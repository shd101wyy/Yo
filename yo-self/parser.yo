//! Yo parser — converts a token stream (from the lexer) into an AST (list of AstExpr).
//! The parser uses recursive descent.
//!
//! Note: The AST type is `AstExpr` (not `Expr`) to avoid conflict with the prelude's Expr type.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList, array_list } :: import("std/collections/array_list");
{ TokenKind, Token, find_matching_bracket } :: import("./token.yo");
{ tokenize } :: import("./lexer.yo");
{
  AstExpr,
  ExprId,
  alloc_global_expr_id,
  BK_TUPLE,
  BK_TUPLE_TYPE,
  BK_ARRAY,
  BK_SLICE,
  BK_ARRAY_VAL,
  BK_BEGIN,
  BK_IMPORT,
  BK_ANON_STRUCT,
  make_err_expr,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_atom_and_operator,
  ast_expr_is_infix_op_fn_call,
  ast_expr_token
} :: import("./expr.yo");
/// Result of parsing one expression: the expression and the next token index.
ParseResult :: struct(
  expr : AstExpr,
  index : usize
);
/// Intermediate result of parsing function arguments.
FnArgsResult :: struct(
  args : ArrayList(AstExpr),
  index : usize
);
/// An error produced by the parser.
ParseError :: object(
  message : String,
  row : usize,
  column : usize,
  module_path : String,
  source_line : String
);
impl(
  ParseError,
  ToString(
    to_string : (fn(ref(self) : Self) -> String)({
      sb := StringBuilder.new();
      sb.write_str("error: ");
      sb.write_string(self.message);
      sb.write_str("\n --> ");
      sb.write_string(self.module_path);
      sb.write_str(":");
      sb.write_string(`${(self.row + usize(1))}`);
      sb.write_str(":");
      sb.write_string(`${self.column}`);
      if(self.source_line.len() > usize(0), {
        sb.write_str("\n  |\n");
        sb.write_string(`${(self.row + usize(1))}`);
        sb.write_str(" | ");
        sb.write_string(self.source_line);
        sb.write_str("\n  |");
        (k : usize) = usize(0);
        // pad column + 3 spaces (to align under first non-space char of source line)
        while(k < self.column, {
          sb.write_byte(u8(32));
          k = (k + usize(1));
        });
        sb.write_byte(u8(94));
      });
      sb.to_string()
    })
  )
);
impl(ParseError, Error());
/// Extract the Nth source line (0-indexed) from the input string.
/// Returns an empty string if the row is out of range.
extract_source_line :: (fn(input : String, row : usize) -> String)({
  lines_list := input.split(String.from("\n"));
  match(
    lines_list.get(row),
    .None => String.from(""),
    .Some(line) => line
  )
});
/// Build a `ParseError` from a token, automatically extracting the source line.
make_parse_error :: (fn(tok : Token, message : String) -> ParseError)(
  ParseError(
    message : message,
    row : tok.row,
    column : tok.column,
    module_path : tok.module_path,
    source_line : extract_source_line(tok.input, tok.row)
  )
);
/// Build a `ParseError` without source context (for end-of-input or internal errors).
make_parse_error_raw :: (fn(module_path : String, message : String) -> ParseError)(
  ParseError(
    message : message,
    row : usize(0),
    column : usize(0),
    module_path : module_path,
    source_line : String.from("")
  )
);
// Per-process monotonic counter for AstExpr ids. Each Parser instance
// pulls from this so ids are unique across files in multi-file `check`
// (otherwise inner.yo's id=N and index.yo's id=N collide in the
// expr_info_table and the second-parsed file's import value gets stamped
// over by the first-parsed file's matching-id expression — observed as
// `import("./rune.yo")` resolving to `i32` at export-spread time).
// Global expr-id counter moved to expr.yo (shared with synthesized nodes).
Parser :: struct(
  input_string : String,
  module_path : String,
  tokens : ArrayList(Token),
  program : ArrayList(AstExpr),
  has_template_string : bool,
  next_expr_id : usize
);
impl(
  Parser,
  new : (
    fn(
      input_string : String,
      module_path : String,
      exn : Exception
    ) -> Self
  )({
    toks := tokenize(input_string, module_path, exn);
    Parser(
      input_string : input_string,
      module_path : module_path,
      tokens : toks,
      program : ArrayList(AstExpr).new(),
      has_template_string : false,
      next_expr_id : usize(0)
    )
  }),
  get_tokens : (fn(self : Self) -> ArrayList(Token))(self.tokens),
  alloc_id : (fn(ref(self) : Self) -> ExprId)({
    id := alloc_global_expr_id();
    self.next_expr_id = (self.next_expr_id + usize(1));
    id
  }),
  make_syn_tok : (fn(ref(self) : Self, kind : TokenKind, value : String) -> Token)(
    Token(
      kind : kind,
      value : value,
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : self.module_path,
      input : self.input_string
    )
  ),
  make_unit_call : (fn(ref(self) : Self, ref_tok : Token) -> AstExpr)({
    unit_tok := Token(
      kind : TokenKind.Identifier,
      value : String.from(BK_TUPLE),
      row : ref_tok.row,
      column : ref_tok.column,
      character : ref_tok.character,
      module_path : ref_tok.module_path,
      input : ref_tok.input
    );
    .FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), unit_tok)), ArrayList(AstExpr).new(), false, unit_tok)
  }),
  skip_ws_fwd : (fn(ref(self) : Self, index : usize) -> usize)({
    i := index;
    n := self.tokens.len();
    while(i < n, {
      match(
        self.tokens.get(i),
        .None => {
          break;
        },
        .Some(tok) => {
          is_ws := (((((((tok.kind == TokenKind.Whitespace) || (tok.kind == TokenKind.SingleLineComment)) || (tok.kind == TokenKind.MultiLineComment)) || (tok.kind == TokenKind.DocLineComment)) || (tok.kind == TokenKind.InnerDocLineComment)) || (tok.kind == TokenKind.DocBlockComment)) || (tok.kind == TokenKind.InnerDocBlockComment));
          if(is_ws == false, {
            break;
          });
          i = (i + usize(1));
        }
      );
    });
    i
  }),
  skip_ws_bwd : (fn(ref(self) : Self, index : usize) -> usize)({
    i := index;
    while(true, {
      match(
        self.tokens.get(i),
        .None => {
          break;
        },
        .Some(tok) => {
          is_ws := (((((((tok.kind == TokenKind.Whitespace) || (tok.kind == TokenKind.SingleLineComment)) || (tok.kind == TokenKind.MultiLineComment)) || (tok.kind == TokenKind.DocLineComment)) || (tok.kind == TokenKind.InnerDocLineComment)) || (tok.kind == TokenKind.DocBlockComment)) || (tok.kind == TokenKind.InnerDocBlockComment));
          if(is_ws == false, {
            break;
          });
          if(i == usize(0), {
            break;
          });
          i = (i - usize(1));
        }
      );
    });
    i
  }),
  range_has_newline : (fn(ref(self) : Self, start : usize, end : usize) -> bool)({
    nl_str := String.from("\n");
    i := start;
    result := false;
    while(i < end, {
      match(
        self.tokens.get(i),
        .None => {
          break;
        },
        .Some(tok) => {
          if((tok.kind == TokenKind.Whitespace) && tok.value.contains(nl_str), {
            result = true;
            break;
          });
          i = (i + usize(1));
        }
      );
    });
    result
  }),
  is_op_at_line_start : (fn(ref(self) : Self, op_idx : usize) -> bool)({
    if(op_idx == usize(0), {
      return(true);
    });
    nl_str := String.from("\n");
    j := op_idx;
    result := false;
    scan_done := false;
    while(scan_done == false, {
      if(j == usize(0), {
        result = true;
        scan_done = true;
      }, {
        j = (j - usize(1));
        match(
          self.tokens.get(j),
          .None => {
            scan_done = true;
          },
          .Some(tok) => cond(
            ((tok.kind == TokenKind.Whitespace) && tok.value.contains(nl_str)) => {
              // Found newline — check tokens[j+1..op_idx) are all whitespace
              all_ws := true;
              k := (j + usize(1));
              while(k < op_idx, {
                match(
                  self.tokens.get(k),
                  .None => {
                    break;
                  },
                  .Some(kt) => {
                    if(kt.kind != TokenKind.Whitespace, {
                      all_ws = false;
                      break;
                    });
                    k = (k + usize(1));
                  }
                );
              });
              result = all_ws;
              scan_done = true;
            },
            (tok.kind != TokenKind.Whitespace) => {
              result = false;
              scan_done = true;
            },
            true => ()
          )
        );
      });
    });
    result
  }),
  is_parenthesized_expr : (fn(ref(self) : Self, start : usize, end : usize) -> bool)({
    s := self.skip_ws_fwd(start);
    e := self.skip_ws_bwd(end);
    s_tok := match(
      self.tokens.get(s),
      .Some(t) => t,
      .None => {
        return(false);
      }
    );
    e_tok := match(
      self.tokens.get(e),
      .Some(t) => t,
      .None => {
        return(false);
      }
    );
    if(s_tok.kind != TokenKind.LParen, {
      return(false);
    });
    if(e_tok.kind != TokenKind.RParen, {
      return(false);
    });
    match_idx := match(
      find_matching_bracket(self.tokens, s),
      .None => {
        return(false);
      },
      .Some(m) => m
    );
    match_idx == e
  }),
  range_after_op_has_newline : (fn(ref(self) : Self, op_idx : usize, rhs_start : usize) -> bool)(
    self.range_has_newline(op_idx + usize(1), rhs_start)
  ),
  is_op_alone_on_line : (fn(ref(self) : Self, op_idx : usize, rhs_start : usize) -> bool)({
    if(self.is_op_at_line_start(op_idx) == false, {
      return(false);
    });
    nl_str := String.from("\n");
    match(
      self.tokens.get(op_idx + usize(1)),
      .None => false,
      .Some(t) => ((t.kind == TokenKind.Whitespace) && t.value.contains(nl_str))
    )
  }),
  parse_template_string : (fn(ref(self) : Self, tok : Token, index : usize, exn : Exception) -> ParseResult)({
    self.has_template_string = true;
    template_value := tok.value;
    // Collect chars of the template string into an ArrayList(rune)
    ts_chars := ArrayList(rune).new();
    {
      c_iter := template_value.chars();
      while(true, {
        match(
          c_iter.next(),
          .None => {
            break;
          },
          .Some(c) => {
            ts_chars.push(c);
          }
        );
      });
    };
    n := ts_chars.len();
    // Parts: each part is either a literal string or an interpolated expression
    part_is_expr := ArrayList(bool).new();
    part_content := ArrayList(String).new();
    cur_sb := StringBuilder.new();
    i := usize(0);
    while(i < n, {
      c := match(ts_chars.get(i),.Some(r) => r,.None => rune(u32(0)));
      cond(
        // Escaped dollar: \$  →  $
        (
          (c.char == u32(0x5C)) && {
            nc := match(ts_chars.get(i + usize(1)),.Some(r) => r,.None => rune(u32(0)));
            nc.char == u32(0x24)
          }
        ) => {
          cur_sb.write_byte(u8(0x24));
          i = (i + usize(2));
        },
        // Interpolation start: ${
        (
          (c.char == u32(0x24)) && {
            nc := match(ts_chars.get(i + usize(1)),.Some(r) => r,.None => rune(u32(0)));
            nc.char == u32(0x7B)
          }
        ) => {
          // Save current string part if non-empty
          if(cur_sb.len() > usize(0), {
            part_is_expr.push(false);
            part_content.push(cur_sb.to_string());
            cur_sb = StringBuilder.new();
          });
          // Scan for matching closing brace
          brace_depth := usize(1);
          expr_sb := StringBuilder.new();
          j := (i + usize(2));
          while((j < n) && (brace_depth > usize(0)), {
            cj := match(ts_chars.get(j),.Some(r) => r,.None => rune(u32(0)));
            cond(
              (cj.char == u32(0x7B)) => {
                brace_depth = (brace_depth + usize(1));
              },
              (cj.char == u32(0x7D)) => {
                brace_depth = (brace_depth - usize(1));
              },
              true => ()
            );
            if(brace_depth > usize(0), {
              expr_sb.write_rune(cj);
            });
            j = (j + usize(1));
          });
          part_is_expr.push(true);
          part_content.push(expr_sb.to_string());
          i = j;
        },
        true => {
          cond(
            (c.char == u32(0x5C)) => cur_sb.write_str("\\\\"),
            (c.char == u32(0x22)) => cur_sb.write_str("\\\""),
            (c.char == u32(0x0A)) => cur_sb.write_str("\\n"),
            (c.char == u32(0x09)) => cur_sb.write_str("\\t"),
            (c.char == u32(0x0D)) => cur_sb.write_str("\\r"),
            (c.char == u32(0x00)) => cur_sb.write_str("\\0"),
            true => cur_sb.write_rune(c)
          );
          i = (i + usize(1));
        }
      );
    });
    // Save remaining string content
    if(cur_sb.len() > usize(0), {
      part_is_expr.push(false);
      part_content.push(cur_sb.to_string());
    });
    // If no parts, use empty string literal
    if(part_content.len() == usize(0), {
      part_is_expr.push(false);
      part_content.push(String.from(""));
    });
    // Synthetic tokens for building the expression chain
    dot_tok := self.make_syn_tok(TokenKind.Dot, String.from("."));
    plus_tok := self.make_syn_tok(TokenKind.Operator, String.from("+"));
    to_str_tok := self.make_syn_tok(TokenKind.Identifier, String.from("to_string"));
    // Helper: build `e.to_string()` — takes explicit params since local fns
    // can't capture outer values. The four synthetic sub-expressions need
    // UNIQUE expr ids (passed in via `id_*`): hardcoding `usize(0)` made
    // every template-string sub-expr collide on id 0 in the per-ctx
    // `expr_info_table`, corrupting their evaluated types (a downstream
    // `.to_string()` dispatch then saw garbage and failed to unify). Mirrors
    // the global-expr-id collision fixed in commit 354b235b.
    make_ts_call :: (
      fn(
        e : AstExpr,
        d_tok : Token,
        ts_tok : Token,
        outer_tok : Token,
        id_ts_atom : usize,
        id_dot_atom : usize,
        id_prop : usize,
        id_outer : usize
      ) -> AstExpr
    )({
      prop_args := ArrayList(AstExpr).new();
      prop_args.push(e);
      prop_args.push(.Atom(id_ts_atom, ts_tok));
      (prop : AstExpr) =.FnCall(id_prop, box(.Atom(id_dot_atom, d_tok)), prop_args, true, d_tok);
      .FnCall(id_outer, box(prop), ArrayList(AstExpr).new(), false, outer_tok)
    });
    num_parts := part_content.len();
    (result_expr_opt : Option(AstExpr)) =.None;
    pi := usize(0);
    while(pi < num_parts, {
      is_expr := match(part_is_expr.get(pi),.Some(b) => b,.None => false);
      content := match(part_content.get(pi),.Some(s) => s,.None => String.from(""));
      (part_expr : AstExpr) = cond(
        is_expr => {
          // Parse the interpolated expression via the module-level holder
          // (avoids forward reference: parse_template_string → get_program cycle)
          (inner_prog : ArrayList(AstExpr)) = Parser.new(content, self.module_path, exn).get_program(exn);
          if(inner_prog.len() == usize(0), {
            exn.throw(dyn(make_parse_error(tok, `empty expression in template string interpolation`)));
          });
          inner_expr := match(
            inner_prog.get(usize(0)),
            .Some(e) => e,
            .None => {
              return(ParseResult(expr : make_err_expr(), index : (index + usize(1))));
            }
          );
          make_ts_call(inner_expr, dot_tok, to_str_tok, tok, self.alloc_id(), self.alloc_id(), self.alloc_id(), self.alloc_id())
        },
        true => {
          // Literal string part: "content".to_string()
          // Build the escaped string by wrapping content in double quotes
          content_str := content.clone();
          str_tok := Token(
            kind : TokenKind.StringLit,
            value : ((String.from("\"") + content) + String.from("\"")),
            row : tok.row,
            column : tok.column,
            character : tok.character,
            module_path : tok.module_path,
            input : tok.input
          );
          make_ts_call(.Atom(self.alloc_id(), str_tok), dot_tok, to_str_tok, tok, self.alloc_id(), self.alloc_id(), self.alloc_id(), self.alloc_id())
        }
      );
      result_expr_opt = match(
        result_expr_opt,
        .None => Option(AstExpr).Some(part_expr),
        .Some(prev) => {
          // prev.(+)(part_expr)
          prop_args := ArrayList(AstExpr).new();
          prop_args.push(prev);
          prop_args.push(.Atom(self.alloc_id(), plus_tok));
          (prop : AstExpr) =.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), dot_tok)), prop_args, true, dot_tok);
          call_args := ArrayList(AstExpr).new();
          call_args.push(part_expr);
          Option(AstExpr).Some(.FnCall(self.alloc_id(), box(prop), call_args, false, tok))
        }
      );
      pi = (pi + usize(1));
    });
    final_expr := match(
      result_expr_opt,
      .Some(e) => e,
      .None => {
        return(ParseResult(expr : make_err_expr(), index : (index + usize(1))));
      }
    );
    ParseResult(expr : final_expr, index : (index + usize(1)))
  }),
  parse_fn_args : (
    fn(
      ref(self) : Self,
      index : usize,
      has_whitespace : bool,
      exn : Exception
    ) -> FnArgsResult
  )({
    args := ArrayList(AstExpr).new();
    idx := self.skip_ws_fwd(index);
    // Empty paren call: func()
    if(has_whitespace == false, {
      curr_kind := match(self.tokens.get(idx),.Some(t) => t.kind,.None => TokenKind.RParen);
      if(curr_kind == TokenKind.RParen, {
        return(FnArgsResult(args : args, index : (idx + usize(1))));
      });
    });
    while(true, {
      arg_pr := self.parse_expression(idx, exn);
      args.push(arg_pr.expr);
      idx = arg_pr.index;
      curr := match(
        self.tokens.get(idx),
        .Some(t) => t,
        .None => {
          return(FnArgsResult(args : args, index : idx));
        }
      );
      cond(
        (curr.kind == TokenKind.Comma) => {
          idx = (idx + usize(1));
          // Accept trailing comma: skip whitespace, check for RParen.
          nxt_idx := self.skip_ws_fwd(idx);
          nxt := match(
            self.tokens.get(nxt_idx),
            .Some(t) => t,
            .None => {
              return(FnArgsResult(args : args, index : nxt_idx));
            }
          );
          is_rp := (nxt.kind == TokenKind.RParen);
          cond(
            is_rp => {
              return(FnArgsResult(args : args, index : (nxt_idx + usize(1))));
            },
            true => ()
          );
        },
        (((curr.kind == TokenKind.Semicolon) || (curr.kind == TokenKind.RBracket)) || (curr.kind == TokenKind.RCurlyBracket)) => {
          return(FnArgsResult(args : args, index : idx));
        },
        (curr.kind == TokenKind.RParen) => {
          return(
            FnArgsResult(
              args : args,
              index : cond(has_whitespace => idx, true => (idx + usize(1)))
            )
          );
        },
        true => {
          exn.throw(
            dyn(
              make_parse_error(
                curr,
                cond(
                  has_whitespace => `expected ; to end function call`,
                  true => `expected , or ) in function call`
                )
              )
            )
          );
          return(FnArgsResult(args : args, index : idx));
        }
      );
    });
    FnArgsResult(args : args, index : idx)
  }),
  parse_fn_call : (
    fn(
      ref(self) : Self,
      func : AstExpr,
      index : usize,
      has_whitespace : bool,
      exn : Exception
    ) -> ParseResult
  )({
    fn_tok := ast_expr_token(func);
    fa := self.parse_fn_args(index, has_whitespace, exn);
    ParseResult(
      expr :.FnCall(self.alloc_id(), box(func), fa.args, false, fn_tok),
      index : fa.index
    )
  }),
  parse_paren_expr : (fn(ref(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    (tok : Token) = match(
      self.tokens.get(index),
      .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `unexpected end of input`))),
      .Some(t) => t
    );
    if(tok.kind != TokenKind.LParen, {
      exn.throw(dyn(make_parse_error(tok, `expected (`)));
    });
    // Check for unit ()
    next_tok_kind := match(
      self.tokens.get(index + usize(1)),
      .Some(t) => t.kind,
      .None => TokenKind.Identifier
    );
    if(next_tok_kind == TokenKind.RParen, {
      unit_tok := Token(
        kind : TokenKind.Identifier,
        value : String.from(BK_TUPLE),
        row : tok.row,
        column : tok.column,
        character : tok.character,
        module_path : tok.module_path,
        input : tok.input
      );
      return(
        ParseResult(
          expr :.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), unit_tok)), ArrayList(AstExpr).new(), false, unit_tok),
          index : (index + usize(2))
        )
      );
    });
    pr := self.parse_expression(index + usize(1), exn);
    (expr : AstExpr) = pr.expr;
    idx := pr.index;
    (curr_kind : TokenKind) = match(
      self.tokens.get(idx),
      .Some(t) => t.kind,
      .None => exn.throw(dyn(make_parse_error(tok, `expected ) or , in (...)`)))
    );
    // Single expression wrapped in parens: (expr)
    if(curr_kind == TokenKind.RParen, {
      return(ParseResult(expr : expr, index : (idx + usize(1))));
    });
    // Tuple or Tuple type
    (separator_is_comma : Option(bool)) =.None;
    args := ArrayList(AstExpr).new();
    args.push(expr);
    while(true, {
      (curr : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `expected ) or , for tuple`))),
        .Some(t) => t
      );
      cond(
        (curr.kind == TokenKind.Comma) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(true),
            .Some(__sb) => cond(
              __sb => Option(bool).Some(true),
              true => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix , and ; in (...)`)));
                Option(bool).Some(false)
              }
            )
          );
          idx = (idx + usize(1));
        },
        (curr.kind == TokenKind.Semicolon) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(false),
            .Some(__sb) => cond(
              __sb => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix ; and , in (...)`)));
                Option(bool).Some(true)
              },
              true => Option(bool).Some(false)
            )
          );
          idx = (idx + usize(1));
        },
        true => ()
      );
      idx = self.skip_ws_fwd(idx);
      (curr2 : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `expected ) for tuple`))),
        .Some(t) => t
      );
      if(curr2.kind == TokenKind.RParen, {
        break;
      });
      arg_pr := self.parse_expression(idx, exn);
      args.push(arg_pr.expr);
      idx = arg_pr.index;
    });
    // comma separator → Tuple type; semicolon separator → tuple value
    is_tuple_type := match(
      separator_is_comma,
      .None => true,
      .Some(__sb) => ((__sb) == false)
    );
    kw := cond(is_tuple_type => BK_TUPLE_TYPE, true => BK_TUPLE);
    func_tok := Token(
      kind : TokenKind.Identifier,
      value : String.from(kw),
      row : tok.row,
      column : tok.column,
      character : tok.character,
      module_path : tok.module_path,
      input : tok.input
    );
    ParseResult(
      expr :.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), func_tok)), args, false, func_tok),
      index : (idx + usize(1))
    )
  }),
  parse_array_expr : (fn(ref(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    (tok : Token) = match(
      self.tokens.get(index),
      .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `unexpected end of input`))),
      .Some(t) => t
    );
    if(tok.kind != TokenKind.LBracket, {
      exn.throw(dyn(make_parse_error(tok, `expected [`)));
    });
    idx := (index + usize(1));
    (separator_is_comma : Option(bool)) =.None;
    args := ArrayList(AstExpr).new();
    while(true, {
      (curr : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `expected ] or , for array`))),
        .Some(t) => t
      );
      cond(
        (curr.kind == TokenKind.Comma) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(true),
            .Some(__sb) => cond(
              __sb => Option(bool).Some(true),
              true => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix , and ; in [...]`)));
                Option(bool).Some(false)
              }
            )
          );
          idx = (idx + usize(1));
        },
        (curr.kind == TokenKind.Semicolon) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(false),
            .Some(__sb) => cond(
              __sb => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix ; and , in [...]`)));
                Option(bool).Some(true)
              },
              true => Option(bool).Some(false)
            )
          );
          idx = (idx + usize(1));
        },
        true => ()
      );
      (curr2 : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `expected ]`))),
        .Some(t) => t
      );
      if(curr2.kind == TokenKind.RBracket, {
        break;
      });
      arg_pr := self.parse_expression(idx, exn);
      args.push(arg_pr.expr);
      idx = arg_pr.index;
    });
    // [T; N] → Array(T, N), [T] or [T;] → Slice(T), [a, b] → array(a, b)
    is_array_or_slice_type := match(
      separator_is_comma,
      .None => true,
      .Some(__sb) => ((__sb) == false)
    );
    n_args := args.len();
    if(is_array_or_slice_type && (n_args > usize(2)), {
      exn.throw(dyn(make_parse_error(tok, `expected at most 2 arguments for Array type, or 1 for Slice type`)));
    });
    is_array_type := (is_array_or_slice_type && (n_args == usize(2)));
    is_slice_type := (is_array_or_slice_type && (n_args == usize(1)));
    kw := cond(
      is_array_type => BK_ARRAY,
      is_slice_type => BK_SLICE,
      true => BK_ARRAY_VAL
    );
    func_tok := Token(
      kind : TokenKind.Identifier,
      value : String.from(kw),
      row : tok.row,
      column : tok.column,
      character : tok.character,
      module_path : tok.module_path,
      input : tok.input
    );
    ParseResult(
      expr :.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), func_tok)), args, false, func_tok),
      index : (idx + usize(1))
    )
  }),
  is_valid_struct_field_arg : (fn(ref(self) : Self, expr : AstExpr) -> bool)(
    match(
      expr,
      .Atom(_, _) => true,
      .FnCall(_, func_box, _, is_infix, _) => cond(
        is_infix => match(
          func_box.*,
          .Atom(_, func_tok) => (func_tok.value == ":"),
          .FnCall(_, _, _, _, _) => false
        ),
        true => match(
          func_box.*,
          .Atom(_, func_tok2) => (func_tok2.value == "..."),
          .FnCall(_, _, _, _, _) => false
        )
      )
    )
  ),
  parse_curly_bracket_expr : (fn(ref(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    (tok : Token) = match(
      self.tokens.get(index),
      .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `unexpected end of input`))),
      .Some(t) => t
    );
    if(tok.kind != TokenKind.LCurlyBracket, {
      exn.throw(dyn(make_parse_error(tok, `expected {`)));
    });
    args := ArrayList(AstExpr).new();
    (separator_is_comma : Option(bool)) =.None;
    idx := (index + usize(1));
    while(true, {
      idx = self.skip_ws_fwd(idx);
      (curr : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `unexpected end of {...}`))),
        .Some(t) => t
      );
      cond(
        (curr.kind == TokenKind.Comma) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(true),
            .Some(__sb) => cond(
              __sb => Option(bool).Some(true),
              true => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix , and ; in {...}`)));
                Option(bool).Some(false)
              }
            )
          );
          idx = (idx + usize(1));
        },
        (curr.kind == TokenKind.Semicolon) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(false),
            .Some(__sb) => cond(
              __sb => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix ; and , in {...}`)));
                Option(bool).Some(true)
              },
              true => Option(bool).Some(false)
            )
          );
          idx = (idx + usize(1));
        },
        true => ()
      );
      idx = self.skip_ws_fwd(idx);
      (curr2 : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `unexpected end of {...}`))),
        .Some(t) => t
      );
      if(curr2.kind == TokenKind.RCurlyBracket, {
        // Check if the last non-ws token before } was a `;` or `{` — if so, add trailing unit
        last_nws_idx := self.skip_ws_bwd(idx - usize(1));
        last_tok := match(
          self.tokens.get(last_nws_idx),
          .Some(t) => t,
          .None => Token(
            kind : TokenKind.LCurlyBracket,
            value : String.from("{"),
            row : usize(0),
            column : usize(0),
            character : usize(0),
            module_path : String.from(""),
            input : String.from("")
          )
        );
        is_semi := match(separator_is_comma,.None => false,.Some(__sb) => ((__sb) == false));
        if(is_semi && ((last_tok.kind == TokenKind.Semicolon) || (last_tok.kind == TokenKind.LCurlyBracket)), {
          unit_tok := Token(
            kind : TokenKind.Identifier,
            value : String.from(BK_TUPLE),
            row : last_tok.row,
            column : last_tok.column,
            character : last_tok.character,
            module_path : last_tok.module_path,
            input : last_tok.input
          );
          args.push(.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), unit_tok)), ArrayList(AstExpr).new(), false, unit_tok));
        });
        break;
      });
      arg_pr := self.parse_expression(idx, exn);
      args.push(arg_pr.expr);
      idx = arg_pr.index;
    });
    // No separator or comma separator -> anonymous struct; semicolon separator -> begin block.
    is_comma := match(
      separator_is_comma,
      .None => true,
      .Some(__sb) => __sb
    );
    cond(
      is_comma => {
        (vi : usize) = usize(0);
        vn := args.len();
        while(vi < vn, {
          match(
            args.get(vi),
            .None => (),
            .Some(arg) => {
              if(!(self.is_valid_struct_field_arg(arg)), {
                exn.throw(
                  dyn(
                    make_parse_error(
                      tok,
                      String.from(
                        "{ ... } without semicolons is parsed as a struct literal, not a block. To write a block, use semicolons: { stmt1; stmt2; }"
                      )
                    )
                  )
                );
              });
            }
          );
          vi = (vi + usize(1));
        });
        // Anonymous struct: { x, y: 2 } → _(x: x, y: 2)
        n_args := args.len();
        final_args := ArrayList(AstExpr).new();
        ai := usize(0);
        while(ai < n_args, {
          match(
            args.get(ai),
            .None => {
              break;
            },
            .Some(arg) => {
              (new_arg : AstExpr) = cond(
                ast_expr_is_atom(arg) => {
                  colon_tok := Token(
                    kind : TokenKind.Operator,
                    value : String.from(":"),
                    row : tok.row,
                    column : tok.column,
                    character : tok.character,
                    module_path : tok.module_path,
                    input : tok.input
                  );
                  arg_copy := match(args.get(ai),.Some(a) => a,.None => make_err_expr());
                  .FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), colon_tok)), array_list(arg, arg_copy), true, colon_tok)
                },
                true => arg
              );
              final_args.push(new_arg);
              ai = (ai + usize(1));
            }
          );
        });
        anon_tok := Token(
          kind : TokenKind.Identifier,
          value : String.from(BK_ANON_STRUCT),
          row : tok.row,
          column : tok.column,
          character : tok.character,
          module_path : tok.module_path,
          input : tok.input
        );
        ParseResult(
          expr :.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), anon_tok)), final_args, false, tok),
          index : (idx + usize(1))
        )
      },
      true => {
        // Begin block: begin(e1, e2, ...)
        begin_tok := Token(
          kind : TokenKind.Identifier,
          value : String.from(BK_BEGIN),
          row : tok.row,
          column : tok.column,
          character : tok.character,
          module_path : tok.module_path,
          input : tok.input
        );
        ParseResult(
          expr :.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), begin_tok)), args, false, begin_tok),
          index : (idx + usize(1))
        )
      }
    )
  }),
  parse_left_assoc_op : (
    fn(
      ref(self) : Self,
      primary : AstExpr,
      op_tok : Token,
      rhs : AstExpr,
      index : usize,
      exn : Exception
    ) -> ParseResult
  )({
    rhs_is_infix_non_dot := match(
      rhs,
      .FnCall(_, rfb, rargs, ris_infix, _) => cond(
        (ris_infix == false) => false,
        (rargs.len() != usize(2)) => false,
        true => match(
          rfb.*,
          .Atom(_, ft) => ((ft.kind == TokenKind.Operator) || (ft.kind == TokenKind.Dot)),
          .FnCall(_, _, _, _, _) => false
        )
      ),
      .Atom(_, _) => false
    );
    is_dot_func := match(
      rhs,
      .FnCall(_, rfb, _, _, _) => match(
        rfb.*,
        .Atom(_, ft) => (ft.kind == TokenKind.Dot),
        .FnCall(_, _, _, _, _) => false
      ),
      .Atom(_, _) => false
    );
    if(rhs_is_infix_non_dot && (is_dot_func == false), {
      (left_operand : AstExpr) = match(
        rhs,
        .FnCall(_, _, rargs, _, _) => match(
          rargs.get(usize(0)),
          .Some(a) => a,
          .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `internal: missing left arg in rhs`)))
        ),
        .Atom(_, _) => exn.throw(dyn(make_parse_error_raw(self.module_path, `internal: rhs is atom`)))
      );
      (right_operand : AstExpr) = match(
        rhs,
        .FnCall(_, _, rargs, _, _) => match(
          rargs.get(usize(1)),
          .Some(a) => a,
          .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `internal: missing right arg in rhs`)))
        ),
        .Atom(_, _) => exn.throw(dyn(make_parse_error_raw(self.module_path, `internal: rhs is atom`)))
      );
      rhs_func_tok := match(
        rhs,
        .FnCall(_, rfb, _, _, _) => match(
          rfb.*,
          .Atom(_, ft) => ft,
          .FnCall(_, _, _, _, ft) => ft
        ),
        .Atom(_, t) => t
      );
      left_side_args := ArrayList(AstExpr).new();
      left_side_args.push(primary);
      left_side_args.push(left_operand);
      (left_side : AstExpr) =.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), op_tok)), left_side_args, true, op_tok);
      new_args := ArrayList(AstExpr).new();
      new_args.push(left_side);
      new_args.push(right_operand);
      (new_primary : AstExpr) =.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), rhs_func_tok)), new_args, true, rhs_func_tok);
      self.parse_primary_end(new_primary, index, exn)
    }, {
      simple_args := ArrayList(AstExpr).new();
      simple_args.push(primary);
      simple_args.push(rhs);
      self.parse_primary_end(.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), op_tok)), simple_args, true, op_tok), index, exn)
    })
  }),
  parse_primary : (fn(ref(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    idx := self.skip_ws_fwd(index);
    (tok : Token) = match(
      self.tokens.get(idx),
      .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `unexpected end of input`))),
      .Some(t) => t
    );
    cond(
      // Atom kinds
      (((((((tok.kind == TokenKind.Identifier) || (tok.kind == TokenKind.Operator)) || (tok.kind == TokenKind.Bool)) || (tok.kind == TokenKind.Integer)) || (tok.kind == TokenKind.Float)) || (tok.kind == TokenKind.StringLit)) || (tok.kind == TokenKind.CharLit)) =>
        ParseResult(expr :.Atom(self.alloc_id(), tok), index : (idx + usize(1))),
      (tok.kind == TokenKind.LParen) => self.parse_paren_expr(idx, exn),
      (tok.kind == TokenKind.LBracket) => self.parse_array_expr(idx, exn),
      (tok.kind == TokenKind.LCurlyBracket) => self.parse_curly_bracket_expr(idx, exn),
      (tok.kind == TokenKind.Dot) => ParseResult(expr :.Atom(self.alloc_id(), tok), index : (idx + usize(1))),
      (tok.kind == TokenKind.TemplateString) => self.parse_template_string(tok, idx, exn),
      true => exn.throw(dyn(make_parse_error(tok, `unexpected token: ${tok.value}`)))
    )
  }),
  parse_primary_end : (
    fn(
      ref(self) : Self,
      primary_expr : AstExpr,
      index : usize,
      exn : Exception
    ) -> ParseResult
  )({
    orig_idx := index;
    next_idx := self.skip_ws_fwd(index);
    has_ws_fwd := (next_idx != index);
    prev_idx_for_ws := cond((index > usize(0)) => (index - usize(1)), true => usize(0));
    has_ws_bwd := match(
      self.tokens.get(prev_idx_for_ws),
      .Some(t) => (t.kind == TokenKind.Whitespace),
      .None => false
    );
    idx := next_idx;
    tok := match(
      self.tokens.get(idx),
      .Some(t) => t,
      .None => {
        return(ParseResult(expr : primary_expr, index : idx));
      }
    );
    // Terminators: stop parsing the current expression
    if(((((tok.kind == TokenKind.Semicolon) || (tok.kind == TokenKind.Comma)) || (tok.kind == TokenKind.RParen)) || (tok.kind == TokenKind.RBracket)) || (tok.kind == TokenKind.RCurlyBracket), {
      return(ParseResult(expr : primary_expr, index : idx));
    });
    primary_is_dot := match(
      primary_expr,
      .Atom(_, pt) => (pt.kind == TokenKind.Dot),
      .FnCall(_, _, _, _, _) => false
    );
    // Dot at start of new line (method chaining across lines)
    is_dot_at_line_start := cond(
      ((tok.kind == TokenKind.Dot) && has_ws_fwd) => {
        next_after_dot_kind := match(
          self.tokens.get(idx + usize(1)),
          .Some(t) => t.kind,
          .None => TokenKind.Whitespace
        );
        ((next_after_dot_kind != TokenKind.Whitespace) && self.range_has_newline(orig_idx, next_idx)) && self.is_op_at_line_start(idx)
      },
      true => false
    );
    // Immediate dot (no whitespace on either side)
    is_immediate_dot := (
      (tok.kind == TokenKind.Dot) && (
        (has_ws_fwd == false) && (
          (has_ws_bwd == false) && {
            next_after_dot_kind := match(
              self.tokens.get(idx + usize(1)),
              .Some(t) => t.kind,
              .None => TokenKind.Whitespace
            );
            next_after_dot_kind != TokenKind.Whitespace
          }
        )
      )
    );
    cond(
      // Dot: field access or enum variant
      ((primary_is_dot || is_dot_at_line_start) || is_immediate_dot) => {
        dot_tok := match(
          self.tokens.get(idx),
          .Some(t) => t,
          .None => Token(
            kind : TokenKind.Dot,
            value : String.from("."),
            row : usize(0),
            column : usize(0),
            character : usize(0),
            module_path : String.from(""),
            input : String.from("")
          )
        );
        rhs_start := cond(primary_is_dot => idx, true => (idx + usize(1)));
        rhs_pr := self.parse_primary(rhs_start, exn);
        rhs_expr := rhs_pr.expr;
        rhs_idx := rhs_pr.index;
        dot_fn_tok := cond(
          primary_is_dot =>
            match(primary_expr,.Atom(_, pt) => pt,.FnCall(_, _, _, _, pt) => pt),
          true => dot_tok
        );
        init_args := cond(
          primary_is_dot => array_list(rhs_expr),
          true => array_list(primary_expr, rhs_expr)
        );
        init_infix := (primary_is_dot == false);
        // Accumulate further immediate dot-chains (no whitespace)
        (cur_expr : AstExpr) =.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), dot_fn_tok)), init_args, init_infix, dot_fn_tok);
        cur_idx := rhs_idx;
        while(true, {
          match(
            self.tokens.get(cur_idx),
            .None => {
              break;
            },
            .Some(next_dot) => {
              if(next_dot.kind != TokenKind.Dot, {
                break;
              });
              chain_pr := self.parse_primary(cur_idx + usize(1), exn);
              chain_args := array_list(cur_expr, chain_pr.expr);
              cur_expr =.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), dot_tok)), chain_args, true, dot_tok);
              cur_idx = chain_pr.index;
            }
          );
        });
        recur(self, cur_expr, cur_idx, exn)
      },
      // Infix operator
      ((tok.kind == TokenKind.Operator) || ((tok.kind == TokenKind.Dot) && (has_ws_fwd == false))) => {
        rhs_start := self.skip_ws_fwd(idx + usize(1));
        rhs_pr := self.parse_expression(rhs_start, exn);
        rhs := rhs_pr.expr;
        rhs_end := rhs_pr.index;
        // Check if rhs is an infix (non-dot) expression
        rhs_is_infix := match(
          rhs,
          .FnCall(_, rfb, rargs, ris_infix, _) => cond(
            (ris_infix == false) => false,
            (rargs.len() != usize(2)) => false,
            true => match(
              rfb.*,
              .Atom(_, ft) => ((ft.kind == TokenKind.Operator) || (ft.kind == TokenKind.Dot)),
              .FnCall(_, _, _, _, _) => false
            )
          ),
          .Atom(_, _) => false
        );
        rhs_is_dot := match(
          rhs,
          .FnCall(_, rfb, _, _, _) => match(
            rfb.*,
            .Atom(_, ft) => (ft.kind == TokenKind.Dot),
            .FnCall(_, _, _, _, _) => false
          ),
          .Atom(_, _) => false
        );
        rhs_is_parenthesized := self.is_parenthesized_expr(rhs_start, rhs_end - usize(1));
        if((rhs_is_infix && (rhs_is_dot == false)) && (rhs_is_parenthesized == false), {
          has_nl_after_op := self.range_after_op_has_newline(idx, rhs_start);
          op_at_line_start := self.is_op_at_line_start(idx);
          op_alone := self.is_op_alone_on_line(idx, rhs_start);
          cond(
            (has_nl_after_op && (op_at_line_start == false)) => {
              rhs_args := ArrayList(AstExpr).new();
              rhs_args.push(primary_expr);
              rhs_args.push(rhs);
              recur(
                self,
                .FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), tok)), rhs_args, true, tok),
                rhs_end,
                exn
              )
            },
            op_alone => {
              rhs_args := ArrayList(AstExpr).new();
              rhs_args.push(primary_expr);
              rhs_args.push(rhs);
              recur(
                self,
                .FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), tok)), rhs_args, true, tok),
                rhs_end,
                exn
              )
            },
            op_at_line_start =>
              self.parse_left_assoc_op(primary_expr, tok, rhs, rhs_end, exn),
            true => exn.throw(dyn(make_parse_error(tok, `ambiguous operator precedence near ${tok.value} — use parentheses`)))
          )
        }, {
          rhs_args := ArrayList(AstExpr).new();
          rhs_args.push(primary_expr);
          rhs_args.push(rhs);
          recur(
            self,
            .FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), tok)), rhs_args, true, tok),
            rhs_end,
            exn
          )
        })
      },
      // Function call without whitespace: `func(arg1, arg2)`
      ((has_ws_fwd == false) && (tok.kind == TokenKind.LParen)) => {
        fn_pr := self.parse_fn_call(primary_expr, idx + usize(1), false, exn);
        recur(self, fn_pr.expr, fn_pr.index, exn)
      },
      ((has_ws_fwd == true) && (tok.kind == TokenKind.LParen)) => {
        exn.throw(dyn(make_parse_error(tok, `whitespace before '(' is not allowed in function calls`)));
        ParseResult(expr : primary_expr, index : idx)
      },
      true => {
        exn.throw(dyn(make_parse_error(tok, `paren-less function and operator calls are not supported; use parentheses`)));
        ParseResult(expr : primary_expr, index : idx)
      }
    )
  }),
  parse_expression : (fn(ref(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    idx := self.skip_ws_fwd(index);
    pr := self.parse_primary(idx, exn);
    self.parse_primary_end(pr.expr, pr.index, exn)
  }),
  do_parse : (fn(ref(self) : Self, exn : Exception) -> unit)({
    idx := usize(0);
    n := self.tokens.len();
    exprs := ArrayList(AstExpr).new();
    while(idx < n, {
      match(
        self.tokens.get(idx),
        .None => {
          break;
        },
        .Some(tok) => {
          is_skip := (((((((tok.kind == TokenKind.Whitespace) || (tok.kind == TokenKind.Semicolon)) || (tok.kind == TokenKind.SingleLineComment)) || (tok.kind == TokenKind.MultiLineComment)) || (tok.kind == TokenKind.DocLineComment)) || (tok.kind == TokenKind.InnerDocLineComment)) || ((tok.kind == TokenKind.DocBlockComment) || (tok.kind == TokenKind.InnerDocBlockComment)));
          if(is_skip, {
            idx = (idx + usize(1));
          }, {
            pr := self.parse_expression(idx, exn);
            exprs.push(pr.expr);
            idx = pr.index;
          });
        }
      );
    });
    // If last non-ws token is `;`, append trailing unit
    if(n > usize(0), {
      last_nws := self.skip_ws_bwd(n - usize(1));
      match(
        self.tokens.get(last_nws),
        .None => (),
        .Some(last_tok) => {
          if(last_tok.kind == TokenKind.Semicolon, {
            unit_tok := Token(
              kind : TokenKind.Identifier,
              value : String.from(BK_TUPLE),
              row : last_tok.row,
              column : last_tok.column,
              character : last_tok.character,
              module_path : last_tok.module_path,
              input : last_tok.input
            );
            exprs.push(.FnCall(self.alloc_id(), box(.Atom(self.alloc_id(), unit_tok)), ArrayList(AstExpr).new(), false, unit_tok));
          });
        }
      );
    });
    self.program = exprs;
  }),
  get_program : (fn(ref(self) : Self, exn : Exception) -> ArrayList(AstExpr))({
    self.do_parse(exn);
    if(self.has_template_string, {
      import_tok := Token(
        kind : TokenKind.Identifier,
        value : String.from(BK_IMPORT),
        row : usize(0),
        column : usize(0),
        character : usize(0),
        module_path : self.module_path,
        input : self.input_string
      );
      str_tok := Token(
        kind : TokenKind.StringLit,
        value : String.from("\"std/fmt/to_string\""),
        row : usize(0),
        column : usize(0),
        character : usize(0),
        module_path : self.module_path,
        input : self.input_string
      );
      (import_atom : AstExpr) =.Atom(self.alloc_id(), import_tok);
      (str_atom : AstExpr) =.Atom(self.alloc_id(), str_tok);
      (import_expr : AstExpr) =.FnCall(
        self.alloc_id(),
        box(import_atom),
        array_list(str_atom),
        false,
        import_tok
      );
      result := ArrayList(AstExpr).new();
      result.push(import_expr);
      i := usize(0);
      n := self.program.len();
      while(i < n, {
        match(
          self.program.get(i),
          .None => {
            break;
          },
          .Some(e) => {
            result.push(e);
            i = (i + usize(1));
          }
        );
      });
      return(result);
    });
    self.program
  })
);
/// Parse Yo source code and return the top-level expression list.
parse :: (
  fn(
    input_string : String,
    module_path : String,
    exn : Exception
  ) -> ArrayList(AstExpr)
)({
  p := Parser.new(input_string, module_path, exn);
  p.get_program(exn)
});
/// Parse a single Yo expression from a code string and return it.
/// Expects exactly one expression in `code`.
/// Mirrors `generateExprFromCode` in `src/parser.ts`.
generate_expr_from_code :: (
  fn(
    code : String,
    exn : Exception
  ) -> AstExpr
)({
  module_path := `auto-generated://\n// === START auto-generated code ===\n${code}\n// === END auto-generated code ===\n`;
  exprs := parse(code.clone(), module_path, exn);
  n := exprs.len();
  cond(
    (n == usize(1)) => match(
      exprs.get(usize(0)),
      .Some(e) => e,
      .None => make_err_expr()
    ),
    true => {
      exn.throw(
        dyn(
          make_parse_error_raw(
            String.from(""),
            String.from("generate_expr_from_code: expected exactly 1 expression from parsed code, got: ") + n.to_string()
          )
        )
      );
      make_err_expr()
    }
  )
});
/// Parse all Yo expressions from a code string and return them.
/// Mirrors `generateExprsFromCode` in `src/parser.ts`.
generate_exprs_from_code :: (
  fn(
    code : String,
    exn : Exception
  ) -> ArrayList(AstExpr)
)({
  module_path := `auto-generated://\n// === START auto-generated code ===\n${code}\n// === END auto-generated code ===\n`;
  parse(code.clone(), module_path, exn)
});
export(ParseResult, FnArgsResult, ParseError, Parser, parse);
export(extract_source_line, make_parse_error, make_parse_error_raw);
export(generate_expr_from_code, generate_exprs_from_code);
