  r := _expr_info_rare_for_write(info);
  r.dyn_call_trait_values = v;
});
expr_info_case_executed :: (fn(info : ExprInfo) -> Option(bool))(
  match(info.rare, .Some(r) => r.case_executed, .None => Option(bool).None)
);
expr_info_set_case_executed :: (fn(info : ExprInfo, v : Option(bool)) -> unit)({
