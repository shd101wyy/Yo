expr_info_is_primitive_match :: (fn(info : ExprInfo) -> Option(bool))(
  match(info.rare, .Some(r) => r.is_primitive_match, .None => Option(bool).None)
);
expr_info_set_is_primitive_match :: (fn(info : ExprInfo, v : Option(bool)) -> unit)({
  r := _expr_info_rare_for_write(info);
  r.is_primitive_match = v;
