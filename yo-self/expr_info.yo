//! EvaluatedExprData annotation types and helpers.
//!
//! Mirrors the type definitions in `src/expr.ts` — 1:1 port.
//!
//! Key design decisions vs TypeScript:
//!
//! * `Path = string[]` → `Path :: ArrayList(String)` type alias.
//! * `PathCollection = Path[]` → `PathCollection :: ArrayList(ArrayList(String))` type alias.
//!   This replaces the `PathCollection :: ArrayList(AstExpr)` stub in `evaluator/context.yo`.
//!
//! * `ControlFlowFlags { return?, unwind?, break?, continue? }` →
//!   `ControlFlowFlags :: struct(return_flag, unwind_flag, break_flag, continue_flag : bool)`.
//!   Using `bool` fields (not `Option(bool)`) because `false` and TypeScript `undefined`
//!   are semantically equivalent for flag fields.
//!
//! * `ControlFlowKind` enum replaces the TypeScript string literal union
//!   `"return" | "unwind" | "break" | "continue"` for type-safe function parameterisation.
//!
//! * `ComptimeRef` discriminated union → Yo enum carrying the inner `ArrayList(EvalValue)`
//!   directly (not the full EvalValue wrapper), preserving the type invariant and
//!   enabling in-place mutation via the shared ArrayList reference handle.
//!   The mutation semantics work because ArrayList is a ref-counted object; copying
//!   the variant still shares the same underlying list.
//!
//! * `EvaluatedExprData` interface → `ExprInfo :: object(...)` with `Option(T)` for all
//!   optional TypeScript fields (`field?: T`); required fields stay non-optional.
//!   `new_expr_info(env, ty)` factory initialises all optional fields to `.None`.
//!
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("./types/definitions.yo");
{ EvalValue } :: import("./value.yo");
{
  AstExpr,
  ExprId,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom_of,
  make_err_expr,
  BK_COND,
  BK_MATCH,
  BK_RETURN,
  BF_UNWIND,
  BK_BREAK
} :: import("./expr.yo");
{ Environment, Variable, Frame, snapshot_env } :: import("./env.yo");
{ AwaitAnalysisResult } :: import("./evaluator/async/await_analysis_types.yo");
{ EffectAnalysisResult } :: import("./evaluator/effects/effect_analysis_types.yo");
// ---------------------------------------------------------------------------
// Path and PathCollection
// ---------------------------------------------------------------------------
/// A compile-time ownership path.  Mirrors TypeScript `type Path = string[]`.
Path :: ArrayList(String);
/// A collection of ownership paths.  Mirrors TypeScript `type PathCollection = Path[]`.
PathCollection :: ArrayList(ArrayList(String));
/// Create an empty PathCollection.
path_collection_new :: (fn() -> PathCollection)(
  ArrayList(ArrayList(String)).new()
);
// ---------------------------------------------------------------------------
// Path utility functions
// ---------------------------------------------------------------------------
/// True if `path1` starts with all segments of `path2` (prefix check).
///
/// Mirrors `pathContainsPath` in `src/expr.ts`.
///
///   path_contains_path(["x"], ["x", "a"])     => false
///   path_contains_path(["x", "a"], ["x"])     => true
///   path_contains_path(["x", "a"], ["x", "a"]) => true
///   path_contains_path(["x", "a"], ["y"])     => false
path_contains_path :: (fn(path1 : ArrayList(String), path2 : ArrayList(String)) -> bool)({
  n1 := path1.len();
  n2 := path2.len();
  if(n1 < n2, {
    return(false);
  });
  i := usize(0);
  while(i < n2, {
    s1 := match(path1.get(i),.Some(s) => s,.None => String.from(""));
    s2 := match(path2.get(i),.Some(s) => s,.None => String.from("~"));
    if(s1 != s2, {
      return(false);
    });
    i = (i + usize(1));
  });
  true
});
/// True if `path1` and `path2` are in conflict: one is a prefix of the other.
///
/// Mirrors `pathConflictsWithPath` in `src/expr.ts`.
path_conflicts_with_path :: (fn(path1 : ArrayList(String), path2 : ArrayList(String)) -> bool)(
  path_contains_path(path2, path1) || path_contains_path(path1, path2)
);
/// True if any path in `c1` conflicts with any path in `c2`.
///
/// Mirrors `pathCollectionConflictsWithPathCollection` in `src/expr.ts`.
path_collection_conflicts_with_path_collection :: (
  fn(
    c1 : ArrayList(ArrayList(String)),
    c2 : ArrayList(ArrayList(String))
  ) -> bool
)({
  n1 := c1.len();
  n2 := c2.len();
  i := usize(0);
  while(i < n1, {
    p1 := match(c1.get(i),.Some(p) => p,.None => ArrayList(String).new());
    j := usize(0);
    while(j < n2, {
      p2 := match(c2.get(j),.Some(p) => p,.None => ArrayList(String).new());
      if(path_conflicts_with_path(p1, p2), {
        return(true);
      });
      j = (j + usize(1));
    });
    i = (i + usize(1));
  });
  false
});
// ---------------------------------------------------------------------------
// ControlFlowKind
// ---------------------------------------------------------------------------
/// Discriminator for control-flow flag operations.
/// Replaces the TypeScript string literal union `"return" | "unwind" | "break" | "continue"`.
ControlFlowKind :: enum(Return, Unwind, Break, Continue);
derive(ControlFlowKind, Clone, Eq(ControlFlowKind), ToString);
// ---------------------------------------------------------------------------
// ControlFlowFlags
// ---------------------------------------------------------------------------
/// Whether an expression carries control flow.
/// Multiple flags can be simultaneously true (e.g., a cond where some branches
/// return and others unwind).
///
/// Mirrors `ControlFlowFlags` in `src/expr.ts`.
/// All fields use `bool` rather than `Option(bool)` because `false` and
/// TypeScript's `undefined` are semantically equivalent for flag fields.
ControlFlowFlags :: struct(
  return_flag : bool,
  unwind_flag : bool,
  break_flag : bool,
  continue_flag : bool
);
derive(ControlFlowFlags, Clone, Eq(ControlFlowFlags));
/// Create a ControlFlowFlags with exactly one flag set.
///
/// Mirrors `controlFlowOf` in `src/expr.ts`.
///
/// Note: uses mutable flag variables rather than struct literals directly
/// in match arms due to a codegen bug (see issues/struct-literal-in-match-arm-not-assigned.md).
control_flow_of :: (fn(kind : ControlFlowKind) -> ControlFlowFlags)({
  r := false;
  e := false;
  b := false;
  c := false;
  match(
    kind,
    .Return => {
      r = true;
    },
    .Unwind => {
      e = true;
    },
    .Break => {
      b = true;
    },
    .Continue => {
      c = true;
    }
  );
  ControlFlowFlags(return_flag : r, unwind_flag : e, break_flag : b, continue_flag : c)
});
/// True if `cf` has the given flag set.
///
/// Mirrors `hasControlFlow` in `src/expr.ts`.
///
/// Note: uses early-return pattern instead of struct literal in match arm
/// due to codegen bug (see issues/struct-literal-in-match-arm-not-assigned.md).
has_control_flow :: (fn(cf : Option(ControlFlowFlags), kind : ControlFlowKind) -> bool)({
  f := match(
    cf,
    .None => {
      return(false);
    },
    .Some(x) => x
  );
  match(
    kind,
    .Return => f.return_flag,
    .Unwind => f.unwind_flag,
    .Break => f.break_flag,
    .Continue => f.continue_flag
  )
});
/// True if `cf` has any flag set.
///
/// Mirrors `hasAnyControlFlow` in `src/expr.ts`.
has_any_control_flow :: (fn(cf : Option(ControlFlowFlags)) -> bool)({
  f := match(
    cf,
    .None => {
      return(false);
    },
    .Some(x) => x
  );
  f.return_flag || (f.unwind_flag || (f.break_flag || f.continue_flag))
});
/// Union multiple ControlFlowFlags into one (OR of all flags).
///
/// Mirrors `mergeControlFlows` in `src/expr.ts`.
merge_control_flows :: (fn(flows : ArrayList(ControlFlowFlags)) -> ControlFlowFlags)({
  r := false;
  e := false;
  b := false;
  c := false;
  n := flows.len();
  i := usize(0);
  while(i < n, {
    cf := match(
      flows.get(i),
      .Some(f) => f,
      .None => ControlFlowFlags(return_flag : false, unwind_flag : false, break_flag : false, continue_flag : false)
    );
    if(cf.return_flag, {
      r = true;
    });
    if(cf.unwind_flag, {
      e = true;
    });
    if(cf.break_flag, {
      b = true;
    });
    if(cf.continue_flag, {
      c = true;
    });
    i = (i + usize(1));
  });
  ControlFlowFlags(return_flag : r, unwind_flag : e, break_flag : b, continue_flag : c)
});
/// Format ControlFlowFlags as a `+`-joined string for error messages.
///
/// Mirrors `controlFlowToString` in `src/expr.ts`.
control_flow_to_string :: (fn(cf : ControlFlowFlags) -> String)({
  parts := ArrayList(String).new();
  if(cf.return_flag, {
    parts.push(String.from("return"));
  });
  if(cf.unwind_flag, {
    parts.push(String.from("unwind"));
  });
  if(cf.break_flag, {
    parts.push(String.from("break"));
  });
  if(cf.continue_flag, {
    parts.push(String.from("continue"));
  });
  String.from("+").join(parts)
});
// ---------------------------------------------------------------------------
// ComptimeRef
// ---------------------------------------------------------------------------
/// Unified compile-time element/field reference for mutation and pointer creation.
/// Enables compile-time operations like `arr(0) = value`, `&(arr(0))`.
///
/// Mirrors the `ComptimeRef` discriminated union in `src/expr.ts`.
///
/// Each variant stores the inner `ArrayList(EvalValue)` directly rather than
/// the full `EvalValue` wrapper, preserving the type invariant.
/// Mutation works because `ArrayList` is a ref-counted object — copying the
/// variant shares the same underlying list, so writes are visible to all holders.
ComptimeRef :: enum(
  /// Array or slice element.  Mutates `elements[index]`.
  ArrayRef(elements : ArrayList(EvalValue), index : usize),
  /// ComptimeList element.  Mutates `elements[index]`.
  ComptimeListRef(elements : ArrayList(EvalValue), index : usize),
  /// Struct field via ComptimeIndex.  Mutates `field_values[field_index]`.
  StructRef(field_values : ArrayList(EvalValue), field_index : usize),
  /// Tuple field via ComptimeIndex.  Mutates `fields[field_index]`.
  TupleRef(fields : ArrayList(EvalValue), field_index : usize)
);
// No derives for ComptimeRef — ArrayList(EvalValue) fields are mutable ref-counted
// objects shared by reference; deep clone/eq is not needed.
// ---------------------------------------------------------------------------
// RuntimeDestructuring
// ---------------------------------------------------------------------------
/// Runtime destructuring binding produced during evaluation of
/// `{ x, y : another_y } := some_point`.
///
/// Mirrors `RuntimeDestructuring` in `src/expr.ts`.
RuntimeDestructuring :: struct(
  label : String,
  ty : TypeValue,
  variable_name : String
);
derive(RuntimeDestructuring, Clone);
// ---------------------------------------------------------------------------
// ExprInfo
// ---------------------------------------------------------------------------
/// Per-expression annotation object set by the evaluator.
/// Mirrors the `EvaluatedExprData` interface in `src/expr.ts`.
///
/// In TypeScript, this is attached to each `Expr` node via the `$` field.
/// In the Yo self-hosted compiler, `ExprInfo` objects are stored separately;
/// the chosen storage strategy (inline enum field vs. `ExprInfoTable` side-table)
/// is finalised in Phase 3.
///
/// Required fields:
///   `env`             – environment after evaluating this expression.
///   `ty`              – resolved type of this expression.
///   `path_collection` – ownership paths tracked by the evaluator.
///
/// All other fields are optional (`Option(T)`), mirroring TypeScript `field?: T`.
ExprInfo :: ref(
  struct(
    // --- Required ---
    env : Environment,
    ty : TypeValue,
    path_collection : ArrayList(ArrayList(String)),
    // --- Optional ---
    /// Compile-time value; `.None` for runtime expressions.
    value : Option(EvalValue),
    /// Runtime type after comptime-to-runtime conversion (e.g. comptime_str → str).
    // `Box`ed (P2): rarely set (only on comptime→runtime conversion exprs), but
    // `Option(TypeValue)` reserved ~sizeof(TypeValue) inline in every ExprInfo.
    converted_runtime_type : Option(TypeValue),
    /// Name of the temporary variable holding the value in `env`.
    variable_name : Option(String),
    /// Root object type in a property-access chain (used for mutability analysis).
    origin_type : Option(TypeValue),
    /// True when this expression is a property-access dereference (`p.*`).
    is_accessing_property : Option(bool),
    /// Runtime arguments in call order (used by codegen).
    runtime_arg_exprs_in_order : Option(ArrayList(AstExpr)),
    /// Runtime destructuring bindings for `{ x, y } := point`.
    runtime_destructurings : Option(ArrayList(RuntimeDestructuring)),
    /// Control-flow flags (return, unwind, break, continue).
    control_flow : Option(ControlFlowFlags),
    /// Trait values for `dyn()` dynamic dispatch (used by codegen vtable emit).
    dyn_call_trait_values : Option(ArrayList(EvalValue)),
    /// For cond/match: true when this branch was executed.
    case_executed : Option(bool),
    /// True when this match expression dispatches on primitive types (int/bool).
    is_primitive_match : Option(bool),
    /// Compile-time pattern values for primitive match (used by codegen C switch).
    primitive_pattern_values : Option(ArrayList(Option(EvalValue))),
    /// Doc comment preceding this declaration.
    doc_comment : Option(String),
    /// `___dup` call expressions for RC variables captured by a closure.
    deferred_dup_expressions : Option(ArrayList(AstExpr)),
    /// `___drop` call expressions for variables needing cleanup at scope exit.
    deferred_drop_expressions : Option(ArrayList(AstExpr)),
    /// Drop expressions for RC variables consumed by the return value
    /// (needed when `unwind` propagates through the function).
    consumed_variable_drop_expressions : Option(ArrayList(AstExpr)),
    /// Optional runtime stack size expression for `async` spawns.
    // `Box`ed: `Option(AstExpr)` reserved ~sizeof(AstExpr) (~128 B) inline in every
    // ExprInfo even though async-stack analysis isn't wired up yet (always `.None`
    // currently) — boxing reclaims it (P2).
    async_stack_size : Option(AstExpr),
    /// C struct name for the async state machine (used by codegen).
    async_state_machine_struct_name : Option(String),
    /// Capture struct type for closures / async blocks that close over RC vars.
    capture_type : Option(TypeValue),
    /// Await-analysis result for async block expressions.
    await_analysis : Option(AwaitAnalysisResult),
    /// Effect-analysis result for effectful function calls.
    effect_analysis : Option(EffectAnalysisResult),
    /// FunctionValue implementing the closure body.
    closure_function_value : Option(EvalValue),
    /// Evaluated macro-expanded expression.
    macro_expansion : Option(AstExpr),
    /// Environment frame popped after a begin block.
    popped_env_frame : Option(Frame),
    /// Original un-evaluated expression (used for test codegen).
    original_expr : Option(AstExpr),
    /// Variable object for identifier expressions (used by compile-time pointer creation).
    source_variable : Option(Variable),
    /// Compile-time element/field reference for mutation (`arr(0) = v`, `&(arr(0))`).
    comptime_ref : Option(ComptimeRef),
    /// Pointer type returned by the Index trait `index()` method (before auto-deref).
    // `Box`ed (P2): only set on Index-trait dispatch exprs.
    index_trait_ptr_type : Option(TypeValue),
    /// Specialised FunctionType of the Index trait `index()` method.
    // `Box`ed (P2): only set on Index-trait dispatch exprs.
    index_method_type : Option(TypeValue),
    /// Specialised FunctionValue of the Index trait `index()` method.
    index_method_value : Option(EvalValue),
    /// True when `&(value(i))` skips the auto-deref and uses the pointer directly.
    is_index_trait_address_of : Option(bool),
    /// True when the assignment is compile-time only (no C code emitted).
    is_compile_time_only_assignment : Option(bool),
    /// True when `->` / `=>` defines an anonymous function (new function boundary).
    is_anonymous_function_definition : Option(bool),
    /// Unrolled loop bodies for comptime-terminated while loops.
    comptime_unrolled_bodies : Option(ArrayList(AstExpr))
  )
);
/// Create an ExprInfo with the three required fields and all optional fields set to `.None`.
///
/// Mirrors the common pattern of constructing `EvaluatedExprData` with only `env`,
/// `type`, and `pathCollection` set in TypeScript, then populating other fields as needed.
new_expr_info :: (fn(env : Environment, ty : TypeValue) -> ExprInfo)(
  ExprInfo(
    // Snapshot the env's frame LIST (shallow — shares Frame refs) so this
    // recorded env reflects the scope at evaluation time and survives a later
    // in-place `pop_frame` on the live env (e.g. a begin block popping its
    // scope frame). Storing the live env by reference let `pop_frame` corrupt
    // recorded begin-local bindings. See issues/fixed/yo-self-recorded-env-aliasing.md.
    env : snapshot_env(env),
    ty : ty,
    path_collection : ArrayList(ArrayList(String)).new(),
    value : Option(EvalValue).None,
    converted_runtime_type : Option(TypeValue).None,
    variable_name : Option(String).None,
    origin_type : Option(TypeValue).None,
    is_accessing_property : Option(bool).None,
    runtime_arg_exprs_in_order : Option(ArrayList(AstExpr)).None,
    runtime_destructurings : Option(ArrayList(RuntimeDestructuring)).None,
    control_flow : Option(ControlFlowFlags).None,
    dyn_call_trait_values : Option(ArrayList(EvalValue)).None,
    case_executed : Option(bool).None,
    is_primitive_match : Option(bool).None,
    primitive_pattern_values : Option(ArrayList(Option(EvalValue))).None,
    doc_comment : Option(String).None,
    deferred_dup_expressions : Option(ArrayList(AstExpr)).None,
    deferred_drop_expressions : Option(ArrayList(AstExpr)).None,
    consumed_variable_drop_expressions : Option(ArrayList(AstExpr)).None,
    async_stack_size : Option(AstExpr).None,
    async_state_machine_struct_name : Option(String).None,
    capture_type : Option(TypeValue).None,
    await_analysis : Option(AwaitAnalysisResult).None,
    effect_analysis : Option(EffectAnalysisResult).None,
    closure_function_value : Option(EvalValue).None,
    macro_expansion : Option(AstExpr).None,
    popped_env_frame : Option(Frame).None,
    original_expr : Option(AstExpr).None,
    source_variable : Option(Variable).None,
    comptime_ref : Option(ComptimeRef).None,
    index_trait_ptr_type : Option(TypeValue).None,
    index_method_type : Option(TypeValue).None,
    index_method_value : Option(EvalValue).None,
    is_index_trait_address_of : Option(bool).None,
    is_compile_time_only_assignment : Option(bool).None,
    is_anonymous_function_definition : Option(bool).None,
    comptime_unrolled_bodies : Option(ArrayList(AstExpr)).None
  )
);
// ---------------------------------------------------------------------------
// ExprInfoTable
// ---------------------------------------------------------------------------
/// Side-table storing evaluation results for each expression node.
/// Keys are ExprId values assigned during parsing.
/// Mirrors the TypeScript evaluator's inline `expr.$` mutation with an
/// immutable-AST equivalent.
ExprInfoTable :: newtype(data : HashMap(ExprId, ExprInfo));
/// Create a new empty ExprInfoTable.
expr_info_table_new :: (fn() -> ExprInfoTable)(
  ExprInfoTable(data : HashMap(ExprId, ExprInfo).new())
);
/// Store an ExprInfo for the given expression id.
expr_info_table_set :: (fn(table : ExprInfoTable, id : ExprId, info : ExprInfo) -> unit)({
  table.data.set(id, info);
  ()
});
/// Retrieve the ExprInfo for the given expression id, or None.
expr_info_table_get :: (fn(table : ExprInfoTable, id : ExprId) -> Option(ExprInfo))(
  table.data.get(id)
);
// ---------------------------------------------------------------------------
// Method-call callee-type side-table.
//
// Maps a method-CALL expr id → the resolved method's `Func` type. Populated
// during method dispatch (evaluator/calls/function.yo, where the resolved
// `method_info.method_ty` is known) and read by the flowability R3 check
// (types/flowability.yo) as a FALLBACK when the `.`/2 method-callee sub-expr
// has no ExprInfo of its own. yo-self never annotates the callee node with the
// method Func type, and writing it INTO that node's ExprInfo is destructive
// (the node's ExprInfo means property/field-access info — doing so regressed
// `check ./std` 151→15). This non-destructive side-table is the faithful
// equivalent of TS reading `call.func.$.type`. Keyed by `ExprId` (globally
// unique), so one process-wide table is safe. Mutated via `set` (the loader
// makes fresh ctx-keyed ExprInfoTables per module, but this global side-table
// is shared — harmless, ids never collide). See
// issues/yo-self-flowability-swallow.md.
// ---------------------------------------------------------------------------
(g_method_callee_types : HashMap(ExprId, TypeValue)) = HashMap(ExprId, TypeValue).new();
/// Record the resolved method `Func` type for a method-call expr id.
record_method_callee_type :: (fn(call_id : ExprId, ty : TypeValue) -> unit)({
  g_method_callee_types.set(call_id, ty);
  ()
});
/// Look up the resolved method `Func` type for a method-call expr id, if any.
lookup_method_callee_type :: (fn(call_id : ExprId) -> Option(TypeValue))(
  g_method_callee_types.get(call_id)
);
// Method-callee VALUE side-table (parallel to g_method_callee_types). Codegen's
// generate_other_function_call dispatches via the callee's ExprInfo value, but a
// method call's callee dot-access has no ExprInfo (recording one is destructive
// — regressed std). This non-destructive table carries the resolved/specialized
// method FuncVal, keyed by the CALL expr id, so codegen can emit
// `<specialized_c_name>(args)`.
(g_method_callee_values : HashMap(ExprId, EvalValue)) = HashMap(ExprId, EvalValue).new();
/// Record the resolved/specialized method FuncVal for a method-call expr id.
record_method_callee_value :: (fn(call_id : ExprId, v : EvalValue) -> unit)({
  g_method_callee_values.set(call_id, v);
  ()
});
/// Look up the resolved/specialized method FuncVal for a method-call expr id.
lookup_method_callee_value :: (fn(call_id : ExprId) -> Option(EvalValue))(
  g_method_callee_values.get(call_id)
);
// Names of extern-C GLOBAL symbols declared via `c_include` (e.g. `stdout`,
// `stderr`, `stdin`). yo-self models `is_extern` only on the `Func` TypeValue
// variant, so a NON-Func extern global (`stdout : *(FILE)`) cannot carry the FFI
// marker on its type. This registry lets the codegen name-resolver keep the REAL
// C name (skip the `__yo_c_reserved_` reserved-word prefix) for such symbols —
// the C header is `#include`d, so the real `stdout` is in scope. Populated by
// c_include's field loop; read by get_variable_name_for_codegen.
(g_extern_c_globals : HashMap(String, bool)) = HashMap(String, bool).new();
/// Mark `name` as an extern-C global symbol (called by c_include per field).
register_extern_c_global :: (fn(name : String) -> unit)({
  g_extern_c_globals.set(name, true);
  ()
});
/// True if `name` is a c_include'd extern-C global symbol.
is_extern_c_global :: (fn(name : String) -> bool)(
  match(g_extern_c_globals.get(name),.Some(b) => b,.None => false)
);
// Phase 5 (async/effects): the resolved CONCRETE type for a `SomeT`, keyed by the
// SomeT's unique `id`. TS stores this as a mutable `SomeType.resolvedConcreteType`
// field set during return-type resolution / synthesis; yo-self's `SomeT` has no
// such field (codegen otherwise lowers an unresolved SomeT to `void*`), so this
// side-table is the idiomatic eval→codegen bridge (same pattern as
// `g_method_callee_values` / `g_extern_c_globals`). The async-Future codegen needs
// it — e.g. `is_io_future_type` distinguishes an extern `__yo_io_future_t` from a
// state-machine Future by inspecting the resolved concrete type. Keyed by `id`
// (SomeT's first field, unique); spread-construction in TS keeps the same id, so
// id-keying is sound. Populated by mirroring the ~15 TS `resolvedConcreteType` set
// sites; read by the FSM emitters. (Registry foundation — set/read sites are wired
// as the FSM core lands; see plans/BOOTSTRAPPING_CODEGEN.md Phase 5 #3.)
(g_some_resolved_concrete : HashMap(String, TypeValue)) = HashMap(String, TypeValue).new();
/// Record the resolved concrete type for the `SomeT` with unique id `some_id`.
register_some_resolved_concrete :: (fn(some_id : String, ty : TypeValue) -> unit)({
  g_some_resolved_concrete.set(some_id, ty);
  ()
});
/// The resolved concrete type for the `SomeT` with id `some_id`, if recorded.
lookup_some_resolved_concrete :: (fn(some_id : String) -> Option(TypeValue))(
  g_some_resolved_concrete.get(some_id)
);
// Macro-expansion side-table: a macro CALL's expanded form (e.g. `if(c, t, e)` →
// its `cond(...)`), keyed by the call's expr id. yo-self codegen lowers a macro
// call ONLY via `ExprInfo.macro_expansion` (generation.yo) — but that per-pass
// ExprInfo gets OVERWRITTEN across eval passes: a later eval of the same call id
// re-sets its table entry WITHOUT macro_expansion, so codegen then reads `None`
// and emits "Failed to transpile" (this is exactly why every `if(...recur...)`
// fails — confirmed: same id is macro-set once, then read with no expansion).
// TS never loses it because its ExprInfo lives ON the node (`expr.$`), a stable
// per-node property; yo-self's side-table is per-pass churnable. This durable,
// id-keyed table is the faithful equivalent — written once by the macro path,
// read by codegen as a FALLBACK when the per-pass ExprInfo lost it. A macro
// call's expansion is a stable syntactic property of its id, so the record stays
// correct regardless of which pass last touched the ExprInfo. (Same pattern as
// g_method_callee_values / g_some_resolved_concrete above.)
(g_macro_expansions : HashMap(ExprId, AstExpr)) = HashMap(ExprId, AstExpr).new();
/// Record the expanded form for a macro-call expr id.
record_macro_expansion :: (fn(call_id : ExprId, expanded : AstExpr) -> unit)({
  g_macro_expansions.set(call_id, expanded);
  ()
});
/// Look up the expanded form for a macro-call expr id, if recorded.
lookup_macro_expansion :: (fn(call_id : ExprId) -> Option(AstExpr))(
  g_macro_expansions.get(call_id)
);
