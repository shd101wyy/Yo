expr_info_primitive_pattern_values :: (
  fn(info : ExprInfo) -> Option(ArrayList(Option(EvalValue)))
)(
  match(
    info.rare,
    .Some(r) => r.primitive_pattern_values,
    .None => Option(ArrayList(Option(EvalValue))).None
  )
);
expr_info_set_primitive_pattern_values :: (
  fn(info : ExprInfo, v : Option(ArrayList(Option(EvalValue)))) -> unit
)({
  r := _expr_info_rare_for_write(info);
  r.primitive_pattern_values = v;
});
expr_info_consumed_variable_drop_expressions :: (
  fn(info : ExprInfo) -> Option(ArrayList(AstExpr))
)(
  match(
    info.rare,
    .Some(r) => r.consumed_variable_drop_expressions,
    .None => Option(ArrayList(AstExpr)).None
  )
);
expr_info_set_consumed_variable_drop_expressions :: (
  fn(info : ExprInfo, v : Option(ArrayList(AstExpr))) -> unit
)({
  r := _expr_info_rare_for_write(info);
  r.consumed_variable_drop_expressions = v;
});
expr_info_async_stack_size :: (fn(info : ExprInfo) -> Option(AstExpr))(
  match(info.rare, .Some(r) => r.async_stack_size, .None => Option(AstExpr).None)
);
expr_info_set_async_stack_size :: (fn(info : ExprInfo, v : Option(AstExpr)) -> unit)({
