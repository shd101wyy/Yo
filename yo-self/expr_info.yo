expr_info_await_analysis :: (fn(info : ExprInfo) -> Option(AwaitAnalysisResult))(
  match(
    info.rare,
    .Some(r) => r.await_analysis,
    .None => Option(AwaitAnalysisResult).None
  )
);
expr_info_set_await_analysis :: (
  fn(info : ExprInfo, v : Option(AwaitAnalysisResult)) -> unit
)({
