//! evaluator/utils — shared helpers used by multiple evaluator handlers.
//!
//! Ports three utility modules from TypeScript:
//!   - `src/utils.ts`           → `generate_new_temp_variable_name`, `is_temp_variable_name`,
//!                                 `random_id`
//!   - `src/evaluator/utils.ts` → `find_rc_value_owner_relationship`,
//!                                 `throw_expr_is_implicit_variable_error`
//!   - `src/expr.ts`            → `require_expr_not_consumed`,
//!                                 `set_expr_as_needs_to_call_dup` (stub),
//!                                 `attach_temp_variable_to_expr` (stub)

open(import("std/string"));
{ ArrayList }  :: import("std/collections/array_list");
{ HashSet }    :: import("std/collections/hash_set");
{ HashMap }    :: import("std/collections/hash_map");

{ AstExpr, ast_expr_token, ast_expr_id, ast_expr_is_atom,
  make_err_expr }                                            :: import("../expr/expr.yo");
{ ExprInfoTable, expr_info_table_get }                      :: import("../expr/expr_info.yo");
{ Environment, Variable, Frame, new_frame,
  get_variables_from_env, make_err_variable,
  generate_variable_id, add_variable_to_begin_block_frame } :: import("../env/env.yo");
{ Token }                                                    :: import("../lexer/token.yo");
{ EvalContext }                                              :: import("./context.yo");
{ atof }                                                     :: import("std/libc/stdlib");
{ format_error_message, format_error_messages,
  TokenAndError, YoError }                                   :: import("../error/error.yo");
{ Exception }                                                :: import("std/error");
{ EvalValue, is_unknown_val, is_var_ref }                   :: import("./value.yo");
{ TypeValue }                                               :: import("../types/type.yo");
{ are_types_compatible }                                    :: import("../types/compatibility.yo");
{ type_contains_rc_type }                                   :: import("../types/utils.yo");
{ expr_info_table_set }                                     :: import("../expr/expr_info.yo");

// ---------------------------------------------------------------------------
// Temp variable name generation
// ---------------------------------------------------------------------------

/// Global counter for generating unique temp variable names.
/// Mirrors `tempVariableNameCount` in `src/utils.ts`.
(g_temp_counter : usize) = usize(1);

/// Compute the module-specific prefix for temp variables.
///
/// In TypeScript this uses the first 10 characters of SHA-1(modulePath).
/// Here we use a simplified sanitisation: replace every non-alphanumeric
/// character with `_` and take the first 12 bytes, which is unique
/// enough for the yo-self bootstrap.
///
/// Mirrors `generateTempVariableNamePrefix` in `src/utils.ts`.
generate_temp_variable_name_prefix :: (fn(module_path : String) -> String)({
  result := String.new();
  bytes  := module_path.as_bytes();
  n      := bytes.len();
  i      := usize(0);
  taken  := usize(0);
  while(runtime(((i < n) && (taken < usize(12)))), {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    is_alnum := (
      ((b >= u8(97)) && (b <= u8(122))) ||   // 'a'-'z'
      ((b >= u8(65)) && (b <= u8(90)))  ||   // 'A'-'Z'
      ((b >= u8(48)) && (b <= u8(57)))        // '0'-'9'
    );
    if(is_alnum, {
      result.push_byte(b);
    }, {
      result.push_str("_");
    });
    i     = (i + usize(1));
    taken = (taken + usize(1));
  });
  out := `_${result}_temp_`;
  out
});

/// Generate a unique temp variable name for `_` discarded bindings.
///
/// Mirrors `generateNewTempVariableName` in `src/utils.ts`.
generate_new_temp_variable_name :: (fn(module_path : String) -> String)({
  prefix  := generate_temp_variable_name_prefix(module_path);
  count   := g_temp_counter;
  g_temp_counter = (g_temp_counter + usize(1));
  `${prefix}${count.to_string()}`
});

/// Return true if `var_name` was generated by `generate_new_temp_variable_name`
/// for the given `module_path`.
///
/// Mirrors `isTempVariableName` in `src/utils.ts`.
is_temp_variable_name :: (fn(module_path : String, var_name : String) -> bool)({
  prefix := generate_temp_variable_name_prefix(module_path);
  var_name.starts_with(prefix)
});

// ---------------------------------------------------------------------------
// random_id
// ---------------------------------------------------------------------------

/// Global counter for generating module-scoped unique IDs.
/// Mirrors the `moduleIdCounters` map in `src/utils.ts`.
///
/// Note: We use a single global counter (not per-module) for simplicity.
/// The resulting IDs are globally unique and will not satisfy
/// `is_temp_variable_name` (they start with `yo_id_`, not `_…_temp_`).
(g_random_id_counter : usize) = usize(0);

/// Generate a unique ID for a module-scoped value (e.g. recur result names).
///
/// Mirrors `randomId` in `src/utils.ts`.
random_id :: (fn(_module_path : String) -> String)({
  count := g_random_id_counter;
  g_random_id_counter = (g_random_id_counter + usize(1));
  `yo_id_${count.to_string()}`
});

// ---------------------------------------------------------------------------
// attach_temp_variable_to_expr
// ---------------------------------------------------------------------------

/// Attach a generated temp variable to `expr`'s ExprInfo for RC drop-tracking.
///
/// Steps (mirrors `attachTempVariableToExpr` in `src/expr.ts`):
///  1. Look up ExprInfo from `ctx.expr_info_table` by `ast_expr_id(expr)`.
///  2. Choose effective type: use `capture_type` when present and RC-containing
///     and `is_owning_the_rc_value` is true (closure capture struct semantics).
///  3. Determine `_is_owning_rc := is_owning_the_rc_value && type_contains_rc_type(ty)`.
///  4. If `ExprInfo.variable_name` already set: update the existing variable.
///  5. Otherwise: generate a fresh temp name, add to nearest begin-block frame,
///     store name + updated env back in the ExprInfo table.
///
/// Mirrors `attachTempVariableToExpr` in `src/expr.ts`.
attach_temp_variable_to_expr :: (fn(
  expr                    : AstExpr,
  is_owning_the_rc_value  : bool,
  ctx                     : *(EvalContext)
) -> unit)({
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(expr));
  match(info_opt,
    .None => (),
    .Some(info) => {
      // Choose effective type: capture_type for closures with RC captures.
      effective_ty := match(info.capture_type,
        .Some(cap_ty) => cond(
          ((type_contains_rc_type(cap_ty)) && is_owning_the_rc_value) => cap_ty,
          true => info.ty
        ),
        .None => info.ty
      );

      // Only mark as owning if the effective type actually contains RC.
      _is_owning_rc := (is_owning_the_rc_value && type_contains_rc_type(effective_ty));

      // Compute compile-time-only flag and value: owning RC vars are always runtime.
      is_ctonly := cond(_is_owning_rc => false, true => match(info.value, .Some(_) => true, .None => false));
      var_value  := cond(_is_owning_rc => Option(EvalValue).None, true => info.value);

      expr_tok := ast_expr_token(expr);

      match(info.variable_name,
        .Some(existing_name) => {
          // Update the existing variable (if found in env).
          existing_vars := get_variables_from_env(info.env, existing_name);
          if((existing_vars.len() > usize(0)), {
            existing_var := match(existing_vars.get((existing_vars.len() - usize(1))), .Some(v) => v, .None => make_err_variable(info.env));
            // Preserve borrowing: if variable was not owning, keep it not-owning.
            preserved_rc := cond(
              (!(existing_var.is_owning_the_rc_value)) => false,
              true => _is_owning_rc
            );
            existing_var.ty                   = effective_ty;
            existing_var.value                = cond(preserved_rc => Option(EvalValue).None, true => var_value);
            existing_var.is_compile_time_only = cond(preserved_rc => false, true => is_ctonly);
            existing_var.is_owning_the_rc_value = preserved_rc;
            // Update origin_type if not already set.
            match(info.origin_type,
              .None => { info.origin_type = Option(TypeValue).Some(effective_ty); },
              .Some(_) => ()
            );
          }, {
            // Variable name exists but not in env: add it to begin-block frame.
            ___ := add_variable_to_begin_block_frame(
              (&(info.env)), existing_name, effective_ty, var_value,
              is_ctonly, _is_owning_rc, expr_tok
            );
            match(info.origin_type, .None => { info.origin_type = Option(TypeValue).Some(effective_ty); }, .Some(_) => ());
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
          });
        },
        .None => {
          // Create a new temp variable.
          temp_name := generate_new_temp_variable_name(info.env.module_path);
          ___ := add_variable_to_begin_block_frame(
            (&(info.env)), temp_name, effective_ty, var_value,
            is_ctonly, _is_owning_rc, expr_tok
          );
          info.variable_name = Option(String).Some(temp_name);
          match(info.origin_type, .None => { info.origin_type = Option(TypeValue).Some(effective_ty); }, .Some(_) => ());
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
        }
      );
    }
  );
});

// ---------------------------------------------------------------------------
// find_rc_value_owner_relationship
// ---------------------------------------------------------------------------

/// Follow the `is_owning_the_same_rc_value_as` chain to find the root owning
/// variable for the value named in `rhs`'s ExprInfo.
///
/// Returns `.None` if no owner is found or if the chain cycles.
///
/// Mirrors `findRcValueOwnerRelationship` in `src/evaluator/utils.ts`.
find_rc_value_owner_relationship :: (fn(
  rhs : AstExpr,
  env : Environment,
  ctx : *(EvalContext)
) -> Option(Variable))({
  name_opt := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
    .Some(info) => info.variable_name,
    .None       => Option(String).None
  );
  match(name_opt,
    .None => Option(Variable).None,
    .Some(var_name) => {
      vars := get_variables_from_env(env, var_name);
      if((vars.len() == usize(0)), { return(Option(Variable).None); });
      (candidate_opt : Option(Variable)) = Option(Variable).Some(
        match(vars.get((vars.len() - usize(1))), .Some(v) => v, .None => make_err_variable(env))
      );
      visited := HashSet(String).new();
      // Follow the chain until we find an owning variable or it breaks.
      while(runtime(match(candidate_opt,
        .Some(c) => c.is_owning_the_same_rc_value_as.is_some(),
        .None    => false
      )), {
        match(candidate_opt,
          .Some(cand) => {
            if(visited.contains(cand.id), {
              candidate_opt = Option(Variable).None;
              return(candidate_opt);
            });
            visited_add_result := visited.add(cand.id);
            candidate_opt = match(cand.is_owning_the_same_rc_value_as,
              .Some(next_box) => Option(Variable).Some(next_box.*),
              .None           => Option(Variable).None
            );
          },
          .None => ()
        );
      });
      match(candidate_opt,
        .Some(c) => (if(c.is_owning_the_rc_value,
          Option(Variable).Some(c),
          Option(Variable).None)),
        .None    => Option(Variable).None
      )
    }
  )
});

// ---------------------------------------------------------------------------
// throw_expr_is_implicit_variable_error
// ---------------------------------------------------------------------------

/// Throw if `rhs` resolves to an implicit (`given(...)`) variable.
///
/// Implicit variables must be passed via `using()` parameters, not captured
/// through regular assignments.
///
/// Mirrors `throwExprIsImplicitVariableError` in `src/evaluator/utils.ts`.
throw_expr_is_implicit_variable_error :: (fn(
  rhs       : AstExpr,
  env       : Environment,
  ctx       : *(EvalContext),
  using(exn : Exception)
) -> unit)({
  // Determine which variable name to check.
  rhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs));
  (var_name_opt : Option(String)) = Option(String).None;

  // Check path_collection first (property-access chains).
  match(rhs_info_opt,
    .Some(rhs_info) => {
      n := rhs_info.path_collection.len();
      (i : usize) = usize(0);
      while(runtime((i < n)), {
        path := match(rhs_info.path_collection.get(i), .Some(p) => p, .None => ArrayList(String).new());
        if((path.len() > usize(0)), {
          match(path.get(usize(0)),
            .Some(first) => { var_name_opt = Option(String).Some(first); },
            .None        => ()
          );
        });
        i = (i + usize(1));
      });
    },
    .None => ()
  );

  // Fall back to the atom token if no path_collection entry was found.
  if(var_name_opt.is_none(), {
    if(ast_expr_is_atom(rhs), {
      var_name_opt = Option(String).Some(String.from(ast_expr_token(rhs).value.as_str()));
    });
  });

  match(var_name_opt,
    .None => (),
    .Some(var_name) => {
      root_vars := get_variables_from_env(env, var_name);
      match(root_vars.get((root_vars.len() - usize(1))),
        .None     => (),
        .Some(rv) => {
          if(rv.is_implicit, {
            exn.throw(dyn(format_error_message(
              ast_expr_token(rhs),
              `Cannot use implicit variable "${var_name}" in assignment. Implicit variables must be passed via using() parameters.`,
              false,
              .None
            )));
          });
        }
      );
    }
  );
});

// ---------------------------------------------------------------------------
// require_expr_not_consumed
// ---------------------------------------------------------------------------

/// Throw if the variable named by `rhs`'s ExprInfo has already been consumed
/// (moved).
///
/// Mirrors `requireExprNotConsumed` in `src/expr.ts`.
require_expr_not_consumed :: (fn(
  rhs       : AstExpr,
  env       : Environment,
  ctx       : *(EvalContext),
  using(exn : Exception)
) -> unit)({
  name_opt := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
    .Some(info) => info.variable_name,
    .None       => Option(String).None
  );
  match(name_opt,
    .None => (),
    .Some(var_name) => {
      vars := get_variables_from_env(env, var_name);
      if((vars.len() == usize(0)), {
        entries := ArrayList(TokenAndError).new();
        entries.push(TokenAndError(
          token         : ast_expr_token(rhs),
          error_message : `Variable "${var_name}" is not defined.`
        ));
        exn.throw(dyn(format_error_messages(entries, false, .None)));
      });
      v := match(vars.get((vars.len() - usize(1))), .Some(v) => v, .None => make_err_variable(env));
      match(v.consumed_at_token,
        .None => (),
        .Some(consumed_tok) => {
          entries := ArrayList(TokenAndError).new();
          entries.push(TokenAndError(
            token         : ast_expr_token(rhs),
            error_message : `use of moved value: \`${var_name}\``
          ));
          entries.push(TokenAndError(
            token         : consumed_tok,
            error_message : String.from("value moved here")
          ));
          exn.throw(dyn(format_error_messages(entries, false, .None)));
        }
      );
    }
  );
});

// ---------------------------------------------------------------------------
// set_expr_as_needs_to_call_dup  (Phase 2w stub)
// ---------------------------------------------------------------------------

/// Mark `rhs` as needing a `___dup` call to transfer RC ownership.
///
/// Phase 2w stub: no-op.  The full implementation (Phase 3) will insert a
/// deferred `___dup` expression into `ctx.expr_info_table` for `rhs` and
/// may consume a temp-variable owner.
///
/// Mirrors `setExprAsNeedsToCallDup` in `src/expr.ts`.
set_expr_as_needs_to_call_dup :: (fn(
  _rhs : AstExpr,
  _ctx : *(EvalContext)
) -> unit)(());

// ---------------------------------------------------------------------------
// doc_comment_lookup_key_from_token
// ---------------------------------------------------------------------------

/// Build the doc-comment lookup key for a token.
///
/// Matches the format produced by `getDocCommentLookupKey` in
/// `src/doc/extractor.ts`: `"<module_path>:<row>:<column>"`.
doc_comment_lookup_key_from_token :: (fn(tok : Token) -> String)(
  `${tok.module_path}:${tok.row.to_string()}:${tok.column.to_string()}`
);

// ---------------------------------------------------------------------------
// consume_case_body_temp_var
// ---------------------------------------------------------------------------

/// Mark the temporary variable bound by `evaluated_body`'s ExprInfo as
/// consumed at the expression's token.  Only acts if the variable name was
/// generated by `generate_new_temp_variable_name` (i.e. is a temp name).
///
/// In TypeScript this returns a new env (immutable snapshot); in yo-self the
/// `Variable` is an RC object so we mutate `consumed_at_token` in-place.
///
/// Mirrors `consumeCaseBodyTempVar` in `src/expr.ts`.
consume_case_body_temp_var :: (fn(
  evaluated_body : AstExpr,
  env            : Environment,
  ctx            : *(EvalContext)
) -> unit)({
  var_name_opt := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_body)),
    .Some(info) => info.variable_name,
    .None       => Option(String).None
  );
  match(var_name_opt,
    .None => (),
    .Some(var_name) => {
      if(!(is_temp_variable_name(env.module_path, var_name)), { return(()); });
      vars := get_variables_from_env(env, var_name);
      if((vars.len() == usize(0)), { return(()); });
      v := match(vars.get((vars.len() - usize(1))), .Some(x) => x, .None => make_err_variable(env));
      if(v.consumed_at_token.is_none(), {
        // Variable is an RC object; mutation is in-place and visible through env.
        v.consumed_at_token = Option(Token).Some(ast_expr_token(evaluated_body));
      });
    }
  );
});

// ---------------------------------------------------------------------------
// merge_and_check_envs  (Phase 3 implementation)
// ---------------------------------------------------------------------------

/// Reconcile variable states across multiple cond/match branch environments.
///
/// For each variable in the base env:
/// - Adopts temp variables that leaked from case bodies into a shared frame.
/// - Propagates `initialized_at_token` when all cases initialize it.
/// - Propagates `consumed_at_token` when all cases consume it.
/// - Propagates `is_owning_the_rc_value` when all cases own it.
/// - Generates a fresh variable ID when any branch reassigns the variable.
/// - Throws a compile-time error if branches partially consume/initialize or
///   if frame layouts are inconsistent.
///
/// In yo-self, Variable is an object (RC reference); mutations propagate
/// automatically to all holders. `update_existing_variable` is used for
/// the is_owning_the_rc_value update (since it also zeros out is_owning_the_same_rc_value_as).
///
/// Mirrors `mergeAndCheckEnvs` in `src/expr.ts`.
merge_and_check_envs :: (fn(
  env    : Environment,
  bodies : ArrayList(AstExpr),
  ctx    : *(EvalContext),
  using(exn : Exception)
) -> Environment)({
  if((bodies.len() == usize(0)), { return(env); });

  max_frame_level := (env.frames.len() - usize(1));

  // Collect case environments from the expr_info_table.
  case_envs := ArrayList(Environment).new();
  (bi : usize) = usize(0);
  while(runtime((bi < bodies.len())), {
    body := match(bodies.get(bi), .Some(b) => b, .None => make_err_expr());
    info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(body));
    match(info_opt,
      .None => {
        exn.throw(dyn(format_error_message(
          ast_expr_token(body),
          `Expected the body of the case to be evaluated, but it is not.`,
          false,
          .None
        )));
      },
      .Some(info) => {
        case_envs.push(info.env);
      }
    );
    bi = (bi + usize(1));
  });

  // Verify that every case env has the same frame depth as the base env.
  (ci : usize) = usize(0);
  while(runtime((ci < case_envs.len())), {
    case_env := match(case_envs.get(ci), .Some(e) => e, .None => env);
    if(((case_env.frames.len() - usize(1)) != max_frame_level), {
      exn.throw(dyn(format_error_message(
        ast_expr_token(match(bodies.get(ci), .Some(b) => b, .None => make_err_expr())),
        `Frame level is different for different cases.`,
        false,
        .None
      )));
    });
    ci = (ci + usize(1));
  });

  // Process each frame level from 0 to max_frame_level (inclusive).
  (frame_i : usize) = usize(0);
  while(runtime((frame_i <= max_frame_level)), {
    frame_opt := env.frames.get(frame_i);
    match(frame_opt,
      .None => (),
      .Some(frame) => {

        // ---------------------------------------------------------------
        // For each case env, possibly adopt extra temp variables into the
        // base env frame (only for non-innermost frames).
        // ---------------------------------------------------------------
        (cj : usize) = usize(0);
        while(runtime((cj < case_envs.len())), {
          case_env := match(case_envs.get(cj), .Some(e) => e, .None => env);
          case_frame := match(case_env.frames.get(frame_i), .Some(f) => f, .None => new_frame(false));
          case_vars_len := case_frame.variables.len();
          base_vars_len := frame.variables.len();

          if(((frame_i != max_frame_level) && (case_vars_len != base_vars_len)), {
            cond(
              (case_vars_len > base_vars_len) => {
                // Check whether all extra variables are temp variables.
                (all_temps : bool) = true;
                (ek : usize) = base_vars_len;
                while(runtime((ek < case_vars_len)), {
                  extra_var := match(case_frame.variables.get(ek), .Some(v) => v, .None => make_err_variable(env));
                  if(!(is_temp_variable_name(env.module_path, extra_var.name)), {
                    all_temps = false;
                  });
                  ek = (ek + usize(1));
                });
                if(all_temps, {
                  // Adopt extra temps into the base env frame. Adopted temps
                  // must NOT own RC values (each branch handles its own drops).
                  (ek2 : usize) = base_vars_len;
                  while(runtime((ek2 < case_vars_len)), {
                    extra_var2 := match(case_frame.variables.get(ek2), .Some(v) => v, .None => make_err_variable(env));
                    extra_var2.is_owning_the_rc_value = false;
                    { ___ := frame.variables.push(extra_var2); };
                    ek2 = (ek2 + usize(1));
                  });
                }, {
                  exn.throw(dyn(format_error_message(
                    ast_expr_token(match(bodies.get(cj), .Some(b) => b, .None => make_err_expr())),
                    `Frame level ${frame_i} has different number of values for different cases.`,
                    false,
                    .None
                  )));
                });
              },
              true => {
                exn.throw(dyn(format_error_message(
                  ast_expr_token(match(bodies.get(cj), .Some(b) => b, .None => make_err_expr())),
                  `Frame level ${frame_i} has different number of values for different cases.`,
                  false,
                  .None
                )));
              }
            );
          });

          // Check variable name consistency.
          (kk : usize) = usize(0);
          while(runtime((kk < frame.variables.len())), {
            base_var    := match(frame.variables.get(kk),      .Some(v) => v, .None => make_err_variable(env));
            case_var_k  := match(case_frame.variables.get(kk), .Some(v) => v, .None => make_err_variable(env));
            if(
              (((base_var.name != case_var_k.name) && !(is_temp_variable_name(env.module_path, base_var.name))) && !(is_temp_variable_name(env.module_path, case_var_k.name))),
              {
                exn.throw(dyn(format_error_message(
                  ast_expr_token(match(bodies.get(cj), .Some(b) => b, .None => make_err_expr())),
                  `Frame level ${frame_i} has different variable names for different cases.`,
                  false,
                  .None
                )));
              }
            );
            kk = (kk + usize(1));
          });
          cj = (cj + usize(1));
        });

        // ---------------------------------------------------------------
        // For each variable column, check and propagate state.
        // ---------------------------------------------------------------
        (var_j : usize) = usize(0);
        while(runtime((var_j < frame.variables.len())), {
          base_var := match(frame.variables.get(var_j), .Some(v) => v, .None => make_err_variable(env));
          var_name := base_var.name;

          // Collect per-case values for this variable.
          initialized_at_tokens  := ArrayList(Option(Token)).new();
          consumed_at_tokens     := ArrayList(Option(Token)).new();
          owning_at_tokens       := ArrayList(Option(Token)).new();
          var_ids                := ArrayList(String).new();
          case_types             := ArrayList(TypeValue).new();

          (ck : usize) = usize(0);
          while(runtime((ck < case_envs.len())), {
            case_env  := match(case_envs.get(ck), .Some(e) => e, .None => env);
            case_frame_k := match(case_env.frames.get(frame_i), .Some(f) => f, .None => new_frame(false));
            case_var := match(case_frame_k.variables.get(var_j), .Some(v) => v, .None => make_err_variable(env));

            { ___ := initialized_at_tokens.push(case_var.initialized_at_token); };
            { ___ := consumed_at_tokens.push(case_var.consumed_at_token); };
            owning_token := cond(
              case_var.is_owning_the_rc_value => Option(Token).Some(case_var.token),
              true                             => Option(Token).None
            );
            { ___ := owning_at_tokens.push(owning_token); };
            { ___ := var_ids.push(case_var.id); };
            { ___ := case_types.push(case_var.ty); };
            ck = (ck + usize(1));
          });

          n_cases := case_envs.len();

          // ---- Check initialized_at_token ----
          // Case 1: single branch, initialized there but not before → error
          if((n_cases == usize(1)), {
            first_init := match(initialized_at_tokens.get(usize(0)), .Some(v) => v, .None => Option(Token).None);
            match(first_init,
              .Some(_) => {
                match(base_var.initialized_at_token,
                  .None => {
                    exn.throw(dyn(format_error_message(
                      base_var.token,
                      `Variable "${var_name}" might not be initialized in all cases.`,
                      false,
                      .None
                    )));
                  },
                  .Some(_) => ()
                );
              },
              .None => ()
            );
          });
          // Case 2: all cases initialize → propagate to base
          if((n_cases > usize(1)), {
            (all_init : bool) = true;
            (any_init : bool) = false;
            (init_i : usize) = usize(0);
            while(runtime((init_i < n_cases)), {
              tok_opt := match(initialized_at_tokens.get(init_i), .Some(v) => v, .None => Option(Token).None);
              match(tok_opt, .Some(_) => { any_init = true; }, .None => { all_init = false; });
              init_i = (init_i + usize(1));
            });
            if((all_init && !(match(base_var.initialized_at_token, .Some(_) => true, .None => false))), {
              first_tok := match(initialized_at_tokens.get(usize(0)), .Some(v) => v, .None => Option(Token).None);
              match(first_tok, .Some(t) => { base_var.initialized_at_token = Option(Token).Some(t); }, .None => ());
            });
            // Case 3: some init, some don't → error
            if((any_init && !(all_init)), {
              err_list := ArrayList(TokenAndError).new();
              (ei : usize) = usize(0);
              while(runtime((ei < n_cases)), {
                tok_opt := match(initialized_at_tokens.get(ei), .Some(v) => v, .None => Option(Token).None);
                body_tok := ast_expr_token(match(bodies.get(ei), .Some(b) => b, .None => make_err_expr()));
                msg := cond(
                  (ei == usize(0)) => `Variable "${var_name}" might be initialized in some cases but not initialized in other cases:`,
                  match(tok_opt, .Some(_) => true, .None => false) => `Might be initialized here:`,
                  true => `Not initialized here:`
                );
                err_tok := match(tok_opt, .Some(t) => t, .None => body_tok);
                { ___ := err_list.push(TokenAndError(token: err_tok, error_message: msg)); };
                ei = (ei + usize(1));
              });
              exn.throw(dyn(format_error_messages(err_list, false, .None)));
            });
          });

          // ---- Check consumed_at_token ----
          // Case 1: single branch consumed → propagate
          if((n_cases == usize(1)), {
            first_consumed := match(consumed_at_tokens.get(usize(0)), .Some(v) => v, .None => Option(Token).None);
            match(first_consumed,
              .Some(ct) => {
                match(base_var.consumed_at_token,
                  .None => { base_var.consumed_at_token = Option(Token).Some(ct); },
                  .Some(_) => ()
                );
              },
              .None => ()
            );
          });
          // Case 2: all cases consumed → propagate
          if((n_cases > usize(1)), {
            (all_consumed : bool) = true;
            (any_consumed : bool) = false;
            (cons_i : usize) = usize(0);
            while(runtime((cons_i < n_cases)), {
              tok_opt := match(consumed_at_tokens.get(cons_i), .Some(v) => v, .None => Option(Token).None);
              match(tok_opt, .Some(_) => { any_consumed = true; }, .None => { all_consumed = false; });
              cons_i = (cons_i + usize(1));
            });
            if((all_consumed && !(match(base_var.consumed_at_token, .Some(_) => true, .None => false))), {
              first_tok := match(consumed_at_tokens.get(usize(0)), .Some(v) => v, .None => Option(Token).None);
              match(first_tok, .Some(t) => { base_var.consumed_at_token = Option(Token).Some(t); }, .None => ());
            });
            // Case 3: partial consumption → error
            if((any_consumed && !(all_consumed)), {
              err_list := ArrayList(TokenAndError).new();
              (eci : usize) = usize(0);
              while(runtime((eci < n_cases)), {
                tok_opt := match(consumed_at_tokens.get(eci), .Some(v) => v, .None => Option(Token).None);
                body_tok := ast_expr_token(match(bodies.get(eci), .Some(b) => b, .None => make_err_expr()));
                msg := cond(
                  (eci == usize(0)) => `Variable "${var_name}" is consumed in some cases but not in other cases:`,
                  match(tok_opt, .Some(_) => true, .None => false) => `Consumed here:`,
                  true => `Not consumed here:`
                );
                err_tok := match(tok_opt, .Some(t) => t, .None => body_tok);
                { ___ := err_list.push(TokenAndError(token: err_tok, error_message: msg)); };
                eci = (eci + usize(1));
              });
              exn.throw(dyn(format_error_messages(err_list, false, .None)));
            });
          });

          // ---- Check is_owning_the_rc_value ----
          // All cases own → propagate
          (all_owning : bool) = true;
          (any_owning : bool) = false;
          (ow_i : usize) = usize(0);
          while(runtime((ow_i < n_cases)), {
            tok_opt := match(owning_at_tokens.get(ow_i), .Some(v) => v, .None => Option(Token).None);
            match(tok_opt, .Some(_) => { any_owning = true; }, .None => { all_owning = false; });
            ow_i = (ow_i + usize(1));
          });
          if((all_owning && !(base_var.is_owning_the_rc_value)), {
            base_var.is_owning_the_rc_value            = true;
            base_var.is_owning_the_same_rc_value_as    = Option(Box(Variable)).None;
          });
          // Partial ownership → error
          if(((any_owning && !(all_owning)) && !(base_var.is_owning_the_rc_value)), {
            err_list := ArrayList(TokenAndError).new();
            (oei : usize) = usize(0);
            while(runtime((oei < n_cases)), {
              tok_opt := match(owning_at_tokens.get(oei), .Some(v) => v, .None => Option(Token).None);
              body_tok := ast_expr_token(match(bodies.get(oei), .Some(b) => b, .None => make_err_expr()));
              msg := cond(
                (oei == usize(0)) => `Variable "${var_name}" might be holding the Rc value in some cases but not holding the Rc value in other cases:`,
                match(tok_opt, .Some(_) => true, .None => false) => `Might be owning the Rc value here:`,
                true => `Might be not owning the Rc value here:`
              );
              err_tok := match(tok_opt, .Some(t) => t, .None => body_tok);
              { ___ := err_list.push(TokenAndError(token: err_tok, error_message: msg)); };
              oei = (oei + usize(1));
            });
            exn.throw(dyn(format_error_messages(err_list, false, .None)));
          });

          // ---- Handle variable ID reassignment across branches ----
          // If any branch has a different variable ID, generate a new one.
          original_id := base_var.id;
          (has_reassignment : bool) = false;
          (rid_i : usize) = usize(0);
          while(runtime((rid_i < n_cases)), {
            case_id := match(var_ids.get(rid_i), .Some(s) => s, .None => String.from(""));
            if((case_id != original_id), { has_reassignment = true; });
            rid_i = (rid_i + usize(1));
          });
          if(has_reassignment, {
            new_id := generate_variable_id(env.module_path, var_name);
            base_var.id                                = new_id;
            base_var.value                             = Option(EvalValue).None;
            base_var.is_owning_the_same_rc_value_as   = Option(Box(Variable)).None;
          });

          var_j = (var_j + usize(1));
        });
      }
    );
    frame_i = (frame_i + usize(1));
  });

  env
});

// ---------------------------------------------------------------------------
// are_values_equal  (Phase 2ae prerequisite)
// ---------------------------------------------------------------------------

/// Private helper: try to get the concrete (non-runtime) EvalValue from the
/// last entry in a variable lookup list.  Returns .None when the list is
/// empty or the last variable has no compile-time value.
///
/// Mirrors the inline resolution logic in `areValuesEqual` from `src/value.ts`.
_try_resolve_last_var :: (fn(vars : ArrayList(Variable)) -> Option(EvalValue))(
  cond(
    (vars.len() == usize(0)) => Option(EvalValue).None,
    true => match(vars.get((vars.len() - usize(1))),
      .None      => Option(EvalValue).None,
      .Some(last) => match(last.value,
        .None    => Option(EvalValue).None,
        .Some(v) => cond(
          ((is_unknown_val(v)) || (is_var_ref(v))) => Option(EvalValue).None,
          true => Option(EvalValue).Some(v)
        )
      )
    )
  )
);

/// Private helper: get the declared type from the last entry in a variable
/// lookup list.  Used as a fallback when both VarRef values are unresolvable.
_get_last_var_type :: (fn(vars : ArrayList(Variable)) -> Option(TypeValue))(
  cond(
    (vars.len() == usize(0)) => Option(TypeValue).None,
    true => match(vars.get((vars.len() - usize(1))),
      .None       => Option(TypeValue).None,
      .Some(last) => Option(TypeValue).Some(last.ty)
    )
  )
);

/// Compare two evaluated values for equality, resolving runtime VarRef values
/// through their respective environments.
///
/// - For `VarRef` (= TypeScript `UnknownValue` with `variableName`): looks up
///   the most recent binding in the environment and recurses on the resolved
///   value.  When neither side can be resolved, falls back to type
///   compatibility.
/// - For `UnknownVal` (= TypeScript `UnknownValue` without `variableName`):
///   compares the declared types with `are_types_compatible`.
/// - For all other concrete value pairs: delegates to structural `==` (which
///   is backed by `eval_value_eq`).
///
/// Mirrors `areValuesEqual` from `src/value.ts`.
are_values_equal :: (fn(
  val1 : EvalValue,
  env1 : Environment,
  val2 : EvalValue,
  env2 : Environment
) -> bool)(
  match(val1,
    // val1 is VarRef — try to resolve from env1.
    .VarRef(name1) => {
      vars1     := get_variables_from_env(env1, String.from(name1.as_str()));
      resolved1 := _try_resolve_last_var(vars1);
      match(val2,
        // Both VarRef: resolve both and compare; fall back to type compat.
        .VarRef(name2) => {
          vars2     := get_variables_from_env(env2, String.from(name2.as_str()));
          resolved2 := _try_resolve_last_var(vars2);
          match(resolved1,
            .Some(r1) => match(resolved2,
              .Some(r2) => recur(r1, env1, r2, env2),
              .None     => false
            ),
            .None => match(resolved2,
              .Some(_) => false,
              .None    => {
                ty1_opt := _get_last_var_type(vars1);
                ty2_opt := _get_last_var_type(vars2);
                match(ty1_opt,
                  .Some(t1) => match(ty2_opt,
                    .Some(t2) => are_types_compatible(t1, t2),
                    .None     => false
                  ),
                  .None => false
                )
              }
            )
          )
        },
        // val2 is concrete: resolve val1 and compare.
        _ => match(resolved1, .Some(r1) => recur(r1, env1, val2, env2), .None => false)
      )
    },
    // val1 is UnknownVal: compare types with are_types_compatible.
    .UnknownVal(ty1) => match(val2,
      .UnknownVal(ty2) => are_types_compatible(ty1.*, ty2.*),
      _ => false
    ),
    // val1 is a concrete value.
    _ => match(val2,
      // val2 is VarRef: resolve and compare.
      .VarRef(name2) => {
        vars2     := get_variables_from_env(env2, String.from(name2.as_str()));
        resolved2 := _try_resolve_last_var(vars2);
        match(resolved2, .Some(r2) => recur(val1, env1, r2, env2), .None => false)
      },
      // val2 is UnknownVal: not equal to a concrete value.
      .UnknownVal(_) => false,
      // Both concrete: structural equality.
      _ => (val1 == val2)
    )
  )
);

// ---------------------------------------------------------------------------
// Integer and float literal parsing (shared by evaluate_integer_literal
// and evaluate_float_literal; also used by eval.yo Phase 1 evaluator)
// ---------------------------------------------------------------------------

// Convert a single byte to its digit value in the given base.
// Returns None for invalid digits.
_digit_value :: (fn(b : u8, base : i64) -> Option(i64))(
  cond(
    ((b >= u8(48)) && (b <= u8(57))) => {  // '0'-'9'
      d := (i64(b) - i64(48));
      cond((d < base) => .Some(d), true => .None)
    },
    ((b >= u8(97)) && (b <= u8(102))) => {  // 'a'-'f'
      d := ((i64(b) - i64(97)) + i64(10));
      cond((d < base) => .Some(d), true => .None)
    },
    ((b >= u8(65)) && (b <= u8(70))) => {  // 'A'-'F'
      d := ((i64(b) - i64(65)) + i64(10));
      cond((d < base) => .Some(d), true => .None)
    },
    true => .None
  )
);

// Parse `bytes[start..]` as a non-negative integer in the given base.
// Returns None if the slice is empty or contains an invalid digit.
_parse_prefixed_int :: (fn(bytes : ArrayList(u8), start : usize, base : i64) -> Option(i64))({
  n := bytes.len();
  cond(
    (start >= n) => .None,
    true => {
      (result : i64) = i64(0);
      (i : usize) = start;
      (ok : bool) = true;
      while(runtime(((i < n) && ok)), {
        match(bytes.get(i),
          .Some(b) =>
            match(_digit_value(b, base),
              .Some(d) => { result = ((result * base) + d); },
              .None    => { ok = false; }
            ),
          .None => { ok = false; }
        );
        i = (i + usize(1));
      });
      cond(ok => .Some(result), true => .None)
    }
  )
});

/// Parse a raw integer token string to `i64`.
///
/// Handles:
/// - Decimal integers (default)
/// - Hex integers with `0x` / `0X` prefix
/// - Binary integers with `0b` / `0B` prefix
/// - Octal integers with `0o` / `0O` prefix
/// - Underscore separators (e.g. `1_000_000`)
///
/// Returns `None` if the raw string cannot be parsed.
parse_raw_int :: (fn(raw : String) -> Option(i64))({
  stripped := raw.replace_all(`_`, ``);
  cond(
    ((stripped.starts_with(`0x`)) || (stripped.starts_with(`0X`))) =>
      _parse_prefixed_int(stripped.as_bytes(), usize(2), i64(16)),
    ((stripped.starts_with(`0b`)) || (stripped.starts_with(`0B`))) =>
      _parse_prefixed_int(stripped.as_bytes(), usize(2), i64(2)),
    ((stripped.starts_with(`0o`)) || (stripped.starts_with(`0O`))) =>
      _parse_prefixed_int(stripped.as_bytes(), usize(2), i64(8)),
    true => stripped.parse_i64()
  )
});

/// Parse a raw float token string (e.g. `"3.14"`, `"1e-5"`) to `f64`.
/// Uses `atof` from the C standard library.
/// Returns `None` if the string has no valid C-string representation.
parse_raw_float :: (fn(raw : String) -> Option(f64))({
  cs := raw.to_cstr();
  match(cs.ptr(),
    .Some(ptr) => .Some(atof(*(char)(ptr))),
    .None       => .None
  )
});

export(generate_new_temp_variable_name, is_temp_variable_name, random_id);
export(find_rc_value_owner_relationship);
export(throw_expr_is_implicit_variable_error);
export(require_expr_not_consumed);
export(set_expr_as_needs_to_call_dup);
export(attach_temp_variable_to_expr);
export(doc_comment_lookup_key_from_token);
export(consume_case_body_temp_var, merge_and_check_envs);
export(are_values_equal);
export(parse_raw_int, parse_raw_float);
