//! Trait checking functions.
//!
//! 1:1 port of `src/evaluator/trait-checking.ts`.
//!
//! Provides `type_implements_trait` (the core function) and all helpers:
//! `type_implements_comptime`, `type_implements_runtime`,
//! `type_implements_fn`, `type_implements_future`,
//! `extract_fn_trait_from_type`, `extract_future_trait_from_type`,
//! `type_implements_send`, `type_implements_dispose`,
//! `type_implements_acyclic`, `validate_type_availability`,
//! `find_some_type_missing_comptime_constraint`,
//! `check_type_implements_self_constraints`.
//!
//! Phase 3 stubs (returns conservative fallback):
//!   * `_find_associated_type_from_generic_impls` — always returns false
//!   * `synthesize_types` calls in `type_implements_trait` step 3 and
//!     `_check_associated_type_constraints` are deferred; env binding
//!     propagation is not yet implemented (returns original env unchanged).
//!
//! Ported in this commit:
//!   * `mark/unmark_concrete_impl_being_registered` and
//!     `_is_concrete_impl_being_registered` now use a real HashMap-backed
//!     registry instead of returning false. Mirrors TS `currentlyRegisteringConcreteImpls`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ Exception } :: import("std/error");
{ TypeValue, FuncMeta } :: import("../types/definitions.yo");
{ is_function_type, is_some_type, is_pointer_type, is_struct_type, is_extern_type_name } :: import("../types/guards.yo");
{
  is_fn_trait_type,
  is_future_trait_type,
  is_dyn_type,
  is_type_hierarchy_type
} :: import("../types/guards.yo");
{ are_types_compatible, set_compat_type_implements_trait_fn } :: import("../types/compatibility.yo");
{
  get_trait_type_from_env,
  get_value_of_some_type_from_env
} :: import("../types/env_lookup.yo");
{
  type_contains_some_type,
  type_implements_runtime_builtin
} :: import("../types/utils.yo");
{ type_to_string } :: import("../types/string.yo");
{ Environment, get_where_clause_constraints_for_some_type } :: import("../env.yo");
{ Token } :: import("../token.yo");
{ YoError, ErrorKind, format_error_message } :: import("../error.yo");
{
  find_matching_generic_impl,
  find_matching_negative_generic_impl,
  set_type_implements_trait_full_fn,
  set_register_trait_value_fn,
  set_check_self_constraints_fn,
  is_concrete_impl_being_registered,
  mark_concrete_impl_being_registered : impl_mark_concrete_impl_being_registered,
  unmark_concrete_impl_being_registered : impl_unmark_concrete_impl_being_registered,
  has_negative_impl,
  get_trait_key,
  find_associated_type_from_generic_impls
}
:: import("./values/impl.yo");
{
  synthesize_types,
  TypePair,
  SynthesizeOptions
} :: import("./types/synthesizer.yo");
{ type_id_or_empty, get_type_trait_methods_by_name } :: import("./values/type_trait_methods.yo");
// ---------------------------------------------------------------------------
// Auto-derived trait registry (folded from former
// `evaluator/types/trait_registry.yo`).
//
// In `src/`, auto-derived trait info is set as a field on the TypeValue
// directly at struct/enum/union construction in `src/evaluator/types/utils.ts`.
// In yo-self this is stored as a side-table keyed by type id, registered
// at the same construction sites (callers in `evaluator/types/utils.yo`)
// and queried by `type_implements_trait` step 4 below.
// ---------------------------------------------------------------------------
/// Maps type id → list of trait TYPE VALUES the type implements (auto-derived).
///
/// FAITHFUL to TS: TS attaches the derived traits as fields on the type
/// (`receiverType.trait.fields`, each field's `assignedValue` is the trait VALUE;
/// `attachTraitToReceiverType`, utils.ts:1268) and `typeImplementsTrait` matches
/// them by `areTypesCompatible` — by trait IDENTITY, never by name. yo-self
/// stores the same trait VALUES in a type-id-keyed side-table (the `Func`/struct
/// TypeValue can't carry the field without a definitions↔env-style coupling; the
/// side-table is the documented yo-self pattern) and matches via
/// `are_types_compatible`. This supersedes the earlier name-keyed registry, which
/// was unqueryable because yo-self trait values are nameless.
(g_type_trait_registry : HashMap(String, ArrayList(TypeValue))) =
  HashMap(String, ArrayList(TypeValue)).new();
/// Register that the type `type_id` auto-derives the marker trait named
/// `trait_name`, resolved to its canonical env trait VALUE (mirrors TS pushing
/// the trait value onto `receiverType.trait.fields`). If the trait isn't in
/// scope yet (rare — e.g. a struct defined before the marker trait), skip
/// silently, exactly as TS `attachTraitToReceiverType` skips via try/catch.
/// Called during struct/enum/union construction by `evaluator/types/utils.yo`.
register_type_trait :: (fn(type_id : String, trait_name : str, env : Environment) -> unit)({
  match(
    get_trait_type_from_env(env, String.from(trait_name)),
    .Some(trait_ty) => {
      match(
        g_type_trait_registry.get(type_id),
        .Some(list) => {
          _push := list.push(trait_ty);
        },
        .None => {
          new_list := ArrayList(TypeValue).new();
          _push2 := new_list.push(trait_ty);
          _set := g_type_trait_registry.set(type_id, new_list);
        }
      );
    },
    .None => ()
  );
});
/// Register that `type_id` implements the trait VALUE `trait_ty` directly
/// (mirrors TS pushing the impl'd trait onto `receiverType.trait.fields`). Used
/// by impl.yo when a concrete `impl(T, SomeTrait(...))` is registered, so
/// `Type.impls(T, SomeTrait)` resolves by id at step 4 — the base trait id
/// `trait_ty` carries matches the id the query evaluates `SomeTrait` to.
register_type_trait_value :: (fn(type_id : String, trait_ty : TypeValue) -> unit)({
  match(
    g_type_trait_registry.get(type_id),
    .Some(list) => {
      _push := list.push(trait_ty);
    },
    .None => {
      new_list := ArrayList(TypeValue).new();
      _push2 := new_list.push(trait_ty);
      _set := g_type_trait_registry.set(type_id, new_list);
    }
  );
});
/// Extract a trait's stable identity string: the `id` field for `TraitT`, the
/// `base_name` for Fn/Future traits. Defined here (above its first use) because
/// yo-self has no forward references.
_trait_type_id :: (fn(ty : TypeValue) -> String)(
  match(
    ty,
    .TraitT(_, _, _, _, id, _, _, _, _, _) => id,
    .FnTraitT(base_name, _, _, _, _, _, _, _) => base_name,
    .FutureTraitT(base_name, _, _, _, _) => base_name,
    _ => String.from("")
  )
);
/// Check whether `type_id` is registered as implementing `query_trait`, matched
/// by trait `id` (mirrors TS `typeImplementsTrait`'s identity comparison —
/// `expected.id === given.id`, compatibility.ts:543-549). The registry holds the
/// type's auto-derived markers (each a distinct prelude `trait()` with a stable
/// id) AND, since the trait-identity overhaul, the traits of its concrete impls
/// (via `register_type_trait_value`, carrying the base trait id). All are looked
/// up so the registered id and the query id match exactly. NOT
/// `are_types_compatible`: yo-self's `TraitT` compatibility is name-based and
/// every marker is nameless (empty name), so it would treat EVERY marker as
/// mutually compatible — wrongly reporting e.g. a plain object as `Send`.
is_type_registered_as_trait :: (fn(type_id : String, query_trait : TypeValue, env : Environment) -> bool)(
  match(
    g_type_trait_registry.get(type_id),
    .None => false,
    .Some(list) => {
      n := list.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      query_id := _trait_type_id(query_trait);
      while((i < n) && !(found), {
        reg := match(list.get(i),.Some(t) => t,.None => TypeValue.Unit);
        if(query_id == _trait_type_id(reg), {
          found = true;
        });
        i = (i + usize(1));
      });
      found
    }
  )
);
// ---------------------------------------------------------------------------
// TraitCheckResult — mirrors { implemented: boolean; env: Environment }
// ---------------------------------------------------------------------------
/// Return type of `type_implements_trait`.
///
/// Mirrors the `{ implemented: boolean; env: Environment }` return type of
/// `typeImplementsTrait` in `src/evaluator/trait-checking.ts`.
TraitCheckResult :: struct(
  implemented : bool,
  env : Environment
);
/// Return type of `_check_associated_type_constraints`.
///
/// Mirrors `{ satisfied: boolean; env: Environment }`.
AssocTypeCheckResult :: struct(
  satisfied : bool,
  env : Environment
);
// ---------------------------------------------------------------------------
// Global recursion guard for type_implements_trait
// ---------------------------------------------------------------------------
/// Recursion guard to prevent infinite loops when checking trait implementations.
/// Mirrors `traitCheckRecursionGuard: Set<string>` in TypeScript.
(g_trait_check_recursion_guard : ArrayList(String)) = ArrayList(String).new();
/// On-demand marker re-derivation guard (step 4b): prevents infinite recursion
/// when recomputing an auto-derived marker from a self-referential type's fields
/// (e.g. `ListNode(_next : Option(Self))`). Keyed by `${type_id}:${trait_id}`.
(g_ondemand_marker_guard : ArrayList(String)) = ArrayList(String).new();
/// Send derivation in-progress set.
/// Mirrors `sendDerivationInProgress: Set<string>` in TypeScript.
(g_send_derivation_in_progress : ArrayList(String)) = ArrayList(String).new();
// ---------------------------------------------------------------------------
// Helper: extract trait ID
// ---------------------------------------------------------------------------
/// Extract the nominal ID string from a trait TypeValue.
/// Only `TraitT` has an explicit `id` field; `FnTraitT`/`FutureTraitT` use
/// their `base_name` as a key (they cannot be the `Comptime`/`Runtime` traits).
/// Identify which auto-derived MARKER trait `trait_type` is, by comparing its id
/// against the fixed env marker set (Send/Comptime/Acyclic/Runtime/Rc); returns
/// the marker name, or "" if it isn't one. Used by the step-4b on-demand
/// re-derivation, which selects per-marker field rules. (The registry lookup
/// itself matches by trait VALUE, not name — see `is_type_registered_as_trait`.)
_marker_name_of :: (fn(trait_type : TypeValue, env : Environment) -> String)({
  tid := _trait_type_id(trait_type);
  if(tid.is_empty(), {
    return(String.from(""));
  });
  markers := ArrayList(String).new();
  ___m0 := markers.push(String.from("Send"));
  ___m1 := markers.push(String.from("Comptime"));
  ___m2 := markers.push(String.from("Acyclic"));
  ___m3 := markers.push(String.from("Runtime"));
  ___m4 := markers.push(String.from("Rc"));
  (i : usize) = usize(0);
  (found : String) = String.from("");
  while((i < markers.len()) && found.is_empty(), {
    marker := match(markers.get(i),.Some(m) => m,.None => String.from(""));
    match(
      get_trait_type_from_env(env, marker.clone()),
      .Some(mt) => if(_trait_type_id(mt) == tid, {
        found = marker.clone();
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// True if the on-demand re-derivation guard currently holds `key`
/// (`${type_id}:${trait_id}`). Used by step 4b to break cycles on
/// self-referential types.
_ondemand_guard_contains :: (fn(key : String) -> bool)({
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < g_ondemand_marker_guard.len()) && !(found), {
    match(
      g_ondemand_marker_guard.get(i),
      .Some(k) => if(k == key, {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Extract the unique structural ID from a struct/enum/union TypeValue.
/// Returns "" for non-nominal types.
///
/// Distinct from `_trait_type_id` which extracts IDs from trait types.
_type_id_for_trait_check :: (fn(ty : TypeValue) -> String)(
  match(
    ty,
    // `type_id_or_empty` has no Union arm — keep the name-keyed special case.
    .Union(name, _, _) => name,
    // SomeT: must mirror `type_id_or_empty` (the REGISTRATION key in
    // impl.yo) — a manual `impl(X, Send())` on an extern opaque type
    // declaration (`extern("Yo", X : Type)` binds X to a SomeT placeholder,
    // e.g. std/sync/mutex.yo's `impl(__YO_THREAD_SYNC_TYPE, Send())`)
    // registers under the SomeT's id; returning `""` here skipped the
    // registry lookup entirely, so `Type.impls(X, Send)` was always false
    // and Mutex(i32)'s Send field-derivation failed on `_handle`. TS can't
    // diverge this way: both sides use the same type OBJECT's
    // `.trait.fields`. A never-impl'd SomeT (ordinary generic param) has a
    // fresh `sometype_<random>` id that simply misses the registry and
    // falls through to the where-clause/resolution steps as before.
    // Everything else must mirror `type_id_or_empty` (the REGISTRATION key
    // in impl.yo) EXACTLY — Struct/EnumT/SomeT ids AND the primitive
    // synthetic ids (`__yo_t_bool`, `__yo_t_usize`, `str`, ...). The old
    // hand-rolled copy here covered Struct/EnumT/SomeT but returned `""` for
    // primitives, so step 4 (registry lookup) was SKIPPED for every
    // primitive target: `bool <: LogicalNot` came back false even though
    // `impl(bool, LogicalNot(...))` registered fine under `__yo_t_bool` —
    // which made the prelude `(!)` operator module's `_Self : (LogicalNot)`
    // param reject a bool operand in the concrete-vs-constrained-SomeT
    // compat rule. TS can't diverge this way: both sides use the same type
    // OBJECT's `.trait.fields`.
    _ => type_id_or_empty(ty)
  )
);
// ---------------------------------------------------------------------------
// type_implements_comptime_builtin
// ---------------------------------------------------------------------------
/// Tag-only fast path for the Comptime trait.
///
/// Returns:
///   * `Some(true)`  — type definitely implements Comptime
///   * `Some(false)` — type definitely does NOT implement Comptime
///   * `.None`       — undecided (caller must check the `Comptime` trait in env)
///
/// Mirrors `typeImplementsComptimeBuiltin` in `src/evaluator/trait-checking.ts`.
type_implements_comptime_builtin :: (fn(ty : TypeValue) -> Option(bool))(
  match(
    ty,
    // Source-namespace structs (modules) — always comptime. Object types
    // (reference semantics) — always runtime, never comptime.
    .Struct({ is_reference_semantics : is_ref, is_source_namespace : t_sns }) => cond(
      t_sns => Option(bool).Some(true),
      is_ref => Option(bool).Some(false),
      true => Option(bool).None
    ),
    // Comptime-only types — always comptime.
    .ComptimeInt => Option(bool).Some(true),
    .ComptimeFloat => Option(bool).Some(true),
    .ComptimeString => Option(bool).Some(true),
    .TypeUni(_) => Option(bool).Some(true),
    .TraitT(name : _) => Option(bool).Some(true),
    .FnTraitT(base_name : _) => Option(bool).Some(true),
    .FutureTraitT(base_name : _) => Option(bool).Some(true),
    .ExprT => Option(bool).Some(true),
    .ComptimeListT(_) => Option(bool).Some(true),
    // Runtime-only types — not comptime.
    .IsoT(_) => Option(bool).Some(false),
    .DynT(_, _, _, _) => Option(bool).Some(false),
    .Void => Option(bool).Some(false),
    .Union(_, _, _) => Option(bool).Some(false),
    .CChar => Option(bool).Some(false),
    .CShort => Option(bool).Some(false),
    .CUShort => Option(bool).Some(false),
    .CInt => Option(bool).Some(false),
    .CUInt => Option(bool).Some(false),
    .CLong => Option(bool).Some(false),
    .CULong => Option(bool).Some(false),
    .CLongLong => Option(bool).Some(false),
    .CULongLong => Option(bool).Some(false),
    .CLongDouble => Option(bool).Some(false),
    // Primitives available in both contexts — comptime-capable.
    .Unit => Option(bool).Some(true),
    .BoolT => Option(bool).Some(true),
    .Usize => Option(bool).Some(true),
    .Isize => Option(bool).Some(true),
    .Int(_, _) => Option(bool).Some(true),
    .Float(_) => Option(bool).Some(true),
    .Str => Option(bool).Some(true),
    .Func({ result : _ }) => Option(bool).Some(true),
    // Undecided — env / Comptime trait lookup needed.
    _ => Option(bool).None
  )
);
// ---------------------------------------------------------------------------
// type_implements_send_builtin / type_implements_acyclic_builtin
// ---------------------------------------------------------------------------
/// Tag-only fast path for the Send / Acyclic marker traits on PRIMITIVE leaves.
///
/// In TS every type carries a `.trait` field listing its auto-derived markers,
/// so a bare `i32`/`bool` resolves Send via `targetType.trait.fields`. yo-self
/// instead stores auto-derive results in a registry keyed by NOMINAL type id
/// (`g_type_trait_registry`), which cannot hold primitives (they have no id),
/// and — like the existing Comptime/Runtime builtins — relies on a tag-only fast
/// path for primitive leaves. Without this, `type_implements_send(i32)` was
/// false, so `_all_fields_implement_send` failed for any value struct with a
/// primitive field, and `where(T <: Send)` over-rejected primitives directly
/// (e.g. `Channel(bool)`).
///
/// Returns `Some(true)` for unconditionally-Send/Acyclic value & comptime-data
/// leaves; `.None` for nominal (Struct/EnumT/Union — defer to the auto-derive
/// registry) and structural/conditional types (Iso/Dyn/Pointer/Func — defer to
/// generic-impl matching / where-constraints).
/// Returns Some(true) for EXACTLY the primitives the prelude declares
/// `impl(<prim>, Send())` for: `unit, void, bool, i8..i64, u8..u64, f32, f64,
/// isize, usize, char`. yo-self can't register these via the type-id-keyed
/// auto-derive registry (primitives have no id), and unlike TS — which carries
/// the impl on the type's `.trait` — there's no per-type slot, so this builtin
/// encodes the prelude's primitive Send impls. NOT comptime_int/float/string
/// (those have only `impl(_, Acyclic())`, no Send), NOT other C scalar types,
/// NOT type-level values — none of which the prelude marks Send. `.None` =
/// defer to the registry / generic impls (nominal types, `*(T)`, etc.).
type_implements_send_builtin :: (fn(ty : TypeValue) -> Option(bool))(
  match(
    ty,
    .Unit => Option(bool).Some(true),
    .Void => Option(bool).Some(true),
    .BoolT => Option(bool).Some(true),
    .Usize => Option(bool).Some(true),
    .Isize => Option(bool).Some(true),
    .Int(_, _) => Option(bool).Some(true),
    .Float(_) => Option(bool).Some(true),
    .Str => Option(bool).Some(true),
    .CChar => Option(bool).Some(true),
    // Everything else defers (incl. comptime_*, other C types, type-level —
    // the prelude declares no `impl(_, Send())` for those).
    _ => Option(bool).None
  )
);
/// Returns Some(true) for EXACTLY the primitives the prelude declares
/// `impl(<prim>, Acyclic())` for: the Send set PLUS `comptime_int,
/// comptime_float, comptime_str, Expr` (comptime data + Expr are acyclic but
/// NOT Send). NOT other C scalar types, NOT type-level values. Same rationale as
/// the Send builtin (encodes the prelude's primitive Acyclic impls).
type_implements_acyclic_builtin :: (fn(ty : TypeValue) -> Option(bool))(
  match(
    ty,
    .Unit => Option(bool).Some(true),
    .Void => Option(bool).Some(true),
    .BoolT => Option(bool).Some(true),
    .Usize => Option(bool).Some(true),
    .Isize => Option(bool).Some(true),
    .Int(_, _) => Option(bool).Some(true),
    .Float(_) => Option(bool).Some(true),
    .Str => Option(bool).Some(true),
    .CChar => Option(bool).Some(true),
    .ComptimeInt => Option(bool).Some(true),
    .ComptimeFloat => Option(bool).Some(true),
    .ComptimeString => Option(bool).Some(true),
    .ExprT => Option(bool).Some(true),
    _ => Option(bool).None
  )
);
// ---------------------------------------------------------------------------
// Phase 3 stubs
// ---------------------------------------------------------------------------
/// Checks if any registered generic impl matches the (target, trait_ty) pair.
_find_matching_generic_impl :: (fn(target : TypeValue, trait_ty : TypeValue, env : Environment) -> bool)(
  find_matching_generic_impl(target, trait_ty, env)
);
// `findAssociatedTypeFromGenericImpls` is real now — imported from
// `values/impl.yo` as `find_associated_type_from_generic_impls`.
/// Returns true if (type_id, trait_id) is currently being registered.
/// Delegates to the registry in `evaluator/values/impl.yo` (where TS
/// keeps `currentlyRegisteringConcreteImpls`). Used to handle recursive
/// types — e.g. `impl(TreeNode, Clone(...))` whose function bodies
/// validate `TreeNode <: Clone` before the impl is formally registered.
///
/// Mirrors `isConcreteImplBeingRegistered` in
/// `src/evaluator/values/impl.ts:825-832`.
_is_concrete_impl_being_registered :: (fn(type_id : String, trait_id : String) -> bool)(
  is_concrete_impl_being_registered(type_id, trait_id)
);
// ---------------------------------------------------------------------------
// _check_associated_type_constraints
// ---------------------------------------------------------------------------
/// Bind SomeTypes in `constraint_ty` against `resolved_ty` and return the
/// updated env — the `synthesizeTypes(constraintType, resolvedType)` call in
/// TS `checkAssociatedTypeConstraints` (trait-checking.ts:315-320). Returns
/// `.None` when synthesis throws (compat already passed, so a throw here is
/// a no-binding situation, not an error).
_assoc_synth_env :: (
  fn(
    constraint_ty : TypeValue,
    resolved_ty : TypeValue,
    env : Environment
  ) -> Option(Environment)
)({
  exn_s := Exception(
    throw : (
      (err) -> {
        err;
        unwind(Option(Environment).None);
      }
    )
  );
  checked := ArrayList(TypePair).new();
  sr := synthesize_types(
    constraint_ty,
    env,
    resolved_ty,
    env,
    checked,
    Option(SynthesizeOptions).None,
    exn_s
  );
  Option(Environment).Some(sr.expected_env)
});
/// Check if a concrete type satisfies associated type constraints on a
/// specialized trait — e.g. for `Iterator(Item := i32)`, verify the target's
/// `Iterator.Item` resolves to `i32`. Propagates SomeType bindings produced by
/// matching constraint types against resolved associated types (`Item := A`
/// against `Item = i32` binds `A := i32` via `synthesize_types`).
///
/// Mirrors `checkAssociatedTypeConstraints` in `src/evaluator/trait-checking.ts:240`.
///
/// Adaptation: TS step 1 reads `targetType.trait.fields` (concrete trait VALUES
/// attached to the type). yo-self's concrete registry (`g_type_trait_registry`)
/// stores only trait TYPES, so the associated-type VALUE is resolved through the
/// generic impl registry (`find_associated_type_from_generic_impls`), which is
/// where every std iterator/collection impl registers.
_check_associated_type_constraints :: (
  fn(
    target_type : TypeValue,
    trait_type : TypeValue,
    env : Environment
  ) -> AssocTypeCheckResult
)({
  atc_labels := match(
    trait_type,
    .TraitT(_, _, _, _, _, _, _, _, l, _) => l,
    _ => ArrayList(String).new()
  );
  atc_types := match(
    trait_type,
    .TraitT(_, _, _, _, _, _, _, _, _, t) => t,
    _ => ArrayList(TypeValue).new()
  );
  n_atc := atc_labels.len();
  if(n_atc == usize(0), {
    return(AssocTypeCheckResult(satisfied : true, env : env));
  });
  (cur_env : Environment) = env;
  (ok : bool) = true;
  (ci : usize) = usize(0);
  while((ci < n_atc) && ok, {
    label := match(atc_labels.get(ci),.Some(l) => l,.None => String.from(""));
    constraint_ty := match(atc_types.get(ci),.Some(t) => t,.None => TypeValue.Unit);
    // TS step 1: the target's OWN trait fields (a CONCRETE impl's
    // `Item : i32` — TS reads `targetType.trait.fields[].assignedValue`,
    // trait-checking.ts:257-286). yo-self's equivalent store is the
    // type-trait-methods registry: impl-provided associated types are
    // registered there under the receiver's type id with a TypeVal value
    // (the same source property_access's assoc-type fallback (b) reads).
    // Without this arm, a concrete impl's assoc constraint check fell
    // through to the GENERIC-impl registry only and reported e.g.
    // `CountIter <: Iterator(Item := A)` as unimplemented
    // (tests/iter_filter_closure — the batch `filter` where-clause).
    (resolved_opt : Option(TypeValue)) = Option(TypeValue).None;
    {
      atc_tid := type_id_or_empty(target_type);
      if(atc_tid != "", {
        atc_entries := get_type_trait_methods_by_name(atc_tid, label);
        (ae_i : usize) = usize(0);
        while((ae_i < atc_entries.len()) && resolved_opt.is_none(), {
          match(
            atc_entries.get(ae_i),
            .Some(ae) => match(
              ae.value,
              .Some(aev) => match(
                aev,
                .TypeVal(ae_t) => {
                  resolved_opt = Option(TypeValue).Some(ae_t);
                },
                _ => ()
              ),
              .None => ()
            ),
            .None => ()
          );
          ae_i = (ae_i + usize(1));
        });
      });
    };
    // TS step 2: the generic impl registry (see the adaptation note above).
    if(resolved_opt.is_none(), {
      resolved_opt = find_associated_type_from_generic_impls(target_type, label, cur_env);
    });
    match(
      resolved_opt,
      .None => {
        ok = false;
      },
      .Some(resolved) => {
        // Argument ROLES matter: yo-self's signature is (actual, expected)
        // while TS's is (expected, given) — TS passes expected=constraintType,
        // given=resolvedType (trait-checking.ts:306-311), so the resolved
        // associated type is the ACTUAL and the constraint is the EXPECTED.
        // With the roles swapped, `Item := A` (constraint = unbound SomeT A)
        // against resolved `i32` missed the concrete-vs-SomeT wildcard rule
        // and the whole trait check reported "does not implement Iterator"
        // (the tests/closure_capture_rc_leak `any` where-clause).
        if(!(are_types_compatible(resolved, constraint_ty)), {
          ok = false;
        }, {
          // Propagate SomeType bindings from constraint matching
          // (`Item := A` resolved to `i32` → binds A := i32).
          match(
            _assoc_synth_env(constraint_ty, resolved, cur_env),
            .Some(e2) => {
              cur_env = e2;
            },
            .None => ()
          );
        });
      }
    );
    ci = (ci + usize(1));
  });
  AssocTypeCheckResult(satisfied : ok, env : cur_env)
});
// ---------------------------------------------------------------------------
// type_implements_trait
// ---------------------------------------------------------------------------
/// Check if a type implements a specific trait.
///
/// Returns both an `implemented` bool and the updated `env` with any type
/// bindings inferred during trait matching propagated back (Phase 3: binding
/// propagation via `synthesize_types` is deferred; env is returned unchanged).
///
/// Use `type_implements_trait_bool` when only the boolean result is needed.
///
/// Mirrors `typeImplementsTrait` in `src/evaluator/trait-checking.ts`.
type_implements_trait :: (
  fn(
    target_type : TypeValue,
    trait_type : TypeValue,
    env : Environment
  ) -> TraitCheckResult
)({
  (target : TypeValue) = target_type;
  // 0. Phase N: Negative-impl check — runs first, authoritative. If the type
  // has a registered negative impl for this trait, it does NOT implement the
  // trait regardless of auto-derive. Mirrors `trait-checking.ts:345-358`.
  // Concrete negative impls are keyed `type_id_or_empty:get_trait_key`
  // (registration site impl.yo). Generic negative impls
  // (`impl(generic(T), Pattern, !(Trait))`) are matched structurally via
  // `find_matching_negative_generic_impl` (TS findMatchingNegativeGenericImpl).
  if(has_negative_impl(type_id_or_empty(target), get_trait_key(trait_type)), {
    return(TraitCheckResult(implemented : false, env : env));
  });
  if(find_matching_negative_generic_impl(target, trait_type, env), {
    return(TraitCheckResult(implemented : false, env : env));
  });
  // 1. Comptime builtin fast path.
  match(
    get_trait_type_from_env(env, String.from("Comptime")),
    .None => (),
    .Some(ct) => {
      if(_trait_type_id(trait_type) == _trait_type_id(ct), {
        match(
          type_implements_comptime_builtin(target),
          .Some(b) => {
            return(TraitCheckResult(implemented : b, env : env));
          },
          .None => ()
        );
      });
    }
  );
  // 2. Runtime builtin fast path.
  match(
    get_trait_type_from_env(env, String.from("Runtime")),
    .None => (),
    .Some(rt) => {
      if(_trait_type_id(trait_type) == _trait_type_id(rt), {
        match(
          type_implements_runtime_builtin(target),
          .Some(b) => {
            return(TraitCheckResult(implemented : b, env : env));
          },
          .None => ()
        );
      });
    }
  );
  // 2a. Send builtin fast path (primitive leaves). yo-self stores auto-derived
  // markers in a nominal-id registry that can't hold primitives; this tag-only
  // path recognizes Send for value/comptime-data leaves so primitive fields
  // (and bare primitives) satisfy `where(T <: Send)`. Mirrors the Comptime/
  // Runtime builtins above (TS carries this on every type's `.trait`).
  match(
    get_trait_type_from_env(env, String.from("Send")),
    .None => (),
    .Some(st) => {
      if(_trait_type_id(trait_type) == _trait_type_id(st), {
        match(
          type_implements_send_builtin(target),
          .Some(b) => {
            return(TraitCheckResult(implemented : b, env : env));
          },
          .None => ()
        );
      });
    }
  );
  // 2b. Acyclic builtin fast path (primitive leaves) — same rationale as Send.
  match(
    get_trait_type_from_env(env, String.from("Acyclic")),
    .None => (),
    .Some(at) => {
      if(_trait_type_id(trait_type) == _trait_type_id(at), {
        match(
          type_implements_acyclic_builtin(target),
          .Some(b) => {
            return(TraitCheckResult(implemented : b, env : env));
          },
          .None => ()
        );
      });
    }
  );
  // 3. Fn-trait satisfaction: FnTraitT + Func → check compatibility.
  // Phase 3 TODO: call synthesize_types for binding propagation.
  if(is_fn_trait_type(trait_type) && is_function_type(target), {
    fn_trait_call_ty := match(
      trait_type,
      .FnTraitT(_, param_labels, param_types, result, _, _, _, _) => TypeValue.Func(
        ArrayList(TypeValue).new(),
        param_types,
        ArrayList(TypeValue).new(),
        ArrayList(TypeValue).new(),
        result,
        box(
          FuncMeta(
            forall_labels : ArrayList(String).new(),
            param_labels : param_labels,
            implicit_labels : ArrayList(String).new(),
            implicit_spreads : ArrayList(bool).new(),
            result_is_comptime_only : false,
            // Fn-trait call type (runtime)
            param_is_ref : ArrayList(bool).new(),
            param_is_owning : ArrayList(bool).new(),
            result_is_ref : false,
            has_variadic : false,
            is_extern : Option(String).None,
            // Fn-trait call type is not FFI
            extern_name : Option(String).None,
            is_control : false // Fn-trait call type is `fn`, not `ctl`
            ,
            variadic_label : Option(String).None,
            variadic_comptime : false
          )
        ),
        ArrayList(TypeValue).new()
      ),
      _ => {
        return(TraitCheckResult(implemented : false, env : env));
      }
    );
    if(!(are_types_compatible(fn_trait_call_ty, target)), {
      return(TraitCheckResult(implemented : false, env : env));
    });
    // Binding propagation (TS trait-checking.ts:377-394): synthesize the
    // trait's call type against the target fn so SomeTs in parameter/return
    // positions (`Fn(a : A) -> B` against `fn(x : i32) -> i32`) get BOUND in
    // the returned env. Discarding this env left `A`/`B` unresolved and the
    // method body specialized a shadow struct ("Type mismatch for type
    // member \"_f\"" — tests/where_clause_fn_inference,
    // tests/iterator_combinators).
    syn_env := match(
      _assoc_synth_env(fn_trait_call_ty, target, env),
      .Some(se) => se,
      .None => env
    );
    return(TraitCheckResult(implemented : true, env : syn_env));
  });
  // 4. Direct trait field match — the auto-derive registry stores the type's
  // derived trait VALUES; match `trait_type` against them by identity
  // (`are_types_compatible`), faithful to TS `typeImplementsTrait` over
  // `targetType.trait.fields`. No name lookup (yo-self trait values are nameless).
  type_id := _type_id_for_trait_check(target);
  if(!(type_id.is_empty()), {
    if(is_type_registered_as_trait(type_id, trait_type, env), {
      // Associated-type constraints (`Iterator(Item := A)`) must hold and
      // their bindings propagate (TS trait-checking.ts:418-431). On failure
      // TS `continue`s to the later steps rather than rejecting outright.
      assoc_result_reg := _check_associated_type_constraints(target, trait_type, env);
      if(assoc_result_reg.satisfied, {
        return(TraitCheckResult(implemented : true, env : assoc_result_reg.env));
      });
    });
  });
  // 4b. On-demand re-derivation fallback for auto-derived markers.
  //
  // A nominal type created via GENERIC INSTANTIATION (comptime-fn stamping /
  // substitution) may not have had `auto_derive_traits_for_struct_type` run with
  // its CONCRETE field types, so the name-keyed registry has no entry. Recompute
  // the marker on demand from the type's current fields, mirroring auto_derive's
  // rules. This is path-independent (unlike re-running auto_derive at one
  // instantiation site). Only the auto-derived markers (Send/Comptime/Acyclic/
  // Runtime) are recomputable this way; the field check recurses through
  // `type_implements_trait` (so it picks up the same builtins / registry /
  // generic-impls), guarded against self-referential cycles.
  marker_name := _marker_name_of(trait_type, env);
  if((!(marker_name.is_empty())) && !(_ondemand_guard_contains(`${type_id}:${_trait_type_id(trait_type)}`)), {
    tn := marker_name.clone();
    marker_relevant := ((((tn == "Send") || (tn == "Comptime")) || (tn == "Acyclic")) || (tn == "Runtime"));
    if(marker_relevant, {
      // Determine the field types to check (None = marker not recomputable here).
      (fields_opt : Option(ArrayList(TypeValue))) = Option(ArrayList(TypeValue)).None;
      (direct_true : bool) = false;
      match(
        target,
        .Struct({ field_types : fts, is_reference_semantics : is_ref, is_atomic_rc : is_atomic }) => cond(
          // Runtime: objects always; value structs need all fields Runtime.
          (tn == "Runtime") => if(is_ref, {
            direct_true = true;
          }, {
            fields_opt = Option(ArrayList(TypeValue)).Some(fts);
          }),
          // Send: value structs + atomic objects need all fields Send; non-atomic
          // objects never auto-derive Send (leave to impls — fall through).
          (tn == "Send") => if(!(is_ref && !(is_atomic)), {
            fields_opt = Option(ArrayList(TypeValue)).Some(fts);
          }),
          // Comptime: objects never; value structs need all fields Comptime.
          (tn == "Comptime") => if(!(is_ref), {
            fields_opt = Option(ArrayList(TypeValue)).Some(fts);
          }),
          // Acyclic: value structs need all fields Acyclic; objects defer to the
          // registry (their Acyclic uses can_type_form_rc_cycle at definition).
          (tn == "Acyclic") => if(!(is_ref), {
            fields_opt = Option(ArrayList(TypeValue)).Some(fts);
          }),
          true => ()
        ),
        // Enums are value types: all (flattened) variant field types must hold.
        .EnumT({ variant_fields : vfs }) => {
          flat := ArrayList(TypeValue).new();
          (vi : usize) = usize(0);
          while(vi < vfs.len(), {
            vf := match(vfs.get(vi),.Some(f) => f,.None => ArrayList(TypeValue).new());
            (vj : usize) = usize(0);
            while(vj < vf.len(), {
              _pf := flat.push(match(vf.get(vj),.Some(t) => t,.None => TypeValue.Unit));
              vj = (vj + usize(1));
            });
            vi = (vi + usize(1));
          });
          fields_opt = Option(ArrayList(TypeValue)).Some(flat);
        },
        // `*(T)`: Send/Acyclic iff `T` is (mirrors the prelude
        // `impl(generic(T), where(T <: Send), *(T), Send())`).
        .Pointer(pointee_box) => if((tn == "Send") || (tn == "Acyclic"), {
          pfields := ArrayList(TypeValue).new();
          _pp := pfields.push(pointee_box);
          fields_opt = Option(ArrayList(TypeValue)).Some(pfields);
        }),
        _ => ()
      );
      if(direct_true, {
        return(TraitCheckResult(implemented : true, env : env));
      });
      match(
        fields_opt,
        .Some(fields) => {
          guard_key2 := `${type_id}:${_trait_type_id(trait_type)}`;
          _gpush := g_ondemand_marker_guard.push(guard_key2);
          (all_pass : bool) = true;
          (fi : usize) = usize(0);
          while((fi < fields.len()) && all_pass, {
            fty := match(fields.get(fi),.Some(t) => t,.None => TypeValue.Unit);
            // Self-recurse via `recur` (yo-self cannot reference the enclosing
            // function by name inside its own body).
            if(!(recur(fty, trait_type, env).implemented), {
              all_pass = false;
            });
            fi = (fi + usize(1));
          });
          _gpop := g_ondemand_marker_guard.remove(g_ondemand_marker_guard.len() - usize(1), usize(1));
          if(all_pass, {
            return(TraitCheckResult(implemented : true, env : env));
          });
        },
        .None => ()
      );
    });
  });
  // 5. DynType: check required traits and selfConstraints.
  match(
    target,
    .DynT(required_trait_types, _, negative_trait_types, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      while(i < n, {
        req_trait := match(
          required_trait_types.get(i),
          .Some(t) => t,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        // Direct match.
        if(_trait_type_id(req_trait) == _trait_type_id(trait_type), {
          return(TraitCheckResult(implemented : true, env : env));
        });
        // selfConstraints of the required trait.
        match(
          req_trait,
          .TraitT(_, _, _, _, _, _, self_constraints, _, _, _) => {
            ns := self_constraints.len();
            (j : usize) = usize(0);
            while(j < ns, {
              sc := match(
                self_constraints.get(j),
                .Some(t) => t,
                .None => {
                  j = (j + usize(1));
                  continue;
                }
              );
              if(_trait_type_id(sc) == _trait_type_id(trait_type), {
                return(TraitCheckResult(implemented : true, env : env));
              });
              j = (j + usize(1));
            });
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      // Negative trait check.
      nn := negative_trait_types.len();
      (k : usize) = usize(0);
      while(k < nn, {
        neg_trait := match(
          negative_trait_types.get(k),
          .Some(t) => t,
          .None => {
            k = (k + usize(1));
            continue;
          }
        );
        if(_trait_type_id(neg_trait) == _trait_type_id(trait_type), {
          return(TraitCheckResult(implemented : false, env : env));
        });
        k = (k + usize(1));
      });
    },
    _ => ()
  );
  // 6. SomeType where-clause check.
  // In yo-self, constraints stored directly on SomeT.required_trait_types
  // via _add_where_clause_constraint (no separate env lookup needed).
  match(
    target,
    .SomeT(_, _, _, _, required_trait_types, _, negative_trait_types, _, _, _, _) => {
      (found_req : bool) = false;
      (found_neg : bool) = false;
      // Check required_trait_types.
      nr := required_trait_types.len();
      (ir : usize) = usize(0);
      while(ir < nr, {
        req_t := match(
          required_trait_types.get(ir),
          .Some(t) => t,
          .None => {
            ir = (ir + usize(1));
            continue;
          }
        );
        if(_trait_type_id(req_t) == _trait_type_id(trait_type), {
          found_req = true;
        });
        ir = (ir + usize(1));
      });
      // Check negative_trait_types.
      nn2 := negative_trait_types.len();
      (in2 : usize) = usize(0);
      while(in2 < nn2, {
        neg_t := match(
          negative_trait_types.get(in2),
          .Some(t) => t,
          .None => {
            in2 = (in2 + usize(1));
            continue;
          }
        );
        if(_trait_type_id(neg_t) == _trait_type_id(trait_type), {
          found_neg = true;
        });
        in2 = (in2 + usize(1));
      });
      // Also consult the ENV-stored where-clause evidence
      // (trait-checking.ts:468-483, getWhereClauseConstraintsForSomeType):
      // a `where(V <: (Send, Acyclic))` on the enclosing fn records its
      // constraints in the callee env frames, not always on the SomeT's own
      // required_trait_types — e.g. `Arc`'s `atomic(ref(struct((*) : V)))`
      // body must see V as Send during the atomic-Send enforcement.
      match(
        get_where_clause_constraints_for_some_type(env, target),
        .Some(wcc) => {
          nwr := wcc.required_traits.len();
          (iwr : usize) = usize(0);
          while(iwr < nwr, {
            wr_t := match(
              wcc.required_traits.get(iwr),
              .Some(t) => t,
              .None => {
                iwr = (iwr + usize(1));
                continue;
              }
            );
            if(_trait_type_id(wr_t) == _trait_type_id(trait_type), {
              found_req = true;
            });
            iwr = (iwr + usize(1));
          });
          nwn := wcc.negative_traits.len();
          (iwn : usize) = usize(0);
          while(iwn < nwn, {
            wn_t := match(
              wcc.negative_traits.get(iwn),
              .Some(t) => t,
              .None => {
                iwn = (iwn + usize(1));
                continue;
              }
            );
            if(_trait_type_id(wn_t) == _trait_type_id(trait_type), {
              found_neg = true;
            });
            iwn = (iwn + usize(1));
          });
        },
        .None => ()
      );
      if(found_req, {
        return(TraitCheckResult(implemented : !(found_neg), env : env));
      }, {
        if(found_neg, {
          return(TraitCheckResult(implemented : false, env : env));
        });
      });
    },
    _ => ()
  );
  // 7. Resolve SomeType to its concrete type before generic impl check.
  if(is_some_type(target), {
    resolved := get_value_of_some_type_from_env(env, target);
    if(is_some_type(resolved), {
      return(TraitCheckResult(implemented : false, env : env));
    });
    target = resolved;
  });
  // 7.5. Concrete impl currently being registered (recursive types).
  // Mirrors `currentlyRegisteringConcreteImpls` lookup in TS.
  if(_is_concrete_impl_being_registered(
    _trait_type_id(target),
    _trait_type_id(trait_type)
  ), {
    return(TraitCheckResult(implemented : true, env : env));
  });
  // 8. Generic impl registry — delegated to impl.yo via _find_matching_generic_impl.
  // Guard key: TS uses `targetType.id` (unique per type instance,
  // trait-checking.ts:531). `_trait_type_id` renders "" for STRUCT/enum
  // targets, so every struct-vs-<trait> check shared ONE key — any nested
  // check of the same trait through a chained combinator record
  // (`IterTake(IterSkip(MyRange)) <: Iterator` → where-pass →
  // `IterSkip(MyRange) <: Iterator`) self-collided and returned false
  // (iterator_combinators arms 16-18). `_type_id_for_trait_check` is the
  // yo-self stand-in for TS's unique type id. NOT type_key: type_key is
  // STATEFUL codegen machinery (it registers g_struct_cfid_keys entries);
  // calling it from eval-phase trait checks poisoned the cfid registry and
  // split the whole imm-container family's C identities (measured
  // 2026-08-03: imm_map/imm_set/imm_sorted_*/linked_list all RED).
  guard_key := _type_id_for_trait_check(target).concat(`:`).concat(_trait_type_id(trait_type));
  // Recursion guard: return false if already checking this pair.
  (already_checking : bool) = false;
  gn := g_trait_check_recursion_guard.len();
  (gi : usize) = usize(0);
  while(gi < gn, {
    entry := match(
      g_trait_check_recursion_guard.get(gi),
      .Some(s) => s,
      .None => {
        gi = (gi + usize(1));
        continue;
      }
    );
    if(entry == guard_key, {
      already_checking = true;
    });
    gi = (gi + usize(1));
  });
  if(already_checking, {
    return(TraitCheckResult(implemented : false, env : env));
  });
  g_trait_check_recursion_guard.push(guard_key);
  result := _find_matching_generic_impl(target, trait_type, env);
  // Pop the guard key.
  last_idx := (g_trait_check_recursion_guard.len() - usize(1));
  g_trait_check_recursion_guard.remove(last_idx);
  if(!(result), {
    return(TraitCheckResult(implemented : false, env : env));
  });
  // Associated-type constraints on the matched trait (TS trait-checking.ts:
  // 545-553): `Iterator(Item := A)` must resolve the target's `Item` and the
  // returned env carries the `A := <concrete>` binding.
  assoc_result := _check_associated_type_constraints(target, trait_type, env);
  TraitCheckResult(implemented : assoc_result.satisfied, env : assoc_result.env)
});
// ---------------------------------------------------------------------------
// type_implements_trait_bool
// ---------------------------------------------------------------------------
/// Boolean wrapper around `type_implements_trait`.
///
/// Mirrors `typeImplementsTraitBool` in `src/evaluator/trait-checking.ts`.
type_implements_trait_bool :: (
  fn(
    target_type : TypeValue,
    trait_type : TypeValue,
    env : Environment
  ) -> bool
)(
  type_implements_trait(target_type, trait_type, env).implemented
);
// ---------------------------------------------------------------------------
// check_type_implements_self_constraints
// ---------------------------------------------------------------------------
/// Message-returning core of the self-constraint check: `.Some(msg)` when the
/// target violates a positive or negative selfConstraint on the trait, `.None`
/// otherwise. Split out (throw-free) so `impl.yo`'s concrete-impl path can
/// call it through the injected function-pointer hook
/// (`set_check_self_constraints_fn`) without an import cycle, and throw with
/// its own token/exn — the same routing as `RegisterTraitValueFn`.
check_self_constraints_violation_msg :: (
  fn(
    target_type : TypeValue,
    trait_type : TypeValue,
    env : Environment
  ) -> Option(String)
)({
  match(
    trait_type,
    .TraitT(name, _, _, _, _, _, self_constraints, neg_self_constraints, _, _) => {
      // Check positive constraints (must implement).
      np := self_constraints.len();
      (ip : usize) = usize(0);
      while(ip < np, {
        constraint := match(
          self_constraints.get(ip),
          .Some(c) => c,
          .None => {
            ip = (ip + usize(1));
            continue;
          }
        );
        if(!(type_implements_trait_bool(target_type, constraint, env)), {
          msg := `Type "`.concat(type_to_string(target_type)).concat(`" does not implement required constraint "`).concat(type_to_string(constraint)).concat(`" from trait "`).concat(name).concat(`"'s where clause.`);
          return(Option(String).Some(msg));
        });
        ip = (ip + usize(1));
      });
      // Check negative constraints (must NOT implement).
      nn := neg_self_constraints.len();
      (in_ : usize) = usize(0);
      while(in_ < nn, {
        constraint := match(
          neg_self_constraints.get(in_),
          .Some(c) => c,
          .None => {
            in_ = (in_ + usize(1));
            continue;
          }
        );
        if(type_implements_trait_bool(target_type, constraint, env), {
          msg := `Type "`.concat(type_to_string(target_type)).concat(`" implements "`).concat(type_to_string(constraint)).concat(`" but the trait "`).concat(name).concat(`"'s where clause requires it to NOT implement this trait.`);
          return(Option(String).Some(msg));
        });
        in_ = (in_ + usize(1));
      });
    },
    _ => ()
  );
  Option(String).None
});
/// Check that a type satisfies all positive and negative selfConstraints on a
/// trait. Throws if any constraint is not satisfied.
///
/// Mirrors `checkTypeImplementsSelfConstraints` in
/// `src/evaluator/trait-checking.ts`.
check_type_implements_self_constraints :: (
  fn(
    target_type : TypeValue,
    trait_type : TypeValue,
    env : Environment,
    error_token : Token,
    exn : Exception
  ) -> unit
)(
  match(
    check_self_constraints_violation_msg(target_type, trait_type, env),
    .Some(msg) => exn.throw(dyn(format_error_message(error_token, msg, false, Option(ErrorKind).None))),
    .None => ()
  )
);
// ---------------------------------------------------------------------------
// type_implements_comptime
// ---------------------------------------------------------------------------
/// Check if a type implements the Comptime trait.
///
/// Mirrors `typeImplementsComptime` in `src/evaluator/trait-checking.ts`.
type_implements_comptime :: (fn(ty : TypeValue, env : Environment) -> bool)({
  match(
    type_implements_comptime_builtin(ty),
    .Some(b) => {
      return(b);
    },
    .None => ()
  );
  match(
    get_trait_type_from_env(env, String.from("Comptime")),
    .None => false,
    .Some(comptime_trait) => type_implements_trait_bool(ty, comptime_trait, env)
  )
});
// ---------------------------------------------------------------------------
// type_implements_runtime (full evaluator-layer version)
// ---------------------------------------------------------------------------
/// Check if a type implements the Runtime trait (full env-aware version).
///
/// Mirrors `typeImplementsRuntime` in `src/evaluator/trait-checking.ts`.
type_implements_runtime_full :: (fn(ty : TypeValue, env : Environment) -> bool)({
  match(
    type_implements_runtime_builtin(ty),
    .Some(b) => {
      return(b);
    },
    .None => ()
  );
  match(
    get_trait_type_from_env(env, String.from("Runtime")),
    .None => false,
    .Some(runtime_trait) => type_implements_trait_bool(ty, runtime_trait, env)
  )
});
// ---------------------------------------------------------------------------
// begin/end_send_derivation
// ---------------------------------------------------------------------------
/// Mark a type as currently undergoing Send auto-derivation.
///
/// Mirrors `beginSendDerivation` in `src/evaluator/trait-checking.ts`.
begin_send_derivation :: (fn(type_id : String) -> unit)({
  g_send_derivation_in_progress.push(type_id);
});
/// Remove a type from the Send auto-derivation in-progress set.
///
/// Mirrors `endSendDerivation` in `src/evaluator/trait-checking.ts`.
end_send_derivation :: (fn(type_id : String) -> unit)({
  n := g_send_derivation_in_progress.len();
  (i : usize) = usize(0);
  (found_idx : Option(usize)) = Option(usize).None;
  while(i < n, {
    entry := match(
      g_send_derivation_in_progress.get(i),
      .Some(s) => s,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    if(entry == type_id, {
      found_idx = Option(usize).Some(i);
    });
    i = (i + usize(1));
  });
  match(
    found_idx,
    .Some(idx) => {
      g_send_derivation_in_progress.remove(idx);
    },
    .None => ()
  );
});
// ---------------------------------------------------------------------------
// type_implements_send
// ---------------------------------------------------------------------------
/// Check if a type implements the Send trait.
///
/// Mirrors `typeImplementsSend` in `src/evaluator/trait-checking.ts`.
type_implements_send :: (fn(ty : TypeValue, env : Environment) -> bool)({
  // Cycle break: if this type is currently being checked for Send derivation,
  // optimistically assume it implements Send.
  ty_id := _type_id_for_trait_check(ty);
  (in_derivation : bool) = false;
  nd := g_send_derivation_in_progress.len();
  (id : usize) = usize(0);
  while(id < nd, {
    entry := match(
      g_send_derivation_in_progress.get(id),
      .Some(s) => s,
      .None => {
        id = (id + usize(1));
        continue;
      }
    );
    if(entry == ty_id, {
      in_derivation = true;
    });
    id = (id + usize(1));
  });
  if(in_derivation, {
    return(true);
  });
  match(
    get_trait_type_from_env(env, String.from("Send")),
    .None => false,
    .Some(send_trait) => type_implements_trait_bool(ty, send_trait, env)
  )
});
