// ---------------------------------------------------------------------------
// type_implements_fn
// ---------------------------------------------------------------------------
/// Check if a type implements Fn (is a function-like type).
///
/// Mirrors `typeImplementsFn` in `src/evaluator/trait-checking.ts`.
///
/// Note: the `resolvedConcreteType` chain walk from TypeScript is Phase 3
/// (SomeType.resolvedConcreteType is not yet in yo-self's SomeT).
type_implements_fn :: (fn(ty : TypeValue) -> bool)(
  match(
    ty,
    .SomeT(_, _, _, _, required_trait_types, _, _, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < n) && !(found), {
        t := match(required_trait_types.get(i),.Some(v) => v,.None => TypeValue.Unit);
        match(
          t,
          .FnTraitT(base_name : _) => {
            found = true;
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .DynT(required_trait_types, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < n) && !(found), {
        t := match(required_trait_types.get(i),.Some(v) => v,.None => TypeValue.Unit);
        match(
          t,
          .FnTraitT(base_name : _) => {
            found = true;
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
// ---------------------------------------------------------------------------
// extract_fn_trait_from_type
// ---------------------------------------------------------------------------
/// Extract FnTraitT from a type.
///
/// Checks:
///   1. If the type IS already a FnTraitT → return it directly.
///   2. If the type is SomeT or DynT → search `required_trait_types`.
///   3. If SomeT: also check where-clause constraints stored in
///      `required_trait_types` (yo-self stores them directly on SomeT).
///
/// Note: `resolvedConcreteType` chain (TypeScript step 2b) is Phase 3.
///
/// Mirrors `extractFnTraitFromType` in `src/evaluator/trait-checking.ts`.
extract_fn_trait_from_type :: (fn(ty : TypeValue) -> Option(TypeValue))(
  match(
    ty,
    .FnTraitT(base_name : _) => Option(TypeValue).Some(ty),
    .SomeT(_, _, _, _, required_trait_types, _, _, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      while(i < n, {
        t := match(
          required_trait_types.get(i),
          .Some(v) => v,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        match(
          t,
          .FnTraitT(base_name : _) => {
            return(Option(TypeValue).Some(t));
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      Option(TypeValue).None
    },
    .DynT(required_trait_types, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      while(i < n, {
        t := match(
          required_trait_types.get(i),
          .Some(v) => v,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        match(
          t,
          .FnTraitT(base_name : _) => {
            return(Option(TypeValue).Some(t));
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      Option(TypeValue).None
    },
    _ => Option(TypeValue).None
  )
);
// ---------------------------------------------------------------------------
// type_implements_future
// ---------------------------------------------------------------------------
/// Check if a type implements Future (is a future-like type).
///
/// Mirrors `typeImplementsFuture` in `src/evaluator/trait-checking.ts`.
type_implements_future :: (fn(ty : TypeValue) -> bool)(
  match(
    ty,
    .SomeT(_, _, _, _, required_trait_types, _, _, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < n) && !(found), {
        t := match(required_trait_types.get(i),.Some(v) => v,.None => TypeValue.Unit);
        match(
          t,
          .FutureTraitT(base_name : _) => {
            found = true;
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .DynT(required_trait_types, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < n) && !(found), {
        t := match(required_trait_types.get(i),.Some(v) => v,.None => TypeValue.Unit);
        match(
          t,
          .FutureTraitT(base_name : _) => {
            found = true;
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
// ---------------------------------------------------------------------------
// type_contains_some_type_for_codegen_param
// ---------------------------------------------------------------------------
/// Deep recursion: does `ty` contain a SomeType in a codegen-relevant position?
///
/// 1:1 port of `typeContainsSomeTypeForCodegenParam` (`src/types/utils.ts:708`).
/// Lives here (not `types/utils.yo`) so it can use `type_implements_fn` /
/// `type_implements_future` without a `types/utils` import cycle.
///
/// STAGED for def-time body evaluation (see plans/DEFTIME_BODY_EVAL.md): this is
/// the DEEP predicate `should_defer` needs — yo-self's shallow
/// `type_contains_some_type` (types/utils.yo) only checks top-level
/// `SomeT`/`TypeAppT`, so generic ptr/slice/struct fns aren't deferred. NOT YET
/// CONSUMED (body-eval wiring is the remaining multi-layer work); exported for
/// that wiring. The `checked_ids` arg is the cycle guard (TS `checkedTypes`),
/// keyed by nominal type id. yo-self `SomeT` has no `is_extern` /
/// `resolved_concrete_type`, so those TS exclusions are no-ops here.
type_contains_some_type_for_codegen_param :: (
  fn(ty : TypeValue, checked_ids : ArrayList(String)) -> bool
)({
  // Cycle guard on nominal type id (mirrors TS `checkedTypes.includes(type)`).
  nominal_id := match(
    ty,
    .Struct({ id : sid }) => sid,
    .EnumT(eid, _, _, _, _, _, _) => eid,
    .Union(uname, _, _) => uname,
    _ => String.from("")
  );
  if(!(nominal_id.is_empty()), {
    (seen : bool) = false;
    (ci : usize) = usize(0);
    while((ci < checked_ids.len()) && !(seen), {
      match(
        checked_ids.get(ci),
        .Some(k) => if(k == nominal_id, {
          seen = true;
        }),
        .None => ()
      );
      ci = (ci + usize(1));
    });
    if(seen, {
      return(false);
    });
    _push := checked_ids.push(nominal_id.clone());
  });
  if(is_some_type(ty), {
    // SomeType: TS excludes extern + resolved-concrete (no-ops in yo-self) and
    // Fn/Future-trait SomeTypes; otherwise it IS a codegen SomeType.
    if(type_implements_fn(ty), {
      return(false);
    });
    if(type_implements_future(ty), {
      return(false);
    });
    return(true);
  });
  match(
    ty,
    .Array(element, _, _) => recur(element.*, checked_ids),
    .Slice(element) => recur(element.*, checked_ids),
    .Pointer(pointee) => recur(pointee.*, checked_ids),
    .Tuple(_, field_types) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < field_types.len()) && !(found), {
        ft := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
        if(recur(ft, checked_ids), {
          found = true;
        });
        i = (i + usize(1));
      });
      found
    },
    // Struct: skip Fn-typed fields (TS `field.type.tag !== Function`); yo-self
    // has no `isEffectParam` so that exclusion is a no-op.
    .Struct({ field_types : field_types }) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < field_types.len()) && !(found), {
        ft := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
        if((!(is_function_type(ft))) && recur(ft, checked_ids), {
          found = true;
        });
        i = (i + usize(1));
      });
      found
    },
    .EnumT(_, _, _, variant_fields, _, _, _) => {
      (found : bool) = false;
      (vi : usize) = usize(0);
      while((vi < variant_fields.len()) && !(found), {
        vf := match(variant_fields.get(vi),.Some(f) => f,.None => ArrayList(TypeValue).new());
        (vj : usize) = usize(0);
        while((vj < vf.len()) && !(found), {
          ft := match(vf.get(vj),.Some(t) => t,.None => TypeValue.Unit);
          if(recur(ft, checked_ids), {
            found = true;
          });
          vj = (vj + usize(1));
        });
        vi = (vi + usize(1));
      });
      found
    },
    .Union(_, _, field_types) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < field_types.len()) && !(found), {
        ft := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
        if(recur(ft, checked_ids), {
          found = true;
        });
        i = (i + usize(1));
      });
      found
    },
    .Func({ forall_labels : forall_labels, param_types : param_types, result : result_box }) => {
      (found : bool) = (forall_labels.len() > usize(0));
      (i : usize) = usize(0);
      while((i < param_types.len()) && !(found), {
        pt := match(param_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
        if(recur(pt, checked_ids), {
          found = true;
        });
        i = (i + usize(1));
      });
      if(!(found), {
        found = recur(result_box.*, checked_ids);
      });
      found
    },
    .TypeAppT(constructor : _) => true,
    _ => false
  )
});
// ---------------------------------------------------------------------------
// extract_future_trait_from_type
// ---------------------------------------------------------------------------
/// Extract FutureTraitT from a type.
///
/// Mirrors `extractFutureTraitFromType` in `src/evaluator/trait-checking.ts`.
extract_future_trait_from_type :: (fn(ty : TypeValue) -> Option(TypeValue))(
  match(
    ty.clone(),
    .FutureTraitT(base_name : _) => Option(TypeValue).Some(ty),
    .SomeT(_, _, _, _, required_trait_types, _, _, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      while(i < n, {
        t := match(
          required_trait_types.get(i),
          .Some(v) => v,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        match(
          t.clone(),
          .FutureTraitT(base_name : _) => {
            return(Option(TypeValue).Some(t));
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      Option(TypeValue).None
    },
    .DynT(required_trait_types, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      while(i < n, {
        t := match(
          required_trait_types.get(i),
          .Some(v) => v,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        match(
          t.clone(),
          .FutureTraitT(base_name : _) => {
            return(Option(TypeValue).Some(t));
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      Option(TypeValue).None
    },
    _ => Option(TypeValue).None
  )
);
// ---------------------------------------------------------------------------
// type_is_comptime_only / type_is_runtime_only
// ---------------------------------------------------------------------------
/// Check if a type is comptime-only (comptime && !runtime).
///
/// Mirrors `typeIsComptimeOnly` in `src/evaluator/trait-checking.ts`.
type_is_comptime_only_full :: (fn(ty : TypeValue, env : Environment) -> bool)(
  type_implements_comptime(ty, env) && !(type_implements_runtime_full(ty, env))
);
/// Check if a type is runtime-only (!comptime && runtime).
///
/// Mirrors `typeIsRuntimeOnly` in `src/evaluator/trait-checking.ts`.
type_is_runtime_only :: (fn(ty : TypeValue, env : Environment) -> bool)(
  !(type_implements_comptime(ty, env)) && type_implements_runtime_full(ty, env)
);
// ---------------------------------------------------------------------------
// validate_type_availability
// ---------------------------------------------------------------------------
/// Validate that a type can be used in at least one evaluation context
/// (comptime or runtime). Throws an error if the type is incompatible in all
/// contexts.
///
/// Mirrors `validateTypeAvailability` in `src/evaluator/trait-checking.ts`.
validate_type_availability :: (
  fn(
    ty : TypeValue,
    env : Environment,
    token : Token,
    exn : Exception
  ) -> unit
)({
  if(type_contains_some_type(ty), {
    return(());
  });
  if(!(type_implements_comptime(ty, env) || type_implements_runtime_full(ty, env)), {
    msg := `Type `.concat(type_to_string(ty)).concat(` has incompatible field contexts and cannot be used in any evaluation context.`);
    exn.throw(dyn(format_error_message(token, msg, false, Option(ErrorKind).None)));
  })
});
// ---------------------------------------------------------------------------
// find_some_type_missing_comptime_constraint
// ---------------------------------------------------------------------------
/// Find a SomeType in the type that is missing a Comptime constraint.
/// Returns None if all SomeTypes have the constraint, or if the type is
/// concretely comptime or concretely not comptime.
///
/// Mirrors `findSomeTypeMissingComptimeConstraint` in
/// `src/evaluator/trait-checking.ts`.
find_some_type_missing_comptime_constraint :: (
  fn(
    ty : TypeValue,
    env : Environment
  ) -> Option(TypeValue)
)({
  // Fast path: builtin comptime check.
  // NOTE: Yo enum patterns do not support literal matching — `.Some(true)` and
  // `.Some(false)` would each bind the inner bool to a variable named `true`
  // or `false`. We collapse to `.Some(_)` because the TS reference
  // (findSomeTypeMissingComptimeConstraint in src/evaluator/trait-checking.ts)
  // returns `undefined` for both true and false alike — only the `None`
  // (unknown) result needs further checking. See
  // issues/pattern-match-literal-in-enum-destructure.md.
  match(
    type_implements_comptime_builtin(ty),
    .Some(_) => {
      return(Option(TypeValue).None);
    },
    .None => ()
  );
  // SomeType: check if it has a Comptime constraint.
  if(is_some_type(ty), {
    comptime_trait_opt := get_trait_type_from_env(env, String.from("Comptime"));
    match(
      comptime_trait_opt,
      .None => {
        return(Option(TypeValue).Some(ty));
      },
      .Some(comptime_trait) => {
        // Check required_trait_types.
        match(
          ty,
          .SomeT(_, _, _, _, required_trait_types, _, _, _, _, _) => {
            n := required_trait_types.len();
            (i : usize) = usize(0);
            (has_comptime : bool) = false;
            while(i < n, {
              req_t := match(
                required_trait_types.get(i),
                .Some(t) => t,
                .None => {
                  i = (i + usize(1));
                  continue;
                }
              );
              if(_trait_type_id(req_t) == _trait_type_id(comptime_trait), {
                has_comptime = true;
              });
              i = (i + usize(1));
            });
            if(!(has_comptime), {
              return(Option(TypeValue).Some(ty));
            });
          },
          _ => ()
        );
        return(Option(TypeValue).None);
      }
    );
  });
  // Pointer *(T): T must implement Comptime.
  if(is_pointer_type(ty), {
    match(
      ty,
      .Pointer(inner) => {
        return(recur(inner.*, env));
      },
      _ => ()
    );
  });
  // Other compound types — deferred to Phase 3 (generic impl registry).
  Option(TypeValue).None
});
// ---------------------------------------------------------------------------
// mark/unmark_concrete_impl_being_registered (Phase 3 stubs)
// ---------------------------------------------------------------------------
// `mark_concrete_impl_being_registered` and
// `unmark_concrete_impl_being_registered` are re-exported here as
// thin pass-throughs to `evaluator/values/impl.yo` (same module that
// owns the underlying HashMap). Defined that way so the impl
// evaluator — which already imports impl.yo — can call them without
// a circular dependency through trait_checking.yo.
mark_concrete_impl_being_registered :: (fn(type_id : String, trait_id : String) -> unit)(
  impl_mark_concrete_impl_being_registered(type_id, trait_id)
);
unmark_concrete_impl_being_registered :: (fn(type_id : String, trait_id : String) -> unit)(
  impl_unmark_concrete_impl_being_registered(type_id, trait_id)
);
// Install type_implements_trait_bool as the function pointer used by
// impl.yo's try_match_generic_impl for where-clause checking.
// This breaks the circular dependency between the two modules.
_trait_checking_init := (fn() -> bool)({
  set_type_implements_trait_fn(type_implements_trait_bool);
  set_register_trait_value_fn(register_type_trait_value);
  true
})();
// ---------------------------------------------------------------------------
