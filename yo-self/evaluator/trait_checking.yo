// ---------------------------------------------------------------------------
// type_implements_fn
// ---------------------------------------------------------------------------
/// Check if a type implements Fn (is a function-like type).
///
/// Mirrors `typeImplementsFn` in `src/evaluator/trait-checking.ts`.
///
/// Note: the `resolvedConcreteType` chain walk from TypeScript is Phase 3
/// (SomeType.resolvedConcreteType is not yet in yo-self's SomeT).
type_implements_fn :: (fn(ty : TypeValue) -> bool)(
  match(
    ty,
    .SomeT(_, _, _, _, required_trait_types, _, _, _, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < n) && !(found), {
        t := match(required_trait_types.get(i),.Some(v) => v,.None => TypeValue.Unit);
        match(
          t,
          .FnTraitT(base_name : _) => {
            found = true;
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .DynT(required_trait_types, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < n) && !(found), {
        t := match(required_trait_types.get(i),.Some(v) => v,.None => TypeValue.Unit);
        match(
          t,
          .FnTraitT(base_name : _) => {
            found = true;
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
// ---------------------------------------------------------------------------
// extract_fn_trait_from_type
// ---------------------------------------------------------------------------
/// Extract FnTraitT from a type.
///
/// Checks:
///   1. If the type IS already a FnTraitT → return it directly.
///   2. If the type is SomeT or DynT → search `required_trait_types`.
///   3. If SomeT: also check where-clause constraints stored in
///      `required_trait_types` (yo-self stores them directly on SomeT).
///
/// Note: `resolvedConcreteType` chain (TypeScript step 2b) is Phase 3.
///
/// Mirrors `extractFnTraitFromType` in `src/evaluator/trait-checking.ts`.
extract_fn_trait_from_type :: (fn(ty : TypeValue) -> Option(TypeValue))(
  match(
    ty,
    .FnTraitT(base_name : _) => Option(TypeValue).Some(ty),
    .SomeT(_, _, _, _, _, _, _, _, _, _, _) => {
      // Walk the SomeT and its resolvedConcreteType chain (TS
      // trait-checking.ts:907-921): a where-clause `F` whose Fn bound was
      // stripped by freshening still resolves through `__impl_fn` (which
      // carries the Fn in ITS required list). Iterative with a visited-id
      // list — resolution cells can cycle in yo-self (the get_type_string
      // SIGBUS family), and TS's finite-chain recursion has no guard to port.
      (eft_cur : TypeValue) = ty;
      (eft_seen : ArrayList(String)) = ArrayList(String).new();
      (eft_out : Option(TypeValue)) = Option(TypeValue).None;
      (eft_going : bool) = true;
      while(eft_going, {
        match(
          eft_cur,
          .SomeT(eft_id, _, _, _, eft_rtt, _, _, _, _, _, eft_rc) => {
            n := eft_rtt.len();
            (i : usize) = usize(0);
            while((i < n) && eft_out.is_none(), {
              match(
                eft_rtt.get(i),
                .Some(t) => match(
                  t,
                  .FnTraitT(base_name : _) => {
                    eft_out = Option(TypeValue).Some(t);
                  },
                  _ => ()
                ),
                .None => ()
              );
              i = (i + usize(1));
            });
            if(eft_out.is_some(), {
              eft_going = false;
            }, {
              (eft_revisit : bool) = false;
              (si : usize) = usize(0);
              while(si < eft_seen.len(), {
                match(
                  eft_seen.get(si),
                  .Some(sid) => if(sid == eft_id, {
                    eft_revisit = true;
                  }),
                  .None => ()
                );
                si = (si + usize(1));
              });
              if(eft_revisit, {
                eft_going = false;
              }, {
                eft_seen.push(eft_id.clone());
                match(
                  eft_rc.get(usize(0)),
                  .Some(eft_next) => {
                    eft_cur = eft_next;
                  },
                  .None => {
                    eft_going = false;
                  }
                );
              });
            });
          },
          .FnTraitT(base_name : _) => {
            eft_out = Option(TypeValue).Some(eft_cur);
            eft_going = false;
          },
          _ => {
            eft_going = false;
          }
        );
      });
      eft_out
    },
    .DynT(required_trait_types, _, _, _) => {
      n := required_trait_types.len();
      (i : usize) = usize(0);
      while(i < n, {
        t := match(
          required_trait_types.get(i),
          .Some(v) => v,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        match(
          t,
          .FnTraitT(base_name : _) => {
            return(Option(TypeValue).Some(t));
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      Option(TypeValue).None
    },
    _ => Option(TypeValue).None
  )
);
