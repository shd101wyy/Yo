// ---------------------------------------------------------------------------
/// Check if a type implements the Acyclic trait.
///
/// Mirrors `typeImplementsAcyclic` in `src/evaluator/trait-checking.ts`.
type_implements_acyclic :: (fn(ty : TypeValue, env : Environment) -> bool)(
  match(
    get_trait_type_from_env(env, String.from("Acyclic")),
