/// Mirrors `typeImplementsDispose` in `src/evaluator/trait-checking.ts`.
type_implements_dispose :: (fn(ty : TypeValue, env : Environment) -> bool)(
  match(
    get_trait_type_from_env(env, String.from("Dispose")),
    .None => false,
    .Some(dispose_trait) => type_implements_trait_bool(ty, dispose_trait, env)
  )
);
