// ---------------------------------------------------------------------------
export(TraitCheckResult, AssocTypeCheckResult);
export(type_implements_comptime_builtin);
export(type_implements_trait, type_implements_trait_bool);
export(check_type_implements_self_constraints);
export(type_implements_comptime, type_implements_runtime_full);
export(begin_send_derivation, end_send_derivation);
export(type_implements_send, type_implements_dispose, type_implements_acyclic);
export(type_implements_fn);
export(extract_fn_trait_from_type);
export(type_implements_future);
export(type_contains_some_type_for_codegen_param);
export(extract_future_trait_from_type);
export(type_is_comptime_only_full, type_is_runtime_only);
export(validate_type_availability);
export(find_some_type_missing_comptime_constraint);
export(mark_concrete_impl_being_registered, unmark_concrete_impl_being_registered);
export(register_type_trait, register_type_trait_value, is_type_registered_as_trait);
