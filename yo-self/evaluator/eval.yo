        // StrLit.substring(start, end) — returns StrLit of inner[start..end] re-quoted
        ((mname == "substring") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(2)))) =>
          match(
            method_call_args.get(usize(0)),
            .None => {
              return(Option(EvalResult).None);
            },
            .Some(sub_start_expr) =>
              match(
                method_call_args.get(usize(1)),
                .None => {
                  return(Option(EvalResult).None);
                },
                .Some(sub_end_expr) =>
                  match(
                    match(
                      g_eval_fn,
                      .Some(ef_ss) => ef_ss(sub_start_expr, env),
                      .None => Option(EvalResult).None
                    ),
                    .None => {
                      return(Option(EvalResult).None);
                    },
                    .Some(start_res) =>
                      match(
                        match(
                          g_eval_fn,
                          .Some(ef_se) => ef_se(sub_end_expr, env),
                          .None => Option(EvalResult).None
                        ),
                        .None => {
                          return(Option(EvalResult).None);
                        },
                        .Some(end_res) =>
                          match(
                            recv_val,
                            .StrLit(raw_sb) =>
                              match(
                                start_res.value,
                                .IntLit(start_raw) =>
                                  match(
                                    end_res.value,
                                    .IntLit(end_raw) => {
                                      n_sb := raw_sb.len();
                                      cond(
                                        (n_sb < usize(2)) => {
                                          return(Option(EvalResult).None);
                                        },
                                        true => {
                                          inner_sb := raw_sb.substring(usize(1), n_sb - usize(1));
                                          inner_len_sb := inner_sb.len();
                                          start_i := match(
                                            parse_raw_int(start_raw),
                                            .Some(si) => usize(si),
                                            .None => {
                                              return(Option(EvalResult).None);
                                            }
                                          );
                                          end_i := match(
                                            parse_raw_int(end_raw),
                                            .Some(ei) => usize(ei),
                                            .None => {
                                              return(Option(EvalResult).None);
                                            }
                                          );
                                          cond(
                                            ((start_i > inner_len_sb) || (end_i > inner_len_sb)) =>
                                              {
                                                return(Option(EvalResult).None);
                                              },
                                            (start_i > end_i) =>
                                              {
                                                return(Option(EvalResult).None);
