        // StrLit.starts_with(prefix) — bool: does inner string start with prefix_inner?
        ((mname == "starts_with") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(
            method_call_args.get(usize(0)),
            .None => {
