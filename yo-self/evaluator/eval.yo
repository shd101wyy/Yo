                  inner_ix := raw_ix.substring(usize(1), (n_ix - usize(1)));
                  needle_str := match(method_call_args.get(usize(0)),
                    .Some(na2) => match(match(g_eval_fn, .Some(ef) => ef(na2, env), .None => Option(EvalResult).None),
                      .Some(nar2) => match(nar2.value, .StrLit(s) => s, _ => { return Option(EvalResult).None; }),
                      .None => { return Option(EvalResult).None; }
                    ),
                    .None => { return Option(EvalResult).None; }
                  );
                  needle_inner := cond((needle_str.len() >= usize(2)) => needle_str.substring(usize(1), (needle_str.len() - usize(1))), true => needle_str);
                  match(inner_ix.index_of(needle_inner),
                    .Some(pos) => {
                      some_ix := ArrayList(EvalValue).new();
                      some_ix.push(.IntLit(pos.to_string()));
                      return Option(EvalResult).Some(eval_result(.EnumVal(String.from(".Some"), some_ix), t_unit()));
                    },
                    .None => {
                      none_ix2 := ArrayList(EvalValue).new();
                      return Option(EvalResult).Some(eval_result(.EnumVal(String.from(".None"), none_ix2), t_unit()));
                    }
                  )
                }
              )
            },
            _ => { return Option(EvalResult).None; }
          ),
        // ---------------------------------------------------------------
        // Phase 5ac: StrLit.split(delim) — split string into ArrayVal of StrLits
        // ---------------------------------------------------------------
        ((mname == "split") && (match(recv_val, .StrLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(recv_val,
            .StrLit(raw_sp) => {
              n_sp := raw_sp.len();
              cond(
                (n_sp < usize(2)) => { return Option(EvalResult).None; },
                true => {
                  inner_sp := raw_sp.substring(usize(1), (n_sp - usize(1)));
                  delim_str := match(method_call_args.get(usize(0)),
                    .Some(de) => match(match(g_eval_fn, .Some(ef) => ef(de, env), .None => Option(EvalResult).None),
                      .Some(dr) => match(dr.value, .StrLit(s) => s, _ => { return Option(EvalResult).None; }),
                      .None => { return Option(EvalResult).None; }
                    ),
                    .None => { return Option(EvalResult).None; }
                  );
                  delim_inner := cond((delim_str.len() >= usize(2)) => delim_str.substring(usize(1), (delim_str.len() - usize(1))), true => delim_str);
                  parts := inner_sp.split(delim_inner);
                  result_arr := ArrayList(EvalValue).new();
                  (spi : usize) = usize(0);
                  while runtime((spi < parts.len())), {
                    match(parts.get(spi),
                      .Some(part) => {
                        result_arr.push(.StrLit(((String.from("\"") + part) + String.from("\""))));
                      },
                      .None => ()
                    );
                    spi = (spi + usize(1));
                  };
                  return Option(EvalResult).Some(eval_result(.ArrayVal(result_arr), t_unit()));
                }
              )
            },
            _ => { return Option(EvalResult).None; }
          ),
        true => ()
      );

      maybe_mval := match(env.*.lookup(qn),
        .Some(mv) => mv.value,
        .None =>
          match(env.*.lookup(String.from(mname)),
            .Some(mv2) => mv2.value,
            .None => Option(EvalValue).None
          )
      );
      match(maybe_mval,
        .None => Option(EvalResult).None,
        .Some(mval) => {
          evaled := ArrayList(EvalResult).new();
          evaled.push(eval_result(recv_val, type_of_eval_value(recv_val)));
          n_ca := method_call_args.len();
          (cai : usize) = usize(0);
          (caok : bool) = true;
          while runtime(((cai < n_ca) && caok)), {
            match(method_call_args.get(cai),
              .Some(aexpr) =>
                match(match(g_eval_fn,
                  .Some(ef) => ef(aexpr, env),
                  .None => Option(EvalResult).None
                ),
                  .Some(ar) => { evaled.push(ar); },
                  .None => { caok = false; }
                ),
              .None => { caok = false; }
            );
            cai = (cai + usize(1));
          };
          cond(
            (!(caok)) => Option(EvalResult).None,
            true => call_funcval_with_args(mval, evaled)
          )
        }
      )
    }
  )
);

// ---------------------------------------------------------------------------
// impl handler helper — Phase 3j
// Handles `impl(TypeName, method_name : fn_def, …)` forms.
// Factored out of `evaluate` to reduce evaluate's C stack frame.
// Uses g_eval_fn to evaluate method bodies.
// ---------------------------------------------------------------------------
handle_impl_form :: (fn(
  args : ArrayList(AstExpr),
  env  : *(Environment)
) -> Option(EvalResult))(
  match(args.get(usize(0)),
    .None => Option(EvalResult).None,
    .Some(ty_expr) =>
      match(ty_expr,
        .FnCall(_, _, _, _, _) => Option(EvalResult).None,
        .Atom(_, ty_tok) => {
          ty_nm := ty_tok.value.as_str();
          n_margs := args.len();
          (mi : usize) = usize(1);
          (mok : bool) = true;
          while runtime(((mi < n_margs) && mok)), {
            match(args.get(mi),
              .Some(meth_expr) =>
                match(meth_expr,
                  .FnCall(_, colon_func, colon_args, colon_infix, _) => {
                    cond(
                      (colon_infix) =>
                        match(colon_func.*,
                          .Atom(_, colon_tok) => {
                            cond(
                              (colon_tok.value.as_str() == ":") => {
                                match(colon_args.get(usize(0)),
                                  .Some(name_expr) =>
                                    match(name_expr,
                                      .Atom(_, name_tok) => {
                                        match(colon_args.get(usize(1)),
                                          .Some(fn_expr) => {
                                            match(match(g_eval_fn,
                                              .Some(ef) => ef(fn_expr, env),
                                              .None => Option(EvalResult).None
                                            ),
                                              .Some(mres) => {
                                                qn := `${String.from(ty_nm)}.${name_tok.value}`;
                                                _dm := env.define_val(
                                                  qn,
                                                  type_of_eval_value(mres.value),
                                                  value_is_comptime(mres.value),
                                                  .Some(mres.value)
                                                );
                                              },
                                              .None => { mok = false; }
                                            );
                                          },
                                          .None => ()
                                        );
                                      },
                                      .FnCall(_, _, _, _, _) => ()
                                    ),
                                  .None => ()
                                );
                              },
                              true => ()
                            );
                          },
                          .FnCall(_, _, _, _, _) => ()
                        ),
                      true => ()
                    );
                  },
                  _ => ()
                ),
              .None => ()
            );
            mi = (mi + usize(1));
          };
          cond(
            (!(mok)) => Option(EvalResult).None,
            true => .Some(eval_result(.UnitVal, t_unit()))
          )
        }
      )
  )
);

/// Evaluate a list of top-level module expressions and collect exports.
///
/// Iterates `exprs`, evaluating each one through `g_eval_fn`. When an
/// `export(name1, name2, …)` call is encountered the named variables are
/// looked up in `env` and appended to the result `ModuleVal`.
///
/// Returns `Some(ModuleVal(names, values))` on success, or `None` if
/// `g_eval_fn` is not set or any expression fails to evaluate.
evaluate_module_body :: (fn(exprs : ArrayList(AstExpr), env : *(Environment)) -> Option(EvalValue))({
  names  := ArrayList(String).new();
  values := ArrayList(EvalValue).new();
  n      := exprs.len();
  (i   : usize) = usize(0);
  (ok  : bool)  = true;
  while runtime(((i < n) && ok)), {
    match(exprs.get(i),
      .Some(expr) =>
        match(expr,
          // export(name1, name2, …) — collect exported bindings
          .FnCall(_, fb, fargs, _, _) =>
            match(fb.*,
              .Atom(_, ftok) =>
                cond(
                  (ftok.value.as_str() == BK_EXPORT) => {
                    j  := usize(0);
                    nj := fargs.len();
                    while runtime(((j < nj) && ok)), {
                      match(fargs.get(j),
                        .Some(export_expr) =>
                          match(export_expr,
                            .Atom(_, name_tok) => {
                              match(env.*.lookup(String.from(name_tok.value.as_str())),
                                .Some(var) => {
                                  exported_val := match(var.value,
                                    .Some(v) => v,
                                    .None    => EvalValue.VarRef(String.from(name_tok.value.as_str()))
                                  );
                                  names.push(String.from(name_tok.value.as_str()));
                                  values.push(exported_val);
                                },
                                .None => { ok = false; }
                              );
                            },
                            .FnCall(_, _, _, _, _) => { ok = false; }
                          ),
                        .None => { ok = false; }
                      );
                      j = (j + usize(1));
                    };
                  },
                  // Regular expression — evaluate normally
                  true =>
                    match(g_eval_fn,
                      .Some(eval_fn) =>
                        match(eval_fn(expr, env),
                          .Some(_) => (),
                          .None    => { ok = false; }
                        ),
                      .None => { ok = false; }
                    )
                ),
              .FnCall(_, _, _, _, _) =>
                // Complex func head — evaluate normally
                match(g_eval_fn,
                  .Some(eval_fn) =>
                    match(eval_fn(expr, env),
                      .Some(_) => (),
                      .None    => { ok = false; }
                    ),
                  .None => { ok = false; }
                )
            ),
          // Atom at module level — evaluate normally
          .Atom(_, _) =>
            match(g_eval_fn,
              .Some(eval_fn) =>
                match(eval_fn(expr, env),
                  .Some(_) => (),
                  .None    => { ok = false; }
                ),
              .None => { ok = false; }
            )
        ),
      .None => { ok = false; }
    );
    i = (i + usize(1));
  };
  cond(
    ok => .Some(.ModuleVal(names, values)),
    true => Option(EvalValue).None
  )
});

// ---------------------------------------------------------------------------
// Phase 3n helpers — factored out of evaluate to keep its ASAN frame small.
// ---------------------------------------------------------------------------

/// Handle `if(cond, then)` or `if(cond, then, else)`.
/// Uses g_eval_fn for recursive evaluation.
// ---------------------------------------------------------------------------
// Anonymous struct literal helper — Phase 2bk
// Handles _(field: val, …) and _(val, …) in the mini-evaluator.
// Factored out of evaluate to keep evaluate's C stack frame small.
// ---------------------------------------------------------------------------
handle_anon_struct_form :: (fn(
  args : ArrayList(AstExpr),
  env  : *(Environment)
) -> Option(EvalResult))({
  n_as := args.len();
  fn_as := ArrayList(String).new();
  fv_as := ArrayList(EvalValue).new();
  (as_i : usize) = usize(0);
  (as_ok : bool) = true;
  while runtime(((as_i < n_as) && as_ok)), {
    match(args.get(as_i),
      .Some(as_arg) =>
        match(as_arg,
          // Could be a labeled field: label : value  (infix ":" call)
          .FnCall(_, as_f, as_na, as_infix, _) =>
            cond(
              (as_infix && match(as_f.*, .Atom(_, as_ct) => (as_ct.value.as_str() == ":"), .FnCall(_, _, _, _, _) => false)) =>
                match(as_na.get(usize(0)),
                  .Some(as_le) =>
                    match(as_le,
                      .Atom(_, as_lt) =>
                        match(as_na.get(usize(1)),
                          .Some(as_ve) =>
                            match(match(g_eval_fn, .Some(ef) => ef(as_ve, env), .None => Option(EvalResult).None),
                              .Some(as_vr) => {
                                fn_as.push(as_lt.value);
                                fv_as.push(as_vr.value);
                              },
                              .None => { as_ok = false; }
                            ),
                          .None => { as_ok = false; }
                        ),
                      .FnCall(_, _, _, _, _) => { as_ok = false; }
                    ),
                  .None => { as_ok = false; }
                ),
              // positional FnCall field
              true =>
                match(match(g_eval_fn, .Some(ef) => ef(as_arg, env), .None => Option(EvalResult).None),
                  .Some(as_pr) => {
                    fn_as.push(String.from("__field_").concat(as_i.to_string()));
                    fv_as.push(as_pr.value);
                  },
                  .None => { as_ok = false; }
                )
            ),
          // positional Atom field (e.g., integer, bool literal)
          .Atom(_, _) =>
            match(match(g_eval_fn, .Some(ef) => ef(as_arg, env), .None => Option(EvalResult).None),
              .Some(as_pr) => {
                fn_as.push(String.from("__field_").concat(as_i.to_string()));
                fv_as.push(as_pr.value);
              },
              .None => { as_ok = false; }
            )
        ),
      .None => { as_ok = false; }
    );
    as_i = (as_i + usize(1));
  };
  cond(
    (!(as_ok)) => Option(EvalResult).None,
    true => .Some(eval_result(.StructVal(String.from("_"), fn_as, fv_as), t_unit()))
  )
});

handle_if_form :: (fn(
  args : ArrayList(AstExpr),
  env  : *(Environment)
) -> Option(EvalResult))({
  n_if := args.len();
  match(args.get(usize(0)),
    .None => Option(EvalResult).None,
    .Some(cond_expr) =>
      match(match(g_eval_fn,
        .Some(ef) => ef(cond_expr, env),
        .None => Option(EvalResult).None
      ),
        .None => Option(EvalResult).None,
        .Some(cond_r) =>
          match(cond_r.value,
            .BoolVal(b) =>
              cond(
                b =>
                  match(args.get(usize(1)),
                    .Some(then_e) =>
                      match(g_eval_fn, .Some(ef) => ef(then_e, env), .None => Option(EvalResult).None),
                    .None => Option(EvalResult).None
                  ),
                (n_if >= usize(3)) =>
                  match(args.get(usize(2)),
                    .Some(else_e) =>
                      match(g_eval_fn, .Some(ef) => ef(else_e, env), .None => Option(EvalResult).None),
                    .None => Option(EvalResult).None
                  ),
                true => .Some(eval_result(.UnitVal, t_unit()))
              ),
            _ => Option(EvalResult).None
          )
      )
  )
});

/// Fold `lv op rv` where both sides are float.  `fval` is "+", "-", "*", "/".
eval_float_arith :: (fn(fval : str, lv : EvalResult, rv : EvalResult) -> Option(EvalResult))({
  lv_ty := lv.ty;
  a_raw := match(lv.value, .FloatLit(raw) => raw, _ => { return Option(EvalResult).None; });
  b_raw := match(rv.value, .FloatLit(raw) => raw, _ => { return Option(EvalResult).None; });
  a := match(parse_raw_float(a_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
  b := match(parse_raw_float(b_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
  res_opt := cond(
    (fval == "+") => Option(f64).Some((a + b)),
    (fval == "-") => Option(f64).Some((a - b)),
    (fval == "*") => Option(f64).Some((a * b)),
    (fval == "/") => cond((b == f64(0)) => Option(f64).None, true => Option(f64).Some((a / b))),
    true => Option(f64).None
  );
  match(res_opt,
    .Some(res) => .Some(eval_result(.FloatLit(res.to_string()), lv_ty)),
    .None => Option(EvalResult).None
  )
});

/// Compare two float EvalResults with operator `fval` (==, !=, <, >, <=, >=).
eval_float_cmp :: (fn(fval : str, lv : EvalResult, rv : EvalResult) -> Option(EvalResult))({
  a_raw := match(lv.value, .FloatLit(raw) => raw, _ => { return Option(EvalResult).None; });
  b_raw := match(rv.value, .FloatLit(raw) => raw, _ => { return Option(EvalResult).None; });
  a := match(parse_raw_float(a_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
  b := match(parse_raw_float(b_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
  res := cond(
    (fval == "==") => (a == b),
    (fval == "!=") => (!(a == b)),
    (fval == "<")  => (a < b),
    (fval == ">")  => (a > b),
    (fval == "<=") => (a <= b),
    (fval == ">=") => (a >= b),
    true           => { return Option(EvalResult).None; }
  );
  .Some(eval_result(.BoolVal(res), t_bool()))
});

/// Negate a float EvalResult.
eval_float_neg :: (fn(v : EvalResult) -> Option(EvalResult))({
  v_ty := v.ty;
  match(v.value,
    .FloatLit(raw) => {
      a := match(parse_raw_float(raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
      .Some(eval_result(.FloatLit((f64(0.0) - a).to_string()), v_ty))
    },
    _ => Option(EvalResult).None
  )
});

/// Extract the parameter name from `comptime(Name)` form.
/// Returns `Some(name)` when the box is `comptime(Atom(name))`, else `None`.
extract_comptime_param_name :: (fn(
  ct_box  : Box(AstExpr),
  ct_args : ArrayList(AstExpr)
) -> Option(String))(
  match(ct_box.*,
    .Atom(_, ct_tok) =>
      cond(
        (ct_tok.value.as_str() == "comptime") =>
          match(ct_args.get(usize(0)),
            .Some(ct_name_e) =>
              match(ct_name_e,
                .Atom(_, ct_name_tok) => .Some(ct_name_tok.value),
                .FnCall(_, _, _, _, _) => Option(String).None
              ),
            .None => Option(String).None
          ),
        true => Option(String).None
      ),
    .FnCall(_, _, _, _, _) => Option(String).None
  )
);

/// Extract the evidence parameter name from the inner expression of a
/// `using(...)` parameter declaration.
///
/// For `using(name : Type)` the inner expression is
/// `FnCall(Atom(":"), [Atom("name"), type_expr], true)` → returns `"name"`.
/// For `using(name)` the inner expression is `Atom("name")` → returns `"name"`.
extract_evidence_param_name :: (fn(ev_inner : AstExpr) -> Option(String))(
  match(ev_inner,
    .FnCall(_, ev_kw_box, ev_kw_args, _, _) =>
      match(ev_kw_box.*,
        .Atom(_, ev_kw_tok) =>
          cond(
            (ev_kw_tok.value.as_str() == ":") =>
              match(ev_kw_args.get(usize(0)),
                .Some(ev_name_expr) =>
                  match(ev_name_expr,
                    .Atom(_, ev_name_tok) => Option(String).Some(ev_name_tok.value),
                    .FnCall(_, _, _, _, _) => Option(String).None
                  ),
                .None => Option(String).None
              ),
            true => Option(String).None
          ),
        .FnCall(_, _, _, _, _) => Option(String).None
      ),
    .Atom(_, ev_bare_tok) => Option(String).Some(ev_bare_tok.value)
  )
);

/// Evaluate a `using(inner_expr)` form at a call site.
///
/// `using(name)` passes the value of `name` from the caller's environment as
/// evidence to the callee.  This allows the evaluator to resolve evidence
/// params bound by `using(name : Type)` declarations in the callee.
handle_using_call :: (fn(
  args : ArrayList(AstExpr),
  env  : *(Environment)
) -> Option(EvalResult))(
  match(g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) =>
      match(args.get(usize(0)),
        .Some(inner_expr) => ef(inner_expr, env),
        .None => Option(EvalResult).None
      )
  )
);

// ---------------------------------------------------------------------------
// Type definition helpers — Phase 3z
// Factored out to keep evaluate's frame small (ASAN concern).
// ---------------------------------------------------------------------------

/// Evaluate `enum(None, Some(value: T), ...)` and produce `TypeVal(EnumT(...))`.
///
/// Each arg to `enum(...)` is a variant descriptor (NOT dot-prefixed):
///   - Atom: `Less` — fieldless variant
///   - FnCall: `Some(value: T)` — variant with labeled fields
///   - Infix `=`: `Red = 0` or `Some(x: i32) = 5` — variant with explicit discriminant
///
/// Field types are evaluated via `ef` to extract their TypeValues.
handle_enum_def :: (fn(
  args : ArrayList(AstExpr),
  env  : *(Environment)
) -> Option(EvalResult))(
  match(g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) => {
      enum_id      := `enum_${random_id(String.from(""))}`;
      v_names      := ArrayList(String).new();
      v_fields_all := ArrayList(ArrayList(TypeValue)).new();
      v_labels_all := ArrayList(ArrayList(String)).new();
      v_discs      := ArrayList(i64).new();
      (next_disc : i64) = i64(0);
      (ok : bool) = true;
      n := args.len();
      (i : usize) = usize(0);
      while runtime(((i < n) && ok)), {
        match(args.get(i),
          .Some(variant_expr) => {
            // Detect custom discriminant wrapper: vcore = discriminant
            (disc_opt   : Option(i64)) = Option(i64).None;
            (vcore_expr : AstExpr)     = variant_expr;
            is_eq_wrap := match(variant_expr,
              .FnCall(_, fb, _, vis_infix, _) =>
                match(fb.*, .Atom(_, tok) => ((tok.value.as_str() == "=") && vis_infix), .FnCall(_, _, _, _, _) => false),
              .Atom(_, _) => false
            );
            if(is_eq_wrap, {
              match(variant_expr,
                .FnCall(_, _, eq_args, _, _) => {
                  match(eq_args.get(usize(0)), .Some(lhs_e) => { vcore_expr = lhs_e; }, .None => { ok = false; });
                  match(eq_args.get(usize(1)),
                    .Some(disc_e) =>
                      match(ef(disc_e, env),
                        .Some(dr) =>
                          match(dr.value,
                            .IntLit(s) => {
                              d := match(parse_raw_int(s), .Some(x) => x, .None => i64(0));
                              disc_opt = .Some(d);
                            },
                            _ => ()
                          ),
                        .None => ()
                      ),
                    .None => ()
                  );
                },
                .Atom(_, _) => ()
              );
            });

            // Compute discriminant value and advance counter
            disc := match(disc_opt,
              .Some(d) => { next_disc = (d + i64(1)); d },
              .None => { d := next_disc; next_disc = (next_disc + i64(1)); d }
            );

            // Handle variant core expression:
            //   Atom("None")              → fieldless variant
            //   FnCall(Atom("Some"), [...]) → variant with fields
            match(vcore_expr,
              .Atom(_, vtok) => {
                vname_s := vtok.value.as_str();
                cond(
                  (vname_s == "_") => { ok = false; },
                  true => {
                    v_names.push(String.from(vname_s));
                    v_fields_all.push(ArrayList(TypeValue).new());
                    v_labels_all.push(ArrayList(String).new());
                    v_discs.push(disc);
                  }
                );
              },
              .FnCall(_, vfunc_box, vfield_args, _, _) => {
                vname_s := match(vfunc_box.*,
                  .Atom(_, vftok) => vftok.value.as_str(),
                  .FnCall(_, _, _, _, _) => { ok = false; "" }
                );
                cond(
                  (!(ok)) => (),
                  true => {
                    field_tys := ArrayList(TypeValue).new();
                    field_lbs := ArrayList(String).new();
                    n_vf := vfield_args.len();
                    (vfi : usize) = usize(0);
                    (vfok : bool) = true;
                    while runtime(((vfi < n_vf) && vfok)), {
                      match(vfield_args.get(vfi),
                        .Some(field_e) => {
                          // `label : type_expr` labeled field
                          is_colon_field := match(field_e,
                            .FnCall(_, fc_box, _, fc_infix, _) =>
                              match(fc_box.*, .Atom(_, fc_tok) => ((fc_tok.value.as_str() == ":") && fc_infix), .FnCall(_, _, _, _, _) => false),
                            .Atom(_, _) => false
                          );
                          cond(
                            is_colon_field => {
                              match(field_e,
                                .FnCall(_, _, fc_args, _, _) => {
                                  flabel := match(fc_args.get(usize(0)),
                                    .Some(le) => match(le, .Atom(_, ltok) => ltok.value.as_str(), .FnCall(_, _, _, _, _) => ""),
                                    .None => ""
                                  );
                                  fty := match(fc_args.get(usize(1)),
                                    .Some(te) =>
                                      match(ef(te, env),
                                        .Some(tr) => match(tr.value, .TypeVal(tb) => tb.*, _ => t_unit()),
                                        .None => t_unit()
                                      ),
                                    .None => t_unit()
                                  );
                                  field_lbs.push(String.from(flabel));
                                  field_tys.push(fty);
                                },
                                .Atom(_, _) => ()
                              );
                            },
                            // Unlabeled field: just a type expression
                            true => {
                              fty := match(ef(field_e, env),
                                .Some(fr) => match(fr.value, .TypeVal(tb) => tb.*, _ => t_unit()),
                                .None => t_unit()
                              );
                              field_lbs.push(String.from(""));
                              field_tys.push(fty);
                            }
                          );
                        },
                        .None => { vfok = false; }
                      );
                      vfi = (vfi + usize(1));
                    };
                    v_names.push(String.from(vname_s));
                    v_fields_all.push(field_tys);
                    v_labels_all.push(field_lbs);
                    v_discs.push(disc);
                    if((!(vfok)), { ok = false; });
                  }
                );
              }
            );
          },
          .None => { ok = false; }
        );
        i = (i + usize(1));
      };
      cond(
        (!(ok)) => Option(EvalResult).None,
        true =>
          .Some(eval_result(
            .TypeVal(box(TypeValue.EnumT(
              String.from(enum_id.as_str()),
              String.from(""),
              v_names,
              v_fields_all,
              Option(String).None,
              v_labels_all,
              v_discs
            ))),
            t_type()
          ))
      )
    }
  )
);

/// Evaluate `struct(name: Type, ...)`, `object(name: Type, ...)`, or
/// `newtype(wrapped_type)` and produce `TypeVal(Struct(...))`.
///
/// Each arg is expected to be a labeled field `name : type_expr`.
/// For newtype, a single unlabeled type expression is also accepted.
handle_struct_def :: (fn(
  args       : ArrayList(AstExpr),
  is_ref_sem : bool,
  is_newtype : bool,
  env        : *(Environment)
) -> Option(EvalResult))(
  match(g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) => {
      struct_id := `struct_${random_id(String.from(""))}`;
      f_labels  := ArrayList(String).new();
      f_types   := ArrayList(TypeValue).new();
      (ok : bool) = true;
      n := args.len();
      (i : usize) = usize(0);
      while runtime(((i < n) && ok)), {
        match(args.get(i),
          .Some(field_expr) => {
            // Check for labeled field: `name : type_expr` (infix :)
            is_labeled := match(field_expr,
              .FnCall(_, fb, _, finfix, _) =>
                match(fb.*, .Atom(_, tok) => ((tok.value.as_str() == ":") && finfix), .FnCall(_, _, _, _, _) => false),
              .Atom(_, _) => false
            );
            cond(
              is_labeled => {
                match(field_expr,
                  .FnCall(_, _, fargs, _, _) => {
                    fname := match(fargs.get(usize(0)),
                      .Some(ne) => match(ne, .Atom(_, tok) => tok.value.as_str(), .FnCall(_, _, _, _, _) => ""),
                      .None => ""
                    );
                    match(fargs.get(usize(1)),
                      .Some(type_expr) =>
                        match(ef(type_expr, env),
                          .Some(fres) => {
                            fty := match(fres.value, .TypeVal(tyb) => tyb.*, _ => t_unit());
                            f_labels.push(String.from(fname));
                            f_types.push(fty);
                          },
                          .None => {
                            f_labels.push(String.from(fname));
                            f_types.push(t_unit());
                          }
                        ),
                      .None => ()
                    );
                  },
                  .Atom(_, _) => ()
                );
              },
              // Unlabeled field (e.g. newtype single-arg): evaluate as type
              true => {
                match(ef(field_expr, env),
                  .Some(fres) => {
                    fty := match(fres.value, .TypeVal(tyb) => tyb.*, _ => t_unit());
                    f_labels.push(String.from("*"));
                    f_types.push(fty);
                  },
                  .None => {
                    f_labels.push(String.from("*"));
                    f_types.push(t_unit());
                  }
                );
              }
            );
          },
          .None => { ok = false; }
        );
        i = (i + usize(1));
      };
      cond(
        (!(ok)) => Option(EvalResult).None,
        true =>
          .Some(eval_result(
            .TypeVal(box(TypeValue.Struct(
              String.from(struct_id.as_str()),
              String.from(""),
              f_labels,
              f_types,
              is_ref_sem,
              false,
              is_newtype
            ))),
            t_type()
          ))
      )
    }
  )
);

/// Evaluate `union(name: Type, ...)` and produce `TypeVal(Union(...))`.
handle_union_def :: (fn(
  args : ArrayList(AstExpr),
  env  : *(Environment)
) -> Option(EvalResult))(
  match(g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) => {
      f_labels := ArrayList(String).new();
      f_types  := ArrayList(TypeValue).new();
      (ok : bool) = true;
      n := args.len();
      (i : usize) = usize(0);
      while runtime(((i < n) && ok)), {
        match(args.get(i),
          .Some(field_expr) => {
            is_labeled := match(field_expr,
              .FnCall(_, fb, _, finfix, _) =>
                match(fb.*, .Atom(_, tok) => ((tok.value.as_str() == ":") && finfix), .FnCall(_, _, _, _, _) => false),
              .Atom(_, _) => false
            );
            cond(
              is_labeled => {
                match(field_expr,
                  .FnCall(_, _, fargs, _, _) => {
                    fname := match(fargs.get(usize(0)),
                      .Some(ne) => match(ne, .Atom(_, tok) => tok.value.as_str(), .FnCall(_, _, _, _, _) => ""),
                      .None => ""
                    );
                    match(fargs.get(usize(1)),
                      .Some(type_expr) =>
                        match(ef(type_expr, env),
                          .Some(fres) => {
                            fty := match(fres.value, .TypeVal(tyb) => tyb.*, _ => t_unit());
                            f_labels.push(String.from(fname));
                            f_types.push(fty);
                          },
                          .None => {
                            f_labels.push(String.from(fname));
                            f_types.push(t_unit());
                          }
                        ),
                      .None => ()
                    );
                  },
                  .Atom(_, _) => ()
                );
              },
              true => {
                match(ef(field_expr, env),
                  .Some(fres) => {
                    fty := match(fres.value, .TypeVal(tyb) => tyb.*, _ => t_unit());
                    f_labels.push(String.from(""));
                    f_types.push(fty);
                  },
                  .None => {
                    f_labels.push(String.from(""));
                    f_types.push(t_unit());
                  }
                );
              }
            );
          },
          .None => { ok = false; }
        );
        i = (i + usize(1));
      };
      cond(
        (!(ok)) => Option(EvalResult).None,
        true =>
          .Some(eval_result(
            .TypeVal(box(TypeValue.Union(
              String.from(""),
              f_labels,
              f_types
            ))),
            t_type()
          ))
      )
    }
  )
);

/// Simplified `trait(...)` handler.
///
/// Phase 3z stub: creates an empty `TraitT` TypeValue so that `trait` definitions
/// can be assigned to names in the environment. Method signatures are NOT
/// currently evaluated (deferred to a later phase).
handle_trait_def :: (fn(
  _args : ArrayList(AstExpr),
  _env  : *(Environment)
) -> Option(EvalResult))(
  cond(true => {
    trait_id := `trait_${random_id(String.from(""))}`;
    .Some(eval_result(
      .TypeVal(box(TypeValue.TraitT(
        String.from(""),
        ArrayList(String).new(),
        ArrayList(String).new(),
        ArrayList(TypeValue).new(),
        String.from(trait_id.as_str()),
        Option(Box(TypeValue)).None,
        ArrayList(TypeValue).new(),
        ArrayList(TypeValue).new()
      ))),
      t_type()
    ))
  })
);

/// Evaluate a single `AstExpr` node in the given environment.
///
/// Returns `None` for expression forms not yet handled (Phase 3e+ scope).
evaluate :: (fn(e : AstExpr, env : *(Environment)) -> Option(EvalResult))(
  match(e,
    .Atom(_, tok) =>
      eval_atom(tok, env),

    .FnCall(_, func_box, args, is_infix, _tok) =>
      match(func_box.*,
        // -----------------------------------------------------------------
        // Enum variant construction with args: .Some(42), .Ok(x), …
        //   func_box.* = FnCall(Atom(Dot), [Atom("Some")], true)
        //   outer args = [arg1, arg2, …]
        //
        // Function definition: (fn(params) -> RetType)(body)
        //   func_box.* = FnCall(Atom("->"), [FnCall(Atom("fn"), [...]), RetType], true)
        //   outer args = [body_expr]
        // -----------------------------------------------------------------
        .FnCall(_, inner_func, inner_args, _, _) => 
          match(inner_func.*,
            .Atom(_, dt) =>
              cond(
                // ---- Dot head: two cases ----
                // 1. Self-hosted method call:
                //    FnCall(FnCall(Dot,[recv,method],true), outer_args, false)
                //    inner_args.len() == 2: [receiver_expr, method_name_expr]
                //    Evaluate receiver, then dispatch via handle_method_dispatch.
                //
                // 2. TS-format enum variant with args:
                //    FnCall(FnCall(Dot,[Atom("VName")],true), fields, false)
                //    inner_args.len() == 1: [Atom("VariantName")]
                //    Build EnumVal with evaluated outer args as fields.
                (dt.kind == TokenKind.Dot) =>
                  cond(
                    // Method call: inner_args has 2 elements [receiver, method_name]
                    (inner_args.len() == usize(2)) => {
                      recv_expr := match(inner_args.get(usize(0)),
                        .Some(x) => x,
                        .None    => { return Option(EvalResult).None; }
                      );
                      method_expr := match(inner_args.get(usize(1)),
                        .Some(x) => x,
                        .None    => { return Option(EvalResult).None; }
                      );
                      // Phase 3am SH-format ArrayVal.push pre-pass:
                      // In self-hosted format, arr.push(x) parses as (arr.push)(x),
                      // so handle_array_push_mutation (TS-format path) is never called.
                      // Mirror the push logic here for bare-identifier ArrayVal receivers.
                      match(method_expr,
                        .Atom(_, sh_push_tok) =>
                          cond(
                            ((sh_push_tok.value.as_str() == "push") && (args.len() == usize(1))) =>
                              match(recv_expr,
                                .Atom(_, sh_arr_tok) =>
                                  match(env.*.lookup(sh_arr_tok.value),
                                    .None => (),
                                    .Some(sh_var) =>
                                      match(sh_var.value,
                                        .None => (),
                                        .Some(sh_arr_ev) =>
                                          match(sh_arr_ev,
                                            .ArrayVal(sh_items) =>
                                              match(args.get(usize(0)),
                                                .None => (),
                                                .Some(sh_push_arg) =>
                                                  match(match(g_eval_fn,
                                                      .Some(ef_sh) => ef_sh(sh_push_arg, env),
                                                      .None => Option(EvalResult).None
                                                    ),
                                                    .None => (),
                                                    .Some(sh_push_res) => {
                                                      sh_items.push(sh_push_res.value);
                                                      return Option(EvalResult).Some(eval_result(.UnitVal, t_unit()));
                                                    }
                                                  )
                                              ),
                                            _ => ()
                                          )
                                      )
                                  ),
                                _ => ()
                              ),
                            true => ()
                          ),
                        .FnCall(_, _, _, _, _) => ()
                      );
                      recv_res := match(recur(recv_expr, env),
                        .Some(x) => x,
                        .None    => { return Option(EvalResult).None; }
                      );
                      handle_method_dispatch(recv_res.value, box(method_expr), args, env)
                    },
                    // TS-format enum variant with args: inner_args has 1 element
                    true => {
                      vname := match(inner_args.get(usize(0)),
                        .Some(vne) => match(vne,
                          .Atom(_, vntok) => vntok.value.as_str(),
                          .FnCall(_, _, _, _, _) => { return Option(EvalResult).None; }
                        ),
                        .None => { return Option(EvalResult).None; }
                      );
                      variant_str := `.${ String.from(vname) }`;
                      n_args := args.len();
                      fields := ArrayList(EvalValue).new();
                      (i : usize) = usize(0);
                      (ok : bool) = true;
                      while runtime(((i < n_args) && ok)), {
                        match(args.get(i),
                          .Some(arg_expr) =>
                            match(recur(arg_expr, env),
                              .Some(r) => { fields.push(r.value); },
                              .None    => { ok = false; }
                            ),
                          .None => { ok = false; }
                        );
                        i = (i + usize(1));
                      };
                      cond(
                        ok => .Some(eval_result(.EnumVal(variant_str, fields), t_unit())),
                        true => Option(EvalResult).None
                      )
                    }
                  ),

                // ---- function definition: (fn(params) -> RetType)(body) ----
                (dt.value.as_str() == "->") =>
                  match(inner_args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(fn_call_expr) =>
                      match(fn_call_expr,
                        .Atom(_, _) => Option(EvalResult).None,
                        .FnCall(_, fn_func_box, fn_params_list, _, _) => {
                          // Verify func_box is `fn` atom
                          ok_fn := match(fn_func_box.*,
                            .Atom(_, fntok) => (fntok.value.as_str() == "fn"),
                            .FnCall(_, _, _, _, _) => false
                          );
                          cond(
                            (!(ok_fn)) => Option(EvalResult).None,
                            true => {
                              // Extract forall names, param names, and param type
                              // annotation identifiers from the param list.
                              //
                              // Each param is one of:
                              //   FnCall(Atom("forall"), [Atom("T")], false)
                              //     → forall name "T"
                              //   FnCall(Atom("forall"), [FnCall(Atom(":"), [Atom("T"), ...], true)], false)
                              //     → forall name "T" (constrained forall)
                              //   FnCall(Atom(":"), [Atom(name), type_expr], true)
                              //     → value param "name" with type annotation
                              //   Atom(name)
                              //     → bare value param (no type annotation)
                              //   Other (using/where) → skip
                              forall_names_f    := ArrayList(String).new();
                              params_f          := ArrayList(String).new();
                              param_type_names_f := ArrayList(String).new();
                              evidence_params_f := ArrayList(String).new();
                              (pi : usize) = usize(0);
                              n_p := fn_params_list.len();
                              (param_ok : bool) = true;
                              while runtime(((pi < n_p) && param_ok)), {
                                match(fn_params_list.get(pi),
                                  .Some(pd) =>
                                    match(pd,
                                      .FnCall(_, kw_box, kw_args, _, _) =>
                                        match(kw_box.*,
                                          .Atom(_, kw_tok) =>
                                            cond(
                                              (kw_tok.value.as_str() == ":") =>
                                                // Value param: extract name + type annotation
                                                match(kw_args.get(usize(0)),
                                                  .Some(name_expr) =>
                                                    match(name_expr,
                                                      .Atom(_, name_tok) => {
                                                        params_f.push(name_tok.value);
                                                        // Capture simple identifier type annotation
                                                        ptn_s := match(kw_args.get(usize(1)),
                                                          .Some(te) =>
                                                            match(te,
                                                              .Atom(_, type_tok) => type_tok.value.as_str(),
                                                              .FnCall(_, _, _, _, _) => ""
                                                            ),
                                                          .None => ""
                                                        );
                                                        param_type_names_f.push(String.from(ptn_s));
                                                      },
                                                      .FnCall(_, ct_box, ct_args, _, _) =>
                                                        match(extract_comptime_param_name(ct_box, ct_args),
                                                          .Some(ct_name) => {
                                                            params_f.push(ct_name);
                                                            param_type_names_f.push(String.from(""));
                                                          },
                                                          .None => { param_ok = false; }
                                                        )
                                                    ),
                                                  .None => { param_ok = false; }
                                                ),
                                              (kw_tok.value.as_str() == "forall") =>
                                                // Forall param: extract generic name
                                                match(kw_args.get(usize(0)),
                                                  .Some(fa_expr) =>
                                                    match(fa_expr,
                                                      // Simple: forall(T)
                                                      .Atom(_, fa_tok) => {
                                                        forall_names_f.push(fa_tok.value);
                                                      },
                                                      // Constrained: forall(T: Constraint)
                                                      .FnCall(_, fa_c_box, fa_c_args, _, _) =>
                                                        match(fa_c_box.*,
                                                          .Atom(_, fa_c_tok) =>
                                                            cond(
                                                              (fa_c_tok.value.as_str() == ":") =>
                                                                match(fa_c_args.get(usize(0)),
                                                                  .Some(fa_name_e) =>
                                                                    match(fa_name_e,
                                                                      .Atom(_, fa_name_tok) => {
                                                                        forall_names_f.push(fa_name_tok.value);
                                                                      },
                                                                      .FnCall(_, _, _, _, _) => ()
                                                                    ),
                                                                  .None => ()
                                                                ),
                                                              true => ()
                                                            ),
                                                          .FnCall(_, _, _, _, _) => ()
                                                        )
                                                    ),
                                                  .None => { param_ok = false; }
                                                ),
                                              // using param: extract evidence name
                                              (kw_tok.value.as_str() == "using") =>
                                                match(kw_args.get(usize(0)),
                                                  .Some(ev_inner) => {
                                                    match(extract_evidence_param_name(ev_inner),
                                                      .Some(ev_name) => {
                                                        evidence_params_f.push(ev_name);
                                                      },
                                                      .None => ()
                                                    );
                                                  },
                                                  .None => ()
                                                ),
                                              // where/other — skip
                                              true => ()
                                            ),
                                          .FnCall(_, _, _, _, _) => { param_ok = false; }
                                        ),
                                      .Atom(_, bare_tok) => {
                                        params_f.push(bare_tok.value);
                                        param_type_names_f.push(String.from(""));
                                      }
                                    ),
                                  .None => { param_ok = false; }
                                );
                                pi = (pi + usize(1));
                              };
                              // Only extract body after params validated (ownership)
                              cond(
                                (!(param_ok)) => Option(EvalResult).None,
                                true =>
                                  match(args.get(usize(0)),
                                    .None => Option(EvalResult).None,
                                    .Some(body_expr) => {
                                      // Capture current env for lexical scoping (Phase 3i).
                                      // __recur_fn is excluded — it is injected at call time.
                                      cap_names_f := ArrayList(String).new();
                                      cap_tys_f   := ArrayList(TypeValue).new();
                                      cap_vals_f  := ArrayList(EvalValue).new();
                                      n_cf := env.*.frames.len();
                                      (cfi : usize) = usize(0);
                                      while runtime((cfi < n_cf)), {
                                        match(env.*.frames.get(cfi),
                                          .Some(frame) => {
                                            n_cv := frame.variables.len();
                                            (cvi : usize) = usize(0);
                                            while runtime((cvi < n_cv)), {
                                              match(frame.variables.get(cvi),
                                                .Some(v) => {
                                                  cond(
                                                    (!(v.name.as_str() == "__recur_fn")) => {
                                                      cap_names_f.push(v.name);
                                                      cap_tys_f.push(v.ty);
                                                      cap_val_f := match(v.value,
                                                        .Some(actual) => actual,
                                                        .None => EvalValue.VarRef(v.name)
                                                      );
                                                      cap_vals_f.push(cap_val_f);
                                                    },
                                                    true => ()
                                                  );
                                                },
                                                .None => ()
                                              );
                                              cvi = (cvi + usize(1));
                                            };
                                          },
                                          .None => ()
                                        );
                                        cfi = (cfi + usize(1));
                                      };
                                      .Some(eval_result(
                                        .FuncVal(
                                          forall_names_f,
                                          params_f,
                                          param_type_names_f,
                                          evidence_params_f,
                                          box(body_expr),
                                          cap_names_f,
                                          cap_tys_f,
                                          cap_vals_f,
                                          random_id(String.from(""))
                                        ),
                                        t_unit()
                                      ))
                                    }
                                  )
                              )
                            }
                          )
                        }
                      )
                  ),

                true => Option(EvalResult).None
              ),
            .FnCall(_, _, _, _, _) => Option(EvalResult).None
          )
        ,
        .Atom(_, ftok) => {
          fval := ftok.value.as_str();
          cond(
            // -----------------------------------------------------------------
            // Unit expression: ()
            // -----------------------------------------------------------------
            ((fval == BK_TUPLE) && (args.len() == usize(0))) =>
              .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Phase 5aa: Tuple expression with args: (a, b, c) — build StructVal
            // Tuples are anonymous structs with numeric field labels.
            // -----------------------------------------------------------------
            ((fval == BK_TUPLE) && (args.len() > usize(0))) => {
              tup_fnames := ArrayList(String).new();
              tup_fvals := ArrayList(EvalValue).new();
              n_tup := args.len();
              (ti : usize) = usize(0);
              (tup_ok : bool) = true;
              while runtime(((ti < n_tup) && tup_ok)), {
                match(args.get(ti),
                  .Some(tup_arg) =>
                    match(recur(tup_arg, env),
                      .Some(tup_res) => {
                        tup_fnames.push(ti.to_string());
                        tup_fvals.push(tup_res.value);
                      },
                      .None => { tup_ok = false; }
                    ),
                  .None => { tup_ok = false; }
                );
                ti = (ti + usize(1));
              };
              cond(
                (!(tup_ok)) => Option(EvalResult).None,
                true => Option(EvalResult).Some(eval_result(.StructVal(String.from("_"), tup_fnames, tup_fvals), t_unit()))
              )
            },

            // -----------------------------------------------------------------
            // Begin block: { stmt1; stmt2; … }
            // -----------------------------------------------------------------
            (fval == BK_BEGIN) => {
              n := args.len();
              cond(
                (n == usize(0)) =>
                  .Some(eval_result(.UnitVal, t_unit())),
                true => {
                  _p := env.push_frame(true);
                  (last : Option(EvalResult)) = .Some(eval_result(.UnitVal, t_unit()));
                  (i : usize) = usize(0);
                  (had_error : bool) = false;
                  (returning : bool) = false;
                  (breaking  : bool) = false;
                  (continuing : bool) = false;
                  while runtime((((i < n) && (!(had_error))) && (((!(returning)) && (!(breaking))) && (!(continuing))))), {
                    match(args.get(i),
                      .Some(stmt) =>
                        match(recur(stmt, env),
                          .Some(r) => {
                            last = .Some(r);
                            match(r.value,
                              .ReturnVal(_, _) => { returning = true; },
                              .BreakVal        => { breaking  = true; },
                              .ContinueVal     => { continuing = true; },
                              _ => ()
                            );
                          },
                          .None => { had_error = true; }
                        ),
                      .None => ()
                    );
                    i = (i + usize(1));
                  };
                  env.pop_frame();
                  cond(
                    had_error => Option(EvalResult).None,
                    true      => last  // returning=true: last=Some(ReturnVal(...)), propagate
                  )
                }
              )
            },

            // -----------------------------------------------------------------
            // cond(arm1, arm2, …)  where each arm is `cond_expr => body_expr`
            // -----------------------------------------------------------------
            (fval == "cond") => {
              n := args.len();
              (result : Option(EvalResult)) = Option(EvalResult).None;
              (i : usize) = usize(0);
              while runtime((i < n)), {
                match(args.get(i),
                  .Some(arm) =>
                    match(arm,
                      .FnCall(_, _, arm_args, _, _) =>
                        match(arm_args.get(usize(0)),
                          .Some(cond_expr) =>
                            match(recur(cond_expr, env),
                              .Some(cond_res) =>
                                match(cond_res.value,
                                  .BoolVal(b) =>
                                    cond(
                                      b => 
                                        match(arm_args.get(usize(1)),
                                          .Some(body_expr) => {
                                            result = recur(body_expr, env);
                                            i = n;
                                          },
                                          .None => { i = n; }
                                        )
                                      ,
                                      true => ()
                                    ),
                                  _ => ()
                                ),
                              .None => ()
                            ),
                          .None => ()
                        ),
                      .Atom(_, _) => ()
                    ),
                  .None => ()
                );
                i = (i + usize(1));
              };
              result
            },

            // -----------------------------------------------------------------
            // Variable define: name := expr  or  (name : T) := expr
            // -----------------------------------------------------------------
            (is_infix && (fval == ":=")) =>
              cond(
                (args.len() < usize(2)) => Option(EvalResult).None,
                true =>
                  match(args.get(usize(0)),
                    .Some(lhs) =>
                      match(args.get(usize(1)),
                        .Some(rhs) =>
                          match(lhs,
                            // bare name: x := rhs  (type inferred from rhs)
                            .Atom(_, name_tok) =>
                              match(recur(rhs, env),
                                .Some(rhs_res) => {
                                  is_ct := value_is_comptime(rhs_res.value);
                                  _idx := env.define_val(
                                    name_tok.value,
                                    rhs_res.ty,
                                    is_ct,
                                    .Some(rhs_res.value)
                                  );
                                  .Some(eval_result(.UnitVal, t_unit()))
                                },
                                .None => Option(EvalResult).None
                              ),
                            // typed: (x : T) := rhs  — declare with explicit type
                            // given(name) := rhs  — implicit/effect parameter installation
                            .FnCall(_, colon_box_a, colon_args_a, _, _) =>
                              match(colon_box_a.*,
                                .Atom(_, colon_tok_a) =>
                                  cond(
                                    (colon_tok_a.value.as_str() == ":") =>
                                      match(colon_args_a.get(usize(0)),
                                        .Some(name_expr_a) =>
                                          match(name_expr_a,
                                            .Atom(_, name_tok_a) =>
                                              match(recur(rhs, env),
                                                .Some(rhs_res) => {
                                                  decl_ty := match(colon_args_a.get(usize(1)),
                                                    .Some(te) => eval_type_annotation_expr(te),
                                                    .None     => rhs_res.ty
                                                  );
                                                  is_ct := value_is_comptime(rhs_res.value);
                                                  _idx := env.define_val(name_tok_a.value, decl_ty, is_ct, .Some(rhs_res.value));
                                                  .Some(eval_result(.UnitVal, t_unit()))
                                                },
                                                .None => Option(EvalResult).None
                                              ),
                                            .FnCall(_, _, _, _, _) => Option(EvalResult).None
                                          ),
                                        .None => Option(EvalResult).None
                                      ),
                                    // given(name) := rhs — implicit parameter installation.
                                    // Mirrors TypeScript binding.ts: sets isImplicit=true, isCompileTimeOnly=true,
                                    // then binds the inner name like a regular comptime binding.
                                    (colon_tok_a.value.as_str() == "given") =>
                                      match(colon_args_a.get(usize(0)),
                                        .None => Option(EvalResult).None,
                                        .Some(inner_expr) =>
                                          match(inner_expr,
                                            .FnCall(_, _, _, _, _) => Option(EvalResult).None,
                                            .Atom(_, inner_tok) =>
                                              match(recur(rhs, env),
                                                .None => Option(EvalResult).None,
                                                .Some(rhs_res) => {
                                                  // Bind as compile-time (isCompileTimeOnly = true)
                                                  _gidx := env.define_val(inner_tok.value, rhs_res.ty, true, .Some(rhs_res.value));
                                                  .Some(eval_result(.UnitVal, t_unit()))
                                                }
                                              )
                                          )
                                      ),
                                    true => Option(EvalResult).None
                                  ),
                                .FnCall(_, _, _, _, _) => Option(EvalResult).None
                              )
                          ),
                        .None => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  )
              ),

            // -----------------------------------------------------------------
            // Variable assign: name = expr  or  (name : T) = expr (declaration)
            // -----------------------------------------------------------------
            (is_infix && (fval == "=")) =>
              cond(
                (args.len() < usize(2)) => Option(EvalResult).None,
                true =>
                  match(args.get(usize(0)),
                    .Some(lhs) =>
                      match(args.get(usize(1)),
                        .Some(rhs) =>
                          match(lhs,
                            // bare name: x = rhs  (mutation of existing binding)
                            .Atom(_, name_tok) =>
                              match(recur(rhs, env),
                                .Some(rhs_res) => {
                                  _found := env.set_value(
                                    name_tok.value,
                                    rhs_res.value
                                  );
                                  .Some(eval_result(.UnitVal, t_unit()))
                                },
                                .None => Option(EvalResult).None
                              ),
                            // struct field mutation OR typed declaration
                            .FnCall(_, colon_box_b, colon_args_b, lhs_infix_b, _) =>
                              match(colon_box_b.*,
                                .Atom(_, colon_tok_b) =>
                                  cond(
                                    (colon_tok_b.value.as_str() == ":") =>
                                      match(colon_args_b.get(usize(0)),
                                        .Some(name_expr_b) =>
                                          match(name_expr_b,
                                            .Atom(_, name_tok_b) =>
                                              match(recur(rhs, env),
                                                .Some(rhs_res) => {
                                                  decl_ty := match(colon_args_b.get(usize(1)),
                                                    .Some(te) => eval_type_annotation_expr(te),
                                                    .None     => rhs_res.ty
                                                  );
                                                  is_ct := value_is_comptime(rhs_res.value);
                                                  _idx := env.define_val(name_tok_b.value, decl_ty, is_ct, .Some(rhs_res.value));
                                                  .Some(eval_result(.UnitVal, t_unit()))
                                                },
                                                .None => Option(EvalResult).None
                                              ),
                                            .FnCall(_, _, _, _, _) => Option(EvalResult).None
                                          ),
                                        .None => Option(EvalResult).None
                                      ),
                                    // struct field assignment: s.field = rhs (Phase 3aq)
                                    ((colon_tok_b.value.as_str() == ".") && lhs_infix_b) =>
                                      handle_struct_field_mutation(
                                        colon_args_b.get(usize(0)),
                                        colon_args_b.get(usize(1)),
                                        rhs,
                                        env
                                      ),
                                    true => Option(EvalResult).None
                                  ),
                                .FnCall(_, _, _, _, _) => Option(EvalResult).None
                              )
                          ),
                        .None => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  )
              ),

            // -----------------------------------------------------------------
            // Arithmetic operators: + - * / %  (comptime_int only)
            // -----------------------------------------------------------------
            (is_infix && (((((((((((fval == "+") || (fval == "-")) || (fval == "*")) || (fval == "/")) || (fval == "%")) || (fval == "|")) || (fval == "&")) || (fval == "^")) || (fval == "<<")) || (fval == ">>")))) => {
              lhs_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rhs_expr := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              lv := match(recur(lhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rv := match(recur(rhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              // Fold int × int (comptime or typed); result preserves lv type
              cond(
                (is_eval_int_type(lv.ty) && is_eval_int_type(rv.ty)) => {
                  lv_ty := lv.ty;
                  a_raw := match(lv.value, .IntLit(raw) => raw, _ => { return Option(EvalResult).None; });
                  b_raw := match(rv.value, .IntLit(raw) => raw, _ => { return Option(EvalResult).None; });
                  a := match(parse_raw_int(a_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  b := match(parse_raw_int(b_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  res_opt := cond(
                    (fval == "+") => Option(i64).Some((a + b)),
                    (fval == "-") => Option(i64).Some((a - b)),
                    (fval == "*") => Option(i64).Some((a * b)),
                    (fval == "/") => cond((b == i64(0)) => Option(i64).None, true => Option(i64).Some((a / b))),
                    (fval == "%") => cond((b == i64(0)) => Option(i64).None, true => Option(i64).Some((a % b))),
                    (fval == "|") => Option(i64).Some((a | b)),
                    (fval == "&") => Option(i64).Some((a & b)),
                    (fval == "^") => Option(i64).Some((a ^ b)),
                    (fval == "<<") => Option(i64).Some((a << b)),
                    (fval == ">>") => Option(i64).Some((a >> b)),
                    true => Option(i64).None
                  );
                  match(res_opt,
                    .Some(res) => .Some(eval_result(.IntLit(res.to_string()), lv_ty)),
                    .None => Option(EvalResult).None
                  )
                },
                // Fold float × float (comptime or typed); result preserves lv type
                (is_eval_float_type(lv.ty) && is_eval_float_type(rv.ty)) =>
                  eval_float_arith(fval, lv, rv),
                // Phase 3aj: StrLit + StrLit — infix string concatenation
                // Strips surrounding `"` delimiters, concatenates inner text, re-quotes.
                ((fval == "+") && (match(lv.value, .StrLit(_) => true, _ => false) && match(rv.value, .StrLit(_) => true, _ => false))) => {
                  lhs_raw_s := match(lv.value, .StrLit(s) => s, _ => { return Option(EvalResult).None; });
                  rhs_raw_s := match(rv.value, .StrLit(s) => s, _ => { return Option(EvalResult).None; });
                  ln_s := lhs_raw_s.len();
                  rn_s := rhs_raw_s.len();
                  cond(
                    ((ln_s < usize(2)) || (rn_s < usize(2))) => Option(EvalResult).None,
                    true => {
                      lhs_inner_s := lhs_raw_s.substring(usize(1), (ln_s - usize(1)));
                      rhs_inner_s := rhs_raw_s.substring(usize(1), (rn_s - usize(1)));
                      concat_s := (((String.from("\"") + lhs_inner_s) + rhs_inner_s) + String.from("\""));
                      .Some(eval_result(.StrLit(concat_s), t_comptime_string()))
                    }
                  )
                },
                true => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Comparison operators: == != < > <= >=
            // Handles comptime_int × comptime_int and bool × bool (== / !=)
            // -----------------------------------------------------------------
            (is_infix && (((((fval == "==") || (fval == "!=")) || (fval == "<")) || (fval == ">")) || ((fval == "<=") || (fval == ">=")))) => {
              lhs_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rhs_expr := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              lv := match(recur(lhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rv := match(recur(rhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              cond(
                // int × int (comptime or typed)
                (is_eval_int_type(lv.ty) && is_eval_int_type(rv.ty)) => {
                  a_raw := match(lv.value, .IntLit(raw) => raw, _ => { return Option(EvalResult).None; });
                  b_raw := match(rv.value, .IntLit(raw) => raw, _ => { return Option(EvalResult).None; });
                  a := match(parse_raw_int(a_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  b := match(parse_raw_int(b_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  res := cond(
                    (fval == "==") => (a == b),
                    (fval == "!=") => (!(a == b)),
                    (fval == "<")  => (a < b),
                    (fval == ">")  => (a > b),
                    (fval == "<=") => (a <= b),
                    (fval == ">=") => (a >= b),
                    true           => { return Option(EvalResult).None; }
                  );
                  .Some(eval_result(.BoolVal(res), t_bool()))
                },
                // bool × bool (== and != only)
                (((type_value_tag(lv.ty) == TypeTag.TBool) && (type_value_tag(rv.ty) == TypeTag.TBool)) && ((fval == "==") || (fval == "!="))) => {
                  la := match(lv.value, .BoolVal(b) => b, _ => { return Option(EvalResult).None; });
                  rb := match(rv.value, .BoolVal(b) => b, _ => { return Option(EvalResult).None; });
                  res := cond((fval == "==") => (la == rb), true => (!(la == rb)));
                  .Some(eval_result(.BoolVal(res), t_bool()))
                },
                // str × str (==, !=, <, >, <=, >=)
                (((type_value_tag(lv.ty) == TypeTag.TComptimeString) && (type_value_tag(rv.ty) == TypeTag.TComptimeString)) && ((((fval == "==") || (fval == "!=")) || ((fval == "<") || (fval == ">"))) || ((fval == "<=") || (fval == ">=")))) => {
                  la_str := match(lv.value, .StrLit(s) => s, _ => { return Option(EvalResult).None; });
                  rb_str := match(rv.value, .StrLit(s) => s, _ => { return Option(EvalResult).None; });
                  res := cond(
                    (fval == "==") => (la_str.as_str() == rb_str.as_str()),
                    (fval == "!=") => (!(la_str.as_str() == rb_str.as_str())),
                    (fval == "<")  => (la_str.as_str() < rb_str.as_str()),
                    (fval == ">")  => (la_str.as_str() > rb_str.as_str()),
                    (fval == "<=") => (la_str.as_str() <= rb_str.as_str()),
                    (fval == ">=") => (la_str.as_str() >= rb_str.as_str()),
                    true => { return Option(EvalResult).None; }
                  );
                  .Some(eval_result(.BoolVal(res), t_bool()))
                },
                // float × float
                (is_eval_float_type(lv.ty) && is_eval_float_type(rv.ty)) =>
                  eval_float_cmp(fval, lv, rv),
                true => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Boolean &&  (short-circuit: skip RHS when LHS is false)
            // -----------------------------------------------------------------
            (is_infix && (fval == "&&")) => {
              lhs_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rhs_expr := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              lv := match(recur(lhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              match(lv.value,
                .BoolVal(b) =>
                  cond(
                    (!(b)) => .Some(eval_result(.BoolVal(false), t_bool())),
                    true => {
                      rv := match(recur(rhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
                      match(rv.value,
                        .BoolVal(rb) => .Some(eval_result(.BoolVal(rb), t_bool())),
                        _ => Option(EvalResult).None
                      )
                    }
                  ),
                _ => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Boolean ||  (short-circuit: skip RHS when LHS is true)
            // -----------------------------------------------------------------
            (is_infix && (fval == "||")) => {
              lhs_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rhs_expr := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              lv := match(recur(lhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              match(lv.value,
                .BoolVal(b) =>
                  cond(
                    b => .Some(eval_result(.BoolVal(true), t_bool())),
                    true => {
                      rv := match(recur(rhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
                      match(rv.value,
                        .BoolVal(rb) => .Some(eval_result(.BoolVal(rb), t_bool())),
                        _ => Option(EvalResult).None
                      )
                    }
                  ),
                _ => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Unary ! — logical negation of bool
            // -----------------------------------------------------------------
            ((!(is_infix)) && ((fval == "!") && (args.len() == usize(1)))) => {
              expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              v := match(recur(expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              match(v.value,
                .BoolVal(b) => .Some(eval_result(.BoolVal(!(b)), t_bool())),
                _ => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Unary - — negation of comptime_int
            // -----------------------------------------------------------------
            ((!(is_infix)) && ((fval == "-") && (args.len() == usize(1)))) => {
              expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              v := match(recur(expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              cond(
                is_eval_int_type(v.ty) => {
                  v_ty := v.ty;
                  match(v.value,
                    .IntLit(raw) => {
                      a := match(parse_raw_int(raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                      .Some(eval_result(.IntLit((i64(0) - a).to_string()), v_ty))
                    },
                    _ => Option(EvalResult).None
                  )
                },
                is_eval_float_type(v.ty) => eval_float_neg(v),
                true => Option(EvalResult).None
              )
            },

            // ---------------------------------------------------------------
            // Dot operator: field access, method calls, and enum variant
            // construction (both TS-parser and self-hosted-parser AST forms).
            //
            // Field access / method call (is_infix=true, 2 args):
            //   FnCall(Atom(Dot), [receiver_expr, field_or_method_expr], true)
            //
            // Fieldless variant — TS format (is_infix=true, 1 Atom arg):
            //   FnCall(Atom(Dot), [Atom("None")], true)
            //
            // Variant with fields — self-hosted format (is_infix=false, 1 FnCall arg):
            //   FnCall(Atom(Dot), [FnCall(Atom("Some"), [arg1, …], false)], false)
            // ---------------------------------------------------------------
            (fval == ".") => 
              cond(
                // --- Field access or method call: is_infix=true, 2 args ---
                ((is_infix) && (args.len() == usize(2))) => {
                  recv_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  rhs := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  // Phase 3am: ArrayVal mutation pre-pass — handle arr.push(x) before evaluating receiver.
                  // We need the variable name from recv_expr to update the binding in-place.
                  push_res_pa := handle_array_push_mutation(recv_expr, rhs, env);
                  match(push_res_pa,
                    .Some(r_pa) => { return Option(EvalResult).Some(r_pa); },
                    .None => ()
                  );
                  recv_res := match(recur(recv_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  match(recv_res.value,
                    .StructVal(_, fnames, fvals) =>
                      match(rhs,
                        // Field access: receiver.field_name
                        .Atom(_, field_tok) => {
                          field_name := field_tok.value.as_str();
                          n_f := fnames.len();
                          (fi : usize) = usize(0);
                          (found_v : Option(EvalValue)) = Option(EvalValue).None;
                          (found_done : bool) = false;
                          while runtime(((fi < n_f) && (!(found_done)))), {
                            match(fnames.get(fi),
                              .Some(fn_s) => {
                                cond(
                                  (fn_s.as_str() == field_name) => {
                                    match(fvals.get(fi),
                                      .Some(fv) => {
                                        found_v = .Some(fv);
                                        found_done = true;
                                      },
                                      .None => ()
                                    );
                                  },
                                  true => ()
                                );
                              },
                              .None => ()
                            );
                            fi = (fi + usize(1));
                          };
                          match(found_v,
                            .Some(fv) => .Some(eval_result(fv, type_of_eval_value(fv))),
                            .None => Option(EvalResult).None
                          )
                        },
                        // Method call on struct: receiver.method(args)  — Phase 3j
                        // Delegated to handle_method_dispatch to keep evaluate's frame small.
                        .FnCall(_, method_func_box, method_call_args, _, _) =>
                          handle_method_dispatch(recv_res.value, method_func_box, method_call_args, env),
                        _ => Option(EvalResult).None
                      ),
                    // Phase 3al fix: method calls on non-StructVal receivers
                    // (TypeVal for static methods, StrLit/IntLit/etc. for instance shims).
                    // Dispatch to handle_method_dispatch which has shims for these types.
                    // Phase 3am: also handle val.* (PtrVal dereference) here.
                    _ =>
                      match(rhs,
                        // val.* — dereference a PtrVal (Phase 3am)
                        .Atom(_, deref_tok) =>
                          cond(
                            (deref_tok.value.as_str() == "*") =>
                              match(recv_res.value,
                                .PtrVal(inner_box, _) =>
                                  .Some(eval_result(inner_box.*, type_of_eval_value(inner_box.*))),
                                _ => Option(EvalResult).None
                              ),
                            true => Option(EvalResult).None
                          ),
                        .FnCall(_, method_func_box2, method_call_args2, _, _) =>
                          handle_method_dispatch(recv_res.value, method_func_box2, method_call_args2, env),
                        _ => Option(EvalResult).None
                      )
                  )
                },

                // --- Enum variant construction: 1 arg ---
                // Fieldless (Atom arg): both TS and self-hosted formats
                // With fields (FnCall arg): self-hosted format only
                (args.len() == usize(1)) => 
                  match(args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(vne) =>
                      match(vne,
                        // Fieldless: .None, .True, etc. — Atom arg
                        .Atom(_, vntok) => {
                          variant_str := `.${ vntok.value }`;
                          ev_fields := ArrayList(EvalValue).new();
                          .Some(eval_result(.EnumVal(variant_str, ev_fields), t_unit()))
                        },
                        // With fields — self-hosted format: .Some(42) etc.
                        // FnCall(Atom(Dot), [FnCall(Atom("Some"), [Atom("42")], false)], false)
                        .FnCall(_, vfunc, vargs, _, _) => {
                          vname := match(vfunc.*,
                            .Atom(_, vntok) => vntok.value.as_str(),
                            .FnCall(_, _, _, _, _) => { return Option(EvalResult).None; }
                          );
                          variant_str := `.${ String.from(vname) }`;
                          ev_fields := ArrayList(EvalValue).new();
                          n_vargs := vargs.len();
                          (vi : usize) = usize(0);
                          (vok : bool) = true;
                          while runtime(((vi < n_vargs) && vok)), {
                            match(vargs.get(vi),
                              .Some(varg_expr) =>
                                match(recur(varg_expr, env),
                                  .Some(vr) => { ev_fields.push(vr.value); },
                                  .None => { vok = false; }
                                ),
                              .None => { vok = false; }
                            );
                            vi = (vi + usize(1));
                          };
                          cond(
                            (!(vok)) => Option(EvalResult).None,
                            true => .Some(eval_result(.EnumVal(variant_str, ev_fields), t_unit()))
                          )
                        }
                      )
                  )
                ,

                true => Option(EvalResult).None
              )
            ,

            // ---------------------------------------------------------------
            // `match(scrutinee, arm1, …)` pattern matching
            // Each arm is FnCall(Atom("=>"), [pattern, body], is_infix=true)
            // ---------------------------------------------------------------
            (fval == "match") => 
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(scrutinee_expr) => 
                  match(recur(scrutinee_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(scrut_res) => {
                      n_arms := args.len();
                      (arm_i : usize) = usize(1);
                      (match_result : Option(EvalResult)) = Option(EvalResult).None;
                      (matched : bool) = false;
                      while runtime(((arm_i < n_arms) && (!(matched)))), {
                        match(args.get(arm_i),
                          .Some(arm_expr) =>
                            match(arm_expr,
                              // Each arm: FnCall(Atom("=>"), [pattern, body], _)
                              .FnCall(_, arrow_func, arm_sub, _, _) =>
                                match(arrow_func.*,
                                  .Atom(_, arrtok) =>
                                    cond(
                                      (!(arrtok.value.as_str() == "=>")) => (),
                                      true => {
                                        match(arm_sub.get(usize(0)),
                                          .None => (),
                                          .Some(pat_expr) => {
                                            env.push_frame(false);
                                            (did_match : bool) = try_match_pat(pat_expr, scrut_res.value, scrut_res.ty, env);
                                            cond(
                                              (!(did_match)) => { env.pop_frame(); },
                                              true => {
                                                match(arm_sub.get(usize(1)),
                                                  .None => {
                                                    env.pop_frame();
                                                  },
                                                  .Some(body_expr) => {
                                                    match(recur(body_expr, env),
                                                      .None => {
                                                        env.pop_frame();
                                                      },
                                                      .Some(body_res) => {
                                                        env.pop_frame();
                                                        match_result = .Some(body_res);
                                                        matched = true;
                                                      }
                                                    );
                                                  }
                                                );
                                              }
                                            );
                                          }
                                        );
                                      }
                                    ),
                                  .FnCall(_, _, _, _, _) => ()
                                ),
                              .Atom(_, _) => ()
                            ),
                          .None => ()
                        );
                        arm_i = (arm_i + usize(1));
                      };
                      match_result
                    }
                  )

              )
            ,

            // ---------------------------------------------------------------
            // `while condition, body`
            // Compile-time while loop: condition must fold to BoolVal.
            // `while runtime(true), body` handled: runtime(...) is unwrapped.
            // ---------------------------------------------------------------
            (fval == "while") => 
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(raw_cond) => 
                  match(args.get(usize(1)),
                    .None => Option(EvalResult).None,
                    .Some(body_expr) => {
                      // Unwrap `runtime(cond_inner)` wrapper if present
                      cond_expr := match(raw_cond,
                        .FnCall(_, rt_func, rt_args, _, _) =>
                          match(rt_func.*,
                            .Atom(_, rttok) =>
                              cond(
                                (rttok.value.as_str() == "runtime") =>
                                  match(rt_args.get(usize(0)),
                                    .Some(inner) => inner,
                                    .None => raw_cond
                                  ),
                                true => raw_cond
                              ),
                            .FnCall(_, _, _, _, _) => raw_cond
                          ),
                        .Atom(_, _) => raw_cond
                      );
                      (last : EvalResult) = eval_result(.UnitVal, t_unit());
                      (keep_going : bool) = true;
                      (iter_count : i64) = i64(0);
                      while runtime(keep_going), {
                        cond(
                          (iter_count >= i64(10000)) => { keep_going = false; },
                          true => {
                            match(recur(cond_expr, env),
                              .None => { keep_going = false; },
                              .Some(cv) =>
                                match(cv.value,
                                  .BoolVal(b) =>
                                    cond(
                                      (!(b)) => { keep_going = false; },
                                      true => {
                                        match(recur(body_expr, env),
                                          .None => { keep_going = false; },
                                          .Some(bv) => {
                                            last = bv;
                                            match(bv.value,
                                              .ReturnVal(_, _) => { keep_going = false; },
                                              .BreakVal        => { keep_going = false; },
                                              .ContinueVal     => (),
                                              _ => ()
                                            );
                                          }
                                        );
                                        iter_count = (iter_count + i64(1));
                                      }
                                    ),
                                  _ => { keep_going = false; }
                                )
                            );
                          }
                        );
                      };
                      .Some(match(last.value, .BreakVal => eval_result(.UnitVal, t_unit()), .ContinueVal => eval_result(.UnitVal, t_unit()), _ => last))
                    }
                  )

              )
            ,

            // -----------------------------------------------------------------
            // Type casts: i32(x), u64(x), usize(x), f32(x), bool(x), etc.
            // For numeric/bool literals, just retag the type; value unchanged.
            // Other values are passed through with the new type tag.
            // -----------------------------------------------------------------
            (((args.len() == usize(1)) && is_primitive_type_cast(fval))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(arg_expr) =>
                  match(recur(arg_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(arg_res) => {
                      cast_ty := type_from_name(fval);
                      .Some(eval_result(arg_res.value, cast_ty))
                    }
                  )
              ),

            // -----------------------------------------------------------------
            // return expr — emit a ReturnVal signal
            // -----------------------------------------------------------------
            (fval == "return") => 
              cond(
                (args.len() == usize(0)) =>
                  .Some(eval_result(.ReturnVal(box(.UnitVal), t_unit()), t_unit())),
                true =>
                  match(args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(ret_expr) =>
                      match(recur(ret_expr, env),
                        .None => Option(EvalResult).None,
                        .Some(ret_res) =>
                          .Some(eval_result(
                            .ReturnVal(box(ret_res.value), ret_res.ty),
                            t_unit()
                          ))
                      )
                  )
              )
            ,

            // -----------------------------------------------------------------
            // break — emit a BreakVal signal to stop the nearest while/for loop
            // -----------------------------------------------------------------
            (fval == "break") =>
              .Some(eval_result(.BreakVal, t_unit()))
            ,

            // -----------------------------------------------------------------
            // continue — emit a ContinueVal signal to skip rest of loop body
            // -----------------------------------------------------------------
            (fval == "continue") =>
              .Some(eval_result(.ContinueVal, t_unit()))
            ,

            // -----------------------------------------------------------------
            // for(item_pat, collection_expr, body_expr) — iterate over ArrayVal
            // -----------------------------------------------------------------
            (fval == "for") =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(item_pat) =>
                  match(args.get(usize(1)),
                    .None => Option(EvalResult).None,
                    .Some(col_expr) =>
                      match(args.get(usize(2)),
                        .None => Option(EvalResult).None,
                        .Some(body_expr) =>
                          match(recur(col_expr, env),
                            .None => Option(EvalResult).None,
                            .Some(col_res) =>
                              match(col_res.value,
                                .ArrayVal(elements) => {
                                  n_fe := elements.len();
                                  (fi : usize) = usize(0);
                                  (last_fe : EvalResult) = eval_result(.UnitVal, t_unit());
                                  (for_ok : bool) = true;
                                  while runtime(((fi < n_fe) && for_ok)), {
                                    match(elements.get(fi),
                                      .None => { for_ok = false; },
                                      .Some(elem_val) => {
                                        env.push_frame(false);
                                        match(item_pat,
                                          .Atom(_, item_tok) => {
                                            _fidx := env.define_val(item_tok.value, type_of_eval_value(elem_val), false, .Some(elem_val));
                                          },
                                          .FnCall(_, _, _, _, _) => ()
                                        );
                                        match(recur(body_expr, env),
                                          .None => { env.pop_frame(); for_ok = false; },
                                          .Some(body_res) => {
                                            env.pop_frame();
                                            last_fe = body_res;
                                            match(body_res.value,
                                              .ReturnVal(_, _) => { for_ok = false; },
                                              .BreakVal        => { for_ok = false; },
                                              .ContinueVal     => (),
                                              _ => ()
                                            );
                                          }
                                        );
                                      }
                                    );
                                    fi = (fi + usize(1));
                                  };
                                  .Some(match(last_fe.value, .BreakVal => eval_result(.UnitVal, t_unit()), .ContinueVal => eval_result(.UnitVal, t_unit()), _ => last_fe))
                                },
                                _ => Option(EvalResult).None
                              )
                          )
                      )
                  )
              )
            ,

            // -----------------------------------------------------------------
            // recur — tail/recursive call to the currently-executing FuncVal.
            // Looks up __recur_fn bound when the current function frame was opened.
            // Delegates to call_funcval_with_args for env setup + forall inference.
            // -----------------------------------------------------------------
            (fval == "recur") => 
              match(env.*.lookup(String.from("__recur_fn")),
                .None => Option(EvalResult).None,
                .Some(rfv) =>
                  match(rfv.value,
                    .None => Option(EvalResult).None,
                    .Some(func_val_r) =>
                      match(func_val_r,
                        .FuncVal(_, _, _, _, _, _, _, _, _) => {
                          evaled_r := ArrayList(EvalResult).new();
                          n_recur_args := args.len();
                          (ri : usize) = usize(0);
                          (rok : bool) = true;
                          while runtime(((ri < n_recur_args) && rok)), {
                            match(args.get(ri),
                              .Some(arg_expr) =>
                                match(recur(arg_expr, env),
                                  .Some(r) => { evaled_r.push(r); },
                                  .None    => { rok = false; }
                                ),
                              .None => { rok = false; }
                            );
                            ri = (ri + usize(1));
                          };
                          cond(
                            (!(rok)) => Option(EvalResult).None,
                            true => call_funcval_with_args(func_val_r, evaled_r)
                          )
                        },
                        _ => Option(EvalResult).None
                      )
                  )
              )
            ,

            // -----------------------------------------------------------------
            // :: constant declaration.
            // name :: expr  — simple binding.
            // { A, B } :: expr — destructuring binding (from Module or Struct).
            // -----------------------------------------------------------------
            (is_infix && (fval == "::")) =>
              cond(
                (args.len() < usize(2)) => Option(EvalResult).None,
                true =>
                  match(args.get(usize(0)),
                    .Some(lhs) =>
                      match(args.get(usize(1)),
                        .Some(rhs) =>
                          match(lhs,
                            // Simple: name :: rhs
                            .Atom(_, name_tok) =>
                              match(recur(rhs, env),
                                .Some(rhs_res) => {
                                  _idx := env.define_val(
                                    name_tok.value,
                                    rhs_res.ty,
                                    true,  // :: is always comptime
                                    .Some(rhs_res.value)
                                  );
                                  .Some(eval_result(.UnitVal, t_unit()))
                                },
                                .None => Option(EvalResult).None
                              ),
                            // Destructuring: { A, B, … } :: rhs (anon-struct LHS)
                            .FnCall(_, lhs_fb, lhs_args, _, _) =>
                              match(lhs_fb.*,
                                .Atom(_, lhs_tok) =>
                                  cond(
                                    (lhs_tok.value.as_str() == BK_ANON_STRUCT) =>
                                      match(recur(rhs, env),
                                        .Some(rhs_res) =>
                                          match(rhs_res.value,
                                            // Destructure a ModuleVal
                                            .ModuleVal(mnames, mvals) => {
                                              (di : usize) = usize(0);
                                              dn := lhs_args.len();
                                              (dok : bool) = true;
                                              while runtime(((di < dn) && dok)), {
                                                match(lhs_args.get(di),
                                                  .Some(name_expr) =>
                                                    match(name_expr,
                                                      .Atom(_, req_tok) => {
                                                        // Find the requested name in the module
                                                        (dj : usize) = usize(0);
                                                        dm := mnames.len();
                                                        (dfound : bool) = false;
                                                        while runtime(((dj < dm) && (!dfound))), {
                                                          match(mnames.get(dj),
                                                            .Some(mname) =>
                                                              cond(
                                                                (mname.as_str() == req_tok.value.as_str()) => {
                                                                  match(mvals.get(dj),
                                                                    .Some(mval) => {
                                                                      _didx := env.define_val(
                                                                        req_tok.value,
                                                                        type_of_eval_value(mval),
                                                                        true,
                                                                        .Some(mval)
                                                                      );
                                                                      dfound = true;
                                                                    },
                                                                    .None => { dok = false; }
                                                                  );
                                                                },
                                                                true => ()
                                                              ),
                                                            .None => ()
                                                          );
                                                          dj = (dj + usize(1));
                                                        };
                                                        cond(
                                                          (!dfound) => { dok = false; },
                                                          true => ()
                                                        );
                                                      },
                                                      .FnCall(_, _, _, _, _) => { dok = false; }
                                                    ),
                                                  .None => { dok = false; }
                                                );
                                                di = (di + usize(1));
                                              };
                                              cond(
                                                dok  => .Some(eval_result(.UnitVal, t_unit())),
                                                true => Option(EvalResult).None
                                              )
                                            },
                                            _ => Option(EvalResult).None
                                          ),
                                        .None => Option(EvalResult).None
                                      ),
                                    true => Option(EvalResult).None
                                  ),
                                .FnCall(_, _, _, _, _) => Option(EvalResult).None
                              )
                          ),
                        .None => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  )
              ),

            // -----------------------------------------------------------------
            // using(name) — Phase 3o
            // At a call site, `using(name)` passes the value of `name` from
            // the caller's env as evidence to the callee.
            // -----------------------------------------------------------------
            (fval == "using") => handle_using_call(args, env),

            // -----------------------------------------------------------------
            // import("path") — Phase 3m
            // Calls g_module_loader with the path string (stripped of quotes).
            // Returns the ModuleVal provided by the loader.
            // -----------------------------------------------------------------
            (fval == BK_IMPORT) =>
              match(args.get(usize(0)),
                .Some(path_expr) =>
                  match(path_expr,
                    .Atom(_, path_tok) => {
                      raw := path_tok.value.as_str();
                      rn  := raw.len();
                      cond(
                        (rn < usize(2)) => Option(EvalResult).None,
                        true => {
                          path_str := String.from(raw).substring(usize(1), (rn - usize(1)));
                          match(g_module_loader,
                            .None => Option(EvalResult).None,
                            .Some(loader) =>
                              match(loader(path_str),
                                .None => Option(EvalResult).None,
                                .Some(mod_val) =>
                                  .Some(eval_result(mod_val, t_unit()))
                              )
                          )
                        }
                      )
                    },
                    .FnCall(_, _, _, _, _) => Option(EvalResult).None
                  ),
                .None => Option(EvalResult).None
              ),

            // -----------------------------------------------------------------
            // open(module_expr) — Phase 3m
            // Evaluates its argument to a ModuleVal, then binds every exported
            // name into the current environment as a comptime constant.
            // -----------------------------------------------------------------
            (fval == BK_OPEN) =>
              match(args.get(usize(0)),
                .Some(mod_expr) =>
                  match(recur(mod_expr, env),
                    .Some(mod_res) =>
                      match(mod_res.value,
                        .ModuleVal(mnames, mvals) => {
                          (oi : usize) = usize(0);
                          on := mnames.len();
                          while runtime((oi < on)), {
                            match(mnames.get(oi),
                              .Some(mname) =>
                                match(mvals.get(oi),
                                  .Some(mval) => {
                                    _oidx := env.define_val(
                                      mname,
                                      type_of_eval_value(mval),
                                      true,
                                      .Some(mval)
                                    );
                                  },
                                  .None => ()
                                ),
                              .None => ()
                            );
                            oi = (oi + usize(1));
                          };
                          .Some(eval_result(.UnitVal, t_unit()))
                        },
                        _ => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  ),
                .None => Option(EvalResult).None
              ),

            // -----------------------------------------------------------------
            // General identifier: struct construction or FuncVal call.
            //
            // Struct construction (all args are named `:` infix calls):
            //   TypeName(field1: val1, field2: val2, …) → StructVal
            //
            // FuncVal call: look up identifier, check arity, run body.
            // Arity mismatch or unbound identifier → None.
            // -----------------------------------------------------------------

            // -----------------------------------------------------------------
            // Type definitions — Phase 3z
            // enum(...), struct(...), object(...), newtype(...), union(...), trait(...)
            // Each creates a TypeVal containing the appropriate TypeValue.
            // -----------------------------------------------------------------
            (fval == BK_ENUM)    => handle_enum_def(args, env),
            (fval == BK_STRUCT)  => handle_struct_def(args, false, false, env),
            (fval == BK_OBJECT)  => handle_struct_def(args, true, false, env),
            (fval == BK_NEWTYPE) => handle_struct_def(args, false, true, env),
            (fval == BK_UNION)   => handle_union_def(args, env),
            (fval == BK_TRAIT)   => handle_trait_def(args, env),

            // -----------------------------------------------------------------
            // `if(cond, then)` or `if(cond, then, else)` — conditional expr.
            // 2-arg: returns UnitVal when condition is false.
            // 3-arg: evaluates else branch when condition is false.
            // Returns None when the condition does not fold to a Bool.
            // -----------------------------------------------------------------
            (fval == "if") => handle_if_form(args, env),

            // -----------------------------------------------------------------
            // impl(TypeName, method_name : fn_def, …) — Phase 3j
            // Delegated to handle_impl_form to keep evaluate's frame small.
            // -----------------------------------------------------------------
            (fval == "impl") => handle_impl_form(args, env),

            // -----------------------------------------------------------------
            // Anonymous struct literal: _(field: val, …) or _(val, …)
            // Labeled fields keep their name; positional fields get "__field_N".
            // -----------------------------------------------------------------
            (fval == BK_ANON_STRUCT) => handle_anon_struct_form(args, env),

            // -----------------------------------------------------------------
            // Phase 5u: assert(cond, msg) — compile-time assertion check.
            // Evaluates cond; if truthy returns unit; if false returns None (error).
            // -----------------------------------------------------------------
            ((fval == "assert") && ((args.len() == usize(2)) || (args.len() == usize(1)))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(cond_expr) =>
                  match(recur(cond_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(cond_res) =>
                      match(cond_res.value,
                        .BoolVal(b) =>
                          cond(b => .Some(eval_result(.UnitVal, t_unit())), true => Option(EvalResult).None),
                        _ => .Some(eval_result(.UnitVal, t_unit()))
                      )
                  )
              )
            ,

            // -----------------------------------------------------------------
            // Phase 5u: comptime_assert(cond, msg) — same as assert for CTFE.
            // -----------------------------------------------------------------
            ((fval == "comptime_assert") && ((args.len() == usize(2)) || (args.len() == usize(1)))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(cond_expr) =>
                  match(recur(cond_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(cond_res) =>
                      match(cond_res.value,
                        .BoolVal(b) =>
                          cond(b => .Some(eval_result(.UnitVal, t_unit())), true => Option(EvalResult).None),
                        _ => .Some(eval_result(.UnitVal, t_unit()))
                      )
                  )
              )
            ,

            // -----------------------------------------------------------------
            // Phase 3am: box(expr) — heap-boxing. At compile time, wraps the
            // value in PtrVal so that `box(x).*` round-trips correctly.
            // -----------------------------------------------------------------
            ((fval == "box") && (args.len() == usize(1))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(box_arg) =>
                  match(recur(box_arg, env),
                    .None => Option(EvalResult).None,
                    .Some(box_res) =>
                      .Some(eval_result(.PtrVal(box(box_res.value), usize(0)), box_res.ty))
                  )
              ),

            // -----------------------------------------------------------------
            // Phase 3am: ArrayList(T) type constructor — returns a TypeVal
            // placeholder so that `ArrayList(T).new()` can dispatch correctly.
            // The type argument T is evaluated but ignored; only the shape
            // matters for the proto-evaluator's purpose.
            // -----------------------------------------------------------------
            (fval == "ArrayList") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),

            // -----------------------------------------------------------------
            // Phase 5w: runtime(expr) — unwrap runtime wrapper, just eval inner.
            // In the real compiler this prevents CTFE; for proto-eval, pass-through.
            // -----------------------------------------------------------------
            ((fval == "runtime") && (args.len() == usize(1))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(rt_arg) => recur(rt_arg, env)
              )
            ,

            // -----------------------------------------------------------------
            // Phase 5w: dyn(expr) — dynamic trait object creation.
            // For proto-eval, just evaluate the inner expression and pass through.
            // -----------------------------------------------------------------
            ((fval == "dyn") && (args.len() == usize(1))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(dyn_arg) => recur(dyn_arg, env)
              )
            ,

            // -----------------------------------------------------------------
            // Phase 5w: comptime(expr) — compile-time evaluation marker.
            // For proto-eval, just evaluate the inner expression.
            // -----------------------------------------------------------------
            ((fval == "comptime") && (args.len() == usize(1))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(ct_arg) => recur(ct_arg, env)
              )
            ,

            // -----------------------------------------------------------------
            // Phase 5w: Common type constructors — return TypeVal placeholder.
            // -----------------------------------------------------------------
            ((fval == "Option") && (args.len() == usize(1))) =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            ((fval == "Result") && (args.len() <= usize(2))) =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            ((fval == "Box") && (args.len() == usize(1))) =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            ((fval == "Pointer") && (args.len() == usize(1))) =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),

            // -----------------------------------------------------------------
            // Phase 5aa: Slice(T), Future(T, ...), Array(T, N) — type constructors.
            // -----------------------------------------------------------------
            (fval == "Slice") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            (fval == "Future") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            (fval == "Array") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            (fval == "IO") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            (fval == "Exception") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),

            // -----------------------------------------------------------------
            // Phase 5x: println/print — evaluate args but return unit.
            // In CTFE these are no-ops; we just ensure args are well-formed.
            // -----------------------------------------------------------------
            (fval == "println") => .Some(eval_result(.UnitVal, t_unit())),
            (fval == "print") => .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Phase 5x: String.from(str) — type constructor for String from str.
            // Returns the string value as a StrLit for the proto-evaluator.
            // -----------------------------------------------------------------
            (fval == "String") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),

            // -----------------------------------------------------------------
            // Phase 5y: extern / c_include — FFI declarations.
            // In the proto-evaluator these are no-ops (just return unit).
            // The real compiler uses them for C interop declarations.
            // -----------------------------------------------------------------
            (fval == "extern") => .Some(eval_result(.UnitVal, t_unit())),
            (fval == "c_include") => .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Phase 5y: where(constraint) — trait bound declarations.
            // No-op for proto-eval; the real compiler uses these for type checking.
            // -----------------------------------------------------------------
            (fval == "where") => .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Phase 5y: forall(T : Type, ...) — type parameter declarations.
            // For proto-eval: evaluate the inner (binding exprs) and return unit.
            // The real evaluator creates type variables; we skip that.
            // -----------------------------------------------------------------
            (fval == "forall") => .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Phase 5y: type_of(expr) — return the type as a TypeVal.
            // Evaluates the expression, extracts its type, wraps as TypeVal.
            // -----------------------------------------------------------------
            ((fval == "type_of") && (args.len() == usize(1))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(typeof_arg) =>
                  match(recur(typeof_arg, env),
                    .None => Option(EvalResult).None,
                    .Some(typeof_res) =>
                      .Some(eval_result(.TypeVal(box(typeof_res.ty)), t_type()))
                  )
              ),

            // -----------------------------------------------------------------
            // Phase 5y: size_of(Type) / align_of(Type) — return placeholder int.
            // Real compiler computes actual sizes; proto-eval returns 8 (pointer size).
            // -----------------------------------------------------------------
            ((fval == "size_of") && (args.len() == usize(1))) =>
              .Some(eval_result(.IntLit(String.from("8")), t_comptime_int())),
            ((fval == "align_of") && (args.len() == usize(1))) =>
              .Some(eval_result(.IntLit(String.from("8")), t_comptime_int())),

            // -----------------------------------------------------------------
            // Phase 5y: HashMap(K, V) — type constructor placeholder.
            // -----------------------------------------------------------------
            ((fval == "HashMap") && (args.len() == usize(2))) =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),

            // -----------------------------------------------------------------
            // Phase 5y: unreachable / panic / todo — control-flow builtins.
            // In proto-eval these just return unit (we can't actually abort).
            // -----------------------------------------------------------------
            (fval == "unreachable") => .Some(eval_result(.UnitVal, t_unit())),
            (fval == "panic") => .Some(eval_result(.UnitVal, t_unit())),
            (fval == "todo") => .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Phase 5z: Impl(T) / Fn / FnMut / FnOnce — closure type constructors.
            // Returns TypeVal placeholder.
            // -----------------------------------------------------------------
            (fval == "Impl") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            (fval == "Fn") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            (fval == "FnMut") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),
            (fval == "FnOnce") =>
              .Some(eval_result(.TypeVal(box(t_type())), t_type())),

            // -----------------------------------------------------------------
            // Phase 5z: comptime_expect_error(expr) — test helper.
            // Tries to evaluate the argument; if it returns None (error) → pass.
            // If it succeeds → we return unit anyway (proto-eval can't distinguish).
            // -----------------------------------------------------------------
            (fval == "comptime_expect_error") =>
              .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Phase 5z: derive(Trait1, Trait2, ...) — derive declarations.
            // No-op in proto-eval; the real compiler generates method impls.
            // -----------------------------------------------------------------
            (fval == "derive") => .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Phase 5z: export(expr) — evaluate inner and return it.
            // The real compiler marks the binding as exported.
            // -----------------------------------------------------------------
            ((fval == BK_EXPORT) && (args.len() == usize(1))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(export_arg) => recur(export_arg, env)
              ),

            // -----------------------------------------------------------------
            // Array literal: [e1, e2, ...] — parsed as array(e1, e2, ...)
            // Evaluates all elements and produces an ArrayVal.
            // -----------------------------------------------------------------
            (fval == BK_ARRAY_VAL) => {
              arr_elems := ArrayList(EvalValue).new();
              n_ae := args.len();
              (ae_i : usize) = usize(0);
              (ae_ok : bool) = true;
              while runtime(((ae_i < n_ae) && ae_ok)), {
                match(args.get(ae_i),
                  .Some(ae_expr) =>
                    match(recur(ae_expr, env),
                      .Some(ae_res) => { arr_elems.push(ae_res.value); },
                      .None => { ae_ok = false; }
                    ),
                  .None => { ae_ok = false; }
                );
                ae_i = (ae_i + usize(1));
              };
              cond(
                (!(ae_ok)) => Option(EvalResult).None,
                true => .Some(eval_result(.ArrayVal(arr_elems), t_unit()))
              )
            },

            // -----------------------------------------------------------------
            // Closure/lambda: (params) => body  or  param => body
            // Creates a FuncVal capturing the current environment.
            // Proto-evaluator simplified: no type checking, just captures env.
            // -----------------------------------------------------------------
            (is_infix && (fval == "=>")) =>
              cond(
                (args.len() != usize(2)) => Option(EvalResult).None,
                true => {
                  param_expr_opt := args.get(usize(0));
                  body_expr_opt  := args.get(usize(1));
                  match(param_expr_opt,
                    .None => Option(EvalResult).None,
                    .Some(param_expr) => match(body_expr_opt,
                      .None => Option(EvalResult).None,
                      .Some(body_expr) => {
                        // Extract parameter names from LHS
                        // Single param: Atom("x")
                        // Multiple: FnCall(Atom("tuple"), [Atom("x"), Atom("y"), ...], false)
                        params_f := ArrayList(String).new();
                        param_type_names_f := ArrayList(String).new();
                        match(param_expr,
                          .Atom(_, ptok) => {
                            params_f.push(ptok.value);
                            param_type_names_f.push(String.from("_"));
                          },
                          .FnCall(_, pf, pargs, _, _) =>
                            match(pf.*,
                              .Atom(_, pftok) =>
                                cond(
                                  (pftok.value.as_str() == BK_TUPLE) => {
                                    // (x, y, z) — multiple params
                                    (pi : usize) = usize(0);
                                    pn := pargs.len();
                                    while runtime((pi < pn)), {
                                      match(pargs.get(pi),
                                        .Some(pe) =>
                                          match(pe,
                                            .Atom(_, petok) => {
                                              params_f.push(petok.value);
                                              param_type_names_f.push(String.from("_"));
                                            },
                                            .FnCall(_, pe_f, pe_args, pe_infix, _) =>
                                              cond(
                                                // (x : T) — typed param
                                                (pe_infix && match(pe_f.*, .Atom(_, ct) => (ct.value.as_str() == ":"), .FnCall(_, _, _, _, _) => false)) =>
                                                  match(pe_args.get(usize(0)),
                                                    .Some(name_e) => match(name_e,
                                                      .Atom(_, nt) => {
                                                        params_f.push(nt.value);
                                                        param_type_names_f.push(String.from("_"));
                                                      },
                                                      .FnCall(_, _, _, _, _) => ()
                                                    ),
                                                    .None => ()
                                                  ),
                                                // using(x : T) — effect param (treat as regular for now)
                                                true =>
                                                  match(pe_args.get(usize(0)),
                                                    .Some(name_e) => match(name_e,
                                                      .Atom(_, nt) => {
                                                        params_f.push(nt.value);
                                                        param_type_names_f.push(String.from("_"));
                                                      },
                                                      .FnCall(_, _, _, _, _) => ()
                                                    ),
                                                    .None => ()
                                                  )
                                              )
                                          ),
                                        .None => ()
                                      );
                                      pi = (pi + usize(1));
                                    };
                                  },
                                  // (x : T) — single typed param in parens
                                  (pftok.value.as_str() == ":") =>
                                    match(pargs.get(usize(0)),
                                      .Some(name_e) => match(name_e,
                                        .Atom(_, nt) => {
                                          params_f.push(nt.value);
                                          param_type_names_f.push(String.from("_"));
                                        },
                                        .FnCall(_, _, _, _, _) => ()
                                      ),
                                      .None => ()
                                    ),
                                  true => ()
                                ),
                              .FnCall(_, _, _, _, _) => ()
                            )
                        );
                        // Capture current environment (all frames)
                        cap_names_f := ArrayList(String).new();
                        cap_tys_f   := ArrayList(TypeValue).new();
                        cap_vals_f  := ArrayList(EvalValue).new();
                        n_frames := env.*.frames.len();
                        (cfi : usize) = usize(0);
                        while runtime((cfi < n_frames)), {
                          match(env.*.frames.get(cfi),
                            .Some(frame) => {
                              n_cv := frame.variables.len();
                              (cvi : usize) = usize(0);
                              while runtime((cvi < n_cv)), {
                                match(frame.variables.get(cvi),
                                  .Some(v) => {
                                    cap_names_f.push(v.name);
                                    cap_tys_f.push(v.ty);
                                    cap_val_f := match(v.value,
                                      .Some(actual) => actual,
                                      .None => EvalValue.VarRef(v.name)
                                    );
                                    cap_vals_f.push(cap_val_f);
                                  },
                                  .None => ()
                                );
                                cvi = (cvi + usize(1));
                              };
                            },
                            .None => ()
                          );
                          cfi = (cfi + usize(1));
                        };
                        .Some(eval_result(
                          .FuncVal(
                            ArrayList(String).new(),
                            params_f,
                            param_type_names_f,
                            ArrayList(String).new(),
                            box(body_expr),
                            cap_names_f,
                            cap_tys_f,
                            cap_vals_f,
                            random_id(String.from("lambda"))
                          ),
                          t_unit()
                        ))
                      }
                    )
                  )
                }
              ),

            // -----------------------------------------------------------------
            // Phase 5v: FnMut closure: (params) =>> body
            // Identical to => for the proto-evaluator (difference is type-level).
            // -----------------------------------------------------------------
            (is_infix && (fval == "=>>")) =>
              cond(
                (args.len() != usize(2)) => Option(EvalResult).None,
                true => {
                  p_opt := args.get(usize(0));
                  b_opt := args.get(usize(1));
                  match(p_opt,
                    .None => Option(EvalResult).None,
                    .Some(p_expr) => match(b_opt,
                      .None => Option(EvalResult).None,
                      .Some(b_expr) => {
                        params_m := ArrayList(String).new();
                        ptnames_m := ArrayList(String).new();
                        match(p_expr,
                          .Atom(_, ptk) => {
                            params_m.push(ptk.value);
                            ptnames_m.push(String.from(""));
                          },
                          .FnCall(_, pfb, pfa, _, _) =>
                            match(pfb.*,
                              .Atom(_, pft) =>
                                cond(
                                  (pft.value.as_str() == BK_TUPLE) => {
                                    np := pfa.len();
                                    (pi : usize) = usize(0);
                                    while runtime((pi < np)), {
                                      match(pfa.get(pi),
                                        .Some(pe) =>
                                          match(pe,
                                            .Atom(_, pet) => {
                                              params_m.push(pet.value);
                                              ptnames_m.push(String.from(""));
                                            },
                                            .FnCall(_, cff, cfa, _, _) =>
                                              match(cff.*,
                                                .Atom(_, cft) =>
                                                  cond(
                                                    (cft.value.as_str() == ":") =>
                                                      match(cfa.get(usize(0)),
                                                        .Some(cfe) =>
                                                          match(cfe,
                                                            .Atom(_, cpn) => {
                                                              params_m.push(cpn.value);
                                                              ptnames_m.push(String.from(""));
                                                            },
                                                            .FnCall(_, _, _, _, _) => ()
                                                          ),
                                                        .None => ()
                                                      ),
                                                    true => ()
                                                  ),
                                                .FnCall(_, _, _, _, _) => ()
                                              )
                                          ),
                                        .None => ()
                                      );
                                      pi = (pi + usize(1));
                                    };
                                  },
                                  true => {
                                    params_m.push(pft.value);
                                    ptnames_m.push(String.from(""));
                                  }
                                ),
                              .FnCall(_, _, _, _, _) => ()
                            )
                        );
                        // Capture environment
                        cn_m := ArrayList(String).new();
                        ct_m := ArrayList(TypeValue).new();
                        cv_m := ArrayList(EvalValue).new();
                        nf_m := env.*.frames.len();
                        (fi_m : usize) = usize(0);
                        while runtime((fi_m < nf_m)), {
                          match(env.*.frames.get(fi_m),
                            .Some(frame_m) => {
                              nv_m := frame_m.variables.len();
                              (vi_m : usize) = usize(0);
                              while runtime((vi_m < nv_m)), {
                                match(frame_m.variables.get(vi_m),
                                  .Some(v_m) => {
                                    cn_m.push(v_m.name);
                                    ct_m.push(v_m.ty);
                                    cv_m.push(match(v_m.value, .Some(a) => a, .None => EvalValue.VarRef(v_m.name)));
                                  },
                                  .None => ()
                                );
                                vi_m = (vi_m + usize(1));
                              };
                            },
                            .None => ()
                          );
                          fi_m = (fi_m + usize(1));
                        };
                        .Some(eval_result(
                          .FuncVal(
                            ArrayList(String).new(),
                            params_m,
                            ptnames_m,
                            ArrayList(String).new(),
                            box(b_expr),
                            cn_m,
                            ct_m,
                            cv_m,
                            random_id(String.from("lambda_mut"))
                          ),
                          t_unit()
                        ))
                      }
                    )
                  )
                }
              ),

            // -----------------------------------------------------------------
            // Phase 5v: Logical NOT: !(expr) → evaluates to !bool
            // -----------------------------------------------------------------
            ((fval == "!") && (args.len() == usize(1))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(not_arg) =>
                  match(recur(not_arg, env),
                    .None => Option(EvalResult).None,
                    .Some(not_res) =>
                      match(not_res.value,
                        .BoolVal(b) => .Some(eval_result(.BoolVal(!(b)), t_bool())),
                        _ => Option(EvalResult).None
                      )
                  )
              )
            ,

            // -----------------------------------------------------------------
            // Phase 5v: Unary negation: -(expr) → negate integer
            // (Only handles prefix `-` as a function call with 1 arg)
            // -----------------------------------------------------------------
            ((fval == "-") && (args.len() == usize(1))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(neg_arg) =>
                  match(recur(neg_arg, env),
                    .None => Option(EvalResult).None,
                    .Some(neg_res) =>
                      match(neg_res.value,
                        .IntLit(raw) => {
                          neg_str := String.from("-").concat(raw);
                          .Some(eval_result(.IntLit(neg_str), t_comptime_int()))
                        },
                        .FloatLit(raw) => {
                          neg_str := String.from("-").concat(raw);
                          .Some(eval_result(.FloatLit(neg_str), t_comptime_float()))
                        },
                        _ => Option(EvalResult).None
                      )
                  )
              )
            ,

            // -----------------------------------------------------------------
            // General identifier: struct constructor or FuncVal call.
            // Detect struct construction: first arg is a `:` infix call (named field)
            true => {
              is_struct_ctor := match(args.get(usize(0)),
                .Some(a0) =>
                  match(a0,
                    .FnCall(_, a0f, _, a0infix, _) =>
                      cond(
                        a0infix =>
                          match(a0f.*,
                            .Atom(_, a0tok) => (a0tok.value.as_str() == ":"),
                            .FnCall(_, _, _, _, _) => false
                          ),
                        true => false
                      ),
                    .Atom(_, _) => false
                  ),
                .None => false
              );
              cond(
                is_struct_ctor => {
                  fn_list := ArrayList(String).new();
                  fv_list := ArrayList(EvalValue).new();
                  n_named := args.len();
                  (si : usize) = usize(0);
                  (sok : bool) = true;
                  while runtime(((si < n_named) && sok)), {
                    match(args.get(si),
                      .Some(arg_e) =>
                        match(arg_e,
                          .FnCall(_, _, na, _, _) =>
                            match(na.get(usize(0)),
                              .Some(ne) =>
                                match(ne,
                                  .Atom(_, ntok) =>
                                    match(na.get(usize(1)),
                                      .Some(ve) =>
                                        match(recur(ve, env),
                                          .Some(vr) => {
                                            fn_list.push(ntok.value);
                                            fv_list.push(vr.value);
                                          },
                                          .None => { sok = false; }
                                        ),
                                      .None => { sok = false; }
                                    ),
                                  .FnCall(_, _, _, _, _) => { sok = false; }
                                ),
                              .None => { sok = false; }
                            ),
                          .Atom(_, _) => { sok = false; }
                        ),
                      .None => { sok = false; }
                    );
                    si = (si + usize(1));
                  };
                  cond(
                    (!(sok)) => Option(EvalResult).None,
                    true => .Some(eval_result(.StructVal(String.from(fval), fn_list, fv_list), t_unit()))
                  )
                },
                true => 
                  match(env.*.lookup(String.from(fval)),
                .None => Option(EvalResult).None,
                .Some(var) =>
                  match(var.value,
                    .None => Option(EvalResult).None,
                    .Some(func_val) =>
                      match(func_val,
                        .FuncVal(_, _, _, _, _, _, _, _, _) => {
                          evaled_g := ArrayList(EvalResult).new();
                          n_gargs := args.len();
                          (gi : usize) = usize(0);
                          (gok : bool) = true;
                          while runtime(((gi < n_gargs) && gok)), {
                            match(args.get(gi),
                              .Some(arg_expr) =>
                                match(recur(arg_expr, env),
                                  .Some(r) => { evaled_g.push(r); },
                                  .None    => { gok = false; }
                                ),
                              .None => { gok = false; }
                            );
                            gi = (gi + usize(1));
                          };
                          cond(
                            (!(gok)) => Option(EvalResult).None,
                            true => call_funcval_with_args(func_val, evaled_g)
                          )
                        },
                        _ => Option(EvalResult).None
                      )
                  )
              )

              )
            }
          )
        }
      )
  )
);

// Initialize the g_eval_fn slot with the evaluate function (Phase 3j).
// Must run after evaluate is defined so the reference is valid.
// Returns bool to avoid 'void' C variable error from unit return type.
_eval_fn_init := (fn() -> bool)({
  g_eval_fn = .Some(evaluate);
  true
})();

/// Register a module loader callback for `import "path"` expressions (Phase 3m).
/// When set, `import "path"` will call `loader(path)` and return the result.
/// Call this before evaluating any module that uses imports.
/// Typically called once at program startup (or in tests for mocking).
set_module_loader :: (fn(loader : (fn(path : String) -> Option(EvalValue))) -> unit)({
  g_module_loader = .Some(loader);
});

export evaluate, eval_atom, eval_identifier, parse_raw_int, evaluate_module_body, set_module_loader;
