                            true => {
                              inner_sw := raw_sw.substring(usize(1), n_sw - usize(1));
                              pfx_inner := pfx_raw.substring(usize(1), n_pfx - usize(1));
                              return(Option(EvalResult).Some(eval_result(.BoolVal(inner_sw.starts_with(pfx_inner)), t_bool())));
