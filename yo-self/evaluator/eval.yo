//! Core evaluator dispatch — Phase 3a + 3b + 3c + 3d + 3e + 3f + 3g + 3h + 3i + 3j + 3n + 3aj + 3ak + 3al + 3am + 3an + 3ao + 3ap + 3aq.
//!
//! `evaluate` is the main entry point. It handles:
//!   - Literal atoms  (Bool, Integer, Float, StringLit, TemplateString, CharLit)
//!   - Identifier atoms (returns stored compile-time value when available,
//!     otherwise a `VarRef` carrying the variable's type)
//!   - Unit expression `()`
//!   - Begin blocks `{ stmts… }` (stops propagation on ReturnVal or BreakVal)
//!   - `cond(cond1 => body1, …)` conditional expressions
//!   - `if(cond, then)` / `if(cond, then, else)` conditional expressions
//!   - Variable define `name := expr`, typed `(name : T) := expr`, constant `name :: expr`
//!   - Variable assign `name = expr` and typed declaration `(name : T) = expr`
//!   - Arithmetic operators `+`, `-`, `*`, `/`, `%` (comptime_int, float, and StrLit concat)
//!   - Comparison operators `==`, `!=`, `<`, `>`, `<=`, `>=` (int, bool, str, float)
//!   - Boolean operators `&&`, `||` (short-circuit), unary `!`
//!   - Unary negation `-` (int and float)
//!   - Enum variant construction `.Variant(args…)` and fieldless `.Variant`
//!   - `match(scrutinee, arm1, …)` pattern matching on compile-time enum values
//!   - `while condition, body` compile-time while loops (condition must fold to bool)
//!   - `break` — emits BreakVal to terminate the enclosing while/for loop
//!   - `for(item, collection, body)` — iterates over ArrayVal, binds item per iteration
//!   - Array literals `[e1, e2, …]` → ArrayVal
//!   - Function definition `(fn(params) -> RetType)(body)` → FuncVal with closure capture;
//!     `comptime(Name)` parameter annotations are supported
//!   - Function calls `name(args…)` where `name` is bound to a FuncVal
//!   - `return expr` — emits a ReturnVal signal propagated to the call boundary
//!   - `recur(args…)` — recursive call to the currently-executing function
//!   - `name :: expr` — compile-time constant declaration
//!   - Type casts: `i32(x)`, `u64(x)`, `usize(x)`, `f64(x)`, `bool(x)`, etc.
//!   - Struct construction `TypeName(field: val, …)` → StructVal
//!   - Field access `struct_val.field_name` → field value
//!   - Method dispatch `struct_val.method(args…)` via `TypeName.method` lookup
//!   - `impl(TypeName, method: fn_def, …)` — registers methods in the environment
//!   - Phase 3ai: primitive `.to_string()` and StrLit `.(+)(rhs)` string concat
//!   - Phase 3aj: `String` identifier → TypeVal; `String.from(s)`, `String.new()` static shims;
//!                StrLit `+` StrLit infix concatenation; higher-order functions; closures
//!   - Phase 3ak: `StrLit.as_str()` passthrough; `StrLit.len()` → IntLit char count
//!   - Phase 3al: `StrLit.starts_with()`, `StrLit.ends_with()`, `StrLit.contains()` predicates;
//!                Fixed bug: method dispatch now invoked for all receiver types (not just StructVal)
//!   - Phase 3aq: struct field mutation `s.field = rhs` — `handle_struct_field_mutation` helper;
//!                `=` assignment handler extended to detect dot-infix LHS expressions
//!
//! Phase 3j adds `impl(...)` support and struct method dispatch. To keep
//! evaluate's C stack frame small (avoiding stack overflows during deep
//! recursion), heavy logic is factored into helper functions that use the
//! `g_eval_fn` module-level pointer (initialized by `_eval_fn_init` after
//! evaluate is defined) to call evaluate without a forward reference:
//!   - `call_funcval_with_args` — handles FuncVal invocation with pre-evaled args
//!   - `handle_method_dispatch` — resolves and calls a struct method
//!   - `handle_impl_form` — registers impl method bindings in the environment
//!   - `handle_struct_field_mutation` — handles `s.field = rhs` struct mutation (Phase 3aq)
//!
//! All recursive sub-evaluations call `recur` (which is `evaluate` itself).
//!
//! All other expression forms return `None`; they are covered by later phases.
//!
//! NOTE: `recur` binds `__recur_fn` in each call frame so nested recursive
//! calls work correctly.

open import "std/string";
open import "std/fmt";
{ ArrayList } :: import "std/collections/array_list";
{ atof } :: import "std/libc/stdlib";

{ TokenKind, Token } :: import "../lexer/token.yo";
{ AstExpr, BK_BEGIN, BK_TUPLE, BK_ANON_STRUCT, BK_IMPORT, BK_EXPORT, BK_OPEN,
  BK_ENUM, BK_STRUCT, BK_OBJECT, BK_NEWTYPE, BK_UNION, BK_TRAIT, BK_ARRAY_VAL } :: import "../expr/expr.yo";
{ TypeValue, type_value_tag,
  t_unit, t_bool, t_void,
  t_i8, t_i16, t_i32, t_i64,
  t_u8, t_u16, t_u32, t_u64,
  t_f32, t_f64,
  t_usize, t_isize,
  t_comptime_int, t_comptime_float, t_comptime_string,
  t_type, t_expr_t }
  :: import "../types/type.yo";
{ TypeTag } :: import "../types/tags.yo";
{ Environment } :: import "../env/env.yo";
{ EvalValue, EvalResult, eval_result,
  is_unit_val, is_bool_val, is_int_lit, is_float_lit, is_str_lit, is_var_ref,
  is_enum_val, is_func_val, is_return_val, is_break_val, is_type_val, is_struct_val, is_module_val,
  is_tuple_val, is_array_val, is_slice_val, is_ptr_val, is_trait_val,
  is_comptime_list_val, is_expr_val,
  value_to_string } :: import "./value.yo";
{ random_id } :: import "./utils.yo";

// ---------------------------------------------------------------------------
// Module-level function pointer slot for evaluate (Phase 3j)
// Filled in by _eval_fn_init after evaluate is defined so call_funcval_with_args
// can invoke evaluate without a forward reference.
// ---------------------------------------------------------------------------
(g_eval_fn : Option((fn(e : AstExpr, env : *(Environment)) -> Option(EvalResult)))) = .None;

// ---------------------------------------------------------------------------
// Module loader callback slot (Phase 3m).
// When set, `import "path"` looks up the path via this callback and returns
// the resulting `ModuleVal`.  Tests register a mock loader; the CLI phase
// will provide the real file-based loader.
// ---------------------------------------------------------------------------
(g_module_loader : Option((fn(path : String) -> Option(EvalValue)))) = .None;

// ---------------------------------------------------------------------------
// Helpers (must precede evaluate — no back-references to evaluate)
// ---------------------------------------------------------------------------

/// Map a known primitive type name (e.g. `"i32"`, `"usize"`) to its TypeValue.
/// Returns `t_unit()` for unrecognized names.
type_from_name :: (fn(name : str) -> TypeValue)(
  cond(
    (name == "i8")    => t_i8(),
    (name == "i16")   => t_i16(),
    (name == "i32")   => t_i32(),
    (name == "i64")   => t_i64(),
    (name == "u8")    => t_u8(),
    (name == "u16")   => t_u16(),
    (name == "u32")   => t_u32(),
    (name == "u64")   => t_u64(),
    (name == "usize") => t_usize(),
    (name == "isize") => t_isize(),
    (name == "f32")   => t_f32(),
    (name == "f64")   => t_f64(),
    (name == "bool")  => t_bool(),
    true              => t_unit()
  )
);

/// Like `type_from_name` but returns `Option(TypeValue)` — used in the
/// identifier lookup fallback so we can distinguish "unknown type name" from
/// "known type name" without returning the sentinel `t_unit()`.
type_from_name_opt :: (fn(name : str) -> Option(TypeValue))(
  cond(
    (name == "i8")    => .Some(t_i8()),
    (name == "i16")   => .Some(t_i16()),
    (name == "i32")   => .Some(t_i32()),
    (name == "i64")   => .Some(t_i64()),
    (name == "u8")    => .Some(t_u8()),
    (name == "u16")   => .Some(t_u16()),
    (name == "u32")   => .Some(t_u32()),
    (name == "u64")   => .Some(t_u64()),
    (name == "usize") => .Some(t_usize()),
    (name == "isize") => .Some(t_isize()),
    (name == "f32")   => .Some(t_f32()),
    (name == "f64")   => .Some(t_f64()),
    (name == "bool")  => .Some(t_bool()),
    (name == "unit")  => .Some(t_unit()),
    (name == "Type")   => .Some(t_type()),
    // Phase 3aj: String resolves to t_comptime_string() so `String.from(s)`
    // and `String.new()` can be dispatched as static method calls on TypeVal.
    (name == "String") => .Some(t_comptime_string()),
    true               => Option(TypeValue).None
  )
);

/// True when `name` is a recognized primitive type that can be used
/// as a cast/coercion call: `i32(x)`, `u64(y)`, `usize(n)`, etc.
is_primitive_type_cast :: (fn(name : str) -> bool)(
  cond(
    (name == "i8")    => true,
    (name == "i16")   => true,
    (name == "i32")   => true,
    (name == "i64")   => true,
    (name == "u8")    => true,
    (name == "u16")   => true,
    (name == "u32")   => true,
    (name == "u64")   => true,
    (name == "usize") => true,
    (name == "isize") => true,
    (name == "f32")   => true,
    (name == "f64")   => true,
    (name == "bool")  => true,
    true              => false
  )
);

/// True for any integer-like type the evaluator handles numerically.
/// Broader than `is_int_type` from type.yo because it includes ComptimeInt,
/// Usize, and Isize (which the type-system helper does not).
is_eval_int_type :: (fn(t : TypeValue) -> bool)(
  match(t,
    .Int(_, _)   => true,
    .Usize       => true,
    .Isize       => true,
    .ComptimeInt => true,
    _            => false
  )
);

is_eval_float_type :: (fn(t : TypeValue) -> bool)(
  match(t,
    .Float(_)      => true,
    .ComptimeFloat => true,
    _              => false
  )
);

/// True when the evaluated value should be treated as compile-time-only.
value_is_comptime :: (fn(v : EvalValue) -> bool)(
  match(v,
    .UnitVal       => true,
    .BoolVal(_)    => true,
    .IntLit(_)     => true,
    .FloatLit(_)   => true,
    .StrLit(_)     => true,
    .VarRef(_)     => false,
    .EnumVal(_, _) => true,
    .FuncVal(_, _, _, _, _, _, _, _, _) => true,
    .ReturnVal(_, _) => true,
    .BreakVal        => true,
    .ContinueVal     => true,
    .TypeVal(_)      => true,
    .ModuleVal(_, _) => true,
    // Phase 2h variants
    .TupleVal(_)           => true,
    .ArrayVal(_)           => true,
    .SliceVal(_, _, _)     => true,
    .PtrVal(_, _)          => true,
    .TraitVal(_, _, _)     => true,
    .ComptimeListVal(_)    => true,
    .ExprVal(_)            => true,
    // Phase 2u variants
    .UnknownVal(_)         => true,
    // Phase 3z variants
    .StructVal(_, _, _)    => true
  )
);

/// Extract a `TypeValue` from a simple type-annotation expression.
/// Recognises the same primitive names as `type_from_name` (`i32`, `bool`,
/// `usize`, `str`, etc.). Returns `t_unit()` for complex types like `Option(T)`.
eval_type_annotation_expr :: (fn(type_expr : AstExpr) -> TypeValue)(
  match(type_expr,
    .Atom(_, tok) => type_from_name(tok.value.as_str()),
    .FnCall(_, _, _, _, _) => t_unit()
  )
);

/// Look up an identifier in the environment. Returns the stored compile-time
/// value when available; otherwise a `VarRef` carrying the variable's type.
/// Returns `None` if the name is unbound.
eval_identifier :: (fn(tok : Token, env : *(Environment)) -> Option(EvalResult))({
  name := tok.value.as_str();
  // Special keywords that can appear as bare identifiers
  cond(
    (name == "break") => .Some(eval_result(.BreakVal, t_unit())),
    (name == "continue") => .Some(eval_result(.ContinueVal, t_unit())),
    true =>
      match((env.*).lookup(tok.value),
        .Some(var) =>
          match(var.value,
            .Some(v)  => .Some(eval_result(v, var.ty)),
            .None     => .Some(eval_result(.VarRef(tok.value), var.ty))
          ),
        .None =>
          // Not in env — check if the name is a known primitive type name.
          match(type_from_name_opt(tok.value.as_str()),
            .Some(ty) => .Some(eval_result(.TypeVal(box(ty)), t_type())),
            .None     => Option(EvalResult).None
          )
      )
  )
});

/// Evaluate a single-token `Atom` expression (does not recurse into evaluate).
eval_atom :: (fn(tok : Token, env : *(Environment)) -> Option(EvalResult))(
  cond(
    (tok.kind == TokenKind.Bool) => {
      b := (tok.value.as_str() == "true");
      .Some(eval_result(.BoolVal(b), t_bool()))
    },
    (tok.kind == TokenKind.Integer) =>
      .Some(eval_result(.IntLit(tok.value), t_comptime_int())),
    (tok.kind == TokenKind.Float) =>
      .Some(eval_result(.FloatLit(tok.value), t_comptime_float())),
    (tok.kind == TokenKind.StringLit) =>
      .Some(eval_result(.StrLit(tok.value), t_comptime_string())),
    (tok.kind == TokenKind.TemplateString) =>
      .Some(eval_result(.StrLit(tok.value), t_comptime_string())),
    (tok.kind == TokenKind.CharLit) =>
      .Some(eval_result(.IntLit(tok.value), t_u32())),
    (tok.kind == TokenKind.Identifier) =>
      eval_identifier(tok, env),
    true =>
      Option(EvalResult).None
  )
);

// ---------------------------------------------------------------------------
// Phase 3d helpers: type inference from value, pattern matching
// ---------------------------------------------------------------------------

/// Best-effort type inference from an `EvalValue`.
/// Returns a primitive type for known literals; falls back to `t_unit()` for
/// complex or runtime values (where the exact type is not tracked in the value).
type_of_eval_value :: (fn(v : EvalValue) -> TypeValue)(
  match(v,
    .UnitVal         => t_unit(),
    .BoolVal(_)      => t_bool(),
    .IntLit(_)       => t_comptime_int(),
    .FloatLit(_)     => t_comptime_float(),
    .StrLit(_)       => t_comptime_string(),
    .VarRef(_)       => t_unit(),
    .EnumVal(_, _)   => t_unit(),
    .FuncVal(_, _, _, _, _, _, _, _, _)   => t_unit(),
    .ReturnVal(_, _) => t_unit(),
    .BreakVal        => t_unit(),
    .ContinueVal     => t_unit(),
    .TypeVal(_)      => t_type(),
    .ModuleVal(_, _) => t_unit(),
    // Phase 2h variants
    .TupleVal(_)        => t_unit(),
    .ArrayVal(_)        => t_unit(),
    .SliceVal(_, _, _)  => t_unit(),
    .PtrVal(_, _)       => t_unit(),
    .TraitVal(_, _, _)  => t_unit(),
    .ComptimeListVal(_) => t_unit(),
    .ExprVal(_)         => t_expr_t(),
    // Phase 2u
    .UnknownVal(ty)     => ty.*,
    // Phase 3z
    .StructVal(_, _, _) => t_unit()
  )
);

/// Try to match `pattern` (an AstExpr from a match arm) against `scrutinee_val`,
/// adding variable bindings into `env`.  Returns `true` on success (and the env
/// has been updated with any new bindings), or `false` when the pattern does not
/// match the scrutinee.
///
/// Supported pattern forms:
///   - `_`            — wildcard, always matches, no bindings
///   - `ident`        — bare identifier (no dot), binds the whole scrutinee
///   - `.None`        — fieldless enum variant `FnCall(Atom(Dot), [Atom("None")], _)`
///   - `.Some(x, …)` — variant with positional bindings
try_match_pat :: (fn(pattern : AstExpr, scrutinee_val : EvalValue, scrutinee_ty : TypeValue, env : *(Environment)) -> bool)(
  match(pattern,
    // -----------------------------------------------------------------------
    // Atom patterns: wildcard `_` or bare variable binding
    // -----------------------------------------------------------------------
    .Atom(_, ptok) =>
      cond(
        (ptok.value.as_str() == "_") =>
          true,
        true => {
          // Bare identifier: bind whole scrutinee
          _idx := env.define_val(ptok.value, scrutinee_ty, true, .Some(scrutinee_val));
          true
        }
      ),

    // -----------------------------------------------------------------------
    // FnCall patterns
    // -----------------------------------------------------------------------
    .FnCall(_, pat_func, pat_args, _, _) =>
      match(pat_func.*,
        // Fieldless variant — TS format  : FnCall(Atom(Dot), [Atom("None")], infix=true)
        // Variant-with-args — self-hosted: FnCall(Atom(Dot), [FnCall(Atom("Some"), [x, …], false)], false)
        .Atom(_, dot_tok) =>
          cond(
            (dot_tok.kind != TokenKind.Dot) => false,
            true =>
              match(pat_args.get(usize(0)),
                .None => false,
                .Some(vne) =>
                  match(vne,
                    // Fieldless variant: .None, .True, etc.
                    .Atom(_, vntok) => {
                      full_v := `.${ vntok.value }`;
                      match(scrutinee_val,
                        .EnumVal(svar, _) => (svar.as_str() == full_v.as_str()),
                        _ => false
                      )
                    },
                    // Variant-with-args — self-hosted format: .Some(x, …)
                    .FnCall(_, sh_vfunc, sh_vargs, _, _) => {
                      sh_vname := match(sh_vfunc.*,
                        .Atom(_, sh_vntok) => sh_vntok.value.as_str(),
                        .FnCall(_, _, _, _, _) => { return false; }
                      );
                      sh_full_v := `.${ String.from(sh_vname) }`;
                      match(scrutinee_val,
                        .EnumVal(sh_svar, sh_sfields) =>
                          cond(
                            (!(sh_svar.as_str() == sh_full_v.as_str())) => false,
                            (sh_sfields.len() != sh_vargs.len()) => false,
                            true => {
                              n_sh := sh_vargs.len();
                              (i_sh : usize) = usize(0);
                              (ok_sh : bool) = true;
                              while runtime(((i_sh < n_sh) && ok_sh)), {
                                match(sh_sfields.get(i_sh),
                                  .Some(sh_fval) =>
                                    match(sh_vargs.get(i_sh),
                                      .Some(sh_bexpr) =>
                                        match(sh_bexpr,
                                          .Atom(_, sh_btok) =>
                                            cond(
                                              (sh_btok.value.as_str() == "_") => (),
                                              true => {
                                                sh_bty := type_of_eval_value(sh_fval);
                                                _sh_idx := env.define_val(sh_btok.value, sh_bty, true, .Some(sh_fval));
                                                ()
                                              }
                                            ),
                                          .FnCall(_, _, _, _, _) => { ok_sh = false; }
                                        ),
                                      .None => { ok_sh = false; }
                                    ),
                                  .None => { ok_sh = false; }
                                );
                                i_sh = (i_sh + usize(1));
                              };
                              ok_sh
                            }
                          ),
                        _ => false
                      )
                    }
                  )
              )
          ),

        // Variant-with-args: FnCall(FnCall(Atom(Dot), [Atom("Some")], _), [x, …], false)
        .FnCall(_, inner_dot_func, inner_dot_args, _, _) => {
          // Verify inner func is a dot
          (is_dot : bool) = match(inner_dot_func.*,
            .Atom(_, dt) => (dt.kind == TokenKind.Dot),
            .FnCall(_, _, _, _, _) => false
          );
          cond(
            (!(is_dot)) => false,
            true => {
              vname := match(inner_dot_args.get(usize(0)),
                .Some(vne) => match(vne,
                  .Atom(_, vntok) => vntok.value.as_str(),
                  .FnCall(_, _, _, _, _) => { return false; }
                ),
                .None => { return false; }
              );
              full_variant := `.${ String.from(vname) }`;
              match(scrutinee_val,
                .EnumVal(svar, sfields) =>
                  cond(
                    (!(svar.as_str() == full_variant.as_str())) => false,
                    (sfields.len() != pat_args.len()) => false,
                    true => {
                      n_bind := pat_args.len();
                      (i : usize) = usize(0);
                      (ok : bool) = true;
                      while runtime(((i < n_bind) && ok)), {
                        match(sfields.get(i),
                          .Some(field_val) =>
                            match(pat_args.get(i),
                              .Some(binding_expr) =>
                                match(binding_expr,
                                  .Atom(_, btok) =>
                                    cond(
                                      (btok.value.as_str() == "_") => (),
                                      true => {
                                        bty := type_of_eval_value(field_val);
                                        _idx := env.define_val(btok.value, bty, true, .Some(field_val));
                                        ()
                                      }
                                    ),
                                  .FnCall(_, _, _, _, _) => { ok = false; }
                                ),
                              .None => { ok = false; }
                            ),
                          .None => { ok = false; }
                        );
                        i = (i + usize(1));
                      };
                      ok
                    }
                  ),
                _ => false
              )
            }
          )
        }
      )
  )
);

// ---------------------------------------------------------------------------
// Integer parsing helpers (Phase 3c — comptime integer folding)
// ---------------------------------------------------------------------------

/// Get the numeric value of byte `b` as a digit in the given numeric base
/// (2, 8, 10, or 16). Returns `None` if `b` is not a valid digit for that base.
digit_value :: (fn(b : u8, base : i64) -> Option(i64))(
  cond(
    ((b >= u8(48)) && (b <= u8(57))) => {  // '0'-'9'
      d := (i64(b) - i64(48));
      cond((d < base) => .Some(d), true => .None)
    },
    ((b >= u8(97)) && (b <= u8(102))) => {  // 'a'-'f'
      d := (((i64(b) - i64(97)) + i64(10)));
      cond((d < base) => .Some(d), true => .None)
    },
    ((b >= u8(65)) && (b <= u8(70))) => {  // 'A'-'F'
      d := (((i64(b) - i64(65)) + i64(10)));
      cond((d < base) => .Some(d), true => .None)
    },
    true => .None
  )
);

/// Parse `bytes[start..]` as a non-negative integer in the given base.
/// Returns `None` if the slice is empty or contains an invalid digit.
parse_prefixed_int :: (fn(bytes : ArrayList(u8), start : usize, base : i64) -> Option(i64))({
  n := bytes.len();
  cond(
    (start >= n) => .None,
    true => {
      (result : i64) = i64(0);
      (i : usize) = start;
      (ok : bool) = true;
      while runtime(((i < n) && ok)), {
        match(bytes.get(i),
          .Some(b) =>
            match(digit_value(b, base),
              .Some(d) => { result = ((result * base) + d); },
              .None    => { ok = false; }
            ),
          .None => { ok = false; }
        );
        i = (i + usize(1));
      };
      cond(ok => .Some(result), true => .None)
    }
  )
});

/// Parse a raw integer token string to `i64`.
///
/// Handles:
/// - Decimal integers (default)
/// - Hex integers with `0x` / `0X` prefix
/// - Binary integers with `0b` / `0B` prefix
/// - Octal integers with `0o` / `0O` prefix
/// - Underscore separators (e.g. `1_000_000`)
///
/// Returns `None` if the raw string cannot be parsed.
parse_raw_int :: (fn(raw : String) -> Option(i64))({
  stripped := raw.replace_all(`_`, ``);
  cond(
    ((stripped.starts_with(`0x`)) || (stripped.starts_with(`0X`))) =>
      parse_prefixed_int(stripped.as_bytes(), usize(2), i64(16)),
    ((stripped.starts_with(`0b`)) || (stripped.starts_with(`0B`))) =>
      parse_prefixed_int(stripped.as_bytes(), usize(2), i64(2)),
    ((stripped.starts_with(`0o`)) || (stripped.starts_with(`0O`))) =>
      parse_prefixed_int(stripped.as_bytes(), usize(2), i64(8)),
    true => stripped.parse_i64()
  )
});

/// Parse a raw float string (e.g. `"3.14"`, `"1e-5"`) into an `f64`.
/// Uses `atof` from the C standard library.
/// Returns `None` if the string has no valid C-string representation.
parse_raw_float :: (fn(raw : String) -> Option(f64))({
  cs := raw.to_cstr();
  match(cs.ptr(),
    .Some(ptr) => .Some(atof(*(char)(ptr))),
    .None       => .None
  )
});

// ---------------------------------------------------------------------------
// Main evaluator — Phase 3b/3c/3d forms are inlined so `recur` can be used for
// recursive evaluation without forward-reference issues.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// FuncVal call helper — Phase 3j
// Factored out of `evaluate` so method dispatch (and any future call sites)
// can invoke it without bloating evaluate's C stack frame.
// Uses g_eval_fn which is set to evaluate by _eval_fn_init after evaluate
// is defined below.
// ---------------------------------------------------------------------------
call_funcval_with_args :: (fn(
  fv             : EvalValue,
  already_evaled : ArrayList(EvalResult)
) -> Option(EvalResult))(
  match(g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) =>
      match(fv,
        .FuncVal(forall_names_h, params, param_type_names_h, evidence_params_h, body, cap_names, cap_tys, cap_vals, _func_id_h) => {
          n_p  := params.len();
          n_ev := evidence_params_h.len();
          n_a  := already_evaled.len();
          cond(
            ((n_p + n_ev) != n_a) => Option(EvalResult).None,
            true => {
              fresh_fn_env := Environment.new(String.from(""));
              n_cap_h := cap_names.len();
              (chi : usize) = usize(0);
              while runtime((chi < n_cap_h)), {
                match(cap_names.get(chi),
                  .Some(cn) =>
                    match(cap_tys.get(chi),
                      .Some(ct) =>
                        match(cap_vals.get(chi),
                          .Some(cv) => {
                            _dch := cond(
                              (!(value_is_comptime(cv))) =>
                                (&fresh_fn_env).define_val(cn, ct, false, Option(EvalValue).None),
                              true =>
                                (&fresh_fn_env).define_val(cn, ct, true, .Some(cv))
                            );
                          },
                          .None => ()
                        ),
                      .None => ()
                    ),
                  .None => ()
                );
                chi = (chi + usize(1));
              };
              _ffr := (&fresh_fn_env).push_frame(false);
              _frr := (&fresh_fn_env).define_val(
                String.from("__recur_fn"), t_unit(), true, .Some(fv)
              );
              // Phase 3l: infer forall type params from argument types.
              // For each forall name F, scan param_type_names_h for a value param
              // annotated with F; use that argument's type to bind F = TypeVal(ty).
              n_forall_h := forall_names_h.len();
              (fa_i_h : usize) = usize(0);
              while runtime((fa_i_h < n_forall_h)), {
                match(forall_names_h.get(fa_i_h),
                  .Some(fa_name) => {
                    n_ptn_h := param_type_names_h.len();
                    (ptn_i_h : usize) = usize(0);
                    (fa_bound_h : bool) = false;
                    while runtime(((ptn_i_h < n_ptn_h) && (!(fa_bound_h)))), {
                      match(param_type_names_h.get(ptn_i_h),
                        .Some(ptn) => {
                          cond(
                            (ptn.as_str() == fa_name.as_str()) => {
                              match(already_evaled.get(ptn_i_h),
                                .Some(arg_res) => {
                                  _fa_bind := (&fresh_fn_env).define_val(
                                    fa_name,
                                    t_type(),
                                    true,
                                    .Some(EvalValue.TypeVal(box(arg_res.ty)))
                                  );
                                  fa_bound_h = true;
                                },
                                .None => ()
                              );
                            },
                            true => ()
                          );
                        },
                        .None => ()
                      );
                      ptn_i_h = (ptn_i_h + usize(1));
                    };
                  },
                  .None => ()
                );
                fa_i_h = (fa_i_h + usize(1));
              };
              (pi : usize) = usize(0);
              while runtime((pi < n_p)), {
                match(params.get(pi),
                  .Some(pname) =>
                    match(already_evaled.get(pi),
                      .Some(pval) => {
                        _dph := (&fresh_fn_env).define_val(
                          pname, pval.ty, value_is_comptime(pval.value), .Some(pval.value)
                        );
                      },
                      .None => ()
                    ),
                  .None => ()
                );
                pi = (pi + usize(1));
              };
              // Phase 3o: bind evidence params — args[n_p..n_p+n_ev]
              (evi : usize) = usize(0);
              while runtime((evi < n_ev)), {
                match(evidence_params_h.get(evi),
                  .Some(ev_pname) =>
                    match(already_evaled.get((n_p + evi)),
                      .Some(ev_pval) => {
                        _dev := (&fresh_fn_env).define_val(
                          ev_pname, ev_pval.ty, value_is_comptime(ev_pval.value), .Some(ev_pval.value)
                        );
                      },
                      .None => ()
                    ),
                  .None => ()
                );
                evi = (evi + usize(1));
              };
              body_rh := ef(body.*, &fresh_fn_env);
              match(body_rh,
                .None => Option(EvalResult).None,
                .Some(br) =>
                  match(br.value,
                    .ReturnVal(rv, rt) => .Some(eval_result(rv.*, rt)),
                    _ => .Some(br)
                  )
              )
            }
          )
        },
        _ => Option(EvalResult).None
      )
  )
);

// ---------------------------------------------------------------------------
// Phase 3am: ArrayVal mutation helper — handles arr.push(x) where arr is a
// bare identifier. Called BEFORE evaluating the receiver so we can look up
// and update the binding by name.
// Returns Some(UnitVal) on success, None if not applicable.
// ---------------------------------------------------------------------------
handle_array_push_mutation :: (fn(
  recv_expr        : AstExpr,
  rhs_expr         : AstExpr,
  env              : *(Environment)
) -> Option(EvalResult))(
  match(rhs_expr,
    .FnCall(_, mfunc_box_m, margs_m, _, _) =>
      match(mfunc_box_m.*,
        .Atom(_, mtok_m) =>
          cond(
            ((mtok_m.value.as_str() == "push") && (margs_m.len() == usize(1))) =>
              match(recv_expr,
                // Only handle bare identifier receivers: arr.push(x)
                .Atom(_, arr_tok_m) =>
                  match(env.*.lookup(arr_tok_m.value),
                    .None => Option(EvalResult).None,
                    .Some(var_m) =>
                      match(var_m.value,
                        .None => Option(EvalResult).None,
                        .Some(var_ev_m) =>
                          match(var_ev_m,
                            .ArrayVal(items_m) =>
                              match(margs_m.get(usize(0)),
                                .None => Option(EvalResult).None,
                                .Some(push_arg_expr) =>
                                  match(match(g_eval_fn,
                                      .Some(ef_p) => ef_p(push_arg_expr, env),
                                      .None => Option(EvalResult).None
                                    ),
                                    .None => Option(EvalResult).None,
                                    .Some(push_res) => {
                                      items_m.push(push_res.value);
                                      _ok_p := env.*.set_value(arr_tok_m.value, .ArrayVal(items_m));
                                      .Some(eval_result(.UnitVal, t_unit()))
                                    }
                                  )
                          ),
                            _ => Option(EvalResult).None
                          )
                      )
                  ),
                _ => Option(EvalResult).None
              ),
            true => Option(EvalResult).None
          ),
        _ => Option(EvalResult).None
      ),
    _ => Option(EvalResult).None
  )
);

// ---------------------------------------------------------------------------
// Phase 3aq: Struct field mutation helper — handles `s.field = rhs` where s
// is a bare identifier bound to a StructVal. Called from the `=` assignment
// handler in `evaluate` when the LHS is a dot-infix expression.
// Returns Some(UnitVal) on success, None if not applicable.
// ---------------------------------------------------------------------------
handle_struct_field_mutation :: (fn(
  recv_opt  : Option(AstExpr),
  field_opt : Option(AstExpr),
  rhs_expr  : AstExpr,
  env       : *(Environment)
) -> Option(EvalResult))(
  match(recv_opt,
    .None => Option(EvalResult).None,
    .Some(recv_expr) =>
      match(recv_expr,
        .FnCall(_, _, _, _, _) => Option(EvalResult).None,
        .Atom(_, recv_tok) =>
          match(field_opt,
            .None => Option(EvalResult).None,
            .Some(field_expr) =>
              match(field_expr,
                .FnCall(_, _, _, _, _) => Option(EvalResult).None,
                .Atom(_, field_tok) =>
                  match(g_eval_fn,
                    .None => Option(EvalResult).None,
                    .Some(ef) =>
                      match(ef(rhs_expr, env),
                        .None => Option(EvalResult).None,
                        .Some(rhs_res) =>
                          match(env.*.lookup(recv_tok.value),
                            .None => Option(EvalResult).None,
                            .Some(recv_var) =>
                              match(recv_var.value,
                                .None => Option(EvalResult).None,
                                .Some(recv_ev) =>
                                  match(recv_ev,
                                    .StructVal(stype, sfnames, sfvals) => {
                                      fname   := field_tok.value.as_str();
                                      n_sf    := sfnames.len();
                                      (fi     : usize)         = usize(0);
                                      (fidx   : Option(usize)) = Option(usize).None;
                                      (sf_fnd : bool)          = false;
                                      while runtime(((fi < n_sf) && (!(sf_fnd)))), {
                                        match(sfnames.get(fi),
                                          .Some(sfn) => {
                                            cond(
                                              (sfn.as_str() == fname) => {
                                                fidx   = .Some(fi);
                                                sf_fnd = true;
                                              },
                                              true => ()
                                            );
                                          },
                                          .None => ()
                                        );
                                        fi = (fi + usize(1));
                                      };
                                      match(fidx,
                                        .None => Option(EvalResult).None,
                                        .Some(target_idx) => {
                                          new_fvals := ArrayList(EvalValue).new();
                                          (k : usize) = usize(0);
                                          while runtime((k < n_sf)), {
                                            cond(
                                              (k == target_idx) => {
                                                new_fvals.push(rhs_res.value);
                                              },
                                              true => {
                                                match(sfvals.get(k),
                                                  .Some(sv) => { new_fvals.push(sv); },
                                                  .None => ()
                                                );
                                              }
                                            );
                                            k = (k + usize(1));
                                          };
                                          _sfok := env.*.set_value(
                                            recv_tok.value,
                                            .StructVal(stype, sfnames, new_fvals)
                                          );
                                          .Some(eval_result(.UnitVal, t_unit()))
                                        }
                                      )
                                    },
                                    _ => Option(EvalResult).None
                                  )
                              )
                          )
                      )
                  )
              )
          )
      )
  )
);

// ---------------------------------------------------------------------------
// Phase 5ac: eval_values_equal — structural equality check for EvalValue
// ---------------------------------------------------------------------------
eval_values_equal :: (fn(a : EvalValue, b : EvalValue) -> bool)(
  match(a,
    .IntLit(sa) => match(b, .IntLit(sb) => (sa.as_str() == sb.as_str()), _ => false),
    .FloatLit(sa) => match(b, .FloatLit(sb) => (sa.as_str() == sb.as_str()), _ => false),
    .BoolVal(ba) => match(b, .BoolVal(bb) => (ba == bb), _ => false),
    .StrLit(sa) => match(b, .StrLit(sb) => (sa.as_str() == sb.as_str()), _ => false),
    .UnitVal => match(b, .UnitVal => true, _ => false),
    _ => false
  )
);

// ---------------------------------------------------------------------------
// method dispatch helper — Phase 3j
// Handles `recv.method(args)` dispatch. Factored out of evaluate to keep
// evaluate's C stack frame small. Uses g_eval_fn to evaluate arg expressions.
// ---------------------------------------------------------------------------
handle_method_dispatch :: (fn(
  recv_val         : EvalValue,
  method_func_box  : Box(AstExpr),
  method_call_args : ArrayList(AstExpr),
  env              : *(Environment)
) -> Option(EvalResult))(
  match(method_func_box.*,
    .FnCall(_, _, _, _, _) => Option(EvalResult).None,
    .Atom(_, mtok) => {
      mname := mtok.value.as_str();
      ty_nm := match(recv_val,
        .StructVal(tn, _, _) => tn.as_str(),
        _ => ""
      );
      qn := `${String.from(ty_nm)}.${String.from(mname)}`;

      // -----------------------------------------------------------------
      // Built-in primitive method shims (Phase 3ai)
      // These intercept method calls on primitive EvalValues before any
      // environment lookup, enabling template-string interpolation and
      // the string-concatenation chain that parse_template_string emits.
      //
      // to_string() — produces StrLit("\"<repr>\"") for primitives.
      // +    (rhs)  — StrLit + StrLit → StrLit (concat, strip re-quote).
      // -----------------------------------------------------------------
      cond(
        ((mname == "to_string") && (method_call_args.len() == usize(0))) =>
          match(recv_val,
            .IntLit(raw)   => { return Option(EvalResult).Some(eval_result(.StrLit((String.from("\"") + raw) + String.from("\"")),  t_comptime_string())); },
            .FloatLit(raw) => { return Option(EvalResult).Some(eval_result(.StrLit((String.from("\"") + raw) + String.from("\"")),  t_comptime_string())); },
            .BoolVal(b)    => { return Option(EvalResult).Some(eval_result(.StrLit(cond(b => String.from("\"true\""),  true => String.from("\"false\""))), t_comptime_string())); },
            .StrLit(s)     => { return Option(EvalResult).Some(eval_result(.StrLit(s),                                             t_comptime_string())); },
            _ => ()
          ),
        // ---------------------------------------------------------------
        // Phase 5aa: .clone() — passthrough for all value types.
        // In proto-eval values are already immutable comptime values,
        // so clone just returns the same value.
        // ---------------------------------------------------------------
        ((mname == "clone") && (method_call_args.len() == usize(0))) =>
          { return Option(EvalResult).Some(eval_result(recv_val, type_of_eval_value(recv_val))); },
        // ---------------------------------------------------------------
        // Phase 5ad: Integer conversion passthroughs — .to_usize(), .to_i64(), etc.
        // In proto-eval all integers are the same. Just return recv_val.
        // ---------------------------------------------------------------
        ((((((mname == "to_usize") || (mname == "to_i64")) || (mname == "to_i32")) || ((mname == "to_u8") || (mname == "to_u32"))) || ((mname == "to_u64") || (mname == "to_f64"))) && (match(recv_val, .IntLit(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          { return Option(EvalResult).Some(eval_result(recv_val, type_of_eval_value(recv_val))); },
        // ---------------------------------------------------------------
        // Phase 5ae: IntLit.abs() — absolute value of integer
        // ---------------------------------------------------------------
        ((mname == "abs") && (match(recv_val, .IntLit(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          match(recv_val,
            .IntLit(raw_abs) =>
              match(parse_raw_int(raw_abs),
                .None => { return Option(EvalResult).None; },
                .Some(n_abs) => {
                  abs_val := cond((n_abs < i64(0)) => (i64(0) - n_abs), true => n_abs);
                  return Option(EvalResult).Some(eval_result(.IntLit(abs_val.to_string()), t_comptime_int()));
                }
              ),
            _ => { return Option(EvalResult).None; }
          ),
        // ---------------------------------------------------------------
        // Phase 5af: IntLit.min(other), IntLit.max(other)
        // ---------------------------------------------------------------
        (((mname == "min") || (mname == "max")) && (match(recv_val, .IntLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(recv_val,
            .IntLit(raw_mm) =>
              match(parse_raw_int(raw_mm),
                .None => { return Option(EvalResult).None; },
                .Some(a_mm) => {
                  other_val := match(method_call_args.get(usize(0)),
                    .Some(oe) => match(match(g_eval_fn, .Some(ef) => ef(oe, env), .None => Option(EvalResult).None),
                      .Some(or2) => match(or2.value, .IntLit(s) => s, _ => { return Option(EvalResult).None; }),
                      .None => { return Option(EvalResult).None; }
                    ),
                    .None => { return Option(EvalResult).None; }
                  );
                  match(parse_raw_int(other_val),
                    .None => { return Option(EvalResult).None; },
                    .Some(b_mm) => {
                      res_mm := cond(
                        (mname == "min") => cond((a_mm < b_mm) => a_mm, true => b_mm),
                        true => cond((a_mm > b_mm) => a_mm, true => b_mm)
                      );
                      return Option(EvalResult).Some(eval_result(.IntLit(res_mm.to_string()), t_comptime_int()));
                    }
                  )
                }
              ),
            _ => { return Option(EvalResult).None; }
          ),
        ((mname == "+") && match(recv_val, .StrLit(_) => true, _ => false)) =>
          match(method_call_args.get(usize(0)),
            .None => { return Option(EvalResult).None; },
            .Some(rhs_expr) =>
              match(match(g_eval_fn,
                  .Some(ef) => ef(rhs_expr, env),
                  .None     => Option(EvalResult).None
                ),
                .None => { return Option(EvalResult).None; },
                .Some(rhs_res) =>
                  match(recv_val,
                    .StrLit(lhs_raw) =>
                      match(rhs_res.value,
                        .StrLit(rhs_raw) => {
                          ln := lhs_raw.len();
                          rn := rhs_raw.len();
                          cond(
                            ((ln < usize(2)) || (rn < usize(2))) => { return Option(EvalResult).None; },
                            true => {
                              lhs_inner := lhs_raw.substring(usize(1), (ln - usize(1)));
                              rhs_inner := rhs_raw.substring(usize(1), (rn - usize(1)));
                              concat_str :=
                                (((String.from("\"") + lhs_inner) + rhs_inner) + String.from("\""));
                              return Option(EvalResult).Some(eval_result(.StrLit(concat_str), t_comptime_string()));
                            }
                          )
                        },
                        _ => { return Option(EvalResult).None; }
                      ),
                    _ => { return Option(EvalResult).None; }
                  )
              )
          ),
        // ---------------------------------------------------------------
        // Phase 3aj: static type method shims — TypeVal.from(s), .new()
        // These intercept `String.from(s)` and `String.new()` before env
        // lookup, enabling programs that use Yo's String API.
        // ---------------------------------------------------------------
        // String.from(s) — evaluate arg and return unchanged (passthrough)
        ((mname == "from") && (match(recv_val, .TypeVal(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(method_call_args.get(usize(0)),
            .None => { return Option(EvalResult).None; },
            .Some(arg_expr_sf) =>
              match(match(g_eval_fn,
                  .Some(ef_sf) => ef_sf(arg_expr_sf, env),
                  .None     => Option(EvalResult).None
                ),
                .None => { return Option(EvalResult).None; },
                .Some(arg_res_sf) => { return Option(EvalResult).Some(arg_res_sf); }
              )
          ),
        // TypeVal.new() — String.new() returns empty StrLit; any other TypeVal
        // (e.g. ArrayList placeholder) returns an empty ArrayVal (Phase 3am).
        ((mname == "new") && (match(recv_val, .TypeVal(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          match(recv_val,
            .TypeVal(ty_box_n) =>
              match(ty_box_n.*,
                .ComptimeString =>
                  { return Option(EvalResult).Some(eval_result(.StrLit(String.from("\"\"")), t_comptime_string())); },
                _ =>
                  { return Option(EvalResult).Some(eval_result(.ArrayVal(ArrayList(EvalValue).new()), t_unit())); }
              ),
            _ => { return Option(EvalResult).None; }
          ),
        // ---------------------------------------------------------------
        // Phase 3ak: StrLit instance method shims — .as_str(), .len()
        // These intercept common string operations on StrLit values before
        // falling through to env lookup (which would fail for runtime stubs).
        // ---------------------------------------------------------------
        // StrLit.as_str() — passthrough (StrLit is already str-like)
        ((mname == "as_str") && (match(recv_val, .StrLit(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          { return Option(EvalResult).Some(eval_result(recv_val, t_comptime_string())); },
        // StrLit.len() — length of the inner content (without surrounding quotes)
        // Returns IntLit (comptime_int) with the decimal character count.
        ((mname == "len") && (match(recv_val, .StrLit(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          match(recv_val,
            .StrLit(raw_l) => {
              n_raw := raw_l.len();
              inner_len := cond(
                (n_raw >= usize(2)) => (n_raw - usize(2)),
                true                => usize(0)
              );
              return Option(EvalResult).Some(eval_result(.IntLit(usize(inner_len).to_string()), t_comptime_int()));
            },
            _ => { return Option(EvalResult).None; }
          ),
        // ---------------------------------------------------------------
        // Phase 3al: StrLit string predicate shims — starts_with, ends_with, contains
        // Each strips the surrounding quotes from the StrLit raw value, then
        // delegates to the real Yo String method.
        // ---------------------------------------------------------------
        // StrLit.starts_with(prefix) — bool: does inner string start with prefix_inner?
        ((mname == "starts_with") && (match(recv_val, .StrLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(method_call_args.get(usize(0)),
            .None => { return Option(EvalResult).None; },
            .Some(sw_arg_expr) =>
              match(match(g_eval_fn,
                  .Some(ef_sw) => ef_sw(sw_arg_expr, env),
                  .None        => Option(EvalResult).None
                ),
                .None => { return Option(EvalResult).None; },
                .Some(sw_arg_res) =>
                  match(recv_val,
                    .StrLit(raw_sw) =>
                      match(sw_arg_res.value,
                        .StrLit(pfx_raw) => {
                          n_sw  := raw_sw.len();
                          n_pfx := pfx_raw.len();
                          cond(
                            ((n_sw < usize(2)) || (n_pfx < usize(2))) =>
                              { return Option(EvalResult).None; },
                            true => {
                              inner_sw  := raw_sw.substring(usize(1), (n_sw - usize(1)));
                              pfx_inner := pfx_raw.substring(usize(1), (n_pfx - usize(1)));
                              return Option(EvalResult).Some(eval_result(.BoolVal(inner_sw.starts_with(pfx_inner)), t_bool()));
                            }
                          )
                        },
                        _ => { return Option(EvalResult).None; }
                      ),
                    _ => { return Option(EvalResult).None; }
                  )
              )
          ),
        // StrLit.ends_with(suffix) — bool: does inner string end with suffix_inner?
        ((mname == "ends_with") && (match(recv_val, .StrLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(method_call_args.get(usize(0)),
            .None => { return Option(EvalResult).None; },
            .Some(ew_arg_expr) =>
              match(match(g_eval_fn,
                  .Some(ef_ew) => ef_ew(ew_arg_expr, env),
                  .None        => Option(EvalResult).None
                ),
                .None => { return Option(EvalResult).None; },
                .Some(ew_arg_res) =>
                  match(recv_val,
                    .StrLit(raw_ew) =>
                      match(ew_arg_res.value,
                        .StrLit(sfx_raw) => {
                          n_ew  := raw_ew.len();
                          n_sfx := sfx_raw.len();
                          cond(
                            ((n_ew < usize(2)) || (n_sfx < usize(2))) =>
                              { return Option(EvalResult).None; },
                            true => {
                              inner_ew  := raw_ew.substring(usize(1), (n_ew - usize(1)));
                              sfx_inner := sfx_raw.substring(usize(1), (n_sfx - usize(1)));
                              return Option(EvalResult).Some(eval_result(.BoolVal(inner_ew.ends_with(sfx_inner)), t_bool()));
                            }
                          )
                        },
                        _ => { return Option(EvalResult).None; }
                      ),
                    _ => { return Option(EvalResult).None; }
                  )
              )
          ),
        // StrLit.contains(sub) — bool: does inner string contain sub_inner?
        ((mname == "contains") && (match(recv_val, .StrLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(method_call_args.get(usize(0)),
            .None => { return Option(EvalResult).None; },
            .Some(con_arg_expr) =>
              match(match(g_eval_fn,
                  .Some(ef_con) => ef_con(con_arg_expr, env),
                  .None         => Option(EvalResult).None
                ),
                .None => { return Option(EvalResult).None; },
                .Some(con_arg_res) =>
                  match(recv_val,
                    .StrLit(raw_con) =>
                      match(con_arg_res.value,
                        .StrLit(sub_raw) => {
                          n_con := raw_con.len();
                          n_sub := sub_raw.len();
                          cond(
                            ((n_con < usize(2)) || (n_sub < usize(2))) =>
                              { return Option(EvalResult).None; },
                            true => {
