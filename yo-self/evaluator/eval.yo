//! Core evaluator dispatch — Phase 3a + 3b + 3c + 3d + 3e + 3f + 3g + 3h + 3i + 3j + 3n.
//!
//! `evaluate` is the main entry point. It handles:
//!   - Literal atoms  (Bool, Integer, Float, StringLit, TemplateString, CharLit)
//!   - Identifier atoms (returns stored compile-time value when available,
//!     otherwise a `VarRef` carrying the variable's type)
//!   - Unit expression `()`
//!   - Begin blocks `{ stmts… }`
//!   - `cond(cond1 => body1, …)` conditional expressions
//!   - `if(cond, then)` / `if(cond, then, else)` conditional expressions
//!   - Variable define `name := expr`, typed `(name : T) := expr`, constant `name :: expr`
//!   - Variable assign `name = expr` and typed declaration `(name : T) = expr`
//!   - Arithmetic operators `+`, `-`, `*`, `/`, `%` (comptime_int and float)
//!   - Comparison operators `==`, `!=`, `<`, `>`, `<=`, `>=` (int, bool, str, float)
//!   - Boolean operators `&&`, `||` (short-circuit), unary `!`
//!   - Unary negation `-` (int and float)
//!   - Enum variant construction `.Variant(args…)` and fieldless `.Variant`
//!   - `match(scrutinee, arm1, …)` pattern matching on compile-time enum values
//!   - `while condition, body` compile-time while loops (condition must fold to bool)
//!   - Function definition `(fn(params) -> RetType)(body)` → FuncVal with closure capture;
//!     `comptime(Name)` parameter annotations are supported
//!   - Function calls `name(args…)` where `name` is bound to a FuncVal
//!   - `return expr` — emits a ReturnVal signal propagated to the call boundary
//!   - `recur(args…)` — recursive call to the currently-executing function
//!   - `name :: expr` — compile-time constant declaration
//!   - Type casts: `i32(x)`, `u64(x)`, `usize(x)`, `f64(x)`, `bool(x)`, etc.
//!   - Struct construction `TypeName(field: val, …)` → StructVal
//!   - Field access `struct_val.field_name` → field value
//!   - Method dispatch `struct_val.method(args…)` via `TypeName.method` lookup
//!   - `impl(TypeName, method: fn_def, …)` — registers methods in the environment
//!
//! Phase 3j adds `impl(...)` support and struct method dispatch. To keep
//! evaluate's C stack frame small (avoiding stack overflows during deep
//! recursion), heavy logic is factored into helper functions that use the
//! `g_eval_fn` module-level pointer (initialized by `_eval_fn_init` after
//! evaluate is defined) to call evaluate without a forward reference:
//!   - `call_funcval_with_args` — handles FuncVal invocation with pre-evaled args
//!   - `handle_method_dispatch` — resolves and calls a struct method
//!   - `handle_impl_form` — registers impl method bindings in the environment
//!
//! All recursive sub-evaluations call `recur` (which is `evaluate` itself).
//!
//! All other expression forms return `None`; they are covered by later phases.
//!
//! NOTE: `recur` binds `__recur_fn` in each call frame so nested recursive
//! calls work correctly.

open import "std/string";
open import "std/fmt";
{ ArrayList } :: import "std/collections/array_list";
{ atof } :: import "std/libc/stdlib";

{ TokenKind, Token } :: import "../lexer/token.yo";
{ AstExpr, BK_BEGIN, BK_TUPLE, BK_ANON_STRUCT, BK_IMPORT, BK_EXPORT, BK_OPEN } :: import "../expr/expr.yo";
{ TypeValue, type_value_tag,
  t_unit, t_bool, t_void,
  t_i8, t_i16, t_i32, t_i64,
  t_u8, t_u16, t_u32, t_u64,
  t_f32, t_f64,
  t_usize, t_isize,
  t_comptime_int, t_comptime_float, t_comptime_string,
  t_type }
  :: import "../types/type.yo";
{ TypeTag } :: import "../types/tags.yo";
{ Environment } :: import "../env/env.yo";
{ EvalValue, EvalResult, eval_result } :: import "./value.yo";

// ---------------------------------------------------------------------------
// Module-level function pointer slot for evaluate (Phase 3j)
// Filled in by _eval_fn_init after evaluate is defined so call_funcval_with_args
// can invoke evaluate without a forward reference.
// ---------------------------------------------------------------------------
(g_eval_fn : Option((fn(e : AstExpr, env : *(Environment)) -> Option(EvalResult)))) = .None;

// ---------------------------------------------------------------------------
// Module loader callback slot (Phase 3m).
// When set, `import "path"` looks up the path via this callback and returns
// the resulting `ModuleVal`.  Tests register a mock loader; the CLI phase
// will provide the real file-based loader.
// ---------------------------------------------------------------------------
(g_module_loader : Option((fn(path : String) -> Option(EvalValue)))) = .None;

// ---------------------------------------------------------------------------
// Helpers (must precede evaluate — no back-references to evaluate)
// ---------------------------------------------------------------------------

/// Map a known primitive type name (e.g. `"i32"`, `"usize"`) to its TypeValue.
/// Returns `t_unit()` for unrecognized names.
type_from_name :: (fn(name : str) -> TypeValue)(
  cond(
    (name == "i8")    => t_i8(),
    (name == "i16")   => t_i16(),
    (name == "i32")   => t_i32(),
    (name == "i64")   => t_i64(),
    (name == "u8")    => t_u8(),
    (name == "u16")   => t_u16(),
    (name == "u32")   => t_u32(),
    (name == "u64")   => t_u64(),
    (name == "usize") => t_usize(),
    (name == "isize") => t_isize(),
    (name == "f32")   => t_f32(),
    (name == "f64")   => t_f64(),
    (name == "bool")  => t_bool(),
    true              => t_unit()
  )
);

/// Like `type_from_name` but returns `Option(TypeValue)` — used in the
/// identifier lookup fallback so we can distinguish "unknown type name" from
/// "known type name" without returning the sentinel `t_unit()`.
type_from_name_opt :: (fn(name : str) -> Option(TypeValue))(
  cond(
    (name == "i8")    => .Some(t_i8()),
    (name == "i16")   => .Some(t_i16()),
    (name == "i32")   => .Some(t_i32()),
    (name == "i64")   => .Some(t_i64()),
    (name == "u8")    => .Some(t_u8()),
    (name == "u16")   => .Some(t_u16()),
    (name == "u32")   => .Some(t_u32()),
    (name == "u64")   => .Some(t_u64()),
    (name == "usize") => .Some(t_usize()),
    (name == "isize") => .Some(t_isize()),
    (name == "f32")   => .Some(t_f32()),
    (name == "f64")   => .Some(t_f64()),
    (name == "bool")  => .Some(t_bool()),
    (name == "unit")  => .Some(t_unit()),
    (name == "Type")  => .Some(t_type()),
    true              => Option(TypeValue).None
  )
);

/// True when `name` is a recognized primitive type that can be used
/// as a cast/coercion call: `i32(x)`, `u64(y)`, `usize(n)`, etc.
is_primitive_type_cast :: (fn(name : str) -> bool)(
  cond(
    (name == "i8")    => true,
    (name == "i16")   => true,
    (name == "i32")   => true,
    (name == "i64")   => true,
    (name == "u8")    => true,
    (name == "u16")   => true,
    (name == "u32")   => true,
    (name == "u64")   => true,
    (name == "usize") => true,
    (name == "isize") => true,
    (name == "f32")   => true,
    (name == "f64")   => true,
    (name == "bool")  => true,
    true              => false
  )
);

/// True for any integer-like type the evaluator handles numerically.
/// Broader than `is_int_type` from type.yo because it includes ComptimeInt,
/// Usize, and Isize (which the type-system helper does not).
is_eval_int_type :: (fn(t : TypeValue) -> bool)(
  match(t,
    .Int(_, _)   => true,
    .Usize       => true,
    .Isize       => true,
    .ComptimeInt => true,
    _            => false
  )
);

is_eval_float_type :: (fn(t : TypeValue) -> bool)(
  match(t,
    .Float(_)      => true,
    .ComptimeFloat => true,
    _              => false
  )
);

/// True when the evaluated value should be treated as compile-time-only.
value_is_comptime :: (fn(v : EvalValue) -> bool)(
  match(v,
    .UnitVal       => true,
    .BoolVal(_)    => true,
    .IntLit(_)     => true,
    .FloatLit(_)   => true,
    .StrLit(_)     => true,
    .VarRef(_)     => false,
    .EnumVal(_, _) => true,
    .FuncVal(_, _, _, _, _, _, _) => true,
    .ReturnVal(_, _) => true,
    .TypeVal(_)    => true,
    .StructVal(_, _, _) => true,
    .ModuleVal(_, _) => true
  )
);

/// Extract a `TypeValue` from a simple type-annotation expression.
/// Recognises the same primitive names as `type_from_name` (`i32`, `bool`,
/// `usize`, `str`, etc.). Returns `t_unit()` for complex types like `Option(T)`.
eval_type_annotation_expr :: (fn(type_expr : AstExpr) -> TypeValue)(
  match(type_expr,
    .Atom(tok) => type_from_name(tok.value.as_str()),
    .FnCall(_, _, _, _) => t_unit()
  )
);

/// Look up an identifier in the environment. Returns the stored compile-time
/// value when available; otherwise a `VarRef` carrying the variable's type.
/// Returns `None` if the name is unbound.
eval_identifier :: (fn(tok : Token, env : *(Environment)) -> Option(EvalResult))(
  match((env.*).lookup(tok.value),
    .Some(var) =>
      match(var.value,
        .Some(v)  => .Some(eval_result(v, var.ty)),
        .None     => .Some(eval_result(.VarRef(tok.value), var.ty))
      ),
    .None =>
      // Not in env — check if the name is a known primitive type name.
      // This makes `i32`, `bool`, `usize`, etc. resolve to TypeVal at
      // use sites like `(x : i32) = …` or generic type-param bindings.
      match(type_from_name_opt(tok.value.as_str()),
        .Some(ty) => .Some(eval_result(.TypeVal(box(ty)), t_type())),
        .None     => Option(EvalResult).None
      )
  )
);

/// Evaluate a single-token `Atom` expression (does not recurse into evaluate).
eval_atom :: (fn(tok : Token, env : *(Environment)) -> Option(EvalResult))(
  cond(
    (tok.kind == TokenKind.Bool) => {
      b := (tok.value.as_str() == "true");
      .Some(eval_result(.BoolVal(b), t_bool()))
    },
    (tok.kind == TokenKind.Integer) =>
      .Some(eval_result(.IntLit(tok.value), t_comptime_int())),
    (tok.kind == TokenKind.Float) =>
      .Some(eval_result(.FloatLit(tok.value), t_comptime_float())),
    (tok.kind == TokenKind.StringLit) =>
      .Some(eval_result(.StrLit(tok.value), t_comptime_string())),
    (tok.kind == TokenKind.TemplateString) =>
      .Some(eval_result(.StrLit(tok.value), t_comptime_string())),
    (tok.kind == TokenKind.CharLit) =>
      .Some(eval_result(.IntLit(tok.value), t_u32())),
    (tok.kind == TokenKind.Identifier) =>
      eval_identifier(tok, env),
    true =>
      Option(EvalResult).None
  )
);

// ---------------------------------------------------------------------------
// Phase 3d helpers: type inference from value, pattern matching
// ---------------------------------------------------------------------------

/// Best-effort type inference from an `EvalValue`.
/// Returns a primitive type for known literals; falls back to `t_unit()` for
/// complex or runtime values (where the exact type is not tracked in the value).
type_of_eval_value :: (fn(v : EvalValue) -> TypeValue)(
  match(v,
    .UnitVal         => t_unit(),
    .BoolVal(_)      => t_bool(),
    .IntLit(_)       => t_comptime_int(),
    .FloatLit(_)     => t_comptime_float(),
    .StrLit(_)       => t_comptime_string(),
    .VarRef(_)       => t_unit(),
    .EnumVal(_, _)   => t_unit(),
    .FuncVal(_, _, _, _, _, _, _)   => t_unit(),
    .ReturnVal(_, _) => t_unit(),
    .TypeVal(_)      => t_type(),
    .StructVal(_, _, _) => t_unit(),
    .ModuleVal(_, _) => t_unit()
  )
);

/// Try to match `pattern` (an AstExpr from a match arm) against `scrutinee_val`,
/// adding variable bindings into `env`.  Returns `true` on success (and the env
/// has been updated with any new bindings), or `false` when the pattern does not
/// match the scrutinee.
///
/// Supported pattern forms:
///   - `_`            — wildcard, always matches, no bindings
///   - `ident`        — bare identifier (no dot), binds the whole scrutinee
///   - `.None`        — fieldless enum variant `FnCall(Atom(Dot), [Atom("None")], _)`
///   - `.Some(x, …)` — variant with positional bindings
try_match_pat :: (fn(pattern : AstExpr, scrutinee_val : EvalValue, scrutinee_ty : TypeValue, env : *(Environment)) -> bool)({
  match(pattern,
    // -----------------------------------------------------------------------
    // Atom patterns: wildcard `_` or bare variable binding
    // -----------------------------------------------------------------------
    .Atom(ptok) =>
      cond(
        (ptok.value.as_str() == "_") =>
          true,
        true => {
          // Bare identifier: bind whole scrutinee
          _idx := env.define_val(ptok.value, scrutinee_ty, true, .Some(scrutinee_val));
          true
        }
      ),

    // -----------------------------------------------------------------------
    // FnCall patterns
    // -----------------------------------------------------------------------
    .FnCall(pat_func, pat_args, _, _) =>
      match(pat_func.*,
        // Fieldless variant: FnCall(Atom(Dot), [Atom("None")], _)
        .Atom(dot_tok) =>
          cond(
            (dot_tok.kind != TokenKind.Dot) => false,
            true => {
              // variant name is pat_args[0]
              vname := match(pat_args.get(usize(0)),
                .Some(vne) => match(vne,
                  .Atom(vntok) => vntok.value.as_str(),
                  .FnCall(_, _, _, _) => { return false; }
                ),
                .None => { return false; }
              );
              full_variant := `.${ String.from(vname) }`;
              match(scrutinee_val,
                .EnumVal(svar, _) => (svar.as_str() == full_variant.as_str()),
                _ => false
              )
            }
          ),

        // Variant-with-args: FnCall(FnCall(Atom(Dot), [Atom("Some")], _), [x, …], false)
        .FnCall(inner_dot_func, inner_dot_args, _, _) => {
          // Verify inner func is a dot
          (is_dot : bool) = match(inner_dot_func.*,
            .Atom(dt) => (dt.kind == TokenKind.Dot),
            .FnCall(_, _, _, _) => false
          );
          cond(
            (!(is_dot)) => false,
            true => {
              vname := match(inner_dot_args.get(usize(0)),
                .Some(vne) => match(vne,
                  .Atom(vntok) => vntok.value.as_str(),
                  .FnCall(_, _, _, _) => { return false; }
                ),
                .None => { return false; }
              );
              full_variant := `.${ String.from(vname) }`;
              match(scrutinee_val,
                .EnumVal(svar, sfields) =>
                  cond(
                    (!(svar.as_str() == full_variant.as_str())) => false,
                    (sfields.len() != pat_args.len()) => false,
                    true => {
                      n_bind := pat_args.len();
                      (i : usize) = usize(0);
                      (ok : bool) = true;
                      while runtime(((i < n_bind) && ok)), {
                        match(sfields.get(i),
                          .Some(field_val) =>
                            match(pat_args.get(i),
                              .Some(binding_expr) =>
                                match(binding_expr,
                                  .Atom(btok) =>
                                    cond(
                                      (btok.value.as_str() == "_") => (),
                                      true => {
                                        bty := type_of_eval_value(field_val);
                                        _idx := env.define_val(btok.value, bty, true, .Some(field_val));
                                        ()
                                      }
                                    ),
                                  .FnCall(_, _, _, _) => { ok = false; }
                                ),
                              .None => { ok = false; }
                            ),
                          .None => { ok = false; }
                        );
                        i = (i + usize(1));
                      };
                      ok
                    }
                  ),
                _ => false
              )
            }
          )
        }
      )
  )
});

// ---------------------------------------------------------------------------
// Integer parsing helpers (Phase 3c — comptime integer folding)
// ---------------------------------------------------------------------------

/// Get the numeric value of byte `b` as a digit in the given numeric base
/// (2, 8, 10, or 16). Returns `None` if `b` is not a valid digit for that base.
digit_value :: (fn(b : u8, base : i64) -> Option(i64))(
  cond(
    ((b >= u8(48)) && (b <= u8(57))) => {  // '0'-'9'
      d := (i64(b) - i64(48));
      cond((d < base) => .Some(d), true => .None)
    },
    ((b >= u8(97)) && (b <= u8(102))) => {  // 'a'-'f'
      d := ((i64(b) - i64(97)) + i64(10));
      cond((d < base) => .Some(d), true => .None)
    },
    ((b >= u8(65)) && (b <= u8(70))) => {  // 'A'-'F'
      d := ((i64(b) - i64(65)) + i64(10));
      cond((d < base) => .Some(d), true => .None)
    },
    true => .None
  )
);

/// Parse `bytes[start..]` as a non-negative integer in the given base.
/// Returns `None` if the slice is empty or contains an invalid digit.
parse_prefixed_int :: (fn(bytes : ArrayList(u8), start : usize, base : i64) -> Option(i64))({
  n := bytes.len();
  cond(
    (start >= n) => .None,
    true => {
      (result : i64) = i64(0);
      (i : usize) = start;
      (ok : bool) = true;
      while runtime(((i < n) && ok)), {
        match(bytes.get(i),
          .Some(b) =>
            match(digit_value(b, base),
              .Some(d) => { result = ((result * base) + d); },
              .None    => { ok = false; }
            ),
          .None => { ok = false; }
        );
        i = (i + usize(1));
      };
      cond(ok => .Some(result), true => .None)
    }
  )
});

/// Parse a raw integer token string to `i64`.
///
/// Handles:
/// - Decimal integers (default)
/// - Hex integers with `0x` / `0X` prefix
/// - Binary integers with `0b` / `0B` prefix
/// - Octal integers with `0o` / `0O` prefix
/// - Underscore separators (e.g. `1_000_000`)
///
/// Returns `None` if the raw string cannot be parsed.
parse_raw_int :: (fn(raw : String) -> Option(i64))({
  stripped := raw.replace_all(`_`, ``);
  cond(
    ((stripped.starts_with(`0x`)) || (stripped.starts_with(`0X`))) =>
      parse_prefixed_int(stripped.as_bytes(), usize(2), i64(16)),
    ((stripped.starts_with(`0b`)) || (stripped.starts_with(`0B`))) =>
      parse_prefixed_int(stripped.as_bytes(), usize(2), i64(2)),
    ((stripped.starts_with(`0o`)) || (stripped.starts_with(`0O`))) =>
      parse_prefixed_int(stripped.as_bytes(), usize(2), i64(8)),
    true => stripped.parse_i64()
  )
});

/// Parse a raw float string (e.g. `"3.14"`, `"1e-5"`) into an `f64`.
/// Uses `atof` from the C standard library.
/// Returns `None` if the string has no valid C-string representation.
parse_raw_float :: (fn(raw : String) -> Option(f64))({
  cs := raw.to_cstr();
  match(cs.ptr(),
    .Some(ptr) => .Some(atof(*(char)(ptr))),
    .None       => .None
  )
});

// ---------------------------------------------------------------------------
// Main evaluator — Phase 3b/3c/3d forms are inlined so `recur` can be used for
// recursive evaluation without forward-reference issues.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// FuncVal call helper — Phase 3j
// Factored out of `evaluate` so method dispatch (and any future call sites)
// can invoke it without bloating evaluate's C stack frame.
// Uses g_eval_fn which is set to evaluate by _eval_fn_init after evaluate
// is defined below.
// ---------------------------------------------------------------------------
call_funcval_with_args :: (fn(
  fv             : EvalValue,
  already_evaled : ArrayList(EvalResult)
) -> Option(EvalResult))(
  match(g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) =>
      match(fv,
        .FuncVal(forall_names_h, params, param_type_names_h, body, cap_names, cap_tys, cap_vals) => {
          n_p := params.len();
          n_a := already_evaled.len();
          cond(
            (n_p != n_a) => Option(EvalResult).None,
            true => {
              fresh_fn_env := Environment.new(String.from(""));
              n_cap_h := cap_names.len();
              (chi : usize) = usize(0);
              while runtime((chi < n_cap_h)), {
                match(cap_names.get(chi),
                  .Some(cn) =>
                    match(cap_tys.get(chi),
                      .Some(ct) =>
                        match(cap_vals.get(chi),
                          .Some(cv) => {
                            _dch := cond(
                              (!(value_is_comptime(cv))) =>
                                (&fresh_fn_env).define_val(cn, ct, false, Option(EvalValue).None),
                              true =>
                                (&fresh_fn_env).define_val(cn, ct, true, .Some(cv))
                            );
                          },
                          .None => ()
                        ),
                      .None => ()
                    ),
                  .None => ()
                );
                chi = (chi + usize(1));
              };
              _ffr := (&fresh_fn_env).push_frame(false);
              _frr := (&fresh_fn_env).define_val(
                String.from("__recur_fn"), t_unit(), true, .Some(fv)
              );
              // Phase 3l: infer forall type params from argument types.
              // For each forall name F, scan param_type_names_h for a value param
              // annotated with F; use that argument's type to bind F = TypeVal(ty).
              n_forall_h := forall_names_h.len();
              (fa_i_h : usize) = usize(0);
              while runtime((fa_i_h < n_forall_h)), {
                match(forall_names_h.get(fa_i_h),
                  .Some(fa_name) => {
                    n_ptn_h := param_type_names_h.len();
                    (ptn_i_h : usize) = usize(0);
                    (fa_bound_h : bool) = false;
                    while runtime(((ptn_i_h < n_ptn_h) && (!(fa_bound_h)))), {
                      match(param_type_names_h.get(ptn_i_h),
                        .Some(ptn) => {
                          cond(
                            (ptn.as_str() == fa_name.as_str()) => {
                              match(already_evaled.get(ptn_i_h),
                                .Some(arg_res) => {
                                  _fa_bind := (&fresh_fn_env).define_val(
                                    fa_name,
                                    t_type(),
                                    true,
                                    .Some(EvalValue.TypeVal(box(arg_res.ty)))
                                  );
                                  fa_bound_h = true;
                                },
                                .None => ()
                              );
                            },
                            true => ()
                          );
                        },
                        .None => ()
                      );
                      ptn_i_h = (ptn_i_h + usize(1));
                    };
                  },
                  .None => ()
                );
                fa_i_h = (fa_i_h + usize(1));
              };
              (pi : usize) = usize(0);
              while runtime((pi < n_p)), {
                match(params.get(pi),
                  .Some(pname) =>
                    match(already_evaled.get(pi),
                      .Some(pval) => {
                        _dph := (&fresh_fn_env).define_val(
                          pname, pval.ty, value_is_comptime(pval.value), .Some(pval.value)
                        );
                      },
                      .None => ()
                    ),
                  .None => ()
                );
                pi = (pi + usize(1));
              };
              body_rh := ef(body.*, &fresh_fn_env);
              match(body_rh,
                .None => Option(EvalResult).None,
                .Some(br) =>
                  match(br.value,
                    .ReturnVal(rv, rt) => .Some(eval_result(rv.*, rt)),
                    _ => .Some(br)
                  )
              )
            }
          )
        },
        _ => Option(EvalResult).None
      )
  )
);

// ---------------------------------------------------------------------------
// method dispatch helper — Phase 3j
// Handles `recv.method(args)` dispatch. Factored out of evaluate to keep
// evaluate's C stack frame small. Uses g_eval_fn to evaluate arg expressions.
// ---------------------------------------------------------------------------
handle_method_dispatch :: (fn(
  recv_val         : EvalValue,
  method_func_box  : Box(AstExpr),
  method_call_args : ArrayList(AstExpr),
  env              : *(Environment)
) -> Option(EvalResult))(
  match(method_func_box.*,
    .FnCall(_, _, _, _) => Option(EvalResult).None,
    .Atom(mtok) => {
      mname := mtok.value.as_str();
      ty_nm := match(recv_val,
        .StructVal(tn, _, _) => tn.as_str(),
        _ => ""
      );
      qn := `${String.from(ty_nm)}.${String.from(mname)}`;
      maybe_mval := match(env.*.lookup(qn),
        .Some(mv) => mv.value,
        .None =>
          match(env.*.lookup(String.from(mname)),
            .Some(mv2) => mv2.value,
            .None => Option(EvalValue).None
          )
      );
      match(maybe_mval,
        .None => Option(EvalResult).None,
        .Some(mval) => {
          evaled := ArrayList(EvalResult).new();
          evaled.push(eval_result(recv_val, type_of_eval_value(recv_val)));
          n_ca := method_call_args.len();
          (cai : usize) = usize(0);
          (caok : bool) = true;
          while runtime(((cai < n_ca) && caok)), {
            match(method_call_args.get(cai),
              .Some(aexpr) =>
                match(match(g_eval_fn,
                  .Some(ef) => ef(aexpr, env),
                  .None => Option(EvalResult).None
                ),
                  .Some(ar) => { evaled.push(ar); },
                  .None => { caok = false; }
                ),
              .None => { caok = false; }
            );
            cai = (cai + usize(1));
          };
          cond(
            (!(caok)) => Option(EvalResult).None,
            true => call_funcval_with_args(mval, evaled)
          )
        }
      )
    }
  )
);

// ---------------------------------------------------------------------------
// impl handler helper — Phase 3j
// Handles `impl(TypeName, method_name : fn_def, …)` forms.
// Factored out of `evaluate` to reduce evaluate's C stack frame.
// Uses g_eval_fn to evaluate method bodies.
// ---------------------------------------------------------------------------
handle_impl_form :: (fn(
  args : ArrayList(AstExpr),
  env  : *(Environment)
) -> Option(EvalResult))(
  match(args.get(usize(0)),
    .None => Option(EvalResult).None,
    .Some(ty_expr) =>
      match(ty_expr,
        .FnCall(_, _, _, _) => Option(EvalResult).None,
        .Atom(ty_tok) => {
          ty_nm := ty_tok.value.as_str();
          n_margs := args.len();
          (mi : usize) = usize(1);
          (mok : bool) = true;
          while runtime(((mi < n_margs) && mok)), {
            match(args.get(mi),
              .Some(meth_expr) =>
                match(meth_expr,
                  .FnCall(colon_func, colon_args, colon_infix, _) => {
                    cond(
                      (colon_infix) =>
                        match(colon_func.*,
                          .Atom(colon_tok) => {
                            cond(
                              (colon_tok.value.as_str() == ":") => {
                                match(colon_args.get(usize(0)),
                                  .Some(name_expr) =>
                                    match(name_expr,
                                      .Atom(name_tok) => {
                                        match(colon_args.get(usize(1)),
                                          .Some(fn_expr) => {
                                            match(match(g_eval_fn,
                                              .Some(ef) => ef(fn_expr, env),
                                              .None => Option(EvalResult).None
                                            ),
                                              .Some(mres) => {
                                                qn := `${String.from(ty_nm)}.${name_tok.value}`;
                                                _dm := env.define_val(
                                                  qn,
                                                  type_of_eval_value(mres.value),
                                                  value_is_comptime(mres.value),
                                                  .Some(mres.value)
                                                );
                                              },
                                              .None => { mok = false; }
                                            );
                                          },
                                          .None => ()
                                        );
                                      },
                                      .FnCall(_, _, _, _) => ()
                                    ),
                                  .None => ()
                                );
                              },
                              true => ()
                            );
                          },
                          .FnCall(_, _, _, _) => ()
                        ),
                      true => ()
                    );
                  },
                  _ => ()
                ),
              .None => ()
            );
            mi = (mi + usize(1));
          };
          cond(
            (!(mok)) => Option(EvalResult).None,
            true => .Some(eval_result(.UnitVal, t_unit()))
          )
        }
      )
  )
);

/// Evaluate a list of top-level module expressions and collect exports.
///
/// Iterates `exprs`, evaluating each one through `g_eval_fn`. When an
/// `export(name1, name2, …)` call is encountered the named variables are
/// looked up in `env` and appended to the result `ModuleVal`.
///
/// Returns `Some(ModuleVal(names, values))` on success, or `None` if
/// `g_eval_fn` is not set or any expression fails to evaluate.
evaluate_module_body :: (fn(exprs : ArrayList(AstExpr), env : *(Environment)) -> Option(EvalValue))({
  names  := ArrayList(String).new();
  values := ArrayList(EvalValue).new();
  n      := exprs.len();
  (i   : usize) = usize(0);
  (ok  : bool)  = true;
  while runtime(((i < n) && ok)), {
    match(exprs.get(i),
      .Some(expr) =>
        match(expr,
          // export(name1, name2, …) — collect exported bindings
          .FnCall(fb, fargs, _, _) =>
            match(fb.*,
              .Atom(ftok) =>
                cond(
                  (ftok.value.as_str() == BK_EXPORT) => {
                    j  := usize(0);
                    nj := fargs.len();
                    while runtime(((j < nj) && ok)), {
                      match(fargs.get(j),
                        .Some(export_expr) =>
                          match(export_expr,
                            .Atom(name_tok) => {
                              match(env.*.lookup(String.from(name_tok.value.as_str())),
                                .Some(var) => {
                                  exported_val := match(var.value,
                                    .Some(v) => v,
                                    .None    => EvalValue.VarRef(String.from(name_tok.value.as_str()))
                                  );
                                  names.push(String.from(name_tok.value.as_str()));
                                  values.push(exported_val);
                                },
                                .None => { ok = false; }
                              );
                            },
                            .FnCall(_, _, _, _) => { ok = false; }
                          ),
                        .None => { ok = false; }
                      );
                      j = (j + usize(1));
                    };
                  },
                  // Regular expression — evaluate normally
                  true =>
                    match(g_eval_fn,
                      .Some(eval_fn) =>
                        match(eval_fn(expr, env),
                          .Some(_) => (),
                          .None    => { ok = false; }
                        ),
                      .None => { ok = false; }
                    )
                ),
              .FnCall(_, _, _, _) =>
                // Complex func head — evaluate normally
                match(g_eval_fn,
                  .Some(eval_fn) =>
                    match(eval_fn(expr, env),
                      .Some(_) => (),
                      .None    => { ok = false; }
                    ),
                  .None => { ok = false; }
                )
            ),
          // Atom at module level — evaluate normally
          .Atom(_) =>
            match(g_eval_fn,
              .Some(eval_fn) =>
                match(eval_fn(expr, env),
                  .Some(_) => (),
                  .None    => { ok = false; }
                ),
              .None => { ok = false; }
            )
        ),
      .None => { ok = false; }
    );
    i = (i + usize(1));
  };
  cond(
    ok => .Some(.ModuleVal(names, values)),
    true => Option(EvalValue).None
  )
});

// ---------------------------------------------------------------------------
// Phase 3n helpers — factored out of evaluate to keep its ASAN frame small.
// ---------------------------------------------------------------------------

/// Handle `if(cond, then)` or `if(cond, then, else)`.
/// Uses g_eval_fn for recursive evaluation.
handle_if_form :: (fn(
  args : ArrayList(AstExpr),
  env  : *(Environment)
) -> Option(EvalResult))({
  n_if := args.len();
  match(args.get(usize(0)),
    .None => Option(EvalResult).None,
    .Some(cond_expr) =>
      match(match(g_eval_fn,
        .Some(ef) => ef(cond_expr, env),
        .None => Option(EvalResult).None
      ),
        .None => Option(EvalResult).None,
        .Some(cond_r) =>
          match(cond_r.value,
            .BoolVal(b) =>
              cond(
                b =>
                  match(args.get(usize(1)),
                    .Some(then_e) =>
                      match(g_eval_fn, .Some(ef) => ef(then_e, env), .None => Option(EvalResult).None),
                    .None => Option(EvalResult).None
                  ),
                (n_if >= usize(3)) =>
                  match(args.get(usize(2)),
                    .Some(else_e) =>
                      match(g_eval_fn, .Some(ef) => ef(else_e, env), .None => Option(EvalResult).None),
                    .None => Option(EvalResult).None
                  ),
                true => .Some(eval_result(.UnitVal, t_unit()))
              ),
            _ => Option(EvalResult).None
          )
      )
  )
});

/// Fold `lv op rv` where both sides are float.  `fval` is "+", "-", "*", "/".
eval_float_arith :: (fn(fval : str, lv : EvalResult, rv : EvalResult) -> Option(EvalResult))({
  lv_ty := lv.ty;
  a_raw := match(lv.value, .FloatLit(raw) => raw, _ => { return Option(EvalResult).None; });
  b_raw := match(rv.value, .FloatLit(raw) => raw, _ => { return Option(EvalResult).None; });
  a := match(parse_raw_float(a_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
  b := match(parse_raw_float(b_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
  res_opt := cond(
    (fval == "+") => Option(f64).Some((a + b)),
    (fval == "-") => Option(f64).Some((a - b)),
    (fval == "*") => Option(f64).Some((a * b)),
    (fval == "/") => cond((b == f64(0)) => Option(f64).None, true => Option(f64).Some((a / b))),
    true => Option(f64).None
  );
  match(res_opt,
    .Some(res) => .Some(eval_result(.FloatLit(res.to_string()), lv_ty)),
    .None => Option(EvalResult).None
  )
});

/// Compare two float EvalResults with operator `fval` (==, !=, <, >, <=, >=).
eval_float_cmp :: (fn(fval : str, lv : EvalResult, rv : EvalResult) -> Option(EvalResult))({
  a_raw := match(lv.value, .FloatLit(raw) => raw, _ => { return Option(EvalResult).None; });
  b_raw := match(rv.value, .FloatLit(raw) => raw, _ => { return Option(EvalResult).None; });
  a := match(parse_raw_float(a_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
  b := match(parse_raw_float(b_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
  res := cond(
    (fval == "==") => (a == b),
    (fval == "!=") => (!(a == b)),
    (fval == "<")  => (a < b),
    (fval == ">")  => (a > b),
    (fval == "<=") => (a <= b),
    (fval == ">=") => (a >= b),
    true           => { return Option(EvalResult).None; }
  );
  .Some(eval_result(.BoolVal(res), t_bool()))
});

/// Negate a float EvalResult.
eval_float_neg :: (fn(v : EvalResult) -> Option(EvalResult))({
  v_ty := v.ty;
  match(v.value,
    .FloatLit(raw) => {
      a := match(parse_raw_float(raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
      .Some(eval_result(.FloatLit((f64(0.0) - a).to_string()), v_ty))
    },
    _ => Option(EvalResult).None
  )
});

/// Extract the parameter name from `comptime(Name)` form.
/// Returns `Some(name)` when the box is `comptime(Atom(name))`, else `None`.
extract_comptime_param_name :: (fn(
  ct_box  : Box(AstExpr),
  ct_args : ArrayList(AstExpr)
) -> Option(String))({
  match(ct_box.*,
    .Atom(ct_tok) =>
      cond(
        (ct_tok.value.as_str() == "comptime") =>
          match(ct_args.get(usize(0)),
            .Some(ct_name_e) =>
              match(ct_name_e,
                .Atom(ct_name_tok) => .Some(ct_name_tok.value),
                .FnCall(_, _, _, _) => Option(String).None
              ),
            .None => Option(String).None
          ),
        true => Option(String).None
      ),
    .FnCall(_, _, _, _) => Option(String).None
  )
});

/// Evaluate a single `AstExpr` node in the given environment.
///
/// Returns `None` for expression forms not yet handled (Phase 3e+ scope).
evaluate :: (fn(e : AstExpr, env : *(Environment)) -> Option(EvalResult))({
  match(e,
    .Atom(tok) =>
      eval_atom(tok, env),

    .FnCall(func_box, args, is_infix, _tok) =>
      match(func_box.*,
        // -----------------------------------------------------------------
        // Enum variant construction with args: .Some(42), .Ok(x), …
        //   func_box.* = FnCall(Atom(Dot), [Atom("Some")], true)
        //   outer args = [arg1, arg2, …]
        //
        // Function definition: (fn(params) -> RetType)(body)
        //   func_box.* = FnCall(Atom("->"), [FnCall(Atom("fn"), [...]), RetType], true)
        //   outer args = [body_expr]
        // -----------------------------------------------------------------
        .FnCall(inner_func, inner_args, _, _) => {
          match(inner_func.*,
            .Atom(dt) =>
              cond(
                // ---- enum variant with args ----
                (dt.kind == TokenKind.Dot) => {
                  vname := match(inner_args.get(usize(0)),
                    .Some(vne) => match(vne,
                      .Atom(vntok) => vntok.value.as_str(),
                      .FnCall(_, _, _, _) => { return Option(EvalResult).None; }
                    ),
                    .None => { return Option(EvalResult).None; }
                  );
                  variant_str := `.${ String.from(vname) }`;
                  n_args := args.len();
                  fields := ArrayList(EvalValue).new();
                  (i : usize) = usize(0);
                  (ok : bool) = true;
                  while runtime(((i < n_args) && ok)), {
                    match(args.get(i),
                      .Some(arg_expr) =>
                        match(recur(arg_expr, env),
                          .Some(r) => { fields.push(r.value); },
                          .None    => { ok = false; }
                        ),
                      .None => { ok = false; }
                    );
                    i = (i + usize(1));
                  };
                  cond(
                    ok => .Some(eval_result(.EnumVal(variant_str, fields), t_unit())),
                    true => Option(EvalResult).None
                  )
                },

                // ---- function definition: (fn(params) -> RetType)(body) ----
                (dt.value.as_str() == "->") =>
                  match(inner_args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(fn_call_expr) =>
                      match(fn_call_expr,
                        .Atom(_) => Option(EvalResult).None,
                        .FnCall(fn_func_box, fn_params_list, _, _) => {
                          // Verify func_box is `fn` atom
                          ok_fn := match(fn_func_box.*,
                            .Atom(fntok) => (fntok.value.as_str() == "fn"),
                            .FnCall(_, _, _, _) => false
                          );
                          cond(
                            (!(ok_fn)) => Option(EvalResult).None,
                            true => {
                              // Extract forall names, param names, and param type
                              // annotation identifiers from the param list.
                              //
                              // Each param is one of:
                              //   FnCall(Atom("forall"), [Atom("T")], false)
                              //     → forall name "T"
                              //   FnCall(Atom("forall"), [FnCall(Atom(":"), [Atom("T"), ...], true)], false)
                              //     → forall name "T" (constrained forall)
                              //   FnCall(Atom(":"), [Atom(name), type_expr], true)
                              //     → value param "name" with type annotation
                              //   Atom(name)
                              //     → bare value param (no type annotation)
                              //   Other (using/where) → skip
                              forall_names_f    := ArrayList(String).new();
                              params_f          := ArrayList(String).new();
                              param_type_names_f := ArrayList(String).new();
                              (pi : usize) = usize(0);
                              n_p := fn_params_list.len();
                              (param_ok : bool) = true;
                              while runtime(((pi < n_p) && param_ok)), {
                                match(fn_params_list.get(pi),
                                  .Some(pd) =>
                                    match(pd,
                                      .FnCall(kw_box, kw_args, _, _) =>
                                        match(kw_box.*,
                                          .Atom(kw_tok) =>
                                            cond(
                                              (kw_tok.value.as_str() == ":") =>
                                                // Value param: extract name + type annotation
                                                match(kw_args.get(usize(0)),
                                                  .Some(name_expr) =>
                                                    match(name_expr,
                                                      .Atom(name_tok) => {
                                                        params_f.push(name_tok.value);
                                                        // Capture simple identifier type annotation
                                                        ptn_s := match(kw_args.get(usize(1)),
                                                          .Some(te) =>
                                                            match(te,
                                                              .Atom(type_tok) => type_tok.value.as_str(),
                                                              .FnCall(_, _, _, _) => ""
                                                            ),
                                                          .None => ""
                                                        );
                                                        param_type_names_f.push(String.from(ptn_s));
                                                      },
                                                      .FnCall(ct_box, ct_args, _, _) =>
                                                        match(extract_comptime_param_name(ct_box, ct_args),
                                                          .Some(ct_name) => {
                                                            params_f.push(ct_name);
                                                            param_type_names_f.push(String.from(""));
                                                          },
                                                          .None => { param_ok = false; }
                                                        )
                                                    ),
                                                  .None => { param_ok = false; }
                                                ),
                                              (kw_tok.value.as_str() == "forall") =>
                                                // Forall param: extract generic name
                                                match(kw_args.get(usize(0)),
                                                  .Some(fa_expr) =>
                                                    match(fa_expr,
                                                      // Simple: forall(T)
                                                      .Atom(fa_tok) => {
                                                        forall_names_f.push(fa_tok.value);
                                                      },
                                                      // Constrained: forall(T: Constraint)
                                                      .FnCall(fa_c_box, fa_c_args, _, _) =>
                                                        match(fa_c_box.*,
                                                          .Atom(fa_c_tok) =>
                                                            cond(
                                                              (fa_c_tok.value.as_str() == ":") =>
                                                                match(fa_c_args.get(usize(0)),
                                                                  .Some(fa_name_e) =>
                                                                    match(fa_name_e,
                                                                      .Atom(fa_name_tok) => {
                                                                        forall_names_f.push(fa_name_tok.value);
                                                                      },
                                                                      .FnCall(_, _, _, _) => ()
                                                                    ),
                                                                  .None => ()
                                                                ),
                                                              true => ()
                                                            ),
                                                          .FnCall(_, _, _, _) => ()
                                                        )
                                                    ),
                                                  .None => { param_ok = false; }
                                                ),
                                              // using/where — skip
                                              true => ()
                                            ),
                                          .FnCall(_, _, _, _) => { param_ok = false; }
                                        ),
                                      .Atom(bare_tok) => {
                                        params_f.push(bare_tok.value);
                                        param_type_names_f.push(String.from(""));
                                      }
                                    ),
                                  .None => { param_ok = false; }
                                );
                                pi = (pi + usize(1));
                              };
                              // Only extract body after params validated (ownership)
                              cond(
                                (!(param_ok)) => Option(EvalResult).None,
                                true =>
                                  match(args.get(usize(0)),
                                    .None => Option(EvalResult).None,
                                    .Some(body_expr) => {
                                      // Capture current env for lexical scoping (Phase 3i).
                                      // __recur_fn is excluded — it is injected at call time.
                                      cap_names_f := ArrayList(String).new();
                                      cap_tys_f   := ArrayList(TypeValue).new();
                                      cap_vals_f  := ArrayList(EvalValue).new();
                                      n_cf := env.*.frames.len();
                                      (cfi : usize) = usize(0);
                                      while runtime((cfi < n_cf)), {
                                        match(env.*.frames.get(cfi),
                                          .Some(frame) => {
                                            n_cv := frame.variables.len();
                                            (cvi : usize) = usize(0);
                                            while runtime((cvi < n_cv)), {
                                              match(frame.variables.get(cvi),
                                                .Some(v) => {
                                                  cond(
                                                    (!(v.name.as_str() == "__recur_fn")) => {
                                                      cap_names_f.push(v.name);
                                                      cap_tys_f.push(v.ty);
                                                      cap_val_f := match(v.value,
                                                        .Some(actual) => actual,
                                                        .None => EvalValue.VarRef(v.name)
                                                      );
                                                      cap_vals_f.push(cap_val_f);
                                                    },
                                                    true => ()
                                                  );
                                                },
                                                .None => ()
                                              );
                                              cvi = (cvi + usize(1));
                                            };
                                          },
                                          .None => ()
                                        );
                                        cfi = (cfi + usize(1));
                                      };
                                      .Some(eval_result(
                                        .FuncVal(
                                          forall_names_f,
                                          params_f,
                                          param_type_names_f,
                                          box(body_expr),
                                          cap_names_f,
                                          cap_tys_f,
                                          cap_vals_f
                                        ),
                                        t_unit()
                                      ))
                                    }
                                  )
                              )
                            }
                          )
                        }
                      )
                  ),

                true => Option(EvalResult).None
              ),
            .FnCall(_, _, _, _) => Option(EvalResult).None
          )
        },
        .Atom(ftok) => {
          fval := ftok.value.as_str();
          cond(
            // -----------------------------------------------------------------
            // Unit expression: ()
            // -----------------------------------------------------------------
            ((fval == BK_TUPLE) && (args.len() == usize(0))) =>
              .Some(eval_result(.UnitVal, t_unit())),

            // -----------------------------------------------------------------
            // Begin block: { stmt1; stmt2; … }
            // -----------------------------------------------------------------
            (fval == BK_BEGIN) => {
              n := args.len();
              cond(
                (n == usize(0)) =>
                  .Some(eval_result(.UnitVal, t_unit())),
                true => {
                  _p := env.push_frame(true);
                  (last : Option(EvalResult)) = .Some(eval_result(.UnitVal, t_unit()));
                  (i : usize) = usize(0);
                  (had_error : bool) = false;
                  (returning : bool) = false;
                  while runtime((((i < n) && (!(had_error))) && (!(returning)))), {
                    match(args.get(i),
                      .Some(stmt) =>
                        match(recur(stmt, env),
                          .Some(r) => {
                            last = .Some(r);
                            match(r.value,
                              .ReturnVal(_, _) => { returning = true; },
                              _ => ()
                            );
                          },
                          .None => { had_error = true; }
                        ),
                      .None => ()
                    );
                    i = (i + usize(1));
                  };
                  env.pop_frame();
                  cond(
                    had_error => Option(EvalResult).None,
                    true      => last  // returning=true: last=Some(ReturnVal(...)), propagate
                  )
                }
              )
            },

            // -----------------------------------------------------------------
            // cond(arm1, arm2, …)  where each arm is `cond_expr => body_expr`
            // -----------------------------------------------------------------
            (fval == "cond") => {
              n := args.len();
              (result : Option(EvalResult)) = Option(EvalResult).None;
              (i : usize) = usize(0);
              while runtime((i < n)), {
                match(args.get(i),
                  .Some(arm) =>
                    match(arm,
                      .FnCall(_, arm_args, _, _) =>
                        match(arm_args.get(usize(0)),
                          .Some(cond_expr) =>
                            match(recur(cond_expr, env),
                              .Some(cond_res) =>
                                match(cond_res.value,
                                  .BoolVal(b) =>
                                    cond(
                                      b => {
                                        match(arm_args.get(usize(1)),
                                          .Some(body_expr) => {
                                            result = recur(body_expr, env);
                                            i = n;
                                          },
                                          .None => { i = n; }
                                        )
                                      },
                                      true => ()
                                    ),
                                  _ => ()
                                ),
                              .None => ()
                            ),
                          .None => ()
                        ),
                      .Atom(_) => ()
                    ),
                  .None => ()
                );
                i = (i + usize(1));
              };
              result
            },

            // -----------------------------------------------------------------
            // Variable define: name := expr  or  (name : T) := expr
            // -----------------------------------------------------------------
            (is_infix && (fval == ":=")) =>
              cond(
                (args.len() < usize(2)) => Option(EvalResult).None,
                true =>
                  match(args.get(usize(0)),
                    .Some(lhs) =>
                      match(args.get(usize(1)),
                        .Some(rhs) =>
                          match(lhs,
                            // bare name: x := rhs  (type inferred from rhs)
                            .Atom(name_tok) =>
                              match(recur(rhs, env),
                                .Some(rhs_res) => {
                                  is_ct := value_is_comptime(rhs_res.value);
                                  _idx := env.define_val(
                                    name_tok.value,
                                    rhs_res.ty,
                                    is_ct,
                                    .Some(rhs_res.value)
                                  );
                                  .Some(eval_result(.UnitVal, t_unit()))
                                },
                                .None => Option(EvalResult).None
                              ),
                            // typed: (x : T) := rhs  — declare with explicit type
                            .FnCall(colon_box_a, colon_args_a, _, _) =>
                              match(colon_box_a.*,
                                .Atom(colon_tok_a) =>
                                  cond(
                                    (colon_tok_a.value.as_str() == ":") =>
                                      match(colon_args_a.get(usize(0)),
                                        .Some(name_expr_a) =>
                                          match(name_expr_a,
                                            .Atom(name_tok_a) =>
                                              match(recur(rhs, env),
                                                .Some(rhs_res) => {
                                                  decl_ty := match(colon_args_a.get(usize(1)),
                                                    .Some(te) => eval_type_annotation_expr(te),
                                                    .None     => rhs_res.ty
                                                  );
                                                  is_ct := value_is_comptime(rhs_res.value);
                                                  _idx := env.define_val(name_tok_a.value, decl_ty, is_ct, .Some(rhs_res.value));
                                                  .Some(eval_result(.UnitVal, t_unit()))
                                                },
                                                .None => Option(EvalResult).None
                                              ),
                                            .FnCall(_, _, _, _) => Option(EvalResult).None
                                          ),
                                        .None => Option(EvalResult).None
                                      ),
                                    true => Option(EvalResult).None
                                  ),
                                .FnCall(_, _, _, _) => Option(EvalResult).None
                              )
                          ),
                        .None => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  )
              ),

            // -----------------------------------------------------------------
            // Variable assign: name = expr  or  (name : T) = expr (declaration)
            // -----------------------------------------------------------------
            (is_infix && (fval == "=")) =>
              cond(
                (args.len() < usize(2)) => Option(EvalResult).None,
                true =>
                  match(args.get(usize(0)),
                    .Some(lhs) =>
                      match(args.get(usize(1)),
                        .Some(rhs) =>
                          match(lhs,
                            // bare name: x = rhs  (mutation of existing binding)
                            .Atom(name_tok) =>
                              match(recur(rhs, env),
                                .Some(rhs_res) => {
                                  _found := env.set_value(
                                    name_tok.value,
                                    rhs_res.value
                                  );
                                  .Some(eval_result(.UnitVal, t_unit()))
                                },
                                .None => Option(EvalResult).None
                              ),
                            // typed: (x : T) = rhs  — typed variable declaration
                            .FnCall(colon_box_b, colon_args_b, _, _) =>
                              match(colon_box_b.*,
                                .Atom(colon_tok_b) =>
                                  cond(
                                    (colon_tok_b.value.as_str() == ":") =>
                                      match(colon_args_b.get(usize(0)),
                                        .Some(name_expr_b) =>
                                          match(name_expr_b,
                                            .Atom(name_tok_b) =>
                                              match(recur(rhs, env),
                                                .Some(rhs_res) => {
                                                  decl_ty := match(colon_args_b.get(usize(1)),
                                                    .Some(te) => eval_type_annotation_expr(te),
                                                    .None     => rhs_res.ty
                                                  );
                                                  is_ct := value_is_comptime(rhs_res.value);
                                                  _idx := env.define_val(name_tok_b.value, decl_ty, is_ct, .Some(rhs_res.value));
                                                  .Some(eval_result(.UnitVal, t_unit()))
                                                },
                                                .None => Option(EvalResult).None
                                              ),
                                            .FnCall(_, _, _, _) => Option(EvalResult).None
                                          ),
                                        .None => Option(EvalResult).None
                                      ),
                                    true => Option(EvalResult).None
                                  ),
                                .FnCall(_, _, _, _) => Option(EvalResult).None
                              )
                          ),
                        .None => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  )
              ),

            // -----------------------------------------------------------------
            // Arithmetic operators: + - * / %  (comptime_int only)
            // -----------------------------------------------------------------
            (is_infix && (((((fval == "+") || (fval == "-")) || (fval == "*")) || (fval == "/")) || (fval == "%"))) => {
              lhs_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rhs_expr := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              lv := match(recur(lhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rv := match(recur(rhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              // Fold int × int (comptime or typed); result preserves lv type
              cond(
                (is_eval_int_type(lv.ty) && is_eval_int_type(rv.ty)) => {
                  lv_ty := lv.ty;
                  a_raw := match(lv.value, .IntLit(raw) => raw, _ => { return Option(EvalResult).None; });
                  b_raw := match(rv.value, .IntLit(raw) => raw, _ => { return Option(EvalResult).None; });
                  a := match(parse_raw_int(a_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  b := match(parse_raw_int(b_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  res_opt := cond(
                    (fval == "+") => Option(i64).Some((a + b)),
                    (fval == "-") => Option(i64).Some((a - b)),
                    (fval == "*") => Option(i64).Some((a * b)),
                    (fval == "/") => cond((b == i64(0)) => Option(i64).None, true => Option(i64).Some((a / b))),
                    (fval == "%") => cond((b == i64(0)) => Option(i64).None, true => Option(i64).Some((a % b))),
                    true => Option(i64).None
                  );
                  match(res_opt,
                    .Some(res) => .Some(eval_result(.IntLit(res.to_string()), lv_ty)),
                    .None => Option(EvalResult).None
                  )
                },
                // Fold float × float (comptime or typed); result preserves lv type
                (is_eval_float_type(lv.ty) && is_eval_float_type(rv.ty)) =>
                  eval_float_arith(fval, lv, rv),
                true => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Comparison operators: == != < > <= >=
            // Handles comptime_int × comptime_int and bool × bool (== / !=)
            // -----------------------------------------------------------------
            (is_infix && (((((fval == "==") || (fval == "!=")) || (fval == "<")) || (fval == ">")) || ((fval == "<=") || (fval == ">=")))) => {
              lhs_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rhs_expr := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              lv := match(recur(lhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rv := match(recur(rhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              cond(
                // int × int (comptime or typed)
                (is_eval_int_type(lv.ty) && is_eval_int_type(rv.ty)) => {
                  a_raw := match(lv.value, .IntLit(raw) => raw, _ => { return Option(EvalResult).None; });
                  b_raw := match(rv.value, .IntLit(raw) => raw, _ => { return Option(EvalResult).None; });
                  a := match(parse_raw_int(a_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  b := match(parse_raw_int(b_raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  res := cond(
                    (fval == "==") => (a == b),
                    (fval == "!=") => (!(a == b)),
                    (fval == "<")  => (a < b),
                    (fval == ">")  => (a > b),
                    (fval == "<=") => (a <= b),
                    (fval == ">=") => (a >= b),
                    true           => { return Option(EvalResult).None; }
                  );
                  .Some(eval_result(.BoolVal(res), t_bool()))
                },
                // bool × bool (== and != only)
                (((type_value_tag(lv.ty) == TypeTag.TBool) && (type_value_tag(rv.ty) == TypeTag.TBool)) && ((fval == "==") || (fval == "!="))) => {
                  la := match(lv.value, .BoolVal(b) => b, _ => { return Option(EvalResult).None; });
                  rb := match(rv.value, .BoolVal(b) => b, _ => { return Option(EvalResult).None; });
                  res := cond((fval == "==") => (la == rb), true => (!(la == rb)));
                  .Some(eval_result(.BoolVal(res), t_bool()))
                },
                // str × str (== and != only)
                (((type_value_tag(lv.ty) == TypeTag.TComptimeString) && (type_value_tag(rv.ty) == TypeTag.TComptimeString)) && ((fval == "==") || (fval == "!="))) => {
                  la_str := match(lv.value, .StrLit(s) => s, _ => { return Option(EvalResult).None; });
                  rb_str := match(rv.value, .StrLit(s) => s, _ => { return Option(EvalResult).None; });
                  res := cond((fval == "==") => (la_str.as_str() == rb_str.as_str()), true => (!(la_str.as_str() == rb_str.as_str())));
                  .Some(eval_result(.BoolVal(res), t_bool()))
                },
                // float × float
                (is_eval_float_type(lv.ty) && is_eval_float_type(rv.ty)) =>
                  eval_float_cmp(fval, lv, rv),
                true => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Boolean &&  (short-circuit: skip RHS when LHS is false)
            // -----------------------------------------------------------------
            (is_infix && (fval == "&&")) => {
              lhs_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rhs_expr := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              lv := match(recur(lhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              match(lv.value,
                .BoolVal(b) =>
                  cond(
                    (!(b)) => .Some(eval_result(.BoolVal(false), t_bool())),
                    true => {
                      rv := match(recur(rhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
                      match(rv.value,
                        .BoolVal(rb) => .Some(eval_result(.BoolVal(rb), t_bool())),
                        _ => Option(EvalResult).None
                      )
                    }
                  ),
                _ => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Boolean ||  (short-circuit: skip RHS when LHS is true)
            // -----------------------------------------------------------------
            (is_infix && (fval == "||")) => {
              lhs_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              rhs_expr := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              lv := match(recur(lhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              match(lv.value,
                .BoolVal(b) =>
                  cond(
                    b => .Some(eval_result(.BoolVal(true), t_bool())),
                    true => {
                      rv := match(recur(rhs_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
                      match(rv.value,
                        .BoolVal(rb) => .Some(eval_result(.BoolVal(rb), t_bool())),
                        _ => Option(EvalResult).None
                      )
                    }
                  ),
                _ => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Unary ! — logical negation of bool
            // -----------------------------------------------------------------
            ((!(is_infix)) && ((fval == "!") && (args.len() == usize(1)))) => {
              expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              v := match(recur(expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              match(v.value,
                .BoolVal(b) => .Some(eval_result(.BoolVal(!(b)), t_bool())),
                _ => Option(EvalResult).None
              )
            },

            // -----------------------------------------------------------------
            // Unary - — negation of comptime_int
            // -----------------------------------------------------------------
            ((!(is_infix)) && ((fval == "-") && (args.len() == usize(1)))) => {
              expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
              v := match(recur(expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
              cond(
                is_eval_int_type(v.ty) => {
                  v_ty := v.ty;
                  match(v.value,
                    .IntLit(raw) => {
                      a := match(parse_raw_int(raw), .Some(x) => x, .None => { return Option(EvalResult).None; });
                      .Some(eval_result(.IntLit((i64(0) - a).to_string()), v_ty))
                    },
                    _ => Option(EvalResult).None
                  )
                },
                is_eval_float_type(v.ty) => eval_float_neg(v),
                true => Option(EvalResult).None
              )
            },

            // ---------------------------------------------------------------
            // Dot operator: field access, method calls, and enum variant
            // construction (both TS-parser and self-hosted-parser AST forms).
            //
            // Field access / method call (is_infix=true, 2 args):
            //   FnCall(Atom(Dot), [receiver_expr, field_or_method_expr], true)
            //
            // Fieldless variant — TS format (is_infix=true, 1 Atom arg):
            //   FnCall(Atom(Dot), [Atom("None")], true)
            //
            // Variant with fields — self-hosted format (is_infix=false, 1 FnCall arg):
            //   FnCall(Atom(Dot), [FnCall(Atom("Some"), [arg1, …], false)], false)
            // ---------------------------------------------------------------
            (fval == ".") => {
              cond(
                // --- Field access or method call: is_infix=true, 2 args ---
                ((is_infix) && (args.len() == usize(2))) => {
                  recv_expr := match(args.get(usize(0)), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  rhs := match(args.get(usize(1)), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  recv_res := match(recur(recv_expr, env), .Some(x) => x, .None => { return Option(EvalResult).None; });
                  match(recv_res.value,
                    .StructVal(_, fnames, fvals) =>
                      match(rhs,
                        // Field access: receiver.field_name
                        .Atom(field_tok) => {
                          field_name := field_tok.value.as_str();
                          n_f := fnames.len();
                          (fi : usize) = usize(0);
                          (found_v : Option(EvalValue)) = Option(EvalValue).None;
                          (found_done : bool) = false;
                          while runtime(((fi < n_f) && (!(found_done)))), {
                            match(fnames.get(fi),
                              .Some(fn_s) => {
                                cond(
                                  (fn_s.as_str() == field_name) => {
                                    match(fvals.get(fi),
                                      .Some(fv) => {
                                        found_v = .Some(fv);
                                        found_done = true;
                                      },
                                      .None => ()
                                    );
                                  },
                                  true => ()
                                );
                              },
                              .None => ()
                            );
                            fi = (fi + usize(1));
                          };
                          match(found_v,
                            .Some(fv) => .Some(eval_result(fv, type_of_eval_value(fv))),
                            .None => Option(EvalResult).None
                          )
                        },
                        // Method call on struct: receiver.method(args)  — Phase 3j
                        // Delegated to handle_method_dispatch to keep evaluate's frame small.
                        .FnCall(method_func_box, method_call_args, _, _) =>
                          handle_method_dispatch(recv_res.value, method_func_box, method_call_args, env),
                        _ => Option(EvalResult).None
                      ),
                    _ => Option(EvalResult).None
                  )
                },

                // --- Enum variant construction: 1 arg ---
                // Fieldless (Atom arg): both TS and self-hosted formats
                // With fields (FnCall arg): self-hosted format only
                (args.len() == usize(1)) => {
                  match(args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(vne) =>
                      match(vne,
                        // Fieldless: .None, .True, etc. — Atom arg
                        .Atom(vntok) => {
                          variant_str := `.${ vntok.value }`;
                          ev_fields := ArrayList(EvalValue).new();
                          .Some(eval_result(.EnumVal(variant_str, ev_fields), t_unit()))
                        },
                        // With fields — self-hosted format: .Some(42) etc.
                        // FnCall(Atom(Dot), [FnCall(Atom("Some"), [Atom("42")], false)], false)
                        .FnCall(vfunc, vargs, _, _) => {
                          vname := match(vfunc.*,
                            .Atom(vntok) => vntok.value.as_str(),
                            .FnCall(_, _, _, _) => { return Option(EvalResult).None; }
                          );
                          variant_str := `.${ String.from(vname) }`;
                          ev_fields := ArrayList(EvalValue).new();
                          n_vargs := vargs.len();
                          (vi : usize) = usize(0);
                          (vok : bool) = true;
                          while runtime(((vi < n_vargs) && vok)), {
                            match(vargs.get(vi),
                              .Some(varg_expr) =>
                                match(recur(varg_expr, env),
                                  .Some(vr) => { ev_fields.push(vr.value); },
                                  .None => { vok = false; }
                                ),
                              .None => { vok = false; }
                            );
                            vi = (vi + usize(1));
                          };
                          cond(
                            (!(vok)) => Option(EvalResult).None,
                            true => .Some(eval_result(.EnumVal(variant_str, ev_fields), t_unit()))
                          )
                        }
                      )
                  )
                },

                true => Option(EvalResult).None
              )
            },

            // ---------------------------------------------------------------
            // `match(scrutinee, arm1, …)` pattern matching
            // Each arm is FnCall(Atom("=>"), [pattern, body], is_infix=true)
            // ---------------------------------------------------------------
            (fval == "match") => {
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(scrutinee_expr) => {
                  match(recur(scrutinee_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(scrut_res) => {
                      n_arms := args.len();
                      (arm_i : usize) = usize(1);
                      (match_result : Option(EvalResult)) = Option(EvalResult).None;
                      (matched : bool) = false;
                      while runtime(((arm_i < n_arms) && (!(matched)))), {
                        match(args.get(arm_i),
                          .Some(arm_expr) =>
                            match(arm_expr,
                              // Each arm: FnCall(Atom("=>"), [pattern, body], _)
                              .FnCall(arrow_func, arm_sub, _, _) =>
                                match(arrow_func.*,
                                  .Atom(arrtok) =>
                                    cond(
                                      (!(arrtok.value.as_str() == "=>")) => (),
                                      true => {
                                        match(arm_sub.get(usize(0)),
                                          .None => (),
                                          .Some(pat_expr) => {
                                            env.push_frame(false);
                                            (did_match : bool) = try_match_pat(pat_expr, scrut_res.value, scrut_res.ty, env);
                                            cond(
                                              (!(did_match)) => { env.pop_frame(); },
                                              true => {
                                                match(arm_sub.get(usize(1)),
                                                  .None => {
                                                    env.pop_frame();
                                                  },
                                                  .Some(body_expr) => {
                                                    match(recur(body_expr, env),
                                                      .None => {
                                                        env.pop_frame();
                                                      },
                                                      .Some(body_res) => {
                                                        env.pop_frame();
                                                        match_result = .Some(body_res);
                                                        matched = true;
                                                      }
                                                    );
                                                  }
                                                );
                                              }
                                            );
                                          }
                                        );
                                      }
                                    ),
                                  .FnCall(_, _, _, _) => ()
                                ),
                              .Atom(_) => ()
                            ),
                          .None => ()
                        );
                        arm_i = (arm_i + usize(1));
                      };
                      match_result
                    }
                  )
                }
              )
            },

            // ---------------------------------------------------------------
            // `while condition, body`
            // Compile-time while loop: condition must fold to BoolVal.
            // `while runtime(true), body` handled: runtime(...) is unwrapped.
            // ---------------------------------------------------------------
            (fval == "while") => {
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(raw_cond) => {
                  match(args.get(usize(1)),
                    .None => Option(EvalResult).None,
                    .Some(body_expr) => {
                      // Unwrap `runtime(cond_inner)` wrapper if present
                      cond_expr := match(raw_cond,
                        .FnCall(rt_func, rt_args, _, _) =>
                          match(rt_func.*,
                            .Atom(rttok) =>
                              cond(
                                (rttok.value.as_str() == "runtime") =>
                                  match(rt_args.get(usize(0)),
                                    .Some(inner) => inner,
                                    .None => raw_cond
                                  ),
                                true => raw_cond
                              ),
                            .FnCall(_, _, _, _) => raw_cond
                          ),
                        .Atom(_) => raw_cond
                      );
                      (last : EvalResult) = eval_result(.UnitVal, t_unit());
                      (keep_going : bool) = true;
                      (iter_count : i64) = i64(0);
                      while runtime(keep_going), {
                        cond(
                          (iter_count >= i64(10000)) => { keep_going = false; },
                          true => {
                            match(recur(cond_expr, env),
                              .None => { keep_going = false; },
                              .Some(cv) =>
                                match(cv.value,
                                  .BoolVal(b) =>
                                    cond(
                                      (!(b)) => { keep_going = false; },
                                      true => {
                                        match(recur(body_expr, env),
                                          .None => { keep_going = false; },
                                          .Some(bv) => {
                                            last = bv;
                                            match(bv.value,
                                              .ReturnVal(_, _) => { keep_going = false; },
                                              _ => ()
                                            );
                                          }
                                        );
                                        iter_count = (iter_count + i64(1));
                                      }
                                    ),
                                  _ => { keep_going = false; }
                                )
                            );
                          }
                        );
                      };
                      .Some(last)
                    }
                  )
                }
              )
            },

            // -----------------------------------------------------------------
            // Type casts: i32(x), u64(x), usize(x), f32(x), bool(x), etc.
            // For numeric/bool literals, just retag the type; value unchanged.
            // Other values are passed through with the new type tag.
            // -----------------------------------------------------------------
            (((args.len() == usize(1)) && is_primitive_type_cast(fval))) =>
              match(args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(arg_expr) =>
                  match(recur(arg_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(arg_res) => {
                      cast_ty := type_from_name(fval);
                      .Some(eval_result(arg_res.value, cast_ty))
                    }
                  )
              ),

            // -----------------------------------------------------------------
            // return expr — emit a ReturnVal signal
            // -----------------------------------------------------------------
            (fval == "return") => {
              cond(
                (args.len() == usize(0)) =>
                  .Some(eval_result(.ReturnVal(box(.UnitVal), t_unit()), t_unit())),
                true =>
                  match(args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(ret_expr) =>
                      match(recur(ret_expr, env),
                        .None => Option(EvalResult).None,
                        .Some(ret_res) =>
                          .Some(eval_result(
                            .ReturnVal(box(ret_res.value), ret_res.ty),
                            t_unit()
                          ))
                      )
                  )
              )
            },

            // -----------------------------------------------------------------
            // recur — tail/recursive call to the currently-executing FuncVal.
            // Looks up __recur_fn bound when the current function frame was opened.
            // Delegates to call_funcval_with_args for env setup + forall inference.
            // -----------------------------------------------------------------
            (fval == "recur") => {
              match(env.*.lookup(String.from("__recur_fn")),
                .None => Option(EvalResult).None,
                .Some(rfv) =>
                  match(rfv.value,
                    .None => Option(EvalResult).None,
                    .Some(func_val_r) =>
                      match(func_val_r,
                        .FuncVal(_, _, _, _, _, _, _) => {
                          evaled_r := ArrayList(EvalResult).new();
                          n_recur_args := args.len();
                          (ri : usize) = usize(0);
                          (rok : bool) = true;
                          while runtime(((ri < n_recur_args) && rok)), {
                            match(args.get(ri),
                              .Some(arg_expr) =>
                                match(recur(arg_expr, env),
                                  .Some(r) => { evaled_r.push(r); },
                                  .None    => { rok = false; }
                                ),
                              .None => { rok = false; }
                            );
                            ri = (ri + usize(1));
                          };
                          cond(
                            (!(rok)) => Option(EvalResult).None,
                            true => call_funcval_with_args(func_val_r, evaled_r)
                          )
                        },
                        _ => Option(EvalResult).None
                      )
                  )
              )
            },

            // -----------------------------------------------------------------
            // :: constant declaration.
            // name :: expr  — simple binding.
            // { A, B } :: expr — destructuring binding (from Module or Struct).
            // -----------------------------------------------------------------
            (is_infix && (fval == "::")) =>
              cond(
                (args.len() < usize(2)) => Option(EvalResult).None,
                true =>
                  match(args.get(usize(0)),
                    .Some(lhs) =>
                      match(args.get(usize(1)),
                        .Some(rhs) =>
                          match(lhs,
                            // Simple: name :: rhs
                            .Atom(name_tok) =>
                              match(recur(rhs, env),
                                .Some(rhs_res) => {
                                  _idx := env.define_val(
                                    name_tok.value,
                                    rhs_res.ty,
                                    true,  // :: is always comptime
                                    .Some(rhs_res.value)
                                  );
                                  .Some(eval_result(.UnitVal, t_unit()))
                                },
                                .None => Option(EvalResult).None
                              ),
                            // Destructuring: { A, B, … } :: rhs (anon-struct LHS)
                            .FnCall(lhs_fb, lhs_args, _, _) =>
                              match(lhs_fb.*,
                                .Atom(lhs_tok) =>
                                  cond(
                                    (lhs_tok.value.as_str() == BK_ANON_STRUCT) =>
                                      match(recur(rhs, env),
                                        .Some(rhs_res) =>
                                          match(rhs_res.value,
                                            // Destructure a ModuleVal
                                            .ModuleVal(mnames, mvals) => {
                                              (di : usize) = usize(0);
                                              dn := lhs_args.len();
                                              (dok : bool) = true;
                                              while runtime(((di < dn) && dok)), {
                                                match(lhs_args.get(di),
                                                  .Some(name_expr) =>
                                                    match(name_expr,
                                                      .Atom(req_tok) => {
                                                        // Find the requested name in the module
                                                        (dj : usize) = usize(0);
                                                        dm := mnames.len();
                                                        (dfound : bool) = false;
                                                        while runtime(((dj < dm) && (!dfound))), {
                                                          match(mnames.get(dj),
                                                            .Some(mname) =>
                                                              cond(
                                                                (mname.as_str() == req_tok.value.as_str()) => {
                                                                  match(mvals.get(dj),
                                                                    .Some(mval) => {
                                                                      _didx := env.define_val(
                                                                        req_tok.value,
                                                                        type_of_eval_value(mval),
                                                                        true,
                                                                        .Some(mval)
                                                                      );
                                                                      dfound = true;
                                                                    },
                                                                    .None => { dok = false; }
                                                                  );
                                                                },
                                                                true => ()
                                                              ),
                                                            .None => ()
                                                          );
                                                          dj = (dj + usize(1));
                                                        };
                                                        cond(
                                                          (!dfound) => { dok = false; },
                                                          true => ()
                                                        );
                                                      },
                                                      .FnCall(_, _, _, _) => { dok = false; }
                                                    ),
                                                  .None => { dok = false; }
                                                );
                                                di = (di + usize(1));
                                              };
                                              cond(
                                                dok  => .Some(eval_result(.UnitVal, t_unit())),
                                                true => Option(EvalResult).None
                                              )
                                            },
                                            _ => Option(EvalResult).None
                                          ),
                                        .None => Option(EvalResult).None
                                      ),
                                    true => Option(EvalResult).None
                                  ),
                                .FnCall(_, _, _, _) => Option(EvalResult).None
                              )
                          ),
                        .None => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  )
              ),

            // -----------------------------------------------------------------
            // import("path") — Phase 3m
            // Calls g_module_loader with the path string (stripped of quotes).
            // Returns the ModuleVal provided by the loader.
            // -----------------------------------------------------------------
            (fval == BK_IMPORT) =>
              match(args.get(usize(0)),
                .Some(path_expr) =>
                  match(path_expr,
                    .Atom(path_tok) => {
                      raw := path_tok.value.as_str();
                      rn  := raw.len();
                      cond(
                        (rn < usize(2)) => Option(EvalResult).None,
                        true => {
                          path_str := String.from(raw).substring(usize(1), (rn - usize(1)));
                          match(g_module_loader,
                            .None => Option(EvalResult).None,
                            .Some(loader) =>
                              match(loader(path_str),
                                .None => Option(EvalResult).None,
                                .Some(mod_val) =>
                                  .Some(eval_result(mod_val, t_unit()))
                              )
                          )
                        }
                      )
                    },
                    .FnCall(_, _, _, _) => Option(EvalResult).None
                  ),
                .None => Option(EvalResult).None
              ),

            // -----------------------------------------------------------------
            // open(module_expr) — Phase 3m
            // Evaluates its argument to a ModuleVal, then binds every exported
            // name into the current environment as a comptime constant.
            // -----------------------------------------------------------------
            (fval == BK_OPEN) =>
              match(args.get(usize(0)),
                .Some(mod_expr) =>
                  match(recur(mod_expr, env),
                    .Some(mod_res) =>
                      match(mod_res.value,
                        .ModuleVal(mnames, mvals) => {
                          (oi : usize) = usize(0);
                          on := mnames.len();
                          while runtime((oi < on)), {
                            match(mnames.get(oi),
                              .Some(mname) =>
                                match(mvals.get(oi),
                                  .Some(mval) => {
                                    _oidx := env.define_val(
                                      mname,
                                      type_of_eval_value(mval),
                                      true,
                                      .Some(mval)
                                    );
                                  },
                                  .None => ()
                                ),
                              .None => ()
                            );
                            oi = (oi + usize(1));
                          };
                          .Some(eval_result(.UnitVal, t_unit()))
                        },
                        _ => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  ),
                .None => Option(EvalResult).None
              ),

            // -----------------------------------------------------------------
            // General identifier: struct construction or FuncVal call.
            //
            // Struct construction (all args are named `:` infix calls):
            //   TypeName(field1: val1, field2: val2, …) → StructVal
            //
            // FuncVal call: look up identifier, check arity, run body.
            // Arity mismatch or unbound identifier → None.
            // -----------------------------------------------------------------

            // -----------------------------------------------------------------
            // `if(cond, then)` or `if(cond, then, else)` — conditional expr.
            // 2-arg: returns UnitVal when condition is false.
            // 3-arg: evaluates else branch when condition is false.
            // Returns None when the condition does not fold to a Bool.
            // -----------------------------------------------------------------
            (fval == "if") => handle_if_form(args, env),

            // -----------------------------------------------------------------
            // impl(TypeName, method_name : fn_def, …) — Phase 3j
            // Delegated to handle_impl_form to keep evaluate's frame small.
            // -----------------------------------------------------------------
            (fval == "impl") => handle_impl_form(args, env),

            true => {
              // Detect struct construction: first arg is a `:` infix call (named field)
              is_struct_ctor := match(args.get(usize(0)),
                .Some(a0) =>
                  match(a0,
                    .FnCall(a0f, _, a0infix, _) =>
                      cond(
                        a0infix =>
                          match(a0f.*,
                            .Atom(a0tok) => (a0tok.value.as_str() == ":"),
                            .FnCall(_, _, _, _) => false
                          ),
                        true => false
                      ),
                    .Atom(_) => false
                  ),
                .None => false
              );
              cond(
                is_struct_ctor => {
                  fn_list := ArrayList(String).new();
                  fv_list := ArrayList(EvalValue).new();
                  n_named := args.len();
                  (si : usize) = usize(0);
                  (sok : bool) = true;
                  while runtime(((si < n_named) && sok)), {
                    match(args.get(si),
                      .Some(arg_e) =>
                        match(arg_e,
                          .FnCall(_, na, _, _) =>
                            match(na.get(usize(0)),
                              .Some(ne) =>
                                match(ne,
                                  .Atom(ntok) =>
                                    match(na.get(usize(1)),
                                      .Some(ve) =>
                                        match(recur(ve, env),
                                          .Some(vr) => {
                                            fn_list.push(ntok.value);
                                            fv_list.push(vr.value);
                                          },
                                          .None => { sok = false; }
                                        ),
                                      .None => { sok = false; }
                                    ),
                                  .FnCall(_, _, _, _) => { sok = false; }
                                ),
                              .None => { sok = false; }
                            ),
                          .Atom(_) => { sok = false; }
                        ),
                      .None => { sok = false; }
                    );
                    si = (si + usize(1));
                  };
                  cond(
                    (!(sok)) => Option(EvalResult).None,
                    true => .Some(eval_result(.StructVal(String.from(fval), fn_list, fv_list), t_unit()))
                  )
                },
                true => {
                  match(env.*.lookup(String.from(fval)),
                .None => Option(EvalResult).None,
                .Some(var) =>
                  match(var.value,
                    .None => Option(EvalResult).None,
                    .Some(func_val) =>
                      match(func_val,
                        .FuncVal(_, _, _, _, _, _, _) => {
                          evaled_g := ArrayList(EvalResult).new();
                          n_gargs := args.len();
                          (gi : usize) = usize(0);
                          (gok : bool) = true;
                          while runtime(((gi < n_gargs) && gok)), {
                            match(args.get(gi),
                              .Some(arg_expr) =>
                                match(recur(arg_expr, env),
                                  .Some(r) => { evaled_g.push(r); },
                                  .None    => { gok = false; }
                                ),
                              .None => { gok = false; }
                            );
                            gi = (gi + usize(1));
                          };
                          cond(
                            (!(gok)) => Option(EvalResult).None,
                            true => call_funcval_with_args(func_val, evaled_g)
                          )
                        },
                        _ => Option(EvalResult).None
                      )
                  )
              )
                }
              )
            }
          )
        }
      )
  )
});

// Initialize the g_eval_fn slot with the evaluate function (Phase 3j).
// Must run after evaluate is defined so the reference is valid.
// Returns bool to avoid 'void' C variable error from unit return type.
_eval_fn_init := (fn() -> bool)({
  g_eval_fn = .Some(evaluate);
  true
})();

/// Register a module loader callback for `import "path"` expressions (Phase 3m).
/// When set, `import "path"` will call `loader(path)` and return the result.
/// Call this before evaluating any module that uses imports.
/// Typically called once at program startup (or in tests for mocking).
set_module_loader :: (fn(loader : (fn(path : String) -> Option(EvalValue))) -> unit)({
  g_module_loader = .Some(loader);
});

export evaluate, eval_atom, eval_identifier, parse_raw_int, evaluate_module_body, set_module_loader;


