                          n_f := fnames.len();
                          (fi : usize) = usize(0);
                          (found_v : Option(EvalValue)) = Option(EvalValue).None;
                          (found_done : bool) = false;
                          while((fi < n_f) && (!(found_done)), {
                            match(
                              fnames.get(fi),
                              .Some(fn_s) => {
                                cond(
                                  (fn_s == field_name) => {
                                    match(
                                      fvals.get(fi),
                                      .Some(fv) => {
                                        found_v =.Some(fv);
                                        found_done = true;
                                      },
                                      .None => ()
                                    );
                                  },
                                  true => ()
                                );
                              },
                              .None => ()
                            );
                            fi = (fi + usize(1));
                          });
                          match(
                            found_v,
                            .Some(fv) =>.Some(eval_result(fv, type_of_eval_value(fv))),
                            .None => Option(EvalResult).None
                          )
                        },
                        // Method call on struct: receiver.method(args)  — Phase 3j
                        // Delegated to handle_method_dispatch to keep evaluate's frame small.
                        .FnCall(_, method_func_box, method_call_args, _, _) =>
                          handle_method_dispatch(recv_res.value, method_func_box, method_call_args, env),
                        _ => Option(EvalResult).None
                      ),
                    // Phase 3al fix: method calls on non-StructVal receivers
                    // (TypeVal for static methods, StrLit/IntLit/etc. for instance shims).
                    // Dispatch to handle_method_dispatch which has shims for these types.
                    // Phase 3am: also handle val.* (PtrVal dereference) here.
                    // Phase 5ap: TypeVal.VariantName — construct fieldless enum variant.
                    _ =>
                      match(
                        rhs,
                        // val.* — dereference a PtrVal (Phase 3am)
                        .Atom(_, deref_tok) =>
                          cond(
                            (deref_tok.value == "*") =>
                              match(
                                recv_res.value,
                                .PtrVal(inner_box, _) =>
                                  .Some(eval_result(inner_box.*, type_of_eval_value(inner_box.*))),
                                _ => Option(EvalResult).None
                              ),
                            true =>
                              // Phase 5ap: TypeVal.VariantName — fieldless enum variant construction.
                              // Handles both:
                              //   - TypeVal(EnumT(...)): user-defined enum variants
                              //   - TypeVal(non-EnumT): built-in generic types like Option(T).None,
                              //     Result(T,E).None — these have no EnumT but still produce variants.
                              match(
                                recv_res.value,
                                .TypeVal(_) => {
                                  variant_str_tv := `.${deref_tok.value}`;
                                  ev_fields_tv := ArrayList(EvalValue).new();
                                  .Some(eval_result(.EnumVal(variant_str_tv, ev_fields_tv), t_unit()))
                                },
                                _ => Option(EvalResult).None
                              )
                          ),
                        .FnCall(_, method_func_box2, method_call_args2, _, _) =>
                          // Phase 5aq: TypeVal.Variant(args) — enum variant with data (TS format)
                          match(
                            recv_res.value,
                            .TypeVal(tv_box_fq) => match(
                              tv_box_fq,
                              .EnumT(_, _, _, _, _, _, _, _, _) => {
                                // Get variant name from method_func_box2
                                vname_tv2 := match(
                                  method_func_box2,
                                  .Atom(_, vntok2) => vntok2.value.clone(),
                                  _ => String.new()
                                );
                                cond(
                                  (vname_tv2 == "") => handle_method_dispatch(recv_res.value, method_func_box2, method_call_args2, env),
                                  true => {
                                    variant_str_tv2 := `.${vname_tv2}`;
                                    ev_fields_tv2 := ArrayList(EvalValue).new();
                                    n_tvargs := method_call_args2.len();
                                    (tvi : usize) = usize(0);
                                    (tvok : bool) = true;
                                    while((tvi < n_tvargs) && tvok, {
                                      match(
                                        method_call_args2.get(tvi),
                                        .Some(tvarg_expr) =>
                                          match(
                                            recur(tvarg_expr, env),
                                            .Some(tvr) => {
                                              ev_fields_tv2.push(tvr.value);
                                            },
                                            .None => {
                                              tvok = false;
                                            }
                                          ),
                                        .None => {
                                          tvok = false;
                                        }
                                      );
                                      tvi = (tvi + usize(1));
                                    });
                                    cond(
                                      (!(tvok)) => Option(EvalResult).None,
                                      true =>.Some(eval_result(.EnumVal(variant_str_tv2, ev_fields_tv2), t_unit()))
                                    )
                                  }
                                )
                              },
                              _ => handle_method_dispatch(recv_res.value, method_func_box2, method_call_args2, env)
                            ),
                            _ => handle_method_dispatch(recv_res.value, method_func_box2, method_call_args2, env)
                          ),
                        _ => Option(EvalResult).None
                      )
                  )
                },
                // --- Enum variant construction: 1 arg ---
                // Fieldless (Atom arg): both TS and self-hosted formats
                // With fields (FnCall arg): self-hosted format only
                (args.len() == usize(1)) =>
                  match(
                    args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(vne) =>
                      match(
                        vne,
                        // Fieldless: .None, .True, etc. — Atom arg
                        .Atom(_, vntok) => {
                          variant_str := `.${ vntok.value }`;
                          ev_fields := ArrayList(EvalValue).new();
                          .Some(eval_result(.EnumVal(variant_str, ev_fields), t_unit()))
                        },
                        // With fields — self-hosted format: .Some(42) etc.
                        // FnCall(Atom(Dot), [FnCall(Atom("Some"), [Atom("42")], false)], false)
                        .FnCall(_, vfunc, vargs, _, _) => {
                          vname := match(
                            vfunc,
                            .Atom(_, vntok) => vntok.value.clone(),
                            .FnCall(_, _, _, _, _) => {
                              return(Option(EvalResult).None);
                            }
                          );
                          variant_str := `.${ vname }`;
                          ev_fields := ArrayList(EvalValue).new();
                          n_vargs := vargs.len();
                          (vi : usize) = usize(0);
                          (vok : bool) = true;
                          while((vi < n_vargs) && vok, {
                            match(
                              vargs.get(vi),
                              .Some(varg_expr) =>
                                match(
                                  recur(varg_expr, env),
                                  .Some(vr) => {
                                    ev_fields.push(vr.value);
                                  },
                                  .None => {
                                    vok = false;
                                  }
                                ),
                              .None => {
                                vok = false;
                              }
                            );
                            vi = (vi + usize(1));
                          });
                          cond(
                            (!(vok)) => Option(EvalResult).None,
                            true =>.Some(eval_result(.EnumVal(variant_str, ev_fields), t_unit()))
                          )
                        }
                      )
                  ),
                true => Option(EvalResult).None
              ),
            // ---------------------------------------------------------------
            // `match(scrutinee, arm1, …)` pattern matching
            // Each arm is FnCall(Atom("=>"), [pattern, body], is_infix=true)
            // ---------------------------------------------------------------
            (fval == "match") =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(scrutinee_expr) =>
                  match(
                    recur(scrutinee_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(scrut_res) => {
                      n_arms := args.len();
                      (arm_i : usize) = usize(1);
                      (match_result : Option(EvalResult)) = Option(EvalResult).None;
                      (matched : bool) = false;
                      while((arm_i < n_arms) && (!(matched)), {
                        match(
                          args.get(arm_i),
                          .Some(arm_expr) =>
                            match(
                              arm_expr,
                              // Each arm: FnCall(Atom("=>"), [pattern, body], _)
                              .FnCall(_, arrow_func, arm_sub, _, _) =>
                                match(
                                  arrow_func,
                                  .Atom(_, arrtok) =>
                                    cond(
                                      (!(arrtok.value == "=>")) => (),
                                      true => {
                                        match(
                                          arm_sub.get(usize(0)),
                                          .None => (),
                                          .Some(pat_expr) => {
                                            env.push_frame(false);
                                            (did_match : bool) = try_match_pat(pat_expr, scrut_res.value, scrut_res.ty, env);
                                            cond(
                                              (!(did_match)) => {
                                                env.pop_frame();
                                              },
                                              true => {
                                                match(
                                                  arm_sub.get(usize(1)),
                                                  .None => {
                                                    env.pop_frame();
                                                  },
                                                  .Some(body_expr) => {
                                                    match(
                                                      recur(body_expr, env),
                                                      .None => {
                                                        env.pop_frame();
                                                      },
                                                      .Some(body_res) => {
                                                        env.pop_frame();
                                                        match_result =.Some(body_res);
                                                        matched = true;
                                                      }
                                                    );
                                                  }
                                                );
                                              }
                                            );
                                          }
                                        );
                                      }
                                    ),
                                  .FnCall(_, _, _, _, _) => ()
                                ),
                              .Atom(_, _) => ()
                            ),
                          .None => ()
                        );
                        arm_i = (arm_i + usize(1));
                      });
                      match_result
                    }
                  )
              ),
            // ---------------------------------------------------------------
            // `while condition, body`
            // Compile-time while loop: condition must fold to BoolVal.
            // `while(runtime(true), body)` handled: runtime(...) is unwrapped.
            // ---------------------------------------------------------------
            (fval == "while") =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(raw_cond) =>
                  match(
                    args.get(usize(1)),
                    .None => Option(EvalResult).None,
                    .Some(body_expr) => {
                      // Unwrap `runtime(cond_inner)` wrapper if present
                      cond_expr := match(
                        raw_cond,
                        .FnCall(_, rt_func, rt_args, _, _) =>
                          match(
                            rt_func,
                            .Atom(_, rttok) =>
                              cond(
                                (rttok.value == "runtime") =>
                                  match(
                                    rt_args.get(usize(0)),
                                    .Some(inner) => inner,
                                    .None => raw_cond
                                  ),
                                true => raw_cond
                              ),
                            .FnCall(_, _, _, _, _) => raw_cond
                          ),
                        .Atom(_, _) => raw_cond
                      );
                      (last : EvalResult) = eval_result(.UnitVal, t_unit());
                      (keep_going : bool) = true;
                      (iter_count : i64) = i64(0);
                      while(keep_going, {
                        cond(
                          (iter_count >= i64(10000)) => {
                            keep_going = false;
                          },
                          true => {
                            match(
                              recur(cond_expr, env),
                              .None => {
                                keep_going = false;
                              },
                              .Some(cv) =>
                                match(
                                  cv.value,
                                  .BoolVal(b) =>
                                    cond(
                                      (!(b)) => {
                                        keep_going = false;
                                      },
                                      true => {
                                        match(
                                          recur(body_expr, env),
                                          .None => {
                                            keep_going = false;
                                          },
                                          .Some(bv) => {
                                            last = bv;
                                            match(
                                              bv.value,
                                              .ReturnVal(_, _) => {
                                                keep_going = false;
                                              },
                                              .BreakVal => {
                                                keep_going = false;
                                              },
                                              .ContinueVal => (),
                                              _ => ()
                                            );
                                          }
                                        );
                                        iter_count = (iter_count + i64(1));
                                      }
                                    ),
                                  _ => {
                                    keep_going = false;
                                  }
                                )
                            );
                          }
                        );
                      });
                      .Some(match(last.value,.BreakVal => eval_result(.UnitVal, t_unit()),.ContinueVal => eval_result(.UnitVal, t_unit()), _ => last))
                    }
                  )
              ),
            // -----------------------------------------------------------------
            // Type casts: i32(x), u64(x), usize(x), f32(x), bool(x), etc.
            // For numeric/bool literals, just retag the type; value unchanged.
            // Other values are passed through with the new type tag.
            // -----------------------------------------------------------------
            ((args.len() == usize(1)) && is_primitive_type_cast(fval)) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(arg_expr) =>
                  match(
                    recur(arg_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(arg_res) => {
                      cast_ty := type_from_name(fval);
                      .Some(eval_result(arg_res.value, cast_ty))
                    }
                  )
              ),
            // -----------------------------------------------------------------
            // return expr — emit a ReturnVal signal
            // -----------------------------------------------------------------
            (fval == "return") =>
              cond(
                (args.len() == usize(0)) =>
                  .Some(eval_result(.ReturnVal(box(.UnitVal), t_unit()), t_unit())),
                true =>
                  match(
                    args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(ret_expr) =>
                      match(
                        recur(ret_expr, env),
                        .None => Option(EvalResult).None,
                        .Some(ret_res) =>
                          .Some(
                            eval_result(
                              .ReturnVal(box(ret_res.value), ret_res.ty),
                              t_unit()
                            )
                          )
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // unwind — in comptime context, acts same as return (discards continuation)
            // -----------------------------------------------------------------
            (fval == "unwind") =>
              cond(
                (args.len() == usize(0)) =>
                  .Some(eval_result(.ReturnVal(box(.UnitVal), t_unit()), t_unit())),
                true =>
                  match(
                    args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(esc_expr) =>
                      match(
                        recur(esc_expr, env),
                        .None => Option(EvalResult).None,
                        .Some(esc_res) =>
                          .Some(
                            eval_result(
                              .ReturnVal(box(esc_res.value), esc_res.ty),
                              t_unit()
                            )
                          )
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // break — emit a BreakVal signal to stop the nearest while/for loop
            // -----------------------------------------------------------------
            (fval == "break") =>
              .Some(eval_result(.BreakVal, t_unit())),
            // -----------------------------------------------------------------
            // continue — emit a ContinueVal signal to skip rest of loop body
            // -----------------------------------------------------------------
            (fval == "continue") =>
              .Some(eval_result(.ContinueVal, t_unit())),
            // -----------------------------------------------------------------
            // quote(expr) — wrap the argument AST in an ExprVal without
            // evaluating it.  This is the proto-evaluator's port of the
            // modular `evaluate_quote` builtin (src/evaluator/builtins/quote.ts).
            //
            // Splicing: any `unquote(name)` sub-expression inside the quoted
            // body is replaced at quote time by the AST stored in the
            // `ExprVal` value bound to `name` in the current environment.
            // (Splicing is implemented in `splice_unquote` below.)
            //
            // ⚠️ DIVERGENCE FROM TS REFERENCE COMPILER:
            // In TS, `quote` is dispatched through `evaluator/exprs/_expr.ts`
            // (the modular dispatcher).  yo-self has a modular dispatcher
            // (`evaluator/exprs/_expr.yo`) but `Evaluator.new` does not route
            // `evaluate_module_body` through it, so we implement `quote`
            // here in the proto-evaluator as a transitional bridge.  When
            // Phase 6.1a/b lands and the modular path becomes reachable,
            // this handler should be deleted in favor of the modular
            // `evaluate_quote`.  See issues/eval-for-loop-3arg-vs-2arg.md.
            // -----------------------------------------------------------------
            (fval == "quote") =>
              cond(
                (args.len() != usize(1)) => Option(EvalResult).None,
                true =>
                  match(
                    args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(quoted_expr) => {
                      spliced := splice_unquote(quoted_expr, env);
                      .Some(eval_result(.ExprVal(spliced), t_expr_t()))
                    }
                  )
              ),
            // -----------------------------------------------------------------
            // pragma(Pragma.X) — module directives. Their meaning is consumed
            // by AST pre-scans (`pre_scan_for_skip_prelude`) and the modular
            // dispatcher's pragma registry; in the proto-evaluator they
            // evaluate to unit so `evaluate_module_body` does not bail on a
            // leading `pragma(Pragma.SkipPrelude);` line.
            // -----------------------------------------------------------------
            (fval == "pragma") =>.Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // unquote(expr) — only valid inside a `quote(...)` body where it
            // is rewritten by `splice_unquote`.  If we reach here it means
            // the call appeared at top level; emit None to signal an error.
            // -----------------------------------------------------------------
            (fval == "unquote") => Option(EvalResult).None,
            // -----------------------------------------------------------------
            // gensym(prefix : str) -> Expr  (atom with unique identifier)
            // Used by macros like the prelude `for` to mint fresh variable
            // names. Mirrors `src/evaluator/builtins/gensym.ts`.
            // -----------------------------------------------------------------
            (fval == "gensym") =>
              cond(
                (args.len() != usize(1)) => Option(EvalResult).None,
                true =>
                  match(
                    args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(prefix_expr) =>
                      match(
                        recur(prefix_expr, env),
                        .None => Option(EvalResult).None,
                        .Some(prefix_res) => match(
                          prefix_res.value,
                          .StrLit(raw_pref) => {
                            n_pref := raw_pref.len();
                            inner_pref := cond(
                              (n_pref >= usize(2)) => raw_pref.substring(usize(1), n_pref - usize(1)),
                              true => raw_pref
                            );
                            uniq := random_id(String.from(""));
                            sym_name := ((inner_pref + String.from("_")) + uniq);
                            sym_tok := Token(
                              kind : TokenKind.Identifier,
                              value : sym_name,
                              row : usize(0),
                              column : usize(0),
                              character : usize(0),
                              module_path : String.from(""),
                              input : String.from("")
                            );
                            sym_expr := AstExpr.Atom(usize(0), sym_tok);
                            .Some(eval_result(.ExprVal(sym_expr), t_expr_t()))
                          },
                          _ => Option(EvalResult).None
                        )
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // for(item_pat, collection_expr, body_expr) — iterate over ArrayVal
            //
            // ⚠️ DIVERGENCE FROM TS REFERENCE COMPILER:
            // In real Yo, `for` is NOT a built-in. It is a 2-arg macro defined
            // in std/prelude.yo:    for(iter, x => body)
            // The proto-evaluator does not yet support macro expansion, so
            // this handler implements the 3-arg lowered form `for(x, arr, {body})`
            // directly as a built-in. Tests that exercise iteration via this
            // form rely on this handler. Once the proper Evaluator
            // (yo-self/evaluator/index.yo Evaluator.new) is wired into
            // `evaluate_module_body` and prelude loading is enabled, this
            // handler MUST be deleted and the corresponding tests migrated to
            // either the proper Evaluator path or to an explicit
            // `while` + `arr.get(i)` rewrite.
            //
            // See: issues/eval-for-loop-3arg-vs-2arg.md
            // -----------------------------------------------------------------
            (fval == "for") =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(item_pat) =>
                  match(
                    args.get(usize(1)),
                    .None => Option(EvalResult).None,
                    .Some(col_expr) =>
                      match(
                        args.get(usize(2)),
                        .None => Option(EvalResult).None,
                        .Some(body_expr) =>
                          match(
                            recur(col_expr, env),
                            .None => Option(EvalResult).None,
                            .Some(col_res) =>
                              match(
                                col_res.value,
                                .ArrayVal(elements) => {
                                  n_fe := elements.len();
                                  (fi : usize) = usize(0);
                                  (last_fe : EvalResult) = eval_result(.UnitVal, t_unit());
                                  (for_ok : bool) = true;
                                  while((fi < n_fe) && for_ok, {
                                    match(
                                      elements.get(fi),
                                      .None => {
                                        for_ok = false;
                                      },
                                      .Some(elem_val) => {
                                        env.push_frame(false);
                                        match(
                                          item_pat,
                                          .Atom(_, item_tok) => {
                                            _fidx := env.define_val(item_tok.value, type_of_eval_value(elem_val), false,.Some(elem_val));
                                          },
                                          .FnCall(_, _, _, _, _) => ()
                                        );
                                        match(
                                          recur(body_expr, env),
                                          .None => {
                                            env.pop_frame();
                                            for_ok = false;
                                          },
                                          .Some(body_res) => {
                                            env.pop_frame();
                                            last_fe = body_res;
                                            match(
                                              body_res.value,
                                              .ReturnVal(_, _) => {
                                                for_ok = false;
                                              },
                                              .BreakVal => {
                                                for_ok = false;
                                              },
                                              .ContinueVal => (),
                                              _ => ()
                                            );
                                          }
                                        );
                                      }
                                    );
                                    fi = (fi + usize(1));
                                  });
                                  .Some(match(last_fe.value,.BreakVal => eval_result(.UnitVal, t_unit()),.ContinueVal => eval_result(.UnitVal, t_unit()), _ => last_fe))
                                },
                                _ => Option(EvalResult).None
                              )
                          )
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // recur — tail/recursive call to the currently-executing FuncVal.
            // Looks up __recur_fn bound when the current function frame was opened.
            // Delegates to call_funcval_with_args for env setup + forall inference.
            // -----------------------------------------------------------------
            (fval == "recur") =>
              match(
                env.lookup(String.from("__recur_fn")),
                .None => Option(EvalResult).None,
                .Some(rfv) =>
                  match(
                    rfv.value,
                    .None => Option(EvalResult).None,
                    .Some(func_val_r) =>
                      match(
                        func_val_r,
                        .FuncVal(_, _) => {
                          evaled_r := ArrayList(EvalResult).new();
                          n_recur_args := args.len();
                          (ri : usize) = usize(0);
                          (rok : bool) = true;
                          while((ri < n_recur_args) && rok, {
                            match(
                              args.get(ri),
                              .Some(arg_expr) =>
                                match(
                                  recur(arg_expr, env),
                                  .Some(r) => {
                                    evaled_r.push(r);
                                  },
                                  .None => {
                                    rok = false;
                                  }
                                ),
                              .None => {
                                rok = false;
                              }
                            );
                            ri = (ri + usize(1));
                          });
                          cond(
                            (!(rok)) => Option(EvalResult).None,
                            true => call_funcval_with_args(func_val_r, evaled_r)
                          )
                        },
                        _ => Option(EvalResult).None
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // :: constant declaration.
            // name :: expr  — simple binding.
            // { A, B } :: expr — destructuring binding (from Module or Struct).
            // -----------------------------------------------------------------
            (is_infix && (fval == "::")) =>
              cond(
                (args.len() < usize(2)) => Option(EvalResult).None,
                true =>
                  match(
                    args.get(usize(0)),
                    .Some(lhs) =>
                      match(
                        args.get(usize(1)),
                        .Some(rhs) =>
                          match(
                            lhs,
                            // Simple: name :: rhs
                            .Atom(_, name_tok) =>
                              match(
                                recur(rhs, env),
                                .Some(rhs_res) => {
                                  _idx := env.define_val(
                                    name_tok.value,
                                    rhs_res.ty,
                                    true,
                                    // :: is always comptime
                                    .Some(rhs_res.value)
                                  );
                                  .Some(eval_result(.UnitVal, t_unit()))
                                },
                                .None => Option(EvalResult).None
                              ),
                            // Destructuring: { A, B, … } :: rhs (anon-struct LHS)
                            .FnCall(_, lhs_fb, lhs_args, _, _) =>
                              match(
                                lhs_fb,
                                .Atom(_, lhs_tok) =>
                                  cond(
                                    (lhs_tok.value == BK_ANON_STRUCT) =>
                                      match(
                                        recur(rhs, env),
                                        .Some(rhs_res) =>
                                          match(
                                            rhs_res.value,
                                            // Destructure a ModuleVal
                                            .StructVal(_, mnames, mvals) => {
                                              (di : usize) = usize(0);
                                              dn := lhs_args.len();
                                              (dok : bool) = true;
                                              while((di < dn) && dok, {
                                                match(
                                                  lhs_args.get(di),
                                                  .Some(name_expr) =>
                                                    match(
                                                      name_expr,
                                                      .Atom(_, req_tok) => {
                                                        // Find the requested name in the module
                                                        (dj : usize) = usize(0);
                                                        dm := mnames.len();
                                                        (dfound : bool) = false;
                                                        while((dj < dm) && (!(dfound)), {
                                                          match(
                                                            mnames.get(dj),
                                                            .Some(mname) =>
                                                              cond(
                                                                (mname == req_tok.value) => {
                                                                  match(
                                                                    mvals.get(dj),
                                                                    .Some(mval) => {
                                                                      _didx := env.define_val(
                                                                        req_tok.value,
                                                                        type_of_eval_value(mval),
                                                                        true,
                                                                        .Some(mval)
                                                                      );
                                                                      dfound = true;
                                                                    },
                                                                    .None => {
                                                                      dok = false;
                                                                    }
                                                                  );
                                                                },
                                                                true => ()
                                                              ),
                                                            .None => ()
                                                          );
                                                          dj = (dj + usize(1));
                                                        });
                                                        cond(
                                                          (!(dfound)) => {
                                                            dok = false;
                                                          },
                                                          true => ()
                                                        );
                                                      },
                                                      .FnCall(_, _, _, _, _) => {
                                                        dok = false;
                                                      }
                                                    ),
                                                  .None => {
                                                    dok = false;
                                                  }
                                                );
                                                di = (di + usize(1));
                                              });
                                              cond(
                                                dok =>.Some(eval_result(.UnitVal, t_unit())),
                                                true => Option(EvalResult).None
                                              )
                                            },
                                            _ => Option(EvalResult).None
                                          ),
                                        .None => Option(EvalResult).None
                                      ),
                                    true => Option(EvalResult).None
                                  ),
                                .FnCall(_, _, _, _, _) => Option(EvalResult).None
                              )
                          ),
                        .None => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  )
              ),
            // -----------------------------------------------------------------
            // name — Phase 3o
            // At a call site, `name` passes the value of `name` from
            // the caller's env as evidence to the callee.
            // -----------------------------------------------------------------
            (fval == "using") => handle_using_call(args, env),
            // -----------------------------------------------------------------
            // import("path") — Phase 3m
            // Calls g_module_loader with the path string (stripped of quotes).
            // Returns the ModuleVal provided by the loader.
            // -----------------------------------------------------------------
            (fval == BK_IMPORT) =>
              match(
                args.get(usize(0)),
                .Some(path_expr) =>
                  match(
                    path_expr,
                    .Atom(_, path_tok) => {
                      raw := path_tok.value.clone();
                      rn := raw.len();
                      cond(
                        (rn < usize(2)) => Option(EvalResult).None,
                        true => {
                          path_str := raw.substring(usize(1), rn - usize(1));
                          match(
                            g_module_loader,
                            .None => Option(EvalResult).None,
                            .Some(loader) =>
                              match(
                                loader(path_str),
                                .None => Option(EvalResult).None,
                                .Some(mod_val) =>
                                  .Some(eval_result(mod_val, t_unit()))
                              )
                          )
                        }
                      )
                    },
                    .FnCall(_, _, _, _, _) => Option(EvalResult).None
                  ),
                .None => Option(EvalResult).None
              ),
            // -----------------------------------------------------------------
            // open(module_expr) — Phase 3m
            // Evaluates its argument to a ModuleVal, then binds every exported
            // name into the current environment as a comptime constant.
            // -----------------------------------------------------------------
            (fval == BK_OPEN) =>
              match(
                args.get(usize(0)),
                .Some(mod_expr) =>
                  match(
                    recur(mod_expr, env),
                    .Some(mod_res) =>
                      match(
                        mod_res.value,
                        .StructVal(_, mnames, mvals) => {
                          (oi : usize) = usize(0);
                          on := mnames.len();
                          while(oi < on, {
                            match(
                              mnames.get(oi),
                              .Some(mname) =>
                                match(
                                  mvals.get(oi),
                                  .Some(mval) => {
                                    _oidx := env.define_val(
                                      mname,
                                      type_of_eval_value(mval),
                                      true,
                                      .Some(mval)
                                    );
                                  },
                                  .None => ()
                                ),
                              .None => ()
                            );
                            oi = (oi + usize(1));
                          });
                          .Some(eval_result(.UnitVal, t_unit()))
                        },
                        _ => Option(EvalResult).None
                      ),
                    .None => Option(EvalResult).None
                  ),
                .None => Option(EvalResult).None
              ),
            // -----------------------------------------------------------------
            // General identifier: struct construction or FuncVal call.
            //
            // Struct construction (all args are named `:` infix calls):
            //   TypeName(field1: val1, field2: val2, …) → StructVal
            //
            // FuncVal call: look up identifier, check arity, run body.
            // Arity mismatch or unbound identifier → None.
            // -----------------------------------------------------------------
            // -----------------------------------------------------------------
            // Type definitions — Phase 3z
            // enum(...), struct(...), object(...), newtype(...), union(...), trait(...)
            // Each creates a TypeVal containing the appropriate TypeValue.
            // -----------------------------------------------------------------
            (fval == BK_ENUM) => handle_enum_def(args, env),
            (fval == BK_STRUCT) => handle_struct_def(args, false, false, env),
            // ref(struct(...)) — reference-semantics struct (the non-deprecated
            // spelling of object). Unwrap the inner struct(...) and define it
            // with reference semantics. (ref(enum(...)) is Phase 3.)
            (fval == BK_REF) =>
              match(
                args.get(usize(0)),
                .Some(__ref_inner) => match(
                  __ref_inner,
                  .FnCall(_, __rib, __ria, _, _) => match(
                    __rib,
                    .Atom(_, __rit) => cond(
                      (__rit.value == BK_STRUCT) => handle_struct_def(__ria, true, false, env),
                      true => Option(EvalResult).None
                    ),
                    .FnCall(_, _, _, _, _) => Option(EvalResult).None
                  ),
                  .Atom(_, _) => Option(EvalResult).None
                ),
                .None => Option(EvalResult).None
              ),
            (fval == BK_NEWTYPE) => handle_struct_def(args, false, true, env),
            (fval == BK_UNION) => handle_union_def(args, env),
            (fval == BK_TRAIT) => handle_trait_def(args, env),
            // -----------------------------------------------------------------
            // `if(cond, then)` or `if(cond, then, else)` — conditional expr.
            // 2-arg: returns UnitVal when condition is false.
            // 3-arg: evaluates else branch when condition is false.
            // Returns None when the condition does not fold to a Bool.
            // -----------------------------------------------------------------
            (fval == "if") => handle_if_form(args, env),
            // -----------------------------------------------------------------
            // impl(TypeName, method_name : fn_def, …) — Phase 3j
            // Delegated to handle_impl_form to keep evaluate's frame small.
            // -----------------------------------------------------------------
            (fval == "impl") => handle_impl_form(args, env),
            // -----------------------------------------------------------------
            // Anonymous struct literal: _(field: val, …) or _(val, …)
            // Labeled fields keep their name; positional fields get "__field_N".
            // -----------------------------------------------------------------
            (fval == BK_ANON_STRUCT) => handle_anon_struct_form(args, env),
            // -----------------------------------------------------------------
            // Phase 5u: assert(cond, msg) — compile-time assertion check.
            // Evaluates cond; if truthy returns unit; if false returns None (error).
            // -----------------------------------------------------------------
            ((fval == "assert") && ((args.len() == usize(2)) || (args.len() == usize(1)))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(cond_expr) =>
                  match(
                    recur(cond_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(cond_res) =>
                      match(
                        cond_res.value,
                        .BoolVal(b) =>
                          cond(b =>.Some(eval_result(.UnitVal, t_unit())), true => Option(EvalResult).None),
                        _ =>.Some(eval_result(.UnitVal, t_unit()))
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // Phase 5u: comptime_assert(cond, msg) — same as assert for CTFE.
            // -----------------------------------------------------------------
            ((fval == "comptime_assert") && ((args.len() == usize(2)) || (args.len() == usize(1)))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(cond_expr) =>
                  match(
                    recur(cond_expr, env),
                    .None => Option(EvalResult).None,
                    .Some(cond_res) =>
                      match(
                        cond_res.value,
                        .BoolVal(b) =>
                          cond(b =>.Some(eval_result(.UnitVal, t_unit())), true => Option(EvalResult).None),
                        _ =>.Some(eval_result(.UnitVal, t_unit()))
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // Phase 3am: expr — heap-boxing. At compile time, wraps the
            // value in PtrVal so that `box(x).*` round-trips correctly.
            // -----------------------------------------------------------------
            ((fval == "box") && (args.len() == usize(1))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(box_arg) =>
                  match(
                    recur(box_arg, env),
                    .None => Option(EvalResult).None,
                    .Some(box_res) =>
                      .Some(eval_result(.PtrVal(box(box_res.value), usize(0)), box_res.ty))
                  )
              ),
            // -----------------------------------------------------------------
            // Phase 3am: ArrayList(T) type constructor — returns a TypeVal
            // placeholder so that `ArrayList(T).new()` can dispatch correctly.
            // The type argument T is evaluated but ignored; only the shape
            // matters for the proto-evaluator's purpose.
            // -----------------------------------------------------------------
            (fval == "ArrayList") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            // -----------------------------------------------------------------
            // Phase 5w: runtime(expr) — unwrap runtime wrapper, just eval inner.
            // In the real compiler this prevents CTFE; for proto-eval, pass-through.
            // -----------------------------------------------------------------
            ((fval == "runtime") && (args.len() == usize(1))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(rt_arg) => recur(rt_arg, env)
              ),
            // -----------------------------------------------------------------
            // Phase 5w: dyn(expr) — dynamic trait object creation.
            // For proto-eval, just evaluate the inner expression and pass through.
            // -----------------------------------------------------------------
            ((fval == "dyn") && (args.len() == usize(1))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(dyn_arg) => recur(dyn_arg, env)
              ),
            // -----------------------------------------------------------------
            // Phase 5w: comptime(expr) — compile-time evaluation marker.
            // For proto-eval, just evaluate the inner expression.
            // -----------------------------------------------------------------
            ((fval == "comptime") && (args.len() == usize(1))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(ct_arg) => recur(ct_arg, env)
              ),
            // -----------------------------------------------------------------
            // Phase 5w: Common type constructors — return TypeVal placeholder.
            // Only match if the single arg is NOT a named field (infix `:`)
            // to avoid shadowing struct constructors like Box(size: i32(5)).
            // -----------------------------------------------------------------
            (((fval == "Option") && (args.len() == usize(1))) && (!(is_named_field_arg(args)))) =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            ((fval == "Result") && (args.len() <= usize(2))) =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (((fval == "Box") && (args.len() == usize(1))) && (!(is_named_field_arg(args)))) =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (((fval == "Pointer") && (args.len() == usize(1))) && (!(is_named_field_arg(args)))) =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            // -----------------------------------------------------------------
            // Phase 5aa: Slice(T), Future(T, ...), Array(T, N) — type constructors.
            // -----------------------------------------------------------------
            (fval == "Slice") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (fval == "Future") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (fval == "Array") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (fval == "Io") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (fval == "Exception") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            // -----------------------------------------------------------------
            // Phase 5x: println/print — evaluate args but return unit.
            // In CTFE these are no-ops; we just ensure args are well-formed.
            // -----------------------------------------------------------------
            (fval == "println") =>.Some(eval_result(.UnitVal, t_unit())),
            (fval == "print") =>.Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // Phase 5x: str — type constructor for String from str.
            // Returns the string value as a StrLit for the proto-evaluator.
            // -----------------------------------------------------------------
            (fval == "String") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            // -----------------------------------------------------------------
            // Phase 5y: extern / c_include — FFI declarations.
            // In the proto-evaluator these are no-ops (just return unit).
            // The real compiler uses them for C interop declarations.
            // -----------------------------------------------------------------
            (fval == "extern") =>.Some(eval_result(.UnitVal, t_unit())),
            (fval == "c_include") =>.Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // Phase 5y: where(constraint) — trait bound declarations.
            // No-op for proto-eval; the real compiler uses these for type checking.
            // -----------------------------------------------------------------
            (fval == "where") =>.Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // Phase 5y: forall(T : Type, ...) — type parameter declarations.
            // For proto-eval: evaluate the inner (binding exprs) and return unit.
            // The real evaluator creates type variables; we skip that.
            // -----------------------------------------------------------------
            (fval == "forall") =>.Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // Phase 5y: type_of(expr) — return the type as a TypeVal.
            // Evaluates the expression, extracts its type, wraps as TypeVal.
            // -----------------------------------------------------------------
            ((fval == "type_of") && (args.len() == usize(1))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(typeof_arg) =>
                  match(
                    recur(typeof_arg, env),
                    .None => Option(EvalResult).None,
                    .Some(typeof_res) =>
                      .Some(eval_result(.TypeVal(typeof_res.ty), t_type()))
                  )
              ),
            // -----------------------------------------------------------------
            // Phase 5y: size_of(Type) / align_of(Type) — return placeholder int.
            // Real compiler computes actual sizes; proto-eval returns 8 (pointer size).
            // -----------------------------------------------------------------
            ((fval == "size_of") && (args.len() == usize(1))) =>
              .Some(eval_result(.IntLit(String.from("8")), t_comptime_int())),
            ((fval == "align_of") && (args.len() == usize(1))) =>
              .Some(eval_result(.IntLit(String.from("8")), t_comptime_int())),
            // -----------------------------------------------------------------
            // Phase 5y: HashMap(K, V) — type constructor placeholder.
            // -----------------------------------------------------------------
            ((fval == "HashMap") && (args.len() == usize(2))) =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            // -----------------------------------------------------------------
            // Phase 5y: unreachable / panic / todo — control-flow builtins.
            // In proto-eval these just return unit (we can't actually abort).
            // -----------------------------------------------------------------
            (fval == "unreachable") =>.Some(eval_result(.UnitVal, t_unit())),
            (fval == "panic") =>.Some(eval_result(.UnitVal, t_unit())),
            (fval == "todo") =>.Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // Phase 5z: Impl(T) / Fn / FnMut / FnOnce — closure type constructors.
            // Returns TypeVal placeholder.
            // -----------------------------------------------------------------
            (fval == "Impl") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (fval == "Fn") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (fval == "FnMut") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            (fval == "FnOnce") =>
              .Some(eval_result(.TypeVal(t_type()), t_type())),
            // -----------------------------------------------------------------
            // Phase 5z: comptime_expect_error(expr) — test helper.
            // Tries to evaluate the argument; if it returns None (error) → pass.
            // If it succeeds → we return unit anyway (proto-eval can't distinguish).
            // -----------------------------------------------------------------
            (fval == "comptime_expect_error") =>
              .Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // Phase 5z: derive(Trait1, Trait2, ...) — derive declarations.
            // No-op in proto-eval; the real compiler generates method impls.
            // -----------------------------------------------------------------
            (fval == "derive") =>.Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // Phase 5z: export(expr) — evaluate inner and return it.
            // The real compiler marks the binding as exported.
            // -----------------------------------------------------------------
            ((fval == BK_EXPORT) && (args.len() == usize(1))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(export_arg) => recur(export_arg, env)
              ),
            // -----------------------------------------------------------------
            // Array literal: [e1, e2, ...] — parsed as array(e1, e2, ...)
            // Evaluates all elements and produces an ArrayVal.
            // -----------------------------------------------------------------
            (fval == BK_ARRAY_VAL) => {
              arr_elems := ArrayList(EvalValue).new();
              n_ae := args.len();
              (ae_i : usize) = usize(0);
              (ae_ok : bool) = true;
              while((ae_i < n_ae) && ae_ok, {
                match(
                  args.get(ae_i),
                  .Some(ae_expr) =>
                    match(
                      recur(ae_expr, env),
                      .Some(ae_res) => {
                        arr_elems.push(ae_res.value);
                      },
                      .None => {
                        ae_ok = false;
                      }
                    ),
                  .None => {
                    ae_ok = false;
                  }
                );
                ae_i = (ae_i + usize(1));
              });
              cond(
                (!(ae_ok)) => Option(EvalResult).None,
                true =>.Some(eval_result(.ArrayVal(arr_elems), t_unit()))
              )
            },
            // -----------------------------------------------------------------
            // Closure/lambda: (params) => body  or  param => body
            // Creates a FuncVal capturing the current environment.
            // Proto-evaluator simplified: no type checking, just captures env.
            // -----------------------------------------------------------------
            (is_infix && (fval == "=>")) =>
              cond(
                (args.len() != usize(2)) => Option(EvalResult).None,
                true => {
                  param_expr_opt := args.get(usize(0));
                  body_expr_opt := args.get(usize(1));
                  match(
                    param_expr_opt,
                    .None => Option(EvalResult).None,
                    .Some(param_expr) => match(
                      body_expr_opt,
                      .None => Option(EvalResult).None,
                      .Some(body_expr) => {
                        // Extract parameter names from LHS
                        // Single param: Atom("x")
                        // Multiple: FnCall(Atom("tuple"), [Atom("x"), Atom("y"), ...], false)
                        params_f := ArrayList(String).new();
                        param_type_names_f := ArrayList(String).new();
                        match(
                          param_expr,
                          .Atom(_, ptok) => {
                            params_f.push(ptok.value);
                            param_type_names_f.push(String.from("_"));
                          },
                          .FnCall(_, pf, pargs, _, _) =>
                            match(
                              pf,
                              .Atom(_, pftok) =>
                                cond(
                                  (pftok.value == BK_TUPLE) => {
                                    // (x, y, z) — multiple params
                                    (pi : usize) = usize(0);
                                    pn := pargs.len();
                                    while(pi < pn, {
                                      match(
                                        pargs.get(pi),
                                        .Some(pe) =>
                                          match(
                                            pe,
                                            .Atom(_, petok) => {
                                              params_f.push(petok.value);
                                              param_type_names_f.push(String.from("_"));
                                            },
                                            .FnCall(_, pe_f, pe_args, pe_infix, _) =>
                                              cond(
                                                // (x : T) — typed param
                                                (pe_infix && match(pe_f,.Atom(_, ct) => (ct.value == ":"),.FnCall(_, _, _, _, _) => false)) =>
                                                  match(
                                                    pe_args.get(usize(0)),
                                                    .Some(name_e) => match(
                                                      name_e,
                                                      .Atom(_, nt) => {
                                                        params_f.push(nt.value);
                                                        param_type_names_f.push(String.from("_"));
                                                      },
                                                      .FnCall(_, _, _, _, _) => ()
                                                    ),
                                                    .None => ()
                                                  ),
                                                // x : T — effect param (treat as regular for now)
                                                true =>
                                                  match(
                                                    pe_args.get(usize(0)),
                                                    .Some(name_e) => match(
                                                      name_e,
                                                      .Atom(_, nt) => {
                                                        params_f.push(nt.value);
                                                        param_type_names_f.push(String.from("_"));
                                                      },
                                                      .FnCall(_, _, _, _, _) => ()
                                                    ),
                                                    .None => ()
                                                  )
                                              )
                                          ),
                                        .None => ()
                                      );
                                      pi = (pi + usize(1));
                                    });
                                  },
                                  // (x : T) — single typed param in parens
                                  (pftok.value == ":") =>
                                    match(
                                      pargs.get(usize(0)),
                                      .Some(name_e) => match(
                                        name_e,
                                        .Atom(_, nt) => {
                                          params_f.push(nt.value);
                                          param_type_names_f.push(String.from("_"));
                                        },
                                        .FnCall(_, _, _, _, _) => ()
                                      ),
                                      .None => ()
                                    ),
                                  // fn(x, y) — function-style param list
                                  (pftok.value == "fn") => {
                                    (fpi : usize) = usize(0);
                                    fpn := pargs.len();
                                    while(fpi < fpn, {
                                      match(
                                        pargs.get(fpi),
                                        .Some(fpe) =>
                                          match(
                                            fpe,
                                            .Atom(_, fpetok) => {
                                              params_f.push(fpetok.value);
                                              param_type_names_f.push(String.from("_"));
                                            },
                                            .FnCall(_, fpe_f, fpe_args, fpe_infix, _) =>
                                              cond(
                                                // (x : T) inside fn(...)
                                                (fpe_infix && match(fpe_f,.Atom(_, fct) => (fct.value == ":"),.FnCall(_, _, _, _, _) => false)) =>
                                                  match(
                                                    fpe_args.get(usize(0)),
                                                    .Some(fn_e) => match(
                                                      fn_e,
                                                      .Atom(_, fnt) => {
                                                        params_f.push(fnt.value);
                                                        param_type_names_f.push(String.from("_"));
                                                      },
                                                      .FnCall(_, _, _, _, _) => ()
                                                    ),
                                                    .None => ()
                                                  ),
                                                true => ()
                                              )
                                          ),
                                        .None => ()
                                      );
                                      fpi = (fpi + usize(1));
                                    });
                                  },
                                  true => ()
                                ),
                              .FnCall(_, _, _, _, _) => ()
                            )
                        );
                        // Capture current environment (all frames)
                        cap_names_f := ArrayList(String).new();
                        cap_tys_f := ArrayList(TypeValue).new();
                        cap_vals_f := ArrayList(EvalValue).new();
                        n_frames := env.frames.len();
                        (cfi : usize) = usize(0);
                        while(cfi < n_frames, {
                          match(
                            env.frames.get(cfi),
                            .Some(frame) => {
                              n_cv := frame.variables.len();
                              (cvi : usize) = usize(0);
                              while(cvi < n_cv, {
                                match(
                                  frame.variables.get(cvi),
                                  .Some(v) => {
                                    cap_names_f.push(v.name);
                                    cap_tys_f.push(v.ty);
                                    cap_val_f := match(
                                      v.value,
                                      .Some(actual) => actual,
                                      .None => EvalValue.VarRef(v.name)
                                    );
                                    cap_vals_f.push(cap_val_f);
                                  },
                                  .None => ()
                                );
                                cvi = (cvi + usize(1));
                              });
                            },
                            .None => ()
                          );
                          cfi = (cfi + usize(1));
                        });
                        .Some(
                          eval_result(
                            .FuncVal(
                              box(
                                FuncValData(
                                  forall_names : ArrayList(String).new(),
                                  params : params_f,
                                  param_type_names : param_type_names_f,
                                  evidence_params : ArrayList(String).new(),
                                  body : body_expr,
                                  cap_names : cap_names_f,
                                  cap_tys : cap_tys_f,
                                  func_id : random_id(String.from("lambda"))
                                )
                              ),
                              cap_vals_f
                            ),
                            t_unit()
                          )
                        )
                      }
                    )
                  )
                }
              ),
            // -----------------------------------------------------------------
            // Phase 5v: FnMut closure: (params) =>> body
            // Identical to => for the proto-evaluator (difference is type-level).
            // -----------------------------------------------------------------
            (is_infix && (fval == "=>>")) =>
              cond(
                (args.len() != usize(2)) => Option(EvalResult).None,
                true => {
                  p_opt := args.get(usize(0));
                  b_opt := args.get(usize(1));
                  match(
                    p_opt,
                    .None => Option(EvalResult).None,
                    .Some(p_expr) => match(
                      b_opt,
                      .None => Option(EvalResult).None,
                      .Some(b_expr) => {
                        params_m := ArrayList(String).new();
                        ptnames_m := ArrayList(String).new();
                        match(
                          p_expr,
                          .Atom(_, ptk) => {
                            params_m.push(ptk.value);
                            ptnames_m.push(String.from(""));
                          },
                          .FnCall(_, pfb, pfa, _, _) =>
                            match(
                              pfb,
                              .Atom(_, pft) =>
                                cond(
                                  (pft.value == BK_TUPLE) => {
                                    np := pfa.len();
                                    (pi : usize) = usize(0);
                                    while(pi < np, {
                                      match(
                                        pfa.get(pi),
                                        .Some(pe) =>
                                          match(
                                            pe,
                                            .Atom(_, pet) => {
                                              params_m.push(pet.value);
                                              ptnames_m.push(String.from(""));
                                            },
                                            .FnCall(_, cff, cfa, _, _) =>
                                              match(
                                                cff,
                                                .Atom(_, cft) =>
                                                  cond(
                                                    (cft.value == ":") =>
                                                      match(
                                                        cfa.get(usize(0)),
                                                        .Some(cfe) =>
                                                          match(
                                                            cfe,
                                                            .Atom(_, cpn) => {
                                                              params_m.push(cpn.value);
                                                              ptnames_m.push(String.from(""));
                                                            },
                                                            .FnCall(_, _, _, _, _) => ()
                                                          ),
                                                        .None => ()
                                                      ),
                                                    true => ()
                                                  ),
                                                .FnCall(_, _, _, _, _) => ()
                                              )
                                          ),
                                        .None => ()
                                      );
                                      pi = (pi + usize(1));
                                    });
                                  },
                                  true => {
                                    params_m.push(pft.value);
                                    ptnames_m.push(String.from(""));
                                  }
                                ),
                              .FnCall(_, _, _, _, _) => ()
                            )
                        );
                        // Capture environment
                        cn_m := ArrayList(String).new();
                        ct_m := ArrayList(TypeValue).new();
                        cv_m := ArrayList(EvalValue).new();
                        nf_m := env.frames.len();
                        (fi_m : usize) = usize(0);
                        while(fi_m < nf_m, {
                          match(
                            env.frames.get(fi_m),
                            .Some(frame_m) => {
                              nv_m := frame_m.variables.len();
                              (vi_m : usize) = usize(0);
                              while(vi_m < nv_m, {
                                match(
                                  frame_m.variables.get(vi_m),
                                  .Some(v_m) => {
                                    cn_m.push(v_m.name);
                                    ct_m.push(v_m.ty);
                                    cv_m.push(match(v_m.value,.Some(a) => a,.None => EvalValue.VarRef(v_m.name)));
                                  },
                                  .None => ()
                                );
                                vi_m = (vi_m + usize(1));
                              });
                            },
                            .None => ()
                          );
                          fi_m = (fi_m + usize(1));
                        });
                        .Some(
                          eval_result(
                            .FuncVal(
                              box(
                                FuncValData(
                                  forall_names : ArrayList(String).new(),
                                  params : params_m,
                                  param_type_names : ptnames_m,
                                  evidence_params : ArrayList(String).new(),
                                  body : b_expr,
                                  cap_names : cn_m,
                                  cap_tys : ct_m,
                                  func_id : random_id(String.from("lambda_mut"))
                                )
                              ),
                              cv_m
                            ),
                            t_unit()
                          )
                        )
                      }
                    )
                  )
                }
              ),
            // -----------------------------------------------------------------
            // Phase 5v: Logical NOT: !(expr) → evaluates to !bool
            // -----------------------------------------------------------------
            ((fval == "!") && (args.len() == usize(1))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(not_arg) =>
                  match(
                    recur(not_arg, env),
                    .None => Option(EvalResult).None,
                    .Some(not_res) =>
                      match(
                        not_res.value,
                        .BoolVal(b) =>.Some(eval_result(.BoolVal(!(b)), t_bool())),
                        _ => Option(EvalResult).None
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // Phase 5v: Unary negation: -(expr) → negate integer
            // (Only handles prefix `-` as a function call with 1 arg)
            // -----------------------------------------------------------------
            ((fval == "-") && (args.len() == usize(1))) =>
              match(
                args.get(usize(0)),
                .None => Option(EvalResult).None,
                .Some(neg_arg) =>
                  match(
                    recur(neg_arg, env),
                    .None => Option(EvalResult).None,
                    .Some(neg_res) =>
                      match(
                        neg_res.value,
                        .IntLit(raw) => {
                          neg_str := String.from("-").concat(raw);
                          .Some(eval_result(.IntLit(neg_str), t_comptime_int()))
                        },
                        .FloatLit(raw) => {
                          neg_str := String.from("-").concat(raw);
                          .Some(eval_result(.FloatLit(neg_str), t_comptime_float()))
                        },
                        _ => Option(EvalResult).None
                      )
                  )
              ),
            // -----------------------------------------------------------------
            // General identifier: struct constructor or FuncVal call.
            // Detect struct construction: first arg is a `:` infix call (named field)
            true => {
              is_struct_ctor := match(
                args.get(usize(0)),
                .Some(a0) =>
                  match(
                    a0,
                    .FnCall(_, a0f, _, a0infix, _) =>
                      cond(
                        a0infix =>
                          match(
                            a0f,
                            .Atom(_, a0tok) => (a0tok.value == ":"),
                            .FnCall(_, _, _, _, _) => false
                          ),
                        true => false
                      ),
                    .Atom(_, _) => false
                  ),
                .None => false
              );
              cond(
                is_struct_ctor => {
                  fn_list := ArrayList(String).new();
                  fv_list := ArrayList(EvalValue).new();
                  n_named := args.len();
                  (si : usize) = usize(0);
                  (sok : bool) = true;
                  while((si < n_named) && sok, {
                    match(
                      args.get(si),
                      .Some(arg_e) =>
                        match(
                          arg_e,
                          .FnCall(_, _, na, _, _) =>
                            match(
                              na.get(usize(0)),
                              .Some(ne) =>
                                match(
                                  ne,
                                  .Atom(_, ntok) =>
                                    match(
                                      na.get(usize(1)),
                                      .Some(ve) =>
                                        match(
                                          recur(ve, env),
                                          .Some(vr) => {
                                            fn_list.push(ntok.value);
                                            fv_list.push(vr.value);
                                          },
                                          .None => {
                                            sok = false;
                                          }
                                        ),
                                      .None => {
                                        sok = false;
                                      }
                                    ),
                                  .FnCall(_, _, _, _, _) => {
                                    sok = false;
                                  }
                                ),
                              .None => {
                                sok = false;
                              }
                            ),
                          .Atom(_, _) => {
                            sok = false;
                          }
                        ),
                      .None => {
                        sok = false;
                      }
                    );
                    si = (si + usize(1));
                  });
                  cond(
                    (!(sok)) => Option(EvalResult).None,
                    true =>.Some(eval_result(.StructVal(fval, fn_list, fv_list), t_unit()))
                  )
                },
                true =>
                  match(
                    env.lookup(fval),
                    .None => Option(EvalResult).None,
                    .Some(var) =>
                      match(
                        var.value,
                        .None => Option(EvalResult).None,
                        .Some(func_val) =>
                          match(
                            func_val,
                            .FuncVal(__fvd1, _) => {
                              // Phase 6c: macro-aware call dispatch.
                              // For quoted params, bind the raw arg AST as
                              // ExprVal instead of evaluating; if the function
                              // returns `unquote(...)`, re-evaluate the returned
                              // ExprVal in the caller's env to get the
                              // expanded expression's value.
                              fv_is_macro := is_macro_fn(__fvd1.*.func_id.clone());
                              evaled_g := ArrayList(EvalResult).new();
                              n_gargs := args.len();
                              (gi : usize) = usize(0);
                              (gok : bool) = true;
                              while((gi < n_gargs) && gok, {
                                match(
                                  args.get(gi),
                                  .Some(arg_expr) =>
                                    cond(
                                      (fv_is_macro && is_param_quoted(__fvd1.*.func_id.clone(), gi)) => {
                                        evaled_g.push(eval_result(.ExprVal(arg_expr.clone()), t_expr_t()));
                                      },
                                      true =>
                                        match(
                                          recur(arg_expr, env),
                                          .Some(r) => {
                                            evaled_g.push(r);
                                          },
                                          .None => {
                                            gok = false;
                                          }
                                        )
                                    ),
                                  .None => {
                                    gok = false;
                                  }
                                );
                                gi = (gi + usize(1));
                              });
                              cond(
                                (!(gok)) => Option(EvalResult).None,
                                true => {
                                  call_res := call_funcval_with_args(func_val, evaled_g);
                                  cond(
                                    macro_return_is_unquote(__fvd1.*.func_id.clone()) =>
                                      match(
                                        call_res,
                                        .None => Option(EvalResult).None,
                                        .Some(cr) =>
                                          match(
                                            cr.value,
                                            .ExprVal(expanded_box) => recur(expanded_box, env),
                                            _ => call_res
                                          )
                                      ),
                                    true => call_res
                                  )
                                }
                              )
                            },
                            _ => Option(EvalResult).None
                          )
                      )
                  )
              )
            }
          )
        }
      )
  )
);
// Initialize the g_eval_fn slot with the evaluate function (Phase 3j).
// Must run after evaluate is defined so the reference is valid.
// Returns bool to avoid 'void' C variable error from unit return type.
_eval_fn_init := (fn() -> bool)({
  g_eval_fn =.Some(evaluate);
  true
})();
/// Register a module loader callback for `import("path")` expressions (Phase 3m).
/// When set, `import("path")` will call `loader(path)` and return the result.
/// Call this before evaluating any module that uses imports.
/// Typically called once at program startup (or in tests for mocking).
set_module_loader :: (fn(loader : (fn(path : String) -> Option(EvalValue))) -> unit)({
  g_module_loader =.Some(loader);
});
export(evaluate, eval_atom, eval_identifier, parse_raw_int, evaluate_module_body, set_module_loader);
