                        },
                        .Some(ca_i64) => {
                          ca_idx_u := usize(ca_i64);
                          match(
                            recv_val,
                            .StrLit(raw_ca) => {
                              n_ca := raw_ca.len();
                              cond(
                                (n_ca < usize(2)) => {
                                  return(Option(EvalResult).None);
                                },
                                true => {
                                  inner_ca := raw_ca.substring(usize(1), n_ca - usize(1));
                                  cond(
                                    (ca_idx_u >= inner_ca.len()) => {
                                      return(Option(EvalResult).None);
                                    },
                                    true => {
                                      ch := inner_ca.substring(ca_idx_u, ca_idx_u + usize(1));
                                      result_ca := ((String.from("\"") + ch) + String.from("\""));
                                      return(Option(EvalResult).Some(eval_result(.StrLit(result_ca), t_comptime_string())));
                                    }
                                  );
                                }
                              );
                            },
                            _ => {
                              return(Option(EvalResult).None);
                            }
                          );
                        }
                      ),
                    _ => {
                      return(Option(EvalResult).None);
                    }
                  )
              )
          ),
        // ---------------------------------------------------------------
        // Phase 3am: TypeVal.new() refinement
        // String.new()    → StrLit("")
        // ArrayList.new() → ArrayVal([]) — any non-String TypeVal
        // ---------------------------------------------------------------
        // ---------------------------------------------------------------
        // Phase 3an: StrLit string mutation shims
        // StrLit.replace_all(from, to) — replace all occurrences
        // StrLit.trim()               — strip leading/trailing whitespace
        // StrLit.to_uppercase()       — uppercase inner content
        // StrLit.to_lowercase()       — lowercase inner content
        // StrLit.chars_count()        — alias for len (UTF-8 char count approx)
        // ---------------------------------------------------------------
        // StrLit.replace_all(from, to) — substitutes all occurrences of `from` with `to`
        ((mname == "replace_all") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(2)))) =>
          match(
            method_call_args.get(usize(0)),
            .None => {
              return(Option(EvalResult).None);
            },
            .Some(ra_from_expr) =>
              match(
                method_call_args.get(usize(1)),
                .None => {
                  return(Option(EvalResult).None);
                },
                .Some(ra_to_expr) =>
                  match(
                    match(
                      g_eval_fn,
                      .Some(ef_ra1) => ef_ra1(ra_from_expr, env),
                      .None => Option(EvalResult).None
                    ),
                    .None => {
                      return(Option(EvalResult).None);
                    },
                    .Some(from_res) =>
                      match(
                        match(
                          g_eval_fn,
                          .Some(ef_ra2) => ef_ra2(ra_to_expr, env),
                          .None => Option(EvalResult).None
                        ),
                        .None => {
                          return(Option(EvalResult).None);
                        },
                        .Some(to_res) =>
                          match(
                            recv_val,
                            .StrLit(raw_ra) =>
                              match(
                                from_res.value,
                                .StrLit(from_raw) =>
                                  match(
                                    to_res.value,
                                    .StrLit(to_raw) => {
                                      n_ra := raw_ra.len();
                                      n_fr := from_raw.len();
                                      n_tr := to_raw.len();
                                      cond(
                                        ((n_ra < usize(2)) || ((n_fr < usize(2)) || (n_tr < usize(2)))) =>
                                          {
                                            return(Option(EvalResult).None);
                                          },
                                        true => {
                                          inner_ra := raw_ra.substring(usize(1), n_ra - usize(1));
                                          from_inner := from_raw.substring(usize(1), n_fr - usize(1));
                                          to_inner := to_raw.substring(usize(1), n_tr - usize(1));
                                          replaced := inner_ra.replace_all(from_inner, to_inner);
                                          result_ra := ((String.from("\"") + replaced) + String.from("\""));
                                          return(Option(EvalResult).Some(eval_result(.StrLit(result_ra), t_comptime_string())));
                                        }
                                      )
                                    },
                                    _ => {
                                      return(Option(EvalResult).None);
                                    }
                                  ),
                                _ => {
                                  return(Option(EvalResult).None);
                                }
                              ),
                            _ => {
                              return(Option(EvalResult).None);
                            }
                          )
                      )
                  )
              )
          ),
        // StrLit.trim() — strip leading/trailing ASCII whitespace
        ((mname == "trim") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          match(
            recv_val,
            .StrLit(raw_tr) => {
              n_tr2 := raw_tr.len();
              cond(
                (n_tr2 < usize(2)) => {
                  return(Option(EvalResult).None);
                },
                true => {
                  inner_tr := raw_tr.substring(usize(1), n_tr2 - usize(1));
                  trimmed := inner_tr.trim();
                  result_tr := ((String.from("\"") + trimmed) + String.from("\""));
                  return(Option(EvalResult).Some(eval_result(.StrLit(result_tr), t_comptime_string())));
                }
              )
            },
            _ => {
              return(Option(EvalResult).None);
            }
          ),
        // StrLit.to_uppercase() — uppercase the inner content
        ((mname == "to_uppercase") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          match(
            recv_val,
            .StrLit(raw_up) => {
              n_up := raw_up.len();
              cond(
                (n_up < usize(2)) => {
                  return(Option(EvalResult).None);
                },
                true => {
                  inner_up := raw_up.substring(usize(1), n_up - usize(1));
                  result_up := ((String.from("\"") + inner_up.to_uppercase()) + String.from("\""));
                  return(Option(EvalResult).Some(eval_result(.StrLit(result_up), t_comptime_string())));
                }
              )
            },
            _ => {
              return(Option(EvalResult).None);
            }
          ),
        // StrLit.to_lowercase() — lowercase the inner content
        ((mname == "to_lowercase") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          match(
            recv_val,
            .StrLit(raw_lo) => {
              n_lo := raw_lo.len();
              cond(
                (n_lo < usize(2)) => {
                  return(Option(EvalResult).None);
                },
                true => {
                  inner_lo := raw_lo.substring(usize(1), n_lo - usize(1));
                  result_lo := ((String.from("\"") + inner_lo.to_lowercase()) + String.from("\""));
                  return(Option(EvalResult).Some(eval_result(.StrLit(result_lo), t_comptime_string())));
                }
              )
            },
            _ => {
              return(Option(EvalResult).None);
            }
          ),
        // ---------------------------------------------------------------
        // Phase 3ao: StrLit.parse_i64() — parse the inner string as i64
        // Returns EnumVal(".Some", [IntLit(n)]) or EnumVal(".None", [])
        // ---------------------------------------------------------------
        ((mname == "parse_i64") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(0)))) =>
          match(
            recv_val,
            .StrLit(raw_pi) => {
              n_pi := raw_pi.len();
              cond(
                (n_pi < usize(2)) => {
                  none_pi := ArrayList(EvalValue).new();
                  return(Option(EvalResult).Some(eval_result(.EnumVal(String.from(".None"), none_pi), t_unit())));
                },
                true => {
                  inner_pi := raw_pi.substring(usize(1), n_pi - usize(1));
                  match(
                    parse_raw_int(inner_pi),
                    .None => {
                      none_pi2 := ArrayList(EvalValue).new();
                      return(Option(EvalResult).Some(eval_result(.EnumVal(String.from(".None"), none_pi2), t_unit())));
                    },
                    .Some(n_i64) => {
                      some_pi := ArrayList(EvalValue).new();
                      some_pi.push(.IntLit(n_i64.to_string()));
                      return(Option(EvalResult).Some(eval_result(.EnumVal(String.from(".Some"), some_pi), t_unit())));
                    }
                  )
                }
              )
            },
            _ => {
              return(Option(EvalResult).None);
            }
          ),
        // ---------------------------------------------------------------
        // Phase 5ab: StrLit.replace(old, new) — string replacement
        // ---------------------------------------------------------------
        ((mname == "replace") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(2)))) =>
          match(
            recv_val,
            .StrLit(raw_rep) => {
              n_rep := raw_rep.len();
              cond(
                (n_rep < usize(2)) => {
                  return(Option(EvalResult).None);
                },
                true => {
                  inner_rep := raw_rep.substring(usize(1), n_rep - usize(1));
                  old_arg := match(
                    method_call_args.get(usize(0)),
                    .Some(oa) => match(
                      match(g_eval_fn,.Some(ef) => ef(oa, env),.None => Option(EvalResult).None),
                      .Some(oar) => match(
                        oar.value,
                        .StrLit(s) => s,
                        _ => {
                          return(Option(EvalResult).None);
                        }
                      ),
                      .None => {
                        return(Option(EvalResult).None);
                      }
                    ),
                    .None => {
                      return(Option(EvalResult).None);
                    }
                  );
                  new_arg := match(
                    method_call_args.get(usize(1)),
                    .Some(na) => match(
                      match(g_eval_fn,.Some(ef) => ef(na, env),.None => Option(EvalResult).None),
                      .Some(nar) => match(
                        nar.value,
                        .StrLit(s) => s,
                        _ => {
                          return(Option(EvalResult).None);
                        }
                      ),
                      .None => {
                        return(Option(EvalResult).None);
                      }
                    ),
                    .None => {
                      return(Option(EvalResult).None);
                    }
                  );
                  old_inner := cond((old_arg.len() >= usize(2)) => old_arg.substring(usize(1), old_arg.len() - usize(1)), true => old_arg);
                  new_inner := cond((new_arg.len() >= usize(2)) => new_arg.substring(usize(1), new_arg.len() - usize(1)), true => new_arg);
                  replaced := inner_rep.replace(old_inner, new_inner);
                  result_rep := ((String.from("\"") + replaced) + String.from("\""));
                  return(Option(EvalResult).Some(eval_result(.StrLit(result_rep), t_comptime_string())));
                }
              )
            },
            _ => {
              return(Option(EvalResult).None);
            }
          ),
        // ---------------------------------------------------------------
        // Phase 5ab: StrLit.index_of(needle) — find substring position
        // Returns Option(comptime_int): .Some(IntLit(pos)) or .None
        // ---------------------------------------------------------------
        ((mname == "index_of") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(
            recv_val,
            .StrLit(raw_ix) => {
              n_ix := raw_ix.len();
              cond(
                (n_ix < usize(2)) => {
                  none_ix := ArrayList(EvalValue).new();
                  return(Option(EvalResult).Some(eval_result(.EnumVal(String.from(".None"), none_ix), t_unit())));
                },
                true => {
                  inner_ix := raw_ix.substring(usize(1), n_ix - usize(1));
                  needle_str := match(
                    method_call_args.get(usize(0)),
                    .Some(na2) => match(
                      match(g_eval_fn,.Some(ef) => ef(na2, env),.None => Option(EvalResult).None),
                      .Some(nar2) => match(
                        nar2.value,
                        .StrLit(s) => s,
                        _ => {
                          return(Option(EvalResult).None);
                        }
                      ),
                      .None => {
                        return(Option(EvalResult).None);
                      }
                    ),
                    .None => {
                      return(Option(EvalResult).None);
                    }
                  );
                  needle_inner := cond((needle_str.len() >= usize(2)) => needle_str.substring(usize(1), needle_str.len() - usize(1)), true => needle_str);
                  match(
                    inner_ix.index_of(needle_inner),
                    .Some(pos) => {
                      some_ix := ArrayList(EvalValue).new();
                      some_ix.push(.IntLit(pos.to_string()));
                      return(Option(EvalResult).Some(eval_result(.EnumVal(String.from(".Some"), some_ix), t_unit())));
                    },
                    .None => {
                      none_ix2 := ArrayList(EvalValue).new();
                      return(Option(EvalResult).Some(eval_result(.EnumVal(String.from(".None"), none_ix2), t_unit())));
                    }
                  )
                }
              )
            },
            _ => {
              return(Option(EvalResult).None);
            }
          ),
        // ---------------------------------------------------------------
        // Phase 5ac: StrLit.split(delim) — split string into ArrayVal of StrLits
        // ---------------------------------------------------------------
        ((mname == "split") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(
            recv_val,
            .StrLit(raw_sp) => {
              n_sp := raw_sp.len();
              cond(
                (n_sp < usize(2)) => {
                  return(Option(EvalResult).None);
                },
                true => {
                  inner_sp := raw_sp.substring(usize(1), n_sp - usize(1));
                  delim_str := match(
                    method_call_args.get(usize(0)),
                    .Some(de) => match(
                      match(g_eval_fn,.Some(ef) => ef(de, env),.None => Option(EvalResult).None),
                      .Some(dr) => match(
                        dr.value,
                        .StrLit(s) => s,
                        _ => {
                          return(Option(EvalResult).None);
                        }
                      ),
                      .None => {
                        return(Option(EvalResult).None);
                      }
                    ),
                    .None => {
                      return(Option(EvalResult).None);
                    }
                  );
                  delim_inner := cond((delim_str.len() >= usize(2)) => delim_str.substring(usize(1), delim_str.len() - usize(1)), true => delim_str);
                  parts := inner_sp.split(delim_inner);
                  result_arr := ArrayList(EvalValue).new();
                  (spi : usize) = usize(0);
                  while(spi < parts.len(), {
                    match(
                      parts.get(spi),
                      .Some(part) => {
                        result_arr.push(.StrLit((String.from("\"") + part) + String.from("\"")));
                      },
                      .None => ()
                    );
                    spi = (spi + usize(1));
                  });
                  return(Option(EvalResult).Some(eval_result(.ArrayVal(result_arr), t_unit())));
                }
              )
            },
            _ => {
              return(Option(EvalResult).None);
            }
          ),
        true => ()
      );
      maybe_mval := match(
        env.lookup(qn),
        .Some(mv) => mv.value,
        .None =>
          match(
            env.lookup(mname),
            .Some(mv2) => mv2.value,
            .None => Option(EvalValue).None
          )
      );
      match(
        maybe_mval,
        .None => Option(EvalResult).None,
        .Some(mval) => {
          evaled := ArrayList(EvalResult).new();
          evaled.push(eval_result(recv_val, type_of_eval_value(recv_val)));
          n_ca := method_call_args.len();
          (cai : usize) = usize(0);
          (caok : bool) = true;
          while((cai < n_ca) && caok, {
            match(
              method_call_args.get(cai),
              .Some(aexpr) =>
                match(
                  match(
                    g_eval_fn,
                    .Some(ef) => ef(aexpr, env),
                    .None => Option(EvalResult).None
                  ),
                  .Some(ar) => {
                    evaled.push(ar);
                  },
                  .None => {
                    caok = false;
                  }
                ),
              .None => {
                caok = false;
              }
            );
            cai = (cai + usize(1));
          });
          cond(
            (!(caok)) => Option(EvalResult).None,
            true => call_funcval_with_args(mval, evaled)
          )
        }
      )
    }
  )
);
// ---------------------------------------------------------------------------
// impl handler helper — Phase 3j
// Handles `impl(TypeName, method_name : fn_def, …)` forms.
// Factored out of `evaluate` to reduce evaluate's C stack frame.
// Uses g_eval_fn to evaluate method bodies.
// ---------------------------------------------------------------------------
handle_impl_form :: (
  fn(
    args : ArrayList(AstExpr),
    env : Environment
  ) -> Option(EvalResult)
)(
  match(
    args.get(usize(0)),
    .None => Option(EvalResult).None,
    .Some(ty_expr) =>
      match(
        ty_expr,
        .FnCall(_, _, _, _, _) => Option(EvalResult).None,
        .Atom(_, ty_tok) => {
          ty_nm := ty_tok.value.clone();
          n_margs := args.len();
          (mi : usize) = usize(1);
          (mok : bool) = true;
          while((mi < n_margs) && mok, {
            match(
              args.get(mi),
              .Some(meth_expr) =>
                match(
                  meth_expr,
                  .FnCall(_, colon_func, colon_args, colon_infix, _) => {
                    cond(
                      (colon_infix) =>
                        match(
                          colon_func,
                          .Atom(_, colon_tok) => {
                            cond(
                              (colon_tok.value == ":") => {
                                match(
                                  colon_args.get(usize(0)),
                                  .Some(name_expr) =>
                                    match(
                                      name_expr,
                                      .Atom(_, name_tok) => {
                                        match(
                                          colon_args.get(usize(1)),
                                          .Some(fn_expr) => {
                                            match(
                                              match(
                                                g_eval_fn,
                                                .Some(ef) => ef(fn_expr, env),
                                                .None => Option(EvalResult).None
                                              ),
                                              .Some(mres) => {
                                                qn := `${ty_nm}.${name_tok.value}`;
                                                _dm := env.define_val(
                                                  qn,
                                                  type_of_eval_value(mres.value),
                                                  value_is_comptime(mres.value),
                                                  .Some(mres.value)
                                                );
                                              },
                                              .None => {
                                                mok = false;
                                              }
                                            );
                                          },
                                          .None => ()
                                        );
                                      },
                                      .FnCall(_, _, _, _, _) => ()
                                    ),
                                  .None => ()
                                );
                              },
                              true => ()
                            );
                          },
                          .FnCall(_, _, _, _, _) => ()
                        ),
                      true => {
                        // Non-infix FnCall: may be a trait constructor like
                        // ToString(to_string: fn_def). Iterate its args and
                        // register any colon-pair method impls.
                        (tmi : usize) = usize(0);
                        while((tmi < colon_args.len()) && mok, {
                          match(
                            colon_args.get(tmi),
                            .Some(inner_expr) =>
                              match(
                                inner_expr,
                                .FnCall(_, inner_func, inner_args, inner_infix, _) => {
                                  cond(
                                    (inner_infix) =>
                                      match(
                                        inner_func,
                                        .Atom(_, inner_tok) => {
                                          cond(
                                            (inner_tok.value == ":") => {
                                              match(
                                                inner_args.get(usize(0)),
                                                .Some(iname_expr) =>
                                                  match(
                                                    iname_expr,
                                                    .Atom(_, iname_tok) => {
                                                      match(
                                                        inner_args.get(usize(1)),
                                                        .Some(ifn_expr) => {
                                                          match(
                                                            match(
                                                              g_eval_fn,
                                                              .Some(ef) => ef(ifn_expr, env),
                                                              .None => Option(EvalResult).None
                                                            ),
                                                            .Some(imres) => {
                                                              iqn := `${ty_nm}.${iname_tok.value}`;
                                                              _idm := env.define_val(
                                                                iqn,
                                                                type_of_eval_value(imres.value),
                                                                value_is_comptime(imres.value),
                                                                .Some(imres.value)
                                                              );
                                                            },
                                                            .None => {
                                                              mok = false;
                                                            }
                                                          );
                                                        },
                                                        .None => ()
                                                      );
                                                    },
                                                    .FnCall(_, _, _, _, _) => ()
                                                  ),
                                                .None => ()
                                              );
                                            },
                                            true => ()
                                          );
                                        },
                                        .FnCall(_, _, _, _, _) => ()
                                      ),
                                    true => ()
                                  );
                                },
                                .Atom(_, _) => ()
                              ),
                            .None => ()
                          );
                          tmi = (tmi + usize(1));
                        });
                      }
                    );
                  },
                  _ => ()
                ),
              .None => ()
            );
            mi = (mi + usize(1));
          });
          cond(
            (!(mok)) => Option(EvalResult).None,
            true =>.Some(eval_result(.UnitVal, t_unit()))
          )
        }
      )
  )
);
/// Evaluate a list of top-level module expressions and collect exports.
///
/// Iterates `exprs`, evaluating each one through `g_eval_fn`. When an
/// `export(name1, name2, …)` call is encountered the named variables are
/// looked up in `env` and appended to the result source-namespace StructVal.
///
/// Returns a source-namespace `StructVal` on success, or `None` if
/// `g_eval_fn` is not set or any expression fails to evaluate.
evaluate_module_body :: (fn(exprs : ArrayList(AstExpr), env : Environment) -> Option(EvalValue))({
  names := ArrayList(String).new();
  values := ArrayList(EvalValue).new();
  n := exprs.len();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < n) && ok, {
    match(
      exprs.get(i),
      .Some(expr) =>
        match(
          expr,
          // export(name1, name2, …) — collect exported bindings
          .FnCall(_, fb, fargs, _, _) =>
            match(
              fb,
              .Atom(_, ftok) =>
                cond(
                  (ftok.value == BK_EXPORT) => {
                    j := usize(0);
                    nj := fargs.len();
                    while((j < nj) && ok, {
                      match(
                        fargs.get(j),
                        .Some(export_expr) =>
                          match(
                            export_expr,
                            .Atom(_, name_tok) => {
                              match(
                                env.lookup(name_tok.value.clone()),
                                .Some(var) => {
                                  exported_val := match(
                                    var.value,
                                    .Some(v) => v,
                                    .None => EvalValue.VarRef(name_tok.value.clone())
                                  );
                                  names.push(name_tok.value.clone());
                                  values.push(exported_val);
                                },
                                .None => {
                                  ok = false;
                                }
                              );
                            },
                            // Expression export: evaluate the expression and export result
                            .FnCall(_, _, _, _, _) =>
                              match(
                                g_eval_fn,
                                .Some(eval_fn) =>
                                  match(
                                    eval_fn(export_expr, env),
                                    .Some(expr_res) => {
                                      names.push(String.from("_"));
                                      values.push(expr_res.value);
                                    },
                                    .None => {
                                      ok = false;
                                    }
                                  ),
                                .None => {
                                  ok = false;
                                }
                              )
                          ),
                        .None => {
                          ok = false;
                        }
                      );
                      j = (j + usize(1));
                    });
                  },
                  // Regular expression — evaluate normally
                  true =>
                    match(
                      g_eval_fn,
                      .Some(eval_fn) =>
                        match(
                          eval_fn(expr, env),
                          .Some(_) => (),
                          .None => {
                            ok = false;
                          }
                        ),
                      .None => {
                        ok = false;
                      }
                    )
                ),
              .FnCall(_, _, _, _, _) =>
                // Complex func head — evaluate normally
                match(
                  g_eval_fn,
                  .Some(eval_fn) =>
                    match(
                      eval_fn(expr, env),
                      .Some(_) => (),
                      .None => {
                        ok = false;
                      }
                    ),
                  .None => {
                    ok = false;
                  }
                )
            ),
          // Atom at module level — evaluate normally
          .Atom(_, _) =>
            match(
              g_eval_fn,
              .Some(eval_fn) =>
                match(
                  eval_fn(expr, env),
                  .Some(_) => (),
                  .None => {
                    ok = false;
                  }
                ),
              .None => {
                ok = false;
              }
            )
        ),
      .None => {
        ok = false;
      }
    );
    i = (i + usize(1));
  });
  cond(
    ok =>.Some(.StructVal(`source_namespace_${random_id(env.module_path)}`, names, values)),
    true => Option(EvalValue).None
  )
});
// ---------------------------------------------------------------------------
// Phase 3n helpers — factored out of evaluate to keep its ASAN frame small.
// ---------------------------------------------------------------------------
/// Handle `if(cond, then)` or `if(cond, then, else)`.
/// Uses g_eval_fn for recursive evaluation.
// ---------------------------------------------------------------------------
// Anonymous struct literal helper — Phase 2bk
// Handles _(field: val, …) and _(val, …) in the mini-evaluator.
// Factored out of evaluate to keep evaluate's C stack frame small.
// ---------------------------------------------------------------------------
handle_anon_struct_form :: (
  fn(
    args : ArrayList(AstExpr),
    env : Environment
  ) -> Option(EvalResult)
)({
  n_as := args.len();
  fn_as := ArrayList(String).new();
  fv_as := ArrayList(EvalValue).new();
  (as_i : usize) = usize(0);
  (as_ok : bool) = true;
  while((as_i < n_as) && as_ok, {
    match(
      args.get(as_i),
      .Some(as_arg) =>
        match(
          as_arg,
          // Could be a labeled field: label : value  (infix ":" call)
          .FnCall(_, as_f, as_na, as_infix, _) =>
            cond(
              (as_infix && match(as_f,.Atom(_, as_ct) => (as_ct.value == ":"),.FnCall(_, _, _, _, _) => false)) =>
                match(
                  as_na.get(usize(0)),
                  .Some(as_le) =>
                    match(
                      as_le,
                      .Atom(_, as_lt) =>
                        match(
                          as_na.get(usize(1)),
                          .Some(as_ve) =>
                            match(
                              match(g_eval_fn,.Some(ef) => ef(as_ve, env),.None => Option(EvalResult).None),
                              .Some(as_vr) => {
                                fn_as.push(as_lt.value);
                                fv_as.push(as_vr.value);
                              },
                              .None => {
                                as_ok = false;
                              }
                            ),
                          .None => {
                            as_ok = false;
                          }
                        ),
                      .FnCall(_, _, _, _, _) => {
                        as_ok = false;
                      }
                    ),
                  .None => {
                    as_ok = false;
                  }
                ),
              // positional FnCall field
              true =>
                match(
                  match(g_eval_fn,.Some(ef) => ef(as_arg, env),.None => Option(EvalResult).None),
                  .Some(as_pr) => {
                    fn_as.push(String.from("__field_").concat(as_i.to_string()));
                    fv_as.push(as_pr.value);
                  },
                  .None => {
                    as_ok = false;
                  }
                )
            ),
          // positional Atom field (e.g., integer, bool literal)
          .Atom(_, _) =>
            match(
              match(g_eval_fn,.Some(ef) => ef(as_arg, env),.None => Option(EvalResult).None),
              .Some(as_pr) => {
                fn_as.push(String.from("__field_").concat(as_i.to_string()));
                fv_as.push(as_pr.value);
              },
              .None => {
                as_ok = false;
              }
            )
        ),
      .None => {
        as_ok = false;
      }
    );
    as_i = (as_i + usize(1));
  });
  cond(
    (!(as_ok)) => Option(EvalResult).None,
    true =>.Some(eval_result(.StructVal(String.from("_"), fn_as, fv_as), t_unit()))
  )
});
handle_if_form :: (
  fn(
    args : ArrayList(AstExpr),
    env : Environment
  ) -> Option(EvalResult)
)({
  n_if := args.len();
  match(
    args.get(usize(0)),
    .None => Option(EvalResult).None,
    .Some(cond_expr) =>
      match(
        match(
          g_eval_fn,
          .Some(ef) => ef(cond_expr, env),
          .None => Option(EvalResult).None
        ),
        .None => Option(EvalResult).None,
        .Some(cond_r) =>
          match(
            cond_r.value,
            .BoolVal(b) =>
              cond(
                b =>
                  match(
                    args.get(usize(1)),
                    .Some(then_e) =>
                      match(g_eval_fn,.Some(ef) => ef(then_e, env),.None => Option(EvalResult).None),
                    .None => Option(EvalResult).None
                  ),
                (n_if >= usize(3)) =>
                  match(
                    args.get(usize(2)),
                    .Some(else_e) =>
                      match(g_eval_fn,.Some(ef) => ef(else_e, env),.None => Option(EvalResult).None),
                    .None => Option(EvalResult).None
                  ),
                true =>.Some(eval_result(.UnitVal, t_unit()))
              ),
            _ => Option(EvalResult).None
          )
      )
  )
});
/// Fold `lv op rv` where both sides are float.  `fval` is "+", "-", "*", "/".
eval_float_arith :: (fn(fval : String, lv : EvalResult, rv : EvalResult) -> Option(EvalResult))({
  lv_ty := lv.ty;
  a_raw := match(
    lv.value,
    .FloatLit(raw) => raw,
    _ => {
      return(Option(EvalResult).None);
    }
  );
  b_raw := match(
    rv.value,
    .FloatLit(raw) => raw,
    _ => {
      return(Option(EvalResult).None);
    }
  );
  a := match(
    parse_raw_float(a_raw),
    .Some(x) => x,
    .None => {
      return(Option(EvalResult).None);
    }
  );
  b := match(
    parse_raw_float(b_raw),
    .Some(x) => x,
    .None => {
      return(Option(EvalResult).None);
    }
  );
  res_opt := cond(
    (fval == "+") => Option(f64).Some(a + b),
    (fval == "-") => Option(f64).Some(a - b),
    (fval == "*") => Option(f64).Some(a * b),
    (fval == "/") => cond((b == f64(0)) => Option(f64).None, true => Option(f64).Some(a / b)),
    true => Option(f64).None
  );
  match(
    res_opt,
    .Some(res) =>.Some(eval_result(.FloatLit(res.to_string()), lv_ty)),
    .None => Option(EvalResult).None
  )
});
/// Compare two float EvalResults with operator `fval` (==, !=, <, >, <=, >=).
eval_float_cmp :: (fn(fval : String, lv : EvalResult, rv : EvalResult) -> Option(EvalResult))({
  a_raw := match(
    lv.value,
    .FloatLit(raw) => raw,
    _ => {
      return(Option(EvalResult).None);
    }
  );
  b_raw := match(
    rv.value,
    .FloatLit(raw) => raw,
    _ => {
      return(Option(EvalResult).None);
    }
  );
  a := match(
    parse_raw_float(a_raw),
    .Some(x) => x,
    .None => {
      return(Option(EvalResult).None);
    }
  );
  b := match(
    parse_raw_float(b_raw),
    .Some(x) => x,
    .None => {
      return(Option(EvalResult).None);
    }
  );
  res := cond(
    (fval == "==") => (a == b),
    (fval == "!=") => (!(a == b)),
    (fval == "<") => (a < b),
    (fval == ">") => (a > b),
    (fval == "<=") => (a <= b),
    (fval == ">=") => (a >= b),
    true => {
      return(Option(EvalResult).None);
    }
  );
  .Some(eval_result(.BoolVal(res), t_bool()))
});
/// Negate a float EvalResult.
eval_float_neg :: (fn(v : EvalResult) -> Option(EvalResult))({
  v_ty := v.ty;
  match(
    v.value,
    .FloatLit(raw) => {
      a := match(
        parse_raw_float(raw),
        .Some(x) => x,
        .None => {
          return(Option(EvalResult).None);
        }
      );
      .Some(eval_result(.FloatLit((f64(0.0) - a).to_string()), v_ty))
    },
    _ => Option(EvalResult).None
  )
});
/// Extract the parameter name from `comptime(Name)` form.
/// Returns `Some(name)` when the box is `comptime(Atom(name))`, else `None`.
extract_comptime_param_name :: (
  fn(
    ct_box : AstExpr,
    ct_args : ArrayList(AstExpr)
  ) -> Option(String)
)(
  match(
    ct_box,
    .Atom(_, ct_tok) =>
      cond(
        (ct_tok.value == "comptime") =>
          match(
            ct_args.get(usize(0)),
            .Some(ct_name_e) =>
              match(
                ct_name_e,
                .Atom(_, ct_name_tok) =>.Some(ct_name_tok.value),
                .FnCall(_, _, _, _, _) => Option(String).None
              ),
            .None => Option(String).None
          ),
        true => Option(String).None
      ),
    .FnCall(_, _, _, _, _) => Option(String).None
  )
);
/// Extract the parameter name from a `quote(name)` quoted parameter.
/// Returns the name if `ct_box` is `Atom("quote")` and `ct_args[0]` is an
/// `Atom(name)`; otherwise returns `None`.
///
/// Mirrors TS `parameter.isQuote` detection in
/// `src/evaluator/types/function.ts` (the `quote(name) : T` syntax).
extract_quote_param_name :: (
  fn(
    ct_box : AstExpr,
    ct_args : ArrayList(AstExpr)
  ) -> Option(String)
)(
  match(
    ct_box,
    .Atom(_, ct_tok) =>
      cond(
        (ct_tok.value == "quote") =>
          match(
            ct_args.get(usize(0)),
            .Some(qn_e) =>
              match(
                qn_e,
                .Atom(_, qn_tok) =>.Some(qn_tok.value),
                .FnCall(_, _, _, _, _) => Option(String).None
              ),
            .None => Option(String).None
          ),
        true => Option(String).None
      ),
    .FnCall(_, _, _, _, _) => Option(String).None
  )
);
/// Extract the evidence parameter name from the inner expression of a
/// `...` parameter declaration.
///
/// For `name : Type` the inner expression is
/// `FnCall(Atom(":"), [Atom("name"), type_expr], true)` → returns `"name"`.
/// For `name` the inner expression is `Atom("name")` → returns `"name"`.
extract_evidence_param_name :: (fn(ev_inner : AstExpr) -> Option(String))(
  match(
    ev_inner,
    .FnCall(_, ev_kw_box, ev_kw_args, _, _) =>
      match(
        ev_kw_box,
        .Atom(_, ev_kw_tok) =>
          cond(
            (ev_kw_tok.value == ":") =>
              match(
                ev_kw_args.get(usize(0)),
                .Some(ev_name_expr) =>
                  match(
                    ev_name_expr,
                    .Atom(_, ev_name_tok) => Option(String).Some(ev_name_tok.value),
                    .FnCall(_, _, _, _, _) => Option(String).None
                  ),
                .None => Option(String).None
              ),
            true => Option(String).None
          ),
        .FnCall(_, _, _, _, _) => Option(String).None
      ),
    .Atom(_, ev_bare_tok) => Option(String).Some(ev_bare_tok.value)
  )
);
/// Evaluate a `inner_expr` form at a call site.
///
/// `name` passes the value of `name` from the caller's environment as
/// evidence to the callee.  This allows the evaluator to resolve evidence
/// params bound by `name : Type` declarations in the callee.
handle_using_call :: (
  fn(
    args : ArrayList(AstExpr),
    env : Environment
  ) -> Option(EvalResult)
)(
  match(
    g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) =>
      match(
        args.get(usize(0)),
        .Some(inner_expr) => ef(inner_expr, env),
        .None => Option(EvalResult).None
      )
  )
);
// ---------------------------------------------------------------------------
// Type definition helpers — Phase 3z
// Factored out to keep evaluate's frame small (ASAN concern).
// ---------------------------------------------------------------------------
/// Evaluate `enum(None, Some(value: T), ...)` and produce `TypeVal(EnumT(...))`.
///
/// Each arg to `enum(...)` is a variant descriptor (NOT dot-prefixed):
///   - Atom: `Less` — fieldless variant
///   - FnCall: `Some(value: T)` — variant with labeled fields
///   - Infix `=`: `Red = 0` or `Some(x: i32) = 5` — variant with explicit discriminant
///
/// Field types are evaluated via `ef` to extract their TypeValues.
handle_enum_def :: (
  fn(
    args : ArrayList(AstExpr),
    env : Environment
  ) -> Option(EvalResult)
)(
  match(
    g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) => {
      enum_id := `enum_${random_id(String.from(""))}`;
      v_names := ArrayList(String).new();
      v_fields_all := ArrayList(ArrayList(TypeValue)).new();
      v_labels_all := ArrayList(ArrayList(String)).new();
      v_discs := ArrayList(i64).new();
      (next_disc : i64) = i64(0);
      (ok : bool) = true;
      n := args.len();
      (i : usize) = usize(0);
      while((i < n) && ok, {
        match(
          args.get(i),
          .Some(variant_expr) => {
            // Detect custom discriminant wrapper: vcore = discriminant
            (disc_opt : Option(i64)) = Option(i64).None;
            (vcore_expr : AstExpr) = variant_expr;
            is_eq_wrap := match(
              variant_expr,
              .FnCall(_, fb, _, vis_infix, _) =>
                match(fb,.Atom(_, tok) => ((tok.value == "=") && vis_infix),.FnCall(_, _, _, _, _) => false),
              .Atom(_, _) => false
            );
            if(is_eq_wrap, {
              match(
                variant_expr,
                .FnCall(_, _, eq_args, _, _) => {
                  match(
                    eq_args.get(usize(0)),
                    .Some(lhs_e) => {
                      vcore_expr = lhs_e;
                    },
                    .None => {
                      ok = false;
                    }
                  );
                  match(
                    eq_args.get(usize(1)),
                    .Some(disc_e) =>
                      match(
                        ef(disc_e, env),
                        .Some(dr) =>
                          match(
                            dr.value,
                            .IntLit(s) => {
                              d := match(parse_raw_int(s),.Some(x) => x,.None => i64(0));
                              disc_opt =.Some(d);
                            },
                            _ => ()
                          ),
                        .None => ()
                      ),
                    .None => ()
                  );
                },
                .Atom(_, _) => ()
              );
            });
            // Compute discriminant value and advance counter
            disc := match(
              disc_opt,
              .Some(d) => {
                next_disc = (d + i64(1));
                d
              },
              .None => {
                d := next_disc;
                next_disc = (next_disc + i64(1));
                d
              }
            );
            // Handle variant core expression:
            //   Atom("None")              → fieldless variant
            //   FnCall(Atom("Some"), [...]) → variant with fields
            match(
              vcore_expr,
              .Atom(_, vtok) => {
                vname_s := vtok.value.clone();
                cond(
                  (vname_s == "_") => {
                    ok = false;
                  },
                  true => {
                    v_names.push(vname_s);
                    v_fields_all.push(ArrayList(TypeValue).new());
                    v_labels_all.push(ArrayList(String).new());
                    v_discs.push(disc);
                  }
                );
              },
              .FnCall(_, vfunc_box, vfield_args, _, _) => {
                vname_s := match(
                  vfunc_box,
                  .Atom(_, vftok) => vftok.value.clone(),
                  .FnCall(_, _, _, _, _) => {
                    ok = false;
                    String.new()
                  }
                );
                cond(
                  (!(ok)) => (),
                  true => {
                    field_tys := ArrayList(TypeValue).new();
                    field_lbs := ArrayList(String).new();
                    n_vf := vfield_args.len();
                    (vfi : usize) = usize(0);
                    (vfok : bool) = true;
                    while((vfi < n_vf) && vfok, {
                      match(
                        vfield_args.get(vfi),
                        .Some(field_e) => {
                          // `label : type_expr` labeled field
                          is_colon_field := match(
                            field_e,
                            .FnCall(_, fc_box, _, fc_infix, _) =>
                              match(fc_box,.Atom(_, fc_tok) => ((fc_tok.value == ":") && fc_infix),.FnCall(_, _, _, _, _) => false),
                            .Atom(_, _) => false
                          );
                          cond(
                            is_colon_field => {
                              match(
                                field_e,
                                .FnCall(_, _, fc_args, _, _) => {
                                  flabel := match(
                                    fc_args.get(usize(0)),
                                    .Some(le) => match(le,.Atom(_, ltok) => ltok.value.clone(),.FnCall(_, _, _, _, _) => String.new()),
                                    .None => String.new()
                                  );
                                  fty := match(
                                    fc_args.get(usize(1)),
                                    .Some(te) =>
                                      match(
                                        ef(te, env),
                                        .Some(tr) => match(tr.value,.TypeVal(tb) => tb, _ => t_unit()),
                                        .None => t_unit()
                                      ),
                                    .None => t_unit()
                                  );
                                  field_lbs.push(flabel.clone());
                                  field_tys.push(fty);
                                },
                                .Atom(_, _) => ()
                              );
                            },
                            // Unlabeled field: just a type expression
                            true => {
                              fty := match(
                                ef(field_e, env),
                                .Some(fr) => match(fr.value,.TypeVal(tb) => tb, _ => t_unit()),
                                .None => t_unit()
                              );
                              field_lbs.push(String.from(""));
                              field_tys.push(fty);
                            }
                          );
                        },
                        .None => {
                          vfok = false;
                        }
                      );
                      vfi = (vfi + usize(1));
                    });
                    v_names.push(vname_s);
                    v_fields_all.push(field_tys);
                    v_labels_all.push(field_lbs);
                    v_discs.push(disc);
                    if(!(vfok), {
                      ok = false;
                    });
                  }
                );
              }
            );
          },
          .None => {
            ok = false;
          }
        );
        i = (i + usize(1));
      });
      cond(
        (!(ok)) => Option(EvalResult).None,
        true =>
          .Some(
            eval_result(
              .TypeVal(
                TypeValue.EnumT(
                  enum_id.clone(),
                  String.from(""),
                  v_names,
                  v_fields_all,
                  Option(String).None,
                  v_labels_all,
                  v_discs,
                  false,
                  false
                )
              ),
              t_type()
            )
          )
      )
    }
  )
);
/// Evaluate `struct(name: Type, ...)`, `object(name: Type, ...)`, or
/// `newtype(wrapped_type)` and produce `TypeVal(Struct(...))`.
///
/// Each arg is expected to be a labeled field `name : type_expr`.
/// For newtype, a single unlabeled type expression is also accepted.
handle_struct_def :: (
  fn(
    args : ArrayList(AstExpr),
    is_ref_sem : bool,
    is_newtype : bool,
    env : Environment
  ) -> Option(EvalResult)
)(
  match(
    g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) => {
      struct_id := `struct_${random_id(String.from(""))}`;
      f_labels := ArrayList(String).new();
      f_types := ArrayList(TypeValue).new();
      (ok : bool) = true;
      n := args.len();
      (i : usize) = usize(0);
      while((i < n) && ok, {
        match(
          args.get(i),
          .Some(field_expr) => {
            // Check for labeled field: `name : type_expr` (infix :)
            is_labeled := match(
              field_expr,
              .FnCall(_, fb, _, finfix, _) =>
                match(fb,.Atom(_, tok) => ((tok.value == ":") && finfix),.FnCall(_, _, _, _, _) => false),
              .Atom(_, _) => false
            );
            cond(
              is_labeled => {
                match(
                  field_expr,
                  .FnCall(_, _, fargs, _, _) => {
                    fname := match(
                      fargs.get(usize(0)),
                      .Some(ne) => match(ne,.Atom(_, tok) => tok.value.clone(),.FnCall(_, _, _, _, _) => String.new()),
                      .None => String.new()
                    );
                    match(
                      fargs.get(usize(1)),
                      .Some(type_expr) =>
                        match(
                          ef(type_expr, env),
                          .Some(fres) => {
                            fty := match(fres.value,.TypeVal(tyb) => tyb, _ => t_unit());
                            f_labels.push(fname);
                            f_types.push(fty);
                          },
                          .None => {
                            f_labels.push(fname);
                            f_types.push(t_unit());
                          }
                        ),
                      .None => ()
                    );
                  },
                  .Atom(_, _) => ()
                );
              },
              // Unlabeled field (e.g. newtype single-arg): evaluate as type
              true => {
                match(
                  ef(field_expr, env),
                  .Some(fres) => {
                    fty := match(fres.value,.TypeVal(tyb) => tyb, _ => t_unit());
                    f_labels.push(String.from("*"));
                    f_types.push(fty);
                  },
                  .None => {
                    f_labels.push(String.from("*"));
                    f_types.push(t_unit());
                  }
                );
              }
            );
          },
          .None => {
            ok = false;
          }
        );
        i = (i + usize(1));
      });
      cond(
        (!(ok)) => Option(EvalResult).None,
        true =>
          .Some(
            eval_result(
              .TypeVal(
                TypeValue.Struct(
                  struct_id.clone(),
                  String.from(""),
                  f_labels,
                  f_types,
                  is_ref_sem,
                  false,
                  is_newtype,
                  String.from(""),
                  ArrayList(TypeValue).new(),
                  false
                )
              ),
              t_type()
            )
          )
      )
    }
  )
);
/// Evaluate `union(name: Type, ...)` and produce `TypeVal(Union(...))`.
handle_union_def :: (
  fn(
    args : ArrayList(AstExpr),
    env : Environment
  ) -> Option(EvalResult)
)(
  match(
    g_eval_fn,
    .None => Option(EvalResult).None,
    .Some(ef) => {
      f_labels := ArrayList(String).new();
      f_types := ArrayList(TypeValue).new();
      (ok : bool) = true;
      n := args.len();
      (i : usize) = usize(0);
      while((i < n) && ok, {
        match(
          args.get(i),
          .Some(field_expr) => {
            is_labeled := match(
              field_expr,
              .FnCall(_, fb, _, finfix, _) =>
                match(fb,.Atom(_, tok) => ((tok.value == ":") && finfix),.FnCall(_, _, _, _, _) => false),
              .Atom(_, _) => false
            );
            cond(
              is_labeled => {
                match(
                  field_expr,
                  .FnCall(_, _, fargs, _, _) => {
                    fname := match(
                      fargs.get(usize(0)),
                      .Some(ne) => match(ne,.Atom(_, tok) => tok.value.clone(),.FnCall(_, _, _, _, _) => String.new()),
                      .None => String.new()
                    );
                    match(
                      fargs.get(usize(1)),
                      .Some(type_expr) =>
                        match(
                          ef(type_expr, env),
                          .Some(fres) => {
                            fty := match(fres.value,.TypeVal(tyb) => tyb, _ => t_unit());
                            f_labels.push(fname);
                            f_types.push(fty);
                          },
                          .None => {
                            f_labels.push(fname);
                            f_types.push(t_unit());
                          }
                        ),
                      .None => ()
                    );
                  },
                  .Atom(_, _) => ()
                );
              },
              true => {
                match(
                  ef(field_expr, env),
                  .Some(fres) => {
                    fty := match(fres.value,.TypeVal(tyb) => tyb, _ => t_unit());
                    f_labels.push(String.from(""));
                    f_types.push(fty);
                  },
                  .None => {
                    f_labels.push(String.from(""));
                    f_types.push(t_unit());
                  }
                );
              }
            );
          },
          .None => {
            ok = false;
          }
        );
        i = (i + usize(1));
      });
      cond(
        (!(ok)) => Option(EvalResult).None,
        true =>
          .Some(
            eval_result(
              .TypeVal(
                TypeValue.Union(
                  String.from(""),
                  f_labels,
                  f_types
                )
              ),
              t_type()
            )
          )
      )
    }
  )
);
/// Simplified `trait(...)` handler.
///
/// Phase 3z stub: creates an empty `TraitT` TypeValue so that `trait` definitions
/// can be assigned to names in the environment. Method signatures are NOT
/// currently evaluated (deferred to a later phase).
handle_trait_def :: (
  fn(
    _args : ArrayList(AstExpr),
    _env : Environment
  ) -> Option(EvalResult)
)(
  cond(
    true => {
      trait_id := `trait_${random_id(String.from(""))}`;
      .Some(
        eval_result(
          .TypeVal(
            TypeValue.TraitT(
              String.from(""),
              ArrayList(String).new(),
              ArrayList(String).new(),
              ArrayList(TypeValue).new(),
              trait_id.clone(),
              Option(TypeValue).None,
              ArrayList(TypeValue).new(),
              ArrayList(TypeValue).new()
            )
          ),
          t_type()
        )
      )
    }
  )
);
/// Recursively rewrite `unquote(name)` sub-expressions inside a quoted
/// AST.  For each `unquote(name)` call where `name` is bound to an
/// `ExprVal(inner_ast)` in `env`, the entire `unquote(...)` node is
/// replaced by `inner_ast`.  Other expressions are returned unchanged
/// (with their children spliced).
///
/// Mirrors the AST-walk in `src/evaluator/builtins/quote.ts` (the
/// `spliceUnquotes` helper).  Implemented as a `recur`-style function
/// because Yo functions are first-class but not directly self-recursive
/// without `recur(...)`.
splice_unquote :: (fn(e : AstExpr, env : Environment) -> AstExpr)(
  match(
    e,
    .Atom(_, _) => e,
    .FnCall(fid, func_box, args, is_infix, ftok) => {
      // Detect `unquote(name)` shape: head is Atom("unquote"), exactly 1 arg,
      // and the arg is an Atom identifier whose name is bound in env to ExprVal.
      is_unquote := match(
        func_box,
        .Atom(_, htok) => (htok.value == "unquote"),
        .FnCall(_, _, _, _, _) => false
      );
      cond(
        (is_unquote && (args.len() == usize(1))) =>
          match(
            args.get(usize(0)),
            .None => e,
            .Some(arg0) =>
              // Evaluate the unquote argument: if it's an ExprVal, splice
              // in its wrapped AST; otherwise leave the original expr.
              match(
                match(
                  g_eval_fn,
                  .Some(efn) => efn(arg0, env),
                  .None => Option(EvalResult).None
                ),
                .None => e,
                .Some(rv) =>
                  match(
                    rv.value,
                    .ExprVal(inner_box) => inner_box,
                    _ => e
                  )
              )
          ),
        true => {
          // Generic walk: splice into func_box and each arg.
          new_func := recur(func_box, env);
          new_args := ArrayList(AstExpr).new();
          n_su := args.len();
          (i_su : usize) = usize(0);
          while(i_su < n_su, {
            match(
              args.get(i_su),
              .Some(child) => {
                new_args.push(recur(child, env));
              },
              .None => ()
            );
            i_su = (i_su + usize(1));
          });
          .FnCall(fid, new_func, new_args, is_infix, ftok)
        }
      )
    }
  )
);
/// Evaluate a single `AstExpr` node in the given environment.
///
/// Returns `None` for expression forms not yet handled (Phase 3e+ scope).
evaluate :: (fn(e : AstExpr, env : Environment) -> Option(EvalResult))(
  match(
    e,
    .Atom(_, tok) =>
      eval_atom(tok, env),
    .FnCall(_, func_box, args, is_infix, _tok) =>
      match(
        func_box,
        // -----------------------------------------------------------------
        // Enum variant construction with args: .Some(42), .Ok(x), …
        //   func_box = FnCall(Atom(Dot), [Atom("Some")], true)
        //   outer args = [arg1, arg2, …]
        //
        // Function definition: (fn(params) -> RetType)(body)
        //   func_box = FnCall(Atom("->"), [FnCall(Atom("fn"), [...]), RetType], true)
        //   outer args = [body_expr]
        // -----------------------------------------------------------------
        .FnCall(_, inner_func, inner_args, _, _) =>
          match(
            inner_func,
            .Atom(_, dt) =>
              cond(
                // ---- Dot head: two cases ----
                // 1. Self-hosted method call:
                //    FnCall(FnCall(Dot,[recv,method],true), outer_args, false)
                //    inner_args.len() == 2: [receiver_expr, method_name_expr]
                //    Evaluate receiver, then dispatch via handle_method_dispatch.
                //
                // 2. TS-format enum variant with args:
                //    FnCall(FnCall(Dot,[Atom("VName")],true), fields, false)
                //    inner_args.len() == 1: [Atom("VariantName")]
                //    Build EnumVal with evaluated outer args as fields.
                (dt.kind == TokenKind.Dot) =>
                  cond(
                    // Method call: inner_args has 2 elements [receiver, method_name]
                    (inner_args.len() == usize(2)) => {
                      recv_expr := match(
                        inner_args.get(usize(0)),
                        .Some(x) => x,
                        .None => {
                          return(Option(EvalResult).None);
                        }
                      );
                      method_expr := match(
                        inner_args.get(usize(1)),
                        .Some(x) => x,
                        .None => {
                          return(Option(EvalResult).None);
                        }
                      );
                      // Phase 3am SH-format ArrayVal.push pre-pass:
                      // In self-hosted format, arr.push(x) parses as (arr.push)(x),
                      // so handle_array_push_mutation (TS-format path) is never called.
                      // Mirror the push logic here for bare-identifier ArrayVal receivers.
                      match(
                        method_expr,
                        .Atom(_, sh_push_tok) =>
                          cond(
                            ((sh_push_tok.value == "push") && (args.len() == usize(1))) =>
                              match(
                                recv_expr,
                                .Atom(_, sh_arr_tok) =>
                                  match(
                                    env.lookup(sh_arr_tok.value),
                                    .None => (),
                                    .Some(sh_var) =>
                                      match(
                                        sh_var.value,
                                        .None => (),
                                        .Some(sh_arr_ev) =>
                                          match(
                                            sh_arr_ev,
                                            .ArrayVal(sh_items) =>
                                              match(
                                                args.get(usize(0)),
                                                .None => (),
                                                .Some(sh_push_arg) =>
                                                  match(
                                                    match(
                                                      g_eval_fn,
                                                      .Some(ef_sh) => ef_sh(sh_push_arg, env),
                                                      .None => Option(EvalResult).None
                                                    ),
                                                    .None => (),
                                                    .Some(sh_push_res) => {
                                                      sh_items.push(sh_push_res.value);
                                                      return(Option(EvalResult).Some(eval_result(.UnitVal, t_unit())));
                                                    }
                                                  )
                                              ),
                                            _ => ()
                                          )
                                      )
                                  ),
                                _ => ()
                              ),
                            true => ()
                          ),
                        .FnCall(_, _, _, _, _) => ()
                      );
                      recv_res := match(
                        recur(recv_expr, env),
                        .Some(x) => x,
                        .None => {
                          return(Option(EvalResult).None);
                        }
                      );
                      // Phase 5ar: TypeVal.Variant(args) — self-hosted format
                      // Only treat as variant construction if the TypeVal wraps an EnumT.
                      // Other TypeVals (StructT, etc.) fall through to method dispatch.
                      sh_is_enum_tv := match(recv_res.value,.TypeVal(tv_box) => match(tv_box,.EnumT(_, _, _, _, _, _, _, _, _) => true, _ => false), _ => false);
                      if(sh_is_enum_tv, {
                        sh_vn_name_sr := match((&(method_expr)).*,.Atom(_, sh_vtk) => sh_vtk.value.clone(),.FnCall(_, _, _, _, _) => String.new());
                        if(sh_vn_name_sr != "", {
                          sh_vn_str_sr := `.${sh_vn_name_sr}`;
                          sh_vn_fields_sr := ArrayList(EvalValue).new();
                          n_sh_vn_sr := args.len();
                          (sh_vi_sr : usize) = usize(0);
                          (sh_vok_sr : bool) = true;
                          while((sh_vi_sr < n_sh_vn_sr) && sh_vok_sr, {
                            match(
                              args.get(sh_vi_sr),
                              .Some(sh_va_expr_sr) =>
                                match(
                                  recur(sh_va_expr_sr, env),
                                  .Some(sh_vr_sr) => {
                                    sh_vn_fields_sr.push(sh_vr_sr.value);
                                  },
                                  .None => {
                                    sh_vok_sr = false;
                                  }
                                ),
                              .None => {
                                sh_vok_sr = false;
                              }
                            );
                            sh_vi_sr = (sh_vi_sr + usize(1));
                          });
                          cond(
                            (!(sh_vok_sr)) => {
                              return(Option(EvalResult).None);
                            },
                            true => {
                              return(Option(EvalResult).Some(eval_result(.EnumVal(sh_vn_str_sr, sh_vn_fields_sr), t_unit())));
                            }
                          );
                        });
                      });
                      handle_method_dispatch(recv_res.value, method_expr, args, env)
                    },
                    // TS-format enum variant with args: inner_args has 1 element
                    true => {
                      vname := match(
                        inner_args.get(usize(0)),
                        .Some(vne) => match(
                          vne,
                          .Atom(_, vntok) => vntok.value.clone(),
                          .FnCall(_, _, _, _, _) => {
                            return(Option(EvalResult).None);
                          }
                        ),
                        .None => {
                          return(Option(EvalResult).None);
                        }
                      );
                      variant_str := `.${ vname }`;
                      n_args := args.len();
                      fields := ArrayList(EvalValue).new();
                      (i : usize) = usize(0);
                      (ok : bool) = true;
                      while((i < n_args) && ok, {
                        match(
                          args.get(i),
                          .Some(arg_expr) =>
                            match(
                              recur(arg_expr, env),
                              .Some(r) => {
                                fields.push(r.value);
                              },
                              .None => {
                                ok = false;
                              }
                            ),
                          .None => {
                            ok = false;
                          }
                        );
                        i = (i + usize(1));
                      });
                      cond(
                        ok =>.Some(eval_result(.EnumVal(variant_str, fields), t_unit())),
                        true => Option(EvalResult).None
                      )
                    }
                  ),
                // ---- function definition: (fn(params) -> RetType)(body) ----
                (dt.value == "->") =>
                  match(
                    inner_args.get(usize(0)),
                    .None => Option(EvalResult).None,
                    .Some(fn_call_expr) =>
                      match(
                        fn_call_expr,
                        .Atom(_, _) => Option(EvalResult).None,
                        .FnCall(_, fn_func_box, fn_params_list, _, _) => {
                          // Verify func_box is `fn` atom
                          ok_fn := match(
                            fn_func_box,
                            .Atom(_, fntok) => (fntok.value == "fn"),
                            .FnCall(_, _, _, _, _) => false
                          );
                          cond(
                            (!(ok_fn)) => Option(EvalResult).None,
                            true => {
                              // Extract forall names, param names, and param type
                              // annotation identifiers from the param list.
                              //
                              // Each param is one of:
                              //   FnCall(Atom("forall"), [Atom("T")], false)
                              //     → forall name "T"
                              //   FnCall(Atom("forall"), [FnCall(Atom(":"), [Atom("T"), ...], true)], false)
                              //     → forall name "T" (constrained forall)
                              //   FnCall(Atom(":"), [Atom(name), type_expr], true)
                              //     → value param "name" with type annotation
                              //   Atom(name)
                              //     → bare value param (no type annotation)
                              //   Other (using/where) → skip
                              forall_names_f := ArrayList(String).new();
                              params_f := ArrayList(String).new();
                              param_type_names_f := ArrayList(String).new();
                              evidence_params_f := ArrayList(String).new();
                              quoted_param_indices_f := ArrayList(usize).new();
                              (pi : usize) = usize(0);
                              n_p := fn_params_list.len();
                              (param_ok : bool) = true;
                              while((pi < n_p) && param_ok, {
                                match(
                                  fn_params_list.get(pi),
                                  .Some(pd) =>
                                    match(
                                      pd,
                                      .FnCall(_, kw_box, kw_args, _, _) =>
                                        match(
                                          kw_box,
                                          .Atom(_, kw_tok) =>
                                            cond(
                                              (kw_tok.value == ":") =>
                                                // Value param: extract name + type annotation
                                                match(
                                                  kw_args.get(usize(0)),
                                                  .Some(name_expr) =>
                                                    match(
                                                      name_expr,
                                                      .Atom(_, name_tok) => {
                                                        params_f.push(name_tok.value);
                                                        // Capture simple identifier type annotation
                                                        ptn_s := match(
                                                          kw_args.get(usize(1)),
                                                          .Some(te) =>
                                                            match(
                                                              te,
                                                              .Atom(_, type_tok) => type_tok.value.clone(),
                                                              .FnCall(_, _, _, _, _) => String.new()
                                                            ),
                                                          .None => String.new()
                                                        );
                                                        param_type_names_f.push(ptn_s);
                                                      },
                                                      .FnCall(_, ct_box, ct_args, _, _) =>
                                                        // Try comptime(name) first, then quote(name).
                                                        match(
                                                          extract_comptime_param_name(ct_box, ct_args),
                                                          .Some(ct_name) => {
                                                            params_f.push(ct_name);
                                                            param_type_names_f.push(String.from(""));
                                                          },
                                                          .None =>
                                                            match(
                                                              extract_quote_param_name(ct_box, ct_args),
                                                              .Some(qname) => {
                                                                // Quoted parameter — record index
                                                                // for the macro registry, push name/type.
                                                                quoted_param_indices_f.push(params_f.len());
                                                                params_f.push(qname);
                                                                param_type_names_f.push(String.from(""));
                                                              },
                                                              .None => {
                                                                param_ok = false;
                                                              }
                                                            )
                                                        )
                                                    ),
                                                  .None => {
                                                    param_ok = false;
                                                  }
                                                ),
                                              (kw_tok.value == "forall") =>
                                                // Forall param: extract generic name
                                                match(
                                                  kw_args.get(usize(0)),
                                                  .Some(fa_expr) =>
                                                    match(
                                                      fa_expr,
                                                      // Simple: forall(T)
                                                      .Atom(_, fa_tok) => {
                                                        forall_names_f.push(fa_tok.value);
                                                      },
                                                      // Constrained: forall(T: Constraint)
                                                      .FnCall(_, fa_c_box, fa_c_args, _, _) =>
                                                        match(
                                                          fa_c_box,
                                                          .Atom(_, fa_c_tok) =>
                                                            cond(
                                                              (fa_c_tok.value == ":") =>
                                                                match(
                                                                  fa_c_args.get(usize(0)),
                                                                  .Some(fa_name_e) =>
                                                                    match(
                                                                      fa_name_e,
                                                                      .Atom(_, fa_name_tok) => {
                                                                        forall_names_f.push(fa_name_tok.value);
                                                                      },
                                                                      .FnCall(_, _, _, _, _) => ()
                                                                    ),
                                                                  .None => ()
                                                                ),
                                                              true => ()
                                                            ),
                                                          .FnCall(_, _, _, _, _) => ()
                                                        )
                                                    ),
                                                  .None => {
                                                    param_ok = false;
                                                  }
                                                ),
                                              // using param: extract evidence name
                                              (kw_tok.value == "using") =>
                                                match(
                                                  kw_args.get(usize(0)),
                                                  .Some(ev_inner) => {
                                                    match(
                                                      extract_evidence_param_name(ev_inner),
                                                      .Some(ev_name) => {
                                                        evidence_params_f.push(ev_name);
                                                      },
                                                      .None => ()
                                                    );
                                                  },
                                                  .None => ()
                                                ),
                                              // where/other — skip
                                              true => ()
                                            ),
                                          .FnCall(_, _, _, _, _) => {
                                            param_ok = false;
                                          }
                                        ),
                                      .Atom(_, bare_tok) => {
                                        params_f.push(bare_tok.value);
                                        param_type_names_f.push(String.from(""));
                                      }
                                    ),
                                  .None => {
                                    param_ok = false;
                                  }
                                );
                                pi = (pi + usize(1));
                              });
                              // Only extract body after params validated (ownership)
                              cond(
                                (!(param_ok)) => Option(EvalResult).None,
                                true =>
                                  match(
                                    args.get(usize(0)),
                                    .None => Option(EvalResult).None,
                                    .Some(body_expr) => {
                                      // Capture current env for lexical scoping (Phase 3i).
                                      // __recur_fn is excluded — it is injected at call time.
                                      cap_names_f := ArrayList(String).new();
                                      cap_tys_f := ArrayList(TypeValue).new();
                                      cap_vals_f := ArrayList(EvalValue).new();
                                      n_cf := env.frames.len();
                                      (cfi : usize) = usize(0);
                                      while(cfi < n_cf, {
                                        match(
                                          env.frames.get(cfi),
                                          .Some(frame) => {
                                            n_cv := frame.variables.len();
                                            (cvi : usize) = usize(0);
                                            while(cvi < n_cv, {
                                              match(
                                                frame.variables.get(cvi),
                                                .Some(v) => {
                                                  cond(
                                                    (!(v.name == "__recur_fn")) => {
                                                      cap_names_f.push(v.name);
                                                      cap_tys_f.push(v.ty);
                                                      cap_val_f := match(
                                                        v.value,
                                                        .Some(actual) => actual,
                                                        .None => EvalValue.VarRef(v.name)
                                                      );
                                                      cap_vals_f.push(cap_val_f);
                                                    },
                                                    true => ()
                                                  );
                                                },
                                                .None => ()
                                              );
                                              cvi = (cvi + usize(1));
                                            });
                                          },
                                          .None => ()
                                        );
                                        cfi = (cfi + usize(1));
                                      });
                                      // Compute a stable func_id and register
                                      // macro metadata before constructing FuncVal.
                                      func_id_f := random_id(String.from(""));
                                      // Register quoted parameter indices
                                      // (no-op if list is empty).
                                      register_macro_quoted_params(func_id_f.clone(), quoted_param_indices_f);
                                      // Detect `unquote(...)` return type
                                      // and register if so.  inner_args[1] is
                                      // the RetType expression of `->`.
                                      match(
                                        inner_args.get(usize(1)),
                                        .Some(ret_te) =>
                                          match(
                                            ret_te,
                                            .FnCall(_, ret_box, _ret_args, _, _) =>
                                              match(
                                                ret_box,
                                                .Atom(_, ret_tok) =>
                                                  cond(
                                                    (ret_tok.value == "unquote") => {
                                                      register_macro_return_is_unquote(func_id_f.clone());
                                                    },
                                                    true => ()
                                                  ),
                                                .FnCall(_, _, _, _, _) => ()
                                              ),
                                            .Atom(_, _) => ()
                                          ),
                                        .None => ()
                                      );
                                      .Some(
                                        eval_result(
                                          .FuncVal(
                                            box(
                                              FuncValData(
                                                forall_names : forall_names_f,
                                                params : params_f,
                                                param_type_names : param_type_names_f,
                                                evidence_params : evidence_params_f,
                                                body : body_expr,
                                                cap_names : cap_names_f,
                                                cap_tys : cap_tys_f,
                                                func_id : func_id_f
                                              )
                                            ),
                                            cap_vals_f
                                          ),
                                          t_unit()
                                        )
                                      )
                                    }
                                  )
                              )
                            }
                          )
                        }
                      )
                  ),
                true => Option(EvalResult).None
              ),
            .FnCall(_, _, _, _, _) => Option(EvalResult).None
          ),
        .Atom(_, ftok) => {
          fval := ftok.value.clone();
          cond(
            // -----------------------------------------------------------------
            // Unit expression: ()
            // -----------------------------------------------------------------
            ((fval == BK_TUPLE) && (args.len() == usize(0))) =>
              .Some(eval_result(.UnitVal, t_unit())),
            // -----------------------------------------------------------------
            // Phase 5aa: Tuple expression with args: (a, b, c) — build StructVal
            // Tuples are anonymous structs with numeric field labels.
            // -----------------------------------------------------------------
            ((fval == BK_TUPLE) && (args.len() > usize(0))) => {
              tup_fnames := ArrayList(String).new();
              tup_fvals := ArrayList(EvalValue).new();
              n_tup := args.len();
              (ti : usize) = usize(0);
              (tup_ok : bool) = true;
              while((ti < n_tup) && tup_ok, {
                match(
                  args.get(ti),
                  .Some(tup_arg) =>
                    match(
                      recur(tup_arg, env),
                      .Some(tup_res) => {
                        tup_fnames.push(ti.to_string());
                        tup_fvals.push(tup_res.value);
                      },
                      .None => {
                        tup_ok = false;
                      }
                    ),
                  .None => {
                    tup_ok = false;
                  }
                );
                ti = (ti + usize(1));
              });
              cond(
                (!(tup_ok)) => Option(EvalResult).None,
                true => Option(EvalResult).Some(eval_result(.StructVal(String.from("_"), tup_fnames, tup_fvals), t_unit()))
              )
            },
            // -----------------------------------------------------------------
            // Begin block: { stmt1; stmt2; … }
            // -----------------------------------------------------------------
            (fval == BK_BEGIN) => {
              n := args.len();
              cond(
                (n == usize(0)) =>
                  .Some(eval_result(.UnitVal, t_unit())),
                true => {
                  _p := env.push_frame(true);
                  (last : Option(EvalResult)) =.Some(eval_result(.UnitVal, t_unit()));
                  (i : usize) = usize(0);
                  (had_error : bool) = false;
                  (returning : bool) = false;
                  (breaking : bool) = false;
                  (continuing : bool) = false;
                  while(((i < n) && (!(had_error))) && (((!(returning)) && (!(breaking))) && (!(continuing))), {
                    match(
                      args.get(i),
                      .Some(stmt) =>
                        match(
                          recur(stmt, env),
                          .Some(r) => {
                            last =.Some(r);
                            match(
                              r.value,
                              .ReturnVal(_, _) => {
                                returning = true;
                              },
                              .BreakVal => {
                                breaking = true;
                              },
                              .ContinueVal => {
                                continuing = true;
                              },
                              _ => ()
                            );
                          },
                          .None => {
                            had_error = true;
                          }
                        ),
                      .None => ()
                    );
                    i = (i + usize(1));
                  });
                  env.pop_frame();
                  cond(
                    had_error => Option(EvalResult).None,
                    true => last // returning=true: last=Some(ReturnVal(...)), propagate
                  )
                }
              )
            },
            // -----------------------------------------------------------------
            // cond(arm1, arm2, …)  where each arm is `cond_expr => body_expr`
            // -----------------------------------------------------------------
            (fval == "cond") => {
              n := args.len();
              (result : Option(EvalResult)) = Option(EvalResult).None;
              (i : usize) = usize(0);
              while(i < n, {
                match(
                  args.get(i),
                  .Some(arm) =>
                    match(
                      arm,
                      .FnCall(_, _, arm_args, _, _) =>
                        match(
                          arm_args.get(usize(0)),
                          .Some(cond_expr) =>
                            match(
                              recur(cond_expr, env),
                              .Some(cond_res) =>
                                match(
                                  cond_res.value,
                                  .BoolVal(b) =>
                                    cond(
                                      b =>
                                        match(
                                          arm_args.get(usize(1)),
                                          .Some(body_expr) => {
                                            result = recur(body_expr, env);
                                            i = n;
                                          },
                                          .None => {
                                            i = n;
                                          }
                                        ),
                                      true => ()
                                    ),
                                  _ => ()
                                ),
                              .None => ()
                            ),
                          .None => ()
                        ),
                      .Atom(_, _) => ()
                    ),
                  .None => ()
                );
                i = (i + usize(1));
              });
