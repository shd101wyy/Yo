        // StrLit.contains(sub) — bool: does inner string contain sub_inner?
        ((mname == "contains") && (match(recv_val,.StrLit(_) => true, _ => false) && (method_call_args.len() == usize(1)))) =>
          match(
            method_call_args.get(usize(0)),
            .None => {
              return(Option(EvalResult).None);
            },
            .Some(con_arg_expr) =>
              match(
                match(
                  g_eval_fn,
