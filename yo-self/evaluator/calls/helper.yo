//! evaluator/calls/helper — stub for try_to_call_function_with_arguments.
//!
//! Phase 2x stub. Full implementation planned for Phase 3.
//! 1:1 port of `src/evaluator/calls/helper.ts`.
//!
//! `try_to_call_function_with_arguments` is the core function-call helper that:
//!   1. Resolves forall type variables from argument types.
//!   2. Matches arguments against function parameters (type-checks).
//!   3. Optionally executes CTFE (unless skip_ctfe_execution is true).
//!   4. Returns a `FuncCallResult` with the resolved return type, runtime arg
//!      expressions, updated caller env, and deferred drop expressions.
//!
//! Ported functions (Phase 3):
//!   * `extract_function_value` — extract FuncVal from EvalValue
//!   * `_module_type_contains_ctl_field` — stub (no isControlFunction in yo-self)
//!   * `generate_deferred_drop_expressions` — generates ___drop calls for RC vars
//!   * `validate_function_return_type` — checks return type SomeTs are resolvable
//!
//! Note: `getVariablesNeedingDrop` is now ported in full in
//! `yo-self/env.yo:get_variables_needing_drop`; the prior simplified
//! stub that lived here has been retired.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom_of,
  make_err_expr
} :: import("../../expr.yo");
{ evaluated_body_contains_unwind } :: import("../../expr_traversal.yo");
{
  Environment,
  Variable,
  get_variables_from_env,
  get_all_variables_from_env,
  add_variable_to_env,
  update_existing_variable,
  synthetic_token,
  clone_env
} :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ Token } :: import("../../token.yo");
{ t_unit, t_type } :: import("../../types/creators.yo");
{ type_to_string } :: import("../../types/string.yo");
{
  get_all_some_types,
  type_contains_some_type
} :: import("../../types/utils.yo");
{ is_some_type, is_function_type, is_comptime_int_type, is_comptime_float_type, is_comptime_string_type } :: import("../../types/guards.yo");
{ convert_comptime_type_to_runtime_type_with_expected } :: import("../../types/env_lookup.yo");
{
  type_implements_future,
  type_implements_fn,
  type_implements_trait_bool
} :: import("../trait_checking.yo");
{
  EvalValue,
  eval_value_eq,
  value_to_string,
  create_type_value,
  create_unknown_val
} :: import("../../value.yo");
{
  EvalContext,
  FuncCallResult,
  FuncOrAsyncBlockCtx,
  FuncOrAsyncBlockKind,
  ImplConcreteTypeInfo,
  ArgValues,
  ArgEntry,
  VarArgEntry,
  ExpectedTypeCtx,
  SpecializingFunctionInfo,
  SpecializedFunctionCache,
  SpecializedFunctionCacheEntry
} :: import("../context.yo");
{
  PathCollection,
  path_collection_new,
  ExprInfo,
  new_expr_info,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ evaluate_expression, evaluate_expression_raw } :: import("../exprs/expr.yo");
{
  SynthesizeResult,
  SynthesizeOptions,
  TypePair,
  synthesize_types
} :: import("../types/synthesizer.yo");
{
  are_types_compatible,
  are_types_compatible_exact
} :: import("../../types/compatibility.yo");
{
  evaluate_function_parameter_type_again,
  evaluate_function_return_type_again,
  get_func_param_defaults,
  get_func_where_constraints,
  WhereConstraintEntry
} :: import("../types/function.yo");
{ evaluate_begin_expression } :: import("../exprs/begin.yo");
{ generate_expr_from_code } :: import("../../parser.yo");
{ format_error_message } :: import("../../error.yo");
{ require_ref_own_argument_exclusivity, require_valid_ref_argument_places } :: import("../../types/flowability.yo");
{
  mark_as_control_fn,
  is_control_fn,
  get_definition_site_return
} :: import("../../function_value.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// extract_function_value
// ---------------------------------------------------------------------------
/// Extract a FuncVal from an optional EvalValue.
/// Closures are runtime-only and have no FuncVal at compile time.
///
/// Mirrors `extractFunctionValue` in `src/evaluator/calls/helper.ts`.
extract_function_value :: (fn(value : Option(EvalValue)) -> Option(EvalValue))(
  match(
    value,
    .None => Option(EvalValue).None,
    .Some(v) => match(
      v,
      .FuncVal(_, _, _, _, _, _, _, _, _) => Option(EvalValue).Some(v),
      _ => Option(EvalValue).None
    )
  )
);
// ---------------------------------------------------------------------------
// _module_type_contains_ctl_field
// ---------------------------------------------------------------------------
/// Return true if any field of `module_type` is a "control function"
/// (one that uses `unwind` to control the continuation).
///
/// Mirrors `moduleTypeContainsCtlField` in `src/evaluator/calls/helper.ts`.
/// Uses the global control-function registry since FuncVal has no isControlFunction flag.
_module_type_contains_ctl_field :: (
  fn(
    module_type : TypeValue,
    module_val : Option(EvalValue)
  ) -> bool
)(
  match(
    module_type,
    .Struct({ field_labels : field_labels, field_types : field_types, is_source_namespace : m_sns }) => cond(
      !(m_sns) => false,
      true => {
        n := field_types.len();
        (fi : usize) = usize(0);
        (found : bool) = false;
        while((fi < n) && (!(found)), {
          field_ty := match(field_types.get(fi),.Some(t) => t,.None => TypeValue.Unit);
          (field_val_opt : Option(EvalValue)) = match(
            module_val,
            .None => Option(EvalValue).None,
            .Some(mv) => match(
              mv,
              .StructVal(_, _, vals) => match(
                vals.get(fi),
                .Some(v) => Option(EvalValue).Some(v),
                .None => Option(EvalValue).None
              ),
              _ => Option(EvalValue).None
            )
          );
          // Check if field is a Func type and value is a control function
          is_func_field := match(field_ty,.Func({ result : _ }) => true, _ => false);
          if(is_func_field, {
            match(
              field_val_opt,
              .Some(fv) => match(
                fv,
                .FuncVal(_, _, _, _, _, _, _, _, fid) => {
                  if(is_control_fn(fid.clone()), {
                    found = true;
                  });
                },
                _ => ()
              ),
              .None => ()
            );
          });
          // Recurse into nested module fields
          is_module_field := match(field_ty,.Struct({ is_source_namespace : f_sns }) => f_sns, _ => false);
          if(is_module_field && (!(found)), {
            (inner_module_val_opt : Option(EvalValue)) = match(
              field_val_opt,
              .None => Option(EvalValue).None,
              .Some(fv) => match(
                fv,
                .StructVal(_, _, _) => Option(EvalValue).Some(fv),
                _ => Option(EvalValue).None
              )
            );
            if(recur(field_ty, inner_module_val_opt), {
              found = true;
            });
          });
          fi = (fi + usize(1));
        });
        found
      }
    ),
    _ => false
  )
);
// `_get_variables_needing_drop` stub retired — the full
// `getVariablesNeedingDrop` port lives at
// `yo-self/env.yo:get_variables_needing_drop` after the
// env.yo ↔ types/utils.yo import cycle was broken.
// ---------------------------------------------------------------------------
// generate_deferred_drop_expressions
// ---------------------------------------------------------------------------
/// Generate `___drop(varName)` expressions for variables that need RC cleanup.
///
/// Phase 3: returns `None` (no variables qualify with the current stub for
/// `type_contains_rc_type`).
///
/// Mirrors `generateDeferredDropExpressions` in `src/evaluator/calls/helper.ts`.
generate_deferred_drop_expressions :: (
  fn(
    variables_to_drop : ArrayList(Variable),
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(ArrayList(AstExpr))
)({
  n := variables_to_drop.len();
  if(n == usize(0), {
    return(Option(ArrayList(AstExpr)).None);
  });
  deferred := ArrayList(AstExpr).new();
  (cur_env : Environment) = env;
  (i : usize) = usize(0);
  while(i < n, {
    match(
      variables_to_drop.get(i),
      .Some(variable) => {
        // Build the drop expression: ___drop(varName)
        drop_code := `___drop(${variable.name})`;
        drop_expr := generate_expr_from_code(drop_code.clone(), exn);
        evaluated := evaluate_expression_raw(drop_expr, cur_env, ctx, exn);
        // Phase 3: env update from ExprInfo is skipped; cur_env stays unchanged.
        _ := evaluated;
        deferred.push(evaluated);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  if(
    deferred.len() == usize(0),
    Option(ArrayList(AstExpr)).None,
    Option(ArrayList(AstExpr)).Some(deferred)
  )
});
// ---------------------------------------------------------------------------
// validate_function_return_type
// ---------------------------------------------------------------------------
/// Validate that the return type does not contain unresolved SomeType variables
/// that cannot be inferred from the caller's environment.
///
/// Throws an Exception if a SomeType is found in the return type that has no
/// corresponding variable in the env AND is not a Future/Fn impl type.
///
/// Mirrors `validateFunctionReturnType` in `src/evaluator/calls/helper.ts`.
validate_function_return_type :: (
  fn(
    return_type : TypeValue,
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  // Skip validation if inside function-type evaluation or when expected type is set.
  if(ctx.is_evaluating_function_type, {
    return(());
  });
  if(ctx.expected_type.is_some(), {
    return(());
  });
  some_types := get_all_some_types(return_type);
  n := some_types.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      some_types.get(i),
      .None => (),
      .Some(st) =>
        match(
          st,
          .SomeT(_, name, _, _, required_trait_types, _, _, _, _, _) => {
            // Determine whether this SomeT should be skipped.
            should_skip := (
              type_implements_future(st) ||
                type_implements_fn(st) ||
                  (required_trait_types.len() > usize(0))
            );
            if(!(should_skip), {
              // Check if name is directly in the env.
              vars := get_variables_from_env(env, name);
              if(vars.len() == usize(0), {
                // Check transitively via all variables' TypeVal values.
                all_vars := get_all_variables_from_env(env);
                (found_transitively : bool) = false;
                (j : usize) = usize(0);
                nv := all_vars.len();
                while((j < nv) && !(found_transitively), {
                  match(
                    all_vars.get(j),
                    .Some(var) => {
                      match(
                        var.value,
                        .Some(ev) => {
                          match(
                            ev,
                            .TypeVal(ty_box) => {
                              transitive := get_all_some_types(ty_box.*);
                              (k : usize) = usize(0);
                              while((k < transitive.len()) && !(found_transitively), {
                                match(
                                  transitive.get(k),
                                  .Some(tst) => {
                                    match(
                                      tst,
                                      .SomeT(_, tname, _, _, _, _, _, _, _, _) => {
                                        if(tname == name, {
                                          found_transitively = true;
                                        });
                                      },
                                      _ => ()
                                    );
                                  },
                                  .None => ()
                                );
                                k = (k + usize(1));
                              });
                            },
                            _ => ()
                          );
                        },
                        .None => ()
                      );
                    },
                    .None => ()
                  );
                  j = (j + usize(1));
                });
                // Not found even transitively — throw error.
                if(!(found_transitively), {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(expr),
                        String.from("Failed to infer the function call return type.\nPlease consider providing the expected type."),
                        false,
                        .None
                      )
                    )
                  );
                });
              });
            });
          },
          _ => ()
        )
    );
    i = (i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Local helper: extract the args ArrayList from a FnCall AstExpr.
// ---------------------------------------------------------------------------
_h_get_fn_call_args :: (fn(e : AstExpr) -> ArrayList(AstExpr))(
  match(
    e,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
// ---------------------------------------------------------------------------
// CheckParamResult — result of check_if_function_parameter_matches_argument
// ---------------------------------------------------------------------------
CheckParamResult :: object(
  callee_env : Environment,
  caller_env : Environment,
  arg_value : Option(EvalValue),
  arg_type : TypeValue,
  resolved_param_type : TypeValue
);
// ---------------------------------------------------------------------------
// check_if_function_parameter_matches_argument
// Phase 3 port of checkIfFunctionParameterMatchesArgument (helper.ts).
// ---------------------------------------------------------------------------
/// Check that one function parameter matches its argument expression.
/// Evaluates the arg, synthesizes type bindings into callee_env, and adds
/// the parameter variable to callee_env.
check_if_function_parameter_matches_argument :: (
  fn(
    param_label : String,
    param_type : TypeValue,
    is_ct_only : bool,
    arg_expr_raw : AstExpr,
    callee_env : Environment,
    caller_env : Environment,
    ctx : EvalContext,
    runtime_arg_exprs_in_order : ArrayList(AstExpr),
    exn : Exception
  ) -> CheckParamResult
)({
  // Step 1: Strip "label: value" colon-label wrapper from arg if present.
  (actual_arg : AstExpr) = arg_expr_raw;
  if(ast_expr_is_fn_call_of(arg_expr_raw, ":",.Some(usize(2))), {
    colon_args := _h_get_fn_call_args(arg_expr_raw);
    actual_arg = match(
      colon_args.get(usize(1)),
      .Some(a) => a,
      .None => arg_expr_raw
    );
  });
  // Step 2: Evaluate param type in callee_env.
  (callee_env_r : Environment) = callee_env;
  resolved_pt := evaluate_function_parameter_type_again(param_type, callee_env_r, ctx);
  // Step 3: Evaluate arg with param type as expected-type hint.
  saved_exp := ctx.expected_type;
  ctx.expected_type =.Some(ExpectedTypeCtx(ty : resolved_pt, env : callee_env_r));
  evaled_arg := evaluate_expression_raw(actual_arg, caller_env, ctx, exn);
  ctx.expected_type = saved_exp;
  // Extract ExprInfo for the evaluated arg.
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_arg));
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg),
            String.from("check_if_function_parameter_matches_argument: arg has no ExprInfo"),
            false,
            .None
          )
        )
      );
      new_expr_info(caller_env, t_unit())
    }
  );
  (caller_env_r : Environment) = arg_info.env;
  // Coerce a comptime arg type (comptime_int/float/string) to the
  // parameter's concrete runtime type before synthesis/compatibility,
  // mirroring the default-value-site coercion (types/env_lookup.yo). Only
  // when the parameter type is CONCRETE (not a `SomeT` type variable) —
  // generic params must bind the raw comptime type via synthesis. Without
  // this, e.g. `comptime_str.to_string()` (the desugaring of a backtick
  // template) matched the self arg `comptime_str` against `Self = str`
  // and `synthesize_types` rejected the `str` vs `comptime_str` tag
  // mismatch before any coercion could run. `convert_…` returns the type
  // unchanged for non-comptime inputs, so this is a no-op for normal args.
  // GUARD: only coerce against a genuine RUNTIME concrete parameter type —
  // never a `SomeT` type variable, and never a comptime parameter type.
  // `convert_…` lowers comptime_int→i32 / comptime_float→f64
  // UNCONDITIONALLY, so coercing against a comptime parameter would break
  // the (correct) comptime-to-comptime match.
  (arg_type : TypeValue) = arg_info.ty;
  pt_is_comptime := (
    (is_comptime_int_type(resolved_pt) || is_comptime_float_type(resolved_pt))
    || is_comptime_string_type(resolved_pt)
  );
  if((!(is_some_type(resolved_pt))) && (!(pt_is_comptime)), {
    arg_was_comptime := (
      (is_comptime_int_type(arg_info.ty) || is_comptime_float_type(arg_info.ty))
      || is_comptime_string_type(arg_info.ty)
    );
    arg_type = convert_comptime_type_to_runtime_type_with_expected(
      arg_type,
      Option(TypeValue).Some(resolved_pt),
      caller_env_r
    );
    // Record the runtime type the comptime arg coerced to, so codegen renders
    // the right C form (e.g. comptime_str → `*(char)` emits a bare string
    // literal, not a `__yo_str` struct). Mirrors TS convertComptimeTypeToRuntime
    // Type writing `expr.$.convertedRuntimeType`. ExprInfo is an object (ref),
    // and for a literal arg `evaled_arg` IS the original node codegen reads.
    // Only the codegen reads this field — no evaluator logic branches on it.
    if(arg_was_comptime, {
      arg_info.converted_runtime_type = Option(TypeValue).Some(arg_type);
    });
  });
  arg_value := arg_info.value;
  // Step 4: Append to runtime arg list if not comptime-only.
  if(!(is_ct_only), {
    runtime_arg_exprs_in_order.push(evaled_arg);
  });
  // Step 5: Comptime check — runtime arg cannot fill a comptime parameter.
  if(is_ct_only, {
    is_rt := match(
      arg_value,
      .None => true,
      .Some(v) => match(
        v,
        .UnknownVal(_) => true,
        .VarRef(_) => true,
        _ => false
      )
    );
    if(is_rt, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg),
            `Cannot assign runtime argument to compile-time parameter "${param_label}"`,
            false,
            .None
          )
        )
      );
    });
  });
  // Step 6: Synthesize forall bindings from arg type into callee_env.
  checked := ArrayList(TypePair).new();
  // Note: opts is a local variable (not comptime .None) to ensure the
  // un-specialized synthesize_types wrapper is generated in C codegen.
  // See issues/synthesizer-unspecialized-wrapper.md
  (synth_opts : Option(SynthesizeOptions)) = Option(SynthesizeOptions).None;
  synth := synthesize_types(
    resolved_pt,
    callee_env_r,
    arg_type,
    caller_env_r,
    checked,
    synth_opts,
    exn
  );
  callee_env_r = synth.expected_env;
  // Step 7: Re-evaluate param type with the updated callee_env.
  final_pt := evaluate_function_parameter_type_again(resolved_pt, callee_env_r, ctx);
  // Step 8: Type-compatibility check.
  if(!(are_types_compatible(final_pt, arg_type)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(actual_arg),
          `Type mismatch for parameter "${param_label}":\n- Expected: ${type_to_string(final_pt)}\n- Got     : ${type_to_string(arg_type)}`,
          false,
          .None
        )
      )
    );
  });
  // Step 9: Bind param variable in callee_env.
  param_tok := synthetic_token(param_label, callee_env_r.module_path);
  _ := add_variable_to_env(
    callee_env_r,
    param_label,
    final_pt,
    arg_value,
    is_ct_only,
    false,
    // is_reassignable
    false,
    // is_owning_the_rc_value
    false,
    // is_implicit
    param_tok
  );
  CheckParamResult(
    callee_env : callee_env_r,
    caller_env : caller_env_r,
    arg_value : arg_value,
    arg_type : arg_type,
    resolved_param_type : final_pt
  )
});
// ---------------------------------------------------------------------------
// sanitize_for_sig
// ---------------------------------------------------------------------------
/// Replace all non-alphanumeric bytes in `s` with underscores.
///
/// Used to make compile-time signature strings safe as C identifier suffixes.
/// Mirrors `sanitizeForCIdentifier` in `src/codegen/utils/index.ts` but only
/// handles the character-replacement aspect (no C keyword avoidance needed
/// here since the signature is a suffix appended to a valid func_id).
sanitize_for_sig :: (fn(s : String) -> String)({
  bytes := s.as_bytes();
  n := bytes.len();
  result := String.new();
  (i : usize) = usize(0);
  while(i < n, {
    b := match(bytes.get(i),.Some(x) => x,.None => u8(0));
    is_alnum := (
      ((b >= u8(97)) && (b <= u8(122))) || // a-z
      ((b >= u8(65)) && (b <= u8(90))) || // A-Z
      ((b >= u8(48)) && (b <= u8(57))) // 0-9
    );
    if(is_alnum, {
      result.push_byte(b);
    }, {
      result.push_str("_");
    });
    i = (i + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// value_to_signature_string
// ---------------------------------------------------------------------------
/// Convert a value to a deterministic string for use in specialization cache keys.
///
/// For type values, returns the type string.
/// For function values, returns `fn_<func_id>`.
/// For other values, falls back to value_to_string.
///
/// Mirrors `valueToSignatureString` in `src/evaluator/calls/helper.ts`.
value_to_signature_string :: (fn(value : EvalValue) -> String)(
  match(
    value,
    .TypeVal(t) => type_to_string(t.*),
    .FuncVal(_, _, _, _, _, _, _, _, fid) => `fn_${fid}`,
    _ => value_to_string(value)
  )
);
// ---------------------------------------------------------------------------
// compute_compile_time_signature
// ---------------------------------------------------------------------------
/// Build a deterministic signature string for a generic function specialization.
///
/// The signature encodes:
///   - forall type arguments
///   - compile-time implicit arguments (given/using handlers)
///   - runtime parameter types that contain SomeType (to differentiate
///     specializations with different concrete closure capture types)
///
/// Used as the suffix for `specializedFuncId = funcId + "_" + signature`.
///
/// Mirrors `computeCompileTimeSignature` in `src/evaluator/calls/helper.ts`.
compute_compile_time_signature :: (
  fn(
    func_type : TypeValue,
    arg_values : ArgValues,
    callee_env : Environment,
    runtime_param_tys : ArrayList(TypeValue),
    exn : Exception
  ) -> String
)({
  parts := ArrayList(String).new();
  // Forall type arguments — extract from forall_labels vs arg_values.forall_args
  match(
    func_type,
    .Func({ forall_labels : fl }) => {
      n_fl := fl.len();
      n_fa := arg_values.forall_args.len();
      (fpi : usize) = usize(0);
      while(fpi < n_fl, {
        val_opt := if(
          fpi < n_fa,
          match(
            arg_values.forall_args.get(fpi),
            .Some(ae) => ae.value,
            .None => Option(EvalValue).None
          ),
          Option(EvalValue).None
        );
        sig_str := match(
          val_opt,
          .Some(v) => sanitize_for_sig(value_to_signature_string(v)),
          .None => {
            // Look up the forall label in callee_env
            label := match(fl.get(fpi),.Some(s) => s,.None => String.new());
            vars := get_variables_from_env(callee_env, label);
            n_v := vars.len();
            cond(
              (n_v > usize(0)) => {
                env_val := match(
                  vars.get(n_v - usize(1)),
                  .Some(vr) => vr.value,
                  .None => Option(EvalValue).None
                );
                match(
                  env_val,
                  .Some(ev) => sanitize_for_sig(value_to_signature_string(ev)),
                  .None => String.from("unknown")
                )
              },
              true => String.from("unknown")
            )
          }
        );
        parts.push(sig_str);
        fpi = (fpi + usize(1));
      });
    },
    _ => ()
  );
  // Implicit argument values (given/using handlers — always compile-time)
  match(
    arg_values.implicit_args,
    .Some(impl_args) => {
      n_ia := impl_args.len();
      (iai : usize) = usize(0);
      while(iai < n_ia, {
        sig_str := match(
          impl_args.get(iai),
          .Some(ae) => match(
            ae.value,
            .Some(v) => sanitize_for_sig(value_to_signature_string(v)),
            .None => String.from("unknown")
          ),
          .None => String.from("unknown")
        );
        parts.push(sig_str);
        iai = (iai + usize(1));
      });
    },
    .None => ()
  );
  // Runtime parameter types that contain SomeType — disambiguates specializations
  // with the same compile-time args but different concrete closure capture types.
  n_rt := runtime_param_tys.len();
  (rti : usize) = usize(0);
  while(rti < n_rt, {
    ptype := match(runtime_param_tys.get(rti),.Some(t) => t,.None => t_unit());
    if(type_contains_some_type(ptype), {
      seg := `rtparam${rti.to_string()}_${sanitize_for_sig(type_to_string(ptype))}`;
      parts.push(seg);
    });
    rti = (rti + usize(1));
  });
  // Join parts into a single string
  result := String.new();
  n_parts := parts.len();
  (pi : usize) = usize(0);
  while(pi < n_parts, {
    if(pi > usize(0), {
      result.push_str("_");
    });
    match(
      parts.get(pi),
      .Some(p) => result.push_string(p),
      .None => ()
    );
    pi = (pi + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// Specialization cache helpers
// ---------------------------------------------------------------------------
/// Look up a cached specialization by `func_id` and compile-time args.
///
/// Returns `Some(specialized_func_val)` if a matching cache entry is found,
/// or `None` if no entry exists.
_find_specialization_cache :: (
  fn(
    ctx : EvalContext,
    func_id : String,
    compile_time_arg_values : ArrayList(EvalValue),
    runtime_parameter_types : ArrayList(TypeValue),
    caller_env : Environment
  ) -> Option(EvalValue)
)({
  n_entries := ctx.specialized_fn_caches.len();
  (ei : usize) = usize(0);
  (result : Option(EvalValue)) = Option(EvalValue).None;
  while((ei < n_entries) && result.is_none(), {
    entry_opt := ctx.specialized_fn_caches.get(ei);
    match(
      entry_opt,
      .Some(entry) => {
        if(entry.func_id == func_id, {
          n_caches := entry.caches.len();
          (ci : usize) = usize(0);
          while((ci < n_caches) && result.is_none(), {
            cache_opt := entry.caches.get(ci);
            match(
              cache_opt,
              .Some(cache) => {
                // Check compile-time arg values match
                n_ct := cache.compile_time_arg_values.len();
                n_cur_ct := compile_time_arg_values.len();
                ct_match := (n_ct == n_cur_ct);
                if(ct_match, {
                  (cti : usize) = usize(0);
                  while((cti < n_ct) && ct_match, {
                    cached_v := match(cache.compile_time_arg_values.get(cti),.Some(v) => v,.None => EvalValue.UnitVal);
                    current_v := match(compile_time_arg_values.get(cti),.Some(v) => v,.None => EvalValue.UnitVal);
                    if(!(eval_value_eq(cached_v, current_v)), {
                      ct_match = false;
                    });
                    cti = (cti + usize(1));
                  });
                });
                if(ct_match, {
                  // Check runtime parameter types match (exact match)
                  n_rt := cache.runtime_parameter_types.len();
                  n_cur_rt := runtime_parameter_types.len();
                  rt_match := (n_rt == n_cur_rt);
                  if(rt_match, {
                    _ := caller_env;
                    (rti : usize) = usize(0);
                    while((rti < n_rt) && rt_match, {
                      cached_ty := match(cache.runtime_parameter_types.get(rti),.Some(t) => t,.None => t_unit());
                      current_ty := match(runtime_parameter_types.get(rti),.Some(t) => t,.None => t_unit());
                      if(!(are_types_compatible_exact(cached_ty, current_ty)), {
                        rt_match = false;
                      });
                      rti = (rti + usize(1));
                    });
                  });
                  if(rt_match, {
                    result = Option(EvalValue).Some(cache.specialized_func_value);
                  });
                });
              },
              .None => ()
            );
            ci = (ci + usize(1));
          });
        });
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  result
});
/// Store a specialization in the cache.
_store_specialization_cache :: (
  fn(
    ctx : EvalContext,
    func_id : String,
    compile_time_arg_values : ArrayList(EvalValue),
    runtime_parameter_types : ArrayList(TypeValue),
    specialized_func_val : EvalValue,
    env : Environment
  ) -> unit
)({
  new_cache := SpecializedFunctionCache(
    compile_time_arg_values : compile_time_arg_values,
    runtime_parameter_types : runtime_parameter_types,
    specialized_func_value : specialized_func_val,
    env : env
  );
  // Find existing entry for this func_id
  n_entries := ctx.specialized_fn_caches.len();
  (ei : usize) = usize(0);
  (found : bool) = false;
  while((ei < n_entries) && !(found), {
    entry_opt := ctx.specialized_fn_caches.get(ei);
    match(
      entry_opt,
      .Some(entry) => {
        if(entry.func_id == func_id, {
          found = true;
          // Push into existing entry's caches
          entry.caches.push(new_cache);
        });
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  if(!(found), {
    // Create new entry
    new_caches := ArrayList(SpecializedFunctionCache).new();
    new_caches.push(new_cache);
    ctx.specialized_fn_caches.push(
      SpecializedFunctionCacheEntry(
        func_id : func_id,
        caches : new_caches
      )
    );
  });
});
// ---------------------------------------------------------------------------
// create_specialized_function_inline
// ---------------------------------------------------------------------------
/// Create (or retrieve from cache) a specialized version of a generic function
/// with compile-time arguments bound.
///
/// This is the core of generic function monomorphization. It:
///   1. Computes a deterministic compile-time signature from arg values.
///   2. Checks the global specialization cache for a matching entry.
///   3. On cache miss: evaluates the function body in the specialized callee_env,
///      creates a new FuncVal with the specialized func_id + updated captures,
///      stores in cache.
///   4. Returns the specialized FuncVal.
///
/// NOTE: Effects analysis (isControlFunction detection, effectCtlParams, etc.)
/// is not yet implemented here — it is the TS function's largest section
/// (~600 lines) and requires more infrastructure. That is deferred to Phase 4k.
///
/// Mirrors the core (pre-effects) of `createSpecializedFunctionInline` in
/// `src/evaluator/calls/helper.ts`.
create_specialized_function_inline :: (
  fn(
    original_func_val : EvalValue,
    func_type : TypeValue,
    arg_values : ArgValues,
    callee_env : Environment,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> EvalValue
)({
  result := match(
    original_func_val,
    .FuncVal(forall_names, params, param_type_names, evidence_params, body, cap_names, cap_tys, cap_vals, func_id) => {
      // ------------------------------------------------------------------
      // Collect compile-time arg values and runtime parameter types
      // ------------------------------------------------------------------
      compile_time_args := ArrayList(EvalValue).new();
      runtime_param_tys := ArrayList(TypeValue).new();
      // Add forall type arguments (always compile-time)
      (fai : usize) = usize(0);
      n_fa := arg_values.forall_args.len();
      while(fai < n_fa, {
        match(
          arg_values.forall_args.get(fai),
          .Some(ae) => match(
            ae.value,
            .Some(v) => {
              compile_time_args.push(v);
            },
            .None => ()
          ),
          .None => ()
        );
        fai = (fai + usize(1));
      });
      // Add implicit arguments (always compile-time)
      match(
        arg_values.implicit_args,
        .Some(impl_args) => {
          (iai : usize) = usize(0);
          n_ia := impl_args.len();
          while(iai < n_ia, {
            match(
              impl_args.get(iai),
              .Some(ae) => match(
                ae.value,
                .Some(v) => {
                  compile_time_args.push(v);
                },
                .None => ()
              ),
              .None => ()
            );
            iai = (iai + usize(1));
          });
        },
        .None => ()
      );
      // Build runtime parameter types from regular args
      // Phase 3 simplification: all regular params are treated as runtime.
      // This means we track all regular arg types for cache differentiation.
      (ai : usize) = usize(0);
      n_a := arg_values.args.len();
      while(ai < n_a, {
        match(
          arg_values.args.get(ai),
          .Some(ae) => {
            runtime_param_tys.push(ae.arg_type);
          },
          .None => ()
        );
        ai = (ai + usize(1));
      });
      // ------------------------------------------------------------------
      // Cache lookup
      // ------------------------------------------------------------------
      cached := _find_specialization_cache(
        ctx,
        func_id.clone(),
        compile_time_args,
        runtime_param_tys,
        caller_env
      );
      match(
        cached,
        .Some(spec_val) => spec_val,
        .None => {
          // ------------------------------------------------------------------
          // Cache miss: create the specialization
          // ------------------------------------------------------------------
          // Compute specialized func_id
          sig := compute_compile_time_signature(func_type, arg_values, callee_env, runtime_param_tys, exn);
          specialized_func_id := if(
            sig.len() > usize(0),
            `${func_id}_${sig}`,
            func_id
          );
          // Register recursive self-reference in context so recursive calls
          // inside the body can find the specialized func_id.
          prev_spec := ctx.currently_specializing_function;
          ctx.currently_specializing_function = Option(SpecializingFunctionInfo).Some(
            SpecializingFunctionInfo(
              original_func_id : func_id,
              specialized_func_id : specialized_func_id,
              specialized_return_type : evaluate_function_return_type_again(
                match(func_type,.Func({ result : r }) => r.*, _ => t_unit()),
                callee_env,
                ctx
              ),
              original_func_value : original_func_val
            )
          );
          // Evaluate the function body in the specialized environment.
          // Uses the already-built callee_env (which has all type params and
          // regular params bound from try_to_call_function_with_arguments steps 4–11).
          specialized_body := evaluate_begin_expression(
            body.*,
            callee_env,
            ctx,
            ArrayList(Variable).new(),
            true,
            exn
          );
          // Restore context
          ctx.currently_specializing_function = prev_spec;
          // Build updated captures from the specialized callee_env.
          // This ensures the specialized function "closes over" the bound
          // compile-time values (forall type params, given handlers, etc.)
          // so codegen can inline them without extra lookups.
          new_cap_names := ArrayList(String).new();
          new_cap_tys := ArrayList(TypeValue).new();
          new_cap_vals := ArrayList(EvalValue).new();
          // Re-use existing captures from original function
          (oci : usize) = usize(0);
          n_oc := cap_names.len();
          while(oci < n_oc, {
            cn := match(cap_names.get(oci),.Some(s) => s,.None => String.new());
            ct := match(cap_tys.get(oci),.Some(t) => t,.None => t_unit());
            cv := match(cap_vals.get(oci),.Some(v) => v,.None => EvalValue.UnitVal);
            new_cap_names.push(cn);
            new_cap_tys.push(ct);
            new_cap_vals.push(cv);
            oci = (oci + usize(1));
          });
          // Add compile-time args as additional captures (forall type bindings)
          (fai2 : usize) = usize(0);
          n_fl := match(func_type,.Func({ forall_labels : fl }) => fl.len(), _ => usize(0));
          while(fai2 < n_fl, {
            label := match(
              func_type,
              .Func({ forall_labels : fl }) => {
                r := match(fl.get(fai2),.Some(s) => s,.None => String.new());
                r
              },
              _ => String.new()
            );
            env_vars := get_variables_from_env(callee_env, label);
            n_ev := env_vars.len();
            if(n_ev > usize(0), {
              match(
                env_vars.get(n_ev - usize(1)),
                .Some(ev) => {
                  match(
                    ev.value,
                    .Some(v) => {
                      new_cap_names.push(label);
                      new_cap_tys.push(ev.ty);
                      new_cap_vals.push(v);
                    },
                    .None => ()
                  );
                },
                .None => ()
              );
            });
            fai2 = (fai2 + usize(1));
          });
          // Evaluate the specialized body to get its return type
          _ := specialized_body;
          // Create the specialized function value
          specialized_func_val := EvalValue.FuncVal(
            forall_names,
            params,
            param_type_names,
            evidence_params,
            Box(AstExpr)(body.*),
            new_cap_names,
            new_cap_tys,
            new_cap_vals,
            specialized_func_id
          );
          // Detect isControlFunction: set if the original was already a control
          // function OR if the specialized body contains unwind.
          // Mirrors the `isControlFunction: originalFunction.isControlFunction ||
          //   evaluatedBodyContainsEscape(specializedBody)` logic in TypeScript.
          parent_is_ctl := is_control_fn(func_id.clone());
          body_has_unwind := evaluated_body_contains_unwind(specialized_body);
          if(parent_is_ctl || body_has_unwind, {
            mark_as_control_fn(specialized_func_id.clone());
          });
          // Store in cache
          _store_specialization_cache(
            ctx,
            func_id,
            compile_time_args,
            runtime_param_tys,
            specialized_func_val,
            callee_env
          );
          specialized_func_val
        }
      )
    },
    _ => original_func_val
  );
  result
});
// ---------------------------------------------------------------------------
// evaluate_ctl_function_body_inline
// ---------------------------------------------------------------------------
/// Inline-evaluate a control function body to produce a specialized version
/// with the forall type parameter bound to the concrete call-site type.
///
/// Called for `isControlFunction` functions (effect handlers that use `unwind`)
/// when they have forall parameters. This is separate from normal specialization
/// because the concrete type comes from the CALL SITE's enclosing function return
/// type (not from the arguments).
///
/// Mirrors `evaluateCtlFunctionBodyInline` in `src/evaluator/calls/helper.ts`
/// (lines 3616–3790).
evaluate_ctl_function_body_inline :: (
  fn(
    original_func_val : EvalValue,
    func_type : TypeValue,
    callee_env : Environment,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> EvalValue
)({
  // Extract FuncVal fields individually to avoid tuple destructuring.
  orig_forall_labels := match(original_func_val,.FuncVal(fl, _, _, _, _, _, _, _, _) => fl, _ => ArrayList(String).new());
  orig_params := match(original_func_val,.FuncVal(_, p, _, _, _, _, _, _, _) => p, _ => ArrayList(String).new());
  orig_param_type_names := match(original_func_val,.FuncVal(_, _, ptn, _, _, _, _, _, _) => ptn, _ => ArrayList(String).new());
  orig_evidence_params := match(original_func_val,.FuncVal(_, _, _, ep, _, _, _, _, _) => ep, _ => ArrayList(String).new());
  orig_body := match(original_func_val,.FuncVal(_, _, _, _, b, _, _, _, _) => b, _ => Box(AstExpr)(make_err_expr()));
  orig_cap_names := match(original_func_val,.FuncVal(_, _, _, _, _, cn, _, _, _) => cn, _ => ArrayList(String).new());
  orig_cap_tys := match(original_func_val,.FuncVal(_, _, _, _, _, _, ct, _, _) => ct, _ => ArrayList(TypeValue).new());
  orig_cap_vals := match(original_func_val,.FuncVal(_, _, _, _, _, _, _, cv, _) => cv, _ => ArrayList(EvalValue).new());
  orig_func_id := match(original_func_val,.FuncVal(_, _, _, _, _, _, _, _, fid) => fid, _ => String.from("__err_ctl"));
  // -------------------------------------------------------------------------
  // Determine concreteTypeForForall from context.
  // For function-body contexts, it's the enclosing function's return type.
  // Mirrors:
  //   context.isEvaluatingFunctionBodyOrAsyncBlock?.kind === "function-body"
  //     ? context.isEvaluatingFunctionBodyOrAsyncBlock.type.return.type
  //     : functionType.return.type
  // -------------------------------------------------------------------------
  (concrete_type_for_forall : TypeValue) = match(
    ctx.is_evaluating_function_body_or_async_block,
    .Some(fb_ctx) => match(
      fb_ctx.kind,
      .FunctionBody => match(
        fb_ctx.func_type,
        .Some(enclosing_ty) => match(
          enclosing_ty,
          .Func({ result : rb }) => rb.*,
          _ => match(func_type,.Func({ result : rb }) => rb.*, _ => TypeValue.Unit)
        ),
        .None => match(func_type,.Func({ result : rb }) => rb.*, _ => TypeValue.Unit)
      ),
      _ => match(func_type,.Func({ result : rb }) => rb.*, _ => TypeValue.Unit)
    ),
    .None => match(func_type,.Func({ result : rb }) => rb.*, _ => TypeValue.Unit)
  );
  // -------------------------------------------------------------------------
  // Determine enclosing return type from definition-site registry.
  // Mirrors:
  //   originalFunction.definitionSiteEnclosingFunctionType?.return.type ?? createUnitType()
  // -------------------------------------------------------------------------
  enclosing_return_ty := get_definition_site_return(orig_func_id.clone());
  // -------------------------------------------------------------------------
  // Build cache key: <original_func_id>_ctl_<sanitized_type_string>.
  // Mirrors:
  //   const ctlSignature = sanitizeForCIdentifier(typeToString(concreteTypeForForall));
  //   funcId: `${originalFunction.funcId}_ctl_${ctlSignature}`
  // -------------------------------------------------------------------------
  ctl_sig_raw := type_to_string(concrete_type_for_forall);
  ctl_sig_san := sanitize_for_sig(ctl_sig_raw);
  ctl_func_id := `${orig_func_id}_ctl_${ctl_sig_san}`;
  // -------------------------------------------------------------------------
  // Check cache: if we already have a specialization with this _ctl_ func_id,
  // return it immediately.
  // -------------------------------------------------------------------------
  // Build a compile-time arg list containing the concrete type as the sole entry.
  ctl_ct_args := ArrayList(EvalValue).new();
  ctl_ct_args.push(create_type_value(concrete_type_for_forall));
  cached_result := _find_specialization_cache(
    ctx,
    ctl_func_id.clone(),
    ctl_ct_args,
    ArrayList(TypeValue).new(),
    caller_env
  );
  (found_cached : bool) = false;
  (cached_val : EvalValue) = EvalValue.UnitVal;
  match(
    cached_result,
    .Some(cv2) => {
      found_cached = true;
      cached_val = cv2;
    },
    .None => ()
  );
  if(found_cached, {
    return(cached_val);
  });
  // -------------------------------------------------------------------------
  // Build specialized env: clone callee_env and push a new frame.
  // Mirrors: let specializedEnv = pushEnvFrame(calleeEnv);
  // -------------------------------------------------------------------------
  specialized_env := clone_env(callee_env);
  _push_frame_res := specialized_env.push_frame(false);
  // -------------------------------------------------------------------------
  // Add compile-time bindings from caller's scope that are missing from
  // specializedEnv (types, modules, traits — not plain function values).
  // Mirrors the callerEnv injection loop in evaluateCtlFunctionBodyInline.
  // -------------------------------------------------------------------------
  n_caller_frames := caller_env.frames.len();
  (cfi : usize) = usize(0);
  while(cfi < n_caller_frames, {
    match(
      caller_env.frames.get(cfi),
      .Some(caller_frame) => {
        n_vars := caller_frame.variables.len();
        (vi : usize) = usize(0);
        while(vi < n_vars, {
          match(
            caller_frame.variables.get(vi),
            .Some(caller_var) => {
              if(caller_var.is_compile_time_only, {
                // Skip plain function values (only types, modules, traits need to cross).
                is_fn_val := match(
                  caller_var.value,
                  .Some(cv3) => match(cv3,.FuncVal(_, _, _, _, _, _, _, _, _) => true, _ => false),
                  .None => false
                );
                if(!(is_fn_val), {
                  existing := get_variables_from_env(specialized_env, caller_var.name);
                  if(existing.len() == usize(0), {
                    _add_caller_var_res := add_variable_to_env(
                      specialized_env,
                      caller_var.name.clone(),
                      caller_var.ty,
                      caller_var.value,
                      true,
                      false,
                      false,
                      caller_var.is_implicit,
                      caller_var.token
                    );
                  });
                });
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
    cfi = (cfi + usize(1));
  });
  // -------------------------------------------------------------------------
  // Bind each forall parameter to concreteTypeForForall.
  // Mirrors the forallParam loop in evaluateCtlFunctionBodyInline.
  // -------------------------------------------------------------------------
  forall_labels := match(
    func_type,
    .Func({ forall_labels : fl }) => fl,
    _ => ArrayList(String).new()
  );
  forall_types_list := match(
    func_type,
    .Func({ forall_types : ft }) => ft,
    _ => ArrayList(TypeValue).new()
  );
  n_forall := forall_labels.len();
  (fi2 : usize) = usize(0);
  while(fi2 < n_forall, {
    fl_label := match(forall_labels.get(fi2),.Some(s) => s,.None => String.from(""));
    fl_ty := match(forall_types_list.get(fi2),.Some(t) => t,.None => TypeValue.Unit);
    ctl_tok := synthetic_token(fl_label.clone(), specialized_env.module_path);
    _add_forall_var_res := add_variable_to_env(
      specialized_env,
      fl_label.clone(),
      fl_ty,
      Option(EvalValue).Some(create_type_value(concrete_type_for_forall)),
      true,
      false,
      false,
      false,
      ctl_tok
    );
    fi2 = (fi2 + usize(1));
  });
  // -------------------------------------------------------------------------
  // Build a handler context with modified enclosingFunctionReturnType.
  // Mirrors:
  //   const handlerContext: EvaluatorContext = {
  //     ...context,
  //     expectedType: undefined,
  //     enclosingFunctionReturnType: enclosingReturnType,
  //     isEvaluatingFunctionBodyOrAsyncBlock: { kind: "function-body", type: functionType, value: originalFunction, evaluationEnv: specializedEnv },
  //     functionReturnImplConcreteType: [],
  //   };
  // -------------------------------------------------------------------------
  handler_fb_ctx := FuncOrAsyncBlockCtx(
    kind : FuncOrAsyncBlockKind.FunctionBody,
    func_type : Option(TypeValue).Some(func_type),
    func_value : Option(EvalValue).Some(original_func_val),
    eval_env : specialized_env
  );
  prev_expected_type := ctx.expected_type;
  prev_is_eval_fb := ctx.is_evaluating_function_body_or_async_block;
  prev_enclosing_ret := ctx.enclosing_function_return_type;
  prev_impl_concrete := ctx.function_return_impl_concrete_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  ctx.is_evaluating_function_body_or_async_block = Option(FuncOrAsyncBlockCtx).Some(handler_fb_ctx);
  ctx.enclosing_function_return_type = Option(TypeValue).Some(enclosing_return_ty);
  ctx.function_return_impl_concrete_type = Option(ArrayList(ImplConcreteTypeInfo)).Some(ArrayList(ImplConcreteTypeInfo).new());
  // -------------------------------------------------------------------------
  // Evaluate the body.
  // -------------------------------------------------------------------------
  ctl_body := evaluate_begin_expression(
    orig_body.*,
    specialized_env,
    ctx,
    ArrayList(Variable).new(),
    true,
    exn
  );
  // Restore context fields.
  ctx.expected_type = prev_expected_type;
  ctx.is_evaluating_function_body_or_async_block = prev_is_eval_fb;
  ctx.enclosing_function_return_type = prev_enclosing_ret;
  ctx.function_return_impl_concrete_type = prev_impl_concrete;
  // -------------------------------------------------------------------------
  // Build the specialized FuncVal.
  // Mirrors: funcId: `${originalFunction.funcId}_ctl_${ctlSignature}`
  // -------------------------------------------------------------------------
  ctl_parent_is_ctl := is_control_fn(orig_func_id.clone());
  ctl_body_has_unwind := evaluated_body_contains_unwind(ctl_body);
  if(ctl_parent_is_ctl || ctl_body_has_unwind, {
    mark_as_control_fn(ctl_func_id.clone());
  });
  // Rebuild captures (same as original + forall type bindings).
  ctl_cap_names := ArrayList(String).new();
  ctl_cap_tys := ArrayList(TypeValue).new();
  ctl_cap_vals := ArrayList(EvalValue).new();
  (oci : usize) = usize(0);
  n_oc := orig_cap_names.len();
  while(oci < n_oc, {
    ctl_cap_names.push(match(orig_cap_names.get(oci),.Some(s) => s,.None => String.new()));
    ctl_cap_tys.push(match(orig_cap_tys.get(oci),.Some(t) => t,.None => TypeValue.Unit));
    ctl_cap_vals.push(match(orig_cap_vals.get(oci),.Some(v) => v,.None => EvalValue.UnitVal));
    oci = (oci + usize(1));
  });
  // Add forall type bindings as extra captures.
  (fi3 : usize) = usize(0);
  while(fi3 < n_forall, {
    fl3 := match(forall_labels.get(fi3),.Some(s) => s,.None => String.new());
    ft3 := match(forall_types_list.get(fi3),.Some(t) => t,.None => TypeValue.Unit);
    ctl_cap_names.push(fl3.clone());
    ctl_cap_tys.push(ft3);
    ctl_cap_vals.push(create_type_value(concrete_type_for_forall));
    fi3 = (fi3 + usize(1));
  });
  ctl_func_val := EvalValue.FuncVal(
    orig_forall_labels,
    orig_params,
    orig_param_type_names,
    orig_evidence_params,
    Box(AstExpr)(orig_body.*),
    ctl_cap_names,
    ctl_cap_tys,
    ctl_cap_vals,
    ctl_func_id.clone()
  );
  // -------------------------------------------------------------------------
  // Cache the result.
  // -------------------------------------------------------------------------
  // Use ctl_func_id as the cache key with the concrete type as the sole arg.
  ctl_cache_args := ArrayList(EvalValue).new();
  ctl_cache_args.push(create_type_value(concrete_type_for_forall));
  _store_specialization_cache(
    ctx,
    ctl_func_id.clone(),
    ctl_cache_args,
    ArrayList(TypeValue).new(),
    ctl_func_val,
    specialized_env
  );
  ctl_func_val
});
// ---------------------------------------------------------------------------
// try_to_call_function_with_arguments
// ---------------------------------------------------------------------------
/// Type-check the arguments of a function call against `func_type` and
/// (optionally) execute CTFE. Returns a `FuncCallResult` with the resolved
/// return type, runtime arg expressions, updated caller env, and deferred
/// drop expressions.
///
/// Phase 3 port of `tryToCallFunctionWithArguments` in
/// `src/evaluator/calls/helper.ts`.
///
/// Phase 3 simplifications (relative to the full TypeScript implementation):
///   * CTFE is not executed — return_value is always None.
///   * Generic specialization is implemented (create_specialized_function_inline)
///     but without effects analysis (isControlFunction, effectCtlParams).
///   * RC ownership / deferred drop expressions are skipped.
///   * Quote parameters are not supported (throw on encounter).
///   * Where-clause constraints are skipped (TypeValue has no AstExpr forms).
/// Validate the registered where-clause constraints of `func_id` against the
/// parameter bindings now present in `callee_env`. Mirrors TS re-applying
/// `FunctionType.whereClauseExprs` at every call site once parameters are
/// bound (helper.ts:1493-1506 → applyWhereClauseConstraints →
/// validateSingleTraitOnConcreteType, types/function.ts:974): a constraint
/// whose LHS param resolved to a CONCRETE type must hold — this is what
/// rejects `Mutex(NonSendObj)` against `where(T <: Send)`. Called from BOTH
/// call paths: Step 8b of `try_to_call_function_with_arguments` below AND the
/// inline FuncVal arm in `calls/function.yo` (the same two-path obligation as
/// the default-args side table).
///
/// DOCUMENTED DIVERGENCE (narrower than TS): only MARKER-trait constraints
/// (traits without methods — Send/Acyclic/user markers) are enforced, and only
/// against FULLY CONCRETE bound types (no SomeT anywhere in the type). TS
/// validates every constraint because its `typeImplementsTrait` is complete;
/// yo-self's still has gaps for (a) method-trait satisfaction on concrete
/// types (e.g. `K <: (Eq, Hash)` for `String`) and (b) marker derivation
/// through generic-instantiation fields that still carry constraint-bearing
/// SomeTs — enforcing those today rejects valid std code (imm/map, hashmap).
/// Widen as the trait checker closes those gaps.
validate_where_constraints_for_call :: (
  fn(
    func_id : String,
    callee_env : Environment,
    tok : Token,
    exn : Exception
  ) -> unit
)({
  where_constraint_list := get_func_where_constraints(func_id);
  (wcl_i : usize) = usize(0);
  while(wcl_i < where_constraint_list.len(), {
    wce := match(
      where_constraint_list.get(wcl_i),
      .Some(e) => e,
      .None => {
        wcl_i = (wcl_i + usize(1));
        continue;
      }
    );
    // Marker traits only: a TraitT none of whose fields is function-typed.
    trait_is_marker := match(
      wce.trait_ty,
      .TraitT(_, _, _, tr_ftys, _, _, _, _) => {
        (tm_i : usize) = usize(0);
        (tm_has_method : bool) = false;
        while((tm_i < tr_ftys.len()) && !(tm_has_method), {
          match(
            tr_ftys.get(tm_i),
            .Some(tf) => if(is_function_type(tf), {
              tm_has_method = true;
            }),
            .None => ()
          );
          tm_i = (tm_i + usize(1));
        });
        !(tm_has_method)
      },
      _ => false
    );
    if(!(trait_is_marker), {
      wcl_i = (wcl_i + usize(1));
      continue;
    });
    lhs_vars := get_variables_from_env(callee_env, wce.lhs_label);
    if(lhs_vars.len() > usize(0), {
      match(
        lhs_vars.get(lhs_vars.len() - usize(1)),
        .Some(lhs_var) => match(
          lhs_var.value,
          .Some(lv) => match(
            lv,
            .TypeVal(bound_tb) => {
              bound_ty := bound_tb.*;
              // Fully concrete only: a bound type still carrying SomeTs (a
              // generic instantiation inside an impl body) defers to TS-style
              // constraint propagation, which yo-self's marker derivation
              // can't see through yet.
              if((!(is_some_type(bound_ty))) && (get_all_some_types(bound_ty).len() == usize(0)), {
                wc_implemented := type_implements_trait_bool(bound_ty, wce.trait_ty, callee_env);
                if(wce.is_negated, {
                  if(wc_implemented, {
                    exn.throw(
                      dyn(
                        format_error_message(
                          tok,
                          `Type ${type_to_string(bound_ty)} must NOT implement ${type_to_string(wce.trait_ty)}, but it does.`,
                          false,
                          .None
                        )
                      )
                    );
                  });
                }, {
                  if(!(wc_implemented), {
                    exn.throw(
                      dyn(
                        format_error_message(
                          tok,
                          `Type ${type_to_string(bound_ty)} does not implement required trait ${type_to_string(wce.trait_ty)}.`,
                          false,
                          .None
                        )
                      )
                    );
                  });
                });
              });
            },
            _ => ()
          ),
          .None => ()
        ),
        .None => ()
      );
    });
    wcl_i = (wcl_i + usize(1));
  });
});
try_to_call_function_with_arguments :: (
  fn(
    func_val : Option(EvalValue),
    func_type : TypeValue,
    expr : AstExpr,
    callee_expr : AstExpr,
    arg_exprs : ArrayList(AstExpr),
    caller_env : Environment,
    ctx : EvalContext,
    is_method_call : bool,
    skip_specialization : bool,
    skip_ctfe_execution : bool,
    exn : Exception
  ) -> FuncCallResult
)({
  _ := callee_expr;
  _ := skip_ctfe_execution;
  tok := ast_expr_token(expr);
  match(
    func_type,
    .Func({ forall_labels : fl, forall_types : ft, param_labels : pl, param_types : pt, implicit_labels : il, implicit_types : it, implicit_spreads : ispr, where_types : wt, result : ret_b, has_variadic : fn_has_variadic }) => {
      _ := ispr;
      _ := wt;
      // ----------------------------------------------------------------
      // Step 1: Detect explicit forall(…) argument.
      // ----------------------------------------------------------------
      (forall_args_opt : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
      (regular_start : usize) = usize(0);
      has_f0 := match(
        arg_exprs.get(usize(0)),
        .Some(a) => ast_expr_is_fn_call_of(a, "forall", Option(usize).None),
        .None => false
      );
      if(has_f0, {
        fa0 := match(arg_exprs.get(usize(0)),.Some(a) => a,.None => make_err_expr());
        forall_args_opt =.Some(_h_get_fn_call_args(fa0));
        regular_start = usize(1);
      });
      // For method calls, forall may appear at index 1 (self is at 0).
      if((!(has_f0)) && (is_method_call && (arg_exprs.len() > usize(1))), {
        has_f1 := match(
          arg_exprs.get(usize(1)),
          .Some(a) => ast_expr_is_fn_call_of(a, "forall", Option(usize).None),
          .None => false
        );
        if(has_f1, {
          fa1 := match(arg_exprs.get(usize(1)),.Some(a) => a,.None => make_err_expr());
          forall_args_opt =.Some(_h_get_fn_call_args(fa1));
          // Phase 3: no arg reordering needed; self is still at adjusted_args[0].
        });
      });
      // ----------------------------------------------------------------
      // Step 2: Split … arg out; collect regular args.
      // ----------------------------------------------------------------
      (using_args_opt : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
      adjusted_args := ArrayList(AstExpr).new();
      n_total := arg_exprs.len();
      (ai : usize) = regular_start;
      while(ai < n_total, {
        a := match(arg_exprs.get(ai),.Some(x) => x,.None => make_err_expr());
        if(ast_expr_is_fn_call_of(a, "using", Option(usize).None), {
          using_args_opt =.Some(_h_get_fn_call_args(a));
        }, {
          adjusted_args.push(a);
        });
        ai = (ai + usize(1));
      });
      // ----------------------------------------------------------------
      // Step 3: Argument count check.
      //
      // Parameters with a `?= default` are optional and may be omitted at
      // the call site. The optional flags are looked up (by FuncVal id)
      // from the side-table populated at definition time. A call is valid
      // when it supplies at least the required-parameter count and no more
      // than the total. Omitted trailing optionals are bound to their
      // declared type below (Step 7).
      // ----------------------------------------------------------------
      n_params := pl.len();
      n_args := adjusted_args.len();
      call_param_defaults := match(
        func_val,
        .Some(fvv) => match(
          fvv,
          .FuncVal(_, _, _, _, _, _, _, _, fvid) => get_func_param_defaults(fvid.clone()),
          _ => ArrayList(Option(EvalValue)).new()
        ),
        .None => ArrayList(Option(EvalValue)).new()
      );
      (n_required : usize) = n_params;
      if(call_param_defaults.len() == n_params, {
        (nr : usize) = usize(0);
        (ofi : usize) = usize(0);
        while(ofi < n_params, {
          match(
            call_param_defaults.get(ofi),
            .Some(d) => if(d.is_none(), {
              nr = (nr + usize(1));
            }),
            .None => ()
          );
          ofi = (ofi + usize(1));
        });
        n_required = nr;
      });
      // Variadic functions (C-style `...` externs like `snprintf`) accept any
      // number of extra arguments — TS skips the count check entirely for
      // them (`if (!functionType.variadicParameter)`, helper.ts:965).
      if((!(fn_has_variadic)) && ((n_args < n_required) || (n_args > n_params)), {
        (count_msg : String) = `Argument count mismatch: expected ${n_params.to_string()} arguments, got ${n_args.to_string()}`;
        if(n_required != n_params, {
          count_msg = `Argument count mismatch: expected ${n_required.to_string()}..${n_params.to_string()} arguments, got ${n_args.to_string()}`;
        });
        exn.throw(
          dyn(
            format_error_message(
              tok,
              count_msg,
              false,
              .None
            )
          )
        );
      });
      // ----------------------------------------------------------------
      // Step 4: Build callee_env from FuncVal captures (or empty).
      // ----------------------------------------------------------------
      (callee_env : Environment) = match(
        func_val,
        .Some(fv) => match(
          fv,
          .FuncVal(_, _, _, _, _, cn, ct, cv, _) => {
            fenv := Environment.new(caller_env.module_path);
            (ci : usize) = usize(0);
            n_cap := cn.len();
            while(ci < n_cap, {
              cname := match(cn.get(ci),.Some(s) => s,.None => String.from(""));
              cty := match(ct.get(ci),.Some(t) => t,.None => t_unit());
              cval := match(
                cv.get(ci),
                .Some(v) => Option(EvalValue).Some(v),
                .None => Option(EvalValue).None
              );
              is_ct_cap := match(cval,.Some(_) => true,.None => false);
              _ := add_variable_to_env(
                fenv,
                cname,
                cty,
                cval,
                is_ct_cap,
                false,
                false,
                false,
                synthetic_token(cname, fenv.module_path)
              );
              ci = (ci + usize(1));
            });
            fenv
          },
          _ => Environment.new(caller_env.module_path)
        ),
        .None => Environment.new(caller_env.module_path)
      );
      // Step 5: Push a new frame on callee_env for parameter bindings.
      _ := callee_env.push_frame(false);
      // ----------------------------------------------------------------
      // Step 6: Add forall params as UnknownVal placeholders (or resolve
      //         them from an explicit forall(…) argument).
      // ----------------------------------------------------------------
      n_forall := fl.len();
      // Self-bound markers (TS structural mirror): TS's callee env EXTENDS
      // the function type's definition env (`pushEnvFrame(functionType.env)`,
      // helper.ts:1009), whose frames still hold the self-binding
      // `T := SomeT(T)` for EVERY type variable the signature introduced —
      // explicit `forall` labels AND implicit ones (`Impl(...)` sugar). That
      // intact marker is what lets `getValueOfSomeTypeFromEnv` accept the
      // concrete rebinding `synthesizeTypes` later writes over the LAST
      // binding (env-lookup.ts:141-167, `thisSomeTypeWasBound`). yo-self's
      // callee_env is built FRESH (the flattened `Func` TypeValue carries no
      // definition env), so the markers must be recreated here, for every
      // distinct SomeT in the signature:
      //   - forall labels: marker only — the `UnknownVal` call binding added
      //     by the loop below stays LAST (it is what `_bind_some_type`
      //     updates), with the marker intact beneath it.
      //   - non-forall SomeTs (`Impl(...)`): marker + a SECOND self-binding.
      //     `_bind_some_type` updates the second; the first survives as the
      //     ownership marker. Skipped when the name is already bound in
      //     callee_env (e.g. an enclosing impl's type param arriving through
      //     the FuncVal captures — self-binding would shadow the real value).
      sig_some_types := get_all_some_types(func_type);
      {
        (seen_st_ids : ArrayList(String)) = ArrayList(String).new();
        (sg_i : usize) = usize(0);
        while(sg_i < sig_some_types.len(), {
          sg_st := match(sig_some_types.get(sg_i),.Some(t) => t,.None => t_unit());
          sg_id := match(sg_st,.SomeT(id, _, _, _, _, _, _, _, _, _) => id, _ => String.from(""));
          sg_nm := match(sg_st,.SomeT(_, n, _, _, _, _, _, _, _, _) => n, _ => String.from(""));
          (sg_dup : bool) = false;
          (sd_i : usize) = usize(0);
          while((sd_i < seen_st_ids.len()) && !(sg_dup), {
            if(match(seen_st_ids.get(sd_i),.Some(s) => (s == sg_id),.None => false), {
              sg_dup = true;
            });
            sd_i = (sd_i + usize(1));
          });
          if((!(sg_dup)) && (sg_nm.len() > usize(0)), {
            seen_st_ids.push(sg_id);
            (sg_is_forall : bool) = false;
            (sf_i : usize) = usize(0);
            while((sf_i < n_forall) && !(sg_is_forall), {
              if(match(fl.get(sf_i),.Some(l) => (l == sg_nm),.None => false), {
                sg_is_forall = true;
              });
              sf_i = (sf_i + usize(1));
            });
            sg_already_bound := (get_variables_from_env(callee_env, sg_nm).len() > usize(0));
            if(sg_is_forall || !(sg_already_bound), {
              _ := add_variable_to_env(
                callee_env,
                sg_nm,
                t_type(),
                Option(EvalValue).Some(create_type_value(sg_st)),
                true,
                false,
                false,
                false,
                synthetic_token(sg_nm, callee_env.module_path)
              );
            });
            if((!(sg_is_forall)) && !(sg_already_bound), {
              // The updatable second binding for non-forall SomeTs.
              _ := add_variable_to_env(
                callee_env,
                sg_nm,
                t_type(),
                Option(EvalValue).Some(create_type_value(sg_st)),
                true,
                false,
                false,
                false,
                synthetic_token(sg_nm, callee_env.module_path)
              );
            });
          });
          sg_i = (sg_i + usize(1));
        });
      };
      (fpi : usize) = usize(0);
      while(fpi < n_forall, {
        flabel := match(fl.get(fpi),.Some(l) => l,.None => String.from(""));
        ftype := match(ft.get(fpi),.Some(t) => t,.None => t_unit());
        ftype_inner := match(ft.get(fpi),.Some(t) => t,.None => t_unit());
        (forall_val : EvalValue) = EvalValue.UnknownVal(box(ftype_inner));
        // If caller supplied explicit forall(…) args, try to resolve.
        match(
          forall_args_opt,
          .Some(fas) => {
            match(
              fas.get(fpi),
              .Some(fa) => {
                if(!(ast_expr_is_atom_of(fa, "_")), {
                  evaled_fa := evaluate_expression_raw(fa, caller_env, ctx, exn);
                  fa_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_fa));
                  match(
                    fa_info_opt,
                    .Some(fa_info) => {
                      match(
                        fa_info.value,
                        .Some(v) => {
                          forall_val = v;
                        },
                        .None => ()
                      );
                    },
                    .None => ()
                  );
                });
              },
              .None => ()
            );
          },
          .None => ()
        );
        _ := add_variable_to_env(
          callee_env,
          flabel,
          ftype,
          Option(EvalValue).Some(forall_val),
          true,
          // is_compile_time_only
          false,
          false,
          false,
          synthetic_token(flabel, callee_env.module_path)
        );
        fpi = (fpi + usize(1));
      });
      // ----------------------------------------------------------------
      // Step 7: Process regular parameters.
      // ----------------------------------------------------------------
      forall_arg_vals := ArrayList(ArgEntry).new();
      arg_vals := ArrayList(ArgEntry).new();
      rt_args := ArrayList(AstExpr).new();
      (callee_env_m : Environment) = callee_env;
      (caller_env_m : Environment) = caller_env;
      (pi : usize) = usize(0);
      while(pi < n_params, {
        plabel := match(pl.get(pi),.Some(l) => l,.None => String.from(""));
        ptype := match(pt.get(pi),.Some(t) => t,.None => t_unit());
        // Omitted optional parameter (no corresponding argument): bind it
        // to its recorded default value (falling back to an `UnknownVal`
        // of its declared type if, defensively, no default is recorded).
        if(pi >= n_args, {
          (omitted_val : EvalValue) = create_unknown_val(ptype);
          match(
            call_param_defaults.get(pi),
            .Some(d) => match(
              d,
              .Some(dv) => {
                omitted_val = dv;
              },
              .None => ()
            ),
            .None => ()
          );
          _ := add_variable_to_env(
            callee_env_m,
            plabel,
            ptype,
            Option(EvalValue).Some(omitted_val),
            false,
            false,
            false,
            false,
            synthetic_token(plabel, callee_env_m.module_path)
          );
          arg_vals.push(
            ArgEntry(
              value : Option(EvalValue).Some(omitted_val),
              parameter_type : ptype,
              arg_type : ptype
            )
          );
          pi = (pi + usize(1));
          continue;
        });
        parg := match(adjusted_args.get(pi),.Some(a) => a,.None => make_err_expr());
        pr := check_if_function_parameter_matches_argument(
          plabel,
          ptype,
          false,
          // is_ct_only: Phase 3 treats all regular params as runtime
          parg,
          callee_env_m,
          caller_env_m,
          ctx,
          rt_args,
          exn
        );
        callee_env_m = pr.callee_env;
        caller_env_m = pr.caller_env;
        arg_vals.push(
          ArgEntry(
            value : pr.arg_value,
            parameter_type : pr.resolved_param_type,
            arg_type : pr.arg_type
          )
        );
        pi = (pi + usize(1));
      });
      // v4.1: validate the PLACES bound to ref parameters (after argument
      // evaluation so the chain types are resolved). Mirrors TS
      // requireValidRefArgumentPlaces in tryToCallFunctionWithArguments.
      vrf_param_labels := match(
        func_type,
        .Func({ param_labels : vrf_pl }) => vrf_pl,
        _ => ArrayList(String).new()
      );
      vrf_param_is_ref := match(
        func_type,
        .Func({ param_is_ref : vrf_pir }) => vrf_pir,
        _ => ArrayList(bool).new()
      );
      vrf_param_is_owning := match(
        func_type,
        .Func({ param_is_owning : vrf_pio }) => vrf_pio,
        _ => ArrayList(bool).new()
      );
      require_ref_own_argument_exclusivity(
        vrf_param_labels,
        vrf_param_is_ref,
        vrf_param_is_owning,
        adjusted_args,
        caller_env_m,
        ctx,
        exn
      );
      require_valid_ref_argument_places(vrf_param_is_ref, adjusted_args, caller_env_m, ctx, exn);
      // ----------------------------------------------------------------
      // Step 8: Extract resolved forall values from callee_env.
      // ----------------------------------------------------------------
      (fpi2 : usize) = usize(0);
      while(fpi2 < n_forall, {
        flabel2 := match(fl.get(fpi2),.Some(l) => l,.None => String.from(""));
        ftype2 := match(ft.get(fpi2),.Some(t) => t,.None => t_unit());
        vars2 := get_variables_from_env(callee_env_m, flabel2);
        n_vars2 := vars2.len();
        if(n_vars2 > usize(0), {
          last_v_opt := vars2.get(n_vars2 - usize(1));
          match(
            last_v_opt,
            .Some(last_v) => {
              match(
                last_v.value,
                .Some(v) => {
                  forall_arg_vals.push(
                    ArgEntry(
                      value :.Some(v),
                      parameter_type : ftype2,
                      arg_type : last_v.ty
                    )
                  );
                },
                .None => ()
              );
            },
            .None => ()
          );
        });
        fpi2 = (fpi2 + usize(1));
      });
      // ----------------------------------------------------------------
      // Step 8b: Re-apply where-clause constraints now that parameters are
      // bound. Mirrors helper.ts:1493-1506 (applyWhereClauseConstraints) →
      // validateSingleTraitOnConcreteType (types/function.ts:974): every
      // constraint whose LHS param is now bound to a CONCRETE type must be
      // validated — `Mutex(NonSendObj)` against `where(T <: Send)` is
      // rejected here.
      match(
        func_val,
        .Some(wfv) => match(
          wfv,
          .FuncVal(_, _, _, _, _, _, _, _, wfvid) => validate_where_constraints_for_call(wfvid.clone(), callee_env_m, tok, exn),
          _ => ()
        ),
        .None => ()
      );
      // ----------------------------------------------------------------
      // Step 9: Evaluate return type.
      // ----------------------------------------------------------------
      (return_type : TypeValue) = evaluate_function_return_type_again(ret_b.*, callee_env_m, ctx);
      // Step 10: Synthesize return type against the caller's expected type.
      if(ctx.expected_type.is_some(), {
        match(
          ctx.expected_type,
          .Some(et) => {
            checked_ret := ArrayList(TypePair).new();
            (synth_ret_opts : Option(SynthesizeOptions)) = Option(SynthesizeOptions).None;
            synth_ret := synthesize_types(
              return_type,
              callee_env_m,
              et.ty,
              et.env,
              checked_ret,
              synth_ret_opts,
              exn
            );
            callee_env_m = synth_ret.expected_env;
            return_type = evaluate_function_return_type_again(ret_b.*, callee_env_m, ctx);
          },
          .None => ()
        );
      });
      // ----------------------------------------------------------------
      // Step 11: Process implicit parameters.
      // ----------------------------------------------------------------
      implicit_arg_vals := ArrayList(ArgEntry).new();
      n_impl := il.len();
      (impl_i : usize) = usize(0);
      while(impl_i < n_impl, {
        impl_label := match(il.get(impl_i),.Some(l) => l,.None => String.from(""));
        impl_type := match(it.get(impl_i),.Some(t) => t,.None => t_unit());
        resolved_impl_type := evaluate_function_parameter_type_again(impl_type, callee_env_m, ctx);
        (resolved : bool) = false;
        // Check for an explicit … arg at position impl_i.
        match(
          using_args_opt,
          .Some(uas) => {
            match(
              uas.get(impl_i),
              .Some(ua_expr) => {
                evaled_ua := evaluate_expression_raw(ua_expr, caller_env_m, ctx, exn);
                ua_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_ua));
                match(
                  ua_info_opt,
                  .Some(ua_info) => {
                    caller_env_m = ua_info.env;
                    match(
                      ua_info.value,
                      .Some(ua_val) => {
                        if(!(are_types_compatible(resolved_impl_type, ua_info.ty)), {
                          exn.throw(
                            dyn(
                              format_error_message(
                                ast_expr_token(ua_expr),
                                `Incompatible type for implicit parameter "${impl_label}"`,
                                false,
                                .None
                              )
                            )
                          );
                        });
                        impl_tok := synthetic_token(impl_label, callee_env_m.module_path);
                        _ := add_variable_to_env(
                          callee_env_m,
                          impl_label,
                          resolved_impl_type,
                          .Some(ua_val),
                          true,
                          // is_compile_time_only
                          false,
                          false,
                          true,
                          // is_implicit
                          impl_tok
                        );
                        implicit_arg_vals.push(
                          ArgEntry(
                            value :.Some(ua_val),
                            parameter_type : resolved_impl_type,
                            arg_type : ua_info.ty
                          )
                        );
                        resolved = true;
                      },
                      .None => ()
                    );
                  },
                  .None => ()
                );
              },
              .None => ()
            );
          },
          .None => ()
        );
        // Fall back: search caller_env for a matching given variable.
        if(!(resolved), {
          all_cenv_vars := get_all_variables_from_env(caller_env_m);
          n_cenv := all_cenv_vars.len();
          (found_given : bool) = false;
          (given_val : Option(EvalValue)) = Option(EvalValue).None;
          (given_ty : TypeValue) = t_unit();
          (given_name : String) = String.from("");
          (vi : usize) = usize(0);
          while((vi < n_cenv) && !(found_given), {
            gv_opt := all_cenv_vars.get(vi);
            match(
              gv_opt,
              .Some(gv) => {
                if(gv.is_implicit && (
                  gv.is_compile_time_only &&
                    (
                      (!(gv.is_from_effect_spread)) &&
                        are_types_compatible(resolved_impl_type, gv.ty)
                    )
                ), {
                  found_given = true;
                  given_val = gv.value;
                  given_ty = gv.ty;
                  given_name = gv.name;
                });
              },
              .None => ()
            );
            vi = (vi + usize(1));
          });
          if(!(found_given), {
            exn.throw(
              dyn(
                format_error_message(
                  tok,
                  `No "given" variable found for implicit parameter "${impl_label}"`,
                  false,
                  .None
                )
              )
            );
          });
          match(
            given_val,
            .Some(gv_val) => {
              impl_tok2 := synthetic_token(impl_label, callee_env_m.module_path);
              _ := add_variable_to_env(
                callee_env_m,
                impl_label,
                resolved_impl_type,
                .Some(gv_val),
                true,
                // is_compile_time_only
                false,
                false,
                true,
                // is_implicit
                impl_tok2
              );
              implicit_arg_vals.push(
                ArgEntry(
                  value :.Some(gv_val),
                  parameter_type : resolved_impl_type,
                  arg_type : given_ty
                )
              );
            },
            .None => {
              exn.throw(
                dyn(
                  format_error_message(
                    tok,
                    `The "given" variable "${given_name}" has no compile-time value`,
                    false,
                    .None
                  )
                )
              );
            }
          );
        });
        impl_i = (impl_i + usize(1));
      });
      // ----------------------------------------------------------------
      // Step 12: Validate return type and build FuncCallResult.
      // ----------------------------------------------------------------
      validate_function_return_type(return_type, expr, callee_env_m, ctx, exn);
      implicit_args_result := if(
        implicit_arg_vals.len() > usize(0),
        Option(ArrayList(ArgEntry)).Some(implicit_arg_vals),
        Option(ArrayList(ArgEntry)).None
      );
      // ----------------------------------------------------------------
      // Step 12b: Create specialized function value if needed.
      // Simplified port of the specialization guard in helper.ts.
      // ----------------------------------------------------------------
      is_func_generic := ((fl.len() > usize(0)) || (il.len() > usize(0)));
      (spec_func_val : Option(EvalValue)) = Option(EvalValue).None;
      if(!(skip_specialization) && is_func_generic, {
        is_recursive_spec := match(
          ctx.currently_specializing_function,
          .Some(spec_info) => match(
            func_val,
            .Some(fv) => match(
              fv,
              .FuncVal(_, _, _, _, _, _, _, _, fid) =>
                (spec_info.original_func_id == fid),
              _ => false
            ),
            .None => false
          ),
          .None => false
        );
        is_concrete_fv := match(
          func_val,
          .Some(fv) => match(fv,.FuncVal(_, _, _, _, _, _, _, _, _) => true, _ => false),
          .None => false
        );
        if(!(is_recursive_spec) && is_concrete_fv, {
          fv2 := match(func_val,.Some(v) => v,.None => EvalValue.UnitVal);
          // ----------------------------------------------------------------
          // Ctl function path: isControlFunction + has forall params.
          // Must come before regular specialization to override it.
          // Mirrors the `isControlFunction` branch in helper.ts step 12b.
          // ----------------------------------------------------------------
          fv2_func_id := match(
            fv2,
            .FuncVal(_, _, _, _, _, _, _, _, fid2) => fid2,
            _ => String.from("")
          );
          is_ctl := is_control_fn(fv2_func_id.clone());
          has_forall := (fl.len() > usize(0));
          if(is_ctl && has_forall, {
            spec_func_val = Option(EvalValue).Some(
              evaluate_ctl_function_body_inline(
                fv2,
                func_type,
                callee_env_m,
                caller_env_m,
                ctx,
                exn
              )
            );
          });
          // Regular specialization if ctl path did not produce a result.
          if(spec_func_val.is_none(), {
            spec_av := ArgValues(
              forall_args : forall_arg_vals,
              args : arg_vals,
              implicit_args : implicit_args_result,
              variadic_args : ArrayList(VarArgEntry).new()
            );
            spec_func_val = Option(EvalValue).Some(
              create_specialized_function_inline(
                fv2,
                func_type,
                spec_av,
                callee_env_m,
                caller_env_m,
                ctx,
                exn
              )
            );
          });
        });
      });
      FuncCallResult(
        callee_env : callee_env_m,
        caller_env : caller_env_m,
        path_collection : path_collection_new(),
        return_type : return_type,
        return_value : Option(EvalValue).None,
        arg_values : ArgValues(
          forall_args : forall_arg_vals,
          args : arg_vals,
          implicit_args : implicit_args_result,
          variadic_args : ArrayList(VarArgEntry).new()
        ),
        runtime_arg_exprs_in_order : rt_args,
        specialized_function_value : spec_func_val,
        deferred_drop_expressions : Option(ArrayList(AstExpr)).None
      )
    },
    _ => {
      // Soft fallback: when the callee's type isn't `.Func(...)` (e.g.
      // it's a source-namespace struct from an `impl({...})` operator binding like
      // `(-) :: impl({ Call :: (neg, comptime_neg); })`, or a `SomeT`
      // that hasn't been resolved to a Func yet), return a placeholder
      // `FuncCallResult` with `t_unit()` return instead of aborting
      // the surrounding eval. This lets the bootstrap make progress
      // through prelude impls that exercise operator-trait dispatch
      // patterns the bootstrap doesn't yet model. Tracked as an
      // evaluator coverage gap in `issues/yo-self-evaluator-gaps.md`.
      _ := tok;
      FuncCallResult(
        callee_env : caller_env,
        caller_env : caller_env,
        path_collection : path_collection_new(),
        return_type : t_unit(),
        return_value : Option(EvalValue).None,
        arg_values : ArgValues(
          forall_args : ArrayList(ArgEntry).new(),
          args : ArrayList(ArgEntry).new(),
          implicit_args : Option(ArrayList(ArgEntry)).None,
          variadic_args : ArrayList(VarArgEntry).new()
        ),
        runtime_arg_exprs_in_order : ArrayList(AstExpr).new(),
        specialized_function_value : Option(EvalValue).None,
        deferred_drop_expressions : Option(ArrayList(AstExpr)).None
      )
    }
  )
});
export(try_to_call_function_with_arguments);
export(check_if_function_parameter_matches_argument);
export(validate_where_constraints_for_call);
export(extract_function_value);
export(validate_function_return_type);
export(generate_deferred_drop_expressions);
export(value_to_signature_string);
export(compute_compile_time_signature);
export(create_specialized_function_inline);
export(evaluate_ctl_function_body_inline);
