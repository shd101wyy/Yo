//! evaluator/calls/helper — stub for try_to_call_function_with_arguments.
//!
//! Phase 2x stub. Full implementation planned for Phase 3.
//! 1:1 port of `src/evaluator/calls/helper.ts`.
//!
//! `try_to_call_function_with_arguments` is the core function-call helper that:
//!   1. Resolves forall type variables from argument types.
//!   2. Matches arguments against function parameters (type-checks).
//!   3. Optionally executes CTFE (unless skip_ctfe_execution is true).
//!   4. Returns a `FuncCallResult` with the resolved return type, runtime arg
//!      expressions, updated caller env, and deferred drop expressions.
//!
//! Ported functions (Phase 3):
//!   * `extract_function_value` — extract FuncVal from EvalValue
//!   * `_module_type_contains_ctl_field` — stub (no isControlFunction in yo-self)
//!   * `_get_variables_needing_drop` — simplified (type_contains_rc_type is stub)
//!   * `generate_deferred_drop_expressions` — generates ___drop calls for RC vars
//!   * `validate_function_return_type` — checks return type SomeTs are resolvable

open import "std/string";
{ ArrayList }                                 :: import "std/collections/array_list";

{ AstExpr, ast_expr_token, ast_expr_id,
  ast_expr_is_fn_call_of, ast_expr_is_atom_of,
  make_err_expr }                              :: import "../../expr/expr.yo";
{ Environment,
  Variable,
  get_variables_from_env,
  get_all_variables_from_env,
  add_variable_to_env,
  synthetic_token }                           :: import "../../env/env.yo";
{ TypeValue, t_unit }                         :: import "../../types/type.yo";
{ get_all_some_types }                        :: import "../../types/utils.yo";
{ is_some_type }                              :: import "../../types/guards.yo";
{ type_implements_future,
  type_implements_fn }                        :: import "../trait_checking.yo";
{ EvalValue }                                 :: import "../value.yo";
{ EvalContext,
  FuncCallResult,
  ArgValues, ArgEntry, VarArgEntry,
  ExpectedTypeCtx }                           :: import "../context.yo";
{ PathCollection, path_collection_new,
  ExprInfo, new_expr_info,
  expr_info_table_get }                       :: import "../../expr/expr_info.yo";
{ evaluate_expression }                       :: import "../exprs/expr.yo";
{ SynthesizeResult, SynthesizeOptions,
  TypePair, synthesize_types }                :: import "../types/synthesizer.yo";
{ are_types_compatible }                      :: import "../../types/compatibility.yo";
{ evaluate_function_parameter_type_again,
  evaluate_function_return_type_again }       :: import "../types/function.yo";
{ generate_expr_from_code }                   :: import "../../parser/parser.yo";
{ format_error_message }                      :: import "../../error/error.yo";
{ Exception }                                 :: import "std/error";

// ---------------------------------------------------------------------------
// extract_function_value
// ---------------------------------------------------------------------------

/// Extract a FuncVal from an optional EvalValue.
/// Closures are runtime-only and have no FuncVal at compile time.
///
/// Mirrors `extractFunctionValue` in `src/evaluator/calls/helper.ts`.
extract_function_value :: (fn(value : Option(EvalValue)) -> Option(EvalValue))(
  match(value,
    .None    => Option(EvalValue).None,
    .Some(v) => match(v,
      .FuncVal(_, _, _, _, _, _, _, _, _) => Option(EvalValue).Some(v),
      _                                   => Option(EvalValue).None
    )
  )
);

// ---------------------------------------------------------------------------
// _module_type_contains_ctl_field
// ---------------------------------------------------------------------------

/// Return true if any field of `module_type` is a "control function"
/// (one that uses `escape` to control the continuation).
///
/// Phase 3 simplification: `FuncVal` has no `isControlFunction` flag in
/// yo-self, so this always returns `false`.
///
/// Mirrors `moduleTypeContainsCtlField` in `src/evaluator/calls/helper.ts`.
_module_type_contains_ctl_field :: (fn(
  _module_type : TypeValue,
  _module_val  : Option(EvalValue)
) -> bool)(false);

// ---------------------------------------------------------------------------
// _get_variables_needing_drop
// ---------------------------------------------------------------------------

/// Return variables from the top env frame that need RC drop calls.
///
/// Phase 3 simplification: `type_contains_rc_type` is a stub that always
/// returns `false`, so this returns an empty list.
///
/// Mirrors `getVariablesNeedingDrop` in `src/env.ts`.
_get_variables_needing_drop :: (fn(env : Environment) -> ArrayList(Variable))({
  result := ArrayList(Variable).new();
  n := env.frames.len();
  if((n == usize(0)), { return result; });
  match(env.frames.get((n - usize(1))),
    .None => (),
    .Some(top_frame) => {
      m := top_frame.variables.len();
      (i : usize) = usize(0);
      while runtime((i < m)), {
        match(top_frame.variables.get(i),
          .Some(v) => {
            if(((!(v.consumed_at_token.is_some())) && v.is_owning_the_rc_value), {
              // Phase 3: type_contains_rc_type is stub (always false),
              // so no variable qualifies for dropping yet.
              // Full implementation: also check type_contains_rc_type(v.ty).
              _ := v;
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      };
    }
  );
  result
});

// ---------------------------------------------------------------------------
// generate_deferred_drop_expressions
// ---------------------------------------------------------------------------

/// Generate `___drop(varName)` expressions for variables that need RC cleanup.
///
/// Phase 3: returns `None` (no variables qualify with the current stub for
/// `type_contains_rc_type`).
///
/// Mirrors `generateDeferredDropExpressions` in `src/evaluator/calls/helper.ts`.
generate_deferred_drop_expressions :: (fn(
  variables_to_drop : ArrayList(Variable),
  env               : Environment,
  ctx               : *(EvalContext),
  using(exn         : Exception)
) -> Option(ArrayList(AstExpr)))({
  n := variables_to_drop.len();
  if((n == usize(0)), { return Option(ArrayList(AstExpr)).None; });

  deferred := ArrayList(AstExpr).new();
  (cur_env : Environment) = env;
  (i : usize) = usize(0);
  while runtime((i < n)), {
    match(variables_to_drop.get(i),
      .Some(variable) => {
        // Build the drop expression: ___drop(varName)
        drop_code := `___drop(${variable.name})`;
        drop_expr := generate_expr_from_code(drop_code.as_str(), using(exn));
        evaluated := evaluate_expression(drop_expr, cur_env, ctx);
        // Phase 3: env update from ExprInfo is skipped; cur_env stays unchanged.
        _ := evaluated;
        deferred.push(evaluated);
      },
      .None => ()
    );
    i = (i + usize(1));
  };

  if((deferred.len() == usize(0)),
    Option(ArrayList(AstExpr)).None,
    Option(ArrayList(AstExpr)).Some(deferred)
  )
});

// ---------------------------------------------------------------------------
// validate_function_return_type
// ---------------------------------------------------------------------------

/// Validate that the return type does not contain unresolved SomeType variables
/// that cannot be inferred from the caller's environment.
///
/// Throws an Exception if a SomeType is found in the return type that has no
/// corresponding variable in the env AND is not a Future/Fn impl type.
///
/// Mirrors `validateFunctionReturnType` in `src/evaluator/calls/helper.ts`.
validate_function_return_type :: (fn(
  return_type : TypeValue,
  expr        : AstExpr,
  env         : Environment,
  ctx         : *(EvalContext),
  using(exn   : Exception)
) -> unit)({
  // Skip validation if inside function-type evaluation or when expected type is set.
  if((ctx.is_evaluating_function_type), { return (); });
  if((ctx.expected_type.is_some()), { return (); });

  some_types := get_all_some_types(return_type);
  n := some_types.len();
  (i : usize) = usize(0);
  while runtime((i < n)), {
    match(some_types.get(i),
      .None    => (),
      .Some(st) =>
        match(st,
          .SomeT(_, name, _, _, required_trait_types, _, _, _, _) => {
            // Determine whether this SomeT should be skipped.
            should_skip := (
              type_implements_future(st) ||
              type_implements_fn(st) ||
              (required_trait_types.len() > usize(0))
            );
            if(!(should_skip), {
              // Check if name is directly in the env.
              vars := get_variables_from_env(env, name);
              if((vars.len() == usize(0)), {
                // Check transitively via all variables' TypeVal values.
                all_vars := get_all_variables_from_env(env);
                (found_transitively : bool) = false;
                (j : usize) = usize(0);
                nv := all_vars.len();
                while runtime(((j < nv) && !(found_transitively))), {
                  match(all_vars.get(j),
                    .Some(var) => {
                      match(var.value,
                        .Some(ev) => {
                          match(ev,
                            .TypeVal(ty_box) => {
                              transitive := get_all_some_types(ty_box.*);
                              (k : usize) = usize(0);
                              while runtime(((k < transitive.len()) && !(found_transitively))), {
                                match(transitive.get(k),
                                  .Some(tst) => {
                                    match(tst,
                                      .SomeT(_, tname, _, _, _, _, _, _, _) => {
                                        if((tname == name), { found_transitively = true; });
                                      },
                                      _ => ()
                                    );
                                  },
                                  .None => ()
                                );
                                k = (k + usize(1));
                              };
                            },
                            _ => ()
                          );
                        },
                        .None => ()
                      );
                    },
                    .None => ()
                  );
                  j = (j + usize(1));
                };
                // Not found even transitively — throw error.
                if(!(found_transitively), {
                  exn.throw(dyn format_error_message(
                    ast_expr_token(expr),
                    String.from("Failed to infer the function call return type.\nPlease consider providing the expected type."),
                    false,
                    .None
                  ));
                });
              });
            });
          },
          _ => ()
        )
    );
    i = (i + usize(1));
  };
});

// ---------------------------------------------------------------------------
// Local helper: extract the args ArrayList from a FnCall AstExpr.
// ---------------------------------------------------------------------------

_h_get_fn_call_args :: (fn(e : AstExpr) -> ArrayList(AstExpr))(
  match(e,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _)               => ArrayList(AstExpr).new()
  )
);

// ---------------------------------------------------------------------------
// CheckParamResult — result of check_if_function_parameter_matches_argument
// ---------------------------------------------------------------------------

CheckParamResult :: object(
  callee_env          : Environment,
  caller_env          : Environment,
  arg_value           : Option(EvalValue),
  arg_type            : TypeValue,
  resolved_param_type : TypeValue
);

// ---------------------------------------------------------------------------
// check_if_function_parameter_matches_argument
// Phase 3 port of checkIfFunctionParameterMatchesArgument (helper.ts).
// ---------------------------------------------------------------------------

/// Check that one function parameter matches its argument expression.
/// Evaluates the arg, synthesizes type bindings into callee_env, and adds
/// the parameter variable to callee_env.
check_if_function_parameter_matches_argument :: (fn(
  param_label                : String,
  param_type                 : TypeValue,
  is_ct_only                 : bool,
  arg_expr_raw               : AstExpr,
  callee_env                 : Environment,
  caller_env                 : Environment,
  ctx                        : *(EvalContext),
  runtime_arg_exprs_in_order : ArrayList(AstExpr),
  using(exn                  : Exception)
) -> CheckParamResult)({
  // Step 1: Strip "label: value" colon-label wrapper from arg if present.
  (actual_arg : AstExpr) = arg_expr_raw;
  if(ast_expr_is_fn_call_of(arg_expr_raw, ":", .Some(usize(2))), {
    colon_args := _h_get_fn_call_args(arg_expr_raw);
    actual_arg = match(colon_args.get(usize(1)),
      .Some(a) => a,
      .None    => arg_expr_raw
    );
  });

  // Step 2: Evaluate param type in callee_env.
  (callee_env_r : Environment) = callee_env;
  resolved_pt := evaluate_function_parameter_type_again(param_type, callee_env_r, ctx);

  // Step 3: Evaluate arg with param type as expected-type hint.
  saved_exp := ctx.expected_type;
  ctx.expected_type = .Some(ExpectedTypeCtx(ty: resolved_pt, env: callee_env_r));
  evaled_arg := evaluate_expression(actual_arg, caller_env, ctx);
  ctx.expected_type = saved_exp;

  // Extract ExprInfo for the evaluated arg.
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_arg));
  arg_info := match(arg_info_opt,
    .Some(i) => i,
    .None    => {
      exn.throw(dyn format_error_message(
        ast_expr_token(actual_arg),
        String.from("check_if_function_parameter_matches_argument: arg has no ExprInfo"),
        false,
        .None
      ));
      new_expr_info(caller_env, t_unit())
    }
  );

  (caller_env_r : Environment) = arg_info.env;
  arg_type  := arg_info.ty;
  arg_value := arg_info.value;

  // Step 4: Append to runtime arg list if not comptime-only.
  if(!(is_ct_only), {
    runtime_arg_exprs_in_order.push(evaled_arg);
  });

  // Step 5: Comptime check — runtime arg cannot fill a comptime parameter.
  if(is_ct_only, {
    is_rt := match(arg_value,
      .None    => true,
      .Some(v) => match(v,
        .UnknownVal(_) => true,
        .VarRef(_)     => true,
        _              => false
      )
    );
    if(is_rt, {
      exn.throw(dyn format_error_message(
        ast_expr_token(actual_arg),
        `Cannot assign runtime argument to compile-time parameter "${param_label}"`,
        false,
        .None
      ));
    });
  });

  // Step 6: Synthesize forall bindings from arg type into callee_env.
  checked := ArrayList(TypePair).new();
  synth := synthesize_types(
    resolved_pt,  callee_env_r,
    arg_type,     caller_env_r,
    &(checked),
    Option(SynthesizeOptions).None,
    using(exn)
  );
  callee_env_r = synth.expected_env;

  // Step 7: Re-evaluate param type with the updated callee_env.
  final_pt := evaluate_function_parameter_type_again(resolved_pt, callee_env_r, ctx);

  // Step 8: Type-compatibility check.
  if(!(are_types_compatible(final_pt, arg_type)), {
    exn.throw(dyn format_error_message(
      ast_expr_token(actual_arg),
      `Type mismatch for parameter "${param_label}"`,
      false,
      .None
    ));
  });

  // Step 9: Bind param variable in callee_env.
  param_tok := synthetic_token(param_label, callee_env_r.module_path);
  _ := add_variable_to_env(
    &(callee_env_r),
    param_label, final_pt, arg_value,
    is_ct_only,
    false,  // is_reassignable
    false,  // is_owning_the_rc_value
    false,  // is_implicit
    param_tok
  );

  CheckParamResult(
    callee_env:          callee_env_r,
    caller_env:          caller_env_r,
    arg_value:           arg_value,
    arg_type:            arg_type,
    resolved_param_type: final_pt
  )
});

// ---------------------------------------------------------------------------
// try_to_call_function_with_arguments
// ---------------------------------------------------------------------------

/// Type-check the arguments of a function call against `func_type` and
/// (optionally) execute CTFE. Returns a `FuncCallResult` with the resolved
/// return type, runtime arg expressions, updated caller env, and deferred
/// drop expressions.
///
/// Phase 3 port of `tryToCallFunctionWithArguments` in
/// `src/evaluator/calls/helper.ts`.
///
/// Phase 3 simplifications (relative to the full TypeScript implementation):
///   * CTFE is not executed — return_value is always None.
///   * Specialization caching is skipped — specialized_function_value is None.
///   * RC ownership / deferred drop expressions are skipped.
///   * Quote parameters are not supported (throw on encounter).
///   * Where-clause constraints are skipped (TypeValue has no AstExpr forms).
try_to_call_function_with_arguments :: (fn(
  func_val            : Option(EvalValue),
  func_type           : TypeValue,
  expr                : AstExpr,
  callee_expr         : AstExpr,
  arg_exprs           : ArrayList(AstExpr),
  caller_env          : Environment,
  ctx                 : *(EvalContext),
  is_method_call      : bool,
  skip_specialization : bool,
  skip_ctfe_execution : bool,
  using(exn           : Exception)
) -> FuncCallResult)({
  _ := callee_expr;
  _ := skip_specialization;
  _ := skip_ctfe_execution;
  tok := ast_expr_token(expr);

  match(func_type,
    .Func(fl, ft, pl, pt, il, it, ispr, wt, ret_b) => {
      _ := ispr;
      _ := wt;

      // ----------------------------------------------------------------
      // Step 1: Detect explicit forall(…) argument.
      // ----------------------------------------------------------------
      (forall_args_opt : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
      (regular_start   : usize) = usize(0);

      has_f0 := match(arg_exprs.get(usize(0)),
        .Some(a) => ast_expr_is_fn_call_of(a, "forall", Option(usize).None),
        .None    => false
      );
      if(has_f0, {
        fa0 := match(arg_exprs.get(usize(0)), .Some(a) => a, .None => make_err_expr());
        forall_args_opt = .Some(_h_get_fn_call_args(fa0));
        regular_start = usize(1);
      });

      // For method calls, forall may appear at index 1 (self is at 0).
      if(((!(has_f0)) && (is_method_call && (arg_exprs.len() > usize(1)))), {
        has_f1 := match(arg_exprs.get(usize(1)),
          .Some(a) => ast_expr_is_fn_call_of(a, "forall", Option(usize).None),
          .None    => false
        );
        if(has_f1, {
          fa1 := match(arg_exprs.get(usize(1)), .Some(a) => a, .None => make_err_expr());
          forall_args_opt = .Some(_h_get_fn_call_args(fa1));
          // Phase 3: no arg reordering needed; self is still at adjusted_args[0].
        });
      });

      // ----------------------------------------------------------------
      // Step 2: Split using(…) arg out; collect regular args.
      // ----------------------------------------------------------------
      (using_args_opt : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
      adjusted_args   := ArrayList(AstExpr).new();

      n_total := arg_exprs.len();
      (ai : usize) = regular_start;
      while runtime((ai < n_total)), {
        a := match(arg_exprs.get(ai), .Some(x) => x, .None => make_err_expr());
        if(ast_expr_is_fn_call_of(a, "using", Option(usize).None), {
          using_args_opt = .Some(_h_get_fn_call_args(a));
        }, {
          adjusted_args.push(a);
        });
        ai = (ai + usize(1));
      };

      // ----------------------------------------------------------------
      // Step 3: Argument count check.
      // ----------------------------------------------------------------
      n_params := pl.len();
      n_args   := adjusted_args.len();
      if((n_args != n_params), {
        exn.throw(dyn format_error_message(
          tok,
          `Argument count mismatch: expected ${n_params.to_string()} arguments, got ${n_args.to_string()}`,
          false,
          .None
        ));
      });

      // ----------------------------------------------------------------
      // Step 4: Build callee_env from FuncVal captures (or empty).
      // ----------------------------------------------------------------
      (callee_env : Environment) = match(func_val,
        .Some(fv) => match(fv,
          .FuncVal(_, _, _, _, _, cn, ct, cv, _) => {
            fenv := Environment.new(caller_env.module_path);
            (ci : usize) = usize(0);
            n_cap := cn.len();
            while runtime((ci < n_cap)), {
              cname := match(cn.get(ci), .Some(s) => s, .None => String.from(""));
              cty   := match(ct.get(ci), .Some(t) => t, .None => t_unit());
              cval  := match(cv.get(ci),
                .Some(v) => Option(EvalValue).Some(v),
                .None    => Option(EvalValue).None
              );
              is_ct_cap := match(cval, .Some(_) => true, .None => false);
              _ := add_variable_to_env(
                &(fenv),
                cname, cty, cval, is_ct_cap,
                false, false, false,
                synthetic_token(cname, fenv.module_path)
              );
              ci = (ci + usize(1));
            };
            fenv
          },
          _ => Environment.new(caller_env.module_path)
        ),
        .None => Environment.new(caller_env.module_path)
      );

      // Step 5: Push a new frame on callee_env for parameter bindings.
      _ := callee_env.push_frame(false);

      // ----------------------------------------------------------------
      // Step 6: Add forall params as UnknownVal placeholders (or resolve
      //         them from an explicit forall(…) argument).
      // ----------------------------------------------------------------
      n_forall := fl.len();
      (fpi : usize) = usize(0);
      while runtime((fpi < n_forall)), {
        flabel      := match(fl.get(fpi), .Some(l) => l, .None => String.from(""));
        ftype       := match(ft.get(fpi), .Some(t) => t, .None => t_unit());
        ftype_inner := match(ft.get(fpi), .Some(t) => t, .None => t_unit());
        (forall_val : EvalValue) = EvalValue.UnknownVal(box(ftype_inner));

        // If caller supplied explicit forall(…) args, try to resolve.
        match(forall_args_opt,
          .Some(fas) => {
            match(fas.get(fpi),
              .Some(fa) => {
                if(!(ast_expr_is_atom_of(fa, "_")), {
                  evaled_fa := evaluate_expression(fa, caller_env, ctx);
                  fa_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_fa));
                  match(fa_info_opt,
                    .Some(fa_info) => {
                      match(fa_info.value,
                        .Some(v) => { forall_val = v; },
                        .None    => ()
                      );
                    },
                    .None => ()
                  );
                });
              },
              .None => ()
            );
          },
          .None => ()
        );

        _ := add_variable_to_env(
          &(callee_env),
          flabel, ftype,
          Option(EvalValue).Some(forall_val),
          true,   // is_compile_time_only
          false, false, false,
          synthetic_token(flabel, callee_env.module_path)
        );
        fpi = (fpi + usize(1));
      };

      // ----------------------------------------------------------------
      // Step 7: Process regular parameters.
      // ----------------------------------------------------------------
      forall_arg_vals := ArrayList(ArgEntry).new();
      arg_vals        := ArrayList(ArgEntry).new();
      rt_args         := ArrayList(AstExpr).new();
      (callee_env_m : Environment) = callee_env;
      (caller_env_m : Environment) = caller_env;

      (pi : usize) = usize(0);
      while runtime((pi < n_params)), {
        plabel := match(pl.get(pi), .Some(l) => l, .None => String.from(""));
        ptype  := match(pt.get(pi), .Some(t) => t, .None => t_unit());
        parg   := match(adjusted_args.get(pi), .Some(a) => a, .None => make_err_expr());

        pr := check_if_function_parameter_matches_argument(
          plabel, ptype,
          false,  // is_ct_only: Phase 3 treats all regular params as runtime
          parg,
          callee_env_m, caller_env_m,
          ctx, rt_args, using(exn)
        );

        callee_env_m = pr.callee_env;
        caller_env_m = pr.caller_env;
        arg_vals.push(ArgEntry(
          value:          pr.arg_value,
          parameter_type: pr.resolved_param_type,
          arg_type:       pr.arg_type
        ));
        pi = (pi + usize(1));
      };

      // ----------------------------------------------------------------
      // Step 8: Extract resolved forall values from callee_env.
      // ----------------------------------------------------------------
      (fpi2 : usize) = usize(0);
      while runtime((fpi2 < n_forall)), {
        flabel2 := match(fl.get(fpi2), .Some(l) => l, .None => String.from(""));
        ftype2  := match(ft.get(fpi2), .Some(t) => t, .None => t_unit());
        vars2   := get_variables_from_env(callee_env_m, flabel2);
        n_vars2 := vars2.len();
        if((n_vars2 > usize(0)), {
          last_v_opt := vars2.get((n_vars2 - usize(1)));
          match(last_v_opt,
            .Some(last_v) => {
              match(last_v.value,
                .Some(v) => {
                  forall_arg_vals.push(ArgEntry(
                    value:          .Some(v),
                    parameter_type: ftype2,
                    arg_type:       last_v.ty
                  ));
                },
                .None => ()
              );
            },
            .None => ()
          );
        });
        fpi2 = (fpi2 + usize(1));
      };

      // ----------------------------------------------------------------
      // Step 9: Evaluate return type.
      // ----------------------------------------------------------------
      (return_type : TypeValue) = evaluate_function_return_type_again(ret_b.*, callee_env_m, ctx);

      // Step 10: Synthesize return type against the caller's expected type.
      if(ctx.expected_type.is_some(), {
        match(ctx.expected_type,
          .Some(et) => {
            checked_ret := ArrayList(TypePair).new();
            synth_ret := synthesize_types(
              return_type, callee_env_m,
              et.ty,        et.env,
              &(checked_ret),
              Option(SynthesizeOptions).None,
              using(exn)
            );
            callee_env_m = synth_ret.expected_env;
            return_type  = evaluate_function_return_type_again(ret_b.*, callee_env_m, ctx);
          },
          .None => ()
        );
      });

      // ----------------------------------------------------------------
      // Step 11: Process implicit parameters.
      // ----------------------------------------------------------------
      implicit_arg_vals := ArrayList(ArgEntry).new();
      n_impl := il.len();
      (impl_i : usize) = usize(0);
      while runtime((impl_i < n_impl)), {
        impl_label := match(il.get(impl_i), .Some(l) => l, .None => String.from(""));
        impl_type  := match(it.get(impl_i), .Some(t) => t, .None => t_unit());
        resolved_impl_type := evaluate_function_parameter_type_again(impl_type, callee_env_m, ctx);
        (resolved : bool) = false;

        // Check for an explicit using(…) arg at position impl_i.
        match(using_args_opt,
          .Some(uas) => {
            match(uas.get(impl_i),
              .Some(ua_expr) => {
                evaled_ua := evaluate_expression(ua_expr, caller_env_m, ctx);
                ua_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_ua));
                match(ua_info_opt,
                  .Some(ua_info) => {
                    caller_env_m = ua_info.env;
                    match(ua_info.value,
                      .Some(ua_val) => {
                        if(!(are_types_compatible(resolved_impl_type, ua_info.ty)), {
                          exn.throw(dyn format_error_message(
                            ast_expr_token(ua_expr),
                            `Incompatible type for implicit parameter "${impl_label}"`,
                            false,
                            .None
                          ));
                        });
                        impl_tok := synthetic_token(impl_label, callee_env_m.module_path);
                        _ := add_variable_to_env(
                          &(callee_env_m),
                          impl_label, resolved_impl_type,
                          .Some(ua_val),
                          true,   // is_compile_time_only
                          false, false,
                          true,   // is_implicit
                          impl_tok
                        );
                        implicit_arg_vals.push(ArgEntry(
                          value:          .Some(ua_val),
                          parameter_type: resolved_impl_type,
                          arg_type:       ua_info.ty
                        ));
                        resolved = true;
                      },
                      .None => ()
                    );
                  },
                  .None => ()
                );
              },
              .None => ()
            );
          },
          .None => ()
        );

        // Fall back: search caller_env for a matching given variable.
        if(!(resolved), {
          all_cenv_vars := get_all_variables_from_env(caller_env_m);
          n_cenv        := all_cenv_vars.len();
          (found_given : bool) = false;
          (given_val   : Option(EvalValue)) = Option(EvalValue).None;
          (given_ty    : TypeValue) = t_unit();
          (given_name  : String) = String.from("");

          (vi : usize) = usize(0);
          while runtime(((vi < n_cenv) && !(found_given))), {
            gv_opt := all_cenv_vars.get(vi);
            match(gv_opt,
              .Some(gv) => {
                if(((gv.is_implicit && (gv.is_compile_time_only &&
                    ((!(gv.is_from_effect_spread)) &&
                    are_types_compatible(resolved_impl_type, gv.ty))))), {
                  found_given = true;
                  given_val   = gv.value;
                  given_ty    = gv.ty;
                  given_name  = gv.name;
                });
              },
              .None => ()
            );
            vi = (vi + usize(1));
          };

          if(!(found_given), {
            exn.throw(dyn format_error_message(
              tok,
              `No "given" variable found for implicit parameter "${impl_label}"`,
              false,
              .None
            ));
          });

          match(given_val,
            .Some(gv_val) => {
              impl_tok2 := synthetic_token(impl_label, callee_env_m.module_path);
              _ := add_variable_to_env(
                &(callee_env_m),
                impl_label, resolved_impl_type,
                .Some(gv_val),
                true,   // is_compile_time_only
                false, false,
                true,   // is_implicit
                impl_tok2
              );
              implicit_arg_vals.push(ArgEntry(
                value:          .Some(gv_val),
                parameter_type: resolved_impl_type,
                arg_type:       given_ty
              ));
            },
            .None => {
              exn.throw(dyn format_error_message(
                tok,
                `The "given" variable "${given_name}" has no compile-time value`,
                false,
                .None
              ));
            }
          );
        });

        impl_i = (impl_i + usize(1));
      };

      // ----------------------------------------------------------------
      // Step 12: Validate return type and build FuncCallResult.
      // ----------------------------------------------------------------
      validate_function_return_type(return_type, expr, callee_env_m, ctx, using(exn));

      implicit_args_result := if((implicit_arg_vals.len() > usize(0)),
        Option(ArrayList(ArgEntry)).Some(implicit_arg_vals),
        Option(ArrayList(ArgEntry)).None
      );

      FuncCallResult(
        callee_env:                 callee_env_m,
        caller_env:                 caller_env_m,
        path_collection:            path_collection_new(),
        return_type:                return_type,
        return_value:               Option(EvalValue).None,
        arg_values:                 ArgValues(
          forall_args:   forall_arg_vals,
          args:          arg_vals,
          implicit_args: implicit_args_result,
          variadic_args: ArrayList(VarArgEntry).new()
        ),
        runtime_arg_exprs_in_order: rt_args,
        specialized_function_value: Option(EvalValue).None,
        deferred_drop_expressions:  Option(ArrayList(AstExpr)).None
      )
    },
    _ => {
      exn.throw(dyn format_error_message(
        tok,
        String.from("try_to_call_function_with_arguments: func_type is not a Func type"),
        false,
        .None
      ));
      // Unreachable placeholder.
      FuncCallResult(
        callee_env:                 caller_env,
        caller_env:                 caller_env,
        path_collection:            path_collection_new(),
        return_type:                t_unit(),
        return_value:               Option(EvalValue).None,
        arg_values:                 ArgValues(
          forall_args:   ArrayList(ArgEntry).new(),
          args:          ArrayList(ArgEntry).new(),
          implicit_args: Option(ArrayList(ArgEntry)).None,
          variadic_args: ArrayList(VarArgEntry).new()
        ),
        runtime_arg_exprs_in_order: ArrayList(AstExpr).new(),
        specialized_function_value: Option(EvalValue).None,
        deferred_drop_expressions:  Option(ArrayList(AstExpr)).None
      )
    }
  )
});

export try_to_call_function_with_arguments;
export check_if_function_parameter_matches_argument;
export extract_function_value;
export validate_function_return_type;
export generate_deferred_drop_expressions;
