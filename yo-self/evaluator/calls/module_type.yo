/// Bind `arg_exprs` to the fields of `module_type`, returning the module value.
///
/// Phase 2x stub: throws "not yet implemented". Full implementation in Phase 3.
///
/// Mirrors `tryToImplementModuleWithArgumentsByModuleType` in
/// `src/evaluator/calls/module-type.ts`.
try_to_implement_module_with_arguments_by_module_type :: (fn(
  module_expr : AstExpr,
  module_type : TypeValue,
  arg_exprs   : ArrayList(AstExpr),
  caller_env  : Environment,
  ctx         : *(EvalContext),
  using(exn   : Exception)
) -> Option(AstExpr))({
  _ := module_type;
  _ := arg_exprs;
  _ := caller_env;
  _ := ctx;
  exn.throw(dyn format_error_message(
    ast_expr_token(module_expr),
    String.from("try_to_implement_module_with_arguments_by_module_type: not yet implemented (Phase 3)"),
    false,
    .None
  ));
  Option(AstExpr).None
});

export try_to_implement_module_with_arguments_by_module_type;
