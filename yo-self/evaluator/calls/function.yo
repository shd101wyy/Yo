{ create_unknown_val, create_unknown_val_with_name } :: import("../../value.yo");
/// Named call-result unknown: promotes a Type-universe result to
/// `TypeVal(SomeT)`. TS names every result UnknownValue (variableName is
/// REQUIRED for Type-typed slots — createUnknownValue throws otherwise,
/// value.ts:573-588), so a bare UnknownVal of type `Type` cannot reach a
/// type-expecting builtin in TS; in yo-self `types.first()` on an unknown
/// variadic ComptimeList(Type) did exactly that
/// (tests/variadic_comptime.test.yo). Template-free name (hot path).
_call_result_unknown :: (fn(ty : TypeValue, env : Environment) -> EvalValue)({
  nm := String.from("call_result_");
  nm.push_string(random_id(env.module_path));
  create_unknown_val_with_name(ty, nm)
});
{ format_error_message } :: import("../../error.yo");
{ require_ref_own_argument_exclusivity, require_valid_ref_argument_places } :: import("../../types/flowability.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// ReceiverMethodResult — carries the resolved method info when a property-
// access callee (`.`) is matched to a registered impl method.
// Used by `_try_find_receiver_method` below.
// ---------------------------------------------------------------------------
ReceiverMethodResult :: struct(
  method_val_opt : Option(EvalValue),
  method_ty : TypeValue,
  receiver_expr : AstExpr,
  // True when the receiver's VALUE is a TypeValue — a static method call
  // (e.g. `HashMap(K,V).new()`). Static methods take no implicit receiver
  // argument; the caller must NOT prepend `receiver_expr`. Mirrors TS
  // `function.ts:291` `isStaticMethodCall = isTypeValue(receiverValue)`.
  is_static : bool,
  // The method entry's first parameter is `*(T)` and the receiver is a
  // compatible value — the call site must wrap the receiver in `&(...)`.
  // Mirrors TS function.ts:335 `method.needsPointerConversion`.
  needs_pointer_conversion : bool,
  // ALL candidate method entries with this name (in registration order), for
  // overload resolution at the call site. `method_val_opt`/`method_ty`/
  // `needs_pointer_conversion` above are the FIRST hit (the common single-hit
  // case); when `all_hits.len() > 1` the call site trial-calls each and picks
  // the one whose parameters match the arguments. Mirrors TS keeping the full
  // `functions` candidate array (function.ts:330) for overload resolution.
  all_hits : ArrayList(MethodEntry)
);
// ---------------------------------------------------------------------------
// _try_find_receiver_method — when the callee is a property-access expression
// `.(receiver, method_name)` with no ExprInfo, look up the method via env.yo's
// `get_receiver_methods_by_name_from_env`.
//
// Replaces the previous in-file "TypeName.method" qualified-name walk; the
// new env.yo function consults the trait-method registry (keyed by type id),
// applies pointer auto-deref, runs the comptime-receiver retry, walks
// SomeType / Dyn / TypeApplication trait constraints, and falls back to the
// generic-impl registry — covering everything the old local helper did plus
// trait-bounded receivers.
//
// Returns `.Some(ReceiverMethodResult)` if a method was found, `.None` otherwise.
//
// Mirrors the property-access branch of `evaluateFunctionCall` in TypeScript's
// `function.ts` (lines 265-362), specifically the instance-method case.
// ---------------------------------------------------------------------------
_try_find_receiver_method :: (
  fn(
    callee : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> Option(ReceiverMethodResult)
)({
  // 1. callee must be `.(receiver, method_name)` — a 2-arg dot call.
  if(!(ast_expr_is_fn_call_of(callee, BF_DOT, Option(usize).Some(usize(2)))), {
    return(Option(ReceiverMethodResult).None);
  });
  prop_args := match(
    callee,
    .FnCall(_, _, pargs, _, _) => pargs,
    _ => {
      return(Option(ReceiverMethodResult).None);
    }
  );
  receiver_expr := match(
    prop_args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(Option(ReceiverMethodResult).None);
    }
  );
  method_name_expr := match(
    prop_args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(Option(ReceiverMethodResult).None);
    }
  );
  // 2. Get receiver's compiled type AND value from the expr-info table.
  receiver_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(receiver_expr)),
    .Some(ri) => ri,
    .None => {
      return(Option(ReceiverMethodResult).None);
    }
  );
  // A self-shell receiver (the empty `${enum}__self_shell` placeholder used as
  // `Self` while a recursive enum's variant fields were evaluated) carries NO
  // methods — `clone` on it returns hits=0 and the call degenerates to a type
  // value (`Type(1)`), so e.g. `ArrayList(Self).clone()` fails to clone its
  // elements ("Type mismatch for type member"). Resolve the shell to the
  // finalized enum (registered by register_enum_final) so the derived clone is
  // found. No-op for non-shell receivers. issues/yo-self-p1-transpile-tail.md.
  receiver_type := resolve_enum_shell(receiver_info.ty);
  receiver_value := receiver_info.value;
  // 3. Method name token.
  method_tok := ast_expr_token(method_name_expr);
  method_name := method_tok.value.clone();
  // 4. Static vs instance dispatch (mirrors TS function.ts:289-321).
  //    When the receiver's VALUE is a TypeValue (e.g. `HashMap(K,V)`,
  //    `EvenNumber`), this is a STATIC method call: look up methods on the
  //    INNER type (the concrete struct), NOT on `receiver_type` (which is
  //    `Type`/TypeUni — the type-of-a-type — and would never match any
  //    struct's impl). Static methods take no implicit receiver arg.
  //    Otherwise it's an instance call: use `receiver_type` and the full
  //    receiver-method lookup (pointer auto-deref, SomeT/Dyn/TypeApp/comptime
  //    branches, generic-impl fallback). `is_infix_operator_call = false`:
  //    dot-call dispatch is never infix.
  is_static := match(receiver_value,.Some(v) => is_type_val(v),.None => false);
  hits := cond(
    is_static => {
      inner_ty := match(
        receiver_value,
        .Some(rv) => match(rv,.TypeVal(inner_b) => inner_b, _ => receiver_type),
        .None => receiver_type
      );
      get_type_trait_methods_by_name_from_env(env, method_name, inner_ty)
    },
    true => get_receiver_methods_by_name_from_env(
      env,
      method_name,
      receiver_type,
      false
    )
  );
  if(hits.len() == usize(0), {
    return(Option(ReceiverMethodResult).None);
  });
  // Take the first hit (mirrors the prior "first match wins"
  // contract — the call site does parameter unification later).
  first := match(
    hits.get(usize(0)),
    .Some(m) => m,
    .None => {
      return(Option(ReceiverMethodResult).None);
    }
  );
  Option(ReceiverMethodResult).Some(
    ReceiverMethodResult(
      method_val_opt : first.value,
      method_ty : first.ty,
      receiver_expr : receiver_expr,
      is_static : is_static,
      needs_pointer_conversion : first.needs_pointer_conversion,
      all_hits : hits
    )
  )
});
// ---------------------------------------------------------------------------
// _static_dot_receiver_self_type — when the callee is a static method call
// `Type.method` (a 2-arg `.` whose receiver evaluated to a `TypeVal`), return
// that receiver's inner type — the `Self` for the method body. The call site
// sets `ctx.self_type` to it around the body evaluation so `Self` references
// inside the (possibly specialized) body resolve to the concrete receiver
// (e.g. inside `HashMap(K,V).new()`'s body, `Self._alloc_with_capacity(...)`
// dispatches statically on `HashMap(String,X)`). This cascades: each
// `Self.method()` is itself a static dot-call, so the same logic re-sets
// `ctx.self_type` for the next body. Mirrors TS `context.SelfType =
// dereferencedReceiverType`. Returns `.None` for non-static-method callees.
// ---------------------------------------------------------------------------
_static_dot_receiver_self_type :: (
  fn(callee : AstExpr, ctx : EvalContext) -> Option(TypeValue)
)({
  if(!(ast_expr_is_fn_call_of(callee, BF_DOT, Option(usize).Some(usize(2)))), {
    return(Option(TypeValue).None);
  });
  pargs := match(
    callee,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(Option(TypeValue).None);
    }
  );
  recv := match(
    pargs.get(usize(0)),
    .Some(r) => r,
    .None => {
      return(Option(TypeValue).None);
    }
  );
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(recv)),
    .Some(ri) => match(
      ri.value,
      .Some(rv) => match(rv,.TypeVal(ib) => Option(TypeValue).Some(ib), _ => Option(TypeValue).None),
      .None => Option(TypeValue).None
    ),
    .None => Option(TypeValue).None
  )
});
/// Resolve unresolved Array `length_var`s in `ty` by structurally matching it
/// against the concrete `self_ty` (the receiver of a `comptime(Self)` method).
/// Wherever `ty` has `Array(_, _, lvar)` with a non-empty `lvar` and `self_ty`
/// has a concrete `Array(_, len, "")` at the same position, adopt `self_ty`'s
/// length and clear the var. Recurses through array elements / pointers so a
/// nested `Array(Array(u8, U), V)` resolves against `Array(Array(u8, 24), 3)`.
/// Non-matching shapes are left unchanged (safe no-op). yo-self's stand-in for
/// the value-level array-length substitution TS does during return resolution.
_resolve_array_length_vars_from_self :: (
  fn(ty : TypeValue, self_ty : TypeValue) -> TypeValue
)(
  match(
    ty,
    .Array(elem, len, lvar) => match(
      self_ty,
      .Array(s_elem, s_len, s_lvar) => {
        new_elem := recur(elem, s_elem);
        resolve := ((lvar.len() > usize(0)) && (s_lvar.len() == usize(0)));
        new_len := cond(resolve => s_len, true => len);
        new_lvar := cond(resolve => String.from(""), true => lvar);
        TypeValue.Array(new_elem, new_len, new_lvar)
      },
      _ => ty
    ),
    .Pointer(inner) => match(
      self_ty,
      .Pointer(s_inner) => TypeValue.Pointer(recur(inner, s_inner)),
      _ => ty
    ),
    _ => ty
  )
);
/// Trial-call one Call-overload candidate with CLONED exprs and a swallowing
/// exception. On success pushes `true` into `ok_out`; a throw unwinds before
/// the push, leaving `ok_out` empty (the `_trial_eval_fn_body` pattern).
/// The `try_to_call_function_with_arguments` path only type-checks (CTFE
/// execution lives in the FuncVal arm of `evaluate_function_call`), so
/// trials are side-effect-free — mirroring TS's checking phase
/// (`skipSpecialization`/`skipCtfeExecution`, function.ts:807-836).
_trial_call_overload_candidate :: (
  fn(
    fn_val : EvalValue,
    fn_ty : TypeValue,
    call_expr : AstExpr,
    func_expr : AstExpr,
    args : ArrayList(AstExpr),
    callee_env : Environment,
    ctx : EvalContext,
    ok_out : ArrayList(bool)
  ) -> unit
)({
  trial_exn := Exception(throw : ((_err) -> unwind(())));
  // FRESH-ID clones — TS trials use cloneExpr precisely so the dry-run
  // writes fresh `$` slots instead of polluting the real expr's eval data;
  // an id-preserving clone would overwrite the real ExprInfo entries.
  cloned_args := ArrayList(AstExpr).new();
  (ci : usize) = usize(0);
  while(ci < args.len(), {
    match(
      args.get(ci),
      .Some(a) => {
        cloned_args.push(clone_expr_fresh_ids(a));
      },
      .None => ()
    );
    ci = (ci + usize(1));
  });
  try_to_call_function_with_arguments(
    Option(EvalValue).Some(fn_val),
    fn_ty,
    clone_expr_fresh_ids(call_expr),
    func_expr,
    cloned_args,
    callee_env,
    ctx,
    false,
    true,
    true,
    trial_exn
  );
  ok_out.push(true);
});
/// Build the C-call argument list for a receiver method candidate: prepend the
/// receiver (wrapped in `&(...)` when the method's self param is `*(T)`) for
/// instance methods; static methods take no receiver. Mirrors the all-args
/// construction in the property-access dispatch's `.Some(method_info)` arm and
/// is used to TRIAL each overload candidate. All exprs are cloned so the
/// caller's originals stay intact for the real call.
_build_receiver_call_args :: (
  fn(is_static : bool, needs_ptr_conv : bool, receiver_expr : AstExpr, args : ArrayList(AstExpr)) -> ArrayList(AstExpr)
)({
  all_args := ArrayList(AstExpr).new();
  if(!(is_static), {
    if(needs_ptr_conv, {
      recv_tok := ast_expr_token(receiver_expr);
      amp_atom := AstExpr.Atom(
        alloc_global_expr_id(),
        Token(
          kind : TokenKind.Identifier,
          value : String.from("&"),
          row : recv_tok.row,
          column : recv_tok.column,
          character : recv_tok.character,
          module_path : recv_tok.module_path.clone(),
          input : recv_tok.input.clone()
        )
      );
      amp_args := ArrayList(AstExpr).new();
      amp_args.push(receiver_expr.clone());
      all_args.push(AstExpr.FnCall(alloc_global_expr_id(), amp_atom, amp_args, false, recv_tok));
    }, {
      all_args.push(receiver_expr.clone());
    });
  });
  (ai : usize) = usize(0);
  while(ai < args.len(), {
    match(
      args.get(ai),
      .Some(a) => {
        all_args.push(a.clone());
      },
      .None => ()
    );
    ai = (ai + usize(1));
  });
  all_args
});
/// When a receiver method name has MULTIPLE candidate overloads (e.g. String's
/// inherent `starts_with(prefix : Self)` + the `StrPattern` trait's
/// `starts_with(prefix : str)`), trial-call each (swallowing errors,
/// side-effect-free) and return a result for the FIRST whose parameters match
/// the arguments. Falls back to `base` (the first hit) when none match, so the
/// real call surfaces the genuine error. Mirrors TS overload resolution
/// (function.ts:1691 filters `functionsToCall` to type-matching candidates);
/// yo-self's prior "first hit wins" threw "Cannot unify String and str" on
/// `s.starts_with("-")` because it committed to the inherent `Self`=String hit.
_select_matching_overload :: (
  fn(base : ReceiverMethodResult, args : ArrayList(AstExpr), func_expr : AstExpr, env : Environment, ctx : EvalContext) -> ReceiverMethodResult
)({
  (sel : Option(ReceiverMethodResult)) = Option(ReceiverMethodResult).None;
  (hi : usize) = usize(0);
  while((hi < base.all_hits.len()) && sel.is_none(), {
    match(
      base.all_hits.get(hi),
      .Some(cand) => match(
        cand.value,
        .Some(cv) => {
          trial_args := _build_receiver_call_args(base.is_static, cand.needs_pointer_conversion, base.receiver_expr.clone(), args);
          ok := ArrayList(bool).new();
          _trial_call_overload_candidate(cv, cand.ty, func_expr.clone(), func_expr.clone(), trial_args, env, ctx, ok);
          if(ok.len() > usize(0), {
            sel = Option(ReceiverMethodResult).Some(
              ReceiverMethodResult(
                method_val_opt : cand.value,
                method_ty : cand.ty,
                receiver_expr : base.receiver_expr.clone(),
                is_static : base.is_static,
                needs_pointer_conversion : cand.needs_pointer_conversion,
                all_hits : base.all_hits
              )
            );
          });
        },
        .None => ()
      ),
      .None => ()
    );
    hi = (hi + usize(1));
  });
  match(sel,.Some(s) => s,.None => base)
});
/// ModuleT/Call overload dispatch — mirrors TS `function.ts:527-573` (the
/// `isSourceNamespaceType` candidate expansion) + the checking phase at
/// `:807` and the comptime-param tiebreak at `:1664`. When the callee
/// evaluated to a source-namespace struct value (an `impl({...})` operator
/// module like `(!)`/`(-)`/`(~)`) whose `Call` field holds the overload
/// candidates, trial-call each candidate and OVERWRITE the callee's
/// ExprInfo with the winner (its Func type + FuncVal) — the ordinary
/// FuncVal arm of `evaluate_function_call` then performs the real call,
/// comptime folding included. No-op for non-source-namespace callees.
/// Deviation from TS (documented): when several candidates survive the
/// tiebreak TS throws "Ambiguous call"; yo-self takes the first survivor
/// (the prelude operator modules order the runtime overload first).
_try_expand_call_overload :: (
  fn(
    evaluated_callee : AstExpr,
    call_expr : AstExpr,
    args : ArrayList(AstExpr),
    env : Environment,
    ctx : EvalContext
  ) -> unit
)({
  info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_callee)),
    .Some(i) => i,
    .None => {
      return(());
    }
  );
  // Type side: a source-namespace struct with a `Call` field.
  sns_parts := match(
    info.ty,
    .Struct({ field_labels : s_fls, field_types : s_fts, is_source_namespace : s_sns }) => cond(
      s_sns => Option(usize).Some(usize(0)),
      true => Option(usize).None
    ),
    _ => Option(usize).None
  );
  if(sns_parts.is_none(), {
    return(());
  });
  s_fls := match(info.ty,.Struct({ field_labels : f }) => f, _ => ArrayList(String).new());
  s_fts := match(info.ty,.Struct({ field_types : t }) => t, _ => ArrayList(TypeValue).new());
  (call_idx : Option(usize)) = Option(usize).None;
  (li : usize) = usize(0);
  while((li < s_fls.len()) && call_idx.is_none(), {
    match(
      s_fls.get(li),
      .Some(l) => if(l == "Call", {
        call_idx = Option(usize).Some(li);
      }),
      .None => ()
    );
    li = (li + usize(1));
  });
  ci2 := match(
    call_idx,
    .Some(i) => i,
    .None => {
      return(());
    }
  );
  call_field_ty := match(s_fts.get(ci2),.Some(t) => t,.None => t_unit());
  // Value side: the paired StructVal's `Call` entry (TS reads the type
  // field's `assignedValue`; yo-self's split keeps it on the value).
  call_val := match(
    info.value,
    .Some(v) => match(
      v,
      .StructVal(_, v_names, v_vals) => {
        (vidx : Option(usize)) = Option(usize).None;
        (vi : usize) = usize(0);
        while((vi < v_names.len()) && vidx.is_none(), {
          match(
            v_names.get(vi),
            .Some(n) => if(n == "Call", {
              vidx = Option(usize).Some(vi);
            }),
            .None => ()
          );
          vi = (vi + usize(1));
        });
        match(
          vidx,
          .Some(vix) => match(
            v_vals.get(vix),
            .Some(cv) => Option(EvalValue).Some(cv),
            .None => Option(EvalValue).None
          ),
          .None => Option(EvalValue).None
        )
      },
      _ => Option(EvalValue).None
    ),
    .None => Option(EvalValue).None
  );
  call_v := match(
    call_val,
    .Some(cv) => cv,
    .None => {
      return(());
    }
  );
  // Candidates: a tuple of functions, or a single function
  // (TS function.ts:541-555).
  cand_vals := ArrayList(EvalValue).new();
  match(
    call_v,
    .TupleVal(tfs) => {
      (ti : usize) = usize(0);
      while(ti < tfs.len(), {
        match(
          tfs.get(ti),
          .Some(tv) => {
            cand_vals.push(tv);
          },
          .None => ()
        );
        ti = (ti + usize(1));
      });
    },
    _ => {
      cand_vals.push(call_v);
    }
  );
  cand_tys := ArrayList(TypeValue).new();
  match(
    call_field_ty,
    .Tuple(_, t_tys) => {
      (ty_i : usize) = usize(0);
      while(ty_i < t_tys.len(), {
        match(
          t_tys.get(ty_i),
          .Some(tt) => {
            cand_tys.push(tt);
          },
          .None => ()
        );
        ty_i = (ty_i + usize(1));
      });
    },
    _ => {
      cand_tys.push(call_field_ty);
    }
  );
  if(cand_vals.len() != cand_tys.len(), {
    return(());
  });
  func_expr := match(call_expr,.FnCall(_, fb, _, _, _) => fb, _ => evaluated_callee);
  // Trial each candidate; collect the indices that type-check.
  // The trials run under is_in_function_call_checking_phase so NESTED
  // comptime/macro calls short-circuit to UnknownVal instead of executing
  // (TS function.ts:822-831 sets isInFunctionCallCheckingPhase +
  // skipCtfeExecution on each dry-run). Without this, every trial
  // re-evaluated its cloned arg exprs INCLUDING macro expansion and CTFE —
  // exponential in nested operator-call chains (std/glob.yo never
  // finished). Restored HERE (not inside the helper) because the trial's
  // swallow handler unwinds past the helper's own tail on failure.
  old_checking_ph := ctx.is_in_function_call_checking_phase;
  ctx.is_in_function_call_checking_phase = true;
  successes := ArrayList(usize).new();
  (cand_i : usize) = usize(0);
  while(cand_i < cand_vals.len(), {
    cv2 := match(cand_vals.get(cand_i),.Some(v) => v,.None => EvalValue.UnitVal);
    ct2 := match(cand_tys.get(cand_i),.Some(t) => t,.None => t_unit());
    ok_out := ArrayList(bool).new();
    _trial_call_overload_candidate(cv2, ct2, call_expr, func_expr, args, env, ctx, ok_out);
    if(ok_out.len() > usize(0), {
      successes.push(cand_i);
    });
    cand_i = (cand_i + usize(1));
  });
  ctx.is_in_function_call_checking_phase = old_checking_ph;
  if(successes.len() == usize(0), {
    return(());
  });
  // Tiebreak (TS function.ts:1664-1681): among multiple matches prefer the
  // single candidate with comptime parameter types, if exactly one exists.
  (winner_idx : usize) = match(successes.get(usize(0)),.Some(i) => i,.None => usize(0));
  if(successes.len() > usize(1), {
    comptime_hits := ArrayList(usize).new();
    (si : usize) = usize(0);
    while(si < successes.len(), {
      sidx := match(successes.get(si),.Some(i) => i,.None => usize(0));
      sty := match(cand_tys.get(sidx),.Some(t) => t,.None => t_unit());
      has_ct_param := match(
        sty,
        .Func({ param_types : s_pts }) => {
          (found_ct : bool) = false;
          (pi2 : usize) = usize(0);
          while((pi2 < s_pts.len()) && !(found_ct), {
            pt2 := match(s_pts.get(pi2),.Some(p) => p,.None => t_unit());
            if((is_comptime_int_type(pt2) || is_comptime_float_type(pt2)) || is_comptime_string_type(pt2), {
              found_ct = true;
            });
            pi2 = (pi2 + usize(1));
          });
          found_ct
        },
        _ => false
      );
      if(has_ct_param, {
        comptime_hits.push(sidx);
      });
      si = (si + usize(1));
    });
    if(comptime_hits.len() == usize(1), {
      winner_idx = match(comptime_hits.get(usize(0)),.Some(i) => i,.None => winner_idx);
    });
  });
  winner_val := match(cand_vals.get(winner_idx),.Some(v) => v,.None => EvalValue.UnitVal);
  winner_ty := match(cand_tys.get(winner_idx),.Some(t) => t,.None => t_unit());
  // Overwrite the callee's ExprInfo with the winner so the FuncVal arm of
  // `evaluate_function_call` performs the real call.
  out := new_expr_info(info.env, winner_ty);
  out.value = Option(EvalValue).Some(winner_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(evaluated_callee), out);
});
/// plans/SLICE_REWORK.md Part C — copying range indexing.
/// `recv(a..b)` / `recv(a..=b)` on a RUNTIME receiver that provides
/// slice_copy / slice_copy_inclusive rewrites to that method call
/// (owned-return value semantics; the Index trait's `*(Output)` pointer
/// contract cannot express owned returns). Mirrors TS function.ts's
/// pre-checking-phase rewrite. Returns `.Some(rewritten_call)` — the
/// caller re-enters `evaluate_function_call` on it — or `.None` when the
/// call is not a range index / the receiver has no slice_copy method.
_try_rewrite_range_index_to_slice_copy :: (
  fn(
    expr : AstExpr,
    func_expr : AstExpr,
    args : ArrayList(AstExpr),
    recv_ty : TypeValue,
    env : Environment
  ) -> Option(AstExpr)
)({
  if(args.len() != usize(1), {
    return(Option(AstExpr).None);
  });
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(Option(AstExpr).None);
    }
  );
  is_excl := ast_expr_is_fn_call_of(arg0, "..", Option(usize).Some(usize(2)));
  is_incl := ast_expr_is_fn_call_of(arg0, "..=", Option(usize).Some(usize(2)));
  if(!(is_excl || is_incl), {
    return(Option(AstExpr).None);
  });
  // Function-typed receivers are real calls, not indexing.
  if(is_function_type(recv_ty), {
    return(Option(AstExpr).None);
  });
  method_name := if(is_incl, String.from("slice_copy_inclusive"), String.from("slice_copy"));
  methods := get_receiver_methods_by_name_from_env(env, method_name.clone(), recv_ty, false);
  if(methods.len() == usize(0), {
    return(Option(AstExpr).None);
  });
  tok := ast_expr_token(expr);
  method_atom := AstExpr.Atom(alloc_global_expr_id(), synthetic_token(method_name, env.module_path));
  dot_atom := AstExpr.Atom(alloc_global_expr_id(), synthetic_token(String.from(BF_DOT), env.module_path));
  ma_args := ArrayList(AstExpr).new();
  ma_args.push(func_expr);
  ma_args.push(method_atom);
  method_access := AstExpr.FnCall(alloc_global_expr_id(), dot_atom, ma_args, true, tok);
  new_args := ArrayList(AstExpr).new();
  new_args.push(arg0);
  // Keep the ORIGINAL call id so the result's ExprInfo lands on the same
  // node (TS mutates expr.func in place — same node identity).
  Option(AstExpr).Some(AstExpr.FnCall(ast_expr_id(expr), method_access, new_args, false, tok))
});
/// The SomeType id of a Future type's OUTPUT, unwrapping an `Impl(Future(T,E))`
/// constraint. `io.async`'s return type is `Impl(Future(T, E))`, represented as a
/// `SomeT` whose `required_trait_types` holds the `FutureTraitT` (not a bare
/// `FutureTraitT`), so the output must be reached through that constraint. Returns
/// the output's SomeType id (when the output is itself an unresolved SomeType), or
/// `None`. Used to bridge the async closure's concrete result to the matching
/// `io.await` site without touching the future type — see
/// issues/yo-self-async-await-struct-result-eval.md.
_future_output_some_id :: (fn(t : TypeValue) -> Option(String))(
  match(
    t,
    .FutureTraitT({ output : o }) => match(o,.SomeT({ id : oid }) => Option(String).Some(oid), _ => Option(String).None),
    .SomeT({ required_trait_types : rtts }) => {
      (i : usize) = usize(0);
      (found : Option(String)) = Option(String).None;
      while((i < rtts.len()) && found.is_none(), {
        match(
          rtts.get(i),
          .Some(rt) => match(
            rt,
            .FutureTraitT({ output : o }) => match(
              o,
              .SomeT({ id : oid }) => {
                found = Option(String).Some(oid);
              },
              _ => ()
            ),
            _ => ()
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => Option(String).None
  )
);
/// True if this function type has a regular parameter that is a SomeType
/// wrapping an Fn trait (a closure param, e.g. `cb : Impl(Fn(...), Send)`).
/// Used to NARROW the non-forall specialization trigger: only closure-param
/// soft-generic functions (Thread.spawn / io.async-style) are specialized for
/// codegen so the closure param lowers to its concrete capture struct. Routing
/// EVERY soft-generic function through create_specialized_function_inline
/// (which lacks full effects analysis) crashed `check ./std`.
_func_type_has_closure_param :: (fn(ft : TypeValue) -> bool)(
  match(
    ft,
    .Func({ param_types }) => {
      n := param_types.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < n) && !(found), {
        match(
          param_types.get(i),
          .Some(pt) => if(is_some_type(pt.clone()), {
            match(
              extract_fn_trait_from_type(pt),
              .Some(_) => {
                found = true;
              },
              .None => ()
            );
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
/// arguments, and returning the annotated expression.
///
/// Phase 2bn: handles function definitions (TypeVal callee) and simple FuncVal calls.
/// Complex dispatch (overloads, CTFE, method calls, trait dispatch) deferred to Phase 3.
///
/// Mirrors `evaluateFunctionCall` in `src/evaluator/calls/function.ts`.
/// [Phase-6 frame split] Extracted forall-binding loop of evaluate_function_call's
/// FuncVal arm. Runs during call SETUP (before the recursive CTFE descent), so
/// moving its loop temps into this helper's frame removes them from
/// evaluate_function_call's -O0 frame on the deep recursion path. Fills
/// fa_bound_names/fa_bound_types + binds forall type params into fresh_env. Pure
/// code motion.
_funcval_bind_foralls :: (
  fn(
    forall_names : ArrayList(String),
    param_type_names : ArrayList(String),
    evaled_arg_infos : ArrayList(ExprInfo),
    cap_names : ArrayList(String),
    cap_vals : ArrayList(EvalValue),
    recv_type_args : ArrayList(TypeValue),
    fresh_env : Environment,
    env : Environment,
    n_forall : usize,
    fa_bound_names : ArrayList(String),
    fa_bound_types : ArrayList(TypeValue)
  ) -> unit
)({
  (fa_i : usize) = usize(0);
  while(fa_i < n_forall, {
    fa_name := match(forall_names.get(fa_i),.Some(n) => n,.None => String.from(""));
    n_ptn := param_type_names.len();
    (ptn_i : usize) = usize(0);
    (fa_bound : bool) = false;
    while((ptn_i < n_ptn) && (!(fa_bound)), {
      ptn := match(param_type_names.get(ptn_i),.Some(n) => n,.None => String.from(""));
      if(ptn == fa_name, {
        arg_info := match(
          evaled_arg_infos.get(ptn_i),
          .Some(i) => i,
          .None => new_expr_info(env, t_unit())
        );
        // A forall type param inferred from a comptime_str VALUE argument (a
        // string literal `"hi"` to `fn(forall(T), v : T)`) must bind to the
        // RUNTIME type `str`, not `comptime_str` — else the specialized body
        // dispatches `v.to_string()` against comptime_str (→ comptime_int →
        // i32), throwing "Cannot unify i32 and str" when specializing
        // println/print (Gap-6). A comptime TYPE arg is a `Type` value, not
        // comptime_str, so this only catches string-literal value args.
        fa_infer_ty := cond(
          is_comptime_string_type(arg_info.ty) => TypeValue.Str,
          true => arg_info.ty
        );
        _add_forall := add_variable_to_env(
          fresh_env,
          fa_name,
          TypeValue.TypeUni(usize(0)),
          Option(EvalValue).Some(EvalValue.TypeVal(fa_infer_ty.clone())),
          true,
          false,
          false,
          false,
          synthetic_token(fa_name, env.module_path)
        );
        fa_bound_names.push(fa_name.clone());
        fa_bound_types.push(fa_infer_ty);
        fa_bound = true;
      });
      ptn_i = (ptn_i + usize(1));
    });
    // Fallback: bind the i-th forall param from the receiver's i-th type
    // argument when it could not be inferred from call arguments.
    if(!(fa_bound) && (fa_i < recv_type_args.len()), {
      match(
        recv_type_args.get(fa_i),
        .Some(rta) => {
          fa_bound_names.push(fa_name.clone());
          fa_bound_types.push(rta.clone());
          _add_forall_rt := add_variable_to_env(
            fresh_env,
            fa_name,
            TypeValue.TypeUni(usize(0)),
            Option(EvalValue).Some(EvalValue.TypeVal(rta)),
            true,
            false,
            false,
            false,
            synthetic_token(fa_name, env.module_path)
          );
          fa_bound = true;
        },
        .None => ()
      );
    });
    // Capture fallback (STATIC generic-impl methods, e.g.
    // `ArrayList(u8).new`): no arg binds `T` and the receiver Struct may
    // not carry `type_arguments`, but the generic-impl resolver injected
    // the impl's forall binding (`T = u8`) into this FuncVal's CAPTURES
    // (`_inject_forall_captures`, appended at the tail). Bind `T` from that
    // capture so the body / specialization concretize.
    if(!(fa_bound), {
      (fcap_i : usize) = usize(0);
      while((fcap_i < cap_names.len()) && !(fa_bound), {
        if(match(cap_names.get(fcap_i),.Some(cn) => (cn == fa_name),.None => false), {
          match(
            cap_vals.get(fcap_i),
            .Some(cvv) => match(
              cvv,
              .TypeVal(ctb) => {
                cap_ty := ctb;
                fa_bound_names.push(fa_name.clone());
                fa_bound_types.push(cap_ty.clone());
                _add_forall_cap := add_variable_to_env(
                  fresh_env,
                  fa_name,
                  TypeValue.TypeUni(usize(0)),
                  Option(EvalValue).Some(EvalValue.TypeVal(cap_ty)),
                  true,
                  false,
                  false,
                  false,
                  synthetic_token(fa_name, env.module_path)
                );
                fa_bound = true;
              },
              _ => ()
            ),
            .None => ()
          );
        });
        fcap_i = (fcap_i + usize(1));
      });
    });
    fa_i = (fa_i + usize(1));
  });
});
/// [Phase-6 frame-size split] Extracted runtime-return branch of the FuncVal arm of
/// `evaluate_function_call`. Pulling this ~200-line block (incl. the 16-field Func
/// destructuring) out of `evaluate_function_call` removes its many -O0 stack slots
/// from that function's frame, shrinking the per-level frame on the deep CTFE
/// recursion path (Phase-6 stage-2 self-compile overflow). Pure code motion — same
/// behavior. Returns the call expr.
_evaluate_funcval_runtime_call :: (
  fn(
    expr : AstExpr,
    func_expr : AstExpr,
    env : Environment,
    fresh_env : Environment,
    ctx : EvalContext,
    ret_type : TypeValue,
    callee_func_type_opt : Option(TypeValue),
    cv : EvalValue,
    func_id_fv : String,
    forall_names : ArrayList(String),
    fa_bound_names : ArrayList(String),
    fa_bound_types : ArrayList(TypeValue),
    runtime_arg_exprs : ArrayList(AstExpr),
    evaled_arg_infos : ArrayList(ExprInfo),
    n_supplied_reg : usize,
    param_vars : ArrayList(Variable),
    exn : Exception
  ) -> AstExpr
)({
  // Resolve forall SomeTs in the declared return type using the
  // forall bindings just inferred from the call arguments — keyed
  // by NAME against the SomeT occurrences in the return type, each
  // with ITS OWN recorded frame level. (The levels are the callee's
  // definition-site levels, which a fresh call env cannot confirm,
  // so the env-lookup resolver returns them unresolved; TS instead
  // re-evaluates the return type EXPRESSION in the callee env,
  // helper.ts:1282 — a plain name lookup.) E.g. `(bit_not) ::
  // (fn(forall(_Self), self : _Self, ...) -> _Self)` called with
  // `self : u32` must return u32, not the abstract `_Self` SomeT.
  (resolved_ret : TypeValue) = ret_type;
  if(fa_bound_names.len() > usize(0), {
    ret_somes := get_all_some_types(ret_type);
    if(ret_somes.len() > usize(0), {
      s_ret := subst_new();
      (s_ret_any : bool) = false;
      (rsi : usize) = usize(0);
      while(rsi < ret_somes.len(), {
        rst := match(ret_somes.get(rsi),.Some(t) => t,.None => t_unit());
        match(
          rst,
          .SomeT(_, rst_name, rst_lvl, _, _, _, _, _, _, _) => {
            (bni : usize) = usize(0);
            while(bni < fa_bound_names.len(), {
              bn := match(fa_bound_names.get(bni),.Some(x) => x,.None => String.from(""));
              if(bn == rst_name, {
                bt := match(fa_bound_types.get(bni),.Some(t) => t,.None => t_unit());
                subst_add(s_ret, rst_name.clone(), rst_lvl, bt);
                s_ret_any = true;
              });
              bni = (bni + usize(1));
            });
          },
          _ => ()
        );
        rsi = (rsi + usize(1));
      });
      if(s_ret_any, {
        resolved_ret = substitute(s_ret, ret_type);
      });
    });
  });
  // Then resolve any REMAINING SomeTs from the callee env — an
  // instantiation method's type params (ArrayList(JsonValue)'s
  // `T` in `get`'s `?(T)`) are bound as CAPTURES, not foralls;
  // without this the unresolved `T` was later looked up by NAME
  // in whatever env was current and picked up stale bindings
  // (a double-wrapped `Option(Option(JsonValue))` in
  // std/encoding/json.yo's `at`). Mirrors TS's Step 9
  // `evaluateFunctionReturnTypeAgain(returnType, calleeEnv)` —
  // already ported on the helper.yo path (helper.yo:1811); this
  // inline FuncVal arm is yo-self's second call path and needs
  // the same resolution.
  resolved_ret = evaluate_function_return_type_again(resolved_ret, fresh_env, ctx);
  out_rt := new_expr_info(env, resolved_ret);
  out_rt.value = Option(EvalValue).Some(_call_result_unknown(resolved_ret, env));
  // Runtime arg exprs for codegen (this is the runtime-call / no-CTFE
  // path — the body is NOT executed, so it returns before the 2341 site).
  out_rt.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_arg_exprs);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_rt);
  // Assign a temp variable name to the (non-unit) call result so codegen
  // can materialize it as `<cty> <tmp> = call(...)`. Mirrors TS
  // function.ts:2263 attachTempVariableToExpr(expr, true, ...).
  attach_temp_variable_to_expr(expr, true, ctx);
  param_vars;
  // Generic-function SPECIALIZATION for codegen (Gap 6). The runtime-
  // return path doesn't execute the body, leaving the callee's ExprInfo
  // as the GENERIC FuncVal (its `forall(T) v:T` type crashes
  // get_type_string). For a generic callee, produce a monomorphized
  // FuncVal (specialized func_id + forall-free registered type, see
  // helper.yo) and record it (value + type) on the callee node so
  // codegen collects/emits the SPECIALIZED instance. (Method-chain
  // generics like println still hit the upstream soft-fallback-to-unit
  // inside create_specialized — that's the deeper Gap-6 evaluator work;
  // simple generic bodies specialize cleanly.) Mirrors TS recording the
  // specialized FunctionValue on `call.func.$.value`.
  // Specialize for codegen when the callee is generic. Forall functions
  // always specialize; additionally — mirroring TS's specialization guard
  // (`isFunctionTypeGeneric(functionType) && !functionValue.isControlFunction`,
  // helper.ts:1911-1929) — a NON-forall soft-generic function (one with a
  // SomeType param, e.g. a closure param `cb : Impl(Fn(...))`) also
  // specializes so its concrete arg types lower into the specialized C
  // function (e.g. Thread.spawn's `cb` → its capture struct). Control
  // (ctl/effect-handler) functions are excluded — the effect system handles
  // them.
  ou_spec_soft_generic := match(callee_func_type_opt,.Some(spec_ft) => ((is_function_type_generic(spec_ft) && !(is_control_fn(func_id_fv.clone()))) && _func_type_has_closure_param(spec_ft)),.None => false);
  if((forall_names.len() > usize(0)) || ou_spec_soft_generic, {
    // Bind `Self` to the concrete static dot-receiver around the
    // specialization so a STATIC generic-impl method's body (e.g.
    // `ArrayList(u8).new`'s `Self(...)` construction) re-evaluates with
    // `Self` concrete. The forall type params (`T`) are bound into
    // `fresh_env` by the capture fallback in the forall-binding loop
    // above; `Self` is the remaining piece for static methods (instance
    // methods get it from the concrete `self` arg). Restored after spec.
    spec_self_saved := ctx.self_type;
    match(
      _static_dot_receiver_self_type(func_expr, ctx),
      .Some(spec_st) => {
        // A static method whose declared return is `Self` (a SomeT) leaves
        // resolved_ret as that unresolved SomeT — which makes codegen's
        // should_skip_function_codegen drop the specialized method as
        // "has_generic_return" (declarations.yo skip2), so e.g. the
        // specialized `Thread.spawn -> Self` would never be emitted.
        // Resolve `Self` to the concrete static-dot receiver here (the
        // body constructs that concrete type). Gated to a SomeT return so
        // concrete returns are untouched.
        if(is_some_type(resolved_ret), {
          resolved_ret = spec_st.clone();
        });
        ctx.self_type = Option(TypeValue).Some(spec_st);
      },
      .None => ()
    );
    spec_ct := match(callee_func_type_opt,.Some(t) => t,.None => t_unit());
    spec_forall_args := ArrayList(ArgEntry).new();
    (sfa_i : usize) = usize(0);
    while(sfa_i < fa_bound_names.len(), {
      fbt := match(fa_bound_types.get(sfa_i),.Some(t) => t,.None => t_unit());
      _sfa := spec_forall_args.push(
        ArgEntry(
          value : Option(EvalValue).Some(EvalValue.TypeVal(fbt.clone())),
          parameter_type : TypeValue.TypeUni(usize(0)),
          arg_type : fbt
        )
      );
      sfa_i = (sfa_i + usize(1));
    });
    spec_reg_args := ArrayList(ArgEntry).new();
    (sra_i : usize) = usize(0);
    while(sra_i < n_supplied_reg, {
      ainfo := match(evaled_arg_infos.get(sra_i),.Some(i) => i,.None => new_expr_info(env, t_unit()));
      // For a closure arg, the evaluator records the concrete capture
      // struct on ExprInfo.capture_type (anonymous_function.yo:1052) while
      // ExprInfo.ty stays the Fn-trait type. Use the capture struct as the
      // specialization arg_type so the closure param (`cb : Impl(Fn(...),
      // Send)`) lowers to its concrete capture struct in the specialized C
      // function — the same concretion TS achieves via the SomeType's
      // resolvedConcreteType (helper.ts:2245-2252).
      arg_ty_spec := match(ainfo.capture_type,.Some(ct) => ct,.None => ainfo.ty);
      _sra := spec_reg_args.push(
        ArgEntry(value : ainfo.value, parameter_type : ainfo.ty, arg_type : arg_ty_spec)
      );
      sra_i = (sra_i + usize(1));
    });
    spec_av := ArgValues(
      forall_args : spec_forall_args,
      args : spec_reg_args,
      implicit_args : Option(ArrayList(ArgEntry)).None,
      variadic_args : ArrayList(VarArgEntry).new()
    );
    spec_fv := create_specialized_function_inline(cv, spec_ct, spec_av, fresh_env, env, ctx, exn);
    spec_fid := match(spec_fv,.FuncVal(__fvd1, _) => __fvd1.*.func_id, _ => String.from(""));
    // helper.yo's create_specialized registers the specialized type but
    // resolves its RETURN type via evaluate_function_return_type_again,
    // which does NOT resolve a forall-result SomeT (frame-level mismatch)
    // — e.g. `fn(a,b:T)->T` specialized to i32 args registers
    // `fn(a:i32,b:i32)->T` (result still `T`). This arm already computed
    // the concrete return (`resolved_ret`, via explicit forall subst), so
    // re-register the specialized type with the result corrected.
    base_spec_ty := get_func_type(spec_fid);
    spec_ty_fixed := match(
      base_spec_ty,
      .Func({
        forall_types : fx_ft,
        param_types : fx_pt,
        implicit_types : fx_it,
        where_types : fx_wt,
        meta : fx_meta
      }) => TypeValue.Func(
        fx_ft,
        fx_pt,
        fx_it,
        fx_wt,
        resolved_ret.clone(),
        fx_meta
      ),
      _ => base_spec_ty
    );
    register_func_type(spec_fid.clone(), spec_ty_fixed);
    spec_callee_info := new_expr_info(env, spec_ty_fixed);
    spec_callee_info.value = Option(EvalValue).Some(spec_fv);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(func_expr), spec_callee_info);
    ctx.self_type = spec_self_saved;
  });
  expr
});
/// Evaluate an operator's 2nd operand under a capture-free swallow `Exception`
/// to read its type for overload selection, WITHOUT aborting the caller on
/// failure. The selection eval clears the expected type to read the operand's
/// natural type; a `.Variant`-shorthand operand then cannot resolve (no expected
/// enum) and throws — here that error is swallowed and `out` stays empty, so the
/// caller falls back to the first overload (the `->` handler is capture-free, so
/// it unwinds `()` and the result rides out via `out`, like `_trial_eval_fn_body`).
_try_eval_operand_type :: (
  fn(arg : AstExpr, env : Environment, ctx : EvalContext, out : ArrayList(TypeValue)) -> unit
)({
  oe_exn := Exception(throw : ((_e) -> unwind(())));
  oe_evaled := evaluate_expression_raw(arg, env, ctx, oe_exn);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(oe_evaled)),
    .Some(si) => {
      out.push(si.ty);
    },
    .None => ()
  );
});
evaluate_function_call :: (
  fn(
    expr : AstExpr,
    env : Environment,
    given_type : TypeValue,
    given_value : Option(EvalValue),
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  given_type;
  tok := ast_expr_token(expr);
  // Decompose the call: func_expr = callee, args = argument list.
  func_expr := match(
    expr,
    .FnCall(_, func_box, _, _, _) => func_box,
    .Atom(_, _) => make_err_expr()
  );
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  // Pre-fold `-(IntLit)` to a comptime negative integer literal.
  // yo-self does not yet implement full ModuleT/Call overload dispatch
  // for the prelude's `(-) :: impl({ Call :: (neg, comptime_neg); })`,
  // so unary-minus on a comptime int falls into a soft fallback that
  // produces UnknownVal. The TS evaluator effectively folds the same
  // shape via `ComptimeNegate.neg`. We mirror the fold here, just for
  // the literal-arg form, so that prelude patterns like
  // `Completed = -(1)` in enum discriminants and similar default-value
  // sites evaluate as comptime_int.
  neg_callee_str := match(
    func_expr,
    .Atom(_, ftok) => ftok.value,
    _ => String.new()
  );
  is_neg_call :=
    ((neg_callee_str == "-") && (args.len() == usize(1)));
  if(is_neg_call, {
    arg0 := match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    match(
      arg0,
      .Atom(_, atok) => {
        if(atok.kind == TokenKind.Integer, {
          neg_raw := `-${atok.value}`;
          out_neg := new_expr_info(env, t_comptime_int());
          out_neg.value = Option(EvalValue).Some(EvalValue.IntLit(neg_raw));
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_neg);
          return(expr);
        });
      },
      _ => ()
    );
  });
  // ------------------------------------------------------------------
  // Infix comparison operator → trait-method dispatch.
  //
  // Mirrors TS `function.ts:452` (`stringIsOperator(functionName) &&
  // expr.isInfix`). An infix operator resolves to a trait method on the
  // receiver (lhs) type via the registry. Use the lexer's
  // `string_is_operator` predicate (port of `stringIsOperator`) — NOT a
  // hardcoded operator list.
  //
  // Route ALWAYS — TS has no operand gating (`function.ts:452`). An earlier
  // bootstrap gate routed arithmetic/bitwise operators (associated-type
  // returns like `comptime(Self.Output)`) only for concrete COMPTIME first
  // operands, because dispatch on runtime/unknown operands looped — a
  // symptom of the since-fixed generic-impl method-type specialization and
  // type-only-call unification gaps. With those fixed, an unknown operand
  // resolves the operator method normally and the extern builtin call
  // returns a typed UnknownVal (e.g. `char_index + usize(1)` under def-eval
  // → UnknownVal(usize), not the `unit` soft-fallthrough that poisoned every
  // downstream binding).
  // ------------------------------------------------------------------
  is_infix_call := match(expr,.FnCall(_, _, _, inf, _) => inf,.Atom(_, _) => false);
  op_name := match(func_expr,.Atom(_, ftok) => ftok.value, _ => String.new());
  op_is_operator := string_is_operator(op_name.clone());
  if((is_infix_call && op_is_operator) && (args.len() >= usize(1)), {
    first_arg := match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    // Evaluate the first operand with `expected_type` cleared — the
    // operand type must come from the operand itself, not from the
    // bool/etc. type the outer context expects of the operator result.
    saved_et := ctx.expected_type;
    ctx.expected_type = Option(ExpectedTypeCtx).None;
    evaluated_first := evaluate_expression_raw(first_arg, env, ctx, exn);
    ctx.expected_type = saved_et;
    first_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_first));
    receiver_ty := match(first_info_opt,.Some(ri) => ri.ty,.None => t_unit());
    // is_infix_operator_call = true: infix operators don't allow auto
    // pointer conversion of the receiver.
    op_methods := get_receiver_methods_by_name_from_env(env, op_name.clone(), receiver_ty, true);
    if(op_methods.len() > usize(0), {
      first_m_0 := match(
        op_methods.get(usize(0)),
        .Some(m) => m,
        .None => return(expr)
      );
      // Operator OVERLOAD selection. A receiver can carry multiple overloads of
      // the same operator — e.g. `String` implements both `Eq(String)` (rhs:
      // String) and `Eq(str)` (rhs: str), so `v == "->"` must pick the `str`
      // overload. yo-self previously always took index 0 and failed to unify the
      // `str` argument against the `String` parameter ("Cannot unify String and
      // str"). When there is more than one candidate, evaluate the 2nd operand
      // and pick the overload whose 2nd parameter (`rhs`) type accepts that
      // operand's type. Mirrors TS trying each overload and using the matching
      // one (function.ts:867+). A single candidate keeps index 0 (no behavior
      // change).
      (chosen_idx : usize) = usize(0);
      if((op_methods.len() > usize(1)) && (args.len() >= usize(2)), {
        snd_arg := match(args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
        snd_saved := ctx.expected_type;
        ctx.expected_type = Option(ExpectedTypeCtx).None;
        snd_ty_holder := ArrayList(TypeValue).new();
        _try_eval_operand_type(snd_arg, env, ctx, snd_ty_holder);
        ctx.expected_type = snd_saved;
        // Only refine when the 2nd operand evaluated to a concrete type; a
        // shorthand operand left `snd_ty_holder` empty → keep the first overload.
        match(
          snd_ty_holder.get(usize(0)),
          .Some(snd_ty) => {
            (osi : usize) = usize(0);
            (osel : bool) = false;
            while((osi < op_methods.len()) && !(osel), {
              ocand := match(op_methods.get(osi),.Some(m) => m,.None => first_m_0);
              ocand_p1 := match(
                ocand.ty,
                .Func({ param_types : ocpt }) => match(ocpt.get(usize(1)),.Some(t) => t,.None => t_unit()),
                _ => t_unit()
              );
              if(are_types_compatible(snd_ty, ocand_p1), {
                chosen_idx = osi;
                osel = true;
              });
              osi = (osi + usize(1));
            });
          },
          .None => ()
        );
      });
      first_m := match(
        op_methods.get(chosen_idx),
        .Some(m) => m,
        .None => first_m_0
      );
      // Classify by the method's return shape: an associated-type return
      // (contains a SomeT, e.g. `comptime(Self.Output)`) marks arithmetic;
      // a SomeT-free return (e.g. `bool`) marks comparison.
      m_ret_op := match(first_m.ty,.Func({ result : _rb }) => _rb, _ => t_unit());
      op_ret_has_some := (get_all_some_types(m_ret_op).len() > usize(0));
      // Associated-type return pre-hint: `try_to_call_function_with_arguments`
      // validates the return type and throws "Failed to infer the function
      // call return type" when an `Output` SomeT isn't bound in the call env
      // (e.g. a module-level comptime arithmetic use where no outer expected
      // type supplies it). Hint with the receiver type so the call's
      // synthesize step binds `Self`/`Output` before validation (numeric
      // arithmetic traits all set `Output = Self`).
      saved_op_et := ctx.expected_type;
      if(op_ret_has_some && ctx.expected_type.is_none(), {
        ctx.expected_type = Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : receiver_ty, env : env));
      });
      call_result_op := try_to_call_function_with_arguments(
        first_m.value,
        first_m.ty,
        expr,
        func_expr,
        args,
        env,
        ctx,
        true,
        false,
        false,
        exn
      );
      ctx.expected_type = saved_op_et;
      // Resolve an associated-type return (`comptime(Self.Output)`) that came
      // back as a bare SomeT (`Output`) because the impl's associated-type
      // binding isn't in the callee env. TS resolves it by the receiver's
      // trait impl matching the operator's trait id (env.ts:1970). yo-self's
      // registry records `source_trait_id` as "" for direct-on-type trait
      // impls, so we approximate SOUNDLY: adopt the receiver's registered
      // associated types of this name only when they UNANIMOUSLY agree (they
      // do for every numeric type — all of `usize`'s `Output` entries are
      // `usize`). Diverging → leave unresolved (no wrong resolution).
      resolved_ret := call_result_op.return_type;
      if(is_some_type(resolved_ret), {
        assoc_nm := match(resolved_ret,.SomeT(name : nm) => nm, _ => String.new());
        recv_id := type_id_or_empty(receiver_ty);
        if((assoc_nm.len() > usize(0)) && (recv_id.len() > usize(0)), {
          assoc_entries := get_type_trait_methods_by_name(recv_id, assoc_nm);
          (agreed : Option(TypeValue)) = Option(TypeValue).None;
          (diverged : bool) = false;
          (ai : usize) = usize(0);
          while((ai < assoc_entries.len()) && !(diverged), {
            match(
              assoc_entries.get(ai),
              .Some(ae) => match(
                ae.value,
                .Some(av) => match(
                  av,
                  .TypeVal(tb) => {
                    cand_ty := tb;
                    match(
                      agreed,
                      .None => {
                        agreed = Option(TypeValue).Some(cand_ty);
                      },
                      .Some(prev) => {
                        if(type_to_string(prev) != type_to_string(cand_ty), {
                          diverged = true;
                        });
                      }
                    );
                  },
                  _ => ()
                ),
                .None => ()
              ),
              .None => ()
            );
            ai = (ai + usize(1));
          });
          if(!(diverged), {
            match(
              agreed,
              .Some(a) => {
                resolved_ret = a;
              },
              .None => ()
            );
          });
        });
      });
      // CTFE-execute comptime-returning operators (e.g. ComptimeSub(usize)'s
      // `(-)`, `__yo_comptime_usize_sub`). Like the `.method()` arm, the
      // operator dispatch resolves only the return TYPE via `try_to_call`
      // and otherwise fabricates an UnknownVal — fine for runtime operators,
      // but a comptime operator needs its concrete VALUE (e.g. `n - usize(1)`
      // in `__yo_comptime_fold_range` must fold to a concrete index, else
      // `list.get(idx)` indexes with an unknown). Build a fresh env binding
      // the operator method's captures + params to the CONCRETE arg values,
      // then route through `evaluate_comptime_fn_call`.
      // Prefer a comptime-returning operator method when one exists. A type
      // like `usize` has BOTH `Sub` (runtime) and `ComptimeSub` (comptime);
      // `get_receiver_methods_by_name_from_env` returns them in registration
      // order and the runtime one often comes first. yo-self can't tell the
      // operands are comptime from the receiver TYPE alone (both are `usize`),
      // so select the comptime impl and let `evaluate_comptime_fn_call` fold
      // when the operand VALUES are concrete (and return unknown when not —
      // safe for runtime operands). Without this, `n - usize(1)` in
      // `__yo_comptime_fold_range` never folded → unknown index → OOB.
      (op_comptime_m : Option(MethodEntry)) = Option(MethodEntry).None;
      {
        (ocm_i : usize) = usize(0);
        while((ocm_i < op_methods.len()) && op_comptime_m.is_none(), {
          match(
            op_methods.get(ocm_i),
            .Some(ocm) => if(match(ocm.ty,.Func({ meta : __fm1 }) => __fm1.*.result_is_comptime_only, _ => false), {
              op_comptime_m = Option(MethodEntry).Some(ocm);
            }),
            .None => ()
          );
          ocm_i = (ocm_i + usize(1));
        });
      };
      op_eff_m := match(op_comptime_m,.Some(m) => m,.None => first_m);
      op_is_comptime := match(op_eff_m.ty,.Func({ meta : __fm2 }) => __fm2.*.result_is_comptime_only, _ => false);
      // Only FOLD the operator at comptime when EVERY operand is a concrete
      // value (present and not an `UnknownVal`). With a runtime-unknown operand
      // (e.g. `idx < len` inside a runtime-return method body being evaluated at
      // definition time, where the receiver is unknown), folding is impossible:
      // `evaluate_comptime_fn_call`'s arg-collect step would throw "Failed to
      // call the function for compile-time" on the `.None`/unknown operand. The
      // surrounding comment promises "return unknown when [operands] not
      // concrete — safe for runtime operands"; this gate realises that promise
      // by yielding an `UnknownVal(resolved_ret)` directly instead of routing.
      op_operands_concrete := {
        (all_conc : bool) = true;
        (oac_i : usize) = usize(0);
        oac_n := call_result_op.arg_values.args.len();
        while((oac_i < oac_n) && all_conc, {
          match(
            call_result_op.arg_values.args.get(oac_i),
            .Some(ae) => match(
              ae.value,
              .Some(v) => if(is_unknown_val(v), {
                all_conc = false;
              }),
              .None => {
                all_conc = false;
              }
            ),
            .None => {
              all_conc = false;
            }
          );
          oac_i = (oac_i + usize(1));
        });
        all_conc
      };
      (op_result_val : Option(EvalValue)) = if((is_type_hierarchy_type(resolved_ret) || op_is_comptime) && op_operands_concrete, {
        op_fv := match(op_eff_m.value,.Some(v) => v,.None => EvalValue.UnitVal);
        op_env := Environment.new(call_result_op.callee_env.module_path);
        match(
          op_fv,
          .FuncVal(__fvm4, op_cvals) => {
            op_pnames := __fvm4.*.params;
            op_cnames := __fvm4.*.cap_names;
            op_ctys := __fvm4.*.cap_tys;
            (oci : usize) = usize(0);
            while(oci < op_cnames.len(), {
              ocn := match(op_cnames.get(oci),.Some(n) => n,.None => String.from(""));
              oct := match(op_ctys.get(oci),.Some(t) => t,.None => t_unit());
              ocv := match(op_cvals.get(oci),.Some(v) => Option(EvalValue).Some(v),.None => Option(EvalValue).None);
              _oac := add_variable_to_env(op_env, ocn, oct, ocv, match(ocv,.Some(_) => true,.None => false), false, false, false, synthetic_token(ocn, op_env.module_path));
              oci = (oci + usize(1));
            });
            _ofr := op_env.push_frame(false);
            (opi : usize) = usize(0);
            while(opi < op_pnames.len(), {
              opn := match(op_pnames.get(opi),.Some(n) => n,.None => String.from(""));
              oa := match(call_result_op.arg_values.args.get(opi),.Some(e) => e,.None => ArgEntry(value : Option(EvalValue).None, parameter_type : t_unit(), arg_type : t_unit()));
              _oap := add_variable_to_env(op_env, opn, oa.arg_type, oa.value, match(oa.value,.Some(_) => true,.None => false), false, false, false, synthetic_token(opn, op_env.module_path));
              opi = (opi + usize(1));
            });
          },
          _ => ()
        );
        op_ctfe := evaluate_comptime_fn_call(
          Option(AstExpr).Some(func_expr),
          op_eff_m.ty,
          op_fv,
          call_result_op.arg_values,
          call_result_op.caller_env,
          op_env,
          ctx,
          exn
        );
        Option(EvalValue).Some(op_ctfe.value)
      }, Option(EvalValue).Some(_call_result_unknown(resolved_ret, env)));
      out_op := new_expr_info(call_result_op.caller_env, resolved_ret);
      out_op.value = op_result_val;
      out_op.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(call_result_op.runtime_arg_exprs_in_order);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_op);
      // RUNTIME operator on a non-primitive type (e.g. derived `==`/`<` on an
      // enum or struct): the result is an `UnknownVal`, so codegen must emit a
      // CALL to the resolved operator method. Two things the comptime-folded
      // path never needed, gated to the runtime case so comptime operators are
      // completely unaffected (codegen takes the concrete-value short-cut on the
      // whole-expr ExprInfo before reaching either of these):
      //   (1) Attach a result temp to the whole-expr ExprInfo. Without it,
      //       codegen has no variable to assign the non-unit call result to →
      //       "// Error: function call returns non-unit but no temp variable
      //       assigned". The FuncVal arm (function.yo:945) and the `.method()`
      //       arm (function.yo:2856) both call this; the operator block omitted it.
      //   (2) Stamp the resolved operator-method FuncVal onto the CALLEE node
      //       (`func_expr`, the `==` atom). TS funnels infix operators through
      //       the common call path, which sets `expr.func.$.value = functionValue`;
      //       yo-self's operator block is a separate early-return that never
      //       evaluates the callee (an identifier lookup on `==` would throw), so
      //       the callee node carries NO ExprInfo. Codegen collection
      //       (functions/collection.yo callee-FuncVal walk) and dispatch
      //       (other_fn_call.yo `get_expr_info(func_expr)`) BOTH read it to emit +
      //       call the function; without the stamp the method is neither
      //       generated nor dispatched → "// Failed to transpile". Prefer the
      //       specialized (monomorphized) FuncVal; fall back to the resolved one.
      op_result_is_runtime := match(op_result_val,.Some(orv) => is_unknown_val(orv),.None => false);
      if(op_result_is_runtime, {
        attach_temp_variable_to_expr(expr, true, ctx);
        op_callee_fv := match(call_result_op.specialized_function_value,.Some(sfv) => Option(EvalValue).Some(sfv),.None => first_m.value);
        match(
          op_callee_fv,
          .Some(_) => {
            op_callee_info := new_expr_info(call_result_op.callee_env, first_m.ty);
            op_callee_info.value = op_callee_fv;
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(func_expr), op_callee_info);
          },
          .None => ()
        );
      });
      return(expr);
    });
  });
  // Evaluate the callee. Clear the ambient expected type UNLESS the callee
  // is a property access (function.ts:252-260: enum-variant constructors
  // like `.Some(x)` need expectedType to infer their enum; everything else
  // must NOT see the call's expected type — a call-result callee like
  // `zs.as_bytes()` in `f(zs.as_bytes()(0))` otherwise synthesizes its
  // declared return against the OUTER expected, e.g.
  // unify(ArrayList(u8), u8)).
  callee_is_dot := ast_expr_is_fn_call_of(func_expr, ".", Option(usize).None);
  callee_saved_expected := ctx.expected_type;
  if(!(callee_is_dot), {
    ctx.expected_type = Option(ExpectedTypeCtx).None;
  });
  // When the caller supplies the function value directly (`given_value`,
  // e.g. `recur(...)` passes the enclosing function's value via
  // `evaluate_recur`), use it as the callee instead of evaluating
  // `func_expr` — the callee atom (`recur`) is not a bound variable and an
  // identifier lookup would throw "Variable recur not found". Mirrors TS
  // `evaluateFunctionCall`'s `givenFunc` shortcut (function.ts:234-237).
  evaluated_callee := match(
    given_value,
    .Some(gv) => {
      gc_info := new_expr_info(env, given_type);
      gc_info.value = Option(EvalValue).Some(gv);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(func_expr), gc_info);
      func_expr
    },
    .None => evaluate_expression_raw(func_expr, env, ctx, exn)
  );
  ctx.expected_type = callee_saved_expected;
  // Call-overload expansion: when the callee is a source-namespace struct
  // (an `impl({...})` operator module), select the winning `Call` candidate
  // and overwrite the callee's ExprInfo so the FuncVal arm below performs
  // the real call. No-op otherwise. See `_try_expand_call_overload`.
  _try_expand_call_overload(evaluated_callee, expr, args, env, ctx);
  callee_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_callee));
  callee_value_raw := match(
    callee_info_opt,
    .Some(ci) => ci.value,
    .None => Option(EvalValue).None
  );
  // Resolve a recursive-type-reference placeholder before dispatch. When the
  // callee evaluated to a `SomeT` recursion placeholder (created by
  // `evaluate_comptime_fn_call` for a self-referential type constructor),
  // resolve it to the actual struct/enum type via the comptime-fn cache so the
  // call dispatches as a real type constructor. Mirrors TS
  // `function.ts:929-945`. `resolve_recursive_type_ref` returns `.None` for any
  // non-placeholder TypeVal, so this is a no-op for ordinary callees.
  callee_value := match(
    callee_value_raw,
    .Some(cv) => match(
      cv,
      .TypeVal(tb) => match(
        resolve_recursive_type_ref(tb, ctx),
        .Some(rt) => Option(EvalValue).Some(EvalValue.TypeVal(rt)),
        .None => callee_value_raw
      ),
      _ => callee_value_raw
    ),
    .None => Option(EvalValue).None
  );
  callee_env := match(
    callee_info_opt,
    .Some(ci) => ci.env,
    .None => env
  );
  // plans/EXTERN_UNSAFE_WRAP.md Phase A — extern "c" call-site gate.
  //
  // A call to a function declared `extern "c"` (via `extern(...)` or
  // `c_include(...)`) must be wrapped in `unsafe(...)` at the call site,
  // even in files declaring `pragma(Pragma.AllowUnsafe);`. The pragma
  // authorizes DECLARING the FFI symbol; this gate is the per-call audit
  // marker so a UB-capable line can be pinpointed. Mirrors
  // `src/evaluator/calls/function.ts:1786-1832`.
  //
  // Exemptions: the call is lexically inside an `unsafe(...)` wrapper
  // (`ctx.unsafe_context`, set by `evaluate_unsafe`), or the call lives in
  // an auto-generated (macro/derive) expansion, which inherits privilege
  // from its user-facing trigger site.
  //
  // The callee's TYPE carries the FFI marker (extern symbols bind as an
  // `UnknownVal` of the extern `Func` type, not a `FuncVal`), so the gate
  // reads `callee_info_opt.ty`, not the value. The migration-helper dump
  // mode (TS Phase C, `YO_EXTERN_WRAP_DUMP_FILE`) is intentionally omitted
  // — it is a one-time TS-side migration aid, not part of the gate.
  callee_ty_for_gate := match(callee_info_opt,.Some(ci) => ci.ty,.None => t_unit());
  gate_is_extern_c := match(
    callee_ty_for_gate,
    .Func({ meta : __fm3 }) => match(__fm3.*.is_extern,.Some(lang) => (lang == "c"),.None => false),
    _ => false
  );
  gate_in_autogen := is_auto_generated_expansion(Option(String).Some(tok.module_path.clone()));
  if((gate_is_extern_c && !(ctx.unsafe_context)) && !(gate_in_autogen), {
    callee_name := match(
      callee_ty_for_gate,
      .Func({ meta : __fm4 }) => match(__fm4.*.extern_name,.Some(n) => n,.None => ast_expr_to_string(func_expr)),
      _ => ast_expr_to_string(func_expr)
    );
    exn.throw(
      dyn(
        format_error_message(
          tok,
          `Call to extern "c" function '${callee_name}' must be wrapped in 'unsafe(...)' to mark the call site as audit-capable.

C functions are outside Yo's type-checking reach — wrong argument types, contract violations, or aliasing assumptions produce undefined behavior. Wrapping each call site lets 'yo unsafe-report' flag exactly where the UB-capable operations live, instead of just noting that the whole file is privileged.

Fix: wrap the call:

  unsafe(${ast_expr_to_string(expr)})`,
          false,
          .None
        )
      )
    );
  });
  match(
    callee_value,
    // ------------------------------------------------------------------
    // Path 1: callee is TypeVal(Func) → function definition expression.
    //   `(fn(params) -> T)(body)`
    // ------------------------------------------------------------------
    .Some(cv) => match(
      cv,
      .TypeVal(func_type_box) => {
        func_type := func_type_box;
        match(
          func_type,
          .Func({ result : _ }) => {
            if(args.len() != usize(1), {
              exn.throw(
                dyn(
                  format_error_message(
                    tok,
                    `Expected 1 body argument for function definition, got ${args.len()}`,
                    false,
                    .None
                  )
                )
              );
            });
            try_to_implement_function_by_function_type(expr, func_type, callee_env, ctx, exn)
          },
          // FnTraitT (Fn(A, B) -> C as a type) — try closure creation.
          .FnTraitT(_, _, _, _, _, _, _) => {
            result_opt := try_to_implement_closure_by_fn_module_type(
              expr,
              func_type,
              func_type,
              callee_env,
              ctx,
              exn
            );
            match(
              result_opt,
              .Some(e) => e,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      tok,
                      String.from("evaluate_function_call: closure creation failed"),
                      false,
                      .None
                    )
                  )
                );
                make_err_expr()
              }
            )
          },
          // SomeT — three cases: (1) HKT kind-annotated type constructor F(A…)
          // → build a TypeApplication; (2) wraps a FnTrait (Impl(Fn(...) -> T))
          // → closure; (3) neither → error.
          .SomeT(_, _, _, _, _, _, _, _, _, kind_fn_opt) =>
            match(
              kind_fn_opt,
              // (1) HKT: applying a kind-annotated type constructor `F(A…)`.
              // Evaluate each arg to a TypeValue and produce a TypeApplication.
              // Mirrors `function.ts:1248-1328`.
              .Some(_) => {
                ta_args := ArrayList(TypeValue).new();
                (tai : usize) = usize(0);
                while(tai < args.len(), {
                  ta_arg_expr := match(args.get(tai),.Some(a) => a,.None => make_err_expr());
                  ta_evaled := evaluate_expression_raw(ta_arg_expr, env, ctx, exn);
                  ta_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(ta_evaled));
                  ta_info := match(ta_info_opt,.Some(ii) => ii,.None => new_expr_info(env, t_unit()));
                  ta_ty := match(
                    ta_info.value,
                    .Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),
                    .None => TypeValue.Unit
                  );
                  ta_args.push(ta_ty);
                  tai = (tai + usize(1));
                });
                type_app := t_type_app(func_type, ta_args);
                out_ta := new_expr_info(env, t_type());
                out_ta.value = Option(EvalValue).Some(EvalValue.TypeVal(type_app));
                expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_ta);
                expr
              },
              .None => {
                fn_trait_opt := extract_fn_trait_from_type(func_type);
                match(
                  fn_trait_opt,
                  .Some(fn_trait) => {
                    result_opt := try_to_implement_closure_by_fn_module_type(
                      expr,
                      fn_trait,
                      func_type,
                      callee_env,
                      ctx,
                      exn
                    );
                    match(
                      result_opt,
                      .Some(e) => e,
                      .None => {
                        exn.throw(
                          dyn(
                            format_error_message(
                              tok,
                              String.from("evaluate_function_call: SomeT closure creation failed"),
                              false,
                              .None
                            )
                          )
                        );
                        make_err_expr()
                      }
                    )
                  },
                  .None => {
                    exn.throw(
                      dyn(
                        format_error_message(
                          tok,
                          String.from("evaluate_function_call: TypeVal SomeT callee without FnTrait (Phase 4)"),
                          false,
                          .None
                        )
                      )
                    );
                    make_err_expr()
                  }
                )
              }
            ),
          .DynT(_, _, _, _) => {
            fn_trait_opt := extract_fn_trait_from_type(func_type);
            match(
              fn_trait_opt,
              .Some(fn_trait) => {
                result_opt := try_to_implement_closure_by_fn_module_type(
                  expr,
                  fn_trait,
                  func_type,
                  callee_env,
                  ctx,
                  exn
                );
                match(
                  result_opt,
                  .Some(e) => e,
                  .None => {
                    exn.throw(
                      dyn(
                        format_error_message(
                          tok,
                          String.from("evaluate_function_call: DynT closure creation failed"),
                          false,
                          .None
                        )
                      )
                    );
                    make_err_expr()
                  }
                )
              },
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      tok,
                      String.from("evaluate_function_call: TypeVal DynT callee without FnTrait (Phase 4)"),
                      false,
                      .None
                    )
                  )
                );
                make_err_expr()
              }
            )
          },
          // ----------------------------------------------------------------
          // Struct construction: StructType(field1: v1, field2: v2, ...).
          // ----------------------------------------------------------------
          .Struct({ id : struct_id, name : struct_name, field_labels : struct_field_labels, field_types : struct_field_types, is_reference_semantics : is_ref, is_source_namespace : callee_is_sns }) => {
            // Source-namespace struct (record type / anonymous module):
            // `RecordType(field: value, ...)` routes to the record-type
            // implementation, NOT struct construction. TS dispatches on
            // SourceNamespaceType before plain structs (record-type.ts).
            if(callee_is_sns, {
              result_m := try_to_implement_module_with_arguments_by_module_type(
                func_expr,
                func_type,
                args,
                callee_env,
                ctx,
                exn
              );
              out_m := new_expr_info(result_m.caller_env, type_of_eval_value(result_m.module_value));
              out_m.value = Option(EvalValue).Some(result_m.module_value);
              expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_m);
              return(expr);
            });
            fields := match(
              get_struct_fields(struct_id),
              .Some(f) => f,
              .None => {
                tf := ArrayList(TypeField).new();
                (tfi : usize) = usize(0);
                while(tfi < struct_field_labels.len(), {
                  sf_lbl := match(struct_field_labels.get(tfi),.Some(l) => l.clone(),.None => String.new());
                  sf_ty := match(struct_field_types.get(tfi),.Some(t) => t,.None => TypeValue.Unit);
                  tf.push(
                    TypeField(
                      label : sf_lbl,
                      ty : sf_ty,
                      is_comptime : false,
                      default_value : Option(EvalValue).None,
                      assigned_value : Option(EvalValue).None,
                      doc_comment : Option(String).None,
                      is_effect_param : false
                    )
                  );
                  tfi = (tfi + usize(1));
                });
                tf
              }
            );
            // Faithful port of TS function.ts:1020 (`typeFields: value.value.fields`):
            // the struct VALUE's `field_types` carry the CONCRETE type arguments
            // (e.g. `HashSet(String)` → `data : ?*(String)`), whereas the registry
            // template from `get_struct_fields(struct_id)` keeps the generic `?*(T)`.
            // yo-self splits field METADATA (defaults — in the registry) from field
            // TYPES (on the `TypeValue.Struct` value), so take each registry field
            // but OVERRIDE its `ty` with the value's substituted type (matched by
            // label). Without this, a `Self(...)` construction reached via a
            // generic-instantiation Self-dispatch path (e.g. `h.add` →
            // `Self._resize` → `Self._alloc_with_capacity`'s `Self(...)`) checks the
            // concrete field value (`*(String)`) against the UNSUBSTITUTED `*(T)`
            // and degenerates the whole construction to `Type(1)`. See
            // issues/yo-self-p1-transpile-tail.md (2026-06-26 "TRUE ROOT").
            fields_subst := ArrayList(TypeField).new();
            (fsi : usize) = usize(0);
            while(fsi < fields.len(), {
              match(
                fields.get(fsi),
                .Some(fld) => {
                  // Move the registry field into a mutable local and override ONLY
                  // its `ty` with the value's substituted type (metadata moves with
                  // it — no clone of `default_value`/`assigned_value`/`doc_comment`).
                  (fld_m : TypeField) = fld;
                  (subst_ty : TypeValue) = fld_m.ty;
                  (sl_i : usize) = usize(0);
                  (found_sl : bool) = false;
                  while((sl_i < struct_field_labels.len()) && !(found_sl), {
                    if(match(struct_field_labels.get(sl_i),.Some(l) => (l == fld_m.label),.None => false), {
                      subst_ty = match(struct_field_types.get(sl_i),.Some(t) => t,.None => subst_ty);
                      found_sl = true;
                    });
                    sl_i = (sl_i + usize(1));
                  });
                  fld_m.ty = subst_ty;
                  fields_subst.push(fld_m);
                },
                .None => ()
              );
              fsi = (fsi + usize(1));
            });
            call_result_s := try_to_call_type_with_arguments(fields_subst, func_expr, args, callee_env, ctx, false, exn);
            // Treat default UnknownVal fields as compile-time placeholders (mirrors
            // TS createUnknownValue's default `isRuntimeOnly: false/undefined`).
            // Only `.None` positions (no value at all) make the struct non-comptime.
            // This lets `__yo_builtin_io :: Io(async : __yo_io_async, ...)` in the
            // prelude evaluate to a comptime StructVal even though extern-fn fields
            // carry UnknownVal values.
            (all_known_s : bool) = true;
            (ki_s : usize) = usize(0);
            while((ki_s < call_result_s.values.len()) && all_known_s, {
              match(
                call_result_s.values.get(ki_s),
                .Some(inner_opt_s) => {
                  match(
                    inner_opt_s,
                    .Some(_) => (),
                    .None => {
                      all_known_s = false;
                    }
                  );
                },
                .None => {
                  all_known_s = false;
                }
              );
              ki_s = (ki_s + usize(1));
            });
            struct_val := if(all_known_s && !(is_ref), {
              fnames_s := ArrayList(String).new();
              fvals_s := ArrayList(EvalValue).new();
              (bi_s : usize) = usize(0);
              while(bi_s < call_result_s.values.len(), {
                match(
                  call_result_s.values.get(bi_s),
                  .Some(inner_v_s) => {
                    match(
                      inner_v_s,
                      .Some(v_s2) => {
                        lbl_s := match(fields.get(bi_s),.Some(f) => f.label.clone(),.None => String.new());
                        fnames_s.push(lbl_s);
                        fvals_s.push(v_s2);
                      },
                      .None => ()
                    );
                  },
                  _ => ()
                );
                bi_s = (bi_s + usize(1));
              });
              Option(EvalValue).Some(EvalValue.StructVal(struct_name.clone(), fnames_s, fvals_s))
            }, Option(EvalValue).None);
            out_s := new_expr_info(call_result_s.caller_env, func_type);
            out_s.value = struct_val;
            out_s.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(call_result_s.runtime_arg_exprs_in_order);
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_s);
            expr
          },
          // ----------------------------------------------------------------
          // Enum variant construction: EnumType.Variant(field1, field2, ...).
          // ----------------------------------------------------------------
          .EnumT(_, _, variant_names, variant_fields_e, sel_var_name, variant_field_labels, _, _, _) => {
            variant_name := match(
              sel_var_name,
              .Some(n) => n,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      tok,
                      String.from("evaluate_function_call: EnumT callee has no selected variant"),
                      false,
                      .None
                    )
                  )
                );
                String.new()
              }
            );
            (variant_idx : usize) = usize(0);
            (found_variant : bool) = false;
            (vs_i : usize) = usize(0);
            while((vs_i < variant_names.len()) && !(found_variant), {
              match(
                variant_names.get(vs_i),
                .Some(vn) => {
                  if(vn == variant_name, {
                    variant_idx = vs_i;
                    found_variant = true;
                  });
                },
                .None => ()
              );
              vs_i = (vs_i + usize(1));
            });
            if(!(found_variant), {
              exn.throw(
                dyn(
                  format_error_message(
                    tok,
                    `evaluate_function_call: enum variant not found: ${variant_name}`,
                    false,
                    .None
                  )
                )
              );
            });
            fields_for_var := match(variant_fields_e.get(variant_idx),.Some(f) => f,.None => ArrayList(TypeValue).new());
            labels_for_var := match(variant_field_labels.get(variant_idx),.Some(l) => l,.None => ArrayList(String).new());
            tf_e := ArrayList(TypeField).new();
            (tfi_e : usize) = usize(0);
            while(tfi_e < fields_for_var.len(), {
              vf_ty := match(fields_for_var.get(tfi_e),.Some(t) => t,.None => TypeValue.Unit);
              vf_lbl := match(labels_for_var.get(tfi_e),.Some(l) => l.clone(),.None => String.new());
              tf_e.push(
                TypeField(
                  label : vf_lbl,
                  ty : vf_ty,
                  is_comptime : false,
                  default_value : Option(EvalValue).None,
                  assigned_value : Option(EvalValue).None,
                  doc_comment : Option(String).None,
                  is_effect_param : false
                )
              );
              tfi_e = (tfi_e + usize(1));
            });
            call_result_e := try_to_call_type_with_arguments(tf_e, func_expr, args, callee_env, ctx, false, exn);
            // Mirror TS enum value construction: default UnknownVal fields are
            // compile-time placeholders (isRuntimeOnly: false/undefined) and
            // therefore still produce a comptime EnumVal. Only missing values
            // (`.None`) abort comptime construction.
            (all_known_e : bool) = true;
            (ki_e : usize) = usize(0);
            while((ki_e < call_result_e.values.len()) && all_known_e, {
              match(
                call_result_e.values.get(ki_e),
                .Some(inner_opt_e) => {
                  match(
                    inner_opt_e,
                    .Some(_) => (),
                    .None => {
                      all_known_e = false;
                    }
                  );
                },
                .None => {
                  all_known_e = false;
                }
              );
              ki_e = (ki_e + usize(1));
            });
            enum_val := if(all_known_e, {
              fvals_e := ArrayList(EvalValue).new();
              (bi_e : usize) = usize(0);
              while(bi_e < call_result_e.values.len(), {
                match(
                  call_result_e.values.get(bi_e),
                  .Some(inner_v_e) => {
                    match(
                      inner_v_e,
                      .Some(v_e2) => {
                        fvals_e.push(v_e2);
                      },
                      .None => ()
                    );
                  },
                  _ => ()
                );
                bi_e = (bi_e + usize(1));
              });
              dot_variant := `.${variant_name}`;
              Option(EvalValue).Some(EvalValue.EnumVal(dot_variant, fvals_e))
            }, Option(EvalValue).None);
            out_e := new_expr_info(call_result_e.caller_env, func_type);
            out_e.value = enum_val;
            out_e.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(call_result_e.runtime_arg_exprs_in_order);
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_e);
            expr
          },
          // ----------------------------------------------------------------
          // Union construction: UnionType(field_value).
          // ----------------------------------------------------------------
          .Union(_, union_labels, union_types) => {
            tf_u := ArrayList(TypeField).new();
            (tfi_u : usize) = usize(0);
            while(tfi_u < union_labels.len(), {
              u_lbl := match(union_labels.get(tfi_u),.Some(l) => l.clone(),.None => String.new());
              u_ty := match(union_types.get(tfi_u),.Some(t) => t,.None => TypeValue.Unit);
              tf_u.push(
                TypeField(
                  label : u_lbl,
                  ty : u_ty,
                  is_comptime : false,
                  default_value : Option(EvalValue).None,
                  assigned_value : Option(EvalValue).None,
                  doc_comment : Option(String).None,
                  is_effect_param : false
                )
              );
              tfi_u = (tfi_u + usize(1));
            });
            call_result_u := try_to_call_type_with_arguments(tf_u, func_expr, args, callee_env, ctx, true, exn);
            out_u := new_expr_info(call_result_u.caller_env, func_type);
            out_u.value = Option(EvalValue).None;
            out_u.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(call_result_u.runtime_arg_exprs_in_order);
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_u);
            expr
          },
          // ----------------------------------------------------------------
          // Trait specialization (Item := T) or implementation.
          // ----------------------------------------------------------------
          .TraitT(_, _, _, _, _, _, _, _) => {
            (has_spec : bool) = false;
            (spec_i : usize) = usize(0);
            while((spec_i < args.len()) && !(has_spec), {
              match(
                args.get(spec_i),
                .Some(a) => {
                  if(ast_expr_is_fn_call_of(a, ":=", Option(usize).Some(usize(2))), {
                    has_spec = true;
                  });
                },
                .None => ()
              );
              spec_i = (spec_i + usize(1));
            });
            if(has_spec, {
              result_ts := try_to_specialize_trait_type(
                func_expr,
                func_type,
                args,
                callee_env,
                ctx,
                exn
              );
              out_ts := new_expr_info(result_ts.caller_env, t_type());
              out_ts.value = Option(EvalValue).Some(EvalValue.TypeVal(result_ts.specialized_trait_type));
              expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_ts);
              expr
            }, {
              result_ti := try_to_implement_trait_with_arguments_by_trait_type(
                func_expr,
                func_type,
                args,
                callee_env,
                ctx,
                exn
              );
              out_ti := new_expr_info(result_ti.caller_env, type_of_eval_value(result_ti.trait_value));
              out_ti.value = Option(EvalValue).Some(result_ti.trait_value);
              expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_ti);
              expr
            })
          },
          // ----------------------------------------------------------------
          // Array construction: ArrayType(elem1, elem2, ...).
          // ----------------------------------------------------------------
          .Array(_, _, _) =>
            try_to_implement_array_by_array_type(expr, func_type, args, callee_env, ctx, exn),
          // ----------------------------------------------------------------
          // ComptimeList construction: ComptimeListT(elem1, elem2, ...).
          // ----------------------------------------------------------------
          .ComptimeListT(_) =>
            try_to_implement_comptime_list_by_comptime_list_type(expr, func_type, args, callee_env, ctx, exn),
          // ----------------------------------------------------------------
          // Iso value wrapping: IsoType(value).
          // ----------------------------------------------------------------
          .IsoT(_) =>
            evaluate_iso_value_call(expr, callee_env, ctx, func_type, exn),
          // ----------------------------------------------------------------
          // Pointer type cast: *(T)(value).
          // ----------------------------------------------------------------
          .Pointer(_) => {
            arg_expr_p := match(
              args.get(usize(0)),
              .Some(a) => a,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      tok,
                      String.from("evaluate_function_call: pointer cast expects 1 argument"),
                      false,
                      .None
                    )
                  )
                );
                make_err_expr()
              }
            );
            result_ptr := try_to_convert_to_pointer_type(func_type, arg_expr_p, expr, callee_env, ctx, exn);
            match(
              result_ptr,
              .Some(e_ptr) => e_ptr,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      tok,
                      String.from("evaluate_function_call: pointer type conversion failed"),
                      false,
                      .None
                    )
                  )
                );
                make_err_expr()
              }
            )
          },
          // ----------------------------------------------------------------
          // Numeric type cast: i32(x), u64(y), f64(z), etc.
          // Any type satisfying is_convertible_numeric_type falls here.
          // ----------------------------------------------------------------
          _ =>
            if(is_convertible_numeric_type(func_type), {
              arg_expr_n := match(
                args.get(usize(0)),
                .Some(a) => a,
                .None => {
                  exn.throw(
                    dyn(
                      format_error_message(
                        tok,
                        String.from("evaluate_function_call: numeric cast expects 1 argument"),
                        false,
                        .None
                      )
                    )
                  );
                  make_err_expr()
                }
              );
              result_n := try_to_convert_to_numeric_type(func_type, arg_expr_n, expr, callee_env, ctx, exn);
              match(
                result_n,
                .Some(e_n) => e_n,
                .None => {
                  exn.throw(
                    dyn(
