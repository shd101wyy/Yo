          out_ct.value = Option(EvalValue).Some(ct_result.value);
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_ct);
          param_vars;
          return(expr);
        });
        // Faithful port of `helper.ts:1731`: ONLY comptime-only-return functions
        // execute their body at call time (the gate above). A function with a
        // RUNTIME return type yields `UnknownVal(returnType)` WITHOUT executing
        // its body. Executing runtime bodies at call time over-CTFEs runtime
        // code (allocation, builtins like `malloc` / `__yo_slice_len` /
        // `sizeof(T) * cap`) on unknown values → spurious `unit` and cascading
        // type errors (e.g. CTFE-ing `String.from("hi")` →
        // `ArrayList.with_capacity` → `malloc(sizeof(T) * cap)`). TS type-checks
