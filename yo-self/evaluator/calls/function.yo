            ret_type_rt,
            .SomeT({ name : sn, frame_level : sfl, parent_type : spt, required_trait_types : srtt, required_trait_levels : srtl, negative_trait_types : sntt, negative_trait_levels : sntl, is_effects_row : sier, kind_function_type : skft }) => TypeValue.SomeT(generate_some_type_id(), sn, sfl, spt, srtt, srtl, sntt, sntl, sier, skft),
