        // even when the callee's recorded return type was specialized to a
        // concrete struct in an expected-type context. Route those through
        // `evaluate_comptime_fn_call` so the result is MEMOIZED + STAMPED with
        // `constructor_func_id`. Safe for recursive types: the recursion guard
        // returns a finite SomeT-leaf placeholder (recursiveTypeRef A/B) and
        // `synthesis_type_id` uses a shallow key, so synthesis terminates.
        all_args_are_types := cond(
          (evaled_arg_infos.len() == usize(0)) => false,
          true => {
            (ok : bool) = true;
            (tai : usize) = usize(0);
            while((tai < evaled_arg_infos.len()) && ok, {
