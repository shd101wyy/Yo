          // an ArrayType, got i8" inside i8's ToString impl).
          old_self_ty_ct := ctx.self_type;
          match(
            _static_dot_receiver_self_type(func_expr, ctx),
            .Some(st_ct) => {
              ctx.self_type = Option(TypeValue).Some(st_ct);
            },
            .None => ()
          );
