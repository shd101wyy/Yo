//! evaluator/calls/function — evaluate_function_call.
//!
//! Phase 3 — expanded implementation.
//! 1:1 port of `src/evaluator/calls/function.ts`.
//!
//! Phase 3 handles:
//!   1. `(fn(params) -> T)(body)` — function definition (TypeVal(Func) callee).
//!   2. `Impl(Fn(...) -> T)(body)` / `Dyn(Fn(...) -> T)(body)` — closure
//!      creation via `try_to_implement_closure_by_fn_module_type`.
//!   3. `f(arg1, arg2, ...)` — simple FuncVal call.
//!
//! Complex dispatch (overloads, CTFE, method calls, trait dispatch, macros)
//! still deferred to Phase 4.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  make_err_expr,
  clone_expr_fresh_ids,
  alloc_global_expr_id,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  BF_DOT
} :: import("../../expr.yo");
{ is_auto_generated_expansion } :: import("../memory_safety.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  record_method_callee_type,
  record_method_callee_value,
  register_some_resolved_concrete,
  lookup_some_resolved_concrete,
  record_macro_expansion
} :: import("../../expr_info.yo");
{
  Variable,
  Environment,
  add_variable_to_env,
  synthetic_token,
  get_receiver_methods_by_name_from_env,
  get_type_trait_methods_by_name_from_env
} :: import("../../env.yo");
{ TypeValue, FuncMeta } :: import("../../types/definitions.yo");
{ get_func_param_defaults, is_param_quoted, is_macro_fn, macro_return_is_unquote, evaluate_function_return_type_again, get_func_variadic_param } :: import("../types/function.yo");
{ is_io_async_call, is_io_await_call } :: import("../async/await_analysis.yo");
{ subst_new, subst_add, substitute } :: import("../../types/substitution.yo");
{ t_unit, t_type, t_comptime_int, t_type_app, t_expr_t, generate_some_type_id, resolve_enum_shell } :: import("../../types/creators.yo");
{ Token, TokenKind, string_is_operator } :: import("../../token.yo");
{ EvalValue, FuncValData, type_of_eval_value, is_type_val, is_unknown_val } :: import("../../value.yo");
{ random_id } :: import("../../utils.yo");
{ attach_temp_variable_to_expr } :: import("../utils.yo");
{
  EvalContext,
  ExpectedTypeCtx,
  FuncOrAsyncBlockCtx,
  FuncOrAsyncBlockKind,
  TypeCallResult,
  ModuleTypeCallResult,
  TraitTypeCallResult,
  TraitSpecializationResult,
