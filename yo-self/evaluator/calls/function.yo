          {
            (gi : usize) = usize(0);
            while(gi < fv_g_args.len(), {
              if(gi < forall_names.len(), {
                fv_g_arg := match(fv_g_args.get(gi),.Some(x) => x,.None => make_err_expr());
                if(!(ast_expr_is_atom_of(fv_g_arg, "_")), {
                  fv_g_evaled := evaluate_expression_raw(fv_g_arg, env, ctx, exn);
                  match(
                    expr_info_table_get(ctx.expr_info_table, ast_expr_id(fv_g_evaled)),
                    .Some(fv_g_info) => match(
                      fv_g_info.value,
                      .Some(fv_g_val) => {
