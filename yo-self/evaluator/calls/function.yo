        (evi : usize) = usize(0);
        while(evi < n_ev, {
          ev_name := match(evidence_names.get(evi),.Some(n) => n,.None => String.from(""));
          ev_info := match(evaled_arg_infos.get(n_supplied_reg + evi),.Some(i) => i,.None => new_expr_info(env, t_unit()));
          is_ct_ev := match(ev_info.value,.Some(_) => true,.None => false);
