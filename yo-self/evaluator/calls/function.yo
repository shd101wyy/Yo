            });
            // An `undefined` argument uses the parameter's declared default
            // (TS helper.ts:323-344). The default expression may reference
            // EARLIER params (`(Rhs : Type) ?= Lhs`), which TS resolves via
            // its sequentially-bound calleeEnv — layer a frame binding the
            // already-evaluated args by param name for this evaluation.
            (du_frame_pushed : bool) = false;
            if((ai < n_p) && ast_expr_is_atom_of(arg_expr_eff, "undefined"), {
              (du_def : Option(AstExpr)) = Option(AstExpr).None;
              match(
                fv_default_exprs.get(ai),
                .Some(de_opt) => {
                  du_def = de_opt;
                },
                .None => ()
              );
              match(
                du_def,
                .Some(du_de) => {
                  arg_expr_eff = clone_expr_fresh_ids(du_de);
                  _duf := env.push_frame(false);
                  du_frame_pushed = true;
                  (du_j : usize) = usize(0);
                  while(du_j < ai, {
                    du_name := match(param_names.get(du_j),.Some(nm) => nm,.None => String.new());
                    match(
                      evaled_arg_infos.get(du_j),
                      .Some(du_info) => if(du_name.len() > usize(0), {
                        add_variable_to_env(
                          env,
                          du_name.clone(),
                          du_info.ty,
                          du_info.value,
                          match(du_info.value,.Some(_) => true,.None => false),
                          false,
                          false,
                          false,
                          synthetic_token(du_name, env.module_path)
                        );
                      }),
                      .None => ()
                    );
                    du_j = (du_j + usize(1));
                  });
                },
                .None => ()
              );
            });
            // Evaluate the arg with expectedType = the DECLARED PARAM TYPE
            // (helper.ts:330) — leaving the caller's expected type in place
            // leaked e.g. a single-expr fn body's expected `bool` into the
            // first argument, so `zimpl(zp.as_bytes(), ...)` synthesized
            // unify(ArrayList(u8), bool) and the whole module failed.
            arg_saved_expected := ctx.expected_type;
            ctx.expected_type = match(
              resolved_param_types.get(ai),
              .Some(apt) => cond(
                // Skip Type params (constructor args) AND unresolved
                // SomeTs — TS passes the SPECIALIZED parameterType
                // (helper.ts:330); when yo-self only has the generic
                // declared type, an abstract expected mis-resolves
                // enum-variant shorthands (".Table(...)" looked up in
                // SomeT-T → "variant not found").
                is_type_hierarchy_type(apt) => Option(ExpectedTypeCtx).None,
                // Abstract SomeTs (bare type-param `T`) are skipped — an abstract
                // expected mis-resolves enum-variant shorthands. EXCEPTION: a
                // SomeT wrapping an Fn trait (`cb : Impl(Fn(...), Send)`) MUST be
                // passed so the closure arg coerces through closure_type.yo and
                // records its capture struct as the SomeT's resolvedConcreteType
                // (needed for spawn/parallelism specialization). Mirrors TS
                // passing the declared param type as the arg's expected type
                // (helper.ts:330).
                is_some_type(apt) => match(
                  extract_fn_trait_from_type(apt),
                  .Some(_) => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : apt, env : env)),
                  .None => Option(ExpectedTypeCtx).None
                ),
                true => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : apt, env : env))
              ),
              .None => Option(ExpectedTypeCtx).None
            );
            evaled_arg := evaluate_expression_raw(arg_expr_eff, env, ctx, exn);
            ctx.expected_type = arg_saved_expected;
            if(du_frame_pushed, {
              env.pop_frame();
            });
            arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_arg));
            arg_info := match(
              arg_info_opt,
              .Some(i) => i,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(arg_expr),
                      String.from("evaluate_function_call: arg not evaluated"),
                      false,
                      .None
                    )
                  )
                );
                new_expr_info(env, t_unit())
              }
            );
            _push_arg := evaled_arg_infos.push(arg_info);
            rt_arg_is_ct := match(rt_ct_flags_args.get(ai),.Some(f) => f,.None => false);
            if(!(rt_arg_is_ct), {
              _push_rt := runtime_arg_exprs.push(evaled_arg);
            });
            // Step 4b own-consume (port of helper.ts:411-451 / helper.yo:543):
            // this inline FuncVal arg loop BYPASSES
            // try_to_call_function_with_arguments, so `own(...)` params never
            // consumed their args here — `box(t.clone())` left the clone temp
            // owning and the statement cleanup dropped it AFTER box() moved it
            // (net −1 on the boxed payload: the stage-2 t1.yo rc=133 UAF;
            // corpus repro box_arg_move_property_store.yo). Owning arg → MOVE
            // (consume, no dup); borrowed → materialize via ___dup + consume.
            fv_p_owning := match(fv_param_is_owning.get(ai),.Some(o) => o,.None => false);
            fv_p_is_ct := match(
              resolved_param_types.get(ai),
              .Some(apt2) => is_type_hierarchy_type(apt2),
              .None => false
            );
            if(fv_p_owning && (!(fv_p_is_ct)), {
              match(
                arg_info.variable_name,
                .None => (),
                .Some(fv_avn) => {
                  fv_avars := get_variables_from_env(env, fv_avn);
                  if(fv_avars.len() > usize(0), {
                    fv_avar := match(fv_avars.get(fv_avars.len() - usize(1)),.Some(v) => v,.None => make_err_variable(env));
                    if(fv_avar.is_owning_the_rc_value, {
                      set_expr_as_consumed(evaled_arg, env, true, ctx, exn);
                    }, {
                      set_expr_as_needs_to_call_dup(evaled_arg, ctx, exn);
                      set_expr_as_consumed(evaled_arg, env, true, ctx, exn);
                    });
                  });
                }
              );
            });
          };
          ai = (ai + usize(1));
        });
        ctx.is_inside_io_async_call = prev_io_async_ctx;
        // ----------------------------------------------------------------
        // Omitted-default splice: clone + evaluate the default-value
        // EXPRESSION of each omitted trailing regular param and splice the
        // results in as if the caller had supplied them — into
        // `evaled_arg_infos`/`runtime_arg_exprs` at the regular/evidence
        // boundary, bumping `n_supplied_reg`. TS has ONE call path where
        // checkIfFunctionParameterMatchesArgument runs for defaults too
        // (helper.ts:323-344 merges into the shared post-processing), so the
        // default participates in generic inference, binds under the same
        // coercions as a supplied arg, is EMITTED as a C argument, and lands
        // in the specialization args. Without this, bare `assert(x)` bound
        // `msg` at the unresolved generic SomeT and the body's `panic(msg)`
        // specialized (and was called) at an UNEMITTED SomeT-keyed C fn.
        // Splices only the contiguous prefix of omitted params with a
        // recorded default expr; the rest keep the value-binding fallback in
        // the param loop below.
        if(n_supplied_reg < n_p, {
          def_infos := ArrayList(ExprInfo).new();
          def_rt_exprs := ArrayList(AstExpr).new();
          // TS evaluates a parameter's default IN CALLEE ENV where the
          // EARLIER params are already bound (helper.ts:329-331 — the
          // per-param loop binds sequentially), so `(Rhs : Type) ?= Lhs`
          // resolves the sibling param. This splice runs BEFORE yo-self's
          // param binding, so layer a frame with the already-supplied (and
          // previously-spliced) params bound by name; popped after the loop.
          _dfr := env.push_frame(false);
          {
            (dbi : usize) = usize(0);
            while(dbi < n_supplied_reg, {
              db_name := match(param_names.get(dbi),.Some(nm) => nm,.None => String.new());
              match(
                evaled_arg_infos.get(dbi),
                .Some(dbi_info) => {
                  if(db_name.len() > usize(0), {
                    add_variable_to_env(
                      env,
                      db_name.clone(),
                      dbi_info.ty,
                      dbi_info.value,
                      match(dbi_info.value,.Some(_) => true,.None => false),
                      false,
                      false,
                      false,
                      synthetic_token(db_name, env.module_path)
                    );
                  });
                },
                .None => ()
              );
              dbi = (dbi + usize(1));
            });
          };
          (dpi : usize) = n_supplied_reg;
          (def_stop : bool) = false;
          while((dpi < n_p) && !(def_stop), {
            (def_expr : Option(AstExpr)) = Option(AstExpr).None;
            match(
              fv_default_exprs.get(dpi),
              .Some(de_opt) => {
                def_expr = de_opt;
              },
              .None => ()
            );
            match(
              def_expr,
              .Some(de) => {
                cloned_de := clone_expr_fresh_ids(de);
                // Same expected-type policy as the supplied-arg loop above.
                def_saved_expected := ctx.expected_type;
                ctx.expected_type = match(
                  resolved_param_types.get(dpi),
                  .Some(apt) => cond(
                    is_type_hierarchy_type(apt) => Option(ExpectedTypeCtx).None,
                    is_some_type(apt) => match(
                      extract_fn_trait_from_type(apt),
                      .Some(_) => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : apt, env : env)),
                      .None => Option(ExpectedTypeCtx).None
                    ),
                    true => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : apt, env : env))
                  ),
                  .None => Option(ExpectedTypeCtx).None
                );
                evaled_de := evaluate_expression_raw(cloned_de, env, ctx, exn);
                ctx.expected_type = def_saved_expected;
                de_info := match(
                  expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_de)),
                  .Some(i) => i,
                  .None => new_expr_info(env, t_unit())
                );
                def_infos.push(de_info);
                def_rt_exprs.push(evaled_de);
                // Bind this spliced param so the NEXT param's default sees
                // it (`(Output : Type) ?= Lhs` after `(Rhs : Type) ?= Lhs`).
                {
                  dsn := match(param_names.get(dpi),.Some(nm) => nm,.None => String.new());
                  if(dsn.len() > usize(0), {
                    add_variable_to_env(
                      env,
                      dsn.clone(),
                      de_info.ty,
                      de_info.value,
                      match(de_info.value,.Some(_) => true,.None => false),
                      false,
                      false,
                      false,
                      synthetic_token(dsn, env.module_path)
                    );
                  });
                };
              },
              .None => {
                def_stop = true;
              }
            );
            if(!(def_stop), {
              dpi = (dpi + usize(1));
            });
          });
          env.pop_frame();
          n_spliced := def_infos.len();
          if(n_spliced > usize(0), {
            // Pop the evidence tails, push the defaults, re-push the tails.
            // `evaled_arg_infos` has one entry per supplied arg (quoted args
            // included), so its evidence tail starts at n_supplied_reg;
            // `runtime_arg_exprs` skips quoted regular args, so its evidence
            // tail is the last (n_a - n_supplied_reg) entries.
            n_ev_tail := (n_a - n_supplied_reg);
            ev_tail_infos := ArrayList(ExprInfo).new();
            (eti : usize) = usize(0);
            while(eti < n_ev_tail, {
              match(
                evaled_arg_infos.pop(),
                .Some(ti) => {
                  ev_tail_infos.push(ti);
                },
                .None => ()
              );
              eti = (eti + usize(1));
            });
            ev_tail_rt := ArrayList(AstExpr).new();
            (etr : usize) = usize(0);
            while(etr < n_ev_tail, {
              match(
                runtime_arg_exprs.pop(),
                .Some(te) => {
                  ev_tail_rt.push(te);
                },
                .None => ()
              );
              etr = (etr + usize(1));
            });
            (dsi : usize) = usize(0);
            while(dsi < n_spliced, {
              match(
                def_infos.get(dsi),
                .Some(i) => {
                  evaled_arg_infos.push(i);
                },
                .None => ()
              );
              match(
                def_rt_exprs.get(dsi),
                .Some(e) => {
                  runtime_arg_exprs.push(e);
                },
                .None => ()
              );
              dsi = (dsi + usize(1));
            });
            // Re-push the evidence tails (popped in reverse order).
            (rti : usize) = ev_tail_infos.len();
            while(rti > usize(0), {
              rti = (rti - usize(1));
              match(
                ev_tail_infos.get(rti),
                .Some(i) => {
                  evaled_arg_infos.push(i);
                },
                .None => ()
              );
            });
            (rtr : usize) = ev_tail_rt.len();
            while(rtr > usize(0), {
              rtr = (rtr - usize(1));
              match(
                ev_tail_rt.get(rtr),
                .Some(e) => {
                  runtime_arg_exprs.push(e);
                },
                .None => ()
              );
            });
            n_supplied_reg = (n_supplied_reg + n_spliced);
          });
        });
        // Build a fresh environment for the function body.
        fresh_env := Environment.new(env.module_path);
        // Bind captures.
        (cap_i : usize) = usize(0);
        n_cap := cap_names.len();
        while(cap_i < n_cap, {
          cn := match(cap_names.get(cap_i),.Some(n) => n,.None => String.from(""));
          ct := match(cap_tys.get(cap_i),.Some(t) => t,.None => t_unit());
          cap_v := match(cap_vals.get(cap_i),.Some(v) => Option(EvalValue).Some(v),.None => Option(EvalValue).None);
          is_ct_only := match(cap_v,.Some(_) => true,.None => false);
          _add_cap := add_variable_to_env(
            fresh_env,
            cn,
            ct,
            cap_v,
            is_ct_only,
            false,
            false,
            false,
            synthetic_token(cn, env.module_path)
          );
          cap_i = (cap_i + usize(1));
        });
        // Push a frame and bind `__recur_fn`.
        _fr := fresh_env.push_frame(false);
        fv_for_recur := EvalValue.FuncVal(
          box(
            FuncValData(
              forall_names : forall_names,
              params : param_names,
              param_type_names : param_type_names,
              evidence_params : evidence_names,
              body : body_box,
              cap_names : cap_names,
              cap_tys : cap_tys,
              func_id : random_id(env.module_path)
            )
          ),
          cap_vals
        );
        _add_recur := add_variable_to_env(
          fresh_env,
          String.from("__recur_fn"),
          t_unit(),
          Option(EvalValue).Some(fv_for_recur),
          true,
          false,
          false,
          false,
          synthetic_token(String.from("__recur_fn"), env.module_path)
        );
        // For a static method call (`Type.method()`), the receiver type carries
        // its concrete type arguments (`type_arguments`, set at instantiation).
        // A `generic` param NOT inferable from call arguments (e.g. a no-arg
        // method whose body uses `K`/`V`, or one dispatched via `Self`) is bound
        // positionally from these. Faithful stand-in for TS recovering the
        // substitution from `StructType.env`. See
        // issues/fixed/self-dispatch-loses-type-args.md.
        recv_type_args := match(
          _static_dot_receiver_self_type(func_expr, ctx),
          .Some(rt) => match(rt,.Struct({ type_arguments : ta }) => ta, _ => ArrayList(TypeValue).new()),
          .None => ArrayList(TypeValue).new()
        );
        // Infer generic type params from argument types.
        n_forall := forall_names.len();
        // Record the (name -> bound type) pairs so the declared return
        // type's generic SomeTs can be substituted after binding (see the
        // runtime-return path below).
        fa_bound_names := ArrayList(String).new();
        fa_bound_types := ArrayList(TypeValue).new();
        _funcval_bind_foralls(
          forall_names,
          param_type_names,
          evaled_arg_infos,
          cap_names,
          cap_vals,
          recv_type_args,
          fresh_env,
          env,
          n_forall,
          fa_bound_names,
          fa_bound_types,
          if(rpt_from_expected, resolved_param_types, ArrayList(TypeValue).new()),
          fv_param_types,
          fv_param_ct,
          match(
            callee_info_opt,
            .Some(fk_ci) => match(fk_ci.ty,.Func({ forall_types : fk_fts }) => fk_fts, _ => ArrayList(TypeValue).new()),
            .None => ArrayList(TypeValue).new()
          ),
          fv_pre_forall_names,
          fv_pre_forall_vals,
          fv_pre_forall_tys
        );
        // v4.1: validate the PLACES bound to ref parameters (after argument
        // evaluation so the chain types are resolved). Mirrors TS
        // requireValidRefArgumentPlaces; this inline FuncVal arm is
        // yo-self's second call path, so the gate runs here too.
        require_ref_own_argument_exclusivity(
          fv_param_labels,
          fv_param_is_ref,
          fv_param_is_owning,
          fv_args,
          env,
          ctx,
          exn
        );
        require_valid_ref_argument_places(fv_param_is_ref, fv_args, env, ctx, exn);
        // Bind regular params. Params at index >= n_supplied_reg were
        // omitted at the call site (they have `?= default`s); bind each to
        // its recorded default value (typed by its declared type) so the
        // body type-checks with the real default — e.g. `assert(cond)`
        // binds `msg` to the literal "Assertion failed.", which the
        // `panic(msg)` in the body requires.
        param_vars := ArrayList(Variable).new();
        (pi : usize) = usize(0);
        while(pi < n_p, {
          pname := match(param_names.get(pi),.Some(n) => n,.None => String.from(""));
          (arg_info : ExprInfo) = new_expr_info(env, t_unit());
          if(pi < n_supplied_reg, {
            arg_info = match(evaled_arg_infos.get(pi),.Some(i) => i,.None => new_expr_info(env, t_unit()));
          }, {
            p_ty := match(fv_param_types.get(pi),.Some(t) => t,.None => t_unit());
            arg_info = new_expr_info(env, p_ty);
            (omitted_val : EvalValue) = create_unknown_val(p_ty);
            match(
              fv_defaults.get(pi),
              .Some(d) => match(
                d,
                .Some(dv) => {
                  omitted_val = dv;
                },
                .None => ()
              ),
              .None => ()
            );
            arg_info.value = Option(EvalValue).Some(omitted_val);
          });
          // comptime_str → str/String value coercion. When a
          // `comptime_str` literal (e.g. `"hi"`) is bound to a concrete
          // runtime string parameter (`str`, `String`, …), bind it under the
          // DECLARED parameter type with a runtime value, NOT under its raw
          // `comptime_str` type. Otherwise in-body method dispatch resolves
          // against `comptime_str` (`comptime_str.len() -> comptime_int
          // -> i32`) instead of the declared runtime type (`str.len() ->
          // usize`) — the source of the spurious "Cannot unify i32 and usize"
          // when CTFE-evaluating `String.from("hi")`. The comptime value cannot
          // stand in for the runtime `str` struct (its `.bytes` Slice has no
          // comptime representation), so we bind a runtime value of the
          // declared type. This is the FuncVal-call counterpart of the
          // comptime→runtime conversion `helper.ts:504-568` performs.
          //
          // Narrow guard — only comptime_str args against a concrete,
          // non-comptime-string, non-`SomeT` declared param. This avoids
          // touching comptime type-parameter args (e.g.
          // `(?*) :: (fn(comptime(T):Type)->…)(Option(*(T)))`), which must keep
          // their `Type` value so `*(T)` resolves.
          bind_decl_pt := match(fv_param_types.get(pi),.Some(t) => t,.None => t_unit());
          // Resolve a generic-`SomeT` declared param type to its concrete binding
          // BY NAME via fa_bound_names/types (built in the inference loop just
          // above — e.g. `T`→`str`). A frame-keyed env lookup misses here because
          // the param's SomeT carries the function's DEFINITION frame level, not
          // the call frame. With the resolved concrete type, the comptime_str→
          // runtime coercion below fires for a generic VALUE param too, so `v` binds
          // as `str` (not comptime_str) — without it, in-body `v.to_string()`
          // dispatches against comptime_str (→ i32) and throws "Cannot unify i32 and
          // str" while specializing println/print (Gap-6).
          resolved_decl_pt := cond(
            is_some_type(bind_decl_pt) => {
              sname := match(bind_decl_pt,.SomeT({ name : sn }) => sn, _ => String.from(""));
              (rt : TypeValue) = bind_decl_pt;
              (rk : usize) = usize(0);
              (rn : usize) = fa_bound_names.len();
              while(rk < rn, {
                bn := match(fa_bound_names.get(rk),.Some(s) => s,.None => String.from(""));
                if((sname.len() > usize(0)) && (bn == sname), {
                  rt = match(fa_bound_types.get(rk),.Some(t) => t,.None => bind_decl_pt);
                  rk = rn;
                }, {
                  rk = (rk + usize(1));
                });
              });
              rt
            },
            true => bind_decl_pt
          );
          (bind_ty : TypeValue) = arg_info.ty;
          (bind_val : Option(EvalValue)) = arg_info.value;
          // A concrete arg value binds the param compile-time-only (Phase-3
          // comptime-folding heuristic) — EXCEPT a closure/function value: a
          // FuncVal-bound param must stay a RUNTIME binding so a nested
          // closure referencing it records it as a CAPTURE
          // (track_variable_usage skips compile-time-only bindings; a ct
          // get_info param made the dyn detect-closure's capture struct drop
          // the field → undeclared `get_info` in the emitted C). TS binds
          // isCompileTimeOnly from the PARAMETER declaration, never from
          // arg-value presence (helper.ts:573).
          (is_ct : bool) = match(arg_info.value,.Some(av) => !(is_func_val(av)),.None => false);
          if((is_comptime_string_type(arg_info.ty) && (!(is_some_type(resolved_decl_pt)))) && (!(is_comptime_string_type(resolved_decl_pt))), {
            bind_ty = resolved_decl_pt.clone();
            bind_val = Option(EvalValue).Some(create_unknown_val(resolved_decl_pt));
            is_ct = false;
          });
          p_is_ref := match(fv_param_is_ref.get(pi),.Some(b) => b,.None => false);
          // Bind via add_parameter_to_env (NOT add_variable_to_env, which
          // hardcodes is_ref=false) so an `inout(name) : T` param carries
          // is_ref onto the binding — codegen then dereferences reads as
          // `(*name)`. The old add_variable_to_env call passed p_is_ref only
          // as is_reassignable and silently dropped is_ref, so a SPECIALIZED
          // callee's body emitted `p.x` on a pointer param (`__yo_tN* p`)
          // instead of `(*p).x`; the def-time body eval (function_type.yo:362)
          // already binds params this way, which is why the non-specialized
          // function was correct. Mirrors TS helper.ts:584-585
          // (`isRef: parameter.isRef, isReassignable: parameter.isRef,
          // isParameter: true`).
          var_opt := add_parameter_to_env(
            fresh_env,
            pname,
            bind_ty,
            bind_val,
            is_ct,
            p_is_ref,
            false,
            false,
            p_is_ref,
            true,
            synthetic_token(pname, env.module_path)
          );
          match(
            var_opt,
            .Some(v) => {
              _push_pv := param_vars.push(v);
            },
            .None => ()
          );
          pi = (pi + usize(1));
        });
        // Bind a QUOTED VARIADIC parameter (`...(quote(elems))`) for macro
        // expansion: gather the trailing supplied args (regular-arg indices
        // n_p..n_supplied_reg) as raw-AST `Expr` values into a `ComptimeList`
        // and bind it under the variadic's name in `fresh_env`, so the macro
        // body's `elems.len()/car()/cdr()` resolve when the body runs. Without
        // this, the variadic name is unbound and the body throws. Mirrors TS
        // variadic binding (helper.ts:1620-1709); the args were already
        // captured as `Expr` in the arg loop above.
        if(fv_variadic_is_quote, {
          velems := ArrayList(EvalValue).new();
          (vidx : usize) = n_p;
          while(vidx < n_supplied_reg, {
            match(
              fv_args.get(vidx),
              .Some(varg) => {
