        // executing context).
        if(((is_type_hierarchy_type(ret_type) || callee_result_is_comptime) || all_args_are_types) || fv_is_macro, {
          ct_arg_entries := ArrayList(ArgEntry).new();
          (ct_ai : usize) = usize(0);
          while(ct_ai < evaled_arg_infos.len(), {
            ct_info := match(
              evaled_arg_infos.get(ct_ai),
              .Some(i) => i,
              .None => new_expr_info(env, t_unit())
