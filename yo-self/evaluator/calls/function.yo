        fv_param_labels := match(
          callee_info_opt,
          .Some(ci) => match(
            ci.ty,
            .Func({ meta : __fm5 }) => __fm5.*.param_labels,
            _ => ArrayList(String).new()
          ),
          .None => ArrayList(String).new()
        );
        fv_param_is_ref := match(
          callee_info_opt,
          .Some(ci) => match(
            ci.ty,
            .Func({ meta : __fm6 }) => __fm6.*.param_is_ref,
            _ => ArrayList(bool).new()
          ),
          .None => ArrayList(bool).new()
