        // Does NOT touch the future type, any env binding, or synthesize (binding
        // `T` at synthesis regresses ALL async — the pipeline keeps the future
        // output as an unresolved SomeType through eval; see
        // issues/yo-self-async-await-struct-result-eval.md). Instead: at io.async,
        // record the closure's CONCRETE result (read from the func_id side-table,
        // the same eval→codegen bridge the async emitter uses) under the
        // future-output SomeType id (the result is `Impl(Future(T,E))`, a SomeT
        // whose required-trait FutureTraitT carries the output — unwrapped by
        // `_future_output_some_id`); at io.await, refine ONLY this call's OWN
        // result type (the bound variable's type) via that record, so downstream
        // `p.field` / `result.unwrap()` get ExprInfo.
        // `lookup_some_resolved_concrete` has no other evaluator reader.
        if(is_io_async_call(expr), {
          // Freshen the io.async RESULT type per call site — wrapper SomeT id,
          // OUTPUT SomeT id, and BOTH resolution cells (see
          // _freshen_io_async_result). Distinct wrapper ids keep per-call
          // state-machine struct registrations from colliding at codegen
          // (issues/yo-self-multi-async-block-metadata-collision.md); the
          // fresh OUTPUT id + cell make the closure-result registration below
          // and the io.await resolution PER-CALL (previously the preserved
          // shared id cross-poisoned sibling calls — item 7 of
          // issues/yo-self-async-emission-cluster.md).
          ret_type_rt = _freshen_io_async_result(ret_type_rt);
          match(
            _future_output_some_id(ret_type_rt),
            .Some(oid) => match(
              args.get(usize(0)),
              .Some(carg) => match(
                expr_info_table_get(ctx.expr_info_table, ast_expr_id(carg)),
                .Some(cinfo) => match(
                  cinfo.value,
                  .Some(cfv) => match(
                    cfv,
                    .FuncVal(__fvd2, _) => match(
                      get_func_type(__fvd2.*.func_id),
                      .Func({ result : rr }) => if(!(is_some_type(rr)), {
                        register_some_resolved_concrete(oid.clone(), rr.clone());
                      }),
                      _ => ()
                    ),
                    _ => ()
                  ),
                  .None => ()
                ),
                .None => ()
              ),
              .None => ()
            ),
            .None => ()
          );
        });
        if(is_io_await_call(expr), {
          match(
            ret_type_rt,
            .SomeT({ id : tid }) => match(
              lookup_some_resolved_concrete(tid),
              .Some(concrete) => {
                ret_type_rt = concrete;
              },
              .None => ()
            ),
            _ => ()
          );
        });
        out_rt := new_expr_info(call_result_rt.caller_env, ret_type_rt);
        out_rt.value = Option(EvalValue).Some(_call_result_unknown(ret_type_rt, env));
        out_rt.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(call_result_rt.runtime_arg_exprs_in_order);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_rt);
        // Same temp attachment as the method + valueless-callee arms (TS
        // function.ts:2263 attaches for EVERY runtime call). Without it, an
        // io.async call whose callee has a comptime-known Io value (the test
        // runner's batch `io :: __yo_builtin_io` shape) reaches codegen with
        // no variable_name — preregister_async_blocks_in_expr and
        // generate_async_block then each mint a DIFFERENT random fallback
        // name, so the FSM struct typedef the code references is never
        // declared (sys/timer flag-on: `unknown type name
        // 'async_block_yo_id_6035_state_t'`).
        attach_temp_variable_to_expr(expr, true, ctx);
        return(expr);
      }
    ),
    // Callee produced no compile-time value.
    // First try instance-method dispatch for property-access callees
    // (when property_access.yo could not resolve the method).
    // Mirrors the `if (!functionToCall.$?.type)` block in TypeScript's
    // `evaluateFunctionCall` (function.ts lines 265-362).
    .None => {
      method_info_opt0 := _try_find_receiver_method(evaluated_callee, callee_env, ctx);
      // Overload resolution: when the method name has multiple candidate
      // overloads, pick the one whose parameters match the arguments (the first
      // hit may not — e.g. `s.starts_with("-")` must select the `StrPattern`
      // `prefix : str` overload, not the inherent `prefix : Self`=String one).
      method_info_opt := match(
        method_info_opt0,
        .Some(mi0) => cond(
          (mi0.all_hits.len() > usize(1)) => Option(ReceiverMethodResult).Some(_select_matching_overload(mi0, args, evaluated_callee, callee_env, ctx)),
          true => Option(ReceiverMethodResult).Some(mi0)
        ),
        .None => Option(ReceiverMethodResult).None
      );
      match(
        method_info_opt,
        // Method found: build the arg list and call it. Instance methods
        // prepend the receiver (`[receiver, ...args]`); static methods
        // (receiver value is a TypeValue, e.g. `HashMap(K,V).new()`) take no
        // implicit receiver arg (`[...args]`). Mirrors TS function.ts:301/319.
        .Some(method_info) => {
          // Record the resolved method's Func type in the non-destructive
          // method-callee side-table (keyed by this call's expr id) BEFORE the
          // call is processed — the call may throw/be swallowed at def-time, but
          // the flowability R3 check still needs the callee type to verify a
          // ref/slice-returning method call rooted in a `ref` param. Mirrors TS
          // reading `call.func.$.type`; writing it into the `.`/2 callee node's
          // ExprInfo instead is destructive (regressed std 151→15).
          record_method_callee_type(ast_expr_id(expr), method_info.method_ty);
          all_args := ArrayList(AstExpr).new();
          if(!(method_info.is_static), {
            // When the method's self param is `*(T)` and the receiver is a
            // compatible value, wrap the receiver in `&(...)` so the self
            // argument type-checks (and codegen inserts the address-of).
            // Mirrors TS function.ts:332-358 building `&(receiverArg)`.
            if(method_info.needs_pointer_conversion, {
              recv_tok := ast_expr_token(method_info.receiver_expr);
              amp_atom := AstExpr.Atom(
                alloc_global_expr_id(),
                Token(
                  kind : TokenKind.Identifier,
                  value : String.from("&"),
                  row : recv_tok.row,
                  column : recv_tok.column,
                  character : recv_tok.character,
                  module_path : recv_tok.module_path.clone(),
                  input : recv_tok.input.clone()
                )
              );
              amp_args := ArrayList(AstExpr).new();
              amp_args.push(method_info.receiver_expr);
              all_args.push(AstExpr.FnCall(alloc_global_expr_id(), amp_atom, amp_args, false, recv_tok));
            }, {
              all_args.push(method_info.receiver_expr);
            });
          });
          (ai : usize) = usize(0);
          while(ai < args.len(), {
            match(
              args.get(ai),
              .Some(a) => {
                all_args.push(a);
              },
              .None => ()
            );
            ai = (ai + usize(1));
          });
          call_result_m := try_to_call_function_with_arguments(
            method_info.method_val_opt,
            method_info.method_ty,
            expr,
            evaluated_callee,
            all_args,
            callee_env,
            ctx,
            true,
            false,
            false,
            exn
          );
          // Record the resolved/specialized method FuncVal in the non-destructive
          // method-callee VALUE side-table (keyed by this call's expr id) so
          // codegen's method-call dispatch can recover it — the callee dot-access
          // has no ExprInfo. Prefer the specialized FuncVal (concrete monomorphized
          // body); fall back to the resolved generic method value.
          match(
            call_result_m.specialized_function_value,
            .Some(sfv) => record_method_callee_value(ast_expr_id(expr), sfv),
            .None => match(
              method_info.method_val_opt,
              .Some(mv) => record_method_callee_value(ast_expr_id(expr), mv),
              .None => ()
            )
          );
          // CTFE-execute comptime-returning methods. `try_to_call...`
          // resolves the return TYPE but never runs the body
          // (return_value is always None), and the default below fabricates
          // an UnknownVal — fine for runtime-returning methods (e.g. derived
          // `==` on a runtime receiver), but a comptime method like
          // `TypeInfo.is_struct` (`-> comptime(bool)`) needs its concrete
          // VALUE (the derive machinery asserts on it). The inline FuncVal
          // arm and the operator-dispatch block already route comptime calls
          // through `evaluate_comptime_fn_call`; this is the `.method()` arm
          // doing the same. Gated on a comptime return so runtime methods
          // keep the cheap path. `evaluate_comptime_fn_call` itself returns
          // an UnknownVal (without executing) when any arg is unknown, so a
          // runtime receiver is handled safely.
          m_ret_ty := match(method_info.method_ty,.Func({ result : _mrb }) => _mrb, _ => t_unit());
          m_is_comptime := match(method_info.method_ty,.Func({ meta : __fm9 }) => __fm9.*.result_is_comptime_only, _ => false);
          (m_result_val : Option(EvalValue)) = if(is_type_hierarchy_type(m_ret_ty) || m_is_comptime, {
            m_self_ty_saved := ctx.self_type;
            match(
              _static_dot_receiver_self_type(func_expr, ctx),
              .Some(m_st) => {
                ctx.self_type = Option(TypeValue).Some(m_st);
              },
              .None => ()
            );
            m_fv := match(method_info.method_val_opt,.Some(v) => v,.None => EvalValue.UnitVal);
            // Restore the self arg's concrete value for the CTFE. `try_to_call`
            // binds comptime params to UNKNOWNS in its type-checking pass, so
            // an instance method with `comptime(self)` (e.g. ComptimeList.len)
            // reaches here with `arg_values.args[0].value` unknown — and
            // `evaluate_comptime_fn_call` refuses to execute when ANY arg is
            // unknown, so the mapper body never folds. The receiver's concrete
            // value was captured at resolution time on `ReceiverMethodResult`
            // (see the field comment); patch it back in (ArgEntry is a ref —
            // in-place) so both the unknown-arg gate and the m_env param
            // binding below see it. Skip static calls (args[0] is not self)
            // and pointer-converted receivers (the arg is `&(recv)`, not the
            // bare value). TS parity: TS arg values survive its checking pass.
            if(!(method_info.is_static) && !(method_info.needs_pointer_conversion), {
              match(
                method_info.receiver_value,
                .Some(rcv_val) => if(!(is_unknown_val(rcv_val)), {
                  match(
                    call_result_m.arg_values.args.get(usize(0)),
                    .Some(self_ae) => {
                      self_needs_value := match(self_ae.value,.Some(sv) => is_unknown_val(sv),.None => true);
                      if(self_needs_value, {
                        self_ae.value = Option(EvalValue).Some(rcv_val);
                      });
                    },
                    .None => ()
                  );
                }),
                .None => ()
              );
            });
            // Build a body env binding the method's CAPTURES + its params to
            // the CONCRETE evaluated arg values. `try_to_call`'s callee_env
            // binds comptime params to UNKNOWNS (it is a type-checking pass,
            // not execution), so passing it to the CTFE would leave `self`
            // unknown in the body. Mirror the inline FuncVal arm, which binds
            // params to `arg_info.value` in a fresh env before CTFE.
            m_env := Environment.new(call_result_m.callee_env.module_path);
            match(
              m_fv,
              .FuncVal(__fvm5, m_cvals) => {
                m_pnames := __fvm5.*.params;
                m_cnames := __fvm5.*.cap_names;
                m_ctys := __fvm5.*.cap_tys;
                (mci : usize) = usize(0);
                while(mci < m_cnames.len(), {
                  mcn := match(m_cnames.get(mci),.Some(n) => n,.None => String.from(""));
                  mct := match(m_ctys.get(mci),.Some(t) => t,.None => t_unit());
                  mcv := match(m_cvals.get(mci),.Some(v) => Option(EvalValue).Some(v),.None => Option(EvalValue).None);
                  _mac := add_variable_to_env(m_env, mcn, mct, mcv, match(mcv,.Some(_) => true,.None => false), false, false, false, synthetic_token(mcn, m_env.module_path));
                  mci = (mci + usize(1));
                });
                _mfr := m_env.push_frame(false);
                (mpi : usize) = usize(0);
                while(mpi < m_pnames.len(), {
                  mpn := match(m_pnames.get(mpi),.Some(n) => n,.None => String.from(""));
                  ma := match(call_result_m.arg_values.args.get(mpi),.Some(e) => e,.None => ArgEntry(value : Option(EvalValue).None, parameter_type : t_unit(), arg_type : t_unit()));
                  _map := add_variable_to_env(m_env, mpn, ma.arg_type, ma.value, match(ma.value,.Some(_) => true,.None => false), false, false, false, synthetic_token(mpn, m_env.module_path));
                  mpi = (mpi + usize(1));
                });
              },
              _ => ()
            );
            m_ctfe := evaluate_comptime_fn_call(
              Option(AstExpr).Some(evaluated_callee),
              method_info.method_ty,
              m_fv,
              call_result_m.arg_values,
              call_result_m.caller_env,
              m_env,
              ctx,
              exn
            );
            ctx.self_type = m_self_ty_saved;
            Option(EvalValue).Some(m_ctfe.value)
          }, Option(EvalValue).Some(_call_result_unknown(call_result_m.return_type, callee_env)));
          // Gap-6 attempt #8(a), method-dispatch arm: THE stamping that types
          // chained method results (`...prepend(3)` → the := RHS). Adopt the
          // call's concrete receiver instance over a pattern-era declared-Self
          // return, mirroring the runtime/CTFE arms.
          (m_out_ty : TypeValue) = call_result_m.return_type;
          m_recv_self := match(
            _static_dot_receiver_self_type(func_expr, ctx),
            .Some(m_rst) => Option(TypeValue).Some(m_rst),
            .None => _instance_dot_receiver_self_type(func_expr, ctx)
          );
          match(
            m_recv_self,
            .Some(m_recv) => match(
              adopt_receiver_struct_instance(m_out_ty, m_recv),
              .Some(m_adopted) => {
                m_out_ty = m_adopted;
              },
              .None => ()
            ),
            .None => ()
          );
          out_m := new_expr_info(call_result_m.caller_env, m_out_ty);
          out_m.value = m_result_val;
          out_m.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(call_result_m.runtime_arg_exprs_in_order);
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_m);
          // Attach the call-result temp (TS function.ts:2263 does this for
          // EVERY runtime call, methods included). Without it a method call's
          // result has no variable_name, so codegen's effect-unwind check has
          // no statement position to wrap — `p.get_program(exn)` emitted with
          // NO escape check and a swallowed throw crashed the stage-2 binary
          // (issues/yo-self-stage2-unwind-check-coverage.md).
          attach_temp_variable_to_expr(expr, true, ctx);
          return(expr);
        },
        // No method found: evaluate args via try_to_call_function_with_arguments.
        // Mirrors TypeScript's isFunctionType path when functionToCall.value == undefined.
        .None => {
          callee_ty_none := match(
            callee_info_opt,
            .Some(ci) => ci.ty,
            .None => t_unit()
          );
          // plans/SLICE_REWORK.md Part C: range indexing on a runtime receiver
          // rewrites to slice_copy / slice_copy_inclusive method dispatch.
          match(
            _try_rewrite_range_index_to_slice_copy(expr, func_expr, args, callee_ty_none, callee_env),
            .Some(rewritten) => {
              return(recur(rewritten, env, t_unit(), Option(EvalValue).None, ctx, exn));
            },
            .None => ()
          );
          // Index-trait dispatch — mirrors TS `function.ts:1392-1411`: a
          // value-call `x(i)` whose callee type is Array or has an
          // Index impl routes through the Index trait. This is the path for
          // UNKNOWN receivers under def-time body evaluation (concrete
          // comptime indexing resolves earlier); without it, `s.bytes(i)` /
          // `data(i)` on unknown values soft-fell to `unit` and poisoned
          // every expression built on the element.
          if(is_array_type(callee_ty_none)
          || has_index_impl(callee_ty_none, args, callee_env, ctx), {
            idx_result := try_to_call_with_index_trait(
              expr,
              callee_ty_none,
              callee_value,
              args,
              callee_env,
              ctx,
              exn
            );
            out_idx := new_expr_info(idx_result.caller_env, idx_result.ty);
            out_idx.value = idx_result.value;
            // Record the index method's `*(T)` so the ref-argument place
            // gate recognizes `xs(i)` as a buffer pointer (TS function.ts:2788).
            out_idx.index_trait_ptr_type = Option(TypeValue).Some(idx_result.ptr_type);
            // Also record the specialized index() method type + value so codegen
            // can emit `*index_fn(&recv, i)` (generation.yo's index-trait branch).
            // Mirrors TS function.ts:2790-2791.
            out_idx.index_method_type = match(idx_result.index_method_type,.Some(imt) => Option(TypeValue).Some(imt),.None => Option(TypeValue).None);
            out_idx.index_method_value = idx_result.index_method_value;
            // ComptimeIndex place-reference — see the FuncVal-callee index arm
            // above (TS function.ts:2820).
            out_idx.comptime_ref = idx_result.comptime_ref;
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_idx);
            // Attach a NON-owning temp (TS function.ts:2810) — see the
            // FuncVal-callee index arm above for the full rationale.
            attach_temp_variable_to_expr(expr, false, ctx);
            return(expr);
          });
          // Per-call whole-callee freshening for io.async — see
          // _freshen_io_builtin_callee.
          (callee_ty_call_none : TypeValue) = callee_ty_none;
          if(is_io_async_call(expr), {
            callee_ty_call_none = _freshen_io_builtin_callee(callee_ty_call_none);
          });
          call_result_none := try_to_call_function_with_arguments(
            Option(EvalValue).None,
            callee_ty_call_none,
            expr,
            func_expr,
            args,
            callee_env,
            ctx,
            false,
            false,
            false,
            exn
          );
          (ret_type_none : TypeValue) = call_result_none.return_type;
          // io.async / io.await result-type refinement — SAME logic as the
          // FuncVal-callee branch above. This VALUELESS-callee path runs when
          // the receiver is a runtime param with no compile-time value (def-time
          // body eval binds params valueless, TS function-type.ts:346), so the
          // Io struct field yields no FuncVal. TS keys the equivalent handling
          // on functionType.ioBuiltin (type-carried, value-independent —
          // helper.ts:379/1314); yo-self keys on the call SHAPE, which is
          // equally value-independent, so the refinement must run here too.
          if(is_io_async_call(expr), {
            // Same per-call freshening + registration order as the FuncVal-
            // callee branch above (fresh output id + cell FIRST, then register
            // the closure's concrete result under the fresh id).
            ret_type_none = _freshen_io_async_result(ret_type_none);
            match(
              _future_output_some_id(ret_type_none),
              .Some(oid_n) => match(
                args.get(usize(0)),
                .Some(carg_n) => match(
                  expr_info_table_get(ctx.expr_info_table, ast_expr_id(carg_n)),
                  .Some(cinfo_n) => match(
                    cinfo_n.value,
                    .Some(cfv_n) => match(
                      cfv_n,
                      .FuncVal(__fvdn, _) => match(
                        get_func_type(__fvdn.*.func_id),
                        .Func({ result : rr_n }) => if(!(is_some_type(rr_n)), {
                          register_some_resolved_concrete(oid_n.clone(), rr_n.clone());
                        }),
                        _ => ()
                      ),
                      _ => ()
                    ),
                    .None => ()
                  ),
                  .None => ()
                ),
                .None => ()
              ),
              .None => ()
            );
          });
          if(is_io_await_call(expr), {
            match(
              ret_type_none,
              .SomeT({ id : tid_n }) => match(
                lookup_some_resolved_concrete(tid_n),
                .Some(concrete_n) => {
                  ret_type_none = concrete_n;
                },
                .None => ()
              ),
              _ => ()
            );
          });
          out_none := new_expr_info(call_result_none.caller_env, ret_type_none);
          out_none.value = Option(EvalValue).Some(_call_result_unknown(ret_type_none, callee_env));
          out_none.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(call_result_none.runtime_arg_exprs_in_order);
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_none);
          // Same temp attachment as the method arm (TS function.ts:2263).
          attach_temp_variable_to_expr(expr, true, ctx);
          return(expr);
        }
      )
    }
  )
});
export(evaluate_function_call);
export(MACRO_DISPATCH_ENABLED);
