          mac_old_validating := ctx.is_validating_function_definition;
          mac_old_analyzing := ctx.is_analyzing_ctfe_capability;
          mac_old_executing := ctx.is_executing;
          if(fv_is_macro, {
            ctx.is_validating_function_definition = false;
            ctx.is_analyzing_ctfe_capability = false;
            ctx.is_executing = true;
          });
          ct_result := evaluate_comptime_fn_call(
            Option(AstExpr).Some(func_expr),
            ct_func_type,
            ct_func_value,
            ct_arg_values,
            env,
            fresh_env,
            ctx,
            exn
          );
          if(fv_is_macro, {
            ctx.is_validating_function_definition = mac_old_validating;
            ctx.is_analyzing_ctfe_capability = mac_old_analyzing;
            ctx.is_executing = mac_old_executing;
          });
