        // Build the call's ExprInfo, consuming the Return control flow.
        out := new_expr_info(env, ret_type);
        out.value = body_info.value;
        // Runtime arg exprs for codegen (the call's C-argument materialization).
        out.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_arg_exprs);
        // control_flow is intentionally NOT propagated (Return is consumed here).
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
        // Temp variable for the (non-unit) call result (mirrors TS
        // attachTempVariableToExpr on the body-executed call path).
        attach_temp_variable_to_expr(expr, true, ctx);
        param_vars;
        expr
      },
      // ------------------------------------------------------------------
      // Fallthrough: UnknownVal or other EvalValue shape — treat as a
      // runtime function reference and call through try_to_call_function_with_arguments.
      // Mirrors TypeScript's handling when functionToCallValue is some
      // non-TypeValue, non-FunctionValue shape (e.g., UnknownValue).
      // ------------------------------------------------------------------
      _ => {
        // Extract the callee's type from the ExprInfo.
        callee_ty := match(
          callee_info_opt,
          .Some(ci) => ci.ty,
          .None => t_unit()
        );
        // plans/SLICE_REWORK.md Part C: range indexing on a runtime receiver
        // rewrites to slice_copy / slice_copy_inclusive method dispatch.
        match(
          _try_rewrite_range_index_to_slice_copy(expr, func_expr, args, callee_ty, callee_env),
          .Some(rewritten) => {
            return(recur(rewritten, env, t_unit(), Option(EvalValue).None, ctx, exn));
          },
          .None => ()
