      },
      .FuncVal(__fvm7, cap_vals) => {
        forall_names := __fvm7.*.forall_names;
        param_names := __fvm7.*.params;
        param_type_names := __fvm7.*.param_type_names;
        evidence_names := __fvm7.*.evidence_params;
        body_box := __fvm7.*.body;
        cap_names := __fvm7.*.cap_names;
        cap_tys := __fvm7.*.cap_tys;
        func_id_fv := __fvm7.*.func_id;
        n_p := param_names.len();
        n_ev := evidence_names.len();
        (n_a : usize) = args.len();
