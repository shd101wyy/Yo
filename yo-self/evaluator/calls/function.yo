              exn.throw(
                dyn(
                  format_error_message(
                    tok,
                    `Partial application: expected ${pa_pt.len()} argument(s), got ${n_a}`,
                    false,
                    .None
                  )
                )
              );
            });
            pa_id := alloc_global_expr_id().to_string();
            pa_orig_name := `__pa_fn_${pa_id}`;
            pa_cap_names := ArrayList(String).new();
            pa_cap_tys := ArrayList(TypeValue).new();
            pa_cap_vals := ArrayList(EvalValue).new();
            pa_cap_names.push(pa_orig_name.clone());
            pa_cap_tys.push(pa_fty.clone());
            pa_cap_vals.push(cv);
            pa_new_labels := ArrayList(String).new();
            pa_new_types := ArrayList(TypeValue).new();
            pa_new_ct := ArrayList(bool).new();
            pa_new_flags := ArrayList(bool).new();
            pa_new_own := ArrayList(bool).new();
            pa_ptn := ArrayList(String).new();
            pa_body_args := ArrayList(AstExpr).new();
            pa_orig_ct := get_func_param_comptime(func_id_fv.clone());
            (pa_i2 : usize) = usize(0);
