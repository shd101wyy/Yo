        ctx.is_evaluating_function_body_or_async_block = Option(FuncOrAsyncBlockCtx).Some(fn_ctx);
        ctx.enclosing_function_return_type = Option(TypeValue).Some(ret_type);
        // For a static method call (`Type.method()`), bind `ctx.self_type` to
        // the receiver type so `Self` references inside the body resolve to the
        // concrete receiver (e.g. `Self._alloc_with_capacity(...)` inside
        // `HashMap(String,X).new()`). Cascades to nested `Self.method()` calls.
        old_self_ty_fv := ctx.self_type;
        match(
          _static_dot_receiver_self_type(func_expr, ctx),
          .Some(st_fv) => {
            ctx.self_type = Option(TypeValue).Some(st_fv);
          },
          .None => ()
        );
        // Propagate the declared return type as the body's expected type, so the
        // body's tail expression (a `match`, `cond`, etc.) can infer enum-variant
        // shorthands like `.Err(...)` / `.None` against the return enum. `begin`
        // forwards this to the last expression only; `match` forwards it to its
        // arms. Mirrors TS evaluating the body with `expectedType = returnType`.
        old_expected_fv := ctx.expected_type;
        ctx.expected_type = Option(ExpectedTypeCtx).Some(
          ExpectedTypeCtx(ty : ret_type, env : fresh_env)
        );
        // Evaluate the function body.
        evaled_body := evaluate_begin_expression(
          body_box,
          fresh_env,
          ctx,
          ArrayList(Variable).new(),
          true,
          exn
        );
        ctx.expected_type = old_expected_fv;
        ctx.self_type = old_self_ty_fv;
        ctx.is_evaluating_function_body_or_async_block = old_fn_ctx;
        ctx.enclosing_function_return_type = old_ret_ty;
        body_info := match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_body)),
          .Some(i) => i,
          .None => new_expr_info(env, ret_type)
