              func_expr,
              env,
              fresh_env,
              ctx,
              ret_type,
              callee_func_type_opt,
              cv,
              func_id_fv.clone(),
              forall_names,
              fa_bound_names,
              fa_bound_types,
              runtime_arg_exprs,
              evaled_arg_infos,
              n_supplied_reg,
              param_vars,
              exn
