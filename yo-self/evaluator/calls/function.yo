                // (generation.yo reads ei.macro_expansion) and the collection pass
                // generate/walk the EXPANDED tree (e.g. `if(c, then, else)` → its
                // `cond(...)`) instead of the raw, un-emittable macro-call FnCall.
                // Use a FRESH info — exp_info IS the expansion's own info, so a
                // self-referential macro_expansion would recurse forever; copy the
                // begin-block-relevant fields (value / control_flow / variable_name)
                // so statement sequencing + early-return detection still work.
                call_macro_info := new_expr_info(exp_info.env, exp_info.ty);
                call_macro_info.value = exp_info.value;
                call_macro_info.control_flow = exp_info.control_flow;
                call_macro_info.variable_name = exp_info.variable_name;
                call_macro_info.macro_expansion = Option(AstExpr).Some(expanded_expr);
                expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), call_macro_info);
                // Durably record the expansion keyed by call id: the per-pass
                // ExprInfo above can be overwritten by a later eval of the same
                // call WITHOUT macro_expansion (e.g. `if(...recur...)`), leaving
                // codegen with `None`. Codegen falls back to this side-table.
                record_macro_expansion(ast_expr_id(expr), expanded_expr);
                param_vars;
                return(expr);
              },
              _ => {
                exn.throw(
                  dyn(
                    format_error_message(
                      tok,
                      String.from("Expected macro function to return an Expr value."),
                      false,
                      .None
                    )
                  )
                );
              }
            );
          });
          // A `comptime(Self)`-returning generic Array impl method (e.g.
          // `Array.fill : (fn(...) -> comptime(Self))` under `impl(forall(T, U),
          // Array(T, U), ...)`) yields a declared return type whose Array
          // `length_var` (`U`) is unresolved — `Self` was expanded to the impl
          // pattern `Array(T, U)` (with `T` substituted) but the const-generic
          // length `U` is bound to no SomeT, so it survives as the malformed
          // `Array(u8, length=0, length_var="U")`. Codegen then rejects it as
