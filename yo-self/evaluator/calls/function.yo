        // rely on — verified: yo-self 53->57, std 150->151, tests 154->155, 0
        // regressions across 560 files.
        if((!(is_type_hierarchy_type(ret_type))) && (!(callee_result_is_comptime)), {
          return(
            _evaluate_funcval_runtime_call(
              expr,
              func_expr,
              env,
              fresh_env,
              ctx,
              ret_type,
              callee_func_type_opt,
              cv,
              func_id_fv.clone(),
              forall_names,
              fa_bound_names,
              fa_bound_types,
              runtime_arg_exprs,
              evaled_arg_infos,
              n_supplied_reg,
              param_vars,
              exn
            )
          );
        });
        old_fn_ctx := ctx.is_evaluating_function_body_or_async_block;
        old_ret_ty := ctx.enclosing_function_return_type;
        fn_ctx := FuncOrAsyncBlockCtx(
          kind :.FunctionBody,
          func_type : callee_func_type_opt,
          func_value : callee_value,
          eval_env : fresh_env
