          // return type's Array length-vars structurally against the concrete
          // receiver. (`ctx.self_type` was reset after the CTFE body eval, so
          // re-fetch the receiver type directly.)
          resolved_ret_ct := match(
            _static_dot_receiver_self_type(func_expr, ctx),
            .Some(recv_self) => _resolve_array_length_vars_from_self(ret_type, recv_self),
            .None => ret_type
