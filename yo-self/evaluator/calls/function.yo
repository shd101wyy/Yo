        // `f(generic(i32), _)` must still see the raw argument count.
        (fv_args : ArrayList(AstExpr)) = args;
        fv_pre_forall_names := ArrayList(String).new();
        fv_pre_forall_vals := ArrayList(EvalValue).new();
        fv_pre_forall_tys := ArrayList(TypeValue).new();
        (fv_forall_arg_exprs : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
        if(match(args.get(usize(0)),.Some(a0) => ast_expr_is_fn_call_of(a0, "generic", Option(usize).None),.None => false), {
          fv_g_node := match(args.get(usize(0)),.Some(a0) => a0,.None => make_err_expr());
          fv_g_args := match(fv_g_node,.FnCall(_, _, g_as, _, _) => g_as,.Atom(_, _) => ArrayList(AstExpr).new());
          fv_forall_arg_exprs = Option(ArrayList(AstExpr)).Some(fv_g_args);
