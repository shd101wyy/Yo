//! evaluator/calls/type — stub for try_to_call_type_with_arguments.
//!
//! Phase 2x stub. Full implementation planned for Phase 3.
//! 1:1 port of `src/evaluator/calls/type.ts`.
//!
//! `try_to_call_type_with_arguments` handles struct/enum/union type constructor
//! calls, binding positional or labelled argument expressions to the type's fields
//! and returning the annotated call expression.

open import "std/string";
{ ArrayList }                              :: import "std/collections/array_list";

{ AstExpr, ast_expr_token, make_err_expr } :: import "../../expr/expr.yo";
{ Environment }                            :: import "../../env/env.yo";
{ TypeValue }                              :: import "../../types/type.yo";
{ EvalContext }                            :: import "../context.yo";
{ format_error_message }                   :: import "../../error/error.yo";
{ Exception }                              :: import "std/error";

/// Call a struct/enum/union type constructor with `arg_exprs`, binding fields.
///
/// `type_fields`  — the field descriptors for the target type (labels + types).
/// `is_union_type` — when `true`, exactly one argument is expected.
///
/// Phase 2x stub: throws "not yet implemented". Full implementation in Phase 3.
///
/// Mirrors `tryToCallTypeWithArguments` in `src/evaluator/calls/type.ts`.
try_to_call_type_with_arguments :: (fn(
  type_fields           : ArrayList(TypeValue),
  function_callee_expr  : AstExpr,
  arg_exprs             : ArrayList(AstExpr),
  caller_env            : Environment,
  ctx                   : *(EvalContext),
  is_union_type         : bool,
  using(exn             : Exception)
) -> Option(AstExpr))({
  _ := type_fields;
  _ := arg_exprs;
  _ := caller_env;
  _ := ctx;
  _ := is_union_type;
  exn.throw(dyn format_error_message(
    ast_expr_token(function_callee_expr),
    String.from("try_to_call_type_with_arguments: not yet implemented (Phase 3)"),
    false,
    .None
  ));
  Option(AstExpr).None
});

export try_to_call_type_with_arguments;
