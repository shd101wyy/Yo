//! evaluator/calls/array_type — stub for try_to_implement_array_by_array_type.
//!
//! Phase 2x stub. Full implementation planned for Phase 3.
//! 1:1 port of `src/evaluator/calls/array-type.ts`.
//!
//! `try_to_implement_array_by_array_type` creates an array value from an
//! ArrayType and a list of initial-value arguments,  e.g.:
//!
//!   ArrayType :: Array(i32, 3);
//!   arr := ArrayType(1, 2, 3);

open import "std/string";
{ ArrayList }                              :: import "std/collections/array_list";

{ AstExpr, ast_expr_token, make_err_expr } :: import "../../expr/expr.yo";
{ Environment }                            :: import "../../env/env.yo";
{ TypeValue }                              :: import "../../types/type.yo";
{ EvalContext }                            :: import "../context.yo";
{ format_error_message }                   :: import "../../error/error.yo";
{ Exception }                              :: import "std/error";

/// Construct an array value from `array_type` and the provided `arg_exprs`.
///
/// Phase 2x stub: throws "not yet implemented". Full implementation in Phase 3.
///
/// Mirrors `tryToImplementArrayByArrayType` in `src/evaluator/calls/array-type.ts`.
try_to_implement_array_by_array_type :: (fn(
  expr       : AstExpr,
  array_type : TypeValue,
  arg_exprs  : ArrayList(AstExpr),
  caller_env : Environment,
  ctx        : *(EvalContext),
  using(exn  : Exception)
) -> Option(AstExpr))({
  _ := array_type;
  _ := arg_exprs;
  _ := caller_env;
  _ := ctx;
  exn.throw(dyn format_error_message(
    ast_expr_token(expr),
    String.from("try_to_implement_array_by_array_type: not yet implemented (Phase 3)"),
    false,
    .None
  ));
  Option(AstExpr).None
});

export try_to_implement_array_by_array_type;
