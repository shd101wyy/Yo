//! evaluator/calls/function_type — function-type call handlers.
//!
//! Phase 2bm — partial implementation.
//! 1:1 port of `src/evaluator/calls/function-type.ts`.
//!
//! Exports:
//!   `check_deferred_generic_return_type`      — trial-evaluates a generic function body
//!                                               to catch return-type mismatches at definition time.
//!   `create_function_body_evaluation_context` — builds a fresh EvalContext for function body eval.
//!   `try_to_implement_function_by_function_type` — registers a function body against a function type,
//!                                               creating a `FuncVal`.
//!
//! Phase 2bm / Phase 3c status:
//!   - `try_to_implement_function_by_function_type`: IMPLEMENTED (simplified).
//!     Creates a `FuncVal` from the function type + body. Body evaluation at
//!     definition time is deferred (only done at call time). This means early
//!     return-type mismatches are not caught at definition time.
//!   - `check_deferred_generic_return_type`: no-op stub (deferred to Phase 3).
//!   - `create_function_body_evaluation_context`: IMPLEMENTED (Phase 3c).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ TypeValue, t_unit } :: import("../../types/type.yo");
{ EvalValue } :: import("../../value.yo");
{
  EvalContext,
  FuncOrAsyncBlockCtx,
  FuncOrAsyncBlockKind,
  LoopBodyCtx,
  ExpectedTypeCtx,
  CapturedVarInfo,
  ImplConcreteTypeInfo
} :: import("../context.yo");
{ random_id } :: import("../utils.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
/// Check if a generic function body returns a type incompatible with the
/// declared generic return type.
///
/// Phase 2bm: no-op stub. Full trial-evaluation deferred to Phase 3.
///
/// Mirrors `checkDeferredGenericReturnType` in `src/evaluator/calls/function-type.ts`.
check_deferred_generic_return_type :: (
  fn(
    function_body_expr : AstExpr,
    function_type : TypeValue,
    function_value : EvalValue,
    env : Environment,
    ctx : *(EvalContext),
    using(exn : Exception)
  ) -> unit
)({
  _ := function_body_expr;
  _ := function_type;
  _ := function_value;
  _ := env;
  _ := ctx;
  ()
});
/// Creates a fresh evaluation context for function body evaluation.
///
/// Mirrors `createFunctionBodyEvaluationContext` in `src/evaluator/calls/function-type.ts`.
///
/// In TypeScript the function returns `{ evaluationContext, functionBodyContext }`.
/// In Yo, `functionBodyContext` is embedded inside the returned `EvalContext` as
/// `is_evaluating_function_body_or_async_block`, so we return just `EvalContext`.
///
/// Phase 3c: IMPLEMENTED.
create_function_body_evaluation_context :: (
  fn(
    function_type : TypeValue,
    function_value : EvalValue,
    env : Environment,
    ctx : *(EvalContext)
  ) -> EvalContext
)({
  // Build the FuncOrAsyncBlockCtx (FunctionEvaluationContext in TypeScript).
  func_body_ctx := FuncOrAsyncBlockCtx(
    kind : FuncOrAsyncBlockKind.FunctionBody,
    func_type : Option(TypeValue).Some(function_type),
    func_value : Option(EvalValue).Some(function_value),
    eval_env : env
  );
  // Compute enclosing function's return type.
  // If the parent is a function body, the enclosing return type is its return type.
  // If the parent is a test/async block, the enclosing return type is unit.
  enclosing_return_type := match(
    ctx.is_evaluating_function_body_or_async_block,
    .None => Option(TypeValue).None,
    .Some(block) => match(
      block.kind,
      .FunctionBody => match(
        block.func_type,
        .Some(ft) => match(
          ft,
          .Func(result : ret_box) => Option(TypeValue).Some(ret_box.*),
          _ => Option(TypeValue).None
        ),
        .None => Option(TypeValue).None
      ),
      _ => Option(TypeValue).Some(t_unit())
    )
  );
  // Extract the return type from function_type for expected_type.
  return_type := match(
    function_type,
    .Func(result : ret_box) => ret_box.*,
    _ => t_unit()
  );
  // Build the new EvalContext with overrides (mirrors `{ ...context, overrides }` in TS).
  EvalContext(
    // Overridden fields
    is_executing : false,
    is_validating_function_definition : true,
    expected_type : Option(ExpectedTypeCtx).Some(
      ExpectedTypeCtx(ty : return_type, env : env)
    ),
    is_evaluating_function_body_or_async_block : Option(FuncOrAsyncBlockCtx).Some(func_body_ctx),
    is_evaluating_function_type : false,
    is_evaluating_loop_body : Option(LoopBodyCtx).None,
    captured_variables : Option(HashMap(String, CapturedVarInfo)).Some(
      HashMap(String, CapturedVarInfo).new()
    ),
    own_consumed_captures : Option(HashSet(String)).Some(HashSet(String).new()),
    function_return_impl_concrete_type : Option(ArrayList(ImplConcreteTypeInfo)).Some(
      ArrayList(ImplConcreteTypeInfo).new()
    ),
    enclosing_function_return_type : enclosing_return_type,
    force_compile_time_bindings : false,
    is_analyzing_ctfe_capability : false,
    // Copied from parent context (mirrors `...context` spread in TS)
    is_inside_impl_block : ctx.is_inside_impl_block,
    self_type : ctx.self_type,
    self_trait_type : ctx.self_trait_type,
    self_module_type : ctx.self_module_type,
    receiver_type : ctx.receiver_type,
    load_module : ctx.load_module,
    std_path : ctx.std_path,
    current_module_path : ctx.current_module_path,
    is_unsafe_function_type : ctx.is_unsafe_function_type,
    has_control_function_implicit_params : ctx.has_control_function_implicit_params,
    is_inside_where_clause : ctx.is_inside_where_clause,
    is_lhs_of_assignment : ctx.is_lhs_of_assignment,
    is_in_function_call_checking_phase : ctx.is_in_function_call_checking_phase,
    is_inside_io_async_call : ctx.is_inside_io_async_call,
    is_inside_given_handler : ctx.is_inside_given_handler,
    is_evaluating_generic_impl_specialization : ctx.is_evaluating_generic_impl_specialization,
    currently_specializing_function : ctx.currently_specializing_function,
    currently_specializing_function_stack : ctx.currently_specializing_function_stack,
    doc_comment_lookup : ctx.doc_comment_lookup,
    // Shared mutable tables — same instance as parent so results are visible
    expr_info_table : ctx.expr_info_table,
    comptime_fn_caches : ctx.comptime_fn_caches,
    specialized_fn_caches : ctx.specialized_fn_caches
  )
});
/// Register a function body expression against a function type, producing a
/// typed `FuncVal`.
///
/// Phase 2bm: simplified implementation.
///
/// - Extracts `forall_labels`, `param_labels`, `implicit_labels`, `result` from
///   `TypeValue.Func`.
/// - Derives `param_type_names` from each param's type: if the type is `SomeT`,
///   uses its `name` (for forall binding at call time); otherwise uses `""`.
/// - Creates `EvalValue.FuncVal` with empty captures (regular functions do not
///   capture outer runtime variables in the 1:1 port).
/// - Body evaluation at definition time is skipped (deferred to call time).
///   This means early return-type mismatches are not caught.
/// - Stores `ExprInfo` in the table and returns the annotated expression.
///
/// Mirrors `tryToImplementFunctionByFunctionType` in `src/evaluator/calls/function-type.ts`.
try_to_implement_function_by_function_type :: (
  fn(
    expr : AstExpr,
    function_type : TypeValue,
    caller_env : Environment,
    ctx : *(EvalContext),
    using(exn : Exception)
  ) -> AstExpr
)(
  match(
    function_type,
    .Func(forall_labels, _, param_labels, param_types, implicit_labels, _, _, _, result_box) => {
      tok := ast_expr_token(expr);
      // Extract the function body from args[0] of the outer call expression.
      args := match(
        expr,
        .FnCall(_, _, a, _, _) => a,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      if(args.len() != usize(1), {
        exn.throw(
          dyn(
            format_error_message(
              tok,
              `Expected 1 argument for function body, got ${args.len()}`,
              false,
              .None
            )
          )
        );
      });
      body_expr := match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
      // Build param_type_names: for each param type, use the SomeT name (for forall
      // binding at call time) if the param type is a generic type variable, else "".
      param_type_names := ArrayList(String).new();
      (pti : usize) = usize(0);
      n_pt := param_types.len();
      while(runtime(pti < n_pt), {
        pt_name := match(
          param_types.get(pti),
          .Some(pt) => match(
            pt,
            .SomeT(_, name, _, _, _, _, _, _, _) => name,
            _ => String.from("")
          ),
          .None => String.from("")
        );
        ___ := param_type_names.push(pt_name);
        pti = (pti + usize(1));
      });
      // Build the FuncVal.  Regular functions (defined with `::`) do not capture
      // outer runtime variables, so cap_names/cap_tys/cap_vals are empty.
      func_val := EvalValue.FuncVal(
        forall_labels,
        param_labels,
        param_type_names,
        implicit_labels,
        box(body_expr),
        ArrayList(String).new(),
        ArrayList(TypeValue).new(),
        ArrayList(EvalValue).new(),
        random_id(caller_env.module_path)
      );
      _ := result_box;
      // Build and store ExprInfo for the function definition expression.
      // The type of a function definition is the function type itself.
      info := new_expr_info(caller_env, function_type);
      info.value = Option(EvalValue).Some(func_val);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
      expr
    },
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("try_to_implement_function_by_function_type: expected Func type"),
            false,
            .None
          )
        )
      );
      make_err_expr()
    }
  )
);
export(check_deferred_generic_return_type);
export(create_function_body_evaluation_context);
export(try_to_implement_function_by_function_type);
