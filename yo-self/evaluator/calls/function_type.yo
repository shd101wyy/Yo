//! evaluator/calls/function_type — function-type call handlers.
//!
//! Phase 2bm — partial implementation.
//! 1:1 port of `src/evaluator/calls/function-type.ts`.
//!
//! Exports:
//!   `check_deferred_generic_return_type`      — trial-evaluates a generic function body
//!                                               to catch return-type mismatches at definition time.
//!   `create_function_body_evaluation_context` — builds a fresh EvalContext for function body eval.
//!   `try_to_implement_function_by_function_type` — registers a function body against a function type,
//!                                               creating a `FuncVal`.
//!
//! Phase 2bm / Phase 3c status:
//!   - `try_to_implement_function_by_function_type`: IMPLEMENTED (simplified).
//!     Creates a `FuncVal` from the function type + body. Body evaluation at
//!     definition time is deferred (only done at call time). This means early
//!     return-type mismatches are not caught at definition time.
//!   - `check_deferred_generic_return_type`: no-op stub (deferred to Phase 3).
//!   - `create_function_body_evaluation_context`: IMPLEMENTED (Phase 3c).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr } :: import("../../expr.yo");
{ copy_func_param_defaults, copy_func_param_default_exprs, copy_macro_registration, get_func_variadic_param, copy_func_variadic_param, copy_func_where_constraints } :: import("../types/function.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ Environment, add_variable_to_env, add_parameter_to_env, synthetic_token } :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_some_t, t_ptr } :: import("../../types/creators.yo");
{ is_type_0 } :: import("../../types/guards.yo");
{ EvalValue, FuncValData, create_unknown_val, create_type_value } :: import("../../value.yo");
{ type_contains_some_type_for_codegen_param } :: import("../trait_checking.yo");
{
  is_flowable_expr,
  flow_options_default,
  FlowOptions,
  clear_flow_violation,
  flow_violation_pending,
  flow_violation_message,
  propagate_def_time_errors
} :: import("../../types/flowability.yo");
{ type_to_string } :: import("../../types/string.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ ast_expr_to_string } :: import("../../expr.yo");
{
  EvalContext,
  FuncOrAsyncBlockCtx,
  FuncOrAsyncBlockKind,
  LoopBodyCtx,
  ExpectedTypeCtx,
  CapturedVarInfo,
  ImplConcreteTypeInfo
} :: import("../context.yo");
{ random_id } :: import("../../utils.yo");
{ register_func_type } :: import("../../function_value.yo");
{ get_all_some_types, type_representation_contains_raw_ptr } :: import("../../types/utils.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
/// Check if a generic function body returns a type incompatible with the
/// declared generic return type.
///
/// Phase 2bm: no-op stub. Full trial-evaluation deferred to Phase 3.
///
/// Mirrors `checkDeferredGenericReturnType` in `src/evaluator/calls/function-type.ts`.
check_deferred_generic_return_type :: (
  fn(
    function_body_expr : AstExpr,
    function_type : TypeValue,
    function_value : EvalValue,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  _ := function_body_expr;
  _ := function_type;
  _ := function_value;
  _ := env;
  _ := ctx;
  ()
});
/// Creates a fresh evaluation context for function body evaluation.
///
/// Mirrors `createFunctionBodyEvaluationContext` in `src/evaluator/calls/function-type.ts`.
///
/// In TypeScript the function returns `{ evaluationContext, functionBodyContext }`.
/// In Yo, `functionBodyContext` is embedded inside the returned `EvalContext` as
/// `is_evaluating_function_body_or_async_block`, so we return just `EvalContext`.
///
/// Phase 3c: IMPLEMENTED.
create_function_body_evaluation_context :: (
  fn(
    function_type : TypeValue,
    function_value : EvalValue,
    env : Environment,
    ctx : EvalContext
  ) -> EvalContext
)({
  // Build the FuncOrAsyncBlockCtx (FunctionEvaluationContext in TypeScript).
  func_body_ctx := FuncOrAsyncBlockCtx(
    kind : FuncOrAsyncBlockKind.FunctionBody,
    func_type : Option(TypeValue).Some(function_type),
    func_value : Option(EvalValue).Some(function_value),
    eval_env : env
  );
  // Compute enclosing function's return type.
  // If the parent is a function body, the enclosing return type is its return type.
  // If the parent is a test/async block, the enclosing return type is unit.
  enclosing_return_type := match(
    ctx.is_evaluating_function_body_or_async_block,
    .None => Option(TypeValue).None,
    .Some(block) => match(
      block.kind,
      .FunctionBody => match(
        block.func_type,
        .Some(ft) => match(
          ft,
          .Func({ result : ret_box }) => Option(TypeValue).Some(ret_box.*),
          _ => Option(TypeValue).None
        ),
        .None => Option(TypeValue).None
      ),
      _ => Option(TypeValue).Some(t_unit())
    )
  );
  // Extract the return type from function_type for expected_type.
  // For `-> inout(T)` functions the body produces a place expression
  // (`*(T)` at the C ABI) — set the body's expected type to `*(T)` so
  // unification across `match`/`cond` arms agrees on the pointer shape
  // (e.g. `match(opt, .Some(b) => &(b(i)), .None => panic(...))`).
  // Mirrors TS function-type.ts `bodyExpectedType = return.isRef ?
  // createPtrType(return.type) : return.type`.
  return_type := match(
    function_type,
    .Func({ result : ret_box, meta : __fm1 }) => cond(
      __fm1.*.result_is_ref => t_ptr(ret_box.*),
      true => ret_box.*
    ),
    _ => t_unit()
  );
  // Build the new EvalContext with overrides (mirrors `{ ...context, overrides }` in TS).
  EvalContext(
    // Overridden fields
    is_executing : false,
    is_validating_function_definition : true,
    expected_type : Option(ExpectedTypeCtx).Some(
      ExpectedTypeCtx(ty : return_type, env : env)
    ),
    is_evaluating_function_body_or_async_block : Option(FuncOrAsyncBlockCtx).Some(func_body_ctx),
    is_evaluating_function_type : false,
    is_evaluating_loop_body : Option(LoopBodyCtx).None,
    captured_variables : Option(HashMap(String, CapturedVarInfo)).Some(
      HashMap(String, CapturedVarInfo).new()
    ),
    own_consumed_captures : Option(HashSet(String)).Some(HashSet(String).new()),
    function_return_impl_concrete_type : Option(ArrayList(ImplConcreteTypeInfo)).Some(
      ArrayList(ImplConcreteTypeInfo).new()
    ),
    enclosing_function_return_type : enclosing_return_type,
    force_compile_time_bindings : false,
    is_analyzing_ctfe_capability : false,
    // Copied from parent context (mirrors `...context` spread in TS)
    is_inside_impl_block : ctx.is_inside_impl_block,
    self_type : ctx.self_type,
    self_trait_type : ctx.self_trait_type,
    self_module_type : ctx.self_module_type,
    receiver_type : ctx.receiver_type,
    load_module : ctx.load_module,
    std_path : ctx.std_path,
    current_module_path : ctx.current_module_path,
    is_unsafe_function_type : ctx.is_unsafe_function_type,
    unsafe_context : ctx.unsafe_context,
    is_control_function_type : ctx.is_control_function_type,
    has_control_function_implicit_params : ctx.has_control_function_implicit_params,
    is_inside_where_clause : ctx.is_inside_where_clause,
    is_lhs_of_assignment : ctx.is_lhs_of_assignment,
    is_in_function_call_checking_phase : ctx.is_in_function_call_checking_phase,
    is_inside_io_async_call : ctx.is_inside_io_async_call,
    is_inside_given_handler : ctx.is_inside_given_handler,
    is_evaluating_generic_impl_specialization : ctx.is_evaluating_generic_impl_specialization,
    currently_specializing_function : ctx.currently_specializing_function,
    currently_specializing_function_stack : ctx.currently_specializing_function_stack,
    doc_comment_lookup : ctx.doc_comment_lookup,
    // Shared mutable tables — same instance as parent so results are visible
    expr_info_table : ctx.expr_info_table,
    comptime_fn_caches : ctx.comptime_fn_caches,
    current_impl_trait_field_labels : ctx.current_impl_trait_field_labels,
    current_impl_trait_field_types : ctx.current_impl_trait_field_types,
    specialized_fn_caches : ctx.specialized_fn_caches
  )
});
/// Trial-evaluate a function body at definition time, swallowing any eval
/// error (mirrors the def-time `evaluateBeginExpression` in
/// `function-type.ts:499`, made non-fatal). On success the evaluated body is
/// pushed to `out`; on error the swallowing `Exception` unwinds THIS helper
/// (returning unit, `out` stays empty). IMPORTANT: the swallow handler unwinds
/// `()` (unit) — NOT a large value — because `unwind(v)` memcpys `v` into the
/// fixed 64-byte `__yo_unwind_value` buffer (codegen), so unwinding a large
/// enum like `Option(AstExpr)` would overflow it. The evaluated body therefore
/// rides out via the `out` param, not the unwind value.
_trial_eval_fn_body :: (
  fn(body : AstExpr, env : Environment, ctx : EvalContext, out : ArrayList(AstExpr)) -> unit
)({
  // Reset the flow-violation flag so a stale flag from an earlier (propagated,
  // non-def-time) throw can't be mistaken for a violation in THIS body.
  clear_flow_violation();
  // The swallow handler is a capture-free `->` effect handler (it cannot close
  // over a propagating `exn`), so it always swallows. A deliberate
  // flow-soundness rejection sets `flow_violation_pending()` BEFORE throwing;
  // the def-time caller re-raises it via the real `exn` after this returns.
  inner_exn := Exception(throw : ((_err) -> unwind(())));
  evaluated := evaluate_expression_raw(body, env, ctx, inner_exn);
  ___ := out.push(evaluated);
});
/// Build a fresh definition-time evaluation env for a function body: captures
/// (re-derived from `caller_env` so other top-level names resolve) + a frame
/// with the parameters bound (with `is_ref`/`is_parameter` set so the
/// flow-soundness check recognises them). Mirrors how TS `evaluateFunctionType`
/// binds params into the env threaded to the body eval (function.ts:711-713).
_build_def_time_body_env :: (
  fn(
    caller_env : Environment,
    param_labels : ArrayList(String),
    param_types : ArrayList(TypeValue),
    param_is_ref : ArrayList(bool),
    // The signature's evaluated result type — scanned (with param_types)
    // for the SIGNATURE's own SomeT objects so comptime type params bind
    // the SAME SomeT identity the signature mentions. Minting fresh
    // SomeTs here gave the body's `ZPair(K, V)` a different CTFE cache
    // key than the signature's `*(ZPair(K, V))` → two struct
    // instantiations → match-arm unification failure (std/imm/map.yo
    // `_alloc_pairs`). TS has no such split: the def-time body eval
    // reuses the fn-type evaluation env, so the body sees the same
    // SomeType objects (function-type.ts:499).
    result_type : TypeValue
  ) -> Environment
)({
  module_path := caller_env.module_path;
  fresh_env := Environment.new(module_path);
  (cap_fi : usize) = usize(0);
  while(cap_fi < caller_env.frames.len(), {
    match(
      caller_env.frames.get(cap_fi),
      .Some(cap_frame) => {
        (cap_vi : usize) = usize(0);
        while(cap_vi < cap_frame.variables.len(), {
          match(
            cap_frame.variables.get(cap_vi),
            .Some(cv) => {
              if(!(cv.name == "__recur_fn"), {
                cap_value := match(cv.value,.Some(actual) => Option(EvalValue).Some(actual),.None => Option(EvalValue).None);
                is_ct := match(cap_value,.Some(_) => true,.None => false);
                // Carry `is_reassignable` — module globals (`(x : T) = v;`)
                // ARE reassignable from fn bodies; rebinding them read-only
                // made std/log.yo's `_global_level = level` def-eval fail
                // "Cannot reassign".
                ___ := add_variable_to_env(fresh_env, cv.name, cv.ty, cap_value, is_ct, cv.is_reassignable, false, false, synthetic_token(cv.name, module_path));
              });
            },
            .None => ()
          );
          cap_vi = (cap_vi + usize(1));
        });
      },
      .None => ()
    );
    cap_fi = (cap_fi + usize(1));
  });
  ___fr := fresh_env.push_frame(false);
  // Frame level of the just-pushed parameter frame (for SomeT binding below).
  pf_level := (fresh_env.frames.len() - usize(1));
  // Collect the signature's SomeTs (from param types + result type) so a
  // comptime type param can be bound to the SAME SomeT object the other
  // signature types reference (see doc comment on result_type above).
  sig_some_ts := ArrayList(TypeValue).new();
  {
    (sci : usize) = usize(0);
    while(sci < param_types.len(), {
      spt := match(param_types.get(sci),.Some(t) => t,.None => t_unit());
      found := get_all_some_types(spt);
      (sfi : usize) = usize(0);
      while(sfi < found.len(), {
        match(
          found.get(sfi),
          .Some(st) => {
            _ := sig_some_ts.push(st);
          },
          .None => ()
        );
        sfi = (sfi + usize(1));
      });
      sci = (sci + usize(1));
    });
    found_r := get_all_some_types(result_type);
    (sri : usize) = usize(0);
    while(sri < found_r.len(), {
      match(
        found_r.get(sri),
        .Some(st) => {
          _ := sig_some_ts.push(st);
        },
        .None => ()
      );
      sri = (sri + usize(1));
    });
  };
  (pi : usize) = usize(0);
  while(pi < param_labels.len(), {
    pn := match(param_labels.get(pi),.Some(n) => n,.None => String.from(""));
    pt := match(param_types.get(pi),.Some(t) => t,.None => t_unit());
    p_ref := match(param_is_ref.get(pi),.Some(b) => b,.None => false);
    // A comptime TYPE parameter (`comptime(T) : Type`) must be bound as a
    // `TypeVal(SomeT(name))` type value — NOT `create_unknown_val(Type)` (an
    // unknown VALUE) — so the body can use it as a type (e.g. a type-constructor
    // body `struct(_0 : A, _1 : B)`). Otherwise `A` is a non-type value and
    // field/element-type eval throws "expected type for element, got A"
    // (field.yo:293) — the dominant def-time-eval swallow category. Mirrors the
    // SomeT binding in evaluate_function_parameters (function.yo:1169).
    pv := if(is_type_0(pt), {
      // Prefer the signature's own SomeT for this name; mint only when
      // the signature never mentions the param.
      (sig_match : Option(TypeValue)) = Option(TypeValue).None;
      (smi : usize) = usize(0);
      while((smi < sig_some_ts.len()) && sig_match.is_none(), {
        match(
          sig_some_ts.get(smi),
          .Some(st) => match(
            st,
            .SomeT(_, st_name, _, _, _, _, _, _, _, _) => if(st_name == pn, {
              sig_match = Option(TypeValue).Some(st);
            }),
            _ => ()
          ),
          .None => ()
        );
        smi = (smi + usize(1));
      });
      match(
        sig_match,
        .Some(st) => create_type_value(st),
        .None => create_type_value(t_some_t(pn, pf_level))
      )
    }, create_unknown_val(pt));
    ___ := add_parameter_to_env(
      fresh_env,
      pn,
      pt,
      Option(EvalValue).Some(pv),
      false,
      p_ref,
      false,
      false,
      p_ref,
      true,
      synthetic_token(pn, module_path)
    );
    pi = (pi + usize(1));
  });
  fresh_env
});
/// Register a function body expression against a function type, producing a
/// typed `FuncVal`.
///
/// Phase 2bm: simplified implementation.
///
/// - Extracts `forall_labels`, `param_labels`, `implicit_labels`, `result` from
///   `TypeValue.Func`.
/// - Derives `param_type_names` from each param's type: if the type is `SomeT`,
///   uses its `name` (for forall binding at call time); otherwise uses `""`.
/// - Creates `EvalValue.FuncVal` with empty captures (regular functions do not
///   capture outer runtime variables in the 1:1 port).
/// - Body evaluation at definition time is skipped (deferred to call time).
///   This means early return-type mismatches are not caught.
/// - Stores `ExprInfo` in the table and returns the annotated expression.
///
/// Mirrors `tryToImplementFunctionByFunctionType` in `src/evaluator/calls/function-type.ts`.
try_to_implement_function_by_function_type :: (
  fn(
    expr : AstExpr,
    function_type : TypeValue,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)(
  match(
    function_type,
    .Func({ param_types, result : result_box, meta : __fm2 }) => {
      forall_labels := __fm2.*.forall_labels;
      param_labels := __fm2.*.param_labels;
      implicit_labels := __fm2.*.implicit_labels;
      param_is_ref := __fm2.*.param_is_ref;
      result_is_ref := __fm2.*.result_is_ref;
      result_is_comptime_only := __fm2.*.result_is_comptime_only;
      tok := ast_expr_token(expr);
      // Extract the function body from args[0] of the outer call expression.
      args := match(
        expr,
        .FnCall(_, _, a, _, _) => a,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      if(args.len() != usize(1), {
        exn.throw(
          dyn(
            format_error_message(
              tok,
              `Expected 1 argument for function body, got ${args.len()}`,
              false,
              .None
            )
          )
        );
      });
      body_expr := match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
      // Build param_type_names: for each param type, use the SomeT name (for forall
      // binding at call time) if the param type is a generic type variable, else "".
      param_type_names := ArrayList(String).new();
      (pti : usize) = usize(0);
      n_pt := param_types.len();
      while(pti < n_pt, {
        pt_name := match(
          param_types.get(pti),
          .Some(pt) => match(
            pt,
            .SomeT(_, name, _, _, _, _, _, _, _, _) => name,
            _ => String.from("")
          ),
          .None => String.from("")
        );
        ___ := param_type_names.push(pt_name);
        pti = (pti + usize(1));
      });
      // Build cap_names/cap_tys/cap_vals from `caller_env` so the FuncVal's body
      // can resolve other top-level identifiers (other functions, types,
      // constants) at call time. The body is evaluated in a `fresh_env`
      // that only contains captures + params; without these, references
      // like `inner` inside `outer :: (fn(…))(inner(T))` fall through to
      // the "Variable not found" soft fallback and the call result becomes
      // `UnknownVal`. Mirrors the capture loop in
      // `evaluator/values/anonymous_function.yo`.
      cap_names := ArrayList(String).new();
      cap_tys := ArrayList(TypeValue).new();
      cap_vals := ArrayList(EvalValue).new();
      n_cap_fr := caller_env.frames.len();
      (cap_fi : usize) = usize(0);
      while(cap_fi < n_cap_fr, {
        match(
          caller_env.frames.get(cap_fi),
          .Some(cap_frame) => {
            n_cap_v := cap_frame.variables.len();
            (cap_vi : usize) = usize(0);
            while(cap_vi < n_cap_v, {
              match(
                cap_frame.variables.get(cap_vi),
                .Some(cv) => {
                  if(!(cv.name == "__recur_fn"), {
                    cap_names.push(cv.name);
                    cap_tys.push(cv.ty);
                    cap_val := match(
                      cv.value,
                      .Some(actual) => actual,
                      .None => EvalValue.VarRef(cv.name)
                    );
                    cap_vals.push(cap_val);
                  });
                },
                .None => ()
              );
              cap_vi = (cap_vi + usize(1));
            });
          },
          .None => ()
        );
        cap_fi = (cap_fi + usize(1));
      });
      fn_val_id := random_id(caller_env.module_path);
      // Faithful port of `shouldDeferBodyEvaluation` (function-type.ts:445-451):
      // defer body evaluation ONLY for functions that depend on generic type
      // variables — `forall` parameters, any parameter whose type contains a
      // some-type in codegen-relevant position, or a generic `Self`. Every other
      // (concrete) function has its body evaluated UNCONDITIONALLY at definition
      // time, exactly as TS does at function-type.ts:499. This is the def-time
      // body eval; the flowability *check* (is_flowable_expr) below applies to
      // returns whose representation carries a raw pointer.
      //
      // We still need a copy of the body for the trial eval because the evaluator
      // consumes its `expr` argument and the original `body_expr` must be moved
      // into the FuncVal. The original is boxed into the FuncVal (retained once);
      // the clone is transient (consumed by the eval, freed at scope end) — so
      // peak retention is 1x, matching TS's shared-reference model.
      (any_some_param_ft : bool) = false;
      (spi : usize) = usize(0);
      while((spi < param_types.len()) && (!(any_some_param_ft)), {
        match(
          param_types.get(spi),
          .Some(pt) => if(type_contains_some_type_for_codegen_param(pt, ArrayList(String).new()), {
            any_some_param_ft = true;
          }),
          .None => ()
        );
        spi = (spi + usize(1));
      });
      // DEEP some-type check on Self (mirrors TS `typeContainsSomeType`, which
      // recurses into struct/enum/tuple/ptr/slice args). yo-self's plain
      // `type_contains_some_type` is SHALLOW (top-level SomeT/TypeAppT only), so
      // a generic-impl method's `Self = ArrayList(T)` (a Struct CONTAINING a
      // SomeT) was NOT detected → the method was wrongly NOT deferred → its body
      // was def-time-evaluated with `T` unbound → "expected type for element,
      // got T" (field.yo:293). Use the deep predicate so such methods defer.
      self_has_some_ft := match(ctx.self_type,.Some(st) => type_contains_some_type_for_codegen_param(st, ArrayList(String).new()),.None => false);
      should_defer_ft := (((forall_labels.len() > usize(0)) || any_some_param_ft) || self_has_some_ft);
      (flow_body : Option(AstExpr)) = if(
        !(should_defer_ft),
        Option(AstExpr).Some(body_expr.clone()),
        Option(AstExpr).None
      );
      func_val := EvalValue.FuncVal(
        box(
          FuncValData(
            forall_names : forall_labels.clone(),
            params : param_labels.clone(),
            param_type_names : param_type_names,
            evidence_params : implicit_labels,
            body : box(body_expr),
            cap_names : cap_names,
            cap_tys : cap_tys,
            func_id : fn_val_id.clone()
          )
        ),
        cap_vals
      );
      // Record this function's own resolved Func type by its FuncVal id so
      // codegen can emit its C prototype (Gap 10). This path (a `fn(...)` type
      // applied to a body, e.g. `f :: (fn(x:i32)->i32)(x+x)`) uses a bare
      // random_id func_id and previously skipped registration — leaving
      // get_func_type → t_unit → a wrong `void f(void)` prototype.
      register_func_type(fn_val_id.clone(), function_type.clone());
      // Re-key the per-parameter optional-flags side-table (registered by
      // `evaluate_function_type` under the `fn(...)` type-expression id)
      // under this FuncVal's id, which is what the call site sees. The
      // callee here is `expr`'s func slot — the same `fn(...)` expr that
      // was evaluated to produce `function_type`, so their ids match.
      match(
        expr,
        .FnCall(_, fn_type_box, _, _, _) => {
          copy_func_param_defaults(ast_expr_id(fn_type_box.*).to_string(), fn_val_id.clone());
          copy_func_param_default_exprs(ast_expr_id(fn_type_box.*).to_string(), fn_val_id.clone());
          copy_func_variadic_param(ast_expr_id(fn_type_box.*).to_string(), fn_val_id.clone());
          copy_macro_registration(ast_expr_id(fn_type_box.*).to_string(), fn_val_id.clone());
          copy_func_where_constraints(ast_expr_id(fn_type_box.*).to_string(), fn_val_id.clone());
        },
        .Atom(_, _) => ()
      );
      _ := result_box;
      // Build and store ExprInfo for the function definition expression.
      // The type of a function definition is the function type itself.
      info := new_expr_info(caller_env, function_type);
      info.value = Option(EvalValue).Some(func_val);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
      // Def-time body evaluation (function-type.ts:499) for every non-deferred
      // (concrete) function. The flowability *check* on the evaluated final
      // expression runs only for returns whose representation carries a raw
      // pointer — ordinary functions are merely evaluated, not rejected.
      match(
        flow_body,
        .Some(fb) => {
          flow_env := _build_def_time_body_env(caller_env, param_labels, param_types, param_is_ref, result_box.*);
          // Bind the variadic parameter (`...(quote(elems))` → `elems` as
          // an unknown ComptimeList) into the body env — its name/type
          // are not on TypeValue.Func, so they ride the side table (see
          // types/function.yo). TS body eval reuses the fn-type eval env
          // where the variadic param is already bound.
          match(
            expr,
            .FnCall(_, vp_ft_box, _, _, _) => match(
              get_func_variadic_param(ast_expr_id(vp_ft_box.*).to_string()),
              .Some(vp_entry) => {
                ___vp := add_variable_to_env(
                  flow_env,
                  vp_entry.label.clone(),
                  vp_entry.ty,
                  Option(EvalValue).Some(create_unknown_val(vp_entry.ty)),
                  true,
                  false,
                  false,
                  false,
                  synthetic_token(vp_entry.label, caller_env.module_path)
                );
              },
              .None => ()
            ),
            .Atom(_, _) => ()
          );
          flow_fv := EvalValue.FuncVal(
            box(
              FuncValData(
                forall_names : ArrayList(String).new(),
                params : ArrayList(String).new(),
                param_type_names : ArrayList(String).new(),
                evidence_params : ArrayList(String).new(),
                body : box(make_err_expr()),
                cap_names : ArrayList(String).new(),
                cap_tys : ArrayList(TypeValue).new(),
                func_id : random_id(caller_env.module_path)
              )
            ),
            ArrayList(EvalValue).new()
          );
          flow_ctx := create_function_body_evaluation_context(function_type, flow_fv, flow_env, ctx);
          flow_out := ArrayList(AstExpr).new();
          _trial_eval_fn_body(fb, flow_env, flow_ctx, flow_out);
          // Re-raise a flow-soundness rejection that the trial-eval swallowed
          // (a `inout(name) := <non-flowable>` binding anywhere in the body). The
          // handler is capture-free so it could not propagate it directly; the
          // binding-site flagged it instead, and we re-throw it here via the
          // real `exn`. Unconditional (NOT under `result_is_ref`) because the
          // enclosing function may return any type — e.g. `fn() -> unit`.
          if(flow_violation_pending(), {
            viol_msg := flow_violation_message();
            clear_flow_violation();
            exn.throw(dyn(format_error_message(ast_expr_token(fb), viol_msg, false,.None)));
          });
          // comptime_expect_error propagation: when "propagate all def-time
          // body-eval errors" mode is active (set only around a
          // `comptime_expect_error` argument eval), a body whose trial-eval THREW
          // — detected by an empty `flow_out`, since `_trial_eval_fn_body` pushes
          // the evaluated body only on success — must NOT be silently swallowed.
          // Re-raise via the real `exn` so the error reaches the
          // `comptime_expect_error` catch (mirrors TS, whose def-time body eval
          // propagates). The message is generic: `comptime_expect_error` discards
          // it (TS catches `error` without inspecting it, comptime-expect-error.ts:33).
          if(propagate_def_time_errors() && (flow_out.len() == usize(0)), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(fb),
                  String.from("Function body raised a compile-time error during definition-time evaluation."),
                  false,
                  .None
                )
              )
            );
          });
          // (Ref-returning functions are banned at signature evaluation —
          // see types/function.yo — so only the raw-pointer-representation
          // rooting check remains. Mirrors function-type.ts.)
          if((type_representation_contains_raw_ptr(result_box.*) && !(result_is_comptime_only))
          && !(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(fb).module_path.clone()))), {
            seb := match(
              flow_out.get(usize(0)),
              .Some(e) => e,
              .None => fb
            );
            slice_flow_opts := FlowOptions(
              allow_same_frame_local : false,
              allow_parameter_source : true,
              allow_comptime_source : true,
              max_local_frame_level : Option(usize).None
            );
            if(!(is_flowable_expr(seb, flow_ctx, slice_flow_opts)), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(seb),
                    `Function returning '${type_to_string(result_box.*)}' carries a raw pointer in its representation; the returned value must be rooted in caller-owned storage. The body's final expression is not flowable:\n  ${ast_expr_to_string(seb)}`,
                    false,
                    .None
                  )
                )
              );
            });
          });
        },
        .None => ()
      );
      expr
    },
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("try_to_implement_function_by_function_type: expected Func type"),
            false,
            .None
          )
        )
      );
      make_err_expr()
    }
  )
);
export(check_deferred_generic_return_type);
export(create_function_body_evaluation_context);
export(try_to_implement_function_by_function_type);
