//! evaluator/calls/closure_type — closure value creation.
//!
//! Phase 3 implementation of `try_to_implement_closure_by_fn_module_type`.
//! 1:1 port of `src/evaluator/calls/closure-type.ts`.
//!
//! Given `WrapperType(closureBody)` where `WrapperType` is `SomeT` or `DynT`
//! containing a `FnTraitT`, this function:
//!   1. Validates the argument count.
//!   2. Pushes a new env frame and adds the FnTrait parameters to it.
//!   3. Creates a `FuncVal` for the closure.
//!   4. Evaluates the closure body.
//!   5. Checks that the body's return type matches the declared return type.
//!   6. Pops the env frame.
//!   7. Enriches captured variables.
//!   8. Creates the capture struct type.
//!   9. Sets ExprInfo on the expression and returns it.
//!
//! Phase 3 simplifications:
//!   - Where-clause re-application skipped (deferred to Phase 4).
//!   - No `wrapperType.resolvedConcreteType` mutation (no such field in yo-self).
//!   - No `deferredDupExpressions` / ARC dup (deferred to Phase 4).
//!   - No `attachTempVariableToExpr` for DynType (deferred to Phase 4).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr }
:: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  register_some_resolved_concrete,
  expr_info_set_closure_function_value,
  expr_info_capture_type,
  expr_info_set_capture_type
} :: import("../../expr_info.yo");
{ Token } :: import("../../token.yo");
{
  Environment,
  add_variable_to_env,
  synthetic_token
} :: import("../../env.yo");
{ TypeValue, FuncMeta } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ are_types_compatible }
:: import("../../types/compatibility.yo");
{
  EvalValue,
  FuncValData
} :: import("../../value.yo");
{
  EvalContext,
  CapturedVarInfo
} :: import("../context.yo");
{ Variable } :: import("../../env.yo");
{ format_error_message }
:: import("../../error.yo");
{ Exception } :: import("std/error");
{ random_id } :: import("../../utils.yo");
{ mark_as_closure_fn, register_func_type, register_closure_capture_info, ClosureCaptureInfo } :: import("../../function_value.yo");
{
  create_function_body_evaluation_context
} :: import("./function_type.yo");
{
  evaluate_begin_expression
} :: import("../exprs/begin.yo");
{
  enrich_captured_variables,
  create_capture_type_and_value,
  FuncCapturedVarInfo
} :: import("../utils/closure.yo");
/// Convert a closure body expression into a typed closure value against
/// `fn_module_type` (an FnTrait type) wrapped in `wrapper_type` (Some or Dyn).
///
/// Mirrors `tryToImplementClosureByFnModuleType` in `src/evaluator/calls/closure-type.ts`.
try_to_implement_closure_by_fn_module_type :: (
  fn(
    expr : AstExpr,
    fn_module_type : TypeValue,
    wrapper_type : TypeValue,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(AstExpr)
)({
  tok := ast_expr_token(expr);
  arg_list := match(
    expr,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  // Validate: FnTrait types expect exactly 1 argument (the closure body).
  if(arg_list.len() != usize(1), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          `Fn module type expects exactly 1 argument (the closure body), got ${arg_list.len()}`,
          false,
          .None
        )
      )
    );
  });
  closure_body_expr := match(
    arg_list.get(usize(0)),
    .Some(a) => a,
    .None => make_err_expr()
  );
  // Clone the body so we can use it twice (once in FuncVal box, once for evaluation).
  closure_body_for_eval := closure_body_expr.clone();
  // Extract param names and types from the FnTraitT.
  param_labels := match(
    fn_module_type,
    .FnTraitT(_, pls, _, _, _, _, _, _) => pls,
    _ => ArrayList(String).new()
  );
  param_types := match(
    fn_module_type,
    .FnTraitT(_, _, pts, _, _, _, _, _) => pts,
    _ => ArrayList(TypeValue).new()
  );
  result_type := match(
    fn_module_type,
    .FnTraitT(_, _, _, rt_box, _, _, _, _) => rt_box,
    _ => t_unit()
  );
  param_is_ref_flags := match(
    fn_module_type,
    .FnTraitT(_, _, _, _, _, _, _, prf) => prf,
    _ => ArrayList(bool).new()
  );
  // Push a new env frame for the closure parameters.
  (env : Environment) = caller_env;
  // Outer frame count BEFORE the param frame is pushed — the closure's defining
  // frame level, used by codegen (generate_function) to rewrite captured vars to
  // `closure_context->field`. Mirrors anonymous_function.yo:637 `n_cap_fr`.
  n_cap_fr := env.frames.len();
  _fr := env.push_frame(false);
  // Add each FnTrait parameter as a runtime variable to the new frame.
  n_params := param_labels.len();
  (pi : usize) = usize(0);
  while(pi < n_params, {
    p_label := match(param_labels.get(pi), .Some(l) => l, .None => String.from("_p"));
    p_type := match(param_types.get(pi), .Some(t) => t, .None => t_unit());
    p_tok := synthetic_token(p_label.clone(), env.module_path);
    p_var_opt := add_variable_to_env(
      env,
      p_label.clone(),
      p_type,
      Option(EvalValue).None,
      // runtime value — unknown at definition time
      false,
      // not compile-time-only
      false,
      // not reassignable
      false,
      // not owning RC
      false,
      // not implicit
      p_tok
    );
    // Stamp is_ref from the Fn trait's `inout(...)` call params so the body's
    // reads/writes go through the C pointer — same stamping as
    // anonymous_function.yo's expected-type param loop (add_variable_to_env
    // cannot set is_ref).
    if(match(param_is_ref_flags.get(pi), .Some(b) => b, .None => false), {
      match(
        p_var_opt,
        .Some(p_var) => {
          p_var.is_ref = true;
          // TS: `isReassignable: parameter.isRef` — see the
          // anonymous_function.yo stamping.
          p_var.is_reassignable = true;
        },
        .None => ()
      );
    });
    pi = (pi + usize(1));
  });
  // Build a synthetic Func type for create_function_body_evaluation_context.
  // This is needed because create_function_body_evaluation_context expects a Func type
  // to extract the return type for the expected-type context.
  result_type_copy := result_type.clone();
  synthetic_func_ty := TypeValue.Func(
    ArrayList(TypeValue).new(),
    // forall_types
    param_types.clone(),
    ArrayList(TypeValue).new(),
    // implicit_types
    ArrayList(TypeValue).new(),
    // where_types
    result_type_copy,
    box(
      FuncMeta(
        forall_labels : ArrayList(String).new(),
        param_labels : param_labels.clone(),
        implicit_labels : ArrayList(String).new(),
        implicit_spreads : ArrayList(bool).new(),
        result_is_comptime_only : false,
        // a runtime closure call type; `inout` call params carry through
        param_is_ref : param_is_ref_flags.clone(),
        param_is_owning : ArrayList(bool).new(),
        // no `own` params in synthesized closure call type
        result_is_ref : false,
        has_variadic : false,
        is_extern : Option(String).None,
        // synthetic closure call type is not FFI
        extern_name : Option(String).None,
        is_control : false // synthetic closure call type is `fn`, not `ctl`
        ,
        variadic_label : Option(String).None,
        variadic_comptime : false
      )
    ),
    ArrayList(TypeValue).new()
  );
  // Build a preliminary FuncVal for the evaluation context.
  closure_id := `closure_${random_id(env.module_path)}`;
  func_val_pre := EvalValue.FuncVal(
    box(
      FuncValData(
        forall_names : ArrayList(String).new(),
        params : param_labels,
        param_type_names : ArrayList(String).new(),
        // filled below
        evidence_params : ArrayList(String).new(),
        body : closure_body_expr,
        cap_names : ArrayList(String).new(),
        // filled after body evaluation
        cap_tys : ArrayList(TypeValue).new(),
        func_id : closure_id.clone()
      )
    ),
    ArrayList(EvalValue).new()
    // cap_vals
  );
  // Mark this function as a closure so codegen prepends the `void* closure_context`
  // capture parameter to its C prototype/definition (mirrors FunctionType.isClosure).
  mark_as_closure_fn(closure_id.clone());
  // Record the closure's own resolved Func type by func_id so codegen's
  // prototype emitter (get_func_type) can build the signature. TS reads
  // `closureFunctionValue.type` directly; yo-self's FuncVal carries only
  // param-name strings, so the structured type is side-tabled here at creation
  // time (mirrors anonymous_function.yo:806 `register_func_type(func_id, ...)`).
  register_func_type(closure_id.clone(), synthetic_func_ty.clone());
  // Create the function body evaluation context.
  eval_ctx := create_function_body_evaluation_context(
    synthetic_func_ty,
    func_val_pre,
    env,
    ctx
  );
  // Evaluate the closure body.
  evaluated_body := evaluate_begin_expression(
    closure_body_for_eval,
    env,
    eval_ctx,
    ArrayList(Variable).new(),
    true,
    exn
  );
  // Update env from the evaluated body.
  body_info_opt := expr_info_table_get(eval_ctx.expr_info_table, ast_expr_id(evaluated_body));
  match(
    body_info_opt,
    .Some(bi) => {
      env.frames = bi.env.frames;
      env.module_path = bi.env.module_path;
      env.function_declaration_frame_level = bi.env.function_declaration_frame_level;
      env.input_string = bi.env.input_string;
    },
    .None => ()
  );
  // Check return type compatibility.
  body_ty := match(
    body_info_opt,
    .Some(bi) => bi.ty,
    .None => t_unit()
  );
  if(!(are_types_compatible(body_ty, result_type)), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          `Incompatible closure return type`,
          false,
          .None
        )
      )
    );
  });
  // Pop the env frame.
  env.pop_frame();
  // Capture variable enrichment.
  captured_vars_opt := eval_ctx.captured_variables;
  captured_vars_with_values_opt := match(
    captured_vars_opt,
    .None => Option(HashMap(String, FuncCapturedVarInfo)).None,
    .Some(cv) =>
      if(cv.len() > usize(0), {
        enriched := enrich_captured_variables(cv, caller_env);
        Option(HashMap(String, FuncCapturedVarInfo)).Some(enriched)
      }, Option(HashMap(String, FuncCapturedVarInfo)).None)
  );
  // Create the capture struct type.
  cap_result := create_capture_type_and_value(
    Option(TypeValue).None,
    captured_vars_with_values_opt,
    env,
    tok
  );
  capture_ty := cap_result.capture_type;
  // Record the capture struct type + defining frame level by func_id so codegen's
  // generate_function can set the closure-capture context (rewriting captured vars
  // like `k` to `((<cap>*)closure_context)->k`). Mirrors anonymous_function.yo:1068.
  match(
    capture_ty.clone(),
    .Some(ct) => {
      register_closure_capture_info(closure_id.clone(), ClosureCaptureInfo(capture_type : ct.clone(), frame_level : n_cap_fr));
      // Lower the `Impl(Fn)` wrapper SomeT to the capture struct for codegen: the
      // closure VALUE then types as the capture struct (get_type_string resolves
      // the SomeT via lookup_some_resolved_concrete) and a direct value-call
      // `add(x)` resolves cc_id to the capture-struct id so it dispatches through
      // impl_closure_call_map (`closure_fn(&add, x)`) instead of a bad fn-ptr
      // cast. Mirrors TS's `resolvedConcreteType` on the closure SomeType.
      match(
        wrapper_type.clone(),
        .SomeT({ id : wid }) => register_some_resolved_concrete(wid, ct),
        _ => ()
      );
    },
    .None => ()
  );
  // Determine the final type (use wrapper_type).
  final_ty := wrapper_type;
  // Build the ExprInfo for this closure expression.
  info := new_expr_info(env, final_ty);
  expr_info_set_capture_type(info, capture_ty);
  expr_info_set_closure_function_value(info, Option(EvalValue).Some(func_val_pre));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  Option(AstExpr).Some(expr)
});
export(try_to_implement_closure_by_fn_module_type);
