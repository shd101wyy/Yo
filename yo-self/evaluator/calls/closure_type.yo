//! evaluator/calls/closure_type — stub for try_to_implement_closure_by_fn_module_type.
//!
//! Phase 2x stub. Full implementation planned for Phase 3.
//! 1:1 port of `src/evaluator/calls/closure-type.ts`.
//!
//! `try_to_implement_closure_by_fn_module_type` converts a closure expression
//! into a typed closure value by matching it against an FnTrait module type,
//! capturing free variables, and producing the wrapped closure expression.

open import "std/string";

{ AstExpr, ast_expr_token, make_err_expr } :: import "../../expr/expr.yo";
{ Environment }                            :: import "../../env/env.yo";
{ TypeValue }                              :: import "../../types/type.yo";
{ EvalContext }                            :: import "../context.yo";
{ format_error_message }                   :: import "../../error/error.yo";
{ Exception }                              :: import "std/error";

/// Convert a closure body expression into a typed closure value against
/// `fn_module_type` (an FnTrait type) wrapped in `wrapper_type` (Some or Dyn).
///
/// Phase 2x stub: throws "not yet implemented". Full implementation in Phase 3.
///
/// Mirrors `tryToImplementClosureByFnModuleType` in `src/evaluator/calls/closure-type.ts`.
try_to_implement_closure_by_fn_module_type :: (fn(
  expr            : AstExpr,
  fn_module_type  : TypeValue,
  wrapper_type    : TypeValue,
  caller_env      : Environment,
  ctx             : *(EvalContext),
  using(exn       : Exception)
) -> Option(AstExpr))({
  _ := fn_module_type;
  _ := wrapper_type;
  _ := caller_env;
  _ := ctx;
  exn.throw(dyn format_error_message(
    ast_expr_token(expr),
    String.from("try_to_implement_closure_by_fn_module_type: not yet implemented (Phase 3)"),
    false,
    .None
  ));
  Option(AstExpr).None
});

export try_to_implement_closure_by_fn_module_type;
