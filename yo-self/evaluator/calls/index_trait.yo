//! evaluator/calls/index_trait — full port of src/evaluator/calls/index-trait.ts.
//!
//! Phase 3u — full implementation.
//! 1:1 port of `src/evaluator/calls/index-trait.ts`.
//!
//! Handles `value(arg)` calls dispatched via the Index trait.
//! For comptime arrays/strings: performs compile-time element indexing
//! (range slicing falls through to the runtime slice_copy rewrite).
//! For runtime values: looks up the index method and returns UnknownVal.
//!
//! Phase 3u simplifications:
//!   - _check_range_type: uses struct name heuristic (no CTFE resolution)
//!   - Custom type ComptimeIndex: dispatched via _try_comptime_custom_type_index
//!   - has_index_impl: Array fast path + trait-field/registry method lookup
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ str_lit_unquote_bytes } :: import("../../utils.yo");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr } :: import("../../expr.yo");
{ Environment, get_receiver_methods_by_name_from_env, add_variable_to_env, synthetic_token } :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_ptr } :: import("../../types/creators.yo");
{ is_array_type, is_pointer_type, is_trait_type } :: import("../../types/guards.yo");
{
  EvalValue,
  is_array_val,
  is_str_lit,
  is_struct_val,
  is_int_lit,
  is_func_val,
  is_unknown_val,
  create_unknown_val,
  create_runtime_unknown_val
} :: import("../../value.yo");
{
  EvalContext,
  IndexCallResult,
  ExpectedTypeCtx,
  ArgEntry,
  ArgValues,
  VarArgEntry
} :: import("../context.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  ComptimeRef
} :: import("../../expr_info.yo");
{ format_error_message } :: import("../../error.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ convert_comptime_type_to_runtime_type } :: import("../../types/env_lookup.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ try_to_call_function_with_arguments } :: import("./helper.yo");
{ get_func_param_comptime } :: import("../types/function.yo");
{ evaluate_comptime_fn_call } :: import("./comptime_fn.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// Private types
// ---------------------------------------------------------------------------
/// One candidate `index` method found on a type.
_IndexMethodEntry :: struct(
  method_type : TypeValue,
  method_value : Option(EvalValue)
);
/// Result of `_check_range_type`.
_RangeCheck :: struct(is_range : bool, is_inclusive : bool);
/// A resolved range pair (start inclusive, end exclusive).
_IdxRange :: struct(start_idx : usize, end_idx : usize);
// ---------------------------------------------------------------------------
// _str_unquote / _str_quote
// ---------------------------------------------------------------------------
/// Strip surrounding `"..."` from a raw StrLit value.
_str_unquote :: (fn(raw : String) -> String)({
  rn := raw.len();
  if(
    rn >= usize(2),
    str_lit_unquote_bytes(raw),
    String.new()
  )
});
/// Add surrounding `"..."` around a string value.
_str_quote :: (fn(s : String) -> String)(
  (String.from("\"") + s) + String.from("\"")
);
// ---------------------------------------------------------------------------
// _check_range_type
// ---------------------------------------------------------------------------
/// Returns a `_RangeCheck` based on the struct type name heuristic.
///   "RangeInclusive..." → { is_range: true,  is_inclusive: true  }
///   "Range..."          → { is_range: true,  is_inclusive: false }
///   other              → { is_range: false, is_inclusive: false }
_check_range_type :: (fn(arg_type : TypeValue) -> _RangeCheck)(
  match(
    arg_type,
    .Struct({ name }) => {
      is_incl := name.starts_with(`RangeInclusive`);
      is_rng := (is_incl || name.starts_with(`Range`));
      _RangeCheck(is_range : is_rng, is_inclusive : is_incl)
    },
    _ => _RangeCheck(is_range : false, is_inclusive : false)
  )
);
// ---------------------------------------------------------------------------
// _extract_range_indices
// ---------------------------------------------------------------------------
/// Extract start/end indices from a Range StructVal.
/// Returns None if the value is not a StructVal with numeric start/end.
_extract_range_indices :: (
  fn(
    range_ev : EvalValue,
    is_inclusive : bool
  ) -> Option(_IdxRange)
)(
  match(
    range_ev,
    .StructVal(_, _, field_values) => {
      start_field := match(
        field_values.get(usize(0)),
        .Some(v) => v,
        .None => {
          return(Option(_IdxRange).None);
        }
      );
      end_field := match(
        field_values.get(usize(1)),
        .Some(v) => v,
        .None => {
          return(Option(_IdxRange).None);
        }
      );
      if(!(is_int_lit(start_field)) || !(is_int_lit(end_field)), {
        return(Option(_IdxRange).None);
      });
      start_raw := match(
        start_field,
        .IntLit(r) => r,
        _ => {
          return(Option(_IdxRange).None);
        }
      );
      end_raw := match(
        end_field,
        .IntLit(r) => r,
        _ => {
          return(Option(_IdxRange).None);
        }
      );
      start_i64 := match(
        start_raw.parse_i64(),
        .Some(n) => n,
        .None => {
          return(Option(_IdxRange).None);
        }
      );
      end_raw_i64 := match(
        end_raw.parse_i64(),
        .Some(n) => n,
        .None => {
          return(Option(_IdxRange).None);
        }
      );
      end_i64 := if(is_inclusive, end_raw_i64 + i64(1), end_raw_i64);
      if(start_i64 < i64(0), {
        return(Option(_IdxRange).None);
      });
      if(end_i64 < i64(0), {
        return(Option(_IdxRange).None);
      });
      Option(_IdxRange).Some(
        _IdxRange(
          start_idx : usize(start_i64),
          end_idx : usize(end_i64)
        )
      )
    },
    _ => Option(_IdxRange).None
  )
);
// ---------------------------------------------------------------------------
// _find_all_index_methods
// ---------------------------------------------------------------------------
/// Find all `index` methods on a concrete type: TraitT receivers expose them
/// as direct trait fields; struct/object receivers resolve through the
/// trait-methods registry + generic-impl fallback (the yo-self mirror of TS
/// `concreteType.trait.fields`).
_find_all_index_methods :: (
  fn(
    concrete_type : TypeValue,
    env : Environment
  ) -> ArrayList(_IndexMethodEntry)
)({
  result := ArrayList(_IndexMethodEntry).new();
  match(
    concrete_type,
    .TraitT(_, _, field_labels, field_types, _, _, _, _, _, _) => {
      n := field_labels.len();
      (i : usize) = usize(0);
      while(i < n, {
        lbl_opt := field_labels.get(i);
        ty_opt := field_types.get(i);
        match(
          lbl_opt,
          .Some(lbl) => {
            if(lbl == "index", {
              match(
                ty_opt,
                .Some(fty) => {
                  if(match(fty,.Func({ result : _ }) => true, _ => false), {
                    result.push(
                      _IndexMethodEntry(
                        method_type : fty,
                        method_value : Option(EvalValue).None
                      )
                    );
                  });
                },
                .None => ()
              );
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  // Registry lookup for non-trait receivers (structs/objects like
  // `ArrayList(u8)`): TS reads `concreteType.trait.fields` directly
  // (index-trait.ts:76-90); yo-self's trait-methods registry + generic-impl
  // fallback is the mirror of that slot. Post method-type specialization,
  // generic-impl candidates arrive concrete (e.g.
  // `index : fn(self : *(ArrayList(u8)), idx : usize) -> *(u8)`). Without
  // this, `x(i)` on a struct receiver with an unknown value soft-fell to
  // `unit` under def-eval, poisoning every comparison built on it.
  if(result.len() == usize(0), {
    reg_methods := get_receiver_methods_by_name_from_env(env, String.from("index"), concrete_type, false);
    (ri : usize) = usize(0);
    while(ri < reg_methods.len(), {
      match(
        reg_methods.get(ri),
        .Some(m) => {
          if(match(m.ty,.Func({ result : _ }) => true, _ => false), {
            result.push(
              _IndexMethodEntry(
                method_type : m.ty,
                method_value : m.value
              )
            );
          });
        },
        .None => ()
      );
      ri = (ri + usize(1));
    });
  });
  result
});
// ---------------------------------------------------------------------------
// _find_index_method
// ---------------------------------------------------------------------------
/// Find a single `index` method whose signature matches:
///   `(self: *(Self), idx: ArgType) -> *(Output)`
_find_index_method :: (
  fn(
    concrete_type : TypeValue,
    arg_type : TypeValue,
    env : Environment
  ) -> Option(_IndexMethodEntry)
)({
  methods := _find_all_index_methods(concrete_type, env);
  n := methods.len();
  (i : usize) = usize(0);
  (found : Option(_IndexMethodEntry)) = Option(_IndexMethodEntry).None;
  while((i < n) && found.is_none(), {
    match(
      methods.get(i),
      .Some(m) => {
        match(
          m.method_type,
          .Func({ param_types, result : result_box, meta : __fm1 }) => {
            param_is_ref := __fm1.*.param_is_ref;
            if(param_types.len() == usize(2), {
              p0_opt := param_types.get(usize(0));
              p1_opt := param_types.get(usize(1));
              match(
                p0_opt,
                .Some(p0) => {
                  match(
                    p1_opt,
                    .Some(p1) => {
                      ret_ty := result_box;
                      // self must be a pointer type OR a `ref` parameter —
                      // both `(self : *(Self), ...)` and the modern
                      // `(inout(self) : Self, ...)` shape are accepted
                      // (TS index-trait.ts:153 `!isPtrType(selfParam.type)
                      // && !selfParam.isRef`).
                      p0_is_ptr := is_pointer_type(p0);
                      p0_is_ref := match(
                        param_is_ref.get(usize(0)),
                        .Some(b) => b,
                        .None => false
                      );
                      // `are_types_compatible(actual, expected)` — the ARGUMENT's type is the
                      // actual, the parameter's declared type is the expected. Passing
                      // them the other way round made the parameter type the "actual",
                      // so the comptime widening arms (types/compatibility.yo:124-146 for
                      // ComptimeInt, :171-190 for ComptimeString) — which all key off
                      // `actual` — never fired: `l(0)` on a `ComptimeIndex(usize)` impl was
                      // rejected with "Type does not implement Index for the given argument
                      // type" while `l(usize(0))` worked. TS spells the same check
                      // `areTypesCompatible({type: idxParam.type}, {type: argType})`
                      // (index-trait.ts:404-406), but ITS first position is `expected` and
                      // its second is `given` — the opposite order from yo-self's, so a
                      // faithful port must swap.
                      p1_compatible := are_types_compatible(arg_type, p1);
                      ret_is_ptr := is_pointer_type(ret_ty);
                      if(((p0_is_ptr || p0_is_ref) && p1_compatible) && ret_is_ptr, {
                        found = Option(_IndexMethodEntry).Some(m);
                      });
                    },
                    .None => ()
                  );
                },
                .None => ()
              );
            });
          },
          _ => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
// ---------------------------------------------------------------------------
// _try_comptime_element_access
// ---------------------------------------------------------------------------
/// Try comptime single element access for arrays and slices.
/// Returns Some(IndexCallResult) or None to fall through.
_try_comptime_element_access :: (
  fn(
    arg_expr : AstExpr,
    arg_val : Option(EvalValue),
    array_val : Option(EvalValue),
    value_type : TypeValue,
    caller_env : Environment,
    exn : Exception
  ) -> Option(IndexCallResult)
)({
  elem_ty := match(
    value_type,
    .Array(et, _, _) => et,
    _ => t_unit()
  );
  match(
    arg_val,
    .Some(v) => if(is_int_lit(v), {
      // Comptime integer index — direct element access
      idx_raw := match(v,.IntLit(r) => r, _ => String.from("0"));
      idx_i64 := match(
        idx_raw.parse_i64(),
        .Some(n) => n,
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(arg_expr),
                String.from("Invalid integer literal for array/slice index"),
                false,
                .None
              )
            )
          );
          i64(0)
        }
      );
      if(idx_i64 < i64(0), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_expr),
              `Array/slice index out of bounds: ${idx_raw}`,
              false,
              .None
            )
          )
        );
      });
      idx_usize := usize(idx_i64);
      // Array branch
      match(
        array_val,
        .Some(av) => {
          match(
            av,
            .ArrayVal(elements) => {
              arr_len := elements.len();
              if(idx_usize >= arr_len, {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(arg_expr),
                      `Array index out of bounds: ${idx_raw}. Expected index in range [0, ${(arr_len - usize(1))}].`,
                      false,
                      .None
                    )
                  )
                );
              });
              elem_val := match(
                elements.get(idx_usize),
                .Some(ev) => ev,
                .None => {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(arg_expr),
                        String.from("Array index out of bounds"),
                        false,
                        .None
                      )
                    )
                  );
                  EvalValue.UnitVal
                }
              );
              return(
                Option(IndexCallResult).Some(
                  IndexCallResult(
                    value : Option(EvalValue).Some(elem_val),
                    ty : elem_ty,
                    ptr_type : t_ptr(elem_ty),
                    index_method_type : Option(TypeValue).None,
                    index_method_value : Option(EvalValue).None,
                    caller_env : caller_env,
                    index : Option(usize).Some(idx_usize),
                    // TS index-trait.ts:870 — comptimeRef: { kind: "array",
                    // arrayValue, index } makes `arr(i) = v` a comptime place.
                    // `elements` is the SHARED handle destructured from the
                    // ArrayVal, so mutation through the ref lands in the
                    // binding (same as builtins/comptime_index_fns.yo:643).
                    comptime_ref : Option(ComptimeRef).Some(ComptimeRef.ArrayRef(elements, idx_usize))
                  )
                )
              );
            },
            _ => ()
          );
        },
        .None => ()
      );
      // Int lit but no array branch matched — return None
      Option(IndexCallResult).None
    }, {
      // Non-integer comptime value (e.g. UnknownVal) — return unknown element
      unk_val := create_unknown_val(elem_ty);
      Option(IndexCallResult).Some(
        IndexCallResult(
          value : Option(EvalValue).Some(unk_val),
          ty : elem_ty,
          ptr_type : t_ptr(elem_ty),
          index_method_type : Option(TypeValue).None,
          index_method_value : Option(EvalValue).None,
          caller_env : caller_env,
          index : Option(usize).None,
          comptime_ref : Option(ComptimeRef).None
        )
      )
    }),
    .None => {
      // Runtime index (no comptime value) — convert element type to runtime
      rt_elem_ty := convert_comptime_type_to_runtime_type(elem_ty, caller_env);
      Option(IndexCallResult).Some(
        IndexCallResult(
          value : Option(EvalValue).None,
          ty : rt_elem_ty,
          ptr_type : t_ptr(elem_ty),
          index_method_type : Option(TypeValue).None,
          index_method_value : Option(EvalValue).None,
          caller_env : caller_env,
          index : Option(usize).None,
          comptime_ref : Option(ComptimeRef).None
        )
      )
    }
  )
});
// ---------------------------------------------------------------------------
// _try_comptime_array_index
// ---------------------------------------------------------------------------
/// Main comptime dispatch for array and slice indexing.
/// Evaluates the arg, checks for range vs. element access, delegates.
_try_comptime_array_index :: (
  fn(
    arg_expr : AstExpr,
    array_val : Option(EvalValue),
    value_type : TypeValue,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(IndexCallResult)
)({
  // Evaluate the arg with `expected_type` CLEARED — the ambient expected type
  // at an index site is the ELEMENT type, which must not leak into the index
  // ARGUMENT's evaluation (TS passes `expectedType: undefined` at every
  // index-arg eval, index-trait.ts). `evaluate_expression` is the no-exn
  // wrapper, so no throw can skip the restore.
  cai_saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated := evaluate_expression(arg_expr, env, ctx);
  ctx.expected_type = cai_saved_expected;
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  info := match(
    info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate index argument"),
            false,
            .None
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  caller_env := info.env;
  arg_type := info.ty;
  arg_val := info.value;
  rc := _check_range_type(arg_type);
  if(rc.is_range, {
    // Range slicing is no longer a comptime operation — fall through to the
    // runtime path (slice_copy rewriting happens before Index dispatch;
    // plans/archive/SLICE_REWORK.md Part C, mirrors TS tryComptimeArrayIndex).
    return(Option(IndexCallResult).None);
  });
  _try_comptime_element_access(
    arg_expr,
    arg_val,
    array_val,
    value_type,
    caller_env,
    exn
  )
});
// ---------------------------------------------------------------------------
// _compute_comptime_string_index
// ---------------------------------------------------------------------------
/// Compute the result of indexing a comptime string value.
_compute_comptime_string_index :: (
  fn(
    str_value : String,
    arg_value : EvalValue,
    arg_expr : AstExpr,
    is_range : bool,
    is_inclusive : bool,
    exn : Exception
  ) -> EvalValue
)({
  // During type-checking with UnknownVal, return a placeholder
  if(is_unknown_val(arg_value), {
    return(EvalValue.StrLit(_str_quote(String.from(""))));
  });
  if(!(is_range), {
    // Single character access
    if(!(is_int_lit(arg_value)), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Expected comptime_int index for comptime string index"),
            false,
            .None
          )
        )
      );
    });
    idx_raw := match(arg_value,.IntLit(r) => r, _ => String.from("0"));
    idx_i64 := match(
      idx_raw.parse_i64(),
      .Some(n) => n,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_expr),
              String.from("Invalid integer literal for string index"),
              false,
              .None
            )
          )
        );
        i64(0)
      }
    );
    if(idx_i64 < i64(0), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `String index out of bounds: ${idx_raw}`,
            false,
            .None
          )
        )
      );
    });
    idx_usize := usize(idx_i64);
    str_len := str_value.len();
    if(idx_usize >= str_len, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `String index out of bounds: ${idx_raw}. Expected index in range [0, ${(str_len - usize(1))}].`,
            false,
            .None
          )
        )
      );
    });
    char_str := str_value.substring(idx_usize, idx_usize + usize(1));
    return(EvalValue.StrLit(_str_quote(char_str)));
  });
  // Range access
  if(!(is_struct_val(arg_value)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          String.from("Expected comptime Range value for comptime string range index"),
          false,
          .None
        )
      )
    );
  });
  indices_opt := _extract_range_indices(arg_value, is_inclusive);
  range_data := match(
    indices_opt,
    .Some(r) => r,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Expected numeric start/end in Range for comptime string range index"),
            false,
            .None
          )
        )
      );
      _IdxRange(start_idx : usize(0), end_idx : usize(0))
    }
  );
  start_idx := range_data.start_idx;
  end_idx := range_data.end_idx;
  str_len := str_value.len();
  if(start_idx > str_len, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `String slice start index out of bounds: ${start_idx}. Expected index in range [0, ${str_len}].`,
          false,
          .None
        )
      )
    );
  });
  if((end_idx < start_idx) || (end_idx > str_len), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `String slice end index out of bounds: ${end_idx}. Expected index in range [${start_idx}, ${str_len}].`,
          false,
          .None
        )
      )
    );
  });
  sliced := str_value.substring(start_idx, end_idx);
  EvalValue.StrLit(_str_quote(sliced))
});
// ---------------------------------------------------------------------------
// _try_comptime_string_index
// ---------------------------------------------------------------------------
/// Implement comptime_str indexing.
_try_comptime_string_index :: (
  fn(
    arg_expr : AstExpr,
    str_value : String,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> IndexCallResult
)({
  // expected_type cleared around the arg eval — see _try_comptime_array_index.
  csi_saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated := evaluate_expression(arg_expr, env, ctx);
  ctx.expected_type = csi_saved_expected;
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  info := match(
    info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate index argument for comptime string indexing"),
            false,
            .None
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  arg_val := match(
    info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate index argument for comptime string indexing"),
            false,
            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  caller_env := info.env;
  arg_type := info.ty;
  rc := _check_range_type(arg_type);
  result_val := _compute_comptime_string_index(
    str_value,
    arg_val,
    arg_expr,
    rc.is_range,
    rc.is_inclusive,
    exn
  );
  result_ty := TypeValue.ComptimeString;
  ptr_result_ty := t_ptr(result_ty);
  IndexCallResult(
    value : Option(EvalValue).Some(result_val),
    ty : result_ty,
    ptr_type : ptr_result_ty,
    index_method_type : Option(TypeValue).None,
    index_method_value : Option(EvalValue).None,
    caller_env : caller_env,
    index : Option(usize).None,
    comptime_ref : Option(ComptimeRef).None
  )
});
// ---------------------------------------------------------------------------
// _specialize_index_method
// ---------------------------------------------------------------------------
/// Specialize the (generic-impl) index method for codegen and ride the
/// concrete FuncVal out via `out`. yo-self specializes impl methods LAZILY at
/// the call site: `find_methods_from_generic_impls` returns the UNSPECIALIZED
/// generic method (generic T, generic func_id whose registered type is
/// hard-generic), which `should_skip_function_codegen` then drops — so the index
/// call would reference an unemitted C function. A normal call `recv.m(i)` routes
/// through `try_to_call_function_with_arguments` → `create_specialized_function_inline`,
/// producing a concrete func_id with a registered concrete type that IS emitted.
/// Route the index method through that same path (args = [receiver, idx]) so its
/// specialized FuncVal reaches codegen. TS uses `indexMethod.value` directly
/// because a concrete type there already carries specialized methods (eager
/// instantiation); this is the faithful-equivalent for yo-self's lazy model.
///
/// `expected_type` is CLEARED around the call: the ambient expected type at the
/// index site is the auto-DEREFERENCED element type (e.g. `u8` for `(b : u8) =
/// al(i)`), but the index method itself returns `*(Output)` (`*(u8)`) — the deref
/// happens at the index-call layer, not inside the method. Leaving it set throws
/// "Cannot unify *(u8) and u8". The swallowing handler + `out`-param fallback
/// (the `_trial_eval_fn_body` idiom) keeps a throw for any other receiver type
/// from unwinding the caller's def-time body eval.
/// NOTE: a throw here unwinds straight to the CALLER of this fn (the swallow
/// handler's `unwind(())` exits `_specialize_index_method`), so `ctx.expected_type`
/// is saved/cleared/restored at the CALL SITE, not here — a restore line after
/// the call below would be skipped on the throw path and leak `None`.
_specialize_index_method :: (
  fn(mv : Option(EvalValue), mty : TypeValue, expr : AstExpr, caller_env : Environment, ctx : EvalContext, idx_expr : AstExpr, out : ArrayList(EvalValue)) -> unit
)({
  recv := match(expr,.FnCall(_, func, _, _, _) => func,.Atom(_, _) => expr);
  margs := ArrayList(AstExpr).new();
  _a0 := margs.push(recv);
  _a1 := margs.push(idx_expr);
  inner_exn := Exception(throw : ((_err) -> unwind(())));
  r := try_to_call_function_with_arguments(mv, mty, expr, recv, margs, caller_env, ctx, true, false, false, inner_exn);
  match(
    r.specialized_function_value,
    .Some(sv) => {
      _p := out.push(sv);
    },
    .None => ()
  );
});
// ---------------------------------------------------------------------------
// _find_comptime_index_method
// ---------------------------------------------------------------------------
/// Find a ComptimeIndex `index` method for a type. Same signature shape as
/// `_find_index_method` — `(self : *(Self) | inout(self) : Self, idx : ArgType)
/// -> *(Output)` — but BOTH parameters must carry the `comptime(...)` modifier.
///
/// Mirrors `findComptimeIndexMethod` (src/evaluator/calls/index-trait.ts:382-420).
///
/// TS reads the flag straight off the type: `selfParam.isCompileTimeOnly &&
/// idxParam.isCompileTimeOnly` (index-trait.ts:414). yo-self's `TypeValue.Func`
/// / `FuncMeta` carry NO per-parameter comptime bit (only `param_is_ref` /
/// `param_is_owning`) — the `comptime(name) : T` parameter modifier rides the
/// func-id-keyed side table `g_func_param_comptime`
/// (evaluator/types/function.yo:269-336): registered under the `fn(...)`
/// type-expression id by `evaluate_function_type`
/// (types/function.yo:3757) and re-keyed under the FuncVal id by
/// `try_to_implement_function_by_function_type`
/// (calls/function_type.yo:655). So the flags are read through the
/// candidate's METHOD VALUE (its FuncVal `func_id`) — which TS needs anyway
/// (`isFunctionValue(comptimeMethod.value)`, index-trait.ts:459). A candidate
/// with no FuncVal value has no registered flags and can never match; the
/// table is SPARSE (only registered when some parameter is comptime), so a
/// plain runtime `Index` impl reads back an empty list and is skipped.
_find_comptime_index_method :: (
  fn(
    concrete_type : TypeValue,
    arg_type : TypeValue,
    env : Environment
  ) -> Option(_IndexMethodEntry)
)({
  methods := _find_all_index_methods(concrete_type, env);
  n := methods.len();
  (i : usize) = usize(0);
  (found : Option(_IndexMethodEntry)) = Option(_IndexMethodEntry).None;
  while((i < n) && found.is_none(), {
    match(
      methods.get(i),
      .Some(m) => {
        match(
          m.method_type,
          .Func({ param_types, result : ci_result, meta : __cifm1 }) => {
            ci_param_is_ref := __cifm1.*.param_is_ref;
            if(param_types.len() == usize(2), {
              match(
                param_types.get(usize(0)),
                .Some(p0) => {
                  match(
                    param_types.get(usize(1)),
                    .Some(p1) => {
                      p0_is_ptr := is_pointer_type(p0);
                      p0_is_ref := match(
                        ci_param_is_ref.get(usize(0)),
                        .Some(b) => b,
                        .None => false
                      );
                      // `are_types_compatible(actual, expected)` — the ARGUMENT's type is the
                      // actual, the parameter's declared type is the expected. Passing
                      // them the other way round made the parameter type the "actual",
                      // so the comptime widening arms (types/compatibility.yo:124-146 for
                      // ComptimeInt, :171-190 for ComptimeString) — which all key off
                      // `actual` — never fired: `l(0)` on a `ComptimeIndex(usize)` impl was
                      // rejected with "Type does not implement Index for the given argument
                      // type" while `l(usize(0))` worked. TS spells the same check
                      // `areTypesCompatible({type: idxParam.type}, {type: argType})`
                      // (index-trait.ts:404-406), but ITS first position is `expected` and
                      // its second is `given` — the opposite order from yo-self's, so a
                      // faithful port must swap.
                      p1_compatible := are_types_compatible(arg_type, p1);
                      ret_is_ptr := is_pointer_type(ci_result);
                      if(((p0_is_ptr || p0_is_ref) && p1_compatible) && ret_is_ptr, {
                        // Comptime-parameter gate (TS index-trait.ts:414).
                        ci_flags := match(
                          m.method_value,
                          .Some(mv) => match(
                            mv,
                            .FuncVal(__cifvd1, _) => get_func_param_comptime(__cifvd1.*.func_id.clone()),
                            _ => ArrayList(bool).new()
                          ),
                          .None => ArrayList(bool).new()
                        );
                        self_is_ct := match(ci_flags.get(usize(0)),.Some(b) => b,.None => false);
                        idx_is_ct := match(ci_flags.get(usize(1)),.Some(b) => b,.None => false);
                        if(self_is_ct && idx_is_ct, {
                          found = Option(_IndexMethodEntry).Some(m);
                        });
                      });
                    },
                    .None => ()
                  );
                },
                .None => ()
              );
            });
          },
          _ => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
// ---------------------------------------------------------------------------
// _try_comptime_custom_type_index
// ---------------------------------------------------------------------------
/// Try to dispatch `value(arg)` through ComptimeIndex for a CUSTOM type
/// (struct / enum / tuple / ComptimeList — anything that is neither a comptime
/// array nor a comptime string). When a comptime value like `p :: Point(3, 4)`
/// is indexed with `p(0)`, the ComptimeIndex `index` method is EXECUTED at
/// compile time. Returns `.None` to fall through to runtime dispatch.
///
/// Mirrors `tryComptimeCustomTypeIndex` (src/evaluator/calls/index-trait.ts:427-620).
///
/// yo-self deltas, all forced by representation differences:
///   * TS sets up the callee env as `pushEnvFrame(fnType.env)`; yo-self's
///     `TypeValue.Func` carries no env, so the definition-time scope is
///     rebuilt from the FuncVal's flat capture snapshot
///     (`cap_names`/`cap_tys`/`cap_vals`) exactly as the ordinary FuncVal call
///     path does (calls/function.yo:3913-3933) — that IS yo-self's `fnType.env`.
///   * TS's `{...context, isValidatingFunctionDefinition: undefined}` spread
///     becomes save / set-false / restore on the shared mutable `ctx` (the
///     idiom `evaluate_comptime_fn_call` itself uses for its own context
///     overrides, calls/comptime_fn.yo:762-816). It is LOAD-BEARING: without
///     it `evaluate_comptime_fn_call` computes `ctx.is_executing =
///     !is_validating_function_definition` = false and
///     `evaluate_comptime_assert` takes its non-executing branch
///     (builtins/comptime_assert.yo:59), so an out-of-bounds ComptimeIndex arm
///     never throws and `comptime_expect_error(p(usize(2)))` reports
///     "Expected compile error, but the expression was evaluated successfully".
///     A throw skips the restore, but every enclosing swallow already restores
///     it (`evaluate_comptime_expect_error` snapshots it explicitly,
///     builtins/comptime_expect_error.yo:107/135, and the def-time trial eval
///     runs on a COPIED EvalContext, calls/function_type.yo:724).
///   * TS returns `undefined` for a runtime argument (`!evaluatedArgExpr.$.value`);
///     yo-self represents a runtime argument as `Some(UnknownVal(...))`, so the
///     unknown case is rejected explicitly — otherwise CTFE's own unknown-arg
///     gate (comptime_fn.yo:572-583) would hand back an `UnknownVal` and this
///     function would swallow the runtime dispatch path.
_try_comptime_custom_type_index :: (
  fn(
    expr : AstExpr,
    arg_expr : AstExpr,
    self_value : EvalValue,
    value_type : TypeValue,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(IndexCallResult)
)({
  // Evaluate the argument (TS index-trait.ts:441-450); expected_type cleared
  // around the arg eval — see _try_comptime_array_index.
  cci_saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_arg := evaluate_expression(arg_expr, caller_env, ctx);
  ctx.expected_type = cci_saved_expected;
  arg_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg)),
    .Some(i) => i,
    .None => {
      return(Option(IndexCallResult).None);
    }
  );
  arg_value := match(
    arg_info.value,
    .Some(v) => v,
    .None => {
      return(Option(IndexCallResult).None);
    }
  );
  // Runtime argument — fall through (see the header note on UnknownVal).
  if(is_unknown_val(arg_value), {
    return(Option(IndexCallResult).None);
  });
  ct_caller_env := arg_info.env;
  arg_type := arg_info.ty;
  // Find a ComptimeIndex method (TS index-trait.ts:456-465).
  ct_method := match(
    _find_comptime_index_method(value_type, arg_type, ct_caller_env),
    .Some(m) => m,
    .None => {
      return(Option(IndexCallResult).None);
    }
  );
  ct_fn_type := ct_method.method_type;
  // TS index-trait.ts:459 `!isFunctionValue(comptimeMethod.value)` -> fall through.
  if(ct_method.method_value.is_none(), {
    return(Option(IndexCallResult).None);
  });
  ct_fn_value := match(ct_method.method_value,.Some(mv) => mv,.None => EvalValue.UnitVal);
  if(!(is_func_val(ct_fn_value)), {
    return(Option(IndexCallResult).None);
  });
  // The return type must be `*(Output)` (TS index-trait.ts:539-545).
  ct_ret_type := match(ct_fn_type,.Func({ result : ct_r }) => ct_r, _ => t_unit());
  if(!(is_pointer_type(ct_ret_type)), {
    return(Option(IndexCallResult).None);
  });
  output_ty := match(ct_ret_type,.Pointer(ct_pt) => ct_pt, _ => ct_ret_type);
  // Comptime pointer to self for the first argument (TS index-trait.ts:475-476).
  self_ptr_type := t_ptr(value_type);
  // Fresh 1-elem cell around self (TS index-trait.ts:472
  // `createPtrValue(selfPtrType, [selfValue])`).
  self_ptr_cell := ArrayList(EvalValue).new();
  self_ptr_cell.push(self_value);
  self_ptr_value := EvalValue.PtrVal(self_ptr_cell, usize(0));
  ct_p0_ty := match(
    ct_fn_type,
    .Func({ param_types : ct_pts0 }) => match(ct_pts0.get(usize(0)),.Some(t) => t,.None => t_unit()),
    _ => t_unit()
  );
  ct_p1_ty := match(
    ct_fn_type,
    .Func({ param_types : ct_pts1 }) => match(ct_pts1.get(usize(1)),.Some(t) => t,.None => t_unit()),
    _ => t_unit()
  );
  ct_p0_label := match(
    ct_fn_type,
    .Func({ meta : __cifm2 }) => match(__cifm2.*.param_labels.get(usize(0)),.Some(l) => l,.None => String.from("self")),
    _ => String.from("self")
  );
  ct_p1_label := match(
    ct_fn_type,
    .Func({ meta : __cifm3 }) => match(__cifm3.*.param_labels.get(usize(1)),.Some(l) => l,.None => String.from("idx")),
    _ => String.from("idx")
  );
  // Rebuild the method's definition-time scope from its capture snapshot, then
  // push a frame with `self` / `idx` bound (TS index-trait.ts:481-508).
  ct_cap_names := match(ct_fn_value,.FuncVal(__cifvd2, _) => __cifvd2.*.cap_names, _ => ArrayList(String).new());
  ct_cap_tys := match(ct_fn_value,.FuncVal(__cifvd3, _) => __cifvd3.*.cap_tys, _ => ArrayList(TypeValue).new());
  ct_cap_vals := match(ct_fn_value,.FuncVal(_, __cicv) => __cicv, _ => ArrayList(EvalValue).new());
  ct_module_path := ct_caller_env.module_path;
  ct_callee_env := Environment.new(ct_module_path);
  (ct_ci : usize) = usize(0);
  while(ct_ci < ct_cap_names.len(), {
    ct_cn := match(ct_cap_names.get(ct_ci),.Some(nm) => nm,.None => String.from(""));
    ct_cty := match(ct_cap_tys.get(ct_ci),.Some(t) => t,.None => t_unit());
    ct_cv := match(ct_cap_vals.get(ct_ci),.Some(v) => Option(EvalValue).Some(v),.None => Option(EvalValue).None);
    ct_cv_is_ct := match(ct_cv,.Some(_) => true,.None => false);
    _ct_add_cap := add_variable_to_env(
      ct_callee_env,
      ct_cn.clone(),
      ct_cty,
      ct_cv,
      ct_cv_is_ct,
      false,
      false,
      false,
      synthetic_token(ct_cn, ct_module_path)
    );
    ct_ci = (ct_ci + usize(1));
  });
  _ct_frame := ct_callee_env.push_frame(false);
  ct_param_token := ast_expr_token(
    match(expr,.FnCall(_, ct_func_slot, _, _, _) => ct_func_slot,.Atom(_, _) => expr)
  );
  _ct_add_self := add_variable_to_env(
    ct_callee_env,
    ct_p0_label.clone(),
    ct_p0_ty,
    Option(EvalValue).Some(self_ptr_value),
    true,
    false,
    false,
    false,
    ct_param_token
  );
  _ct_add_idx := add_variable_to_env(
    ct_callee_env,
    ct_p1_label.clone(),
    ct_p1_ty,
    Option(EvalValue).Some(arg_value),
    true,
    false,
    false,
    false,
    ct_param_token
  );
  ct_args := ArrayList(ArgEntry).new();
  _ct_a0 := ct_args.push(
    ArgEntry(
      value : Option(EvalValue).Some(self_ptr_value),
      parameter_type : ct_p0_ty,
      arg_type : self_ptr_type
    )
  );
  _ct_a1 := ct_args.push(
    ArgEntry(
      value : Option(EvalValue).Some(arg_value),
      parameter_type : ct_p1_ty,
      arg_type : arg_type
    )
  );
  ct_arg_values := ArgValues(
    forall_args : ArrayList(ArgEntry).new(),
    args : ct_args,
    implicit_args : Option(ArrayList(ArgEntry)).None,
    variadic_args : ArrayList(VarArgEntry).new()
  );
  // Execute the ComptimeIndex method (TS index-trait.ts:510-535). The
  // validation override is what makes the body actually run — see the header.
  ct_saved_validating := ctx.is_validating_function_definition;
  ctx.is_validating_function_definition = false;
  ct_result := evaluate_comptime_fn_call(
    Option(AstExpr).Some(match(expr,.FnCall(_, ct_func_slot2, _, _, _) => ct_func_slot2,.Atom(_, _) => expr)),
    ct_fn_type,
    ct_fn_value,
    ct_arg_values,
    ct_caller_env,
    ct_callee_env,
    ctx,
    exn
  );
  ctx.is_validating_function_definition = ct_saved_validating;
  ct_return_value := ct_result.value;
  // Also record the RUNTIME index method for codegen (TS index-trait.ts:578-583
  // and 601-605).
  ct_rt_method := _find_index_method(value_type, arg_type, ct_caller_env);
  ct_rt_method_type := match(ct_rt_method,.Some(rm) => Option(TypeValue).Some(rm.method_type),.None => Option(TypeValue).None);
  ct_rt_method_value := match(ct_rt_method,.Some(rm) => rm.method_value,.None => Option(EvalValue).None);
  // A PtrVal return derefs to the pointed-at element/field and yields the
  // ComptimeRef that makes `p(0) = v` and `&(p(0))` comptime places
  // (TS index-trait.ts:549-576).
  //
  // NOTE: yo-self's `&(self.x)` builds `PtrVal(ArrayVal(field_values), i)` —
  // it wraps the struct's field list in an `ArrayVal` "to enable indexed
  // access" (builtins/ptr_fns.yo:151) — so the ArrayVal arm below is the one
  // that fires for a struct receiver, and `ComptimeRef.ArrayRef` over the
  // SHARED `field_values` handle mutates the struct in place exactly as
  // `StructRef` would (exprs/assignment.yo:672-678). The StructVal / TupleVal
  // arms are ported for the paths that hand back an unwrapped target.
  match(
    ct_return_value,
    .PtrVal(ct_target_cell, ct_index) => {
      ct_target := match(ct_target_cell.get(usize(0)),.Some(t0) => t0,.None => EvalValue.UnitVal);
      (ct_deref : EvalValue) = ct_target;
      (ct_cref : Option(ComptimeRef)) = Option(ComptimeRef).None;
      match(
        ct_target,
        .ArrayVal(ct_elements) => {
          ct_deref = match(ct_elements.get(ct_index),.Some(e) => e,.None => ct_target);
          ct_cref = Option(ComptimeRef).Some(ComptimeRef.ArrayRef(ct_elements, ct_index));
        },
        .StructVal(_, _, ct_fields_s) => {
          ct_deref = match(ct_fields_s.get(ct_index),.Some(e) => e,.None => ct_target);
          ct_cref = Option(ComptimeRef).Some(ComptimeRef.StructRef(ct_fields_s, ct_index));
        },
        .TupleVal(ct_fields_t) => {
          ct_deref = match(ct_fields_t.get(ct_index),.Some(e) => e,.None => ct_target);
          ct_cref = Option(ComptimeRef).Some(ComptimeRef.TupleRef(ct_fields_t, ct_index));
        },
        _ => ()
      );
      return(
        Option(IndexCallResult).Some(
          IndexCallResult(
            value : Option(EvalValue).Some(ct_deref),
            ty : output_ty,
            ptr_type : ct_ret_type,
            index_method_type : ct_rt_method_type,
            index_method_value : ct_rt_method_value,
            caller_env : ct_caller_env,
            index : Option(usize).None,
            comptime_ref : ct_cref
          )
        )
      );
    },
    _ => ()
  );
  // Not a PtrVal (e.g. an UnknownVal from a skipped CTFE, or a builtin like
  // `__yo_comptime_list_index` that returns the element directly)
  // — TS index-trait.ts:598-616: propagate `result.comptimeRef` from the
  // comptime function call so `l(0) = v` treats the result as a comptime place.
  Option(IndexCallResult).Some(
    IndexCallResult(
      value : Option(EvalValue).Some(ct_return_value),
      ty : output_ty,
      ptr_type : ct_ret_type,
      index_method_type : ct_rt_method_type,
      index_method_value : ct_rt_method_value,
      caller_env : ct_caller_env,
      index : Option(usize).None,
      comptime_ref : ct_result.comptime_ref
    )
  )
});
// ---------------------------------------------------------------------------
// try_to_call_with_index_trait
// ---------------------------------------------------------------------------
/// Dispatch `value(arg)` via the Index trait.
///
/// Desugars: `value(arg)` → `Index(typeof(arg)).index(&(value), arg).*`
///
/// Mirrors `tryToCallWithIndexTrait` in `src/evaluator/calls/index-trait.ts`.
try_to_call_with_index_trait :: (
  fn(
    expr : AstExpr,
    value_type : TypeValue,
    self_value : Option(EvalValue),
    arg_exprs : ArrayList(AstExpr),
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> IndexCallResult
)({
  // 1. Exactly 1 argument required
  if(arg_exprs.len() != usize(1), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Index trait expects exactly 1 argument, got ${arg_exprs.len()}.`,
          false,
          .None
        )
      )
    );
  });
  arg_expr := match(
    arg_exprs.get(usize(0)),
    .Some(e) => e,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("Index trait: missing argument"),
            false,
            .None
          )
        )
      );
      make_err_expr()
    }
  );
  // 2. Extract comptime values from self
  array_val := match(
    self_value,
    .Some(v) => if(
      is_array_val(v),
      Option(EvalValue).Some(v),
      Option(EvalValue).None
    ),
    .None => Option(EvalValue).None
  );
  string_raw_opt := match(
    self_value,
    .Some(v) => match(
      v,
      .StrLit(r) => Option(String).Some(r),
      _ => Option(String).None
    ),
    .None => Option(String).None
  );
  has_array_or_slice := array_val.is_some();
  is_arr_or_slice_ty := is_array_type(value_type);
  // 3. Comptime array/slice path
  if(has_array_or_slice && is_arr_or_slice_ty, {
    ct_result := _try_comptime_array_index(
      arg_expr,
      array_val,
      value_type,
      caller_env,
      ctx,
      exn
    );
    match(
      ct_result,
      .Some(r) => {
        return(r);
      },
      .None => ()
    );
  });
  // 4. Comptime string path
  match(
    string_raw_opt,
    .Some(raw) => {
      rn := raw.len();
      str_unquoted := if(
        rn >= usize(2),
        str_lit_unquote_bytes(raw),
        String.new()
      );
      result := _try_comptime_string_index(arg_expr, str_unquoted, caller_env, ctx, exn);
      return(result);
    },
    .None => ()
  );
  // 5. Comptime values of CUSTOM types (structs, enums, tuples, ComptimeList):
  //    try ComptimeIndex dispatch. Handles types like `Point` that implement
  //    `ComptimeIndex(usize)`. Mirrors TS index-trait.ts:255-274.
  match(
    self_value,
    .Some(sv_ct) => if((!(is_unknown_val(sv_ct)) && array_val.is_none()) && string_raw_opt.is_none(), {
      match(
        _try_comptime_custom_type_index(
          expr,
          arg_expr,
          sv_ct,
          value_type,
          caller_env,
          ctx,
          exn
        ),
        .Some(ct_r) => {
          return(ct_r);
        },
        .None => ()
      );
    }),
    .None => ()
  );
  // 6. Runtime path: evaluate arg to get its type. `expected_type` is CLEARED
  // around the arg eval — the ambient expected type at the index site is the
  // ELEMENT type (e.g. `u8` for `(b : u8) = al(i - usize(1))`), and leaking it
  // into the ARGUMENT's operator call made the `-` overload synthesis throw
  // "Cannot unify incompatible types: usize and u8" (swallowed by the no-exn
  // wrapper — the std/string/string.yo `trim` noise-baseline line). TS passes
  // `expectedType: undefined` here (index-trait.ts:278-284).
  rt_arg_saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_arg := evaluate_expression(arg_expr, caller_env, ctx);
  ctx.expected_type = rt_arg_saved_expected;
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg));
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate index argument"),
            false,
            .None
          )
        )
      );
      new_expr_info(caller_env, t_unit())
    }
  );
  updated_env := arg_info.env;
  // For array/slice: derive element type directly from TypeValue (no method lookup needed)
  if(is_arr_or_slice_ty, {
    elem_ty := match(
      value_type,
      .Array(et, _, _) => et,
      _ => t_unit()
    );
    result_val := create_unknown_val(elem_ty);
    return(
      IndexCallResult(
        value : Option(EvalValue).Some(result_val),
        ty : elem_ty,
        ptr_type : t_ptr(elem_ty),
        index_method_type : Option(TypeValue).None,
        index_method_value : Option(EvalValue).None,
        caller_env : updated_env,
        index : Option(usize).None,
        comptime_ref : Option(ComptimeRef).None
      )
    );
  });
  // For custom types: find the index method via trait lookup
  arg_type := arg_info.ty;
  method_opt := _find_index_method(value_type, arg_type, caller_env);
  method := match(
    method_opt,
    .Some(m) => m,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("Type does not implement Index for the given argument type."),
            false,
            .None
          )
        )
      );
      _IndexMethodEntry(
        method_type : t_unit(),
        method_value : Option(EvalValue).None
      )
    }
  );
  // Get the output type: index method returns *(Output), deref to get Output
  ret_ty := match(
    method.method_type,
    .Func({ result : result_box }) => result_box,
    _ => t_unit()
  );
  output_ty := match(
    ret_ty,
    .Pointer(et) => et,
    _ => ret_ty
  );
  // Runtime dispatch through a trait method — TS marks the result
  // `isRuntimeOnly` "so overload resolution doesn't prefer comptime functions"
  // (index-trait.ts:321-328).
  result_val := create_runtime_unknown_val(output_ty);
  // Specialize the index method so codegen has an emittable concrete FuncVal (see
  // _specialize_index_method). On any failure, fall back to the generic value
  // (no worse than before — the codegen branch then references an unemitted fn).
  // expected_type is cleared around the call (the method returns *(Output), the
  // ambient expected type is the dereferenced Output) and restored here so a
  // swallowed throw inside the helper cannot leak `None` into later evaluation.
  spec_out := ArrayList(EvalValue).new();
  saved_idx_exp := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  match(
    method.method_value,
    .Some(_) => _specialize_index_method(method.method_value, method.method_type, expr, caller_env, ctx, arg_expr, spec_out),
    .None => ()
  );
  ctx.expected_type = saved_idx_exp;
  spec_method_value := match(spec_out.get(usize(0)),.Some(sv) => Option(EvalValue).Some(sv),.None => method.method_value);
  IndexCallResult(
    value : Option(EvalValue).Some(result_val),
    ty : output_ty,
    ptr_type : t_ptr(output_ty),
    index_method_type : Option(TypeValue).Some(method.method_type),
    index_method_value : spec_method_value,
    caller_env : updated_env,
    index : Option(usize).None,
    comptime_ref : Option(ComptimeRef).None
  )
});
// ---------------------------------------------------------------------------
// has_index_impl
// ---------------------------------------------------------------------------
/// Check if a type has any matching Index impl for a given set of argument expressions.
///
/// Array/Slice fast path; custom types resolve `index` methods through the
/// trait-field scan + trait-methods registry (generic-impl fallback included).
///
/// Mirrors `hasIndexImpl` in `src/evaluator/calls/index-trait.ts`.
has_index_impl :: (
  fn(
    concrete_type : TypeValue,
    arg_exprs : ArrayList(AstExpr),
    caller_env : Environment,
    ctx : EvalContext
  ) -> bool
)({
  ctx;
  if(arg_exprs.len() != usize(1), {
    return(false);
  });
  // Fast path: Array always has an Index impl
  if(is_array_type(concrete_type), {
    return(true);
  });
  // Trait-field + registry/generic-impl method lookup.
  methods := _find_all_index_methods(concrete_type, caller_env);
  methods.len() > usize(0)
});
export(try_to_call_with_index_trait);
export(has_index_impl);
