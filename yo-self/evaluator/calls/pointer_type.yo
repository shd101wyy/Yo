//! evaluator/calls/pointer_type — stub for try_to_convert_to_pointer_type.
//!
//! Phase 2x stub. Full implementation planned for Phase 3.
//! 1:1 port of `src/evaluator/calls/pointer-type.ts`.
//!
//! `try_to_convert_to_pointer_type` attempts to cast an argument expression to
//! a pointer type via a type-level pointer conversion (e.g. comptime_string → *(u8)).

open import "std/string";

{ AstExpr, ast_expr_token, make_err_expr } :: import "../../expr/expr.yo";
{ Environment }                            :: import "../../env/env.yo";
{ TypeValue }                              :: import "../../types/type.yo";
{ EvalContext }                            :: import "../context.yo";
{ format_error_message }                   :: import "../../error/error.yo";
{ Exception }                              :: import "std/error";

/// Attempt to cast `arg_expr` to `target_type` as a pointer-type conversion.
/// Returns `.None` if `target_type` is not a pointer type.
///
/// Phase 2x stub: throws "not yet implemented". Full implementation in Phase 3.
///
/// Mirrors `tryToConvertToPointerType` in `src/evaluator/calls/pointer-type.ts`.
try_to_convert_to_pointer_type :: (fn(
  target_type : TypeValue,
  arg_expr    : AstExpr,
  expr        : AstExpr,
  caller_env  : Environment,
  ctx         : *(EvalContext),
  using(exn   : Exception)
) -> Option(AstExpr))({
  _ := target_type;
  _ := arg_expr;
  _ := caller_env;
  _ := ctx;
  exn.throw(dyn format_error_message(
    ast_expr_token(expr),
    String.from("try_to_convert_to_pointer_type: not yet implemented (Phase 3)"),
    false,
    .None
  ));
  Option(AstExpr).None
});

export try_to_convert_to_pointer_type;
