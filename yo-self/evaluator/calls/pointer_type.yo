//! evaluator/calls/pointer_type — try_to_convert_to_pointer_type.
//!
//! 1:1 port of `src/evaluator/calls/pointer-type.ts`.
//!
//! `*(T)(val)` pointer cast: handles comptime_str → *(u8) / *(char)
//! and runtime pointer → pointer via `__yo_as`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  make_err_expr,
  alloc_global_expr_id,
  BF_YO_AS,
  ExprId
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_pointer_type } :: import("../../types/guards.yo");
{ is_comptime_string_type, is_u8_type, is_char_type } :: import("../../types/guards.yo");
{ convert_comptime_type_to_runtime_type, convert_comptime_type_to_runtime_type_with_expected } :: import("../../types/env_lookup.yo");
{ type_to_string } :: import("../../types/string.yo");
{ EvalContext } :: import("../context.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ format_error_message } :: import("../../error.yo");
{ Token, TokenKind } :: import("../../token.yo");
{ Exception } :: import("std/error");
/// Attempt to cast `arg_expr` to `target_type` as a pointer-type conversion.
/// Returns `.None` if `target_type` is not a pointer type.
///
/// Handles two cases:
///   1. `comptime_str` → `*(u8)` or `*(char)`: converts type info, keeps string value.
///   2. Any pointer → pointer: emits a `__yo_as(arg, TargetType)` runtime cast.
///
/// Mirrors `tryToConvertToPointerType` in `src/evaluator/calls/pointer-type.ts`.
try_to_convert_to_pointer_type :: (
  fn(
    target_type : TypeValue,
    arg_expr : AstExpr,
    expr : AstExpr,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(AstExpr)
)({
  if(!(is_pointer_type(target_type)), {
    return(Option(AstExpr).None);
  });
  // Evaluate the argument with no expectedType.
  saved_expected := ctx.expected_type;
  ctx.expected_type =.None;
  evaluated := evaluate_expression(arg_expr, caller_env, ctx);
  ctx.expected_type = saved_expected;
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  if(info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `Failed to evaluate argument: ${ast_expr_to_string(arg_expr)}`,
          false,
          .None
        )
      )
    );
  });
  arg_info := match(info_opt,.Some(i) => i,.None => new_expr_info(caller_env, target_type));
  env := arg_info.env;
  arg_type := arg_info.ty;
  // -----------------------------------------------------------------------
  // Case 1: comptime_str → *(u8) or *(char)
  // -----------------------------------------------------------------------
  is_ptr_u8_or_char := match(
    target_type,
    .Pointer(inner) => cond(
      is_u8_type(inner.*) => true,
      is_char_type(inner.*) => true,
      true => false
    ),
    _ => false
  );
  if(is_comptime_string_type(arg_type) && is_ptr_u8_or_char, {
    // Convert WITH the target as the expected type (pointer-type.ts:69
    // passes `expectedType: targetType`) — the no-expected conversion
    // yields `str`, so `*(u8)("[")` typed str and the enclosing
    // `*(void)(...)` cast rejected it (std/log.yo's fwrite calls).
    converted_ty := convert_comptime_type_to_runtime_type_with_expected(arg_type, Option(TypeValue).Some(target_type), env);
    out_info := new_expr_info(env, converted_ty);
    out_info.value = arg_info.value;
    out_info.converted_runtime_type =.Some(converted_ty);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    // Annotate the ARG node too — this helper returns `evaluated` (the
    // arg), and callers read the RETURNED node's info; leaving the arg's
    // original comptime_str info made nested casts like
    // `*(void)(*(u8)("["))` see comptime_str and reject. Mirrors TS
    // setting `evaluatedArg.$` to the converted data before
    // Object.assign-ing it onto the cast expr (pointer-type.ts:76-85).
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(evaluated), out_info);
    return(.Some(evaluated));
  });
  // -----------------------------------------------------------------------
  // Case 2: pointer → pointer via __yo_as
  // -----------------------------------------------------------------------
  if(!(is_pointer_type(arg_type)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `Cannot cast ${type_to_string(arg_type)} to ${type_to_string(target_type)}. Expected a pointer type or comptime_str.`,
          false,
          .None
        )
      )
    );
  });
  orig_tok := ast_expr_token(expr);
  orig_id := ast_expr_id(expr);
  type_expr := match(
    expr,
    .FnCall(_, func_box, _, _, _) => func_box.*,
    .Atom(_, _) => make_err_expr()
  );
  // Lower the runtime pointer→pointer cast to a `__yo_as` node, attached to the
  // ORIGINAL expr's ExprInfo as a `macro_expansion`. Codegen walks the original
  // parsed node (which keeps its `*(T)(...)` structure — codegen does NOT see
  // returned rewrites), so the lowering must travel via the original node's
  // ExprInfo. Mirrors TS `replaceExprWithFuncCallExpr` (in-place mutation), which
  // yo-self can't do on the enum node, so it uses the existing macro_expansion
  // mechanism (codegen checks it before structural dispatch). The `__yo_as` node
  // gets a FRESH id so codegen's re-dispatch onto it does not re-trigger the same
  // macro_expansion (infinite loop).
  fresh_id := alloc_global_expr_id();
  func_atom := AstExpr.Atom(
    alloc_global_expr_id(),
    Token(
      kind : TokenKind.Identifier,
      value : String.from(BF_YO_AS),
      row : orig_tok.row,
      column : orig_tok.column,
      character : orig_tok.character,
      module_path : orig_tok.module_path.clone(),
      input : orig_tok.input.clone()
    )
  );
  call_args := ArrayList(AstExpr).new();
  call_args.push(evaluated);
  call_args.push(type_expr);
  yo_as_node := AstExpr.FnCall(fresh_id, box(func_atom), call_args, false, orig_tok);
  yo_as_info := new_expr_info(env, target_type);
  yo_as_info.value =.None;
  // runtimeArgExprsInOrder: only the value arg (not the type) — mirrors TS
  rt_args := ArrayList(AstExpr).new();
  rt_args.push(evaluated);
  yo_as_info.runtime_arg_exprs_in_order =.Some(rt_args);
  expr_info_table_set(ctx.expr_info_table, fresh_id, yo_as_info);
  out_info := new_expr_info(env, target_type);
  out_info.value =.None;
  out_info.macro_expansion = Option(AstExpr).Some(yo_as_node);
  expr_info_table_set(ctx.expr_info_table, orig_id, out_info);
  .Some(expr)
});
export(try_to_convert_to_pointer_type);
