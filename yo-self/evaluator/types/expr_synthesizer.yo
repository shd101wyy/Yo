//! expr_synthesizer — infer a concrete type for expressions involving `_`
//! placeholders or type applications.
//!
//! Phase 2w stub: returns `expr`, `ty`, and `env` unchanged.
//!
//! In the full evaluator (Phase 3), this will handle cases such as:
//!   - `_ := SomeVariant` where the RHS is an enum-discriminant call
//!   - partial-type tuples containing `_`
//!
//! Mirrors `synthesizeExprAndType` in
//! `src/evaluator/types/expr-synthesizer.ts`.
open(import("std/string"));
{ AstExpr } :: import("../../expr.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ TypeValue } :: import("../../types/definitions.yo");
// ---------------------------------------------------------------------------
// Return type
// ---------------------------------------------------------------------------
/// Holds the (possibly updated) expr, resolved type, and environment after
/// synthesis.  Mirrors the anonymous return type of `synthesizeExprAndType`
/// in TypeScript.
SynthesizeResult :: ref(
  struct(
    expr : AstExpr,
    ty : TypeValue,
    env : Environment
  )
);
// ---------------------------------------------------------------------------
// synthesize_expr_and_type
// ---------------------------------------------------------------------------
/// Attempt to infer a concrete type for `expr` given the expected type `ty`.
///
/// Phase 2w stub: returns `expr`, `ty`, and `env` unchanged.
///
/// Mirrors `synthesizeExprAndType` in
/// `src/evaluator/types/expr-synthesizer.ts`.
synthesize_expr_and_type :: (
  fn(
    expr : AstExpr,
    ty : TypeValue,
    env : Environment,
    _ctx : EvalContext
  ) -> SynthesizeResult
)(
  SynthesizeResult(expr : expr, ty : ty, env : env)
);
export(SynthesizeResult, synthesize_expr_and_type);
