//! trait_registry.yo — global auto-derive trait registry.
//!
//! Holds the `g_type_trait_registry` HashMap mapping type id → list of
//! auto-derived trait names. Lives in a standalone file to avoid the circular
//! import that would arise if this were in `field.yo` (which imports from
//! `trait_checking.yo`) while `trait_checking.yo` queries the registry.
//!
//! Exported:
//!   register_type_trait(type_id, trait_name)
//!   is_type_registered_as_trait(type_id, trait_name) -> bool
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
// ---------------------------------------------------------------------------
// Global type-trait registry
// ---------------------------------------------------------------------------
/// Maps type id → list of trait names auto-derived for that type.
/// Populated by `utils.yo` during struct/enum/union type construction.
/// Queried by `type_implements_trait` step 4 in `trait_checking.yo`.
(g_type_trait_registry : HashMap(String, ArrayList(String))) = HashMap(String, ArrayList(String)).new();
/// Register that the type with `type_id` auto-derives the trait named `trait_name`.
///
/// Called during struct/enum/union construction by `utils.yo`.
register_type_trait :: (fn(type_id : String, trait_name : str) -> unit)({
  match(
    g_type_trait_registry.get(type_id),
    .Some(list) => {
      _push := list.push(String.from(trait_name));
    },
    .None => {
      new_list := ArrayList(String).new();
      _push2 := new_list.push(String.from(trait_name));
      _set := g_type_trait_registry.set(type_id, new_list);
    }
  );
});
/// Check whether `type_id` is registered as implementing the trait named `trait_name`.
///
/// Called from `type_implements_trait` step 4 in `trait_checking.yo`.
is_type_registered_as_trait :: (fn(type_id : String, trait_name : str) -> bool)(
  match(
    g_type_trait_registry.get(type_id),
    .None => false,
    .Some(list) => {
      n := list.len();
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < n) && !(found), {
        name := match(list.get(i),.Some(n2) => n2,.None => String.from(""));
        if(name == trait_name, {
          found = true;
        });
        i = (i + usize(1));
      });
      found
    }
  )
);
export(register_type_trait, is_type_registered_as_trait);
