//! evaluator/types/macro_registry — global registry for macro detection.
//!
//! TypeScript stores macro-ness via the `FunctionType` fields:
//!   - `parameter.isQuote: boolean` — for `quote(name) : Expr` parameters
//!   - `returnType.isUnquote: boolean` — for `unquote(Expr)` return types
//!
//! In yo-self, `TypeValue.Func` does not have these flags, so we use global
//! HashMaps keyed by `func_id` (a String) instead.
//!
//! A function is treated as a macro if either:
//!   1. Its return type is `unquote(...)` (return_is_unquote = true), OR
//!   2. It has at least one quoted parameter (quoted_param_indices non-empty).
//!
//! Phase 6a: scaffolding only — registration sites populate these maps; call
//! dispatch will use them in Phase 6c to skip arg evaluation for quoted params
//! and re-evaluate the returned `QuotedExpr` AST in the caller's env.
//!
//! Mirrors `parameter.isQuote` and `returnType.isUnquote` on `FunctionType`
//! in `src/evaluator/types/function.ts`.
open(import("std/string"));
{ HashMap } :: import("std/collections/hash_map");
{ ArrayList } :: import("std/collections/array_list");
// ---------------------------------------------------------------------------
// Global registries
// ---------------------------------------------------------------------------
/// Global map from `func_id` → list of parameter indices that are quoted.
/// Absent entry means no quoted parameters.
(g_macro_quoted_param_indices : HashMap(String, ArrayList(usize))) = HashMap(String, ArrayList(usize)).new();
/// Global map from `func_id` → true if return type is `unquote(...)`.
/// Absent entry means return is not an unquote.
(g_macro_return_is_unquote : HashMap(String, bool)) = HashMap(String, bool).new();
// ---------------------------------------------------------------------------
// Registration
// ---------------------------------------------------------------------------
/// Register the list of quoted parameter indices for a function.
/// Idempotent: repeated calls overwrite the previous entry.
register_macro_quoted_params :: (fn(func_id : String, indices : ArrayList(usize)) -> unit)({
  cond(
    (indices.len() > usize(0)) => {
      ___ := g_macro_quoted_param_indices.set(func_id.clone(), indices);
    },
    true => ()
  );
});
/// Mark a function as having an `unquote(...)` return type.
/// Idempotent.
register_macro_return_is_unquote :: (fn(func_id : String) -> unit)({
  ___ := g_macro_return_is_unquote.set(func_id.clone(), true);
});
// ---------------------------------------------------------------------------
// Lookups
// ---------------------------------------------------------------------------
/// Returns the list of quoted parameter indices, or an empty list if none.
get_macro_quoted_param_indices :: (fn(func_id : str) -> ArrayList(usize))(
  match(
    g_macro_quoted_param_indices.get(String.from(func_id)),
    .Some(idxs) => idxs,
    .None => ArrayList(usize).new()
  )
);
/// Returns true if the function's return type is `unquote(...)`.
macro_return_is_unquote :: (fn(func_id : str) -> bool)(
  match(
    g_macro_return_is_unquote.get(String.from(func_id)),
    .Some(_) => true,
    .None => false
  )
);
/// Convenience: returns true if the function is a macro
/// (has quoted params OR returns unquote).
is_macro_fn :: (fn(func_id : str) -> bool)(
  cond(
    macro_return_is_unquote(func_id) => true,
    true => match(
      g_macro_quoted_param_indices.get(String.from(func_id)),
      .Some(idxs) => (idxs.len() > usize(0)),
      .None => false
    )
  )
);
/// Returns true if the parameter at `param_index` is quoted for `func_id`.
is_param_quoted :: (fn(func_id : str, param_index : usize) -> bool)(
  match(
    g_macro_quoted_param_indices.get(String.from(func_id)),
    .Some(idxs) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      n := idxs.len();
      while((i < n) && !(found), {
        match(
          idxs.get(i),
          .Some(idx) => cond(
            (idx == param_index) => {
              found = true;
            },
            true => ()
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .None => false
  )
);
export(
  register_macro_quoted_params,
  register_macro_return_is_unquote,
  get_macro_quoted_param_indices,
  macro_return_is_unquote,
  is_macro_fn,
  is_param_quoted
);
