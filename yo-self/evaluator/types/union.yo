//! evaluate_union_type — evaluates a `union(...)` type expression.
//!
//! 1:1 port of `src/evaluator/types/union.ts`.
//!
//! Builds a `TypeValue.Union` with the given field labels and types.
//! Validates that fields are runtime types and do not contain RC types.
//!
//! Stubs (deferred to Phase 3):
//!   - `auto_derive_send_for_union_type`
//!   - `auto_derive_acyclic_for_union_type`
//!   - `auto_derive_runtime_for_union_type`
//!   - `definedInModulePath` propagation (orphan rule checks)
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_UNION
} :: import("../../expr.yo");
{ new_expr_info, expr_info_table_set } :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_type_value } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{
  TypeField,
  EvalTypeFieldResult,
  evaluate_type_field
} :: import("./field.yo");
{ random_id } :: import("../../utils.yo");
{ type_implements_runtime, type_is_comptime_only } :: import("../../types/utils.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ ArrayList } :: import("std/collections/array_list");
{ auto_derive_traits_for_union_type } :: import("./utils.yo");
evaluate_union_type :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env_mut : Environment) = env;
  if(!(ast_expr_is_fn_call_of(expr, BK_UNION, Option(usize).None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "union", got:\n${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  union_id := `union_${random_id(env_mut.module_path)}`;
  // Temporarily set SelfType so fields can reference Self.
  old_self_type := ctx.self_type;
  prelim_ty := TypeValue.Union(
    union_id.clone(),
    ArrayList(String).new(),
    ArrayList(TypeValue).new()
  );
  ctx.self_type = Option(TypeValue).Some(prelim_ty);
  // Collect fields.
  args := match(expr,.FnCall(_, _, a, _, _) => a,.Atom(_, _) => ArrayList(AstExpr).new());
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  fields := ArrayList(TypeField).new();
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg := match(args.get(i),.Some(a) => a,.None => make_err_expr());
    result := evaluate_type_field(arg, i, env_mut, ctx, "union", exn);
    field := result.field;
    // Check for duplicate labels.
    (dup_idx : usize) = usize(0);
    (has_dup : bool) = false;
    while((dup_idx < field_labels.len()) && !(has_dup), {
      existing := match(field_labels.get(dup_idx),.Some(l) => l,.None => String.from(""));
      if(existing == field.label, {
        has_dup = true;
      });
      dup_idx = (dup_idx + usize(1));
    });
    if(has_dup, {
      arg_args := match(arg,.FnCall(_, _, a2, _, _) => a2,.Atom(_, _) => ArrayList(AstExpr).new());
      err_tok := if(
        ast_expr_is_fn_call(arg),
        match(arg_args.get(usize(0)),.Some(fe) => ast_expr_token(fe),.None => ast_expr_token(arg)),
        ast_expr_token(arg)
      );
      exn.throw(
        dyn(
          format_error_message(
            err_tok,
            `Duplicate label "${field.label}" in union field.`,
            false,
            .None
          )
        )
      );
    });
    // Union type cannot have default values for fields.
    if(field.default_value.is_some(), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            String.from("Union type cannot have default value for its fields."),
            false,
            .None
          )
        )
      );
    });
    // Union fields must be runtime types.
    if(type_is_comptime_only(field.ty) || !(type_implements_runtime(field.ty)), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            String.from("Union type fields must be runtime types."),
            false,
            .None
          )
        )
      );
    });
    // Union fields cannot contain garbage-collected types.
    if(type_contains_rc_type(field.ty), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            String.from("Union type cannot have field with garbage-collected type."),
            false,
            .None
          )
        )
      );
    });
    field_labels.push(field.label.clone());
    field_types.push(field.ty);
    fields.push(field);
    env_mut.frames = result.env.frames;
    env_mut.module_path = result.env.module_path;
    env_mut.function_declaration_frame_level = result.env.function_declaration_frame_level;
    env_mut.input_string = result.env.input_string;
    i = (i + usize(1));
  });
  // Auto-derive trait markers (Send, Acyclic, Comptime, Runtime).
  // Mirrors `autoDeriveTraitsForUnionType` in TypeScript.
  auto_derive_traits_for_union_type(union_id.clone(), field_types, env);
  // Restore SelfType.
  ctx.self_type = old_self_type;
  // Build final Union TypeValue.
  union_ty := TypeValue.Union(
    union_id.clone(),
    field_labels,
    field_types
  );
  union_val := create_type_value(union_ty);
  meta_ty := type_of_type(union_ty);
  out_info := new_expr_info(env_mut, meta_ty);
  out_info.value = Option(EvalValue).Some(union_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  // Annotate callee (expr.func) with same info (mirrors TS: expr.func.$ = expr.$).
  callee_expr := match(expr,.FnCall(_, fb, _, _, _) => fb,.Atom(_, _) => expr);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(callee_expr), out_info);
  expr
});
export(evaluate_union_type);
