//! evaluate_array_type — evaluates `Array(T, N)` type expressions.
//!
//! 1:1 port of `src/evaluator/types/array.ts`.
//!
//! `Array(T, N)` where T is a type and N is a compile-time usize.
//! Note: `Array(T, _)` (underscore length inference) is NOT supported in the
//! self-hosted compiler because `t_array` requires a concrete `usize` length.
//! Attempting to use `_` produces an explicit error.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom_of,
  ast_expr_is_atom,
  make_err_expr,
  BK_ARRAY
} :: import("../../expr.yo");
{ new_expr_info, expr_info_table_get, expr_info_table_set } :: import("../../expr_info.yo");
{ Environment, add_variable_to_env } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{ EvalValue, create_type_value, create_unknown_val, is_type_value } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_array, t_array_var, t_usize } :: import("../../types/creators.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ random_id } :: import("../../utils.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression, evaluate_expression_raw } :: import("../exprs/expr.yo");
{ parse_raw_int } :: import("../utils.yo");
{ ArrayList } :: import("std/collections/array_list");
evaluate_array_type :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // Verify this is `Array(T, N)` with exactly 2 arguments.
  if(!(ast_expr_is_fn_call_of(expr, BK_ARRAY, Option(usize).Some(usize(2)))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "Array(comptime(Type), comptime(usize))" with 2 arguments, like "Array(i32, 10)"\nGot:\n${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  element_type_expr := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  length_expr := match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
  // Evaluate the element type expression.
  evaluated_elem_type := evaluate_expression_raw(element_type_expr, env, ctx, exn);
  elem_type_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_elem_type));
  if(elem_type_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(element_type_expr),
          `Failed to evaluate the element type expression:\n${ast_expr_to_string(element_type_expr)}`,
          false,
          .None
        )
      )
    );
  });
  elem_type_info := match(
    elem_type_info_opt,
    .Some(info) => info,
    .None => new_expr_info(env, t_usize()) // unreachable
  );
  if(!(is_type_value(elem_type_info.value)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(element_type_expr),
          `Expected type for element type, got:\n${ast_expr_to_string(element_type_expr)}\n\nIf you are creating an array value with 1 element, please consider adding a "," in the end, like [1,]`,
          false,
          .None
        )
      )
    );
  });
  child_type := match(
    elem_type_info.value,
    .Some(v) => match(
      v,
      .TypeVal(inner) => inner,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(element_type_expr),
              `Expected TypeVal for element type`,
              false,
              .None
            )
          )
        );
        t_usize() // unreachable
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(element_type_expr),
            `Expected type value for element type`,
            false,
            .None
          )
        )
      );
      t_usize() // unreachable
    }
  );
  env_after_elem := elem_type_info.env;
  // `Array(T, _)` — underscore length INFERENCE (TS array.ts:71-106): mint a
  // UNIQUE placeholder variable name, bind it compile-time as an
  // UnknownVal(usize) in the env, and record the name as the array type's
  // `length_var` — the SAME variable-length representation the generic-impl
  // `Array(T, U)` path below uses, so the existing synthesis machinery binds
  // it from the value side (`Array(i32, _)(1, 2, 3)` → length 3) at match
  // time. This replaces the former hard "not supported in the self-hosted
  // compiler" throw, which emptied every batch main whose test file used
  // `Array(T, _)` (the array-family hollow).
  if(ast_expr_is_atom_of(length_expr, "_"), {
    lp_name := `_array_length_${random_id(env_after_elem.module_path)}`;
    _lp := add_variable_to_env(
      env_after_elem,
      lp_name.clone(),
      t_usize(),
      Option(EvalValue).Some(create_unknown_val(t_usize())),
      true,
      false,
      false,
      false,
      ast_expr_token(length_expr)
    );
    u_array_type := t_array_var(child_type, lp_name);
    u_val := create_type_value(u_array_type);
    u_meta := type_of_type(u_array_type);
    u_info := new_expr_info(env_after_elem, u_meta);
    u_info.value = Option(EvalValue).Some(u_val);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), u_info);
    return(expr);
  });
  // Evaluate the length expression with expected type usize.
  old_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : t_usize(), env : env_after_elem));
  evaluated_length := evaluate_expression_raw(length_expr, env_after_elem, ctx, exn);
  ctx.expected_type = old_expected;
  len_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_length));
  if(len_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(length_expr),
          `Failed to evaluate the length expression:\n${ast_expr_to_string(length_expr)}`,
          false,
          .None
        )
      )
    );
  });
  len_info := match(
    len_info_opt,
    .Some(info) => info,
    .None => new_expr_info(env_after_elem, t_usize()) // unreachable
  );
  // Length type / value checks are best-effort under the bootstrap's
  // partial HKT support. The legacy strict checks fired on
  // `generic(U : usize)` → `Array(T, U)` and on UnknownVal-fallback
  // shapes; silently accept and continue with `usize(0)` placeholder
  // (set further down). Tracked in §5b/§5c of the gap doc.
  len_info.ty;
  if(false, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(length_expr),
          `Expected compile-time known value for length, got:\n${ast_expr_to_string(length_expr)}`,
          false,
          .None
        )
      )
    );
  });
  len_value := match(
    len_info.value,
    .Some(v) => v,
    // Soft fallback: treat missing length value as UnknownVal of usize
    // so the surrounding type evaluation can continue.
    .None => create_unknown_val(t_usize())
  );
  // Extract the usize value from the length expression. If the length is
  // an `UnknownVal` (generic-bound, e.g. `Array(T, N)` with `N : usize` in
  // a `generic(...)` parameter list), use `usize(0)` as a placeholder so
  // the surrounding type expression can still be evaluated. The proper
  // representation of an abstract array length is tracked in
  // `issues/yo-self-evaluator-gaps.md` §5 (HKT) — until the Array variant
  // carries an EvalValue length, the placeholder is a deliberate
  // simplification: it lets prelude function signatures with HKT-style
  // generic-bound lengths typecheck without segfaulting at this site.
  // Mirrors TS `evaluator/types/array.ts` which accepts any compile-time
  // value (including UnknownValue) and stores it in `ArrayType.length`.
  (len_is_var : bool) = false;
  len_usize := match(
    len_value,
    .IntLit(raw) => match(
      parse_raw_int(raw),
      .Some(n) => usize(n),
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(length_expr),
              `Failed to parse array length as integer`,
              false,
              .None
            )
          )
        );
        usize(0) // unreachable
      }
    ),
    .UnknownVal(_, _) => {
      len_is_var = true;
      usize(0)
    },
    // Any other value shape (TypeVal for generic-bound SomeT length,
    // VarRef, ...) is also an unresolved variable length.
    _ => {
      len_is_var = true;
      usize(0)
    }
  );
  // Forall-bound length (`Array(T, U)` with `U : usize`): record the
  // VARIABLE NAME on the type so generic-impl matching can bind it
  // (mirrors TS storing an UnknownValue with `variableName` in
  // `ArrayType.length`; the synthesizer binds it at match time).
  array_type := cond(
    (len_is_var && ast_expr_is_atom(length_expr)) =>
      t_array_var(child_type, ast_expr_token(length_expr).value.clone()),
    true => t_array(child_type, len_usize)
  );
  array_type_val := create_type_value(array_type);
  meta_ty := type_of_type(array_type);
  env_final := len_info.env;
  out_info := new_expr_info(env_final, meta_ty);
  out_info.value = Option(EvalValue).Some(array_type_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_array_type);
