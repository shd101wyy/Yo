//! evaluate_future_type — evaluates `Future(T)` or `Future(T, E)` syntax.
//!
//! 1:1 port of `src/evaluator/types/future-trait.ts` (Phase 2ay).
//!
//! Creates a FutureTraitT type with output type and at most one effect bundle.
//! Supports:
//!   Future(T)        — basic future
//!   Future(T, E)     — future with a single effect bundle struct E
//!
//! Multiple effects must be packed into a single struct (e.g.
//!   Ctx :: struct(io : Io, raise : Raise); Future(T, Ctx)).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_FUTURE
}
:: import("../../expr.yo");
{ new_expr_info, expr_info_table_get, expr_info_table_set } :: import("../../expr_info.yo");
{ Environment, get_variables_from_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_type_value, is_type_value, is_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_future_trait, generate_some_type_id } :: import("../../types/creators.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ ArrayList } :: import("std/collections/array_list");
// ---------------------------------------------------------------------------
// Local helpers
// ---------------------------------------------------------------------------
_future_args :: (fn(e : AstExpr) -> ArrayList(AstExpr))(
  match(
    e,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
/// Derive a label name for an individual effect type.
/// Mirrors `getEffectLabel` from future-trait.ts.
_effect_label_for :: (fn(effect_type : TypeValue, effect_expr : AstExpr) -> String)(
  match(
    effect_type,
    .Struct({ name, is_source_namespace : fl_sns }) => cond(fl_sns => name, true => ast_expr_to_string(effect_expr)),
    .SomeT(_, name, _, _, _, _, _, _, _, _, _) => name,
    _ => ast_expr_to_string(effect_expr)
  )
);
/// Resolve a spread effect row `E : Type.Struct`.
/// Pushes the resolved label/type/spread into the output lists.
/// Mirrors `resolveEffectRowSpread` from future-trait.ts.
_resolve_effect_row_spread :: (
  fn(
    effect_expr : AstExpr,
    env : Environment,
    out_labels : ArrayList(String),
    out_types : ArrayList(TypeValue),
    out_spreads : ArrayList(bool),
    exn : Exception
  ) -> unit
)({
  // effect_expr is `E : Type.Struct` — extract the row var name
  spread_args := _future_args(effect_expr);
  row_arg := match(spread_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
  row_var_name_str := ast_expr_token(row_arg).value;
  row_var_name := row_var_name_str;
  // Look up E in the environment
  row_vars := get_variables_from_env(env, row_var_name);
  if(row_vars.len() == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(effect_expr),
          `Effect row variable "${row_var_name}" not found in scope. Declare it with forall(..., ...(${row_var_name}))`,
          false,
          .None
        )
      )
    );
  });
  match(
    row_vars.get(row_vars.len() - usize(1)),
    .Some(row_var) => {
      match(
        row_var.value,
        .Some(e_value) => {
          match(
            e_value,
            // Case 1/2: TypeVal — check if EffectsRowT (expand) or SomeT (spread marker)
            .TypeVal(type_box) => {
              match(
                type_box,
                .EffectsRowT(row_labels, row_types) => {
                  // Case 1: Concrete EffectsRowT — expand into non-spread params
                  (ri : usize) = usize(0);
                  while(ri < row_labels.len(), {
                    lbl := match(
                      row_labels.get(ri),
                      .Some(l) => l,
                      .None => {
                        ri = row_labels.len();
                        break;
                      }
                    );
                    ty := match(
                      row_types.get(ri),
                      .Some(t) => t,
                      .None => {
                        ri = row_labels.len();
                        break;
                      }
                    );
                    out_labels.push(lbl);
                    out_types.push(ty);
                    out_spreads.push(false);
                    ri = (ri + usize(1));
                  });
                },
                .SomeT(_, _, _, _, _, _, _, _, _, _, _) => {
                  // Case 2: SomeT effects row variable — use as spread marker
                  out_labels.push(row_var_name);
                  out_types.push(type_box);
                  out_spreads.push(true);
                },
                _ => {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(effect_expr),
                        `"...(${row_var_name})" requires "${row_var_name}" to be a forall-declared effect row variable, but it resolves to a concrete type. Use individual effect types directly instead of spreading them, e.g. Future(T, ${row_var_name}) instead of Future(T, ...(${row_var_name}))`,
                        false,
                        .None
                      )
                    )
                  );
                }
              );
            },
            // Case 3/4/5: UnknownVal — check the contained type
            .UnknownVal(type_box) => {
              match(
                type_box,
                .EffectsRowT(row_labels, row_types) => {
                  // Case 3: UnknownVal with EffectsRowT — expand into concrete non-spread params
                  (ri : usize) = usize(0);
                  while(ri < row_labels.len(), {
                    lbl := match(
                      row_labels.get(ri),
                      .Some(l) => l,
                      .None => {
                        ri = row_labels.len();
                        break;
                      }
                    );
                    ty := match(
                      row_types.get(ri),
                      .Some(t) => t,
                      .None => {
                        ri = row_labels.len();
                        break;
                      }
                    );
                    out_labels.push(lbl);
                    out_types.push(ty);
                    out_spreads.push(false);
                    ri = (ri + usize(1));
                  });
                },
                .SomeT(_, _, _, _, _, _, _, _, _, _, _) => {
                  // Case 4: UnknownVal with SomeT type — use SomeT as spread marker
                  out_labels.push(row_var_name);
                  out_types.push(type_box);
                  out_spreads.push(true);
                },
                _ => {
                  // Case 5: UnknownVal with TypeUni or other — re-evaluation, create fresh SomeT
                  frame_level := cond(
                    (env.frames.len() > usize(0)) => (env.frames.len() - usize(1)),
                    true => usize(0)
                  );
                  new_some_t := TypeValue.SomeT(
                    generate_some_type_id(),
                    row_var_name,
                    frame_level,
                    TypeValue.TypeUni(usize(1)),
                    ArrayList(TypeValue).new(),
                    ArrayList(usize).new(),
                    ArrayList(TypeValue).new(),
                    ArrayList(usize).new(),
                    true,
                    Option(TypeValue).None,
                    Option(TypeValue).None
                  );
                  out_labels.push(row_var_name);
                  out_types.push(new_some_t);
                  out_spreads.push(true);
                }
              );
            },
            _ => {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(effect_expr),
                    `Effect row variable "${row_var_name}" has invalid value. Expected a type.`,
                    false,
                    .None
                  )
                )
              );
            }
          );
        },
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(effect_expr),
                `Effect row variable "${row_var_name}" has invalid value. Expected a type.`,
                false,
                .None
              )
            )
          );
        }
      );
    },
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(effect_expr),
            `Effect row variable "${row_var_name}" not found in scope.`,
            false,
            .None
          )
        )
      );
    }
  );
});
/// Resolve a single effect argument (either `E : Type.Struct` spread or individual effect type).
/// Pushes the result into out_labels/out_types/out_spreads and returns updated env.
/// Mirrors `resolveEffectArg` from future-trait.ts.
_resolve_effect_arg :: (
  fn(
    effect_expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    out_labels : ArrayList(String),
    out_types : ArrayList(TypeValue),
    out_spreads : ArrayList(bool),
    exn : Exception
  ) -> Environment
)({
  // Check if this is a spread expression E : Type.Struct with one atom arg
  is_spread := (
    ast_expr_is_fn_call(effect_expr) &&
      ast_expr_is_fn_call_of(effect_expr, "...",.Some(usize(1))) &&
        match(_future_args(effect_expr).get(usize(0)),.Some(a) => ast_expr_is_atom(a),.None => false)
  );
  cond(
    is_spread => {
      _resolve_effect_row_spread(effect_expr, env, out_labels, out_types, out_spreads, exn);
      env
    },
    true => {
      // Individual effect type — evaluate it
      evaluated_expr := evaluate_expression(effect_expr, env, ctx);
      info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_expr));
      match(
        info_opt,
        .Some(info) => {
          if(!(is_type_value(info.value)), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(effect_expr),
                  `Future effect argument must be an effect type or E : Type.Struct spread, but got:\n${ast_expr_to_string(effect_expr)}`,
                  false,
                  .None
                )
              )
            );
          });
          effect_type := match(
            info.value,
            .Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),
            .None => TypeValue.Unit
          );
          label := _effect_label_for(effect_type, effect_expr);
          out_labels.push(label);
          out_types.push(effect_type);
          out_spreads.push(false);
          info.env
        },
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(effect_expr),
                `Future effect argument must be an effect type or E : Type.Struct spread, but got:\n${ast_expr_to_string(effect_expr)}`,
                false,
                .None
              )
            )
          );
          env
        }
      )
    }
  )
});
// ---------------------------------------------------------------------------
// evaluate_future_type
// ---------------------------------------------------------------------------
/// Evaluates the `Future(T, ...)` syntax.
/// Creates a FutureTraitT type with output type and optional effect row effects.
///
/// Mirrors `evaluateFutureType` from future-trait.ts.
evaluate_future_type :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  expr_args := _future_args(expr);
  if((expr_args.len() < usize(1)) || (expr_args.len() > usize(2)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Future type constructor expects 1 or 2 arguments (output type, optional effect bundle struct).\nUsage: Future(T) or Future(T, E).\nTo combine multiple effects, declare a struct that bundles them and pass that struct as E."),
          false,
          .None
        )
      )
    );
  });
  // Evaluate output type (first arg)
  element_type_expr := match(expr_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
  evaluated_elem_expr := evaluate_expression(element_type_expr, env, ctx);
  elem_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_elem_expr));
  elem_info := match(
    elem_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(element_type_expr),
            `Failed to evaluate the element type expression for Future:\n${ast_expr_to_string(element_type_expr)}`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, TypeValue.Unit)
    }
  );
  (env_mut : Environment) = elem_info.env;
  if(!(is_type_value(elem_info.value)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(element_type_expr),
          `Future type constructor expects a type as its first argument, but got:\n${ast_expr_to_string(element_type_expr)}`,
          false,
          .None
        )
      )
    );
  });
  output_type := match(
    elem_info.value,
    .Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),
    .None => TypeValue.Unit
  );
  // Process effect arguments (args 1..N)
  effect_labels := ArrayList(String).new();
  effect_types := ArrayList(TypeValue).new();
  effect_spreads := ArrayList(bool).new();
  (ei : usize) = usize(1);
  while(ei < expr_args.len(), {
    effect_expr := match(
      expr_args.get(ei),
      .Some(a) => a,
      .None => {
        ei = expr_args.len();
        break;
      }
    );
    env_mut = _resolve_effect_arg(effect_expr, env_mut, ctx, effect_labels, effect_types, effect_spreads, exn);
    ei = (ei + usize(1));
  });
  // Build the FutureTraitT
  future_type := t_future_trait(String.from(BK_FUTURE), output_type, effect_labels, effect_types, effect_spreads);
  // Set expr info
  out_info := new_expr_info(env_mut, type_of_type(future_type));
  out_info.value =.Some(create_type_value(future_type));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_future_type);
