//! evaluate_function_type — evaluates `fn(...) -> ReturnType` expressions.
//!
//! 1:1 port of `src/evaluator/types/function.ts` (Phase 3w).
//!
//! Implements the full multi-pass parameter evaluation algorithm:
//!   Pass 1 — process generic type parameters (create SomeTypes)
//!   Pass 2 — process  implicit parameters
//!   Pass 3 — pre-add comptime parameters to env (so where clauses can reference them)
//!   Pass 4 — scan where clause and try to evaluate constraints (with pending retry)
//!   Pass 5 — process regular parameters; retry pending constraints after each
//!
//! Phase 3w: effect-row generic `E : Type.Struct` and effect-row spread `E : Type.Struct` in  are now fully implemented.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_GENERIC,
  BK_WHERE,
  BK_COMPTIME,
  BK_QUOTE,
  BK_INOUT,
  BK_COLON,
  BK_FN,
  BK_UNSAFE_FN,
  BK_CTL,
  BK_TUPLE,
  BF_REQUIRES,
  BF_ENSURES
}
:: import("../../expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_get, expr_info_table_set, lookup_some_resolved_concrete, register_some_resolved_concrete, adopt_receiver_struct_instance } :: import("../../expr_info.yo");
{ Environment, Variable, get_variables_from_env, add_variable_to_env, add_where_clause_constraint_for_type_application } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{ EvalValue, create_type_value, create_unknown_val, is_type_value, is_type_val, is_unknown_val } :: import("../../value.yo");
{ TypeValue, FuncMeta } :: import("../../types/definitions.yo");
{ t_some_t, t_some_t_with_kind, t_type, t_type_1, t_unit, t_expr_t, t_comptime_list, generate_some_type_id } :: import("../../types/creators.yo");
{ is_some_type, is_trait_type, is_function_type, is_type_0 } :: import("../../types/guards.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ is_expr_type, is_expr_list_type, is_fn_trait_type, is_type_application_type, is_effects_row_type }
:: import("../../types/guards.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{
  prohibit_void_type,
  type_requires_comptime_modifier,
  type_prohibits_comptime_modifier,
  type_contains_some_type,
  type_representation_contains_raw_ptr,
  get_all_some_types
}
:: import("../../types/utils.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ subst_new, subst_add, substitute } :: import("../../types/substitution.yo");
{
  get_value_of_some_type_from_env,
  convert_comptime_type_to_runtime_type,
  convert_comptime_type_to_runtime_type_with_expected
} :: import("../../types/env_lookup.yo");
{ format_error_message } :: import("../../error.yo");
{ type_to_string } :: import("../../types/string.yo");
{ is_valid_variable_name } :: import("../utils.yo");
{ type_implements_trait } :: import("../trait_checking.yo");
{ Exception } :: import("std/error");
{ evaluate_expression, evaluate_expression_raw } :: import("../exprs/expr.yo");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ Token, TokenKind } :: import("../../token.yo");
// ---------------------------------------------------------------------------
// Macro side-tables (folded from former
// `evaluator/types/macro_registry.yo`).
//
// In src/, macro-ness is stored as flags on FunctionType:
//   * `parameter.isQuote: boolean` — for `quote(name) : Expr` parameters
//   * `returnType.isUnquote: boolean` — for `unquote(Expr)` return types
//
// yo-self's TypeValue.Func does not carry those flags, so we side-table
// the information keyed by `func_id`. A function is treated as a macro
// if EITHER its return type is `unquote(...)` OR it has at least one
// quoted parameter.
// ---------------------------------------------------------------------------
/// Map from func_id → list of parameter indices that are quoted.
/// Absent entry means no quoted parameters.
(g_macro_quoted_param_indices : HashMap(String, ArrayList(usize))) =
  HashMap(String, ArrayList(usize)).new();
/// Map from func_id → true if return type is `unquote(...)`.
/// Absent entry means return is not an unquote.
(g_macro_return_is_unquote : HashMap(String, bool)) =
  HashMap(String, bool).new();
/// Register the list of quoted parameter indices for a function.
/// Idempotent: repeated calls overwrite the previous entry.
register_macro_quoted_params :: (fn(func_id : String, indices : ArrayList(usize)) -> unit)({
  cond(
    (indices.len() > usize(0)) => {
      g_macro_quoted_param_indices.set(func_id.clone(), indices);
    },
    true => ()
  );
});
/// Mark a function as having an `unquote(...)` return type. Idempotent.
register_macro_return_is_unquote :: (fn(func_id : String) -> unit)({
  g_macro_return_is_unquote.set(func_id.clone(), true);
});
/// Returns the list of quoted parameter indices, or an empty list if none.
get_macro_quoted_param_indices :: (fn(func_id : String) -> ArrayList(usize))(
  match(
    g_macro_quoted_param_indices.get(func_id.clone()),
    .Some(idxs) => idxs,
    .None => ArrayList(usize).new()
  )
);
/// Returns true if the function's return type is `unquote(...)`.
macro_return_is_unquote :: (fn(func_id : String) -> bool)(
  match(
    g_macro_return_is_unquote.get(func_id.clone()),
    .Some(_) => true,
    .None => false
  )
);
/// Returns true if the function is a macro (quoted params OR unquote return).
is_macro_fn :: (fn(func_id : String) -> bool)(
  cond(
    macro_return_is_unquote(func_id) => true,
    true => match(
      g_macro_quoted_param_indices.get(func_id.clone()),
      .Some(idxs) => (idxs.len() > usize(0)),
      .None => false
    )
  )
);
/// Returns true if the parameter at `param_index` is quoted for `func_id`.
is_param_quoted :: (fn(func_id : String, param_index : usize) -> bool)(
  match(
    g_macro_quoted_param_indices.get(func_id.clone()),
    .Some(idxs) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      n := idxs.len();
      while((i < n) && !(found), {
        match(
          idxs.get(i),
          .Some(idx) => cond(
            (idx == param_index) => {
              found = true;
            },
            true => ()
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .None => false
  )
);
/// Copy a macro registration (quoted param indices + unquote-return flag)
/// from `from_id` to `to_id`. Used to re-key from the `fn(...)`
/// type-expression id (registered by `evaluate_function_type`) to the
/// `FuncVal` id, which is what the call site has in hand — the same
/// two-step as `copy_func_param_defaults` below. No-op when `from_id`
/// has no entries.
copy_macro_registration :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_macro_quoted_param_indices.get(from_id.clone()),
    .Some(idxs) => {
      g_macro_quoted_param_indices.set(to_id.clone(), idxs);
    },
    .None => ()
  );
  match(
    g_macro_return_is_unquote.get(from_id.clone()),
    .Some(_) => {
      g_macro_return_is_unquote.set(to_id.clone(), true);
    },
    .None => ()
  );
});
// ---------------------------------------------------------------------------
// Optional-parameter side-table (default-argument support).
//
// `TypeValue.Func` carries only parallel `param_labels`/`param_types`
// arrays — no per-param default info. In src/ this lives on
// `FunctionParameter.defaultValue`; here we side-table it keyed by
// `func_id`, like the macro registries above. Index `i` holds
// `.Some(value)` when parameter `i` has a `?= default` (and may be
// omitted at the call site, then bound to `value`) or `.None` when
// required.
//
// Registration is two-step (the value's id isn't known when the type is
// built): `evaluate_function_type` registers keyed by the `fn(...)`
// type-expression id; `try_to_implement_function_by_function_type` then
// copies the entry under the freshly-minted `FuncVal` id, which is what
// the call site (`helper.yo` / the FuncVal-call arm) has in hand.
(g_func_param_defaults : HashMap(String, ArrayList(Option(EvalValue)))) =
  HashMap(String, ArrayList(Option(EvalValue))).new();
/// Register the per-parameter default values for a function.
/// No-op when no parameter has a default (keeps the table sparse).
register_func_param_defaults :: (fn(func_id : String, defaults : ArrayList(Option(EvalValue))) -> unit)({
  (any_default : bool) = false;
  (i : usize) = usize(0);
  while((i < defaults.len()) && !(any_default), {
    match(
      defaults.get(i),
      .Some(d) => if(d.is_some(), {
        any_default = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(any_default, {
    g_func_param_defaults.set(func_id.clone(), defaults);
  });
});
/// Copy a registered default-values entry from `from_id` to `to_id`
/// (used to re-key from the fn-type-expr id to the FuncVal id). No-op
/// when `from_id` has no entry.
copy_func_param_defaults :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_func_param_defaults.get(from_id.clone()),
    .Some(defaults) => {
      g_func_param_defaults.set(to_id.clone(), defaults);
    },
    .None => ()
  );
});
/// Variadic-parameter side table: `fn(...)`-type-expression id (then the
/// FuncVal id via the same two-step as the defaults) → the variadic
/// parameter's NAME and TYPE. TS stores `FunctionType.variadicParameter`
/// on the type itself; yo-self's `TypeValue.Func` only keeps the
/// `has_variadic` presence bit, which loses the binding name the
/// def-time body evaluation must bring into scope (`...(quote(elems))`
/// in std/collections/array_list.yo's `array_list` macro — `elems` was
/// unresolved in the body).
VariadicParamEntry :: struct(label : String, ty : TypeValue);
(g_func_variadic_params : HashMap(String, VariadicParamEntry)) =
  HashMap(String, VariadicParamEntry).new();
register_func_variadic_param :: (fn(func_id : String, label : String, ty : TypeValue) -> unit)({
  if(label != "...", {
    g_func_variadic_params.set(func_id.clone(), VariadicParamEntry(label : label, ty : ty));
  });
});
copy_func_variadic_param :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_func_variadic_params.get(from_id.clone()),
    .Some(entry) => {
      g_func_variadic_params.set(to_id.clone(), entry);
    },
    .None => ()
  );
});
get_func_variadic_param :: (fn(func_id : String) -> Option(VariadicParamEntry))(
  g_func_variadic_params.get(func_id.clone())
);
/// Return the per-parameter default values for `func_id`, or an empty
/// list when none are registered (i.e. all parameters required).
get_func_param_defaults :: (fn(func_id : String) -> ArrayList(Option(EvalValue)))(
  match(
    g_func_param_defaults.get(func_id.clone()),
    .Some(defaults) => defaults,
    .None => ArrayList(Option(EvalValue)).new()
  )
);
// Per-parameter `is_compile_time_only` flags (the `comptime(name) : T` param
// modifier). `TypeValue.Func`/`FuncMeta` do NOT carry a per-param comptime bit
// (only `param_is_ref`/`param_is_owning`), so — like the defaults above — it
// rides a func-id-keyed side table. The call site (helper.yo) reads it to
// replicate TS's `!parameter.isCompileTimeOnly` guard on the comptime→runtime
// argument-type conversion (helper.ts:508): a RUNTIME parameter that receives a
// comptime-only argument (e.g. the operator `neg`'s `self : _Self` given
// `comptime_float`) must lower the arg to its runtime type, or the specialized
// body dispatches to the COMPTIME impl (`__yo_comptime_float_neg`, undeclared).
// Keyed/copied like the defaults (fn-type-expr id → FuncVal id).
(g_func_param_comptime : HashMap(String, ArrayList(bool))) = HashMap(String, ArrayList(bool)).new();
register_func_param_comptime :: (fn(func_id : String, flags : ArrayList(bool)) -> unit)({
  // Keep the table sparse — only register when at least one param is comptime.
  (any_ct : bool) = false;
  (i : usize) = usize(0);
  while((i < flags.len()) && !(any_ct), {
    match(
      flags.get(i),
      .Some(f) => if(f, {
        any_ct = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(any_ct, {
    g_func_param_comptime.set(func_id.clone(), flags);
  });
});
copy_func_param_comptime :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_func_param_comptime.get(from_id.clone()),
    .Some(flags) => {
      g_func_param_comptime.set(to_id.clone(), flags);
    },
    .None => ()
  );
});
// Side-table: the declared RETURN TYPE EXPRESSION (the normalized `-> RET`
// AST), keyed/copied like the defaults (fn-type-expr id → FuncVal id). TS
// carries this on the type itself (`functionType.return.typeExpr`) and
// specialization RE-EVALUATES it in the specialized env
// (evaluateFunctionReturnTypeAgain, function.ts:2822) so a generic
// instantiation in the return (`*(Pair(K, V))`) routes through the SAME
// memoized type-constructor as the body's own calls — one instantiation
// lineage. yo-self's substitution-based re-resolution kept the def-era
// instance and split the lineage (the imm_map `_alloc_pairs` expected/actual
// struct-id mismatch).
(g_func_return_type_expr : HashMap(String, AstExpr)) = HashMap(String, AstExpr).new();
register_func_return_type_expr :: (fn(func_id : String, e : AstExpr) -> unit)({
  g_func_return_type_expr.set(func_id.clone(), e);
});
copy_func_return_type_expr :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_func_return_type_expr.get(from_id.clone()),
    .Some(e) => {
      g_func_return_type_expr.set(to_id.clone(), e.clone());
    },
    .None => ()
  );
});
get_func_return_type_expr :: (fn(func_id : String) -> Option(AstExpr))(
  g_func_return_type_expr.get(func_id.clone())
);
get_func_param_comptime :: (fn(func_id : String) -> ArrayList(bool))(
  match(g_func_param_comptime.get(func_id.clone()),.Some(f) => f,.None => ArrayList(bool).new())
);
// Parallel side-table: per-parameter default-value EXPRESSIONS (the `?= EXPR`
// AST). The value table above suffices for the call-site count check and the
// def-time binding, but CODEGEN must EMIT an omitted default as a C argument —
// TS evaluates `parameter.exprs.defaultValueExpr` and pushes it to
// `runtimeArgExprsInOrder` (helper.ts:328-344). yo-self keeps the exprs here so
// the omitted-parameter branch can clone+evaluate+emit them. Keyed/copied like
// the values (fn-type-expr id → FuncVal id).
(g_func_param_default_exprs : HashMap(String, ArrayList(Option(AstExpr)))) =
  HashMap(String, ArrayList(Option(AstExpr))).new();
register_func_param_default_exprs :: (fn(func_id : String, exprs : ArrayList(Option(AstExpr))) -> unit)({
  (any_default : bool) = false;
  (i : usize) = usize(0);
  while((i < exprs.len()) && !(any_default), {
    match(
      exprs.get(i),
      .Some(e) => if(e.is_some(), {
        any_default = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(any_default, {
    g_func_param_default_exprs.set(func_id.clone(), exprs);
  });
});
copy_func_param_default_exprs :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_func_param_default_exprs.get(from_id.clone()),
    .Some(exprs) => {
      g_func_param_default_exprs.set(to_id.clone(), exprs);
    },
    .None => ()
  );
});
get_func_param_default_exprs :: (fn(func_id : String) -> ArrayList(Option(AstExpr)))(
  match(
    g_func_param_default_exprs.get(func_id.clone()),
    .Some(exprs) => exprs,
    .None => ArrayList(Option(AstExpr)).new()
  )
);
/// Per-parameter declared TYPE expressions (the raw AST right of `:`), keyed
/// like the defaults (fn-type-expr id, re-keyed under the FuncVal id by
/// try_to_implement_function_by_function_type). TS `parameter.exprs.typeExpr`,
/// consumed by evaluateFunctionParameterTypeAgain: the call site RE-EVALUATES
/// the expr in the bound callee env so comptime type-constructor
/// instantiations route through the memoized constructor (canonical ids)
/// instead of substituting into the def-era nocache mint — the
/// imm_sorted_map-family id split (issues/yo-self-69-red-list-map.md, ROOT
/// CAUSE 2026-07-30). The list is parallel to the param order; `.None` for
/// params without a written type.
(g_func_param_type_exprs : HashMap(String, ArrayList(Option(AstExpr)))) =
  HashMap(String, ArrayList(Option(AstExpr))).new();
register_func_param_type_exprs :: (fn(func_id : String, exprs : ArrayList(Option(AstExpr))) -> unit)({
  (any_te : bool) = false;
  (tei : usize) = usize(0);
  while((tei < exprs.len()) && !(any_te), {
    match(
      exprs.get(tei),
      .Some(e) => if(e.is_some(), {
        any_te = true;
      }),
      .None => ()
    );
    tei = (tei + usize(1));
  });
  if(any_te, {
    g_func_param_type_exprs.set(func_id.clone(), exprs);
  });
});
copy_func_param_type_exprs :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_func_param_type_exprs.get(from_id.clone()),
    .Some(exprs) => {
      g_func_param_type_exprs.set(to_id.clone(), exprs);
    },
    .None => ()
  );
});
get_func_param_type_exprs :: (fn(func_id : String) -> ArrayList(Option(AstExpr)))(
  match(
    g_func_param_type_exprs.get(func_id.clone()),
    .Some(exprs) => exprs,
    .None => ArrayList(Option(AstExpr)).new()
  )
);
/// Where-clause constraint side table: `fn(...)`-type-expression id (then the
/// FuncVal id via the same two-step as the defaults) → the function's
/// where-clause constraints as (LHS param label, trait type, negated) triples.
/// TS stores the raw constraint exprs as `FunctionType.whereClauseExprs`
/// (src/types/definitions.ts:837) and RE-APPLIES them at every call site once
/// parameters are bound (helper.ts:1493-1506 → applyWhereClauseConstraints →
/// validateSingleTraitOnConcreteType, function.ts:974) — that re-application is
/// what rejects `Mutex(NonSendObj)` against `where(T <: Send)`. yo-self's
/// `TypeValue.Func` cannot carry AstExprs (definitions.yo must not depend on
/// expr.yo), so the constraints live here in evaluated form: the label of the
/// constrained parameter plus the trait it must (or, negated, must NOT)
/// implement. Only simple-atom LHS constraints naming a generic/comptime param
/// are recorded — exactly the ones whose LHS can resolve to a concrete bound
/// type at a call site.
WhereConstraintEntry :: struct(
  lhs_label : String,
  trait_ty : TypeValue,
  is_negated : bool
);
(g_func_where_constraints : HashMap(String, ArrayList(WhereConstraintEntry))) =
  HashMap(String, ArrayList(WhereConstraintEntry)).new();
/// Register the where-clause constraints for a function.
/// No-op when the function has none (keeps the table sparse).
register_func_where_constraints :: (fn(func_id : String, entries : ArrayList(WhereConstraintEntry)) -> unit)({
  if(entries.len() > usize(0), {
    g_func_where_constraints.set(func_id.clone(), entries);
  });
});
/// Call-site RE-APPLICATION needs the original constraint EXPRESSIONS: TS
/// re-applies `FunctionType.whereClauseExprs` at every call once parameters
/// are bound (helper.ts:1515-1530 → applyWhereClauseConstraints). The
/// evaluated `WhereConstraintEntry` form above cannot express a PARAMETERIZED
/// trait — `K <: Eq(K)` must be re-evaluated with the call's concrete `K` to
/// yield `Eq(String)`. Keyed and re-keyed exactly like the entries table.
(g_func_where_clause_exprs : HashMap(String, ArrayList(AstExpr))) =
  HashMap(String, ArrayList(AstExpr)).new();
/// Register the where-clause constraint expressions for a function.
/// No-op when the function has none (keeps the table sparse).
register_func_where_clause_exprs :: (fn(func_id : String, exprs : ArrayList(AstExpr)) -> unit)({
  if(exprs.len() > usize(0), {
    g_func_where_clause_exprs.set(func_id.clone(), exprs);
  });
});
/// Return the where-clause constraint expressions for `func_id` (empty when none).
get_func_where_clause_exprs :: (fn(func_id : String) -> ArrayList(AstExpr))(
  match(
    g_func_where_clause_exprs.get(func_id.clone()),
    .Some(exprs) => exprs,
    .None => ArrayList(AstExpr).new()
  )
);
/// Copy a registered where-constraints entry from `from_id` to `to_id`
/// (re-key from the fn-type-expr id to the FuncVal id). No-op when absent.
/// Also re-keys the where-clause EXPRESSIONS table (the two travel together).
copy_func_where_constraints :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_func_where_constraints.get(from_id.clone()),
    .Some(entries) => {
      g_func_where_constraints.set(to_id.clone(), entries);
    },
    .None => ()
  );
  match(
    g_func_where_clause_exprs.get(from_id.clone()),
    .Some(exprs) => {
      g_func_where_clause_exprs.set(to_id.clone(), exprs);
    },
    .None => ()
  );
});
/// Return the where-clause constraints for `func_id` (empty when none).
get_func_where_constraints :: (fn(func_id : String) -> ArrayList(WhereConstraintEntry))(
  match(
    g_func_where_constraints.get(func_id.clone()),
    .Some(entries) => entries,
    .None => ArrayList(WhereConstraintEntry).new()
  )
);
// ---------------------------------------------------------------------------
// Phase-0 contract-clause side-tables (plans/FORMAL_VERIFICATION.md).
// ---------------------------------------------------------------------------
/// `fn(...)`-type-expression id (then the FuncVal id via the same two-step as
/// the defaults) → the signature's `requires(...)` predicate expressions.
/// TS stores these as `FunctionType.requiresExprs`
/// (src/types/definitions.ts:865); yo-self's `TypeValue.Func` cannot carry
/// AstExprs (definitions.yo must not depend on expr.yo — see the
/// where-constraints table above), so they live here and are read by the
/// body-wrapping lowering in `evaluator/builtins/contracts.yo`.
(g_func_requires_exprs : HashMap(String, ArrayList(AstExpr))) =
  HashMap(String, ArrayList(AstExpr)).new();
/// Same, for `ensures(...)`. Mirrors `FunctionType.ensuresExprs`
/// (src/types/definitions.ts:875).
(g_func_ensures_exprs : HashMap(String, ArrayList(AstExpr))) =
  HashMap(String, ArrayList(AstExpr)).new();
/// Register the signature's `requires(...)` predicates. No-op when empty
/// (keeps the table sparse, like the where-constraints table).
register_func_requires_exprs :: (fn(func_id : String, preds : ArrayList(AstExpr)) -> unit)({
  if(preds.len() > usize(0), {
    g_func_requires_exprs.set(func_id.clone(), preds);
  });
});
/// Register the signature's `ensures(...)` predicates. No-op when empty.
register_func_ensures_exprs :: (fn(func_id : String, preds : ArrayList(AstExpr)) -> unit)({
  if(preds.len() > usize(0), {
    g_func_ensures_exprs.set(func_id.clone(), preds);
  });
});
/// Re-key both contract tables from the fn-type-expr id to the FuncVal id.
copy_func_contract_exprs :: (fn(from_id : String, to_id : String) -> unit)({
  match(
    g_func_requires_exprs.get(from_id.clone()),
    .Some(preds) => {
      g_func_requires_exprs.set(to_id.clone(), preds);
    },
    .None => ()
  );
  match(
    g_func_ensures_exprs.get(from_id.clone()),
    .Some(preds) => {
      g_func_ensures_exprs.set(to_id.clone(), preds);
    },
    .None => ()
  );
});
/// Return the `requires(...)` predicates for `func_id` (empty when none).
get_func_requires_exprs :: (fn(func_id : String) -> ArrayList(AstExpr))(
  match(
    g_func_requires_exprs.get(func_id.clone()),
    .Some(preds) => preds,
    .None => ArrayList(AstExpr).new()
  )
);
/// Return the `ensures(...)` predicates for `func_id` (empty when none).
get_func_ensures_exprs :: (fn(func_id : String) -> ArrayList(AstExpr))(
  match(
    g_func_ensures_exprs.get(func_id.clone()),
    .Some(preds) => preds,
    .None => ArrayList(AstExpr).new()
  )
);
/// Append (label, trait, negated) entries for every required/negative trait
/// carried on `ty` when it is a SomeT (the where clause mutated the param
/// placeholder's lists in place). No-op for non-SomeT types.
_collect_where_constraints_from_some_t :: (
  fn(label : String, ty : TypeValue, out : ArrayList(WhereConstraintEntry)) -> unit
)({
  match(
    ty,
    .SomeT(_, _, _, _, required_trait_types, _, negative_trait_types, _, _, _, _) => {
      (ri : usize) = usize(0);
      while(ri < required_trait_types.len(), {
        match(
          required_trait_types.get(ri),
          .Some(rt) => {
            out.push(WhereConstraintEntry(lhs_label : label.clone(), trait_ty : rt, is_negated : false));
          },
          .None => ()
        );
        ri = (ri + usize(1));
      });
      (ni : usize) = usize(0);
      while(ni < negative_trait_types.len(), {
        match(
          negative_trait_types.get(ni),
          .Some(nt) => {
            out.push(WhereConstraintEntry(lhs_label : label.clone(), trait_ty : nt, is_negated : true));
          },
          .None => ()
        );
        ni = (ni + usize(1));
      });
    },
    _ => ()
  );
});
// ---------------------------------------------------------------------------
// Local data structures
// ---------------------------------------------------------------------------
/// Processed function parameter — mirrors TypeScript `FunctionParameter`.
FuncParam :: struct(
  label : String,
  ty : TypeValue,
  is_compile_time_only : bool,
  is_quote : bool,
  is_owning_rc_value : bool,
  is_implicit : bool,
  is_effect_row_spread : bool,
  // The parameter's evaluated `?= default` value, or `.None` for a
  // required parameter. Collected into a func-id-keyed side-table (the
  // Func TypeValue does not carry per-param default info) so call-site arg
  // matching can treat trailing defaulted params as optional AND bind an
  // omitted argument to the recorded default value.
  default_value : Option(EvalValue),
  /// True when the parameter was declared `inout(name) : T` (a by-reference
  /// borrow). Recorded so the Func type's `param_is_ref` can be populated for
  /// the `inout(T)`-flow soundness check (`is_flowable_expr`).
  is_ref : bool,
  /// The parameter's `?= default` value EXPRESSION (the raw AST), or `.None`
  /// for a required parameter. Parallel to `default_value` (the evaluated
  /// value): codegen must EMIT an omitted default as a C argument, so the
  /// expr is carried into the default-expr side-table at registration. Appended
  /// last so existing positional constructions only need a trailing argument.
  default_value_expr : Option(AstExpr),
  /// The parameter's declared TYPE expression (the raw AST right of `:`), or
  /// `.None` when the param has no written type (default-only shorthand,
  /// synthetic params). TS `parameter.exprs.typeExpr` — the call site
  /// RE-EVALUATES it in the bound callee env so comptime type-constructor
  /// instantiations (`Map(K)` with K := i32) route through the memoized
  /// constructor and unify with the body's instantiations, instead of
  /// substituting into the def-era nocache mint (the imm_sorted_map family's
  /// id split; issues/yo-self-69-red-list-map.md ROOT CAUSE 2026-07-30).
  ty_expr : Option(AstExpr)
);
/// Pending where-clause constraint that failed to evaluate.
PendingConstraint :: struct(
  lhs_expr : AstExpr,
  trait_expr : AstExpr,
  original_constraint_expr : AstExpr
);
/// Return type for evaluate_function_parameters.
FuncParamsResult :: struct(
  params : ArrayList(FuncParam),
  forall_params : ArrayList(FuncParam),
  implicit_params : ArrayList(FuncParam),
  where_clause_exprs : ArrayList(AstExpr),
  has_variadic : bool,
  variadic_param : FuncParam,
  /// Phase-0 `requires(...)` predicates extracted from the parameter list.
  /// TS returns these on the FunctionType (function.ts:2273); yo-self carries
  /// them out here so `evaluate_function_type` can register the side-table.
  /// Appended last so existing positional constructions only need trailing args.
  requires_exprs : ArrayList(AstExpr),
  /// Phase-0 `ensures(...)` predicates (same rationale).
  ensures_exprs : ArrayList(AstExpr)
);
// ---------------------------------------------------------------------------
// Local helpers
// ---------------------------------------------------------------------------
_fn_call_args :: (fn(e : AstExpr) -> ArrayList(AstExpr))(
  match(
    e,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
_fn_call_func :: (fn(e : AstExpr) -> AstExpr)(
  match(
    e,
    .FnCall(_, func_box, _, _, _) => func_box,
    .Atom(_, _) => make_err_expr()
  )
);
/// Evaluate an expression and return (updated_env, TypeValue option).
/// Returns None for the TypeValue if evaluation fails or result is not a type.
_get_expr_type :: (
  fn(
    expr : AstExpr,
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> TypeValue
)({
  evaluated := evaluate_expression_raw(expr, env_mut, ctx, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  info := match(
    info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Failed to get expr info after evaluation`,
            false,
            .None
          )
        )
      );
      new_expr_info(env_mut, TypeValue.Unit)
    }
  );
  if(!(is_type_value(info.value)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected a type value, got ${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  match(
    info.value,
    .Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),
    .None => TypeValue.Unit
  )
});
/// Evaluate an expression and update env_mut in-place.
/// Returns (evaluated_expr, type_value_or_none).
_eval_and_update_env :: (
  fn(
    expr : AstExpr,
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(TypeValue)
)({
  evaluated := evaluate_expression_raw(expr, env_mut, ctx, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  match(
    info_opt,
    .Some(info) => {
      env_mut.frames = info.env.frames;
      env_mut.module_path = info.env.module_path;
      env_mut.function_declaration_frame_level = info.env.function_declaration_frame_level;
      env_mut.input_string = info.env.input_string;
      if(
        is_type_value(info.value),
        .Some(
          match(
            info.value,
            .Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),
            .None => TypeValue.Unit
          )
        ),
        Option(TypeValue).None
      )
    },
    .None => Option(TypeValue).None
  )
});
/// Pre-pass helper: tries to evaluate a comptime type expr.
/// Uses outer exn (hard failure) — the `given/unwind` soft-failure pattern is
/// avoided here because passing a `given` binding via `exn_x` in a call
/// generates an incomplete C call (missing exn__throw arg).
/// Since evaluate_expression already panics on errors (via _evaluate_expression_wrapper),
/// the soft-failure was dead code anyway.
_try_eval_comptime_type :: (
  fn(
    type_expr : AstExpr,
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(TypeValue)
)(
  _eval_and_update_env(type_expr, env_mut, ctx, exn)
);
/// Helper: true when `expr` is the `...` atom (variadic marker).
/// Extracted as a module-level function to avoid a double-drop codegen bug where
/// `ast_expr_token` returns an owned Token whose drop is emitted twice when used
/// inline in an `&&` short-circuit expression inside a loop body.
_is_dots_atom :: (fn(expr : AstExpr) -> bool)(
  if(
    !(ast_expr_is_atom(expr)),
    false,
    begin(
      tok := ast_expr_token(expr),
      tok.value == "..."
    )
  )
);
// ---------------------------------------------------------------------------
// Phase 0 of plans/FORMAL_VERIFICATION.md: canonical signature clause order.
// Each parameter belongs to an ordered "zone"; zones must appear
// non-decreasing left-to-right:
//   generic(0) -> regular params (1) -> where(2) -> requires(3) -> ensures(4)
// Mirrors the `zoneOf` / `zoneLabels` block in
// `src/evaluator/types/function.ts:1700-1743`.
// ---------------------------------------------------------------------------
/// The clause zone of a parameter expression.
_clause_zone :: (fn(e : AstExpr) -> usize)(
  cond(
    ast_expr_is_fn_call_of(e, BK_GENERIC, Option(usize).None) => usize(0),
    ast_expr_is_fn_call_of(e, BK_WHERE, Option(usize).None) => usize(2),
    ast_expr_is_fn_call_of(e, BF_REQUIRES, Option(usize).None) => usize(3),
    ast_expr_is_fn_call_of(e, BF_ENSURES, Option(usize).None) => usize(4),
    true => usize(1)
  )
);
/// The diagnostic name of a parameter expression's clause (TS `zoneOf().name`).
_clause_name :: (fn(e : AstExpr) -> String)(
  cond(
    ast_expr_is_fn_call_of(e, BK_GENERIC, Option(usize).None) => String.from("generic(...)"),
    ast_expr_is_fn_call_of(e, BK_WHERE, Option(usize).None) => String.from("where(...)"),
    ast_expr_is_fn_call_of(e, BF_REQUIRES, Option(usize).None) => String.from("requires(...)"),
    ast_expr_is_fn_call_of(e, BF_ENSURES, Option(usize).None) => String.from("ensures(...)"),
    true => String.from("parameter")
  )
);
/// The zone label used in the "Move X before Y" hint (TS `zoneLabels`).
_zone_label :: (fn(zone : usize) -> String)(
  cond(
    (zone == usize(0)) => String.from("generic(...)"),
    (zone == usize(1)) => String.from("regular parameters"),
    (zone == usize(2)) => String.from("where(...)"),
    (zone == usize(3)) => String.from("requires(...)"),
    true => String.from("ensures(...)")
  )
);
/// True when `e` is a Phase-0 contract clause (`requires(...)`/`ensures(...)`).
/// Such clauses are NOT runtime parameters: every parameter pass skips them.
_is_contract_clause :: (fn(e : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(e, BF_REQUIRES, Option(usize).None) ||
    ast_expr_is_fn_call_of(e, BF_ENSURES, Option(usize).None)
);
/// Add a where-clause trait constraint directly to a SomeType's constraint lists.
/// Since `required_trait_types` in SomeT is an `ArrayList(TypeValue)` (object =
/// reference type), we can mutate it in-place. The mutation is visible everywhere
/// the same ArrayList is referenced, including in the Variable stored in the env.
///
/// Mirrors `addWhereClauseConstraintToEnv` from TypeScript, but using in-place
/// mutation instead of env-frame constraint map (yo-self's SomeT stores constraints
/// directly in required_trait_types / negative_trait_types ArrayLists).
_add_where_clause_constraint :: (
  fn(
    some_ty : TypeValue,
    trait_ty : TypeValue,
    is_negated : bool
  ) -> unit
)(
  match(
    some_ty,
    .SomeT(_, _, _, _, required_trait_types, required_trait_levels, negative_trait_types, negative_trait_levels, _, _, _) => {
      if(is_negated, {
        negative_trait_types.push(trait_ty);
        negative_trait_levels.push(usize(0));
      }, {
        required_trait_types.push(trait_ty);
        required_trait_levels.push(usize(0));
      });
    },
    _ => ()
  )
);
/// Check if a trait type already has a receiver type (is_concrete is Some).
/// Mirrors TypeScript `traitType.receiverType` check.
_trait_has_receiver :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .TraitT(_, _, _, _, _, is_concrete, _, _, _, _) => is_concrete.is_some(),
    _ => false
  )
);
/// Build a placeholder Token from an existing token (for variables we create).
_make_token :: (fn(tok : Token) -> Token)(tok);
// ---------------------------------------------------------------------------
// extract_comptime_parameter_info
// ---------------------------------------------------------------------------
/// Return (name, type_expr, token) for `comptime(name) : Type` and variants.
/// Returns None if the expression is not a comptime parameter.
///
/// Mirrors `extractComptimeParameterInfo` from function.ts lines 91-133.
ExtractComptimeResult :: struct(
  name : String,
  type_expr : AstExpr,
  token : Token
);
extract_comptime_parameter_info :: (
  fn(
    param_expr : AstExpr
  ) -> Option(ExtractComptimeResult)
)({
  (expr : AstExpr) = param_expr;
  // Handle default value: (comptime(name) : Type) ?= defaultValue
  if(ast_expr_is_fn_call_of(expr, "?=",.Some(usize(2))), {
    expr = match(
      _fn_call_args(expr).get(usize(0)),
      .Some(a) => a,
      .None => return(Option(ExtractComptimeResult).None)
    );
  });
  // Handle assigned value: (comptime(name) : Type) = value
  if(ast_expr_is_fn_call_of(expr, "=",.Some(usize(2))), {
    expr = match(
      _fn_call_args(expr).get(usize(0)),
      .Some(a) => a,
      .None => return(Option(ExtractComptimeResult).None)
    );
  });
  // Expect: comptime(name) : Type — form :(lhs, rhs)
  if(!(ast_expr_is_fn_call_of(expr, ":",.Some(usize(2)))), {
    return(Option(ExtractComptimeResult).None);
  });
  args := _fn_call_args(expr);
  lhs := match(args.get(usize(0)),.Some(a) => a,.None => return(Option(ExtractComptimeResult).None));
  type_e := match(args.get(usize(1)),.Some(a) => a,.None => return(Option(ExtractComptimeResult).None));
  // Check if lhs is comptime(name)
  if(!(ast_expr_is_fn_call_of(lhs, BK_COMPTIME,.Some(usize(1)))), {
    return(Option(ExtractComptimeResult).None);
  });
  name_expr := match(
    _fn_call_args(lhs).get(usize(0)),
    .Some(a) => a,
    .None => return(Option(ExtractComptimeResult).None)
  );
  if(!(ast_expr_is_atom(name_expr)), {
    return(Option(ExtractComptimeResult).None);
  });
  if(!(is_valid_variable_name(name_expr)), {
    return(Option(ExtractComptimeResult).None);
  });
  .Some(
    ExtractComptimeResult(
      ast_expr_token(name_expr).value,
      type_e,
      ast_expr_token(name_expr)
    )
  )
});
// ---------------------------------------------------------------------------
// evaluate_function_parameter
// ---------------------------------------------------------------------------
/// Evaluate a single function parameter expression.
///
/// Mirrors `evaluateFunctionParameter` from function.ts lines 140-734.
evaluate_function_parameter :: (
  fn(
    expr : AstExpr,
    env_mut : Environment,
    ctx : EvalContext,
    is_parameter_comptime_by_default : bool,
    allow_shadowing : bool,
    exn : Exception
  ) -> FuncParam
)({
  (label : Option(String)) = Option(String).None;
  (is_compile_time_only : bool) = is_parameter_comptime_by_default;
  (is_quote : bool) = false;
  (is_owning_rc_value : bool) = false;
  (is_param_ref : bool) = false;
  (lhs_expr : Option(AstExpr)) = Option(AstExpr).None;
  (type_expr : Option(AstExpr)) = Option(AstExpr).None;
  (label_expr : Option(AstExpr)) = Option(AstExpr).None;
  (default_value_expr : Option(AstExpr)) = Option(AstExpr).None;
  (assigned_value_expr : Option(AstExpr)) = Option(AstExpr).None;
  // The evaluated default value (`?= <value>`), captured for the
  // default-argument side-table so omitted args can be bound to it at
  // call sites. `.None` for a required parameter.
  (captured_default_value : Option(EvalValue)) = Option(EvalValue).None;
  (expr_mut : AstExpr) = expr;
  // Handle assigned value: (T : Type) = value
  if(ast_expr_is_fn_call_of(expr_mut, "=",.Some(usize(2))), {
    if(ast_expr_is_fn_call_of(
      match(_fn_call_args(expr_mut).get(usize(0)),.Some(a) => a,.None => make_err_expr()),
      ":",
      .Some(usize(2))
    ), {
      lhs_expr =.Some(match(_fn_call_args(expr_mut).get(usize(0)),.Some(a) => a,.None => make_err_expr()));
      assigned_value_expr =.Some(match(_fn_call_args(expr_mut).get(usize(1)),.Some(a) => a,.None => make_err_expr()));
      expr_mut = match(_fn_call_args(expr_mut).get(usize(0)),.Some(a) => a,.None => make_err_expr());
    }, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr_mut),
            `Use "?=" for default parameter values. Assigned values require an explicit type: (name : Type) = value.`,
            false,
            .None
          )
        )
      );
    });
  });
  // Disallow ":=" in parameter lists
  if(ast_expr_is_fn_call_of(expr_mut, ":=",.Some(usize(2))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr_mut),
          `":=" is not allowed in parameter lists. Use (name : Type) = value instead.`,
          false,
          .None
        )
      )
    );
  });
  // Handle default value: (x: i32) ?= 13
  if(ast_expr_is_fn_call_of(expr_mut, "?=",.Some(usize(2))), {
    default_value_expr =.Some(match(_fn_call_args(expr_mut).get(usize(1)),.Some(a) => a,.None => make_err_expr()));
    lhs_expr =.Some(match(_fn_call_args(expr_mut).get(usize(0)),.Some(a) => a,.None => make_err_expr()));
    expr_mut = match(lhs_expr,.Some(e) => e,.None => make_err_expr());
  });
  // Parse label and type: (x: i32)
  if(ast_expr_is_fn_call_of(expr_mut, ":",.Some(usize(2))), {
    lhs_expr =.Some(match(_fn_call_args(expr_mut).get(usize(0)),.Some(a) => a,.None => make_err_expr()));
    type_expr =.Some(match(_fn_call_args(expr_mut).get(usize(1)),.Some(a) => a,.None => make_err_expr()));
  }, {
    if(assigned_value_expr.is_none(), {
      if(default_value_expr.is_none(), {
        type_expr =.Some(expr_mut);
      }, {
        // (x ?= 13) — no type annotation
        lhs_expr =.Some(expr_mut);
      });
    }, {
      lhs_expr =.Some(expr_mut);
    });
  });
  // Type annotation is required
  _type_err_msg := if(
    default_value_expr.is_some(),
    `Default parameters must specify a type: (name : Type) ?= value.`,
    `Expected an explicit type annotation for function parameter. Use "(name : Type)".`
  );
  if(type_expr.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          _type_err_msg,
          false,
          .None
        )
      )
    );
  });
  // Process label expression modifiers: comptime, own, quote
  match(
    lhs_expr,
    .Some(lhs) => {
      (lhs_mut : AstExpr) = lhs;
      // comptime modifier
      if(ast_expr_is_fn_call_of(lhs_mut, BK_COMPTIME, Option(usize).None), {
        if(is_parameter_comptime_by_default, {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(lhs_mut),
                `"generic"/"using" parameters are "comptime" by default. Not needed to use "comptime" modifier.`,
                false,
                .None
              )
            )
          );
        });
        is_compile_time_only = true;
        c_args := _fn_call_args(lhs_mut);
        if(!(c_args.len() == usize(1)), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(lhs_mut),
                `Expected one argument for "comptime", got ${c_args.len()}`,
                false,
                .None
              )
            )
          );
        });
        lhs_mut = match(c_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
      });
      // ref modifier — strip the wrapper and record the `ref` flag (consumed
      // into the Func type's `param_is_ref` for the flow-soundness check).
      if(ast_expr_is_fn_call_of(lhs_mut, BK_INOUT, Option(usize).None), {
        r_args := _fn_call_args(lhs_mut);
        if(!(r_args.len() == usize(1)), {
          exn.throw(
            dyn(format_error_message(ast_expr_token(lhs_mut), `Expected one argument for "ref", got ${r_args.len()}`, false,.None))
          );
        });
        is_param_ref = true;
        lhs_mut = match(r_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
      });
      // own modifier
      if(ast_expr_is_fn_call_of(lhs_mut, "own", Option(usize).None), {
        is_owning_rc_value = true;
        o_args := _fn_call_args(lhs_mut);
        if(!(o_args.len() == usize(1)), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(lhs_mut),
                `Expected one argument for "own", got ${o_args.len()}`,
                false,
                .None
              )
            )
          );
        });
        lhs_mut = match(o_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
      });
      // quote modifier
      if(ast_expr_is_fn_call_of(lhs_mut, BK_QUOTE, Option(usize).None), {
        is_quote = true;
        q_args := _fn_call_args(lhs_mut);
        if(!(q_args.len() == usize(1)), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(lhs_mut),
                `Expected one argument for "quote" (or ":"), got ${q_args.len()}`,
                false,
                .None
              )
            )
          );
        });
        if(is_compile_time_only, {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(lhs_mut),
                `Cannot use "comptime" with "quote" (or ":"). "quote" parameters means compile-time only, so "comptime" is redundant.`,
                false,
                .None
              )
            )
          );
        });
        is_compile_time_only = true;
        lhs_mut = match(q_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
      });
      if(!(ast_expr_is_atom(lhs_mut)) || !(is_valid_variable_name(lhs_mut)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(lhs_mut),
              `Expected identifier for parameter label, got ${ast_expr_to_string(lhs_mut)}`,
              false,
              .None
            )
          )
        );
      });
      label =.Some(ast_expr_token(lhs_mut).value);
      label_expr =.Some(lhs_mut);
    },
    .None => ()
  );
  // A label is required
  if(label.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected a label for function parameter, got ${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  // Disallow "Self" as label
  if(match(label,.Some(l) => (l == "Self"),.None => false), {
    exn.throw(
      dyn(
        format_error_message(
          match(label_expr,.Some(e) => ast_expr_token(e),.None => ast_expr_token(expr)),
          String.from("Not allowed to use 'Self' as the label."),
          false,
          .None
        )
      )
    );
  });
  // Evaluate assigned value expression (generic((T : Type) = Impl(Id)) form)
  (param_type : Option(TypeValue)) = Option(TypeValue).None;
  (assigned_value : Option(EvalValue)) = Option(EvalValue).None;
  match(
    assigned_value_expr,
    .Some(ave) => {
      av_ty_opt := _eval_and_update_env(ave, env_mut, ctx, exn);
      if(av_ty_opt.is_none(), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(ave),
              `Expected type value for = assignment, got ${ast_expr_to_string(ave)}`,
              false,
              .None
            )
          )
        );
      });
      param_type =.Some(t_type());
      assigned_value =.Some(create_type_value(match(av_ty_opt,.Some(t) => t,.None => TypeValue.Unit)));
      if(!(is_compile_time_only), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(ave),
              `Assigned value (=) is only allowed for compile-time parameters. Use "comptime(${match(label, .Some(l) => l, .None => String.from("?"))})" or put this in "generic(...)".`,
              false,
              .None
            )
          )
        );
      });
    },
    .None => ()
  );
  // Evaluate type expression
  match(
    type_expr,
    .Some(te) => {
      ty_opt := _eval_and_update_env(te, env_mut, ctx, exn);
      if(ty_opt.is_none(), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(te),
              `(3) Failed to evaluate type expression: ${ast_expr_to_string(te)}`,
              false,
              .None
            )
          )
        );
      });
      param_type =.Some(match(ty_opt,.Some(t) => t,.None => TypeValue.Unit));
    },
    .None => ()
  );
  // Evaluate default value expression.
  //
  // Mirror TS `function.ts:399-440` — the default value's VALUE and
  // TYPE are extracted separately from the evaluated expression's
  // ExprInfo. A default like `?= i32(42)` evaluates to an i32 value
  // (not a TypeValue), so we cannot route through `_eval_and_update_env`
  // (which is type-only and would return `.None` here, triggering a
  // spurious `Expected a compile-time known value for default
  // parameter` error). Read the ExprInfo directly.
  match(
    default_value_expr,
    .Some(dve) => {
      // Use raw evaluator path so throws (e.g. propagated from
      // nested type evaluations) reach the caller's exn cleanly
      // instead of via the panic wrapper.
      saved_expected := ctx.expected_type;
      ctx.expected_type = match(
        param_type,
        .Some(pt) => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(pt, env_mut)),
        .None => saved_expected
      );
      evaluated_dve := evaluate_expression_raw(dve, env_mut, ctx, exn);
      ctx.expected_type = saved_expected;
      info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_dve));
      match(
        info_opt,
        .Some(info) => {
          env_mut.frames = info.env.frames;
          env_mut.module_path = info.env.module_path;
          env_mut.function_declaration_frame_level = info.env.function_declaration_frame_level;
          env_mut.input_string = info.env.input_string;
          dv_val_opt := info.value;
          captured_default_value = dv_val_opt;
          // Coerce comptime types (e.g. comptime_str) to their runtime
          // equivalents when the param has an explicit annotation. Mirrors
          // TS `convertComptimeTypeToRuntimeType` at default-value sites —
          // lets `(msg : str) ?= "Assertion failed."` typecheck because the
          // comptime_str literal coerces to `str` (or `*(u8)`/`*(char)`/
          // `[u8]` if explicitly expected).
          dv_ty := convert_comptime_type_to_runtime_type_with_expected(
            info.ty,
            param_type,
            env_mut
          );
          match(
            dv_val_opt,
            .Some(_dv_val) => {
              match(
                param_type,
                .None => {
                  param_type =.Some(dv_ty);
                },
                .Some(pt) => {
                  // When the parameter type still contains an unresolved
                  // generic (`(msg : T) ?= "..."` with `generic(T)`), defer
                  // the check to the call site: binding the default there
                  // infers T from the default value and validates any
                  // `where` constraints, exactly like an explicitly passed
                  // argument. Mirrors TS function.ts (same guard).
                  if((!(type_contains_some_type(pt))) && (!(are_types_compatible(pt, dv_ty))), {
                    exn.throw(
                      dyn(
                        format_error_message(
                          ast_expr_token(dve),
                          `Incompatible default value type:\n- Expected: ${type_to_string(pt)}\n- Got     : ${type_to_string(dv_ty)}`,
                          false,
                          .None
                        )
                      )
                    );
                  });
                }
              );
            },
            .None => {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(dve),
                    `Expected a compile-time known value for default parameter, got ${ast_expr_to_string(dve)}`,
                    false,
                    .None
                  )
                )
              );
            }
          );
        },
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(dve),
                `Failed to evaluate default value expression`,
                false,
                .None
              )
            )
          );
        }
      );
    },
    .None => ()
  );
  // Unwrap param_type (must be set by now)
  final_param_type := match(
    param_type,
    .Some(pt) => pt,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("Expected type for function parameter}"),
            false,
            .None
          )
        )
      );
      TypeValue.Unit
    }
  );
  // Raw-view naming gate (plans/SLICE_REWORK.md): a SAFE file may not
  // annotate a parameter with a type whose representation carries a raw
  // pointer (RawSlice(T), structs wrapping *(T), ...). Mirrors the TS gate
  // in src/evaluator/types/function.ts.
  if((!(ctx.unsafe_context)) &&
    (!(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(expr).module_path.clone())))) &&
      type_representation_contains_raw_ptr(final_param_type), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Raw-pointer-carrying types ('${type_to_string(final_param_type)}') are not available in safe code.\n\nUse owned collections (ArrayList/String), 'inout(name) : T' parameters for in-place mutation, or 'str' for static string views. If this file genuinely needs the raw view, add 'pragma(Pragma.AllowUnsafe);' at the top.`,
          false,
          .None
        )
      )
    );
  });
  // Validate comptime + type compatibility
  if(is_compile_time_only &&
    !(type_contains_some_type(final_param_type)) &&
      type_prohibits_comptime_modifier(final_param_type), {
    exn.throw(
      dyn(
        format_error_message(
          match(label_expr,.Some(e) => ast_expr_token(e),.None => ast_expr_token(expr)),
          `Parameter marked as "comptime" but type is not available at compile-time:\n${type_to_string(final_param_type)}`,
          false,
          .None
        )
      )
    );
  });
  if(!(is_compile_time_only) && type_requires_comptime_modifier(final_param_type), {
    exn.throw(
      dyn(
        format_error_message(
          match(label_expr,.Some(e) => ast_expr_token(e),.None => ast_expr_token(expr)),
          `Parameter marked as runtime but type is not available at runtime:\n${type_to_string(final_param_type)}`,
          false,
          .None
        )
      )
    );
  });
  // Validate runtime function parameters with generic function types
  if(!(is_compile_time_only) && is_function_type(final_param_type), {
    has_forall := match(
      final_param_type,
      .Func({ meta : __fm1 }) => (__fm1.*.forall_labels.len() > usize(0)),
      _ => false
    );
    if(has_forall, {
      exn.throw(
        dyn(
          format_error_message(
            match(label_expr,.Some(e) => ast_expr_token(e),.None => ast_expr_token(expr)),
            `Runtime function parameters with generic function types are not allowed:\n${type_to_string(final_param_type)}\n\nGeneric functions must be compile-time known to enable monomorphization. Consider using:\ncomptime(${match(label, .Some(l) => l, .None => String.from("?"))}) : ${type_to_string(final_param_type)}`,
            false,
            .None
          )
        )
      );
    });
  });
  // quote type must be Expr or ExprList
  if(is_quote &&
    !(is_expr_type(final_param_type)) &&
      !(is_expr_list_type(final_param_type)), {
    exn.throw(
      dyn(
        format_error_message(
          match(label_expr,.Some(e) => ast_expr_token(e),.None => ast_expr_token(expr)),
          `Expected Expr or ExprList type for "quote" (or ":") parameter, got ${type_to_string(final_param_type)}`,
          false,
          .None
        )
      )
    );
  });
  // Prohibit void type as parameter type
  if(!(ctx.is_unsafe_function_type), {
    prohibit_void_type(final_param_type, match(type_expr,.Some(e) => ast_expr_token(e),.None => ast_expr_token(expr)), exn);
  });
  // Validate trait type must have receiver type already set (error if not)
  if(is_trait_type(final_param_type), {
    has_receiver := match(
      final_param_type,
      .TraitT(_, _, _, _, _, is_concrete, _, _, _, _) => is_concrete.is_some(),
      _ => true
    );
    if(!(has_receiver), {
      exn.throw(
        dyn(
          format_error_message(
            match(type_expr,.Some(e) => ast_expr_token(e),.None => ast_expr_token(expr)),
            `Trait type without receiver type set cannot be used as function parameter type.
        
Please consider using "<:" to specify the receiver type for a trait type, for example:

Id :: trait(id   : (fn(self : Self) -> Self)));

use_id :: (fn(generic(T : Type),
              val : T, 
              where(T <: Id)
          ) -> T)({
  return(val.id());
})`,
            false,
            .None
          )
        )
      );
    });
  });
  label_str := match(label,.Some(l) => l,.None => String.from("?"));
  lbl_tok := match(label_expr,.Some(e) => ast_expr_token(e),.None => ast_expr_token(expr));
  // Check if variable already exists from where clause or pre-add pass
  existing_vars := get_variables_from_env(env_mut, label_str);
  n_existing := existing_vars.len();
  // Find where-clause pre-created SomeT variable (last binding that is a SomeT)
  (existing_where_var : Option(Variable)) = Option(Variable).None;
  (existing_pre_var : Option(Variable)) = Option(Variable).None;
  (vi : usize) = n_existing;
  while(vi > usize(0), {
    vi = (vi - usize(1));
    v := match(
      existing_vars.get(vi),
      .Some(x) => x,
      .None => {
        vi = usize(0);
        break;
      }
    );
    match(
      v.value.get(usize(0)),
      .Some(ev) => {
        match(
          ev,
          .TypeVal(b) => {
            if(is_some_type(b), {
              existing_where_var =.Some(v);
              vi = usize(0); // break
            });
          },
          _ => ()
        );
      },
      .None => ()
    );
  });
  // Find last pre-added comptime var in current top frame
  if(existing_where_var.is_none() && (n_existing > usize(0)), {
    last_v := match(
      existing_vars.get(n_existing - usize(1)),
      .Some(x) => x,
      .None => return(
        FuncParam(
          label_str,
          final_param_type,
          is_compile_time_only,
          is_quote,
          is_owning_rc_value,
          false,
          false,
          captured_default_value,
          is_param_ref,
          default_value_expr,
          type_expr
        )
      )
    );
    top_frame_level := (env_mut.frames.len() - usize(1));
    if(last_v.is_compile_time_only && (last_v.frame_level == top_frame_level), {
      existing_pre_var =.Some(last_v);
    });
  });
  // Determine actual type and value for the variable
  (actual_param_type : TypeValue) = final_param_type;
  match(
    existing_where_var,
    .Some(wv) => {
      // Variable pre-created by where clause — reuse its SomeT
      existing_some_ty := match(wv.value.get(usize(0)),.Some(ev) => match(ev,.TypeVal(b) => b, _ => TypeValue.Unit),.None => TypeValue.Unit);
      // If assigned_value is a SomeT, merge traits from it
      match(
        assigned_value,
        .Some(av) => {
          match(
            av,
            .TypeVal(av_box) => {
              if(is_some_type(av_box), {
                new_some := av_box;
                match(
                  new_some,
                  .SomeT(_, _, _, _, new_rtt, _, new_ntt, _, _, _, _) => {
                    // Merge required traits
                    (ri : usize) = usize(0);
                    while(ri < new_rtt.len(), {
                      nt := match(
                        new_rtt.get(ri),
                        .Some(t) => t,
                        .None => {
                          ri = new_rtt.len();
                          TypeValue.Unit
                        }
                      );
                      _add_where_clause_constraint(existing_some_ty, nt, false);
                      ri = (ri + usize(1));
                    });
                    // Merge negative traits
                    (ni : usize) = usize(0);
                    while(ni < new_ntt.len(), {
                      nt := match(
                        new_ntt.get(ni),
                        .Some(t) => t,
                        .None => {
                          ni = new_ntt.len();
                          TypeValue.Unit
                        }
                      );
                      _add_where_clause_constraint(existing_some_ty, nt, true);
                      ni = (ni + usize(1));
                    });
                  },
                  _ => ()
                );
              });
            },
            _ => ()
          );
        },
        .None => ()
      );
      actual_param_type = type_of_type(existing_some_ty);
      // Set expr info on the label expr
      match(
        label_expr,
        .Some(le) => {
          le_info := new_expr_info(env_mut, actual_param_type);
          le_info.value =.Some(match(wv.value.get(usize(0)),.Some(v) => v,.None => EvalValue.UnitVal));
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(le), le_info);
        },
        .None => ()
      );
    },
    .None => {
      match(
        existing_pre_var,
        .Some(pv) => {
          // Pre-added by comptime pre-scan pass — reuse it
          actual_param_type = pv.ty;
          match(
            label_expr,
            .Some(le) => {
              le_info := new_expr_info(env_mut, actual_param_type);
              le_info.value = pv.value.get(usize(0));
              expr_info_table_set(ctx.expr_info_table, ast_expr_id(le), le_info);
            },
            .None => ()
          );
        },
        .None => {
          // No existing variable — add new one.
          //
          // When the parameter type is `Type` (TypeUni(0)) — e.g.
          // `generic(T : Type)` — bind to `TypeVal(SomeT(...))` rather
          // than `UnknownVal(...)`. Mirrors TS `createUnknownValue`
          // (src/value.ts:573-588) which returns a TypeValue wrapping
          // a fresh SomeType for level-0 type-hierarchy types. Where
          // clauses (`T <: Trait`) and identifier lookups expect to
          // see a TypeVal(SomeT) so they can attach constraints.
          (param_frame_level : usize) = if(
            env_mut.frames.len() > usize(0),
            env_mut.frames.len() - usize(1),
            usize(0)
          );
          (param_val : Option(EvalValue)) = match(
            assigned_value,
            .Some(av) =>.Some(av),
            .None =>
              if(
                is_compile_time_only,
                if(
                  is_type_0(final_param_type),
                  Option(EvalValue).Some(create_type_value(t_some_t(label_str, param_frame_level))),
                  // HKT: a function-kind annotation (e.g.
                  // `F : (fn(comptime(T) : Type) -> comptime(Type))`) binds F as
                  // a SomeType carrying `kind_function_type`, so a later `F(A)`
                  // can evaluate to a TypeApplication. Mirrors `value.ts:598-624`.
                  if(
                    match(
                      final_param_type,
                      .Func({ result, meta : __fm2 }) => (__fm2.*.result_is_comptime_only && is_type_0(result)),
                      _ => false
                    ),
                    Option(EvalValue).Some(create_type_value(t_some_t_with_kind(label_str, param_frame_level, final_param_type))),
                    Option(EvalValue).Some(create_unknown_val(final_param_type))
                  )
                ),
                Option(EvalValue).None
              )
          );
          add_variable_to_env(
            env_mut,
            label_str,
            final_param_type,
            param_val,
            is_compile_time_only,
            false,
            // is_reassignable
            is_owning_rc_value,
            // is_owning_the_rc_value
            false,
            // is_implicit
            lbl_tok
          );
          // Set expr info on label expr
          match(
            label_expr,
            .Some(le) => {
              le_info := new_expr_info(env_mut, actual_param_type);
              le_info.value = param_val;
              expr_info_table_set(ctx.expr_info_table, ast_expr_id(le), le_info);
            },
            .None => ()
          );
        }
      );
    }
  );
  // Set expr info on the outer expr (if different from label_expr)
  match(
    label_expr,
    .Some(le) => {
      if(ast_expr_id(le) != ast_expr_id(expr), {
        outer_info := new_expr_info(env_mut, TypeValue.Unit);
        outer_info.value =.Some(EvalValue.UnitVal);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), outer_info);
      });
    },
    .None => ()
  );
  FuncParam(
    label_str,
    actual_param_type,
    is_compile_time_only,
    is_quote,
    is_owning_rc_value,
    false,
    false,
    captured_default_value,
    is_param_ref,
    default_value_expr,
    type_expr
  )
});
// ---------------------------------------------------------------------------
// validate_concrete_type_constraints
// ---------------------------------------------------------------------------
/// Validate that a concrete type satisfies all trait constraints from a where clause.
/// Mirrors `validateConcreteTypeConstraints` from function.ts lines 1466-1564.
validate_concrete_type_constraints :: (
  fn(
    concrete_type : TypeValue,
    rhs_expr : AstExpr,
    constraint_expr : AstExpr,
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  // Collect (trait_expr, is_negated) pairs.
  // Tuple form: (Trait1, Trait2, ...) or single: Trait / !(Trait)
  (trait_exprs : ArrayList(AstExpr)) = ArrayList(AstExpr).new();
  (trait_negated : ArrayList(bool)) = ArrayList(bool).new();
  if(ast_expr_is_fn_call_of(rhs_expr, BK_TUPLE,.None), {
    (args : ArrayList(AstExpr)) = _fn_call_args(rhs_expr);
    (i : usize) = usize(0);
    while(i < args.len(), {
      (arg : AstExpr) = match(
        args.get(i),
        .Some(a) => a,
        .None => {
          i = (i + usize(1));
          return(());
        }
      );
      if(ast_expr_is_fn_call_of(arg, "!",.Some(usize(1))), {
        (inner : AstExpr) = match(_fn_call_args(arg).get(usize(0)),.Some(a) => a,.None => arg);
        trait_exprs.push(inner);
        trait_negated.push(true);
      }, {
        trait_exprs.push(arg);
        trait_negated.push(false);
      });
      i = (i + usize(1));
    });
  }, {
    if(ast_expr_is_fn_call_of(rhs_expr, "!",.Some(usize(1))), {
      (inner : AstExpr) = match(_fn_call_args(rhs_expr).get(usize(0)),.Some(a) => a,.None => rhs_expr);
      trait_exprs.push(inner);
      trait_negated.push(true);
    }, {
      trait_exprs.push(rhs_expr);
      trait_negated.push(false);
    });
  });
  // For each (trait_expr, is_negated): evaluate, check, throw if violated
  (j : usize) = usize(0);
  while(j < trait_exprs.len(), {
    (t_expr : AstExpr) = match(
      trait_exprs.get(j),
      .Some(e) => e,
      .None => {
        j = (j + usize(1));
        return(());
      }
    );
    (negated : bool) = match(trait_negated.get(j),.Some(b) => b,.None => false);
    evaled_t := evaluate_expression_raw(t_expr, env_mut, ctx, exn);
    info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_t));
    evaled_t;
    info := match(
      info_opt,
      .Some(i) => i,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(t_expr),
              String.from("validate_concrete_type_constraints: failed to evaluate trait expression"),
              false,
              .None
            )
          )
        );
        new_expr_info(env_mut, t_unit())
      }
    );
    env_mut.frames = info.env.frames;
    env_mut.module_path = info.env.module_path;
    env_mut.function_declaration_frame_level = info.env.function_declaration_frame_level;
    env_mut.input_string = info.env.input_string;
    if(is_type_value(info.value), {
      tv := match(
        info.value,
        .Some(ev) => match(
          ev,
          .TypeVal(b) => b,
          _ => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(t_expr),
                  String.from("Expected trait type for right-hand side of where clause constraint."),
                  false,
                  .None
                )
              )
            );
            return(());
          }
        ),
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(t_expr),
                String.from("Expected trait type for right-hand side of where clause constraint."),
                false,
                .None
              )
            )
          );
          return(());
        }
      );
      if(!(is_trait_type(tv)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(t_expr),
              String.from("Expected trait type for right-hand side of where clause constraint, got: ").concat(type_to_string(tv)),
              false,
              .None
            )
          )
        );
      });
      // Use the FULL type_implements_trait (not the Bool wrapper) so bindings
      // produced during trait satisfaction — synthesizing `A := i32`,
      // `B := i32` from `F <: (Fn(a : A) -> B)` against `fn(x : i32) -> i32`
      // — propagate back into `env_mut`. TS threads `envAfterCheck` the same
      // way (function.ts:979-987 and 1598-1603); discarding it left A/B as
      // SomeTs and the method body specialized a shadow struct
      // ("Type mismatch for type member \"_f\"").
      tc_res := type_implements_trait(concrete_type, tv, env_mut);
      implemented := tc_res.implemented;
      env_mut.frames = tc_res.env.frames;
      if(negated, {
        if(implemented, {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(constraint_expr),
                String.from("Type ").concat(type_to_string(concrete_type)).concat(String.from(" must NOT implement ")).concat(type_to_string(tv)).concat(String.from(", but it does.")),
                false,
                .None
              )
            )
          );
        });
      }, {
        if(!(implemented), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(constraint_expr),
                String.from("Type ").concat(type_to_string(concrete_type)).concat(String.from(" does not implement required trait ")).concat(type_to_string(tv)).concat(String.from(".")),
                false,
                .None
              )
            )
          );
        });
      });
    }, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(t_expr),
            String.from("Expected trait type for right-hand side of where clause constraint."),
            false,
            .None
          )
        )
      );
    });
    j = (j + usize(1));
  });
});
// ---------------------------------------------------------------------------
// apply_single_trait_constraint
// ---------------------------------------------------------------------------
/// Try to apply a single trait constraint to a SomeType.
/// Returns true if the trait was successfully applied, false if it failed (retry later).
///
/// Mirrors `applySingleTraitConstraint` from function.ts lines 953-1104.
apply_single_trait_constraint :: (
  fn(
    lhs_expr : AstExpr,
    trait_expr : AstExpr,
    original_constraint_expr : AstExpr,
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> bool
)({
  // Check if trait expression is negated: !(Trait)
  (is_negated : bool) = false;
  (unwrapped_trait_expr : AstExpr) = trait_expr;
  if(ast_expr_is_fn_call_of(trait_expr, "!",.Some(usize(1))), {
    is_negated = true;
    unwrapped_trait_expr = match(
      _fn_call_args(trait_expr).get(usize(0)),
      .Some(a) => a,
      .None => trait_expr
    );
  });
  // Resolve LHS to a SomeType
  (some_ty_opt : Option(TypeValue)) = Option(TypeValue).None;
  if(ast_expr_is_atom(lhs_expr), {
    var_name := ast_expr_token(lhs_expr).value;
    existing_vars := get_variables_from_env(env_mut, var_name);
    if(existing_vars.len() == usize(0), {
      return(false);
    });
    last_var := match(existing_vars.get(existing_vars.len() - usize(1)),.Some(v) => v,.None => return(false));
    match(
      last_var.value.get(usize(0)),
      .Some(ev) => {
        match(
          ev,
          .TypeVal(b) => {
            if(is_some_type(b), {
              some_ty_opt =.Some(b);
            }, {
              // Concrete type — validate constraint using validate_concrete_type_constraints.
              // Use outer exn directly (hard failure) — the given/using soft-failure pattern
              // generates incomplete C calls (missing exn__throw argument).
              validate_concrete_type_constraints(b, unwrapped_trait_expr, original_constraint_expr, env_mut, ctx, exn);
              return(true);
            });
          },
          _ => {
            return(false);
          }
        );
      },
      .None => {
        return(false);
      }
    );
  }, {
    // Evaluate LHS expression
    (lhs_ty : TypeValue) = TypeValue.Unit;
    evaluated := evaluate_expression_raw(lhs_expr, env_mut, ctx, exn);
    info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
    info := match(
      info_opt,
      .Some(i) => i,
      .None => {
        return(false);
      }
    );
    if(!(is_type_value(info.value)), {
      return(false);
    });
    env_mut.frames = info.env.frames;
    env_mut.module_path = info.env.module_path;
    env_mut.function_declaration_frame_level = info.env.function_declaration_frame_level;
    env_mut.input_string = info.env.input_string;
    lhs_ty = match(info.value,.Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),.None => TypeValue.Unit);
    if(is_some_type(lhs_ty), {
      some_ty_opt =.Some(lhs_ty);
    }, {
      // Concrete type — use outer exn (hard failure)
      validate_concrete_type_constraints(lhs_ty, unwrapped_trait_expr, original_constraint_expr, env_mut, ctx, exn);
      return(true);
    });
  });
  some_ty := match(
    some_ty_opt,
    .Some(t) => t,
    .None => {
      return(false);
    }
  );
  // Evaluate trait expression (unwrapped)
  (trait_ty : TypeValue) = TypeValue.Unit;
  evaluated_rhs := evaluate_expression_raw(unwrapped_trait_expr, env_mut, ctx, exn);
  info_rhs_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_rhs));
  info_rhs := match(
    info_rhs_opt,
    .Some(i) => i,
    .None => {
      return(false);
    }
  );
  if(!(is_type_value(info_rhs.value)), {
    return(false);
  });
  env_mut.frames = info_rhs.env.frames;
  env_mut.module_path = info_rhs.env.module_path;
  env_mut.function_declaration_frame_level = info_rhs.env.function_declaration_frame_level;
  env_mut.input_string = info_rhs.env.input_string;
  trait_ty = match(info_rhs.value,.Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),.None => TypeValue.Unit);
  if(!(is_trait_type(trait_ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(unwrapped_trait_expr),
          `Expected trait type for right-hand side of where clause constraint, got: ${type_to_string(trait_ty)}`,
          false,
          .None
        )
      )
    );
  });
  // Check that the trait does not already have a receiver type
  if(_trait_has_receiver(trait_ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(unwrapped_trait_expr),
          String.from("Trait type in where clause already has a receiver type assigned."),
          false,
          .None
        )
      )
    );
  });
  // Add the constraint directly to the SomeT's ArrayLists
  _add_where_clause_constraint(some_ty, trait_ty, is_negated);
  true
});
// ---------------------------------------------------------------------------
// parse_where_clause_constraints
// ---------------------------------------------------------------------------
/// Parse where clause constraint expressions and apply them.
/// If collect_pending is true, failed individual traits are collected for retry.
///
/// Mirrors `parseWhereClauseConstraints` from function.ts lines 1115-1433.
parse_where_clause_constraints :: (
  fn(
    constraint_exprs : ArrayList(AstExpr),
    env_mut : Environment,
    ctx : EvalContext,
    collect_pending : bool,
    exn : Exception
  ) -> ArrayList(PendingConstraint)
)({
  pending_traits := ArrayList(PendingConstraint).new();
  (ci : usize) = usize(0);
  while(ci < constraint_exprs.len(), {
    constraint_expr := match(
      constraint_exprs.get(ci),
      .Some(e) => e,
      .None => {
        ci = constraint_exprs.len();
        AstExpr.Atom(usize(0), Token(kind : TokenKind.Identifier, value : String.from(""), row : usize(0), column : usize(0), character : usize(0), module_path : String.from(""), input : String.from("")))
      }
    );
    ci = (ci + usize(1));
    if(!(ast_expr_is_fn_call_of(constraint_expr, "<:",.Some(usize(2)))), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(constraint_expr),
            `Expected constraint in the form "T <: Trait" or "T <: (Trait1, Trait2)", got: ${ast_expr_to_string(constraint_expr)}`,
            false,
            .None
          )
        )
      );
    });
    c_args := _fn_call_args(constraint_expr);
    lhs_expr := match(c_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    rhs_expr := match(c_args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
    // Resolve LHS
    (some_ty_opt : Option(TypeValue)) = Option(TypeValue).None;
    // HKT: set when the LHS is a TypeApplication `F(A)` (where-clause over a
    // higher-kinded constructor application). Recorded via the dedicated
    // type-application constraint table instead of a SomeT's constraint list.
    (type_app_lhs : Option(TypeValue)) = Option(TypeValue).None;
    (is_concrete_type : bool) = false;
    (skip_constraint : bool) = false;
    if(ast_expr_is_atom(lhs_expr), {
      var_name := ast_expr_token(lhs_expr).value;
      existing_vars := get_variables_from_env(env_mut, var_name);
      if(existing_vars.len() > usize(0), {
        last_v := match(existing_vars.get(existing_vars.len() - usize(1)),.Some(v) => v,.None => return(pending_traits));
        match(
          last_v.value.get(usize(0)),
          .Some(ev) => {
            match(
              ev,
              .TypeVal(b) => {
                if(is_some_type(b), {
                  some_ty_opt =.Some(b);
                }, {
                  // Concrete type — use outer exn (hard failure).
                  // The given/using soft-failure pattern generates incomplete C calls.
                  // collect_pending behavior is simplified: hard failure on constraint violation.
                  is_concrete_type = true;
                  validate_concrete_type_constraints(b, rhs_expr, constraint_expr, env_mut, ctx, exn);
                  skip_constraint = true;
                });
              },
              _ => {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(lhs_expr),
                      `Expected type for left-hand side of where clause constraint, got variable "${var_name}".`,
                      false,
                      .None
                    )
                  )
                );
              }
            );
          },
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(lhs_expr),
                  `Expected type for left-hand side of where clause constraint, got variable "${var_name}".`,
                  false,
                  .None
                )
              )
            );
          }
        );
      }, {
        // Create new SomeType for this variable
        top_frame := env_mut.frames.len();
        if(top_frame == usize(0), {
          return(pending_traits);
        });
        new_some_ty := t_some_t(var_name, top_frame - usize(1));
        tv := create_type_value(new_some_ty);
        add_variable_to_env(
          env_mut,
          var_name,
          type_of_type(new_some_ty),
          .Some(tv),
          true,
          // is_compile_time_only
          false,
          // is_reassignable
          false,
          // is_owning_the_rc_value
          false,
          // is_implicit
          ast_expr_token(lhs_expr)
        );
        // Set expr info on lhs
        lhs_info := new_expr_info(env_mut, type_of_type(new_some_ty));
        lhs_info.value =.Some(tv);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(lhs_expr), lhs_info);
        some_ty_opt =.Some(new_some_ty);
      });
    }, {
      // Evaluate LHS expression
      // Note: errors propagate via outer exn (simplified from TS try/catch pattern)
      evaluated_lhs := evaluate_expression_raw(lhs_expr, env_mut, ctx, exn);
      lhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_lhs));
      lhs_info := match(
        lhs_info_opt,
        .Some(i) => i,
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(lhs_expr),
                String.from("Expected type for left-hand side of where clause constraint."),
                false,
                .None
              )
            )
          );
          new_expr_info(env_mut, TypeValue.Unit)
        }
      );
      if(!(is_type_value(lhs_info.value)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(lhs_expr),
              String.from("Expected type for left-hand side of where clause constraint."),
              false,
              .None
            )
          )
        );
      });
      env_mut.frames = lhs_info.env.frames;
      env_mut.module_path = lhs_info.env.module_path;
      env_mut.function_declaration_frame_level = lhs_info.env.function_declaration_frame_level;
      env_mut.input_string = lhs_info.env.input_string;
      lhs_tv := match(lhs_info.value,.Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),.None => TypeValue.Unit);
      // HKT TypeApplication case: record `F(A) <: Trait` via the dedicated
      // type-application constraint table (mirrors function.ts:1265-1348 +
      // addWhereClauseConstraintForTypeApplication). The RHS trait parsing
      // below is shared; the recording branches on `type_app_lhs`. A
      // TypeApplication is NOT concrete (its head is an abstract type-param),
      // so it must NOT fall into the concrete-type validation branch.
      if(is_type_application_type(lhs_tv), {
        type_app_lhs = Option(TypeValue).Some(lhs_tv);
      }, {
        if(is_some_type(lhs_tv), {
          some_ty_opt =.Some(lhs_tv);
        }, {
          // Concrete type — use outer exn (hard failure).
          // The given/using soft-failure pattern generates incomplete C calls.
          validate_concrete_type_constraints(lhs_tv, rhs_expr, constraint_expr, env_mut, ctx, exn);
          skip_constraint = true;
        });
      });
    });
    if(skip_constraint, {
      continue;
    });
    some_ty := match(
      some_ty_opt,
      .Some(t) => t,
      .None => match(
        type_app_lhs,
        // TypeApplication LHS: `some_ty` is unused on this path; bind a dummy.
        .Some(_) => t_unit(),
        .None => {
          continue;
        }
      )
    );
    // Parse RHS trait(s): single or tuple
    rhs_trait_exprs := ArrayList(AstExpr).new();
    if(ast_expr_is_fn_call_of(rhs_expr, BK_TUPLE,.None), {
      rhs_args := _fn_call_args(rhs_expr);
      (ri : usize) = usize(0);
      while(ri < rhs_args.len(), {
        rte := match(rhs_args.get(ri),.Some(a) => a,.None => make_err_expr());
        rhs_trait_exprs.push(rte);
        ri = (ri + usize(1));
      });
    }, {
      rhs_trait_exprs.push(rhs_expr);
    });
    // Evaluate each trait expression and apply constraint incrementally
    (ti : usize) = usize(0);
    while(ti < rhs_trait_exprs.len(), {
      trait_expr_item := match(rhs_trait_exprs.get(ti),.Some(a) => a,.None => make_err_expr());
      ti = (ti + usize(1));
      // Check negation
      (is_neg : bool) = false;
      (unwrapped_te : AstExpr) = trait_expr_item;
      if(ast_expr_is_fn_call_of(trait_expr_item, "!",.Some(usize(1))), {
        is_neg = true;
        unwrapped_te = match(
          _fn_call_args(trait_expr_item).get(usize(0)),
          .Some(a) => a,
          .None => trait_expr_item
        );
      });
      // Try to evaluate trait expression
      // Note: errors propagate via outer exn (collect_pending fallback simplified)
      (trait_ty2 : TypeValue) = TypeValue.Unit;
      evaluated_trait := evaluate_expression_raw(unwrapped_te, env_mut, ctx, exn);
      trait_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_trait));
      (skip_iter : bool) = false;
      trait_info := match(
        trait_info_opt,
        .Some(i) => i,
        .None => {
          if(!(collect_pending), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(unwrapped_te),
                  String.from("Expected trait type for right-hand side of where clause constraint."),
                  false,
                  .None
                )
              )
            );
          });
          pending_traits.push(PendingConstraint(lhs_expr, trait_expr_item, constraint_expr));
          skip_iter = true;
          new_expr_info(env_mut, TypeValue.Unit)
        }
      );
      if(skip_iter, {
        continue;
      });
      if(!(is_type_value(trait_info.value)), {
        if(!(collect_pending), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(unwrapped_te),
                String.from("Expected trait type for right-hand side of where clause constraint."),
                false,
                .None
              )
            )
          );
        });
        pending_traits.push(PendingConstraint(lhs_expr, trait_expr_item, constraint_expr));
        skip_iter = true;
      });
      if(skip_iter, {
        continue;
      });
      env_mut.frames = trait_info.env.frames;
      env_mut.module_path = trait_info.env.module_path;
      env_mut.function_declaration_frame_level = trait_info.env.function_declaration_frame_level;
      env_mut.input_string = trait_info.env.input_string;
      trait_ty2 = match(trait_info.value,.Some(v) => match(v,.TypeVal(b) => b, _ => TypeValue.Unit),.None => TypeValue.Unit);
      if(!(is_trait_type(trait_ty2)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(unwrapped_te),
              `Expected trait type for right-hand side of where clause constraint, got: ${type_to_string(trait_ty2)}`,
              false,
              .None
            )
          )
        );
      });
      if(_trait_has_receiver(trait_ty2), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(unwrapped_te),
              String.from("Trait type in where clause already has a receiver type assigned."),
              false,
              .None
            )
          )
        );
      });
      // Record the constraint: TypeApplication LHS → the dedicated
      // type-application table; otherwise directly on the SomeT's ArrayList.
      match(
        type_app_lhs,
        .Some(ta_lhs) => {
          add_where_clause_constraint_for_type_application(env_mut, ta_lhs, trait_ty2, is_neg);
        },
        .None => {
          _add_where_clause_constraint(some_ty, trait_ty2, is_neg);
        }
      );
    });
  });
  pending_traits
});
// ---------------------------------------------------------------------------
// apply_where_clause_constraints (exported)
// ---------------------------------------------------------------------------
/// Apply where-clause constraints in the current environment frame.
/// Used when evaluating a function body to re-attach constraints.
///
/// Mirrors `applyWhereClauseConstraints` from function.ts lines 1440-1461.
apply_where_clause_constraints :: (
  fn(
    constraint_exprs : ArrayList(AstExpr),
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)(
  if(constraint_exprs.len() == usize(0), (), {
    _pending := parse_where_clause_constraints(constraint_exprs, env_mut, ctx, false, exn);
    ()
  })
);
// ---------------------------------------------------------------------------
// prepare_where_clause_variables
// ---------------------------------------------------------------------------
/// First pass of where clause processing: scan LHS variables, create SomeTypes,
/// and try to evaluate constraints. Returns pending constraints.
///
/// Mirrors `prepareWhereClauseVariables` from function.ts lines 751-831.
prepare_where_clause_variables :: (
  fn(
    constraint_exprs : ArrayList(AstExpr),
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> ArrayList(PendingConstraint)
)({
  pending := ArrayList(PendingConstraint).new();
  (ci : usize) = usize(0);
  while(ci < constraint_exprs.len(), {
    constraint_expr := match(
      constraint_exprs.get(ci),
      .Some(e) => e,
      .None => {
        ci = constraint_exprs.len();
        break;
      }
    );
    ci = (ci + usize(1));
    if(!(ast_expr_is_fn_call_of(constraint_expr, "<:",.Some(usize(2)))), {
      continue;
    });
    c_args := _fn_call_args(constraint_expr);
    lhs_expr := match(c_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    // Ensure LHS variable exists — create SomeType if needed
    if(ast_expr_is_atom(lhs_expr), {
      var_name := ast_expr_token(lhs_expr).value;
      existing_vars := get_variables_from_env(env_mut, var_name);
      if(existing_vars.len() == usize(0), {
        // Create new SomeType for this variable
        top_frame := env_mut.frames.len();
        if(top_frame == usize(0), {
          continue;
        });
        new_some_ty := t_some_t(var_name, top_frame - usize(1));
        tv := create_type_value(new_some_ty);
        add_variable_to_env(
          env_mut,
          var_name,
          type_of_type(new_some_ty),
          .Some(tv),
          true,
          // is_compile_time_only
          false,
          // is_reassignable
          false,
          // is_owning_the_rc_value
          false,
          // is_implicit
          ast_expr_token(lhs_expr)
        );
        // Set expr info on lhs
        lhs_info := new_expr_info(env_mut, type_of_type(new_some_ty));
        lhs_info.value =.Some(tv);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(lhs_expr), lhs_info);
      });
    });
    // Try to evaluate the constraint, collecting pending failures
    one_expr := ArrayList(AstExpr).new();
    one_expr.push(constraint_expr);
    new_pending := parse_where_clause_constraints(one_expr, env_mut, ctx, true, exn);
    (pi : usize) = usize(0);
    while(pi < new_pending.len(), {
      pc := match(
        new_pending.get(pi),
        .Some(p) => p,
        .None => {
          pi = new_pending.len();
          break;
        }
      );
      pending.push(pc);
      pi = (pi + usize(1));
    });
  });
  pending
});
// ---------------------------------------------------------------------------
// retry_pending_constraints
// ---------------------------------------------------------------------------
/// Retry pending trait constraints. Returns still-pending constraints.
///
/// Mirrors `retryPendingConstraints` from function.ts lines 837-866.
retry_pending_constraints :: (
  fn(
    pending : ArrayList(PendingConstraint),
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> ArrayList(PendingConstraint)
)({
  still_pending := ArrayList(PendingConstraint).new();
  (i : usize) = usize(0);
  while(i < pending.len(), {
    pc := match(
      pending.get(i),
      .Some(p) => p,
      .None => {
        i = pending.len();
        break;
      }
    );
    i = (i + usize(1));
    success := apply_single_trait_constraint(
      pc.lhs_expr,
      pc.trait_expr,
      pc.original_constraint_expr,
      env_mut,
      ctx,
      exn
    );
    if(!(success), {
      still_pending.push(pc);
    });
  });
  still_pending
});
// ---------------------------------------------------------------------------
// evaluate_function_parameters
// ---------------------------------------------------------------------------
/// Evaluate all function parameters.
/// NOTE: This function pushes an env frame but does NOT pop it.
///       The caller (evaluate_function_type) must pop the frame after evaluating
///       the return type.
///
/// Mirrors `evaluateFunctionParameters` from function.ts lines 1570-2358.
evaluate_function_parameters :: (
  fn(
    param_exprs : ArrayList(AstExpr),
    env_mut : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> FuncParamsResult
)({
  env_mut.push_frame(false);
  params := ArrayList(FuncParam).new();
  forall_params := ArrayList(FuncParam).new();
  implicit_params := ArrayList(FuncParam).new();
  where_clause_exprs := ArrayList(AstExpr).new();
  (has_variadic : bool) = false;
  (variadic_param : FuncParam) = FuncParam(
    String.from("..."),
    TypeValue.Unit,
    false,
    false,
    false,
    false,
    false,
    Option(EvalValue).None,
    false,
    Option(AstExpr).None,
    Option(AstExpr).None
  );
  (find_variadic : bool) = false;
  // --------------------------------------------------------------------------
  // Pass 1 — process generic type parameters (first parameter only)
  // --------------------------------------------------------------------------
  if(param_exprs.len() > usize(0), {
    first_param := match(param_exprs.get(usize(0)),.Some(e) => e,.None => make_err_expr());
    if(ast_expr_is_fn_call_of(first_param, BK_GENERIC, Option(usize).None), {
      forall_args := _fn_call_args(first_param);
      (j : usize) = usize(0);
      while(j < forall_args.len(), {
        tp_expr := match(forall_args.get(j),.Some(a) => a,.None => make_err_expr());
        j = (j + usize(1));
        // Detect E : Type.Struct — effect row variable declaration
        (is_eff_row_forall : bool) = false;
        if(ast_expr_is_fn_call_of(tp_expr, "...",.Some(usize(1))) &&
          ast_expr_is_atom(match(_fn_call_args(tp_expr).get(usize(0)),.Some(a) => a,.None => make_err_expr())), {
          inner_arg := match(_fn_call_args(tp_expr).get(usize(0)),.Some(a) => a,.None => make_err_expr());
          row_var_name := ast_expr_token(inner_arg).value.clone();
          // Duplicate check
          (erd_found : bool) = false;
          (erdi : usize) = usize(0);
          while(erdi < forall_params.len(), {
            erfp := match(
              forall_params.get(erdi),
              .Some(p) => p,
              .None => {
                erdi = forall_params.len();
                break;
              }
            );
            if(erfp.label == row_var_name, {
              erd_found = true;
              erdi = forall_params.len();
            });
            erdi = (erdi + usize(1));
          });
          if(erd_found, {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(tp_expr),
                  `Duplicate label "${row_var_name}" in type parameter`,
                  false,
                  .None
                )
              )
            );
          });
          // Create effects-row SomeT (is_effects_row = true)
          er_frame_level := cond(
            (env_mut.frames.len() > usize(0)) => (env_mut.frames.len() - usize(1)),
            true => usize(0)
          );
          eff_row_some_type := TypeValue.SomeT(
            generate_some_type_id(),
            row_var_name.clone(),
            er_frame_level,
            TypeValue.TypeUni(usize(1)),
            ArrayList(TypeValue).new(),
            ArrayList(usize).new(),
            ArrayList(TypeValue).new(),
            ArrayList(usize).new(),
            true,
            Option(TypeValue).None,
            ArrayList(TypeValue).new()
          );
          row_kind_type := TypeValue.TypeUni(usize(1));
          add_variable_to_env(
            env_mut,
            row_var_name.clone(),
            row_kind_type.clone(),
            Option(EvalValue).Some(EvalValue.TypeVal(eff_row_some_type.clone())),
            true,
            false,
            false,
            false,
            ast_expr_token(inner_arg)
          );
          forall_params.push(
            FuncParam(
              row_var_name.clone(),
              row_kind_type.clone(),
              true,
              false,
              false,
              false,
              false,
              Option(EvalValue).None,
              false,
              Option(AstExpr).None,
              Option(AstExpr).None
            )
          );
          is_eff_row_forall = true;
        });
        if(is_eff_row_forall, {
          continue;
        });
        param := evaluate_function_parameter(tp_expr, env_mut, ctx, true, true, exn);
        // Duplicate check
        dup_found := false;
        (di : usize) = usize(0);
        while(di < forall_params.len(), {
          fp := match(
            forall_params.get(di),
            .Some(p) => p,
            .None => {
              di = forall_params.len();
              break;
            }
          );
          if(fp.label == param.label, {
            dup_found = true;
            di = forall_params.len();
          });
          di = (di + usize(1));
        });
        if(dup_found, {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(tp_expr),
                `Duplicate label "${param.label}" in type parameter`,
                false,
                .None
              )
            )
          );
        });
        forall_params.push(param);
      });
    });
  });
  // --------------------------------------------------------------------------
  // Pass 2 — process  implicit parameters
  // --------------------------------------------------------------------------
  (using_count : usize) = usize(0);
  (ui : usize) = usize(0);
  while(ui < param_exprs.len(), {
    param_expr := match(param_exprs.get(ui),.Some(e) => e,.None => make_err_expr());
    ui = (ui + usize(1));
    if(!(ast_expr_is_fn_call_of(param_expr, "using", Option(usize).None)), {
      continue;
    });
    using_count = (using_count + usize(1));
    if(using_count > usize(1), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(param_expr),
            `Only one "..." clause is allowed per function signature. Combine all implicit parameters into a single , e.g.: a : TypeA, b : TypeB`,
            false,
            .None
          )
        )
      );
    });
    using_args := _fn_call_args(param_expr);
    (uj : usize) = usize(0);
    while(uj < using_args.len(), {
      impl_expr := match(using_args.get(uj),.Some(a) => a,.None => make_err_expr());
      uj = (uj + usize(1));
      // Detect E : Type.Struct — effect row spread in
      (is_eff_row_using : bool) = false;
      if(ast_expr_is_fn_call_of(impl_expr, "...",.Some(usize(1))) &&
        ast_expr_is_atom(match(_fn_call_args(impl_expr).get(usize(0)),.Some(a) => a,.None => make_err_expr())), {
        inner_arg2 := match(_fn_call_args(impl_expr).get(usize(0)),.Some(a) => a,.None => make_err_expr());
        row_var_name2 := ast_expr_token(inner_arg2).value.clone();
        // Look up E (must have been declared in generic)
        row_vars := get_variables_from_env(env_mut, row_var_name2.clone());
        if(row_vars.len() == usize(0), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(impl_expr),
                `Effect row variable "${row_var_name2}" not found in scope. Declare it with generic(..., ...(${row_var_name2}))`,
                false,
                .None
              )
            )
          );
        });
        row_var_opt := row_vars.get(row_vars.len() - usize(1));
        match(
          row_var_opt,
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(impl_expr),
                  String.from("Effect row variable not found"),
                  false,
                  .None
                )
              )
            );
          },
          .Some(row_var) => {
            e_val := row_var.value.get(usize(0));
            (eff_row_handled : bool) = false;
            match(
              e_val,
              .Some(ev) => {
                if(is_type_val(ev) && !(eff_row_handled), {
                  inner_ty := match(ev,.TypeVal(b) => b, _ => TypeValue.Unit);
                  if(is_effects_row_type(inner_ty.clone()), {
                    // Expand concrete EffectsRowT into individual params
                    match(
                      inner_ty.clone(),
                      .EffectsRowT(row_ls, row_ts) => {
                        (ki : usize) = usize(0);
                        while(ki < row_ls.len(), {
                          lbl := match(row_ls.get(ki),.Some(l) => l,.None => String.from(""));
                          ty := match(row_ts.get(ki),.Some(t) => t,.None => TypeValue.Unit);
                          implicit_params.push(
                            FuncParam(
                              lbl.clone(),
                              ty.clone(),
                              true,
                              false,
                              false,
                              true,
                              false,
                              Option(EvalValue).None,
                              false,
                              Option(AstExpr).None,
                              Option(AstExpr).None
                            )
                          );
                          ki = (ki + usize(1));
                        });
                      },
                      _ => ()
                    );
                    eff_row_handled = true;
                  }, {
                    // TypeVal but not EffectsRowT — must be a SomeT with is_effects_row
                    is_er_some := match(
                      inner_ty.clone(),
                      .SomeT(_, _, _, _, _, _, _, _, is_er, _, _) => is_er,
                      _ => false
                    );
                    if(!(is_er_some), {
                      exn.throw(
                        dyn(
                          format_error_message(
                            ast_expr_token(impl_expr),
                            `"...(${row_var_name2})" requires "${row_var_name2}" to be a generic-declared effect row variable, but it resolves to a concrete type.`,
                            false,
                            .None
                          )
                        )
                      );
                    });
                    // Push spread marker
                    implicit_params.push(
                      FuncParam(
                        row_var_name2.clone(),
                        inner_ty.clone(),
                        true,
                        false,
                        false,
                        true,
                        true,
                        Option(EvalValue).None,
                        false,
                        Option(AstExpr).None,
                        Option(AstExpr).None
                      )
                    );
                    eff_row_handled = true;
                  });
                });
                if(is_unknown_val(ev) && !(eff_row_handled), {
                  inner_ty2 := match(ev,.UnknownVal(b, _) => b, _ => TypeValue.Unit);
                  if(is_effects_row_type(inner_ty2.clone()), {
                    // Expand EffectsRowT
                    match(
                      inner_ty2.clone(),
                      .EffectsRowT(row_ls2, row_ts2) => {
                        (ki2 : usize) = usize(0);
                        while(ki2 < row_ls2.len(), {
                          lbl2 := match(row_ls2.get(ki2),.Some(l) => l,.None => String.from(""));
                          ty2 := match(row_ts2.get(ki2),.Some(t) => t,.None => TypeValue.Unit);
                          implicit_params.push(
                            FuncParam(
                              lbl2.clone(),
                              ty2.clone(),
                              true,
                              false,
                              false,
                              true,
                              false,
                              Option(EvalValue).None,
                              false,
                              Option(AstExpr).None,
                              Option(AstExpr).None
                            )
                          );
                          ki2 = (ki2 + usize(1));
                        });
                      },
                      _ => ()
                    );
                    eff_row_handled = true;
                  }, {
                    // UnknownVal with non-EffectsRowT — create fresh SomeT spread marker
                    er_fl := cond(
                      (env_mut.frames.len() > usize(0)) => (env_mut.frames.len() - usize(1)),
                      true => usize(0)
                    );
                    fresh_some_t := TypeValue.SomeT(
                      generate_some_type_id(),
                      row_var_name2.clone(),
                      er_fl,
                      TypeValue.TypeUni(usize(1)),
                      ArrayList(TypeValue).new(),
                      ArrayList(usize).new(),
                      ArrayList(TypeValue).new(),
                      ArrayList(usize).new(),
                      true,
                      Option(TypeValue).None,
                      ArrayList(TypeValue).new()
                    );
                    implicit_params.push(
                      FuncParam(
                        row_var_name2.clone(),
                        fresh_some_t.clone(),
                        true,
                        false,
                        false,
                        true,
                        true,
                        Option(EvalValue).None,
                        false,
                        Option(AstExpr).None,
                        Option(AstExpr).None
                      )
                    );
                    eff_row_handled = true;
                  });
                });
                if(!(eff_row_handled), {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(impl_expr),
                        `Effect row variable "${row_var_name2}" has invalid value. Expected a type.`,
                        false,
                        .None
                      )
                    )
                  );
                });
              },
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(impl_expr),
                      `Effect row variable "${row_var_name2}" has no value.`,
                      false,
                      .None
                    )
                  )
                );
              }
            );
          }
        );
        is_eff_row_using = true;
      });
      if(is_eff_row_using, {
        continue;
      });
      // Bare types without labels are not allowed
      has_explicit_label := (
        ast_expr_is_fn_call_of(impl_expr, ":", Option(usize).None) ||
          ast_expr_is_fn_call_of(impl_expr, "=", Option(usize).None) ||
            ast_expr_is_fn_call_of(impl_expr, "?=", Option(usize).None) ||
              ast_expr_is_fn_call_of(impl_expr, ":=", Option(usize).None)
      );
      if(!(has_explicit_label), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(impl_expr),
              `Implicit parameter requires a label. Use "name : Type" instead of "Type".`,
              false,
              .None
            )
          )
        );
      });
      param := evaluate_function_parameter(impl_expr, env_mut, ctx, true, true, exn);
      // Duplicate checks
      (dup_forall : bool) = false;
      (dfi : usize) = usize(0);
      while(dfi < forall_params.len(), {
        fp := match(
          forall_params.get(dfi),
          .Some(p) => p,
          .None => {
            dfi = forall_params.len();
            break;
          }
        );
        if(fp.label == param.label, {
          dup_forall = true;
          dfi = forall_params.len();
        });
        dfi = (dfi + usize(1));
      });
      if(dup_forall, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(impl_expr),
              `Duplicate label "${param.label}" in implicit parameter (already in generic)`,
              false,
              .None
            )
          )
        );
      });
      (dup_impl : bool) = false;
      (dii : usize) = usize(0);
      while(dii < implicit_params.len(), {
        ip := match(
          implicit_params.get(dii),
          .Some(p) => p,
          .None => {
            dii = implicit_params.len();
            break;
          }
        );
        if(ip.label == param.label, {
          dup_impl = true;
          dii = implicit_params.len();
        });
        dii = (dii + usize(1));
      });
      if(dup_impl, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(impl_expr),
              `Duplicate label "${param.label}" in implicit parameter`,
              false,
              .None
            )
          )
        );
      });
      impl_param := FuncParam(
        param.label,
        param.ty,
        true,
        param.is_quote,
        param.is_owning_rc_value,
        true,
        false,
        Option(EvalValue).None,
        false,
        Option(AstExpr).None,
        Option(AstExpr).None
      );
      implicit_params.push(impl_param);
      // Mark variable as implicit in env top frame
      top_frame_idx := (env_mut.frames.len() - usize(1));
      match(
        env_mut.frames.get(top_frame_idx),
        .Some(frame) => {
          (fvi : usize) = usize(0);
          while(fvi < frame.variables.len(), {
            fv := match(
              frame.variables.get(fvi),
              .Some(v) => v,
              .None => {
                fvi = frame.variables.len();
                break;
              }
            );
            if(fv.name == param.label, {
              fv.is_implicit = true;
              fvi = frame.variables.len();
            });
            fvi = (fvi + usize(1));
          });
        },
        .None => ()
      );
    });
  });
  // --------------------------------------------------------------------------
  // Pass 2b — Phase 0 of plans/FORMAL_VERIFICATION.md: enforce the canonical
  // signature clause order, then extract the contract clauses.
  // Mirrors src/evaluator/types/function.ts:1700-1783.
  // --------------------------------------------------------------------------
  (max_zone : usize) = usize(0);
  (max_name : String) = String.from("generic(...)");
  (zi : usize) = usize(0);
  while(zi < param_exprs.len(), {
    z_expr := match(param_exprs.get(zi),.Some(e) => e,.None => make_err_expr());
    zi = (zi + usize(1));
    z_zone := _clause_zone(z_expr);
    z_name := _clause_name(z_expr);
    if(z_zone < max_zone, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(z_expr),
            `${z_name} appears after ${max_name} in the function signature. The canonical clause order is: generic(...), parameters, where(...), requires(...), ensures(...). Move ${z_name} before ${_zone_label(max_zone)}.`,
            false,
            .None
          )
        )
      );
    });
    if(z_zone > max_zone, {
      max_zone = z_zone;
      max_name = z_name;
    });
  });
  // Each contract builtin may appear at most once in a signature (single-call
  // rule: `requires(P1, P2, ...)`). Zero-argument forms are rejected.
  (requires_exprs : ArrayList(AstExpr)) = ArrayList(AstExpr).new();
  (ensures_exprs : ArrayList(AstExpr)) = ArrayList(AstExpr).new();
  (seen_requires : bool) = false;
  (seen_ensures : bool) = false;
  (ci : usize) = usize(0);
  while(ci < param_exprs.len(), {
    c_expr := match(param_exprs.get(ci),.Some(e) => e,.None => make_err_expr());
    ci = (ci + usize(1));
    if(ast_expr_is_fn_call_of(c_expr, BF_REQUIRES, Option(usize).None), {
      c_args := _fn_call_args(c_expr);
      if(c_args.len() == usize(0), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(c_expr),
              String.from("'requires(...)' with zero arguments is a syntax error. Omit the clause entirely if there is no precondition."),
              false,
              .None
            )
          )
        );
      });
      if(seen_requires, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(c_expr),
              String.from("Multiple 'requires(...)' clauses in the same signature are a syntax error. Combine the predicates into one call: 'requires(P1, P2, ...)'."),
              false,
              .None
            )
          )
        );
      });
      seen_requires = true;
      (cri : usize) = usize(0);
      while(cri < c_args.len(), {
        match(
          c_args.get(cri),
          .Some(p) => {
            requires_exprs.push(p);
          },
          .None => ()
        );
        cri = (cri + usize(1));
      });
      continue;
    });
    if(ast_expr_is_fn_call_of(c_expr, BF_ENSURES, Option(usize).None), {
      e_args := _fn_call_args(c_expr);
      if(e_args.len() == usize(0), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(c_expr),
              String.from("'ensures(...)' with zero arguments is a syntax error. Omit the clause entirely if there is no postcondition."),
              false,
              .None
            )
          )
        );
      });
      if(seen_ensures, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(c_expr),
              String.from("Multiple 'ensures(...)' clauses in the same signature are a syntax error. Combine the predicates into one call: 'ensures(Q1, Q2, ...)'."),
              false,
              .None
            )
          )
        );
      });
      seen_ensures = true;
      (cei : usize) = usize(0);
      while(cei < e_args.len(), {
        match(
          e_args.get(cei),
          .Some(p) => {
            ensures_exprs.push(p);
          },
          .None => ()
        );
        cei = (cei + usize(1));
      });
      continue;
    });
  });
  // --------------------------------------------------------------------------
  // Pass 3 — pre-add all comptime parameters to env (so where clauses can ref them)
  // --------------------------------------------------------------------------
  (pre_added_indices : ArrayList(usize)) = ArrayList(usize).new();
  (pi3 : usize) = usize(0);
  while(pi3 < param_exprs.len(), {
    param_expr := match(param_exprs.get(pi3),.Some(e) => e,.None => make_err_expr());
    (current_idx : usize) = pi3;
    pi3 = (pi3 + usize(1));
    // Skip generic, using, where, ..., and Phase-0 contract clauses
    // (requires/ensures). The contract clauses are recognized here so they
    // don't get treated as runtime parameters; their bodies are lowered later
    // by `wrap_function_body_with_contracts`.
    if(ast_expr_is_fn_call_of(param_expr, BK_GENERIC, Option(usize).None) ||
      ast_expr_is_fn_call_of(param_expr, "using", Option(usize).None) ||
        ast_expr_is_fn_call_of(param_expr, BK_WHERE, Option(usize).None) ||
          ast_expr_is_fn_call_of(param_expr, "...", Option(usize).None) ||
            _is_contract_clause(param_expr), {
      continue;
    });
    ct_info := extract_comptime_parameter_info(param_expr);
    match(
      ct_info,
      .Some(info) => {
        // Try to evaluate the type expression; returns None on error (soft failure).
        (param_type_opt : Option(TypeValue)) = _try_eval_comptime_type(info.type_expr, env_mut, ctx, exn);
        if(param_type_opt.is_none(), {
          continue; // Skip — will be handled in main pass
        });
        param_type := match(param_type_opt,.Some(t) => t,.None => continue);
        // For `comptime(T) : Type` — create TypeVal(SomeT) so where
        // clauses and identifier lookups treat T as a SomeType (mirrors
        // TS createUnknownValue for level-0 type-hierarchy types).
        ct_frame_level := if(
          env_mut.frames.len() > usize(0),
          env_mut.frames.len() - usize(1),
          usize(0)
        );
        val := if(
          is_type_0(param_type),
          create_type_value(t_some_t(info.name, ct_frame_level)),
          create_unknown_val(param_type)
        );
        add_variable_to_env(
          env_mut,
          info.name,
          param_type,
          .Some(val),
          true,
          // is_compile_time_only
          false,
          // is_reassignable
          false,
          // is_owning_the_rc_value
          false,
          // is_implicit
          info.token
        );
        pre_added_indices.push(current_idx);
      },
      .None => ()
    );
  });
  // --------------------------------------------------------------------------
  // Pass 4 — scan where clause and try constraints (with pending retry)
  // --------------------------------------------------------------------------
  (pending_constraints : ArrayList(PendingConstraint)) = ArrayList(PendingConstraint).new();
  if(param_exprs.len() > usize(0), {
    // `where` must come at the end of the signature, but Phase-0 contract
    // clauses (requires/ensures) may follow it. Scan from the end past any
    // trailing contract clauses to find the where clause.
    // Mirrors src/evaluator/types/function.ts:1863-1878.
    (where_idx : usize) = (param_exprs.len() - usize(1));
    (where_scanning : bool) = true;
    while(where_scanning, {
      cand := match(param_exprs.get(where_idx),.Some(e) => e,.None => make_err_expr());
      cond(
        !(_is_contract_clause(cand)) => {
          where_scanning = false;
        },
        (where_idx == usize(0)) => {
          where_scanning = false;
        },
        true => {
          where_idx = (where_idx - usize(1));
        }
      );
    });
    last_param := match(param_exprs.get(where_idx),.Some(e) => e,.None => make_err_expr());
    if(ast_expr_is_fn_call_of(last_param, BK_WHERE, Option(usize).None), {
      where_args := _fn_call_args(last_param);
      // Copy where_args to where_clause_exprs
      (wai : usize) = usize(0);
      while(wai < where_args.len(), {
        we := match(where_args.get(wai),.Some(a) => a,.None => make_err_expr());
        where_clause_exprs.push(we);
        wai = (wai + usize(1));
      });
      if(where_clause_exprs.len() == usize(0), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(last_param),
              String.from("The where clause must have at least one constraint."),
              false,
              .None
            )
          )
        );
      });
      // First pass of where clause: create SomeTypes and try constraints
      pending_constraints = prepare_where_clause_variables(where_clause_exprs, env_mut, ctx, exn);
    });
  });
  // --------------------------------------------------------------------------
  // Pass 5 — process regular parameters
  // --------------------------------------------------------------------------
  (pi5 : usize) = usize(0);
  while(pi5 < param_exprs.len(), {
    param_expr := match(param_exprs.get(pi5),.Some(e) => e,.None => make_err_expr());
    (current_i : usize) = pi5;
    pi5 = (pi5 + usize(1));
    // Skip generic (already processed in pass 1)
    if(ast_expr_is_fn_call_of(param_expr, BK_GENERIC, Option(usize).None), {
      if(!(current_i == usize(0)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(param_expr),
              `Expected type parameters to be the first argument, got ${(current_i + usize(1))}`,
              false,
              .None
            )
          )
        );
      });
      continue;
    });
    // Skip using (already processed in pass 2)
    if(ast_expr_is_fn_call_of(param_expr, "using", Option(usize).None), {
      continue;
    });
    // Skip where clause (already processed in pass 4). Clause ordering —
    // including "where may only be followed by requires/ensures" — is
    // validated up front by the zone check in pass 2b, so no positional check
    // is needed here. Mirrors src/evaluator/types/function.ts:1924-1933.
    if(ast_expr_is_fn_call_of(param_expr, BK_WHERE, Option(usize).None), {
      continue;
    });
    // Skip Phase-0 contract clauses (requires/ensures). They were extracted in
    // pass 2b; their predicates are lowered into the body by
    // `wrap_function_body_with_contracts`.
    // Mirrors src/evaluator/types/function.ts:1934-1943.
    if(_is_contract_clause(param_expr), {
      continue;
    });
    // Variadic parameter: ... or ...(name)
    is_variadic := (
      _is_dots_atom(param_expr) ||
        ast_expr_is_fn_call_of(param_expr, "...", Option(usize).None)
    );
    if(is_variadic, {
      find_variadic = true;
      has_variadic = true;
      (is_vcomptime : bool) = false;
      (is_vquote : bool) = false;
      (vparam_name : String) = String.from("...");
      (vlabel_expr : AstExpr) = param_expr;
      (vparam_type : TypeValue) = TypeValue.Unit;
      if(ast_expr_is_fn_call(param_expr), {
        varg := match(_fn_call_args(param_expr).get(usize(0)),.Some(a) => a,.None => make_err_expr());
        // ...((lhsExpr : typeExpr)) — type-annotated variadic.
        //
        // The outer is a *colon pair* `lhs : type`, parsed as
        // `:(lhs, type)`. In TS this matches via the
        // `BuiltinKeywords.quote = ["quote", ":"]` keyword alias, but
        // the semantic shape is the colon pair, not the quote macro
        // (quote is only the unary form). In yo-self where `BK_QUOTE`
        // and `BK_COLON` are separate constants, the correct spelling
        // is `BK_COLON.Some(2)`.
        if(ast_expr_is_fn_call_of(varg, BK_COLON,.Some(usize(2))), {
          vlhs_arg := match(_fn_call_args(varg).get(usize(0)),.Some(a) => a,.None => make_err_expr());
          vtype_arg := match(_fn_call_args(varg).get(usize(1)),.Some(a) => a,.None => make_err_expr());
          if(ast_expr_is_fn_call_of(vlhs_arg, BK_COMPTIME, Option(usize).None), {
            is_vcomptime = true;
            vlabel_expr = match(_fn_call_args(vlhs_arg).get(usize(0)),.Some(a) => a,.None => make_err_expr());
            vparam_name = ast_expr_token(vlabel_expr).value;
          }, {
            // Inner LHS may be `quote(name)` (literal "quote") or
            // `:(name)` (unary `:`) — both are the unary quote macro,
            // semantically interchangeable.
            vlhs_is_quote := (
              ast_expr_is_fn_call_of(vlhs_arg, BK_QUOTE, Option(usize).None) ||
                ast_expr_is_fn_call_of(vlhs_arg, BK_COLON,.Some(usize(1)))
            );
            if(vlhs_is_quote, {
              is_vcomptime = true;
              is_vquote = true;
              vlabel_expr = match(_fn_call_args(vlhs_arg).get(usize(0)),.Some(a) => a,.None => make_err_expr());
              vparam_name = ast_expr_token(vlabel_expr).value;
            }, {
              if(ast_expr_is_atom(vlhs_arg) && is_valid_variable_name(vlhs_arg), {
                vlabel_expr = vlhs_arg;
                vparam_name = ast_expr_token(vlhs_arg).value;
              }, {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(vlhs_arg),
                      `Expected a valid variable name for variadic parameter, got ${ast_expr_to_string(vlhs_arg)}`,
                      false,
                      .None
                    )
                  )
                );
              });
            });
          });
          // Evaluate type expression
          vtype_opt := _eval_and_update_env(vtype_arg, env_mut, ctx, exn);
          vparam_type = match(
            vtype_opt,
            .Some(t) => t,
            .None => {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(vtype_arg),
                    `Expected type for variadic parameter, got ${ast_expr_to_string(vtype_arg)}`,
                    false,
                    .None
                  )
                )
              );
              TypeValue.Unit
            }
          );
        }, {
          // ...(comptime(name)) without type annotation
          if(ast_expr_is_fn_call_of(varg, BK_COMPTIME, Option(usize).None), {
            is_vcomptime = true;
            vlabel_expr = match(_fn_call_args(varg).get(usize(0)),.Some(a) => a,.None => make_err_expr());
            vparam_name = ast_expr_token(vlabel_expr).value;
            vparam_type = TypeValue.ComptimeListT(t_type());
          }, {
            // ...(quote(name)) or ...(:(name)) — the unary quote
            // macro. `:` (unary) aliases `quote` semantically.
            varg_is_quote := (
              ast_expr_is_fn_call_of(varg, BK_QUOTE, Option(usize).None) ||
                ast_expr_is_fn_call_of(varg, BK_COLON,.Some(usize(1)))
            );
            if(varg_is_quote, {
              is_vcomptime = true;
              is_vquote = true;
              vlabel_expr = match(_fn_call_args(varg).get(usize(0)),.Some(a) => a,.None => make_err_expr());
              vparam_name = ast_expr_token(vlabel_expr).value;
              vparam_type = t_comptime_list(t_expr_t());
            }, {
              if(ast_expr_is_atom(varg) && is_valid_variable_name(varg), {
                vlabel_expr = varg;
                vparam_name = ast_expr_token(varg).value;
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(varg),
                      String.from("...(param_name) is not supported yet."),
                      false,
                      .None
                    )
                  )
                );
              }, {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(varg),
                      `Expected a valid variable name for variadic parameter, got ${ast_expr_to_string(varg)}`,
                      false,
                      .None
                    )
                  )
                );
              });
            });
          });
        });
      });
      variadic_param = FuncParam(
        vparam_name,
        vparam_type,
        is_vcomptime,
        is_vquote,
        false,
        false,
        false,
        Option(EvalValue).None,
        false,
        Option(AstExpr).None,
        Option(AstExpr).None
      );
      // Add to env if named
      if(!(vparam_name == "..."), {
        v_frame_level := if(
          env_mut.frames.len() > usize(0),
          env_mut.frames.len() - usize(1),
          usize(0)
        );
        vval := if(
          is_vcomptime,
          if(
            is_type_0(vparam_type),
            Option(EvalValue).Some(create_type_value(t_some_t(vparam_name, v_frame_level))),
            Option(EvalValue).Some(create_unknown_val(vparam_type))
          ),
          Option(EvalValue).None
        );
        add_variable_to_env(
          env_mut,
          vparam_name,
          vparam_type,
          vval,
          is_vcomptime,
          false,
          // is_reassignable
          false,
          // is_owning_the_rc_value
          false,
          // is_implicit
          ast_expr_token(vlabel_expr)
        );
      });
    }, {
      // Normal function parameter
      if(find_variadic, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(param_expr),
              String.from("Expected variadic parameter to be the last parameter before the normal parameters."),
              false,
              .None
            )
          )
        );
      });
      param := evaluate_function_parameter(param_expr, env_mut, ctx, false, true, exn);
      // Duplicate check
      (dup_p : bool) = false;
      (dpi : usize) = usize(0);
      while(dpi < params.len(), {
        pp := match(
          params.get(dpi),
          .Some(p) => p,
          .None => {
            dpi = params.len();
            break;
          }
        );
        if(pp.label == param.label, {
          dup_p = true;
          dpi = params.len();
        });
        dpi = (dpi + usize(1));
      });
      _dup_err_tok := if(
        ast_expr_is_fn_call(param_expr),
        match(_fn_call_args(param_expr).get(usize(0)),.Some(a) => ast_expr_token(a),.None => ast_expr_token(param_expr)),
        ast_expr_token(param_expr)
      );
      if(dup_p, {
        exn.throw(
          dyn(
            format_error_message(
              _dup_err_tok,
              `Duplicate label "${param.label}" in function parameter`,
              false,
              .None
            )
          )
        );
      });
      params.push(param);
      // Retry pending constraints now that we have a new variable
      if(pending_constraints.len() > usize(0), {
        pending_constraints = retry_pending_constraints(pending_constraints, env_mut, ctx, exn);
      });
    });
  });
  // Validate ExprList must be last parameter
  (eli : usize) = usize(0);
  while(eli < params.len(), {
    p := match(
      params.get(eli),
      .Some(x) => x,
      .None => {
        eli = params.len();
        break;
      }
    );
    _eli_tok := ast_expr_token(match(param_exprs.get(eli),.Some(e) => e,.None => make_err_expr()));
    if(p.is_quote && is_expr_list_type(p.ty), {
      if(!(eli == (params.len() - usize(1))), {
        exn.throw(
          dyn(
            format_error_message(
              _eli_tok,
              String.from("Expected ExprList type to be the last parameter."),
              false,
              .None
            )
          )
        );
      });
    });
    eli = (eli + usize(1));
  });
  // Final retry of pending constraints
  if(pending_constraints.len() > usize(0), {
    pending_constraints = retry_pending_constraints(pending_constraints, env_mut, ctx, exn);
    if(pending_constraints.len() > usize(0), {
      failed := match(
        pending_constraints.get(usize(0)),
        .Some(p) => p,
        .None => return(
          FuncParamsResult(
            params,
            forall_params,
            implicit_params,
            where_clause_exprs,
            has_variadic,
            variadic_param,
            requires_exprs,
            ensures_exprs
          )
        )
      );
      // Re-evaluate the failed constraint to get the error message
      one_failed := ArrayList(AstExpr).new();
      one_failed.push(failed.original_constraint_expr);
      _retry_errors := parse_where_clause_constraints(one_failed, env_mut, ctx, false, exn);
    });
  });
  FuncParamsResult(params, forall_params, implicit_params, where_clause_exprs, has_variadic, variadic_param, requires_exprs, ensures_exprs)
});
// Helper to get a param expr for error reporting
param_exprs_for_error :: (fn(arg_list : ArrayList(AstExpr), idx : usize) -> Option(AstExpr))(
  arg_list.get(idx)
);
// ---------------------------------------------------------------------------
// evaluate_function_type
// ---------------------------------------------------------------------------
/// Evaluate a `fn(...) -> ReturnType` expression.
///
/// Mirrors `evaluateFunctionType` from function.ts lines 2366-2694.
evaluate_function_type :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  if(!(ast_expr_is_fn_call_of(expr, "->",.Some(usize(2)))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected -> for function type, got:\n${ast_expr_to_string(expr)}\n\nNote: For closures, use Impl(Fn(...) -> ...) syntax.`,
          false,
          .None
        )
      )
    );
  });
  expr_args := _fn_call_args(expr);
  arg_list_expr := match(expr_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
  return_expr := match(expr_args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
  // Expect fn(...), unsafe_fn(...), or ctl(...). `ctl` is the
  // control-function type constructor — parallel to `fn`, but its body
  // may contain `unwind` and the value is frame-bound.
  if(!(
    ast_expr_is_fn_call_of(arg_list_expr, BK_FN, Option(usize).None) ||
      (
        ast_expr_is_fn_call_of(arg_list_expr, BK_UNSAFE_FN, Option(usize).None) ||
          ast_expr_is_fn_call_of(arg_list_expr, BK_CTL, Option(usize).None)
      )
  ), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_list_expr),
          `Expected a "fn", "ctl", or "unsafe_fn" call for parameter list, got:\n${ast_expr_to_string(arg_list_expr)}`,
          false,
          .None
        )
      )
    );
  });
  // Whether the parameter-list head is `ctl(...)` — this is a control-function
  // type. Captured here (the head expr is only in scope at this point) and
  // stamped onto the constructed Func as `is_control` below. Mirrors TS
  // `context.isControlFunctionType` (_expr.ts:286) → `isControl` (function.ts:2678).
  is_ctl_fn_type := ast_expr_is_fn_call_of(arg_list_expr, BK_CTL, Option(usize).None);
  arg_list := _fn_call_args(arg_list_expr);
  // Set is_evaluating_function_type flag on context
  prev_is_eval_fn_type := ctx.is_evaluating_function_type;
  ctx.is_evaluating_function_type = true;
  // Evaluate parameters (pushes a new env frame, doesn't pop it)
  (env_mut : Environment) = env;
  params_result := evaluate_function_parameters(arg_list, env_mut, ctx, exn);
  // Restore context flag
  ctx.is_evaluating_function_type = prev_is_eval_fn_type;
  // Parse return type
  (return_label : Option(String)) = Option(String).None;
  (is_return_comptime_only : bool) = false;
  (is_return_unquote : bool) = false;
  (is_return_type_ref : bool) = false;
  (return_type_expr : AstExpr) = return_expr;
  // -> (ret : i32) or -> (comptime(ret) : i32) or -> (unquote(ret) : Expr)
  if(ast_expr_is_fn_call_of(return_type_expr, ":",.Some(usize(2))), {
    ret_args := _fn_call_args(return_type_expr);
    (rl_expr : AstExpr) = match(ret_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    return_type_expr = match(ret_args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
    // `(inout(name) : T)` / `(name : inout(T))` — ref-return forms are
    // BANNED: refs are second-class and may appear only in parameter
    // position and local lvalue borrows. (Mirrors the TS ban in
    // evaluateFunctionType.)
    if(ast_expr_is_fn_call_of(rl_expr, BK_INOUT, Option(usize).None) ||
      (ast_expr_is_fn_call(return_type_expr) && ast_expr_is_fn_call_of(return_type_expr, BK_INOUT, Option(usize).None)), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(rl_expr),
            String.from("Functions cannot return 'ref' — return the value instead (object values are handles that mutate in place; struct values copy), or take a callback parameter that receives 'inout(name) : T'."),
            false,
            .None
          )
        )
      );
    });
    // comptime modifier
    if(ast_expr_is_fn_call_of(rl_expr, BK_COMPTIME, Option(usize).None), {
      is_return_comptime_only = true;
      ct_args := _fn_call_args(rl_expr);
      if(!(ct_args.len() == usize(1)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(rl_expr),
              `Expected one argument for "comptime", got ${ct_args.len()}`,
              false,
              .None
            )
          )
        );
      });
      rl_expr = match(ct_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    });
    // unquote modifier — accepts both `unquote(...)` and `#(...)`
    // (TS `BuiltinKeywords.unquote = ["unquote", "#"]`).
    rl_is_unquote := (
      ast_expr_is_fn_call_of(rl_expr, "unquote", Option(usize).None) ||
        ast_expr_is_fn_call_of(rl_expr, "#", Option(usize).None)
    );
    if(rl_is_unquote, {
      is_return_unquote = true;
      uq_args := _fn_call_args(rl_expr);
      if(!(uq_args.len() == usize(1)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(rl_expr),
              `Expected one argument for "unquote", got ${uq_args.len()}`,
              false,
              .None
            )
          )
        );
      });
      if(is_return_comptime_only, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(rl_expr),
              `Cannot use "comptime" with "unquote". "unquote" return type means compile-time only, so "comptime" is redundant.`,
              false,
              .None
            )
          )
        );
      });
      is_return_comptime_only = true;
      rl_expr = match(uq_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    });
    // quote on return label is an error
    if(ast_expr_is_fn_call_of(rl_expr, BK_QUOTE, Option(usize).None), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(rl_expr),
            `To define a macro function, please use "unquote" for the return type, not "quote".`,
            false,
            .None
          )
        )
      );
    });
    // In a labeled return slot, a `ref`/`comptime` modifier goes on the LABEL,
    // never on the TYPE. Reject `-> (name : inout(T))` / `-> (name : comptime(T))`;
    // use `-> (inout(name) : T)` / `-> (comptime(name) : T)` (or unlabeled
    // `-> inout(T)` / `-> comptime(T)`). The `(inout(name) : inout(T))` double-ref
    // case is caught above with a more specific message. Mirrors function.ts.
    if(ast_expr_is_fn_call(return_type_expr) && ast_expr_is_fn_call_of(return_type_expr, BK_INOUT, Option(usize).None), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(return_type_expr),
            String.from("In a labeled return slot, 'ref' goes on the label, not the type. Use '-> (inout(name) : T)' (or unlabeled '-> inout(T)'), not '-> (name : inout(T))'."),
            false,
            .None
          )
        )
      );
    });
    if(ast_expr_is_fn_call(return_type_expr) && ast_expr_is_fn_call_of(return_type_expr, BK_COMPTIME, Option(usize).None), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(return_type_expr),
            String.from("In a labeled return slot, 'comptime' goes on the label, not the type. Use '-> (comptime(name) : T)' (or unlabeled '-> comptime(T)'), not '-> (name : comptime(T))'."),
            false,
            .None
          )
        )
      );
    });
    if(!(is_valid_variable_name(rl_expr)), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(rl_expr),
            `Expected a valid variable name for return label, got ${ast_expr_to_string(rl_expr)}`,
            false,
            .None
          )
        )
      );
    });
    return_label =.Some(ast_expr_token(rl_expr).value);
  }, {
    // -> i32 or -> comptime(i32) or -> unquote(Expr)
    // `-> inout(T)` is BANNED: refs are second-class and may appear only
    // in parameter position and local lvalue borrows. (Mirrors the TS
    // ban in evaluateFunctionType.)
    if(ast_expr_is_fn_call(return_type_expr) && ast_expr_is_fn_call_of(return_type_expr, BK_INOUT, Option(usize).None), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(return_type_expr),
            String.from("Functions cannot return 'ref' — return the value instead (object values are handles that mutate in place; struct values copy), or take a callback parameter that receives 'inout(name) : T'."),
            false,
            .None
          )
        )
      );
    });
    if(ast_expr_is_fn_call_of(return_type_expr, BK_COMPTIME, Option(usize).None), {
      is_return_comptime_only = true;
      ct_args2 := _fn_call_args(return_type_expr);
      if(!(ct_args2.len() == usize(1)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(return_type_expr),
              `Expected one argument for "comptime", got ${ct_args2.len()}`,
              false,
              .None
            )
          )
        );
      });
      return_type_expr = match(ct_args2.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    });
    rte_is_unquote := (
      ast_expr_is_fn_call_of(return_type_expr, "unquote", Option(usize).None) ||
        ast_expr_is_fn_call_of(return_type_expr, "#", Option(usize).None)
    );
    if(rte_is_unquote, {
      is_return_unquote = true;
      uq_args2 := _fn_call_args(return_type_expr);
      if(!(uq_args2.len() == usize(1)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(return_type_expr),
              `Expected one argument for "unquote", got ${uq_args2.len()}`,
              false,
              .None
            )
          )
        );
      });
      if(is_return_comptime_only, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(return_type_expr),
              `Cannot use "comptime" with "unquote". "unquote" return type means compile-time only, so "comptime" is redundant.`,
              false,
              .None
            )
          )
        );
      });
      is_return_comptime_only = true;
      return_type_expr = match(uq_args2.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    });
    if(ast_expr_is_fn_call_of(return_type_expr, BK_QUOTE, Option(usize).None), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(return_type_expr),
            `To define a macro function, please use "unquote" for the return type, not "quote".`,
            false,
            .None
          )
        )
      );
    });
  });
  // `-> inout(T)` in the return slot is BANNED: refs are second-class and
  // may appear only in parameter position and local lvalue borrows.
  // (Mirrors the TS ban in evaluateFunctionType.)
  if(ast_expr_is_fn_call(return_type_expr) && ast_expr_is_fn_call_of(return_type_expr, BK_INOUT, Option(usize).None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(return_type_expr),
          String.from("Functions cannot return 'ref' — return the value instead (object values are handles that mutate in place; struct values copy), or take a callback parameter that receives 'inout(name) : T'."),
          false,
          .None
        )
      )
    );
  });
  // Evaluate return type expression
  prev_eval_fn := ctx.is_evaluating_function_type;
  ctx.is_evaluating_function_type = true;
  ret_type_opt := _eval_and_update_env(return_type_expr, env_mut, ctx, exn);
  ctx.is_evaluating_function_type = prev_eval_fn;
  ret_type_val := match(
    ret_type_opt,
    .Some(t) => t,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(return_type_expr),
            `Expected a type for function return type, got:\n${ast_expr_to_string(return_type_expr)}`,
            false,
            .None
          )
        )
      );
      TypeValue.Unit
    }
  );
  // Auto-convert comptime-only return types if possible
  (return_type : TypeValue) = ret_type_val;
  if(type_requires_comptime_modifier(return_type) && !(is_return_comptime_only), {
    converted := convert_comptime_type_to_runtime_type(return_type, env_mut);
    if(type_requires_comptime_modifier(converted), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(return_type_expr),
            `Expected a "comptime" for return type, like:\n\ncomptime(${ast_expr_to_string(return_type_expr)})\n\nGiven type:\n${type_to_string(return_type)}`,
            false,
            .None
          )
        )
      );
    });
    return_type = converted;
  });
  // Prohibit void return type
  if(!(ctx.is_unsafe_function_type), {
    prohibit_void_type(return_type, ast_expr_token(return_type_expr), exn);
  });
  if(is_return_comptime_only &&
    !(type_contains_some_type(return_type)) &&
      type_prohibits_comptime_modifier(return_type), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(return_type_expr),
          `Unexpected "comptime" for return type of ${type_to_string(return_type)} which can only be used at runtime.`,
          false,
          .None
        )
      )
    );
  });
  // All params must be comptime if return is comptime
  if(is_return_comptime_only, {
    (rci : usize) = usize(0);
    while(rci < params_result.params.len(), {
      rp := match(
        params_result.params.get(rci),
        .Some(p) => p,
        .None => {
          rci = params_result.params.len();
          break;
        }
      );
      if(!(rp.is_compile_time_only), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(match(param_exprs_for_error(arg_list, rci),.Some(e) => e,.None => make_err_expr())),
              String.from("Expected all parameters to be compile time only given the return type is compile time only."),
              false,
              .None
            )
          )
        );
      });
      rci = (rci + usize(1));
    });
  });
  // unquote return must be Expr type
  if(is_return_unquote && !(is_expr_type(return_type)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(return_type_expr),
          `Expected Expr type for "unquote" return type, got ${type_to_string(return_type)}`,
          false,
          .None
        )
      )
    );
  });
  // Collect where-clause constraints for the call-site re-application side
  // table (see WhereConstraintEntry above) BEFORE popping the parameter frame:
  // a regular `comptime(T) : Type` parameter's constrained SomeT placeholder
  // lives only in this frame (pass 3 pre-added it; the where clause mutated its
  // required/negative trait lists in place). Forall params carry their SomeT in
  // `params_result.forall_params[].ty` directly.
  where_constraint_entries := ArrayList(WhereConstraintEntry).new();
  (wce_i : usize) = usize(0);
  while(wce_i < params_result.forall_params.len(), {
    wfp := match(
      params_result.forall_params.get(wce_i),
      .Some(p) => p,
      .None => {
        wce_i = params_result.forall_params.len();
        break;
      }
    );
    _collect_where_constraints_from_some_t(wfp.label, wfp.ty, where_constraint_entries);
    wce_i = (wce_i + usize(1));
  });
  (wcp_i : usize) = usize(0);
  while(wcp_i < params_result.params.len(), {
    wpp := match(
      params_result.params.get(wcp_i),
      .Some(p) => p,
      .None => {
        wcp_i = params_result.params.len();
        break;
      }
    );
    if(wpp.is_compile_time_only, {
      ct_vars := get_variables_from_env(env_mut, wpp.label);
      if(ct_vars.len() > usize(0), {
        match(
          ct_vars.get(ct_vars.len() - usize(1)),
          .Some(ct_var) => match(
            ct_var.value.get(usize(0)),
            .Some(cv) => match(
              cv,
              .TypeVal(ct_tb) => _collect_where_constraints_from_some_t(wpp.label, ct_tb, where_constraint_entries),
              _ => ()
            ),
            .None => ()
          ),
          .None => ()
        );
      });
    });
    wcp_i = (wcp_i + usize(1));
  });
  // Pop the parameters frame
  env_mut.pop_frame();
  // Build TypeValue.Func from collected parameters
  forall_labels := ArrayList(String).new();
  forall_types := ArrayList(TypeValue).new();
  param_labels := ArrayList(String).new();
  param_types := ArrayList(TypeValue).new();
  param_is_ref := ArrayList(bool).new();
  param_is_owning := ArrayList(bool).new();
  implicit_labels := ArrayList(String).new();
  implicit_types := ArrayList(TypeValue).new();
  implicit_spreads := ArrayList(bool).new();
  where_types := ArrayList(TypeValue).new();
  (fpi : usize) = usize(0);
  while(fpi < params_result.forall_params.len(), {
    fp := match(
      params_result.forall_params.get(fpi),
      .Some(p) => p,
      .None => {
        fpi = params_result.forall_params.len();
        break;
      }
    );
    forall_labels.push(fp.label);
    forall_types.push(fp.ty);
    fpi = (fpi + usize(1));
  });
  (ppi : usize) = usize(0);
  param_defaults := ArrayList(Option(EvalValue)).new();
  param_default_exprs := ArrayList(Option(AstExpr)).new();
  param_type_exprs := ArrayList(Option(AstExpr)).new();
  param_comptime_flags := ArrayList(bool).new();
  quoted_param_indices := ArrayList(usize).new();
  while(ppi < params_result.params.len(), {
    pp := match(
      params_result.params.get(ppi),
      .Some(p) => p,
      .None => {
        ppi = params_result.params.len();
        break;
      }
    );
    param_labels.push(pp.label);
    param_types.push(pp.ty);
    param_is_ref.push(pp.is_ref);
    param_is_owning.push(pp.is_owning_rc_value);
    param_defaults.push(pp.default_value);
    param_default_exprs.push(pp.default_value_expr);
    param_type_exprs.push(pp.ty_expr);
    param_comptime_flags.push(pp.is_compile_time_only);
    if(pp.is_quote, {
      quoted_param_indices.push(ppi);
    });
    ppi = (ppi + usize(1));
  });
  // Register the per-parameter default values keyed by this `fn(...)`
  // type-expression id. `try_to_implement_function_by_function_type`
  // re-keys them under the FuncVal id so call-site arg matching can treat
  // trailing defaulted params as optional. (See the side-table above.)
  register_func_param_defaults(ast_expr_id(expr).to_string(), param_defaults);
  // Per-param comptime flags (same two-step re-keying as the defaults) so the
  // call site can lower comptime-only args passed to RUNTIME params.
  register_func_param_comptime(ast_expr_id(expr).to_string(), param_comptime_flags);
  // Keep the declared return-type EXPR for specialization-time re-evaluation
  // (see the side-table comment above; TS functionType.return.typeExpr).
  register_func_return_type_expr(ast_expr_id(expr).to_string(), return_type_expr.clone());
  // Register the per-parameter default-value EXPRESSIONS (parallel to the
  // values above) so codegen can EMIT an omitted default as a C argument.
  register_func_param_default_exprs(ast_expr_id(expr).to_string(), param_default_exprs);
  // Per-parameter declared TYPE expressions (TS parameter.exprs.typeExpr) for
  // specialization-time re-evaluation — see the side-table comment above.
  register_func_param_type_exprs(ast_expr_id(expr).to_string(), param_type_exprs);
  // Register the where-clause constraints (keyed like the defaults; re-keyed
  // under the FuncVal id by try_to_implement_function_by_function_type) so the
  // call site can validate bound concrete types against them.
  register_func_where_constraints(ast_expr_id(expr).to_string(), where_constraint_entries);
  // Register the where-clause EXPRESSIONS too (TS functionType.whereClauseExprs)
  // for the call-site re-application — see the exprs side-table comment above.
  register_func_where_clause_exprs(ast_expr_id(expr).to_string(), params_result.where_clause_exprs);
  // Register the Phase-0 contract predicates (keyed like the defaults; re-keyed
  // under the FuncVal id by try_to_implement_function_by_function_type) so the
  // body-wrapping lowering can splice them into the function body.
  // Mirrors function.ts:2273-2274 storing them on the FunctionType.
  register_func_requires_exprs(ast_expr_id(expr).to_string(), params_result.requires_exprs);
  register_func_ensures_exprs(ast_expr_id(expr).to_string(), params_result.ensures_exprs);
  // Register the variadic parameter's name/type (see the side table above).
  if(params_result.has_variadic, {
    register_func_variadic_param(
      ast_expr_id(expr).to_string(),
      params_result.variadic_param.label.clone(),
      params_result.variadic_param.ty
    );
  });
  // Register macro-ness (quoted param indices + unquote return), keyed by
  // this `fn(...)` type-expression id and re-keyed under the FuncVal id by
  // `try_to_implement_function_by_function_type` (same two-step as the
  // defaults table). Mirrors TS storing `parameter.isQuote` /
  // `return.isUnquote` directly on FunctionType — yo-self's TypeValue.Func
  // does not carry these flags, so they live in the macro registry above.
  register_macro_quoted_params(ast_expr_id(expr).to_string(), quoted_param_indices);
  if(is_return_unquote, {
    register_macro_return_is_unquote(ast_expr_id(expr).to_string());
  });
  (ipi : usize) = usize(0);
  while(ipi < params_result.implicit_params.len(), {
    ip := match(
      params_result.implicit_params.get(ipi),
      .Some(p) => p,
      .None => {
        ipi = params_result.implicit_params.len();
        break;
      }
    );
    implicit_labels.push(ip.label);
    implicit_types.push(ip.ty);
    implicit_spreads.push(ip.is_effect_row_spread);
    ipi = (ipi + usize(1));
  });
  // where_types: collect trait types from where clause exprs (for substitution)
  // We store the constraint trait types from the SomeT required_trait_types
  (wci : usize) = usize(0);
  while(wci < params_result.forall_params.len(), {
    fp := match(
      params_result.forall_params.get(wci),
      .Some(p) => p,
      .None => {
        wci = params_result.forall_params.len();
        break;
      }
    );
    match(
      fp.ty,
      .SomeT(_, _, _, _, required_trait_types, _, _, _, _, _, _) => {
        (ti2 : usize) = usize(0);
        while(ti2 < required_trait_types.len(), {
          tt := match(
            required_trait_types.get(ti2),
            .Some(t) => t,
            .None => {
              ti2 = required_trait_types.len();
              break;
            }
          );
          where_types.push(tt);
          ti2 = (ti2 + usize(1));
        });
      },
      _ => ()
    );
    wci = (wci + usize(1));
  });
  (mint_vlabel : Option(String)) = Option(String).None;
  (mint_vcomptime : bool) = false;
  vts_mint := ArrayList(TypeValue).new();
  if(params_result.has_variadic, {
    mint_vlabel = Option(String).Some(params_result.variadic_param.label.clone());
    mint_vcomptime = params_result.variadic_param.is_compile_time_only;
    vts_mint.push(params_result.variadic_param.ty);
  });
  func_type := TypeValue.Func(
    forall_types,
    param_types,
    implicit_types,
    where_types,
    return_type,
    box(
      FuncMeta(
        forall_labels : forall_labels,
        param_labels : param_labels,
        implicit_labels : implicit_labels,
        implicit_spreads : implicit_spreads,
        // result_is_comptime_only — mirrors TS `return.isCompileTimeOnly`,
        // set from the `comptime(...)` wrapper on the declared return.
        result_is_comptime_only : is_return_comptime_only,
        // param_is_ref / param_is_owning / result_is_ref — mirrors TS
        // `FunctionParameter.isRef`, `isOwningTheRcValue`, and `return.isRef`.
        param_is_ref : param_is_ref,
        param_is_owning : param_is_owning,
        result_is_ref : is_return_type_ref,
        // has_variadic — mirrors TS `FunctionType.variadicParameter` presence,
        // set from the trailing `...` marker (C-style variadic externs).
        has_variadic : params_result.has_variadic,
        // is_extern / extern_name — None here; a bare `fn(...)` type carries no
        // FFI marker. `evaluate_extern`/`evaluate_c_include` rebuild the field's
        // type with `Some(language)`/`Some(label)` (mirrors extern.ts:138-161).
        is_extern : Option(String).None,
        extern_name : Option(String).None,
        // is_control — true when the head was `ctl(...)` (mirrors isControl).
        is_control : is_ctl_fn_type,
        // variadic_label / variadic_comptime — the variadic parameter's
        // binding name + comptime flag (mirrors TS
        // `FunctionType.variadicParameter.{label,isCompileTimeOnly}`); the
        // TYPE rides in Func.variadic_types below.
        variadic_label : mint_vlabel,
        variadic_comptime : mint_vcomptime,
        // origin_id — this `fn(...)` TYPE EXPRESSION's id, the key under which
        // every side table above (param comptime flags, param type exprs,
        // return type expr, defaults, where clauses, contracts) was just
        // registered. Carrying it ON the type is what lets a consumer that only
        // ever sees the TYPE — an anonymous function checked against it —
        // re-key those tables onto its own FuncVal id, the way the `::` path
        // does explicitly. TS needs no such channel because the data lives on
        // its FunctionType and its anonymous-function evaluator spreads it.
        origin_id : Option(String).Some(ast_expr_id(expr).to_string())
      )
    ),
    vts_mint
  );
  // Set expr info on the expr
  out_info := new_expr_info(env_mut, type_of_type(func_type));
  out_info.value =.Some(create_type_value(func_type));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
// ---------------------------------------------------------------------------
// evaluate_function_parameter_type_again
// ---------------------------------------------------------------------------
/// Resolve every SomeT inside `ty` (at any structural depth) from `env`,
/// substituting the ones that resolve to concrete types. TS re-evaluates the
/// stored type EXPRESSION in the callee env, which resolves type variables at
/// any nesting level (`*(T)` → `*(u8)`); yo-self's `TypeValue.Func` keeps
/// only pre-evaluated TypeValues, so the equivalent is: collect the SomeTs,
/// resolve each via `get_value_of_some_type_from_env`, and `substitute`.
/// A bare-SomeT input keeps the direct single-lookup path (identical result,
/// no list allocation).
/// Collect the SomeTypes nested inside a SomeT wrapper's `Fn`-trait carrier —
/// the `E`/`T` inside `Impl(Fn(e : E) -> T)`. `get_all_some_types` deliberately
/// stops at a SomeT boundary (a faithful mirror of TS's `getAllSomeTypes`, which
/// never recurses into a SomeType and reaches inner vars only via type-expr
/// re-evaluation). yo-self stores no type expr, so `_resolve_some_types_deep`
/// walks the `Fn` carrier here so a closure parameter's bundle type resolves at
/// the call site.
///
/// Deliberately does NOT descend into a `Future` carrier (`Impl(Future(T, E))`):
/// yo-self's async codegen keeps the future's output/effect UNRESOLVED through
/// eval (the sync-future struct is registered against the wrapper SomeType id).
/// Resolving them would change the return type's identity and break that
/// registration. The `Fn` carrier yields the same `E`/`T` instances (shared
/// generic vars) so their self-markers still get recreated.
collect_wrapper_trait_somes :: (fn(wrapper : TypeValue) -> ArrayList(TypeValue))({
  acc := ArrayList(TypeValue).new();
  rtts := match(
    wrapper,
    .SomeT(_, _, _, _, required_trait_types : rts, _, _, _, _, _, _) => rts,
    _ => ArrayList(TypeValue).new()
  );
  (i : usize) = usize(0);
  while(i < rtts.len(), {
    rtt := match(rtts.get(i),.Some(t) => t,.None => t_unit());
    match(
      rtt,
      .FnTraitT({ call_param_types : cpts, call_result : cr, implicit_types : its }) => {
        (cj : usize) = usize(0);
        while(cj < cpts.len(), {
          match(
            cpts.get(cj),
            .Some(pt) => {
              inner := get_all_some_types(pt);
              (ii : usize) = usize(0);
              while(ii < inner.len(), {
                match(
                  inner.get(ii),
                  .Some(s) => {
                    acc.push(s);
                  },
                  .None => ()
                );
                ii = (ii + usize(1));
              });
            },
            .None => ()
          );
          cj = (cj + usize(1));
        });
        cr_inner := get_all_some_types(cr);
        (ci : usize) = usize(0);
        while(ci < cr_inner.len(), {
          match(
            cr_inner.get(ci),
            .Some(s) => {
              acc.push(s);
            },
            .None => ()
          );
          ci = (ci + usize(1));
        });
        (ij : usize) = usize(0);
        while(ij < its.len(), {
          match(
            its.get(ij),
            .Some(it) => {
              inner := get_all_some_types(it);
              (ik : usize) = usize(0);
              while(ik < inner.len(), {
                match(
                  inner.get(ik),
                  .Some(s) => {
                    acc.push(s);
                  },
                  .None => ()
                );
                ik = (ik + usize(1));
              });
            },
            .None => ()
          );
          ij = (ij + usize(1));
        });
      },
      _ => ()
    );
    i = (i + usize(1));
  });
  acc
});
_resolve_some_types_deep :: (
  fn(ty : TypeValue, env : Environment) -> TypeValue
)({
  if(is_some_type(ty), {
    r := get_value_of_some_type_from_env(env, ty);
    // Wrapper resolved to a concrete type → done.
    if(!(is_some_type(r)), {
      return(r);
    });
    // The wrapper is still an unbound SomeT (e.g. `Impl(Fn(e : E) -> T)` whose
    // `Impl` var is unbound while an inner var like `E` is now concrete). Resolve
    // the SomeTypes nested in its `Fn` carrier and substitute them back — the
    // value-space equivalent of TS re-evaluating the parameter's type expr.
    // Without it a closure bundle param stays `Impl(Fn(e : E) -> T)`, `e` lowers
    // to `void*`, and `e.io` / `e.exn` field accesses fail.
    nested := collect_wrapper_trait_somes(r);
    if(nested.len() == usize(0), {
      return(r);
    });
    ns := subst_new();
    (nbound : bool) = false;
    (nti : usize) = usize(0);
    while(nti < nested.len(), {
      nst := match(nested.get(nti),.Some(t) => t,.None => t_unit());
      (nres : TypeValue) = get_value_of_some_type_from_env(env, nst);
      // Track whether the resolution came from the env (true) or from
      // the global lookup_some_resolved_concrete fallback (false).
      // Only register when sourced from env to avoid re-caching IoExn.
      (nres_from_env : bool) = !(is_some_type(nres));
      if(is_some_type(nres), {
        // Only fall back to the global table when the env lookup
        // returned a FRESH SomeType (from get_value_of_some_type_from_env's
        // self-bound/def-frame gating). Skip the fallback for "E" (effect
        // param) — the global table is poisoned by prior IoExn registrations
        // and would resolve E to IoExn even for single-effect io.async calls.
        _skip_fallback := match(
          nst,
          .SomeT(_, _nsn, _, _, _, _, _, _, _, _, _) => (_nsn == "E"),
          _ => false
        );
        if(!(_skip_fallback), {
          match(
            nres,
            .SomeT({ id : nrsid }) => match(
              lookup_some_resolved_concrete(nrsid),
              .Some(c) => {
                nres = c;
              },
              .None => ()
            ),
            _ => ()
          );
        });
      });
      if(!(is_some_type(nres)), {
        match(
          nst,
          .SomeT(nst_id, nst_name, nst_lvl, _, _, _, _, _, _, _, _) => {
            subst_add(ns, nst_name, nst_lvl, nres);
            // Register the concrete type in the global table when
            // resolved from the env (not from the stale fallback).
            // Skip registering IoExn — it's a compound effect that
            // would overwrite single-effect Io and poison subsequent
            // io.async calls that only need Io.
            if(nres_from_env, {
              _is_ioexn := match(
                nres,
                .Struct({ id : _reg_sid }) => (_reg_sid == "IoExn"),
                _ => false
              );
              if(!(_is_ioexn), {
                register_some_resolved_concrete(nst_id, nres);
              });
            });
            nbound = true;
          },
          _ => ()
        );
      });
      nti = (nti + usize(1));
    });
    return(cond(nbound => substitute(ns, r), true => r));
  });
  some_types := get_all_some_types(ty);
  if(some_types.len() == usize(0), {
    return(ty);
  });
  s := subst_new();
  (bound_any : bool) = false;
  (sti : usize) = usize(0);
  while(sti < some_types.len(), {
    st := match(some_types.get(sti),.Some(t) => t,.None => t_unit());
    (resolved : TypeValue) = get_value_of_some_type_from_env(env, st);
    // If the env resolves `st` only to ANOTHER SomeType (e.g. an async future's
    // output type, which yo-self keeps unresolved through eval), try the codegen
    // resolved-concrete registry — the same resolvedConcreteType bridge the
    // io.await/io.spawn refinements use. This lets `io.spawn`'s `JoinHandle(T)`
    // return type concretize `T` to the spawned future's actual output so the
    // `handle.await` generic-impl match can bind it. See
    // issues/yo-self-async-await-struct-result-eval.md.
    if(is_some_type(resolved), {
      match(
        resolved,
        .SomeT({ id : rsid }) => match(
          lookup_some_resolved_concrete(rsid),
          .Some(c) => {
            resolved = c;
          },
          .None => ()
        ),
        _ => ()
      );
    });
    if(!(is_some_type(resolved)), {
      match(
        st,
        .SomeT(_, st_name, st_lvl, _, _, _, _, _, _, _, _) => {
          subst_add(s, st_name, st_lvl, resolved);
          bound_any = true;
        },
        _ => ()
      );
    });
    sti = (sti + usize(1));
  });
  cond(
    bound_any => substitute(s, ty),
    true => ty
  )
});
/// Re-evaluate (resolve) a function parameter's type at call site.
///
/// In TypeScript, this re-evaluates the stored type expression (`.exprs.typeExpr`)
/// to resolve any generic type variables that have been bound since the function
/// was defined.  In Yo, `TypeValue.Func` stores only the pre-evaluated types
/// (not the original expressions), so we resolve the type by walking the callee
/// env — at ANY structural depth (`_resolve_some_types_deep`), matching the
/// expression re-evaluation's behavior for shapes like `*(T)` / `Slice(T)`.
///
/// Input:
///   `param_type`  — pre-evaluated parameter type from `TypeValue.Func.param_types[i]`
///   `callee_env`  — callee-side environment (has generic bindings)
/// Output: the resolved parameter type (concrete if a SomeT was bound, else unchanged)
///
/// Mirrors `evaluateFunctionParameterTypeAgain` in
/// `src/evaluator/types/function.ts`.
evaluate_function_parameter_type_again :: (
  fn(
    param_type : TypeValue,
    callee_env : Environment,
    _ctx : EvalContext
  ) -> TypeValue
)(
  _resolve_some_types_deep(param_type, callee_env)
);
// ---------------------------------------------------------------------------
/// Has `cta_id` already been walked on this branch? Mirrors
/// `_id_already_visited` in types/utils.yo (not exported, so re-stated here).
_cta_seen :: (fn(cta_v : ArrayList(String), cta_id : String) -> bool)({
  (cta_k : usize) = usize(0);
  (cta_found : bool) = false;
  while((cta_k < cta_v.len()) && !(cta_found), {
    match(
      cta_v.get(cta_k),
      .Some(cta_e) => if(cta_e == cta_id, {
        cta_found = true;
      }),
      .None => ()
    );
    cta_k = (cta_k + usize(1));
  });
  cta_found
});
/// Collect the SomeTs that live ONLY in a generic instantiation's
/// `type_arguments` — the yo-self-only slot standing in for TS's
/// `StructType.env` (types/definitions.yo:212). `get_all_some_types` walks
/// FIELD types only, a faithful mirror of TS's `getAllSomeTypes`
/// (src/types/utils.ts:813-864), which has nothing more to walk: TS never
/// substitutes into an instantiation, it RE-EVALUATES the return-type
/// EXPRESSION (src/evaluator/types/function.ts:2836, called unconditionally
/// from src/evaluator/calls/helper.ts:1538). yo-self resolves by substitution,
/// and `substitute()` DOES rewrite `type_arguments`
/// (types/substitution.yo:290-298) — the gap is only in the MAP, so a forall
/// occurring solely as an instantiation ARGUMENT is never a substitution key.
/// `type_key` keys an instance as `gs_<ctor_fid>_<type_arguments>`
/// (types/type_key.yo:137), so a raw SomeT in an argument slot emits a SECOND
/// C struct with the same layout (tests/where_clause_fn_inference).
///
/// `visited_ids` is the same cycle guard `_collect_some_types_into` needs
/// (types/utils.yo:961) — a recursive struct type is a CYCLIC TypeValue graph
/// and an unguarded walk both recurses forever and re-visits shared subtrees
/// exponentially.
_collect_type_arg_somes :: (
  fn(ty : TypeValue, acc : ArrayList(TypeValue), visited_ids : ArrayList(String)) -> unit
)(
  match(
    ty,
    .Struct({ id : cta_sid, field_types : cta_fts, type_arguments : cta_args }) => {
      if(_cta_seen(visited_ids, cta_sid), {
        return(());
      });
      if(cta_sid.len() > usize(0), {
        visited_ids.push(cta_sid.clone());
      });
      (cta_a : usize) = usize(0);
      while(cta_a < cta_args.len(), {
        match(
          cta_args.get(cta_a),
          .Some(cta_at) => {
            if(is_some_type(cta_at), {
              acc.push(cta_at);
            });
            recur(cta_at, acc, visited_ids);
          },
          .None => ()
        );
        cta_a = (cta_a + usize(1));
      });
      (cta_f : usize) = usize(0);
      while(cta_f < cta_fts.len(), {
        match(cta_fts.get(cta_f),.Some(cta_ft) => recur(cta_ft, acc, visited_ids),.None => ());
        cta_f = (cta_f + usize(1));
      });
    },
    .EnumT(cta_eid, _, _, cta_vfs, _, _, _, _, _) => {
      if(_cta_seen(visited_ids, cta_eid), {
        return(());
      });
      if(cta_eid.len() > usize(0), {
        visited_ids.push(cta_eid.clone());
      });
      (cta_v : usize) = usize(0);
      while(cta_v < cta_vfs.len(), {
        cta_vf := match(cta_vfs.get(cta_v),.Some(vf) => vf,.None => ArrayList(TypeValue).new());
        (cta_j : usize) = usize(0);
        while(cta_j < cta_vf.len(), {
          match(cta_vf.get(cta_j),.Some(cta_vt) => recur(cta_vt, acc, visited_ids),.None => ());
          cta_j = (cta_j + usize(1));
        });
        cta_v = (cta_v + usize(1));
      });
    },
    .Func({ param_types : cta_pts, result : cta_res }) => {
      (cta_p : usize) = usize(0);
      while(cta_p < cta_pts.len(), {
        match(cta_pts.get(cta_p),.Some(cta_pt) => recur(cta_pt, acc, visited_ids),.None => ());
        cta_p = (cta_p + usize(1));
      });
      recur(cta_res, acc, visited_ids);
    },
    .Tuple(_, field_types : cta_tfs) => {
      (cta_t : usize) = usize(0);
      while(cta_t < cta_tfs.len(), {
        match(cta_tfs.get(cta_t),.Some(cta_tt) => recur(cta_tt, acc, visited_ids),.None => ());
        cta_t = (cta_t + usize(1));
      });
    },
    .Pointer(pointee : cta_p2) => recur(cta_p2, acc, visited_ids),
    .Array(element : cta_e, _, _) => recur(cta_e, acc, visited_ids),
    .IsoT(child : cta_c) => recur(cta_c, acc, visited_ids),
    _ => ()
  )
);
/// Resolve those type-argument SomeTs through the SAME three channels
/// `_resolve_some_types_deep` already uses at this very site (env by name →
/// the SomeT's own shared resolved-concrete cell → the id-keyed
/// `lookup_some_resolved_concrete` registry). The registry channel is REQUIRED:
/// the measured record for this call (issues/yo-self-hollow-root-cause-map.md
/// "A resolved via the registry, B needed the env fallback") says `A` is
/// reachable only there. It is a RESOLUTION channel, exactly as
/// `_resolve_some_types_deep` uses it — NOT a memo-COMPARISON channel, which is
/// what F-era attempt 4 did inside `_ctfe_args_equal` and what the recorded
/// verdict forbids.
_resolve_type_arg_somes :: (fn(ty : TypeValue, env : Environment) -> TypeValue)({
  targ_somes := ArrayList(TypeValue).new();
  tas_visited := ArrayList(String).new();
  _collect_type_arg_somes(ty, targ_somes, tas_visited);
  if(targ_somes.len() == usize(0), {
    return(ty);
  });
  tas_s := subst_new();
  (tas_bound_any : bool) = false;
  (tas_i : usize) = usize(0);
  while(tas_i < targ_somes.len(), {
    match(
      targ_somes.get(tas_i),
      .Some(tas_st) => {
        (tas_r : TypeValue) = get_value_of_some_type_from_env(env, tas_st);
        if(is_some_type(tas_r), {
          match(
            tas_st,
            .SomeT({ resolved_concrete : tas_cell }) => match(
              tas_cell.get(usize(0)),
              .Some(tas_c) => {
                tas_r = tas_c;
              },
              .None => ()
            ),
            _ => ()
          );
        });
        if(is_some_type(tas_r), {
          match(
            tas_r,
            .SomeT({ id : tas_rid }) => match(
              lookup_some_resolved_concrete(tas_rid),
              .Some(tas_g) => {
                tas_r = tas_g;
              },
              .None => ()
            ),
            _ => ()
          );
        });
        if(!(is_some_type(tas_r)), {
          match(
            tas_st,
            .SomeT(_, tas_name, tas_lvl, _, _, _, _, _, _, _, _) => {
              subst_add(tas_s, tas_name, tas_lvl, tas_r);
              tas_bound_any = true;
            },
            _ => ()
          );
        });
      },
      .None => ()
    );
    tas_i = (tas_i + usize(1));
  });
  cond(
    tas_bound_any => substitute(tas_s, ty),
    true => ty
  )
});
// evaluate_function_return_type_again
// ---------------------------------------------------------------------------
/// Re-evaluate (resolve) a function's return type at call site.
///
/// Same semantics as `evaluate_function_parameter_type_again` but for the
/// return type.  Resolves any SomeT in the return type from the callee env.
///
/// Input:
///   `return_type` — pre-evaluated return type from `TypeValue.Func`
///   `callee_env`  — callee-side environment (has generic bindings)
/// Output: the resolved return type
///
/// Mirrors `evaluateFunctionReturnTypeAgain` in
/// `src/evaluator/types/function.ts`.
evaluate_function_return_type_again :: (
  fn(
    return_type : TypeValue,
    callee_env : Environment,
    _ctx : EvalContext
  ) -> TypeValue
)({
  resolved := _resolve_some_types_deep(return_type, callee_env);
  // Gap-6 attempt #8(a): a declared-`Self` return resolves through the env to
  // the impl's PATTERN-ERA instance (its unresolved `T#N` lives ONLY in
  // type_arguments, which no resolution path walks). The dispatcher put the
  // call's CONCRETE receiver instance in ctx.self_type — adopt it whenever
  // the resolved return is a same-ctor, tyarg-compatible sibling (TS gets
  // this natively from `context.SelfType = dereferencedReceiverType`). This
  // is the CENTRAL exit every spec-signature/return stamping funnels through.
  (rr_out : TypeValue) = match(
    _ctx.self_type,
    .Some(rr_recv) => match(
      adopt_receiver_struct_instance(resolved, rr_recv),
      .Some(rr_adopted) => rr_adopted,
      .None => resolved
    ),
    .None => resolved
  );
  // Applied AFTER the adopt, never before: `adopt_receiver_struct_instance`'s
  // tyarg gate (expr_info.yo:857-890) treats an UNRESOLVED ret tyarg as a
  // wildcard and requires a RESOLVED one to match the receiver's by rendered
  // type, so concretising first could flip a currently-passing adopt to
  // `.None` and silently switch off the Gap-6 attempt-#8(a) fix.
  _resolve_type_arg_somes(rr_out, callee_env)
});
