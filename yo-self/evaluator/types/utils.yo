//! evaluator/types/utils — type-system utility helpers.
//!
//! 1-to-1 with `src/evaluator/types/utils.ts` (~2000 lines), which
//! aggregates several concerns. Currently this file covers the
//! auto-derive portion only:
//!
//!   * `autoDeriveTraitsAndAddRcFunctionsForStructType`
//!   * `autoDeriveTraitsAndAddRcFunctionsForEnumType`
//!   * `autoDeriveTraitsForUnionType`
//!
//! Traits auto-derived here (stored in `g_type_trait_registry` in
//! `evaluator/trait_checking.yo`):
//!   - Send:     struct (value) if all fields Send; object only if atomic
//!   - Rc:       object (reference-semantics) types only
//!   - Acyclic:  struct if all fields Acyclic; object if not a cycle root
//!   - Comptime: struct if all fields Comptime; object never
//!   - Runtime:  object always; struct if all fields Runtime
//!
//! RC functions (___drop / ___dup / ___dispose) are deferred to a later
//! phase. The remaining concerns from utils.ts (self-type module
//! composition, RC signature installation across struct/enum/dyn/iso,
//! `attachTraitToReceiverType`) are still scattered/stubbed across the
//! per-type files in `evaluator/types/` and are pulled in here as
//! they're ported, one TS function at a time.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../../types/definitions.yo");
{ Environment } :: import("../../env.yo");
{
  begin_send_derivation,
  end_send_derivation,
  type_implements_send,
  type_implements_acyclic,
  type_implements_comptime,
  type_implements_runtime_full,
  register_type_trait
} :: import("../trait_checking.yo");
{ can_type_form_rc_cycle } :: import("../../types/utils.yo");
// ---------------------------------------------------------------------------
// Helpers: check all field types for a trait
// ---------------------------------------------------------------------------
_all_fields_implement_send :: (fn(field_types : ArrayList(TypeValue), env : Environment) -> bool)({
  n := field_types.len();
  (i : usize) = usize(0);
  (all_ok : bool) = true;
  while((i < n) && all_ok, {
    ft := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
    if(!(type_implements_send(ft, env)), {
      all_ok = false;
    });
    i = (i + usize(1));
  });
  all_ok
});
_all_fields_implement_acyclic :: (fn(field_types : ArrayList(TypeValue), env : Environment) -> bool)({
  n := field_types.len();
  (i : usize) = usize(0);
  (all_ok : bool) = true;
  while((i < n) && all_ok, {
    ft := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
    if(!(type_implements_acyclic(ft, env)), {
      all_ok = false;
    });
    i = (i + usize(1));
  });
  all_ok
});
_all_fields_implement_comptime :: (fn(field_types : ArrayList(TypeValue), env : Environment) -> bool)({
  n := field_types.len();
  (i : usize) = usize(0);
  (all_ok : bool) = true;
  while((i < n) && all_ok, {
    ft := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
    if(!(type_implements_comptime(ft, env)), {
      all_ok = false;
    });
    i = (i + usize(1));
  });
  all_ok
});
_all_fields_implement_runtime :: (fn(field_types : ArrayList(TypeValue), env : Environment) -> bool)({
  n := field_types.len();
  (i : usize) = usize(0);
  (all_ok : bool) = true;
  while((i < n) && all_ok, {
    ft := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
    if(!(type_implements_runtime_full(ft, env)), {
      all_ok = false;
    });
    i = (i + usize(1));
  });
  all_ok
});
// ---------------------------------------------------------------------------
// auto_derive_traits_for_struct_type
// ---------------------------------------------------------------------------
/// Auto-derive trait markers for a struct/object/newtype type.
///
/// Mirrors `autoDeriveTraitsAndAddRcFunctionsForStructType` in
/// `src/evaluator/types/utils.ts`.
///
/// `begin_send_derivation` / `end_send_derivation` are called here so
/// struct.yo does not need to import trait_checking.yo directly.
///
/// `self_type` is the final struct TypeValue — used for `can_type_form_rc_cycle`.
auto_derive_traits_for_struct_type :: (
  fn(
    struct_id : String,
    field_types : ArrayList(TypeValue),
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    env : Environment,
    self_type : TypeValue
  ) -> unit
)({
  // Begin Send derivation cycle guard.
  begin_send_derivation(struct_id);
  // Send.
  // Object types: auto-derive Send only if atomic.
  // Struct (value) types: all fields must be Send.
  if(!(is_reference_semantics && !(is_atomic_rc)), {
    if(_all_fields_implement_send(field_types, env), {
      register_type_trait(struct_id, "Send", env);
    });
  });
  // Rc — object types only.
  if(is_reference_semantics, {
    register_type_trait(struct_id, "Rc", env);
  });
  // Acyclic.
  // Object types: if not a cycle root.
  // Struct (value) types: all fields Acyclic.
  is_acyclic := if(
    is_reference_semantics,
    !(can_type_form_rc_cycle(self_type)),
    _all_fields_implement_acyclic(field_types, env)
  );
  if(is_acyclic, {
    register_type_trait(struct_id, "Acyclic", env);
  });
  // Comptime — object types never; struct types if all fields Comptime.
  if(!(is_reference_semantics), {
    if(_all_fields_implement_comptime(field_types, env), {
      register_type_trait(struct_id, "Comptime", env);
    });
  });
  // Runtime — object types always; struct types if all fields Runtime.
  if(is_reference_semantics, {
    register_type_trait(struct_id, "Runtime", env);
  }, {
    if(_all_fields_implement_runtime(field_types, env), {
      register_type_trait(struct_id, "Runtime", env);
    });
  });
  // End Send derivation cycle guard.
  end_send_derivation(struct_id);
});
// ---------------------------------------------------------------------------
// auto_derive_traits_for_enum_type
// ---------------------------------------------------------------------------
/// Collect all variant field types from a nested ArrayList(ArrayList(TypeValue)).
_flatten_variant_fields :: (fn(variant_fields : ArrayList(ArrayList(TypeValue))) -> ArrayList(TypeValue))({
  result := ArrayList(TypeValue).new();
  n := variant_fields.len();
  (i : usize) = usize(0);
  while(i < n, {
    vf := match(variant_fields.get(i),.Some(f) => f,.None => ArrayList(TypeValue).new());
    m := vf.len();
    (j : usize) = usize(0);
    while(j < m, {
      ft := match(vf.get(j),.Some(t) => t,.None => TypeValue.Unit);
      ___ := result.push(ft);
      j = (j + usize(1));
    });
    i = (i + usize(1));
  });
  result
});
/// Auto-derive trait markers for an enum type.
///
/// Mirrors `autoDeriveTraitsAndAddRcFunctionsForEnumType` in
/// `src/evaluator/types/utils.ts`.
///
/// Enums are always value types (no reference semantics).
/// Traits are derived from the union of all variant field types.
auto_derive_traits_for_enum_type :: (
  fn(
    enum_id : String,
    variant_fields : ArrayList(ArrayList(TypeValue)),
    env : Environment
  ) -> unit
)({
  all_field_types := _flatten_variant_fields(variant_fields);
  // Send: all fields Send.
  if(_all_fields_implement_send(all_field_types, env), {
    register_type_trait(enum_id, "Send", env);
  });
  // Acyclic: all fields Acyclic.
  if(_all_fields_implement_acyclic(all_field_types, env), {
    register_type_trait(enum_id, "Acyclic", env);
  });
  // Comptime: all fields Comptime.
  if(_all_fields_implement_comptime(all_field_types, env), {
    register_type_trait(enum_id, "Comptime", env);
  });
  // Runtime: all fields Runtime.
  if(_all_fields_implement_runtime(all_field_types, env), {
    register_type_trait(enum_id, "Runtime", env);
  });
});
// ---------------------------------------------------------------------------
// auto_derive_traits_for_union_type
// ---------------------------------------------------------------------------
/// Auto-derive trait markers for a union type.
///
/// Mirrors `autoDeriveTraitsForUnionType` in `src/evaluator/types/utils.ts`.
///
/// Unions are value types (they cannot contain RC types — enforced earlier).
/// Traits derived from all field types.
auto_derive_traits_for_union_type :: (
  fn(
    union_id : String,
    field_types : ArrayList(TypeValue),
    env : Environment
  ) -> unit
)({
  // Send: all fields Send.
  if(_all_fields_implement_send(field_types, env), {
    register_type_trait(union_id, "Send", env);
  });
  // Acyclic: all fields Acyclic.
  if(_all_fields_implement_acyclic(field_types, env), {
    register_type_trait(union_id, "Acyclic", env);
  });
  // Comptime: all fields Comptime.
  if(_all_fields_implement_comptime(field_types, env), {
    register_type_trait(union_id, "Comptime", env);
  });
  // Runtime: all fields Runtime.
  if(_all_fields_implement_runtime(field_types, env), {
    register_type_trait(union_id, "Runtime", env);
  });
});
export(auto_derive_traits_for_struct_type);
export(auto_derive_traits_for_enum_type);
export(auto_derive_traits_for_union_type);
