          giv_vf.get(vi),
          .Some(f) => f,
          .None => {
            vi = n_v;
            break;
          }
        );
        n_f := exp_variant.len();
        (fi : usize) = usize(0);
        while(fi < n_f, {
          et := match(
            exp_variant.get(fi),
            .Some(t) => t,
