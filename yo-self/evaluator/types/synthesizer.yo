//! evaluator/types/synthesizer — type synthesis (unification of SomeType variables).
//!
//! 1:1 port of `src/evaluator/types/synthesizer.ts`.
//!
//! Exports:
//!   `SynthesizeOptions`     — options controlling synthesis behavior.
//!   `SynthesizeResult`      — return type of `synthesize_types`.
//!   `can_assign_type_hierarchy` — check if a TypeHierarchy type can be assigned.
//!   `synthesize_types`      — main type-inference/unification function.
//!
//! Key adaptation notes:
//!   - TypeScript uses object identity for `checkedTypePairs`; yo-self uses
//!     string IDs (`synthesis_type_id`) for structural identity.
//!   - TypeScript `addVariableToEnv` returns `{env, variable}`; yo-self
//!     `add_variable_to_env` mutates in place via `*(Environment)`.
//!   - TypeScript `Set<number>` → yo-self `ArrayList(bool)` (index-based flags).
//!   - `SomeType.resolvedConcreteType` mutation skipped (no such field in yo-self).
//!   - `StructType.functionValue` comparison skipped (not in yo-self); uses `id` only.
//!   - FnTrait synthesis uses parallel arrays directly instead of `callType`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  Environment,
  Variable,
  get_variables_from_env,
  add_variable_to_env,
  update_existing_variable,
  synthetic_token
} :: import("../../env.yo");
{ Token } :: import("../../token.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ register_some_resolved_concrete } :: import("../../expr_info.yo");
{ type_value_tag, t_effects_row, t_usize, resolve_enum_shell } :: import("../../types/creators.yo");
{ is_some_type, is_function_type, is_pointer_type } :: import("../../types/guards.yo");
{ TypeTag } :: import("../../types/tags.yo");
{
  is_fn_trait_type,
  is_future_trait_type,
  is_struct_type,
  is_enum_type,
  is_tuple_type,
  is_union_type,
  is_iso_type,
  is_array_type,
  is_comptime_list_type,
  is_module_type,
  is_trait_type,
  is_effects_row_type,
  is_type_application_type,
  is_type_hierarchy_type
}
:: import("../../types/guards.yo");
{ get_value_of_some_type_from_env }
:: import("../../types/env_lookup.yo");
{ type_to_string, type_to_string_key } :: import("../../types/string.yo");
{ EvalValue, lookup_enum_cfid } :: import("../../value.yo");
{ format_error_message, ErrorKind } :: import("../../error.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// Public data types
// ---------------------------------------------------------------------------
/// Options controlling type synthesis behavior.
/// Mirrors `SynthesizeTypesOptions` in TypeScript.
SynthesizeOptions :: ref(
  struct(
    /// When true, also sets `resolvedConcreteType` on SomeType objects
    /// (skipped in yo-self — no such field on SomeT).
    set_resolved_concrete_type : bool,
    /// Optional source token for variable bindings created during synthesis.
    token : Option(Token)
  )
);
/// Return type of `synthesize_types`.
/// Mirrors `{ expectedEnv: Environment; givenEnv: Environment }` in TypeScript.
SynthesizeResult :: ref(
  struct(
    expected_env : Environment,
    given_env : Environment
  )
);
// ---------------------------------------------------------------------------
// Internal data type: one implicit/effect parameter entry
// ---------------------------------------------------------------------------
/// Mirrors `FunctionImplicitParameter` in TypeScript.
ImplicitEntry :: ref(
  struct(
    label : String,
    ty : TypeValue,
    is_spread : bool
  )
);
// ---------------------------------------------------------------------------
// Checked-pair anti-circularity state
// ---------------------------------------------------------------------------
/// A pair of type IDs used to detect circular synthesis.
/// Mirrors `{ expected: Type; given: Type }[]` in TypeScript.
TypePair :: ref(
  struct(
    expected_id : String,
    given_id : String
  )
);
// ---------------------------------------------------------------------------
// synthesize_types — global function pointer (like evaluate_expression)
// ---------------------------------------------------------------------------
//
// synthesize_types calls helper functions (_synthesize_fn_traits,
// _synthesize_future_traits, _synthesize_implicit_params) which in turn call
// synthesize_types recursively. To break this circular dependency, we use the
// same global-function-pointer pattern as `evaluate_expression` in expr.yo.
/// Type of the synthesize_types function (for the global pointer).
SynthesizeTypesFn :: (
  fn(
    expected_ty : TypeValue,
    expected_env : Environment,
    given_ty : TypeValue,
    given_env : Environment,
    checked : ArrayList(TypePair),
    opts : Option(SynthesizeOptions),
    exn : Exception
  ) -> SynthesizeResult
);
/// Global function pointer — set once at module init via IIFE below.
(g_synthesize_types : Option(SynthesizeTypesFn)) = Option(SynthesizeTypesFn).None;
/// Public dispatch wrapper — mirrors `synthesizeTypes` in TypeScript.
/// Calls through the global pointer so helpers can be defined before the impl.
synthesize_types :: (
  fn(
    expected_ty : TypeValue,
    expected_env : Environment,
    given_ty : TypeValue,
    given_env : Environment,
    checked : ArrayList(TypePair),
    opts : Option(SynthesizeOptions),
    exn : Exception
  ) -> SynthesizeResult
)(
  match(
    g_synthesize_types,
    .None => exn.throw(
      dyn(
        format_error_message(
          synthetic_token(String.from("E"), expected_env.module_path),
          String.from("synthesize_types called before initialization"),
          false,
          Option(ErrorKind).None
        )
      )
    ),
    .Some(f) => f(expected_ty, expected_env, given_ty, given_env, checked, opts, exn)
  )
);
/// Internal recursive call — calls g_synthesize_types via function pointer.
/// Used by helpers inside synthesizer.yo to avoid the C codegen issue where
/// indirect-function-pointer-reachable functions don't get forward declarations.
/// This is defined BEFORE all helpers so it's in their closure scope.
_synthesize_call :: (
  fn(
    expected_ty : TypeValue,
    expected_env : Environment,
    given_ty : TypeValue,
    given_env : Environment,
    checked : ArrayList(TypePair),
    opts : Option(SynthesizeOptions),
    exn : Exception
  ) -> SynthesizeResult
)(
  match(
    g_synthesize_types,
    .None => exn.throw(
      dyn(
        format_error_message(
          synthetic_token(String.from("E"), expected_env.module_path),
          String.from("_synthesize_call: synthesize_types not initialized"),
          false,
          Option(ErrorKind).None
        )
      )
    ),
    .Some(f) => f(expected_ty, expected_env, given_ty, given_env, checked, opts, exn)
  )
);
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
/// Extract a stable identity key from a TypeValue for use in `TypePair`.
/// For named types (Struct, Enum, Trait, Module, SomeT), uses their `id` field.
/// For everything else, uses a shallow `type_to_string_key` as a
/// unique-enough key. (Was full `type_to_string`, which is O(depth-40) per call
/// and, called O(n) times over a large type with a growing `checked` list,
/// blows up to O(n²) string-building — the hang seen when routing recursive-
/// type instantiations through synthesis. The shallow key bounds that cost; it
/// is identical to the full string for shallow types.)
synthesis_type_id :: (fn(ty : TypeValue) -> String)(
  match(
    ty,
    .Struct({ id }) => id,
    .EnumT(id, _, _, _, _, _, _, _, _) => id,
    .TraitT(_, _, _, _, id, _, _, _) => id,
    .SomeT(id, _, _, _, _, _, _, _, _, _) => id,
    _ => type_to_string_key(ty)
  )
);
/// Check if a `TypePair` is already in the checked-pairs list.
_has_type_pair :: (fn(pairs : ArrayList(TypePair), exp_id : String, giv_id : String) -> bool)({
  n := pairs.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < n) && !(found), {
    p := match(
      pairs.get(i),
      .Some(p) => p,
      .None => {
        i = n;
        break;
      }
    );
    if((p.expected_id == exp_id) && (p.given_id == giv_id), {
      found = true;
    });
    i = (i + usize(1));
  });
  found
});
/// Bind a SomeType variable in `env`: add if not present, update if already present.
/// Mirrors the `!variable ? addVariableToEnv(...) : updateExistingVariable(...)` pattern.
_bind_some_type :: (
  fn(
    env : Environment,
    name : String,
    val : EvalValue,
    ty : TypeValue,
    tok : Option(Token),
    exn : Exception
  ) -> unit
)({
  token := match(tok,.Some(t) => t,.None => synthetic_token(name, env.module_path));
  vars := get_variables_from_env(env, name);
  n := vars.len();
  cond(
    (n == usize(0)) => {
      // No existing binding — add one
      add_variable_to_env(
        env,
        name,
        ty,
        Option(EvalValue).Some(val),
        true,
        // is_compile_time_only
        false,
        // is_reassignable
        false,
        // is_owning_the_rc_value
        false,
        // is_implicit
        token
      );
      ()
    },
    true => {
      // Update the last binding
      last_idx := (n - usize(1));
      old_var := match(
        vars.get(last_idx),
        .Some(v) => v,
        .None => {
          return(());
        }
      );
      new_var := Variable(
        id : old_var.id,
        name : old_var.name,
        ty : ty,
        is_compile_time_only : old_var.is_compile_time_only,
        frame_level : old_var.frame_level,
        value : Option(EvalValue).Some(val),
        is_owning_the_rc_value : old_var.is_owning_the_rc_value,
        is_owning_the_same_rc_value_as : old_var.is_owning_the_same_rc_value_as,
        is_reassignable : old_var.is_reassignable,
        token : old_var.token,
        initialized_at_token : old_var.initialized_at_token,
        consumed_at_token : old_var.consumed_at_token,
        is_implicit : old_var.is_implicit,
        is_created_from_destructuring_atom_variable : old_var.is_created_from_destructuring_atom_variable,
        parameter_alias : old_var.parameter_alias,
        is_from_effect_spread : old_var.is_from_effect_spread,
        is_effect_param : old_var.is_effect_param,
        is_module_level : old_var.is_module_level,
        doc_comment : old_var.doc_comment,
        is_ref : false,
        is_parameter : false
      );
      update_existing_variable(env, old_var, new_var);
    }
  );
});
// ---------------------------------------------------------------------------
// canAssignTypeHierarchy
// ---------------------------------------------------------------------------
/// Check if a given type hierarchy type can be assigned to an expected one.
/// Mirrors `canAssignTypeHierarchy` in TypeScript.
can_assign_type_hierarchy :: (fn(expected : TypeValue, given : TypeValue) -> bool)(
  match(
    expected,
    .TypeUni(exp_level) => match(
      given,
      .TypeUni(giv_level) => (giv_level == exp_level),
      _ => false
    ),
    _ => false
  )
);
// ---------------------------------------------------------------------------
// occursCheck (private)
// ---------------------------------------------------------------------------
/// Check if a SomeType (identified by `some_type_id`) occurs anywhere in `ty`.
/// Prevents infinite types like T = Option(T).
/// `visited` is a list of type IDs already being checked (prevents cycles).
/// Mirrors `occursCheck` in TypeScript.
_occurs_check :: (fn(some_type_id : String, some_type_name : String, ty : TypeValue, visited : ArrayList(String), exn : Exception) -> bool)({
  ty_id := synthesis_type_id(ty);
  // Prevent infinite recursion on cyclic types
  (found_visited : bool) = false;
  {
    vi := usize(0);
    n := visited.len();
    while((vi < n) && !(found_visited), {
      v := match(
        visited.get(vi),
        .Some(s) => s,
        .None => {
          vi = n;
          break;
        }
      );
      if(v == ty_id, {
        found_visited = true;
      });
      vi = (vi + usize(1));
    });
  };
  if(found_visited, {
    return(false);
  });
  visited.push(ty_id);
  match(
    ty,
    .SomeT(sid, _, _, _, _, _, _, _, _, _) => (some_type_id == sid),
    .Struct({ field_types }) => {
      (res : bool) = false;
      i := usize(0);
      while((i < field_types.len()) && !(res), {
        ft := match(
          field_types.get(i),
          .Some(t) => t,
          .None => {
            i = field_types.len();
            break;
          }
        );
        if(recur(some_type_id, some_type_name, ft, visited, exn), {
          res = true;
        });
        i = (i + usize(1));
      });
      res
    },
    .EnumT(_, _, _, variant_fields, _, _, _, _, _) => {
      (res : bool) = false;
      vi := usize(0);
      while((vi < variant_fields.len()) && !(res), {
        vf := match(
          variant_fields.get(vi),
          .Some(f) => f,
          .None => {
            vi = variant_fields.len();
            break;
          }
        );
        fi := usize(0);
        while((fi < vf.len()) && !(res), {
          ft := match(
            vf.get(fi),
            .Some(t) => t,
            .None => {
              fi = vf.len();
              break;
            }
          );
          if(recur(some_type_id, some_type_name, ft, visited, exn), {
            res = true;
          });
          fi = (fi + usize(1));
        });
        vi = (vi + usize(1));
      });
      res
    },
    .Tuple(_, field_types) => {
      (res : bool) = false;
      i := usize(0);
      while((i < field_types.len()) && !(res), {
        ft := match(
          field_types.get(i),
          .Some(t) => t,
          .None => {
            i = field_types.len();
            break;
          }
        );
        if(recur(some_type_id, some_type_name, ft, visited, exn), {
          res = true;
        });
        i = (i + usize(1));
      });
      res
    },
    .Array(elem, _, _) => recur(some_type_id, some_type_name, elem, visited, exn),
    .ComptimeListT(child) => recur(some_type_id, some_type_name, child, visited, exn),
    // Don't check inside pointer types (valid indirection)
    .Pointer(_) => false,
    .IsoT(child) => recur(some_type_id, some_type_name, child, visited, exn),
    .Func({ param_types, implicit_types, result, meta : __fm1 }) => {
      forall_labels := __fm1.*.forall_labels;
      // A forall declared by this Func's OWN signature SHADOWS the
      // searched variable: occurrences inside its params/return are
      // bound (alpha-renameable), not free occurrences. TS gets this
      // implicitly — each fn-type evaluation mints fresh SomeType ids,
      // so an embedded method signature never shares ids with the
      // call's foralls — but yo-self's value-typed struct copies
      // preserve ids: an `IoExn` struct embedding `Io.await :
      // fn(forall(T, E), …)` made `E := IoExn` a false infinite type
      // (std/http/client.yo). Within a Func that declares forall "E",
      // any SomeT named "E" lexically IS that inner forall, so
      // name-based shadowing is sound.
      //
      // The anonymous `Impl(...)` sugar wrapper is per-signature too: an
      // "Impl" SomeT reached THROUGH a nested Func is that Func's OWN
      // param/return sugar (`action : Impl(Fn(e : E) -> T)`), never the outer
      // var being unified. Same id-preservation trap: resolving a closure
      // bundle param to a concrete `IoExn` (which embeds `Io`'s method fields,
      // each `fn(forall(T,E), action : Impl(...)) -> Impl(...)`) made the outer
      // closure-wrapper "Impl" a FALSE infinite type. "Impl" is a reserved
      // sugar name (never a user var), so shadowing it inside a nested Func is
      // sound — mirrors the forall-label shadowing below.
      if(some_type_name == "Impl", {
        return(false);
      });
      {
        (sfi : usize) = usize(0);
        while(sfi < forall_labels.len(), {
          fl := match(
            forall_labels.get(sfi),
            .Some(l) => l,
            .None => {
              sfi = forall_labels.len();
              break;
            }
          );
          if(fl == some_type_name, {
            return(false);
          });
          sfi = (sfi + usize(1));
        });
      };
      (res : bool) = false;
      i := usize(0);
      while((i < param_types.len()) && !(res), {
        pt := match(
          param_types.get(i),
          .Some(t) => t,
          .None => {
            i = param_types.len();
            break;
          }
        );
        if(recur(some_type_id, some_type_name, pt, visited, exn), {
          res = true;
        });
        i = (i + usize(1));
      });
      if(!(res), {
        if(recur(some_type_id, some_type_name, result, visited, exn), {
          res = true;
        });
      });
      res
    },
    .FutureTraitT(_, out_box, _, ets, _) => {
      if(recur(some_type_id, some_type_name, out_box, visited, exn), {
        return(true);
      });
      (res : bool) = false;
      i := usize(0);
      while((i < ets.len()) && !(res), {
        et := match(
          ets.get(i),
          .Some(t) => t,
          .None => {
            i = ets.len();
            break;
          }
        );
        if(recur(some_type_id, some_type_name, et, visited, exn), {
          res = true;
        });
        i = (i + usize(1));
      });
      res
    },
    .FnTraitT(_, _, call_param_types, call_result, _, _, _) => {
      (res : bool) = false;
      i := usize(0);
      while((i < call_param_types.len()) && !(res), {
        pt := match(
          call_param_types.get(i),
          .Some(t) => t,
          .None => {
            i = call_param_types.len();
            break;
          }
        );
        if(recur(some_type_id, some_type_name, pt, visited, exn), {
          res = true;
        });
        i = (i + usize(1));
      });
      if(!(res), {
        if(recur(some_type_id, some_type_name, call_result, visited, exn), {
          res = true;
        });
      });
      res
    },
    .TypeAppT(constructor, args) => {
      if(recur(some_type_id, some_type_name, constructor, visited, exn), {
        return(true);
      });
      (res : bool) = false;
      i := usize(0);
      while((i < args.len()) && !(res), {
        arg := match(
          args.get(i),
          .Some(t) => t,
          .None => {
            i = args.len();
            break;
          }
        );
        if(recur(some_type_id, some_type_name, arg, visited, exn), {
          res = true;
        });
        i = (i + usize(1));
      });
      res
    },
    .TraitT(_, _, _, field_types, _, _, _, _) => {
      (res : bool) = false;
      i := usize(0);
      while((i < field_types.len()) && !(res), {
        ft := match(
          field_types.get(i),
          .Some(t) => t,
          .None => {
            i = field_types.len();
            break;
          }
        );
        if(recur(some_type_id, some_type_name, ft, visited, exn), {
          res = true;
        });
        i = (i + usize(1));
      });
      res
    },
    .Union(_, _, field_types) => {
      (res : bool) = false;
      i := usize(0);
      while((i < field_types.len()) && !(res), {
        ft := match(
          field_types.get(i),
          .Some(t) => t,
          .None => {
            i = field_types.len();
            break;
          }
        );
        if(recur(some_type_id, some_type_name, ft, visited, exn), {
          res = true;
        });
        i = (i + usize(1));
      });
      res
    },
    _ => false
  )
});
// ---------------------------------------------------------------------------
// synthesize_future_effects (private)
// ---------------------------------------------------------------------------
/// Extract the token from options (or make a synthetic one).
opts_token :: (fn(opts : Option(SynthesizeOptions), env : Environment) -> Option(Token))(
  match(opts,.Some(o) => o.token,.None => Option(Token).None)
);
/// Build an ArrayList(ImplicitEntry) from parallel arrays (with expansion
/// of resolved EffectsRowT spreads).
_expand_effects :: (
  fn(
    labels : ArrayList(String),
    types : ArrayList(TypeValue),
    spreads : ArrayList(bool)
  ) -> ArrayList(ImplicitEntry)
)({
  result := ArrayList(ImplicitEntry).new();
  n := labels.len();
  i := usize(0);
  while(i < n, {
    lbl := match(
      labels.get(i),
      .Some(s) => s,
      .None => {
        i = n;
        break;
      }
    );
    ty := match(
      types.get(i),
      .Some(t) => t,
      .None => {
        i = n;
        break;
      }
    );
    is_spr := match(spreads.get(i),.Some(b) => b,.None => false);
    if(is_spr && is_effects_row_type(ty), {
      // Solved spread — expand into concrete entries
      match(
        ty,
        .EffectsRowT(row_labels, row_types) => {
          ri := usize(0);
          while(ri < row_labels.len(), {
            rl := match(
              row_labels.get(ri),
              .Some(s) => s,
              .None => {
                ri = row_labels.len();
                break;
              }
            );
            rt := match(
              row_types.get(ri),
              .Some(t) => t,
              .None => {
                ri = row_labels.len();
                break;
              }
            );
            result.push(ImplicitEntry(label : rl, ty : rt, is_spread : false));
            ri = (ri + usize(1));
          });
        },
        _ => ()
      );
    }, {
      // Regular or unresolved spread — pass through
      if(!(is_spr), {
        result.push(ImplicitEntry(label : lbl, ty : ty, is_spread : is_spr));
      });
      // Unresolved SomeType spreads on given side are skipped
    });
    i = (i + usize(1));
  });
  result
});
/// Synthesize effects between two FutureTraitT or function implicit param lists.
/// Uses set-based matching with the "at most one unsolved spread" rule.
/// Mirrors `synthesizeFutureEffects` in TypeScript.
_synthesize_implicit_params :: (
  fn(
    expected_labels : ArrayList(String),
    expected_types : ArrayList(TypeValue),
    expected_spreads : ArrayList(bool),
    given_labels : ArrayList(String),
    given_types : ArrayList(TypeValue),
    given_spreads : ArrayList(bool),
    expected_env : Environment,
    given_env : Environment,
    checked : ArrayList(TypePair),
    opts : Option(SynthesizeOptions),
    exn : Exception
  ) -> unit
)({
  // Build ImplicitEntry lists
  concrete_expected := ArrayList(ImplicitEntry).new();
  solved_spreads := ArrayList(ImplicitEntry).new();
  unsolved_spreads := ArrayList(ImplicitEntry).new();
  n_exp := expected_labels.len();
  (ei : usize) = usize(0);
  while(ei < n_exp, {
    lbl := match(
      expected_labels.get(ei),
      .Some(s) => s,
      .None => {
        ei = n_exp;
        break;
      }
    );
    ty := match(
      expected_types.get(ei),
      .Some(t) => t,
      .None => {
        ei = n_exp;
        break;
      }
    );
    is_spr := match(expected_spreads.get(ei),.Some(b) => b,.None => false);
    entry := ImplicitEntry(label : lbl, ty : ty, is_spread : is_spr);
    cond(
      is_spr => {
        if(is_effects_row_type(ty), {
          solved_spreads.push(entry);
        }, {
          match(
            ty,
            .SomeT(_, _, _, _, _, _, _, _, is_er, _) => {
              if(is_er, {
                unsolved_spreads.push(entry);
              });
            },
            _ => ()
          );
        });
      },
      true => {
        concrete_expected.push(entry);
      }
    );
    ei = (ei + usize(1));
  });
  if(unsolved_spreads.len() > usize(1), {
    exn.throw(
      dyn(
        format_error_message(
          synthetic_token(String.from("E"), expected_env.module_path),
          String.from("Ambiguous effect row unification: multiple unsolved effect row variables. At most one effect row spread can be unsolved during type unification."),
          false,
          Option(ErrorKind).None
        )
      )
    );
  });
  // Collect given concrete entries (expand resolved spreads)
  given_concrete := _expand_effects(given_labels, given_types, given_spreads);
  n_giv := given_concrete.len();
  // Track matched indices on the given side
  matched_given := ArrayList(bool).new();
  {
    (mgi : usize) = usize(0);
    while(mgi < n_giv, {
      matched_given.push(false);
      mgi = (mgi + usize(1));
    });
  };
  // 1. Match concrete expected params against given (set-based by type id)
  n_ce := concrete_expected.len();
  matched_expected := ArrayList(bool).new();
  {
    (mei : usize) = usize(0);
    while(mei < n_ce, {
      matched_expected.push(false);
      mei = (mei + usize(1));
    });
  };
  (cei : usize) = usize(0);
  while(cei < n_ce, {
    exp := match(
      concrete_expected.get(cei),
      .Some(e) => e,
      .None => {
        cei = n_ce;
        break;
      }
    );
    exp_id := synthesis_type_id(exp.ty);
    (gj : usize) = usize(0);
    while(gj < n_giv, {
      already_matched := match(matched_given.get(gj),.Some(b) => b,.None => false);
      if(!(already_matched), {
        giv := match(
          given_concrete.get(gj),
          .Some(g) => g,
          .None => {
            gj = n_giv;
            break;
          }
        );
        if(exp_id == synthesis_type_id(giv.ty), {
          res := _synthesize_call(exp.ty, expected_env, giv.ty, given_env, checked, opts, exn);
          expected_env.frames = res.expected_env.frames;
          expected_env.module_path = res.expected_env.module_path;
          expected_env.function_declaration_frame_level = res.expected_env.function_declaration_frame_level;
          expected_env.input_string = res.expected_env.input_string;
          given_env.frames = res.given_env.frames;
          given_env.module_path = res.given_env.module_path;
          given_env.function_declaration_frame_level = res.given_env.function_declaration_frame_level;
          given_env.input_string = res.given_env.input_string;
          matched_given(gj) = true;
          matched_expected(cei) = true;
          gj = n_giv; // break
        });
      });
      gj = (gj + usize(1));
    });
    cei = (cei + usize(1));
  });
  // 2. Match solved spreads' expanded effects against given
  n_ss := solved_spreads.len();
  (ssi : usize) = usize(0);
  while(ssi < n_ss, {
    spread := match(
      solved_spreads.get(ssi),
      .Some(s) => s,
      .None => {
        ssi = n_ss;
        break;
      }
    );
    expanded := match(
      spread.ty,
      .EffectsRowT(row_labels, row_types) => {
        r := ArrayList(ImplicitEntry).new();
        ri := usize(0);
        while(ri < row_labels.len(), {
          rl := match(
            row_labels.get(ri),
            .Some(s) => s,
            .None => {
              ri = row_labels.len();
              break;
            }
          );
          rt := match(
            row_types.get(ri),
            .Some(t) => t,
            .None => {
              ri = row_labels.len();
              break;
            }
          );
          r.push(ImplicitEntry(label : rl, ty : rt, is_spread : false));
          ri = (ri + usize(1));
        });
        r
      },
      _ => ArrayList(ImplicitEntry).new()
    );
    n_exp_effects := expanded.len();
    (eei : usize) = usize(0);
    while(eei < n_exp_effects, {
      exp := match(
        expanded.get(eei),
        .Some(e) => e,
        .None => {
          eei = n_exp_effects;
          break;
        }
      );
      exp_id := synthesis_type_id(exp.ty);
      (gj : usize) = usize(0);
      while(gj < n_giv, {
        already_matched := match(matched_given.get(gj),.Some(b) => b,.None => false);
        if(!(already_matched), {
          giv := match(
            given_concrete.get(gj),
            .Some(g) => g,
            .None => {
              gj = n_giv;
              break;
            }
          );
          if(exp_id == synthesis_type_id(giv.ty), {
            res := _synthesize_call(exp.ty, expected_env, giv.ty, given_env, checked, opts, exn);
            expected_env.frames = res.expected_env.frames;
            expected_env.module_path = res.expected_env.module_path;
            expected_env.function_declaration_frame_level = res.expected_env.function_declaration_frame_level;
            expected_env.input_string = res.expected_env.input_string;
            given_env.frames = res.given_env.frames;
            given_env.module_path = res.given_env.module_path;
            given_env.function_declaration_frame_level = res.given_env.function_declaration_frame_level;
            given_env.input_string = res.given_env.input_string;
            matched_given(gj) = true;
            gj = n_giv; // break
          });
        });
        gj = (gj + usize(1));
      });
      eei = (eei + usize(1));
    });
    ssi = (ssi + usize(1));
  });
  // Verify all concrete expected params were matched before binding the spread
  if(unsolved_spreads.len() == usize(1), {
    (matched_exp_count : usize) = usize(0);
    (mci : usize) = usize(0);
    while(mci < matched_expected.len(), {
      b := match(matched_expected.get(mci),.Some(v) => v,.None => false);
      if(b, {
        matched_exp_count = (matched_exp_count + usize(1));
      });
      mci = (mci + usize(1));
    });
    if(matched_exp_count < n_ce, {
      exn.throw(
        dyn(
          format_error_message(
            synthetic_token(String.from("E"), expected_env.module_path),
            String.from("Effect row unification failed: some expected effects not found in given implicit parameters."),
            false,
            Option(ErrorKind).None
          )
        )
      );
    });
  });
  // 3. Bind the single unsolved spread to remaining unmatched given params
  if(unsolved_spreads.len() == usize(1), {
    unsolved := match(
      unsolved_spreads.get(usize(0)),
      .Some(u) => u,
      .None => {
        return(());
      }
    );
    match(
      unsolved.ty,
      .SomeT(_, sname, _, _, _, _, _, _, is_er, _) => {
        if(is_er, {
          // Collect remaining unmatched given entries
          remaining_labels := ArrayList(String).new();
          remaining_types := ArrayList(TypeValue).new();
          (ri : usize) = usize(0);
          while(ri < n_giv, {
            already := match(matched_given.get(ri),.Some(b) => b,.None => false);
            if(!(already), {
              giv := match(
                given_concrete.get(ri),
                .Some(g) => g,
                .None => {
                  ri = n_giv;
                  break;
                }
              );
              remaining_labels.push(giv.label);
              remaining_types.push(giv.ty);
            });
            ri = (ri + usize(1));
          });
          effects_row := t_effects_row(remaining_labels, remaining_types);
          type_val := EvalValue.TypeVal(effects_row);
          _bind_some_type(expected_env, sname, type_val, TypeValue.TypeUni(usize(1)), opts_token(opts, expected_env), exn);
        });
      },
      _ => ()
    );
  });
});
// ---------------------------------------------------------------------------
// Private helpers for FnTrait and FutureTrait synthesis
// ---------------------------------------------------------------------------
/// Synthesize two FnTraitT types.
_synthesize_fn_traits :: (
  fn(
    expected_ty : TypeValue,
    expected_env : Environment,
    given_ty : TypeValue,
    given_env : Environment,
    checked : ArrayList(TypePair),
    opts : Option(SynthesizeOptions),
    exn : Exception
  ) -> SynthesizeResult
)({
  // Either side may be a `Func` rather than an `FnTraitT`: this helper also
  // synthesizes an `Impl(Fn(...))` (FnTraitT) against a concrete closure `Func`
  // (see the caller guard `is_fn_trait_type(exp_trait) && is_function_type(given)`
  // and the doc note below). TS converts the FnTraitT to its `isFn.callType`
  // (a Func) and runs Func-vs-Func synthesis (synthesizer.ts:516-523); the
  // value-space equivalent is to read params/result from whichever shape each
  // side is. Without the `.Func` arms, a `Func` given fell to `TypeValue.Unit`
  // for its result, so `Impl(Fn(e : E) -> T)` vs `fn(e : IoExn) -> i32` bound
  // the io.async forall `T = unit` (→ later `Future(unit,E)` vs
  // `Future(i32,IoExn)` "Cannot unify unit and i32").
  exp_params := match(
    expected_ty,
    .FnTraitT(_, _, pts, _, _, _, _) => pts,
    .Func({ param_types : pts }) => pts,
    _ => ArrayList(TypeValue).new()
  );
  giv_params := match(
    given_ty,
    .FnTraitT(_, _, pts, _, _, _, _) => pts,
    .Func({ param_types : pts }) => pts,
    _ => ArrayList(TypeValue).new()
  );
  exp_result := match(
    expected_ty,
    .FnTraitT(_, _, _, r, _, _, _) => r,
    .Func({ result : r }) => r,
    _ => TypeValue.Unit
  );
  giv_result := match(
    given_ty,
    .FnTraitT(_, _, _, r, _, _, _) => r,
    .Func({ result : r }) => r,
    _ => TypeValue.Unit
  );
  (ee : Environment) = expected_env;
  (ge : Environment) = given_env;
  n := exp_params.len();
  (i : usize) = usize(0);
  while(i < n, {
    et := match(
      exp_params.get(i),
      .Some(t) => t,
      .None => {
        i = n;
        break;
      }
    );
    gt := match(
      giv_params.get(i),
      .Some(t) => t,
      .None => {
        i = n;
        break;
      }
    );
    res := _synthesize_call(et, ee, gt, ge, checked, opts, exn);
    ee = res.expected_env;
    ge = res.given_env;
    i = (i + usize(1));
  });
  // Synthesize return type
  res2 := _synthesize_call(exp_result, ee, giv_result, ge, checked, opts, exn);
  ee = res2.expected_env;
  ge = res2.given_env;
  SynthesizeResult(expected_env : ee, given_env : ge)
});
/// Also handles Func + FnTraitT when given_ty is a Func.
/// (When `given_ty` is a Func, the FnTraitT's call type is synthesized against it.)
_synthesize_future_traits :: (
  fn(
    expected_ty : TypeValue,
    expected_env : Environment,
    given_ty : TypeValue,
    given_env : Environment,
    checked : ArrayList(TypePair),
    opts : Option(SynthesizeOptions),
    exn : Exception
  ) -> SynthesizeResult
)({
  exp_out := match(expected_ty,.FutureTraitT(_, out, _, _, _) => out, _ => TypeValue.Unit);
  giv_out := match(given_ty,.FutureTraitT(_, out, _, _, _) => out, _ => TypeValue.Unit);
  (ee : Environment) = expected_env;
  (ge : Environment) = given_env;
  res := _synthesize_call(exp_out, ee, giv_out, ge, checked, opts, exn);
  ee = res.expected_env;
  ge = res.given_env;
  // Synthesize effects
  exp_el := match(expected_ty,.FutureTraitT(_, _, els, _, _) => els, _ => ArrayList(String).new());
  exp_et := match(expected_ty,.FutureTraitT(_, _, _, ets, _) => ets, _ => ArrayList(TypeValue).new());
  exp_es := match(expected_ty,.FutureTraitT(_, _, _, _, ess) => ess, _ => ArrayList(bool).new());
  giv_el := match(given_ty,.FutureTraitT(_, _, els, _, _) => els, _ => ArrayList(String).new());
  giv_et := match(given_ty,.FutureTraitT(_, _, _, ets, _) => ets, _ => ArrayList(TypeValue).new());
  giv_es := match(given_ty,.FutureTraitT(_, _, _, _, ess) => ess, _ => ArrayList(bool).new());
  _synthesize_implicit_params(
    exp_el,
    exp_et,
    exp_es,
    giv_el,
    giv_et,
    giv_es,
    ee,
    ge,
    checked,
    opts,
    exn
  );
  SynthesizeResult(expected_env : ee, given_env : ge)
});
// ---------------------------------------------------------------------------
// synthesize_types (public, recursive)
// ---------------------------------------------------------------------------
/// Actual implementation of type unification.
/// Called only through the dispatch wrapper `synthesize_types`.
/// Mirrors `synthesizeTypes` in `src/evaluator/types/synthesizer.ts`.
///
/// Parameters:
///   expected_ty, expected_env — the "pattern" side (may contain SomeTypes).
///   given_ty, given_env       — the "actual value" side.
///   checked   — anti-circularity pairs (thread through all recursive calls).
///   opts      — optional options (set_resolved_concrete_type, token).
_synthesize_types_impl :: (
  fn(
    expected_ty : TypeValue,
    expected_env : Environment,
    given_ty : TypeValue,
    given_env : Environment,
    checked : ArrayList(TypePair),
    opts : Option(SynthesizeOptions),
    exn : Exception
  ) -> SynthesizeResult
)({
  exp_id := synthesis_type_id(expected_ty);
  (ee : Environment) = expected_env;
  (ge : Environment) = given_env;
  giv_id := synthesis_type_id(given_ty);
  // Anti-circularity check
  if(_has_type_pair(checked, exp_id, giv_id), {
    return(SynthesizeResult(expected_env : ee, given_env : ge));
  });
  checked.push(TypePair(expected_id : exp_id, given_id : giv_id));
  tok := opts_token(opts, ee);
  // Case: both are SomeTypes
  if(is_some_type(expected_ty) && is_some_type(given_ty), {
    expected_bound := get_value_of_some_type_from_env(ee, expected_ty);
    given_bound := get_value_of_some_type_from_env(ge, given_ty);
    exp_some_id := match(expected_ty,.SomeT(id, _, _, _, _, _, _, _, _, _) => id, _ => ``);
    giv_some_id := match(given_ty,.SomeT(id, _, _, _, _, _, _, _, _, _) => id, _ => ``);
    exp_bound_is_some := is_some_type(expected_bound);
    giv_bound_is_some := is_some_type(given_bound);
    cond(
      !(exp_bound_is_some) => {
        // Expected is bound — use its value to bind given
        val := EvalValue.TypeVal(expected_bound);
        _bind_some_type(ge, match(given_ty,.SomeT(_, n, _, _, _, _, _, _, _, _) => n, _ => ``), val, expected_bound, tok, exn);
      },
      !(giv_bound_is_some) => {
        // Given is bound — use its value to bind expected
        val := EvalValue.TypeVal(given_bound);
        _bind_some_type(ee, match(expected_ty,.SomeT(_, n, _, _, _, _, _, _, _, _) => n, _ => ``), val, given_bound, tok, exn);
      },
      (exp_some_id == giv_some_id) => (),
      // Same SomeType — nothing to do
      true => {
        // Both unbound — bind expected to given.type (given is the unification target)
        val := EvalValue.TypeVal(given_ty);
        _bind_some_type(ee, match(expected_ty,.SomeT(_, n, _, _, _, _, _, _, _, _) => n, _ => ``), val, given_ty, tok, exn);
        val2 := EvalValue.TypeVal(given_ty);
        _bind_some_type(ge, match(given_ty,.SomeT(_, n, _, _, _, _, _, _, _, _) => n, _ => ``), val2, given_ty, tok, exn);
      }
    );
    // After unifying, recursively synthesize required trait type parameters
    if(exp_some_id != giv_some_id, {
      match(
        expected_ty,
        .SomeT(_, _, _, _, expected_traits, _, _, _, _, _) => {
          match(
            given_ty,
            .SomeT(_, _, _, _, given_traits, _, _, _, _, _) => {
              n_et := expected_traits.len();
              (eti : usize) = usize(0);
              while(eti < n_et, {
                exp_trait := match(
                  expected_traits.get(eti),
                  .Some(t) => t,
                  .None => {
                    eti = n_et;
                    break;
                  }
                );
                cond(
                  is_fn_trait_type(exp_trait) => {
                    // Find matching Fn trait in given_traits
                    (fi : usize) = usize(0);
                    while(fi < given_traits.len(), {
                      giv_trait := match(
                        given_traits.get(fi),
                        .Some(t) => t,
                        .None => {
                          fi = given_traits.len();
                          break;
                        }
                      );
                      if(is_fn_trait_type(giv_trait), {
                        res := _synthesize_fn_traits(exp_trait, ee, giv_trait, ge, checked, opts, exn);
                        ee = res.expected_env;
                        ge = res.given_env;
                        fi = given_traits.len(); // break
                      });
                      fi = (fi + usize(1));
                    });
                  },
                  is_future_trait_type(exp_trait) => {
                    // Find matching Future trait in given_traits
                    (fi : usize) = usize(0);
                    while(fi < given_traits.len(), {
                      giv_trait := match(
                        given_traits.get(fi),
                        .Some(t) => t,
                        .None => {
                          fi = given_traits.len();
                          break;
                        }
                      );
                      if(is_future_trait_type(giv_trait), {
                        res := _synthesize_future_traits(exp_trait, ee, giv_trait, ge, checked, opts, exn);
                        ee = res.expected_env;
                        ge = res.given_env;
                        fi = given_traits.len(); // break
                      });
                      fi = (fi + usize(1));
                    });
                  },
                  true => ()
                );
                eti = (eti + usize(1));
              });
            },
            _ => ()
          );
        },
        _ => ()
      );
    });
    return(SynthesizeResult(expected_env : ee, given_env : ge));
  });
  // Case: expected is SomeType (given may be concrete)
  if(is_some_type(expected_ty), {
    bound := get_value_of_some_type_from_env(ee, expected_ty);
    exp_id2 := match(expected_ty,.SomeT(id, _, _, _, _, _, _, _, _, _) => id, _ => ``);
    exp_name := match(expected_ty,.SomeT(_, n, _, _, _, _, _, _, _, _) => n, _ => ``);
    exp_traits := match(expected_ty,.SomeT(_, _, _, _, rts, _, _, _, _, _) => rts, _ => ArrayList(TypeValue).new());
    if(is_some_type(bound) && (match(bound,.SomeT(bid, _, _, _, _, _, _, _, _, _) => (bid == exp_id2), _ => false)), {
      // Unbound — bind to given_ty
      // Occurs check
      {
        visited := ArrayList(String).new();
        if(_occurs_check(exp_id2, exp_name, given_ty, visited, exn), {
          exn.throw(
            dyn(
              format_error_message(
                synthetic_token(exp_name, ee.module_path),
                `Cannot unify type variable "${exp_name}" with type "${type_to_string(given_ty)}" because it would create an infinite type.`,
                false,
                Option(ErrorKind).None
              )
            )
          );
          return(SynthesizeResult(expected_env : ee, given_env : ge));
        });
      };
      val := EvalValue.TypeVal(given_ty);
      _bind_some_type(ee, exp_name, val, given_ty, tok, exn);
      // Phase 5: record the resolved CONCRETE type for this SomeT (keyed by id)
      // in the side-table when the caller asked for it. Mirrors
      // synthesizer.ts:463 (`expected.type.resolvedConcreteType = given.type` when
      // `options.setResolvedConcreteType`); yo-self has no SomeT field, so the
      // `g_some_resolved_concrete` registry stands in (read by the async-Future /
      // FSM codegen). Inert until the FSM readers land.
      if(match(opts,.Some(o) => o.set_resolved_concrete_type,.None => false), {
        register_some_resolved_concrete(exp_id2, given_ty);
      });
      // Recursively synthesize required trait type parameters
      n_et := exp_traits.len();
      (eti : usize) = usize(0);
      while(eti < n_et, {
        exp_trait := match(
          exp_traits.get(eti),
          .Some(t) => t,
          .None => {
            eti = n_et;
            break;
          }
        );
        cond(
          (is_fn_trait_type(exp_trait) && is_function_type(given_ty)) => {
            res := _synthesize_fn_traits(exp_trait, ee, given_ty, ge, checked, opts, exn);
            ee = res.expected_env;
            ge = res.given_env;
          },
          (is_future_trait_type(exp_trait) && is_future_trait_type(given_ty)) => {
            res := _synthesize_future_traits(exp_trait, ee, given_ty, ge, checked, opts, exn);
            ee = res.expected_env;
            ge = res.given_env;
          },
          true => ()
        );
        eti = (eti + usize(1));
      });
    }, {
      if(!(is_some_type(bound)), {
        // Bound to a concrete type — recurse with the bound type
        res := _synthesize_call(bound, ee, given_ty, ge, checked, opts, exn);
        ee = res.expected_env;
        ge = res.given_env;
      });
    });
    return(SynthesizeResult(expected_env : ee, given_env : ge));
  });
  // Case: given is SomeType (expected is concrete)
  if(is_some_type(given_ty), {
    existing_bound := get_value_of_some_type_from_env(ge, given_ty);
    giv_id2 := match(given_ty,.SomeT(id, _, _, _, _, _, _, _, _, _) => id, _ => ``);
    giv_name := match(given_ty,.SomeT(_, n, _, _, _, _, _, _, _, _) => n, _ => ``);
    if(!(is_some_type(existing_bound)), {
      // Given is already bound — recurse
      res := _synthesize_call(expected_ty, ee, existing_bound, ge, checked, opts, exn);
      ee = res.expected_env;
      ge = res.given_env;
    }, {
      // Occurs check
      {
        visited := ArrayList(String).new();
        if(_occurs_check(giv_id2, giv_name, expected_ty, visited, exn), {
          exn.throw(
            dyn(
              format_error_message(
                synthetic_token(giv_name, ge.module_path),
                `Cannot unify type variable "${giv_name}" with type "${type_to_string(expected_ty)}" because it would create an infinite type.`,
                false,
                Option(ErrorKind).None
              )
            )
          );
          return(SynthesizeResult(expected_env : ee, given_env : ge));
        });
      };
      val := EvalValue.TypeVal(expected_ty);
      _bind_some_type(ge, giv_name, val, expected_ty, tok, exn);
      // Phase 5 (symmetric set-site): record the given SomeT's resolved concrete
      // type (the expected concrete) in the side-table. Mirrors synthesizer.ts:595
      // (`given.type.resolvedConcreteType = expected.type` under
      // `setResolvedConcreteType`). Keyed by the given SomeT's id.
      if(match(opts,.Some(o) => o.set_resolved_concrete_type,.None => false), {
        register_some_resolved_concrete(giv_id2, expected_ty);
      });
    });
    return(SynthesizeResult(expected_env : ee, given_env : ge));
  });
  // Case: Tuple
  if(is_tuple_type(expected_ty) && is_tuple_type(given_ty), {
    exp_fields := match(expected_ty,.Tuple(_, fts) => fts, _ => ArrayList(TypeValue).new());
    giv_fields := match(given_ty,.Tuple(_, fts) => fts, _ => ArrayList(TypeValue).new());
    if(exp_fields.len() != giv_fields.len(), {
      exn.throw(
        dyn(
          format_error_message(
            synthetic_token(String.from("tuple"), ee.module_path),
            `Cannot unify incompatible tuple types: "${type_to_string(expected_ty)}" and "${type_to_string(given_ty)}"`,
            false,
            Option(ErrorKind).None
          )
        )
      );
    }, {
      n := exp_fields.len();
      (i : usize) = usize(0);
      while(i < n, {
        et := match(
          exp_fields.get(i),
          .Some(t) => t,
          .None => {
            i = n;
            break;
          }
        );
        gt := match(
          giv_fields.get(i),
          .Some(t) => t,
          .None => {
            i = n;
            break;
          }
        );
        res := _synthesize_call(et, ee, gt, ge, checked, opts, exn);
        ee = res.expected_env;
        ge = res.given_env;
        i = (i + usize(1));
      });
    });
