open(import("std/string"));
{ AstExpr, ast_expr_token, make_err_expr } :: import("../../expr/expr.yo");
{ Environment }                            :: import("../../env/env.yo");
{ EvalContext }                            :: import("../context.yo");
{ Exception }                              :: import("std/error");
{ evaluate_struct_type }                   :: import("./struct.yo");

evaluate_object_type :: (fn(
  expr         : AstExpr,
  env          : Environment,
  ctx          : *(EvalContext),
  is_atomic_rc : bool,
  using(exn : Exception)
) -> AstExpr)(
  evaluate_struct_type(expr, env, ctx, is_atomic_rc, using(exn))
);

export(evaluate_object_type);
