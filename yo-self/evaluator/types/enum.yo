//! evaluate_enum_type — evaluates an `enum(...)` type expression.
//!
//! 1:1 port of `src/evaluator/types/enum.ts`.
//!
//! Builds a `TypeValue.EnumT` with variant names, fields, field labels, and
//! discriminants. Supports:
//!   - Simple atom variants:                 `Red`
//!   - Atom variants with discriminant:       `Red = 1`
//!   - Variants with fields:                  `Some(T)`
//!   - Variants with fields + discriminant:   `Some(T) = 5`
//!   - Discriminants are auto-assigned (one more than previous, starting at 0)
//!
//! RC + trait derivation (mirrors `struct.yo`):
//!   - Trait MARKERS (Send/Acyclic/Comptime/Runtime) are auto-derived by
//!     `auto_derive_traits_for_enum_type` after variant evaluation.
//!   - RC functions (___drop/___dup) for reference-semantics enums
//!     (`ref(enum(…))`) are lowered DIRECTLY in codegen (drop_dup.yo), like ref
//!     structs — TS's evaluator-side ___drop/___dup method synthesis mutates
//!     `SelfType.trait.fields`, which yo-self's value-enum TypeValue lacks (see
//!     [[yo-self-typevalue-enum-interning]]); the direct lowering is equivalent.
//!   - GADT enums are supported (see the GADT detection + gadt_registry below).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_ENUM,
  BK_ASSIGN,
  BK_CONST,
  BF_RECUR
} :: import("../../expr.yo");
{ new_expr_info, expr_info_table_get, expr_info_table_set } :: import("../../expr_info.yo");
{ Environment, get_variables_from_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_type_value, is_type_value } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, register_enum_final, _patch_self_shell } :: import("../../types/creators.yo");
{ is_comptime_int_type, is_type_0 } :: import("../../types/guards.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ TypeField, EvalTypeFieldResult, evaluate_type_field } :: import("./field.yo");
{ parse_raw_int } :: import("../utils.yo");
{ random_id } :: import("../../utils.yo");
{ is_valid_variable_name } :: import("../utils.yo");
{ evaluate_expression, evaluate_expression_raw } :: import("../exprs/expr.yo");
{ ArrayList } :: import("std/collections/array_list");
{ auto_derive_traits_for_enum_type } :: import("./utils.yo");
{ register_gadt_enum, register_gadt_type_constructor_args } :: import("./gadt_registry.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
/// Get the args of a FnCall expression (empty for non-FnCall).
_fn_call_args :: (fn(e : AstExpr) -> ArrayList(AstExpr))(
  match(e,.FnCall(_, _, a, _, _) => a,.Atom(_, _) => ArrayList(AstExpr).new())
);
/// Get the func expression of a FnCall (or the expr itself for Atom).
_fn_call_func :: (fn(e : AstExpr) -> AstExpr)(
  match(e,.FnCall(_, fb, _, _, _) => fb,.Atom(_, _) => e)
);
/// Check if `variant_names` contains `name`.
_has_variant :: (fn(variant_names : ArrayList(String), name : String) -> bool)({
  i := usize(0);
  (found : bool) = false;
  while((i < variant_names.len()) && !(found), {
    match(
      variant_names.get(i),
      .Some(vn) => if(vn == name, {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Evaluate a discriminant expression and return its integer value (or throw).
_evaluate_discriminant :: (
  fn(
    discriminant_expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> i64
)({
  evaluated_disc := evaluate_expression_raw(discriminant_expr, env_in, ctx, exn);
  disc_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_disc));
  disc_info := match(
    disc_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(discriminant_expr),
            `Failed to evaluate discriminant value: ${ast_expr_to_string(discriminant_expr)}`,
            false,
            .None
          )
        )
      );
      new_expr_info(env_in, TypeValue.Unit)
    }
  );
  if(disc_info.value.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(discriminant_expr),
          `Failed to evaluate discriminant value: ${ast_expr_to_string(discriminant_expr)}`,
          false,
          .None
        )
      )
    );
  });
  // Must be a comptime integer.
  is_int_lit_val := match(
    disc_info.value,
    .Some(v) => match(v,.IntLit(_) => true, _ => false),
    .None => false
  );
  if(!(is_int_lit_val) && !(is_comptime_int_type(disc_info.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(discriminant_expr),
          `Enum discriminant must be a compile-time integer, got: ${ast_expr_to_string(discriminant_expr)}`,
          false,
          .None
        )
      )
    );
  });
  if(!(is_int_lit_val), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(discriminant_expr),
          `Enum discriminant must be a compile-time known value, got: ${ast_expr_to_string(discriminant_expr)}`,
          false,
          .None
        )
      )
    );
  });
  raw := match(
    disc_info.value,
    .Some(v) => match(v,.IntLit(r) => r, _ => String.from("0")),
    .None => String.from("0")
  );
  match(
    parse_raw_int(raw),
    .Some(n) => n,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(discriminant_expr),
            `Failed to parse discriminant integer value: ${raw}`,
            false,
            .None
          )
        )
      );
      i64(0)
    }
  )
});
// ---------------------------------------------------------------------------
// evaluate_enum_type
// ---------------------------------------------------------------------------
evaluate_enum_type :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    is_atomic_rc : bool,
    force_reference_semantics : bool,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  if(!(ast_expr_is_fn_call_of(expr, BK_ENUM, Option(usize).None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "enum", got:\n${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  // DECLARATION-STABLE id at module level (ctfe_depth == 0): every
  // re-evaluation GENERATION of the same declaration node shares one enum
  // identity, so shells/finals/instantiation memo entries unify across
  // generations (SomeT surgery slice 2 — the cross-generation split minted a
  // fresh enum id per generation, splitting Box(Self)/ArrayList(Self)
  // instantiations into per-generation C types; the recursive-enum
  // construct+drop heap corruption). Inside CTFE (generic constructor
  // instantiation), ids stay eval-fresh: Option(i32) vs Option(String)
  // evaluate the same enum body and must NOT share identity (the recorded
  // tk2/Bucket failure of the unconditional ast-id swap).
  enum_id := if(
    ctx.ctfe_depth == usize(0),
    `enum_decl_${ast_expr_id(expr).to_string()}_${env.module_path.replace(String.from("/"), String.from("_")).replace(String.from("."), String.from("_")).replace(String.from(":"), String.from("_"))}`,
    `enum_${random_id(env.module_path)}`
  );
  // Preliminary EnumT (empty variants) used as SelfType during field evaluation
  // so self-referential variants like `Some(Self)` work. The shell carries a
  // DISTINCT id: sharing the final's id made EXACT type comparison — the
  // CTFE cache key — conflate `Option(shell)` with `Option(final)`, so
  // def-time instantiations that captured the empty shell were returned
  // for post-definition lookups of the real enum (std/encoding/json.yo).
  shell_id := `${enum_id}__self_shell`;
  prelim_ty := TypeValue.EnumT(
    shell_id.clone(),
    String.from(""),
    ArrayList(String).new(),
    ArrayList(ArrayList(TypeValue)).new(),
    Option(String).None,
    ArrayList(ArrayList(String)).new(),
    ArrayList(i64).new(),
    force_reference_semantics,
    is_atomic_rc
  );
  // Temporarily set SelfType in context for field evaluation.
  old_self_type := ctx.self_type;
  ctx.self_type = Option(TypeValue).Some(prelim_ty);
  // (No evaluator-side RC-method synthesis here — see the file header: RC
  // drop/dup for reference-semantics enums is lowered directly in codegen.)
  // Accumulators for variants.
  variant_names := ArrayList(String).new();
  variant_fields := ArrayList(ArrayList(TypeValue)).new();
  variant_field_labels := ArrayList(ArrayList(String)).new();
  variant_discriminants := ArrayList(i64).new();
  // GADT: per-variant `-> recur(T…)` return-type args, parallel to variant
  // order. An empty inner list marks a non-GADT variant. `any_gadt` mirrors
  // `EnumType.isGadt`. Recorded in the gadt_registry side-table at the end.
  all_variant_gadt_args := ArrayList(ArrayList(TypeValue)).new();
  (any_gadt : bool) = false;
  // Track the next auto-assigned discriminant.
  (next_discriminant : i64) = i64(0);
  args := _fn_call_args(expr);
  (i : usize) = usize(0);
  while(i < args.len(), {
    enum_arg := match(args.get(i),.Some(a) => a,.None => make_err_expr());
    // -------------------------------------------------------------------
    // GADT detection. Detect `Variant -> recur(T…)` or
    // `(Variant -> recur(T…)) = disc`, capture the `recur(...)` return-type
    // expression in `gadt_ret`, and rewrite `enum_arg` to the bare variant so
    // the normal variant-building `cond` below runs unchanged. Mirrors
    // `enum.ts:61-85`.
    // -------------------------------------------------------------------
    is_gadt_arrow := ast_expr_is_fn_call_of(enum_arg, "->", Option(usize).Some(usize(2)));
    is_gadt_eq_arrow := if(ast_expr_is_fn_call_of(enum_arg, BK_ASSIGN, Option(usize).Some(usize(2))), {
      eq_args := _fn_call_args(enum_arg);
      lhs_eq := match(eq_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
      ast_expr_is_fn_call_of(lhs_eq, "->", Option(usize).Some(usize(2)))
    }, false);
    (gadt_ret : Option(AstExpr)) = Option(AstExpr).None;
    if(is_gadt_arrow, {
      arrow_args := _fn_call_args(enum_arg);
      gadt_ret = Option(AstExpr).Some(match(arrow_args.get(usize(1)),.Some(a) => a,.None => make_err_expr()));
      enum_arg = match(arrow_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
    }, {
      if(is_gadt_eq_arrow, {
        eq_args := _fn_call_args(enum_arg);
        arrow_e := match(eq_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
        arrow_args := _fn_call_args(arrow_e);
        gadt_ret = Option(AstExpr).Some(match(arrow_args.get(usize(1)),.Some(a) => a,.None => make_err_expr()));
        arrow_lhs := match(arrow_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
        eq_disc := match(eq_args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
        // Reconstruct the `=` node stripped of the `->` wrapper (mirrors TS's
        // `{...outerFnCall, args:[arrow.args[0], outer.args[1]]}`).
        enum_arg = match(
          enum_arg,
          .FnCall(fid, ffunc, _, finfix, ftok) => {
            new_args := ArrayList(AstExpr).new();
            new_args.push(arrow_lhs);
            new_args.push(eq_disc);
            AstExpr.FnCall(fid, ffunc, new_args, finfix, ftok)
          },
          .Atom(_, _) => enum_arg
        );
      });
    });
    // -------------------------------------------------------------------
    // Atom variant with discriminant: `VariantName = value`
    // -------------------------------------------------------------------
    is_atom_eq := if(ast_expr_is_fn_call(enum_arg) && ast_expr_is_fn_call_of(enum_arg, BK_ASSIGN, Option(usize).Some(usize(2))), {
      eq_args := _fn_call_args(enum_arg);
      lhs_eq := match(eq_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
      ast_expr_is_atom(lhs_eq)
    }, false);
    cond(
      is_atom_eq => {
        eq_args := _fn_call_args(enum_arg);
        variant_name_expr := match(eq_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
        discriminant_expr := match(eq_args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
        if(!(is_valid_variable_name(variant_name_expr)), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(variant_name_expr),
                `Expected identifier for enum variant, got:\n${ast_expr_to_string(variant_name_expr)}`,
                false,
                .None
              )
            )
          );
        });
        variant_name := ast_expr_token(variant_name_expr).value;
        if(_has_variant(variant_names, variant_name.clone()), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(variant_name_expr),
                `Duplicate variant name "${variant_name}" in enum`,
                false,
                .None
              )
            )
          );
        });
        disc := _evaluate_discriminant(discriminant_expr, env, ctx, exn);
        variant_names.push(variant_name.clone());
        variant_fields.push(ArrayList(TypeValue).new());
        variant_field_labels.push(ArrayList(String).new());
        variant_discriminants.push(disc);
        next_discriminant = (disc + i64(1));
      },
      // ---------------------------------------------------------------
      // `::` or `?=` — comptime-field syntax not allowed in enum.
      // ---------------------------------------------------------------
      (
        ast_expr_is_fn_call(enum_arg) &&
          (
            ast_expr_is_fn_call_of(enum_arg, BK_CONST, Option(usize).Some(usize(2))) ||
              ast_expr_is_fn_call_of(enum_arg, "?=", Option(usize).Some(usize(2)))
          )
      ) => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(enum_arg),
              String.from("Please use \"impl\" block to define members/methods for enum types."),
              false,
              .None
            )
          )
        );
      },
      // ---------------------------------------------------------------
      // Plain atom variant (auto-assigned discriminant).
      // ---------------------------------------------------------------
      ast_expr_is_atom(enum_arg) => {
        variant_name := ast_expr_token(enum_arg).value;
        if(!(is_valid_variable_name(enum_arg)), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(enum_arg),
                `Expected identifier for enum variant, got:\n${ast_expr_to_string(enum_arg)}`,
                false,
                .None
              )
            )
          );
        });
        if(_has_variant(variant_names, variant_name.clone()), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(enum_arg),
                `Duplicate variant name "${variant_name}" in enum`,
                false,
                .None
              )
            )
          );
        });
        variant_names.push(variant_name.clone());
        variant_fields.push(ArrayList(TypeValue).new());
        variant_field_labels.push(ArrayList(String).new());
        variant_discriminants.push(next_discriminant);
        next_discriminant = (next_discriminant + i64(1));
      },
      // ---------------------------------------------------------------
      // Variant with fields, possibly with `= discriminant`.
      // ---------------------------------------------------------------
      true => {
        (variant_expr : AstExpr) = enum_arg;
        (custom_disc : Option(i64)) = Option(i64).None;
        if(ast_expr_is_fn_call_of(enum_arg, BK_ASSIGN, Option(usize).Some(usize(2))), {
          eq_args := _fn_call_args(enum_arg);
          variant_expr = match(eq_args.get(usize(0)),.Some(a) => a,.None => make_err_expr());
          discriminant_expr := match(eq_args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
          d := _evaluate_discriminant(discriminant_expr, env, ctx, exn);
          custom_disc = Option(i64).Some(d);
        });
        if(ast_expr_is_fn_call_of(variant_expr, ":", Option(usize).None), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(variant_expr),
                String.from("Enum variant with : is not implemented yet"),
                false,
                .None
              )
            )
          );
        });
        if(!(ast_expr_is_fn_call(variant_expr)) ||
          !(is_valid_variable_name(_fn_call_func(variant_expr))), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(variant_expr),
                `Expected identifier for enum variant, got:\n${ast_expr_to_string(variant_expr)}`,
                false,
                .None
              )
            )
          );
        });
        variant_name := ast_expr_token(_fn_call_func(variant_expr)).value;
        if(_has_variant(variant_names, variant_name.clone()), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(_fn_call_func(variant_expr)),
                `Duplicate variant name "${variant_name}" in enum`,
                false,
                .None
              )
            )
          );
        });
        v_args := _fn_call_args(variant_expr);
        v_field_types := ArrayList(TypeValue).new();
        v_field_labels := ArrayList(String).new();
        (j : usize) = usize(0);
        while(j < v_args.len(), {
          field_arg := match(v_args.get(j),.Some(a) => a,.None => make_err_expr());
          result := evaluate_type_field(field_arg, j, env, ctx, "enum", exn);
          field := result.field;
          // Check for duplicate labels in this variant.
          (dup_idx : usize) = usize(0);
          (has_dup : bool) = false;
          while((dup_idx < v_field_labels.len()) && !(has_dup), {
            existing := match(v_field_labels.get(dup_idx),.Some(l) => l,.None => String.from(""));
            if(existing == field.label, {
              has_dup = true;
            });
            dup_idx = (dup_idx + usize(1));
          });
          if(has_dup, {
            arg_args := _fn_call_args(field_arg);
            err_tok := if(
              ast_expr_is_fn_call(field_arg),
              match(arg_args.get(usize(0)),.Some(fe) => ast_expr_token(fe),.None => ast_expr_token(field_arg)),
              ast_expr_token(field_arg)
            );
            exn.throw(
              dyn(
                format_error_message(
                  err_tok,
                  `Duplicate field label "${field.label}" in enum variant`,
                  false,
                  .None
                )
              )
            );
          });
          if(field.assigned_value.is_some(), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(field_arg),
                  String.from("Enum variant field cannot have compile-time assigned value."),
                  false,
                  .None
                )
              )
            );
          });
          v_field_types.push(field.ty);
          v_field_labels.push(field.label.clone());
          env.frames = result.env.frames;
          env.module_path = result.env.module_path;
          env.function_declaration_frame_level = result.env.function_declaration_frame_level;
          env.input_string = result.env.input_string;
          j = (j + usize(1));
        });
        disc := match(custom_disc,.Some(d) => d,.None => next_discriminant);
        variant_names.push(variant_name.clone());
        variant_fields.push(v_field_types);
        variant_field_labels.push(v_field_labels);
        variant_discriminants.push(disc);
        next_discriminant = (disc + i64(1));
      }
    );
    // GADT: evaluate the `-> recur(T…)` return-type args for the variant just
    // built and record them parallel to variant order (mirrors enum.ts:313-366).
    // A non-GADT variant records an empty list. `ctx.self_type` is still the
    // preliminary enum type, so self-referential return args resolve.
    match(
      gadt_ret,
      .Some(gre) => {
        if(!(ast_expr_is_fn_call_of(gre, BF_RECUR, Option(usize).None)), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(gre),
                `Expected recur(...) for GADT return type, got:\n${ast_expr_to_string(gre)}`,
                false,
                .None
              )
            )
          );
        });
        recur_args := _fn_call_args(gre);
        this_variant_args := ArrayList(TypeValue).new();
        (gi : usize) = usize(0);
        while(gi < recur_args.len(), {
          ra := match(recur_args.get(gi),.Some(a) => a,.None => make_err_expr());
          evaluated_ra := evaluate_expression_raw(ra, env, ctx, exn);
          ra_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_ra));
          ra_info := match(ra_info_opt,.Some(ii) => ii,.None => new_expr_info(env, TypeValue.Unit));
          if(!(is_type_value(ra_info.value)), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(ra),
                  `Expected type for GADT return type argument, got ${ast_expr_to_string(ra)}`,
                  false,
                  .None
                )
              )
            );
          });
          ra_ty := match(
            ra_info.value,
            .Some(v) => match(v,.TypeVal(inner) => inner, _ => TypeValue.Unit),
            .None => TypeValue.Unit
          );
          this_variant_args.push(ra_ty);
          gi = (gi + usize(1));
        });
        all_variant_gadt_args.push(this_variant_args);
        any_gadt = true;
      },
      .None => {
        all_variant_gadt_args.push(ArrayList(TypeValue).new());
      }
    );
    i = (i + usize(1));
  });
  // GADT: record per-variant return-type args in the side-table (marks this
  // enum id as a GADT). Mirrors `enumType.isGadt = true` + per-variant
  // `gadtReturnTypeArgs` (enum.ts:364-365). typeConstructorArgs (enum.ts:369-391)
  // is populated by the caller/match path.
  if(any_gadt, {
    register_gadt_enum(enum_id.clone(), all_variant_gadt_args);
    // typeConstructorArgs (enum.ts:369-391): when a GADT enum is built
    // inside its type-constructor fn body (`Value(i32)` → `enum(...)`),
    // record the concrete type args the constructor was called with —
    // read from the env via the fn type's comptime (Type-universe) params.
    // The match exhaustiveness check uses these to skip GADT-unreachable
    // variants (tests/gadts.test.yo `eval_int_only` on `Value(i32)`).
    match(
      ctx.is_evaluating_function_body_or_async_block,
      .Some(fab) => if(match(fab.kind,.FunctionBody => true, _ => false), {
        match(
          fab.func_type,
          .Some(ft) => match(
            ft,
            .Func({ param_types : fc_ptypes, meta : __fm1 }) => {
              fc_plabels := __fm1.*.param_labels;
              tca := ArrayList(TypeValue).new();
              (tci : usize) = usize(0);
              n_tcp := fc_plabels.len();
              while(tci < n_tcp, {
                p_lbl := match(fc_plabels.get(tci),.Some(l) => l,.None => String.from(""));
                p_ty := match(fc_ptypes.get(tci),.Some(t) => t,.None => TypeValue.Unit);
                // Comptime type param ≈ declared type is the `Type` universe.
                if(is_type_0(p_ty), {
                  vars := get_variables_from_env(env, p_lbl);
                  if(vars.len() > usize(0), {
                    match(
                      vars.get(vars.len() - usize(1)),
                      .Some(lastv) => match(
                        lastv.value,
                        .Some(vv) => match(
                          vv,
                          .TypeVal(tvb) => {
                            _t := tca.push(tvb);
                          },
                          _ => ()
                        ),
                        .None => ()
                      ),
                      .None => ()
                    );
                  });
                });
                tci = (tci + usize(1));
              });
              // Only register when every comptime param resolved to a type
              // (mirrors TS `typeArgs.length === comptimeParams.length`).
              n_comptime := usize(0);
              (cti : usize) = usize(0);
              while(cti < fc_ptypes.len(), {
                match(
                  fc_ptypes.get(cti),
                  .Some(pt) => if(is_type_0(pt), {
                    n_comptime = (n_comptime + usize(1));
                  }),
                  .None => ()
                );
                cti = (cti + usize(1));
              });
              if((tca.len() > usize(0)) && (tca.len() == n_comptime), {
                register_gadt_type_constructor_args(enum_id.clone(), tca);
              });
            },
            _ => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
  });
  // Auto-derive trait markers (Send, Acyclic, Comptime, Runtime).
  // Mirrors `autoDeriveTraitsAndAddRcFunctionsForEnumType` in TypeScript.
  auto_derive_traits_for_enum_type(enum_id.clone(), variant_fields, env);
  // Restore SelfType.
  ctx.self_type = old_self_type;
  // Build the final EnumT in two steps: an UNPATCHED pre-final used as the
  // replacement target, then the real final with shell-patched fields.
  pre_final_ty := TypeValue.EnumT(
    enum_id.clone(),
    String.from(""),
    variant_names,
    variant_fields,
    Option(String).None,
    variant_field_labels,
    variant_discriminants,
    force_reference_semantics,
    is_atomic_rc
  );
  // Patch the SELF SHELL out of the variant fields: during field
  // evaluation `Self` was the empty prelim (same id), and instantiations
  // like `ArrayList(Self)` captured it — `.Array(items)` bindings then
  // carried ArrayList(<0-variant shell>) and downstream dispatch/unify
  // failed (std/encoding/json.yo's `at`). Replace one level here; deeper
  // self-nesting resolves through the enum-final registry
  // (resolve_enum_shell). TS needs no patch — its Self IS the same
  // mutable object.
  patched_fields := ArrayList(ArrayList(TypeValue)).new();
  (pf_i : usize) = usize(0);
  while(pf_i < variant_fields.len(), {
    vf_list := match(variant_fields.get(pf_i),.Some(l) => l,.None => ArrayList(TypeValue).new());
    new_list := ArrayList(TypeValue).new();
    (pf_j : usize) = usize(0);
    while(pf_j < vf_list.len(), {
      ft := match(vf_list.get(pf_j),.Some(t) => t,.None => t_unit());
      new_list.push(_patch_self_shell(ft, shell_id.clone(), pre_final_ty));
      pf_j = (pf_j + usize(1));
    });
    patched_fields.push(new_list);
    pf_i = (pf_i + usize(1));
  });
  enum_ty := TypeValue.EnumT(
    enum_id.clone(),
    String.from(""),
    variant_names,
    patched_fields,
    Option(String).None,
    variant_field_labels,
    variant_discriminants,
    force_reference_semantics,
    is_atomic_rc
  );
  // Record the finalized form under the SHELL's id so leaked shells can
  // be resolved at use sites — see resolve_enum_shell.
  register_enum_final(shell_id.clone(), enum_ty);
  enum_val := create_type_value(enum_ty);
  meta_ty := type_of_type(enum_ty);
  out_info := new_expr_info(env, meta_ty);
  out_info.value = Option(EvalValue).Some(enum_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  // Annotate callee (expr.func) with the same info.
  callee_expr := _fn_call_func(expr);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(callee_expr), out_info);
  expr
});
export(evaluate_enum_type);
