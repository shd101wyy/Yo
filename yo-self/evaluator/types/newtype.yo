open(import("std/string"));
{ AstExpr, ast_expr_token, make_err_expr } :: import("../../expr/expr.yo");
{ Environment } :: import("../../env/env.yo");
{ EvalContext } :: import("../context.yo");
{ Exception } :: import("std/error");
{ evaluate_struct_type } :: import("./struct.yo");
evaluate_newtype_type :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : *(EvalContext),
    using(exn : Exception)
  ) -> AstExpr
)(
  evaluate_struct_type(expr, env, ctx, false, using(exn))
);
export(evaluate_newtype_type);
