open(import("std/string"));
{ AstExpr, ast_expr_token, make_err_expr } :: import("../../expr.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ Exception } :: import("std/error");
{ evaluate_struct_type } :: import("./struct.yo");
evaluate_newtype_type :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)(
  evaluate_struct_type(expr, env, ctx, false, false, exn)
);
export(evaluate_newtype_type);
