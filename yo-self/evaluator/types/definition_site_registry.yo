//! evaluator/types/definition_site_registry — tracks definitionSiteEnclosingFunctionType.
//!
//! TypeScript stores `definitionSiteEnclosingFunctionType` as an optional field
//! on `FunctionValue`. In yo-self, `FuncVal` has no such field, so we use a
//! global HashMap keyed by `func_id` (a String).
//!
//! Only the **return type** portion is stored, since that is the only field
//! used by `evaluateCtlFunctionBodyInline` (line 3644 in `src/evaluator/calls/helper.ts`):
//!   `originalFunction.definitionSiteEnclosingFunctionType?.return.type ?? createUnitType()`
//!
//! Mirrors the `definitionSiteEnclosingFunctionType` field on `FunctionValue`
//! in `src/function-value.ts`.
open(import("std/string"));
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue, t_unit } :: import("../../types/type.yo");
// ---------------------------------------------------------------------------
// Global registry
// ---------------------------------------------------------------------------
/// Global map from `func_id` → return type of the enclosing function at the
/// definition site.
(g_definition_site_return_registry : HashMap(String, TypeValue)) =
  HashMap(String, TypeValue).new();
/// Register the enclosing function's return type at a function's definition site.
///
/// Called when creating a FuncVal (in `anonymous_function.yo`) if the function
/// is defined inside another function body.
///
/// Mirrors setting `functionValue.definitionSiteEnclosingFunctionType = ...`
/// in `src/evaluator/values/anonymous-function.ts`.
register_definition_site_return :: (fn(func_id : String, return_ty : TypeValue) -> unit)({
  ___ := g_definition_site_return_registry.set(func_id.clone(), return_ty);
});
/// Get the enclosing function's return type at a function's definition site.
/// Returns `None` if the function was not defined inside another function body
/// (e.g., top-level definitions, handlers defined in test blocks).
///
/// Returns `t_unit()` as fallback to mirror:
///   `originalFunction.definitionSiteEnclosingFunctionType?.return.type ?? createUnitType()`
get_definition_site_return :: (fn(func_id : str) -> TypeValue)(
  match(
    g_definition_site_return_registry.get(String.from(func_id)),
    .Some(ty) => ty,
    .None => t_unit()
  )
);
export(register_definition_site_return, get_definition_site_return);
