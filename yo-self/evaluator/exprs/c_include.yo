//! evaluate_c_include — handles `c_include "<stdio.h>" { ... }` declarations.
//!
//! 1:1 port of `src/evaluator/exprs/c-include.ts` (189 lines).
//!
//! Phase 2av: fully ported — calls `evaluate_module_field` and adds fields to
//! the environment.  The `is_extern`/`externName` markers ARE ported (onto the
//! `Func` variant): the extern-call `unsafe(...)` gate in `calls/function.yo`
//! reads them to require `c_include`d FFI call sites be wrapped in `unsafe(...)`
//! (plans/EXTERN_UNSAFE_WRAP.md). Only `cInclude` (a codegen concern) stays
//! skipped.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BK_C_INCLUDE
} :: import("../../expr.yo");
{ new_expr_info, expr_info_table_set, expr_info_table_get, register_extern_c_global } :: import("../../expr_info.yo");
{ Environment, add_variable_to_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_unknown_val_with_name } :: import("../../value.yo");
{ TypeValue, FuncMeta } :: import("../../types/definitions.yo");
{ t_unit, t_some_t } :: import("../../types/creators.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ evaluate_expression } :: import("./expr.yo");
{ EvalModuleFieldResult, evaluate_module_field } :: import("../types/record.yo");
{ ArrayList } :: import("std/collections/array_list");
evaluate_c_include :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  if(!(ast_expr_is_fn_call_of(expr, BK_C_INCLUDE,.None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected c_include, got ${ast_expr_token(expr).value}`,
          false,
          .None
        )
      )
    );
  });
  // Privilege gate (mirrors evaluate_extern). `c_include(...)` brings C
  // header symbols into scope as `extern "c"` declarations; safe code
  // (no `pragma(Pragma.AllowUnsafe);`) must not be able to do this. The
  // call-site gate in `function.yo` catches actual calls, but type-level
  // uses (an imported extern Type in a field/trait bound) would slip
  // through. Mirrors `c-include.ts:46-66`.
  if(!(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(expr).module_path.clone()))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `'c_include(...)' is not available in safe code.

C header imports declare 'extern "c"' symbols, which are outside Yo's
type-checking reach. To use them, declare at the top of this file:

    pragma(Pragma.AllowUnsafe);

User code should normally call stdlib wrappers (e.g. functions in
'std/sys', 'std/fs') instead of pulling in C headers directly.`,
          false,
          .None
        )
      )
    );
  });
  (env : Environment) = env_in;
  all_args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  // First arg must be an atom (the C header file string literal, e.g. "<stdio.h>").
  first_arg_opt := all_args.get(usize(0));
  if(!(match(first_arg_opt,.Some(a) => ast_expr_is_atom(a),.None => false)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected C header file as first argument to c_include, such as:\n\nc_include \"<stdio.h>\" ...;"),
          false,
          .None
        )
      )
    );
  });
  c_header_file_arg := match(first_arg_opt,.Some(a) => a,.None => expr);
  evaluated_hdr := evaluate_expression(c_header_file_arg, env, ctx);
  hdr_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_hdr));
  hdr_info := match(hdr_info_opt,.Some(i) => i,.None => new_expr_info(env, t_unit()));
  env.frames = hdr_info.env.frames;
  env.module_path = hdr_info.env.module_path;
  env.function_declaration_frame_level = hdr_info.env.function_declaration_frame_level;
  env.input_string = hdr_info.env.input_string;
  raw_hdr := match(
    hdr_info.value,
    .Some(v) => match(
      v,
      .StrLit(s) => s,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(c_header_file_arg),
              `Expected string for C header file argument`,
              false,
              .None
            )
          )
        );
        String.new()
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(c_header_file_arg),
            `Failed to evaluate C header file argument`,
            false,
            .None
          )
        )
      );
      String.new()
    }
  );
  // Strip surrounding quotes from the raw string literal.
  rn := raw_hdr.len();
  (c_header_file : String) = if(
    rn >= usize(2),
    raw_hdr.substring(usize(1), rn - usize(1)),
    raw_hdr.clone()
  );
  if(c_header_file.len() == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected C header file as first argument to c_include, such as:\n\nc_include \"<stdio.h>\" ...;"),
          false,
          .None
        )
      )
    );
  });
  // Iterate over the field declarations (args[1..]).
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  (args_idx : usize) = usize(1);
  (field_idx : usize) = usize(0);
  while(args_idx < all_args.len(), {
    arg := match(all_args.get(args_idx),.Some(a) => a,.None => expr);
    result := evaluate_module_field(arg, field_idx, env, ctx, false, exn);
    // Check for duplicate labels.
    (dup_idx : usize) = usize(0);
    (has_dup : bool) = false;
    while((dup_idx < field_labels.len()) && !(has_dup), {
      existing := match(field_labels.get(dup_idx),.Some(l) => l,.None => String.from(""));
      if(existing == result.label, {
        has_dup = true;
      });
      dup_idx = (dup_idx + usize(1));
    });
    if(has_dup, {
      err_tok := if(
        ast_expr_is_fn_call(arg),
        match(
          match(arg,.FnCall(_, _, a2, _, _) => a2, _ => ArrayList(AstExpr).new()).get(usize(0)),
          .Some(fe) => ast_expr_token(fe),
          .None => ast_expr_token(arg)
        ),
        ast_expr_token(arg)
      );
      exn.throw(
        dyn(
          format_error_message(
            err_tok,
            `Duplicate label "${result.label}" in module`,
            false,
            .None
          )
        )
      );
    });
    // Stamp the FFI marker (`is_extern = "c"`, `extern_name = label`) onto
    // function field types so the extern-call `unsafe(...)` gate
    // (calls/function.yo) can identify calls to this `c_include`d symbol.
    // Mirrors `c-include.ts:138-145` (the `isFunctionType` branch). Non-`Func`
    // field types (type declarations like `time_t : Type`) carry no
    // `is_extern` slot and are never called. `cInclude` is codegen-only.
    field_ty_with_extern := match(
      result.field_type,
      .Func({
        forall_types : fts,
        param_types : pts,
        implicit_types : its,
        where_types : wts,
        result : ret,
        meta : m
      }) => TypeValue.Func(
        fts,
        pts,
        its,
        wts,
        ret,
        box(
          FuncMeta(
            forall_labels : m.*.forall_labels.clone(),
            param_labels : m.*.param_labels.clone(),
            implicit_labels : m.*.implicit_labels.clone(),
            implicit_spreads : m.*.implicit_spreads.clone(),
            result_is_comptime_only : m.*.result_is_comptime_only,
            param_is_ref : m.*.param_is_ref.clone(),
            param_is_owning : m.*.param_is_owning.clone(),
            result_is_ref : m.*.result_is_ref,
            has_variadic : m.*.has_variadic,
            is_extern : Option(String).Some(String.from("c")),
            extern_name : Option(String).Some(result.label.clone()),
            is_control : m.*.is_control
          )
        )
      ),
      _ => result.field_type
    );
    field_labels.push(result.label.clone());
    field_types.push(field_ty_with_extern);
    env.frames = result.env.frames;
    env.module_path = result.env.module_path;
    env.function_declaration_frame_level = result.env.function_declaration_frame_level;
    env.input_string = result.env.input_string;
    // If the field type is Type (TypeUni(0)), this is a type declaration (e.g. time_t : Type).
    // Create a SomeType placeholder so the identifier can be used in type expressions.
    (field_val : EvalValue) = match(
      result.field_type,
      .TypeUni(level) => cond(
        (level == usize(0)) =>.TypeVal(t_some_t(result.label.clone(), usize(0))),
        true => create_unknown_val_with_name(result.field_type, result.label.clone())
      ),
      _ => create_unknown_val_with_name(field_ty_with_extern, result.label.clone())
    );
    // Add field variable to env (compile-time only, unknown value placeholder).
    _var_opt := add_variable_to_env(
      env,
      result.label.clone(),
      field_ty_with_extern,
      Option(EvalValue).Some(field_val),
      true,
      // is_compile_time_only
      false,
      // is_reassignable
      type_contains_rc_type(field_ty_with_extern),
      // is_owning_the_rc_value
      false,
      // is_implicit
      ast_expr_token(arg)
    );
    // Mark this c_include symbol as an extern-C global so codegen keeps its REAL
    // C name (e.g. `stdout`) instead of the `__yo_c_reserved_` prefix. yo-self
    // models is_extern only on the Func TypeValue, so non-Func globals
    // (`stdout : *(FILE)`) can't carry the marker on their type — this registry
    // covers them (see expr_info.yo). Harmless for Func/Type fields.
    register_extern_c_global(result.label.clone());
    args_idx = (args_idx + usize(1));
    field_idx = (field_idx + usize(1));
  });
  // Store UnitVal result on the c_include expression.
  unit_info := new_expr_info(env, t_unit());
  unit_info.value =.Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), unit_info);
  // Annotate callee (the "c_include" func node) with same info.
  callee_expr := match(expr,.FnCall(_, fb, _, _, _) => fb.*,.Atom(_, _) => expr);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(callee_expr), unit_info);
  expr
});
export(evaluate_c_include);
