//! evaluate_c_include — handles `c_include "<stdio.h>" { ... }` declarations.
//!
//! 1:1 port of `src/evaluator/exprs/c-include.ts` (189 lines).
//!
//! Phase 2av: fully ported — calls `evaluate_module_field` and adds fields to
//! the environment.  The `is_extern`, `cInclude`, and `externName` metadata
//! mutations from TypeScript are intentionally skipped: yo-self's `TypeValue`
//! enum has no such fields, and that metadata is only needed by codegen (which
//! yo-self does not perform).
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BK_C_INCLUDE
} :: import("../../expr/expr.yo");
{ new_expr_info, expr_info_table_set, expr_info_table_get } :: import("../../expr/expr_info.yo");
{ Environment, add_variable_to_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_unknown_val } :: import("../value.yo");
{ TypeValue, t_unit } :: import("../../types/type.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ format_error_message } :: import("../../error/error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression } :: import("./expr.yo");
{ EvalModuleFieldResult, evaluate_module_field } :: import("../types/record.yo");
{ ArrayList } :: import("std/collections/array_list");
evaluate_c_include :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : *(EvalContext),
    using(exn : Exception)
  ) -> AstExpr
)({
  if(!(ast_expr_is_fn_call_of(expr, BK_C_INCLUDE,.None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected c_include, got ${ast_expr_token(expr).value}`,
          false,
          .None
        )
      )
    );
  });
  (env : Environment) = env_in;
  all_args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  // First arg must be an atom (the C header file string literal, e.g. "<stdio.h>").
  first_arg_opt := all_args.get(usize(0));
  if(!(match(first_arg_opt,.Some(a) => ast_expr_is_atom(a),.None => false)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected C header file as first argument to c_include, such as:\n\nc_include \"<stdio.h>\" ...;"),
          false,
          .None
        )
      )
    );
  });
  c_header_file_arg := match(first_arg_opt,.Some(a) => a,.None => expr);
  evaluated_hdr := evaluate_expression(c_header_file_arg, env, ctx);
  hdr_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_hdr));
  hdr_info := match(hdr_info_opt,.Some(i) => i,.None => new_expr_info(env, t_unit()));
  env = hdr_info.env;
  raw_hdr := match(
    hdr_info.value,
    .Some(v) => match(
      v,
      .StrLit(s) => s,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(c_header_file_arg),
              `Expected string for C header file argument`,
              false,
              .None
            )
          )
        );
        String.new()
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(c_header_file_arg),
            `Failed to evaluate C header file argument`,
            false,
            .None
          )
        )
      );
      String.new()
    }
  );
  // Strip surrounding quotes from the raw string literal.
  rn := raw_hdr.len();
  (c_header_file : String) = if(
    rn >= usize(2),
    raw_hdr.substring(usize(1), rn - usize(1)),
    String.from(raw_hdr.as_str())
  );
  if(c_header_file.len() == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected C header file as first argument to c_include, such as:\n\nc_include \"<stdio.h>\" ...;"),
          false,
          .None
        )
      )
    );
  });
  // Iterate over the field declarations (args[1..]).
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  (args_idx : usize) = usize(1);
  (field_idx : usize) = usize(0);
  while(runtime(args_idx < all_args.len()), {
    arg := match(all_args.get(args_idx),.Some(a) => a,.None => expr);
    result := evaluate_module_field(arg, field_idx, env, ctx, false, using(exn));
    // Check for duplicate labels.
    (dup_idx : usize) = usize(0);
    (has_dup : bool) = false;
    while(runtime((dup_idx < field_labels.len()) && !(has_dup)), {
      existing := match(field_labels.get(dup_idx),.Some(l) => l,.None => String.from(""));
      if(existing.as_str() == result.label.as_str(), {
        has_dup = true;
      });
      dup_idx = (dup_idx + usize(1));
    });
    if(has_dup, {
      err_tok := if(
        ast_expr_is_fn_call(arg),
        match(
          match(arg,.FnCall(_, _, a2, _, _) => a2, _ => ArrayList(AstExpr).new()).get(usize(0)),
          .Some(fe) => ast_expr_token(fe),
          .None => ast_expr_token(arg)
        ),
        ast_expr_token(arg)
      );
      exn.throw(
        dyn(
          format_error_message(
            err_tok,
            `Duplicate label "${result.label}" in module`,
            false,
            .None
          )
        )
      );
    });
    field_labels.push(String.from(result.label.as_str()));
    field_types.push(result.field_type);
    env = result.env;
    // NOTE: TypeScript sets is_extern/"c" and cInclude/externName on the type here.
    // yo-self skips that mutation — TypeValue has no such fields (codegen-only metadata).
    // Add field variable to env (compile-time only, unknown value placeholder).
    _var_opt := add_variable_to_env(
      &(env),
      String.from(result.label.as_str()),
      result.field_type,
      Option(EvalValue).Some(create_unknown_val(result.field_type)),
      true,
      // is_compile_time_only
      false,
      // is_reassignable
      type_contains_rc_type(result.field_type),
      // is_owning_the_rc_value
      false,
      // is_implicit
      ast_expr_token(arg)
    );
    args_idx = (args_idx + usize(1));
    field_idx = (field_idx + usize(1));
  });
  // Store UnitVal result on the c_include expression.
  unit_info := new_expr_info(env, t_unit());
  unit_info.value =.Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), unit_info);
  // Annotate callee (the "c_include" func node) with same info.
  callee_expr := match(expr,.FnCall(_, fb, _, _, _) => fb.*,.Atom(_, _) => expr);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(callee_expr), unit_info);
  expr
});
export(evaluate_c_include);
