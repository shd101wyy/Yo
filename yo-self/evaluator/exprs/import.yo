//! evaluate_import — handles `import("path")` expressions.
//!
//! 1:1 port of `src/evaluator/exprs/import.ts` (317 lines).
//!
//! Phase 2 limitations
//! -------------------
//! * Dependency name resolution (`getBuildRegistry`, `getModuleImportRoot`,
//!   `resolveDependencyPath`) is not yet ported.  Any import that is neither a
//!   `std/` import nor a relative path (starting with `./` or `../`) will fail
//!   with a descriptive error until those helpers are ported.
//! * The `safeRelativePath` Windows cross-drive helper is omitted; absolute
//!   paths returned by `Path.join` are used directly.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  BK_IMPORT
} :: import("../../expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_get, expr_info_table_set } :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, LoadModuleResult } :: import("../context.yo");
{ EvalValue, type_of_eval_value } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ Path } :: import("std/path");
{ cwd } :: import("std/env");
{ access, F_OK } :: import("std/libc/unistd");
{ evaluate_expression } :: import("./expr.yo");
{ random_id } :: import("../../utils.yo");
// ---------------------------------------------------------------------------
// _file_exists_sync
// ---------------------------------------------------------------------------
/// Synchronous file existence check using POSIX `access(2)`.
_file_exists_sync :: (fn(absolute_path : String) -> bool)({
  cstr := absolute_path.to_cstr();
  ptr := *(char)(cstr.ptr().unwrap());
  unsafe(access(ptr, F_OK)) == int(0)
});
// ---------------------------------------------------------------------------
// Module path resolution (shared with main.yo's preload_module_tree)
// ---------------------------------------------------------------------------
/// Result of resolving an `import("…")` path string to a concrete file.
/// `Found` carries the `file://`-prefixed absolute path (with extension).
ModuleResolveResult :: enum(
  Found(abs_path : String),
  NotFound(base : String),
  Ambiguous(base : String)
);
/// Resolve an import path string (already stripped of surrounding quotes,
/// and known not to be the prelude) to a concrete `file://` module path.
///
/// I/O-free: file existence is probed with `_file_exists_sync` (POSIX
/// `access(2)`), so this is a pure `fn` usable from both the evaluator
/// (`evaluate_import`) and the orchestration layer (`preload_module_tree`
/// in main.yo). Keeping resolution in one place guarantees both compute
/// the *same* cache key for `ctx.load_module`.
///
/// Mirrors the resolution order in `src/evaluator/exprs/import.ts`:
///   1. `std/…`     → relative to `std_path`
///   2. `std`       → `std_path/index.yo`
///   3. `.`/`..`    → relative to `current_dir`
///   4. otherwise   → relative to CWD
/// then extension resolution: `<path>.yo` xor `<path>/index.yo`.
resolve_module_path :: (
  fn(import_path : str, current_dir : str, std_path : str) -> ModuleResolveResult
)({
  (module_path_to_import : String) = String.from(import_path);
  // 1. `std/` prefix → resolve relative to std_path.
  if(module_path_to_import.starts_with(String.from("std/")), {
    rel := module_path_to_import.substring(usize(4), module_path_to_import.len());
    module_path_to_import = Path.new(String.from(std_path)).join(Path.new(rel)).to_string();
  });
  // 2. `std` alone → std/index.yo.
  if(module_path_to_import == "std", {
    module_path_to_import = Path.new(String.from(std_path)).join(Path.new(String.from("index.yo"))).to_string();
  });
  // 3. Relative paths (`.` or `..` prefix) — resolve relative to current dir.
  //    Build a combined string and re-`Path.new` it: `Path.new` collapses
  //    `..`/`.` segments on construction, whereas `Path.join` does NOT
  //    re-normalize `..` in its argument (so `std/imm`.join(`../allocator`)
  //    would wrongly yield `std/imm/allocator`, not `std/allocator`).
  if(module_path_to_import.starts_with(String.from(".")), {
    module_path_to_import = Path.new(`${current_dir}/${module_path_to_import.as_str()}`).to_string();
  });
  // 4. Non-relative, non-absolute paths: resolve relative to CWD.
  if(!(Path.new(String.from(module_path_to_import.as_str())).is_absolute()), {
    cwd_result := match(
      cwd(),
      .Ok(p) => p.to_string(),
      .Err(_) => String.from(".")
    );
    module_path_to_import = Path.new(cwd_result).join(Path.new(String.from(module_path_to_import.as_str()))).to_string();
  });
  // Extension resolution.
  ext_opt := Path.new(String.from(module_path_to_import.as_str())).extension();
  has_ext := match(ext_opt,.Some(_) => true,.None => false);
  if(has_ext, {
    return(ModuleResolveResult.Found(`file://${module_path_to_import}`));
  });
  yo_file_path := `${module_path_to_import}.yo`;
  index_yo_path := `${module_path_to_import}/index.yo`;
  yo_exists := _file_exists_sync(String.from(yo_file_path.as_str()));
  index_exists := _file_exists_sync(String.from(index_yo_path.as_str()));
  cond(
    (yo_exists && index_exists) => ModuleResolveResult.Ambiguous(module_path_to_import),
    yo_exists => ModuleResolveResult.Found(`file://${yo_file_path}`),
    index_exists => ModuleResolveResult.Found(`file://${index_yo_path}`),
    true => ModuleResolveResult.NotFound(module_path_to_import)
  )
});
// ---------------------------------------------------------------------------
// _find_project_root
// ---------------------------------------------------------------------------
/// Walk up the directory tree to find the nearest project root.
/// A directory is a project root if it contains `yo.lock` or `build.yo`.
/// Returns `.None` if no project root is found.
_find_project_root :: (fn(file_path : String) -> Option(String))({
  dir_path_opt := Path.new(file_path).parent();
  (result : Option(String)) =.None;
  (found : bool) = false;
  while(!(found), {
    match(
      dir_path_opt,
      .None => {
        found = true;
      },
      .Some(dir_p) => {
        dir_str := dir_p.to_string();
        yo_lock := dir_p.join(Path.new(String.from("yo.lock"))).to_string();
        build_yo := dir_p.join(Path.new(String.from("build.yo"))).to_string();
        if(_file_exists_sync(yo_lock) || _file_exists_sync(build_yo), {
          result =.Some(dir_str);
          found = true;
        }, {
          // Move up one level.
          next_opt := dir_p.parent();
          match(
            next_opt,
            .None => {
              found = true;
            },
            .Some(next) => {
              // Stop if we've reached the root (no more parent).
              if(next.to_string() == dir_str, {
                found = true;
              }, {
                dir_path_opt =.Some(next);
              });
            }
          );
        });
      }
    );
  });
  result
});
// ---------------------------------------------------------------------------
// _resolve_dependency_entry_point
// ---------------------------------------------------------------------------
/// Resolve the entry point file for a named dependency under `dep_root`.
/// Tries `index.yo` then `<dep_name>.yo`, falls back to `dep_root`.
_resolve_dependency_entry_point :: (fn(dep_root : String, dep_name : String) -> String)({
  index_yo := Path.new(dep_root).join(Path.new(String.from("index.yo"))).to_string();
  named_yo := Path.new(dep_root).join(Path.new(dep_name.concat(String.from(".yo")))).to_string();
  if(
    _file_exists_sync(index_yo),
    index_yo,
    if(
      _file_exists_sync(named_yo),
      named_yo,
      dep_root
    )
  )
});
// ---------------------------------------------------------------------------
// _build_module_val_from_env
// ---------------------------------------------------------------------------
/// Build a source-namespace `StructVal` (TS: imports are StructValues,
/// evaluator/index.ts:49) whose fields are all comptime-known bindings currently
/// visible in `env`. Used as a fallback when no real module loader is
/// registered: in `run_check`'s flatten-eval pipeline all dep exprs run in the
/// same shared env, so the names declared in any imported module are already
/// reachable from `env` by the time the `import("…")` call is evaluated.
/// Outer (lower-index) frames are walked first so newer same-name bindings in
/// inner frames take precedence by overwriting earlier ones via a linear scan
/// in the destructurer.
_build_module_val_from_env :: (fn(env : Environment) -> EvalValue)({
  names := ArrayList(String).new();
  values := ArrayList(EvalValue).new();
  (fi : usize) = usize(0);
  while(fi < env.frames.len(), {
    match(
      env.frames.get(fi),
      .Some(frame) => {
        (vi : usize) = usize(0);
        while(vi < frame.variables.len(), {
          match(
            frame.variables.get(vi),
            .Some(v) => match(
              v.value,
              .Some(val) => {
                // Skip prelude operator / impl-method names (like bool.!, i32.MAX)
                // that would cause "already exported" errors when spread-exporting
                // multiple imports in flatten-eval mode. Real module exports never
                // contain '.' — operator/impl names do.
                name_str := v.name.as_str();
                if(String.from(name_str).contains(String.from(".")), {
                  // skip — prelude operator binding, not a module export
                }, {
                  names.push(String.from(name_str));
                  values.push(val);
                });
              },
              .None => ()
            ),
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  EvalValue.StructVal(`source_namespace_${random_id(env.module_path)}`, names, values)
});
// ---------------------------------------------------------------------------
// evaluate_import
// ---------------------------------------------------------------------------
evaluate_import :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  if(!(ast_expr_is_fn_call_of(expr, BK_IMPORT,.Some(usize(1)))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected `import` with exactly 1 argument."),
          false,
          .None
        )
      )
    );
  });
  // Get the path argument (first arg of the import call).
  module_arg := match(
    expr,
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              String.from("import: missing path argument."),
              false,
              .None
            )
          )
        );
        expr
      }
    ),
    .Atom(_, _) => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("import: expected FnCall expression."),
            false,
            .None
          )
        )
      );
      expr
    }
  );
  // Evaluate the argument — it must yield a comptime string.
  evaluated_arg := evaluate_expression(module_arg, env, ctx);
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg));
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(module_arg),
            String.from("import: failed to evaluate module path argument."),
            false,
            .None
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  env.frames = arg_info.env.frames;
  env.module_path = arg_info.env.module_path;
  env.function_declaration_frame_level = arg_info.env.function_declaration_frame_level;
  env.input_string = arg_info.env.input_string;
  // Extract the comptime string value.
  // In yo-self, StrLit.raw includes the surrounding quotes (e.g., `"std/string"`).
  // Strip the leading and trailing quote character to get the raw path.
  raw_with_quotes := match(
    arg_info.value,
    .Some(v) => match(
      v,
      .StrLit(s) => s,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(module_arg),
              String.from("Expected comptime_string for module path."),
              false,
              .None
            )
          )
        );
        String.new()
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(module_arg),
            String.from("Expected comptime_string for module path."),
            false,
            .None
          )
        )
      );
      String.new()
    }
  );
  // Strip leading and trailing quote characters.
  rn := raw_with_quotes.len();
  (module_path_to_import : String) = if(
    rn >= usize(2),
    raw_with_quotes.substring(usize(1), rn - usize(1)),
    String.from(raw_with_quotes.as_str())
  );
  // Disallow importing the prelude.
  if((module_path_to_import == "std/prelude") || (module_path_to_import == "std/prelude.yo"), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(module_arg),
          String.from("Importing the prelude module is not allowed — it is automatically loaded for every file."),
          false,
          .None
        )
      )
    );
  });
  // ---------------------------------------------------------------------------
  // Path resolution
  // ---------------------------------------------------------------------------
  // Strip `file://` from the current module path to get the raw file-system path.
  current_file := env.module_path.replace(String.from("file://"), String.from(""));
  current_dir := match(
    Path.new(String.from(current_file.as_str())).parent(),
    .Some(p) => p.to_string(),
    .None => String.from(".")
  );
  // Resolve via the shared resolver so the cache key here matches the one
  // `preload_module_tree` (main.yo) registers under.
  (module_abs_path : String) = match(
    resolve_module_path(module_path_to_import.as_str(), current_dir.as_str(), ctx.std_path.as_str()),
    .Found(p) => p,
    .Ambiguous(base) => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(module_arg),
            `Ambiguous import("${base}": both "${base}.yo" and "${base}/index.yo" exist. Use an explicit path to resolve the ambiguity.)`,
            false,
            .None
          )
        )
      );
      String.from("")
    },
    .NotFound(base) => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(module_arg),
            `Module not found: tried "${base}.yo" and "${base}/index.yo"`,
            false,
            .None
          )
        )
      );
      String.from("")
    }
  );
  // ---------------------------------------------------------------------------
  // Load the module
  // ---------------------------------------------------------------------------
  // When no module loader is registered (e.g. `run_check` flatten-eval path),
  // synthesise a ModuleVal from the current evaluation env. Because
  // `collect_module_deps` flattens all dep exprs into one big list evaluated
  // in a shared env, every name declared in the imported module is already
  // in `env` at the time `import("…")` is evaluated. Building a ModuleVal
  // from `env` lets downstream destructuring (`{ X, Y } :: import("…")`)
  // and `open(import("…"))` find the names without a real ModuleManager.
  load_result := match(
    ctx.load_module,
    .Some(load_fn) => load_fn(String.from(module_abs_path.as_str())),
    .None => LoadModuleResult(
      module_value : _build_module_val_from_env(env),
      module_type : TypeValue.Unit,
      module_error :.None
    )
  );
  // Check for a load error.
  match(
    load_result.module_error,
    .Some(err_msg) => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(module_arg),
            `Failed to import module "${module_path_to_import}":\n${err_msg}`,
            false,
            .None
          )
        )
      );
    },
    .None => ()
  );
  // Record the result.
  mod_val := load_result.module_value;
  // Prefer the CACHED namespace struct type (real member field types —
  // fn members especially, whose FuncVal values carry no type, so the
  // value-derived reconstruction makes every imported fn unit-typed and
  // every `mod.f(x)` call unit). Fall back to the value-derived type for
  // the cycle path, which has no recorded type.
  mod_ty := match(
    load_result.module_type,
    .Unit => type_of_eval_value(mod_val),
    _ => load_result.module_type
  );
  out_info := new_expr_info(env, mod_ty);
  out_info.value =.Some(mod_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_import, resolve_module_path, ModuleResolveResult, _build_module_val_from_env);
