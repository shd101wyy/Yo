//! evaluate_assignment — the `=` reassignment handler.
//!
//! Mirrors `src/evaluator/exprs/assignment.ts` — Phase 3t (full) port.
//!
//! Supports:
//!   - Simple atom LHS:           x = rhs
//!   - Typed binding LHS:         (x : T) = rhs
//!   - Property / index LHS:      x.a = rhs, arr(0) = rhs
//!
//! Phase 3 stubs (not yet implemented):
//!   - Ownership tracking (clone_value, find_rc_value_owner_relationship, etc.)
//!   - attachTempVariableToExpr (no-op stub in utils.yo)
//!   - synthesizeExprAndType (type-inference for unknown-length arrays)
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_to_string,
  make_err_expr,
  BK_COLON,
  BK_ASSIGN,
  BK_COND,
  BK_MATCH,
  BK_BEGIN,
  BF_DOT
} :: import("../../expr.yo");
{
  ExprInfo,
  ComptimeRef,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  ControlFlowFlags,
  has_any_control_flow,
  control_flow_to_string,
  record_branch_init,
  has_dominating_branch_init,
  lookup_some_resolved_concrete
} :: import("../../expr_info.yo");
{
  Environment,
  Variable,
  value_cell_of,
  make_err_variable,
  get_variables_from_env,
  get_all_variables_from_env,
  update_existing_variable
} :: import("../../env.yo");
{ Token } :: import("../../token.yo");
{ EvalContext, ExpectedTypeCtx, CaptureUsage, track_variable_usage, call_rerun_pending_def_evals } :: import("../context.yo");
{
  EvalValue,
  is_struct_val,
  is_array_val,
  is_enum_val,
  is_tuple_val,
  is_unknown_val,
  eval_value_eq
} :: import("../../value.yo");
{ t_unit } :: import("../../types/creators.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_atomic_reference_struct_type,
  is_some_type,
  is_tuple_type,
  is_function_type,
  is_function_type_generic
} :: import("../../types/guards.yo");
{
  convert_comptime_type_to_runtime_type,
  convert_comptime_type_to_runtime_type_with_expected,
  get_value_of_some_type_from_env
} :: import("../../types/env_lookup.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ type_to_string } :: import("../../types/string.yo");
{ is_flowable_expr, FlowOptions, flag_flow_violation }
:: import("../../types/flowability.yo");
{ type_representation_contains_raw_ptr, type_contains_rc_type } :: import("../../types/utils.yo");
{ format_error_message, format_error_messages, TokenAndError } :: import("../../error.yo");
{ evaluate_expression_raw } :: import("./expr.yo");
{ evaluate_binding, set_defer_generic_fn_type_check } :: import("./binding.yo");
{ all_paths_unwind } :: import("../../expr_traversal.yo");
{
  require_expr_not_consumed,
  throw_expr_is_implicit_variable_error,
  set_expr_as_needs_to_call_dup,
  attach_temp_variable_to_expr,
  parse_raw_int
} :: import("../utils.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// throw_rhs_contains_control_flow_expression_error
// ---------------------------------------------------------------------------
/// Throw a descriptive error when the RHS of an assignment unconditionally
/// transfers control flow (return / unwind / break / continue).
///
/// Mirrors `throwRhsContainsControlFlowExpressionError` in
/// `src/evaluator/exprs/assignment.ts`.
throw_rhs_contains_control_flow_expression_error :: (
  fn(
    rhs : AstExpr,
    cf : ControlFlowFlags,
    exn : Exception
  ) -> unit
)({
  cf_str := control_flow_to_string(cf);
  error_msg := cond(
    (ast_expr_is_fn_call(rhs) && ast_expr_is_fn_call_of(rhs, BK_COND,.None)) =>
      `Cannot assign "cond" expression to variable when all cases contain "${cf_str}" statements. Consider using the "cond" result directly without assignment, or ensure at least one case doesn't return.`,
    (ast_expr_is_fn_call(rhs) && ast_expr_is_fn_call_of(rhs, BK_MATCH,.None)) =>
      `Cannot assign "match" expression to variable when all cases contain "${cf_str}" statements. Consider using the "match" result directly without assignment, or ensure at least one case doesn't return.`,
    (ast_expr_is_fn_call(rhs) && ast_expr_is_fn_call_of(rhs, BK_BEGIN,.None)) =>
      `Cannot assign "begin" expression to variable when it contains "${cf_str}" statement.`,
    true =>
      `Right-hand side contains "${cf_str}" from function.`
  );
  exn.throw(
    dyn(
      format_error_message(
        ast_expr_token(rhs),
        error_msg,
        false,
        .None
      )
    )
  );
});
// ---------------------------------------------------------------------------
// resolve_unknown_values_and_some_type_in_type  (Phase 2v stub)
// ---------------------------------------------------------------------------
/// Resolve unknown values and SomeType instances in a type.
///
/// In yo-self all array lengths are concrete, so the full TS logic is not
/// needed here.  Returns `ty` unchanged.
///
/// Mirrors `resolveUnknownValuesAndSomeTypeInType` in
/// `src/evaluator/exprs/assignment.ts`.
resolve_unknown_values_and_some_type_in_type :: (
  fn(
    ty : TypeValue,
    env : Environment
  ) -> TypeValue
)(
  ty
);
// ---------------------------------------------------------------------------
// rebuild_list_with_index
// ---------------------------------------------------------------------------
/// Return a new ArrayList(EvalValue) that is a copy of `vals` with the element
/// at `idx` replaced by `new_val`.
///
/// Used when updating compile-time struct/tuple/array/enum field values.
rebuild_list_with_index :: (
  fn(
    vals : ArrayList(EvalValue),
    idx : usize,
    new_val : EvalValue
  ) -> ArrayList(EvalValue)
)({
  result := ArrayList(EvalValue).new();
  n := vals.len();
  (k : usize) = usize(0);
  while(k < n, {
    old_v := match(vals.get(k),.Some(v) => v,.None => EvalValue.UnitVal);
    if(k == idx, {
      result.push(new_val);
    }, {
      result.push(old_v);
    });
    k = (k + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// make_variable_with_value
// ---------------------------------------------------------------------------
/// Return a copy of `v` with the `value` field replaced by `new_value`.
///
/// Used when updating a compile-time variable after field/index assignment.
make_variable_with_value :: (
  fn(
    v : Variable,
    new_value : Option(EvalValue)
  ) -> Variable
)(
  Variable(
    id : v.id,
    name : v.name,
    ty : v.ty,
    is_compile_time_only : v.is_compile_time_only,
    frame_level : v.frame_level,
    value : value_cell_of(new_value),
    is_owning_the_rc_value : v.is_owning_the_rc_value,
    is_owning_the_same_rc_value_as : v.is_owning_the_same_rc_value_as,
    is_reassignable : v.is_reassignable,
    token : v.token,
    initialized_at_token : v.initialized_at_token,
    consumed_at_token : v.consumed_at_token,
    is_implicit : v.is_implicit,
    is_created_from_destructuring_atom_variable : v.is_created_from_destructuring_atom_variable,
    parameter_alias : v.parameter_alias,
    is_from_effect_spread : v.is_from_effect_spread,
    is_effect_param : v.is_effect_param,
    is_module_level : v.is_module_level,
    doc_comment : v.doc_comment,
    is_ref : false,
    is_parameter : false
  )
);
// ---------------------------------------------------------------------------
// get_root_expr_of_field_access
// ---------------------------------------------------------------------------
/// Walk a chained field/index access down to its root atom.
/// For `a.b.c`, returns the `a` atom. For a bare atom `x`, returns it
/// unchanged. Mirrors `getRootExprOfFieldAccess` in `src/evaluator/utils.ts`.
get_root_expr_of_field_access :: (fn(expr : AstExpr) -> AstExpr)(
  if(
    (ast_expr_is_fn_call(expr) && ast_expr_is_fn_call_of(expr, BF_DOT,.None)) && (match(expr,.FnCall(_, _, args, _, _) => args.len(),.Atom(_, _) => usize(0)) >= usize(2)),
    recur(match(expr,.FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => expr),.Atom(_, _) => expr)),
    expr
  )
);
// ---------------------------------------------------------------------------
// get_atomic_object_root_type
// ---------------------------------------------------------------------------
/// Phase O (THREAD_SAFETY): if a field-access expression's root has
/// `atomic object` type, writes through it are forbidden in safe code.
/// Returns the root type if it's an atomic object, `None` otherwise.
/// Resolves SomeType (e.g. `Self`) to concrete types before checking.
/// Mirrors `getAtomicObjectRootType` in `src/evaluator/utils.ts`.
get_atomic_object_root_type :: (
  fn(root_expr : AstExpr, env : Environment) -> Option(TypeValue)
)({
  if(!(ast_expr_is_atom(root_expr)), {
    return(Option(TypeValue).None);
  });
  var_name := ast_expr_token(root_expr).value;
  if(var_name.is_empty(), {
    return(Option(TypeValue).None);
  });
  variables := get_variables_from_env(env, var_name.clone());
  if(variables.len() == usize(0), {
    return(Option(TypeValue).None);
  });
  (root_type : TypeValue) = match(
    variables.get(variables.len() - usize(1)),
    .Some(v) => v.ty,
    .None => return(Option(TypeValue).None)
  );
  // Resolve SomeType (e.g. Self) to its concrete type.
  if(is_some_type(root_type), {
    root_type = get_value_of_some_type_from_env(env, root_type);
  });
  if(
    is_atomic_reference_struct_type(root_type),
    Option(TypeValue).Some(root_type),
    Option(TypeValue).None
  )
});
// ---------------------------------------------------------------------------
// evaluate_assignment
// ---------------------------------------------------------------------------
/// Evaluate an `=` assignment expression.
///
/// Handles:
///   - atom LHS:           `x = rhs`
///   - typed-binding LHS:  `(x : T) = rhs`
///   - property/index LHS: `x.a = rhs`, `arr(0) = rhs`
///
/// Mirrors `evaluateAssignment` in `src/evaluator/exprs/assignment.ts`.
evaluate_assignment :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Validate shape: "=" with exactly 2 args.
  if(!(ast_expr_is_fn_call_of(expr, BK_ASSIGN,.Some(usize(2)))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "=" for assignment.`,
          false,
          .None
        )
      )
    );
  });
  (lhs : AstExpr) = match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  (rhs : AstExpr) = match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(1)),.Some(a) => a,.None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  // -----------------------------------------------------------------------
  // Determine branch: atom LHS, typed-binding LHS, or property/index LHS
  // -----------------------------------------------------------------------
  is_atom_lhs := ast_expr_is_atom(lhs);
  is_typed_binding_lhs := (ast_expr_is_fn_call(lhs) && ast_expr_is_fn_call_of(lhs, BK_COLON,.Some(usize(2))));
  // -----------------------------------------------------------------------
  // Property / index LHS: x.a = rhs, arr(0) = rhs
  // Mirrors the `else` branch in `evaluateAssignment` (lines ~680-1048 of
  // `src/evaluator/exprs/assignment.ts`).
  // -----------------------------------------------------------------------
  if(!(is_atom_lhs || is_typed_binding_lhs), {
    // Phase O: Forbid writing through atomic-object fields in safe code.
    if(!(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(lhs).module_path.clone()))), {
      root_expr := get_root_expr_of_field_access(lhs);
      match(
        get_atomic_object_root_type(root_expr, env),
        .Some(atomic_obj_type) => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(lhs),
                `Cannot write to field of atomic object '${ast_expr_to_string(root_expr)}' (type ${type_to_string(atomic_obj_type)}) in safe code. Atomic objects shared across threads must use AtomicX / Mutex / RwLock for mutation. Use Arc(AtomicI32), Arc(Mutex(T)), or Arc(RwLock(T)) instead.`,
                false,
                .None
              )
            )
          );
        },
        .None => ()
      );
    });
    // Step 1 — Evaluate LHS with is_lhs_of_assignment = true
    saved_expected := ctx.expected_type;
    saved_is_lhs := ctx.is_lhs_of_assignment;
    ctx.expected_type = Option(ExpectedTypeCtx).None;
    ctx.is_lhs_of_assignment = true;
    evaluated_lhs := evaluate_expression_raw(lhs, env, ctx, exn);
    ctx.expected_type = saved_expected;
    ctx.is_lhs_of_assignment = saved_is_lhs;
    lhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_lhs));
    if(lhs_info_opt.is_none(), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `Failed to evaluate left-hand side of assignment: ${ast_expr_to_string(lhs)}`,
            false,
            .None
          )
        )
      );
    });
    lhs_info := match(lhs_info_opt,.Some(i) => i,.None => new_expr_info(env, t_unit()));
    expected_ty := lhs_info.ty;
    // Step 2 — Evaluate RHS with expected type from LHS
    ctx.expected_type = Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : expected_ty, env : env));
    prop_rhs := evaluate_expression_raw(rhs, env, ctx, exn);
    ctx.expected_type = saved_expected;
    prop_rhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(prop_rhs));
    if(prop_rhs_info_opt.is_none(), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(rhs),
            `Failed to evaluate right-hand side of assignment: ${ast_expr_to_string(rhs)}`,
            false,
            .None
          )
        )
      );
    });
    (prop_rhs_info : ExprInfo) = match(
      prop_rhs_info_opt,
      .Some(i) => i,
      .None => new_expr_info(env, t_unit())
    );
    env.frames = prop_rhs_info.env.frames;
    env.module_path = prop_rhs_info.env.module_path;
    env.function_declaration_frame_level = prop_rhs_info.env.function_declaration_frame_level;
    env.input_string = prop_rhs_info.env.input_string;
    // Step 3 — requireExprNotConsumed, throwExprIsImplicitVariableError, setExprAsNeedsToCallDup
    require_expr_not_consumed(prop_rhs, env, ctx, exn);
    throw_expr_is_implicit_variable_error(prop_rhs, env, ctx, exn);
    set_expr_as_needs_to_call_dup(prop_rhs, ctx, exn);
    // Re-read rhs info after potential mutations by the above helpers.
    prop_rhs_info = match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(prop_rhs)),
      .Some(i) => i,
      .None => new_expr_info(env, t_unit())
    );
    env.frames = prop_rhs_info.env.frames;
    env.module_path = prop_rhs_info.env.module_path;
    env.function_declaration_frame_level = prop_rhs_info.env.function_declaration_frame_level;
    env.input_string = prop_rhs_info.env.input_string;
    // Step 3b — Slice-flowability at the FIELD/INDEX-write boundary (the
    // sibling of the simple-variable gate). Writing a raw-pointer-carrying
    // value (`Slice`/`str`/aggregate) into `holder.s` / `arr(0)` must root
    // the RHS in storage that outlives the field's CONTAINER, else the slice
    // outlives its backing through the container (a use-after-free reachable
    // from safe code). The container's lifetime is that of the access chain's
    // root binding (`holder`/`arr`): pass its frame level as
    // `max_local_frame_level` so an inner-block local source is rejected while
    // a `ref` param / enclosing-scope local / parameter / comptime is
    // accepted. Mirrors src/evaluator/exprs/assignment.ts. Throws directly
    // (this path runs at module/test level — not behind the def-eval swallow).
    if(type_representation_contains_raw_ptr(expected_ty) && (!(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(lhs).module_path.clone())))), {
      prop_root_expr := get_root_expr_of_field_access(lhs);
      (container_frame_level : i64) = i64(-(1));
      if(ast_expr_is_atom(prop_root_expr), {
        prop_root_vars := get_variables_from_env(env, ast_expr_token(prop_root_expr).value.clone());
        if(prop_root_vars.len() > usize(0), {
          match(
            prop_root_vars.get(prop_root_vars.len() - usize(1)),
            .Some(rv) => {
              container_frame_level = i64(rv.frame_level);
            },
            .None => ()
          );
        });
      });
      (prop_max_local : Option(usize)) = cond(
        (container_frame_level < i64(0)) => Option(usize).Some(usize(0)),
        true => Option(usize).Some(usize(container_frame_level))
      );
      // container_frame_level < 0 (unresolvable root) → strictest: use 0 as a
      // bound that no real inner-block local can be <= unless module-level,
      // and rely on parameter/comptime/ref sources still being accepted.
      prop_flow_opts := FlowOptions(
        allow_same_frame_local : (container_frame_level >= i64(0)),
        allow_parameter_source : true,
        allow_comptime_source : true,
        max_local_frame_level : prop_max_local
      );
      if(!(is_flowable_expr(prop_rhs, ctx, prop_flow_opts)), {
        prop_viol_msg := `Writing into '${ast_expr_to_string(lhs)}' (type '${type_to_string(expected_ty)}') a value that carries a raw pointer in its representation; the value must be rooted in storage that outlives the field's container. The assigned expression is not flowable:\n  ${ast_expr_to_string(rhs)}\n\nThis would let the slice/pointer outlive its backing storage through the container — a use-after-free.\n\nFlowable sources: a 'ref'-bound parameter; a non-'ref' parameter; a 'comptime' constant or string literal; a local whose scope encloses the container; '.field' on a flowable base; a call returning ref or slice with flowable arguments; or a 'cond'/'match' whose arms are all flowable.`;
        // Flag so a def-time trial-eval swallow re-raises it via the real `exn`
        // (function_type.yo), mirroring the simple-variable assignment gate.
        flag_flow_violation(prop_viol_msg);
        exn.throw(dyn(format_error_message(ast_expr_token(rhs), prop_viol_msg, false,.None)));
      });
    });
    // Step 4 — Type compatibility check
    (prop_rhs_type : TypeValue) = prop_rhs_info.ty;
    if(!((is_comptime_int_type(expected_ty) || is_comptime_float_type(expected_ty)) || is_comptime_string_type(expected_ty)), {
      // Pass the EXPECTED type: TS threads `expectedType: expectedType`
      // (assignment.ts:976-982) so a `comptime_str` assigned into a `*(u8)` /
      // `*(char)` target converts to THAT pointer type rather than defaulting
      // to `str` (types/utils.ts:963-979). Without the hint the check below
      // compares `*(u8)` against `str` and rejects
      // `(path : *(u8)) = "…"` — the C-string-literal form.
      prop_rhs_type = convert_comptime_type_to_runtime_type_with_expected(
        prop_rhs_type,
        Option(TypeValue).Some(expected_ty),
        env
      );
      // TS also passes `expr: rhs`, and the helper stores the result on
      // `expr.$.convertedRuntimeType` (types/utils.ts:985-988). Codegen needs
      // it: generate_comptime_value emits a StrLit as the `__yo_str` struct
      // when the type it is handed is str/comptime_str, and as a bare C string
      // literal otherwise — so without this a `*(u8)` target still gets the
      // struct form and the C assignment is ill-typed.
      if((is_comptime_int_type(prop_rhs_info.ty) || is_comptime_float_type(prop_rhs_info.ty)) || is_comptime_string_type(prop_rhs_info.ty), {
        prop_rhs_info.converted_runtime_type = Option(TypeValue).Some(prop_rhs_type.clone());
      });
    });
    if(!(are_types_compatible(expected_ty, prop_rhs_type)), {
      exp_str := type_to_string(expected_ty);
      rhs_str := type_to_string(prop_rhs_type);
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `Incompatible types:\n- Expected: ${exp_str}\n- Given   : ${rhs_str}`,
            false,
            .None
          )
        )
      );
    });
    // Step 5 — Update compile-time value via path_collection
    // Mirrors the pathCollection[0].length >= 2 branch in assignment.ts.
    (is_comptime_only_prop : bool) = false;
    prop_path_col := lhs_info.path_collection;
    if(prop_path_col.len() > usize(0), {
      prop_path := match(prop_path_col.get(usize(0)),.Some(p) => p,.None => ArrayList(String).new());
      if(prop_path.len() >= usize(2), {
        pc_var_name := match(prop_path.get(usize(0)),.Some(s) => s,.None => String.from(""));
        pc_field_or_idx := match(prop_path.get(usize(1)),.Some(s) => s,.None => String.from(""));
        pc_vars := get_variables_from_env(env, pc_var_name);
        if(pc_vars.len() > usize(0), {
          pc_var := match(
            pc_vars.get(pc_vars.len() - usize(1)),
            .Some(v) => v,
            .None => make_err_variable(env)
          );
          if(pc_var.is_compile_time_only && pc_var.value.get(usize(0)).is_some(), {
            pc_cur_val := match(pc_var.value.get(usize(0)),.Some(v) => v,.None => EvalValue.UnitVal);
            if(prop_rhs_info.value.is_some(), {
              is_comptime_only_prop = true;
            });
            cond(
              (is_struct_val(pc_cur_val) || is_tuple_val(pc_cur_val)) => {
                // Find field index in the type.
                (struct_fi : i64) = i64(-(1));
                match(
                  pc_var.ty,
                  .Struct({ field_labels : s_flabels }) => {
                    n_sf := s_flabels.len();
                    (k_sf : usize) = usize(0);
                    while(k_sf < n_sf, {
                      s_lbl := match(s_flabels.get(k_sf),.Some(s) => s,.None => String.from(""));
                      if(s_lbl == pc_field_or_idx, {
                        struct_fi = i64(k_sf);
                        k_sf = n_sf;
                      }, {
                        k_sf = (k_sf + usize(1));
                      });
                    });
                  },
                  .Tuple(t_flabels, _) => {
                    n_tf := t_flabels.len();
                    (k_tf : usize) = usize(0);
                    while(k_tf < n_tf, {
                      t_lbl := match(t_flabels.get(k_tf),.Some(s) => s,.None => String.from(""));
                      if(t_lbl == pc_field_or_idx, {
                        struct_fi = i64(k_tf);
                        k_tf = n_tf;
                      }, {
                        k_tf = (k_tf + usize(1));
                      });
                    });
                  },
                  _ => ()
                );
                if((struct_fi >= i64(0)) && prop_rhs_info.value.is_some(), {
                  pc_rhs_val := match(prop_rhs_info.value,.Some(v) => v,.None => EvalValue.UnitVal);
                  fi_us := usize(struct_fi);
                  is_ref_sem := match(
                    pc_var.ty,
                    .Struct({ is_reference_semantics : is_ref }) => is_ref,
                    _ => false
                  );
                  if(is_ref_sem, {
                    // Reference semantics: update all variables that share the same
                    // compile-time struct value.
                    // Note: yo-self uses deep equality (eval_value_eq) as an
                    // approximation for TypeScript's reference identity (===).
                    all_env_vars := get_all_variables_from_env(env);
                    n_av := all_env_vars.len();
                    (k_av : usize) = usize(0);
                    while(k_av < n_av, {
                      av := match(all_env_vars.get(k_av),.Some(v) => v,.None => make_err_variable(env));
                      // Avoid && short-circuit with match on RHS to prevent codegen
                      // scope bug (temp declared in if-block, dropped outside).
                      (is_same_val : bool) = false;
                      if(av.is_compile_time_only, {
                        is_same_val = match(
                          av.value.get(usize(0)),
                          .Some(avv) => eval_value_eq(avv, pc_cur_val),
                          .None => false
                        );
                      });
                      if(is_same_val, {
                        new_ref_opt := match(
                          av.value.get(usize(0)),
                          .Some(av_inner) => match(
                            av_inner,
                            .StructVal(tn, fnames, fvals) =>
                              Option(EvalValue).Some(EvalValue.StructVal(tn, fnames, rebuild_list_with_index(fvals, fi_us, pc_rhs_val))),
                            _ => av.value.get(usize(0))
                          ),
                          .None => av.value.get(usize(0))
                        );
                        update_existing_variable(env, av, make_variable_with_value(av, new_ref_opt));
                      });
                      k_av = (k_av + usize(1));
                    });
                  }, {
                    // Value semantics: update only this variable.
                    new_vs_opt := cond(
                      is_struct_val(pc_cur_val) =>
                        match(
                          pc_cur_val,
                          .StructVal(tn, fnames, fvals) =>
                            Option(EvalValue).Some(EvalValue.StructVal(tn, fnames, rebuild_list_with_index(fvals, fi_us, pc_rhs_val))),
                          _ => pc_var.value.get(usize(0))
                        ),
                      true =>
                        match(
                          pc_cur_val,
                          .TupleVal(fvals) =>
                            Option(EvalValue).Some(EvalValue.TupleVal(rebuild_list_with_index(fvals, fi_us, pc_rhs_val))),
                          _ => pc_var.value.get(usize(0))
                        )
                    );
                    update_existing_variable(env, pc_var, make_variable_with_value(pc_var, new_vs_opt));
                  });
                });
              },
              is_array_val(pc_cur_val) => {
                arr_idx_i64 := match(parse_raw_int(pc_field_or_idx),.Some(v) => v,.None => i64(-(1)));
                if((arr_idx_i64 >= i64(0)) && prop_rhs_info.value.is_some(), {
                  pc_rhs_arr := match(prop_rhs_info.value,.Some(v) => v,.None => EvalValue.UnitVal);
                  arr_idx_us := usize(arr_idx_i64);
                  new_arr_opt := match(
                    pc_cur_val,
                    .ArrayVal(elems) =>
                      cond(
                        (arr_idx_us < elems.len()) =>
                          Option(EvalValue).Some(EvalValue.ArrayVal(rebuild_list_with_index(elems, arr_idx_us, pc_rhs_arr))),
                        true => pc_var.value.get(usize(0))
                      ),
                    _ => pc_var.value.get(usize(0))
                  );
                  update_existing_variable(env, pc_var, make_variable_with_value(pc_var, new_arr_opt));
                });
              },
              is_enum_val(pc_cur_val) => {
                match(
                  pc_cur_val,
                  .EnumVal(ev_variant, ev_fields) => {
                    // Find variant index, then field index within that variant.
                    (ev_fi : i64) = i64(-(1));
                    match(
                      pc_var.ty,
                      .EnumT(_, _, ev_vnames, _, _, ev_vf_labels, _, _, _) => {
                        n_vn := ev_vnames.len();
                        (k_vn : usize) = usize(0);
                        (vi : usize) = n_vn; // sentinel: not found
                        while(k_vn < n_vn, {
                          vn := match(ev_vnames.get(k_vn),.Some(s) => s,.None => String.from(""));
                          if(vn == ev_variant, {
                            vi = k_vn;
                            k_vn = n_vn;
                          }, {
                            k_vn = (k_vn + usize(1));
                          });
                        });
                        if(vi < n_vn, {
                          vf_labels := match(ev_vf_labels.get(vi),.Some(l) => l,.None => ArrayList(String).new());
                          n_vfl := vf_labels.len();
                          (k_vfl : usize) = usize(0);
                          while(k_vfl < n_vfl, {
                            fl := match(vf_labels.get(k_vfl),.Some(s) => s,.None => String.from(""));
                            if(fl == pc_field_or_idx, {
                              ev_fi = i64(k_vfl);
                              k_vfl = n_vfl;
                            }, {
                              k_vfl = (k_vfl + usize(1));
                            });
                          });
                        });
                      },
                      _ => ()
                    );
                    if((ev_fi >= i64(0)) && prop_rhs_info.value.is_some(), {
                      pc_rhs_enum := match(prop_rhs_info.value,.Some(v) => v,.None => EvalValue.UnitVal);
                      ev_fi_us := usize(ev_fi);
                      new_ev_opt := Option(EvalValue).Some(
                        EvalValue.EnumVal(ev_variant, rebuild_list_with_index(ev_fields, ev_fi_us, pc_rhs_enum))
                      );
                      update_existing_variable(env, pc_var, make_variable_with_value(pc_var, new_ev_opt));
                    });
                  },
                  _ => ()
                );
              },
              true => ()
            );
          });
        });
      });
    });
    // Step 6 — Handle comptimeRef: direct in-place mutation of shared ArrayList.
    // Mirrors the `comptimeRef` block in assignment.ts (lines ~982-1001).
    match(
      lhs_info.comptime_ref,
      .None => (),
      .Some(cr) => {
        match(
          prop_rhs_info.value,
          .None => (),
          .Some(cr_rhs_val) => {
            match(
              cr,
              .ArrayRef(cr_elements, cr_index) => {
                cr_elements(cr_index) = cr_rhs_val;
              },
              .ComptimeListRef(cr_elements, cr_index) => {
                cr_elements(cr_index) = cr_rhs_val;
              },
              .StructRef(cr_field_values, cr_field_index) => {
                cr_field_values(cr_field_index) = cr_rhs_val;
              },
              .TupleRef(cr_fields, cr_field_index) => {
                cr_fields(cr_field_index) = cr_rhs_val;
              }
            );
            is_comptime_only_prop = true;
          }
        );
      }
    );
    // Step 7 — Fallback: a compile-time-only field/index write (both LHS and RHS
    // have values, LHS is not an Index-trait lvalue). Mirrors assignment.ts
    // 1013-1019, which ONLY sets this inside `if (variable.isCompileTimeOnly ...)`
    // — i.e. the flag requires the BASE VARIABLE to be compile-time-only. Without
    // that guard, a RUNTIME field write whose value is an UnknownVal (which is
    // still `.is_some()`) — e.g. `self.field = ...` inside a method body — was
    // wrongly marked comptime-only, so codegen (assignment.yo:40) emitted NOTHING
    // and every mutating method silently no-op'd.
    base_var_is_comptime := {
      bvn := match(
        lhs_info.path_collection.get(usize(0)),
        .Some(p) => match(p.get(usize(0)),.Some(s) => s,.None => String.from("")),
        .None => String.from("")
      );
      if(bvn.len() == usize(0), false, {
        bvars := get_variables_from_env(env, bvn);
        if(bvars.len() == usize(0), false, match(bvars.get(bvars.len() - usize(1)),.Some(v) => v.is_compile_time_only,.None => false))
      })
    };
    if(((!(is_comptime_only_prop) && lhs_info.value.is_some()) && prop_rhs_info.value.is_some()) && base_var_is_comptime, {
      if(lhs_info.index_trait_ptr_type.is_none(), {
        is_comptime_only_prop = true;
      });
    });
    // Step 8 — Write ExprInfo for the whole `=` expression.
    prop_ei := new_expr_info(env, lhs_info.ty);
    prop_ei.value = lhs_info.value;
    prop_ei.is_compile_time_only_assignment = Option(bool).Some(is_comptime_only_prop);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), prop_ei);
    // Step 9 — Attach temp variable (no-op stub in Phase 2x; full impl in Phase 3).
    if(!(is_comptime_only_prop), {
      attach_temp_variable_to_expr(expr, true, ctx);
    });
    return(expr);
  });
  // ------------------------------------------------------------------
  // Atom / typed-binding LHS path (unchanged from Phase 2v)
  // ------------------------------------------------------------------
  // ------------------------------------------------------------------
  // Derive variable_name and update env/lhs for both LHS kinds.
  // ------------------------------------------------------------------
  (variable_name : String) = String.from("");
  (lhs_resolved : AstExpr) = lhs;
  cond(
    is_atom_lhs => {
      // Simple identifier: x = rhs
      // For a plain identifier we just read the name from its token.
      // (Full evaluateIdentifierAndOperator is a Phase 3 concern.)
      variable_name = ast_expr_token(lhs).value.clone();
    },
    true => {
      // Typed binding: (x : T) = rhs — defer the generic-fn-type check to
      // the deferred recheck after the RHS eval below (TS assignment.ts:210).
      set_defer_generic_fn_type_check(true);
      binding := evaluate_binding(lhs, env, ctx, exn);
      set_defer_generic_fn_type_check(false);
      binding_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(binding.expr));
      match(
        binding_info_opt,
        .Some(info) => {
          env.frames = info.env.frames;
          env.module_path = info.env.module_path;
          env.function_declaration_frame_level = info.env.function_declaration_frame_level;
          env.input_string = info.env.input_string;
        },
        .None => ()
      );
      variable_name = binding.variable_name.clone();
      lhs_resolved = binding.variable_expr;
    }
  );
  // Disallow reassignment to "_"
  if(variable_name == "_", {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs_resolved),
          `Cannot reassign "_". Use ":=" to discard a value, or use a named variable for reassignment.`,
          false,
          .None
        )
      )
    );
  });
  // Look up the variable.
  vars := get_variables_from_env(env, variable_name);
  if(vars.len() == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs_resolved),
          `Variable ${variable_name} not found in the environment`,
          false,
          .None
        )
      )
    );
  });
  // The if-check above guarantees vars is non-empty here; the .None arm is unreachable.
  variable := match(vars.get(vars.len() - usize(1)),.Some(v) => v,.None => make_err_variable(env));
  // Closure capture tracking — a WRITE to an outer variable from inside a
  // function body / async block is a capture too (mirrors assignment.ts:667
  // calling trackVariableUsage with usage "own"). Reads are tracked by the
  // identifier evaluator; without this, a closure whose only reference to an
  // outer variable is an assignment (`(...) => { x = v; }`) recorded NO
  // capture and the ref-capture gate never saw `x`
  // (tests/ref_closure_capture.test.yo `make_writer`). The tracking helper
  // itself guards on the body-evaluation context, the outer-frame threshold,
  // and compile-time-only variables.
  track_variable_usage(
    variable.name,
    variable.frame_level,
    CaptureUsage.Own,
    ast_expr_token(lhs_resolved),
    ctx
  );
  // Check reassignability.
  if(!(variable.is_reassignable), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs_resolved),
          `Cannot reassign "${variable_name}".\nYou can mutate fields (e.g., ${variable_name}.field = value) but cannot reassign itself.`,
          false,
          .None
        )
      )
    );
  });
  // Evaluate the RHS.
  // Pass the variable type as expected type for coercion hints.
  old_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).Some(
    ExpectedTypeCtx(
      ty : variable.ty,
      env : env
    )
  );
  (rhs_evaled : AstExpr) = evaluate_expression_raw(rhs, env, ctx, exn);
  ctx.expected_type = old_expected;
  rhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs_evaled));
  if(rhs_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(rhs),
          `Failed to evaluate right-hand side of assignment: ${ast_expr_to_string(rhs)}`,
          false,
          .None
        )
      )
    );
  });
  rhs_info := match(rhs_info_opt,.Some(i) => i,.None => new_expr_info(env, t_unit()));
  // Deferred generic-fn-type check (TS assignment.ts:438-470): reject a
  // runtime variable with a GENERIC function type unless the bound lambda's
  // body provably ALWAYS unwinds — such a ctl handler never delivers its
  // generic'd return through the C fn pointer, so the ABI mismatch the rule
  // guards against is moot (the `Exception { throw : ctl(generic(ResumeType),
  // …) }` shape as a local binding; async_await "unwind in async closure").
  if((!(variable.is_compile_time_only)) && (is_function_type(variable.ty) && is_function_type_generic(variable.ty)), {
    (dgc_proven : bool) = false;
    match(
      rhs_info.value,
      .Some(dgc_v) => match(
        dgc_v,
        .FuncVal(dgc_fvd, _) => {
          dgc_proven = all_paths_unwind(dgc_fvd.*.body);
        },
        _ => ()
      ),
      .None => ()
    );
    if(!(dgc_proven), {
      dgc_ty_str := type_to_string(variable.ty);
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs_resolved),
            `Runtime variables with generic function types are not allowed:
${dgc_ty_str}

Generic functions must be compile-time known to enable monomorphization. Consider using:
comptime(${variable_name}) : ${dgc_ty_str}

(Carve-out: a ctl handler whose body always unwinds is accepted automatically; the analysis did not see an all-paths-unwind body.)`,
            false,
            .None
          )
        )
      );
    });
  });
  env.frames = rhs_info.env.frames;
  env.module_path = rhs_info.env.module_path;
  env.function_declaration_frame_level = rhs_info.env.function_declaration_frame_level;
  env.input_string = rhs_info.env.input_string;
  // Slice-flowability at the assignment boundary (assignment.ts:263-297). When
  // the TARGET's type carries a raw pointer (Slice/str/aggregate-thereof; owned
  // object types like String/ArrayList are excluded by the predicate), the RHS
  // must be rooted in storage that OUTLIVES the target binding. `=` can target
  // an outer-scope binding, so pass the target's `frame_level` as
  // `max_local_frame_level`: a same-frame/local source is accepted only if its
  // scope encloses the target's (level <= target). Parameters, comptime values
  // and `ref`-bound names outlive the function and are always accepted.
  // Privileged files (pragma AllowUnsafe) are exempt, mirroring the sibling
  // return-position gate — raw-pointer manipulation like `p = &(x)` is exactly
  // what those files declare (assignment.ts gate, same exemption). Mirrors the
  // binding-site check, but `:=` is always innermost so only `=` reassignment
  // can invert scope.
  if(type_representation_contains_raw_ptr(variable.ty) && (!(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(rhs).module_path.clone())))), {
    assign_flow_opts := FlowOptions(
      allow_same_frame_local : true,
      allow_parameter_source : true,
      allow_comptime_source : true,
      max_local_frame_level : Option(usize).Some(variable.frame_level)
    );
    if(!(is_flowable_expr(rhs_evaled, ctx, assign_flow_opts)), {
      viol_msg := `Assigning to '${variable_name}' (type '${type_to_string(variable.ty)}') a value that carries a raw pointer in its representation; the value must be rooted in storage that outlives '${variable_name}'. The assigned expression is not flowable:\n  ${ast_expr_to_string(rhs)}`;
      // Flag the violation so a def-time trial-eval swallow re-raises it via the
      // real `exn` (function_type.yo), mirroring the `inout(name) :=` binding-site.
      flag_flow_violation(viol_msg);
      exn.throw(dyn(format_error_message(ast_expr_token(rhs), viol_msg, false,.None)));
    });
  });
  // Check if the LHS variable was consumed by the RHS (e.g., via own parameter).
  // This happens in patterns like `v = v.push(x)` where push takes own(self).
  // If consumed, we must NOT create a temp variable to save the old value,
  // because the old value's ownership was transferred to the callee.
  // Mirrors assignment.ts:305-315.
  lhs_consumed_by_rhs := {
    cvars := get_variables_from_env(env, variable_name);
    cond(
      (cvars.len() > usize(0)) => match(
        cvars.get(cvars.len() - usize(1)),
        .Some(lv) => lv.consumed_at_token.is_some(),
        .None => false
      ),
      true => false
    )
  };
  // Check if the RHS variable has been consumed (moved). Mirrors assignment.ts:318.
  require_expr_not_consumed(rhs_evaled, env, ctx, exn);
  // Under the new ownership model, all assignments transfer ownership, so we
  // always need to call dup on the RHS. Without this, codegen emits the
  // scope-end drop for the (owning) LHS binding but no matching dup — every
  // `(x : T) = rhs` / `x = rhs` whose RHS is a borrowed RC value net-releases
  // the caller's object (the stage-2 Environment UAF). Mirrors assignment.ts:321.
  set_expr_as_needs_to_call_dup(rhs_evaled, ctx, exn);
  // Re-read env in case set_expr_as_needs_to_call_dup updated it (TS: env = rhs.$.env).
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs_evaled)),
    .Some(ri_after_dup) => {
      env.frames = ri_after_dup.env.frames;
      env.module_path = ri_after_dup.env.module_path;
      env.function_declaration_frame_level = ri_after_dup.env.function_declaration_frame_level;
      env.input_string = ri_after_dup.env.input_string;
    },
    .None => ()
  );
  // Check control flow.
  if(has_any_control_flow(rhs_info.control_flow), {
    match(
      rhs_info.control_flow,
      .Some(cf) => throw_rhs_contains_control_flow_expression_error(rhs_evaled, cf, exn),
      .None => () // unreachable: has_any_control_flow guarantees .Some
    );
  });
  // Resolve the RHS type.
  (rhs_type : TypeValue) = rhs_info.ty;
  // Convert comptime types to runtime types when the variable is not comptime-only.
  if(!(variable.is_compile_time_only), {
    // Expected-type-aware (TS assignment.ts:360-366 passes
    // `expectedType: variable.type`): a `comptime_str` assigned to a
    // `*(u8)` / `*(char)` variable becomes that pointer type, not `str`.
    rhs_type = convert_comptime_type_to_runtime_type_with_expected(
      rhs_type,
      Option(TypeValue).Some(variable.ty),
      env
    );
    // Mirror TS's `expr: rhs` side-effect (types/utils.ts:985-988) — see the
    // property-assignment site above for why codegen needs it.
    if((is_comptime_int_type(rhs_info.ty) || is_comptime_float_type(rhs_info.ty)) || is_comptime_string_type(rhs_info.ty), {
      rhs_info.converted_runtime_type = Option(TypeValue).Some(rhs_type.clone());
    });
  });
  // Type-compatibility check.
  if(!(are_types_compatible(variable.ty, rhs_type)), {
    var_ty_str := type_to_string(variable.ty);
    rhs_ty_str := type_to_string(rhs_type);
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs_resolved),
          `Incompatible types:\n- Expected: ${var_ty_str}\n- Given   : ${rhs_ty_str}`,
          false,
          .None
        )
      )
    );
  });
  // Re-fetch variable after RHS evaluation (env may have been updated).
  updated_vars := get_variables_from_env(env, variable_name);
  updated_variable := match(
    updated_vars.get(updated_vars.len() - usize(1)),
    .Some(v) => v,
    .None => make_err_variable(env)
  );
  // Determine whether this is initialisation (first assignment) or reassignment.
  is_mutating_defined_variable := updated_variable.initialized_at_token.is_some();
  // First-initialisation scope gate (assignment.ts:557-574): a declared-but-
  // uninitialised variable may only be initialised in the scope that declared
  // it — initialising one defined OUTSIDE the current function body is an
  // error (the function may never be called, and its body must not initialise
  // caller-scope storage).
  //
  // The TS while-loop twin (assignment.ts:539-555) is deliberately NOT ported:
  // yo-self's mutable-shared frames make the frame-level oracle unreliable
  // there — measured on tests/codegen-bootstrap/arraylist_index_call.yo, a
  // body-local `(b : u8) = al(i)` inside `while` carried frame_level 3 against
  // a loop-entry frame count of 4, so the gate wrongly fired and the swallowed
  // throw dropped the loop from the emitted C (corpus DIFF).
  if(!(is_mutating_defined_variable), {
    // While-loop twin (assignment.ts:541-555): a variable declared OUTSIDE
    // the loop may not be first-initialised inside its body (the loop may run
    // zero times, and iteration 2 would re-init). The first port of this gate
    // was reverted: it read the LIVE shared env's frame count, which had
    // grown past loop entry by the time the gate ran, so body-locals compared
    // as "outside" (corpus DIFF on arraylist_index_call.yo). The
    // entry_frame_count SNAPSHOT taken by while.yo restores TS's persistent-
    // env semantics.
    match(
      ctx.is_evaluating_loop_body,
      .Some(loop_ctx) => {
        if(updated_variable.frame_level < loop_ctx.entry_frame_count, {
          wl_entries := ArrayList(TokenAndError).new();
          wl_entries.push(
            TokenAndError(
              token : ast_expr_token(lhs_resolved),
              error_message : String.from("Cannot initialize a variable that is defined outside the while loop.")
            )
          );
          wl_entries.push(
            TokenAndError(
              token : updated_variable.token,
              error_message : String.from("Defined here:")
            )
          );
          exn.throw(dyn(format_error_messages(wl_entries, false,.None)));
        });
      },
      .None => ()
    );
    match(
      ctx.is_evaluating_function_body_or_async_block,
      .Some(of_ctx) => match(
        of_ctx.kind,
        .FunctionBody => {
          if(updated_variable.frame_level < of_ctx.eval_env.frames.len(), {
            of_entries := ArrayList(TokenAndError).new();
            of_entries.push(
              TokenAndError(
                token : ast_expr_token(lhs_resolved),
                error_message : String.from("Cannot initialize a variable that is defined outside the function body.")
              )
            );
            of_entries.push(
              TokenAndError(
                token : updated_variable.token,
                error_message : String.from("Defined here:")
              )
            );
            exn.throw(dyn(format_error_messages(of_entries, false,.None)));
          });
        },
        _ => ()
      ),
      .None => ()
    );
  });
  // Impl(...) reassignment rule (TS assignment.ts:635-655): a SomeType
  // variable whose concrete type is already fixed (Impl uses static dispatch)
  // cannot be reassigned. Generic type parameters WITHOUT a resolved concrete
  // type stay reassignable. "Already assigned" must be judged on the CURRENT
  // control-flow path: yo-self's shared mutable Variable is stamped
  // initialized by the FIRST cond arm, so a sibling arm's own first
  // assignment would false-positive here — has_dominating_branch_init
  // consults cond.yo's branch-group windows to exclude sibling-arm records
  // (TS's per-branch child envs make them invisible for free).
  if(is_mutating_defined_variable, {
    impl_resolved := match(
      updated_variable.ty,
      .SomeT(id : some_id, resolved_concrete : some_cell) => ((some_cell.len() > usize(0)) || lookup_some_resolved_concrete(some_id).is_some()),
      _ => false
    );
    if(impl_resolved && has_dominating_branch_init(updated_variable.id), {
      ra_entries := ArrayList(TokenAndError).new();
      ra_entries.push(
        TokenAndError(
          token : ast_expr_token(lhs_resolved),
          error_message : `Cannot reassign variable "${variable_name}" of type Impl(...).\nImpl(...) uses static dispatch and the concrete type is fixed at first assignment.\nConsider using Dyn(...) for dynamic dispatch if you need to reassign to different implementations.`
        )
      );
      ra_entries.push(
        TokenAndError(
          token : match(updated_variable.initialized_at_token,.Some(t) => t,.None => updated_variable.token),
          error_message : String.from("First assigned here:")
        )
      );
      exn.throw(dyn(format_error_messages(ra_entries, false,.None)));
    });
  });
  // Record FIRST-INITIALIZATIONS into the per-branch init log — consumed by
  // merge_and_check_envs's cross-branch type checks (see expr_info.yo's
  // BranchInitRecord: the shared mutable Variable cannot carry per-branch
  // types). The RHS's closure capture struct rides along for the Impl(...)
  // static-dispatch rule.
  // Record EVERY assignment (not just first-inits): the shared Variable is
  // stamped initialized by the FIRST arm's eval, so a sibling arm's
  // first-per-branch assignment reads as a "reassignment" here. The merge
  // keeps the LAST record per (arm window, var id).
  record_branch_init(updated_variable.id.clone(), rhs_type, rhs_info.capture_type);
  // Store the RHS value for comptime-only variables; runtime vars don't carry a value.
  value_to_store := cond(
    (updated_variable.is_compile_time_only) => rhs_info.value,
    true => Option(EvalValue).None
  );
  // Update the variable in the environment.
  new_variable := Variable(
    id : updated_variable.id,
    name : updated_variable.name,
    // A labeled tuple declaration keeps its DECLARED type when a positional
    // tuple flows in: TS's variableType is always the declared type (never
    // the RHS), so `(t2 : Tuple(a : i32, ...)) = (1, ...)` still resolves
    // `t2.a` afterwards. Scoped to tuples — yo-self otherwise deliberately
    // adopts rhs_type (enum selected-variant, SomeT resolution riders).
    ty : cond(
      (is_tuple_type(updated_variable.ty) && is_tuple_type(rhs_type)) => updated_variable.ty,
      true => rhs_type
    ),
    is_compile_time_only : updated_variable.is_compile_time_only,
    frame_level : updated_variable.frame_level,
    value : value_cell_of(value_to_store),
    // A `ref` binding/parameter NEVER owns: writing through the borrow
    // stores into the OWNER's storage. Mirrors TS assignment.ts
    // (`variable.isRef ? false : typeContainsRcType(...)`) — flipping a
    // borrow to owning generated a spurious scope-end drop / double free
    // (issues/fixed/codegen-ref-binding-to-object-field-missing-addressof.md).
    is_owning_the_rc_value : cond(
      updated_variable.is_ref => false,
      true => type_contains_rc_type(rhs_type)
    ),
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : updated_variable.is_reassignable,
    token : updated_variable.token,
    // First initialization stamps the token; a REASSIGNMENT must preserve it.
    // TS also writes `initializedAtToken: lhs.token` here, but its persistent
    // env means exprs BEFORE the reassignment keep a snapshot with the original
    // token. yo-self shares one mutable Variable (END-of-scope env), so moving
    // the token forward makes _keep_pending_drop's forward-reference guard
    // (codegen/exprs/return.yo) treat the local as not-yet-declared at every
    // EARLIER return and skip its drop — the ee/ge Environment leak in
    // _synthesize_types_impl's anti-circularity early return.
    initialized_at_token : if(
      is_mutating_defined_variable,
      updated_variable.initialized_at_token,
      Option(Token).Some(ast_expr_token(lhs_resolved))
    ),
    consumed_at_token : Option(Box(Token)).None,
    is_implicit : updated_variable.is_implicit,
    is_created_from_destructuring_atom_variable : updated_variable.is_created_from_destructuring_atom_variable,
    parameter_alias : updated_variable.parameter_alias,
    is_from_effect_spread : updated_variable.is_from_effect_spread,
    is_effect_param : updated_variable.is_effect_param,
    is_module_level : updated_variable.is_module_level,
    doc_comment : updated_variable.doc_comment,
    // Preserve the borrow/parameter flags across reassignment (1:1 with
    // the TS `...variable` spread — the previous `false` literals DROPPED
    // is_ref on write-through, silently disabling the ref-aware gates).
    is_ref : updated_variable.is_ref,
    is_parameter : updated_variable.is_parameter
  );
  update_existing_variable(env, updated_variable, new_variable);
  // A comptime fn-typed variable just received its FuncVal — a FORWARD
  // DECLARATION (`comptime(is_odd) : (fn ...)`) is now filled. Re-run any
  // pending def-time body evals whose captures referenced it while it was
  // valueless (function_type.yo's pending table, via context.yo's hook) so
  // their call-site ExprInfos record the FuncVal before codegen reads them
  // (fn arm 14's mutual recursion).
  if(updated_variable.is_compile_time_only && is_function_type(updated_variable.ty), {
    if(match(value_to_store,.Some(vts) => match(vts,.FuncVal(_, _) => true, _ => false),.None => false), {
      call_rerun_pending_def_evals(env, ctx);
    });
  });
  // Write ExprInfo for the lhs.
  lhs_path := ArrayList(String).new();
  lhs_path.push(variable_name);
  lhs_info2 := new_expr_info(env, rhs_type);
  lhs_info2.path_collection.push(lhs_path);
  lhs_info2.variable_name =.Some(variable_name);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(lhs_resolved), lhs_info2);
  // Write ExprInfo for the whole `=` expression. Mirrors assignment.ts:759-800:
  // - initialization (variable not yet initialized) → unit info;
  // - reassignment whose old value was consumed by the RHS (e.g. passed to an
  //   `own` parameter) → unit info: the callee owns the old value, no temp;
  // - otherwise (real reassignment) → info carrying the OLD value/type plus an
  //   attached temp variable, so codegen saves the old value into the temp and
  //   drop-tracks it (balances the dup-on-store above).
  if(!(is_mutating_defined_variable) || lhs_consumed_by_rhs, {
    expr_info := new_expr_info(env, t_unit());
    expr_info.value =.Some(EvalValue.UnitVal);
    expr_info.is_compile_time_only_assignment =.Some(variable.is_compile_time_only);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
  }, {
    // NOTE: This should return the original value of lhs.
    expr_info := new_expr_info(env, variable.ty);
    expr_info.value = variable.value.get(usize(0));
    expr_info.is_compile_time_only_assignment =.Some(variable.is_compile_time_only);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
    // This temp variable is used to hold the old value of lhs.
    // (yo-self divergence: attach_temp_variable_to_expr takes no
    // is_owning_the_same_rc_value_as optimization argument.)
    attach_temp_variable_to_expr(expr, true, ctx);
  });
  expr
});
export(
  throw_rhs_contains_control_flow_expression_error,
  resolve_unknown_values_and_some_type_in_type,
  rebuild_list_with_index,
  make_variable_with_value,
  evaluate_assignment
);
