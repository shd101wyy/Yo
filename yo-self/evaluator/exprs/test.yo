//! test — evaluate `test("name", { body })` declarations.
//!
//! 1:1 port of `src/evaluator/exprs/test.ts`.
//!
//! During normal compilation, test declarations are skipped (no-op, returns unit).
//! The test runner extracts these declarations and compiles/runs them separately.
//!
//! All tests implicitly have `io : Io` — the Io effect is always available.
//! This evaluator injects `io : Io` into the body's scope automatically.
//!
//! Syntax:
//!   test "test_name", { body };
//!
//! Returns unit (no-op, preserves original env).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  ast_expr_to_string,
  make_err_expr,
  BK_TEST
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{
  Environment,
  Variable,
  get_variables_from_env,
  add_variable_to_env
} :: import("../../env.yo");
{
  EvalContext,
  FuncOrAsyncBlockKind,
  FuncOrAsyncBlockCtx
} :: import("../context.yo");
{
  EvalValue,
  create_unknown_val,
  is_type_val,
  is_str_lit
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression, evaluate_expression_raw } :: import("./expr.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// _trial_eval_test_body
// ---------------------------------------------------------------------------
/// Trial-evaluate a test body in a synthetic function-body context.
///
/// Under explicit effects the test runner generates `main :: (fn(io : Io,
/// exn : Exception) -> unit)({ …test body… })` and inlines test bodies into
/// it; that is where the *authoritative* type check happens at build time.
/// This trial evaluation just surfaces obvious mistakes earlier — but it runs
/// from a test-block context that takes a different generic-inference path
/// than a real function body, and some valid patterns (e.g. a call to a
/// locally-defined `cond`-with-`throw` function) fail in the trial even
/// though they compile fine in the real `main` wrapper.
///
/// A local exception handler swallows any error from the trial: it unwinds
/// this helper, so trial-eval errors are non-fatal and test extraction
/// proceeds. Mirrors the `try { … } catch {}` in
/// `src/evaluator/exprs/test.ts`. On success, attaches `original_body` to the
/// body's `ExprInfo` when the body has unit type (also matching TypeScript).
_trial_eval_test_body :: (
  fn(
    body : AstExpr,
    original_body : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> unit
)({
  inner_exn := Exception(throw : ((_err) -> unwind(())));
  evaluated := evaluate_expression_raw(body, env, ctx, inner_exn);
  body_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  match(
    body_info_opt,
    .Some(body_info) => {
      if(is_unit_type(body_info.ty), {
        body_info.original_expr = Option(AstExpr).Some(original_body);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(evaluated), body_info);
      });
    },
    .None => ()
  );
  ()
});
// ---------------------------------------------------------------------------
// evaluate_test
// ---------------------------------------------------------------------------
/// Evaluate a `test("name", { body })` declaration.
///
/// Mirrors `evaluateTest` in `src/evaluator/exprs/test.ts`.
///
/// Returns the expression tagged with unit type (no-op); test bodies are
/// evaluated at compile time only to catch errors early.
evaluate_test :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Validate shape: must be "test" call.
  if(!(ast_expr_is_fn_call_of(expr, BK_TEST,.None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected test, got ${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  // test expects exactly 2 arguments: test "name", { body }
  (arg_count : usize) = match(
    expr,
    .FnCall(_, _, args, _, _) => args.len(),
    .Atom(_, _) => usize(0)
  );
  if(arg_count != usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `test expects 2 arguments (name, body), got ${arg_count}. Io is implicitly available via "io" — no using clause needed.`,
          false,
          .None
        )
      )
    );
  });
  test_name_expr := match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  test_body_expr := match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(1)),.Some(a) => a,.None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  // Evaluate test name to ensure it's a comptime_str.
  evaluated_test_name_expr := evaluate_expression(test_name_expr, env, ctx);
  name_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_test_name_expr));
  if(!(name_info_opt.is_some()), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(test_name_expr),
          `Failed to evaluate test name: ${ast_expr_to_string(test_name_expr)}`,
          false,
          .None
        )
      )
    );
  });
  name_info := match(name_info_opt,.Some(i) => i,.None => new_expr_info(env, t_unit()));
  // Update env from the name evaluation.
  env.frames = name_info.env.frames;
  env.module_path = name_info.env.module_path;
  env.function_declaration_frame_level = name_info.env.function_declaration_frame_level;
  env.input_string = name_info.env.input_string;
  // Validate test name is a comptime string.
  name_is_str_lit := match(
    name_info.value,
    .Some(v) => is_str_lit(v),
    .None => false
  );
  if(!(name_is_str_lit), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(test_name_expr),
          `Expected string for test name, got ${ast_expr_to_string(test_name_expr)}`,
          false,
          .None
        )
      )
    );
  });
  // Inject `io : Io` into the body scope.
  // The Io module type is looked up from the env.
  io_vars := get_variables_from_env(env, String.from("Io"));
  n_io := io_vars.len();
  if(n_io == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Io module not found in environment. Is the prelude loaded?"),
          false,
          .None
        )
      )
    );
  });
  io_module_var := match(
    io_vars.get(n_io - usize(1)),
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("Io module not found in environment."),
            false,
            .None
          )
        )
      );
      // unreachable
      return(make_err_expr());
    }
  );
  // Extract the actual module type from Io's TypeVal.
  // Io :: module(...) means io_module_var.value == .Some(.TypeVal(ModuleType)).
  io_module_type := match(
    io_module_var.value,
    .Some(v) => match(
      v,
      .TypeVal(ty) => ty.*,
      _ => io_module_var.ty
    ),
    .None => io_module_var.ty
  );
  // Save frame count to restore after the (best-effort) trial evaluation,
  // which may push frames and then unwind on a swallowed error.
  saved_frames_len := env.frames.len();
  // Push a new frame for the test body (isolates io variable from outer scope).
  _frame_idx := env.push_frame(false);
  // Add the implicit `io : Io` variable to the new frame.
  io_unknown_val := create_unknown_val(io_module_type);
  _io_var_opt := add_variable_to_env(
    env,
    String.from("io"),
    io_module_type,
    Option(EvalValue).Some(io_unknown_val),
    true,
    // is_compile_time_only
    false,
    // is_reassignable
    false,
    // is_owning_the_rc_value
    true,
    // is_implicit
    ast_expr_token(expr)
  );
  // Clone test body for originalExpr storage (used by test codegen).
  original_test_body_expr := test_body_expr.clone();
  // Save and set context for test block evaluation.
  old_func_ctx := ctx.is_evaluating_function_body_or_async_block;
  ctx.is_evaluating_function_body_or_async_block = Option(FuncOrAsyncBlockCtx).Some(
    FuncOrAsyncBlockCtx(
      kind : FuncOrAsyncBlockKind.TestBlock,
      func_type : Option(TypeValue).None,
      func_value : Option(EvalValue).None,
      eval_env : env
    )
  );
  // Trial-evaluate the body (best effort; errors are swallowed — see the
  // helper). This surfaces obvious mistakes early; the authoritative check
  // is the test runner's compile step. Matches TypeScript's `try/catch`.
  _trial_eval_test_body(test_body_expr, original_test_body_expr, env, ctx);
  // Restore context.
  ctx.is_evaluating_function_body_or_async_block = old_func_ctx;
  // Restore env to its pre-test frame state: pops the implicit-io frame and
  // any frames left behind by a trial evaluation that unwound on error.
  while(env.frames.len() > saved_frames_len, {
    env.pop_frame();
  });
  // NOTE: Don't propagate env (matches TypeScript behavior).
  // Return unit — test has no compile-time value.
  result_info := new_expr_info(env, t_unit());
  result_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), result_info);
  expr
});
export(evaluate_test);
