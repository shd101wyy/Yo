//! evaluate_exists — stub for the `exists(T)` builtin.
//!
//! 1:1 port of `src/evaluator/exprs/exists.ts`.
//!
//! NOTE: The TypeScript source (`exists.ts`) has its entire implementation
//! commented out as a class method in the legacy evaluator class.  The
//! feature is therefore **not yet active** in the reference implementation.
//! This file is a Phase 2 stub; full implementation is deferred until the
//! `exists` feature is re-enabled in TypeScript.
//!
//! When implemented, `exists(T)` checks whether a variable of type T (or
//! labelled variable `label : T`) exists as a compile-time-only variable in
//! the current environment.  It returns a `comptime(bool)` value.
open(import("std/string"));
{ AstExpr, ast_expr_token, make_err_expr } :: import("../../expr.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
/// Evaluate the `exists(type_or_label_type, ...)` builtin.
///
/// Phase 2 stub: the TypeScript implementation is commented out in
/// `src/evaluator/exprs/exists.ts`.  This function currently throws
/// "not yet implemented" and will be completed in a later phase.
evaluate_exists :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  exn.throw(
    dyn(
      format_error_message(
        ast_expr_token(expr),
        String.from("evaluate_exists: not yet implemented (Phase 2 stub)"),
        false,
        .None
      )
    )
  );
  make_err_expr()
});
export(evaluate_exists);
