//! evaluate_begin_expression — evaluates `begin(...)` blocks.
//!
//! 1:1 port of `src/evaluator/exprs/begin.ts` (Phase 2aa).
//!
//! Complex optimization passes are stubbed as no-ops:
//!   - OPTIMIZE_DUP_AND_DROP_PAIRS block — no-op (type_contains_rc_type = false)
//!   - generateDeferredDropExpressions   — returns empty list
//!   - getVariablesNeedingDrop           — returns empty list
//!   - collectDupCallsConservatively     — returns empty DupCallsResult
//!   - consumeCaseBodyTempVar            — no-op
//!   - optimizeLoopTraversalBorrowChain  — no-op
//!
//! Exported symbols:
//!   DupCallsResult, is_unit_value_expression,
//!   collect_dup_calls_conservatively, evaluate_begin_expression
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom_of,
  make_err_expr,
  BK_BEGIN,
  BK_TUPLE,
  BK_RETURN,
  BF_UNWIND,
  BK_ASSIGN,
  BK_INIT_ASSIGN
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  ControlFlowFlags,
  control_flow_of,
  has_control_flow,
  has_any_control_flow
} :: import("../../expr_info.yo");
{ Environment, Variable, Frame, add_variable_to_env } :: import("../../env.yo");
{
  EvalContext,
  ExpectedTypeCtx
} :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ is_some_type } :: import("../../types/guards.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ type_to_string } :: import("../../types/string.yo");
{ is_flowable_expr, flow_options_default, FlowOptions }
:: import("../../types/flowability.yo");
{ type_representation_contains_raw_ptr } :: import("../../types/utils.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression, evaluate_expression_raw } :: import("./expr.yo");
{
  attach_temp_variable_to_expr,
  throw_expr_is_implicit_variable_error,
  consume_case_body_temp_var
} :: import("../utils.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// DupCallsResult — stub result type for collectDupCallsConservatively.
//
// The full implementation traverses the AST for `___dup(...)` calls and is
// deferred to Phase 3.  Both lists are always empty in Phase 2aa.
// ---------------------------------------------------------------------------
DupCallsResult :: object(
  /// Maps base-variable id → list of `___dup(...)` call expressions.
  dup_calls : HashMap(String, ArrayList(AstExpr)),
  /// Variable ids that have dups in some branches but not all (conservative).
  vars_with_partial_branch_dups : ArrayList(String)
);
// ---------------------------------------------------------------------------
// is_unit_value_expression
// ---------------------------------------------------------------------------
/// Returns `true` if `expr` is the empty-tuple literal `()`, i.e. a
/// zero-argument `tuple()` function call.
///
/// Mirrors `isUnitValueExpression` in `src/evaluator/exprs/begin.ts`.
is_unit_value_expression :: (fn(expr : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(expr, BK_TUPLE,.Some(usize(0)))
);
// ---------------------------------------------------------------------------
// collect_dup_calls_conservatively — stub
// ---------------------------------------------------------------------------
/// Stub. The real implementation traverses `expr` recursively to collect all
/// `___dup(...)` calls, keyed by the base-variable id they dup.
/// Deferred to Phase 3.
collect_dup_calls_conservatively :: (fn(_expr : AstExpr) -> DupCallsResult)(
  DupCallsResult(
    dup_calls : HashMap(String, ArrayList(AstExpr)).new(),
    vars_with_partial_branch_dups : ArrayList(String).new()
  )
);
// ---------------------------------------------------------------------------
// _check_keyword_position
// ---------------------------------------------------------------------------
/// Verify that a control-flow keyword (`return`, `break`, `continue`, `unwind`)
/// appears only as the last expression in a begin block (or as the second-to-
/// last when the last is a unit-value `()`).
///
/// Throws via `exn` when the position is invalid.
_check_keyword_position :: (
  fn(
    expr_to_eval : AstExpr,
    loop_i : usize,
    n_args : usize,
    begin_args : ArrayList(AstExpr),
    keyword : String,
    exn : Exception
  ) -> unit
)({
  if(n_args == usize(0), {
    return(());
  });
  last_idx := (n_args - usize(1));
  last_arg := match(begin_args.get(last_idx),.Some(a) => a,.None => make_err_expr());
  last_is_unit := is_unit_value_expression(last_arg);
  is_last := (loop_i == last_idx);
  is_second_last := ((n_args >= usize(2)) && (loop_i == (n_args - usize(2))));
  second_last_before_unit := (is_second_last && last_is_unit);
  ok := (is_last || second_last_before_unit);
  if(!(ok), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr_to_eval),
          `The "${keyword}" keyword can only be used as the last expression.`,
          false,
          .None
        )
      )
    );
  });
});
// ---------------------------------------------------------------------------
// evaluate_begin_expression — main function
// ---------------------------------------------------------------------------
/// Evaluate a `begin(...)` block expression.
///
/// Mirrors `evaluateBeginExpression` in `src/evaluator/exprs/begin.ts`.
///
/// Parameters:
///   - `expr`                    The begin expression to evaluate.
///   - `env_in`                  Environment at the call site.
///   - `ctx`                     Mutable evaluator context (side-table, etc.).
///   - `variables_to_add`        Variables to inject into the new frame before
///                               evaluating (used for function parameters).
///   - `_is_evaluating_function_body_begin_block`
///                               True when this begin block IS the function
///                               body.  Affects the dup/drop optimization pass
///                               (Phase 3); unused in Phase 2aa.
/// True when `v` is — or recursively contains — an `UnknownVal` (a runtime
/// hole). Used to decide whether a single-expression begin block must carry the
/// inner expression's `runtime_arg_exprs_in_order`: a bare runtime call yields
/// `UnknownVal`, and a RUNTIME enum/struct construction (`.Some((p &+ i).*)`,
/// `Wrap(v : runtimeVal)`) yields an `EnumVal`/`StructVal` SHELL with an
/// `UnknownVal` payload — both need the runtime construction codegen. A fully
/// comptime-folded construct (`.Some(i32(7))`) has only concrete leaves and must
/// keep the comptime-value path (see the gate in `evaluate_begin_expression`).
_value_contains_unknown :: (fn(v : EvalValue) -> bool)(
  match(
    v,
    .UnknownVal(_) => true,
    .EnumVal(_, fields) => {
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < fields.len()) && !(found), {
        match(
          fields.get(i),
          .Some(f) => if(recur(f), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .StructVal(_, _, field_values) => {
      (i : usize) = usize(0);
      (found : bool) = false;
      while((i < field_values.len()) && !(found), {
        match(
          field_values.get(i),
          .Some(f) => if(recur(f), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
evaluate_begin_expression :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    variables_to_add : ArrayList(Variable),
    _is_evaluating_function_body_begin_block : bool,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Extract the list of child expressions from the begin block.
  //
  // If `expr` is NOT a `begin(...)` call (e.g. a function body like
  // `struct(value : T)` invoked via the comptime-fn caller), treat it
  // as a single-expression begin block by wrapping it in a 1-element
  // arg list. Mirrors TS `evaluateBeginExpression`
  // (src/evaluator/exprs/begin.ts:1009-1037) which synthesises a
  // `begin(expr)` wrapper when the input is not already a begin call.
  // Without this, the naive `FnCall` arg unwrap below would treat the
  // struct call's fields (`value : T`) as top-level statements and
  // dispatch them through `evaluate_binding`, raising a spurious
  // `Unexpected runtime variable binding in a compile-time only
  // function body.` error.
  is_begin_call := ast_expr_is_fn_call_of(expr, BK_BEGIN,.None);
  begin_args := if(is_begin_call, match(
    expr,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  ), {
    single := ArrayList(AstExpr).new();
    single.push(expr);
    single
  });
  n_args := begin_args.len();
  // Empty begin → unit result immediately.
  if(n_args == usize(0), {
    info := new_expr_info(env, TypeValue.Unit);
    info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    return(expr);
  });
  // Push a new begin-block frame so temp variables are scoped correctly.
  _fr := env.push_frame(true);
  // Inject pre-supplied variables (e.g. function parameters) into the frame.
  (vi : usize) = usize(0);
  while(vi < variables_to_add.len(), {
    v := match(
      variables_to_add.get(vi),
      .Some(x) => x,
      .None => {
        vi = variables_to_add.len();
        return(expr);
      }
    );
    _added := add_variable_to_env(
      env,
      v.name,
      v.ty,
      v.value,
      v.is_compile_time_only,
      v.is_reassignable,
      v.is_owning_the_rc_value,
      v.is_implicit,
      v.token
    );
    vi = (vi + usize(1));
  });
  // -------------------------------------------------------------------------
  // Main evaluation loop
  // -------------------------------------------------------------------------
  // `last_expr` tracks the expression that will determine the begin block's
  // type and value.  Initialised to the final child; updated on control flow.
  (last_expr : AstExpr) = match(
    begin_args.get(n_args - usize(1)),
    .Some(a) => a,
    .None => make_err_expr()
  );
  (return_expr : Option(AstExpr)) = Option(AstExpr).None;
  (has_runtime_side_effects : bool) = false;
  (done : bool) = false;
  (loop_i : usize) = usize(0);
  while((loop_i < n_args) && !(done), {
    (expr_to_eval : AstExpr) = match(
      begin_args.get(loop_i),
      .Some(a) => a,
      .None => make_err_expr()
    );
    // Classify the current expression.
    is_return_atom := (ast_expr_is_atom(expr_to_eval) && ast_expr_is_atom_of(expr_to_eval, BK_RETURN));
    is_return_call := ast_expr_is_fn_call_of(expr_to_eval, BK_RETURN,.None);
    is_return_expr := (is_return_atom || is_return_call);
    // `return` (atom) AND `return()` (zero-arg call) are BOTH unit returns.
    // Mirrors TS begin.ts:1122-1124 (`exprIsAtom(e) || (exprIsFunctionCall(e)
    // && e.args.length === 0)`). Without the zero-arg case, `return()` fell to
    // the `return(val)` branch, where `args.get(0)` is `.None` → `make_err_expr()`
    // → evaluating that error expr poisons the def-time return-type inference
    // ("Return type mismatch ... got fn(T : Type) -> Type"), the dominant
    // codegen-async transpile-marker cluster.
    is_return_unit := (
      is_return_atom || (
        is_return_call && match(
          expr_to_eval,
          .FnCall(_, _, ret_call_args, _, _) => (ret_call_args.len() == usize(0)),
          .Atom(_, _) => false
        )
      )
    );
    is_break_atom := (ast_expr_is_atom(expr_to_eval) && ast_expr_is_atom_of(expr_to_eval, "break"));
    is_continue_atom := (ast_expr_is_atom(expr_to_eval) && ast_expr_is_atom_of(expr_to_eval, "continue"));
    is_escape_call := ast_expr_is_fn_call_of(expr_to_eval, BF_UNWIND,.None);
    cond(
      // -------------------------------------------------------------------
      // return / return(val)
      // -------------------------------------------------------------------
      is_return_expr => {
        _check_keyword_position(expr_to_eval, loop_i, n_args, begin_args, String.from("return"), exn);
        if(!(ctx.is_evaluating_function_body_or_async_block.is_some()), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr_to_eval),
                String.from("The \"return\" keyword can only be used inside a function body or async block."),
                false,
                .None
              )
            )
          );
        });
        return_expr = Option(AstExpr).Some(expr_to_eval);
        if(is_return_unit, {
          // `return` / `return()` with no argument → unit return.
          out := new_expr_info(env, TypeValue.Unit);
          out.value = Option(EvalValue).Some(EvalValue.UnitVal);
          out.control_flow = Option(ControlFlowFlags).Some(control_flow_of(.Return));
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr_to_eval), out);
          last_expr = expr_to_eval;
        }, {
          // `return(val)` — evaluate the argument.
          ret_arg := match(
            expr_to_eval,
            .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr()),
            .Atom(_, _) => make_err_expr()
          );
          // Pass the function-body's return type as the expected type for the
          // return argument — mirrors TS begin.ts:1148-1163: for a
          // FunctionBody context, `expectedType = { type:
          // functionType.return.type, env }`; for async blocks / other
          // contexts, keep the current expected type. Without this,
          // `return(.Variant(...))` shorthand throws "Failed to infer enum
          // variant type" at definition-time body evaluation (this was the
          // single largest def-eval swallow category, 58× in std).
          old_expected := ctx.expected_type;
          ret_expected := match(
            ctx.is_evaluating_function_body_or_async_block,
            .Some(fb_ctx) => match(
              fb_ctx.kind,
              .FunctionBody => match(
                fb_ctx.func_type,
                .Some(ft) => match(
                  ft,
                  .Func({ result : ret_box }) => Option(TypeValue).Some(ret_box.*),
                  _ => Option(TypeValue).None
                ),
                .None => Option(TypeValue).None
              ),
              _ => Option(TypeValue).None
            ),
            .None => Option(TypeValue).None
          );
          match(
            ret_expected,
            .Some(rt) => {
              ctx.expected_type = Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : rt, env : env));
            },
            .None => ()
          );
          evaluated_ret_arg := evaluate_expression_raw(ret_arg, env, ctx, exn);
          ctx.expected_type = old_expected;
          ret_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_ret_arg));
          if(ret_info_opt.is_none(), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(ret_arg),
                  String.from("Return expression is not evaluated correctly."),
                  false,
                  .None
                )
              )
            );
          });
          ret_info := match(ret_info_opt,.Some(ri) => ri,.None => new_expr_info(env, TypeValue.Unit));
          env.frames = ret_info.env.frames;
          env.module_path = ret_info.env.module_path;
          env.function_declaration_frame_level = ret_info.env.function_declaration_frame_level;
          env.input_string = ret_info.env.input_string;
          // attachTempVariableToExpr is a no-op stub; call it for API parity.
          attach_temp_variable_to_expr(evaluated_ret_arg, true, ctx);
          // Re-read env in case the stub updated it (future-proof).
          env = match(
            expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_ret_arg)),
            .Some(ri) => ri.env,
            .None => env
          );
          // Defense-in-depth flowability on the return ARGUMENT (begin.ts).
          // (Ref-returning functions are banned at signature evaluation —
          // see types/function.yo — so only the raw-pointer-representation
          // rooting check remains for explicit `return(...)`.)
          match(
            ctx.is_evaluating_function_body_or_async_block,
            .Some(rfb_ctx) => match(
              rfb_ctx.kind,
              .FunctionBody => match(
                rfb_ctx.func_type,
                .Some(rft) => match(
                  rft,
                  .Func({ result : rfb, meta : __fm1 }) => {
                    rfco := __fm1.*.result_is_comptime_only;
                    if((!(rfco) && type_representation_contains_raw_ptr(rfb.*))
                    && !(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(ret_arg).module_path.clone()))), {
                      ret_slice_opts := FlowOptions(
                        allow_same_frame_local : false,
                        allow_parameter_source : true,
                        allow_comptime_source : true,
                        max_local_frame_level : Option(usize).None
                      );
                      if(!(is_flowable_expr(evaluated_ret_arg, ctx, ret_slice_opts)), {
                        exn.throw(
                          dyn(
                            format_error_message(
                              ast_expr_token(ret_arg),
                              `'return(...)' from a function returning '${type_to_string(rfb.*)}' carries a raw pointer in its representation; the returned value must be rooted in caller-owned storage. The returned expression is not flowable:\n  ${ast_expr_to_string(ret_arg)}`,
                              false,
                              .None
                            )
                          )
                        );
                      });
                    });
                  },
                  _ => ()
                ),
                .None => ()
              ),
              _ => ()
            ),
            .None => ()
          );
          out := new_expr_info(env, ret_info.ty);
          out.value = ret_info.value;
          out.control_flow = Option(ControlFlowFlags).Some(control_flow_of(.Return));
          out.path_collection = ret_info.path_collection;
          out.variable_name = ret_info.variable_name;
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr_to_eval), out);
          last_expr = expr_to_eval;
        });
        done = true;
      },
      // -------------------------------------------------------------------
      // break
      // -------------------------------------------------------------------
      is_break_atom => {
        _check_keyword_position(expr_to_eval, loop_i, n_args, begin_args, String.from("break"), exn);
        if(!(ctx.is_evaluating_loop_body.is_some()), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr_to_eval),
                String.from("The \"break\" keyword can only be used inside a loop."),
                false,
                .None
              )
            )
          );
        });
        out := new_expr_info(env, TypeValue.Unit);
        out.value = Option(EvalValue).Some(EvalValue.UnitVal);
        out.control_flow = Option(ControlFlowFlags).Some(control_flow_of(.Break));
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr_to_eval), out);
        last_expr = expr_to_eval;
        done = true;
      },
      // -------------------------------------------------------------------
      // continue
      // -------------------------------------------------------------------
      is_continue_atom => {
        _check_keyword_position(expr_to_eval, loop_i, n_args, begin_args, String.from("continue"), exn);
        if(!(ctx.is_evaluating_loop_body.is_some()), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr_to_eval),
                String.from("The \"continue\" keyword can only be used inside a loop."),
                false,
                .None
              )
            )
          );
        });
        out := new_expr_info(env, TypeValue.Unit);
        out.value = Option(EvalValue).Some(EvalValue.UnitVal);
        out.control_flow = Option(ControlFlowFlags).Some(control_flow_of(.Continue));
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr_to_eval), out);
        last_expr = expr_to_eval;
        done = true;
      },
      // -------------------------------------------------------------------
      // unwind(val)
      // -------------------------------------------------------------------
      is_escape_call => {
        _check_keyword_position(expr_to_eval, loop_i, n_args, begin_args, String.from("unwind"), exn);
        if(!(ctx.enclosing_function_return_type.is_some()), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr_to_eval),
                String.from("The \"unwind\" keyword can only be used inside a function that has an enclosing function."),
                false,
                .None
              )
            )
          );
        });
        return_expr = Option(AstExpr).Some(expr_to_eval);
        esc_arg := match(
          expr_to_eval,
          .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr()),
          .Atom(_, _) => make_err_expr()
        );
        enclosing_ret := match(
          ctx.enclosing_function_return_type,
          .Some(t) => t,
          .None => TypeValue.Unit
        );
        // Propagate the enclosing function's return type as the expected type.
        old_expected := ctx.expected_type;
        ctx.expected_type = Option(ExpectedTypeCtx).Some(
          ExpectedTypeCtx(ty : enclosing_ret, env : env)
        );
        evaluated_esc_arg := evaluate_expression_raw(esc_arg, env, ctx, exn);
        ctx.expected_type = old_expected;
        esc_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_esc_arg));
        if(esc_info_opt.is_none(), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(esc_arg),
                String.from("Unwind expression is not evaluated correctly."),
                false,
                .None
              )
            )
          );
        });
        esc_info := match(esc_info_opt,.Some(ei) => ei,.None => new_expr_info(env, TypeValue.Unit));
        // Type-check unwind value against the enclosing return type.
        // Skip when the enclosing return type is an unresolved SomeType.
        esc_compat := are_types_compatible(esc_info.ty, enclosing_ret);
        if(!(is_some_type(enclosing_ret)) && !(esc_compat), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(esc_arg),
                `Incompatible type for \`unwind\` argument:\n- Expected: ${type_to_string(enclosing_ret)}\n- Got: ${type_to_string(esc_info.ty)}`,
                false,
                .None
              )
            )
          );
        });
        attach_temp_variable_to_expr(evaluated_esc_arg, true, ctx);
        env = match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_esc_arg)),
          .Some(ei) => ei.env,
          .None => env
        );
        out := new_expr_info(env, esc_info.ty);
        out.value = esc_info.value;
        out.control_flow = Option(ControlFlowFlags).Some(control_flow_of(.Unwind));
        out.path_collection = esc_info.path_collection;
        out.variable_name = esc_info.variable_name;
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr_to_eval), out);
        last_expr = expr_to_eval;
        done = true;
      },
      // -------------------------------------------------------------------
      // Normal expression evaluation
      // -------------------------------------------------------------------
      true => {
        // Propagate the expectedType hint only to the last expression in the block.
        old_expected := ctx.expected_type;
        is_last_in_loop := (loop_i == (n_args - usize(1)));
        if(!(is_last_in_loop), {
          ctx.expected_type = Option(ExpectedTypeCtx).None;
        });
        evaluated := evaluate_expression_raw(expr_to_eval, env, ctx, exn);
        ctx.expected_type = old_expected;
        ev_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
        match(
          ev_info_opt,
          .Some(ev_info) => {
            env.frames = ev_info.env.frames;
            env.module_path = ev_info.env.module_path;
            env.function_declaration_frame_level = ev_info.env.function_declaration_frame_level;
            env.input_string = ev_info.env.input_string;
          },
          .None => ()
        );
        // Track runtime side effects for non-last expressions.
        // A begin block with any runtime non-last expression cannot be
        // folded to a compile-time value.
        if(!(is_last_in_loop) && !(has_runtime_side_effects), {
          is_value_none := match(
            ev_info_opt,
            .Some(ei) => ei.value.is_none(),
            .None => false
          );
          is_assign_expr := ast_expr_is_fn_call_of(evaluated, BK_ASSIGN,.None);
          is_init_assign_expr := ast_expr_is_fn_call_of(evaluated, BK_INIT_ASSIGN,.None);
          is_either_assign := (is_assign_expr || is_init_assign_expr);
          ct_only_assign := match(
            ev_info_opt,
            .Some(ei) => match(ei.is_compile_time_only_assignment,.Some(b) => b,.None => false),
            .None => false
          );
          // For NON-assignment statements, only a CONCRETELY known value
          // proves the statement effect-free: an UnknownVal (e.g. a
          // runtime-condition cond over unit arms) may execute anything at
          // runtime — including a conditional return — so folding the
          // block would silently delete the statement. Assignments are
          // exempt: a comptime-only assignment in a comptime fn body
          // carries a typed unknown during validation (1:1 with begin.ts;
          // issues/fixed/codegen-block-rhs-drops-nontail-statements.md).
          is_unknown_val := match(
            ev_info_opt,
            .Some(ei) => match(
              ei.value,
              .Some(v) => match(v,.UnknownVal(_) => true, _ => false),
              .None => false
            ),
            .None => false
          );
          is_assign_runtime := (is_either_assign && !(ct_only_assign));
          is_nonassign_unknown := (!(is_either_assign) && is_unknown_val);
          if((is_value_none || is_assign_runtime) || is_nonassign_unknown, {
            has_runtime_side_effects = true;
          });
        });
        // If this expression carries control flow, it becomes the last expression.
        has_cf := match(
          ev_info_opt,
          .Some(ei) => has_any_control_flow(ei.control_flow),
          .None => false
        );
        last_expr = evaluated;
        if(has_cf, {
          done = true;
        });
      }
    );
    if(!(done), {
      loop_i = (loop_i + usize(1));
    });
  });
  // -------------------------------------------------------------------------
  // Post-loop: verify the last expression was evaluated
  // -------------------------------------------------------------------------
  last_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(last_expr));
  if(last_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(last_expr),
          `Last expression in "begin" is not evaluated correctly:\n${ast_expr_to_string(last_expr)}`,
          false,
          .None
        )
      )
    );
  });
  last_info := match(last_info_opt,.Some(li) => li,.None => new_expr_info(env, TypeValue.Unit));
  return_type := last_info.ty;
  // -------------------------------------------------------------------------
  // Return-type compatibility check (partial port — synthesize_types deferred)
  // -------------------------------------------------------------------------
  is_return_ctrl := has_control_flow(last_info.control_flow,.Return);
  if(is_return_ctrl, {
    match(
      ctx.is_evaluating_function_body_or_async_block,
      .None => (),
      .Some(fctx) => {
        match(
          fctx.kind,
          .FunctionBody => {
            // Check compatibility with the declared function return type.
            match(
              fctx.func_type,
              .None => (),
              .Some(ft) => {
                match(
                  ft,
                  .Func({ result : result_box }) => {
                    expected_ret := result_box.*;
                    compat := are_types_compatible(return_type, expected_ret);
                    if(!(is_some_type(expected_ret)) && !(compat), {
                      exn.throw(
                        dyn(
                          format_error_message(
                            ast_expr_token(last_expr),
                            `Return type mismatch. Expected type "${type_to_string(expected_ret)}", but got "${type_to_string(return_type)}".`,
                            false,
                            .None
                          )
                        )
                      );
                    });
                  },
                  _ => ()
                );
              }
            );
          },
          _ => ()
        );
      }
    );
  });
  // -------------------------------------------------------------------------
  // Disallow returning implicit (`given(...)`) variables
  // -------------------------------------------------------------------------
  // Build the expression to check: the value being returned (not the `return`
  // keyword wrapper itself).
  re_base := match(return_expr,.Some(re) => re,.None => last_expr);
  is_return_with_arg := match(
    return_expr,
    .Some(re) => ast_expr_is_fn_call_of(re, BK_RETURN,.Some(usize(1))),
    .None => false
  );
  check_expr := cond(
    is_return_with_arg => match(
      re_base,
      .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => re_base),
      .Atom(_, _) => re_base
    ),
    true => re_base
  );
  throw_expr_is_implicit_variable_error(check_expr, env, ctx, exn);
  // -------------------------------------------------------------------------
  // Ownership / RC optimizations — all stubbed (type_contains_rc_type = false)
  // -------------------------------------------------------------------------
  //
  // The following passes are no-ops in Phase 2aa:
  //   - Loop traversal borrow-chain optimisation
  //   - dup/drop pair elimination (OPTIMIZE_DUP_AND_DROP_PAIRS)
  //   - Deferred drop expression generation
  //   - Own-parameter drop for nested returns inside function bodies
  //
  // These will be ported in Phase 3 once the RC type system is complete.
  // -------------------------------------------------------------------------
  // Save the current frame before popping it
  // -------------------------------------------------------------------------
  n_frames := env.frames.len();
  current_frame_opt := match(
    env.frames.get(n_frames - usize(1)),
    .Some(f) => Option(Frame).Some(f),
    .None => Option(Frame).None
  );
  // Drop the begin scope frame NON-mutatingly: reassign `env.frames` to a fresh
  // list without the last frame, instead of `env.frames.pop()` (in-place). The
  // threading above (`env.frames = ev_info.env.frames`) aliases `env.frames` to
  // the last statement's recorded `ExprInfo` snapshot list; an in-place pop
  // would drop the begin frame from THAT snapshot too, hiding begin-local
  // bindings from any later consumer of the recorded env (e.g. the flowability
  // check). See issues/fixed/yo-self-recorded-env-aliasing.md.
  env.pop_frame_nonmutating();
  // -------------------------------------------------------------------------
  // Build ExprInfo for the begin expression itself
  // -------------------------------------------------------------------------
  out_info := new_expr_info(env, return_type);
  out_info.value = cond(has_runtime_side_effects => Option(EvalValue).None, true => last_info.value);
  out_info.control_flow = last_info.control_flow;
  out_info.comptime_ref = last_info.comptime_ref;
  out_info.popped_env_frame = current_frame_opt;
  // A SINGLE-expression begin block (`expr` was not a real `begin(...)` call, so
  // it was wrapped in a 1-element list at the top) has its result node EQUAL to
  // the inner expression node — yo-self reuses `expr`'s id rather than
  // clone+mutate-into-begin like TS (begin.ts:1016-1045, which clones the inner
  // expr so its `$` lives on a separate node). The fresh `out_info` therefore
  // CLOBBERS the inner expression's own ExprInfo on that shared id. Most fields
  // are re-derived above, but `runtime_arg_exprs_in_order` (the call-argument
  // materialization list codegen needs) is dropped — so a bare runtime CALL as a
  // match/cond arm body or a single-expression function body emitted
  // "Failed to transpile". Carry that one field across — but ONLY for a runtime
  // RESULT: a bare runtime call (UnknownVal), a unit-returning call (UnitVal), no
  // value, OR a RUNTIME enum/struct construction whose shell carries an UnknownVal
  // payload (`.Some((p &+ i).*)` in ArrayList.get → runtime construction codegen).
  // A fully comptime-FOLDED construct (`.None`, `.Some(i32(7))`, `i32(0)`) has only
  // concrete leaves and emits via the comptime-value path; carrying its arg list
  // would wrongly trip the runtime enum/struct-construction codegen
  // (`ctor_has_runtime_args`), corrupting the literal's type name — that regressed
  // match_arm_folded_fncall + runtime_enum_construct. (Do NOT alias the whole
  // `last_info` either: its `variable_name` temp would pollute downstream type names.)
  carry_runtime_args := match(
    last_info.value,
    .None => true,
    .Some(v) => match(v,.UnitVal => true, _ => _value_contains_unknown(v))
  );
  if((ast_expr_id(expr) == ast_expr_id(last_expr)) && carry_runtime_args, {
    out_info.runtime_arg_exprs_in_order = last_info.runtime_arg_exprs_in_order;
  });
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  // Attach temp variable for the begin block result (no-op stub in Phase 2aa).
  attach_temp_variable_to_expr(expr, true, ctx);
  expr
});
export(DupCallsResult, is_unit_value_expression);
export(collect_dup_calls_conservatively);
export(evaluate_begin_expression);
