        last_expr = expr_to_eval;
        done = true;
      },
      // -------------------------------------------------------------------
      // unwind(val)
      // -------------------------------------------------------------------
      is_escape_call => {
        _check_keyword_position(expr_to_eval, loop_i, n_args, begin_args, String.from("unwind"), exn);
        if(!(ctx.enclosing_function_return_type.is_some()), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr_to_eval),
                String.from("The \"unwind\" keyword can only be used inside a function that has an enclosing function."),
                false,
                .None
              )
            )
          );
        });
        return_expr = Option(AstExpr).Some(expr_to_eval);
        esc_n_args := match(
          expr_to_eval,
          .FnCall(_, _, esc_args0, _, _) => esc_args0.len(),
          .Atom(_, _) => usize(0)
        );
        // At most one argument (TS begin.ts:1446-1451).
        if(esc_n_args > usize(1), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr_to_eval),
                String.from("The \"unwind\" keyword accepts at most one argument."),
                false,
                .None
              )
            )
          );
        });
        enclosing_ret := match(
          ctx.enclosing_function_return_type,
          .Some(t) => t,
          .None => TypeValue.Unit
        );
        // Zero-arg `unwind()` — unwind with unit (TS begin.ts:1454-1479):
        // type-check unit against the enclosing return type, stamp a
        // unit-typed ExprInfo carrying the Unwind control flow, and stop the
        // block. The with-arg path below fed a make_err_expr() into
        // evaluation here, so `unwind();` never stamped and codegen emitted
        // "// Failed to transpile unwind();" — the handler then fell
        // through instead of exiting (tests/algebraic_effects.test.yo
        // "Test zero-arg unwind exits unit function", the file's one
        // genuinely failing test).
        if(esc_n_args == usize(0), {
          if(!(is_some_type(enclosing_ret)) && !(are_types_compatible(TypeValue.Unit, enclosing_ret)), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(expr_to_eval),
                  `Incompatible type for \`escape\` argument:\n- Expected (enclosing function return type): ${type_to_string(enclosing_ret)}\n- Got: ${type_to_string(TypeValue.Unit)}`,
                  false,
                  .None
                )
              )
            );
          });
          out_esc0 := new_expr_info(env, TypeValue.Unit);
          out_esc0.control_flow = Option(ControlFlowFlags).Some(control_flow_of(.Unwind));
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr_to_eval), out_esc0);
          last_expr = expr_to_eval;
          done = true;
        }, {
          esc_arg := match(
            expr_to_eval,
            .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr()),
            .Atom(_, _) => make_err_expr()
          );
          // Propagate the enclosing function's return type as the expected type.
          old_expected := ctx.expected_type;
          ctx.expected_type = Option(ExpectedTypeCtx).Some(
            ExpectedTypeCtx(ty : enclosing_ret, env : env)
          );
          evaluated_esc_arg := evaluate_expression_raw(esc_arg, env, ctx, exn);
          ctx.expected_type = old_expected;
          esc_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_esc_arg));
          if(esc_info_opt.is_none(), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(esc_arg),
                  String.from("Unwind expression is not evaluated correctly."),
                  false,
                  .None
                )
              )
            );
          });
          esc_info := match(esc_info_opt,.Some(ei) => ei,.None => new_expr_info(env, TypeValue.Unit));
          // Type-check unwind value against the enclosing return type.
          // Skip when the enclosing return type is an unresolved SomeType.
          esc_compat := are_types_compatible(esc_info.ty, enclosing_ret);
          if(!(is_some_type(enclosing_ret)) && !(esc_compat), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(esc_arg),
                  `Incompatible type for \`unwind\` argument:\n- Expected: ${type_to_string(enclosing_ret)}\n- Got: ${type_to_string(esc_info.ty)}`,
                  false,
                  .None
                )
              )
            );
          });
          attach_temp_variable_to_expr(evaluated_esc_arg, true, ctx);
          env = match(
            expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_esc_arg)),
            .Some(ei) => ei.env,
            .None => env
          );
          out := new_expr_info(env, esc_info.ty);
          out.value = esc_info.value;
          out.control_flow = Option(ControlFlowFlags).Some(control_flow_of(.Unwind));
          out.path_collection = esc_info.path_collection;
          out.variable_name = esc_info.variable_name;
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr_to_eval), out);
          last_expr = expr_to_eval;
          done = true;
        });
      },
      // -------------------------------------------------------------------
      // Normal expression evaluation
      // -------------------------------------------------------------------
      true => {
        // Propagate the expectedType hint only to the last expression in the block.
        old_expected := ctx.expected_type;
        is_last_in_loop := (loop_i == (n_args - usize(1)));
        if(!(is_last_in_loop), {
          ctx.expected_type = Option(ExpectedTypeCtx).None;
        });
        evaluated := evaluate_expression_raw(expr_to_eval, env, ctx, exn);
        ctx.expected_type = old_expected;
        ev_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
        match(
          ev_info_opt,
          .Some(ev_info) => {
            env.frames = ev_info.env.frames;
            env.module_path = ev_info.env.module_path;
            env.function_declaration_frame_level = ev_info.env.function_declaration_frame_level;
            env.input_string = ev_info.env.input_string;
          },
          .None => ()
        );
        // Track runtime side effects for non-last expressions.
        // A begin block with any runtime non-last expression cannot be
        // folded to a compile-time value.
        if(!(is_last_in_loop) && !(has_runtime_side_effects), {
          is_value_none := match(
            ev_info_opt,
            .Some(ei) => ei.value.is_none(),
            .None => false
          );
          is_assign_expr := ast_expr_is_fn_call_of(evaluated, BK_ASSIGN,.None);
          is_init_assign_expr := ast_expr_is_fn_call_of(evaluated, BK_INIT_ASSIGN,.None);
          is_either_assign := (is_assign_expr || is_init_assign_expr);
          ct_only_assign := match(
            ev_info_opt,
            .Some(ei) => match(ei.is_compile_time_only_assignment,.Some(b) => b,.None => false),
            .None => false
          );
          // For NON-assignment statements, only a CONCRETELY known value
          // proves the statement effect-free: an UnknownVal (e.g. a
          // runtime-condition cond over unit arms) may execute anything at
          // runtime — including a conditional return — so folding the
          // block would silently delete the statement. Assignments are
          // exempt: a comptime-only assignment in a comptime fn body
          // carries a typed unknown during validation (1:1 with begin.ts;
          // issues/fixed/codegen-block-rhs-drops-nontail-statements.md).
          is_unknown_val := match(
            ev_info_opt,
            .Some(ei) => match(
              ei.value,
              .Some(v) => match(v,.UnknownVal(_, _) => true, _ => false),
              .None => false
            ),
            .None => false
          );
          is_assign_runtime := (is_either_assign && !(ct_only_assign));
          is_nonassign_unknown := (!(is_either_assign) && is_unknown_val);
          if((is_value_none || is_assign_runtime) || is_nonassign_unknown, {
            has_runtime_side_effects = true;
          });
        });
        // If this expression carries control flow, it becomes the last expression.
        has_cf := match(
          ev_info_opt,
          .Some(ei) => has_any_control_flow(ei.control_flow),
          .None => false
        );
        last_expr = evaluated;
        if(has_cf, {
          done = true;
        });
      }
    );
    if(!(done), {
      loop_i = (loop_i + usize(1));
    });
  });
  // -------------------------------------------------------------------------
  // Post-loop: verify the last expression was evaluated
  // -------------------------------------------------------------------------
  last_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(last_expr));
  if(last_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(last_expr),
          `Last expression in "begin" is not evaluated correctly:\n${ast_expr_to_string(last_expr)}`,
          false,
          .None
        )
      )
    );
  });
  last_info := match(last_info_opt,.Some(li) => li,.None => new_expr_info(env, TypeValue.Unit));
  return_type := last_info.ty;
  // -------------------------------------------------------------------------
  // Return-type compatibility check (begin.ts:1602-1680)
  // -------------------------------------------------------------------------
  // TS FIRST tries `synthesizeTypes(expected, given)` (begin.ts:1607-1618) —
  // with a SomeT expected this BINDS the type variable's name in the env
  // (synthesizer.ts:457-490); handles shapes like [i32; n] vs [i32; 5]. Only
  // when synthesis THROWS does TS fall back to the raw compatibility check +
  // the mismatch error. NOTE: this alone does NOT fix the io.async
  // `return(<binop>)` void-result bug — there the GIVEN side is already the
  // same bare SomeT (see issues/yo-self-io-async-return-binop-void.md).
  is_return_ctrl := has_control_flow(last_info.control_flow,.Return);
  if(is_return_ctrl, {
    match(
      ctx.is_evaluating_function_body_or_async_block,
      .None => (),
      .Some(fctx) => {
        match(
          fctx.kind,
          .FunctionBody => {
            // Check compatibility with the declared function return type.
            match(
              fctx.func_type,
              .None => (),
              .Some(ft) => {
                match(
                  ft,
                  .Func({ result : result_box }) => {
                    expected_ret := result_box;
                    synth_ok := _try_synthesize_return_type(expected_ret, return_type, env);
                    if(!(synth_ok), {
                      compat := are_types_compatible(return_type, expected_ret);
                      if(!(is_some_type(expected_ret)) && !(compat), {
                        exn.throw(
                          dyn(
                            format_error_message(
                              ast_expr_token(last_expr),
                              `Return type mismatch. Expected type "${type_to_string(expected_ret)}", but got "${type_to_string(return_type)}".`,
                              false,
                              .None
                            )
                          )
                        );
                      });
                    });
                  },
                  _ => ()
                );
              }
            );
          },
          .AsyncBlock => {
            // begin.ts:1642-1680 — async-block kind synthesizes against the
            // surrounding EXPECTED type instead of a declared fn return.
            match(
              ctx.expected_type,
              .Some(et) => {
                as_synth_ok := _try_synthesize_return_type(et.ty, return_type, env);
                if(!(as_synth_ok), {
                  as_compat := are_types_compatible(return_type, et.ty);
                  if(!(is_some_type(et.ty)) && !(as_compat), {
                    exn.throw(
                      dyn(
                        format_error_message(
                          ast_expr_token(last_expr),
                          `Return type mismatch. Expected type "${type_to_string(et.ty)}", but got "${type_to_string(return_type)}".`,
                          false,
                          .None
                        )
                      )
                    );
                  });
                });
              },
              .None => ()
            );
          },
          _ => ()
        );
      }
    );
  });
  // -------------------------------------------------------------------------
  // Disallow returning implicit (`given(...)`) variables
  // -------------------------------------------------------------------------
  // Build the expression to check: the value being returned (not the `return`
  // keyword wrapper itself).
  re_base := match(return_expr,.Some(re) => re,.None => last_expr);
  is_return_with_arg := match(
    return_expr,
    .Some(re) => ast_expr_is_fn_call_of(re, BK_RETURN,.Some(usize(1))),
    .None => false
  );
  check_expr := cond(
    is_return_with_arg => match(
      re_base,
      .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => re_base),
      .Atom(_, _) => re_base
    ),
    true => re_base
  );
  throw_expr_is_implicit_variable_error(check_expr, env, ctx, exn);
  // -------------------------------------------------------------------------
  // Ownership / RC optimizations — all stubbed (type_contains_rc_type = false)
  // -------------------------------------------------------------------------
  //
  // The following passes are no-ops in Phase 2aa:
  //   - Loop traversal borrow-chain optimisation
  //   - dup/drop pair elimination (OPTIMIZE_DUP_AND_DROP_PAIRS)
  //   - Deferred drop expression generation
  //   - Own-parameter drop for nested returns inside function bodies
  //
  // These will be ported in Phase 3 once the RC type system is complete.
  // -------------------------------------------------------------------------
  // Save the current frame before popping it
  // -------------------------------------------------------------------------
  n_frames := env.frames.len();
  current_frame_opt := match(
    env.frames.get(n_frames - usize(1)),
    .Some(f) => Option(Frame).Some(f),
    .None => Option(Frame).None
  );
  // Drop the begin scope frame NON-mutatingly: reassign `env.frames` to a fresh
  // list without the last frame, instead of `env.frames.pop()` (in-place). The
  // threading above (`env.frames = ev_info.env.frames`) aliases `env.frames` to
  // the last statement's recorded `ExprInfo` snapshot list; an in-place pop
  // would drop the begin frame from THAT snapshot too, hiding begin-local
  // bindings from any later consumer of the recorded env (e.g. the flowability
  // check). See issues/fixed/yo-self-recorded-env-aliasing.md.
  // Simplified begin-tail ownership (mirrors begin.ts:1705-1778): when the
  // block's result is a bare local, an OWNING local from the CURRENT frame
  // (or an `own(...)` parameter of the enclosing function) transfers
  // ownership out — mark it consumed so the scope-end scheduler skips it.
  // A NON-OWNING local (e.g. a match pattern binding borrowing the
  // scrutinee's payload) or one from an OUTER frame is SHARED out — mark the
  // tail with a deferred `___dup` so codegen emits the balancing incr before
  // the owner's scope-end `___drop` runs (without it, widening the drop
  // predicate to value enums/structs freed payloads still in use — the
  // hashmap_self_cycle abort).
  (return_value_expr : AstExpr) = last_expr;
  if(ast_expr_is_fn_call_of(last_expr, BK_RETURN, Option(usize).Some(usize(1))), {
    match(
      last_expr,
      .FnCall(_, _, ret_args, _, _) => match(
        ret_args.get(usize(0)),
        .Some(ra) => {
          return_value_expr = ra;
        },
        .None => ()
      ),
      _ => ()
    );
  });
  rv_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(return_value_expr));
  rv_name_opt := match(
    rv_info_opt,
    .Some(rv_info) => rv_info.variable_name,
    .None => Option(String).None
  );
  match(
    rv_name_opt,
    .None => (),
    .Some(rv_name) => {
      rv_vars := get_variables_from_env(env, rv_name);
      nrv := rv_vars.len();
      if(nrv == usize(0), {
        // The tail's recorded temp name is NOT visible in the live begin env
        // (snapshot env threading can drop an inline field-read's temp
        // registration on a bare-expression body — e.g. `(fn(p : Pair) ->
        // Krate)(p.inner)`). TS's persistent env always finds it and takes
        // the non-owning → dup branch. Delegate to set_expr_as_needs_to_call_dup,
        // which re-checks ownership/consumption against the RECORDED ei.env
        // (where the temp does exist): owning temps still consume, non-RC and
        // inlinable-concrete values still decline — only the borrowed case
        // gains its balancing +1 (the round-3 borrowed-field-tail UAF).
        set_expr_as_needs_to_call_dup(return_value_expr, ctx, exn);
      });
      if(nrv > usize(0), {
        match(
          rv_vars.get(nrv - usize(1)),
          .None => (),
          .Some(rv) => {
            ty_ok := match(
              rv_info_opt,
              .Some(rv_info_t) => are_types_compatible(rv.ty, rv_info_t.ty),
              .None => false
            );
            if(ty_ok, {
              // `own(name) : T` parameters in the parameter frame also transfer
              // ownership directly when returned from ANY nested begin block —
              // mirrors begin.ts `isOwnParamReturn` (matched by label against
              // the enclosing function's parameter list).
              is_own_param_return := (
                (rv.is_owning_the_rc_value && rv.consumed_at_token.is_none()) && match(
                  ctx.is_evaluating_function_body_or_async_block,
                  .Some(fc) => match(
                    fc.kind,
                    .FunctionBody => match(
                      fc.func_type,
                      .Some(fty) => match(
                        fty,
                        .Func({ meta : own_fm }) => {
                          (own_found : bool) = false;
                          own_labels := own_fm.*.param_labels;
                          own_flags := own_fm.*.param_is_owning;
                          (own_i : usize) = usize(0);
                          n_own := own_labels.len();
                          while((own_i < n_own) && (!(own_found)), {
                            lbl_match := match(own_labels.get(own_i),.Some(lbl) => (lbl == rv_name),.None => false);
                            flag_match := match(own_flags.get(own_i),.Some(fl) => fl,.None => false);
                            if(lbl_match && flag_match, {
                              own_found = true;
                            });
                            own_i = (own_i + usize(1));
                          });
                          own_found
                        },
                        _ => false
                      ),
                      .None => false
                    ),
                    _ => false
                  ),
                  .None => false
                )
              );
              if((rv.is_owning_the_rc_value && ((rv.frame_level == (env.frames.len() - usize(1))) || is_own_param_return)) && rv.consumed_at_token.is_none(), {
                // Transfer: consumed — the scope-end scheduler (e5) skips it.
                rv.consumed_at_token = Option(Box(Token)).Some(box(ast_expr_token(last_expr)));
              }, {
                // Borrow/outer-frame share: balancing dup.
                set_expr_as_needs_to_call_dup(return_value_expr, ctx, exn);
              });
            });
          }
        );
      });
    }
  );
  // OPTIMIZE_DUP_AND_DROP_PAIRS (begin.ts:1787-2062): cancel each candidate
  // local's single runtime dup against its scope-end drop — a MOVE. Winners
  // are marked consumed HERE so the scheduler's e5 gate skips their drop and
  // the M3 driver below attaches their early-return-only drops.
  match(
    current_frame_opt,
    .Some(opt_fr) => _optimize_dup_drop_pairs(opt_fr, begin_args, last_info.variable_name, last_expr, ctx),
    .None => ()
  );
  // M1: schedule scope-end RC drops for this frame's owning named locals BEFORE the
  // frame is popped (the `___drop(name)` exprs are evaluated against `env` while the
  // names are still in scope). See _schedule_scope_end_drops + plans/archive/YO_SELF_NAMED_LOCAL_DROPS.md.
  (scope_end_drops : Option(ArrayList(AstExpr))) = match(
    current_frame_opt,
    .Some(fr) => _schedule_scope_end_drops(fr, begin_args, last_info.variable_name, last_expr, env, ctx, exn),
    .None => Option(ArrayList(AstExpr)).None
  );
  // For the FUNCTION-BODY begin block, also schedule drops for the
  // PARAMETERS frame (one level below) — `own(name) : T` params carry a
  // reference the caller transferred in (helper.yo's own-arg move/dup) and
  // the callee must release it at scope end. Mirrors TS begin.ts:1894-1906
  // (getVariablesNeedingDrop over the parameters frame, appended AFTER the
  // locals so params drop last). Borrow params are excluded by the
  // scheduler's owning gate, inout by is_ref, returned own params by the
  // consumed mark the own-param-return transfer sets above. Without this,
  // an own param that the body moved into a local was never released —
  // rc() stayed +1 where TS releases (the yo-self arm of
  // issues/fixed/own-param-discard-leak.md, caught by
  // tests/ref_field_borrow.test.yo under the self-hosted runner).
  if(is_evaluating_function_body_begin_block && (env.frames.len() >= usize(2)), {
    match(
      env.frames.get(env.frames.len() - usize(2)),
      .Some(params_fr) => {
        params_drops := _schedule_scope_end_drops(params_fr, begin_args, last_info.variable_name, last_expr, env, ctx, exn, true);
        match(
          params_drops,
          .Some(pd_list) => {
            (merged : ArrayList(AstExpr)) = match(
              scope_end_drops,
              .Some(existing) => existing,
              .None => ArrayList(AstExpr).new()
            );
            (pd_i : usize) = usize(0);
            while(pd_i < pd_list.len(), {
              match(
                pd_list.get(pd_i),
                .Some(pd) => {
                  merged.push(pd);
                },
                .None => ()
              );
              pd_i = (pd_i + usize(1));
            });
            scope_end_drops = Option(ArrayList(AstExpr)).Some(merged);
          },
          .None => ()
        );
      },
      .None => ()
    );
  });
  // M3 driver: attach early-return-only `___drop`s for CONSUMED (moved-out) owning
  // locals to each return/unwind preceding consumption (begin.ts:2068-2122). Runs
  // before pop_frame. Consumed vars are disjoint from the scope-end drop set.
  match(
    current_frame_opt,
    .Some(fr2) => {
      begin_tok := ast_expr_token(expr);
      (evi : usize) = usize(0);
      while(evi < fr2.variables.len(), {
        match(
          fr2.variables.get(evi),
          .Some(ev) => {
            not_auto := !(ev.token.module_path.starts_with(String.from("auto-generated://")));
            eligible := (ev.consumed_at_token.is_some() && (ev.initialized_at_token.is_some() && (not_auto && (!(_variable_is_captured_by_current_function(ev, ctx)) && _variable_can_need_drop_ignoring_consumed(ev)))));
            init_ok := match(ev.initialized_at_token,.Some(it) => _m3_token_is_at_or_before(begin_tok, it),.None => false);
            if(eligible && init_ok, {
              drop_code := `___drop(${ev.name})`;
              drop_expr := generate_expr_from_code(drop_code, exn);
              evaluated := evaluate_expression_raw(drop_expr, env, ctx, exn);
              (dai : usize) = usize(0);
              while(dai < begin_args.len(), {
                match(begin_args.get(dai),.Some(arg) => _attach_early_return_only_drop_to_returns(arg, ev, evaluated, ctx),.None => ());
                dai = (dai + usize(1));
              });
            });
          },
          .None => ()
        );
        evi = (evi + usize(1));
      });
    },
    .None => ()
  );
  env.pop_frame_nonmutating();
  // -------------------------------------------------------------------------
  // Build ExprInfo for the begin expression itself.
  //
  // A SINGLE-expression begin block (`expr` was not a real `begin(...)` call,
  // so it was wrapped in a 1-element list at the top) has its result node
  // EQUAL to the inner expression node — yo-self reuses `expr`'s id rather
  // than clone+mutate-into-begin like TS (begin.ts:1016-1045, which clones
  // the inner expr so its `$` lives on a separate node). Codegen then reads
  // this ONE id in BOTH roles: the inner expression's shape (the match/call/
  // address-of emitters) and the begin block (scope-end drops). A fresh info
  // here therefore CLOBBERED every inner field codegen needs unless it was on
  // a hand-picked carry list — four separate miscompiles came from that
  // (issues/yo-self-begin-shared-id-clobber.md). INVERT the merge instead:
  // start from a copy of the tail's info (preservation is the default),
  // override what the begin level owns (env/ty in the clone helper; value +
  // deferred_drop_expressions below), and explicitly CLEAR the fields whose
  // begin-role meaning conflicts with the inner-role one — the old carries'
  // gates, applied as clears:
  //   - `runtime_arg_exprs_in_order` + the index-field triplet: cleared for a
  //     comptime-FOLDED tail (`!carry_runtime_args`) — a folded construct
  //     (`.Some(i32(7))`) emits via the comptime-value path, and carrying its
  //     arg list wrongly tripped the runtime-construction codegen
  //     (`ctor_has_runtime_args`), corrupting the literal's type name
  //     (match_arm_folded_fncall + runtime_enum_construct regressions).
  //   - `variable_name`: cleared unless FUNCTION-BODY begin AND runtime tail —
  //     for match/cond ARM begins the attach_temp_variable_to_expr below would
  //     re-register the carried name as an OWNING variable in the ENCLOSING
  //     begin frame of the SAME C function, scheduling a scope-end drop
  //     against a declared temp whose value the arm's `_result` assignment
  //     already moved out (over-release); a folded tail's recorded temp would
  //     pollute downstream type names.
  // Kept from the tail without a gate (the old unconditional carries):
  // `deferred_dup_expressions` (begin-tail ownership +1 — losing it freed
  // `.Ok(map) => map` while the caller held it), `is_index_trait_address_of`
  // (dangling stack pointer on `s(i) = ...` writes), the `rare` group's
  // `is_primitive_match` (bare primitive `match` fn body took the enum
  // branch), and now every OTHER inner field (source_variable, origin_type,
  // early-return-only drops, converted type / dyn traits / async analysis...)
  // that previously needed its own empirical carry.
  // -------------------------------------------------------------------------
  shared_with_tail := (ast_expr_id(expr) == ast_expr_id(last_expr));
  (out_info : ExprInfo) = if(
    shared_with_tail,
    clone_expr_info_for_shared_begin_result(last_info, env, return_type),
    new_expr_info(env, return_type)
  );
  out_info.deferred_drop_expressions = scope_end_drops;
  out_info.value = cond(has_runtime_side_effects => Option(EvalValue).None, true => last_info.value);
  out_info.control_flow = last_info.control_flow;
  out_info.comptime_ref = last_info.comptime_ref;
  out_info.capture_type = last_info.capture_type;
  // NOTE: `out_info.popped_env_frame = current_frame_opt` REMOVED. The field is
  // WRITE-ONLY DEAD STATE — nothing in yo-self ever reads popped_env_frame (grep:
  // only the field def + this former write). Storing every block's popped frame
  // pinned its bound Variables (the per-call `new_variable` env Variables — the
  // dominant self-compile eval leaker, 2.7M live) on the whole-compile
  // expr_info_table forever. Not storing it lets `current_frame_opt` (and its
  // Variables) be RC-freed at scope end. See issues/fixed/yo-self-fixpoint-eval-phase-leak.md.
  // Runtime-RESULT gate for the clears below: a bare runtime call
  // (UnknownVal), a unit-returning call (UnitVal), no value, OR a RUNTIME
  // enum/struct construction whose shell carries an UnknownVal payload
  // (`.Some((p &+ i).*)` in ArrayList.get → runtime construction codegen). A
  // fully comptime-FOLDED construct (`.None`, `.Some(i32(7))`, `i32(0)`) has
  // only concrete leaves and emits via the comptime-value path.
  carry_runtime_args := match(
    last_info.value,
    .None => true,
    .Some(v) => match(v,.UnitVal => true, _ => _value_contains_unknown(v))
  );
  if(shared_with_tail && !(carry_runtime_args), {
    out_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).None;
    out_info.index_trait_ptr_type = Option(TypeValue).None;
    out_info.index_method_type = Option(TypeValue).None;
    out_info.index_method_value = Option(EvalValue).None;
  });
  if(shared_with_tail && !(is_evaluating_function_body_begin_block && carry_runtime_args), {
    out_info.variable_name = Option(String).None;
  });
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  // Attach temp variable for the begin block result (no-op stub in Phase 2aa).
  attach_temp_variable_to_expr(expr, true, ctx);
  expr
});
export(DupCallsResult, is_unit_value_expression);
export(collect_dup_calls_conservatively);
export(evaluate_begin_expression);
