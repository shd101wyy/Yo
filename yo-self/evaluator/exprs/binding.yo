//! evaluate_binding — handles `(name : T)` typed variable declarations.
//!
//! 1:1 port of `src/evaluator/exprs/binding.ts`.
//!
//! `(name : T)` is a type-only declaration: it introduces `name` into the
//! environment with type `T` but no value yet. Initialization comes from the
//! subsequent `:=` or `=` assignment operator. The function is also called by
//! the assignment handler for the `(name : T) := rhs` compound form.
//!
//! Returns a `BindingResult` struct with the evaluated expr, the lhs sub-expr,
//! and the variable name string.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  ast_expr_to_string,
  BK_COMPTIME,
  BK_GIVEN,
  BK_COLON,
  make_err_expr
} :: import("../../expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_get, expr_info_table_set, expr_info_paths_for_write, register_module_level_global } :: import("../../expr_info.yo");
{ Environment, add_variable_to_env, get_variables_from_env } :: import("../../env.yo");
{ EvalContext, FuncOrAsyncBlockKind, in_def_time_trial } :: import("../context.yo");
{ EvalValue, is_type_value, create_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{
  is_array_type,
  is_function_type,
  is_function_type_generic,
  is_function_type_and_returns_comptime_value
} :: import("../../types/guards.yo");
{ type_to_string } :: import("../../types/string.yo");
{
  prohibit_void_type,
  type_requires_comptime_modifier,
  type_prohibits_comptime_modifier,
  type_contains_rc_type,
  get_all_some_types
} :: import("../../types/utils.yo");
{ format_error_message, format_error_messages, TokenAndError, YoError } :: import("../../error.yo");
{ type_implements_comptime, type_implements_runtime_full } :: import("../trait_checking.yo");
{ Exception } :: import("std/error");
{ evaluate_expression } :: import("./expr.yo");
{ is_valid_variable_name } :: import("../utils.yo");
/// Deferred-check flag for the generic-fn-type rule (see the gate below and
/// exprs/assignment.yo). Module-global because EvalContext field additions
/// ripple through every explicit constructor; evaluation is single-threaded.
(g_defer_generic_fn_type_check : bool) = false;
set_defer_generic_fn_type_check :: (fn(v : bool) -> unit)({
  g_defer_generic_fn_type_check = v;
});
// ---------------------------------------------------------------------------
// Return type
// ---------------------------------------------------------------------------
/// The result of `evaluate_binding`. Mirrors the anonymous TS return type.
BindingResult :: ref(
  struct(
    /// The fully annotated `:` expression.
    expr : AstExpr,
    /// The lhs name expression (after stripping `comptime(...)` / `given(...)`).
    variable_expr : AstExpr,
    /// The plain string name of the variable being declared.
    variable_name : String
  )
);
// ---------------------------------------------------------------------------
// evaluate_binding
// ---------------------------------------------------------------------------
/// Evaluate a `(name : T)` type-annotation declaration.
///
/// Validates the expression shape, evaluates the type annotation on the rhs,
/// strips optional `comptime(...)` / `given(...)` wrappers from the lhs, adds
/// the variable to `env`, and writes `ExprInfo` for both the lhs and the
/// whole `":"` expression into `ctx.expr_info_table`.
///
/// Mirrors `evaluateBinding` in `src/evaluator/exprs/binding.ts`.
evaluate_binding :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> BindingResult
)({
  // Mutable env that we update from rhs ExprInfo.
  (env : Environment) = env_in;
  // Validate shape: ":" with exactly 2 args.
  if(!(ast_expr_is_fn_call_of(expr, BK_COLON, .Some(usize(2)))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "${BK_COLON}" for variable binding.`,
          false,
          .None
        )
      )
    );
  });
  // Pull lhs and rhs from the FnCall args.
  (lhs_arg : AstExpr) = match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  rhs := match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  // Evaluate the rhs to obtain the declared type.
  evaluated_rhs := evaluate_expression(rhs, env, ctx);
  rhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_rhs));
  if(rhs_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(rhs),
          `Failed to evaluate rhs expression:\n${ast_expr_to_string(rhs)}`,
          false,
          .None
        )
      )
    );
  });
  rhs_info := match(rhs_info_opt, .Some(i) => i, .None => new_expr_info(env, t_unit()));
  // Update env from rhs evaluation.
  env.frames = rhs_info.env.frames;
  env.module_path = rhs_info.env.module_path;
  env.function_declaration_frame_level = rhs_info.env.function_declaration_frame_level;
  env.input_string = rhs_info.env.input_string;
  // Rhs must evaluate to a TypeValue.
  if(!(is_type_value(rhs_info.value)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(rhs),
          `Expected type for rhs, got ${ast_expr_to_string(rhs)}`,
          false,
          .None
        )
      )
    );
  });
  user_defined_type := match(
    rhs_info.value,
    .Some(v) => match(
      v,
      .TypeVal(bt) => bt,
      _ => t_unit()
    ),
    .None => t_unit()
  );
  // Array types with inferred length are not allowed in type annotations
  // (TS binding.ts:76: `isArrayType(t) && isUnknownValue(t.length)`). The
  // `_` placeholder is value-position-only (`arr := Array(i32, _)(1,2,3)`).
  // yo-self's `_` path (evaluator/types/array.yo) mints a length_var named
  // `_array_length_*` — gate on that prefix so legitimate generic-impl
  // length variables (`Array(T, U)`) in other positions are unaffected.
  // Without this, the array.test.yo cee that EXPECTS this rejection
  // evaluated successfully and emptied the whole batch main.
  match(
    user_defined_type,
    .Array(_, _, udt_lvar) => if(udt_lvar.starts_with("_array_length_"), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(rhs),
            `Array type with inferred length '_' is not allowed in type annotations.\nUse explicit length like 'Array(i32, 3)' or omit the type annotation and initialize with 'arr := Array(i32, _)(1, 2, 3)'`,
            false,
            .None
          )
        )
      );
    }),
    _ => ()
  );
  // Prohibit void type.
  prohibit_void_type(user_defined_type, ast_expr_token(rhs), exn);
  // Strip optional `comptime(...)` wrapper from lhs.
  (is_compile_time_only : bool) = false;
  (lhs : AstExpr) = lhs_arg;
  if(ast_expr_is_fn_call_of(lhs, BK_COMPTIME, .None), {
    is_compile_time_only = true;
    n_comptime_args := match(
      lhs,
      .FnCall(_, _, cargs, _, _) => cargs.len(),
      .Atom(_, _) => usize(0)
    );
    if(n_comptime_args != usize(1), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `Expected one argument for "comptime", got ${n_comptime_args.to_string()}`,
            false,
            .None
          )
        )
      );
    });
    lhs = match(
      lhs,
      .FnCall(_, _, cargs, _, _) => match(cargs.get(usize(0)), .Some(a) => a, .None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
  });
  // Strip optional `given(...)` wrapper (implies implicit + comptime).
  (is_implicit : bool) = false;
  if(ast_expr_is_fn_call_of(lhs, BK_GIVEN, .None), {
    n_given_args := match(
      lhs,
      .FnCall(_, _, gargs, _, _) => gargs.len(),
      .Atom(_, _) => usize(0)
    );
    if(n_given_args != usize(1), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `Expected exactly one argument for "given", got ${n_given_args.to_string()}`,
            false,
            .None
          )
        )
      );
    });
    is_implicit = true;
    is_compile_time_only = true;
    lhs = match(
      lhs,
      .FnCall(_, _, gargs, _, _) => match(gargs.get(usize(0)), .Some(a) => a, .None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
  });
  // context.forceCompileTimeBindings forces all bindings to be compile-time.
  if(ctx.force_compile_time_bindings, {
    is_compile_time_only = true;
  });
  // Reject runtime bindings inside a compile-time-only function body.
  // Mirrors: context.isEvaluatingFunctionBodyOrAsyncBlock?.kind === "function-body"
  //          && context.isEvaluatingFunctionBodyOrAsyncBlock?.type.return.isCompileTimeOnly
  if(!(is_compile_time_only), {
    is_ctfe_body := match(
      ctx.is_evaluating_function_body_or_async_block,
      .Some(fctx) => (
        match(fctx.kind, .FunctionBody => true, _ => false) &&
          match(
            fctx.func_type,
            .Some(ft) => is_function_type_and_returns_comptime_value(ft),
            .None => false
          )
      ),
      .None => false
    );
    if(is_ctfe_body, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `Unexpected runtime variable binding in a compile-time only function body.`,
            false,
            .None
          )
        )
      );
    });
  });
  // Validate lhs is a valid variable name (identifier or operator).
  if(!(is_valid_variable_name(lhs)), {
    lhs_tok_val := ast_expr_token(lhs).value;
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs),
          `Invalid binding to "${lhs_tok_val}", expected identifier or operator`,
          false,
          .None
        )
      )
    );
  });
  // Reject type annotations that require comptime but binding is runtime.
  // Env-aware fallback for COMPOUND comptime-only types — see the twin gate
  // in initialization_assignment.yo.
  binding_requires_ct := (type_requires_comptime_modifier(user_defined_type) || (type_implements_comptime(user_defined_type, env) && !(type_implements_runtime_full(user_defined_type, env))));
  // In a DEFINITION-time body trial a type still carrying unresolved SomeTs
  // cannot be judged comptime-only — the twin of the ::-vs-:= skip in
  // initialization_assignment.yo (root 7837, IterFilter's
  // `(loop_result : Option(A)) = .None` — A is the where-constraint SomeT;
  // issues/def-eval-swallow-remaining-roots.md). The specialization-time
  // re-eval re-checks with concrete types.
  binding_ct_check := cond(
    ((in_def_time_trial() && binding_requires_ct) && (get_all_some_types(user_defined_type).len() > usize(0))) => false,
    true => binding_requires_ct
  );
  if(binding_ct_check && !(is_compile_time_only), {
    ty_str := type_to_string(user_defined_type);
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs),
          `Expected "comptime" for compile-time known value binding:\n${ty_str}`,
          false,
          .None
        )
      )
    );
  });
  // Reject comptime modifier on runtime-only types.
  if(type_prohibits_comptime_modifier(user_defined_type) && is_compile_time_only, {
    ty_str := type_to_string(user_defined_type);
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs),
          `Unexpected "comptime" for ${ty_str} which can only be used at runtime.`,
          false,
          .None
        )
      )
    );
  });
  variable_name := ast_expr_token(lhs).value;
  // Reject runtime vars with generic function types — DEFERRABLE: exprs/
  // assignment.yo sets the flag around its typed-binding eval and re-runs
  // the check itself after the RHS is evaluated, relaxing it for ctl
  // handlers whose body ALWAYS unwinds (TS binding.ts:160
  // `deferGenericFnTypeCheckToAssignment` + assignment.ts:447-470).
  if(((!(is_compile_time_only)) && !(g_defer_generic_fn_type_check)) && (is_function_type(user_defined_type) && is_function_type_generic(user_defined_type)), {
    ty_str := type_to_string(user_defined_type);
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs),
          `Runtime variables with generic function types are not allowed:\n${ty_str}\n\nGeneric functions must be compile-time known to enable monomorphization. Consider using:\ncomptime(${variable_name}) : ${ty_str}`,
          false,
          .None
        )
      )
    );
  });
  // Reject mutable runtime vars inside impl blocks.
  is_inside_fn_body := match(
    ctx.is_evaluating_function_body_or_async_block,
    .Some(_) => true,
    .None => false
  );
  if((!(is_compile_time_only)) && (!(is_inside_fn_body) && ctx.is_inside_impl_block), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs),
          `Mutable runtime variable "${variable_name}" is not allowed inside an impl block.\nUse "::" for compile-time definitions inside impl.`,
          false,
          .None
        )
      )
    );
  });
  // Module-level: runtime var at module scope (not inside a function body).
  is_module_level := (!(is_compile_time_only) && !(is_inside_fn_body));
  // Initial value: comptime vars get an UnknownVal placeholder; runtime vars get None.
  initial_value_opt := cond(
    is_compile_time_only => Option(EvalValue).Some(create_unknown_val(user_defined_type)),
    true => Option(EvalValue).None
  );
  // No-shadowing rule (TS env.ts:644-658, enforced inside addVariableToEnv) —
  // same check as initialization_assignment.yo; see the comment there for why
  // yo-self keeps it at the user binding-introduction sites.
  if(variable_name != String.from("__yo_self"), {
    shadow_existing := get_variables_from_env(env, variable_name);
    if(shadow_existing.len() > usize(0), {
      match(
        shadow_existing.get(shadow_existing.len() - usize(1)),
        .Some(shadow_var) => {
          sh_entries := ArrayList(TokenAndError).new();
          sh_entries.push(
            TokenAndError(
              token : ast_expr_token(lhs),
              error_message : `Failed to define variable "${variable_name}":`
            )
          );
          sh_entries.push(
            TokenAndError(
              token : shadow_var.token,
              error_message : `Variable "${variable_name}" is already defined here (variable shadowing is not allowed):`
            )
          );
          exn.throw(dyn(format_error_messages(sh_entries, false, .None)));
        },
        .None => ()
      );
    });
  });
  // Add the variable to the environment.
  _var_opt := add_variable_to_env(
    env,
    variable_name,
    user_defined_type,
    initial_value_opt,
    is_compile_time_only,
    true,
    // is_reassignable
    type_contains_rc_type(user_defined_type),
    // is_owning_the_rc_value
    is_implicit,
    ast_expr_token(lhs)
  );
  // The variable is NOT initialized yet — initialization happens in the
  // enclosing `=` assignment. Mirrors binding.ts:211
  // (`initializedAtToken: undefined`). add_variable_to_env stamps
  // Some(token) (correct for params and `:=` bindings), so clear it here.
  // Without this, `(x : T) = rhs` reads as a REASSIGNMENT in
  // evaluate_assignment (is_mutating_defined_variable true) and wrongly
  // attaches a save-old-value temp for a variable that has no old value —
  // emitting `T temp = x; // Save old value` before `x` is even declared.
  match(
    _var_opt,
    .Some(new_binding_var) => {
      new_binding_var.initialized_at_token = .None;
      // Stamp module-level-ness — computed above but previously never
      // patched onto the variable for the `(name : T) = ...` binding form
      // (add_variable_to_env has no is_module_level parameter). Also record
      // it in the data-keyed registry, which survives env copies (see
      // expr_info.yo g_module_level_globals).
      new_binding_var.is_module_level = is_module_level;
      if(is_module_level, {
        register_module_level_global(ast_expr_token(lhs).module_path.clone(), variable_name.clone());
      });
    },
    .None => ()
  );
  // Write ExprInfo for the lhs expression.
  // pathCollection = [[variableName]] (one-element path collection, matches TS).
  lhs_path := ArrayList(String).new();
  lhs_path.push(variable_name);
  lhs_info := new_expr_info(env, user_defined_type);
  expr_info_paths_for_write(lhs_info).push(lhs_path);
  lhs_info.variable_name = .Some(variable_name);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(lhs), lhs_info);
  // Write ExprInfo for the whole ":" expression.
  expr_info := new_expr_info(env, t_unit());
  expr_info.value = .Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
  BindingResult(
    expr : expr,
    variable_expr : lhs,
    variable_name : variable_name
  )
});
export(BindingResult, evaluate_binding);
export(set_defer_generic_fn_type_check);
