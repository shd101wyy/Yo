//! evaluate_cond — evaluates `cond(...)` expressions.
//! 1:1 port of `src/evaluator/exprs/cond.ts` (Phase 2ac).
//!
//! Exported symbols: evaluate_cond
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_COND
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  ControlFlowFlags,
  control_flow_of,
  has_control_flow,
  has_any_control_flow,
  merge_control_flows,
  branch_init_log_len,
  register_arm_init_range,
  push_branch_group,
  begin_branch_group_arm,
  pop_branch_group
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ Variable } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{ EvalValue, create_unknown_val, is_bool_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_bool, t_unit } :: import("../../types/creators.yo");
{
  is_bool_type,
  is_some_type,
  is_pointer_type,
  is_function_type_and_returns_comptime_value
} :: import("../../types/guards.yo");
{ type_contains_some_type, type_contains_some_type_deep } :: import("../../types/utils.yo");
{ convert_comptime_type_to_runtime_type } :: import("../../types/env_lookup.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message } :: import("../../error.yo");
{
  merge_and_check_envs,
  consume_case_body_temp_var,
  attach_temp_variable_to_expr
} :: import("../utils.yo");
{ evaluate_begin_expression } :: import("./begin.yo");
{ evaluate_expression } :: import("./expr.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// Local struct definitions
// ---------------------------------------------------------------------------
/// One parsed `cond` arm (before condition evaluation).
ParsedStmt :: struct(
  cond_expr : AstExpr,
  case_body_expr : AstExpr,
  case_env : Environment
);
/// One evaluated `cond` arm (condition already evaluated, body not yet).
EvaluatedCond :: struct(
  cond_expr : AstExpr,
  case_body_expr : AstExpr,
  case_env : Environment,
  cond_value : Option(EvalValue)
);
/// Tracks the unified value-type across `cond` arms.
ValueTypeState :: struct(
  ty : TypeValue,
  env : Environment
);
// ---------------------------------------------------------------------------
// evaluate_cond — main function
// ---------------------------------------------------------------------------
/// Evaluate a `cond(...)` expression.
///
/// Mirrors `evaluateCond` in `src/evaluator/exprs/cond.ts`.
evaluate_cond :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Validate that the expression is a cond() call.
  if(!(ast_expr_is_fn_call_of(expr, BK_COND,.None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "cond"`,
          false,
          .None
        )
      )
    );
  });
  // Extract argument list.
  statements := match(
    expr,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  statement_count := statements.len();
  if(statement_count == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected at least one statement in "cond", got 0`,
          false,
          .None
        )
      )
    );
  });
  // -------------------------------------------------------------------------
  // First pass: parse and validate all cond arms
  // -------------------------------------------------------------------------
  parsed_stmts := ArrayList(ParsedStmt).new();
  (pi : usize) = usize(0);
  while(pi < statement_count, {
    statement := match(statements.get(pi),.Some(s) => s,.None => make_err_expr());
    is_arrow_call := (ast_expr_is_fn_call(statement) && ast_expr_is_fn_call_of(statement, "=>",.Some(usize(2))));
    if(!(is_arrow_call), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(statement),
            `Expected => for cond statement, got ${ast_expr_to_string(statement)}`,
            false,
            .None
          )
        )
      );
    });
    cond_expr := match(
      statement,
      .FnCall(_, _, sargs, _, _) => match(sargs.get(usize(0)),.Some(a) => a,.None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
    case_body_expr := match(
      statement,
      .FnCall(_, _, sargs, _, _) => match(sargs.get(usize(1)),.Some(a) => a,.None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
    parsed_stmts.push(
      ParsedStmt(
        cond_expr : cond_expr,
        case_body_expr : case_body_expr,
        case_env : env
      )
    );
    pi = (pi + usize(1));
  });
  // -------------------------------------------------------------------------
  // Second pass: evaluate all conditions (break early on compile-time true)
  // -------------------------------------------------------------------------
  evaluated_conds := ArrayList(EvaluatedCond).new();
  (done_eval : bool) = false;
  (ec_i : usize) = usize(0);
  while((ec_i < parsed_stmts.len()) && !(done_eval), {
    pstmt := match(
      parsed_stmts.get(ec_i),
      .Some(s) => s,
      .None => {
        done_eval = true;
        return(expr);
      }
    );
    cond_expr := pstmt.cond_expr;
    case_body_expr := pstmt.case_body_expr;
    case_env := pstmt.case_env;
    // Evaluate condition with expected type = bool.
    old_expected := ctx.expected_type;
    ctx.expected_type = Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : t_bool(), env : case_env));
    evaluated_cond_expr := cond(
      ast_expr_is_atom(cond_expr) =>
        evaluate_expression(cond_expr, case_env, ctx),
      true =>
        evaluate_begin_expression(cond_expr, case_env, ctx, ArrayList(Variable).new(), false, exn)
    );
    ctx.expected_type = old_expected;
    // Require that the evaluator produced ExprInfo.
    cond_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_cond_expr));
    if(cond_info_opt.is_none(), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(evaluated_cond_expr),
            `Failed to evaluate condition expression: ${ast_expr_to_string(evaluated_cond_expr)}`,
            false,
            .None
          )
        )
      );
    });
    cond_info := match(
      cond_info_opt,
      .Some(ci) => ci,
      .None => {
        return(expr);
      }
    );
    // Require bool type — but tolerate `unit` (from an `UnknownVal`
    // emitted by an upstream soft-fallback, e.g. operator-trait
    // lookup that the bootstrap can't yet resolve). Treat the
    // condition as non-comptime-true and let the rest of the
    // case-selection logic fall through naturally.
    is_unit_fallback := match(cond_info.ty,.Unit => true, _ => false);
    if((!(is_bool_type(cond_info.ty))) && !(is_unit_fallback), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(evaluated_cond_expr),
            `Expected bool for cond statement, got ${ast_expr_to_string(evaluated_cond_expr)} of type ${type_to_string(cond_info.ty)}`,
            false,
            .None
          )
        )
      );
    });
    cond_val := cond_info.value;
    updated_case_env := cond_info.env;
    // Last condition must be compile-time known `true`.
    is_last := (ec_i == (parsed_stmts.len() - usize(1)));
    is_comptime_true := match(cond_val,.Some(v) => match(v,.BoolVal(b) => b, _ => false),.None => false);
    if(is_last && !(is_comptime_true), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(evaluated_cond_expr),
            `Expect the last condition to be compile-time known "true".`,
            false,
            .None
          )
        )
      );
    });
    evaluated_conds.push(
      EvaluatedCond(
        cond_expr : evaluated_cond_expr,
        case_body_expr : case_body_expr,
        case_env : updated_case_env,
        cond_value : cond_val
      )
    );
    // Stop evaluating further if we found a compile-time true condition.
    if(is_comptime_true, {
      done_eval = true;
    });
    ec_i = (ec_i + usize(1));
  });
  // -------------------------------------------------------------------------
  // Third pass: find the first compile-time true index (if any)
  // -------------------------------------------------------------------------
  (first_true_index : Option(usize)) = Option(usize).None;
  (fti : usize) = usize(0);
  (fti_done : bool) = false;
  while((fti < evaluated_conds.len()) && !(fti_done), {
    ec_here := match(
      evaluated_conds.get(fti),
      .Some(c) => c,
      .None => {
        fti_done = true;
        return(expr);
      }
    );
    is_comptime_true_here := match(ec_here.cond_value,.Some(v) => match(v,.BoolVal(b) => b, _ => false),.None => false);
    if(is_comptime_true_here, {
      // Ensure all previous conditions were compile-time false.
      (all_prev_false : bool) = true;
      (j : usize) = usize(0);
      while((j < fti) && all_prev_false, {
        match(
          evaluated_conds.get(j),
          .Some(prev) => {
            prev_is_false := match(prev.cond_value,.Some(v) => match(v,.BoolVal(b) => !(b), _ => false),.None => false);
            if(!(prev_is_false), {
              all_prev_false = false;
            });
          },
          .None => {
            all_prev_false = false;
            j = fti;
          }
        );
        j = (j + usize(1));
      });
      if(all_prev_false, {
        first_true_index = Option(usize).Some(fti);
        fti_done = true;
      });
    });
    fti = (fti + usize(1));
  });
  // -------------------------------------------------------------------------
  // Fourth pass: evaluate bodies
  // -------------------------------------------------------------------------
  bodies := ArrayList(AstExpr).new();
  (value_type : Option(ValueTypeState)) = Option(ValueTypeState).None;
  match(
    first_true_index,
    // ---------------------------------------------------------------------
    // A compile-time true condition was found — evaluate only its body.
    // ---------------------------------------------------------------------
    .Some(fti_idx) => {
      ec_true := match(
        evaluated_conds.get(fti_idx),
        .Some(c) => c,
        .None => {
          return(expr);
        }
      );
      cond_expr_true := ec_true.cond_expr;
      case_body_true := ec_true.case_body_expr;
      case_env_true := ec_true.case_env;
      // Mark condition as executed.
      match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(cond_expr_true)),
        .None => (),
        .Some(ci) => {
          ci.case_executed = Option(bool).Some(true);
        }
      );
      // Evaluate the body (branch-init window recorded for the cross-branch
      // type checks in merge_and_check_envs).
      bir_start_t := branch_init_log_len();
      evaluated_body := evaluate_begin_expression(case_body_true, case_env_true, ctx, ArrayList(Variable).new(), false, exn);
      register_arm_init_range(ast_expr_id(evaluated_body), bir_start_t, branch_init_log_len());
      body_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_body));
      body_cf := match(body_info_opt,.Some(bi) => bi.control_flow,.None => Option(ControlFlowFlags).None);
      if(has_any_control_flow(body_cf), {
        // Body has control flow — propagate without a value.
        body_info := match(
          body_info_opt,
          .Some(bi) => bi,
          .None => {
            return(expr);
          }
        );
        result_ty := cond(
          match(ctx.expected_type,.Some(et) => !(type_contains_some_type_deep(et.ty)),.None => false) =>
            match(ctx.expected_type,.Some(et) => et.ty,.None => body_info.ty),
          true => body_info.ty
        );
        out_info := new_expr_info(body_info.env, result_ty);
        out_info.value = body_info.value;
        out_info.path_collection = body_info.path_collection;
        out_info.control_flow = body_info.control_flow;
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
        return(expr);
      }, {
        // No control flow — use this body's type and value.
        body_info := match(
          body_info_opt,
          .Some(bi) => bi,
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(evaluated_body),
                  `Expected type for cond statement, got ${ast_expr_to_string(evaluated_body)}`,
                  false,
                  .None
                )
              )
            );
            return(expr);
          }
        );
        bodies.push(evaluated_body);
        value_type = Option(ValueTypeState).Some(ValueTypeState(ty : body_info.ty, env : body_info.env));
        env.frames = body_info.env.frames;
        env.module_path = body_info.env.module_path;
        env.function_declaration_frame_level = body_info.env.function_declaration_frame_level;
        env.input_string = body_info.env.input_string;
        result_ty := cond(
          match(ctx.expected_type,.Some(et) => !(type_contains_some_type_deep(et.ty)),.None => false) =>
            match(ctx.expected_type,.Some(et) => et.ty,.None => body_info.ty),
          true => body_info.ty
        );
        out_info := new_expr_info(env, result_ty);
        out_info.value = body_info.value;
        out_info.variable_name = body_info.variable_name;
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
        // Only attach a new temp variable if the inner body doesn't have one.
        if(body_info.variable_name.is_none(), {
          attach_temp_variable_to_expr(expr, true, ctx);
        });
        return(expr);
      });
    },
    // ---------------------------------------------------------------------
    // No compile-time true found — evaluate all non-false arms.
    // ---------------------------------------------------------------------
    .None => {
      (has_case_without_control_flow : bool) = false;
      control_flows := ArrayList(ControlFlowFlags).new();
      return_bodies := ArrayList(AstExpr).new();
      (has_runtime_body_val : bool) = false;
      (nb_i : usize) = usize(0);
      // Sibling-arm inits must not read as prior inits inside later arms
      // (Impl reassignment rule) — group the arms' branch-init windows.
      push_branch_group();
      while(nb_i < evaluated_conds.len(), {
        match(
          evaluated_conds.get(nb_i),
          .None => {
            nb_i = evaluated_conds.len();
          },
          .Some(ec_item) => {
            nb_i = (nb_i + usize(1));
            // Skip compile-time false conditions.
            is_comptime_false := match(ec_item.cond_value,.Some(v) => match(v,.BoolVal(b) => !(b), _ => false),.None => false);
            if(!(is_comptime_false), {
              // Mark condition as executed.
              match(
                expr_info_table_get(ctx.expr_info_table, ast_expr_id(ec_item.cond_expr)),
                .None => (),
                .Some(ci) => {
                  ci.case_executed = Option(bool).Some(true);
                }
              );
              // Evaluate body with is_executing = false (analysis only).
              old_executing := ctx.is_executing;
              ctx.is_executing = false;
              begin_branch_group_arm();
              bir_start_a := branch_init_log_len();
              evaluated_case_body := evaluate_begin_expression(
                ec_item.case_body_expr,
                ec_item.case_env,
                ctx,
                ArrayList(Variable).new(),
                false,
                exn
              );
              register_arm_init_range(ast_expr_id(evaluated_case_body), bir_start_a, branch_init_log_len());
              ctx.is_executing = old_executing;
              // Consume the case body temp var to avoid phantom drops.
              body_env_for_consume := match(
                expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_case_body)),
                .Some(bi) => bi.env,
                .None => ec_item.case_env
              );
              consume_case_body_temp_var(evaluated_case_body, body_env_for_consume, ctx);
              body_einfo_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_case_body));
              body_cf2 := match(body_einfo_opt,.Some(bi) => bi.control_flow,.None => Option(ControlFlowFlags).None);
              if(has_any_control_flow(body_cf2), {
                cf_flags := match(
                  body_cf2,
                  .Some(f) => f,
                  .None => ControlFlowFlags(return_flag : false, unwind_flag : false, break_flag : false, continue_flag : false)
                );
                control_flows.push(cf_flags);
                if(has_control_flow(body_cf2,.Return), {
                  return_bodies.push(evaluated_case_body);
                });
                // Skip remaining processing for this arm.
              }, {
                has_case_without_control_flow = true;
                // Require type information.
                body_einfo := match(
                  body_einfo_opt,
                  .Some(bi) => bi,
                  .None => {
                    exn.throw(
                      dyn(
                        format_error_message(
                          ast_expr_token(evaluated_case_body),
                          `Expected type for cond statement, got ${ast_expr_to_string(evaluated_case_body)}`,
                          false,
                          .None
                        )
                      )
                    );
                    new_expr_info(ec_item.case_env, t_unit())
                  }
                );
                bodies.push(evaluated_case_body);
                // Track whether any body produced a runtime (None) value.
                if(body_einfo.value.is_none(), {
                  has_runtime_body_val = true;
                });
                // Check compatibility with the expected type.
                match(
                  ctx.expected_type,
                  .None => (),
                  .Some(et) => {
                    // For `-> inout(T)` enclosing functions the body's expected
                    // type is lowered to `*(T)` (function_type.yo
                    // `bodyExpectedType`). Cond arms that produce raw `T` (e.g.
                    // a field projection `p.x` of a ref-bound parameter) are
                    // flowable — codegen emits address-taking on the way out.
                    // Accept the raw `T` form here; the flowability rule on the
                    // return expression owns soundness. Mirrors TS cond.ts
                    // `isPtrRelaxedMatch`.
                    is_ptr_relaxed_match := cond(
                      (is_pointer_type(et.ty) && !(is_pointer_type(body_einfo.ty))) => match(
                        et.ty,
                        .Pointer(child_box) => are_types_compatible(body_einfo.ty, child_box),
                        _ => false
                      ),
                      true => false
                    );
                    if(!(is_ptr_relaxed_match) && !(are_types_compatible(body_einfo.ty, et.ty)), {
                      // Coerce the arm's comptime type to runtime and re-check
                      // (e.g. a `comptime_str` literal arm against a `str`
                      // expected return), mirroring the value-type unification
                      // fallback below. TS's areTypesCompatible accepts this
                      // directly; yo-self needs the explicit widening.
                      runtime_arm_ty := convert_comptime_type_to_runtime_type(body_einfo.ty, body_einfo.env);
                      if(!(are_types_compatible(runtime_arm_ty, et.ty)), {
                        exn.throw(
                          dyn(
                            format_error_message(
                              ast_expr_token(evaluated_case_body),
                              `Incompatible type with expected type:\n- Expected: ${type_to_string(et.ty)}\n- Actual  : ${type_to_string(body_einfo.ty)}`,
                              false,
                              .None
                            )
                          )
                        );
                      });
                    });
                  }
                );
                // Update the running value type.
                if(!(has_any_control_flow(body_cf2)), {
                  match(
                    value_type,
                    .None => {
                      value_type = Option(ValueTypeState).Some(ValueTypeState(ty : body_einfo.ty, env : body_einfo.env));
                    },
                    .Some(vt) => {
                      if(!(are_types_compatible(body_einfo.ty, vt.ty)), {
                        // Try widening the previous type to runtime and check again.
                        runtime_vt_ty := convert_comptime_type_to_runtime_type(vt.ty, vt.env);
                        if(are_types_compatible(body_einfo.ty, runtime_vt_ty), {
                          value_type = Option(ValueTypeState).Some(ValueTypeState(ty : body_einfo.ty, env : body_einfo.env));
                        }, {
                          exn.throw(
                            dyn(
                              format_error_message(
                                ast_expr_token(evaluated_case_body),
                                `Incompatible types:\n- Previous: ${type_to_string(vt.ty)}\n- Current : ${type_to_string(body_einfo.ty)}`,
                                false,
                                .None
                              )
                            )
                          );
                        });
                      });
                    }
                  );
                });
              });
            });
          }
        );
      });
      pop_branch_group();
      // Merge all control-flow flags from the arms.
      final_cf := cond(
        (control_flows.len() > usize(0)) => Option(ControlFlowFlags).Some(merge_control_flows(control_flows)),
        true => Option(ControlFlowFlags).None
      );
      if(has_case_without_control_flow || !(has_any_control_flow(final_cf)), {
        // At least one arm produces a value (no diverge).
        if(has_case_without_control_flow && value_type.is_none(), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `Failed to determine the type of value from the cond.`,
                false,
                .None
              )
            )
          );
        });
        if(value_type.is_none(), {
          value_type = Option(ValueTypeState).Some(ValueTypeState(ty : t_unit(), env : env));
        });
        vts := match(value_type,.Some(vt) => vt,.None => ValueTypeState(ty : t_unit(), env : env));
        // Merge environments from arms that don't return/unwind.
        filtered_bodies := ArrayList(AstExpr).new();
        (fb_i : usize) = usize(0);
        while(fb_i < bodies.len(), {
          body := match(bodies.get(fb_i),.Some(b) => b,.None => make_err_expr());
          body_info_filt_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(body));
          match(
            body_info_filt_opt,
            .None => (),
            .Some(bi) => {
              if(!(has_control_flow(bi.control_flow,.Return)) && !(has_control_flow(bi.control_flow,.Unwind)), {
                filtered_bodies.push(body);
              });
            }
          );
          fb_i = (fb_i + usize(1));
        });
        // Impl(...) RESULT rule: arms yielding DIFFERENT closures cannot
        // unify into one Impl value (static dispatch — TS rejects
        // `(c : Impl(Fn...)) = cond(a => closureA, b => closureB)`).
        // Per-arm result captures come from the arm bodies' ExprInfos.
        {
          (ir_first_cap : Option(TypeValue)) = Option(TypeValue).None;
          (ir_i : usize) = usize(0);
          while(ir_i < filtered_bodies.len(), {
            ir_body := match(filtered_bodies.get(ir_i),.Some(b) => b,.None => make_err_expr());
            match(
              expr_info_table_get(ctx.expr_info_table, ast_expr_id(ir_body)),
              .Some(ir_bi) => match(
                ir_bi.capture_type,
                .Some(ir_cap) => {
                  match(
                    ir_first_cap,
                    .None => {
                      ir_first_cap = Option(TypeValue).Some(ir_cap);
                    },
                    .Some(ir_fc) => {
                      ir_conflict := match(
                        ir_fc,
                        .Struct({ id : ir_fid }) => match(
                          ir_cap,
                          .Struct({ id : ir_cid }) => ((ir_fid.len() > usize(0)) && (ir_fid != ir_cid)),
                          _ => false
                        ),
                        _ => false
                      );
                      if(ir_conflict, {
                        exn.throw(
                          dyn(
                            format_error_message(
                              ast_expr_token(ir_body),
                              String.from("Branches produce different concrete closure types for an Impl(...) result. Impl(...) uses static dispatch and requires the same concrete type across branches. Consider using Dyn(...) for dynamic dispatch if different concrete types are needed."),
                              false,
                              .None
                            )
                          )
                        );
                      });
                    }
                  );
                },
                .None => ()
              ),
              .None => ()
            );
            ir_i = (ir_i + usize(1));
          });
        };
        env = merge_and_check_envs(env, filtered_bodies, ctx, exn);
        // Determine the compile-time value.
        result_val := cond(
          has_runtime_body_val => Option(EvalValue).None,
          true => Option(EvalValue).Some(create_unknown_val(vts.ty))
        );
        result_ty := cond(
          match(ctx.expected_type,.Some(et) => !(type_contains_some_type_deep(et.ty)),.None => false) =>
            match(ctx.expected_type,.Some(et) => et.ty,.None => vts.ty),
          true => vts.ty
        );
        out_info := new_expr_info(env, result_ty);
        out_info.value = result_val;
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
        attach_temp_variable_to_expr(expr, true, ctx);
        return(expr);
      }, {
        // All arms have control flow — determine what kind.
        if(control_flows.len() == usize(0), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `No control flows found but expected some.`,
                false,
                .None
              )
            )
          );
        });
        cond(
          has_control_flow(final_cf,.Return) => {
            // At least one arm returns from a function.
            if(ctx.is_evaluating_function_body_or_async_block.is_none(), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(expr),
                    `All cases in cond are returning from function, but not evaluating in function body.`,
                    false,
                    .None
                  )
                )
              );
            });
            // Determine the return type from return-bodies, the function type,
            // or the expected type (in that priority order).
            (return_type : Option(TypeValue)) = Option(TypeValue).None;
            if(return_bodies.len() > usize(0), {
              first_rb := match(return_bodies.get(usize(0)),.Some(b) => b,.None => make_err_expr());
              first_rb_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(first_rb));
              match(
                first_rb_info_opt,
                .Some(bi) => {
                  return_type = Option(TypeValue).Some(bi.ty);
                },
                .None => ()
              );
            });
            if(return_type.is_none(), {
              match(
                ctx.is_evaluating_function_body_or_async_block,
                .None => (),
                .Some(fctx) => {
                  match(
                    fctx.kind,
                    .FunctionBody => {
                      match(
                        fctx.func_type,
                        .None => (),
                        .Some(ft) => {
                          match(
                            ft,
                            .Func({ result : result_box }) => {
                              return_type = Option(TypeValue).Some(result_box);
                            },
                            _ => ()
                          );
                        }
                      );
                    },
                    _ => ()
                  );
                }
              );
            });
            if(return_type.is_none(), {
              match(
                ctx.expected_type,
                .None => (),
                .Some(et) => {
                  return_type = Option(TypeValue).Some(et.ty);
                }
              );
            });
            match(
              return_type,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(expr),
                      `Failed to determine the return type for cond statement.`,
                      false,
                      .None
                    )
                  )
                );
              },
              .Some(rt) => {
                is_fn_body := match(
                  ctx.is_evaluating_function_body_or_async_block,
                  .None => false,
                  .Some(fctx) => match(fctx.kind,.FunctionBody => true, _ => false)
                );
                is_comptime_return := cond(
                  is_fn_body => match(
                    ctx.is_evaluating_function_body_or_async_block,
                    .None => false,
                    .Some(fctx) => match(
                      fctx.func_type,
                      .None => false,
                      .Some(ft) => is_function_type_and_returns_comptime_value(ft)
                    )
                  ),
                  true => false
                );
                return_val := cond(
                  is_comptime_return => Option(EvalValue).Some(create_unknown_val(rt)),
                  true => Option(EvalValue).None
                );
                out_ret_info := new_expr_info(env, rt);
                out_ret_info.value = return_val;
                out_ret_info.control_flow = final_cf;
                expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_ret_info);
              }
            );
          },
          has_control_flow(final_cf,.Unwind) => {
            // All arms unwind from the enclosing function.
            if(ctx.enclosing_function_return_type.is_none(), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(expr),
                    `All cases in cond use "unwind", but not inside a function with an enclosing function.`,
                    false,
                    .None
                  )
                )
              );
            });
            unwind_ty := match(ctx.enclosing_function_return_type,.Some(t) => t,.None => t_unit());
            out_esc_info := new_expr_info(env, unwind_ty);
            out_esc_info.control_flow = final_cf;
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_esc_info);
          },
          has_control_flow(final_cf,.Break) => {
            // All arms break from a loop.
            if(ctx.is_evaluating_loop_body.is_none(), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(expr),
                    `All cases in cond are breaking from loop, but not inside a loop.`,
                    false,
                    .None
                  )
                )
              );
            });
            out_brk_info := new_expr_info(env, t_unit());
            out_brk_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
            out_brk_info.control_flow = final_cf;
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_brk_info);
          },
          has_control_flow(final_cf,.Continue) => {
            // All arms continue a loop.
            if(ctx.is_evaluating_loop_body.is_none(), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(expr),
                    `All cases in cond are continuing loop, but not inside a loop.`,
                    false,
                    .None
                  )
                )
              );
            });
            out_cnt_info := new_expr_info(env, t_unit());
            out_cnt_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
            out_cnt_info.control_flow = final_cf;
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_cnt_info);
          },
          // Should never be reached.
          true => ()
        );
        return(expr);
      });
    }
  );
  expr
});
export(evaluate_cond);
