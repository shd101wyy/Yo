//! evaluate_unwind — handles the `unwind(value)` builtin.
//!
//! 1:1 port of `src/evaluator/exprs/unwind.ts`.
//!
//! `unwind(value)` (or bare `unwind()`) returns from the **enclosing**
//! function with `value` (or `unit`), discarding the current continuation.
//!
//! NOTE: TS `evaluateUnwind` does NOT itself check that we are in a `given`
//! handler — that constraint is enforced at the FunctionValue-creation sites
//! (anonymous-function.ts / function-type.ts), which yo-self DOES port (the §4
//! rule-1 post-eval gate keyed on `is_control`). So this evaluator does NOT gate
//! on `ctx.is_inside_given_handler` (a former yo-self compensating control that
//! wrongly threw during definition-time body eval of plain-`:=` handlers).
open(import("std/string"));
open(import("std/fmt"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  BF_UNWIND,
  make_err_expr
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  ControlFlowKind,
  control_flow_of,
  expr_info_set_control_flow
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_i32, t_unit } :: import("../../types/creators.yo");
{ is_some_type } :: import("../../types/guards.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message, YoError } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression } :: import("./expr.yo");
evaluate_unwind :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // Validate shape: an `unwind` call (0 or 1 argument).
  if(!(ast_expr_is_fn_call_of(expr, BF_UNWIND, .None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected `unwind`."),
          false,
          .None
        )
      )
    );
  });
  // Must be inside a function with an enclosing function.
  match(
    ctx.enclosing_function_return_type,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("`unwind` can only be used inside a function that has an enclosing function."),
            false,
            .None
          )
        )
      );
    },
    .Some(_) => ()
  );
  enclosing_ret := match(
    ctx.enclosing_function_return_type,
    .Some(t) => t,
    .None => t_i32()
  );
  // `unwind` accepts at most one argument (mirrors unwind.ts:34-39).
  n_args := match(expr, .FnCall(_, _, args, _, _) => args.len(), .Atom(_, _) => usize(0));
  if(n_args > usize(1), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("`unwind` accepts at most one argument."),
          false,
          .None
        )
      )
    );
  });
  // (No `is_inside_given_handler` gate — matches TS `evaluateUnwind` (unwind.ts:20-32),
  // which only checks for an enclosing function. TS enforces "unwind is valid only in a
  // `ctl(...)` body" at the FunctionValue CREATION site, which yo-self ALSO ports: the §4
  // rule-1 post-eval gate keyed on `is_control` (anonymous_function.yo:999 /
  // function_type.yo). The old compensating gate threw during DEFINITION-TIME body eval of a
  // plain `exn := Exception(throw : (err) -> unwind(...))` handler — where
  // `is_inside_given_handler` is false (only set for `given(exn) :=`) — aborting before the
  // `unwind` expr's ExprInfo was stamped, so codegen emitted "// Failed to transpile
  // unwind(...)".)
  // No-argument form `unwind()` — type unit (mirrors unwind.ts:42-68).
  if(n_args == usize(0), {
    if(!(is_some_type(enclosing_ret)) && !(are_types_compatible(t_unit(), enclosing_ret)), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Incompatible type for \`unwind\` argument:\n- Expected (enclosing function return type): ${type_to_string(enclosing_ret)}\n- Got: ${type_to_string(t_unit())}`,
            false,
            .None
          )
        )
      );
    });
    unit_info := new_expr_info(env, t_unit());
    expr_info_set_control_flow(unit_info, .Some(control_flow_of(.Unwind)));
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), unit_info);
    return(expr);
  });
  // Pull arg out of the FnCall.
  arg_expr := match(
    expr,
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => make_err_expr()
    ),
    .Atom(_, _) => make_err_expr()
  );
  // Recursively evaluate the argument with the enclosing return type as the
  // expected type (mirrors unwind.ts:70-80).
  saved_expected := ctx.expected_type;
  ctx.expected_type = .Some(ExpectedTypeCtx(ty : enclosing_ret, env : env));
  evaluated := evaluate_expression(arg_expr, env, ctx);
  ctx.expected_type = saved_expected;
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  match(
    info_opt,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate the argument of `unwind`."),
            false,
            .None
          )
        )
      );
    },
    .Some(_) => ()
  );
  arg_info := match(
    info_opt,
    .Some(i) => i,
    .None => new_expr_info(env, t_i32())
  );
  // Type-check (skip when enclosing_ret is a SomeType, mirrors TS).
  if(!(is_some_type(enclosing_ret)) && !(are_types_compatible(arg_info.ty, enclosing_ret)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `Incompatible type for \`unwind\` argument:\n- Expected (enclosing function return type): ${type_to_string(enclosing_ret)}\n- Got: ${type_to_string(arg_info.ty)}`,
          false,
          .None
        )
      )
    );
  });
  // Emit ExprInfo: type = arg type, value = .None, control_flow = unwind.
  out_info := new_expr_info(env, arg_info.ty);
  expr_info_set_control_flow(out_info, .Some(control_flow_of(.Unwind)));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_unwind);
