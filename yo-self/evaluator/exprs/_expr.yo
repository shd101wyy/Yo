  BF_COMPTIME_BOOL_NOT,
  BF_COMPTIME_BOOL_TO_COMPTIME_STRING,
  BF_COMPTIME_STRING_CONCAT,
  BF_COMPTIME_STRING_EQ,
  BF_COMPTIME_STRING_NEQ,
  BF_COMPTIME_STRING_LT,
  BF_COMPTIME_STRING_LTE,
  BF_COMPTIME_STRING_GT,
  BF_COMPTIME_STRING_GTE,
  BF_COMPTIME_STRING_LENGTH,
  BF_COMPTIME_STRING_TO_UPPER,
