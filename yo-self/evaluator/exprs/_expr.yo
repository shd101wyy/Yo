        ast_expr_is_fn_call_of(expr, BK_TUPLE_TYPE,.None) =>
          evaluate_tuple_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_ARRAY,.None) =>
          evaluate_array_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_ARRAY_FILL,.Some(usize(2))) =>
          evaluate_yo_array_fill(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_COMPTIME_LIST_TYPE,.None) =>
          evaluate_comptime_list_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_FUTURE,.None) =>
          evaluate_future_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_CONCRETE,.None) =>
          evaluate_concrete_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_DYN_UPPER,.None) =>
          evaluate_dyn_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_COMPTIME_EXPECT_ERROR,.None) =>
          evaluate_comptime_expect_error(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_COMPTIME_ASSERT,.None) =>
          evaluate_comptime_assert(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_COMPTIME_FN,.None) =>
          evaluate_comptime_fn(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_COMPTIME_PRINT,.None) =>
          evaluate_comptime_print(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_PANIC,.None) =>
          evaluate_panic(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_ASM,.None) =>
          evaluate_asm(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_GLOBAL_ASM,.None) =>
          evaluate_global_asm(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_MACRO_EXPAND,.None) =>
          evaluate_macro_expand(expr, env, ctx, exn),
        (
          ast_expr_is_fn_call_of(expr, BK_OP_AND,.None) ||
            ast_expr_is_fn_call_of(expr, BK_OP_OR,.None)
        ) =>
          evaluate_and_or(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_UNWIND,.None) =>
          evaluate_unwind(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_CONSUME,.None) =>
          evaluate_consume(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_DROP,.None) =>
          evaluate_drop(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_DUP,.None) =>
          evaluate_dup(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_DECR_RC,.None) =>
          evaluate_yo_decr_rc(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_INCR_RC,.None) =>
          evaluate_yo_incr_rc(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_DECR_RC_ATOMIC,.None) =>
          evaluate_yo_decr_rc_atomic(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_INCR_RC_ATOMIC,.None) =>
          evaluate_yo_incr_rc_atomic(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_ISO_EXTRACT,.None) =>
          evaluate_yo_iso_extract(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_ISO_DISPOSE,.None) =>
          evaluate_yo_iso_dispose(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_DROP_ARRAY_ELEMENT,.None) =>
          evaluate_yo_drop_array_element(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_DUP_ARRAY_ELEMENT,.None) =>
          evaluate_yo_dup_array_element(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_DROP_TUPLE_ELEMENT,.None) =>
          evaluate_yo_drop_tuple_element(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_DUP_TUPLE_ELEMENT,.None) =>
          evaluate_yo_dup_tuple_element(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_RC_OWN,.None) =>
          evaluate_yo_rc_own(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_DYN_DROP,.None) =>
          evaluate_yo_dyn_vtable_drop(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_DYN_DUP,.None) =>
          evaluate_yo_dyn_vtable_dup(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_SOMETYPE_DROP,.None) =>
          evaluate_yo_some_type_drop(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_SOMETYPE_DUP,.None) =>
          evaluate_yo_some_type_dup(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_GC_COLLECT,.None) =>
          evaluate_yo_gc_collect(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_QUOTE,.None) =>
          evaluate_quote(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_GENSYM,.None) =>
          evaluate_gensym(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_EXPR_IS_ATOM,.None) =>
          evaluate_yo_expr_is_atom(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_EXPR_IS_FN_CALL,.None) =>
          evaluate_yo_expr_is_fn_call(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_EXPR_GET_CALLEE,.None) =>
          evaluate_yo_expr_get_callee(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_EXPR_GET_ARGS,.None) =>
          evaluate_yo_expr_get_args(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_EXPR_TO_STRING,.None) =>
          evaluate_yo_expr_to_string(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_EXPR_EQ,.None) =>
          evaluate_yo_expr_eq(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_CAR,.None) =>
          evaluate_yo_comptime_list_car(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_CDR,.None) =>
          evaluate_yo_comptime_list_cdr(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_CONS,.None) =>
          evaluate_yo_comptime_list_cons(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_APPEND,.None) =>
          evaluate_yo_comptime_list_append(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_LENGTH,.None) =>
          evaluate_yo_comptime_list_length(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_ELEMENT_TYPE,.None) =>
          evaluate_yo_comptime_list_element_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_GET,.None) =>
          evaluate_yo_comptime_list_get(expr, env, ctx, exn),
        is_comptime_numeric_fn_call(expr) =>
          evaluate_yo_comptime_numeric_functions(expr, env, ctx, exn),
        (
          ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_AND,.Some(usize(2))) ||
            ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_OR,.Some(usize(2))) ||
              ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_EQ,.Some(usize(2))) ||
                ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_NEQ,.Some(usize(2))) ||
                  ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_NOT,.Some(usize(1))) ||
                    ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_TO_COMPTIME_STRING,.Some(usize(1)))
        ) =>
          evaluate_yo_comptime_boolean_functions(expr, env, ctx, exn),
        (
          ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_CONCAT,.Some(usize(2))) ||
            ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_EQ,.Some(usize(2))) ||
              ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_NEQ,.Some(usize(2))) ||
                ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_LT,.Some(usize(2))) ||
                  ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_LTE,.Some(usize(2))) ||
                    ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_GT,.Some(usize(2))) ||
                      ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_GTE,.Some(usize(2))) ||
                        ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_LENGTH,.Some(usize(1))) ||
                          ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_TO_UPPER,.Some(usize(1))) ||
                            ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_TO_LOWER,.Some(usize(1))) ||
                              ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_SLICE,.None)
        ) =>
          evaluate_yo_comptime_string_functions(expr, env, ctx, exn),
        (
          ast_expr_is_fn_call_of(expr, BF_COMPTIME_ARRAY_INDEX,.None) ||
            ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_INDEX,.None) ||
              ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_INDEX_RANGE,.None) ||
                ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_INDEX_RANGE_INCLUSIVE,.None) ||
                  ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_INDEX,.None) ||
                    ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_INDEX_RANGE,.None) ||
                      ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_INDEX_RANGE_INCLUSIVE,.None)
        ) =>
          evaluate_yo_comptime_index_functions(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_TYPE_TO_COMPTIME_STRING,.Some(usize(1))) =>
          evaluate_yo_type_to_string(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_ARE_TYPES_COMPATIBLE,.Some(usize(2))) =>
          evaluate_yo_are_types_compatible(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_ARE_TYPES_EQUAL,.Some(usize(2))) =>
          evaluate_yo_are_types_equal(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_TYPE_CONTAINS_RC_TYPE,.Some(usize(1))) =>
          evaluate_yo_type_contains_rc_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_TYPE_CAN_FORM_RC_CYCLE,.Some(usize(1))) =>
          evaluate_yo_type_can_form_rc_cycle(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_TYPE_IMPLS,.Some(usize(2))) =>
          evaluate_yo_type_impls(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_TYPE_GET_INFO,.Some(usize(1))) =>
          evaluate_yo_type_get_info(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_COMPTIME_EVAL,.Some(usize(1))) =>
          evaluate_comptime_eval(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_STRING_TO_EXPR,.Some(usize(1))) =>
          evaluate_comptime_string_to_expr(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_TYPE_JOIN_FIELDS,.Some(usize(3))) =>
          evaluate_type_join_fields(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_TYPE_MAP_VARIANTS,.Some(usize(2))) =>
          evaluate_type_map_variants(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_DERIVE_RULE,.Some(usize(2))) =>
          evaluate_derive_rule(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_DERIVE,.None) =>
          evaluate_derive(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_VAR_PRINT_INFO,.Some(usize(1))) =>
          evaluate_yo_var_print_info(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_VAR_IS_OWNING_RC,.None) =>
          evaluate_yo_var_is_owning_the_rc_value(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_YO_VAR_HAS_OTHER_ALIASES,.None) =>
          evaluate_yo_var_has_other_aliases(expr, env, ctx, exn),
        (
          ast_expr_is_fn_call_of(expr, BF_YO_PROCESS_PLATFORM,.None) ||
            ast_expr_is_fn_call_of(expr, BF_YO_PROCESS_ARCH,.None) ||
              ast_expr_is_fn_call_of(expr, BF_YO_POINTER_SIZE_BITS,.None)
        ) =>
          evaluate_yo_process_functions(expr, env, ctx, exn),
        (
          ast_expr_is_fn_call_of(expr, BF_YO_BUILD_EXECUTABLE,.None) ||
            ast_expr_is_fn_call_of(expr, BF_YO_BUILD_STATIC_LIBRARY,.None) ||
              ast_expr_is_fn_call_of(expr, BF_YO_BUILD_SHARED_LIBRARY,.None) ||
                ast_expr_is_fn_call_of(expr, BF_YO_BUILD_TEST,.None) ||
                  ast_expr_is_fn_call_of(expr, BF_YO_BUILD_RUN,.None) ||
                    ast_expr_is_fn_call_of(expr, BF_YO_BUILD_STEP,.None) ||
                      ast_expr_is_fn_call_of(expr, BF_YO_BUILD_STEP_DEPEND_ON,.None) ||
                        ast_expr_is_fn_call_of(expr, BF_YO_BUILD_TARGET_HOST,.None) ||
                          ast_expr_is_fn_call_of(expr, BF_YO_BUILD_TARGET_PARSE,.None) ||
                            ast_expr_is_fn_call_of(expr, BF_YO_BUILD_DEPENDENCY,.None) ||
                              ast_expr_is_fn_call_of(expr, BF_YO_BUILD_PATH_DEPENDENCY,.None) ||
                                ast_expr_is_fn_call_of(expr, BF_YO_BUILD_SYSTEM_LIBRARY,.None) ||
                                  ast_expr_is_fn_call_of(expr, BF_YO_BUILD_LINK,.None) ||
                                    ast_expr_is_fn_call_of(expr, BF_YO_BUILD_LINK_SYSTEM_LIBRARY,.None) ||
                                      ast_expr_is_fn_call_of(expr, BF_YO_BUILD_OPTION,.None) ||
                                        ast_expr_is_fn_call_of(expr, BF_YO_BUILD_DEP_ARTIFACT,.None) ||
                                          ast_expr_is_fn_call_of(expr, BF_YO_BUILD_MODULE,.None) ||
                                            ast_expr_is_fn_call_of(expr, BF_YO_BUILD_MODULE_LINK,.None) ||
                                              ast_expr_is_fn_call_of(expr, BF_YO_BUILD_ADD_IMPORT,.None) ||
                                                ast_expr_is_fn_call_of(expr, BF_YO_BUILD_ADD_CFLAGS,.None) ||
                                                  ast_expr_is_fn_call_of(expr, BF_YO_BUILD_DEP_MODULE,.None) ||
                                                    ast_expr_is_fn_call_of(expr, BF_YO_BUILD_DOC,.None)
        ) => {
          // Pre-evaluate args before dispatching — the build builtins read
          // each arg's resolved comptime value from the expr-info table.
          // Mirrors the for-loop before `evaluateYoBuildFunctions` in TS
          // `_expr.ts`. Mutating the args ArrayList in place updates
          // `expr.args` (FnCall holds it by reference).
          build_call_args := match(
            expr,
            .FnCall(_, _, a, _, _) => a,
            .Atom(_, _) => ArrayList(AstExpr).new()
          );
          (bca_i : usize) = usize(0);
          while(bca_i < build_call_args.len(), {
            match(
              build_call_args.get(bca_i),
              .Some(ba) => {
                build_call_args(bca_i) = recur(ba, env, ctx, exn);
              },
              .None => ()
            );
            bca_i = (bca_i + usize(1));
          });
          evaluate_yo_build_functions(expr, env, ctx, exn)
        },
        ast_expr_is_fn_call_of(expr, BK_WHILE,.None) =>
          evaluate_while(expr, env, ctx, usize(0), exn),
        ast_expr_is_fn_call_of(expr, BF_VA_START,.None) =>
          evaluate_va_start(expr, env, ctx, exn),
        true =>
          evaluate_function_call(expr, env, t_unit(), Option(EvalValue).None, ctx, exn)
      )
  )
);
/// Non-capturing wrapper that creates a local exception handler.
///
/// When the underlying `_evaluate_expression` throws, the previous
/// implementation called `panic("evaluate_expression: unexpected
/// error")` — that aborted the process with `SIGABRT` and discarded
/// the actual error message, making evaluator coverage gaps look
/// like opaque crashes (especially through `yo-self-bin check`).
/// We now print the caught error's `to_string()` output to stderr
/// before aborting, so the user sees the real diagnostic without
/// extra tooling.
///
/// (Callers that want graceful recovery instead of an abort can
/// use `_evaluate_expression_raw_wrapper`, which propagates the
/// exception through to the caller's `exn`. `try_populate_expr_info_table`
/// in `yo-self/main.yo` and the new `run_check` subcommand both
/// go through that path so they can surface or swallow errors as
/// appropriate.)
/// Codegen-metadata bridge: yo-self's evaluator records ExprInfo PIECEMEAL (each
/// sub-evaluator sets it for the node IT handles, often the evaluated/result node,
/// not the original sub-expression). Codegen, however, walks the ORIGINAL function
/// body AST (stored on the FuncVal) and looks up ExprInfo by the original node's
/// id — so a call/operator child of a recorded binding (`_y := double(1)`) had no
/// entry → "Failed to transpile". This central bridge fills a MISSING original-id
/// entry from the (correct) result-node entry produced by evaluating it. It is
/// the yo-self analogue of TS attaching `expr.$` to every node.
///
/// GUARDED for safety (prior unguarded ExprInfo changes regressed std/tests):
/// only acts when the ids DIFFER, only FILLS a missing original entry, and NEVER
/// overwrites an existing one — so worst case it is a no-op.
_bridge_expr_info :: (fn(orig : AstExpr, result : AstExpr, ctx : EvalContext) -> unit)({
  oid := ast_expr_id(orig);
  rid := ast_expr_id(result);
  if(!(oid == rid), {
    match(
      expr_info_table_get(ctx.expr_info_table, oid),
      .Some(_) => (),
      .None => match(
        expr_info_table_get(ctx.expr_info_table, rid),
        .Some(rinfo) => {
          expr_info_table_set(ctx.expr_info_table, oid, rinfo);
        },
        .None => ()
      )
    );
  });
});
_evaluate_expression_wrapper :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  exn := Exception(
    throw : (
      (err) -> {
        // During check, don't abort — let the caller handle the error.
        // Abort only in non-check contexts (the raw evaluator path
        // provides its own exn handler). The error is swallowed here;
        // callers that need the diagnostic print it themselves.
        unwind(make_err_expr());
      }
    )
  );
  result := _evaluate_expression(expr, env, ctx, exn);
  _bridge_expr_info(expr, result, ctx);
  result
});
/// Concrete-signature wrapper for set_evaluate_expression_raw_fn.
///
/// Forwards the caller's exception handler directly to the underlying
/// `_evaluate_expression`. This is what lets `try_populate_expr_info_table`
/// in `yo-self/main.yo` install a `.None`-escape handler and gracefully
/// fall back when the proper evaluator hits coverage gaps (Stream A in
/// `plans/BOOTSTRAPPING.md`).
///
/// The previous bootstrap stub delegated to `_evaluate_expression_wrapper`
/// (which installs its own panic handler), with a comment claiming the
/// codegen could not handle a runtime `void*` throw function pointer.
/// Phase 3 verified that the codegen does in fact handle this — the
/// previous panic was masking real evaluator coverage gaps as crashes
/// instead of recoverable errors.
_evaluate_expression_raw_wrapper :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  result := _evaluate_expression(expr, env, ctx, exn);
  _bridge_expr_info(expr, result, ctx);
  result
});
/// Register the expression evaluator. Call once during evaluator initialization.
register_evaluate_expression :: (fn() -> unit)({
  set_evaluate_expression_fn(_evaluate_expression_wrapper);
  set_evaluate_expression_raw_fn(_evaluate_expression_raw_wrapper);
  ()
});
export(_evaluate_expression, _evaluate_expression_wrapper, _evaluate_expression_raw_wrapper, register_evaluate_expression);
