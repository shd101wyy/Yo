/// Get the first argument of a FnCall expression. Returns make_err_expr() if not available.
ast_expr_get_arg0 :: (fn(e : AstExpr) -> AstExpr)(
  match(
    e,
    .Atom(_, _) => make_err_expr(),
    .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr())
  )
);
/// True if `e` is a FnCall whose function name starts with a comptime numeric prefix.
/// Mirrors the `__yo_comptime_*` prefix check in `_expr.ts`.
is_comptime_numeric_fn_call :: (fn(e : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, func_box, _, _, _) => match(
      func_box.*,
      .Atom(_, ftok) => {
        v := ftok.value;
        (v.starts_with(`__yo_comptime_u8_`)) ||
          (v.starts_with(`__yo_comptime_i8_`)) ||
            (v.starts_with(`__yo_comptime_u16_`)) ||
              (v.starts_with(`__yo_comptime_i16_`)) ||
                (v.starts_with(`__yo_comptime_u32_`)) ||
                  (v.starts_with(`__yo_comptime_i32_`)) ||
                    (v.starts_with(`__yo_comptime_u64_`)) ||
                      (v.starts_with(`__yo_comptime_i64_`)) ||
                        (v.starts_with(`__yo_comptime_usize_`)) ||
                          (v.starts_with(`__yo_comptime_isize_`)) ||
                            (v.starts_with(`__yo_comptime_f32_`)) ||
                              (v.starts_with(`__yo_comptime_f64_`)) ||
                                (v.starts_with(`__yo_comptime_int_`)) ||
                                  (v.starts_with(`__yo_comptime_float_`))
                                },
      .FnCall(_, _, _, _, _) => false
    )
  )
);
_evaluate_expression :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)(
  cond(
    ast_expr_is_atom(expr) => {
      tok := ast_expr_token(expr);
      cond(
        ((tok.kind == TokenKind.Identifier) || (tok.kind == TokenKind.Operator)) =>
          evaluate_identifier_and_operator(expr, env, ctx, true, exn),
        (tok.kind == TokenKind.Integer) =>
          evaluate_integer_literal(expr, env, ctx, exn),
        (tok.kind == TokenKind.Float) =>
          evaluate_float_literal(expr, env, ctx, exn),
        (tok.kind == TokenKind.StringLit) =>
          evaluate_string_literal(expr, env, ctx, exn),
        (tok.kind == TokenKind.CharLit) =>
          evaluate_char_literal(expr, env, ctx, exn),
        (tok.kind == TokenKind.Bool) =>
          evaluate_boolean_literal(expr, env, ctx, exn),
        true => {
          exn.throw(
            dyn(
              format_error_message(
                tok,
                `(1) Evaluating the expression (token: ${tok.value}) is not implemented:\n${ast_expr_to_string(expr)}`,
                false,
                .None
              )
            )
          );
          make_err_expr()
        }
      )
    },
    true =>
      cond(
        ast_expr_is_fn_call_of(expr, BK_COLON,.Some(usize(2))) => {
          result := evaluate_binding(expr, env, ctx, exn);
          result.expr
        },
        (
          ast_expr_is_fn_call_of(expr, BK_INIT_ASSIGN,.Some(usize(2))) ||
            ast_expr_is_fn_call_of(expr, BK_CONST,.Some(usize(2)))
        ) =>
          evaluate_initialization_assignment(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_ASSIGN,.Some(usize(2))) =>
          evaluate_assignment(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, "->",.Some(usize(2))) => {
          arg0 := ast_expr_get_arg0(expr);
          cond(
            (
              ast_expr_is_fn_call(arg0) &&
                (
                  ast_expr_is_fn_call_of(arg0, BK_FN,.None) ||
                    (
                      ast_expr_is_fn_call_of(arg0, BK_UNSAFE_FN,.None) ||
                        ast_expr_is_fn_call_of(arg0, BK_CTL,.None)
                    )
                )
            ) => {
              is_unsafe := ast_expr_is_fn_call_of(arg0, BK_UNSAFE_FN,.None);
              is_control := ast_expr_is_fn_call_of(arg0, BK_CTL,.None);
              old_is_unsafe := ctx.is_unsafe_function_type;
              old_is_control := ctx.is_control_function_type;
              ctx.is_unsafe_function_type = is_unsafe;
              ctx.is_control_function_type = is_control;
              result := evaluate_function_type(expr, env, ctx, exn);
              ctx.is_unsafe_function_type = old_is_unsafe;
              ctx.is_control_function_type = old_is_control;
              result
            },
            (
              ast_expr_is_fn_call(arg0) &&
                ast_expr_is_fn_call_of(arg0, BK_FN_TRAIT,.None)
            ) =>
              evaluate_fn_trait_type(expr, env, ctx, exn),
            true =>
              evaluate_anonymous_function_implementation(expr, env, ctx, exn)
          )
        },
        ast_expr_is_fn_call_of(expr, "=>",.Some(usize(2))) => {
          arg0 := ast_expr_get_arg0(expr);
          cond(
            (
              ast_expr_is_fn_call(arg0) &&
                ast_expr_is_fn_call_of(arg0, BK_FN,.None)
            ) =>
              evaluate_closure_type(expr, env, ctx, exn),
            true =>
              evaluate_anonymous_function_implementation(expr, env, ctx, exn)
          )
        },
        ast_expr_is_fn_call_of(expr, "=>>",.Some(usize(2))) =>
          evaluate_anonymous_function_implementation(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_RECUR,.None) =>
          evaluate_recur(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_RUNTIME,.None) =>
          evaluate_runtime(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_EXTERN,.None) =>
          evaluate_extern(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_C_INCLUDE,.None) =>
          evaluate_c_include(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_TEST,.None) =>
          evaluate_test(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_COND,.None) =>
          evaluate_cond(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_MATCH,.None) =>
          evaluate_match(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_TUPLE,.None) =>
          evaluate_tuple_value(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_ANON_STRUCT,.None) =>
          evaluate_anonymous_struct_value(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_ARRAY_VAL,.None) =>
          evaluate_array_value(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_COMPTIME_LIST_VAL,.None) =>
          evaluate_comptime_list_value(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_DYN_LOWER,.None) =>
          evaluate_dyn_value(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_ATOMIC,.None) => {
          n_args := match(
            expr,
            .Atom(_, _) => usize(0),
            .FnCall(_, _, args, _, _) => args.len()
          );
          cond(
            (n_args != usize(1)) => {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(expr),
                    `"atomic" expects exactly one argument: atomic object(...)`,
                    false,
                    .None
                  )
                )
              );
              make_err_expr()
            },
            true => {
              inner_expr := match(
                expr,
                .Atom(_, _) => make_err_expr(),
                .FnCall(_, _, args, _, _) =>
                  match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr())
              );
              cond(
                ast_expr_is_fn_call_of(inner_expr, BK_REF,.None) => {
                  // atomic(ref(struct(...))) — canonical reference-semantics form.
                  ref_inner := match(
                    inner_expr,
                    .Atom(_, _) => make_err_expr(),
                    .FnCall(_, _, rargs, _, _) =>
                      match(rargs.get(usize(0)),.Some(a) => a,.None => make_err_expr())
                  );
                  cond(
                    ast_expr_is_fn_call_of(ref_inner, BK_STRUCT,.None) =>
                      evaluate_struct_type(ref_inner, env, ctx, true, true, exn),
                    ast_expr_is_fn_call_of(ref_inner, BK_ENUM,.None) =>
                      evaluate_enum_type(ref_inner, env, ctx, true, true, exn),
                    true => {
                      exn.throw(
                        dyn(
                          format_error_message(
                            ast_expr_token(ref_inner),
                            `"atomic(ref(...))" wraps an inline "struct(...)" or "enum(...)" literal. Got:\n${ast_expr_to_string(ref_inner)}`,
                            false,
                            .None
                          )
                        )
                      );
                      make_err_expr()
                    }
                  )
                },
                true => {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(inner_expr),
                        `"atomic" modifier is only valid before "ref(struct(...))". Got:\n${ast_expr_to_string(inner_expr)}`,
                        false,
                        .None
                      )
                    )
                  );
                  make_err_expr()
                }
              )
            }
          )
        },
        ast_expr_is_fn_call_of(expr, BK_REF,.None) => {
          // ref(struct(...)) / ref(enum(...)) — reference-semantics type
          // constructor. Wraps an inline struct/enum literal only.
          n_ref_args := match(
            expr,
            .Atom(_, _) => usize(0),
            .FnCall(_, _, args, _, _) => args.len()
          );
          cond(
            (n_ref_args != usize(1)) => {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(expr),
                    `"ref" expects exactly one argument: ref(struct(...))`,
                    false,
                    .None
                  )
                )
              );
              make_err_expr()
            },
            true => {
              ref_inner := match(
                expr,
                .Atom(_, _) => make_err_expr(),
                .FnCall(_, _, args, _, _) =>
                  match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr())
              );
              cond(
                ast_expr_is_fn_call_of(ref_inner, BK_STRUCT,.None) =>
                  evaluate_struct_type(ref_inner, env, ctx, false, true, exn),
                ast_expr_is_fn_call_of(ref_inner, BK_ENUM,.None) =>
                  evaluate_enum_type(ref_inner, env, ctx, false, true, exn),
                true => {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(ref_inner),
                        `"ref(...)" wraps an inline "struct(...)" or "enum(...)" literal. Got:\n${ast_expr_to_string(ref_inner)}`,
                        false,
                        .None
                      )
                    )
                  );
                  make_err_expr()
                }
              )
            }
          )
        },
        ast_expr_is_fn_call_of(expr, BK_STRUCT,.None) =>
          evaluate_struct_type(expr, env, ctx, false, false, exn),
        ast_expr_is_fn_call_of(expr, BK_NEWTYPE,.None) =>
          evaluate_newtype_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_ENUM,.None) =>
          evaluate_enum_type(expr, env, ctx, false, false, exn),
        ast_expr_is_fn_call_of(expr, BK_UNION,.None) =>
          evaluate_union_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_DOT,.None) =>
          evaluate_property_access(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_BEGIN,.None) =>
          evaluate_begin_expression(expr, env, ctx, ArrayList(Variable).new(), false, exn),
        ast_expr_is_fn_call_of(expr, BK_MODULE,.None) =>
          evaluate_module_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_TRAIT,.None) =>
          evaluate_trait_type(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_IMPL_UPPER,.None) =>
          evaluate_impl_constraint(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_IMPL_LOWER,.None) =>
          evaluate_module_value(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_TYPEOF,.None) =>
          evaluate_typeof(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_SIZEOF,.None) =>
          evaluate_size_of(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_UNSAFE,.None) =>
          evaluate_unsafe(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_PRAGMA,.None) =>
          evaluate_pragma(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_REQUIRES,.None) =>
          evaluate_requires(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_ENSURES,.None) =>
          evaluate_ensures(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_INVARIANT,.None) =>
          evaluate_invariant(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_GHOST,.None) =>
          evaluate_ghost(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_GHOST_FN,.None) =>
          evaluate_ghost_fn(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_OLD,.None) =>
          evaluate_old(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_ALIGNOF,.None) =>
          evaluate_align_of(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_TYPEID,.None) =>
          evaluate_type_id(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_DOWNCAST,.None) =>
          evaluate_downcast(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_RC,.None) =>
          evaluate_rc(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_SUBTYPE_OF,.None) =>
          evaluate_subtype_of(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BF_THE,.None) =>
          evaluate_the(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_IMPORT,.None) =>
          evaluate_import(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_OPEN,.None) =>
          evaluate_open(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_PTR,.Some(usize(1))) =>
          evaluate_raw_pointer_call(expr, env, ctx, exn),
        ast_expr_is_fn_call_of(expr, BK_ISO,.Some(usize(1))) =>
