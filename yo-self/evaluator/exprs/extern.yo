//! evaluate_extern — handles `extern "yo" { ... }` and `extern "c" { ... }`.
//!
//! 1:1 port of `src/evaluator/exprs/extern.ts` (201 lines).
//!
//! Phase 2av: fully ported — calls `evaluate_module_field` and adds fields to
//! the environment.  The `is_extern`/`externName` markers ARE ported (onto the
//! `Func` variant): the extern-call `unsafe(...)` gate in `calls/function.yo`
//! reads them to require FFI call sites be wrapped in `unsafe(...)`
//! (plans/EXTERN_UNSAFE_WRAP.md). The earlier port dropped them as
//! "codegen-only" — wrong, the gate lives in the evaluator. Only `ioBuiltin`
//! (a pure codegen concern) stays skipped.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BK_EXTERN
} :: import("../../expr.yo");
{ new_expr_info, expr_info_table_set, expr_info_table_get } :: import("../../expr_info.yo");
{ Environment, add_variable_to_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_unknown_val_with_name } :: import("../../value.yo");
{ TypeValue, FuncMeta } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ is_type_hierarchy_type, register_extern_type_name } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ evaluate_expression } :: import("./expr.yo");
{ EvalModuleFieldResult, evaluate_module_field } :: import("../types/record.yo");
{ ArrayList } :: import("std/collections/array_list");
evaluate_extern :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  if(!(ast_expr_is_fn_call_of(expr, BK_EXTERN,.None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected extern, got ${ast_expr_token(expr).value}`,
          false,
          .None
        )
      )
    );
  });
  // Phase C privilege gate: extern fn declarations are FFI; they bind
  // names to symbols outside the type system's reach. Only files with
  // `pragma(Pragma.AllowUnsafe);` can declare them. User code calls
  // stdlib wrappers instead. Mirrors `extern.ts:46-66`.
  if(!(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(expr).module_path.clone()))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `'extern(...)' is not available in safe code.

FFI declarations bind names to symbols outside Yo's type-checking
reach. To use them, declare at the top of this file:

    pragma(Pragma.AllowUnsafe);

User code should normally call stdlib wrappers (e.g. functions in
'std/sys', 'std/fs') instead of declaring FFI directly.`,
          false,
          .None
        )
      )
    );
  });
  (env : Environment) = env_in;
  all_args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  // If the first arg is an atom (string literal), treat it as the language tag.
  // Otherwise default to "yo".
  (language : String) = String.from("yo");
  (field_start : usize) = usize(0);
  first_arg_opt := all_args.get(usize(0));
  (has_lang_arg : bool) = match(first_arg_opt,.Some(a) => ast_expr_is_atom(a),.None => false);
  if(has_lang_arg, {
    lang_arg := match(first_arg_opt,.Some(a) => a,.None => expr);
    evaluated_lang := evaluate_expression(lang_arg, env, ctx);
    lang_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_lang));
    lang_info := match(lang_info_opt,.Some(i) => i,.None => new_expr_info(env, t_unit()));
    env.frames = lang_info.env.frames;
    env.module_path = lang_info.env.module_path;
    env.function_declaration_frame_level = lang_info.env.function_declaration_frame_level;
    env.input_string = lang_info.env.input_string;
    raw_lang := match(
      lang_info.value,
      .Some(v) => match(
        v,
        .StrLit(s) => s,
        _ => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(lang_arg),
                `Expected string for language argument`,
                false,
                .None
              )
            )
          );
          String.new()
        }
      ),
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(lang_arg),
              `Failed to evaluate language argument`,
              false,
              .None
            )
          )
        );
        String.new()
      }
    );
    // Strip surrounding quotes.
    rn := raw_lang.len();
    lang_stripped := if(
      rn >= usize(2),
      raw_lang.substring(usize(1), rn - usize(1)),
      raw_lang.clone()
    );
    // Validate: must be "yo" or "c" (case-insensitive).
    lang_lower := lang_stripped.to_lowercase();
    if(lang_lower == "yo", {
      language = String.from("yo");
    });
    if(lang_lower == "c", {
      language = String.from("c");
    });
    if(!((lang_lower == "yo") || (lang_lower == "c")), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lang_arg),
            `Unsupported language "${lang_lower}" for extern, expected "c" or "yo"`,
            false,
            .None
          )
        )
      );
    });
    field_start = usize(1);
  });
  // `language` is stamped onto each function field type below (is_extern),
  // so the extern-call `unsafe(...)` gate can identify FFI call sites.
  // Iterate over the field declarations.
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  (args_idx : usize) = field_start;
  (field_idx : usize) = usize(0);
  while(args_idx < all_args.len(), {
    arg := match(all_args.get(args_idx),.Some(a) => a,.None => expr);
    result := evaluate_module_field(arg, field_idx, env, ctx, false, exn);
    // Check for duplicate labels.
    (dup_idx : usize) = usize(0);
    (has_dup : bool) = false;
    while((dup_idx < field_labels.len()) && !(has_dup), {
      existing := match(field_labels.get(dup_idx),.Some(l) => l,.None => String.from(""));
      if(existing == result.label, {
        has_dup = true;
      });
      dup_idx = (dup_idx + usize(1));
    });
    if(has_dup, {
      err_tok := if(
        ast_expr_is_fn_call(arg),
        match(
          match(arg,.FnCall(_, _, a2, _, _) => a2, _ => ArrayList(AstExpr).new()).get(usize(0)),
          .Some(fe) => ast_expr_token(fe),
          .None => ast_expr_token(arg)
        ),
        ast_expr_token(arg)
      );
      exn.throw(
        dyn(
          format_error_message(
            err_tok,
            `Duplicate label "${result.label}" in module`,
            false,
            .None
          )
        )
      );
    });
    // Stamp the FFI language tag + symbol name onto function field types so
    // the extern-call `unsafe(...)` gate (calls/function.yo) can identify
    // calls to this symbol. Mirrors `extern.ts:138-161` (the
    // `isFunctionType(field.type)` branch sets both `isExtern` and
    // `externName`). Non-`Func` field types (e.g. `__yo_argc : i32`) carry no
    // `is_extern` slot in yo-self's `TypeValue` and are never called, so the
    // gate does not need them. `ioBuiltin` is codegen-only and stays skipped.
    field_ty_with_extern := match(
      result.field_type,
      .Func({
        forall_types : fts,
        param_types : pts,
        implicit_types : its,
        where_types : wts,
        result : ret,
        meta : m
      }) => TypeValue.Func(
        fts,
        pts,
        its,
        wts,
        ret,
        box(
          FuncMeta(
            forall_labels : m.*.forall_labels.clone(),
            param_labels : m.*.param_labels.clone(),
            implicit_labels : m.*.implicit_labels.clone(),
            implicit_spreads : m.*.implicit_spreads.clone(),
            result_is_comptime_only : m.*.result_is_comptime_only,
            param_is_ref : m.*.param_is_ref.clone(),
            param_is_owning : m.*.param_is_owning.clone(),
            result_is_ref : m.*.result_is_ref,
            has_variadic : m.*.has_variadic,
            is_extern : Option(String).Some(language.clone()),
            extern_name : Option(String).Some(result.label.clone()),
            is_control : m.*.is_control,
            variadic_label : Option(String).None,
            variadic_comptime : false
          )
        ),
        ArrayList(TypeValue).new()
      ),
      _ => result.field_type
    );
    field_labels.push(result.label.clone());
    field_types.push(field_ty_with_extern);
    env.frames = result.env.frames;
    env.module_path = result.env.module_path;
    env.function_declaration_frame_level = result.env.function_declaration_frame_level;
    env.input_string = result.env.input_string;
    // Add field variable to env (compile-time only, unknown value placeholder).
    _var_opt := add_variable_to_env(
      env,
      result.label.clone(),
      field_ty_with_extern,
      Option(EvalValue).Some(create_unknown_val_with_name(field_ty_with_extern, result.label.clone())),
      true,
      // is_compile_time_only
      false,
      // is_reassignable
      type_contains_rc_type(field_ty_with_extern),
      // is_owning_the_rc_value
      false,
      // is_implicit
      ast_expr_token(arg)
    );
    // An `extern("Yo", X : Type)` member declares an opaque FFI type whose value
    // is a SomeT placeholder named X. Record X so the codegen-generic checks
    // (type_contains_some_type_for_codegen_param) don't treat it as a blocking
    // generic (it lowers to a concrete C type). Mirrors TS `SomeType.isExtern`.
    if(is_type_hierarchy_type(result.field_type), {
      register_extern_type_name(result.label.clone());
    });
    args_idx = (args_idx + usize(1));
    field_idx = (field_idx + usize(1));
  });
  // Store UnitVal result on the extern expression.
  unit_info := new_expr_info(env, t_unit());
  unit_info.value =.Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), unit_info);
  // Annotate callee (the "extern" func node) with same info.
  callee_expr := match(expr,.FnCall(_, fb, _, _, _) => fb,.Atom(_, _) => expr);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(callee_expr), unit_info);
  expr
});
export(evaluate_extern);
