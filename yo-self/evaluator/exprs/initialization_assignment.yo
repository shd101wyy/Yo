//! initialization_assignment — evaluate `::` and `:=` initialization assignments.
//!
//! 1:1 port of `src/evaluator/exprs/initialization-assignment.ts`.
//!
//! Handles:
//!   - `name := rhs`              — runtime variable declaration
//!   - `name :: rhs`              — compile-time constant declaration
//!   - `name := handler`   — implicit parameter declaration
//!   - `_ := rhs`                 — discard (renamed to a temp var)
//!
//! Phase 2w stubs (deferred to Phase 3):
//!   - `synthesize_expr_and_type` — type inference for `_`/partial types
//!   - `clone_value`              — deep clone of compile-time values
//!   - `set_expr_as_needs_to_call_dup` — deferred `___dup` insertion
//!   - `evaluate_destructuring_assignment` — destructuring LHS
//!   - `is_compile_time_only` check for function return type
//!   - `funcName` / `typeName` / `isModuleEffectMember` mutations
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  ast_expr_to_string,
  make_err_expr,
  BK_COLON,
  BK_CONST,
  BK_INIT_ASSIGN,
  BK_GIVEN,
  BK_INOUT
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  has_any_control_flow,
  path_collection_new,
  expr_info_set_runtime_destructurings,
  register_module_level_global
} :: import("../../expr_info.yo");
{ Environment, Variable, add_variable_to_env, get_variables_from_env, variable_set_doc_comment } :: import("../../env.yo");
{
  EvalContext,
  ExpectedTypeCtx,
  FuncOrAsyncBlockKind
} :: import("../context.yo");
{ EvalValue, create_unknown_val, is_runtime_only_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, type_value_tag } :: import("../../types/creators.yo");
{ TypeTag } :: import("../../types/tags.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{
  prohibit_void_type,
  type_requires_comptime_modifier,
  type_prohibits_comptime_modifier,
  type_contains_rc_type,
  type_is_control_bound
} :: import("../../types/utils.yo");
{ convert_comptime_type_to_runtime_type } :: import("../../types/env_lookup.yo");
{ type_to_string } :: import("../../types/string.yo");
{ is_function_type_and_returns_comptime_value } :: import("../../types/guards.yo");
{ format_error_message, format_error_messages, TokenAndError } :: import("../../error.yo");
{ type_implements_comptime, type_implements_runtime_full } :: import("../trait_checking.yo");
{ evaluate_expression_raw } :: import("./expr.yo");
{ is_valid_variable_name } :: import("../utils.yo");
{ throw_rhs_contains_control_flow_expression_error } :: import("./assignment.yo");
{
  evaluate_destructuring_assignment,
  DestructuringResult
} :: import("./destructuring_assignment.yo");
{ synthesize_expr_and_type } :: import("../types/expr_synthesizer.yo");
{ clone_value } :: import("../values/clone_value.yo");
{ find_rc_value_owner_relationship, throw_expr_is_implicit_variable_error, require_expr_not_consumed, set_expr_as_needs_to_call_dup, doc_comment_lookup_key_from_token } :: import("../utils.yo");
{ generate_new_temp_variable_name } :: import("../../utils.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// evaluate_initialization_assignment
// ---------------------------------------------------------------------------
/// Evaluate a `::` or `:=` initialization expression.
///
/// Mirrors `evaluateInitializationAssignment` in
/// `src/evaluator/exprs/initialization-assignment.ts`.
evaluate_initialization_assignment :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Validate shape.
  is_const := ast_expr_is_fn_call_of(expr, BK_CONST,.Some(usize(2)));
  is_init_assign := ast_expr_is_fn_call_of(expr, BK_INIT_ASSIGN,.Some(usize(2)));
  if(!(is_const || is_init_assign), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected \":=\" or \"::\" for initialization assignment."),
          false,
          .None
        )
      )
    );
  });
  // During CTFE (force_compile_time_bindings), `:=` is treated as `::`.
  is_compile_time_only := (is_const || ctx.force_compile_time_bindings);
  // For type conversion purposes, only `::` suppresses comptime→runtime
  // conversion; `:=` with forceCompileTimeBindings still converts.
  should_convert_to_runtime_type := !(is_const);
  // Reject runtime `:=` inside a compile-time-only function body.
  // Phase 2w: `is_function_type_and_returns_comptime_value` is a stub (always false).
  if(!(is_compile_time_only), {
    is_ctfe_body := match(
      ctx.is_evaluating_function_body_or_async_block,
      .Some(fctx) => (
        match(fctx.kind,.FunctionBody => true, _ => false) &&
          match(
            fctx.func_type,
            .Some(ft) => is_function_type_and_returns_comptime_value(ft),
            .None => false
          )
      ),
      .None => false
    );
    if(is_ctfe_body, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("Unexpected runtime variable declaration in a compile-time only function body."),
            false,
            .None
          )
        )
      );
    });
  });
  // Extract lhs and rhs from args.
  (lhs : AstExpr) = match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  (rhs : AstExpr) = match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(1)),.Some(a) => a,.None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  // Detect given(name) wrapper on LHS for implicit parameter declaration.
  (is_implicit : bool) = false;
  (actual_lhs : AstExpr) = lhs;
  // v4.1 (plans/archive/BORROW_EXCLUSIVITY.md): local `inout(name) := …` bindings
  // were REMOVED — `ref` exists only in parameter position. Mirrors the
  // TS rejection in initialization-assignment.ts.
  if(ast_expr_is_fn_call(lhs) && ast_expr_is_fn_call_of(lhs, BK_INOUT,.None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs),
          String.from("'inout(name) := ...' local bindings were removed — 'ref' exists only in parameter position. Read and write fields directly ('h.s = v'), or bind the handle ('b := a.b') to keep an object alive."),
          false,
          .None
        )
      )
    );
  });
  if(ast_expr_is_fn_call(lhs) && ast_expr_is_fn_call_of(lhs, BK_GIVEN,.None), {
    n_given_args := match(
      lhs,
      .FnCall(_, _, gargs, _, _) => gargs.len(),
      .Atom(_, _) => usize(0)
    );
    if(n_given_args != usize(1), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `Expected exactly one argument for "given", got ${n_given_args.to_string()}`,
            false,
            .None
          )
        )
      );
    });
    is_implicit = true;
    actual_lhs = match(
      lhs,
      .FnCall(_, _, gargs, _, _) => match(gargs.get(usize(0)),.Some(a) => a,.None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
  });
  // Prevent declaring variable type using :: or :=.
  if(ast_expr_is_fn_call(actual_lhs) && ast_expr_is_fn_call_of(actual_lhs, BK_COLON,.None), {
    op_str := ast_expr_token(expr).value.clone();
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(actual_lhs),
          `Unexpected use of ":" in type declaration with "${op_str}". Please consider using "=":
(${ast_expr_to_string(actual_lhs)}) = ${ast_expr_to_string(rhs)}`,
          false,
          .None
        )
      )
    );
  });
  // Evaluate the rhs expression.
  // Save/restore context fields that are locally overridden.
  old_expected_type := ctx.expected_type;
  old_is_inside_given_handler := ctx.is_inside_given_handler;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  if(is_implicit, {
    ctx.is_inside_given_handler = true;
  });
  // Use the exn-threading (raw) evaluator so a compile error in the rhs
  // propagates to the caller's handler instead of being caught, printed,
  // and swallowed by the non-raw `_evaluate_expression_wrapper` (which then
  // continues with a placeholder expr). In particular this lets a test
  // body's trial-evaluation swallow (see `evaluate_test`) actually catch
  // errors raised while evaluating a `:=` rhs. Mirrors TS
  // `evaluateInitializationAssignment` calling the propagating
  // `evaluateExpression`.
  rhs = evaluate_expression_raw(rhs, env, ctx, exn);
  ctx.expected_type = old_expected_type;
  ctx.is_inside_given_handler = old_is_inside_given_handler;
  // Update env from the evaluated rhs.
  rhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs));
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      env.frames = rhs_info.env.frames;
      env.module_path = rhs_info.env.module_path;
      env.function_declaration_frame_level = rhs_info.env.function_declaration_frame_level;
      env.input_string = rhs_info.env.input_string;
    },
    .None => ()
  );
  // Prohibit void rhs type.
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      prohibit_void_type(rhs_info.ty, ast_expr_token(rhs), exn);
    },
    .None => ()
  );
  // §4 escape boundary 2 (algebraic-effect ctl rules): a module-level binding
  // type cannot be control-bound. Module-level bindings outlive every call
  // frame, so a stored `ctl(...)` handler (or an aggregate / pointer containing
  // one) would be invokable long after its install frame has returned, where it
  // would `unwind` to a dead frame. Mirrors `initialization-assignment.ts:186-210`.
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      is_at_module_level := match(
        ctx.is_evaluating_function_body_or_async_block,
        .Some(_) => false,
        .None => true
      );
      if(is_at_module_level && type_is_control_bound(rhs_info.ty), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(rhs),
              `Cannot bind a value whose type is control-bound (transitively contains a \`ctl(...) -> ret\` function type) at module level. Module-level bindings outlive every call frame; invoking the contained control-function later would unwind to a dead frame.

Bound type: ${type_to_string(rhs_info.ty)}`,
              false,
              .None
            )
          )
        );
      });
    },
    .None => ()
  );
  // Reject rhs that unconditionally transfers control flow.
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      if(has_any_control_flow(rhs_info.control_flow), {
        match(
          rhs_info.control_flow,
          .Some(cf) => throw_rhs_contains_control_flow_expression_error(rhs, cf, exn),
          .None => ()
        );
      });
    },
    .None => ()
  );
  // Disallow implicit variables as the RHS of non-given assignment.
  throw_expr_is_implicit_variable_error(rhs, env, ctx, exn);
  // --------------------------------------------------------------------------
  // Branch: atom LHS vs destructuring LHS
  // --------------------------------------------------------------------------
  if(ast_expr_is_atom(actual_lhs), {
    // -------------------------------------------------------------------
    // Atom LHS: `name := rhs`
    // -------------------------------------------------------------------
    // Check if the RHS variable has been consumed (moved).
    require_expr_not_consumed(rhs, env, ctx, exn);
    // Insert dup-on-store (transfers/shares RC ownership of the RHS).
    set_expr_as_needs_to_call_dup(rhs, ctx, exn);
    // Re-read env in case set_expr_as_needs_to_call_dup updated it.
    match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
      .Some(ri) => {
        env.frames = ri.env.frames;
        env.module_path = ri.env.module_path;
        env.function_declaration_frame_level = ri.env.function_declaration_frame_level;
        env.input_string = ri.env.input_string;
      },
      .None => ()
    );
    // Validate LHS name.
    if(!(is_valid_variable_name(actual_lhs)), {
      lhs_tok_val := ast_expr_token(actual_lhs).value.clone();
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_lhs),
            `Invalid assignment to ${lhs_tok_val}, expected identifier or operator`,
            false,
            .None
          )
        )
      );
    });
    effective_is_compile_time_only := (is_implicit || is_compile_time_only);
    effective_should_convert_to_runtime := (!(is_implicit) && should_convert_to_runtime_type);
    // Determine the LHS type.
    rhs_type_opt := match(
      rhs_info_opt,
      .Some(ri) => Option(TypeValue).Some(ri.ty),
      .None => Option(TypeValue).None
    );
    actual_lhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(actual_lhs));
    // Check if the user pre-annotated the LHS with a type (via `(x : T) := rhs`).
    has_predefined_type := match(
      actual_lhs_info_opt,
      .Some(ali) => (match(ali.value,.Some(_) => true,.None => false) || (type_value_tag(ali.ty) != TypeTag.TUnit)),
      .None => false
    );
    // More precise: check if actualLhs.$.type was set (ExprInfo was created with a type annotation).
    // In yo-self, if ExprInfo for actual_lhs has a non-unit type we treat it as pre-annotated.
    (lhs_type : TypeValue) = match(
      rhs_type_opt,
      .Some(rt) => rt,
      .None => t_unit()
    );
    if(!(has_predefined_type), {
      // User did not annotate a type — infer from RHS.
      match(
        rhs_type_opt,
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(rhs),
                `Failed to evaluate, got ${ast_expr_to_string(rhs)}`,
                false,
                .None
              )
            )
          );
        },
        .Some(rt) => {
          lhs_type = rt;
          if(effective_should_convert_to_runtime, {
            lhs_type = convert_comptime_type_to_runtime_type(rt, env);
          });
          // Set ExprInfo for actual_lhs.
          new_ali := new_expr_info(env, lhs_type);
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(actual_lhs), new_ali);
        }
      );
    }, {
      // User annotated a type — synthesize and check compatibility.
      pre_type := match(
        actual_lhs_info_opt,
        .Some(ali) => ali.ty,
        .None => t_unit()
      );
      synth := synthesize_expr_and_type(rhs, pre_type, env, ctx);
      rhs = synth.expr;
      rhs_type_opt = Option(TypeValue).Some(synth.ty);
      env.frames = synth.env.frames;
      env.module_path = synth.env.module_path;
      env.function_declaration_frame_level = synth.env.function_declaration_frame_level;
      env.input_string = synth.env.input_string;
      // Re-read rhs_info for the updated rhs.
      rhs_info_opt = expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs));
      // Check type compatibility.
      if(!(are_types_compatible(pre_type, synth.ty)), {
        pre_ty_str := type_to_string(pre_type);
        rhs_ty_str := type_to_string(synth.ty);
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(actual_lhs),
              `Incompatible types:
- Defined: ${pre_ty_str}
- Given  : ${rhs_ty_str}`,
              false,
              .None
            )
          )
        );
      });
      lhs_type = pre_type;
    });
    // Check comptime modifier requirements. The tag-only helper misses
    // COMPOUND comptime-only types (a struct whose fields are all
    // comptime_int, e.g. basic.test.yo's Point2) — TS's
    // typeRequiresComptimeModifier is isComptimeOnlyType(type, env) =
    // implementsComptime && !implementsRuntime with the auto-derive
    // recursion (types/utils.ts:85-96). Use the env-aware derivation as
    // the fallback after the cheap tag path.
    lhs_requires_ct := (type_requires_comptime_modifier(lhs_type) || (type_implements_comptime(lhs_type, env) && !(type_implements_runtime_full(lhs_type, env))));
    if(!(effective_is_compile_time_only) && lhs_requires_ct, {
      lhs_type_str := type_to_string(lhs_type);
      expr_str := ast_expr_to_string(expr);
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Expected "::" instead of ":=" for compile-time known value assignment:
${expr_str}

Type:
${lhs_type_str}`,
            false,
            .None
          )
        )
      );
    });
    if(effective_is_compile_time_only && type_prohibits_comptime_modifier(lhs_type), {
      lhs_type_str := type_to_string(lhs_type);
      expr_str := ast_expr_to_string(expr);
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Expected ":=" instead of "::" for value type "${lhs_type_str}" which can only be used at the runtime:
${expr_str}`,
            false,
            .None
          )
        )
      );
    });
    // NOTE: Type mutations (funcName, typeName, isModuleEffectMember) are
    // intentionally skipped in Phase 2w.  The yo-self EvalValue types do not
    // carry these mutable fields — they are TS-specific optimization hints.
    // Get RHS compile-time value.
    rhs_value_opt := match(
      rhs_info_opt,
      .Some(ri) => ri.value,
      .None => Option(EvalValue).None
    );
    // Reject runtime value for a compile-time-only declaration.
    // A runtime CALL result is stored as a RUNTIME-ONLY UnknownVal placeholder
    // (`_call_result_unknown`, calls/function.yo) — "TS would have had no
    // value here" (value.yo doc). TS's gate is `if (!rhsValue && ...)`
    // (initialization-assignment.ts:325) where a runtime call left
    // `returnValue` unassigned (helper.ts:1752-1754), so the faithful port
    // rejects BOTH no-value and runtime-only-unknown. Without this,
    // `r :: runt_id(n)` was silently accepted (tests/fn.test.yo arm 12's
    // comptime_expect_error never saw an error and hollowed the batch).
    rhs_has_no_ct_value := match(
      rhs_value_opt,
      .Some(_rv) => is_runtime_only_unknown_val(_rv),
      .None => true
    );
    if(rhs_has_no_ct_value && effective_is_compile_time_only, {
      lhs_tok_val := ast_expr_token(actual_lhs).value.clone();
      rhs_str := ast_expr_to_string(rhs);
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_lhs),
            `Expected compile-time value for "${lhs_tok_val}".
Got runtime value. Please consider using ":=" instead of "::":
${rhs_str}`,
            false,
            .None
          )
        )
      );
    });
    // typeName stamping at `::` binding — mirrors TS
    // initialization-assignment.ts:343-367: `str :: newtype(...)` names the
    // struct "str", `Color :: enum(...)` names the enum, etc. TS mutates
    // the shared type object in place; yo-self TypeValues are value-typed,
    // so rebuild the TypeVal with the binding name filled (only when the
    // current name is empty) before storing. Without this, name-keyed
    // checks — e.g. panic's `typeName === "str"` (panic.ts:88) — can never
    // match; under propagated def-eval the prelude's `assert` failed on it
    // and cascaded across 96 std files.
    stamped_rhs_value_opt := match(
      rhs_value_opt,
      .Some(rv) => match(
        rv,
        .TypeVal(tv_box) => {
          binding_name := ast_expr_token(actual_lhs).value.clone();
          stamped_ty := match(
            tv_box,
            .Struct({ id : st_id, name : st_name, field_labels : st_fls, field_types : st_fts, is_reference_semantics : st_ref, is_atomic_rc : st_at, is_newtype : st_nt, constructor_func_id : st_cfid, type_arguments : st_ta, is_source_namespace : st_sns }) => cond(
              (st_name.len() == usize(0)) => Option(TypeValue).Some(
                TypeValue.Struct(st_id, binding_name, st_fls, st_fts, st_ref, st_at, st_nt, st_cfid, st_ta, st_sns)
              ),
              true => Option(TypeValue).None
            ),
            .EnumT(en_id, en_name, en_vns, en_vfs, en_sel, en_vfl, en_vd, en_irs, en_iar) => cond(
              (en_name.len() == usize(0)) => Option(TypeValue).Some(
                TypeValue.EnumT(en_id, binding_name, en_vns, en_vfs, en_sel, en_vfl, en_vd, en_irs, en_iar)
              ),
              true => Option(TypeValue).None
            ),
            .Union(un_name, un_fls, un_fts) => cond(
              (un_name.len() == usize(0)) => Option(TypeValue).Some(
                TypeValue.Union(binding_name, un_fls, un_fts)
              ),
              true => Option(TypeValue).None
            ),
            // Traits too: `Send :: trait(id := "Send")` names the trait
            // "Send" (TS stamps any unnamed type the same way). Identity is
            // unaffected — trait matching keys on the `id` field, which is
            // preserved. Without this, diagnostics render the trait as its
            // field dump (`(id : comptime_str)` instead of `Send`), e.g.
            // the where-clause "does not implement required trait" error.
            .TraitT(tr_name, tr_atns, tr_fls, tr_fts, tr_id, tr_conc, tr_sc, tr_nsc, tr_atcl, tr_atct) => cond(
              (tr_name.len() == usize(0)) => Option(TypeValue).Some(
                TypeValue.TraitT(binding_name, tr_atns, tr_fls, tr_fts, tr_id, tr_conc, tr_sc, tr_nsc, tr_atcl, tr_atct)
              ),
              true => Option(TypeValue).None
            ),
            _ => Option(TypeValue).None
          );
          match(
            stamped_ty,
            .Some(new_ty) => Option(EvalValue).Some(EvalValue.TypeVal(new_ty)),
            .None => rhs_value_opt
          )
        },
        _ => rhs_value_opt
      ),
      .None => rhs_value_opt
    );
    // Determine the value to store.
    lhs_value_opt := cond(
      effective_is_compile_time_only => match(
        stamped_rhs_value_opt,
        .Some(rv) => Option(EvalValue).Some(clone_value(rv, true)),
        .None => Option(EvalValue).Some(create_unknown_val(lhs_type))
      ),
      true => Option(EvalValue).None
    );
    // Update ExprInfo for actual_lhs with final value and env.
    // (Re-read in case synthesize_expr_and_type updated it.)
    actual_lhs_info_final_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(actual_lhs));
    (actual_lhs_info : ExprInfo) = match(
      actual_lhs_info_final_opt,
      .Some(ali) => ali,
      .None => new_expr_info(env, lhs_type)
    );
    actual_lhs_info.ty = lhs_type;
    actual_lhs_info.env = env;
    actual_lhs_info.value = lhs_value_opt;
    actual_lhs_info.path_collection = path_collection_new();
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(actual_lhs), actual_lhs_info);
    // NOTE: SomeType resolvedConcreteType copy is skipped in Phase 2w.
    // yo-self's TypeValue.SomeT does not carry resolvedConcreteType.
    final_lhs_type := lhs_type;
    // Find RC owner relationship for shared-ownership tracking.
    // (type_contains_rc_type is a stub returning false, so rhsOwningVariable
    //  will always be None in Phase 2w.)
    rhs_owning_variable := find_rc_value_owner_relationship(rhs, env, ctx);
    is_owning_same_rc_value_as := match(
      rhs_owning_variable,
      .Some(rov) => match(
        rov.consumed_at_token,
        // If the RHS was moved, LHS becomes the new primary owner (no chain).
        .Some(_) => Option(Variable).None,
        .None => Option(Variable).Some(rov)
      ),
      .None => Option(Variable).None
    );
    // Rename `_` to a unique temp name so it is tracked in the frame for drop/RC cleanup.
    actual_lhs_tok := ast_expr_token(actual_lhs);
    (var_name : String) = cond(
      (actual_lhs_tok.value == "_") =>
        generate_new_temp_variable_name(env.module_path),
      true =>
        actual_lhs_tok.value.clone()
    );
    // Reject mutable runtime variable inside an impl block.
    is_runtime_not_in_fn := (!(effective_is_compile_time_only) && !(ctx.is_evaluating_function_body_or_async_block.is_some()));
    if(is_runtime_not_in_fn && ctx.is_inside_impl_block, {
      exn.throw(
        dyn(
          format_error_message(
            actual_lhs_tok,
            `Mutable runtime variable "${var_name}" is not allowed inside an impl block.
Use \`::\` for compile-time definitions inside impl.`,
            false,
            .None
          )
        )
      );
    });
    // Mark as module-level for C file-scope statics.
    is_module_level := (
      !(effective_is_compile_time_only) &&
        !(ctx.is_evaluating_function_body_or_async_block.is_some())
    );
    // Look up doc comment from pre-computed position-keyed lookup.
    doc_comment_opt := match(
      ctx.doc_comment_lookup,
      .None => Option(String).None,
      .Some(lookup) => {
        key := doc_comment_lookup_key_from_token(actual_lhs_tok);
        match(lookup.get(key),.Some(v) => Option(String).Some(v),.None => Option(String).None)
      }
    );
    // No-shadowing rule (TS env.ts:644-658, enforced inside addVariableToEnv):
    // a `:=`/`::` binding may not reuse a name visible in ANY frame. yo-self
    // keeps the check at the user binding-introduction sites instead of inside
    // add_variable_to_env — that helper's 100+ internal callers correspond to
    // TS sites passing `allowVariableShadowing: true` (params, type params,
    // effect spreads). Temp names (`_` rename) are machine-unique, and
    // `__yo_self` is TS's explicit exemption.
    if(var_name != String.from("__yo_self"), {
      shadow_existing := get_variables_from_env(env, var_name);
      if(shadow_existing.len() > usize(0), {
        match(
          shadow_existing.get(shadow_existing.len() - usize(1)),
          .Some(shadow_var) => {
            sh_entries := ArrayList(TokenAndError).new();
            sh_entries.push(
              TokenAndError(
                token : actual_lhs_tok,
                error_message : `Failed to define variable "${var_name}":`
              )
            );
            sh_entries.push(
              TokenAndError(
                token : shadow_var.token,
                error_message : `Variable "${var_name}" is already defined here (variable shadowing is not allowed):`
              )
            );
            exn.throw(dyn(format_error_messages(sh_entries, false,.None)));
          },
          .None => ()
        );
      });
    });
    // Add variable to environment.
    new_var_opt := add_variable_to_env(
      env,
      var_name,
      final_lhs_type,
      lhs_value_opt,
      effective_is_compile_time_only,
      !(is_implicit),
      // is_reassignable
      type_contains_rc_type(final_lhs_type),
      // is_owning_the_rc_value (stub: always false)
      is_implicit,
      actual_lhs_tok
    );
    // Patch mutable fields not supported by add_variable_to_env.
    match(
      new_var_opt,
      .Some(new_var) => {
        new_var.is_module_level = is_module_level;
        // Also record it in the data-keyed registry — env copies can lose
        // the flag on some resolution paths (see expr_info.yo
        // g_module_level_globals).
        if(is_module_level, {
          register_module_level_global(actual_lhs_tok.module_path.clone(), var_name.clone());
        });
        variable_set_doc_comment(new_var, doc_comment_opt);
        // Set is_owning_the_same_rc_value_as when applicable.
        match(
          is_owning_same_rc_value_as,
          .Some(rov) => {
            new_var.is_owning_the_same_rc_value_as = Option(Box(Variable)).Some(Box(Variable)(rov));
          },
          .None => ()
        );
      },
      .None => ()
    );
    // Store the renamed variable name in ExprInfo so codegen uses it instead of "_".
    if(actual_lhs_tok.value == "_", {
      ali_after := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(actual_lhs)),
        .Some(a) => a,
        .None => new_expr_info(env, final_lhs_type)
      );
      ali_after.variable_name = Option(String).Some(var_name);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(actual_lhs), ali_after);
    });
    // Update env in ExprInfo for actual_lhs.
    ali_final := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(actual_lhs)),
      .Some(a) => a,
      .None => new_expr_info(env, final_lhs_type)
    );
    ali_final.env = env;
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(actual_lhs), ali_final);
    // If name := handler, set ExprInfo on the outer given(...) wrapper.
    if(is_implicit, {
      lhs_info := new_expr_info(env, t_unit());
      lhs_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(lhs), lhs_info);
    });
    // Set ExprInfo on the whole :: / := expression.
    expr_info := new_expr_info(env, t_unit());
    expr_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info.is_compile_time_only_assignment = Option(bool).Some(effective_is_compile_time_only);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
    expr
  }, {
    // -------------------------------------------------------------------
    // Destructuring LHS: `{x, y} := rhs`
    // -------------------------------------------------------------------
    effective_is_compile_time_only := (is_implicit || is_compile_time_only);
    destr_result := evaluate_destructuring_assignment(
      actual_lhs,
      rhs,
      env,
      effective_is_compile_time_only,
      ctx,
      exn
    );
    env.frames = destr_result.env.frames;
    env.module_path = destr_result.env.module_path;
    env.function_declaration_frame_level = destr_result.env.function_declaration_frame_level;
    env.input_string = destr_result.env.input_string;
    expr_info := new_expr_info(env, t_unit());
    expr_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_set_runtime_destructurings(expr_info, destr_result.runtime_destructurings);
    expr_info.is_compile_time_only_assignment = Option(bool).Some(effective_is_compile_time_only);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
    expr
  })
});
export(evaluate_initialization_assignment);
