//! Shared tree-walking analysis for suspension points.
//!
//! Mirrors `src/evaluator/shared/suspension-analysis.ts` — 1:1 port.
//!
//! Both async/await and algebraic effects use the same algorithm to:
//!  1. Capture local variables that persist across suspension points.
//!  2. Handle while loop nesting.
//!  3. Merge cond/match branch suspension points.
//!  4. Walk deferred drop/dup expressions.
//!
//! The only difference is *what constitutes a suspension point*, which is
//! injected via the `SuspensionPointDetector` callback object.
//!
//! Key design decisions vs the TypeScript source:
//!
//! * `SuspensionPointDetector<P extends SuspensionPoint>` (TypeScript generic interface) →
//!   `SuspensionPointDetector :: object(detect : Dyn(...), should_skip_body : Dyn(...))`.
//!   Yo does not support generic object fields; `Dyn(Fn)` replaces `Impl(Fn)` in fields.
//!   The typed side-channel (e.g. ArrayList(AwaitPoint)) is maintained INSIDE the detect
//!   closure by the caller. See issues/suspension-analysis-typed-side-channel.md for the
//!   reconstruction strategy required in Phase 2m/2n.
//!
//! * `walkExpr<P>(..., points: P[])` generic → `walk_expr_` with
//!   `points : ArrayList(SuspensionPoint)` (base type). The detect closure pushes base
//!   SuspensionPoint objects; callers reconstruct typed lists post-analysis.
//!
//! * `handleBranchingExpr` is inlined into `walk_expr_` because mutual top-level
//!   `recur` across two functions is not supported in Yo.
//!
//! * `analyzeSuspensionPoints` takes an extra `get_info` parameter (Yo's equivalent of
//!   `expr.$` — the per-expression evaluation annotation set by the TypeScript evaluator).
//!   See issues/suspension-analysis-get-info-identity.md for the structural vs.
//!   identity-based lookup strategy required in Phase 3.
//!
//! * `capturedVariables` is a `HashMap(String, SuspensionCapturedVariable)` for O(1) dedup;
//!   `captured_variable_ids_in_order` is a parallel `ArrayList(String)` that preserves
//!   first-seen insertion order (TypeScript `Map` is insertion-ordered, Yo `HashMap` is not).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TokenKind } :: import("../../token.yo");
{ AstExpr, ast_expr_is_fn_call_of } :: import("../../expr.yo");
{ ExprInfo } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ Variable, Environment, get_variables_from_env } :: import("../../env.yo");
{
  SuspensionPoint,
  SuspensionCapturedVariable,
  SuspensionAnalysisResult
} :: import("./suspension_analysis_types.yo");
// ---------------------------------------------------------------------------
// SuspensionPointDetector
// ---------------------------------------------------------------------------
/// Callback object for detecting system-specific suspension points.
/// Async and effect detectors provide concrete implementations.
///
/// Mirrors `SuspensionPointDetector<P extends SuspensionPoint>` in
/// `src/evaluator/shared/suspension-analysis.ts`.
///
/// Design note: `Impl(Fn)` is rejected in object/struct/enum fields in Yo;
/// `Dyn(Fn)` is the correct approach. Construct with `dyn(closure_expr)`.
SuspensionPointDetector :: ref(
  struct(
    /// Detect suspension point(s) in a FnCall expression and push them to `points`.
    /// The detector is responsible for constructing the full SuspensionPoint including
    /// system-specific fields. Use `extract_target_variable_id` for the common
    /// parent `:=` assignment pattern.
    ///
    /// Typed side-channel lists (e.g. ArrayList(AwaitPoint)) are typically maintained
    /// inside this closure by the caller; see the Phase 2m/2n implementation notes.
    detect : Dyn(
      Fn(
        expr : AstExpr,
        parent_expr : Option(AstExpr),
        points : ArrayList(SuspensionPoint)
      ) -> unit
    ),
    /// Return true if this FnCall expression's body should be skipped
    /// (no recursion into func/args). Used for nested async blocks that
    /// have their own analysis. Deferred dup expressions are still walked.
    should_skip_body : Dyn(Fn(expr : AstExpr) -> bool)
  )
);
// ---------------------------------------------------------------------------
// extract_target_variable_id
// ---------------------------------------------------------------------------
/// Extracts the target variable ID from a parent `:=` assignment expression.
/// Shared by both async and effect suspension point detection.
///
/// Mirrors `extractTargetVariableId` in
/// `src/evaluator/shared/suspension-analysis.ts`.
extract_target_variable_id :: (
  fn(
    parent_expr : Option(AstExpr),
    get_info : Impl(Fn(e : AstExpr) -> Option(ExprInfo))
  ) -> Option(String)
)({
  pe := match(
    parent_expr,
    .None => {
      return(Option(String).None);
    },
    .Some(x) => x
  );
  if(!(ast_expr_is_fn_call_of(pe.clone(), ":=", Option(usize).None)), {
    return(Option(String).None);
  });
  // Extract args[0] from the FnCall
  var_expr := match(
    pe.clone(),
    .Atom(_, _) => {
      return(Option(String).None);
    },
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .None => {
        return(Option(String).None);
      },
      .Some(ve) => ve
    )
  );
  // Must be an Identifier atom
  tok := match(
    var_expr.clone(),
    .Atom(_, t) => t,
    .FnCall(_, _, _, _, _) => {
      return(Option(String).None);
    }
  );
  if(tok.kind != TokenKind.Identifier, {
    return(Option(String).None);
  });
  var_name := tok.value;
  // Resolve through the `:=` node's OWN recorded env FIRST: it is stamped
  // post-binding, so it always contains the freshly-bound target (and under
  // shadowing resolves to the NEW binding, matching TS where the LHS atom's
  // env is stamped after the binding). yo-self's LHS atom env PREDATES the
  // binding — it only sees the target through retroactive shared-Frame
  // mutation, which breaks across match/cond arm frames (the sys/timer FSM
  // `result := io.await(...)` extracted no target and the await result was
  // never copied out of the future). Same root cause as the `:=`
  // binding-target case in collect_variable_refs_in_expr (state_machine.yo).
  match(
    get_info(pe.clone()),
    .Some(pinfo) => {
      pvars := get_variables_from_env(pinfo.env, var_name.clone());
      pn := pvars.len();
      if(pn > usize(0), {
        match(
          pvars.get(pn - usize(1)),
          .Some(pv) => {
            return(Option(String).Some(pv.id.clone()));
          },
          .None => ()
        );
      });
    },
    .None => ()
  );
  // Fallback: the LHS atom's env (works when the recorded Frame is shared
  // with the binding scope).
  match(
    get_info(var_expr.clone()),
    .None => Option(String).None,
    .Some(info) => {
      variables := get_variables_from_env(info.env, var_name.clone());
      n := variables.len();
      if(n == usize(0), {
        return(Option(String).None);
      });
      last_var := match(
        variables.get(n - usize(1)),
        .None => {
          return(Option(String).None);
        },
        .Some(v) => v
      );
      Option(String).Some(last_var.id.clone())
    }
  )
});
// ---------------------------------------------------------------------------
// _capture_env_variable (internal)
// ---------------------------------------------------------------------------
/// Resolve `var_name` in `env` and record it as a suspension-captured variable:
/// SSA-renamed ids remap to the original, RC-sharing borrows capture the OWNER,
/// otherwise a normal capture. This is the Atom-case capture cascade of
/// `walk_expr_`, factored out so the `:=` binding-target case can run the SAME
/// logic through the `:=` node's own (post-binding) env — the LHS atom's
/// recorded env predates the binding in yo-self, so the Atom walk alone misses
/// freshly-bound targets (TS's walker sees them because TS stamps LHS envs
/// post-binding). `ty_override` is the captured type when the caller has a
/// better source than the variable's own declared type (the Atom case passes
/// its ExprInfo type, preserving the original behavior exactly).
_capture_env_variable :: (
  fn(
    var_name : String,
    env : Environment,
    ty_override : Option(TypeValue),
    captured_variables : HashMap(String, SuspensionCapturedVariable),
    captured_variable_ids_in_order : ArrayList(String),
    name_frame_to_original_id : HashMap(String, String),
    variable_id_remapping : HashMap(String, String)
  ) -> unit
)({
  variables := get_variables_from_env(env, var_name.clone());
  n_vars := variables.len();
  if(n_vars > usize(0), {
    variable := match(
      variables.get(n_vars - usize(1)),
      .None => {
        return(());
      },
      .Some(v) => v
    );
    if(!(variable.is_compile_time_only) && !(captured_variables.contains_key(variable.id.clone())), {
      name_frame_key := `${variable.name}:${variable.frame_level}`;
      // Check if there is a different existing original ID for this name:frame key
      has_different_orig := match(
        name_frame_to_original_id.get(name_frame_key.clone()),
        .None => false,
        .Some(eid) => (eid != variable.id)
      );
      cond(
        // Case 1: SSA renaming — remap this ID to the original
        has_different_orig => {
          orig_id := match(
            name_frame_to_original_id.get(name_frame_key.clone()),
            .None => String.from(""),
            .Some(id) => id
          );
          variable_id_remapping.set(variable.id.clone(), orig_id);
        },
        // Case 2/3: owner capture or normal capture
        // Single match to avoid double field access (move safety).
        true => {
          match(
            variable.is_owning_the_same_rc_value_as,
            // Case 2: variable shares RC with an owner — capture the owner
            .Some(owner_box) => {
              owner_var := owner_box.*;
              if(!(captured_variables.contains_key(owner_var.id.clone())), {
                owner_captured := SuspensionCapturedVariable(
                  id : owner_var.id.clone(),
                  name : owner_var.name.clone(),
                  ty : owner_var.ty.clone(),
                  is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None
                );
                captured_variables.set(owner_var.id.clone(), owner_captured);
                captured_variable_ids_in_order.push(owner_var.id.clone());
                owner_nfk := `${owner_var.name}:${owner_var.frame_level}`;
                if(!(name_frame_to_original_id.contains_key(owner_nfk.clone())), {
                  name_frame_to_original_id.set(owner_nfk, owner_var.id.clone());
                });
              });
            },
            // Case 3: normal capture
            .None => {
              cap_ty := match(
                ty_override,
                .Some(t) => t,
                .None => variable.ty.clone()
              );
              sc := SuspensionCapturedVariable(
                id : variable.id.clone(),
                name : var_name.clone(),
                ty : cap_ty,
                is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None
              );
              captured_variables.set(variable.id.clone(), sc);
              captured_variable_ids_in_order.push(variable.id.clone());
              if(!(name_frame_to_original_id.contains_key(name_frame_key.clone())), {
                name_frame_to_original_id.set(name_frame_key, variable.id.clone());
              });
            }
          );
        }
      );
    });
  });
});
// ---------------------------------------------------------------------------
// walk_expr_ (internal)
// ---------------------------------------------------------------------------
/// Recursively walks an expression tree to find suspension points and capture variables.
///
/// Internal helper — not exported.
///
/// Mirrors `walkExpr` from `src/evaluator/shared/suspension-analysis.ts`,
/// with `handleBranchingExpr` inlined for the cond/match case (Yo does not
/// support mutual `recur` across two top-level functions).
walk_expr_ :: (
  fn(
    expr : AstExpr,
    get_info : Impl(Fn(e : AstExpr) -> Option(ExprInfo)),
    points : ArrayList(SuspensionPoint),
    captured_variables : HashMap(String, SuspensionCapturedVariable),
    captured_variable_ids_in_order : ArrayList(String),
    name_frame_to_original_id : HashMap(String, String),
    variable_id_remapping : HashMap(String, String),
    detector : SuspensionPointDetector,
    parent_expr : Option(AstExpr)
  ) -> unit
)({
  // Clone expr before match because match consumes the value.
  expr_cloned := expr.clone();
  match(
    expr,
    // -----------------------------------------------------------------------
    // Atom — capture identifiers that cross suspension points
    // -----------------------------------------------------------------------
    .Atom(_, tok) => {
      if(tok.kind == TokenKind.Identifier, {
        var_name := tok.value;
        match(
          get_info(expr_cloned.clone()),
          .None => (),
          .Some(info) => {
            _capture_env_variable(var_name.clone(), info.env, Option(TypeValue).Some(info.ty.clone()), captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping);
          }
        );
      });
    },
    // -----------------------------------------------------------------------
    // FnCall — while, cond/match, or a potential suspension point
    // -----------------------------------------------------------------------
    .FnCall(_, func_box, args, _, _) => {
      // `:=` binding TARGET: capture it through the `:=` node's OWN
      // (post-binding) env. The recursion below visits the LHS atom, but its
      // recorded env PREDATES the binding, so the Atom case misses the fresh
      // variable — an await/suspension result target then never gets an SM
      // struct field, and the result extraction writes to a non-member
      // (`sm->var_<id> = sm->await_future_N->result` — the fs/file flag-on
      // clang error). TS's Atom walk covers this because TS stamps LHS envs
      // post-binding.
      if(ast_expr_is_fn_call_of(expr_cloned.clone(), ":=", Option(usize).None), {
        match(
          args.get(usize(0)),
          .Some(lhs_e) => match(
            lhs_e,
            .Atom(_, lhs_tok) => if(lhs_tok.kind == TokenKind.Identifier, {
              match(
                get_info(expr_cloned.clone()),
                .Some(binfo) => {
                  _capture_env_variable(lhs_tok.value.clone(), binfo.env, Option(TypeValue).None, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping);
                },
                .None => ()
              );
            }),
            .FnCall(_, _, _, _, _) => ()
          ),
          .None => ()
        );
      });
      is_while := ast_expr_is_fn_call_of(expr_cloned.clone(), "while", Option(usize).None);
      is_cond_or_match := (
        ast_expr_is_fn_call_of(expr_cloned.clone(), "cond", Option(usize).None) ||
          ast_expr_is_fn_call_of(expr_cloned.clone(), "match", Option(usize).None)
      );
      cond(
        // -------------------------------------------------------------------
        // while — mark all new suspension points with nesting info
        // -------------------------------------------------------------------
        is_while => {
          initial_count := points.len();
          recur(func_box, get_info, points, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping, detector, Option(AstExpr).Some(expr_cloned.clone()));
          (ai : usize) = usize(0);
          n_args := args.len();
          while(ai < n_args, {
            arg := match(
              args.get(ai),
              .None => {
                ai = n_args;
                return(());
              },
              .Some(a) => a
            );
            recur(arg, get_info, points, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping, detector, Option(AstExpr).Some(expr_cloned.clone()));
            ai = (ai + usize(1));
          });
          new_count := points.len();
          if(new_count > initial_count, {
            (wi : usize) = initial_count;
            while(wi < new_count, {
              sp := match(
                points.get(wi),
                .None => {
                  wi = new_count;
                  return(());
                },
                .Some(p) => p
              );
              sp.is_inside_while = Option(bool).Some(true);
              current_depth := match(sp.while_nesting_depth,.None => usize(0),.Some(d) => d);
              sp.while_nesting_depth = Option(usize).Some(current_depth + usize(1));
              if(sp.enclosing_while_expr.is_none(), {
                sp.enclosing_while_expr = Option(AstExpr).Some(expr_cloned.clone());
              });
              wi = (wi + usize(1));
            });
          });
        },
        // -------------------------------------------------------------------
        // cond / match — merge mutually exclusive branch suspension points
        // (handleBranchingExpr inlined)
        // -------------------------------------------------------------------
        is_cond_or_match => {
          initial_count_b := points.len();
          // Walk the func expression (keyword + condition/matched value)
          recur(func_box, get_info, points, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping, detector, Option(AstExpr).Some(expr_cloned.clone()));
          // Save nameFrameToOriginalId snapshot before walking branches so that
          // variables declared inside one branch don't leak into subsequent branches.
          saved_keys := ArrayList(String).new();
          saved_vals := ArrayList(String).new();
          for(name_frame_to_original_id.iter_ptr(), (entry_ptr) => {
            k := unsafe(entry_ptr.*).key.clone();
            v := unsafe(entry_ptr.*).value.clone();
            saved_keys.push(k);
            saved_vals.push(v);
          });
          // Walk each branch separately, recording per-branch suspension points
          per_branch_points := ArrayList(ArrayList(SuspensionPoint)).new();
          (ai2 : usize) = usize(0);
          n_args2 := args.len();
          while(ai2 < n_args2, {
            branch_start := points.len();
            arg2 := match(
              args.get(ai2),
              .None => {
                ai2 = n_args2;
                return(());
              },
              .Some(a) => a
            );
            recur(arg2, get_info, points, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping, detector, Option(AstExpr).Some(expr_cloned.clone()));
            // Copy per-branch SuspensionPoint handles (same RC objects as in points)
            branch_pts := ArrayList(SuspensionPoint).new();
            (bi : usize) = branch_start;
            cur_len := points.len();
            while(bi < cur_len, {
              sp2 := match(
                points.get(bi),
                .None => {
                  bi = cur_len;
                  return(());
                },
                .Some(p) => p
              );
              branch_pts.push(sp2);
              bi = (bi + usize(1));
            });
            per_branch_points.push(branch_pts);
            ai2 = (ai2 + usize(1));
          });
          // Restore snapshot — branch-local declarations must not persist
          name_frame_to_original_id.clear();
          (si : usize) = usize(0);
          n_saved := saved_keys.len();
          while(si < n_saved, {
            k2 := match(
              saved_keys.get(si),
              .None => {
                si = n_saved;
                return(());
              },
              .Some(k) => k
            );
            v2 := match(
              saved_vals.get(si),
              .None => {
                si = n_saved;
                return(());
              },
              .Some(v) => v
            );
            name_frame_to_original_id.set(k2, v2);
            si = (si + usize(1));
          });
          // Compute max depth across all branches
          (max_depth : usize) = usize(0);
          n_branches := per_branch_points.len();
          (bpi : usize) = usize(0);
          while(bpi < n_branches, {
            branch := match(
              per_branch_points.get(bpi),
              .None => {
                bpi = n_branches;
                return(());
              },
              .Some(b) => b
            );
            if(branch.len() > max_depth, {
              max_depth = branch.len();
            });
            bpi = (bpi + usize(1));
          });
          if(max_depth > usize(0), {
            // Remove all new points added during branch walking
            while(points.len() > initial_count_b, {
              points.pop();
            });
            // Re-add merged suspension points: one representative per depth position
            first_index_b := initial_count_b;
            (pos : usize) = usize(0);
            while(pos < max_depth, {
              // Find the first branch that has a point at this depth position.
              // Use a bool sentinel to avoid consuming rep_opt in the loop condition.
              (rep_opt : Option(SuspensionPoint)) = Option(SuspensionPoint).None;
              (found_rep : bool) = false;
              (bpi2 : usize) = usize(0);
              while((bpi2 < n_branches) && !(found_rep), {
                branch2 := match(
                  per_branch_points.get(bpi2),
                  .None => {
                    bpi2 = n_branches;
                    return(());
                  },
                  .Some(b) => b
                );
                if(pos < branch2.len(), {
                  sp3 := match(
                    branch2.get(pos),
                    .None => {
                      bpi2 = n_branches;
                      return(());
                    },
                    .Some(p) => p
                  );
                  rep_opt = Option(SuspensionPoint).Some(sp3);
                  found_rep = true;
                  bpi2 = n_branches;
                });
                bpi2 = (bpi2 + usize(1));
              });
              match(
                rep_opt,
                .None => (),
                .Some(rep) => {
                  rep.index = points.len();
                  rep.is_inside_cond = Option(bool).Some(true);
                  if(pos == usize(0), {
                    rep.needs_own_cond_branch_field = Option(bool).Some(true);
                  });
                  if(pos > usize(0), {
                    rep.cond_branch_source_index = Option(usize).Some(first_index_b);
                  });
                  points.push(rep);
                }
              );
              pos = (pos + usize(1));
            });
          });
        },
        // -------------------------------------------------------------------
        // Default — detect suspension, then recurse into children
        // -------------------------------------------------------------------
        true => {
          detector.detect(expr_cloned.clone(), parent_expr, points);
          if(detector.should_skip_body(expr_cloned.clone()), {
            // For skipped bodies, still walk deferred dup expressions
            match(
              get_info(expr_cloned.clone()),
              .None => (),
              .Some(info2) => {
                match(
                  info2.deferred_dup_expressions,
                  .None => (),
                  .Some(dup_exprs) => {
                    (di : usize) = usize(0);
                    n_dup := dup_exprs.len();
                    while(di < n_dup, {
                      dup_e := match(
                        dup_exprs.get(di),
                        .None => {
                          di = n_dup;
                          return(());
                        },
                        .Some(e) => e
                      );
                      recur(dup_e, get_info, points, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping, detector, Option(AstExpr).Some(expr_cloned.clone()));
                      di = (di + usize(1));
                    });
                  }
                );
              }
            );
            return(());
          });
          // Recurse into function and arguments
          recur(func_box, get_info, points, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping, detector, Option(AstExpr).Some(expr_cloned.clone()));
          (ai3 : usize) = usize(0);
          n_args3 := args.len();
          while(ai3 < n_args3, {
            arg3 := match(
              args.get(ai3),
              .None => {
                ai3 = n_args3;
                return(());
              },
              .Some(a) => a
            );
            recur(arg3, get_info, points, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping, detector, Option(AstExpr).Some(expr_cloned.clone()));
            ai3 = (ai3 + usize(1));
          });
          // Walk deferred drop expressions
          match(
            get_info(expr_cloned.clone()),
            .None => (),
            .Some(info3) => {
              match(
                info3.deferred_drop_expressions,
                .None => (),
                .Some(drop_exprs) => {
                  (di2 : usize) = usize(0);
                  n_drop := drop_exprs.len();
                  while(di2 < n_drop, {
                    drop_e := match(
                      drop_exprs.get(di2),
                      .None => {
                        di2 = n_drop;
                        return(());
                      },
                      .Some(e) => e
                    );
                    recur(drop_e, get_info, points, captured_variables, captured_variable_ids_in_order, name_frame_to_original_id, variable_id_remapping, detector, Option(AstExpr).Some(expr_cloned.clone()));
                    di2 = (di2 + usize(1));
                  });
                }
              );
            }
          );
        }
      );
    }
  );
});
// ---------------------------------------------------------------------------
// analyze_suspension_points
// ---------------------------------------------------------------------------
/// Analyzes a function body to find all suspension points and captured variables.
///
/// Mirrors `analyzeSuspensionPoints` in
/// `src/evaluator/shared/suspension-analysis.ts`.
///
/// Takes an extra `get_info` parameter: Yo's equivalent of `expr.$` —
/// the per-expression evaluation annotation set by the TypeScript evaluator.
analyze_suspension_points :: (
  fn(
    body : AstExpr,
    get_info : Impl(Fn(e : AstExpr) -> Option(ExprInfo)),
    detector : SuspensionPointDetector
  ) -> SuspensionAnalysisResult
)({
  suspension_points := ArrayList(SuspensionPoint).new();
  captured_variables := HashMap(String, SuspensionCapturedVariable).new();
  captured_variable_ids_in_order := ArrayList(String).new();
  name_frame_to_orig_id := HashMap(String, String).new();
  variable_id_remapping := HashMap(String, String).new();
  walk_expr_(
    body.clone(),
    get_info,
    suspension_points,
    captured_variables,
    captured_variable_ids_in_order,
    name_frame_to_orig_id,
    variable_id_remapping,
    detector,
    Option(AstExpr).None
  );
  // Also walk deferred drop expressions from body
  match(
    get_info(body.clone()),
    .None => (),
    .Some(body_info) => {
      match(
        body_info.deferred_drop_expressions,
        .None => (),
        .Some(drop_exprs) => {
          n_drops := drop_exprs.len();
          (di : usize) = usize(0);
          while(di < n_drops, {
            drop_e := match(
              drop_exprs.get(di),
              .None => {
                break;
              },
              .Some(e) => e
            );
            walk_expr_(
              drop_e,
              get_info,
              suspension_points,
              captured_variables,
              captured_variable_ids_in_order,
              name_frame_to_orig_id,
              variable_id_remapping,
              detector,
              Option(AstExpr).None
            );
            di = (di + usize(1));
          });
        }
      );
    }
  );
  // If no suspension points found, no variables need to be captured
  if(suspension_points.len() == usize(0), {
    captured_variables.clear();
    captured_variable_ids_in_order.clear();
  });
  // Build captured variable list in first-seen insertion order
  captured_list := ArrayList(SuspensionCapturedVariable).new();
  n_ids := captured_variable_ids_in_order.len();
  (ci : usize) = usize(0);
  while(ci < n_ids, {
    id := match(
      captured_variable_ids_in_order.get(ci),
      .None => {
        break;
      },
      .Some(i) => i
    );
    cv := match(
      captured_variables.get(id.clone()),
      .None => {
        break;
      },
      .Some(v) => v
    );
    captured_list.push(cv);
    ci = (ci + usize(1));
  });
  SuspensionAnalysisResult(
    suspension_points : suspension_points,
    captured_variables : captured_list,
    has_suspensions : (suspension_points.len() > usize(0)),
    variable_id_remapping : variable_id_remapping
  )
});
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(SuspensionPointDetector, extract_target_variable_id, analyze_suspension_points);
