//! Async function body analysis — await point detection.
//!
//! Mirrors `src/evaluator/async/await-analysis.ts` — 1:1 port.
//!
//! Analyzes async function bodies to identify await points and local variables
//! that need to be captured in state machine structs.
//!
//! This is a thin wrapper around the shared suspension-point analysis,
//! providing the async-specific suspension point detection (io.await/io.spawn).
//!
//! Key design decisions vs the TypeScript source:
//!
//! * `analyzeAwaitPoints(body)` → `analyze_await_points(body, get_info)`:
//!   the extra `get_info` parameter is Yo's equivalent of `expr.$` (the per-
//!   expression evaluation annotation). No `ioBuiltin` type marker exists in Yo,
//!   so Io calls are identified structurally by matching `io.await` / `io.async`
//!   dot-access patterns.
//!
//! * `SuspensionPointDetector<AwaitPoint>` (TypeScript generic) → untyped base
//!   `SuspensionPointDetector`. A typed side-channel `HashMap(String, AwaitPointExtra)`
//!   keyed by `expr.token.character` carries the async-specific fields. After
//!   `analyze_suspension_points` returns, the base `SuspensionPoint` list is
//!   zipped with the extras to produce `ArrayList(AwaitPoint)`.
//!
//! * `collectVariableBindings(expr, variables, seen)` → extra `get_info`
//!   parameter; `seen: Set<string>` → `HashMap(String, bool)`.
//!
//! * `dyn(closure)` captures outer variables by reference (C pointer), so
//!   `get_info` can be both captured in `detect_fn` and passed separately to
//!   `analyze_suspension_points` without any ownership conflict.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TokenKind } :: import("../../token.yo");
{ AstExpr, ast_expr_token } :: import("../../expr.yo");
{ ExprInfo } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ Variable, Environment, get_variables_from_env } :: import("../../env.yo");
{
  SuspensionPoint,
  SuspensionCapturedVariable,
  SuspensionAnalysisResult
} :: import("../shared/suspension_analysis_types.yo");
{
  SuspensionPointDetector,
  extract_target_variable_id,
  analyze_suspension_points
} :: import("../shared/suspension_analysis.yo");
{
  CapturedVariableKind,
  AwaitPoint,
  CapturedVariable,
  AwaitAnalysisResult,
  await_analysis_result_empty
} :: import("./await_analysis_types.yo");
{
  extract_future_trait_from_type,
  type_implements_future
} :: import("../trait_checking.yo");
// ---------------------------------------------------------------------------
// AwaitPointExtra — typed side-channel for async-specific fields
// ---------------------------------------------------------------------------
/// Async-specific fields for a single await expression.
/// Stored in a side-channel HashMap keyed by `expr.token.character`
/// because `SuspensionPointDetector` only accepts base `SuspensionPoint` objects.
AwaitPointExtra :: ref(
  struct(
    result_type : TypeValue,
    future_type : Option(TypeValue),
    future_variable_id : Option(String)
  )
);
// ---------------------------------------------------------------------------
// _is_dot_access — structural AST check for `obj.method(...)` calls
// ---------------------------------------------------------------------------
/// Returns true if `expr` is a call of the form `obj_name.method_name(...)`.
///
/// Io builtin calls like `io.await(task, io)` parse as:
///   FnCall(func=FnCall(func=Atom(dot), args=[Atom("io"), Atom("await")],
///                      is_infix=true), args=[Atom("task")])
///
/// This replaces the TypeScript `expr.func.$?.type?.ioBuiltin` marker which
/// is not available in the Yo self-hosted type system.
_is_dot_access :: (fn(expr : AstExpr, obj_name : str, method_name : str) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, outer_func_box, _, _, _) => match(
      outer_func_box,
      .Atom(_, _) => false,
      .FnCall(_, dot_func_box, dot_args, is_infix, _) => cond(
        (is_infix == false) => false,
        (dot_args.len() != usize(2)) => false,
        true => match(
          dot_func_box,
          .FnCall(_, _, _, _, _) => false,
          .Atom(_, dot_tok) => cond(
            (dot_tok.kind != TokenKind.Dot) => false,
            true => {
              obj_ok := match(
                dot_args.get(usize(0)),
                .None => false,
                .Some(oe) => match(
                  oe,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, tok) => (tok.value == obj_name)
                )
              );
              cond(
                (obj_ok == false) => false,
                true => match(
                  dot_args.get(usize(1)),
                  .None => false,
                  .Some(me) => match(
                    me,
                    .FnCall(_, _, _, _, _) => false,
                    .Atom(_, tok) => (tok.value == method_name)
                  )
                )
              )
            }
          )
        )
      )
    )
  )
);
// ---------------------------------------------------------------------------
// Io builtin structural checks
// ---------------------------------------------------------------------------
/// Checks if an expression is an io.async(closure) call.
///
/// Mirrors `isIoAsyncCall` in `src/evaluator/async/await-analysis.ts`.
is_io_async_call :: (fn(expr : AstExpr) -> bool)(
  _is_dot_access(expr, "io", "async")
);
/// Checks if an expression is an io.await(future, io) call.
///
/// Mirrors `isIoAwaitCall` in `src/evaluator/async/await-analysis.ts`.
is_io_await_call :: (fn(expr : AstExpr) -> bool)(
  _is_dot_access(expr, "io", "await")
);
/// Checks if an expression is an io.state(future) call.
///
/// Mirrors `isIoStateCall` in `src/evaluator/async/await-analysis.ts`.
is_io_state_call :: (fn(expr : AstExpr) -> bool)(
  _is_dot_access(expr, "io", "state")
);
/// Checks if an expression is an io.spawn(future) call.
///
/// Mirrors `isIoSpawnCall` in `src/evaluator/async/await-analysis.ts`.
is_io_spawn_call :: (fn(expr : AstExpr) -> bool)(
  _is_dot_access(expr, "io", "spawn")
);
/// Checks if an expression is a JoinHandle.await(io, JoinHandle) call.
/// Structurally: any `x.await(..., x)` where x is NOT "io".
///
/// Mirrors `isJoinHandleAwaitCall` in `src/evaluator/async/await-analysis.ts`.
is_join_handle_await_call :: (fn(expr : AstExpr) -> bool)({
  // Check if this is any X.await(..., X) method call. Match `expr` directly —
  // a read-only structural match does NOT consume it (the sibling
  // `_is_dot_access` matches the same shape without cloning, and `expr` is still
  // used below in `is_io_await_call(expr)`). The previous `expr.clone()` was an
  // unfaithful divergence (TS `isJoinHandleAwaitCall` does no clone) that
  // deep-cloned the whole AST on EVERY generate_func_call — a large allocation
  // source and a suspected trigger for the intermittent RC freelist corruption.
  is_method_await := match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, outer_func_box, _, _, _) => match(
      outer_func_box,
      .Atom(_, _) => false,
      .FnCall(_, dot_func_box, dot_args, is_infix, _) => cond(
        (is_infix == false) => false,
        (dot_args.len() != usize(2)) => false,
        true => match(
          dot_func_box,
          .FnCall(_, _, _, _, _) => false,
          .Atom(_, dot_tok) => cond(
            (dot_tok.kind != TokenKind.Dot) => false,
            true => match(
              dot_args.get(usize(1)),
              .None => false,
              .Some(me) => match(
                me,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, tok) => (tok.value == "await")
              )
            )
          )
        )
      )
    )
  );
  if(!(is_method_await), {
    return(false);
  });
  // Exclude io.await (that's handled by is_io_await_call)
  !(is_io_await_call(expr))
});
// ---------------------------------------------------------------------------
// get_future_variable_id_ — extract the future variable ID from an await arg
// ---------------------------------------------------------------------------
/// If `await_arg` is an identifier that refers to a named future variable,
/// returns the variable ID (or its RC-owner's ID). Otherwise returns None.
///
/// Mirrors the inline variable-lookup logic inside `detect` in the TypeScript.
get_future_variable_id_ :: (
  fn(
    await_arg : AstExpr,
    get_info : Impl(Fn(e : AstExpr) -> Option(ExprInfo))
  ) -> Option(String)
)({
  // Extract the token from the await_arg; must be an Identifier Atom
  await_tok := match(
    await_arg.clone(),
    .FnCall(_, _, _, _, _) => {
      return(Option(String).None);
    },
    .Atom(_, tok) => tok
  );
  if(await_tok.kind != TokenKind.Identifier, {
    return(Option(String).None);
  });
  await_var_name := await_tok.value.clone();
  // Get the expression info to access the environment
  info := match(
    get_info(await_arg),
    .None => {
      return(Option(String).None);
    },
    .Some(i) => i
  );
  vars := get_variables_from_env(info.env, await_var_name.clone());
  n := vars.len();
  if(n == usize(0), {
    return(Option(String).None);
  });
  last_var := match(
    vars.get(n - usize(1)),
    .None => {
      return(Option(String).None);
    },
    .Some(v) => v
  );
  // If the variable shares RC with an owner, return the owner's ID
  match(
    last_var.is_owning_the_same_rc_value_as,
    .Some(owner_box) => Option(String).Some(owner_box.*.id.clone()),
    .None => Option(String).Some(last_var.id.clone())
  )
});
// ---------------------------------------------------------------------------
// detect_await_expr_ — core detection logic for a single await expression
// ---------------------------------------------------------------------------
/// Processes one expression to detect if it is an await point and, if so,
/// pushes a base SuspensionPoint to `points` and stores typed extras in
/// `await_extras` keyed by `expr.token.character.to_string()`.
///
/// Called from the `detect_fn` dyn closure inside `analyze_await_points`.
detect_await_expr_ :: (
  fn(
    expr : AstExpr,
    parent_expr : Option(AstExpr),
    points : ArrayList(SuspensionPoint),
    await_extras : HashMap(String, AwaitPointExtra),
    get_info : Impl(Fn(e : AstExpr) -> Option(ExprInfo))
  ) -> unit
)({
  if(!(is_io_await_call(expr.clone())), {
    return(());
  });
  // Pre-clone expr for the SuspensionPoint before the consuming match below
  expr_for_sp := expr.clone();
  match(
    expr,
    .Atom(_, _) => (),
    // unreachable: is_io_await_call already confirmed FnCall
    .FnCall(_, _, args, _, tok) => {
      // Get the first argument (the future being awaited)
      await_arg := match(
        args.get(usize(0)),
        .None => {
          return(());
        },
        .Some(a) => a
      );
      // Get expression info for the await argument to read its type
      await_info := match(
        get_info(await_arg.clone()),
        .None => {
          return(());
        },
        .Some(i) => i
      );
      // The argument's type must implement the Future trait
      future_type_val := await_info.ty.clone();
      if(!(type_implements_future(future_type_val.clone())), {
        return(());
      });
      // Extract the concrete FutureTrait type from the bound
      future_module_type := match(
        extract_future_trait_from_type(future_type_val.clone()),
        .None => {
          return(());
        },
        .Some(t) => t
      );
      // Extract the result type T from FutureTraitT(output: Box(T))
      result_type := match(
        future_module_type.clone(),
        .FutureTraitT(output : output_box) => output_box,
        _ => {
          return(());
        } // unreachable: we just verified FutureTraitT
      );
      // Get the variable ID of the future being awaited (for state machine fields)
      future_variable_id := get_future_variable_id_(await_arg.clone(), get_info);
      // Get the target variable ID from the parent := assignment, if any
      target_variable_id := extract_target_variable_id(parent_expr.clone(), get_info);
      // Store async-specific extras in the side-channel, keyed by token position
      expr_char_key := tok.character.to_string();
      await_extras.set(
        expr_char_key.clone(),
        AwaitPointExtra(
          result_type : result_type.clone(),
          future_type : Option(TypeValue).Some(future_module_type),
          future_variable_id : future_variable_id
        )
      );
      // Push the base suspension point (walk_expr_ will fill in structural fields)
      sp := SuspensionPoint(
        index : points.len(),
        expr : expr_for_sp,
        target_variable_id : target_variable_id,
        is_inside_cond : Option(bool).None,
        is_inside_while : Option(bool).None,
        while_nesting_depth : Option(usize).None,
        cond_branch_source_index : Option(usize).None,
        needs_own_cond_branch_field : Option(bool).None,
        enclosing_while_expr : Option(AstExpr).None
      );
      points.push(sp);
    }
  );
});
// ---------------------------------------------------------------------------
// analyze_await_points
// ---------------------------------------------------------------------------
/// Analyzes an async function body to find all await expressions.
///
/// Mirrors `analyzeAwaitPoints` in `src/evaluator/async/await-analysis.ts`.
///
/// The extra `get_info` parameter provides per-expression type/env information
/// (Yo's equivalent of TypeScript's `expr.$`).
analyze_await_points :: (
  fn(
    body : AstExpr,
    get_info : Impl(Fn(e : AstExpr) -> Option(ExprInfo))
  ) -> AwaitAnalysisResult
)({
  // Side-channel: stores async-specific fields for each await suspension point
  await_extras := HashMap(String, AwaitPointExtra).new();
  result := analyze_suspension_points(
    body.clone(),
    get_info,
    SuspensionPointDetector(
      detect : dyn((expr, parent_expr, points) => {
        detect_await_expr_(expr, parent_expr, points, await_extras, get_info);
      }),
      should_skip_body : dyn((expr) => is_io_async_call(expr))
    )
  );
  // Reconstruct typed AwaitPoint list from base suspension points + side-channel extras
  await_points := ArrayList(AwaitPoint).new();
  n_pts := result.suspension_points.len();
  (pi : usize) = usize(0);
  while(pi < n_pts, {
    sp := match(
      result.suspension_points.get(pi),
      .None => {
        break;
      },
      .Some(p) => p
    );
    expr_char_key := ast_expr_token(sp.expr.clone()).character.to_string();
    match(
      await_extras.get(expr_char_key.clone()),
      .None => (),
      // should not happen: every SP was registered via detect_await_expr_
      .Some(extra) => {
        ap := AwaitPoint(
          base : sp,
          result_type : extra.result_type,
          future_type : extra.future_type,
          future_variable_id : extra.future_variable_id
        );
        await_points.push(ap);
      }
    );
    pi = (pi + usize(1));
  });
  // Map shared captured variables to CapturedVariable (adding kind: Local)
  captured_variables := ArrayList(CapturedVariable).new();
  n_cv := result.captured_variables.len();
  (ci : usize) = usize(0);
  while(ci < n_cv, {
    sv := match(
      result.captured_variables.get(ci),
      .None => {
        break;
      },
      .Some(v) => v
    );
    cv := CapturedVariable(
      base : sv,
      kind : CapturedVariableKind.Local,
      is_owning_the_same_rc_value_as : Option(Box(CapturedVariable)).None
    );
    captured_variables.push(cv);
    ci = (ci + usize(1));
  });
  AwaitAnalysisResult(
    await_points : await_points,
    captured_variables : captured_variables,
    has_awaits : result.has_suspensions,
    variable_id_remapping : result.variable_id_remapping
  )
});
// ---------------------------------------------------------------------------
// collect_variable_bindings_ — recursive variable declaration collector
// ---------------------------------------------------------------------------
/// Recursively collects variable binding declarations from an expression.
/// Used by `get_local_variables_from_body` to discover all locals for
/// async state machine generation.
///
/// Mirrors `collectVariableBindings` in `src/evaluator/async/await-analysis.ts`.
///
/// Note: does NOT use early `return` for the binding check — control must
/// always reach the recursive calls at the bottom of the FnCall arm.
collect_variable_bindings_ :: (
  fn(
    expr : AstExpr,
    variables : ArrayList(CapturedVariable),
    seen : HashMap(String, bool),
    get_info : Impl(Fn(e : AstExpr) -> Option(ExprInfo))
  ) -> unit
)(
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, func_box, args, _, _) => {
      // Check if this is a "let" or ":=" binding declaration
      func_is_binding := match(
        func_box,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, ftok) => (
          (ftok.value == "let") || (ftok.value == ":=")
        )
      );
      if(func_is_binding && (args.len() >= usize(2)), {
        name_arg_opt := args.get(usize(0));
        match(
          name_arg_opt,
          .None => (),
          .Some(name_arg) => {
            // name_arg must be an Identifier Atom with expression info
            match(
              name_arg.clone(),
              .FnCall(_, _, _, _, _) => (),
              .Atom(_, name_tok) => {
                if(name_tok.kind == TokenKind.Identifier, {
                  var_name := name_tok.value.clone();
                  // Get the type from the second argument (the value being bound)
                  match(
                    args.get(usize(1)),
                    .None => (),
                    .Some(val_arg) => {
                      match(
                        get_info(val_arg.clone()),
                        .None => (),
                        .Some(val_info) => {
                          var_type := val_info.ty.clone();
                          // Look up the variable in the name_arg's environment
                          match(
                            get_info(name_arg),
                            .None => (),
                            .Some(name_info) => {
                              vars := get_variables_from_env(
                                name_info.env,
                                var_name.clone()
                              );
                              n_vars := vars.len();
                              if(n_vars > usize(0), {
                                match(
                                  vars.get(n_vars - usize(1)),
                                  .None => (),
                                  .Some(variable) => {
                                    match(
                                      variable.is_owning_the_same_rc_value_as,
                                      .Some(_) => (),
                                      .None => {
                                        if(!(variable.is_compile_time_only) &&
                                          !(seen.contains_key(variable.id.clone())), {
                                          cv := CapturedVariable(
                                            base : SuspensionCapturedVariable(
                                              id : variable.id.clone(),
                                              name : var_name.clone(),
                                              ty : var_type.clone(),
                                              is_owning_the_same_rc_value_as :
                                                Option(Box(SuspensionCapturedVariable)).None
                                            ),
                                            kind : CapturedVariableKind.Local,
                                            is_owning_the_same_rc_value_as :
                                              Option(Box(CapturedVariable)).None
                                          );
                                          variables.push(cv);
                                          seen.set(variable.id.clone(), true);
                                        });
                                      }
                                    );
                                  }
                                );
                              });
                            }
                          );
                        }
                      );
                    }
                  );
                });
              }
            );
          }
        );
      });
      // Always recurse into the function expression
      recur(func_box, variables, seen, get_info);
      // Always recurse into each argument
      n_args := args.len();
      (ai : usize) = usize(0);
      while(ai < n_args, {
        arg := match(
          args.get(ai),
          .None => {
            break;
          },
          .Some(a) => a
        );
        recur(arg, variables, seen, get_info);
        ai = (ai + usize(1));
      });
    }
  )
);
// ---------------------------------------------------------------------------
// get_local_variables_from_body
// ---------------------------------------------------------------------------
/// Gets the local variable declarations from a function body.
/// Used by async codegen to determine which variables need state-machine fields.
///
/// Mirrors `getLocalVariablesFromBody` in `src/evaluator/async/await-analysis.ts`.
get_local_variables_from_body :: (
  fn(
    body : AstExpr,
    get_info : Impl(Fn(e : AstExpr) -> Option(ExprInfo))
  ) -> ArrayList(CapturedVariable)
)({
  variables := ArrayList(CapturedVariable).new();
  seen := HashMap(String, bool).new();
  collect_variable_bindings_(body, variables, seen, get_info);
  variables
});
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Closure await-analysis side-table (func_id → AwaitAnalysisResult)
// ---------------------------------------------------------------------------
/// The await analysis for an io.async closure, keyed by the closure's `func_id`.
/// yo-self records `await_analysis` on the def-evaluated body CLONE (an
/// inaccessible expr distinct from the FuncVal body and from the codegen-read
/// clone), so the codegen cannot reach it via ExprInfo. The closure's `func_id`,
/// however, IS what codegen resolves (via the closure value's FuncVal), so the
/// analysis is side-tabled by func_id — the same eval→codegen bridge pattern as
/// `g_some_resolved_concrete`. Set in `evaluate_anonymous_function_implementation`
/// for marked io.async closures with awaits; read by the async dispatch +
/// `generate_async_block` + `preregister_async_blocks_in_expr`.
(g_closure_await_analysis : HashMap(String, AwaitAnalysisResult)) = HashMap(String, AwaitAnalysisResult).new();
/// Register a closure's await analysis by func_id (only when it has awaits).
register_closure_await_analysis :: (fn(func_id : String, result : AwaitAnalysisResult) -> unit)({
  g_closure_await_analysis.set(func_id.clone(), result);
});
/// The await analysis recorded for `func_id`, if any.
get_closure_await_analysis :: (fn(func_id : String) -> Option(AwaitAnalysisResult))(
  g_closure_await_analysis.get(func_id.clone())
);
export(
  // Types (re-exported for convenience — canonical home is await_analysis_types.yo)
  AwaitPointExtra,
  register_closure_await_analysis,
  get_closure_await_analysis,
  // Future-trait helpers
  extract_future_trait_from_type,
  type_implements_future,
  // Io call structural checks
  is_io_async_call,
  is_io_await_call,
  is_io_state_call,
  is_io_spawn_call,
  is_join_handle_await_call,
  // Main analysis entry points
  analyze_await_points,
  get_local_variables_from_body
);
