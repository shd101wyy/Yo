//! Type definitions for await analysis.
//!
//! Mirrors `src/evaluator/async/await-analysis-types.ts` — 1:1 port.
//!
//! `AwaitPoint` extends `SuspensionPoint` with async-specific fields.
//! `CapturedVariable` extends `SuspensionCapturedVariable` with a `kind` discriminator
//! and an async-typed self-referential `is_owning_the_same_rc_value_as` override.
//! `AwaitAnalysisResult` aggregates all await information for one async block.
//!
//! Key design decisions vs the TypeScript source:
//!
//! * TypeScript `extends` → embed base type as a `base` field (Yo has no interface inheritance).
//! * `kind: "local" | "outer"` → `CapturedVariableKind` enum.
//! * `isOwningTheSameRcValueAs: CapturedVariable | undefined` override →
//!   `is_owning_the_same_rc_value_as: Option(Box(Self))` using `Box(Self)`.
//! * `Map<string, string>` → `HashMap(String, String)`.
//! * `Type[]` → `TypeValue` (single element fields stay as `TypeValue`).
//! * Optional fields (`field?: T`) → `Option(T)`.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("../../types/definitions.yo");
{
  SuspensionPoint,
  SuspensionCapturedVariable
} :: import("../shared/suspension_analysis_types.yo");
// ---------------------------------------------------------------------------
// CapturedVariableKind
// ---------------------------------------------------------------------------
/// Discriminator for the kind of variable being captured.
///
/// Mirrors the `kind: "local" | "outer"` discriminated union field in TypeScript.
CapturedVariableKind :: enum(
  /// A variable defined in the async function body (uses `var_{id}` field naming).
  Local,
  /// A variable captured from outer scope (uses variable name as field name).
  Outer
);
// ---------------------------------------------------------------------------
// AwaitPoint
// ---------------------------------------------------------------------------
/// Information about a single await expression found in an async function.
/// Embeds `SuspensionPoint` as a `base` field (TypeScript: extends SuspensionPoint).
///
/// Mirrors `AwaitPoint` in `src/evaluator/async/await-analysis-types.ts`.
AwaitPoint :: ref(
  struct(
    /// Shared suspension-point fields (index, expr, target_variable_id, …).
    base : SuspensionPoint,
    /// The type of the value being awaited (the T in Future(T)).
    result_type : TypeValue,
    /// The full Future type being awaited (Impl Future(T) or similar).
    /// Stored to help codegen determine the correct C type for `await_future_X` fields.
    future_type : Option(TypeValue),
    /// The variable ID of the Future being awaited.
    /// Used to reference the captured Future variable instead of creating a separate
    /// `await_future_X` field.
    future_variable_id : Option(String)
  )
);
// ---------------------------------------------------------------------------
// CapturedVariable
// ---------------------------------------------------------------------------
/// Information about a local variable that needs to persist across await points.
/// TypeScript: `CapturedVariable extends SuspensionCapturedVariable`.
///
/// Yo: embeds the base fields in `base` and adds async-specific fields.
/// The self-referential `isOwningTheSameRcValueAs: CapturedVariable | undefined`
/// is overridden with the async-typed version.
CapturedVariable :: ref(
  struct(
    /// Shared captured-variable fields (id, name, ty).
    base : SuspensionCapturedVariable,
    /// The kind of variable being captured (local or outer-scope).
    kind : CapturedVariableKind,
    /// Async-typed self-referential override for `isOwningTheSameRcValueAs`.
    /// Uses `Box(Self)` to break the recursive value-type cycle.
    is_owning_the_same_rc_value_as : Option(Box(Self))
  )
);
// ---------------------------------------------------------------------------
// AwaitAnalysisResult
// ---------------------------------------------------------------------------
/// Result of analyzing an async function for await points.
///
/// Mirrors `AwaitAnalysisResult` in `src/evaluator/async/await-analysis-types.ts`.
AwaitAnalysisResult :: ref(
  struct(
    /// All await points found in the function, in order of appearance.
    await_points : ArrayList(AwaitPoint),
    /// All local variables that need to be captured in the state machine.
    captured_variables : ArrayList(CapturedVariable),
    /// Whether this function contains any await expressions.
    has_awaits : bool,
    /// Maps SSA-renamed variable IDs to their original/canonical IDs.
    /// Allows codegen to resolve all versions of a variable to the same state machine field.
    variable_id_remapping : HashMap(String, String)
  )
);
// ---------------------------------------------------------------------------
// Constructor helpers
// ---------------------------------------------------------------------------
/// Create an empty AwaitAnalysisResult (no await points found).
await_analysis_result_empty :: (fn() -> AwaitAnalysisResult)(
  AwaitAnalysisResult(
    await_points : ArrayList(AwaitPoint).new(),
    captured_variables : ArrayList(CapturedVariable).new(),
    has_awaits : false,
    variable_id_remapping : HashMap(String, String).new()
  )
);
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(
  CapturedVariableKind,
  AwaitPoint,
  CapturedVariable,
  AwaitAnalysisResult,
  await_analysis_result_empty
);
