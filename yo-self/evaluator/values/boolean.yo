//! evaluate_boolean_literal — evaluates boolean literal expressions (`true`, `false`).
//!
//! 1:1 port of `src/evaluator/values/boolean.ts`.
open(import("std/string"));
open(import("std/fmt"));
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_set } :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TokenKind } :: import("../../token.yo");
{ t_bool } :: import("../../types/creators.yo");
{ Exception } :: import("std/error");
{ format_error_message } :: import("../../error.yo");
evaluate_boolean_literal :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  tok := ast_expr_token(expr);
  if(!(tok.kind == TokenKind.Bool), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          `Expected bool literal, got ${tok.value}`,
          false,
          .None
        )
      )
    );
  });
  b := (tok.value == "true");
  val := EvalValue.BoolVal(b);
  info := new_expr_info(env, t_bool());
  info.value =.Some(val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
export(evaluate_boolean_literal);
