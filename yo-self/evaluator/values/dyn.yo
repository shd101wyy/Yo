//! evaluate_dyn_value — evaluates `dyn` coercion expressions.
//!
//! 1:1 port of `src/evaluator/values/dyn.ts`.
//!
//! Phase 3 implementation:
//!   - Handles `SomeT` (Impl) and `DynT` value types.
//!   - Infers the DynType from the evaluated value type or from context.
//!   - Auto-boxes non-object values by synthesising a `inner` call.
//!   - Concrete `.trait` field access is NOT available in yo-self; only
//!     SomeT, DynT, and expected-DynType-from-context are supported.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment, synthetic_token } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx, ArgEntry, ArgValues, VarArgEntry } :: import("../context.yo");
{ EvalValue, is_func_val } :: import("../../value.yo");
{ get_func_type } :: import("../../function_value.yo");
{ create_specialized_function_inline } :: import("../calls/helper.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, generate_some_type_id } :: import("../../types/creators.yo");
{ is_dyn_type, is_some_type, is_reference_struct_type, is_boxed_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ attach_temp_variable_to_expr } :: import("../utils.yo");
{ get_type_trait_methods_for_type, type_id_or_empty, get_trait_default } :: import("./type_trait_methods.yo");
{ Exception } :: import("std/error");
/// Build the ordered TraitVal evidence for a DynType over a concrete value
/// type, resolving each trait method to the concrete type's registered impl
/// FuncVal (yo-self's type_trait_methods registry stands in for TS's
/// `concreteType.trait.fields` with assignedValue FuncVals). C codegen's vtable
/// wrappers read these FuncVals to dispatch; a field with no registered method
/// falls back to None. Shared by both the executing and non-executing paths so
/// codegen has the evidence regardless of the mode the body was evaluated in.
/// For a BOXED dyn payload (`Box(Sq)`), return the box's underlying value type
/// (`Sq`, its single `*` field) so trait methods resolve on the concrete type the
/// impl is registered against; non-boxed passes through. The codegen wrapper's
/// is_boxed branch then unboxes `Box* -> &box->*` at the call. Requires the box's
/// `Box(...)` name (stamped in comptime_fn.yo) so is_boxed_type recognises it.
_unwrap_box_for_method_lookup :: (fn(t : TypeValue) -> TypeValue)({
  (result : TypeValue) = t;
  if(is_boxed_type(t), {
    match(
      t,
      .Struct({ field_types : fts }) => match(
        fts.get(usize(0)),
        .Some(ut) => {
          result = ut;
        },
        .None => ()
      ),
      _ => ()
    );
  });
  result
});
_resolve_dyn_trait_values :: (fn(dyn_type : TypeValue, value_type : TypeValue, ctx : EvalContext, caller_env : Environment, exn : Exception) -> ArrayList(EvalValue))({
  trait_vals := ArrayList(EvalValue).new();
  // Resolve trait methods on the UNDERLYING type when the payload is a Box.
  method_lookup_type := _unwrap_box_for_method_lookup(value_type);
  match(
    dyn_type,
    .DynT(required_trait_types : rtt) => {
      n := rtt.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          rtt.get(i),
          .Some(tt) => match(
            tt,
            .TraitT(name : tname, field_labels : fl, id : trait_id) => {
              entries := get_type_trait_methods_for_type(type_id_or_empty(method_lookup_type));
              n_fields := fl.len();
              field_names := ArrayList(String).new();
              field_vals := ArrayList(Option(EvalValue)).new();
              (j : usize) = usize(0);
              while(j < n_fields, {
                fname := match(fl.get(j),.Some(s) => s,.None => String.from(""));
                field_names.push(fname.clone());
                // Prefer an entry matching BOTH label and trait id; fall back to
                // a label-only match (the Dyn(Trait) annotation's trait id can
                // differ from the impl's source_trait_id across trait-type
                // instantiations). Read entry.value at most ONCE per entry —
                // Option(EvalValue) reads MOVE (EvalValue holds reference-
                // semantics members), so a double read is use-after-move (SIGBUS).
                (exact : Option(EvalValue)) = Option(EvalValue).None;
                (by_label : Option(EvalValue)) = Option(EvalValue).None;
                (have_exact : bool) = false;
                ne := entries.len();
                (k : usize) = usize(0);
                while((k < ne) && !(have_exact), {
                  match(
                    entries.get(k),
                    .Some(entry) => if(entry.label == fname, {
                      is_exact := (entry.source_trait_id == trait_id);
                      ev := entry.value;
                      if(is_exact, {
                        exact = ev;
                        have_exact = true;
                      }, {
                        by_label = ev;
                      });
                    }),
                    .None => ()
                  );
                  k = (k + usize(1));
                });
                // Fall back to the trait's `?=` DEFAULT method when the concrete
                // type implements the trait WITHOUT overriding this method (e.g.
                // `Error.source ?= (self) -> .None` for a LexerError that omits
                // `source`). The registered default is GENERIC over `Self`, so it
                // must be MONOMORPHIZED to the concrete receiver: codegen would
                // otherwise skip its generic body (undeclared wrapper) and the
                // `Self`-bearing return type would mismatch the vtable slot. Route
                // it through create_specialized_function_inline with `self :
                // value_type` (ctx.self_type set so `Self` in the body/return
                // resolves to the receiver), producing a concrete, collectable
                // FuncVal. Falls back to the raw default if specialization is not
                // possible.
                resolved_field := match(
                  exact,
                  .Some(v) => Option(EvalValue).Some(v),
                  .None => match(
                    by_label,
                    .Some(bv) => Option(EvalValue).Some(bv),
                    .None => match(
                      get_trait_default(trait_id.clone(), fname.clone()),
                      .Some(default_fv) => if(is_func_val(default_fv), {
                        default_fid := match(default_fv,.FuncVal(__fvd1, _) => __fvd1.*.func_id, _ => String.new());
                        default_ft := get_func_type(default_fid.clone());
                        self_args := ArrayList(ArgEntry).new();
                        _sa := self_args.push(ArgEntry(value : Option(EvalValue).None, parameter_type : value_type.clone(), arg_type : value_type.clone()));
                        spec_argvals := ArgValues(
                          forall_args : ArrayList(ArgEntry).new(),
                          args : self_args,
                          implicit_args : Option(ArrayList(ArgEntry)).None,
                          variadic_args : ArrayList(VarArgEntry).new()
                        );
                        saved_self_ty := ctx.self_type;
                        ctx.self_type = Option(TypeValue).Some(value_type.clone());
                        spec_fv := create_specialized_function_inline(default_fv, default_ft, spec_argvals, caller_env, caller_env, ctx, exn);
                        ctx.self_type = saved_self_ty;
                        Option(EvalValue).Some(spec_fv)
                      }, Option(EvalValue).Some(default_fv)),
                      .None => Option(EvalValue).None
                    )
                  )
                );
                field_vals.push(resolved_field);
                j = (j + usize(1));
              });
              trait_vals.push(EvalValue.TraitVal(tname, field_names, field_vals));
              ()
            },
            _ => ()
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  trait_vals
});
evaluate_dyn_value :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  expr_tok := ast_expr_token(expr);
  // Extract the args ArrayList and the single value argument.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            expr_tok,
            String.from("evaluate_dyn_value: expected a FnCall expression"),
            false,
            .None
          )
        )
      );
      return(expr);
    }
  );
  value_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            expr_tok,
            String.from("'dyn' requires exactly one argument"),
            false,
            .None
          )
        )
      );
      return(expr);
    }
  );
  // Expected-type for the INNER value expression. The dyn target itself
  // must NOT flow down as the inner's expected type: the inner is a
  // concrete value being coerced into the dyn, so matching its type
  // against the dyn (e.g. `"x".to_string()`'s `String` return vs
  // `dyn(Error)`) wrongly reaches `synthesize_types` and tag-mismatches.
  // Mirrors TS `evaluateDynValue`: when the outer expected type is a Dyn,
  // evaluate the inner with a fresh `SomeT` carrying the Dyn's required /
  // negative traits (a type variable, which `synthesize` binds to the
  // concrete value and checks the trait constraints against); otherwise
  // clear the expected type entirely.
  (inner_expected : Option(ExpectedTypeCtx)) = match(
    ctx.expected_type,
    .Some(et) => match(
      et.ty,
      .DynT(
        required_trait_types : rtt,
        required_trait_levels : rtl,
        negative_trait_types : ntt,
        negative_trait_levels : ntl
      ) =>
        Option(ExpectedTypeCtx).Some(
          ExpectedTypeCtx(
            ty : TypeValue.SomeT(
              generate_some_type_id(),
              String.from(""),
              env.frames.len(),
              TypeValue.TypeUni(usize(0)),
              rtt,
              rtl,
              ntt,
              ntl,
              false,
              Option(TypeValue).None
            ),
            env : et.env
          )
        ),
      _ => Option(ExpectedTypeCtx).None
    ),
    .None => Option(ExpectedTypeCtx).None
  );
  // Non-executing path: still type-check the inner expression, then return early.
  if(ctx.is_validating_function_definition || !(ctx.is_executing), {
    saved_et_ne := ctx.expected_type;
    ctx.expected_type = inner_expected;
    inner_ne := evaluate_expression(value_arg, env, ctx);
    ctx.expected_type = saved_et_ne;
    (ret_type : TypeValue) = match(
      ctx.expected_type,
      .Some(et) => et.ty,
      .None => TypeValue.DynT(
        required_trait_types : ArrayList(TypeValue).new(),
        required_trait_levels : ArrayList(usize).new(),
        negative_trait_types : ArrayList(TypeValue).new(),
        negative_trait_levels : ArrayList(usize).new()
      )
    );
    out_info := new_expr_info(env, ret_type.clone());
    // Even in validating mode, resolve the trait evidence from the registry so
    // C codegen (which reads body ExprInfo produced in THIS mode — yo-self
    // evaluates fn bodies in validating mode) has the vtable FuncVals. The
    // resolution is structural (registry lookup), not execution-dependent.
    ne_value_type := match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(inner_ne)),.Some(ii) => ii.ty,.None => t_unit());
    if(is_dyn_type(ret_type.clone()), {
      out_info.dyn_call_trait_values =.Some(_resolve_dyn_trait_values(ret_type, ne_value_type, ctx, env, exn));
    });
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    // Attach the temp variable C codegen reads for the fat-pointer struct.
    attach_temp_variable_to_expr(expr, true, ctx);
    return(expr);
  });
  // --- Executing path ---
  // Evaluate the inner expression (with the inner-expected computed above).
  saved_et_ex := ctx.expected_type;
  ctx.expected_type = inner_expected;
  eval_inner := evaluate_expression(value_arg, env, ctx);
  ctx.expected_type = saved_et_ex;
  inner_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_inner));
  inner_info := match(
    inner_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            expr_tok,
            String.from("evaluate_dyn_value: failed to evaluate inner expression"),
            false,
            .None
          )
        )
      );
      return(expr);
    }
  );
  (value_type : TypeValue) = inner_info.ty;
  (cur_env : Environment) = inner_info.env;
  (final_value_type : TypeValue) = value_type;
  // Auto-box non-object, non-dyn values (mirrors TypeScript lines 251-310).
  // Note: Future-implementing SomeType check (typeImplementsFuture) is omitted
  // in Phase 3 — all non-object, non-dyn values are wrapped in box().
  if(!(is_reference_struct_type(value_type)) && !(is_dyn_type(value_type)), {
    box_tok := synthetic_token(String.from("box"), cur_env.module_path);
    box_atom := AstExpr.Atom(usize(0), box_tok);
    box_args := ArrayList(AstExpr).new();
    box_args.push(eval_inner);
    box_call := AstExpr.FnCall(usize(0), box_atom, box_args, false, expr_tok);
    boxed_expr := evaluate_expression(box_call, cur_env, ctx);
    boxed_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(boxed_expr));
    match(
      boxed_info_opt,
      .Some(bi) => {
        // Update the dyn(...) call's first arg to point at the boxed expression,
        // so that C codegen sees inner rather than the bare inner expression.
        args(usize(0)) = boxed_expr;
        final_value_type = bi.ty;
        cur_env = bi.env;
      },
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              expr_tok,
              String.from("evaluate_dyn_value: failed to auto-box value for 'dyn'"),
              false,
              .None
            )
          )
        );
      }
    );
  });
  // Determine the expected DynType:
  //   1. From context.expected_type when it is already a DynT.
  //   2. From final_value_type when it is a DynT.
  //   3. From final_value_type when it is a SomeT — build DynT from its traits.
  //   4. Otherwise: unsupported in Phase 3 (concrete `.trait` not available).
  expected_dyn_from_ctx := match(
    ctx.expected_type,
    .Some(et) => match(
      et.ty,
      .DynT(
        required_trait_types : rtt,
        required_trait_levels : rtl,
        negative_trait_types : ntt,
        negative_trait_levels : ntl
      ) =>
        Option(TypeValue).Some(
          TypeValue.DynT(
            required_trait_types : rtt,
            required_trait_levels : rtl,
            negative_trait_types : ntt,
            negative_trait_levels : ntl
          )
        ),
      _ => Option(TypeValue).None
    ),
    .None => Option(TypeValue).None
  );
  dyn_type := match(
    expected_dyn_from_ctx,
    .Some(dt) => dt,
    .None => match(
      final_value_type,
      .DynT(
        required_trait_types : rtt,
        required_trait_levels : rtl,
        negative_trait_types : ntt,
        negative_trait_levels : ntl
      ) =>
        TypeValue.DynT(
          required_trait_types : rtt,
          required_trait_levels : rtl,
          negative_trait_types : ntt,
          negative_trait_levels : ntl
        ),
      .SomeT(
        required_trait_types : rtt,
        required_trait_levels : rtl,
        negative_trait_types : ntt,
        negative_trait_levels : ntl
      ) =>
        TypeValue.DynT(
          required_trait_types : rtt,
          required_trait_levels : rtl,
          negative_trait_types : ntt,
          negative_trait_levels : ntl
        ),
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              expr_tok,
              String.from("'dyn' requires a SomeType (Impl), DynType, or an expected Dyn type context. Concrete types without trait fields are not supported in Phase 3."),
              false,
              .None
            )
          )
        );
        TypeValue.DynT(
          required_trait_types : ArrayList(TypeValue).new(),
          required_trait_levels : ArrayList(usize).new(),
          negative_trait_types : ArrayList(TypeValue).new(),
          negative_trait_levels : ArrayList(usize).new()
        )
      }
    )
  );
  // Collect a TraitVal for each required trait, resolving the concrete type's
  // registered impl methods (the registry-based stand-in for TS's
  // `concreteType.trait.fields`). Resolved on the pre-box concrete type.
  trait_vals := _resolve_dyn_trait_values(dyn_type.clone(), value_type, ctx, cur_env, exn);
  // Annotate the outer dyn(...) expression with the resolved DynType and
  // the ordered trait values for C codegen vtable emission.
  out_info := new_expr_info(cur_env, dyn_type);
  out_info.dyn_call_trait_values =.Some(trait_vals);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  // Attach the temp variable C codegen reads for the fat-pointer struct
  // (mirrors TS attachTempVariableToExpr(expr, true), dyn.ts:594).
  attach_temp_variable_to_expr(expr, true, ctx);
  expr
});
export(evaluate_dyn_value);
