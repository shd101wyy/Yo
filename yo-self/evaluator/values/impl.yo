export(GenericImplEntry, MethodCandidate);
export(TypeImplementsTraitFn);
export(set_type_implements_trait_fn, set_register_trait_value_fn, get_trait_key);
export(register_generic_impl);
export(register_negative_generic_impl, find_matching_negative_generic_impl);
export(try_match_generic_impl);
export(find_matching_generic_impl);
export(find_methods_from_generic_impls);
export(is_concrete_impl_being_registered);
export(mark_concrete_impl_being_registered);
export(unmark_concrete_impl_being_registered);
export(has_negative_impl);
