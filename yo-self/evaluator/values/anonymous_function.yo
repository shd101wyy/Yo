//! evaluate_anonymous_function_implementation — evaluates anonymous function literals.
//!
//! Phase 3 implementation — port of `src/evaluator/values/anonymous-function.ts`.
//!
//! Handles:
//!   `(params) -> body`   — regular anonymous function (expected type must be Func)
//!   `(params) => body`   — closure (expected type must be SomeT or FnTraitT with Fn trait)
//!   `(params) =>> body`  — async closure (like `=>` but marks io.async context)
//!
//! Definition-time body evaluation IS ported (the closure-body def-eval
//! wall, mirrors anonymous-function.ts:766-852): non-generic bodies evaluate
//! at definition time under a function-body context (captured_variables
//! populated via track_variable_usage), guarded by the capture-free trial
//! swallow. Post-eval gates: regular-fn-no-capture (ts:867), §4 rule 1
//! unwind-needs-ctl (ts:894), Phase B ref-capture + control-bound-capture
//! rejection (ts:1078-1110).
//!
//! Phase 3 simplifications (vs full TypeScript port):
//!   - substituteSomeTypesFromEnv skipped
//!   - analyzeCtfeCapability skipped
//!   - await analysis skipped
//!   - Effect row spread expansion skipped (uses existing implicit params as-is)
//!   - checkDeferredGenericReturnType skipped for deferred (generic) bodies
//!   - return-type-vs-body compatibility check skipped (would over-fire on
//!     def-eval porting gaps; the swallow philosophy admits only
//!     deliberately-gated rejections)
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  make_err_expr,
  ast_expr_to_string,
  wrap_body_in_begin,
  BK_TUPLE
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  has_control_flow
} :: import("../../expr_info.yo");
{ are_types_compatible_exact } :: import("../../types/compatibility.yo");
{
  copy_func_param_defaults,
  copy_func_param_default_exprs,
  copy_func_param_type_exprs,
  copy_func_param_comptime,
  copy_func_param_assigned_values,
  copy_func_return_type_expr,
  copy_func_variadic_param,
  copy_macro_registration,
  copy_func_where_constraints,
  copy_func_contract_exprs
} :: import("../types/function.yo");
{ analyze_await_points, register_closure_await_analysis } :: import("../async/await_analysis.yo");
{ AwaitAnalysisResult } :: import("../async/await_analysis_types.yo");
{
  Environment,
  add_variable_to_env,
  synthetic_token,
  snapshot_env,
  get_variables_from_env
} :: import("../../env.yo");
{ Token } :: import("../../token.yo");
{ TypeValue, FuncMeta } :: import("../../types/definitions.yo");
{ t_unit, t_some_t, t_func_simple, t_resolved_cell, t_ptr, generate_some_type_id } :: import("../../types/creators.yo");
{
  EvalValue,
  FuncValData,
  create_unknown_val
} :: import("../../value.yo");
{
  EvalContext,
  CapturedVarInfo,
  ExpectedTypeCtx
} :: import("../context.yo");
{ random_id } :: import("../../utils.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{
  register_definition_site_return,
  register_closure_body_type,
  register_func_type,
  mark_as_closure_fn,
  ClosureCaptureInfo,
  register_closure_capture_info,
  get_closure_capture_info,
  register_closure_fid_source,
  mark_fn_unemittable
} :: import("../../function_value.yo");
{
  enrich_captured_variables,
  generate_captured_variable_dup_expressions,
  create_capture_type_and_value,
  FuncCapturedVarInfo
} :: import("../utils/closure.yo");
{ extract_fn_trait_from_type } :: import("../trait_checking.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ create_function_body_evaluation_context } :: import("../calls/function_type.yo");
{ evaluated_body_contains_unwind } :: import("../../expr_traversal.yo");
{ get_all_some_types, type_is_control_bound } :: import("../../types/utils.yo");
{ is_some_type, is_unit_type, is_comptime_string_type, is_comptime_int_type, is_comptime_float_type, is_fn_trait_type } :: import("../../types/guards.yo");
{ type_to_string } :: import("../../types/string.yo");
{ synthesize_types, SynthesizeOptions, TypePair } :: import("../types/synthesizer.yo");
{
  clear_flow_violation,
  flow_violation_pending,
  flow_violation_message,
  propagate_def_time_errors
} :: import("../../types/flowability.yo");
/// Walk a parameter-declaration AST (`(a, b)` tuple or single atom)
/// and append each param-name token-value to `out`. Used to
/// synthesize a default Func type when no `expected_type` is in
/// context (e.g. impl field whose surrounding trait is a parametric
/// trait the bootstrap can't yet evaluate).
_collect_anon_param_names :: (
  fn(param_decl : AstExpr, out : ArrayList(String)) -> unit
)(
  match(
    param_decl,
    .Atom(_, t) => {
      out.push(t.value.clone());
    },
    .FnCall(_, fb, args, _, _) => match(
      fb,
      .Atom(_, ptok) => cond(
        (ptok.value == BK_TUPLE) => {
          (i : usize) = usize(0);
          n := args.len();
          while(i < n, {
            match(
              args.get(i),
              .Some(a) => match(
                a,
                .Atom(_, at) => {
                  out.push(at.value.clone());
                },
                .FnCall(_, _, _, _, _) => {
                  // Best-effort: use the first atom of the call (e.g.
                  // `name : Type` → token "name") if present.
                  match(
                    a,
                    .FnCall(_, _, ca, _, _) => match(
                      ca.get(usize(0)),
                      .Some(name_e) => match(
                        name_e,
                        .Atom(_, nt) => {
                          out.push(nt.value.clone());
                        },
                        .FnCall(_, _, _, _, _) => ()
                      ),
                      .None => ()
                    ),
                    .Atom(_, _) => ()
                  );
                }
              ),
              .None => ()
            );
            i = (i + usize(1));
          });
        },
        true => {
          // Single non-tuple FnCall — treat as one param with the
          // function head's atom value if available.
          out.push(ptok.value.clone());
        }
      ),
      .FnCall(_, _, _, _, _) => ()
    )
  )
);
/// Synthesize a default `Func` TypeValue whose params and return
/// type are fresh `SomeT`s. Used as the fallback for anonymous
/// functions evaluated without an `expected_type` in context. Lets
/// downstream code path through without throwing; the resulting
/// closure is effectively polymorphic.
_synthesize_default_func_type :: (
  fn(param_decl : AstExpr, env : Environment) -> TypeValue
)({
  names := ArrayList(String).new();
  _collect_anon_param_names(param_decl, names);
  frame_level := env.frames.len();
  param_types := ArrayList(TypeValue).new();
  (i : usize) = usize(0);
  n := names.len();
  while(i < n, {
    name := match(names.get(i),.Some(s) => s,.None => String.from("_p"));
    param_types.push(t_some_t(name, frame_level));
    i = (i + usize(1));
  });
  ret_ty := t_some_t(String.from("_ret"), frame_level);
  t_func_simple(names, param_types, ret_ty)
});
/// Helper: get the operator string from an anonymous function expression.
/// For `(x) -> body`, returns "->"; for `(x) => body`, returns "=>"; etc.
_get_anon_op :: (fn(expr : AstExpr) -> String)(
  match(
    expr,
    .Atom(_, t) => t.value,
    .FnCall(_, fb, _, _, _) => match(
      fb,
      .Atom(_, t) => t.value,
      .FnCall(_, _, _, _, _) => String.from("<unknown>")
    )
  )
);
/// Helper: get the argument at index `i` from a FnCall, or `make_err_expr()` if missing.
_get_arg :: (fn(expr : AstExpr, i : usize) -> AstExpr)(
  match(
    expr,
    .FnCall(_, _, args, _, _) => match(
      args.get(i),
      .Some(a) => a,
      .None => make_err_expr()
    ),
    .Atom(_, _) => make_err_expr()
  )
);
/// Helper: get the actual parameter name from a parameter expression.
/// Handles bare atoms (`x`) and colon-annotated (`x : T`).
/// Falls back to `fallback` if neither pattern matches.
_get_param_name_from_expr :: (fn(param_expr : AstExpr, fallback : String) -> String)(
  match(
    param_expr,
    .Atom(_, ptok) => ptok.value,
    .FnCall(_, fb, args, _, _) => match(
      fb,
      .Atom(_, fbtok) => cond(
        (fbtok.value == ":") => match(
          args.get(usize(0)),
          .Some(name_expr) => match(
            name_expr,
            .Atom(_, ntok) => ntok.value,
            .FnCall(_, _, _, _, _) => fallback.clone()
          ),
          .None => fallback.clone()
        ),
        true => fallback.clone()
      ),
      .FnCall(_, _, _, _, _) => fallback.clone()
    )
  )
);
/// Helper: build a Func TypeValue from a FnTraitT TypeValue.
/// Extracts `call_param_labels`, `call_param_types`, `call_result` from FnTraitT
/// and wraps them in a no-generic, no-implicit Func.
_func_from_fn_trait :: (fn(ftt : TypeValue) -> TypeValue)(
  match(
    ftt,
    .FnTraitT(_, cpl, cpt, cr_box, _, _, _, cprf) => TypeValue.Func(
      ArrayList(TypeValue).new(),
      // no generic types
      cpt,
      ArrayList(TypeValue).new(),
      // no implicit types
      ArrayList(TypeValue).new(),
      // no where types
      cr_box,
      box(
        FuncMeta(
          forall_labels : ArrayList(String).new(),
          param_labels : cpl,
          implicit_labels : ArrayList(String).new(),
          implicit_spreads : ArrayList(bool).new(),
          result_is_comptime_only : false,
          // Fn-trait-derived closure type (runtime); `inout` call params
          // carry through (the with_lock write-through closure).
          param_is_ref : cprf,
          param_is_owning : ArrayList(bool).new(),
          // no `own` params in Fn-trait closure type
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          // Fn-trait-derived closure type is not FFI
          extern_name : Option(String).None,
          is_control : false // Fn-trait-derived closure type is `fn`, not `ctl`
          ,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      ArrayList(TypeValue).new()
    ),
    _ => TypeValue.Unit
  )
);
/// Substitute generic SomeTypes (by name, from `env2` bindings) throughout a
/// type. Faithful port of TS `substituteSomeTypesFromEnv`
/// (anonymous-function.ts:110): a SomeT becomes the env's non-SomeT TypeVal
/// binding (innermost frame wins); Pointer/Array recurse into the child;
/// Func substitutes param + result types only (generic/implicit/where lists
/// and meta are preserved); every other node is returned unchanged. yo-self
/// stands in `!is_some_type(bound)` for TS's `bound !== type` identity guard
/// (same convention as the per-param substitution loop in
/// evaluate_anonymous_function_implementation).
///
/// DIVERGENCE (deliberate): TS's step 1 resolves through the SomeT's own
/// `resolvedConcreteType` — a PER-CALL-CLONE field, always this call's
/// truth. yo-self's resolution cell is per-LINEAGE (the declaration's
/// clones share the handle), so by the time a later io.async call site's
/// lambda evaluates, the shared `T` cell can hold a SIBLING call's
/// resolution — substituting through it concretized the expected type with
/// the WRONG type (e.g. unit for an i32-bodied task), the body's
/// return-type check threw, the def-time trial swallowed, and the closure
/// never reached the result refinement (the async_await 8× void-closure
/// class). Only ENV BINDINGS (the per-lambda annotation frame + the callee
/// env) drive this substitution.
_subst_some_types_from_env :: (fn(ty : TypeValue, env2 : Environment, allow : ArrayList(String)) -> TypeValue)(
  match(
    ty,
    .SomeT({ name : ssn }) => {
      // ALLOW-LIST gate: only substitute generic names THIS pass itself bound
      // (the per-lambda annotation frame). A bare name-based env walk is
      // collision-prone for trait-associated type names — the Future trait's
      // `Output` matched std/process/command.yo's `Output` STRUCT through the
      // import chain, concretizing the closure's expected result with a
      // process struct ("Expected type \"Output\"" def-eval swallows, ekey
      // probe in issues/yo-self-async-emission-cluster.md item 7).
      if(!(allow.contains(ssn.clone())), {
        return(ty);
      });
      ss_found := get_variables_from_env(env2, ssn.clone());
      (ss_bound : Option(TypeValue)) = Option(TypeValue).None;
      (ss_bi : usize) = ss_found.len();
      while(ss_bi > usize(0), {
        ss_bi = (ss_bi - usize(1));
        match(
          ss_found.get(ss_bi),
          .Some(sv) => match(
            sv.value.get(usize(0)),
            .Some(sval) => match(
              sval,
              .TypeVal(stv) => if(!(is_some_type(stv)), {
                ss_bound = Option(TypeValue).Some(stv);
                ss_bi = usize(0);
              }),
              _ => ()
            ),
            .None => ()
          ),
          .None => ()
        );
      });
      match(ss_bound,.Some(bt) => recur(bt, env2, allow.clone()),.None => ty)
    },
    .Pointer(ss_in) =>.Pointer(recur(ss_in, env2, allow.clone())),
    .Array(ss_ain, ss_alen, ss_alv) =>.Array(recur(ss_ain, env2, allow.clone()), ss_alen, ss_alv),
    .Func({ forall_types : ss_fts, param_types : ss_pts, implicit_types : ss_its, where_types : ss_wts, result : ss_ret, meta : ss_fm }) => {
      ss_new_pts := ArrayList(TypeValue).new();
      (ss_pi : usize) = usize(0);
      while(ss_pi < ss_pts.len(), {
        ss_elem := match(ss_pts.get(ss_pi),.Some(t) => t,.None => TypeValue.Unit);
        ss_new_pts.push(recur(ss_elem, env2, allow.clone()));
        ss_pi = (ss_pi + usize(1));
      });
      TypeValue.Func(ss_fts.clone(), ss_new_pts, ss_its.clone(), ss_wts.clone(), recur(ss_ret, env2, allow.clone()), box(ss_fm.*.clone()), ArrayList(TypeValue).new())
    },
    _ => ty
  )
);
/// Trial-evaluate an anonymous-function body at definition time, swallowing
/// any eval error. Replicates `_trial_eval_fn_body` (calls/function_type.yo)
/// — the swallow handler must be a capture-free `->` effect handler, so the
/// helper cannot be shared by closing over locals; see the def-eval-wall
/// notes there. On success the evaluated body is pushed to `out`; on error
/// the swallowing exception unwinds THIS helper (returning unit, `out` stays
/// empty). A deliberate gate rejection inside the body flags
/// `flow_violation_pending()` before throwing; the caller re-raises it.
_trial_eval_anon_body :: (
  fn(body : AstExpr, env : Environment, ctx : EvalContext, out : ArrayList(AstExpr)) -> unit
)({
  clear_flow_violation();
  inner_exn := Exception(throw : ((_err) -> unwind(())));
  // Wrap a non-begin body in a synthetic `begin(...)` so even a bare-atom
  // body runs the begin-tail ownership pass (TS anonymous-function.ts:829
  // always routes through evaluateBeginExpression; see wrap_body_in_begin).
  evaluated := evaluate_expression_raw(wrap_body_in_begin(body), env, ctx, inner_exn);
  out.push(evaluated);
});
/// Unify a declared return type that CONTAINS type variables (`Option(B)`)
/// against the concrete body type, binding each nested type variable in
/// `expected_env`.
///
/// TS does this for the side effect on the shared SomeType object
/// (`setResolvedConcreteType`, anonymous-function.ts:1004-1008) and then
/// harvests it into the call's calleeEnv at helper.ts:1471-1493. yo-self routes
/// the SAME net effect through the env in one step: `expected_env` IS the
/// caller-side `ctx.expected_type.env` — the call's own callee env — so the
/// binding lands exactly where `evaluate_function_return_type_again` reads it.
///
/// Going through the env rather than the lineage cell / id registry is what
/// makes this PER CALL. Those channels are keyed on the SomeT's identity, and a
/// prelude signature's `B` is ONE instance shared by every call of the method
/// (TS mints a fresh `B` per call at helper.ts:1047), so stamping them made
/// `opt.and_then(x => Option(String).Some(…))` inherit the previous call's
/// `B := i32` — measured as a specialized `and_then` declared `-> Option(i32)`
/// whose closure returned `Option(String)` (a C type error in
/// tests/option_result_combinators arm 6).
///
/// A genuine mismatch must not fail the definition-time evaluation — TS's own
/// compatibility check downstream reports it — so the throw is swallowed by
/// unwinding THIS helper.
_synth_nested_return_somes :: (
  fn(ret_ty : TypeValue, body_ty : TypeValue, expected_env : Environment, given_env : Environment) -> unit
)({
  inner_exn := Exception(throw : ((_err) -> unwind(())));
  nrs_checked := ArrayList(TypePair).new();
  (nrs_opts : Option(SynthesizeOptions)) = Option(SynthesizeOptions).None;
  synthesize_types(ret_ty, expected_env, body_ty, given_env, nrs_checked, nrs_opts, inner_exn);
  ()
});
/// Evaluate a closure-parameter type annotation, swallowing eval errors
/// (mirrors the try/catch around anonymous-function.ts:448). On success —
/// the annotation evaluated to a CONCRETE (non-SomeT) TypeVal — pushes the
/// type to `out`; on error or a non-type result `out` stays empty. The
/// caller saves/restores `ctx.is_evaluating_function_type` (an unwind here
/// would skip an in-helper restore).
_trial_eval_annotation_type :: (
  fn(type_expr : AstExpr, env : Environment, ctx : EvalContext, out : ArrayList(TypeValue)) -> unit
)({
  inner_exn := Exception(throw : ((_err) -> unwind(())));
  ctx.is_evaluating_function_type = true;
  evaluated := evaluate_expression_raw(type_expr, env, ctx, inner_exn);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
    .Some(ann_ei) => match(
      ann_ei.value,
      .Some(ann_v) => match(
        ann_v,
        .TypeVal(ann_tv) => if(!(is_some_type(ann_tv)), {
          out.push(ann_tv);
        }),
        _ => ()
      ),
      .None => ()
    ),
    .None => ()
  );
});
/// Post-body-eval capture checks. Mirrors anonymous-function.ts:
///   - :867-878 — a regular function (`->`) cannot capture outer runtime
///     variables (codegen would emit a standalone C function with no capture
///     params → undeclared identifiers). Only TRUE outer captures count:
///     `frame_level < outer_frames_len` (params live AT outer_frames_len).
///   - :1078-1087 — Phase B non-escape: a closure cannot capture a `ref`
///     binding (second-class reference; the closure could outlive the frame).
///   - :1088-1110 — §4 rule 4: a closure cannot capture a value of
///     control-bound type (the captured ctl handler would escape its install
///     frame with the closure).
/// `env` still carries the parameter frame; `outer_frames_len` is the frame
/// count from BEFORE it was pushed.
_check_anon_fn_captures :: (
  fn(
    caps : HashMap(String, CapturedVarInfo),
    env : Environment,
    is_closure : bool,
    outer_frames_len : usize,
    func_id : String,
    tok : Token,
    exn : Exception
  ) -> unit
)({
  if(!(is_closure), {
    (names : String) = String.new();
    key_iter := caps.keys();
    (more : bool) = true;
    while(more, {
      match(
        key_iter.next(),
        .None => {
          more = false;
        },
        .Some(k) => {
          match(
            caps.get(k.clone()),
            .Some(ci) => if(ci.frame_level < outer_frames_len, {
              if(names.len() > usize(0), {
                names = `${names}, `;
              });
              names = `${names}${k}`;
            }),
            .None => ()
          );
        }
      );
    });
    if(names.len() > usize(0), {
      // TS discards the definition when this throws; yo-self already
      // registered it — mark it unemittable so codegen skips the body
      // (else it emits `return outer_val;` referencing an undeclared
      // outer variable; the algebraic_effects cee block).
      mark_fn_unemittable(func_id.clone());
      exn.throw(
        dyn(
          format_error_message(
            tok,
            `A regular function (using ->) cannot capture outer runtime variables: ${names}.
Use a closure (=> syntax) instead, or refactor the handler to not reference outer variables.
If this is an effect handler (e.g. Exception.throw), the handler type only accepts -> functions,
so only builtin functions (panic, escape) and local variables are accessible.`,
            false,
            .None
          )
        )
      );
    });
    return(());
  });
  key_iter2 := caps.keys();
  (more2 : bool) = true;
  while(more2, {
    match(
      key_iter2.next(),
      .None => {
        more2 = false;
      },
      .Some(k) => {
        match(
          caps.get(k.clone()),
          .Some(ci) => {
            // Mirror TS: `if (captureInfo.frameLevel >= env.frames.length)
            // continue` — only true outer captures are checked.
            if(ci.frame_level < outer_frames_len, {
              match(
                env.frames.get(ci.frame_level),
                .Some(frame) => {
                  (vi : usize) = usize(0);
                  n_v := frame.variables.len();
                  while(vi < n_v, {
                    match(
                      frame.variables.get(vi),
                      .Some(v) => if(v.name == k, {
                        if(v.is_ref, {
                          exn.throw(
                            dyn(
                              format_error_message(
                                ci.token,
                                `Cannot capture inout binding '${k}' in a closure. \`inout(${k}) : T\` is a second-class reference to the caller's storage; a closure that captures it could outlive the call frame. Pass the value through (e.g. read it into a local first, or restructure to take the closure as a callback parameter).`,
                                false,
                                .None
                              )
                            )
                          );
                        });
                        if((!(v.is_compile_time_only)) && type_is_control_bound(v.ty), {
                          exn.throw(
                            dyn(
                              format_error_message(
                                ci.token,
                                `Closures cannot capture a value of control-bound type. The captured value \`${k}\` has type \`${type_to_string(v.ty)}\` which transitively contains a \`ctl(...) -> ret\` function. Closures can escape their enclosing frame, taking the captured control function with them — which would unwind to a dead install frame.

Pass \`${k}\` as a regular function parameter instead of capturing it in a closure.`,
                                false,
                                .None
                              )
                            )
                          );
                        });
                      }),
                      .None => ()
                    );
                    vi = (vi + usize(1));
                  });
                },
                .None => ()
              );
            });
          },
          .None => ()
        );
      }
    );
  });
});
evaluate_anonymous_function_implementation :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  tok := ast_expr_token(expr);
  op_str := _get_anon_op(expr);
  // Require exactly 2 args: param declaration + body.
  n_expr_args := match(
    expr,
    .FnCall(_, _, a, _, _) => a.len(),
    .Atom(_, _) => usize(0)
  );
  if(n_expr_args != usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          `Anonymous function: expected 2 args, got ${n_expr_args}`,
          false,
          .None
        )
      )
    );
  });
  param_decl := _get_arg(expr, usize(0));
  body_expr := _get_arg(expr, usize(1));
  // -------------------------------------------------------------------------
  // Resolve the expected type from context.
  // -------------------------------------------------------------------------
  // No expected type in context is a HARD ERROR, exactly as in TS
  // (anonymous-function.ts:190-196): an anonymous-function literal has no type
  // of its own, so there is nothing to check its parameters and body against.
  // TS throws for `->`, `=>` and `=>>` alike, so this gate is operator-agnostic.
  //
  // The former leniency (`_synthesize_default_func_type`, which built an
  // all-`SomeT` Func and DISCARDED the user's parameter annotations) is what
  // produced the `use of undeclared identifier fn_yo_id_NNNN` clang error in
  // tests/algebraic_effects.test.yo: the synthesized FuncVal gets registered, so
  // codegen/exprs/comptime_value.yo emits its c_name, while
  // should_skip_function_codegen (codegen/functions/declarations.yo:462, via
  // is_function_type_hard_generic / has_generic_return) suppresses BOTH its
  // prototype and its body. It also made that file's `comptime_expect_error`
  // for "lambda with unwind needs an explicit ctl annotation" pass vacuously.
  expected_ty := match(
    ctx.expected_type,
    .Some(etc) => etc.ty,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            `Expected a function type, got:\n${ast_expr_to_string(expr)}`,
            false,
            .None
          )
        )
      );
      TypeValue.Unit
    }
  );
  // For closures passed to generic functions (e.g. io.async), the callee's
  // env carries generic bindings (E=Io, T=i32). Extract it so the closure's
  // parameter types can be resolved against those bindings before body
  // evaluation. Mirrors TS anonymous-function.ts:205 `expectedTypeEnv`.
  expected_type_env := match(
    ctx.expected_type,
    .Some(etc) => etc.env,
    .None => env
  );
  // -------------------------------------------------------------------------
  // Determine whether this is a closure (`=>` / `=>>`) or regular function
  // (`->`).  For closures the expected type is normally SomeT or FnTraitT
  // (the Fn-trait wrapper); for regular functions it is Func.
  // -------------------------------------------------------------------------
  op_is_arrow := (op_str == "->");
  is_creating_closure := (!(op_is_arrow));
  // Resolve the concrete Func type to use for parameter/return information.
  // For Func expected types: use directly.
  // For FnTraitT: convert to Func.
  // For SomeT: extract FnTraitT via trait_checking, then convert to Func.
  function_type_opt := match(
    expected_ty,
    .Func({ result : _ }) => Option(TypeValue).Some(expected_ty),
    .FnTraitT(_, _, _, _, _, _, _, _) => Option(TypeValue).Some(_func_from_fn_trait(expected_ty)),
    .SomeT(_, _, _, _, _, _, _, _, _, _, _) => {
      fn_trait_opt := extract_fn_trait_from_type(expected_ty);
      match(
        fn_trait_opt,
        // NOTE: TS anonymous-function.ts:249 also substitutes here from
        // expectedTypeEnv; the yo-self port of that call proved both
        // unnecessary (the annotation-driven pass below is what resolves
        // io.async's `E := Io`) and collision-prone (name-based lookup), so
        // only the allow-listed annotation-driven substitution remains.
        .Some(ftt) => Option(TypeValue).Some(_func_from_fn_trait(ftt)),
        .None => Option(TypeValue).None
      )
    },
    _ => Option(TypeValue).None
  );
  (function_type : TypeValue) = match(
    function_type_opt,
    .Some(ft) => ft,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("Anonymous function: expected a Func or Impl(Fn(...)) type"),
            false,
            .None
          )
        )
      );
      TypeValue.Unit
    }
  );
  // -------------------------------------------------------------------------
  // Extract Func fields.
  // -------------------------------------------------------------------------
  forall_labels := match(
    function_type,
    .Func({ meta : __fm1 }) => __fm1.*.forall_labels,
    _ => ArrayList(String).new()
  );
  param_labels := match(
    function_type,
    .Func({ meta : __fm2 }) => __fm2.*.param_labels,
    _ => ArrayList(String).new()
  );
  (param_types : ArrayList(TypeValue)) = match(
    function_type,
    .Func({ param_types : pt }) => pt,
    _ => ArrayList(TypeValue).new()
  );
  // The expected type's per-param ref-ness. A `inout(self) : Self` trait-method
  // param (e.g. Clone's `clone : fn(inout(self) : Self) -> Self`) makes `self` a
  // C pointer; the body's `self.field` read must dereference it (`(*self).field`,
  // emitted by generate_atom on an is_ref binding). add_variable_to_env can't set
  // is_ref, so we stamp it onto the bound variable below — matching the
  // def-time (_build_def_time_body_env) and specialized
  // (create_specialized_function_inline) body-eval paths.
  param_is_ref := match(
    function_type,
    .Func({ meta : __fm3 }) => __fm3.*.param_is_ref,
    _ => ArrayList(bool).new()
  );
  implicit_labels := match(
    function_type,
    .Func({ meta : __fm4 }) => __fm4.*.implicit_labels,
    _ => ArrayList(String).new()
  );
  implicit_types := match(
    function_type,
    .Func({ implicit_types : it }) => it,
    _ => ArrayList(TypeValue).new()
  );
  result_box := match(
    function_type,
    .Func({ result : rb }) => rb,
    _ => TypeValue.Unit
  );
  // -------------------------------------------------------------------------
  // Parse the parameter declaration into a flat list.
  // `param_decl` is either a tuple(...) with multiple params or a single expr.
  // -------------------------------------------------------------------------
  raw_param_exprs := match(
    param_decl,
    .FnCall(_, fb2, decl_args, _, _) => match(
      fb2,
      .Atom(_, ptok) => cond(
        (ptok.value == BK_TUPLE) => decl_args,
        true => {
          single_list := ArrayList(AstExpr).new();
          single_list.push(param_decl);
          single_list
        }
      ),
      .FnCall(_, _, _, _, _) => {
        single_list2 := ArrayList(AstExpr).new();
        single_list2.push(param_decl);
        single_list2
      }
    ),
    .Atom(_, _) => {
      single_list3 := ArrayList(AstExpr).new();
      single_list3.push(param_decl);
      single_list3
    }
  );
  // -------------------------------------------------------------------------
  // Separate generic / using / regular parameter expressions.
  // -------------------------------------------------------------------------
  forall_param_exprs := ArrayList(AstExpr).new();
  using_param_exprs := ArrayList(AstExpr).new();
  regular_param_exprs := ArrayList(AstExpr).new();
  (sep_i : usize) = usize(0);
  n_raw := raw_param_exprs.len();
  while(sep_i < n_raw, {
    pe := match(raw_param_exprs.get(sep_i),.Some(a) => a,.None => make_err_expr());
    is_forall_call := ast_expr_is_fn_call_of(pe, "generic",.None);
    is_using_call := ast_expr_is_fn_call_of(pe, "using",.None);
    cond(
      is_forall_call => {
        fa := match(pe,.FnCall(_, _, fa_args, _, _) => fa_args,.Atom(_, _) => ArrayList(AstExpr).new());
        (fi : usize) = usize(0);
        while(fi < fa.len(), {
          fpe := match(fa.get(fi),.Some(a) => a,.None => make_err_expr());
          forall_param_exprs.push(fpe);
          fi = (fi + usize(1));
        });
      },
      is_using_call => {
        ua := match(pe,.FnCall(_, _, ua_args, _, _) => ua_args,.Atom(_, _) => ArrayList(AstExpr).new());
        (ui : usize) = usize(0);
        while(ui < ua.len(), {
          upe := match(ua.get(ui),.Some(a) => a,.None => make_err_expr());
          using_param_exprs.push(upe);
          ui = (ui + usize(1));
        });
      },
      true => {
        regular_param_exprs.push(pe);
      }
    );
    sep_i = (sep_i + usize(1));
  });
  // -------------------------------------------------------------------------
  // Validate regular parameter count.
  // -------------------------------------------------------------------------
  n_regular := regular_param_exprs.len();
  n_expected := param_labels.len();
  if(n_regular != n_expected, {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          `Anonymous function: expected ${n_expected} regular parameters, got ${n_regular}`,
          false,
          .None
        )
      )
    );
  });
  // -------------------------------------------------------------------------
  // Lambda-annotation-driven generic resolution (closure params). Mirrors TS
  // anonymous-function.ts:416-490: when a closure parameter carries an
  // explicit `(name : Type)` annotation and the expected Fn-trait parameter
  // type is an UNRESOLVED SomeType (io.async's `Impl(Fn(E) -> T)` exposes
  // `e : E`), evaluate the user's annotation and substitute that SomeType
  // throughout `function_type` via a per-lambda binding frame that never
  // escapes (pushed here, popped before the capture snapshot below). Without
  // this the registered closure type keeps the live shared `E`; a LATER call
  // site's resolution of the same declaration-cloned SomeT (E := IoExn in
  // std/process/command.yo) then poisons this closure's prototype render —
  // the never-collected IoExn is the rc=-6 `get_type_string` panic family.
  // -------------------------------------------------------------------------
  if(is_creating_closure, {
    (ann_subst_needed : bool) = false;
    (ann_frame_pushed : bool) = false;
    ann_bound_names := ArrayList(String).new();
    (ann_i : usize) = usize(0);
    while(ann_i < n_regular, {
      ann_pe := match(regular_param_exprs.get(ann_i),.Some(a) => a,.None => make_err_expr());
      ann_exp_ty := match(param_types.get(ann_i),.Some(t) => t,.None => TypeValue.Unit);
      ann_is_colon := ast_expr_is_fn_call_of(ann_pe, ":", Option(usize).Some(usize(2)));
      // The expected param must be a SomeT with no resolution yet — mirrors
      // `isSomeType(expectedParam.type) && !expectedParam.type.resolvedConcreteType`.
      ann_some_name := match(
        ann_exp_ty,
        .SomeT({ name : ann_sn, resolved_concrete : ann_rc }) => if(
          (ann_rc.len() == usize(0)) && ann_is_colon,
          Option(String).Some(ann_sn.clone()),
          Option(String).None
        ),
        _ => Option(String).None
      );
      match(
        ann_some_name,
        .Some(ann_nm) => {
          ann_targs := match(ann_pe,.FnCall(_, _, ata, _, _) => ata,.Atom(_, _) => ArrayList(AstExpr).new());
          ann_tex := match(ann_targs.get(usize(1)),.Some(a) => a,.None => make_err_expr());
          ann_out := ArrayList(TypeValue).new();
          ann_prev_flag := ctx.is_evaluating_function_type;
          _trial_eval_annotation_type(ann_tex, env, ctx, ann_out);
          ctx.is_evaluating_function_type = ann_prev_flag;
          match(
            ann_out.get(usize(0)),
            .Some(ann_user_ty) => {
              if(!(ann_frame_pushed), {
                _ann_fr := env.push_frame(false);
                ann_frame_pushed = true;
              });
              // Skip if this generic name was already bound by an earlier
              // annotated param (TS: topFrame duplicate-name check —
              // multi-param closures reusing one generic name).
              ann_already := match(
                env.frames.get(env.frames.len() - usize(1)),
                .Some(ann_top) => {
                  (ann_found : bool) = false;
                  (ann_vi : usize) = usize(0);
                  while(ann_vi < ann_top.variables.len(), {
                    match(
                      ann_top.variables.get(ann_vi),
                      .Some(av) => if(av.name == ann_nm, {
                        ann_found = true;
                      }),
                      .None => ()
                    );
                    ann_vi = (ann_vi + usize(1));
                  });
                  ann_found
                },
                .None => false
              );
              if(!(ann_already), {
                ann_tok := ast_expr_token(ann_pe);
                _ann_v := add_variable_to_env(
                  env,
                  ann_nm.clone(),
                  TypeValue.TypeUni(usize(0)),
                  Option(EvalValue).Some(EvalValue.TypeVal(ann_user_ty)),
                  true,
                  false,
                  false,
                  false,
                  ann_tok
                );
                ann_bound_names.push(ann_nm.clone());
                ann_subst_needed = true;
              });
            },
            .None => ()
          );
        },
        .None => ()
      );
      ann_i = (ann_i + usize(1));
    });
    if(ann_subst_needed, {
      function_type = _subst_some_types_from_env(function_type, env, ann_bound_names);
      param_types = match(
        function_type,
        .Func({ param_types : ann_pt }) => ann_pt,
        _ => param_types.clone()
      );
    });
    if(ann_frame_pushed, {
      env.pop_frame();
    });
  });
  // -------------------------------------------------------------------------
  // Phase 3ad: snapshot outer env for closure/function capture.
  // Mirrors eval.yo lines 1696-1730: iterate all outer frames and collect
  // all visible variable bindings. Runtime variables (no comptime value) are
  // stored as VarRef(name) in cap_vals so they can be found at call time.
  // This must happen BEFORE pushing the parameter frame so we only capture
  // the outer lexical scope (params are bound fresh at each call site).
  // -------------------------------------------------------------------------
  cap_names := ArrayList(String).new();
  cap_tys := ArrayList(TypeValue).new();
  cap_vals := ArrayList(EvalValue).new();
  n_cap_fr := env.frames.len();
  (cap_fi : usize) = usize(0);
  while(cap_fi < n_cap_fr, {
    match(
      env.frames.get(cap_fi),
      .Some(cap_frame) => {
        n_cap_v := cap_frame.variables.len();
        (cap_vi : usize) = usize(0);
        while(cap_vi < n_cap_v, {
          match(
            cap_frame.variables.get(cap_vi),
            .Some(cv) => {
              cond(
                (!(cv.name == "__recur_fn")) => {
                  cap_names.push(cv.name);
                  cap_tys.push(cv.ty);
                  cap_val := match(
                    cv.value.get(usize(0)),
                    .Some(actual) => actual,
                    .None => EvalValue.VarRef(cv.name)
                  );
                  cap_vals.push(cap_val);
                },
                true => ()
              );
            },
            .None => ()
          );
          cap_vi = (cap_vi + usize(1));
        });
      },
      .None => ()
    );
    cap_fi = (cap_fi + usize(1));
  });
  // -------------------------------------------------------------------------
  // Push a new environment frame for the function parameters.
  // -------------------------------------------------------------------------
  _frame_idx := env.push_frame(false);
  // -------------------------------------------------------------------------
  // Add generic parameters to the environment.
  // Each generic type variable is bound as a compile-time unknown SomeT.
  // -------------------------------------------------------------------------
  (fa_env_i : usize) = usize(0);
  while(fa_env_i < forall_labels.len(), {
    fl_name := match(forall_labels.get(fa_env_i),.Some(n) => n,.None => String.from(""));
    fl_ty := TypeValue.SomeT(
      fl_name.clone(),
      fl_name.clone(),
      env.frame_count(),
      TypeValue.TypeUni(usize(0)),
      ArrayList(TypeValue).new(),
      ArrayList(usize).new(),
      ArrayList(TypeValue).new(),
      ArrayList(usize).new(),
      false,
      Option(TypeValue).None,
      ArrayList(TypeValue).new()
    );
    fl_tok := synthetic_token(fl_name.clone(), env.module_path);
    _fa_v := add_variable_to_env(
      env,
      fl_name.clone(),
      TypeValue.TypeUni(usize(0)),
      Option(EvalValue).Some(EvalValue.TypeVal(fl_ty)),
      true,
      false,
      false,
      false,
      fl_tok
    );
    fa_env_i = (fa_env_i + usize(1));
  });
  // -------------------------------------------------------------------------
  // Add implicit (using) parameters to the environment.
  // -------------------------------------------------------------------------
  (il_env_i : usize) = usize(0);
  while(il_env_i < implicit_labels.len(), {
    il_name := match(implicit_labels.get(il_env_i),.Some(n) => n,.None => String.from(""));
    il_ty := match(implicit_types.get(il_env_i),.Some(t) => t,.None => TypeValue.Unit);
    il_tok := synthetic_token(il_name.clone(), env.module_path);
    il_val := create_unknown_val(il_ty.clone());
    _il_v := add_variable_to_env(
      env,
      il_name.clone(),
      il_ty,
      Option(EvalValue).Some(il_val),
      true,
      false,
      false,
      true,
      il_tok
    );
    il_env_i = (il_env_i + usize(1));
  });
  // -------------------------------------------------------------------------
  // Build param_type_names and add regular parameters to the environment.
  // Use the user-supplied name from the parameter expression where available;
  // fall back to the expected label.
  // -------------------------------------------------------------------------
  param_type_names := ArrayList(String).new();
  actual_param_labels := ArrayList(String).new();
  (rp_i : usize) = usize(0);
  while(rp_i < n_regular, {
    rpe := match(regular_param_exprs.get(rp_i),.Some(a) => a,.None => make_err_expr());
    exp_label := match(param_labels.get(rp_i),.Some(n) => n,.None => String.from(""));
    rp_ty_raw := match(param_types.get(rp_i),.Some(t) => t,.None => TypeValue.Unit);
    // Substitute generic SomeTypes (e.g. `E`) in the param type with their
    // concrete bindings from the callee env. Mirrors TS
    // substituteSomeTypesFromEnv at anonymous-function.ts:249.
    rp_ty := match(
      rp_ty_raw,
      .SomeT(_, srp_name, _, _, _, _, _, _, _, _, _) => {
        _st_bind_vars := get_variables_from_env(expected_type_env, srp_name.clone());
        (_st_bound : Option(TypeValue)) = Option(TypeValue).None;
        (_st_bi : usize) = _st_bind_vars.len();
        while(_st_bi > usize(0), {
          _st_bi = (_st_bi - usize(1));
          match(
            _st_bind_vars.get(_st_bi),
            .Some(sv) => match(
              sv.value.get(usize(0)),
              .Some(sval) => match(
                sval,
                .TypeVal(stv) => if(!(is_some_type(stv)), {
                  _st_bound = Option(TypeValue).Some(stv);
                  _st_bi = usize(0);
                }),
                _ => ()
              ),
              .None => ()
            ),
            .None => ()
          );
        });
        match(_st_bound,.Some(t) => t,.None => rp_ty_raw)
      },
      _ => rp_ty_raw
    );
    // Derive the actual parameter name from the user's expression.
    param_name := _get_param_name_from_expr(rpe, exp_label.clone());
    // param_type_name for generic param binding at call time
    ptn := match(
      rp_ty_raw,
      .SomeT(_, name, _, _, _, _, _, _, _, _, _) => name,
      _ => String.from("")
    );
    param_type_names.push(ptn.clone());
    actual_param_labels.push(param_name.clone());
    rp_tok := ast_expr_token(rpe);
    rp_v_opt := add_variable_to_env(
      env,
      param_name,
      rp_ty,
      Option(EvalValue).None,
      false,
      false,
      false,
      false,
      rp_tok
    );
    // Stamp is_ref from the expected type so a `inout(...)` param's body reads
    // dereference the C pointer (see param_is_ref note above).
    if(match(param_is_ref.get(rp_i),.Some(b) => b,.None => false), {
      match(
        rp_v_opt,
        .Some(rp_v) => {
          rp_v.is_ref = true;
          // TS binds `isReassignable: parameter.isRef`
          // (anonymous-function.ts:560): assignment TO an `inout` param is
          // the write-through (`v = i32(99)` in with_lock's closure).
          rp_v.is_reassignable = true;
        },
        .None => ()
      );
    });
    rp_i = (rp_i + usize(1));
  });
  // UNANNOTATED closure params whose expected SomeT resolved concretely
  // through the env (a where-bound forall — `fold`'s `item : A` with
  // `A := i32` bound by the `Self <: Iterator(Item := A)` application):
  // substitute those names through `function_type` so the REGISTERED type
  // (corrected_func_type → register_func_type → the emitted C prototype)
  // carries the concrete type. The rp loop above already binds the param
  // VARIABLE concretely (rp_ty), but the registered type kept the raw SomeT,
  // whose cell is never written by the env binding — the C emitter then
  // falls back to `void*` and every call site mismatches (`acc + x` with
  // `void* x`; iterator_combinators arm 18's last layer). TS needs no step
  // here: its newFunctionType is a SPREAD of the expected FunctionType whose
  // parameter objects already reference the resolved SomeType.
  if(is_creating_closure, {
    rp_resolved_names := ArrayList(String).new();
    (rpr_i : usize) = usize(0);
    while(rpr_i < n_regular, {
      rpr_raw := match(param_types.get(rpr_i),.Some(t) => t,.None => TypeValue.Unit);
      match(
        rpr_raw,
        .SomeT({ name : rpr_nm }) => if((rpr_nm.len() > usize(0)) && !(rpr_nm == "Impl"), {
          rpr_vars := get_variables_from_env(expected_type_env, rpr_nm.clone());
          (rpr_conc : bool) = false;
          (rpr_vi : usize) = rpr_vars.len();
          while(rpr_vi > usize(0), {
            rpr_vi = (rpr_vi - usize(1));
            match(
              rpr_vars.get(rpr_vi),
              .Some(rv) => match(
                rv.value.get(usize(0)),
                .Some(rvv) => match(
                  rvv,
                  .TypeVal(rvt) => if(!(is_some_type(rvt)), {
                    rpr_conc = true;
                    rpr_vi = usize(0);
                  }),
                  _ => ()
                ),
                .None => ()
              ),
              .None => ()
            );
          });
          if(rpr_conc && !(rp_resolved_names.contains(rpr_nm.clone())), {
            rp_resolved_names.push(rpr_nm.clone());
          });
        }),
        _ => ()
      );
      rpr_i = (rpr_i + usize(1));
    });
    if(rp_resolved_names.len() > usize(0), {
      function_type = _subst_some_types_from_env(function_type, expected_type_env, rp_resolved_names);
    });
  });
  // -------------------------------------------------------------------------
  // Build the FuncVal.
  // Phase 3ad: captures are populated from the outer env snapshot above.
  // -------------------------------------------------------------------------
  func_id := cond(
    is_creating_closure => (String.from("closure_") + random_id(env.module_path)),
    true => (String.from("fn_") + random_id(env.module_path))
  );
  // Source-position identity: every re-eval generation of this source
  // closure registers under the same key so capture info can merge across
  // generations (see function_value.yo g_closure_fid_source).
  if(is_creating_closure, {
    register_closure_fid_source(func_id.clone(), `${tok.module_path}:${tok.row.to_string()}:${tok.column.to_string()}`);
  });
  // Clone taken BEFORE `body_expr` below moves the body into the
  // FuncVal; the definition-time body evaluation further down needs it.
  body_for_def_eval := body_expr.clone();
  func_val := EvalValue.FuncVal(
    box(
      FuncValData(
        forall_names : forall_labels,
        params : actual_param_labels,
        param_type_names : param_type_names,
        evidence_params : implicit_labels,
        body : body_expr,
        cap_names : cap_names,
        cap_tys : cap_tys,
        func_id : func_id.clone()
      )
    ),
    cap_vals
  );
  // Record this function's own resolved Func type by func_id so codegen can
  // emit its C prototype (Gap 10 — FuncVal carries only param-name strings).
  //
  // L3: register with the SOURCE param labels (`actual_param_labels`), NOT the expected
  // type's `meta.param_labels`. The body binds + the atom emitter emits the SOURCE param
  // name (e.g. `err` from `(err) -> ...`), but a bare handler's `function_type` inherits
  // the EXPECTED label (e.g. `error` from `Exception.throw : ctl(…, error : AnyError) →
  // …`). The C prototype is generated from this registered type's `meta.param_labels`, so
  // registering the expected label yields "undeclared identifier 'err'" (proto declares
  // `error`, body references `err`). TS's FunctionValue.type carries the anon fn's OWN
  // (source) param labels. Rebuild a fresh Func with the source labels; leave
  // `function_type` (used below for body-eval + the expr's ExprInfo) untouched.
  corrected_func_type := match(
    function_type.clone(),
    .Func(_l3ft, _l3pt, _l3it, _l3wt, _l3r, _l3m, _) => {
      _l3nm := _l3m.*.clone();
      _l3nm.param_labels = actual_param_labels.clone();
      TypeValue.Func(_l3ft.clone(), _l3pt.clone(), _l3it.clone(), _l3wt.clone(), _l3r.clone(), box(_l3nm), ArrayList(TypeValue).new())
    },
    _ => function_type.clone()
  );
  // Re-key the func-id SIDE TABLES from the `fn(...)` type expression this
  // anonymous function was checked against, onto THIS FuncVal's id — the same
  // nine copies `try_to_implement_function_by_function_type` does for the `::`
  // form (evaluator/calls/function_type.yo). yo-self keeps
  // `is_compile_time_only`, the per-parameter type exprs and the return-type
  // expr in tables keyed by that expression's id; the anonymous-function path
  // minted a fresh `fn_<random>` id and copied NOTHING, so a
  // `comptime(T) : Type` parameter/return was simply lost: the call's return
  // stayed an unbound SomeT (`x := id(i32, 12)` then had no `==` impl and typed
  // `unit` — tests/fn.test.yo arm 9), and a `comptime(y) : i32` parameter was
  // emitted as a RUNTIME C parameter. TS needs no copy: `newFunctionType` is a
  // SPREAD of the expected FunctionType (anonymous-function.ts:597-638), so
  // both ride along. `origin_id` is yo-self's channel for the same thing and
  // travels with the meta through the `.clone()` just above.
  match(
    match(corrected_func_type,.Func({ meta : _oid_m }) => _oid_m.*.origin_id, _ => Option(String).None),
    .Some(_oid) => {
      copy_func_param_defaults(_oid.clone(), func_id.clone());
      copy_func_param_default_exprs(_oid.clone(), func_id.clone());
      copy_func_param_type_exprs(_oid.clone(), func_id.clone());
      copy_func_param_comptime(_oid.clone(), func_id.clone());
      copy_func_param_assigned_values(_oid.clone(), func_id.clone());
      copy_func_return_type_expr(_oid.clone(), func_id.clone());
      copy_func_variadic_param(_oid.clone(), func_id.clone());
      copy_macro_registration(_oid.clone(), func_id.clone());
      copy_func_where_constraints(_oid.clone(), func_id.clone());
      copy_func_contract_exprs(_oid.clone(), func_id.clone());
    },
    .None => ()
  );
  register_func_type(func_id.clone(), corrected_func_type);
  // Phase 5/3 (closure codegen): an io.async `=>` closure must carry the
  // capture-struct type + closure marker the codegen needs (closure functions take
  // a `void* closure_context` capture parameter; the sync-future path reads
  // `capture_type` for the SM's `__capture` field). closure_type.yo sets these on
  // the FnTraitT-callee path, which the lambda-arg path does not take.
  //
  // STICKY + SCOPED: the closure expr is evaluated more than once (def-time body
  // eval + codegen-prep) — only the FIRST eval sees `is_inside_io_async_call`, and
  // each eval mints a FRESH func_id, so the codegen-read (later) eval would be
  // unmarked. We therefore also treat THIS eval as an io.async closure when a PRIOR
  // eval already recorded a `capture_type` on this expr's ExprInfo. This keeps the
  // marking SCOPED to io.async closures (general `=>` closures are never flagged
  // and never get a prior capture_type — so building a capture struct for EVERY
  // closure, which regressed the full `check ./std`, is avoided) while surviving
  // re-eval. See issues/fixed/yo-self-closure-codegen-gate.md.
  // UNSCOPED (mark every `=>` closure): the codegen-read closure is a CLONE with
  // fresh expr-ids, evaluated WITHOUT is_inside_io_async_call, so neither the flag
  // nor an ExprInfo-keyed sticky bit transfers to it — only marking on every
  // closure eval reaches the clone codegen consumes. This is safe: yo-self-bin's
  // general closure codegen is unported (no capture-param convention existed
  // before this), so marking all closures cannot regress anything that worked; the
  // capture-struct creation below is the only added evaluator load, and the
  // pre-existing `check ./std` crash (std/imm/map.yo, bisected) is unrelated.
  mark_closure_for_codegen := is_creating_closure;
  if(mark_closure_for_codegen, {
    mark_as_closure_fn(func_id.clone());
  });
  (closure_capture_type : Option(TypeValue)) = Option(TypeValue).None;
  (closure_capture_dups : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
  (closure_body_caps : Option(HashMap(String, CapturedVarInfo))) = Option(HashMap(String, CapturedVarInfo)).None;
  // Register definitionSiteEnclosingFunctionType return type.
  // Mirrors: definitionSiteEnclosingFunctionType = context.isEvaluatingFunctionBodyOrAsyncBlock?.kind === "function-body"
  //   ? context.isEvaluatingFunctionBodyOrAsyncBlock.type : undefined
  // in src/evaluator/values/anonymous-function.ts.
  match(
    ctx.is_evaluating_function_body_or_async_block,
    .Some(fb_ctx) => match(
      fb_ctx.kind,
      .FunctionBody => match(
        fb_ctx.func_type,
        .Some(enclosing_func_ty) => {
          enclosing_return_ty := match(
            enclosing_func_ty,
            .Func({ result : rb }) => rb,
            _ => TypeValue.Unit
          );
          register_definition_site_return(func_id.clone(), enclosing_return_ty);
        },
        .None => ()
      ),
      _ => ()
    ),
    .None => ()
  );
  // -------------------------------------------------------------------------
  // Definition-time body evaluation (closure-body def-eval wall).
  //
  // Mirrors anonymous-function.ts:766-852: a NON-GENERIC anonymous function
  // evaluates its body NOW, under a function-body evaluation context whose
  // `captured_variables` map records every outer-variable reference
  // (identifier lookup calls `track_variable_usage`). Generic bodies stay
  // deferred, mirroring `shouldDeferBodyEvaluation` (generic params, or a
  // param type carrying SomeTs).
  //
  // Eval errors are SWALLOWED by the capture-free trial wrapper (the
  // def-eval-wall pattern — yo-self porting gaps must not reject valid
  // bodies). Deliberate rejections surface through three channels:
  //   1. a flow violation flagged inside the body (binding-site checks) is
  //      re-raised here via the real `exn`;
  //   2. under `propagate_def_time_errors()` (a `comptime_expect_error`
  //      argument eval) a swallowed body error is re-raised so the expected
  //      error is observed;
  //   3. the post-eval gates below (unwind-needs-ctl, capture checks) throw
  //      via the real `exn` directly.
  // -------------------------------------------------------------------------
  // Defer body eval on the SOURCE generic count (`forall_param_exprs`), NOT the
  // synthesized type's `forall_labels`. A bare handler `Exception(throw : (err) ->
  // unwind(...))` checked against the expected `ctl(generic(ResumeType), error :
  // AnyError) -> ResumeType` INHERITS `forall_labels = [ResumeType]` even though its
  // source declares no generic — keying the defer on `forall_labels` would wrongly skip
  // evaluating the body, leaving its `unwind` sub-expr UNSTAMPED (→ codegen "// Failed
  // to transpile unwind(...)"). TS keys on `forallParamExprs.length` (the anon fn's OWN
  // generic args — anonymous-function.ts:759; the generic-count mismatch guard at :320 is
  // commented out). The env still binds the inherited `forall_labels` below (~line 688)
  // for bodies that DO reference ResumeType.
  (should_defer_body : bool) = (forall_param_exprs.len() > usize(0));
  if(!(should_defer_body), {
    (sd_i : usize) = usize(0);
    while((sd_i < param_types.len()) && !(should_defer_body), {
      sd_pt := match(param_types.get(sd_i),.Some(t) => t,.None => t_unit());
      if(get_all_some_types(sd_pt).len() > usize(0), {
        should_defer_body = true;
      });
      sd_i = (sd_i + usize(1));
    });
  });
  // Phase 5 (closure codegen): an io.async closure has its synthesized type's
  // params as SomeT (→ would defer), but codegen MUST emit its body, which needs
  // the body's ExprInfo (types) from def-time eval — otherwise the body emits
  // "Failed to transpile". Force evaluation; the def-eval-wall swallow below makes
  // this safe even if the body touches the (SomeT) bundle param.
  if(mark_closure_for_codegen, {
    should_defer_body = false;
  });
  // CTL handlers (`throw : (ctl(generic(ResumeType), ...) -> ResumeType)`)
  // must also FORCE body evaluation: nothing else ever evaluates the body
  // (the def-eval is deferred by the SomeT param; the ctl inline eval only
  // runs when the handler VALUE reaches a call, which a def-eval'd callee
  // taking the record as a PARAM never does), so codegen had no ExprInfos
  // and emitted `// Failed to transpile return(resume_val);` — the handler
  // then returned garbage at runtime (algebraic_effects generic
  // struct-record family, issues/fixed/yo-self-algebraic-effects-two-roots.md).
  // Params bind at their (erased) declared types — exactly the void*
  // convention the emitted C uses; the def-eval-wall swallow keeps a
  // failing body harmless. TS needs no equivalent: its codegen emits
  // simple bodies from AST + types without per-node eval infos.
  ctl_force := match(
    function_type,
    .Func({ meta : __fmc9 }) => __fmc9.*.is_control,
    _ => false
  );
  // NOT inside a comptime_expect_error clone eval (propagate mode): the
  // force exists to stamp body ExprInfos for EMISSION, which rejected
  // cee code never reaches — and forcing there made the capture-check
  // throw propagate past the cee catch and abandon the enclosing begin
  // (the cee_regular_fn_capture_reject corpus DIFF: trailing println
  // dropped).
  if(ctl_force && !(propagate_def_time_errors()), {
    should_defer_body = false;
  });
  if(!(should_defer_body), {
    // A separate preliminary FuncVal for the body-eval context (EvalValue is
    // not Clone; `func_val` above is consumed by the ExprInfo below). Same
    // pattern as closure_type.yo's `func_val_pre`.
    body_ctx_func_val := EvalValue.FuncVal(
      box(
        FuncValData(
          forall_names : ArrayList(String).new(),
          params : ArrayList(String).new(),
          param_type_names : ArrayList(String).new(),
          evidence_params : ArrayList(String).new(),
          body : body_for_def_eval.clone(),
          cap_names : ArrayList(String).new(),
          cap_tys : ArrayList(TypeValue).new(),
          func_id : func_id.clone()
        )
      ),
      ArrayList(EvalValue).new()
    );
    // The body evaluates against a SNAPSHOT of the live env (the param frame
    // is in scope; frame-list mutations during body eval cannot corrupt the
    // outer env's frame list — see snapshot_env / the recorded-env-aliasing
    // issue). TS evaluates in the live env and restores `outerEnv` after
    // (anonymous-function.ts:1062) — the snapshot gives the same net effect.
    body_eval_env := snapshot_env(env);
    // NOTE: io.async's generic `E` (the effect bundle) is bound at the CALL site
    // (`try_to_call_function_with_arguments` Step 6b, helper.yo), which resolves
    // the closure's `e : E` param type to the concrete bundle BEFORE this body
    // eval runs — mirroring TS helper.ts:1312-1366. So `e.io` / `e.exn` field
    // accesses see a concrete receiver here without any body-env type binding.
    body_eval_ctx := create_function_body_evaluation_context(
      function_type,
      body_ctx_func_val,
      body_eval_env,
      ctx
    );
    // Phase 5 (closure codegen): for a marked io.async closure, the synthesized
    // closure return type is a fresh `SomeT _ret` — using it as the body's expected
    // type coerces an operator-bodied result (e.g. `i32+i32`) to that SomeT, so the
    // body types as SomeT and the concrete result-refine is skipped (closure return
    // + future result then lower to void*). Clear the expected type so the body
    // types naturally (the closure's result is inferred from the body anyway).
    ret_ty_for_body := match(function_type,.Func({ result : brt }) => brt, _ => t_unit());
    // (`mark_closure_for_codegen` is every `=>` closure — this clear is what
    // makes the def-time body type CONCRETELY instead of being coerced to
    // the SomeT, which feeds the closure-body-type registration below.)
    if(mark_closure_for_codegen && is_some_type(ret_ty_for_body), {
      body_eval_ctx.expected_type = Option(ExpectedTypeCtx).None;
    });
    anon_body_out := ArrayList(AstExpr).new();
    _trial_eval_anon_body(body_for_def_eval, body_eval_env, body_eval_ctx, anon_body_out);
    // Channel 1: re-raise a flow violation the trial swallow ate (a
    // deliberate binding-site rejection inside the body). Mirrors the
    // def-time caller in calls/function_type.yo:601.
    if(flow_violation_pending(), {
      anon_viol_msg := flow_violation_message();
      clear_flow_violation();
      exn.throw(dyn(format_error_message(tok, anon_viol_msg, false,.None)));
    });
    // Channel 2: comptime_expect_error observation — when the body eval
    // THREW (empty `out`) and propagate mode is on, re-raise so the
    // expected error reaches the comptime_expect_error catch.
    if(propagate_def_time_errors() && (anon_body_out.len() == usize(0)), {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("Anonymous function body raised a compile-time error during definition-time evaluation."),
            false,
            .None
          )
        )
      );
    });
    // §4 typing rule 1 (anonymous-function.ts:894-900): `unwind` is only
    // valid in a `ctl(...) -> ret` body. A `fn(...) -> ret` body containing
    // `unwind` is a type error. Closures are exempt (TS checks isClosure).
    fn_type_is_control := match(
      function_type,
      .Func({ meta : __fm5 }) => __fm5.*.is_control,
      _ => false
    );
    match(
      anon_body_out.get(usize(0)),
      .Some(anon_eb) => {
        if(evaluated_body_contains_unwind(anon_eb) && ((!(fn_type_is_control)) && (!(is_creating_closure))), {
          exn.throw(
            dyn(
              format_error_message(
                tok,
                String.from("`unwind` is only valid inside a control-function body. This function is declared with `fn(...) -> ret`; change the declared type to `ctl(...) -> ret` if the body needs to unwind."),
                false,
                .None
              )
            )
          );
        });
        // TS anonymous-function.ts:992-1015: when the declared return type
        // CONTAINS SomeTypes but is not itself one (`Option(B)` — the comment
        // there names this very shape) and the body evaluated to a fully
        // concrete type, synthesize the declared return against the body type
        // with `setResolvedConcreteType`, so every NESTED type variable carries
        // its resolution. TS relies on object identity: the `B` inside the
        // closure's `-> Option(B)` IS the callee signature's `B`, so stamping it
        // is what lets `helper.ts:1464` propagate `B := i32` into calleeEnv and
        // `evaluateFunctionReturnTypeAgain` resolve `Option(B)` → `Option(i32)`.
        // yo-self binds them in the call's own callee env instead — see
        // _synth_nested_return_somes for why the identity channels (the shared
        // `resolved_concrete` cell / id registry) are wrong here.
        //
        // Without this the whole Option/Result-combinator family hollowed: the
        // closure TAKES ON the expected `Impl(Fn(a : T) -> Option(B))` wrapper
        // (ts:1183-1252), so the call's Step-6 synthesis sees a SomeT — not a
        // Func — on the given side and skips the Fn-trait recursion that would
        // otherwise bind `B` (synthesizer.yo's `is_function_type(given_ty)`
        // guard, the same one TS has). TS binds `B` here instead, at the
        // closure's own body/return unification.
        match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(anon_eb)),
          .Some(nrs_info) => {
            nrs_body_ty := nrs_info.ty;
            nrs_ret_ty := match(function_type,.Func({ result : nrs_r }) => nrs_r, _ => t_unit());
            nrs_ret_nested := ((!(is_some_type(nrs_ret_ty))) && (get_all_some_types(nrs_ret_ty).len() > usize(0)));
            // BARE-SomeT declared return (`-> B`, map's output forall): TS
            // binds it through object identity at the plain body/declared
            // compat check (the closure's `B` IS the signature's `B`, so
            // setResolvedConcreteType propagates); yo-self's env channel
            // must handle it here or `B` never binds anywhere — the caller's
            // return record keeps a raw `B` slot and method dispatch on it
            // leaves the blanket impl's `B` forall abstract
            // (iterator_combinators arm 0 / repro9). io.async closures are
            // excluded: their declared `T` result must stay unresolved for
            // the sync-future registration (the wrapper-adoption hazard).
            // `->` effect handlers are excluded too: their declared result is
            // the per-call-site `ResumeType` SomeT, which other machinery
            // freshens — eagerly binding it here broke the effect-handler
            // corpus (dyn_error_throw_ioerror / effect_handler_unwind_emit:
            // handler `err` params emitted as undeclared identifiers).
            nrs_ret_bare := ((is_some_type(nrs_ret_ty) && is_creating_closure) && !(ctx.is_inside_io_async_call));
            nrs_body_concrete := ((!(is_some_type(nrs_body_ty))) && (get_all_some_types(nrs_body_ty).len() == usize(0)));
            if((nrs_ret_nested || nrs_ret_bare) && nrs_body_concrete, {
              _synth_nested_return_somes(nrs_ret_ty, nrs_body_ty, expected_type_env, body_eval_env);
              // TS ts:1012-1014 completes the mechanism by REPLACING the
              // declared return with the body type on both function types
              // (`functionType.return.type = evaluatedBodyReturnType`). In
              // yo-self this is load-bearing for codegen, not just tidiness:
              // resolving `B` by SUBSTITUTION keeps the def-era enum id, so a
              // left-in-place `Option(B)` reaches lowering as an instance that
              // was never collected ("get_type_string: no C type name found for
              // <enum:…>"). The body type is the CANONICAL memoized instance.
              function_type = match(
                function_type,
                .Func(nrs_fl, nrs_pt, nrs_it, nrs_wt, _, nrs_m, nrs_vt) => TypeValue.Func(nrs_fl, nrs_pt, nrs_it, nrs_wt, nrs_body_ty, nrs_m, nrs_vt),
                _ => function_type
              );
              register_func_type(func_id.clone(), function_type);
            });
          },
          .None => ()
        );
        // Phase 5: for an `io.async(closure)`, run the await-point analysis on the
        // body and record it on the body's ExprInfo when it has awaits — the
        // async-FSM codegen reads `await_analysis` to choose the state-machine path
        // (vs the sync-future path) and drive the transformation. Mirrors
        // anonymous-function.ts:898-907. Gated on mark_closure_for_codegen (not just
        // is_inside_io_async_call) so the codegen-read CLONE — re-evaluated without
        // the flag — also gets it (else an await-bearing closure is mis-dispatched
        // to the sync path). See issues/fixed/yo-self-closure-codegen-gate.md.
        if(mark_closure_for_codegen, {
          info_tbl := ctx.expr_info_table;
          await_res := analyze_await_points(anon_eb, (e : AstExpr) => expr_info_table_get(info_tbl, ast_expr_id(e)));
          if(await_res.has_awaits, {
            // Side-table by func_id (codegen reads it there — the analysis lands on
            // an inaccessible body clone, but func_id is stable for the codegen-read
            // closure). See register_closure_await_analysis.
            register_closure_await_analysis(func_id.clone(), await_res);
          });
        });
        // Phase 5 (closure codegen): refine the io.async closure's registered Func
        // type so its RESULT is the def-evaluated body type (concrete), not the
        // synthesized `_ret` SomeT. Codegen reads get_func_type(func_id) for the
        // prototype + the future result type; without this the closure's return
        // lowers to void* (`int32_t = void*` at the await result), and the closure
        // is dropped as hard-generic. Gated on mark_closure_for_codegen (so it also
        // runs on the re-eval the codegen reads, via the sticky prior-capture flag)
        // and only when the body type is concrete. Params stay as-is (the io.async
        // bundle param is supplied via the SM __yo_param slot).
        if(mark_closure_for_codegen, {
          match(
            expr_info_table_get(ctx.expr_info_table, ast_expr_id(anon_eb)),
            .Some(body_info2) => {
              (body_ty : TypeValue) = body_info2.ty;
              // TS anonymous-function.ts:975-978 — the body type might be a
              // SomeT whose resolved_concrete was set during evaluation
              // ("e.g., when the last expression is a binary op whose result
              // inherits the expected SomeType but has been resolved to a
              // concrete type"). A `return(x + y)` body types exactly so (the
              // return arg is evaluated against the fn's `_ret` SomeT —
              // begin.ts:1157-1165). Unwrap it BEFORE the concreteness gate,
              // or the refinement is skipped and the closure's return / the
              // io.async future result lower to void*.
              match(
                body_ty,
                .SomeT({ resolved_concrete : bt_cell }) => match(
                  bt_cell.get(usize(0)),
                  .Some(bt_rc) => {
                    body_ty = bt_rc;
                  },
                  .None => ()
                ),
                _ => ()
              );
              has_some := get_all_some_types(body_ty.clone()).len();
              if(has_some == usize(0), {
                // SOURCE labels (actual_param_labels), NOT the expected type's
                // labels — same L3 rule as corrected_func_type above. This
                // re-registration previously clobbered L3 with the EXPECTED
                // label (`e` from io.async's `Fn(e : E)`) for every closure it
                // touched: the C prototype then declared `e` while the body
                // referenced the source name (`io`) — "use of undeclared
                // identifier 'io'" (issues/yo-self-async-emission-cluster.md
                // item 2).
                //
                // REBUILD from `corrected_func_type`'s meta, do NOT use
                // t_func_simple — its default meta drops `param_is_ref`, and a
                // closure typed against `Impl(Fn(inout(v) : T) -> R)` then
                // re-registered with the flags erased binds `v` BY VALUE in
                // the specialized body eval (the sync/mutex with_lock
                // write-through arm: `v = i32(99)` FTT'd and `return v`
                // skipped the deref).
                rereg_ty := match(
                  corrected_func_type.clone(),
                  .Func(_l4ft, _l4pt, _l4it, _l4wt, _l4r, _l4m, _) => {
                    _l4nm := _l4m.*.clone();
                    _l4nm.param_labels = actual_param_labels.clone();
                    TypeValue.Func(_l4ft.clone(), param_types.clone(), _l4it.clone(), _l4wt.clone(), body_ty.clone(), box(_l4nm), ArrayList(TypeValue).new())
                  },
                  _ => t_func_simple(actual_param_labels.clone(), param_types.clone(), body_ty.clone())
                );
                register_func_type(func_id.clone(), rereg_ty);
                // Record the CONCRETE def-evaluated body type by FuncVal id.
                // Consumed by check_and_add_argument's Step-6 synthesis
                // (calls/helper.yo): a closure passed as a call ARGUMENT whose
                // declared return never resolved (`-> U`) otherwise binds the
                // callee's generic to ITSELF, and the callee's specialization
                // body eval then throws and unwinds the CALLER's statement
                // chain (the hollow-batch blast radius —
                // issues/retired/yo-self-hollow-test-batch-main.md, fourth round).
                // NOT for io.async closures: substituting the body type as
                // the given return perturbs io.async's own `_ret`/E-bundle
                // synthesis and FTTs the io.async statement (measured:
                // corpus io_async_str SELF-FAIL).
                // COMPTIME body types are excluded: a comptime_str/int/float
                // body (e.g. io.async's `(io : Io) => "hello async"`, whose
                // def-eval types comptime_str) must not bind a RUNTIME generic
                // slot — substituting it as the given return perturbed
                // io.async's own `_ret` synthesis (corpus io_async_str
                // SELF-FAIL; measured: label=action body=comptime_str, and
                // ctx.is_inside_io_async_call is FALSE at this point, so the
                // flag cannot be the gate).
                body_is_comptime := (
                  (is_comptime_string_type(body_ty) || is_comptime_int_type(body_ty))
                  || is_comptime_float_type(body_ty)
                );
                if(!(body_is_comptime), {
                  register_closure_body_type(func_id.clone(), body_ty);
                });
              });
            },
            .None => ()
          );
        });
      },
      .None => ()
    );
    // Capture checks (regular-fn-no-capture; Phase B ref-capture +
    // control-bound-capture for closures). `n_cap_fr` is the outer frame
    // count from before the parameter frame was pushed.
    match(
      body_eval_ctx.captured_variables,
      .Some(anon_caps) => if(anon_caps.len() > usize(0), {
        _check_anon_fn_captures(anon_caps, env, is_creating_closure, n_cap_fr, func_id.clone(), tok, exn);
      }),
      .None => ()
    );
    // Stash the body-eval captured variables so the capture struct can be built
    // after the parameter frame is popped (below) — mirrors closure_type.yo's
    // pop-then-create order. (Only the non-deferred path evaluates the body and
    // thus populates captures; a deferred generic closure has none → empty struct.)
    closure_body_caps = body_eval_ctx.captured_variables;
  });
  // Deferred generic body: TS trial-evaluates a CLONE to catch a concrete
  // return against the declared generic return type (`(value -> i32(0))`
  // checked against `fn(generic(T), value : T) -> T` must be rejected) —
  // checkDeferredGenericReturnType, anonymous-function.ts:773. Twin of the
  // direct-definition check in calls/function_type.yo — same skips: a trial
  // that throws is silently skipped, a trial type carrying SomeTs or
  // degenerating to unit cannot convict, and an expected bare SomeT that is
  // not this fn's own forall is bound by the call site.
  if(should_defer_body, {
    dgc_ret := match(function_type,.Func({ result : dgc_r }) => dgc_r, _ => t_unit());
    if(get_all_some_types(dgc_ret).len() > usize(0), {
      dgc_fv := EvalValue.FuncVal(
        box(
          FuncValData(
            forall_names : ArrayList(String).new(),
            params : ArrayList(String).new(),
            param_type_names : ArrayList(String).new(),
            evidence_params : ArrayList(String).new(),
            body : body_for_def_eval.clone(),
            cap_names : ArrayList(String).new(),
            cap_tys : ArrayList(TypeValue).new(),
            // THROWAWAY id: reusing the real func_id let trial registrations
            // shadow the real definition's (codegen emitted the trial clone).
            func_id : random_id(env.module_path)
          )
        ),
        ArrayList(EvalValue).new()
      );
      dgc_env := snapshot_env(env);
      dgc_ctx := create_function_body_evaluation_context(function_type, dgc_fv, dgc_env, ctx);
      dgc_out := ArrayList(AstExpr).new();
      dgc_fv_was := flow_violation_pending();
      _trial_eval_anon_body(body_for_def_eval.clone(), dgc_env, dgc_ctx, dgc_out);
      if(!(dgc_fv_was) && flow_violation_pending(), {
        clear_flow_violation();
      });
      match(
        dgc_out.get(usize(0)),
        .Some(dgc_body) => match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(dgc_body)),
          .Some(dgc_info) => {
            dgc_skip_cf := (has_control_flow(dgc_info.control_flow,.Unwind) && !(has_control_flow(dgc_info.control_flow,.Return)));
            dgc_is_ref := match(function_type,.Func({ meta : __fmd1 }) => __fmd1.*.result_is_ref, _ => false);
            dgc_expected := cond(
              dgc_is_ref => t_ptr(dgc_ret),
              true => dgc_ret
            );
            dgc_own_forall_skip := match(
              dgc_expected,
              .SomeT({ name : dgc_sname }) => {
                (dgc_found : bool) = false;
                (dgc_fi : usize) = usize(0);
                while(dgc_fi < forall_labels.len(), {
                  if(match(forall_labels.get(dgc_fi),.Some(l) => (l == dgc_sname),.None => false), {
                    dgc_found = true;
                  });
                  dgc_fi = (dgc_fi + usize(1));
                });
                !(dgc_found)
              },
              _ => false
            );
            dgc_trial_ty := dgc_info.ty;
            dgc_trial_abstract := (get_all_some_types(dgc_trial_ty).len() > usize(0));
            dgc_trial_degenerate := (is_unit_type(dgc_trial_ty) && !(is_unit_type(dgc_expected)));
            if((((!(dgc_skip_cf) && !(dgc_own_forall_skip)) && !(dgc_trial_abstract)) && !(dgc_trial_degenerate)) && !(are_types_compatible_exact(dgc_trial_ty, dgc_expected)), {
              dgc_exp_str := type_to_string(dgc_expected);
              dgc_got_str := type_to_string(dgc_trial_ty);
              exn.throw(
                dyn(
                  format_error_message(
                    tok,
                    `Incompatible function return type for:\n- Expected: ${dgc_exp_str}\n- Given  : ${dgc_got_str}`,
                    false,
                    .None
                  )
                )
              );
            });
          },
          .None => ()
        ),
        .None => ()
      );
    });
  });
  // -------------------------------------------------------------------------
  // Restore the parameter frame.
  // -------------------------------------------------------------------------
  env.pop_frame();
  // Build the capture struct for an io.async closure (empty for no-capture; works
  // for deferred-generic closures too, which simply have no recorded captures).
  // Mirrors closure_type.yo's pop-then-create. Set on the ExprInfo below so
  // generate_io_async_sync_call can resolve the SM's __capture field type.
  if(mark_closure_for_codegen, {
    cvwv := match(
      closure_body_caps,
      .None => Option(HashMap(String, FuncCapturedVarInfo)).None,
      .Some(cv) => if(cv.len() > usize(0), Option(HashMap(String, FuncCapturedVarInfo)).Some(enrich_captured_variables(cv, env)), Option(HashMap(String, FuncCapturedVarInfo)).None)
    );
    // Generate evaluated `___dup(name)` exprs for RC-typed captures BEFORE
    // building the capture struct — codegen emits them as the capture-field
    // initializers so the capture owns its own reference (mirrors TS
    // anonymous-function.ts:1154 + utils/closure.ts:393; missing this freed
    // the captured Command.status spawn storage under the running closure).
    dup_res := generate_captured_variable_dup_expressions(cvwv, env, ctx, exn);
    closure_capture_dups = dup_res.dup_exprs;
    cap_res := create_capture_type_and_value(Option(TypeValue).None, cvwv, env, tok);
    closure_capture_type = cap_res.capture_type;
    // Prefer an already-REGISTERED (larger) capture struct for this fid — see
    // register_closure_capture_info's keep-larger note: a re-eval that tracked
    // fewer captures must not shrink the struct the emitted body was (or will
    // be) rewritten against.
    match(
      get_closure_capture_info(func_id.clone()),
      .Some(prev_cci2) => {
        prev_nf2 := match(prev_cci2.capture_type,.Struct({ field_labels : pfl2 }) => pfl2.len(), _ => usize(0));
        cur_nf2 := match(
          closure_capture_type,
          .Some(cur_ct2) => match(cur_ct2,.Struct({ field_labels : cfl2 }) => cfl2.len(), _ => usize(0)),
          .None => usize(0)
        );
        if(prev_nf2 > cur_nf2, {
          closure_capture_type = Option(TypeValue).Some(prev_cci2.capture_type);
        });
      },
      .None => ()
    );
    // Record the capture struct type + defining frame level (n_cap_fr, the outer
    // frame count before the param frame was pushed) by func_id, so generate_function
    // can set the closure-capture codegen context (capture-access rewriting).
    match(
      closure_capture_type,
      .Some(ct) => register_closure_capture_info(func_id.clone(), ClosureCaptureInfo(capture_type : ct, frame_level : n_cap_fr)),
      .None => ()
    );
  });
  // -------------------------------------------------------------------------
  // Build and store the ExprInfo for this expression.
  // -------------------------------------------------------------------------
  // TS anonymous-function.ts:1183-1252: a CLOSURE whose expected type is a
  // SomeT wrapper TAKES ON that wrapper as its recorded type, with the
  // capture struct as its resolved concrete — so an Impl(Fn(...))-ANNOTATED
  // BINDING's compat check sees the SomeT, not the plain Func (the c01/c06
  // closure-battery hollow). Recorded on the VALUE COPY's resolved cell —
  // NOT the global register_some_resolved_concrete registry (that stamp
  // measured hollow regressions in fs/file + fs/temp; the cell is
  // value-scoped). Ported for the wrapper-has-Fn-in-requiredTraits case
  // only (the annotation shape); TS's synthetic `__impl_fn` wrapper for
  // where-clause-constrained generics (ts:1205-1216) is NOT ported — those
  // paths keep the plain Func type as before.
  // GATED to closures whose expected Fn-trait RESULT is CONCRETE: the
  // async pipeline registers the sync-future struct and io.await
  // refinement against the UNRESOLVED wrapper SomeT, and its closures'
  // declared result is the unresolved `T` — taking on the wrapper for
  // them broke all 12 io_async corpus files (SELF-FAIL: the FSM resume
  // call lost the closure-context argument; measured 2026-07-27, and
  // `ctx.is_inside_io_async_call` used to be FALSE here because only the
  // function.yo route set it — helper.yo's Step 7 now sets it too (the TS
  // helper.ts:1314 twin), so the flag gates io.async closures whose `T`
  // was pre-bound concrete by Step-6b — the four fsm/bundle corpus files
  // the concrete-result check alone admitted). A concrete result means a
  // fully-annotated binding shape (`(c : Impl(Fn(y : i32) -> i32)) = ...`),
  // which is exactly the c01/c06 case.
  (final_lambda_ty : TypeValue) = function_type;
  if(is_creating_closure && !(ctx.is_inside_io_async_call), {
    match(
      expected_ty,
      .SomeT(w_id, w_nm, w_fl, w_pt, w_rtt, w_rtl, w_ntt, w_ntl, w_ier, w_kft, w_rc) => {
        match(
          closure_capture_type,
          .Some(cap_t) => {
            (w_has_concrete_fn : bool) = false;
            (w_fn_trait : Option(TypeValue)) = Option(TypeValue).None;
            (wf_i : usize) = usize(0);
            while(wf_i < w_rtt.len(), {
              match(
                w_rtt.get(wf_i),
                .Some(w_rt) => if(is_fn_trait_type(w_rt), {
                  if(w_fn_trait.is_none(), {
                    w_fn_trait = Option(TypeValue).Some(w_rt);
                  });
                  match(
                    w_rt,
                    .FnTraitT({ call_result : w_cr }) => if(!(is_some_type(w_cr)), {
                      w_has_concrete_fn = true;
                    }),
                    _ => ()
                  );
                }),
                .None => ()
              );
              wf_i = (wf_i + usize(1));
            });
            // TS anonymous-function.ts:1195-1216 (`__impl_fn`): when the
            // wrapper's Fn bound comes from a WHERE CLAUSE (TS:
            // `!wrapperHasFnInRequired`), setting resolved = the bare capture
            // struct would strip the Fn trait info and subsequent where-clause
            // checks would fail. TS mints a synthetic `Impl(Fn(...))` SomeT
            // (`__impl_fn`, requiredTraits=[expectedFnTraitType],
            // resolvedConcreteType=captureType) and stamps it as F's resolved
            // concrete IN PLACE — one stable F identity at the return-type
            // mint, the body construction and the arg check.
            // yo-self divergence: the where-bound has already been MERGED into
            // `w_rtt` (the where-clause binding arc), so TS's
            // requiredTraits-membership test cannot discriminate. Annotation
            // wrappers are minted with the RESERVED name "Impl"
            // (builtins/impl_constraint.yo:171; synthesizer.yo:501 documents
            // the reservation) — any other name means a generic type variable
            // whose Fn bound arrived via a where clause.
            // Exclude the reserved annotation name "Impl" AND the NAMELESS
            // dyn-coercion wrappers (values/dyn.yo:336): the dyn/box pipeline
            // reads the wrapper's cell expecting the CAPTURE STRUCT directly
            // (ne_box_inner_ty), so an interposed `__impl_fn` level broke the
            // whole dyn corpus ("no member named 'call'").
            w_fn_from_where := ((w_nm != "Impl") && ((w_nm.len() > usize(0)) && w_fn_trait.is_some()));
            cond(
              w_fn_from_where => match(
                w_fn_trait,
                .Some(eft) => {
                  impl_rtt := ArrayList(TypeValue).new();
                  impl_rtt.push(eft.clone());
                  impl_rtl := ArrayList(usize).new();
                  impl_rtl.push(usize(0));
                  impl_fn_wrapper := TypeValue.SomeT(
                    generate_some_type_id(),
                    String.from("__impl_fn"),
                    usize(0),
                    TypeValue.TypeUni(usize(0)),
                    impl_rtt,
                    impl_rtl,
                    ArrayList(TypeValue).new(),
                    ArrayList(usize).new(),
                    false,
                    Option(TypeValue).None,
                    t_resolved_cell(cap_t)
                  );
                  // PER-CALL identity: TS stamps `wrapperType.resolvedConcrete
                  // Type = implFnWrapper` in place, but ITS wrapperType is a
                  // per-call freshened object. yo-self's `F` here shares ONE
                  // resolution cell across every call of the generic fn
                  // (substitution copies the cell HANDLE), so an in-place
                  // stamp makes the LAST closure win for every caller
                  // (measured: iter_filter_closure's three arms all rendered
                  // the third arm's capture struct). Seed a FRESH cell on the
                  // recorded COPY instead — the arg's recorded type feeds
                  // `fa_bound`, so the caller's return-type substitution and
                  // the body specialization both see THIS call's `__impl_fn`.
                  final_lambda_ty = TypeValue.SomeT(
                    w_id,
                    w_nm,
                    w_fl,
                    w_pt,
                    w_rtt,
                    w_rtl,
                    w_ntt,
                    w_ntl,
                    w_ier,
                    w_kft,
                    t_resolved_cell(impl_fn_wrapper)
                  );
                },
                .None => ()
              ),
              w_has_concrete_fn => {
                final_lambda_ty = TypeValue.SomeT(
                  w_id,
                  w_nm,
                  w_fl,
                  w_pt,
                  w_rtt,
                  w_rtl,
                  w_ntt,
                  w_ntl,
                  w_ier,
                  w_kft,
                  t_resolved_cell(cap_t)
                );
              },
              true => ()
            );
          },
          .None => ()
        );
      },
      _ => ()
    );
  });
  info := new_expr_info(env, final_lambda_ty);
  info.value = Option(EvalValue).Some(func_val);
  info.is_anonymous_function_definition = Option(bool).Some(true);
  // Phase 3: closure_function_value is not set (EvalValue is not Clone).
  // Downstream code falls back to reading info.value when closure_function_value is None.
  // io.async closures carry the capture-struct type for codegen (see above).
  info.capture_type = closure_capture_type;
  info.deferred_dup_expressions = closure_capture_dups;
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
export(evaluate_anonymous_function_implementation);
