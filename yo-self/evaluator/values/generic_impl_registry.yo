//! Generic impl registry — stores and matches `impl(forall(T), ReceiverType, …)` entries.
//!
//! 1:1 port of the generic-impl parts of `src/evaluator/values/impl.ts`.
//!
//! Key functions:
//!   `register_generic_impl`         — store a new generic impl entry.
//!   `find_matching_generic_impl`    — check if any registered generic impl matches a
//!                                     (concrete_type, trait_type) pair.
//!   `set_type_implements_trait_fn`  — install the function pointer used to check
//!                                     where-clause constraints (breaks the circular
//!                                     dependency between this file and trait_checking.yo).
//!
//! The registry is two parallel ArrayLists (keys + entry-lists) instead of a HashMap
//! to avoid dependency on HashMap(String, …) which itself needs generic impl resolution.
//!
//! Phase 3.5: Basic matching via `synthesize_types`. Where-clause checking and
//! `find_methods_from_generic_impls` are present as simplified implementations.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Exception } :: import("std/error");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_type, t_unit, t_some_t, generate_some_type_id } :: import("../../types/creators.yo");
{ is_some_type } :: import("../../types/guards.yo");
{ EvalValue, create_type_value } :: import("../../value.yo");
{ Environment, Variable, add_variable_to_env, get_variables_from_env, synthetic_token, clone_env }
:: import("../../env.yo");
{ get_value_of_some_type_from_env }
:: import("../../types/env_lookup.yo");
{ synthesize_types, SynthesizeOptions, SynthesizeResult, TypePair }
:: import("../types/synthesizer.yo");
{ format_error_message, ErrorKind }
:: import("../../error.yo");
// ---------------------------------------------------------------------------
// GenericImplEntry — mirrors TypeScript GenericImpl interface
// ---------------------------------------------------------------------------
/// One registered generic impl.
/// Mirrors `GenericImpl` in `src/evaluator/values/impl.ts`.
GenericImplEntry :: struct(
  /// Registry key — same as the trait type's `id` field (from `_trait_type_id`).
  trait_key : String,
  /// Names of forall type parameters, e.g. ["T", "U"].
  forall_names : ArrayList(String),
  /// Corresponding SomeT TypeValues, one per forall name.
  /// Used by `try_match_generic_impl` to populate the unification env.
  forall_some_types : ArrayList(TypeValue),
  /// Receiver type pattern, e.g. `Option(SomeT(T))`.
  /// Contains SomeT references that get bound during unification.
  receiver_type_pattern : TypeValue,
  /// The trait type (may be Unit for anonymous inherent impls).
  trait_type : TypeValue,
  /// Impl field names (method names and associated type labels).
  field_names : ArrayList(String),
  /// Impl field types.
  field_types : ArrayList(TypeValue),
  /// Impl field values (FuncVal, etc.).
  field_values : ArrayList(EvalValue),
  /// Environment captured at definition time.
  definition_env : Environment
);
// ---------------------------------------------------------------------------
// Registry storage (two parallel ArrayLists — avoids HashMap dependency)
// ---------------------------------------------------------------------------
/// Trait keys stored in registration order.
(g_impl_registry_keys : ArrayList(String)) = ArrayList(String).new();
/// Lists of entries, one ArrayList per key (parallel to g_impl_registry_keys).
(g_impl_registry_entry_lists : ArrayList(ArrayList(GenericImplEntry))) = ArrayList(ArrayList(GenericImplEntry)).new();
// ---------------------------------------------------------------------------
// Function-pointer for type_implements_trait (breaks circular import)
// ---------------------------------------------------------------------------
/// Type of `type_implements_trait_bool` from trait_checking.yo.
TypeImplementsTraitFn :: (fn(t : TypeValue, trait_type : TypeValue, env : Environment) -> bool);
/// Global slot — set once by `set_type_implements_trait_fn` (called from
/// trait_checking.yo after `type_implements_trait` is defined).
(g_type_implements_trait_fn : Option(TypeImplementsTraitFn)) = Option(TypeImplementsTraitFn).None;
/// Install the function pointer (called from trait_checking.yo init block).
set_type_implements_trait_fn :: (fn(f : TypeImplementsTraitFn) -> unit)({
  g_type_implements_trait_fn = Option(TypeImplementsTraitFn).Some(f);
});
// ---------------------------------------------------------------------------
// get_trait_key — mirrors `getBaseTraitKey` in impl.ts
// ---------------------------------------------------------------------------
/// Extract the registry key from a trait TypeValue.
/// Uses the `id` field of TraitT (the stable nominal ID).
/// Mirrors `getBaseTraitKey` which prefers `traitType.functionValue.funcId`.
get_trait_key :: (fn(trait_ty : TypeValue) -> String)(
  match(
    trait_ty,
    .TraitT(_, _, _, _, id, _, _, _) => id,
    .FnTraitT(base_name, _, _, _, _, _, _) => base_name,
    .FutureTraitT(base_name, _, _, _, _) => base_name,
    _ => String.from("")
  )
);
// ---------------------------------------------------------------------------
// register_generic_impl
// ---------------------------------------------------------------------------
/// Register a new generic impl entry.
/// Mirrors `registerGenericImpl` in impl.ts.
register_generic_impl :: (fn(entry : GenericImplEntry) -> unit)({
  key := entry.trait_key.clone();
  // Find existing bucket for this key, or create a new one.
  (key_idx : Option(usize)) = Option(usize).None;
  (ki : usize) = usize(0);
  (n_keys : usize) = g_impl_registry_keys.len();
  while(ki < n_keys, {
    existing_key := match(g_impl_registry_keys.get(ki),.Some(k) => k,.None => String.from(""));
    if(existing_key == key, {
      key_idx = Option(usize).Some(ki);
      ki = n_keys; // break
    });
    ki = (ki + usize(1));
  });
  match(
    key_idx,
    .Some(idx) => {
      // Append to existing list.
      match(
        g_impl_registry_entry_lists.get(idx),
        .Some(list) => {
          list.push(entry);
        },
        .None => ()
      );
    },
    .None => {
      // New key — add parallel entries.
      new_list := ArrayList(GenericImplEntry).new();
      new_list.push(entry);
      g_impl_registry_keys.push(key);
      g_impl_registry_entry_lists.push(new_list);
    }
  );
});
// ---------------------------------------------------------------------------
// try_match_generic_impl
// ---------------------------------------------------------------------------
//
// Mirrors `tryMatchGenericImpl` in impl.ts — uses `synthesize_types` to unify
// the receiver type pattern against the concrete type.
//
// Phase 3.5 simplifications vs TypeScript:
// - No `valueSubstitutions` (only type params supported).
// - No struct env fallback for erasure (simpler struct lookup).
// - Where-clause constraints skipped (no `g_type_implements_trait_fn` check yet
//   beyond returning true if function pointer is set).
// ---------------------------------------------------------------------------
/// True if `entry` matches `concrete_type` in `env`.
try_match_generic_impl :: (
  fn(
    concrete_type : TypeValue,
    entry : GenericImplEntry,
    env : Environment
  ) -> bool
)({
  // 1. Resolve SomeT — if still unresolved, cannot match.
  (resolved_concrete : TypeValue) = concrete_type;
  if(is_some_type(concrete_type), {
    resolved := get_value_of_some_type_from_env(env, concrete_type);
    if(is_some_type(resolved), {
      return(false); // Unresolved type param — cannot match.
    });
    resolved_concrete = resolved;
  });
  // 2. Build unify_env: clone the env and push a fresh frame, add all forall SomeTs.
  (unify_env : Environment) = clone_env(env);
  _ := unify_env.push_frame(false);
  (ui : usize) = usize(0);
  (n_forall : usize) = entry.forall_names.len();
  while(ui < n_forall, {
    fa_name := match(
      entry.forall_names.get(ui),
      .Some(n) => n,
      .None => {
        ui = (ui + usize(1));
        continue;
      }
    );
    fa_some := match(
      entry.forall_some_types.get(ui),
      .Some(s) => s,
      .None => {
        ui = (ui + usize(1));
        continue;
      }
    );
    _ := add_variable_to_env(
      unify_env,
      fa_name,
      t_type(),
      Option(EvalValue).Some(create_type_value(fa_some)),
      true,
      // is_compile_time_only
      false,
      false,
      false,
      synthetic_token(fa_name, env.module_path)
    );
    ui = (ui + usize(1));
  });
  // 3. Try synthesize_types(receiver_pattern, unify_env, concrete_type, env).
  //    If it throws, return false (no match).
  (matched : bool) = false;
  exn_match := Exception(
    throw : (
      (err) -> {
        // Synthesis failed → no match.
        _ := err;
        unwind(false);
      }
    )
  );
  checked := ArrayList(TypePair).new();
  opts := Option(SynthesizeOptions).None;
  synth_result := synthesize_types(
    entry.receiver_type_pattern,
    unify_env,
    resolved_concrete,
    env,
    checked,
    opts,
    exn_match
  );
  // Synthesis succeeded — all forall params should now be bound in expected_env.
  // Verify each forall param was actually bound to a concrete type.
  (all_bound : bool) = true;
  (vi : usize) = usize(0);
  while((vi < n_forall) && all_bound, {
    fa_name2 := match(
      entry.forall_names.get(vi),
      .Some(n) => n,
      .None => {
        vi = (vi + usize(1));
        continue;
      }
    );
    fa_some2 := match(
      entry.forall_some_types.get(vi),
      .Some(s) => s,
      .None => {
        vi = (vi + usize(1));
        continue;
      }
    );
    // Look up the binding: the SomeT should have been replaced in unify_env.
    bound_type := get_value_of_some_type_from_env(synth_result.expected_env, fa_some2);
    if(is_some_type(bound_type), {
      // Try name-based fallback: look up fa_name2 directly in expected_env.
      name_vars := get_variables_from_env(synth_result.expected_env, fa_name2);
      (n_nvars : usize) = name_vars.len();
      if(n_nvars > usize(0), {
        last_nvar := match(name_vars.get(n_nvars - usize(1)),.Some(v) => v,.None => return(true));
        match(
          last_nvar.value,
          .Some(ev) => {
            match(
              ev,
              .TypeVal(b) => {
                if(!(is_some_type(b.*)), (), // Found a concrete binding via name — still count as bound.
                {
                  all_bound = false;
                });
              },
              _ => {
                all_bound = false;
              }
            );
          },
          .None => {
            all_bound = false;
          }
        );
      }, {
        all_bound = false;
      });
    });
    vi = (vi + usize(1));
  });
  if(all_bound, {
    matched = true;
  });
  matched
});
// ---------------------------------------------------------------------------
// find_matching_generic_impl
// ---------------------------------------------------------------------------
/// Check if any registered generic impl matches (concrete_type, trait_type, env).
/// Returns true if a match is found.
///
/// Mirrors `findMatchingGenericImpl` in impl.ts (boolean result only).
find_matching_generic_impl :: (
  fn(
    concrete_type : TypeValue,
    trait_type : TypeValue,
    env : Environment
  ) -> bool
)({
  key := get_trait_key(trait_type);
  if(key.is_empty(), {
    return(false);
  });
  // Find the entry list for this key.
  (entry_list_opt : Option(ArrayList(GenericImplEntry))) = Option(ArrayList(GenericImplEntry)).None;
  (ki : usize) = usize(0);
  (n_keys : usize) = g_impl_registry_keys.len();
  while(ki < n_keys, {
    k := match(g_impl_registry_keys.get(ki),.Some(k) => k,.None => String.from(""));
    if(k == key, {
      entry_list_opt = g_impl_registry_entry_lists.get(ki);
      ki = n_keys; // break
    });
    ki = (ki + usize(1));
  });
  (entries : ArrayList(GenericImplEntry)) = match(
    entry_list_opt,
    .Some(l) => l,
    .None => {
      return(false);
    }
  );
  (n_entries : usize) = entries.len();
  (ei : usize) = usize(0);
  while(ei < n_entries, {
    entry := match(
      entries.get(ei),
      .Some(e) => e,
      .None => {
        ei = (ei + usize(1));
        continue;
      }
    );
    if(try_match_generic_impl(concrete_type, entry, env), {
      return(true);
    });
    ei = (ei + usize(1));
  });
  false
});
// ---------------------------------------------------------------------------
// MethodCandidate — return type for find_methods_from_generic_impls
// ---------------------------------------------------------------------------
/// A method (field) from a matched generic impl.
MethodCandidate :: struct(
  method_type : TypeValue,
  method_value : Option(EvalValue)
);
// ---------------------------------------------------------------------------
// find_methods_from_generic_impls
// ---------------------------------------------------------------------------
/// Search ALL registered generic impls for matching entries that have a field
/// with `method_name`. Returns candidates (unspecialized).
///
/// Simplified port of `findMethodsFromGenericImpls` — no specialization,
/// just returns the original type/value for the field.
find_methods_from_generic_impls :: (
  fn(
    concrete_type : TypeValue,
    method_name : String,
    env : Environment
  ) -> ArrayList(MethodCandidate)
)({
  results := ArrayList(MethodCandidate).new();
  // Resolve SomeT.
  (resolved : TypeValue) = concrete_type;
  if(is_some_type(concrete_type), {
    r := get_value_of_some_type_from_env(env, concrete_type);
    if(!(is_some_type(r)), {
      resolved = r;
    });
  });
  // Iterate all key buckets.
  n_keys := g_impl_registry_keys.len();
  (ki : usize) = usize(0);
  while(ki < n_keys, {
    entry_list := match(
      g_impl_registry_entry_lists.get(ki),
      .Some(l) => l,
      .None => {
        ki = (ki + usize(1));
        continue;
      }
    );
    n_entries := entry_list.len();
    (ei : usize) = usize(0);
    while(ei < n_entries, {
      entry := match(
        entry_list.get(ei),
        .Some(e) => e,
        .None => {
          ei = (ei + usize(1));
          continue;
        }
      );
      if(!(try_match_generic_impl(resolved, entry, env)), {
        ei = (ei + usize(1));
        continue;
      });
      // Found a matching impl — search for the method field.
      n_fields := entry.field_names.len();
      (fi : usize) = usize(0);
      while(fi < n_fields, {
        fname := match(
          entry.field_names.get(fi),
          .Some(n) => n,
          .None => {
            fi = (fi + usize(1));
            continue;
          }
        );
        if(fname == method_name, {
          ftype := match(
            entry.field_types.get(fi),
            .Some(t) => t,
            .None => TypeValue.Unit
          );
          fvalue := entry.field_values.get(fi);
          results.push(
            MethodCandidate(
              method_type : ftype,
              method_value : fvalue
            )
          );
        });
        fi = (fi + usize(1));
      });
      ei = (ei + usize(1));
    });
    ki = (ki + usize(1));
  });
  results
});
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(GenericImplEntry, MethodCandidate);
export(TypeImplementsTraitFn);
export(set_type_implements_trait_fn, get_trait_key);
export(register_generic_impl);
export(try_match_generic_impl);
export(find_matching_generic_impl);
export(find_methods_from_generic_impls);
