//! evaluate_string_literal — evaluates string literal expressions.
//!
//! 1:1 port of `src/evaluator/values/string.ts`.
//!
//! Note: StrLit.raw stores the raw token text *including* surrounding `"` delimiters,
//! unlike the TypeScript which strips them via JSON.parse.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_set } :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TokenKind } :: import("../../token.yo");
{ t_comptime_string } :: import("../../types/creators.yo");
{ Exception } :: import("std/error");
{ format_error_message } :: import("../../error.yo");
evaluate_string_literal :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : *(EvalContext),
    exn : Exception
  ) -> AstExpr
)({
  tok := ast_expr_token(expr);
  if(!(tok.kind == TokenKind.StringLit), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          `Expected string literal, got ${tok.value}`,
          false,
          .None
        )
      )
    );
  });
  val := EvalValue.StrLit(tok.value);
  info := new_expr_info(env, t_comptime_string());
  info.value =.Some(val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
export(evaluate_string_literal);
