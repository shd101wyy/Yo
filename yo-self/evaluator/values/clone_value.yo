//! clone_value — deep-clone a compile-time `EvalValue`.
//!
//! Phase 2w stub: returns the value unchanged (identity clone).
//!
//! In the full evaluator (Phase 3), this will perform a proper structural
//! deep clone so that `arr2 :: arr1` creates an independent copy and
//! mutations to one variable do not affect the other.
//!
//! Mirrors `cloneValue` in `src/evaluator/values/clone-value.ts`.

{ EvalValue } :: import "../value.yo";

/// Deep-clone `v`.  Phase 2w stub — returns `v` unchanged.
///
/// Mirrors `cloneValue` in `src/evaluator/values/clone-value.ts`.
clone_value :: (fn(v : EvalValue) -> EvalValue)(v);

export clone_value;
