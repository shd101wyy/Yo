//! clone_value — deep-clone a compile-time `EvalValue`.
//!
//! Phase 3d: full structural deep-clone implementation.
//!
//! `preserve_pointer_refs = true` (the common case): `PtrVal`
//! is returned unchanged to preserve reference semantics.
//! `preserve_pointer_refs = false` (CTFE checking): all compound types
//! including pointers are recursively cloned so that mutations to the clone
//! do not affect the original environment.
//!
//! The TypeScript `targetValueMapping` (to maintain aliasing between cloned
//! pointers inside the same environment) is not yet ported — each Box gets an
//! independent clone, which is sufficient for Phase 3 bootstrap purposes.
//!
//! Mirrors `cloneValue` in `src/evaluator/values/clone-value.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ EvalValue } :: import("../../value.yo");
/// Deep-clone `v`.
///
/// When `preserve_pointer_refs` is `true` (default usage), `PtrVal`
/// is returned unchanged to preserve reference semantics.
/// When `false`, every node is recursively cloned (used in CTFE checking).
///
/// Mirrors `cloneValue` in `src/evaluator/values/clone-value.ts`.
clone_value :: (fn(v : EvalValue, preserve_pointer_refs : bool) -> EvalValue)(
  match(
    v,
    // Primitive / immutable — return as-is
    .UnitVal => EvalValue.UnitVal,
    .BoolVal(_) => v,
    .IntLit(_) => v,
    .FloatLit(_) => v,
    .StrLit(_) => v,
    .VarRef(_) => v,
    .BreakVal => v,
    .ContinueVal => v,
    .FuncVal(_, _) => v,
    .TypeVal(_) => v,
    .ExprVal(_) => v,
    .UnknownVal(_, _) => v,
    // ReturnVal — recursively clone the wrapped value
    .ReturnVal(val : val_box, ty : ty) =>
      EvalValue.ReturnVal(val : recur(val_box, preserve_pointer_refs), ty : ty.clone()),
    // PtrVal — preserve or deep-clone depending on flag
    .PtrVal(target : tgt_box, index : idx) =>
      cond(
        (preserve_pointer_refs) => v,
        true => EvalValue.PtrVal(target : recur(tgt_box, preserve_pointer_refs), index : idx)
      ),
    // EnumVal — recursively clone each field
    .EnumVal(variant : vname, fields : flds) => {
      new_fields := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < flds.len(), {
        elem := match(flds.get(i),.Some(e) => e,.None => EvalValue.UnitVal);
        new_fields.push(recur(elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      EvalValue.EnumVal(variant : vname, fields : new_fields)
    },
    // StructVal — recursively clone field_values
    .StructVal(ty_name : tname, field_names : fnames, field_values : fvals) => {
      new_fvals := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < fvals.len(), {
        elem := match(fvals.get(i),.Some(e) => e,.None => EvalValue.UnitVal);
        new_fvals.push(recur(elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      EvalValue.StructVal(ty_name : tname, field_names : fnames, field_values : new_fvals)
    },
    // TupleVal — recursively clone fields
    .TupleVal(fields : flds) => {
      new_fields := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < flds.len(), {
        elem := match(flds.get(i),.Some(e) => e,.None => EvalValue.UnitVal);
        new_fields.push(recur(elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      EvalValue.TupleVal(fields : new_fields)
    },
    // ArrayVal — recursively clone elements
    .ArrayVal(elements : elems) => {
      new_elems := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < elems.len(), {
        elem := match(elems.get(i),.Some(e) => e,.None => EvalValue.UnitVal);
        new_elems.push(recur(elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      EvalValue.ArrayVal(elements : new_elems)
    },
    // TraitVal — recursively clone field_values (each is Option(EvalValue))
    .TraitVal(ty_name : tname, field_names : fnames, field_values : fvals) => {
      new_fvals := ArrayList(Option(EvalValue)).new();
      i := usize(0);
      while(i < fvals.len(), {
        opt_f := match(fvals.get(i),.Some(o) => o,.None => Option(EvalValue).None);
        cloned_opt := match(
          opt_f,
          .None => Option(EvalValue).None,
          .Some(f) => Option(EvalValue).Some(recur(f, preserve_pointer_refs))
        );
        new_fvals.push(cloned_opt);
        i = (i + usize(1));
      });
      EvalValue.TraitVal(ty_name : tname, field_names : fnames, field_values : new_fvals)
    },
    // ComptimeListVal — recursively clone elements
    .ComptimeListVal(elements : elems) => {
      new_elems := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < elems.len(), {
        elem := match(elems.get(i),.Some(e) => e,.None => EvalValue.UnitVal);
        new_elems.push(recur(elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      EvalValue.ComptimeListVal(elements : new_elems)
    }
  )
);
export(clone_value);
