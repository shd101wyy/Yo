//! evaluator/builtins/derive — evaluate_derive.
//!
//! Phase 3 implementation. 1:1 port of `src/evaluator/builtins/derive.ts`.
//!
//! Supports:
//!   derive([forall(...)], [where(...)], TargetType, [where(...)], Trait1, Trait2, ...)
//!
//! Key difference from TypeScript: we use the global g_derive_rules registry
//! (from derive_rule.yo) instead of deriveRule fields on FunctionValue/TraitType.
//! Trait args are resolved by expression-level name (not by evaluating the trait arg).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_FORALL,
  BK_WHERE
} :: import("../../expr.yo");
{
  Environment,
  Variable,
  add_variable_to_env,
  synthetic_token
} :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_type } :: import("../../types/creators.yo");
{ generate_expr_from_code } :: import("../../parser.yo");
{ EvalValue, FuncValData, create_unknown_val_with_name } :: import("../../value.yo");
{ EvalContext, FuncOrAsyncBlockCtx } :: import("../context.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ evaluate_begin_expression } :: import("../exprs/begin.yo");
{ extract_derive_key, get_derive_rule } :: import("./derive_rule.yo");
{ random_id } :: import("../../utils.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// call_registered_derive_rule
//
// Calls a registered derive rule function with:
//   arg0: TypeVal(target_type)
//   arg1: StructVal("DeriveContext", {target, forall_params, where_clause})
//   arg2: ComptimeListVal(trait_params as ExprVals)
//
// Returns the env after evaluating the generated impl expression.
// Mirrors `callRegisteredDeriveRule` in `src/evaluator/builtins/derive.ts`.
// ---------------------------------------------------------------------------
call_registered_derive_rule :: (
  fn(
    derive_rule_val : EvalValue,
    target_type : TypeValue,
    target_type_expr : AstExpr,
    forall_arg_opt : Option(AstExpr),
    where_arg_opt : Option(AstExpr),
    trait_arg_expr : AstExpr,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Environment
)({
  tok := ast_expr_token(trait_arg_expr);
  // Build the DeriveContext StructVal.
  // target field: ExprVal wrapping the target type expression.
  target_ev := EvalValue.ExprVal(box(target_type_expr));
  // forall_params field: Option(Expr) → EnumVal.
  forall_inner := ArrayList(EvalValue).new();
  forall_pms_ev := match(
    forall_arg_opt,
    .Some(forall_expr) => {
      forall_inner.push(EvalValue.ExprVal(box(forall_expr)));
      EvalValue.EnumVal(String.from(".Some"), forall_inner)
    },
    .None => EvalValue.EnumVal(String.from(".None"), ArrayList(EvalValue).new())
  );
  // where_clause field: Option(Expr) → EnumVal.
  where_inner := ArrayList(EvalValue).new();
  where_pms_ev := match(
    where_arg_opt,
    .Some(where_expr) => {
      where_inner.push(EvalValue.ExprVal(box(where_expr)));
      EvalValue.EnumVal(String.from(".Some"), where_inner)
    },
    .None => EvalValue.EnumVal(String.from(".None"), ArrayList(EvalValue).new())
  );
  // Build DeriveContext StructVal.
  dc_field_names := ArrayList(String).new();
  dc_field_names.push(String.from("target"));
  dc_field_names.push(String.from("forall_params"));
  dc_field_names.push(String.from("where_clause"));
  dc_field_vals := ArrayList(EvalValue).new();
  dc_field_vals.push(target_ev);
  dc_field_vals.push(forall_pms_ev);
  dc_field_vals.push(where_pms_ev);
  dc_ev := EvalValue.StructVal(String.from("DeriveContext"), dc_field_names, dc_field_vals);
  // Build trait_params: ComptimeListVal of ExprVals extracted from trait arg.
  trait_param_evs := ArrayList(EvalValue).new();
  match(
    trait_arg_expr,
    .FnCall(_, _, ta_args, _, _) => {
      (ti : usize) = usize(0);
      while(ti < ta_args.len(), {
        match(
          ta_args.get(ti),
          .Some(ta) => {
            trait_param_evs.push(EvalValue.ExprVal(box(ta)));
          },
          .None => ()
        );
        ti = (ti + usize(1));
      });
    },
    .Atom(_, _) => ()
  );
  trait_params_ev := EvalValue.ComptimeListVal(trait_param_evs);
  // Now replicate the FuncVal call pattern from function.yo.
  result_env := match(
    derive_rule_val,
    .FuncVal(__fvm10, cap_vals) => {
      forall_names := __fvm10.*.forall_names;
      param_names := __fvm10.*.params;
      param_type_names := __fvm10.*.param_type_names;
      evidence_names := __fvm10.*.evidence_params;
      body_box := __fvm10.*.body;
      cap_names := __fvm10.*.cap_names;
      cap_tys := __fvm10.*.cap_tys;
      n_p := param_names.len();
      n_ev := evidence_names.len();
      // Build evaled_arg_infos with 3 pre-constructed entries.
      evaled_arg_infos := ArrayList(ExprInfo).new();
      arg0 := new_expr_info(caller_env, t_type());
      arg0.value = Option(EvalValue).Some(EvalValue.TypeVal(target_type.clone()));
      evaled_arg_infos.push(arg0);
      // The ctx/trait_params arg ExprInfos must carry their DECLARED types
      // (DeriveContext / ComptimeList(Expr)) — NOT t_unit(). The param
      // binding below uses `arg_inf.ty` as the bound variable's type, and
      // `ctx.make_impl(...)` resolves `make_impl` by the receiver type's id
      // (env.yo get_receiver_methods); a `unit`-typed `ctx` finds no method.
      // Evaluate the type exprs to get the SAME ids the `impl(DeriveContext,
      // …)` registration used. Mirrors TS evaluating `DeriveContext(...)` to
      // obtain the real type (derive.ts:608-625).
      dc_type := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluate_expression(generate_expr_from_code(String.from("DeriveContext").clone(), exn), caller_env, ctx))),
        .Some(i) => match(i.value,.Some(v) => match(v,.TypeVal(t) => t, _ => t_unit()),.None => t_unit()),
        .None => t_unit()
      );
      tps_type := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluate_expression(generate_expr_from_code(String.from("ComptimeList(Expr)").clone(), exn), caller_env, ctx))),
        .Some(i) => match(i.value,.Some(v) => match(v,.TypeVal(t) => t, _ => t_unit()),.None => t_unit()),
        .None => t_unit()
      );
      arg1 := new_expr_info(caller_env, dc_type);
      arg1.value = Option(EvalValue).Some(dc_ev);
      evaled_arg_infos.push(arg1);
      arg2 := new_expr_info(caller_env, tps_type);
      arg2.value = Option(EvalValue).Some(trait_params_ev);
      evaled_arg_infos.push(arg2);
      // Build a fresh environment for the function body.
      fresh_env := Environment.new(caller_env.module_path);
      // Bind captures.
      (cap_i : usize) = usize(0);
      n_cap := cap_names.len();
      while(cap_i < n_cap, {
        cn := match(cap_names.get(cap_i),.Some(n) => n,.None => String.from(""));
        ct := match(cap_tys.get(cap_i),.Some(t) => t,.None => t_unit());
        cap_v := match(
          cap_vals.get(cap_i),
          .Some(v) => Option(EvalValue).Some(v),
          .None => Option(EvalValue).None
        );
        is_ct_only := match(cap_v,.Some(_) => true,.None => false);
        _add_cap := add_variable_to_env(
          fresh_env,
          cn,
          ct,
          cap_v,
          is_ct_only,
          false,
          false,
          false,
          synthetic_token(cn, caller_env.module_path)
        );
        cap_i = (cap_i + usize(1));
      });
      // Push frame and bind __recur_fn.
      _fr := fresh_env.push_frame(false);
      fv_for_recur := EvalValue.FuncVal(
        box(
          FuncValData(
            forall_names : forall_names,
            params : param_names,
            param_type_names : param_type_names,
            evidence_params : evidence_names,
            body : body_box,
            cap_names : cap_names,
            cap_tys : cap_tys,
            func_id : random_id(caller_env.module_path)
          )
        ),
        cap_vals
      );
      _add_recur := add_variable_to_env(
        fresh_env,
        String.from("__recur_fn"),
        t_unit(),
        Option(EvalValue).Some(fv_for_recur),
        true,
        false,
        false,
        false,
        synthetic_token(String.from("__recur_fn"), caller_env.module_path)
      );
      // Infer forall type params from argument types.
      n_forall := forall_names.len();
      (fa_i : usize) = usize(0);
      while(fa_i < n_forall, {
        fa_name := match(forall_names.get(fa_i),.Some(n) => n,.None => String.from(""));
        n_ptn := param_type_names.len();
        (ptn_i : usize) = usize(0);
        (fa_bound : bool) = false;
        while((ptn_i < n_ptn) && (!(fa_bound)), {
          ptn := match(param_type_names.get(ptn_i),.Some(n) => n,.None => String.from(""));
          if(ptn == fa_name, {
            arg_inf := match(
              evaled_arg_infos.get(ptn_i),
              .Some(i) => i,
              .None => new_expr_info(caller_env, t_unit())
            );
            _add_forall := add_variable_to_env(
              fresh_env,
              fa_name,
              TypeValue.TypeUni(usize(0)),
              Option(EvalValue).Some(EvalValue.TypeVal(arg_inf.ty)),
              true,
              false,
              false,
              false,
              synthetic_token(fa_name, caller_env.module_path)
            );
            fa_bound = true;
          });
          ptn_i = (ptn_i + usize(1));
        });
        fa_i = (fa_i + usize(1));
      });
      // Bind regular params.
      (pi : usize) = usize(0);
      while(pi < n_p, {
        pname := match(param_names.get(pi),.Some(n) => n,.None => String.from(""));
        arg_inf := match(evaled_arg_infos.get(pi),.Some(i) => i,.None => new_expr_info(caller_env, t_unit()));
        is_ct := match(arg_inf.value,.Some(_) => true,.None => false);
        _add_p := add_variable_to_env(
          fresh_env,
          pname,
          arg_inf.ty,
          arg_inf.value,
          is_ct,
          false,
          false,
          false,
          synthetic_token(pname, caller_env.module_path)
        );
        pi = (pi + usize(1));
      });
      // Bind evidence params.
      (evi : usize) = usize(0);
      while(evi < n_ev, {
        ev_name := match(evidence_names.get(evi),.Some(n) => n,.None => String.from(""));
        ev_inf := match(evaled_arg_infos.get(n_p + evi),.Some(i) => i,.None => new_expr_info(caller_env, t_unit()));
        is_ct_ev := match(ev_inf.value,.Some(_) => true,.None => false);
        _add_ev := add_variable_to_env(
          fresh_env,
          ev_name,
          ev_inf.ty,
          ev_inf.value,
          is_ct_ev,
          false,
          false,
          true,
          synthetic_token(ev_name, caller_env.module_path)
        );
        evi = (evi + usize(1));
      });
      // Set function body context.
      old_fn_ctx := ctx.is_evaluating_function_body_or_async_block;
      old_ret_ty := ctx.enclosing_function_return_type;
      fn_ctx := FuncOrAsyncBlockCtx(
        kind :.FunctionBody,
        func_type : Option(TypeValue).None,
        func_value : Option(EvalValue).Some(derive_rule_val),
        eval_env : fresh_env
      );
      ctx.is_evaluating_function_body_or_async_block = Option(FuncOrAsyncBlockCtx).Some(fn_ctx);
      ctx.enclosing_function_return_type = Option(TypeValue).Some(t_unit());
      // Evaluate the function body.
      evaled_body := evaluate_begin_expression(
        body_box.*,
        fresh_env,
        ctx,
        ArrayList(Variable).new(),
        true,
        exn
      );
      ctx.is_evaluating_function_body_or_async_block = old_fn_ctx;
      ctx.enclosing_function_return_type = old_ret_ty;
      body_info := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_body)),
        .Some(i) => i,
        .None => new_expr_info(caller_env, t_unit())
      );
      // Extract the ExprVal from the body result.
      body_val := match(
        body_info.value,
        .Some(v) => v,
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                tok,
                String.from("derive: derive rule returned no value"),
                false,
                .None
              )
            )
          );
          EvalValue.UnitVal
        }
      );
      result_expr := match(
        body_val,
        .ExprVal(expr_box) => expr_box.*,
        _ => {
          exn.throw(
            dyn(
              format_error_message(
                tok,
                String.from("derive: derive rule must return(comptime(Expr))"),
                false,
                .None
              )
            )
          );
          make_err_expr()
        }
      );
      // Evaluate the returned Expr in caller_env.
      evaled_result := evaluate_expression(result_expr, caller_env, ctx);
      result_info := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_result)),
        .Some(i) => i,
        .None => new_expr_info(caller_env, t_unit())
      );
      result_info.env
    },
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive: registered derive rule is not a function"),
            false,
            .None
          )
        )
      );
      caller_env
    }
  );
  result_env
});
// ---------------------------------------------------------------------------
// process_trait_arg
//
// Look up and dispatch a single trait argument in derive().
// Mirrors `processTraitArg` in `src/evaluator/builtins/derive.ts`.
// ---------------------------------------------------------------------------
process_trait_arg :: (
  fn(
    trait_arg_expr : AstExpr,
    target_type : TypeValue,
    target_type_expr : AstExpr,
    env : Environment,
    forall_arg_opt : Option(AstExpr),
    where_arg_opt : Option(AstExpr),
    ctx : EvalContext,
    exn : Exception
  ) -> Environment
)({
  tok := ast_expr_token(trait_arg_expr);
  // Extract the trait name from the expression (expression-level key).
  key_opt := extract_derive_key(trait_arg_expr);
  key := match(
    key_opt,
    .Some(k) => k,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive: trait argument must be a trait name or trait constructor call"),
            false,
            .None
          )
        )
      );
      String.from("")
    }
  );
  // Look up the registered derive rule.
  rule_opt := get_derive_rule(key);
  derive_rule_val := match(
    rule_opt,
    .Some(r) => r,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            `derive: trait '${key}' does not have a derive rule. Use derive_rule() to register one.`,
            false,
            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  // Call the registered derive rule.
  call_registered_derive_rule(
    derive_rule_val,
    target_type,
    target_type_expr,
    forall_arg_opt,
    where_arg_opt,
    trait_arg_expr,
    env,
    ctx,
    exn
  )
});
// ---------------------------------------------------------------------------
// evaluate_derive
//
// Entry point for `derive(Type, Trait1, Trait2, ...)`.
// Argument layout:
//   derive([forall(...)], [where(...)], TargetType, [where(...)], Trait1, Trait2, ...)
// Mirrors `evaluateDerive` in `src/evaluator/builtins/derive.ts`.
// ---------------------------------------------------------------------------
evaluate_derive :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  tok := ast_expr_token(expr);
  // Early return if not in executing context.
  if(ctx.is_validating_function_definition || !(ctx.is_executing), {
    info := new_expr_info(env, t_unit());
    info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    return(expr);
  });
  // Extract arguments.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  if(args.len() < usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          String.from("derive requires at least 2 arguments: derive(Type, Trait1, ...)."),
          false,
          .None
        )
      )
    );
  });
  (arg_idx : usize) = usize(0);
  (forall_arg_opt : Option(AstExpr)) = Option(AstExpr).None;
  (where_arg_opt : Option(AstExpr)) = Option(AstExpr).None;
  // Check for optional forall(...).
  is_forall := match(
    args.get(arg_idx),
    .Some(a) => ast_expr_is_fn_call_of(a, BK_FORALL,.None),
    .None => false
  );
  if(is_forall, {
    forall_arg_opt = match(args.get(arg_idx),.Some(a) => Option(AstExpr).Some(a),.None => Option(AstExpr).None);
    arg_idx = (arg_idx + usize(1));
    // Introduce forall type variables into env so that target type expressions
    // like Pair(T) can be evaluated.
    forall_expr := match(forall_arg_opt,.Some(fa) => fa,.None => make_err_expr());
    forall_params := match(
      forall_expr,
      .FnCall(_, _, fps, _, _) => fps,
      .Atom(_, _) => ArrayList(AstExpr).new()
    );
    _fr := env.push_frame(false);
    (fpi : usize) = usize(0);
    while(fpi < forall_params.len(), {
      fp := match(forall_params.get(fpi),.Some(a) => a,.None => make_err_expr());
      // Handle both `T` (Atom) and `T : Type` (FnCall(":", [T, Type])) forms.
      fp_name := match(
        fp,
        .Atom(_, ftok) => ftok.value,
        .FnCall(_, func_b, fa2, _, _) => match(
          func_b.*,
          .Atom(_, op_tok) => cond(
            (op_tok.value == ":") => match(
              fa2.get(usize(0)),
              .Some(na) => match(na,.Atom(_, ntok) => ntok.value,.FnCall(_, _, _, _, _) => String.from("")),
              .None => String.from("")
            ),
            true => String.from("")
          ),
          .FnCall(_, _, _, _, _) => String.from("")
        )
      );
      if(fp_name.len() > usize(0), {
        // Mirror TS `createUnknownValue(createType0(), { variableName })`: a
        // Type-universe slot promotes to `TypeVal(SomeType(name))` so the target
        // type expression (e.g. `DRPair(T1, T2)`) instantiates a real struct
        // instead of failing on a bare `UnknownVal(Type)`.
        unknown_val := create_unknown_val_with_name(TypeValue.TypeUni(usize(0)), fp_name);
        _add_fp := add_variable_to_env(
          env,
          fp_name,
          TypeValue.TypeUni(usize(0)),
          Option(EvalValue).Some(unknown_val),
          true,
          false,
          false,
          false,
          synthetic_token(fp_name, env.module_path)
        );
      });
      fpi = (fpi + usize(1));
    });
  });
  // Check for optional where(...) before target type.
  is_where_pre := match(
    args.get(arg_idx),
    .Some(a) => ast_expr_is_fn_call_of(a, BK_WHERE,.None),
    .None => false
  );
  if(is_where_pre, {
    where_arg_opt = match(args.get(arg_idx),.Some(a) => Option(AstExpr).Some(a),.None => Option(AstExpr).None);
    arg_idx = (arg_idx + usize(1));
  });
  // Evaluate the target type.
  target_expr := match(
    args.get(arg_idx),
    .Some(a) => a,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive requires a target type"),
            false,
            .None
          )
        )
      );
      make_err_expr()
    }
  );
  target_type_expr := target_expr;
  evaled_target := evaluate_expression(target_type_expr, env, ctx);
  target_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_target));
  target_info := match(
    target_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive: failed to evaluate target type"),
            false,
            .None
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  // Expect target to be a TypeVal.
  target_type := match(
    target_info.value,
    .Some(tv) => match(
      tv,
      .TypeVal(ty_box) => ty_box,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              tok,
              String.from("derive: expected a type"),
              false,
              .None
            )
          )
        );
        TypeValue.Unit
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive: expected a type"),
            false,
            .None
          )
        )
      );
      TypeValue.Unit
    }
  );
  // Verify the target is a Struct or EnumT.
  match(
    target_type,
    .Struct({ id : _ }) => (),
    .EnumT(_, _, _, _, _, _, _, _, _) => (),
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive only works on struct and enum types"),
            false,
            .None
          )
        )
      );
    }
  );
  arg_idx = (arg_idx + usize(1));
  // Check for optional where(...) after target type (only when forall is present).
  is_where_post := match(
    args.get(arg_idx),
    .Some(a) => ast_expr_is_fn_call_of(a, BK_WHERE,.None),
    .None => false
  );
  if(is_where_post && forall_arg_opt.is_some(), {
    if(where_arg_opt.is_none(), {
      where_arg_opt = match(args.get(arg_idx),.Some(a) => Option(AstExpr).Some(a),.None => Option(AstExpr).None);
    });
    arg_idx = (arg_idx + usize(1));
  });
  // Pop the forall frame before processing trait args.
  if(forall_arg_opt.is_some(), {
    env.pop_frame();
  });
  n_args := args.len();
  if(arg_idx >= n_args, {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          String.from("derive requires at least one trait argument after the target type"),
          false,
          .None
        )
      )
    );
  });
  // Process each trait argument.
  (result_env : Environment) = env;
  while(arg_idx < n_args, {
    trait_arg := match(args.get(arg_idx),.Some(a) => a,.None => make_err_expr());
    result_env = process_trait_arg(
      trait_arg,
      target_type,
      target_type_expr,
      result_env,
      forall_arg_opt,
      where_arg_opt,
      ctx,
      exn
    );
    arg_idx = (arg_idx + usize(1));
  });
  out := new_expr_info(result_env, t_unit());
  out.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
export(evaluate_derive);
