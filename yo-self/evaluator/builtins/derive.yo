//! evaluator/builtins/derive — evaluate_derive.
//!
//! Phase 3 implementation. 1:1 port of `src/evaluator/builtins/derive.ts`.
//!
//! Supports:
//!   derive([forall(...)], [where(...)], TargetType, [where(...)], Trait1, Trait2, ...)
//!
//! Key difference from TypeScript: we use the global g_derive_rules registry
//! (from derive_rule.yo) instead of deriveRule fields on FunctionValue/TraitType.
//! Trait args are resolved by expression-level name (not by evaluating the trait arg).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_FORALL,
  BK_WHERE
} :: import("../../expr.yo");
{
  Environment,
  add_variable_to_env,
  synthetic_token,
  push_env_frame,
  pop_env_frame,
  get_variables_from_env,
  generate_variable_id
} :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_type, t_expr_t, t_comptime_list } :: import("../../types/creators.yo");
{ generate_expr_from_code } :: import("../../parser.yo");
{ EvalValue, create_unknown_val_with_name, value_to_string } :: import("../../value.yo");
{ EvalContext } :: import("../context.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ extract_derive_key, get_derive_rule, get_derive_rule_type } :: import("./derive_rule.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// call_registered_derive_rule
//
// Calls a registered derive rule function with:
//   arg0: TypeVal(target_type)
//   arg1: StructVal("DeriveContext", {target, forall_params, where_clause})
//   arg2: ComptimeListVal(trait_params as ExprVals)
//
// Returns the env after evaluating the generated impl expression.
// Mirrors `callRegisteredDeriveRule` in `src/evaluator/builtins/derive.ts`.
// ---------------------------------------------------------------------------
// Bind a comptime-only variable (mirrors TS `addComptimeVar`:
// isCompileTimeOnly=true, isOwningTheRcValue=false).
add_comptime_var :: (
  fn(env : Environment, name : String, ty : TypeValue, value : EvalValue) -> unit
)({
  _r := add_variable_to_env(
    env,
    name.clone(),
    ty,
    Option(EvalValue).Some(value),
    true,
    false,
    false,
    false,
    synthetic_token(name, env.module_path)
  );
  ()
});
// Build + bind an `Option(Expr)` comptime var for a forall/where argument and
// return its variable name. Evaluates a generated `((tmp : Option(Expr)) =
// .Some(inner))` / `.None` so the bound value carries the real Option(Expr)
// type (mirrors TS callRegisteredDeriveRule step 4).
_derive_bind_opt :: (
  fn(
    env : Environment,
    prefix : String,
    arg_opt : Option(AstExpr),
    ctx : EvalContext,
    exn : Exception
  ) -> String
)({
  var_name := `__derive_opt_${generate_variable_id(env.module_path, prefix.clone())}`;
  tmp := `__derive_optT_${generate_variable_id(env.module_path, prefix.clone())}`;
  opt_code := match(
    arg_opt,
    .Some(ae) => {
      inner_var := `__derive_optI_${generate_variable_id(env.module_path, prefix.clone())}`;
      add_comptime_var(env, inner_var.clone(), t_expr_t(), EvalValue.ExprVal(ae.clone()));
      `((${tmp} : Option(Expr)) = .Some(${inner_var}))`
    },
    .None => `((${tmp} : Option(Expr)) = .None)`
  );
  _e := evaluate_expression(generate_expr_from_code(opt_code, exn), env, ctx);
  tmp_vars := get_variables_from_env(env, tmp.clone());
  match(
    tmp_vars.get(tmp_vars.len() - usize(1)),
    .Some(v) => match(
      v.value,
      .Some(ov) => add_comptime_var(env, var_name.clone(), v.ty, ov),
      .None => ()
    ),
    .None => ()
  );
  var_name
});
// ---------------------------------------------------------------------------
// call_registered_derive_rule
//
// Faithful 1:1 port of `callRegisteredDeriveRule` in
// `src/evaluator/builtins/derive.ts`: bind the target type, rule fn, target
// Expr, forall/where options, DeriveContext value and trait-params list as
// comptime vars on a pushed temp frame, then evaluate a GENERATED call
// `ruleFn(type, ctx, tps)` (so the rule runs through the normal call path with
// correct RC — the previous hand-rolled FuncVal-call replication over-released
// arg ExprInfos, see issues/yo-self-stage2-unwind-check-coverage.md). The
// returned Expr is the impl; evaluate it in the caller env and return that env.
// ---------------------------------------------------------------------------
call_registered_derive_rule :: (
  fn(
    derive_rule_val : EvalValue,
    derive_rule_ty : TypeValue,
    target_type : TypeValue,
    target_type_expr : AstExpr,
    forall_arg_opt : Option(AstExpr),
    where_arg_opt : Option(AstExpr),
    trait_arg_expr : AstExpr,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Environment
)({
  tok := ast_expr_token(trait_arg_expr);
  // Extract trait params (raw exprs) from the trait-arg call.
  trait_params := ArrayList(AstExpr).new();
  match(
    trait_arg_expr,
    .FnCall(_, _, ta_args, _, _) => {
      (ti : usize) = usize(0);
      while(ti < ta_args.len(), {
        match(
          ta_args.get(ti),
          .Some(ta) => {
            trait_params.push(ta);
          },
          .None => ()
        );
        ti = (ti + usize(1));
      });
    },
    .Atom(_, _) => ()
  );
  // Push a temp frame; all bindings below are comptime vars on it.
  _pf := push_env_frame(caller_env, false);
  // The DeriveContext / comptime_list / rule-call evaluations below must
  // resolve the comptime bindings (TS passes `forceCompileTimeBindings: true`).
  old_force_ct := ctx.force_compile_time_bindings;
  ctx.force_compile_time_bindings = true;
  // 1. target type.
  type_var := `__derive_T_${generate_variable_id(caller_env.module_path, String.from("dT"))}`;
  add_comptime_var(caller_env, type_var.clone(), t_type(), EvalValue.TypeVal(target_type.clone()));
  // 2. rule fn (bound by VALUE; the declared type is irrelevant to the call).
  rule_fn_name := `__derive_rule_${generate_variable_id(caller_env.module_path, String.from("dr"))}`;
  add_comptime_var(caller_env, rule_fn_name.clone(), derive_rule_ty, derive_rule_val);
  // 3. target Expr value.
  target_expr_var := `__derive_te_${generate_variable_id(caller_env.module_path, String.from("dte"))}`;
  add_comptime_var(caller_env, target_expr_var.clone(), t_expr_t(), EvalValue.ExprVal(target_type_expr.clone()));
  // 4. forall_params / where_clause as Option(Expr).
  forall_expr_var := _derive_bind_opt(caller_env, String.from("dfp"), forall_arg_opt, ctx, exn);
  where_expr_var := _derive_bind_opt(caller_env, String.from("dwp"), where_arg_opt, ctx, exn);
  // 5. DeriveContext(target, forall, where) — evaluated so it carries the
  //    registered DeriveContext type (its id gates `ctx.make_impl` resolution).
  ctx_var := `__derive_ctx_${generate_variable_id(caller_env.module_path, String.from("dctx"))}`;
  ctx_code := `DeriveContext(${target_expr_var}, ${forall_expr_var}, ${where_expr_var})`;
  ctx_result := evaluate_expression(generate_expr_from_code(ctx_code, exn), caller_env, ctx);
  ctx_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(ctx_result)),
    .Some(i) => i,
    .None => new_expr_info(caller_env, t_unit())
  );
  ctx_val := match(
    ctx_info.value,
    .Some(v) => v,
    .None => {
      exn.throw(dyn(format_error_message(tok, String.from("derive: failed to create DeriveContext"), false,.None)));
      EvalValue.UnitVal
    }
  );
  add_comptime_var(caller_env, ctx_var.clone(), ctx_info.ty, ctx_val);
  // 6. trait_params as ComptimeList(Expr).
  tps_var := `__derive_tps_${generate_variable_id(caller_env.module_path, String.from("dtps"))}`;
  if(trait_params.len() > usize(0), {
    param_names := ArrayList(String).new();
    (tpi : usize) = usize(0);
    while(tpi < trait_params.len(), {
      pv := `__derive_tp_${generate_variable_id(caller_env.module_path, String.from("dtp"))}`;
      pexpr := match(trait_params.get(tpi),.Some(p) => p,.None => make_err_expr());
      add_comptime_var(caller_env, pv.clone(), t_expr_t(), EvalValue.ExprVal(pexpr.clone()));
      param_names.push(pv);
      tpi = (tpi + usize(1));
    });
    joined := String.from("");
    (ji : usize) = usize(0);
    while(ji < param_names.len(), {
      if(ji > usize(0), {
        joined = (joined + String.from(", "));
      });
      joined = (joined + match(param_names.get(ji),.Some(n) => n,.None => String.from("")));
      ji = (ji + usize(1));
    });
    list_code := `comptime_list(${joined})`;
    list_result := evaluate_expression(generate_expr_from_code(list_code, exn), caller_env, ctx);
    list_info := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(list_result)),
      .Some(i) => i,
      .None => new_expr_info(caller_env, t_unit())
    );
    list_val := match(list_info.value,.Some(v) => v,.None => EvalValue.ComptimeListVal(ArrayList(EvalValue).new()));
    add_comptime_var(caller_env, tps_var.clone(), list_info.ty, list_val);
  }, {
    add_comptime_var(caller_env, tps_var.clone(), t_comptime_list(t_expr_t()), EvalValue.ComptimeListVal(ArrayList(EvalValue).new()));
  });
  // 7. Call the rule via a generated call expression.
  call_code := `${rule_fn_name}(${type_var}, ${ctx_var}, ${tps_var})`;
  call_result := evaluate_expression(generate_expr_from_code(call_code, exn), caller_env, ctx);
  call_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(call_result)),
    .Some(i) => i,
    .None => new_expr_info(caller_env, t_unit())
  );
  call_val := match(
    call_info.value,
    .Some(v) => v,
    .None => {
      exn.throw(dyn(format_error_message(tok, String.from("derive: derive rule function failed"), false,.None)));
      EvalValue.UnitVal
    }
  );
  result_expr := match(
    call_val,
    .ExprVal(e) => e,
    _ => {
      exn.throw(dyn(format_error_message(tok, `derive: derive rule must return(comptime(Expr)); got ${value_to_string(call_val)}`, false,.None)));
      make_err_expr()
    }
  );
  // Pop the temp frame, then evaluate the returned impl Expr in the caller env
  // (TS uses `forceCompileTimeBindings: false` for this final evaluation).
  ctx.force_compile_time_bindings = old_force_ct;
  pop_env_frame(caller_env);
  evaled_result := evaluate_expression(result_expr, caller_env, ctx);
  result_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_result)),
    .Some(i) => i,
    .None => new_expr_info(caller_env, t_unit())
  );
  result_info.env
});
// ---------------------------------------------------------------------------
// process_trait_arg
//
// Look up and dispatch a single trait argument in derive().
// Mirrors `processTraitArg` in `src/evaluator/builtins/derive.ts`.
// ---------------------------------------------------------------------------
process_trait_arg :: (
  fn(
    trait_arg_expr : AstExpr,
    target_type : TypeValue,
    target_type_expr : AstExpr,
    env : Environment,
    forall_arg_opt : Option(AstExpr),
    where_arg_opt : Option(AstExpr),
    ctx : EvalContext,
    exn : Exception
  ) -> Environment
)({
  tok := ast_expr_token(trait_arg_expr);
  // Extract the trait name from the expression (expression-level key).
  key_opt := extract_derive_key(trait_arg_expr);
  key := match(
    key_opt,
    .Some(k) => k,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive: trait argument must be a trait name or trait constructor call"),
            false,
            .None
          )
        )
      );
      String.from("")
    }
  );
  // Look up the registered derive rule.
  rule_opt := get_derive_rule(key);
  derive_rule_val := match(
    rule_opt,
    .Some(r) => r,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            `derive: trait '${key}' does not have a derive rule. Use derive_rule() to register one.`,
            false,
            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  // Look up the rule's Func type (needed to bind the rule fn callably).
  derive_rule_ty := match(get_derive_rule_type(key.clone()),.Some(t) => t,.None => t_unit());
  // Call the registered derive rule.
  call_registered_derive_rule(
    derive_rule_val,
    derive_rule_ty,
    target_type,
    target_type_expr,
    forall_arg_opt,
    where_arg_opt,
    trait_arg_expr,
    env,
    ctx,
    exn
  )
});
// ---------------------------------------------------------------------------
// evaluate_derive
//
// Entry point for `derive(Type, Trait1, Trait2, ...)`.
// Argument layout:
//   derive([forall(...)], [where(...)], TargetType, [where(...)], Trait1, Trait2, ...)
// Mirrors `evaluateDerive` in `src/evaluator/builtins/derive.ts`.
// ---------------------------------------------------------------------------
evaluate_derive :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  tok := ast_expr_token(expr);
  // Early return if not in executing context.
  if(ctx.is_validating_function_definition || !(ctx.is_executing), {
    info := new_expr_info(env, t_unit());
    info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    return(expr);
  });
  // Extract arguments.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  if(args.len() < usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          String.from("derive requires at least 2 arguments: derive(Type, Trait1, ...)."),
          false,
          .None
        )
      )
    );
  });
  (arg_idx : usize) = usize(0);
  (forall_arg_opt : Option(AstExpr)) = Option(AstExpr).None;
  (where_arg_opt : Option(AstExpr)) = Option(AstExpr).None;
  // Check for optional forall(...).
  is_forall := match(
    args.get(arg_idx),
    .Some(a) => ast_expr_is_fn_call_of(a, BK_FORALL,.None),
    .None => false
  );
  if(is_forall, {
    forall_arg_opt = match(args.get(arg_idx),.Some(a) => Option(AstExpr).Some(a),.None => Option(AstExpr).None);
    arg_idx = (arg_idx + usize(1));
    // Introduce forall type variables into env so that target type expressions
    // like Pair(T) can be evaluated.
    forall_expr := match(forall_arg_opt,.Some(fa) => fa,.None => make_err_expr());
    forall_params := match(
      forall_expr,
      .FnCall(_, _, fps, _, _) => fps,
      .Atom(_, _) => ArrayList(AstExpr).new()
    );
    _fr := env.push_frame(false);
    (fpi : usize) = usize(0);
    while(fpi < forall_params.len(), {
      fp := match(forall_params.get(fpi),.Some(a) => a,.None => make_err_expr());
      // Handle both `T` (Atom) and `T : Type` (FnCall(":", [T, Type])) forms.
      fp_name := match(
        fp,
        .Atom(_, ftok) => ftok.value,
        .FnCall(_, func_b, fa2, _, _) => match(
          func_b,
          .Atom(_, op_tok) => cond(
            (op_tok.value == ":") => match(
              fa2.get(usize(0)),
              .Some(na) => match(na,.Atom(_, ntok) => ntok.value,.FnCall(_, _, _, _, _) => String.from("")),
              .None => String.from("")
            ),
            true => String.from("")
          ),
          .FnCall(_, _, _, _, _) => String.from("")
        )
      );
      if(fp_name.len() > usize(0), {
        // Mirror TS `createUnknownValue(createType0(), { variableName })`: a
        // Type-universe slot promotes to `TypeVal(SomeType(name))` so the target
        // type expression (e.g. `DRPair(T1, T2)`) instantiates a real struct
        // instead of failing on a bare `UnknownVal(Type)`.
        unknown_val := create_unknown_val_with_name(TypeValue.TypeUni(usize(0)), fp_name);
        _add_fp := add_variable_to_env(
          env,
          fp_name,
          TypeValue.TypeUni(usize(0)),
          Option(EvalValue).Some(unknown_val),
          true,
          false,
          false,
          false,
          synthetic_token(fp_name, env.module_path)
        );
      });
      fpi = (fpi + usize(1));
    });
  });
  // Check for optional where(...) before target type.
  is_where_pre := match(
    args.get(arg_idx),
    .Some(a) => ast_expr_is_fn_call_of(a, BK_WHERE,.None),
    .None => false
  );
  if(is_where_pre, {
    where_arg_opt = match(args.get(arg_idx),.Some(a) => Option(AstExpr).Some(a),.None => Option(AstExpr).None);
    arg_idx = (arg_idx + usize(1));
  });
  // Evaluate the target type.
  target_expr := match(
    args.get(arg_idx),
    .Some(a) => a,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive requires a target type"),
            false,
            .None
          )
        )
      );
      make_err_expr()
    }
  );
  target_type_expr := target_expr;
  evaled_target := evaluate_expression(target_type_expr, env, ctx);
  target_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_target));
  target_info := match(
    target_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive: failed to evaluate target type"),
            false,
            .None
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  // Expect target to be a TypeVal.
  target_type := match(
    target_info.value,
    .Some(tv) => match(
      tv,
      .TypeVal(ty_box) => ty_box,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              tok,
              String.from("derive: expected a type"),
              false,
              .None
            )
          )
        );
        TypeValue.Unit
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive: expected a type"),
            false,
            .None
          )
        )
      );
      TypeValue.Unit
    }
  );
  // Verify the target is a Struct or EnumT.
  match(
    target_type,
    .Struct({ id : _ }) => (),
    .EnumT(_, _, _, _, _, _, _, _, _) => (),
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive only works on struct and enum types"),
            false,
            .None
          )
        )
      );
    }
  );
  arg_idx = (arg_idx + usize(1));
  // Check for optional where(...) after target type (only when forall is present).
  is_where_post := match(
    args.get(arg_idx),
    .Some(a) => ast_expr_is_fn_call_of(a, BK_WHERE,.None),
    .None => false
  );
  if(is_where_post && forall_arg_opt.is_some(), {
    if(where_arg_opt.is_none(), {
      where_arg_opt = match(args.get(arg_idx),.Some(a) => Option(AstExpr).Some(a),.None => Option(AstExpr).None);
    });
    arg_idx = (arg_idx + usize(1));
  });
  // Pop the forall frame before processing trait args.
  if(forall_arg_opt.is_some(), {
    env.pop_frame();
  });
  n_args := args.len();
  if(arg_idx >= n_args, {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          String.from("derive requires at least one trait argument after the target type"),
          false,
          .None
        )
      )
    );
  });
  // Process each trait argument.
  (result_env : Environment) = env;
  while(arg_idx < n_args, {
    trait_arg := match(args.get(arg_idx),.Some(a) => a,.None => make_err_expr());
    result_env = process_trait_arg(
      trait_arg,
      target_type,
      target_type_expr,
      result_env,
      forall_arg_opt,
      where_arg_opt,
      ctx,
      exn
    );
    arg_idx = (arg_idx + usize(1));
  });
  out := new_expr_info(result_env, t_unit());
  out.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
export(evaluate_derive);
