//! evaluator/builtins/ptr_fns — implements evaluate_address_call.
//!
//! 1:1 port of `src/evaluator/builtins/ptr-fns.ts`.
//!
//! Handles the `&(expr)` address-of operator. Creates a pointer type and,
//! when the target is compile-time known, a PtrVal.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{
  ExprInfo,
  ComptimeRef,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Variable, Environment } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{
  EvalValue,
  is_unknown_val,
  create_unknown_val,
  is_type_value
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_ptr } :: import("../../types/creators.yo");
{ format_error_message } :: import("../../error.yo");
{ attach_temp_variable_to_expr } :: import("../utils.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ Exception } :: import("std/error");
evaluate_address_call :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_expr := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Phase C structural gate: `&(expr)` produces a raw pointer value (`*(T)`).
  // In safe code that value would have type `*(T)`, which the surrounding rules
  // forbid. Reject at the construction site so the diagnostic points at `&(...)`
  // rather than some downstream use. Mirrors ptr-fns.ts:45-61.
  ptok := ast_expr_token(expr);
  if((!(ctx.unsafe_context)) && (!(is_implicitly_unsafe_capable_file(Option(String).Some(ptok.module_path.clone())))), {
    exn.throw(
      dyn(
        format_error_message(
          ptok,
          `Taking an address with '&(...)' produces a raw pointer ('*(T)'), which is not available in safe code.\n\nFor in-place mutation of a value, use the 'inout(name) : T' parameter form on the receiving function. For collections, the safe types (Slice(T), ArrayList(T), HashMap(K, V)) own their interior pointers — don't take an address of an element manually. If this file genuinely needs raw pointers, add 'pragma(Pragma.AllowUnsafe);' at the top.`,
          false,
          .None
        )
      )
    );
  });
  // Adjust expected type: if expected is a pointer, use the pointee type.
  // Build a FRESH ExpectedTypeCtx (mirrors TS ptr-fns.ts:69
  // `{...expectedType, type: childType}`) — ExpectedTypeCtx is an
  // `object` (reference semantics), so mutating an alias of the current
  // one would corrupt the EXPECTED TYPE captured by enclosing
  // expressions (e.g. a match arm's `et.ty` became the pointee, making
  // `.None => panic(...)` arms fail "Expected u8, Actual *(u8)").
  old_expected := ctx.expected_type;
  match(
    ctx.expected_type,
    .Some(ectx) => {
      match(
        ectx.ty,
        .Pointer(pointee_box) => {
          ctx.expected_type = Option(ExpectedTypeCtx).Some(
            ExpectedTypeCtx(ty : pointee_box, env : ectx.env)
          );
        },
        _ => ()
      );
    },
    .None => ()
  );
  eval_arg := evaluate_expression(arg_expr, env, ctx);
  ctx.expected_type = old_expected;
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg));
  match(
    arg_info_opt,
    .Some(_) => (),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("&: failed to evaluate the argument expression for reference."),
            false,
            .None
          )
        )
      );
    }
  );
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      return(expr);
    }
  );
  (cur_env : Environment) = arg_info.env;
  // Error if the argument is a type value — use * for pointer-to-type.
  if(is_type_value(arg_info.value), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          String.from("Cannot create a pointer to a type. Did you mean to use \"*\"?"),
          false,
          .None
        )
      )
    );
  });
  arg_type := arg_info.ty;
  pointer_type := t_ptr(arg_type);
  // Determine compile-time pointer value from comptimeRef.
  comptime_ref_opt := arg_info.comptime_ref;
  ptr_val_from_comptime_ref := match(
    comptime_ref_opt,
    .Some(cref) => Option(EvalValue).Some(
      match(
        cref,
        .ArrayRef(elements, index) =>
          EvalValue.PtrVal(EvalValue.ArrayVal(elements), index),
        .ComptimeListRef(elements, index) =>
          EvalValue.PtrVal(EvalValue.ComptimeListVal(elements), index),
        .StructRef(field_values, field_index) =>
          // Treat field_values as an array to enable indexed access.
          EvalValue.PtrVal(EvalValue.ArrayVal(field_values), field_index),
        .TupleRef(fields, field_index) =>
          EvalValue.PtrVal(EvalValue.ArrayVal(fields), field_index)
      )
    ),
    .None => Option(EvalValue).None
  );
  // If no comptimeRef, check source_variable or unknown val.
  ptr_val_opt := match(
    ptr_val_from_comptime_ref,
    .Some(_) => ptr_val_from_comptime_ref,
    .None => {
      src_val := match(
        arg_info.source_variable,
        .Some(src_var) => match(
          src_var.value,
          .Some(sv) => Option(EvalValue).Some(EvalValue.PtrVal(sv, usize(0))),
          .None => Option(EvalValue).None
        ),
        .None => Option(EvalValue).None
      );
      match(
        src_val,
        .Some(_) => src_val,
        .None => match(
          arg_info.value,
          .Some(v) => if(
            is_unknown_val(v),
            Option(EvalValue).Some(create_unknown_val(pointer_type)),
            Option(EvalValue).None
          ),
          .None => Option(EvalValue).None
        )
      )
    }
  );
  out_info := new_expr_info(cur_env, pointer_type);
  // Handle index_trait_ptr_type: &(value(i)) skips auto-deref.
  match(
    arg_info.index_trait_ptr_type,
    .Some(itp_ty) => {
      // Use the Index-trait pointer type; value is runtime only.
      out_info.ty = itp_ty;
      out_info.is_index_trait_address_of = Option(bool).Some(true);
    },
    .None => {
      // Set compile-time pointer value if available.
      out_info.value = ptr_val_opt;
    }
  );
  // Propagate path_collection from arg.
  out_info.path_collection = arg_info.path_collection;
  // Propagate comptime_ref so callers can mutate through the pointer.
  out_info.comptime_ref = comptime_ref_opt;
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  // Attach a temp variable name (for ownership tracking / codegen).
  attach_temp_variable_to_expr(expr, false, ctx);
  expr
});
export(evaluate_address_call);
