//! evaluator/builtins/expr_fns — expr introspection builtin functions.
//!
//! 1:1 port of `src/evaluator/builtins/expr-fns.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  make_err_expr,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_to_string,
  BF_YO_EXPR_IS_ATOM,
  BF_YO_EXPR_IS_FN_CALL,
  BF_YO_EXPR_GET_CALLEE,
  BF_YO_EXPR_GET_ARGS,
  BF_YO_EXPR_TO_STRING,
  BF_YO_EXPR_EQ
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{
  EvalValue,
  is_unknown_val,
  create_unknown_val,
  is_expr_val
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_bool, t_expr_t, t_comptime_string, t_comptime_list } :: import("../../types/creators.yo");
{ is_expr_type } :: import("../../types/guards.yo");
{ are_values_equal } :: import("../utils.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// evaluate_yo_expr_is_atom
// ---------------------------------------------------------------------------
evaluate_yo_expr_is_atom :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_e := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg_e, env, ctx);
  arg_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Failed to evaluate argument for "${BF_YO_EXPR_IS_ATOM}"`,
            false,
            .None
          )
        )
      );
      return(make_err_expr());
    }
  );
  if(!(is_expr_type(arg_info.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_e),
          `Expected expression type for "${BF_YO_EXPR_IS_ATOM}" argument`,
          false,
          .None
        )
      )
    );
    return(make_err_expr());
  });
  bool_val := match(
    arg_info.value,
    .Some(v) => if(
      is_expr_val(v),
      match(v,.ExprVal(e_box) => EvalValue.BoolVal(ast_expr_is_atom(e_box)), _ => create_unknown_val(t_bool())),
      create_unknown_val(t_bool())
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Expected expression value for "${BF_YO_EXPR_IS_ATOM}" argument`,
            false,
            .None
          )
        )
      );
      return(make_err_expr());
    }
  );
  out_info := new_expr_info(arg_info.env, t_bool());
  out_info.value = Option(EvalValue).Some(bool_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
// ---------------------------------------------------------------------------
