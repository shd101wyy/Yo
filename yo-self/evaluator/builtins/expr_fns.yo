  bool_val := match(
    arg_info.value,
    .Some(v) => if(
      is_expr_val(v),
      match(v,.ExprVal(e_box) => EvalValue.BoolVal(ast_expr_is_fn_call(e_box)), _ => create_unknown_val(t_bool())),
      create_unknown_val(t_bool())
