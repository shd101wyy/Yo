  using(exn : Exception)
) -> AstExpr)({
  _ := env;
  _ := ctx;
  exn.throw(dyn format_error_message(
    ast_expr_token(expr),
    String.from("evaluate_yo_type_impls: not yet implemented (Phase 3)"),
    false,
    .None
