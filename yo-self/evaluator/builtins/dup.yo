//! evaluator/builtins/dup — implements evaluate_dup.
//!
//! 1:1 port of `src/evaluator/builtins/dup.ts`.
//!
//! NOTE: The RC-owning paths (tuple dup, array dup, struct ___dup()) require
//! `type_contains_rc_type` to return true and `generate_expr_from_code` to exist.
//! Since `type_contains_rc_type` is currently a stub returning `false`, those
//! paths are unreachable and only the simple (non-RC) path is implemented here.
open(import("std/string"));
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../value.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
evaluate_dup :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : *(EvalContext),
    using(exn : Exception)
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_expr := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg_expr, env, ctx);
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg));
  match(
    arg_info_opt,
    .Some(_) => (),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("___dup: failed to evaluate the argument expression."),
            false,
            .None
          )
        )
      );
    }
  );
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      return(expr);
    }
  );
  (cur_env : Environment) = arg_info.env;
  arg_type := arg_info.ty;
  // NOTE: When type_contains_rc_type is fully implemented, we need to handle:
  //   - tuple types: generateTupleDupCall → evaluate generated code
  //   - array types: generateArrayDupCall → evaluate generated code
  //   - SomeType (non-Future): return unit (just note the dup)
  //   - struct types: call .___dup() method
  // For now, type_contains_rc_type() always returns false, so we always take
  // the simple path: return the arg type with no compile-time value.
  out_info := new_expr_info(cur_env, arg_type);
  // value is None (runtime) — mirrors `value: undefined` in TS
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_dup);
