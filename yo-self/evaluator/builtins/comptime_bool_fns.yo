//! evaluator/builtins/comptime_bool_fns — implements evaluate_yo_comptime_boolean_functions.
//!
//! 1:1 port of `src/evaluator/builtins/comptime-bool-fns.ts`.
//!
//! Handles all compile-time boolean operations:
//!   __yo_comptime_bool_not, __yo_comptime_bool_to_comptime_string (unary)
//!   __yo_comptime_bool_and, __yo_comptime_bool_or, __yo_comptime_bool_eq,
//!   __yo_comptime_bool_neq (binary)
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  BF_COMPTIME_BOOL_NOT,
  BF_COMPTIME_BOOL_TO_COMPTIME_STRING,
  BF_COMPTIME_BOOL_AND,
  BF_COMPTIME_BOOL_OR,
  BF_COMPTIME_BOOL_EQ,
  BF_COMPTIME_BOOL_NEQ
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, is_bool_val, create_unknown_val, type_of_eval_value }
:: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_bool, t_comptime_string } :: import("../../types/creators.yo");
{ is_bool_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// Helper — evaluate one argument and validate it is bool type with a value.
// Returns (ExprInfo, updated env) or throws.
// ---------------------------------------------------------------------------
eval_bool_arg :: (
  fn(
    arg : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> ExprInfo
)({
  evaluated := evaluate_expression(arg, env, ctx);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  info := match(
    info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            `Expected bool type for comptime_bool argument, got:\n${ast_expr_to_string(arg)}`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, t_bool())
    }
  );
  if(!(is_bool_type(info.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg),
          `Expected bool type for comptime_bool argument, got:\n${ast_expr_to_string(arg)}`,
          false,
          .None
        )
      )
    );
  });
  info
});
evaluate_yo_comptime_boolean_functions :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  is_unary := (
    ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_NOT,.Some(usize(1))) ||
      ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_TO_COMPTIME_STRING,.Some(usize(1)))
  );
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  if(is_unary, {
    arg0 := match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    ai := eval_bool_arg(arg0, env, ctx, exn);
    (cur_env : Environment) = ai.env;
    arg_val := ai.value;
    (result_val : EvalValue) = cond(
      ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_NOT,.Some(usize(1))) =>
        match(
          arg_val,
          .Some(av) => match(av,.BoolVal(b) => EvalValue.BoolVal(!(b)), _ => create_unknown_val(t_bool())),
          .None => create_unknown_val(t_bool())
        ),
      ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_TO_COMPTIME_STRING,.Some(usize(1))) =>
        match(
          arg_val,
          .Some(av) => match(
            av,
            .BoolVal(b) => EvalValue.StrLit(if(b, String.from("\"true\""), String.from("\"false\""))),
            _ => create_unknown_val(t_comptime_string())
          ),
          .None => create_unknown_val(t_comptime_string())
        ),
      true => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              String.from("Unexpected unary comptime_bool function"),
              false,
              .None
            )
          )
        );
        EvalValue.UnitVal
      }
    );
    // Result type from the VALUE'S TYPE (mirrors TS `type: value.type`,
    // comptime-bool-fns.ts:91), NOT the value tag: `to_comptime_string` on an
    // unknown bool builds `UnknownVal(comptime_str)`, which a tag-based match
    // (UnknownVal ≠ StrLit) wrongly typed `bool`.
    result_ty := type_of_eval_value(result_val);
    out_info := new_expr_info(cur_env, result_ty);
    out_info.value =.Some(result_val);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  }, {
    // Binary operations: lhs and rhs.
    arg0 := match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    arg1 := match(
      args.get(usize(1)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    lhs_info := eval_bool_arg(arg0, env, ctx, exn);
    rhs_info := eval_bool_arg(arg1, lhs_info.env, ctx, exn);
    (cur_env : Environment) = rhs_info.env;
    lhs_val := lhs_info.value;
    rhs_val := rhs_info.value;
    (result_val : EvalValue) = cond(
      ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_AND,.Some(usize(2))) =>
        match(
          lhs_val,
          .Some(lv) => match(
            lv,
            .BoolVal(lb) => match(
              rhs_val,
              .Some(rv) => match(
                rv,
                .BoolVal(rb) => EvalValue.BoolVal(lb && rb),
                _ => create_unknown_val(t_bool())
              ),
              .None => create_unknown_val(t_bool())
            ),
            _ => create_unknown_val(t_bool())
          ),
          .None => create_unknown_val(t_bool())
        ),
      ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_OR,.Some(usize(2))) =>
        match(
          lhs_val,
          .Some(lv) => match(
            lv,
            .BoolVal(lb) => match(
              rhs_val,
              .Some(rv) => match(
                rv,
                .BoolVal(rb) => EvalValue.BoolVal(lb || rb),
                _ => create_unknown_val(t_bool())
              ),
              .None => create_unknown_val(t_bool())
            ),
            _ => create_unknown_val(t_bool())
          ),
          .None => create_unknown_val(t_bool())
        ),
      ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_EQ,.Some(usize(2))) =>
        match(
          lhs_val,
          .Some(lv) => match(
            lv,
            .BoolVal(lb) => match(
              rhs_val,
              .Some(rv) => match(
                rv,
                .BoolVal(rb) => EvalValue.BoolVal(lb == rb),
                _ => create_unknown_val(t_bool())
              ),
              .None => create_unknown_val(t_bool())
            ),
            _ => create_unknown_val(t_bool())
          ),
          .None => create_unknown_val(t_bool())
        ),
      ast_expr_is_fn_call_of(expr, BF_COMPTIME_BOOL_NEQ,.Some(usize(2))) =>
        match(
          lhs_val,
          .Some(lv) => match(
            lv,
            .BoolVal(lb) => match(
              rhs_val,
              .Some(rv) => match(
                rv,
                .BoolVal(rb) => EvalValue.BoolVal(!(lb == rb)),
                _ => create_unknown_val(t_bool())
              ),
              .None => create_unknown_val(t_bool())
            ),
            _ => create_unknown_val(t_bool())
          ),
          .None => create_unknown_val(t_bool())
        ),
      true => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `Unexpected function call for comptime_bool binary operations:\n${ast_expr_to_string(expr)}`,
              false,
              .None
            )
          )
        );
        EvalValue.UnitVal
      }
    );
    out_info := new_expr_info(cur_env, t_bool());
    out_info.value =.Some(result_val);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  });
  expr
});
export(evaluate_yo_comptime_boolean_functions);
