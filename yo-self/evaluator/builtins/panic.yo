//! evaluator/builtins/panic — implements evaluate_panic.
//!
//! 1:1 port of `src/evaluator/builtins/panic.ts`.
//!
//! `panic(msg)` validates the optional string argument and annotates the
//! call with the surrounding function's return type (panic diverges).
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string
} :: import("../../expr/expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr/expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, FuncOrAsyncBlockKind } :: import("../context.yo");
{ EvalValue } :: import("../value.yo");
{ TypeValue } :: import("../../types/type.yo");
{ t_unit, t_bool } :: import("../../types/type.yo");
{ is_comptime_string_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
evaluate_panic :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : *(EvalContext),
    using(exn : Exception)
  ) -> AstExpr
)({
  // panic() is only valid inside a function body or test block.
  fn_ctx_opt := ctx.is_evaluating_function_body_or_async_block;
  fn_ctx := match(
    fn_ctx_opt,
    .Some(c) => c,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("panic() can only be called inside a function body or test block"),
            false,
            .None
          )
        )
      );
      return(expr);
    }
  );
  // During CTFE capability analysis, panic disqualifies the function.
  if(ctx.is_analyzing_ctfe_capability, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Cannot use \"panic\" during compile-time function evaluation analysis. Functions containing \"panic\" cannot be evaluated at compile time."),
          false,
          .None
        )
      )
    );
  });
  // Determine the return type: function body → func return type; test/async → unit.
  (return_ty : TypeValue) = match(
    fn_ctx.kind,
    .FunctionBody => match(
      fn_ctx.func_type,
      .Some(ty) => match(
        ty,
        .Func(_, _, _, _, _, _, _, _, result) => result.*,
        _ => t_unit()
      ),
      .None => t_unit()
    ),
    _ => t_unit()
  );
  // If there's a message argument, evaluate it and validate its type.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  (cur_env : Environment) = env;
  if(args.len() > usize(0), {
    msg_expr := match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    evaluated := evaluate_expression(msg_expr, cur_env, ctx);
    info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
    match(
      info_opt,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(msg_expr),
              String.from("Failed to evaluate panic message"),
              false,
              .None
            )
          )
        );
      },
      .Some(info) => {
        cur_env = info.env;
        msg_type := info.ty;
        msg_value := info.value;
        // str type: Struct named "str" (newtype)
        is_str_type := match(
          msg_type,
          .Struct(_, name, _, _, _, _, _) => (name.as_str() == "str"),
          _ => false
        );
        // comptime_string: StrLit value, or unknown value with ComptimeString type
        is_comptime_str := match(
          msg_value,
          .Some(v) => match(v,.StrLit(_) => true, _ => false),
          .None => is_comptime_string_type(msg_type)
        );
        if(!(is_str_type) && !(is_comptime_str), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(msg_expr),
                String.from("panic message must be a comptime_string or str"),
                false,
                .None
              )
            )
          );
        });
      }
    );
  });
  // Annotate with the surrounding function's return type (panic diverges).
  info := new_expr_info(cur_env, return_ty);
  // panic never returns a value — leave info.value as .None
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
export(evaluate_panic);
