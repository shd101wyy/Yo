//! evaluator/builtins/panic — implements evaluate_panic.
//!
//! 1:1 port of `src/evaluator/builtins/panic.ts`.
//!
//! `panic(msg)` validates the optional string argument and annotates the
//! call with the surrounding function's return type (panic diverges).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, FuncOrAsyncBlockKind } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_bool, t_ptr } :: import("../../types/creators.yo");
{ is_comptime_string_type, is_str_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
evaluate_panic :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // panic() is only valid inside a function body or test block.
  fn_ctx_opt := ctx.is_evaluating_function_body_or_async_block;
  fn_ctx := match(
    fn_ctx_opt,
    .Some(c) => c,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("panic() can only be called inside a function body or test block"),
            false,
            .None
          )
        )
      );
      return(expr);
    }
  );
  // During CTFE capability analysis, panic disqualifies the function.
  if(ctx.is_analyzing_ctfe_capability, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Cannot use \"panic\" during compile-time function evaluation analysis. Functions containing \"panic\" cannot be evaluated at compile time."),
          false,
          .None
        )
      )
    );
  });
  // Determine the divergent panic's stand-in type (mirrors panic.ts:57-66):
  //   1. the propagated expected type (a match arm's sibling-arm type, a
  //      cond arm, an assignment RHS) when present;
  //   2. else the enclosing function's return type — wrapped in `*(T)` when
  //      the return is declared `inout(T)` (panic in tail position of an
  //      `-> inout(T)` body must produce `*(T)` to match the body's C-ABI
  //      return; sibling `unsafe(&(...))` arms are `*(T)` too);
  //   3. test/async blocks → unit.
  (return_ty : TypeValue) = match(
    ctx.expected_type,
    .Some(et) => et.ty,
    .None => match(
      fn_ctx.kind,
      .FunctionBody => match(
        fn_ctx.func_type,
        .Some(ty) => match(
          ty,
          .Func({ result, meta : __fm1 }) => cond(
            __fm1.*.result_is_ref => t_ptr(result.*),
            true => result.*
          ),
          _ => t_unit()
        ),
        .None => t_unit()
      ),
      _ => t_unit()
    )
  );
  // If there's a message argument, evaluate it and validate its type.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  (cur_env : Environment) = env;
  if(args.len() > usize(0), {
    msg_expr := match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    evaluated := evaluate_expression(msg_expr, cur_env, ctx);
    info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
    match(
      info_opt,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(msg_expr),
              String.from("Failed to evaluate panic message"),
              false,
              .None
            )
          )
        );
      },
      .Some(info) => {
        cur_env = info.env;
        msg_type := info.ty;
        msg_value := info.value;
        // `str` is the fieldless `.Str` TypeValue variant (NOT a Struct named
        // "str") — use the is_str_type guard. The old inline `.Struct(name=="str")`
        // check never matched a real `str` param, so a `panic(msg : str)` body
        // (e.g. `assert`'s `cond(flag => (), true => panic(msg))`) threw
        // "panic message must be a comptime_str or str", was swallowed by the
        // def-time trial-eval, and left the enclosing cond without ExprInfo →
        // "Failed to transpile cond(...)" in codegen.
        is_str := is_str_type(msg_type);
        // comptime_str: StrLit value, or an UNKNOWN value whose type is
        // comptime_str — mirrors TS panic.ts:91-93
        // (`isUnknownValue(msgValue) && isComptimeStringType(msgValue.type)`).
        // Under def-time body evaluation a `comptime_str` parameter binds
        // as a typed unknown; dropping it to `false` made `panic(msg)` the
        // single largest propagated def-eval failure (96 std files).
        is_comptime_str := match(
          msg_value,
          .Some(v) => match(
            v,
            .StrLit(_) => true,
            .UnknownVal(uty) => is_comptime_string_type(uty.*),
            _ => false
          ),
          .None => is_comptime_string_type(msg_type)
        );
        if(!(is_str) && !(is_comptime_str), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(msg_expr),
                String.from("panic message must be a comptime_str or str"),
                false,
                .None
              )
            )
          );
        });
      }
    );
  });
  // Annotate with the surrounding function's return type (panic diverges).
  info := new_expr_info(cur_env, return_ty);
  // panic never returns a value — leave info.value as .None
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
export(evaluate_panic);
