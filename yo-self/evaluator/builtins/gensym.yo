//! evaluator/builtins/gensym — implements evaluate_gensym.
//!
//! 1:1 port of `src/evaluator/builtins/gensym.ts`.
//!
//! `gensym()` or `gensym(prefix)` — generates a unique identifier symbol.
//! The optional prefix is a comptime string prepended to the generated ID.
//! Returns an ExprVal holding the new atom expression.
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  alloc_global_expr_id
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, is_str_lit } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_expr_t } :: import("../../types/creators.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
{ TokenKind, Token } :: import("../../token.yo");
{ random_id } :: import("../../utils.yo");
evaluate_gensym :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // Extract optional prefix argument.
  (args_opt_0 : Option(AstExpr)) = match(
    expr,
    .FnCall(_, _, args, _, _) => args.get(usize(0)),
    _ => Option(AstExpr).None
  );
  (n_args : usize) = match(
    expr,
    .FnCall(_, _, args, _, _) => args.len(),
    _ => usize(0)
  );
  (prefix : String) = String.new();
  match(
    args_opt_0,
    .None => {},
    .Some(prefix_arg) => {
      // More than 1 argument is an error.
      if(n_args > usize(1), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `Expected "gensym" with 0 or 1 argument, got more`,
              false,
              .None
            )
          )
        );
      });
      // Evaluate the prefix argument.
      evaluated_prefix := evaluate_expression(prefix_arg, env, ctx);
      prefix_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_prefix));
      prefix_info := match(
        prefix_info_opt,
        .Some(pi) => pi,
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(prefix_arg),
                `Failed to evaluate the prefix argument for "gensym":\n${ast_expr_to_string(prefix_arg)}`,
                false,
                .None
              )
            )
          );
          return(expr);
        }
      );
      // Prefix must be a comptime string (StrLit).
      match(
        prefix_info.value,
        .Some(pv) => {
          if(!(is_str_lit(pv)), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(prefix_arg),
                  `Expected comptime_string for prefix argument, got:\n${ast_expr_to_string(prefix_arg)}`,
                  false,
                  .None
                )
              )
            );
          });
          // Extract the unquoted prefix string from StrLit.raw.
          match(
            pv,
            .StrLit(raw) => {
              n := raw.len();
              prefix = if(
                n >= usize(2),
                raw.substring(usize(1), n - usize(1)),
                String.new()
              );
            },
            _ => {}
          );
        },
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(prefix_arg),
                `Expected comptime_string for prefix argument, got:\n${ast_expr_to_string(prefix_arg)}`,
                false,
                .None
              )
            )
          );
        }
      );
    }
  );
  // Generate a unique symbol: prefix + random_id(env.modulePath).
  symbol := (prefix + random_id(env.module_path).clone());
  // Build a new Atom expression representing the generated identifier.
  tok := ast_expr_token(expr);
  // Fresh id — id-0 synthesized atoms all collide in the ExprInfo table
  // (every gensym'd node overwrote key 0, dropping live values).
  atom_expr := AstExpr.Atom(
    alloc_global_expr_id(),
    Token(
      kind : TokenKind.Identifier,
      value : symbol,
      row : tok.row,
      column : tok.column,
      character : tok.character,
      module_path : tok.module_path.clone(),
      input : tok.input.clone()
    )
  );
  // Wrap the atom as an ExprVal.
  val := EvalValue.ExprVal(box(atom_expr));
  info := new_expr_info(env, t_expr_t());
  info.value =.Some(val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
export(evaluate_gensym);
