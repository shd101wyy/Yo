//! evaluator/builtins/comptime_index_fns — implements evaluate_yo_comptime_index_functions.
//!
//! 1:1 port of `src/evaluator/builtins/comptime-index-fns.ts`.
//!
//! Handles compile-time indexing for:
//!   ComptimeList element and range indexing
//!   Array element indexing (range slicing falls through to the runtime
//!   slice_copy rewrite — plans/SLICE_REWORK.md Part C)
//!   comptime_str character and range indexing
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BF_YO_COMPTIME_LIST_INDEX,
  BF_YO_COMPTIME_LIST_INDEX_RANGE,
  BF_YO_COMPTIME_LIST_INDEX_RANGE_INCLUSIVE,
  BF_COMPTIME_ARRAY_INDEX,
  BF_COMPTIME_STRING_INDEX,
  BF_COMPTIME_STRING_INDEX_RANGE,
  BF_COMPTIME_STRING_INDEX_RANGE_INCLUSIVE
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  ComptimeRef
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{
  EvalValue,
  is_int_lit,
  is_str_lit,
  is_struct_val,
  is_array_val,
  is_ptr_val,
  is_comptime_list_val,
  is_unknown_val,
  create_unknown_val
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_ptr, t_comptime_list, t_comptime_string } :: import("../../types/creators.yo");
{ is_array_type, is_pointer_type } :: import("../../types/guards.yo");
{ is_comptime_list_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// Range extraction result.
// ---------------------------------------------------------------------------
CiRange :: struct(start_idx : usize, end_idx : usize);
// ---------------------------------------------------------------------------
// Helper: evaluate one arg and get its ExprInfo from the expr_info_table.
// ---------------------------------------------------------------------------
ci_eval_arg :: (
  fn(
    arg : AstExpr,
    env : Environment,
    ctx : EvalContext,
    label : String,
    exn : Exception
  ) -> ExprInfo
)({
  evaluated := evaluate_expression(arg, env, ctx);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  match(
    info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            label,
            false,
            .None
          )
        )
      );
      new_expr_info(env, TypeValue.TypeUni(usize(0)))
    }
  )
});
// ---------------------------------------------------------------------------
// String quoting / unquoting for StrLit values (raw includes surrounding `"`).
// ---------------------------------------------------------------------------
ci_str_unquote :: (fn(raw : String) -> String)({
  rn := raw.len();
  if(
    rn >= usize(2),
    raw.substring(usize(1), rn - usize(1)),
    String.new()
  )
});
ci_str_quote :: (fn(s : String) -> String)(
  (String.from("\"") + s) + String.from("\"")
);
// ---------------------------------------------------------------------------
// Type helpers: child type extraction and fallback return-type computation.
// ---------------------------------------------------------------------------
// Extract element type from ComptimeListT or *(ComptimeListT).
ci_child_of_comptime_list_ty :: (fn(ty : TypeValue) -> TypeValue)(
  match(
    ty,
    .ComptimeListT(cb) => cb.*,
    .Pointer(pb) => match(pb.*,.ComptimeListT(cb) => cb.*, _ => ty),
    _ => ty
  )
);
// Extract element type from Array(T, N) or *(Array(T, N)).
ci_child_of_array_ty :: (fn(ty : TypeValue) -> TypeValue)(
  match(
    ty,
    .Array(cb, _, _) => cb.*,
    .Pointer(pb) => match(pb.*,.Array(cb, _, _) => cb.*, _ => ty),
    _ => ty
  )
);
// Compute fallback return type for element indexing.
// Mirrors TypeScript `computeElementReturnType`.
ci_elem_return_ty :: (fn(ty : TypeValue) -> TypeValue)(
  match(
    ty,
    .Pointer(pb) => {
      inner := pb.*;
      cond(
        is_array_type(inner) => t_ptr(match(inner,.Array(cb, _, _) => cb.*, _ => inner)),
        is_comptime_list_type(inner) => t_ptr(match(inner,.ComptimeListT(cb) => cb.*, _ => inner)),
        true => ty
      )
    },
    .Array(cb, _, _) => t_ptr(cb.*),
    .ComptimeListT(cb) => t_ptr(cb.*),
    _ => ty
  )
);
// Compute fallback return type for ComptimeList range indexing.
// Mirrors TypeScript `computeListRangeReturnType`.
ci_list_range_return_ty :: (fn(ty : TypeValue) -> TypeValue)(
  match(
    ty,
    .Pointer(_) => ty,
    .ComptimeListT(_) => t_ptr(ty),
    _ => ty
  )
);
// ---------------------------------------------------------------------------
// Helper: resolve a ComptimeListVal from a direct value or a PtrVal.
// ---------------------------------------------------------------------------
ci_resolve_comptime_list :: (fn(val_opt : Option(EvalValue)) -> Option(EvalValue))(
  match(
    val_opt,
    .Some(sv) => if(
      is_comptime_list_val(sv),
      Option(EvalValue).Some(sv),
      if(is_ptr_val(sv), {
        inner := match(sv,.PtrVal(tgt, _) => tgt.*, _ => EvalValue.UnitVal);
        if(is_comptime_list_val(inner), Option(EvalValue).Some(inner), Option(EvalValue).None)
      }, Option(EvalValue).None)
    ),
    .None => Option(EvalValue).None
  )
);
// ---------------------------------------------------------------------------
// Helper: extract Range struct indices into a CiRange.
// Returns .None when fields are absent or non-integer.
// ---------------------------------------------------------------------------
ci_extract_range_indices :: (
  fn(
    range_ev : EvalValue,
    is_inclusive : bool
  ) -> Option(CiRange)
)(
  match(
    range_ev,
    .StructVal(_, _, field_values) => {
      start_field := match(
        field_values.get(usize(0)),
        .Some(v) => v,
        .None => {
          return(Option(CiRange).None);
        }
      );
      end_field := match(
        field_values.get(usize(1)),
        .Some(v) => v,
        .None => {
          return(Option(CiRange).None);
        }
      );
      if(!(is_int_lit(start_field)) || !(is_int_lit(end_field)), {
        return(Option(CiRange).None);
      });
      start_raw := match(
        start_field,
        .IntLit(r) => r,
        _ => {
          return(Option(CiRange).None);
        }
      );
      end_raw := match(
        end_field,
        .IntLit(r) => r,
        _ => {
          return(Option(CiRange).None);
        }
      );
      start_i64 := match(
        start_raw.parse_i64(),
        .Some(n) => n,
        .None => {
          return(Option(CiRange).None);
        }
      );
      end_raw_i64 := match(
        end_raw.parse_i64(),
        .Some(n) => n,
        .None => {
          return(Option(CiRange).None);
        }
      );
      end_i64 := if(is_inclusive, end_raw_i64 + i64(1), end_raw_i64);
      if(start_i64 < i64(0), {
        return(Option(CiRange).None);
      });
      if(end_i64 < i64(0), {
        return(Option(CiRange).None);
      });
      Option(CiRange).Some(CiRange(start_idx : usize(start_i64), end_idx : usize(end_i64)))
    },
    _ => Option(CiRange).None
  )
);
// ---------------------------------------------------------------------------
// Handler: __yo_comptime_list_index
// ---------------------------------------------------------------------------
ci_eval_list_index :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  self_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  idx_arg := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  self_info := ci_eval_arg(self_arg, env, ctx, String.from("Failed to evaluate self for comptime list index"), exn);
  (cur_env : Environment) = self_info.env;
  idx_info := ci_eval_arg(idx_arg, cur_env, ctx, String.from("Failed to evaluate index for comptime list index"), exn);
  cur_env = idx_info.env;
  list_ev_opt := ci_resolve_comptime_list(self_info.value);
  fallback_ty := ci_elem_return_ty(self_info.ty);
  match(
    list_ev_opt,
    .Some(list_ev) => {
      list_elems := match(
        list_ev,
        .ComptimeListVal(elems) => elems,
        _ => {
          return(expr);
        }
      );
      elem_ty := ci_child_of_comptime_list_ty(self_info.ty);
      out_info := new_expr_info(cur_env, elem_ty);
      match(
        idx_info.value,
        .Some(iv) => {
          if(is_int_lit(iv), {
            idx_raw := match(iv,.IntLit(r) => r, _ => String.from("0"));
            idx_i64 := match(
              idx_raw.parse_i64(),
              .Some(n) => n,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(idx_arg),
                      String.from("Invalid integer literal for ComptimeList index"),
                      false,
                      .None
                    )
                  )
                );
                i64(0)
              }
            );
            if(idx_i64 < i64(0), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(idx_arg),
                    `ComptimeList index out of bounds: ${idx_raw}`,
                    false,
                    .None
                  )
                )
              );
            });
            idx_usize := usize(idx_i64);
            list_len := list_elems.len();
            if(idx_usize >= list_len, {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(idx_arg),
                    `ComptimeList index out of bounds: ${idx_raw}`,
                    false,
                    .None
                  )
                )
              );
            });
            elem_val := match(
              list_elems.get(idx_usize),
              .Some(v) => v,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(idx_arg),
                      String.from("ComptimeList index out of bounds"),
                      false,
                      .None
                    )
                  )
                );
                EvalValue.UnitVal
              }
            );
            out_info.value = Option(EvalValue).Some(elem_val);
            out_info.comptime_ref = Option(ComptimeRef).Some(ComptimeRef.ComptimeListRef(list_elems, idx_usize));
          }, {
            out_info.value = Option(EvalValue).Some(create_unknown_val(elem_ty));
          });
        },
        .None => {
          out_info.value = Option(EvalValue).Some(create_unknown_val(elem_ty));
        }
      );
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    },
    .None => {
      out_info := new_expr_info(cur_env, fallback_ty);
      out_info.value = Option(EvalValue).Some(create_unknown_val(fallback_ty));
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    }
  );
  expr
});
// ---------------------------------------------------------------------------
// Handler: __yo_comptime_list_index_range / _inclusive
// ---------------------------------------------------------------------------
ci_eval_list_range_index :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    is_inclusive : bool,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  self_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  range_arg := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  self_info := ci_eval_arg(self_arg, env, ctx, String.from("Failed to evaluate self for comptime list range index"), exn);
  (cur_env : Environment) = self_info.env;
  range_info := ci_eval_arg(range_arg, cur_env, ctx, String.from("Failed to evaluate range for comptime list range index"), exn);
  cur_env = range_info.env;
  fallback_ty := ci_list_range_return_ty(self_info.ty);
  // Fallback when range value is unknown or not a struct.
  range_is_known := match(
    range_info.value,
    .Some(rv) => (is_struct_val(rv) && !(is_unknown_val(rv))),
    .None => false
  );
  if(!(range_is_known), {
    out_info := new_expr_info(cur_env, fallback_ty);
    out_info.value = Option(EvalValue).Some(create_unknown_val(fallback_ty));
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  range_ev := match(
    range_info.value,
    .Some(rv) => rv,
    .None => {
      return(expr);
    }
  );
  range_opt := ci_extract_range_indices(range_ev, is_inclusive);
  ci_range := match(
    range_opt,
    .Some(r) => r,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(range_arg),
            String.from("Expected numeric start/end in Range for comptime list range index"),
            false,
            .None
          )
        )
      );
      CiRange(start_idx : usize(0), end_idx : usize(0))
    }
  );
  start_idx := ci_range.start_idx;
  end_idx := ci_range.end_idx;
  list_ev_opt := ci_resolve_comptime_list(self_info.value);
  match(
    list_ev_opt,
    .Some(list_ev) => {
      list_elems := match(
        list_ev,
        .ComptimeListVal(elems) => elems,
        _ => {
          return(expr);
        }
      );
      elem_ty := ci_child_of_comptime_list_ty(self_info.ty);
      result_ty := t_comptime_list(elem_ty);
      list_len := list_elems.len();
      if(start_idx > list_len, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(range_arg),
              `ComptimeList range start out of bounds: ${start_idx}`,
              false,
              .None
            )
          )
        );
      });
      if(end_idx < start_idx, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(range_arg),
              `ComptimeList range end out of bounds: ${end_idx}`,
              false,
              .None
            )
          )
        );
      });
      if(end_idx > list_len, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(range_arg),
              `ComptimeList range end out of bounds: ${end_idx}`,
              false,
              .None
            )
          )
        );
      });
      sliced := ArrayList(EvalValue).new();
      (i : usize) = start_idx;
      while(i < end_idx, {
        match(
          list_elems.get(i),
          .Some(v) => {
            sliced.push(v);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      new_list_val := EvalValue.ComptimeListVal(sliced);
      out_info := new_expr_info(cur_env, result_ty);
      out_info.value = Option(EvalValue).Some(new_list_val);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    },
    .None => {
      out_info := new_expr_info(cur_env, fallback_ty);
      out_info.value = Option(EvalValue).Some(create_unknown_val(fallback_ty));
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    }
  );
  expr
});
// ---------------------------------------------------------------------------
// Handler: __yo_comptime_array_index
// ---------------------------------------------------------------------------
ci_eval_array_index :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  self_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  idx_arg := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  self_info := ci_eval_arg(self_arg, env, ctx, String.from("Failed to evaluate self for comptime array/slice index"), exn);
  (cur_env : Environment) = self_info.env;
  idx_info := ci_eval_arg(idx_arg, cur_env, ctx, String.from("Failed to evaluate index for comptime array/slice index"), exn);
  cur_env = idx_info.env;
  // ----- Array branch -----
  array_ev_opt := match(
    self_info.value,
    .Some(sv) => if(is_array_val(sv), Option(EvalValue).Some(sv), Option(EvalValue).None),
    .None => Option(EvalValue).None
  );
  match(
    array_ev_opt,
    .Some(sv) => {
      match(
        sv,
        .ArrayVal(elements) => {
          elem_ty := ci_child_of_array_ty(self_info.ty);
          out_info := new_expr_info(cur_env, elem_ty);
          match(
            idx_info.value,
            .Some(iv) => {
              if(is_int_lit(iv), {
                idx_raw := match(iv,.IntLit(r) => r, _ => String.from("0"));
                idx_i64 := match(
                  idx_raw.parse_i64(),
                  .Some(n) => n,
                  .None => {
                    exn.throw(
                      dyn(
                        format_error_message(
                          ast_expr_token(idx_arg),
                          String.from("Invalid integer literal for array index"),
                          false,
                          .None
                        )
                      )
                    );
                    i64(0)
                  }
                );
                if(idx_i64 < i64(0), {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(idx_arg),
                        `Array index out of bounds: ${idx_raw}`,
                        false,
                        .None
                      )
                    )
                  );
                });
                idx_usize := usize(idx_i64);
                arr_len := elements.len();
                if(idx_usize >= arr_len, {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(idx_arg),
                        `Array index out of bounds: ${idx_raw}`,
                        false,
                        .None
                      )
                    )
                  );
                });
                elem_val := match(
                  elements.get(idx_usize),
                  .Some(v) => v,
                  .None => {
                    exn.throw(
                      dyn(
                        format_error_message(
                          ast_expr_token(idx_arg),
                          String.from("Array index out of bounds"),
                          false,
                          .None
                        )
                      )
                    );
                    EvalValue.UnitVal
                  }
                );
                out_info.value = Option(EvalValue).Some(elem_val);
                out_info.comptime_ref = Option(ComptimeRef).Some(ComptimeRef.ArrayRef(elements, idx_usize));
              }, {
                out_info.value = Option(EvalValue).Some(create_unknown_val(elem_ty));
              });
            },
            .None => {
              out_info.value = Option(EvalValue).Some(create_unknown_val(elem_ty));
            }
          );
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
        },
        _ => ()
      );
    },
    .None => {
      fallback_ty := ci_elem_return_ty(self_info.ty);
      out_info := new_expr_info(cur_env, fallback_ty);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    }
  );
  expr
});
// ---------------------------------------------------------------------------
// Handler: __yo_comptime_string_index / _range / _range_inclusive
// ---------------------------------------------------------------------------
ci_eval_string_index :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    is_range : bool,
    is_inclusive : bool,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  self_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  idx_arg := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  self_info := ci_eval_arg(self_arg, env, ctx, String.from("Failed to evaluate self for comptime string index"), exn);
  (cur_env : Environment) = self_info.env;
  idx_info := ci_eval_arg(idx_arg, cur_env, ctx, String.from("Failed to evaluate index for comptime string index"), exn);
  cur_env = idx_info.env;
  result_ty := self_info.ty;
  // If self is not a known comptime_str, set no value.
  self_is_str := match(
    self_info.value,
    .Some(sv) => is_str_lit(sv),
    .None => false
  );
  if(!(self_is_str), {
    out_info := new_expr_info(cur_env, result_ty);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  raw := match(self_info.value,.Some(sv) => match(sv,.StrLit(r) => r, _ => String.new()),.None => String.new());
  unquoted := ci_str_unquote(raw);
  if(!(is_range), {
    // ----- Single character index -----
    idx_is_known := match(
      idx_info.value,
      .Some(iv) => (is_int_lit(iv) && !(is_unknown_val(iv))),
      .None => false
    );
    if(!(idx_is_known), {
      out_info := new_expr_info(cur_env, result_ty);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
      return(expr);
    });
    idx_raw := match(
      idx_info.value,
      .Some(iv) => match(iv,.IntLit(r) => r, _ => String.from("0")),
      .None => String.from("0")
    );
    idx_i64 := match(
      idx_raw.parse_i64(),
      .Some(n) => n,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(idx_arg),
              String.from("Invalid integer literal for string index"),
              false,
              .None
            )
          )
        );
        i64(0)
      }
    );
    if(idx_i64 < i64(0), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(idx_arg),
            `String index out of bounds: ${idx_raw}`,
            false,
            .None
          )
        )
      );
    });
    idx_usize := usize(idx_i64);
    str_len := unquoted.len();
    if(idx_usize >= str_len, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(idx_arg),
            `String index out of bounds: ${idx_raw}`,
            false,
            .None
          )
        )
      );
    });
    char_str := unquoted.substring(idx_usize, idx_usize + usize(1));
    out_info := new_expr_info(cur_env, result_ty);
    out_info.value = Option(EvalValue).Some(EvalValue.StrLit(ci_str_quote(char_str)));
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  // ----- Range index -----
  range_is_known := match(
    idx_info.value,
    .Some(rv) => (is_struct_val(rv) && !(is_unknown_val(rv))),
    .None => false
  );
  if(!(range_is_known), {
    out_info := new_expr_info(cur_env, result_ty);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  range_ev := match(
    idx_info.value,
    .Some(rv) => rv,
    .None => {
      return(expr);
    }
  );
  range_opt := ci_extract_range_indices(range_ev, is_inclusive);
  ci_range := match(
    range_opt,
    .Some(r) => r,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(idx_arg),
            String.from("Expected numeric start/end in Range for comptime string range index"),
            false,
            .None
          )
        )
      );
      CiRange(start_idx : usize(0), end_idx : usize(0))
    }
  );
  start_idx := ci_range.start_idx;
  end_idx := ci_range.end_idx;
  str_len := unquoted.len();
  if(start_idx > str_len, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(idx_arg),
          `String slice start index out of bounds: ${start_idx}`,
          false,
          .None
        )
      )
    );
  });
  if(end_idx < start_idx, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(idx_arg),
          `String slice end index out of bounds: ${end_idx}`,
          false,
          .None
        )
      )
    );
  });
  if(end_idx > str_len, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(idx_arg),
          `String slice end index out of bounds: ${end_idx}`,
          false,
          .None
        )
      )
    );
  });
  sliced := unquoted.substring(start_idx, end_idx);
  out_info := new_expr_info(cur_env, result_ty);
  out_info.value = Option(EvalValue).Some(EvalValue.StrLit(ci_str_quote(sliced)));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
// ---------------------------------------------------------------------------
// Main dispatch function.
// ---------------------------------------------------------------------------
evaluate_yo_comptime_index_functions :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  if(ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_INDEX,.None), {
    return(ci_eval_list_index(expr, env, ctx, exn));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_INDEX_RANGE,.None), {
    return(ci_eval_list_range_index(expr, env, ctx, false, exn));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_COMPTIME_LIST_INDEX_RANGE_INCLUSIVE,.None), {
    return(ci_eval_list_range_index(expr, env, ctx, true, exn));
  });
  if(ast_expr_is_fn_call_of(expr, BF_COMPTIME_ARRAY_INDEX,.None), {
    return(ci_eval_array_index(expr, env, ctx, exn));
  });
  if(ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_INDEX,.None), {
    return(ci_eval_string_index(expr, env, ctx, false, false, exn));
  });
  if(ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_INDEX_RANGE,.None), {
    return(ci_eval_string_index(expr, env, ctx, true, false, exn));
  });
  if(ast_expr_is_fn_call_of(expr, BF_COMPTIME_STRING_INDEX_RANGE_INCLUSIVE,.None), {
    return(ci_eval_string_index(expr, env, ctx, true, true, exn));
  });
  exn.throw(
    dyn(
      format_error_message(
        ast_expr_token(expr),
        String.from("evaluate_yo_comptime_index_functions: unexpected function"),
        false,
        .None
      )
    )
  );
  make_err_expr()
});
export(evaluate_yo_comptime_index_functions);
