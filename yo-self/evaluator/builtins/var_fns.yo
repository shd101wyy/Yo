//! evaluator/builtins/var_fns — variable introspection builtin functions.
//!
//! 1:1 port of `src/evaluator/builtins/var-fns.ts`.
//!
//! Implements:
//!   __yo_var_print_info(var)           — print debug info about a variable (no-op in self-hosted)
//!   __yo_var_is_owning_the_rc_value(v) — returns bool: is var the RC owner?
//!   __yo_var_has_other_aliases(v)      — returns bool: does var share an RC alias?
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{
  Variable,
  Frame,
  Environment,
  get_variables_from_env
} :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_bool, t_unit } :: import("../../types/creators.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
evaluate_yo_var_print_info :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  var_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_var_arg := evaluate_expression(var_arg, env, ctx);
  var_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_var_arg));
  (cur_env : Environment) = match(var_info_opt, .Some(i) => i.env, .None => env);
  // Note: debug printing of variable info is a no-op in the self-hosted compiler.
  // The TS version calls console.log(getVariableInfo(variable)).
  out_info := new_expr_info(cur_env, t_unit());
  out_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
evaluate_yo_var_is_owning_the_rc_value :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  var_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_var_arg := evaluate_expression(var_arg, env, ctx);
  var_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_var_arg));
  (cur_env : Environment) = match(var_info_opt, .Some(i) => i.env, .None => env);
  variable_name_opt := match(var_info_opt, .Some(i) => i.variable_name, .None => Option(String).None);
  (is_owning : bool) = false;
  match(
    variable_name_opt,
    .Some(vname) => {
      variables := get_variables_from_env(cur_env, vname);
      n_vars := variables.len();
      if(n_vars > usize(0), {
        variable := match(
          variables.get(n_vars - usize(1)),
          .Some(v) => v,
          .None => {
            return(expr);
          }
        );
        is_owning = variable.is_owning_the_rc_value;
      });
    },
    .None => ()
  );
  out_info := new_expr_info(cur_env, t_bool());
  out_info.value = Option(EvalValue).Some(EvalValue.BoolVal(is_owning));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
evaluate_yo_var_has_other_aliases :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  var_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_var_arg := evaluate_expression(var_arg, env, ctx);
  var_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_var_arg));
  (cur_env : Environment) = match(var_info_opt, .Some(i) => i.env, .None => env);
  variable_name_opt := match(var_info_opt, .Some(i) => i.variable_name, .None => Option(String).None);
  (has_aliases : bool) = false;
  match(
    variable_name_opt,
    .Some(vname) => {
      variables := get_variables_from_env(cur_env, vname);
      n_vars := variables.len();
      if(n_vars > usize(0), {
        variable := match(
          variables.get(n_vars - usize(1)),
          .Some(v) => v,
          .None => {
            return(expr);
          }
        );
        match(
          variable.is_owning_the_same_rc_value_as,
          .Some(_) => {
            has_aliases = true;
          },
          .None => {
            // Check if any frame variable points to this variable as its RC alias.
            target_id := variable.id;
            (fi : usize) = cur_env.frames.len();
            while(fi > usize(0), {
              fi = (fi - usize(1));
              frame := match(
                cur_env.frames.get(fi),
                .Some(f) => f,
                .None => {
                  return(expr);
                }
              );
              n_fvars := frame.variables.len();
              (fj : usize) = usize(0);
              while(fj < n_fvars, {
                fvar := match(
                  frame.variables.get(fj),
                  .Some(v) => v,
                  .None => {
                    return(expr);
                  }
                );
                match(
                  fvar.is_owning_the_same_rc_value_as,
                  .Some(aliased_box) => {
                    if(aliased_box.*.id == target_id, {
                      has_aliases = true;
                    });
                  },
                  .None => ()
                );
                fj = (fj + usize(1));
              });
            });
          }
        );
      });
    },
    .None => ()
  );
  out_info := new_expr_info(cur_env, t_bool());
  out_info.value = Option(EvalValue).Some(EvalValue.BoolVal(has_aliases));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(
  evaluate_yo_var_has_other_aliases,
  evaluate_yo_var_is_owning_the_rc_value,
  evaluate_yo_var_print_info
);
