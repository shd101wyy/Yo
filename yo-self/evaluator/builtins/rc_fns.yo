// ---------------------------------------------------------------------------
// 1-arg -> arg type (rc_own passes ownership to caller, no comptime value)
// ---------------------------------------------------------------------------
/// Mirrors `evaluateYoRcOwn` in rc-fns.ts.
evaluate_yo_rc_own :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  info := _eval_arg("evaluate_yo_rc_own", expr, env, ctx, usize(0), exn);
  out := new_expr_info(info.env, info.ty);
  out.value =.None;
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
// ---------------------------------------------------------------------------
// iso_extract: 1-arg -> Option(T)
// ---------------------------------------------------------------------------
/// Mirrors `evaluateYoIsoExtract` in rc-fns.ts.
evaluate_yo_iso_extract :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  info := _eval_arg("evaluate_yo_iso_extract", expr, env, ctx, usize(0), exn);
  arg_type := info.ty;
  if(!(is_iso_type(arg_type)), {
    args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    tok := match(args.get(usize(0)),.Some(a) => ast_expr_token(a),.None => ast_expr_token(expr));
    exn.throw(
      dyn(
        format_error_message(
          tok,
          `evaluate_yo_iso_extract: expected Iso type, but got: ${type_to_string(arg_type)}`,
          false,
          .None
        )
      )
    );
  });
  inner_type := match(arg_type,.IsoT(child_box) => child_box, _ => t_unit());
  option_type := create_option_type(inner_type);
  out := new_expr_info(info.env, option_type);
  out.value =.None;
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
// ---------------------------------------------------------------------------
// 2-arg -> unit functions
// ---------------------------------------------------------------------------
/// Mirrors `evaluateYoDropArrayElement` in rc-fns.ts.
evaluate_yo_drop_array_element :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  info0 := _eval_arg("evaluate_yo_drop_array_element", expr, env, ctx, usize(0), exn);
  info1 := _eval_arg("evaluate_yo_drop_array_element", expr, info0.env, ctx, usize(1), exn);
  info1;
  out := new_expr_info(info0.env, t_unit());
  out.value =.Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
