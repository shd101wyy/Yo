//! evaluator/builtins/rc_fns — RC reference-counting builtin evaluators.
//!
//! 1:1 port of `src/evaluator/builtins/rc_fns.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr } :: import("../../expr.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ EvalValue } :: import("../../value.yo");
{ is_array_type, is_iso_type, is_tuple_type } :: import("../../types/guards.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression } :: import("../exprs/expr.yo");
create_option_type :: (fn(inner_type : TypeValue) -> TypeValue)({
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("None"));
  variant_names.push(String.from("Some"));
  none_fields := ArrayList(TypeValue).new();
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(inner_type);
  variant_fields := ArrayList(ArrayList(TypeValue)).new();
  variant_fields.push(none_fields);
  variant_fields.push(some_fields);
  none_labels := ArrayList(String).new();
  some_labels := ArrayList(String).new();
  some_labels.push(String.from("val"));
  variant_field_labels := ArrayList(ArrayList(String)).new();
  variant_field_labels.push(none_labels);
  variant_field_labels.push(some_labels);
  discs := ArrayList(i64).new();
  discs.push(i64(0));
  discs.push(i64(1));
  TypeValue.EnumT(
    String.from(""),
    // id: empty (compat checks use name only)
    String.from("Option"),
    variant_names,
    variant_fields,
    Option(String).None,
    // selected_variant_name
    variant_field_labels,
    discs,
    false,
    false
  )
});
// ---------------------------------------------------------------------------
// Helper: evaluate one argument and get its ExprInfo.
// ---------------------------------------------------------------------------
_eval_arg :: (
  fn(
    fn_name : str,
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    arg_idx : usize,
    exn : Exception
  ) -> ExprInfo
)({
  args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  arg_expr := match(args.get(arg_idx),.Some(a) => a,.None => make_err_expr());
  eval_arg := evaluate_expression(arg_expr, env, ctx);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `Failed to evaluate argument for ${fn_name}`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  )
});
// ---------------------------------------------------------------------------
// Simple 1-arg -> unit functions
// ---------------------------------------------------------------------------
/// Mirrors `evaluateYoDecrRc` in rc-fns.ts.
evaluate_yo_decr_rc :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  info := _eval_arg("evaluate_yo_decr_rc", expr, env, ctx, usize(0), exn);
  out := new_expr_info(info.env, t_unit());
  out.value =.Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
