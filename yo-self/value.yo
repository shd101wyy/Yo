//! EvalValue and EvalResult — core value types for the self-hosted evaluator.
//!
//! Phase 3a defines the value representation.  Numeric literals store their
//! raw token text (actual parsing / CTFE is Phase 3h scope).  Variable
//! references carry the bound type from the environment but have no computed
//! value at compile time — they mirror `UnknownValue` from the TS evaluator.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("./types/definitions.yo");
{ t_unit, t_bool, t_comptime_int, t_comptime_float, t_comptime_string, t_type, t_some_t } :: import("./types/creators.yo");
{ is_type_0 } :: import("./types/guards.yo");
{ AstExpr, exprs_are_equal } :: import("./expr.yo");
{ are_types_compatible, are_types_compatible_exact } :: import("./types/compatibility.yo");
/// Non-`Self`-referencing fields of `EvalValue.FuncVal`, factored out and stored
/// behind a `Box` (P2 memory). These reference only `String`/`AstExpr`/`TypeValue`
/// (NOT `Self`/`EvalValue`), so the struct is defined BEFORE `EvalValue` (no
/// forward-reference dance). Only `cap_vals : ArrayList(Self)` stays inline.
FuncValData :: struct(
  forall_names : ArrayList(String),
  params : ArrayList(String),
  param_type_names : ArrayList(String),
  evidence_params : ArrayList(String),
  body : AstExpr,
  cap_names : ArrayList(String),
  cap_tys : ArrayList(TypeValue),
  func_id : String
);
derive(FuncValData, Clone);
/// The compile-time representation of an evaluated expression.
///
/// - Literal variants (`BoolVal`, `IntLit`, `FloatLit`, `StrLit`) hold the
///   actual data for constants that can be folded at compile time.
/// - `VarRef` represents a runtime variable reference: the type is known from
///   the environment, but the runtime value is unknown at compile time.
/// - `UnitVal` is the value of the `()` unit expression.
EvalValue :: ref(
  enum(
    /// The unit `()` value.
    UnitVal,
    /// Boolean constant from a `true`/`false` literal.
    BoolVal(b : bool),
    /// Integer literal — raw token text, e.g. `"42"`, `"0xFF"`, `"0b1010"`.
    /// Char literals are decoded to their Unicode code point and stored as a
    /// decimal string, e.g. `'a'` → `"97"` (matching TypeScript's ComptimeInt).
    /// Full parsing (CTFE numeric evaluation) is deferred to Phase 3h.
    IntLit(raw : String),
    /// Float literal — raw token text, e.g. `"3.14"`.
    FloatLit(raw : String),
    /// String or template-string literal — raw token text.
    /// For StringLit tokens the value includes surrounding `"` delimiters.
    /// For TemplateString tokens the delimiters are stripped by the lexer.
    StrLit(raw : String),
    /// Runtime variable reference: type is known from the environment, but the
    /// value is only available at runtime.  Mirrors `UnknownValue` in the TS
    /// evaluator for non-comptime bindings.
    VarRef(name : String),
    /// A compile-time known enum variant value.
    ///
    /// `variant` stores the full dot-prefixed name (e.g. `".Some"`, `".None"`).
    /// `fields` holds the evaluated values of the constructor arguments in
    /// declaration order (positional).
    EnumVal(variant : String, fields : ArrayList(Self)),
    /// A compiled function value: parameter names, unevaluated body expression,
    /// and a snapshot of the definition-time environment for lexical scoping.
    ///
    /// Phase 3i: `cap_names`, `cap_tys`, and `cap_vals` hold a flat snapshot of
    /// all variable bindings visible when the function was defined. At call time
    /// a fresh `Environment` is rebuilt from these captures so the body sees the
    /// correct lexical scope instead of the caller's dynamic env.
    /// Runtime variables (no comptime value) are stored as `VarRef(name)` in
    /// `cap_vals`; their type is preserved in the parallel `cap_tys` array.
    ///
    /// Phase 3l: `forall_names` holds the generic type parameter names extracted
    /// from the function's `forall(T)` parameters. `param_type_names` holds the
    /// type annotation identifier for each value parameter (empty string if the
    /// annotation is complex or absent). These are used together at call time to
    /// infer forall bindings: for each forall name `F`, if any value param has
    /// type annotation `F`, the corresponding argument's type is bound as
    /// `TypeVal(arg.ty)` under name `F` before value params are bound.
    ///
    /// Phase 3o: `evidence_params` holds the names of `name : Type`
    /// parameters. At call time these are bound from explicit `name` args
    /// (which evaluate to the named value from the caller's env).
    /// `cap_vals` (closure capture VALUES) stays inline — it is `ArrayList(Self)`
    /// (recursive). All other fields live in `data : Box(FuncValData)` (P2: the
    /// inline 9-handle variant set sizeof(EvalValue) ~80 B, wasted in every inline
    /// Option(EvalValue) / nested ArrayList(EvalValue) copy).
    FuncVal(
      data : Box(FuncValData),
      cap_vals : ArrayList(Self)
    ),
    /// Control-flow signal emitted by a `return(expr)` statement.
    ///
    /// Propagated upward through begin blocks and while loops until it reaches
    /// the function call boundary, where it is unwrapped into the return value.
    // `ty` is `Box`ed: it is the ONLY `EvalValue` variant that embedded a
    // `TypeValue` inline (~126 B), which set `sizeof(EvalValue)` and inflated every
    // inline `Option(EvalValue)` (Variable.value ×2.6M, ExprInfo.value, every
    // ArrayList(EvalValue)) in the self-compile. Boxing it drops `sizeof(EvalValue)`
    // to the next-biggest variant; the per-`return` box is transient (control-flow
    // signals are short-lived) while the inline savings are retained (P2).
    ReturnVal(val : Self, ty : TypeValue),
    /// Control-flow signal emitted by a `break` statement inside a while or for loop.
    ///
    /// Propagated upward through begin blocks until it reaches the enclosing loop,
    /// where it terminates iteration and the loop returns `UnitVal`.
    BreakVal,
    /// Control-flow signal emitted by a `continue` statement inside a loop.
    ///
    /// Propagated upward through begin blocks until it reaches the enclosing loop,
    /// where it skips the rest of the body and continues to the next iteration.
    ContinueVal,
    /// A compile-time type value (Phase 3k).
    ///
    /// Represents a Yo type as a first-class compile-time value.  For example,
    /// evaluating the bare identifier `i32` produces `TypeVal(Int(32, true))`.
    /// This is needed for `forall(T: Type)` param binding, type-level lambdas
    /// (`ArrayList(String)`), and any other context where a type appears as a
    /// value.
    ///
    /// `ty` is heap-allocated via `Box` to keep the `EvalValue` enum size small —
    /// `TypeValue` is large (the `Func` variant has 9 ArrayList fields) and
    /// storing it inline would bloat every local `EvalValue` and stack frame.
    TypeVal(ty : TypeValue),
    /// A compile-time known struct/object value with named fields.
    ///
    /// `ty_name` is the struct type name (e.g. `"Token"`, `"EvalResult"`).
    /// `field_names` and `field_values` are parallel arrays in field-declaration order.
    StructVal(ty_name : String, field_names : ArrayList(String), field_values : ArrayList(Self)),
    // Phase 2h — remaining value types from src/value.ts ----------------------
    /// An anonymous tuple value.
    ///
    /// `fields` holds the compile-time values of all tuple elements in order.
    /// This corresponds to TypeScript's `TupleValue`.
    TupleVal(fields : ArrayList(Self)),
    /// A compile-time array value.
    ///
    /// `elements` holds the element values in index order.
    /// The element type is tracked in the surrounding `EvalResult.ty` (Array variant).
    /// Mirrors TypeScript's `ArrayValue`.
    ArrayVal(elements : ArrayList(Self)),
    /// A compile-time slice into an array.
    ///
    /// `source` is a `Box(EvalValue)` wrapping an `ArrayVal`.
    /// `start_idx` (inclusive) and `end_idx` (exclusive) delimit the view.
    ///
    /// Note: The TypeScript design uses `[ArrayValue]` (a shared single-element
    /// array) to enable mutable aliasing. This Box design preserves the
    /// backing-array reference concept for Phase 3 pointer semantics but does
    /// not yet implement full mutable aliasing. Mutable-alias semantics will be
    /// revisited when pointer/slice mutation is ported in Phase 3.
    ///
    /// A compile-time pointer to a value.
    ///
    /// `target` is a `Box(EvalValue)` holding the pointed-to value (or `ArrayVal`
    /// for array-element pointers). `index` is the element index within the
    /// target (0 for simple variable pointers).
    ///
    /// Equality is always `false` for pointers (alias identity is not portable
    /// in the compile-time evaluator context).
    ///
    /// Mirrors TypeScript's `PtrValue`.
    PtrVal(target : Self, index : usize),
    /// A compile-time trait object value.
    ///
    /// `ty_name` is the trait type name (e.g. `"Display"`).
    /// `field_names` and `field_values` are parallel arrays in field-declaration
    /// order. `field_values` uses `Option(Self)` so that runtime-only fields
    /// (where the compile-time value is unknown) can be represented as `.None`,
    /// preserving parity with TypeScript's `(Value | undefined)[]` design.
    ///
    /// Mirrors TypeScript's `TraitValue`.
    TraitVal(ty_name : String, field_names : ArrayList(String), field_values : ArrayList(Option(Self))),
    /// A compile-time list (used for variadics and metaprogramming).
    ///
    /// `elements` holds the element values. The element type is tracked in the
    /// surrounding `EvalResult.ty` (ComptimeListT variant).
    /// Mirrors TypeScript's `ComptimeListValue`.
    ComptimeListVal(elements : ArrayList(Self)),
    /// An expression value (metaprogramming / quote).
    ///
    /// `expr` holds the quoted `AstExpr` node.
    /// Equality is always `false` (no structural AST equality yet).
    /// Mirrors TypeScript's `ExprValue`.
    ExprVal(expr : AstExpr),
    /// A compile-time placeholder for a variable whose value is not yet known.
    ///
    /// Used by `evaluateBinding` for `(x : T)` declarations before the
    /// initializer runs. Mirrors `UnknownValue { tag: Unknown, type }` in TS.
    /// The type is preserved so that subsequent type-checking can verify
    /// compatibility without needing the concrete value.
    ///
    /// `TypeValue` keeps the enum size manageable — storing `TypeValue`
    /// inline would inflate every local `EvalValue` variable causing ASAN stack overflow.
    ///
    /// NOT the same as `VarRef` — `VarRef` represents a known-at-runtime variable
    /// reference, while `UnknownVal` is a compile-time placeholder.
    UnknownVal(ty : TypeValue)
  )
);
/// Element-wise equality for `EvalValue`.
///
/// Implemented manually (not via `derive`) because `derive(EvalValue, Eq)` would
/// need `ArrayList(EvalValue) <: Eq(ArrayList(EvalValue))` which in turn needs
/// `EvalValue <: Eq(EvalValue)` — a circularity at derive-expansion time.
///
/// By writing the function with `recur` for recursive cases we break the cycle:
/// the `Eq(ArrayList(EvalValue))` impl is only exercised at call time.
eval_value_eq :: (fn(a : EvalValue, b : EvalValue) -> bool)(
  match(
    a,
    .UnitVal =>
      match(b,.UnitVal => true, _ => false),
    .BoolVal(ab) =>
      match(b,.BoolVal(bb) => (ab == bb), _ => false),
    .IntLit(ar) =>
      match(b,.IntLit(br) => (ar == br), _ => false),
    .FloatLit(ar) =>
      match(b,.FloatLit(br) => (ar == br), _ => false),
    .StrLit(ar) =>
      match(b,.StrLit(br) => (ar == br), _ => false),
    .VarRef(an) =>
      match(b,.VarRef(bn) => (an == bn), _ => false),
    .EnumVal(av, afs) =>
      match(
        b,
        .EnumVal(bv, bfs) =>
          cond(
            (!(av == bv)) => false,
            (afs.len() != bfs.len()) => false,
            true => {
              n := afs.len();
              (i : usize) = usize(0);
              (ok : bool) = true;
              while((i < n) && ok, {
                match(
                  afs.get(i),
                  .Some(af) =>
                    match(
                      bfs.get(i),
                      .Some(bf) => {
                        ok = recur(af, bf);
                      },
                      .None => {
                        ok = false;
                      }
                    ),
                  .None => {
                    ok = false;
                  }
                );
                i = (i + usize(1));
              });
              ok
            }
          ),
        _ => false
      ),
    .FuncVal(_, _) => false,
    .ReturnVal(_, _) => false,
    .BreakVal => match(b,.BreakVal => true, _ => false),
    .ContinueVal => match(b,.ContinueVal => true, _ => false),
    .TypeVal(at) =>
      // EXACT type identity (not lenient compatibility): mirrors TS `areValuesEqual`
      // (value.ts:699-704) passing `requireExactMatch = true`. `eval_value_eq` keys the
      // specialization cache (`_find_specialization_cache`, on compile-time arg VALUES —
      // which include the forall type args like a HashMap's `V`), so a lenient compare
      // collapses distinct instantiations: `HashMap<usize, ArrayList>` and
      // `HashMap<usize, WhileLoopInfo>` are `are_types_compatible` (both `struct_13613`)
      // but NOT identical — a lenient key let `Self._alloc_with_capacity`'s specialization
      // for one V be reused for the other, so the callee's `Result<Self>` return type
      // disagreed with the call site (stage-2 Family-C incompatible-type cluster).
      match(b,.TypeVal(bt) => are_types_compatible_exact(at, bt), _ => false),
    .StructVal(atn, anames, avals) =>
      match(
        b,
        .StructVal(btn, bnames, bvals) =>
          cond(
            (!(atn == btn)) => false,
            (anames.len() != bnames.len()) => false,
            (avals.len() != bvals.len()) => false,
            true => {
              n_sf := anames.len();
              (sf_i : usize) = usize(0);
              (sf_ok : bool) = true;
              while((sf_i < n_sf) && sf_ok, {
                match(
                  anames.get(sf_i),
                  .Some(an_s) =>
                    match(
                      bnames.get(sf_i),
                      .Some(bn_s) => {
                        cond(
                          (!(an_s == bn_s)) => {
                            sf_ok = false;
                          },
                          true => ()
                        );
                      },
                      .None => {
                        sf_ok = false;
                      }
                    ),
                  .None => {
                    sf_ok = false;
                  }
                );
                match(
                  avals.get(sf_i),
                  .Some(av) =>
                    match(
                      bvals.get(sf_i),
                      .Some(bv) => {
                        cond(
                          (!(recur(av, bv))) => {
                            sf_ok = false;
                          },
                          true => ()
                        );
                      },
                      .None => {
                        sf_ok = false;
                      }
                    ),
                  .None => {
                    sf_ok = false;
                  }
                );
                sf_i = (sf_i + usize(1));
              });
              sf_ok
            }
          ),
        _ => false
      ),
    // Phase 2h variants ---------------------------------------------------------
    .TupleVal(afs) =>
      match(
        b,
        .TupleVal(bfs) =>
          cond(
            (afs.len() != bfs.len()) => false,
            true => {
              n_tv := afs.len();
              (tv_i : usize) = usize(0);
              (tv_ok : bool) = true;
              while((tv_i < n_tv) && tv_ok, {
                match(
                  afs.get(tv_i),
                  .Some(af) =>
                    match(
                      bfs.get(tv_i),
                      .Some(bf) => {
                        tv_ok = recur(af, bf);
                      },
                      .None => {
                        tv_ok = false;
                      }
                    ),
                  .None => {
                    tv_ok = false;
                  }
                );
                tv_i = (tv_i + usize(1));
              });
              tv_ok
            }
          ),
        _ => false
      ),
    .ArrayVal(aes) =>
      match(
        b,
        .ArrayVal(bes) =>
          cond(
            (aes.len() != bes.len()) => false,
            true => {
              n_av := aes.len();
              (av_i : usize) = usize(0);
              (av_ok : bool) = true;
              while((av_i < n_av) && av_ok, {
                match(
                  aes.get(av_i),
                  .Some(ae) =>
                    match(
                      bes.get(av_i),
                      .Some(be) => {
                        av_ok = recur(ae, be);
                      },
                      .None => {
                        av_ok = false;
                      }
                    ),
                  .None => {
                    av_ok = false;
                  }
                );
                av_i = (av_i + usize(1));
              });
              av_ok
            }
          ),
        _ => false
      ),
    // PtrVal: pointer alias identity is not portable; always unequal.
    .PtrVal(_, _) => false,
    .TraitVal(atn, afnames, afvals) =>
      match(
        b,
        .TraitVal(btn, bfnames, bfvals) =>
          cond(
            (!(atn == btn)) => false,
            (afnames.len() != bfnames.len()) => false,
            (afvals.len() != bfvals.len()) => false,
            true => {
              n_tr := afnames.len();
              (tr_i : usize) = usize(0);
              (tr_ok : bool) = true;
              while((tr_i < n_tr) && tr_ok, {
                match(
                  afnames.get(tr_i),
                  .Some(an_s) =>
                    match(
                      bfnames.get(tr_i),
                      .Some(bn_s) => {
                        cond(
                          (!(an_s == bn_s)) => {
                            tr_ok = false;
                          },
                          true => ()
                        );
                      },
                      .None => {
                        tr_ok = false;
                      }
                    ),
                  .None => {
                    tr_ok = false;
                  }
                );
                match(
                  afvals.get(tr_i),
                  .Some(ao) =>
                    match(
                      bfvals.get(tr_i),
                      .Some(bo) => {
                        cond(
                          (ao.is_none() && bo.is_none()) => (),
                          (ao.is_some() && bo.is_some()) => {
                            cond(
                              (!(recur(ao.unwrap(), bo.unwrap()))) => {
                                tr_ok = false;
                              },
                              true => ()
                            );
                          },
                          true => {
                            tr_ok = false;
                          }
                        );
                      },
                      .None => {
                        tr_ok = false;
                      }
                    ),
                  .None => {
                    tr_ok = false;
                  }
                );
                tr_i = (tr_i + usize(1));
              });
              tr_ok
            }
          ),
        _ => false
      ),
    .ComptimeListVal(aes) =>
      match(
        b,
        .ComptimeListVal(bes) =>
          cond(
            (aes.len() != bes.len()) => false,
            true => {
              n_cl := aes.len();
              (cl_i : usize) = usize(0);
              (cl_ok : bool) = true;
              while((cl_i < n_cl) && cl_ok, {
                match(
                  aes.get(cl_i),
                  .Some(ae) =>
                    match(
                      bes.get(cl_i),
                      .Some(be) => {
                        cl_ok = recur(ae, be);
                      },
                      .None => {
                        cl_ok = false;
                      }
                    ),
                  .None => {
                    cl_ok = false;
                  }
                );
                cl_i = (cl_i + usize(1));
              });
              cl_ok
            }
          ),
        _ => false
      ),
    // ExprVal: full structural equality — Atoms by token value, FnCalls by
    // callee + args recursively (mirrors TS areValuesEqual → exprsAreEqual).
    .ExprVal(a_ex) => match(
      b,
      .ExprVal(b_ex) => exprs_are_equal(a_ex, b_ex),
      _ => false
    ),
    // UnknownVal: two unknowns are equal if they represent the same type.
    .UnknownVal(aty) => match(b,.UnknownVal(bty) => are_types_compatible(aty, bty), _ => false)
  )
);
impl(
  EvalValue,
  Eq(EvalValue)(
    (==) : (fn(a : Self, b : Self) -> bool)(eval_value_eq(a, b))
  )
);
// ---------------------------------------------------------------------------
// value_to_string — mirrors `valueToString` from src/value.ts
// ---------------------------------------------------------------------------
{ type_to_string } :: import("./types/string.yo");
/// Convert an `EvalValue` to a human-readable string for debugging.
/// Mirrors `valueToString` in `src/value.ts`.
value_to_string :: (fn(v : EvalValue) -> String)(
  match(
    v,
    .UnitVal => String.from("()"),
    .BoolVal(b) => if(b, String.from("true"), String.from("false")),
    .IntLit(raw) => raw.clone(),
    .FloatLit(raw) => raw.clone(),
    .StrLit(raw) => raw.clone(),
    .VarRef(name) => name.clone(),
    .EnumVal(variant, fields) =>
      cond(
        (fields.len() == usize(0)) => `${variant}`,
        true => {
          parts := String.from("");
          (fi : usize) = usize(0);
          n_f := fields.len();
          while(fi < n_f, {
            cond(
              (fi > usize(0)) => {
                parts = `${parts}, `;
              },
              true => ()
            );
            match(
              fields.get(fi),
              .Some(f) => {
                fs := recur(f);
                parts = `${parts}${fs}`;
              },
              .None => ()
            );
            fi = (fi + usize(1));
          });
          `${variant}(${parts})`
        }
      ),
    .FuncVal(__fvd1, _) => {
      param_str := String.from("");
      (pi : usize) = usize(0);
      n_p := __fvd1.*.params.len();
      while(pi < n_p, {
        cond(
          (pi > usize(0)) => {
            param_str = `${param_str}, `;
          },
          true => ()
        );
        match(
          __fvd1.*.params.get(pi),
          .Some(p) => {
            param_str = `${param_str}${p}`;
          },
          .None => ()
        );
        pi = (pi + usize(1));
      });
      `<fn(${param_str})>`
    },
    .ReturnVal(val, _) => {
      inner := recur(val);
      `return(${inner})`
    },
    .BreakVal => String.from("break"),
    .ContinueVal => String.from("continue"),
    .TypeVal(ty) => type_to_string(ty),
    .StructVal(ty_name, field_names, field_values) => {
      parts_sv := String.from("");
      (svi : usize) = usize(0);
      n_sv := field_names.len();
      while(svi < n_sv, {
        cond(
          (svi > usize(0)) => {
            parts_sv = `${parts_sv}, `;
          },
          true => ()
        );
        match(
          field_names.get(svi),
          .Some(fn_s) => {
            match(
              field_values.get(svi),
              .Some(fv_s) => {
                fvs := recur(fv_s);
                parts_sv = `${parts_sv}${fn_s}: ${fvs}`;
              },
              .None => {
                parts_sv = `${parts_sv}${fn_s}`;
              }
            );
          },
          .None => ()
        );
        svi = (svi + usize(1));
      });
      `${ty_name}(${parts_sv})`
    },
    .TupleVal(fields) => {
      n_tup := fields.len();
      cond(
        (n_tup == usize(0)) => String.from("()"),
        true => {
          parts_tup := String.from("");
          (ti : usize) = usize(0);
          while(ti < n_tup, {
            cond(
              (ti > usize(0)) => {
                parts_tup = `${parts_tup}, `;
              },
              true => ()
            );
            match(
              fields.get(ti),
              .Some(f) => {
                fs_tup := recur(f);
                parts_tup = `${parts_tup}${fs_tup}`;
              },
              .None => ()
            );
            ti = (ti + usize(1));
          });
          cond(
            (n_tup == usize(1)) => `(${parts_tup},)`,
            true => `(${parts_tup})`
          )
        }
      )
    },
    .ArrayVal(elements) => {
      n_arr := elements.len();
      parts_arr := String.from("");
      (arri : usize) = usize(0);
      while(arri < n_arr, {
        cond(
          (arri > usize(0)) => {
            parts_arr = `${parts_arr}, `;
          },
          true => ()
        );
        match(
          elements.get(arri),
          .Some(e) => {
            es_arr := recur(e);
            parts_arr = `${parts_arr}${es_arr}`;
          },
          .None => ()
        );
        arri = (arri + usize(1));
      });
      cond(
        (n_arr == usize(1)) => `[${parts_arr},]`,
        true => `[${parts_arr}]`
      )
    },
    .PtrVal(target, index) =>
      match(
        target,
        .ArrayVal(elems) =>
          match(
            elems.get(index),
            .Some(e) => {
              es_ptr := recur(e);
              `<ptr to ${es_ptr}>`
            },
            .None => String.from("<ptr to ?>")
          ),
        _ => {
          ts_ptr := recur(target);
          `<ptr to ${ts_ptr}>`
        }
      ),
    .TraitVal(ty_name, field_names, field_values) => {
      parts_tr := String.from("");
      (tri : usize) = usize(0);
      n_tr_f := field_names.len();
      while(tri < n_tr_f, {
        cond(
          (tri > usize(0)) => {
            parts_tr = `${parts_tr}, `;
          },
          true => ()
        );
        match(
          field_names.get(tri),
          .Some(fn_tr) => {
            match(
              field_values.get(tri),
              .Some(fv_opt) =>
                match(
                  fv_opt,
                  .Some(fv_tr) => {
                    fvtrs := recur(fv_tr);
                    parts_tr = `${parts_tr}${fn_tr}: ${fvtrs}`;
                  },
                  .None => {
                    parts_tr = `${parts_tr}${fn_tr}: <runtime>`;
                  }
                ),
              .None => {
                parts_tr = `${parts_tr}${fn_tr}`;
              }
            );
          },
          .None => ()
        );
        tri = (tri + usize(1));
      });
      `${ty_name}(${parts_tr})`
    },
    .ComptimeListVal(elements) => {
      parts_cl := String.from("");
      (cli : usize) = usize(0);
      n_cl_vs := elements.len();
      while(cli < n_cl_vs, {
        cond(
          (cli > usize(0)) => {
            parts_cl = `${parts_cl}, `;
          },
          true => ()
        );
        match(
          elements.get(cli),
          .Some(e) => {
            es_cl := recur(e);
            parts_cl = `${parts_cl}${es_cl}`;
          },
          .None => ()
        );
        cli = (cli + usize(1));
      });
      `comptime_list(${parts_cl})`
    },
    .ExprVal(_) => String.from("<expr>"),
    .UnknownVal(ty) => {
      ts := type_to_string(ty);
      `<unknown: ${ts}>`
    }
  )
);
// ---------------------------------------------------------------------------
// Type predicate functions — mirrors is* functions from src/value.ts
// ---------------------------------------------------------------------------
is_unit_val :: (fn(v : EvalValue) -> bool)(match(v,.UnitVal => true, _ => false));
is_bool_val :: (fn(v : EvalValue) -> bool)(match(v,.BoolVal(_) => true, _ => false));
is_int_lit :: (fn(v : EvalValue) -> bool)(match(v,.IntLit(_) => true, _ => false));
is_float_lit :: (fn(v : EvalValue) -> bool)(match(v,.FloatLit(_) => true, _ => false));
is_str_lit :: (fn(v : EvalValue) -> bool)(match(v,.StrLit(_) => true, _ => false));
is_var_ref :: (fn(v : EvalValue) -> bool)(match(v,.VarRef(_) => true, _ => false));
is_enum_val :: (fn(v : EvalValue) -> bool)(match(v,.EnumVal(_, _) => true, _ => false));
is_func_val :: (fn(v : EvalValue) -> bool)(match(v,.FuncVal(_, _) => true, _ => false));
is_return_val :: (fn(v : EvalValue) -> bool)(match(v,.ReturnVal(_, _) => true, _ => false));
is_break_val :: (fn(v : EvalValue) -> bool)(match(v,.BreakVal => true, _ => false));
is_continue_val :: (fn(v : EvalValue) -> bool)(match(v,.ContinueVal => true, _ => false));
is_type_val :: (fn(v : EvalValue) -> bool)(match(v,.TypeVal(_) => true, _ => false));
is_struct_val :: (fn(v : EvalValue) -> bool)(match(v,.StructVal(_, _, _) => true, _ => false));
/// True for source-namespace struct values (anonymous modules / imports).
/// TS has no module value kind — modules are StructValues with a
/// source-namespace type (plans/MODULE_AS_STRUCT_ALIGNMENT.md); the
/// generated `source_namespace_` ty_name prefix is the value-side marker.
is_module_val :: (fn(v : EvalValue) -> bool)(match(v,.StructVal(n, _, _) => n.starts_with(`source_namespace_`), _ => false));
is_tuple_val :: (fn(v : EvalValue) -> bool)(match(v,.TupleVal(_) => true, _ => false));
is_array_val :: (fn(v : EvalValue) -> bool)(match(v,.ArrayVal(_) => true, _ => false));
is_ptr_val :: (fn(v : EvalValue) -> bool)(match(v,.PtrVal(_, _) => true, _ => false));
is_trait_val :: (fn(v : EvalValue) -> bool)(match(v,.TraitVal(_, _, _) => true, _ => false));
is_comptime_list_val :: (fn(v : EvalValue) -> bool)(match(v,.ComptimeListVal(_) => true, _ => false));
is_expr_val :: (fn(v : EvalValue) -> bool)(match(v,.ExprVal(_) => true, _ => false));
is_unknown_val :: (fn(v : EvalValue) -> bool)(match(v,.UnknownVal(_) => true, _ => false));
/// Check if `v` is a numeric literal (int or float). Mirrors TS
/// `isNumberValue` in `src/value.ts`, which covers all numeric
/// variants. yo-self stores numerics as `IntLit` / `FloatLit` raw
/// text; this helper is the disjunction of those two checks.
is_number_val :: (fn(v : EvalValue) -> bool)(
  match(v,.IntLit(_) => true,.FloatLit(_) => true, _ => false)
);
/// Check if `v` is a compile-time integer literal (`IntLit`).
/// Mirrors TS `isComptimeIntValue` in `src/value.ts`. yo-self stores
/// integer literals as raw text in `IntLit(raw)`; this helper is the
/// canonical-named alias of `is_int_lit`.
is_comptime_int_value :: (fn(v : EvalValue) -> bool)(
  match(v,.IntLit(_) => true, _ => false)
);
/// Check if `v` is a compile-time float literal (`FloatLit`).
/// Mirrors TS `isComptimeFloatValue` in `src/value.ts`. yo-self
/// stores float literals as raw text in `FloatLit(raw)`; this helper
/// is the canonical-named alias of `is_float_lit`.
is_comptime_float_value :: (fn(v : EvalValue) -> bool)(
  match(v,.FloatLit(_) => true, _ => false)
);
/// Check if `v` is a compile-time string literal (`StrLit`). Mirrors
/// TS `isComptimeStringValue` in `src/value.ts`. yo-self does not
/// distinguish runtime-`str` from comptime-string at the EvalValue
/// level — the lexer-stored `StrLit(raw)` is the comptime-string
/// representation; runtime `str` values are constructed via
/// `convert_comptime_type_to_runtime_type`.
is_comptime_string_value :: (fn(v : EvalValue) -> bool)(
  match(v,.StrLit(_) => true, _ => false)
);
/// Check if an `Option(EvalValue)` contains a `TypeVal`.
/// Mirrors `isTypeValue(value)` from `src/value.ts`.
is_type_value :: (fn(opt : Option(EvalValue)) -> bool)(
  match(
    opt,
    .Some(v) => match(v,.TypeVal(_) => true, _ => false),
    .None => false
  )
);
/// Create a compile-time unknown placeholder for type `ty`.
/// Mirrors `createUnknownValue` in `src/value.ts` for the common (non-SomeType) case.
/// For type-level unknowns (`TypeUni(0)`), prefer `create_unknown_val_with_name`
/// which builds a `TypeVal(SomeType)` — required for extern/c_include fields whose
/// declared type is `Type` so that later expressions can use the name as a type
/// (e.g. `INT_LEAST8_MIN : int_least8_t`).
create_unknown_val :: (fn(ty : TypeValue) -> EvalValue)(
  EvalValue.UnknownVal(ty)
);
/// Create a compile-time unknown placeholder, promoting to `TypeVal(SomeType)` when
/// `ty` is the `Type` universe (i.e. the binding is type-level). Mirrors the TS
/// path in `createUnknownValue` (`src/value.ts:573-588`) that returns a fresh
/// `SomeType` wrapped as a `TypeValue` whenever the slot's declared type is `Type`.
create_unknown_val_with_name :: (fn(ty : TypeValue, name : String) -> EvalValue)(
  cond(
    is_type_0(ty) =>
      EvalValue.TypeVal(t_some_t(name, usize(0))),
    true => EvalValue.UnknownVal(ty)
  )
);
/// The result of evaluating a single `AstExpr` node.
EvalResult :: ref(
  struct(
    /// The evaluated value (or a runtime reference marker).
    value : EvalValue,
    /// The compile-time type of the expression.
    ty : TypeValue
  )
);
/// Construct an `EvalResult` with the given value and type.
eval_result :: (fn(value : EvalValue, ty : TypeValue) -> EvalResult)(
  EvalResult(value : value, ty : ty)
);
/// Wrap a TypeValue as a TypeVal EvalValue. Mirrors `createTypeValue` in
/// `src/value.ts`. The "meta type" (TypeUni) is computed separately via
/// `type_of_type` at call sites that need it.
create_type_value :: (fn(ty : TypeValue) -> EvalValue)(
  EvalValue.TypeVal(ty)
);
/// Best-effort recovery of a `TypeValue` from a comptime `EvalValue`.
///
/// Mirrors the contract of "StructValue.type" in `src/value.ts`: yo-self
/// values do not carry a parallel type reference, so handlers like
/// `evaluate_open` recover per-field types by
/// inspecting each exported value. The mapping is deliberately conservative:
/// for value variants whose type is not directly recoverable we fall back to
/// `t_unit()`, which matches the production behavior of treating such fields
/// as opaque comptime bindings.
type_of_eval_value :: (fn(v : EvalValue) -> TypeValue)(
  match(
    v,
    .UnitVal => t_unit(),
    .BoolVal(_) => t_bool(),
    .IntLit(_) => t_comptime_int(),
    .FloatLit(_) => t_comptime_float(),
    .StrLit(_) => t_comptime_string(),
    .TypeVal(_) => t_type(),
    .StructVal(name, labels, vals) => {
      // Reconstruct a Struct type from parallel field info. Source-namespace
      // struct values (anonymous modules / imports — TS `SourceNamespaceType`)
      // carry their generated `source_namespace_<id>` as `ty_name`; recover
      // the `is_source_namespace` flag from that marker (the producer puts
      // the id in the type's ID slot and leaves the name empty — mirror that
      // here). Name-prefix detection is the stand-in for TS's `value.type`
      // back-reference (yo-self values don't carry their type).
      is_sns := name.starts_with(`source_namespace_`);
      tys := ArrayList(TypeValue).new();
      i := usize(0);
      while(i < vals.len(), {
        match(
          vals.get(i),
          .Some(fv) => tys.push(recur(fv)),
          .None => tys.push(t_unit())
        );
        i = (i + usize(1));
      });
      cond(
        is_sns =>.Struct(name, String.from(""), labels, tys, false, false, false, String.from(""), ArrayList(TypeValue).new(), true),
        true =>.Struct(String.from(""), name, labels, tys, false, false, false, String.from(""), ArrayList(TypeValue).new(), false)
      )
    },
    .UnknownVal(ty) => ty,
    _ => t_unit()
  )
);
export(EvalValue, FuncValData, EvalResult, eval_result, create_type_value, type_of_eval_value);
export(value_to_string);
export(is_unit_val, is_bool_val, is_int_lit, is_float_lit, is_str_lit, is_var_ref);
export(is_enum_val, is_func_val, is_return_val, is_break_val, is_type_val, is_struct_val, is_module_val);
export(is_tuple_val, is_array_val, is_ptr_val, is_trait_val);
export(is_comptime_list_val, is_expr_val, is_unknown_val);
export(
  is_number_val,
  is_comptime_int_value,
  is_comptime_float_value,
  is_comptime_string_value
);
export(is_type_value, create_unknown_val, create_unknown_val_with_name);
export(eval_value_eq);
// ---------------------------------------------------------------------------
// Enum constructor-func-id side-table. `TypeValue.EnumT` has no
// `constructor_func_id` field (only `Struct` does), so two instantiations of
// the same generic enum (`Option(X)`/`Option(Y)`) — distinct fresh ids — can't
// be recognized as the same constructor in synthesis. Records `enum_id ->
// func_id` whenever a comptime type-constructor call returns an `EnumT`
// (populated by `evaluate_comptime_fn_call`); the synthesizer's enum
// same_constructor guard reads it. Lives here (leaf both comptime_fn and
// synthesizer import, no cycle). `substitute()` preserves enum id → key stays
// valid across specialization. Mirrors `Struct.constructor_func_id`.
// ---------------------------------------------------------------------------
EnumCfidEntry :: ref(struct(enum_id : String, func_id : String));
(g_enum_cfids : ArrayList(EnumCfidEntry)) = ArrayList(EnumCfidEntry).new();
register_enum_cfid :: (fn(enum_id : String, func_id : String) -> unit)({
  if((enum_id.len() > usize(0)) && (func_id.len() > usize(0)), {
    g_enum_cfids.push(EnumCfidEntry(enum_id : enum_id, func_id : func_id));
  });
});
lookup_enum_cfid :: (fn(enum_id : String) -> String)({
  (i : usize) = usize(0);
  n := g_enum_cfids.len();
  (r : String) = String.from("");
  while((i < n) && (r.len() == usize(0)), {
    match(
      g_enum_cfids.get(i),
      .Some(e) => if(e.enum_id == enum_id, {
        r = e.func_id.clone();
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  r
});
export(register_enum_cfid, lookup_enum_cfid);
