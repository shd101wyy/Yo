//! Token types for the Yo lexer.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
TokenKind :: enum(
  Operator,
  Dot,
  LParen,
  RParen,
  LBracket,
  RBracket,
  LCurlyBracket,
  RCurlyBracket,
  CharLit,
  StringLit,
  TemplateString,
  Identifier,
  Integer,
  Float,
  Bool,
  Semicolon,
  Comma,
  SingleLineComment,
  MultiLineComment,
  DocLineComment,
  InnerDocLineComment,
  DocBlockComment,
  InnerDocBlockComment,
  Whitespace
);
derive(TokenKind, Eq(TokenKind), Hash, Clone, ToString);
Token :: ref(
  struct(
    kind : TokenKind,
    value : String,
    row : usize,
    column : usize,
    character : usize,
    module_path : String,
    input : String
  )
);
derive(Token, Eq(Token));
// `Token` is an `object` (Rc), not a value `struct` (P2 memory). Every `AstExpr`
// embeds a `Token` and `Variable` embeds two, and AST/variable clones are
// pervasive during the self-compile. As a value struct, each holder inlined the
// ~104-byte Token, and each clone copied it — once ~1.6 GB of peak when
// `derive(Clone)` also deep-copied the ~100–200 KB `input` source string. As an
// Rc object every holder stores an 8-byte pointer to ONE shared token, and
// `.clone()` is a refcount bump (the body returns `self`) that shares the whole
// token — positions, lexeme, and the immutable `input`/`module_path` source
// strings. Sound because tokens are immutable after lexing (no field is ever
// reassigned), and faithful to TS, where `Token` is a by-reference `interface`.
impl(
  Token,
  Clone(
    clone : (fn(inout(self) : Self) -> Self)(self)
  )
);
is_operator_char :: (fn(c : rune) -> bool)(
  cond(
    (c.char == u32(61)) => true,
    (c.char == u32(43)) => true,
    (c.char == u32(45)) => true,
    (c.char == u32(42)) => true,
    (c.char == u32(47)) => true,
    (c.char == u32(60)) => true,
    (c.char == u32(62)) => true,
    (c.char == u32(64)) => true,
    (c.char == u32(36)) => true,
    (c.char == u32(126)) => true,
    (c.char == u32(38)) => true,
    (c.char == u32(37)) => true,
    (c.char == u32(124)) => true,
    (c.char == u32(33)) => true,
    (c.char == u32(63)) => true,
    (c.char == u32(94)) => true,
    (c.char == u32(46)) => true,
    (c.char == u32(58)) => true,
    (c.char == u32(92)) => true,
    (c.char == u32(35)) => true,
    true => false
  )
);
is_identifier_start :: (fn(c : rune) -> bool)(
  ((c.char == u32(95)) || c.is_alphabetic()) || (c.char >= u32(0xA0))
);
is_identifier_continue :: (fn(c : rune) -> bool)(
  (is_identifier_start(c)) || c.is_digit()
);
/// True iff every char of `s` is an operator char. Mirrors
/// `stringIsOperator` in `src/token.ts`.
string_is_operator :: (fn(s : String) -> bool)({
  n := s.bytes_len();
  cond(
    (n == usize(0)) => false,
    true => {
      (i : usize) = usize(0);
      (ok : bool) = true;
      while((i < n) && ok, {
        b := s.byte_at(i);
        // Operator chars: same set as is_operator_char, but on bytes
        is_op := cond(
          (b == u8(61)) => true,
          // =
          (b == u8(43)) => true,
          // +
          (b == u8(45)) => true,
          // -
          (b == u8(42)) => true,
          // *
          (b == u8(47)) => true,
          // /
          (b == u8(60)) => true,
          // <
          (b == u8(62)) => true,
          // >
          (b == u8(64)) => true,
          // @
          (b == u8(36)) => true,
          // $
          (b == u8(126)) => true,
          // ~
          (b == u8(38)) => true,
          // &
          (b == u8(37)) => true,
          // %
          (b == u8(124)) => true,
          // |
          (b == u8(33)) => true,
          // !
          (b == u8(63)) => true,
          // ?
          (b == u8(94)) => true,
          // ^
          (b == u8(46)) => true,
          // .
          (b == u8(58)) => true,
          // :
          (b == u8(92)) => true,
          // \
          (b == u8(35)) => true,
          // #
          true => false
        );
        if(!(is_op), {
          ok = false;
        });
        i = (i + usize(1));
      });
      ok
    }
  )
});
/// True iff `s` is a valid identifier under the regex
/// `^[_a-zA-Z\xA0-￿][_a-zA-Z0-9\xA0-￿]*$`. Mirrors
/// `IdentifierRegex.test(s)` in `src/token.ts`.
is_valid_identifier :: (fn(s : String) -> bool)({
  chars := ArrayList(rune).new();
  {
    c_iter := s.chars();
    while(true, {
      match(
        c_iter.next(),
        .None => {
          break;
        },
        .Some(r) => {
          chars.push(r);
        }
      );
    });
  };
  n := chars.len();
  cond(
    (n == usize(0)) => false,
    true => {
      first := match(chars.get(usize(0)),.Some(c) => c,.None => rune(u32(0)));
      cond(
        (!(is_identifier_start(first))) => false,
        true => {
          (i : usize) = usize(1);
          (ok : bool) = true;
          while((i < n) && ok, {
            ch := match(chars.get(i),.Some(c) => c,.None => rune(u32(0)));
            if(!(is_identifier_continue(ch)), {
              ok = false;
            });
            i = (i + usize(1));
          });
          ok
        }
      )
    }
  )
});
/// Synthetic placeholder token used as a sentinel position when constructing
/// AST nodes that have no real source location. Mirrors `PlaceholderToken`
/// in `src/token.ts`.
placeholder_token :: (fn() -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from("_"),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("_"),
    input : String.from("_")
  )
);
/// Synthetic token used for `drop` (RAII) markers attached to compiler-generated
/// drop expressions. Mirrors `RAIIToken` in `src/token.ts`.
raii_token :: (fn() -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from("drop"),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("drop"),
    input : String.from("drop")
  )
);
find_matching_bracket :: (fn(tokens : ArrayList(Token), start : usize) -> Option(usize))({
  n := tokens.len();
  if(start >= n, {
    return(.None);
  });
  start_tok := match(
    tokens.get(start),
    .Some(t) => t,
    .None => {
      return(.None);
    }
  );
  start_kind := start_tok.kind;
  is_open_bracket := (((start_kind == TokenKind.LCurlyBracket) || (start_kind == TokenKind.LParen)) || (start_kind == TokenKind.LBracket));
  if(!(is_open_bracket), {
    return(.None);
  });
  (end_kind : TokenKind) = cond(
    (start_kind == TokenKind.LCurlyBracket) => TokenKind.RCurlyBracket,
    (start_kind == TokenKind.LParen) => TokenKind.RParen,
    true => TokenKind.RBracket
  );
  i := (start + usize(1));
  depth := usize(1);
  while(i < n, {
    tk_opt := tokens.get(i);
    match(
      tk_opt,
      .None => {
        break;
      },
      .Some(tok) => {
        tk := tok.kind;
        cond(
          (tk == end_kind) => {
            depth = (depth - usize(1));
            if(depth == usize(0), {
              return(.Some(i));
            });
          },
          (tk == start_kind) => {
            depth = (depth + usize(1));
          },
          true => ()
        );
      }
    );
    i = (i + usize(1));
  });
  .None
});
export(
  TokenKind,
  Token,
  is_operator_char,
  is_identifier_start,
  is_identifier_continue,
  string_is_operator,
  is_valid_identifier,
  placeholder_token,
  raii_token,
  find_matching_bracket
);
