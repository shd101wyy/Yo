//! Source formatter for Yo — 1-to-1 port of `src/formatter.ts`.
//!
//! Entry points:
//!   * `format_yo_source(input, module_path) -> String` — pure formatter.
//!   * `find_yo_format_files(target_path) -> ArrayList(String)` — directory walker.
//!   * `format_yo_files(target_path, options) -> FormatYoFilesResult` — apply to
//!     all matching files (with optional `--check` mode).
//!
//! Status (Phase A.10): foundations + small helpers. The main
//! `format_yo_source` pipeline is stubbed (returns the input unchanged) and
//! will be filled in by successive commits.
open(import("std/string"));
open(import("std/error"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ Path } :: import("std/path");
{ read_file, write_file, is_file, is_dir, exists } :: import("std/fs/file");
{ DirEntry, FileType, read_dir } :: import("std/fs/dir");
{ HashMap } :: import("std/collections/hash_map");
{ Token, TokenKind } :: import("./token.yo");
{ tokenize } :: import("./lexer.yo");
// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
/// Number of spaces per indentation level. Mirrors `INDENT_SIZE` in
/// `src/formatter.ts`.
INDENT_SIZE :: usize(2);
// ---------------------------------------------------------------------------
// Token-kind classifiers
// ---------------------------------------------------------------------------
// In TypeScript these are `Set<TokenType>` constants tested with `.has(...)`.
// In yo-self the variant kinds are an enum, so a simple predicate is more
// idiomatic than a HashSet of enum values.
/// True iff `kind` is any comment token (single-line, block, doc-line,
/// inner-doc-line, doc-block, inner-doc-block). Mirrors `COMMENT_TOKEN_TYPES`.
is_comment_token :: (fn(kind : TokenKind) -> bool)(
  cond(
    (kind == TokenKind.SingleLineComment) => true,
    (kind == TokenKind.MultiLineComment) => true,
    (kind == TokenKind.DocLineComment) => true,
    (kind == TokenKind.InnerDocLineComment) => true,
    (kind == TokenKind.DocBlockComment) => true,
    (kind == TokenKind.InnerDocBlockComment) => true,
    true => false
  )
);
/// True iff `kind` is a single-line comment variant. Mirrors
/// `LINE_COMMENT_TOKEN_TYPES`.
is_line_comment_token :: (fn(kind : TokenKind) -> bool)(
  cond(
    (kind == TokenKind.SingleLineComment) => true,
    (kind == TokenKind.DocLineComment) => true,
    (kind == TokenKind.InnerDocLineComment) => true,
    true => false
  )
);
/// True iff `kind` is an atom-like token (Identifier / Integer / Float /
/// Bool / StringLit / CharLit / TemplateString). Mirrors `ATOM_LIKE_TOKEN_TYPES`.
is_atom_like_token :: (fn(kind : TokenKind) -> bool)(
  cond(
    (kind == TokenKind.Identifier) => true,
    (kind == TokenKind.Integer) => true,
    (kind == TokenKind.Float) => true,
    (kind == TokenKind.Bool) => true,
    (kind == TokenKind.StringLit) => true,
    (kind == TokenKind.CharLit) => true,
    (kind == TokenKind.TemplateString) => true,
    true => false
  )
);
/// True iff `name` is a directory the formatter should skip when walking
/// `format_yo_files`. Mirrors `IGNORED_FORMAT_DIRS`.
is_ignored_format_dir :: (fn(name : String) -> bool)(
  cond(
    (name == ".git") => true,
    (name == ".yo-cache") => true,
    (name == "node_modules") => true,
    (name == "out") => true,
    (name == "yo-out") => true,
    true => false
  )
);
// ---------------------------------------------------------------------------
// Public option / result records
// ---------------------------------------------------------------------------
/// Options passed to `format_yo_files`. Mirrors `FormatYoFilesOptions` in
/// `src/formatter.ts`. `check` = true switches to dry-run mode (no writes,
/// `changed` lists files that WOULD be rewritten). `cwd` is the directory
/// from which relative paths are resolved.
FormatYoFilesOptions :: struct(
  check : bool,
  cwd : String
);
/// Result of `format_yo_files`. `files` is every file visited, `changed` is
/// the subset that was rewritten (or would be in `check` mode). Mirrors
/// `FormatYoFilesResult` in `src/formatter.ts`.
FormatYoFilesResult :: struct(
  files : ArrayList(String),
  changed : ArrayList(String)
);
// ---------------------------------------------------------------------------
// Small helpers (mostly from src/formatter.ts lines 1093-1334)
// ---------------------------------------------------------------------------
/// True iff `previous` (the token immediately before `(`) makes the paren a
/// call delimiter — i.e. the paren follows an rvalue-end. Mirrors
/// `parenIsCallDelimiter`.
paren_is_call_delimiter :: (fn(previous : Option(Token)) -> bool)(
  match(
    previous,
    .None => false,
    .Some(p) => (
      is_atom_like_token(p.kind) || (
        (p.kind == TokenKind.RParen) || (
          (p.kind == TokenKind.RBracket) || (p.kind == TokenKind.RCurlyBracket)
        )
      )
    )
  )
);
/// True iff `operator` is one of `:=`, `::`, `=`, `:`, `=>`, `->` — operators
/// whose right-hand side does not require parenthesisation. Mirrors
/// `operatorAllowsUngroupedRhs`.
operator_allows_ungrouped_rhs :: (fn(op : String) -> bool)(
  cond(
    (op == ":=") => true,
    (op == "::") => true,
    (op == "=") => true,
    (op == ":") => true,
    (op == "=>") => true,
    (op == "->") => true,
    true => false
  )
);
/// True iff `value` is one of the function-type keywords (`fn` or
/// `unsafe_fn`). Mirrors `isFunctionTypeKeyword`.
is_function_type_keyword :: (fn(value : String) -> bool)(
  cond(
    (value == "fn") => true,
    (value == "unsafe_fn") => true,
    true => false
  )
);
/// True iff inserting an atom right after `previous` requires a leading
/// space (so the tokens don't run together). Mirrors `needsSpaceBeforeAtom`.
needs_space_before_atom :: (fn(previous : Option(Token)) -> bool)(
  match(
    previous,
    .None => false,
    .Some(p) => (
      is_atom_like_token(p.kind) || (
        (p.kind == TokenKind.RParen) || (
          (p.kind == TokenKind.RBracket) || (p.kind == TokenKind.RCurlyBracket)
        )
      )
    )
  )
);
/// True iff `token` (a prefix operator like `!`, `-`, `&`, `~`) needs a
/// leading space to separate from `previous`. Specifically:
///   * After a comma — yes.
///   * After another operator (except `.`) — yes, otherwise the lexer would
///     merge them into one token (e.g. `||!` or `+!`).
///   * Exception: `...` followed by `#` does not need a space.
///
/// Mirrors `prefixOperatorNeedsLeadingSpace`.
prefix_operator_needs_leading_space :: (fn(token : Token, previous : Option(Token)) -> bool)(
  match(
    previous,
    .None => false,
    .Some(p) => cond(
      (((p.kind == TokenKind.Operator) && (p.value == "...")) && (token.value == "#")) => false,
      (p.kind == TokenKind.Comma) => true,
      ((p.kind == TokenKind.Operator) && (p.value != ".")) => true,
      true => false
    )
  )
);
/// Strip trailing space / tab characters from `s` and return the trimmed
/// string. Newlines and other whitespace are preserved.
///
/// Mirrors `trimTrailingHorizontalWhitespace` in `src/formatter.ts` (which
/// mutates `result` via `replace(/[ \t]+$/u, "")`). Used before emitting
/// closing delimiters and statement terminators to absorb the placeholder
/// space added by `ensureSpace`-style helpers.
_trim_trailing_h_ws :: (fn(s : String) -> String)({
  bytes := s.as_bytes();
  n := bytes.len();
  (i : usize) = n;
  (done : bool) = false;
  while((i > usize(0)) && (!(done)), {
    b := match(bytes.get(i - usize(1)), .Some(x) => x, .None => u8(0));
    if((b == u8(32)) || (b == u8(9)), {
      i = (i - usize(1));
    }, {
      done = true;
    });
  });
  cond(
    (i == n) => s,
    true => s.substring(usize(0), i)
  )
});
/// Count the leading `[ \t]*` characters of `line`. Mirrors
/// `leadingWhitespaceLength`.
leading_whitespace_length :: (fn(line : String) -> usize)({
  n := line.bytes_len();
  (i : usize) = usize(0);
  (done : bool) = false;
  while((i < n) && (!(done)), {
    b := line.byte_at(i);
    cond(
      (b == u8(32)) => {
        i = (i + usize(1));
      },
      (b == u8(9)) => {
        i = (i + usize(1));
      },
      true => {
        done = true;
      }
    );
  });
  i
});
// ---------------------------------------------------------------------------
// Token-iteration helpers
// ---------------------------------------------------------------------------
/// Walk past comment tokens (anything matching `is_comment_token`) before
/// `index`, returning the nearest non-comment predecessor. Mirrors
/// `previousMeaningfulToken`.
previous_meaningful_token :: (fn(tokens : ArrayList(Token), index : usize) -> Option(Token))({
  if(index == usize(0), {
    return(Option(Token).None);
  });
  (i : usize) = (index - usize(1));
  (result : Option(Token)) = Option(Token).None;
  (done : bool) = false;
  while(!(done), {
    match(
      tokens.get(i),
      .None => {
        done = true;
      },
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          result = Option(Token).Some(t);
          done = true;
        }
      )
    );
    if((!(done)) && (i == usize(0)), {
      done = true;
    }, {
      if(!(done), {
        i = (i - usize(1));
      });
    });
  });
  result
});
/// Walk past comment tokens (anything matching `is_comment_token`) after
/// `index`, returning the nearest non-comment successor within
/// `[index+1, end_exclusive)`. Mirrors `nextMeaningfulToken`.
next_meaningful_token :: (fn(tokens : ArrayList(Token), index : usize, end_exclusive : usize) -> Option(Token))({
  (i : usize) = (index + usize(1));
  (result : Option(Token)) = Option(Token).None;
  (done : bool) = false;
  while((i < end_exclusive) && (!(done)), {
    match(
      tokens.get(i),
      .None => {
        done = true;
      },
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          result = Option(Token).Some(t);
          done = true;
        }
      )
    );
    i = (i + usize(1));
  });
  result
});
/// True iff any token in `[start_inclusive, end_exclusive)` is a comment.
/// Mirrors `tokenRangeHasComment`.
token_range_has_comment :: (fn(tokens : ArrayList(Token), start_inclusive : usize, end_exclusive : usize) -> bool)({
  (i : usize) = start_inclusive;
  (found : bool) = false;
  while((i < end_exclusive) && (!(found)), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => if(is_comment_token(t.kind), {
        found = true;
      })
    );
    i = (i + usize(1));
  });
  found
});
/// True iff any token in `(left_index, right_index)` (exclusive both ends)
/// has the given kind. No bracket nesting awareness. Mirrors `hasAnyToken`.
has_any_token :: (fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, kind : TokenKind) -> bool)({
  (i : usize) = (left_index + usize(1));
  (found : bool) = false;
  while((i < right_index) && (!(found)), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => if(t.kind == kind, {
        found = true;
      })
    );
    i = (i + usize(1));
  });
  found
});
/// True iff there is a top-level (no nesting) token of `kind` in
/// `(left_index, right_index)`. Skips comments and tracks paren / bracket /
/// curly depth so e.g. a comma inside an inner paren doesn't count.
/// Mirrors `hasTopLevelToken`.
has_top_level_token :: (fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, kind : TokenKind) -> bool)({
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  (curly_depth : usize) = usize(0);
  (i : usize) = (left_index + usize(1));
  (found : bool) = false;
  while((i < right_index) && (!(found)), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        ((t.kind == kind) && (((paren_depth == usize(0)) && (bracket_depth == usize(0))) && (curly_depth == usize(0)))) => {
          found = true;
        },
        (t.kind == TokenKind.LParen) => {
          paren_depth = (paren_depth + usize(1));
        },
        ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
          paren_depth = (paren_depth - usize(1));
        },
        (t.kind == TokenKind.LBracket) => {
          bracket_depth = (bracket_depth + usize(1));
        },
        ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
          bracket_depth = (bracket_depth - usize(1));
        },
        (t.kind == TokenKind.LCurlyBracket) => {
          curly_depth = (curly_depth + usize(1));
        },
        ((t.kind == TokenKind.RCurlyBracket) && (curly_depth > usize(0))) => {
          curly_depth = (curly_depth - usize(1));
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  found
});
/// True iff any top-level (no nesting) token in `(left_index, right_index)`
/// is an Operator. Skips comments. Mirrors `hasTopLevelOperator`.
has_top_level_operator :: (fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool)(
  has_top_level_token(tokens, left_index, right_index, TokenKind.Operator)
);
// ---------------------------------------------------------------------------
// Set/Map computation helpers
// ---------------------------------------------------------------------------
/// Walk past tokens whose index is in `skipped_indices`, returning the
/// nearest non-skipped successor. Mirrors `nextToken`.
next_token :: (fn(tokens : ArrayList(Token), skipped_indices : HashSet(usize), index : usize) -> Option(Token))({
  n := tokens.len();
  (next_index : usize) = (index + usize(1));
  (result : Option(Token)) = Option(Token).None;
  (done : bool) = false;
  while((next_index < n) && (!(done)), {
    cond(
      skipped_indices.contains(next_index) => (),
      true => {
        result = tokens.get(next_index);
        done = true;
      }
    );
    next_index = (next_index + usize(1));
  });
  result
});
/// Build a map of each `LParen` index → its matching `RParen` index.
/// Mirrors `findMatchingParenIndices`.
find_matching_paren_indices :: (fn(tokens : ArrayList(Token)) -> HashMap(usize, usize))({
  pairs := HashMap(usize, usize).new();
  stack := ArrayList(usize).new();
  n := tokens.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LParen) => {
          _r := stack.push(i);
        },
        (t.kind == TokenKind.RParen) => {
          if(stack.len() > usize(0), {
            left := match(stack.get(stack.len() - usize(1)), .Some(x) => x, .None => usize(0));
            _r := stack.pop();
            _r2 := pairs.set(left, i);
          });
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  pairs
});
/// Build a map of each inner `LParen` index → its parent `LParen` index.
/// Top-level parens are absent. Mirrors `findParentParenIndices`.
find_parent_paren_indices :: (fn(tokens : ArrayList(Token)) -> HashMap(usize, usize))({
  parents := HashMap(usize, usize).new();
  stack := ArrayList(usize).new();
  n := tokens.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LParen) => {
          if(stack.len() > usize(0), {
            parent := match(stack.get(stack.len() - usize(1)), .Some(x) => x, .None => usize(0));
            _r := parents.set(i, parent);
          });
          _r2 := stack.push(i);
        },
        (t.kind == TokenKind.RParen) => {
          if(stack.len() > usize(0), {
            _r := stack.pop();
          });
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  parents
});
/// Compute the set of `LCurlyBracket` and matching `RCurlyBracket` indices
/// that should render on a single line (no top-level semicolons inside).
/// Mirrors `findInlineCurlyIndices`. Stack frames track per-frame
/// `paren_depth` / `bracket_depth` so semicolons inside nested calls don't
/// trigger multiline mode for the enclosing curly.
find_inline_curly_indices :: (fn(tokens : ArrayList(Token)) -> HashSet(usize))({
  inline_indices := HashSet(usize).new();
  stack_indices := ArrayList(usize).new();
  stack_paren_depths := ArrayList(usize).new();
  stack_bracket_depths := ArrayList(usize).new();
  stack_has_top_level_semi := ArrayList(bool).new();
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  n := tokens.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LCurlyBracket) => {
          _r1 := stack_indices.push(i);
          _r2 := stack_paren_depths.push(paren_depth);
          _r3 := stack_bracket_depths.push(bracket_depth);
          _r4 := stack_has_top_level_semi.push(false);
        },
        (t.kind == TokenKind.Semicolon) => {
          if(stack_indices.len() > usize(0), {
            top := (stack_indices.len() - usize(1));
            frame_paren := match(stack_paren_depths.get(top), .Some(x) => x, .None => usize(0));
            frame_bracket := match(stack_bracket_depths.get(top), .Some(x) => x, .None => usize(0));
            if((frame_paren == paren_depth) && (frame_bracket == bracket_depth), {
              // pop+push to update top-of-stack (ArrayList has no set-at-index)
              _p := stack_has_top_level_semi.pop();
              _r := stack_has_top_level_semi.push(true);
            });
          });
        },
        (t.kind == TokenKind.RCurlyBracket) => {
          if(stack_indices.len() > usize(0), {
            top := (stack_indices.len() - usize(1));
            left_idx := match(stack_indices.get(top), .Some(x) => x, .None => usize(0));
            has_semi := match(stack_has_top_level_semi.get(top), .Some(x) => x, .None => false);
            _p1 := stack_indices.pop();
            _p2 := stack_paren_depths.pop();
            _p3 := stack_bracket_depths.pop();
            _p4 := stack_has_top_level_semi.pop();
            if(!(has_semi), {
              _add1 := inline_indices.add(left_idx);
              _add2 := inline_indices.add(i);
            });
          });
        },
        (t.kind == TokenKind.LParen) => {
          paren_depth = (paren_depth + usize(1));
        },
        ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
          paren_depth = (paren_depth - usize(1));
        },
        (t.kind == TokenKind.LBracket) => {
          bracket_depth = (bracket_depth + usize(1));
        },
        ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
          bracket_depth = (bracket_depth - usize(1));
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  inline_indices
});
/// Compute indices of `LBracket` / `RBracket` pairs that span multiple
/// source rows. Mirrors `findMultilineBracketIndices`.
find_multiline_bracket_indices :: (fn(tokens : ArrayList(Token)) -> HashSet(usize))({
  multiline_indices := HashSet(usize).new();
  stack := ArrayList(usize).new();
  n := tokens.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LBracket) => {
          _r := stack.push(i);
        },
        (t.kind == TokenKind.RBracket) => {
          if(stack.len() > usize(0), {
            left_idx := match(stack.get(stack.len() - usize(1)), .Some(x) => x, .None => usize(0));
            _p := stack.pop();
            left_tok := match(tokens.get(left_idx), .Some(lt) => lt, .None => t);
            if(t.row > left_tok.row, {
              _add1 := multiline_indices.add(left_idx);
              _add2 := multiline_indices.add(i);
            });
          });
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  multiline_indices
});
/// Compute indices of `LCurlyBracket` / `RCurlyBracket` pairs that are
/// marked inline-eligible (by `find_inline_curly_indices`) but actually
/// span multiple rows in the source. Mirrors `findMultilineInlineCurlyIndices`.
find_multiline_inline_curly_indices :: (fn(tokens : ArrayList(Token), inline_curly_indices : HashSet(usize)) -> HashSet(usize))({
  multiline_indices := HashSet(usize).new();
  stack := ArrayList(usize).new();
  n := tokens.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LCurlyBracket) => {
          _r := stack.push(i);
        },
        (t.kind == TokenKind.RCurlyBracket) => {
          if(stack.len() > usize(0), {
            left_idx := match(stack.get(stack.len() - usize(1)), .Some(x) => x, .None => usize(0));
            _p := stack.pop();
            left_tok := match(tokens.get(left_idx), .Some(lt) => lt, .None => t);
            if(inline_curly_indices.contains(left_idx) && (t.row > left_tok.row), {
              _add1 := multiline_indices.add(left_idx);
              _add2 := multiline_indices.add(i);
            });
          });
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  multiline_indices
});
// ---------------------------------------------------------------------------
// Multiline / paren-removal predicates
// ---------------------------------------------------------------------------
/// True iff `previous` is an Operator AND the paren range
/// `(left_index, right_index)` contains a top-level curly. In that case
/// the operator's RHS must render as a block (multiline). Mirrors
/// `shouldForceOperatorRhsBlock`.
should_force_operator_rhs_block :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, previous : Option(Token)) -> bool
)(
  match(
    previous,
    .None => false,
    .Some(p) => (
      (p.kind == TokenKind.Operator) &&
        has_any_token(tokens, left_index, right_index, TokenKind.LCurlyBracket)
    )
  )
);
/// True iff the paren follows a control-flow identifier (`cond`, `if`,
/// `match`) and contains a top-level curly. Forces the paren range to
/// render multiline. Mirrors `shouldForceControlFlowMultiline`.
should_force_control_flow_multiline :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, previous : Option(Token)) -> bool
)(
  match(
    previous,
    .None => false,
    .Some(p) => cond(
      (p.kind != TokenKind.Identifier) => false,
      true => {
        v := p.value.clone();
        ((v == "cond") || ((v == "if") || (v == "match"))) &&
          has_top_level_token(tokens, left_index, right_index, TokenKind.LCurlyBracket)
        }
    )
  )
);
/// True iff the paren range contains a top-level curly that follows a
/// top-level comma (i.e. a curly-bracketed argument like `f(x, { … })`).
/// Mirrors `hasTopLevelCurlyArgument`.
has_top_level_curly_argument :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool
)({
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  (curly_depth : usize) = usize(0);
  (previous_top_level : Option(Token)) = Option(Token).None;
  (found : bool) = false;
  (i : usize) = (left_index + usize(1));
  while((i < right_index) && (!(found)), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          at_top_level := (((paren_depth == usize(0)) && (bracket_depth == usize(0))) && (curly_depth == usize(0)));
          // Check curly-after-comma BEFORE depth updates
          if((t.kind == TokenKind.LCurlyBracket) && at_top_level, {
            match(
              previous_top_level,
              .None => (),
              .Some(p) => if(p.kind == TokenKind.Comma, {
                found = true;
              })
            );
          });
          // Update depths
          cond(
            (t.kind == TokenKind.LParen) => {
              paren_depth = (paren_depth + usize(1));
            },
            ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
              paren_depth = (paren_depth - usize(1));
            },
            (t.kind == TokenKind.LBracket) => {
              bracket_depth = (bracket_depth + usize(1));
            },
            ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
              bracket_depth = (bracket_depth - usize(1));
            },
            (t.kind == TokenKind.LCurlyBracket) => {
              curly_depth = (curly_depth + usize(1));
            },
            ((t.kind == TokenKind.RCurlyBracket) && (curly_depth > usize(0))) => {
              curly_depth = (curly_depth - usize(1));
            },
            true => ()
          );
          if(at_top_level, {
            previous_top_level = Option(Token).Some(t);
          });
        }
      )
    );
    i = (i + usize(1));
  });
  found
});
/// True iff the paren range contains a top-level `:` operator (a struct-
/// field-style label) followed by a top-level curly. Mirrors
/// `hasTopLevelFieldBlock`.
has_top_level_field_block :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool
)({
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  (curly_depth : usize) = usize(0);
  (saw_top_level_colon : bool) = false;
  (found : bool) = false;
  (i : usize) = (left_index + usize(1));
  while((i < right_index) && (!(found)), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          at_top_level := (((paren_depth == usize(0)) && (bracket_depth == usize(0))) && (curly_depth == usize(0)));
          cond(
            (((t.kind == TokenKind.Operator) && (t.value == ":")) && at_top_level) => {
              saw_top_level_colon = true;
            },
            (((t.kind == TokenKind.LCurlyBracket) && (bracket_depth == usize(0))) && saw_top_level_colon) => {
              found = true;
            },
            true => ()
          );
          cond(
            (t.kind == TokenKind.LParen) => {
              paren_depth = (paren_depth + usize(1));
            },
            ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
              paren_depth = (paren_depth - usize(1));
            },
            (t.kind == TokenKind.LBracket) => {
              bracket_depth = (bracket_depth + usize(1));
            },
            ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
              bracket_depth = (bracket_depth - usize(1));
            },
            (t.kind == TokenKind.LCurlyBracket) => {
              curly_depth = (curly_depth + usize(1));
            },
            ((t.kind == TokenKind.RCurlyBracket) && (curly_depth > usize(0))) => {
              curly_depth = (curly_depth - usize(1));
            },
            true => ()
          );
        }
      )
    );
    i = (i + usize(1));
  });
  found
});
/// True iff the paren range contains a top-level closure (anything that
/// matches `(...) => body` or `(...) -> body` at the paren's top level)
/// followed by a curly. Used to detect `xs.iter(x => { ... })`-style
/// calls so they're rendered inline. Mirrors `hasDirectTopLevelClosureArgument`.
has_direct_top_level_closure_argument :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, previous : Option(Token)) -> bool
)({
  // Control-flow keywords have their own multiline rules — bail out.
  prev_is_control := match(
    previous,
    .None => false,
    .Some(p) => cond(
      (p.kind != TokenKind.Identifier) => false,
      true => {
        v := p.value.clone();
        (v == "cond") || ((v == "if") || ((v == "match") || ((v == "test") || (v == "while"))))
      }
    )
  );
  cond(
    prev_is_control => false,
    true => {
      (paren_depth : usize) = usize(0);
      (bracket_depth : usize) = usize(0);
      (curly_depth : usize) = usize(0);
      (saw_top_level_colon : bool) = false;
      (saw_closure_operator : bool) = false;
      (found : bool) = false;
      (i : usize) = (left_index + usize(1));
      while((i < right_index) && (!(found)), {
        match(
          tokens.get(i),
          .None => (),
          .Some(t) => cond(
            is_comment_token(t.kind) => (),
            true => {
              at_top_level := (((paren_depth == usize(0)) && (bracket_depth == usize(0))) && (curly_depth == usize(0)));
              cond(
                ((t.kind == TokenKind.Operator) && at_top_level) => {
                  v := t.value.clone();
                  cond(
                    (v == ":") => {
                      saw_top_level_colon = true;
                    },
                    ((!(saw_top_level_colon)) && ((v == "=>") || (v == "->"))) => {
                      saw_closure_operator = true;
                    },
                    true => ()
                  );
                },
                (((t.kind == TokenKind.LCurlyBracket) && at_top_level) && saw_closure_operator) => {
                  found = true;
                },
                true => ()
              );
              cond(
                (t.kind == TokenKind.LParen) => {
                  paren_depth = (paren_depth + usize(1));
                },
                ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
                  paren_depth = (paren_depth - usize(1));
                },
                (t.kind == TokenKind.LBracket) => {
                  bracket_depth = (bracket_depth + usize(1));
                },
                ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
                  bracket_depth = (bracket_depth - usize(1));
                },
                (t.kind == TokenKind.LCurlyBracket) => {
                  curly_depth = (curly_depth + usize(1));
                },
                ((t.kind == TokenKind.RCurlyBracket) && (curly_depth > usize(0))) => {
                  curly_depth = (curly_depth - usize(1));
                },
                true => ()
              );
            }
          )
        );
        i = (i + usize(1));
      });
      found
    }
  )
});
/// True iff the paren range is `(.X)` (a parenthesised dot-dereference,
/// e.g. `ptr.*(x)`). Mirrors `isParenthesizedDotDeref`.
is_parenthesized_dot_deref :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool
)({
  previous := previous_meaningful_token(tokens, left_index);
  (inner_token : Option(Token)) = Option(Token).None;
  (inner_count : usize) = usize(0);
  (early_exit : bool) = false;
  (i : usize) = (left_index + usize(1));
  while((i < right_index) && (!(early_exit)), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          inner_token = Option(Token).Some(t);
          inner_count = (inner_count + usize(1));
          if(inner_count > usize(1), {
            early_exit = true;
          });
        }
      )
    );
    i = (i + usize(1));
  });
  cond(
    early_exit => false,
    true => match(
      previous,
      .None => false,
      .Some(prev) => cond(
        (prev.kind != TokenKind.Dot) => false,
        true => match(
          inner_token,
          .None => false,
          .Some(inner) => (
            (inner.kind == TokenKind.Operator) &&
              ((inner.value == "*") && (inner_count == usize(1)))
          )
        )
      )
    )
  )
});
/// True iff the paren range is a redundant grouping paren (e.g.
/// `(x)` around a single sub-expression that doesn't need protection).
/// Mirrors `isRedundantGroupingParen`.
is_redundant_grouping_paren :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool
)(
  cond(
    (right_index == (left_index + usize(1))) => false,
    true => {
      previous := previous_meaningful_token(tokens, left_index);
      next := next_meaningful_token(tokens, right_index, tokens.len());
      first_inner := next_meaningful_token(tokens, left_index, right_index);
      cond(
        match(first_inner, .None => true, .Some(_) => false) => false,
        token_range_has_comment(tokens, left_index + usize(1), right_index) => false,
        paren_is_call_delimiter(previous) => false,
        true => {
          // Operator predecessor + not in the allow-list → cannot remove
          prev_blocks := match(
            previous,
            .None => false,
            .Some(p) => (
              (p.kind == TokenKind.Operator) &&
                (!(operator_allows_ungrouped_rhs(p.value.clone())))
            )
          );
          cond(
            prev_blocks => false,
            true => {
              paren_dot_deref := is_parenthesized_dot_deref(tokens, left_index, right_index);
              // Dot-prefix without being a parenthesised dot-deref blocks removal
              prev_is_dot_blocks := match(
                previous,
                .None => false,
                .Some(p) => ((p.kind == TokenKind.Dot) && (!(paren_dot_deref)))
              );
              cond(
                prev_is_dot_blocks => false,
                true => {
                  // Following operator/dot/lparen blocks removal
                  next_blocks := match(
                    next,
                    .None => false,
                    .Some(nx) => (
                      (
                        ((nx.kind == TokenKind.Operator) && (!(paren_dot_deref))) ||
                          ((nx.kind == TokenKind.Dot) && (!(paren_dot_deref)))
                      ) ||
                        (nx.kind == TokenKind.LParen)
                    )
                  );
                  cond(
                    next_blocks => false,
                    true => {
                      // `fn(` / `unsafe_fn(` is a function-type expression
                      first_inner_blocks := match(
                        first_inner,
                        .None => false,
                        .Some(fi) => (
                          (fi.kind == TokenKind.Identifier) &&
                            is_function_type_keyword(fi.value.clone())
                        )
                      );
                      cond(
                        first_inner_blocks => false,
                        has_top_level_token(tokens, left_index, right_index, TokenKind.Comma) => false,
                        has_top_level_token(tokens, left_index, right_index, TokenKind.Semicolon) => false,
                        true => true
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
);
/// True iff removing the redundant grouping paren at `(left_index,
/// right_index)` would expose the inner operator to a surrounding
/// operator that would then re-parse the meaning incorrectly. Mirrors
/// `parenRemovalWouldExposeOperatorRhsInfix`.
paren_removal_would_expose_operator_rhs_infix :: (
  fn(
    tokens : ArrayList(Token),
    left_index : usize,
    right_index : usize,
    parent_parens : HashMap(usize, usize),
    candidate_left_indices : HashSet(usize)
  ) -> bool
)({
  previous := previous_meaningful_token(tokens, left_index);
  match(
    previous,
    .None => {
      // Walk up the parent chain
      parent_left_opt := parent_parens.get(left_index);
      match(
        parent_left_opt,
        .None => false,
        .Some(parent_left) => cond(
          (!(candidate_left_indices.contains(parent_left))) => false,
          true => match(
            previous_meaningful_token(tokens, parent_left),
            .None => false,
            .Some(pp) => (
              (pp.kind == TokenKind.Operator) &&
                has_top_level_operator(tokens, left_index, right_index)
            )
          )
        )
      )
    },
    .Some(prev) => cond(
      (prev.kind == TokenKind.Operator) => has_top_level_operator(tokens, left_index, right_index),
      true => {
        parent_left_opt := parent_parens.get(left_index);
        match(
          parent_left_opt,
          .None => false,
          .Some(parent_left) => cond(
            (!(candidate_left_indices.contains(parent_left))) => false,
            true => match(
              previous_meaningful_token(tokens, parent_left),
              .None => false,
              .Some(pp) => (
                (pp.kind == TokenKind.Operator) &&
                  has_top_level_operator(tokens, left_index, right_index)
              )
            )
          )
        )
      }
    )
  )
});
/// Compute the set of paren indices that should be elided as redundant
/// grouping parens. Mirrors `findRedundantGroupingParenIndices`.
find_redundant_grouping_paren_indices :: (fn(tokens : ArrayList(Token)) -> HashSet(usize))({
  skipped_indices := HashSet(usize).new();
  matching_parens := find_matching_paren_indices(tokens);
  parent_parens := find_parent_paren_indices(tokens);
  candidate_left_indices := HashSet(usize).new();
  // Pass 1: collect all candidates (those that look redundant in isolation).
  n := tokens.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => if((t.kind == TokenKind.LParen) && matching_parens.contains_key(i), {
        right_idx := match(matching_parens.get(i), .Some(x) => x, .None => i);
        if(is_redundant_grouping_paren(tokens, i, right_idx), {
          _add := candidate_left_indices.add(i);
        });
      })
    );
    i = (i + usize(1));
  });
  // Pass 2: filter out candidates whose removal would change operator parsing.
  // We need to iterate candidate_left_indices — HashSet doesn't have iterate
  // so re-walk tokens.
  (j : usize) = usize(0);
  while(j < n, {
    if(candidate_left_indices.contains(j), {
      right_idx := match(matching_parens.get(j), .Some(x) => x, .None => j);
      keep_candidate := !(
        paren_removal_would_expose_operator_rhs_infix(
          tokens,
          j,
          right_idx,
          parent_parens,
          candidate_left_indices
        )
      );
      if(keep_candidate, {
        _add1 := skipped_indices.add(j);
        _add2 := skipped_indices.add(right_idx);
      });
    });
    j = (j + usize(1));
  });
  skipped_indices
});
/// Compute the set of paren indices that should render on multiple
/// lines. Mirrors `findMultilineParenIndices`.
find_multiline_paren_indices :: (
  fn(tokens : ArrayList(Token), skipped_indices : HashSet(usize)) -> HashSet(usize)
)({
  multiline_indices := HashSet(usize).new();
  matching_parens := find_matching_paren_indices(tokens);
  n := tokens.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => if((t.kind == TokenKind.LParen) && matching_parens.contains_key(i), {
        right_idx := match(matching_parens.get(i), .Some(x) => x, .None => i);
        cond(
          (skipped_indices.contains(i) || skipped_indices.contains(right_idx)) => (),
          true => {
            previous := previous_meaningful_token(tokens, i);
            force_multiline := (
              should_force_control_flow_multiline(tokens, i, right_idx, previous) ||
                (
                  has_top_level_field_block(tokens, i, right_idx) ||
                    should_force_operator_rhs_block(tokens, i, right_idx, previous)
                )
            );
            // Token row check
            left_tok := t;
            right_tok := match(tokens.get(right_idx), .Some(rt) => rt, .None => left_tok);
            spans_rows := (right_tok.row > left_tok.row);
            cond(
              ((!(force_multiline)) && (!(spans_rows))) => (),
              true => {
                first_inner := next_meaningful_token(tokens, i, right_idx);
                first_is_curly := match(
                  first_inner,
                  .None => false,
                  .Some(fi) => (fi.kind == TokenKind.LCurlyBracket)
                );
                skip := (
                  first_is_curly ||
                    (
                      has_top_level_curly_argument(tokens, i, right_idx) ||
                        (
                          paren_is_call_delimiter(previous) &&
                            has_direct_top_level_closure_argument(tokens, i, right_idx, previous)
                        )
                    )
                );
                if(!(skip), {
                  _add1 := multiline_indices.add(i);
                  _add2 := multiline_indices.add(right_idx);
                });
              }
            );
          }
        );
      })
    );
    i = (i + usize(1));
  });
  multiline_indices
});
// ---------------------------------------------------------------------------
// Tightly-bound operator + comment-normalisation helpers
// ---------------------------------------------------------------------------
/// True iff `token` (an Operator like `*`, `!`, `?`) is tightly bound to a
/// following `(` — i.e. should render as a prefix operator without a space
/// before the paren (e.g. `*(T)`, `!(x)`). Mirrors `isTightlyBoundOperator`.
is_tightly_bound_operator :: (
  fn(token : Token, previous : Option(Token), next : Option(Token)) -> bool
)({
  // After a dot, always tight (e.g. ptr.*(x), ptr.&(x))
  prev_is_dot := match(previous, .None => false, .Some(p) => (p.kind == TokenKind.Dot));
  cond(
    prev_is_dot => true,
    true => {
      next_is_lparen := match(next, .None => false, .Some(n) => (n.kind == TokenKind.LParen));
      cond(
        (!(next_is_lparen)) => false,
        true => {
          // Tight only when both:
          //   (1) no whitespace between operator and '('
          //   (2) the previous token is not an rvalue-end
          no_space := match(
            next,
            .None => false,
            .Some(n) => (
              (n.row == token.row) &&
                (n.column == (token.column + token.value.len()))
            )
          );
          cond(
            (!(no_space)) => false,
            true => {
              prev_is_rvalue_end := match(
                previous,
                .None => false,
                .Some(p) => (
                  is_atom_like_token(p.kind) || (
                    (p.kind == TokenKind.RParen) || (
                      (p.kind == TokenKind.RBracket) ||
                        (p.kind == TokenKind.RCurlyBracket)
                    )
                  )
                )
              );
              !(prev_is_rvalue_end)
            }
          )
        }
      )
    }
  )
});
/// Split a block-comment string by newlines and trim trailing whitespace.
/// If indented continuation lines share a common indent, strip it. Mirrors
/// `normalizeMultilineBlockComment`.
normalize_multiline_block_comment :: (fn(raw : String) -> ArrayList(String))({
  // Split raw on '\n', trim each line's trailing horizontal whitespace.
  lines := ArrayList(String).new();
  {
    bytes := raw.as_bytes();
    n := bytes.len();
    (i : usize) = usize(0);
    (line_start : usize) = usize(0);
    while(i < n, {
      b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
      if(b == u8(10), {
        // Emit line: bytes[line_start..i] with trailing whitespace trimmed.
        (end_idx : usize) = i;
        while(end_idx > line_start, {
          eb := match(bytes.get(end_idx - usize(1)), .Some(x) => x, .None => u8(0));
          if((eb == u8(32)) || (eb == u8(9)), {
            end_idx = (end_idx - usize(1));
          }, {
            // break by setting end_idx <= line_start to exit
            line_start = end_idx;
            // Note: this trick mimics break; restore line_start after.
          });
          if((eb == u8(32)) || (eb == u8(9)), (), {
            // Force loop exit on next iteration
            end_idx = line_start;
          });
        });
        // Reset line_start to original (we corrupted it above for break)
        // Reconstruct: scan again to find real trimmed bound.
        (real_end : usize) = i;
        while(real_end > usize(0), {
          eb2 := match(bytes.get(real_end - usize(1)), .Some(x) => x, .None => u8(0));
          if(((eb2 == u8(32)) || (eb2 == u8(9))) && (real_end > usize(0)), {
            real_end = (real_end - usize(1));
          }, {
            real_end = usize(0);
          });
        });
        // Simpler restart: use index search
        ()
      });
      i = (i + usize(1));
    });
    // Always emit final segment after last '\n' (or whole string if no '\n').
    ()
  };
  // Fallback simple impl: split on '\n' and trim each. Avoids the
  // mutate-while-iterate gymnastics above — replace with a straightforward
  // two-pass approach.
  lines = ArrayList(String).new();
  {
    bytes := raw.as_bytes();
    n := bytes.len();
    (i : usize) = usize(0);
    (start : usize) = usize(0);
    while(i <= n, {
      is_end := cond((i == n) => true, true => false);
      is_nl := cond(
        is_end => false,
        true => {
          b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
          b == u8(10)
        }
      );
      if(is_end || is_nl, {
        // Compute trimmed end
        (end_idx : usize) = i;
        (trimming : bool) = true;
        while(trimming && (end_idx > start), {
          eb := match(bytes.get(end_idx - usize(1)), .Some(x) => x, .None => u8(0));
          if((eb == u8(32)) || (eb == u8(9)), {
            end_idx = (end_idx - usize(1));
          }, {
            trimming = false;
          });
        });
        // Slice bytes[start..end_idx] into a String
        (line_str : String) = String.new();
        (k : usize) = start;
        while(k < end_idx, {
          match(
            bytes.get(k),
            .Some(byte_val) => {
              line_str.push_byte(byte_val);
            },
            .None => ()
          );
          k = (k + usize(1));
        });
        _r := lines.push(line_str);
        start = (i + usize(1));
      });
      i = (i + usize(1));
    });
  };
  // Determine common indent among lines[1..]
  (n_lines : usize) = lines.len();
  cond(
    (n_lines <= usize(1)) => lines,
    true => {
      (common_indent : Option(usize)) = Option(usize).None;
      (li : usize) = usize(1);
      while(li < n_lines, {
        match(
          lines.get(li),
          .None => (),
          .Some(line) => {
            // Skip blank lines
            stripped_len := {
              ll_bytes := line.as_bytes();
              ll_n := ll_bytes.len();
              (lk : usize) = usize(0);
              (ll_done : bool) = false;
              while((lk < ll_n) && (!(ll_done)), {
                lb := match(ll_bytes.get(lk), .Some(x) => x, .None => u8(0));
                if((lb == u8(32)) || (lb == u8(9)), {
                  lk = (lk + usize(1));
                }, {
                  ll_done = true;
                });
              });
              cond((lk == ll_n) => usize(0), true => (ll_n - lk))
            };
            if(stripped_len > usize(0), {
              indent := leading_whitespace_length(line.clone());
              common_indent = match(
                common_indent,
                .None => Option(usize).Some(indent),
                .Some(ci) => cond(
                  (indent < ci) => Option(usize).Some(indent),
                  true => Option(usize).Some(ci)
                )
              );
            });
          }
        );
        li = (li + usize(1));
      });
      match(
        common_indent,
        .None => lines,
        .Some(ci) => cond(
          (ci == usize(0)) => lines,
          true => {
            // Build new list: keep lines[0], strip ci from lines[1..]
            out := ArrayList(String).new();
            match(
              lines.get(usize(0)),
              .Some(first) => {
                _r := out.push(first);
              },
              .None => ()
            );
            (oi : usize) = usize(1);
            while(oi < n_lines, {
              match(
                lines.get(oi),
                .None => (),
                .Some(line) => {
                  ll_bytes := line.as_bytes();
                  ll_n := ll_bytes.len();
                  // If line is blank → ""
                  (lk : usize) = usize(0);
                  (only_ws : bool) = true;
                  while((lk < ll_n) && only_ws, {
                    lb := match(ll_bytes.get(lk), .Some(x) => x, .None => u8(0));
                    if((lb == u8(32)) || (lb == u8(9)), {
                      lk = (lk + usize(1));
                    }, {
                      only_ws = false;
                    });
                  });
                  if(only_ws, {
                    _r := out.push(String.from(""));
                  }, {
                    // Drop the first `ci` bytes
                    new_line := String.new();
                    (sk : usize) = ci;
                    while(sk < ll_n, {
                      match(
                        ll_bytes.get(sk),
                        .Some(byte_val) => {
                          new_line.push_byte(byte_val);
                        },
                        .None => ()
                      );
                      sk = (sk + usize(1));
                    });
                    _r := out.push(new_line);
                  });
                }
              );
              oi = (oi + usize(1));
            });
            out
          }
        )
      )
    }
  )
});
/// Read a backtick template-string starting at byte offset `start` in `input`,
/// returning the literal slice from `` ` `` to the matching closing `` ` ``.
/// Mirrors `readRawTemplateString`.
/// Convert a CHARACTER index into a BYTE offset within `bytes`.
///
/// `Token.character` is a CHARACTER index — the lexer walks `input.chars()` and
/// stores that loop's counter (`lexer.yo:82` `char_idx := i`). Everything here
/// slices `input.as_bytes()`. On ASCII input the two coincide exactly, which is
/// why the mismatch survived every test: the whole test corpus is ASCII.
///
/// With ANY multi-byte character earlier in the file the character index is
/// SMALLER than the byte offset, so the slice started early and swallowed the
/// source preceding the backtick — `input.contains(\`&\`)` was rewritten to
/// `input.contains(s(\`))`, which does not parse, with `fmt` still exiting 0.
/// Em dashes in doc comments made this fire across std: 23 of 40 sampled files
/// with a backtick came out non-parseable.
/// See issues/fixed/yo-self-formatter-corrupts-files-with-non-ascii.md.
///
/// Counts UTF-8 LEAD bytes: a continuation byte matches `0b10xxxxxx`, i.e.
/// `(b & 0xC0) == 0x80`, and never starts a character.
_byte_offset_of_char_index :: (fn(bytes : ArrayList(u8), char_index : usize) -> usize)({
  n := bytes.len();
  (bi : usize) = usize(0);
  (ci : usize) = usize(0);
  while((ci < char_index) && (bi < n), {
    bi = (bi + usize(1));
    while((bi < n) && ((match(bytes.get(bi), .Some(x) => x, .None => u8(0)) & u8(0xC0)) == u8(0x80)), {
      bi = (bi + usize(1));
    });
    ci = (ci + usize(1));
  });
  bi
});
/// `start` is a CHARACTER index (a `Token.character`); it is converted to a byte
/// offset before any slicing — see `_byte_offset_of_char_index`.
read_raw_template_string :: (fn(input : String, start_char : usize) -> String)({
  bytes := input.as_bytes();
  n := bytes.len();
  start := _byte_offset_of_char_index(bytes, start_char);
  (index : usize) = (start + usize(1));
  (brace_depth : usize) = usize(0);
  (end_index : usize) = n; // default: until EOF
  (done : bool) = false;
  while((index < n) && (!(done)), {
    char_byte := match(bytes.get(index), .Some(x) => x, .None => u8(0));
    cond(
      (char_byte == u8(92)) => {
        // backslash: skip next byte
        index = (index + usize(2));
      },
      ((brace_depth == usize(0)) && (char_byte == u8(96))) => {
        // closing backtick
        end_index = (index + usize(1));
        done = true;
      },
      ((brace_depth == usize(0)) && (char_byte == u8(36))) => {
        // '$' check if followed by '{'
        next_byte := match(bytes.get(index + usize(1)), .Some(x) => x, .None => u8(0));
        cond(
          (next_byte == u8(123)) => {
            brace_depth = usize(1);
            index = (index + usize(2));
          },
          true => {
            index = (index + usize(1));
          }
        );
      },
      (brace_depth > usize(0)) => {
        cond(
          (char_byte == u8(123)) => {
            brace_depth = (brace_depth + usize(1));
          },
          (char_byte == u8(125)) => {
            brace_depth = (brace_depth - usize(1));
          },
          true => ()
        );
        index = (index + usize(1));
      },
      true => {
        index = (index + usize(1));
      }
    );
  });
  // Slice bytes[start..end_index]
  result := String.new();
  (k : usize) = start;
  while(k < end_index, {
    match(
      bytes.get(k),
      .Some(byte_val) => {
        result.push_byte(byte_val);
      },
      .None => ()
    );
    k = (k + usize(1));
  });
  result
});
/// Return the raw source text for token `tokens[index]`. For template strings
/// this re-reads from `input` (the lexer normalises template-string `value`s).
/// Mirrors `rawTokenValue`.
raw_token_value :: (fn(input : String, tokens : ArrayList(Token), index : usize) -> String)(
  match(
    tokens.get(index),
    .None => String.new(),
    .Some(t) => cond(
      (t.kind == TokenKind.TemplateString) => read_raw_template_string(input, t.character),
      true => t.value
    )
  )
);
// ---------------------------------------------------------------------------
// Public entry — `format_yo_source`
// ---------------------------------------------------------------------------
/// Format the given Yo source text and return the rewritten output.
///
/// 1-to-1 port of `formatYoSource` in `src/formatter.ts`. Throws via the
/// implicit `Exception` handler on lexer/parser errors.
///
/// Algorithm summary:
///   1. Tokenise the input.
///   2. Filter out whitespace tokens.
///   3. Pre-compute several sets/maps over token indices that determine the
///      layout decisions:
///        * inline-curly indices (curly bodies without top-level `;`)
///        * skipped paren indices (redundant grouping parens to elide)
///        * multiline paren / bracket / inline-curly indices
///   4. Walk the tokens in order, emitting C-formatted output via the mutable
///      `result` string. Stacks track `(LParen/LBracket/LCurlyBracket)`
///      framing decisions for the matching close brackets.
format_yo_source :: (
  fn(
    input : String,
    module_path : String,
    exn : Exception
  ) -> String
)(
  cond(
    (input.len() == usize(0)) => String.from(""),
    true => {
      all_tokens := tokenize(input, module_path, exn);
      // Filter out whitespace tokens.
      significant_tokens := ArrayList(Token).new();
      {
        nt := all_tokens.len();
        (ti : usize) = usize(0);
        while(ti < nt, {
          match(
            all_tokens.get(ti),
            .Some(t) => if(t.kind != TokenKind.Whitespace, {
              _r := significant_tokens.push(t);
            }),
            .None => ()
          );
          ti = (ti + usize(1));
        });
      };
      // Pre-compute index sets / maps used by the layout decisions.
      inline_curly_indices := find_inline_curly_indices(significant_tokens);
      skipped_paren_indices := find_redundant_grouping_paren_indices(significant_tokens);
      multiline_paren_indices := find_multiline_paren_indices(significant_tokens, skipped_paren_indices);
      multiline_bracket_indices := find_multiline_bracket_indices(significant_tokens);
      multiline_inline_curly_indices := find_multiline_inline_curly_indices(significant_tokens, inline_curly_indices);
      // Pre-compute raw token values.
      raw_values := ArrayList(String).new();
      {
        rn := significant_tokens.len();
        (ri : usize) = usize(0);
        while(ri < rn, {
          _r := raw_values.push(raw_token_value(input, significant_tokens, ri));
          ri = (ri + usize(1));
        });
      };
      // Mutable state captured by the main loop.
      (result : String) = String.new();
      (indent_level : usize) = usize(0);
      (paren_depth : usize) = usize(0);
      (bracket_depth : usize) = usize(0);
      (curly_depth : usize) = usize(0);
      (inline_curly_depth : usize) = usize(0);
      (at_line_start : bool) = true;
      (previous_token : Option(Token)) = Option(Token).None;
      // Stacks (parallel ArrayLists since Yo struct ArrayLists are awkward).
      paren_stack_indices := ArrayList(usize).new();
      paren_stack_multiline := ArrayList(bool).new();
      bracket_stack_multiline := ArrayList(bool).new();
      curly_stack_inline := ArrayList(bool).new();
      curly_stack_multiline := ArrayList(bool).new();
      continuation_paren := ArrayList(usize).new();
      continuation_bracket := ArrayList(usize).new();
      continuation_curly := ArrayList(usize).new();
      // ---------------------------------------------------------------
      // Main loop.
      // ---------------------------------------------------------------
      n_tokens := significant_tokens.len();
      (index : usize) = usize(0);
      while(index < n_tokens, {
        cond(
          skipped_paren_indices.contains(index) => {
            index = (index + usize(1));
          },
          true => {
            token := match(
              significant_tokens.get(index),
              .Some(t) => t,
              .None => {
                index = (index + usize(1));
                continue;
              }
            );
            previous := previous_token;
            next := next_token(significant_tokens, skipped_paren_indices, index);
            raw := match(raw_values.get(index), .Some(s) => s, .None => String.new());
            // ---- Comment handling ----
            cond(
              is_comment_token(token.kind) => {
                // Insert newline if comment is on a later row.
                prev_row_check := match(
                  previous,
                  .None => false,
                  .Some(p) => ((token.row > p.row) && (!(at_line_start)))
                );
                if(prev_row_check, {
                  // Trim trailing whitespace + add newline.
                  // Trim by walking back; if result already ends in '\n', skip.
                  if(!(result.ends_with(String.from("\n"))), {
                    result.push_str("\n");
                  });
                  at_line_start = true;
                });
                cond(
                  is_line_comment_token(token.kind) => {
                    if(!(at_line_start), {
                      if((!(result.ends_with(String.from(" ")))) && (!(result.ends_with(String.from("\n")))), {
                        result.push_str(" ");
                      });
                    });
                    // Write indent if needed
                    if(at_line_start, {
                      (sp : usize) = usize(0);
                      space_count := (indent_level * INDENT_SIZE);
                      while(sp < space_count, {
                        result.push_str(" ");
                        sp = (sp + usize(1));
                      });
                      at_line_start = false;
                    });
                    // raw.trimEnd() — strip trailing whitespace from raw
                    trimmed := {
                      rb := raw.as_bytes();
                      (re : usize) = rb.len();
                      (trim : bool) = true;
                      while(trim && (re > usize(0)), {
                        eb := match(rb.get(re - usize(1)), .Some(x) => x, .None => u8(0));
                        if((eb == u8(32)) || ((eb == u8(9)) || ((eb == u8(13)) || (eb == u8(10)))), {
                          re = (re - usize(1));
                        }, {
                          trim = false;
                        });
                      });
                      tr := String.new();
                      (tk : usize) = usize(0);
                      while(tk < re, {
                        match(
                          rb.get(tk),
                          .Some(b) => {
                            tr.push_byte(b);
                          },
                          .None => ()
                        );
                        tk = (tk + usize(1));
                      });
                      tr
                    };
                    result.push_string(trimmed);
                    if(!(result.ends_with(String.from("\n"))), {
                      result.push_str("\n");
                    });
                    at_line_start = true;
                  },
                  true => {
                    // Block comment handling
                    has_nl := raw.contains(String.from("\n"));
                    cond(
                      has_nl => {
                        if(!(at_line_start), {
                          if(!(result.ends_with(String.from("\n"))), {
                            result.push_str("\n");
                          });
                          at_line_start = true;
                        });
                        comment_lines := normalize_multiline_block_comment(raw);
                        (cli : usize) = usize(0);
                        cn := comment_lines.len();
                        while(cli < cn, {
                          match(
                            comment_lines.get(cli),
                            .Some(line) => {
                              if(at_line_start, {
                                (sp2 : usize) = usize(0);
                                space_count2 := (indent_level * INDENT_SIZE);
                                while(sp2 < space_count2, {
                                  result.push_str(" ");
                                  sp2 = (sp2 + usize(1));
                                });
                                at_line_start = false;
                              });
                              result.push_string(line);
                              if(!(result.ends_with(String.from("\n"))), {
                                result.push_str("\n");
                              });
                              at_line_start = true;
                            },
                            .None => ()
                          );
                          cli = (cli + usize(1));
                        });
                      },
                      true => {
                        if(!(at_line_start), {
                          if((!(result.ends_with(String.from(" ")))) && (!(result.ends_with(String.from("\n")))), {
                            result.push_str(" ");
                          });
                        });
                        if(at_line_start, {
                          (sp3 : usize) = usize(0);
                          space_count3 := (indent_level * INDENT_SIZE);
                          while(sp3 < space_count3, {
                            result.push_str(" ");
                            sp3 = (sp3 + usize(1));
                          });
                          at_line_start = false;
                        });
                        result.push_string(raw);
                        // Only add trailing space if the next token is on the
                        // same row (otherwise the upcoming newline would just
                        // trim it).
                        next_on_same_row := match(
                          next,
                          .None => false,
                          .Some(nx) => (nx.row == token.row)
                        );
                        if(next_on_same_row && (((!(at_line_start)) && (!(result.ends_with(String.from(" "))))) && (!(result.ends_with(String.from("\n"))))), {
                          result.push_str(" ");
                        });
                      }
                    );
                  }
                );
                previous_token = Option(Token).Some(token);
                index = (index + usize(1));
              },
              true => {
                // ---- TokenKind dispatch ----
                cond(
                  (token.kind == TokenKind.LCurlyBracket) => {
                    cond(
                      inline_curly_indices.contains(index) => {
                        is_multiline := multiline_inline_curly_indices.contains(index);
                        _r1 := curly_stack_inline.push(true);
                        _r2 := curly_stack_multiline.push(is_multiline);
                        curly_depth = (curly_depth + usize(1));
                        inline_curly_depth = (inline_curly_depth + usize(1));
                        cond(
                          is_multiline => {
                            // write("{")
                            if(at_line_start, {
                              (sp : usize) = usize(0);
                              count := (indent_level * INDENT_SIZE);
                              while(sp < count, {
                                result.push_str(" ");
                                sp = (sp + usize(1));
                              });
                              at_line_start = false;
                            });
                            result.push_str("{");
                            indent_level = (indent_level + usize(1));
                            next_is_rcurly := match(next, .None => false, .Some(nx) => (nx.kind == TokenKind.RCurlyBracket));
                            if((!(next_is_rcurly)) && match(next, .None => false, .Some(_) => true), {
                              if(!(result.ends_with(String.from("\n"))), {
                                result.push_str("\n");
                              });
                              at_line_start = true;
                            });
                          },
                          true => {
                            if(at_line_start, {
                              (sp : usize) = usize(0);
                              count := (indent_level * INDENT_SIZE);
                              while(sp < count, {
                                result.push_str(" ");
                                sp = (sp + usize(1));
                              });
                              at_line_start = false;
                            });
                            result.push_str("{");
                            next_is_rcurly := match(next, .None => false, .Some(nx) => (nx.kind == TokenKind.RCurlyBracket));
                            if(((!(next_is_rcurly)) && match(next, .None => false, .Some(_) => true)) && ((!(at_line_start)) && (!(result.ends_with(String.from(" "))))), {
                              result.push_str(" ");
                            });
                          }
                        );
                      },
                      true => {
                        _r1 := curly_stack_inline.push(false);
                        _r2 := curly_stack_multiline.push(false);
                        if(at_line_start, {
                          (sp : usize) = usize(0);
                          count := (indent_level * INDENT_SIZE);
                          while(sp < count, {
                            result.push_str(" ");
                            sp = (sp + usize(1));
                          });
                          at_line_start = false;
                        });
                        result.push_str("{");
                        curly_depth = (curly_depth + usize(1));
                        indent_level = (indent_level + usize(1));
                        if(!(result.ends_with(String.from("\n"))), {
                          result.push_str("\n");
                        });
                        at_line_start = true;
                      }
                    );
                  },
                  (token.kind == TokenKind.RCurlyBracket) => {
                    // Pop frame
                    cur_inline := cond(
                      (curly_stack_inline.len() > usize(0)) => match(curly_stack_inline.get(curly_stack_inline.len() - usize(1)), .Some(x) => x, .None => false),
                      true => false
                    );
                    cur_multiline := cond(
                      (curly_stack_multiline.len() > usize(0)) => match(curly_stack_multiline.get(curly_stack_multiline.len() - usize(1)), .Some(x) => x, .None => false),
                      true => false
                    );
                    if(curly_stack_inline.len() > usize(0), {
                      _p1 := curly_stack_inline.pop();
                      _p2 := curly_stack_multiline.pop();
                    });
                    cond(
                      cur_inline => {
                        if(inline_curly_depth > usize(0), {
                          inline_curly_depth = (inline_curly_depth - usize(1));
                        });
                        cond(
                          cur_multiline => {
                            if(!(at_line_start), {
                              if(!(result.ends_with(String.from("\n"))), {
                                result.push_str("\n");
                              });
                              at_line_start = true;
                            });
                            if(indent_level > usize(0), {
                              indent_level = (indent_level - usize(1));
                            });
                            if(at_line_start, {
                              (sp : usize) = usize(0);
                              count := (indent_level * INDENT_SIZE);
                              while(sp < count, {
                                result.push_str(" ");
                                sp = (sp + usize(1));
                              });
                              at_line_start = false;
                            });
                            result.push_str("}");
                          },
                          true => {
                            prev_is_lcurly := match(previous, .None => false, .Some(p) => (p.kind == TokenKind.LCurlyBracket));
                            if((!(at_line_start)) && (!(prev_is_lcurly)), {
                              if((!(result.ends_with(String.from(" ")))) && (!(result.ends_with(String.from("\n")))), {
                                result.push_str(" ");
                              });
                            });
                            if(at_line_start, {
                              (sp : usize) = usize(0);
                              count := (indent_level * INDENT_SIZE);
                              while(sp < count, {
                                result.push_str(" ");
                                sp = (sp + usize(1));
                              });
                              at_line_start = false;
                            });
                            result.push_str("}");
                          }
                        );
                      },
                      true => {
                        if(!(at_line_start), {
                          if(!(result.ends_with(String.from("\n"))), {
                            result.push_str("\n");
                          });
                          at_line_start = true;
                        });
                        if(indent_level > usize(0), {
                          indent_level = (indent_level - usize(1));
                        });
                        if(at_line_start, {
                          (sp : usize) = usize(0);
                          count := (indent_level * INDENT_SIZE);
                          while(sp < count, {
                            result.push_str(" ");
                            sp = (sp + usize(1));
                          });
                          at_line_start = false;
                        });
                        result.push_str("}");
                      }
                    );
                    if(curly_depth > usize(0), {
                      curly_depth = (curly_depth - usize(1));
                    });
                  },
                  (token.kind == TokenKind.LParen) => {
                    is_multiline := multiline_paren_indices.contains(index);
                    if(at_line_start, {
                      (sp : usize) = usize(0);
                      count := (indent_level * INDENT_SIZE);
                      while(sp < count, {
                        result.push_str(" ");
                        sp = (sp + usize(1));
                      });
                      at_line_start = false;
                    });
                    result.push_str("(");
                    _r1 := paren_stack_indices.push(index);
                    _r2 := paren_stack_multiline.push(is_multiline);
                    paren_depth = (paren_depth + usize(1));
                    if(is_multiline, {
                      indent_level = (indent_level + usize(1));
                      next_is_rparen := match(next, .None => false, .Some(nx) => (nx.kind == TokenKind.RParen));
                      if((!(next_is_rparen)) && match(next, .None => false, .Some(_) => true), {
                        if(!(result.ends_with(String.from("\n"))), {
                          result.push_str("\n");
                        });
                        at_line_start = true;
                      });
                    });
                  },
                  (token.kind == TokenKind.LBracket) => {
                    is_multiline := multiline_bracket_indices.contains(index);
                    _r := bracket_stack_multiline.push(is_multiline);
                    bracket_depth = (bracket_depth + usize(1));
                    if(at_line_start, {
                      (sp : usize) = usize(0);
                      count := (indent_level * INDENT_SIZE);
                      while(sp < count, {
                        result.push_str(" ");
                        sp = (sp + usize(1));
                      });
                      at_line_start = false;
                    });
                    result.push_str("[");
                    if(is_multiline, {
                      indent_level = (indent_level + usize(1));
                      next_is_rbracket := match(next, .None => false, .Some(nx) => (nx.kind == TokenKind.RBracket));
                      if((!(next_is_rbracket)) && match(next, .None => false, .Some(_) => true), {
                        if(!(result.ends_with(String.from("\n"))), {
                          result.push_str("\n");
                        });
                        at_line_start = true;
                      });
                    });
                  },
                  (token.kind == TokenKind.RParen) => {
                    // close_operator_continuations
                    (closing_done : bool) = false;
                    while((continuation_paren.len() > usize(0)) && (!(closing_done)), {
                      top_idx := (continuation_paren.len() - usize(1));
                      top_p := match(continuation_paren.get(top_idx), .Some(x) => x, .None => usize(0));
                      top_b := match(continuation_bracket.get(top_idx), .Some(x) => x, .None => usize(0));
                      top_c := match(continuation_curly.get(top_idx), .Some(x) => x, .None => usize(0));
                      cond(
                        ((paren_depth > top_p) || ((bracket_depth > top_b) || (curly_depth > top_c))) => {
                          closing_done = true;
                        },
                        true => {
                          _p1 := continuation_paren.pop();
                          _p2 := continuation_bracket.pop();
                          _p3 := continuation_curly.pop();
                          if(indent_level > usize(0), {
                            indent_level = (indent_level - usize(1));
                          });
                        }
                      );
                    });
                    is_multiline := cond(
                      (paren_stack_multiline.len() > usize(0)) => match(paren_stack_multiline.get(paren_stack_multiline.len() - usize(1)), .Some(x) => x, .None => false),
                      true => false
                    );
                    if(paren_stack_multiline.len() > usize(0), {
                      _p1 := paren_stack_indices.pop();
                      _p2 := paren_stack_multiline.pop();
                    });
                    cond(
                      is_multiline => {
                        if(!(at_line_start), {
                          if(!(result.ends_with(String.from("\n"))), {
                            result.push_str("\n");
                          });
                          at_line_start = true;
                        });
                        if(indent_level > usize(0), {
                          indent_level = (indent_level - usize(1));
                        });
                        if(at_line_start, {
                          (sp : usize) = usize(0);
                          count := (indent_level * INDENT_SIZE);
                          while(sp < count, {
                            result.push_str(" ");
                            sp = (sp + usize(1));
                          });
                          at_line_start = false;
                        });
                        result.push_str(")");
                      },
                      true => {
                        result = _trim_trailing_h_ws(result);
                        result.push_str(")");
                      }
                    );
                    if(paren_depth > usize(0), {
                      paren_depth = (paren_depth - usize(1));
                    });
                  },
                  (token.kind == TokenKind.RBracket) => {
                    // close_operator_continuations
                    (closing_done2 : bool) = false;
                    while((continuation_paren.len() > usize(0)) && (!(closing_done2)), {
                      top_idx := (continuation_paren.len() - usize(1));
                      top_p := match(continuation_paren.get(top_idx), .Some(x) => x, .None => usize(0));
                      top_b := match(continuation_bracket.get(top_idx), .Some(x) => x, .None => usize(0));
                      top_c := match(continuation_curly.get(top_idx), .Some(x) => x, .None => usize(0));
                      cond(
                        ((paren_depth > top_p) || ((bracket_depth > top_b) || (curly_depth > top_c))) => {
                          closing_done2 = true;
                        },
                        true => {
                          _p1 := continuation_paren.pop();
                          _p2 := continuation_bracket.pop();
                          _p3 := continuation_curly.pop();
                          if(indent_level > usize(0), {
                            indent_level = (indent_level - usize(1));
                          });
                        }
                      );
                    });
                    is_multiline_b := cond(
                      (bracket_stack_multiline.len() > usize(0)) => match(bracket_stack_multiline.get(bracket_stack_multiline.len() - usize(1)), .Some(x) => x, .None => false),
                      true => false
                    );
                    if(bracket_stack_multiline.len() > usize(0), {
                      _p := bracket_stack_multiline.pop();
                    });
                    if(bracket_depth > usize(0), {
                      bracket_depth = (bracket_depth - usize(1));
                    });
                    cond(
                      is_multiline_b => {
                        if(!(at_line_start), {
                          if(!(result.ends_with(String.from("\n"))), {
                            result.push_str("\n");
                          });
                          at_line_start = true;
                        });
                        if(indent_level > usize(0), {
                          indent_level = (indent_level - usize(1));
                        });
                        if(at_line_start, {
                          (sp : usize) = usize(0);
                          count := (indent_level * INDENT_SIZE);
                          while(sp < count, {
                            result.push_str(" ");
                            sp = (sp + usize(1));
                          });
                          at_line_start = false;
                        });
                        result.push_str("]");
                      },
                      true => {
                        result = _trim_trailing_h_ws(result);
                        result.push_str("]");
                      }
                    );
                  },
                  (token.kind == TokenKind.Comma) => {
                    // close_operator_continuations
                    (closing_done3 : bool) = false;
                    while((continuation_paren.len() > usize(0)) && (!(closing_done3)), {
                      top_idx := (continuation_paren.len() - usize(1));
                      top_p := match(continuation_paren.get(top_idx), .Some(x) => x, .None => usize(0));
                      top_b := match(continuation_bracket.get(top_idx), .Some(x) => x, .None => usize(0));
                      top_c := match(continuation_curly.get(top_idx), .Some(x) => x, .None => usize(0));
                      cond(
                        ((paren_depth > top_p) || ((bracket_depth > top_b) || (curly_depth > top_c))) => {
                          closing_done3 = true;
                        },
                        true => {
                          _p1 := continuation_paren.pop();
                          _p2 := continuation_bracket.pop();
                          _p3 := continuation_curly.pop();
                          if(indent_level > usize(0), {
                            indent_level = (indent_level - usize(1));
                          });
                        }
                      );
                    });
                    result = _trim_trailing_h_ws(result);
                    result.push_str(",");
                    next_is_closer := match(
                      next,
                      .None => false,
                      .Some(nx) => (
                        ((nx.kind == TokenKind.RParen) || (nx.kind == TokenKind.RBracket)) || (nx.kind == TokenKind.RCurlyBracket)
                      )
                    );
                    if((!(next_is_closer)) && match(next, .None => false, .Some(_) => true), {
                      cur_bracket_ml := cond(
                        (bracket_stack_multiline.len() > usize(0)) => match(bracket_stack_multiline.get(bracket_stack_multiline.len() - usize(1)), .Some(x) => x, .None => false),
                        true => false
                      );
                      cur_curly_inline := cond(
                        (curly_stack_inline.len() > usize(0)) => match(curly_stack_inline.get(curly_stack_inline.len() - usize(1)), .Some(x) => x, .None => false),
                        true => false
                      );
                      cur_curly_ml := cond(
                        (curly_stack_multiline.len() > usize(0)) => match(curly_stack_multiline.get(curly_stack_multiline.len() - usize(1)), .Some(x) => x, .None => false),
                        true => false
                      );
                      cur_paren_ml := cond(
                        (paren_stack_multiline.len() > usize(0)) => match(paren_stack_multiline.get(paren_stack_multiline.len() - usize(1)), .Some(x) => x, .None => false),
                        true => false
                      );
                      cond(
                        cur_bracket_ml => {
                          if(!(result.ends_with(String.from("\n"))), {
                            result.push_str("\n");
                          });
                          at_line_start = true;
                        },
                        (cur_curly_inline && cur_curly_ml) => {
                          if(!(result.ends_with(String.from("\n"))), {
                            result.push_str("\n");
                          });
                          at_line_start = true;
                        },
                        ((bracket_stack_multiline.len() > usize(0)) || (cur_curly_inline && (!(cur_curly_ml)))) => {
                          if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                            result.push_str(" ");
                          });
                        },
                        cur_paren_ml => {
                          if(!(result.ends_with(String.from("\n"))), {
                            result.push_str("\n");
                          });
                          at_line_start = true;
                        },
                        true => {
                          if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                            result.push_str(" ");
                          });
                        }
                      );
                    });
                  },
                  (token.kind == TokenKind.Semicolon) => {
                    next_is_not_rbracket := match(next, .None => false, .Some(nx) => (nx.kind != TokenKind.RBracket));
                    next_is_not_comment := match(next, .None => true, .Some(nx) => (!(is_comment_token(nx.kind))));
                    cond(
                      ((bracket_depth > usize(0)) && (next_is_not_rbracket && next_is_not_comment)) => {
                        if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                          result.push_str(" ");
                        });
                        result.push_str(";");
                        result.push_str(" ");
                      },
                      true => {
                        // close_operator_continuations
                        (closing_done4 : bool) = false;
                        while((continuation_paren.len() > usize(0)) && (!(closing_done4)), {
                          top_idx := (continuation_paren.len() - usize(1));
                          top_p := match(continuation_paren.get(top_idx), .Some(x) => x, .None => usize(0));
                          top_b := match(continuation_bracket.get(top_idx), .Some(x) => x, .None => usize(0));
                          top_c := match(continuation_curly.get(top_idx), .Some(x) => x, .None => usize(0));
                          cond(
                            ((paren_depth > top_p) || ((bracket_depth > top_b) || (curly_depth > top_c))) => {
                              closing_done4 = true;
                            },
                            true => {
                              _p1 := continuation_paren.pop();
                              _p2 := continuation_bracket.pop();
                              _p3 := continuation_curly.pop();
                              if(indent_level > usize(0), {
                                indent_level = (indent_level - usize(1));
                              });
                            }
                          );
                        });
                        result = _trim_trailing_h_ws(result);
                        result.push_str(";");
                        emit_newline := match(
                          next,
                          .None => false,
                          .Some(nx) => ((!(is_comment_token(nx.kind))) || (nx.row > token.row))
                        );
                        if(emit_newline, {
                          if(!(result.ends_with(String.from("\n"))), {
                            result.push_str("\n");
                          });
                          at_line_start = true;
                          // Preserve at most one blank line between statements
                          next_row_diff := match(next, .None => usize(0), .Some(nx) => cond((nx.row > token.row) => (nx.row - token.row), true => usize(0)));
                          if(next_row_diff >= usize(2), {
                            result.push_str("\n");
                          });
                        });
                      }
                    );
                  },
                  (token.kind == TokenKind.Dot) => {
                    // Mirrors formatter.ts:381-385 — `trimTrailingHorizontalWhitespace(); write(".")`.
                    // TS routes EVERY emit through `write()`, which calls
                    // `writeIndentIfNeeded()` first; yo-self inlines that helper at each
                    // site and this one was missed, so a line-leading dot was pushed
                    // BEFORE the pending indent and left `at_line_start` set. The next
                    // token then wrote the indent after it, formatting every match arm as
                    // `.    Some(v) =>` instead of `    .Some(v) =>`.
                    //
                    // The trim is for MEMBER ACCESS only — a dot WITH a left operand
                    // binds tight to it (`str. len()` → `str.len()`). A PREFIX dot
                    // (`.Some`) has no left operand: it follows a comma or an operator
                    // whose handler just established a space, and trimming ate it,
                    // emitting `,.Some` / `=.Some` / `=>.Err` / `:.Some`. Both
                    // formatters carried this bug identically (measured: given either
                    // spelling as input, both normalized to tight), so both change
                    // together. `needs_space_before_atom` is exactly the "has a left
                    // operand" predicate — false after a comma, an operator, or `(`,
                    // so `(.Some` stays tight while `, .Some` keeps its space.
                    // See plans/PREFIX_OPERATOR_OPERAND_RULE.md.
                    if(needs_space_before_atom(previous), {
                      result = _trim_trailing_h_ws(result);
                    });
                    if(at_line_start, {
                      (sp : usize) = usize(0);
                      count := (indent_level * INDENT_SIZE);
                      while(sp < count, {
                        result.push_str(" ");
                        sp = (sp + usize(1));
                      });
                      at_line_start = false;
                    });
                    result.push_str(".");
                  },
                  (token.kind == TokenKind.Operator) => {
                    // Operator-handling cascade matches TS lines 386-426
                    is_colon_in_inline_curly := ((token.value == ":") && (inline_curly_depth > usize(0)));
                    cond(
                      is_colon_in_inline_curly => {
                        if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                          result.push_str(" ");
                        });
                        result.push_str(":");
                        next_on_next_row := match(next, .None => false, .Some(nx) => (nx.row > token.row));
                        cond(
                          next_on_next_row => {
                            // start_operator_continuation
                            if(!(result.ends_with(String.from("\n"))), {
                              result.push_str("\n");
                            });
                            at_line_start = true;
                            indent_level = (indent_level + usize(1));
                            _r1 := continuation_paren.push(paren_depth);
                            _r2 := continuation_bracket.push(bracket_depth);
                            _r3 := continuation_curly.push(curly_depth);
                          },
                          true => {
                            if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                              result.push_str(" ");
                            });
                          }
                        );
                      },
                      is_tightly_bound_operator(token, previous, next) => {
                        cond(
                          prefix_operator_needs_leading_space(token, previous) => {
                            if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                              result.push_str(" ");
                            });
                          },
                          true => {
                            result = _trim_trailing_h_ws(result);
                          }
                        );
                        if(at_line_start, {
                          (sp : usize) = usize(0);
                          count := (indent_level * INDENT_SIZE);
                          while(sp < count, {
                            result.push_str(" ");
                            sp = (sp + usize(1));
                          });
                          at_line_start = false;
                        });
                        result.push_string(token.value);
                      },
                      true => {
                        prev_is_open_bracket := match(
                          previous,
                          .None => false,
                          .Some(p) => (
                            (p.kind == TokenKind.LParen) ||
                              ((p.kind == TokenKind.LBracket) || (p.kind == TokenKind.LCurlyBracket))
                          )
                        );
                        if(!(prev_is_open_bracket), {
                          prev_on_earlier_row := match(previous, .None => false, .Some(p) => (token.row > p.row));
                          cond(
                            prev_on_earlier_row => {
                              if(!(result.ends_with(String.from("\n"))), {
                                result.push_str("\n");
                              });
                              at_line_start = true;
                            },
                            true => {
                              if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                                result.push_str(" ");
                              });
                            }
                          );
                        });
                        if(at_line_start, {
                          (sp : usize) = usize(0);
                          count := (indent_level * INDENT_SIZE);
                          while(sp < count, {
                            result.push_str(" ");
                            sp = (sp + usize(1));
                          });
                          at_line_start = false;
                        });
                        result.push_string(token.value);
                        next_on_next_row2 := match(next, .None => false, .Some(nx) => (nx.row > token.row));
                        cond(
                          next_on_next_row2 => {
                            // start_operator_continuation
                            if(!(result.ends_with(String.from("\n"))), {
                              result.push_str("\n");
                            });
                            at_line_start = true;
                            indent_level = (indent_level + usize(1));
                            _r1 := continuation_paren.push(paren_depth);
                            _r2 := continuation_bracket.push(bracket_depth);
                            _r3 := continuation_curly.push(curly_depth);
                          },
                          true => {
                            if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                              result.push_str(" ");
                            });
                          }
                        );
                      }
                    );
                  },
                  is_atom_like_token(token.kind) => {
                    if(needs_space_before_atom(previous), {
                      if((!(at_line_start)) && (!(result.ends_with(String.from(" ")))), {
                        result.push_str(" ");
                      });
                    });
                    if(at_line_start, {
                      (sp : usize) = usize(0);
                      count := (indent_level * INDENT_SIZE);
                      while(sp < count, {
                        result.push_str(" ");
                        sp = (sp + usize(1));
                      });
                      at_line_start = false;
                    });
                    result.push_string(raw);
                  },
                  true => () // Whitespace already filtered; unreachable
                );
                previous_token = Option(Token).Some(token);
                index = (index + usize(1));
              }
            );
          }
        );
      });
      // Final newline.
      if((result.len() > usize(0)) && (!(result.ends_with(String.from("\n")))), {
        result.push_str("\n");
      });
      result
    }
  )
);
// ---------------------------------------------------------------------------
// Directory walking + batch formatting
// ---------------------------------------------------------------------------
/// Recursively collect every `*.yo` file under `target_path` into `files`.
/// Skips directories named in `is_ignored_format_dir`. Mirrors `collectYoFiles`.
collect_yo_files :: (
  fn(
    target_path : Path,
    files : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  is_file_p := io.await(is_file(target_path, io), io);
  cond(
    is_file_p => {
      path_str := target_path.to_string();
      if(path_str.ends_with(String.from(".yo")), {
        _r := files.push(path_str);
      });
    },
    true => {
      is_dir_p := io.await(is_dir(target_path, io), io);
      if(is_dir_p, {
        entries := io.await(read_dir(target_path, io), IoExn(io : io, exn : exn));
        en := entries.len();
        (ei : usize) = usize(0);
        while(ei < en, {
          match(
            entries.get(ei),
            .None => (),
            .Some(entry) => {
              entry_name := entry.name;
              skip := match(
                entry.file_type,
                .Directory => is_ignored_format_dir(entry_name.clone()),
                _ => false
              );
              if(!(skip), {
                child_path := target_path.join(Path.new(entry_name.clone()));
                recur(child_path, files, io, exn);
              });
            }
          );
          ei = (ei + usize(1));
        });
      });
    }
  );
});
/// Resolve `input_paths` to a list of `.yo` file paths. If `input_paths` is
/// empty, defaults to ["."]. Throws via `exn` if any input path does not
/// exist. Mirrors `findYoFormatFiles`.
find_yo_format_files :: (
  fn(
    input_paths : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> ArrayList(String)
)({
  files := ArrayList(String).new();
  paths_to_format := cond(
    (input_paths.len() == usize(0)) => {
      defaults := ArrayList(String).new();
      _r := defaults.push(String.from("."));
      defaults
    },
    true => input_paths
  );
  pn := paths_to_format.len();
  (pi : usize) = usize(0);
  while(pi < pn, {
    match(
      paths_to_format.get(pi),
      .None => (),
      .Some(p) => {
        path_obj := Path.new(p);
        path_exists := io.await(exists(path_obj, io), io);
        if(!(path_exists), {
          exn.throw(dyn(`Path does not exist: ${p}`));
        });
        collect_yo_files(path_obj, files, io, exn);
      }
    );
    pi = (pi + usize(1));
  });
  files
});
/// Format every `.yo` file found under `input_paths`. Returns the list of
/// files visited and the subset whose content would change. In `check` mode
/// no file is written. Mirrors `formatYoFiles`.
format_yo_files :: (
  fn(
    input_paths : ArrayList(String),
    options : FormatYoFilesOptions,
    io : Io,
    exn : Exception
  ) -> FormatYoFilesResult
)({
  files := find_yo_format_files(input_paths, io, exn);
  changed := ArrayList(String).new();
  fn := files.len();
  (fi : usize) = usize(0);
  while(fi < fn, {
    match(
      files.get(fi),
      .None => (),
      .Some(file) => {
        bytes := io.await(read_file(Path.new(file), io), IoExn(io : io, exn : exn));
        original := String.from_bytes(bytes);
        formatted := format_yo_source(original, file, exn);
        if(formatted != original, {
          _r := changed.push(file);
          if(!(options.check), {
            io.await(write_file(Path.new(file), formatted, io), IoExn(io : io, exn : exn));
          });
        });
      }
    );
    fi = (fi + usize(1));
  });
  FormatYoFilesResult(files : files, changed : changed)
});
export(
  INDENT_SIZE,
  is_comment_token,
  is_line_comment_token,
  is_atom_like_token,
  is_ignored_format_dir,
  FormatYoFilesOptions,
  FormatYoFilesResult,
  paren_is_call_delimiter,
  operator_allows_ungrouped_rhs,
  is_function_type_keyword,
  needs_space_before_atom,
  prefix_operator_needs_leading_space,
  leading_whitespace_length,
  previous_meaningful_token,
  next_meaningful_token,
  token_range_has_comment,
  has_any_token,
  has_top_level_token,
  has_top_level_operator,
  next_token,
  find_matching_paren_indices,
  find_parent_paren_indices,
  find_inline_curly_indices,
  find_multiline_bracket_indices,
  find_multiline_inline_curly_indices,
  should_force_operator_rhs_block,
  should_force_control_flow_multiline,
  has_top_level_curly_argument,
  has_top_level_field_block,
  has_direct_top_level_closure_argument,
  is_parenthesized_dot_deref,
  is_redundant_grouping_paren,
  paren_removal_would_expose_operator_rhs_infix,
  find_redundant_grouping_paren_indices,
  find_multiline_paren_indices,
  is_tightly_bound_operator,
  normalize_multiline_block_comment,
  read_raw_template_string,
  raw_token_value,
  format_yo_source,
  collect_yo_files,
  find_yo_format_files,
  format_yo_files
);
