//! Source formatter for Yo — 1-to-1 port of `src/formatter.ts`.
//!
//! Entry points:
//!   * `format_yo_source(input, module_path) -> String` — pure formatter.
//!   * `find_yo_format_files(target_path) -> ArrayList(String)` — directory walker.
//!   * `format_yo_files(target_path, options) -> FormatYoFilesResult` — apply to
//!     all matching files (with optional `--check` mode).
//!
//! Status (Phase A.10): foundations + small helpers. The main
//! `format_yo_source` pipeline is stubbed (returns the input unchanged) and
//! will be filled in by successive commits.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ HashMap } :: import("std/collections/hash_map");
{ Token, TokenKind } :: import("./token.yo");
// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
/// Number of spaces per indentation level. Mirrors `INDENT_SIZE` in
/// `src/formatter.ts`.
INDENT_SIZE :: usize(2);
// ---------------------------------------------------------------------------
// Token-kind classifiers
// ---------------------------------------------------------------------------
// In TypeScript these are `Set<TokenType>` constants tested with `.has(...)`.
// In yo-self the variant kinds are an enum, so a simple predicate is more
// idiomatic than a HashSet of enum values.
/// True iff `kind` is any comment token (single-line, block, doc-line,
/// inner-doc-line, doc-block, inner-doc-block). Mirrors `COMMENT_TOKEN_TYPES`.
is_comment_token :: (fn(kind : TokenKind) -> bool)(
  cond(
    (kind == TokenKind.SingleLineComment) => true,
    (kind == TokenKind.MultiLineComment) => true,
    (kind == TokenKind.DocLineComment) => true,
    (kind == TokenKind.InnerDocLineComment) => true,
    (kind == TokenKind.DocBlockComment) => true,
    (kind == TokenKind.InnerDocBlockComment) => true,
    true => false
  )
);
/// True iff `kind` is a single-line comment variant. Mirrors
/// `LINE_COMMENT_TOKEN_TYPES`.
is_line_comment_token :: (fn(kind : TokenKind) -> bool)(
  cond(
    (kind == TokenKind.SingleLineComment) => true,
    (kind == TokenKind.DocLineComment) => true,
    (kind == TokenKind.InnerDocLineComment) => true,
    true => false
  )
);
/// True iff `kind` is an atom-like token (Identifier / Integer / Float /
/// Bool / StringLit / CharLit / TemplateString). Mirrors `ATOM_LIKE_TOKEN_TYPES`.
is_atom_like_token :: (fn(kind : TokenKind) -> bool)(
  cond(
    (kind == TokenKind.Identifier) => true,
    (kind == TokenKind.Integer) => true,
    (kind == TokenKind.Float) => true,
    (kind == TokenKind.Bool) => true,
    (kind == TokenKind.StringLit) => true,
    (kind == TokenKind.CharLit) => true,
    (kind == TokenKind.TemplateString) => true,
    true => false
  )
);
/// True iff `name` is a directory the formatter should skip when walking
/// `format_yo_files`. Mirrors `IGNORED_FORMAT_DIRS`.
is_ignored_format_dir :: (fn(name : str) -> bool)(
  cond(
    (name == ".git") => true,
    (name == ".yo-cache") => true,
    (name == "node_modules") => true,
    (name == "out") => true,
    (name == "yo-out") => true,
    true => false
  )
);
// ---------------------------------------------------------------------------
// Public option / result records
// ---------------------------------------------------------------------------
/// Options passed to `format_yo_files`. Mirrors `FormatYoFilesOptions` in
/// `src/formatter.ts`. `check` = true switches to dry-run mode (no writes,
/// `changed` lists files that WOULD be rewritten). `cwd` is the directory
/// from which relative paths are resolved.
FormatYoFilesOptions :: struct(
  check : bool,
  cwd : String
);
/// Result of `format_yo_files`. `files` is every file visited, `changed` is
/// the subset that was rewritten (or would be in `check` mode). Mirrors
/// `FormatYoFilesResult` in `src/formatter.ts`.
FormatYoFilesResult :: struct(
  files : ArrayList(String),
  changed : ArrayList(String)
);
// ---------------------------------------------------------------------------
// Small helpers (mostly from src/formatter.ts lines 1093-1334)
// ---------------------------------------------------------------------------
/// True iff `previous` (the token immediately before `(`) makes the paren a
/// call delimiter — i.e. the paren follows an rvalue-end. Mirrors
/// `parenIsCallDelimiter`.
paren_is_call_delimiter :: (fn(previous : Option(Token)) -> bool)(
  match(
    previous,
    .None => false,
    .Some(p) => (
      is_atom_like_token(p.kind) || (
        (p.kind == TokenKind.RParen) || (
          (p.kind == TokenKind.RBracket) || (p.kind == TokenKind.RCurlyBracket)
        )
      )
    )
  )
);
/// True iff `operator` is one of `:=`, `::`, `=`, `:`, `=>`, `->` — operators
/// whose right-hand side does not require parenthesisation. Mirrors
/// `operatorAllowsUngroupedRhs`.
operator_allows_ungrouped_rhs :: (fn(op : str) -> bool)(
  cond(
    (op == ":=") => true,
    (op == "::") => true,
    (op == "=") => true,
    (op == ":") => true,
    (op == "=>") => true,
    (op == "->") => true,
    true => false
  )
);
/// True iff `value` is one of the function-type keywords (`fn` or
/// `unsafe_fn`). Mirrors `isFunctionTypeKeyword`.
is_function_type_keyword :: (fn(value : str) -> bool)(
  cond(
    (value == "fn") => true,
    (value == "unsafe_fn") => true,
    true => false
  )
);
/// True iff inserting an atom right after `previous` requires a leading
/// space (so the tokens don't run together). Mirrors `needsSpaceBeforeAtom`.
needs_space_before_atom :: (fn(previous : Option(Token)) -> bool)(
  match(
    previous,
    .None => false,
    .Some(p) => (
      is_atom_like_token(p.kind) || (
        (p.kind == TokenKind.RParen) || (
          (p.kind == TokenKind.RBracket) || (p.kind == TokenKind.RCurlyBracket)
        )
      )
    )
  )
);
/// True iff `token` (a prefix operator like `!`, `-`, `&`, `~`) needs a
/// leading space to separate from `previous`. Specifically:
///   * After a comma — yes.
///   * After another operator (except `.`) — yes, otherwise the lexer would
///     merge them into one token (e.g. `||!` or `+!`).
///   * Exception: `...` followed by `#` does not need a space.
///
/// Mirrors `prefixOperatorNeedsLeadingSpace`.
prefix_operator_needs_leading_space :: (fn(token : Token, previous : Option(Token)) -> bool)(
  match(
    previous,
    .None => false,
    .Some(p) => cond(
      (((p.kind == TokenKind.Operator) && (p.value.as_str() == "...")) && (token.value.as_str() == "#")) => false,
      (p.kind == TokenKind.Comma) => true,
      ((p.kind == TokenKind.Operator) && (p.value.as_str() != ".")) => true,
      true => false
    )
  )
);
/// Count the leading `[ \t]*` characters of `line`. Mirrors
/// `leadingWhitespaceLength`.
leading_whitespace_length :: (fn(line : str) -> usize)({
  n := line.len();
  (i : usize) = usize(0);
  (done : bool) = false;
  while(runtime((i < n) && (!(done))), {
    b := line.bytes(i);
    cond(
      (b == u8(32)) => {
        i = (i + usize(1));
      },
      (b == u8(9)) => {
        i = (i + usize(1));
      },
      true => {
        done = true;
      }
    );
  });
  i
});
// ---------------------------------------------------------------------------
// Token-iteration helpers
// ---------------------------------------------------------------------------
/// Walk past comment tokens (anything matching `is_comment_token`) before
/// `index`, returning the nearest non-comment predecessor. Mirrors
/// `previousMeaningfulToken`.
previous_meaningful_token :: (fn(tokens : ArrayList(Token), index : usize) -> Option(Token))({
  if(index == usize(0), {
    return(Option(Token).None);
  });
  (i : usize) = (index - usize(1));
  (result : Option(Token)) = Option(Token).None;
  (done : bool) = false;
  while(runtime(!(done)), {
    match(
      tokens.get(i),
      .None => {
        done = true;
      },
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          result = Option(Token).Some(t);
          done = true;
        }
      )
    );
    if((!(done)) && (i == usize(0)), {
      done = true;
    }, {
      if(!(done), {
        i = (i - usize(1));
      });
    });
  });
  result
});
/// Walk past comment tokens (anything matching `is_comment_token`) after
/// `index`, returning the nearest non-comment successor within
/// `[index+1, end_exclusive)`. Mirrors `nextMeaningfulToken`.
next_meaningful_token :: (fn(tokens : ArrayList(Token), index : usize, end_exclusive : usize) -> Option(Token))({
  (i : usize) = (index + usize(1));
  (result : Option(Token)) = Option(Token).None;
  (done : bool) = false;
  while(runtime((i < end_exclusive) && (!(done))), {
    match(
      tokens.get(i),
      .None => {
        done = true;
      },
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          result = Option(Token).Some(t);
          done = true;
        }
      )
    );
    i = (i + usize(1));
  });
  result
});
/// True iff any token in `[start_inclusive, end_exclusive)` is a comment.
/// Mirrors `tokenRangeHasComment`.
token_range_has_comment :: (fn(tokens : ArrayList(Token), start_inclusive : usize, end_exclusive : usize) -> bool)({
  (i : usize) = start_inclusive;
  (found : bool) = false;
  while(runtime((i < end_exclusive) && (!(found))), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => if(is_comment_token(t.kind), {
        found = true;
      })
    );
    i = (i + usize(1));
  });
  found
});
/// True iff any token in `(left_index, right_index)` (exclusive both ends)
/// has the given kind. No bracket nesting awareness. Mirrors `hasAnyToken`.
has_any_token :: (fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, kind : TokenKind) -> bool)({
  (i : usize) = (left_index + usize(1));
  (found : bool) = false;
  while(runtime((i < right_index) && (!(found))), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => if(t.kind == kind, {
        found = true;
      })
    );
    i = (i + usize(1));
  });
  found
});
/// True iff there is a top-level (no nesting) token of `kind` in
/// `(left_index, right_index)`. Skips comments and tracks paren / bracket /
/// curly depth so e.g. a comma inside an inner paren doesn't count.
/// Mirrors `hasTopLevelToken`.
has_top_level_token :: (fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, kind : TokenKind) -> bool)({
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  (curly_depth : usize) = usize(0);
  (i : usize) = (left_index + usize(1));
  (found : bool) = false;
  while(runtime((i < right_index) && (!(found))), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        ((t.kind == kind) && (((paren_depth == usize(0)) && (bracket_depth == usize(0))) && (curly_depth == usize(0)))) => {
          found = true;
        },
        (t.kind == TokenKind.LParen) => {
          paren_depth = (paren_depth + usize(1));
        },
        ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
          paren_depth = (paren_depth - usize(1));
        },
        (t.kind == TokenKind.LBracket) => {
          bracket_depth = (bracket_depth + usize(1));
        },
        ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
          bracket_depth = (bracket_depth - usize(1));
        },
        (t.kind == TokenKind.LCurlyBracket) => {
          curly_depth = (curly_depth + usize(1));
        },
        ((t.kind == TokenKind.RCurlyBracket) && (curly_depth > usize(0))) => {
          curly_depth = (curly_depth - usize(1));
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  found
});
/// True iff any top-level (no nesting) token in `(left_index, right_index)`
/// is an Operator. Skips comments. Mirrors `hasTopLevelOperator`.
has_top_level_operator :: (fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool)(
  has_top_level_token(tokens, left_index, right_index, TokenKind.Operator)
);
// ---------------------------------------------------------------------------
// Set/Map computation helpers
// ---------------------------------------------------------------------------
/// Walk past tokens whose index is in `skipped_indices`, returning the
/// nearest non-skipped successor. Mirrors `nextToken`.
next_token :: (fn(tokens : ArrayList(Token), skipped_indices : HashSet(usize), index : usize) -> Option(Token))({
  n := tokens.len();
  (next_index : usize) = (index + usize(1));
  (result : Option(Token)) = Option(Token).None;
  (done : bool) = false;
  while(runtime((next_index < n) && (!(done))), {
    cond(
      skipped_indices.contains(next_index) => (),
      true => {
        result = tokens.get(next_index);
        done = true;
      }
    );
    next_index = (next_index + usize(1));
  });
  result
});
/// Build a map of each `LParen` index → its matching `RParen` index.
/// Mirrors `findMatchingParenIndices`.
find_matching_paren_indices :: (fn(tokens : ArrayList(Token)) -> HashMap(usize, usize))({
  pairs := HashMap(usize, usize).new();
  stack := ArrayList(usize).new();
  n := tokens.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LParen) => {
          _r := stack.push(i);
        },
        (t.kind == TokenKind.RParen) => {
          if(stack.len() > usize(0), {
            left := match(stack.get(stack.len() - usize(1)),.Some(x) => x,.None => usize(0));
            _r := stack.pop();
            _r2 := pairs.set(left, i);
          });
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  pairs
});
/// Build a map of each inner `LParen` index → its parent `LParen` index.
/// Top-level parens are absent. Mirrors `findParentParenIndices`.
find_parent_paren_indices :: (fn(tokens : ArrayList(Token)) -> HashMap(usize, usize))({
  parents := HashMap(usize, usize).new();
  stack := ArrayList(usize).new();
  n := tokens.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LParen) => {
          if(stack.len() > usize(0), {
            parent := match(stack.get(stack.len() - usize(1)),.Some(x) => x,.None => usize(0));
            _r := parents.set(i, parent);
          });
          _r2 := stack.push(i);
        },
        (t.kind == TokenKind.RParen) => {
          if(stack.len() > usize(0), {
            _r := stack.pop();
          });
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  parents
});
/// Compute the set of `LCurlyBracket` and matching `RCurlyBracket` indices
/// that should render on a single line (no top-level semicolons inside).
/// Mirrors `findInlineCurlyIndices`. Stack frames track per-frame
/// `paren_depth` / `bracket_depth` so semicolons inside nested calls don't
/// trigger multiline mode for the enclosing curly.
find_inline_curly_indices :: (fn(tokens : ArrayList(Token)) -> HashSet(usize))({
  inline_indices := HashSet(usize).new();
  stack_indices := ArrayList(usize).new();
  stack_paren_depths := ArrayList(usize).new();
  stack_bracket_depths := ArrayList(usize).new();
  stack_has_top_level_semi := ArrayList(bool).new();
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  n := tokens.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LCurlyBracket) => {
          _r1 := stack_indices.push(i);
          _r2 := stack_paren_depths.push(paren_depth);
          _r3 := stack_bracket_depths.push(bracket_depth);
          _r4 := stack_has_top_level_semi.push(false);
        },
        (t.kind == TokenKind.Semicolon) => {
          if(stack_indices.len() > usize(0), {
            top := (stack_indices.len() - usize(1));
            frame_paren := match(stack_paren_depths.get(top),.Some(x) => x,.None => usize(0));
            frame_bracket := match(stack_bracket_depths.get(top),.Some(x) => x,.None => usize(0));
            if((frame_paren == paren_depth) && (frame_bracket == bracket_depth), {
              // pop+push to update top-of-stack (ArrayList has no set-at-index)
              _p := stack_has_top_level_semi.pop();
              _r := stack_has_top_level_semi.push(true);
            });
          });
        },
        (t.kind == TokenKind.RCurlyBracket) => {
          if(stack_indices.len() > usize(0), {
            top := (stack_indices.len() - usize(1));
            left_idx := match(stack_indices.get(top),.Some(x) => x,.None => usize(0));
            has_semi := match(stack_has_top_level_semi.get(top),.Some(x) => x,.None => false);
            _p1 := stack_indices.pop();
            _p2 := stack_paren_depths.pop();
            _p3 := stack_bracket_depths.pop();
            _p4 := stack_has_top_level_semi.pop();
            if(!(has_semi), {
              _add1 := inline_indices.add(left_idx);
              _add2 := inline_indices.add(i);
            });
          });
        },
        (t.kind == TokenKind.LParen) => {
          paren_depth = (paren_depth + usize(1));
        },
        ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
          paren_depth = (paren_depth - usize(1));
        },
        (t.kind == TokenKind.LBracket) => {
          bracket_depth = (bracket_depth + usize(1));
        },
        ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
          bracket_depth = (bracket_depth - usize(1));
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  inline_indices
});
/// Compute indices of `LBracket` / `RBracket` pairs that span multiple
/// source rows. Mirrors `findMultilineBracketIndices`.
find_multiline_bracket_indices :: (fn(tokens : ArrayList(Token)) -> HashSet(usize))({
  multiline_indices := HashSet(usize).new();
  stack := ArrayList(usize).new();
  n := tokens.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LBracket) => {
          _r := stack.push(i);
        },
        (t.kind == TokenKind.RBracket) => {
          if(stack.len() > usize(0), {
            left_idx := match(stack.get(stack.len() - usize(1)),.Some(x) => x,.None => usize(0));
            _p := stack.pop();
            left_tok := match(tokens.get(left_idx),.Some(lt) => lt, .None => t);
            if(t.row > left_tok.row, {
              _add1 := multiline_indices.add(left_idx);
              _add2 := multiline_indices.add(i);
            });
          });
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  multiline_indices
});
/// Compute indices of `LCurlyBracket` / `RCurlyBracket` pairs that are
/// marked inline-eligible (by `find_inline_curly_indices`) but actually
/// span multiple rows in the source. Mirrors `findMultilineInlineCurlyIndices`.
find_multiline_inline_curly_indices :: (fn(tokens : ArrayList(Token), inline_curly_indices : HashSet(usize)) -> HashSet(usize))({
  multiline_indices := HashSet(usize).new();
  stack := ArrayList(usize).new();
  n := tokens.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        (t.kind == TokenKind.LCurlyBracket) => {
          _r := stack.push(i);
        },
        (t.kind == TokenKind.RCurlyBracket) => {
          if(stack.len() > usize(0), {
            left_idx := match(stack.get(stack.len() - usize(1)),.Some(x) => x,.None => usize(0));
            _p := stack.pop();
            left_tok := match(tokens.get(left_idx),.Some(lt) => lt, .None => t);
            if(inline_curly_indices.contains(left_idx) && (t.row > left_tok.row), {
              _add1 := multiline_indices.add(left_idx);
              _add2 := multiline_indices.add(i);
            });
          });
        },
        true => ()
      )
    );
    i = (i + usize(1));
  });
  multiline_indices
});
// ---------------------------------------------------------------------------
// Multiline / paren-removal predicates
// ---------------------------------------------------------------------------
/// True iff `previous` is an Operator AND the paren range
/// `(left_index, right_index)` contains a top-level curly. In that case
/// the operator's RHS must render as a block (multiline). Mirrors
/// `shouldForceOperatorRhsBlock`.
should_force_operator_rhs_block :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, previous : Option(Token)) -> bool
)(
  match(
    previous,
    .None => false,
    .Some(p) => (
      (p.kind == TokenKind.Operator) &&
      has_any_token(tokens, left_index, right_index, TokenKind.LCurlyBracket)
    )
  )
);
/// True iff the paren follows a control-flow identifier (`cond`, `if`,
/// `match`) and contains a top-level curly. Forces the paren range to
/// render multiline. Mirrors `shouldForceControlFlowMultiline`.
should_force_control_flow_multiline :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, previous : Option(Token)) -> bool
)(
  match(
    previous,
    .None => false,
    .Some(p) => cond(
      (p.kind != TokenKind.Identifier) => false,
      true => {
        v := p.value.as_str();
        ((v == "cond") || ((v == "if") || (v == "match"))) &&
        has_top_level_token(tokens, left_index, right_index, TokenKind.LCurlyBracket)
      }
    )
  )
);
/// True iff the paren range contains a top-level curly that follows a
/// top-level comma (i.e. a curly-bracketed argument like `f(x, { … })`).
/// Mirrors `hasTopLevelCurlyArgument`.
has_top_level_curly_argument :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool
)({
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  (curly_depth : usize) = usize(0);
  (previous_top_level : Option(Token)) = Option(Token).None;
  (found : bool) = false;
  (i : usize) = (left_index + usize(1));
  while(runtime((i < right_index) && (!(found))), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          at_top_level := (((paren_depth == usize(0)) && (bracket_depth == usize(0))) && (curly_depth == usize(0)));
          // Check curly-after-comma BEFORE depth updates
          if((t.kind == TokenKind.LCurlyBracket) && at_top_level, {
            match(
              previous_top_level,
              .None => (),
              .Some(p) => if(p.kind == TokenKind.Comma, {
                found = true;
              })
            );
          });
          // Update depths
          cond(
            (t.kind == TokenKind.LParen) => {
              paren_depth = (paren_depth + usize(1));
            },
            ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
              paren_depth = (paren_depth - usize(1));
            },
            (t.kind == TokenKind.LBracket) => {
              bracket_depth = (bracket_depth + usize(1));
            },
            ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
              bracket_depth = (bracket_depth - usize(1));
            },
            (t.kind == TokenKind.LCurlyBracket) => {
              curly_depth = (curly_depth + usize(1));
            },
            ((t.kind == TokenKind.RCurlyBracket) && (curly_depth > usize(0))) => {
              curly_depth = (curly_depth - usize(1));
            },
            true => ()
          );
          if(at_top_level, {
            previous_top_level = Option(Token).Some(t);
          });
        }
      )
    );
    i = (i + usize(1));
  });
  found
});
/// True iff the paren range contains a top-level `:` operator (a struct-
/// field-style label) followed by a top-level curly. Mirrors
/// `hasTopLevelFieldBlock`.
has_top_level_field_block :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool
)({
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  (curly_depth : usize) = usize(0);
  (saw_top_level_colon : bool) = false;
  (found : bool) = false;
  (i : usize) = (left_index + usize(1));
  while(runtime((i < right_index) && (!(found))), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          at_top_level := (((paren_depth == usize(0)) && (bracket_depth == usize(0))) && (curly_depth == usize(0)));
          cond(
            (((t.kind == TokenKind.Operator) && (t.value.as_str() == ":")) && at_top_level) => {
              saw_top_level_colon = true;
            },
            (((t.kind == TokenKind.LCurlyBracket) && (bracket_depth == usize(0))) && saw_top_level_colon) => {
              found = true;
            },
            true => ()
          );
          cond(
            (t.kind == TokenKind.LParen) => {
              paren_depth = (paren_depth + usize(1));
            },
            ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
              paren_depth = (paren_depth - usize(1));
            },
            (t.kind == TokenKind.LBracket) => {
              bracket_depth = (bracket_depth + usize(1));
            },
            ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
              bracket_depth = (bracket_depth - usize(1));
            },
            (t.kind == TokenKind.LCurlyBracket) => {
              curly_depth = (curly_depth + usize(1));
            },
            ((t.kind == TokenKind.RCurlyBracket) && (curly_depth > usize(0))) => {
              curly_depth = (curly_depth - usize(1));
            },
            true => ()
          );
        }
      )
    );
    i = (i + usize(1));
  });
  found
});
/// True iff the paren range contains a top-level closure (anything that
/// matches `(...) => body` or `(...) -> body` at the paren's top level)
/// followed by a curly. Used to detect `xs.iter(x => { ... })`-style
/// calls so they're rendered inline. Mirrors `hasDirectTopLevelClosureArgument`.
has_direct_top_level_closure_argument :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize, previous : Option(Token)) -> bool
)({
  // Control-flow keywords have their own multiline rules — bail out.
  prev_is_control := match(
    previous,
    .None => false,
    .Some(p) => cond(
      (p.kind != TokenKind.Identifier) => false,
      true => {
        v := p.value.as_str();
        (v == "cond") || ((v == "if") || ((v == "match") || ((v == "test") || (v == "while"))))
      }
    )
  );
  cond(
    prev_is_control => false,
    true => {
      (paren_depth : usize) = usize(0);
      (bracket_depth : usize) = usize(0);
      (curly_depth : usize) = usize(0);
      (saw_top_level_colon : bool) = false;
      (saw_closure_operator : bool) = false;
      (found : bool) = false;
      (i : usize) = (left_index + usize(1));
      while(runtime((i < right_index) && (!(found))), {
        match(
          tokens.get(i),
          .None => (),
          .Some(t) => cond(
            is_comment_token(t.kind) => (),
            true => {
              at_top_level := (((paren_depth == usize(0)) && (bracket_depth == usize(0))) && (curly_depth == usize(0)));
              cond(
                ((t.kind == TokenKind.Operator) && at_top_level) => {
                  v := t.value.as_str();
                  cond(
                    (v == ":") => {
                      saw_top_level_colon = true;
                    },
                    ((!(saw_top_level_colon)) && ((v == "=>") || (v == "->"))) => {
                      saw_closure_operator = true;
                    },
                    true => ()
                  );
                },
                (((t.kind == TokenKind.LCurlyBracket) && at_top_level) && saw_closure_operator) => {
                  found = true;
                },
                true => ()
              );
              cond(
                (t.kind == TokenKind.LParen) => {
                  paren_depth = (paren_depth + usize(1));
                },
                ((t.kind == TokenKind.RParen) && (paren_depth > usize(0))) => {
                  paren_depth = (paren_depth - usize(1));
                },
                (t.kind == TokenKind.LBracket) => {
                  bracket_depth = (bracket_depth + usize(1));
                },
                ((t.kind == TokenKind.RBracket) && (bracket_depth > usize(0))) => {
                  bracket_depth = (bracket_depth - usize(1));
                },
                (t.kind == TokenKind.LCurlyBracket) => {
                  curly_depth = (curly_depth + usize(1));
                },
                ((t.kind == TokenKind.RCurlyBracket) && (curly_depth > usize(0))) => {
                  curly_depth = (curly_depth - usize(1));
                },
                true => ()
              );
            }
          )
        );
        i = (i + usize(1));
      });
      found
    }
  )
});
/// True iff the paren range is `(.X)` (a parenthesised dot-dereference,
/// e.g. `ptr.*(x)`). Mirrors `isParenthesizedDotDeref`.
is_parenthesized_dot_deref :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool
)({
  previous := previous_meaningful_token(tokens, left_index);
  (inner_token : Option(Token)) = Option(Token).None;
  (inner_count : usize) = usize(0);
  (early_exit : bool) = false;
  (i : usize) = (left_index + usize(1));
  while(runtime((i < right_index) && (!(early_exit))), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => cond(
        is_comment_token(t.kind) => (),
        true => {
          inner_token = Option(Token).Some(t);
          inner_count = (inner_count + usize(1));
          if(inner_count > usize(1), {
            early_exit = true;
          });
        }
      )
    );
    i = (i + usize(1));
  });
  cond(
    early_exit => false,
    true => match(
      previous,
      .None => false,
      .Some(prev) => cond(
        (prev.kind != TokenKind.Dot) => false,
        true => match(
          inner_token,
          .None => false,
          .Some(inner) => (
            (inner.kind == TokenKind.Operator) &&
            ((inner.value.as_str() == "*") && (inner_count == usize(1)))
          )
        )
      )
    )
  )
});
/// True iff the paren range is a redundant grouping paren (e.g.
/// `(x)` around a single sub-expression that doesn't need protection).
/// Mirrors `isRedundantGroupingParen`.
is_redundant_grouping_paren :: (
  fn(tokens : ArrayList(Token), left_index : usize, right_index : usize) -> bool
)(
  cond(
    (right_index == (left_index + usize(1))) => false,
    true => {
      previous := previous_meaningful_token(tokens, left_index);
      next := next_meaningful_token(tokens, right_index, tokens.len());
      first_inner := next_meaningful_token(tokens, left_index, right_index);
      cond(
        match(first_inner,.None => true,.Some(_) => false) => false,
        token_range_has_comment(tokens, (left_index + usize(1)), right_index) => false,
        paren_is_call_delimiter(previous) => false,
        true => {
          // Operator predecessor + not in the allow-list → cannot remove
          prev_blocks := match(
            previous,
            .None => false,
            .Some(p) => (
              (p.kind == TokenKind.Operator) &&
              (!(operator_allows_ungrouped_rhs(p.value.as_str())))
            )
          );
          cond(
            prev_blocks => false,
            true => {
              paren_dot_deref := is_parenthesized_dot_deref(tokens, left_index, right_index);
              // Dot-prefix without being a parenthesised dot-deref blocks removal
              prev_is_dot_blocks := match(
                previous,
                .None => false,
                .Some(p) => ((p.kind == TokenKind.Dot) && (!(paren_dot_deref)))
              );
              cond(
                prev_is_dot_blocks => false,
                true => {
                  // Following operator/dot/lparen blocks removal
                  next_blocks := match(
                    next,
                    .None => false,
                    .Some(nx) => (
                      (((nx.kind == TokenKind.Operator) && (!(paren_dot_deref))) ||
                        ((nx.kind == TokenKind.Dot) && (!(paren_dot_deref)))) ||
                      (nx.kind == TokenKind.LParen)
                    )
                  );
                  cond(
                    next_blocks => false,
                    true => {
                      // `fn(` / `unsafe_fn(` is a function-type expression
                      first_inner_blocks := match(
                        first_inner,
                        .None => false,
                        .Some(fi) => (
                          (fi.kind == TokenKind.Identifier) &&
                          is_function_type_keyword(fi.value.as_str())
                        )
                      );
                      cond(
                        first_inner_blocks => false,
                        has_top_level_token(tokens, left_index, right_index, TokenKind.Comma) => false,
                        has_top_level_token(tokens, left_index, right_index, TokenKind.Semicolon) => false,
                        true => true
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
);
/// True iff removing the redundant grouping paren at `(left_index,
/// right_index)` would expose the inner operator to a surrounding
/// operator that would then re-parse the meaning incorrectly. Mirrors
/// `parenRemovalWouldExposeOperatorRhsInfix`.
paren_removal_would_expose_operator_rhs_infix :: (
  fn(
    tokens : ArrayList(Token),
    left_index : usize,
    right_index : usize,
    parent_parens : HashMap(usize, usize),
    candidate_left_indices : HashSet(usize)
  ) -> bool
)({
  previous := previous_meaningful_token(tokens, left_index);
  match(
    previous,
    .None => {
      // Walk up the parent chain
      parent_left_opt := parent_parens.get(left_index);
      match(
        parent_left_opt,
        .None => false,
        .Some(parent_left) => cond(
          (!(candidate_left_indices.contains(parent_left))) => false,
          true => match(
            previous_meaningful_token(tokens, parent_left),
            .None => false,
            .Some(pp) => (
              (pp.kind == TokenKind.Operator) &&
              has_top_level_operator(tokens, left_index, right_index)
            )
          )
        )
      )
    },
    .Some(prev) => cond(
      (prev.kind == TokenKind.Operator) => has_top_level_operator(tokens, left_index, right_index),
      true => {
        parent_left_opt := parent_parens.get(left_index);
        match(
          parent_left_opt,
          .None => false,
          .Some(parent_left) => cond(
            (!(candidate_left_indices.contains(parent_left))) => false,
            true => match(
              previous_meaningful_token(tokens, parent_left),
              .None => false,
              .Some(pp) => (
                (pp.kind == TokenKind.Operator) &&
                has_top_level_operator(tokens, left_index, right_index)
              )
            )
          )
        )
      }
    )
  )
});
/// Compute the set of paren indices that should be elided as redundant
/// grouping parens. Mirrors `findRedundantGroupingParenIndices`.
find_redundant_grouping_paren_indices :: (fn(tokens : ArrayList(Token)) -> HashSet(usize))({
  skipped_indices := HashSet(usize).new();
  matching_parens := find_matching_paren_indices(tokens);
  parent_parens := find_parent_paren_indices(tokens);
  candidate_left_indices := HashSet(usize).new();
  // Pass 1: collect all candidates (those that look redundant in isolation).
  n := tokens.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => if((t.kind == TokenKind.LParen) && matching_parens.contains_key(i), {
        right_idx := match(matching_parens.get(i),.Some(x) => x,.None => i);
        if(is_redundant_grouping_paren(tokens, i, right_idx), {
          _add := candidate_left_indices.add(i);
        });
      })
    );
    i = (i + usize(1));
  });
  // Pass 2: filter out candidates whose removal would change operator parsing.
  // We need to iterate candidate_left_indices — HashSet doesn't have iterate
  // so re-walk tokens.
  (j : usize) = usize(0);
  while(runtime(j < n), {
    if(candidate_left_indices.contains(j), {
      right_idx := match(matching_parens.get(j),.Some(x) => x,.None => j);
      keep_candidate := !(paren_removal_would_expose_operator_rhs_infix(
        tokens,
        j,
        right_idx,
        parent_parens,
        candidate_left_indices
      ));
      if(keep_candidate, {
        _add1 := skipped_indices.add(j);
        _add2 := skipped_indices.add(right_idx);
      });
    });
    j = (j + usize(1));
  });
  skipped_indices
});
/// Compute the set of paren indices that should render on multiple
/// lines. Mirrors `findMultilineParenIndices`.
find_multiline_paren_indices :: (
  fn(tokens : ArrayList(Token), skipped_indices : HashSet(usize)) -> HashSet(usize)
)({
  multiline_indices := HashSet(usize).new();
  matching_parens := find_matching_paren_indices(tokens);
  n := tokens.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      tokens.get(i),
      .None => (),
      .Some(t) => if((t.kind == TokenKind.LParen) && matching_parens.contains_key(i), {
        right_idx := match(matching_parens.get(i),.Some(x) => x,.None => i);
        cond(
          (skipped_indices.contains(i) || skipped_indices.contains(right_idx)) => (),
          true => {
            previous := previous_meaningful_token(tokens, i);
            force_multiline := (
              should_force_control_flow_multiline(tokens, i, right_idx, previous) ||
              (has_top_level_field_block(tokens, i, right_idx) ||
                should_force_operator_rhs_block(tokens, i, right_idx, previous))
            );
            // Token row check
            left_tok := t;
            right_tok := match(tokens.get(right_idx),.Some(rt) => rt,.None => left_tok);
            spans_rows := (right_tok.row > left_tok.row);
            cond(
              ((!(force_multiline)) && (!(spans_rows))) => (),
              true => {
                first_inner := next_meaningful_token(tokens, i, right_idx);
                first_is_curly := match(
                  first_inner,
                  .None => false,
                  .Some(fi) => (fi.kind == TokenKind.LCurlyBracket)
                );
                skip := (
                  first_is_curly ||
                  (has_top_level_curly_argument(tokens, i, right_idx) ||
                    (paren_is_call_delimiter(previous) &&
                      has_direct_top_level_closure_argument(tokens, i, right_idx, previous)))
                );
                if(!(skip), {
                  _add1 := multiline_indices.add(i);
                  _add2 := multiline_indices.add(right_idx);
                });
              }
            );
          }
        );
      })
    );
    i = (i + usize(1));
  });
  multiline_indices
});
// ---------------------------------------------------------------------------
// Public entry — `format_yo_source`
// ---------------------------------------------------------------------------
/// Format the given Yo source text and return the rewritten output.
///
/// 1-to-1 port of `formatYoSource` in `src/formatter.ts`. Throws via the
/// implicit `Exception` handler on parse errors (matches TS `throw`).
///
/// **Phase A.10 status**: stub — currently returns the input unchanged.
/// The full pipeline (token classification, paren/bracket/curly stack
/// management, multiline detection, comment normalisation, indentation) will
/// be filled in by subsequent commits.
format_yo_source :: (fn(input : String, _module_path : String) -> String)(
  input
);
export(
  INDENT_SIZE,
  is_comment_token,
  is_line_comment_token,
  is_atom_like_token,
  is_ignored_format_dir,
  FormatYoFilesOptions,
  FormatYoFilesResult,
  paren_is_call_delimiter,
  operator_allows_ungrouped_rhs,
  is_function_type_keyword,
  needs_space_before_atom,
  prefix_operator_needs_leading_space,
  leading_whitespace_length,
  previous_meaningful_token,
  next_meaningful_token,
  token_range_has_comment,
  has_any_token,
  has_top_level_token,
  has_top_level_operator,
  next_token,
  find_matching_paren_indices,
  find_parent_paren_indices,
  find_inline_curly_indices,
  find_multiline_bracket_indices,
  find_multiline_inline_curly_indices,
  should_force_operator_rhs_block,
  should_force_control_flow_multiline,
  has_top_level_curly_argument,
  has_top_level_field_block,
  has_direct_top_level_closure_argument,
  is_parenthesized_dot_deref,
  is_redundant_grouping_paren,
  paren_removal_would_expose_operator_rhs_infix,
  find_redundant_grouping_paren_indices,
  find_multiline_paren_indices,
  format_yo_source
);
