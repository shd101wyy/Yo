pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ Thread } :: import("std/thread");
{ yield } :: import("std/async");
open(import("std/fmt"));

main :: (fn() -> unit)({
  // CASE A — async body returns a value built from LOCALS only.
  t1 := Thread.spawn((io) => {
    task := io.async((io : Io) => {
      io.await(yield(io), io);
      return(i32(30));
    });
    r := io.await(task, io);
    assert(r == i32(30), "A: local-only result should be 30");
  });
  t1.join();
  // CASE B — async body returns a value built from CAPTURED outer variables.
  t2 := Thread.spawn((io) => {
    x := 10;
    y := 20;
    task := io.async((io : Io) => {
      io.await(yield(io), io);
      return(x + y);
    });
    r := io.await(task, io);
    assert(r == i32(30), "B: captured result should be 30");
  });
  t2.join();
  println(`both ok`);
});

export(main);
