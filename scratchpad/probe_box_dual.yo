//! Dual probe: the WORKING `Box(i32)` shape and the FAILING `Box(Self)` shape
//! in ONE file, so a single run yields both PROBEFM traces for diffing.
open(import("std/fmt"));

// --- WORKING: Box over a concrete type -------------------------------------
Holder :: struct(inner : Box(i32));
derive(Holder, Clone);

// --- FAILING: Box over Self (recursive enum) --------------------------------
TreeNode :: enum(Leaf(value : i32), Branch(left : Box(Self), right : Box(Self)));
derive(TreeNode, Clone);

main :: (fn() -> unit)({
  h := Holder(inner : box(i32(5)));
  h2 := h.clone();
  println(`holder cloned`);
  leaf_a := TreeNode.Leaf(i32(1));
  leaf_b := TreeNode.Leaf(i32(2));
  tree := TreeNode.Branch(box(leaf_a), box(leaf_b));
  t2 := tree.clone();
  println(`tree cloned`);
});

export(main);
