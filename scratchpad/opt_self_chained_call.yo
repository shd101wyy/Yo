open(import("std/fmt"));

Node :: ref(
  struct(
    value : i32,
    child : Option(Self)
  )
);

impl(
  Node,
  get_child : (fn(self : Self) -> Option(Self))(self.child)
);

main :: (fn() -> unit)({
  leaf := Node(value : i32(2), child : Option(Node).None);
  root := Node(value : i32(1), child : Option(Node).Some(leaf));
  // STANDALONE binding — expected to be fine
  ok := root.get_child();
  println(`standalone is_some=${ok.is_some().to_string()}`);
  // CHAINED call on the Option(Self) result — expected to FAIL
  inner := root.get_child().unwrap();
  println(`chained value=${inner.value.to_string()}`);
});

export(main);
