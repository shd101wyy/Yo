{ assert } :: import("std/assert");
main :: (fn() -> unit)({
  comptime_return_array :: (fn(comptime(n) : usize) -> comptime(Array(i32, n)))(begin(
    return((Array(i32, n).fill)(30)),
    ()
  ));
  arr3 := comptime_return_array(10);
  assert(arr3.len() == 10);
  assert(arr3(0) == 30);
});
export(main);
