open(import("std/fmt"));

Node :: ref(
  struct(
    value : i32,
    child : Option(Self)
  )
);

impl(
  Node,
  get_child : (fn(self : Self) -> Option(Self))(self.child)
);

main :: (fn() -> unit)({
  leaf := Node(value : i32(3), child : Option(Node).None);
  mid := Node(value : i32(2), child : Option(Node).Some(leaf));
  root := Node(value : i32(1), child : Option(Node).Some(mid));
  match(
    root.get_child(),
    .Some(c1) => match(
      c1.get_child(),
      .Some(c2) => println(`depth2 value=${c2.value.to_string()}`),
      .None => println(`no c2`)
    ),
    .None => println(`no c1`)
  );
});

export(main);
