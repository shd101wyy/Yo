open(import("std/fmt"));

Node :: ref(
  struct(
    value : i32,
    child : Option(Self)
  )
);

impl(
  Node,
  get_child : (fn(self : Self) -> Option(Self))(self.child)
);

main :: (fn() -> unit)({
  n4 := Node(value : i32(4), child : Option(Node).None);
  n3 := Node(value : i32(3), child : Option(Node).Some(n4));
  n2 := Node(value : i32(2), child : Option(Node).Some(n3));
  root := Node(value : i32(1), child : Option(Node).Some(n2));
  match(
    root.get_child(),
    .Some(c1) => match(
      c1.get_child(),
      .Some(c2) => match(
        c2.get_child(),
        .Some(c3) => match(
          c3.get_child(),
          .Some(c4) => println(`deep value=${c4.value.to_string()}`),
          .None => println(`no c4`)
        ),
        .None => println(`no c3`)
      ),
      .None => println(`no c2`)
    ),
    .None => println(`no c1`)
  );
});

export(main);
