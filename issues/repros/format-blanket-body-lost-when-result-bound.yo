open(import("std/string"));
open(import("std/fmt"));
main :: (fn() -> unit)({
  a := Option(i32).Some(i32(4)).format(">10");
  b := `   Some(4)`;
  println(String.from("a=[") + a + String.from("] len=") + a.len().to_string());
  println(String.from("b=[") + b + String.from("] len=") + b.len().to_string());
  println(String.from("eq=") + (a == b).to_string());
});
export(main);
