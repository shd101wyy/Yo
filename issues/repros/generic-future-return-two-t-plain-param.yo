{ println } :: import("std/fmt");
Pair :: struct(lo : i32, hi : i32);
wrap :: (fn(generic(T : Type), v : T, io : Io) -> Impl(Future(T, Io)))(
  io.async((io : Io) => v)
);
main :: (fn(io : Io) -> unit)({
  a := io.await(wrap(i32(7), io), io);
  println(`a=${a + i32(0)}`);
  b := io.await(wrap(Pair(lo : i32(3), hi : i32(4)), io), io);
  println(`b=${b.lo + b.hi}`);
});
export(main);
