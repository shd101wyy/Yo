{ println } :: import("std/fmt");

// Reproducer for issues/fixed/yo-self-rc-depth-cap-skips-deep-teardown.md
//
// `_type_contains_rc_inner` (src/types/utils.yo) answered FALSE past 8
// aggregate levels ("contains nothing to drop"), so codegen's
// `generate_drop_code_for_value` emitted no teardown for a value whose
// counted or `Drop` leaf sat 9 or more levels down.
//
// A ref struct with a `Drop` impl makes teardown OBSERVABLE without ever
// reading a freed value: if the enclosing struct's drop is emitted,
// "disposed" prints; if it was suppressed, nothing prints and the object
// leaked.
//
// L0 puts Tracked at depth 10; L2 puts it at depth 8 as the control.
//
// EXPECTED (fixed):  disposed=42 and disposed=7
// BEFORE THE FIX:    disposed=7 only — the depth-10 object was never dropped.
Tracked :: ref(struct(v : i32));
impl(
  Tracked,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      println(`disposed=${self.v}`);
    })
  )
);

L9 :: struct(t : Tracked);
L8 :: struct(v : L9);
L7 :: struct(v : L8);
L6 :: struct(v : L7);
L5 :: struct(v : L6);
L4 :: struct(v : L5);
L3 :: struct(v : L4);
L2 :: struct(v : L3);
L1 :: struct(v : L2);
L0 :: struct(v : L1);

main :: (fn() -> unit)({
  println(`-- enter deep scope --`);
  {
    deep := L0(v : L1(v : L2(v : L3(v : L4(v : L5(v : L6(v : L7(v : L8(v : L9(t : Tracked(v : 42)))))))))));
    println(`deep built = ${deep.v.v.v.v.v.v.v.v.v.t.v}`);
  };
  println(`-- left deep scope --`);
  println(`-- enter control scope --`);
  {
    ctl := L2(v : L3(v : L4(v : L5(v : L6(v : L7(v : L8(v : L9(t : Tracked(v : 7)))))))));
    println(`ctl built = ${ctl.v.v.v.v.v.v.v.t.v}`);
  };
  println(`-- left control scope --`);
});

export(main);
