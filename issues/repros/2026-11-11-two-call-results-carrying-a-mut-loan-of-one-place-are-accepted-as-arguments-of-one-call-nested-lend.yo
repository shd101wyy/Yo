// expect: E0910
// The second argument `first(&xs)` creates a `&` loan of `xs` INSIDE a nested call; its result
// carries that loan into `f` beside `&mut xs`. `f` clears the list, then reads the freed
// element through `r`: heap-use-after-free.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
first :: (fn(xs : &ArrayList(String)) -> &String)(&xs(usize(0)));
f :: (fn(xs : &mut ArrayList(String), r : &String) -> usize)({
  xs.clear();
  r.clone().len()
});
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(long());
  v := f(&mut xs, first(&xs));
  println(`OUT: ${v.to_string()}`);
});
export(main);
