// A plain `Exception` handler that `return`s a value: the throw site resumes
// with 0, not the value (issues/a-plain-exception-handler-that-returns-a-value-resumes-with-zero.md).
// Prints `sync: 0` and `after an await: 0 1`; `ResumableException(i32)` resumes with 7.
{ Error, Exception } :: import("std/error");
{ String } :: import("std/string");
{ println, ToString } :: import("std/fmt");
Boom :: struct(msg : String);
impl(Boom, ToString(to_string : (self -> self.msg)));
impl(Boom, Error());
checked :: (fn(n : i32, exn : Exception) -> i32)(
  cond(
    (n > i32(100)) => exn.throw(dyn(Boom(msg : `too big`))),
    true => n
  )
);
g :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(io.async((e : Io) => n));
main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        return(i32(7));
      }
    )
  );
  println(`sync: ${checked(i32(500), exn)}`);
  a := io.await(g(i32(1), io), io);
  println(`after an await: ${checked(i32(500), exn)} ${a}`);
});
export(main);
