// expect: accept
// The swap the tuple form looks like, written with a temporary: prints a=2 b=1.
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(a) := i32(1);
  mut(b) := i32(2);
  tmp := a;
  a = b;
  b = tmp;
  println(`OUT a=${a.to_string()} b=${b.to_string()}`);
});
export(main);
