// expect: E0911
// `h = .Some(&x)` on iteration 1 and `x = …` on iteration 2: the write comes first in the body's text, so it is
// checked before the loan exists, and the loan the back edge carries is never checked against it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  mut(x) := L();
  mut(h) := Option(&String).None;
  mut(i) := 0;
  while(i < 3, {
    if(i == 2, { x = String.from("q"); });
    if(i == 1, { h = .Some(&x); });
    i = (i + 1);
  });
  match(h, .Some(r) => println(`OUT: ${r.*}`), .None => ());
  ()
});
export(main);
