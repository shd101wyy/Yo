// expect: E0923
// `H`'s `&` field is an elided origin parameter. Named twice in `stash`'s signature it gets no origin at
// all, so the body stores `h` into `dst.*` unchecked and the caller's `o` outlives `y` (heap-use-after-free).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
stash :: (fn(dst : &mut Option(H), h : H) -> unit)({
  dst.* = .Some(h);
});
main :: (fn() -> unit)({
  mut(o) := Option(H).None;
  {
    y := mk();
    stash(&mut o, H(r : &y, n : i32(0)));
  };
  match(&o, .Some(h) => println(`OUT: ${h.r.*.*.s.len().to_string()}`), .None => ());
});
export(main);
