// expect: accept
// Positive control: the signature spells one origin `p` for both occurrences of the holder.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
G :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p), n : i32));
stash :: (fn(generic(p : Origin), dst : &mut Option(G(p)), h : G(p)) -> unit)({
  dst.* = .Some(h);
});
main :: (fn() -> unit)({
  y := mk();
  mut(o) := Option(G(y)).None;
  stash(&mut o, G(y)(r : &y, n : i32(0)));
  match(&o, .Some(h) => println(`OUT: ${h.r.*.*.s.len().to_string()}`), .None => ());
});
export(main);
