// expect: E0911
// `b` is a reference bound from a CALL RESULT (`idr` returns its `&` parameter), so `b`
// holds a `&` loan of `x`. `match(b, …)` binds `p` into `b`'s referent, and `b`'s last
// use is the scrutinee. The arm then overwrites `x` and reads `p`: nothing keeps `x`
// frozen for `p`, the payload `Rc` is released by the write, and the read is a
// use-after-free (ASan: SEGV through the freed cell).
//   yo compile <this> --optimize 1 --sanitize address --allocator system -o t && ./t
// With a direct lend (`b := &x`) this exact program is E0911, but only because the `match`
// initializes `n`; as a statement `match` the direct-lend form is accepted too (the doc's wider family).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
idr :: (fn(r : &Option(Rc(X))) -> &Option(Rc(X)))(&r.*);
mk :: (fn() -> Option(Rc(X)))(
  .Some(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))))
);
main :: (fn() -> unit)({
  mut(x) := mk();
  b := idr(&x);
  n := match(
    b,
    .Some(p) => {
      x = .None;
      p.*.s.len()
    },
    .None => usize(0)
  );
  println(`OUT: ${n.to_string()}`);
  ()
});
export(main);
