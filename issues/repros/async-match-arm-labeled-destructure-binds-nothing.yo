{ println } :: import("std/fmt");
{ yield } :: import("std/async");
{ args } :: import("std/env");
Shape :: enum(Circle(radius : i32), Rect(width : i32, height : i32));
main :: (fn(io : Io) -> i32)({
  n := i32(args().len());
  s := if(n > 100, Shape.Circle(i32(1)), Shape.Rect(i32(4), i32(5)));
  result := Box(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      s,
      .Rect({ width, height : h }) => {
        io.await(yield(io), io);
        width * h
      },
      .Circle(radius : r) => {
        io.await(yield(io), io);
        r * r
      }
    );
  });
  io.await(task, io);
  println(`result=${result.*}`);
  i32(0)
});
export(main);
