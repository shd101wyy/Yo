//! Two `Dyn(Fn(...))` types that differ only in a parameter's mode share one
//! C vtable struct (issues/2026-10-27-dyn-fn-types-differing-only-in-a-parameter-mode-share-one-vtable.md).
//! Expected when fixed: compiles and runs (rc 0).
main :: (fn() -> unit)({
  (a : Dyn(Fn(x : &mut i32) -> unit)) = dyn((x : &mut i32) => {
    x = (x + i32(1));
  });
  (b : Dyn(Fn(x : i32) -> unit)) = dyn((x : i32) => {
    _y := (x + i32(1));
  });
  (mut(v) : i32) = i32(1);
  a(&mut v);
  b(v);
});
export(main);
