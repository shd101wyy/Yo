import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");

MyExpr :: enum(
  Lit(value : i32),
  Add(lhs : Box(Self), rhs : Box(Self)),
  List(items : ArrayList(Self))
);
main :: (fn() -> unit)({
  items := ArrayList(MyExpr).new();
  items.push(MyExpr.Lit(i32(10)));
  e := MyExpr.List(items);
  e;
  println(`OK`);
});
export(main);
