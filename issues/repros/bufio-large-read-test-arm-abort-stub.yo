//! The generic `BufReader(R)` / `BufWriter(W)` (`std/io/bufio`, D5) — the
//! coverage carried over from the deleted fd-based `tests/sys/bufio.test.yo`,
//! re-expressed against the trait-generic API over `File`, plus the new
//! contracts: the wrappers satisfy the `Reader`/`Writer` bounds themselves,
//! `read_to_end`/`read_to_string` arrive as trait defaults, and `BufWriter`
//! deliberately does NOT flush on drop (tokio contract — flush explicitly).
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/collections/array_list"));
open(import("std/string"));
{ IoExn } :: import("std/error");
{ Reader, Writer, copy } :: import("std/io");
{ BufReader, BufWriter } :: import("std/io/bufio");
{ File, OpenMode } :: import("std/fs/file");
{ Path } :: import("std/path");
{ remove_file } :: import("std/fs/dir");
{ write_string } :: import("std/fs/file");

_p :: (fn(name : str) -> Path)(
  Path.new(`/tmp/yo_io_bufio_`.to_string() + String.from(name))
);
test("BufReader large read bypasses the buffer", {
  path := _p("bypass.txt");
  big := ArrayList(u8).new();
  (i : usize) = usize(0);
  while(i < usize(64), i = (i + usize(1)), {
    big.push(u8(usize(65) + (i % usize(26))));
  });
  fw := io.await(File.open(path, OpenMode.Write, io), { io });
  io.await(fw.write(big.ptr().unwrap(), big.len(), io), { io });
  io.await(fw.close(io), { io });
  f := io.await(File.open(path, OpenMode.Read, io), { io });
  br := BufReader(File).with_capacity(f, usize(8));
  out := ArrayList(u8).new();
  (j : usize) = usize(0);
  while(j < usize(64), j = (j + usize(1)), {
    out.push(u8(0));
  });
  n := io.await(br.read(out.ptr().unwrap(), usize(64), io), { io });
  assert(n == usize(64), "one bypass read got everything");
  assert(out(usize(63)) == big(usize(63)), "content intact");
  io.await(f.close(io), { io });
  io.await(remove_file(path, io), { io });
});
