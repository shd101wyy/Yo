// issues/2026-10-22-clone-of-an-anonymous-record-element-copies-the-element-first.md
// Expected: prints 4 (`raw(0).clone()` clones the element field-wise, as `r.clone()` on a local does).
// Actual: E0901 "cannot copy `raw(usize(0))` ... it is borrowed from the value that holds it".
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
B :: struct(n : i32);
impl(B, Drop(drop : (fn(self : &mut Self) -> unit)(())));
impl(B, Clone(clone : (fn(self : &Self) -> Self)(B(n : self.n))));
main :: (fn() -> unit)({
  mut(raw) := ArrayList(struct(b : B, k : i32)).new();
  raw.push({ b : B(n : i32(4)), k : i32(1) });
  s := raw(usize(0)).clone();
  println(&s.b.n);
});
export(main);
