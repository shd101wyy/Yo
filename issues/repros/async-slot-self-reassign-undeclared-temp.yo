// Minimal repro: reassigning an RC (String) variable that lives in an async
// state-machine slot, with an RHS that also READS the variable
// (`abs_exe = f(abs_exe.clone())`), emits a drop of the variable's OLD value
// through a temp id that was never declared -> invalid C
// ("use of undeclared identifier '_yo..._temp_N'").
{ assert } :: import("std/assert");
open(import("std/string"));
{ Path } :: import("std/path");
{ exists } :: import("std/fs/file");
{ Exception, IoExn } :: import("std/error");

resolve_abs :: (fn(io : Io) -> Impl(Future(String, IoExn)))(
  io.async((e : IoExn) => {
    (abs_exe : String) = String.from("bin/app");
    if(!(Path.new(abs_exe.clone()).is_absolute()), {
      base := String.from("/root");
      abs_exe = Path.new(base).join(Path.new(abs_exe.clone())).to_string();
    });
    // The variable must SURVIVE a suspension point to be lowered into a
    // state-machine slot — the await is what makes `abs_exe` an sm-> field.
    found := e.io.await(exists(Path.new(abs_exe.clone()), e.io), e.io);
    if(found, abs_exe.clone(), abs_exe)
  })
);

main :: (fn(io : Io) -> unit)({
  r := io.await(resolve_abs(io), IoExn(io : io, exn : Exception(throw : ((_e) -> unwind(())))));
  assert(r.len() > usize(0));
});
export(main);
