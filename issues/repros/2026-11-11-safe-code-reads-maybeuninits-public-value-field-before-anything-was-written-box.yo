// expect: E0405 (MaybeUninit's payload field private to the prelude; today accepted)
// The never-written `value` of `MaybeUninit(Box(i64)).new()` is a zeroed `Box`, dereferenced in safe code.
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  m := MaybeUninit(Box(i64)).new();
  v := m.value.*;
  println(`OUT: ${v.to_string()}`);
});
export(main);
