// expect: accept
// The receiver form: `mkw()` is a temporary receiver of a `self : &Self` method whose argument awaits.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
make :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
num :: (fn(io : Io) -> Impl(Future(usize, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    usize(7)
  })
);
W :: struct(s : String);
impl(W, plus : (fn(self : &Self, n : usize) -> usize)({
  println(`OUT: ${self.s}`);
  (self.s.len() + n)
}));
mkw :: (fn() -> W)(W(s : make()));
main :: (fn(io : Io) -> unit)({
  f := io.async((io : Io) => mkw().plus(io.await(num(io), io)));
  println(`OUT: ${io.await(f, io).to_string()}`);
});
export(main);
