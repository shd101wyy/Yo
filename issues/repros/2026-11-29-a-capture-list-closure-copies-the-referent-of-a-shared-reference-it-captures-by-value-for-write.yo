{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");

writes_local :: (fn(xs : &ArrayList(i32)) -> unit)({
  (f : Impl(Fn() -> unit)) = ({ xs }() => {
    for(xs, x => {
      x.* = i32(99);
    });
  });
  f();
});

main :: (fn() -> unit)({
  xs := ArrayList(i32).from([1, 5, 2]);
  writes_local(&xs);
  for(&xs, v => println(`${v.*} `));
});
export(main);
