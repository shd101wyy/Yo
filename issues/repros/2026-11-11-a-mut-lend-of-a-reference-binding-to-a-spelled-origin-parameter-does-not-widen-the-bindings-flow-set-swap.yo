// expect: E0911
// The corpus's `swap-inferred-locals` shape with a block-local referent: neither binding is widened.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
sw :: (fn(generic(p : Origin), a : &mut &(Rc(X), p), b : &mut &(Rc(X), p)) -> unit)({
  t := a.*;
  a.* = b.*;
  b.* = t;
});
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  {
    inner := mk();
    mut(q) := &inner;
    sw(&mut r, &mut q);
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
