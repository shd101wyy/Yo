{ Thread } :: import("std/thread");
{ println } :: import("std/fmt");
_work :: (fn(io : Io) -> unit)({
  println("work");
});
main :: (fn() -> unit)({
  t1 := Thread(unit).spawn(_work);
  t1.join();
  f := _work;
  t3 := Thread(unit).spawn((io : Io) => {
    f(io);
    ()
  });
  t3.join();
});
export(main);
