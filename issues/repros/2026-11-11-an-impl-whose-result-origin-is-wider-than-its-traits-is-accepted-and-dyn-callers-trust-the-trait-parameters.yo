// expect: E0923
// The PARAMETER direction: the trait keeps `v` and `self` apart (two fresh origins); the impl requires
// `v` to share `Slot(p)`'s origin and stores it into `self`. Rejected at the impl once impls are checked
// against their trait per position. (The direct call below is also closed by the method-lend fix.)
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
Store :: trait(put : (fn(self : &mut Self, v : &Rc(X)) -> unit));
Slot :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(dst : Option(&(Rc(X), p))));
impl(
  generic(p : Origin),
  Slot(p),
  Store(
    put : (fn(self : &mut Self, v : &(Rc(X), p)) -> unit)({
      self.dst = .Some(v);
    })
  )
);
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  mut(s) := Slot(x)(dst : .Some(&x));
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    s.put(&b);
  };
  match(&s.dst, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
