open(import("std/string"));
open(import("std/fmt"));
{ FormatSpec } :: import("std/fmt/spec");
{ Alignment } :: import("std/fmt/writer");
main :: (fn() -> unit)({
  // (1) plain to_string bound to a local, inline receiver
  t := Option(i32).Some(i32(4)).to_string();
  println(String.from("to_string bound   =[") + t + String.from("] len=") + t.len().to_string());
  // (2) pad applied to that local
  p := FormatSpec.parse(">10").pad(t, Alignment.Left);
  println(String.from("pad(local)        =[") + p + String.from("]"));
  // (3) pad applied to a fresh inline to_string
  q := FormatSpec.parse(">10").pad(Option(i32).Some(i32(4)).to_string(), Alignment.Left);
  println(String.from("pad(inline t_s)   =[") + q + String.from("]"));
  // (4) same but with a String literal body
  r := FormatSpec.parse(">10").pad(String.from("Some(4)"), Alignment.Left);
  println(String.from("pad(literal)      =[") + r + String.from("]"));
});
export(main);
