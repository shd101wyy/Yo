// expect: accept
// Positive control: the impl keeps the trait's parameter origins (`v` is unrelated to `self`) and only reads `v`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
Store :: trait(put : (fn(self : &mut Self, v : &Rc(X)) -> unit));
Count :: struct(n : usize);
impl(
  Count,
  Store(
    put : (fn(self : &mut Self, v : &Rc(X)) -> unit)({
      self.n = (self.n + v.*.s.len());
    })
  )
);
main :: (fn() -> unit)({
  mut(c) := Count(n : usize(0));
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    c.put(&b);
  };
  println(`OUT: ${c.n.to_string()}`);
});
export(main);
