// expect: accept
// Positive control: the slot is read only in the iteration that stored it (the read moves it; it is reset before
// the back edge), so nothing reaches a dead local over the back edge.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  mut(slot) := Option(&String).None;
  mut(i) := 0;
  while(i < 3, {
    b := Box.new(L());
    slot = .Some(&b.*);
    match(slot, .Some(r) => println(`OUT: ${r.*}`), .None => ());
    slot = .None;
    i = (i + 1);
  });
  ()
});
export(main);
