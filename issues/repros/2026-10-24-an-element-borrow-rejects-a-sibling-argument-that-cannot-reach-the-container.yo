{ replace, take } :: import("std/mem");
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ assert } :: import("std/assert");
main :: (fn() -> unit)({
  mut(s) := ArrayList(String).new();
  s.push(`a`);
  v := `c`;
  y := replace(&mut s(usize(0)), v);
  assert(y == `a`, "old");
});
export(main);
