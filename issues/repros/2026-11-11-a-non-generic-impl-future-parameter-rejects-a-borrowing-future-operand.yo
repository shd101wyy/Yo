// expect: accept
// `wrap2`'s `f : Impl(Future(i32, Io))` is the generic `wrap`'s parameter without `generic(T)`:
// it rejects the borrowing operand `mk(&x, io)` with E0909, which `wrap(mk(&x, io), io)` accepts.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
mk :: (fn(s : &String, io : Io) -> Impl(Future(i32, Io)))(
  io.async({ s : &s.* }(io : Io) => {
    io.await(yield(io), io);
    println(`OUT: ${s.*}`);
    i32(1)
  })
);
wrap2 :: (fn(f : Impl(Future(i32, Io)), io : Io) -> Impl(Future(i32, Io)))(
  io.async({ f }(io : Io) => {
    io.await(yield(io), io);
    io.await(f, io)
  })
);
main :: (fn(io : Io) -> unit)({
  x := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  t := wrap2(mk(&x, io), io);
  println(`OUT: ${io.await(t, io).to_string()}`);
});
export(main);
