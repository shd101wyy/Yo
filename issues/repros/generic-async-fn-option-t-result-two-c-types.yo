{ println } :: import("std/fmt");
_wrap :: (fn(generic(U : Type), v : U, io : Io) -> Impl(Future(Option(U), Io)))(
  io.async((io : Io) => Option(U).Some(v))
);
main :: (fn(io : Io) -> unit)({
  r := io.await(_wrap(i32(5), io), io);
  match(r, .Some(x) => println(x), .None => println("none"));
});
export(main);
