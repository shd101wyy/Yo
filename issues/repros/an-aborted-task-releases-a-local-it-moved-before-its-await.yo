{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
{ sleep } :: import("std/sys/timer");
(g_disposed : i32) = i32(0);
(g_kept : ArrayList(Thing)) = ArrayList(Thing).new();
Thing :: ref(struct(n : i32));
impl(Thing, Dispose(dispose : (fn(self : Self) -> unit)({
  g_disposed = (g_disposed + i32(1));
})));
_consume :: (fn(own(t) : Thing) -> unit)({
  g_kept.push(t);
});
_task :: (fn(io : Io) -> Impl(Future(i32, Io)))(io.async((e : Io) => {
  t := Thing(n : i32(7));
  _consume(t);
  e.await(sleep(u64(50)), e);
  i32(1)
}));
main :: (fn(io : Io) -> unit)({
  h := io.spawn(_task(io), io);
  io.await(yield(io), io);
  h.abort();
  _r := h.await(io);
  println(`disposed-before-clear=${g_disposed}`);
  g_kept.clear();
  println(`result: disposed=${g_disposed} (want 1)`);
});
export(main);
