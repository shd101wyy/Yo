// expect: accept (drops=3, no leak)
// The temporary first argument when the second argument's callee unwinds
// through a `ctl` handler.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
(mut(g_drops) : i32) = i32(0);
nd :: (fn() -> i32)(g_drops);
D :: struct(s : String);
impl(
  D,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_drops = (g_drops + i32(1));
    })
  )
);
mk :: (fn() -> D)(D(s : String.from("payload-0123456789abcdefghijklmnop")));
Raise :: (ctl(msg : i32) -> D);
two :: (fn(a : D, b : D) -> usize)(a.s.len() + b.s.len());
mkr :: (fn(c : bool, raise : Raise) -> D)(cond(c => raise(i32(1)), true => mk()));
inner :: (fn(c : bool, raise : Raise) -> usize)(two(mk(), mkr(c, raise)));
run :: (fn(c : bool) -> usize)({
  (raise : Raise) = (
    msg -> {
      unwind(usize(7));
    }
  );
  inner(c, raise)
});
main :: (fn() -> unit)({
  r1 := run(true);
  r2 := run(false);
  println(`OUT r1=${r1.to_string()} drops=${nd().to_string()} expect 3`);
});
export(main);
