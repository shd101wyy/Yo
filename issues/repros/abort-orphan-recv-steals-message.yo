{ eprintln } :: import("std/fmt");
{ sleep } :: import("std/sys/timer");
{ timeout } :: import("std/async");
{ Duration } :: import("std/time/duration");
{ Channel } :: import("std/async/channel");
main :: (fn(io : Io) -> unit)({
  ch := Channel(i32).new(usize(4));
  f := io.async((io : Io) => {
    v := io.await(ch.recv(io), io);
    eprintln(`DEAD receiver resumed`);
    match(v, .Some(x) => x, .None => i32(-1))
  });
  h := io.spawn(f, io);
  r := timeout(h, Duration.from_millis(i64(5)), io);
  eprintln(`f timed out: ${r.is_err()}`);
  g := io.async((io : Io) => {
    v := io.await(ch.recv(io), io);
    match(v, .Some(x) => x, .None => i32(-1))
  });
  hg := io.spawn(g, io);
  io.await(sleep(u64(2)), io);
  sr := io.await(ch.send(i32(42), io), io);
  eprintln(`sent 42`);
  r2 := timeout(hg, Duration.from_millis(i64(50)), io);
  eprintln(`live receiver got it: ${r2.is_ok()} (expect true)  buffered=${ch.len()}`);
});
export(main);
