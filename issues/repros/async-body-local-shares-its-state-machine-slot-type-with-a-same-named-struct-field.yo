// Reproducer for issues/fixed/async-body-local-shares-its-state-machine-slot-type-with-a-same-named-struct-field.md
{ println } :: import("std/fmt");
{ String } :: import("std/string");
{ Exception, IoExn } :: import("std/error");
{ yield } :: import("std/async");

Resolution :: ref(struct(root : Option(String), n : usize));
resolve :: (fn(io : Io) -> Impl(Future(Resolution, IoExn)))(
  io.async((e : IoExn) => {
    e.io.await(yield(e.io), e.io);
    Resolution(root : Option(String).Some(String.from("/dep")), n : usize(1))
  })
);
// A local named like a struct FIELD read in the same async body, of a
// different type, both used after an await.
walk :: (fn(io : Io) -> Impl(Future(String, IoExn)))(
  io.async((e : IoExn) => {
    (log : String) = String.new();
    (k : usize) = usize(0);
    while(runtime(k < usize(2)), {
      resolution := e.io.await(resolve(e.io), e);
      dep_root_opt := resolution.root;
      root := match(dep_root_opt, .Some(r) => r, .None => String.from("none"));
      log.push_string(`${root};`);
      k = (k + usize(1));
    });
    log
  })
);
main :: (fn(io : Io, exn : Exception) -> unit)({
  println(io.await(walk(io), IoExn(io : io, exn : exn)));
});
export(main);
