// expect: E0923/E0911
// Invariance through a generic wrapper at the type level: put(generic(T), w : W(&mut Option(T)), v : T) at T := H.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X));
W :: (fn(comptime(Y) : Type) -> comptime(Type))(struct(inner : Y));
put :: (fn(generic(T : Type), w : W(&mut Option(T)), v : T) -> unit)({
  w.inner.* = .Some(v);
});
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  mut(slot) := Option(H).Some(H(r : &x));
  {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    put(W(&mut Option(H))(inner : &mut slot), H(r : &y));
  };
  match(slot, .Some(h) => println(`OUT: ${h.r.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
