// expect: E0911
// A struct holder: `b = mk()` at the top of every iteration frees the Box that the previous iteration's
// `h = H(r : &b.*, …)` points into; `h` is read after the loop.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &X, n : i32);
mk :: (fn() -> Box(X))(Box.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  a := mk();
  mut(b) := mk();
  mut(h) := H(r : &a.*, n : i32(0));
  mut(i) := i32(0);
  while(i < i32(3), {
    b = mk();
    if(i == i32(1), {
      h = H(r : &b.*, n : i32(1));
    });
    i = (i + i32(1));
  });
  println(`OUT: ${h.r.*.s.len().to_string()}`);
  ()
});
export(main);
