pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ yield } :: import("std/async");
_a2_count :: (fn(items : &ArrayList(i32), io : Io) -> Impl(Future(usize, Io)))(
  io.async({ &items }(io : Io) => items.len())
);
_a2_push :: (fn(items : &mut ArrayList(i32), io : Io) -> Impl(Future(unit, Io)))(
  io.async({ &mut items }(io : Io) => items.push(i32(1)))
);
test("a borrowing future's io.await takes a bundle that is a place (§3.13 A2)", {
  mut(s) := ArrayList(i32).new();
  s.push(i32(7));
  comptime_expect_error(
    io.await(_a2_count(&s, io), {
      s = ArrayList(i32).new();
      io
    }),
    "the bundle must be a place"
  );
  comptime_expect_error(
    io.await(_a2_count(&s, io), {
      io.await(_a2_push(&mut s, io), io);
      io
    }),
    "the bundle must be a place"
  );
  assert(io.await(_a2_count(&s, io), io) == usize(1), "a place bundle is accepted");
});
