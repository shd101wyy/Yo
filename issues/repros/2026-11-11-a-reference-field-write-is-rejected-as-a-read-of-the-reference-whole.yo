// expect: accept
// The workaround accepted today: rebuild the whole holder instead of writing its field.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
main :: (fn() -> unit)({
  z := mk();
  y := mk();
  mut(h) := H(r : &z, n : i32(0));
  h = H(r : &y, n : h.n);
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
});
export(main);
