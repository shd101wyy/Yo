{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
S :: struct(buf : ArrayList(u8), cap : usize);
main :: (fn() -> unit)({
  l := ArrayList(u8).new();
  l.push(u8(1));
  s := S(buf : l, cap : usize(4));
  r := (i32(1), s.buf);
  println(`len ${r.1.len()} ${s.buf.len()}`);
});
export(main);
