// expect: accept
// Positive control: the result points into the REFERENCE parameter `a`, the place the elided
// origin names; the by-value list is only read inside `pick`.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
pick :: (fn(a : &String, xs : ArrayList(String)) -> Option(&String))(
  cond(
    (xs.len() > usize(0)) => .Some(a),
    true => .None
  )
);
main :: (fn() -> unit)({
  t := long();
  mut(ys) := ArrayList(String).new();
  ys.push(long());
  o := pick(&t, ys);
  match(o, .Some(r) => println(`OUT: ${r.clone()}`), .None => ());
});
export(main);
