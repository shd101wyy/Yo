{ assert } :: import("std/assert");
main :: (fn() -> unit)({
  x := Box(i32)(3);
  y := [x,];
  z := [y,];
  m := [z,];
  n := [m,];
  assert(x.* == 3, "x");
  assert(y(0).* == 3, "y");
  assert(z(0)(0).* == 3, "z");
  assert(m(0)(0)(0).* == 3, "m");
  assert(n(0)(0)(0)(0).* == 3, "n");
});
export(main);
