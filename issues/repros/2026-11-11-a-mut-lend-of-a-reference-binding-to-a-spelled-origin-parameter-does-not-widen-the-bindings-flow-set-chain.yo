// expect: E0911
// A28 at depth 2 (the audit re-probe's e_rr_chain): `set(&mut rpp.*.*, &inner)` through `rpp := &mut rp`, `rp := &mut r`; the write-back must follow the re-borrow chain to `r`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
set :: (fn(generic(p : Origin), dst : &mut&(Rc(X), p), v : &(Rc(X), p)) -> unit)({
  dst.* = v;
});
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  mut(rp) := &mut r;
  {
    inner := mk();
    rpp := &mut rp;
    set(&mut rpp.*.*, &inner);
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
