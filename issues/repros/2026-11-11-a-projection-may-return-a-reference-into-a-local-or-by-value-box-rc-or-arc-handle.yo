// expect: E0912
// A projection returns `&b.*` of a LOCAL `Box`: the root rule treats every `.*` as a raw-pointer deref
// and stops, so the result points into the box the function frees when it returns.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
get :: (fn(a : &String) -> &String)({
  b := Box.new(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  &b.*
});
main :: (fn() -> unit)({
  k := String.from("k");
  println(`OUT: ${get(&k)}`);
});
export(main);
