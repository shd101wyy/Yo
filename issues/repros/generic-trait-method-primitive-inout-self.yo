open(import("std/string"));
open(import("std/fmt"));
G :: trait(
  g : (fn(generic(S : Type), inout(self) : Self, dummy : S) -> u64)
);
impl(
  i32,
  G(
    g : (fn(generic(S : Type), inout(self) : Self, dummy : S) -> u64)(u64(self))
  )
);
main :: (fn() -> unit)({
  println(`got ${i32(42).g(true)} want 42`);
  ();
});
export(main);
