// expect: E0911
// A holder over the block's own local `y` is the block's value: `y` drops at the block's end and `h` is read
// after it. The block's origin is computed after `y` left scope, so `h` holds nothing.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X), n : i32);
main :: (fn() -> unit)({
  h := {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    H(r : &y, n : i32(1))
  };
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
  ()
});
export(main);
