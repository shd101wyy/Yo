// expect: accept
// O3's canonical place write `v.xs = &y`: `h.r = &y` with `y` outliving `h`. Rejected with E0926,
// whose text says the left side is a READ of the reference.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
main :: (fn() -> unit)({
  z := mk();
  y := mk();
  mut(h) := H(r : &z, n : i32(0));
  h.r = &y;
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
});
export(main);
