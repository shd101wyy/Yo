// expect: accept
// Positive control: the await is bound first, so no operand of the call is held across it
// (OUT: the string, then OUT: 79).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
make :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
num :: (fn(io : Io) -> Impl(Future(usize, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    usize(7)
  })
);
use2 :: (fn(a : &String, b : usize) -> usize)({
  println(`OUT: ${a.*}`);
  (a.len() + b)
});
main :: (fn(io : Io) -> unit)({
  f := io.async((io : Io) => {
    n := io.await(num(io), io);
    use2(&make(), n)
  });
  println(`OUT: ${io.await(f, io).to_string()}`);
});
export(main);
