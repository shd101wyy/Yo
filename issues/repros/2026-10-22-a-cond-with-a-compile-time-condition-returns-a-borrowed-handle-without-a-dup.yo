// issues/fixed/2026-10-22-a-cond-with-a-compile-time-condition-returns-a-borrowed-handle-without-a-dup.md
// Expected: prints 5 twice. Actual: heap-use-after-free under
// `--sanitize address --allocator system`; `--optimize 2` aborts with
// "tcache_thread_shutdown(): unaligned tcache chunk detected".
{ println } :: import("std/fmt");
R :: ref(struct(n : i32));
rd :: (fn(q : &R) -> R)(
  cond(
    false => q,
    true => q
  )
);
main :: (fn() -> unit)({
  r := R(n : i32(5));
  x := rd(&r);
  println(&x.n);
  println(&r.n);
});
export(main);
