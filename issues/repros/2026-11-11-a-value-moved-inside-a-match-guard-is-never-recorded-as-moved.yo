// expect: E0901
// A match guard moves the outer local `a` into `take`; the move is never recorded,
// so `a` is dropped again at the end of `main` (double free).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
take :: (fn(s : String) -> bool)(s.len() > usize(0));
main :: (fn() -> unit)({
  a := String.from("payload-0123456789abcdefghijklmnop");
  r := match(i32(3), (n && (take(a))) => i32(1), _ => i32(2));
  println(`OUT r=${r.to_string()}`);
});
export(main);
