// expect: E0911
// `h` is assigned a reference into `x` in the first arm and into `y` in the second; only the
// second loan survives, so writing `x` is accepted. `flag()` is true at run time: the read of
// `h` is a heap-use-after-free.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
flag :: (fn() -> bool)(String.from("a").len() == usize(1));
main :: (fn() -> unit)({
  mut(x) := Box.new(L());
  mut(y) := Box.new(L());
  mut(h) := Option(&String).None;
  cond(
    flag() => {
      h = match(&x, Box(s) => Option(&String).Some(s));
    },
    true => {
      h = match(&y, Box(s) => Option(&String).Some(s));
    }
  );
  x = Box.new(String.from("q"));
  match(h, .Some(r) => println(`OUT: ${r.*}`), .None => ());
  ()
});
export(main);
