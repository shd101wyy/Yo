{ println } :: import("std/fmt");

S :: struct(n : i32);

count :: (fn(k : i32, s : &mut S) -> unit)({
  s.n = (s.n + i32(1));
  if(k > i32(0), {
    mut(local) := S(n : i32(0));
    recur(k - i32(1), &mut local);
    s.n = (s.n + local.n);
  });
});

main :: (fn() -> unit)({
  mut(s) := S(n : i32(0));
  count(i32(3), &mut s);
  println(&s.n);
});
export(main);
