{ println } :: import("std/fmt");
{ yield } :: import("std/async");
{ Exception, IoExn } :: import("std/error");
{ IoError } :: import("std/sys/errors");
_t :: (fn(x : i32, io : Io) -> Impl(Future(i32, IoExn)))(io.async((e : IoExn) => {
  e.io.await(yield(e.io), e.io);
  cond((x == i32(2)) => e.exn.throw(dyn(IoError.from_errno(i32(2)))), true => x)
}));
_run :: (fn(n : i32, io : Io) -> Impl(Future(i32, IoExn)))(io.async((e : IoExn) => {
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while((i < n), {
    t := e.io.await(_t(i, e.io), e);
    acc = (acc + t);
    i = (i + i32(1));
  });
  acc
}));
drive :: (fn(n : i32, io : Io) -> i32)({
  ex := Exception(throw : (_err -> { unwind(i32(-99)); }));
  io.await(_run(n, io), IoExn(io : io, exn : ex))
});
main :: (fn(io : Io) -> unit)({ println(drive(i32(1), io)); println(drive(i32(3), io)); println(drive(i32(0), io)); });
export(main);
