// expect: E0922 (the v0.2.77 wall, VERDICTS-57 §1; E0923 once v0.2.78 checks `static`, P12)
// A holder typed over static initialized with &b; b dropped while it is live.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
main :: (fn() -> unit)({
  b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  o := Option(&(Rc(X), static)).Some(&b);
  drop(b);
  match(o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
