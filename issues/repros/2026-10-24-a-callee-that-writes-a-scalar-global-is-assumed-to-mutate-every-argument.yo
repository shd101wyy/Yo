// issues/2026-10-24-a-callee-that-writes-a-scalar-global-is-assumed-to-mutate-every-argument.md
// Expected: prints 4 twice and exits 0. Actual: the first `label_*` call panics with
// "container operation while an interior reference ... borrows from it".
// `count_copy` only bumps an i32 global, yet its mutation mask is `all`, so each
// read-only `&self` method that passes `&self.name` to it gets the borrowed-`for`
// entry assert. Since fix/c7-readonly-iter-receiver the constructor-argument spelling
// (`label_ctor`) asserts too; before it only the plain spelling (`label_plain`) did.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ println } :: import("std/fmt");
W3 :: struct(s : String, n : usize);
(mut(g_n) : i32) = i32(0);
count_copy :: (fn(s : &String) -> String)({
  g_n = (g_n + i32(1));
  s.clone()
});
Bag :: ref(struct(items : ArrayList(i32), name : String));
impl(
  Bag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_ref : (fn(self : &Self, cur : &usize) -> &i32)(self.items.ptr().unwrap().add(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
impl(
  Bag,
  BorrowedWalkMut(
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)(self.items.ptr().unwrap().add(cur))
  )
);
impl(
  Bag,
  label_ctor : (fn(self : &Self) -> usize)({
    w := W3(s : count_copy(&self.name), n : usize(1));
    w.s.len()
  }),
  label_plain : (fn(self : &Self) -> usize)({
    s := count_copy(&self.name);
    s.len()
  })
);
main :: (fn() -> unit)({
  bag := Bag(items : ArrayList(i32).new(), name : String.from("ab"));
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  other := bag;
  mut(a) := usize(0);
  mut(b) := usize(0);
  for(&mut bag, x => {
    a = (a + other.label_ctor());
    b = (b + other.label_plain());
    x = (x + i32(1));
  });
  println(&a);
  println(&b);
});
export(main);
