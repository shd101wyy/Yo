{ println } :: import("std/fmt");
A :: trait(get : (fn(self : Self) -> i32));
B :: trait(get : (fn(self : Self) -> i32));
C :: ref(struct(n : i32));
impl(C, A(get : (self -> i32(1))));
impl(C, B(get : (self -> i32(2))));
main :: (fn() -> unit)({
  c := C(n : i32(0));
  println(`${c.get()}`);
});
export(main);
