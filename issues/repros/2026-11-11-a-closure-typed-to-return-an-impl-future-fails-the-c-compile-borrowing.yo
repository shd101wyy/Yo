// expect: accept
// The same with a borrowing future: the closure captures `&x` and its future borrows `x`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
main :: (fn(io : Io) -> unit)({
  x := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  (mk : Impl(Fn() -> Impl(Future(unit, Io)))) = ({ &x, io }() => io.async({ x }(io : Io) => {
    println(`OUT: ${x.*}`);
  }));
  f := mk();
  io.await(f, io);
});
export(main);
