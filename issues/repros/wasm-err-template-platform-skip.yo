//! Repro: `.Err(<template string interpolating comptime `platform`>)` emits
//! `/* skip generating value */` inside the C initializer under yo-self with
//! a wasm target — "error: expected expression" from emcc/clang.
//!   TS      + wasm target -> compiles, running prints the message
//!   yo-self + wasm target -> C compile error (the env.test.yo emcc-leg break)
//!   yo-self + native      -> fine (the arm is wasm-only via cond(platform…))
{ platform } :: import("std/process");
{ String } :: import("std/string/string");
open(import("std/fmt"));
f :: (fn() -> Result(unit, String))(
  .Err(`not supported on platform '${platform}'`)
);
main :: (fn() -> unit)({
  match(
    f(),
    .Ok(_) => println(`ok`),
    .Err(e) => println(`err: ${e}`)
  );
});
export(main);
