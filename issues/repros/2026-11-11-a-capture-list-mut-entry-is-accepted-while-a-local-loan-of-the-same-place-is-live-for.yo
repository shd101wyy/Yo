// expect: E0911
// Inside a read walk `for(&xs, e => ...)`, a closure literal with `{ m : &mut xs }` grows `xs`;
// the walk's element reference `e` dangles.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
run :: (fn(f : &mut Impl(FnMut() -> unit)) -> unit)(f());
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  xs.push(String.from("b"));
  for(&xs, e => {
    run(&mut ({ m : &mut xs }() => {
      mut(i) := i32(0);
      while(i < i32(1000), {
        m.push(String.from("z"));
        i = (i + i32(1));
      });
    }));
    println(`OUT: ${e.len().to_string()}`);
  });
});
export(main);
