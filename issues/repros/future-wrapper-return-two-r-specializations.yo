{ assert } :: import("std/assert");
open(import("std/string"));
open(import("std/fmt"));
Holder :: (fn(comptime(T) : Type) -> comptime(Type))(ref(struct(_value : T)));
impl(
  generic(T : Type),
  Holder(T),
  new : (fn(value : T) -> Self)(Self(_value : value)),
  apply_async_r : (fn(generic(R : Type), self : Self, body : Impl(Fn(inout(v) : T) -> R), io : Io) -> Impl(Future(R)))(
    io.async((io : Io) => {
      r := body(self._value);
      return(r);
    })
  )
);
main :: (fn(io : Io) -> unit)({
  h := Holder(i64).new(i64(10));
  s := io.await(h.apply_async_r((v) => `v=${v}`, io), io);
  n := io.await(h.apply_async_r((v) => (v + i64(1)), io), io);
  println(`${s} ${n}`);
});
export(main);
