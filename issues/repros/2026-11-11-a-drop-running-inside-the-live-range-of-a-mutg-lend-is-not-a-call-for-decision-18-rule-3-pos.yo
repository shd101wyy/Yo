// expect: accept
// Positive control: the `Drop` runs after `y`'s last use.
{ println } :: import("std/fmt");
mut(G) := i64(1);
_bump :: (fn() -> unit)({
  G = (G + i64(100));
});
D :: struct(n : i64);
impl(D, Drop(drop : (fn(self : &mut Self) -> unit)(_bump())));
main :: (fn() -> unit)({
  y := &G;
  w := y.*;
  v := y.*;
  {
    d := D(n : i64(1));
    _ := d.n;
  };
  println(`OUT: before=${w.to_string()} after=${v.to_string()} (expect equal)`);
});
export(main);
