// expect: E0923
// The same with a closure literal at an `Impl(Fn(...))` slot: the literal returns its SECOND parameter
// where the slot spells the result over the first.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mkr :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
apply :: (fn(f : &Impl(Fn(a : &Rc(X), b : &Rc(X)) -> Option(&(Rc(X), a))), x : &Rc(X), y : &Rc(X)) -> Option(&(Rc(X), x)))(f(x, y));
main :: (fn() -> unit)({
  a := mkr();
  mut(o) := Option(&Rc(X)).None;
  {
    b := mkr();
    o = apply(&((p : &Rc(X), q : &Rc(X)) => Option(&Rc(X)).Some(q)), &a, &b);
  };
  match(o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
});
export(main);
