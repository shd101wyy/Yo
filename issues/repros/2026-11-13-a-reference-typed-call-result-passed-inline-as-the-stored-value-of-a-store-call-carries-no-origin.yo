// expect: E0911
// `pick(&x.*.s)` is a `&String` call result passed INLINE as the stored value of `put(&mut h, …)`: its origin
// (`x`'s cell) is never compared with the slot `h` outlives `x` by. Binding the result first (`r := pick(..)`)
// is rejected with E0911; so are a bare `&x.*.s` and an `Option(&String)`-typed result passed inline.
// Accepted: `x`'s cell is freed at the block's end and the read after it is a heap-use-after-free.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
put :: (fn(generic(p : Origin), dst : &mut&(String, p), v : &(String, p)) -> unit)({
  dst.* = v;
});
pick :: (fn(a : &String) -> &String)(a);
main :: (fn() -> unit)({
  z := Rc.new(X(s : String.from("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")));
  mut(h) := &z.*.s;
  {
    x := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    put(&mut h, pick(&x.*.s));
  };
  println(`OUT: ${h.*.slice_copy(usize(0) .. usize(5))}`);
});
export(main);
