// expect: E0911
// The unsound neighbour: `replace` stores a reference to a block local into an outer slot. Today it is
// rejected for the wrong reason (E0912 inside std); after the fix it must be rejected at the caller.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ replace } :: import("std/mem");
main :: (fn() -> unit)({
  a := String.from("aaaa");
  mut(o) := Option(&String).Some(&a);
  {
    b := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
    _old := replace(&mut o, Option(&String).Some(&b));
  };
  match(o, .Some(r) => println(`OUT: ${r.*.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
