// A closure capturing `&mut slot` where `slot : Option(&i32)` holds a reference: valid; crashed codegen.
{ println } :: import("std/fmt");
run :: (fn(f : &mut Impl(FnMut() -> unit)) -> unit)(f());
main :: (fn() -> unit)({
  x := i32(7);
  mut(slot) := Option(&i32).Some(&x);
  run(
    &mut ({ s : &mut slot }() => {
      s.* = .None;
    })
  );
  println(`none=${slot.is_none().to_string()}`);
  ()
});
export(main);
