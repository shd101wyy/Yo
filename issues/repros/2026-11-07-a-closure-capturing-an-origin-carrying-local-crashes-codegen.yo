// H2e: the capture is a named holder struct rather than an Option local.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
S :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(o : Option(&(String, p))));
each :: (fn(f : &Impl(Fn(v : &String) -> unit)) -> unit)({
  k := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  f(&k);
});
main :: (fn() -> unit)({
  z0 := String.from("z");
  mut(s) := S(z0)(o : Option(&(String, z0)).None);
  each({ s : &mut s }(v : &String) => {
    s.o = .Some(v);
  });
  match(&s.o, .Some(r) => println(`OUT: ${r.*.len().to_string()} ${r.*.slice_copy(usize(0) .. usize(5))}`), .None => println("none"));
  ()
});
export(main);
