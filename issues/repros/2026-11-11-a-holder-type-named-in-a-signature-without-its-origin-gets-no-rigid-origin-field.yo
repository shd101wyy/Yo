// expect: E0923
// The holder nested in another struct's field: `dst : &mut W` with `W :: struct(h : H, …)`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
W :: struct(h : H, m : i32);
stash :: (fn(dst : &mut W, h : H) -> unit)({ dst.h = h; });
main :: (fn() -> unit)({
  a := mk();
  mut(w) := W(h : H(r : &a, n : i32(0)), m : i32(0));
  {
    y := mk();
    stash(&mut w, H(r : &y, n : i32(0)));
  };
  println(`OUT: ${w.h.r.*.*.s.len().to_string()}`);
});
export(main);
