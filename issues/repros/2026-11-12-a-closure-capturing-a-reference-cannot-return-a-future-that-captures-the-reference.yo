// expect: accept. A local closure captures `&x` and returns a future that
// captures the same reference; the future lives inside `main`, beside `x`.
// develop 4f8f975b3: E0912 "the origin names a local of this function".
{ String } :: import("std/string");
{ println } :: import("std/fmt");
LONG :: "0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz";
main :: (fn(io : Io) -> unit)({
  x := String.from(LONG);
  (mk : Impl(Fn() -> Impl(Future(unit, Io)))) = ({ &x, io }() => io.async({ x }(io : Io) => {
    println(`OUT: ${x.*}`);
  }));
  f := mk();
  io.await(f, io);
});
export(main);
