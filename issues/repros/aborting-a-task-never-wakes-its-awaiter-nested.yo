{ eprintln } :: import("std/fmt");
{ sleep } :: import("std/sys/timer");
g_fn :: (fn(io : Io) -> Impl(Future(i32, Io)))(io.async((io : Io) => {
  io.await(sleep(u64(30)), io);
  i32(3)
}));
main :: (fn(io : Io) -> unit)({
  f := io.async((io : Io) => {
    x := io.await(g_fn(io), io);
    (x + i32(4))
  });
  hf := io.spawn(f, io);
  a := io.async((io : Io) => {
    v := io.await(f, io);
    eprintln(`a: got ${v}`);
    v
  });
  ha := io.spawn(a, io);
  hf.abort();
  eprintln(`main: aborted f`);
  ra := ha.await(io);
  eprintln(`main: ra is_none=${ra.is_none()}`);
  rf := hf.await(io);
  eprintln(`main: done`);
});
export(main);
