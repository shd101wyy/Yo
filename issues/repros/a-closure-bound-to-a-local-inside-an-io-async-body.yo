// A `=>` closure bound to a typed local inside an `io.async` body emits
// invalid C (issues/fixed/a-closure-bound-to-a-local-inside-an-io-async-body-emits-invalid-c.md).
// The same binding in a plain fn (`h`) compiles and runs.
{ println } :: import("std/fmt");
g :: (fn(io : Io, n : i32) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    (f : Impl(Fn(v : i32) -> i32)) = (v => (v + n));
    f(n)
  })
);
h :: (fn(n : i32) -> i32)({
  (f : Impl(Fn(v : i32) -> i32)) = (v => (v + n));
  f(n)
});
main :: (fn(io : Io) -> unit)({
  v := io.await(g(io, i32(1)), io);
  println(`result: ${v} ${h(i32(3))}`);
});
export(main);
