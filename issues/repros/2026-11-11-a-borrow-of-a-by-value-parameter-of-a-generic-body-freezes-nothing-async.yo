// expect: E0911
// The future form: a trait method's borrowing future over the generic body's by-value `t`;
// `t` is moved before the await (heap-use-after-free).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
Show :: trait(show : (fn(self : &Self, io : Io) -> Impl(Future(unit, Io))));
W :: struct(s : String);
impl(
  W,
  Show(
    show : (fn(self : &Self, io : Io) -> Impl(Future(unit, Io)))(
      io.async({ self : &self.* }(io : Io) => {
        io.await(yield(io), io);
        println(`OUT: ${self.*.s}`);
      })
    )
  )
);
consume_t :: (fn(generic(T : Type), v : T) -> unit)(());
run :: (fn(generic(T : Type), t : T, io : Io, where(T <: Show)) -> unit)({
  f := t.show(io);
  consume_t(t);
  io.await(f, io);
});
main :: (fn(io : Io) -> unit)({
  run(W(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")), io);
});
export(main);
