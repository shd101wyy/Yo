{ println } :: import("std/fmt");
// NOTE, not a defect — see the issue doc of the same name. Every assignment
// emits a "Save old value for later use" temp before the store, which is BY
// DESIGN: for a reference-counted old value that temp is what the deferred
// drop reads. When the old value needs no drop the temp is dead, and clang
// removes it at -O2, so there is nothing to recover at run time.
//
// Kept as a reproducer only so the shape is easy to re-inspect:
//
//   yo compile <this file> --optimize 2 --emit-c --skip-c-compiler
//   grep -c 'Save old value' <out>.c        # 8, for the four lines below
//
main :: (fn() -> unit)({
  a := Array(i32, usize(4)).fill(i32(7));
  (i : usize) = usize(0);
  while(i < usize(4), {
    a(i) = i32(1);
    i = (i + usize(1));
  });
  println(`${a(usize(0))}`);
});
export(main);
