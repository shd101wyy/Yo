// expect: E0911
// `set(&mut r, &inner)` unifies `p` over `r`'s referent and `inner`, and the callee re-points `r` at
// `inner`; `r`'s flow set is not widened, so its read after `inner` dies is accepted (heap-use-after-free).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
set :: (fn(generic(p : Origin), dst : &mut &(Rc(X), p), v : &(Rc(X), p)) -> unit)({ dst.* = v; });
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  {
    inner := mk();
    set(&mut r, &inner);
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
