// expect: accept
// A closure bound as `Impl(Fn() -> Impl(Future(unit, Io)))` whose body returns an `io.async`
// future passes `yo check`; the C compile fails (`void *` initialized with the capture struct).
{ println } :: import("std/fmt");
main :: (fn(io : Io) -> unit)({
  (mk : Impl(Fn() -> Impl(Future(unit, Io)))) = ({ io }() => io.async((io : Io) => {
    println("OUT: ran");
  }));
  f := mk();
  io.await(f, io);
});
export(main);
