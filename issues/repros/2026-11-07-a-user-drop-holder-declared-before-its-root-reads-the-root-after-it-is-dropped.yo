{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
impl(
  X,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      println("OUT: X dropped");
    })
  )
);
H :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p)));
impl(
  generic(p : Origin),
  H(p),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      n := self.r.*.*.s.len();
      println(`OUT: H dropped, read len ${n.to_string()}`);
    })
  )
);
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  mut(h) := Option(H(x)).None;
  y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  h = .Some(H(y)(r : &y));
  println("OUT: end of main");
  ()
});
export(main);
