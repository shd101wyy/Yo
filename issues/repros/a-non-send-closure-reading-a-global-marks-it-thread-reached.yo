{ println } :: import("std/fmt");
{ yield } :: import("std/async");
(g_counter : i32) = i32(0);
main :: (fn(io : Io) -> unit)({
  t1 := io.async((io : Io) => { io.await(yield(io), io); g_counter = (g_counter + i32(1)); });
  t2 := io.async((io : Io) => { io.await(yield(io), io); g_counter = (g_counter + i32(2)); });
  h1 := io.spawn(t1, io);
  h2 := io.spawn(t2, io);
  _ := h1.await(io);
  _ := h2.await(io);
  println(`counter=${g_counter} (expect 3)`);
});
export(main);
