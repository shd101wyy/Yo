// expect: accept (no drop: the right side moves the old value into the store)
// `x = x` saves the old bytes, stores x into itself and drops the saved copy:
// `x` keeps the freed buffer, read by the println (heap-use-after-free).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(x) := String.from("payload-0123456789abcdefghijklmnop");
  x = x;
  println(`OUT ${x}`);
});
export(main);
