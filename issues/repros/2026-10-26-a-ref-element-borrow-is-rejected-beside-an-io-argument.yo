{ ArrayList } :: import("std/collections/array_list");
io :: __yo_builtin_io;
_a2_plain :: (fn(c : &mut i32, io : Io) -> unit)({ c = (c + i32(1)); });
export(main);
main :: (fn() -> unit)(
  begin(
    xs := ArrayList(i32).new(),
    xs.push(i32(1)),
    _a2_plain(&mut xs(usize(0)), io),
    ()
  )
);
