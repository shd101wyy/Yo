pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ println } :: import("std/fmt");
pick :: (fn(s : &String) -> Option(&String))(.Some(s));
main :: (fn() -> unit)({
  y := String.from("hello");
  n := pick(&y).unwrap().len();
  println(`${n.to_string()}`);
  k := pick(&y).unwrap();
  println(`${k.*.len().to_string()}`);
  m := pick(&y).unwrap();
  println(`${m.len().to_string()}`);
  ()
});
export(main);
