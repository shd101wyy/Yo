{ println } :: import("std/fmt");

// `Array(T, N).fill` takes `comptime(val) : T`. A LITERAL satisfies it, even
// inside a generic function (see the `ok` arm). A value produced by a
// GENERIC-DISPATCHED trait call does not — even when `T` is bounded
// `Comptime` and the concrete `T`'s `default()` is itself a comptime
// constant. It compiles rc=0 and aborts at runtime as an FTT stub.
//
// This is what blocks `Array(T, N)`'s `Default`.
// WORKS: literal fill value inside the same generic shape.
ok :: (fn(generic(T : Type), x : T, where(T <: (Default, Comptime))) -> Array(i32, usize(3)))(
  Array(i32, usize(3)).fill(i32(0))
);

// FTT STUB: identical shape, fill value from `T.default()`.
broken :: (fn(generic(T : Type), x : T, where(T <: (Default, Comptime))) -> Array(T, usize(3)))(
  Array(T, usize(3)).fill(T.default())
);

main :: (fn() -> unit)({
  println(`${ok(i32(0)).len()}`);
  println(`${broken(i32(0)).len()}`);
});
export(main);

// Controls that make the isolation airtight — all three COMPILE AND RUN, so
// neither `fill`, nor a generic element type, nor the bound is the cause:
//
//   passthrough :: (fn(generic(T : Type), a : Array(T, usize(3))) -> Array(T, usize(3)))(a);
//   explicit    :: (fn(generic(T : Type), x : T, where(T <: (Default, Comptime))) -> Array(T, usize(3)))(Array(T, usize(3))(x, x, x));
//   literal     :: (fn(generic(T : Type), x : T, where(T <: Comptime)) -> Array(T, usize(3)))(Array(T, usize(3)).fill(T(0)));
//
// Only the TRAIT-DISPATCHED value `T.default()` fails.
