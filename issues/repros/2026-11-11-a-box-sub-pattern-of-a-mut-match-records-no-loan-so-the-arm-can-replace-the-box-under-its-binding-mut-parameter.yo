// expect: E0911
// The scrutinee is a `&mut` parameter: `.Some(Box(s))` binds below the box, the arm writes
// `r.* = .None` and reads `s`: heap-use-after-free.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
f :: (fn(r : &mut Option(Box(String))) -> unit)(
  match(
    r,
    .Some(Box(s)) => {
      r.* = .None;
      println(`OUT: ${s}`);
    },
    .None => ()
  )
);
main :: (fn() -> unit)({
  mut(o) := Option(Box(String)).Some(Box.new(L()));
  f(&mut o);
  ()
});
export(main);
