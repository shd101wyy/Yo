pragma(Pragma.AllowUnsafe);
{ println } :: import("std/fmt");
Tag :: trait(tag : (fn(self : &Self) -> i32));
Cat :: struct(n : i32);
impl(generic(T : Type), *T, Tag(tag : ((self : &Self) -> i32(7))));
main :: (fn() -> unit)({
  c := Cat(n : i32(1));
  (t : Dyn(Tag)) = dyn(addr_of(c));
  x := t.tag();
  println(&x);
});
export(main);
