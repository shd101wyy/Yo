// expect: accept
// The scrutinee form: `match(&mk_opt(), ...)` lends a temporary; the arm binding `r` is read
// after an await inside the arm.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
make :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
num :: (fn(io : Io) -> Impl(Future(usize, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    usize(7)
  })
);
mk_opt :: (fn() -> Option(String))(.Some(make()));
main :: (fn(io : Io) -> unit)({
  f := io.async((io : Io) => {
    match(&mk_opt(), .Some(r) => {
      io.await(yield(io), io);
      println(`OUT: ${r.*}`);
    }, .None => ());
  });
  io.await(f, io);
});
export(main);
