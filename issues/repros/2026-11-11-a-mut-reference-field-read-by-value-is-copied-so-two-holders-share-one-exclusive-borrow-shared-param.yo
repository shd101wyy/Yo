// expect: E0908
// No derive: a plain function copies the `&mut` field out through its `&M` parameter.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
M :: struct(r : &mut Box(X), n : i32);
H :: struct(p : &X);
big :: (fn() -> Box(X))(Box.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
dup :: (fn(m : &M) -> M)(M(r : m.r, n : m.n));
main :: (fn() -> unit)({
  mut(x) := big();
  m := M(r : &mut x, n : i32(0));
  m2 := dup(&m);
  h := H(p : &m.r.*.*);
  m2.r.* = Box.new(X(s : String.from("b")));
  println(`OUT: ${h.p.*.s.len().to_string()}`);
});
export(main);
