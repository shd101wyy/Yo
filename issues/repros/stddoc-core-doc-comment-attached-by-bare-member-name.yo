//! Probe module.
/// A plain value struct.
Vs :: struct(x : i32);
impl(
  Vs,
  /// Make one.
  new : (fn(x : i32) -> Self)(Self(x)),
  /// Read it.
  get : (fn(self : Self) -> i32)(self.x)
);
/// A ref struct.
Rs :: ref(struct(y : i32));
impl(
  Rs,
  /// Make a ref one.
  new : (fn(y : i32) -> Self)(Self(y))
);
/// A top-level function.
tl :: (fn(a : i32) -> i32)(a);
export(Vs, Rs, tl);
