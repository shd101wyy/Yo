// expect: E0910
// Two arguments of one call are each a CALL RESULT that carries a `&mut` loan of `x`
// (`idm` returns its `&mut` parameter). Neither argument is a by-name lend at the outer
// call and no binding holds either loan, so nothing compares them: `both` receives two
// live `&mut` to one place, clears it through one and reads the freed payload through
// the other.
//   yo compile <this> --optimize 1 --sanitize address --allocator system -o t && ./t
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
idm :: (fn(r : &mut Option(Rc(X))) -> &mut Option(Rc(X)))(&mut r.*);
both :: (fn(a : &mut Option(Rc(X)), b : &mut Option(Rc(X))) -> usize)(
  match(
    a,
    .Some(p) => {
      b.* = .None;
      p.*.s.len()
    },
    .None => usize(0)
  )
);
mk :: (fn() -> Option(Rc(X)))(
  .Some(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))))
);
main :: (fn() -> unit)({
  mut(x) := mk();
  n := both(idm(&mut x), idm(&mut x));
  println(`OUT: ${n.to_string()}`);
  ()
});
export(main);
