// expect: accept
// No `&` expression at all: a callee stores its reference parameter into the holder's field, both typed
// over one spelled origin `p`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
G :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p), n : i32));
set :: (fn(generic(p : Origin), h : &mut G(p), v : &(Rc(X), p)) -> unit)({
  h.r = v;
});
main :: (fn() -> unit)({
  z := mk();
  y := mk();
  mut(h) := G((z, y))(r : &z, n : i32(0));
  set(&mut h, &y);
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
});
export(main);
