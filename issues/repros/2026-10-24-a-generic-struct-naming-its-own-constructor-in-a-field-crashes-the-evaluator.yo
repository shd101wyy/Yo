pragma(Pragma.AllowUnsafe);
{ println } :: import("std/fmt");
Link :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    value : T,
    next : Option(*Link(T))
  )
);
main :: (fn() -> unit)({
  (x : Option(*Link(i32))) = .None;
  println(&x.is_some());
});
export(main);
