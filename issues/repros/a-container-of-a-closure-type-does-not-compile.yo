{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  (k : Impl(Fn() -> unit)) = (
    () => {
      println("ran");
    }
  );
  ks := ArrayList(typeof(k)).new();
  ks.push(k);
  match(ks.get(usize(0)), .Some(g0) => g0(), .None => ());
});
export(main);
