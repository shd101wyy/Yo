// expect: E0910
// The std form: `xs.fill(xs.index(usize(0)))` lends `xs` `&mut` as the receiver and passes a
// reference into `xs`'s own element as the value. `fill` overwrites element 0 (dropping it)
// and then clones the dropped value into the later slots: heap-use-after-free.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(String.from("hello-world-hello-world-hello-world"));
  xs.push(String.from("second-second-second-second-second"));
  xs.fill(xs.index(usize(0)));
  println(`OUT: ${xs(usize(1))}`);
});
export(main);
