// Reproducer: issues/fixed/ftt-stub-in-live-closure-falls-off-non-void-function.md
//
// The open half after 2026-10-17: an UNANNOTATED `io.async((e) => …)` with no
// expected type. The call binds `E := Io` in the callee env (Step 6b-nested),
// so the body is checked with `e : Io` and fails with E0610, but Channel 3
// judged the raw `E` abstract and swallowed the error into the hollow-body
// registry, which only codegen reads:
//
//   yo check   this.yo                     -> rc=0, "evaluator OK"   (before)
//   yo compile this.yo --skip-c-compiler   -> rc=1, E0610 at 19:6
//
// Fixed: `check` reports the same E0610.
{ HashSet } :: import("std/collections/hash_set");
{ println } :: import("std/fmt");

main :: (fn(io : Io) -> unit)({
  f := io.async(e => {
    s := HashSet(usize).new();
    s.no_such_method_at_all(usize(1));
    usize(7)
  });
  v := io.await(f, io);
  println(&v);
});
export(main);
