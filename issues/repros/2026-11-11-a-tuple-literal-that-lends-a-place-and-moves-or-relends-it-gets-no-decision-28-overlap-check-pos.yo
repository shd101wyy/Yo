// expect: accept
// Positive control: two `&` lends of one place in one tuple are compatible.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  x := Box.new(L());
  match((&x, &x), (a, b) => println(`OUT: ${a.*.*} ${b.*.*}`));
  ()
});
export(main);
