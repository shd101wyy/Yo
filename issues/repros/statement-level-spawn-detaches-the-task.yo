// A statement-level `io.spawn` must DETACH its task, which frees its own state
// machine when it finishes. Parked here from tests/async/sm_protocol.test.yo:
// it needs the OWNING JoinHandle (a `ref` struct whose Dispose releases the
// future), which std can use only once SEED_VERSION carries the codegen.
// Restore it to the suite with the flip:
// issues/join-handle-ownership-waits-for-the-seed.md.
//
//   yo compile issues/repros/statement-level-spawn-detaches-the-task.yo --optimize 2 -o a.out && ./a.out
//   → "detached tasks freed: 20" (the value-form JoinHandle prints 0)
pragma(Pragma.AllowUnsafe);
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
(g_disposed : i32) = i32(0);
Thing :: ref(struct(n : i32));
impl(
  Thing,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      g_disposed = (g_disposed + i32(1));
    })
  )
);
main :: (fn(io : Io) -> unit)({
  (i : i32) = i32(0);
  while(runtime(i < i32(20)), {
    io.spawn(
      io.async((io : Io) => {
        io.await(yield(io), io);
        Thing(n : i)
      }),
      io
    );
    i = (i + i32(1));
  });
  (spins : i32) = i32(0);
  while(runtime((g_disposed < i32(20)) && (spins < i32(100))), {
    io.await(yield(io), io);
    spins = (spins + i32(1));
  });
  println(`detached tasks freed: ${g_disposed}`);
});
export(main);
