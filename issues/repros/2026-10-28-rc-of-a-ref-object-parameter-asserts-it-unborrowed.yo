// issues/2026-10-28-rc-of-a-ref-object-parameter-asserts-it-unborrowed.md
// Expected: prints 4, rc 0. Actual (develop 49aca7a72 and earlier): the
// borrowed-for entry-assert panic, rc 134.
pragma(Pragma.AllowUnsafe);
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
VBag :: ref(struct(items : ArrayList(i32)));
impl(
  VBag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_ref : (fn(self : &Self, cur : &usize) -> &i32)(self.items.ptr().unwrap().add(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
impl(
  VBag,
  BorrowedWalkMut(
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)(self.items.ptr().unwrap().add(cur))
  )
);
keep_rc :: (fn(b : VBag) -> Rc(VBag))(rc(b));
main :: (fn() -> unit)({
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  bag := VBag(items : xs);
  other := bag;
  mut(seen) := usize(0);
  for(&mut bag, x => {
    kept := keep_rc(other);
    seen = (seen + kept.*.items.len());
    x = (x * i32(10));
  });
  println(&seen);
});
export(main);
