{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
S :: struct(x : usize, (xs : ArrayList(usize)) ?= ArrayList(usize).new());
make :: (fn() -> S)(S(x : usize(7)));
main :: (fn() -> unit)({
  s := make();
  n := s.xs.len();
  println(s.x.to_string() + n.to_string());
  ()
});
export(main);
