open(import("std/string"));
open(import("std/fmt"));
{ Exception, IoExn, AnyError } :: import("std/error");
{ yield } :: import("std/async");

Kind :: enum(Exe, Lib);
// A mutable local REASSIGNED from a template string inside a match arm that
// also awaits, in an async body — the shape `execute_node` uses for
// `description = `compile ${kind_label} ${artifact.name}``.
probe :: (fn(k : Kind, io : Io, exn : Exception) -> Impl(Future(String, IoExn)))(
  io.async((e : IoExn) => {
    description := String.from("start");
    name := String.from("thing");
    match(
      k,
      .Exe => {
        label := String.from("exe");
        description = `compile ${label} ${name}`;
        e.io.await(yield(e.io), e.io);
      },
      .Lib => {
        label := String.from("lib");
        description = `compile ${label} ${name}`;
        e.io.await(yield(e.io), e.io);
      }
    );
    return(description);
  })
);

main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      (err) -> {
        eprintln(err.to_string());
        unwind();
      }
    )
  );
  println(io.await(probe(Kind.Exe, io, exn), IoExn(io : io, exn : exn)));
  println(io.await(probe(Kind.Lib, io, exn), IoExn(io : io, exn : exn)));
});
export(main);
