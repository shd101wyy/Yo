{ eprintln } :: import("std/fmt");
{ yield } :: import("std/async");
{ sleep } :: import("std/sys/timer");
main :: (fn(io : Io) -> unit)({
  shared := io.async((io : Io) => {
    io.await(sleep(u64(20)), io);
    i32(7)
  });
  a := io.async((io : Io) => {
    v := io.await(shared, io);
    eprintln(`a got ${v}`);
    v
  });
  b := io.async((io : Io) => {
    v := io.await(shared, io);
    eprintln(`b got ${v}`);
    v
  });
  ha := io.spawn(a, io);
  hb := io.spawn(b, io);
  ra := ha.await(io);
  eprintln(`ra done`);
  rb := hb.await(io);
  eprintln(`rb done`);
});
export(main);
