// expect: E0908
// `poke` borrows `e` read-only, yet the arm writes through the `&mut` payload it binds.
{ println } :: import("std/fmt");
X :: struct(n : i32);
E :: enum(V(r : &mut X), Z);
poke :: (fn(e : &E) -> unit)(
  match(
    e,
    .V(r) => {
      r.n = i32(5);
    },
    .Z => ()
  )
);
main :: (fn() -> unit)({
  mut(x) := X(n : i32(1));
  e := E.V(r : &mut x);
  poke(&e);
  println(`OUT: ${match(e, .V(r) => r.n, .Z => i32(0)).to_string()}`);
});
export(main);
