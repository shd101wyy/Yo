// expect: accept (accepted today: the argument form of the same lend)
{ String } :: import("std/string");
{ println } :: import("std/fmt");
H := String.from("0123456789abcdefghijklmnopqrstuvwxyz");
_len :: (fn(s : &String) -> usize)(s.len());
main :: (fn() -> unit)({
  n := _len(&H);
  println(`OUT: ${n.to_string()}`);
});
export(main);
