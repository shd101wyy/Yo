{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
main :: (fn() -> unit)({
  println(`ArrayList(i32): ${Type.impls(ArrayList(i32), Comptime)}`);
  println(`String: ${Type.impls(String, Comptime)}`);
  println(`HashMap(i32,i32): ${Type.impls(HashMap(i32, i32), Comptime)}`);
  println(`Box(i32): ${Type.impls(Box(i32), Comptime)}`);
  println(`Rc(i32): ${Type.impls(Rc(i32), Comptime)}`);
  println(`i32: ${Type.impls(i32, Comptime)}`);
});
export(main);
