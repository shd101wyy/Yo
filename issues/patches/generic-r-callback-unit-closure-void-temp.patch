+      ctl_generic_ret => false,
+      is_some_type(result_type) => {
+        ou_rts := get_type_string(result_type, context.base);
+        (ou_rts == `void`) || ((ou_rts == `void*`) && is_unit_type(ei.ty))
+      },
+      true => false
+    );
+    if(ou_result_is_void, {
