{ assert } :: import("std/assert");
// Regression tests for closure-capture RC leak.
//
// See: issues/closure-capture-rc-value-leak.md
//
// These tests pass under AddressSanitizer (`./yo-cli test ... --sanitize address`).
// The bug was that generic Iterator combinators that take `f: F` by value
// (where F is forall-typed with a Fn trait constraint) did not call
// `___drop(f)` at function exit, leaking the closure's captured RC values.
pragma(Pragma.AllowUnsafe);
open(import("std/collections/array_list"));
open(import("std/string"));
// Combinator chains consume value iterators via `coll.into_iter()` —
// each element is yielded by value, so the closure parameter binds
// directly without a `.*` deref.
test("for_each with ArrayList capture does not leak", {
  out := array_list(i32(0));
  out.clear();
  src := array_list(i32(1), i32(2), i32(3), i32(4));
  src.into_iter().for_each((x) => {
    out.push(x);
  });
  assert(out.len() == usize(4), "out len=4");
});
test("for_each with String capture does not leak", {
  buf := array_list(`x`);
  buf.clear();
  src := array_list(i32(10), i32(20), i32(30));
  src.into_iter().for_each((x) => {
    consume(x);
    buf.push(`item`);
  });
  assert(buf.len() == usize(3), "buf len=3");
});
test("fold with RC accumulator does not leak", {
  src := array_list(i32(1), i32(2), i32(3));
  result := src.into_iter().fold(array_list(i32(0)), (acc, x) => {
    acc.push(x);
    acc
  });
  // result has 1 initial 0 + 3 pushed = 4 elements
  assert(result.len() == usize(4), "fold acc len=4");
});
test("any with RC capture does not leak", {
  needle := array_list(i32(7));
  src := array_list(i32(1), i32(5), i32(7), i32(9));
  found := src.into_iter().any((x) => (x == needle(usize(0))));
  assert(found, "found 7");
});
test("all with RC capture does not leak", {
  bound := array_list(i32(100));
  src := array_list(i32(1), i32(2), i32(3));
  ok := src.into_iter().all((x) => (x < bound(usize(0))));
  assert(ok, "all < 100");
});
test("for_each early break via short list", {
  out := array_list(i32(0));
  out.clear();
  empty := array_list(i32(0));
  empty.clear();
  empty.into_iter().for_each((x) => {
    out.push(x);
  });
  assert(out.len() == usize(0), "empty for_each leaves out empty");
});
test("any short-circuit drops capture", {
  side := array_list(i32(0));
  side.clear();
  src := array_list(i32(1), i32(2), i32(3), i32(4), i32(5));
  found := src.into_iter().any((x) => {
    side.push(x);
    x == i32(2)
  });
  assert(found, "found 2");
  // 'any' short-circuits on first match; side has [1, 2]
  assert(side.len() == usize(2), "short-circuit visited 2 elements");
});
