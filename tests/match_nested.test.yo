//! Nested variant patterns (plans/reference/MATCH_PATTERN_MATCHING.md P2): a
//! sub-pattern of a variant payload may itself be a variant pattern, at any
//! depth, positional or labeled, with literals inside, on runtime and
//! compile-time scrutinees.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
import("std/fmt");
Inner :: enum(A(x : i32), B);
derive(Inner, Copy, Clone);
Outer :: enum(Ok(v : Inner), Err(code : i32));
Deep :: enum(Wrap(o : Outer), Flat);
test("nested variant patterns select by the inner variant", {
  f :: (fn(o : Outer) -> i32)(
    match(
      o,
      .Ok(.A(x)) => x,
      .Ok(.B) => i32(-1),
      .Err(c) => (c * i32(10))
    )
  );
  assert(f(Outer.Ok(Inner.A(7))) == i32(7));
  assert(f(Outer.Ok(Inner.B)) == i32(-1));
  assert(f(Outer.Err(3)) == i32(30));
});
test("Option of Option", {
  g :: (fn(a : Option(Option(i32))) -> i32)(
    match(
      a,
      .Some(.Some(v)) => v,
      .Some(.None) => i32(-1),
      .None => i32(-2)
    )
  );
  assert(g(Option(Option(i32)).Some(Option(i32).Some(5))) == i32(5));
  assert(g(Option(Option(i32)).Some(Option(i32).None)) == i32(-1));
  assert(g(Option(Option(i32)).None) == i32(-2));
});
test("three levels deep, with a literal at the bottom", {
  h :: (fn(d : &Deep) -> i32)(
    match(
      d,
      .Wrap(.Ok(.A(0))) => i32(100),
      .Wrap(.Ok(.A(x))) => x,
      .Wrap(.Ok(.B)) => i32(-1),
      .Wrap(.Err(c)) => (c + i32(1000)),
      .Flat => i32(0)
    )
  );
  assert(h(Deep.Wrap(Outer.Ok(Inner.A(0)))) == i32(100));
  assert(h(Deep.Wrap(Outer.Ok(Inner.A(9)))) == i32(9));
  assert(h(Deep.Wrap(Outer.Ok(Inner.B))) == i32(-1));
  assert(h(Deep.Wrap(Outer.Err(5))) == i32(1005));
  assert(h(Deep.Flat) == i32(0));
});
test("nested patterns in labeled and curly slots", {
  k :: (fn(o : Outer) -> i32)(
    match(
      o,
      .Ok(v : .A(x)) => (x + i32(1)),
      .Ok({ v : .B }) => i32(-1),
      .Err({ code }) => code
    )
  );
  assert(k(Outer.Ok(Inner.A(1))) == i32(2));
  assert(k(Outer.Ok(Inner.B)) == i32(-1));
  assert(k(Outer.Err(42)) == i32(42));
});
test("a wildcard inside a nested payload", {
  any_a :: (fn(o : Outer) -> bool)(
    match(
      o,
      .Ok(.A(_)) => true,
      _ => false
    )
  );
  assert(any_a(Outer.Ok(Inner.A(3))));
  assert(!any_a(Outer.Ok(Inner.B)));
  assert(!any_a(Outer.Err(0)));
});
test("compile-time scrutinee: the nested arm is selected at compile time", {
  K :: Outer.Ok(Inner.A(7));
  r :: match(
    K,
    .Ok(.A(x)) => x,
    _ => i32(0)
  );
  assert(r == i32(7));
  K2 :: Outer.Ok(Inner.B);
  r2 :: match(
    K2,
    .Ok(.A(x)) => x,
    .Ok(.B) => i32(-1),
    .Err(_) => i32(-2)
  );
  assert(r2 == i32(-1));
});
Pair :: enum(Two(a : Option(String), b : i32), Zero);
test("reference-semantics payloads bound through a nested pattern", {
  total :: (fn(p : &Pair) -> usize)(
    match(
      p,
      .Two(.Some(s), n) => (s.len() + usize(n)),
      .Two(.None, n) => usize(n),
      .Zero => usize(0)
    )
  );
  assert(total(Pair.Two(Option(String).Some(`hello`), 2)) == usize(7));
  assert(total(Pair.Two(Option(String).None, 4)) == usize(4));
  assert(total(Pair.Zero) == usize(0));
});
List :: ref(enum(Nil, Cons(head : i32, tail : Rc(Self))));
test("a nested variant pattern through an Rc payload", {
  f :: (fn(l : &List) -> i32)(
    match(
      l,
      .Cons(1, Rc(.Cons(n, _))) => n,
      .Cons(h, _) => h,
      .Nil => i32(0)
    )
  );
  assert(f(List.Cons(1, rc(List.Cons(2, rc(List.Nil))))) == i32(2));
  assert(f(List.Cons(3, rc(List.Nil))) == i32(3));
  assert(f(List.Nil) == i32(0));
});
test("two levels through Rc payloads", {
  sum_boxed :: (fn(b : &Rc(List)) -> i32)(
    match(
      b,
      Rc(.Cons(h, _)) => h,
      Rc(.Nil) => i32(-2)
    )
  );
  g :: (fn(l : &List) -> i32)(
    match(
      l,
      .Cons(1, Rc(.Cons(2, Rc(.Cons(n, _))))) => n,
      .Cons(_, t) => sum_boxed(&t),
      .Nil => i32(-1)
    )
  );
  assert(g(List.Cons(1, rc(List.Cons(2, rc(List.Cons(3, rc(List.Nil))))))) == i32(3));
  assert(g(List.Cons(9, rc(List.Cons(8, rc(List.Nil))))) == i32(8));
  assert(g(List.Nil) == i32(-1));
});
test("a literal sub-pattern through an Rc payload", {
  Cell :: enum(Value(v : Rc(i32)), Empty);
  h :: (fn(c : &Cell) -> i32)(
    match(
      c,
      .Value(Rc(42)) => i32(1),
      .Value(_) => i32(2),
      .Empty => i32(0)
    )
  );
  assert(h(Cell.Value(rc(i32(42)))) == i32(1));
  assert(h(Cell.Value(rc(i32(7)))) == i32(2));
  assert(h(Cell.Empty) == i32(0));
});
test("an or-pattern through an Rc payload", {
  k :: (fn(l : &List) -> i32)(
    match(
      l,
      (.Nil | .Cons(0, Rc(.Nil))) => i32(0),
      .Cons(h, _) => h,
      _ => i32(-1)
    )
  );
  assert(k(List.Nil) == i32(0));
  assert(k(List.Cons(0, rc(List.Nil))) == i32(0));
  assert(k(List.Cons(5, rc(List.Nil))) == i32(5));
});
test("whole-value binding of the Rc position still binds the Rc", {
  inner_kind :: (fn(b : &Rc(List)) -> i32)(
    match(
      b.*,
      (rest := .Nil) => i32(100),
      _ => i32(101)
    )
  );
  m :: (fn(l : &List) -> i32)(
    match(
      l,
      .Cons(_, t) => inner_kind(&t),
      .Nil => i32(0)
    )
  );
  assert(m(List.Cons(2, rc(List.Nil))) == i32(100));
  assert(m(List.Cons(1, rc(List.Cons(9, rc(List.Nil))))) == i32(101));
  assert(m(List.Nil) == i32(0));
});
test("an Rc scrutinee takes nested patterns directly", {
  n :: (fn(b : &Rc(List)) -> i32)(
    match(
      b,
      Rc(.Cons(h, _)) => h,
      Rc(.Nil) => i32(-1)
    )
  );
  assert(n(rc(List.Cons(7, rc(List.Nil)))) == i32(7));
  assert(n(rc(List.Nil)) == i32(-1));
});
// Wrapper patterns (plans/VALUES_BY_DEFAULT.md decision 31): `Rc(p)` and
// `Arc(p)` name the cell a pattern looks through.
Tree :: enum(Leaf(n : i32), Node(l : Rc(Self), r : Rc(Self)));
test("Rc(p) looks through an Rc child at any depth", {
  f :: (fn(t : &Tree) -> i32)(
    match(
      t,
      .Node(Rc(.Leaf(a)), Rc(.Leaf(b))) => (a + b),
      .Node(Rc(.Node(Rc(.Leaf(a)), _)), _) => (a * i32(10)),
      .Node(_, _) => i32(-1),
      .Leaf(n) => n
    )
  );
  assert(f(Tree.Node(rc(Tree.Leaf(1)), rc(Tree.Leaf(2)))) == i32(3));
  assert(f(Tree.Node(rc(Tree.Node(rc(Tree.Leaf(4)), rc(Tree.Leaf(0)))), rc(Tree.Leaf(9)))) == i32(40));
  assert(f(Tree.Node(rc(Tree.Leaf(1)), rc(Tree.Node(rc(Tree.Leaf(4)), rc(Tree.Leaf(0)))))) == i32(-1));
  assert(f(Tree.Leaf(7)) == i32(7));
});
// A borrow match on an `Rc` handle whose arms all look through it to plain
// variant shapes lowers to a `switch` on the payload's tag; a literal field
// or a guard keeps the test chain (plans/VALUES_BY_DEFAULT.md decision 21's
// "As built" note). Both lowerings answer alike.
Shape :: enum(Dot, Line(len : i32), Pair(a : Rc(Self), b : Rc(Self)));
test("a match on an Rc handle with plain variant arms switches on the payload", {
  size :: (fn(s : &Rc(Shape)) -> i32)(
    match(
      s,
      Rc(.Dot) => i32(1),
      Rc(.Line(n)) => n,
      Rc(.Pair(a, b)) => (recur(&a) + recur(&b))
    )
  );
  only_line :: (fn(s : &Rc(Shape)) -> i32)(match(s, Rc(.Line(n)) => n, _ => i32(0)));
  with_literal :: (fn(s : &Rc(Shape)) -> i32)(match(s, Rc(.Line(0)) => i32(-1), Rc(.Line(n)) => n, _ => i32(0)));
  with_guard :: (fn(s : &Rc(Shape)) -> i32)(match(s, (Rc(.Line(n)) && (n > i32(5))) => i32(5), Rc(.Line(n)) => n, _ => i32(0)));
  dot := rc(Shape.Dot);
  line := rc(Shape.Line(len : i32(7)));
  zero := rc(Shape.Line(len : i32(0)));
  pair := rc(Shape.Pair(a : line, b : rc(Shape.Pair(a : dot, b : zero))));
  assert(size(&dot) == i32(1));
  assert(size(&line) == i32(7));
  assert(size(&pair) == i32(8));
  assert(only_line(&line) == i32(7));
  assert(only_line(&pair) == i32(0));
  assert(with_literal(&zero) == i32(-1));
  assert(with_literal(&line) == i32(7));
  assert(with_literal(&dot) == i32(0));
  assert(with_guard(&line) == i32(5));
  assert(with_guard(&zero) == i32(0));
  assert(with_guard(&pair) == i32(0));
});
// The payload switch reads through the cell only for a tagged union. A
// nullable-pointer enum (one pointer payload, one empty variant) or a
// fieldless enum keeps the cell in the subject, so the pattern's own `Rc`
// hop is the only one (issues/fixed/2026-10-15-a-match-through-an-rc-of-a-nullable-pointer-enum-emits-a-second-payload-hop.md).
Nul :: enum(Full(xs : ArrayList(i32)), Empty);
Hue :: enum(Red, Green, Blue);
test("a match through an Rc into a nullable-pointer or fieldless enum reads the payload once", {
  count :: (fn(r : &Rc(Nul)) -> usize)(match(r, Rc(.Full(xs)) => xs.len(), _ => usize(99)));
  both :: (fn(r : &Rc(Nul)) -> usize)(match(r, Rc(.Full(xs)) => xs.len(), Rc(.Empty) => usize(98)));
  red :: (fn(r : &Rc(Hue)) -> i32)(match(r, Rc(.Red) => i32(1), _ => i32(0)));
  hue :: (fn(r : &Rc(Hue)) -> i32)(match(r, Rc(.Red) => i32(1), Rc(.Green) => i32(2), Rc(.Blue) => i32(3)));
  xs := ArrayList(i32).new();
  xs.push(i32(4));
  xs.push(i32(5));
  full := rc(Nul.Full(xs));
  empty := rc(Nul.Empty);
  assert(count(&full) == usize(2));
  assert(count(&empty) == usize(99));
  assert(both(&full) == usize(2));
  assert(both(&empty) == usize(98));
  owned := rc(Nul.Full(ArrayList(i32).new()));
  n := match(owned, Rc(.Full(ys)) => ys.len(), _ => usize(99));
  assert(n == usize(0));
  r := rc(Hue.Red);
  g := rc(Hue.Green);
  b := rc(Hue.Blue);
  assert(red(&r) == i32(1));
  assert(red(&b) == i32(0));
  assert(hue(&g) == i32(2));
  assert(hue(&b) == i32(3));
});
test("Rc(p) at the scrutinee covers it with no catch-all", {
  g :: (fn(b : &Rc(Tree)) -> i32)(
    match(
      b,
      Rc(.Leaf(n)) => n,
      Rc(.Node(_, _)) => i32(-1)
    )
  );
  assert(g(rc(Tree.Leaf(5))) == i32(5));
  assert(g(rc(Tree.Node(rc(Tree.Leaf(1)), rc(Tree.Leaf(2))))) == i32(-1));
});
test("exhaustiveness reaches through Rc(p) into the payload's variants", {
  h :: (fn(t : &Tree) -> i32)(
    match(
      t,
      .Node(Rc(.Leaf(_)), _) => i32(1),
      .Node(Rc(.Node(_, _)), _) => i32(2),
      .Leaf(_) => i32(0)
    )
  );
  assert(h(Tree.Node(rc(Tree.Leaf(1)), rc(Tree.Leaf(2)))) == i32(1));
  assert(h(Tree.Node(rc(Tree.Node(rc(Tree.Leaf(1)), rc(Tree.Leaf(2)))), rc(Tree.Leaf(2)))) == i32(2));
  assert(h(Tree.Leaf(3)) == i32(0));
});
test("Rc(name) binds the payload, a borrow of the shared cell", {
  k :: (fn(t : &Tree) -> i32)(
    match(
      t,
      .Node(Rc(left), _) => match(left, .Leaf(n) => n, .Node(_, _) => i32(-2)),
      .Leaf(_) => i32(0)
    )
  );
  assert(k(Tree.Node(rc(Tree.Leaf(8)), rc(Tree.Leaf(2)))) == i32(8));
  assert(k(Tree.Node(rc(Tree.Node(rc(Tree.Leaf(1)), rc(Tree.Leaf(1)))), rc(Tree.Leaf(2)))) == i32(-2));
});
test("(name := Rc(p)) binds the cell, Rc((name := p)) the payload", {
  m :: (fn(t : &Tree) -> i32)(
    match(
      t,
      .Node(cell := Rc(.Leaf(n)), _) => (n + i32(ref_count(cell))),
      .Node(_, Rc(inner := .Leaf(n))) => match(inner, .Leaf(x) => (x + n), .Node(_, _) => i32(-3)),
      _ => i32(0)
    )
  );
  assert(m(Tree.Node(rc(Tree.Leaf(10)), rc(Tree.Leaf(0)))) >= i32(11));
  assert(m(Tree.Node(rc(Tree.Node(rc(Tree.Leaf(1)), rc(Tree.Leaf(1)))), rc(Tree.Leaf(6)))) == i32(12));
  assert(m(Tree.Leaf(1)) == i32(0));
});
test("Rc(p) with a literal and an or-pattern inside", {
  Cell2 :: enum(Value(v : Rc(i32)), Empty);
  q :: (fn(c : &Cell2) -> i32)(
    match(
      c,
      .Value(Rc(1 | 2)) => i32(1),
      .Value(Rc(42)) => i32(42),
      .Value(Rc(n)) => (n * i32(2)),
      .Empty => i32(0)
    )
  );
  assert(q(Cell2.Value(rc(i32(2)))) == i32(1));
  assert(q(Cell2.Value(rc(i32(42)))) == i32(42));
  assert(q(Cell2.Value(rc(i32(5)))) == i32(10));
  assert(q(Cell2.Empty) == i32(0));
});
Signal :: enum(Level(v : i32), Off);
test("Arc(p) looks through an Arc", {
  r :: (fn(a : &Arc(Signal)) -> i32)(
    match(
      a,
      Arc(.Level(v)) => v,
      Arc(.Off) => i32(-1)
    )
  );
  assert(r(arc(Signal.Level(3))) == i32(3));
  assert(r(arc(Signal.Off)) == i32(-1));
});
test("a wrapper pattern must name the cell at its position", {
  comptime_expect_error({
    bad :: (fn(t : &Tree) -> i32)(
      match(
        t,
        Rc(.Leaf(n)) => n,
        _ => i32(0)
      )
    );
    bad(Tree.Leaf(1))
  }, "looks through an `Rc`, and this position is not one");
  comptime_expect_error({
    bad2 :: (fn(a : &Arc(Signal)) -> i32)(
      match(
        a,
        .Level(v) => v,
        _ => i32(0)
      )
    );
    bad2(arc(Signal.Off))
  }, "a pattern does not look through a cell implicitly");
  comptime_expect_error({
    bad3 :: (fn(t : &Tree) -> i32)(
      match(
        t,
        .Node(Rc(.Leaf(_)), _) => i32(1),
        .Leaf(_) => i32(0)
      )
    );
    bad3(Tree.Leaf(1))
  }, "not exhaustive");
});
// Decision 31, Generation B: an `Rc(T)` position is never looked through
// implicitly, and a missing case is printed through the wrapper.
test("a structural pattern at an Rc position must spell Rc(p)", {
  comptime_expect_error({
    bad4 :: (fn(t : &Tree) -> i32)(
      match(
        t,
        .Node(.Leaf(a), _) => a,
        _ => i32(0)
      )
    );
    bad4(Tree.Leaf(1))
  }, "a pattern does not look through a cell implicitly");
  comptime_expect_error({
    bad5 :: (fn(b : &Rc(Tree)) -> i32)(
      match(
        b,
        .Leaf(n) => n,
        _ => i32(0)
      )
    );
    bad5(rc(Tree.Leaf(1)))
  }, "a pattern does not look through a cell implicitly");
  comptime_expect_error({
    Cell3 :: enum(Value(v : Rc(i32)), Empty);
    bad6 :: (fn(c : &Cell3) -> i32)(
      match(
        c,
        .Value(42) => i32(1),
        _ => i32(0)
      )
    );
    bad6(Cell3.Empty)
  }, "a pattern does not look through a cell implicitly");
});
test("a missing case is printed through the Rc wrapper", {
  comptime_expect_error({
    bad7 :: (fn(t : &Tree) -> i32)(
      match(
        t,
        .Node(Rc(.Leaf(_)), _) => i32(1),
        .Leaf(_) => i32(0)
      )
    );
    bad7(Tree.Leaf(1))
  }, "Missing case: .Node(Rc(.Node(_, _)), Rc(.Leaf(_)))");
  comptime_expect_error({
    bad8 :: (fn(b : &Rc(Tree)) -> i32)(
      match(
        b,
        Rc(.Node(_, _)) => i32(1)
      )
    );
    bad8(rc(Tree.Leaf(1)))
  }, "Missing case: Rc(.Leaf(_))");
});
// A match in statement position whose every arm returns, inside a non-void
// function: the emitted switch is the C function's last statement, which gcc
// rejects under -Werror=return-type unless the construct is closed with the
// unreachable trap (clang accepted the bare switch, so CI's clang builds never
// saw it). The match-as-function-tail, the match-before-a-tail, and a nested
// statement match are the three shapes that hit it
// (issues/fixed/2026-10-18-a-match-in-statement-position-falls-off-the-end-of-a-non-void-function.md).
test("an all-arms-return statement match over an Option ends a non-void function", {
  f :: (fn(n_opt : Option(usize)) -> Option(usize))({
    match(
      n_opt,
      .Some(k) => {
        return(Option(usize).Some(k + usize(1)));
      },
      .None => {
        return(Option(usize).None);
      }
    );
  });
  assert(f(Option(usize).Some(usize(9))) == Option(usize).Some(usize(10)));
  assert(f(Option(usize).None).is_none());
});
test("an all-arms-return statement match over a payload enum ends a non-void function", {
  g :: (fn(o : Outer) -> i32)({
    match(
      o,
      .Ok(v) => {
        return(match(v, .A(x) => x, .B => i32(-1)));
      },
      .Err(code) => {
        return(code * i32(100));
      }
    );
  });
  assert(g(Outer.Ok(Inner.A(41))) == i32(41));
  assert(g(Outer.Ok(Inner.B)) == i32(-1));
  assert(g(Outer.Err(2)) == i32(200));
});
test("an all-arms-return statement match before a tail leaves the tail emitted", {
  h :: (fn(o : Outer) -> i32)({
    match(
      o,
      .Ok(v) => {
        return(match(v, .A(x) => x, .B => i32(-5)));
      },
      .Err(code) => {
        return(code - i32(1));
      }
    );
    i32(-99);
  });
  assert(h(Outer.Ok(Inner.A(3))) == i32(3));
  assert(h(Outer.Err(4)) == i32(3));
});
