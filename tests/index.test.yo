pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ BTreeMap } :: import("std/collections/btree_map");
{ Deque } :: import("std/collections/deque");
{ rune, String } :: import("std/string");
// === Custom struct for testing Index trait ===
MyArray :: struct(data0 : i32, data1 : i32, data2 : i32);
derive(MyArray, Copy, Clone);
impl(
  MyArray,
  Index(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(
      cond(
        (idx == usize(0)) => &self.data0,
        (idx == usize(1)) => &self.data1,
        (idx == usize(2)) => &self.data2,
        true => __yo_panic("MyArray: index out of bounds")
      )
    )
  )
);
impl(
  MyArray,
  IndexMut(usize)(
    Output : i32,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)(
      cond(
        (idx == usize(0)) => &mut self.data0,
        (idx == usize(1)) => &mut self.data1,
        (idx == usize(2)) => &mut self.data2,
        true => __yo_panic("MyArray: index out of bounds")
      )
    )
  )
);
// === Tests ===
test("Test Index trait on custom struct", {
  (arr : MyArray) = MyArray(i32(10), i32(20), i32(30));
  // Basic indexing
  (v0 : i32) = arr(usize(0));
  assert(v0 == i32(10), "arr(0) should be 10");
  (v1 : i32) = arr(usize(1));
  assert(v1 == i32(20), "arr(1) should be 20");
  (v2 : i32) = arr(usize(2));
  assert(v2 == i32(30), "arr(2) should be 30");
});
test("Test Index trait address-of", {
  (arr : MyArray) = MyArray(i32(100), i32(200), i32(300));
  // &(arr(i)) should return a pointer to the element
  (p : *i32) = addr_of(arr(usize(1)));
  assert(p.* == i32(200), "&(arr(1)).* should be 200");
  // Mutate through pointer
  p.* = i32(999);
  assert(arr(usize(1)) == i32(999), "arr(1) should be 999 after mutation through pointer");
});
test("Test Index trait on ArrayList", {
  (mut(list) : ArrayList(i32)) = ArrayList(i32).new();
  list.push(i32(10));
  list.push(i32(20));
  list.push(i32(30));
  // Basic indexing
  assert(list(usize(0)) == i32(10), "list(0) should be 10");
  assert(list(usize(1)) == i32(20), "list(1) should be 20");
  assert(list(usize(2)) == i32(30), "list(2) should be 30");
});
test("Test Index trait address-of on ArrayList", {
  (mut(list) : ArrayList(i32)) = ArrayList(i32).new();
  list.push(i32(100));
  list.push(i32(200));
  list.push(i32(300));
  // &(list(i)) should return a pointer to the element
  (p : *i32) = addr_of(list(usize(1)));
  assert(p.* == i32(200), "&(list(1)).* should be 200");
  // Mutate through pointer
  p.* = i32(999);
  assert(list(usize(1)) == i32(999), "list(1) should be 999 after mutation through pointer");
});
test("Test Index trait inline with operators", {
  (arr : MyArray) = MyArray(i32(10), i32(20), i32(30));
  // Inline Index result used directly with ==
  assert(arr(usize(0)) == i32(10), "inline arr(0) == 10");
  assert(arr(usize(1)) == i32(20), "inline arr(1) == 20");
  // Inline Index result used with arithmetic + comparison
  assert((arr(usize(0)) + arr(usize(1))) == i32(30), "arr(0) + arr(1) == 30");
  assert((arr(usize(2)) - arr(usize(0))) == i32(20), "arr(2) - arr(0) == 20");
  // Inline Index result used with ordering
  assert(arr(usize(0)) < arr(usize(1)), "arr(0) < arr(1)");
  assert(arr(usize(2)) > arr(usize(0)), "arr(2) > arr(0)");
});
// === Range slicing tests ===
test("Test range slicing on arrays with ..", {
  (arr : [i32 ; 5]) = [i32(10), i32(20), i32(30), i32(40), i32(50)];
  // Basic range slice
  s := arr(usize(1) .. usize(4));
  assert(s.len() == usize(3), "slice length should be 3");
  assert(s(usize(0)) == i32(20), "s(0) should be 20");
  assert(s(usize(1)) == i32(30), "s(1) should be 30");
  assert(s(usize(2)) == i32(40), "s(2) should be 40");
  // Full range slice
  s2 := arr(usize(0) .. usize(5));
  assert(s2.len() == usize(5), "full slice length should be 5");
  assert(s2(usize(0)) == i32(10), "s2(0) should be 10");
  assert(s2(usize(4)) == i32(50), "s2(4) should be 50");
  // Empty range
  s3 := arr(usize(2) .. usize(2));
  assert(s3.len() == usize(0), "empty slice length should be 0");
});
test("Test inclusive range slicing on arrays with ..=", {
  (arr : [i32 ; 5]) = [i32(10), i32(20), i32(30), i32(40), i32(50)];
  // Inclusive range: includes the end index
  s := arr(usize(1) ..= usize(3));
  assert(s.len() == usize(3), "inclusive slice length should be 3");
  assert(s(usize(0)) == i32(20), "s(0) should be 20");
  assert(s(usize(1)) == i32(30), "s(1) should be 30");
  assert(s(usize(2)) == i32(40), "s(2) should be 40");
  // Single-element inclusive range
  s2 := arr(usize(2) ..= usize(2));
  assert(s2.len() == usize(1), "single-element slice length should be 1");
  assert(s2(usize(0)) == i32(30), "s2(0) should be 30");
  // Full array inclusive range
  s3 := arr(usize(0) ..= usize(4));
  assert(s3.len() == usize(5), "full inclusive slice length should be 5");
});
test("Test range slicing on slices", {
  (arr : [i32 ; 5]) = [i32(100), i32(200), i32(300), i32(400), i32(500)];
  slice := arr(usize(0) .. usize(5)); // get a slice from the array
  // Slice of a slice with ..
  s := slice(usize(1) .. usize(4));
  assert(s.len() == usize(3), "sub-slice length should be 3");
  assert(s(usize(0)) == i32(200), "s(0) should be 200");
  assert(s(usize(1)) == i32(300), "s(1) should be 300");
  assert(s(usize(2)) == i32(400), "s(2) should be 400");
  // Slice of a slice with ..=
  s2 := slice(usize(1) ..= usize(3));
  assert(s2.len() == usize(3), "inclusive sub-slice length should be 3");
  assert(s2(usize(0)) == i32(200), "s2(0) should be 200");
  assert(s2(usize(2)) == i32(400), "s2(2) should be 400");
});
test("Test range slicing preserves data (owned copy)", {
  // Ranges COPY (plans/archive/SLICE_REWORK.md): the result owns its elements;
  // mutating it never touches the source array.
  (arr : [i32 ; 5]) = [i32(10), i32(20), i32(30), i32(40), i32(50)];
  s := arr(usize(1) .. usize(4));
  assert(s.len() == usize(3), "copy length");
  assert(match(s.get(usize(0)), .Some(v) => (v == i32(20)), .None => false), "copy data");
  s(usize(0)) = i32(999);
  assert(arr(usize(1)) == i32(20), "source array unaffected by copy mutation");
});
// === HashMap Index tests ===
test("Test Index trait on HashMap", {
  (map : HashMap(i32, i32)) = HashMap(i32, i32).new();
  map.insert(i32(1), i32(100));
  map.insert(i32(2), i32(200));
  map.insert(i32(3), i32(300));
  // Basic indexing
  assert(map(i32(1)) == i32(100), "map(1) should be 100");
  assert(map(i32(2)) == i32(200), "map(2) should be 200");
  assert(map(i32(3)) == i32(300), "map(3) should be 300");
});
test("Test Index trait mutation on HashMap", {
  (map : HashMap(i32, i32)) = HashMap(i32, i32).new();
  map.insert(i32(10), i32(42));
  // Mutate through pointer
  addr_of(map(i32(10))).* = i32(999);
  assert(map(i32(10)) == i32(999), "map(10) should be 999 after mutation");
});
// === BTreeMap Index tests ===
test("Test Index trait on BTreeMap", {
  (map : BTreeMap(i32, i32)) = BTreeMap(i32, i32).new();
  map.insert(i32(5), i32(500));
  map.insert(i32(3), i32(300));
  map.insert(i32(7), i32(700));
  assert(map(i32(3)) == i32(300), "map(3) should be 300");
  assert(map(i32(5)) == i32(500), "map(5) should be 500");
  assert(map(i32(7)) == i32(700), "map(7) should be 700");
});
test("Test Index trait mutation on BTreeMap", {
  (map : BTreeMap(i32, i32)) = BTreeMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  addr_of(map(i32(1))).* = i32(77);
  assert(map(i32(1)) == i32(77), "map(1) should be 77 after mutation");
});
// === Deque Index tests ===
test("Test Index trait on Deque", {
  (d : Deque(i32)) = Deque(i32).new();
  d.push_back(i32(10));
  d.push_back(i32(20));
  d.push_back(i32(30));
  assert(d(usize(0)) == i32(10), "d(0) should be 10");
  assert(d(usize(1)) == i32(20), "d(1) should be 20");
  assert(d(usize(2)) == i32(30), "d(2) should be 30");
});
test("Test Index trait mutation on Deque", {
  (d : Deque(i32)) = Deque(i32).new();
  d.push_back(i32(100));
  d.push_back(i32(200));
  addr_of(d(usize(0))).* = i32(555);
  assert(d(usize(0)) == i32(555), "d(0) should be 555 after mutation");
});
test("Test Index on Deque with ring buffer wrap", {
  (d : Deque(i32)) = Deque(i32).new();
  // Push and pop to shift head forward
  d.push_back(i32(1));
  d.push_back(i32(2));
  d.push_back(i32(3));
  d.pop_front(); // removes 1, head moves
  d.pop_front(); // removes 2, head moves
  d.push_back(i32(4));
  d.push_back(i32(5));
  // Now: [3, 4, 5] with head wrapped
  assert(d(usize(0)) == i32(3), "d(0) should be 3");
  assert(d(usize(1)) == i32(4), "d(1) should be 4");
  assert(d(usize(2)) == i32(5), "d(2) should be 5");
});
// === String bytes: a read-only Index (V2b Generation B), no IndexMut ===
test("String's Index reads a byte and has no IndexMut; byte_at / get_byte agree", {
  (s : String) = `Hello`;
  assert(s(usize(0)) == u8(72), "s(0) reads byte 0");
  comptime_expect_error(s(usize(0)) = u8(0), "IndexMut");
  assert(s.byte_at(usize(0)) == u8(72), "byte 0 should be 'H' (72)");
  assert(s.byte_at(usize(1)) == u8(101), "byte 1 should be 'e' (101)");
  assert(s.byte_at(usize(2)) == u8(108), "byte 2 should be 'l' (108)");
  assert(s.get_byte(usize(4)) == Option(u8).Some(u8(111)), "byte 4 should be 'o' (111)");
  assert(s.get_byte(usize(5)) == Option(u8).None, "past the end");
});
// === RC dup correctness tests ===
// These tests verify that Index trait auto-deref correctly increments
// the reference count for RC types, preventing use-after-free.
test("Test Index on ArrayList(String) - RC dup on extract", {
  // Extracting a String from ArrayList via Index must dup the RC.
  // Without dup: drop(s) frees internal bytes, then drop(list) double-frees.
  (mut(list) : ArrayList(String)) = ArrayList(String).new();
  list.push(`hello`);
  list.push(`world`);
  (s : String) = (list(usize(0))).clone();
  assert(s == `hello`, "extracted string should be hello");
  // s is dropped, then list is dropped — both must work without UAF
});
test("Test Index on ArrayList(String) - RC dup in loop", {
  // Loop extracting RC elements must dup each one correctly.
  (mut(list) : ArrayList(String)) = ArrayList(String).new();
  list.push(`alpha`);
  list.push(`beta`);
  list.push(`gamma`);
  (mut(i) : usize) = usize(0);
  while(i < list.len(), {
    (elem : String) = list(i).clone();
    assert(elem.len() > usize(0), "element should not be empty");
    // elem is dropped at end of iteration; list elements must remain valid
    i = (i + usize(1));
  });
  // list is dropped here — all elements must still be valid
  assert(list.len() == usize(3), "list should still have 3 elements");
});
test("Test Index on ArrayList(String) - RC dup in cond branches", {
  // Index inside cond branches must produce correct dup.
  (mut(list) : ArrayList(String)) = ArrayList(String).new();
  list.push(`first`);
  list.push(`second`);
  (flag : bool) = true;
  (result : String) = cond(
    flag => (list(usize(0))).clone(),
    true => (list(usize(1))).clone()
  );
  assert(result == `first`, "should pick first element");
});
test("Test Index on ArrayList(String) - multiple extracts same index", {
  // Multiple extracts from the same index must each dup.
  (mut(list) : ArrayList(String)) = ArrayList(String).new();
  list.push(`shared`);
  (a : String) = (list(usize(0))).clone();
  (b : String) = (list(usize(0))).clone();
  (c : String) = (list(usize(0))).clone();
  assert(a == `shared`, "a should be shared");
  assert(b == `shared`, "b should be shared");
  assert(c == `shared`, "c should be shared");
  // All three copies + list element share the same data; all must be dropped safely
});
test("Test Index on ArrayList(ArrayList(u8)) - nested RC", {
  // Index on nested RC types must dup the outer container.
  (mut(outer) : ArrayList(ArrayList(u8))) = ArrayList(ArrayList(u8)).new();
  (mut(inner) : ArrayList(u8)) = ArrayList(u8).new();
  inner.push(u8(42));
  outer.push(inner);
  (extracted : ArrayList(u8)) = (outer(usize(0))).clone();
  assert(extracted.len() == usize(1), "extracted should have 1 element");
  assert(extracted(usize(0)) == u8(42), "extracted[0] should be 42");
  // extracted and outer both hold references to the same ArrayList(u8)
});
test("Test NOT operator on Index trait field access", {
  // The ! operator on a bool field accessed through Index trait
  // must use the runtime `not` function, not `comptime_not`.
  Marker :: struct(
    active : bool,
    is_image : bool
  );
  derive(Marker, Copy, Clone);
  (mut(markers) : ArrayList(Marker)) = ArrayList(Marker).new();
  markers.push(Marker(active : true, is_image : false));
  markers.push(Marker(active : true, is_image : true));
  // Direct ! on Index trait field access
  assert(!markers(usize(0)).is_image, "markers[0] should not be image");
  assert(markers(usize(1)).is_image, "markers[1] should be image");
  // ! inside a loop (the original bug scenario)
  (mut(count) : i32) = i32(0);
  (mut(i) : i32) = i32(0);
  while(i < i32(2), {
    if(!markers(usize(i)).is_image, {
      count = (count + i32(1));
    });
    i = (i + i32(1));
  });
  assert(count == i32(1), "should count 1 non-image marker");
});
// === Comptime Index tests ===
test("Comptime array element indexing", {
  arr :: [i32(1), i32(2), i32(3)];
  comptime_assert(arr(usize(0)) == i32(1), "first element");
  comptime_assert(arr(usize(2)) == i32(3), "last element");
});
test("Comptime array mutation via index", {
  mut(arr) :: [i32(0), i32(1), i32(2)];
  arr(usize(0)) = i32(42);
  comptime_assert(arr(usize(0)) == i32(42), "arr(0) should be mutated");
  comptime_assert(arr(usize(1)) == i32(1), "arr(1) unchanged");
});
test("Comptime string element indexing", {
  x :: "Hello";
  comptime_assert(x(0) == "H", "first char");
  comptime_assert(x(4) == "o", "last char");
});
test("Comptime string range slicing", {
  x :: "Hello World";
  comptime_assert(x(0 .. 5) == "Hello", "first word");
  comptime_assert(x(6 .. 11) == "World", "second word");
});
test("Comptime string inclusive range slicing", {
  x :: "Hello";
  comptime_assert(x(0 ..= 2) == "Hel", "inclusive slice");
  comptime_assert(x(0 ..= 4) == "Hello", "full inclusive slice");
});
test("Comptime string indexing is BYTE-based (D4 PR 7, O1c)", {
  // Subject covers three UTF-8 widths: a=1B @0, é=2B @1, 中=3B @3 — 6 bytes.
  x :: "aé中";
  // s[i] takes a BYTE offset on a rune boundary and yields the rune STARTING
  // there as a 1-rune comptime_str (mirrors runtime `at(i)`; the pre-PR-7
  // engine read i as a RUNE index: x(1) was "é" by counting, x(3) an error).
  comptime_assert(x(0) == "a", "byte 0 starts a");
  comptime_assert(x(1) == "é", "byte 1 starts é");
  comptime_assert(x(3) == "中", "byte 3 starts 中");
  // Runtime-observable: the folded rune agrees with the runtime byte basis.
  third_ct :: x(3);
  (third : str) = third_ct;
  assert(third.len() == usize(3));
  assert(third == "中");
});
test("Comptime string range slicing is BYTE-based (D4 PR 7, O1c)", {
  x :: "aé中";
  // Byte offsets [start, end) — the pre-PR-7 engine counted runes here
  // (x(1 .. 3) was "é中").
  comptime_assert(x(1 .. 3) == "é", "bytes 1..3 are é");
  comptime_assert(x(3 .. 6) == "中", "bytes 3..6 are 中");
  comptime_assert(x(0 .. 6) == "aé中", "full byte range");
  // Inclusive: the end byte must be the LAST byte of a rune.
  comptime_assert(x(1 ..= 2) == "é", "inclusive last byte of é");
  comptime_assert(x(3 ..= 5) == "中", "inclusive last byte of 中");
  // Runtime-observable case.
  second_ct :: x(1 .. 3);
  (second : str) = second_ct;
  assert(second.len() == usize(2));
  assert(second == "é");
});
test("Comptime string mid-rune offsets are compile errors (D4 PR 7)", {
  x :: "aé中";
  // Byte 2 is the SECOND byte of é — not a rune boundary.
  comptime_expect_error(bad_index :: x(2));
  comptime_expect_error(bad_slice_end :: x(0 .. 2));
  comptime_expect_error(bad_slice_start :: x(2 .. 6));
  // Boundary offsets stay accepted (over-rejection canary).
  comptime_assert(x(0 .. 1) == "a", "boundary range still fine");
});
// ============================================================
// ComptimeList indexing via ComptimeIndex trait
// ============================================================
test("ComptimeList indexing: read elements", {
  l :: ComptimeList(i32)(1, 2, 3);
  comptime_assert(l(0) == 1, "l(0) should be 1");
  comptime_assert(l(1) == 2, "l(1) should be 2");
  comptime_assert(l(2) == 3, "l(2) should be 3");
});
test("ComptimeList indexing: mutation", {
  l :: ComptimeList(i32)(10, 20, 30);
  comptime_assert(l(0) == 10, "l(0) should be 10");
  l(0) = 99;
  comptime_assert(l(0) == 99, "l(0) should be 99 after mutation");
  comptime_assert(l(1) == 20, "l(1) should still be 20");
  comptime_assert(l(2) == 30, "l(2) should still be 30");
});
test("ComptimeList indexing: multiple mutations", {
  l :: ComptimeList(i32)(1, 2, 3);
  l(0) = 100;
  l(1) = 200;
  l(2) = 300;
  comptime_assert(l(0) == 100, "l(0) should be 100");
  comptime_assert(l(1) == 200, "l(1) should be 200");
  comptime_assert(l(2) == 300, "l(2) should be 300");
});
test("ComptimeList indexing: range slicing", {
  l :: ComptimeList(i32)(10, 20, 30, 40, 50);
  sliced :: l(usize(1) .. usize(4));
  comptime_assert(sliced.len() == usize(3), "sliced length should be 3");
  comptime_assert(sliced(0) == 20, "sliced(0) should be 20");
  comptime_assert(sliced(1) == 30, "sliced(1) should be 30");
  comptime_assert(sliced(2) == 40, "sliced(2) should be 40");
});
test("ComptimeList indexing: inclusive range slicing", {
  l :: ComptimeList(i32)(10, 20, 30, 40, 50);
  sliced :: l(usize(1) ..= usize(3));
  comptime_assert(sliced.len() == usize(3), "sliced length should be 3");
  comptime_assert(sliced(0) == 20, "sliced(0) should be 20");
  comptime_assert(sliced(1) == 30, "sliced(1) should be 30");
  comptime_assert(sliced(2) == 40, "sliced(2) should be 40");
});
test("ComptimeList indexing: range slicing edge cases", {
  l :: ComptimeList(i32)(1, 2, 3);
  // Full range
  full :: l(usize(0) .. usize(3));
  comptime_assert(full.len() == usize(3), "full range length should be 3");
  comptime_assert(full(0) == 1, "full(0) should be 1");
  comptime_assert(full(2) == 3, "full(2) should be 3");
  // Empty range
  empty :: l(usize(1) .. usize(1));
  comptime_assert(empty.len() == usize(0), "empty range length should be 0");
  // Single element range
  single :: l(usize(0) .. usize(1));
  comptime_assert(single.len() == usize(1), "single range length should be 1");
  comptime_assert(single(0) == 1, "single(0) should be 1");
});
// ============================================================
// Comptime range variable indexing
// ============================================================
test("Comptime string slicing with range variable", {
  x :: "Hello World";
  range :: (0 .. 5);
  comptime_assert(x(range) == "Hello", "range var string slice");
  range2 :: (6 ..= 10);
  comptime_assert(x(range2) == "World", "inclusive range var string slice");
});
// === Custom struct Index + ComptimeIndex ===
Point :: struct(x : i32, y : i32);
derive(Point, Copy, Clone);
impl(
  Point,
  Index(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(
      cond(
        (idx == usize(0)) => &self.x,
        true => &self.y
      )
    )
  )
);
impl(
  Point,
  IndexMut(usize)(
    Output : i32,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)(
      cond(
        (idx == usize(0)) => &mut self.x,
        true => &mut self.y
      )
    )
  )
);
impl(
  Point,
  ComptimeIndex(usize)(
    Output : i32,
    index : (fn(comptime(self) : &mut Self, comptime(idx) : usize) -> comptime(*Self.Output))(
      cond(
        (idx == usize(0)) => addr_of(self.x),
        true => addr_of(self.y)
      )
    )
  )
);
test("Point runtime Index", {
  p1 := Point(i32(1), i32(2));
  assert(p1(usize(0)) == i32(1), "p1(0) should be 1");
  assert(p1(usize(1)) == i32(2), "p1(1) should be 2");
});
test("Point runtime Index mutation", {
  p1 := Point(i32(1), i32(2));
  p1(usize(0)) = i32(10);
  assert(p1(usize(0)) == i32(10), "p1(0) should be 10 after mutation");
  assert(p1(usize(1)) == i32(2), "p1(1) should still be 2");
});
test("Point comptime Index", {
  p2 :: Point(i32(3), i32(4));
  comptime_assert(p2(usize(0)) == i32(3), "p2(0) should be 3");
  comptime_assert(p2(usize(1)) == i32(4), "p2(1) should be 4");
});
test("Point comptime Index mutation", {
  p2 :: Point(i32(3), i32(4));
  p2(usize(0)) = i32(30);
  comptime_assert(p2(usize(0)) == i32(30), "p2(0) should be 30 after mutation");
  comptime_assert(p2(usize(1)) == i32(4), "p2(1) should still be 4");
});
StrictPoint :: struct(x : i32, y : i32);
derive(StrictPoint, Copy, Clone);
impl(
  StrictPoint,
  Index(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(
      cond(
        (idx == usize(0)) => &self.x,
        (idx == usize(1)) => &self.y,
        true => __yo_panic("StrictPoint: index out of bounds")
      )
    )
  )
);
impl(
  StrictPoint,
  ComptimeIndex(usize)(
    Output : i32,
    index : (fn(comptime(self) : &mut Self, comptime(idx) : usize) -> comptime(*Self.Output))(
      cond(
        (idx == usize(0)) => addr_of(self.x),
        (idx == usize(1)) => addr_of(self.y),
        true => {
          comptime_assert(false, "StrictPoint: index out of bounds");
          addr_of(self.x)
        }
      )
    )
  )
);
test("StrictPoint comptime Index propagates errors", {
  p :: StrictPoint(i32(1), i32(2));
  comptime_expect_error(p(usize(2)));
});
// === Generic struct Index + ComptimeIndex ===
GenericPoint :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(x : T, y : T)
);
derive(generic(T : Type), where(T <: Clone), GenericPoint(T), Clone);
derive(generic(T : Type), where(T <: Copy), GenericPoint(T), Copy);
impl(
  generic(T),
  GenericPoint(T),
  Index(usize)(
    Output : T,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(
      cond(
        (idx == usize(0)) => &self.x,
        true => &self.y
      )
    )
  )
);
impl(
  generic(T),
  GenericPoint(T),
  IndexMut(usize)(
    Output : T,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)(
      cond(
        (idx == usize(0)) => &mut self.x,
        true => &mut self.y
      )
    )
  )
);
impl(
  generic(T),
  where(T <: Comptime),
  GenericPoint(T),
  ComptimeIndex(usize)(
    Output : T,
    index : (fn(comptime(self) : &mut Self, comptime(idx) : usize) -> comptime(*Self.Output))(
      cond(
        (idx == usize(0)) => addr_of(self.x),
        true => addr_of(self.y)
      )
    )
  )
);
test("GenericPoint runtime Index", {
  gp1 := GenericPoint(i32)(i32(5), i32(6));
  assert(gp1(usize(0)) == i32(5), "gp1(0) should be 5");
  assert(gp1(usize(1)) == i32(6), "gp1(1) should be 6");
});
test("GenericPoint runtime Index mutation", {
  gp1 := GenericPoint(i32)(i32(5), i32(6));
  gp1(usize(0)) = i32(50);
  assert(gp1(usize(0)) == i32(50), "gp1(0) should be 50 after mutation");
  assert(gp1(usize(1)) == i32(6), "gp1(1) should still be 6");
});
test("GenericPoint comptime Index", {
  gp2 :: GenericPoint(i32)(i32(7), i32(8));
  comptime_assert(gp2(usize(0)) == i32(7), "gp2(0) should be 7");
  comptime_assert(gp2(usize(1)) == i32(8), "gp2(1) should be 8");
});
test("GenericPoint comptime Index mutation", {
  gp2 :: GenericPoint(i32)(i32(7), i32(8));
  gp2(usize(0)) = i32(70);
  comptime_assert(gp2(usize(0)) == i32(70), "gp2(0) should be 70 after mutation");
  comptime_assert(gp2(usize(1)) == i32(8), "gp2(1) should still be 8");
});
// === Tuple-like struct Index + ComptimeIndex ===
// Note: Can't impl Index directly on built-in Tuple types (orphan rule).
// Using a struct wrapper to test tuple-style positional indexing.
Pair :: struct(first : i32, second : i32);
derive(Pair, Copy, Clone);
impl(
  Pair,
  Index(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(
      cond(
        (idx == usize(0)) => &self.first,
        true => &self.second
      )
    )
  )
);
impl(
  Pair,
  IndexMut(usize)(
    Output : i32,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)(
      cond(
        (idx == usize(0)) => &mut self.first,
        true => &mut self.second
      )
    )
  )
);
impl(
  Pair,
  ComptimeIndex(usize)(
    Output : i32,
    index : (fn(comptime(self) : &mut Self, comptime(idx) : usize) -> comptime(*Self.Output))(
      cond(
        (idx == usize(0)) => addr_of(self.first),
        true => addr_of(self.second)
      )
    )
  )
);
test("Pair runtime Index", {
  p := Pair(i32(10), i32(20));
  assert(p(usize(0)) == i32(10), "p(0) should be 10");
  assert(p(usize(1)) == i32(20), "p(1) should be 20");
});
test("Pair runtime Index mutation", {
  p := Pair(i32(10), i32(20));
  p(usize(0)) = i32(100);
  assert(p(usize(0)) == i32(100), "p(0) should be 100 after mutation");
  assert(p(usize(1)) == i32(20), "p(1) should still be 20");
});
test("Pair comptime Index", {
  p :: Pair(i32(30), i32(40));
  comptime_assert(p(usize(0)) == i32(30), "p(0) should be 30");
  comptime_assert(p(usize(1)) == i32(40), "p(1) should be 40");
});
test("Pair comptime Index mutation", {
  p :: Pair(i32(30), i32(40));
  p(usize(0)) = i32(300);
  comptime_assert(p(usize(0)) == i32(300), "p(0) should be 300 after mutation");
  comptime_assert(p(usize(1)) == i32(40), "p(1) should still be 40");
});
test("Typed binding from index call with operator-expression argument", {
  // Regression shape for issues/fixed/yo-self-std-string-swallowed-unify-noise.md:
  // under a typed `u8` binding, the index ARGUMENT (`end_idx - usize(1)`) was
  // evaluated with the ambient expected type still set, producing a swallowed
  // usize-vs-u8 unify error in the self-hosted evaluator (String.trim's shape).
  mut(al) := ArrayList(u8).new();
  al.push(u8(7));
  al.push(u8(9));
  end_idx := usize(2);
  (b : u8) = al(end_idx - usize(1));
  assert(b == u8(9), "index with operator arg under typed binding");
});
// === By-value index arguments (decision 34 as amended 2026-10-11) ===
// The Index trait takes its index BY VALUE. An RC-typed index (a String key)
// exercises the caller-side share: the specialized `index` C function drops
// its by-value parameter on every exit path, so the dispatch site must
// balance it — without the `consume_argument_for_parameter` call in
// try_to_call_with_index_trait the refcount underflowed and the key was
// freed while the caller still read it.
Keyed :: struct(entries : ArrayList(String));
impl(
  Keyed,
  Index(String)(
    Output : String,
    index : (fn(self : &Self, key : String) -> &Self.Output)({
      (mut(i) : usize) = usize(0);
      while(i < self.entries.len(), i = (i + usize(1)), {
        if(self.entries(i) == key, {
          return(&self.entries(i));
        });
      });
      __yo_panic("Keyed: key not found")
    })
  )
);
test("Index with a by-value String key keeps the caller's key alive", {
  mut(k) := Keyed(entries : ArrayList(String).new());
  k.entries.push(String.from("alpha"));
  k.entries.push(String.from("beta"));
  key := String.from("alpha");
  first := k(key.clone()).clone();
  second := k(key.clone()).clone();
  assert(first == second, "same key indexes the same entry");
  assert(key.len() == usize(5), "the by-value index did not consume the caller's key");
  assert(k(key.clone()) == key, "still sound after a third dispatch");
});
test("Index with an owning-temp String key moves it", {
  mut(k) := Keyed(entries : ArrayList(String).new());
  k.entries.push(String.from("gamma"));
  got := k(String.from("gamma")).clone();
  assert(got == String.from("gamma"), "temp-key dispatch");
});
test("HashMap Index with a by-value String key", {
  m := HashMap(String, String).new();
  m.insert(String.from("one"), String.from("1"));
  key := String.from("one");
  assert(m(key.clone()) == String.from("1"), "map index by String key");
  assert(key.len() == usize(3), "key still alive after the dispatch");
  assert(m(key) == String.from("1"), "second dispatch through the same key");
});
BadBorrowIdx :: struct(data0 : i32, data1 : i32);
test("A borrowed idx no longer conforms to the by-value Index trait", {
  comptime_expect_error(
    impl(
      BadBorrowIdx,
      Index(usize)(
        Output : i32,
        index : (fn(self : &Self, idx : &usize) -> &Self.Output)(&self.data0)
      )
    ),
    "but the trait requires"
  );
});
// A later impl's `Self.Output` must not see the abandoned impl's `Output`
// (issues/fixed/an-abandoned-impl-leaks-its-working-trait-bindings.md): the
// failed `BadBorrowIdx` impl above left `Output : i32` installed, and this
// trait's second impl was rejected as needing `-> *(i32)`.
AfterBadIdx :: (fn(comptime(Idx) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    index : (fn(self : &mut Self, idx : Idx) -> *Self.Output)
  )
);
AbiCell :: struct(v : i32);
derive(AbiCell, Copy, Clone);
impl(AbiCell, AfterBadIdx(usize)(Output : i32, index : (fn(self : &mut Self, idx : usize) -> *Self.Output)(addr_of(self.v))));
AbiBox :: struct(c : AbiCell);
impl(AbiBox, AfterBadIdx(usize)(Output : AbiCell, index : (fn(self : &mut Self, idx : usize) -> *Self.Output)(addr_of(self.c))));
test("An impl abandoned under comptime_expect_error leaves no Output behind", {
  b := AbiBox(c : AbiCell(v : i32(4)));
  assert(b(usize(0)).v == i32(4), "AbiBox's Output is AbiCell");
  assert(b(usize(0))(usize(0)) == i32(4), "and AbiCell's is i32");
});
// ============================================================
// V2b: the read/write split (decision 34) over projections (decision 24).
// These local traits spell the prelude's `Index`/`IndexMut` shapes, so the
// cases below exercise the dispatch apart from std's impls. The subscript
// dispatches by method name: `x(i)` reads through
// `index`, and every write (`=`, a field of the element, a `&mut` receiver
// or argument, `addr_of`) goes through `index_mut`.
// ============================================================
VIndex :: (fn(comptime(Idx) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    index : (fn(self : &Self, idx : Idx) -> &Self.Output)
  )
);
VIndexMut :: (fn(comptime(Idx) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    index_mut : (fn(self : &mut Self, idx : Idx) -> &mut Self.Output)
  )
);
// Inline storage: the projection's place is inside `self`, so its `&Self`
// receiver must reach the caller's value, never a by-value copy.
Trio :: struct(a : i32, b : i32, c : i32);
impl(
  Trio,
  VIndex(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(
      cond(
        (idx == usize(0)) => &self.a,
        (idx == usize(1)) => &self.b,
        true => &self.c
      )
    )
  )
);
impl(
  Trio,
  VIndexMut(usize)(
    Output : i32,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)(
      cond(
        (idx == usize(0)) => &mut self.a,
        (idx == usize(1)) => &mut self.b,
        true => &mut self.c
      )
    )
  )
);
test("V2b: a read projection reads the caller's element", {
  t := Trio(a : i32(1), b : i32(2), c : i32(3));
  assert(t(usize(0)) == i32(1), "t(0)");
  assert(t(usize(1)) == i32(2), "t(1)");
  assert(t(usize(2)) == i32(3), "t(2)");
});
test("V2b: element assignment dispatches IndexMut", {
  t := Trio(a : i32(1), b : i32(2), c : i32(3));
  t(usize(1)) = i32(20);
  assert(t.b == i32(20), "the write reached the field");
  assert(t(usize(1)) == i32(20), "and reads back");
  // A read-modify-write is a read dispatch then a write dispatch.
  t(usize(2)) = (t(usize(2)) + i32(30));
  assert(t.c == i32(33), "t(2) = t(2) + 30");
});
_trio_bump :: (fn(t : &mut Trio, i : usize) -> unit)({
  t(i) = (t(i) + i32(1));
});
_trio_sum :: (fn(t : &Trio) -> i32)(
  t(usize(0)) + t(usize(1)) + t(usize(2))
);
test("V2b: a &mut parameter writes its elements, a & parameter reads them", {
  mut(t) := Trio(a : i32(1), b : i32(2), c : i32(3));
  _trio_bump(&mut t, usize(0));
  _trio_bump(&mut t, usize(0));
  assert(t.a == i32(3), "two bumps through a &mut parameter");
  assert(_trio_sum(&t) == i32(8), "reads through a & parameter");
});
_trio_write_shared :: (fn(t : &Trio) -> unit)({
  comptime_expect_error(t(usize(0)) = i32(9), "is a read-only borrow");
});
// A collection of value elements: `grid(i)(j) = v` writes through both
// projections, and `pts(i).x = v` writes a field of the element.
Rows :: struct(rows : ArrayList(Trio));
impl(
  Rows,
  VIndex(usize)(
    Output : Trio,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)({
      assert(idx < self.rows.len(), "Rows index out of bounds");
      &self.rows(idx)
    })
  )
);
impl(
  Rows,
  VIndexMut(usize)(
    Output : Trio,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)({
      assert(idx < self.rows.len(), "Rows index out of bounds");
      &mut self.rows(idx)
    })
  )
);
impl(
  Trio,
  bump_all : (fn(self : &mut Self) -> unit)({
    self.a = (self.a + i32(1));
    self.b = (self.b + i32(1));
    self.c = (self.c + i32(1));
  })
);
test("V2b: nested and field writes go through IndexMut at every level", {
  mut(g) := Rows(rows : ArrayList(Trio).new());
  g.rows.push(Trio(a : i32(1), b : i32(2), c : i32(3)));
  g.rows.push(Trio(a : i32(4), b : i32(5), c : i32(6)));
  assert(g(usize(1))(usize(2)) == i32(6), "nested read");
  g(usize(1))(usize(2)) = i32(60);
  assert(g.rows(usize(1)).c == i32(60), "nested write");
  g(usize(0)).b = i32(22);
  assert(g(usize(0)).b == i32(22), "a field of the element");
  g(usize(0)).bump_all();
  assert(g(usize(0))(usize(0)) == i32(2), "a &mut receiver");
  assert(g(usize(0)).b == i32(23), "a &mut receiver, second field");
});
// Read-only elements: `Index` without `IndexMut`.
Frozen :: struct(v : i32);
impl(
  Frozen,
  VIndex(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)({
      assert(idx == usize(0), "Frozen has one element");
      &self.v
    })
  )
);
test("V2b: a type with Index but no IndexMut has read-only elements", {
  f := Frozen(v : i32(7));
  assert(f(usize(0)) == i32(7), "the read");
  comptime_expect_error(f(usize(0)) = i32(8), "but not `IndexMut`");
});
test("V2b: IndexMut needs a writable receiver", {
  t := Trio(a : i32(1), b : i32(2), c : i32(3));
  _trio_write_shared(&t);
  assert(t.a == i32(1), "nothing was written");
});
test("V2b: a projection yields a place rooted at a borrow parameter", {
  comptime_expect_error(
    (fn(t : &Trio) -> &i32)({
      x := t.a;
      &x
    }),
    "is a local"
  );
  comptime_expect_error((fn(t : Trio) -> &i32)(&t.a), "is a by-value parameter");
  comptime_expect_error((fn(t : &Trio) -> &mut i32)(&mut t.a), "is a shared borrow");
  comptime_expect_error((fn(t : &mut Trio) -> &mut i32)(&t.a), "write `&mut place`");
  comptime_expect_error((fn(t : &Trio) -> &i32)(&mut t.a), "write `&place`, not `&mut place`");
});
// ============================================================
// Decision 24's remaining result positions: a projection called directly
// (`t.index(i)`, `first(&t)`), not through the subscript. Its result is a
// place, read through as an operand, used as a receiver, lent to a borrow
// parameter, bound to a local borrow and written through as the left of
// `=` (a `&mut` projection's). The place lies in the call's borrowed
// arguments, which stay frozen while a binding of it is live.
// ============================================================
_v2b_first :: (fn(t : &Trio) -> &i32)(&t.a);
_v2b_first_mut :: (fn(t : &mut Trio) -> &mut i32)(&mut t.a);
_v2b_read :: (fn(x : &i32) -> i32)(x + i32(0));
_v2b_bump :: (fn(x : &mut i32) -> unit)({
  x = (x + i32(1));
});
// RC elements: the place is read through and written through, never
// copied into a temporary that is dropped.
Names :: struct(first : String, second : String);
impl(
  Names,
  name : (fn(self : &Self, idx : usize) -> &String)(
    cond(
      (idx == usize(0)) => &self.first,
      true => &self.second
    )
  ),
  name_mut : (fn(self : &mut Self, idx : usize) -> &mut String)(
    cond(
      (idx == usize(0)) => &mut self.first,
      true => &mut self.second
    )
  )
);
_v2b_len :: (fn(s : &String) -> usize)(s.len());
test("V2b: a projection call is an operand", {
  mut(t) := Trio(a : i32(5), b : i32(6), c : i32(7));
  assert(_v2b_first(&t) == i32(5), "a free projection, read through");
  assert((t.index(usize(1)) + i32(1)) == i32(7), "a method projection in an operator");
  assert(Trio.index(&t, usize(2)) == i32(7), "the static form");
  assert((t.index_mut(usize(0)) + i32(1)) == i32(6), "a &mut projection read through");
});
test("V2b: a projection call is a receiver", {
  mut(n) := Names(first : String.from("ab"), second : String.from("xyz"));
  assert(n.name(usize(1)).len() == usize(3), "a &self method on a read projection's place");
  n.name_mut(usize(0)).push_str("c");
  assert(n.first == "abc", "a &mut self method wrote the caller's field");
  mut(g) := Rows(rows : ArrayList(Trio).new());
  g.rows.push(Trio(a : i32(1), b : i32(2), c : i32(3)));
  g.index_mut(usize(0)).bump_all();
  assert(g.rows(usize(0)).c == i32(4), "a &mut receiver through a &mut projection");
  assert(g.index(usize(0))(usize(1)) == i32(3), "a subscript on a projection's place");
  g.index_mut(usize(0))(usize(2)) = i32(40);
  assert(g.rows(usize(0)).c == i32(40), "an element write through a &mut projection's place");
});
test("V2b: a projection call is a borrow argument", {
  mut(t) := Trio(a : i32(5), b : i32(6), c : i32(7));
  assert(_v2b_read(t.index(usize(1))) == i32(6), "lent to a & parameter");
  _v2b_bump(t.index_mut(usize(2)));
  _v2b_bump(_v2b_first_mut(&mut t));
  assert((t.c == i32(8)) && (t.a == i32(6)), "lent to a &mut parameter, the write reached the caller");
  n := Names(first : String.from("ab"), second : String.from("xyz"));
  assert(_v2b_len(n.name(usize(0))) == usize(2), "an RC element lent to a & parameter");
});
test("V2b: a projection call binds a local borrow", {
  mut(t) := Trio(a : i32(5), b : i32(6), c : i32(7));
  r := t.index(usize(1));
  assert(r == i32(6), "read through the & borrow");
  assert(t.b == i32(6), "its root stays readable while a & borrow is live");
  w := t.index_mut(usize(2));
  w = (w + i32(30));
  assert(t.c == i32(37), "written through the &mut borrow, read after its last use");
  t.c = i32(1);
  assert(t.c == i32(1), "the root is writable after the borrow's last use");
  mut(n) := Names(first : String.from("ab"), second : String.from("xyz"));
  s := n.name_mut(usize(1));
  s.push_str("!");
  kept := n.name(usize(1));
  copy := kept.clone();
  assert(copy == "xyz!", "a by-value read of the borrow copies the element");
  assert(n.second == "xyz!", "and the element is still the caller's");
});
// issues/fixed/2026-10-15-a-direct-projection-method-call-bound-to-a-local-reaches-the-c-compiler.md:
// a std collection's `index` called as a method and bound to a local
// initialized an `int32_t` with the `int32_t *` the projection returns
// (clang: int-from-pointer).
test("V2b: a std collection's index method call binds a local borrow", {
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(7));
  r := xs.index(usize(0));
  assert((r + i32(0)) == i32(7), "r reads the element through the borrow");
  w := xs.index_mut(usize(0));
  w = (w + i32(1));
  assert(xs(usize(0)) == i32(8), "written through the &mut borrow");
  assert((xs.index(usize(0)) + i32(1)) == i32(9), "an operand");
  xs.index_mut(usize(0)) = i32(20);
  assert(xs(usize(0)) == i32(20), "the left of `=`");
});
// The same through a user generic impl: its methods are resolved by the
// receiver-method dispatch, whose `.` callee carries no function type.
V2bPair :: (fn(comptime(T) : Type) -> comptime(Type))(struct(v : T, w : T));
impl(
  generic(T : Type),
  V2bPair(T),
  at : (fn(self : &Self, i : usize) -> &T)(
    cond(
      (i == usize(0)) => &self.v,
      true => &self.w
    )
  ),
  at_mut : (fn(self : &mut Self, i : usize) -> &mut T)(
    cond(
      (i == usize(0)) => &mut self.v,
      true => &mut self.w
    )
  )
);
test("V2b: a generic impl's projection method call is a place", {
  mut(p) := V2bPair(i32)(v : i32(7), w : i32(8));
  r := p.at(usize(1));
  assert((r + i32(0)) == i32(8), "bound as a & borrow");
  assert((p.at(usize(0)) + i32(1)) == i32(8), "an operand");
  p.at_mut(usize(0)) = i32(70);
  _v2b_bump(p.at_mut(usize(1)));
  assert((p.v == i32(70)) && (p.w == i32(9)), "written through the &mut projection");
});
comptime_expect_error(
  _v2b_generic_write_through_read :: (fn() -> unit)({
    p := V2bPair(i32)(v : i32(7), w : i32(8));
    p.at(usize(0)) = i32(1);
  }),
  "is a read projection"
);
comptime_expect_error(
  _v2b_std_write_through_read :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    xs.push(i32(7));
    xs.index(usize(0)) = i32(1);
  }),
  "is a read projection"
);
test("V2b: a &mut projection call is the left of `=`", {
  mut(t) := Trio(a : i32(5), b : i32(6), c : i32(7));
  t.index_mut(usize(1)) = i32(60);
  _v2b_first_mut(&mut t) = i32(6);
  assert((t.b == i32(60)) && (t.a == i32(6)), "both writes reached the caller's fields");
  mut(n) := Names(first : String.from("ab"), second : String.from("xyz"));
  n.name_mut(usize(0)) = String.from("replaced");
  assert((n.first == "replaced") && (n.second == "xyz"), "an RC element replaced in place");
});
// A projection yields another projection's place, rooted at its own
// parameters.
_v2b_row_a :: (fn(g : &Rows, i : usize) -> &i32)(&g.index(i).a);
_v2b_row_b_mut :: (fn(g : &mut Rows, i : usize) -> &mut i32)(&mut g.index_mut(i).b);
test("V2b: a projection yields another projection's result", {
  mut(g) := Rows(rows : ArrayList(Trio).new());
  g.rows.push(Trio(a : i32(1), b : i32(2), c : i32(3)));
  assert(_v2b_row_a(&g, usize(0)) == i32(1), "a & projection through a & projection");
  _v2b_row_b_mut(&mut g, usize(0)) = i32(20);
  assert(g.rows(usize(0)).b == i32(20), "a &mut projection through a &mut projection");
});
comptime_expect_error(
  _v2b_yield_of_read_as_mut :: (fn(g : &mut Rows) -> &mut i32)(&mut g.index(usize(0)).b),
  "read projection"
);
comptime_expect_error(
  _v2b_yield_of_local :: (fn(t : &Trio) -> &i32)({
    u := Trio(a : i32(1), b : i32(2), c : i32(3));
    &u.index(usize(0))
  }),
  "is a local"
);
// A read projection's place is read-only.
comptime_expect_error(
  _v2b_write_through_read :: (fn() -> unit)({
    t := Trio(a : i32(5), b : i32(6), c : i32(7));
    t.index(usize(0)) = i32(1);
  }),
  "is a read projection"
);
comptime_expect_error(
  _v2b_mut_receiver_through_read :: (fn() -> unit)({
    g := Rows(rows : ArrayList(Trio).new());
    g.index(usize(0)).bump_all();
  }),
  "is a read projection"
);
comptime_expect_error(
  _v2b_mut_method_through_read :: (fn() -> unit)({
    n := Names(first : String.from("ab"), second : String.from("xyz"));
    n.name(usize(0)).push_str("!");
  }),
  "is a read projection"
);
comptime_expect_error(
  _v2b_mut_arg_through_read :: (fn() -> unit)({
    t := Trio(a : i32(5), b : i32(6), c : i32(7));
    _v2b_bump(t.index(usize(0)));
  }),
  "is a read projection"
);
comptime_expect_error(
  _v2b_write_through_read_binding :: (fn() -> unit)({
    t := Trio(a : i32(5), b : i32(6), c : i32(7));
    r := t.index(usize(0));
    r = i32(1);
  }),
  "is a `&` borrow, which is read-only"
);
// issues/fixed/2026-10-15-a-mut-subscript-argument-writes-through-a-read-only-borrow.md:
// `&mut xs(i)` lent to a known function's `&mut` parameter, with `xs` a `&`
// borrow, passed check (its argument loop never promoted the place to
// `IndexMut`).
comptime_expect_error(
  _v2b_mut_elem_arg_through_shared :: (fn(xs : &ArrayList(i32)) -> unit)({
    _v2b_bump(&mut xs(usize(0)));
  }),
  "is a read-only borrow"
);
// A `&mut` projection call needs a `&mut` root.
comptime_expect_error(
  _v2b_mut_projection_of_shared :: (fn(t : &Trio) -> unit)({
    t.index_mut(usize(0)) = i32(1);
  })
);
// The root is frozen while a binding of the result is live (E0911).
comptime_expect_error(
  _v2b_write_root_under_read :: (fn() -> unit)({
    mut(t) := Trio(a : i32(5), b : i32(6), c : i32(7));
    r := t.index(usize(0));
    t.a = i32(9);
    _v := r;
  }),
  "Cannot write `t.a` here"
);
comptime_expect_error(
  _v2b_overwrite_root_under_read :: (fn() -> unit)({
    mut(t) := Trio(a : i32(5), b : i32(6), c : i32(7));
    r := t.index(usize(0));
    t = Trio(a : i32(1), b : i32(2), c : i32(3));
    _v := r;
  }),
  "Cannot write `t` here"
);
// `m := n` copies `Names` (its `String`s are implicitly copyable until V2b's
// unique buffers), so the move is a `sink` argument.
_v2b_take_names :: (fn(sink(n) : Names) -> usize)(n.first.len());
comptime_expect_error(
  _v2b_move_root_under_read :: (fn() -> unit)({
    n := Names(first : String.from("ab"), second : String.from("xyz"));
    s := n.name(usize(0));
    _k := _v2b_take_names(n);
    _l := s.len();
  }),
  "Cannot move `n` here"
);
comptime_expect_error(
  _v2b_read_root_under_mut :: (fn() -> unit)({
    mut(t) := Trio(a : i32(5), b : i32(6), c : i32(7));
    w := t.index_mut(usize(0));
    x := t.b;
    w = x;
  }),
  "Cannot read `t.b` here"
);
// A binding of the result is second-class: it never leaves the function
// (E0912), and a temporary has no place to borrow.
comptime_expect_error(
  _v2b_return_the_borrow :: (fn(t : &Trio) -> i32)({
    r := t.index(usize(0));
    return(r);
  }),
  "Cannot return the local borrow `r`"
);
_v2b_make_trio :: (fn() -> Trio)(Trio(a : i32(1), b : i32(2), c : i32(3)));
comptime_expect_error(
  _v2b_bind_of_temporary :: (fn() -> unit)({
    r := _v2b_make_trio().index(usize(0));
    _v := r;
  }),
  "which is a temporary"
);
// A projection body that forwards its pointer-bound `self` whole: to a
// method, to a static `Self.helper(self, …)`, and through `addr_of(self)` to a
// raw-pointer helper (the shape of the prelude's `Array` impl).
Quad :: struct(w : i32, x : i32, y : i32, z : i32);
impl(
  Quad,
  _clamp : (fn(self : &Self, idx : usize) -> usize)(
    cond(
      (idx > usize(3)) => usize(3),
      true => idx
    )
  ),
  _slot : (fn(self : &Self, idx : usize) -> usize)(
    self._clamp(idx)
  )
);
_quad_at :: (fn(p : *Quad, i : usize) -> *i32)(
  cond(
    (i == usize(0)) => addr_of(p.*.w),
    (i == usize(1)) => addr_of(p.*.x),
    (i == usize(2)) => addr_of(p.*.y),
    true => addr_of(p.*.z)
  )
);
impl(
  Quad,
  VIndex(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(
      _quad_at(addr_of(self), Self._slot(self, self._clamp(idx)))
    )
  )
);
impl(
  Quad,
  VIndexMut(usize)(
    Output : i32,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)(
      _quad_at(addr_of(self), Self._slot(self, self._clamp(idx)))
    )
  )
);
test("V2b: a projection forwards its self to helpers and through addr_of", {
  q := Quad(w : i32(1), x : i32(2), y : i32(3), z : i32(4));
  assert(q(usize(1)) == i32(2), "q(1) through a method, a static helper and addr_of(self)");
  assert(q(usize(9)) == i32(4), "q(9) clamps to the last slot");
  q(usize(2)) = i32(30);
  assert(q.y == i32(30), "the write reached the caller's field, not a copy");
  q(usize(0)) = (q(usize(0)) + q(usize(3)));
  assert(q.w == i32(5), "q(0) = q(0) + q(3)");
});
// A GENERIC projection whose body branches (`cond`/`match`, an early
// `return(&place)`): its specialization types the arms against `*(T)`, and a
// caller's own `return(...)` is checked against the caller's result
// (issues/fixed/a-swallowed-index-specialization-leaks-its-function-context.md).
Pair2 :: (fn(comptime(T) : Type) -> comptime(Type))(struct(first : T, second : T));
impl(
  generic(T : Type),
  Pair2(T),
  VIndex(usize)(
    Output : T,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)({
      if(idx == usize(0), {
        return(&self.first);
      });
      cond(
        (idx == usize(1)) => &self.second,
        true => &self.first
      )
    })
  )
);
impl(
  generic(T : Type),
  Pair2(T),
  VIndexMut(usize)(
    Output : T,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)(
      match(
        idx,
        0 => &mut self.first,
        _ => &mut self.second
      )
    )
  )
);
_pair2_widen :: (fn(p : &Pair2(u8)) -> i32)({
  b := p(usize(1));
  return(i32(b) + i32(1));
});
test("V2b: a generic branching projection; the caller's return keeps its type", {
  p := Pair2(u8)(first : u8(3), second : u8(7));
  assert(_pair2_widen(&p) == i32(8), "p(1) widened");
  assert(p(usize(0)) == u8(3), "the early return(&self.first)");
  p(usize(1)) = u8(9);
  assert(p.second == u8(9), "the match arm wrote second");
});
// A projection's `return(...)` of a generic raw-pointer call (std's buffer
// form, `return(unsafe(items.ptr().unwrap().add(i)))`): the argument is typed
// against `*(T)`, not `T` (it was E0601 "Cannot unify *(i32) and i32").
_quad_last :: (fn(p : *Quad) -> *i32)(addr_of(p.*.z));
QuadRev :: struct(q : Quad);
impl(
  QuadRev,
  VIndex(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)({
      if(idx == usize(0), {
        return(_quad_last(addr_of(self.q)).add(usize(0)));
      });
      &self.q.w
    })
  )
);
test("V2b: a projection returns a raw-pointer call", {
  r := QuadRev(q : Quad(w : i32(1), x : i32(2), y : i32(3), z : i32(4)));
  assert(r(usize(0)) == i32(4), "r(0) is q.z through return(_quad_last(...))");
  assert(r(usize(1)) == i32(1), "r(1) is q.w");
});
// A projection whose body releases an owning local at scope end: the result
// is materialized into the C `__yo_scope_ret` before the drops, typed `T*`
// (it was `T`, a C error: the std `LinkedList`/`HashMap` index shapes).
Chain :: struct(items : ArrayList(i32));
impl(
  Chain,
  VIndex(usize)(
    Output : i32,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)({
      label := String.from("Chain");
      mut(i) := usize(0);
      while(i < self.items.len(), {
        if(i == idx, {
          return(&self.items(i));
        });
        i = (i + usize(1));
      });
      assert(label.len() == usize(0), "Chain: index out of bounds");
      &self.items(usize(0))
    })
  )
);
test("V2b: a projection that drops a local before yielding its place", {
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(5));
  xs.push(i32(6));
  c := Chain(items : xs);
  assert(c(usize(1)) == i32(6), "c(1) through the loop's return(&...)");
  assert(c(usize(0)) == i32(5), "c(0)");
});
// A generic `Index(K)` impl called with a move-only NAMED local: the call
// moves `k` once, and the impl is specialized and emitted. The
// specialization trial re-ran the argument's move, threw a swallowed E0901,
// and codegen called the unspecialized method, an undeclared C function
// (issues/fixed/2026-10-17-an-index-call-that-moves-a-named-local-calls-an-unemitted-method.md).
_IxKey :: struct(n : i32);
_IxBag :: (fn(comptime(K) : Type) -> comptime(Type))(struct(v : i32));
impl(generic(K : Type), _IxBag(K), Index(K)(Output : i32, index : (fn(self : &Self, idx : K) -> &Self.Output)(&self.v)));
test("Index: a generic impl takes a move-only named local by value", {
  comptime_assert(!Type.impls(_IxKey, Copy) && !Type.impls(_IxKey, Clone), "the key is move-only");
  b := _IxBag(_IxKey)(v : i32(78));
  k := _IxKey(n : i32(1));
  assert(b(k) == i32(78), "the projection reads through the specialized impl");
  comptime_expect_error(k.n, "moved");
  m := HashMap(Box(i32), i32).new();
  m.insert(box(i32(5)), i32(50));
  key := box(i32(5));
  assert(m(key) == i32(50), "a HashMap(Box(K), V) looked up by a named box");
});
// The argument is a temporary that moves a named local: the trial re-ran
// that move too. The key counts its drops, so each case checks it is
// dropped exactly once.
(mut(g_ix_dropped) : i32) = i32(0);
_IxDk :: struct(n : i32);
derive(_IxDk, Eq(_IxDk), Hash);
impl(
  _IxDk,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_ix_dropped = (g_ix_dropped + i32(1));
    })
  )
);
_IxWrap :: struct(k : _IxDk);
_ix_wrap :: (fn(k : _IxDk) -> _IxWrap)(_IxWrap(k : k));
test("Index: a temporary argument that moves a named local", {
  before := g_ix_dropped;
  b := _IxBag(_IxWrap)(v : i32(79));
  k1 := _IxDk(n : i32(1));
  assert(b(_IxWrap(k : k1)) == i32(79), "a constructor that moves the local");
  comptime_expect_error(k1.n, "moved");
  assert(g_ix_dropped == (before + i32(1)), "the index drops the moved key once");
  k2 := _IxDk(n : i32(2));
  assert(b(_ix_wrap(k2)) == i32(79), "a call that moves the local");
  comptime_expect_error(k2.n, "moved");
  assert(g_ix_dropped == (before + i32(2)), "and the second one once");
});
// A write re-dispatches to `index_mut`, specialized the same way. The key
// has no `Drop` and no heap, so this checks only that the write compiles,
// moves the key and lands; the drop-counting shapes (an assignment evaluates
// its place once) are the tests below
// (issues/fixed/2026-10-17-an-assignment-through-an-index-call-runs-the-call-twice.md).
_IxHk :: struct(n : i32);
derive(_IxHk, Eq(_IxHk), Hash);
test("IndexMut: a write through a generic impl with a move-only named key", {
  comptime_assert(!Type.impls(_IxHk, Copy) && !Type.impls(_IxHk, Clone), "the key is move-only");
  m := HashMap(_IxHk, i32).new();
  m.insert(_IxHk(n : i32(5)), i32(50));
  wk := _IxHk(n : i32(5));
  m(wk) = i32(60);
  comptime_expect_error(wk.n, "moved");
  rk := _IxHk(n : i32(5));
  assert(m(rk) == i32(60), "the write landed");
});
// An assignment evaluates its place ONCE: the old-value save and the store
// each spliced the place's rendered C, so a write through an index call ran
// the call twice and dropped its by-value key twice
// (issues/fixed/2026-10-17-an-assignment-through-an-index-call-runs-the-call-twice.md).
// The key counts its drops, so each shape checks the call ran exactly once.
_IxPt :: struct(x : i32, y : i32);
derive(_IxPt, Copy, Clone);
test("IndexMut: a write through an index call drops its key exactly once", {
  m := HashMap(_IxDk, i32).new();
  m.insert(_IxDk(n : i32(5)), i32(50));
  mid := g_ix_dropped;
  key := _IxDk(n : i32(5));
  m(key) = i32(60);
  assert((g_ix_dropped - mid) == i32(1), "the write drops its key once");
  k2 := _IxDk(n : i32(5));
  x := m(k2);
  assert((g_ix_dropped - mid) == i32(2), "the read drops its key once more");
  assert(x == i32(60), "the write landed");
});
test("IndexMut: a field write through an index call drops its key exactly once", {
  p := HashMap(_IxDk, _IxPt).new();
  p.insert(_IxDk(n : i32(9)), _IxPt(x : i32(1), y : i32(2)));
  mid := g_ix_dropped;
  kf := _IxDk(n : i32(9));
  p(kf).x = i32(42);
  assert((g_ix_dropped - mid) == i32(1), "the field write drops its key once");
  kfr := _IxDk(n : i32(9));
  assert(p(kfr).x == i32(42), "the field write landed");
});
test("IndexMut: an array write through an index call drops its key exactly once", {
  a := HashMap(_IxDk, Array(i32, 2)).new();
  a.insert(_IxDk(n : i32(3)), Array(i32, 2)(1, 2));
  mid := g_ix_dropped;
  ka := _IxDk(n : i32(3));
  a(ka) = Array(i32, 2)(3, 4);
  assert((g_ix_dropped - mid) == i32(1), "the array write drops its key once");
  kar := _IxDk(n : i32(3));
  assert(a(kar)(usize(1)) == i32(4), "the array write landed");
});
// The issue's shape, without ASan: the write must land and the key string
// must still be alive after it (the double call freed it before).
test("IndexMut: a String key survives the write it indexes", {
  ms := HashMap(String, i32).new();
  ms.insert(String.from("key-long-enough-to-heap"), i32(1));
  s := String.from("key-long-enough-to-heap");
  ms(s.clone()) = i32(5);
  assert(ms(s.clone()) == i32(5), "the write landed");
  assert(s.len() == usize(23), "the key string is alive after the write");
});
// The nested access `mm(i)(k) = v`: the inner index_mut's receiver is itself
// an index place borrowing into `mm` while the move-only key sits beside it —
// the exact shape the ref-place rule rejects in a USER call, so the index
// specialization trial (which replays the desugared call through the
// user-call machinery) swallowed that rejection, fell back to the
// unspecialized generic method, and codegen called a C function it never
// declared (issues/fixed/2026-10-17-a-nested-index-call-on-generic-impls-calls-an-unspecialized-method.md).
test("IndexMut: a nested write through a generic impl with a move-only key", {
  inner := HashMap(_IxDk, i32).new();
  inner.insert(_IxDk(n : i32(5)), i32(50));
  mm := HashMap(i32, HashMap(_IxDk, i32)).new();
  mm.insert(i32(1), inner);
  mid := g_ix_dropped;
  mm(i32(1))(_IxDk(n : i32(5))) = i32(60);
  assert((g_ix_dropped - mid) == i32(1), "the nested write drops its key once");
  kr := _IxDk(n : i32(5));
  assert(mm(i32(1))(kr) == i32(60), "the nested write landed");
});

// A nested read through user generic impls whose `Output` is a generic
// struct with a PHANTOM parameter (no field mentions `K`). The re-evaluated
// `Self.Output` kept the impl's own `Bag(K)`, which looked concrete because
// `K` sits only in the instance's type arguments, so the outer access's
// specialization was registered with a generic result and never emitted
// while its call site stood
// (issues/fixed/2026-10-17-a-nested-index-call-on-generic-impls-calls-an-unspecialized-method.md).
_IxPBag :: (fn(comptime(K) : Type) -> comptime(Type))(struct(v : i32));
impl(generic(K : Type), _IxPBag(K), Index(K)(Output : i32, index : (fn(self : &Self, idx : K) -> &Self.Output)(&self.v)));
_IxPOuter :: (fn(comptime(K) : Type) -> comptime(Type))(struct(inner : _IxPBag(K)));
impl(generic(K : Type), _IxPOuter(K), Index(K)(Output : _IxPBag(K), index : (fn(self : &Self, idx : K) -> &Self.Output)(&self.inner)));
test("Index: a nested read through generic impls whose Output has a phantom parameter", {
  o := _IxPOuter(i32)(inner : _IxPBag(i32)(v : i32(9)));
  assert(o(i32(1))(i32(2)) == i32(9), "nested read at i32");
  assert(o(i32(1)).v == i32(9), "single read at i32");
  ou := _IxPOuter(u8)(inner : _IxPBag(u8)(v : i32(4)));
  assert(ou(u8(1))(u8(2)) == i32(4), "nested read at u8");
});
