// A `ref` user collection implements `BorrowedWalk` with a raw pointer into
// its list's buffer, so this file needs the pragma for that spelling. The
// safe spelling — forwarding the list's own projection,
// `walk_elem : ... (&mut self.items(cur))` — works through a `ref` receiver
// too since the mutation mask reads the projection tail as a lend (see
// FwdBag below;
// issues/fixed/2026-10-18-a-projection-forwarded-through-a-ref-receiver-leaves-its-borrow-flag-set.md).
// A plain-value collection forwards `&mut self.items(cur)` in safe code.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
/// The borrowed `for` over a USER collection (plans/VALUES_BY_DEFAULT.md
/// decision 39): any type implementing `BorrowedWalk` is a read-walk source
/// (`for(&c, …)`), and with `BorrowedWalkMut` an in-place one (`for(&mut c, …)`). Its
/// mutating methods take `&mut self`; their compiler-emitted invalidation
/// assert must read the OBJECT's borrow flag (`*self`, the receiver is passed
/// as a pointer to the caller's handle slot), not the slot's address —
/// issues/fixed/inout-self-method-borrow-assert-reads-handle-slot.md. The
/// body cannot name the iterated collection (E0911), so the methods below are
/// reached through a second handle of the same object, which the static rule
/// cannot see and the run-time flag guards. The panic side (a mutating method
/// through such a handle) is pinned by
/// tests/cli-cases/inout-self-method-under-borrow-panics.
{ ArrayList } :: import("std/collections/array_list");
{ RefCell } :: import("std/sync/refcell");
Bag :: ref(struct(items : ArrayList(i32), version : i32));
impl(
  Bag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_ref : (fn(self : &Self, cur : &usize) -> &i32)({
      assert(cur < self.items.len(), "Bag: walk cursor out of bounds");
      self.items.ptr().unwrap().add(cur)
    }),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
// The write half: `for(&mut bag, …)` needs `BorrowedWalkMut` too; a type with
// only `BorrowedWalk` is a read-walk source (`for(&bag, …)`).
impl(
  Bag,
  BorrowedWalkMut(
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)({
      assert(cur < self.items.len(), "Bag: walk cursor out of bounds");
      self.items.ptr().unwrap().add(cur)
    })
  )
);
impl(
  Bag,
  bump_version : (fn(self : &mut Self) -> unit)({
    self.version = (self.version + i32(1));
  }),
  reset : (fn(self : &mut Self) -> unit)({
    self = Bag(items : ArrayList(i32).new(), version : i32(0));
  })
);
test("borrowed for over a user collection; &mut self methods assert on the object, not the handle slot", {
  bag := Bag(items : ArrayList(i32).new(), version : i32(0));
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  bag.bump_version();
  assert(bag.version == i32(1), "field store through &mut self outside any borrow");
  mut(total) := i32(0);
  for(&mut bag, x => {
    total = (total + x);
    x = (x * i32(10));
  });
  assert(total == i32(3), "the user collection's BorrowedWalk drives the borrowed loop");
  assert((bag.items(usize(0)) == i32(10)) && (bag.items(usize(1)) == i32(20)), "elements mutated in place");
  bag.bump_version();
  assert(bag.version == i32(2), "the flag is released after the loop: no false panic");
  bag.reset();
  assert((bag.version == i32(0)) && (bag.items.len() == usize(0)), "reassigning through &mut self replaces the caller's handle");
  assert(ref_count(bag) == 1, "the old object was released, the new one is owned once");
});
// The body naming the iterated user collection is E0911, as for std's.
comptime_expect_error(
  method_on_the_borrowed_user_collection :: (fn() -> unit)({
    bag := Bag(items : ArrayList(i32).new(), version : i32(0));
    bag.items.push(i32(1));
    for(&mut bag, x => {
      bag.bump_version();
    });
  })
);
// Two read-only shapes the compiler-emitted invalidation assert must not fire
// for: a body that DECLARES a typed local `(r : T) = init` (the declaration's
// lhs is a colon pair, not a place —
// issues/fixed/borrow-assert-typed-local-declaration-false-positive.md), and a
// body that READS elements by index `self.items(i)` (an index-trait call whose
// callee is recorded on the call, not on its func expr —
// issues/fixed/borrow-assert-index-trait-call-opaque-false-positive.md).
impl(
  Bag,
  first_over : (fn(self : &Self, limit : i32) -> Option(i32))({
    (mut(found) : Option(i32)) = .None;
    mut(i) := usize(0);
    while((i < self.items.len()) && found.is_none(), {
      v := self.items(i);
      if(v > limit, {
        found = .Some(v);
      });
      i = (i + usize(1));
    });
    found
  })
);
test("borrowed for: a read-only user method with a typed local, through an alias, does not trip the flag", {
  xs := ArrayList(i32).new();
  xs.push(i32(6));
  xs.push(i32(8));
  bag := Bag(items : xs, version : i32(0));
  other := bag; // a second handle of the same bag
  mut(seen) := i32(0);
  for(&mut bag, x => {
    match(
      other.first_over(i32(6)),
      .Some(v) => {
        seen = v;
      },
      .None => ()
    );
  });
  assert(seen == i32(8), "a user method with a typed local inside the borrowed body");
});
// The invalidation assert is decided PER PARAMETER from where each mutated
// value's storage lives (plans/archive/INOUT_LOCAL_BINDINGS_AUDIT.md §9, third pass):
// a method that mutates only storage it allocated itself (`clone` pushing into
// its result), or an iterator's own cursor while walking the collection, does
// not mutate the collection and carries no assert. A method that makes fresh
// storage reachable from `self` and then mutates it does — pinned by
// tests/cli-cases/inout-for-store-fresh-into-self-panics.
impl(
  Bag,
  sum_by_value_for : (fn(self : &Self) -> i32)({
    mut(total) := i32(0);
    for(self.items, x => {
      total = (total + x);
    });
    total
  }),
  doubled_copy : (fn(self : &Self) -> ArrayList(i32))({
    copy := self.items.clone();
    mut(i) := usize(0);
    while(i < copy.len(), {
      copy(i) = (copy(i) * i32(2));
      i = (i + usize(1));
    });
    copy.push(i32(0));
    copy
  })
);
test("borrowed for: user methods iterating the collection or mutating a fresh copy, through an alias, do not trip the flag", {
  xs := ArrayList(i32).new();
  xs.push(i32(2));
  xs.push(i32(3));
  bag := Bag(items : xs, version : i32(0));
  other := bag;
  mut(seen) := i32(0);
  for(&mut bag, x => {
    seen = (seen + other.sum_by_value_for());
    d := other.doubled_copy();
    seen = (seen + i32(d.len()));
  });
  assert(seen == i32(16), "a method iterating self and one mutating a fresh copy: no assert");
});
// Forwarding the inner list's own projection is the SAFE spelling of
// `walk_elem`, and works through a `ref` receiver: `walk_elem` is a
// `-> &mut T` method (decision 24), so its compiler-emitted entry
// invalidation assert is skipped — it hands the caller an interior borrow
// of its receiver and runs while the borrowed `for`'s guard holds the
// collection's flag for the walk's extent. Before that, the mutation mask
// answered `all` for the synthesized projection tail, the assert fired on
// the first `walk_elem` call, and the loop aborted with "container
// operation while an interior reference ... borrows from it"
// (issues/fixed/2026-10-18-a-projection-forwarded-through-a-ref-receiver-leaves-its-borrow-flag-set.md).
// "SAFE" means no raw pointer: the guard holds FwdBag's flag, not `items`'s
// (issues/2026-10-24-a-forwarded-walk-leaves-the-inner-collection-unguarded.md).
FwdBag :: ref(struct(items : ArrayList(i32)));
impl(
  FwdBag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_ref : (fn(self : &Self, cur : &usize) -> &i32)(&self.items(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
impl(
  FwdBag,
  BorrowedWalkMut(
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)(&mut self.items(cur))
  )
);
test("borrowed for over a ref collection forwarding the inner projection: no assert, in-place mutation, flag released", {
  bag := FwdBag(items : ArrayList(i32).new());
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  mut(total) := i32(0);
  for(&mut bag, x => {
    total = (total + x);
    x = (x * i32(10));
  });
  assert(total == i32(3), "the forwarded projection drives the borrowed loop");
  assert((bag.items(usize(0)) == i32(10)) && (bag.items(usize(1)) == i32(20)), "elements mutated in place through the forwarded projection");
  bag.items.push(i32(3));
  assert(bag.items.len() == usize(3), "the guard released the flag at loop end: later container calls do not panic");
});
// A read-only method iterating a VALUE field by value, `for(self.c, …)`, runs
// the field's `into_iter`, whose iterator owns a copy of the field, and then
// advances that iterator's own cursor. Neither touches `self`, so the method
// carries no entry assert. Two PARAM-STORAGE mistakes used to give it one
// (issues/fixed/2026-10-23-a-read-only-method-iterating-a-value-field-asserts-its-receiver-unborrowed.md):
// a runtime construction whose compile-time value is a struct SHELL with an
// unknown leaf (`Counter(n : self.n)`, `CIter(src : self.clone(), …)`) read
// as a folded constant that roots nothing, and a local defined with such an
// inert root read back as "never defined", which is unknown storage, so the
// cursor write `next(&mut it)` counted as a write to unknown storage. Each
// shape below goes through a second handle inside a borrowed `for`.
Counter :: struct(n : usize);
derive(Counter, Clone);
CIter :: struct(src : Counter, i : usize);
impl(
  CIter,
  Iterator(
    Item : usize,
    next : (fn(self : &mut Self) -> Option(usize))(
      cond(
        (self.i < self.src.n) => {
          r := self.i;
          self.i = (self.i + usize(1));
          .Some(r)
        },
        true => .None
      )
    )
  )
);
// The iterator holds a derived clone of the source.
impl(
  Counter,
  IntoIterator(
    Item : usize,
    IntoIter : CIter,
    into_iter : (fn(self : &Self) -> CIter)(CIter(src : self.clone(), i : usize(0)))
  )
);
// The iterator is bound to a local, then returned.
CountLocal :: struct(c : Counter);
impl(
  CountLocal,
  IntoIterator(
    Item : usize,
    IntoIter : CIter,
    into_iter : (fn(self : &Self) -> CIter)({
      it := CIter(src : self.c.clone(), i : usize(0));
      it
    })
  )
);
// A fully constant iterator: its value is folded, it roots nothing.
CountConst :: struct(c : Counter);
impl(
  CountConst,
  IntoIterator(
    Item : usize,
    IntoIter : CIter,
    into_iter : (fn(self : &Self) -> CIter)(CIter(src : Counter(n : usize(3)), i : usize(0)))
  )
);
// The copy passes through a chain of locals.
CountChain :: struct(c : Counter);
impl(
  CountChain,
  IntoIterator(
    Item : usize,
    IntoIter : CIter,
    into_iter : (fn(self : &Self) -> CIter)({
      a := self.c.clone();
      b := a;
      CIter(src : b, i : usize(0))
    })
  )
);
// A hand-written `Clone` whose body is a bare constructor.
HCounter :: struct(n : usize);
impl(HCounter, Clone(clone : (fn(self : &Self) -> Self)(HCounter(n : self.n))));
HIter :: struct(src : HCounter, i : usize);
impl(
  HIter,
  Iterator(
    Item : usize,
    next : (fn(self : &mut Self) -> Option(usize))(
      cond(
        (self.i < self.src.n) => {
          r := self.i;
          self.i = (self.i + usize(1));
          .Some(r)
        },
        true => .None
      )
    )
  )
);
impl(
  HCounter,
  IntoIterator(
    Item : usize,
    IntoIter : HIter,
    into_iter : (fn(self : &Self) -> HIter)(HIter(src : self.clone(), i : usize(0)))
  )
);
// A `Copy` source.
PCounter :: struct(n : usize);
derive(PCounter, Copy, Clone);
PIter :: struct(src : PCounter, i : usize);
impl(
  PIter,
  Iterator(
    Item : usize,
    next : (fn(self : &mut Self) -> Option(usize))(
      cond(
        (self.i < self.src.n) => {
          r := self.i;
          self.i = (self.i + usize(1));
          .Some(r)
        },
        true => .None
      )
    )
  )
);
impl(
  PCounter,
  IntoIterator(
    Item : usize,
    IntoIter : PIter,
    into_iter : (fn(self : &Self) -> PIter)(PIter(src : self.clone(), i : usize(0)))
  )
);
VBag :: ref(
  struct(
    items : ArrayList(i32),
    c : Counter,
    local : CountLocal,
    konst : CountConst,
    chain : CountChain,
    h : HCounter,
    p : PCounter
  )
);
impl(
  VBag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_ref : (fn(self : &Self, cur : &usize) -> &i32)(self.items.ptr().unwrap().add(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
impl(
  VBag,
  BorrowedWalkMut(
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)(self.items.ptr().unwrap().add(cur))
  )
);
impl(
  VBag,
  sum_clone : (fn(self : &Self) -> usize)({
    mut(t) := usize(0);
    for(self.c, x => {
      t = (t + x);
    });
    t
  }),
  sum_local : (fn(self : &Self) -> usize)({
    mut(t) := usize(0);
    for(self.local, x => {
      t = (t + x);
    });
    t
  }),
  sum_const : (fn(self : &Self) -> usize)({
    mut(t) := usize(0);
    for(self.konst, x => {
      t = (t + x);
    });
    t
  }),
  sum_chain : (fn(self : &Self) -> usize)({
    mut(t) := usize(0);
    for(self.chain, x => {
      t = (t + x);
    });
    t
  }),
  sum_hand : (fn(self : &Self) -> usize)({
    mut(t) := usize(0);
    for(self.h, x => {
      t = (t + x);
    });
    t
  }),
  sum_copy : (fn(self : &Self) -> usize)({
    mut(t) := usize(0);
    for(self.p, x => {
      t = (t + x);
    });
    t
  })
);
// Handing the object to a callee that only stores it is not a mutation either.
// `RefCell.new` boxes its slot with `box(slot)`, omitting `box`'s
// `alloc ?= .None`: the analysis matches the given arguments to the leading
// parameters instead of giving up on the call.
keep_in_cell :: (fn(b : VBag) -> RefCell(VBag))(RefCell(VBag).new(b));
test("borrowed for: read-only methods iterating a value field by value, through an alias, do not trip the flag", {
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  c := Counter(n : usize(3));
  bag := VBag(
    items : xs,
    c : c.clone(),
    local : CountLocal(c : c.clone()),
    konst : CountConst(c : c.clone()),
    chain : CountChain(c : c.clone()),
    h : HCounter(n : usize(3)),
    p : PCounter(n : usize(3))
  );
  other := bag;
  mut(seen) := usize(0);
  for(&mut bag, x => {
    seen = (seen + other.sum_clone());
    seen = (seen + other.sum_local());
    seen = (seen + other.sum_const());
    seen = (seen + other.sum_chain());
    seen = (seen + other.sum_hand());
    seen = (seen + other.sum_copy());
    cell := keep_in_cell(other);
    seen = (seen + cell.with(v => v.items.len()));
    x = (x * i32(10));
  });
  // Each method sums 0 + 1 + 2 = 3; six methods plus the two-element list, two elements.
  assert(seen == usize(40), "every by-value iteration of a value field runs without the entry assert");
  assert((bag.items(usize(0)) == i32(10)) && (bag.items(usize(1)) == i32(20)), "the borrowed loop still mutates in place");
});
// A callee that writes an INERT module-level global (an `i32`, a `Copy`
// struct of scalars) mutates only that static: no argument's storage is reachable from
// it, so it does not count as mutating every argument. Before the fix such a
// store made the callee's mask `all`, and each read-only `&self` method that
// lent `&self.name` to it got the entry assert, which panicked through a
// second handle inside the borrowed `for`
// (issues/fixed/2026-10-24-a-callee-that-writes-a-scalar-global-is-assumed-to-mutate-every-argument.md).
{ String } :: import("std/string");
GCount :: struct(calls : i32, bytes : usize);
// `Copy`: a non-`Copy` struct is a move-only value, whose store runs drop
// glue, so a store to it still counts as unknown effects.
derive(GCount, Copy, Clone);
(mut(g_scalar_calls) : i32) = i32(0);
(mut(g_scalar_stats) : GCount) = GCount(calls : i32(0), bytes : usize(0));
count_copy :: (fn(s : &String) -> String)({
  g_scalar_calls = (g_scalar_calls + i32(1));
  s.clone()
});
stats_copy :: (fn(s : &String) -> String)({
  g_scalar_stats = GCount(calls : (g_scalar_stats.calls + i32(1)), bytes : g_scalar_stats.bytes);
  g_scalar_stats.bytes = (g_scalar_stats.bytes + s.len());
  s.clone()
});
W3 :: struct(s : String, n : usize);
NBag :: ref(struct(items : ArrayList(i32), name : String));
impl(
  NBag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_ref : (fn(self : &Self, cur : &usize) -> &i32)(self.items.ptr().unwrap().add(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
impl(
  NBag,
  BorrowedWalkMut(
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)(self.items.ptr().unwrap().add(cur))
  )
);
impl(
  NBag,
  label_ctor : (fn(self : &Self) -> usize)({
    w := W3(s : count_copy(&self.name), n : usize(1));
    w.s.len()
  }),
  label_plain : (fn(self : &Self) -> usize)({
    s := count_copy(&self.name);
    s.len()
  }),
  label_stats : (fn(self : &Self) -> usize)({
    s := stats_copy(&self.name);
    s.len()
  })
);
test("borrowed for: a callee that only writes a scalar global does not trip the flag through an alias", {
  bag := NBag(items : ArrayList(i32).new(), name : String.from("ab"));
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  other := bag;
  mut(seen) := usize(0);
  for(&mut bag, x => {
    seen = (seen + other.label_ctor());
    seen = (seen + other.label_plain());
    seen = (seen + other.label_stats());
    x = (x + i32(1));
  });
  // Three labels of length 2, two elements.
  assert(seen == usize(12), "every read-only label runs without the entry assert");
  assert(g_scalar_calls == i32(4), "the scalar global counted each call");
  assert((g_scalar_stats.calls == i32(2)) && (g_scalar_stats.bytes == usize(4)), "the struct-of-scalars global counted each call");
  assert((bag.items(usize(0)) == i32(2)) && (bag.items(usize(1)) == i32(3)), "the borrowed loop still mutates in place");
});
// The read walk `for(&c, …)` (B7a) drives a user collection through
// `walk_ref`: the raw-pointer spelling (Bag) and the forwarded inner read
// projection (FwdBag). Neither the collection nor an element is copied.
test("read walk over user collections: walk_ref through a pointer and through a forwarded projection", {
  bag := Bag(items : ArrayList(i32).new(), version : i32(0));
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  (mut(total) : i32) = i32(0);
  for(&bag, x => {
    total = (total + x);
    total = (total + bag.version); // the body may read the walked collection
  });
  assert(total == i32(3), "Bag's walk_ref drives the read walk");
  fwd := FwdBag(items : ArrayList(i32).new());
  fwd.items.push(i32(5));
  fwd.items.push(i32(6));
  total = i32(0);
  for(&fwd, x => {
    total = (total + x);
  });
  assert(total == i32(11), "the forwarded read projection drives the read walk");
  fwd.items.push(i32(7));
  assert(fwd.items.len() == usize(3), "the guard released the flag at loop end");
});
// A user type implementing ONLY `BorrowedWalk` is a read-walk source, and the
// in-place walk over it is an error naming `BorrowedWalkMut`. The loop's flag
// guards the wrapper, not `items`: a body that shared `rb.items` and grew it
// would leave `x` dangling
// (issues/2026-10-24-a-forwarded-walk-leaves-the-inner-collection-unguarded.md).
ReadOnlyBag :: struct(items : ArrayList(i32));
impl(
  ReadOnlyBag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_ref : (fn(self : &Self, cur : &usize) -> &i32)(&self.items(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
test("a read-only user collection is a read-walk source", {
  rb := ReadOnlyBag(items : ArrayList(i32).new());
  rb.items.push(i32(4));
  rb.items.push(i32(5));
  (mut(total) : i32) = i32(0);
  for(&rb, x => {
    total = (total + x);
  });
  assert(total == i32(9), "the forwarded walk_ref needs no pragma");
});
comptime_expect_error(
  write_walk_over_a_read_only_user_collection :: (fn() -> unit)({
    (mut(rb) : ReadOnlyBag) = ReadOnlyBag(items : ArrayList(i32).new());
    rb.items.push(i32(1));
    for(&mut rb, x => {
      x = i32(2);
    });
  }),
  "needs `BorrowedWalkMut`"
);
