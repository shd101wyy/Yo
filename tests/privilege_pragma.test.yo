pragma(Pragma.AllowUnsafe);
/// Positive end-to-end coverage for the `pragma(Pragma.AllowUnsafe);`
/// privilege gate (Phase C of plans/MEMORY_SAFETY.md).
///
/// `tests/unsafe.test.yo` already covers the *shape* of `unsafe(...)`:
/// transparency, nesting, control-flow wrapping. The negative side
/// (pointer ops outside `unsafe(...)` in a file *without* the pragma)
/// lives in `src/tests/unsafe-gate.test.ts`, which spawns `yo-cli` on
/// a temp file and asserts the error message.
///
/// This file pins the *positive* contract from inside a real
/// pragma-declaring source file: every pointer operation the gate
/// could reject must succeed when both the pragma is present and the
/// operation is wrapped in `unsafe(...)`. If any of these regresses,
/// the binary won't even link; the test bodies double-check the
/// runtime semantics.
test("AllowUnsafe + unsafe(deref) reads a known value", {
  x := i32(7);
  p := &(x);
  v := unsafe(p.*);
  assert(v == i32(7), "deref reads through &(x)");
});
test("AllowUnsafe + unsafe(write deref) mutates the pointee", {
  x := i32(0);
  p := &(x);
  unsafe(p.* = i32(99));
  assert(x == i32(99), "write through &(x) is visible at the original binding");
});
test("AllowUnsafe + unsafe(pointer arith) walks an array", {
  arr := [i32(10), i32(20), i32(30)];
  count := usize(0);
  sum := i32(0);
  while(count < usize(3), {
    // Synthesize the raw pointer to the current element from the
    // array base + offset, then round-trip through `&-` / `&+` to
    // prove pointer arithmetic walks element-by-element.
    ptr := unsafe(&(arr(count)));
    if(count > usize(0), {
      base := unsafe(ptr &- count);
      via_arith := unsafe(base &+ count);
      assert(unsafe(via_arith.*) == unsafe(ptr.*), "&+ and &- round-trip to the same element");
    });
    sum = (sum + unsafe(ptr.*));
    count = (count + usize(1));
  });
  assert(sum == i32(60), "iterated through all three elements");
});
test("AllowUnsafe + unsafe(...) is transparent inside a begin-block", {
  x := i32(3);
  p := &(x);
  doubled := unsafe({
    v := p.*;
    v + v
  });
  assert(doubled == i32(6), "block expression returns the inner value");
});
// ============================================================================
// Phase A (THREAD_SAFETY): Manual impl(T, Send/Acyclic()) under pragma.
// Auto-derived Acyclic is withheld from self-referential atomic objects
// (correctly — the compiler can't prove no cycles form). Pragma'd code
// can manually declare Acyclic when it audit-establishes immutability.
// ============================================================================
test("AllowUnsafe + manual impl(T, Acyclic()) for self-referential atomic object", {
  ImmNode :: atomic(ref(struct(_value : i32, _next : Option(Self))));
  // SAFETY: ImmNode is immutable — its fields are never mutated after
  // construction, so no cycles can form at runtime.
  impl(ImmNode, Acyclic());
  comptime_assert(Type.impls(ImmNode, Acyclic), "manual Acyclic impl should work");
});
test("AllowUnsafe + manual impl(T, Send()) for a wrapper type", {
  Wrapper :: newtype(inner : i32);
  // SAFETY: Wrapper is a newtype over i32 with no heap allocations.
  impl(Wrapper, Send());
  comptime_assert(Type.impls(Wrapper, Send), "manual Send impl should work");
});
// ============================================================================
// Phase F (THREAD_SAFETY): Atomic object field re-verification.
// When a manual impl(T, Send()) is registered against an atomic object type,
// Phase F re-verifies that all fields are truly Send transitively. This is
// the safety belt: even though Phase A allows the impl (pragma is present),
// the actual field contents must match the Send claim.
// ============================================================================
test("Phase F: manual Send impl on valid atomic object passes re-verification", {
  // i32 and u32 are both Send, so this atomic object is valid
  Pair :: atomic(ref(struct(a : i32, b : u32)));
  // SAFETY: Pair's fields (i32, u32) are trivially Send value types.
  impl(Pair, Send());
  comptime_assert(Type.impls(Pair, Send), "Pair should impl Send");
});
// Phase F catches a manual Send impl on an atomic object whose fields
// were Send at definition time but whose impl is a lie. This is tested
// via comptime_expect_error in the structural gates test file.
// The struct-definition-time check (struct.ts) catches the common case
// of a non-Send field at type creation time.
