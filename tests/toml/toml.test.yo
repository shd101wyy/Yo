{ assert } :: import("std/assert");
{ toml_parse, TomlValue } :: import("std/encoding/toml");
open(import("std/string"));
test("Empty table", {
  t := TomlValue.new_table();
  assert(t.table_len() == usize(0), "new table should be empty");
  assert(!(t.has_key(`x`)), "should not have key x");
});
test("Table set and get", {
  t := TomlValue.new_table();
  t.insert(`name`, .Str(`hello`));
  assert(t.table_len() == usize(1), "should have 1 entry");
  assert(t.has_key(`name`), "should have key name");
  val := t.get(`name`);
  assert(val.is_some(), "should find name");
  s := val.unwrap().as_string();
  assert(s.is_some(), "should be string");
  assert(s.unwrap() == `hello`, "should be hello");
});
test("Table set overwrites", {
  t := TomlValue.new_table();
  t.insert(`x`, .Int(i64(1)));
  t.insert(`x`, .Int(i64(2)));
  assert(t.table_len() == usize(1), "should still have 1 entry");
  assert(t.get(`x`).unwrap().as_int().unwrap() == i64(2), "should be 2");
});
test("Parse empty string", {
  result := toml_parse(``);
  assert(result.is_ok(), "should parse empty string");
  assert(result.unwrap().table_len() == usize(0), "should be empty");
});
test("Parse string value", {
  result := toml_parse(`name = "hello"`);
  assert(result.is_ok(), "should parse");
  table := result.unwrap();
  s := table.get(`name`).unwrap().as_string();
  assert(s.is_some(), "should be string");
  assert(s.unwrap() == `hello`, "should be hello");
});
test("Parse integer value", {
  result := toml_parse(`port = 8080`);
  assert(result.is_ok(), "should parse");
  table := result.unwrap();
  n := table.get(`port`).unwrap().as_int();
  assert(n.is_some(), "should be int");
  assert(n.unwrap() == i64(8080), "should be 8080");
});
test("Parse boolean values", {
  input :=
    `debug = true
verbose = false`;
  result := toml_parse(input);
  assert(result.is_ok(), "should parse");
  table := result.unwrap();
  assert(table.get(`debug`).unwrap().as_bool().unwrap(), "debug should be true");
  assert(!(table.get(`verbose`).unwrap().as_bool().unwrap()), "verbose should be false");
});
test("Parse with comments and blank lines", {
  input :=
    `# comment
name = "test"

# another comment
count = 42`;
  result := toml_parse(input);
  assert(result.is_ok(), "should parse");
  table := result.unwrap();
  assert(table.table_len() == usize(2), "should have 2 entries");
  assert(table.has_key(`name`), "should have name");
  assert(table.has_key(`count`), "should have count");
});
test("Parse table sections", {
  input :=
    `title = "My App"

[server]
host = "localhost"
port = 8080`;
  result := toml_parse(input);
  assert(result.is_ok(), "should parse");
  root := result.unwrap();
  assert(root.get(`title`).unwrap().as_string().unwrap() == `My App`, "title");
  srv := root.get(`server`).unwrap();
  assert(srv.get(`host`).unwrap().as_string().unwrap() == `localhost`, "host");
  assert(srv.get(`port`).unwrap().as_int().unwrap() == i64(8080), "port");
});
test("Parse multiple tables", {
  input :=
    `[database]
name = "mydb"
port = 5432

[logging]
level = "info"
enabled = true`;
  result := toml_parse(input);
  assert(result.is_ok(), "should parse");
  root := result.unwrap();
  db := root.get(`database`).unwrap();
  assert(db.get(`name`).unwrap().as_string().unwrap() == `mydb`, "db name");
  assert(db.get(`port`).unwrap().as_int().unwrap() == i64(5432), "db port");
  log := root.get(`logging`).unwrap();
  assert(log.get(`level`).unwrap().as_string().unwrap() == `info`, "log level");
  assert(log.get(`enabled`).unwrap().as_bool().unwrap(), "log enabled");
});
