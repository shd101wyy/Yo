//! `addr_of(x)` is the raw-pointer address-of, and `&x` is only a borrow
//! marker (plans/VALUES_BY_DEFAULT.md decision 33, V3b Generation B step 3):
//! passed to an `imm` parameter, a generic one included, it lends `x`;
//! anywhere else it is an error naming `addr_of(x)` (and, for a by-value
//! parameter, `x` and `x.clone()`). This holds in unsafe files too.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ String } :: import("std/string");

_ao_write :: (fn(p : *i32, v : i32) -> unit)({
  p.* = v;
});
_ao_id :: (fn(generic(T : Type), x : &T) -> T)(x);
_ao_own :: (fn(generic(T : Type), x : T) -> T)(x);
_ao_len :: (fn(s : &String) -> usize)(s.len());
_ao_take :: (fn(s : String) -> usize)(s.len());
_ao_sink :: (fn(sink(s) : String) -> usize)(s.len());
_AoBox :: struct(n : i32);
impl(_AoBox, get : (fn(self : &Self) -> i32)(self.n));

test("addr_of produces a raw pointer", {
  (n : i32) = i32(1);
  p := addr_of(n);
  comptime_assert(Type.is_compatible_with(type_of(p), *i32), "addr_of(n) : *(i32)");
  p.* = i32(7);
  assert(n == i32(7), "a write through the pointer lands in n");
  assert(addr_of(n) == p, "the same address each time");
});

test("addr_of(x) to a pointer or generic by-value parameter", {
  (n : i32) = i32(1);
  _ao_write(addr_of(n), i32(10));
  assert(n == i32(10), "addr_of(n) to a *(i32) parameter");
  q := _ao_own(addr_of(n));
  comptime_assert(Type.is_compatible_with(type_of(q), *i32), "addr_of(n) to a generic parameter infers a pointer");
  q.* = i32(11);
  assert(n == i32(11), "the generic parameter received n's address");
});

test("&x to a generic imm parameter lends x", {
  (n : i32) = i32(5);
  r := _ao_id(&n);
  comptime_assert(Type.is_compatible_with(type_of(r), i32), "&n to a generic imm parameter infers i32, not *(i32)");
  assert(r == i32(5), "the generic parameter read n");
});

test("&x to a non-pointer imm parameter lends x", {
  s := String.from("abc");
  assert(_ao_len(&s) == usize(3), "&s to a String parameter is a borrow");
  assert(s.len() == usize(3), "s stays usable");
});

test("&x to a raw-pointer parameter is an error naming addr_of(x)", {
  (n : i32) = i32(1);
  comptime_expect_error(_ao_write(&n, i32(2)), "take the address with `addr_of(n)`");
  assert(n == i32(1), "nothing was written");
  // The message spells a field place as written, not as the AST printer's
  // `((b.n))`.
  b := _AoBox(n : i32(3));
  comptime_expect_error(_ao_write(&b.n, i32(2)), "take the address with `addr_of(b.n)`");
});

test("&x to a by-value parameter is an error naming x and x.clone()", {
  s := String.from("abc");
  comptime_expect_error(_ao_take(&s), "takes its argument by value: pass `s`");
  comptime_expect_error(_ao_take(&s), "`s.clone()` to keep `s`");
  comptime_expect_error(_ao_sink(&s), "takes its argument by value");
  (n : i32) = i32(1);
  comptime_expect_error(_ao_own(&n), "takes its argument by value");
  assert(s.len() == usize(3), "s stays usable");
});

test("&x outside an argument is an error naming addr_of(x)", {
  (n : i32) = i32(1);
  // `p := &n` is a local borrow since decision 42; a pointer-typed
  // binding is not a slot that holds a borrow.
  comptime_expect_error({
    (p : *i32) = &n;
  }, "Take a raw pointer with `addr_of(n)`");
  b := _AoBox(n : i32(4));
  comptime_expect_error((&b).get(), "a method receiver is written bare");
  assert(b.get() == i32(4), "the receiver is passed bare");
  assert(n == i32(1), "n is untouched");
});
// A `unit` place has no C storage, so `addr_of` of one emitted `(&)`, which
// is not C. It is a dangling, non-null pointer that nothing reads or writes
// through (issues/fixed/2026-10-16-a-pointer-move-of-a-unit-place-emits-invalid-c.md).
_AoUnitField :: struct(a : i32, u : unit);
test("addr_of a unit place: a non-null pointer, and moves through it touch nothing", {
  s := _AoUnitField(a : i32(7), u : ());
  p := addr_of(s.u);
  old := __yo_ptr_read(p);
  __yo_ptr_write(p, old);
  __yo_ptr_write(addr_of(s.u), ());
  (o : ?*unit) = .Some(p);
  assert(o.is_some(), "non-null, so not the None niche");
  assert(s.a == i32(7), "the field beside it is untouched");
});
// E0921: a `&T` parameter is passed as a copy of the caller's value
// (decision 34; today every size of `T`, `fn_param_is_ptr_borrow`), so
// `addr_of` of it, or of a place inside it, is the callee's copy, which
// dangles once the call returns (maintainer verdict 2026-10-25,
// issues/retired/2026-10-25-should-addr-of-a-borrowed-parameter-be-rejected.md).
_AoSmall :: struct(n : usize);
derive(_AoSmall, Copy, Clone);
_AoBig :: struct(a : usize, b : usize, c : usize, d : usize, e : usize, f : usize, g : usize, h : usize);
_AoHandle :: ref(struct(n : usize));
test("addr_of of a &T parameter is E0921: small Copy T, large T, self, generic T, a field", {
  s := _AoSmall(n : usize(1));
  comptime_expect_error({
    _ao_small_where :: (fn(x : &_AoSmall) -> *_AoSmall)(addr_of(x));
    _ao_small_where(&s);
  }, "a `&T` parameter has no stable address");
  big := _AoBig(a : usize(1), b : usize(2), c : usize(3), d : usize(4), e : usize(5), f : usize(6), g : usize(7), h : usize(8));
  comptime_expect_error({
    _ao_big_where :: (fn(x : &_AoBig) -> *_AoBig)(addr_of(x));
    _ao_big_where(&big);
  }, "a `&T` parameter has no stable address");
  comptime_expect_error({
    _AoSelf :: struct(n : usize);
    impl(_AoSelf, where_is : (fn(self : &Self) -> *Self)(addr_of(self)));
    o := _AoSelf(n : usize(1));
    o.where_is();
  }, "a `&T` parameter has no stable address");
  comptime_expect_error({
    _ao_gen_where :: (fn(generic(T : Type), x : &T) -> *T)(addr_of(x));
    _ao_gen_where(&s);
  }, "a `&T` parameter has no stable address");
  comptime_expect_error({
    _ao_field_where :: (fn(x : &_AoBig) -> *usize)(addr_of(x.c));
    _ao_field_where(&big);
  }, "takes the address of a place inside `x`");
  comptime_expect_error({
    _ao_capture_where :: (fn(x : &_AoSmall) -> *_AoSmall)({
      (f : Impl(Fn() -> *_AoSmall)) = (() => addr_of(x));
      f()
    });
    _ao_capture_where(&s);
  }, "a `&T` parameter has no stable address");
});
_ao_ptr_param :: (fn(x : *_AoBig) -> *_AoBig)(x);
_ao_mut_param :: (fn(x : &mut _AoBig) -> *_AoBig)(addr_of(x));
_ao_mut_field :: (fn(x : &mut _AoBig) -> *usize)(addr_of(x.c));
_ao_handle_field :: (fn(x : &_AoHandle) -> *usize)(addr_of(x.n));
_ao_local :: (fn(x : &_AoSmall) -> usize)({
  (copy : _AoSmall) = x;
  p := addr_of(copy);
  p.*.n
});
_ao_projection :: (fn(x : &_AoBig) -> &usize)(&x.c);
test("the forms that give the caller's address: *T, &mut T, a ref handle's field, a local, a projection", {
  mut(big) := _AoBig(a : usize(1), b : usize(2), c : usize(3), d : usize(4), e : usize(5), f : usize(6), g : usize(7), h : usize(8));
  assert(_ao_ptr_param(addr_of(big)) == addr_of(big), "a *T parameter carries the caller's address");
  assert(_ao_mut_param(&mut big) == addr_of(big), "a &mut T parameter is a pointer");
  assert(_ao_mut_field(&mut big) == addr_of(big.c), "a field of a &mut T parameter is the caller's field");
  h := _AoHandle(n : usize(4));
  assert(_ao_handle_field(&h) == addr_of(h.n), "a ref handle's field lives in the shared cell");
  assert(_ao_local(&_AoSmall(n : usize(9))) == usize(9), "a local copy has its own address");
  assert(_ao_projection(&big) == usize(3), "a projection's &T parameter is a pointer");
  arr := [usize(1), usize(2), usize(3)];
  assert(arr(1) == usize(2), "the prelude's Array Index takes addr_of of its projection receiver");
});
