// PREFIX_OPERATOR_OPERAND_RULE.md Rule 1: a bare prefix-capable operator
// (`-` `!` `~` `&` `*` `?` `^`) followed by a primary binds exactly ONE
// postfix expression — `-1`, `!x`, `?*T`, `3 - -3` — with parenthesized
// spellings (`-(1)`) unchanged and parenthesized operator ATOMS (`(!)`)
// still values. The pragma is for the raw-pointer TYPES used in the
// `?*T`/`**T` assertions.
pragma(Pragma.AllowUnsafe);
import("std/string");
{ assert } :: import("std/assert");

identity :: (fn(x : i32) -> i32)(x);
Pair :: struct(a : i32, b : i32);
derive(Pair, Copy, Clone);

my_not :: (!);

test("prefix minus: -1, 3 - -3, - -1, 3--3", {
  x := -1;
  assert(x == -1, "-1 is -(1)");
  assert((-1 + 2) == 1, "-1 + 2 groups as (-1) + 2");
  assert((3 - -3) == 6, "3 - -3");
  assert((3 - -3) == 6, "3 - -(3) unchanged");
  assert(- -1 == 1, "- -1 is -(-(1))");
  assert((3 - -3) == 6, "3--3: -- is not a token, it splits");
});

test("prefix operand is one postfix expression", {
  assert(-identity(2) == -2, "-f(x) binds the call");
  p := Pair(a : 7, b : 0);
  assert(-p.a == -7, "-p.a binds the dot chain");
  assert((-identity(2) + 5) == 3, "then infix applies to the prefix result");
});

test("prefix ! and ~", {
  flag := false;
  assert(!flag, "!x");
  assert(!false == true, "!false literal");
  v := cond(!flag => i32(1), true => i32(2));
  assert(v == i32(1), "!x in a cond arm condition");
  assert(~u8(0) == u8(255), "~x complement");
});

test("prefix & address-of", {
  x := i32(41);
  p := addr_of(x);
  q := addr_of(x);
  assert(unsafe(p.*) == unsafe(q.*), "&x is &(x)");
});

test("prefix type constructors: ?T, *T, ?*T, **T", {
  __a :: comptime_assert(__yo_are_types_equal(?i32, Option(i32)), "?T is Option(T)");
  __b :: comptime_assert(__yo_are_types_equal(*i32, *i32), "*T is *(T)");
  __c :: comptime_assert(__yo_are_types_equal(?*i32, ?*i32), "?*T composes Option(*(T))");
  __d :: comptime_assert(__yo_are_types_equal(**i32, **i32), "**T is *(*(T))");
  assert(true, "comptime type assertions evaluated");
});

test("parenthesized operator atoms stay values", {
  assert(my_not(false), "(!) bound as a value and called");
});

// `!` on the pointee of a pointer that is a call's result, inside a function
// with a comptime parameter: the specialization binds the pointer to a
// runtime-only placeholder, and its deref used to drop that flag, so `!`
// picked `comptime_not` and reported a false E1101
// (issues/fixed/2026-10-16-not-on-a-runtime-bool-in-a-comptime-type-parameterized-fn-is-e1101.md).
_NotCell :: (fn(comptime(T) : Type) -> comptime(Type))(struct(flag : bool, v : T));
_not_take :: (fn(comptime(T) : Type, p : *_NotCell(T)) -> bool)({
  was_clear := !unsafe(p.*.flag);
  unsafe(consume(p.*.flag = false));
  was_clear
});
_not_flag :: (fn(comptime(T) : Type, p : *bool) -> bool)(!unsafe(p.*));
_not_ptr :: (fn(b : &Box(bool)) -> *bool)(addr_of(b.*));
_NotWrap :: (fn(comptime(T) : Type) -> comptime(Type))(struct(st : Box(_NotCell(T))));
impl(
  generic(T : Type),
  _NotWrap(T),
  cell : (fn(self : &Self) -> *_NotCell(T))(addr_of(self.st.*)),
  take : (fn(self : &Self) -> bool)(_not_take(T, self.cell()))
);
// Each result is bound before it is asserted; the test after this one makes
// the calls operands of `!`.
test("! on a runtime pointee through a call-result pointer in a comptime-parameterized fn", {
  w := _NotWrap(i32)(st : box(_NotCell(i32)(flag : true, v : i32(1))));
  first := w.take();
  assert(first == false, "the flag was set: ! of true");
  second := w.take();
  assert(second, "take cleared the flag: ! of false");
  mut(b) := box(false);
  clear := _not_flag(i32, _not_ptr(&b));
  assert(clear, "! of a bool read through a call's pointer");
  b.* = true;
  set := _not_flag(u8, _not_ptr(&b));
  assert(set == false, "the same read sees the new value");
});

// A specialization an overload trial creates outlives the trial: `!`'s
// candidates (`not`, `comptime_not`) are trial-called with the operand, and
// the call in the operand specializes its callee. Its body was evaluated in
// the trial's checking phase, where a deref of a call-result pointer is a
// compile-time placeholder, so the store through it was taken as compile-time
// only and never emitted; every later call reused that body
// (issues/fixed/2026-10-17-a-store-in-a-comptime-parameterized-fn-is-dropped-when-its-first-call-is-an-operand-of-not.md).
_NotStoreCell :: struct(flag : bool);
_not_store_take :: (fn(comptime(T) : Type, p : *_NotStoreCell) -> bool)({
  (was : bool) = unsafe(p.*.flag);
  unsafe(consume(p.*.flag = false));
  was
});
_not_store_only :: (fn(comptime(T) : Type, p : *_NotStoreCell) -> bool)({
  unsafe(consume(p.*.flag = false));
  true
});
_not_store_cell :: (fn(b : &Box(_NotStoreCell)) -> *_NotStoreCell)(addr_of(b.*));
test("a store in a comptime-parameterized fn first called as an operand of ! is emitted", {
  c := box(_NotStoreCell(flag : true));
  assert(!!_not_store_take(i32, _not_store_cell(&c)), "the first call reads the set flag");
  assert(!_not_store_take(i32, _not_store_cell(&c)), "the first call's store cleared it");
  d := box(_NotStoreCell(flag : true));
  assert(!!_not_store_only(u8, _not_store_cell(&d)), "a store with no read before it");
  assert(!d.*.flag, "that store ran too");
  w := _NotWrap(i64)(st : box(_NotCell(i64)(flag : true, v : i64(1))));
  assert(!w.take(), "through a generic method: ! of the set flag");
  assert(w.take(), "the method's store cleared the flag");
});
