{ assert } :: import("std/assert");
open(import("std/collections/array_list"));
open(import("std/fmt"));
{ SortedSet } :: import("std/imm/sorted_set");
{ List } :: import("std/imm/list");
test("SortedSet new is empty", {
  s := SortedSet(i32).new();
  assert(s.is_empty(), "new set should be empty");
  assert(s.len() == usize(0), "len should be 0");
});
test("SortedSet insert and contains", {
  s := SortedSet(i32).new();
  s = s.insert(i32(42));
  assert(s.contains(i32(42)), "should contain 42");
  assert(!(s.contains(i32(99))), "should not contain 99");
  assert(s.len() == usize(1), "len should be 1");
});
test("SortedSet insert duplicate", {
  s := SortedSet(i32).new();
  s = s.insert(i32(1));
  s = s.insert(i32(1));
  assert(s.len() == usize(1), "duplicate insert should not increase len");
});
test("SortedSet insert multiple and sorted order", {
  s := SortedSet(i32).new();
  s = s.insert(i32(5));
  s = s.insert(i32(3));
  s = s.insert(i32(7));
  s = s.insert(i32(1));
  assert(s.len() == usize(4), "len should be 4");
  elems := s.to_list();
  assert(elems.len() == usize(4), "list len 4");
  // Verify sorted: 1, 3, 5, 7
  (cur : List(i32)) = elems;
  (prev : i32) = i32(-(1));
  (sorted : bool) = true;
  (done : bool) = false;
  while(runtime(!(done)), {
    match(
      cur.head(),
      .Some(v) => {
        if(v <= prev, {
          sorted = false;
        });
        prev = v;
        cur = cur.tail();
      },
      .None => {
        done = true;
      }
    );
  });
  assert(sorted, "elements should be in sorted order");
});
test("SortedSet remove", {
  s := SortedSet(i32).new();
  s = s.insert(i32(1));
  s = s.insert(i32(2));
  s = s.insert(i32(3));
  s2 := s.remove(i32(2));
  assert(s2.len() == usize(2), "after remove len 2");
  assert(!(s2.contains(i32(2))), "2 removed");
  assert(s2.contains(i32(1)), "1 still there");
  assert(s2.contains(i32(3)), "3 still there");
  // original unchanged
  assert(s.len() == usize(3), "original unchanged");
});
test("SortedSet min and max", {
  s := SortedSet(i32).new();
  s = s.insert(i32(5));
  s = s.insert(i32(2));
  s = s.insert(i32(8));
  s = s.insert(i32(1));
  s = s.insert(i32(9));
  min_v := s.min();
  match(
    min_v,
    .Some(v) => assert(v == i32(1), "min should be 1"),
    .None => assert(false, "should have min")
  );
  max_v := s.max();
  match(
    max_v,
    .Some(v) => assert(v == i32(9), "max should be 9"),
    .None => assert(false, "should have max")
  );
});
test("SortedSet union", {
  a := SortedSet(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(3));
  b := SortedSet(i32).new();
  b = b.insert(i32(2));
  b = b.insert(i32(3));
  c := a.union(b);
  assert(c.len() == usize(3), "union has 3");
  assert(c.contains(i32(1)), "contains 1");
  assert(c.contains(i32(2)), "contains 2");
  assert(c.contains(i32(3)), "contains 3");
});
test("SortedSet intersection", {
  a := SortedSet(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  a = a.insert(i32(3));
  b := SortedSet(i32).new();
  b = b.insert(i32(2));
  b = b.insert(i32(3));
  b = b.insert(i32(4));
  c := a.intersection(b);
  assert(c.len() == usize(2), "intersection has 2");
  assert(c.contains(i32(2)), "contains 2");
  assert(c.contains(i32(3)), "contains 3");
});
test("SortedSet difference", {
  a := SortedSet(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  a = a.insert(i32(3));
  b := SortedSet(i32).new();
  b = b.insert(i32(2));
  c := a.difference(b);
  assert(c.len() == usize(2), "difference has 2");
  assert(c.contains(i32(1)), "contains 1");
  assert(c.contains(i32(3)), "contains 3");
  assert(!(c.contains(i32(2))), "does not contain 2");
});
test("SortedSet is_subset", {
  a := SortedSet(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  b := SortedSet(i32).new();
  b = b.insert(i32(1));
  b = b.insert(i32(2));
  b = b.insert(i32(3));
  assert(a.is_subset(b), "a is subset of b");
  assert(!(b.is_subset(a)), "b is not subset of a");
});
test("SortedSet is_disjoint", {
  a := SortedSet(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  b := SortedSet(i32).new();
  b = b.insert(i32(3));
  b = b.insert(i32(4));
  assert(a.is_disjoint(b), "a and b disjoint");
  c := SortedSet(i32).new();
  c = c.insert(i32(2));
  assert(!(a.is_disjoint(c)), "a and c not disjoint");
});
test("SortedSet Eq trait", {
  a := SortedSet(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  b := SortedSet(i32).new();
  b = b.insert(i32(2));
  b = b.insert(i32(1));
  assert(a == b, "same elements should be equal");
  c := SortedSet(i32).new();
  c = c.insert(i32(1));
  assert(!(a == c), "different sets not equal");
});
test("SortedSet structural sharing", {
  s := SortedSet(i32).new();
  s = s.insert(i32(1));
  s = s.insert(i32(2));
  s2 := s.insert(i32(3));
  assert(s.len() == usize(2), "original still 2");
  assert(s2.len() == usize(3), "new has 3");
  assert(!(s.contains(i32(3))), "original doesn't have 3");
});
test("SortedSet many elements", {
  (s : SortedSet(i32)) = SortedSet(i32).new();
  (i : i32) = i32(0);
  while(runtime(i < i32(50)), {
    s = s.insert(i);
    i = (i + i32(1));
  });
  assert(s.len() == usize(50), "should have 50 elements");
  assert(s.contains(i32(0)), "contains 0");
  assert(s.contains(i32(25)), "contains 25");
  assert(s.contains(i32(49)), "contains 49");
});
test("SortedSet from_list single element", {
  arr := [i32 ; 1](i32(42));
  s := SortedSet(i32).from_list(ArrayList(i32).from_array(arr));
  assert(s.len() == usize(1), "len = 1");
  assert(s.contains(i32(42)), "contains 42");
});
test("SortedSet from_list with elements", {
  arr := [i32 ; 4](i32(30), i32(10), i32(40), i32(20));
  s := SortedSet(i32).from_list(ArrayList(i32).from_array(arr));
  assert(s.len() == usize(4), "len = 4");
  assert(s.contains(i32(10)), "contains 10");
  assert(s.contains(i32(30)), "contains 30");
  assert(!(s.contains(i32(50))), "does not contain 50");
  // should be sorted
  assert(s.min().unwrap() == i32(10), "min = 10");
  assert(s.max().unwrap() == i32(40), "max = 40");
});
test("SortedSet from_list duplicates", {
  arr := [i32 ; 4](i32(1), i32(2), i32(1), i32(3));
  s := SortedSet(i32).from_list(ArrayList(i32).from_array(arr));
  assert(s.len() == usize(3), "duplicates collapsed");
});
test("SortedSet from_list equals manual insert", {
  s1_arr := [i32 ; 3](i32(1), i32(2), i32(3));
  s1 := SortedSet(i32).from_list(ArrayList(i32).from_array(s1_arr));
  s2 := SortedSet(i32).new().insert(i32(1)).insert(i32(2)).insert(i32(3));
  assert(s1 == s2, "from_list equals manual insert");
});
