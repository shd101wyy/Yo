open import "std/fs";
open import "std/path";
open import "std/string";
open import "std/collections/array_list";

test "std/fs", {
  // Test OpenFlags enum discriminant values
  assert(i32(OpenFlags.Read) == i32(0));
  assert(i32(OpenFlags.Write) == i32(1));
  assert(i32(OpenFlags.ReadWrite) == i32(2));
  assert(i32(OpenFlags.Create) == i32(64));
  assert(i32(OpenFlags.Truncate) == i32(512));
  assert(i32(OpenFlags.Append) == i32(1024));

  // Test combining flags with bitwise OR
  write_create := (i32(OpenFlags.Write) | i32(OpenFlags.Create));
  assert(write_create == i32(65));

  // Test FileMode enum discriminant values
  assert(i32(FileMode.OwnerRead) == i32(256));
  assert(i32(FileMode.OwnerWrite) == i32(128));
  assert(i32(FileMode.OwnerExecute) == i32(64));
  assert(i32(FileMode.GroupRead) == i32(32));
  assert(i32(FileMode.OtherRead) == i32(4));

  // Test common mode constants
  assert(MODE_644 == i32(420));
  assert(MODE_755 == i32(493));

  // Test file write and read roundtrip
  test_path := Path.new(String.from("/tmp/yo_fs_test.txt"));
  test_content := String.from("Hello from Yo fs module!");
  
  // Write file
  write_result := await write_file_string(test_path, test_content);
  match(write_result,
    .Ok(_) => (),
    .Err(e) => {
      print("Write failed");
      assert(false);
    }
  );

  // Check file exists
  file_exists := await exists(test_path);
  assert(file_exists);

  // Read file back
  read_result := await read_file_string(test_path);
  match(read_result,
    .Ok(content) => {
      assert(content.len() == test_content.len());
    },
    .Err(e) => {
      print("Read failed");
      assert(false);
    }
  );

  // Test stat
  stat_result := await stat(test_path);
  match(stat_result,
    .Ok(file_stat) => {
      assert(file_stat.is_file());
      assert(not(file_stat.is_directory()));
      assert(file_stat.size() == i64(24));
    },
    .Err(e) => {
      print("Stat failed");
      assert(false);
    }
  );

  // Clean up - remove test file
  unlink_result := await unlink(test_path);
  match(unlink_result,
    .Ok(_) => (),
    .Err(e) => {
      print("Unlink failed");
      assert(false);
    }
  );

  // Verify file is gone
  file_exists_after := await exists(test_path);
  assert(not(file_exists_after));

  // Test directory operations
  test_dir := Path.new(String.from("/tmp/yo_fs_test_dir"));
  
  mkdir_result := await mkdir(test_dir);
  match(mkdir_result,
    .Ok(_) => (),
    .Err(e) => {
      print("Mkdir failed");
      assert(false);
    }
  );

  // Check directory exists and is a directory
  dir_stat_result := await stat(test_dir);
  match(dir_stat_result,
    .Ok(dir_stat) => {
      assert(dir_stat.is_directory());
      assert(not(dir_stat.is_file()));
    },
    .Err(e) => {
      print("Dir stat failed");
      assert(false);
    }
  );

  // Remove directory
  rmdir_result := await rmdir(test_dir);
  match(rmdir_result,
    .Ok(_) => (),
    .Err(e) => {
      print("Rmdir failed");
      assert(false);
    }
  );

  // Test File.open_read / File.open_write
  test_path2 := Path.new(String.from("/tmp/yo_fs_test2.txt"));
  
  // Use open_write convenience method
  write_file_result := await File.open_write(test_path2);
  match(write_file_result,
    .Ok(file) => {
      bytes := ArrayList(u8).new();
      bytes.push(u8(72));  // H
      bytes.push(u8(105)); // i
      write_bytes_result := await file.write_bytes(bytes);
      match(write_bytes_result,
        .Ok(n) => assert(n == usize(2)),
        .Err(_) => assert(false)
      );
      await file.close();
    },
    .Err(_) => assert(false)
  );

  // Use open_read convenience method
  read_file_result := await File.open_read(test_path2);
  match(read_file_result,
    .Ok(file) => {
      read_bytes_result := await file.read_bytes(usize(2));
      match(read_bytes_result,
        .Ok(bytes) => {
          assert(bytes.len() == usize(2));
          b0 := match(bytes.get(usize(0)), .Some(b) => b, .None => u8(0));
          b1 := match(bytes.get(usize(1)), .Some(b) => b, .None => u8(0));
          assert(b0 == u8(72));
          assert(b1 == u8(105));
        },
        .Err(_) => assert(false)
      );
      await file.close();
    },
    .Err(_) => assert(false)
  );

  // Clean up
  await unlink(test_path2);

  print("All fs tests passed!");
};