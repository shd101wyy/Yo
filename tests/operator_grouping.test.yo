//! Tests for the stricter operator-grouping rule
//! (plans/OPERATOR_ASSOCIATIVITY.md).
//!
//! Yo has no operator precedence: a chain of the SAME operator is
//! left-associative (no parentheses needed), while adjacent DIFFERENT operators
//! require explicit parentheses (otherwise a parse error — that rejection is
//! exercised by the parser-level test in `src/tests/operator-grouping.test.ts`).
open(import("std/string"));

test("same-operator chains left-associate", {
  // `+` and `*` are associative, so these mainly confirm the chain parses:
  comptime_assert((1 + 2 + 3) == 6, "(1 + 2) + 3 == 6");
  comptime_assert((2 * 3 * 4) == 24, "(2 * 3) * 4 == 24");
  // `-` and `/` are NON-associative, so the value distinguishes left grouping
  // from right grouping and proves the chain is left-associative:
  comptime_assert((10 - 3 - 2) == 5, "(10 - 3) - 2 == 5, not 10 - (3 - 2) == 9");
  comptime_assert((100 / 5 / 2) == 10, "(100 / 5) / 2 == 10, not 100 / (5 / 2) == 50");
  comptime_assert((20 - 5 - 4 - 3) == 8, "left-associative 4-operand chain");
});

test("explicit parentheses group mixed operators", {
  comptime_assert(((1 + 2) * 3) == 9, "(1 + 2) * 3 == 9");
  comptime_assert((1 + (2 * 3)) == 7, "1 + (2 * 3) == 7");
  comptime_assert(((10 - 2) / (1 + 1)) == 4, "(10 - 2) / (1 + 1) == 4");
});

test("comparison chaining is rejected", {
  // `1 < 2 < 3` left-associates to `(1 < 2) < 3`; `(1 < 2)` is a `bool`, so
  // `bool < 3` is a type error. (Adjacent DIFFERENT operators without parens —
  // e.g. `1 + 2 * 3` — are rejected at PARSE time, which `comptime_expect_error`
  // cannot observe; that rejection is covered by the std/tests/yo-self migration
  // itself, where every such site now requires explicit parentheses.)
  comptime_expect_error(1 < 2 < 3);
});
