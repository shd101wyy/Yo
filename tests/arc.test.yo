pragma(Pragma.SkipWasm32Wasi); // no pthread support in standalone WASI
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
test("Test basic Arc with primitive type", {
  a := Arc.new(i32(42));
  val := a.*;
  assert(val == 42);
});
test("Test Arc copy shares value", {
  a := Arc.new(i32(100));
  b := Arc.clone(a);
  assert(a.* == 100);
  assert(b.* == 100);
});
test("Test Arc with direct constructor", {
  a := Arc(i32)(i32(99));
  assert(a.* == 99);
});
test("Test Arc with struct type", {
  Counter :: struct(count : i32);
  c := Arc.new(Counter(i32(10)));
  assert(c.*.count == 10);
});
test("Test Arc copy of struct type", {
  Counter :: struct(count : i32);
  c := Arc.new(Counter(i32(20)));
  d := Arc.clone(c);
  assert(c.*.count == 20);
  assert(d.*.count == 20);
});
test("Test Arc with method delegation through deref", {
  Counter :: struct(count : i32);
  impl(
    Counter,
    get_count : (fn(self : &Self) -> i32)(self.count)
  );
  c := Arc.new(Counter(i32(30)));
  assert(c.*.get_count() == 30);
});
test("Test Arc passed to function", {
  Counter :: struct(count : i32);
  read_arc :: (fn(a : &Arc(Counter)) -> i32)(a.*.count);
  c := Arc.new(Counter(i32(50)));
  result := read_arc(&c);
  assert(result == 50);
  // c is still valid after passing to function (Arc copies on pass)
  assert(c.*.count == 50);
});
test("Test Arc rejects non-Send object type", {
  Counter :: ref(struct(count : i32));
  comptime_expect_error(Arc(Counter));
  comptime_expect_error(arc(Counter(i32(1))));
});
test("Test Arc multiple copies", {
  a := Arc.new(i32(7));
  b := Arc.clone(a);
  c := Arc.clone(a);
  d := Arc.clone(b);
  assert(a.* == 7);
  assert(b.* == 7);
  assert(c.* == 7);
  assert(d.* == 7);
});
test("Test Arc implements Send", {
  f :: Type.impls(Arc(i32), Send);
  comptime_assert(f, "Arc(i32) should implement Send");
});
test("Test Arc of struct type", {
  Point :: struct(x : i32, y : i32);
  p := Arc.new(Point(i32(3), i32(4)));
  assert(p.*.x == 3);
  assert(p.*.y == 4);
});
test("Test Arc scope cleanup", {
  // Arc should be properly cleaned up when going out of scope
  // ASAN will detect any leaks
  {
    a := Arc.new(i32(42));
    b := a;
    c := b;
    ()
  };
  assert(true);
});
// --- Arc + Thread tests ---
{ Thread } :: import("std/thread");
// --- The `alloc` parameter (plans/VALUES_BY_DEFAULT.md §3.2) ---
{ GlobalAllocator } :: import("std/allocator");
// A counting allocator: forwards to the global allocator and counts the
// blocks it holds (`live`) and the alloc/realloc requests it served.
_Counts :: struct(live : usize, requests : usize);
_count_alloc :: (fn(ctx : ?*void, size : usize, align : usize) -> ?*void)({
  c := (*_Counts)(ctx.unwrap());
  unsafe(c.*.live = (c.*.live + usize(1)));
  unsafe(c.*.requests = (c.*.requests + usize(1)));
  GlobalAllocator.malloc(size)
});
_count_realloc :: (fn(ctx : ?*void, ptr : ?*void, old_size : usize, new_size : usize, align : usize) -> ?*void)({
  c := (*_Counts)(ctx.unwrap());
  unsafe(c.*.requests = (c.*.requests + usize(1)));
  cond(
    ptr.is_none() => {
      unsafe(c.*.live = (c.*.live + usize(1)));
    },
    true => ()
  );
  GlobalAllocator.realloc(ptr, new_size)
});
_count_free :: (fn(ctx : ?*void, ptr : ?*void, size : usize, align : usize) -> unit)({
  cond(
    ptr.is_some() => {
      c := (*_Counts)(ctx.unwrap());
      unsafe(c.*.live = (c.*.live - usize(1)));
    },
    true => ()
  );
  GlobalAllocator.free(ptr);
});
_COUNT_VTABLE := AllocatorVTable(alloc : _count_alloc, realloc : _count_realloc, free : _count_free);
_counts :: (fn() -> _Counts)(_Counts(live : usize(0), requests : usize(0)));
// An `Allocator` over `c`, which must outlive every block it hands out.
_counting :: (fn(c : *_Counts) -> Allocator)(Allocator(ctx : .Some((*void)(c)), vtable : addr_of(_COUNT_VTABLE)));
// The live count of a counting allocator, read through the allocator value: a
// closure that captured the `_Counts` itself would read its own copy.
test("arc alloc : .Some(a) places the cell in a, and the default does not", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  {
    a := Arc.new(i32(5), alloc : .Some(heap));
    assert(counts.live == usize(1), `the cell is in the allocator: ${counts.live}`);
    assert(ref_count(a) == usize(1), "ref_count never reports the allocator tag");
    g := Arc.new(i32(6));
    assert(counts.live == usize(1), "a default arc is on the global allocator");
    assert((a.* + g.*) == i32(11), "the payloads");
  };
  assert(counts.live == usize(0), "the last drop released the cell into the allocator");
});
test("arc alloc : .Some(a) shared across a thread is released into a", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  {
    shared := Arc.new(i32(42), alloc : .Some(heap));
    t := Thread(unit).spawn({ shared : Arc.clone(shared) }(io) => {
      assert(shared.* == i32(42), "the worker reads the placed cell");
    });
    t.join();
    assert(counts.live == usize(1), "one cell, two handles");
  };
  assert(counts.live == usize(0), "the last handle released the cell into the allocator");
});
// A `Dyn(..., Send)` closure that captures a parameter of a generic
// (`Impl(Fn)`) function is boxed by a synthesized `__yo_arc_cell(closure)`
// (`arc(closure)` until H1) whose `V` is the closure's capture struct: the C
// result once had a second type, the
// unbound `Arc(V)` (issues/fixed/2026-10-22-a-dyn-closure-in-a-generic-fn-boxes-through-a-cell-typed-by-the-unbound-return.md).
_ArcDynDetector :: struct(detect : Dyn(Fn(x : i32) -> i32, Send));
_arc_dyn_run :: (fn(get : Impl(Fn(x : i32) -> i32, Send, Sync)) -> i32)({
  d := _ArcDynDetector(detect : dyn((x : i32) => (get(x) + i32(1))));
  d.detect(i32(2))
});
test("a Send dyn of a closure capturing a generic fn's Impl(Fn) parameter boxes through arc", {
  n := i32(10);
  assert(_arc_dyn_run((x : i32) => (x + n)) == i32(13), "the closure, called through the Dyn");
});
test("Test Arc shared across thread", {
  shared := Arc.new(i32(42));
  t := Thread(unit).spawn({ shared : Arc.clone(shared) }(io) => {
    assert(shared.* == 42);
  });
  t.join();
  assert(shared.* == 42);
});
test("Test Arc of struct shared across thread", {
  Counter :: struct(count : i32);
  shared := Arc.new(Counter(i32(99)));
  t := Thread(unit).spawn({ shared : Arc.clone(shared) }(io) => {
    assert(shared.*.count == 99);
  });
  t.join();
  assert(shared.*.count == 99);
});
test("Test Arc shared across multiple threads", {
  shared := Arc.new(i32(7));
  t1 := Thread(unit).spawn({ shared : Arc.clone(shared) }(io) => {
    assert(shared.* == 7);
  });
  t2 := Thread(unit).spawn({ shared : Arc.clone(shared) }(io) => {
    assert(shared.* == 7);
  });
  t1.join();
  t2.join();
  assert(shared.* == 7);
});
// --- Decision 46's doors, the Arc mirrors (plans/VALUES_BY_DEFAULT.md §6
// "Decision 46" step 1) ---
_ArcPair :: struct(a : i32, b : i32);
derive(_ArcPair, Copy, Clone);
test("Arc.try_unwrap on the only handle moves the payload out", {
  h := Arc.new(_ArcPair(a : i32(1), b : i32(2)));
  match(
    Arc.try_unwrap(h),
    .Ok(p) => assert((p.a == i32(1)) && (p.b == i32(2)), "the payload came out"),
    .Err(_) => assert(false, "the only handle unwraps")
  );
});
test("Arc.try_unwrap on a handle another thread holds returns it", {
  a := Arc.new(i32(5));
  b := Arc.clone(a);
  t := Thread(unit).spawn(io => {
    assert(b.* == i32(5));
  });
  c := Arc.clone(a);
  back := match(
    Arc.try_unwrap(c),
    .Ok(_) => {
      assert(false, "a still shares the cell");
      Arc.new(i32(0))
    },
    .Err(h) => h
  );
  assert(back.* == i32(5), "the handle came back");
  t.join();
  assert(a.* == i32(5), "the payload is untouched");
});
test("Arc.make_mut clones a shared payload and writes a unique one in place", {
  a := Arc.new(_ArcPair(a : i32(1), b : i32(2)));
  b := Arc.clone(a);
  Arc.make_mut(&mut b).a = i32(10);
  assert(a.a == i32(1), "the other handle does not see the write");
  assert(b.a == i32(10), "the write landed in b's own cell");
  assert((ref_count(a) == 1) && (ref_count(b) == 1), "two cells, one handle each");
  Arc.make_mut(&mut a).b = i32(20);
  assert((a.b == i32(20)) && (b.b == i32(2)), "a was unique: written in place");
});
// --- ArcWeak (plans/backlog/WEAK_AND_UNCOLLECTED_RC.md §3, W4): the W3 rows
// across a thread ---
(mut(g_arc_weak_dropped) : i32) = i32(0);
_ArcWeakProbe :: struct(n : i32);
impl(
  _ArcWeakProbe,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_arc_weak_dropped = (g_arc_weak_dropped + i32(1));
    })
  )
);
test("ArcWeak.upgrade on another thread is .Some while an Arc is alive, .None after", {
  a := Arc.new(i32(7));
  w := Arc.downgrade(&a);
  w2 := ArcWeak.clone(&w);
  assert(w.weak_count() == usize(2), "two weak handles");
  t := Thread(unit).spawn({ w2 }(io) => {
    n := match(w2.upgrade(), .Some(h) => h.*, .None => i32(0));
    assert(n == i32(7), "the worker upgrades while a is alive");
  });
  t.join();
  assert(ref_count(a) == usize(1), "the worker's upgraded handle was dropped");
  assert(w.weak_count() == usize(1), "the worker's ArcWeak was dropped with its closure");
  consume(a);
  assert(w.upgrade().is_none(), "the last Arc is gone");
  assert(w.strong_count() == usize(0), "no strong handle");
  e := ArcWeak(i32).new();
  d := (ArcWeak(i32) <: Default).default();
  assert(e.upgrade().is_none() && e.ptr_eq(&d), "a dangling ArcWeak");
});
test("the last Arc dropped on another thread leaves the cell to the last ArcWeak", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  before := g_arc_weak_dropped;
  w := {
    a := Arc.new(_ArcWeakProbe(n : i32(1)), alloc : .Some(heap));
    w0 := Arc.downgrade(&a);
    t := Thread(unit).spawn({ a : Arc.clone(a) }(io) => {
      assert(a.n == i32(1), "the worker holds the last Arc");
    });
    consume(a);
    t.join();
    w0
  };
  assert(g_arc_weak_dropped == (before + i32(1)), "the worker's drop dropped the payload");
  assert(counts.live == usize(1), "an ArcWeak keeps the cell's bytes");
  assert(w.upgrade().is_none(), "the payload is gone");
  consume(w);
  assert(counts.live == usize(0), "the last ArcWeak freed the cell");
});
test("ArcWeak handles upgraded and dropped on several threads while the last Arc goes", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  before := g_arc_weak_dropped;
  {
    a := Arc.new(_ArcWeakProbe(n : i32(3)), alloc : .Some(heap));
    w1 := Arc.downgrade(&a);
    w2 := Arc.downgrade(&a);
    t1 := Thread(unit).spawn({ w1 }(io) => {
      (mut(i) : i32) = i32(0);
      while(i < i32(2000), {
        match(w1.upgrade(), .Some(h) => assert(h.n == i32(3), "an upgraded handle reads the payload"), .None => ());
        c := ArcWeak.clone(&w1);
        consume(c);
        i = (i + i32(1));
      });
    });
    t2 := Thread(unit).spawn({ w2 }(io) => {
      (mut(i) : i32) = i32(0);
      while(i < i32(2000), {
        match(w2.upgrade(), .Some(h) => assert(h.n == i32(3), "an upgraded handle reads the payload"), .None => ());
        i = (i + i32(1));
      });
    });
    consume(a);
    t1.join();
    t2.join();
  };
  assert(g_arc_weak_dropped == (before + i32(1)), "the payload was dropped once");
  assert(counts.live == usize(0), "the cell was freed once, by whichever handle went last");
});
// `Arc.make_mut` disassociates `ArcWeak` handles, as `Rc.make_mut` does `Weak`
// ones.
test("Arc.make_mut on the only Arc with an ArcWeak alive moves to a fresh cell", {
  a := Arc.new(_ArcPair(a : i32(1), b : i32(2)));
  w := Arc.downgrade(&a);
  before := addr_of(a.*);
  Arc.make_mut(&mut a).a = i32(10);
  assert(a.a == i32(10), "the write landed");
  assert(addr_of(a.*) != before, "an ArcWeak shared the cell: a moved to a fresh one");
  t := Thread(unit).spawn({ w }(io) => {
    assert(w.upgrade().is_none(), "the ArcWeak upgrades to .None on another thread");
  });
  t.join();
  b := Arc.new(_ArcPair(a : i32(3), b : i32(4)));
  w2 := Arc.downgrade(&b);
  consume(w2);
  before_b := addr_of(b.*);
  Arc.make_mut(&mut b).b = i32(40);
  assert(addr_of(b.*) == before_b, "no ArcWeak left: written in place");
});
// --- The uniqueness lock behind `Arc.make_mut` and `Arc.try_unwrap`
// (issues/2026-10-28-arc-make-mut-and-try-unwrap-race-an-arcweak-upgrade-on-another-thread.md):
// one CAS of the strong count from 1 to 0 instead of two loads. The
// interleaving it closes cannot be forced from Yo source, so these rows drive
// the runtime primitives directly. ---
_arc_unique :: extern(
  "Yo",
  __yo_arc_lock_unique : (fn(cell : *void) -> bool),
  __yo_arc_unlock_unique : (fn(cell : *void) -> unit),
  __yo_arc_weak_count_raw : (fn(cell : *void) -> usize),
  __yo_arc_release_locked : (fn(slot : *void) -> unit)
);
test("a locked Arc cell refuses ArcWeak.upgrade on another thread, and its weak count still reads", {
  a := Arc.new(_ArcPair(a : i32(1), b : i32(2)));
  cell := (*void)(unsafe.cast(&a, *_ArcPair));
  w := Arc.downgrade(&a);
  w2 := ArcWeak.clone(&w);
  assert(_arc_unique.__yo_arc_lock_unique(cell), "the only Arc locks its cell");
  assert(w.strong_count() == usize(0), "the lock leaves a strong count of 0");
  assert(w.weak_count() == usize(0), "the checked weak count answers 0 for a zero strong count");
  assert(_arc_unique.__yo_arc_weak_count_raw(cell) == usize(2), "the raw read sees both ArcWeak handles");
  t := Thread(bool).spawn({ w2 }(io) => w2.upgrade().is_none());
  assert(t.join(), "an upgrade on another thread refuses the locked cell");
  assert(_arc_unique.__yo_arc_weak_count_raw(cell) == usize(1), "the worker's ArcWeak went while the cell was locked");
  assert(w.upgrade().is_none(), "an upgrade on this thread refuses it too");
  assert(!_arc_unique.__yo_arc_lock_unique(cell), "a locked cell does not lock twice");
  a.a = i32(10);
  _arc_unique.__yo_arc_unlock_unique(cell);
  assert(ref_count(a) == usize(1), "the unlock gives the count of 1 back");
  w3 := ArcWeak.clone(&w);
  t2 := Thread(i32).spawn({ w3 }(io) => match(w3.upgrade(), .Some(h) => h.a, .None => i32(0)));
  assert(t2.join() == i32(10), "after the unlock an upgrade on another thread sees the write made under the lock");
  h := w.upgrade();
  assert(!_arc_unique.__yo_arc_lock_unique(cell), "a cell an upgraded handle shares does not lock");
  assert(ref_count(a) == usize(2), "a failed lock leaves the count alone");
  consume(h);
});
test("a locked cell whose payload moved out goes to its ArcWeak handles as dead", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  before := g_arc_weak_dropped;
  a := Arc.new(_ArcWeakProbe(n : i32(4)), alloc : .Some(heap));
  cell := (*void)(unsafe.cast(&a, *_ArcWeakProbe));
  w := Arc.downgrade(&a);
  assert(_arc_unique.__yo_arc_lock_unique(cell), "the only Arc locks its cell");
  p := __yo_ptr_read(addr_of(a.*));
  _arc_unique.__yo_arc_release_locked((*void)(addr_of(a)));
  assert(p.n == i32(4), "the payload moved out");
  assert(g_arc_weak_dropped == before, "the cell did not drop the moved-out payload");
  assert(counts.live == usize(1), "the ArcWeak keeps the cell's bytes");
  t := Thread(bool).spawn({ w }(io) => w.upgrade().is_none());
  assert(t.join(), "the payload is gone for the ArcWeak");
  assert(counts.live == usize(0), "the last ArcWeak, dropped on the worker, freed the cell");
  consume(p);
  assert(g_arc_weak_dropped == (before + i32(1)), "the payload was dropped once, by its new owner");
  b := Arc.new(_ArcWeakProbe(n : i32(5)), alloc : .Some(heap));
  cell_b := (*void)(unsafe.cast(&b, *_ArcWeakProbe));
  assert(_arc_unique.__yo_arc_lock_unique(cell_b), "the only Arc locks its cell");
  q := __yo_ptr_read(addr_of(b.*));
  _arc_unique.__yo_arc_release_locked((*void)(addr_of(b)));
  assert(counts.live == usize(0), "no ArcWeak: the release freed the cell");
  consume(q);
  assert(g_arc_weak_dropped == (before + i32(2)), "each payload dropped once");
});
// A recursive payload whose edge back to its own type is an `ArcWeak`: the
// `Self` in the field is fixed up with the declaration, and the upgraded
// handle is the payload's own `Arc` (one C type,
// issues/fixed/2026-10-27-a-generic-method-returning-rc-of-its-parameter-over-a-recursive-struct-gets-a-second-c-type.md).
_ArcWeakNode :: struct(parent : ArcWeak(Self), tag : i32);
test("an ArcWeak parent pointer in a recursive payload upgrades on another thread", {
  root := Arc.new(_ArcWeakNode(parent : ArcWeak(_ArcWeakNode).new(), tag : i32(1)));
  leaf := Arc.new(_ArcWeakNode(parent : Arc.downgrade(&root), tag : i32(2)));
  t := Thread(unit).spawn({ leaf : Arc.clone(leaf) }(io) => {
    n := match(leaf.parent.upgrade(), .Some(p) => p.tag, .None => i32(0));
    assert(n == i32(1), "the leaf reaches its parent");
  });
  t.join();
  assert(root.parent.upgrade().is_none(), "the root has no parent");
});
// Decision 17 (plans/VALUES_BY_DEFAULT.md, V2c): copying an `Arc` needs
// `.clone()`, as in Rust.
test("Arc.clone is a second handle, and an implicit copy whose source is used again is E0901", {
  a := Arc.new(i32(8));
  b := Arc.clone(a);
  assert(ref_count(a) == usize(2), "two handles to one cell");
  comptime_expect_error({
    c := a;
    a.* + c.*
  }, "Arc.clone(a)");
  d := b;
  assert(ref_count(d) == usize(2), "the last use moved b: still two handles");
});
