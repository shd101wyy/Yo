pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ Mutex } :: import("std/sync/mutex");
// === Recursive enum with Rc(Self) ===
// Mirrors the AST MyExpr shape we'll need for the compiler port.
MyExpr :: enum(
  Lit(value : i32),
  Add(lhs : Rc(Self), rhs : Rc(Self)),
  Mul(lhs : Rc(Self), rhs : Rc(Self)),
  List(items : ArrayList(Self))
);
derive(MyExpr, Clone);
eval :: (fn(e : *MyExpr) -> i32)({
  return(
    match(
      &e.*,
      .Lit(v) => v.*,
      .Add(l, r) => {
        lv := recur(addr_of(l.*.*));
        rv := recur(addr_of(r.*.*));
        lv + rv
      },
      .Mul(l, r) => {
        lv := recur(addr_of(l.*.*));
        rv := recur(addr_of(r.*.*));
        lv * rv
      },
      .List(items) => {
        mut(sum) := i32(0);
        mut(i) := usize(0);
        while(i < items.len(), i = (i + usize(1)), {
          match(
            items.get_cloned(i),
            .Some(it) => {
              sum = (sum + recur(addr_of(it)));
            },
            .None => ()
          );
        });
        sum
      }
    )
  );
});
test("Recursive enum: construct + match Rc(Self) leaves", {
  e := MyExpr.Add(
    Rc.new(MyExpr.Lit(i32(2))),
    Rc.new(MyExpr.Lit(i32(3)))
  );
  v := eval(addr_of(e));
  assert(v == i32(5), "2 + 3 == 5");
});
test("Recursive enum: ArrayList(Self) variant", {
  mut(items) := ArrayList(MyExpr).new();
  items.push(MyExpr.Lit(i32(10)));
  items.push(MyExpr.Lit(i32(20)));
  items.push(MyExpr.Add(Rc.new(MyExpr.Lit(i32(3))), Rc.new(MyExpr.Lit(i32(4)))));
  e := MyExpr.List(items);
  v := eval(addr_of(e));
  assert(v == i32(37), "10 + 20 + 7 == 37");
});
test("Recursive enum: nested Rc(Self) tree", {
  // ((1 + 2) * (3 + 4)) = 21
  tree := MyExpr.Mul(
    Rc.new(MyExpr.Add(Rc.new(MyExpr.Lit(i32(1))), Rc.new(MyExpr.Lit(i32(2))))),
    Rc.new(MyExpr.Add(Rc.new(MyExpr.Lit(i32(3))), Rc.new(MyExpr.Lit(i32(4)))))
  );
  v := eval(addr_of(tree));
  assert(v == i32(21), "(1+2)*(3+4) == 21");
});
build_spine :: (fn(n : i32) -> MyExpr)({
  return(
    cond(
      (n <= i32(0)) => MyExpr.Lit(i32(1)),
      true => MyExpr.Add(Rc.new(MyExpr.Lit(i32(1))), Rc.new(recur(n - i32(1))))
    )
  );
});
test("Recursive enum: deeply nested drop terminates", {
  spine := build_spine(i32(50));
  v := eval(addr_of(spine));
  assert(v == i32(51), "spine of 50 Adds + 1 Lit sums to 51");
});
// === derive(Clone) on a recursive type ===
// Note: derive(Clone) on Rc(Self) currently has a known codegen ordering
// issue (issues/fixed/recursive-derive-clone-codegen-vtable.md). We skip the
// derive call here and only test that the bare recursive enum works.
// === Value-enum drops and dups through per-type functions ===
// issues/fixed/value-enum-drops-are-emitted-inline-at-every-drop-site.md: a
// tagged value enum's drop and dup are one C function per enum type, called at
// every site, instead of the variant switch inlined at each one. Every payload
// must still be released exactly once: the probes count their disposals.
// The payloads are shared `Rc` handles, so a dup is a clone of the handle.
(mut(g_holder_probe_disposed) : i32) = i32(0);
HolderProbe :: struct(id : i32);
impl(
  HolderProbe,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_holder_probe_disposed = (g_holder_probe_disposed + i32(1));
    })
  )
);
Holder :: enum(
  HEmpty,
  HOne(p : Rc(HolderProbe)),
  HPair(a : Rc(HolderProbe), b : Rc(HolderProbe)),
  HNest(inner : Rc(Self)),
  HMany(xs : ArrayList(Rc(HolderProbe)))
);
derive(Holder, Clone);
_holder_weight :: (fn(h : Holder, stop : bool) -> i32)({
  if(stop, {
    return(i32(1));
  });
  match(h, .HPair(_, _) => i32(2), .HNest(_) => i32(3), _ => i32(4))
});
_holder_sum_ids :: (fn(hs : &ArrayList(Holder)) -> i32)({
  (mut(total) : i32) = i32(0);
  (mut(i) : usize) = usize(0);
  while(i < hs.len(), i = (i + usize(1)), {
    match(
      hs.get_cloned(i),
      .Some(h) => match(
        h,
        .HOne(p) => {
          total = (total + p.*.id);
        },
        .HPair(a, b) => {
          total = (total + (a.*.id + b.*.id));
        },
        _ => ()
      ),
      .None => ()
    );
  });
  total
});
test("Value enum: every payload is released once through the per-type drop and dup", {
  before := g_holder_probe_disposed;
  {
    one := Holder.HOne(p : Rc.new(HolderProbe(id : i32(1))));
    pair := Holder.HPair(a : Rc.new(HolderProbe(id : i32(2))), b : Rc.new(HolderProbe(id : i32(3))));
    nest := Holder.HNest(inner : Rc.new(Holder.HOne(p : Rc.new(HolderProbe(id : i32(4))))));
    mut(probes) := ArrayList(Rc(HolderProbe)).new();
    probes.push(Rc.new(HolderProbe(id : i32(5))));
    probes.push(Rc.new(HolderProbe(id : i32(6))));
    many := Holder.HMany(xs : probes);
    assert(_holder_weight(nest, true) == i32(1), "an early return drops its by-value Holder");
    assert(_holder_weight(many, false) == i32(4), "a fall-through drops its by-value Holder");
    mut(hs) := ArrayList(Holder).new();
    hs.push(one);
    hs.push(pair);
    hs.push(Holder.HEmpty);
    // `get` copies each element out (a dup); the copies are dropped per iteration.
    assert(_holder_sum_ids(&hs) == i32(6), "1 + 2 + 3");
    assert(_holder_sum_ids(&hs) == i32(6), "a second pass sees the same payloads");
  };
  assert((g_holder_probe_disposed - before) == i32(6), "the six probes are disposed exactly once");
});
// === One C type for Option(E) of a recursive value enum ===
// issues/fixed/option-of-a-recursive-value-enum-gets-two-c-types-in-the-self-build.md:
// with an `ArrayList(Self)` and an `ArrayList(ArrayList(Self))` payload, the
// `Option(ListTree)` that `ArrayList(Self).get` returns inside the enum's own
// arms and the declared `Option(ListTree)` got two C types ("initializing
// '__yo_t_A' with an expression of incompatible type '__yo_t_B'").
ListTree :: enum(
  LtLeaf(n : i32),
  LtList(xs : ArrayList(Self)),
  LtGrid(rows : ArrayList(ArrayList(Self)))
);
derive(ListTree, Clone);
_list_tree_weight :: (fn(t : &ListTree) -> i32)(
  match(
    t,
    .LtLeaf(n) => n.*,
    .LtList(xs) => match(xs.get_cloned(usize(0)), .Some(x) => recur(&x), .None => i32(0)),
    .LtGrid(rows) => match(
      rows.get_cloned(usize(0)),
      .Some(row) => match(row.get_cloned(usize(0)), .Some(x) => recur(&x), .None => i32(0)),
      .None => i32(0)
    )
  )
);
_list_tree_first :: (fn(xs : &ArrayList(ListTree)) -> Option(ListTree))(xs.get_cloned(usize(0)));
test("Recursive value enum: ArrayList(Self).get and a declared Option(Self) are one type", {
  mut(inner) := ArrayList(ListTree).new();
  inner.push(ListTree.LtLeaf(n : i32(7)));
  mut(xs) := ArrayList(ListTree).new();
  xs.push(ListTree.LtList(xs : inner));
  w := match(_list_tree_first(&xs), .Some(f) => _list_tree_weight(&f), .None => i32(-1));
  assert(w == i32(7), "the first element's first leaf");
  mut(row) := ArrayList(ListTree).new();
  row.push(ListTree.LtLeaf(n : i32(3)));
  mut(rows) := ArrayList(ArrayList(ListTree)).new();
  rows.push(row);
  g := ListTree.LtGrid(rows : rows);
  assert(_list_tree_weight(&g) == i32(3), "a grid's first cell");
});

// === A substituted recursive type's self-reference is the substituted type ===
// A generic impl member whose signature spells a recursive generic instance
// (`_V77Kind(T)` with a `Box(Self)` payload) instead of `Self` is specialized
// by substitution, which re-ties the instance's self-reference to the
// substituted type; the copy and the constructor's own instance are one C type
// (issues/fixed/2026-11-20-an-untyped-trait-member-literal-on-a-generic-box-self-enum-emits-mismatched-c-types.md).
_V77Kind :: (fn(comptime(T) : Type) -> comptime(Type))(enum(Leaf(v : T), Node(elem : Box(Self))));
impl(
  generic(T : Type),
  _V77Kind(T),
  Eq(_V77Kind(T))(
    (==) : ((lhs, rhs) -> match(lhs, .Leaf(a) => match(rhs, .Leaf(b) => true, _ => false), .Node(l) => match(rhs, .Node(r) => true, _ => false)))
  )
);
impl(
  generic(T : Type),
  _V77Kind(T),
  v77_is_node : (fn(self : &_V77Kind(T)) -> bool)(match(self, .Leaf(a) => false, .Node(l) => true)),
  v77_same_kind : (fn(self : &Self, other : &_V77Kind(T)) -> bool)(match(self, .Leaf(a) => match(other, .Leaf(b) => true, _ => false), .Node(l) => match(other, .Node(r) => true, _ => false))),
  v77_wrap : (fn(self : Self) -> Option(_V77Kind(T)))(.Some(self)),
  v77_deep : (fn(self : Self) -> Option(Option(Option(Option(Option(_V77Kind(T)))))))(.Some(.Some(.Some(.Some(.Some(self))))))
);
_V77Pair :: (fn(comptime(T) : Type) -> comptime(Type))(struct(a : T));
impl(
  generic(T : Type),
  _V77Pair(T),
  v77_is_node : (fn(self : &Self, k : &_V77Kind(T)) -> bool)(match(k, .Leaf(a) => false, .Node(l) => true))
);
_V77Opt :: (fn(comptime(T) : Type) -> comptime(Type))(enum(Leaf(v : T), Node(elem : Option(Box(Self)))));
impl(
  generic(T : Type),
  _V77Opt(T),
  v77_is_node : (fn(self : &_V77Opt(T)) -> bool)(match(self, .Leaf(a) => false, .Node(l) => true))
);
_V77Arr :: (fn(comptime(T) : Type) -> comptime(Type))(enum(Leaf(v : T), Node(kids : ArrayList(Self))));
impl(
  generic(T : Type),
  _V77Arr(T),
  v77_is_node : (fn(self : &_V77Arr(T)) -> bool)(match(self, .Leaf(a) => false, .Node(l) => true))
);
_V77Rc :: (fn(comptime(T) : Type) -> comptime(Type))(enum(Leaf(v : T), Node(elem : Rc(Self))));
impl(
  generic(T : Type),
  _V77Rc(T),
  v77_is_node : (fn(self : &_V77Rc(T)) -> bool)(match(self, .Leaf(a) => false, .Node(l) => true))
);
_V77Wrap :: trait(v77_wrap_kind : (fn(self : &Self) -> _V77Kind(Self)));
impl(i32, _V77Wrap(v77_wrap_kind : (self -> _V77Kind(i32).Node(elem : Box.new(_V77Kind(i32).Leaf(v : self.*))))));
_V77F :: (fn(comptime(A) : Type) -> comptime(Type))({
  G :: (fn(comptime(B) : Type) -> comptime(Type))(enum(L(a : A, b : B), N(elem : Box(Self))));
  G(i32)
});
impl(
  generic(T : Type),
  _V77Pair(T),
  v77_is_n : (fn(self : &Self, k : &_V77F(T)) -> bool)(match(k, .L(a, b) => false, .N(e) => true))
);
_V77GS :: (fn(comptime(T) : Type) -> comptime(Type))(struct(v : T, next : Option(Box(Self))));
impl(
  generic(T : Type),
  _V77GS(T),
  v77_has_next : (fn(self : &_V77GS(T)) -> bool)(match(&self.next, .Some(n) => true, .None => false))
);
_V77Ref :: (fn(comptime(p) : Origin) -> comptime(Type))(enum(End(r : &(i32, p)), More(next : &(Self, p))));
impl(
  generic(p : Origin),
  _V77Ref(p),
  v77_is_more : (fn(self : &_V77Ref(p)) -> bool)(match(self, .End(r) => false, .More(n) => true))
);
test("Substituted recursive instance: a trait member's untyped Rhs at the generic instance", {
  k := _V77Kind(i32).Node(elem : Box.new(_V77Kind(i32).Leaf(v : i32(1))));
  j := _V77Kind(i32).Node(elem : Box.new(_V77Kind(i32).Leaf(v : i32(1))));
  assert(k == j, "two Node values compare equal");
});
test("Substituted recursive instance: inherent members spelling the instance", {
  k := _V77Kind(i32).Node(elem : Box.new(_V77Kind(i32).Leaf(v : i32(1))));
  l := _V77Kind(i32).Leaf(v : i32(2));
  assert(k.v77_is_node(), "a Node");
  assert(!l.v77_is_node(), "a Leaf");
  assert(!k.v77_same_kind(&l), "Node against Leaf");
  o := l.v77_wrap();
  assert(match(&o, .Some(g) => !g.v77_is_node(), .None => false), "a wrapped Leaf");
  d := k.v77_deep();
  assert(match(&d, .Some(.Some(.Some(.Some(.Some(g))))) => g.v77_is_node(), _ => false), "five Options deep");
});
test("Substituted recursive instance: another impl's member and Option(Box(Self)), ArrayList(Self), Rc(Self) payloads", {
  k := _V77Kind(i32).Node(elem : Box.new(_V77Kind(i32).Leaf(v : i32(1))));
  p := _V77Pair(i32)(a : i32(3));
  assert(p.v77_is_node(&k), "the pair sees a Node");
  q := _V77Opt(i32).Leaf(v : i32(1));
  assert(!q.v77_is_node(), "a Leaf");
  mut(xs) := ArrayList(_V77Arr(i32)).new();
  xs.push(_V77Arr(i32).Leaf(v : i32(1)));
  a := _V77Arr(i32).Node(kids : xs);
  assert(a.v77_is_node(), "an ArrayList(Self) Node");
  r := _V77Rc(i32).Node(elem : Rc.new(_V77Rc(i32).Leaf(v : i32(1))));
  assert(r.v77_is_node(), "an Rc(Self) Node");
});
test("Substituted recursive instance: a member type taken from a trait's GKind(Self)", {
  x := i32(1);
  (j : _V77Kind(i32)) = x.v77_wrap_kind();
  assert(j.v77_is_node(), "a Node");
});
test("Substituted recursive instance: a constructor nested in another (VERDICTS-77 correction 2)", {
  x := _V77F(bool).L(a : true, b : i32(1));
  y := _V77F(_V77F(bool)).L(a : x, b : i32(2));
  assert(match(&y, .L(a, b) => match(a, .L(a2, b2) => a2.*, .N(e2) => false), .N(e) => false), "the inner payload");
  k := _V77F(bool).N(elem : Box.new(_V77F(bool).L(a : true, b : i32(1))));
  p := _V77Pair(bool)(a : false);
  assert(p.v77_is_n(&k), "the pair sees an N");
});
test("Substituted recursive instance: the struct twin and an origin-parameter holder", {
  k := _V77GS(i32)(v : i32(1), next : .Some(Box.new(_V77GS(i32)(v : i32(2), next : .None))));
  assert(k.v77_has_next(), "the struct has a next");
  x := i32(5);
  e := _V77Ref(x).End(r : &x);
  h := _V77Ref(x).More(next : &e);
  assert(h.v77_is_more(), "a More");
});
// Two named recursive structs with the same fields are two types. Each one's
// `Self` resolves, inside its own fields, to its registry final, which has no
// name yet, and the two compared equal field by field: the instantiation memo
// served `Box(_SameA)` for `Box(_SameB)` ("Cannot unify incompatible struct
// types") and one `_MutexState` C type for both `Mutex` payloads
// (issues/fixed/2026-11-28-two-same-shaped-recursive-structs-share-one-generic-instance.md).
_SameA :: struct(value : i32, next : Option(Box(Self)));
_SameB :: struct(value : i32, next : Option(Box(Self)));
_SameLockA :: struct(id : i32, peer : Option(Arc(Mutex(Self))));
_SameLockB :: struct(id : i32, peer : Option(Arc(Mutex(Self))));
_same_b_push :: (fn(slot : &mut Option(Box(_SameB)), v : i32) -> unit)({
  slot.* = .Some(Box.new(_SameB(value : v, next : .None)));
});
test("Two same-shaped recursive structs: each Box(Self) is its own instance", {
  a := _SameA(value : i32(1), next : .None);
  (c : Option(Box(_SameB))) = .Some(Box.new(_SameB(value : i32(2), next : .None)));
  mut(s) := Option(Box(_SameB)).None;
  _same_b_push(&mut s, i32(3));
  assert(a.value == i32(1), "the first struct");
  assert(match(&c, .Some(b) => (b.*.*.value == i32(2)), .None => false), "the second struct");
  assert(match(&s, .Some(b) => (b.*.*.value == i32(3)), .None => false), "written through the slot");
});
test("Two same-shaped recursive structs: each Mutex(Self) is its own instance", {
  a := Arc.new(Mutex(_SameLockA).new(_SameLockA(id : i32(1), peer : .None)));
  b := Arc.new(Mutex(_SameLockB).new(_SameLockB(id : i32(2), peer : .None)));
  ia := a.*.with_lock(v => v.id);
  ib := b.*.with_lock(v => v.id);
  assert((ia + ib) == i32(3), "both payloads read back");
});
