open import "std/libc/stdio";

some_func :: (fn() -> unit) {
  printf("inside some_func\n");
};

test "test_equal_2", {
  some_func(); // Run some function defined in this file

  x := 10;
  y := 10;
  assert(x == y, "x is not equal to y");
};

test_name :: "compile-time test equal";
test test_name, {
  x :: 10;
  y :: 10;
  assert(x == y, "compile-time x is not equal to y");
};
