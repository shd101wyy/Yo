{ assert } :: import("std/assert");
// Tests for the `try` macro in std/prelude.yo
// `try(expr)` unwraps a Result, returning early on Err.
open(import("std/string"));
// ---------------------------------------------------------------------------
// Result(T, E) tests
// ---------------------------------------------------------------------------
parse_int :: (fn(s : i32) -> Result(i32, i32))(
  cond(
    (s >= i32(0)) => .Ok(s),
    true => .Err(i32(-(1)))
  )
);
double_ok :: (fn(s : i32) -> Result(i32, i32))({
  v := try(parse_int(s));
  .Ok(v * i32(2))
});
test("try unwraps Ok and returns the inner value", {
  match(
    double_ok(i32(5)),
    .Ok(v) => assert(v == i32(10), "double of 5 is 10"),
    .Err(_) => assert(false, "expected Ok")
  );
});
test("try short-circuits on Err and propagates the error", {
  match(
    double_ok(i32(-(7))),
    .Ok(_) => assert(false, "expected Err"),
    .Err(e) => assert(e == i32(-(1)), "error propagated")
  );
});
// ---------------------------------------------------------------------------
// Chained try
// ---------------------------------------------------------------------------
triple_chain :: (fn(s : i32) -> Result(i32, i32))({
  a := try(parse_int(s));
  b := try(parse_int(a + i32(1)));
  c := try(parse_int(b + i32(1)));
  .Ok(c)
});
test("try chains across multiple calls when all Ok", {
  match(
    triple_chain(i32(10)),
    .Ok(v) => assert(v == i32(12), "10 -> 11 -> 12"),
    .Err(_) => assert(false, "expected Ok")
  );
});
// ---------------------------------------------------------------------------
// try with String error type
// ---------------------------------------------------------------------------
parse_pos :: (fn(n : i32) -> Result(i32, String))(
  cond(
    (n > i32(0)) => .Ok(n),
    true => .Err(`negative or zero`)
  )
);
use_pos :: (fn(n : i32) -> Result(i32, String))({
  v := try(parse_pos(n));
  .Ok(v + i32(100))
});
test("try works with non-trivial (RC) error types", {
  match(
    use_pos(i32(5)),
    .Ok(v) => assert(v == i32(105), "5+100"),
    .Err(_) => assert(false, "expected Ok")
  );
  match(
    use_pos(i32(0)),
    .Ok(_) => assert(false, "expected Err"),
    .Err(_) => assert(true, "got Err")
  );
});
