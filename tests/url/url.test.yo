{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Url, UrlError } :: import("std/url");
{ Error, AnyError, Exception } :: import("std/error");
// ============================================================================
// Basic parsing
// ============================================================================
test("Url parse simple HTTP URL", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com"), exn);
  assert(url.scheme() == String.from("http"), "scheme should be http");
  assert(url.host().is_some(), "host should be present");
  assert(url.host().unwrap() == String.from("example.com"), "host should be example.com");
  assert(url.port().is_none(), "port should be None");
  assert(url.query().is_none(), "query should be None");
  assert(url.fragment().is_none(), "fragment should be None");
});
test("Url parse HTTPS URL with path", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("https://example.com/path/to/resource"), exn);
  assert(url.scheme() == String.from("https"), "scheme should be https");
  assert(url.host().unwrap() == String.from("example.com"), "host should be example.com");
  assert(url.path() == String.from("/path/to/resource"), "path should be /path/to/resource");
});
test("Url parse URL with port", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://localhost:8080/api"), exn);
  assert(url.host().unwrap() == String.from("localhost"), "host should be localhost");
  assert(url.port().is_some(), "port should be present");
  assert(url.port().unwrap() == u16(8080), "port should be 8080");
  assert(url.path() == String.from("/api"), "path should be /api");
});
test("Url parse URL with query", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com/search?q=hello&lang=en"), exn);
  assert(url.path() == String.from("/search"), "path should be /search");
  assert(url.query().is_some(), "query should be present");
  assert(url.query().unwrap() == String.from("q=hello&lang=en"), "query should be q=hello&lang=en");
});
test("Url parse URL with fragment", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com/page#section1"), exn);
  assert(url.path() == String.from("/page"), "path should be /page");
  assert(url.fragment().is_some(), "fragment should be present");
  assert(url.fragment().unwrap() == String.from("section1"), "fragment should be section1");
});
test("Url parse full URL with all components", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("https://user:pass@example.com:443/path?key=val#frag"), exn);
  assert(url.scheme() == String.from("https"), "scheme");
  assert(url.userinfo().unwrap() == String.from("user:pass"), "userinfo");
  assert(url.host().unwrap() == String.from("example.com"), "host");
  assert(url.port().unwrap() == u16(443), "port");
  assert(url.path() == String.from("/path"), "path");
  assert(url.query().unwrap() == String.from("key=val"), "query");
  assert(url.fragment().unwrap() == String.from("frag"), "fragment");
});
// ============================================================================
// Scheme handling
// ============================================================================
test("Url parse normalizes scheme to lowercase", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("HTTP://EXAMPLE.COM"), exn);
  assert(url.scheme() == String.from("http"), "scheme should be lowercased to http");
});
test("Url parse FTP scheme", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("ftp://files.example.com/pub/data.txt"), exn);
  assert(url.scheme() == String.from("ftp"), "scheme should be ftp");
  assert(url.host().unwrap() == String.from("files.example.com"), "host");
  assert(url.path() == String.from("/pub/data.txt"), "path");
});
// ============================================================================
// Edge cases
// ============================================================================
test("Url parse empty path with query", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com?q=1"), exn);
  assert(url.path().is_empty(), "path should be empty");
  assert(url.query().unwrap() == String.from("q=1"), "query should be q=1");
});
test("Url parse empty path with fragment", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com#top"), exn);
  assert(url.path().is_empty(), "path should be empty");
  assert(url.fragment().unwrap() == String.from("top"), "fragment should be top");
});
test("Url parse trailing slash", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com/"), exn);
  assert(url.path() == String.from("/"), "path should be /");
});
test("Url parse port 0", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://localhost:0/test"), exn);
  assert(url.port().unwrap() == u16(0), "port should be 0");
});
test("Url parse port 65535", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://localhost:65535"), exn);
  assert(url.port().unwrap() == u16(65535), "port should be 65535");
});
// ============================================================================
// Error cases
// ============================================================================
test("Url parse empty input returns error", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  Url.parse(String.from(""), exn);
  assert(false, "should fail on empty input");
});
test("Url parse missing scheme returns error", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  Url.parse(String.from("://example.com"), exn);
  assert(false, "should fail without scheme");
});
test("Url parse invalid port returns error", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  Url.parse(String.from("http://example.com:abc"), exn);
  assert(false, "should fail on non-numeric port");
});
test("Url parse port out of range returns error", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  Url.parse(String.from("http://example.com:99999"), exn);
  assert(false, "should fail on port > 65535");
});
// ============================================================================
// to_string round-trip
// ============================================================================
test("Url to_string simple URL", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com/path"), exn);
  s := url.to_string();
  assert(s == String.from("http://example.com/path"), "to_string should reconstruct URL");
});
test("Url to_string full URL round-trip", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  input := String.from("https://user:pass@example.com:8080/path?q=1#frag");
  url := Url.parse(input, exn);
  s := url.to_string();
  assert(s == input, "to_string should round-trip");
});
// ============================================================================
// Accessors
// ============================================================================
test("Url host_port with port", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com:8080/path"), exn);
  hp := url.host_port();
  assert(hp.is_some(), "host_port should be present");
  assert(hp.unwrap() == String.from("example.com:8080"), "host_port should be example.com:8080");
});
test("Url host_port without port", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("http://example.com/path"), exn);
  hp := url.host_port();
  assert(hp.is_some(), "host_port should be present");
  assert(hp.unwrap() == String.from("example.com"), "host_port should just be host");
});
test("Url origin", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("https://example.com:443/path?q=1"), exn);
  o := url.origin();
  assert(o == String.from("https://example.com:443"), "origin should be scheme://host:port");
});
// ============================================================================
// Opaque URIs (no authority)
// ============================================================================
test("Url parse mailto URI", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("mailto:user@example.com"), exn);
  assert(url.scheme() == String.from("mailto"), "scheme should be mailto");
  assert(url.host().is_none(), "no host for mailto");
  assert(url.path() == String.from("user@example.com"), "path should be user@example.com");
});
test("Url parse data URI", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  url := Url.parse(String.from("data:text/plain;base64,SGVsbG8="), exn);
  assert(url.scheme() == String.from("data"), "scheme should be data");
  assert(url.host().is_none(), "no host for data URI");
  assert(url.path() == String.from("text/plain;base64,SGVsbG8="), "path should contain data");
});
test("Url UrlError to_string", {
  e1 := UrlError.EmptyInput;
  assert(e1.to_string() == String.from("URL error: empty input"), "EmptyInput message");
  e2 := UrlError.MissingScheme;
  assert(e2.to_string() == String.from("URL error: missing scheme"), "MissingScheme message");
  e3 := UrlError.InvalidPort;
  assert(e3.to_string() == String.from("URL error: invalid port"), "InvalidPort message");
  // The two variants the file used to skip. `InvalidCharacter` went
  // un-asserted AND un-produced, which is how the missing validation survived.
  e4 := UrlError.InvalidCharacter(pos : usize(9));
  assert(
    e4.to_string() == String.from("URL error: invalid character at position 9"),
    "InvalidCharacter message"
  );
  e5 := UrlError.Other(msg : `boom`);
  assert(e5.to_string() == String.from("URL error: boom"), "Other message");
});
// ============================================================================
// RFC 3986 §2 byte-set validation
//
// `Url.parse` used to validate nothing outside the scheme (and the scheme
// guard tested the wrong operand, so it was always true). A raw CRLF in a
// path therefore flowed through `Url.path()` into `HttpRequest`'s request
// line and split one HTTP request into two — textbook request splitting,
// reachable from any caller that interpolates untrusted text into a fetch URL
// and, via `Location`, from a remote server.
// ============================================================================
// The parse error a URL produced, or `.None` if it parsed. Returning the
// MESSAGE pins the variant AND the byte offset — the parser has four other
// rejections, so "did it throw" would pass for the wrong reason.
_parse_err :: (fn(src : String) -> Option(String))({
  rec := Exception(
    throw : (
      err -> {
        unwind(Option(String).Some(err.to_string()));
      }
    )
  );
  _u := Url.parse(src, rec);
  Option(String).None
});
_assert_invalid_at :: (fn(src : String, at : usize, label : String) -> unit)({
  want := (String.from("URL error: invalid character at position ") + at.to_string());
  match(
    _parse_err(src),
    .Some(got) => assert(got == want, `${label}: want [${want}], got [${got}]`),
    .None => assert(false, `${label}: parsed a URL that RFC 3986 forbids`)
  );
});
test("Url parse rejects RFC 3986 forbidden characters at the exact offset", {
  _assert_invalid_at(String.from("http://exa mple.com/"), usize(10), `raw space in host`);
  _assert_invalid_at(String.from("http://x/a b"), usize(10), `raw space in path`);
  // The scheme scan's own guard tested `first` instead of `ch`, so it could
  // never fail; the pre-scan catches this one before the scheme scan runs.
  _assert_invalid_at(String.from("ht tp://x/"), usize(2), `raw space in scheme`);
  _assert_invalid_at(String.from("http://x/a\rb"), usize(10), `raw CR`);
  _assert_invalid_at(String.from("http://x/a\nb"), usize(10), `raw LF`);
  _assert_invalid_at(
    String.from("http://x/a\r\nX: y\r\n\r\nGET /admin"),
    usize(10),
    `CRLF request-splitting payload`
  );
  _assert_invalid_at(String.from("http://x/a\"b"), usize(10), `double quote`);
  _assert_invalid_at(String.from("http://x/a<b"), usize(10), `less-than`);
  _assert_invalid_at(String.from("http://x/a>b"), usize(10), `greater-than`);
  _assert_invalid_at(String.from("http://x/a\\b"), usize(10), `backslash`);
  _assert_invalid_at(String.from("http://x/a{b"), usize(10), `open brace`);
  _assert_invalid_at(String.from("http://x/a|b"), usize(10), `pipe`);
  // A raw control byte, and a raw UTF-8 lead byte: RFC 3986 is ASCII-only, so
  // non-ASCII components are percent-encoded by the caller.
  _assert_invalid_at(String.from("http://x/a\x01b"), usize(10), `control byte 0x01`);
  _assert_invalid_at(String.from("http://x/h\xc3\xa9llo"), usize(10), `raw UTF-8`);
});
test("Url parse still accepts every legal URI byte", {
  // The over-rejection canary. Tightening a parser is the dangerous
  // direction: this asserts the whole legal byte set still gets through, and
  // it passed BEFORE the validation was added as well as after.
  legal := ArrayList(String).new();
  legal.push(String.from("http://x/p?a=1&b=2;c=3!"));
  legal.push(String.from("http://u:p@x:8080/"));
  legal.push(String.from("http://x/a~b-c.d_e"));
  legal.push(String.from("http://[::1]:80/"));
  legal.push(String.from("http://x/a%20b"));
  legal.push(String.from("http://x/p?q=1#frag"));
  legal.push(String.from("mailto:user@example.com"));
  legal.push(String.from("a+b-c.d://x/"));
  legal.push(String.from("http://x/$'()*,"));
  legal.push(String.from("http://x/p?a+b=c"));
  legal.push(String.from("data:text/plain;base64,SGVsbG8="));
  i := usize(0);
  while(runtime(i < legal.len()), {
    src := legal(i);
    match(
      _parse_err(src),
      .Some(got) => assert(false, `legal URI rejected: [${src}] -> ${got}`),
      .None => ()
    );
    i = (i + usize(1));
  });
});
