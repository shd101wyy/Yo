test "Test comments", {
  /*
    This is a block comment
  */
  x :: 0;

  /*
  This is a nested block comment
  Outer comment
    
    /*
      Inner comment
    */

    Yes the block comments can be nested
  */
  y :: 1;

  /**
  * Define the operator precedence for the Yo language.  
  * 1 is the lowest precedence.  
  * Reference: https://rosettacode.org/wiki/Operator_precedence#Haskell
  */

  // This is a line comment
  // Another line comment
  // One more line comment
};

test "Test assignments", {
  {
    x := 1;
    y := (x = 2);

    assert(x == 2);
    assert(y == 1);
  };

  {
    x := box(1);
    y := (x = box(2));

    assert(x.* == 2);
    assert(y.* == 1);
  };

  {
    x := [1, 2, 3];
    y := (x = [2, 3, 4]);

    assert(x(0) == 2);
    assert(y(0) == 1);
  };

  {
    x : i32;
    
    // Initialize a variable defined outside the function body is not allowed
    test :: (fn() -> unit) {
      compt_expect_error(
        x = 12,
        "Cannot initialize a variable that is defined outside the function body."
      );
    
    };
    
    // Initialize a variable defined outside the while loop is not allowed
    test2 :: (fn(flag: bool) -> unit) {
      y : i32;
      while flag, {
        compt_expect_error(
          x = 12,
          "Cannot initialize a variable that is defined outside the while loop."
        );
        compt_expect_error(
          y = 12,
          "Cannot initialize a variable that is defined outside the while loop."
        );
        z : i32;
        z = 12;
      };
      y = 12;
    };
    
    x = 13;
  };
};

test "Test bindings", {
  {
    x : i32;
    y : i32;
    x = 1;
    y = 2;
    assert((x + y) == 3);
  };
  // Runtime immutable variable
  {
    x : i32;
    x = 12;
  };
  {
    (x : bool) = true;
  };

  // Runtime mutable variable
  {
    x : i32;
    x = 12;
  };
  {
    (x : bool) = true;
    x = false;
  };

  // Compile-time immutable variable
  {
    compt(x) : i32;
    x = 12;
  };
  {
    (compt(x) : bool) = true;
    // x = false;
  };

  // Compile-time mutable variable
  {
    compt(x) : i32;
    x = 12;
  };
  {
    (compt(x) : bool) = true;
    x = false;
  };

  // Runtime immutable variable
  {
    (x : i32) = 12;
    // x = 13; // error
  };

  // Runtime mutable variable
  {
    (x : i32) = 12;
    x = 13;
  };

  // Compile-time immutable variable
  {
    x :: 12;
    // x = 13; // error
  };

  {
    // Compile-time mutable variable
    x :: 12;
    x = 13;
  };

  {
    compt(x) : Type;
    x = struct(x: i32, y: i32);
  };
};

test "Test compt", {
  compt_12 :: (fn() -> compt(i32))(
    12
  );

  Point :: struct(
    x : i32,
    y : i32
  );

  {
    x :: 13;
    y := x;
    z :: compt_12();
    assert((y + z) == 25);
  };

  {
    use_point :: (fn(p : Point) -> i32)
      (p.x + p.y)
    ;

    p :: Point(compt_12(), 16);
    assert(use_point(p) == 28);
  };
};

test "Test cond", {
  {
    max :: (fn(x : i32, y : i32) -> i32)
      cond(
        (x > y) => {
          a := 12;
          x
        },
        true => {
          b := 13;
          y
        }
      )
    ;

    x := 5;
    y := 10;
    assert(max(x, y) == 10);
  };
};

test "Test destructuring", {
  // tuple destructuring
  {
    t := (1, 3.4, true);
    (t2 : Tuple(a: i32, b: f64, c: bool)) = t;

    {
      // by index
      assert(t.0 == 1);
      assert(t.1 == 3.4);
      assert(t.2 == true);
    };

    {
      // by index
      assert(t2.0 == 1);
      assert(t2.1 == 3.4);
      assert(t2.2 == true);

      // by label
      assert(t2.a == 1);
      assert(t2.b == 3.4);
      assert(t2.c == true);
    };
    
    {
      // by order
      (x, y, z) := t;
      assert(x == 1);
      assert(y == 3.4);
      assert(z == true);
    };
    {
      // by order
      (c, b, a) := t2;
      assert(c == 1);
      assert(b == 3.4);
      assert(a == true);
    };
    {
      // by label
      (c : c, b : b, a : a) := t2;
      assert(a == 1);
      assert(b == 3.4);
      assert(c == true);
    };

    {
      // by label with different names
      (c : c1, b : b1, a : a1) := t2;
      assert(a1 == 1);
      assert(b1 == 3.4);
      assert(c1 == true);
    };
  };

  // struct destructuring
  {
    Point :: struct(x : i32, y : f64);
    point := Point(3, 4.5);
    {
      { x, y } := point;
      assert(x == 3);
      assert(y == 4.5);
    };
    {
      { y, x } := point;
      assert(x == 3);
      assert(y == 4.5);
    };
    {
      _(x : a, y : b) := point;
      assert(a == 3);
      assert(b == 4.5);
    };
    {
      { x : another_x } := point;
      assert(another_x == 3);
    };
    {
      { x : another_x, ... } := point;
      assert(another_x == 3);
      assert(y == 4.5);
    };
  };
};

test "Test type auto derive Send", {
  compt_assert(Type.impls(i32, Send));
  
  Point :: struct(x : i32, y : i32);
  compt_assert(Type.impls(Point, Send) == true);
  
  MyBox :: object(v : i32);
  compt_assert(Type.impls(MyBox, Send) == false);
  
  GenericPoint :: (fn(compt(T) : Type) -> compt(Type))
    struct(x : T, y : T)
  ;
  compt_assert(Type.impls(GenericPoint(i32), Send) == true);
  compt_assert(Type.impls(GenericPoint(MyBox), Send) == false);
};

test "Test struct", {
  // Struct
  {
    Point :: struct(x: i32, y: i32);

    p := Point(3, 4); // Assign compt to runtime
    p2 :: Point(3, 4); // Assign compt to compt

    runt_value := 1;
    p3 := Point(runt_value, 4);

    compt_expect_error(
      p4 :: Point(runt_value, 4) // Assign runt to compt is not allowed
    );

    assert(p.x == 3);
    assert(p.y == 4);
    compt_assert(p2.x == 3);
    compt_assert(p2.y == 4);
    assert(p3.x == 1);
    assert(p3.y == 4);
  };
  {
    Point :: struct(x: i32, (y: i32) ?= 12);
    p4 :: Point(14);
    assert(p4.x == 14);
    assert(p4.y == 12);
  };
  // curly brackets
  {
    Point :: struct(x: i32, y: bool);

    p := Point(3, true);
    (p2: Point) = _(3, true);
    (p3: Point) = {x: 3, y: true};
    (p4: Point) = {y: true, x: 3};

    x := 1;
    y := true;
    (p5: Point) = {x, y}; 
    (p6: Point) = {y, x};
    
    {
      { x, y: a } := p;
      a;
    };

    {
      { x: a, y: b } := p;
      a;
      b;
    };
  };
};

test "Test tuple", {
  {
    x :: 12;
    t :: (x,);

    runt_x := 16;
    compt_expect_error(t2 :: (x, runt_x)); // Expected error

    t3 := (x, runt_x);

    compt_assert(t.0 == 12);
    assert(t3.0 == 12);
    assert(t3.1 == 16);
  };
};

test "Test cond", {
  compt_expect_error(
    x := cond(
      (3 > 4) => 5,
      (5 > 6) => 6
    ),
    "Expect the last condition to be compile-time known \"true\"."
  );

  x := cond(
    (3 > 4) => 5,
    (5 > 6) => 6,
    true => 7 // the last case expects to be always compile-time known "true"
  );
  assert(x == 7);
};

test "Test control flows", {
  (compt(LinearI32) : Type) = i32;

  some_condition :: (fn() -> bool) 
    true
  ;

  test_while_drop :: (fn() -> i32) {
    (x : LinearI32) = 42;

    compt_expect_error(
      while some_condition(), {
        drop(x);
      },
      "Shouldn't allow to drop x multiple times"
    );

    0
  };

  test_while_drop_with_break_nested :: (fn() -> i32) {
    (x : LinearI32) = 42;

    while some_condition(), {
      ___drop(x); // allowed, because the `cond` expr below always break.
      cond
        some_condition() => break,
        true => break
      ;
    };

    0
  };

  test_while_drop_with_return_nested :: (fn() -> i32) {
    (x : LinearI32) = 42;

    while some_condition(), {
      ___drop(x); // allowed, because the `cond` expr below always returns.
      cond(
        some_condition() => {
          return 0;
        },
        true => {
          return 12;
        }
      );
    };

    0
  };

  test_while_drop_with_continue_nested :: (fn() -> i32) {
    (x : LinearI32) = 42;

    compt_expect_error(
      while some_condition(), {
        drop(x);
        cond
          some_condition() => continue,
          true => continue;
      },
      "Shouldn't allow to drop x multiple times"
    );

    0
  };

  test_while_drop_with_mixed :: (fn() -> i32) {
    (x : LinearI32) = 42;
    compt_expect_error(
      while some_condition(), {
        drop(x); // should give error
        cond
          some_condition() => break,
          some_condition() => {
            return 0;
          },
          true => continue;
      },
      "Shouldn't allow to drop x multiple times"
    );

    0
  };

  test_while_with_mixed_2 :: (fn() -> i32) {
    while some_condition(), {
      a := cond
        some_condition() => break,
        some_condition() => {
          return 0;
        },
        some_condition() => true,
        true => continue
      ;
    };

    0
  };

  test_while_drop_with_mixed_2 :: (fn() -> i32) {
    (x : LinearI32) = 42;
    compt_expect_error(
      while some_condition(), {
        a := cond
          some_condition() => break,
          some_condition() => {
            return 0;
          },
          some_condition() => true,
          true => continue
        ;

        drop(x);
      }, 
      "Shouldn't allow to drop x multiple times"
    );

    0
  };


  // Test 1: Break in while loop
  test_while_with_break :: (fn(flag: bool) -> i32) {
    (x : LinearI32) = 42;
    while flag, 
      cond
        some_condition() => {
          ___drop(x);
          break;
        },
        true => ()
    ;
    return 12;
  };

  // Test 2: Continue in while loop  
  test_while_with_continue :: (fn(flag: bool) -> i32) {
    while flag, 
      cond
        some_condition() => {
          continue;
        },
        true => {
          break;
        }
    ;
    return 15;
  };

  // Test 3: Return in while loop
  test_while_with_return :: (fn(flag: bool) -> i32) {
    (x : LinearI32) = 42;
    while flag,
      cond
        some_condition() => {
          ___drop(x);
          return 16;
        },
        true => ()
    ;
    return 12;
  };

  // Test 4: All cases break
  test_cond_all_break :: (fn(flag: bool) -> i32) {
    while flag,
      cond
        false => { break; },
        true => { break; }
    ;
    return 20;
  };

  // Test 5: All cases continue
  test_cond_all_continue :: (fn(flag: bool) -> i32) {
    while flag,
      cond
        false => { continue; },
        true => { continue; }
    ;
    return 25;
  };

  // Test 6: Mixed cases with one normal return
  test_cond_mixed :: (fn(flag: bool) -> i32)
    cond
      some_condition() => { return 30; },
      true => 35
  ;

  // Test enum for match expressions
  (compt(Shape): Type) = enum(Circle, Square);

  // Test 7: Match with all break cases
  test_match_all_break :: (fn(shape: Shape) -> i32) {
    while some_condition(),
      match shape,
        .Circle => { break; },
        .Square => { break; }
    ;
    return 40;
  };

  // Test 8: Match with all continue cases  
  test_match_all_continue :: (fn(shape: Shape) -> i32) {
    while some_condition(),
      match shape,
        .Circle => { continue; },
        .Square => { continue; }
    ;
    return 45;
  };

  // Test 9: Match with all return cases
  test_match_all_return :: (fn(shape: Shape) -> i32)
    match shape,
      .Circle => { return 50; },
      .Square => { return 55; }
  ;

  // ===========================================
  // NESTED CONTROL STRUCTURES TESTS
  // ===========================================

  // Test 10: Nested cond inside while
  test_nested_cond_in_while :: (fn(flag: bool) -> i32) {
    (x : LinearI32) = 42;
    while flag,
      cond
        some_condition() => {
          cond
            some_condition() => {
              ___drop(x);
              break;
            },
            true => continue
          ;
        },
        true => break
    ;
    return 60;
  };

  // Test 11: Nested while inside cond - fixed version
  test_nested_while_in_cond :: (fn(flag: bool) -> i32) {
    (result: i32) = cond
      some_condition() => {
        while some_condition(), {
          break;
        };
        10  // This ensures the branch returns i32
      },
      true => 20
    ;
    return result;
  };

  // Test 12: Nested match inside while
  test_nested_match_in_while :: (fn(flag: bool, shape: Shape) -> i32) {
    while flag,
      match shape,
        .Circle => {
          cond
            some_condition() => break,
            true => continue
          ;
        },
        .Square => break
    ;
    return 70;
  };

  // ===========================================
  // VALUE-RETURNING CONTROL STRUCTURES TESTS
  // ===========================================

  // Test 13: Cond returning values assigned to variable
  test_cond_value_assignment :: (fn(flag: bool) -> i32) {
    (result: i32) = cond
      some_condition() => 100,
      true => 200
    ;
    return result;
  };

  // Test 14: Match returning values assigned to variable
  test_match_value_assignment :: (fn(shape: Shape) -> i32) {
    (result: i32) = match shape,
      .Circle => 300,
      .Square => 400
    ;
    return result;
  };

  // Test 15: Nested cond with values only (no early returns)
  test_nested_cond_mixed :: (fn(flag: bool) -> i32) {
    (result: i32) = cond(
      some_condition() => cond(
        some_condition() => 500,
        true => 600
      ),
      true => 700
    );
    return result;
  };

  // Test 16: Complex nested structure with linear values
  test_complex_nested :: (fn(flag: bool, shape: Shape) -> i32) {
    (x : LinearI32) = 42;
    (y : LinearI32) = 24;
    
    while flag, {
      (choice: i32) = cond(
        some_condition() => 1,
        true => 2
      );
      
      cond(
        (choice == 1) => {
          match(shape,
            .Circle => {
              ___drop(x);
              break;
            },
            .Square => {
              // drop(y) here should give error
              continue;
            }
          );
        },
        true => {
          break;
        }
      );
    };
    
    return 800;
  };

  // Test 17: Multiple assignment with control flow
  test_multiple_assignment :: (fn(flag: bool) -> i32) {
    (a: i32) = cond
      some_condition() => 10,
      true => 20
    ;
    
    (b: i32) = cond
      flag => {
        return a + 100;  // Early return
      },
      true => 30
    ;
    
    return a + b;
  };

  // === ERROR TEST CASES ===

  // Test: Break outside of loop should fail
  test_break_outside_loop :: (fn() -> unit) 
    compt_expect_error({
      break;
    })
  ;

  // Test: Continue outside of loop should fail  
  test_continue_outside_loop :: (fn() -> unit)
    compt_expect_error({
      continue;
    })
  ;

  // NOTE: Mixed control flows are now allowed in cond/match expressions
  // Test: Mixed control flows in cond should work
  test_mixed_control_flows :: (fn(flag: bool) -> i32) {
    while flag,
      cond(
        some_condition() => {
          break;
        },
        some_condition() => {
          continue;  // Mixed break and continue is allowed
        },
        true => ()
      )
    ;
    return 1;
  };

  // Test: Break in function (not in loop) should fail
  test_break_in_function :: (fn() -> unit)
    compt_expect_error({
      cond(
        some_condition() => {
          break;  // Break outside loop context should fail
        },
        true => ()
      );
    })
  ;

  // Test: Continue in function (not in loop) should fail
  test_continue_in_function :: (fn() -> unit)
    compt_expect_error({
      cond(
        some_condition() => {
          continue;  // Continue outside loop context should fail
        },
        true => ()
      );
    })
  ;
};

test "Test destructuring by ... spread operator", {
  SomeModule :: impl {
    id :: (fn(x: i32)-> i32) x;
    implicit_id :: (fn(x: i32)-> i32) x;
    x :: 1;
    y :: 2;
    export id, implicit_id, x, y;
  };

  {
    // Use ... to destructure all exports
    { ... } :: SomeModule;
    v := id(3);


    Point :: struct(a: i32, b: i32);
    p :: Point(3, 4);
    { ... } :: p;
    x2 := id(a);
  };

  {
    // Use ...(given) to destructure all implicits // NOTE: "given" is no longer supported
    open SomeModule;
    
    implicit_id(3);
    id(3);
  };
};