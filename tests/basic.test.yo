pragma(Pragma.AllowUnsafe);
test("Test comments", {
  /*
    This is a block comment
  */
  x :: 0;
  /*
  This is a nested block comment
  Outer comment
    /*
      Inner comment
    */
    Yes the block comments can be nested
  */
  y :: 1;
  /**
  * Define the operator precedence for the Yo language.
  * 1 is the lowest precedence.
  * Reference: https://rosettacode.org/wiki/Operator_precedence#Haskell
  */
  // This is a line comment
  // Another line comment
  // One more line comment
});
test("Test zero-arg return", {
  returns_unit :: (fn() -> unit)({
    return();
  });
  returns_unit();
});
test("Test assignments", {
  {
    x := 1;
    y := (x = 2);
    assert(x == 2);
    assert(y == 1);
  };
  {
    x := box(1);
    y := (x = box(2));
    assert(x.* == 2);
    assert(y.* == 1);
  };
  {
    (x : [i32 ; 3]) = [1, 2, 3];
    y := (x = [2, 3, 4]);
    assert(x(0) == 2);
    assert(y(0) == 1);
  };
  {
    x : i32;
    // Initialize a variable defined outside the function body is not allowed
    test1 :: (fn() -> unit)({
      comptime_expect_error(
        x = 12,
        "Cannot initialize a variable that is defined outside the function body."
      );
    });
    // Initialize a variable defined outside the while loop is not allowed
    test2 :: (fn(flag : bool) -> unit)({
      y : i32;
      while(flag, {
        comptime_expect_error(
          x = 12,
          "Cannot initialize a variable that is defined outside the while loop."
        );
        comptime_expect_error(
          y = 12,
          "Cannot initialize a variable that is defined outside the while loop."
        );
        z : i32;
        z = 12;
      });
      y = 12;
    });
    x = 13;
  };
});
test("Test bindings", {
  {
    x : i32;
    y : i32;
    x = 1;
    y = 2;
    assert((x + y) == 3);
  };
  // Runtime immutable variable
  {
    x : i32;
    x = 12;
  };
  {
    (x : bool) = true;
  };
  // Runtime mutable variable
  {
    x : i32;
    x = 12;
  };
  {
    (x : bool) = true;
    x = false;
  };
  // Compile-time immutable variable
  {
    comptime(x) : i32;
    x = 12;
  };
  {
    (comptime(x) : bool) = true;
    // x = false;
  };
  // Compile-time mutable variable
  {
    comptime(x) : i32;
    x = 12;
  };
  {
    (comptime(x) : bool) = true;
    x = false;
  };
  // Runtime immutable variable
  {
    (x : i32) = 12;
    // x = 13; // error
  };
  // Runtime mutable variable
  {
    (x : i32) = 12;
    x = 13;
  };
  // Compile-time immutable variable
  {
    x :: 12;
    // x = 13; // error
  };
  {
    // Compile-time mutable variable
    x :: 12;
    x = 13;
  };
  {
    comptime(x) : Type;
    x = struct(x : i32, y : i32);
  };
});
test("Test variable shadowing", {
  {
    (x : i32) = 12;
    comptime_expect_error(
      x := 13 // Not allowed, because `x` already exists at the current frame.
    );
    assert(x == 12);
    {
      comptime_expect_error(
        x := 15 // Not allowed, because `x` already exists at upper frame.
      );
    };
    assert(x == 12);
  };
});
test("Test comptime", {
  comptime_12 :: (fn() -> comptime(i32))(
    12
  );
  Point :: struct(
    x : i32,
    y : i32
  );
  {
    x :: 13;
    y := x;
    z :: comptime_12();
    assert((y + z) == 25);
  };
  {
    use_point :: (fn(p : Point) -> i32)(p.x + p.y);
    p :: Point(comptime_12(), 16);
    assert(use_point(p) == 28);
  };
});
test("Test destructuring", {
  // tuple destructuring
  {
    t := (1, 3.4, true);
    (t2 : Tuple(a : i32, b : f64, c : bool)) = t;
    {
      // by index
      assert(t.0 == 1);
      assert(t.1 == 3.4);
      assert(t.2 == true);
    };
    {
      // by index
      assert(t2.0 == 1);
      assert(t2.1 == 3.4);
      assert(t2.2 == true);
      // by label
      assert(t2.a == 1);
      assert(t2.b == 3.4);
      assert(t2.c == true);
    };
    {
      // by order
      (x, y, z) := t;
      assert(x == 1);
      assert(y == 3.4);
      assert(z == true);
    };
    {
      // by order
      (c, b, a) := t2;
      assert(c == 1);
      assert(b == 3.4);
      assert(a == true);
    };
    {
      // by label
      (c : c, b : b, a : a) := t2;
      assert(a == 1);
      assert(b == 3.4);
      assert(c == true);
    };
    {
      // by label with different names
      (c : c1, b : b1, a : a1) := t2;
      assert(a1 == 1);
      assert(b1 == 3.4);
      assert(c1 == true);
    };
  };
  // struct destructuring
  {
    Point :: struct(x : i32, y : f64);
    point := Point(3, 4.5);
    {
      { x, y } := point;
      assert(x == 3);
      assert(y == 4.5);
    };
    {
      { y, x } := point;
      assert(x == 3);
      assert(y == 4.5);
    };
    {
      _(x : a, y : b) := point;
      assert(a == 3);
      assert(b == 4.5);
    };
    {
      { x : another_x } := point;
      assert(another_x == 3);
    };
    {
      { x : another_x, ... } := point;
      assert(another_x == 3);
      assert(y == 4.5);
    };
  };
});
test("Test type auto derive Send", {
  comptime_assert(Type.impls(i32, Send));
  Point :: struct(x : i32, y : i32);
  comptime_assert(Type.impls(Point, Send) == true);
  MyBox :: object(v : i32);
  comptime_assert(Type.impls(MyBox, Send) == false);
  GenericPoint :: (fn(comptime(T) : Type) -> comptime(Type))(struct(x : T, y : T));
  comptime_assert(Type.impls(GenericPoint(i32), Send) == true);
  comptime_assert(Type.impls(GenericPoint(MyBox), Send) == false);
});
test("Test Send on pointer-bearing types is conditional on the pointee", {
  // Pre-condition: a non-Send carrier to use as a negative pointee.
  NonSendCarrier :: object(v : i32);
  comptime_assert(Type.impls(NonSendCarrier, Send) == false);
  // *(T): Send iff T: Send.
  comptime_assert(Type.impls(*(i32), Send) == true);
  comptime_assert(Type.impls(*(NonSendCarrier), Send) == false);
  // str (builtin static string view) is Send.
  comptime_assert(Type.impls(str, Send) == true);
  // Array(T, N): Send iff T: Send.
  comptime_assert(Type.impls(Array(i32, 4), Send) == true);
  comptime_assert(Type.impls(Array(NonSendCarrier, 4), Send) == false);
  // Nullable pointer ?*(T): same as *(T) via Option(*(T)) desugar.
  comptime_assert(Type.impls(?*(i32), Send) == true);
});
test("Test type auto derive Acyclic", {
  // Primitive types are Acyclic
  // Compile-time only types
  comptime_assert(Type.impls(comptime_int, Acyclic));
  comptime_assert(Type.impls(comptime_float, Acyclic));
  comptime_assert(Type.impls(comptime_str, Acyclic));
  comptime_assert(Type.impls(Expr, Acyclic));
  comptime_assert(Type.impls(ComptimeList(i32), Acyclic));
  // Primitive types that can exist at comptime
  comptime_assert(Type.impls(bool, Acyclic));
  comptime_assert(Type.impls(usize, Acyclic));
  comptime_assert(Type.impls(isize, Acyclic));
  comptime_assert(Type.impls(u8, Acyclic));
  comptime_assert(Type.impls(i8, Acyclic));
  comptime_assert(Type.impls(u16, Acyclic));
  comptime_assert(Type.impls(i16, Acyclic));
  comptime_assert(Type.impls(u32, Acyclic));
  comptime_assert(Type.impls(i32, Acyclic));
  comptime_assert(Type.impls(u64, Acyclic));
  comptime_assert(Type.impls(i64, Acyclic));
  comptime_assert(Type.impls(f32, Acyclic));
  comptime_assert(Type.impls(f64, Acyclic));
  comptime_assert(Type.impls(unit, Acyclic));
  // C compatible types are runtime only
  comptime_assert(Type.impls(void, Acyclic));
  comptime_assert(Type.impls(char, Acyclic));
  comptime_assert(Type.impls(short, Acyclic));
  comptime_assert(Type.impls(ushort, Acyclic));
  comptime_assert(Type.impls(int, Acyclic));
  comptime_assert(Type.impls(uint, Acyclic));
  comptime_assert(Type.impls(long, Acyclic));
  comptime_assert(Type.impls(ulong, Acyclic));
  comptime_assert(Type.impls(longlong, Acyclic));
  comptime_assert(Type.impls(ulonglong, Acyclic));
  comptime_assert(Type.impls(longdouble, Acyclic));
  // Value structs without object fields are Acyclic
  Point :: struct(x : i32, y : i32);
  comptime_assert(Type.impls(Point, Acyclic) == true);
  // Object types that don't form cycles are Acyclic
  SimpleBox :: object(v : i32);
  comptime_assert(Type.impls(SimpleBox, Acyclic) == true);
  // Self-referencing object (can form cycle) is NOT Acyclic
  Node :: object(value : i32, next : Option(Self));
  comptime_assert(Type.impls(Node, Acyclic) == false);
  //
  // Generic struct: Acyclic depends on type parameter
  GenericPoint :: (fn(comptime(T) : Type) -> comptime(Type))(struct(x : T, y : T));
  comptime_assert(Type.impls(GenericPoint(i32), Acyclic) == true);
  comptime_assert(Type.impls(GenericPoint(Node), Acyclic) == false);
  // Enum types
  Direction :: enum(North, South, East, West);
  comptime_assert(Type.impls(Direction, Acyclic) == true);
  // Enum with i32 fields
  ResultInt :: enum(Ok(value : i32), Err(error : i32));
  comptime_assert(Type.impls(ResultInt, Acyclic) == true);
});
test("Test type auto derive Comptime", {
  // Compile-time only types
  comptime_assert(Type.impls(comptime_int, Comptime));
  comptime_assert(Type.impls(comptime_float, Comptime));
  comptime_assert(Type.impls(comptime_str, Comptime));
  comptime_assert(Type.impls(Expr, Comptime));
  comptime_assert(Type.impls(ComptimeList(i32), Comptime));
  // Primitive types that can exist at comptime
  comptime_assert(Type.impls(bool, Comptime));
  comptime_assert(Type.impls(usize, Comptime));
  comptime_assert(Type.impls(isize, Comptime));
  comptime_assert(Type.impls(u8, Comptime));
  comptime_assert(Type.impls(i8, Comptime));
  comptime_assert(Type.impls(u16, Comptime));
  comptime_assert(Type.impls(i16, Comptime));
  comptime_assert(Type.impls(u32, Comptime));
  comptime_assert(Type.impls(i32, Comptime));
  comptime_assert(Type.impls(u64, Comptime));
  comptime_assert(Type.impls(i64, Comptime));
  comptime_assert(Type.impls(f32, Comptime));
  comptime_assert(Type.impls(f64, Comptime));
  comptime_assert(Type.impls(unit, Comptime));
  // C compatible types are runtime only
  comptime_assert(Type.impls(void, Comptime) == false);
  comptime_assert(Type.impls(char, Comptime) == false);
  comptime_assert(Type.impls(short, Comptime) == false);
  comptime_assert(Type.impls(ushort, Comptime) == false);
  comptime_assert(Type.impls(int, Comptime) == false);
  comptime_assert(Type.impls(uint, Comptime) == false);
  comptime_assert(Type.impls(long, Comptime) == false);
  comptime_assert(Type.impls(ulong, Comptime) == false);
  comptime_assert(Type.impls(longlong, Comptime) == false);
  comptime_assert(Type.impls(ulonglong, Comptime) == false);
  comptime_assert(Type.impls(longdouble, Comptime) == false);
  // Array
  comptime_assert(Type.impls(Array(i32, 3), Comptime));
  comptime_assert(Type.impls(Array(comptime_int, 3), Comptime));
  comptime_assert(Type.impls(Array(Box(i32), 3), Comptime) == false);
  // Slice
  // Tuple
  comptime_assert(Type.impls(Tuple(i32), Comptime));
  comptime_assert(Type.impls(Tuple(comptime_int), Comptime));
  comptime_assert(Type.impls(Tuple(Box(i32)), Comptime) == false);
  // Ptr
  // Yo support compile-time pointer
  comptime_assert(Type.impls(*(comptime_int), Comptime));
  comptime_assert(Type.impls(*(i32), Comptime));
  comptime_assert(Type.impls(*(Box(i32)), Comptime) == false);
  // Function
  comptime_assert(Type.impls(fn() -> unit, Comptime));
  // Iso type is runtime only
  comptime_assert(Type.impls(Iso(i32), Comptime) == false);
  // Value structs with comptime-compatible fields are Comptime
  Point :: struct(x : i32, y : i32);
  comptime_assert(Type.impls(Point, Comptime) == true);
  // Object types are NOT Comptime (reference-counted, runtime-only)
  MyBox :: object(v : i32);
  comptime_assert(Type.impls(MyBox, Comptime) == false);
  // Generic struct: Comptime depends on type parameter
  GenericPoint :: (fn(comptime(T) : Type) -> comptime(Type))(struct(x : T, y : T));
  comptime_assert(Type.impls(GenericPoint(i32), Comptime) == true);
  comptime_assert(Type.impls(GenericPoint(MyBox), Comptime) == false);
  // Enum types with comptime-compatible fields are Comptime
  Direction :: enum(North, South, East, West);
  comptime_assert(Type.impls(Direction, Comptime) == true);
  ResultInt :: enum(Ok(value : i32), Err(error : i32));
  comptime_assert(Type.impls(ResultInt, Comptime) == true);
  // Union type is runtime only
  UnionData :: union(a : i32, b : bool);
  comptime_assert(Type.impls(UnionData, Comptime) == false);
  // SomeType
  fn1 :: (fn(comptime(T) : Type) -> unit)({
    comptime_assert(Type.impls(T, Comptime) == false);
  });
  fn2 :: (fn(comptime(T) : Type, where(T <: Comptime)) -> unit)({
    comptime_assert(Type.impls(T, Comptime));
  });
  fn3 :: (fn(forall(T : Type), v : T) -> unit)({
    comptime_assert(Type.impls(T, Comptime) == false);
  });
  fn4 :: (fn(forall(T : Type), v : T, where(T <: Comptime)) -> unit)({
    comptime_assert(Type.impls(T, Comptime));
  });
  // Recursive type
  {
    SelfRecursive :: struct(
      v : i32,
      next : *(Self)
    );
    // i32 is both comptime and runtime
    // *(Self) is both comptime and runtime
    // therefore SelfRecursive should be both comptime and runtime
    comptime_assert(Type.impls(SelfRecursive, Comptime));
    // next: *(Self) is both comptime and runtime
    // therefore SelfRecursive2 should be both comptime and runtime
    SelfRecursive2 :: struct(
      next : *(Self)
    );
    comptime_assert(Type.impls(SelfRecursive2, Comptime));
    // v : int is only runtime
    // therefore SelfRecursive3 should be only runtime
    SelfRecursive3 :: struct(
      v : int,
      next : *(Self)
    );
    comptime_assert(Type.impls(SelfRecursive3, Comptime) == false);
    // v : comptime_int is only comptime
    // therefore SelfRecursive4 should be only comptime
    SelfRecursive4 :: struct(
      v : comptime_int,
      next : *(Self)
    );
    comptime_assert(Type.impls(SelfRecursive4, Comptime));
  };
});
test("Test type auto derive Runtime", {
  // Compile-time only types are not runtime available
  comptime_assert(Type.impls(comptime_int, Runtime) == false);
  comptime_assert(Type.impls(comptime_float, Runtime) == false);
  comptime_assert(Type.impls(comptime_str, Runtime) == false);
  comptime_assert(Type.impls(Expr, Runtime) == false);
  comptime_assert(Type.impls(ComptimeList(i32), Runtime) == false);
  // Primitive types that can exist at runtime
  comptime_assert(Type.impls(bool, Runtime));
  comptime_assert(Type.impls(i32, Runtime));
  comptime_assert(Type.impls(f64, Runtime));
  comptime_assert(Type.impls(usize, Runtime));
  comptime_assert(Type.impls(isize, Runtime));
  comptime_assert(Type.impls(u8, Runtime));
  comptime_assert(Type.impls(i8, Runtime));
  comptime_assert(Type.impls(u16, Runtime));
  comptime_assert(Type.impls(i16, Runtime));
  comptime_assert(Type.impls(u32, Runtime));
  comptime_assert(Type.impls(i32, Runtime));
  comptime_assert(Type.impls(u64, Runtime));
  comptime_assert(Type.impls(i64, Runtime));
  comptime_assert(Type.impls(f32, Runtime));
  comptime_assert(Type.impls(f64, Runtime));
  comptime_assert(Type.impls(unit, Runtime));
  // C compatible types are runtime only
  comptime_assert(Type.impls(void, Runtime));
  comptime_assert(Type.impls(char, Runtime));
  comptime_assert(Type.impls(short, Runtime));
  comptime_assert(Type.impls(ushort, Runtime));
  comptime_assert(Type.impls(int, Runtime));
  comptime_assert(Type.impls(uint, Runtime));
  comptime_assert(Type.impls(long, Runtime));
  comptime_assert(Type.impls(ulong, Runtime));
  comptime_assert(Type.impls(longlong, Runtime));
  comptime_assert(Type.impls(ulonglong, Runtime));
  comptime_assert(Type.impls(longdouble, Runtime));
  // Array
  comptime_assert(Type.impls(Array(i32, 3), Runtime));
  comptime_assert(Type.impls(Array(comptime_int, 3), Runtime) == false);
  comptime_assert(Type.impls(Array(Box(i32), 3), Runtime));
  // Slice
  // Tuple
  comptime_assert(Type.impls(Tuple(i32), Runtime));
  comptime_assert(Type.impls(Tuple(comptime_int), Runtime) == false);
  comptime_assert(Type.impls(Tuple(Box(i32)), Runtime));
  // Ptr
  // Yo support compile-time pointer
  comptime_assert(Type.impls(*(comptime_int), Runtime) == false);
  comptime_assert(Type.impls(*(i32), Runtime));
  comptime_assert(Type.impls(*(Box(i32)), Runtime));
  // Function
  comptime_assert(Type.impls(fn() -> unit, Runtime));
  // Iso type is runtime only
  comptime_assert(Type.impls(Iso(i32), Runtime));
  // Value structs with runtime-compatible fields are Runtime
  Point :: struct(x : i32, y : i32);
  comptime_assert(Type.impls(Point, Runtime) == true);
  // Object types are Runtime
  MyBox :: object(v : i32);
  comptime_assert(Type.impls(MyBox, Runtime) == true);
  // Generic struct: Runtime depends on type parameter
  GenericPoint :: (fn(comptime(T) : Type) -> comptime(Type))(struct(x : T, y : T));
  comptime_assert(Type.impls(GenericPoint(i32), Runtime) == true);
  // Enum types with runtime-compatible fields are Runtime
  Direction :: enum(North, South, East, West);
  comptime_assert(Type.impls(Direction, Runtime) == true);
  ResultInt :: enum(Ok(value : i32), Err(error : i32));
  comptime_assert(Type.impls(ResultInt, Runtime) == true);
  // Union type is runtime only
  UnionData :: union(a : i32, b : bool);
  comptime_assert(Type.impls(UnionData, Runtime));
  // SomeType
  fn1 :: (fn(comptime(T) : Type) -> unit)({
    comptime_assert(Type.impls(T, Runtime));
  });
  fn2 :: (fn(comptime(T) : Type, where(T <: !(Runtime))) -> unit)({
    comptime_assert(Type.impls(T, Runtime) == false);
  });
  fn3 :: (fn(forall(T : Type), v : T) -> unit)({
    comptime_assert(Type.impls(T, Runtime));
  });
  fn4 :: (fn(forall(T : Type), v : T, where(T <: !(Runtime))) -> unit)({
    comptime_assert(Type.impls(T, Runtime) == false);
  });
  // Self recursive types
  {
    SelfRecursive :: struct(
      v : i32,
      next : *(Self)
    );
    // i32 is both comptime and runtime
    // *(Self) is both comptime and runtime
    // therefore SelfRecursive should be both comptime and runtime
    comptime_assert(Type.impls(SelfRecursive, Runtime));
    // next: *(Self) is both comptime and runtime
    // therefore SelfRecursive2 should be both comptime and runtime
    SelfRecursive2 :: struct(
      next : *(Self)
    );
    comptime_assert(Type.impls(SelfRecursive2, Runtime));
    // v : int is only runtime
    // therefore SelfRecursive3 should be only runtime
    SelfRecursive3 :: struct(
      v : int,
      next : *(Self)
    );
    comptime_assert(Type.impls(SelfRecursive3, Runtime));
    // v : comptime_int is only comptime
    // therefore SelfRecursive4 should be only comptime
    SelfRecursive4 :: struct(
      v : comptime_int,
      next : *(Self)
    );
    comptime_assert(Type.impls(SelfRecursive4, Runtime) == false);
  };
});
test("Test 'struct'", {
  // Struct
  {
    Point :: struct(x : i32, y : i32);
    p := Point(3, 4); // Assign comptime to runtime
    p2 :: Point(3, 4); // Assign comptime to comptime
    runt_value := 1;
    p3 := Point(runt_value, 4);
    comptime_expect_error(
      p4 :: Point(runt_value, 4) // Assign runt to comptime is not allowed
    );
    assert(p.x == 3);
    assert(p.y == 4);
    comptime_assert(p2.x == 3);
    comptime_assert(p2.y == 4);
    assert(p3.x == 1);
    assert(p3.y == 4);
  };
  {
    Point :: struct(x : i32, (y : i32) ?= 12);
    p4 :: Point(14);
    assert(p4.x == 14);
    assert(p4.y == 12);
  };
  // curly brackets
  {
    Point :: struct(x : i32, y : bool);
    p := Point(3, true);
    (p2 : Point) = _(3, true);
    (p3 : Point) = { x : 3, y : true };
    (p4 : Point) = { y : true, x : 3 };
    x := 1;
    y := true;
    (p5 : Point) = { x, y };
    (p6 : Point) = { y, x };
    {
      { x : another_x, y : a } := p;
      a;
    };
    {
      { x : a, y : b } := p;
      a;
      b;
    };
  };
  // nomimal type
  {
    Point1 :: struct(x : i32, y : i32);
    Point2 :: struct(x : i32, y : i32);
    x := Point1(3, 4);
    (y : Point2) = _(5, 6);
    comptime_expect_error(
      (z : Point1) := (3, 4),
      "error: type Mismatch"
    );
    Point3 :: Point1;
    (z : Point2) = y;
    (z2 : Point3) = x;
    comptime_expect_error(
      (z3 : Point2) = x,
      "error: type Mismatch"
    );
    assert(x.x == 3);
    assert(x.y == 4);
    assert(y.x == 5);
    assert(y.y == 6);
    assert(z.x == 5);
    assert(z.y == 6);
    assert(z2.x == 3);
    assert(z2.y == 4);
  };
  // anonymous struct
  {
    p := (struct(x : i32, y : i32))(3, 4);
    (p2 : struct(x : i32, y : i32)) = _(3, 4);
    assert(p.x == 3);
    assert(p.y == 4);
    assert(p2.x == 3);
    assert(p2.y == 4);
  };
  // struct default field values
  {
    Point :: struct(
      (x : i32) ?= 0,
      (y : i32) ?= 0
    );
    p := Point(y : 1, x : 2);
    p2 := Point();
    p3 := Point(13);
    p4 := Point(x : 2);
    p5 := Point(y : 3);
    assert(p.x == 2);
    assert(p.y == 1);
    assert(p2.x == 0);
    assert(p2.y == 0);
    assert(p3.x == 13);
    assert(p3.y == 0);
    assert(p4.x == 2);
    assert(p4.y == 0);
    assert(p5.x == 0);
    assert(p5.y == 3);
  };
  // struct default field values — mixed required and optional
  {
    Config :: struct(
      name : i32,
      (width : i32) ?= 800,
      (height : i32) ?= 600,
      (visible : bool) ?= true
    );
    // all defaults
    c1 := Config(name : 1);
    assert(c1.name == 1);
    assert(c1.width == 800);
    assert(c1.height == 600);
    assert(c1.visible == true);
    // override some defaults
    c2 := Config(name : 2, width : 1024);
    assert(c2.name == 2);
    assert(c2.width == 1024);
    assert(c2.height == 600);
    assert(c2.visible == true);
    // override all fields
    c3 := Config(name : 3, width : 1920, height : 1080, visible : false);
    assert(c3.name == 3);
    assert(c3.width == 1920);
    assert(c3.height == 1080);
    assert(c3.visible == false);
    // override non-adjacent defaults (skip width, set height)
    c4 := Config(name : 4, height : 480);
    assert(c4.name == 4);
    assert(c4.width == 800);
    assert(c4.height == 480);
    assert(c4.visible == true);
    // override only last default
    c5 := Config(name : 5, visible : false);
    assert(c5.name == 5);
    assert(c5.width == 800);
    assert(c5.height == 600);
    assert(c5.visible == false);
  };
  // struct default field values — all fields have defaults
  {
    Opts :: struct(
      (a : i32) ?= 10,
      (b : i32) ?= 20,
      (c : i32) ?= 30
    );
    o1 := Opts();
    assert(o1.a == 10);
    assert(o1.b == 20);
    assert(o1.c == 30);
    o2 := Opts(a : 100);
    assert(o2.a == 100);
    assert(o2.b == 20);
    assert(o2.c == 30);
    o3 := Opts(b : 200);
    assert(o3.a == 10);
    assert(o3.b == 200);
    assert(o3.c == 30);
    o4 := Opts(c : 300);
    assert(o4.a == 10);
    assert(o4.b == 20);
    assert(o4.c == 300);
    o5 := Opts(a : 1, c : 3);
    assert(o5.a == 1);
    assert(o5.b == 20);
    assert(o5.c == 3);
  };
  // struct default field values — expression defaults
  {
    Base :: struct((x : i32) ?= (3 + 4));
    b := Base();
    assert(b.x == 7);
    b2 := Base(x : 99);
    assert(b2.x == 99);
  };
  // struct default field values — positional args fill in order, defaults for rest
  {
    Triple :: struct(
      a : i32,
      (b : i32) ?= 100,
      (c : i32) ?= 200
    );
    t1 := Triple(1);
    assert(t1.a == 1);
    assert(t1.b == 100);
    assert(t1.c == 200);
    t2 := Triple(1, 2);
    assert(t2.a == 1);
    assert(t2.b == 2);
    assert(t2.c == 200);
    t3 := Triple(1, 2, 3);
    assert(t3.a == 1);
    assert(t3.b == 2);
    assert(t3.c == 3);
  };
  // struct in tuple
  {
    {
      SomeStruct :: struct(x : i32, y : bool);
      Complex :: Tuple(s : SomeStruct);
      x := SomeStruct(1, true);
      (y : SomeStruct) = _(1, false);
      (c : Complex) = (_(3, true),);
      assert(x.x == 1);
      assert(x.y == true);
      assert(y.x == 1);
      assert(y.y == false);
      assert(c.0.x == 3);
      assert(c.0.y == true);
    };
    {
      Complex :: struct(x : Tuple(i32, bool), y : i32);
      (c : Complex) = _((3, true), 4);
      assert(c.x.0 == 3);
      assert(c.x.1 == true);
      assert(c.y == 4);
    };
    {
      SomeStruct :: struct(x : i32, y : bool);
      Complex0 :: Tuple(SomeStruct);
      Complex :: Tuple(Complex0);
      (c : SomeStruct) = _(3, false);
      (c2 : Complex0) = (_(3, true),);
      (c3 : Complex) = ((_(3, true),),);
      (c4 : Complex) = ((_(y : true, x : 1),),);
      assert(c.x == 3);
      assert(c.y == false);
      assert(c2.0.x == 3);
      assert(c2.0.y == true);
      assert(c3.0.0.x == 3);
      assert(c3.0.0.y == true);
      assert(c4.0.0.x == 1);
      assert(c4.0.0.y == true);
    };
  };
  // type methods
  {
    Withdraw :: struct(
      balance : i32
    );
    impl(
      Withdraw,
      withdraw : (fn(self : *(Self), amount : i32) -> i32)(
        cond(
          (self.balance >= amount) => {
            self.balance = (self.balance - amount);
            return(self.balance);
          },
          true => {
            return(0); // insufficient balance
          }
        )
      )
    );
    make_widthdraw_balance_100 :: (fn() -> Withdraw)({
      (balance : i32) = 100;
      return({ balance });
    });
    bank := make_widthdraw_balance_100();
    left := bank.withdraw(50);
    left2 := bank.withdraw(30);
    left3 := bank.withdraw(40);
    assert(left == 50);
    assert(left2 == 20);
    assert(left3 == 0);
  };
  // type methods for generic type
  {
    MyStruct :: (fn(comptime(T) : Type) -> comptime(Type))(
      struct(value : T)
    );
    impl(
      forall(T : Type),
      MyStruct(T),
      new : (fn(v : T) -> Self)(Self(v)),
      another_new : (fn(v : T) -> Self)(
        Self.new(v)
      ),
      add : (fn(self : *(Self), value : T, where(T <: Add(T))) -> unit)({
        self.value = (self.value + value);
      }),
      another_add : (fn(self : *(Self), value : T, where(T <: Add(T))) -> unit)({
        self.add(value);
      })
    );
    value := 10;
    x := MyStruct(i32).new(value);
    y := MyStruct(i32).another_new(value);
    assert(x.value == value);
    assert(y.value == value);
    x.add(3);
    y.another_add(4);
    assert(x.value == (value + 3));
    assert(y.value == (value + 4));
  };
});
test("Test 'enum'", {
  {
    Color :: enum(Red, Green, Blue);
    (r : Color) = Color.Red;
    r2 := Color.Blue;
    Shape :: enum(
      Circle(r : i32),
      Rectangle(w : i32, h : i32)
    );
    (c : Shape) = Shape.Circle(5);
    c2 := Shape.Rectangle(h : 1, w : 2);
  };
  // Anonymous enum
  {
    color := (enum(Red, Green, Blue)).Red;
    (color2 : enum(Red, Green, Blue)) =.Blue;
    shape := (
      enum(
        Circle(r : i32),
        Rectangle(w : i32, h : i32)
      )
    ).Circle(5);
    (
      shape2 : enum(
        Circle(r : i32),
        Rectangle(w : i32, h : i32)
      )
    ) =.Rectangle(h : 1, w : 2);
  };
  // Type methods
  {
    Shape :: enum(
      Circle(radius : i32),
      Rectangle(width : i32, height : i32),
      Triangle(base : i32, height : i32)
    );
    impl(
      Shape,
      new_circle : (fn(radius : i32) -> Self)(
        .Circle(radius)
      ),
      id : (fn(self : Self) -> Self)(
        self
      )
    );
    // c := Shape.new_circle(5);
    // c2 := c.id();
    // c2.radius = 10;
    // assert(c.radius == 5);
    // assert(c2.radius == 10);
  };
  // Nested enum
  {
    NestedEnum :: enum(
      Level1(
        x : enum(Level2(value : i32))
      )
    );
    n := NestedEnum.Level1(.Level2(3));
    (n2 : NestedEnum) =.Level1(.Level2(3));
  };
  // Discriminant values
  {
    Color :: enum(
      Red,
      // implicitly 0
      Green = 6,
      Blue = 9
    );
    Shape :: enum(
      Circle(radius : i32) = 2,
      Square(side : i32) = 4,
      Triangle(base : i32, height : i32) // implicitly 5
    );
    red := i32(Color.Red);
    assert(red == i32(0));
    green := i32(Color.Green);
    assert(green == i32(6));
    blue := i32(Color.Blue);
    assert(blue == i32(9));
    circle := i32(Shape.Circle(10));
    assert(circle == i32(2));
    square := i32(Shape.Square(5));
    assert(square == i32(4));
    triangle := i32(Shape.Triangle(3, 4));
    assert(triangle == i32(5));
    expect_triangle :: (fn(shape : Shape) -> unit)({
      assert(i32(shape) == i32(5));
    });
    expect_triangle(Shape.Triangle(5, 6));
  };
});
test("Test 'union'", {
  SomeUnion :: union(
    x : i32,
    y : bool
  );
  impl(
    SomeUnion,
    new : (fn() -> Self)(Self(x : 0))
  );
  v1 := SomeUnion(x : 12);
  v2 := SomeUnion(y : true);
  v3 := SomeUnion.new();
  {
    a := v1.x;
    assert(a == 12);
    b := v2.y;
    assert(b == true);
    c := v3.x;
    assert(c == 0);
  };
  {
    { x } := v1;
    assert(x == 12);
    { y : z } := v1; // unsafe access
  };
});
