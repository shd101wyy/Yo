  };
});
test("Test type availability", {
  // ===== STRUCT TESTS =====
  {
    Point :: struct(x : i32, y : i32); // Point can create both compile-time and run-time values
    // as i32 can be used in both contexts
    a :: Point(3 + 5, 4); // compile-time value
    b := Point(6, 8); // run-time value
    r := 12;
    comptime_expect_error(c :: Point(r, 15)); // Should give error, as r is a run-time value
    d := Point(r, 20); // valid run-time value
  };
  {
    Point2 :: struct(x : comptime_int, y : comptime_int); // Point2 can only create compile-time values
    // as comptime_int can only be used in compile-time context
    x :: Point2(3 + 5, 4); // compile-time value
    comptime_expect_error(
      y := Point2(6, 8) // error: cannot create run-time value of type Point2
    );
  };
  {
    comptime_expect_error(
      Point3 :: struct(x : comptime_int, y : Box(i32)) // Error: incompatible field contexts
      // comptime_int can only be used in compile-time context,
      // Box `object` can only be used in run-time context.
      // There is no intersection between the two contexts.
    );
  };
  {
    Point4 :: struct(x : comptime_int, y : i32); // Point4 can only be used to create compile-time values
    // comptime_int can only be used in compile-time context,
    // i32 can be used in both contexts,
    // so the intersection is compile-time context
    x :: Point4(10, 20); // compile-time value
    comptime_expect_error(
      y := Point4(30, 40) // error: cannot create run-time value of type Point4
    );
  };
  // ===== TUPLE TESTS =====
  {
    // Tuple can be used in both contexts
    a :: (5, 10); // compile-time value
    b := (15, 20); // run-time value
    r := 25;
    c := (r, 30); // valid run-time value
    comptime_expect_error(
      d :: (r, 40) // error: cannot create compile-time value with run-time element
    );
  };
  {
    Pair :: Tuple(x : comptime_int, y : comptime_int); // Tuple can only be used in compile-time context
    (comptime(x) : Pair) = (11, 12); // compile-time value
    comptime_expect_error(
      (y : Pair) = (13, 14) // error: cannot create run-time value
    );
  };
  // ===== ENUM TESTS =====
  {
    MyResult :: enum(
      Ok(value : i32),
      Err(msg : i32)
    ); // Enum can be used in both contexts
    a :: MyResult.Ok(42); // compile-time value
    b := MyResult.Err(1); // run-time value
    r := 10;
    c := MyResult.Ok(r); // valid run-time value
  };
  {
    ComptResult :: enum(
      Ok(value : comptime_int),
      Err(code : comptime_int)
    ); // Enum can only be used in compile-time context
    x :: ComptResult.Ok(123); // compile-time value
    comptime_expect_error(
      y := ComptResult.Err(456) // error: cannot create run-time value
    );
  };
  {
    comptime_expect_error(
      MixedResult :: enum(
        Ok(value : comptime_int),
        Err(ptr : Box(i32))
      ) // Error: incompatible variant field contexts
    );
  };
  {
    HalfComptResult :: enum(
      Ok(value : comptime_int),
      Err(code : i32)
    ); // Only compile-time context available (intersection of variant availabilities)
    x :: HalfComptResult.Ok(999); // compile-time value
    comptime_expect_error(
      y := HalfComptResult.Err(888) // error: cannot create run-time value
    );
  };
  // ===== ARRAY TESTS =====
  {
    IntArray :: [i32 ; 3]; // Array can be used in both contexts
    a :: IntArray(1, 2, 3); // compile-time value
    b := IntArray(4, 5, 6); // run-time value
  };
  {
    ComptArray :: [comptime_int ; 2]; // Array can only be used in compile-time context
    x :: ComptArray(10, 20); // compile-time value
    comptime_expect_error(
      y := ComptArray(30, 40) // error: cannot create run-time value
    );
  };
  // ===== UNION TESTS =====
  // Union can only accept runtime fields
  {
    MyUnion :: union(x : i32, y : i32); // allowed
    comptime_expect_error(
      MyComptUnion :: union(a : comptime_int, b : i32) // error: field 'a' is compile-time only
    );
  };
});
test("Test 'comptime_fn' function call and function overloading", {
  add :: impl({
    _add :: (fn(x : i32, y : i32) -> i32)({
      return(x + y);
    });
    comptime_add :: comptime_fn(_add); // Convert `add` to a comptime function.
    // Panic if fails to convert.
    Call :: (_add, comptime_add);
    export(Call);
  });
  MyOption :: (fn(comptime(T) : Type) -> comptime(Type))(
    enum(
      None,
      Some(value : T)
    )
  );
  impl(
    forall(T : Type),
    MyOption(T),
    unwrap : (fn(self : Self) -> T)(
      match(
        self,
        .Some(value) => value,
        .None => panic("Called unwrap on a None value")
      )
    )
  );
  impl(
    forall(T : Type),
    where(T <: Comptime),
    MyOption(T),
    comptime_unwrap : (fn(comptime(self) : Self) -> comptime(T))(
      match(
        self,
        .Some(value) => value,
        .None => comptime_assert(false, "Called unwrap on a None value at comptime")
      )
    )
  );
  op := MyOption(i32).Some(12);
  match(
    op,
    .Some(_) => {
      assert(true);
    },
    .None => {
      x :: add(3, 4); // compile-time function call
      comptime_assert(x == 7);
      y := add(4, 5); // run-time function call
      assert(y == 9);
      assert(false, "Expected Some, got None");
    }
  );
  val := op.unwrap();
  assert(val == 12);
  op2 :: MyOption(i32).Some(55);
  val2 :: op2.comptime_unwrap();
  comptime_assert(val2 == 55);
});
test("Test comptime while loop unrolling with runtime body", {
  // 2-arg form: comptime counter with runtime accumulator
  {
    sum := 0;
    i :: 0;
    while(comptime(i < 5), {
      sum = (sum + i32(i));
      i = (i + 1);
    });
    assert(sum == 10, "2-arg unrolled sum should be 10");
  };
  // 3-arg form: comptime counter with step expression and runtime accumulator
  {
    sum := 0;
    i :: 0;
    while(comptime(i < 5), i = (i + 1), {
      sum = (sum + i32(i));
    });
    assert(sum == 10, "3-arg unrolled sum should be 10");
  };
  // comptime condition initially false: body should not execute
  {
    sum := 0;
    i :: 10;
    while(comptime(i < 5), {
      sum = (sum + i32(i));
      i = (i + 1);
    });
    assert(sum == 0, "initially false condition should produce 0");
  };
  // single iteration unroll
  {
    sum := 0;
    i :: 0;
    while(comptime(i < 1), {
      sum = (sum + i32(i));
      i = (i + 1);
    });
    assert(sum == 0, "single iteration should produce 0");
  };
  // comptime unrolled while with multiple runtime side effects per iteration
  {
    a := 0;
    b := 0;
    i :: 0;
    while(comptime(i < 3), {
      a = (a + i32(i));
      b = (b + i32(i * i));
      i = (i + 1);
    });
    assert(a == 3, "a should be 0+1+2 = 3");
    assert(b == 5, "b should be 0+1+4 = 5");
  };
});
test("Test comptime match branch elimination", {
  // primitive match with comptime scrutinee — only matching branch should be emitted
  {
    x :: 2;
    result := match(
      x,
      1 => i32(10),
      2 => i32(20),
      3 => i32(30),
      _ => i32(0)
    );
    assert(result == 20, "match on comptime 2 should yield 20");
  };
  // comptime scrutinee matching first branch
  {
    x :: 1;
    result := match(
      x,
      1 => i32(100),
      2 => i32(200),
      _ => i32(0)
    );
    assert(result == 100, "match on comptime 1 should yield 100");
  };
  // comptime scrutinee matching wildcard
  {
    x :: 99;
    result := match(
      x,
      1 => i32(10),
      2 => i32(20),
      _ => i32(999)
    );
    assert(result == 999, "match on comptime 99 should yield wildcard 999");
  };
});
// Test: return in match branch should be treated as never type
test("return in match branch type compatibility", {
  open(import("std/collections/array_list"));
  test_fn :: (fn() -> unit)({
    (list : ArrayList(u8)) = ArrayList(u8).new();
    list.push(u8(42));
    // .None branch returns from the function — its type should be never/bottom,
    // compatible with *(u8) expected type from .Some branch
    (ptr : *(u8)) = match(
      list._ptr,
      .Some(p) => p,
      .None => {
        return(());
      }
    );
    assert(ptr.* == u8(42), "ptr value should be 42");
  });
  test_fn();
});
// Test: { } without semicolons is a struct literal, not a block.
// Single-expression function bodies must be written directly (no wrapping braces),
// or as multi-statement blocks with semicolons.
test("single-expression function body without braces", {
  // Single-expression body: written directly, no outer { }
  double :: (fn(x : i32) -> i32)(
    x * i32(2)
  );
  assert(double(i32(3)) == i32(6), "double should work");
  // Multi-statement block: { } WITH semicolons is still a valid block
  add_one_verbose :: (fn(x : i32) -> i32)({
    y := (x + i32(1));
    y
  });
  assert(add_one_verbose(i32(4)) == i32(5), "add_one_verbose should work");
});
// Test: indexing a function call result directly (temporary)
test("index function call result", {
  open(import("std/collections/array_list"));
  get_list :: (fn() -> ArrayList(u8))({
    (list : ArrayList(u8)) = ArrayList(u8).new();
    list.push(u8(10));
    list.push(u8(20));
    list.push(u8(30));
    list
  });
  // Index directly into function return value
  (val : u8) = get_list()(usize(1));
  assert(val == u8(20), "index fn call result should be 20");
});
// Regression: struct literal in match arm whose field name contains "return"
// must be assigned to the function's return temporary, not emitted as a bare
// expression statement. The codegen previously misclassified the arm body as
// control-flow because `code.includes("return")` matched `return_flag`.
// See: issues/fixed/struct-literal-in-match-arm-not-assigned.md
test("match arm struct literal with `return` in field name", {
  ControlFlowFlags :: struct(
    return_flag : bool,
    unwind_flag : bool,
    break_flag : bool,
    continue_flag : bool
  );
  ControlFlowKind :: enum(Return, Escape, Break, Continue);
  control_flow_of :: (fn(kind : ControlFlowKind) -> ControlFlowFlags)(
    match(
      kind,
      .Return => ControlFlowFlags(return_flag : true, unwind_flag : false, break_flag : false, continue_flag : false),
      .Escape => ControlFlowFlags(return_flag : false, unwind_flag : true, break_flag : false, continue_flag : false),
      .Break => ControlFlowFlags(return_flag : false, unwind_flag : false, break_flag : true, continue_flag : false),
      .Continue => ControlFlowFlags(return_flag : false, unwind_flag : false, break_flag : false, continue_flag : true)
    )
  );
  cf := control_flow_of(ControlFlowKind.Return);
  assert(cf.return_flag, "Return arm must set return_flag = true");
  assert(!(cf.unwind_flag), "Return arm must leave unwind_flag = false");
  cf2 := control_flow_of(ControlFlowKind.Escape);
  assert(cf2.unwind_flag, "Escape arm must set unwind_flag = true");
  assert(!(cf2.return_flag), "Escape arm must leave return_flag = false");
});
// Regression: cond arm struct literal with `return` in field name (mirrors
// the match-arm fix in src/codegen/exprs/cond.ts).
test("cond arm struct literal with `return` in field name", {
  Flags :: struct(return_flag : bool, other_flag : bool);
  pick :: (fn(x : i32) -> Flags)(
    cond(
      (x == i32(1)) => Flags(return_flag : true, other_flag : false),
      (x == i32(2)) => Flags(return_flag : false, other_flag : true),
      true => Flags(return_flag : false, other_flag : false)
    )
  );
  f := pick(i32(1));
  assert(f.return_flag, "cond arm 1 must set return_flag = true");
  assert(!(f.other_flag), "cond arm 1 must leave other_flag = false");
});
