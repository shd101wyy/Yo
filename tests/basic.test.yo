test "Test comments", {
  /*
    This is a block comment
  */
  x :: 0;

  /*
  This is a nested block comment
  Outer comment
    
    /*
      Inner comment
    */

    Yes the block comments can be nested
  */
  y :: 1;

  /**
  * Define the operator precedence for the Yo language.  
  * 1 is the lowest precedence.  
  * Reference: https://rosettacode.org/wiki/Operator_precedence#Haskell
  */

  // This is a line comment
  // Another line comment
  // One more line comment
};

test "Test assignments", {
  {
    x := 1;
    y := (x = 2);

    assert(x == 2);
    assert(y == 1);
  };

  {
    x := box(1);
    y := (x = box(2));

    assert(x.* == 2);
    assert(y.* == 1);
  };

  {
    x := [1, 2, 3];
    y := (x = [2, 3, 4]);

    assert(x(0) == 2);
    assert(y(0) == 1);
  };

  {
    x : i32;
    
    // Initialize a variable defined outside the function body is not allowed
    test1 :: (fn() -> unit) {
      compt_expect_error(
        x = 12,
        "Cannot initialize a variable that is defined outside the function body."
      );
    
    };
    
    // Initialize a variable defined outside the while loop is not allowed
    test2 :: (fn(flag: bool) -> unit) {
      y : i32;
      while flag, {
        compt_expect_error(
          x = 12,
          "Cannot initialize a variable that is defined outside the while loop."
        );
        compt_expect_error(
          y = 12,
          "Cannot initialize a variable that is defined outside the while loop."
        );
        z : i32;
        z = 12;
      };
      y = 12;
    };
    
    x = 13;
  };
};

test "Test bindings", {
  {
    x : i32;
    y : i32;
    x = 1;
    y = 2;
    assert((x + y) == 3);
  };
  // Runtime immutable variable
  {
    x : i32;
    x = 12;
  };
  {
    (x : bool) = true;
  };

  // Runtime mutable variable
  {
    x : i32;
    x = 12;
  };
  {
    (x : bool) = true;
    x = false;
  };

  // Compile-time immutable variable
  {
    compt(x) : i32;
    x = 12;
  };
  {
    (compt(x) : bool) = true;
    // x = false;
  };

  // Compile-time mutable variable
  {
    compt(x) : i32;
    x = 12;
  };
  {
    (compt(x) : bool) = true;
    x = false;
  };

  // Runtime immutable variable
  {
    (x : i32) = 12;
    // x = 13; // error
  };

  // Runtime mutable variable
  {
    (x : i32) = 12;
    x = 13;
  };

  // Compile-time immutable variable
  {
    x :: 12;
    // x = 13; // error
  };

  {
    // Compile-time mutable variable
    x :: 12;
    x = 13;
  };

  {
    compt(x) : Type;
    x = struct(x: i32, y: i32);
  };
};

test "Test variable shadowing", {
  {
    (x : i32) = 12;
    compt_expect_error(
      x := 13 // Not allowed, because `x` already exists at the current frame.
    );
    assert(x == 12);

    {
      compt_expect_error(
        x := 15 // Not allowed, because `x` already exists at upper frame.
      );
    };
    assert(x == 12);
  };
};

test "Test compt", {
  compt_12 :: (fn() -> compt(i32))(
    12
  );

  Point :: struct(
    x : i32,
    y : i32
  );

  {
    x :: 13;
    y := x;
    z :: compt_12();
    assert((y + z) == 25);
  };

  {
    use_point :: (fn(p : Point) -> i32)
      (p.x + p.y)
    ;

    p :: Point(compt_12(), 16);
    assert(use_point(p) == 28);
  };
};

test "Test destructuring", {
  // tuple destructuring
  {
    t := (1, 3.4, true);
    (t2 : Tuple(a: i32, b: f64, c: bool)) = t;

    {
      // by index
      assert(t.0 == 1);
      assert(t.1 == 3.4);
      assert(t.2 == true);
    };

    {
      // by index
      assert(t2.0 == 1);
      assert(t2.1 == 3.4);
      assert(t2.2 == true);

      // by label
      assert(t2.a == 1);
      assert(t2.b == 3.4);
      assert(t2.c == true);
    };
    
    {
      // by order
      (x, y, z) := t;
      assert(x == 1);
      assert(y == 3.4);
      assert(z == true);
    };
    {
      // by order
      (c, b, a) := t2;
      assert(c == 1);
      assert(b == 3.4);
      assert(a == true);
    };
    {
      // by label
      (c : c, b : b, a : a) := t2;
      assert(a == 1);
      assert(b == 3.4);
      assert(c == true);
    };

    {
      // by label with different names
      (c : c1, b : b1, a : a1) := t2;
      assert(a1 == 1);
      assert(b1 == 3.4);
      assert(c1 == true);
    };
  };

  // struct destructuring
  {
    Point :: struct(x : i32, y : f64);
    point := Point(3, 4.5);
    {
      { x, y } := point;
      assert(x == 3);
      assert(y == 4.5);
    };
    {
      { y, x } := point;
      assert(x == 3);
      assert(y == 4.5);
    };
    {
      _(x : a, y : b) := point;
      assert(a == 3);
      assert(b == 4.5);
    };
    {
      { x : another_x } := point;
      assert(another_x == 3);
    };
    {
      { x : another_x, ... } := point;
      assert(another_x == 3);
      assert(y == 4.5);
    };
  };
};

test "Test type auto derive Send", {
  compt_assert(Type.impls(i32, Send));
  
  Point :: struct(x : i32, y : i32);
  compt_assert(Type.impls(Point, Send) == true);
  
  MyBox :: object(v : i32);
  compt_assert(Type.impls(MyBox, Send) == false);
  
  GenericPoint :: (fn(compt(T) : Type) -> compt(Type))
    struct(x : T, y : T)
  ;
  compt_assert(Type.impls(GenericPoint(i32), Send) == true);
  compt_assert(Type.impls(GenericPoint(MyBox), Send) == false);
};

test "Test 'struct'", {
  // Struct
  {
    Point :: struct(x: i32, y: i32);

    p := Point(3, 4); // Assign compt to runtime
    p2 :: Point(3, 4); // Assign compt to compt

    runt_value := 1;
    p3 := Point(runt_value, 4);

    compt_expect_error(
      p4 :: Point(runt_value, 4) // Assign runt to compt is not allowed
    );

    assert(p.x == 3);
    assert(p.y == 4);
    compt_assert(p2.x == 3);
    compt_assert(p2.y == 4);
    assert(p3.x == 1);
    assert(p3.y == 4);
  };
  {
    Point :: struct(x: i32, (y: i32) ?= 12);
    p4 :: Point(14);
    assert(p4.x == 14);
    assert(p4.y == 12);
  };
  // curly brackets
  {
    Point :: struct(x: i32, y: bool);

    p := Point(3, true);
    (p2: Point) = _(3, true);
    (p3: Point) = {x: 3, y: true};
    (p4: Point) = {y: true, x: 3};

    x := 1;
    y := true;
    (p5: Point) = {x, y}; 
    (p6: Point) = {y, x};
    
    {
      { x : another_x, y: a } := p;
      a;
    };

    {
      { x: a, y: b } := p;
      a;
      b;
    };
  };

  // nomimal type
  {
    Point1 :: struct(x : i32, y : i32);
    Point2 :: struct(x : i32, y : i32);

    x := Point1(3, 4);
    (y : Point2) = _(5, 6);

    compt_expect_error(
      (z : Point1) := (3, 4),
      "error: type Mismatch"
    );

    Point3 :: Point1;

    (z : Point2) = y;
    (z2 : Point3) = x;
    compt_expect_error(
      (z3 : Point2) = x,
      "error: type Mismatch"
    );

    assert(x.x == 3);
    assert(x.y == 4);

    assert(y.x == 5);
    assert(y.y == 6);

    assert(z.x == 5);
    assert(z.y == 6);

    assert(z2.x == 3);
    assert(z2.y == 4);
  };

  // anonymous struct
  {
    p := (struct(x: i32, y: i32))(3, 4);
    (p2: struct(x: i32, y: i32)) = _(3, 4);

    assert(p.x == 3);
    assert(p.y == 4);
    assert(p2.x == 3);
    assert(p2.y == 4);
  };

  // struct default field values
  {
    Point :: struct
      (x: i32) ?= 0,
      (y: i32) ?= 0
    ;

    p := Point(y: 1, x: 2);
    p2 := Point();
    p3 := Point(13);
    p4 := Point(x: 2);
    p5 := Point(y: 3);

    assert(p.x == 2);
    assert(p.y == 1);

    assert(p2.x == 0);
    assert(p2.y == 0);

    assert(p3.x == 13);
    assert(p3.y == 0);

    assert(p4.x == 2);
    assert(p4.y == 0);

    assert(p5.x == 0);
    assert(p5.y == 3);
  };

  // struct in tuple
  {
    { 
      SomeStruct :: struct(x: i32, y: bool);
      Complex :: Tuple(s: SomeStruct);

      x := SomeStruct(1, true);
      (y: SomeStruct) = _(1, false);

      (c: Complex) = (_(3, true),);

      assert(x.x == 1);
      assert(x.y == true);
      assert(y.x == 1);
      assert(y.y == false);
      assert(c.0.x == 3);
      assert(c.0.y == true);
    };

    {
      Complex :: struct(x: Tuple(i32, bool), y: i32);
      (c: Complex) = _((3, true), 4);
      assert(c.x.0 == 3);
      assert(c.x.1 == true);
      assert(c.y == 4);        
    };

    {
      SomeStruct :: struct(x: i32, y: bool);
      Complex0 :: Tuple(SomeStruct);
      Complex :: Tuple(Complex0);

      (c: SomeStruct) = _(3, false);
      (c2: Complex0) = (_(3, true),);
      (c3: Complex) = ((_(3, true),),);
      (c4: Complex) = ((_(y: true, x: 1),),);

      assert(c.x == 3);
      assert(c.y == false);

      assert(c2.0.x == 3);
      assert(c2.0.y == true);

      assert(c3.0.0.x == 3);
      assert(c3.0.0.y == true);

      assert(c4.0.0.x == 1);
      assert(c4.0.0.y == true);
    };
  };

  // type methods
  {
    Withdraw :: struct(
      balance: i32,

      withdraw :: (fn(self: *(Self), amount: i32) -> i32)(
        cond(
          (self.balance >= amount) => {
            self.balance = (self.balance - amount);
            return self.balance;
          }, 
          true => {
            return 0; // insufficient balance
          }
        )
      )
    );

    make_widthdraw_balance_100 :: (fn() -> Withdraw) {
      (balance : i32) = 100;
      return { balance };
    };

    bank := make_widthdraw_balance_100();
    left := bank.withdraw(50);
    left2 := bank.withdraw(30);
    left3 := bank.withdraw(40);

    assert(left == 50);
    assert(left2 == 20);
    assert(left3 == 0);
  };
};

test "Test 'enum'", {
  {
    Color :: enum(Red, Green, Blue);
    (r : Color) = Color.Red;
    r2 := Color.Blue;

    Shape :: enum(
      Circle(r: i32),
      Rectangle(w: i32, h: i32)
    );
    (c : Shape) = Shape.Circle(5);
    c2 := Shape.Rectangle(h: 1, w: 2);
  };

  // Anonymous enum
  {
    color := (enum(Red, Green, Blue)).Red;
    (color2 : enum(Red, Green, Blue)) = .Blue;

    shape := (enum(
      Circle(r: i32),
      Rectangle(w: i32, h: i32)
    )).Circle(5);
    (shape2 : enum(
      Circle(r: i32),
      Rectangle(w: i32, h: i32)
    )) = .Rectangle(h: 1, w: 2);
  };

  // Type methods
  {
    Shape :: enum(
      Circle(radius: i32),
      Rectangle(width: i32, height: i32),
      Triangle(base: i32, height: i32),

      new_circle :: (
        (fn(radius: i32) -> Self)
          .Circle(radius)
      ),
      id :: ((fn(self: Self)-> Self)
        self
      )
    );

    // c := Shape.new_circle(5);
    // c2 := c.id();
    // c2.radius = 10;

    // assert(c.radius == 5);
    // assert(c2.radius == 10);
  };

  // Nested enum
  {
    NestedEnum :: enum
      Level1(
        x: enum Level2(value: i32)
      );

    n := NestedEnum.Level1(.Level2(3));
    (n2 : NestedEnum) = .Level1(.Level2(3));
  };

  // Discriminant values
  {
    Color :: enum(
      Red, // implicitly 0
      Green = 6,
      Blue = 9
    );

    Shape :: enum(
      Circle(radius : i32) = 2,
      Square(side : i32) = 4,
      Triangle(base : i32, height : i32) // implicitly 5
    );

    red := i32(Color.Red);
    assert(red == i32(0));
    green := i32(Color.Green);
    assert(green == i32(6));
    blue := i32(Color.Blue);
    assert(blue == i32(9));

    circle := i32(Shape.Circle(10));
    assert(circle == i32(2));
    square := i32(Shape.Square(5));
    assert(square == i32(4));
    triangle := i32(Shape.Triangle(3, 4));
    assert(triangle == i32(5));

    expect_triangle :: (fn(shape : Shape) -> unit) {
      assert(i32(shape) == i32(5));
    };
    expect_triangle(Shape.Triangle(5, 6));
  };
};

test "Test 'union'", {
  SomeUnion :: union
    x : i32,
    y : bool,

    new :: ((fn()-> Self) Self(x : 0)) 
  ;

  v1 := SomeUnion( x : 12 );
  v2 := SomeUnion( y : true );
  v3 := SomeUnion.new();

  {
    a := v1.x;
    assert(a == 12);

    b := v2.y;
    assert(b == true);

    c := v3.x;
    assert(c == 0);
  };

  {
    { x } := v1;
    assert(x == 12);
    { y : z } := v1; // unsafe access
  };
};

test "Test tuple", {
  {
    x :: 12;
    t :: (x,);

    runt_x := 16;
    compt_expect_error(t2 :: (x, runt_x)); // Expected error

    t3 := (x, runt_x);

    compt_assert(t.0 == 12);
    assert(t3.0 == 12);
    assert(t3.1 == 16);
  };
};

