// Move-only values (plans/VALUES_BY_DEFAULT.md §3.4, phase V3, Generation A).
//
// A value type that implements `Drop`, a plain value type that is neither
// `Copy` nor `Clone` (decision 36), and every value aggregate holding one,
// cannot be copied: each move point (`:=`, `=`,
// a `sink` argument, a field or element store, a return, a closure capture)
// moves it, a use after the move is E0901, and its one owner disposes it
// exactly once. `g_mo_disposed` counts the `dispose` runs of `_MoFd` and
// `_MoLate`, and `g_mo_sum` adds up the disposed `_MoFd`s' `n`.
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ yield } :: import("std/async");
{ VList } :: import("./fixtures/owned_buffer.yo");
{ RefCell } :: import("std/sync/refcell");
(mut(g_mo_disposed) : i32) = i32(0);
(mut(g_mo_sum) : i32) = i32(0);
_MoFd :: struct(n : i32);
impl(
  _MoFd,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_mo_disposed = (g_mo_disposed + i32(1));
      g_mo_sum = (g_mo_sum + self.n);
    })
  )
);
_MoHolder :: struct(fd : _MoFd, tag : i32);
// Neither `Copy` nor `Clone`: a token that stays unique without a `Drop`.
_MoToken :: struct(id : i32);
_MoChoice :: enum(Open(fd : _MoFd), Closed);
_MoRef :: ref(struct(fd : _MoFd));
_mo_take :: (fn(sink(f) : _MoFd) -> i32)(f.n);
_mo_peek :: (fn(f : &_MoFd) -> i32)(f.n);
_mo_make :: (fn(n : i32) -> _MoFd)({
  x := _MoFd(n : n);
  x
});
_mo_wrap :: (fn(sink(f) : _MoFd) -> _MoHolder)(_MoHolder(fd : f, tag : i32(0)));
_mo_early :: (fn(c : bool) -> i32)({
  a := _MoFd(n : i32(10));
  if(c, {
    return(_mo_take(a));
  });
  i32(0)
});
_mo_both_arms :: (fn(c : bool) -> i32)({
  a := _MoFd(n : i32(20));
  cond(c => _mo_take(a), true => _mo_take(a))
});
// The impl of a move-only type may come after its first use: move-only is
// derived on demand, not when the type is declared.
_mo_late_user :: (fn() -> i32)({
  a := _MoLate(n : i32(5));
  b := a;
  b.n
});
_MoLate :: struct(n : i32);
impl(
  _MoLate,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_mo_disposed = (g_mo_disposed + i32(1));
    })
  )
);
// A `sink(x)` parameter is the same function type as a plain `x` (the move
// is decided at the caller); `own(x)`, its old spelling, is deleted.
_mo_take_old :: (fn(sink(f) : _MoFd) -> i32)(f.n);
_mo_dup_generic :: (fn(generic(T : Type), x : &T) -> T)(x);
_mo_move_generic :: (fn(generic(T : Type), sink(x) : T) -> T)(x);
// ---------------------------------------------------------------------------
// The marker
// ---------------------------------------------------------------------------
test("move-only: Drop makes a value type move-only, and value aggregates inherit it", {
  // Move-only is "neither Copy nor Clone" for a value type (decision 36).
  comptime_assert(!Type.impls(_MoFd, Copy) && !Type.impls(_MoFd, Clone), "a Drop value type is move-only");
  comptime_assert(!Type.impls(_MoToken, Copy) && !Type.impls(_MoToken, Clone), "a plain type with neither is move-only");
  comptime_assert(!Type.impls(_MoHolder, Copy) && !Type.impls(_MoHolder, Clone), "a struct holding one is move-only");
  comptime_assert(!Type.impls(Option(_MoFd), Copy) && !Type.impls(Option(_MoFd), Clone), "an Option of one is move-only");
  comptime_assert(!Type.impls(Tuple(_MoFd, i32), Copy) && !Type.impls(Tuple(_MoFd, i32), Clone), "a tuple holding one is move-only");
  comptime_assert(!Type.impls(_MoChoice, Copy) && !Type.impls(_MoChoice, Clone), "an enum carrying one is move-only");
  comptime_assert(!Type.impls(Array(_MoFd, 2), Copy) && !Type.impls(Array(_MoFd, 2), Clone), "an array of them is move-only");
  comptime_assert(Type.impls(i32, Copy), "i32 is copyable");
  comptime_assert(Type.contains_rc_type(_MoFd), "a move-only value has a drop to run");
  // A reference type shares its payload: its copy is another handle, never a move.
  r := _MoRef(fd : _MoFd(n : i32(4)));
  r2 := r;
  assert((r.fd.n + r2.fd.n) == i32(8), "both handles stay usable");
});
test("move-only: the impl-site gate", {
  comptime_expect_error(impl(i32, Drop(drop : (fn(self : &mut Self) -> unit)(()))), "cannot implement \"Drop\"");
  comptime_expect_error(impl(_MoToken, Trace(trace : (fn(self : Self, tracer : GcTracer) -> unit)(()))), "cannot implement \"Trace\"");
});
// ---------------------------------------------------------------------------
// Every move point moves, and the one owner disposes once
// ---------------------------------------------------------------------------
test("move-only: `:=` moves, and the new owner disposes once", {
  before := g_mo_disposed;
  {
    a := _MoFd(n : i32(1));
    b := a;
    assert(b.n == i32(1), "b holds the value");
    comptime_expect_error(a.n, "use of moved value");
  };
  assert(g_mo_disposed == (before + i32(1)), "one dispose");
});
test("move-only: a by-value parameter borrows, a `sink` parameter moves", {
  before := g_mo_disposed;
  {
    a := _MoFd(n : i32(2));
    assert(_mo_peek(&a) == i32(2), "borrowed");
    assert(_mo_peek(&a) == i32(2), "still usable after a borrow");
    assert(_mo_take(a) == i32(2), "moved in");
    assert(g_mo_disposed == (before + i32(1)), "the callee disposed it");
    comptime_expect_error(_mo_take(a), "use of moved value");
  };
  assert(g_mo_disposed == (before + i32(1)), "disposed once");
});
test("move-only: `=` moves the right side, and the old value is disposed once", {
  before := g_mo_disposed;
  before_sum := g_mo_sum;
  {
    (mut(x) : _MoFd) = _MoFd(n : i32(3));
    y := _MoFd(n : i32(4));
    x = y;
    assert(x.n == i32(4), "x holds the new value");
    comptime_expect_error(y.n, "use of moved value");
  };
  assert(g_mo_disposed == (before + i32(2)), "old and new each disposed once");
  assert(g_mo_sum == (before_sum + i32(7)), "3 and 4");
});
test("move-only: a field store and a constructor argument move", {
  before := g_mo_disposed;
  before_sum := g_mo_sum;
  {
    a := _MoFd(n : i32(5));
    mut(h) := _MoHolder(fd : a, tag : i32(1));
    comptime_expect_error(a.n, "use of moved value");
    b := _MoFd(n : i32(6));
    h.fd = b;
    comptime_expect_error(b.n, "use of moved value");
    assert(h.fd.n == i32(6), "the field holds the stored value");
  };
  assert(g_mo_disposed == (before + i32(2)), "each disposed once");
  assert(g_mo_sum == (before_sum + i32(11)), "5 and 6");
});
test("move-only: Option, tuple, enum and array elements move in and dispose once", {
  before := g_mo_disposed;
  before_sum := g_mo_sum;
  {
    a := _MoFd(n : i32(1));
    o := Option(_MoFd).Some(a);
    b := _MoFd(n : i32(2));
    t := (b, i32(0));
    c := _MoFd(n : i32(3));
    e := _MoChoice.Open(c);
    d := _MoFd(n : i32(4));
    arr := Array(_MoFd, 2)(d, _MoFd(n : i32(5)));
    comptime_expect_error(d.n, "use of moved value");
    assert(t.1 == i32(0), "tuple built");
  };
  assert(g_mo_disposed == (before + i32(5)), "five disposals");
  assert(g_mo_sum == (before_sum + i32(15)), "1 to 5");
});
test("move-only: a return moves the value out, an early return disposes once", {
  before := g_mo_disposed;
  before_sum := g_mo_sum;
  {
    f := _mo_make(i32(7));
    h := _mo_wrap(f);
    assert(h.fd.n == i32(7), "moved through sink and a constructor");
    assert(_mo_early(true) == i32(10), "the returning path moved it");
    assert(_mo_early(false) == i32(0), "the other path drops it");
    assert(_mo_both_arms(true) == i32(20), "moved in one arm");
    assert(_mo_both_arms(false) == i32(20), "moved in the other arm");
  };
  assert(g_mo_disposed == (before + i32(5)), "each value disposed once");
  assert(g_mo_sum == (before_sum + i32(67)), "7 + 10 + 10 + 20 + 20");
});
_mo_one_arm :: (fn(c : bool, keep : &mut ArrayList(_MoFd)) -> i32)({
  a := _MoFd(n : i32(30));
  cond(c => keep.push(a), true => ());
  i32(1)
});
_mo_one_arm_reads :: (fn(c : bool, keep : &mut ArrayList(_MoFd)) -> i32)({
  a := _MoFd(n : i32(40));
  cond(
    c => {
      keep.push(a);
      i32(0)
    },
    true => a.n
  )
});
_mo_one_match_arm :: (fn(k : i32, keep : &mut ArrayList(_MoFd)) -> unit)({
  a := _MoFd(n : i32(50));
  match(
    k,
    0 => keep.push(a),
    1 => (),
    _ => ()
  );
});
test("move-only: a value moved in one arm is dropped at the end of the others", {
  before := g_mo_disposed;
  before_sum := g_mo_sum;
  mut(keep) := ArrayList(_MoFd).new();
  assert(_mo_one_arm(true, &mut keep) == i32(1), "moved into the list");
  assert(g_mo_disposed == before, "the list owns it: not disposed");
  assert(_mo_one_arm(false, &mut keep) == i32(1), "kept");
  assert(g_mo_disposed == (before + i32(1)), "the arm that kept it dropped it once");
  assert(_mo_one_arm_reads(false, &mut keep) == i32(40), "read in the keeping arm, then dropped");
  assert(g_mo_disposed == (before + i32(2)), "dropped after the arm's value");
  assert(_mo_one_arm_reads(true, &mut keep) == i32(0), "moved");
  _mo_one_match_arm(i32(0), &mut keep);
  _mo_one_match_arm(i32(1), &mut keep);
  _mo_one_match_arm(i32(7), &mut keep);
  assert(g_mo_disposed == (before + i32(4)), "each match arm that kept it dropped it once");
  assert(keep.len() == usize(3), "three moved into the list");
  assert(g_mo_sum == (before_sum + i32(170)), "30 + 40 + 50 + 50");
});
_mo_all_move_or_return :: (fn(k : i32) -> i32)({
  a := _MoFd(n : i32(60));
  cond(
    (k == i32(0)) => _mo_take(a),
    (k == i32(1)) => {
      return(i32(77));
    },
    true => _mo_take(a)
  )
});
_mo_some_move_or_return :: (fn(k : i32) -> i32)({
  a := _MoFd(n : i32(70));
  cond(
    (k == i32(0)) => _mo_take(a),
    (k == i32(1)) => {
      return(i32(77));
    },
    true => i32(0)
  )
});
test("move-only: a returning arm beside arms that move a value drops it at the return", {
  before := g_mo_disposed;
  assert(_mo_all_move_or_return(i32(0)) == i32(60), "moved");
  assert(_mo_all_move_or_return(i32(1)) == i32(77), "returned");
  assert(_mo_all_move_or_return(i32(2)) == i32(60), "moved");
  assert(g_mo_disposed == (before + i32(3)), "every path disposed it once, the returning one included");
  assert(_mo_some_move_or_return(i32(0)) == i32(70), "moved");
  assert(_mo_some_move_or_return(i32(1)) == i32(77), "returned");
  assert(_mo_some_move_or_return(i32(2)) == i32(0), "kept, then dropped at the arm's end");
  assert(g_mo_disposed == (before + i32(6)), "and again for a move in some arms");
});
_MoPair :: struct(fd : _MoFd, tag : i32);
test("move-only: an assignment statement drops the old value at the assignment", {
  before := g_mo_disposed;
  (mut(x) : _MoFd) = _MoFd(n : i32(1));
  x = _MoFd(n : i32(2));
  assert(g_mo_disposed == (before + i32(1)), "the variable's old value is gone at once");
  mut(h) := _MoPair(fd : _MoFd(n : i32(3)), tag : i32(0));
  h.fd = _MoFd(n : i32(4));
  assert(g_mo_disposed == (before + i32(2)), "a field store's too");
  mut(xs) := ArrayList(_MoFd).new();
  xs.push(_MoFd(n : i32(5)));
  xs(usize(0)) = _MoFd(n : i32(6));
  assert(g_mo_disposed == (before + i32(3)), "an index store's too");
  old := (x = _MoFd(n : i32(7)));
  assert((g_mo_disposed == (before + i32(3))) && (old.n == i32(2)), "a used result keeps it");
});
test("move-only: a closure capture moves the value, and the closure disposes it", {
  before := g_mo_disposed;
  {
    a := _MoFd(n : i32(8));
    (f : Impl(Fn() -> i32)) = (() => a.n);
    assert(f() == i32(8), "the closure owns the value");
    comptime_expect_error(a.n, "use of moved value");
  };
  assert(g_mo_disposed == (before + i32(1)), "the closure disposes once");
});
_mo_with :: (fn(f : &Impl(Fn() -> i32)) -> i32)(f());
_mo_with_sink :: (fn(sink(f) : Impl(Fn() -> i32)) -> i32)(f());
test("move-only: a closure passed straight to a borrowing parameter borrows its captures", {
  before := g_mo_disposed;
  {
    a := _MoFd(n : i32(11));
    assert(_mo_with(() => a.n) == i32(11), "the closure reads the borrowed value");
    assert(_mo_with(() => (a.n + i32(1))) == i32(12), "and again: nothing moved");
    assert(a.n == i32(11), "a is still usable after the call");
    assert(g_mo_disposed == before, "the borrowing closure disposes nothing");
  };
  assert(g_mo_disposed == (before + i32(1)), "the owner disposes once");
});
test("move-only: a closure passed to a sink parameter escapes and moves its captures", {
  before := g_mo_disposed;
  {
    a := _MoFd(n : i32(12));
    assert(_mo_with_sink(() => a.n) == i32(12), "the escaping closure owns the value");
    comptime_expect_error(a.n, "use of moved value");
  };
  assert(g_mo_disposed == (before + i32(1)), "disposed once, with the closure");
});
test("move-only: an impl declared after its first use", {
  before := g_mo_disposed;
  assert(_mo_late_user() == i32(5), "moved");
  assert(g_mo_disposed == (before + i32(1)), "disposed once");
});
test("move-only: a generic `sink` parameter moves at the instantiation", {
  before := g_mo_disposed;
  {
    a := _MoFd(n : i32(9));
    b := _mo_move_generic(a);
    comptime_expect_error(a.n, "use of moved value");
    assert(b.n == i32(9), "moved through the generic");
  };
  assert(g_mo_disposed == (before + i32(1)), "disposed once");
});
// ---------------------------------------------------------------------------
// Rejected copies
// ---------------------------------------------------------------------------
test("move-only: a borrow cannot be copied or moved out", {
  a := _MoFd(n : i32(1));
  comptime_expect_error((fn(f : &_MoFd) -> _MoFd)(f), "it is borrowed");
  comptime_expect_error(
    (fn(f : &_MoFd) -> i32)({
      g := f;
      g.n
    }),
    "it is borrowed"
  );
  comptime_expect_error((fn(f : &mut _MoFd) -> i32)(_mo_take(f)), "it is a `&mut` borrow");
  comptime_expect_error(
    (fn(f : &_MoFd) -> i32)({
      (k : Impl(Fn() -> i32)) = (() => f.n);
      k()
    }),
    "the closure captures `f`"
  );
  o := Option(_MoFd).Some(_MoFd(n : i32(2)));
  comptime_expect_error(match(&o, .Some(f) => _mo_take(f), .None => i32(0)), "it is borrowed");
  assert(_mo_peek(&a) == i32(1), "a is untouched");
});
test("move-only: no partial moves out of a field", {
  h := _MoHolder(fd : _MoFd(n : i32(1)), tag : i32(2));
  comptime_expect_error({
    f := h.fd;
    f.n
  }, "no partial moves");
  comptime_expect_error(_mo_take(h.fd), "no partial moves");
  assert(_mo_peek(&h.fd) == i32(1), "a field can still be borrowed");
});
test("move-only: a generic body that copies is rejected at the instantiation", {
  a := _MoFd(n : i32(1));
  comptime_expect_error(_mo_dup_generic(&a), "whose type `_MoFd` is move-only");
  xs := ArrayList(_MoFd).new();
  comptime_expect_error(xs.get(usize(0)), "a dereference copies, it never moves");
  assert(xs.len() == usize(0), "empty");
});
test("move-only: a loop moves on every way out or none", {
  a := _MoFd(n : i32(1));
  b := _MoFd(n : i32(2));
  comptime_expect_error({
    mut(i) := i32(0);
    while(i < i32(2), {
      _mo_take(b);
      i = (i + i32(1));
    });
  }, "is moved inside the loop");
  assert(_mo_peek(&a) == i32(1), "a stays");
});
test("move-only: the E0901 note names why the type is move-only", {
  h := _MoHolder(fd : _MoFd(n : i32(1)), tag : i32(2));
  g := h;
  comptime_expect_error(h.tag, "holds a move-only value in its field `fd`");
  t := _MoToken(id : i32(3));
  u := t;
  comptime_expect_error(t.id, "neither `Copy` nor `Clone`");
  // Since the flip a by-value parameter owns its argument; the note names the
  // borrowing mode.
  comptime_expect_error(h.tag, "A `&T` parameter borrows it without a copy (the call lends it with `&h`)");
  assert((g.tag + u.id) == i32(5), "moved values");
});
test("move-only: `sink` and plain spell one function type, and `sink` moves", {
  comptime_assert(Type.is_compatible_with((fn(sink(f) : _MoFd) -> i32), (fn(f : _MoFd) -> i32)), "sink and plain are one parameter mode");
  comptime_assert(Type.is_compatible_with((fn(f : _MoFd) -> i32), (fn(sink(f) : _MoFd) -> i32)), "both directions");
  comptime_assert(!Type.is_compatible_with((fn(sink(f) : _MoFd) -> i32), (fn(f : &_MoFd) -> i32)), "sink is not a borrow");
  before := g_mo_disposed;
  {
    a := _MoFd(n : i32(3));
    assert(_mo_take_old(a) == i32(3), "sink moves");
    comptime_expect_error(a.n, "use of moved value");
  };
  assert(g_mo_disposed == (before + i32(1)), "disposed once, by the callee");
});
// ---------------------------------------------------------------------------
// The consuming match (plans/VALUES_BY_DEFAULT.md decision 26): a `match`
// takes an owned scrutinee by value. The selected arm's bindings own their
// parts, the parts it leaves unbound are dropped when the arm is entered,
// guards see the bindings as borrows, and below a reference cell the
// bindings borrow while the handle lives to the arm's end. `match(&x, …)`
// borrows and keeps `x`.
// ---------------------------------------------------------------------------
_MoTwo :: enum(Two(a : _MoFd, b : _MoFd), One(a : _MoFd), Zero);
_mo_two :: (fn(k : i32) -> _MoTwo)(
  cond(
    (k == i32(0)) => _MoTwo.Zero,
    (k == i32(1)) => _MoTwo.One(a : _MoFd(n : i32(1))),
    true => _MoTwo.Two(a : _MoFd(n : i32(2)), b : _MoFd(n : i32(3)))
  )
);
_mo_some :: (fn(n : i32) -> Option(_MoFd))(.Some(_MoFd(n : n)));
_mo_peek_opt :: (fn(o : &Option(_MoFd)) -> i32)(
  match(
    o,
    .Some(f) => f.n,
    .None => i32(-1)
  )
);
// An owned binding the arm returns before it moves it is dropped at the
// `return`, once.
_mo_match_early :: (fn(c : bool) -> i32)({
  o := _mo_some(i32(11));
  match(
    o,
    .Some(f) => {
      if(c, {
        return(i32(-11));
      });
      _mo_take(f)
    },
    .None => i32(0)
  )
});
// A consuming match in a loop body: an arm moves its binding and continues,
// returns it to the keeper, or breaks while still owning it.
_mo_match_in_loop :: (fn(keep : &mut ArrayList(_MoFd)) -> i32)({
  (mut(i) : i32) = i32(0);
  (mut(total) : i32) = i32(0);
  while(i < i32(5), {
    o := _mo_some(i);
    match(
      o,
      .Some(f) => {
        if(f.n == i32(1), {
          keep.push(f);
          i = (i + i32(1));
          continue;
        });
        if(f.n == i32(3), {
          break;
        });
        total = (total + f.n);
      },
      .None => ()
    );
    i = (i + i32(1));
  });
  total
});
// The same loop over a plain local: the value moved before `continue` is the
// keeper's (issues/fixed/a-value-moved-before-a-continue-or-break-is-dropped-again-at-the-exit.md).
_mo_local_in_loop :: (fn(keep : &mut ArrayList(_MoFd)) -> i32)({
  (mut(i) : i32) = i32(0);
  (mut(total) : i32) = i32(0);
  while(i < i32(5), {
    f := _MoFd(n : i);
    if(f.n == i32(1), {
      keep.push(f);
      i = (i + i32(1));
      continue;
    });
    if(f.n == i32(3), {
      break;
    });
    total = (total + f.n);
    i = (i + i32(1));
  });
  total
});
_MoCell :: enum(Cell(fd : _MoFd, shared : Rc(_MoFd)), Empty);
test("consuming match: an owned local's payload moves into the arm", {
  before := g_mo_disposed;
  {
    o := _mo_some(i32(5));
    r := match(
      o,
      .Some(f) => _mo_take(f),
      .None => i32(0)
    );
    assert(r == i32(5), "the arm moved the payload out");
    assert(g_mo_disposed == (before + i32(1)), "disposed once, by the callee");
    comptime_expect_error(o, "match(&o, …)");
  };
  assert(g_mo_disposed == (before + i32(1)), "the consumed local is not dropped again at its scope end");
});
test("consuming match: the parts an arm does not bind are dropped when it is entered", {
  before := g_mo_disposed;
  before_sum := g_mo_sum;
  mut(keep) := ArrayList(_MoFd).new();
  {
    p := _mo_two(i32(2));
    match(
      p,
      .Two(a, _) => {
        assert(g_mo_disposed == (before + i32(1)), "b was dropped when the arm was entered");
        assert(g_mo_sum == (before_sum + i32(3)), "the dropped part is b");
        keep.push(a);
      },
      .One(a) => keep.push(a),
      .Zero => ()
    );
  };
  assert(g_mo_disposed == (before + i32(1)), "a lives on in the keeper, b was dropped once");
  assert(keep.len() == usize(1), "a was moved into the keeper");
  keep.clear();
  assert(g_mo_disposed == (before + i32(2)), "a is disposed once, by its new owner");
  assert(g_mo_sum == (before_sum + i32(5)), "2 + 3, each once");
});
test("consuming match: a wildcard arm drops the whole scrutinee once", {
  before := g_mo_disposed;
  {
    p := _mo_two(i32(2));
    r := match(
      p,
      .Zero => i32(0),
      _ => {
        assert(g_mo_disposed == (before + i32(2)), "both parts dropped when the arm was entered");
        i32(1)
      }
    );
    assert(r == i32(1), "the wildcard arm ran");
  };
  assert(g_mo_disposed == (before + i32(2)), "nothing dropped twice");
});
test("consuming match: a binding the arm still owns is dropped at the arm's end", {
  before := g_mo_disposed;
  {
    o := _mo_some(i32(7));
    match(
      o,
      .Some(f) => {
        assert(f.n == i32(7), "read");
        assert(g_mo_disposed == before, "still owned inside the arm");
      },
      .None => ()
    );
    assert(g_mo_disposed == (before + i32(1)), "dropped at the arm's end");
  };
  assert(g_mo_disposed == (before + i32(1)), "once");
});
test("consuming match: a temporary scrutinee is consumed", {
  before := g_mo_disposed;
  {
    f := match(
      _mo_some(i32(9)),
      .Some(x) => x,
      .None => _MoFd(n : i32(0))
    );
    assert(f.n == i32(9), "the arm's binding moved out as the result");
    assert(g_mo_disposed == before, "not dropped by the match");
  };
  assert(g_mo_disposed == (before + i32(1)), "disposed once, by the local that owns it");
});
test("consuming match: a `return` inside an arm drops the owned binding once", {
  before := g_mo_disposed;
  assert(_mo_match_early(true) == i32(-11), "returned early");
  assert(g_mo_disposed == (before + i32(1)), "the binding was dropped at the return");
  assert(_mo_match_early(false) == i32(11), "moved");
  assert(g_mo_disposed == (before + i32(2)), "the callee dropped it");
});
test("move-only: a value moved before a `continue` is not dropped again at the exit", {
  before := g_mo_disposed;
  mut(keep) := ArrayList(_MoFd).new();
  assert(_mo_local_in_loop(&mut keep) == i32(2), "0 + 2 before the break at 3");
  assert(g_mo_disposed == (before + i32(3)), "0 and 2 at the iteration's end, 3 at the break; 1 is the keeper's");
  keep.clear();
  assert(g_mo_disposed == (before + i32(4)), "1 by the keeper");
});
test("consuming match: in a loop, `continue` after a move and `break` while owning drop each value once", {
  before := g_mo_disposed;
  mut(keep) := ArrayList(_MoFd).new();
  assert(_mo_match_in_loop(&mut keep) == i32(2), "0 + 2 added before the break at 3");
  assert(keep.len() == usize(1), "1 was moved into the keeper");
  assert(g_mo_disposed == (before + i32(3)), "0 and 2 at the arm's end, 3 at the break");
  keep.clear();
  assert(g_mo_disposed == (before + i32(4)), "1 by the keeper");
});
test("consuming match: a guard sees the bindings as borrows; the move happens on selection", {
  before := g_mo_disposed;
  {
    o := _mo_some(i32(3));
    r := match(
      o,
      (.Some(f) && (f.n > i32(5))) => (_mo_take(f) + i32(100)),
      .Some(f) => _mo_take(f),
      .None => i32(0)
    );
    assert(r == i32(3), "the guard failed and the next arm took the payload");
    assert(g_mo_disposed == (before + i32(1)), "disposed once");
  };
  o2 := _mo_some(i32(4));
  comptime_expect_error(
    match(
      o2,
      (.Some(f) && (_mo_take(f) > i32(0))) => i32(1),
      _ => i32(0)
    ),
    "it is borrowed"
  );
});
test("consuming match: `match(&x, …)` borrows and keeps `x`", {
  before := g_mo_disposed;
  {
    mut(o) := _mo_some(i32(6));
    r := match(
      &o,
      .Some(f) => f.n,
      .None => i32(0)
    );
    assert(r == i32(6), "read through the borrow");
    assert(_mo_peek_opt(&o) == i32(6), "o is still usable");
    comptime_expect_error(
      match(
        &o,
        .Some(f) => _mo_take(f),
        .None => i32(0)
      ),
      "it is borrowed"
    );
    assert(g_mo_disposed == before, "nothing moved");
    comptime_expect_error(
      match(
        &o,
        .Some(f) => {
          o = .None;
          f.n
        },
        .None => i32(0)
      ),
      "borrows `o` with `&` and is still live"
    );
  };
  assert(g_mo_disposed == (before + i32(1)), "o is dropped once at its scope end");
});
test("consuming match: an `imm` binding scrutinee is matched through its borrow", {
  before := g_mo_disposed;
  {
    o := _mo_some(i32(8));
    assert(_mo_peek_opt(&o) == i32(8), "an imm parameter's match borrows");
    assert(_mo_peek_opt(&o) == i32(8), "twice");
  };
  assert(g_mo_disposed == (before + i32(1)), "once");
});
test("consuming match: what a match cannot move is E0901 naming the borrow", {
  h := _MoHolder(fd : _MoFd(n : i32(1)), tag : i32(2));
  comptime_expect_error(
    match(
      h.fd,
      _ => i32(0)
    ),
    "match(&h.fd, …)"
  );
  o := _mo_some(i32(2));
  comptime_expect_error(
    match(
      o,
      (w := .Some(f)) => i32(0),
      .None => i32(1)
    ),
    "is not `Copy`"
  );
  p := _mo_two(i32(1));
  comptime_expect_error(
    match(
      p,
      (.Two(a, _) | .One(a)) => _mo_take(a),
      .Zero => i32(0)
    ),
    "leaves a part with a drop unbound"
  );
  assert(
    match(
      &h.fd,
      f => f.n
    ) == i32(1),
    "a projection is matched through a borrow"
  );
});
test("consuming match: a match on an outer local inside a loop is a move per iteration", {
  o := _mo_some(i32(1));
  comptime_expect_error({
    mut(i) := i32(0);
    while(i < i32(2), {
      match(
        o,
        .Some(f) => _mo_peek(&f),
        .None => i32(0)
      );
      i = (i + i32(1));
    });
  }, "match(&o, …)");
  o2 := _mo_some(i32(2));
  {
    mut(i) := i32(0);
    while(i < i32(2), {
      match(
        &o2,
        .Some(f) => _mo_peek(&f),
        .None => i32(0)
      );
      i = (i + i32(1));
    });
  };
  assert(_mo_peek_opt(&o2) == i32(2), "a borrowing match in the loop keeps o2");
});
test("consuming match: below a reference cell the bindings borrow and the handle lives to the arm's end", {
  before := g_mo_disposed;
  {
    c := _MoCell.Cell(fd : _MoFd(n : i32(1)), shared : rc(_MoFd(n : i32(2))));
    r := match(
      c,
      .Cell(f, Rc(_MoFd(n : k))) => {
        assert(g_mo_disposed == before, "the cell's payload is alive inside the arm");
        _mo_take(f) + k
      },
      .Empty => i32(0)
    );
    assert(r == i32(3), "f moved, k read through the cell");
    assert(g_mo_disposed == (before + i32(2)), "f by the callee, the cell when the arm ended");
  };
  assert(g_mo_disposed == (before + i32(2)), "nothing dropped twice");
});
test("consuming match: inside an io.async body, across an await in the arm", {
  before := g_mo_disposed;
  before_sum := g_mo_sum;
  result := rc(RefCell(i32).new(0));
  task := io.async((io : Io) => {
    o := _mo_some(i32(4));
    first := match(
      o,
      .Some(f) => {
        io.await(yield(io), io);
        _mo_take(f)
      },
      .None => i32(0)
    );
    p := _mo_two(i32(2));
    second := match(
      p,
      .Two(a, _) => {
        io.await(yield(io), io);
        a.n
      },
      .One(a) => a.n,
      .Zero => i32(0)
    );
    result.with_mut(cur => {
      cur = (first + second);
    });
  });
  io.await(task, io);
  assert(result.with(cur => cur) == i32(6), "4 moved across the await, then a.n = 2");
  assert(g_mo_disposed == (before + i32(3)), "f by the callee, b at the arm's entry, a at the arm's end");
  assert(g_mo_sum == (before_sum + i32(9)), "4 + 3 + 2, each once");
});
test("consuming match: an io.async arm keeps a looked-through cell across an await", {
  before := g_mo_disposed;
  result := rc(RefCell(i32).new(0));
  task := io.async((io : Io) => {
    c := _MoCell.Cell(fd : _MoFd(n : i32(1)), shared : rc(_MoFd(n : i32(2))));
    result_value := match(
      c,
      .Cell(f, Rc(_MoFd(n : k))) => {
        io.await(yield(io), io);
        _mo_take(f) + k
      },
      .Empty => i32(0)
    );
    result.with_mut(cur => {
      cur = result_value;
    });
  });
  io.await(task, io);
  assert(result.with(cur => cur) == i32(3), "f moved after the await, k read through the kept cell");
  assert(g_mo_disposed == (before + i32(2)), "f by the callee, the cell at the arm's end");
});
// issues/fixed/a-move-inside-an-overloaded-operators-operand-is-a-use-after-move.md:
// the overload pick of `+` probed its right operand's type by evaluating it,
// which recorded the move, and the real evaluation then reported E0901.
test("a move inside an operator's operand moves once", {
  before := g_mo_disposed;
  d := _MoFd(n : i32(5));
  x := (i32(3) + _mo_take(d));
  assert(x == i32(8), "the operand ran once");
  e := _MoFd(n : i32(1));
  assert((i32(1) + _mo_take(e)) == i32(2), "inside an assert's condition");
  assert(g_mo_disposed == (before + i32(2)), "each value disposed once, by the callee");
});
// issues/fixed/a-method-call-on-a-move-only-element-disposes-a-copy-of-it.md:
// Aliasing Stage 0 gave the element a caller-owned "+1" for a callee that is
// not read-only, which for a move-only value was a bitwise copy whose drop
// ran `Drop` while the list still owned the element.
// The method writes container storage (a global list), so the mutation
// summary cannot prove it read-only and Stage 0 applied.
(mut(g_mo_seen) : ArrayList(i32)) = ArrayList(i32).new();
impl(
  _MoFd,
  _mo_note : (fn(self : &Self) -> i32)({
    g_mo_seen.push(self.n);
    self.n
  })
);
test("a method call on a move-only element borrows it: no copy is disposed", {
  before := g_mo_disposed;
  xs := ArrayList(_MoFd).new();
  xs.push(_MoFd(n : i32(4)));
  xs.push(_MoFd(n : i32(5)));
  assert(xs(usize(0))._mo_note() == i32(4), "the first element");
  assert(xs(usize(1))._mo_note() == i32(5), "the second element");
  assert(g_mo_disposed == before, "the calls borrowed; nothing was disposed");
  xs.clear();
  assert(g_mo_disposed == (before + i32(2)), "the list disposed each element once");
});
// A projection through an `Rc` lent to a callee with no mutation summary (a
// recursive call) used to take Aliasing Stage 0's +1: a bit copy of the
// move-only value, disposed after the call
// (issues/fixed/a-borrowed-projection-of-a-move-only-value-is-disposed-twice.md).
_mo_rec :: (fn(x : &_MoFd, n : i32) -> i32)(
  cond(
    (n == i32(0)) => x.n,
    true => {
      r := rc(_MoFd(n : x.n));
      _mo_rec(&r.*, n - i32(1))
    }
  )
);
test("move-only: a projection through an Rc lent to a recursive call is disposed once", {
  before := g_mo_disposed;
  {
    a := _MoFd(n : i32(0));
    assert(_mo_rec(&a, i32(2)) == i32(0), "the value reaches the base case");
  };
  assert(g_mo_disposed == (before + i32(3)), "a and the two cells' payloads, once each");
});
// ---------------------------------------------------------------------------
// `Drop`, the new name of `Drop` (plans/VALUES_BY_DEFAULT.md decision 45,
// Generation A: the compiler treats both spellings as the destructor), the
// prelude's `drop(x)`, and E0915 for an explicit destructor call.
// `g_mo_dropped` adds up the `n` of every dropped `_MoDrop*` value.
// ---------------------------------------------------------------------------
(mut(g_mo_dropped) : i32) = i32(0);
_MoDropFd :: struct(n : i32);
impl(
  _MoDropFd,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_mo_dropped = (g_mo_dropped + self.n);
    })
  )
);
_MoDropRef :: ref(struct(n : i32));
impl(
  _MoDropRef,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_mo_dropped = (g_mo_dropped + self.n);
    })
  )
);
_MoDropPair :: (fn(comptime(T) : Type) -> comptime(Type))(struct(a : T, n : i32));
impl(
  generic(T : Type),
  _MoDropPair(T),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_mo_dropped = (g_mo_dropped + self.n);
    })
  )
);
_MoDropHolder :: struct(fd : _MoDropFd, tag : i32);
_mo_drop_take :: (fn(sink(f) : _MoDropFd) -> i32)(f.n);
test("Drop: a Drop impl runs once, when the owner drops the value", {
  before := g_mo_dropped;
  {
    a := _MoDropFd(n : i32(1));
    assert(a.n == i32(1), "a is live");
  };
  assert(g_mo_dropped == (before + i32(1)), "dropped at the end of its scope");
  {
    h := _MoDropHolder(fd : _MoDropFd(n : i32(10)), tag : i32(0));
    assert(h.tag == i32(0), "the holder is live");
  };
  assert(g_mo_dropped == (before + i32(11)), "a field's Drop runs when its holder is dropped");
  {
    p := _MoDropPair(i32)(a : i32(7), n : i32(100));
    assert(p.a == i32(7), "the pair is live");
  };
  assert(g_mo_dropped == (before + i32(111)), "a generic Drop impl runs too");
});
test("Drop: a Drop value type is move-only", {
  comptime_assert(!Type.impls(_MoDropFd, Copy) && !Type.impls(_MoDropFd, Clone), "a Drop value type is neither Copy nor Clone");
  comptime_assert(!Type.impls(_MoDropHolder, Copy) && !Type.impls(_MoDropHolder, Clone), "a struct holding one is move-only");
  comptime_assert(!Type.impls(_MoDropPair(i32), Copy) && !Type.impls(_MoDropPair(i32), Clone), "a generic Drop impl's instance is move-only");
  comptime_assert(Type.contains_rc_type(_MoDropFd), "a Drop value has a drop to run");
  before := g_mo_dropped;
  {
    a := _MoDropFd(n : i32(2));
    b := a;
    comptime_expect_error(a.n, "use of moved value");
    assert(_mo_drop_take(b) == i32(2), "moved into the callee");
    assert(g_mo_dropped == (before + i32(2)), "the callee dropped it");
    comptime_expect_error(b.n, "use of moved value");
  };
  assert(g_mo_dropped == (before + i32(2)), "dropped once");
  comptime_expect_error(impl(i32, Drop(drop : (fn(self : &mut Self) -> unit)(()))), "cannot implement \"Drop\"");
});
test("Drop: drop(x) ends a value now and moves it", {
  before := g_mo_dropped;
  {
    a := _MoDropFd(n : i32(3));
    drop(a);
    assert(g_mo_dropped == (before + i32(3)), "drop(a) ran the destructor immediately");
    comptime_expect_error(a.n, "use of moved value");
  };
  assert(g_mo_dropped == (before + i32(3)), "and the scope end does not run it again");
  {
    d := _MoFd(n : i32(0));
    d_before := g_mo_disposed;
    drop(d);
    assert(g_mo_disposed == (d_before + i32(1)), "drop(x) runs a Drop impl too");
  };
});
test("Drop: an explicit destructor call is E0915", {
  a := _MoDropFd(n : i32(0));
  comptime_expect_error(a.drop(), "Explicit call of the destructor");
  comptime_expect_error(_MoDropFd.drop(&a), "Explicit call of the destructor");
  comptime_expect_error((_MoDropFd <: Drop).drop(&a), "Explicit call of the destructor");
  r := _MoDropRef(n : i32(0));
  comptime_expect_error(r.drop(), "Explicit call of the destructor");
  p := _MoDropPair(i32)(a : i32(0), n : i32(0));
  comptime_expect_error(p.drop(), "Explicit call of the destructor");
});
// `Drop.drop` takes `self : &mut Self`, as Rust's `drop(&mut self)`
// (decision 45, maintainer 2026-10-13): a destructor that takes a field out
// (`self.inner = .None`) writes the dropped value's own storage, so the field
// drops that follow it see `.None` and the inner value is released once, by
// the destructor's assignment. `g_md_calls` counts the outer destructor's
// runs and `g_md_inner` the inner value's; each path must add one to both.
(mut(g_md_calls) : i32) = i32(0);
(mut(g_md_inner) : i32) = i32(0);
_MdInner :: struct(n : i32);
impl(
  _MdInner,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_md_inner = (g_md_inner + i32(1));
    })
  )
);
_MdOuter :: struct(inner : Option(_MdInner), n : i32);
impl(
  _MdOuter,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_md_calls = (g_md_calls + i32(1));
      self.inner = Option(_MdInner).None;
    })
  )
);
_MdShow :: trait(n_of : (fn(self : &Self) -> i32));
impl(_MdOuter, _MdShow(n_of : (fn(self : &Self) -> i32)(self.n)));
_MdRef :: ref(struct(inner : Option(_MdInner), n : i32));
impl(
  _MdRef,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_md_calls = (g_md_calls + i32(1));
      self.inner = Option(_MdInner).None;
    })
  )
);
_md_make :: (fn(n : i32) -> _MdOuter)(_MdOuter(inner : Option(_MdInner).Some(_MdInner(n : n)), n : n));
_MdBad :: struct(n : i32);
test("Drop: a destructor that takes a field out runs once on every drop path", {
  c0 := g_md_calls;
  i0 := g_md_inner;
  {
    o := _md_make(i32(1));
    assert(o.n == i32(1), "scope end: live");
  };
  assert((g_md_calls == (c0 + i32(1))) && (g_md_inner == (i0 + i32(1))), "scope end: once");
  {
    o := _md_make(i32(2));
    drop(o);
    assert((g_md_calls == (c0 + i32(2))) && (g_md_inner == (i0 + i32(2))), "drop(x): at once");
  };
  assert((g_md_calls == (c0 + i32(2))) && (g_md_inner == (i0 + i32(2))), "drop(x): not again at the scope end");
  {
    r := rc(_md_make(i32(3)));
    r2 := r;
    assert(r2.n == i32(3), "Rc payload: live");
  };
  assert((g_md_calls == (c0 + i32(3))) && (g_md_inner == (i0 + i32(3))), "Rc payload: once, with the last handle");
  {
    b := box(_md_make(i32(4)));
    assert(b.n == i32(4), "Box payload: live");
  };
  assert((g_md_calls == (c0 + i32(4))) && (g_md_inner == (i0 + i32(4))), "Box payload: once");
  {
    (d : Dyn(_MdShow)) = dyn(_md_make(i32(5)));
    assert(d.n_of() == i32(5), "Dyn object: live");
  };
  assert((g_md_calls == (c0 + i32(5))) && (g_md_inner == (i0 + i32(5))), "Dyn object: once");
  {
    xs := ArrayList(_MdOuter).new();
    xs.push(_md_make(i32(6)));
    xs.push(_md_make(i32(7)));
    assert(xs.len() == usize(2), "ArrayList elements: live");
  };
  assert((g_md_calls == (c0 + i32(7))) && (g_md_inner == (i0 + i32(7))), "ArrayList elements: once each");
  {
    h := _MdRef(inner : Option(_MdInner).Some(_MdInner(n : i32(8))), n : i32(8));
    h2 := h;
    assert(h2.n == i32(8), "reference type: live");
  };
  assert((g_md_calls == (c0 + i32(8))) && (g_md_inner == (i0 + i32(8))), "reference type: once, with the last handle");
});
test("Drop: a drop declared with `self : &Self` does not conform", {
  comptime_expect_error(impl(_MdBad, Drop(drop : (fn(self : &Self) -> unit)(()))), "the trait requires the receiver");
});
// Decision 45 Generation A follow-ups. A method of another trait that is
// named `drop` or `dispose` keeps its Dyn vtable slot: only the destructor
// trait's own method is left out
// (issues/fixed/a-trait-method-named-drop-is-left-out-of-every-dyn-vtable.md).
_MoStack :: trait(
  drop : (fn(self : &mut Self, n : i32) -> i32),
  dispose : (fn(self : &Self) -> i32)
);
_MoStackImpl :: struct(top : i32);
impl(
  _MoStackImpl,
  _MoStack(
    drop : (fn(self : &mut Self, n : i32) -> i32)({
      self.top = (self.top - n);
      self.top
    }),
    dispose : (fn(self : &Self) -> i32)(self.top)
  )
);
test("Drop: a trait method named drop or dispose keeps its Dyn vtable slot", {
  (d : Dyn(_MoStack)) = dyn(_MoStackImpl(top : i32(10)));
  assert(d.drop(i32(3)) == i32(7), "a user trait's drop is called through Dyn");
  assert(d.dispose() == i32(7), "a user trait's dispose is called through Dyn");
});
// The destructor read as a value is E0915 too, as Rust's E0040: a call
// through the value would run it a second time
// (issues/fixed/a-destructor-read-as-a-method-value-gets-past-e0915.md). The
// repair names the value, not the type or the witness
// (issues/fixed/e0915-repair-hint-names-the-type-instead-of-the-value.md).
test("Drop: the destructor read as a value is E0915, and the repair names the value", {
  comptime_expect_error(_MoDropFd.drop, "is read as a value");
  comptime_expect_error((_MoDropFd <: Drop).drop, "is read as a value");
  myval := _MoDropFd(n : i32(0));
  comptime_expect_error(myval.drop(), "write drop(myval)");
  comptime_expect_error(_MoDropFd.drop(&mut myval), "write drop(myval)");
  comptime_expect_error((_MoDropFd <: Drop).drop(&mut myval), "write drop(myval)");
  comptime_expect_error(Drop.drop(&mut myval), "write drop(myval)");
});
// A type has one destructor: a second `Drop` impl, concrete or through a
// generic impl, is E0612 (plans/reference/TRAIT_COHERENCE.md).
// `ArrayList(T)`'s destructor is std's generic `Drop` impl.
_MoDropBox :: (fn(comptime(T) : Type) -> comptime(Type))(struct(v : T));
impl(
  _MoDropBox(i32),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_mo_dropped = (g_mo_dropped + self.v);
    })
  )
);
test("Drop: a type has one destructor", {
  comptime_expect_error(impl(_MoDropFd, Drop(drop : (fn(self : &mut Self) -> unit)(()))), "is already implemented");
  comptime_expect_error(impl(ArrayList(_MoDropFd), Drop(drop : (fn(self : &mut Self) -> unit)(()))), "is already implemented");
  comptime_expect_error(impl(generic(T : Type), _MoDropBox(T), Drop(drop : (fn(self : &mut Self) -> unit)(()))), "is already implemented");
  comptime_expect_error(impl(generic(T : Type), _MoDropPair(T), Drop(drop : (fn(self : &mut Self) -> unit)(()))), "is already implemented");
  before := g_mo_dropped;
  {
    xs := ArrayList(_MoDropFd).new();
    xs.push(_MoDropFd(n : i32(20)));
    xs.push(_MoDropFd(n : i32(30)));
    assert(xs.len() == usize(2), "live");
  };
  assert(g_mo_dropped == (before + i32(50)), "std's ArrayList destructor still drops each element");
});
// A `Drop` impl, concrete or generic, std's included, satisfies a `Drop`
// bound and `Type.impls(T, Drop)`.
_mo_retire_drop :: (fn(generic(T : Type), x : T, where(T <: Drop)) -> unit)(drop(x));
_mo_needs_cleanup :: (fn(comptime(T) : Type) -> comptime(bool))(Type.impls(T, Drop));
test("Drop: Drop impls satisfy a Drop bound and Type.impls", {
  comptime_assert(Type.impls(_MoDropFd, Drop), "a Drop type implements Drop");
  comptime_assert(Type.impls(_MoFd, Drop), "so does one migrated to Drop");
  comptime_assert(_mo_needs_cleanup(ArrayList(i32)), "std's collections implement Drop");
  comptime_assert(_mo_needs_cleanup(_MoDropPair(i32)), "a generic Drop impl answers for Drop");
  comptime_assert(!_mo_needs_cleanup(i32), "a type with no destructor implements neither");
  before := g_mo_dropped;
  _mo_retire_drop(_MoDropFd(n : i32(5)));
  assert(g_mo_dropped == (before + i32(5)), "a Drop value meets a Drop bound");
  d_before := g_mo_disposed;
  _mo_retire_drop(_MoFd(n : i32(0)));
  assert(g_mo_disposed == (d_before + i32(1)), "and so does one migrated to Drop");
  _mo_retire_drop(ArrayList(i32).new());
});
// Decision 45 Generation B: `Dispose` is no longer a destructor name. A
// trait a program defines under that name is an ordinary trait: a `Copy`
// type may implement it, and its `dispose` is an ordinary method.
Dispose :: trait(
  id := "Dispose",
  dispose : (fn(self : &Self) -> i32)
);
_MoOldTok :: struct(n : i32);
derive(_MoOldTok, Copy, Clone);
impl(_MoOldTok, Dispose(dispose : (fn(self : &Self) -> i32)(self.n)));
test("Drop: a trait named Dispose is an ordinary trait", {
  t := _MoOldTok(n : i32(4));
  u := t;
  assert((t.dispose() + u.dispose()) == i32(8), "both copies are usable, and dispose is an ordinary method");
});
// §3.13 A3 Generation B: `pop`, `swap`, `remove` and `reverse` move elements
// bitwise (`__yo_ptr_read`/`__yo_ptr_write`), so a move-only element works.
test("ArrayList pop/swap/remove/reverse move a move-only element", {
  before := g_mo_disposed;
  sum_before := g_mo_sum;
  xs := ArrayList(_MoFd).new();
  xs.push(_MoFd(n : i32(1)));
  xs.push(_MoFd(n : i32(2)));
  xs.push(_MoFd(n : i32(3)));
  xs.push(_MoFd(n : i32(4)));
  xs.swap(usize(0), usize(3));
  assert(xs(usize(0)).n == i32(4), "swapped in");
  assert(xs(usize(3)).n == i32(1), "swapped out");
  xs.reverse();
  assert(xs(usize(0)).n == i32(1), "reversed: first");
  assert(xs(usize(3)).n == i32(4), "reversed: last");
  // [1, 3, 2, 4]
  r := xs.remove(usize(1));
  assert(r.n == i32(3), "removed the second element");
  assert(xs.len() == usize(3), "the tail closed the gap");
  assert(xs(usize(1)).n == i32(2), "the tail moved left");
  assert(g_mo_disposed == before, "no move disposed anything");
  assert(_mo_take(r) == i32(3), "the removed element is owned");
  match(
    xs.pop(),
    .Some(p) => assert(_mo_take(p) == i32(4), "pop moves the last element out"),
    .None => assert(false, "pop of a non-empty list")
  );
  assert(xs.len() == usize(2), "pop shortened the list");
  assert(g_mo_disposed == (before + i32(2)), "the two moved-out elements, each once");
  xs.clear();
  assert(g_mo_disposed == (before + i32(4)), "every element disposed exactly once");
  assert(g_mo_sum == (sum_before + i32(10)), "and each one by its own value");
});
// decision 19's `take`/`replace`, built on the bitwise moves.
test("Option take/replace move a move-only payload", {
  before := g_mo_disposed;
  mut(o) := Option(_MoFd).Some(_MoFd(n : i32(7)));
  t := o.take();
  assert(o.is_none(), "take leaves .None");
  assert(g_mo_disposed == before, "take moved the payload; nothing was disposed");
  old := o.replace(_MoFd(n : i32(8)));
  assert(old.is_none(), "replace hands back the old option");
  assert(o.is_some(), "replace stores the new payload");
  again := o.replace(_MoFd(n : i32(9)));
  match(
    again,
    .Some(f) => assert(_mo_take(f) == i32(8), "the replaced payload moves out"),
    .None => assert(false, "replace of a .Some")
  );
  match(
    t,
    .Some(f) => assert(_mo_take(f) == i32(7), "the taken payload moves out"),
    .None => assert(false, "take of a .Some")
  );
  assert(g_mo_disposed == (before + i32(2)), "the two moved-out payloads, by their callee");
  o = Option(_MoFd).None;
  assert(g_mo_disposed == (before + i32(3)), "the stored payload, by the reassignment");
});
// A value that owns its heap buffer (V2b's unique buffers) is not a raw
// view: a safe file may name it in a parameter type, as it may name a `Box`.
// It carries what its elements carry. Before, the raw-view gate saw only the
// `?*T` field and rejected every such signature in safe code.
_vlist_total :: (fn(xs : &VList(i32)) -> usize)(xs.len());
test("move-only: a buffer-owning value is not a raw view in safe code", {
  mut(xs) := VList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  assert(_vlist_total(&xs) == usize(2), "a safe signature names the owner");
  ys := xs;
  assert(ys.len() == usize(2), "it moves like any owner");
});
