test("Test anonymous closure value with Dyn that captures Rc object with auto boxing", {
  x := MyBox(1);
  (closure : Dyn(Fn(y : i32) -> i32)) = dyn((y) => {
    // without explicitly calling `box`
    x.* = (x.* + y);
    return(x.*);
  });
  closure2 := closure; // Test dup on closure
  closure(1); // 2
  closure2(1); // 3
  result := closure(2); // 5
  unsafe(printf("Final result: %d\n", result));
  assert(x.* == 5, "Captured boxed variable should be 5");
  assert(x.* == result, "Expected final result to be 5");
});
