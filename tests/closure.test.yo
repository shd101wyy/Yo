pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ AtomicI32, AtomicUsize, MemoryOrder } :: import("std/sync/atomic");
{ Channel } :: import("std/sync/channel");
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ printf } :: import("std/libc/stdio.yo");
MyBox :: ref(
  struct(
    (*) : i32
  )
);
impl(
  MyBox,
  Dispose(
    dispose : (fn(imm(self) : Self) -> unit)({
      unsafe(printf("Disposing Boxed i32 with value: %d\n", self.*));
    })
  )
);
test("Test ClosureType({...}) to create closure value", {
  x := 1;
  ClosureType :: Impl(Fn(y : i32) -> i32);
  T :: Type.to_comptime_string(ClosureType);
  closure := ClosureType({
    x = (x + y);
    return(x);
  });
  closure2 := closure; // Test dup on closure
  closure(1); // 2
  closure(1); // 3
  result := closure(2); // 5
  unsafe(printf("Final result: %d\n", result));
  assert(x == 1, "Captured variable x should remain unchanged outside closure");
  assert(result == 5, "Expected final result to be 5");
});
test("Test anonymous closure value =>", {
  x := 1;
  (closure : Impl(Fn(y : i32) -> i32)) = (
    y => {
      x = (x + y);
      return(x);
    }
  );
  closure2 := closure; // Test dup on closure
  closure(1); // 2
  closure(1); // 3
  result := closure(2); // 5
  unsafe(printf("Final result: %d\n", result));
  assert(x == 1, "Captured variable x should remain unchanged outside closure");
  assert(result == 5, "Expected final result to be 5");
});
some_cond :: (fn() -> bool)({
  return(true);
});
// This should fail
test("Test multiple expected errors", {
  comptime_expect_error({
    closure : Impl(Fn(y : i32) -> i32);
    cond(
      some_cond() => {
        a := 1;
        closure = (
          y => {
            return(y + a);
          }
        );
      },
      true => {
        b := 1;
        closure = (
          y => {
            return(y + b);
          }
        );
      }
    );
  });
  comptime_expect_error({
    closure : Impl(Fn(y : i32) -> i32);
    cond(
      some_cond() => {
        a := 1;
        closure = (
          y => {
            return(y + a);
          }
        );
      },
      true => {
        a := 2;
        closure = (
          y => {
            return(y + a);
          }
        );
      }
    );
  }, "different concrete types across branches");
  comptime_expect_error(
    (closure : Impl(Fn(y : i32) -> i32)) =
      cond(
        some_cond() => {
          a := 1;
          y => {
            return(y + a);
          }
        },
        true => {
          a := 2;
          y => {
            return(y + a);
          }
        }
      )
  );
  // This should fail - sequential reassignment to closures with different capture types
  comptime_expect_error({
    a := 1;
    b := 2;
    closure : Impl(Fn(y : i32) -> i32);
    closure = (y => (y + a));
    closure = (y => (y + b));
  }, "Cannot reassign variable \"closure\" of type Impl");
  comptime_expect_error({
    a := 1;
    (closure : Impl(Fn(y : i32) -> i32)) = (y => (y + a));
    closure = (y => (y + a));
  }, "Cannot reassign variable \"closure\" of type Impl");
});
test("Test closure with Dyn", {
  x := 1;
  (closure : Dyn(Fn(y : i32) -> i32)) = dyn(
    rc(y => {
      x = (x + y);
      return(x);
    })
  );
  closure2 := closure; // Test dup on closure
  closure(1); // 2
  closure2(1); // 3
  result := closure(2); // 5
  unsafe(printf("Final result: %d\n", result));
  assert(x == 1, "Captured variable x should remain unchanged outside closure");
  assert(result == 5, "Expected final result to be 5");
});
test("Test closure with Impl that captures Rc object", {
  x := MyBox(1);
  ClosureType :: Impl(Fn(y : i32) -> i32);
  closure := ClosureType({
    x.* = (x.* + y);
    return(x.*);
  });
  closure2 := closure; // Test dup on closure
  closure(1); // 2
  closure(1); // 3
  result := closure(2); // 5
  unsafe(printf("Final result: %d\n", result));
  assert(x.* == 5, "Captured boxed variable should be 5");
  assert(x.* == result, "Expected final result to be 5");
});
// A `ClosureType({...})` closure owns its RC captures, like an `=>` one: the
// box outlives the function that built the closure. It used to capture
// without a reference, so the box was freed when `_make_counter` returned and
// the closure read freed memory (issues/fixed/a-closuretype-closure-does-not-own-its-rc-captures.md).
_CounterFn :: Impl(Fn(y : i32) -> i32);
_make_counter :: (fn() -> _CounterFn)({
  x := MyBox(40);
  c := _CounterFn({
    x.* = (x.* + y);
    return(x.*);
  });
  c
});
test("Test ClosureType closure keeps its Rc capture alive after its builder returns", {
  c := _make_counter();
  assert(c(i32(2)) == i32(42), "the captured box survives the builder's return");
  assert(c(i32(3)) == i32(45), "and keeps its state between calls");
});
test("Test closure captured Rc survives nested early return", {
  x := MyBox(1);
  take_return := true;
  ClosureType :: Impl(Fn(y : i32) -> i32);
  closure := ClosureType({
    cond(
      take_return => {
        x.* = (x.* + y);
        return(x.*);
      },
      true => {
        x.* = (x.* + i32(100));
        return(x.*);
      }
    );
    return(i32(-1));
  });
  closure2 := closure;
  result := closure(4);
  assert(result == i32(5), "nested early return should return updated value");
  assert(x.* == i32(5), "captured boxed variable should survive early return");
  result2 := closure2(2);
  assert(result2 == i32(7), "duplicated closure should share captured box");
  assert(x.* == i32(7), "captured box should remain alive after duplicate call");
});
test("Test anonymous closure value with Impl that captures Rc object", {
  x := MyBox(1);
  ClosureType :: Impl(Fn(y : i32) -> i32);
  (closure : ClosureType) = (
    y => {
      x.* = (x.* + y);
      return(x.*);
    }
  );
  closure2 := closure; // Test dup on closure
  closure(1); // 2
  closure(1); // 3
  result := closure(2); // 5
  unsafe(printf("Final result: %d\n", result));
  assert(x.* == 5, "Captured boxed variable should be 5");
  assert(x.* == result, "Expected final result to be 5");
});
test("Test anonymous closure value with Dyn that captures Rc object", {
  x := MyBox(1);
  (closure : Dyn(Fn(y : i32) -> i32)) = dyn(
    rc(y => {
      x.* = (x.* + y);
      return(x.*);
    })
  );
  closure2 := closure; // Test dup on closure
  closure(1); // 2
  closure2(1); // 3
  result := closure(2); // 5
  unsafe(printf("Final result: %d\n", result));
  assert(x.* == 5, "Captured boxed variable should be 5");
  assert(x.* == result, "Expected final result to be 5");
});
test("Test anonymous closure value with Dyn that captures Rc object with auto boxing", {
  x := MyBox(1);
  (closure : Dyn(Fn(y : i32) -> i32)) = dyn(y => {
    // without explicitly calling `box`
    x.* = (x.* + y);
    return(x.*);
  });
  closure2 := closure; // Test dup on closure
  closure(1); // 2
  closure2(1); // 3
  result := closure(2); // 5
  unsafe(printf("Final result: %d\n", result));
  assert(x.* == 5, "Captured boxed variable should be 5");
  assert(x.* == result, "Expected final result to be 5");
});
// Regression (issues/fixed/arrow-fn-literal-result-type-not-inferred.md, C55):
// a `->` fn literal passed where a result type variable must be inferred
// (`Option.map`'s `B`, a user method's `Impl(Fn(..) -> R)`) binds it exactly
// like a `=>` closure does. The binding used to be gated on "is a closure" to
// keep ctl effect handlers' per-call-site `ResumeType` unbound; the gate now
// excludes only ctl types, so the first method call on the result resolves.
ArrowApply :: struct(base : i64);
derive(ArrowApply, Copy, Clone);
impl(
  ArrowApply,
  apply : (fn(generic(R : Type), self : Self, imm(f) : Impl(Fn(v : i64) -> R)) -> R)(f(self.base))
);
test("a -> fn literal binds the result type variable of Option.map and of an Impl(Fn) method", {
  o := Option(i64).Some(i64(2));
  s := o.map(x -> `v=${x}`).unwrap();
  assert(s.to_string() == `v=2`, "Option.map result usable through a -> literal");
  assert(s.len() == usize(3), "String methods resolve on the mapped value");
  a := ArrowApply(base : i64(20));
  t := a.apply(v -> `n=${v + i64(1)}`);
  assert(t.to_string() == `n=21`, "method generic R bound by a -> literal");
  n := a.apply(v -> (v * i64(2)));
  assert((n + i64(1)) == i64(41), "and by a numeric -> literal");
});

// ---------------------------------------------------------------------------
// Module-level globals are NOT captures (issues/module-global-referenced-
// inside-async-closure-undeclared.md, fixed in the capture tracker): a
// module global lowers to a process-global C symbol, so referencing one
// from inside a closure must emit the global directly — capturing it added
// a phantom capture-struct member and the C compile failed with
// "no member named 'counter_m<hash>'".
// ---------------------------------------------------------------------------
module_global_counter := AtomicI32(i32(0));
run_it :: (fn(imm(f) : Impl(Fn() -> unit)) -> unit)(f());
test("a closure referencing a module-level global compiles and mutates it", {
  run_it(() => {
    module_global_counter.fetch_add(i32(3), MemoryOrder.Relaxed);
    ()
  });
  assert(module_global_counter.load(MemoryOrder.Relaxed) == i32(3), "the inline closure reached the module global");
});
test("a named module-level fn still reaches the global", {
  bump_again :: (fn() -> unit)({
    module_global_counter.fetch_add(i32(4), MemoryOrder.Relaxed);
    ()
  });
  run_it(bump_again);
  assert(module_global_counter.load(MemoryOrder.Relaxed) == i32(4), "named module fn reached the global");
});
// ---------------------------------------------------------------------------
// A generic impl method's closure is emitted ONCE — the substituted
// generation. Calling such a method used to mint TWO closure generations, one
// with the impl's `T` still a bare SomeT, and codegen emitted both: the
// generic one keyed every call in its body on the unresolved `T`
// ("call to undeclared function ..._rtparam1_2192_...", where the C
// compiler's own "did you mean" named the correct symbol right beside it).
// issues/fixed/a-generic-impl-methods-closure-is-emitted-twice.md
// ---------------------------------------------------------------------------
GenericHolder :: (fn(comptime(T) : Type) -> comptime(Type))(
  ref(struct(_slot : Channel(T)))
);
impl(
  generic(T : Type),
  GenericHolder(T),
  where(T <: (Send, Acyclic)),
  /// The closure captures `sink : Channel(T)` and `v : T` — both generic —
  /// and is handed to an `Impl(Fn)` parameter, which is what creates the
  /// second generation.
  make : (fn(imm(v) : T) -> Self)({
    ch := Channel(T).new(usize(1));
    sink := ch;
    run_it(() => {
      _ := sink.send(v);
      ()
    });
    Self(_slot : ch)
  }),
  take : (fn(imm(self) : Self, imm(fallback) : T) -> T)(
    match(self._slot.try_recv(), .Ok(r) => r, .Err(_) => fallback)
  )
);
test("a generic impl method's capturing closure compiles and runs", {
  h := GenericHolder(i32).make(i32(7));
  assert(h.take(i32(0)) == i32(7), "the generic impl method's closure delivered its value");
});
test("the same generic impl method at a second instantiation", {
  h := GenericHolder(bool).make(true);
  assert(h.take(false), "the bool instantiation delivered its value too");
});
// A generic instantiated at a closure's own type: the static constructor's
// `-> Self` and the `Self(...)` it builds are one C type
// (issues/fixed/a-container-of-a-closure-type-does-not-compile.md).
_ClosureSlot :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    tag : i32,
    _f : Option(T)
  )
);
impl(
  generic(T : Type),
  _ClosureSlot(T),
  empty : (fn(tag : i32) -> Self)(Self(tag : tag, _f : .None)),
  holding : (fn(tag : i32, imm(f) : T) -> Self)(Self(tag : tag, _f : .Some(f)))
);
test("a container of a closure type compiles and calls the closure", {
  (hits : AtomicI32) = AtomicI32.new(i32(0));
  (k : Impl(Fn() -> unit)) = (
    () => {
      hits.fetch_add(i32(1), MemoryOrder.AcqRel);
      ();
    }
  );
  ks := ArrayList(type_of(k)).new();
  ks.push(k);
  match(ks.get(usize(0)), .Some(g0) => g0(), .None => assert(false, "the pushed closure is there"));
  assert(ks.len() == usize(1), "one closure in the list");
  assert(hits.load(MemoryOrder.Acquire) == i32(1), "the listed closure ran");
});
test("a generic's static -> Self constructor at a closure type", {
  n := i32(40);
  (k : Impl(Fn() -> i32)) = (() => (n + i32(2)));
  e := _ClosureSlot(type_of(k)).empty(i32(3));
  assert(e.tag == i32(3), "the empty slot");
  s := _ClosureSlot(type_of(k)).holding(i32(4), k);
  assert(s.tag == i32(4), "the holding slot");
  assert(match(s._f, .Some(g) => g(), .None => i32(0)) == i32(42), "the held closure ran");
});
test("two closures' lists are two types, one per closure", {
  (hits : AtomicI32) = AtomicI32.new(i32(0));
  a := i32(1);
  b := i32(10);
  (k1 : Impl(Fn() -> unit)) = (
    () => {
      hits.fetch_add(a, MemoryOrder.AcqRel);
      ();
    }
  );
  (k2 : Impl(Fn() -> unit)) = (
    () => {
      hits.fetch_add(b, MemoryOrder.AcqRel);
      ();
    }
  );
  l1 := ArrayList(type_of(k1)).new();
  l2 := ArrayList(type_of(k2)).new();
  l1.push(k1);
  l2.push(k2);
  match(l1.get(usize(0)), .Some(g1) => g1(), .None => assert(false, "k1 is in l1"));
  match(l2.get(usize(0)), .Some(g2) => g2(), .None => assert(false, "k2 is in l2"));
  assert(hits.load(MemoryOrder.Acquire) == i32(11), "each list called its own closure");
});
// Two closures of different capture shapes: the first list's push must not
// leave a binding that types the second closure as the first's capture struct.
test("a second closure's list after the first list's push", {
  (hits : AtomicI32) = AtomicI32.new(i32(0));
  a := i32(1);
  s := String.from("abc");
  (k1 : Impl(Fn() -> unit)) = (
    () => {
      hits.fetch_add(a, MemoryOrder.AcqRel);
      ();
    }
  );
  l1 := ArrayList(type_of(k1)).new();
  l1.push(k1);
  (k2 : Impl(Fn() -> unit)) = (
    () => {
      hits.fetch_add(i32(s.len()), MemoryOrder.AcqRel);
      ();
    }
  );
  l2 := ArrayList(type_of(k2)).new();
  l2.push(k2);
  match(l1.get(usize(0)), .Some(g1) => g1(), .None => assert(false, "k1 is in l1"));
  match(l2.get(usize(0)), .Some(g2) => g2(), .None => assert(false, "k2 is in l2"));
  assert(hits.load(MemoryOrder.Acquire) == i32(4), "each list called its own closure");
});
// ---------------------------------------------------------------------------
// A closure releases its captures (issues/fixed/a-closure-typed-slot-never-releases-its-captures.md).
// Every case asserts EXACTLY one dispose: 0 is the leak, 2 an over-release.
(g_cap_disposed : i32) = i32(0);
CapPayload :: ref(struct(n : i32));
impl(
  CapPayload,
  Dispose(
    dispose : (fn(imm(self) : Self) -> unit)({
      g_cap_disposed = (g_cap_disposed + i32(1));
    })
  )
);
_cap_ignore :: (fn(imm(get) : Impl(Fn(x : i32) -> i32)) -> i32)(i32(0));
_cap_call :: (fn(imm(get) : Impl(Fn(x : i32) -> i32)) -> i32)(get(i32(3)));
_cap_rewrap :: (fn(imm(get) : Impl(Fn(x : i32) -> i32)) -> i32)({
  (again : Impl(Fn(x : i32) -> i32)) = ((x : i32) => get(x));
  again(i32(3))
});
_CapBox :: ref(struct(f : Dyn(Fn(x : i32) -> i32)));
_cap_boxed :: (fn(imm(get) : Impl(Fn(x : i32) -> i32)) -> i32)({
  b := _CapBox(f : dyn(x => get(x)));
  b.f(i32(3))
});
test("a closure local releases its captures at scope end", {
  before := g_cap_disposed;
  {
    p := CapPayload(n : i32(5));
    (c : Impl(Fn(x : i32) -> i32)) = ((x : i32) => (x + p.n));
    assert(c(i32(1)) == i32(6), "the closure reads its capture");
  };
  assert((g_cap_disposed - before) == i32(1), "the capture is released exactly once");
});
test("a copied closure releases its captures once per owner", {
  before := g_cap_disposed;
  {
    p := CapPayload(n : i32(5));
    (c : Impl(Fn(x : i32) -> i32)) = ((x : i32) => (x + p.n));
    c2 := c;
    assert((c(i32(1)) + c2(i32(1))) == i32(12), "both copies read the capture");
  };
  assert((g_cap_disposed - before) == i32(1), "the capture is released exactly once");
});
test("a closure literal passed as an argument releases its captures", {
  before := g_cap_disposed;
  {
    p := CapPayload(n : i32(5));
    assert(_cap_ignore((x : i32) => (x + p.n)) == i32(0), "an unused closure parameter");
    assert(_cap_call((x : i32) => (x + p.n)) == i32(8), "a called closure parameter");
  };
  assert((g_cap_disposed - before) == i32(1), "the capture is released exactly once");
});
test("a closure local passed as an argument stays owned by the caller", {
  before := g_cap_disposed;
  {
    p := CapPayload(n : i32(5));
    (c : Impl(Fn(x : i32) -> i32)) = ((x : i32) => (x + p.n));
    assert(_cap_call(c) == i32(8), "the callee calls it");
    assert(c(i32(1)) == i32(6), "the caller still owns a live closure");
  };
  assert((g_cap_disposed - before) == i32(1), "the capture is released exactly once");
});
test("a closure captured by another closure releases the inner captures", {
  before := g_cap_disposed;
  {
    p := CapPayload(n : i32(5));
    assert(_cap_rewrap((x : i32) => (x + p.n)) == i32(8), "the outer closure calls the inner");
    (inner : Impl(Fn(x : i32) -> i32)) = ((x : i32) => (x + p.n));
    (outer : Impl(Fn(x : i32) -> i32)) = ((x : i32) => inner(x));
    assert(outer(i32(1)) == i32(6), "a local closure capturing a local closure");
  };
  assert((g_cap_disposed - before) == i32(1), "the capture is released exactly once");
});
test("a closure captured by a Dyn closure field releases its captures", {
  before := g_cap_disposed;
  {
    p := CapPayload(n : i32(5));
    assert(_cap_boxed((x : i32) => (x + p.n)) == i32(8), "the boxed closure calls through");
  };
  assert((g_cap_disposed - before) == i32(1), "the capture is released exactly once");
});
// issues/fixed/a-unit-call-through-a-fn-typed-field-never-drops-its-argument-temporaries.md
_CapSink :: (fn(imm(p) : CapPayload) -> unit);
_CapSinkBundle :: struct(sink : _CapSink);
_cap_send :: (fn(imm(b) : _CapSinkBundle) -> unit)(b.sink(CapPayload(n : i32(3))));
test("a unit call through a fn-typed field releases its argument temporary", {
  before := g_cap_disposed;
  (s : _CapSink) = (p -> ());
  _cap_send(_CapSinkBundle(sink : s));
  assert((g_cap_disposed - before) == i32(1), `the argument was released once, released ${g_cap_disposed - before}`);
});
// A function whose `Impl(Fn)` result is the TAIL `cond`/`match` itself: the
// join keeps the arms' concrete closure type (it adopted the abstract
// `Impl`, so the C result temp was `void*` and clang rejected the store)
// (issues/fixed/cond-match-tail-adopts-the-abstract-impl-result-type.md).
_impl_tail_cond :: (fn(x : i32, b : bool) -> Impl(Fn() -> i32))({
  (f : Impl(Fn() -> i32)) = ({ x }() => x);
  cond(b => f, true => f)
});
_impl_tail_match :: (fn(x : i32, b : bool) -> Impl(Fn() -> i32))({
  (f : Impl(Fn() -> i32)) = ({ x }() => x);
  match(b, true => f, false => f)
});
_impl_tail_guard :: (fn(x : i32, n : i32) -> Impl(Fn() -> i32))({
  (f : Impl(Fn() -> i32)) = ({ x }() => x);
  match(n, (k && (k > i32(0))) => f, _ => f)
});
_impl_tail_nested :: (fn(x : i32, b : bool, c : bool) -> Impl(Fn() -> i32))({
  (f : Impl(Fn() -> i32)) = ({ x }() => x);
  match(b, true => cond(c => f, true => f), false => match(c, true => f, false => f))
});
_impl_tail_return :: (fn(x : i32, b : bool) -> Impl(Fn() -> i32))({
  (f : Impl(Fn() -> i32)) = ({ x }() => x);
  if(b, {
    return(cond(b => f, true => f));
  });
  match(b, true => f, false => f)
});
_impl_tail_generic :: (fn(generic(T : Type), x : T, b : bool) -> Impl(Fn() -> T))({
  (f : Impl(Fn() -> T)) = ({ x }() => x);
  match(b, true => f, false => f)
});
_impl_tail_payload :: (fn(b : bool) -> Impl(Fn(x : i32) -> i32))({
  p := CapPayload(n : i32(5));
  (f : Impl(Fn(x : i32) -> i32)) = ((x : i32) => (x + p.n));
  cond(b => f, true => f)
});
test("a cond or match tail returns its arms' closure as an Impl(Fn) result", {
  assert(_impl_tail_cond(i32(42), true)() == i32(42), "cond tail, first arm");
  assert(_impl_tail_cond(i32(7), false)() == i32(7), "cond tail, fallback arm");
  assert(_impl_tail_match(i32(43), true)() == i32(43), "match tail");
  assert(_impl_tail_match(i32(44), false)() == i32(44), "match tail, second arm");
  assert(_impl_tail_guard(i32(5), i32(1))() == i32(5), "guarded match tail");
  assert(_impl_tail_guard(i32(6), i32(-1))() == i32(6), "guarded match tail, fallback");
  assert(_impl_tail_nested(i32(3), true, false)() == i32(3), "cond nested in a match arm");
  assert(_impl_tail_nested(i32(4), false, true)() == i32(4), "match nested in a match arm");
  assert(_impl_tail_return(i32(1), true)() == i32(1), "return(cond(...))");
  assert(_impl_tail_return(i32(2), false)() == i32(2), "match tail after a return");
  assert(_impl_tail_generic(i32(8), true)() == i32(8), "generic, i32");
  assert(_impl_tail_generic(i64(9), false)() == i64(9), "generic, i64");
});
test("a closure returned through a cond tail keeps and releases its capture once", {
  before := g_cap_disposed;
  {
    g := _impl_tail_payload(true);
    assert(g(i32(1)) == i32(6), "the returned closure reads its capture");
    assert(g(i32(2)) == i32(7), "and again");
  };
  assert((g_cap_disposed - before) == i32(1), `the capture is released exactly once, released ${g_cap_disposed - before}`);
});
// A LOCAL function value returning `Impl(Fn)` is called with the concrete
// closure type the function returns, not `void*`
// (issues/fixed/a-local-function-value-returning-an-impl-fn-calls-through-a-void-pointer-signature.md).
test("a local function value returning an Impl(Fn) result", {
  mk := (fn(x : i32) -> Impl(Fn() -> i32))({
    (f : Impl(Fn() -> i32)) = ({ x }() => (x + i32(1)));
    f
  });
  g := mk(i32(41));
  h := mk(i32(9));
  assert(g() == i32(42), "first call");
  assert(h() == i32(10), "second call");
  assert(g() == i32(42), "the first closure again");
  assert(mk(i32(3))() == i32(4), "called directly");
  (outer : Impl(Fn(y : i32) -> i32)) = ({ mk }(y : i32) => mk(y)());
  assert(outer(i32(5)) == i32(6), "captured by a closure");
});
test("a local function value's Impl(Fn) result keeps and releases its capture once", {
  before := g_cap_disposed;
  {
    mk := (fn(n : i32) -> Impl(Fn(x : i32) -> i32))({
      p := CapPayload(n : n);
      (f : Impl(Fn(x : i32) -> i32)) = ((x : i32) => (x + p.n));
      f
    });
    g := mk(i32(5));
    assert(g(i32(1)) == i32(6), "the returned closure reads its capture");
    assert(g(i32(2)) == i32(7), "and again");
  };
  assert((g_cap_disposed - before) == i32(1), `the capture is released exactly once, released ${g_cap_disposed - before}`);
});
test("an Impl(Fn) result joined from two different closures is rejected", {
  comptime_expect_error(
    (fn(x : i32, b : bool) -> Impl(Fn() -> i32))({
      (f : Impl(Fn() -> i32)) = ({ x }() => x);
      (h : Impl(Fn() -> i32)) = ({ x }() => (x + i32(1)));
      cond(b => f, true => h)
    }),
    "different concrete closure types"
  );
  comptime_expect_error(
    (fn(x : i32, b : bool) -> Impl(Fn() -> i32))({
      (f : Impl(Fn() -> i32)) = ({ x }() => x);
      (h : Impl(Fn() -> i32)) = ({ x }() => (x + i32(1)));
      match(b, true => f, false => h)
    }),
    "different concrete closure types"
  );
});
// A function returning `Impl(Fn)` passed to a GENERIC `Impl(Fn(...) -> ...)`
// parameter is called with its concrete result: each specialization types
// `mk(v)` from the argument's own function type, not from the parameter's
// open `Impl(Fn() -> i32)` / `G`, which lowered `g := mk(v)` to `void*`
// (issues/fixed/a-function-returning-impl-passed-to-a-function-typed-parameter-is-called-through-void-pointer.md).
_nim_use :: (fn(imm(mk) : Impl(Fn(x : i32) -> Impl(Fn() -> i32)), v : i32) -> i32)({
  g := mk(v);
  g()
});
_nim_use_where :: (fn(generic(G : Type), imm(mk) : Impl(Fn(x : i32) -> G), v : i32, where(G <: (Fn() -> i32))) -> i32)({
  g := mk(v);
  g()
});
_nim_pass :: (fn(generic(R : Type), imm(mk) : Impl(Fn(x : i32) -> R), v : i32) -> R)({
  return(mk(v));
});
_nim_double :: (fn(x : i32) -> Impl(Fn() -> i32))({
  (f : Impl(Fn() -> i32)) = ({ x }() => (x * i32(2)));
  f
});
_nim_boxed :: (fn(n : i32) -> Impl(Fn() -> i32))({
  p := CapPayload(n : n);
  (f : Impl(Fn() -> i32)) = (() => (p.n + i32(100)));
  f
});
test("a function returning Impl(Fn) through a generic Impl(Fn) parameter", {
  assert(_nim_use(_nim_double, i32(21)) == i32(42), "nested Impl(Fn) parameter");
  assert(_nim_use(_nim_boxed, i32(1)) == i32(101), "a second argument function: its own specialization");
  assert(_nim_use_where(_nim_double, i32(5)) == i32(10), "a where-bound G");
  assert(_nim_use_where(_nim_boxed, i32(2)) == i32(102), "a where-bound G, second argument");
  g := _nim_pass(_nim_double, i32(4));
  assert(g() == i32(8), "R bound to the concrete result");
});
test("a closure returning Impl(Fn) through a nested Impl(Fn) slot", {
  k := i32(1);
  (mk : Impl(Fn(x : i32) -> Impl(Fn() -> i32))) = ({ k }(x : i32) => {
    (f : Impl(Fn() -> i32)) = ({ x, k }() => ((x * i32(2)) + k));
    f
  });
  assert(mk(i32(4))() == i32(9), "called directly");
  h := mk(i32(10));
  assert(h() == i32(21), "bound, then called");
  assert(_nim_use(mk, i32(21)) == i32(43), "passed to a nested Impl(Fn) parameter");
});
test("a function's Impl(Fn) result through a generic parameter releases its capture once", {
  before := g_cap_disposed;
  {
    assert(_nim_use(_nim_boxed, i32(3)) == i32(103), "first call");
    assert(_nim_use_where(_nim_boxed, i32(4)) == i32(104), "second call");
  };
  assert((g_cap_disposed - before) == i32(2), `each capture is released exactly once, released ${g_cap_disposed - before}`);
});
// A LOCAL annotated with a bare function type takes its initializer's
// concrete function type (as an `Impl(Fn(...))` annotation takes its
// closure's), so it stays a valid slot; a `comptime` parameter of that type
// is specialized per argument.
_nim_use_ct :: (fn(comptime(mk) : (fn(x : i32) -> Impl(Fn() -> i32)), v : i32) -> i32)({
  g := mk(v);
  g()
});
test("a local or comptime slot of a function type returning Impl(Fn)", {
  (h : (fn(x : i32) -> Impl(Fn() -> i32))) = _nim_double;
  g := h(i32(21));
  assert(g() == i32(42), "local annotation");
  assert(_nim_use_ct(_nim_double, i32(6)) == i32(12), "comptime parameter");
});
