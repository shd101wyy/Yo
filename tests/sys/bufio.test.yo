open import "std/libc/stdio";
open import "std/string";
{ Path } :: import "std/path";
{ IOError } :: import "std/sys/errors";
fs_file :: import "std/fs/file";
{ File, OpenMode } :: import "std/fs/file";
fs_dir :: import "std/fs/dir";
{ BufReader } :: import "std/sys/bufio/buf_reader";
{ BufWriter } :: import "std/sys/bufio/buf_writer";
{ temp_dir, path_join } :: import "../helper";

// ============================================================================
// BufReader tests
// ============================================================================

test "BufReader new creates reader", {
  reader := BufReader.new(i32(0));
  assert((reader.fd() == i32(0)), "fd should be 0");
  assert((reader.buffered() == usize(0)), "should have no buffered data");
};

test "BufReader with_capacity creates reader with custom size", {
  reader := BufReader.with_capacity(i32(1), usize(8192));
  assert((reader.fd() == i32(1)), "fd should be 1");
  assert((reader.buffered() == usize(0)), "should have no buffered data");
};

test "BufReader read_line reads single line", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readline_single.txt`));

  io.await(fs_file.write_file(fpath, "hello world\n", using(io)));

  f := io.await(File.open(fpath, .Read, using(io)));
  fd := f.unwrap().fd();
  reader := BufReader.new(fd);

  line := io.await(reader.read_line(using(io)));
  match(line,
    .Ok(.Some(s)) => {
      printf("  line: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `hello world`), "should read the line without newline");
    },
    .Ok(.None) => assert(false, "should not get EOF"),
    .Err(e) => assert(false, "should not get error")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

test "BufReader read_line reads multiple lines", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readline_multi.txt`));

  io.await(fs_file.write_file(fpath, "line1\nline2\nline3\n", using(io)));

  f := io.await(File.open(fpath, .Read, using(io)));
  fd := f.unwrap().fd();
  reader := BufReader.new(fd);

  line1 := io.await(reader.read_line(using(io)));
  match(line1,
    .Ok(.Some(s)) => {
      printf("  line1: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `line1`), "first line should be line1");
    },
    _ => assert(false, "should get line1")
  );

  line2 := io.await(reader.read_line(using(io)));
  match(line2,
    .Ok(.Some(s)) => {
      printf("  line2: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `line2`), "second line should be line2");
    },
    _ => assert(false, "should get line2")
  );

  line3 := io.await(reader.read_line(using(io)));
  match(line3,
    .Ok(.Some(s)) => {
      printf("  line3: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `line3`), "third line should be line3");
    },
    _ => assert(false, "should get line3")
  );

  // Should get EOF
  line4 := io.await(reader.read_line(using(io)));
  match(line4,
    .Ok(.None) => printf("  got EOF correctly\n"),
    _ => assert(false, "should get EOF after all lines")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

test "BufReader read_line handles line without trailing newline", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readline_notrail.txt`));

  io.await(fs_file.write_file(fpath, "no newline at end", using(io)));

  f := io.await(File.open(fpath, .Read, using(io)));
  fd := f.unwrap().fd();
  reader := BufReader.new(fd);

  line := io.await(reader.read_line(using(io)));
  match(line,
    .Ok(.Some(s)) => {
      printf("  line: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `no newline at end`), "should read partial line");
    },
    _ => assert(false, "should get partial line")
  );

  // Now should get EOF
  line2 := io.await(reader.read_line(using(io)));
  match(line2,
    .Ok(.None) => printf("  got EOF correctly\n"),
    _ => assert(false, "should get EOF")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

test "BufReader read_line on empty file returns None", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readline_empty.txt`));

  io.await(fs_file.write_file(fpath, "", using(io)));

  f := io.await(File.open(fpath, .Read, using(io)));
  fd := f.unwrap().fd();
  reader := BufReader.new(fd);

  line := io.await(reader.read_line(using(io)));
  match(line,
    .Ok(.None) => printf("  got None for empty file\n"),
    _ => assert(false, "should get None on empty file")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

test "BufReader read_all reads entire file", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readall.txt`));

  io.await(fs_file.write_file(fpath, "all data here", using(io)));

  f := io.await(File.open(fpath, .Read, using(io)));
  fd := f.unwrap().fd();
  reader := BufReader.new(fd);

  result := io.await(reader.read_all(using(io)));
  match(result,
    .Ok(bytes) => {
      s := String.from_bytes(bytes);
      printf("  read_all: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `all data here`), "should read all data");
    },
    .Err(e) => assert(false, "should not error")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

test "BufReader read_to_string reads entire file as String", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readtostring.txt`));

  io.await(fs_file.write_file(fpath, "string content", using(io)));

  f := io.await(File.open(fpath, .Read, using(io)));
  fd := f.unwrap().fd();
  reader := BufReader.new(fd);

  result := io.await(reader.read_to_string(using(io)));
  match(result,
    .Ok(s) => {
      printf("  content: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `string content`), "should match content");
    },
    .Err(e) => assert(false, "should not error")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

// ============================================================================
// BufWriter tests
// ============================================================================

test "BufWriter new creates writer", {
  writer := BufWriter.new(i32(1));
  assert((writer.fd() == i32(1)), "fd should be 1");
  assert((writer.buffered() == usize(0)), "should have no buffered data");
};

test "BufWriter write and flush", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_write_flush.txt`));

  f := io.await(File.open(fpath, .Write, using(io)));
  fd := f.unwrap().fd();
  writer := BufWriter.new(fd);

  (data : str) = "buffered write test";
  io.await(writer.write(*(u8)(data), u32(usize(19)), using(io)));
  io.await(writer.flush(using(io)));

  // Read back
  content := io.await(fs_file.read_to_string(fpath, using(io)));
  match(content,
    .Ok(s) => {
      printf("  content: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `buffered write test`), "content mismatch");
    },
    .Err(e) => assert(false, "read failed")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

test "BufWriter write_string", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_write_string.txt`));

  f := io.await(File.open(fpath, .Write, using(io)));
  fd := f.unwrap().fd();
  writer := BufWriter.new(fd);

  io.await(writer.write_string(String.from("hello from bufwriter"), using(io)));
  io.await(writer.flush(using(io)));

  content := io.await(fs_file.read_to_string(fpath, using(io)));
  match(content,
    .Ok(s) => {
      printf("  content: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `hello from bufwriter`), "content mismatch");
    },
    .Err(e) => assert(false, "read failed")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

test "BufWriter with small buffer flushes automatically", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_auto_flush.txt`));

  f := io.await(File.open(fpath, .Write, using(io)));
  fd := f.unwrap().fd();
  // Very small buffer (8 bytes)
  writer := BufWriter.with_capacity(fd, usize(8));

  // Write more data than buffer size to trigger auto-flush
  io.await(writer.write_string(String.from("abcdefghijklmnop"), using(io)));
  io.await(writer.flush(using(io)));

  content := io.await(fs_file.read_to_string(fpath, using(io)));
  match(content,
    .Ok(s) => {
      printf("  content: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `abcdefghijklmnop`), "should have all data after auto-flush");
    },
    .Err(e) => assert(false, "read failed")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

// ============================================================================
// BufReader + BufWriter round-trip
// ============================================================================

test "BufWriter then BufReader round-trip", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_roundtrip.txt`));

  // Write with BufWriter
  wf := io.await(File.open(fpath, .Write, using(io)));
  wfd := wf.unwrap().fd();
  writer := BufWriter.new(wfd);
  io.await(writer.write_string(String.from("line one\nline two\nline three\n"), using(io)));
  io.await(writer.flush(using(io)));

  // Read with BufReader
  rf := io.await(File.open(fpath, .Read, using(io)));
  rfd := rf.unwrap().fd();
  reader := BufReader.new(rfd);

  l1 := io.await(reader.read_line(using(io)));
  match(l1,
    .Ok(.Some(s)) => {
      printf("  l1: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `line one`), "first line");
    },
    _ => assert(false, "should get first line")
  );

  l2 := io.await(reader.read_line(using(io)));
  match(l2,
    .Ok(.Some(s)) => {
      printf("  l2: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `line two`), "second line");
    },
    _ => assert(false, "should get second line")
  );

  l3 := io.await(reader.read_line(using(io)));
  match(l3,
    .Ok(.Some(s)) => {
      printf("  l3: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `line three`), "third line");
    },
    _ => assert(false, "should get third line")
  );

  l4 := io.await(reader.read_line(using(io)));
  match(l4,
    .Ok(.None) => printf("  got EOF\n"),
    _ => assert(false, "should get EOF")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};
