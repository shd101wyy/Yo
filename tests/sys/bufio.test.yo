test("BufWriter with small buffer flushes automatically", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_auto_flush.txt`));
  f := io.await(File.open(fpath, .Write, io), IoExn(io : io, exn : exn));
  fd := f.fd();
  // Very small buffer (8 bytes)
  writer := BufWriter.with_capacity(fd, usize(8));
  // Write more data than buffer size to trigger auto-flush
  io.await(writer.write_string(`abcdefghijklmnop`, io), io);
  io.await(writer.flush(io), io);
  content := io.await(fs_file.read_to_string(fpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  content: %s\n", content.to_cstr().ptr().unwrap()));
  assert(content == `abcdefghijklmnop`, "should have all data after auto-flush");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// BufReader + BufWriter round-trip
// ============================================================================
test("BufWriter then BufReader round-trip", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_roundtrip.txt`));
  // Write with BufWriter
  wf := io.await(File.open(fpath, .Write, io), IoExn(io : io, exn : exn));
  wfd := wf.fd();
  writer := BufWriter.new(wfd);
  io.await(writer.write_string(String.from("line one\nline two\nline three\n"), io), io);
  io.await(writer.flush(io), io);
  // Read with BufReader
  rf := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  rfd := rf.fd();
  reader := BufReader.new(rfd);
  l1 := io.await(reader.read_line(io), io);
  match(
    l1,
    .Ok(opt) => {
      match(
        opt,
        .Some(s) => {
          unsafe(printf("  l1: %s\n", s.to_cstr().ptr().unwrap()));
          assert(s == `line one`, "first line");
        },
        .None => assert(false, "should get first line")
      );
    },
    .Err(e) => assert(false, "should get first line")
  );
  l2 := io.await(reader.read_line(io), io);
  match(
    l2,
    .Ok(opt) => {
      match(
        opt,
        .Some(s) => {
          unsafe(printf("  l2: %s\n", s.to_cstr().ptr().unwrap()));
          assert(s == `line two`, "second line");
        },
        .None => assert(false, "should get second line")
      );
    },
    .Err(e) => assert(false, "should get second line")
  );
  l3 := io.await(reader.read_line(io), io);
  match(
    l3,
    .Ok(opt) => {
      match(
        opt,
        .Some(s) => {
          unsafe(printf("  l3: %s\n", s.to_cstr().ptr().unwrap()));
          assert(s == `line three`, "third line");
        },
        .None => assert(false, "should get third line")
      );
    },
    .Err(e) => assert(false, "should get third line")
  );
  l4 := io.await(reader.read_line(io), io);
  match(
    l4,
    .Ok(opt) => {
      match(
        opt,
        .Some(_) => assert(false, "should get EOF"),
        .None => {
          unsafe(printf("  got EOF\n"));
        }
      );
    },
    .Err(e) => assert(false, "should get EOF")
  );
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// BufReader.read tests
// ============================================================================
test("BufReader read returns bytes from file", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_read_bytes.txt`));
  io.await(fs_file.write_string(fpath, String.from("abcde"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  fd := f.fd();
  reader := BufReader.new(fd);
  buf := *(u8)(malloc(usize(10)).unwrap());
  result := io.await(reader.read(buf, u32(5), io), io);
  match(
    result,
    .Ok(n) => {
      unsafe(printf("  read %d bytes\n", n));
      assert(n == i32(5), "should read 5 bytes");
      assert((buf.add(usize(0))).* == u8(97), "first byte should be 'a'");
      assert((buf.add(usize(4))).* == u8(101), "last byte should be 'e'");
    },
    .Err(e) => assert(false, "should not error")
  );
  free(.Some(*(void)(buf)));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
