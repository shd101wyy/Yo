// ============================================================================
// BufWriter tests
// ============================================================================
test("BufWriter new creates writer", {
  writer := BufWriter.new(i32(1));
  assert(writer.fd() == i32(1), "fd should be 1");
  assert(writer.buffered() == usize(0), "should have no buffered data");
});
test("BufWriter write and flush", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_write_flush.txt`));
  f := io.await(File.open(fpath, .Write, io), IoExn(io : io, exn : exn));
  fd := f.fd();
  writer := BufWriter.new(fd);
  data := `buffered write test`;
  data_bytes := data.as_bytes();
  io.await(writer.write(data_bytes.ptr().unwrap(), u32(data_bytes.len()), io), io);
  io.await(writer.flush(io), io);
  // Read back
  content := io.await(fs_file.read_to_string(fpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  content: %s\n", content.to_cstr().ptr().unwrap()));
  assert(content == `buffered write test`, "content mismatch");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
