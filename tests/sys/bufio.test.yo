pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ println } :: import("std/fmt");
{ Path } :: import("std/path");
{ IoError } :: import("std/sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
fs_file :: import("std/fs/file");
{ File, OpenMode } :: import("std/fs/file");
fs_dir :: import("std/fs/dir");
{ BufReader } :: import("std/sys/bufio/buf_reader");
{ BufWriter } :: import("std/sys/bufio/buf_writer");
{ temp_dir, path_join } :: import("../helper");
{ ArrayList } :: import("std/collections/array_list");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
// ============================================================================
// BufReader tests
// ============================================================================
test("BufReader new creates reader", {
  reader := BufReader.new(i32(0));
  assert(reader.fd() == i32(0), "fd should be 0");
  assert(reader.buffered() == usize(0), "should have no buffered data");
});
test("BufReader with_capacity creates reader with custom size", {
  reader := BufReader.with_capacity(i32(1), usize(8192));
  assert(reader.fd() == i32(1), "fd should be 1");
  assert(reader.buffered() == usize(0), "should have no buffered data");
});
test("BufReader read_line reads single line", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readline_single.txt`));
  io.await(fs_file.write_string(fpath, String.from("hello world\n"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  fd := f.fd();
  reader := BufReader.new(fd);
  line := io.await(reader.read_line(io), io);
  match(
    line,
    .Ok(opt) => {
      match(
        opt,
        .Some(s) => {
          unsafe(printf("  line: %s\n", s.to_cstr().ptr().unwrap()));
          assert(s == `hello world`, "should read the line without newline");
        },
        .None => assert(false, "should not get EOF")
      );
    },
    .Err(e) => assert(false, "should not get error")
  );
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("BufReader read_line reads multiple lines", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readline_multi.txt`));
  io.await(fs_file.write_string(fpath, String.from("line1\nline2\nline3\n"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  fd := f.fd();
  reader := BufReader.new(fd);
  line1 := io.await(reader.read_line(io), io);
  match(
    line1,
    .Ok(opt) => {
      match(
        opt,
        .Some(s) => {
          unsafe(printf("  line1: %s\n", s.to_cstr().ptr().unwrap()));
          assert(s == `line1`, "first line should be line1");
        },
        .None => assert(false, "should get line1")
      );
    },
    .Err(e) => assert(false, "should get line1")
  );
  line2 := io.await(reader.read_line(io), io);
  match(
    line2,
    .Ok(opt) => {
      match(
        opt,
        .Some(s) => {
          unsafe(printf("  line2: %s\n", s.to_cstr().ptr().unwrap()));
          assert(s == `line2`, "second line should be line2");
        },
        .None => assert(false, "should get line2")
      );
    },
    .Err(e) => assert(false, "should get line2")
  );
  line3 := io.await(reader.read_line(io), io);
  match(
    line3,
    .Ok(opt) => {
      match(
        opt,
        .Some(s) => {
          unsafe(printf("  line3: %s\n", s.to_cstr().ptr().unwrap()));
          assert(s == `line3`, "third line should be line3");
        },
        .None => assert(false, "should get line3")
      );
    },
    .Err(e) => assert(false, "should get line3")
  );
  // Should get EOF
  line4 := io.await(reader.read_line(io), io);
  match(
    line4,
    .Ok(opt) => {
      match(
        opt,
        .Some(_) => assert(false, "should get EOF after all lines"),
        .None => {
          unsafe(printf("  got EOF correctly\n"));
        }
      );
    },
    .Err(e) => assert(false, "should get EOF after all lines")
  );
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("BufReader read_line handles line without trailing newline", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_bufio_readline_notrail.txt`));
  io.await(fs_file.write_string(fpath, String.from("no newline at end"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
