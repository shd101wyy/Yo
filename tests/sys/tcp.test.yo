pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (TCP sockets unavailable)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (TCP sockets unavailable)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
import("std/string");
{ platform, Platform } :: import("std/process");
tcp :: import("std/sys/tcp");
{ AF_INET, SOCK_STREAM, SOL_SOCKET, SO_REUSEADDR, IPPROTO_TCP, SHUT_RDWR, SO_NOSIGPIPE } :: import("std/sys/socket");
{ sleep } :: import("std/sys/timer");
{ IoFuture } :: import("std/sys/future");
test("TCP socket creation and close", {
  server_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  unsafe(printf("  socket fd = %d\n", server_fd));
  assert(server_fd >= i32(0));
  close_result := io.await(tcp.close(server_fd), io);
  unsafe(printf("  close = %d\n", close_result));
  assert(close_result == i32(0));
});
test("TCP socket creation and close", {
  server_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  unsafe(printf("  socket fd = %d\n", server_fd));
  assert(server_fd >= i32(0));
  close_result := io.await(tcp.close(server_fd), io);
  unsafe(printf("  close = %d\n", close_result));
  assert(close_result == i32(0));
});
test("Set SO_REUSEADDR socket option", {
  server_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  unsafe(printf("  socket fd = %d\n", server_fd));
  assert(server_fd >= i32(0));
  optval := (*u8)(malloc(usize(4)).unwrap());
  (optval.add(usize(0))).* = u8(1);
  (optval.add(usize(1))).* = u8(0);
  (optval.add(usize(2))).* = u8(0);
  (optval.add(usize(3))).* = u8(0);
  sso := io.await(tcp.setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, optval, u32(4)), io);
  unsafe(printf("  setsockopt = %d\n", sso));
  assert(sso == i32(0));
  free(.Some((*void)(optval)));
  close_result := io.await(tcp.close(server_fd), io);
  unsafe(printf("  close = %d\n", close_result));
  assert(close_result == i32(0));
});
test("Bind to loopback and listen", {
  server_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  unsafe(printf("  socket fd = %d\n", server_fd));
  assert(server_fd >= i32(0));
  addr := tcp.make_sockaddr_in_loopback(u16(0));
  bind_result := io.await(tcp.bind(server_fd, addr.buf, addr.len), io);
  unsafe(printf("  bind = %d\n", bind_result));
  assert(bind_result == i32(0));
  listen_result := io.await(tcp.listen(server_fd, i32(128)), io);
  unsafe(printf("  listen = %d\n", listen_result));
  assert(listen_result == i32(0));
  tcp.free_sockaddr(addr);
  close_result := io.await(tcp.close(server_fd), io);
  unsafe(printf("  close = %d\n", close_result));
  assert(close_result == i32(0));
});
test("TCP echo server-client", {
  server_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  unsafe(printf("  server fd = %d\n", server_fd));
  assert(server_fd >= i32(0));
  optval := (*u8)(malloc(usize(4)).unwrap());
  (optval.add(usize(0))).* = u8(1);
  (optval.add(usize(1))).* = u8(0);
  (optval.add(usize(2))).* = u8(0);
  (optval.add(usize(3))).* = u8(0);
  sso := io.await(tcp.setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, optval, u32(4)), io);
  unsafe(printf("  setsockopt = %d\n", sso));
  assert(sso == i32(0));
  free(.Some((*void)(optval)));
  addr := tcp.make_sockaddr_in_loopback(u16(19877));
  bind_result := io.await(tcp.bind(server_fd, addr.buf, addr.len), io);
  unsafe(printf("  bind = %d\n", bind_result));
  assert(bind_result == i32(0));
  listen_result := io.await(tcp.listen(server_fd, i32(128)), io);
  unsafe(printf("  listen = %d\n", listen_result));
  assert(listen_result == i32(0));
  client_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  unsafe(printf("  client fd = %d\n", client_fd));
  assert(client_fd >= i32(0));
  connect_addr := tcp.make_sockaddr_in_loopback(u16(19877));
  conn_result := io.await(tcp.connect(client_fd, connect_addr.buf, connect_addr.len), io);
  unsafe(printf("  connect = %d\n", conn_result));
  assert(conn_result == i32(0));
  tcp.free_sockaddr(connect_addr);
  peer_addr_buf := (*u8)(malloc(usize(128)).unwrap());
  peer_addr_len := (*u32)(malloc(usize(4)).unwrap());
  peer_addr_len.* = u32(128);
  accepted_fd := io.await(tcp.accept(server_fd, peer_addr_buf, peer_addr_len), io);
  unsafe(printf("  accepted fd = %d\n", accepted_fd));
  assert(accepted_fd >= i32(0));
  free(.Some((*void)(peer_addr_buf)));
  free(.Some((*void)(peer_addr_len)));
  msg := (*u8)("Hello TCP!");
  sent := io.await(tcp.send(client_fd, msg, usize(10), i32(0)), io);
  unsafe(printf("  sent = %d\n", sent));
  assert(sent == i32(10));
  recv_buf := (*u8)(malloc(usize(256)).unwrap());
  received := io.await(tcp.recv(accepted_fd, recv_buf, usize(256), i32(0)), io);
  unsafe(printf("  received = %d\n", received));
  assert(received == i32(10));
  unsafe(printf("  verifying message...\n"));
  assert((recv_buf.add(usize(0))).* == u8(72));
  assert((recv_buf.add(usize(1))).* == u8(101));
  assert((recv_buf.add(usize(2))).* == u8(108));
  assert((recv_buf.add(usize(3))).* == u8(108));
  assert((recv_buf.add(usize(4))).* == u8(111));
  free(.Some((*void)(recv_buf)));
  shut := io.await(tcp.shutdown(client_fd, SHUT_RDWR), io);
  unsafe(printf("  shutdown = %d\n", shut));
  c1 := io.await(tcp.close(client_fd), io);
  unsafe(printf("  close client = %d\n", c1));
  assert(c1 == i32(0));
  c2 := io.await(tcp.close(accepted_fd), io);
  unsafe(printf("  close accepted = %d\n", c2));
  assert(c2 == i32(0));
  c3 := io.await(tcp.close(server_fd), io);
  unsafe(printf("  close server = %d\n", c3));
  assert(c3 == i32(0));
  tcp.free_sockaddr(addr);
});
test("SockAddr helper functions", {
  addr1 := tcp.make_sockaddr_in_any(u16(8080));
  port1 := tcp.get_port_in(addr1.buf);
  unsafe(printf("  port = %u\n", port1));
  assert(port1 == u16(8080));
  family1 := tcp.get_family(addr1.buf);
  unsafe(printf("  family = %u\n", family1));
  assert(family1 == u16(AF_INET));
  tcp.free_sockaddr(addr1);
  addr2 := tcp.make_sockaddr_in_loopback(u16(9000));
  port2 := tcp.get_port_in(addr2.buf);
  unsafe(printf("  port = %u\n", port2));
  assert(port2 == u16(9000));
  loopback_addr := tcp.get_addr_in(addr2.buf);
  expected_loopback := tcp.htonl(u32(0x7F000001));
  unsafe(printf("  loopback addr = %u, expected = %u\n", loopback_addr, expected_loopback));
  assert(loopback_addr == expected_loopback);
  tcp.free_sockaddr(addr2);
});
// The stream-write op std/net will use for its own sockets (stage 2 waits for
// the seed): write(2) on macOS once SO_NOSIGPIPE is set, send(MSG_NOSIGNAL) on
// Linux, the ordinary send on Windows. Declared here, not in std/sys/externs,
// because std cannot name a runtime symbol the seed does not emit yet.
extern(
  "Yo",
  __yo_async_stream_write_start : (fn(fd : i32, buf : *u8, len : usize) -> IoFuture)
);
_StreamPair :: struct(server : i32, client : i32, accepted : i32);
_stream_pair :: (fn(port : u16, io : Io) -> _StreamPair)({
  server_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  optval := (*u8)(malloc(usize(4)).unwrap());
  (optval.add(usize(0))).* = u8(1);
  (optval.add(usize(1))).* = u8(0);
  (optval.add(usize(2))).* = u8(0);
  (optval.add(usize(3))).* = u8(0);
  io.await(tcp.setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, optval, u32(4)), io);
  addr := tcp.make_sockaddr_in_loopback(port);
  assert(io.await(tcp.bind(server_fd, addr.buf, addr.len), io) == i32(0));
  assert(io.await(tcp.listen(server_fd, i32(16)), io) == i32(0));
  client_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  assert(io.await(tcp.connect(client_fd, addr.buf, addr.len), io) == i32(0));
  peer := (*u8)(malloc(usize(128)).unwrap());
  peer_len := (*u32)(malloc(usize(4)).unwrap());
  peer_len.* = u32(128);
  accepted_fd := io.await(tcp.accept(server_fd, peer, peer_len), io);
  assert(accepted_fd >= i32(0));
  free(.Some((*void)(peer)));
  free(.Some((*void)(peer_len)));
  if(platform == Platform.Macos, {
    io.await(tcp.setsockopt(client_fd, SOL_SOCKET, SO_NOSIGPIPE, optval, u32(4)), io);
  });
  free(.Some((*void)(optval)));
  tcp.free_sockaddr(addr);
  _StreamPair(server : server_fd, client : client_fd, accepted : accepted_fd)
});
_drain :: (fn(fd : i32, want : i64, io : Io) -> Impl(Future(i64, Io)))(
  io.async((io : Io) => {
    buf := (*u8)(malloc(usize(65536)).unwrap());
    (got : i64) = i64(0);
    while(runtime(got < want), {
      n := io.await(tcp.recv(fd, buf, usize(65536), i32(0)), io);
      if(n <= i32(0), {
        return(got);
      });
      got = (got + i64(n));
    });
    free(.Some((*void)(buf)));
    got
  })
);
test("the stream-write op delivers every byte, parking when the send buffer is full", {
  fds := _stream_pair(u16(19886), io);
  client_fd := fds.client;
  accepted_fd := fds.accepted;
  total := i64(4194304);
  chunk := (*u8)(malloc(usize(65536)).unwrap());
  // The reader starts late, so the 4 MiB cannot all fit in the socket buffers
  // and some writes must park.
  reader := io.spawn(_drain(accepted_fd, total, io), io);
  (sent : i64) = i64(0);
  while(runtime(sent < total), {
    rest := (total - sent);
    want := cond((rest < i64(65536)) => usize(rest), true => usize(65536));
    n := io.await(__yo_async_stream_write_start(client_fd, chunk, want), io);
    assert(n > i32(0), "a stream write to a live peer makes progress");
    sent = (sent + i64(n));
  });
  got := match(reader.await(io), .Some(g) => g, .None => i64(-1));
  assert(got == total, "the reader received every byte, in order of writing");
  free(.Some((*void)(chunk)));
  io.await(tcp.close(client_fd), io);
  io.await(tcp.close(accepted_fd), io);
  io.await(tcp.close(fds.server), io);
});
test("the stream-write op to a closed peer fails with an error instead of SIGPIPE", {
  fds := _stream_pair(u16(19887), io);
  client_fd := fds.client;
  accepted_fd := fds.accepted;
  io.await(tcp.close(accepted_fd), io);
  buf := (*u8)(malloc(usize(1024)).unwrap());
  // The first writes after the peer closes can still be accepted (the RST has
  // not arrived yet): retry a bounded number of times, 2 ms apart.
  (err : i32) = i32(0);
  (i : i32) = i32(0);
  while(runtime((i < i32(50)) && (err == i32(0))), {
    r := io.await(__yo_async_stream_write_start(client_fd, buf, usize(1024)), io);
    if(r < i32(0), {
      err = r;
    });
    io.await(sleep(u64(2)), io);
    i = (i + i32(1));
  });
  assert(err < i32(0), "writing to a closed peer eventually reports an error, and the process is still here");
  free(.Some((*void)(buf)));
  io.await(tcp.close(client_fd), io);
  io.await(tcp.close(fds.server), io);
});
