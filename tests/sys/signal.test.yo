pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Emscripten); // POSIX signals are limited/stubbed in Emscripten WASM
pragma(Pragma.SkipWasm32Wasi); // POSIX signals not available in WASI
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
{ platform, Platform } :: import("std/process");
{ SIGUSR1 } :: import("std/sys/signals");
Sig :: import("std/sys/signal");
signal_handler :: (fn(data : *(u8)) -> unit)({
  ();
});
test("signal handler installs and handles SIGUSR1", {
  cond(
    (platform == Platform.Windows) => {
      r1 := Sig.on_signal(SIGUSR1, signal_handler);
      unsafe(printf("  on_signal (win) = %d\n", r1));
      assert(r1 == i32(0));
      r2 := Sig.kill(i32(0), SIGUSR1);
      unsafe(printf("  kill (win) = %d\n", r2));
      assert(r2 == i32(0));
      r3 := Sig.off_signal(SIGUSR1);
      unsafe(printf("  off_signal (win) = %d\n", r3));
      assert(r3 == i32(0));
    },
    true => {
      open(import("std/libc/unistd"));
      r1 := Sig.on_signal(SIGUSR1, signal_handler);
      unsafe(printf("  on_signal = %d\n", r1));
      assert(r1 == i32(0));
      pid := i32(unsafe(getpid()));
      r2 := Sig.kill(pid, SIGUSR1);
      unsafe(printf("  kill = %d\n", r2));
      assert(r2 == i32(0));
      _ := unsafe(usleep(u32(100000)));
      r3 := Sig.off_signal(SIGUSR1);
      unsafe(printf("  off_signal = %d\n", r3));
      assert(r3 == i32(0));
    }
  );
});
