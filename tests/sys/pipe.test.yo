pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio");
{ platform, Platform } :: import("std/process");
file :: import("std/sys/file");
pipe_io :: import("std/sys/pipe");
fcntl_io :: import("std/sys/fcntl");
{ O_NONBLOCK } :: import("std/sys/constants");
{ sleep } :: import("std/sys/timer");
test("pipe read/write", {
  pipefd_uninit := MaybeUninit(Array(i32, usize(2))).new();
  pipefd := (*i32)(pipefd_uninit.as_ptr());
  pr := pipe_io.pipe(pipefd);
  unsafe(printf("  pipe = %d\n", pr));
  assert(pr == i32(0));
  read_fd := (pipefd.add(usize(0))).*;
  write_fd := (pipefd.add(usize(1))).*;
  assert(read_fd >= i32(0));
  assert(write_fd >= i32(0));
  data := (*u8)("hello pipe");
  data_len := u32(10);
  wr := io.await(file.write(write_fd, data, data_len, u64(0)), io);
  unsafe(printf("  write = %d\n", wr));
  assert(wr == i32(data_len));
  buf_uninit := MaybeUninit(Array(u8, usize(16))).new();
  buf := (*u8)(buf_uninit.as_ptr());
  rd := io.await(file.read(read_fd, buf, u32(16), u64(0)), io);
  unsafe(printf("  read = %d\n", rd));
  assert(rd == i32(data_len));
  assert((buf.add(usize(0))).* == u8(104));
  assert((buf.add(usize(6))).* == u8(112));
  assert((buf.add(usize(9))).* == u8(101));
  c1 := io.await(file.close(read_fd), io);
  c2 := io.await(file.close(write_fd), io);
  assert(c1 == i32(0));
  assert(c2 == i32(0));
});
test("dup reads from original pipe", {
  pipefd_uninit := MaybeUninit(Array(i32, usize(2))).new();
  pipefd := (*i32)(pipefd_uninit.as_ptr());
  pr := pipe_io.pipe(pipefd);
  assert(pr == i32(0));
  read_fd := (pipefd.add(usize(0))).*;
  write_fd := (pipefd.add(usize(1))).*;
  dup_fd := pipe_io.dup(read_fd);
  unsafe(printf("  dup = %d\n", dup_fd));
  assert(dup_fd >= i32(0));
  close_read := io.await(file.close(read_fd), io);
  assert(close_read == i32(0));
  data := (*u8)("dup test");
  data_len := u32(8);
  wr := io.await(file.write(write_fd, data, data_len, u64(0)), io);
  assert(wr == i32(data_len));
  buf_uninit := MaybeUninit(Array(u8, usize(16))).new();
  buf := (*u8)(buf_uninit.as_ptr());
  rd := io.await(file.read(dup_fd, buf, u32(16), u64(0)), io);
  assert(rd == i32(data_len));
  assert((buf.add(usize(0))).* == u8(100));
  assert((buf.add(usize(7))).* == u8(116));
  c1 := io.await(file.close(dup_fd), io);
  c2 := io.await(file.close(write_fd), io);
  assert(c1 == i32(0));
  assert(c2 == i32(0));
});
test("dup2 redirects to target fd", {
  pipefd_a_uninit := MaybeUninit(Array(i32, usize(2))).new();
  pipefd_a := (*i32)(pipefd_a_uninit.as_ptr());
  pr1 := pipe_io.pipe(pipefd_a);
  assert(pr1 == i32(0));
  pipefd_b_uninit := MaybeUninit(Array(i32, usize(2))).new();
  pipefd_b := (*i32)(pipefd_b_uninit.as_ptr());
  pr2 := pipe_io.pipe(pipefd_b);
  assert(pr2 == i32(0));
  read_fd := (pipefd_a.add(usize(0))).*;
  write_fd_src := (pipefd_a.add(usize(1))).*;
  read_fd_b := (pipefd_b.add(usize(0))).*;
  write_fd_dst := (pipefd_b.add(usize(1))).*;
  dup2_fd := pipe_io.dup2(write_fd_src, write_fd_dst);
  unsafe(printf("  dup2 = %d\n", dup2_fd));
  assert(dup2_fd == write_fd_dst);
  c1 := io.await(file.close(write_fd_src), io);
  c2 := io.await(file.close(read_fd_b), io);
  assert(c1 == i32(0));
  assert(c2 == i32(0));
  data := (*u8)("dup2 ok");
  data_len := u32(7);
  wr := io.await(file.write(write_fd_dst, data, data_len, u64(0)), io);
  assert(wr == i32(data_len));
  buf_uninit := MaybeUninit(Array(u8, usize(16))).new();
  buf := (*u8)(buf_uninit.as_ptr());
  rd := io.await(file.read(read_fd, buf, u32(16), u64(0)), io);
  assert(rd == i32(data_len));
  assert((buf.add(usize(0))).* == u8(100));
  assert((buf.add(usize(6))).* == u8(107));
  c3 := io.await(file.close(read_fd), io);
  c4 := io.await(file.close(write_fd_dst), io);
  assert(c3 == i32(0));
  assert(c4 == i32(0));
});
test("two concurrent async reads on one pipe end both complete", {
  // macOS kqueue keeps ONE knote per (fd, filter): before per-(fd,filter)
  // registrations, the second pending read silently re-pointed the knote's
  // udata and orphaned the first — only one task ever completed and the
  // program hung in the event loop forever
  // (issues/fixed/macos-kqueue-concurrent-ops-on-one-fd-orphan-the-earlier-pending-op.md).
  // io_uring (Linux) multiplexes the same program, so Linux runs as the
  // parity check. Windows skips: its setfl does not serve pipe handles.
  cond(
    ((platform == Platform.Macos) || (platform == Platform.Linux)) => {
      pipefd_uninit := MaybeUninit(Array(i32, usize(2))).new();
      pipefd := (*i32)(pipefd_uninit.as_ptr());
      pr := pipe_io.pipe(pipefd);
      assert(pr == i32(0));
      read_fd := (pipefd.add(usize(0))).*;
      write_fd := (pipefd.add(usize(1))).*;
      // The kqueue backend requires non-blocking descriptors for readiness
      // waits (same requirement std/sys/tcp documents for sockets).
      fl := fcntl_io.setfl(read_fd, O_NONBLOCK);
      assert(fl == i32(0));
      buf_a_uninit := MaybeUninit(Array(u8, usize(8))).new();
      buf_a := (*u8)(buf_a_uninit.as_ptr());
      buf_b_uninit := MaybeUninit(Array(u8, usize(8))).new();
      buf_b := (*u8)(buf_b_uninit.as_ptr());
      read_a := Box(i32)(-99);
      read_b := Box(i32)(-99);
      task_a := io.async((io : Io) => {
        n := io.await(file.read(read_fd, buf_a, u32(8), u64(0)), io);
        read_a.* = n;
      });
      task_b := io.async((io : Io) => {
        n := io.await(file.read(read_fd, buf_b, u32(8), u64(0)), io);
        read_b.* = n;
      });
      handle_a := io.spawn(task_a, io);
      handle_b := io.spawn(task_b, io);
      // Let both tasks reach their would-block and register.
      io.await(sleep(u64(20)), io);
      data := (*u8)("hi!\n");
      wr := io.await(file.write(write_fd, data, u32(4), u64(0)), io);
      assert(wr == i32(4));
      io.await(sleep(u64(20)), io);
      // One 4-byte write serves one reader; closing the write end hands the
      // other reader its EOF so BOTH complete.
      cw := io.await(file.close(write_fd), io);
      assert(cw == i32(0));
      ra := handle_a.await(io);
      rb := handle_b.await(io);
      unsafe(printf("  concurrent reads: a=%d b=%d\n", read_a.*, read_b.*));
      assert((read_a.* >= i32(0)) && (read_b.* >= i32(0)));
      assert((read_a.* + read_b.*) == i32(4));
      cr := io.await(file.close(read_fd), io);
      assert(cr == i32(0));
    },
    true => ()
  );
});
