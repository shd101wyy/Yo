pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio");
{ platform, Platform } :: import("std/process");
file :: import("std/sys/file");
pipe_io :: import("std/sys/pipe");
fcntl_io :: import("std/sys/fcntl");
{ O_NONBLOCK } :: import("std/sys/constants");
{ sleep } :: import("std/sys/timer");
{ RefCell } :: import("std/sync/refcell");
{ write, read } :: import("std/libc/unistd");
{ yield, select } :: import("std/async");
{ env } :: import("std/env");
test("pipe read/write", {
  mut(pipefd_uninit) := MaybeUninit(Array(i32, usize(2))).new();
  pipefd := (*i32)(pipefd_uninit.as_ptr());
  pr := pipe_io.pipe(pipefd);
  unsafe(printf("  pipe = %d\n", pr));
  assert(pr == i32(0));
  read_fd := (pipefd.add(usize(0))).*;
  write_fd := (pipefd.add(usize(1))).*;
  assert(read_fd >= i32(0));
  assert(write_fd >= i32(0));
  data := (*u8)("hello pipe");
  data_len := u32(10);
  wr := io.await(file.write(write_fd, data, data_len, u64(0), io), io);
  unsafe(printf("  write = %d\n", wr));
  assert(wr == i32(data_len));
  mut(buf_uninit) := MaybeUninit(Array(u8, usize(16))).new();
  buf := (*u8)(buf_uninit.as_ptr());
  rd := io.await(file.read(read_fd, buf, u32(16), u64(0), io), io);
  unsafe(printf("  read = %d\n", rd));
  assert(rd == i32(data_len));
  assert((buf.add(usize(0))).* == u8(104));
  assert((buf.add(usize(6))).* == u8(112));
  assert((buf.add(usize(9))).* == u8(101));
  c1 := io.await(file.close(read_fd, io), io);
  c2 := io.await(file.close(write_fd, io), io);
  assert(c1 == i32(0));
  assert(c2 == i32(0));
});
test("dup reads from original pipe", {
  mut(pipefd_uninit) := MaybeUninit(Array(i32, usize(2))).new();
  pipefd := (*i32)(pipefd_uninit.as_ptr());
  pr := pipe_io.pipe(pipefd);
  assert(pr == i32(0));
  read_fd := (pipefd.add(usize(0))).*;
  write_fd := (pipefd.add(usize(1))).*;
  dup_fd := pipe_io.dup(read_fd);
  unsafe(printf("  dup = %d\n", dup_fd));
  assert(dup_fd >= i32(0));
  close_read := io.await(file.close(read_fd, io), io);
  assert(close_read == i32(0));
  data := (*u8)("dup test");
  data_len := u32(8);
  wr := io.await(file.write(write_fd, data, data_len, u64(0), io), io);
  assert(wr == i32(data_len));
  mut(buf_uninit) := MaybeUninit(Array(u8, usize(16))).new();
  buf := (*u8)(buf_uninit.as_ptr());
  rd := io.await(file.read(dup_fd, buf, u32(16), u64(0), io), io);
  assert(rd == i32(data_len));
  assert((buf.add(usize(0))).* == u8(100));
  assert((buf.add(usize(7))).* == u8(116));
  c1 := io.await(file.close(dup_fd, io), io);
  c2 := io.await(file.close(write_fd, io), io);
  assert(c1 == i32(0));
  assert(c2 == i32(0));
});
test("dup2 redirects to target fd", {
  mut(pipefd_a_uninit) := MaybeUninit(Array(i32, usize(2))).new();
  pipefd_a := (*i32)(pipefd_a_uninit.as_ptr());
  pr1 := pipe_io.pipe(pipefd_a);
  assert(pr1 == i32(0));
  mut(pipefd_b_uninit) := MaybeUninit(Array(i32, usize(2))).new();
  pipefd_b := (*i32)(pipefd_b_uninit.as_ptr());
  pr2 := pipe_io.pipe(pipefd_b);
  assert(pr2 == i32(0));
  read_fd := (pipefd_a.add(usize(0))).*;
  write_fd_src := (pipefd_a.add(usize(1))).*;
  read_fd_b := (pipefd_b.add(usize(0))).*;
  write_fd_dst := (pipefd_b.add(usize(1))).*;
  dup2_fd := pipe_io.dup2(write_fd_src, write_fd_dst);
  unsafe(printf("  dup2 = %d\n", dup2_fd));
  assert(dup2_fd == write_fd_dst);
  c1 := io.await(file.close(write_fd_src, io), io);
  c2 := io.await(file.close(read_fd_b, io), io);
  assert(c1 == i32(0));
  assert(c2 == i32(0));
  data := (*u8)("dup2 ok");
  data_len := u32(7);
  wr := io.await(file.write(write_fd_dst, data, data_len, u64(0), io), io);
  assert(wr == i32(data_len));
  mut(buf_uninit) := MaybeUninit(Array(u8, usize(16))).new();
  buf := (*u8)(buf_uninit.as_ptr());
  rd := io.await(file.read(read_fd, buf, u32(16), u64(0), io), io);
  assert(rd == i32(data_len));
  assert((buf.add(usize(0))).* == u8(100));
  assert((buf.add(usize(6))).* == u8(107));
  c3 := io.await(file.close(read_fd, io), io);
  c4 := io.await(file.close(write_fd_dst, io), io);
  assert(c3 == i32(0));
  assert(c4 == i32(0));
});
test("two concurrent async reads on one pipe end both complete", {
  // macOS kqueue keeps ONE knote per (fd, filter): before per-(fd,filter)
  // registrations, the second pending read silently re-pointed the knote's
  // udata and orphaned the first — only one task ever completed and the
  // program hung in the event loop forever
  // (issues/fixed/macos-kqueue-concurrent-ops-on-one-fd-orphan-the-earlier-pending-op.md).
  // io_uring (Linux) multiplexes the same program, so Linux runs as the
  // parity check. Windows skips: its setfl does not serve pipe handles.
  cond(
    ((platform == Platform.Macos) || (platform == Platform.Linux)) => {
      mut(pipefd_uninit) := MaybeUninit(Array(i32, usize(2))).new();
      pipefd := (*i32)(pipefd_uninit.as_ptr());
      pr := pipe_io.pipe(pipefd);
      assert(pr == i32(0));
      read_fd := (pipefd.add(usize(0))).*;
      write_fd := (pipefd.add(usize(1))).*;
      // The kqueue backend requires non-blocking descriptors for readiness
      // waits (same requirement std/sys/tcp documents for sockets).
      fl := fcntl_io.setfl(read_fd, O_NONBLOCK);
      assert(fl == i32(0));
      mut(buf_a_uninit) := MaybeUninit(Array(u8, usize(8))).new();
      buf_a := (*u8)(buf_a_uninit.as_ptr());
      mut(buf_b_uninit) := MaybeUninit(Array(u8, usize(8))).new();
      buf_b := (*u8)(buf_b_uninit.as_ptr());
      read_a := Rc.new(RefCell(i32).new(-99));
      read_b := Rc.new(RefCell(i32).new(-99));
      task_a := io.async({ buf_a, read_a : Rc.clone(read_a), read_fd }(io : Io) => {
        n := io.await(file.read(read_fd, buf_a, u32(8), u64(0), io), io);
        read_a.with_mut(cur => {
          cur.* = n;
        });
      });
      task_b := io.async({ buf_b, read_b : Rc.clone(read_b), read_fd }(io : Io) => {
        n := io.await(file.read(read_fd, buf_b, u32(8), u64(0), io), io);
        read_b.with_mut(cur => {
          cur.* = n;
        });
      });
      handle_a := io.spawn(task_a, io);
      handle_b := io.spawn(task_b, io);
      // Let both tasks reach their would-block and register.
      io.await(sleep(u64(20), io), io);
      data := (*u8)("hi!\n");
      wr := io.await(file.write(write_fd, data, u32(4), u64(0), io), io);
      assert(wr == i32(4));
      io.await(sleep(u64(20), io), io);
      // One 4-byte write serves one reader; closing the write end hands the
      // other reader its EOF so BOTH complete.
      cw := io.await(file.close(write_fd, io), io);
      assert(cw == i32(0));
      ra := handle_a.await(io);
      rb := handle_b.await(io);
      unsafe(printf("  concurrent reads: a=%d b=%d\n", read_a.with(cur => cur.*), read_b.with(cur => cur.*)));
      assert((read_a.with(cur => cur.*) >= i32(0)) && (read_b.with(cur => cur.*) >= i32(0)));
      assert((read_a.with(cur => cur.*) + read_b.with(cur => cur.*)) == i32(4));
      cr := io.await(file.close(read_fd, io), io);
      assert(cr == i32(0));
    },
    true => ()
  );
});
// An aborted task's block must outlive the operation it was suspended in.
// The io_uring backend queues its SQEs and submits them at the loop's next
// kernel entry, and cancels by queueing an ASYNC_CANCEL behind them: a READ
// aborted while still queued reaches the kernel FIRST, and with data in the
// pipe it completes right there, into the buffer it was given. The abort had
// released the task's block already, so the kernel wrote into freed memory —
// here into a reused state machine of the same type, whose buffer the second
// task (mode 1) fills and then finds overwritten. AddressSanitizer cannot see
// a kernel write (and turns the state-machine pools off), so this is the
// unsanitized half; tests/sys/socketpair.test.yo's recvfrom case is the
// sanitized one
// (issues/fixed/2026-11-25-an-aborted-tasks-frame-is-released-while-io-uring-can-still-write-into-it.md).
_frame_reader :: (fn(fd : i32, mode : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    mut(b_uninit) := MaybeUninit(Array(u8, usize(256))).new();
    b := (*u8)(b_uninit.as_ptr());
    if(mode == i32(0), {
      n := e.await(file.read(fd, b, u32(256), u64.MAX, e), e);
      n + i32(b.*)
    }, {
      (mut(i) : usize) = usize(0);
      while(i < usize(256), i = (i + usize(1)), {
        (b.add(i)).* = u8(66);
      });
      e.await(yield(e), e);
      e.await(yield(e), e);
      (mut(bad) : i32) = i32(0);
      (mut(j) : usize) = usize(0);
      while(j < usize(256), j = (j + usize(1)), {
        if((b.add(j)).* != u8(66), {
          bad = (bad + i32(1));
        });
      });
      bad
    })
  })
);
_spawn_fill_and_abort :: (fn(rfd : i32, wfd : i32, io : Io) -> unit)({
  h := io.spawn(_frame_reader(rfd, i32(0), io), io);
  unsafe(write(int(wfd), (*void)((*u8)("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")), usize(32)));
  h.abort();
});
_aborted_read_does_not_write_into_a_released_frame :: (fn(io : Io) -> unit)({
  mut(fds_uninit) := MaybeUninit(Array(i32, usize(2))).new();
  fds := (*i32)(fds_uninit.as_ptr());
  assert(pipe_io.pipe(fds) == i32(0), "pipe");
  rfd := fds.*;
  wfd := (fds.add(usize(1))).*;
  assert(fcntl_io.setfl(rfd, fcntl_io.getfl(rfd) | O_NONBLOCK) == i32(0), "nonblocking");
  (mut(bad) : i32) = i32(0);
  (mut(k) : i32) = i32(0);
  while(k < i32(20), k = (k + i32(1)), {
    _spawn_fill_and_abort(rfd, wfd, io);
    bad = (bad + io.await(_frame_reader(rfd, i32(1), io), io));
  });
  assert(bad == i32(0), "no byte of a live task's buffer was overwritten by an aborted read");
  io.await(file.close(rfd, io), io);
  io.await(file.close(wfd, io), io);
});
test("an aborted task's queued read does not write into its released frame", {
  cond(
    ((platform == Platform.Macos) || (platform == Platform.Linux)) => _aborted_read_does_not_write_into_a_released_frame(io),
    true => ()
  );
});
test("an aborted task's queued read does not write into its released frame (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _aborted_read_does_not_write_into_a_released_frame(io);
  });
});
// The same window through a combinator, on a buffer that stays alive: the
// read borrows the CALLER's buffer, and `select` aborts it because the other
// operand completes in the same turn, while its READ is still queued. The
// join inside `select` returned at the abort, so the kernel wrote the pipe's
// bytes into the caller's buffer after `select` had handed it back — visible
// with or without a sanitizer.
_read_into :: (fn(fd : i32, buf : *u8, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => e.await(file.read(fd, buf, u32(256), u64.MAX, e), e))
);
_ready_now :: (fn(io : Io) -> Impl(Future(i32, Io)))(io.async((e : Io) => i32(1)));
_select_loser_read_does_not_write_after_select :: (fn(io : Io) -> unit)({
  mut(fds_uninit) := MaybeUninit(Array(i32, usize(2))).new();
  fds := (*i32)(fds_uninit.as_ptr());
  assert(pipe_io.pipe(fds) == i32(0), "pipe");
  rfd := fds.*;
  wfd := (fds.add(usize(1))).*;
  assert(fcntl_io.setfl(rfd, fcntl_io.getfl(rfd) | O_NONBLOCK) == i32(0), "nonblocking");
  mut(b_uninit) := MaybeUninit(Array(u8, usize(256))).new();
  b := (*u8)(b_uninit.as_ptr());
  mut(d_uninit) := MaybeUninit(Array(u8, usize(4096))).new();
  (mut(bad) : i32) = i32(0);
  (mut(k) : i32) = i32(0);
  while(k < i32(20), k = (k + i32(1)), {
    unsafe(write(int(wfd), (*void)((*u8)("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")), usize(32)));
    _r := io.await(select(_read_into(rfd, b, io), _ready_now(io), io), io);
    (mut(i) : usize) = usize(0);
    while(i < usize(256), i = (i + usize(1)), {
      (b.add(i)).* = u8(66);
    });
    io.await(yield(io), io);
    io.await(yield(io), io);
    (mut(j) : usize) = usize(0);
    while(j < usize(256), j = (j + usize(1)), {
      if((b.add(j)).* != u8(66), {
        bad = (bad + i32(1));
      });
    });
    // Whatever the read did not take stays for the next round: drain it.
    _d := unsafe(read(int(rfd), (*void)((*u8)(d_uninit.as_ptr())), usize(4096)));
  });
  assert(bad == i32(0), "the losing read wrote nothing after select returned");
  io.await(file.close(rfd, io), io);
  io.await(file.close(wfd, io), io);
});
test("a read select aborted while queued does not write after select returns", {
  cond(
    ((platform == Platform.Macos) || (platform == Platform.Linux)) => _select_loser_read_does_not_write_after_select(io),
    true => ()
  );
});
test("a read select aborted while queued does not write after select returns (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _select_loser_read_does_not_write_after_select(io);
  });
});
