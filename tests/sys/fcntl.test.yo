open import "std/libc/stdio";
{ platform, Platform } :: import "std/process";
file :: import "std/sys/file";
pipe_io :: import "std/sys/pipe";
fcntl_io :: import "std/sys/fcntl";

test "fcntl invalid fd returns -EBADF", using(io : IO), {
  ret_getfl := fcntl_io.getfl(i32(-1));
  ret_setfl := fcntl_io.setfl(i32(-1), i32(0));
  ret_getfd := fcntl_io.getfd(i32(-1));
  ret_setfd := fcntl_io.setfd(i32(-1), i32(0));

  printf("  getfl(-1) = %d\n", ret_getfl);
  printf("  setfl(-1) = %d\n", ret_setfl);
  printf("  getfd(-1) = %d\n", ret_getfd);
  printf("  setfd(-1) = %d\n", ret_setfd);

  assert(ret_getfl == i32(-9));
  assert(ret_setfl == i32(-9));
  assert(ret_getfd == i32(-9));
  assert(ret_setfd == i32(-9));
};

test "fcntl setfl toggles O_NONBLOCK on pipe", using(io : IO), {
  pipefd_uninit := MaybeUninit(Array(i32, usize(2))).new();
  pipefd := *(i32)(pipefd_uninit.as_ptr());
  pr := pipe_io.pipe(pipefd);
  assert(pr == i32(0));

  read_fd := (pipefd &+ usize(0)).*;
  write_fd := (pipefd &+ usize(1)).*;

  flags_before := fcntl_io.getfl(read_fd);
  printf("  flags_before = %d\n", flags_before);
  assert(flags_before >= i32(0));

  set_nonblock := fcntl_io.setfl(read_fd, (flags_before | fcntl_io.O_NONBLOCK));
  printf("  set_nonblock = %d\n", set_nonblock);

  flags_after := fcntl_io.getfl(read_fd);
  printf("  flags_after = %d\n", flags_after);

  cond(
    (platform == Platform.Windows) => {
      // Windows uses a different model; setfl is best-effort for non-socket fds.
      assert(((set_nonblock == i32(0)) || (set_nonblock == i32(-38))));
    },
    true => {
      assert(set_nonblock == i32(0));
      assert(((flags_after & fcntl_io.O_NONBLOCK) == fcntl_io.O_NONBLOCK));
    }
  );

  restore := fcntl_io.setfl(read_fd, flags_before);
  cond(
    (platform == Platform.Windows) => {
      assert(((restore == i32(0)) || (restore == i32(-38))));
    },
    true => {
      assert(restore == i32(0));
    }
  );

  c1 := io.await(file.close(read_fd));
  c2 := io.await(file.close(write_fd));
  assert(c1 == i32(0));
  assert(c2 == i32(0));
};

test "fcntl getfd/setfd toggles FD_CLOEXEC", using(io : IO), {
  pipefd_uninit := MaybeUninit(Array(i32, usize(2))).new();
  pipefd := *(i32)(pipefd_uninit.as_ptr());
  pr := pipe_io.pipe(pipefd);
  assert(pr == i32(0));

  read_fd := (pipefd &+ usize(0)).*;
  write_fd := (pipefd &+ usize(1)).*;

  fd_flags_before := fcntl_io.getfd(read_fd);
  printf("  fd_flags_before = %d\n", fd_flags_before);
  assert(fd_flags_before >= i32(0));

  set_cloexec := fcntl_io.setfd(read_fd, (fd_flags_before | fcntl_io.FD_CLOEXEC));
  printf("  set_cloexec = %d\n", set_cloexec);
  assert(set_cloexec == i32(0));

  fd_flags_after := fcntl_io.getfd(read_fd);
  printf("  fd_flags_after = %d\n", fd_flags_after);
  assert(fd_flags_after >= i32(0));

  cond(
    (platform == Platform.Windows) => {
      assert(true);
    },
    true => {
      assert(((fd_flags_after & fcntl_io.FD_CLOEXEC) == fcntl_io.FD_CLOEXEC));
    }
  );

  restore := fcntl_io.setfd(read_fd, fd_flags_before);
  printf("  restore = %d\n", restore);
  assert(restore == i32(0));

  c1 := io.await(file.close(read_fd));
  c2 := io.await(file.close(write_fd));
  assert(c1 == i32(0));
  assert(c2 == i32(0));
};
