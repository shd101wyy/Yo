pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (socketpair unavailable)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (socketpair unavailable)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio");
socketpair_io :: import("std/sys/socketpair");
tcp :: import("std/sys/tcp");
pipe_io :: import("std/sys/pipe");
{ AF_UNIX, SOCK_STREAM } :: import("std/sys/socket");
fcntl :: import("std/sys/fcntl");
{ O_NONBLOCK } :: import("std/sys/constants");
{ write } :: import("std/libc/unistd");
{ env } :: import("std/env");
{ platform, Platform } :: import("std/process");
{ yield } :: import("std/async");
test("socketpair create and close", {
  sv_uninit := MaybeUninit(Array(i32, usize(2))).new();
  sv := (*i32)(sv_uninit.as_ptr());
  sp := socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), sv);
  unsafe(printf("  socketpair = %d\n", sp));
  assert(sp == i32(0), "socketpair should succeed");
  fd0 := (sv.add(usize(0))).*;
  fd1 := (sv.add(usize(1))).*;
  assert(fd0 >= i32(0), "socketpair fd0 should be valid");
  assert(fd1 >= i32(0), "socketpair fd1 should be valid");
  assert(fd0 != fd1, "socketpair fds should be distinct");
  c0 := io.await(tcp.close(fd0), io);
  c1 := io.await(tcp.close(fd1), io);
  assert(c0 == i32(0), "closing socketpair fd0 should succeed");
  assert(c1 == i32(0), "closing socketpair fd1 should succeed");
});
test("socketpair bidirectional send and recv", {
  sv_uninit := MaybeUninit(Array(i32, usize(2))).new();
  sv := (*i32)(sv_uninit.as_ptr());
  sp := socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), sv);
  assert(sp == i32(0), "socketpair should succeed for data exchange");
  fd0 := (sv.add(usize(0))).*;
  fd1 := (sv.add(usize(1))).*;
  msg1 := (*u8)("hello");
  sent1 := io.await(tcp.send(fd0, msg1, usize(5), i32(0)), io);
  assert(sent1 == i32(5), "sending first message should write 5 bytes");
  buf1_uninit := MaybeUninit(Array(u8, usize(16))).new();
  buf1 := (*u8)(buf1_uninit.as_ptr());
  recv1 := io.await(tcp.recv(fd1, buf1, usize(16), i32(0)), io);
  assert(recv1 == i32(5), "receiving first message should read 5 bytes");
  assert((buf1.add(usize(0))).* == u8(104), "first byte should be 'h'");
  assert((buf1.add(usize(4))).* == u8(111), "last byte should be 'o'");
  msg2 := (*u8)("world!");
  sent2 := io.await(tcp.send(fd1, msg2, usize(6), i32(0)), io);
  assert(sent2 == i32(6), "sending second message should write 6 bytes");
  buf2_uninit := MaybeUninit(Array(u8, usize(16))).new();
  buf2 := (*u8)(buf2_uninit.as_ptr());
  recv2 := io.await(tcp.recv(fd0, buf2, usize(16), i32(0)), io);
  assert(recv2 == i32(6), "receiving second message should read 6 bytes");
  assert((buf2.add(usize(0))).* == u8(119), "first byte should be 'w'");
  assert((buf2.add(usize(5))).* == u8(33), "last byte should be '!'");
  c0 := io.await(tcp.close(fd0), io);
  c1 := io.await(tcp.close(fd1), io);
  assert(c0 == i32(0), "closing socketpair fd0 should succeed after transfer");
  assert(c1 == i32(0), "closing socketpair fd1 should succeed after transfer");
});
// The epoll fallback keeps ONE kernel interest per fd: a reader and a writer
// parked on the same socket share it. Before the fix each direction ADDed its
// own interest; the second ADD failed with EEXIST and its MOD replaced the
// first direction's interest, so when the writer drained, the fd was DELeted
// and the parked reader was never woken — this test hung at the last await
// (issues/fixed/epoll-fallback-hangs-when-one-fd-has-a-parked-reader-and-writer.md).
// Linux only: YO_IO_BACKEND picks the Linux backend; each test runs in its own
// process, so pinning it before the first I/O selects epoll for this test.
test("epoll fallback: a parked reader and writer on one fd both complete", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    sv_uninit := MaybeUninit(Array(i32, usize(2))).new();
    sv := (*i32)(sv_uninit.as_ptr());
    assert(socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), sv) == i32(0), "socketpair");
    fd0 := (sv.add(usize(0))).*;
    fd1 := (sv.add(usize(1))).*;
    assert(fcntl.setfl(fd0, fcntl.getfl(fd0) | O_NONBLOCK) == i32(0), "fd0 nonblocking");
    assert(fcntl.setfl(fd1, fcntl.getfl(fd1) | O_NONBLOCK) == i32(0), "fd1 nonblocking");
    // Park a reader on fd0 (nothing to read yet).
    rbuf_uninit := MaybeUninit(Array(u8, usize(16))).new();
    rbuf := (*u8)(rbuf_uninit.as_ptr());
    r_fut := tcp.recv(fd0, rbuf, usize(16), i32(0));
    // Fill fd0's send buffer, then park a writer on the same fd.
    chunk_uninit := MaybeUninit(Array(u8, usize(4096))).new();
    chunk := (*u8)(chunk_uninit.as_ptr());
    (filled : i64) = i64(0);
    (full : bool) = false;
    while(!full, {
      n := i64(unsafe(write(int(fd0), (*void)(chunk), usize(4096))));
      if(n > i64(0), {
        filled = (filled + n);
      }, {
        full = true;
      });
    });
    w_fut := tcp.send(fd0, (*u8)("W"), usize(1), i32(0));
    // Drain from the peer until the writer's byte has arrived: the writer
    // completes only if fd0's EPOLLOUT interest is live.
    big_uninit := MaybeUninit(Array(u8, usize(65536))).new();
    big := (*u8)(big_uninit.as_ptr());
    (got : i64) = i64(0);
    while(got < (filled + i64(1)), {
      n := io.await(tcp.recv(fd1, big, usize(65536), i32(0)), io);
      assert(n > i32(0), "peer drain");
      got = (got + i64(n));
    });
    assert(io.await(w_fut, io) == i32(1), "parked writer completed");
    // Wake the reader: its EPOLLIN interest must have survived the writer.
    assert(io.await(tcp.send(fd1, (*u8)("R"), usize(1), i32(0)), io) == i32(1), "peer send");
    assert(io.await(r_fut, io) == i32(1), "parked reader completed");
    assert(rbuf.* == u8(82), "reader got 'R'");
    io.await(tcp.close(fd0), io);
    io.await(tcp.close(fd1), io);
  });
});
// Closing a descriptor ends the async operations still pending on it: the
// waiter wakes with an error instead of outliving the fd. kqueue and epoll
// purged their parked waiters; the io_uring backend did nothing — a ring
// request holds its own file reference, so the recv stayed pending and this
// test hung at the last await
// (issues/fixed/io-uring-close-leaves-pending-ops-on-the-fd-running.md).
_pending_recv_fails_after_close :: (fn(io : Io) -> unit)({
  sv_uninit := MaybeUninit(Array(i32, usize(2))).new();
  sv := (*i32)(sv_uninit.as_ptr());
  assert(socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), sv) == i32(0), "socketpair");
  fd0 := (sv.add(usize(0))).*;
  fd1 := (sv.add(usize(1))).*;
  assert(fcntl.setfl(fd0, fcntl.getfl(fd0) | O_NONBLOCK) == i32(0), "fd0 nonblocking");
  rbuf_uninit := MaybeUninit(Array(u8, usize(16))).new();
  rbuf := (*u8)(rbuf_uninit.as_ptr());
  r_fut := tcp.recv(fd0, rbuf, usize(16), i32(0));
  io.await(yield(io), io);
  assert(io.await(tcp.close(fd0), io) == i32(0), "close");
  assert(io.await(r_fut, io) < i32(0), "the pending recv fails once its fd is closed");
  io.await(tcp.close(fd1), io);
});
test("closing an fd fails the recv still pending on it", {
  if(platform != Platform.Windows, {
    _pending_recv_fails_after_close(io);
  });
});
test("closing an fd fails the recv still pending on it (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _pending_recv_fails_after_close(io);
  });
});
// An aborted task's pending recv must be CANCELLED, not left running: on the
// io_uring backend it had no cancel path, so the kernel kept it and it
// swallowed the next bytes sent to the socket — the second recv below then
// waited forever for data the aborted task had taken
// (issues/fixed/io-uring-close-leaves-pending-ops-on-the-fd-running.md).
_aborted_recv_leaves_the_data :: (fn(io : Io) -> unit)({
  sv_uninit := MaybeUninit(Array(i32, usize(2))).new();
  sv := (*i32)(sv_uninit.as_ptr());
  assert(socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), sv) == i32(0), "socketpair");
  fd0 := (sv.add(usize(0))).*;
  fd1 := (sv.add(usize(1))).*;
  assert(fcntl.setfl(fd0, fcntl.getfl(fd0) | O_NONBLOCK) == i32(0), "fd0 nonblocking");
  fut := io.async((io : Io) => {
    b_uninit := MaybeUninit(Array(u8, usize(16))).new();
    b := (*u8)(b_uninit.as_ptr());
    return(io.await(tcp.recv(fd0, b, usize(16), i32(0)), io));
  });
  h := io.spawn(fut, io);
  io.await(yield(io), io);
  h.abort();
  assert(match(h.await(io), .Some(_) => false, .None => true), "the recv task was aborted");
  assert(io.await(tcp.send(fd1, (*u8)("X"), usize(1), i32(0)), io) == i32(1), "peer send");
  rbuf_uninit := MaybeUninit(Array(u8, usize(16))).new();
  rbuf := (*u8)(rbuf_uninit.as_ptr());
  assert(io.await(tcp.recv(fd0, rbuf, usize(16), i32(0)), io) == i32(1), "the live recv gets the byte");
  assert(rbuf.* == u8(88), "and it is the byte that was sent");
  io.await(tcp.close(fd0), io);
  io.await(tcp.close(fd1), io);
});
test("an aborted task's pending recv does not swallow later data", {
  if(platform != Platform.Windows, {
    _aborted_recv_leaves_the_data(io);
  });
});
test("an aborted task's pending recv does not swallow later data (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _aborted_recv_leaves_the_data(io);
  });
});
// Both Linux backends try a recv inline before they park it. The inline
// attempt must not overtake a recv already waiting on the same socket: the
// earlier waiter is owed the first bytes. The second recv is started while the
// first is parked.
//   - epoll (like kqueue) completes parked recvs FIFO: the first send lands in
//     the first recv.
//   - io_uring does NOT order concurrent RECVs on one socket (a later RECV's
//     attempt at submission can run before an earlier one's deferred wakeup),
//     so there the contract is only that each byte reaches exactly one recv.
_recvs_in_order :: (fn(io : Io, fifo : bool) -> unit)({
  sv_uninit := MaybeUninit(Array(i32, usize(2))).new();
  sv := (*i32)(sv_uninit.as_ptr());
  assert(socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), sv) == i32(0), "socketpair");
  fd0 := (sv.add(usize(0))).*;
  fd1 := (sv.add(usize(1))).*;
  assert(fcntl.setfl(fd0, fcntl.getfl(fd0) | O_NONBLOCK) == i32(0), "fd0 nonblocking");
  b1_uninit := MaybeUninit(Array(u8, usize(16))).new();
  b1 := (*u8)(b1_uninit.as_ptr());
  b2_uninit := MaybeUninit(Array(u8, usize(16))).new();
  b2 := (*u8)(b2_uninit.as_ptr());
  r1 := tcp.recv(fd0, b1, usize(1), i32(0));
  io.await(yield(io), io);
  r2 := tcp.recv(fd0, b2, usize(1), i32(0));
  assert(io.await(tcp.send(fd1, (*u8)("A"), usize(1), i32(0)), io) == i32(1), "send A");
  if(fifo, {
    assert(io.await(r1, io) == i32(1), "the first recv completes first");
    assert(b1.* == u8(65), "and gets the first byte");
  });
  assert(io.await(tcp.send(fd1, (*u8)("B"), usize(1), i32(0)), io) == i32(1), "send B");
  assert(io.await(r1, io) == i32(1), "the first recv completes");
  assert(io.await(r2, io) == i32(1), "the second recv completes");
  if(fifo, {
    assert(b2.* == u8(66), "the second recv gets the second byte");
  }, {
    sum := (i32(b1.*) + i32(b2.*));
    assert(sum == i32(131), "each byte reached exactly one recv");
    assert(b1.* != b2.*, "no byte was delivered twice");
  });
  io.await(tcp.close(fd0), io);
  io.await(tcp.close(fd1), io);
});
test("a recv started behind a parked recv gets its own bytes", {
  if(platform == Platform.Linux, {
    _recvs_in_order(io, false);
  });
});
test("a recv started behind a parked recv does not overtake it (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _recvs_in_order(io, true);
  });
});
// dup2(other, fd) CLOSES fd first. That close has to reach the async backend
// like any other: a recv parked on fd used to wait forever — the ring's
// request holds its own reference to the old socket, and epoll drops the
// interest with the old file, so neither ever delivered it
// (issues/fixed/dup2-over-a-descriptor-with-a-parked-op-hangs-the-op.md).
// It now fails with -EBADF, and fd works again as the duplicate.
_dup2_over_parked_recv :: (fn(io : Io) -> unit)({
  a_uninit := MaybeUninit(Array(i32, usize(2))).new();
  a := (*i32)(a_uninit.as_ptr());
  b_uninit := MaybeUninit(Array(i32, usize(2))).new();
  b := (*i32)(b_uninit.as_ptr());
  assert(socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), a) == i32(0), "socketpair a");
  assert(socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), b) == i32(0), "socketpair b");
  a0 := (a.add(usize(0))).*;
  a1 := (a.add(usize(1))).*;
  b0 := (b.add(usize(0))).*;
  b1 := (b.add(usize(1))).*;
  assert(fcntl.setfl(a0, fcntl.getfl(a0) | O_NONBLOCK) == i32(0), "a0 nonblocking");
  assert(fcntl.setfl(b0, fcntl.getfl(b0) | O_NONBLOCK) == i32(0), "b0 nonblocking");
  buf_uninit := MaybeUninit(Array(u8, usize(16))).new();
  buf := (*u8)(buf_uninit.as_ptr());
  parked := tcp.recv(a0, buf, usize(16), i32(0));
  io.await(yield(io), io);
  assert(pipe_io.dup2(b0, a0) == a0, "dup2 onto the parked fd");
  r := io.await(parked, io);
  unsafe(printf("  parked recv after dup2 = %d\n", r));
  assert(r == i32(-9), "the parked recv fails with EBADF");
  // a0 is now b0's socket, and must not inherit the old one's registration.
  assert(io.await(tcp.send(b1, (*u8)("Z"), usize(1), i32(0)), io) == i32(1), "send on b");
  assert(io.await(tcp.recv(a0, buf, usize(16), i32(0)), io) == i32(1), "recv through the duplicate");
  assert(buf.* == u8(90), "gets b's byte");
  io.await(tcp.close(a0), io);
  io.await(tcp.close(a1), io);
  io.await(tcp.close(b0), io);
  io.await(tcp.close(b1), io);
});
test("dup2 over a descriptor with a parked recv fails the recv with EBADF", {
  if(platform == Platform.Linux, {
    _dup2_over_parked_recv(io);
  });
});
test("dup2 over a descriptor with a parked recv fails the recv with EBADF (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _dup2_over_parked_recv(io);
  });
});
// A top-level await of an I/O future registers no continuation: when the
// loop's poll completes it, no task runs. The loop step used to block in the
// backend right after that poll whenever other I/O was pending — here a recv
// nobody will ever feed — so the await never returned
// (issues/fixed/a-top-level-await-completed-by-the-io-poll-blocks-on-unrelated-io.md).
_await_completed_by_poll :: (fn(io : Io) -> unit)({
  u_uninit := MaybeUninit(Array(i32, usize(2))).new();
  u := (*i32)(u_uninit.as_ptr());
  p_uninit := MaybeUninit(Array(i32, usize(2))).new();
  p := (*i32)(p_uninit.as_ptr());
  assert(socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), u) == i32(0), "socketpair u");
  assert(socketpair_io.socketpair(AF_UNIX, SOCK_STREAM, i32(0), p) == i32(0), "socketpair p");
  u0 := (u.add(usize(0))).*;
  u1 := (u.add(usize(1))).*;
  p0 := (p.add(usize(0))).*;
  p1 := (p.add(usize(1))).*;
  assert(fcntl.setfl(u0, fcntl.getfl(u0) | O_NONBLOCK) == i32(0), "u0 nonblocking");
  assert(fcntl.setfl(p0, fcntl.getfl(p0) | O_NONBLOCK) == i32(0), "p0 nonblocking");
  ubuf_uninit := MaybeUninit(Array(u8, usize(16))).new();
  ubuf := (*u8)(ubuf_uninit.as_ptr());
  pbuf_uninit := MaybeUninit(Array(u8, usize(16))).new();
  pbuf := (*u8)(pbuf_uninit.as_ptr());
  unrelated := tcp.recv(u0, ubuf, usize(16), i32(0));
  r := tcp.recv(p0, pbuf, usize(16), i32(0));
  io.await(yield(io), io);
  assert(io.await(tcp.send(p1, (*u8)("x"), usize(1), i32(0)), io) == i32(1), "feed r");
  assert(io.await(r, io) == i32(1), "the awaited recv returns");
  // Now end the unrelated recv: closing its fd fails it with EBADF.
  io.await(tcp.close(u0), io);
  assert(io.await(unrelated, io) == i32(-9), "the unrelated recv ends with the close");
  io.await(tcp.close(u1), io);
  io.await(tcp.close(p0), io);
  io.await(tcp.close(p1), io);
});
test("a top-level await completed by the I/O poll returns despite unrelated pending I/O", {
  if(platform != Platform.Windows, {
    _await_completed_by_poll(io);
  });
});
test("a top-level await completed by the I/O poll returns despite unrelated pending I/O (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _await_completed_by_poll(io);
  });
});
