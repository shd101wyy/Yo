pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
open(import("std/string"));
{ platform, Platform } :: import("std/process");
{ O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC, AT_FDCWD } :: import("std/sys/constants");
{ openat, close, read, write, open_sync, close_sync, file_size } :: import("std/sys/file");
{ temp_dir, path_join } :: import("../helper");
test("sync open, file_size, close", {
  (path : *u8) = "tests/fixtures/test_file.txt";
  fd := open_sync(path, O_RDONLY, i32(0));
  unsafe(printf("  fd = %d\n", fd));
  assert(fd >= i32(0));
  sz := file_size(fd);
  unsafe(printf("  size = %lld\n", sz));
  assert(sz > i64(0));
  close_sync(fd);
});
test("sync open nonexistent returns negative errno", {
  (bad_path : *u8) = "/nonexistent/path/file.txt";
  fd := open_sync(bad_path, O_RDONLY, i32(0));
  unsafe(printf("  fd = %d\n", fd));
  assert(fd < i32(0));
});
test("async openat, read, close", {
  async_path := *(u8)("tests/fixtures/test_file.txt");
  open_result := io.await(openat(AT_FDCWD, async_path, O_RDONLY, i32(0)), io);
  unsafe(printf("  openat result = %d\n", open_result));
  assert(open_result >= i32(0));
  afd := open_result;
  buf := *(u8)(malloc(usize(256)).unwrap());
  read_result := io.await(read(afd, buf, u32(256), u64(0)), io);
  unsafe(printf("  read result = %d\n", read_result));
  assert(read_result > i32(0));
  // "Hello from Yo async I/O!\n" - check first 5 bytes: H=72, e=101, l=108, l=108, o=111
  assert((buf.add(usize(0))).* == u8(72));
  assert((buf.add(usize(1))).* == u8(101));
  assert((buf.add(usize(2))).* == u8(108));
  assert((buf.add(usize(3))).* == u8(108));
  assert((buf.add(usize(4))).* == u8(111));
  close_result := io.await(close(afd), io);
  unsafe(printf("  close result = %d\n", close_result));
  assert(close_result == i32(0));
  free(.Some(*(void)(buf)));
});
test("async write and read back", {
  write_open_flags := (O_WRONLY | O_CREAT | O_TRUNC);
  tmp := temp_dir();
  write_path_str := path_join(tmp, `yo_io_file_test.txt`);
  write_path_c := write_path_str.to_cstr();
  write_path := write_path_c.ptr().unwrap();
  open_result := io.await(openat(AT_FDCWD, write_path, write_open_flags, i32(0o644)), io);
  unsafe(printf("  write openat result = %d\n", open_result));
  assert(open_result >= i32(0));
  wfd := open_result;
  data := *(u8)("Hello from Yo file test!");
  write_result := io.await(write(wfd, data, u32(24), u64(0)), io);
  unsafe(printf("  write result = %d\n", write_result));
  assert(write_result == i32(24));
  close1 := io.await(close(wfd), io);
  assert(close1 == i32(0));
  // Read back
  open_result2 := io.await(openat(AT_FDCWD, write_path, O_RDONLY, i32(0)), io);
  assert(open_result2 >= i32(0));
  rfd := open_result2;
  buf := *(u8)(malloc(usize(64)).unwrap());
  read_result := io.await(read(rfd, buf, u32(64), u64(0)), io);
  unsafe(printf("  read back result = %d\n", read_result));
  assert(read_result == i32(24));
  // Check: H=72, space=32 after "Hello", f=102
  assert((buf.add(usize(0))).* == u8(72));
  assert((buf.add(usize(5))).* == u8(32));
  assert((buf.add(usize(6))).* == u8(102));
  close2 := io.await(close(rfd), io);
  assert(close2 == i32(0));
  free(.Some(*(void)(buf)));
});
