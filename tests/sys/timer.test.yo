pragma(Pragma.SkipWasm32Wasi);
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ sleep } :: import("std/sys/timer");
{ printf } :: import("std/libc/stdio");
{ yield } :: import("std/async");
{ ArrayList } :: import("std/collections/array_list");
{ env } :: import("std/env");
{ platform, Platform } :: import("std/process");
test("Test Io timer", {
  // =========================================================================
  // Test: async timer operations
  // =========================================================================
  value := Rc(i32)(0);
  task1 := io.async((io : Io) => {
    assert(value.* == 0); // 0
    value.* = (value.* + 1); // 1
    unsafe(printf("Timer test: sleeping 50ms...\n"));
    result := io.await(sleep(u64(50)), io);
    unsafe(printf("Timer test: woke up with result=%d\n", result));
    assert(result > i32(0));
    assert(value.* == 3); // yield() resumed block2 first, which set it to 3
    value.* = (value.* + 1); // 4
    unsafe(printf("Timer test: sleeping 3000ms...\n"));
    result2 := io.await(sleep(u64(3000)), io);
    unsafe(printf("Timer test: woke up with result=%d\n", result2));
    assert(result2 > i32(0));
    assert(value.* == 4); // 4
    unsafe(printf("All async timer tests passed!\n"));
  });
  task2 := io.async((io : Io) => {
    assert(value.* == 1); // 1
    value.* = (value.* + 1); // 2
    io.await(yield(io), io);
    assert(value.* == 2); // yield() resumes before sleep(50ms), nobody changed it
    value.* = (value.* + 1); // 3
  });
  io.spawn(task1, io);
  io.spawn(task2, io);
  io.await(task1, io);
  io.await(task2, io);
});
test("Test zero-length sleep completes", {
  // sleep(0) must complete on the next loop turn on every runtime. Linux's
  // timerfd variant regressed this: POSIX defines a zero it_value as
  // DISARMING the timer, so the io_uring read never completed and the awaiter
  // parked forever (issues/fixed/sleep-zero-disarms-linux-timerfd.md).
  r0 := io.await(sleep(u64(0)), io);
  assert(r0 >= i32(0), "sleep(0) awaited from a plain context should complete without error");
  inner := Rc(bool)(false);
  t := io.async((io : Io) => {
    r1 := io.await(sleep(u64(0)), io);
    assert(r1 >= i32(0), "sleep(0) awaited inside a task should complete without error");
    inner.* = true;
  });
  io.spawn(t, io);
  io.await(t, io);
  assert(inner.*, "the zero-sleep task body should have run to completion");
});
// io_uring submission is deferred to the loop's next poll, so a single tick
// that starts more operations than the ring has SQ entries (1024) used to run
// out of slots: every operation past the 1,024th completed at once with
// -EAGAIN (issues/fixed/io-uring-full-submission-queue-fails-operations-with-eagain.md).
// 1,500 spawned tasks each start one sleep: the tasks all run in ONE drain of
// the ready queue, so every start lands in the same tick.
_one_sleep :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    r := io.await(sleep(u64(1)), io);
    r
  })
);
_many_sleeps_in_one_tick :: (fn(io : Io) -> unit)({
  hs := ArrayList(JoinHandle(i32)).new();
  (i : usize) = usize(0);
  while(i < usize(1500), i = (i + usize(1)), {
    hs.push(io.spawn(_one_sleep(io), io));
  });
  (ok : usize) = usize(0);
  i = usize(0);
  while(i < hs.len(), i = (i + usize(1)), {
    r := match(hs(i).await(io), .Some(v) => v, .None => i32(-1));
    if(r > i32(0), {
      ok = (ok + usize(1));
    });
  });
  unsafe(printf("  %zu of 1500 sleeps completed\n", ok));
  assert(ok == usize(1500), "every sleep started in one tick completes with success");
});
test("1500 sleeps started in one tick all complete", {
  _many_sleeps_in_one_tick(io);
});
test("1500 sleeps started in one tick all complete (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _many_sleeps_in_one_tick(io);
  });
});
// Timers complete in deadline order, and aborting one in the middle of the
// set releases it without disturbing the rest — the epoll fallback's timer
// heap removes it from the middle of the heap (a timerfd per sleep before).
// An `Rc`: the caller and the spawned task share the list on purpose, and a
// task captures by value (plans/VALUES_BY_DEFAULT.md §3.13).
_sleeper :: (fn(ms : i32, imm(order) : Rc(ArrayList(i32)), io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    _r := io.await(sleep(u64(ms)), io);
    order.*.push(ms);
    i32(0)
  })
);
_timer_order :: (fn(io : Io) -> unit)({
  order := rc(ArrayList(i32).new());
  h60 := io.spawn(_sleeper(i32(60), order, io), io);
  h20 := io.spawn(_sleeper(i32(20), order, io), io);
  h30 := io.spawn(_sleeper(i32(30), order, io), io);
  h40 := io.spawn(_sleeper(i32(40), order, io), io);
  io.await(yield(io), io);
  h30.abort();
  _a := h60.await(io);
  _b := h20.await(io);
  assert(match(h30.await(io), .Some(_) => false, .None => true), "the aborted sleeper never finished");
  _d := h40.await(io);
  assert(order.*.len() == usize(3), "three sleepers finished");
  assert((order.*)(usize(0)) == i32(20), "20 ms first");
  assert((order.*)(usize(1)) == i32(40), "then 40 ms");
  assert((order.*)(usize(2)) == i32(60), "then 60 ms");
});
test("timers fire in deadline order around an aborted one", {
  _timer_order(io);
});
test("timers fire in deadline order around an aborted one (epoll fallback)", {
  if(platform == Platform.Linux, {
    env.set("YO_IO_BACKEND", "epoll");
    _timer_order(io);
  });
});
// A sleep future bound to a local and dropped at scope end before it fires:
// the drop must not free what the backend still holds. The kqueue backend kept
// a bare pointer to the future in its EVFILT_TIMER context, so the timer fired
// into freed memory and the process crashed (SIGSEGV, every run). The timer
// heap now holds its own reference until the timer fires or is cancelled, as
// Linux's backends and Windows' timer list do
// (issues/fixed/pending-io-future-local-drop-uaf.md).
_drop_an_armed_sleep :: (fn(io : Io) -> bool)({
  deadline := sleep(u64(5));
  s := io.state(deadline);
  s == FutureState.Completed
});
test("a sleep future dropped before it fires does not fire into freed memory", {
  (i : i32) = i32(0);
  while(i < i32(50), i = (i + i32(1)), {
    _b := _drop_an_armed_sleep(io);
  });
  io.await(sleep(u64(30)), io);
  assert(true, "all 50 dropped sleeps fired without touching freed memory");
});
