pragma(Pragma.SkipWasm32Wasi);
{ assert } :: import("std/assert");
constants :: import("std/sys/constants");
socket :: import("std/sys/socket");
signals :: import("std/sys/signals");
events :: import("std/sys/events");
{ IoError } :: import("std/sys/errors");
{ platform, Platform } :: import("std/process");
test("Test Io constants", {
  // =========================================================================
  // Test: module structure and constant imports
  // =========================================================================
  // File mode constants
  assert(constants.S_IFREG == u32(0o100000));
  assert(constants.S_IFDIR == u32(0o040000));
  assert(constants.DEFAULT_FILE_MODE == u32(0o644));
  assert(constants.DEFAULT_DIR_MODE == u32(0o755));
  // AT_* flags
  cond(
    (platform == Platform.Macos) => assert(constants.AT_FDCWD == i32(-2)),
    true => assert(constants.AT_FDCWD == i32(-100))
  );
  // Access mode constants
  assert(constants.F_OK == i32(0));
  assert(constants.R_OK == i32(4));
  assert(constants.W_OK == i32(2));
  assert(constants.X_OK == i32(1));
  // DT_* directory entry types
  assert(constants.DT_REG == u8(8));
  assert(constants.DT_DIR == u8(4));
  assert(constants.DT_LNK == u8(10));
  // Socket constants - platform-aware
  assert(socket.AF_INET == i32(2));
  assert(socket.AF_UNIX == i32(1));
  assert(socket.SOCK_STREAM == i32(1));
  assert(socket.SOCK_DGRAM == i32(2));
  assert(socket.SHUT_RD == i32(0));
  assert(socket.SHUT_WR == i32(1));
  assert(socket.SHUT_RDWR == i32(2));
  // Platform-specific socket constants
  cond(
    (platform == Platform.Macos) => {
      assert(socket.AF_INET6 == i32(30));
      assert(socket.SOL_SOCKET == i32(0xFFFF));
    },
    (platform == Platform.Linux) => {
      assert(socket.AF_INET6 == i32(10));
      assert(socket.SOL_SOCKET == i32(1));
    },
    true => ()
  );
  // Signal constants
  assert(signals.SIGINT == i32(2));
  assert(signals.SIGTERM == i32(15));
  assert(signals.SIGKILL == i32(9));
  // Platform-specific signal constants
  cond(
    (platform == Platform.Macos) => {
      assert(signals.SIGCHLD == i32(20));
      assert(signals.SIGCONT == i32(19));
      assert(signals.SIGSTOP == i32(17));
      assert(signals.SIGTSTP == i32(18));
    },
    (platform == Platform.Linux) => {
      assert(signals.SIGCHLD == i32(17));
      assert(signals.SIGCONT == i32(18));
      assert(signals.SIGSTOP == i32(19));
      assert(signals.SIGTSTP == i32(20));
    },
    true => ()
  );
  // Event constants
  assert(events.TTY_MODE_NORMAL == i32(0));
  assert(events.TTY_MODE_RAW == i32(1));
  assert(events.POLL_READABLE == i32(1));
  assert(events.POLL_WRITABLE == i32(2));
  // IoError
  { ENOENT } :: import("std/libc/errno");
  err := IoError.from_errno(i32(ENOENT));
  match(
    err,
    .NotFound => assert(true, "IoError.from_errno(ENOENT) should be NotFound"),
    _ => assert(false, "IoError.from_errno(ENOENT) should be NotFound")
  );
});
