pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ platform, Platform } :: import("std/process");
{ temp_dir, path_join } :: import("../helper");
dir :: import("std/sys/dir");
file :: import("std/sys/file");
{ AT_FDCWD, AT_REMOVEDIR, O_RDONLY, O_DIRECTORY } :: import("std/sys/constants");
temp_io :: import("std/sys/temp");
test("mkdtemp creates and removes directory", {
  tmp := temp_dir();
  template_str := path_join(tmp, `yo_io_mkdtemp_XXXXXX`);
  template_c := template_str.to_cstr();
  template_path := template_c.ptr().unwrap();
  mk := temp_io.mkdtemp(template_path);
  unsafe(printf("  mkdtemp = %d\n", mk));
  assert(mk == i32(0));
  open_flags := (O_RDONLY | O_DIRECTORY);
  open_dir := io.await(file.openat(AT_FDCWD, template_path, open_flags, i32(0)), io);
  unsafe(printf("  open dir = %d\n", open_dir));
  assert(open_dir >= i32(0));
  io.await(file.close(open_dir), io);
  rm := io.await(dir.unlink(AT_FDCWD, template_path, AT_REMOVEDIR), io);
  unsafe(printf("  rmdir = %d\n", rm));
  assert(rm == i32(0));
});
test("mkstemp creates and removes file", {
  tmp := temp_dir();
  template_str := path_join(tmp, `yo_io_mkstemp_XXXXXX`);
  template_c := template_str.to_cstr();
  template_path := template_c.ptr().unwrap();
  fd := temp_io.mkstemp(template_path);
  unsafe(printf("  mkstemp = %d\n", fd));
  assert(fd >= i32(0));
  close_result := io.await(file.close(fd), io);
  assert(close_result == i32(0));
  rm := io.await(dir.unlink(AT_FDCWD, template_path, i32(0)), io);
  unsafe(printf("  unlink = %d\n", rm));
  assert(rm == i32(0));
});
