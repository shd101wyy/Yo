pragma(Pragma.SkipWasm32Emscripten); // no inotify/kqueue in WASM (filesystem event watching unavailable)
pragma(Pragma.SkipWasm32Wasi); // no inotify/kqueue in WASM (filesystem event watching unavailable)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio");
import("std/string");
{ temp_dir, path_join } :: import("../helper");
events :: import("std/sys/events");
file :: import("std/sys/file");
dir :: import("std/sys/dir");
{ sleep } :: import("std/sys/timer");
{ AT_FDCWD, AT_REMOVEDIR, O_CREAT, O_WRONLY, O_TRUNC } :: import("std/sys/constants");
{ platform, Platform } :: import("std/process");
// Callback that records event type into user_data (pointer to i32)
on_fs_event_record :: (fn(path : *u8, events_mask : i32, user_data : *u8) -> unit)({
  ptr := (*i32)(user_data);
  ptr.* = (ptr.* | events_mask);
  unsafe(printf("  fs_event callback: path=%s events=%d\n", path, events_mask));
});
test("fs_event init/start/stop", {
  handle := events.fs_event_init();
  dir_str := temp_dir();
  dir_c := dir_str.to_cstr();
  dir_path := dir_c.ptr().unwrap();
  result_buf := MaybeUninit(i32).new();
  result_ptr := (*i32)(result_buf.as_ptr());
  result_ptr.* = i32(0);
  ret := events.fs_event_start(handle, dir_path, events.FS_EVENT_WATCH_ENTRY, on_fs_event_record, (*u8)(result_ptr));
  assert(ret == i32(0), "fs_event_start failed");
  stop_ret := events.fs_event_stop(handle);
  assert(stop_ret == i32(0), "fs_event_stop failed");
  events.fs_event_close(handle);
});
test("fs_event detects file creation", {
  dir_str := temp_dir();
  test_file := path_join(dir_str, `yo_test_fs_event_create.txt`);
  test_file_c := test_file.to_cstr();
  test_file_path := test_file_c.ptr().unwrap();
  // Clean up from previous runs
  io.await(dir.unlink(AT_FDCWD, test_file_path, i32(0)), io);
  dir_c := dir_str.to_cstr();
  dir_path := dir_c.ptr().unwrap();
  result_buf := MaybeUninit(i32).new();
  result_ptr := (*i32)(result_buf.as_ptr());
  result_ptr.* = i32(0);
  handle := events.fs_event_init();
  ret := events.fs_event_start(handle, dir_path, events.FS_EVENT_WATCH_ENTRY, on_fs_event_record, (*u8)(result_ptr));
  assert(ret == i32(0), "fs_event_start failed");
  // Create a file in the watched directory
  fd := io.await(file.openat(AT_FDCWD, test_file_path, O_CREAT | (O_WRONLY | O_TRUNC), i32(0o644)), io);
  assert(fd >= i32(0), "open failed");
  msg := (*u8)("test content");
  wr := io.await(file.write(fd, msg, u32(12), u64(0)), io);
  assert(wr == i32(12), "write failed");
  cr := io.await(file.close(fd), io);
  assert(cr == i32(0), "close failed");
  // Wait for inotify events to arrive
  io.await(sleep(u64(200)), io);
  recorded := result_ptr.*;
  unsafe(printf("  recorded events: %d\n", recorded));
  // On Linux with inotify, creating a file triggers IN_CREATE (→ RENAME=1)
  // and writing triggers IN_MODIFY (→ CHANGE=2)
  assert(recorded != i32(0), "expected fs events after file creation");
  stop_ret := events.fs_event_stop(handle);
  assert(stop_ret == i32(0), "fs_event_stop failed");
  events.fs_event_close(handle);
  // Cleanup
  io.await(dir.unlink(AT_FDCWD, test_file_path, i32(0)), io);
});
test("fs_event detects file modification", {
  dir_str := temp_dir();
  test_file := path_join(dir_str, `yo_test_fs_event_modify.txt`);
  test_file_c := test_file.to_cstr();
  test_file_path := test_file_c.ptr().unwrap();
  // Create the file first
  fd1 := io.await(file.openat(AT_FDCWD, test_file_path, O_CREAT | (O_WRONLY | O_TRUNC), i32(0o644)), io);
  assert(fd1 >= i32(0), "initial open failed");
  init_msg := (*u8)("initial");
  wr1 := io.await(file.write(fd1, init_msg, u32(7), u64(0)), io);
  assert(wr1 == i32(7), "initial write failed");
  cr1 := io.await(file.close(fd1), io);
  assert(cr1 == i32(0), "initial close failed");
  // Wait a bit for the initial writes to settle
  io.await(sleep(u64(100)), io);
  dir_c := dir_str.to_cstr();
  dir_path := dir_c.ptr().unwrap();
  result_buf := MaybeUninit(i32).new();
  result_ptr := (*i32)(result_buf.as_ptr());
  result_ptr.* = i32(0);
  handle := events.fs_event_init();
  ret := events.fs_event_start(handle, dir_path, events.FS_EVENT_WATCH_ENTRY, on_fs_event_record, (*u8)(result_ptr));
  assert(ret == i32(0), "fs_event_start failed");
  // Now modify the file
  fd2 := io.await(file.openat(AT_FDCWD, test_file_path, O_WRONLY, i32(0)), io);
  assert(fd2 >= i32(0), "modify open failed");
  mod_msg := (*u8)("modified content");
  wr2 := io.await(file.write(fd2, mod_msg, u32(16), u64(0)), io);
  assert(wr2 == i32(16), "modify write failed");
  cr2 := io.await(file.close(fd2), io);
  assert(cr2 == i32(0), "modify close failed");
  io.await(sleep(u64(200)), io);
  recorded := result_ptr.*;
  unsafe(printf("  recorded events: %d\n", recorded));
  assert((recorded & events.FS_EVENT_CHANGE) != i32(0), "expected FS_EVENT_CHANGE after modification");
  stop_ret := events.fs_event_stop(handle);
  assert(stop_ret == i32(0), "fs_event_stop failed");
  events.fs_event_close(handle);
  // Cleanup
  io.await(dir.unlink(AT_FDCWD, test_file_path, i32(0)), io);
});
test("fs_event stop prevents further callbacks", {
  dir_str := temp_dir();
  test_file := path_join(dir_str, `yo_test_fs_event_stopped.txt`);
  test_file_c := test_file.to_cstr();
  test_file_path := test_file_c.ptr().unwrap();
  // Clean up from previous runs
  io.await(dir.unlink(AT_FDCWD, test_file_path, i32(0)), io);
  dir_c := dir_str.to_cstr();
  dir_path := dir_c.ptr().unwrap();
  result_buf := MaybeUninit(i32).new();
  result_ptr := (*i32)(result_buf.as_ptr());
  result_ptr.* = i32(0);
  handle := events.fs_event_init();
  ret := events.fs_event_start(handle, dir_path, events.FS_EVENT_WATCH_ENTRY, on_fs_event_record, (*u8)(result_ptr));
  assert(ret == i32(0), "fs_event_start failed");
  // Stop immediately
  stop_ret := events.fs_event_stop(handle);
  assert(stop_ret == i32(0), "fs_event_stop failed");
  // Now create a file - callback should NOT fire
  fd := io.await(file.openat(AT_FDCWD, test_file_path, O_CREAT | (O_WRONLY | O_TRUNC), i32(0o644)), io);
  assert(fd >= i32(0), "open failed");
  msg := (*u8)("data");
  wr := io.await(file.write(fd, msg, u32(4), u64(0)), io);
  assert(wr == i32(4), "write failed");
  cr := io.await(file.close(fd), io);
  assert(cr == i32(0), "close failed");
  io.await(sleep(u64(200)), io);
  recorded := result_ptr.*;
  unsafe(printf("  after stop, recorded: %d (expect 0)\n", recorded));
  assert(recorded == i32(0), "callback should not fire after stop");
  events.fs_event_close(handle);
  // Cleanup
  io.await(dir.unlink(AT_FDCWD, test_file_path, i32(0)), io);
});
test("fs_event detects file deletion", {
  dir_str := temp_dir();
  test_file := path_join(dir_str, `yo_test_fs_event_delete.txt`);
  test_file_c := test_file.to_cstr();
  test_file_path := test_file_c.ptr().unwrap();
  // Create the file first
  fd := io.await(file.openat(AT_FDCWD, test_file_path, O_CREAT | (O_WRONLY | O_TRUNC), i32(0o644)), io);
  assert(fd >= i32(0), "create failed");
  cr := io.await(file.close(fd), io);
  assert(cr == i32(0), "close failed");
  io.await(sleep(u64(100)), io);
  dir_c := dir_str.to_cstr();
  dir_path := dir_c.ptr().unwrap();
  result_buf := MaybeUninit(i32).new();
  result_ptr := (*i32)(result_buf.as_ptr());
  result_ptr.* = i32(0);
  handle := events.fs_event_init();
  ret := events.fs_event_start(handle, dir_path, events.FS_EVENT_WATCH_ENTRY, on_fs_event_record, (*u8)(result_ptr));
  assert(ret == i32(0), "fs_event_start failed");
  // Delete the file
  io.await(dir.unlink(AT_FDCWD, test_file_path, i32(0)), io);
  io.await(sleep(u64(200)), io);
  recorded := result_ptr.*;
  unsafe(printf("  recorded events: %d\n", recorded));
  // IN_DELETE maps to FS_EVENT_RENAME (1)
  assert((recorded & events.FS_EVENT_RENAME) != i32(0), "expected FS_EVENT_RENAME after deletion");
  stop_ret := events.fs_event_stop(handle);
  assert(stop_ret == i32(0), "fs_event_stop failed");
  events.fs_event_close(handle);
});

// Callback that COUNTS events (one tick per callback) for the spam tests.
on_fs_event_count :: (fn(path : *u8, events_mask : i32, user_data : *u8) -> unit)({
  ptr := (*i32)(user_data);
  ptr.* = (ptr.* + 1);
});

test("a deleted watch directory reports the deletion once, not on every tick", {
  // The macOS snapshot diff used to re-report the vanished directory on
  // every tick — a rename event roughly every 10 ms, forever
  // (issues/fixed/macos-fs-event-deleted-directory-fires-rename-every-tick.md).
  // inotify reports the deletion once, so Linux shares the no-spam
  // assertion; the recreate check is macOS-only because an inotify watch
  // dies with its directory. Windows has its own backend and skips.
  cond(
    ((platform == Platform.Macos) || (platform == Platform.Linux)) => {
      dir_str := temp_dir();
      watch := path_join(dir_str, `yo_fs_event_deleted_dir`);
      watch_c := watch.to_cstr();
      watch_path := watch_c.ptr().unwrap();
      // Clean up any leftover from a previous run, then create fresh.
      io.await(dir.unlink(AT_FDCWD, watch_path, AT_REMOVEDIR), io);
      mk := io.await(dir.mkdir(AT_FDCWD, watch_path, i32(0o755)), io);
      assert(mk == i32(0));
      count_buf := MaybeUninit(i32).new();
      count_ptr := (*i32)(count_buf.as_ptr());
      count_ptr.* = i32(0);
      handle := events.fs_event_init();
      ret := events.fs_event_start(handle, watch_path, events.FS_EVENT_WATCH_ENTRY, on_fs_event_count, (*u8)(count_ptr));
      assert(ret == i32(0));
      io.await(sleep(u64(150)), io);
      assert(count_ptr.* == i32(0), "quiet watch must report nothing");
      rm := io.await(dir.unlink(AT_FDCWD, watch_path, AT_REMOVEDIR), io);
      assert(rm == i32(0));
      io.await(sleep(u64(300)), io);
      after_delete := count_ptr.*;
      unsafe(printf("  callbacks after delete: %d\n", after_delete));
      assert(after_delete >= i32(1), "the deletion must be reported");
      io.await(sleep(u64(300)), io);
      assert(count_ptr.* == after_delete, "the deletion must not re-report every tick");
      cond(
        (platform == Platform.Macos) => {
          // The snapshot watch survives the delete: a recreated directory
          // reports the recreation.
          mk2 := io.await(dir.mkdir(AT_FDCWD, watch_path, i32(0o755)), io);
          assert(mk2 == i32(0));
          io.await(sleep(u64(300)), io);
          unsafe(printf("  callbacks after recreate: %d\n", count_ptr.*));
          assert(count_ptr.* > after_delete, "the recreation must be reported");
        },
        true => ()
      );
      events.fs_event_stop(handle);
      events.fs_event_close(handle);
      io.await(dir.unlink(AT_FDCWD, watch_path, AT_REMOVEDIR), io);
    },
    true => ()
  );
});
