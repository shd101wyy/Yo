pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
file :: import("std/sys/file");
copy_io :: import("std/sys/copy");
dir :: import("std/sys/dir");
{ AT_FDCWD, O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC } :: import("std/sys/constants");
{ temp_dir, path_join } :: import("../helper");
test("copyfile copies file contents", {
  tmp := temp_dir();
  src_path_str := path_join(tmp, `yo_io_copy_src.txt`);
  dst_path_str := path_join(tmp, `yo_io_copy_dst.txt`);
  src_path_c := src_path_str.to_cstr();
  dst_path_c := dst_path_str.to_cstr();
  src_path := src_path_c.ptr().unwrap();
  dst_path := dst_path_c.ptr().unwrap();
  io.await(dir.unlink(AT_FDCWD, dst_path, i32(0)), io);
  io.await(dir.unlink(AT_FDCWD, src_path, i32(0)), io);
  write_flags := (O_WRONLY | O_CREAT | O_TRUNC);
  src_fd := io.await(file.openat(AT_FDCWD, src_path, write_flags, i32(0o644)), io);
  assert(src_fd >= i32(0));
  data := *(u8)("copyfile data");
  data_len := u32(13);
  wr := io.await(file.write(src_fd, data, data_len, u64(0)), io);
  assert(wr == i32(data_len));
  c1 := io.await(file.close(src_fd), io);
  assert(c1 == i32(0));
  cr := copy_io.copyfile(src_path, dst_path, i32(0));
  unsafe(printf("  copyfile = %d\n", cr));
  assert(cr == i32(0));
  dst_fd := io.await(file.openat(AT_FDCWD, dst_path, O_RDONLY, i32(0)), io);
  assert(dst_fd >= i32(0));
  buf_uninit := MaybeUninit(Array(u8, usize(32))).new();
  buf := *(u8)(buf_uninit.as_ptr());
  rd := io.await(file.read(dst_fd, buf, u32(32), u64(0)), io);
  assert(rd == i32(data_len));
  assert((buf.add(usize(0))).* == u8(99));
  assert((buf.add(usize(4))).* == u8(102));
  assert((buf.add(usize(12))).* == u8(97));
  c2 := io.await(file.close(dst_fd), io);
  assert(c2 == i32(0));
  io.await(dir.unlink(AT_FDCWD, dst_path, i32(0)), io);
  io.await(dir.unlink(AT_FDCWD, src_path, i32(0)), io);
});
test("sendfile transfers bytes", {
  tmp := temp_dir();
  src_path_str := path_join(tmp, `yo_io_sendfile_src.txt`);
  dst_path_str := path_join(tmp, `yo_io_sendfile_dst.txt`);
  src_path_c := src_path_str.to_cstr();
  dst_path_c := dst_path_str.to_cstr();
  src_path := src_path_c.ptr().unwrap();
  dst_path := dst_path_c.ptr().unwrap();
  io.await(dir.unlink(AT_FDCWD, dst_path, i32(0)), io);
  io.await(dir.unlink(AT_FDCWD, src_path, i32(0)), io);
  write_flags := (O_WRONLY | O_CREAT | O_TRUNC);
  src_fd := io.await(file.openat(AT_FDCWD, src_path, write_flags, i32(0o644)), io);
  assert(src_fd >= i32(0));
  data := *(u8)("sendfile ok");
  data_len := u32(11);
  wr := io.await(file.write(src_fd, data, data_len, u64(0)), io);
  assert(wr == i32(data_len));
  c1 := io.await(file.close(src_fd), io);
  assert(c1 == i32(0));
  in_fd := io.await(file.openat(AT_FDCWD, src_path, O_RDONLY, i32(0)), io);
  assert(in_fd >= i32(0));
  out_fd := io.await(file.openat(AT_FDCWD, dst_path, write_flags, i32(0o644)), io);
  assert(out_fd >= i32(0));
  sent := copy_io.sendfile(out_fd, in_fd, i64(0), usize(data_len));
  unsafe(printf("  sendfile = %d\n", sent));
  assert(sent == i32(data_len));
  c2 := io.await(file.close(in_fd), io);
  c3 := io.await(file.close(out_fd), io);
  assert(c2 == i32(0));
  assert(c3 == i32(0));
  dst_fd := io.await(file.openat(AT_FDCWD, dst_path, O_RDONLY, i32(0)), io);
  assert(dst_fd >= i32(0));
  buf_uninit := MaybeUninit(Array(u8, usize(32))).new();
  buf := *(u8)(buf_uninit.as_ptr());
  rd := io.await(file.read(dst_fd, buf, u32(32), u64(0)), io);
  assert(rd == i32(data_len));
  assert((buf.add(usize(0))).* == u8(115));
  assert((buf.add(usize(4))).* == u8(102));
  assert((buf.add(usize(10))).* == u8(107));
  c4 := io.await(file.close(dst_fd), io);
  assert(c4 == i32(0));
  io.await(dir.unlink(AT_FDCWD, dst_path, i32(0)), io);
  io.await(dir.unlink(AT_FDCWD, src_path, i32(0)), io);
});
