pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (socket info requires real sockets)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (socket info requires real sockets)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
tcp :: import("std/sys/tcp");
sockinfo :: import("std/sys/sockinfo");
{ AF_INET, SOCK_STREAM, SOL_SOCKET, SO_REUSEADDR, SO_TYPE, sockaddr_storage_size } :: import("std/sys/socket");
test("sockinfo getsockname and getpeername on TCP connection", {
  server_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  assert(server_fd >= i32(0), "server socket should be created");
  bind_addr := tcp.make_sockaddr_in_loopback(u16(0));
  bind_result := io.await(tcp.bind(server_fd, bind_addr.buf, bind_addr.len), io);
  assert(bind_result == i32(0), "bind should succeed on loopback ephemeral port");
  listen_result := io.await(tcp.listen(server_fd, i32(16)), io);
  assert(listen_result == i32(0), "listen should succeed");
  storage_size := sockaddr_storage_size();
  local_addr_buf := (*u8)(malloc(storage_size).unwrap());
  local_addr_len := (*u32)(malloc(usize(4)).unwrap());
  local_addr_len.* = u32(storage_size);
  getsockname_result := sockinfo.getsockname(server_fd, local_addr_buf, local_addr_len);
  unsafe(printf("  getsockname(server) = %d, len = %u\n", getsockname_result, local_addr_len.*));
  assert(getsockname_result == i32(0), "getsockname on listening socket should succeed");
  family := tcp.get_family(local_addr_buf);
  assert(family == u16(AF_INET), "getsockname family should be AF_INET");
  server_port := tcp.get_port_in(local_addr_buf);
  unsafe(printf("  server ephemeral port = %u\n", server_port));
  assert(server_port != u16(0), "ephemeral port should be non-zero after bind");
  client_fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  assert(client_fd >= i32(0), "client socket should be created");
  connect_addr := tcp.make_sockaddr_in_loopback(server_port);
  connect_result := io.await(tcp.connect(client_fd, connect_addr.buf, connect_addr.len), io);
  assert(connect_result == i32(0), "connect should succeed");
  accepted_addr_buf := (*u8)(malloc(storage_size).unwrap());
  accepted_addr_len := (*u32)(malloc(usize(4)).unwrap());
  accepted_addr_len.* = u32(storage_size);
  accepted_fd := io.await(tcp.accept(server_fd, accepted_addr_buf, accepted_addr_len), io);
  assert(accepted_fd >= i32(0), "accept should return a valid fd");
  peer_addr_buf := (*u8)(malloc(storage_size).unwrap());
  peer_addr_len := (*u32)(malloc(usize(4)).unwrap());
  peer_addr_len.* = u32(storage_size);
  getpeername_result := sockinfo.getpeername(client_fd, peer_addr_buf, peer_addr_len);
  unsafe(printf("  getpeername(client) = %d, len = %u\n", getpeername_result, peer_addr_len.*));
  assert(getpeername_result == i32(0), "getpeername on connected client should succeed");
  peer_family := tcp.get_family(peer_addr_buf);
  assert(peer_family == u16(AF_INET), "peer family should be AF_INET");
  peer_port := tcp.get_port_in(peer_addr_buf);
  unsafe(printf("  peer port on client = %u\n", peer_port));
  assert(peer_port == server_port, "client peer port should equal server listen port");
  accepted_peer_buf := (*u8)(malloc(storage_size).unwrap());
  accepted_peer_len := (*u32)(malloc(usize(4)).unwrap());
  accepted_peer_len.* = u32(storage_size);
  accepted_peer_result := sockinfo.getpeername(accepted_fd, accepted_peer_buf, accepted_peer_len);
  assert(accepted_peer_result == i32(0), "getpeername on accepted socket should succeed");
  accepted_peer_family := tcp.get_family(accepted_peer_buf);
  assert(accepted_peer_family == u16(AF_INET), "accepted peer family should be AF_INET");
  accepted_peer_port := tcp.get_port_in(accepted_peer_buf);
  unsafe(printf("  client source port = %u\n", accepted_peer_port));
  assert(accepted_peer_port != u16(0), "accepted peer port should be non-zero");
  close_client := io.await(tcp.close(client_fd), io);
  close_accepted := io.await(tcp.close(accepted_fd), io);
  close_server := io.await(tcp.close(server_fd), io);
  assert(close_client == i32(0), "closing client socket should succeed");
  assert(close_accepted == i32(0), "closing accepted socket should succeed");
  assert(close_server == i32(0), "closing server socket should succeed");
  tcp.free_sockaddr(bind_addr);
  tcp.free_sockaddr(connect_addr);
  free(.Some((*void)(local_addr_buf)));
  free(.Some((*void)(local_addr_len)));
  free(.Some((*void)(accepted_addr_buf)));
  free(.Some((*void)(accepted_addr_len)));
  free(.Some((*void)(peer_addr_buf)));
  free(.Some((*void)(peer_addr_len)));
  free(.Some((*void)(accepted_peer_buf)));
  free(.Some((*void)(accepted_peer_len)));
});
test("sockinfo getsockopt and setsockopt", {
  fd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  assert(fd >= i32(0), "socket should be created for getsockopt/setsockopt test");
  set_optval := (*i32)(malloc(usize(4)).unwrap());
  set_optval.* = i32(1);
  setsockopt_result := sockinfo.setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (*u8)(set_optval), u32(4));
  unsafe(printf("  setsockopt(SO_REUSEADDR) = %d\n", setsockopt_result));
  assert(setsockopt_result == i32(0), "setsockopt SO_REUSEADDR should succeed");
  get_optval := (*i32)(malloc(usize(4)).unwrap());
  get_optval.* = i32(0);
  get_optlen := (*u32)(malloc(usize(4)).unwrap());
  get_optlen.* = u32(4);
  getsockopt_result := sockinfo.getsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (*u8)(get_optval), get_optlen);
  unsafe(printf("  getsockopt(SO_REUSEADDR) = %d, optlen = %u, value = %d\n", getsockopt_result, get_optlen.*, get_optval.*));
  assert(getsockopt_result == i32(0), "getsockopt SO_REUSEADDR should succeed");
  assert(get_optlen.* >= u32(4), "getsockopt SO_REUSEADDR should return at least 4 bytes");
  assert(get_optval.* != i32(0), "SO_REUSEADDR should be enabled after setsockopt");
  sock_type := (*i32)(malloc(usize(4)).unwrap());
  sock_type.* = i32(0);
  sock_type_len := (*u32)(malloc(usize(4)).unwrap());
  sock_type_len.* = u32(4);
  getsockopt_type_result := sockinfo.getsockopt(fd, SOL_SOCKET, SO_TYPE, (*u8)(sock_type), sock_type_len);
  unsafe(printf("  getsockopt(SO_TYPE) = %d, value = %d\n", getsockopt_type_result, sock_type.*));
  assert(getsockopt_type_result == i32(0), "getsockopt SO_TYPE should succeed");
  assert(sock_type.* == SOCK_STREAM, "SO_TYPE should report SOCK_STREAM");
  close_result := io.await(tcp.close(fd), io);
  assert(close_result == i32(0), "closing socket should succeed");
  free(.Some((*void)(set_optval)));
  free(.Some((*void)(get_optval)));
  free(.Some((*void)(get_optlen)));
  free(.Some((*void)(sock_type)));
  free(.Some((*void)(sock_type_len)));
});
