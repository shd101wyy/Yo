pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (Unix domain sockets unavailable)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (Unix domain sockets unavailable)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
{ AT_FDCWD } :: import("std/sys/constants");
{ temp_dir, path_join } :: import("../helper");
unix :: import("std/sys/unix");
{ sockaddr_storage_size } :: import("std/sys/socket");
dir :: import("std/sys/dir");
test("Unix stream socket echo", {
  tmp_dir := temp_dir();
  sock_path_str := path_join(tmp_dir, `yo_unix_sock_test`);
  sock_path_c := sock_path_str.to_cstr();
  sock_path := sock_path_c.ptr().unwrap();
  // Best-effort cleanup (ignore errors)
  io.await(dir.unlink(AT_FDCWD, sock_path, i32(0)), io);
  server_fd := io.await(unix.socket_stream(), io);
  unsafe(printf("  server fd = %d\n", server_fd));
  assert(server_fd >= i32(0), "server socket_stream failed");
  addr := unix.make_sockaddr_un(sock_path);
  cond(
    (addr.len == u32(0)) => {
      unsafe(printf("  sockaddr_un not supported on this platform\n"));
      io.await(unix.close(server_fd), io);
      return;
    },
    true => ()
  );
  addr_buf := match(
    addr.buf,
    .Some(p) => p,
    .None => {
      unsafe(printf("  sockaddr_un not supported on this platform\n"));
      io.await(unix.close(server_fd), io);
      return;
    }
  );
  bind_result := io.await(unix.bind(server_fd, addr_buf, addr.len), io);
  unsafe(printf("  bind = %d\n", bind_result));
  assert(bind_result == i32(0), "bind failed");
  listen_result := io.await(unix.listen(server_fd, i32(16)), io);
  unsafe(printf("  listen = %d\n", listen_result));
  assert(listen_result == i32(0), "listen failed");
  client_fd := io.await(unix.socket_stream(), io);
  unsafe(printf("  client fd = %d\n", client_fd));
  assert(client_fd >= i32(0), "client socket_stream failed");
  conn_result := io.await(unix.connect(client_fd, addr_buf, addr.len), io);
  unsafe(printf("  connect = %d\n", conn_result));
  assert(conn_result == i32(0), "connect failed");
  peer_size := sockaddr_storage_size();
  peer_buf := (*u8)(malloc(peer_size).unwrap());
  peer_len := (*u32)(malloc(usize(4)).unwrap());
  peer_len.* = u32(peer_size);
  accepted_fd := io.await(unix.accept(server_fd, peer_buf, peer_len), io);
  unsafe(printf("  accepted fd = %d\n", accepted_fd));
  assert(accepted_fd >= i32(0), "accept failed");
  msg := (*u8)("Hello Unix!");
  sent := io.await(unix.send(client_fd, msg, usize(11), i32(0)), io);
  unsafe(printf("  sent = %d\n", sent));
  assert(sent == i32(11), "send length mismatch");
  recv_buf := (*u8)(malloc(usize(64)).unwrap());
  received := io.await(unix.recv(accepted_fd, recv_buf, usize(64), i32(0)), io);
  unsafe(printf("  received = %d\n", received));
  assert(received == i32(11), "recv length mismatch");
  // Verify "Hello Unix!"
  assert((recv_buf.add(usize(0))).* == u8(72), "byte 0 mismatch");
  assert((recv_buf.add(usize(1))).* == u8(101), "byte 1 mismatch");
  assert((recv_buf.add(usize(2))).* == u8(108), "byte 2 mismatch");
  assert((recv_buf.add(usize(3))).* == u8(108), "byte 3 mismatch");
  assert((recv_buf.add(usize(4))).* == u8(111), "byte 4 mismatch");
  assert((recv_buf.add(usize(5))).* == u8(32), "byte 5 mismatch");
  assert((recv_buf.add(usize(6))).* == u8(85), "byte 6 mismatch");
  assert((recv_buf.add(usize(7))).* == u8(110), "byte 7 mismatch");
  assert((recv_buf.add(usize(8))).* == u8(105), "byte 8 mismatch");
  assert((recv_buf.add(usize(9))).* == u8(120), "byte 9 mismatch");
  assert((recv_buf.add(usize(10))).* == u8(33), "byte 10 mismatch");
  free(.Some((*void)(recv_buf)));
  free(.Some((*void)(peer_buf)));
  free(.Some((*void)(peer_len)));
  c1 := io.await(unix.close(client_fd), io);
  unsafe(printf("  close client = %d\n", c1));
  assert(c1 == i32(0), "close client failed");
  c2 := io.await(unix.close(accepted_fd), io);
  unsafe(printf("  close accepted = %d\n", c2));
  assert(c2 == i32(0), "close accepted failed");
  c3 := io.await(unix.close(server_fd), io);
  unsafe(printf("  close server = %d\n", c3));
  assert(c3 == i32(0), "close server failed");
  unix.free_addr(addr);
  io.await(dir.unlink(AT_FDCWD, sock_path, i32(0)), io);
});
