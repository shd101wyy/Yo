pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Emscripten); // no terminal in WASM (ioctl/termios unavailable)
pragma(Pragma.SkipWasm32Wasi); // no terminal in WASM (ioctl/termios unavailable)
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
{ platform, Platform } :: import("std/process");
tty :: import("std/sys/tty");
print_bool :: (fn(value : bool) -> i32)(
  cond(
    value => i32(1),
    true => i32(0)
  )
);
test("isatty and winsize", {
  cond(
    (platform == Platform.Windows) => {
      ();
    },
    true => {
      { STDIN_FILENO } :: import("std/libc/unistd");
      stdin_fd := i32(STDIN_FILENO);
      is_tty := tty.isatty(stdin_fd);
      unsafe(printf("  isatty = %d\n", print_bool(is_tty)));
      cond(
        is_tty => {
          init := tty.tty_init(stdin_fd);
          unsafe(printf("  tty_init = %d\n", init));
          assert(init == i32(0));
          ws := tty.tty_winsize(stdin_fd);
          unsafe(printf("  winsize = %d x %d\n", ws.width, ws.height));
          assert(ws.width >= i32(0));
          assert(ws.height >= i32(0));
        },
        true => {
          unsafe(printf("  skipping winsize: not a tty\n"));
        }
      );
    }
  );
});
test("set and reset tty mode", {
  cond(
    (platform == Platform.Windows) => {
      ();
    },
    true => {
      { STDIN_FILENO } :: import("std/libc/unistd");
      stdin_fd := i32(STDIN_FILENO);
      is_tty := tty.isatty(stdin_fd);
      cond(
        is_tty => {
          init := tty.tty_init(stdin_fd);
          assert(init == i32(0));
          set_result := tty.tty_set_mode(stdin_fd, tty.TTY_MODE_NORMAL);
          unsafe(printf("  tty_set_mode = %d\n", set_result));
          assert(set_result == i32(0));
          reset_result := tty.tty_reset();
          unsafe(printf("  tty_reset = %d\n", reset_result));
          assert(reset_result == i32(0));
        },
        true => {
          unsafe(printf("  skipping tty_set_mode: not a tty\n"));
        }
      );
    }
  );
});
