{ assert } :: import("std/assert");
// Tests for std/imm/vec — Persistent immutable vector
{ Vec, PopResult } :: import("../std/imm/vec");
{ ArrayList } :: import("../std/collections/array_list");
{ ImmString } :: import("../std/imm/string");
VecRcEntry :: struct(text : ImmString);
test("Vec new creates empty vector", {
  v := Vec(i32).new();
  assert(v.len() == usize(0), "length should be 0");
  assert(v.is_empty(), "should be empty");
});
test("Vec with_capacity", {
  v := Vec(i32).with_capacity(usize(100));
  assert(v.is_empty(), "should be empty");
  assert(v.len() == usize(0), "length should be 0");
});
test("Vec with_capacity zero then push", {
  v1 := Vec(i32).with_capacity(usize(0));
  v1_copy := v1;
  v2 := v1_copy.push(i32(7));
  assert(v1.is_empty(), "original stays empty");
  assert(v2.len() == usize(1), "push grows zero-cap vec");
  assert(v2(usize(0)) == i32(7), "pushed value preserved");
});
test("Vec push single element", {
  v := Vec(i32).new().push(i32(42));
  assert(v.len() == usize(1), "length should be 1");
  assert(!(v.is_empty()), "should not be empty");
});
test("Vec push multiple elements", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3)).push(i32(4)).push(i32(5));
  assert(v.len() == usize(5), "length should be 5");
  assert(v(usize(0)) == i32(1), "first");
  assert(v(usize(4)) == i32(5), "last");
});
test("Vec push preserves original", {
  v1 := Vec(i32).new().push(i32(10));
  v1_copy := v1;
  v2 := v1_copy.push(i32(20));
  assert(v1.len() == usize(1), "original unchanged");
  assert(v2.len() == usize(2), "new has both");
  assert(v1(usize(0)) == i32(10), "original value intact");
});
test("Vec get element", {
  v := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  assert(v(usize(0)) == i32(10), "first element");
  assert(v(usize(1)) == i32(20), "second element");
  assert(v(usize(2)) == i32(30), "third element");
  assert(v.get(usize(3)).is_none(), "out of bounds returns None");
});
test("Vec set element", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  v_copy := v;
  v2 := v_copy.set(usize(1), i32(99));
  assert(v(usize(1)) == i32(2), "original unchanged");
  assert(v2(usize(1)) == i32(99), "new has updated value");
  assert(v2(usize(0)) == i32(1), "other elements preserved");
  assert(v2(usize(2)) == i32(3), "other elements preserved 2");
});
test("Vec first and last", {
  v := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  assert(v.first().unwrap() == i32(10), "first");
  assert(v.last().unwrap() == i32(30), "last");
  empty := Vec(i32).new();
  assert(empty.first().is_none(), "first of empty is None");
  assert(empty.last().is_none(), "last of empty is None");
});
test("Vec pop", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  result := v.pop();
  assert(result.value.unwrap() == i32(3), "popped value");
  assert(result.vec.len() == usize(2), "vec len after pop");
  assert(result.vec(usize(0)) == i32(1), "remaining first");
  assert(result.vec(usize(1)) == i32(2), "remaining second");
});
test("Vec pop empty", {
  v := Vec(i32).new();
  result := v.pop();
  assert(result.value.is_none(), "pop empty returns None");
  assert(result.vec.is_empty(), "vec still empty");
});
test("Vec slice", {
  v := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30)).push(i32(40)).push(i32(50));
  s := v.slice(usize(1), usize(4));
  assert(s.len() == usize(3), "slice length");
  assert(s(usize(0)) == i32(20), "slice first");
  assert(s(usize(1)) == i32(30), "slice second");
  assert(s(usize(2)) == i32(40), "slice third");
});
test("Vec slice edge cases", {
  v := Vec(i32).new().push(i32(1)).push(i32(2));
  assert(v.slice(usize(0), usize(0)).is_empty(), "empty slice");
  assert(v.slice(usize(5), usize(10)).is_empty(), "out of bounds slice");
  assert(v.slice(usize(0), usize(100)).len() == usize(2), "clamped end");
});
test("Vec concat", {
  v1 := Vec(i32).new().push(i32(1)).push(i32(2));
  v2 := Vec(i32).new().push(i32(3)).push(i32(4));
  result := v1.concat(v2);
  assert(result.len() == usize(4), "concat length");
  assert(result(usize(0)) == i32(1), "concat 0");
  assert(result(usize(1)) == i32(2), "concat 1");
  assert(result(usize(2)) == i32(3), "concat 2");
  assert(result(usize(3)) == i32(4), "concat 3");
});
test("Vec concat empty", {
  v1 := Vec(i32).new().push(i32(1));
  v2 := Vec(i32).new();
  v1_copy := v1;
  v2_copy := v2;
  assert(v1_copy.concat(v2).len() == usize(1), "concat with empty right");
  assert(v2_copy.concat(v1).len() == usize(1), "concat with empty left");
});
test("Vec concat two empties then push", {
  v1 := Vec(i32).new();
  v2 := Vec(i32).new();
  combined := v1.concat(v2);
  combined_copy := combined;
  pushed := combined_copy.push(i32(9));
  assert(combined.is_empty(), "concat of empties stays empty");
  assert(pushed.len() == usize(1), "push grows empty concat result");
  assert(pushed(usize(0)) == i32(9), "pushed value preserved");
});
test("Vec reverse", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  r := v.reverse();
  assert(r(usize(0)) == i32(3), "reversed first");
  assert(r(usize(1)) == i32(2), "reversed second");
  assert(r(usize(2)) == i32(1), "reversed third");
});
test("Vec reverse single and empty", {
  empty := Vec(i32).new();
  assert(empty.reverse().is_empty(), "reverse empty");
  single := Vec(i32).new().push(i32(42));
  assert(single.reverse()(usize(0)) == i32(42), "reverse single");
});
test("Vec map", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  doubled := v.map((a) => (a * i32(2)));
  assert(doubled.len() == usize(3), "map preserves length");
  assert(doubled(usize(0)) == i32(2), "map 0");
  assert(doubled(usize(1)) == i32(4), "map 1");
  assert(doubled(usize(2)) == i32(6), "map 2");
});
test("Vec filter", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3)).push(i32(4)).push(i32(5));
  evens := v.filter((a) => ((a % i32(2)) == i32(0)));
  assert(evens.len() == usize(2), "filter length");
  assert(evens(usize(0)) == i32(2), "filter 0");
  assert(evens(usize(1)) == i32(4), "filter 1");
});
test("Vec fold", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3)).push(i32(4));
  sum := v.fold(i32(0), (acc, elem) => (acc + elem));
  assert(sum == i32(10), "fold sum");
});
test("Vec any", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  assert(v.any((a) => (a == i32(2))), "any finds 2");
  assert(!(v.any((a) => (a == i32(99)))), "any misses 99");
});
test("Vec all", {
  v := Vec(i32).new().push(i32(2)).push(i32(4)).push(i32(6));
  assert(v.all((a) => ((a % i32(2)) == i32(0))), "all even");
  v2 := v.push(i32(3));
  assert(!(v2.all((a) => ((a % i32(2)) == i32(0)))), "not all even");
});
test("Vec find", {
  v := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  assert(v.find((a) => (a > i32(15))).unwrap() == i32(20), "find first > 15");
  assert(v.find((a) => (a > i32(100))).is_none(), "find none > 100");
});
test("Vec index_of", {
  v := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  assert(v.index_of(i32(20)).unwrap() == usize(1), "index_of 20");
  assert(v.index_of(i32(99)).is_none(), "index_of missing");
});
test("Vec contains", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  assert(v.contains(i32(2)), "contains 2");
  assert(!(v.contains(i32(99))), "not contains 99");
});
test("Vec dedup", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(1)).push(i32(3)).push(i32(2));
  d := v.dedup();
  assert(d.len() == usize(3), "dedup length");
  assert(d(usize(0)) == i32(1), "dedup 0");
  assert(d(usize(1)) == i32(2), "dedup 1");
  assert(d(usize(2)) == i32(3), "dedup 2");
});
test("Vec zip_with", {
  v1 := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  v2 := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  result := v1.zip_with(v2, (a, b) => (a + b));
  assert(result.len() == usize(3), "zip_with length");
  assert(result(usize(0)) == i32(11), "zip_with 0");
  assert(result(usize(1)) == i32(22), "zip_with 1");
  assert(result(usize(2)) == i32(33), "zip_with 2");
});
test("Vec zip_with different lengths", {
  v1 := Vec(i32).new().push(i32(1)).push(i32(2));
  v2 := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  result := v1.zip_with(v2, (a, b) => (a + b));
  assert(result.len() == usize(2), "zip_with takes min length");
});
test("Vec equality", {
  v1 := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  v2 := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  v3 := Vec(i32).new().push(i32(1)).push(i32(2));
  v4 := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(99));
  assert(v1 == v2, "equal vectors");
  assert(v1 != v3, "different lengths");
  assert(v1 != v4, "different values");
});
test("Vec push many elements (capacity growth)", {
  v := Vec(i32).new();
  i := i32(0);
  while(i < i32(100), i = (i + i32(1)), {
    v = v.push(i);
  });
  assert(v.len() == usize(100), "100 elements");
  assert(v(usize(0)) == i32(0), "first");
  assert(v(usize(99)) == i32(99), "last");
});
test("Vec structural sharing", {
  v1 := Vec(i32).new().push(i32(1)).push(i32(2));
  v1a := v1;
  v1b := v1;
  v2 := v1a.push(i32(3));
  v3 := v1b.push(i32(4));
  assert(v1.len() == usize(2), "v1 unchanged");
  assert(v2.len() == usize(3), "v2 has 3");
  assert(v3.len() == usize(3), "v3 has 3");
  assert(v2(usize(2)) == i32(3), "v2 last = 3");
  assert(v3(usize(2)) == i32(4), "v3 last = 4");
});
test("Vec from_list single element", {
  arr := [i32 ; 1](i32(42));
  v := Vec(i32).from_list(ArrayList(i32).from_array(arr));
  assert(v.len() == usize(1), "len = 1");
  assert(v(usize(0)) == i32(42), "elem 0");
});
test("Vec from_list with elements", {
  arr := [i32 ; 5](i32(10), i32(20), i32(30), i32(40), i32(50));
  v := Vec(i32).from_list(ArrayList(i32).from_array(arr));
  assert(v.len() == usize(5), "len = 5");
  assert(v(usize(0)) == i32(10), "elem 0");
  assert(v(usize(2)) == i32(30), "elem 2");
  assert(v(usize(4)) == i32(50), "elem 4");
});
test("Vec from_list then push", {
  arr := [i32 ; 3](i32(1), i32(2), i32(3));
  v1 := Vec(i32).from_list(ArrayList(i32).from_array(arr));
  v1_copy := v1;
  v2 := v1_copy.push(i32(4));
  assert(v1.len() == usize(3), "original unchanged");
  assert(v2.len() == usize(4), "new has 4");
  assert(v2(usize(3)) == i32(4), "appended elem");
});
test("Vec from_list equality", {
  arr := [i32 ; 3](i32(1), i32(2), i32(3));
  v1 := Vec(i32).from_list(ArrayList(i32).from_array(arr));
  v2 := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  assert(v1 == v2, "from_list equals manual push");
});
test("Vec supports RC-backed Send elements", {
  v1 := Vec(VecRcEntry).new().push(VecRcEntry(text : ImmString.from("a"))).push(VecRcEntry(text : ImmString.from("b")));
  v1a := v1;
  v2 := v1a.push(VecRcEntry(text : ImmString.from("c")));
  v2a := v2;
  v3 := v2a.set(usize(0), VecRcEntry(text : ImmString.from("z")));
  v3a := v3;
  popped := v3a.pop();
  v1b := v1;
  v4 := v1b.concat(Vec(VecRcEntry).new().push(VecRcEntry(text : ImmString.from("d"))));
  v5 := v4.slice(usize(1), usize(3));
  assert(v1(usize(0)).text.eq_str("a"), "v1 keeps first value");
  assert(v2(usize(2)).text.eq_str("c"), "push appends rc value");
  assert(v3(usize(0)).text.eq_str("z"), "set replaces rc value");
  assert(popped.value.unwrap().text.eq_str("c"), "pop returns rc value");
  assert(popped.vec.len() == usize(2), "pop shrinks vector");
  assert(v5(usize(0)).text.eq_str("b"), "slice keeps middle value");
  assert(v5(usize(1)).text.eq_str("d"), "concat adds tail value");
});
// COW (copy-on-write) specific tests
test("Vec COW push unique path", {
  // When rc==1 (no sharing), push should mutate in place
  v := Vec(i32).new();
  v = v.push(i32(1));
  v = v.push(i32(2));
  v = v.push(i32(3));
  assert(v.len() == usize(3), "unique push works");
  assert(v(usize(0)) == i32(1), "elem 0");
  assert(v(usize(2)) == i32(3), "elem 2");
});
test("Vec COW push shared path preserves original", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  v_copy := v;
  v2 := v_copy.push(i32(4));
  assert(v.len() == usize(3), "original preserved when shared");
  assert(v2.len() == usize(4), "new has 4 elements");
  assert(v2(usize(3)) == i32(4), "appended value correct");
});
test("Vec COW set unique path", {
  v := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  v = v.set(usize(1), i32(99));
  assert(v(usize(1)) == i32(99), "in-place set works");
  assert(v(usize(0)) == i32(10), "other elements intact");
});
test("Vec COW pop unique path", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  result := v.pop();
  assert(result.value.unwrap() == i32(3), "popped value");
  assert(result.vec.len() == usize(2), "len after pop");
});
test("Vec COW reverse unique path", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  v = v.reverse();
  assert(v(usize(0)) == i32(3), "reversed 0");
  assert(v(usize(1)) == i32(2), "reversed 1");
  assert(v(usize(2)) == i32(1), "reversed 2");
});
test("Vec COW concat unique path", {
  v := Vec(i32).new().push(i32(1)).push(i32(2));
  other := Vec(i32).new().push(i32(3)).push(i32(4));
  v = v.concat(other);
  assert(v.len() == usize(4), "concat length");
  assert(v(usize(2)) == i32(3), "concat elem 2");
  assert(v(usize(3)) == i32(4), "concat elem 3");
});
test("Vec COW dedup unique path", {
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(1)).push(i32(3));
  v = v.dedup();
  assert(v.len() == usize(3), "dedup length");
  assert(v(usize(0)) == i32(1), "dedup 0");
  assert(v(usize(1)) == i32(2), "dedup 1");
  assert(v(usize(2)) == i32(3), "dedup 2");
});
// Regression test: Vec(ImmString) exercised genericImplMethodCache with
// same-named types from different modules (std/imm/string::String vs
// std/string::String) — see issues/fixed/generic-impl-method-cache-key-collision.md.
// D4 PR 5 (2026-08-26) renamed the imm type to ImmString, so that name
// collision no longer exists in the tree; these tests stay as plain
// Vec(ImmString) coverage.
test("Vec of ImmString push and get", {
  v := Vec(ImmString).new();
  v = v.push(ImmString.from("hello"));
  v = v.push(ImmString.from("world"));
  assert(v.len() == usize(2), "length should be 2");
  assert(v(usize(0)) == ImmString.from("hello"), "elem 0");
  assert(v(usize(1)) == ImmString.from("world"), "elem 1");
});
test("Vec of ImmString concat", {
  a := Vec(ImmString).new().push(ImmString.from("a")).push(ImmString.from("b"));
  b := Vec(ImmString).new().push(ImmString.from("c"));
  c := a.concat(b);
  assert(c.len() == usize(3), "concat length");
  assert(c(usize(2)) == ImmString.from("c"), "concat elem 2");
});
test("Vec of ImmString with struct element", {
  v := Vec(VecRcEntry).new();
  v = v.push(VecRcEntry(text : ImmString.from("item1")));
  v = v.push(VecRcEntry(text : ImmString.from("item2")));
  assert(v.len() == usize(2), "length");
  assert(v(usize(0)).text == ImmString.from("item1"), "text 0");
});
