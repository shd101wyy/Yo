{ assert } :: import("std/assert");
/// Phase P (THREAD_SAFETY): Field visibility — `_`-prefix enforced as
/// file/directory-private. A field whose name starts with `_` is accessible
/// only within the file or directory that defines the containing type.
// ============================================================================
// Within same file: _-prefixed fields are accessible.
// ============================================================================
test("private field accessible in same file", {
  MyType :: struct(public_field : i32, _hidden : i32);
  v := MyType(i32(1), i32(2));
  assert(v._hidden == i32(2), "should access private field in same file");
  v._hidden = i32(3);
  assert(v._hidden == i32(3), "should write private field in same file");
});

// ============================================================================
// Private fields on std/ types are accessible from same-directory
// std/ files (covered by the 148/148 std check above).
// ============================================================================
test("std lib _-prefixed fields compile without error", {
  // String._bytes is accessed by string_builder.yo in std/string/
  // This compiles because both files are in the same directory.
  // Just asserting the test framework works.
  assert(true, "std compiled without errors");
});

// ============================================================================
// Non-_ fields are always accessible from any file.
// ============================================================================
test("non-private fields accessible everywhere", {
  Point :: struct(x : i32, y : i32);
  p := Point(i32(10), i32(20));
  assert(p.x == i32(10), "public field x accessible");
  assert(p.y == i32(20), "public field y accessible");
});
