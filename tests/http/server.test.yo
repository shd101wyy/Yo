//! std/http HttpServer (plans/STD_API_AUDIT.md §7 P1 "HTTP server"): a
//! spawned server task on loopback, driven by the client on the test's own
//! stack — so both halves of std/http are exercised against each other.
pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM
pragma(Pragma.SkipWindows); // std/http pulls in TlsStream → openssl/ssl.h, absent on the Windows runners (same gate as http.test.yo)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ HttpServer, HttpRequest, HttpResponse, HttpMethod, fetch, fetch_with, FetchOptions, parse_request } :: import("std/http");
{ TcpStream } :: import("std/net/tcp");
{ SocketAddr } :: import("std/net/addr");
{ Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
open(import("std/string"));
open(import("std/fmt"));
// Handlers are installed INLINE in each test: a ctl handler is frame-bound,
// and the previous helper returned the Exception record OUT of the fn that
// defined its handler — the def-time trial cannot type that handler's
// `unwind` (the future install frame is unknowable), so the handler body was
// silently hollow (its `unwind` statement was never emitted) —
// issues/fixed/ctl-handler-escaping-its-defining-fn-is-untypeable.md.
// Echo handler: method, path, a request header and the body, as text.
_echo :: (fn(req : HttpRequest) -> HttpResponse)({
  tag := match(req.get_header(`X-Tag`), .Some(v) => v, .None => `-`);
  HttpResponse.with_status(i32(200)).header(`X-Echo`, `yes`).with_body(`${req.method.to_string()} ${req.path} tag=${tag} body=[${req.body}]`)
});
// Read one full response off a raw stream (until the server closes).
_read_all :: (fn(stream : TcpStream, io : Io) -> Impl(Future(String, IoExn)))(
  io.async((e) => {
    out := ArrayList(u8).new();
    buf := *(u8)(malloc(usize(4096)).unwrap());
    done := false;
    while(runtime(!(done)), {
      n := e.io.await(stream.read(buf, usize(4096), e.io), e);
      cond(
        (n == usize(0)) => {
          done = true;
        },
        true => {
          i := usize(0);
          while(runtime(i < n), {
            out.push((buf.add(i)).*);
            i = (i + usize(1));
          });
        }
      );
    });
    free(.Some(*(void)(buf)));
    String.from_bytes(out)
  })
);
test("parse_request: request line, headers, body, and the error cases", {
  r := parse_request(`POST /a/b?x=1 HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhello`);
  match(
    r,
    .Ok(req) => {
      assert(match(req.method, .POST => true, _ => false), "method");
      assert(req.path == "/a/b?x=1", `path ${req.path}`);
      assert(req.get_header(`host`).unwrap() == "h", "header lookup is case-insensitive");
      assert(req.body == "hello", `body [${req.body}]`);
    },
    .Err(msg) => assert(false, `unexpected parse error: ${msg}`)
  );
  assert(match(parse_request(`BREW /pot HTTP/1.1\r\n\r\n`), .Err(m) => m.contains(`Unknown method`), .Ok(_) => false), "unknown method");
  assert(match(parse_request(`GET /x HTTP/2\r\n\r\n`), .Err(m) => m.contains(`version`), .Ok(_) => false), "unsupported version");
  assert(match(parse_request(`GET /x\r\n\r\n`), .Err(m) => m.contains(`request line`), .Ok(_) => false), "two-part request line");
  assert(match(parse_request(``), .Err(m) => m.contains(`Empty`), .Ok(_) => false), "empty");
  assert(match(HttpMethod.from_str(`OPTIONS`), .Some(m) => (m.to_string() == "OPTIONS"), .None => false), "OPTIONS round-trips");
});
test("HttpResponse.to_string adds Content-Length and keeps explicit headers", {
  s := HttpResponse.with_status(i32(404)).header(`X-A`, `1`).with_body(`nope`).to_string();
  assert(s == "HTTP/1.1 404 Not Found\r\nX-A: 1\r\nContent-Length: 4\r\n\r\nnope", `wire form: ${s}`);
  t := HttpResponse.with_status(i32(200)).header(`Content-Length`, `0`).to_string();
  assert(t == "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", "an explicit Content-Length is not duplicated");
});
test("serve_once answers a GET from fetch (method, path, header, empty body)", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19970)), io), IoExn(io : io, exn : exn));
  task := io.spawn(server.serve_once(_echo, io), IoExn(io : io, exn : exn));
  resp := io.await(fetch(`http://127.0.0.1:19970/hello?q=1`, io), IoExn(io : io, exn : exn));
  assert(resp.status_code == i32(200), `status ${resp.status_code}`);
  assert(resp.body == "GET /hello?q=1 tag=- body=[]", `echo body: ${resp.body}`);
  assert(resp.get_header(`X-Echo`).unwrap() == "yes", "handler header survives");
  assert(resp.get_header(`Content-Length`).unwrap() == resp.body.len().to_string(), "Content-Length matches the body");
  assert(resp.get_header(`Connection`).unwrap() == "close", "server adds Connection: close");
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("serve_once reads a POST body and forwards request headers", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19971)), io), IoExn(io : io, exn : exn));
  task := io.spawn(server.serve_once(_echo, io), IoExn(io : io, exn : exn));
  opts := FetchOptions.new().with_method(HttpMethod.POST).with_body(`payload — 3 bytes of dash`).with_header(`X-Tag`, `t1`);
  resp := io.await(fetch_with(`http://127.0.0.1:19971/post`, opts, io), IoExn(io : io, exn : exn));
  assert(resp.body == "POST /post tag=t1 body=[payload — 3 bytes of dash]", `echo body: ${resp.body}`);
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("a chunked request body is decoded before the handler sees it", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19972)), io), IoExn(io : io, exn : exn));
  task := io.spawn(server.serve_once(_echo, io), IoExn(io : io, exn : exn));
  s := io.await(TcpStream.connect(SocketAddr.loopback(u16(19972)), io), IoExn(io : io, exn : exn));
  _w := io.await(s.write_string(`PUT /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n`, io), IoExn(io : io, exn : exn));
  raw := io.await(_read_all(s, io), IoExn(io : io, exn : exn));
  assert(raw.starts_with(`HTTP/1.1 200 OK\r\n`), `status line: ${raw}`);
  assert(raw.ends_with(`PUT /c tag=- body=[abcde]`), `decoded body reached the handler: ${raw}`);
  io.await(s.close(io), IoExn(io : io, exn : exn));
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("a request that does not parse gets 400 with the reason, handler not called", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19973)), io), IoExn(io : io, exn : exn));
  called := ArrayList(i32).new();
  task := io.spawn(
    server.serve_once((req) => {
      called.push(i32(1));
      HttpResponse.with_status(i32(200))
    }, io),
    IoExn(io : io, exn : exn)
  );
  s := io.await(TcpStream.connect(SocketAddr.loopback(u16(19973)), io), IoExn(io : io, exn : exn));
  _w := io.await(s.write_string(`BREW /pot HTTP/1.1\r\nHost: x\r\n\r\n`, io), IoExn(io : io, exn : exn));
  raw := io.await(_read_all(s, io), IoExn(io : io, exn : exn));
  assert(raw.starts_with(`HTTP/1.1 400 Bad Request\r\n`), `status line: ${raw}`);
  assert(raw.contains(`Unknown method: BREW`), `reason in body: ${raw}`);
  assert(called.len() == usize(0), "handler must not run for a malformed request");
  io.await(s.close(io), IoExn(io : io, exn : exn));
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("serve loops until stop(); local_addr reports the bound port", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19974)), io), IoExn(io : io, exn : exn));
  assert(server.local_addr().port == u16(19974), `local_addr port ${server.local_addr().port}`);
  hits := ArrayList(i32).new();
  task := io.spawn(
    server.serve((req) => {
      hits.push(i32(1));
      cond(
        (req.path == `/last`) => {
          server.stop();
        },
        true => ()
      );
      HttpResponse.with_status(i32(200)).with_body(`n=${hits.len()}`)
    }, io),
    IoExn(io : io, exn : exn)
  );
  r1 := io.await(fetch(`http://127.0.0.1:19974/a`, io), IoExn(io : io, exn : exn));
  r2 := io.await(fetch(`http://127.0.0.1:19974/b`, io), IoExn(io : io, exn : exn));
  r3 := io.await(fetch(`http://127.0.0.1:19974/last`, io), IoExn(io : io, exn : exn));
  assert((r1.body == "n=1") && ((r2.body == "n=2") && (r3.body == "n=3")), `three sequential requests: ${r1.body} ${r2.body} ${r3.body}`);
  task.await(io);
  assert(hits.len() == usize(3), "serve returned after stop()");
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
// The request direction of the binary-body pin: parse_request must slice the
// body at BYTE offsets without char-boundary checks — a body starting with a
// UTF-8 continuation byte used to panic the boundary-checked substring.
test("the server round-trips a binary request body byte-for-byte", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  srv := io.await(HttpServer.bind(SocketAddr.loopback(u16(19979)), io), IoExn(io : io, exn : exn));
  task := io.spawn(
    srv.serve_once((req) => {
      resp := HttpResponse.with_status(i32(200)).with_body(req.body);
      resp
    }, io),
    IoExn(io : io, exn : exn)
  );
  payload := ArrayList(u8).new();
  payload.push(u8(0x80));
  payload.push(u8(0));
  payload.push(u8(0xFF));
  payload.push(u8(66));
  body := String.from_bytes(payload);
  opts := FetchOptions.new().with_method(HttpMethod.POST).with_body(body);
  r := io.await(fetch_with(`http://127.0.0.1:19979/echo`, opts, io), IoExn(io : io, exn : exn));
  task.await(io);
  io.await(srv.close(io), IoExn(io : io, exn : exn));
  assert(r.status_code == i32(200), "200");
  got := r.body.as_bytes();
  assert(got.len() == usize(4), `echoed 4 bytes (got ${got.len()})`);
  assert(got(usize(0)) == u8(0x80), "continuation byte");
  assert(got(usize(3)) == u8(66), "B");
});
