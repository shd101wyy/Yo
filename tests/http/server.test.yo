//! std/http HttpServer (plans/STD_API_AUDIT.md §7 P1 "HTTP server"): a
//! spawned server task on loopback, driven by the client on the test's own
//! stack — so both halves of std/http are exercised against each other.
pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM
pragma(Pragma.SkipWindows); // std/http pulls in TlsStream → openssl/ssl.h, absent on the Windows runners (same gate as http.test.yo)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ HttpServer, HttpRequest, HttpResponse, HttpMethod, fetch, fetch_with, FetchOptions, parse_request } :: import("std/http");
{ TcpStream } :: import("std/net/tcp");
{ SocketAddr } :: import("std/net/addr");
{ Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
open(import("std/string"));
open(import("std/fmt"));
// Handlers are installed INLINE in each test: a ctl handler is frame-bound,
// and the previous helper returned the Exception record OUT of the fn that
// defined its handler — the def-time trial cannot type that handler's
// `unwind` (the future install frame is unknowable), so the handler body was
// silently hollow (its `unwind` statement was never emitted) —
// issues/fixed/ctl-handler-escaping-its-defining-fn-is-untypeable.md.
// Echo handler: method, path, a request header and the body, as text.
_echo :: (fn(req : HttpRequest) -> HttpResponse)({
  tag := match(req.get_header(`X-Tag`), .Some(v) => v, .None => `-`);
  HttpResponse.with_status(i32(200)).header(`X-Echo`, `yes`).with_body(`${req.method.to_string()} ${req.path} tag=${tag} body=[${req.body}]`)
});
// Read one full response off a raw stream (until the server closes).
_read_all :: (fn(stream : TcpStream, io : Io) -> Impl(Future(String, IoExn)))(
  io.async(e => {
    out := ArrayList(u8).new();
    buf := (*u8)(malloc(usize(4096)).unwrap());
    done := false;
    while(runtime(!done), {
      n := e.io.await(stream.read(buf, usize(4096), e.io), e);
      cond(
        (n == usize(0)) => {
          done = true;
        },
        true => {
          i := usize(0);
          while(runtime(i < n), {
            out.push((buf.add(i)).*);
            i = (i + usize(1));
          });
        }
      );
    });
    free(.Some((*void)(buf)));
    String.from_bytes(out)
  })
);
// Send one raw request on a fresh connection and read the whole response.
// The write count is asserted so a short `send` shows up as a failure here
// rather than as the server waiting forever for the rest of the body.
_raw_exchange :: (fn(port : u16, request : String, io : Io) -> Impl(Future(String, IoExn)))(
  io.async(e => {
    s := e.io.await(TcpStream.connect(SocketAddr.loopback(port), e.io), e);
    w := e.io.await(s.write_string(request, e.io), e);
    assert(w == request.len(), `short write: ${w} of ${request.len()} bytes`);
    raw := e.io.await(_read_all(s, e.io), e);
    e.io.await(s.close(e.io), e);
    raw
  })
);
// 12 000 bytes — more than the 8 KiB `read_http_message` reads at a time, so
// the body only arrives in full when `Content-Length` really framed it.
_big_body :: (fn() -> String)({
  s := String.new();
  i := usize(0);
  while(i < usize(1200), i = (i + usize(1)), {
    s.push_str("0123456789");
  });
  s
});
test("parse_request: request line, headers, body, and the error cases", {
  r := parse_request(`POST /a/b?x=1 HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhello`);
  match(
    r,
    .Ok(req) => {
      assert(match(req.method, .POST => true, _ => false), "method");
      assert(req.path == "/a/b?x=1", `path ${req.path}`);
      assert(req.get_header(`host`).unwrap() == "h", "header lookup is case-insensitive");
      assert(req.body == "hello", `body [${req.body}]`);
    },
    .Err(msg) => assert(false, `unexpected parse error: ${msg}`)
  );
  assert(match(parse_request(`BREW /pot HTTP/1.1\r\n\r\n`), .Err(m) => match(m, .UnknownMethod(name) => (name == "BREW"), _ => false), .Ok(_) => false), "unknown method");
  assert(match(parse_request(`GET /x HTTP/2\r\n\r\n`), .Err(m) => match(m, .UnsupportedVersion(v) => (v == "HTTP/2"), _ => false), .Ok(_) => false), "unsupported version");
  assert(match(parse_request(`GET /x\r\n\r\n`), .Err(m) => match(m, .InvalidRequestLine(_) => true, _ => false), .Ok(_) => false), "two-part request line");
  assert(match(parse_request(``), .Err(m) => match(m, .Empty => true, _ => false), .Ok(_) => false), "empty");
  assert(match(parse_request(`GET /x HTTP/1.1\r\nno-colon-here\r\n\r\n`), .Err(m) => m.to_string().contains(`Invalid header line: no-colon-here`), .Ok(_) => false), "header line without a colon, rendered for a 400 body");
  assert(match(HttpMethod.from_str(`OPTIONS`), .Some(m) => (m.to_string() == "OPTIONS"), .None => false), "OPTIONS round-trips");
});
// The request-side half of the same defect: `read_http_message(is_request=true)`
// completes a body-less request at its headers, but returned the whole buffer —
// so a second request pipelined into the SAME write became the first one's
// body. That is request smuggling (RFC 9112 §11.2).
test("bytes pipelined after a body-less request are not its body", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19983)), io), IoExn(io : io, exn : exn));
  task := io.spawn(server.serve_once(_echo, io), IoExn(io : io, exn : exn));
  raw := io.await(
    _raw_exchange(u16(19983), `GET /first HTTP/1.1\r\nHost: h\r\n\r\nGET /smuggled HTTP/1.1\r\nHost: h\r\n\r\n`, io),
    IoExn(io : io, exn : exn)
  );
  assert(raw.contains(`body=[]`), `the pipelined bytes leaked into the body: ${raw}`);
  assert(!raw.contains(`/smuggled`), `the smuggled request line reached the handler: ${raw}`);
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("HttpResponse.to_string adds Content-Length and keeps explicit headers", {
  s := HttpResponse.with_status(i32(404)).header(`X-A`, `1`).with_body(`nope`).to_string();
  assert(s == "HTTP/1.1 404 Not Found\r\nX-A: 1\r\nContent-Length: 4\r\n\r\nnope", `wire form: ${s}`);
  t := HttpResponse.with_status(i32(200)).header(`Content-Length`, `0`).to_string();
  assert(t == "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", "an explicit Content-Length is not duplicated");
});
test("serve_once answers a GET from fetch (method, path, header, empty body)", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19970)), io), IoExn(io : io, exn : exn));
  task := io.spawn(server.serve_once(_echo, io), IoExn(io : io, exn : exn));
  resp := io.await(fetch(`http://127.0.0.1:19970/hello?q=1`, io), IoExn(io : io, exn : exn));
  assert(resp.status_code == i32(200), `status ${resp.status_code}`);
  assert(resp.body == "GET /hello?q=1 tag=- body=[]", `echo body: ${resp.body}`);
  assert(resp.get_header(`X-Echo`).unwrap() == "yes", "handler header survives");
  assert(resp.get_header(`Content-Length`).unwrap() == resp.body.len().to_string(), "Content-Length matches the body");
  assert(resp.get_header(`Connection`).unwrap() == "close", "server adds Connection: close");
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("serve_once reads a POST body and forwards request headers", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19971)), io), IoExn(io : io, exn : exn));
  task := io.spawn(server.serve_once(_echo, io), IoExn(io : io, exn : exn));
  opts := FetchOptions.new().with_method(HttpMethod.POST).with_body(`payload — 3 bytes of dash`).with_header(`X-Tag`, `t1`);
  resp := io.await(fetch_with(`http://127.0.0.1:19971/post`, opts, io), IoExn(io : io, exn : exn));
  assert(resp.body == "POST /post tag=t1 body=[payload — 3 bytes of dash]", `echo body: ${resp.body}`);
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("a chunked request body is decoded before the handler sees it", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19972)), io), IoExn(io : io, exn : exn));
  task := io.spawn(server.serve_once(_echo, io), IoExn(io : io, exn : exn));
  s := io.await(TcpStream.connect(SocketAddr.loopback(u16(19972)), io), IoExn(io : io, exn : exn));
  _w := io.await(s.write_string(`PUT /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n`, io), IoExn(io : io, exn : exn));
  raw := io.await(_read_all(s, io), IoExn(io : io, exn : exn));
  assert(raw.starts_with(`HTTP/1.1 200 OK\r\n`), `status line: ${raw}`);
  assert(raw.ends_with(`PUT /c tag=- body=[abcde]`), `decoded body reached the handler: ${raw}`);
  io.await(s.close(io), IoExn(io : io, exn : exn));
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("a request that does not parse gets 400 with the reason, handler not called", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19973)), io), IoExn(io : io, exn : exn));
  called := ArrayList(i32).new();
  task := io.spawn(
    server.serve_once(req => {
      called.push(i32(1));
      HttpResponse.with_status(i32(200))
    }, io),
    IoExn(io : io, exn : exn)
  );
  s := io.await(TcpStream.connect(SocketAddr.loopback(u16(19973)), io), IoExn(io : io, exn : exn));
  _w := io.await(s.write_string(`BREW /pot HTTP/1.1\r\nHost: x\r\n\r\n`, io), IoExn(io : io, exn : exn));
  raw := io.await(_read_all(s, io), IoExn(io : io, exn : exn));
  assert(raw.starts_with(`HTTP/1.1 400 Bad Request\r\n`), `status line: ${raw}`);
  assert(raw.contains(`Unknown method: BREW`), `reason in body: ${raw}`);
  assert(called.len() == usize(0), "handler must not run for a malformed request");
  io.await(s.close(io), IoExn(io : io, exn : exn));
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("serve loops until stop(); local_addr reports the bound port", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19974)), io), IoExn(io : io, exn : exn));
  assert(server.local_addr().port == u16(19974), `local_addr port ${server.local_addr().port}`);
  hits := ArrayList(i32).new();
  task := io.spawn(
    server.serve(req => {
      hits.push(i32(1));
      cond(
        (req.path == `/last`) => {
          server.stop();
        },
        true => ()
      );
      HttpResponse.with_status(i32(200)).with_body(`n=${hits.len()}`)
    }, io),
    IoExn(io : io, exn : exn)
  );
  r1 := io.await(fetch(`http://127.0.0.1:19974/a`, io), IoExn(io : io, exn : exn));
  r2 := io.await(fetch(`http://127.0.0.1:19974/b`, io), IoExn(io : io, exn : exn));
  r3 := io.await(fetch(`http://127.0.0.1:19974/last`, io), IoExn(io : io, exn : exn));
  assert((r1.body == "n=1") && ((r2.body == "n=2") && (r3.body == "n=3")), `three sequential requests: ${r1.body} ${r2.body} ${r3.body}`);
  task.await(io);
  assert(hits.len() == usize(3), "serve returned after stop()");
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
// The request direction of the binary-body pin: parse_request must slice the
// body at BYTE offsets without char-boundary checks — a body starting with a
// UTF-8 continuation byte used to panic the boundary-checked substring.
test("the server round-trips a binary request body byte-for-byte", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  srv := io.await(HttpServer.bind(SocketAddr.loopback(u16(19979)), io), IoExn(io : io, exn : exn));
  task := io.spawn(
    srv.serve_once(req => {
      resp := HttpResponse.with_status(i32(200)).with_body(req.body);
      resp
    }, io),
    IoExn(io : io, exn : exn)
  );
  payload := ArrayList(u8).new();
  payload.push(u8(0x80));
  payload.push(u8(0));
  payload.push(u8(0xFF));
  payload.push(u8(66));
  body := String.from_bytes(payload);
  opts := FetchOptions.new().with_method(HttpMethod.POST).with_body(body);
  r := io.await(fetch_with(`http://127.0.0.1:19979/echo`, opts, io), IoExn(io : io, exn : exn));
  task.await(io);
  io.await(srv.close(io), IoExn(io : io, exn : exn));
  assert(r.status_code == i32(200), "200");
  got := r.body.as_bytes();
  assert(got.len() == usize(4), `echoed 4 bytes (got ${got.len()})`);
  assert(got(usize(0)) == u8(0x80), "continuation byte");
  assert(got(usize(3)) == u8(66), "B");
});
// ============================================================================
// RFC 9112 §5 field-line parsing (issues/fixed/http-content-length-ows-and-
// invalid-values.md). `field-line = field-name ":" OWS field-value OWS`: the
// whitespace after the colon is OPTIONAL and is any run of SP/HTAB. The scan
// used to step over the colon AND assume exactly one space, so
// `Content-Length:12000` read as 2000 and `Content-Length:5` read as "absent"
// — and a field name was matched anywhere in the header block, so
// `X-Content-Length` supplied the framing.
//
// The body is 12 000 bytes, past the 8 KiB the server reads at a time, so a
// mis-parsed length stops the read early and the handler sees a SHORT body.
// The handler reports the length and the last 8 bytes; both must survive.
test("Content-Length framing: OWS after the colon is optional, and only a real field line counts", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19980)), io), IoExn(io : io, exn : exn));
  task := io.spawn(
    server.serve(req => {
      cond(
        (req.path == `/last`) => {
          server.stop();
        },
        true => ()
      );
      n := req.body.len();
      tail := cond(
        (n >= usize(8)) => req.body.substring(n - usize(8), n),
        true => req.body
      );
      HttpResponse.with_status(i32(200)).with_body(`${n}|${tail}`)
    }, io),
    IoExn(io : io, exn : exn)
  );
  body := _big_body();
  want := `12000|23456789`;
  // No OWS at all — the shape that used to lose the value's first digit.
  r1 := io.await(_raw_exchange(u16(19980), `POST /nows HTTP/1.1\r\nHost: x\r\nContent-Length:12000\r\n\r\n${body}`, io), IoExn(io : io, exn : exn));
  assert(r1.ends_with(want), `Content-Length:12000 (no OWS): ${r1}`);
  // More than one space.
  r2 := io.await(_raw_exchange(u16(19980), `POST /spaces HTTP/1.1\r\nHost: x\r\nContent-Length:   12000\r\n\r\n${body}`, io), IoExn(io : io, exn : exn));
  assert(r2.ends_with(want), `Content-Length:   12000 (three spaces): ${r2}`);
  // A tab is OWS too.
  r3 := io.await(_raw_exchange(u16(19980), `POST /tab HTTP/1.1\r\nHost: x\r\nContent-Length:\t12000\r\n\r\n${body}`, io), IoExn(io : io, exn : exn));
  assert(r3.ends_with(want), `Content-Length:<TAB>12000: ${r3}`);
  // Trailing OWS is not part of the value.
  r4 := io.await(_raw_exchange(u16(19980), `POST /trailing HTTP/1.1\r\nHost: x\r\nContent-Length: 12000 \t \r\n\r\n${body}`, io), IoExn(io : io, exn : exn));
  assert(r4.ends_with(want), `Content-Length: 12000<SP><TAB><SP>: ${r4}`);
  // A DIFFERENT field whose name ends in the one we want must not supply the
  // framing — a field name has to START its line.
  r5 := io.await(_raw_exchange(u16(19980), `POST /hijack HTTP/1.1\r\nX-Content-Length: 3\r\nContent-Length: 12000\r\n\r\n${body}`, io), IoExn(io : io, exn : exn));
  assert(r5.ends_with(want), `X-Content-Length must not frame the body: ${r5}`);
  // The canonical spelling still works (baseline against over-rejection).
  r6 := io.await(_raw_exchange(u16(19980), `POST /last HTTP/1.1\r\nHost: x\r\nContent-Length: 12000\r\n\r\n${body}`, io), IoExn(io : io, exn : exn));
  assert(r6.ends_with(want), `Content-Length: 12000 (canonical): ${r6}`);
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
// The same anchoring rule for Transfer-Encoding. `X-Transfer-Encoding:
// chunked` ENDS with the field name, so the old substring search turned on
// chunked decoding for a body that is not chunked: the request died with a
// typed MalformedChunkedBody instead of being served. The request TARGET is
// part of the start-line and is not a field line either.
test("only a real Transfer-Encoding field line turns on chunked decoding", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19981)), io), IoExn(io : io, exn : exn));
  task := io.spawn(
    server.serve(req => {
      cond(
        (req.path == `/xte`) => {
          server.stop();
        },
        true => ()
      );
      HttpResponse.with_status(i32(200)).with_body(`${req.path} body=[${req.body}]`)
    }, io),
    IoExn(io : io, exn : exn)
  );
  r1 := io.await(
    _raw_exchange(u16(19981), `POST /transfer-encoding:chunked HTTP/1.1\r\nHost: x\r\nContent-Length: 2\r\n\r\nzz`, io),
    IoExn(io : io, exn : exn)
  );
  assert(r1.ends_with(`/transfer-encoding:chunked body=[zz]`), `a request target is not a header field: ${r1}`);
  r2 := io.await(
    _raw_exchange(u16(19981), `POST /xte HTTP/1.1\r\nX-Transfer-Encoding: chunked\r\nContent-Length: 2\r\n\r\nzz`, io),
    IoExn(io : io, exn : exn)
  );
  assert(r2.ends_with(`/xte body=[zz]`), `X-Transfer-Encoding is a different field: ${r2}`);
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
// issues/fixed/one-malformed-request-killed-http-server-serve.md: a framing
// defect used to THROW out of `serve` and end the server. It is the client's
// error: answer it and take the next connection.
test("a request with an unreadable Content-Length gets 400 and serve keeps serving", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19976)), io), IoExn(io : io, exn : exn));
  hits := ArrayList(i32).new();
  task := io.spawn(
    server.serve(req => {
      hits.push(i32(1));
      cond(
        (req.path == `/last`) => {
          server.stop();
        },
        true => ()
      );
      HttpResponse.with_status(i32(200)).with_body(`ok`)
    }, io),
    IoExn(io : io, exn : exn)
  );
  s := io.await(TcpStream.connect(SocketAddr.loopback(u16(19976)), io), IoExn(io : io, exn : exn));
  _w := io.await(s.write_string(`POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: abc\r\n\r\n`, io), IoExn(io : io, exn : exn));
  raw := io.await(_read_all(s, io), IoExn(io : io, exn : exn));
  assert(raw.starts_with(`HTTP/1.1 400 Bad Request\r\n`), `status line: ${raw}`);
  assert(raw.contains(`Content-Length`), `reason names the header: ${raw}`);
  io.await(s.close(io), IoExn(io : io, exn : exn));
  assert(hits.len() == usize(0), "handler must not run for a malformed frame");
  // The server is still there for the next client.
  r := io.await(fetch(`http://127.0.0.1:19976/last`, io), IoExn(io : io, exn : exn));
  assert(r.status_code == i32(200), `next request served: ${r.status_code}`);
  task.await(io);
  assert(hits.len() == usize(1), "exactly the good request reached the handler");
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("a request over max_request_bytes gets 413 and serve keeps serving", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(HttpServer.bind(SocketAddr.loopback(u16(19977)), io), IoExn(io : io, exn : exn)).with_max_request_bytes(usize(64));
  task := io.spawn(
    server.serve(req => {
      cond(
        (req.path == `/last`) => {
          server.stop();
        },
        true => ()
      );
      HttpResponse.with_status(i32(200)).with_body(`ok`)
    }, io),
    IoExn(io : io, exn : exn)
  );
  s := io.await(TcpStream.connect(SocketAddr.loopback(u16(19977)), io), IoExn(io : io, exn : exn));
  big := `GET /aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa HTTP/1.1\r\nHost: x\r\n\r\n`;
  _w := io.await(s.write_string(big, io), IoExn(io : io, exn : exn));
  raw := io.await(_read_all(s, io), IoExn(io : io, exn : exn));
  assert(raw.starts_with(`HTTP/1.1 413 `), `status line: ${raw}`);
  io.await(s.close(io), IoExn(io : io, exn : exn));
  r := io.await(fetch(`http://127.0.0.1:19977/last`, io), IoExn(io : io, exn : exn));
  assert(r.status_code == i32(200), `next request served: ${r.status_code}`);
  task.await(io);
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
