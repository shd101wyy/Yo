pragma(Pragma.SkipWasm32Emscripten); // https needs a network stack + TLS
pragma(Pragma.SkipWasm32Wasi); // https needs a network stack + TLS
// Windows used to skip this whole file because https had no backend there
// (OpenSSL is absent on the runners). The Schannel backend closed that
// (plans/D6_TLS_PLAN.md item 3), so every test here — the loopback client,
// the server, chunked bodies AND the live https fetch — now runs on Windows.
{ assert, panic } :: import("std/assert");
{ HttpMethod, HttpRequest, HttpResponse, parse_response } :: import("std/http/http");
{ HttpHeader, http_status_text } :: import("std/http/http");
{ fetch, fetch_with, FetchOptions } :: import("std/http/client");
{ Exception, IoExn } :: import("std/error");
{ println, eprintln } :: import("std/fmt");
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
{ TcpListener, TcpStream } :: import("std/net/tcp");
{ SocketAddr } :: import("std/net/addr");
{ Duration } :: import("std/time/duration");
{ sleep } :: import("std/time/sleep");
{ env } :: import("std/env");
/// True where a network failure is a REAL failure rather than "this box has
/// no egress": GitHub Actions and essentially every other CI sets `CI`.
///
/// A capture-free `->` handler may not read a runtime local, but it CAN call
/// a module-level binding (#396) — hence a module-level fn.
_network_required :: (fn() -> bool)(env.get("CI").is_some());
pragma(Pragma.AllowUnsafe);
test("HttpRequest build GET request", {
  req := HttpRequest.new(HttpMethod.GET, `/index.html`);
  req.set_host(`example.com`);
  s := req.to_string();
  assert(s.contains(`GET /index.html HTTP/1.1`), "should contain request line");
  assert(s.contains(`Host: example.com`), "should contain host header");
});
test("HttpRequest build POST with body", {
  req := HttpRequest.new(HttpMethod.POST, `/api/data`);
  req.set_host(`api.example.com`);
  req.set_body(`body_data`);
  s := req.to_string();
  assert(s.contains(`POST /api/data HTTP/1.1`), "should contain POST request line");
  assert(s.contains(`Host: api.example.com`), "should contain host");
  assert(s.contains(`body_data`), "should contain body");
});
test("HttpRequest set multiple headers", {
  req := HttpRequest.new(HttpMethod.GET, `/`);
  req.set_header(`Accept`, `text/html`);
  req.set_header(`User-Agent`, `YoHTTP/1.0`);
  req.set_header(`Connection`, `close`);
  s := req.to_string();
  assert(s.contains(`Accept: text/html`), "should contain Accept header");
  assert(s.contains(`User-Agent: YoHTTP/1.0`), "should contain User-Agent header");
  assert(s.contains(`Connection: close`), "should contain Connection header");
});
test("HttpRequest to_string format", {
  req := HttpRequest.new(HttpMethod.GET, `/path`);
  req.set_host(`host.com`);
  s := req.to_string();
  assert(s.starts_with(`GET /path HTTP/1.1`), "should start with request line");
  assert(s.contains(`Host: host.com`), "should contain host header");
});
test("Parse simple HTTP response", {
  raw := `HTTP/1.1 200 OK\r\n\r\n`;
  result := parse_response(raw);
  assert(result.is_ok(), "should parse successfully");
  resp := result.unwrap();
  assert(resp.status_code == i32(200), "status code should be 200");
  assert(resp.status_text == `OK`, "status text should be OK");
});
test("Parse response with headers", {
  raw := `HTTP/1.1 404 Not Found\r\nContent-Type: text/html\r\nX-Custom: hello\r\n\r\n`;
  result := parse_response(raw);
  assert(result.is_ok(), "should parse successfully");
  resp := result.unwrap();
  assert(resp.status_code == i32(404), "status code should be 404");
  assert(resp.status_text == `Not Found`, "status text should be Not Found");
  assert(resp.headers.len() == usize(2), "should have 2 headers");
});
test("Parse response with body", {
  raw := `HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nHello World`;
  result := parse_response(raw);
  assert(result.is_ok(), "should parse successfully");
  resp := result.unwrap();
  assert(resp.status_code == i32(200), "status code should be 200");
  assert(resp.body == `Hello World`, "body should match");
});
test("HttpResponse get_header case-insensitive", {
  raw := `HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nX-Request-Id: abc123\r\n\r\n`;
  result := parse_response(raw);
  assert(result.is_ok(), "should parse successfully");
  resp := result.unwrap();
  ct := resp.get_header(`content-type`);
  assert(ct.is_some(), "should find content-type lowercase");
  assert(ct.unwrap() == `text/html`, "content-type value should match");
  ct2 := resp.get_header(`CONTENT-TYPE`);
  assert(ct2.is_some(), "should find CONTENT-TYPE uppercase");
  assert(ct2.unwrap() == `text/html`, "content-type value should match uppercase");
  xr := resp.get_header(`x-request-id`);
  assert(xr.is_some(), "should find x-request-id");
  assert(xr.unwrap() == `abc123`, "x-request-id value should match");
  missing := resp.get_header(`Authorization`);
  assert(missing.is_none(), "missing header should be None");
});
test("HttpMethod enum values", {
  m_get := HttpMethod.GET;
  m_post := HttpMethod.POST;
  m_put := HttpMethod.PUT;
  m_del := HttpMethod.DELETE;
  m_head := HttpMethod.HEAD;
  m_patch := HttpMethod.PATCH;
  assert(m_get.to_string() == `GET`, "GET to_string");
  assert(m_post.to_string() == `POST`, "POST to_string");
  assert(m_put.to_string() == `PUT`, "PUT to_string");
  assert(m_del.to_string() == `DELETE`, "DELETE to_string");
  assert(m_head.to_string() == `HEAD`, "HEAD to_string");
  assert(m_patch.to_string() == `PATCH`, "PATCH to_string");
});
test("fetch still refuses an unsupported scheme", {
  // http and https are supported (https over TLS as of D6); anything else
  // must throw UnsupportedScheme BEFORE any DNS or socket work. ftp:// to
  // 127.0.0.1:1 would be an instant connection-refused if it slipped past
  // the scheme check.
  exn := Exception(
    throw : (
      err -> {
        msg := err.to_string();
        assert(msg.contains(`Unsupported scheme`), `expected UnsupportedScheme, got: ${msg}`);
        unwind(());
      }
    )
  );
  _r := io.await(fetch(`ftp://127.0.0.1:1/`, io), IoExn(io : io, exn : exn));
  assert(false, "fetch(ftp) must throw UnsupportedScheme");
});
test("fetch over https returns a real response (mandatory under CI)", {
  // https speaks TLS (D6: OpenSSL on unix, Schannel on Windows). A box with
  // no egress SKIPS; under CI a failure is a FAILURE — the old handler
  // unwound out of the test on every error, so a broken TLS stack passed
  // with no assertion at all
  // (issues/fixed/live-tls-tests-pass-vacuously-when-the-handshake-fails.md).
  reached := Box(bool)(false);
  ok := Box(bool)(false);
  exn := Exception(
    throw : (
      err -> {
        detail := err.to_string();
        cond(
          _network_required() => {
            // eprintln, not println: a buffered println is lost when the
            // panic below aborts the test child.
            eprintln(`  https fetch FAILED where the network is required: ${detail}`);
            panic(`https fetch failed under CI — see the message above`);
          },
          true => {
            println(`  https fetch skipped (no egress?): ${detail}`);
            unwind(());
          }
        );
      }
    )
  );
  resp := io.await(fetch(`https://example.com`.to_string(), io), IoExn(io : io, exn : exn));
  reached.* = true;
  status_ok := (resp.status_code == i32(200));
  body_ok := (resp.body.len() > usize(0));
  good := (status_ok && body_ok);
  ok.* = good;
  cond(
    reached.* => assert(ok.*, `expected a 200 with a body over https, got ${resp.status_code}`),
    true => assert(true, "skipped: no network")
  );
});

// ============================================================================
// C33 — the three HttpError variants that used to be unreachable
// (issues/http-client-error-variants-never-raised.md). Each test runs a tiny
// loopback server as a spawned task and drives `fetch_with` on the test's
// own stack, so a thrown HttpError lands in the test's handler.
// ============================================================================
// Read one request off an accepted stream (a single read is enough for the
// small requests fetch_with sends). An io.async future, not a plain fn with an
// await inside — the latter is a nested blocking event loop and deadlocks
// when called from the server TASK while the client waits underneath it
// (issues/fixed/sync-await-in-plain-fn-nests-the-event-loop.md).
// True once `b` ends with the CRLFCRLF that closes a request's header section.
// Every request these servers receive is body-less, so that is the whole
// message.
_ends_headers :: (fn(b : ArrayList(u8)) -> bool)({
  n := b.len();
  cond(
    (n < usize(4)) => false,
    true =>
      (
        (b(n - usize(4)) == u8(13)) && (b(n - usize(3)) == u8(10)) &&
          (b(n - usize(2)) == u8(13)) && (b(n - usize(1)) == u8(10))
      )
  )
});
// Read a whole request, not just whatever the first `read` happened to return.
// A single read is not enough for two separate reasons: a request can arrive
// split across TCP segments, and bytes left sitting in the socket's receive
// queue turn a later `close()` into an RST, which discards the response the
// client has not read yet. Both make a server that answers correctly look like
// one that did not.
_read_request :: (fn(stream : TcpStream, io : Io) -> Impl(Future(String, IoExn)))(
  io.async(e => {
    buf := *(u8)(malloc(usize(4096)).unwrap());
    bytes := ArrayList(u8).new();
    eof := false;
    while(runtime(!eof && !_ends_headers(bytes)), {
      n := e.io.await(stream.read(buf, usize(4096), e.io), e);
      cond(
        (n == usize(0)) => {
          eof = true;
        },
        true => {
          i := usize(0);
          while(runtime(i < n), {
            bytes.push((buf.add(i)).*);
            i = (i + usize(1));
          });
        }
      );
    });
    free(.Some(*(void)(buf)));
    String.from_bytes(bytes)
  })
);
// Serve `responses` in order, one connection each, recording every request
// line into `seen`. Runs as a spawned task.
_serve_scripted :: (
  fn(listener : TcpListener, responses : ArrayList(String), seen : ArrayList(String), io : Io) ->
    Impl(Future(unit, IoExn))
)(
  io.async(e => {
    k := usize(0);
    while(runtime(k < responses.len()), {
      s := e.io.await(listener.accept(e.io), e);
      req := e.io.await(_read_request(s, e.io), e);
      seen.push(req);
      _w := e.io.await(s.write_string(responses(k), e.io), e);
      e.io.await(s.close(e.io), e);
      k = (k + usize(1));
    });
    return(());
  })
);
_redirect_to :: (fn(location : String) -> String)(
  `HTTP/1.1 302 Found\r\nLocation: ${location}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n`
);
_ok_body :: (fn(body : String) -> String)(
  `HTTP/1.1 200 OK\r\nContent-Length: ${body.len()}\r\nConnection: close\r\n\r\n${body}`
);
test("fetch follows redirects, resolving relative and absolute-path Locations", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19960));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  responses := ArrayList(String).new();
  responses.push(_redirect_to(`next`)); // relative → /dir/next
  responses.push(_redirect_to(`/final`)); // absolute path → /final
  responses.push(_ok_body(`done`));
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  resp := io.await(fetch_with(`http://127.0.0.1:19960/dir/start`, FetchOptions.new(), io), IoExn(io : io, exn : exn));
  assert(resp.status_code == i32(200), `final status should be 200, got ${resp.status_code}`);
  assert(resp.body == "done", `final body should be the last hop's, got "${resp.body}"`);
  assert(seen.len() == usize(3), `three requests should have been made, saw ${seen.len()}`);
  assert(seen(usize(0)).starts_with(`GET /dir/start HTTP/1.1`), `hop 0: ${seen(usize(0))}`);
  assert(seen(usize(1)).starts_with(`GET /dir/next HTTP/1.1`), `relative Location must resolve against the base directory: ${seen(usize(1))}`);
  assert(seen(usize(2)).starts_with(`GET /final HTTP/1.1`), `absolute-path Location must resolve against the origin: ${seen(usize(2))}`);
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
test("fetch throws TooManyRedirects past max_redirects", {
  exn := Exception(
    throw : (
      err -> {
        msg := err.to_string();
        assert(msg.contains(`Too many redirects`), `expected TooManyRedirects, got: ${msg}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19961));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  responses := ArrayList(String).new();
  responses.push(_redirect_to(`/again`));
  responses.push(_redirect_to(`/again`));
  responses.push(_redirect_to(`/again`));
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  // max_redirects 2: hop 0 → hop 1 → hop 2 is the third 3xx, one too many.
  opts := FetchOptions.new().with_max_redirects(usize(2));
  _r := io.await(fetch_with(`http://127.0.0.1:19961/start`, opts, io), IoExn(io : io, exn : exn));
  assert(false, "fetch must throw TooManyRedirects");
});
test("fetch with max_redirects 0 returns the 3xx verbatim", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19962));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  responses := ArrayList(String).new();
  responses.push(_redirect_to(`/elsewhere`));
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  opts := FetchOptions.new().with_max_redirects(usize(0));
  resp := io.await(fetch_with(`http://127.0.0.1:19962/start`, opts, io), IoExn(io : io, exn : exn));
  assert(resp.status_code == i32(302), `the 3xx itself should come back, got ${resp.status_code}`);
  assert(match(resp.get_header(`Location`), .Some(l) => (l == "/elsewhere"), .None => false), "Location header should be preserved");
  assert(seen.len() == usize(1), "exactly one request");
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
test("fetch throws ResponseTooLarge past max_response_bytes", {
  exn := Exception(
    throw : (
      err -> {
        msg := err.to_string();
        assert(msg.contains(`Response too large`), `expected ResponseTooLarge, got: ${msg}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19963));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  body := String.new();
  i := usize(0);
  while(runtime(i < usize(300)), {
    body.push_str("x");
    i = (i + usize(1));
  });
  responses := ArrayList(String).new();
  responses.push(_ok_body(body));
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  opts := FetchOptions.new().with_max_response_bytes(usize(100));
  _r := io.await(fetch_with(`http://127.0.0.1:19963/big`, opts, io), IoExn(io : io, exn : exn));
  assert(false, "fetch must throw ResponseTooLarge");
});
test("fetch default response ceiling is 64 MiB and 0 lifts it", {
  d := FetchOptions.new();
  assert(d.max_response_bytes == usize(67108864), "default ceiling is 64 MiB");
  assert(d.max_redirects == usize(10), "default redirect cap is 10");
  assert(match(d.timeout, .None => true, .Some(_) => false), "no deadline by default");
  unlimited := FetchOptions.new().with_max_response_bytes(usize(0));
  assert(unlimited.max_response_bytes == usize(0), "0 = unlimited");
});
// A server that accepts and then never answers — the case a deadline exists
// for: fetch is parked inside a read that will not return on its own.
_serve_silent :: (fn(listener : TcpListener, hold : Duration, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    s := e.io.await(listener.accept(e.io), e);
    _req := e.io.await(_read_request(s, e.io), e);
    e.io.await(sleep(hold, e.io), e.io);
    e.io.await(s.close(e.io), e);
    return(());
  })
);
test("fetch throws Timeout when the server never answers", {
  exn := Exception(
    throw : (
      err -> {
        msg := err.to_string();
        assert(msg.contains(`timed out`), `expected Timeout, got: ${msg}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19964));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  server := io.spawn(_serve_silent(listener, Duration.from_millis(i64(400)), io), IoExn(io : io, exn : exn));
  opts := FetchOptions.new().with_timeout(Duration.from_millis(i64(100)));
  _r := io.await(fetch_with(`http://127.0.0.1:19964/hang`, opts, io), IoExn(io : io, exn : exn));
  assert(false, "fetch must throw Timeout");
});
// ============================================================================
// Transfer-Encoding: chunked (plans/STD_API_AUDIT.md §7 P1 "chunked client";
// issues/fixed/http-client-does-not-decode-chunked-bodies.md). The body must
// be the concatenated chunk DATA — no hex sizes, no chunk extensions, no
// trailers — and the read must stop at the terminating `0\r\n\r\n`.
// ============================================================================
_hex :: (fn(n : usize) -> String)({
  digits := `0123456789abcdef`;
  cond(
    (n == usize(0)) => `0`,
    true => {
      s := String.new();
      m := n;
      while(m > usize(0), m = (m / usize(16)), {
        s = `${digits.substring(m % usize(16), (m % usize(16)) + usize(1))}${s}`;
      });
      s
    }
  )
});
_chunked :: (fn(chunks : ArrayList(String), trailer : String) -> String)({
  out := `HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n`;
  i := usize(0);
  while(i < chunks.len(), i = (i + usize(1)), {
    c := chunks(i);
    out = `${out}${_hex(c.as_bytes().len())}\r\n${c}\r\n`;
  });
  `${out}0\r\n${trailer}\r\n`
});
test("fetch decodes a chunked body (sizes, extensions and trailers stripped)", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19965));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  chunks := ArrayList(String).new();
  chunks.push(`hello, `);
  chunks.push(`chunked `);
  chunks.push(`world — 16+ bytes so a size needs two hex digits`);
  responses := ArrayList(String).new();
  responses.push(_chunked(chunks, `X-Trailer: t\r\n`));
  // Same body, but the first chunk carries a chunk extension (`;name=value`)
  // and sizes use UPPER-case hex — both legal per RFC 9112 §7.1.
  responses.push(`HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n7;ext=1\r\nhello, \r\nA\r\nchunked!!!\r\n0\r\n\r\n`);
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  r1 := io.await(fetch_with(`http://127.0.0.1:19965/one`, FetchOptions.new(), io), IoExn(io : io, exn : exn));
  assert(r1.status_code == i32(200), `status ${r1.status_code}`);
  assert(r1.body == "hello, chunked world — 16+ bytes so a size needs two hex digits", `decoded body, got "${r1.body}"`);
  assert(r1.get_header(`Transfer-Encoding`).is_some(), `the header itself is kept`);
  r2 := io.await(fetch_with(`http://127.0.0.1:19965/two`, FetchOptions.new(), io), IoExn(io : io, exn : exn));
  assert(r2.body == "hello, chunked!!!", `chunk extension + upper-case size, got "${r2.body}"`);
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
// The throwing fetch runs as its OWN spawned task: its handler unwinds that
// task only, `JoinHandle.await` then yields `.None` for the unwound task, and
// the test joins the server and closes the listener on the normal path.
// Unwinding out of the test body itself left the server task parked in
// `accept` on a never-closed listener, which keeps the Linux event loop alive
// after the last test — the process never exited (hollow sweep rc=124).
test("a malformed chunk size is a typed HttpError, not a garbage body", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  // Capture-free by design (handlers are frame-bound): it can only unwind.
  chunk_exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19966));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  responses := ArrayList(String).new();
  responses.push(`HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\nzz\r\nhello\r\n0\r\n\r\n`);
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  client := io.spawn(fetch_with(`http://127.0.0.1:19966/bad`, FetchOptions.new(), io), IoExn(io : io, exn : chunk_exn));
  outcome := client.await(io);
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  assert(match(outcome, .None => true, .Some(r) => false), `a non-hex chunk size must throw (task unwound → None)`);
  assert(seen.len() == usize(1), "the server saw exactly one request");
});
// A garbage status line surfaces as `HttpError.Other("Invalid status line")`.
// Also the production pin for
// issues/fixed/async-scope-end-drop-then-escape-double-drop.md: `_fetch_once`
// throws AFTER its transport branch (addrs/addr/stream) has closed, and the
// state machine's dispose used to release those locals a second time — the
// heap-use-after-free behind the Linux crash of this file's sweep. The client
// runs as its own task so the test body survives the throw and the task's
// dispose happens while the test is still watching.
test("fetch throws Other on a garbage status line, and the aborted task disposes cleanly", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  // Capture-free by design (handlers are frame-bound): it can only unwind.
  garbage_exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19967));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  responses := ArrayList(String).new();
  responses.push(`garbage\r\n\r\n`);
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  (outcome : Option(HttpResponse)) = Option(HttpResponse).None;
  {
    client := io.spawn(fetch_with(`http://127.0.0.1:19967/garbage`, FetchOptions.new(), io), IoExn(io : io, exn : garbage_exn));
    outcome = client.await(io);
  };
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  assert(match(outcome, .None => true, .Some(r) => false), `a garbage status line must throw (task unwound → None)`);
  assert(seen.len() == usize(1), "the server saw exactly one request");
});
// `body : String` is a byte-transparent buffer (String is unvalidated bytes;
// len()/substring are byte-indexed since D4), so HTTP bodies may carry
// arbitrary binary: NULs, invalid UTF-8 (a lone 0x80 continuation byte, an
// 0xFF), and embedded CRLFs must survive fetch verbatim. Pins the audit's
// "binary bodies" row.
test("fetch round-trips a binary body byte-for-byte", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  payload := ArrayList(u8).new();
  payload.push(u8(0x80)); // a bare continuation byte — invalid UTF-8 first
  payload.push(u8(0));
  payload.push(u8(13));
  payload.push(u8(10));
  payload.push(u8(13));
  payload.push(u8(10));
  payload.push(u8(0xFF));
  payload.push(u8(65));
  body := String.from_bytes(payload);
  addr := SocketAddr.loopback(u16(19968));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  responses := ArrayList(String).new();
  responses.push(`HTTP/1.1 200 OK\r\nContent-Length: ${body.len()}\r\nConnection: close\r\n\r\n${body}`);
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  r := io.await(fetch_with(`http://127.0.0.1:19968/bin`, FetchOptions.new(), io), IoExn(io : io, exn : exn));
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  assert(r.status_code == i32(200), "200");
  got := r.body.as_bytes();
  assert(got.len() == usize(8), `body is 8 bytes (got ${got.len()})`);
  assert(got(usize(0)) == u8(0x80), "leading continuation byte survives");
  assert(got(usize(1)) == u8(0), "NUL survives");
  assert(got(usize(2)) == u8(13), "embedded CR survives");
  assert(got(usize(6)) == u8(0xFF), "0xFF survives");
  assert(got(usize(7)) == u8(65), "trailing ASCII");
});
// ============================================================================
// RFC 9112 §5 field-line parsing (issues/fixed/http-content-length-ows-and-
// invalid-values.md). Every test above closes the connection after the
// response, so close-delimiting hid a Content-Length the client could not
// read. These hold the connection open — HTTP/1.1's default — so the header
// is the ONLY thing that can end the message, and a deadline turns a
// mis-parse into a Timeout instead of a hang.
// ============================================================================
// Write `response`, then TRAILING BYTES, on one connection, and close.
//
// The trailing bytes are the whole point. If the client frames the message by
// its `Content-Length` it stops at the declared length and never sees them; if
// it instead reads to EOF, they land in the body and the assertion below fails
// on a VALUE. That is what makes these two tests deadline-free: the earlier
// shape held the connection open and gave the client a timeout budget, so a
// loaded runner could lose the race and abort the whole test binary
// (measured on ubuntu-latest and macos-26-intel) without saying why.
// Response AND trailing bytes in ONE write. `_serve_then_trailing` writes them
// separately, so whether they reach the client in a single `read` is the
// platform's write-coalescing decision — which is exactly how the over-read
// below hid: it failed on one CI runner and passed on the other five.
_serve_one_write :: (fn(listener : TcpListener, payload : String, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    s := e.io.await(listener.accept(e.io), e);
    _req := e.io.await(_read_request(s, e.io), e);
    _w := e.io.await(s.write_string(payload, e.io), e);
    e.io.await(s.close(e.io), e);
    return(());
  })
);
_serve_then_trailing :: (
  fn(listener : TcpListener, response : String, trailing : String, io : Io) ->
    Impl(Future(unit, IoExn))
)(
  io.async(e => {
    s := e.io.await(listener.accept(e.io), e);
    _req := e.io.await(_read_request(s, e.io), e);
    _w := e.io.await(s.write_string(response, e.io), e);
    _t := e.io.await(s.write_string(trailing, e.io), e);
    e.io.await(s.close(e.io), e);
    return(());
  })
);
test("a kept-alive response is framed by a Content-Length written without OWS", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  // Capture-free by design (handlers are frame-bound): it can only unwind — so
  // it PRINTS first. A silent unwind here reaches the assertion below as a bare
  // `.None`, which says the test failed but not what threw.
  report_exn := Exception(
    throw : (
      err -> {
        println(`  [no-OWS client] ${err.to_string()}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19969));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  server := io.spawn(
    _serve_then_trailing(
      listener,
      `HTTP/1.1 200 OK\r\nContent-Length:5\r\n\r\nhello`,
      `TRAILING-MUST-NOT-BE-READ`,
      io
    ),
    IoExn(io : io, exn : report_exn)
  );
  client := io.spawn(
    fetch_with(`http://127.0.0.1:19969/nows`, FetchOptions.new(), io),
    IoExn(io : io, exn : report_exn)
  );
  outcome := client.await(io);
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  assert(
    match(outcome, .Some(r) => (r.body == "hello"), .None => false),
    `a single-digit Content-Length with no space after the colon must end the message`
  );
});
test("only a real Content-Length field line frames a kept-alive response", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  // Capture-free by design (handlers are frame-bound): prints, then unwinds.
  report_exn := Exception(
    throw : (
      err -> {
        println(`  [X-CL client] ${err.to_string()}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19975));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  // `X-Content-Length` ENDS with the name we want; the old unanchored match
  // picked it up and asked for 99 bytes of a 5-byte body.
  server := io.spawn(
    _serve_then_trailing(
      listener,
      `HTTP/1.1 200 OK\r\nX-Content-Length: 99\r\nContent-Length: 5\r\n\r\nhello`,
      `TRAILING-MUST-NOT-BE-READ`,
      io
    ),
    IoExn(io : io, exn : report_exn)
  );
  client := io.spawn(
    fetch_with(`http://127.0.0.1:19975/hijack`, FetchOptions.new(), io),
    IoExn(io : io, exn : report_exn)
  );
  outcome := client.await(io);
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  assert(
    match(outcome, .Some(r) => (r.body == "hello"), .None => false),
    `X-Content-Length must not frame the message`
  );
});
// RFC 9112 §11.2: a framed message ends where its framing says it ends. The
// read loop STOPPED at the boundary but returned the whole buffer, so bytes the
// peer sent after the body were handed on AS body — response smuggling, and a
// heisenbug, because it only shows when the two writes coalesce into one read.
test("bytes after a Content-Length body are not part of the body", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  // Capture-free by design (handlers are frame-bound): prints, then unwinds.
  report_exn := Exception(
    throw : (
      err -> {
        println(`  [smuggle client] ${err.to_string()}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19982));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  server := io.spawn(
    _serve_one_write(listener, `HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhelloHTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nbad`, io),
    IoExn(io : io, exn : report_exn)
  );
  client := io.spawn(
    fetch_with(`http://127.0.0.1:19982/smuggle`, FetchOptions.new(), io),
    IoExn(io : io, exn : report_exn)
  );
  outcome := client.await(io);
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  body := match(outcome, .Some(r) => r.body, .None => `<client unwound>`);
  assert(body == "hello", `body must stop at Content-Length, got [${body}]`);
});
// RFC 9112 §6.3: a Content-Length that is present but unreadable is an
// unrecoverable framing error. It used to fall back to -1 — "no such header" —
// so the message was framed by whatever the peer did next.
test("an unreadable Content-Length is a typed HttpError, not a silent absence", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  // Capture-free by design (handlers are frame-bound): it can only unwind.
  bad_cl_exn := Exception(
    throw : (
      err -> {
        msg := err.to_string();
        assert(msg.contains(`Malformed Content-Length`), `expected MalformedContentLength, got: ${msg}`);
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19976));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  responses := ArrayList(String).new();
  responses.push(`HTTP/1.1 200 OK\r\nContent-Length: abc\r\nConnection: close\r\n\r\nhello`);
  responses.push(`HTTP/1.1 200 OK\r\nContent-Length: -5\r\nConnection: close\r\n\r\nhello`);
  responses.push(`HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 9\r\nConnection: close\r\n\r\nhello`);
  seen := ArrayList(String).new();
  server := io.spawn(_serve_scripted(listener, responses, seen, io), IoExn(io : io, exn : exn));
  c1 := io.spawn(fetch_with(`http://127.0.0.1:19976/garbage`, FetchOptions.new(), io), IoExn(io : io, exn : bad_cl_exn));
  o1 := c1.await(io);
  c2 := io.spawn(fetch_with(`http://127.0.0.1:19976/negative`, FetchOptions.new(), io), IoExn(io : io, exn : bad_cl_exn));
  o2 := c2.await(io);
  c3 := io.spawn(fetch_with(`http://127.0.0.1:19976/conflict`, FetchOptions.new(), io), IoExn(io : io, exn : bad_cl_exn));
  o3 := c3.await(io);
  server.await(io);
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  assert(match(o1, .None => true, .Some(r) => false), `"abc" is not a length and must throw (task unwound → None)`);
  assert(match(o2, .None => true, .Some(r) => false), `a negative Content-Length must throw`);
  assert(match(o3, .None => true, .Some(r) => false), `two Content-Length lines that disagree must throw`);
  assert(seen.len() == usize(3), `the server saw three requests, not ${seen.len()}`);
});
