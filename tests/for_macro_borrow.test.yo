{ assert } :: import("std/assert");
/// `for` macro runtime coverage — the value form `for(coll, (x) => body)`
/// across `Array(T, N)`, `ArrayList(T)`, `String`, and range copies, and the
/// BORROWED form `for(&mut coll, x => body)` / `for(&mut map, (k, v) => body)`
/// (plans/VALUES_BY_DEFAULT.md decision 39): the loop holds a local borrow
/// `c := &mut coll` and walks a cursor (`BorrowedWalk`) that holds no handle
/// to the collection; each element is a `&mut` local borrow of the
/// collection's storage (no per-element dup, in-place mutation). The body
/// naming the collection is decision 18's E0911. A container operation
/// reached through ANOTHER handle that could invalidate the element panics at
/// run time — pinned by tests/cli-cases/inout-for-* (the `yo test` runner has
/// no expected-panic assertion). User collections are covered by
/// tests/for_macro_borrow_user_collection.test.yo.
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ HashMap } :: import("std/collections/hash_map");
{ Deque } :: import("std/collections/deque");
{ LinkedList } :: import("std/collections/linked_list");
{ BTreeMap } :: import("std/collections/btree_map");
{ OrderedMap } :: import("std/collections/ordered_map");
{ HashSet } :: import("std/collections/hash_set");
test("for(arr, (x) => body) iterates and reads", {
  arr := [i32(1), i32(2), i32(3), i32(4)];
  sum := i32(0);
  for(arr, x => {
    sum = (sum + x);
  });
  assert(sum == i32(10), "sum of [1,2,3,4] = 10");
});
test("Array index writes mutate in place", {
  arr := [i32(1), i32(2), i32(3)];
  i := usize(0);
  while(i < usize(3), {
    arr(i) = (arr(i) * i32(10));
    i = (i + usize(1));
  });
  assert(arr(usize(0)) == i32(10), "0 -> 10");
  assert(arr(usize(1)) == i32(20), "1 -> 20");
  assert(arr(usize(2)) == i32(30), "2 -> 30");
});
test("for(arr, (x) => body) on zero-length array", {
  arr := Array(i32, 0)();
  count := i32(0);
  for(arr, x => {
    count = (count + i32(1));
    consume(x);
  });
  assert(count == i32(0), "empty array iterates zero times");
});
test("for-loop body interacts with outer locals", {
  arr := [i32(10), i32(20), i32(30)];
  hits := i32(0);
  threshold := i32(15);
  for(arr, x => {
    if(x > threshold, {
      hits = (hits + i32(1));
    });
  });
  assert(hits == i32(2), "two elements (20, 30) exceed threshold 15");
});
test("for(list, (x) => body) on ArrayList iterates and reads", {
  list := ArrayList(i32).new();
  list.push(i32(2));
  list.push(i32(3));
  list.push(i32(5));
  sum := i32(0);
  for(list, x => {
    sum = (sum + x);
  });
  assert(sum == i32(10), "ArrayList sum 2+3+5=10");
});
test("ArrayList index writes mutate in place", {
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  i := usize(0);
  while(i < list.len(), {
    list(i) = (list(i) * i32(10));
    i = (i + usize(1));
  });
  assert(list(usize(0)) == i32(10), "ArrayList 0 -> 10");
  assert(list(usize(1)) == i32(20), "ArrayList 1 -> 20");
  assert(list(usize(2)) == i32(30), "ArrayList 2 -> 30");
});
test("String elements mutate in place through the inout binding", {
  // `String` is a value: the value form `s => ...` borrows each element and
  // may not write it (E0908, `tests/cli-cases/inout-write-through-a-borrowed-for-is-e0908`).
  // The borrowed `inout` form writes the element in the list's buffer.
  names := ArrayList(String).new();
  names.push(String.from("a"));
  names.push(String.from("b"));
  for(&mut names, s => {
    s.push_str("!");
  });
  assert(match(names.get(usize(0)), .Some(s) => (s == "a!"), .None => false), "first mutated in place");
  assert(match(names.get(usize(1)), .Some(s) => (s == "b!"), .None => false), "second mutated in place");
});
test("for(s.bytes(), (b) => body) on String iterates and reads bytes", {
  s := `xyz`;
  total := i32(0);
  for(s.bytes(), b => {
    total = (total + i32(b));
  });
  // 'x'=120 + 'y'=121 + 'z'=122 = 363
  assert(total == i32(363), "String byte sum 120+121+122=363");
});
test("String bytes are rewritten through into_bytes / from_bytes (no byte index)", {
  s := `abc`;
  b := s.into_bytes();
  i := usize(0);
  while(i < b.len(), {
    b(i) = (b(i) + u8(1));
    i = (i + usize(1));
  });
  t := String.from_bytes(b);
  assert(t.byte_at(usize(0)) == u8(98), "'a' -> 'b'");
  assert(t.byte_at(usize(1)) == u8(99), "'b' -> 'c'");
  assert(t.byte_at(usize(2)) == u8(100), "'c' -> 'd'");
});
test("for(range-copy, (x) => body) iterates and reads", {
  arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];
  s := arr(usize(1) .. usize(4));
  sum := i32(0);
  for(s, x => {
    sum = (sum + x);
  });
  assert(sum == i32(90), "slice sum 20+30+40=90");
});
test("range-copy index writes stay in the copy", {
  // Ranges COPY (plans/archive/SLICE_REWORK.md): mutating the copy's elements
  // leaves the source array untouched.
  arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];
  s := arr(usize(1) .. usize(4));
  i := usize(0);
  while(i < s.len(), {
    s(i) = (s(i) * i32(10));
    i = (i + usize(1));
  });
  assert(arr(usize(1)) == i32(2), "source untouched");
  assert(match(s.get(usize(0)), .Some(v) => (v == i32(20)), .None => false), "copy 2 -> 20");
  assert(match(s.get(usize(2)), .Some(v) => (v == i32(40)), .None => false), "copy 4 -> 40");
});
test("break inside for(arr, (x) => body) exits the loop", {
  arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];
  hits := i32(0);
  for(arr, x => {
    cond(
      (x >= i32(30)) => break,
      true => {
        hits = (hits + i32(1));
      }
    );
  });
  assert(hits == i32(2), "saw arr[0] and arr[1] before breaking");
});
test("continue inside for(arr, (x) => body) skips one iteration", {
  arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];
  evens_sum := i32(0);
  for(arr, x => {
    cond(
      ((x % i32(2)) != i32(0)) => continue,
      true => {
        evens_sum = (evens_sum + x);
      }
    );
  });
  assert(evens_sum == i32(6), "2 + 4 = 6 (skipped odds)");
});
// The removed borrow form must fail with the teaching error, not a
// resolution mystery.
comptime_expect_error(
  borrow_form_is_removed :: (fn() -> unit)({
    arr := [i32(1), i32(2)];
    total := i32(0);
    for(&mut arr, x => {
      total = (total + x);
    });
    consume(total);
  })
);

// --- Borrowed form -------------------------------------------------------------
Enemy :: struct(hp : i32, name : String);
bump_i32 :: (fn(v : &mut i32) -> unit)({
  v = (v + i32(1));
});
test("for(list, inout(x) => body) mutates ArrayList elements in place", {
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  for(&mut list, x => {
    x = (x * i32(10));
  });
  assert(list(usize(0)) == i32(10), "0 -> 10");
  assert(list(usize(1)) == i32(20), "1 -> 20");
  assert(list(usize(2)) == i32(30), "2 -> 30");
  assert(list.len() == usize(3), "length untouched");
});
test("borrowed for over struct elements: field writes land in the buffer", {
  enemies := ArrayList(Enemy).new();
  enemies.push(Enemy(hp : i32(3), name : String.from("a")));
  enemies.push(Enemy(hp : i32(1), name : String.from("b")));
  for(&mut enemies, e => {
    e.hp = (e.hp - i32(1));
  });
  assert(enemies(usize(0)).hp == i32(2), "a: 3 -> 2");
  assert(enemies(usize(1)).hp == i32(0), "b: 1 -> 0");
});
test("borrowed for over RC elements: no per-element dup, mutate through the reference", {
  names := ArrayList(String).new();
  names.push(String.from("x"));
  names.push(String.from("y"));
  first := names(usize(0));
  before := ref_count(first);
  for(&mut names, s => {
    s.push_str("!");
    assert(ref_count(first) == before, "the element is borrowed, not dup'd");
  });
  assert(names(usize(0)) == "x!", "x!");
  assert(names(usize(1)) == "y!", "y!");
  assert(ref_count(first) == before, "counts unchanged after the loop");
});
test("borrowed for: element handed to an inout parameter, break and continue", {
  list := ArrayList(i32).new();
  i := i32(0);
  while(i < i32(6), {
    list.push(i);
    i = (i + i32(1));
  });
  for(&mut list, x => {
    if(x == i32(1), {
      continue;
    });
    if(x == i32(4), {
      break;
    });
    bump_i32(x);
  });
  assert(list(usize(0)) == i32(1), "0 bumped");
  assert(list(usize(1)) == i32(1), "1 skipped by continue");
  assert(list(usize(2)) == i32(3), "2 bumped");
  assert(list(usize(3)) == i32(4), "3 bumped");
  assert(list(usize(4)) == i32(4), "4 not reached (break)");
  assert(list(usize(5)) == i32(5), "5 not reached");
  list.push(i32(99)); // the guard released on `break`: growth is allowed again
  assert(list.len() == usize(7), "push after the loop");
});
test("borrowed for: return from the body and unwind through the body release the guard", {
  Raise :: (ctl() -> unit);
  // The source is a `&mut` parameter: the loop re-borrows it. The element is
  // a local borrow, so it is read out before it is returned (E0912 below).
  find_first_even :: (fn(xs : &mut ArrayList(i32)) -> i32)({
    for(&mut xs, x => {
      if((x % i32(2)) == i32(0), {
        v := x;
        return(v);
      });
    });
    i32(-1)
  });
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(4));
  list.push(i32(5));
  assert(find_first_even(&mut list) == i32(4), "returned from inside the borrowed loop");
  list.push(i32(6)); // must not panic: the return path released the flag
  assert(list.len() == usize(4), "push after the early return");
  unwind_out :: (fn(xs : &mut ArrayList(i32)) -> unit)({
    (raise : Raise) = (
      () -> {
        unwind(());
      }
    );
    for(&mut xs, x => {
      x = i32(0);
      raise();
    });
    assert(false, "unreachable");
  });
  unwind_out(&mut list);
  assert(list(usize(0)) == i32(0), "the first write landed before the unwind");
  list.push(i32(7)); // must not panic: the unwind path released the flag
  assert(list.len() == usize(5), "push after the unwind");
});
// The element binding is a local borrow of the element (decision 18): it is
// second-class, so returning it is E0912 — read it out first.
comptime_expect_error(
  borrowed_element_returned :: (fn(xs : &mut ArrayList(i32)) -> i32)({
    for(&mut xs, x => {
      return(x);
    });
    i32(0)
  })
);
// A `&` parameter cannot be the source of the `&mut` loop: the loop writes
// through its borrow.
comptime_expect_error(
  borrowed_loop_over_a_read_only_parameter :: (fn(xs : &ArrayList(i32)) -> unit)({
    for(&mut xs, x => {
      x = i32(0);
    });
  })
);
test("nested borrowed loops over two collections", {
  a := ArrayList(i32).new();
  a.push(i32(1));
  a.push(i32(2));
  b := ArrayList(i32).new();
  b.push(i32(10));
  b.push(i32(20));
  for(&mut a, x => {
    for(&mut b, y => {
      y = (y + x);
    });
  });
  assert((b(usize(0)) == i32(13)) && (b(usize(1)) == i32(23)), "inner loop saw both outer elements");
  a.push(i32(3)); // both guards released
  assert(a.len() == usize(3), "push after nested loops");
});
// A nested borrowed loop over the SAME collection takes a second `&mut`
// borrow of it while the outer one is live: E0911 (decision 18). Two `&mut`
// elements could alias.
comptime_expect_error(
  nested_borrowed_loops_over_the_same_collection :: (fn() -> unit)({
    a := ArrayList(i32).new();
    a.push(i32(1));
    total := i32(0);
    for(&mut a, x => {
      for(&mut a, y => {
        total = (total + (x * y));
      });
    });
  })
);
test("borrowed for over a rvalue collection", {
  make :: (fn() -> ArrayList(i32))({
    xs := ArrayList(i32).new();
    xs.push(i32(5));
    xs
  });
  sum := i32(0);
  for(&mut make(), x => {
    x = (x + i32(1));
    sum = (sum + x);
  });
  assert(sum == i32(6), "the hidden local kept the temporary alive for the loop");
});
test("for(map, (k, inout(v)) => body): key by value, value borrowed", {
  scores := HashMap(String, i32).new();
  scores.insert(String.from("a"), i32(1));
  scores.insert(String.from("b"), i32(2));
  keys := ArrayList(String).new();
  for(&mut scores, (k, v) => {
    v = (v + i32(10));
    keys.push(k);
  });
  assert(scores.get(String.from("a")) == Option(i32).Some(i32(11)), "a bumped in place");
  assert(scores.get(String.from("b")) == Option(i32).Some(i32(12)), "b bumped in place");
  assert(keys.len() == usize(2), "both keys visited");
  scores.insert(String.from("c"), i32(3)); // guard released
  assert(scores.len() == usize(3), "insert after the loop");
});
test("borrowed for over Deque, LinkedList, BTreeMap and OrderedMap", {
  dq := Deque(i32).new();
  dq.push_back(i32(1));
  dq.push_back(i32(2));
  for(&mut dq, x => {
    x = (x + i32(100));
  });
  assert(dq.pop_front() == Option(i32).Some(i32(101)), "deque element mutated in place");
  ll := LinkedList(i32).new();
  ll.push_back(i32(1));
  ll.push_back(i32(2));
  for(&mut ll, x => {
    x = (x * i32(3));
  });
  assert(ll.pop_front() == Option(i32).Some(i32(3)), "linked-list node value mutated in place");
  bt := BTreeMap(i32, i32).new();
  bt.insert(i32(1), i32(10));
  bt.insert(i32(2), i32(20));
  for(&mut bt, (k, v) => {
    v = (v + k);
  });
  assert(bt.get(i32(2)) == Option(i32).Some(i32(22)), "btree value mutated in place");
  om := OrderedMap(i32, i32).new();
  om.insert(i32(7), i32(1));
  for(&mut om, (k, v) => {
    v = (v + k);
  });
  assert(om.get(i32(7)) == Option(i32).Some(i32(8)), "ordered-map value mutated in place");
});
// The element binding is an `inout` local: it cannot be captured by a
// closure (the existing second-class-reference gate).
comptime_expect_error(
  borrowed_element_captured :: (fn() -> unit)({
    run :: (fn(f : &Impl(Fn() -> unit)) -> unit)(f());
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    for(&mut xs, x => {
      run(() => {
        x = i32(2);
      });
    });
  })
);
// A combinator chain owns no storage: it has no `iter()`, so the borrowed
// form is a compile error (use the value form).
comptime_expect_error(
  borrowed_form_over_a_chain :: (fn() -> unit)({
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    for(&mut xs.into_iter().map(v => (v + i32(1))), x => {
      x = i32(0);
    });
  })
);
// The body names the iterated collection: E0911, for a write and for a read
// alike — the loop's `c := &mut xs` is live for the whole loop, and a `&mut`
// borrow is exclusive (decision 18; Rust's rule for `iter_mut`). The borrow is
// taken in the `for` macro's own code, so this also pins the macro-boundary
// liveness rule
// (issues/fixed/2026-10-17-a-local-borrow-a-macro-expansion-declares-is-never-live-in-the-callers-code.md).
comptime_expect_error(
  push_on_the_borrowed_collection :: (fn() -> unit)({
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    for(&mut xs, x => {
      xs.push(x);
    });
  })
);
comptime_expect_error(
  read_of_the_borrowed_collection :: (fn() -> unit)({
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    total := i32(0);
    for(&mut xs, x => {
      total = (total + (x * i32(xs.len())));
    });
  })
);
comptime_expect_error(
  insert_into_the_borrowed_map :: (fn() -> unit)({
    m := HashMap(i32, i32).new();
    m.insert(i32(1), i32(1));
    for(&mut m, (k, v) => {
      m.insert(k + i32(1), v);
    });
  })
);
// `HashSet` and `PriorityQueue` have no `BorrowedWalk`: writing a hashed or
// heap-ordered element in place would break the container.
comptime_expect_error(
  borrowed_loop_over_a_set :: (fn() -> unit)({
    s := HashSet(i32).new();
    s.insert(i32(1));
    for(&mut s, x => {
      x = i32(2);
    });
  })
);
// The way to read or grow a collection while walking it: its positions
// (decision 39's index cursor). `indices()` is a `Range(usize)` fixed when it
// is made and holding no handle; `xs(i)` re-derives each element from the
// CURRENT buffer, so growth that reallocates mid-walk is read correctly, never
// from the freed buffer (issues/collection-iterators-have-no-sound-post-v2b-shape.md).
test("indices(): a walk that grows its list reads the re-derived buffer", {
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  xs.push(i32(3));
  cap0 := xs.capacity();
  seen := i32(0);
  for(xs.indices(), i => {
    // Grow past the capacity: the buffer is reallocated on the first step.
    while(xs.len() <= cap0, {
      xs.push(i32(0));
    });
    seen = (seen + xs(i));
  });
  assert(seen == i32(6), "the three original elements, read through the moved buffer");
  assert(xs.len() > cap0, "the list grew past its first buffer");
  dq := Deque(i32).new();
  dq.push_back(i32(5));
  dq.push_back(i32(6));
  dsum := i32(0);
  for(dq.indices(), i => {
    // Sixteen pushes per step outgrow the eight-slot ring: it is reallocated.
    (k : i32) = i32(0);
    while(k < i32(16), {
      dq.push_back(i32(0));
      k = (k + i32(1));
    });
    dsum = (dsum + dq(i));
  });
  assert(dq.len() == usize(34), "the deque grew past its first ring");
  assert(dsum == i32(11), "both original elements, read through the moved ring");
});
// Read-only and fresh-storage methods reached through ANOTHER handle of the
// borrowed collection (a `ref` alias the static rule cannot see) do not trip
// the run-time flag: the compiler emits the borrow assert only at the entry of
// methods whose body may mutate the object (`len`, `get`, `contains`,
// `index_of` — with its typed local
// (issues/fixed/borrow-assert-typed-local-declaration-false-positive.md) —
// `clone` pushing into its result, an iterator's own cursor). The panic side is
// pinned by tests/cli-cases/inout-for-alias-push-panics.
test("borrowed for: read-only and fresh-storage methods through an alias do not trip the flag", {
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  ys := xs; // a second handle of the same list
  total := i32(0);
  hits := i32(0);
  for(&mut xs, x => {
    total = (total + (x * i32(ys.len())));
    assert(ys.contains(x), "contains reads");
    match(
      ys.get(usize(0)),
      .Some(first) => {
        total = (total + first);
      },
      .None => ()
    );
    match(
      ys.index_of(x),
      .Some(_) => {
        hits = (hits + i32(1));
      },
      .None => ()
    );
    snapshot := ys.clone();
    snapshot.push(i32(100));
    total = (total + i32(snapshot.len()));
    collected := ys.into_iter().collect(ArrayList(i32));
    collected.push(i32(7));
    total = (total + i32(collected.len()));
    x = (x + i32(1));
  });
  // len/contains/get: (1*2 + 1) + (2*2 + 1) = 8; clone and collect: 2*(3+3) = 12.
  assert(total == i32(20), "read-only and fresh-storage methods through the alias");
  assert(hits == i32(2), "index_of inside the borrowed body");
  assert((xs(usize(0)) == i32(2)) && (xs(usize(1)) == i32(3)), "the elements were written through");
  names := ArrayList(String).new();
  names.push(String.from("a"));
  names.push(String.from("bb"));
  more := names;
  for(&mut names, n => {
    copy := more.clone();
    copy.push(String.from("c"));
    n.push_str("!");
  });
  assert((names(usize(0)) == "a!") && (names.len() == usize(2)), "cloning a collection of RC elements inside the borrowed body");
});
// The borrowed `for`'s guard over a VALUE-rooted place (V2b's unique
// buffers: after Generation B a collection is a value with no cell header).
// Unique ownership checks such a place statically
// (plans/VALUES_BY_DEFAULT.md §3.10, "the borrowed-`for` guard splits by
// path"), so `__yo_borrow_acquire`/`__yo_borrow_release` lower to nothing
// for it. They used to cast the struct itself to `void*`, which is invalid C.
test("a borrow guard over a value-rooted place sets no flag", {
  _GuardPt :: struct(x : i32, y : i32);
  derive(_GuardPt, Copy, Clone);
  p := _GuardPt(x : i32(1), y : i32(2));
  {
    _g := __borrow_guard(&p);
  };
  assert(p.x == i32(1), "the value is untouched");
});
