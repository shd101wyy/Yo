{ assert } :: import("std/assert");
/// `for` macro runtime coverage — value form `for(coll, (x) => body)`
/// across `Array(T, N)`, `ArrayList(T)`, `String`, and range copies.
/// The borrow form `for(coll, inout(x) => body)` was REMOVED (v4 of
/// plans/archive/BORROW_EXCLUSIVITY.md): interior refs into reallocatable
/// storage are no longer expressible. In-place element mutation uses
/// index writes (`coll(i) = v`); object elements mutate in place
/// through the value handle.
open(import("std/collections/array_list"));
open(import("std/string"));
test("for(arr, (x) => body) iterates and reads", {
  arr := [i32(1), i32(2), i32(3), i32(4)];
  sum := i32(0);
  for(arr, x => {
    sum = (sum + x);
  });
  assert(sum == i32(10), "sum of [1,2,3,4] = 10");
});
test("Array index writes mutate in place", {
  arr := [i32(1), i32(2), i32(3)];
  i := usize(0);
  while(i < usize(3), {
    arr(i) = (arr(i) * i32(10));
    i = (i + usize(1));
  });
  assert(arr(usize(0)) == i32(10), "0 -> 10");
  assert(arr(usize(1)) == i32(20), "1 -> 20");
  assert(arr(usize(2)) == i32(30), "2 -> 30");
});
test("for(arr, (x) => body) on zero-length array", {
  arr := Array(i32, 0)();
  count := i32(0);
  for(arr, x => {
    count = (count + i32(1));
    consume(x);
  });
  assert(count == i32(0), "empty array iterates zero times");
});
test("for-loop body interacts with outer locals", {
  arr := [i32(10), i32(20), i32(30)];
  hits := i32(0);
  threshold := i32(15);
  for(arr, x => {
    if(x > threshold, {
      hits = (hits + i32(1));
    });
  });
  assert(hits == i32(2), "two elements (20, 30) exceed threshold 15");
});
test("for(list, (x) => body) on ArrayList iterates and reads", {
  list := ArrayList(i32).new();
  list.push(i32(2));
  list.push(i32(3));
  list.push(i32(5));
  sum := i32(0);
  for(list, x => {
    sum = (sum + x);
  });
  assert(sum == i32(10), "ArrayList sum 2+3+5=10");
});
test("ArrayList index writes mutate in place", {
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  i := usize(0);
  while(i < list.len(), {
    list(i) = (list(i) * i32(10));
    i = (i + usize(1));
  });
  assert(list(usize(0)) == i32(10), "ArrayList 0 -> 10");
  assert(list(usize(1)) == i32(20), "ArrayList 1 -> 20");
  assert(list(usize(2)) == i32(30), "ArrayList 2 -> 30");
});
test("object elements mutate in place through the value binding", {
  // The value form binds a HANDLE for object element types — mutating
  // the element through it is visible in the list (and survives later
  // growth, because the handle points at the element object, not into
  // the list's buffer).
  names := ArrayList(String).new();
  names.push(String.from("a"));
  names.push(String.from("b"));
  for(names, s => {
    s.push_str("!");
  });
  assert(match(names.get(usize(0)), .Some(s) => (s == "a!"), .None => false), "first mutated in place");
  assert(match(names.get(usize(1)), .Some(s) => (s == "b!"), .None => false), "second mutated in place");
});
test("for(s.bytes(), (b) => body) on String iterates and reads bytes", {
  s := `xyz`;
  total := i32(0);
  for(s.bytes(), b => {
    total = (total + i32(b));
  });
  // 'x'=120 + 'y'=121 + 'z'=122 = 363
  assert(total == i32(363), "String byte sum 120+121+122=363");
});
test("String byte index writes mutate in place", {
  s := `abc`;
  i := usize(0);
  while(i < s.len(), {
    s(i) = (s(i) + u8(1));
    i = (i + usize(1));
  });
  assert(s(usize(0)) == u8(98), "'a' -> 'b'");
  assert(s(usize(1)) == u8(99), "'b' -> 'c'");
  assert(s(usize(2)) == u8(100), "'c' -> 'd'");
});
test("for(range-copy, (x) => body) iterates and reads", {
  arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];
  s := arr(usize(1) .. usize(4));
  sum := i32(0);
  for(s, x => {
    sum = (sum + x);
  });
  assert(sum == i32(90), "slice sum 20+30+40=90");
});
test("range-copy index writes stay in the copy", {
  // Ranges COPY (plans/archive/SLICE_REWORK.md): mutating the copy's elements
  // leaves the source array untouched.
  arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];
  s := arr(usize(1) .. usize(4));
  i := usize(0);
  while(i < s.len(), {
    s(i) = (s(i) * i32(10));
    i = (i + usize(1));
  });
  assert(arr(usize(1)) == i32(2), "source untouched");
  assert(match(s.get(usize(0)), .Some(v) => (v == i32(20)), .None => false), "copy 2 -> 20");
  assert(match(s.get(usize(2)), .Some(v) => (v == i32(40)), .None => false), "copy 4 -> 40");
});
test("break inside for(arr, (x) => body) exits the loop", {
  arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];
  hits := i32(0);
  for(arr, x => {
    cond(
      (x >= i32(30)) => break,
      true => {
        hits = (hits + i32(1));
      }
    );
  });
  assert(hits == i32(2), "saw arr[0] and arr[1] before breaking");
});
test("continue inside for(arr, (x) => body) skips one iteration", {
  arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];
  evens_sum := i32(0);
  for(arr, x => {
    cond(
      ((x % i32(2)) != i32(0)) => continue,
      true => {
        evens_sum = (evens_sum + x);
      }
    );
  });
  assert(evens_sum == i32(6), "2 + 4 = 6 (skipped odds)");
});
// The removed borrow form must fail with the teaching error, not a
// resolution mystery.
comptime_expect_error(
  borrow_form_is_removed :: (fn() -> unit)({
    arr := [i32(1), i32(2)];
    total := i32(0);
    for(arr, inout(x) => {
      total = (total + x);
    });
    consume(total);
  })
);
