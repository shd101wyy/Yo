{ assert } :: import("std/assert");
open(import("std/fmt"));
{ SortedMap } :: import("std/imm/sorted_map");
{ List } :: import("std/imm/list");
test("SortedMap new is empty", {
  m := SortedMap(i32, i32).new();
  assert(m.is_empty(), "new map should be empty");
  assert(m.len() == usize(0), "len should be 0");
});
test("SortedMap insert and get", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(5), i32(50));
  result := m.get(i32(5));
  match(
    result,
    .Some(v) => assert(v == i32(50), "value should be 50"),
    .None => assert(false, "key 5 should exist")
  );
  assert(m.len() == usize(1), "len should be 1");
});
test("SortedMap insert multiple and ordering", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(3), i32(30));
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(2), i32(20));
  assert(m.len() == usize(3), "len should be 3");
  ks := m.keys();
  // Keys should be in sorted order: 1, 2, 3
  assert(ks.len() == usize(3), "keys len 3");
  k1 := ks.head();
  match(
    k1,
    .Some(v) => assert(v == i32(1), "first key should be 1"),
    .None => assert(false, "should have first key")
  );
});
test("SortedMap insert overwrites", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(1), i32(99));
  assert(m.len() == usize(1), "len still 1 after overwrite");
  result := m.get(i32(1));
  match(
    result,
    .Some(v) => assert(v == i32(99), "value should be updated to 99"),
    .None => assert(false, "key should exist")
  );
});
test("SortedMap contains_key", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(10), i32(100));
  assert(m.contains_key(i32(10)), "should contain 10");
  assert(!(m.contains_key(i32(20))), "should not contain 20");
});
test("SortedMap remove existing", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(2), i32(20));
  m = m.insert(i32(3), i32(30));
  m2 := m.remove(i32(2));
  assert(m2.len() == usize(2), "after remove len 2");
  assert(!(m2.contains_key(i32(2))), "2 removed");
  assert(m2.contains_key(i32(1)), "1 still exists");
  assert(m2.contains_key(i32(3)), "3 still exists");
  // original unchanged
  assert(m.len() == usize(3), "original unchanged");
});
test("SortedMap remove nonexistent", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(1), i32(10));
  m2 := m.remove(i32(999));
  assert(m2.len() == usize(1), "len unchanged");
});
test("SortedMap min_key and max_key", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(5), i32(50));
  m = m.insert(i32(2), i32(20));
  m = m.insert(i32(8), i32(80));
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(9), i32(90));
  min_k := m.min_key();
  match(
    min_k,
    .Some(v) => assert(v == i32(1), "min key should be 1"),
    .None => assert(false, "should have min key")
  );
  max_k := m.max_key();
  match(
    max_k,
    .Some(v) => assert(v == i32(9), "max key should be 9"),
    .None => assert(false, "should have max key")
  );
});
test("SortedMap structural sharing", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(2), i32(20));
  m2 := m.insert(i32(3), i32(30));
  assert(m.len() == usize(2), "original has 2");
  assert(m2.len() == usize(3), "new has 3");
  assert(!(m.contains_key(i32(3))), "original doesn't have 3");
});
test("SortedMap keys in order", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(5), i32(50));
  m = m.insert(i32(3), i32(30));
  m = m.insert(i32(7), i32(70));
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(4), i32(40));
  ks := m.keys();
  assert(ks.len() == usize(5), "5 keys");
  // Verify sorted: 1, 3, 4, 5, 7
  (cur : List(i32)) = ks;
  (prev : i32) = i32(-(1));
  (sorted : bool) = true;
  (done : bool) = false;
  while(runtime(!(done)), {
    match(
      cur.head(),
      .Some(k) => {
        if(k <= prev, {
          sorted = false;
        });
        prev = k;
        cur = cur.tail();
      },
      .None => {
        done = true;
      }
    );
  });
  assert(sorted, "keys should be in sorted order");
});
test("SortedMap Eq trait", {
  a := SortedMap(i32, i32).new();
  a = a.insert(i32(1), i32(10));
  a = a.insert(i32(2), i32(20));
  b := SortedMap(i32, i32).new();
  b = b.insert(i32(2), i32(20));
  b = b.insert(i32(1), i32(10));
  assert(a == b, "maps with same entries should be equal");
  c := SortedMap(i32, i32).new();
  c = c.insert(i32(1), i32(99));
  assert(!(a == c), "maps with different values not equal");
});
test("SortedMap many entries", {
  (m : SortedMap(i32, i32)) = SortedMap(i32, i32).new();
  (i : i32) = i32(0);
  while(runtime(i < i32(50)), {
    m = m.insert(i, i * i32(10));
    i = (i + i32(1));
  });
  assert(m.len() == usize(50), "should have 50 entries");
  assert(m.contains_key(i32(0)), "contains 0");
  assert(m.contains_key(i32(25)), "contains 25");
  assert(m.contains_key(i32(49)), "contains 49");
  result := m.get(i32(25));
  match(
    result,
    .Some(v) => assert(v == i32(250), "25 * 10 = 250"),
    .None => assert(false, "key 25 should exist")
  );
});
test("SortedMap values in key order", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(3), i32(30));
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(2), i32(20));
  vs := m.values();
  assert(vs.len() == usize(3), "3 values");
  // Values should be in key order: 10, 20, 30
  v1 := vs.head();
  match(
    v1,
    .Some(v) => assert(v == i32(10), "first value is 10 (key 1)"),
    .None => assert(false, "should have first value")
  );
});
test("SortedMap remove all entries", {
  m := SortedMap(i32, i32).new();
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(2), i32(20));
  m = m.insert(i32(3), i32(30));
  m = m.remove(i32(1));
  m = m.remove(i32(2));
  m = m.remove(i32(3));
  assert(m.is_empty(), "should be empty after removing all");
  assert(m.len() == usize(0), "len 0");
});
test("SortedMap from_entries builds correct map", {
  m := SortedMap(i32, i32).new().insert(i32(3), i32(30)).insert(i32(1), i32(10)).insert(i32(2), i32(20));
  assert(m.len() == usize(3), "len = 3");
  assert(m.get(i32(1)).unwrap() == i32(10), "key 1");
  assert(m.get(i32(2)).unwrap() == i32(20), "key 2");
  assert(m.get(i32(3)).unwrap() == i32(30), "key 3");
  assert(m.min_key().unwrap() == i32(1), "min key = 1");
  assert(m.max_key().unwrap() == i32(3), "max key = 3");
});
test("SortedMap empty equality", {
  m1 := SortedMap(i32, i32).new();
  m2 := SortedMap(i32, i32).new();
  assert(m1 == m2, "two empty sorted maps are equal");
});
test("SortedMap equality same elements", {
  m1 := SortedMap(i32, i32).new().insert(i32(1), i32(10)).insert(i32(2), i32(20));
  m2 := SortedMap(i32, i32).new().insert(i32(2), i32(20)).insert(i32(1), i32(10));
  assert(m1 == m2, "same elements different insertion order");
});
