pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (UDP sockets unavailable)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (UDP sockets unavailable)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import("std/collections/array_list");
open(import("std/string"));
open(import("std/fmt"));
{ UdpSocket } :: import("std/net/udp");
{ SocketAddr, IpAddr } :: import("std/net/addr");
{ NetError } :: import("std/net/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
IO_tcp :: import("std/sys/tcp");
// ============================================================================
// UdpSocket tests
// ============================================================================
test("UdpSocket bind and close", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  sock := io.await(UdpSocket.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  unsafe(printf("  socket fd = %d\n", sock.fd()));
  assert(sock.fd() >= i32(0), "fd should be valid");
  io.await(sock.close(io), IoExn(io : io, exn : exn));
  unsafe(printf("  close ok\n"));
});
test("UdpSocket local_addr", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  sock := io.await(UdpSocket.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  la := sock.local_addr();
  unsafe(printf("  local_addr = %s\n", la.to_string().to_cstr().ptr().unwrap()));
  assert(la.ip.is_loopback(), "should be loopback");
  io.await(sock.close(io), IoExn(io : io, exn : exn));
});
test("UdpSocket send_to and recv", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  server_addr := SocketAddr.loopback(u16(19910));
  server := io.await(UdpSocket.bind(server_addr, io), IoExn(io : io, exn : exn));
  client_addr := SocketAddr.loopback(u16(19911));
  client := io.await(UdpSocket.bind(client_addr, io), IoExn(io : io, exn : exn));
  // Client sends to server
  data := ArrayList(u8).new();
  data.push(u8(72)); // H
  data.push(u8(101)); // e
  data.push(u8(108)); // l
  data.push(u8(108)); // l
  data.push(u8(111)); // o
  n := io.await(client.send_to(data, server_addr, io), IoExn(io : io, exn : exn));
  unsafe(printf("  sent = %zu\n", n));
  assert(n == usize(5), "should send 5 bytes");
  // Server receives
  recv_buf := (*u8)(malloc(usize(256)).unwrap());
  nr := io.await(server.recv(recv_buf, usize(256), io), IoExn(io : io, exn : exn));
  unsafe(printf("  received = %zu\n", nr));
  assert(nr == usize(5), "should receive 5 bytes");
  assert((recv_buf.add(usize(0))).* == u8(72), "H");
  assert((recv_buf.add(usize(1))).* == u8(101), "e");
  assert((recv_buf.add(usize(2))).* == u8(108), "l");
  assert((recv_buf.add(usize(3))).* == u8(108), "l");
  assert((recv_buf.add(usize(4))).* == u8(111), "o");
  free(.Some((*void)(recv_buf)));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("UdpSocket recv_from gets source address", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  server_addr := SocketAddr.loopback(u16(19912));
  server := io.await(UdpSocket.bind(server_addr, io), IoExn(io : io, exn : exn));
  client_addr := SocketAddr.loopback(u16(19913));
  client := io.await(UdpSocket.bind(client_addr, io), IoExn(io : io, exn : exn));
  // Client sends
  data := ArrayList(u8).new();
  data.push(u8(65)); // A
  data.push(u8(66)); // B
  io.await(client.send_to(data, server_addr, io), IoExn(io : io, exn : exn));
  // Server receives, and gets the sender back as a DECODED SocketAddr — the
  // sockaddr buffer and its length used to be raw out-params the caller had to
  // malloc, pre-set to 128, pass in, decode with IO_tcp.get_* and free.
  recv_buf := (*u8)(malloc(usize(256)).unwrap());
  got := io.await(server.recv_from(recv_buf, usize(256), io), IoExn(io : io, exn : exn));
  unsafe(printf("  received = %zu\n", got.0));
  assert(got.0 == usize(2), "should receive 2 bytes");
  assert((recv_buf.add(usize(0))).* == u8(65), "A");
  assert((recv_buf.add(usize(1))).* == u8(66), "B");
  assert(got.1.port == u16(19913), "src port should be 19913");
  assert(got.1.ip == IpAddr.loopback_v4(), "src ip is the loopback the client bound");
  free(.Some((*void)(recv_buf)));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("UdpSocket recv_from_bytes needs no raw pointers at all", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  server_addr := SocketAddr.loopback(u16(19916));
  server := io.await(UdpSocket.bind(server_addr, io), IoExn(io : io, exn : exn));
  client_addr := SocketAddr.loopback(u16(19917));
  client := io.await(UdpSocket.bind(client_addr, io), IoExn(io : io, exn : exn));
  data := ArrayList(u8).new();
  data.push(u8(120)); // x
  data.push(u8(121)); // y
  data.push(u8(122)); // z
  io.await(client.send_to(data, server_addr, io), IoExn(io : io, exn : exn));
  // `send_to` has always taken an ArrayList; every RECEIVE took a *(u8), so a
  // program without Pragma.AllowUnsafe could send a datagram and not read one.
  got := io.await(server.recv_from_bytes(usize(256), io), IoExn(io : io, exn : exn));
  assert(got.0.len() == usize(3), "truncated to the 3 bytes actually received");
  assert(got.0(usize(0)) == u8(120), "x");
  assert(got.0(usize(2)) == u8(122), "z");
  assert(got.1.port == u16(19917), "and the sender's port came back decoded");
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("UdpSocket recv_bytes over a connected socket", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  server_addr := SocketAddr.loopback(u16(19918));
  server := io.await(UdpSocket.bind(server_addr, io), IoExn(io : io, exn : exn));
  client_addr := SocketAddr.loopback(u16(19919));
  client := io.await(UdpSocket.bind(client_addr, io), IoExn(io : io, exn : exn));
  io.await(client.connect(server_addr, io), IoExn(io : io, exn : exn));
  data := ArrayList(u8).new();
  data.push(u8(7));
  io.await(client.send(data, io), IoExn(io : io, exn : exn));
  got := io.await(server.recv_bytes(usize(64), io), IoExn(io : io, exn : exn));
  assert(got.len() == usize(1), "one byte, and the list is truncated to it");
  assert(got(usize(0)) == u8(7), "the byte that was sent");
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
test("UdpSocket set_broadcast", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  sock := io.await(UdpSocket.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  io.await(sock.set_broadcast(true, io), IoExn(io : io, exn : exn));
  unsafe(printf("  broadcast ok\n"));
  io.await(sock.close(io), IoExn(io : io, exn : exn));
});
test("UDP bind to a non-local IPv6 address must fail (was: sockaddr hardcoded ::1)", {
  // plans/archive/STD_API_AUDIT.md C2: udp's _make_sockaddr had the same hardcoded
  // "::1" as tcp's, so binding 2001:db8::1 silently bound the loopback.
  segs := Array(u16, usize(8)).fill(u16(0));
  segs(usize(0)) = u16(8193);
  // 0x2001
  segs(usize(1)) = u16(3512);
  // 0x0db8
  segs(usize(7)) = u16(1);
  doc_addr := SocketAddr.new(IpAddr.V6(segs), u16(0));
  exn := Exception(
    throw : (
      err -> {
        msg := err.to_string();
        unsafe(printf("  bind(2001:db8::1) correctly failed: %s\n", msg.to_cstr().ptr().unwrap()));
        unwind(());
      }
    )
  );
  sock := io.await(UdpSocket.bind(doc_addr, io), IoExn(io : io, exn : exn));
  io.await(sock.close(io), IoExn(io : io, exn : exn));
  assert(false, "UDP bind to non-local 2001:db8::1 must fail — the sockaddr was hardcoded to ::1");
});
// `bind` used to ECHO its argument as `_local_addr`, so a port-0 (ephemeral)
// bind — the only reason to bind port 0 — reported port 0 forever. TCP got this
// fix as C2 (getsockname readback); UDP was left out.
// issues/fixed/udpsocket-bind-echoes-its-argument-and-send-has-no-connect.md
test("UdpSocket.bind to port 0 reports the kernel-assigned port", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  sock := io.await(UdpSocket.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  la := sock.local_addr();
  assert(la.port != u16(0), "an ephemeral bind must report the real port");
  assert(la.ip.is_loopback(), "and the real address");
  io.await(sock.close(io), IoExn(io : io, exn : exn));
});
// `send`/`recv` documented "requires prior connect" — and no `connect` existed,
// so they could only ever fail with ENOTCONN.
test("UdpSocket.connect makes send and recv usable", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  server := io.await(UdpSocket.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  client := io.await(UdpSocket.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  io.await(client.connect(server.local_addr(), io), IoExn(io : io, exn : exn));
  io.await(server.connect(client.local_addr(), io), IoExn(io : io, exn : exn));
  msg := ArrayList(u8).new();
  msg.push(u8(104));
  msg.push(u8(105));
  sent := io.await(client.send(msg, io), IoExn(io : io, exn : exn));
  assert(sent == usize(2), "send on a connected socket sends the datagram");
  buf := (*u8)(malloc(usize(16)).unwrap());
  got := io.await(server.recv(buf, usize(16), io), IoExn(io : io, exn : exn));
  assert(got == usize(2), "recv on the connected peer gets it");
  assert(((buf.add(usize(0))).* == u8(104)) && ((buf.add(usize(1))).* == u8(105)), "payload intact");
  reply := ArrayList(u8).new();
  reply.push(u8(33));
  _r := io.await(server.send(reply, io), IoExn(io : io, exn : exn));
  got2 := io.await(client.recv(buf, usize(16), io), IoExn(io : io, exn : exn));
  assert((got2 == usize(1)) && ((buf.add(usize(0))).* == u8(33)), "the reply comes back over the connected pair");
  free(.Some((*void)(buf)));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(server.close(io), IoExn(io : io, exn : exn));
});
