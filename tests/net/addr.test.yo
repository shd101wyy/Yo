pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio");
{ String } :: import("std/string");
import("std/fmt");
{ IpAddr, SocketAddr } :: import("std/net/addr");
{ hash_one } :: import("std/hash");
{ HashMap } :: import("std/collections/hash_map");
{ NetError } :: import("std/net/errors");
{ Error, AnyError, Exception } :: import("std/error");
// ============================================================================
// IpAddr tests
// ============================================================================
test("IpAddr.loopback_v4 returns 127.0.0.1", {
  addr := IpAddr.loopback_v4();
  assert(addr.is_loopback(), "should be loopback");
  assert(addr.is_v4(), "should be v4");
  assert(!addr.is_v6(), "should not be v6");
  s := addr.to_string();
  unsafe(printf("  loopback_v4 = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `127.0.0.1`, "should be 127.0.0.1");
});
test("IpAddr.loopback_v6 returns ::1", {
  addr := IpAddr.loopback_v6();
  assert(addr.is_loopback(), "should be loopback");
  assert(addr.is_v6(), "should be v6");
  assert(!addr.is_v4(), "should not be v4");
});
test("IpAddr.any_v4 returns 0.0.0.0", {
  addr := IpAddr.any_v4();
  assert(addr.is_v4(), "should be v4");
  assert(!addr.is_loopback(), "should not be loopback");
  s := addr.to_string();
  unsafe(printf("  any_v4 = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `0.0.0.0`, "should be 0.0.0.0");
});
test("IpAddr.parse_v4 valid address", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := IpAddr.parse_v4(`192.168.1.100`, exn);
  assert(addr.is_v4(), "should be v4");
  s := addr.to_string();
  unsafe(printf("  parsed = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `192.168.1.100`, "should be 192.168.1.100");
});
test("IpAddr.parse_v4 loopback", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := IpAddr.parse_v4(`127.0.0.1`, exn);
  assert(addr.is_loopback(), "should be loopback");
});
test("IpAddr.parse_v4 invalid address", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  IpAddr.parse_v4(`999.0.0.1`, exn);
  assert(false, "should fail for out of range");
});
test("IpAddr.parse_v4 too few octets", {
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("  correctly rejected\n"));
        unwind(());
      }
    )
  );
  IpAddr.parse_v4(`1.2.3`, exn);
  assert(false, "should fail for too few octets");
});
test("IpAddr.parse_v4 invalid char", {
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("  correctly rejected\n"));
        unwind(());
      }
    )
  );
  IpAddr.parse_v4(`1.2.3.abc`, exn);
  assert(false, "should fail for invalid char");
});
// ============================================================================
// SocketAddr tests
// ============================================================================
test("SocketAddr.new creates correct address", {
  ip := IpAddr.loopback_v4();
  addr := SocketAddr.new(ip, u16(8080));
  assert(addr.port == u16(8080), "port should be 8080");
  assert(addr.ip.is_loopback(), "ip should be loopback");
  s := addr.to_string();
  unsafe(printf("  addr = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `127.0.0.1:8080`, "should be 127.0.0.1:8080");
});
test("SocketAddr.loopback creates loopback address", {
  addr := SocketAddr.loopback(u16(3000));
  s := addr.to_string();
  unsafe(printf("  addr = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `127.0.0.1:3000`, "should be 127.0.0.1:3000");
});
test("SocketAddr.any creates any address", {
  addr := SocketAddr.any(u16(9090));
  s := addr.to_string();
  unsafe(printf("  addr = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `0.0.0.0:9090`, "should be 0.0.0.0:9090");
});
test("IpAddr V4 to_string various addresses", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := IpAddr.parse_v4(`10.0.0.1`, exn);
  s := addr.to_string();
  unsafe(printf("  10.0.0.1 = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `10.0.0.1`, "should match");
});
test("SocketAddr with parsed IP", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  ip := IpAddr.parse_v4(`10.20.30.40`, exn);
  addr := SocketAddr.new(ip, u16(443));
  s := addr.to_string();
  unsafe(printf("  addr = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `10.20.30.40:443`, "should be 10.20.30.40:443");
});
// `parse_v4` accepted two shapes it must reject — both are silent WRONG VALUES,
// not errors: an empty octet (`"..."` parsed as 0.0.0.0, `"1.2.3."` as 1.2.3.0)
// because nothing counted the digits in an octet, and an octet that wraps u32
// (`"4294967297.0.0.0"` parsed as 1.0.0.0) because the accumulator was only
// range-checked at the separator. Rust's Ipv4Addr::from_str rejects both, and
// leading zeros (`"01.2.3.4"`, octal ambiguity) — so do we now.
// issues/fixed/ipaddr-parse-v4-accepts-empty-and-wrapping-octets.md
_must_reject_v4 :: (fn(s : String) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  IpAddr.parse_v4(s, exn);
  assert(false, `parse_v4 accepted ${s}`);
});
test("IpAddr.parse_v4 rejects empty octets", {
  _must_reject_v4(`...`);
  _must_reject_v4(`1.2.3.`);
  _must_reject_v4(`.1.2.3`);
  _must_reject_v4(`1..2.3`);
  _must_reject_v4(``);
});
test("IpAddr.parse_v4 rejects an octet that wraps the accumulator", {
  _must_reject_v4(`4294967297.0.0.0`);
  _must_reject_v4(`99999999999.0.0.0`);
});
test("IpAddr.parse_v4 rejects leading zeros like Rust", {
  _must_reject_v4(`01.2.3.4`);
  _must_reject_v4(`1.2.3.007`);
  exn := Exception(
    throw : (
      err -> {
        assert(false, "0.0.0.0 is valid");
        unwind(());
      }
    )
  );
  z := IpAddr.parse_v4(`0.0.0.0`, exn);
  assert(z.to_string() == "0.0.0.0", "a lone 0 octet is not a leading zero");
});
// ============================================================================
// Eq / Ord / Hash / Clone on the two address types
// ============================================================================
test("IpAddr Eq and Clone", {
  a := IpAddr.V4(u8(10), u8(0), u8(0), u8(1));
  b := IpAddr.V4(u8(10), u8(0), u8(0), u8(1));
  c := IpAddr.V4(u8(10), u8(0), u8(0), u8(2));
  assert(a == b, "identical V4 addresses are equal");
  assert(a != c, "a differing last octet is unequal");
  assert(IpAddr.loopback_v6() == IpAddr.loopback_v6(), "identical V6 addresses are equal");
  assert(IpAddr.loopback_v4() != IpAddr.loopback_v6(), "V4 and V6 loopback are different addresses");
  d := a.clone();
  assert(d == a, "a clone equals its source");
});
test("IpAddr Ord is the numeric order, with every V4 before every V6", {
  lo := IpAddr.V4(u8(1), u8(2), u8(3), u8(4));
  hi := IpAddr.V4(u8(1), u8(2), u8(3), u8(5));
  assert(lo < hi, "the last octet decides");
  assert(IpAddr.V4(u8(1), u8(255), u8(255), u8(255)) < IpAddr.V4(u8(2), u8(0), u8(0), u8(0)), "the FIRST octet outranks the rest");
  assert(!(hi < lo), "and it is not symmetric");
  assert(lo <= lo, "<= is reflexive");
  assert(hi > lo, "> agrees with <");
  assert(match(lo.cmp(lo), .Equal => true, _ => false), "cmp says Equal for identical addresses");
  // Rust's `IpAddr` derives Ord over `V4 < V6` in declaration order, so the
  // highest possible V4 still sorts below any V6.
  assert(IpAddr.V4(u8(255), u8(255), u8(255), u8(255)) < IpAddr.loopback_v6(), "every V4 sorts before every V6");
  assert(IpAddr.loopback_v6() > IpAddr.any_v4(), "and every V6 after every V4");
});
test("IpAddr Hash agrees with Eq and separates the families", {
  a := IpAddr.V4(u8(127), u8(0), u8(0), u8(1));
  b := IpAddr.V4(u8(127), u8(0), u8(0), u8(1));
  assert(hash_one(a) == hash_one(b), "equal addresses hash equal");
  assert(hash_one(a) != hash_one(IpAddr.V4(u8(127), u8(0), u8(0), u8(2))), "different addresses hash differently");
  assert(hash_one(IpAddr.loopback_v4()) != hash_one(IpAddr.loopback_v6()), "the family tag separates V4 from V6");
});
test("SocketAddr Eq, Ord, Clone and use as a HashMap key", {
  a := SocketAddr.loopback(u16(8080));
  b := SocketAddr.loopback(u16(8080));
  c := SocketAddr.loopback(u16(8081));
  assert(a == b, "same ip and port are equal");
  assert(a != c, "a differing port is unequal");
  assert(a < c, "the port breaks an ip tie");
  assert(SocketAddr.any(u16(9999)) < SocketAddr.loopback(u16(1)), "the IP outranks the port");
  d := a.clone();
  assert(d == a, "a clone equals its source");
  assert(hash_one(a) == hash_one(b), "equal socket addresses hash equal");
  assert(hash_one(a) != hash_one(c), "a differing port changes the hash");
  // The point of all four: a connection table keyed by peer.
  conns := HashMap(SocketAddr, i32).new();
  conns.insert(a, i32(1));
  conns.insert(c, i32(2));
  assert(conns.len() == usize(2), "two distinct keys");
  assert(conns.get(b).unwrap() == i32(1), "an equal-but-distinct value finds the entry");
  conns.insert(b, i32(3));
  assert(conns.len() == usize(2), "re-inserting an equal key replaces");
  assert(conns.get(a).unwrap() == i32(3), "with the new value");
});
// ============================================================================
// IpAddr.parse_v6 / IpAddr.parse
// ============================================================================
_must_reject_v6 :: (fn(s : String) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  IpAddr.parse_v6(s, exn);
  assert(false, `parse_v6 accepted ${s}`);
});
_ok_v6 :: (fn(s : String) -> IpAddr)({
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  parse_v6 rejected a valid address: ${err}`);
        assert(false, "parse_v6 must accept this");
        unwind(());
      }
    )
  );
  IpAddr.parse_v6(s, exn)
});
test("IpAddr.parse_v6 accepts the full eight-group form", {
  a := _ok_v6(`2001:0db8:0000:0000:0000:0000:0002:0001`);
  assert(a.is_v6(), "is v6");
  match(
    a,
    .V6(segs) => {
      assert(segs(usize(0)) == u16(0x2001), "first group");
      assert(segs(usize(1)) == u16(0x0db8), "second group");
      assert(segs(usize(6)) == u16(2), "seventh group");
      assert(segs(usize(7)) == u16(1), "eighth group");
    },
    .V4(_, _, _, _) => assert(false, "must be v6")
  );
  // Hex is case-insensitive on input.
  assert(_ok_v6(`2001:DB8:0:0:0:0:2:1`) == a, "upper-case hex parses the same");
  // Groups may be written with fewer than four digits.
  assert(_ok_v6(`2001:db8:0:0:0:0:2:1`) == a, "short groups parse the same");
});
test("IpAddr.parse_v6 accepts :: compression in every position", {
  assert(_ok_v6(`::1`) == IpAddr.loopback_v6(), "leading :: is the loopback");
  // `::` alone is the unspecified address — all eight groups zero.
  unspec := _ok_v6(`::`);
  match(
    unspec,
    .V6(segs) => {
      i := usize(0);
      while(runtime(i < usize(8)), {
        assert(segs(i) == u16(0), "every group of :: is zero");
        i = (i + usize(1));
      });
    },
    .V4(_, _, _, _) => assert(false, "must be v6")
  );
  // Middle and trailing compression.
  assert(
    _ok_v6(`2001:db8::2:1`) == _ok_v6(`2001:db8:0:0:0:0:2:1`),
    "middle :: expands to the zero run"
  );
  assert(
    _ok_v6(`2001:db8::`) == _ok_v6(`2001:db8:0:0:0:0:0:0`),
    "trailing :: expands to the zero run"
  );
  assert(_ok_v6(`fe80::1`) == _ok_v6(`fe80:0:0:0:0:0:0:1`), "link-local");
});
test("IpAddr.parse_v6 accepts a trailing dotted-quad", {
  // The IPv4-mapped form. The last two groups carry the four octets.
  mapped := _ok_v6(`::ffff:192.0.2.1`);
  match(
    mapped,
    .V6(segs) => {
      assert(segs(usize(5)) == u16(0xffff), "the mapping prefix");
      assert(segs(usize(6)) == u16(0xc000), "192.0 packs into one group");
      assert(segs(usize(7)) == u16(0x0201), "2.1 packs into the next");
    },
    .V4(_, _, _, _) => assert(false, "must be v6")
  );
  // Also legal without compression, spelling all six leading groups.
  assert(
    _ok_v6(`0:0:0:0:0:ffff:192.0.2.1`) == mapped,
    "the uncompressed spelling is the same address"
  );
  // And the IPv4-compatible (deprecated but well-formed) form.
  assert(_ok_v6(`::192.0.2.1`) == _ok_v6(`::c000:201`), "dotted-quad == its hex spelling");
});
test("IpAddr.parse_v6 rejects malformed input", {
  _must_reject_v6(``);
  // More than one compression run is ambiguous.
  _must_reject_v6(`1::2::3`);
  // A group longer than four hex digits cannot fit in 16 bits.
  _must_reject_v6(`12345::1`);
  // Too many groups, with and without compression.
  _must_reject_v6(`1:2:3:4:5:6:7:8:9`);
  _must_reject_v6(`1:2:3:4:5:6:7:8::9`);
  // Without a `::` all eight groups must be written.
  _must_reject_v6(`1:2:3`);
  _must_reject_v6(`1:2:3:4:5:6:7`);
  // A `::` standing for nothing is wrong per RFC 5952 4.2.2.
  _must_reject_v6(`1:2:3:4::5:6:7:8`);
  // A single leading or trailing colon is not a compression run.
  _must_reject_v6(`:1:2:3:4:5:6:7:8`);
  _must_reject_v6(`1:2:3:4:5:6:7:8:`);
  _must_reject_v6(`1:`);
  // An empty group that is not part of a `::`.
  _must_reject_v6(`1:2:::3`);
  // Non-hex bytes, and an IPv4 part that is not itself valid.
  _must_reject_v6(`2001:zz::1`);
  _must_reject_v6(`::ffff:192.0.2.256`);
  _must_reject_v6(`::ffff:192.0.2`);
  // A zone id identifies an interface, not an address.
  _must_reject_v6(`fe80::1%eth0`);
});
test("IpAddr.parse_v6 round-trips through to_string", {
  // to_string writes the full uncompressed form, which parse_v6 must accept
  // back — this is what makes an address survive a serialize/parse cycle.
  a := _ok_v6(`2001:db8::dead:beef`);
  assert(_ok_v6(a.to_string()) == a, "to_string output re-parses to the same address");
  assert(_ok_v6(IpAddr.loopback_v6().to_string()) == IpAddr.loopback_v6(), "loopback round-trips");
});
_must_reject_parse :: (fn(s : String) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  IpAddr.parse(s, exn);
  assert(false, `parse accepted ${s}`);
});
test("IpAddr.parse dispatches on the presence of a colon", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  parse rejected a valid address: ${err}`);
        assert(false, "must accept");
        unwind(());
      }
    )
  );
  assert(IpAddr.parse(`127.0.0.1`, exn) == IpAddr.loopback_v4(), "no colon means v4");
  assert(IpAddr.parse(`::1`, exn) == IpAddr.loopback_v6(), "a colon means v6");
  // A malformed address reports the error for the family it was meant to be.
  _must_reject_parse(`1.2.3`);
  _must_reject_parse(`1:2:3`);
});
// ============================================================================
// IpAddr batteries + SocketAddr.parse
// ============================================================================
test("IpAddr.octets serializes either family big-endian", {
  v4 := IpAddr.V4(u8(10), u8(20), u8(30), u8(40)).octets();
  assert(v4.len() == usize(4), "a V4 address is four octets");
  assert(v4(usize(0)) == u8(10), "first octet");
  assert(v4(usize(3)) == u8(40), "last octet");
  v6 := _ok_v6(`2001:db8::1`).octets();
  assert(v6.len() == usize(16), "a V6 address is sixteen bytes");
  assert(v6(usize(0)) == u8(0x20), "high octet of the first group comes first");
  assert(v6(usize(1)) == u8(0x01), "then the low octet");
  assert(v6(usize(15)) == u8(0x01), "and the last group's low octet is last");
});
test("IpAddr.segments answers only for V6", {
  match(
    _ok_v6(`fe80::1`).segments(),
    .Some(segs) => {
      assert(segs(usize(0)) == u16(0xfe80), "first group");
      assert(segs(usize(7)) == u16(1), "last group");
    },
    .None => assert(false, "a V6 address has segments")
  );
  // Not the IPv4-mapped groups: a V4 address has no groups, and answering with
  // them would silently answer a different question.
  assert(IpAddr.loopback_v4().segments().is_none(), "a V4 address has none");
});
test("IpAddr.is_unspecified, any_v6", {
  assert(IpAddr.any_v4().is_unspecified(), "0.0.0.0");
  assert(IpAddr.any_v6().is_unspecified(), "::");
  assert(_ok_v6(`::`) == IpAddr.any_v6(), "any_v6 is what :: parses to");
  assert(!IpAddr.loopback_v4().is_unspecified(), "127.0.0.1 is specified");
  assert(!IpAddr.loopback_v6().is_unspecified(), "::1 is specified");
});
test("IpAddr.is_multicast covers 224/4 and ff00::/8", {
  assert(IpAddr.V4(u8(224), u8(0), u8(0), u8(1)).is_multicast(), "the bottom of 224/4");
  assert(IpAddr.V4(u8(239), u8(255), u8(255), u8(255)).is_multicast(), "the top of 224/4");
  assert(!IpAddr.V4(u8(223), u8(0), u8(0), u8(1)).is_multicast(), "223 is below the range");
  assert(!IpAddr.V4(u8(240), u8(0), u8(0), u8(1)).is_multicast(), "240 is above it");
  assert(_ok_v6(`ff02::1`).is_multicast(), "ff00::/8");
  assert(!_ok_v6(`fe80::1`).is_multicast(), "link-local is not multicast");
});
test("IpAddr.is_private is RFC 1918 only, with unique-local kept separate", {
  assert(IpAddr.V4(u8(10), u8(0), u8(0), u8(1)).is_private(), "10/8");
  assert(IpAddr.V4(u8(172), u8(16), u8(0), u8(1)).is_private(), "the bottom of 172.16/12");
  assert(IpAddr.V4(u8(172), u8(31), u8(255), u8(255)).is_private(), "the top of 172.16/12");
  assert(!IpAddr.V4(u8(172), u8(15), u8(0), u8(1)).is_private(), "172.15 is outside");
  assert(!IpAddr.V4(u8(172), u8(32), u8(0), u8(1)).is_private(), "172.32 is outside");
  assert(IpAddr.V4(u8(192), u8(168), u8(1), u8(1)).is_private(), "192.168/16");
  assert(!IpAddr.V4(u8(192), u8(169), u8(1), u8(1)).is_private(), "192.169 is public");
  assert(!IpAddr.V4(u8(8), u8(8), u8(8), u8(8)).is_private(), "8.8.8.8 is public");
  // fc00::/7 is the V6 analogue but has different routing rules, so it is a
  // SEPARATE predicate rather than folded into is_private.
  assert(!_ok_v6(`fd00::1`).is_private(), "a V6 address is never RFC 1918");
  assert(_ok_v6(`fd00::1`).is_unique_local(), "but it is unique-local");
  assert(_ok_v6(`fc00::1`).is_unique_local(), "and so is the bottom of fc00::/7");
  assert(!_ok_v6(`fe00::1`).is_unique_local(), "fe00 is outside fc00::/7");
  assert(!IpAddr.loopback_v4().is_unique_local(), "a V4 address is never unique-local");
});
test("IpAddr.is_link_local covers 169.254/16 and fe80::/10", {
  assert(IpAddr.V4(u8(169), u8(254), u8(0), u8(1)).is_link_local(), "169.254/16");
  assert(!IpAddr.V4(u8(169), u8(253), u8(0), u8(1)).is_link_local(), "169.253 is not");
  assert(_ok_v6(`fe80::1`).is_link_local(), "fe80::/10");
  assert(_ok_v6(`febf::1`).is_link_local(), "the top of fe80::/10");
  assert(!_ok_v6(`fec0::1`).is_link_local(), "fec0 is outside fe80::/10");
});
_must_reject_sockaddr :: (fn(s : String) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  SocketAddr.parse(s, exn);
  assert(false, `SocketAddr.parse accepted ${s}`);
});
test("SocketAddr.parse takes host:port and requires brackets for V6", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  rejected a valid socket address: ${err}`);
        assert(false, "must accept");
        unwind(());
      }
    )
  );
  a := SocketAddr.parse(`127.0.0.1:8080`, exn);
  assert(a.ip == IpAddr.loopback_v4(), "host parsed");
  assert(a.port == u16(8080), "port parsed");
  b := SocketAddr.parse(`[::1]:443`, exn);
  assert(b.ip == IpAddr.loopback_v6(), "bracketed V6 host parsed");
  assert(b.port == u16(443), "and its port");
  assert(SocketAddr.parse(`0.0.0.0:0`, exn).port == u16(0), "port 0 is legal — it means 'any'");
  assert(SocketAddr.parse(`[2001:db8::1]:65535`, exn).port == u16(65535), "the top port");
  // to_string already brackets a V6 host, so a socket address round-trips.
  assert(SocketAddr.parse(b.to_string(), exn) == b, "to_string round-trips through parse");
  assert(SocketAddr.parse(a.to_string(), exn) == a, "and so does a V4 one");
});
test("SocketAddr.parse rejects the ambiguous and the out-of-range", {
  // A bare V6 host is ambiguous — is the trailing group a port? That is why
  // RFC 3986 3.2.2 introduced the brackets, so guessing is not an option.
  _must_reject_sockaddr(`::1:80`);
  _must_reject_sockaddr(`2001:db8::1:8080`);
  // Malformed brackets.
  _must_reject_sockaddr(`[::1:80`);
  _must_reject_sockaddr(`[::1]80`);
  _must_reject_sockaddr(`[::1]`);
  // A port above 65535 must be REJECTED, not truncated: parse_i32 accepts
  // 70000 and a u16 cast would silently make it 4464.
  _must_reject_sockaddr(`127.0.0.1:70000`);
  _must_reject_sockaddr(`127.0.0.1:65536`);
  _must_reject_sockaddr(`127.0.0.1:99999999999`);
  // No port, an empty port, a non-numeric port.
  _must_reject_sockaddr(`127.0.0.1`);
  _must_reject_sockaddr(`127.0.0.1:`);
  _must_reject_sockaddr(`127.0.0.1:http`);
  _must_reject_sockaddr(`127.0.0.1:-1`);
  // And a host that is not an address.
  _must_reject_sockaddr(`example.com:80`);
  _must_reject_sockaddr(`1.2.3:80`);
});
