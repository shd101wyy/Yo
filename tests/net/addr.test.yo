pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
open(import("std/fmt"));
{ IpAddr, SocketAddr } :: import("std/net/addr");
{ NetError } :: import("std/net/errors");
{ Error, AnyError, Exception } :: import("std/error");
// ============================================================================
// IpAddr tests
// ============================================================================
test("IpAddr.loopback_v4 returns 127.0.0.1", {
  addr := IpAddr.loopback_v4();
  assert(addr.is_loopback(), "should be loopback");
  assert(addr.is_v4(), "should be v4");
  assert(!addr.is_v6(), "should not be v6");
  s := addr.to_string();
  unsafe(printf("  loopback_v4 = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `127.0.0.1`, "should be 127.0.0.1");
});
test("IpAddr.loopback_v6 returns ::1", {
  addr := IpAddr.loopback_v6();
  assert(addr.is_loopback(), "should be loopback");
  assert(addr.is_v6(), "should be v6");
  assert(!addr.is_v4(), "should not be v4");
});
test("IpAddr.any_v4 returns 0.0.0.0", {
  addr := IpAddr.any_v4();
  assert(addr.is_v4(), "should be v4");
  assert(!addr.is_loopback(), "should not be loopback");
  s := addr.to_string();
  unsafe(printf("  any_v4 = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `0.0.0.0`, "should be 0.0.0.0");
});
test("IpAddr.parse_v4 valid address", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := IpAddr.parse_v4(`192.168.1.100`, exn);
  assert(addr.is_v4(), "should be v4");
  s := addr.to_string();
  unsafe(printf("  parsed = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `192.168.1.100`, "should be 192.168.1.100");
});
test("IpAddr.parse_v4 loopback", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := IpAddr.parse_v4(`127.0.0.1`, exn);
  assert(addr.is_loopback(), "should be loopback");
});
test("IpAddr.parse_v4 invalid address", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  IpAddr.parse_v4(`999.0.0.1`, exn);
  assert(false, "should fail for out of range");
});
test("IpAddr.parse_v4 too few octets", {
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("  correctly rejected\n"));
        unwind(());
      }
    )
  );
  IpAddr.parse_v4(`1.2.3`, exn);
  assert(false, "should fail for too few octets");
});
test("IpAddr.parse_v4 invalid char", {
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("  correctly rejected\n"));
        unwind(());
      }
    )
  );
  IpAddr.parse_v4(`1.2.3.abc`, exn);
  assert(false, "should fail for invalid char");
});
// ============================================================================
// SocketAddr tests
// ============================================================================
test("SocketAddr.new creates correct address", {
  ip := IpAddr.loopback_v4();
  addr := SocketAddr.new(ip, u16(8080));
  assert(addr.port == u16(8080), "port should be 8080");
  assert(addr.ip.is_loopback(), "ip should be loopback");
  s := addr.to_string();
  unsafe(printf("  addr = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `127.0.0.1:8080`, "should be 127.0.0.1:8080");
});
test("SocketAddr.loopback creates loopback address", {
  addr := SocketAddr.loopback(u16(3000));
  s := addr.to_string();
  unsafe(printf("  addr = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `127.0.0.1:3000`, "should be 127.0.0.1:3000");
});
test("SocketAddr.any creates any address", {
  addr := SocketAddr.any(u16(9090));
  s := addr.to_string();
  unsafe(printf("  addr = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `0.0.0.0:9090`, "should be 0.0.0.0:9090");
});
test("IpAddr V4 to_string various addresses", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := IpAddr.parse_v4(`10.0.0.1`, exn);
  s := addr.to_string();
  unsafe(printf("  10.0.0.1 = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `10.0.0.1`, "should match");
});
test("SocketAddr with parsed IP", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  ip := IpAddr.parse_v4(`10.20.30.40`, exn);
  addr := SocketAddr.new(ip, u16(443));
  s := addr.to_string();
  unsafe(printf("  addr = %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `10.20.30.40:443`, "should be 10.20.30.40:443");
});
// `parse_v4` accepted two shapes it must reject — both are silent WRONG VALUES,
// not errors: an empty octet (`"..."` parsed as 0.0.0.0, `"1.2.3."` as 1.2.3.0)
// because nothing counted the digits in an octet, and an octet that wraps u32
// (`"4294967297.0.0.0"` parsed as 1.0.0.0) because the accumulator was only
// range-checked at the separator. Rust's Ipv4Addr::from_str rejects both, and
// leading zeros (`"01.2.3.4"`, octal ambiguity) — so do we now.
// issues/fixed/ipaddr-parse-v4-accepts-empty-and-wrapping-octets.md
_must_reject_v4 :: (fn(s : String) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  IpAddr.parse_v4(s, exn);
  assert(false, `parse_v4 accepted ${s}`);
});
test("IpAddr.parse_v4 rejects empty octets", {
  _must_reject_v4(`...`);
  _must_reject_v4(`1.2.3.`);
  _must_reject_v4(`.1.2.3`);
  _must_reject_v4(`1..2.3`);
  _must_reject_v4(``);
});
test("IpAddr.parse_v4 rejects an octet that wraps the accumulator", {
  _must_reject_v4(`4294967297.0.0.0`);
  _must_reject_v4(`99999999999.0.0.0`);
});
test("IpAddr.parse_v4 rejects leading zeros like Rust", {
  _must_reject_v4(`01.2.3.4`);
  _must_reject_v4(`1.2.3.007`);
  exn := Exception(
    throw : (
      err -> {
        assert(false, "0.0.0.0 is valid");
        unwind(());
      }
    )
  );
  z := IpAddr.parse_v4(`0.0.0.0`, exn);
  assert(z.to_string() == "0.0.0.0", "a lone 0 octet is not a leading zero");
});
