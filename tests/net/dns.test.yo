pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (DNS resolution unavailable)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (DNS resolution unavailable)
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import("std/collections/array_list");
open(import("std/string"));
open(import("std/fmt"));
{ lookup_host, resolve } :: import("std/net/dns");
{ IpAddr, SocketAddr } :: import("std/net/addr");
{ NetError } :: import("std/net/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
// ============================================================================
// DNS tests
// ============================================================================
test("lookup_host localhost returns loopback", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "lookup_host localhost should succeed");
        unwind(());
      }
    )
  );
  addrs := io.await(lookup_host(`localhost`, io), IoExn(io : io, exn : exn));
  unsafe(printf("  addrs.len = %zu\n", addrs.len()));
  assert(addrs.len() > usize(0), "should resolve at least one address");
  // Check that at least one address is loopback
  found_loopback := false;
  i := usize(0);
  while(runtime(i < addrs.len()), {
    addr := addrs(i);
    unsafe(printf("  addr[%zu] = %s\n", i, addr.to_string().to_cstr().ptr().unwrap()));
    cond(
      addr.is_loopback() => {
        found_loopback = true;
      },
      true => ()
    );
    i = (i + usize(1));
  });
  assert(found_loopback, "at least one result should be loopback");
});
test("lookup_host invalid host fails", {
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("  expected error from invalid host\n"));
        unwind(());
      }
    )
  );
  addrs := io.await(lookup_host(`this.host.does.not.exist.invalid`, io), IoExn(io : io, exn : exn));
  // Some systems may resolve any domain; if so, skip assertion
  unsafe(printf("  unexpectedly resolved %zu addresses\n", addrs.len()));
});
test("resolve localhost returns socket addresses", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "resolve localhost should succeed");
        unwind(());
      }
    )
  );
  addrs := io.await(resolve(`localhost`, u16(8080), io), IoExn(io : io, exn : exn));
  unsafe(printf("  addrs.len = %zu\n", addrs.len()));
  assert(addrs.len() > usize(0), "should resolve at least one address");
  i := usize(0);
  while(runtime(i < addrs.len()), {
    addr := addrs(i);
    unsafe(printf("  addr[%zu] = %s\n", i, addr.to_string().to_cstr().ptr().unwrap()));
    // Verify port is 8080
    assert(addr.port == u16(8080), "port should be 8080");
    // Verify IP is loopback
    assert(addr.ip.is_loopback(), "ip should be loopback");
    i = (i + usize(1));
  });
});
test("lookup_host returns IPv6 results (was: AAAA records dropped)", {
  // plans/STD_API_AUDIT.md C3: the result walk imported AF_INET6 and then
  // silently skipped every non-AF_INET entry, so all IPv6 results vanished.
  // The "::1" literal resolves numerically (no resolver query) and is
  // AF_INET6-only, so pre-fix this returned an EMPTY list.
  exn := Exception(
    throw : (
      err -> {
        assert(false, "lookup_host(::1) should succeed");
        unwind(());
      }
    )
  );
  addrs := io.await(lookup_host(`::1`, io), IoExn(io : io, exn : exn));
  unsafe(printf("  addrs.len = %zu\n", addrs.len()));
  assert(addrs.len() > usize(0), "the ::1 literal must yield at least one address");
  found_v6 := false;
  i := usize(0);
  while(runtime(i < addrs.len()), {
    addr := addrs(i);
    unsafe(printf("  addr[%zu] = %s\n", i, addr.to_string().to_cstr().ptr().unwrap()));
    cond(
      addr.is_v6() => {
        found_v6 = true;
        assert(addr.is_loopback(), "::1 must parse as the V6 loopback");
      },
      true => ()
    );
    i = (i + usize(1));
  });
  assert(found_v6, "::1 must come back as a V6 address, not be silently dropped");
});
