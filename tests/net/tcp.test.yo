pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (TCP sockets unavailable)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (TCP sockets unavailable)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import("std/collections/array_list");
open(import("std/string"));
open(import("std/fmt"));
{ TcpListener, TcpStream, Shutdown } :: import("std/net/tcp");
{ SocketAddr, IpAddr } :: import("std/net/addr");
{ NetError } :: import("std/net/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
// ============================================================================
// TcpListener tests
// ============================================================================
test("TcpListener bind and close", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  listener := io.await(TcpListener.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  unsafe(printf("  listener fd = %d\n", listener.fd()));
  assert(listener.fd() >= i32(0), "fd should be valid");
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  unsafe(printf("  close ok\n"));
});
test("TcpListener local_addr returns bound address", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  listener := io.await(TcpListener.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  la := listener.local_addr();
  unsafe(printf("  local_addr = %s\n", la.to_string().to_cstr().ptr().unwrap()));
  assert(la.ip.is_loopback(), "should be loopback");
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
// ============================================================================
// TcpStream tests
// ============================================================================
test("TCP connect to listener and accept", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19900));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  unsafe(printf("  listener fd = %d\n", listener.fd()));
  client := io.await(TcpStream.connect(addr, io), IoExn(io : io, exn : exn));
  unsafe(printf("  client fd = %d\n", client.fd()));
  server_stream := io.await(listener.accept(io), IoExn(io : io, exn : exn));
  unsafe(printf("  accepted fd = %d\n", server_stream.fd()));
  assert(server_stream.fd() >= i32(0), "accepted fd should be valid");
  io.await(server_stream.close(io), IoExn(io : io, exn : exn));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
test("TCP echo with write_str and read", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19901));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  client := io.await(TcpStream.connect(addr, io), IoExn(io : io, exn : exn));
  server_stream := io.await(listener.accept(io), IoExn(io : io, exn : exn));
  // Client sends
  n := io.await(client.write_str("Hello Net!", io), IoExn(io : io, exn : exn));
  unsafe(printf("  sent = %zu\n", n));
  assert(n == usize(10), "should send 10 bytes");
  // Server reads
  recv_buf := *(u8)(malloc(usize(256)).unwrap());
  nr := io.await(server_stream.read(recv_buf, usize(256), io), IoExn(io : io, exn : exn));
  unsafe(printf("  received = %zu\n", nr));
  assert(nr == usize(10), "should receive 10 bytes");
  assert((recv_buf.add(usize(0))).* == u8(72), "H");
  assert((recv_buf.add(usize(1))).* == u8(101), "e");
  assert((recv_buf.add(usize(2))).* == u8(108), "l");
  assert((recv_buf.add(usize(3))).* == u8(108), "l");
  assert((recv_buf.add(usize(4))).* == u8(111), "o");
  free(.Some(*(void)(recv_buf)));
  io.await(server_stream.close(io), IoExn(io : io, exn : exn));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
