  n := io.await(client.write_string(msg, io), IoExn(io : io, exn : exn));
  unsafe(printf("  sent = %d\n", n));
  assert(n == i32(13), "should send 13 bytes");
  // Server reads
  recv_buf := *(u8)(malloc(usize(256)).unwrap());
  nr := io.await(server_stream.read(recv_buf, usize(256), io), IoExn(io : io, exn : exn));
  unsafe(printf("  received = %d\n", nr));
  assert(nr == i32(13), "should receive 13 bytes");
  free(.Some(*(void)(recv_buf)));
  io.await(server_stream.close(io), IoExn(io : io, exn : exn));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
test("TCP write_bytes", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19903));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  client := io.await(TcpStream.connect(addr, io), IoExn(io : io, exn : exn));
  server_stream := io.await(listener.accept(io), IoExn(io : io, exn : exn));
  // Write bytes
  data := ArrayList(u8).new();
  data.push(u8(1));
  data.push(u8(2));
  data.push(u8(3));
  data.push(u8(4));
  n := io.await(client.write_bytes(data, io), IoExn(io : io, exn : exn));
  unsafe(printf("  sent = %d\n", n));
  assert(n == i32(4), "should send 4 bytes");
  // Server reads
  recv_buf := *(u8)(malloc(usize(256)).unwrap());
  nr := io.await(server_stream.read(recv_buf, usize(256), io), IoExn(io : io, exn : exn));
  unsafe(printf("  received = %d\n", nr));
  assert(nr == i32(4), "should receive 4 bytes");
  assert((recv_buf.add(usize(0))).* == u8(1), "byte 0");
  assert((recv_buf.add(usize(1))).* == u8(2), "byte 1");
  assert((recv_buf.add(usize(2))).* == u8(3), "byte 2");
  assert((recv_buf.add(usize(3))).* == u8(4), "byte 3");
  free(.Some(*(void)(recv_buf)));
  io.await(server_stream.close(io), IoExn(io : io, exn : exn));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
test("TCP set_nodelay and set_keepalive", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19904));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  client := io.await(TcpStream.connect(addr, io), IoExn(io : io, exn : exn));
  io.await(client.set_nodelay(true, io), IoExn(io : io, exn : exn));
  unsafe(printf("  nodelay ok\n"));
  io.await(client.set_keepalive(true, io), IoExn(io : io, exn : exn));
  unsafe(printf("  keepalive ok\n"));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
test("TCP shutdown", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19905));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  client := io.await(TcpStream.connect(addr, io), IoExn(io : io, exn : exn));
  server_stream := io.await(listener.accept(io), IoExn(io : io, exn : exn));
  io.await(client.shutdown(SHUT_RDWR, io), IoExn(io : io, exn : exn));
  unsafe(printf("  shutdown ok\n"));
  io.await(server_stream.close(io), IoExn(io : io, exn : exn));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
test("TCP peer_addr returns remote address", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19906));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  client := io.await(TcpStream.connect(addr, io), IoExn(io : io, exn : exn));
  pa := client.peer_addr();
  unsafe(printf("  peer_addr = %s\n", pa.to_string().to_cstr().ptr().unwrap()));
  assert(pa.ip.is_loopback(), "peer should be loopback");
  assert(pa.port == u16(19906), "peer port should be 19906");
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
test("TCP read_bytes gets all data", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19907));
  listener := io.await(TcpListener.bind(addr, io), IoExn(io : io, exn : exn));
  client := io.await(TcpStream.connect(addr, io), IoExn(io : io, exn : exn));
  server_stream := io.await(listener.accept(io), IoExn(io : io, exn : exn));
  // Client sends data then closes write side
  io.await(client.write_str("ABCDE", io), IoExn(io : io, exn : exn));
  io.await(client.shutdown(i32(1), io), IoExn(io : io, exn : exn));
  // Server reads all
  data := io.await(server_stream.read_bytes(io), IoExn(io : io, exn : exn));
  unsafe(printf("  read_bytes len = %lld\n", i64(data.len())));
  assert(data.len() == usize(5), "should be 5 bytes");
  assert(data(usize(0)) == u8(65), "A");
  assert(data(usize(1)) == u8(66), "B");
  assert(data(usize(2)) == u8(67), "C");
  assert(data(usize(3)) == u8(68), "D");
  assert(data(usize(4)) == u8(69), "E");
  io.await(server_stream.close(io), IoExn(io : io, exn : exn));
  io.await(client.close(io), IoExn(io : io, exn : exn));
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
