pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (TCP sockets unavailable)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (TCP sockets unavailable)
pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import("std/collections/array_list");
open(import("std/string"));
open(import("std/fmt"));
{ TcpListener, TcpStream } :: import("std/net/tcp");
{ SocketAddr, IpAddr } :: import("std/net/addr");
{ NetError } :: import("std/net/errors");
{ SHUT_RDWR } :: import("std/sys/socket");
{ Error, AnyError, Exception } :: import("std/error");
// ============================================================================
// TcpListener tests
// ============================================================================
test("TcpListener bind and close", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  listener := io.await(TcpListener.bind(SocketAddr.loopback(u16(0)), io), io);
  printf("  listener fd = %d\n", listener.fd());
  assert(listener.fd() >= i32(0), "fd should be valid");
  io.await(listener.close(io), io);
  printf("  close ok\n");
});
test("TcpListener local_addr returns bound address", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  listener := io.await(TcpListener.bind(SocketAddr.loopback(u16(0)), io), io);
  la := listener.local_addr();
  printf("  local_addr = %s\n", la.to_string().to_cstr().ptr().unwrap());
  assert(la.ip.is_loopback(), "should be loopback");
  io.await(listener.close(io), io);
});
// ============================================================================
// TcpStream tests
// ============================================================================
test("TCP connect to listener and accept", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19900));
  listener := io.await(TcpListener.bind(addr, io), io);
  printf("  listener fd = %d\n", listener.fd());
  client := io.await(TcpStream.connect(addr, io), io);
  printf("  client fd = %d\n", client.fd());
  server_stream := io.await(listener.accept(io), io);
  printf("  accepted fd = %d\n", server_stream.fd());
  assert(server_stream.fd() >= i32(0), "accepted fd should be valid");
  io.await(server_stream.close(io), io);
  io.await(client.close(io), io);
  io.await(listener.close(io), io);
});
test("TCP echo with write_str and read", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19901));
  listener := io.await(TcpListener.bind(addr, io), io);
  client := io.await(TcpStream.connect(addr, io), io);
  server_stream := io.await(listener.accept(io), io);
  // Client sends
  n := io.await(client.write_str("Hello Net!", io), io);
  printf("  sent = %d\n", n);
  assert(n == i32(10), "should send 10 bytes");
  // Server reads
  recv_buf := *(u8)(malloc(usize(256)).unwrap());
  nr := io.await(server_stream.read(recv_buf, usize(256), io), io);
  printf("  received = %d\n", nr);
  assert(nr == i32(10), "should receive 10 bytes");
  assert((recv_buf &+ usize(0)).* == u8(72), "H");
  assert((recv_buf &+ usize(1)).* == u8(101), "e");
  assert((recv_buf &+ usize(2)).* == u8(108), "l");
  assert((recv_buf &+ usize(3)).* == u8(108), "l");
  assert((recv_buf &+ usize(4)).* == u8(111), "o");
  free(.Some(*(void)(recv_buf)));
  io.await(server_stream.close(io), io);
  io.await(client.close(io), io);
  io.await(listener.close(io), io);
});
test("TCP echo with write String", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19902));
  listener := io.await(TcpListener.bind(addr, io), io);
  client := io.await(TcpStream.connect(addr, io), io);
  server_stream := io.await(listener.accept(io), io);
  // Write using String
  msg := `Hello String!`;
  n := io.await(client.write_string(msg, io), io);
  printf("  sent = %d\n", n);
  assert(n == i32(13), "should send 13 bytes");
  // Server reads
  recv_buf := *(u8)(malloc(usize(256)).unwrap());
  nr := io.await(server_stream.read(recv_buf, usize(256), io), io);
  printf("  received = %d\n", nr);
  assert(nr == i32(13), "should receive 13 bytes");
  free(.Some(*(void)(recv_buf)));
  io.await(server_stream.close(io), io);
  io.await(client.close(io), io);
  io.await(listener.close(io), io);
});
test("TCP write_bytes", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19903));
  listener := io.await(TcpListener.bind(addr, io), io);
  client := io.await(TcpStream.connect(addr, io), io);
  server_stream := io.await(listener.accept(io), io);
  // Write bytes
  data := ArrayList(u8).new();
  data.push(u8(1));
  data.push(u8(2));
  data.push(u8(3));
  data.push(u8(4));
  n := io.await(client.write_bytes(data, io), io);
  printf("  sent = %d\n", n);
  assert(n == i32(4), "should send 4 bytes");
  // Server reads
  recv_buf := *(u8)(malloc(usize(256)).unwrap());
  nr := io.await(server_stream.read(recv_buf, usize(256), io), io);
  printf("  received = %d\n", nr);
  assert(nr == i32(4), "should receive 4 bytes");
  assert((recv_buf &+ usize(0)).* == u8(1), "byte 0");
  assert((recv_buf &+ usize(1)).* == u8(2), "byte 1");
  assert((recv_buf &+ usize(2)).* == u8(3), "byte 2");
  assert((recv_buf &+ usize(3)).* == u8(4), "byte 3");
  free(.Some(*(void)(recv_buf)));
  io.await(server_stream.close(io), io);
  io.await(client.close(io), io);
  io.await(listener.close(io), io);
});
test("TCP set_nodelay and set_keepalive", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19904));
  listener := io.await(TcpListener.bind(addr, io), io);
  client := io.await(TcpStream.connect(addr, io), io);
  io.await(client.set_nodelay(true, io), io);
  printf("  nodelay ok\n");
  io.await(client.set_keepalive(true, io), io);
  printf("  keepalive ok\n");
  io.await(client.close(io), io);
  io.await(listener.close(io), io);
});
test("TCP shutdown", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19905));
  listener := io.await(TcpListener.bind(addr, io), io);
  client := io.await(TcpStream.connect(addr, io), io);
  server_stream := io.await(listener.accept(io), io);
  io.await(client.shutdown(SHUT_RDWR, io), io);
  printf("  shutdown ok\n");
  io.await(server_stream.close(io), io);
  io.await(client.close(io), io);
  io.await(listener.close(io), io);
});
test("TCP peer_addr returns remote address", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19906));
  listener := io.await(TcpListener.bind(addr, io), io);
  client := io.await(TcpStream.connect(addr, io), io);
  pa := client.peer_addr();
  printf("  peer_addr = %s\n", pa.to_string().to_cstr().ptr().unwrap());
  assert(pa.ip.is_loopback(), "peer should be loopback");
  assert(pa.port == u16(19906), "peer port should be 19906");
  io.await(client.close(io), io);
  io.await(listener.close(io), io);
});
test("TCP read_bytes gets all data", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  addr := SocketAddr.loopback(u16(19907));
  listener := io.await(TcpListener.bind(addr, io), io);
  client := io.await(TcpStream.connect(addr, io), io);
  server_stream := io.await(listener.accept(io), io);
  // Client sends data then closes write side
  io.await(client.write_str("ABCDE", io), io);
  io.await(client.shutdown(i32(1), io), io);
  // Server reads all
  data := io.await(server_stream.read_bytes(io), io);
  printf("  read_bytes len = %lld\n", i64(data.len()));
  assert(data.len() == usize(5), "should be 5 bytes");
  assert(data.get(usize(0)).unwrap() == u8(65), "A");
  assert(data.get(usize(1)).unwrap() == u8(66), "B");
  assert(data.get(usize(2)).unwrap() == u8(67), "C");
  assert(data.get(usize(3)).unwrap() == u8(68), "D");
  assert(data.get(usize(4)).unwrap() == u8(69), "E");
  io.await(server_stream.close(io), io);
  io.await(client.close(io), io);
  io.await(listener.close(io), io);
});
