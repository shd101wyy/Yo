pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM (TCP sockets unavailable)
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM (TCP sockets unavailable)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ gets, printf, EOF } :: import("std/libc/stdio");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ eprintln } :: import("std/fmt");
{ TcpListener, TcpStream, Shutdown } :: import("std/net/tcp");
{ SocketAddr, IpAddr } :: import("std/net/addr");
{ NetError } :: import("std/net/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
{ Stream } :: import("std/async/stream");
{ timeout } :: import("std/async");
{ Duration } :: import("std/time/duration");
{ sleep } :: import("std/sys/timer");
{ Instant } :: import("std/time/instant");
// ============================================================================
// TcpListener tests
// ============================================================================
test("TcpListener bind and close", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  listener := io.await(TcpListener.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  unsafe(printf("  listener fd = %d\n", listener.fd()));
  assert(listener.fd() >= i32(0), "fd should be valid");
  io.await(listener.close(io), IoExn(io : io, exn : exn));
  unsafe(printf("  close ok\n"));
});
test("TcpListener local_addr returns bound address", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  listener := io.await(TcpListener.bind(SocketAddr.loopback(u16(0)), io), IoExn(io : io, exn : exn));
  la := listener.local_addr();
  unsafe(printf("  local_addr = %s\n", la.to_string().to_cstr().ptr().unwrap()));
  assert(la.ip.is_loopback(), "should be loopback");
  io.await(listener.close(io), IoExn(io : io, exn : exn));
});
