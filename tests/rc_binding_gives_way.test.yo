//! `rc` was the prelude's cell constructor until static-argument inference B3
//! deleted it (plans/backlog/STATIC_ARGUMENT_INFERENCE.md §5): `Rc.new(v)`
//! builds the cell, and the count is the `ref_count(x)` builtin
//! (plans/VALUES_BY_DEFAULT.md decision 11). This file pins that `rc` is an
//! ordinary name now:
//! - a call `rc(x)` with no binding of `rc` in scope is E0401, whose help
//!   names `Rc.new(x)`;
//! - a local definition named `rc` is allowed, there is no prelude name to
//!   shadow;
//! - a function PARAMETER or a match-pattern binding named `rc` wins inside
//!   its scope: a call `rc(x)` there calls the parameter.
{ assert } :: import("std/assert");
{ ToString } :: import("std/fmt");
{ String } :: import("std/string");
_apply :: (fn(rc : &Impl(Fn(v : i32) -> i32), x : i32) -> i32)(rc(x));
_status_plus_one :: (fn(rc : i32) -> i32)(rc + i32(1));
// `dyn(rc)` boxes the parameter through the cell constructor the compiler
// names itself, `Rc(i32).new`, which no binding can capture
// (issues/fixed/2026-10-27-dyn-of-a-value-under-a-parameter-named-rc-calls-the-parameter.md).
_boxed_under_rc_param :: (fn(rc : i32) -> Dyn(ToString))(dyn(rc));
test("a call of rc with no binding of it is E0401, naming Rc.new", {
  comptime_expect_error(rc(i32(7)), "`rc(x)` is `Rc.new(x)`");
  b := Rc.new(i32(7));
  assert(ref_count(b) == usize(1), "Rc.new builds a cell with one owner");
});
test("a local definition named rc is an ordinary binding", {
  rc := i32(3);
  assert((rc + i32(1)) == i32(4), "the local reads as itself");
});
test("a parameter named rc binds inside its function", {
  assert(_apply(v => (v * i32(2)), i32(21)) == i32(42), "rc(x) calls the parameter");
  assert(_status_plus_one(i32(1)) == i32(2), "a non-function parameter named rc reads as the parameter");
});
test("a match-pattern binding named rc binds inside its arm", {
  y := match(Option(i32).Some(i32(5)), .Some(rc) => (rc + i32(1)), .None => i32(0));
  assert(y == i32(6), "the arm reads the bound payload");
  comptime_expect_error(rc(i32(9)), "`rc(x)` is `Rc.new(x)`");
});
test("a parameter named rc does not capture the cell dyn(...) builds", {
  d := _boxed_under_rc_param(i32(5));
  assert(d.to_string() == `5`, "the parameter is boxed through Rc(i32).new");
});
