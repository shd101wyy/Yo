{ assert } :: import("std/assert");
/// Tests for `inout(name) : T` parameter form
/// (Phase B of plans/reference/MEMORY_SAFETY.md).
///
/// `inout(name) : T` is a parameter modifier (parallel to `own(name)`)
/// that gives second-class reference semantics: assignments inside the
/// callee write through to the caller's variable. At codegen time
/// ref params lower to `T*` in C; the caller automatically passes
/// `&(arg)`.
swap_i32 :: (fn(inout(a) : i32, inout(b) : i32) -> unit)({
  tmp := a;
  a = b;
  b = tmp;
});

increment :: (fn(inout(n) : i32) -> unit)({
  n = (n + i32(1));
});

add_to :: (fn(inout(dst) : i32, src : i32) -> unit)({
  dst = (dst + src);
});

set_both :: (fn(inout(a) : i32, inout(b) : i32, v : i32) -> unit)({
  a = v;
  b = v;
});

double_then_swap :: (fn(inout(x) : i32, inout(y) : i32) -> unit)({
  // Calls ref-param fn passing through ref-params.
  add_to(x, x);
  add_to(y, y);
  swap_i32(x, y);
});

test("swap mutates caller variables", {
  x := i32(1);
  y := i32(2);
  swap_i32(x, y);
  assert(x == i32(2), "x swapped");
  assert(y == i32(1), "y swapped");
});

test("increment mutates caller variable", {
  counter := i32(0);
  increment(counter);
  increment(counter);
  increment(counter);
  assert(counter == i32(3), "counter incremented three times");
});

test("ref + value parameter mix", {
  acc := i32(10);
  add_to(acc, i32(5));
  add_to(acc, i32(7));
  assert(acc == i32(22), "accumulated");
});

test("ref with same value via two params", {
  a := i32(0);
  b := i32(0);
  set_both(a, b, i32(42));
  assert(a == i32(42), "a set");
  assert(b == i32(42), "b set");
});

test("ref chained through another ref-param fn", {
  x := i32(3);
  y := i32(5);
  double_then_swap(x, y);
  // x was 3 -> 6 (doubled), y was 5 -> 10 (doubled), then swapped.
  assert(x == i32(10), "x doubled then swapped");
  assert(y == i32(6), "y doubled then swapped");
});

test("ref read returns current caller value", {
  v := i32(100);
  read_back :: (fn(inout(p) : i32) -> i32)(p);
  result := read_back(v);
  assert(result == i32(100), "read through ref");
});
// Regression (issues/fixed/inout-return-in-nested-block-shadows-pointer.md):
// `return(m)` of an inout PARAM from inside a nested block emitted
// `int32_t m = (*m);` — a C local shadowing the pointer parameter whose
// initializer dereferences itself — "indirection requires pointer operand".
// The top-level tail `m` never hit it (no nested block, no shadow).
test("returning an inout param from inside a nested block", {
  first_positive :: (fn(inout(m) : i32) -> i32)({
    if(m > i32(0), {
      return(m);
    });
    m = i32(-1);
    m
  });
  a := i32(4);
  assert(first_positive(a) == i32(4), "returned through the pointer");
  assert(a == i32(4), "untouched on the early path");
  b := i32(0);
  assert(first_positive(b) == i32(-1), "fallthrough writes back and returns");
  assert(b == i32(-1), "write-back landed");
});
{ String } :: import("std/string");
// issues/fixed/inout-arg-to-own-param-moves-without-dup.md: an `inout`
// parameter passed BY VALUE to an `own` parameter hands the callee a COPY
// (+1) of the referenced handle; the referenced slot keeps its own count and
// the parameter stays usable. (The dup was skipped for the `(*name)` read, so
// the callee's release over-released the caller's variable.)
own_len :: (fn(own(v) : String) -> usize)(v.len());
test("inout parameter passed to an own parameter copies, the referenced slot survives", {
  via_param :: (fn(inout(p) : String) -> usize)({
    n := own_len(p);
    p.push_str("!");
    n
  });
  s := String.from("abc");
  n := via_param(s);
  assert(n == usize(3), "callee saw the value");
  assert(s == "abc!", "the referenced slot is intact and the parameter stayed usable after the own call");
  assert(rc(s) == 1, "the copy handed to the own parameter was released by the callee; the slot owns its value once");
});
