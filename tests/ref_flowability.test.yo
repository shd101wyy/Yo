/// Phase B of plans/ITERATOR_REDESIGN.md — flowability rule (R1–R4).
///
/// A `ref(T)`-yielding expression must root back to a `ref`-bound
/// parameter along a projection-respecting chain. This file pins
/// the negative cases (rejected at evaluation time) and a handful
/// of positives that the chain accepts.
///
/// The rule applies in two positions:
///
/// - The right-hand side of `ref(name) := expr;` local bindings.
/// - The return expression of `-> ref(T)` functions (the body's
///   last expression, or the only expression for single-expression
///   bodies).
///
/// The four numbered cases below come straight from the plan; the
/// "Mixed cases" section exercises field-access, projection chains,
/// and cond/match arms.
pragma(Pragma.AllowUnsafe);
// ── Functions used by the tests below ────────────────────────────
identity :: (fn(ref(p) : i32) -> ref(i32))(p);
Point :: struct(x : i32, y : i32);
point_x :: (fn(ref(p) : Point) -> ref(i32))(p.x);
returns_value :: (fn() -> i32)(i32(42));
// ── R1: a `ref`-bound parameter atom is flowable ─────────────────
// Already covered by `ref_return.test.yo`; re-pinned here as the
// canonical R1 example to anchor the others.
// ── R1: a bare local atom is NOT flowable ────────────────────────
// Returning a local from a `-> ref(T)` function is rejected because
// the storage dies with the call frame.
comptime_expect_error(
  bad_local_return :: (fn() -> ref(i32))({
    x := i32(12);
    x
  })
);
// ── R2: field of a local struct is NOT flowable ──────────────────
comptime_expect_error(
  bad_field_of_local :: (fn() -> ref(i32))({
    p := Point(x : i32(1), y : i32(2));
    p.x
  })
);
// ── R2 (positive): field of a `ref`-bound parameter IS flowable ──
// (Covered by `point_x` above — no separate `comptime_expect_error`
// needed.)
// ── R3: a function returning value (not ref) is NOT flowable ─────
// `returns_value` returns `i32`, not `ref(i32)`. Using its result
// as a return for a `-> ref(i32)` function is rejected.
comptime_expect_error(
  bad_call_value_return :: (fn(ref(p) : i32) -> ref(i32))(returns_value())
);
// ── R4 (cond): every arm must be flowable; one bad arm fails all ─
// In the bad case below, the first arm is flowable (`p.x`) but the
// fallback arm returns a local variable — rejected by R4 (every
// reachable arm must pass).
comptime_expect_error(
  bad_cond_mixed_arms :: (fn(ref(p) : Point, use_first : bool) -> ref(i32))(
    cond(
      use_first => p.x,
      true => {
        fallback := i32(0);
        fallback
      }
    )
  )
);
// ── RHS of `ref(name) :=` must also satisfy the rule ─────────────
// Binding to a non-flowable expression (a function returning a
// value type) is rejected at the binding site.
comptime_expect_error(
  bad_binding :: (fn() -> unit)({
    ref(r) := returns_value();
  })
);
// ── Positive: chain through a `ref`-returning helper ─────────────
// `identity(p)` is flowable because identity returns `ref(i32)` AND
// its `ref` parameter `p` receives a flowable argument (`p` is
// itself `ref`-bound). So the wrapper's body is also flowable.
chain :: (fn(ref(p) : i32) -> ref(i32))(identity(p));
test("flowability accepts a ref-call chain rooted in a ref param", {
  x := i32(5);
  ref(r) := chain(x);
  r = i32(99);
  assert(x == i32(99), "writes through the chained projection");
});
// ── Positive: `cond` with both arms flowable ─────────────────────
// Both arms project a field of the inout-bound `p`, so the full
// `cond` is flowable per R4.
pick :: (fn(ref(p) : Point, use_x : bool) -> ref(i32))(
  cond(
    use_x => p.x,
    true => p.y
  )
);
test("flowability accepts a cond whose arms all project from ref params", {
  pt := Point(x : i32(10), y : i32(20));
  ref(rx) := pick(pt, true);
  rx = i32(100);
  assert(pt.x == i32(100), "wrote through the cond-flowable projection");
});
