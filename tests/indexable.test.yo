/// Phase C of plans/ITERATOR_REDESIGN.md — `Indexable` trait + Array
/// impl. Verifies the end-to-end stack:
///
/// - The `Indexable(usize)` impl on `Array(T, N)` declares
///   `project` with `-> ref(T)` return slot.
/// - The body uses `unsafe(__yo_array_index(self, pos))` to compute
///   the element address. The flowability rule treats `unsafe(...)`
///   as the trusted escape hatch (the privilege gate already restricts
///   `unsafe` to pragma'd files).
/// - Codegen lowers the C signature to `T*` and reads/writes through
///   the resulting ref-binding propagate to the underlying array
///   element.
test("Array.project read", {
  arr := Array(i32, usize(3)).fill(i32(0));
  arr(usize(0)) = i32(10);
  arr(usize(1)) = i32(20);
  arr(usize(2)) = i32(30);
  ref(r0) := arr.project(usize(0));
  ref(r1) := arr.project(usize(1));
  ref(r2) := arr.project(usize(2));
  assert(r0 == i32(10), "r0 sees the 0th element");
  assert(r1 == i32(20), "r1 sees the 1st element");
  assert(r2 == i32(30), "r2 sees the 2nd element");
});
test("Array.project write propagates to the underlying array", {
  arr := Array(i32, usize(3)).fill(i32(0));
  ref(r) := arr.project(usize(1));
  r = i32(99);
  assert(arr(usize(0)) == i32(0), "untouched element stays at 0");
  assert(arr(usize(1)) == i32(99), "written element reflects the new value");
  assert(arr(usize(2)) == i32(0), "untouched element stays at 0");
});
test("Range-copy project read and write", {
  // Ranges COPY (plans/SLICE_REWORK.md): projection into the ArrayList
  // copy reads/writes the COPY, never the source array.
  arr := Array(i32, usize(3)).fill(i32(0));
  arr(usize(0)) = i32(10);
  arr(usize(1)) = i32(20);
  arr(usize(2)) = i32(30);
  s := arr(usize(0) .. usize(3));
  ref(r1) := s.project(usize(1));
  assert(r1 == i32(20), "copy.project reads the 1st element");
  r1 = i32(200);
  assert(match(s.get(usize(1)), .Some(v) => (v == i32(200)), .None => false), "write lands in the copy");
  assert(arr(usize(1)) == i32(20), "source array unaffected");
});
{ ArrayList } :: import("std/collections/array_list");
open(import("std/string"));
test("ArrayList.project read and write", {
  list := ArrayList(i32).new();
  list.push(i32(7));
  list.push(i32(14));
  list.push(i32(21));
  ref(r1) := list.project(usize(1));
  assert(r1 == i32(14), "ArrayList.project reads the 1st element");
  r1 = i32(140);
  assert(list(usize(1)) == i32(140), "writes through ArrayList projection propagate");
});
test("String.project read and write", {
  s := String.from("abcd");
  ref(b0) := s.project(usize(0));
  ref(b1) := s.project(usize(1));
  ref(b3) := s.project(usize(3));
  assert(b0 == u8(97), "String.project reads byte at index 0 (97 = 'a')");
  assert(b1 == u8(98), "String.project reads byte at index 1 (98 = 'b')");
  assert(b3 == u8(100), "String.project reads byte at index 3 (100 = 'd')");
  b1 = u8(122);
  assert(s(usize(1)) == u8(122), "writes through String.project propagate (122 = 'z')");
});
/// Phase D of plans/ITERATOR_REDESIGN.md — `for(coll, ref(x) => body)`
/// lambda-shape dispatch lowers to `coll.iter()` + `coll.project(pos)`
/// pairing. Verifies the end-to-end for-macro expansion across all four
/// collections that have `Indexable(usize)`.
test("for(arr, ref(x) => body) borrows each Array element", {
  arr := [i32(1), i32(2), i32(3)];
  sum := i32(0);
  for(arr, ref(x) => {
    sum = (sum + x);
    x = (x * i32(10));
  });
  assert(sum == i32(6), "sum reads original values via ref-binding");
  assert(arr(usize(0)) == i32(10), "writes propagate (0)");
  assert(arr(usize(1)) == i32(20), "writes propagate (1)");
  assert(arr(usize(2)) == i32(30), "writes propagate (2)");
});
test("for(slice, ref(x) => body) borrows each Slice element", {
  arr := [i32(10), i32(20), i32(30), i32(40)];
  s := arr(usize(1) .. usize(4));
  sum := i32(0);
  for(s, ref(x) => {
    sum = (sum + x);
  });
  assert(sum == i32(90), "for-loop over slice sums 20+30+40 = 90");
});
test("for(list, ref(x) => body) borrows each ArrayList element", {
  list := ArrayList(i32).new();
  list.push(i32(2));
  list.push(i32(3));
  list.push(i32(5));
  for(list, ref(x) => {
    x = (x * i32(x));
  });
  assert(list(usize(0)) == i32(4), "squared (0)");
  assert(list(usize(1)) == i32(9), "squared (1)");
  assert(list(usize(2)) == i32(25), "squared (2)");
});
test("for(s, ref(b) => body) borrows each String byte", {
  s := String.from("xyz");
  bytes_seen := ArrayList(u8).new();
  for(s, ref(b) => {
    bytes_seen.push(b);
  });
  assert(bytes_seen.len() == usize(3), "for-loop visits each byte");
  assert(bytes_seen(usize(0)) == u8(120), "0 = 'x' (120)");
  assert(bytes_seen(usize(1)) == u8(121), "1 = 'y' (121)");
  assert(bytes_seen(usize(2)) == u8(122), "2 = 'z' (122)");
});
test("for(s, ref(b) => body) writes propagate back to the String", {
  s := String.from("abc");
  for(s, ref(b) => {
    b = (b + u8(1));
  });
  assert(s(usize(0)) == u8(98), "a -> b");
  assert(s(usize(1)) == u8(99), "b -> c");
  assert(s(usize(2)) == u8(100), "c -> d");
});
