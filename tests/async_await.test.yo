  assert(result == i32(55), "Future with multiple individual effects should work");
};

// ---------------------------------------------------------------------------
// 63. Multiple effect row spreads: ...(E1), ...(E2)
// ---------------------------------------------------------------------------
test "Test Future with multiple effect row spreads", using(io : IO), {
  Raise :: (fn(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);

  might_fail :: (fn(using(raise : Raise)) -> i32)(
    raise(`oops`)
  );

  might_log :: (fn(using(log : Log)) -> unit)(
    log(`logged something`)
  );

  run_both :: (fn(
      forall(T1 : Type, T2 : Type, ...(E1), ...(E2)),
      f1 : (fn(using(...(E1))) -> T1),
      f2 : (fn(using(...(E2))) -> T2),
      using(...(E1), ...(E2))
    ) -> T1)
  {
    f2();
    f1()
  };

  task := io.async((using(io : IO))=> {
    (given(raise) : Raise) = ((msg) -> {
      println(msg);
      return i32(42);
    });
    (given(log) : Log) = ((msg) -> {
      println(msg);
    });
    result := run_both(might_fail, might_log);
    io.await(yield());
    result
  });
  result := io.await(task);
  assert(result == i32(42), "Future with multiple effect row spreads should work");
};

// ---------------------------------------------------------------------------
// 64. Mixed: individual effect + spread: using(my_raise : Raise, ...(E))
// ---------------------------------------------------------------------------
test "Test Future with mixed individual effect and spread", using(io : IO), {
  Raise :: (fn(msg : String) -> i32);

  task := io.async((using(io : IO))=> {
    (given(raise) : Raise) = ((msg) -> {
      println(msg);
      return i32(33);
    });

    might_fail_and_forward :: (fn(
        forall(...(E)),
        using(my_raise : Raise, ...(E))
      ) -> i32)
    (
      my_raise(`mixed-effect`)
    );

    result := might_fail_and_forward();
    io.await(yield());
    result
  });
  result := io.await(task);
  assert(result == i32(33), "Future with mixed individual effect and spread should work");
};

// ============================================================================
// Type-level Future tests — Impl(Future(T, ...)) as type aliases
// Effects are order-independent (set-based matching).
// ============================================================================

// ---------------------------------------------------------------------------
// 65. Impl(Future(i32, Log, IO, Raise)) — individual effects at type level
//     Effects listed in different order than the closure's (IO, Raise, Log)
