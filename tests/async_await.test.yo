  task := io.async((io : Io) => {
    (raise : Raise) = (
      (msg) -> {
        println(msg);
        return(i32(33));
      }
    );
    might_fail_and_forward :: (
      fn(
        generic(E : Type.Struct),
        my_raise : Raise,
        e : E
      ) -> i32
    )(
      my_raise(`mixed-effect`)
    );
