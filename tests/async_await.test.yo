// ---------------------------------------------------------------------------
// 62. Multiple individual effects: Raise and Log
// ---------------------------------------------------------------------------
test "Test Future with multiple individual effects", using(io : IO), {
  Raise :: (fn(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);

  might_fail_and_log :: (fn(using(raise : Raise, log : Log)) -> i32)({
    log(`about to raise`);
    raise(`multi-effect`)
  });

  task := io.async((using(io : IO))=> {
    (given(raise) : Raise) = ((msg) -> {
