// 62. Multiple individual effects: Raise and Log
// ---------------------------------------------------------------------------
test("Test Future with multiple individual effects", {
  Raise :: (fn(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);
  might_fail_and_log :: (fn(r : Raise, l : Log) -> i32)({
