// Multi-effect Future type tests
// ============================================================================
// ---------------------------------------------------------------------------
// 59. Future(T) — no effects (backward compat)
// ---------------------------------------------------------------------------
test("Test Future no effects backward compat", {
  task := io.async((io : Io) => {
    io.await(yield(io), io);
    i32(42)
  });
  result := io.await(task, io);
  assert(result == i32(42), "Future(i32) should work without effects");
});
// ---------------------------------------------------------------------------
// 60. Future(T, E : Type.Struct) — single row spread (backward compat)
// ---------------------------------------------------------------------------
test("Test Future with single effect row spread", {
  Raise :: (fn(msg : String) -> i32);
  RaiseBundle :: struct(raise : Raise);
  might_fail :: (fn(e : RaiseBundle) -> i32)(
    e.raise(`oops`)
  );
  run :: (
    fn(
      generic(T : Type, E : Type.Struct),
      f : (fn(e : E) -> T),
      e : E
    ) -> T
  )(f(e));
  task := io.async((io : Io) => {
    (raise : Raise) = (
      (msg) -> {
        return(i32(99));
      }
    );
    result := run(might_fail, RaiseBundle(raise : raise));
    io.await(yield(io), io);
    result
  });
  result := io.await(task, io);
  assert(result == i32(99), "Future with effect row spread should work");
});
// ---------------------------------------------------------------------------
// 61. Single individual effect — Raise used directly in async
// ---------------------------------------------------------------------------
test("Test Future with single individual effect", {
