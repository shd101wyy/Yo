// ---------------------------------------------------------------------------
// 68. Await a Future multiple times — should return the same result
// ---------------------------------------------------------------------------
test "Test await future multiple times returns same result", using(io : IO), {
  {
    task := io.async(() => {
      return 42;
    });
    result1 := io.await(task);
    result2 := io.await(task);
    result3 := io.await(task);
    assert((result1 == 42), "first await should return 42");
    assert((result2 == 42), "second await should return 42");
    assert((result3 == 42), "third await should return 42");
  };
  {
    task := io.async(() => {
      return Box(i32)(12);
    });
    result1 := io.await(task);
    result2 := io.await(task);
    assert(result1.* == i32(12), "first await should return Box(i32) with value 12");
    assert(result1.* == result2.*, "multiple awaits should return the same Box(i32) value");
  };
};

// ---------------------------------------------------------------------------
// 69. io.state — query a Future's state without awaiting
// ---------------------------------------------------------------------------
test "Test io.state pending", using(io : IO), {
  // A cold (not yet started) Future should be Pending
  task := io.async((using(io : IO))=> {
    io.await(yield());
    return i32(42);
  });
  s := io.state(task);
  assert((s == FutureState.Pending), "cold future should be Pending");
  io.await(task);
};

test "Test io.state completed", using(io : IO), {
  // After awaiting, the Future should be Completed
  task := io.async((using(io : IO))=> {
    return i32(42);
  });
  io.await(task);
  s := io.state(task);
  assert((s == FutureState.Completed), "awaited future should be Completed");
};

test "Test io.state completed after yield", using(io : IO), {
  // A task with yield points should be Completed after await
  task := io.async((using(io : IO))=> {
    io.await(yield());
    io.await(yield());
    return i32(7);
  });
  io.await(task);
  s := io.state(task);
  assert((s == FutureState.Completed), "future with yields should be Completed after await");
};

test "Test io.state completed after spawn", using(io : IO), {
  // After spawn + await, both tasks should be Completed
  counter := Box(i32)(0);
  task_a := io.async((using(io : IO))=> {
    counter.* = (counter.* + 1);
    io.await(yield());
    counter.* = (counter.* + 1);
  });
  task_b := io.async((using(io : IO))=> {
    assert((counter.* == i32(1)), "task_a should have started and set counter");
  });
  handle_a := io.spawn(task_a);
  handle_b := io.spawn(task_b);
  handle_a.await(using(io));
  handle_b.await(using(io));
  sa := io.state(task_a);
  sb := io.state(task_b);
  assert((sa == FutureState.Completed), "spawned task_a should be Completed");
  assert((sb == FutureState.Completed), "spawned task_b should be Completed");
  assert((counter.* == i32(2)), "counter should be 2 after both tasks complete");
};

test "Test io.state consistency", using(io : IO), {
  // Multiple io.state calls on the same future return consistent results
  task := io.async(() => {
    return i32(99);
  });
  s1 := io.state(task);
  s2 := io.state(task);
  assert((s1 == s2), "multiple state calls should return same result");
  assert((s1 == FutureState.Pending), "cold future should be Pending");
  io.await(task);
  s3 := io.state(task);
  s4 := io.state(task);
  assert((s3 == s4), "multiple state calls after completion should match");
  assert((s3 == FutureState.Completed), "completed future should be Completed");
};

test "Test escape in async closure", using(io : IO), {
  // NOTE: Using forall(T) here due to a C codegen bug where concrete effect
  // types in async closures produce "No C function name found" errors.
  Raise :: (fn(forall(T : Type), msg : String) -> T);

  {
    test_escape :: (fn(task : Impl(Future(i32, IO, Raise)), using(io : IO)) -> unit) {
      (given(raise) : Raise) =
        (msg) -> {
          println(msg);
          escape ();
        };
      io.await(task, using(io, raise));
      assert(false, "expected task to escape already");
    };

    // I expect 'task' to have type Impl(Future(i32, IO, Raise))
    task := io.async((using(io : IO, raise : Raise)) => {
      raise(`This task should be aborted, not awaited!`);
      return i32(12);
    });
    test_escape(task);
    st := io.state(task);
    printf("Future state after starting task: %d\n", st);
    assert(st == FutureState.Aborted);
  };

  {
    test_escape :: (fn(task : Impl(Future(i32, IO, Raise)), using(io : IO)) -> i32) {
      (given(raise) : Raise) =
        (msg) -> {
          println(msg);
          escape 666;
        };
      result := io.await(task, using(io, raise));
      assert(false, "expected task to escape already");
      return result;
    };

    // I expect 'task' to have type Impl(Future(i32, IO, Raise))
    task := io.async((using(io : IO, raise : Raise)) => {
      raise(`This task should be aborted, not awaited!`);
      return i32(12);
    });
    result := test_escape(task);
    st := io.state(task);
    printf("Future state after starting task: %d\n", st);
    assert(st == FutureState.Aborted, "expected task to be aborted");
    assert(result == 666, "expected task to escape with 666");
  };
};

// ============================================================================
// JoinHandle Tests — verify handle := io.spawn(task) + handle.await(using(io))
// ============================================================================

// ---------------------------------------------------------------------------
// JoinHandle.await returns Option(T) — .Some on success, .None on escape
// ---------------------------------------------------------------------------
test "Test JoinHandle await returns Some on success", using(io : IO), {
  task := io.async((using(io : IO))=> {
    io.await(yield());
    return i32(42);
  });

  handle := io.spawn(task);
  result := handle.await(using(io));
  assert(result.is_some(), "successful task should return Some");
  assert((result.unwrap() == i32(42)), "result should be 42");
};

// ---------------------------------------------------------------------------
// JoinHandle.await returns .None when the task escapes (aborts)
// ---------------------------------------------------------------------------
test "Test JoinHandle await returns None on escape", using(io : IO), {
  Raise :: (fn(forall(T : Type), msg : String) -> T);

  task := io.async((using(io : IO, raise : Raise)) => {
    io.await(yield());
    raise(`aborting task`);
    return i32(99);
  });

  (given(raise) : Raise) =
    (msg) -> {
      escape ();
    };
  handle := io.spawn(task, using(io, raise));
  result := handle.await(using(io));
  assert(result.is_none(), "escaped task should return None");
};

// ---------------------------------------------------------------------------
// Two spawned tasks — one escapes, one succeeds. Verify both JoinHandles.
// ---------------------------------------------------------------------------
test "Test JoinHandle two tasks one escapes", using(io : IO), {
  Raise :: (fn(forall(T : Type), msg : String) -> T);

  task1 := io.async((using(io : IO, raise : Raise)) => {
    io.await(yield());
    raise(`task1 escapes`);
    return i32(0);
  });

  task2 := io.async((using(io : IO, raise : Raise)) => {
    io.await(yield());
    return i32(42);
  });

  (given(raise) : Raise) =
    (msg) -> {
      escape ();
    };

  handle1 := io.spawn(task1, using(io, raise));
  handle2 := io.spawn(task2, using(io, raise));

  result1 := handle1.await(using(io));
  result2 := handle2.await(using(io));

  assert(result1.is_none(), "task1 should escape → None");
  assert(result2.is_some(), "task2 should succeed → Some");
  assert((result2.unwrap() == i32(42)), "task2 should return 42");
};

// ============================================================================
// Effect Injection Tests — verify effect handlers are injected at runtime
// via io.spawn/io.await into the future's capture struct.
// ============================================================================

// ---------------------------------------------------------------------------
// Effect injection via io.await (sync future, no await inside closure)
// ---------------------------------------------------------------------------
test "Test effect injection via io.await on sync future", using(io : IO), {
  Log :: (fn(msg : String) -> unit);

  task := io.async((using(io : IO, log : Log))=> {
    log(`effect injected`);
  });

  (given(log1) : Log) =
    (msg) -> {
      printf("Log1: %s\n", msg);
    };
  io.await(task, using(io, log1));
  printf("effect injection via await OK\n");
};

// ---------------------------------------------------------------------------
// Effect injection via io.spawn, then io.await (set-once semantics)
// The first spawn sets the effect handlers; the later await is ignored.
// ---------------------------------------------------------------------------
test "Test effect injection set-once via io.spawn then io.await", using(io : IO), {
  Log :: (fn(msg : String) -> unit);

  task := io.async((using(io : IO, log : Log))=> {
    log(`spawn first`);
  });

  (given(log1) : Log) =
    (msg) -> {
      printf("SpawnLog: %s\n", msg);
    };
  (given(log2) : Log) =
    (msg) -> {
      assert(false, "log2 should not be called (set-once semantics)");
    };

  handle := io.spawn(task, using(io, log1));
  handle.await(using(io));
  printf("set-once via spawn OK\n");
};

// ---------------------------------------------------------------------------
// Effect injection via io.await on async future (SM path, with await inside)
// ---------------------------------------------------------------------------
test "Test effect injection via io.await on SM future", using(io : IO), {
  Log :: (fn(msg : String) -> unit);

  task := io.async((using(io : IO, log : Log))=> {
    log(`before yield`);
    io.await(yield());
    log(`after yield`);
  });

  (given(log1) : Log) =
    (msg) -> {
      printf("SMLog: %s\n", msg);
    };
  io.await(task, using(io, log1));
  printf("effect injection SM path OK\n");
};

// ---------------------------------------------------------------------------
// Break in tagged union (Option) match arm inside async while loop
// Tests that goto-based break in match bodyCode is emitted directly,
// not assigned to a temp variable (Bug 4 in C_CODEGEN_BUGS.md).
// ---------------------------------------------------------------------------
test "Test break in Option match arm in async while loop", using(io : IO), {
  counter := Box(i32)(0);
  sum := Box(i32)(0);

  task := io.async((using(io : IO))=> {
    while runtime(true), {
      counter.* = (counter.* + 1);
      io.await(yield());

      opt := cond(
        (counter.* > i32(5)) => Option(i32).None,
        true => Option(i32).Some(counter.*)
      );

      val := match(opt,
        .Some(v) => v,
        .None => break
      );
      sum.* = (sum.* + val);
    };
  });

  io.await(task);
  assert(counter.* == i32(6), "counter should be 6 when None triggers break");
  assert(sum.* == i32(15), "sum should be 1+2+3+4+5 = 15");
};

// ---------------------------------------------------------------------------
// Continue in tagged union (Option) match arm inside async while loop
// Tests that goto-based continue in match bodyCode is emitted directly.
// ---------------------------------------------------------------------------
test "Test continue in Option match arm in async while loop", using(io : IO), {
  counter := Box(i32)(0);
  sum := Box(i32)(0);

  task := io.async((using(io : IO))=> {
    while runtime(counter.* < i32(6)), {
      counter.* = (counter.* + 1);
      io.await(yield());

      // Skip even numbers via Option match
      opt := cond(
        ((counter.* % i32(2)) == i32(0)) => Option(i32).None,
        true => Option(i32).Some(counter.*)
      );

      val := match(opt,
        .Some(v) => v,
        .None => continue
      );
      sum.* = (sum.* + val);
    };
  });

  io.await(task);
  assert(counter.* == i32(6), "counter should reach 6");
  assert(sum.* == i32(9), "sum should be 1+3+5 = 9 (even numbers skipped)");
};

// ---------------------------------------------------------------------------
// Mixed break and continue in tagged union match arms in async while loop
// Tests both control flow paths through the same match expression.
// ---------------------------------------------------------------------------
test "Test mixed break and continue in Option match in async while loop", using(io : IO), {
  counter := Box(i32)(0);
  sum := Box(i32)(0);

  task := io.async((using(io : IO))=> {
    while runtime(true), {
      counter.* = (counter.* + 1);
      io.await(yield());

      // None means break, Some(0) means continue, Some(v) means accumulate
      opt := cond(
        (counter.* > i32(7)) => Option(i32).None,
        ((counter.* % i32(3)) == i32(0)) => Option(i32).Some(i32(0)),
        true => Option(i32).Some(counter.*)
      );

      val := match(opt,
        .Some(v) => cond((v == i32(0)) => continue, true => v),
        .None => break
      );
      sum.* = (sum.* + val);
    };
  });

  io.await(task);
  assert(counter.* == i32(8), "counter should be 8 when None triggers break");
  // Iterations: 1→Some(1)→sum, 2→Some(2)→sum, 3→Some(0)→continue,
  // 4→Some(4)→sum, 5→Some(5)→sum, 6→Some(0)→continue,
  // 7→Some(7)→sum, 8→None→break
  // sum = 1+2+4+5+7 = 19
  assert(sum.* == i32(19), "sum should be 1+2+4+5+7 = 19");
};