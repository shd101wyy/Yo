// 68. Await a Future multiple times — should return the same result
// ---------------------------------------------------------------------------
test("Test await future multiple times returns same result", {
  {
    task := io.async((io : Io) => {
      return(42);
    });
    result1 := io.await(task, io);
    result2 := io.await(task, io);
    result3 := io.await(task, io);
    assert(result1 == 42, "first await should return 42");
    assert(result2 == 42, "second await should return 42");
    assert(result3 == 42, "third await should return 42");
  };
  {
    task := io.async((io : Io) => {
      return(Box(i32)(12));
    });
    result1 := io.await(task, io);
    result2 := io.await(task, io);
    assert(result1.* == i32(12), "first await should return Box(i32) with value 12");
    assert(result1.* == result2.*, "multiple awaits should return the same Box(i32) value");
  };
});
// ---------------------------------------------------------------------------
// 69. io.state — query a Future's state without awaiting
// ---------------------------------------------------------------------------
test("Test io.state pending", {
  // A cold (not yet started) Future should be Pending
  task := io.async((io : Io) => {
    io.await(yield(io), io);
    return(i32(42));
  });
  s := io.state(task);
  assert(s == FutureState.Pending, "cold future should be Pending");
  io.await(task, io);
});
test("Test io.state completed", {
  // After awaiting, the Future should be Completed
  task := io.async((io : Io) => {
    return(i32(42));
  });
  io.await(task, io);
  s := io.state(task);
  assert(s == FutureState.Completed, "awaited future should be Completed");
});
test("Test io.state completed after yield", {
  // A task with yield points should be Completed after await
  task := io.async((io : Io) => {
    io.await(yield(io), io);
    io.await(yield(io), io);
    return(i32(7));
  });
  io.await(task, io);
  s := io.state(task);
  assert(s == FutureState.Completed, "future with yields should be Completed after await");
});
test("Test io.state completed after spawn", {
  // After spawn + await, both tasks should be Completed
  counter := Box(i32)(0);
  task_a := io.async((io : Io) => {
    counter.* = (counter.* + 1);
    io.await(yield(io), io);
    counter.* = (counter.* + 1);
  });
  task_b := io.async((io : Io) => {
    assert(counter.* == i32(1), "task_a should have started and set counter");
  });
  handle_a := io.spawn(task_a, io);
  handle_b := io.spawn(task_b, io);
  handle_a.await(io);
  handle_b.await(io);
  sa := io.state(task_a);
  sb := io.state(task_b);
  assert(sa == FutureState.Completed, "spawned task_a should be Completed");
  assert(sb == FutureState.Completed, "spawned task_b should be Completed");
  assert(counter.* == i32(2), "counter should be 2 after both tasks complete");
});
test("Test io.state consistency", {
  // Multiple io.state calls on the same future return consistent results
  task := io.async((io : Io) => {
    return(i32(99));
  });
  s1 := io.state(task);
  s2 := io.state(task);
  assert(s1 == s2, "multiple state calls should return same result");
  assert(s1 == FutureState.Pending, "cold future should be Pending");
  io.await(task, io);
  s3 := io.state(task);
  s4 := io.state(task);
  assert(s3 == s4, "multiple state calls after completion should match");
  assert(s3 == FutureState.Completed, "completed future should be Completed");
});
test("Test unwind in async closure", {
  // NOTE: Using generic(T) here due to a C codegen bug where concrete effect
  // types in async closures produce "No C function name found" errors.
  Raise :: (ctl(generic(T : Type), msg : String) -> T);
  Ctx :: struct(io : Io, raise : Raise);
  {
    test_unwind :: (fn(task : Impl(Future(i32, Ctx)), my_io : Io) -> unit)({
      (raise : Raise) =
        (
          (msg) -> {
            println(msg);
            unwind(());
          }
        );
      ctx := Ctx(io : my_io, raise : raise);
      my_io.await(task, ctx);
      assert(false, "expected task to unwind already");
    });
    task := io.async((ctx : Ctx) => {
      ctx.raise(`This task should be aborted, not awaited!`);
      return(i32(12));
    });
    test_unwind(task, io);
    st := io.state(task);
    unsafe(printf("Future state after starting task: %d\n", st));
    assert(st == FutureState.Aborted);
  };
  {
    test_unwind :: (fn(task : Impl(Future(i32, Ctx)), my_io : Io) -> i32)({
      (raise : Raise) =
        (
          (msg) -> {
            println(msg);
            unwind(666);
          }
        );
      ctx := Ctx(io : my_io, raise : raise);
      result := my_io.await(task, ctx);
      assert(false, "expected task to unwind already");
      return(result);
    });
    task := io.async((ctx : Ctx) => {
      ctx.raise(`This task should be aborted, not awaited!`);
      return(i32(12));
    });
    result := test_unwind(task, io);
    st := io.state(task);
    unsafe(printf("Future state after starting task: %d\n", st));
    assert(st == FutureState.Aborted, "expected task to be aborted");
    assert(result == 666, "expected task to unwind with 666");
  };
});
// ============================================================================
// JoinHandle Tests — verify handle := io.spawn(task) + handle.await(io)
// ============================================================================
// ---------------------------------------------------------------------------
// JoinHandle.await returns Option(T) — .Some on success, .None on unwind
// ---------------------------------------------------------------------------
test("Test JoinHandle await returns Some on success", {
  task := io.async((io : Io) => {
    io.await(yield(io), io);
    return(i32(42));
  });
  handle := io.spawn(task, io);
  result := handle.await(io);
  assert(result.is_some(), "successful task should return Some");
  assert(result.unwrap() == i32(42), "result should be 42");
});
// ---------------------------------------------------------------------------
// JoinHandle.await returns .None when the task escapes (aborts)
// ---------------------------------------------------------------------------
test("Test JoinHandle await returns None on unwind", {
  Raise :: (ctl(generic(T : Type), msg : String) -> T);
  Ctx :: struct(io : Io, raise : Raise);
  task := io.async((ctx : Ctx) => {
    ctx.io.await(yield(ctx.io), ctx.io);
    ctx.raise(`aborting task`);
    return(i32(99));
  });
  (raise : Raise) =
    (
      (msg) -> {
        unwind(());
      }
    );
  handle := io.spawn(task, { io, raise });
  result := handle.await(io);
  assert(result.is_none(), "escaped task should return None");
});
// ---------------------------------------------------------------------------
// Two spawned tasks — one escapes, one succeeds. Verify both JoinHandles.
// ---------------------------------------------------------------------------
test("Test JoinHandle two tasks one escapes", {
  Raise :: (ctl(generic(T : Type), msg : String) -> T);
  Ctx :: struct(io : Io, raise : Raise);
  task1 := io.async((ctx : Ctx) => {
    ctx.io.await(yield(ctx.io), ctx.io);
    ctx.raise(`task1 escapes`);
    return(i32(0));
  });
  task2 := io.async((ctx : Ctx) => {
    ctx.io.await(yield(ctx.io), ctx.io);
    return(i32(42));
  });
  (raise : Raise) =
    (
      (msg) -> {
        unwind(());
      }
    );
  handle1 := io.spawn(task1, { io, raise });
  handle2 := io.spawn(task2, { io, raise });
  result1 := handle1.await(io);
  result2 := handle2.await(io);
  assert(result1.is_none(), "task1 should unwind → None");
  assert(result2.is_some(), "task2 should succeed → Some");
  assert(result2.unwrap() == i32(42), "task2 should return 42");
});
// ============================================================================
// Effect Injection Tests — verify effect handlers are injected at runtime
// via io.spawn/io.await into the future's capture struct.
// ============================================================================
// ---------------------------------------------------------------------------
// Effect injection via io.await (sync future, no await inside closure)
// ---------------------------------------------------------------------------
test("Test effect injection via io.await on sync future", {
  Log :: (fn(msg : String) -> unit);
  Ctx :: struct(io : Io, log : Log);
  task := io.async((ctx : Ctx) => {
    ctx.log(`effect injected`);
  });
  (log1 : Log) =
    (
      (msg) -> {
        print("Log1: ");
        println(msg);
      }
    );
  io.await(task, { io, log : log1 });
  unsafe(printf("effect injection via await OK\n"));
});
// ---------------------------------------------------------------------------
// Effect injection via io.spawn, then io.await (set-once semantics)
// The first spawn sets the effect handlers; the later await is ignored.
// ---------------------------------------------------------------------------
test("Test effect injection set-once via io.spawn then io.await", {
  Log :: (fn(msg : String) -> unit);
  Ctx :: struct(io : Io, log : Log);
  task := io.async((ctx : Ctx) => {
    ctx.log(`spawn first`);
  });
  (log1 : Log) =
    (
      (msg) -> {
        print("SpawnLog: ");
        println(msg);
      }
    );
  (log2 : Log) =
    (
      (msg) -> {
        assert(false, "log2 should not be called (set-once semantics)");
      }
    );
  handle := io.spawn(task, { io, log : log1 });
  handle.await(io);
  unsafe(printf("set-once via spawn OK\n"));
});
// ---------------------------------------------------------------------------
// Effect injection via io.await on async future (SM path, with await inside)
// ---------------------------------------------------------------------------
test("Test effect injection via io.await on SM future", {
  Log :: (fn(msg : String) -> unit);
  Ctx :: struct(io : Io, log : Log);
  task := io.async((ctx : Ctx) => {
    ctx.log(`before yield`);
    ctx.io.await(yield(ctx.io), ctx.io);
    ctx.log(`after yield`);
  });
  (log1 : Log) =
    (
      (msg) -> {
        print("SMLog: ");
        println(msg);
      }
    );
  io.await(task, { io, log : log1 });
  unsafe(printf("effect injection SM path OK\n"));
});
// ---------------------------------------------------------------------------
// Break in tagged union (Option) match arm inside async while loop
// Tests that goto-based break in match bodyCode is emitted directly,
// not assigned to a temp variable (Bug 4 in C_CODEGEN_BUGS.md).
// ---------------------------------------------------------------------------
test("Test break in Option match arm in async while loop", {
  counter := Box(i32)(0);
  sum := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(true), {
      counter.* = (counter.* + 1);
      io.await(yield(io), io);
      opt := cond(
        (counter.* > i32(5)) => Option(i32).None,
        true => Option(i32).Some(counter.*)
      );
      val := match(
        opt,
        .Some(v) => v,
        .None => break
      );
      sum.* = (sum.* + val);
    });
  });
  io.await(task, io);
  assert(counter.* == i32(6), "counter should be 6 when None triggers break");
  assert(sum.* == i32(15), "sum should be 1+2+3+4+5 = 15");
});
// ---------------------------------------------------------------------------
// Continue in tagged union (Option) match arm inside async while loop
// Tests that goto-based continue in match bodyCode is emitted directly.
// ---------------------------------------------------------------------------
test("Test continue in Option match arm in async while loop", {
  counter := Box(i32)(0);
  sum := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(counter.* < i32(6)), {
      counter.* = (counter.* + 1);
      io.await(yield(io), io);
      // Skip even numbers via Option match
      opt := cond(
        ((counter.* % i32(2)) == i32(0)) => Option(i32).None,
        true => Option(i32).Some(counter.*)
      );
      val := match(
        opt,
        .Some(v) => v,
        .None => continue
      );
      sum.* = (sum.* + val);
    });
  });
  io.await(task, io);
  assert(counter.* == i32(6), "counter should reach 6");
  assert(sum.* == i32(9), "sum should be 1+3+5 = 9 (even numbers skipped)");
});
// ---------------------------------------------------------------------------
// Mixed break and continue in tagged union match arms in async while loop
// Tests both control flow paths through the same match expression.
// ---------------------------------------------------------------------------
test("Test mixed break and continue in Option match in async while loop", {
  counter := Box(i32)(0);
  sum := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(true), {
      counter.* = (counter.* + 1);
      io.await(yield(io), io);
      // None means break, Some(0) means continue, Some(v) means accumulate
      opt := cond(
        (counter.* > i32(7)) => Option(i32).None,
        ((counter.* % i32(3)) == i32(0)) => Option(i32).Some(i32(0)),
        true => Option(i32).Some(counter.*)
      );
      val := match(
        opt,
        .Some(v) => cond((v == i32(0)) => continue, true => v),
        .None => break
      );
      sum.* = (sum.* + val);
    });
  });
  io.await(task, io);
  assert(counter.* == i32(8), "counter should be 8 when None triggers break");
  // Iterations: 1→Some(1)→sum, 2→Some(2)→sum, 3→Some(0)→continue,
  // 4→Some(4)→sum, 5→Some(5)→sum, 6→Some(0)→continue,
  // 7→Some(7)→sum, 8→None→break
  // sum = 1+2+4+5+7 = 19
  assert(sum.* == i32(19), "sum should be 1+2+4+5+7 = 19");
});
// ===========================================================================
// Async + Algebraic Effects — additional corner-case tests
// ===========================================================================
// ---------------------------------------------------------------------------
// Resume handler (return) inside async closure — handler resumes, execution
// continues past the effect call site inside the async block.
// ---------------------------------------------------------------------------
test("Test effect resume inside async closure", {
  Raise :: (fn(msg : String) -> i32);
  Ctx :: struct(io : Io, raise : Raise);
  task := io.async((ctx : Ctx) => {
    a := ctx.raise(`first`);
    ctx.io.await(yield(ctx.io), ctx.io);
    b := ctx.raise(`second`);
    r := (a + b);
    r
  });
  (raise : Raise) = (
    (msg) -> {
      return(i32(10));
    }
  );
  result := io.await(task, { io, raise });
  assert(result == i32(20), "resume handler should return 10 twice: 10+10=20");
});
// ---------------------------------------------------------------------------
// Effect resume across multiple await points — evidence is preserved in the
// capture struct across state machine yields.
// ---------------------------------------------------------------------------
test("Test effect resume across multiple yields", {
  Raise :: (fn(msg : String) -> i32);
  Ctx :: struct(io : Io, raise : Raise);
  counter := Box(i32)(0);
  task := io.async((ctx : Ctx) => {
    a := ctx.raise(`before yield 1`);
    counter.* = (counter.* + a);
    ctx.io.await(yield(ctx.io), ctx.io);
    b := ctx.raise(`between yields`);
    counter.* = (counter.* + b);
    ctx.io.await(yield(ctx.io), ctx.io);
    c := ctx.raise(`after yield 2`);
    counter.* = (counter.* + c);
    r := counter.*;
    r
  });
  (raise : Raise) = (
    (msg) -> {
      return(i32(5));
    }
  );
  result := io.await(task, { io, raise });
  assert(result == i32(15), "3 resumes of 5 each: 15");
  assert(counter.* == i32(15), "counter should track 5+5+5=15");
});
// ---------------------------------------------------------------------------
// Two different effect types injected simultaneously via io.await.
// Both the Raise and Log handlers are provided via using().
// ---------------------------------------------------------------------------
test("Test two effects injected via io.await", {
  Raise :: (fn(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);
  Ctx :: struct(io : Io, raise : Raise, log : Log);
  task := io.async((ctx : Ctx) => {
    ctx.log(`hello`);
    result := ctx.raise(`fail`);
    ctx.log(`resumed`);
    result
  });
  (raise : Raise) = (
    (msg) -> {
      return(i32(42));
    }
  );
  (log : Log) = (
    (msg) -> {
      unsafe(printf("log: "));
      println(msg);
    }
  );
  result := io.await(task, { io, raise, log });
  assert(result == i32(42), "raise should resume with 42");
});
// ---------------------------------------------------------------------------
// Two different effects injected via io.spawn + JoinHandle.await.
// ---------------------------------------------------------------------------
test("Test two effects injected via io.spawn", {
  Raise :: (fn(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);
  Ctx :: struct(io : Io, raise : Raise, log : Log);
  task := io.async((ctx : Ctx) => {
    ctx.log(`spawned`);
    ctx.io.await(yield(ctx.io), ctx.io);
    result := ctx.raise(`check`);
    ctx.log(`resumed`);
    result
  });
  (raise : Raise) = (
    (msg) -> {
      return(i32(7));
    }
  );
  (log : Log) = (
    (msg) -> {
      unsafe(printf("spawn-log: "));
      println(msg);
    }
  );
  handle := io.spawn(task, { io, raise, log });
  result := handle.await(io);
  assert(result.is_some(), "task should succeed");
  assert(result.unwrap() == i32(7), "raise should resume with 7");
});
// ---------------------------------------------------------------------------
// Effect resume in async while loop — effect is called each iteration,
// handler resumes each time. Validates evidence survives loop iterations.
// ---------------------------------------------------------------------------
test("Test effect resume in async while loop", {
  GetValue :: (fn() -> i32);
  Ctx :: struct(io : Io, get_value : GetValue);
  sum := Box(i32)(0);
  counter := Box(i32)(0);
  task := io.async((ctx : Ctx) => {
    while(runtime(counter.* < i32(4)), {
      v := ctx.get_value();
      sum.* = (sum.* + v);
      counter.* = (counter.* + i32(1));
      ctx.io.await(yield(ctx.io), ctx.io);
    });
    r := sum.*;
    r
  });
  (get_value : GetValue) = (
    () -> {
      return(i32(3));
    }
  );
  result := io.await(task, { io, get_value });
  assert(result == i32(12), "4 iterations * 3 = 12");
});
// ---------------------------------------------------------------------------
// Effect resume in async while loop with break — handler resumes, then
// a subsequent condition triggers break.
// ---------------------------------------------------------------------------
test("Test effect resume in async while loop with break", {
  GetValue :: (fn() -> i32);
  Ctx :: struct(io : Io, get_value : GetValue);
  sum := Box(i32)(0);
  counter := Box(i32)(0);
  task := io.async((ctx : Ctx) => {
    while(runtime(true), {
      counter.* = (counter.* + i32(1));
      v := ctx.get_value();
      ctx.io.await(yield(ctx.io), ctx.io);
      cond(
        (counter.* >= i32(3)) => {
          break;
        },
        true => ()
      );
      sum.* = (sum.* + v);
    });
    r := sum.*;
    r
  });
  (get_value : GetValue) = (
    () -> {
      return(i32(10));
    }
  );
  result := io.await(task, { io, get_value });
  // Iterations: 1→get(10)→yield→sum+=10, 2→get(10)→yield→sum+=10, 3→get(10)→yield→break
  assert(result == i32(20), "2 full iterations * 10 = 20");
});
// ---------------------------------------------------------------------------
// Escape from async task via injected effect — the handler escapes,
// the future is aborted, and the caller sees the unwind.
// ---------------------------------------------------------------------------
test("Test unwind via injected effect aborts future", {
  Raise :: (ctl(generic(T : Type), msg : String) -> T);
  Ctx :: struct(io : Io, raise : Raise);
  test_unwind :: (fn(my_io : Io) -> i32)({
    task := my_io.async((ctx : Ctx) => {
      ctx.io.await(yield(ctx.io), ctx.io);
      ctx.raise(`abort now`);
      return(i32(999));
    });
    (raise : Raise) =
      (
        (msg) -> {
          unwind(i32(77));
        }
      );
    my_io.await(task, { io : my_io, raise });
    // should not reach here
    i32(0)
  });
  unwind_result := test_unwind(io);
  assert(unwind_result == i32(77), "unwind should return 77");
});
// ---------------------------------------------------------------------------
// JoinHandle.await on escaped task returns .None — same as existing test but
// with the effect injected via io.spawn (not io.await).
// ---------------------------------------------------------------------------
test("Test JoinHandle unwind via spawn-injected effect", {
  Raise :: (ctl(generic(T : Type), msg : String) -> T);
  Ctx :: struct(io : Io, raise : Raise);
  task := io.async((ctx : Ctx) => {
    ctx.io.await(yield(ctx.io), ctx.io);
    ctx.raise(`aborting`);
    return(i32(0));
  });
  (raise : Raise) =
    (
      (msg) -> {
        unwind(());
      }
    );
  handle := io.spawn(task, { io, raise });
  result := handle.await(io);
  assert(result.is_none(), "escaped task should return None");
});
// ---------------------------------------------------------------------------
// Effect handler inside async closure resolved by given binding (not injected).
// The handler is installed inside the async block itself — no injection needed.
// Validates internal given works correctly inside async SM.
// ---------------------------------------------------------------------------
test("Test given handler inside async closure with yields", {
  Raise :: (fn(msg : String) -> i32);
  task := io.async((io : Io) => {
    (raise : Raise) = (
      (msg) -> {
        return(i32(50));
      }
    );
    might_fail :: (fn(x : i32, r : Raise) -> i32)(
      cond(
        (x < i32(0)) => r(`negative`),
        true => x
      )
    );
    a := might_fail(i32(5), raise);
    io.await(yield(io), io);
    b := might_fail(i32(-(1)), raise);
    io.await(yield(io), io);
    c := might_fail(i32(3), raise);
    r := ((a + b) + c);
    r
  });
  result := io.await(task, io);
  assert(result == i32(58), "5 + 50 + 3 = 58");
});
// ===========================================================================
// Regression tests for specific bug fixes
// ===========================================================================
// ---------------------------------------------------------------------------
// Bug fix: async SM result type was void* when body returned a binary
// expression (e.g., (a + b)). The SomeType resolution chain wasn't followed
// when the closure body type was itself a SomeType with a resolvedConcreteType.
// ---------------------------------------------------------------------------
test("Regression: async SM result type for binary expression return", {
  task := io.async((io : Io) => {
    a := i32(10);
    io.await(yield(io), io);
    b := i32(5);
    (a + b) * i32(3)
  });
  result := io.await(task, io);
  assert(result == i32(45), "async binary expr result should be 45");
});
// ---------------------------------------------------------------------------
// Bug fix: 3-argument while(cond, step, body) form was not supported in
// async state machines. The step expression was ignored when the while loop
// contained an await point.
// ---------------------------------------------------------------------------
test("Regression: 3-arg while loop in async SM with step expression", {
  task := io.async((io : Io) => {
    sum := i32(0);
    i := i32(0);
    while(i < i32(5), i = (i + i32(1)), {
      io.await(yield(io), io);
      sum = (sum + i);
    });
    sum
  });
  result := io.await(task, io);
  assert(result == i32(10), "while 3-arg in async: 0+1+2+3+4=10");
});
// ---------------------------------------------------------------------------
// Bug fix: async unwind caused use-after-free due to double RC decrement.
// The SM self-decrements on unwind (event loop ref), and the synchronous
// await abort path was also decrementing. The caller's reference was freed
// prematurely, causing UAF when accessing the future after the function
// returned.
// ---------------------------------------------------------------------------
test("Regression: async unwind RC no double-decrement UAF", {
  // This test verifies that a full async SM that escapes doesn't cause a
  // use-after-free when the caller accesses the future after the await.
  // Before the fix, the synchronous await abort path decremented the RC
  // again after the SM already self-decremented, causing a double-free.
  Raise :: (ctl(generic(T : Type), msg : String) -> T);
  Ctx :: struct(io : Io, raise : Raise);
  test_and_check :: (fn(my_io : Io) -> i32)({
    task := my_io.async((ctx : Ctx) => {
      ctx.io.await(yield(ctx.io), ctx.io);
      ctx.raise(`abort now`);
      return(i32(999));
    });
    (raise : Raise) =
      (
        (msg) -> {
          unwind(i32(77));
        }
      );
    result := my_io.await(task, { io : my_io, raise });
    // If we reach here, the unwind didn't work
    result
  });
  unwind_result := test_and_check(io);
  assert(unwind_result == i32(77), "unwind should return 77");
});
// ---------------------------------------------------------------------------
// SM Optimization: Segment-local variables should be C locals, not struct fields
// ---------------------------------------------------------------------------
test("SM opt: segment-local i32 vars are not in struct", {
  // Variables b, d, e are each used in only one segment.
  // The optimization should keep them as C locals.
  task := io.async((io : Io) => {
    a := i32(10);
    b := i32(20);
    sum0 := (a + b);
    io.await(yield(io), io);
    c := i32(30);
    d := i32(40);
    sum1 := ((a + c) + d);
    io.await(yield(io), io);
    e := i32(50);
    result := ((sum1 + e) - sum0);
    return(result);
  });
  r := io.await(task, io);
  // sum0 = 30, sum1 = 10+30+40 = 80, result = 80+50-30 = 100
  assert(r == i32(100), "segment-local optimization result should be 100");
});
test("SM opt: RC-typed segment-local variables", {
  // Box values used in only one segment should be properly allocated and freed
  // even when they are C locals rather than struct fields.
  task := io.async((io : Io) => {
    a := Box(i32)(1);
    io.await(yield(io), io);
    b := Box(i32)(2);
    c := Box(i32)(3);
    sum := (b.* + c.*);
    io.await(yield(io), io);
    d := Box(i32)(4);
    result := ((a.* + sum) + d.*);
    return(result);
  });
  r := io.await(task, io);
  // a=1 crosses, b=2 local, c=3 local, sum=5 crosses, d=4 local
  // result = 1 + 5 + 4 = 10
  assert(r == i32(10), "RC segment-local vars should work correctly");
});
test("SM opt: String segment-local variables", {
  // String values used in only one segment should work correctly.
  task := io.async((io : Io) => {
    s1 := `hello`;
    io.await(yield(io), io);
    s2 := `world`;
    combined := `${s1} ${s2}`;
    io.await(yield(io), io);
    return(combined);
  });
  r := io.await(task, io);
  assert(r == `hello world`, "String segment-local should work");
});
test("SM opt: multiple awaits with cross-boundary and local vars", {
  // A more complex pattern: some vars cross many boundaries, others are local.
  task := io.async((io : Io) => {
    // Segment 0: define persistent var and local-only var
    persistent := i32(100);
    local0 := i32(1);
    check0 := (persistent + local0);
    io.await(yield(io), io);
    // Segment 1: define another local, use persistent
    local1 := i32(2);
    check1 := (persistent + local1);
    io.await(yield(io), io);
    // Segment 2: define another local, use persistent
    local2 := i32(3);
    check2 := (persistent + local2);
    io.await(yield(io), io);
    // Segment 3: use all checks — checks cross boundaries since used here
    return((check0 + check1) + check2);
  });
  r := io.await(task, io);
  // check0=101, check1=102, check2=103 → 101+102+103 = 306
  assert(r == i32(306), "multi-segment cross-boundary should be 306");
});
test("SM opt: no await points means no struct fields needed", {
  // A sync_fut_t (no await points) — all variables should be stack locals.
  task := io.async((io : Io) => {
    a := i32(1);
    b := i32(2);
    c := i32(3);
    return((a + b) + c);
  });
  r := io.await(task, io);
  assert(r == i32(6), "no-await sync_fut_t should work with all locals");
});
test("SM opt: variable reassignment across await", {
  // Variable mutated (reassigned) across an await boundary.
  task := io.async((io : Io) => {
    x := i32(1);
    io.await(yield(io), io);
    x = (x + i32(10));
    io.await(yield(io), io);
    x = (x + i32(100));
    return(x);
  });
  r := io.await(task, io);
  assert(r == i32(111), "reassignment across await should be 111");
});
test("SM opt: cond with segment-local vars and no await in branches", {
  // Cond without await in branches — the optimization should still apply
  // to variables local to each segment.
  task := io.async((io : Io) => {
    flag := true;
    io.await(yield(io), io);
    local_val := cond(
      flag => i32(42),
      true => i32(0)
    );
    io.await(yield(io), io);
    return(local_val);
  });
  r := io.await(task, io);
  assert(r == i32(42), "cond without await should work with segment-local");
});
// ---------------------------------------------------------------------------
// SM Optimization: Phase 2b — cond/while with await, non-branching segments
// Variables in segments WITHOUT branching awaits should still be C locals,
// even when OTHER segments have branching awaits (cond/while).
// ---------------------------------------------------------------------------
test("SM opt: cond-with-await, non-branching segment locals", {
  // local_before is used only in segment 0 (before the first await).
  // Even though segment 1 has a cond-with-await, local_before should be a C local.
  task := io.async((io : Io) => {
    cross := i32(100);
    local_before := i32(7);
    sum0 := (cross + local_before);
    io.await(yield(io), io);
    cond(
      true => {
        io.await(yield(io), io);
      },
      true => ()
    );
    local_after := i32(9);
    return((cross + sum0) + local_after);
  });
  r := io.await(task, io);
  // sum0 = 107, result = 100 + 107 + 9 = 216
  assert(r == i32(216), "non-branching segment locals with cond-with-await should be 216");
});
test("SM opt: while-with-await, non-branching segment locals", {
  // Variables in segments before/after the while should be C locals if only
  // used in that segment.
  task := io.async((io : Io) => {
    persistent := i32(0);
    local_init := i32(5);
    persistent = (persistent + local_init);
    io.await(yield(io), io);
    i := i32(0);
    while(i < i32(3), {
      io.await(yield(io), io);
      persistent = (persistent + i32(1));
      i = (i + i32(1));
    });
    local_end := i32(10);
    return(persistent + local_end);
  });
  r := io.await(task, io);
  // persistent starts at 5, loop adds 3 → 8, then + 10 = 18
  assert(r == i32(18), "while-with-await non-branching locals should be 18");
});
test("SM opt: cond-with-await, cross-boundary vars still work", {
  // Variables that cross the cond-await boundary must still be in the struct.
  task := io.async((io : Io) => {
    a := i32(10);
    b := i32(20);
    io.await(yield(io), io);
    c := i32(30);
    cond(
      true => {
        io.await(yield(io), io);
        a = ((a + b) + c);
      },
      true => ()
    );
    return(a);
  });
  r := io.await(task, io);
  // a=10, b=20, c=30 → 10+20+30 = 60
  assert(r == i32(60), "cond-with-await cross-boundary should be 60");
});
test("SM opt: nested cond-with-await, outer segment locals", {
  // Multiple cond-with-await branches; variables only used outside cond are locals.
  task := io.async((io : Io) => {
    total := i32(0);
    local_setup := i32(100);
    total = (total + local_setup);
    io.await(yield(io), io);
    cond(
      true => {
        io.await(yield(io), io);
        total = (total + i32(1));
      },
      true => ()
    );
    return(total);
  });
  r := io.await(task, io);
  // total = 0 + 100 + 1 = 101
  assert(r == i32(101), "nested cond-with-await outer locals should be 101");
});
test("SM opt: temp future vars aliased to await_future fields", {
  // Phase 1b: io.await(yield(io), io) creates a temp var that should be aliased
  // to the corresponding await_future_N field, not stored as a separate
  // struct field. This test verifies correctness with multiple temp futures.
  task := io.async((io : Io) => {
    x := i32(10);
    io.await(yield(io), io);
    y := i32(20);
    io.await(yield(io), io);
    z := i32(30);
    io.await(yield(io), io);
    return((x + y) + z);
  });
  r := io.await(task, io);
  assert(r == i32(60), "temp future aliasing should compute 60");
});
test("SM opt: overlapping storage for non-RC value types", {
  // Phase 2: Variables a and c have non-overlapping live ranges
  // (a: segments {0,1}, c: segments {2,3}) so they can share a slot.
  // b overlaps with both, so it keeps its own field.
  task := io.async((io : Io) => {
    a := i32(10);
    io.await(yield(io), io);
    b := (a + i32(5));
    io.await(yield(io), io);
    c := i32(20);
    io.await(yield(io), io);
    return(b + c);
  });
  r := io.await(task, io);
  assert(r == i32(35), "overlapping storage should compute 35");
});
test("SM opt: overlapping vars must conflict when ranges overlap", {
  // a: segments {0,2}, range [0,2]; b: segments {1,2}, range [1,2]
  // Ranges overlap at segment 2 — no sharing possible.
  task := io.async((io : Io) => {
    a := i32(10);
    io.await(yield(io), io);
    b := i32(20);
    io.await(yield(io), io);
    return(a + b);
  });
  r := io.await(task, io);
  assert(r == i32(30), "conflicting vars should compute 30");
});
test("SM opt: multiple non-overlapping pairs share slots", {
  // a and c don't overlap, b and d don't overlap.
  // a: range [0,0], b: range [0,0], c: range [2,2], d: range [2,2]
  // But a and b are in same segment — they conflict!
  // So a,c share (both i32, non-overlapping) and b,d share.
  task := io.async((io : Io) => {
    a := i32(1);
    b := i32(2);
    sum1 := (a + b);
    io.await(yield(io), io);
    io.await(yield(io), io);
    c := i32(3);
    d := i32(4);
    sum2 := (c + d);
    return(sum1 + sum2);
  });
  r := io.await(task, io);
  assert(r == i32(10), "multiple pairs should compute 10");
});
test("SM opt: RC types excluded from overlapping storage", {
  // String is RC-typed. Even if s1 and s2 have non-overlapping reference
  // ranges, they must NOT share a slot (RC deferred drops extend lifetime).
  task := io.async((io : Io) => {
    s1 := `hello`;
    io.await(yield(io), io);
    n1 := s1.len();
    io.await(yield(io), io);
    s2 := `world`;
    io.await(yield(io), io);
    n2 := s2.len();
    return(n1 + n2);
  });
  r := io.await(task, io);
  assert(r == usize(10), "RC types excluded from sharing, lengths should sum to 10");
});
// Regression: multiple io.await calls in a single while loop body
// Previously, the second await generated `int32_t temp = ;` (empty expression)
// because the state machine only handled the first await and passed remaining
// expressions through generateExpr which can't handle io.await in SM context.
test("Regression: multiple awaits in while loop body", {
  task := io.async((io : Io) => {
    counter := i32(0);
    while(runtime(counter < i32(3)), {
      // First await in while body
      io.await(yield(io), io);
      // Second await in while body
      io.await(yield(io), io);
      counter = (counter + i32(1));
    });
    return(counter);
  });
  r := io.await(task, io);
  assert(r == i32(3), "multiple awaits in while should iterate 3 times");
});
test("Regression: two awaits in while loop with result values", {
  task := io.async((io : Io) => {
    sum := i32(0);
    i := i32(0);
    while(runtime(i < i32(4)), {
      a := io.await(
        io.async((io : Io) => {
          return(i + i32(1));
        }),
        io
      );
      b := io.await(
        io.async((io : Io) => {
          return(a * i32(2));
        }),
        io
      );
      sum = (sum + b);
      i = (i + i32(1));
    });
    return(sum);
  });
  r := io.await(task, io);
  assert(r == i32(20), "two awaits in while with values should sum to 20");
});
test("Regression: three awaits in while loop body", {
  task := io.async((io : Io) => {
    counter := i32(0);
    while(runtime(counter < i32(2)), {
      io.await(yield(io), io);
      io.await(yield(io), io);
      io.await(yield(io), io);
      counter = (counter + i32(1));
    });
    return(counter);
  });
  r := io.await(task, io);
  assert(r == i32(2), "three awaits in while should iterate 2 times");
});
// ---------------------------------------------------------------------------
// Regression: cond-with-await inside while loop body
// Pattern: while { io.await(X, io); cond(flag => io.await(Y, io), true => ()) }
// The cond branch containing await must properly set up the future and
// skip the await when the non-await branch is taken.
// ---------------------------------------------------------------------------
test("Regression: cond with await in while loop body", {
  task := io.async((io : Io) => {
    counter := i32(0);
    done := false;
    while(runtime(!(done)), {
      io.await(yield(io), io);
      counter = (counter + i32(1));
      cond(
        (counter >= i32(3)) => {
          done = true;
        },
        true => ()
      );
      cond(
        !(done) => {
          io.await(yield(io), io);
        },
        true => ()
      );
    });
    return(counter);
  });
  r := io.await(task, io);
  assert(r == i32(3), "cond-with-await in while should count to 3");
});
test("Regression: cond with await in while - both branches exercised", {
  task := io.async((io : Io) => {
    sum := i32(0);
    i := i32(0);
    while(runtime(i < i32(4)), {
      val := io.await(
        io.async((io : Io) => {
          return(i + i32(1));
        }),
        io
      );
      cond(
        ((val % i32(2)) == i32(0)) => {
          extra := io.await(
            io.async((io : Io) => {
              return(i32(10));
            }),
            io
          );
          sum = (sum + extra);
        },
        true => {
          sum = (sum + val);
        }
      );
      i = (i + i32(1));
    });
    return(sum);
  });
  r := io.await(task, io);
  // i=0: val=1 (odd) -> sum += 1 = 1
  // i=1: val=2 (even) -> sum += 10 = 11
  // i=2: val=3 (odd) -> sum += 3 = 14
  // i=3: val=4 (even) -> sum += 10 = 24
  assert(r == i32(24), "cond branches with/without await should compute 24");
});
test("Regression: recv-then-cond-send pattern (HTTP server style)", {
  task := io.async((io : Io) => {
    responses := i32(0);
    done := false;
    while(runtime(!(done)), {
      // Simulate recv
      n := io.await(
        io.async((io : Io) => {
          return(
            cond(
              (responses < i32(3)) => i32(100),
              true => i32(0)
            )
          );
        }),
        io
      );
      cond(
        (n <= i32(0)) => {
          done = true;
        },
        true => ()
      );
      cond(
        !(done) => {
          // Simulate send
          io.await(
            io.async((io : Io) => {
              return(i32(1));
            }),
            io
          );
          responses = (responses + i32(1));
        },
        true => ()
      );
    });
    return(responses);
  });
  r := io.await(task, io);
  assert(r == i32(3), "recv-then-cond-send should handle 3 responses");
});
// ---------------------------------------------------------------------------
// Conditional branches containing an await, inside io.async.
//
// `cond` is the supported spelling — its branch structure is what the state
// machine splits on. `if` is a MACRO over `cond`, and the splitter never
// followed `$.macroExpansion`, so an await under an `if` got no state
// transition at all: in condition position that compiled at rc=0 and produced
// a SEGFAULTING binary (`yo-self init` shipped that way); in body position it
// produced C that did not compile. Both shapes are now rejected at compile
// time — see src/tests/async-await-position-gate.test.ts.
// ---------------------------------------------------------------------------
test("Test await inside a cond branch", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    cond(
      runtime(true) => {
        v := io.await(future_with_returned_state(i32(41), io), io);
        acc.* = v;
      },
      true => ()
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(42), "await inside a taken cond branch should run and bind");
});
test("Test await inside a cond branch that is not taken", {
  task := io.async((io : Io) => {
    acc := Box(i32)(7);
    cond(
      runtime(false) => {
        v := io.await(future_with_returned_state(i32(41), io), io);
        acc.* = v;
      },
      true => ()
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(7), "an untaken cond branch must not run its await");
});
test("Test await inside both cond branches", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    cond(
      runtime(false) => {
        v := io.await(future_with_returned_state(i32(10), io), io);
        acc.* = v;
      },
      true => {
        v := io.await(future_with_returned_state(i32(20), io), io);
        acc.* = v;
      }
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(21), "the fallback branch's await should be the one that runs");
});
test("Test hoisted await used as a cond condition", {
  // The supported spelling of `cond(io.await(...) => ...)`: bind first, branch
  // second. This is what yo-self/init.yo now does.
  task := io.async((io : Io) => {
    v := io.await(future_with_returned_state(i32(41), io), io);
    acc := Box(i32)(0);
    cond(
      (v == i32(42)) => {
        acc.* = i32(1);
      },
      true => ()
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(1), "hoisting the await out of the condition should work");
});
test("Test statement after a cond branch that awaits", {
  // Regression: the state AFTER the branch must still run — the original bug
  // dropped the branch body and jumped straight past it.
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    cond(
      runtime(true) => {
        v := io.await(future_with_returned_state(i32(9), io), io);
        acc.* = v;
      },
      true => ()
    );
    acc.* = (acc.* + i32(100));
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(110), "code after the cond must still execute");
});
test("Test await inside an if body", {
  // `if` is a MACRO over `cond`; the splitter has to follow its expansion to
  // see the branch at all. The self-hosted compiler always did; the reference
  // compiler did not, and emitted C that would not compile.
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    if(runtime(true), {
      v := io.await(future_with_returned_state(i32(41), io), io);
      acc.* = v;
    });
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(42), "await inside an if body should run and bind");
});
test("Test await inside both if and else bodies", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    if(runtime(false), {
      v := io.await(future_with_returned_state(i32(10), io), io);
      acc.* = v;
    }, {
      v := io.await(future_with_returned_state(i32(20), io), io);
      acc.* = v;
    });
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(21), "the else body's await should be the one that runs");
});
test("Test statement after an if whose body awaits", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    if(runtime(true), {
      v := io.await(future_with_returned_state(i32(9), io), io);
      acc.* = v;
    });
    acc.* = (acc.* + i32(100));
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(110), "code after the if must still execute");
});
// ---------------------------------------------------------------------------
// `io.await` in a branch CONDITION / `match` SCRUTINEE, inside io.async.
//
// These are evaluated before any branch is chosen, so the await cannot END a
// state the way a branch-body await does. Codegen hoists it across the state
// boundary instead: the state that reaches the expression stores only the
// future, and the next state re-runs the expression with the await standing
// for `sm->await_result_N`. It is a real suspension — a task spawned first
// still interleaves — not a blocking wait.
// ---------------------------------------------------------------------------
test("Test await directly as an if condition", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    if(io.await(future_bool(true, io), io), {
      acc.* = i32(42);
    });
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(42), "await as an if condition should drive the branch");
});
test("Test await as a cond condition, true branch", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    cond(
      io.await(future_bool(true, io), io) => {
        acc.* = i32(1);
      },
      true => {
        acc.* = i32(2);
      }
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(1), "the awaited condition was true, so branch 1 runs");
});
test("Test await as a cond condition, false branch", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    cond(
      io.await(future_bool(false, io), io) => {
        acc.* = i32(1);
      },
      true => {
        acc.* = i32(2);
      }
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(2), "the awaited condition was false, so the fallback runs");
});
test("Test await as a match scrutinee", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    match(
      io.await(future_with_returned_state(i32(41), io), io),
      42 => {
        acc.* = i32(100);
      },
      _ => {
        acc.* = i32(200);
      }
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(100), "the awaited scrutinee should select the 42 arm");
});
test("Test code after an if whose condition awaits", {
  task := io.async((io : Io) => {
    acc := Box(i32)(0);
    if(io.await(future_bool(true, io), io), {
      acc.* = i32(5);
    });
    acc.* = (acc.* + i32(100));
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(105), "code after the if must still execute");
});
test("Test awaited condition really suspends (spawned task interleaves)", {
  order := Box(i32)(0);
  task := io.async((io : Io) => {
    noise := io.async((io : Io) => {
      // Runs only if the awaiting task actually yielded the loop.
      order.* = (order.* + i32(1));
      return(i32(0));
    });
    h := io.spawn(noise, io);
    if(io.await(future_bool(true, io), io), {
      // If the await had blocked instead of suspending, the spawned task
      // would not have run yet and order.* would still be 0.
      order.* = (order.* + i32(10));
    });
    _r := h.await(io);
    return(order.*);
  });
  r := io.await(task, io);
  assert(r == i32(11), "spawned task must run during the awaited condition");
});
// ---------------------------------------------------------------------------
// `io.await` in a `while` CONDITION and in the 3-arg form's STEP.
//
// A body await splits the loop into "before" and "after" halves. A condition
// await cannot be split that way — the condition is re-evaluated every
// iteration — so the whole loop cycles through one state: the state stores the
// condition's future and suspends; the next state tests the result, runs the
// body and step, and jumps back to re-store it.
//
// A step await needs no new layout: the step runs after the body each
// iteration, so it splits the loop exactly where a trailing body await would.
// ---------------------------------------------------------------------------
test("Test await as a while condition", {
  task := io.async((io : Io) => {
    n := Box(i32)(0);
    while(io.await(future_lt(n.*, i32(3), io), io), {
      n.* = (n.* + i32(1));
    });
    return(n.*);
  });
  r := io.await(task, io);
  assert(r == i32(3), "awaited while condition should drive 3 iterations");
});
test("Test await as a while condition that is false immediately", {
  task := io.async((io : Io) => {
    n := Box(i32)(0);
    while(io.await(future_lt(i32(9), i32(3), io), io), {
      n.* = (n.* + i32(1));
    });
    return(n.*);
  });
  r := io.await(task, io);
  assert(r == i32(0), "a false awaited condition must not run the body");
});
test("Test await as a while condition with a step expression", {
  task := io.async((io : Io) => {
    n := Box(i32)(0);
    sum := Box(i32)(0);
    while(io.await(future_lt(n.*, i32(3), io), io), {
      n.* = (n.* + i32(1));
    }, {
      sum.* = (sum.* + n.*);
    });
    return(sum.*);
  });
  r := io.await(task, io);
  assert(r == i32(3), "body 0,1,2 summed after each step: 0+1+2 = 3");
});
test("Test await in a while step expression", {
  task := io.async((io : Io) => {
    n := Box(i32)(0);
    sum := Box(i32)(0);
    while(n.* < i32(3), {
      _x := io.await(future_with_returned_state(i32(1), io), io);
      n.* = (n.* + i32(1));
    }, {
      sum.* = (sum.* + n.*);
    });
    (n.* * i32(10)) + sum.*
  });
  r := io.await(task, io);
  assert(r == i32(33), "n=3 and sum=0+1+2=3 with the await in the step");
});
test("Test await in a while step matches the non-await control", {
  // Same loop without the await — the await must not change the result.
  task := io.async((io : Io) => {
    n := Box(i32)(0);
    sum := Box(i32)(0);
    while(n.* < i32(3), {
      n.* = (n.* + i32(1));
    }, {
      sum.* = (sum.* + n.*);
    });
    (n.* * i32(10)) + sum.*
  });
  r := io.await(task, io);
  assert(r == i32(33), "control: the awaited-step loop must agree with this");
});
// ---------------------------------------------------------------------------
// `match` ARM containing an await.
//
// The self-hosted compiler silently DROPPED the whole match: its
// `generate_match_with_await` looked the enum's C name up by the enum's `id`
// (faithful to TS, whose registry is id-keyed), but yo-self's registry is keyed
// by `type_key`, so every generic enum instance missed and the match was
// emitted as a C comment. rc=0, no diagnostic, the arm never ran — nothing in
// the corpus covered it, so the hollow sweep stayed green.
// ---------------------------------------------------------------------------
test("Test await inside a match arm", {
  task := io.async((io : Io) => {
    m := Option(i32).Some(i32(1));
    acc := Box(i32)(0);
    match(
      m,
      .Some(x) => {
        v := io.await(future_with_returned_state(i32(41), io), io);
        acc.* = (v + x);
      },
      .None => ()
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(43), "the matched arm must run its await and its body");
});
test("Test await inside a match arm that is not selected", {
  task := io.async((io : Io) => {
    m := Option(i32).None;
    acc := Box(i32)(7);
    match(
      m,
      .Some(x) => {
        v := io.await(future_with_returned_state(i32(41), io), io);
        acc.* = (v + x);
      },
      .None => ()
    );
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(7), "an unselected arm must not run its await");
});
test("Test statement after a match arm that awaits", {
  task := io.async((io : Io) => {
    m := Option(i32).Some(i32(1));
    acc := Box(i32)(0);
    match(
      m,
      .Some(_x) => {
        v := io.await(future_with_returned_state(i32(41), io), io);
        acc.* = v;
      },
      .None => ()
    );
    acc.* = (acc.* + i32(100));
    return(acc.*);
  });
  r := io.await(task, io);
  assert(r == i32(142), "code after the match must still execute");
});
// ---------------------------------------------------------------------------
// `return(<compound expression>)` as an async closure's FINAL expression.
//
// yo-self's return codegen yields a COMPLETE `return X` statement (and emits
// the scope-end drops itself), where TS yields the value temp and lets the
// caller emit the return. Feeding that statement into the tail materialization
// produced `int32_t __yo_scope_ret = return X;` — invalid C. A SIMPLE
// `return(n.*)` was fine, which is why this hid: it only shows when the
// materialization kicks in.
// ---------------------------------------------------------------------------
test("Test return of a compound expression as the final expression", {
  task := io.async((io : Io) => {
    n := Box(i32)(3);
    return((n.* * i32(10)) + n.*)
  });
  r := io.await(task, io);
  assert(r == i32(33), "a compound return in tail position must compile");
});
// ---------------------------------------------------------------------------
// An await whose result is never read.
//
// The state machine struct only gets a field for variables that cross a state
// boundary, and a target nothing ever reads does not. The extraction wrote to
// `sm-><field>` regardless, so the C referenced a member that was never
// declared: `error: no member named 'var_..._v'`. Reading the value anywhere
// hid it — which is why every existing test passed.
// ---------------------------------------------------------------------------
test("Test await whose result is never read", {
  task := io.async((io : Io) => {
    n := Box(i32)(3);
    _v := io.await(future_with_returned_state(i32(1), io), io);
    return(n.*);
  });
  r := io.await(task, io);
  assert(r == i32(3), "an unread await result must not break the SM struct");
});
test("Test await whose result is never read, with a compound tail", {
  task := io.async((io : Io) => {
    n := Box(i32)(3);
    _v := io.await(future_with_returned_state(i32(1), io), io);
    return((n.* * i32(10)) + n.*)
  });
  r := io.await(task, io);
  assert(r == i32(33), "same, with the tail materialization in play");
});
test("Test await whose result IS read (control)", {
  task := io.async((io : Io) => {
    n := Box(i32)(3);
    v := io.await(future_with_returned_state(i32(1), io), io);
    return((n.* * i32(10)) + v);
  });
  r := io.await(task, io);
  assert(r == i32(32), "control: reading the result keeps the field");
});
// ---------------------------------------------------------------------------
// An `io.async` closure that captures a mutable local, re-created every
// iteration of a loop.
//
// The state machine's dispose drops the capture's RC-bearing fields, but
// nothing retained them: TS balances that by dupping the whole capture struct
// through its synthesized `___dup`, and yo-self synthesizes no such helper (it
// emits ZERO per-type `___dup` where TS emits 124) while its deferred-dup path
// is deliberately skipped inside a state machine. So each iteration dropped a
// reference nobody took, and the captured Box was freed under the loop —
// rc=139 in the self-hosted compiler, correct output in the reference one.
// ---------------------------------------------------------------------------
test("Test io.async closure capturing a local, re-created each iteration", {
  task := io.async((io : Io) => {
    n := Box(i32)(0);
    while(io.await(
      io.async((io2 : Io) => {
        io2.await(yield(io2), io2);
        return(n.* < i32(3));
      }),
      io
    ), {
      n.* = (n.* + i32(1));
    });
    return(n.*);
  });
  r := io.await(task, io);
  assert(r == i32(3), "the captured Box must survive every iteration");
});
test("Test two io.async closures capturing the same local", {
  // An inline `io.async(...)` produces two temps that can share a generated
  // name — the closure's CAPTURE STRUCT and the future. Only the future lives
  // in `await_future_N`; aliasing the capture struct instead made its deferred
  // drop run against that field, emitting a drop of a struct BY VALUE applied
  // to a state machine POINTER, which is not legal C. Two inline closures over
  // one local in a single state machine is what exposed it.
  task := io.async((io : Io) => {
    n := Box(i32)(5);
    a := io.await(
      io.async((io2 : Io) => {
        io2.await(yield(io2), io2);
        return(n.*);
      }),
      io
    );
    b := io.await(
      io.async((io2 : Io) => {
        io2.await(yield(io2), io2);
        return(n.* * i32(2));
      }),
      io
    );
    return(a + b);
  });
  r := io.await(task, io);
  assert(r == i32(15), "5 + 10 — the capture is still live for the second");
});
// ---------------------------------------------------------------------------
// `return(<local>)` from an async body that ALSO awaits later.
//
// The later await forces a multi-state machine, so the local is hoisted into
// the state struct. The return's completion path emitted the SOURCE name
// (`sm->result = results;`) instead of the hoisted field, and `results` is not
// a C identifier in that scope — invalid C. Without a later await there is a
// single state and nothing is hoisted, which is why it stayed hidden until
// `build`/`fetch`/`install` were wired to a subcommand.
// ---------------------------------------------------------------------------
test("Test return of a hoisted local from an async body that awaits later", {
  task := io.async((io : Io) => {
    total := Box(i32)(7);
    if(total.* == i32(7), {
      return(total.*);
    });
    io.await(yield(io), io);
    return(i32(0));
  });
  r := io.await(task, io);
  assert(r == i32(7), "the early return must read the hoisted local");
});
// ---------------------------------------------------------------------------
// An OUTER `match` whose arms each contain an INNER `match` with an await.
//
// Every cond/match that awaits under one await point shares ONE resume
// `switch`, and each numbered its own arms from 0 — so sibling and nested
// matches emitted `case 0:`/`case 1:` several times over and C rejected the
// function ("duplicate case value"). Dispatch codes are now unique per arm
// per function.
//
// The scrutinee here is also a PAYLOAD-FREE enum, which lowers to a plain C
// enum with no `tag` member; the async match generator emitted `x.tag` on it
// unconditionally while `codegen/exprs/match.ts` had always special-cased it.
// ---------------------------------------------------------------------------
Pick :: enum(First, Second, Neither);
test("Test await inside nested match arms under a payload-free scrutinee", {
  // The parameter is `rio`, not `io`: the test runner batches every test body
  // into one file that binds `io :: __yo_builtin_io` at top level, and Yo
  // forbids shadowing it.
  run := (fn(p : Pick, rio : Io) -> Impl(Future(i32, Io)))(
    rio.async((aio : Io) => {
      out := Box(i32)(0);
      match(
        p,
        .First => {
          match(
            Option(i32).Some(i32(10)),
            .None => (),
            .Some(v) => {
              aio.await(yield(aio), aio);
              out.* = (out.* + v);
            }
          );
        },
        .Second => {
          match(
            Option(i32).Some(i32(20)),
            .None => (),
            .Some(v) => {
              aio.await(yield(aio), aio);
              out.* = (out.* + v);
            }
          );
        },
        .Neither => ()
      );
      return(out.*);
    })
  );
  assert(io.await(run(Pick.First, io), io) == i32(10), "first arm resumes its own continuation");
  assert(io.await(run(Pick.Second, io), io) == i32(20), "second arm resumes its own continuation");
  assert(io.await(run(Pick.Neither, io), io) == i32(0), "the awaitless arm runs nothing");
});
// ---------------------------------------------------------------------------
// An await whose RESULT IS BOUND, in more than one arm of the same match.
//
// Several arms collapse onto ONE await point — only one arm can run, so one
// suspension state suffices — and the await point carries a single
// `targetVariableId`. That named the arm the analysis visited first; every
// other arm's binding was never assigned from `sm->await_result_N` and read a
// zero-initialised struct field. Unlike the rest of this cluster the C
// COMPILED and the program RAN, it just answered `false`/`0`.
//
// `execute_node` in yo-self/build_runner.yo is exactly this shape, which is
// what kept `build`/`fetch`/`install` from being dispatched.
// See issues/fixed/async-await-in-nested-match-arms.md.
// ---------------------------------------------------------------------------
test("Test an await result bound in two different match arms", {
  pick := (fn(k : i32, rio : Io) -> Impl(Future(i32, Io)))(
    rio.async((aio : Io) => {
      out := Box(i32)(0);
      match(
        Option(i32).Some(k),
        .None => (),
        .Some(v) => cond(
          (v == i32(1)) => {
            a := aio.await(future_with_returned_state(i32(10), aio), aio);
            out.* = a;
          },
          (v == i32(2)) => {
            b := aio.await(future_with_returned_state(i32(20), aio), aio);
            out.* = b;
          },
          true => ()
        )
      );
      return(out.*);
    })
  );
  // future_with_returned_state returns value + 1.
  assert(io.await(pick(i32(1), io), io) == i32(11), "first arm binds its own await result");
  assert(io.await(pick(i32(2), io), io) == i32(21), "second arm must bind ITS OWN await result, not read a zeroed field");
  assert(io.await(pick(i32(3), io), io) == i32(0), "the awaitless arm runs nothing");
});
// ---------------------------------------------------------------------------
// Two DIFFERENT locals that share a NAME, in sibling branches of one async body.
//
// The suspension analysis keyed SSA renaming on `name:frameLevel` alone. Arm
// bodies push and pop a frame, so both arms' `label` landed on the same level
// and the second was remapped onto the first's state-machine field — a field
// its own path never writes. The C COMPILED and the program RAN; the second arm
// just read an empty String. Keying on the declaration site as well separates a
// redeclaration (two `:=`, two sites) from a reassignment (`x = …`, which
// re-stamps the id but keeps its declaration token).
// See issues/fixed/async-sibling-arm-same-named-locals.md.
// ---------------------------------------------------------------------------
Shape :: enum(Exe, Lib);
test("Test same-named locals in sibling match arms of an async body", {
  describe := (fn(k : Shape, rio : Io) -> Impl(Future(String, Io)))(
    rio.async((aio : Io) => {
      description := String.from("start");
      name := String.from("thing");
      match(
        k,
        .Exe => {
          label := String.from("exe");
          description = `compile ${label} ${name}`;
          aio.await(yield(aio), aio);
        },
        .Lib => {
          label := String.from("lib");
          description = `compile ${label} ${name}`;
          aio.await(yield(aio), aio);
        }
      );
      return(description);
    })
  );
  assert(io.await(describe(Shape.Exe, io), io) == `compile exe thing`, "first arm reads its own local");
  assert(
    io.await(describe(Shape.Lib, io), io) == `compile lib thing`,
    "second arm must read ITS OWN local, not the first arm's zeroed field"
  );
});
// ---------------------------------------------------------------------------
// The same conflation, but where the second same-named local is a struct-literal
// ARGUMENT. The argument materialization declares a C local named after the
// variable; resolving the name to the other branch's state-machine field made it
// emit that declaration a second time — `error: redefinition of 'sub'`.
// ---------------------------------------------------------------------------
Duo :: ref(
  struct(
    a : String,
    b : String
  )
);
test("Test same-named locals in sibling branches used as struct-literal arguments", {
  build_duo := (fn(n : i32, rio : Io) -> Impl(Future(Duo, Io)))(
    rio.async((aio : Io) => {
      base := String.from("base");
      if(n > i32(0), {
        sub := String.from("one");
        return(Duo(a : base, b : sub));
      });
      aio.await(yield(aio), aio);
      sub := String.from("two");
      return(Duo(a : base, b : sub));
    })
  );
  early := io.await(build_duo(i32(1), io), io);
  assert(early.b == `one`, "the early-return branch uses its own local");
  late := io.await(build_duo(i32(0), io), io);
  assert(late.b == `two`, "the post-await branch uses its own local");
});
// ---------------------------------------------------------------------------
// A `match` as a definition's RHS with an arm that early-`return`s a FRESHLY
// CONSTRUCTED value, inside a body that awaits later.
//
// The evaluator attaches no temp variable to a call whose result flows straight
// out of a `return` — a plain function emits `return fn_String_new();`. In a
// state machine that `return` is lowered to "declare a result temp, assign
// sm->result", so the call must still appear as an expression; codegen emitted
// an error comment where the value belonged.
// See issues/fixed/async-match-arm-early-return-drops-call-result.md.
// ---------------------------------------------------------------------------
test("Test a match arm early-returning a freshly built value before an await", {
  probe := (fn(seed : i32, rio : Io) -> Impl(Future(String, Io)))(
    rio.async((aio : Io) => {
      stack := ArrayList(i32).new();
      if(seed > i32(0), {
        stack.push(seed);
      });
      item := match(
        stack.pop(),
        .None => {
          return(String.new());
        },
        .Some(it) => it
      );
      aio.await(yield(aio), aio);
      return(`got ${item}`);
    })
  );
  assert(io.await(probe(i32(0), io), io) == ``, "the early return yields the freshly built value");
  assert(io.await(probe(i32(7), io), io) == `got 7`, "the awaiting path still returns its own value");
});
// ---------------------------------------------------------------------------
// A reassignment inside an AWAITLESS nested match arm, in an async body whose
// OTHER arm awaits (variant C of the sibling-arm cluster).
//
// The match-arm statement emitter was the one statement emitter with no
// bare-temp-name gate, so the "old value saved for deferred drop" temp was
// emitted under its source name — not a declared C identifier in the resume
// function, where that temp lives as `sm->var_<id>`. `execute_node` in
// yo-self/build_runner.yo is this shape (`.Doc` only reassigns; `.Run` awaits).
// yo-self's `codegen/exprs/match.yo` already had the gate; only `src/` lacked it.
// See issues/fixed/async-sibling-arm-same-named-locals.md.
// ---------------------------------------------------------------------------
Task :: ref(struct(name : String));
Job :: enum(Run, Doc);
test("Test a reassignment in an awaitless nested arm beside an awaiting arm", {
  describe_job := (fn(k : Job, rio : Io) -> Impl(Future(String, Io)))(
    rio.async((aio : Io) => {
      description := String.from("start");
      match(
        k,
        .Run => {
          match(
            Option(Task).Some(Task(name : String.from("exe"))),
            .None => (),
            .Some(run_cfg) => {
              description = `run ${run_cfg.name}`;
              aio.await(yield(aio), aio);
            }
          );
        },
        .Doc => {
          match(
            Option(Task).Some(Task(name : String.from("book"))),
            .None => (),
            .Some(doc_cfg) => {
              description = `doc ${doc_cfg.name}`;
            }
          );
        }
      );
      return(description);
    })
  );
  assert(io.await(describe_job(Job.Run, io), io) == `run exe`, "the awaiting arm reassigns");
  assert(io.await(describe_job(Job.Doc, io), io) == `doc book`, "the awaitless arm reassigns");
});
// ---------------------------------------------------------------------------
// An `if` whose branch awaits, as the body of a `while`, in an async body.
//
// `if` is a `cond` wearing a macro head: the AST node stays an `if` and the
// branch structure only exists in its `$.macroExpansion`. The while-body
// dispatcher matched `cond` and `match` but not `if`, so the loop body emitted
// NOTHING AT ALL — no branch code, no `sm->cond_branch_N`. The loop ran, did
// nothing, and the program exited 0. `run_build`'s `--dry-run` loop in
// yo-self/build_runner.yo is this shape.
// See issues/fixed/async-if-with-await-in-while-body-emits-nothing.md.
// ---------------------------------------------------------------------------
test("Test an if whose branch awaits as a while loop body", {
  drive := (fn(dry : bool, rio : Io) -> Impl(Future(i32, Io)))(
    rio.async((aio : Io) => {
      total := Box(i32)(0);
      i := usize(0);
      while(runtime(i < usize(3)), {
        if(dry, {
          total.* = (total.* + i32(1));
        }, {
          v := aio.await(future_with_returned_state(i32(10), aio), aio);
          total.* = (total.* + v);
        });
        i = (i + usize(1));
      });
      return(total.*);
    })
  );
  // future_with_returned_state returns value + 1, so the awaiting path adds 11
  // three times; the non-awaiting path adds 1 three times.
  assert(io.await(drive(true, io), io) == i32(3), "the non-awaiting branch runs every iteration");
  assert(io.await(drive(false, io), io) == i32(33), "the awaiting branch runs every iteration");
});
// ---------------------------------------------------------------------------
// Sibling match arms whose PATTERNS bind the same name, each handing the
// binding to an awaited future that captures it.
//
// Same-named `:=` locals were fixed above; PATTERN bindings store through a
// different path. The async match generator resolved the state-machine slot
// for the binding STORE by scanning all state-machine variables for the first
// name match, so the second arm stored into the FIRST arm's field — while the
// argument READ resolved by id to the second arm's own field, calloc-zeroed,
// NULL for a ref type. The callee captured NULL and the program SIGSEGVed on
// the future's first poll. `execute_node` in yo-self/build_runner.yo is this
// shape (its .Artifact and .Run arms both bind `artifact`), which crashed
// `yo build run`.
// See issues/fixed/async-sibling-arm-match-bindings-store-to-wrong-slot.md.
// ---------------------------------------------------------------------------
Cargo :: ref(
  struct(
    label : String,
    size : i32
  )
);
CargoKind :: enum(A, B);
find_cargo :: (fn(tag : String) -> Option(Cargo))(
  Option(Cargo).Some(Cargo(label : tag, size : i32(7)))
);
describe_cargo :: (fn(c : Cargo, rio : Io) -> Impl(Future(String, Io)))(
  rio.async((aio : Io) => {
    aio.await(yield(aio), aio);
    return(`${c.label}:${c.size}`)
  })
);
test("Test same-named pattern bindings in sibling match arms passed to a capturing future", {
  drive := (fn(k : CargoKind, rio : Io) -> Impl(Future(String, Io)))(
    rio.async((aio : Io) => {
      out := String.from("none");
      match(
        k,
        .A => {
          match(
            find_cargo(String.from("a-item")),
            .None => (),
            .Some(artifact) => {
              d := aio.await(describe_cargo(artifact, aio), aio);
              out = d;
            }
          );
        },
        .B => {
          match(
            find_cargo(String.from("b-item")),
            .None => (),
            .Some(artifact) => {
              d := aio.await(describe_cargo(artifact, aio), aio);
              out = d;
            }
          );
        }
      );
      return(out)
    })
  );
  assert(io.await(drive(CargoKind.A, io), io) == `a-item:7`, "first arm's binding reaches the callee");
  assert(
    io.await(drive(CargoKind.B, io), io) == `b-item:7`,
    "second arm's binding must be stored in ITS OWN slot, not the first arm's"
  );
});
// ---------------------------------------------------------------------------
// A bare `if` whose branch awaits and then EARLY-RETURNS, in an async body.
//
// `yo fetch`'s prune-stale-lock path (yo-self/fetch.yo run_fetch) is this
// shape. Two independent miscompiles hid here, one per compiler:
//
//  - TS: the branch's remaining code after its first await hit
//    `generateRemainingExprFuture`, which handled nested cond/match/while/
//    begin but NOT `if` (a macro whose branch structure lives only in
//    `$.macroExpansion`) — the nested await's future was never stored, and
//    the chained early-return was emitted INSIDE the `await_future_N != NULL`
//    guard of a never-submitted future. The whole branch was silently
//    SKIPPED at runtime (printed the fall-through value, rc 0).
//  - self-hosted: the suspension-point walker had no `if` case at all, so
//    the branch's awaits never became await points — codegen then emitted
//    `sm->var_N = ;` (invalid C) where the await results were read.
//
// The fix set: walk/emit `if` through its macro expansion on both sides,
// start cond_branch dispatch codes at 1 so the calloc-zeroed field can gate
// chained layers, and emit outer-cond chained layers OUTSIDE the NULL guard.
// See issues/fixed/ts-bare-if-await-early-return-silently-skipped.md.
// ---------------------------------------------------------------------------
future_tag :: (fn(io : Io) -> Impl(Future(String, Io)))(
  io.async((aio : Io) => {
    aio.await(yield(aio), aio);
    return(String.from("lock"))
  })
);
test("Test a bare if whose branch awaits then early-returns", {
  drive := (fn(n : usize, rio : Io) -> Impl(Future(String, Io)))(
    rio.async((aio : Io) => {
      if(n == usize(0), {
        existing := aio.await(future_tag(aio), aio);
        if(existing.len() > usize(0), {
          aio.await(yield(aio), aio);
        });
        return(String.from("empty-path"));
      });
      return(String.from("deps-path"))
    })
  );
  assert(io.await(drive(usize(0), io), io) == `empty-path`, "the awaiting branch early-returns");
  assert(io.await(drive(usize(2), io), io) == `deps-path`, "the fall-through path still runs");
});
test("Test a bare if with await-binding and early return between two top-level awaits", {
  drive := (fn(n : usize, rio : Io) -> Impl(Future(String, Io)))(
    rio.async((aio : Io) => {
      first := aio.await(future_tag(aio), aio);
      if(n == usize(0), {
        existing := aio.await(future_tag(aio), aio);
        if(existing.len() > usize(0), {
          aio.await(yield(aio), aio);
        });
        return(`empty:${first}`);
      });
      tail := aio.await(future_tag(aio), aio);
      return(`deps:${first}:${tail}`)
    })
  );
  assert(io.await(drive(usize(0), io), io) == `empty:lock`, "the awaiting branch early-returns with the preceding await's value");
  assert(io.await(drive(usize(2), io), io) == `deps:lock:lock`, "the fall-through path runs the preceding AND trailing awaits");
});
// ─── await in an arm VALUE: the branch value must reach its destination ──────
// Module-level helper (a test-local closure cannot be captured by the nested
// async closure that drives each case).
__opt7_future :: (fn(rio : Io) -> Impl(Future(Option(i32), Io)))(
  rio.async((aio : Io) => {
    aio.await(yield(aio), aio);
    return(Option(i32).Some(i32(7)));
  })
);
// Regression for the silent value-loss found via read_yo_version always
// returning None: an await-carrying cond/match arm computes its value AFTER
// the await, in the resume segment — and unless the branch registration names
// a destination (sm->result for a tail expression, the bound variable's SM
// field for `r := ...`), that value was computed into a temp and DISCARDED.
// The zero-initialised result then silently decoded as `.None`/0.
test("match as the async body's tail value with an await inside an arm", {
  drive := (fn(rio : Io) -> Impl(Future(Option(i32), Io)))(
    rio.async((aio : Io) => {
      got := aio.await(__opt7_future(aio), aio);
      match(
        got,
        .None => Option(i32).None,
        .Some(v) => {
          aio.await(yield(aio), aio);
          Option(i32).Some(v + i32(1))
        }
      )
    })
  );
  r := io.await(drive(io), io);
  assert(match(r, .Some(v) => (v == i32(8)), .None => false), "tail match arm value survives the await split");
});
test("match bound to a local with an await inside an arm", {
  drive := (fn(rio : Io) -> Impl(Future(Option(i32), Io)))(
    rio.async((aio : Io) => {
      got := aio.await(__opt7_future(aio), aio);
      bound := match(
        got,
        .None => Option(i32).None,
        .Some(v) => {
          aio.await(yield(aio), aio);
          Option(i32).Some(v + i32(1))
        }
      );
      bound
    })
  );
  r := io.await(drive(io), io);
  assert(match(r, .Some(v) => (v == i32(8)), .None => false), "bound match arm value survives the await split");
});
test("cond as the async body's tail value with an await inside a branch", {
  drive := (fn(n : usize, rio : Io) -> Impl(Future(i32, Io)))(
    rio.async(
      (aio : Io) => cond(
        (n == usize(0)) => {
          aio.await(yield(aio), aio);
          i32(41)
        },
        true => i32(3)
      )
    )
  );
  assert(io.await(drive(usize(0), io), io) == i32(41), "tail cond awaiting branch value survives");
  assert(io.await(drive(usize(2), io), io) == i32(3), "tail cond fall-through branch value survives");
});
test("cond bound to a local with an await inside a branch", {
  drive := (fn(n : usize, rio : Io) -> Impl(Future(i32, Io)))(
    rio.async((aio : Io) => {
      bound := cond(
        (n == usize(0)) => {
          aio.await(yield(aio), aio);
          i32(41)
        },
        true => i32(3)
      );
      bound + i32(1)
    })
  );
  assert(io.await(drive(usize(0), io), io) == i32(42), "bound cond awaiting branch value survives");
  assert(io.await(drive(usize(2), io), io) == i32(4), "bound cond fall-through branch value survives");
});
// ─── await nested TWO branch levels deep inside an async while ───────────────
// Regression: a branch-nested await inside a while body never inherited the
// while-loop chain — the loop's own resume state looped back BEFORE the
// nested await ran (seeing the stale condition, it exited), and the nested
// await's state completed the future with no loop-back at all. The loop
// silently ran ONE iteration. Both `if` and `cond` nesting were affected.
test("await nested in an if inside an if inside an async while keeps looping", {
  drive := (fn(rio : Io) -> Impl(Future(usize, Io)))(
    rio.async((aio : Io) => {
      (count : usize) = usize(0);
      stack := ArrayList(usize).new();
      stack.push(usize(3));
      while(runtime(stack.len() > usize(0)), {
        n := match(stack.pop(), .Some(x) => x, .None => usize(0));
        if(n > usize(1), {
          aio.await(yield(aio), aio);
          if(n > usize(2), {
            aio.await(yield(aio), aio);
            stack.push(n - usize(1));
          });
          count = (count + usize(1));
        });
      });
      count
    })
  );
  assert(io.await(drive(io), io) == usize(2), "both branch-carrying iterations ran");
});
test("await nested in a cond inside a cond inside an async while keeps looping", {
  drive := (fn(rio : Io) -> Impl(Future(usize, Io)))(
    rio.async((aio : Io) => {
      (count : usize) = usize(0);
      stack := ArrayList(usize).new();
      stack.push(usize(3));
      while(runtime(stack.len() > usize(0)), {
        n := match(stack.pop(), .Some(x) => x, .None => usize(0));
        cond(
          (n > usize(1)) => {
            aio.await(yield(aio), aio);
            cond(
              (n > usize(2)) => {
                aio.await(yield(aio), aio);
                stack.push(n - usize(1));
              },
              true => ()
            );
            count = (count + usize(1));
          },
          true => ()
        );
      });
      count
    })
  );
  assert(io.await(drive(io), io) == usize(2), "both branch-carrying iterations ran");
});
