});
// ---------------------------------------------------------------------------
// 63. Multiple effect row spreads: E1 : Type.Struct, E2 : Type.Struct
// ---------------------------------------------------------------------------
test("Test Future with multiple effect row spreads", {
  Raise :: (fn(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);
  RaiseBundle :: struct(raise : Raise);
  LogBundle :: struct(log : Log);
  might_fail :: (fn(e : RaiseBundle) -> i32)(
    e.raise(`oops`)
  );
  might_log :: (fn(e : LogBundle) -> unit)(
    e.log(`logged something`)
  );
  run_both :: (
    fn(
      generic(T1 : Type, T2 : Type, E1 : Type.Struct, E2 : Type.Struct),
      f1 : (fn(e : E1) -> T1),
      f2 : (fn(e : E2) -> T2),
      e1 : E1,
      e2 : E2
    ) -> T1
  )({
    f2(e2);
    f1(e1)
  });
  task := io.async((io : Io) => {
    (raise : Raise) = (
      (msg) -> {
        println(msg);
        return(i32(42));
      }
    );
    (log : Log) = (
      (msg) -> {
        println(msg);
      }
    );
    result := run_both(
      might_fail,
      might_log,
      RaiseBundle(raise : raise),
      LogBundle(log : log)
    );
    io.await(yield(io), io);
    result
  });
  result := io.await(task, io);
  assert(result == i32(42), "Future with multiple effect row spreads should work");
});
