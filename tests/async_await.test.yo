});
// ---------------------------------------------------------------------------
// 43. Single-iteration while-with-await
//     Condition becomes false after exactly one iteration.
//     Tests that the state machine correctly exits after one await.
// ---------------------------------------------------------------------------
test("Test single-iteration while-with-await", {
  counter := Box(i32)(0);
  result := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(counter.* < i32(1)), {
      counter.* = (counter.* + 1);
      temp := Box(i32)(42);
      io.await(yield(io), io);
      result.* = temp.*;
    });
  });
  io.await(task, io);
  assert(counter.* == i32(1), "loop runs exactly once");
  assert(result.* == i32(42), "result from single iteration");
});
// ---------------------------------------------------------------------------
// 44. While-with-await followed by code after the loop
//     Expressions after the while must run after loop exits.
// ---------------------------------------------------------------------------
test("Test code after while-with-await loop", {
  counter := Box(i32)(0);
  result := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(counter.* < i32(3)), {
      counter.* = (counter.* + 1);
      io.await(yield(io), io);
    });
    result.* = (counter.* * i32(10));
  });
  io.await(task, io);
  assert(counter.* == i32(3), "counter should reach 3");
  assert(result.* == i32(30), "code after loop should set result to 30");
});
// ---------------------------------------------------------------------------
// 45. Cond-with-await followed by while-with-await
//     Sequential mixing of different async control flow patterns.
// ---------------------------------------------------------------------------
test("Test cond-with-await then while-with-await", {
  flag := Box(bool)(true);
  counter := Box(i32)(0);
  result := Box(i32)(0);
  task := io.async((io : Io) => {
    cond(
      flag.* => {
        io.await(yield(io), io);
        result.* = i32(10);
      },
      true => {
        result.* = i32(20);
      }
    );
    while(runtime(counter.* < i32(3)), {
      counter.* = (counter.* + 1);
      io.await(yield(io), io);
    });
    result.* = (result.* + counter.*);
  });
  io.await(task, io);
  assert(result.* == i32(13), "10 from cond + 3 from counter");
  assert(counter.* == i32(3), "counter should reach 3");
});
// ---------------------------------------------------------------------------
// 46. While-with-await followed by cond-with-await
//     The cond sees the loop's final state.
// ---------------------------------------------------------------------------
test("Test while-with-await then cond-with-await", {
  counter := Box(i32)(0);
  result := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(counter.* < i32(3)), {
      counter.* = (counter.* + 1);
      io.await(yield(io), io);
    });
    cond(
      (counter.* == i32(3)) => {
        io.await(yield(io), io);
        result.* = i32(100);
      },
      true => {
        result.* = i32(0);
      }
    );
  });
  io.await(task, io);
  assert(counter.* == i32(3), "counter should reach 3");
  assert(result.* == i32(100), "cond should take true branch after loop");
});
// ---------------------------------------------------------------------------
// 47. While-with-await with break in first iteration
//     The loop runs once and breaks immediately after the first await.
// ---------------------------------------------------------------------------
test("Test while-with-await break on first iteration", {
  counter := Box(i32)(0);
  done := Box(bool)(false);
  task := io.async((io : Io) => {
    while(runtime(true), {
      counter.* = (counter.* + 1);
      temp := Box(i32)(99);
      io.await(yield(io), io);
      assert(temp.* == i32(99), "temp should survive await");
      break;
    });
    done.* = true;
  });
  io.await(task, io);
  assert(counter.* == i32(1), "loop should execute exactly once");
  assert(done.* == true, "code after loop should run");
});
// ---------------------------------------------------------------------------
// 48. Nested async while with inner break + outer code after loop
//     Outer while runs 2 rounds. Inner while breaks at 3.
//     After outer loop, additional code runs.
// ---------------------------------------------------------------------------
test("Test nested async while with code after outer loop", {
  outer := Box(i32)(0);
  inner_total := Box(i32)(0);
  final_result := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(outer.* < i32(2)), {
      inner_counter := Box(i32)(0);
      while(runtime(true), {
        inner_counter.* = (inner_counter.* + 1);
        io.await(yield(io), io);
        cond(
          (inner_counter.* >= i32(3)) => {
            break;
          },
          true => ()
        );
      });
      inner_total.* = (inner_total.* + inner_counter.*);
      outer.* = (outer.* + 1);
    });
    final_result.* = ((inner_total.* * i32(10)) + outer.*);
  });
  io.await(task, io);
  assert(outer.* == i32(2), "outer loop should run twice");
  assert(inner_total.* == i32(6), "inner breaks at 3 each round, total 6");
  assert(final_result.* == i32(62), "final should be 6*10 + 2 = 62");
});
// ---------------------------------------------------------------------------
// 49. Multiple captured variables modified in nested while-with-await
//     All captured variables must remain consistent across iterations.
// ---------------------------------------------------------------------------
test("Test multiple captured variables in nested while-with-await", {
  x := Box(i32)(0);
  y := Box(i32)(100);
  z := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(x.* < i32(3)), {
      x.* = (x.* + 1);
      y.* = (y.* - i32(10));
      inner := Box(i32)(0);
      while(runtime(true), {
        inner.* = (inner.* + 1);
        io.await(yield(io), io);
        cond(
          (inner.* >= i32(2)) => {
            break;
          },
          true => ()
        );
      });
      z.* = (z.* + (x.* + inner.*));
    });
  });
  io.await(task, io);
  assert(x.* == i32(3), "x should count to 3");
  assert(y.* == i32(70), "y should be 100 - 3*10 = 70");
  assert(z.* == i32(12), "z should be (1+2)+(2+2)+(3+2) = 12");
});
// ---------------------------------------------------------------------------
// 50. While-with-await early break skips remaining iterations
//     Break after 2 of 10 planned iterations. Resources must be properly freed.
// ---------------------------------------------------------------------------
test("Test while-with-await early break with local allocations", {
  counter := Box(i32)(0);
  sum := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(counter.* < i32(10)), {
      counter.* = (counter.* + 1);
      temp := Box(i32)(counter.* * counter.*);
      io.await(yield(io), io);
      sum.* = (sum.* + temp.*);
      cond(
        (counter.* >= i32(3)) => {
          break;
        },
        true => ()
      );
    });
  });
  io.await(task, io);
  assert(counter.* == i32(3), "loop should break at 3");
  assert(sum.* == i32(14), "sum of squares 1+4+9 = 14");
});
// ---------------------------------------------------------------------------
// 51. Cond with await in non-await branch followed by code
//     Non-await branch is taken; code after cond should still execute.
// ---------------------------------------------------------------------------
test("Test cond non-await path then code after cond in async", {
  flag := Box(bool)(false);
  result := Box(i32)(0);
  after_cond := Box(i32)(0);
  task := io.async((io : Io) => {
    cond(
      flag.* => {
        io.await(yield(io), io);
        result.* = i32(1);
      },
      true => {
        result.* = i32(2);
      }
    );
    after_cond.* = (result.* + i32(10));
  });
  io.await(task, io);
  assert(result.* == i32(2), "non-await branch should set result to 2");
  assert(after_cond.* == i32(12), "code after cond should run: 2+10=12");
});
// ---------------------------------------------------------------------------
// 52. Await of async subtask inside while loop
//     Each iteration creates and awaits a subtask that captures RC values.
//     Tests proper dup of captured RC values when creating async blocks
//     inside a state machine (while loop body).
// ---------------------------------------------------------------------------
test("Test await of async subtask inside while loop", {
  total := Box(i32)(0);
  counter := Box(i32)(0);
  task := io.async((io : Io) => {
    while(runtime(counter.* < i32(3)), {
      counter.* = (counter.* + 1);
      val := counter.*;
      subtask := io.async((io : Io) => {
        io.await(yield(io), io);
        total.* = (total.* + val);
      });
      io.await(subtask, io);
    });
  });
  io.await(task, io);
  assert(counter.* == i32(3), "outer loop should run 3 times");
  assert(total.* == i32(6), "total should be 1+2+3 = 6");
});
// ---------------------------------------------------------------------------
// 53. Match with await on primitive integer type
//     Tests match expression with integer values containing await in branches.
// ---------------------------------------------------------------------------
test("Test match with await on primitive integer", {
  result := Box(i32)(0);
  task := io.async((io : Io) => {
    x := i32(2);
    result.* = match(
      x,
      1 => {
        io.await(yield(io), io);
        i32(10)
      },
      2 => {
        io.await(yield(io), io);
        i32(20)
      },
      _ => i32(30)
    );
  });
  io.await(task, io);
  assert(result.* == i32(20), "match should take branch 2 and return 20");
});
// ---------------------------------------------------------------------------
// 54. Match with await on primitive integer - default branch
//     Tests that the default/wildcard branch with await works correctly.
// ---------------------------------------------------------------------------
test("Test match with await on primitive integer default branch", {
  result := Box(i32)(0);
  task := io.async((io : Io) => {
    x := i32(99);
    result.* = match(
      x,
      1 => i32(10),
      2 => i32(20),
      _ => {
        io.await(yield(io), io);
        i32(30)
      }
    );
  });
  io.await(task, io);
  assert(result.* == i32(30), "match should take default branch and return 30");
});
// ---------------------------------------------------------------------------
// 55. Basic spawn — two cold futures started concurrently
//     io.spawn starts each future without waiting.
//     io.await extracts results after spawn.
//     Verifies interleaving order: task1 state0 → task2 state0 → task1 state1 → task2 state1
// ---------------------------------------------------------------------------
test("Test basic spawn of two futures", {
  counter := Box(i32)(0);
  task1 := io.async((io : Io) => {
    assert(counter.* == i32(0), "counter should be 0 at start of task1");
    counter.* = (counter.* + 1);
    io.await(yield(io), io);
    assert(counter.* == i32(11), "counter should be 11 after yield in task1");
    counter.* = (counter.* + 1);
    return(counter.*);
  });
  task2 := io.async((io : Io) => {
    assert(counter.* == i32(1), "counter should be 1 at start of task2");
    counter.* = (counter.* + 10);
    io.await(yield(io), io);
    assert(counter.* == i32(12), "counter should be 12 after yield in task2");
    counter.* = (counter.* + 10);
    return(counter.*);
  });
  // Both tasks are cold (not started).
  // spawn starts both without waiting for completion, returns JoinHandle.
  handle1 := io.spawn(task1, io);
  handle2 := io.spawn(task2, io);
  // After spawn, both are running — handle.await waits and returns Option(T).
  result1 := handle1.await(io);
  result2 := handle2.await(io);
  // Both tasks completed successfully (no unwind), results are Some.
  assert(result1.is_some(), "task1 should complete successfully");
  assert(result2.is_some(), "task2 should complete successfully");
  // Both tasks incremented counter: +2 from task1, +20 from task2
  assert(counter.* == i32(22), "counter should be 22 after spawn");
});
// ---------------------------------------------------------------------------
// 56. Spawn single future — edge case
//     io.spawn(task) starts the future, io.await waits for it.
// ---------------------------------------------------------------------------
test("Test spawn single future", {
  counter := Box(i32)(0);
  task := io.async((io : Io) => {
    counter.* = (counter.* + 42);
    io.await(yield(io), io);
    counter.* = (counter.* + 8);
    return(counter.*);
  });
  handle := io.spawn(task, io);
  result := handle.await(io);
  assert(counter.* == i32(50), "counter should be 50 after single spawn");
  assert(result.is_some(), "task should complete successfully");
  assert(result.unwrap() == i32(50), "result should be 50");
});
// ---------------------------------------------------------------------------
// 57. Spawn with futures that have multiple awaits inside
//     Each future yields multiple times; spawn starts both.
//     Verifies round-robin interleaving across all yield points.
// ---------------------------------------------------------------------------
test("Test spawn with multi-yield futures", {
  counter := Box(i32)(0);
  task1 := io.async((io : Io) => {
    // Round 1: task1 runs first
    assert(counter.* == i32(0), "counter should be 0 at task1 round 1");
    counter.* = (counter.* + 1);
    io.await(yield(io), io);
    // Round 2: after task2's round 1 (+10)
    assert(counter.* == i32(11), "counter should be 11 at task1 round 2");
    counter.* = (counter.* + 1);
    io.await(yield(io), io);
    // Round 3: after task2's round 2 (+10)
    assert(counter.* == i32(22), "counter should be 22 at task1 round 3");
    counter.* = (counter.* + 1);
    return(counter.*);
  });
  task2 := io.async((io : Io) => {
    // Round 1: after task1's round 1 (+1)
    assert(counter.* == i32(1), "counter should be 1 at task2 round 1");
    counter.* = (counter.* + 10);
    io.await(yield(io), io);
    // Round 2: after task1's round 2 (+1)
    assert(counter.* == i32(12), "counter should be 12 at task2 round 2");
    counter.* = (counter.* + 10);
    io.await(yield(io), io);
    // Round 3: after task1's round 3 (+1)
    assert(counter.* == i32(23), "counter should be 23 at task2 round 3");
    counter.* = (counter.* + 10);
    return(counter.*);
  });
  handle1 := io.spawn(task1, io);
  handle2 := io.spawn(task2, io);
  result1 := handle1.await(io);
  result2 := handle2.await(io);
  // Both tasks completed successfully, results are Some.
  assert(result1.is_some(), "multi-yield task1 should complete");
  assert(result2.is_some(), "multi-yield task2 should complete");
  // task1 adds 3, task2 adds 30; total = 33
  assert(counter.* == i32(33), "counter should be 33 after spawn of multi-yield futures");
});
// ---------------------------------------------------------------------------
// 58. Spawn then code after — verify execution continues after spawn + await
// ---------------------------------------------------------------------------
test("Test code after spawn", {
  flag := Box(bool)(false);
  task := io.async((io : Io) => {
    io.await(yield(io), io);
    flag.* = true;
  });
  handle := io.spawn(task, io);
  handle.await(io);
  // After spawn + await, flag should be set
  assert(flag.*, "flag should be true after spawn + await");
  // Code after should execute normally
  task2 := io.async((io : Io) => {
    io.await(yield(io), io);
  });
  io.await(task2, io);
  assert(flag.*, "flag should still be true after yield");
});
