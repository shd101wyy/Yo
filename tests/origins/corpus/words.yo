// N0 corpus row `words` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): POSITIVE: `words(self : &Doc) -> ArrayList(&(T, self))`, the owner written after the result's last use (§3, O6).
// Expected once decision 43's rules land: accepted.
{ ArrayList } :: import("std/collections/array_list");
_Doc :: struct(text : i32);
_words :: (fn(self : &_Doc) -> ArrayList(&(i32, self)))({
  mut(out) := ArrayList(&(i32, self)).new();
  out.push(&self.text);
  out.push(&self.text);
  out
});
main :: (fn() -> unit)({
  mut(doc) := _Doc(text : i32(1));
  w := _words(&doc);
  _ := w.len();
  doc.text = i32(2);
  ()
});
export(main);
