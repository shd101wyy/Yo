// N0 corpus row `effect-resume-local` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): a handler resuming with a view of its own local (O7 effect handlers; §4's handler lowering; the superseded design's handler row).
// Expected once decision 43's rules land: rejected: E0912, the resume value names the handler's local.
_Ask :: (ctl(key : &i32) -> &(i32, key));
_use :: (fn(ask : _Ask) -> i32)({
  k := i32(1);
  r := ask(&k);
  // Read into a local, not a tail `r.*`: issues/2026-11-08-e0912-flags-a-scalar-field-read-through-a-local-borrow-as-returning-the-borrow.md.
  v := r.*;
  v
});
main :: (fn() -> unit)({
  (ask : _Ask) = (fn(key : &i32) -> &(i32, key))({
    y := i32(2);
    return(&y);
  });
  _ := _use(ask);
  ()
});
export(main);
