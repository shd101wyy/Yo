// O-3 corpus row `async-body-local-into-capture` (plans/backlog/BORROW_CHECKER_COMPLETENESS.md §8, VERDICTS-37;
// manifest tests/origins/corpus.tsv): an `io.async` body stores a reference to its own local into a captured `&mut` slot.
// Expected once O-3 lands: rejected in the body: E0912 (VERDICTS-37 Q2: a body-local root).
_put :: (fn(generic(r : Origin), dst : &mut Option(&(i32, r)), v : &(i32, r)) -> unit)({
  dst.* = .Some(v);
});
main :: (fn(io : Io) -> unit)({
  mut(slot) := Option(&i32).None;
  fut := io.async({ s : &mut slot }(io : Io) => {
    y := i32(42);
    _put(&mut s.*, &y);
  });
  io.await(fut, io);
  _ := slot.is_some();
});
export(main);
