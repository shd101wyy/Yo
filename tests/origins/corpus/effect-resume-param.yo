_Ask :: (ctl(key : &i32) -> &(i32, key));
_use :: (fn(ask : _Ask) -> i32)({
  k := i32(1);
  r := ask(&k);
  r.*
});
main :: (fn() -> unit)({
  (ask : _Ask) = (
    key -> {
      return(key);
    }
  );
  _ := _use(ask);
  ()
});
export(main);
