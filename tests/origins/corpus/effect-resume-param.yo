// N0 corpus row `effect-resume-param` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): POSITIVE: a handler resuming with the operation's own parameter (O7 effect handlers).
// Expected once decision 43's rules land: accepted.
_Ask :: (ctl(key : &i32) -> &(i32, key));
_use :: (fn(ask : _Ask) -> i32)({
  k := i32(1);
  r := ask(&k);
  // Read into a local, not a tail `r.*`: issues/2026-11-08-e0912-flags-a-scalar-field-read-through-a-local-borrow-as-returning-the-borrow.md.
  v := r.*;
  v
});
main :: (fn() -> unit)({
  (ask : _Ask) = (
    key -> {
      return(key);
    }
  );
  _ := _use(ask);
  ()
});
export(main);
