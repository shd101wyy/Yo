// N0 corpus row `swap-declared-union` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): POSITIVE: `swap` on referents both declared `&(i32, (x, y))` (O7).
// Expected once decision 43's rules land: accepted.
_swap :: (fn(generic(r : Origin), a : &mut&(i32, r), b : &mut&(i32, r)) -> unit)({
  t := a.*;
  a.* = b.*;
  b.* = t;
});
main :: (fn() -> unit)({
  x := i32(1);
  y := i32(2);
  (mut(ra) : &(i32, (x, y))) = &x;
  (mut(rb) : &(i32, (x, y))) = &y;
  _swap(&mut ra, &mut rb);
  _ := (ra.* + rb.*);
  ()
});
export(main);
