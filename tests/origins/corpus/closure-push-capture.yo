// N0 corpus row `closure-push-capture` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): POSITIVE: a closure pushes a captured `&x` into a captured body-local container with an elided union; an unrelated place stays writable (§7: a `&mut` capture of a flow-inferred container).
// Expected once decision 43's rules land: accepted (the flow set grows by the literal's captures: {x}).
{ ArrayList } :: import("std/collections/array_list");
_each :: (fn(f : Impl(Fn(v : &i32) -> unit)) -> unit)({
  k := i32(1);
  f(&k);
});
main :: (fn() -> unit)({
  mut(x) := i32(1);
  mut(y) := i32(2);
  mut(out) := ArrayList(&i32).new();
  _each({ o : &mut out, rx : &x }(v : &i32) => o.push(rx));
  y = i32(3);
  _ := out.len();
  ()
});
export(main);
