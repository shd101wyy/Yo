// N0 corpus row `rc-of-ref-holder` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): `rc(v)` with a reference-holding `v` (the `Escapable` bound, O9, O10).
// Expected once decision 43's rules land: rejected: E0909 at the call, naming `Rc`'s bound.
_View :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(at : &(i32, p), lo : usize));
main :: (fn() -> unit)({
  x := i32(1);
  v := _View(x)(at : &x, lo : usize(0));
  r := rc(v);
  _ := r.*.lo;
  ()
});
export(main);
