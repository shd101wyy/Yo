// N0 corpus row `dyn-call-spelled-result` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): POSITIVE: a call through `Dyn(Trait)` whose trait method spells its result `&(i32, self)`: `o` is not in the result and may be written (§5 route 5; the superseded design's `map.remove(&k)` / `m.get(&k)` controls).
// Expected once decision 43's rules land: accepted.
_Pick :: trait(pick : (fn(self : &Self, other : &i32) -> &(i32, self)));
_P :: struct(v : i32);
impl(_P, _Pick(pick : (fn(self : &Self, other : &i32) -> &(i32, self))(&self.v)));
main :: (fn() -> unit)({
  (d : Dyn(_Pick)) = dyn(_P(v : i32(1)));
  mut(o) := i32(2);
  r := d.pick(&o);
  o = i32(3);
  _ := r.*;
  ()
});
export(main);
