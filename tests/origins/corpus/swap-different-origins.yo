// N0 corpus row `swap-different-origins` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): `swap` on referents of different origin types (O7's `swap` row).
// Expected once decision 43's rules land: rejected: a type error, `r` fixed to `x` and to `y`.
_swap :: (fn(generic(r : Origin), a : &mut&(i32, r), b : &mut&(i32, r)) -> unit)({
  t := a.*;
  a.* = b.*;
  b.* = t;
});
main :: (fn() -> unit)({
  x := i32(1);
  y := i32(2);
  (mut(ra) : &(i32, x)) = &x;
  (mut(rb) : &(i32, y)) = &y;
  _swap(&mut ra, &mut rb);
  _ := (ra.* + rb.*);
  ()
});
export(main);
