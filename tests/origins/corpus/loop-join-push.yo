// N0 corpus row `loop-join-push` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): a loop that pushes on one path and writes the root at its head: the flow set must be a fixpoint over the back edge (expected hole: control-flow joins).
// Expected once decision 43's rules land: rejected: E0911 at `x = i` on the second iteration.
{ ArrayList } :: import("std/collections/array_list");
main :: (fn() -> unit)({
  mut(x) := i32(0);
  mut(out) := ArrayList(&i32).new();
  mut(i) := i32(0);
  while(i < i32(3), {
    x = i;
    if((i % i32(2)) == i32(1), {
      out.push(&x);
    });
    i = (i + i32(1));
  });
  _ := out.len();
  ()
});
export(main);
