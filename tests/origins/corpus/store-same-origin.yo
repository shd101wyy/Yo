// Expected once decision 43's rules land: accepted.
_store :: (fn(generic(T : Type, r : Origin), dst : &mut Option(&(T, r)), v : &(T, r)) -> unit)({
  dst.* = .Some(v);
});
main :: (fn() -> unit)({
  x := i32(1);
  mut(slot) := Option(&(i32, x)).None;
  _store(&mut slot, &x);
  _ := slot.is_some();
  ()
});
export(main);
