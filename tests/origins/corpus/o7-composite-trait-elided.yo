// N0 corpus row `o7-composite-trait-elided` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): POSITIVE: a trait eliding its composite result's origin (O2: self and other); the impl elides too and returns `other` (VERDICTS-57 §2).
// Expected once decision 43's rules land: accepted.
_Pick :: trait(pick : (fn(self : &Self, other : &i32) -> Option(&i32)));
_P :: struct(v : i32);
impl(_P, _Pick(pick : (fn(self : &Self, other : &i32) -> Option(&i32))(.Some(other))));
main :: (fn() -> unit)({
  p := _P(v : i32(1));
  o := i32(2);
  _ := p.pick(&o);
  ()
});
export(main);
