// N0 corpus row `generic-unbounded-rc` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): a generic body passing an unbounded `T` to `Rc(T)` (O10).
// Expected once decision 43's rules land: rejected inside the specialization, naming `where(T <: Escapable)`.
_wrap :: (fn(generic(T : Type), v : T) -> Rc(T))(rc(v));
main :: (fn() -> unit)({
  x := i32(1);
  r := _wrap(&x);
  _ := r.*.*;
  ()
});
export(main);
