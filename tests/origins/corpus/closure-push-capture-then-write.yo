// N0 corpus row `closure-push-capture-then-write` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): the captured root written while the container lives.
// Expected once decision 43's rules land: rejected: E0911 at the write of `x`.
{ ArrayList } :: import("std/collections/array_list");
_each :: (fn(f : Impl(Fn(v : &i32) -> unit)) -> unit)({
  k := i32(1);
  f(&k);
});
main :: (fn() -> unit)({
  mut(x) := i32(1);
  mut(y) := i32(2);
  mut(out) := ArrayList(&i32).new();
  _each({ o : &mut out, rx : &x }(v : &i32) => o.push(rx));
  x = i32(3);
  _ := out.len();
  ()
});
export(main);
