// N0 corpus row `ref-mut-ref-store-narrower` (manifest tests/origins/corpus.tsv): NEGATIVE: `set(&mut r, &inner)` through `&mut &(Rc(X), p)` writes the solved origin back into the inferred `r`; the scope end of `inner` with `r` live is E0911.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
set :: (fn(generic(p : Origin), dst : &mut&(Rc(X), p), v : &(Rc(X), p)) -> unit)({
  dst.* = v;
});
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  {
    inner := mk();
    set(&mut r, &inner);
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
