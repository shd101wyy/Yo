// N0 corpus row `fnmut-two-live-calls` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): an `FnMut` call borrows its closure exclusively (decision 37), so a second call while a `&mut` lend of the closure lives is two live exclusive borrows of one place (O3 step 2; decision 43 N1f).
// Expected once decision 43's rules land: rejected: E0911 at the second call.
main :: (fn() -> unit)({
  (mut(f) : Impl(FnMut() -> i32)) = ({ n : i32(0) }() => {
    n = (n + i32(1));
    n
  });
  r := &mut f;
  _a := f();
  _b := r();
  ()
});
export(main);
