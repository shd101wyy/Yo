// N0 corpus row `ref-mut-ref-store-chain3` (manifest tests/origins/corpus.tsv): NEGATIVE: the same store through a depth-3 re-borrow chain.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
set :: (fn(generic(p : Origin), dst : &mut&(Rc(X), p), v : &(Rc(X), p)) -> unit)({
  dst.* = v;
});
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  mut(rp) := &mut r;
  {
    inner := mk();
    rpp := &mut rp;
    rppp := &mut rpp;
    set(&mut rppp.*.*.*, &inner);
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
