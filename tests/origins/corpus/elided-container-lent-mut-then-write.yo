// N0 corpus row `elided-container-lent-mut-then-write` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): the place pushed through a `&mut` lend written while the container lives (O2 x O6).
// Expected once decision 43's rules land: rejected: E0911 at the write of `x`.
{ ArrayList } :: import("std/collections/array_list");
_push :: (fn(generic(r : Origin), xs : &mut ArrayList(&(i32, r)), value : &(i32, r)) -> unit)(xs.push(value));
main :: (fn() -> unit)({
  mut(x) := i32(1);
  mut(out) := ArrayList(&i32).new();
  _push(&mut out, &x);
  x = i32(3);
  _ := out.len();
  ()
});
export(main);
