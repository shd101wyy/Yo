// N0 corpus row `repoint-through-rc` (plans/backlog/BORROW_CHECKER_COMPLETENESS.md §4 P1; manifest
// tests/origins/corpus.tsv): POSITIVE: `cur` is re-pointed at a field of an `Rc`'s payload; the step pins
// the cell (decision 25, "Through an `Rc`"), so the place lives as long as `cur` does.
// Expected: accepted.
X :: struct(v : i32);
main :: (fn() -> unit)({
  x := i32(1);
  cur := &x;
  h := Rc.new(X(v : i32(2)));
  cur = &h.v;
  _ := (cur.* + i32(1));
  ()
});
export(main);
