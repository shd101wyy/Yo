// N0 corpus row `store-widen-mut-pointee` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): a widening through a `&mut` pointee: `store(&mut slot, &y)` (O3-3).
// Expected once decision 43's rules land: rejected: `r` is fixed to `x` through the `&mut` pointee and `&y : &(i32, y)` does not fit it.
_store :: (fn(generic(T : Type, r : Origin), dst : &mut Option(&(T, r)), v : &(T, r)) -> unit)({
  dst.* = .Some(v);
});
main :: (fn() -> unit)({
  x := i32(1);
  mut(slot) := Option(&(i32, x)).Some(&x);
  {
    y := i32(2);
    _store(&mut slot, &y);
  };
  _ := slot.is_some();
  ()
});
export(main);
