// N0 corpus row `rc-guard-handle-dropped` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): the handle a `RefCell` guard was taken through dropped while the guard lives (O9).
// Expected once decision 43's rules land: rejected: E0911 at the drop.
{ RefCell } :: import("std/sync/refcell");
main :: (fn() -> unit)({
  h := rc(RefCell(i32).new(i32(1)));
  h2 := h;
  mut(g) := h.*.borrow_mut();
  drop(h);
  g.* = i32(2);
  ()
});
export(main);
