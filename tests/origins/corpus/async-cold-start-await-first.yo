// N0 corpus row `async-cold-start-await-first` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): POSITIVE: the same future awaited before the write (O8).
// Expected once decision 43's rules land: accepted.
_run :: (fn(io : Io) -> Impl(Future(unit, Io)))(
  io.async((io : Io) => {
    mut(x) := i32(1);
    fut := io.async({ &mut x }(io : Io) => {
      x = (x + i32(1));
    });
    io.await(fut, io);
    x = i32(5);
  })
);
main :: (fn(io : Io) -> unit)({
  io.await(_run(io), io);
});
export(main);
