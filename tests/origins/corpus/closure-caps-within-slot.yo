{ ArrayList } :: import("std/collections/array-list");
_register :: (fn(generic(r : Origin), reg : &mut ArrayList(Box(Dyn(Fn(v : &i32) -> i32, r))), f : Box(Dyn(Fn(v : &i32) -> i32, r))) -> unit)(reg.push(f));
main :: (fn() -> unit)({
  x := i32(1);
  y := i32(2);
  mut(reg) := ArrayList(Box(Dyn(Fn(v : &i32) -> i32, x))).new();
  _register(&mut reg, dyn(Box.new({ c : &x }(v : &i32) => (v.* + c.*))));
  _ := reg.len();
  ()
});
export(main);
