// N0 corpus row `rc-handle-dropped` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): a handle dropped while `&(X, h)` lives (O9).
// Expected once decision 43's rules land: rejected: E0911 at the drop.
_X :: struct(x : i32);
derive(_X, Copy, Clone);
main :: (fn() -> unit)({
  h := rc(_X(x : i32(1)));
  r := &h.*.x;
  drop(h);
  _ := r.*;
  ()
});
export(main);
