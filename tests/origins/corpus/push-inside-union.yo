// N0 corpus row `push-inside-union` (plans/backlog/REFERENCES_AND_ORIGINS.md §8 N0;
// manifest tests/origins/corpus.tsv): POSITIVE: pushes inside the declared union; a declared-but-not-yet-entered place is still writable (O6: the union is a bound, the flow set freezes).
// Expected once decision 43's rules land: accepted.
{ ArrayList } :: import("std/collections/array_list");
main :: (fn() -> unit)({
  x := i32(1);
  mut(y) := i32(2);
  mut(both) := ArrayList(&(i32, (x, y))).new();
  both.push(&x);
  y = i32(3);
  both.push(&y);
  _ := both.len();
  ()
});
export(main);
