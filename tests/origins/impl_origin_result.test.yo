// An impl's origin parameter in a method's result (decision 43; Rust's
// `impl<'p> Entry<'p, …> { fn or_insert(self) -> &'p mut V }`): in scope in
// every method's signature, bound at a call from the receiver's type
// (`H(…, o)` gives `p := o`), so the result points where the receiver's
// references do — it may outlive the holder, never the place
// (issues/fixed/2026-11-08-a-method-result-origin-cannot-name-its-impls-origin-parameter.md).
{ assert } :: import("std/assert");
// A `&` holder: `get` reads through its reference.
IoHeld :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(i32, p)));
impl(generic(p : Origin), IoHeld(p), get : (fn(self : &Self) -> &(i32, p))(&self.r.*));
// The result outlives the holder: it points into `x`, which the caller owns.
io_read_through :: (fn(x : &i32) -> &(i32, x))({
  h := IoHeld(x)(r : x);
  &h.get().*
});
test("A method's result names its impl's origin", {
  x := i32(1);
  h := IoHeld(x)(r : &x);
  y := h.get();
  assert(y.* == i32(1), "bound");
  assert(h.get().* == i32(1), "in place");
  assert(io_read_through(&x).* == i32(1), "the result outlives the holder: it points into `x`");
  z := IoHeld(x)(r : &x).get();
  assert(z.* == i32(1), "bound off a temporary holder: the result points into `x`, not into the holder");
});
comptime_expect_error(
  io_place_written_while_temp_holders_result_lives :: (fn() -> unit)({
    mut(x) := i32(1);
    z := IoHeld(x)(r : &x).get();
    x = i32(2);
    _ := z.*;
  }),
  "Cannot write `x` here: `z` borrows `x` with `&`"
);
comptime_expect_error(
  io_place_written_while_result_lives :: (fn() -> unit)({
    mut(x) := i32(1);
    h := IoHeld(x)(r : &x);
    y := h.get();
    x = i32(2);
    _ := y.*;
  }),
  "Cannot write `x` here: `y` borrows `x` with `&`"
);
// The entry shape: a by-value holder of a `&mut` loan whose consuming
// method returns a place in the borrowed value.
IoSlots :: struct(a : i32, b : i32, a_set : bool);
IoEntry :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(m : &mut(IoSlots, p), key : i32));
impl(IoSlots, entry : (fn(self : &mut Self, key : i32) -> IoEntry(self))(IoEntry(self)(m : self, key : key)));
impl(
  generic(p : Origin),
  IoEntry(p),
  or_insert : (fn(self : Self, v : i32) -> &mut(i32, p))({
    if(!self.m.a_set, {
      self.m.a = v;
      self.m.a_set = true;
    });
    &mut self.m.*.a
  })
);
test("An entry's or_insert returns a place in the map", {
  mut(s) := IoSlots(a : i32(0), b : i32(0), a_set : false);
  s.entry(i32(0)).or_insert(i32(5)).* = (s.entry(i32(0)).or_insert(i32(9)).* + i32(1));
  assert(s.a == i32(6), "written in place through a temporary entry");
  r := s.entry(i32(0)).or_insert(i32(9));
  r.* = i32(7);
  assert(s.a == i32(7), "written through the bound result");
});
comptime_expect_error(
  io_result_outlives_the_map :: (fn() -> &mut i32)({
    mut(s) := IoSlots(a : i32(0), b : i32(0), a_set : false);
    &mut s.entry(i32(0)).or_insert(i32(5)).*
  }),
  "points into `s`, a local: its storage ends with the call"
);
comptime_expect_error(
  io_map_read_while_result_lives :: (fn() -> unit)({
    mut(s) := IoSlots(a : i32(0), b : i32(0), a_set : false);
    r := s.entry(i32(0)).or_insert(i32(5));
    _ := s.b;
    r.* = i32(1);
  }),
  "Cannot read `s.b` here: `r` borrows `s` with `&mut`"
);
// A by-value holder whose body is the `&mut` place itself: the function
// literal's body is no argument lent to a call, so dropping `self` at its end
// is no move of a lent place (E0910 before the fix).
IoTake :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(m : &mut(i32, p)));
impl(generic(p : Origin), IoTake(p), take : (fn(self : Self) -> &mut(i32, p))(&mut self.m.*));
test("A by-value holder yields its reference's place", {
  mut(x) := i32(1);
  IoTake(x)(m : &mut x).take().* = i32(4);
  assert(x == i32(4), "written through the holder's place");
});
// An origin parameter no parameter's type names cannot be bound at a call.
IoPlain :: struct(v : i32);
comptime_expect_error(
  impl(generic(p : Origin), IoPlain, io_get : (fn(self : &Self) -> &(i32, p))(&self.v)),
  "no parameter's type names it"
);
// VERDICTS-41 Q2 (Rust's E0713): a by-value parameter's end-of-body drop runs
// its `Drop` with `&mut self` while the result is live, so the result may not
// borrow a place through the parameter's `&mut` field when a value prefix of
// the place path has a `Drop` that uses its roots. A `&` field is exempt, and
// so is a holder without a `Drop` on the path
// (issues/fixed/2026-11-08-a-drop-holder-yields-a-place-through-its-reference-field.md).
DpSlots :: struct(a : i32, b : i32);
DpEntry :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(m : &mut(DpSlots, p)));
impl(
  generic(p : Origin),
  DpEntry(p),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      self.m.a = i32(-1);
    })
  )
);
comptime_expect_error(
  impl(generic(p : Origin), DpEntry(p), dp_take_ref : (fn(self : Self) -> &mut(i32, p))(&mut self.m.*.a)),
  "its destructor runs at the end of this body with `&mut self` while the returned `&mut i32` is still in use by the caller"
);
comptime_expect_error(
  impl(generic(p : Origin), DpEntry(p), dp_take_payload : (fn(self : Self) -> Option(&mut(i32, p)))(.Some(&mut self.m.*.a))),
  "Cannot return a value holding a reference into `*self.m` from the by-value parameter `self`"
);
comptime_expect_error(
  impl(generic(p : Origin), DpEntry(p), dp_take_shared : (fn(self : Self) -> &(i32, p))(&self.m.*.a)),
  "Cannot return a reference into `*self.m` from the by-value parameter `self`"
);
// The `Drop` is on a prefix of the path, not on the holder itself.
DpOuter :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(e : DpEntry(p)));
comptime_expect_error(
  impl(generic(p : Origin), DpOuter(p), dp_take_nested : (fn(self : Self) -> &mut(i32, p))(&mut self.e.m.*.a)),
  "from the by-value parameter `self`"
);
// A holder without a `Drop` impl: its storage ends and nothing runs.
DpPlain :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(m : &mut(DpSlots, p)));
impl(generic(p : Origin), DpPlain(p), dp_plain_take : (fn(self : Self) -> &mut(i32, p))(&mut self.m.*.a));
// A `Drop` holder of a SHARED reference: the destructor cannot write through it.
DpShared :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(DpSlots, p)));
impl(
  generic(p : Origin),
  DpShared(p),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _ := self.r.a;
    })
  )
);
impl(generic(p : Origin), DpShared(p), dp_shared_take : (fn(self : Self) -> &(i32, p))(&self.r.*.a));
// A `Drop` field the path does not go through.
DpGuard :: struct(n : i32);
impl(DpGuard, Drop(drop : (fn(self : &mut Self) -> unit)(())));
DpGuarded :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(m : &mut(DpSlots, p), g : DpGuard));
impl(generic(p : Origin), DpGuarded(p), dp_guarded_take : (fn(self : Self) -> &mut(i32, p))(&mut self.m.*.a));
test("a by-value parameter's place is yielded when no Drop on its path runs", {
  mut(s) := DpSlots(a : i32(0), b : i32(0));
  res := DpPlain(s)(m : &mut s).dp_plain_take();
  res.* = i32(5);
  assert(s.a == i32(5), "no Drop: the write through the result lands");
  t := DpSlots(a : i32(2), b : i32(3));
  q := DpShared(t)(r : &t).dp_shared_take();
  assert(q.* == i32(2), "a shared field: the reborrow is not invalidated");
  mut(u) := DpSlots(a : i32(0), b : i32(0));
  w := DpGuarded(u)(m : &mut u, g : DpGuard(n : i32(1))).dp_guarded_take();
  w.* = i32(7);
  assert(u.a == i32(7), "the guard is not on the path");
});
// O-6's call-result elision names no callee origin in a call's result type
// (issues/fixed/2026-11-09-a-call-results-type-keeps-its-callees-origin-names.md): the origin an impl method's
// result binds from its receiver is `origin_of`'s, so a store of it through a `&mut` holder still compares it with
// the holder's fixed origin.
IoStore :: (fn(generic(q : Origin), dst : &mut Option(&(i32, q)), v : &(i32, q)) -> unit)({
  dst.* = .Some(v);
});
test("A method result bound from its receiver is stored through a &mut holder", {
  x := i32(1);
  (mut(slot) : Option(&(i32, x))) = .None;
  h := IoHeld(x)(r : &x);
  y := h.get();
  IoStore(&mut slot, y);
  assert(match(slot, .Some(s) => (s.* == i32(1)), .None => false), "stored within the holder's origin");
});
