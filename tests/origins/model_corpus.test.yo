// ---------------------------------------------------------------------------
// The superseded design's rows restated (§8 "N0 as built" maps the rest)
// ---------------------------------------------------------------------------
test("index-mut-twice", {
  // An index place is its root's place: the model has no paths, which is the
  // rule (index places on one root overlap, decision 28).
  main := entry(
    al5(
      let_(XS, Rc.new(NodeE.NewList(int()))),
      let_(A, Rc.new(NodeE.Borrow(true, XS))),
      let_(B, Rc.new(NodeE.Borrow(true, XS))),
      Rc.new(NodeE.WriteThrough(A, lit())),
      Rc.new(NodeE.WriteThrough(B, lit()))
    )
  );
  verdict("index-mut-twice", case1(main), "E0911");
});
test("place-write-join", {
  // `out(0) = &x` is encoded as the push it joins like.
  main := entry(
    al7(
      let_(Z, lit()),
      let_(X, lit()),
      let_(OUT, Rc.new(NodeE.NewList(shr(int(), o(X) | o(Z))))),
      Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Borrow(false, Z)))),
      Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Borrow(false, X)))),
      Rc.new(NodeE.Assign(X, lit())),
      use_(Rc.new(NodeE.Var(OUT)))
    )
  );
  verdict("place-write-join", case1(main), "E0911");
});
test("match-arm-binding-origin", {
