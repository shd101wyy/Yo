  verdict("match-arm-binding-origin", case1(main), "E0911");
});
test("list-mut-two-pushes", {
  main := entry(
    al5(
      let_(X, lit()),
      let_(OUT, Rc.new(NodeE.NewList(exc(int(), o(X))))),
      Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Borrow(true, X)))),
      Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Borrow(true, X)))),
      use_(Rc.new(NodeE.Var(OUT)))
    )
  );
