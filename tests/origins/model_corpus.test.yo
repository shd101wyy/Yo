// P9 (plans/backlog/BORROW_CHECKER_COMPLETENESS.md §7): two-phase borrows with a
// named `&`. A `&mut` argument is reserved when evaluated and activated when
// the call begins, so a `&` loan whose last use lies in a later argument is
// dead at the activation; one used after the call is not.
/// `push_n(generic(), a : &mut List(int), n : int)`.
push_n :: (fn() -> FnDef)(sig(u64(0), al2(prm(A, exc(list(int()), ELIDED)), prm(B, int())), int()));
/// `len(v : &List(int)) -> int`.
list_len :: (fn() -> FnDef)(sig(u64(0), al1(prm(V, shr(list(int()), ELIDED))), int()));
two_phase_main :: (fn(used_after : bool) -> FnDef)({
  mut(body) := al3(
    let_(XS, Rc.new(NodeE.NewList(int()))),
    let_(R, Rc.new(NodeE.Borrow(false, XS))),
    use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, XS)), call(usize(2), al1(Rc.new(NodeE.Var(R)))))))
  );
  if(used_after, {
    body.push(use_(Rc.new(NodeE.Var(R))));
  });
  entry(body)
});
test("two-phase-named-last-use", {
  verdict("two-phase-named-last-use", case3(two_phase_main(false), push_n(), list_len()), "ACCEPT");
});
test("two-phase-named-after", {
  verdict("two-phase-named-after", case3(two_phase_main(true), push_n(), list_len()), "E0911");
});
test("two-phase-mut-relend", {
  both := sig(u64(0), al2(prm(A, exc(list(int()), ELIDED)), prm(B, exc(list(int()), ELIDED))), int());
  main := entry(al2(let_(XS, Rc.new(NodeE.NewList(int()))), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, XS)), Rc.new(NodeE.Borrow(true, XS)))))));
  verdict("two-phase-mut-relend", case2(main, both), "E0910");
});
// An operand whose VALUE carries the loan's origin into the callee keeps the
// loan live at the activation, wherever its last use is: a holder of it, an
// `Option(&T)` of it, a nested call's reference result over it
// (issues/fixed/2026-11-11-two-phase-ends-a-loan-a-later-argument-carries-into-the-callee.md).
/// `push_carried(generic(), a : &mut List(int), h : <carrier>)`.
push_carried :: (fn(carrier : Ty) -> FnDef)(sig(u64(0), al2(prm(A, exc(list(int()), ELIDED)), prm(B, carrier)), int()));
/// `two_phase_main`'s shape with `H := init` and the later argument `arg`.
two_phase_carrier_main :: (fn(init : Node, arg : Node) -> FnDef)(
  entry(al3(let_(XS, Rc.new(NodeE.NewList(int()))), let_(H, init), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, XS)), arg)))))
);
test("two-phase-holder-arg", {
  main := two_phase_carrier_main(Rc.new(NodeE.MakeTup(al1(Rc.new(NodeE.Borrow(false, XS))))), Rc.new(NodeE.Var(H)));
  verdict("two-phase-holder-arg", case2(main, push_carried(Rc.new(TyE.Tup(al1(shr(list(int()), ELIDED)))))), "E0911");
});
test("two-phase-holder-first-arg", {
  // The holder first, the `&mut` second: `carried_push(h, &mut xs)`.
  carried_push := sig(u64(0), al2(prm(B, Rc.new(TyE.Tup(al1(shr(list(int()), ELIDED))))), prm(A, exc(list(int()), ELIDED))), int());
  main := entry(
    al3(
      let_(XS, Rc.new(NodeE.NewList(int()))),
      let_(H, Rc.new(NodeE.MakeTup(al1(Rc.new(NodeE.Borrow(false, XS)))))),
      use_(call(usize(1), al2(Rc.new(NodeE.Var(H)), Rc.new(NodeE.Borrow(true, XS)))))
    )
  );
  verdict("two-phase-holder-first-arg", case2(main, carried_push), "E0911");
});
test("two-phase-option-arg", {
  main := two_phase_carrier_main(Rc.new(NodeE.Make(Kind.Some, Rc.new(NodeE.Borrow(false, XS)))), Rc.new(NodeE.Var(H)));
  verdict("two-phase-option-arg", case2(main, push_carried(wrap(Kind.Some, shr(list(int()), ELIDED)))), "E0911");
});
test("two-phase-ref-result-arg", {
  // `first(generic(r), v : &(List(int), r)) -> &(int, r)`.
  first := sig(P, al1(prm(V, shr(list(int()), P))), shr(int(), P));
  main := two_phase_carrier_main(Rc.new(NodeE.Borrow(false, XS)), call(usize(2), al1(Rc.new(NodeE.Var(H)))));
  verdict("two-phase-ref-result-arg", case3(main, push_carried(shr(int(), ELIDED)), first), "E0911");
});
test("two-phase-holder-value-arg", {
  // The later argument reads a value through the holder: `len(h.0)`.
  main := two_phase_carrier_main(Rc.new(NodeE.MakeTup(al1(Rc.new(NodeE.Borrow(false, XS))))), call(usize(2), al1(Rc.new(NodeE.Field(H, usize(0))))));
  verdict("two-phase-holder-value-arg", case3(main, push_n(), list_len()), "ACCEPT");
});
