});
/// `wrap(generic(T : Type), v : T) -> Rc(T)`, with and without
/// `where(T <: Escapable)`.
wrap_rc :: (fn(bounded : bool) -> FnDef)(
  FnDef(
    origin_params : u64(0),
    type_params : usize(1),
    escapable : bounded,
    params : al1(prm(V, Rc.new(TyE.TParam(usize(0))))),
    result : wrap(Kind.Rc, Rc.new(TyE.TParam(usize(0)))),
    body : .Some(al1(Rc.new(NodeE.Return(Rc.new(NodeE.Make(Kind.Rc, Rc.new(NodeE.Var(V)))))))),
    is_extern : false
  )
);
test("generic-unbounded-rc", {
  main := entry(al2(let_(X, lit()), let_(R, call(usize(1), al1(Rc.new(NodeE.Borrow(false, X)))))));
  verdict("generic-unbounded-rc", case2(main, wrap_rc(false)), "E0909@spec");
});
test("generic-bounded-rc", {
  main := entry(al2(let_(X, lit()), let_(R, call(usize(1), al1(Rc.new(NodeE.Borrow(false, X)))))));
  verdict("generic-bounded-rc", case2(main, wrap_rc(true)), "E0909");
});
test("generic-escapable-rc", {
  main := entry(al1(let_(R, call(usize(1), al1(lit())))));
  verdict("generic-escapable-rc", case2(main, wrap_rc(true)), "ACCEPT");
});
// ---------------------------------------------------------------------------
// Closures (O2's per-call parameter origin, O7's capture origins)
// ---------------------------------------------------------------------------
/// `Fn(&i32) -> R` capturing `caps`.
fn_t :: (fn(result : Ty, caps : u64) -> Ty)(Rc.new(TyE.Func(shr(int(), FNQ), result, caps, u64(0))));
closure :: (fn(caps : ArrayList(Node), body : ArrayList(Node), result : Node) -> Node)(Rc.new(NodeE.Closure(E, shr(int(), ELIDED), caps, body, result)));
/// `register(generic(r : Origin), reg : &mut List(Fn(&i32) -> i32 + r), f : Fn(&i32) -> i32 + r)`.
register :: (fn() -> FnDef)(sig(P, al2(prm(REG, exc(list(fn_t(int(), P)), ELIDED)), prm(V, fn_t(int(), P))), int()));
register_main :: (fn(captured : usize) -> FnDef)(
  entry(
    al5(
      let_(X, lit()),
      let_(Y, lit()),
      let_(REG, Rc.new(NodeE.NewList(fn_t(int(), o(X))))),
      use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, REG)), closure(al1(let_(captured, Rc.new(NodeE.Borrow(false, captured)))), none(), lit())))),
      use_(Rc.new(NodeE.Var(REG)))
    )
  )
);
test("closure-caps-exceed-slot", {
  verdict("closure-caps-exceed-slot", case2(register_main(Y), register()), "ORIGIN_MISMATCH");
});
test("closure-caps-within-slot", {
  verdict("closure-caps-within-slot", case2(register_main(X), register()), "ACCEPT");
});
/// `apply(f : Fn(&i32) -> &i32, v : &i32)`: the result origin is the
/// per-call parameter origin.
apply :: (fn() -> FnDef)(sig(u64(0), al2(prm(F, fn_t(shr(int(), FNQ), ELIDED)), prm(V, shr(int(), ELIDED))), int()));
F :: usize(17);
apply_main :: (fn(result : Node) -> FnDef)(
  entry(al3(let_(X, lit()), let_(Y, lit()), use_(call(usize(1), al2(closure(al1(let_(Y, Rc.new(NodeE.Borrow(false, Y)))), none(), result), Rc.new(NodeE.Borrow(false, X)))))))
);
test("closure-returns-capture", {
  verdict("closure-returns-capture", case2(apply_main(Rc.new(NodeE.Var(Y))), apply()), "ORIGIN_MISMATCH");
});
test("closure-returns-param", {
  verdict("closure-returns-param", case2(apply_main(Rc.new(NodeE.Var(E))), apply()), "ACCEPT");
});
/// `each(f : Fn(&i32) -> i32)`.
each :: (fn() -> FnDef)(sig(u64(0), al1(prm(F, Rc.new(TyE.Func(shr(int(), FNQ), int(), ELIDED, u64(0))))), int()));
test("closure-param-into-capture", {
  main := entry(
    al4(
      let_(X, lit()),
      let_(OUT, Rc.new(NodeE.NewList(shr(int(), o(X))))),
      use_(call(usize(1), al1(closure(al1(let_(OUT, Rc.new(NodeE.Borrow(true, OUT)))), al1(Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Var(E))))), lit())))),
      use_(Rc.new(NodeE.Var(OUT)))
    )
  );
  verdict("closure-param-into-capture", case2(main, each()), "UNION");
});
closure_push_main :: (fn(written : usize) -> FnDef)(
  entry(
    al6(
      let_(X, lit()),
      let_(Y, lit()),
      let_(OUT, Rc.new(NodeE.NewList(shr(int(), ELIDED)))),
      use_(call(usize(1), al1(closure(al2(let_(OUT, Rc.new(NodeE.Borrow(true, OUT))), let_(X, Rc.new(NodeE.Borrow(false, X)))), al1(Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Var(X))))), lit())))),
      Rc.new(NodeE.Assign(written, lit())),
      use_(Rc.new(NodeE.Var(OUT)))
    )
  )
);
test("closure-push-capture", {
  verdict("closure-push-capture", case2(closure_push_main(Y), each()), "ACCEPT");
});
test("closure-push-capture-then-write", {
  verdict("closure-push-capture-then-write", case2(closure_push_main(X), each()), "E0911");
});
test("closure-push-capture-then-clear", {
  // The store joins `out`'s flow set at the literal; re-binding `out`
  // kills it (O-1's `=` over reaching definitions), so `x` is writable.
  main := entry(
    al7(
      let_(X, lit()),
      let_(Y, lit()),
      let_(OUT, Rc.new(NodeE.NewList(shr(int(), ELIDED)))),
      use_(call(usize(1), al1(closure(al2(let_(OUT, Rc.new(NodeE.Borrow(true, OUT))), let_(X, Rc.new(NodeE.Borrow(false, X)))), al1(Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Var(X))))), lit())))),
      Rc.new(NodeE.Assign(OUT, Rc.new(NodeE.NewList(shr(int(), ELIDED))))),
      Rc.new(NodeE.Assign(X, lit())),
      use_(Rc.new(NodeE.Var(OUT)))
    )
  );
  verdict("closure-push-capture-then-clear", case2(main, each()), "ACCEPT");
});
test("closure-mut-capture-last-use", {
  // P4-0 (VERDICTS-59 decision 12): the closure's `&mut` capture of `out` is a loan whose range ends at the closure's
  // last use (the call), so `out` is usable after it; the shape of `closure-push-capture`, whose written root is the
  // unrelated `y`. The compiler still holds the capture to the binding's scope end (C14): the manifest's `today`
  // column records E0910.
  verdict("closure-mut-capture-last-use", case2(closure_push_main(Y), each()), "ACCEPT");
});
test("closure-param-into-capture-inline", {
  // The per-call parameter stored into a captured flow-inferred container
  // (the compiler row's `Option` slot; the toy language spells a flow slot
  // as its container twin, as `flow-slot-lent-mut` does).
  main := entry(
    al3(
      let_(OUT, Rc.new(NodeE.NewList(shr(int(), ELIDED)))),
      use_(call(usize(1), al1(closure(al1(let_(OUT, Rc.new(NodeE.Borrow(true, OUT)))), al1(Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Var(E))))), lit())))),
      use_(Rc.new(NodeE.Var(OUT)))
    )
  );
  verdict("closure-param-into-capture-inline", case2(main, each()), "UNION");
});
// ---------------------------------------------------------------------------
// O-3: every elided `&` written in a parameter type is a rigid origin of the
// body, named, closure and `io.async` bodies alike (one binder)
// ---------------------------------------------------------------------------
/// `store(v : &i32, dst : &mut Option(&i32))`: two elided origins, distinct
/// and rigid in the body.
store_elided :: (fn() -> FnDef)(
  fun(
    u64(0),
    al2(prm(V, shr(int(), ELIDED)), prm(DST, exc(wrap(Kind.Some, shr(int(), ELIDED)), ELIDED))),
    int(),
    al1(Rc.new(NodeE.WriteThrough(DST, Rc.new(NodeE.Make(Kind.Some, Rc.new(NodeE.Var(V)))))))
  )
);
test("fn-param-through-param", {
  verdict("fn-param-through-param", case2(entry(none()), store_elided()), "ORIGIN_MISMATCH");
});
test("fn-param-through-param-spelled", {
  body := fun(
    P,
    al2(prm(V, shr(int(), P)), prm(DST, exc(wrap(Kind.Some, shr(int(), P)), ELIDED))),
    int(),
    al1(Rc.new(NodeE.WriteThrough(DST, Rc.new(NodeE.Make(Kind.Some, Rc.new(NodeE.Var(V)))))))
  );
  verdict("fn-param-through-param-spelled", case2(entry(none()), body), "ACCEPT");
});
test("closure-param-through-param", {
  // A toy closure takes one parameter. The literal's body is checked by the
  // same binder as a named body, so its two-parameter form is the named
  // body above.
  verdict("closure-param-through-param", case2(entry(none()), store_elided()), "ORIGIN_MISMATCH");
});
test("async-body-local-into-capture", {
  // A toy `io.async` carries no body: the escape is the body storing its own
  // local through the `&mut` it borrows, spelled as a body with that
  // parameter.
  body := fun(
    u64(0),
    al1(prm(DST, exc(list(shr(int(), ELIDED)), ELIDED))),
    int(),
    al2(let_(Y, lit()), Rc.new(NodeE.Push(DST, Rc.new(NodeE.Borrow(false, Y)))))
  );
  verdict("async-body-local-into-capture", case2(entry(none()), body), "UNION");
});
// ---------------------------------------------------------------------------
// Futures (O5, O8)
// ---------------------------------------------------------------------------
cold_start_main :: (fn(await_first : bool) -> FnDef)({
  fut := let_(FUT, Rc.new(NodeE.Async(al1(let_(X, Rc.new(NodeE.Borrow(true, X)))))));
  entry(
    cond(
      await_first => al4(let_(X, lit()), fut, use_(Rc.new(NodeE.Var(FUT))), Rc.new(NodeE.Assign(X, lit()))),
      true => al4(let_(X, lit()), fut, Rc.new(NodeE.Assign(X, lit())), use_(Rc.new(NodeE.Var(FUT))))
    )
  )
});
test("async-cold-start-write", {
  verdict("async-cold-start-write", case1(cold_start_main(false)), "E0911");
});
test("async-cold-start-await-first", {
  verdict("async-cold-start-await-first", case1(cold_start_main(true)), "ACCEPT");
});
test("async-forward-local", {
  g := fun(u64(0), no_params(), Rc.new(TyE.Fut(u64(0), u64(0))), al2(let_(Y, lit()), Rc.new(NodeE.Return(Rc.new(NodeE.Async(al1(let_(Y, Rc.new(NodeE.Borrow(false, Y))))))))));
  verdict("async-forward-local", case2(entry(none()), g), "E0912");
});
/// `bump(c : &mut i32) -> Future(unit, c)`, forwarding its lent place.
bump_fut :: (fn() -> FnDef)(fun(u64(0), al1(prm(C, exc(int(), ELIDED))), Rc.new(TyE.Fut(u64(0), o(C))), al1(Rc.new(NodeE.Return(Rc.new(NodeE.Async(al1(let_(C, Rc.new(NodeE.Var(C)))))))))));
test("async-forward-param", {
  main := entry(al4(let_(X, lit()), let_(FUT, call(usize(1), al1(Rc.new(NodeE.Borrow(true, X))))), use_(Rc.new(NodeE.Var(FUT))), use_(Rc.new(NodeE.Var(X)))));
  verdict("async-forward-param", case2(main, bump_fut()), "ACCEPT");
});
test("await-local-borrow", {
  outer := fun(u64(0), no_params(), int(), al4(let_(D, lit()), let_(INNER, call(usize(1), al1(Rc.new(NodeE.Borrow(true, D))))), use_(Rc.new(NodeE.Var(INNER))), Rc.new(NodeE.Return(Rc.new(NodeE.Var(D))))));
  verdict("await-local-borrow", case3(entry(al1(use_(call0(usize(2))))), bump_fut(), outer), "ACCEPT");
