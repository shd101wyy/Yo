// Decision 43's N0 gate (plans/backlog/REFERENCES_AND_ORIGINS.md §8): every
// row of the negative-test corpus, encoded in the reference checker's toy
// language (tests/origins/model.yo), must get the verdict
// tests/origins/corpus.tsv records for it — `ACCEPT` for a positive control,
// the code of the rule that rejects it for a negative row. The Yo spelling
// of each row is tests/origins/corpus/<id>.yo; scripts/origins-corpus.sh runs
// those through the compiler and cross-checks this file's ids and codes
// against the manifest.
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{
  bit,
  FNQ,
  ELIDED,
  Kind,
  Ty,
  Node,
  Param,
  FnDef,
  TypeDef,
  Case,
  check_case,
  check_ablated,
  ABLATE_INVARIANCE,
  ABLATE_LOOP_FIXPOINT,
  ABLATE_USER_DROP,
  ABLATE_CAPTURE_WIDEN,
  ABLATE_HANDLE_ORIGIN
} :: import("./model.yo");
/// `alK(e1, …, eK)`: a list of K elements, built by pushes. Macro plan B3
/// deleted the `array_list(...)` literal, and its replacement,
/// `ArrayList(T).from([…])`, cannot take these elements yet: an array literal
/// of enum variants built from runtime values emits invalid C
/// (issues/2026-10-20-an-array-or-tuple-literal-whose-element-holds-a-runtime-field-emits-invalid-c.md).
al1 :: (fn(generic(T : Type), a : T) -> ArrayList(T))({
  out := ArrayList(T).with_capacity(usize(1));
  out.push(a);
  out
});
al2 :: (fn(generic(T : Type), a : T, b : T) -> ArrayList(T))({
  out := ArrayList(T).with_capacity(usize(2));
  out.push(a);
  out.push(b);
  out
});
al3 :: (fn(generic(T : Type), a : T, b : T, c : T) -> ArrayList(T))({
  out := ArrayList(T).with_capacity(usize(3));
  out.push(a);
  out.push(b);
  out.push(c);
  out
});
al4 :: (fn(generic(T : Type), a : T, b : T, c : T, d : T) -> ArrayList(T))({
  out := ArrayList(T).with_capacity(usize(4));
  out.push(a);
  out.push(b);
  out.push(c);
  out.push(d);
  out
});
al5 :: (fn(generic(T : Type), a : T, b : T, c : T, d : T, e : T) -> ArrayList(T))({
  out := ArrayList(T).with_capacity(usize(5));
  out.push(a);
  out.push(b);
  out.push(c);
  out.push(d);
  out.push(e);
  out
});
al6 :: (fn(generic(T : Type), a : T, b : T, c : T, d : T, e : T, f : T) -> ArrayList(T))({
  out := ArrayList(T).with_capacity(usize(6));
  out.push(a);
  out.push(b);
  out.push(c);
  out.push(d);
  out.push(e);
  out.push(f);
  out
});
al7 :: (fn(generic(T : Type), a : T, b : T, c : T, d : T, e : T, f : T, g : T) -> ArrayList(T))({
  out := ArrayList(T).with_capacity(usize(7));
  out.push(a);
  out.push(b);
  out.push(c);
  out.push(d);
  out.push(e);
  out.push(f);
  out.push(g);
  out
});
// Places: a case uses each at most once.
X :: usize(0);
Y :: usize(1);
Z :: usize(2);
XS :: usize(3);
OUT :: usize(4);
SLOT :: usize(5);
H :: usize(6);
H2 :: usize(7);
G :: usize(8);
RA :: usize(9);
RB :: usize(10);
A :: usize(11);
B :: usize(12);
PAIR :: usize(13);
IT :: usize(14);
D :: usize(15);
C :: usize(16);
FUT :: usize(18);
V :: usize(19);
SELF :: usize(20);
VALUE :: usize(21);
DST :: usize(22);
E :: usize(23);
CELL :: usize(24);
R :: usize(25);
INNER :: usize(26);
OTHER :: usize(27);
BOTH :: usize(28);
DOC :: usize(29);
W :: usize(30);
REG :: usize(32);
NEXT :: usize(33);
/// The first declared origin parameter `p`.
P :: (u64(1) << u64(40));
o :: (fn(p : usize) -> u64)(bit(p));
// Types.
int :: (fn() -> Ty)(Ty.Int);
shr :: (fn(t : Ty, origin : u64) -> Ty)(Ty.Ref(false, t, origin));
exc :: (fn(t : Ty, origin : u64) -> Ty)(Ty.Ref(true, t, origin));
list :: (fn(t : Ty) -> Ty)(Ty.List(t));
wrap :: (fn(k : Kind, t : Ty) -> Ty)(Ty.Wrap(k, t));
// Programs.
none :: (fn() -> ArrayList(Node))(ArrayList(Node).new());
let_ :: (fn(p : usize, init : Node) -> Node)(Node.Let(p, init, .None));
let_d :: (fn(p : usize, init : Node, decl : Ty) -> Node)(Node.Let(p, init, .Some(decl)));
lit :: (fn() -> Node)(Node.Lit);
call :: (fn(f : usize, args : ArrayList(Node)) -> Node)(Node.Call(f, args));
call0 :: (fn(f : usize) -> Node)(Node.Call(f, ArrayList(Node).new()));
use_ :: (fn(e : Node) -> Node)(Node.Use(e));
prm :: (fn(p : usize, t : Ty) -> Param)(Param(p : p, ty : t));
no_params :: (fn() -> ArrayList(Param))(ArrayList(Param).new());
/// The entry function: no parameters, a body.
entry :: (fn(body : ArrayList(Node)) -> FnDef)(
  FnDef(origin_params : u64(0), type_params : usize(0), escapable : false, params : ArrayList(Param).new(), result : Ty.Int, body : .Some(body), is_extern : false)
);
/// A function with a body.
fun :: (fn(origins : u64, params : ArrayList(Param), result : Ty, body : ArrayList(Node)) -> FnDef)(
  FnDef(origin_params : origins, type_params : usize(0), escapable : false, params : params, result : result, body : .Some(body), is_extern : false)
);
/// A signature whose body the model does not see (an `AllowUnsafe` std
/// body, a trait method).
sig :: (fn(origins : u64, params : ArrayList(Param), result : Ty) -> FnDef)(
  FnDef(origin_params : origins, type_params : usize(0), escapable : false, params : params, result : result, body : .None, is_extern : false)
);
case1 :: (fn(f0 : FnDef) -> Case)(Case(fns : al1(f0), globals : ArrayList(Ty).new(), types : ArrayList(TypeDef).new()));
case2 :: (fn(f0 : FnDef, f1 : FnDef) -> Case)(Case(fns : al2(f0, f1), globals : ArrayList(Ty).new(), types : ArrayList(TypeDef).new()));
case3 :: (fn(f0 : FnDef, f1 : FnDef, f2 : FnDef) -> Case)(Case(fns : al3(f0, f1, f2), globals : ArrayList(Ty).new(), types : ArrayList(TypeDef).new()));
/// Asserts the model's verdict on a case.
verdict :: (fn(id : str, c : Case, want : str) -> unit)({
  ck := check_case(c);
  println(`${id}: ${ck.err} (${ck.why})`);
  assert(ck.err == String.from(want), `${id}: the model says ${ck.err} (${ck.why}), the manifest says ${want}`);
});
// ---------------------------------------------------------------------------
// O1 well-formedness
// ---------------------------------------------------------------------------
test("wf-self-binding", {
  t := list(shr(int(), o(XS)));
  verdict("wf-self-binding", case1(entry(al1(let_d(XS, Node.NewList(shr(int(), o(XS))), t)))), "WF_SELF");
});
test("wf-self-field", {
  c := case1(entry(none()));
  c.types.push(TypeDef(origin_params : u64(0), field_places : o(NEXT), fields : al1(shr(int(), o(NEXT)))));
  verdict("wf-self-field", c, "WF_SELF");
});
test("wf-undeclared-origin", {
  verdict("wf-undeclared-origin", case2(entry(none()), sig(u64(0), al1(prm(V, shr(int(), P))), int())), "WF_UNDECLARED");
});
test("wf-outward-field", {
  c := case1(entry(none()));
  c.types.push(TypeDef(origin_params : P, field_places : o(NEXT), fields : al1(shr(int(), P))));
  verdict("wf-outward-field", c, "ACCEPT");
});
// ---------------------------------------------------------------------------
// The return rule (O3, §5 route 1)
// ---------------------------------------------------------------------------
test("ret-local", {
  f := fun(u64(0), al1(prm(XS, shr(int(), ELIDED))), shr(int(), ELIDED), al2(let_(Y, lit()), Node.Return(Node.Borrow(false, Y))));
  verdict("ret-local", case2(entry(none()), f), "E0912");
});
test("ret-byvalue-param", {
  verdict("ret-byvalue-param", case2(entry(none()), sig(u64(0), al1(prm(V, int())), shr(int(), o(V)))), "E0912");
});
test("ret-param-place", {
  f := fun(u64(0), al1(prm(XS, shr(int(), ELIDED))), shr(int(), o(XS)), al1(Node.Return(Node.Reborrow(XS))));
  main := entry(al3(let_(X, lit()), let_(R, call(usize(1), al1(Node.Borrow(false, X)))), use_(Node.Var(R))));
  verdict("ret-param-place", case2(main, f), "ACCEPT");
});
test("words", {
  words := fun(
    u64(0),
    al1(prm(SELF, shr(int(), ELIDED))),
    list(shr(int(), o(SELF))),
    al4(let_(OUT, Node.NewList(shr(int(), o(SELF)))), Node.Push(OUT, Node.Reborrow(SELF)), Node.Push(OUT, Node.Reborrow(SELF)), Node.Return(Node.Var(OUT)))
  );
  main := entry(al4(let_(DOC, lit()), let_(W, call(usize(1), al1(Node.Borrow(false, DOC)))), use_(Node.Var(W)), Node.Assign(DOC, lit())));
  verdict("words", case2(main, words), "ACCEPT");
});
test("words-then-write", {
  words := fun(
    u64(0),
    al1(prm(SELF, shr(int(), ELIDED))),
    list(shr(int(), o(SELF))),
    al3(let_(OUT, Node.NewList(shr(int(), o(SELF)))), Node.Push(OUT, Node.Reborrow(SELF)), Node.Return(Node.Var(OUT)))
  );
  main := entry(al4(let_(DOC, lit()), let_(W, call(usize(1), al1(Node.Borrow(false, DOC)))), Node.Assign(DOC, lit()), use_(Node.Var(W))));
  verdict("words-then-write", case2(main, words), "E0911");
});
// ---------------------------------------------------------------------------
// Several `&mut` out of one lend (O3 step 2)
// ---------------------------------------------------------------------------
get2_mut :: (fn() -> FnDef)(sig(u64(0), al1(prm(SELF, exc(list(int()), ELIDED))), Ty.Tup(al2(exc(int(), o(SELF)), exc(int(), o(SELF))))));
test("get2-mut-pair", {
  main := entry(al4(let_(XS, Node.NewList(int())), let_(PAIR, call(usize(1), al1(Node.Borrow(true, XS)))), use_(Node.Field(PAIR, usize(0))), use_(Node.Field(PAIR, usize(1)))));
  verdict("get2-mut-pair", case2(main, get2_mut()), "ACCEPT");
});
test("get2-mut-twice", {
  main := entry(
    al4(
      let_(XS, Node.NewList(int())),
      let_(PAIR, call(usize(1), al1(Node.Borrow(true, XS)))),
      let_(D, call(usize(1), al1(Node.Borrow(true, XS)))),
      use_(Node.Field(PAIR, usize(0)))
    )
  );
  verdict("get2-mut-twice", case2(main, get2_mut()), "E0911");
});
/// `iter_mut(self : &mut List(i32)) -> Cursor(self)` and
/// `next(generic(p : Origin), self : &mut Cursor(p)) -> Option(&mut(i32, p))`.
iter_mut :: (fn() -> FnDef)(sig(u64(0), al1(prm(SELF, exc(list(int()), ELIDED))), Ty.Tup(al2(exc(list(int()), o(SELF)), int()))));
next :: (fn() -> FnDef)(sig(P, al1(prm(SELF, exc(Ty.Tup(al2(exc(list(int()), P), int())), ELIDED))), wrap(Kind.Some, exc(int(), P))));
test("cursor-two-items", {
  main := entry(
    al6(
      let_(XS, Node.NewList(int())),
      let_(IT, call(usize(1), al1(Node.Borrow(true, XS)))),
      let_(A, call(usize(2), al1(Node.Borrow(true, IT)))),
      let_(B, call(usize(2), al1(Node.Borrow(true, IT)))),
      use_(Node.Var(A)),
      use_(Node.Var(B))
    )
  );
  verdict("cursor-two-items", case3(main, iter_mut(), next()), "ACCEPT");
});
test("copy-mut-holder", {
  main := entry(al4(let_(XS, Node.NewList(int())), let_(IT, call(usize(1), al1(Node.Borrow(true, XS)))), let_(D, Node.Var(IT)), use_(Node.Var(IT))));
  verdict("copy-mut-holder", case2(main, iter_mut()), "E0901");
});
test("call-arg-overlap", {
  both := sig(u64(0), al2(prm(A, exc(list(int()), ELIDED)), prm(B, shr(list(int()), ELIDED))), int());
  main := entry(al2(let_(XS, Node.NewList(int())), use_(call(usize(1), al2(Node.Borrow(true, XS), Node.Borrow(false, XS))))));
  verdict("call-arg-overlap", case2(main, both), "E0910");
});
test("drop-root-while-borrowed", {
  main := entry(al4(let_(X, lit()), let_(R, Node.Borrow(false, X)), Node.Drop(X, false), use_(Node.Var(R))));
  verdict("drop-root-while-borrowed", case1(main), "E0911");
});
// ---------------------------------------------------------------------------
// Invariance through a `&mut` pointee or a `RefCell` (O3-3)
// ---------------------------------------------------------------------------
/// `store(generic(T, r), dst : &mut Option(&(T, r)), v : &(T, r))`.
store :: (fn() -> FnDef)(
  fun(
    P,
    al2(prm(DST, exc(wrap(Kind.Some, shr(int(), P)), ELIDED)), prm(V, shr(int(), P))),
    int(),
    al1(Node.WriteThrough(DST, Node.Make(Kind.Some, Node.Var(V))))
  )
);
store_main :: (fn(root : usize) -> FnDef)(
  entry(
    al4(
      let_(X, lit()),
      let_d(SLOT, Node.Make(Kind.Some, Node.Borrow(false, X)), wrap(Kind.Some, shr(int(), o(X)))),
      Node.Block(al2(let_(Y, lit()), use_(call(usize(1), al2(Node.Borrow(true, SLOT), Node.Borrow(false, root)))))),
      use_(Node.Var(SLOT))
    )
  )
);
test("store-widen-mut-pointee", {
  verdict("store-widen-mut-pointee", case2(store_main(Y), store()), "ORIGIN_MISMATCH");
});
test("store-same-origin", {
  verdict("store-same-origin", case2(store_main(X), store()), "ACCEPT");
});
store_widen_refcell :: (fn() -> Case)({
  store_cell := sig(P, al2(prm(CELL, shr(wrap(Kind.Cell, wrap(Kind.Some, shr(int(), P))), ELIDED)), prm(V, shr(int(), P))), int());
  main := entry(
    al4(
      let_(X, lit()),
      let_d(R, Node.Make(Kind.Cell, Node.Make(Kind.Some, Node.Borrow(false, X))), wrap(Kind.Cell, wrap(Kind.Some, shr(int(), o(X))))),
      Node.Block(al2(let_(Y, lit()), use_(call(usize(1), al2(Node.Borrow(false, R), Node.Borrow(false, Y)))))),
      use_(Node.Var(R))
    )
  );
  case2(main, store_cell)
});
test("store-widen-refcell", {
  verdict("store-widen-refcell", store_widen_refcell(), "ORIGIN_MISMATCH");
});
/// `swap(generic(T, r), a : &mut &(T, r), b : &mut &(T, r))`.
swap :: (fn() -> FnDef)(sig(P, al2(prm(A, exc(shr(int(), P), ELIDED)), prm(B, exc(shr(int(), P), ELIDED))), int()));
swap_main :: (fn(ta : u64, tb : u64) -> FnDef)(
  entry(
    al7(
      let_(X, lit()),
      let_(Y, lit()),
      let_d(RA, Node.Borrow(false, X), shr(int(), ta)),
      let_d(RB, Node.Borrow(false, Y), shr(int(), tb)),
      use_(call(usize(1), al2(Node.Borrow(true, RA), Node.Borrow(true, RB)))),
      use_(Node.Var(RA)),
      use_(Node.Var(RB))
    )
  )
);
test("swap-different-origins", {
  verdict("swap-different-origins", case2(swap_main(o(X), o(Y)), swap()), "ORIGIN_MISMATCH");
});
test("swap-inferred-locals", {
  main := entry(
    al7(
      let_(X, lit()),
      let_(Y, lit()),
      let_(RA, Node.Borrow(false, X)),
      let_(RB, Node.Borrow(false, Y)),
      use_(call(usize(1), al2(Node.Borrow(true, RA), Node.Borrow(true, RB)))),
      use_(Node.Var(RA)),
      use_(Node.Var(RB))
    )
  );
  verdict("swap-inferred-locals", case2(main, swap()), "ACCEPT");
});
test("swap-declared-union", {
  verdict("swap-declared-union", case2(swap_main(o(X) | o(Y), o(X) | o(Y)), swap()), "ACCEPT");
});
// ---------------------------------------------------------------------------
// Containers: declared unions (O6)
// ---------------------------------------------------------------------------
test("push-outside-union", {
  main := entry(
    al7(
      let_(X, lit()),
      let_(Y, lit()),
      let_(Z, lit()),
      let_(BOTH, Node.NewList(shr(int(), o(X) | o(Y)))),
      Node.Push(BOTH, Node.Borrow(false, X)),
      Node.Push(BOTH, Node.Borrow(false, Z)),
      use_(Node.Var(BOTH))
    )
  );
  verdict("push-outside-union", case1(main), "UNION");
});
test("push-inside-union", {
  main := entry(
    al7(
      let_(X, lit()),
      let_(Y, lit()),
      let_(BOTH, Node.NewList(shr(int(), o(X) | o(Y)))),
      Node.Push(BOTH, Node.Borrow(false, X)),
      Node.Assign(Y, lit()),
      Node.Push(BOTH, Node.Borrow(false, Y)),
      use_(Node.Var(BOTH))
    )
  );
  verdict("push-inside-union", case1(main), "ACCEPT");
});
test("push-elided-unrelated", {
  push_e := fun(u64(0), al2(prm(SELF, exc(list(shr(int(), ELIDED)), ELIDED)), prm(VALUE, shr(int(), ELIDED))), int(), al1(Node.Push(SELF, Node.Var(VALUE))));
  verdict("push-elided-unrelated", case2(entry(none()), push_e), "UNION");
});
/// `push(generic(T, r), self : &mut List(&(T, r)), value : &(T, r))`.
push_s :: (fn() -> FnDef)(fun(P, al2(prm(SELF, exc(list(shr(int(), P)), ELIDED)), prm(VALUE, shr(int(), P))), int(), al1(Node.Push(SELF, Node.Var(VALUE)))));
test("push-spelled-shared", {
  main := entry(al4(let_(X, lit()), let_(OUT, Node.NewList(shr(int(), o(X)))), use_(call(usize(1), al2(Node.Borrow(true, OUT), Node.Borrow(false, X)))), use_(Node.Var(OUT))));
  verdict("push-spelled-shared", case2(main, push_s()), "ACCEPT");
});
test("elided-container-lent-mut", {
  main := entry(
    al6(
      let_(X, lit()),
      let_(Y, lit()),
      let_(OUT, Node.NewList(shr(int(), ELIDED))),
      use_(call(usize(1), al2(Node.Borrow(true, OUT), Node.Borrow(false, X)))),
      Node.Assign(Y, lit()),
      use_(Node.Var(OUT))
    )
  );
  verdict("elided-container-lent-mut", case2(main, push_s()), "ACCEPT");
});
test("elided-container-lent-mut-then-write", {
  main := entry(
    al5(
      let_(X, lit()),
      let_(OUT, Node.NewList(shr(int(), ELIDED))),
      use_(call(usize(1), al2(Node.Borrow(true, OUT), Node.Borrow(false, X)))),
      Node.Assign(X, lit()),
      use_(Node.Var(OUT))
    )
  );
  verdict("elided-container-lent-mut-then-write", case2(main, push_s()), "E0911");
});
loop_join_push :: (fn() -> Case)(
  case1(
    entry(
      al4(
        let_(X, lit()),
        let_(OUT, Node.NewList(shr(int(), ELIDED))),
        Node.Loop(al2(Node.Assign(X, lit()), Node.Branch(al1(Node.Push(OUT, Node.Borrow(false, X))), none()))),
        use_(Node.Var(OUT))
      )
    )
  )
);
test("loop-join-push", {
  verdict("loop-join-push", loop_join_push(), "E0911");
});
test("loop-join-push-after", {
  main := entry(
    al5(
      let_(X, lit()),
      let_(OUT, Node.NewList(shr(int(), ELIDED))),
      Node.Loop(al1(Node.Branch(al1(Node.Push(OUT, Node.Borrow(false, X))), none()))),
      use_(Node.Var(OUT)),
      Node.Assign(X, lit())
    )
  );
  verdict("loop-join-push-after", case1(main), "ACCEPT");
});
drop_order_user_drop :: (fn() -> Case)(case1(entry(al3(let_(OUT, Node.Make(Kind.Guard, Node.NewList(shr(int(), ELIDED)))), let_(X, lit()), Node.Push(OUT, Node.Borrow(false, X))))));
test("drop-order-user-drop", {
  verdict("drop-order-user-drop", drop_order_user_drop(), "E0911");
});
test("drop-order-may-dangle", {
  main := entry(al3(let_(OUT, Node.NewList(shr(int(), ELIDED))), let_(X, lit()), Node.Push(OUT, Node.Borrow(false, X))));
  verdict("drop-order-may-dangle", case1(main), "ACCEPT");
});
// ---------------------------------------------------------------------------
// No-origin positions: `Escapable` (O4, O10)
// ---------------------------------------------------------------------------
test("spawn-box-origin", {
  main := entry(al3(let_(X, lit()), let_(B, Node.Make(Kind.Boxed, Node.Borrow(false, X))), Node.Spawn(Node.Var(B))));
  verdict("spawn-box-origin", case1(main), "E0909");
});
test("thread-send-origin", {
  main := entry(al3(let_(X, lit()), let_(CELL, Node.Make(Kind.Cell, Node.Borrow(false, X))), Node.Spawn(Node.Var(CELL))));
  verdict("thread-send-origin", case1(main), "E0909");
});
test("global-refcell-origin", {
  c := case1(entry(none()));
  c.globals.push(wrap(Kind.Cell, shr(int(), o(G))));
  verdict("global-refcell-origin", c, "E0909");
});
test("extern-box-origin", {
  ext := FnDef(origin_params : P, type_params : usize(0), escapable : false, params : al1(prm(V, wrap(Kind.Boxed, shr(int(), P)))), result : int(), body : .None, is_extern : true);
  verdict("extern-box-origin", case2(entry(none()), ext), "E0909");
});
// ---------------------------------------------------------------------------
// `Rc`: the handle-origin rule (O9) and the `Escapable` payload (O10)
// ---------------------------------------------------------------------------
test("rc-mut-through-deref", {
  bump := sig(u64(0), al1(prm(V, exc(int(), ELIDED))), int());
  main := entry(al2(let_(H, Node.Make(Kind.Rc, lit())), use_(call(usize(1), al1(Node.HandleBorrow(true, H))))));
  verdict("rc-mut-through-deref", case2(main, bump), "E0919");
});
rc_handle_dropped :: (fn() -> Case)(case1(entry(al4(let_(H, Node.Make(Kind.Rc, lit())), let_(R, Node.HandleBorrow(false, H)), Node.Drop(H, false), use_(Node.Var(R))))));
test("rc-handle-dropped", {
  verdict("rc-handle-dropped", rc_handle_dropped(), "E0911");
});
test("rc-handle-reassigned", {
  main := entry(al4(let_(H, Node.Make(Kind.Rc, lit())), let_(R, Node.HandleBorrow(false, H)), Node.Assign(H, Node.Make(Kind.Rc, lit())), use_(Node.Var(R))));
  verdict("rc-handle-reassigned", case1(main), "E0911");
});
test("rc-push-handle-borrow", {
  main := entry(al4(let_(H, Node.Make(Kind.Rc, lit())), let_(OUT, Node.NewList(shr(int(), o(H)))), Node.Push(OUT, Node.HandleBorrow(false, H)), use_(Node.Var(OUT))));
  verdict("rc-push-handle-borrow", case1(main), "ACCEPT");
});
test("rc-of-ref-holder", {
  main := entry(al3(let_(X, lit()), let_(V, Node.MakeTup(al2(Node.Borrow(false, X), lit()))), let_(R, Node.Make(Kind.Rc, Node.Var(V)))));
  verdict("rc-of-ref-holder", case1(main), "E0909");
});
/// `borrow_mut(self : &RefCell(i32)) -> RefMut(self)`: a guard holding the
/// lent `&` place.
borrow_mut :: (fn() -> FnDef)(sig(u64(0), al1(prm(SELF, shr(wrap(Kind.Cell, int()), ELIDED))), wrap(Kind.Guard, shr(wrap(Kind.Cell, int()), o(SELF)))));
rc_guard_main :: (fn(dropped : usize) -> FnDef)(
  entry(
    al5(
      let_(H, Node.Make(Kind.Rc, Node.Make(Kind.Cell, lit()))),
      let_(H2, Node.Var(H)),
      let_(G, call(usize(1), al1(Node.HandleBorrow(false, H)))),
      Node.Drop(dropped, false),
      use_(Node.Var(G))
    )
  )
);
test("rc-guard-and-clone", {
  verdict("rc-guard-and-clone", case2(rc_guard_main(H2), borrow_mut()), "ACCEPT");
});
test("rc-guard-handle-dropped", {
  verdict("rc-guard-handle-dropped", case2(rc_guard_main(H), borrow_mut()), "E0911");
});
/// `wrap(generic(T : Type), v : T) -> Rc(T)`, with and without
/// `where(T <: Escapable)`.
wrap_rc :: (fn(bounded : bool) -> FnDef)(
  FnDef(
    origin_params : u64(0),
    type_params : usize(1),
    escapable : bounded,
    params : al1(prm(V, Ty.TParam(usize(0)))),
    result : wrap(Kind.Rc, Ty.TParam(usize(0))),
    body : .Some(al1(Node.Return(Node.Make(Kind.Rc, Node.Var(V))))),
    is_extern : false
  )
);
test("generic-unbounded-rc", {
  main := entry(al2(let_(X, lit()), let_(R, call(usize(1), al1(Node.Borrow(false, X))))));
  verdict("generic-unbounded-rc", case2(main, wrap_rc(false)), "E0909@spec");
});
test("generic-bounded-rc", {
  main := entry(al2(let_(X, lit()), let_(R, call(usize(1), al1(Node.Borrow(false, X))))));
  verdict("generic-bounded-rc", case2(main, wrap_rc(true)), "E0909");
});
test("generic-escapable-rc", {
  main := entry(al1(let_(R, call(usize(1), al1(lit())))));
  verdict("generic-escapable-rc", case2(main, wrap_rc(true)), "ACCEPT");
});
// ---------------------------------------------------------------------------
// Closures (O2's per-call parameter origin, O7's capture origins)
// ---------------------------------------------------------------------------
/// `Fn(&i32) -> R` capturing `caps`.
fn_t :: (fn(result : Ty, caps : u64) -> Ty)(Ty.Func(shr(int(), FNQ), result, caps, u64(0)));
closure :: (fn(caps : ArrayList(Node), body : ArrayList(Node), result : Node) -> Node)(Node.Closure(E, shr(int(), ELIDED), caps, body, result));
/// `register(generic(r : Origin), reg : &mut List(Fn(&i32) -> i32 + r), f : Fn(&i32) -> i32 + r)`.
register :: (fn() -> FnDef)(sig(P, al2(prm(REG, exc(list(fn_t(int(), P)), ELIDED)), prm(V, fn_t(int(), P))), int()));
register_main :: (fn(captured : usize) -> FnDef)(
  entry(
    al5(
      let_(X, lit()),
      let_(Y, lit()),
      let_(REG, Node.NewList(fn_t(int(), o(X)))),
      use_(call(usize(1), al2(Node.Borrow(true, REG), closure(al1(let_(captured, Node.Borrow(false, captured))), none(), lit())))),
      use_(Node.Var(REG))
    )
  )
);
test("closure-caps-exceed-slot", {
  verdict("closure-caps-exceed-slot", case2(register_main(Y), register()), "ORIGIN_MISMATCH");
});
test("closure-caps-within-slot", {
  verdict("closure-caps-within-slot", case2(register_main(X), register()), "ACCEPT");
});
/// `apply(f : Fn(&i32) -> &i32, v : &i32)`: the result origin is the
/// per-call parameter origin.
apply :: (fn() -> FnDef)(sig(u64(0), al2(prm(F, fn_t(shr(int(), FNQ), ELIDED)), prm(V, shr(int(), ELIDED))), int()));
F :: usize(17);
apply_main :: (fn(result : Node) -> FnDef)(
  entry(al3(let_(X, lit()), let_(Y, lit()), use_(call(usize(1), al2(closure(al1(let_(Y, Node.Borrow(false, Y))), none(), result), Node.Borrow(false, X))))))
);
test("closure-returns-capture", {
  verdict("closure-returns-capture", case2(apply_main(Node.Var(Y)), apply()), "ORIGIN_MISMATCH");
});
test("closure-returns-param", {
  verdict("closure-returns-param", case2(apply_main(Node.Var(E)), apply()), "ACCEPT");
});
/// `each(f : Fn(&i32) -> i32)`.
each :: (fn() -> FnDef)(sig(u64(0), al1(prm(F, Ty.Func(shr(int(), FNQ), int(), ELIDED, u64(0)))), int()));
test("closure-param-into-capture", {
  main := entry(
    al4(
      let_(X, lit()),
      let_(OUT, Node.NewList(shr(int(), o(X)))),
      use_(call(usize(1), al1(closure(al1(let_(OUT, Node.Borrow(true, OUT))), al1(Node.Push(OUT, Node.Var(E))), lit())))),
      use_(Node.Var(OUT))
    )
  );
  verdict("closure-param-into-capture", case2(main, each()), "UNION");
});
closure_push_main :: (fn(written : usize) -> FnDef)(
  entry(
    al6(
      let_(X, lit()),
      let_(Y, lit()),
      let_(OUT, Node.NewList(shr(int(), ELIDED))),
      use_(call(usize(1), al1(closure(al2(let_(OUT, Node.Borrow(true, OUT)), let_(X, Node.Borrow(false, X))), al1(Node.Push(OUT, Node.Var(X))), lit())))),
      Node.Assign(written, lit()),
      use_(Node.Var(OUT))
    )
  )
);
test("closure-push-capture", {
  verdict("closure-push-capture", case2(closure_push_main(Y), each()), "ACCEPT");
});
test("closure-push-capture-then-write", {
  verdict("closure-push-capture-then-write", case2(closure_push_main(X), each()), "E0911");
});
// ---------------------------------------------------------------------------
// Futures (O5, O8)
// ---------------------------------------------------------------------------
cold_start_main :: (fn(await_first : bool) -> FnDef)({
  fut := let_(FUT, Node.Async(al1(let_(X, Node.Borrow(true, X)))));
  entry(
    cond(
      await_first => al4(let_(X, lit()), fut, use_(Node.Var(FUT)), Node.Assign(X, lit())),
      true => al4(let_(X, lit()), fut, Node.Assign(X, lit()), use_(Node.Var(FUT)))
    )
  )
});
test("async-cold-start-write", {
  verdict("async-cold-start-write", case1(cold_start_main(false)), "E0911");
});
test("async-cold-start-await-first", {
  verdict("async-cold-start-await-first", case1(cold_start_main(true)), "ACCEPT");
});
test("async-forward-local", {
  g := fun(u64(0), no_params(), Ty.Fut(u64(0), u64(0)), al2(let_(Y, lit()), Node.Return(Node.Async(al1(let_(Y, Node.Borrow(false, Y)))))));
  verdict("async-forward-local", case2(entry(none()), g), "E0912");
});
/// `bump(c : &mut i32) -> Future(unit, c)`, forwarding its lent place.
bump_fut :: (fn() -> FnDef)(fun(u64(0), al1(prm(C, exc(int(), ELIDED))), Ty.Fut(u64(0), o(C)), al1(Node.Return(Node.Async(al1(let_(C, Node.Var(C))))))));
test("async-forward-param", {
  main := entry(al4(let_(X, lit()), let_(FUT, call(usize(1), al1(Node.Borrow(true, X)))), use_(Node.Var(FUT)), use_(Node.Var(X))));
  verdict("async-forward-param", case2(main, bump_fut()), "ACCEPT");
});
test("await-local-borrow", {
  outer := fun(u64(0), no_params(), int(), al4(let_(D, lit()), let_(INNER, call(usize(1), al1(Node.Borrow(true, D)))), use_(Node.Var(INNER)), Node.Return(Node.Var(D))));
  verdict("await-local-borrow", case3(entry(al1(use_(call0(usize(2))))), bump_fut(), outer), "ACCEPT");
});
// ---------------------------------------------------------------------------
// An impl checked against its trait's signature (O7), and a call through
// `Dyn` mapped from the trait's signature (§5 route 5)
// ---------------------------------------------------------------------------
pick :: (fn(result : Ty, returned : usize) -> FnDef)(fun(u64(0), al2(prm(SELF, shr(int(), ELIDED)), prm(OTHER, shr(int(), ELIDED))), result, al1(Node.Return(Node.Var(returned)))));
test("impl-wider-than-trait", {
  verdict("impl-wider-than-trait", case2(entry(none()), pick(shr(int(), o(SELF)), OTHER)), "ORIGIN_MISMATCH");
});
test("impl-narrower-than-trait", {
  verdict("impl-narrower-than-trait", case2(entry(none()), pick(shr(int(), ELIDED), SELF)), "ACCEPT");
});
/// The trait method `pick(self : &Self, other : &i32) -> result` that a
/// `Dyn(_Pick)` call dispatches on: the caller sees only this signature.
pick_sig :: (fn(result : Ty) -> FnDef)(sig(u64(0), al2(prm(SELF, shr(int(), ELIDED)), prm(OTHER, shr(int(), ELIDED))), result));
dyn_call_main :: (fn() -> FnDef)(
  entry(al5(let_(D, lit()), let_(X, lit()), let_(R, call(usize(1), al2(Node.Borrow(false, D), Node.Borrow(false, X)))), Node.Assign(X, lit()), use_(Node.Var(R))))
);
test("dyn-call-elided-result", {
  verdict("dyn-call-elided-result", case2(dyn_call_main(), pick_sig(shr(int(), ELIDED))), "E0911");
});
test("dyn-call-spelled-result", {
  verdict("dyn-call-spelled-result", case2(dyn_call_main(), pick_sig(shr(int(), o(SELF)))), "ACCEPT");
});
// ---------------------------------------------------------------------------
// The effect-handler and macro lowerings (§4). The model has no handler or
// macro node: a handler is checked as what it is, a function literal with the
// operation's signature (`ask(key : &i32) -> &(i32, key)`) or, when it
// captures, a closure passed to a slot of that signature; a macro row is its
// expansion. Walking the lowering is the compiler's part, which N1's gate
// tests with the fixture.
// ---------------------------------------------------------------------------
/// `use(ask : Fn(key : &i32) -> &(i32, key))`.
ask_use :: (fn() -> FnDef)(sig(u64(0), al1(prm(F, fn_t(shr(int(), FNQ), ELIDED))), int()));
ask_main :: (fn(result : Node) -> FnDef)(
  entry(al2(let_(X, lit()), use_(call(usize(1), al1(closure(al1(let_(X, Node.Borrow(false, X))), none(), result))))))
);
test("effect-resume-local", {
  handler := fun(u64(0), al1(prm(E, shr(int(), ELIDED))), shr(int(), o(E)), al2(let_(Y, lit()), Node.Return(Node.Borrow(false, Y))));
  verdict("effect-resume-local", case2(entry(none()), handler), "E0912");
});
test("effect-resume-capture", {
  verdict("effect-resume-capture", case2(ask_main(Node.Var(X)), ask_use()), "ORIGIN_MISMATCH");
});
test("effect-resume-param", {
  verdict("effect-resume-param", case2(ask_main(Node.Var(E)), ask_use()), "ACCEPT");
});
test("macro-ret-local", {
  f := fun(u64(0), al1(prm(XS, shr(int(), ELIDED))), shr(int(), ELIDED), al1(Node.Block(al2(let_(Y, lit()), Node.Return(Node.Borrow(false, Y))))));
  verdict("macro-ret-local", case2(entry(none()), f), "E0912");
});
// ---------------------------------------------------------------------------
// The superseded design's rows restated (§8 "N0 as built" maps the rest)
// ---------------------------------------------------------------------------
test("index-mut-twice", {
  // An index place is its root's place: the model has no paths, which is the
  // rule (index places on one root overlap, decision 28).
  main := entry(
    al5(
      let_(XS, Node.NewList(int())),
      let_(A, Node.Borrow(true, XS)),
      let_(B, Node.Borrow(true, XS)),
      Node.WriteThrough(A, lit()),
      Node.WriteThrough(B, lit())
    )
  );
  verdict("index-mut-twice", case1(main), "E0911");
});
test("place-write-join", {
  // `out(0) = &x` is encoded as the push it joins like.
  main := entry(
    al7(
      let_(Z, lit()),
      let_(X, lit()),
      let_(OUT, Node.NewList(shr(int(), o(X) | o(Z)))),
      Node.Push(OUT, Node.Borrow(false, Z)),
      Node.Push(OUT, Node.Borrow(false, X)),
      Node.Assign(X, lit()),
      use_(Node.Var(OUT))
    )
  );
  verdict("place-write-join", case1(main), "E0911");
});
test("match-arm-binding-origin", {
  // The arm binding `r` is the payload moved out of the consumed scrutinee.
  main := entry(al5(let_(X, lit()), let_(V, Node.Make(Kind.Some, Node.Borrow(false, X))), let_(R, Node.Var(V)), Node.Assign(X, lit()), use_(Node.Var(R))));
  verdict("match-arm-binding-origin", case1(main), "E0911");
});
test("list-mut-two-pushes", {
  main := entry(
    al5(
      let_(X, lit()),
      let_(OUT, Node.NewList(exc(int(), o(X)))),
      Node.Push(OUT, Node.Borrow(true, X)),
      Node.Push(OUT, Node.Borrow(true, X)),
      use_(Node.Var(OUT))
    )
  );
  verdict("list-mut-two-pushes", case1(main), "E0911");
});
test("copy-shared-holder", {
  main := entry(al5(let_(X, lit()), let_(V, Node.MakeTup(al2(Node.Borrow(false, X), lit()))), let_(W, Node.Var(V)), use_(Node.Var(V)), use_(Node.Var(W))));
  verdict("copy-shared-holder", case1(main), "ACCEPT");
});
test("ret-byvalue-carried", {
  first := fun(P, al1(prm(V, Ty.Tup(al2(shr(int(), P), int())))), shr(int(), P), al1(Node.Return(Node.Field(V, usize(0)))));
  main := entry(al3(let_(X, lit()), let_(R, call(usize(1), al1(Node.MakeTup(al2(Node.Borrow(false, X), lit()))))), use_(Node.Var(R))));
  verdict("ret-byvalue-carried", case2(main, first), "ACCEPT");
});
// ---------------------------------------------------------------------------
// Each hole row tests its rule: with that rule switched off, the model
// accepts the row (a mutant the row kills). A row that still failed would be
// rejected for some other reason.
// ---------------------------------------------------------------------------
/// Asserts the ablated model's verdict on a negative row.
flips :: (fn(id : str, c : Case, rule : u64, want : str) -> unit)({
  ck := check_ablated(c, rule);
  println(`${id} without rule ${rule}: ${ck.err} (${ck.why})`);
  assert(ck.err == String.from(want), `${id}: with rule ${rule} off the model says ${ck.err} (${ck.why}), expected ${want}`);
});
test("ablation: invariance through a &mut pointee or a RefCell (O3-3)", {
  flips("store-widen-mut-pointee", case2(store_main(Y), store()), ABLATE_INVARIANCE, "ACCEPT");
  flips("store-widen-refcell", store_widen_refcell(), ABLATE_INVARIANCE, "ACCEPT");
  flips("swap-different-origins", case2(swap_main(o(X), o(Y)), swap()), ABLATE_INVARIANCE, "ACCEPT");
  flips("closure-caps-exceed-slot", case2(register_main(Y), register()), ABLATE_INVARIANCE, "ACCEPT");
});
test("ablation: the loop fixpoint over the back edge", {
  flips("loop-join-push", loop_join_push(), ABLATE_LOOP_FIXPOINT, "ACCEPT");
});
test("ablation: a user Drop keeps its roots live", {
  flips("drop-order-user-drop", drop_order_user_drop(), ABLATE_USER_DROP, "ACCEPT");
});
test("ablation: a &mut capture grows the container's flow set", {
  flips("closure-push-capture-then-write", case2(closure_push_main(X), each()), ABLATE_CAPTURE_WIDEN, "ACCEPT");
});
test("ablation: a borrow through an Rc deref carries the handle's place (O9)", {
  flips("rc-handle-dropped", rc_handle_dropped(), ABLATE_HANDLE_ORIGIN, "ACCEPT");
  flips("rc-guard-handle-dropped", case2(rc_guard_main(H), borrow_mut()), ABLATE_HANDLE_ORIGIN, "ACCEPT");
});
