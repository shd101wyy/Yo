      let_d(R, Rc.new(NodeE.Borrow(false, X)), shr(int(), o(X))),
      Rc.new(NodeE.Block(al2(let_(Y, lit()), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, R)), Rc.new(NodeE.Borrow(false, Y)))))))),
      use_(Rc.new(NodeE.Var(R)))
    )
  );
  verdict("ref-mut-ref-store-narrower-declared", case2(main, set_s()), "ORIGIN_MISMATCH");
});
