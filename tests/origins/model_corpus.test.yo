});
test("generic-rigid-origin", {
  // A generic body valid only under its first caller's substitution: the
  // body stores `b : &(i32, q)` into `dst : &mut Option(&(i32, p))` and is
  // checked with `p` and `q` rigid.
  body := fun(
    (P | Q),
    al3(prm(A, shr(int(), P)), prm(B, shr(int(), Q)), prm(DST, exc(wrap(Kind.Some, shr(int(), P)), ELIDED))),
    int(),
    al1(Rc.new(NodeE.WriteThrough(DST, Rc.new(NodeE.Make(Kind.Some, Rc.new(NodeE.Var(B)))))))
  );
  main := entry(
    al4(
      let_(X, lit()),
      let_d(SLOT, lit(), wrap(Kind.Some, shr(int(), o(X)))),
      use_(call(usize(1), al3(Rc.new(NodeE.Borrow(false, X)), Rc.new(NodeE.Borrow(false, X)), Rc.new(NodeE.Borrow(true, SLOT))))),
      use_(Rc.new(NodeE.Var(SLOT)))
    )
  );
  verdict("generic-rigid-origin", case2(main, body), "ORIGIN_MISMATCH");
});
// ---------------------------------------------------------------------------
// Each hole row tests its rule: with that rule switched off, the model
// accepts the row (a mutant the row kills). A row that still failed would be
// rejected for some other reason.
// ---------------------------------------------------------------------------
/// Asserts the ablated model's verdict on a negative row.
flips :: (fn(id : str, c : Case, rule : u64, want : str) -> unit)({
  ck := check_ablated(c, rule);
  println(`${id} without rule ${rule}: ${ck.err} (${ck.why})`);
  assert(ck.err == String.from(want), `${id}: with rule ${rule} off the model says ${ck.err} (${ck.why}), expected ${want}`);
});
test("ablation: invariance through a &mut pointee or a RefCell (O3-3)", {
  flips("store-widen-mut-pointee", case2(store_main(Y), store()), ABLATE_INVARIANCE, "ACCEPT");
  flips("store-widen-refcell", store_widen_refcell(), ABLATE_INVARIANCE, "ACCEPT");
  flips("swap-different-origins", case2(swap_main(o(X), o(Y)), swap()), ABLATE_INVARIANCE, "ACCEPT");
  flips("closure-caps-exceed-slot", case2(register_main(Y), register()), ABLATE_INVARIANCE, "ACCEPT");
});
test("ablation: the loop fixpoint over the back edge", {
  flips("loop-join-push", loop_join_push(), ABLATE_LOOP_FIXPOINT, "ACCEPT");
});
test("ablation: a user Drop keeps its roots live", {
  flips("drop-order-user-drop", drop_order_user_drop(), ABLATE_USER_DROP, "ACCEPT");
});
test("ablation: a &mut capture grows the container's flow set", {
  flips("closure-push-capture-then-write", case2(closure_push_main(X), each()), ABLATE_CAPTURE_WIDEN, "ACCEPT");
});
// Cluster 4 (plans/backlog/BORROW_CHECKER_COMPLETENESS.md §3 `bind`: the join over
// reaching definitions, including the loop back edge; audit A18, A19a, A19b).
some_lend :: (fn(p : usize) -> Node)(Rc.new(NodeE.Make(Kind.Some, Rc.new(NodeE.Borrow(false, p)))));
test("holder-assigned-in-both-arms-then-first-root-written", {
  main := entry(
    al7(
      let_(Z, lit()),
      let_(X, lit()),
      let_(Y, lit()),
      let_(H, some_lend(Z)),
      Rc.new(NodeE.Branch(al1(Rc.new(NodeE.Assign(H, some_lend(X)))), al1(Rc.new(NodeE.Assign(H, some_lend(Y)))))),
      Rc.new(NodeE.Assign(X, lit())),
      use_(Rc.new(NodeE.Var(H)))
    )
  );
  verdict("holder-assigned-in-both-arms-then-first-root-written", case1(main), "E0911");
});
test("loop-store-body-local-read-next", {
  main := entry(al3(let_(Z, lit()), let_(SLOT, some_lend(Z)), Rc.new(NodeE.Loop(al1(Rc.new(NodeE.Block(al3(use_(Rc.new(NodeE.Var(SLOT))), let_(Y, lit()), Rc.new(NodeE.Assign(SLOT, some_lend(Y)))))))))));
  verdict("loop-store-body-local-read-next", case1(main), "E0911");
});
