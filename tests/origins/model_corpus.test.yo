set_s :: (fn() -> FnDef)(sig(P, al2(prm(A, exc(shr(int(), P), ELIDED)), prm(B, shr(int(), P))), int()));
test("ref-mut-ref-store-narrower", {
  // `set(&mut r, &inner)` through `dst : &mut &(T, p)`: the solved origin {inner} is written back into the inferred `r`, which is read after `inner` dies.
  main := entry(
    al4(
      let_(X, lit()),
      let_(R, Rc.new(NodeE.Borrow(false, X))),
      Rc.new(NodeE.Block(al2(let_(Y, lit()), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, R)), Rc.new(NodeE.Borrow(false, Y)))))))),
      use_(Rc.new(NodeE.Var(R)))
    )
  );
  verdict("ref-mut-ref-store-narrower", case2(main, set_s()), "E0911");
});
test("ref-mut-ref-store-narrower-declared", {
