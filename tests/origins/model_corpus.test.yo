test("ref-mut-ref-store-chain2", {
  // `set(&mut rpp.*.*, &inner)` with `rp := &mut r`, `rpp := &mut rp`: the store lands in `r`, the binding the re-borrow chain ends at, which is read after `inner` dies.
  main := entry(
    al5(
      let_(X, lit()),
      let_(R, Rc.new(NodeE.Borrow(false, X))),
      let_(RP, Rc.new(NodeE.Borrow(true, R))),
      Rc.new(NodeE.Block(al3(let_(Y, lit()), let_(RR, Rc.new(NodeE.Borrow(true, RP))), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, R)), Rc.new(NodeE.Borrow(false, Y)))))))),
      use_(Rc.new(NodeE.Var(R)))
    )
  );
  verdict("ref-mut-ref-store-chain2", case2(main, set_s()), "E0911");
});
test("ref-mut-ref-store-chain3", {
  // The same store through `rppp := &mut rpp` (depth 3).
