test("copy-shared-holder", {
  main := entry(al5(let_(X, lit()), let_(V, Rc.new(NodeE.MakeTup(al2(Rc.new(NodeE.Borrow(false, X)), lit())))), let_(W, Rc.new(NodeE.Var(V))), use_(Rc.new(NodeE.Var(V))), use_(Rc.new(NodeE.Var(W)))));
