// Decision 43's N0 gate (plans/backlog/REFERENCES_AND_ORIGINS.md §8): every
// row of the negative-test corpus, encoded in the reference checker's toy
// language (tests/origins/model.yo), must get the verdict
// tests/origins/corpus.tsv records for it — `ACCEPT` for a positive control,
// the code of the rule that rejects it for a negative row. The Yo spelling
// of each row is tests/origins/corpus/<id>.yo; scripts/origins-corpus.sh runs
// those through the compiler and cross-checks this file's ids and codes
// against the manifest.
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{
  bit,
  FNQ,
  ELIDED,
  Kind,
  TyE,
  Ty,
  NodeE,
  Node,
  Param,
  FnDef,
  TypeDef,
  Case,
  check_case,
  check_ablated,
  ABLATE_INVARIANCE,
  ABLATE_LOOP_FIXPOINT,
  ABLATE_USER_DROP,
  ABLATE_CAPTURE_WIDEN,
  ABLATE_HANDLE_ORIGIN
} :: import("./model.yo");
/// `alK(e1, …, eK)`: a list of K elements, built by pushes. Macro plan B3
/// deleted the `array_list(...)` literal, and its replacement,
/// `ArrayList(T).from([…])`, cannot take these elements yet: an array literal
/// of enum variants built from runtime values emits invalid C
/// (issues/2026-10-20-an-array-or-tuple-literal-whose-element-holds-a-runtime-field-emits-invalid-c.md).
al1 :: (fn(generic(T : Type), a : T) -> ArrayList(T))({
  mut(out) := ArrayList(T).with_capacity(usize(1));
  out.push(a);
  out
});
al2 :: (fn(generic(T : Type), a : T, b : T) -> ArrayList(T))({
  mut(out) := ArrayList(T).with_capacity(usize(2));
  out.push(a);
  out.push(b);
  out
});
al3 :: (fn(generic(T : Type), a : T, b : T, c : T) -> ArrayList(T))({
  mut(out) := ArrayList(T).with_capacity(usize(3));
  out.push(a);
  out.push(b);
  out.push(c);
  out
});
al4 :: (fn(generic(T : Type), a : T, b : T, c : T, d : T) -> ArrayList(T))({
  mut(out) := ArrayList(T).with_capacity(usize(4));
  out.push(a);
  out.push(b);
  out.push(c);
  out.push(d);
  out
});
al5 :: (fn(generic(T : Type), a : T, b : T, c : T, d : T, e : T) -> ArrayList(T))({
  mut(out) := ArrayList(T).with_capacity(usize(5));
  out.push(a);
  out.push(b);
  out.push(c);
  out.push(d);
  out.push(e);
  out
});
al6 :: (fn(generic(T : Type), a : T, b : T, c : T, d : T, e : T, f : T) -> ArrayList(T))({
  mut(out) := ArrayList(T).with_capacity(usize(6));
  out.push(a);
  out.push(b);
  out.push(c);
  out.push(d);
  out.push(e);
  out.push(f);
  out
});
al7 :: (fn(generic(T : Type), a : T, b : T, c : T, d : T, e : T, f : T, g : T) -> ArrayList(T))({
  mut(out) := ArrayList(T).with_capacity(usize(7));
  out.push(a);
  out.push(b);
  out.push(c);
  out.push(d);
  out.push(e);
  out.push(f);
  out.push(g);
  out
});
// Places: a case uses each at most once.
X :: usize(0);
Y :: usize(1);
Z :: usize(2);
XS :: usize(3);
OUT :: usize(4);
SLOT :: usize(5);
H :: usize(6);
H2 :: usize(7);
G :: usize(8);
RA :: usize(9);
RB :: usize(10);
A :: usize(11);
B :: usize(12);
PAIR :: usize(13);
IT :: usize(14);
D :: usize(15);
C :: usize(16);
FUT :: usize(18);
V :: usize(19);
SELF :: usize(20);
VALUE :: usize(21);
DST :: usize(22);
E :: usize(23);
CELL :: usize(24);
R :: usize(25);
INNER :: usize(26);
OTHER :: usize(27);
BOTH :: usize(28);
DOC :: usize(29);
W :: usize(30);
REG :: usize(32);
NEXT :: usize(33);
M :: usize(34);
T :: usize(35);
O :: usize(36);
K :: usize(37);
RR :: usize(38);
RP :: usize(39);
/// The first declared origin parameter `p`.
P :: (u64(1) << u64(40));
/// The second declared origin parameter `q` (`generic-rigid-origin`).
Q :: (u64(2) << u64(40));
o :: (fn(p : usize) -> u64)(bit(p));
// Types.
int :: (fn() -> Ty)(Rc.new(TyE.Int));
shr :: (fn(t : Ty, origin : u64) -> Ty)(Rc.new(TyE.Ref(false, t, origin)));
exc :: (fn(t : Ty, origin : u64) -> Ty)(Rc.new(TyE.Ref(true, t, origin)));
list :: (fn(t : Ty) -> Ty)(Rc.new(TyE.List(t)));
wrap :: (fn(k : Kind, t : Ty) -> Ty)(Rc.new(TyE.Wrap(k, t)));
// Programs.
none :: (fn() -> ArrayList(Node))(ArrayList(Node).new());
let_ :: (fn(p : usize, init : Node) -> Node)(Rc.new(NodeE.Let(p, init, .None)));
let_d :: (fn(p : usize, init : Node, decl : Ty) -> Node)(Rc.new(NodeE.Let(p, init, .Some(decl))));
lit :: (fn() -> Node)(Rc.new(NodeE.Lit));
call :: (fn(f : usize, args : ArrayList(Node)) -> Node)(Rc.new(NodeE.Call(f, args)));
call0 :: (fn(f : usize) -> Node)(Rc.new(NodeE.Call(f, ArrayList(Node).new())));
use_ :: (fn(e : Node) -> Node)(Rc.new(NodeE.Use(e)));
prm :: (fn(p : usize, t : Ty) -> Param)(Param(p : p, ty : t));
no_params :: (fn() -> ArrayList(Param))(ArrayList(Param).new());
/// The entry function: no parameters, a body.
entry :: (fn(body : ArrayList(Node)) -> FnDef)(
  FnDef(origin_params : u64(0), type_params : usize(0), escapable : false, params : ArrayList(Param).new(), result : Rc.new(TyE.Int), body : .Some(body), is_extern : false)
);
/// A function with a body.
fun :: (fn(origins : u64, params : ArrayList(Param), result : Ty, body : ArrayList(Node)) -> FnDef)(
  FnDef(origin_params : origins, type_params : usize(0), escapable : false, params : params, result : result, body : .Some(body), is_extern : false)
);
/// A signature whose body the model does not see (an `AllowUnsafe` std
/// body, a trait method).
sig :: (fn(origins : u64, params : ArrayList(Param), result : Ty) -> FnDef)(
  FnDef(origin_params : origins, type_params : usize(0), escapable : false, params : params, result : result, body : .None, is_extern : false)
);
case1 :: (fn(f0 : FnDef) -> Case)(Case(fns : al1(f0), globals : ArrayList(Ty).new(), types : ArrayList(TypeDef).new()));
case2 :: (fn(f0 : FnDef, f1 : FnDef) -> Case)(Case(fns : al2(f0, f1), globals : ArrayList(Ty).new(), types : ArrayList(TypeDef).new()));
case3 :: (fn(f0 : FnDef, f1 : FnDef, f2 : FnDef) -> Case)(Case(fns : al3(f0, f1, f2), globals : ArrayList(Ty).new(), types : ArrayList(TypeDef).new()));
/// Asserts the model's verdict on a case.
verdict :: (fn(id : str, c : Case, want : str) -> unit)({
  ck := check_case(c);
  println(`${id}: ${ck.err} (${ck.why})`);
  assert(ck.err == String.from(want), `${id}: the model says ${ck.err} (${ck.why}), the manifest says ${want}`);
});
// ---------------------------------------------------------------------------
// O1 well-formedness
// ---------------------------------------------------------------------------
test("wf-self-binding", {
  t := list(shr(int(), o(XS)));
  verdict("wf-self-binding", case1(entry(al1(let_d(XS, Rc.new(NodeE.NewList(shr(int(), o(XS)))), t)))), "WF_SELF");
});
test("wf-self-field", {
  mut(c) := case1(entry(none()));
  c.types.push(TypeDef(origin_params : u64(0), field_places : o(NEXT), fields : al1(shr(int(), o(NEXT)))));
  verdict("wf-self-field", c, "WF_SELF");
});
test("wf-undeclared-origin", {
  verdict("wf-undeclared-origin", case2(entry(none()), sig(u64(0), al1(prm(V, shr(int(), P))), int())), "WF_UNDECLARED");
});
test("wf-outward-field", {
  mut(c) := case1(entry(none()));
  c.types.push(TypeDef(origin_params : P, field_places : o(NEXT), fields : al1(shr(int(), P))));
  verdict("wf-outward-field", c, "ACCEPT");
});
// ---------------------------------------------------------------------------
// The return rule (O3, §5 route 1)
// ---------------------------------------------------------------------------
test("ret-local", {
  f := fun(u64(0), al1(prm(XS, shr(int(), ELIDED))), shr(int(), ELIDED), al2(let_(Y, lit()), Rc.new(NodeE.Return(Rc.new(NodeE.Borrow(false, Y))))));
  verdict("ret-local", case2(entry(none()), f), "E0912");
});
test("ret-byvalue-param", {
  verdict("ret-byvalue-param", case2(entry(none()), sig(u64(0), al1(prm(V, int())), shr(int(), o(V)))), "E0912");
});
test("ret-param-place", {
  f := fun(u64(0), al1(prm(XS, shr(int(), ELIDED))), shr(int(), o(XS)), al1(Rc.new(NodeE.Return(Rc.new(NodeE.Reborrow(XS))))));
  main := entry(al3(let_(X, lit()), let_(R, call(usize(1), al1(Rc.new(NodeE.Borrow(false, X))))), use_(Rc.new(NodeE.Var(R)))));
  verdict("ret-param-place", case2(main, f), "ACCEPT");
});
test("words", {
  words := fun(
    u64(0),
    al1(prm(SELF, shr(int(), ELIDED))),
    list(shr(int(), o(SELF))),
    al4(let_(OUT, Rc.new(NodeE.NewList(shr(int(), o(SELF))))), Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Reborrow(SELF)))), Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Reborrow(SELF)))), Rc.new(NodeE.Return(Rc.new(NodeE.Var(OUT)))))
  );
  main := entry(al4(let_(DOC, lit()), let_(W, call(usize(1), al1(Rc.new(NodeE.Borrow(false, DOC))))), use_(Rc.new(NodeE.Var(W))), Rc.new(NodeE.Assign(DOC, lit()))));
  verdict("words", case2(main, words), "ACCEPT");
});
test("words-then-write", {
  words := fun(
    u64(0),
    al1(prm(SELF, shr(int(), ELIDED))),
    list(shr(int(), o(SELF))),
    al3(let_(OUT, Rc.new(NodeE.NewList(shr(int(), o(SELF))))), Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Reborrow(SELF)))), Rc.new(NodeE.Return(Rc.new(NodeE.Var(OUT)))))
  );
  main := entry(al4(let_(DOC, lit()), let_(W, call(usize(1), al1(Rc.new(NodeE.Borrow(false, DOC))))), Rc.new(NodeE.Assign(DOC, lit())), use_(Rc.new(NodeE.Var(W)))));
  verdict("words-then-write", case2(main, words), "E0911");
});
// ---------------------------------------------------------------------------
// A closure capturing a reference or a holder by value (VERDICTS-44 R-CAP-1/2). A capture of an
// origin-carrying value puts that origin in the closure, which the model checks as the holder
// bound by a call that lends the root: the freeze (E0911) and the return rule (E0912) are the
// shapes `words`, `words-then-write` and `ret-local` already encode.
// ---------------------------------------------------------------------------
words_main :: (fn() -> FnDef)(entry(al4(let_(DOC, lit()), let_(W, call(usize(1), al1(Rc.new(NodeE.Borrow(false, DOC))))), use_(Rc.new(NodeE.Var(W))), Rc.new(NodeE.Assign(DOC, lit())))));
words_fn :: (fn() -> FnDef)(
  fun(
    u64(0),
    al1(prm(SELF, shr(int(), ELIDED))),
    list(shr(int(), o(SELF))),
    al3(let_(OUT, Rc.new(NodeE.NewList(shr(int(), o(SELF))))), Rc.new(NodeE.Push(OUT, Rc.new(NodeE.Reborrow(SELF)))), Rc.new(NodeE.Return(Rc.new(NodeE.Var(OUT)))))
  )
);
ret_param_main :: (fn() -> FnDef)(entry(al3(let_(X, lit()), let_(R, call(usize(1), al1(Rc.new(NodeE.Borrow(false, X))))), use_(Rc.new(NodeE.Var(R))))));
ret_param_fn :: (fn() -> FnDef)(fun(u64(0), al1(prm(XS, shr(int(), ELIDED))), shr(int(), o(XS)), al1(Rc.new(NodeE.Return(Rc.new(NodeE.Reborrow(XS)))))));
ret_local_fn :: (fn() -> FnDef)(fun(u64(0), al1(prm(XS, shr(int(), ELIDED))), shr(int(), ELIDED), al2(let_(Y, lit()), Rc.new(NodeE.Return(Rc.new(NodeE.Borrow(false, Y)))))));
test("closure-captures-ref-binding", {
  verdict("closure-captures-ref-binding", case2(words_main(), words_fn()), "ACCEPT");
});
test("closure-captures-self-ref", {
  verdict("closure-captures-self-ref", case2(ret_param_main(), ret_param_fn()), "ACCEPT");
});
test("closure-ref-capture-outlives-binding", {
  verdict("closure-ref-capture-outlives-binding", case2(words_main(), words_fn()), "ACCEPT");
});
test("closure-ref-capture-write-root", {
  // A closure bound to a local freezes its roots: the real checker's E0910 ("cannot be written
  // or moved here: the closure borrows it"), encoded as the argument overlap the model has.
  both := sig(u64(0), al2(prm(A, exc(list(int()), ELIDED)), prm(B, shr(list(int()), ELIDED))), int());
  main := entry(al2(let_(XS, Rc.new(NodeE.NewList(int()))), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, XS)), Rc.new(NodeE.Borrow(false, XS)))))));
  verdict("closure-ref-capture-write-root", case2(main, both), "E0910");
});
test("closure-ref-capture-returned-over-local", {
  verdict("closure-ref-capture-returned-over-local", case2(entry(none()), ret_local_fn()), "E0912");
});
test("closure-holder-capture-write-root", {
  // A closure bound to a local freezes its roots: the real checker's E0910 ("cannot be written
  // or moved here: the closure borrows it"), encoded as the argument overlap the model has.
  both := sig(u64(0), al2(prm(A, exc(list(int()), ELIDED)), prm(B, shr(list(int()), ELIDED))), int());
  main := entry(al2(let_(XS, Rc.new(NodeE.NewList(int()))), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, XS)), Rc.new(NodeE.Borrow(false, XS)))))));
  verdict("closure-holder-capture-write-root", case2(main, both), "E0910");
});
test("closure-holder-capture-returned-over-local", {
  verdict("closure-holder-capture-returned-over-local", case2(entry(none()), ret_local_fn()), "E0912");
});
test("async-captures-ref-param", {
  verdict("async-captures-ref-param", case2(ret_param_main(), ret_param_fn()), "ACCEPT");
});
test("async-ref-capture-caller-writes-arg", {
  // The forwarded future holds the argument's origin: the caller's write while it is live is
  // `words-then-write`'s shape.
  words_then_write_main := entry(al4(let_(DOC, lit()), let_(W, call(usize(1), al1(Rc.new(NodeE.Borrow(false, DOC))))), Rc.new(NodeE.Assign(DOC, lit())), use_(Rc.new(NodeE.Var(W)))));
  verdict("async-ref-capture-caller-writes-arg", case2(words_then_write_main, words_fn()), "E0911");
});
test("async-ref-capture-local-returned", {
  verdict("async-ref-capture-local-returned", case2(entry(none()), ret_local_fn()), "E0912");
});
// ---------------------------------------------------------------------------
// Several `&mut` out of one lend (O3 step 2)
// ---------------------------------------------------------------------------
get2_mut :: (fn() -> FnDef)(sig(u64(0), al1(prm(SELF, exc(list(int()), ELIDED))), Rc.new(TyE.Tup(al2(exc(int(), o(SELF)), exc(int(), o(SELF)))))));
test("get2-mut-pair", {
  main := entry(al4(let_(XS, Rc.new(NodeE.NewList(int()))), let_(PAIR, call(usize(1), al1(Rc.new(NodeE.Borrow(true, XS))))), use_(Rc.new(NodeE.Field(PAIR, usize(0)))), use_(Rc.new(NodeE.Field(PAIR, usize(1))))));
  verdict("get2-mut-pair", case2(main, get2_mut()), "ACCEPT");
});
test("get2-mut-twice", {
  main := entry(
    al4(
      let_(XS, Rc.new(NodeE.NewList(int()))),
      let_(PAIR, call(usize(1), al1(Rc.new(NodeE.Borrow(true, XS))))),
      let_(D, call(usize(1), al1(Rc.new(NodeE.Borrow(true, XS))))),
      use_(Rc.new(NodeE.Field(PAIR, usize(0))))
    )
  );
  verdict("get2-mut-twice", case2(main, get2_mut()), "E0911");
});
/// `iter_mut(self : &mut List(i32)) -> Cursor(self)` and
/// `next(generic(p : Origin), self : &mut Cursor(p)) -> Option(&mut(i32, p))`.
iter_mut :: (fn() -> FnDef)(sig(u64(0), al1(prm(SELF, exc(list(int()), ELIDED))), Rc.new(TyE.Tup(al2(exc(list(int()), o(SELF)), int())))));
next :: (fn() -> FnDef)(sig(P, al1(prm(SELF, exc(Rc.new(TyE.Tup(al2(exc(list(int()), P), int()))), ELIDED))), wrap(Kind.Some, exc(int(), P))));
test("cursor-two-items", {
  main := entry(
    al6(
      let_(XS, Rc.new(NodeE.NewList(int()))),
      let_(IT, call(usize(1), al1(Rc.new(NodeE.Borrow(true, XS))))),
      let_(A, call(usize(2), al1(Rc.new(NodeE.Borrow(true, IT))))),
      let_(B, call(usize(2), al1(Rc.new(NodeE.Borrow(true, IT))))),
      use_(Rc.new(NodeE.Var(A))),
      use_(Rc.new(NodeE.Var(B)))
    )
  );
  verdict("cursor-two-items", case3(main, iter_mut(), next()), "ACCEPT");
});
test("copy-mut-holder", {
  main := entry(al4(let_(XS, Rc.new(NodeE.NewList(int()))), let_(IT, call(usize(1), al1(Rc.new(NodeE.Borrow(true, XS))))), let_(D, Rc.new(NodeE.Var(IT))), use_(Rc.new(NodeE.Var(IT)))));
  verdict("copy-mut-holder", case2(main, iter_mut()), "E0901");
});
test("call-arg-overlap", {
  both := sig(u64(0), al2(prm(A, exc(list(int()), ELIDED)), prm(B, shr(list(int()), ELIDED))), int());
  main := entry(al2(let_(XS, Rc.new(NodeE.NewList(int()))), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, XS)), Rc.new(NodeE.Borrow(false, XS)))))));
  verdict("call-arg-overlap", case2(main, both), "E0910");
});
test("drop-root-while-borrowed", {
  main := entry(al4(let_(X, lit()), let_(R, Rc.new(NodeE.Borrow(false, X))), Rc.new(NodeE.Drop(X, false)), use_(Rc.new(NodeE.Var(R)))));
  verdict("drop-root-while-borrowed", case1(main), "E0911");
});
// An `FnMut` call borrows its closure exclusively (decision 37, N1f): the call
// is a `&mut` lend of the closure binding `C`, so no call-trait node is needed.
test("fnmut-two-live-calls", {
  main := entry(al4(let_(C, lit()), let_(R, Rc.new(NodeE.Borrow(true, C))), use_(Rc.new(NodeE.Borrow(true, C))), use_(Rc.new(NodeE.Var(R)))));
  verdict("fnmut-two-live-calls", case1(main), "E0911");
});
test("fnmut-sequential-calls", {
  main := entry(al4(let_(C, lit()), let_(R, Rc.new(NodeE.Borrow(true, C))), use_(Rc.new(NodeE.Var(R))), use_(Rc.new(NodeE.Borrow(true, C)))));
  verdict("fnmut-sequential-calls", case1(main), "ACCEPT");
});
// ---------------------------------------------------------------------------
// Invariance through a `&mut` pointee or a `RefCell` (O3-3)
// ---------------------------------------------------------------------------
/// `store(generic(T, r), dst : &mut Option(&(T, r)), v : &(T, r))`.
store :: (fn() -> FnDef)(
  fun(
    P,
    al2(prm(DST, exc(wrap(Kind.Some, shr(int(), P)), ELIDED)), prm(V, shr(int(), P))),
    int(),
    al1(Rc.new(NodeE.WriteThrough(DST, Rc.new(NodeE.Make(Kind.Some, Rc.new(NodeE.Var(V)))))))
  )
);
store_main :: (fn(root : usize) -> FnDef)(
  entry(
    al4(
      let_(X, lit()),
      let_d(SLOT, Rc.new(NodeE.Make(Kind.Some, Rc.new(NodeE.Borrow(false, X)))), wrap(Kind.Some, shr(int(), o(X)))),
      Rc.new(NodeE.Block(al2(let_(Y, lit()), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, SLOT)), Rc.new(NodeE.Borrow(false, root)))))))),
      use_(Rc.new(NodeE.Var(SLOT)))
    )
  )
);
test("store-widen-mut-pointee", {
  verdict("store-widen-mut-pointee", case2(store_main(Y), store()), "ORIGIN_MISMATCH");
});
test("store-same-origin", {
  verdict("store-same-origin", case2(store_main(X), store()), "ACCEPT");
});
store_widen_refcell :: (fn() -> Case)({
  store_cell := sig(P, al2(prm(CELL, shr(wrap(Kind.Cell, wrap(Kind.Some, shr(int(), P))), ELIDED)), prm(V, shr(int(), P))), int());
  main := entry(
    al4(
      let_(X, lit()),
      let_d(R, Rc.new(NodeE.Make(Kind.Cell, Rc.new(NodeE.Make(Kind.Some, Rc.new(NodeE.Borrow(false, X)))))), wrap(Kind.Cell, wrap(Kind.Some, shr(int(), o(X))))),
      Rc.new(NodeE.Block(al2(let_(Y, lit()), use_(call(usize(1), al2(Rc.new(NodeE.Borrow(false, R)), Rc.new(NodeE.Borrow(false, Y)))))))),
      use_(Rc.new(NodeE.Var(R)))
    )
  );
  case2(main, store_cell)
});
test("store-widen-refcell", {
  verdict("store-widen-refcell", store_widen_refcell(), "ORIGIN_MISMATCH");
});
/// `first(generic(r), v : &(i32, r)) -> &(i32, r)`: a projection whose
/// result names its parameter (projection-in-payload's callee).
proj_first :: (fn() -> FnDef)(sig(P, al1(prm(V, shr(int(), P))), shr(int(), P)));
/// `swap(generic(T, r), a : &mut &(T, r), b : &mut &(T, r))`.
swap :: (fn() -> FnDef)(sig(P, al2(prm(A, exc(shr(int(), P), ELIDED)), prm(B, exc(shr(int(), P), ELIDED))), int()));
swap_main :: (fn(ta : u64, tb : u64) -> FnDef)(
  entry(
    al7(
      let_(X, lit()),
      let_(Y, lit()),
      let_d(RA, Rc.new(NodeE.Borrow(false, X)), shr(int(), ta)),
      let_d(RB, Rc.new(NodeE.Borrow(false, Y)), shr(int(), tb)),
      use_(call(usize(1), al2(Rc.new(NodeE.Borrow(true, RA)), Rc.new(NodeE.Borrow(true, RB))))),
      use_(Rc.new(NodeE.Var(RA))),
      use_(Rc.new(NodeE.Var(RB)))
    )
  )
);
test("swap-different-origins", {
