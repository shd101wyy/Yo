// expect: E0911
// A projection call result passed to a parameter that names the `&mut`-lent holder's origin (`put(&mut o,
// ys.index(usize(0)))`) added nothing to `o`'s flow set: its type reads as the place, not a reference, so
// the write-back's solve skipped it. `o` is read after `ys` is dropped (heap-use-after-free).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
put :: (fn(generic(r : Origin), d : &mut Option(&(String, r)), v : &(String, r)) -> unit)({
  d.* = .Some(v);
});
main :: (fn() -> unit)({
  x := long();
  mut(o) := Option(&String).Some(&x);
  {
    mut(ys) := ArrayList(String).new();
    ys.push(long());
    put(&mut o, ys.index(usize(0)));
  };
  match(&o, .Some(r) => println(`OUT: ${r.*.clone()}`), .None => ());
});
export(main);
