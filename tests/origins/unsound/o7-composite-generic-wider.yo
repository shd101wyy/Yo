// expect: E0923
// The generic form of o7-composite-impl-wider: a where(T <: Pk) caller maps through the trait; the impl is rejected at registration. VERDICTS-57 §2. Found by the borrow/ownership audit (yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
Pk :: trait(pick : (fn(self : &Self, other : &Rc(X)) -> Option(&(Rc(X), self))));
P :: struct(v : Rc(X));
impl(P, Pk(pick : (fn(self : &Self, other : &Rc(X)) -> Option(&Rc(X)))(.Some(other))));
via :: (fn(generic(T : Type), t : &T, other : &Rc(X), where(T <: Pk)) -> Option(&(Rc(X), t)))(t.pick(other));
main :: (fn() -> unit)({
  p := P(v : Rc.new(X(s : String.from("p"))));
  mut(o) := Option(&Rc(X)).None;
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    o = via(&p, &b);
  };
  match(o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
