// expect: E0911
// `slot` is given a reference to `b`, a local of the loop body, at the end of one iteration and read at the top
// of the next, after `b` was dropped: the store is judged as if `slot` died with the body.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  mut(slot) := Option(&String).None;
  mut(i) := 0;
  while(i < 3, {
    match(slot, .Some(r) => println(`OUT: ${r.*}`), .None => ());
    b := Box.new(L());
    slot = .Some(&b.*);
    i = (i + 1);
  });
  ()
});
export(main);
