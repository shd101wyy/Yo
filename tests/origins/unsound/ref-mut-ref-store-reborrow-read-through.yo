// expect: E0911
// `set(&mut rp.*, &inner)`, then a read of `rp.*.*` after `inner` dies: the re-borrow `rp` names the same invariant origin as `r`, so its set widens too.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
set :: (fn(generic(p : Origin), dst : &mut&(Rc(X), p), v : &(Rc(X), p)) -> unit)({
  dst.* = v;
});
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  mut(rp) := &mut r;
  {
    inner := mk();
    set(&mut rp.*, &inner);
  };
  println(`OUT: ${rp.*.*.s.len().to_string()}`);
});
export(main);
