// expect: E0923
// A result SPELLED -> &(T, static) whose body returns the reference parameter (t2).
// VERDICTS-74 rule 2: the spelled empty origin is checked — a value holding a
// parameter's place may not flow into it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn(x : &X) -> &(X, static))(x);
main :: (fn() -> unit)({
  mut(o) := Option(&X).None;
  {
    b := X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
    o = .Some(mk(&b));
  };
  match(o, .Some(r) => println(`OUT: ${r.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
