// expect: accept
// Audit A3 (VERDICTS-71 rule (c)): sib1 without the sibling's later use: the re-point through `b` is accepted (VERDICTS-71 addendum A, sib2).
{ println } :: import("std/fmt");
Pair :: (fn(comptime(T) : Type) -> comptime(Type))(
  enum(Two(l : Option(Box(T)), tag : i32))
);
PNode :: struct(v : i32, kids : Pair(Self));
main :: (fn() -> unit)({
  mut(root) := Pair(PNode).Two(l : .Some(Box.new(PNode(v : i32(1), kids : Pair(PNode).Two(l : .None, tag : i32(0))))), tag : i32(0));
  cur := &mut root;
  match(
    cur,
    .Two(l, tag) => match(
      l,
      .Some(b) => {
        cur = &mut b.kids;
      },
      .None => ()
    )
  );
  match(
    cur,
    .Two(_, t) => {
      t.* = i32(9);
    }
  );
  println(&i32(0));
});
export(main);
