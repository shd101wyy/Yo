// expect: E0911
// An `io.async` method body copies `self : &Self` (`{ self }`): the returned future forwards the
// receiver's origin, so the caller's `w` is frozen until the await. Accepted, `w.s = ...` frees
// the String the future reads (found by the borrow/ownership audit, yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
LONG :: "0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz";
W :: struct(s : String);
impl(
  W,
  show : (fn(self : &Self, io : Io) -> Impl(Future(unit, Io)))(
    io.async({ self }(io : Io) => {
      println(`OUT: ${self.*.s.len().to_string()}`);
    })
  )
);
main :: (fn(io : Io) -> unit)({
  mut(w) := W(s : String.from(LONG));
  fut := w.show(io);
  w.s = String.from("b");
  io.await(fut, io);
});
export(main);
