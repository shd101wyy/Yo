// expect: E0911
// A field write `h.o = .Some(&y)` must grow `h`'s flow set (§5's place-write row): `y` dies with
// its block while `h` is read after it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
S :: struct(o : Option(&Rc(X)));
main :: (fn() -> unit)({
  mut(h) := S(o : Option(&Rc(X)).None);
  {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    h.o = .Some(&y);
  };
  match(&h.o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
