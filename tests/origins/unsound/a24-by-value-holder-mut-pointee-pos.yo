// expect: accept
// Positive control: the by-value `Slot(x)` is given a reference into `x2`, declared before the slot, and the
// slot's type is spelled over `(x, x2)`; nothing outlives what it points at.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
Slot :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(dst : &mut Option(&(Rc(X), p))));
put :: (fn(generic(p : Origin), s : Slot(p), v : &(Rc(X), p)) -> unit)({
  s.dst.* = .Some(v);
});
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  x2 := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  mut(slot) := Option(&(Rc(X), (x, x2))).Some(&x);
  put(Slot((x, x2))(dst : &mut slot), &x2);
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
