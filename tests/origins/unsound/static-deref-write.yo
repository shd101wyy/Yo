// expect: E0923
// A holder typed over static written through a &mut with &b; b dropped while it is live.
// VERDICTS-74 rule 2: a store through `p.*` is a write of a place whose type
// spells static, so only static values flow into it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
main :: (fn() -> unit)({
  mut(o) := Option(&(Rc(X), static)).None;
  b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  {
    p := &mut o;
    p.* = .Some(&b);
  };
  drop(b);
  match(o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
