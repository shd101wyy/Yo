// expect: accept
// The positive control of static-generic-fn-store: the free generic function
// handed a reference declared over `static` (`&G` of an immutable
// module-level binding, VERDICTS-74 rule 3), read after the store; and the
// same parameter passed on to the holder's method
// (issues/fixed/2026-11-27-a-static-reference-parameter-passed-on-to-a-static-holders-method-is-e0923.md).
{ println } :: import("std/fmt");
X :: struct(n : i32);
keep :: (fn(generic(T : Type), dst : &mut Option(T), v : T) -> unit)({
  dst.* = .Some(v);
});
G := X(n : i32(7));
fill :: (fn(slot : &mut Option(&(X, static)), g : &(X, static)) -> unit)({
  keep(slot, g);
  _old := slot.replace(g);
});
main :: (fn() -> unit)({
  mut(slot) := Option(&(X, static)).None;
  fill(&mut slot, &G);
  match(slot, .Some(r) => println(`OUT: ${r.*.n.to_string()}`), .None => println("none"));
  ()
});
export(main);
