// expect: accept
// The control: the read is inside `inner`'s block.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
set2 :: (fn(generic(p : Origin), dst : &mut &mut&(Rc(X), p), v : &(Rc(X), p)) -> unit)({
  dst.*.* = v;
});
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  mut(rp) := &mut r;
  {
    inner := mk();
    rpp := &mut rp;
    set2(&mut rpp.*, &inner);
    println(`OUT: ${r.*.*.s.len().to_string()}`);
  };
});
export(main);
