// expect: accept
// VERDICTS-78 Q1 edge 4: the holder declares the union `(z, y)`; storing `&y` is inside it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
Hp :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p), n : i32));
main :: (fn() -> unit)({
  z := mk();
  y := mk();
  mut(h) := Hp((z, y))(r : &z, n : i32(0));
  h.r = &y;
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
});
export(main);
