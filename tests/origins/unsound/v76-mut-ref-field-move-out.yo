// expect: E0901
// VERDICTS-76 Q1 row 12: a `&mut` field is part of its holder and is never moved out (a partial move, decision 19); the reborrow is `&mut s.r.*`.
S :: struct(r : &mut i32, n : i32);
main :: (fn() -> unit)({
  mut(x) := i32(1);
  s := S(r : &mut x, n : i32(0));
  a := s.r;
  a.* = i32(2);
});
export(main);
