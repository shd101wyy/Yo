// expect: accept
// a2-nested-lend-after-mut-lend's positive twin: the later argument borrows another list.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
first :: (fn(xs : &ArrayList(String)) -> &String)(&xs(usize(0)));
f :: (fn(xs : &mut ArrayList(String), r : &String) -> usize)({
  xs.clear();
  r.clone().len()
});
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(long());
  mut(ys) := ArrayList(String).new();
  ys.push(long());
  v := f(&mut xs, first(&ys));
  println(`OUT: ${v.to_string()}`);
});
export(main);
