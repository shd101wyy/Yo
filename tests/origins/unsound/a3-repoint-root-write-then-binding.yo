// expect: E0911
// Audit A3 (VERDICTS-71 rule (c)): `cur = &mut n.next; l1.head = .None; n.value = i32(7);`: `n`'s loan keeps `cur`'s root frozen until `n`'s last mention, so the root write is E0911 (VERDICTS-71 addendum B, b2; an ASan memory error before rule (c)).
{ println } :: import("std/fmt");
BNode :: struct(value : i32, next : Option(Box(Self)));
BList :: struct(head : Option(Box(BNode)));

main :: (fn() -> unit)({
  mut(l1) := BList(head : .Some(Box.new(BNode(value : i32(1), next : .Some(Box.new(BNode(value : i32(2), next : .None)))))));
  cur := &mut l1.head;
  match(
    cur,
    .Some(n) => {
      cur = &mut n.*.*.next;
      l1.head = .None;
      n.*.value = i32(7);
    },
    .None => ()
  );
});
export(main);
