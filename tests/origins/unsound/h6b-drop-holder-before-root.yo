// expect: E0911
// H6 (O-4): a user-`Drop` holder declared before its root; the root drops first and the holder's `drop` reads it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p)));
impl(
  generic(p : Origin),
  H(p),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      n := self.r.*.*.s.len();
      println(`H dropped, read len ${n.to_string()}`);
    })
  )
);
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  mut(h) := Option(H(x)).None;
  y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  h = .Some(H(y)(r : &y));
  println("end of main");
  ()
});
export(main);
