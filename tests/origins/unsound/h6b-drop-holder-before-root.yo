// expect: E0911
// H6 (O-4): a user-`Drop` holder (a flow-inferred `&` element) declared before its root and re-pointed at it; the root drops first, the holder's `drop` reads it. (The issue's spelled `Option(H(x))` form is E0923 since O-3.)
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
G :: (fn(comptime(T) : Type) -> comptime(Type))(struct(t : T));
impl(
  G(&Rc(X)),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      n := self.t.*.*.s.len();
      println(`G dropped, read len ${n.to_string()}`);
    })
  )
);
long :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  x := long();
  mut(g) := G(&Rc(X))(t : &x);
  y := long();
  g = G(&Rc(X))(t : &y);
  println("end of main");
});
export(main);
