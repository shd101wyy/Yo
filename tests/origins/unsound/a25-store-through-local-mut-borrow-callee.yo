// expect: E0911
// The callee form (VERDICTS-58 probe 2): the local `&mut` borrow of the slot is passed to a callee that
// stores through it. `_store(&mut slot, &y)` written directly is E0911.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
_store :: (fn(generic(r : Origin), dst : &mut Option(&(Rc(X), r)), v : &(Rc(X), r)) -> unit)({
  dst.* = .Some(v);
});
main :: (fn() -> unit)({
  mut(slot) := Option(&Rc(X)).None;
  {
    y := mk();
    sp := &mut slot;
    _store(sp, &y);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
});
export(main);
