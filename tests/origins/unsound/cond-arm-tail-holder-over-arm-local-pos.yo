// expect: accept
// Positive twin of cond-arm-tail-holder-over-arm-local: the arm block has a local of its own, but the holder it
// yields points at `z`, declared before the `cond`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X), n : i32);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
pick :: (fn(c : bool) -> usize)({
  z := mk();
  h := cond(
    c => {
      y := mk();
      _ := y.s.len();
      H(r : &z, n : i32(1))
    },
    true => H(r : &z, n : i32(0))
  );
  h.r.s.len()
});
main :: (fn() -> unit)({
  println(`OUT: ${pick(true).to_string()}`);
});
export(main);
