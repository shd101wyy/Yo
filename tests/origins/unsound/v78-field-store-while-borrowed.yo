// expect: E0911
// VERDICTS-78 Q1: a live `&` borrow of `h` freezes it, so the store into `h.r` is rejected.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
use_h :: (fn(h : &H) -> unit)(println(`OUT: ${h.r.*.*.s.len().to_string()}`));
main :: (fn() -> unit)({
  z := mk();
  y := mk();
  mut(h) := H(r : &z, n : i32(0));
  w := &h;
  h.r = &y;
  use_h(w);
});
export(main);
