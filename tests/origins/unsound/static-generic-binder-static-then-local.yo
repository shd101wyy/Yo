// expect: E0923
// A generic Type binder bound by a static value and then a local: the first argument's
// static type never wins (VERDICTS-74 rule 4); the second argument into the
// instantiated static slot is E0923 at the call.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
G := X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
two :: (fn(generic(T : Type), a : T, b : T) -> T)(b);
main :: (fn() -> unit)({
  x := X(s : String.from("hello"));
  (l : &(X, static)) = &G;
  r := two(l, &x);
  (m : &(X, static)) = r;
  drop(x);
  println(`OUT: ${m.*.s.len().to_string()}`);
});
export(main);
