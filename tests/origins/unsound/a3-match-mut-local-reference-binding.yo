// expect: E0911
// The `&mut` form: `e` borrows the list element through the arm binding `x`; the arm writes
// `r.* = .None` (dropping the list) and reads `e`: heap-use-after-free.
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(L());
  mut(o) := Option(ArrayList(String)).Some(xs);
  r := &mut o;
  match(
    r,
    .Some(x) => match(
      &x.*(usize(0)),
      e => {
        r.* = .None;
        println(`OUT: ${e.*}`);
      }
    ),
    .None => ()
  );
  ()
});
export(main);
