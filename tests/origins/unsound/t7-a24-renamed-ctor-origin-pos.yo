// expect: accept
// The positive twin of t7-a24-renamed-ctor-origin: the reference stored is over the slot's own origin.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
Slot :: (fn(comptime(z) : Origin) -> comptime(Type))(struct(dst : &mut Option(&(Rc(X), z))));
put :: (fn(generic(p : Origin), s : Slot(p), v : &(Rc(X), p)) -> unit)({
  s.dst.* = .Some(v);
});
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  mut(slot) := Option(&(Rc(X), x)).Some(&x);
  {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    put(Slot(x)(dst : &mut slot), &x);
    println(`y ${y.s.len().to_string()}`);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
