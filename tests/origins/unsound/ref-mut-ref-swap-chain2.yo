// expect: E0911
// The swap shape through a depth-2 re-borrow chain: `sw(&mut rpp.*.*, &mut q)` with `q := &inner` block-local; the write-back must reach `r`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
sw :: (fn(generic(p : Origin), a : &mut&(Rc(X), p), b : &mut&(Rc(X), p)) -> unit)({
  t := a.*;
  a.* = b.*;
  b.* = t;
});
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  mut(rp) := &mut r;
  {
    inner := mk();
    mut(q) := &inner;
    rpp := &mut rp;
    sw(&mut rpp.*.*, &mut q);
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
