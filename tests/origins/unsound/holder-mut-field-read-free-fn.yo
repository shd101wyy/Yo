// expect: E0911
// A31's free-function form: `first2(&h)` reads through `h`'s `&mut` field behind `h : &H(p)`, so `r`
// borrows `h` and `grow(h.m)` while `r` lives is E0911.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
H :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(m : &mut(ArrayList(String), p)));
first2 :: (fn(generic(p : Origin), h : &H(p)) -> &String)(&h.m(usize(0)));
grow :: (fn(xs : &mut ArrayList(String)) -> unit)({
  mut(i) := i32(0);
  while(i < i32(100), i = (i + i32(1)), {
    xs.push(String.from("grow"));
  });
});
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  h := H(xs)(m : &mut xs);
  r := first2(&h);
  grow(h.m);
  println(`OUT: ${r.*}`);
});
export(main);
