// expect: accept
// Positive twin of move-only-element-lent-container-moved: the container is moved and cleared AFTER the last use of the lent element.
{ println } :: import("std/fmt");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ RefCell } :: import("std/sync/refcell");
main :: (fn() -> unit)({
  mut(hs) := ArrayList(RefCell(String)).new();
  hs.push(RefCell(String).new(String.from("hello")));
  hs(usize(0)).with_mut(v => println(&v.*));
  mut(hs2) := hs;
  hs2.clear();
});
export(main);
