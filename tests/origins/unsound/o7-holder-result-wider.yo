// expect: E0923
// A holder result: the trait returns V(self), the impl V(other) and returns a holder of other. VERDICTS-57 §2. Found by the borrow/ownership audit (yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
V :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p)));
Pk :: trait(pick : (fn(self : &Self, other : &Rc(X)) -> V(self)));
P :: struct(h : Rc(X));
impl(P, Pk(pick : (fn(self : &Self, other : &Rc(X)) -> V(other))(V(other)(r : other))));
main :: (fn() -> unit)({
  (d : Dyn(Pk)) = dyn(P(h : Rc.new(X(s : String.from("kept")))));
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    v := d.pick(&b);
    println(`OUT: ${v.r.*.s.len().to_string()}`);
  };
  ()
});
export(main);
