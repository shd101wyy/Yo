// expect: accept
// Positive twin of rigid-generic-nested-call: `b` is declared over `p` too, so the nested
// store stays within `dst`'s origin; the caller passes a place that outlives the holder.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
_put :: (fn(generic(r : Origin), v : &(Rc(X), r), dst : &mut Option(&(Rc(X), r))) -> unit)({
  dst.* = .Some(v);
});
_pick :: (fn(generic(p : Origin), a : &(Rc(X), p), b : &(Rc(X), p), dst : &mut Option(&(Rc(X), p))) -> unit)({
  _put(b, dst);
});
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("outer")));
  mut(slot) := Option(&(Rc(X), x)).None;
  {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    _pick(&x, &x, &mut slot);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
