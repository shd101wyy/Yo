// expect: accept
// Positive twin of field-write-spelled-holder: the field takes `&z0`, the place the origin names.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
S :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(o : Option(&(String, p))));
main :: (fn() -> unit)({
  z0 := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  mut(h) := S(z0)(o : Option(&(String, z0)).None);
  h.o = .Some(&z0);
  match(&h.o, .Some(r) => println(`OUT: ${r.*.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
