// expect: accept
// Positive control: the closure's capture list lends a different list `&mut`.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");
W :: struct(s : String);
peek :: (fn(w : &W, act : &mut Impl(FnMut() -> unit)) -> unit)({
  act();
  println(`OUT: ${w.s.clone()}`);
});
main :: (fn() -> unit)({
  mut(ws) := ArrayList(W).new();
  ws.push(W(s : String.from("hello, a string long enough to live on the heap")));
  mut(vs) := ArrayList(W).new();
  vs.push(W(s : String.from("hello, a string long enough to live on the heap")));
  peek(
    &ws(usize(0)),
    &mut ({ &mut vs }() => {
      vs.clear();
    })
  );
});
export(main);
