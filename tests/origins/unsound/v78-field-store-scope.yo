// expect: E0911
// VERDICTS-78 Q1: `h.r = &y` stores a reference into the field `r`, charged to `h` as the
// whole-holder store is: `y` dies with its block while `h` is read after it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
main :: (fn() -> unit)({
  z := mk();
  mut(h) := H(r : &z, n : i32(0));
  {
    y := mk();
    h.r = &y;
  };
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
});
export(main);
