// expect: accept
// a2-inline-payload-arg's positive twin: the payload borrows another list.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
first :: (fn(xs : &ArrayList(String)) -> &String)(&xs(usize(0)));
f :: (fn(xs : &mut ArrayList(String), o : Option(&String)) -> usize)({
  xs.clear();
  match(o, .Some(r) => r.clone().len(), .None => usize(0))
});
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(long());
  mut(ys) := ArrayList(String).new();
  ys.push(long());
  v := f(&mut xs, Option(&String).Some(&ys(usize(0))));
  println(`OUT: ${v.to_string()}`);
});
export(main);
