// expect: accept
// holder-from-temporary-rc-deref's positive twin: the `Rc` and the `Box` are bound to locals that outlive the
// holders, so nothing they point into is a temporary; a temporary handle lent within one statement is fine.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
V :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(String, p)));
mkv :: (fn(r : &String) -> V(r))(V(r)(r : r));
long :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
len_of :: (fn(r : &String) -> usize)(r.len());
main :: (fn() -> unit)({
  h := long();
  b := Box.new(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  v := mkv(&h.*.s);
  w := mkv(&b.*);
  n := len_of(&long().*.s);
  println(`OUT: ${v.r.*} ${w.r.*} ${n}`);
});
export(main);
