// expect: E0912
// A `self : Self` method returns `&self.h.*.s`, a place inside an `Rc` field of the BY-VALUE receiver:
// the method drops `self` (and the only handle) when it returns, so the result points into a freed payload.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
W :: struct(h : Rc(X));
impl(W, get : (fn(self : Self) -> &String)(&self.h.*.s));
main :: (fn() -> unit)({
  w := W(h : Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
  println(`OUT: ${w.get()}`);
});
export(main);
