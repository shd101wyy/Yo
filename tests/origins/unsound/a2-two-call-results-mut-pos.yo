// expect: accept
// a2-two-call-results-mut's positive twin: the two call results borrow two different places.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
idm :: (fn(r : &mut Option(Rc(X))) -> &mut Option(Rc(X)))(&mut r.*);
both :: (fn(a : &mut Option(Rc(X)), b : &mut Option(Rc(X))) -> usize)(
  match(
    a,
    .Some(p) => {
      b.* = .None;
      p.*.s.len()
    },
    .None => usize(0)
  )
);
mk :: (fn() -> Option(Rc(X)))(.Some(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")))));
main :: (fn() -> unit)({
  mut(x) := mk();
  mut(y) := mk();
  n := both(idm(&mut x), idm(&mut y));
  println(`OUT: ${n.to_string()}`);
  ()
});
export(main);
