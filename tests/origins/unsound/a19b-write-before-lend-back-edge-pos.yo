// expect: accept
// Positive control: the holder is read at the top of the iteration, then the root is written, then the holder
// is re-pointed. The loan the back edge carries is dead at the write (the holder is overwritten before its next
// read), so a back-edge-aware checker must keep accepting this.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  a := L();
  mut(x) := L();
  mut(h) := Option(&String).Some(&a);
  mut(i) := 0;
  while(i < 3, {
    match(h, .Some(r) => println(`OUT: ${r.*}`), .None => ());
    x = String.from("q");
    h = .Some(&x);
    i = (i + 1);
  });
  ()
});
export(main);
