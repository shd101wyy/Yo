// expect: E0923
// A field spelled over static written with &b; b dropped while the holder is live.
// VERDICTS-74 rule 2: a field write is an expected-type site. The value
// `.Some(&b)` is typed from the field, so its type carries no origin, and only
// its roots show what it holds.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : Option(&(Rc(X), static)));
main :: (fn() -> unit)({
  mut(h) := H(r : .None);
  b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  h.r = .Some(&b);
  drop(b);
  match(h.r, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
