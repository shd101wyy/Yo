// expect: accept
// A destructuring consumes the call's temporary (VERDICTS-76 Q2): `mut(written)` owns its `Rc`
// element, so reassigning it releases the element once and the temporary releases nothing. Before
// Q2 the name was a copy of a borrowed element, and its reassignment released the element a second
// time (heap-use-after-free at the read); then it was E0901.
{ println } :: import("std/fmt");
Node :: struct(n : i32);
pair :: (fn(e : &Rc(Node)) -> Tuple(Rc(Node), usize))((Rc.clone(e.*), usize(0)));
use :: (fn(e : &Rc(Node), swap : bool) -> i32)({
  (mut(written), _synth) := pair(e);
  if(swap, {
    written = Rc.new(Node(n : i32(9)));
  });
  written.*.n
});
main :: (fn() -> unit)({
  x := Rc.new(Node(n : i32(7)));
  keep := Rc.clone(x);
  a := use(&x, false);
  b := use(&x, true);
  println(`OUT: ${ref_count(keep)} ${a} ${b}`);
});
export(main);
