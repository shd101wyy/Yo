// expect: E0923
// A struct field spelled &(T, static) filled with a block-local's reference.
// VERDICTS-57 §1.4, P12: `static` is checked (`o ⊆ static` iff `o = static`); E0922 in v0.2.77. Found by the borrow/ownership audit (yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &(Rc(X), static));
main :: (fn() -> unit)({
  mut(o) := Option(H).None;
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    o = .Some(H(r : &b));
  };
  match(o, .Some(h) => println(`OUT: ${h.r.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
