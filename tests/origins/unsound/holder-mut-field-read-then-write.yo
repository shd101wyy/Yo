// expect: E0911
// A31 (found by the borrow/ownership audit, yo-6c): `r := h.first()` reads through the holder's `&mut`
// field `m` behind `self : &Self`. Its origin is the UNION of the field's origin (`xs`) and the holder `h`
// (O3 "Reborrows"), so `h.m.push`, a write through `h`'s own `&mut`, is E0911 while `r` lives.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
H :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(m : &mut(ArrayList(String), p)));
impl(generic(p : Origin), H(p), first : (fn(self : &Self) -> &String)(&self.m(usize(0))));
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  h := H(xs)(m : &mut xs);
  r := h.first();
  mut(i) := i32(0);
  while(i < i32(100), i = (i + i32(1)), {
    h.m.push(String.from("grow"));
  });
  println(`OUT: ${r.*}`);
});
export(main);
