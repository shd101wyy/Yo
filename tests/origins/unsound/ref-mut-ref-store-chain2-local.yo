// expect: E0911
// `rpp.*.* = ri` with no call: the store replaces `r`'s value through the depth-2 chain.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  mut(rp) := &mut r;
  {
    inner := mk();
    ri := &inner;
    rpp := &mut rp;
    rpp.*.* = ri;
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
