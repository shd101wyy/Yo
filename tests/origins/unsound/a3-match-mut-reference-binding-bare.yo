// expect: E0910
// A `&mut` reference binding matched bare (audit A3's open half, m20): `r := &mut o`, the arm binds inside the
// referent, then `r.* = .None` drops it under the binding and `e` reads freed memory (heap-use-after-free).
// WALLED in v0.2.79: the bare form is rejected; `match(&mut r.*, …)` registers the arm bindings' loans.
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(o) := Option(ArrayList(i32)).Some(ArrayList(i32).new());
  r := &mut o;
  match(
    r,
    .Some(x) => match(
      &x.*(usize(0)),
      e => {
        r.* = .None;
        (v : i32) = e.*;
        println(&v);
      }
    )
  );
  ()
});
export(main);
