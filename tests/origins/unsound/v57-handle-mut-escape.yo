// expect: E0911
// A callee that writes nothing and returns a holder of its `&mut` parameter: storing the parameter in the
// holder's `&mut` field makes a `&mut` reference value (`lends_mut`), so the argument is a write against `r`.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
Bag :: struct(items : ArrayList(ArrayList(String)));
Handle :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(bag : &mut(Bag, p)));
handle :: (fn(b : &mut Bag) -> Handle(b))(Handle(b)(bag : b));
main :: (fn() -> unit)({
  mut(inner) := ArrayList(String).new();
  inner.push(String.from("hello-world-hello-world-hello-world"));
  mut(b) := Bag(items : ArrayList(ArrayList(String)).new());
  b.items.push(inner);
  r := b.items.index(usize(0)).index(usize(0));
  h := handle(&mut b);
  h.bag.items.clear();
  println(`OUT: ${r.*}`);
  ()
});
export(main);
