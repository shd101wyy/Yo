// expect: E0923
// The qualified form `_Slot(a).put(&mut s, &yb.*)` of method-store-widen-named-holder: the callee's specialized type
// elides the references' origins, so the call reads the definition's slots (impl-level `generic(p : Origin)`).
{ println } :: import("std/fmt");
_Slot :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(dst : &mut Option(&(i32, p))));
impl(
  generic(p : Origin),
  _Slot(p),
  put : (fn(self : &mut Self, v : &(i32, p)) -> unit)({
    self.dst.* = .Some(v);
  })
);
main :: (fn() -> unit)({
  a := i32(1);
  mut(slot) := Option(&(i32, a)).Some(&a);
  mut(s) := _Slot(a)(dst : &mut slot);
  {
    yb := Box.new(i32(2));
    _Slot(a).put(&mut s, &yb.*);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.to_string()}`), .None => println("none"));
  ()
});
export(main);
