// expect: E0923
// The = join's subset (O3 place writes), ASan form: `s` is declared over `x`, and a whole-holder
// assignment stores a composite holding `&y`, a block local, which dies while `s` is read.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("outer")));
  mut(s) := Option(&(Rc(X), x)).None;
  {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    s = .Some(&y);
  };
  match(s, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
