// expect: E0913
// The same write in a closure that the callee calls twice: both calls reallocate from the closure's
// copy and the outer `s` releases the original buffer again at scope end (double free).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
twice :: (fn(f : &Impl(Fn() -> usize)) -> usize)(f() + f());
main :: (fn() -> unit)({
  mut(s) := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  n := twice(
    &(
      () => {
        s.push_str("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
        s.len()
      }
    )
  );
  println(`OUT: ${n.to_string()}`);
});
export(main);
