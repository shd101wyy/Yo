// expect: E0911
// `consume(s)` while `r := &s` is live: the builtin's move releases the buffer `r` points at, and `r` is read.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  s := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  r := &s;
  consume(s);
  println(`OUT: ${r.*}`);
});
export(main);
