// expect: E0911
// `find` over a cursor whose `Item` is a reference into `xs`: the bound result still points into `xs`, which is cleared before the result is read (the closure lent to `pred` is no root, the list is).
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
FrCursor :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(xs : &(ArrayList(String), p), i : usize));
impl(
  generic(p : Origin),
  FrCursor(p),
  Iterator(
    Item : &(String, p),
    next : (fn(self : &mut Self) -> Option(&(String, p)))(
      cond(
        (self.i < self.xs.len()) => {
          k := self.i;
          self.i = (k + usize(1));
          unsafe(.Some(&self.xs.ptr().unwrap().add(k).*))
        },
        true => .None
      )
    )
  )
);
fr_cursor :: (fn(xs : &ArrayList(String)) -> FrCursor(xs))(FrCursor(xs)(xs : xs, i : usize(0)));
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  xs.push(String.from("abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789"));
  found := fr_cursor(&xs).find(v => (v.*.len() > usize(10)));
  xs.clear();
  match(found, .Some(s) => println(`OUT: ${s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
