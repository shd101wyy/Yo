// expect: accept
// proj-ret-byvalue-self-rc-field's positive twin: the receiver is `self : &Self`, so `&self.h.*.s` lies in the
// caller's `Rc`, which outlives the call.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
W :: struct(h : Rc(X));
impl(W, get : (fn(self : &Self) -> &String)(&self.h.*.s));
main :: (fn() -> unit)({
  w := W(h : Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
  println(`OUT: ${w.get()}`);
});
export(main);
