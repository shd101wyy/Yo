// expect: E0911
// A function forwarding another call's borrowing future (`fwd` returns `w.show(io)`): the result is rooted at
// `fwd`'s `w`, so the caller's `f := fwd(&w, io)` freezes `w` and moving it while `f` is live is rejected.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
W :: struct(s : String);
impl(W, show : (fn(self : &Self, io : Io) -> Impl(Future(unit, Io)))(
  io.async({ self : &self.* }(io : Io) => {
    io.await(yield(io), io);
    println(`OUT: ${self.*.s}`);
  })
));
fwd :: (fn(w : &W, io : Io) -> Impl(Future(unit, Io)))(w.show(io));
eat :: (fn(w : W) -> unit)(());
main :: (fn(io : Io) -> unit)({
  w := W(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  f := fwd(&w, io);
  eat(w);
  io.await(f, io);
});
export(main);
