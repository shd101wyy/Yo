// expect: E0911
// A holder of `&mut r` (a `&mut &Rc(X)` field): the store `m.rp.* = ri` re-points `r` at the
// block-local `inner`, `r`'s flow set is not widened, and `r` is read after `inner` dies.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
M :: struct(rp : &mut&Rc(X));
main :: (fn() -> unit)({
  outer := mk();
  mut(r) := &outer;
  {
    inner := mk();
    m := M(rp : &mut r);
    ri := &inner;
    m.rp.* = ri;
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
