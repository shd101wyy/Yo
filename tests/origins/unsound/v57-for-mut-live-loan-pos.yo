// expect: accept
// Positive twin of v57-for-mut-live-loan: the `&` loan's last use is before the write walk.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(inner) := ArrayList(String).new();
  inner.push(String.from("hello-world-hello-world-hello-world"));
  mut(xs) := ArrayList(ArrayList(String)).new();
  xs.push(inner);
  r := xs.index(usize(0)).index(usize(0));
  println(`OUT: ${r.*}`);
  for(&mut xs, x => {
    x.* = ArrayList(String).new();
  });
  println(`OUT: ${xs.len().to_string()}`);
  ()
});
export(main);
