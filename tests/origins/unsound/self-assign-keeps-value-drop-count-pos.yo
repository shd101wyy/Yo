// expect: accept
// No heap payload: the destructor of the one `D` runs once, at the scope end,
// not at `x = x` too (it ran twice).
{ println } :: import("std/fmt");
{ assert } :: import("std/assert");
(mut(g_drops) : i32) = i32(0);
nd :: (fn() -> i32)(g_drops);
D :: struct(n : i32);
impl(
  D,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_drops = (g_drops + i32(1));
    })
  )
);
main :: (fn() -> unit)({
  {
    mut(x) := D(n : i32(1));
    x = x;
    println(`OUT after-assign drops=${nd().to_string()} expect 0`);
    assert(nd() == i32(0), "x = x runs no destructor");
  };
  println(`OUT drops=${nd().to_string()} expect 1`);
  assert(nd() == i32(1), "the scope end runs it once");
});
export(main);
