// expect: accept
// generic-result-option-second-arg-pushed's positive twin: the result is read before the event.
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
_sm_pick :: (fn(generic(T : Type), a : T, b : T, first : bool) -> Option(T))(.Some(if(first, a, b)));
main :: (fn() -> unit)({
  mut(xs) := ArrayList(i32).new();
  mut(ys) := ArrayList(i32).new();
  xs.push(i32(1));
  ys.push(i32(2));
  rx := xs.index(usize(0));
  ry := ys.index(usize(0));
  picked := _sm_pick(rx, ry, false);
  (v : i32) = match(picked, .Some(p) => p.*, .None => i32(0));
  mut(i) := i32(0);
  while(i < i32(1000), {
    ys.push(i);
    i = (i + i32(1));
  });
  println(&v);
});
export(main);
