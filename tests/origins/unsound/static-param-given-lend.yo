// expect: E0923
// A parameter typed &(Rc(X), static) given a lend of a block local.
// VERDICTS-57 §1.4, P12: `static` is checked (`o ⊆ static` iff `o = static`); E0922 in v0.2.77. Found by the borrow/ownership audit (yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
keep :: (fn(v : &(Rc(X), static)) -> Option(&(Rc(X), static)))(.Some(v));
main :: (fn() -> unit)({
  mut(o) := Option(&(Rc(X), static)).None;
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    o = keep(&b);
  };
  match(o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
