// expect: E0911
// VERDICTS-78 Q1: `d` borrows a place reached through `h.r`; re-pointing `h.r` while `d` is
// live is rejected (decision 38 A; Rust accepts this one).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
main :: (fn() -> unit)({
  z := mk();
  y := mk();
  mut(h) := H(r : &z, n : i32(0));
  d := &h.r.*.*.s;
  h.r = &y;
  println(`OUT: ${d.len().to_string()}`);
});
export(main);
