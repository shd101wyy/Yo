// expect: E0922
// A result spelled over static; the body returns the reference parameter.
// VERDICTS-57 §1: the v0.2.77 wall (E0923 once v0.2.78 checks `static`; P12). Found by the borrow/ownership audit (yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn(x : &Rc(X)) -> Option(&(Rc(X), static)))(.Some(x));
main :: (fn() -> unit)({
  mut(o) := Option(&Rc(X)).None;
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    o = mk(&b);
  };
  match(o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
