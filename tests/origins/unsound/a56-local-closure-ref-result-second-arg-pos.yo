// expect: accept
// Positive control of a56-local-closure-ref-result-second-arg: the closure's elided result
// origin is the union of both reference parameters (O2), and the read of `picked` comes before
// `ys` grows, so both borrows end before the reallocation.
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(xs) := ArrayList(i32).new();
  mut(ys) := ArrayList(i32).new();
  xs.push(i32(1));
  ys.push(i32(2));
  rx := xs.index(usize(0));
  ry := ys.index(usize(0));
  pick := (fn(a : &i32, b : &i32) -> &i32)(&b.*);
  picked := pick(rx, ry);
  (v : i32) = picked.*;
  println(&v);
});
export(main);
