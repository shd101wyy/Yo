// expect: E0912
// An `FnMut` closure stores a reference to one of its BODY's locals into its own by-value state; the
// next call reads it after the local died.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
main :: (fn() -> unit)({
  (mut(f) : Impl(FnMut() -> unit)) = ({ last : Option(&Rc(X)).None }() => {
    match(&last, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => ());
    k := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    y := &k;
    last = .Some(y);
  });
  f();
  f();
});
export(main);
