// expect: E0912
// A projection returns `&b.*` of a LOCAL `Box`: a `.*` on an owning handle is a field step, so the place is
// rooted at `b`, which the function frees when it returns (O3's return rule, audit A30).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
get :: (fn(a : &String) -> &String)({
  b := Box.new(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  &b.*
});
main :: (fn() -> unit)({
  k := String.from("k");
  println(`OUT: ${get(&k)}`);
});
export(main);
