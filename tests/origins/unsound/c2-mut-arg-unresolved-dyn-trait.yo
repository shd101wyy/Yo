// expect: E0911
// The same through a `Dyn(Trait)` method: the caller sees only the trait signature.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Option(Rc(X)))(.Some(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")))));
clear :: (fn(o : &mut Option(Rc(X))) -> unit)({
  o.* = .None;
});
Wiper :: trait(wipe : (fn(self : &Self, o : &mut Option(Rc(X))) -> unit));
W :: struct(n : i32);
impl(
  W,
  Wiper(
    wipe : (fn(self : &Self, o : &mut Option(Rc(X))) -> unit)({
      o.* = .None;
    })
  )
);
main :: (fn() -> unit)({
  (d : Dyn(Wiper)) = dyn(W(n : i32(1)));
  mut(x) := mk();
  n := match(
    &x,
    .Some(p) => {
      d.wipe(&mut x);
      p.*.s.len()
    },
    .None => usize(0)
  );
  println(`OUT: ${n.to_string()}`);
});
export(main);
