// expect: E0911
// H1 (ASan form): the stored reference points at an Rc handle whose cell is freed at the inner scope's end.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
store :: (fn(generic(r : Origin), dst : &mut Option(&(Rc(X), r)), v : &(Rc(X), r)) -> unit)({
  dst.* = .Some(v);
});
main :: (fn() -> unit)({
  mut(slot) := Option(&Rc(X)).None;
  {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    store(&mut slot, &y);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
