// expect: E0911
// The callee walks its `&mut` parameter by name, `for(b, …)`: a read of a `&mut` reference binding into the
// by-value `self : Self` slot of `into_iter` makes a `&mut` reference value (`lends_mut`).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
overwrite :: (fn(b : &mut ArrayList(ArrayList(String))) -> unit)({
  for(b, x => {
    x.* = ArrayList(String).new();
  });
});
main :: (fn() -> unit)({
  mut(inner) := ArrayList(String).new();
  inner.push(String.from("hello-world-hello-world-hello-world"));
  mut(xs) := ArrayList(ArrayList(String)).new();
  xs.push(inner);
  r := xs.index(usize(0)).index(usize(0));
  overwrite(&mut xs);
  println(`OUT: ${r.*}`);
  ()
});
export(main);
