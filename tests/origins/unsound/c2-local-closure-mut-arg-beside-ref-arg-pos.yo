// expect: accept
// The positive twin: the `&` loan's last use is before the call, and the closure's reference argument borrows another
// string, so `&mut xs` at the call's activation overlaps no live loan.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");
first :: (fn(xs : &ArrayList(String)) -> &String)(&xs(usize(0)));
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(long());
  w := long();
  (c : Impl(Fn(ys : &mut ArrayList(String), r : &String) -> usize)) = ((ys : &mut ArrayList(String), r : &String) => {
    ys.clear();
    r.clone().len()
  });
  e := first(&xs);
  println(`OUT: ${e.*}`);
  v := c(&mut xs, &w);
  println(`OUT: ${v.to_string()}`);
});
export(main);
