// expect: E0911
// The same store written as an assignment through the call result:
// `slot(&mut s).* = .Some(...)`. Heap-use-after-free after the block.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
S2 :: struct(o : Option(&String), n : i32);
slot :: (fn(s : &mut S2) -> &mut Option(&String))(&mut s.o);
main :: (fn() -> unit)({
  x := long();
  mut(s) := S2(o : .Some(&x), n : i32(0));
  {
    mut(ys) := ArrayList(String).new();
    ys.push(long());
    slot(&mut s).* = .Some(ys.index(usize(0)));
  };
  match(&s.o, .Some(r) => println(`OUT: ${r.*.clone()}`), .None => ());
});
export(main);
