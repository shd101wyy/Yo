// expect: accept
// VERDICTS-78 Q1 edge 6: `h.r = &mut b` re-points a `&mut` field; `h.r.* = v` writes `b`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
M :: struct(r : &mut Rc(X), n : i32);
main :: (fn() -> unit)({
  mut(a) := mk();
  mut(b) := mk();
  mut(h) := M(r : &mut a, n : i32(0));
  h.r = &mut b;
  h.r.* = mk();
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
  println(`OUT: ${b.*.s.len().to_string()}`);
});
export(main);
