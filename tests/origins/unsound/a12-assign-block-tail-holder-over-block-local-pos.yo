// expect: accept
// Positive control of a12-assign-block-tail-holder-over-block-local: the block yields a holder over the
// outer `w`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X), n : i32);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  z := mk();
  w := mk();
  mut(h) := H(r : &z, n : i32(0));
  h = {
    y := mk();
    _ := y.s.len();
    H(r : &w, n : i32(1))
  };
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
  ()
});
export(main);
