// expect: E0911
// The callee re-lends its parameter to a local, `ys := &mut b.*`, and walks that: the binding makes a `&mut`
// reference value of the parameter's storage (`lends_mut`).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
overwrite :: (fn(b : &mut ArrayList(ArrayList(String))) -> unit)({
  ys := &mut b.*;
  for(&mut ys.*, x => {
    x.* = ArrayList(String).new();
  });
});
main :: (fn() -> unit)({
  mut(inner) := ArrayList(String).new();
  inner.push(String.from("hello-world-hello-world-hello-world"));
  mut(xs) := ArrayList(ArrayList(String)).new();
  xs.push(inner);
  r := xs.index(usize(0)).index(usize(0));
  overwrite(&mut xs);
  println(`OUT: ${r.*}`);
  ()
});
export(main);
