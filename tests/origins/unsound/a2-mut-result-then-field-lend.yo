// expect: E0910
// Audit A2 (c23): the first argument is a call result carrying `&mut w` (`g` returns `&mut w.l`); the second lends `&w.l`, an access against that loan. `f` clears the list through the first and reads it through the second.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
first :: (fn(xs : &ArrayList(String)) -> &String)(&xs(usize(0)));
W :: struct(l : ArrayList(String), k : ArrayList(String));
mkw :: (fn() -> W)({
  mut(l) := ArrayList(String).new();
  l.push(long());
  mut(k) := ArrayList(String).new();
  k.push(long());
  W(l : l, k : k)
});
g :: (fn(w : &mut W) -> &mut ArrayList(String))(&mut w.l);
f :: (fn(a : &mut ArrayList(String), r : &ArrayList(String)) -> usize)({
  a.clear();
  r(usize(0)).clone().len()
});
main :: (fn() -> unit)({
  mut(w) := mkw();
  v := f(g(&mut w), &w.l);
  println(`OUT: ${v.to_string()}`);
});
export(main);
