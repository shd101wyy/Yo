// expect: E0911
// `&mut h.o` lends a field of `h` to a callee that may store a reference into it: what the
// call's other arguments carry is charged to `h` (the write-back of a `&mut` lend, for a field
// place), and `y` dies with its block while `h` is read after it
// (issues/fixed/2026-11-25-a-mut-lend-of-a-holders-field-does-not-write-back-what-the-callee-stores.md).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
H2 :: struct(o : Option(&Rc(X)), n : i32);
put :: (fn(generic(p : Origin), dst : &mut Option(&(Rc(X), p)), v : &(Rc(X), p)) -> unit)({
  dst.* = .Some(v);
});
main :: (fn() -> unit)({
  z := mk();
  mut(h) := H2(o : .Some(&z), n : i32(0));
  {
    y := mk();
    put(&mut h.o, &y);
  };
  match(&h.o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => ());
});
export(main);
