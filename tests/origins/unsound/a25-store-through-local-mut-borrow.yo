// expect: E0911
// A store through `p := &mut slot` re-points the holder `slot` at the block-local `y`; `slot`'s
// flow set is not widened, so its read after `y` dies is accepted (stack-use-after-scope).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  mut(slot) := Option(&Rc(X)).None;
  {
    y := mk();
    p := &mut slot;
    p.* = .Some(&y);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
});
export(main);
