// expect: accept
// VERDICTS-76 row 10: `a = m` re-points `a` by move: `a`'s old loan of `y` ends, `a` takes over `m`'s loan of `x`.
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(x) := i32(1);
  mut(y) := i32(1);
  m := &mut x;
  mut(a) := &mut y;
  a = m;
  a.* = i32(2);
  y = i32(3);
  println(`OUT: ${x.to_string()} ${y.to_string()}`);
});
export(main);
