// expect: accept
// h6e's positive twin: the holder is moved on every path, so its drop ran in `finish` and the root is free after it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p)));
impl(
  generic(p : Origin),
  H(p),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      n := self.r.*.*.s.len();
      println(`H dropped, read len ${n.to_string()}`);
    })
  )
);
impl(generic(p : Origin), H(p), finish : (fn(self : Self) -> unit)(()));
sink :: (fn(v : Rc(X)) -> unit)({
  println(`sink ${v.*.s.len().to_string()}`);
});
main :: (fn() -> unit)({
  y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  h := H(y)(r : &y);
    h.finish();
  sink(y);
  println("end of main");
  ()
});
export(main);
