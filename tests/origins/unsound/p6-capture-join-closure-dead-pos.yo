// expect: accept
// Positive twin of p6-capture-join-closure-dead: the slot is cleared before `x` is reassigned
// (the `=` join kills over reaching definitions).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
put :: (fn(generic(p : Origin), dst : &mut Option(&(Rc(X), p)), v : &(Rc(X), p)) -> unit)({
  dst.* = .Some(v);
});
main :: (fn() -> unit)({
  mut(x) := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  mut(slot) := Option(&Rc(X)).None;
  {
    (mut(c) : Impl(FnMut() -> unit)) = ({ s : &mut slot, rx : &x }() => {
      put(&mut s.*, rx);
    });
    c();
  };
  match(&slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  slot = .None;
  x = Rc.new(X(s : String.from("y")));
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
