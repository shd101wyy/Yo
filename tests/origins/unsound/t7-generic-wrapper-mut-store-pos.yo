// expect: accept
// The positive twin of t7-generic-wrapper-mut-store: the stored holder points at an outer place.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X));
W :: (fn(comptime(Y) : Type) -> comptime(Type))(struct(inner : Y));
put :: (fn(generic(T : Type), w : W(&mut Option(T)), v : T) -> unit)({
  w.inner.* = .Some(v);
});
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  x2 := Rc.new(X(s : String.from("x2")));
  mut(slot) := Option(H).Some(H(r : &x));
  {
    y := Rc.new(X(s : String.from("y")));
    put(W(&mut Option(H))(inner : &mut slot), H(r : &x2));
    println(`y ${y.*.s.len().to_string()}`);
  };
  match(slot, .Some(h) => println(`OUT: ${h.r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
