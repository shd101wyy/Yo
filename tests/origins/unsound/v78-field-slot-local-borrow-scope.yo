// expect: E0911
// VERDICTS-78 Q1: `p := &mut h.r` borrows the field itself as a `&mut &T`; `p.* = &y` re-points
// `h.r`, charged to `h`, which outlives `y` (test 7 probe holders/f07).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
main :: (fn() -> unit)({
  z := mk();
  mut(h) := H(r : &z, n : i32(0));
  {
    y := mk();
    p := &mut h.r;
    p.* = &y;
  };
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
});
export(main);
