// expect: E0911
// P3 (ASan form): a write through a `&mut &T` stores a reference to an inner-scoped String into `r`, which is read after the String is dropped.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  outer := String.from("outer");
  mut(r) := &outer;
  {
    inner := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
    rp := &mut r;
    ri := &inner;
    rp.* = ri;
  };
  println(`OUT: ${r.*.len().to_string()}`);
  ()
});
export(main);
