// expect: E0910
// A closure borrows `xs` through `{ r : &xs }`; `xs.clear()`, a `&mut self` receiver, lends `xs` exclusively and
// frees the element the closure then reads through its capture.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  (g : Impl(Fn() -> usize)) = ({ r : &xs }() => r(usize(0)).len());
  xs.clear();
  xs.push(String.from("z"));
  println(`OUT: ${g().to_string()}`);
});
export(main);
