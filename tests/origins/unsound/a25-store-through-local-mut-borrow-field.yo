// expect: E0911
// The field-write form: `p.o = .Some(&y)` through `p := &mut h` joins `p`, not `h`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(o : Option(&Rc(X)), n : i32);
main :: (fn() -> unit)({
  mut(h) := H(o : .None, n : i32(0));
  {
    y := mk();
    p := &mut h;
    p.o = .Some(&y);
  };
  match(&h.o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
});
export(main);
