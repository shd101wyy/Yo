// expect: E0911
// Two forwarding hops (`fwd2` returns `fwd(w, io)`): the result is still rooted at the caller's `w`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
W :: struct(s : String);
impl(W, show : (fn(self : &Self, io : Io) -> Impl(Future(unit, Io)))(
  io.async({ self : &self.* }(io : Io) => {
    io.await(yield(io), io);
    println(`OUT: ${self.*.s}`);
  })
));
fwd :: (fn(w : &W, io : Io) -> Impl(Future(unit, Io)))(w.show(io));
eat :: (fn(w : W) -> unit)(());
LONG :: "0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz";
fwd2 :: (fn(a : i32, w : &W, io : Io) -> Impl(Future(unit, Io)))(fwd(w, io));
main :: (fn(io : Io) -> unit)({
  w := W(s : String.from(LONG));
  f := fwd2(i32(1), &w, io);
  eat(w);
  io.await(f, io);
});
export(main);
