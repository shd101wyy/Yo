// expect: E0911
// The guard writes the scrutinee through a call (test 7, probe g02b): `kill(&mut o)` is an exclusive access of `o`
// while `s` is live into the arm.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
kill :: (fn(p : &mut Option(Box(String))) -> unit)({
  p.* = .None;
});
peek :: (fn(p : &Option(Box(String))) -> bool)(p.is_some());
main :: (fn() -> unit)({
  mut(o) := Option(Box(String)).Some(Box.new(L()));
  match(
    &mut o,
    (
      .Some(Box(s)) && {
        kill(&mut o);
        true
      }
    ) => println(`OUT: ${s}`),
    _ => ()
  );
  ()
});
export(main);
