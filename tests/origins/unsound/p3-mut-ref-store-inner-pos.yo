// expect: accept
// p3-mut-ref-store-inner's positive twin: `r`'s last use is inside the inner scope, before `inner` dies.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  outer := String.from("outer");
  mut(r) := &outer;
  {
    inner := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
    rp := &mut r;
    ri := &inner;
    rp.* = ri;
    println(`OUT: ${r.*.len().to_string()}`);
  };
  ()
});
export(main);
