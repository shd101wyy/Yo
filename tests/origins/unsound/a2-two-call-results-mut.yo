// expect: E0910
// Audit A2 (row 1): two arguments of one call are call RESULTS that each carry a `&mut` loan of `x`. The first result is a loan the call holds from its evaluation until the call returns, so the second argument's `&mut x` is an access against it; `both` clears the payload through `b` and reads it through `a`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
idm :: (fn(r : &mut Option(Rc(X))) -> &mut Option(Rc(X)))(&mut r.*);
both :: (fn(a : &mut Option(Rc(X)), b : &mut Option(Rc(X))) -> usize)(
  match(
    a,
    .Some(p) => {
      b.* = .None;
      p.*.s.len()
    },
    .None => usize(0)
  )
);
mk :: (fn() -> Option(Rc(X)))(.Some(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")))));
main :: (fn() -> unit)({
  mut(x) := mk();
  n := both(idm(&mut x), idm(&mut x));
  println(`OUT: ${n.to_string()}`);
  ()
});
export(main);
