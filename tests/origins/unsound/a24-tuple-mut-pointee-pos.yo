// expect: accept
// a24-tuple-mut-pointee's positive twin: the slot is spelled over `(x, x2)`, both declared before it, and the stored reference is into `x2`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
put :: (fn(generic(p : Origin), w : Tuple(&mut Option(&(Rc(X), p)), i32), v : &(Rc(X), p)) -> unit)({
  w.0.* = .Some(v);
});
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  x2 := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  mut(slot) := Option(&(Rc(X), (x, x2))).Some(&x);
  put((&mut slot, i32(0)), &x2);
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
