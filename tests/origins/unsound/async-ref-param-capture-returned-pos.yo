// expect: accept
// An `io.async` body copies the `&P` parameter (`{ p }`, VERDICTS-44): the future borrows the
// parameter, so returning it forwards the parameter's origin to the caller, which awaits it while
// `n` lives (the corpus row async-captures-ref-param, run).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
P :: struct(s : String);
probe :: (fn(p : &P, io : Io) -> Impl(Future(usize, Io)))(
  io.async({ p }(io : Io) => p.s.len())
);
main :: (fn(io : Io) -> unit)({
  n := P(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  fut := probe(&n, io);
  println(`OUT: ${io.await(fut, io).to_string()}`);
});
export(main);
