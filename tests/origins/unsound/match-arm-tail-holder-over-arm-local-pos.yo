// expect: accept
// Positive twin of match-arm-tail-holder-over-arm-local: the arm block has a local of its own, but the holder it
// yields points at `z`, declared before the `match`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X), n : i32);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  z := mk();
  k := i32(1);
  h := match(
    k,
    1 => {
      y := mk();
      _ := y.s.len();
      H(r : &z, n : i32(1))
    },
    _ => H(r : &z, n : i32(0))
  );
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
  ()
});
export(main);
