// expect: E0901
// VERDICTS-76 row 20: after `{ m }` moves `m` into the closure, a write through `m` while the closure lives would be a second `&mut` to `x`.
main :: (fn() -> unit)({
  mut(x) := i32(1);
  m := &mut x;
  (f : Impl(FnOnce() -> unit)) = ({ m }() => {
    m.* = i32(2);
  });
  m.* = i32(3);
  f();
});
export(main);
