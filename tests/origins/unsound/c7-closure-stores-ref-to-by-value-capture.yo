// expect: E0912
// The closure twin: the closure dies at the end of the inner block with its by-value capture,
// and `slot` still holds `&owned` (stack-use-after-scope).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
store :: (fn(generic(r : Origin), dst : &mut Option(&(String, r)), v : &(String, r)) -> unit)({
  dst.* = .Some(v);
});
main :: (fn() -> unit)({
  mut(slot) := Option(&String).None;
  owned := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  {
    (mut(c) : Impl(FnMut() -> unit)) = ({ s : &mut slot, owned }() => {
      store(&mut s.*, &owned);
    });
    c();
  };
  match(slot, .Some(r) => println(`OUT: ${r.*}`), .None => println("none"));
});
export(main);
