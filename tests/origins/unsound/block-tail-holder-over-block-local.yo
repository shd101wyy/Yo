// expect: E0911
// A12 at a block tail (VERDICTS-58 decision 12): a holder over the block's own local `y` is the block's value; `y`
// drops at the block's end and `h` is read after it (heap-use-after-free under ASan when the rejection is missing).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X), n : i32);
main :: (fn() -> unit)({
  h := {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    H(r : &y, n : i32(1))
  };
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
  ()
});
export(main);
