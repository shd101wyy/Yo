// expect: E0911
// VERDICTS-37 Q1 (e): the caller-side negative of fn-store-elided-params-pos. `store` spells one
// origin for both parameters, so its body is valid; the caller's block-local `k` is lent into
// `slot`, which outlives the block, and the write-back at the call rejects it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
store :: (fn(generic(p : Origin), v : &(Rc(X), p), s : &mut Option(&(Rc(X), p))) -> unit)({
  s.* = .Some(v);
});
main :: (fn() -> unit)({
  mut(slot) := Option(&Rc(X)).None;
  {
    k := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    store(&k, &mut slot);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
