// expect: E0911
// t7-generic-wrapper-mut-store through a tuple-wrapped `&mut` (`Tuple(&mut Option(T), i32)`).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X));
put :: (fn(generic(T : Type), w : Tuple(&mut Option(T), i32), v : T) -> unit)({
  w.0.* = .Some(v);
});
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  mut(slot) := Option(H).Some(H(r : &x));
  {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    put((&mut slot, i32(0)), H(r : &y));
  };
  match(slot, .Some(h) => println(`OUT: ${h.r.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
