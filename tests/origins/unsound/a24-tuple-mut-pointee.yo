// expect: E0923
// The same widening through a tuple component: `w : Tuple(&mut Option(&(Rc(X), p)), i32)` passed by value.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
put :: (fn(generic(p : Origin), w : Tuple(&mut Option(&(Rc(X), p)), i32), v : &(Rc(X), p)) -> unit)({
  w.0.* = .Some(v);
});
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  mut(slot) := Option(&(Rc(X), x)).Some(&x);
  {
    y := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    put((&mut slot, i32(0)), &y);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
