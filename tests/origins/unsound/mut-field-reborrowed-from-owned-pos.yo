// expect: accept
// `M(r : m.r, …)` reborrows `m.r.*`: the new holder writes through it while it lives, and `m` is
// read again only after its last use.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
M :: struct(r : &mut Box(X), n : i32);
H :: struct(p : &X);
big :: (fn() -> Box(X))(Box.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  mut(x) := big();
  m := M(r : &mut x, n : i32(0));
  m2 := M(r : m.r, n : i32(1));
  m2.r.* = Box.new(X(s : String.from("b")));
  h := H(p : &m.r.*.*);
  println(`OUT: ${h.p.*.s.len().to_string()}`);
});
export(main);
