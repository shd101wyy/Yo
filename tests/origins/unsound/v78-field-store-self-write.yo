// expect: E0911
// VERDICTS-78 Q1 edge 2: `h.r = &h.s` makes `h` borrow `h.s`; growing `h.s` while `h.r` is read
// later is rejected.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: struct(r : &Rc(X), n : i32);
S :: struct(s : String, r : &String);
main :: (fn() -> unit)({
  other := String.from("0123456789abcdefghijklmnopqrstuvwxyz");
  mut(h) := S(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789"), r : &other);
  h.r = &h.s;
  h.s.push_str("0123456789abcdefghijklmnopqrstuvwxyz0123456789");
  println(`OUT: ${h.r.*.len().to_string()}`);
});
export(main);
