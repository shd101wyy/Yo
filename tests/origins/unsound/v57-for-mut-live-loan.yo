// expect: E0911
// VERDICTS-57 §3.1: `for(&mut xs, …)` lowers to `(&mut xs).into_iter()`, whose `self : Self` is a by-value
// `&mut` slot: making the `&mut` reference value is a write of `xs`, so the live `&` loan `r` conflicts.
// Accepted since #1876 (heap-use-after-free: the walk replaces the list `r` points into).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(inner) := ArrayList(String).new();
  inner.push(String.from("hello-world-hello-world-hello-world"));
  mut(xs) := ArrayList(ArrayList(String)).new();
  xs.push(inner);
  r := xs.index(usize(0)).index(usize(0));
  for(&mut xs, x => {
    x.* = ArrayList(String).new();
  });
  println(`OUT: ${r.*}`);
  ()
});
export(main);
