// expect: E0911
// The owned form: `M(r : m.r, …)` copies the `&mut` field out of the local `m` and leaves `m` usable
// (no move of `m.r`, no freeze of `m`).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
M :: struct(r : &mut Box(X), n : i32);
H :: struct(p : &X);
big :: (fn() -> Box(X))(Box.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  mut(x) := big();
  m := M(r : &mut x, n : i32(0));
  m2 := M(r : m.r, n : i32(1));
  h := H(p : &m.r.*.*);
  m2.r.* = Box.new(X(s : String.from("b")));
  println(`OUT: ${h.p.*.s.len().to_string()}`);
});
export(main);
