// expect: E0911
// A12 at a `cond` arm tail (VERDICTS-58 decision 12): an arm block's value is a holder over the arm block's own local
// `y`, dropped at the arm block's end while `h` is read after it (heap-use-after-free under ASan when the rejection
// is missing).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X), n : i32);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
pick :: (fn(c : bool) -> usize)({
  z := mk();
  h := cond(
    c => {
      y := mk();
      H(r : &y, n : i32(1))
    },
    true => H(r : &z, n : i32(0))
  );
  h.r.s.len()
});
main :: (fn() -> unit)({
  println(`OUT: ${pick(true).to_string()}`);
});
export(main);
