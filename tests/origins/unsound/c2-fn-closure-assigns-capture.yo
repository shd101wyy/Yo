// expect: E0913
// An `Fn` closure lent to `&Impl(Fn() -> unit)` reassigns its implicit capture `r`, a counted handle. The literal
// borrows its captures, so the record holds an uncounted copy of `r`: the assignment releases the payload `r` still
// owns, and `r` is read and released again after the call
// (issues/fixed/2026-10-23-an-fn-closure-that-reassigns-a-capture-releases-the-old-value-twice.md).
{ println } :: import("std/fmt");
{ String } :: import("std/string");
W :: struct(s : String);
call_it :: (fn(act : &Impl(Fn() -> unit)) -> unit)({
  act();
});
main :: (fn() -> unit)({
  mut(r) := Rc.new(W(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  call_it(
    &(
      () => {
        r = Rc.new(W(s : String.from("bye")));
      }
    )
  );
  println(`OUT: ${r.*.s}`);
});
export(main);
