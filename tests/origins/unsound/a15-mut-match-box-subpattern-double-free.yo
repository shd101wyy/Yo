// expect: E0901
// The same with `Box(mut(s))`: the arm replaces the box, then writes `s`, which drops the String
// the replacement already freed: double free.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  mut(b) := Box.new(L());
  match(
    &mut b,
    Box(mut(s)) => {
      b = Box.new(L());
      s = String.from("w");
    }
  );
  ()
});
export(main);
