// expect: E0911
// A struct holder re-pointed at a `for` body's local and read at the top of the next iteration.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &X, n : i32);
mk :: (fn() -> Box(X))(Box.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
main :: (fn() -> unit)({
  a := mk();
  mut(h) := H(r : &a.*, n : i32(0));
  for(i32(0) .. i32(3), i => {
    println(`OUT: ${h.r.*.s.len().to_string()}`);
    y := mk();
    h = H(r : &y.*, n : i);
  });
  ()
});
export(main);
