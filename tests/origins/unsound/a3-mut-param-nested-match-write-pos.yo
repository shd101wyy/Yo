// expect: accept
// Audit A3 (VERDICTS-71 rule (c), r2's positive twin): the write through `cur` after the nested binding's last use.
{ println } :: import("std/fmt");
BNode :: struct(value : i32, next : Option(Box(Self)));
BList :: struct(head : Option(Box(BNode)));
f :: (fn(cur : &mut Option(Box(BNode))) -> unit)({
  match(
    cur,
    .Some(n) => match(
      &mut n.next,
      .Some(m) => {
        m.value = i32(4);
        cur.* = .None;
      },
      .None => ()
    ),
    .None => ()
  );
});
main :: (fn() -> unit)({
  mut(l1) := BList(head : .Some(Box.new(BNode(value : i32(1), next : .Some(Box.new(BNode(value : i32(2), next : .None)))))));
  f(&mut l1.head);
  println(`OUT: ${l1.head.is_some().to_string()}`);
});
export(main);
