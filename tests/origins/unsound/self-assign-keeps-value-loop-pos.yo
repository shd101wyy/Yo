// expect: accept
// `x = x` in a loop body drops nothing (it freed the buffer on the first
// iteration and again on the second: a double free).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(x) := String.from("payload-0123456789abcdefghijklmnop");
  mut(i) := i32(0);
  while(i < i32(3), {
    x = x;
    i = (i + i32(1));
  });
  println(`OUT ${x}`);
});
export(main);
