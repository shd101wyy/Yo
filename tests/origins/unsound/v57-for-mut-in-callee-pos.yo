// expect: accept
// Positive twin of v57-for-mut-in-callee: the loan's last use is before the call.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
overwrite :: (fn(b : &mut ArrayList(ArrayList(String))) -> unit)({
  for(&mut b.*, x => {
    x.* = ArrayList(String).new();
  });
});
main :: (fn() -> unit)({
  mut(inner) := ArrayList(String).new();
  inner.push(String.from("hello-world-hello-world-hello-world"));
  mut(xs) := ArrayList(ArrayList(String)).new();
  xs.push(inner);
  r := xs.index(usize(0)).index(usize(0));
  println(`OUT: ${r.*}`);
  overwrite(&mut xs);
  println(`OUT: ${xs.len().to_string()}`);
  ()
});
export(main);
