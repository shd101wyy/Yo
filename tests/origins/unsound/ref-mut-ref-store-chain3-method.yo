// expect: E0911
// The method form of the depth-3 chain store (A28 q3a at depth 3).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
S :: struct(n : i32);
impl(
  S,
  set : (fn(generic(p : Origin), self : &Self, dst : &mut&(Rc(X), p), v : &(Rc(X), p)) -> unit)({
    dst.* = v;
  })
);
main :: (fn() -> unit)({
  outer := mk();
  s := S(n : i32(0));
  mut(r) := &outer;
  mut(rp) := &mut r;
  {
    inner := mk();
    rpp := &mut rp;
    rppp := &mut rpp;
    s.set(&mut rppp.*.*.*, &inner);
  };
  println(`OUT: ${r.*.*.s.len().to_string()}`);
});
export(main);
