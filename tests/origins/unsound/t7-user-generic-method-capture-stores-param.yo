// expect: E0923
// A USER generic container's `&mut self` method on an FnMut closure's `&mut` capture stores the per-call `v`.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
Cell1 :: (fn(comptime(T) : Type) -> comptime(Type))(struct(v : Option(T)));
impl(
  generic(T : Type),
  Cell1(T),
  put : (fn(self : &mut Self, x : T) -> unit)({
    self.v = .Some(x);
  })
);
each :: (fn(f : &mut Impl(FnMut(v : &Rc(X)) -> unit)) -> unit)({
  k := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  f(&k);
});
main :: (fn() -> unit)({
  mut(c) := Cell1(&Rc(X))(v : .None);
  each(
    &mut ({ s : &mut c }(v : &Rc(X)) => {
      s.put(v);
    })
  );
  match(c.v, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
});
export(main);
