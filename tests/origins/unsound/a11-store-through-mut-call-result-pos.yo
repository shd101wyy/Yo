// expect: accept
// Positive control: the stored reference points into `zs`, declared before `s`, so it
// outlives every read of `s`.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
S2 :: struct(o : Option(&String), n : i32);
slot :: (fn(s : &mut S2) -> &mut Option(&String))(&mut s.o);
main :: (fn() -> unit)({
  x := long();
  mut(zs) := ArrayList(String).new();
  zs.push(long());
  mut(s) := S2(o : .Some(&x), n : i32(0));
  {
    slot(&mut s).* = .Some(zs.index(usize(0)));
  };
  match(&s.o, .Some(r) => println(`OUT: ${r.*.clone()}`), .None => ());
});
export(main);
