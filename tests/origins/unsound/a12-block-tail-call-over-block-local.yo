// expect: E0911
// A12's call form (audit calls u02/u07): the block's tail is a call whose result borrows the block's own
// `u`; `u` is dropped at the block's end while `h` is read after it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
H :: struct(r : &Rc(X), n : i32);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
wrap :: (fn(r : &Rc(X)) -> H)(H(r : r, n : i32(1)));
main :: (fn() -> unit)({
  h := {
    u := mk();
    wrap(&u)
  };
  println(`OUT: ${h.r.*.*.s.len().to_string()}`);
  ()
});
export(main);
