// expect: accept
// generic-erased-lending-result-receiver-written's positive twin: `a` is read before `clear_v` frees the buffer.
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
_Getter :: trait(get : (fn(self : &mut Self) -> Option(&i32)), clear_v : (fn(self : &mut Self) -> unit));
_Lend :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(i32, p), v : ArrayList(i32)));
impl(
  generic(p : Origin),
  _Lend(p),
  _Getter(
    get : (fn(self : &mut Self) -> Option(&i32))(
      cond((self.v.len() > usize(0)) => .Some(&self.v(usize(0))), true => .None)
    ),
    clear_v : (fn(self : &mut Self) -> unit)({
      self.v = ArrayList(i32).new();
    })
  )
);
_use :: (fn(generic(T : Type), t : &mut T, where(T <: _Getter)) -> i32)({
  a := t.get();
  n := match(a, .Some(r) => r.*, .None => i32(0));
  t.clear_v();
  n
});
main :: (fn() -> unit)({
  x := i32(1);
  mut(l) := _Lend(x)(r : &x, v : ArrayList(i32).new());
  l.v.push(i32(7));
  println(&_use(&mut l));
  ()
});
export(main);
