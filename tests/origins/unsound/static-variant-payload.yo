// expect: E0923
// A holder typed over static initialized with &b; b dropped while it is live (the audit program).
// VERDICTS-74 rule 2: the empty origin is checked — only values that borrow no
// place flow into it. Found by the borrow/ownership audit (yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
main :: (fn() -> unit)({
  b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  o := Option(&(Rc(X), static)).Some(&b);
  drop(b);
  match(o, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
