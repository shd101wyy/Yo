// expect: E0923
// The invariant holder widened inside a TUPLE result (`Tuple(Slot((p, q)), i32)`).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
Slot :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(dst : &mut Option(&(Rc(X), p))));
View :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p)));
put :: (fn(generic(p : Origin), s : &mut Slot(p), v : &(Rc(X), p)) -> unit)({
  s.dst.* = .Some(v);
});
LONG :: "0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz";
widen2 :: (fn(generic(p : Origin, q : Origin), s : Slot(p), w : &(Rc(X), q)) -> Tuple(Slot((p, q)), i32))((s, i32(1)));
main :: (fn() -> unit)({
  x := Rc.new(X(s : String.from("x")));
  mut(slot) := Option(&(Rc(X), x)).Some(&x);
  {
    y := Rc.new(X(s : String.from(LONG)));
    mut(t) := widen2(Slot(x)(dst : &mut slot), &y);
    put(&mut t.0, &y);
  };
  match(slot, .Some(r) => println(`OUT: ${r.*.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
