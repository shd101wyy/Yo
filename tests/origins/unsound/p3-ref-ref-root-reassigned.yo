// expect: E0911
// P3 (ASan form): a `&&T` reads through `r` into `s`, and `s` is reassigned (its old heap buffer freed) while `rr` lives.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(s) := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  r := &s;
  rr := &r;
  s = String.from("b");
  println(`OUT: ${rr.*.*.len().to_string()}`);
  ()
});
export(main);
