// expect: E0922
// A module-level alias of &(Rc(X), static) used for a holder field.
// VERDICTS-57 §1: the v0.2.77 wall (E0923 once v0.2.78 checks `static`; P12). Found by the borrow/ownership audit (yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
SRef :: &(Rc(X), static);
H :: struct(r : SRef);
main :: (fn() -> unit)({
  mut(o) := Option(H).None;
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    o = .Some(H(r : &b));
  };
  match(o, .Some(h) => println(`OUT: ${h.r.*.s.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
