// expect: E0911
// The write walk inside a callee: `overwrite`'s body makes a `&mut` reference value of its parameter's storage,
// so its summary sets `lends_mut` and the `&mut xs` argument is a write against the live loan `r`.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
overwrite :: (fn(b : &mut ArrayList(ArrayList(String))) -> unit)({
  for(&mut b.*, x => {
    x.* = ArrayList(String).new();
  });
});
main :: (fn() -> unit)({
  mut(inner) := ArrayList(String).new();
  inner.push(String.from("hello-world-hello-world-hello-world"));
  mut(xs) := ArrayList(ArrayList(String)).new();
  xs.push(inner);
  r := xs.index(usize(0)).index(usize(0));
  overwrite(&mut xs);
  println(`OUT: ${r.*}`);
  ()
});
export(main);
