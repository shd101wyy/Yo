// expect: E0923
// A future's origin spelled static: Impl(Future(usize, Io, static)) over a reference parameter.
// VERDICTS-57 §1.4, P12: `static` is checked (`o ⊆ static` iff `o = static`); E0922 in v0.2.77. Found by the borrow/ownership audit (yo-6c).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
len_later :: (fn(x : &Rc(X), io : Io) -> Impl(Future(usize, Io, static)))(
  io.async((io : Io) => x.*.s.len())
);
main :: (fn(using(io : Io)) -> unit)({
  mut(f) := Option(Impl(Future(usize, Io, static))).None;
  {
    b := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
    f = .Some(len_later(&b, io));
  };
  match(f, .Some(t) => println(`OUT: ${io.await(t).to_string()}`), .None => println("none"));
  ()
});
export(main);
