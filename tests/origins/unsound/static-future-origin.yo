// expect: E0923
// A future's origin spelled static: Impl(Future(usize, Io, static)) over a
// captured holder of a reference parameter.
// VERDICTS-74 rule 2: the empty origin is checked — only values that borrow no
// place flow into it. Found by the borrow/ownership audit (yo-6c); the
// audit's `&Rc(X)` capture now trips the capture-move rule (E0901) first, so
// the row captures an `Option(&X)` (the future holds the borrow through a
// captured value), which reaches the spelled origin.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
len_later :: (fn(x : Option(&X), io : Io) -> Impl(Future(usize, Io, static)))(
  io.async((io : Io) => match(x, .Some(r) => r.s.len(), .None => usize(0)))
);
main :: (fn(io : Io) -> unit)({
  {
    b := X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
    (f2 : Impl(Future(usize, Io, static))) = len_later(.Some(&b), io);
    println(`OUT: ${io.await(f2).to_string()}`)
  };
  ()
});
export(main);
