// expect: accept
// p9-two-phase-loan-used-after's positive twin: `e`'s last use is the push's own argument, so it has ended when the push begins.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
_first :: (fn(xs : &ArrayList(String)) -> &String)(&xs(usize(0)));
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
  e := _first(&xs);
  xs.push(e.clone());
  println(`OUT: ${xs(usize(1)).len().to_string()}`);
  ()
});
export(main);
