// expect: accept
// guard-off: DIRTY heap-use-after-free
// Unsafe-capable code (outside claim (S)): tests/rc.test.yo's Stage 0 row. An
// `Rc` field projection `&w.b` lent to a callee that reassigns the field in a
// loop through a raw pointer to the container; the guard's +1 keeps the
// borrowed box alive.
pragma(Pragma.AllowUnsafe);
{ println } :: import("std/fmt");
AliasWrap :: struct(b : Rc(i32));
poke_loop :: (fn(w : *AliasWrap, borrowed : &Rc(i32)) -> unit)({
  (mut(i) : i32) = i32(0);
  while(i < i32(2), {
    w.*.b = Rc.new(i32(100) + i);
    i = (i + i32(1));
  });
  println(`OUT: ${borrowed.*.*}`);
});
main :: (fn() -> unit)({
  mut(w) := AliasWrap(b : Rc.new(i32(42)));
  poke_loop(addr_of(w), &w.b);
});
export(main);
