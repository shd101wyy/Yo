// expect: E0916
// A place behind a module-level `Rc` (`&G.*`) lent to a callee that resets
// the global by name: the guard skips a bare name, so decision 18's
// global-lend rule is what must reject it.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
W :: struct(s : String);
(mut(G) : Rc(W)) = Rc.new(W(s : String.from("initial")));
reset :: (fn() -> unit)({
  G = Rc.new(W(s : String.from("replacement, a string long enough to live on the heap")));
});
peek :: (fn(w : &W) -> unit)({
  reset();
  println(`OUT: ${w.s.clone()}`);
});
main :: (fn() -> unit)({
  G = Rc.new(W(s : String.from("hello, a string long enough to live on the heap")));
  peek(&G.*);
});
export(main);
