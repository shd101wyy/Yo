// expect: accept
// The guard inside a state machine: an `io.async` body lends a receiver
// reached through an `Rc` element across a closure argument, with a
// suspension on each side of the call.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
W :: struct(s : String);
impl(
  W,
  peek : (fn(self : &Self, act : &mut Impl(FnMut() -> unit)) -> unit)({
    act();
    println(`OUT: ${self.s.clone()}`);
  })
);
task :: (fn(io : Io) -> Impl(Future(usize, Io)))(
  io.async((io : Io) => {
    mut(hs) := ArrayList(Rc(W)).new();
    hs.push(Rc.new(W(s : String.from("hello, a string long enough to live on the heap"))));
    mut(other) := ArrayList(Rc(W)).new();
    other.push(Rc.clone(hs(usize(0))));
    io.await(yield(io), io);
    hs(usize(0)).*.peek(
      &mut (
        () => {
          other.clear();
        }
      )
    );
    io.await(yield(io), io);
    hs.len()
  })
);
main :: (fn(io : Io) -> unit)({
  println(`OUT: ${io.await(task(io), io)}`);
});
export(main);
