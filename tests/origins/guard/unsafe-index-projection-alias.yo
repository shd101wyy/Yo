// expect: DIRTY heap-use-after-free
// Unsafe-capable code (outside claim (S)). An element of a fixed-size array of
// `Rc`s lent to a callee that replaces the element through a raw pointer to
// the container. No count is taken for a lend, so the borrowed box is freed
// under the callee.
pragma(Pragma.AllowUnsafe);
{ println } :: import("std/fmt");
Arr :: struct(a : Array(Rc(i32), 2));
poke_index :: (fn(h : *Arr, borrowed : &Rc(i32)) -> unit)({
  (mut(i) : i32) = i32(0);
  while(i < i32(2), {
    h.*.a(0) = Rc.new(i32(100) + i);
    i = (i + i32(1));
  });
  println(`OUT: ${borrowed.*.*}`);
});
main :: (fn() -> unit)({
  mut(h) := Arr(a : Array(Rc(i32), 2)(Rc.new(i32(42)), Rc.new(i32(7))));
  poke_index(addr_of(h), &h.a(0));
});
export(main);
