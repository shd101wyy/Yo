// expect: accept
// guard-off: DIRTY heap-use-after-free
// A user newtype over a cell (`TRc`, tests/fixtures/cell-handles.yo) as a list
// element: a receiver reached through it, and a `&` argument through it,
// outlive a closure that empties the list through the fixture's unchecked
// second name (`talias`/`tclear`, unsafe-capable code). The guard's +1 on the
// handle is what keeps the cell alive (tests/cell-handles.test.yo). A `&`
// parameter is a copy of the caller's value, so the probe reads the payload's
// heap buffer (`s`), which the cell's destruction frees.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");
{ TRc, trc, talias, tclear } :: import("../../fixtures/cell-handles.yo");
(mut(drops) : i32) = i32(0);
C :: struct(n : i32, s : String);
impl(
  C,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      drops = (drops + i32(1));
    })
  )
);
impl(
  C,
  peek : (fn(self : &Self, act : &Impl(Fn() -> unit)) -> i32)({
    act();
    println(`OUT: ${self.s.clone()}`);
    drops + self.n
  })
);
peek :: (fn(c : &C, act : &Impl(Fn() -> unit)) -> i32)({
  act();
  println(`OUT: ${c.s.clone()}`);
  drops + c.n
});
main :: (fn() -> unit)({
  mut(hs) := ArrayList(TRc(C)).new();
  hs.push(trc(C(n : i32(10), s : String.from("first payload, a string long enough to live on the heap"))));
  hs2 := talias(&mut hs);
  a := hs(usize(0)).*.peek(
    &(
      () => {
        tclear(&hs2);
      }
    )
  );
  hs.push(trc(C(n : i32(20), s : String.from("second payload, a string long enough to live on the heap"))));
  b := peek(
    &hs(usize(0)).*,
    &(
      () => {
        tclear(&hs2);
      }
    )
  );
  d := drops;
  println(`OUT: ${a} ${b} ${d}`);
});
export(main);
