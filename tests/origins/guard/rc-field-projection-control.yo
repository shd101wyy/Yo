// expect: accept
// guard-off: same
// Control: an `Rc` field projection (`s.h`) and a place in its payload
// (`s.h.*`) lent to borrowing parameters, with a closure that drops a second
// handle to the same cell. The first handle keeps the cell alive.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
W :: struct(s : String);
S :: struct(h : Rc(W));
peek_handle :: (fn(h : &Rc(W), act : Impl(FnOnce() -> unit)) -> unit)({
  act();
  println(`OUT: ${h.*.*.s.clone()}`);
});
peek_payload :: (fn(w : &W, act : Impl(FnOnce() -> unit)) -> unit)({
  act();
  println(`OUT: ${w.s.clone()}`);
});
main :: (fn() -> unit)({
  s := S(h : Rc.new(W(s : String.from("hello, a string long enough to live on the heap"))));
  second := Rc.clone(s.h);
  peek_handle(&s.h, { second }() => {
    drop(second);
  });
  third := Rc.clone(s.h);
  peek_payload(&s.h.*, { third }() => {
    drop(third);
  });
});
export(main);
