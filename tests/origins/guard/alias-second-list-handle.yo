// expect: E0901
// guard-off: same
// The 2026-10-23 alias form: a second name for the list (`hs2 := hs`) cleared
// by a closure while a receiver reached through an element's `Rc` is borrowed.
// A list is unique, so the second name is a move and the later use is E0901.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");
W :: struct(s : String);
impl(
  W,
  peek : (fn(self : &Self, act : &Impl(Fn() -> unit)) -> unit)({
    act();
    println(`OUT: ${self.s.clone()}`);
  })
);
main :: (fn() -> unit)({
  mut(hs) := ArrayList(Rc(W)).new();
  hs.push(Rc.new(W(s : String.from("hello, a string long enough to live on the heap"))));
  mut(hs2) := hs;
  hs(usize(0)).peek(
    &(
      () => {
        hs2.clear();
      }
    )
  );
});
export(main);
