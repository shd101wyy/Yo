// expect: reject
// guard-off: same
// The `FnMut` form of the global reset: a borrow capture cannot name a
// module-level binding (decision 18 rule 3).
{ String } :: import("std/string");
{ println } :: import("std/fmt");
W :: struct(s : String);
S :: struct(h : Rc(W));
impl(
  W,
  peek : (fn(self : &Self, act : &mut Impl(FnMut() -> unit)) -> unit)({
    act();
    println(`OUT: ${self.s.clone()}`);
  })
);
(mut(G) : Option(Rc(S))) = .None;
main :: (fn() -> unit)({
  G = .Some(Rc.new(S(h : Rc.new(W(s : String.from("hello, a string long enough to live on the heap"))))));
  match(
    &G,
    .Some(g) => g.h.peek(
      &mut ({ &mut G }() => {
        G = .None;
      })
    ),
    .None => ()
  );
});
export(main);
