// expect: accept
// guard-off: same
// Control: a receiver reached through an `Rc` element of a list (the guard's
// +1 goes on the handle) with a closure argument that touches another list.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");
W :: struct(s : String);
impl(
  W,
  peek : (fn(self : &Self, act : &mut Impl(FnMut() -> unit)) -> unit)({
    act();
    println(`OUT: ${self.s.clone()}`);
  })
);
main :: (fn() -> unit)({
  mut(hs) := ArrayList(Rc(W)).new();
  hs.push(Rc.new(W(s : String.from("hello, a string long enough to live on the heap"))));
  mut(other) := ArrayList(Rc(W)).new();
  other.push(Rc.clone(hs(usize(0))));
  hs(usize(0)).*.peek(
    &mut ({ &mut other }() => {
      other.clear();
    })
  );
  println(`OUT: ${hs.len()} ${other.len()}`);
});
export(main);
