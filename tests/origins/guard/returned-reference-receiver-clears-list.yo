// expect: E0910
// guard-off: same
// Rejected since the capture-list fix: issues/fixed/2026-11-21-a-closures-mut-capture-list-entry-is-not-checked-against-the-loans-of-the-calls-other-arguments.md
// A receiver reached through a reference a function returns (`first(&hs)`,
// an `Rc` element of the list) with a closure argument whose capture list
// lends the list `&mut` and clears it. Accepted and dirty with the guard on:
// the guard's place walk stops at a call's result, so it takes no +1. The
// right verdict is E0910 (the issue).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");
W :: struct(s : String);
impl(
  W,
  peek : (fn(self : &Self, act : &mut Impl(FnMut() -> unit)) -> unit)({
    act();
    println(`OUT: ${self.s.clone()}`);
  })
);
first :: (fn(xs : &ArrayList(Rc(W))) -> &Rc(W))(&xs(usize(0)));
main :: (fn() -> unit)({
  mut(hs) := ArrayList(Rc(W)).new();
  hs.push(Rc.new(W(s : String.from("hello, a string long enough to live on the heap"))));
  first(&hs).peek(
    &mut ({ &mut hs }() => {
      hs.clear();
    })
  );
});
export(main);
