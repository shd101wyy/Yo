{ assert } :: import("std/assert");
{ Thread } :: import("std/thread");
{ Mutex } :: import("std/sync/mutex");
{ AtomicI32, MemoryOrder } :: import("std/sync/atomic");
{ ArrayList } :: import("std/collections/array_list");
{ platform, Platform } :: import("std/process");
{ __yo_async_blocking_begin } :: import("std/sys/externs.yo");
/// The parallelism-soundness corpus (`plans/archive/PARALLELISM_SOUNDNESS.md`, Phase 0).
///
/// One `comptime_expect_error` block per rule the plan's phases add, and one
/// over-rejection canary per rule so a gate cannot land by rejecting the legal
/// shape next to it. Every block names the rule (`plans/reference/PARALLELISM_RULES.md`)
/// it pins. A phase that lands a rule ADDS its rejection blocks here; nothing
/// in this file is wrapped or skipped, so the file is green at every commit.
///
/// This file has NO `pragma(Pragma.AllowUnsafe)` on purpose: every rule here
/// is a safe-mode rule, and the pragma would switch all of them off.
Counter :: struct(n : i32);
impl(
  Counter,
  bump : (fn(inout(self) : Self) -> unit)({
    self.n = (self.n + i32(1));
  })
);
// A `Send` value-type constant at module level: legal under D1 (no reference
// inside, never assigned).
LIMIT :: i32(5);
// Per-thread mutable state at module level: the D1-approved spelling.
(thread_local(tl_hits) : i32) = i32(0);
// ============================================================================
// D3 — writes through an atomic object
// ============================================================================
// Already enforced (Phase O): field assignment through an `Arc` root.
comptime_expect_error({
  _d3_field_assignment :: (fn() -> unit)({
    a := arc(Counter(n : i32(0)));
    a.*.n = i32(1);
  });
  _d3_field_assignment();
});
// D3 (Phase 1): an `inout(self)` method called on a place inside an `Arc`.
comptime_expect_error({
  _d3_inout_self_receiver :: (fn() -> unit)({
    a := arc(Counter(n : i32(0)));
    a.*.bump();
  });
  _d3_inout_self_receiver();
});
// D3 (Phase 1): an `inout` argument rooted in an `Arc`.
_bump_by_ten :: (fn(inout(c) : Counter) -> unit)({
  c.n = (c.n + i32(10));
});
comptime_expect_error({
  _d3_inout_argument :: (fn() -> unit)({
    a := arc(Counter(n : i32(0)));
    _bump_by_ten(a.*);
  });
  _d3_inout_argument();
});
// D3 (Phase 1): index assignment through an `Arc` of a fixed array.
comptime_expect_error({
  _d3_index_assignment :: (fn() -> unit)({
    a := arc(Array(i32, usize(2))(i32(0), i32(0)));
    a.*(usize(0)) = i32(7);
  });
  _d3_index_assignment();
});
// D3 (Phase 1): the same through a user atomic object, not just `Arc`.
Shared :: atomic(ref(struct(counter : Counter)));
comptime_expect_error({
  _d3_user_atomic_receiver :: (fn() -> unit)({
    s := Shared(counter : Counter(n : i32(0)));
    s.counter.bump();
  });
  _d3_user_atomic_receiver();
});
// Canary: the same three shapes on a NON-atomic ref struct stay legal (they
// are the ordinary way to mutate a thread-local object).
Cell :: ref(struct(counter : Counter, slots : Array(i32, usize(2))));
test("D3 canary: inout receiver, inout argument and index assignment on a plain ref struct", {
  c := Cell(counter : Counter(n : i32(0)), slots : Array(i32, usize(2))(i32(0), i32(0)));
  c.counter.bump();
  _bump_by_ten(c.counter);
  c.slots(usize(1)) = i32(3);
  assert(c.counter.n == i32(11), "both writes landed");
  assert(c.slots(usize(1)) == i32(3), "the index write landed");
});
// Canary: a READ-ONLY `inout(self)` method through an `Arc` is legal — `inout`
// is also Yo's plain by-reference receiver (`ToString`, `Hash`, ...), so the
// gate decides by the callee's mutation mask, not by the parameter mode.
impl(
  Counter,
  describe : (fn(inout(self) : Self) -> i32)(self.n)
);
test("D3 canary: a read-only inout(self) method and ToString through an Arc are legal", {
  a := arc(Counter(n : i32(4)));
  assert(a.*.describe() == i32(4), "read-only inout(self) receiver through an Arc");
  s := `n=${a.*.n}`;
  assert(s == `n=4`, "ToString (inout(self)) on a field through an Arc");
});
// Canary: a local COPY of the value is not an atomic root.
test("D3 canary: mutating a local copy taken out of an Arc is legal", {
  a := arc(Counter(n : i32(0)));
  c := a.*;
  c.bump();
  assert(c.n == i32(1), "the copy was bumped");
  assert(a.*.n == i32(0), "the Arc's value is untouched");
});
// Canary: `with_lock`'s `inout(v)` is a parameter root, not an atomic root.
test("D3 canary: Mutex.with_lock may mutate the protected value", {
  m := Mutex(Counter).new(Counter(n : i32(0)));
  m.with_lock(v => {
    v.bump();
  });
  assert(m.with_lock(v => v.n) == i32(1), "with_lock body wrote through v");
});
// ============================================================================
// D4 — a closure is Send iff its captures are
// ============================================================================
// Already enforced at the spawn boundary: a closure over an ArrayList is not Send.
comptime_expect_error({
  _d4_spawn_over_array_list :: (fn() -> unit)({
    items := ArrayList(i32).new();
    t := Thread(unit).spawn(io => {
      items.push(i32(1));
      ()
    });
    t.join();
  });
  _d4_spawn_over_array_list();
});
// D4 (Phase 4): the same closure through `arc(...)` — `Arc(V)` requires
// `V <: Send`, and a closure type holds `Send` only when its captures do.
comptime_expect_error({
  _d4_arc_of_non_send_closure :: (fn() -> unit)({
    items := ArrayList(i32).new();
    (f : Impl(Fn() -> unit)) = (
      () => {
        items.push(i32(1));
      }
    );
    _a := arc(f);
  });
  _d4_arc_of_non_send_closure();
});
// D4 (Phase 4): ...and through a generic `where(T <: Send)` function.
_needs_send :: (fn(generic(T : Type), x : T, where(T <: Send)) -> unit)({
  x;
});
comptime_expect_error({
  _d4_generic_send_bound :: (fn() -> unit)({
    items := ArrayList(i32).new();
    (f : Impl(Fn() -> unit)) = (
      () => {
        items.push(i32(1));
      }
    );
    _needs_send(f);
  });
  _d4_generic_send_bound();
});
// Canary: a closure whose only capture is an atomic satisfies the bound, both
// through a generic `where(T <: Send)` and through `arc(...)` (the `arc` form
// emitted two Arc instances for one type until P-26,
// issues/fixed/arc-of-a-send-closure-emits-two-capture-struct-typedefs.md).
test("D4 canary: a closure over an atomic satisfies where(T <: Send), and arc() of it runs on a thread", {
  hits := AtomicI32(i32(0));
  (bump : Impl(Fn() -> unit)) = (
    () => {
      hits.fetch_add(i32(1), MemoryOrder.AcqRel);
    }
  );
  _needs_send(bump);
  a := arc(bump);
  t := Thread(unit).spawn((io : Io) => {
    f := a.*;
    f();
    ()
  });
  t.join();
  assert(hits.load(MemoryOrder.Acquire) == i32(1), "the closure ran on the thread");
});
// ============================================================================
// D1 — module-level bindings
// ============================================================================
// D1 (Phase 3): a spawn closure may not reach a non-Send global, even
// through a called function.
g_items := ArrayList(i32).new();
_fill_global :: (fn() -> unit)({
  g_items.push(i32(1));
});
comptime_expect_error({
  _d1_spawn_reaches_global :: (fn() -> unit)({
    t := Thread(unit).spawn(io => {
      _fill_global();
      ()
    });
    t.join();
  });
  _d1_spawn_reaches_global();
});
// D1 (Phase 3 residual, closed with D4): the same global reached through a
// LOCAL closure the spawn body calls — the closure captures nothing, so its
// capture struct is trivially Send; the reach walk follows the call into it.
comptime_expect_error({
  _d1_spawn_calls_local_closure :: (fn() -> unit)({
    (k : Impl(Fn() -> unit)) = (
      () => {
        g_items.push(i32(2));
      }
    );
    t := Thread(unit).spawn(io => {
      k();
      ()
    });
    t.join();
  });
  _d1_spawn_calls_local_closure();
});
// D1: ...and through a `Dyn(Trait, Send)` value whose method reaches it — the
// vtable's methods are walked where the concrete impl is known, at `dyn(...)`.
_GlobalPusher :: trait(
  push_one : (fn(self : Self) -> unit)
);
_PushesToGlobal :: struct(unused : i32);
impl(
  _PushesToGlobal,
  _GlobalPusher(
    push_one : (
      self -> {
        g_items.push(i32(3));
      }
    )
  )
);
comptime_expect_error({
  _d1_send_dyn_reaches_global :: (fn() -> unit)({
    (d : Dyn(_GlobalPusher, Send)) = dyn(_PushesToGlobal(unused : i32(0)));
    d.push_one();
  });
  _d1_send_dyn_reaches_global();
});
// Canary: a spawn closure may call a function that reads a `Send` constant
// and an atomic global; the non-Send global above is untouched by it.
g_hits := AtomicI32(i32(0));
_count_hit :: (fn() -> i32)({
  g_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
  LIMIT
});
test("D1 canary: a spawned closure may call a function that reaches Send globals", {
  t := Thread(i32).spawn((io : Io) => _count_hit());
  assert(t.join() == i32(5), "the callee read LIMIT on the thread");
  assert(g_hits.load(MemoryOrder.Acquire) == i32(1), "and bumped the atomic");
  g_items.push(i32(7));
  assert(g_items.len() == usize(1), "the non-Send global is still usable on the main thread");
});
// Canary: a `Send` value-type constant may be read from two threads.
test("D1 canary: a module-level value constant is readable from a spawned thread", {
  t := Thread(i32).spawn((io : Io) => (LIMIT + i32(1)));
  assert(t.join() == i32(6), "the thread read LIMIT");
  assert(LIMIT == i32(5), "so did the main thread");
});
// Canary: a `thread_local` global is per-thread mutable state.
//
// The oracle differs by platform because the contract does. Standalone WASI
// has no threads: `pthread_create` fails and `__yo_thread_spawn` runs the
// closure INLINE on the spawning thread (issues/fixed/wasi-thread-pool-submit-deadlock.md),
// so the "thread" IS the main thread and reads and writes the main thread's
// instance. Still race-free — one OS thread — but not a fresh instance, so
// the degraded contract is pinned there instead of skipped.
test("D1 canary: a thread_local global is written independently per thread", {
  tl_hits = i32(1);
  t := Thread(i32).spawn((io : Io) => {
    tl_hits = (tl_hits + i32(10));
    tl_hits
  });
  joined := t.join();
  if(platform == Platform.Wasi, {
    assert(joined == i32(11), "on standalone wasi the closure ran inline, on the main thread's instance");
    assert(tl_hits == i32(11), "so the main thread sees the write");
  }, {
    assert(joined == i32(10), "the thread started from its own zeroed instance");
    assert(tl_hits == i32(1), "the main thread's instance is untouched");
  });
});
// D1 (Phase 3): a Send VALUE global is a mutable static once it is assigned,
// so a spawned closure may not read one that is written anywhere.
(g_level : i32) = i32(0);
_raise_level :: (fn() -> unit)({
  g_level = (g_level + i32(1));
});
comptime_expect_error({
  _d1_spawn_reads_written_global :: (fn() -> i32)({
    _raise_level();
    t := Thread(i32).spawn((io : Io) => g_level);
    t.join()
  });
  _d1_spawn_reads_written_global();
});
// Canary: a written value global that no other thread reaches is an ordinary
// single-threaded mutable static.
(g_main_only : i32) = i32(0);
test("D1 canary: a value global written and read only on the main thread is legal", {
  g_main_only = (g_main_only + i32(2));
  assert(g_main_only == i32(2), "the write landed");
});
// ============================================================================
// D6 — runtime externs are not callable from safe code
// ============================================================================
// D6 (Phase 4): importing (naming) a runtime extern stays legal; CALLING it
// from a file without the pragma is rejected.
comptime_expect_error({
  _d6_call_runtime_extern :: (fn() -> unit)({
    __yo_async_blocking_begin();
  });
  _d6_call_runtime_extern();
});
// D6 (Phase 4): the same entry point reached as a field of the module value.
_runtime_externs :: import("std/sys/externs.yo");
comptime_expect_error({
  _d6_call_runtime_extern_through_module :: (fn() -> unit)({
    _runtime_externs.__yo_async_blocking_begin();
  });
  _d6_call_runtime_extern_through_module();
});
// ============================================================================
// D2 — Iso: constructed only through ^, over a reference object
// ============================================================================
// D2 (Phase 2): the raw constructor is not available in safe code.
comptime_expect_error({
  _d2_raw_iso_constructor :: (fn() -> unit)({
    b := box(i32(1));
    _i := Iso(Box(i32))(b);
  });
  _d2_raw_iso_constructor();
});
// D2 (Phase 2): Iso of a value type is rejected at the type.
comptime_expect_error({
  _D2Scalar :: Iso(i32);
});
// Canary: `^` constructs an Iso in safe code.
test("D2 canary: ^ isolates a uniquely owned Box in safe code", {
  b := box(i32(7));
  match(
    ^b,
    .Some(i) => assert(i.extract().* == i32(7), "the value came through"),
    .None => assert(false, "a fresh Box is uniquely owned")
  );
});
// ============================================================================
// D8 — closures may not capture second-class bindings
// ============================================================================
// D8 (Phase 4): a closure inside a `with_lock` body may not capture the
// body's second-class `inout(v)` (the check-level gate is the cli-case
// check-closure-captures-lock-inout-rejected; a comptime_expect_error observes
// the def-time error even while `check` swallows it).
comptime_expect_error({
  _d8_capture_lock_param :: (fn() -> unit)({
    m := Mutex(Counter).new(Counter(n : i32(0)));
    (_u : unit) = m.with_lock((v) => {
      (k : Impl(Fn() -> unit)) = (
        () => {
          v.n = (v.n + i32(1));
        }
      );
      k();
    });
  });
  _d8_capture_lock_param();
});
// Canary: a closure inside a `with_lock` body that captures a local COPY is legal.
test("D8 canary: a closure over a copy of the protected value is legal", {
  m := Mutex(Counter).new(Counter(n : i32(7)));
  seen := m.with_lock(v => {
    c := v;
    (k : Impl(Fn() -> i32)) = (() => c.n);
    k()
  });
  assert(seen == i32(7), "the copy was readable through the closure");
});
// ============================================================================
// D9 — a function value is Send by what it captures and what its code reaches
// ============================================================================
d9_hits := AtomicI32(i32(0));
_d9_fill :: (fn(io : Io) -> unit)({
  g_items.push(i32(9));
});
_d9_count :: (fn(io : Io) -> unit)({
  d9_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
  ();
});
_d9_push :: (fn() -> unit)({
  g_items.push(i32(9));
});
_d9_call_ptr :: (fn(cb : (fn() -> unit)) -> unit)({
  cb();
});
_d9_run :: (fn(cb : Impl(Fn() -> unit, Send)) -> unit)({
  t := Thread(unit).spawn((io : Io) => {
    cb();
    ()
  });
  t.join();
});
_D9Holder :: struct(f : (fn(io : Io) -> unit));
// D9: a NAMED function whose code reaches a non-Send global is not a spawn
// body (it is never a literal, so D1's creation-time walk never saw it).
comptime_expect_error({
  _d9_named_spawn :: (fn() -> unit)({
    t := Thread(unit).spawn(_d9_fill);
    t.join();
  });
  _d9_named_spawn();
});
// D9: a closure that captures nothing — its capture struct is trivially Send —
// but pushes to the global, bound to a plain local and then made Send by
// value: through `arc`, a generic `where(T <: Send)`, an `Impl(Fn, Send)`
// parameter.
comptime_expect_error({
  _d9_arc_of_reaching_closure :: (fn() -> unit)({
    (k : Impl(Fn() -> unit)) = (
      () => {
        g_items.push(i32(9));
      }
    );
    _a := arc(k);
  });
  _d9_arc_of_reaching_closure();
});
comptime_expect_error({
  _d9_generic_of_reaching_closure :: (fn() -> unit)({
    (k : Impl(Fn() -> unit)) = (
      () => {
        g_items.push(i32(9));
      }
    );
    _needs_send(k);
  });
  _d9_generic_of_reaching_closure();
});
comptime_expect_error({
  _d9_send_param_of_reaching_closure :: (fn() -> unit)({
    (k : Impl(Fn() -> unit)) = (
      () => {
        g_items.push(i32(9));
      }
    );
    _d9_run(k);
  });
  _d9_send_param_of_reaching_closure();
});
// D9: a declared `Impl(Fn(...), Send)` binding is where a function value takes
// on the promise, so the value is judged there — a closure that reaches the
// global cannot be re-bound to it.
comptime_expect_error({
  _d9_declared_send_binding :: (fn() -> unit)({
    (k : Impl(Fn() -> unit)) = (
      () => {
        g_items.push(i32(9));
      }
    );
    (k2 : Impl(Fn() -> unit, Send)) = k;
    k2;
  });
  _d9_declared_send_binding();
});
// D9: a function used as a VALUE inside a spawn body is walked as if called —
// whatever receives it may call it.
comptime_expect_error({
  _d9_value_in_spawn_body :: (fn() -> unit)({
    t := Thread(unit).spawn((io : Io) => {
      _d9_call_ptr(_d9_push);
      ()
    });
    t.join();
  });
  _d9_value_in_spawn_body();
});
// D9: a bare `fn` field loses the function's identity, so a struct holding one
// is not Send — even when the function stored in it is harmless.
comptime_expect_error({
  _d9_struct_with_fn_field :: (fn() -> unit)({
    h := _D9Holder(f : _d9_count);
    t := Thread(unit).spawn((io : Io) => {
      g := h.f;
      g(io);
      ()
    });
    t.join();
  });
  _d9_struct_with_fn_field();
});
// D9 inside an Iso: isolation proves the graph uniquely owned, not that the
// code a function stored in it runs is safe on another thread.
_D9Wrap :: ref(struct(f : (fn() -> unit)));
comptime_expect_error({
  _d9_iso_of_fn_field :: (fn() -> unit)({
    w := _D9Wrap(f : _d9_push);
    r := ^w;
    r;
  });
  _d9_iso_of_fn_field();
});
// An atomic beside the function does not exempt the graph: `AtomicI32` carries
// an extern opaque SomeT, and the Iso rules once ran only on a SomeT-free `T`
// (issues/fixed/an-atomic-field-exempts-an-iso-graph-from-rule-d9.md).
_D9WrapAtomic :: ref(struct(counter : AtomicI32, f : (fn() -> unit)));
comptime_expect_error({
  _d9_iso_of_fn_field_beside_an_atomic :: (fn() -> unit)({
    w := _D9WrapAtomic(counter : AtomicI32.new(i32(0)), f : _d9_push);
    r := ^w;
    r;
  });
  _d9_iso_of_fn_field_beside_an_atomic();
});
comptime_expect_error({
  _d9_iso_of_reaching_closures :: (fn() -> unit)({
    (k : Impl(Fn() -> unit)) = (
      () => {
        g_items.push(i32(9));
      }
    );
    xs := ArrayList(typeof(k)).new();
    xs.push(k);
    r := ^xs;
    r;
  });
  _d9_iso_of_reaching_closures();
});
// D9 at `dyn(...)`: a closure coerced to `Dyn(Fn() -> R, Send)` is judged by
// its value.
comptime_expect_error({
  _d9_dyn_fn_send :: (fn() -> unit)({
    (k : Impl(Fn() -> unit)) = (
      () => {
        g_items.push(i32(9));
      }
    );
    (d : Dyn(Fn() -> unit, Send)) = dyn(k);
    d;
  });
  _d9_dyn_fn_send();
});
// A `Dyn(..., Send)` shares its data object across threads, so the object is
// counted atomically: `dyn(...)` boxes a closure with `arc`, and an explicit
// non-atomic `box(...)` payload is rejected
// (issues/fixed/a-send-dyn-shares-a-non-atomic-box-across-threads.md).
comptime_expect_error({
  _dsend_box :: (fn() -> unit)({
    (k : Impl(Fn() -> unit)) = (
      () => {
        d9_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
        ();
      }
    );
    (d : Dyn(Fn() -> unit, Send)) = dyn(box(k));
    d;
  });
  _dsend_box();
}, "must be atomically reference counted");
// Canary: function values whose code reaches only atomics cross threads by
// every route above — a named spawn body, a capture-free closure through a
// generic bound and an `Impl(Fn, Send)` parameter, a captured closure, a
// declared `Impl(Fn, Send)` re-binding of it.
test("D9 canary: function values that reach only atomics are Send by every route", {
  t1 := Thread(unit).spawn(_d9_count);
  t1.join();
  (k : Impl(Fn() -> unit)) = (
    () => {
      d9_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
      ();
    }
  );
  _needs_send(k);
  _d9_run(k);
  t2 := Thread(unit).spawn((io : Io) => {
    k();
    ()
  });
  t2.join();
  // A declared `Impl(Fn(...), Send)` binding of an existing closure: judged
  // where it is made, then captured on its declaration.
  (k2 : Impl(Fn() -> unit, Send)) = k;
  t3 := Thread(unit).spawn((io : Io) => {
    k2();
    ()
  });
  t3.join();
  // `dyn(...)` and the list each take ownership, so each gets its own closure.
  (kd : Impl(Fn() -> unit)) = (
    () => {
      d9_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
      ();
    }
  );
  (kl : Impl(Fn() -> unit)) = (
    () => {
      d9_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
      ();
    }
  );
  (d : Dyn(Fn() -> unit, Send)) = dyn(kd);
  t4 := Thread(unit).spawn((io : Io) => {
    d();
    ()
  });
  t4.join();
  // An `Iso` over a list of clean closures
  // (issues/fixed/a-container-of-a-closure-type-does-not-compile.md).
  ks := ArrayList(typeof(kl)).new();
  ks.push(kl);
  match(
    ^ks,
    .Some(iso) => {
      t5 := Thread(unit).spawn((io : Io) => {
        got := iso.extract();
        match(got.get(usize(0)), .Some(g0) => g0(), .None => ());
        ()
      });
      t5.join();
    },
    .None => assert(false, "a fresh list of clean closures is uniquely owned")
  );
  assert(d9_hits.load(MemoryOrder.Acquire) == i32(6), "every route ran its function on a thread");
});
// Canary (P-26 residual): `arc` of a closure that captures NOTHING — here it
// reaches only an atomic global — compiles and runs; its `Arc(V)` signature
// and body built two Arc instances until
// issues/fixed/arc-of-a-capture-free-closure-emits-two-arc-typedefs.md.
d9_arc_hits := AtomicI32(i32(0));
test("D4/D9 canary: arc() of a capture-free closure runs on a thread", {
  (k : Impl(Fn() -> unit)) = (
    () => {
      d9_arc_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
      ();
    }
  );
  a := arc(k);
  t := Thread(unit).spawn((io : Io) => {
    f := a.*;
    f();
    ()
  });
  t.join();
  assert(d9_arc_hits.load(MemoryOrder.Acquire) == i32(1), "the capture-free closure ran on the thread");
});
// A named function passed to an `own` parameter is not MOVED: a `::`
// definition is a code pointer, re-materialized at every use. Binding it
// again after the call was "use of moved value"
// (issues/fixed/passing-a-named-function-to-an-own-parameter-moves-the-definition.md).
d9_tick_hits := AtomicI32(i32(0));
_d9_tick :: (fn() -> unit)({
  d9_tick_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
  ();
});
_d9_take_own :: (fn(own(cb) : Impl(Fn() -> unit)) -> unit)({
  cb();
});
// Canary for the atomic Dyn box: one `Dyn(Fn, Send)` held by two threads at
// once and by the spawning thread; every copy retains and releases the same
// box. TSan (scripts/tsan-thread-corpus.sh) reported the
// plain-box version as a race on the box's reference count.
(dsend_hits : AtomicI32) = AtomicI32.new(i32(0));
test("a Dyn(Fn, Send) shared by two threads and the spawner", {
  (k : Impl(Fn() -> unit)) = (
    () => {
      dsend_hits.fetch_add(i32(1), MemoryOrder.AcqRel);
      ();
    }
  );
  (d : Dyn(Fn() -> unit, Send)) = dyn(k);
  ta := Thread(unit).spawn((io : Io) => {
    d();
    ()
  });
  tb := Thread(unit).spawn((io : Io) => {
    d();
    ()
  });
  d();
  ta.join();
  tb.join();
  assert(dsend_hits.load(MemoryOrder.Acquire) == i32(3), "both threads and the spawner called the closure");
});
test("a named function passed to an own parameter stays usable", {
  _d9_take_own(_d9_tick);
  f := _d9_tick;
  f();
  _d9_take_own(_d9_tick);
  assert(d9_tick_hits.load(MemoryOrder.Acquire) == i32(3), "all three calls ran the definition");
});
