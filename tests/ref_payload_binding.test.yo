// A pattern binding whose payload is a reference (decision 43 step 3,
// plans/backlog/REFERENCES_AND_ORIGINS.md O4; decision 44's `&Dyn(Trait)`):
// `.Some(r)` over an `Option(&T)` binds `r` as a reference binding, exactly
// as `r := &x` and a `-> &T` projection's result do. A field read, a method
// call and a lend read through it, `r.*` is the referent, and a `&` payload
// is read-only. Over an `Option(&Dyn(Trait))` this is what a borrowing
// `Error.source` walk needs (plans/handover/D43_STEP3_N2_DESIGN.md §3.2).
{ assert } :: import("std/assert");
_Cell :: struct(n : i32);
impl(
  _Cell,
  get : (fn(self : &Self) -> i32)(self.n),
  bump : (fn(self : &mut Self) -> unit)({
    self.n = (self.n + i32(1));
  })
);
_pick :: (fn(c : &_Cell) -> Option(&_Cell))(.Some(c));
_pick_mut :: (fn(c : &mut _Cell) -> Option(&mut _Cell))(.Some(c));
_read :: (fn(c : &_Cell) -> i32)(c.n);
// An arrow method whose result carries an origin takes its `&Self`
// receiver by pointer, like a projection, so `.Some(&self.n)` points at the
// caller's place, through `Dyn` dispatch too.
_Peek :: trait(peek : (fn(self : &Self) -> Option(&i32)));
impl(_Cell, _Peek(peek : (self -> .Some(&self.n))));
// A reference payload beside a later operand that reads its root: the
// payload is the place's address, never a temporary's.
_Two :: enum(Both(r : &_Cell, k : i32), Neither);
_both :: (fn(c : &_Cell) -> _Two)(.Both(c, _read(c)));
_Shape :: trait(area : (fn(self : &Self) -> i32));
_Sq :: struct(s : i32);
impl(_Sq, _Shape(area : (fn(self : &Self) -> i32)(self.s * self.s)));
_first :: (fn(r : &Dyn(_Shape)) -> Option(&Dyn(_Shape)))(.Some(r));
_area :: (fn(r : &Dyn(_Shape)) -> i32)(r.area());
// The end-state shape of `Error.source` (VERDICTS-1 §B13): a link lends its
// cause as a borrowed trait object, and a walk follows the borrows.
_Link :: trait(
  code : (fn(self : &Self) -> i32),
  (source : (fn(self : &Self) -> Option(&Dyn(SelfTrait)))) ?= (self -> .None)
);
_Leaf :: struct(code : i32);
impl(_Leaf, _Link(code : (fn(self : &Self) -> i32)(self.code)));
_Wrap :: struct(code : i32, cause : Dyn(_Link));
impl(
  _Wrap,
  _Link(
    code : (fn(self : &Self) -> i32)(self.code),
    source : (fn(self : &Self) -> Option(&Dyn(_Link)))(.Some(&self.cause))
  )
);
_root_code :: (fn(e : &Dyn(_Link)) -> i32)(
  match(e.source(), .Some(s) => _root_code(s), .None => e.code())
);
// A projection's result positions are written with the sigil (decision
// 24); the payload binding's place is rooted at `e` through `e.source()`.
_root :: (fn(e : &Dyn(_Link)) -> &Dyn(_Link))(
  match(e.source(), .Some(s) => &_root(s), .None => &e.*)
);
_first_cause :: (fn(e : &Dyn(_Link)) -> &Dyn(_Link))(
  match(e.source(), .Some(s) => &s.*, .None => &e.*)
);
// The payload's place is rooted at the projection's own local: E0912.
comptime_expect_error(
  _escape :: (fn(c : &_Cell) -> &_Cell)({
    l := _Cell(n : c.n);
    match(_pick(&l), .Some(s) => &s.*, .None => &c.*)
  }),
  "single-root rule"
);
_depth :: (fn(e : &Dyn(_Link)) -> i32)(
  match(e.source(), .Some(s) => (_depth(s) + i32(1)), .None => i32(0))
);
// While a payload binding is live its referent's root is frozen: a `&`
// payload freezes `c` against writes, a `&mut` one against any access
// (E0911, decision 43 O3 step 2).
comptime_expect_error(
  _write_root_under_shared :: (fn() -> unit)({
    mut(c) := _Cell(n : i32(1));
    match(
      _pick(&c),
      .Some(r) => {
        c.n = i32(2);
        _ := r.n;
      },
      .None => ()
    );
  }),
  "is still live"
);
comptime_expect_error(
  _read_root_under_mut :: (fn() -> unit)({
    mut(c) := _Cell(n : i32(1));
    match(
      _pick_mut(&mut c),
      .Some(r) => {
        _ := c.n;
        r.bump();
      },
      .None => ()
    );
  }),
  "is still live"
);
test("ref payload: a field read and a method call read through the binding", {
  c := _Cell(n : i32(4));
  a := match(_pick(&c), .Some(r) => r.n, .None => i32(0));
  b := match(_pick(&c), .Some(r) => r.get(), .None => i32(0));
  assert(a == i32(4), "r.n reads the referent's field");
  assert(b == i32(4), "r.get() calls through the reference");
});
test("ref payload: `r.*` is the referent and `r` lends bare to a `&T` parameter", {
  c := _Cell(n : i32(6));
  v := match(_pick(&c), .Some(r) => r.*.n, .None => i32(0));
  w := match(_pick(&c), .Some(r) => _read(r), .None => i32(0));
  m := match(_pick(&c), .Some(r) => r.*.get(), .None => i32(0));
  assert(v == i32(6), "r.*.n");
  assert(m == i32(6), "r.*.get()");
  assert(w == i32(6), "_read(r)");
});
test("ref payload: a `&mut` payload writes the referent", {
  mut(c) := _Cell(n : i32(1));
  match(
    _pick_mut(&mut c),
    .Some(r) => {
      r.bump();
      r.n = (r.n + i32(10));
    },
    .None => ()
  );
  assert(c.n == i32(12), "both writes reached `c`");
});
test("ref payload: the root is free again after the binding's last use", {
  mut(c) := _Cell(n : i32(1));
  match(
    _pick_mut(&mut c),
    .Some(r) => {
      r.bump();
      c.n = (c.n + i32(1));
    },
    .None => ()
  );
  assert(c.n == i32(3), "the write after `r`'s last use is legal");
});
test("ref payload: a `&` payload is read-only", {
  c := _Cell(n : i32(1));
  comptime_expect_error(
    match(
      _pick(&c),
      .Some(r) => {
        r.n = i32(2);
      },
      .None => ()
    ),
    "read-only"
  );
});
test("ref payload: an arrow method's receiver of an origin-carrying result", {
  c := _Cell(n : i32(8));
  v := match(c.peek(), .Some(r) => r.*, .None => i32(0));
  assert(v == i32(8), "c.peek()");
  (d : Dyn(_Peek)) = dyn(_Cell(n : i32(9)));
  w := match(d.peek(), .Some(r) => r.*, .None => i32(0));
  assert(w == i32(9), "d.peek() through the vtable");
});
test("ref payload: a variant with a reference and a later operand", {
  c := _Cell(n : i32(5));
  v := match(_both(&c), .Both(r, k) => (r.n + k), .Neither => i32(0));
  assert(v == i32(10), "r points at `c`, k read it");
});
test("ref payload: a `&Dyn(Trait)` payload dispatches through its vtable", {
  (d : Dyn(_Shape)) = dyn(_Sq(s : i32(3)));
  a := match(_first(&d), .Some(r) => r.area(), .None => i32(0));
  b := match(_first(&d), .Some(r) => _area(r), .None => i32(0));
  assert(a == i32(9), "r.area()");
  assert(b == i32(9), "_area(r)");
});
test("ref payload: a borrowing `source` chain walks without cloning", {
  (e : Dyn(_Link)) = dyn(_Wrap(code : i32(1), cause : dyn(_Wrap(code : i32(2), cause : dyn(_Leaf(code : i32(3)))))));
  assert(_root_code(&e) == i32(3), "the innermost link's code");
  assert(_depth(&e) == i32(2), "two causes below the head");
  r := _root(&e);
  assert(r.code() == i32(3), "the root returned as a borrow of the leaf");
  f := _first_cause(&e);
  assert(f.code() == i32(2), "the first cause returned as a borrow");
});
// A reference payload or field whose referent is spelled by a typedef (a
// newtype: `String`, `Box`, `ArrayList`) is declared after that typedef; a
// struct or enum referent needs only its forward declaration. Each type
// here is declared after the enum that points at it
// (issues/fixed/2026-11-05-an-option-of-a-reference-to-a-newtype-is-declared-before-the-newtype.md).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
_Refs :: enum(ToStruct(r : &_Later), ToString(s : &String), ToBox(b : &Box(_Later)), ToEnum(o : &Option(_Later)), ToList(l : &ArrayList(i32)), Nothing);
_Later :: struct(n : i32, s : String);
_name_of :: (fn(x : &_Later) -> Option(&String))(.Some(&x.s));
_boxed :: (fn(x : &Box(_Later)) -> Option(&Box(_Later)))(.Some(x));
test("a reference to a later newtype, struct or enum is a valid payload", {
  v := _Later(n : i32(3), s : String.from("ab"));
  b := Box.new(_Later(n : i32(4), s : String.from("c")));
  o := Option(_Later).Some(_Later(n : i32(5), s : String.from("d")));
  xs := ArrayList(i32).new();
  assert(match(_name_of(&v), .Some(s) => (s.len() == usize(2)), .None => false), "Option(&String)");
  assert(match(_boxed(&b), .Some(r) => (r.n == i32(4)), .None => false), "Option(&Box(_Later))");
  assert(match(_Refs.ToStruct(&v), .ToStruct(r) => (r.n == i32(3)), _ => false), "a struct referent");
  assert(match(_Refs.ToString(&v.s), .ToString(s) => (s.len() == usize(2)), _ => false), "a String referent");
  assert(match(_Refs.ToBox(&b), .ToBox(r) => (r.n == i32(4)), _ => false), "a Box referent");
  assert(match(_Refs.ToEnum(&o), .ToEnum(r) => r.is_some(), _ => false), "an enum referent");
  assert(match(_Refs.ToList(&xs), .ToList(r) => (r.len() == usize(0)), _ => false), "an ArrayList referent");
});
// A borrowing reader over an `Option` field, Rust's `Option::as_ref` and
// `OnceCell::get`/`get_or_init` shapes: a binding of a borrowed `match` is a
// place inside the scrutinee's place, so `&s.*` is rooted at `self`
// (issues/fixed/2026-11-05-a-projection-cannot-yield-a-binding-of-a-borrowed-match.md).
_Slot :: struct(v : Option(String), fallback : String);
impl(
  _Slot,
  peek : (fn(self : &Self) -> Option(&String))(
    match(&self.v, .Some(s) => .Some(s), .None => .None)
  ),
  value_or_fallback : (fn(self : &Self) -> &String)(
    match(&self.v, .Some(s) => &s.*, .None => &self.fallback)
  )
);
_slot_opt :: (fn() -> Option(String))(.Some(String.from("temp")));
test("a borrowed match binding is yielded as a place of `self`", {
  full := _Slot(v : .Some(String.from("hello")), fallback : String.from("-"));
  empty := _Slot(v : .None, fallback : String.from("-"));
  assert(match(full.peek(), .Some(s) => (s.len() == usize(5)), .None => false), "peek reads the payload in place");
  assert(empty.peek().is_none(), "an empty slot peeks None");
  assert(full.value_or_fallback().len() == usize(5), "the payload, in place");
  assert(empty.value_or_fallback().len() == usize(1), "the fallback field");
  assert(full.v.is_some(), "the String stayed in the slot");
  // The yielded reference is the slot's payload itself, not a copy: it
  // outlives the call and reads the place.
  r := full.value_or_fallback();
  assert(r.* == String.from("hello"), "the reference reads the payload after the call");
  // A `&mut` result cannot yield a shared borrow, and a binding of a
  // temporary scrutinee dies with the call.
  comptime_expect_error({
    _SlotMut :: struct(v : Option(String), fallback : String);
    _bad :: (fn(x : &mut _SlotMut) -> &mut String)(
      match(&x.v, .Some(s) => &mut s.*, .None => &mut x.fallback)
    );
    mut(m) := _SlotMut(v : .Some(String.from("a")), fallback : String.from("-"));
    _r := _bad(&mut m);
  }, "is a shared borrow");
  comptime_expect_error({
    _bad_tmp :: (fn(x : &_Slot) -> &String)(
      match(&_slot_opt(), .Some(s) => &s.*, .None => &x.fallback)
    );
    _r := _bad_tmp(&full);
  }, "this is a temporary");
});
