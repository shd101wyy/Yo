{ assert } :: import("std/assert");
// Tests for forward references between methods in a single impl block.
// Tracking issue: forward-fn-ref-in-toplevel-holder.md
// Bootstrapping prerequisite: parser needs mutually recursive methods.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/error"));
open(import("std/fmt"));
P :: struct(x : i32, y : i32);
// ---------- Test 1: forward call within a single impl block ----------
//
// `caller` references `callee` which is defined later in the same impl.
impl(
  P,
  caller : (fn(self : *Self) -> i32)(
    self.callee()
  ),
  callee : (fn(self : *Self) -> i32)(
    self.x
  )
);
test("forward call within single impl", {
  p := P(x : i32(7), y : i32(0));
  assert(p.caller() == i32(7), "forward call should return 7");
});
// ---------- Test 2: mutual recursion between two impl methods ----------
//
// `is_even` and `is_odd` call each other. Counts down from a positive int.
Q :: struct(n : i32);
impl(
  Q,
  is_even : (fn(self : *Self) -> bool)(
    cond(
      (self.n == i32(0)) => true,
      true => Q(n : (self.n - i32(1))).is_odd()
    )
  ),
  is_odd : (fn(self : *Self) -> bool)(
    cond(
      (self.n == i32(0)) => false,
      true => Q(n : (self.n - i32(1))).is_even()
    )
  )
);
test("mutual recursion in single impl", {
  assert(Q(n : i32(4)).is_even(), "4 is even");
  assert(Q(n : i32(5)).is_odd(), "5 is odd");
  assert(!Q(n : i32(7)).is_even(), "7 is not even");
});
// ---------- Test 3: forward call with effect parameters ----------
//
// The parser case: methods carry `exn : Exception` and forward-call
// each other.
MyErr :: ref(struct(msg : String));
impl(MyErr, ToString(to_string : (self -> `my err`)));
impl(MyErr, Error());
R :: struct(v : i32);
impl(
  R,
  outer : (fn(self : *Self, exn : Exception) -> i32)(
    self.inner(exn)
  ),
  inner : (fn(self : *Self, exn : Exception) -> i32)(
    cond(
      (self.v < i32(0)) => exn.throw(dyn(MyErr(msg : `neg`))),
      true => self.v
    )
  )
);
test("forward call with effect params", {
  r := R(v : i32(99));
  exn := Exception(
    throw : (
      e -> {
        unwind(());
      }
    )
  );
  result := r.outer(exn);
  assert(result == i32(99), "outer should return 99");
});
// ---------- Test 4: mutual recursion with effect parameters ----------
//
// This is the case that originally caused
// "Maximum call stack size exceeded" during specialization. The fix is in
// helper.ts: currentlySpecializingFunctionStack now lets the recursive call
// from `odd` back to `even` short-circuit instead of re-specializing
// infinitely.
// See issues/mutual-recursion-impl-method-specialization-overflow.md.
S :: ref(struct(tag : i32));
impl(
  S,
  s_even : (fn(self : *Self, i : i32, exn : Exception) -> bool)(
    cond(
      (i == i32(0)) => true,
      true => self.s_odd(i - i32(1), exn)
    )
  ),
  s_odd : (fn(self : *Self, i : i32, exn : Exception) -> bool)(
    cond(
      (i == i32(0)) => false,
      true => self.s_even(i - i32(1), exn)
    )
  )
);
test("mutual recursion with effect params (specialization-cycle)", {
  s := S(tag : i32(0));
  exn := Exception(
    throw : (
      e -> {
        unwind(());
      }
    )
  );
  assert(s.s_even(i32(10), exn), "10 is even");
  assert(s.s_odd(i32(11), exn), "11 is odd");
  assert(!s.s_even(i32(7), exn), "7 is not even");
});
// ---------- Test 5: shell merge does not emit duplicate orphan FunctionValue
//
// Regression: forward-ref pre-pass creates a real FunctionValue shell with a
// stable funcId; the main pass then evaluates the body and produces a SECOND
// FunctionValue with a different funcId, sharing the body AST. Before the
// fix, codegen collected BOTH (the orphan reached context.functions through
// AST walks of the impl's value expressions). The orphan's emission re-used
// temp variable names that the shell's emission had already declared,
// producing C with undeclared identifiers and a build failure.
//
// Reproduces with multiple methods in one impl, an RC-typed return, and
// multiple call sites (so the orphan and shell are both reachable from the
// codegen walk).
QQ :: ref(struct(data : Box(i32)));
impl(
  QQ,
  new : (fn(val : i32) -> Self)(
    Self(data : box(val))
  ),
  get_implicit : (fn(self : Self) -> Box(i32))(
    self.data
  ),
  get_explicit : (fn(self : Self) -> Box(i32))({
    return(self.data);
  })
);
test("no duplicate function emission for shell + orphan", {
  q := QQ.new(i32(42));
  d1 := q.get_implicit();
  assert(d1.* == i32(42), "d1 == 42");
  d2 := q.get_explicit();
  assert(d2.* == i32(42), "d2 == 42");
});
// ---------- Test 6: forcing chains and a shared forward callee ----------
//
// `a` references `b` which references `c` (a three-hop forward chain), and
// `d` references `c` again after `c` has been forced. `c` must be evaluated
// once and every caller must bind to the same real function. Pins the
// pending-field forcing that replaced the shell pre-pass
// (plans/LAZY_TOPLEVEL_BINDINGS.md §10 "P3 as landed").
Chain :: struct(base : i32);
impl(
  Chain,
  a : (fn(self : Chain) -> i32)(self.b() + i32(1)),
  b : (fn(self : Chain) -> i32)(self.c() + i32(10)),
  d : (fn(self : Chain) -> i32)(self.c() * i32(2)),
  c : (fn(self : Chain) -> i32)(self.base + i32(100))
);
test("three-hop forward chain and shared forward callee", {
  ch := Chain(base : i32(5));
  assert(ch.c() == i32(105), "c is 105");
  assert(ch.b() == i32(115), "b is c + 10");
  assert(ch.a() == i32(116), "a is b + 1");
  assert(ch.d() == i32(210), "d is 2c");
});
// ---------- Test 7: members of an ABANDONED impl do not survive its error ----
//
// The impl throws at `bad` (body type mismatch); `good` sits after it. Before
// the fix, `good` was still callable afterwards — on the shell design the
// pre-pass had registered its shell permanently before the throw, and with
// pending-field forcing a stale in-flight record let the `good()` miss force
// it (issues/fixed/abandoned-impl-members-survive-the-error.md). Module-level
// `comptime_expect_error` is the catch-and-continue site this pins.
Abandoned :: struct(n : i32);
comptime_expect_error(
  impl(
    Abandoned,
    bad : (fn(self : Abandoned) -> i32)(String.from("not an i32")),
    good : (fn(self : Abandoned) -> i32)(self.n + i32(1))
  )
);
comptime_expect_error(Abandoned(n : i32(1)).good());
test("members after a failing impl member do not exist", {
  // Reached only if both expectations above held at check time.
  assert(true, "abandoned impl left no members behind");
});
