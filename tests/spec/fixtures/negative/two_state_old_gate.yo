// old(y) where y is BODY-LOCAL: there is no entry value (the Dafny
// rule) — a loud subset error. Never an identity read of the CURRENT y:
// before V5's two-state encoding, old() walked as identity and this
// assert (concretely false for every x: y = x + 1) was a false PROOF.
pragma(Pragma.Verify);
{ assert } :: import("std/assert");

old_local :: (
  fn(
    x : i32,
    requires(x >= i32(0), x <= i32(1000)),
    ensures(result >= i32(0))
  ) -> (result : i32)
)({
  y := x;
  y = (y + i32(1));
  assert(y == old(y));
  y
});
