// The bugged twins: `get` at the end is claimed Some; pop's length claim is
// off by one.
pragma(Pragma.Verify);
{ ArrayList } :: import("std/collections/array_list");

past_end_wrong :: (fn(xs : &ArrayList(i32), ensures(r == i32(0))) -> (r : i32))(
  match(
    xs.get(xs.len()),
    .Some(_) => i32(0),
    .None => i32(-1)
  )
);

pop_wrong :: (
  fn(xs : &ArrayList(i32), requires(xs.len() >= usize(1)), ensures(xs.len() == old(xs.len()))) -> (r : i32)
)(
  match(
    xs.pop(),
    .Some(v) => v,
    .None => i32(0)
  )
);
