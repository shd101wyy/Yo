// The negative twin of valid/for_produced.yo: each claim is one step off.
pragma(Pragma.Verify);
{ ArrayList } :: import("std/collections/array_list");

// REFUTED at the back-edge: two pushes per element outgrow what was
// produced.
copy_twice :: (fn(imm(xs) : ArrayList(i32), ensures(true)) -> (r : ArrayList(i32)))({
  out := ArrayList(i32).new();
  for(xs, x => {
    invariant(out.len() <= produced(xs).len());
    out.push(x);
    out.push(x);
  });
  out
});

// REFUTED at the continue: a skipped element is still produced, so a
// count of the kept ones falls behind it.
count_all :: (fn(imm(xs) : ArrayList(i32), ensures(true)) -> (r : usize))({
  (n : usize) = usize(0);
  for(xs, x => {
    invariant(n == produced(xs).len());
    if(x <= i32(0), {
      continue;
    });
    n = (n + usize(1));
  });
  n
});

// SUBSET ERROR: the body changes the list it walks.
grow :: (fn(imm(xs) : ArrayList(i32), ensures(true)) -> unit)({
  for(xs, x => {
    xs.push(x);
  });
});
