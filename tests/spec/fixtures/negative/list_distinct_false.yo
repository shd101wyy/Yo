// The negative twin of valid/list_distinct.yo.
pragma(Pragma.Verify);
{ ArrayList } :: import("std/collections/array_list");

append_all :: (
  fn(
    src : &ArrayList(i32),
    dst : &mut ArrayList(i32),
    requires(distinct(src, dst), (dst.len() + src.len()) >= dst.len()),
    ensures(dst.len() == (old(dst.len()) + src.len()))
  ) -> unit
)({
  (mut(i) : usize) = usize(0);
  while(i < src.len(), {
    invariant(i <= src.len(), dst.len() == (old(dst.len()) + i));
    dst.push(src(i));
    i = (i + usize(1));
  });
});

// One list passed as both (`onto_itself`, `append_all(xs, xs)` for an
// `xs : &mut ArrayList(i32)`) is E0910 at evaluation, before the verifier's
// `distinct(src, dst)` sees it
// (issues/fixed/2026-11-04-a-mut-reference-parameter-lent-as-both-arguments-of-one-call-is-accepted.md).

// SUBSET ERROR: without distinct, a body mutating one of two same-typed
// list parameters is rejected.
append_unchecked :: (
  fn(
    src : &ArrayList(i32),
    dst : &mut ArrayList(i32),
    requires((dst.len() + src.len()) >= dst.len()),
    ensures(dst.len() == (old(dst.len()) + src.len()))
  ) -> unit
)({
  (mut(i) : usize) = usize(0);
  while(i < src.len(), {
    invariant(i <= src.len(), dst.len() == (old(dst.len()) + i));
    dst.push(src(i));
    i = (i + usize(1));
  });
});
