// The false twins of valid/generic_body_abstract.yo: before contracted
// generic functions were registered, `yo verify` reported this file green
// with no task for either function.
pragma(Pragma.Verify);

wrong_id :: (fn(generic(T : Type), x : &T, y : &T, ensures(result == x)) -> (result : T))(y);

tenth_wrong :: (fn(generic(T : Type), x : &T, n : i32, requires(n != i32(0)), ensures(r == i32(3))) -> (r : i32))(i32(10) / n);
