// issues/fixed/2026-10-23-the-verifier-walk-ignores-an-early-return.md: the
// walk read a folded `return(i32(5))` as the bare literal, so the value after
// the branch stood for the returned one and both false ensures verified (each
// returns 5 when `x` is 1). An early exit is outside the subset now: neither
// function may verify.
pragma(Pragma.Verify);

r_match :: (fn(x : i32, requires(x >= i32(0), x <= i32(10)), ensures((x != i32(1)) || (r == i32(0)))) -> (r : i32))({
  (mut(y) : i32) = i32(0);
  match(
    x,
    1 => {
      return(i32(5));
    },
    _ => {
      y = i32(2);
    }
  );
  y
});

r_if :: (fn(x : i32, requires(x >= i32(0), x <= i32(10)), ensures(r == i32(0))) -> (r : i32))({
  if(x == i32(1), {
    return(i32(5));
  });
  i32(0)
});
export(r_match, r_if);
