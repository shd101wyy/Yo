// The false twins of valid/dml_append_seq.yo: the order of an append is part
// of its meaning, and skipping an element changes the sequence.
pragma(Pragma.Verify);
{ ArrayList } :: import("std/collections/array_list");

// REFUTED: b before a.
append_backwards :: (
  fn(
    a : &ArrayList(i32),
    b : &ArrayList(i32),
    requires((a.len() + b.len()) >= a.len()),
    ensures(seq_of(r) == seq_append(seq_of(b), seq_of(a)))
  ) -> (r : ArrayList(i32))
)({
  out := ArrayList(i32).new();
  (i : usize) = usize(0);
  while(i < a.len(), {
    invariant(i <= a.len(), out.len() == i, forall(k : usize, (k < i) ==> (out(k) == a(k))));
    out.push(a(i));
    i = (i + usize(1));
  });
  (j : usize) = usize(0);
  while(j < b.len(), {
    invariant(
      j <= b.len(),
      out.len() == (a.len() + j),
      forall(k : usize, (k < a.len()) ==> (out(k) == a(k))),
      forall(k : usize, (k < j) ==> (out(a.len() + k) == b(k)))
    );
    out.push(b(j));
    j = (j + usize(1));
  });
  out
});

// REFUTED: the copy drops the first element.
copy_all :: (fn(a : ArrayList(i32), ensures(seq_of(r) == seq_of(a))) -> (r : ArrayList(i32)))({
  out := ArrayList(i32).new();
  (i : usize) = usize(1);
  while(i < a.len(), {
    invariant(i >= usize(1), out.len() == (i - usize(1)), forall(k : usize, (k < out.len()) ==> (out(k) == a(k + usize(1)))));
    out.push(a(i));
    i = (i + usize(1));
  });
  out
});
