// A ghost binding is a specification, and a specification cannot call a
// function with a contract: `spin` never returns, so partial correctness
// proves its `ensures(r > r)`, and an erased binding that assumed it proved
// `r == 42` for a program that returns 7
// (issues/fixed/2026-11-27-a-ghost-binding-calls-a-diverging-function.md).
// The evaluator rejects the call (E0928) in every mode.
pragma(Pragma.Verify);

spin :: (fn(x : i32, ensures(r > r)) -> (r : i32))({
  mut(i) := x;
  while(true, {
    invariant(true);
    i = i;
  });
  i
});

wrong :: (fn(x : i32, ensures(r == i32(42))) -> (r : i32))({
  ghost(v := spin(x));
  x
});
