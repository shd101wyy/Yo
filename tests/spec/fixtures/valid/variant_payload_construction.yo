// issues/fixed/verifier-a-variant-constructed-in-a-cond-arm-is-an-untyped-callee.md:
// a variant WITH a payload parses as `(.Variant)(payload)` or
// `(Enum.Variant)(payload)`, and qualified zero-field `Enum.Variant` as
// `.(Enum, Variant)`; the verifier modeled neither, in any position.
pragma(Pragma.Verify);
Color :: enum(Red, Green(v : i32));

stmt_qualified :: (fn(b : bool, ensures(r == i32(1))) -> (r : i32))({
  (c : Color) = Color.Green(i32(7));
  match(c, .Red => i32(0), .Green(_) => i32(1))
});
stmt_short :: (fn(b : bool, ensures(r == i32(1))) -> (r : i32))({
  (c : Color) = .Green(i32(7));
  match(c, .Red => i32(0), .Green(_) => i32(1))
});
arm_qualified :: (fn(b : bool, ensures(r == cond(b => i32(1), true => i32(0)))) -> (r : i32))({
  (c : Color) = cond(b => Color.Green(i32(7)), true => Color.Red);
  match(c, .Red => i32(0), .Green(_) => i32(1))
});
arm_short :: (fn(b : bool, ensures(r == cond(b => i32(1), true => i32(0)))) -> (r : i32))({
  (c : Color) = cond(b => .Green(i32(7)), true => .Red);
  match(c, .Red => i32(0), .Green(_) => i32(1))
});

// The FINAL arm binds the payload (issues/fixed/verifier-a-final-match-arm-loses-its-pattern-bindings.md).
payload_read :: (fn(ensures(r == i32(7))) -> (r : i32))({
  (c : Color) = .Green(i32(7));
  match(c, .Red => i32(0), .Green(v) => v)
});
last_arm_binds :: (fn(c : Color, ensures(r >= i32(0))) -> (r : i32))(
  match(
    c,
    .Red => i32(0),
    .Green(v) => cond((v >= i32(0)) => v, true => i32(0))
  )
);
