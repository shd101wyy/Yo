// A3 of plans/ATS_LESSONS_BEYOND_INDEXED_TYPES.md (ATS's total, pure `-<>`
// functions in proofs): an UNCONTRACTED function whose body the verifier can
// express is transparent to specs, so a contract can name it instead of
// restating it as a ghost_fn.
pragma(Pragma.Verify);

sq :: (fn(x : i32) -> i32)(x * x);

clamp :: (fn(x : i32, lo : i32, hi : i32) -> i32)(
  cond(
    (x < lo) => lo,
    (x > hi) => hi,
    true => x
  )
);

square_small :: (fn(x : i32, requires((x > i32(0)) && (x < i32(10))), ensures(r == sq(x))) -> (r : i32))(x * x);

clamped :: (fn(x : i32, ensures((r >= i32(0)) && (r <= i32(100)), r == clamp(x, i32(0), i32(100)))) -> (r : i32))(
  clamp(x, i32(0), i32(100))
);
