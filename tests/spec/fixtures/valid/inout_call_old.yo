// A `&mut` argument at a call site is the callee's post-call value, and the
// callee's `old(v)` reads its pre-call value
// (issues/fixed/2026-10-23-a-mut-ref-argument-keeps-its-pre-call-value-at-a-call-site.md):
// `twice_bumped` proves `r == n + 2` from `inc`'s two-state contract.
pragma(Pragma.Verify);

inc :: (fn(v : &mut i32, requires(v >= i32(0), v <= i32(1000)), ensures(v == (old(v) + i32(1)))) -> unit)({
  v = (v + i32(1));
});

twice_bumped :: (fn(n : i32, requires(n >= i32(0), n <= i32(10)), ensures(r == (n + i32(2)))) -> (r : i32))({
  (mut(y) : i32) = n;
  inc(&mut y);
  inc(&mut y);
  y
});
export(inc, twice_bumped);
