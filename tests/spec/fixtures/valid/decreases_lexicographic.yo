// A5 of plans/ATS_LESSONS_BEYOND_INDEXED_TYPES.md (ATS `.<m, n>.`): a
// lexicographic measure decreases(i, j). `walk(i - 1, 100)` RAISES j while
// lowering i, so no single measure of the two proves termination; the pair
// does: each call lowers i, or keeps i and lowers j.
pragma(Pragma.Verify);

walk :: (fn(i : u32, j : u32, decreases(i, j)) -> u32)(
  cond(
    ((i == u32(0)) && (j == u32(0))) => u32(0),
    (j == u32(0)) => walk(i - u32(1), u32(100)),
    true => walk(i, j - u32(1))
  )
);
