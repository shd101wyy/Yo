// The Multiset flavor: elem→count over an Array sort. ms_single then
// ms_add bumps the count; the identity proves, and the == 3 twin refutes.
pragma(Pragma.Verify);

ms_counts :: (
  fn(
    x : i32,
    requires(x >= i32(0)),
    ensures(ms_count(ms_add(ms_single(x), x), x) == i64(2))
  ) -> (result : i32)
)({
  z := x;
  z
});
