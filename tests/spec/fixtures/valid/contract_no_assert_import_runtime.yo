// Runtime-mode twin of contract_no_assert_import.yo: no verify pragma, no
// std/assert import — the spliced guards must hold at RUNTIME (the
// module-level initializer calls the contracted function, so the splice
// executes during the load itself).
half :: (fn(x : i32, requires(i32(1) == i32(1))) -> (r : i32))(
  x / i32(2)
);

quotient := half(i32(10));
