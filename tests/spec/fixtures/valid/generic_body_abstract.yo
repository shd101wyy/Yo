// R1 task 4 of plans/backlog/ATS_STYLE_INDEXED_TYPES.md / FORMAL_VERIFICATION.md
// V6 task 2: a CONTRACTED generic function's body is verified abstractly —
// its type parameter is an uninterpreted sort (equality and pass-through
// only), and every other obligation in the body is proved as usual
// (issues/fixed/verifier-contracted-generic-fn-is-silently-unverified.md).
pragma(Pragma.Verify);

identity :: (fn(generic(T : Type), x : T, ensures(result == x)) -> (result : T))(x);

pick :: (
  fn(generic(T : Type), b : bool, x : T, y : T, ensures(cond(b => (result == x), true => (result == y)))) -> (result : T)
)(
  cond(
    b => x,
    true => y
  )
);

tenth :: (fn(generic(T : Type), x : T, n : i32, requires(n != i32(0)), ensures(r == (i32(10) / n))) -> (r : i32))(i32(10) / n);
