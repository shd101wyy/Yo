// The V5 exit criterion (FORMAL_VERIFICATION.md task 6): an in-place
// insertion sort proves its FULL functional spec — sorted(s) and
// permutation(s, old(s)) — through the ghost Multiset of the array's
// elements (ms_of folds an elem→count array over the compile-time
// length). N is a compile-time constant (Array(T, N)), so every
// quantifier instantiates over a concrete index range.
//
// The proof shape: the OUTER invariant carries sortedness of [0, i) and
// multiset preservation of the whole array; the INNER shift loop pins
// the array to its entry snapshot s0 pointwise — untouched prefix
// [0, j+1], shifted window [j+2, i] (one right), and the scan fact that
// every already-shifted element exceeds tmp. The exit's insert at j+1
// re-establishes both outer facts (case j = -1: everything shifted).
pragma(Pragma.Verify);

insertion_sort :: (
  fn(
    s : Array(i64, 8),
    ensures(
      forall(p : i64, ((p >= i64(0)) && (p < i64(7))) ==> (s(p) <= s(p + i64(1)))),
      forall(x : i64, ms_count(ms_of(s), x) == ms_count(ms_of(old(s)), x))
    )
  ) -> (result : unit)
)({
  i := i64(1);
  while(i < i64(8), {
    invariant(
      i >= i64(1),
      i <= i64(8),
      forall(p : i64, ((p >= i64(0)) && (p < (i - i64(1)))) ==> (s(p) <= s(p + i64(1)))),
      forall(x : i64, ms_count(ms_of(s), x) == ms_count(ms_of(old(s)), x))
    );
    decreases(i64(8) - i);
    tmp := s(i);
    s0 := s;
    j := (i - i64(1));
    while((j >= i64(0)) && (s(j) > tmp), {
      invariant(
        j >= i64(-1),
        j <= (i - i64(1)),
        forall(p : i64, ((p < i64(0)) || (p > i)) ==> (s(p) == s0(p))),
        forall(p : i64, ((p >= i64(0)) && (p <= (j + i64(1)))) ==> (s(p) == s0(p))),
        forall(p : i64, ((p >= (j + i64(2))) && (p <= i)) ==> (s(p) == s0(p - i64(1)))),
        forall(p : i64, ((p >= (j + i64(2))) && (p <= i)) ==> (s(p) > tmp))
      );
      decreases(j + i64(1));
      s(j + i64(1)) = s(j);
      j = (j - i64(1));
    });
    s(j + i64(1)) = tmp;
    i = (i + i64(1));
  });
});
