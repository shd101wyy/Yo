// A law's `ensures` calls a contracted function imported from another file.
// The clause's call needs the callee's contract instance just like a call in a
// body (issues/fixed/law-over-an-imported-callee-cannot-verify.md). Each call
// is modular — its result is constrained only by `abs_value`'s own `ensures` —
// so the clause claims what that contract gives. Only a law's clauses may call
// a function with a contract: nothing can cite a law
// (plans/backlog/SPEC_AND_PROOF.md §4.2).
pragma(Pragma.Verify);
{ abs_value } :: import("./law-imported-callee-math.yo");

plus_abs :: (
  fn(
    x : i64,
    requires((x > i64(-1000)) && (x < i64(1000))),
    ensures(r >= i64(1))
  ) -> (r : i64)
)(abs_value(x) + i64(1));

plus_abs_bound :: law(
  fn(
    x : i64,
    requires((x > i64(-1000)) && (x < i64(1000))),
    ensures((plus_abs(x) >= i64(1)) && (abs_value(x) < i64(1000)))
  ) -> unit
);
export(plus_abs);
