// R1 of plans/backlog/ATS_STYLE_INDEXED_TYPES.md: the rest of the DML worked
// examples over ArrayList (concat and get are dml_list_concat.yo and
// dml_list_get.yo). Each result length is stated as an index relation and
// proved from the loop invariant and push's std contract.
pragma(Pragma.Verify);
{ ArrayList } :: import("std/collections/array_list");

// zip: equal lengths in, the same length out (ATS: list(n) -> list(n) -> list(n)).
zip_max :: (
  fn(imm(a) : ArrayList(i32), imm(b) : ArrayList(i32), requires(a.len() == b.len()), ensures(r.len() == a.len())) -> (r : ArrayList(i32))
)({
  out := ArrayList(i32).new();
  (i : usize) = usize(0);
  while(i < a.len(), {
    invariant(i <= a.len(), out.len() == i);
    out.push(
      cond(
        (a(i) > b(i)) => a(i),
        true => b(i)
      )
    );
    i = (i + usize(1));
  });
  out
});

// filter: no longer than the input (ATS: list(n) -> [m | m <= n] list(m)).
filter_pos :: (fn(imm(xs) : ArrayList(i32), ensures(r.len() <= xs.len())) -> (r : ArrayList(i32)))({
  out := ArrayList(i32).new();
  (i : usize) = usize(0);
  while(i < xs.len(), {
    invariant(i <= xs.len(), out.len() <= i);
    if(xs(i) > i32(0), {
      out.push(xs(i));
    });
    i = (i + usize(1));
  });
  out
});

// reverse: the same length, read back to front.
reverse :: (fn(imm(xs) : ArrayList(i32), ensures(r.len() == xs.len())) -> (r : ArrayList(i32)))({
  out := ArrayList(i32).new();
  (i : usize) = xs.len();
  while(i > usize(0), {
    invariant(i <= xs.len(), out.len() == (xs.len() - i));
    i = (i - usize(1));
    out.push(xs(i));
  });
  out
});
