// expect-elided: 1
// 5b twin: `i < 4` is checked at entry (verify mode keeps runtime-checkable
// requires), so the subscript needs no bounds guard.
pragma(Pragma.Verify);
{ println } :: import("std/fmt");

pick :: (fn(xs : Array(i32, usize(4)), i : usize, requires(i < usize(4))) -> i32)(
  xs(i)
);

main :: (fn() -> unit)({
  xs := Array(i32, usize(4))(i32(1), i32(2), i32(3), i32(4));
  println(pick(xs, usize(2)));
});
export(main);
