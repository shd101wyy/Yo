// expect-elided: 1
// 5b twin (plans/backlog/SAFE_MODE_5B_VERIFIED_GUARD_ELISION.md §5.3): the
// requires is runtime-checked at entry, so the proved non-zero divisor
// licenses removing the division guard.
pragma(Pragma.VerifyOrAssert);
{ println } :: import("std/fmt");

udiv :: (fn(a : u32, b : u32, requires(b != u32(0))) -> u32)(
  a / b
);

main :: (fn() -> unit)({
  println(udiv(u32(10), u32(2)));
});
export(main);
