// expect-elided: 0
// 5b twin: a signed `/` needs its `MIN / -1` proof too. `b != 0` proves the
// divisor non-zero but allows `MIN / -1`, so the one signed guard stays.
pragma(Pragma.VerifyOrAssert);
{ println } :: import("std/fmt");

sdiv :: (fn(a : i32, b : i32, requires(b != i32(0))) -> i32)(
  a / b
);

main :: (fn() -> unit)({
  println(sdiv(i32(10), i32(2)));
});
export(main);
