// expect-elided: 0
// 5b twin: a generic body is verified only ABSTRACTLY (§5.1 rule 5,
// `issues/fixed/verifier-contracted-generic-fn-is-silently-unverified.md`), so its
// specializations keep the guard even though its proof discharges it.
pragma(Pragma.VerifyOrAssert);
{ println } :: import("std/fmt");

scaled :: (fn(generic(T : Type), imm(tag) : T, a : u32, b : u32, requires(b != u32(0))) -> u32)(
  a / b
);

main :: (fn() -> unit)({
  println(scaled(i32(1), u32(10), u32(2)));
  println(scaled(true, u32(9), u32(3)));
});
export(main);
