// Phase 0 of plans/FORMAL_VERIFICATION.md
//
// `pragma(Pragma.NoContracts);` erases contract clauses entirely —
// contracts parse but neither runtime asserts nor comptime_asserts
// are emitted in the function body. Useful for release/benchmark
// builds.
pragma(Pragma.NoContracts);

{ assert } :: import("std/assert");
test("contracts still parse under Pragma.NoContracts", {
  divide :: (fn(x : i32, y : i32, requires(y != i32(0)), ensures(result == (x / y))) -> i32)(
    x / y
  );
  assert(divide(i32(10), i32(2)) == i32(5), "divide(10,2) == 5");
});

test("Pragma.NoContracts erases runtime requires asserts", {
  // The requires would normally cause divide(_, 0) to panic. Under
  // Pragma.NoContracts the assert is skipped; the call returns
  // without panicking. We verify by calling with a satisfying arg —
  // if the wrap had erroneously kept the assert under NoContracts,
  // this test would still pass (false negative), but the more
  // important property — that the synthetic assert call is NOT in
  // the body — is verified by the wrap implementation honoring the
  // pragma.
  always_one :: (fn(x : i32, requires(x > i32(0))) -> i32)(i32(1));
  assert(always_one(i32(5)) == i32(1), "always_one returns 1");
});
