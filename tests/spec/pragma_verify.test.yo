// Phase 0 of plans/backlog/FORMAL_VERIFICATION.md (comment updated for V3)
//
// `pragma(Pragma.Verify);` parses cleanly and contract-bearing code
// still compiles. Since V3 the pragma is HONORED when this file is a
// verification target (`yo verify`): proofs replace the runtime asserts.
// Under plain `yo test`/`compile` the file is not a verification target,
// so contracts lower to runtime/comptime asserts as always. This test
// confirms the pragma is accepted and the file type-checks and runs.
pragma(Pragma.Verify);

{ assert } :: import("std/assert");
test("contracts compile under Pragma.Verify (warns, does not error)", {
  divide :: (fn(x : i32, y : i32, requires(y != i32(0)), ensures(result == (x / y))) -> (result : i32))(
    x / y
  );
  assert(divide(i32(10), i32(2)) == i32(5), "divide(10,2) == 5 under Verify");
});
