{ assert } :: import("std/assert");
open(import("std/string"));
open(import("std/fmt"));
open(import("std/collections/array_list"));
{ HashMap } :: import("std/collections/hash_map");
// `unit` in a C DECLARATION position — a by-value parameter, a struct field, a
// tuple element, a generic instantiated at T = unit — used to be emitted as C
// `void`, which is not an object type: "argument may not have 'void' type",
// "field has incomplete type 'void'". A by-value PARAMETER is spelled as a
// one-byte placeholder (get_storage_type_string) with its argument slot filled;
// every STORAGE position erases the unit outright — it is a zero-sized type.
// See issues/fixed/unit-typed-params-and-fields-emit-c-void.md and
// issues/fixed/unit-should-be-a-true-zero-sized-type-like-rust.md.
_takes_unit :: (fn(x : unit) -> i32)(i32(7));
_generic_id :: (fn(generic(T : Type), x : T) -> i32)(i32(9));
_UnitField :: struct(a : i32, b : unit);
test("unit as a by-value parameter", {
  assert(_takes_unit(()) == i32(7), "non-generic unit parameter");
  assert(_generic_id(()) == i32(9), "generic instantiated at T = unit");
});
test("unit as a struct field", {
  s := _UnitField(a : i32(1), b : ());
  assert(s.a == i32(1), "the non-unit field survives");
});
test("unit inside a tuple", {
  p := (i32(3), ());
  assert(p.0 == i32(3), "the non-unit element survives");
});
test("unit as a generic container element", {
  xs := ArrayList(unit).new();
  xs.push(());
  xs.push(());
  assert(xs.len() == usize(2), "ArrayList(unit) stores elements");
});
test("unit printing (D3.8)", {
  assert(().to_string() == "()", "unit stringifies");
  println(());
});
test("unit as an enum payload still works", {
  // The enum path already erased unit payloads before this change — this is the
  // no-regression witness, not new behaviour.
  o := Option(unit).Some(());
  assert(o.is_some(), "Option(unit)");
  r := Result(unit, String).Ok(());
  assert(r.is_ok(), "Result(unit, E)");
});
// ---------------------------------------------------------------------------
// LAYOUT: `sizeof` of an aggregate with a `unit` field must equal the C struct
// codegen emits for it — and `unit` is a TRUE ZERO-SIZED TYPE, as in Rust.
//
// A `unit` field emits NO C member, so it costs nothing (C members are accessed
// by name, so erasing one shifts nothing); an aggregate whose every field is
// `unit` is an empty C struct (GNU extension, sizeof 0). `sizeof` folds to a C
// literal and then sizes allocations that C-typed pointer arithmetic strides
// through, so the layout model must report exactly the object the emitter lays
// out — a disagreement in EITHER direction is a heap bug. The interim one-byte
// placeholder (v0.2.25) was the safe stopgap for the under-allocating
// direction; issues/fixed/unit-should-be-a-true-zero-sized-type-like-rust.md
// is the erasure that made 0 right.
//
// `comptime_assert` is INERT inside a fn/test body — it only fires at module
// level (issues/comptime-assert-never-fires-inside-a-function-body.md) — so
// every size is pinned as a module-level `::` binding and read back by a
// RUNTIME assert. The round-trip tests that follow are what catch a
// CODEGEN-side change: a size equality alone would not notice the C struct
// moving underneath it.
// ---------------------------------------------------------------------------
_OnlyUnit :: struct(u : unit);
_UnitFirst :: struct(u : unit, a : i32);
_UnitMid :: struct(a : i32, u : unit, b : i32);
_UnitLast :: struct(a : i32, u : unit);
_AllUnits :: struct(x : unit, y : unit, z : unit);
_NestedUnit :: struct(a : i32, inner : _UnitLast, b : i32);
_AllUnitsWrapped :: struct(a : i32, inner : _AllUnits, b : i32);
_UnitTuple :: Tuple(i32, unit);
_AllUnitTuple :: Tuple(unit, unit);
_UnitPayloadEnum :: enum(A(a : i32, u : unit), B);
_SZ_UNIT :: sizeof(unit);
_SZ_ONLY_UNIT :: sizeof(_OnlyUnit);
_SZ_UNIT_FIRST :: sizeof(_UnitFirst);
_SZ_UNIT_MID :: sizeof(_UnitMid);
_SZ_UNIT_LAST :: sizeof(_UnitLast);
_SZ_ALL_UNITS :: sizeof(_AllUnits);
_SZ_NESTED_UNIT :: sizeof(_NestedUnit);
_SZ_ALL_UNITS_WRAPPED :: sizeof(_AllUnitsWrapped);
_SZ_UNIT_TUPLE :: sizeof(_UnitTuple);
_SZ_ALL_UNIT_TUPLE :: sizeof(_AllUnitTuple);
_SZ_UNIT_PAYLOAD_ENUM :: sizeof(_UnitPayloadEnum);
_SZ_OPTION_UNIT :: sizeof(Option(unit));
_SZ_UNIT_ARRAY :: sizeof(Array(unit, 16));
_ALIGN_ONLY_UNIT :: alignof(_OnlyUnit);
_ALIGN_UNIT_LAST :: alignof(_UnitLast);
test("sizeof of a unit-bearing aggregate matches the emitted C struct", {
  assert(_SZ_UNIT == usize(0), "unit is a zero-sized type");
  // struct { } — empty, GNU sizeof 0
  assert(_SZ_ONLY_UNIT == usize(0), "struct(u : unit)");
  assert(_ALIGN_ONLY_UNIT == usize(1), "struct(u : unit) alignment");
  // struct { int32_t a; }
  assert(_SZ_UNIT_FIRST == usize(4), "unit field FIRST");
  // struct { int32_t a; int32_t b; }
  assert(_SZ_UNIT_MID == usize(8), "unit field in the MIDDLE");
  // struct { int32_t a; }
  assert(_SZ_UNIT_LAST == usize(4), "unit field LAST");
  assert(_ALIGN_UNIT_LAST == usize(4), "unit field LAST alignment");
  // struct { } — three erased fields
  assert(_SZ_ALL_UNITS == usize(0), "an ALL-unit aggregate is zero-sized");
  // struct { int32_t a; struct { int32_t a; } inner; int32_t b; }
  assert(_SZ_NESTED_UNIT == usize(12), "a NESTED aggregate carrying a unit field");
  // struct { int32_t a; struct { } inner; int32_t b; }
  assert(_SZ_ALL_UNITS_WRAPPED == usize(8), "a nested ALL-unit aggregate costs nothing");
  // typedef struct { int32_t _0; }
  assert(_SZ_UNIT_TUPLE == usize(4), "a tuple with a unit element");
  // typedef struct { }
  assert(_SZ_ALL_UNIT_TUPLE == usize(0), "an ALL-unit tuple");
  // The data union keeps only the non-unit variant fields: tag(4) + union {
  // struct { int32_t a; } } (4).
  assert(_SZ_UNIT_PAYLOAD_ENUM == usize(8), "unit variant fields are erased, not padded");
  assert(_SZ_OPTION_UNIT == usize(4), "Option(unit) is tag-only");
  assert(_SZ_UNIT_ARRAY == usize(0), "Array(unit, 16) is zero-sized");
});
test("an ArrayList of a unit-bearing aggregate round-trips every element", {
  // The growth path is `malloc(sizeof(T) * capacity)` addressed as `T*`, so a
  // sizeof that is short of the C stride writes past the block. Read every
  // element back — a short buffer scrambles the sentinels even when it does
  // not fault.
  n := usize(64);
  first := ArrayList(_UnitFirst).new();
  mid := ArrayList(_UnitMid).new();
  last := ArrayList(_UnitLast).new();
  nested := ArrayList(_NestedUnit).new();
  wrapped := ArrayList(_AllUnitsWrapped).new();
  (i : usize) = usize(0);
  while(i < n, {
    v := i32(i);
    first.push(_UnitFirst(u : (), a : v));
    mid.push(_UnitMid(a : v, u : (), b : (v + i32(1000))));
    last.push(_UnitLast(a : v, u : ()));
    nested.push(
      _NestedUnit(a : v, inner : _UnitLast(a : (v + i32(7)), u : ()), b : (v + i32(2000)))
    );
    wrapped.push(
      _AllUnitsWrapped(
        a : v,
        inner : _AllUnits(x : (), y : (), z : ()),
        b : (v + i32(3000))
      )
    );
    i = (i + usize(1));
  });
  assert(first.len() == n, "ArrayList(_UnitFirst) length");
  assert(mid.len() == n, "ArrayList(_UnitMid) length");
  assert(last.len() == n, "ArrayList(_UnitLast) length");
  assert(nested.len() == n, "ArrayList(_NestedUnit) length");
  assert(wrapped.len() == n, "ArrayList(_AllUnitsWrapped) length");
  (bad : usize) = usize(0);
  i = usize(0);
  while(i < n, {
    v := i32(i);
    if(match(first.get(i), .Some(e) => e.a, .None => i32(-1)) != v, {
      bad = (bad + usize(1));
    });
    if(match(mid.get(i), .Some(e) => e.a, .None => i32(-1)) != v, {
      bad = (bad + usize(1));
    });
    if(match(mid.get(i), .Some(e) => e.b, .None => i32(-1)) != (v + i32(1000)), {
      bad = (bad + usize(1));
    });
    if(match(last.get(i), .Some(e) => e.a, .None => i32(-1)) != v, {
      bad = (bad + usize(1));
    });
    if(match(nested.get(i), .Some(e) => e.a, .None => i32(-1)) != v, {
      bad = (bad + usize(1));
    });
    if(match(nested.get(i), .Some(e) => e.inner.a, .None => i32(-1)) != (v + i32(7)), {
      bad = (bad + usize(1));
    });
    if(match(nested.get(i), .Some(e) => e.b, .None => i32(-1)) != (v + i32(2000)), {
      bad = (bad + usize(1));
    });
    if(match(wrapped.get(i), .Some(e) => e.a, .None => i32(-1)) != v, {
      bad = (bad + usize(1));
    });
    if(match(wrapped.get(i), .Some(e) => e.b, .None => i32(-1)) != (v + i32(3000)), {
      bad = (bad + usize(1));
    });
    i = (i + usize(1));
  });
  assert(bad == usize(0), "every sentinel survives the sizeof-sized buffer");
});
test("an ArrayList of an ALL-unit aggregate stores every element", {
  // sizeof(_AllUnits) used to be 0, so this mallocs a ZERO-byte block and then
  // stores a 3-byte struct into it — the store is NOT suppressed the way a bare
  // `unit` store is, because the whole aggregate is written.
  xs := ArrayList(_AllUnits).new();
  (i : usize) = usize(0);
  while(i < usize(64), {
    xs.push(_AllUnits(x : (), y : (), z : ()));
    i = (i + usize(1));
  });
  assert(xs.len() == usize(64), "ArrayList(_AllUnits) length");
  assert(xs.get(usize(63)).is_some(), "the last element is readable");
});
test("HashMap(K, unit) does not overflow its bucket array", {
  // `bucket_size :: sizeof(MapEntry(K, V))` sizes the bucket array, which is
  // then indexed as `MapEntry*`. With V = unit that entry carries a `unit`
  // field, so a zero-counted `unit` made an EMPTY 16-bucket map already 64
  // bytes short.
  m := HashMap(i32, unit).new();
  (i : i32) = i32(0);
  while(i < i32(64), {
    _r := m.insert(i, ());
    i = (i + i32(1));
  });
  assert(m.len() == usize(64), "every key is stored");
  (missing : i32) = i32(0);
  (j : i32) = i32(0);
  while(j < i32(64), {
    if(!m.contains_key(j), {
      missing = (missing + i32(1));
    });
    j = (j + i32(1));
  });
  assert(missing == i32(0), "every key is found again");
});
// ZERO-SIZED ELEMENTS: an ArrayList of a zero-sized type never grows a buffer
// (`_zst_anchor`, std/collections/array_list.yo) — one anchor block, capacity
// SIZE_MAX. The counts below are what a `malloc(0)` + `realloc(p, 0)` path
// would have failed on: glibc and the Windows CRT free `p` and return NULL, so
// the SECOND growth (element 5) reported "allocation failed".
_Counter :: ref(struct(n : i32));
_bump :: (fn(c : _Counter) -> unit)({
  c.n = (c.n + i32(1));
});
_RefWithUnit :: ref(struct(a : i32, u : unit, s : String));
test("an ArrayList of a zero-sized element type grows to any length", {
  xs := ArrayList(unit).new();
  (i : usize) = usize(0);
  while(i < usize(1000), {
    xs.push(());
    i = (i + usize(1));
  });
  assert(xs.len() == usize(1000), "ArrayList(unit) holds 1000 elements");
  assert(xs.get(usize(999)).is_some(), "the last unit is readable");
  assert(xs.pop().is_some(), "pop returns a unit");
  assert(xs.len() == usize(999), "pop shrinks the length");
  assert(match(xs.shrink_to_fit(), .Ok(_) => true, .Err(_) => false), "shrink_to_fit is a no-op, not a realloc(p, 0)");
  assert(xs.len() == usize(999), "shrink_to_fit keeps the elements");
  ys := ArrayList(unit).with_capacity(usize(10));
  ys.push(());
  assert(ys.len() == usize(1), "with_capacity(10) for a ZST still pushes");
  all := ArrayList(_AllUnits).new();
  i = usize(0);
  while(i < usize(300), {
    all.push(_AllUnits(x : (), y : (), z : ()));
    i = (i + usize(1));
  });
  assert(all.len() == usize(300), "ArrayList of an all-unit struct holds 300 elements");
  assert(all.get(usize(299)).is_some(), "an all-unit struct element is readable");
});
test("a unit field is erased from the C layout but still reads, writes and compares", {
  s := _UnitLast(a : i32(5), u : ());
  k := s.u;
  s.u = ();
  assert(s.a == i32(5), "the non-unit field survives a unit read and write");
  // `unit` implements Clone (and Eq/Ord/Hash) in the prelude, as Rust's `()`
  // does. NOTE: infix `==` on two unit operands still does not dispatch to
  // that impl (pre-existing — issues/equality-operator-without-an-eq-impl-evaluates-to-unit.md,
  // "Follow-up 2026-09-06"), so `derive(Eq)` over a struct with a unit field
  // is not asserted here yet.
  k4 := k.clone();
  r := _RefWithUnit(a : i32(9), u : (), s : String.from("nine"));
  k2 := r.u;
  assert(r.a == i32(9), "ref struct: the field after an erased unit is intact");
  assert(r.s == "nine", "ref struct: the RC field after an erased unit is intact");
  (t : _UnitTuple) = (i32(3), ());
  k3 := t.1;
  assert(t.0 == i32(3), "tuple: the element before an erased unit is intact");
  m := HashMap(String, unit).new();
  m.insert(String.from("a"), ());
  m.insert(String.from("b"), ());
  assert(m.len() == usize(2), "HashMap(K, unit) as a set");
  assert(m.get(String.from("a")).is_some(), "HashMap(K, unit) lookup");
});
test("a unit-typed constructor argument still runs for its side effects", {
  c := _Counter(n : i32(0));
  v := _UnitLast(a : i32(1), u : _bump(c));
  r := _RefWithUnit(a : i32(2), u : _bump(c), s : String.from("s"));
  (t : _UnitTuple) = (i32(3), _bump(c));
  assert(c.n == i32(3), `each erased unit argument ran once (got ${c.n})`);
  assert((v.a + r.a + t.0) == i32(6), "the non-unit fields are intact");
});
// `Array(unit, N)` and a GENERIC struct instantiated at T = unit: the erasure
// must hold when the unit arrives through a type parameter, and an array of a
// zero-sized element has no `data` member to construct, fill or index.
_Pair :: (fn(comptime(T) : Type) -> comptime(Type))(struct(x : T, n : i32));
_pair_x :: (fn(generic(T : Type), p : _Pair(T)) -> T)(p.x);
_pair_n :: (fn(generic(T : Type), p : _Pair(T)) -> i32)(p.n);
_mk_pair :: (fn(generic(T : Type), v : T, n : i32) -> _Pair(T))(_Pair(T)(x : v, n : n));
_SZ_PAIR_UNIT :: sizeof(_Pair(unit));
_SZ_PAIR_I32 :: sizeof(_Pair(i32));
test("a generic struct at T = unit erases the field; Array(unit, N) constructs, fills and indexes", {
  assert(_SZ_PAIR_UNIT == usize(4), "Pair(unit) is just the i32");
  assert(_SZ_PAIR_I32 == usize(8), "Pair(i32) is two i32s");
  p := _mk_pair((), i32(7));
  u := _pair_x(p);
  assert(_pair_n(p) == i32(7), "the non-unit field of a generic-at-unit struct is intact");
  q := _Pair(unit)(x : (), n : i32(9));
  assert(q.n == i32(9), "direct construction of a generic-at-unit struct");
  arr := Array(unit, usize(3)).fill(());
  assert(arr.len() == usize(3), "Array(unit, 3).fill(()) has length 3");
  e := arr(usize(1));
  assert(sizeof(Array(unit, usize(3))) == usize(0), "Array(unit, 3) is zero-sized");
});
