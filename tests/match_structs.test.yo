//! Struct scrutinees and struct sub-patterns (plans/reference/MATCH_PATTERN_MATCHING.md
//! P4): named `S(label : p, name)` and anonymous `{label : p, name}` forms,
//! partial destructuring, any sub-pattern per field, on runtime and
//! compile-time scrutinees.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
Point :: struct(x : i32, y : i32);
derive(Point, Copy, Clone);
Person :: struct(name : String, age : i32);
test("a named struct pattern discriminates by field", {
  f :: (fn(p : Point) -> i32)(
    match(
      p,
      Point(x : 0, y) => y,
      Point(x, y : 0) => (x * i32(10)),
      Point(x, y) => ((x * i32(100)) + y)
    )
  );
  assert(f(Point(0, 7)) == i32(7));
  assert(f(Point(3, 0)) == i32(30));
  assert(f(Point(3, 7)) == i32(307));
});
test("an anonymous struct pattern binds same-named fields", {
  g :: (fn(p : Point) -> i32)(
    match(p, { x : 0, y } => y, { x, y } => (x + y))
  );
  assert(g(Point(0, 7)) == i32(7));
  assert(g(Point(3, 7)) == i32(10));
});
test("a struct pattern is partial: unlisted fields match anything", {
  h :: (fn(p : &Person) -> i32)(
    match(
      p,
      Person(age : 0) => i32(-1),
      Person(name : "alice") => i32(1),
      Person(name, age) => age
    )
  );
  assert(h(Person(String.from("bob"), 0)) == i32(-1));
  assert(h(Person(String.from("alice"), 42)) == i32(1));
  assert(h(Person(String.from("bob"), 42)) == i32(42));
});
test("a field may carry any sub-pattern", {
  Cell :: enum(Full(v : i32), Empty);
  derive(Cell, Copy, Clone);
  Holder :: struct(tag : Cell, note : i32);
  k :: (fn(hh : &Holder) -> i32)(
    match(
      hh,
      Holder(tag : .Full(7), note) => (note + i32(100)),
      Holder(tag : .Full(v), note) => (v + note),
      Holder(tag : .Empty, note) => (note * i32(-1))
    )
  );
  assert(k(Holder(Cell.Full(7), 1)) == i32(101));
  assert(k(Holder(Cell.Full(9), 1)) == i32(10));
  assert(k(Holder(Cell.Empty, 5)) == i32(-5));
});
test("a guard sees the struct pattern's bindings", {
  m :: (fn(p : Point) -> i32)(
    match(
      p,
      (Point(x, y) && ((x + y) > i32(10))) => i32(1),
      _ => i32(0)
    )
  );
  assert(m(Point(5, 6)) == i32(1));
  assert(m(Point(5, 5)) == i32(0));
});
test("compile-time scrutinee: the struct arm is selected at compile time", {
  K :: Point(3, 9);
  r :: match(
    K,
    Point(x : 3, y) => y,
    _ => i32(0)
  );
  assert(r == i32(9));
});
test("an enum payload holding a struct takes a struct sub-pattern", {
  Wrap :: enum(W(p : Point), Nothing);
  w :: (fn(e : &Wrap) -> i32)(
    match(
      e,
      .W(Point(x : 0, y)) => y,
      .W(Point(x, y)) => (x - y),
      .Nothing => i32(0)
    )
  );
  assert(w(Wrap.W(Point(0, 9))) == i32(9));
  assert(w(Wrap.W(Point(9, 3))) == i32(6));
  assert(w(Wrap.Nothing) == i32(0));
});
test("a whole-value binding of a struct pattern", {
  n :: (fn(p : Point) -> i32)(
    match(
      p,
      ((whole := Point(x : 0, y)) && (y > i32(5))) => (whole.x + whole.y),
      Point(x, _) => x
    )
  );
  assert(n(Point(0, 9)) == i32(9));
  assert(n(Point(0, 3)) == i32(0));
  assert(n(Point(4, 1)) == i32(4));
});
test("a reference-semantics struct pattern reads through the pointer", {
  SharedPoint :: ref(struct(x : i32, y : i32));
  s :: (fn(p : &SharedPoint) -> i32)(
    match(p, { x : 0, y } => y, { x, y } => (x + y))
  );
  assert(s(SharedPoint(0, 7)) == i32(7));
  assert(s(SharedPoint(3, 7)) == i32(10));
});
// A `match` through a borrowed ELEMENT reads the element in place
// (decision 26's "A projection scrutinee"): `match(&xs(i), …)` binds its
// arms through the element's place, as a `&xs(i)` argument does. Before the
// in-place route the scrutinee's begin evaluation attached an OWNING temp,
// and owning a projection's element means copying it — E0901 for a
// move-only element, although `&xs(i)` is the repair E0901 itself names
// (issues/fixed/2026-10-17-a-match-through-a-borrowed-element-copies-the-element.md).
// Plain data without `Copy`/`Clone` is move-only: the element read must not
// copy it (a struct with an RC field (a `String`) is still implicitly
// copyable, which does not exercise the rule).
_MvElem :: struct(a : i32, b : i64);
test("a match through a borrowed element of a move-only struct", {
  xs := ArrayList(_MvElem).new();
  xs.push(_MvElem(a : i32(3), b : i64(30)));
  xs.push(_MvElem(a : i32(4), b : i64(40)));
  match(
    &xs(usize(1)),
    _MvElem(a : v, b : s) => {
      assert(v == i32(4), "the borrowed element's first field");
      assert(s == i64(40), "and its second field, read through the place");
    }
  );
  // The list still owns its elements: nothing was moved or dropped out of it.
  assert(xs.len() == usize(2), "the list keeps both elements");
  assert(xs(usize(1)).a == i32(4), "and the matched element is intact");
});
_MvTree :: enum(Leaf(v : i32), At(sub : Box(Self)));
test("a match through a borrowed element of a Box-children enum", {
  xs := ArrayList(_MvTree).new();
  xs.push(_MvTree.Leaf(v : i32(7)));
  xs.push(_MvTree.At(sub : box(_MvTree.Leaf(v : i32(9)))));
  match(
    &xs(usize(1)),
    .Leaf(v) => assert(false, "the second element is not a Leaf: got ${v}"),
    // The Box pattern binds the payload through the element's place.
    .At(Box(s)) => assert(s.v == i32(9), "the boxed leaf's value through the borrowed element")
  );
  assert(xs.len() == usize(2), "the list keeps both elements");
});
