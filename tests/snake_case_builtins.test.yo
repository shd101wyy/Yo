//! `size_of`, `align_of`, `type_of` and `type_id` are the builtins' only
//! names: V3b Generation B (plans/VALUES_BY_DEFAULT.md) swept the tree and
//! deleted the C-style `sizeof`, `alignof`, `typeof` and `typeid`.
{ assert } :: import("std/assert");
{ String } :: import("std/string");

_SnPoint :: struct(x : i32, y : i64, z : u8);
_SnShape :: enum(Dot, Line(len : i32));
_SN_SIZE :: size_of(_SnPoint);
_SN_ALIGN :: align_of(_SnPoint);

test("size_of", {
  comptime_assert(size_of(i64) == usize(8), "i64");
  comptime_assert(size_of(u8) == usize(1), "u8");
  comptime_assert(size_of(_SnPoint) == usize(24), "a struct, padded to its alignment");
  comptime_assert(_SN_SIZE == size_of(_SnPoint), "a module-level constant");
  n := size_of(_SnShape);
  assert(n >= size_of(i32), "a runtime use, an enum");
});

test("align_of", {
  comptime_assert(align_of(i64) == usize(8), "i64");
  comptime_assert(align_of(_SnPoint) == usize(8), "a struct takes its widest field's");
  comptime_assert(_SN_ALIGN == align_of(_SnPoint), "a module-level constant");
});

test("type_of", {
  x := i32(7);
  s := String.from("t");
  comptime_assert(Type.is_compatible_with(type_of(x), i32), "a local");
  comptime_assert(Type.is_compatible_with(type_of(s), String), "a std value");
  (y : type_of(x)) = (x + i32(1));
  assert(y == i32(8), "type_of in a type annotation");
});

test("type_id", {
  assert(type_id(i32) == type_id(i32), "one type, one id");
  assert(type_id(i32) != type_id(i64), "distinct types keep distinct ids");
  comptime_expect_error(type_id(i32(1)), "expects a type argument");
});

test("the C-style spellings are gone", {
  comptime_expect_error(sizeof(i64), "sizeof");
  comptime_expect_error(alignof(i64), "alignof");
  comptime_expect_error(typeof(i32(1)), "typeof");
  comptime_expect_error(typeid(i32), "typeid");
});
