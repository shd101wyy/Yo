# plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.7 (B10), then §4.9.
#
# ORIGINALLY: the artifact input stamp walked a directory only when its name had
# NO dot — a heuristic meaning "this is probably a file". Every source under a
# directory with a dot in its name (`my.pkg/`, `v1.2/`) was invisible to the
# stamp, so editing those sources left the artifact "cached" and the build
# silently did nothing. This case added a `.yo` file under `my.pkg/` between two
# builds and asserted the second build RECOMPILED.
#
# SINCE §4.9 the expectation is inverted, and deliberately so: the stamp hashes
# the files the previous compile actually opened, not a directory walk, and
# `yo init my.pkg/added` creates a subtree that NOTHING in this project imports.
# A cache hit is the correct answer, and it is what the golden now records.
#
# The dotted-directory fix is still load-bearing — `_cache_collect_yo_files` is
# the first-build fallback, and a build whose depfile is missing falls back to it
# too — but it can no longer produce a STALE cache, because the walk's stamp is
# only ever compared, never recorded (the recorded one comes from the depfile the
# child just wrote). What this case proves today is that a dotted directory does
# not break the depfile path either; `build-depfile-scoped-stamp` is the same
# assertion without the dot.
timeout=900
stdout_keep=^(Building |  \(cached|Created|Error|error:)
