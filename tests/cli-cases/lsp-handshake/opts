# Slice-1 gate (plans/archive/P4_LSP.md): a scripted client completes the initialize
# handshake, opens a BROKEN document (diagnostic published at the right
# range), fixes it via full-sync didChange (diagnostics clear), probes an
# unknown request (MethodNotFound), closes (diagnostics cleared), and shuts
# down cleanly. stdin carries the framed JSON-RPC bytes (the harness pipes a
# case's `stdin` file); the doc lives at a virtual uri so the golden is
# machine-independent. The timeout covers the prelude evaluation the first
# analysis pays.
timeout=240
