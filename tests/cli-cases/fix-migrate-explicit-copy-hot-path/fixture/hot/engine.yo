//! A file under the hot path: its copy is listed for a hand edit.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
remember :: (fn(names : &ArrayList(String)) -> usize)({
  first := String.from("x");
  kept := first;
  out := ArrayList(String).new();
  out.push(kept);
  first.len() + out.len() + names.len()
});
export(remember);
