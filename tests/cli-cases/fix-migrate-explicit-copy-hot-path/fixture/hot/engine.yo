//! A file under the hot path: its copy is listed for a hand edit.
{ BTreeMap } :: import("std/collections/btree_map");
remember :: (fn(names : &BTreeMap(i32, BTreeMap(i32, i32))) -> usize)({
  first := BTreeMap(i32, i32).new();
  kept := first;
  out := BTreeMap(i32, BTreeMap(i32, i32)).new();
  out.insert(i32(0), kept);
  first.len() + out.len() + names.len()
});
export(remember);
