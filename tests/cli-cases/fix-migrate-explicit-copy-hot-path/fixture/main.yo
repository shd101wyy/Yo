//! `yo fix --migrate explicit-copy --hot-path hot`: the copy in `main.yo` is
//! rewritten, the one in `hot/engine.yo` is listed for a hand edit. The copies
//! are of a `BTreeMap` (still a `ref`; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
{ remember } :: import("./hot/engine.yo");
main :: (fn() -> unit)({
  a := BTreeMap(i32, i32).new();
  b := a;
  names := BTreeMap(i32, BTreeMap(i32, i32)).new();
  names.insert(i32(0), b);
  println(`${a.len().to_string()} ${remember(&names).to_string()}`);
});
export(main);
