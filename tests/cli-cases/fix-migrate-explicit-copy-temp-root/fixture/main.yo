//! `yo fix --migrate explicit-copy` roots a copied place in a call's owned
//! result, not in the function binding the call names. `first_tag` returns
//! an element of a temporary that dies after the copy: listed as usually a
//! move. The scrutinee `grab(&s).*.maybe` reads an `Rc` pointee that outlives
//! the handle, a genuine copy of an owned place: it gets `.clone()`. The
//! copied values are `BTreeMap`s (still a `ref`, so a copy dups the handle;
//! decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
Holder :: struct(name : BTreeMap(i32, i32), tags : BTreeMap(i32, BTreeMap(i32, i32)), maybe : Option(BTreeMap(i32, i32)));
make :: (fn() -> Holder)({
  tags := BTreeMap(i32, BTreeMap(i32, i32)).new();
  tags.insert(i32(0), BTreeMap(i32, i32).new());
  Holder(name : BTreeMap(i32, i32).new(), tags : tags, maybe : .Some(BTreeMap(i32, i32).new()))
});
first_tag :: (fn() -> BTreeMap(i32, i32))(make().tags(i32(0)));
Shelf :: struct(h : Rc(Holder));
grab :: (fn(s : &Shelf) -> Rc(Holder))(Rc.clone(s.h));
main :: (fn() -> unit)({
  s := Shelf(h : Rc.new(make()));
  b := match(grab(&s).*.maybe, .Some(z) => z, .None => BTreeMap(i32, i32).new());
  println(`${first_tag().len().to_string()} ${b.len().to_string()} ${s.h.*.name.len().to_string()}`);
});
export(main);
