{ ArrayList } :: import("std/collections/array_list");
{ yield } :: import("std/async");
Holder :: ref(struct(items : ArrayList(i32)));
main :: (fn(io : Io) -> unit)({
  h := Holder(items : ArrayList(i32).new());
  h.items.push(i32(1));
  t := io.async((e : Io) => {
    for(&mut h.items, x => {
      x.* = (x.* + i32(1));
      e.await(yield(e), e);
    });
  });
  io.await(t, io);
});
export(main);
