{ ArrayList } :: import("std/collections/array-list");
{ yield } :: import("std/async");
HolderInner :: struct(items : ArrayList(i32));
Holder :: Rc(HolderInner);
main :: (fn(io : Io) -> unit)({
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(1));
  h := Rc.new(HolderInner(items : xs));
  t := io.async((e : Io) => {
    for(&h.*.items, x => {
      _ := x.*;
      e.await(yield(e), e);
    });
  });
  io.await(t, io);
});
export(main);
