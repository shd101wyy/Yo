# `yo fix --migrate deref` inserts `.*` where a reference reaches a by-value
# parameter (`take_i(r.*)`), except where the referent is not implicitly
# copyable: `take_len(r.*)` would be E0901, so that site is listed and left as
# written, and `check` reports E0926 with the two repairs
# (issues/fixed/2026-11-05-migrate-deref-copies-a-move-only-referent-into-a-by-value-parameter.md).
stdout_keep=^(fix:|error|help)
timeout=240
