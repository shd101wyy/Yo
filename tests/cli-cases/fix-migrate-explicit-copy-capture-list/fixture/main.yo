//! `yo fix --migrate explicit-copy` at a closure capture list: the shorthand
//! entry `s` names the capture and its source together, so its copy becomes
//! `s : s.clone()` (a bare `{ s.clone() }` does not parse). The entry `seen`
//! is written in the closure body (`seen.insert`) and read by the caller after
//! the call, so the two share a map on purpose: listed, not cloned. Both are
//! `BTreeMap`s (still a `ref`; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  s := BTreeMap(i32, i32).new();
  s.insert(i32(4), i32(4));
  (f : Impl(Fn() -> usize)) = ({ s }() => s.len());
  seen := BTreeMap(i32, i32).new();
  (g : Impl(Fn() -> unit)) = ({ seen }() => {
    seen.insert(i32(1), i32(1));
  });
  g();
  println(`${f()} ${s.len()} ${seen.len()}`);
});
export(main);
