# `yo fix` applies E0917's one mechanical repair (VERDICTS-20 §5): a local
# written after its definition gets `mut(...)` around its declared name. The
# expected_tree pins the rewritten file, so the case fails if `fix` reports
# success without editing, or wraps the wrong token (the write, not the
# declaration). rc is 0 because the rewritten file then evaluates.
stdout_keep=^fix:
timeout=180
