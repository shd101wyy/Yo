open(import("std/libc/stdio"));
open(import("std/string"));
open(import("std/fmt"));

is_cached :: (fn(v : String, io : Io, extra : i32) -> Impl(Future(bool, Io)))(
  io.async((io : Io) => Option(bool).Some(true))
);

do_call :: (fn(v : String, io : Io) -> Impl(Future(bool, Io)))(
  io.async((io : Io) => {
    // WRONG ARITY: two args for the three-param is_cached. This exact shape
    // (an async helper called with a missing parameter from another async
    // body) shipped broken `yo version install` in v0.2.19/v0.2.20 — check
    // stayed green and the state machine emitted a too-few-arguments C call.
    cached := io.await(is_cached(v, io), io);
    cached
  })
);

main :: (fn() -> unit)({
  r := io.await(do_call(String.from("v"), io), io);
  println(r.to_string());
});
export(main);
