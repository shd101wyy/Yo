# `--error-format sarif` renders the diagnostic group as one SARIF 2.1.0 log
# on stdout — codes as driver rules, 1-based positions per the SARIF spec,
# and the mechanical repair as a `fixes` entry (the field GitHub code
# scanning ingests). The substring pin says the stdout channel carries the
# SARIF log itself, in the machine format, like the json sibling case.
stdout_keep_match="version":"2.1.0"
timeout=180
