//! A pattern binding holds a part of the scrutinee's variable and shares its
//! map, so a write through the binding is a write of that variable. Each copy
//! below shares its map with one inserted into through such a binding (a
//! `match` by value, a `&mut` match, a record pattern, a `:=`
//! destructuring), so all four are listed. `read_only`'s binding is only
//! read, and its copy is cloned. The maps are `BTreeMap`s (still a `ref`, so
//! a copy dups the handle; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
VEntry :: struct(yes : BTreeMap(i32, i32), opt : Option(BTreeMap(i32, i32)));
by_value :: (fn(entry : &VEntry) -> usize)({
  x := entry.opt;
  match(
    entry.opt,
    .Some(v) => {
      v.insert(i32(1), i32(1));
    },
    .None => ()
  );
  match(x, .Some(v) => v.len(), .None => usize(99))
});
by_mut :: (fn(entry : &mut VEntry) -> usize)({
  x := entry.opt;
  match(
    &mut entry.opt,
    .Some(v) => {
      v.insert(i32(1), i32(1));
    },
    .None => ()
  );
  match(x, .Some(v) => v.len(), .None => usize(99))
});
record_pattern :: (fn(entry : &mut VEntry) -> usize)({
  x := entry.yes;
  match(&mut entry, { yes } => {
    yes.insert(i32(1), i32(1));
  });
  x.len()
});
destructured :: (fn(entry : &VEntry) -> usize)({
  x := entry.yes;
  { yes } := entry;
  yes.insert(i32(1), i32(1));
  x.len()
});
read_only :: (fn(entry : &VEntry) -> usize)({
  x := entry.opt;
  n := match(entry.opt, .Some(v) => v.len(), .None => usize(0));
  n + match(x, .Some(v) => v.len(), .None => usize(99))
});
main :: (fn() -> unit)(());
export(main);
