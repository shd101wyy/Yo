# The class-D trait names a model writes by their Rust spelling (`Not`,
# `PartialEq`, `PartialOrd`) name the prelude's trait in the help; the prelude
# binds it, so there is no import to add. `Not` is two operators in Yo: the help
# names `LogicalNot` for `!` and `BitNot` for `~`.
stdout_keep_match=error(\[E[0-9]+\])?: .*|--> main\.yo:[0-9]+:[0-9]+|help: (did you mean|`).*
timeout=120
