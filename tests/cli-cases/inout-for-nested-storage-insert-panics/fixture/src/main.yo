{ OrderedMap } :: import("std/collections/ordered_map");
{ assert } :: import("std/assert");
{ String } :: import("std/string");
main :: (fn() -> unit)({
  mut(scores) := OrderedMap(String, i32).new();
  scores.insert(String.from("a"), i32(1));
  scores.insert(String.from("b"), i32(2));
  mut(other) := scores; // since B10 a MOVE: the map is a value, so no second handle exists
  for(&mut scores, (k, v) => {
    other.insert(String.from("c"), i32(3)); // panics: mutates the inner map while `v` borrows an entry
    v = (v + i32(1));
  });
  assert(false, "unreachable: insert must panic first");
});
export(main);
