# An `Allocator` value is a plain copyable struct, so a copy can outlive its
# arena. Allocating through such a stale copy PANICS rather than touching the
# released region (plans/EXPLICIT_ALLOCATORS.md §3.6): a dead arena's state is
# recycled, never freed, and carries a `dead` flag the allocator checks. The
# fixture calls `Allocator.alloc` directly, which returns a raw pointer, hence
# its AllowUnsafe.
stdout_keep_match=Arena: allocation from an arena after deinit
timeout=600
