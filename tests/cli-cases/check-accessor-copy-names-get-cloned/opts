# A re-anchored E0901 at a method call whose receiver type has an `<name>_cloned`
# sibling in the impl registry carries decision 20's guidance in its help
# (B6-b): the in-place read `raw(i)`, the copy `raw.get_cloned(...)` and the
# write-through `raw.with(i, ...)` — the names come from the registry, not a
# compiler list, so they follow what the receiver's impls actually provide.
stdout_keep_match=error\[E0901\]: .*|--> main\.yo:[0-9]+:[0-9]+|help: .*|note: .*
timeout=120
