# `build.manifest()` is the `[package]` table of the build file being
# evaluated. A dependency's build.yo is evaluated after the project's, against
# the same std/build.yo evaluation, so a module-level manifest VALUE would name
# the dependency's library "app" (the project's name) and
# `dep.artifact("mathlib")` would find nothing. The program's own output (36)
# is the assertion; clang chatter carries machine-specific paths.
timeout=600
stdout_keep=^(Building|36$|Error|error:)
