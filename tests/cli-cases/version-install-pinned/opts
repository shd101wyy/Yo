# Full version-cache cycle against the REAL GitHub Releases channel (P3
# item 2): install a pinned old version (0.2.1 — the first release with
# native bundles for every platform; MIN_BUNDLE_VERSION, so it stays valid),
# list it, clean it. Network-gated: the harness SKIPs this unless --network
# is passed. stdout is matched on the stable substring rather than the full
# transcript — the install line embeds the host bundle name, which differs
# per platform.
network=1
stdout_keep_match=0\.2\.1
timeout=600
