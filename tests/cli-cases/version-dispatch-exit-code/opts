# A project pinning another version (`.yo-version` = 0.0.1) re-dispatches to
# that version's cached binary; the stub there exits 3, and the dispatcher must
# exit 3 too. Before the fix it exited with the raw wait status (3 << 8), whose
# low 8 bits are 0, so every failing dispatched command reported success
# (issues/fixed/2026-10-16-a-yo-version-dispatched-command-exits-0-when-it-fails.md).
env=YO_CACHE_DIR=<PROJ>/cache
timeout=120
