# `Arena.deinit` with a live block PANICS instead of releasing the region under
# it (plans/archive/EXPLICIT_ALLOCATORS.md §3.6): the Zig bug class "use after arena
# deinit" is a loud, defined failure here. The block is a raw allocation from
# the arena's `Allocator` (a raw pointer, hence the fixture's AllowUnsafe).
# `build run` propagates the panic as a non-zero rc; the message rides stderr
# with build chatter, so stdout keeps only the diagnostic substring.
stdout_keep_match=Arena.deinit: 1 block\(s\) still live
timeout=600
