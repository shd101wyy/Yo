pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array-list");
Name :: str;
Person :: struct(name : str, nick : Name);
greet :: (fn(who : str) -> str)(who);
take :: (fn(sink(s) : str) -> usize)(s.len());
view :: (fn(s : &str) -> usize)(s.len());
impl(str, twice_len : (fn(self : &Self) -> usize)(self.len() + self.len()));
hold :: (fn(generic(T : Type), x : T) -> ArrayList(T))({
  mut(xs) := ArrayList(T).new();
  xs.push(x);
  xs
});
main :: (fn() -> unit)({
  (s : str) = greet("hi");
  p := Person(name : s, nick : "n");
  names := ArrayList(str).new();
  (pair : Array(str, 2)) = Array(str, 2)("a", "b");
  _ := (take(p.name), view(p.nick), names.len(), pair.len(), hold("x").len(), "ab".twice_len());
});
export(main);
