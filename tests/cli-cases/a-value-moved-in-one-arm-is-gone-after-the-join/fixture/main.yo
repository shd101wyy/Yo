{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
take_list :: (fn(sink(xs) : ArrayList(i32)) -> unit)(());
main :: (fn() -> unit)({
  xs := ArrayList(i32).new();
  c := runtime(true);
  // Moved in one arm, so the other arm drops it where the arms meet.
  if(c, {
    take_list(xs);
  }, {
    println(`else ${xs.len()}`);
  });
  println(`after ${xs.len()}`);
});
export(main);
