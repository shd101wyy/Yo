# E0007 with ONE expression between the braces (`{ f(x) }` — the shape an
# agent writes for a single-statement body) carries the unique repair: a `;`
# before the `}`. Two or more comma-separated items could be a block OR a
# record with a bad field, so those get the message alone (see
# check-struct-literal-vs-block). The expected_tree pins the rewritten file;
# rc=0 because the repaired file then evaluates.
stdout_keep=^fix:
timeout=180
