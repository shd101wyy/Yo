# An `Exception(throw : (err) -> {...})` handler is a `->` function: handlers are
# capture-free by design (docs/en-US/ALGEBRAIC_EFFECTS.md rule 4), so one that
# writes a captured runtime local must be REJECTED WITH THAT REASON. The
# struct-member evaluation used to swallow the anonymous-function evaluator's
# precise diagnostic and report only "Failed to evaluate argument expression"
# (issues/fixed/exception-handler-closure-with-box-capture-fails-inference.md).
stdout_keep_match=cannot capture outer runtime variables: thrown
timeout=120
