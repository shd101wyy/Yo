# `yo fix <path> --migrate deref` over a `cond(arch == …)` (decision 43 step 2
# N1e-1): the file is evaluated for every other (architecture, OS) pair as
# well, so the arms that are dead on the host are migrated too. The
# expected_tree pins main.yo with `.*` in all three arms.
stdout_keep=^fix:
timeout=600
