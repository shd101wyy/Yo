//! Four identical stores of a `&` collection parameter into a field; only the
//! value type differs. The collection is a `BTreeMap` (still a `ref`, so a
//! copy dups the handle; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
//! `F` and `E` have no `Clone`, so `BTreeMap(i32, F)` and `BTreeMap(i32, E)`
//! have none either: their copies used to be dropped from the listing.
//! `set_a` and `set_d` are cloned; `set_b` and `set_c` are listed.
{ BTreeMap } :: import("std/collections/btree_map");
E :: struct(name : BTreeMap(i32, i32), depth : u32);
F :: struct(depth : u32);
Prog :: ref(struct(a : BTreeMap(i32, u32), b : BTreeMap(i32, F), c : BTreeMap(i32, E), d : BTreeMap(i32, BTreeMap(i32, i32))));
set_a :: (fn(prog : &Prog, xs : &BTreeMap(i32, u32)) -> unit)({
  prog.a = xs;
});
set_b :: (fn(prog : &Prog, xs : &BTreeMap(i32, F)) -> unit)({
  prog.b = xs;
});
set_c :: (fn(prog : &Prog, xs : &BTreeMap(i32, E)) -> unit)({
  prog.c = xs;
});
set_d :: (fn(prog : &Prog, xs : &BTreeMap(i32, BTreeMap(i32, i32))) -> unit)({
  prog.d = xs;
});
main :: (fn() -> unit)({
  prog := Prog(a : BTreeMap(i32, u32).new(), b : BTreeMap(i32, F).new(), c : BTreeMap(i32, E).new(), d : BTreeMap(i32, BTreeMap(i32, i32)).new());
  a := BTreeMap(i32, u32).new();
  b := BTreeMap(i32, F).new();
  c := BTreeMap(i32, E).new();
  d := BTreeMap(i32, BTreeMap(i32, i32)).new();
  set_a(&prog, &a);
  set_b(&prog, &b);
  set_c(&prog, &c);
  set_d(&prog, &d);
  a.insert(i32(1), u32(1));
});
export(main);
