# Under `--allocator fixed --debug-heap` the exit report lists every arena that
# was never deinit and every abandoned one (plans/EXPLICIT_ALLOCATORS.md P4); a
# deinit arena is not listed. The test binary's stderr rides the runner's `-v`
# output with its build chatter, so stdout keeps only the report lines.
stdout_keep_match=arena \((never deinit|abandoned)\): live at exit: [0-9]+ block\(s\), [0-9]+ of [0-9]+ bytes in use
timeout=600
