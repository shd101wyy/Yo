//! Box lends where a `&Dyn` is taken: `yo fix --migrate unsized` writes
//! `&b` as `&b.*`.
{ println } :: import("std/fmt");
Speak :: trait(speak : (fn(self : &Self) -> i32), bump : (fn(self : &mut Self) -> unit));
Cat :: struct(n : i32);
impl(Cat, Speak(speak : ((self : &Self) -> self.n), bump : ((self : &mut Self) -> { self.n = (self.n + i32(1)); })));
Holder :: struct(b : Box(Dyn(Speak)));
read :: (fn(d : &Dyn(Speak)) -> i32)(d.speak());
bump :: (fn(d : &mut Dyn(Speak)) -> unit)(d.bump());
first :: (fn(h : &Holder) -> Option(&Dyn(Speak)))(.Some(&h.b));
main :: (fn() -> unit)({
  (d : Box(Dyn(Speak))) = dyn(Box.new(Cat(n : i32(3))));
  bump(&mut d);
  h := Holder(b : d);
  total := (read(&h.b) + match(first(&h), .Some(s) => s.speak(), .None => i32(0)));
  println(&total);
});
export(main);
