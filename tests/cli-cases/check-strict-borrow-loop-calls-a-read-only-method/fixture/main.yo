pragma(Pragma.StrictBorrow);
// A user collection implements `impl(&mut C, IntoIterator)` with a raw pointer
// into its list (R-FOR), so the file is unsafe-capable.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
Bag :: ref(struct(items : ArrayList(i32)));
BagCursorMut :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(bag : &mut(Bag, p), i : usize));
impl(
  generic(p : Origin),
  BagCursorMut(p),
  Iterator(
    Item : &mut(i32, p),
    next : (fn(self : &mut Self) -> Option(&mut(i32, p)))(
      cond(
        (self.i >= self.bag.items.len()) => .None,
        true => {
          at := self.i;
          self.i = (at + usize(1));
          .Some(&mut self.bag.items.ptr().unwrap().add(at).*)
        }
      )
    )
  )
);
impl(
  generic(p : Origin),
  &mut(Bag, p),
  IntoIterator(
    Item : &mut(i32, p),
    IntoIter : BagCursorMut(p),
    into_iter : (fn(self : Self) -> BagCursorMut(p))(BagCursorMut(p)(bag : self, i : usize(0)))
  )
);
impl(
  Bag,
  total : (fn(self : &Self) -> i32)({
    mut(t) := i32(0);
    for(&self.items, x => {
      t = (t + x.*);
    });
    t
  })
);
main :: (fn() -> unit)({
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(1));
  mut(bag) := Bag(items : xs);
  other := bag; // the body cannot name `bag` (E0911); the call goes through an alias
  (mut(seen) : i32) = i32(0);
  for(&mut bag, x => {
    seen = (seen + other.total());
  });
  println(&seen);
});
export(main);
