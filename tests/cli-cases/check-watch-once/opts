# Phase C gate (plans/reference/INCREMENTAL_COMPILATION.md, src/check_watch.yo):
# `--watch-once` reads changed paths from stdin, runs ONE incremental round
# (invalidate reverse closure -> selective recheck) and exits with the
# round's failure count. The summary line carries a wall-clock ms figure, so
# the golden keeps only the deterministic lines.
stdout_keep=^(check: |watch: .*(OK|FAILED))
timeout=240
