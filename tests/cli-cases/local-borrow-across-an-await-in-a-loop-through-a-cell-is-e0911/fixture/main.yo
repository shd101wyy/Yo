{ Stream } :: import("std/async/stream");
Countdown :: struct(_n : i32);
impl(
  Countdown,
  Stream(
    Item : i32,
    next : (fn(self : &mut Self, io : Io) -> Impl(Future(Option(i32), Io)))(
      io.async({ self : &mut self.* }(io : Io) =>
        cond(
          (self._n <= i32(0)) => Option(i32).None,
          true => {
            v := self._n;
            self._n = (self._n - i32(1));
            Option(i32).Some(v)
          }
        ))
    )
  )
);
HolderInner :: struct(o : Option(i32));
Holder :: Rc(HolderInner);
main :: (fn(io : Io) -> unit)({
  h := Rc.new(HolderInner(o : Option(i32).Some(i32(1))));
  t := io.async((e : Io) => {
    cur := &h.*.o;
    mut(s) := Countdown(_n : i32(3));
    while(true, {
      n := e.await(s.next(e), e);
      match(
        n,
        .Some(_) => (),
        .None => {
          break;
        }
      );
    });
    _v := cur.*;
  });
  io.await(t, io);
});
export(main);
