//! A raw pointer derived from one parameter (`first_ptr`'s `xs`) used to list
//! a copy out of another (`plain`'s `entry`) as "a raw pointer into its
//! source is taken". The maps are `BTreeMap`s (still a `ref`; decision
//! Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
//! `x := entry.yes` is cloned.
pragma(Pragma.AllowUnsafe);
{ BTreeMap, MapEntry } :: import("std/collections/btree_map");
VEntry :: struct(yes : BTreeMap(i32, i32), no : BTreeMap(i32, i32));
plain :: (fn(entry : VEntry) -> usize)({
  x := entry.yes;
  x.len()
});
first_ptr :: (fn(xs : &BTreeMap(i32, i32)) -> *MapEntry(i32, i32))(xs.iter().next().unwrap());
main :: (fn() -> unit)(());
export(main);
