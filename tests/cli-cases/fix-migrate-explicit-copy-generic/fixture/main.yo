//! `yo fix --migrate explicit-copy` leaves a copy inside a generic body alone:
//! `twice` is instantiated at `BTreeMap(i32, i32)` and at a `ref` struct
//! without `Clone`, and `Bag.snapshot` is never called (only its
//! definition-time trial copies). `BTreeMap` stands in for a collection that
//! still dups (still a `ref`; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
Node :: ref(struct(id : i32));
Bag :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(items : BTreeMap(i32, T), n : i32)
);
impl(
  generic(T : Type),
  Bag(T),
  snapshot : (fn(self : &Self) -> Bag(T))(Bag(T)(items : self.items, n : self.n))
);
twice :: (fn(comptime(T) : Type, x : &T) -> BTreeMap(i32, T))({
  out := BTreeMap(i32, T).new();
  out.insert(i32(0), x);
  out.insert(i32(1), x);
  out
});
main :: (fn() -> unit)({
  s := BTreeMap(i32, i32).new();
  xs := twice(BTreeMap(i32, i32), &s);
  n := Node(id : i32(1));
  ns := twice(Node, &n);
  println(`${xs.len().to_string()} ${ns.len().to_string()} ${s.len().to_string()}`);
});
export(main);
