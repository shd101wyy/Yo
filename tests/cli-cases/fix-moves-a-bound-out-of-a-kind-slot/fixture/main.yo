Probe :: trait(probe : (fn(self : &Self) -> i32));
P :: struct(n : i32);
impl(P, Probe(probe : (fn(self : &Self) -> i32)(self.n)));
total :: (fn(generic(T : Probe), x : &T) -> i32)(x.probe());
twice :: (fn(generic(T : Probe), x : &T, where(T <: Clone)) -> i32)(x.probe() * i32(2));
Src :: trait(Item : Clone, next_item : (fn(self : &mut Self) -> Option(Self.Item)));
main :: (fn() -> unit)({
  p := P(n : i32(1));
  _a := total(&p);
});
export(main);
