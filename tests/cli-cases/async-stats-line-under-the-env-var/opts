# The test binary's stderr rides the runner's `-v` output with its build
# chatter, so stdout keeps only the stats line: its keys and order are what
# this case pins, and the counts are the baseline every stage of the
# allocation-free async plan re-records (a stage that removes a cell changes a
# number here, on purpose).
env=YO_ASYNC_STATS=1
stdout_keep_match=yo: async-stats .*
timeout=600
