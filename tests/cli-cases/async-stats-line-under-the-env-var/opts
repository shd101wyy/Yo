# The binary is built with -DYO_ASYNC_STATS (add_c_flags in the fixture's
# build.yo) and run with YO_ASYNC_STATS=1; its stderr line rides the build's
# output, so stdout keeps only that line. Its keys and order are what this case
# pins, and the counts are the baseline every stage of the allocation-free
# async plan re-records (a stage that removes a cell changes a number here, on
# purpose).
env=YO_ASYNC_STATS=1
stdout_keep_match=yo: async-stats .*
timeout=600
