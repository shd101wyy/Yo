# plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.7 (B6): a node whose
# dependency FAILED used to run anyway — the `run` step executed a program that
# had just failed to compile, turning one clear compile error into a second,
# confusing one. The run must be skipped, saying so, and the build must exit
# non-zero. The compiler's own diagnostic carries machine-specific paths, so
# only the runner's own lines are compared.
timeout=600
stdout_keep=^(Skipping |Compilation error|Build Summary|Error)
