// A user collection walked with a borrowed `for` (plans/VALUES_BY_DEFAULT.md
// decision 39).
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
Bag :: ref(struct(items : ArrayList(i32)));
impl(
  Bag,
  rebuild : (fn(self : &Self) -> unit)({
    mut(fresh) := ArrayList(i32).new();
    fresh.push(i32(1)); // fresh storage: mutating it is not a mutation of the bag
    self.items = fresh; // now reachable from self
    fresh.push(i32(2)); // mutates the bag's storage
  })
);
main :: (fn() -> unit)({
  bag := Bag(items : ArrayList(i32).new());
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  other := bag; // a second handle: the loop's static borrow cannot see it
  for(&mut bag, x => {
    other.rebuild(); // panics: the method stores fresh storage into self and mutates it
    x.* = i32(9);
  });
  assert(false, "unreachable: rebuild must panic first");
});
export(main);
