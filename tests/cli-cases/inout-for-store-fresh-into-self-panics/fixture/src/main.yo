// A user collection implements `BorrowedWalk` with a raw pointer into its
// list (plans/VALUES_BY_DEFAULT.md decision 39), so the file is unsafe-capable.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
Bag :: ref(struct(items : ArrayList(i32)));
impl(
  Bag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)(self.items.ptr().unwrap().add(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
impl(
  Bag,
  rebuild : (fn(self : &Self) -> unit)({
    fresh := ArrayList(i32).new();
    fresh.push(i32(1)); // fresh storage: mutating it is not a mutation of the bag
    self.items = fresh; // now reachable from self
    fresh.push(i32(2)); // mutates the bag's storage
  })
);
main :: (fn() -> unit)({
  bag := Bag(items : ArrayList(i32).new());
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  other := bag; // a second handle: the loop's static borrow cannot see it
  for(&mut bag, x => {
    other.rebuild(); // panics: the method stores fresh storage into self and mutates it
    x = i32(9);
  });
  assert(false, "unreachable: rebuild must panic first");
});
export(main);
