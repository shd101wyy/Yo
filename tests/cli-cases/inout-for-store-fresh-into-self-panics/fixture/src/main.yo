{ ArrayList, ArrayListIterPtr } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
Bag :: ref(struct(items : ArrayList(i32)));
impl(
  Bag,
  iter : (fn(imm(self) : Self) -> ArrayListIterPtr(i32))(self.items.iter()),
  rebuild : (fn(imm(self) : Self) -> unit)({
    fresh := ArrayList(i32).new();
    fresh.push(i32(1)); // fresh storage: mutating it is not a mutation of the bag
    self.items = fresh; // now reachable from self
    fresh.push(i32(2)); // mutates the bag's storage
  })
);
main :: (fn() -> unit)({
  bag := Bag(items : ArrayList(i32).new());
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  for(bag, mut(x) => {
    bag.rebuild(); // panics: the method stores fresh storage into self and mutates it
    x = i32(9);
  });
  assert(false, "unreachable: rebuild must panic first");
});
export(main);
