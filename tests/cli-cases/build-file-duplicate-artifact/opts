# A parse-clean build.yo whose EVALUATION throws — two artifacts named "app" —
# must fail the build with the registry's own diagnostic. That diagnostic
# (`_check_duplicate_artifact_name`, src/evaluator/builtins/build.yo) existed
# and was never shown while build-file errors were swallowed
# (issues/fixed/build-yo-evaluation-errors-are-swallowed.md).
stdout_keep_match=(Artifact "app" already registered as executable|Error: Failed to evaluate build file .*build\.yo)
