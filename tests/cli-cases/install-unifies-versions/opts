# VERSION UNIFICATION: the root wants util "*" (alone that is v2.0.0) and
# app_lib wants util "^1". One import name is one package at one version, so
# the resolver must pick the highest tag inside BOTH ranges — v1.1.0 — and
# both the root's and app_lib's import("util") must see that one tree.
timeout=600
stdout_keep=^(Found|  - |  [a-z_]+ →|Resolving|Done|Building|app_lib |root sees|Wrote|yo\.lock is up)
