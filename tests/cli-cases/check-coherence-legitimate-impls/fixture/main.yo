{ println, ToString, Format } :: import("std/fmt");
{ String } :: import("std/string");
{ Show, A } :: import("./a.yo");
{ B } :: import("./b.yo");
Loud :: trait();
Named :: trait(name : (fn(self : Self) -> i32));
impl(bool, Loud());
impl(i32, Named(name : (self -> i32(1))));
impl(generic(T : Type), where(T <: Loud), T, Named(name : (self -> i32(2))));
Wrap :: (fn(comptime(T) : Type) -> comptime(Type))(struct(inner : T));
impl(generic(T : Type), Wrap(T), Show(show : (self -> i32(9))));
Point :: struct(x : i32, y : i32);
impl(Point, ToString(to_string : (self -> `(${self.x}, ${self.y})`)));
impl(Point, Format());
Quiet :: trait();
impl(i64, Quiet());
impl(generic(T : Type), where(T <: Loud), T, level : (fn(self : Self) -> i32)(i32(10)));
impl(generic(T : Type), where(T <: Quiet), T, level : (fn(self : Self) -> i32)(i32(20)));
main :: (fn() -> unit)({
  println(A(v : i32(3)).show());
  println(B(w : i32(4)).show());
  println(i32(0).name());
  println(true.name());
  println(Wrap(i32)(inner : i32(1)).show());
  println(Wrap(bool)(inner : false).show());
  println(true.level());
  println(i64(0).level());
  println(`[${Point(x : i32(1), y : i32(2)):>8}]`);
});
export(main);
