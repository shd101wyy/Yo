# Safe mode (plans/SAFE_MODE.md §14 R6 run 5): reading a union member in a
# SAFE file is a compile error. The union does not record which member was
# written, so `v.y` reinterprets the i32 12 as a bool: undefined behavior
# (issues/fixed/safe-code-can-read-an-inactive-union-member.md). Writing a
# member stays legal. Before the gate: rc 0. Recorded by hand.
stdout_keep_match=requires .pragma\(Pragma.AllowUnsafe\);. in this file
timeout=300
