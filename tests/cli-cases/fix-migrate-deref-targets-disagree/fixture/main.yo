{ println } :: import("std/fmt");
{ arch, Arch } :: import("std/process");
by_ref :: (fn(x : &i64) -> i64)(x.*);
by_val :: (fn(x : i64) -> i64)(x);
// A reference parameter on one target, a by-value one on another.
pick :: cond((arch == Arch.Aarch64) => by_val, true => by_ref);
// `pick(n)` lends `n` on one target and reads it whole on the other. No one
// spelling fits both targets, so the migration leaves it as written.
twice :: (fn(n : &i64) -> i64)(pick(n) + pick(n));
main :: (fn() -> unit)({
  x := i64(2);
  println(twice(&x));
});
export(main);
