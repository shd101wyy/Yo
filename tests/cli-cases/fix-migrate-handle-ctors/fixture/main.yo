//! `yo fix --migrate handle-ctors`: `rc(x)` → `Rc.new(x)`, `box(x)` →
//! `Box.new(x)`, `arc(x)` → `Arc.new(x)`.
{ String } :: import("std/string");
run :: (fn(d : Dyn(Fn(x : i32) -> i32)) -> i32)(d(i32(1)));
call_param :: (fn(rc : Impl(Fn(x : i32) -> i32)) -> i32)(rc(i32(2)));
wrap :: (fn(generic(T : Type), x : T) -> Rc(T))(rc(x));
empty :: (fn(comptime(T) : Type) -> Rc(Option(T)))(rc(.None));
main :: (fn() -> unit)({
  a := rc(i32(1));
  b := box(String.from("b"));
  c := arc(i32(3));
  d := rc(i32(4), alloc : .None);
  (o : Rc(Option(i32))) = rc(.None);
  (u : Rc(u8)) = rc(7);
  n := i32(5);
  e := run(dyn(rc(x => (x + n))));
  f := call_param(x => (x * n));
  w := wrap(i32(6));
  v := wrap(String.from("v"));
  m := empty(i32);
  k := empty(bool);
  nested := rc(rc(i32(8)));
});
export(main);
