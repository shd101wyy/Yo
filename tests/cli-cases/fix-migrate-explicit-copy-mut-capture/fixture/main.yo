//! A `&mut` capture-list entry is a second name for the captured variable's
//! place: a write through it in the closure body is a write of that
//! variable. Each copy below shares its map with one a closure inserts into
//! through such a capture, so all four are listed; `read_only`'s closure
//! only reads through a `&` capture, so its copy is cloned. The maps are
//! `BTreeMap`s (still a `ref`, so a copy dups the handle; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
VEntry :: struct(yes : BTreeMap(i32, i32), no : BTreeMap(i32, i32));
local_capture :: (fn() -> usize)({
  mut(entry) := VEntry(yes : BTreeMap(i32, i32).new(), no : BTreeMap(i32, i32).new());
  x := entry.yes;
  (bump : Impl(Fn() -> unit)) = ({ &mut entry }() => {
    entry.yes.insert(i32(1), i32(1));
  });
  bump();
  x.len()
});
param_capture :: (fn(entry : &mut VEntry) -> usize)({
  x := entry.yes;
  (bump : Impl(Fn() -> unit)) = ({ e : &mut entry }() => {
    e.yes.insert(i32(1), i32(1));
  });
  bump();
  x.len()
});
field_capture :: (fn(entry : &mut VEntry) -> usize)({
  x := entry.yes;
  (bump : Impl(Fn() -> unit)) = ({ ys : &mut entry.yes }() => {
    ys.insert(i32(1), i32(1));
  });
  bump();
  x.len()
});
copy_captured :: (fn(entry : &VEntry) -> usize)({
  mut(x) := entry.yes;
  (bump : Impl(Fn() -> unit)) = ({ &mut x }() => {
    x.insert(i32(1), i32(1));
  });
  bump();
  entry.yes.len()
});
read_only :: (fn(entry : &VEntry) -> usize)({
  x := entry.yes;
  (peek : Impl(Fn() -> usize)) = ({ &entry }() => entry.yes.len());
  peek() + x.len()
});
main :: (fn() -> unit)(());
export(main);
