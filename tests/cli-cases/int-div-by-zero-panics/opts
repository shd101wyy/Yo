# Safe mode Phase 2 (plans/backlog/SAFE_MODE.md §5): integer division by
# zero was raw C - UB, SIGFPE with no message. The / and % builtins now emit
# a guard before the division (signed also covers INT_MIN / -1); floats are
# untouched (IEEE total). Recorded by hand: the recording binary must carry
# the guard.
stdout_keep_match=integer division or remainder by zero
timeout=300
