# An unannotated `io.async((e) => …)` with no expected type: the call binds
# `E := Io` in the env, so the body is checked with `e : Io` and its error is
# real. `check` reports the E0610 that `compile` reports, instead of exiting 0
# (issues/fixed/ftt-stub-in-live-closure-falls-off-non-void-function.md).
stdout_keep_match=error\[E0610\].*|--> main\.yo:[0-9]+:[0-9]+
timeout=120
