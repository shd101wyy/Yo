{ println } :: import("std/fmt");
leaf :: (fn(x : i32, io : Io) -> Impl(Future(i32)))(io.async((io2 : Io) => (x + i32(1))));
run :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(
  io.async((io : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(runtime(i < n), {
      acc = (acc + io.await(leaf(i, io), io));
      i = (i + i32(1));
    });
    acc
  })
);
main :: (fn(io : Io) -> unit)({
  v := io.await(run(i32(3), io), io);
  println(`result: ${v}`);
});
export(main);
