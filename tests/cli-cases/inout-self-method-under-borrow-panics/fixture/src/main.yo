// A user collection implements `BorrowedWalk` with a raw pointer into its
// list (plans/VALUES_BY_DEFAULT.md decision 39), so the file is unsafe-capable.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
Bag :: ref(struct(items : ArrayList(i32), version : i32));
impl(
  Bag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)(self.items.ptr().unwrap().add(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
impl(
  Bag,
  bump_version : (fn(self : &mut Self) -> unit)({
    self.version = (self.version + i32(1));
  })
);
main :: (fn() -> unit)({
  bag := Bag(items : ArrayList(i32).new(), version : i32(0));
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  other := bag; // a second handle: the loop's static borrow cannot see it
  for(&mut bag, x => {
    other.bump_version(); // panics: a mutating `&mut self` method while `x` borrows an element
    x = i32(9);
  });
  assert(false, "unreachable: bump_version must panic first");
});
export(main);
