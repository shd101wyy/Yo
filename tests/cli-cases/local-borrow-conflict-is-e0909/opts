# plans/VALUES_BY_DEFAULT.md decision 18: a local borrow freezes its place
# until its last use. `b` (a sibling field) is free; writing `p` while `a`
# is still used is E0909, and the diagnostic names the borrow and its use.
stdout_keep_match=error(\[E[0-9]+\])?: .*|--> main\.yo:[0-9]+:[0-9]+
timeout=120
