# The same fixture as async-await-fusion-verdicts with the F2 lowering on
# (the default): each fusable site reports `fused`, or why it is not lowered
# (a site inside a fused block is nested fusion, F3), then the inner awaits'
# own verdicts. Only main.yo's lines are kept.
env=YO_DEBUG_FUSION=1
stdout_keep_match=^fusion: main\.yo:.*
timeout=120
