# YO_DEBUG_FUSION prints, per await of the single-pass lowering, the verdict
# the evaluator recorded for the awaited call: whether its callee is an
# io.async wrapper whose body can run in the caller's frame
# (plans/backlog/ASYNC_AWAIT_SITE_FUSION.md, F1). One callee per rule. Only
# main.yo's lines are kept; std's own awaits print std paths.
env=YO_DEBUG_FUSION=1
stdout_keep_match=^fusion: main\.yo:.*
timeout=120
