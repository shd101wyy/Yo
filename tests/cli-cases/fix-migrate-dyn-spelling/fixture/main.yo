//! `yo fix --migrate dyn-spelling`: every callable passed bare into a
//! `Dyn(Fn(...))` binding, field, argument or result becomes `dyn(...)`
//! (a named closure, a named `fn`, a `->` function literal);
//! `Impl(Fn(...))` slots and values already spelled `dyn(...)` stay. A
//! generic method's `T` argument (`ArrayList(Dyn(Fn() -> i32)).push`) is a
//! `Dyn(Fn(...))` slot too.
{ ArrayList } :: import("std/collections/array_list");
Hold :: ref(struct(f : Dyn(Fn() -> i32)));
run :: (fn(d : Dyn(Fn() -> i32)) -> i32)(d());
keep :: (fn(f : Impl(Fn() -> i32)) -> i32)(f());
nine :: (fn() -> i32)(i32(9));
make :: (fn() -> Dyn(Fn() -> i32))({
  (g : Impl(Fn() -> i32)) = (() => i32(9));
  g
});
main :: (fn() -> unit)({
  n := i32(3);
  (f1 : Impl(Fn() -> i32)) = (() => n);
  (f2 : Impl(Fn() -> i32)) = (() => n);
  (f3 : Impl(Fn() -> i32)) = (() => n);
  (f4 : Impl(Fn() -> i32)) = (() => n);
  (d : Dyn(Fn() -> i32)) = f1;
  h := Hold(f : f2);
  r := run(f3);
  k := keep(f4);
  e := run(dyn(() => i32(1)));
  (g : Dyn(Fn() -> i32)) = nine;
  (l : Dyn(Fn() -> i32)) = (() -> i32(5));
  fs := ArrayList(Dyn(Fn() -> i32)).new();
  fs.push(nine);
  _s := (d() + h.f() + r + make()() + (k + e) + (g() + l()) + fs(usize(0))());
});
export(main);
