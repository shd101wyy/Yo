# An io.await in this position used to be rejected (E0904) or miscompiled by
# the segment lowering. The single-pass lowering suspends wherever the await
# sits, so the program runs and prints its value
# (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 5).
stdout_keep_match=^result: |^first|^second|^not taken|error|internal compiler error|panic
timeout=300
