# issues/fixed/2026-11-26-yo-check-with-several-file-arguments-checks-only-the-last-and-exits-0.md:
# `yo check` checks EVERY path it is given. bad.yo comes first, so the old
# overwrite of the positional checked only good.yo and exited 0; now bad.yo's
# E0601 is reported, the tally counts both files, and the run exits 1.
stdout_keep_match=error\[E0601\]: Incompatible types|check: [0-9]+/[0-9]+ file\(s\) passed
timeout=180
