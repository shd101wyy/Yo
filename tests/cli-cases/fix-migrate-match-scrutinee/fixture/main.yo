// `yo fix --migrate match-scrutinee` (decision 26): `t` (no `Copy`) is read
// after the first match, so that match becomes `match(&t, …)`; the second is
// its last use and keeps consuming it. `h.tok` is a projection and `g` a
// module-level binding: both become borrows. `n` is `Copy` and stays.
_Tok :: struct(id : i32);
_Holder :: struct(tok : _Tok);
(g : _Tok) = _Tok(id : i32(3));
_id :: (fn(imm(t) : _Tok) -> i32)(t.id);
main :: (fn() -> unit)({
  t := _Tok(id : i32(1));
  a := match(t, _Tok(id : k) => k);
  b := _id(t);
  c := match(t, x => x.id);
  h := _Holder(tok : _Tok(id : i32(2)));
  d := match(h.tok, _Tok(id : k) => k);
  e := match(g, _Tok(id : k) => k);
  n := i32(4);
  f := match(n, 4 => i32(1), _ => i32(0));
  _s := (a + b + c + d + e + f);
});
export(main);
