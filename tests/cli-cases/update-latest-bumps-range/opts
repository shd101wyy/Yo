# `yo update --latest`: the newest release of remote is v2.0.0, outside the
# manifest's "^1". The range in yo.toml must be rewritten IN PLACE to "^2.0.0"
# (the comment above it survives — the tree golden pins the file), the lock
# must record v2.0.0, and `build run` must see the new tree.
timeout=600
stdout_keep=^(Found|  - |Checking|  remote|Updating|Resolving|Done|Building|remote 2\.0\.0$|Wrote|yo\.lock is up)
