# Phase 0 gate (plans/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §3.4): `yo
# compile --profile` must print the phase table and the function census.
# Timings are not reproducible — the harness normalizes every `<N> ms` to
# <TIME>, so the golden pins the PHASE NAMES and their order. The per-module
# rows are ordered by measured time (run-to-run nondeterministic) and the
# module count varies with std churn, so only `phase`/`functions` lines are
# kept from the merged stream; the table itself still prints.
stdout_keep=^profile: (phase|functions)
timeout=120
