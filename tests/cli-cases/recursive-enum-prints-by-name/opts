# A recursive enum's self-shell prints as `Self`, as the field was written, not
# as an internal `__self_shell` id (Phase 4.4).
# The diagnostic is an operator on the Box(Self) payload binding: a nested
# `.Nil` pattern at that position matches since #993 (patterns through Box).
stdout_keep_match=error(\[E[0-9]+\])?: .*|--> main\.yo:[0-9]+:[0-9]+|help: did you mean.*
timeout=120
