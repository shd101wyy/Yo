# A Rust std name that Yo spells differently is E0401 with the Yo name and its
# import as help (plans/backlog/STD_RUST_ALIGNMENT.md §3.6), not the nearest-name
# guess (`Vec` used to be "did you mean `Rc`?"). `yo fix` offers no rewrite: the
# name and the import line are two edits.
stdout_keep_match=error(\[E[0-9]+\])?: .*|--> main\.yo:[0-9]+:[0-9]+|help: (did you mean|`).*
timeout=120
