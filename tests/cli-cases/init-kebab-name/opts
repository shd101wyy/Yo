# `yo init` writes the kebab-case form of the name it derives: the directory
# `My_App` gets `[package] name = "my-app"` (lowercased, `_` → `-`), and the
# generated build.yo names `my-app` / `my-app-lib`. `--no-skills` keeps the
# skill files (pinned by the init/skills cases) out of this golden.
timeout=300
