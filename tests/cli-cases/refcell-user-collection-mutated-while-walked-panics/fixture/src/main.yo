// A value user collection shared through `Rc(RefCell(...))`, walked inside a
// `with` body and mutated through a second `Rc` handle's `with_mut`, panics:
// the cell's own flag catches what a `ref` collection's run-time borrow flag
// caught (tests/cli-cases/inout-self-method-under-borrow-panics). Naming the
// walked value itself is E0911 (tests/for_macro_borrow.test.yo).
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ RefCell } :: import("std/sync/refcell");
UserBag :: struct(items : ArrayList(i32), version : i32);
impl(
  UserBag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur.* < self.items.len()),
    walk_ref : (fn(self : &Self, cur : &usize) -> &i32)(&self.items(cur.*)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur.* + usize(1))
  )
);
impl(
  UserBag,
  bump_version : (fn(self : &mut Self) -> unit)({
    self.version = (self.version + i32(1));
  })
);
main :: (fn() -> unit)({
  mut(bag) := UserBag(items : ArrayList(i32).new(), version : i32(0));
  bag.items.push(i32(1));
  bag.items.push(i32(2));
  a := Rc.new(RefCell(UserBag).new(bag));
  b := Rc.clone(&a);
  a.with(v => {
    for(&v.*, x => {
      println(`walking ${x.*.to_string()}`);
      b.with_mut(m => m.bump_version());
    });
  });
  println("unreachable");
});
export(main);
