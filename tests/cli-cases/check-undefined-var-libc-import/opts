# `check` must report an undefined variable inside a fn body even when the
# module directly imports a c_include (libc) module. The self-hosted evaluator
# used to return 0 here: c_include externs (permanently valueless fn-typed
# comptime vars) tripped the forward-declared-comptime-fn heuristic, which
# suppressed the def-eval fatal re-raise for EVERY definition in the importing
# module — the GATE-4 hole that let the missing `set_current_target` import in
# yo-self/main.yo through. See
# issues/fixed/yo-self-check-misses-undefined-variable.md.
stdout_keep_match=Variable "totally_undefined_zzz" not found
timeout=120
