# `yo check <dir>` over `lib.yo` and a `main.yo` that imports it evaluates
# `lib.yo` once: the second target's import is a cache hit on the first
# target's evaluation, not a second evaluation whose `Matrix` meets the first
# one's inside `derive(VrStereoConfig, Copy, Clone)`.
stdout_keep_match=check: [0-9]+/[0-9]+ file\(s\) passed|evaluator OK
timeout=180
