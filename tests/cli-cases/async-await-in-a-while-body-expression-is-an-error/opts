# An io.await nested inside a larger expression in an arm or a loop body
# cannot be split by today's lowering. It used to be ACCEPTED and silently
# dropped: the statement vanished (a wrong value) or the await read a NULL
# future slot (SIGSEGV). It is now a coded user error at the await
# (issues/fixed/await-inside-an-expression-in-a-later-cond-arm-is-dropped.md).
stdout_keep_match=error\[E0904\]|internal compiler error|is not supported in this position
timeout=120
