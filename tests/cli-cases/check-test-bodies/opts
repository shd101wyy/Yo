# `yo check --test-bodies` stops swallowing errors from the test-body trial
# (plans/archive/LLM_FRIENDLY_TOOLCHAIN_AND_SYNTAX.md §1.3). Measured 2026-09-16:
# without the flag this exact file reports "evaluator OK", which is how
# #717's four private-member reaches escaped `check` and surfaced one per
# suite run instead.
#
# The flag is OPT-IN because the trial takes a different generic-inference
# path than the real `main` wrapper and so has known false positives; this
# case pins that a REAL error is reported, by its own name.
stdout_keep_match=totally_undefined_name_zzz
timeout=180
