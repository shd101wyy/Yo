# The `{ x }` footgun (plans/archive/LLM_FRIENDLY_TOOLCHAIN_AND_SYNTAX.md §4): a brace
# group without a semicolon is a record in EVERY position — that is the
# decided rule and it is not changing — so `v => { v }` builds a one-field
# record where a model means a block. The diagnostic now names the brace rule
# at the punned literal instead of surfacing as a type mismatch somewhere
# downstream that never mentions braces.
#
# stdout_keep_match asserts the advice line, which is the part a reader acts
# on; matching only invariant text, no spans or ids.
stdout_keep_match=a brace group without a semicolon is a record
timeout=180
