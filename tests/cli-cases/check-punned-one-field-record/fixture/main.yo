{ println } :: import("std/fmt");
P :: struct(y : i32);
main :: (fn() -> unit)({
  y := i32(7);
  // `{ y }` is a block that yields `y`, an `i32`; the one-field record is
  // `.{ y }`. The error says so rather than surfacing as a bare mismatch.
  (p : P) = { y };
  println(p.y.to_string());
});
export(main);
