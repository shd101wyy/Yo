# Safe mode D1 for a 64-bit usize: usize.MAX + 1 at runtime aborts with a
# located diagnostic, like u64, instead of silently wrapping to 0
# (issues/fixed/usize-arithmetic-is-unguarded-on-64-bit-targets.md).
# Recorded by hand: the recording binary must carry the trap.
stdout_keep_match=integer addition overflow
timeout=300
