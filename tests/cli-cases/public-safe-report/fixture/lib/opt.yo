impl(
  generic(T : Type),
  Option(T),
  unwrap : (fn(imm(self) : Self) -> T)(
    match(
      self,
      .Some(v) => v,
      .None => __yo_panic("none")
    )
  ),
  expect_some : (fn(imm(self) : Self) -> T)(
    match(
      self,
      .Some(v) => v,
      .None => __yo_panic("none")
    )
  )
);
impl(
  generic(T : Type),
  where(T <: Comptime),
  Option(T),
  comptime_unwrap : (fn(comptime(self) : Self) -> comptime(T))(
    match(
      self,
      .Some(v) => v,
      .None => __yo_panic("none")
    )
  )
);
