{ println } :: import("std/fmt");
Tag :: trait();
impl(i32, Tag());
impl(generic(T : Type), where(T <: Tag), T, twice : (fn(self : Self) -> i32)(i32(2)));
impl(generic(T : Type), where(T <: Tag), T, twice : (fn(self : Self) -> i32)(i32(3)));
main :: (fn() -> unit)({
  println(i32(1).twice());
});
export(main);
