{ Thread } :: import("std/thread");
{ ArrayList } :: import("std/collections/array_list");
mut(g) := ArrayList(i32).new();
_worker :: (fn(io : Io) -> unit)({
  mut(g2) := g.clone();
  g2.push(i32(1));
  g = g2;
});
main :: (fn() -> unit)({
  t := Thread(unit).spawn(_worker);
  mut(g2) := g.clone();
  g2.push(i32(2));
  g = g2;
  t.join();
});
export(main);
