//! `yo fix --migrate explicit-copy` over a test file: a `test(...)` body whose
//! trial evaluation fails (`missing_function` is undefined) is swallowed by
//! the trial, so its copies are never judged. The run lists the body instead
//! of passing over it; the body that evaluates gets its `.clone()`. The copied
//! value is a `BTreeMap` (still a `ref`, so a copy dups the handle; decision
//! Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
test("copies", {
  s := BTreeMap(i32, i32).new();
  t := s;
  println(`${s.len().to_string()} ${t.len().to_string()}`);
});
test("skipped", {
  s := BTreeMap(i32, i32).new();
  t := s;
  println(`${s.len().to_string()} ${t.len().to_string()}`);
  missing_function(s);
});
