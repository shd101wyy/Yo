# Not D3-specific: any error in a closure whose parameter is `Io` is reported at
# `check`. `Io` is a concrete struct; its generic fn fields do not make the
# closure generic, as they do not for a named fn
# (issues/fixed/2026-10-15-yo-check-swallows-a-d3-error-inside-a-thread-spawn-or-io-async-body.md).
stdout_keep_match=error\[E0610\]|--> main\.yo:[0-9]+:[0-9]+
timeout=120
