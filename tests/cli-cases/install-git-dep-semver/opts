# A git dependency with a SEMVER RANGE, resolved and fetched OFFLINE: the
# remote is the bare repository fixture/remote.git (tags v1.0.0, v1.2.0,
# v2.0.0 and a non-version tag; the manifest's `git = "./remote.git"` is a
# path git accepts as a remote). `yo install` must pick v1.2.0 for "^1" —
# the highest tag inside the range, not the highest tag — write yo.lock and
# populate the sandbox HOME's cache; `build run` then imports the dependency
# by name and prints the version its lib.yo carries.
timeout=600
stdout_keep=^(Found|  - |Fetching|Done|Building|remote 1\.2\.0$|Wrote|yo\.lock is up)
