// `Weak(T)` (plans/backlog/WEAK_AND_UNCOLLECTED_RC.md §3.3, W3): the last
// `Rc` drops the payload while a `Weak` keeps the cell's bytes, the last
// `Weak` frees the cell, and a cycle closed through a `Weak` frees itself,
// under both `--cycle-collector` modes. The `--debug-heap` oracle's
// live-at-exit count is the witness.
{ println } :: import("std/fmt");
{ RefCell } :: import("std/sync/refcell");
Loop :: struct(me : Weak(RefCell(Self)), n : i32);
test("a Weak outlives its Rc, and a Weak self-loop frees itself", {
  a := rc(i32(1));
  w := Rc.downgrade(&a);
  consume(a);
  gone := w.upgrade().is_none();
  println(`weak: upgrade after the last Rc is none ${gone.to_string()}`);
  l := rc(RefCell(Loop).new(Loop(me : Weak(RefCell(Loop)).new(), n : i32(2))));
  me := Rc.downgrade(&l);
  l.with_mut({ me }(v) => {
    v.me = Weak.clone(&me);
  });
});
