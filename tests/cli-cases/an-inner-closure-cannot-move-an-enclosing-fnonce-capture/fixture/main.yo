Tok :: struct(n : i32);
impl(Tok, Dispose(dispose : (fn(self : &Self) -> unit)(())));
eat :: (fn(t : Tok) -> i32)(t.n);
run_twice :: (fn(g : &Impl(Fn() -> i32)) -> i32)(g() + g());
run_once :: (fn(h : Impl(FnOnce() -> i32)) -> i32)(h());
main :: (fn() -> unit)({
  t := Tok(n : i32(7));
  _r := run_once({ t }() => run_twice(() => eat(t)));
});
export(main);
