//! `yo fix --migrate unsized` finds a `dyn(v)` site by its position, not by
//! printing the evaluated argument back: a template literal, a bracket inside
//! a string and an argument over several lines are rewritten. An enum variant
//! named `Dyn` is not a type spelling, and a `dyn` site inside a
//! `comptime_expect_error` argument is the error under test: both stay.
{ String } :: import("std/string");
Show :: trait(show : (fn(self : &Self) -> String));
impl(String, Show(show : (self -> self.clone())));
Shape :: enum(
  Dyn(x : i32),
  Plain
);
shape_n :: (fn(s : Shape) -> i32)(
  match(
    s,
    .Dyn(x : v) => v,
    .Plain => i32(0)
  )
);
literal :: (fn() -> Box(Dyn(Show)))(dyn(`hi`));
interpolated :: (fn(n : i32) -> Box(Dyn(Show)))(dyn(`n = ${n} (${String.from("x)")})`));
bracket :: (fn() -> Box(Dyn(Show)))(dyn(String.from("a[b")));
escaped :: (fn() -> Box(Dyn(Show)))(dyn(String.from("a\"(b")));
lines :: (fn() -> Box(Dyn(Show)))(
  dyn(
    String.from(
      "spans lines" // a comment holding a ) bracket
    )
  )
);
written :: (fn() -> Box(Dyn(Show)))(dyn(Box.new(String.from("boxed"))));
negative :: (fn() -> unit)({
  comptime_expect_error({
    (s : Box(Dyn(Show))) = dyn(i32(1));
  }, "Show");
});
main :: (fn() -> unit)({
  _a := literal().show();
  _b := interpolated(i32(1)).show();
  _c := bracket().show();
  _d := escaped().show();
  _e := lines().show();
  _f := written().show();
  _n := shape_n(.Dyn(x : i32(1)));
  negative();
});
export(main);
