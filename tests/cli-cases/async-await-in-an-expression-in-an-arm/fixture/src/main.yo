{ println } :: import("std/fmt");
leaf :: (fn(x : i32, io : Io) -> Impl(Future(i32)))(io.async((io2 : Io) => (x + i32(1))));
run :: (fn(k : i32, io : Io) -> Impl(Future(i32)))(
  io.async((io : Io) => {
    (x : i32) = i32(0);
    if(k > i32(0), {
      x = (x + io.await(leaf(k, io), io));
    });
    x
  })
);
main :: (fn(io : Io) -> unit)({
  v := io.await(run(i32(1), io), io);
  println(`result: ${v}`);
});
export(main);
