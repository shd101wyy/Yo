//! `yo fix --migrate explicit-copy`: a copy of a `String`, a collection or a
//! value holding one, whose source stays alive, is spelled `.clone()`. A copy
//! whose source or destination is written afterwards may share its buffer on
//! purpose, so it is listed instead.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
Person :: struct(name : String, tags : ArrayList(String), age : i32);
derive(Person, Clone);
first_name :: (fn(p : &Person) -> String)(p.name);
keep :: (fn(s : &String) -> String)(s);
main :: (fn() -> unit)({
  a := String.from("ada");
  b := a;
  tags := ArrayList(String).new();
  tags.push(b);
  p := Person(name : a, tags : tags, age : i32(36));
  q := p;
  n := first_name(&q);
  k := keep(&n);
  maybe := Option(String).Some(k);
  m2 := maybe;
  age := p.age;
  println(`${p.name} ${q.name} ${n} ${age.to_string()} ${m2.is_some().to_string()} ${maybe.is_some().to_string()}`);
  // The copy is written afterwards: listed, left as written.
  r := String.from("r");
  r2 := r;
  r2.push_str("!");
  println(`${r} ${r2}`);
  // The source is written afterwards: listed, left as written.
  s1 := String.from("s");
  s2 := s1;
  s1.push_str("?");
  println(`${s1} ${s2}`);
});
export(main);
