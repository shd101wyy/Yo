//! `Bag`'s `Clone` is derived below the function that copies a `Bag`. The
//! copy is evaluated first, so a `Clone` question asked when it is recorded
//! answers "no", and the copy was dropped from the migration. It is listed:
//! `Bag` has `Clone` by the end of the run, but a `.clone()` written at the
//! copy does not resolve above the `derive`. `Sack`'s `Clone` is an `impl`
//! below its copies: a `.clone()` lookup there forces it, so the copy of a
//! `Sack` and of a `BTreeMap(i32, Sack)` are both cloned. The `items` are
//! `BTreeMap`s (still a `ref`; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
Bag :: struct(items : BTreeMap(i32, i32), label : i32);
count :: (fn(b : &Bag) -> usize)({
  c := b;
  c.items.len()
});
derive(Bag, Clone);
Sack :: struct(items : BTreeMap(i32, i32), label : i32);
sack_count :: (fn(s : &Sack) -> usize)({
  c := s;
  c.items.len()
});
sacks_count :: (fn(ss : &BTreeMap(i32, Sack)) -> usize)({
  c := ss;
  c.len()
});
impl(Sack, Clone(clone : (fn(self : &Self) -> Self)(Sack(items : self.items.clone(), label : self.label))));
main :: (fn() -> unit)(());
export(main);
