S64 :: struct(a : S63, b : S63);
ident :: (fn(sink(o) : S64) -> S64)(o);
use :: (fn(sink(o) : S64) -> i32)({
  p := ident(o);
  q := p;
  imm(r) := q.a;
  i32(0)
});
export(use);
