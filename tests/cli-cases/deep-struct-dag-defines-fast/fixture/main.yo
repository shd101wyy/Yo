// S(i) holds two S(i-1): 65 types whose expanded field tree has 2^64
// leaves. Each walk over a type (its universe, whether it holds a raw
// pointer) must visit each type once, not once per path through the tree.
S0 :: struct(x : i32);
S1 :: struct(a : S0, b : S0);
S2 :: struct(a : S1, b : S1);
S3 :: struct(a : S2, b : S2);
