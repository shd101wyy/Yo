# `yo cache gc` keeps every store tree a recorded project's yo.lock references
# and removes the rest. After `yo install` the project's lock names remote's
# tree, so the first gc removes nothing; `yo remove remote` rewrites the lock
# without it, so the second gc drops the tree, the remote's mirror and its tag
# list. Numbers only: the store, mirror and index paths are per-run.
timeout=600
stdout_keep=^(Kept|Removed|Wrote|yo\.lock is up|Done)
