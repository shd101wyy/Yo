// a.yo and b.yo each declare a generic `Wrap(T)` and a trait `Show`. They are
// two different types that print alike, so `yo fix` / `yo check` over both
// files in one session must keep each file's impls on its own `Wrap`.
Wrap :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(v : T)
);
impl(
  generic(T : Type),
  Wrap(T),
  add : (fn(self : &Self, delta : i32) -> i32)(self.v + delta)
);
Show :: trait(
  show : (fn(self : &Self) -> i32)
);
impl(
  generic(T : Type),
  Wrap(T),
  Show(
    show : (fn(self : &Self) -> i32)(i32(1))
  )
);
// A hand-written generic Clone, and a Copy impl over it that is rejected:
// the rejected impl must not make b.yo's unrelated `GenBox` Copy impl fail.
Tag :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(id : i32)
);
impl(
  generic(T : Type),
  Tag(T),
  Clone(
    clone : (fn(self : &Self) -> Self)(Self(id : self.id))
  )
);
comptime_expect_error(impl(generic(T : Type), Tag(T), Copy()), "a hand-written Clone impl can only repeat it or contradict it");
// Each file's own `Meters`, with an impl of the prelude's `From` for the
// prelude's `Option(T)`: `From(Meters)` is a different trait instance in each
// file, although both print alike.
Meters :: struct(v : i32);
impl(
  generic(T : Type),
  Option(T),
  From(Meters)(
    from : (fn(value : Meters) -> Self)(Option(T).None)
  )
);
total := i32(0);
main :: (fn() -> unit)({
  w := Wrap(i32)(v : i32(60));
  total = (w.add(i32(5)) + w.show());
});
export(main);
