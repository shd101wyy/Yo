# A batch that fails to compile fails its own tests and the run goes on:
# b_fine.test.yo still runs after a_broken.test.yo's link failure, and the
# summary counts both (issues/fixed/a-test-batch-compile-failure-aborts-the-whole-run.md).
# The runner used to throw at the first such batch, which ended the run. The
# golden keeps the verdict lines, the did-not-run note and the counts.
stdout_keep_match=^(\$ yo .*|rc=[0-9]+|  [✓✗] .*|    the batch failed to compile.*|[0-9]+ (passed|failed|total))$
timeout=600
