{ yield } :: import("std/async");
CounterInner :: struct(n : i32);
Counter :: Rc(CounterInner);
bump_later :: (fn(c : &Counter, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    n := &c.*.*.n;
    e.await(yield(e), e);
    n.*
  })
);
main :: (fn(io : Io) -> unit)({
  c := Rc.new(CounterInner(n : i32(1)));
  _r := io.await(bump_later(&c, io), io);
});
export(main);
