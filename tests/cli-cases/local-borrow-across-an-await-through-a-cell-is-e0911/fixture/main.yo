{ yield } :: import("std/async");
Counter :: ref(struct(n : i32));
bump_later :: (fn(c : Counter, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    mut(n) := c.n;
    e.await(yield(e), e);
    n = (n + i32(1));
    n
  })
);
main :: (fn(io : Io) -> unit)({
  c := Counter(n : i32(1));
  _r := io.await(bump_later(c, io), io);
});
export(main);
