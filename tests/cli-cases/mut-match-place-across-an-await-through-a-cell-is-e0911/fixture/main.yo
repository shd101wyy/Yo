{ yield } :: import("std/async");
HolderInner :: struct(o : Option(i32));
Holder :: Rc(HolderInner);
main :: (fn(io : Io) -> unit)({
  h := Rc.new(HolderInner(o : Option(i32).Some(i32(1))));
  t := io.async((e : Io) => {
    cur := &h.*.o;
    match(
      cur,
      .Some(n) => {
        e.await(yield(e), e);
        _v := n.*;
      },
      .None => ()
    );
  });
  io.await(t, io);
});
export(main);
