{ yield } :: import("std/async");
Holder :: ref(struct(o : Option(i32)));
main :: (fn(io : Io) -> unit)({
  h := Holder(o : .Some(i32(1)));
  t := io.async((e : Io) => {
    cur := &mut h.o;
    match(
      cur,
      .Some(n) => {
        e.await(yield(e), e);
        n = (n + i32(1));
      },
      .None => ()
    );
  });
  io.await(t, io);
});
export(main);
