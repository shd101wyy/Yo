{ println } :: import("std/fmt");
Named :: trait(name : (fn(self : Self) -> i32));
Marker :: trait();
impl(i32, Marker());
impl(i32, Named(name : (self -> i32(0))));
impl(generic(T : Type), where(T <: Marker), T, Named(name : (self -> i32(7))));
main :: (fn() -> unit)({
  println(i32(1).name());
});
export(main);
