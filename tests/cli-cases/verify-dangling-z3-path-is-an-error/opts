# A YO_Z3_PATH that names no file is an error, never a solver. Before the fix
# it resolved as one, so a warm verify cache answered `proved` with no solver
# present (issues/fixed/compile-missing-solver-handling-ignores-verify-plus-and-trusts-a-dangling-z3-path.md).
# A verify-mode file needs its proofs, so the compile fails (rc 1).
# Recorded by hand.
env=YO_Z3_PATH=/nonexistent/z3
stdout_keep_match=solver path '/nonexistent/z3' does not exist
timeout=300
