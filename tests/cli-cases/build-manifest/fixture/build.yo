build :: import("std/build");

// `build.manifest()` reads the `[package]` table of the yo.toml beside this
// file (plans/archive/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.1).
m :: build.manifest();

// The artifact is named by the manifest, not by this file.
exe :: build.executable({ name : m.name, root : "./src/main.yo" });

install :: build.step("install", m.version);
install.depend_on(exe);

name_step :: build.step("package-name", m.name);

// A field the manifest does not set reads as "" (no `license` here).
absent_step :: build.step("absent-field", __yo_build_manifest_field("license"));
