# Import-list completion: the cursor inside the braces of
# `{ … } :: import("mod")` offers the module's exports — a partial word
# (`{ Arr| }`), an empty list (`{ |}`), and a list that already names two
# exports (`{ println, e| }` → `println` is not offered again). The module is
# read from the module cache when the document's analysis loaded it, else
# evaluated on demand. The document does not need to parse.
timeout=240
