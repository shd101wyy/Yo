# `Io.native()` (the calling thread's native `Io`, the prelude's
# `impl(Io, native : __yo_io_native)`) is a runtime entry point: a safe file
# takes `io` as an argument and never builds one
# (plans/backlog/IO_INTERFACE_AND_STD_RUNTIME.md §2). A static member bound to
# a runtime extern is that extern called by name (rule D6). The kept substring
# pins THE diagnostic.
stdout_keep_match=Calling the runtime extern '__yo_io_native' is not available in safe code
timeout=120
