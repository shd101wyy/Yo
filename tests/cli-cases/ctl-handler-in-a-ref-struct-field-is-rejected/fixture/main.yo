{ println } :: import("std/fmt");
{ String } :: import("std/string");
Raise :: (ctl(msg : &String) -> i32);
Slot :: struct(r : Raise);
SharedSlot :: Rc(Slot);
dummy :: (fn(msg : String) -> i32)(i32(1));
main :: (fn() -> unit)({
  s := SharedSlot.new(Slot(r : dummy));
  println(`made a slot`);
});
export(main);
