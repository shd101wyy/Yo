//! `yo fix --migrate explicit-copy` lists, and never rewrites, a copy inside
//! a `Clone` impl's member: there the impl defines how deep its type's copy
//! goes. `Tree.clone` shares the `kids` handle on purpose, so an insert
//! through the copy is seen by the original; a `.clone()` there would make every
//! `Tree.clone` a deep copy and the run print `0`. `Bag(T)`'s generic impl
//! shares its `items` the same way and is recognized the same way. A copy
//! outside the impls (`tags.insert(i32(0), label)` while `label` is read
//! again) is still cloned. The handles are `BTreeMap`s (still a `ref`; decision
//! Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
Tree :: ref(
  enum(
    Leaf(n : i32),
    Node(kids : BTreeMap(i32, Self))
  )
);
impl(
  Tree,
  Clone(
    clone : (fn(self : &Self) -> Self)(
      match(
        self,
        .Leaf(n) => Tree.Leaf(n),
        .Node(kids) => Tree.Node(kids)
      )
    )
  )
);
Bag :: (fn(comptime(T) : Type) -> comptime(Type))(ref(struct(items : BTreeMap(i32, T))));
impl(
  generic(T : Type),
  Bag(T),
  Clone(
    clone : (fn(self : &Self) -> Self)(
      Self(items : self.items)
    )
  )
);
bag_shares :: (fn() -> usize)({
  b := Bag(i32)(items : BTreeMap(i32, i32).new());
  c := b.clone();
  c.items.insert(i32(0), i32(1));
  b.items.len()
});
main :: (fn() -> unit)({
  t := Tree.Node(BTreeMap(i32, Tree).new());
  u := t.clone();
  match(
    u,
    .Node(ks) => {
      mut(list) := ks;
      list.insert(i32(0), Tree.Leaf(i32(1)));
    },
    .Leaf(_) => ()
  );
  n := match(t, .Node(ks) => ks.len(), .Leaf(_) => usize(0));
  label := BTreeMap(i32, i32).new();
  label.insert(i32(7), i32(7));
  tags := BTreeMap(i32, BTreeMap(i32, i32)).new();
  tags.insert(i32(0), label);
  println(`${n.to_string()} ${label.len().to_string()} ${tags.len().to_string()} ${bag_shares().to_string()}`);
});
export(main);
