//! `yo fix --migrate explicit-copy` lists, and never rewrites, a copy inside
//! a `Clone` impl's member: there the impl defines how deep its type's copy
//! goes. `Tree.clone` shares the `kids` handle on purpose, so a push through
//! the copy is seen by the original; a `.clone()` there would make every
//! `Tree.clone` a deep copy and the run print `0`. `Bag(T)`'s generic impl
//! shares its `items` the same way and is recognized the same way. A copy
//! outside the impls (`tags.push(label)` while `label` is read again) is
//! still cloned.
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ println } :: import("std/fmt");
Tree :: ref(
  enum(
    Leaf(n : i32),
    Node(kids : ArrayList(Self))
  )
);
impl(
  Tree,
  Clone(
    clone : (fn(self : &Self) -> Self)(
      match(
        self,
        .Leaf(n) => Tree.Leaf(n),
        .Node(kids) => Tree.Node(kids)
      )
    )
  )
);
Bag :: (fn(comptime(T) : Type) -> comptime(Type))(ref(struct(items : ArrayList(T))));
impl(
  generic(T : Type),
  Bag(T),
  Clone(
    clone : (fn(self : &Self) -> Self)(
      Self(items : self.items)
    )
  )
);
bag_shares :: (fn() -> usize)({
  b := Bag(i32)(items : ArrayList(i32).new());
  c := b.clone();
  c.items.push(i32(1));
  b.items.len()
});
main :: (fn() -> unit)({
  t := Tree.Node(ArrayList(Tree).new());
  u := t.clone();
  match(
    u,
    .Node(ks) => {
      mut(list) := ks;
      list.push(Tree.Leaf(i32(1)));
    },
    .Leaf(_) => ()
  );
  n := match(t, .Node(ks) => ks.len(), .Leaf(_) => usize(0));
  label := String.from("n");
  tags := ArrayList(String).new();
  tags.push(label);
  println(`${n.to_string()} ${label} ${tags.len().to_string()} ${bag_shares().to_string()}`);
});
export(main);
