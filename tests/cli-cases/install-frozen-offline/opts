# `--frozen` (= --locked --offline) after a plain `yo install`: the lock is
# complete and the cache holds the tree, so the second run must succeed with
# no network and no lock change — the shape CI runs on a checked-in lock.
timeout=600
stdout_keep=^(\$ yo|Found|  - |  remote →|Resolving|Done|rc=|Wrote|yo\.lock is up)
