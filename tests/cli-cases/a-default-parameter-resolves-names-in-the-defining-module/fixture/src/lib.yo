//! A library whose `?=` defaults name its OWN bindings: the constant `K` and
//! the imported `Allocator`. Naming `Allocator` in a signature needs the pragma.
pragma(Pragma.AllowUnsafe);
{ Allocator } :: import("std/allocator");
K :: i32(5);
f :: (fn((x : i32) ?= K) -> i32)(x);
g :: (fn(generic(T : Type), v : T, (x : i32) ?= K) -> i32)(x);
Counter :: struct(n : i32);
impl(Counter, bump : (fn(self : Self, (by : i32) ?= K) -> i32)(self.n + by));
named_alloc :: (fn((alloc : Option(Allocator)) ?= Option(Allocator).None) -> bool)(alloc.is_none());
short_alloc :: (fn((alloc : Option(Allocator)) ?= .None) -> bool)(alloc.is_none());
// `LATE` is defined after its use: `::` definitions are order-independent.
late :: (fn((x : i32) ?= LATE) -> i32)(x);
LATE :: i32(8);
export(f, g, Counter, named_alloc, short_alloc, late);
