open(import("std/fmt"));
open(import("std/string"));
Counter :: struct(n : i32);
impl(
  Counter,
  double : (fn(self : Counter) -> i32)(self.helper() * i32(2)),
  helper : (fn(self : Counter) -> i32)(String.from("not an i32"))
);
main :: (fn() -> unit)({
  c := Counter(n : i32(4));
  println(c.double().to_string());
});
export(main);
