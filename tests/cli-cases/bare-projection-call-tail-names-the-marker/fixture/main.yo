//! A bare projection call as a projection body: the missing `&mut` marker is
//! reported as decision 24, naming the lending spelling.
{ ArrayList } :: import("std/collections/array_list");
Bag :: struct(items : ArrayList(i32));
impl(
  Bag,
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : i32,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self.items.len()),
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut i32)(self.items.walk_elem(cur)),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
main :: (fn() -> unit)({
  (mut(bag) : Bag) = Bag(items : ArrayList(i32).new());
  bag.items.push(i32(1));
  for(&mut bag, x => {
    x = (x * i32(10));
  });
});
export(main);
