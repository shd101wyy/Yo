//! A bare projection call as a projection body: the missing `&mut` marker is
//! reported as decision 24, naming the lending spelling.
{ ArrayList } :: import("std/collections/array_list");
Bag :: struct(items : ArrayList(i32));
impl(
  Bag,
  at_mut : (fn(self : &mut Self, i : usize) -> &mut i32)(self.items.index_mut(i))
);
main :: (fn() -> unit)({
  (mut(bag) : Bag) = Bag(items : ArrayList(i32).new());
  bag.items.push(i32(1));
  x := bag.at_mut(usize(0));
  x.* = i32(10);
});
export(main);
