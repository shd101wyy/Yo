// A reference stored as a collection element: E0909, the container/cell wall
// (issues/fixed/2026-11-21-a-reference-in-a-container-is-an-uncoded-error-citing-plan-phases.md).
{ ArrayList } :: import("std/collections/array-list");
main :: (fn() -> unit)({
  x := i32(1);
  mut(r) := ArrayList(&i32).new();
  r.push(&x);
});
export(main);
