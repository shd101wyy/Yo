{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
sink :: (fn(own(xs) : ArrayList(i32)) -> unit)(());
main :: (fn() -> unit)({
  xs := ArrayList(i32).new();
  c := runtime(true);
  if(c, {
    sink(xs);
  }, {
    println(`else ${xs.len()}`);
  });
});
export(main);
