# `..` stands for a variant's whole payload and is written alone, `.V(..)`
# (VERDICTS-88). Beside a positional sub-pattern it is E0609, whose help
# writes one `_` per field it stands for (`..` used to bind a variable named
# `..` there).
stdout_keep_match=error(\[E[0-9]+\])?: .*|--> main\.yo:[0-9]+:[0-9]+|help: .*
timeout=120
