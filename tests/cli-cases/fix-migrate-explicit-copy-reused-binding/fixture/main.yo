//! `yo fix --migrate explicit-copy` judges a `match` binding of a temporary
//! with liveness, at the end of its arm: each copy of `z` made while `z` is
//! read again is genuine and gets `.clone()`; its last use, the arm's tail,
//! is a move and is neither rewritten nor listed. A copy a guard makes
//! (`keep(g)`) is genuine whatever follows it: a failing guard hands the same
//! payload to the next arm, which binds it again as `y`. The payload is a
//! `BTreeMap` (still a `ref`, so a copy dups the handle; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
make_opt :: (fn() -> Option(BTreeMap(i32, i32)))(.Some(BTreeMap(i32, i32).new()));
keep :: (fn(sink(s) : BTreeMap(i32, i32)) -> bool)(s.len() > usize(5));
main :: (fn() -> unit)({
  hs := BTreeMap(i32, BTreeMap(i32, i32)).new();
  b := match(
    make_opt(),
    .Some(z) => {
      hs.insert(i32(0), z);
      hs.insert(i32(1), z);
      z
    },
    .None => BTreeMap(i32, i32).new()
  );
  r := match(
    make_opt(),
    (.Some(g) && keep(g)) => usize(1),
    .Some(y) => {
      hs.insert(i32(2), y);
      usize(2)
    },
    .None => usize(0)
  );
  println(`${b.len().to_string()} ${r.to_string()} ${hs.len().to_string()}`);
});
export(main);
