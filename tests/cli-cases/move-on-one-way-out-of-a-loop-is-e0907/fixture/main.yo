{ ArrayList } :: import("std/collections/array_list");
sink :: (fn(own(xs) : ArrayList(i32)) -> unit)(());
main :: (fn() -> unit)({
  xs := ArrayList(i32).new();
  (i : i32) = 0;
  while(runtime(i < 3), {
    if(runtime(i == 1), {
      sink(xs);
      break;
    });
    i = (i + 1);
  });
});
export(main);
