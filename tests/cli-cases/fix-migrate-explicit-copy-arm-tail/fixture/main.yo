//! `yo fix --migrate explicit-copy` lists a `match` arm's copy of a payload it
//! borrows through `&mut self`: the copy flows into a binding that is written
//! and stored back, and `cur`, a copy of `t`, shares both maps with `t`. The
//! payloads are `BTreeMap`s (still a `ref`; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
Tbl :: enum(Table(keys : BTreeMap(i32, i32), vals : BTreeMap(i32, i32)), Empty);
impl(
  Tbl,
  insert : (fn(self : &mut Self, key : i32, v : i32) -> unit)({
    keys := match(self, .Table(k, _) => k, _ => BTreeMap(i32, i32).new());
    vals := match(self, .Table(_, vs) => vs, _ => BTreeMap(i32, i32).new());
    keys.insert(key, key);
    vals.insert(key, v);
    self = Self.Table(keys, vals);
  }),
  size : (fn(self : &Self) -> usize)(match(self, .Table(k, _) => k.len(), _ => usize(0)))
);
main :: (fn() -> unit)({
  t := Tbl.Table(BTreeMap(i32, i32).new(), BTreeMap(i32, i32).new());
  mut(cur) := t;
  cur.insert(i32(1), i32(1));
  println(&`${t.size().to_string()} ${cur.size().to_string()}`);
});
export(main);
