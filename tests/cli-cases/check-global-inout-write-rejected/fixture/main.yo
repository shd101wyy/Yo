{ println } :: import("std/fmt");
{ Thread } :: import("std/thread");
Counter :: struct(n : i32);
bump_by_ten :: (fn(inout(c) : Counter) -> unit)({
  c.n = (c.n + i32(10));
});
describe :: (fn(inout(c) : Counter) -> i32)(c.n);
g := Counter(n : i32(0));
main :: (fn() -> unit)({
  t := Thread(i32).spawn((io : Io) => g.n);
  println(`read-only inout is fine: ${describe(g)}`);
  bump_by_ten(g);
  println(`seen=${t.join()}`);
});
export(main);
