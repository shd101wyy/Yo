# Safe mode Phase 3c (§6, ruling D2): float->int casts SATURATE at the
# target's bounds (NaN -> 0) instead of C UB. 3.9e9 saturates i32 to
# 2147483647. Recorded by hand: the recording binary must carry the change.
# stdout_keep: the golden is the program's own line only — the hand
# recording wrote just `n=...` and the first battery run through this case
# diffed against the full build chatter (warnings included) under it.
stdout_keep=^n=
timeout=300
