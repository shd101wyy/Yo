//! `yo fix --migrate explicit-copy` lists, and does not clone, a copy whose
//! source has a raw pointer derived from it: `_m` caches `marks.ptr()`, which
//! points into the buffer the field store shares with `marks`. A `.clone()`
//! would give the field a fresh buffer and leave `_m` pointing into the local
//! one, freed when `make` returns. The hand edit is a move with the pointer
//! taken first.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
Marks :: struct(marks : ArrayList(i32), _m : *i32);
make :: (fn() -> Marks)({
  marks := ArrayList(i32).new();
  marks.push(i32(7));
  Marks(marks : marks, _m : marks.ptr().unwrap())
});
main :: (fn() -> unit)({
  m := make();
  println(`${m.marks(usize(0))} ${m._m.*}`);
});
export(main);
