# Both programs must compile. Each trait count puts a type-table resize inside
# codegen's dyn-declaration walk (36 near the 224-entry threshold, 78 near the
# 448 one; measured windows 34–38 and 72–84). Before the fix the C failed to
# compile: vtable and Future structs defined twice (`redefinition of`).
stdout_keep_match=^Using .*|.*redefinition of.*
timeout=300
