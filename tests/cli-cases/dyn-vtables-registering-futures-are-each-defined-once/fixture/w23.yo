main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  (mut(total) : i32) = i32(0);
  (d0 : Dyn(T0)) = dyn(S0(n : i32(0)));
  total = (total + io.await(d0.get(io), IoExn(io : io, exn : exn)).v);
  (d1 : Dyn(T1)) = dyn(S1(n : i32(1)));
  total = (total + io.await(d1.get(io), IoExn(io : io, exn : exn)).v);
  (d2 : Dyn(T2)) = dyn(S2(n : i32(2)));
  total = (total + io.await(d2.get(io), IoExn(io : io, exn : exn)).v);
  (d3 : Dyn(T3)) = dyn(S3(n : i32(3)));
  total = (total + io.await(d3.get(io), IoExn(io : io, exn : exn)).v);
  (d4 : Dyn(T4)) = dyn(S4(n : i32(4)));
  total = (total + io.await(d4.get(io), IoExn(io : io, exn : exn)).v);
  (d5 : Dyn(T5)) = dyn(S5(n : i32(5)));
  total = (total + io.await(d5.get(io), IoExn(io : io, exn : exn)).v);
  (d6 : Dyn(T6)) = dyn(S6(n : i32(6)));
  total = (total + io.await(d6.get(io), IoExn(io : io, exn : exn)).v);
  (d7 : Dyn(T7)) = dyn(S7(n : i32(7)));
  total = (total + io.await(d7.get(io), IoExn(io : io, exn : exn)).v);
  (d8 : Dyn(T8)) = dyn(S8(n : i32(8)));
  total = (total + io.await(d8.get(io), IoExn(io : io, exn : exn)).v);
  (d9 : Dyn(T9)) = dyn(S9(n : i32(9)));
  total = (total + io.await(d9.get(io), IoExn(io : io, exn : exn)).v);
  (d10 : Dyn(T10)) = dyn(S10(n : i32(10)));
  total = (total + io.await(d10.get(io), IoExn(io : io, exn : exn)).v);
  (d11 : Dyn(T11)) = dyn(S11(n : i32(11)));
  total = (total + io.await(d11.get(io), IoExn(io : io, exn : exn)).v);
  (d12 : Dyn(T12)) = dyn(S12(n : i32(12)));
  total = (total + io.await(d12.get(io), IoExn(io : io, exn : exn)).v);
  (d13 : Dyn(T13)) = dyn(S13(n : i32(13)));
  total = (total + io.await(d13.get(io), IoExn(io : io, exn : exn)).v);
  (d14 : Dyn(T14)) = dyn(S14(n : i32(14)));
  total = (total + io.await(d14.get(io), IoExn(io : io, exn : exn)).v);
  (d15 : Dyn(T15)) = dyn(S15(n : i32(15)));
  total = (total + io.await(d15.get(io), IoExn(io : io, exn : exn)).v);
  (d16 : Dyn(T16)) = dyn(S16(n : i32(16)));
  total = (total + io.await(d16.get(io), IoExn(io : io, exn : exn)).v);
  (d17 : Dyn(T17)) = dyn(S17(n : i32(17)));
  total = (total + io.await(d17.get(io), IoExn(io : io, exn : exn)).v);
  (d18 : Dyn(T18)) = dyn(S18(n : i32(18)));
  total = (total + io.await(d18.get(io), IoExn(io : io, exn : exn)).v);
  (d19 : Dyn(T19)) = dyn(S19(n : i32(19)));
  total = (total + io.await(d19.get(io), IoExn(io : io, exn : exn)).v);
  (d20 : Dyn(T20)) = dyn(S20(n : i32(20)));
  total = (total + io.await(d20.get(io), IoExn(io : io, exn : exn)).v);
  (d21 : Dyn(T21)) = dyn(S21(n : i32(21)));
  total = (total + io.await(d21.get(io), IoExn(io : io, exn : exn)).v);
  (d22 : Dyn(T22)) = dyn(S22(n : i32(22)));
  total = (total + io.await(d22.get(io), IoExn(io : io, exn : exn)).v);
  println(`total: ${total}`);
});
export(main);
