P9 :: struct(v : i32);
T9 :: trait(get : (fn(self : &Self, io : Io) -> Impl(Future(P9, IoExn))));
S9 :: struct(n : i32);
impl(
  S9,
  T9(
    get : (fn(self : &Self, io : Io) -> Impl(Future(P9, IoExn)))(
      io.async({ n : self.n }(e : IoExn) => {
        return(P9(v : n));
      })
    )
  )
);
main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  (mut(total) : i32) = i32(0);
  (d0 : Dyn(T0)) = dyn(S0(n : i32(0)));
  total = (total + io.await(d0.get(io), IoExn(io : io, exn : exn)).v);
  (d1 : Dyn(T1)) = dyn(S1(n : i32(1)));
  total = (total + io.await(d1.get(io), IoExn(io : io, exn : exn)).v);
  (d2 : Dyn(T2)) = dyn(S2(n : i32(2)));
  total = (total + io.await(d2.get(io), IoExn(io : io, exn : exn)).v);
  (d3 : Dyn(T3)) = dyn(S3(n : i32(3)));
  total = (total + io.await(d3.get(io), IoExn(io : io, exn : exn)).v);
  (d4 : Dyn(T4)) = dyn(S4(n : i32(4)));
  total = (total + io.await(d4.get(io), IoExn(io : io, exn : exn)).v);
  (d5 : Dyn(T5)) = dyn(S5(n : i32(5)));
  total = (total + io.await(d5.get(io), IoExn(io : io, exn : exn)).v);
  (d6 : Dyn(T6)) = dyn(S6(n : i32(6)));
  total = (total + io.await(d6.get(io), IoExn(io : io, exn : exn)).v);
  (d7 : Dyn(T7)) = dyn(S7(n : i32(7)));
  total = (total + io.await(d7.get(io), IoExn(io : io, exn : exn)).v);
  (d8 : Dyn(T8)) = dyn(S8(n : i32(8)));
  total = (total + io.await(d8.get(io), IoExn(io : io, exn : exn)).v);
  (d9 : Dyn(T9)) = dyn(S9(n : i32(9)));
  total = (total + io.await(d9.get(io), IoExn(io : io, exn : exn)).v);
  println(`total: ${total}`);
});
export(main);
