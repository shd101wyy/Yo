P8 :: struct(v : i32);
T8 :: trait(get : (fn(self : &Self, io : Io) -> Impl(Future(P8, IoExn))));
S8 :: struct(n : i32);
impl(
  S8,
  T8(
    get : (fn(self : &Self, io : Io) -> Impl(Future(P8, IoExn)))(
      io.async({ n : self.n }(e : IoExn) => {
