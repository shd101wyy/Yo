# YO_TEST_FORK=N with --bail: b.test.yo's first test fails, so the run stops
# there exactly as the sequential runner does. b's second test does not run,
# and c and d (forked, possibly finished already) are reaped but their output
# and counts are dropped: the sequential runner would never have run them.
env=YO_TEST_FORK=2
stdout_keep_match=^(\$ yo .*|rc=[0-9]+|.*[a-d]\.test\.yo|  [✓✗] .*|[0-9]+ (passed|failed|total)|Bailing out.*)$
timeout=600
