build :: import("std/build");

exe :: build.executable({ name : "app", root : "./src/main.yo" });

// A step that reuses the artifact's name. `resolve_dependency` answers
// artifact → test → run → doc → step and takes the FIRST match, so one of
// these two is unreachable and `depend_on("app")` builds the wrong one.
clash :: build.step("app", "the same name as the executable");
