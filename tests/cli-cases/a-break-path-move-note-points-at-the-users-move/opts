# A value moved on a loop's `break` path and read after the loop is E0901, and
# its "value moved here" note points at the move the user wrote: also when the
# move sits in a nested loop or a nested branch of the breaking arm (the loop
# join used to point it one past that inner loop's or branch's end).
stdout_keep_match=error(\[E[0-9]+\])?: .*|--> [a-z_]+\.yo:[0-9]+:[0-9]+
timeout=120
