Fd :: struct(n : i32);
impl(Fd, Drop(drop : (fn(self : &mut Self) -> unit)(())));
take :: (fn(sink(f) : Fd) -> i32)(f.n);
show :: (fn(f : &Fd) -> i32)(f.n);
// The move sits in a branch nested in the breaking arm.
nested_branch :: (fn(k : i32) -> i32)({
  f := Fd(n : k);
  while(true, {
    if(k > i32(0), {
      if(k > i32(5), {
        take(f);
      }, {
        show(&f);
        take(f);
      });
      break;
    });
  });
  f.n
});
main :: (fn() -> unit)({
  nested_branch(i32(1));
});
export(main);
