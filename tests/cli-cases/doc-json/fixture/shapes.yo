//! Shape kinds and helpers.
open(import("std/string"));

/// The kind of a shape.
ShapeKind :: enum(
  /// A circle.
  Circle,
  /// A box with a label.
  Boxed(label : String)
);

/// Things that can render themselves.
Renderable :: trait(
  /// Render to a string.
  render : (fn(self : Self) -> String)
);

/// A friendly greeting.
GREETING :: "hello";

export(ShapeKind, Renderable, GREETING);
