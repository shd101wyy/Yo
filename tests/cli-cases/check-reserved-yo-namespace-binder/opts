# VERDICTS-72 rule (b): a `::` binding named in the `__yo_` namespace. Codegen
# matches `__yo_errno` by name, so the definition was accepted and every call
# read `errno` (the program printed 0, not 7) with no diagnostic. Now the
# binder itself is E0407. The golden pins the code and the binder's position.
stdout_keep=^(error\[|  --> )
timeout=120
