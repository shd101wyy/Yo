//! `yo fix . --migrate unsized` on v0.2.79 (decision 49 S3b): the code is in
//! the v0.2.79 spelling (`Box(Dyn(...))` owns, `&Dyn(...)`/`*Dyn(...)` view,
//! every erasure spells its pointer, `dyn(Box.new(v))` or `dyn(Rc.new(v))`,
//! a closure and a generic body's `dyn(Box.new(v.*))` included), so the mode
//! rewrites and lists nothing. `*Dyn(...)`, `?*Dyn(...)`, the alias body,
//! `impl(Dyn(...), ...)` and the `size_of`/`Type.eq` arguments name the
//! unsized object and stay as written; the owned `downcast` is the owning form
//! and is not listed.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array-list");
{ println } :: import("std/fmt");
Speak :: trait(speak : (fn(self : &Self) -> i32));
Loud :: trait(loud : (fn(self : &Self) -> i32));
Bump :: trait(bump : (fn(self : &mut Self) -> i32));
Cat :: struct(n : i32);
derive(Cat, Copy, Clone);
Tag :: trait(tag : (fn(self : &Self) -> i32));
impl(generic(T : Type), *T, Tag(tag : ((self : &Self) -> i32(7))));
impl(Cat, Speak(speak : ((self : &Self) -> self.n)));
impl(Cat, Loud(loud : ((self : &Self) -> (self.n * i32(10)))));
impl(Cat, Bump(bump : ((self : &mut Self) -> self.n)));
Pet :: Box(Dyn(Speak));
Zoo :: struct(pet : Box(Dyn(Speak)), spare : Option(Box(Dyn(Speak))));
impl(Dyn(Loud), Speak(speak : ((self : &Self) -> self.loud())));
_owned :: (fn(d : Box(Dyn(Speak))) -> i32)(d.speak());
_lent :: (fn(d : &Dyn(Speak)) -> i32)(d.speak());
_lent_mut :: (fn(d : &mut Dyn(Bump)) -> i32)(d.bump());
_through_ptr :: (fn(p : *Dyn(Speak)) -> i32)(p.*.speak());
_through_opt :: (fn(o : ?*Dyn(Speak)) -> i32)(match(o, .Some(p) => p.*.speak(), .None => i32(0)));
_make :: (fn(n : i32) -> Box(Dyn(Speak)))(dyn(Box.new(Cat(n : n))));
_gen_speak :: (fn(generic(T : Type), v : &T, where(T <: Speak)) -> i32)(_owned(dyn(Box.new(v.*))));
main :: (fn() -> unit)({
  z := Zoo(pet : _make(i32(1)), spare : .None);
  mut(pets) := ArrayList(Box(Dyn(Speak))).new();
  pets.push(_make(i32(2)));
  (both : Box(Dyn(Speak, Loud))) = dyn(Box.new(Cat(n : i32(3))));
  (one : Box(Dyn(Speak))) = upcast(both, Dyn(Speak));
  (handle : Rc(Dyn(Speak))) = dyn(Rc.new(Cat(n : i32(12))));
  (pet : Pet) = _make(i32(5));
  (mut(b) : Box(Dyn(Bump))) = dyn(Box.new(Cat(n : i32(6))));
  (d : Box(Dyn(Speak))) = _make(i32(7));
  (fresh : Box(Dyn(Speak))) = dyn(Box.new(Cat(n : i32(9))));
  c := Cat(n : i32(11));
  (t : Box(Dyn(Tag))) = dyn(Box.new(addr_of(c)));
  (add : Box(Dyn(Fn(x : i32) -> i32))) = dyn(Box.new(x => (x + i32(1))));
  back := match(downcast(fresh, Cat), .Ok(k) => k.n, .Err(_) => i32(0));
  comptime_assert(size_of(*Dyn(Speak)) == (usize(2) * size_of(*u8)), "a fat pointer");
  comptime_assert(Type.eq(Dyn(Speak, Loud), Dyn(Loud, Speak)), "one type");
  total := (z.pet.speak() + pets(usize(0)).speak() + one.speak() + handle.speak() + pet.speak() + _lent_mut(&mut b.*) + _lent(&d.*) + _through_opt(.None) + _owned(_make(i32(8))) + t.tag() + add(back) + _gen_speak(&c));
  println(&total);
});
export(main);
