//! `yo fix . --migrate unsized` (decision 49 S1f): every bare `Dyn(...)` type
//! spelling is written `Box(Dyn(...))`, `*Dyn(...)`, `?*Dyn(...)`, an alias
//! body and a `size_of`/`Type.eq` argument included; the wrapped and reference
//! spellings and `upcast`'s target are left alone; `Rc(Dyn(T)).new(...)` and
//! `impl(Dyn(...), ...)` are listed. The evaluation writes `dyn(v)` as
//! `dyn(Box.new(v))` (a closure too) and a `dyn(Rc.new(v))` into an owning
//! `Dyn` as `dyn(Box.new(v))`, and lists `dyn(p)` over a raw pointer and a
//! `downcast` of an owned `Dyn`.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
Speak :: trait(speak : (fn(self : &Self) -> i32));
Loud :: trait(loud : (fn(self : &Self) -> i32));
Bump :: trait(bump : (fn(self : &mut Self) -> i32));
Cat :: struct(n : i32);
derive(Cat, Copy, Clone);
Tag :: trait(tag : (fn(self : &Self) -> i32));
impl(generic(T : Type), *T, Tag(tag : ((self : &Self) -> i32(7))));
impl(Cat, Speak(speak : ((self : &Self) -> self.n)));
impl(Cat, Loud(loud : ((self : &Self) -> (self.n * i32(10)))));
impl(Cat, Bump(bump : ((self : &mut Self) -> self.n)));
Pet :: Dyn(Speak);
Zoo :: struct(pet : Dyn(Speak), spare : Option(Dyn(Speak)));
impl(Dyn(Loud), Speak(speak : ((self : &Self) -> self.loud())));
_owned :: (fn(d : Dyn(Speak)) -> i32)(d.speak());
_lent :: (fn(d : &Dyn(Speak)) -> i32)(d.speak());
_lent_mut :: (fn(d : &mut Dyn(Bump)) -> i32)(d.bump());
_through_ptr :: (fn(p : *Dyn(Speak)) -> i32)(p.*.speak());
_through_opt :: (fn(o : ?*Dyn(Speak)) -> i32)(match(o, .Some(p) => p.*.speak(), .None => i32(0)));
_make :: (fn(n : i32) -> Dyn(Speak))(dyn(Cat(n : n)));
main :: (fn() -> unit)({
  z := Zoo(pet : _make(i32(1)), spare : .None);
  mut(pets) := ArrayList(Dyn(Speak)).new();
  pets.push(_make(i32(2)));
  (both : Dyn(Speak, Loud)) = dyn(Cat(n : i32(3)));
  (one : Dyn(Speak)) = upcast(both, Dyn(Speak));
  shared := Rc(Dyn(Speak)).new(_make(i32(4)));
  (pet : Pet) = _make(i32(5));
  (mut(b) : Dyn(Bump)) = dyn(Cat(n : i32(6)));
  (d : Dyn(Speak)) = _make(i32(7));
  (fresh : Dyn(Speak)) = dyn(Rc.new(Cat(n : i32(9))));
  c := Cat(n : i32(11));
  (t : Dyn(Tag)) = dyn(addr_of(c));
  (add : Dyn(Fn(x : i32) -> i32)) = dyn(x => (x + i32(1)));
  back := match(downcast(fresh, Cat), .Some(k) => k.n, .None => i32(0));
  comptime_assert(size_of(Dyn(Speak)) == (usize(2) * size_of(*u8)), "a fat pointer");
  comptime_assert(Type.eq(Dyn(Speak, Loud), Dyn(Loud, Speak)), "one type");
  total := (z.pet.speak() + pets(usize(0)).speak() + one.speak() + shared.speak() + pet.speak() + _lent_mut(&mut b) + _lent(&d) + _through_ptr(addr_of(d)) + _through_opt(.None) + _owned(_make(i32(8))) + t.tag() + add(back));
  println(&total);
});
export(main);
