// A garbage cycle leaks: there is no cycle collector (decision 48 W6b), and
// the `--debug-heap` report counts the two cells at exit. A `Weak` on the back
// edge is the remedy (docs/en-US/WEAK.md).
{ println } :: import("std/fmt");
{ RefCell } :: import("std/sync/refcell");
(mut(g_disposed) : i32) = i32(0);
// Two shared cells written after construction: `Rc` handles, each edge in a
// `RefCell`.
_PairVal :: struct(
  value : i32,
  other : RefCell(Option(Rc(Self)))
);
Pair :: Rc(_PairVal);
_pair :: (fn(value : i32, other : Option(Pair)) -> Pair)(
  Rc.new(_PairVal(value : value, other : RefCell(Option(Pair)).new(other)))
);
impl(
  _PairVal,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_disposed = (g_disposed + i32(1));
    })
  )
);
make_cycle :: (fn() -> unit)({
  a := _pair(i32(1), .None);
  b := _pair(i32(2), .Some(Rc.clone(&a)));
  a.other.replace(.Some(b)); // a <-> b, unreachable after return
});
test("a garbage cycle", {
  make_cycle();
  disposed := g_disposed;
  println(`cycle: disposed ${disposed.to_string()}`);
});
