// `check` of a test body that defines a recursive local fn with an `Impl(Fn)`
// parameter. The test-body trial inherited the module's `is_executing`, so the
// call ran `recur` at compile time on an unknown depth and grew without bound
// (a 48 GB footprint on tests/closure_param_forwarding.test.yo).
// issues/fixed/check-of-a-test-body-with-a-recursive-soft-generic-local-fn-grows-without-bound.md
{ assert } :: import("std/assert");
test("a recursive soft-generic local fn", {
  w2 :: (fn(depth : i32, imm(get_info) : Impl(Fn(k : i32) -> i32)) -> i32)(
    cond((depth <= i32(0)) => i32(0), true => (get_info(depth) + recur(depth - i32(1), get_info)))
  );
  assert(w2(i32(2), (k : i32) => (k + i32(1))) == i32(5), "3 + 2");
});
