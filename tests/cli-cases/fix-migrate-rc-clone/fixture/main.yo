//! `yo fix --migrate rc-clone` (plans/VALUES_BY_DEFAULT.md decision 17): a
//! copy of an `Rc`/`Arc` handle whose source stays alive is spelled
//! `Rc.clone(h)` / `Arc.clone(h)`, a copy of a value holding one `.clone()`,
//! and a closure that captures a handle the caller reads again gets a capture
//! list. A last use (a move) is left alone; a value holding a handle whose
//! type is not `Clone` is listed.
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
Node :: struct(label : Rc(i32), weight : i32);
derive(Node, Clone);
Bare :: struct(h : Rc(i32));
keep :: (fn(h : &Rc(i32)) -> Rc(i32))(h);
label_of :: (fn(n : &Node) -> Rc(i32))(n.label);
total :: (fn(h : Rc(i32), k : i32) -> i32)(h.* + k);
main :: (fn() -> unit)({
  a := rc(i32(1));
  b := a;
  xs := ArrayList(Rc(i32)).new();
  xs.push(a);
  n := Node(label : b, weight : i32(2));
  m := n;
  l := label_of(&n);
  k := keep(&l);
  o := Option(Rc(i32)).Some(k);
  o2 := o;
  t := total(l, i32(3));
  (f : Impl(Fn() -> i32)) = (() => k.*);
  (g : Impl(Fn() -> i32)) = ({ k }() => k.*);
  s := arc(i32(4));
  s2 := s;
  bare := Bare(h : rc(i32(5)));
  bare2 := bare;
  last := rc(i32(6));
  moved := last;
  println(`${a.*} ${b.*} ${m.weight} ${n.label.*} ${l.*} ${o.is_some()} ${o2.is_some()} ${t} ${f()} ${g()} ${k.*} ${s.*} ${s2.*} ${bare.h.*} ${bare2.h.*} ${moved.*} ${xs.len()}`);
});
export(main);
