//! `yo fix --migrate rc-clone` (plans/VALUES_BY_DEFAULT.md decision 17): a
//! copy of an `Rc`/`Arc` handle whose source stays alive is spelled
//! `Rc.clone(h)` / `Arc.clone(h)`, a copy of a value holding one `.clone()`,
//! and a closure that captures a handle the caller reads again gets a capture
//! list, unless the closure is lent to a borrowing parameter (it borrows its
//! captures), or one whose later read is inside a closure that borrows its
//! captures (`w.with(c => … cell.* …)`). A `match` on a field holding a handle
//! borrows it, with `&mut` when an arm writes through a binding (`fill`); a
//! `match` on a module-level binding clones it (`last_of`: a borrow of a
//! module-level place may not live across the arm's calls), and so does one
//! whose arm writes the scrutinee (`refresh`). A copy inside a loop whose
//! next iteration reads the source is cloned even when the loop body writes
//! it on another path (`walk`). A last use (a move) is left alone; a value
//! holding a handle whose type is not `Clone` is listed. A `match` on a
//! `&` parameter already borrows and is left alone, in a loop too (`hits`).
//! A record's shorthand field `{ sh }` names its source, so its clone is
//! spelled `{ sh : Rc.clone(sh) }`.
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ RefCell } :: import("std/sync/refcell");
Node :: struct(label : Rc(i32), weight : i32);
derive(Node, Clone);
Bare :: struct(h : Rc(i32));
keep :: (fn(h : &Rc(i32)) -> Rc(i32))(h);
label_of :: (fn(n : &Node) -> Rc(i32))(n.label);
total :: (fn(h : Rc(i32), k : i32) -> i32)(h.* + k);
Holder :: struct(slot : Option(Rc(i32)));
peek :: (fn(h : &Holder) -> i32)(match(h.slot, .Some(r) => r.*, .None => i32(0)));
mut(g_last) := Option(Rc(i32)).Some(Rc.new(i32(10)));
last_of :: (fn() -> i32)(match(g_last, .Some(h) => total(h, i32(0)), .None => i32(0)));
walk :: (fn(start : Rc(i32)) -> Rc(i32))({
  mut(cur) := start;
  mut(out) := Rc.new(i32(0));
  mut(done) := false;
  while(!done, {
    if(cur.* > i32(2), {
      out = cur;
      done = true;
    }, {
      cur = Rc.new(cur.* + i32(1));
    });
  });
  out
});
Bag :: struct(h : Rc(i32), items : ArrayList(i32));
fill :: (fn(b : Bag) -> usize)({
  mut(bb) := b;
  match(bb, { items : xs } => {
    xs.push(i32(1));
  });
  bb.items.len() + usize(bb.h.*)
});
refresh :: (fn(o : Option(Rc(i32))) -> bool)({
  mut(x) := o;
  match(
    x,
    .Some(h) => {
      x = Option(Rc(i32)).Some(h);
    },
    .None => ()
  );
  x.is_some()
});
hits :: (fn(h : &Option(Rc(i32)), n : i32) -> i32)({
  mut(i) := i32(0);
  mut(sum) := i32(0);
  while(i < n, {
    match(
      h,
      .Some(r) => {
        sum = (sum + r.*);
      },
      .None => ()
    );
    i = (i + i32(1));
  });
  sum
});
main :: (fn() -> unit)({
  a := Rc.new(i32(1));
  b := a;
  xs := ArrayList(Rc(i32)).new();
  xs.push(a);
  n := Node(label : b, weight : i32(2));
  m := n;
  l := label_of(&n);
  k := keep(&l);
  o := Option(Rc(i32)).Some(k);
  o2 := o;
  t := total(l, i32(3));
  (f : Impl(Fn() -> i32)) = (() => k.*);
  (g : Impl(Fn() -> i32)) = ({ k }() => k.*);
  s := Arc.new(i32(4));
  s2 := s;
  bare := Bare(h : Rc.new(i32(5)));
  bare2 := bare;
  last := Rc.new(i32(6));
  moved := last;
  w := RefCell(i32).new(i32(7));
  u := w.with(c => (c + total(a, i32(0))));
  p := peek(&Holder(slot : .Some(Rc.new(i32(8)))));
  cell := Rc.new(i32(9));
  pair := Node(label : cell, weight : i32(0));
  v := w.with(c => (c + cell.*));
  q := ((last_of() + walk(Rc.new(i32(1))).*) + if(refresh(.Some(Rc.new(i32(11)))), i32(1), i32(0)));
  r := fill(Bag(h : Rc.new(i32(1)), items : ArrayList(i32).new()));
  hs := hits(&Option(Rc(i32)).Some(Rc.new(i32(2))), i32(3));
  sh := Rc.new(i32(12));
  rec := { sh };
  println(`${a.*} ${b.*} ${m.weight} ${n.label.*} ${l.*} ${o.is_some()} ${o2.is_some()} ${t} ${f()} ${g()} ${k.*} ${s.*} ${s2.*} ${bare.h.*} ${bare2.h.*} ${moved.*} ${xs.len()} ${u} ${p} ${pair.weight} ${v} ${q} ${r} ${hs} ${rec.sh.*} ${sh.*}`);
});
export(main);
