# Brace groups (plans/reference/BRACE_BLOCKS.md): a bare expression brace with
# a `label : value` pair is E0007, repaired by inserting the dot (the record
# `.{ ... }`); a dot on the binding side is E0007 too, repaired by deleting
# it. One repair per pass. The expected_tree pins the rewritten file; rc=0
# because the repaired file then evaluates.
stdout_keep=^fix:
timeout=180
