//! `yo fix --migrate explicit-copy` follows a copy through the locals it is
//! stored in. `x := entry.no; target := x; target.insert(v, v)` copies the
//! entry's map into `x` and writes it through `target`, which shares `x`'s
//! map on purpose, so the insert lands in the entry: those copies are listed,
//! not cloned, and the run prints `3 2 2 2`. `peek` never writes the local
//! its copy is moved into, so that copy is still cloned. The maps are
//! `BTreeMap`s (still a `ref`, so a copy dups the handle; decision Option 1 of
//! issues/questions/2026-10-27-what-the-implicit-copy-audit-and-the-explicit-copy-migration-cover-after-b8.md).
{ ArrayList } :: import("std/collections/array_list");
{ BTreeMap } :: import("std/collections/btree_map");
{ println } :: import("std/fmt");
Entry :: ref(
  struct(
    yes : BTreeMap(i32, i32),
    no : BTreeMap(i32, i32)
  )
);
first :: (fn(entries : &ArrayList(Entry)) -> Entry)(
  match(
    entries.get(usize(0)),
    .Some(existing) => existing,
    .None => Entry(yes : BTreeMap(i32, i32).new(), no : BTreeMap(i32, i32).new())
  )
);
straight :: (fn(entries : &ArrayList(Entry), v : i32) -> unit)({
  entry := first(entries);
  x := entry.no;
  mut(target) := x;
  target.insert(v, v);
});
block_tail :: (fn(entries : &ArrayList(Entry), v : i32) -> unit)({
  entry := first(entries);
  mut(target) := {
    x := entry.yes;
    x
  };
  target.insert(v, v);
});
arm_tail :: (fn(entries : &ArrayList(Entry), negated : bool, v : i32) -> unit)({
  entry := first(entries);
  mut(target) := if(negated, {
    x := entry.no;
    x
  }, entry.yes);
  target.insert(v, v);
});
assigned :: (fn(entries : &ArrayList(Entry), v : i32) -> unit)({
  entry := first(entries);
  x := entry.yes;
  mut(target) := BTreeMap(i32, i32).new();
  target = x;
  target.insert(v, v);
});
source_moved :: (fn(v : i32) -> usize)({
  mut(list) := BTreeMap(i32, i32).new();
  list.insert(v, v);
  snapshot := list;
  mut(target) := list;
  target.insert(v + i32(1), v);
  snapshot.len()
});
peek :: (fn(entries : &ArrayList(Entry)) -> usize)({
  entry := first(entries);
  x := entry.no;
  seen := x;
  seen.len()
});
main :: (fn() -> unit)({
  mut(entries) := ArrayList(Entry).new();
  entries.push(Entry(yes : BTreeMap(i32, i32).new(), no : BTreeMap(i32, i32).new()));
  straight(&entries, i32(1));
  block_tail(&entries, i32(2));
  arm_tail(&entries, true, i32(3));
  arm_tail(&entries, false, i32(4));
  assigned(&entries, i32(5));
  e := first(&entries);
  println(`${e.yes.len().to_string()} ${e.no.len().to_string()} ${source_moved(i32(6)).to_string()} ${peek(&entries).to_string()}`);
});
export(main);
