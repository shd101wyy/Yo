# A binding named by a builtin the dispatch reaches by spelling (maintainer,
# 2026-11-27, option 1 of issues/fixed/builtin-name-shadows-user-definition.md).
# The parameter `law` was accepted and `law(f)` ran the contract builtin, not
# the argument. Now the binder is E0407 with a help line naming the builtin
# and the rename. `law(...)` heads a call in its body, so the use cannot be
# told from the builtin and the diagnostic carries no repair.
stdout_keep=^(error\[|  --> |help: )
timeout=120
