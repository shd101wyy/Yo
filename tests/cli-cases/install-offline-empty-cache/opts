# (The harness rewrites a 40-hex commit to <SHA1> before filtering.)
# `--offline` with a complete yo.lock but an EMPTY cache (the sandbox HOME is
# fresh): the locked commit is known without the network, the tree is not, and
# cloning it would need the network — so the run fails (rc 1) naming the
# package and the commit instead of cloning.
timeout=600
stdout_keep_match=Error: --offline: "remote" \(\./remote\.git @ <SHA1>\) is not in the cache
