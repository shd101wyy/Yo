{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
g_outer := ArrayList(ArrayList(i32)).new();
grow_global :: (fn() -> unit)({
  inner := match(g_outer.get(usize(0)), .Some(x) => x, .None => ArrayList(i32).new());
  i := usize(0);
  while(i < usize(4096), {
    inner.push(i32(0));
    i = (i + usize(1));
  });
});
bump :: (fn(inout(v) : i32) -> unit)({
  grow_global(); // reaches `xs` through the global while `v` borrows into it
  v = i32(99);
});
main :: (fn() -> unit)({
  xs := ArrayList(i32).new();
  xs.push(i32(41));
  g_outer.push(xs); // `xs` escapes into a module-level heap structure
  bump(xs(usize(0))); // element-only inout arg — allowed by the static place rule
  assert(xs(usize(0)) == i32(99), "unreachable: push must panic first");
});
export(main);
