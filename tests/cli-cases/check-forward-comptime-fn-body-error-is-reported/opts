# A type error in the body of a comptime fn that captures a forward-declared
# comptime fn (mutual recursion) is reported once the forward declaration is
# filled, instead of being dropped by the pending re-run
# (issues/fixed/a-forward-comptime-fn-body-error-is-dropped-by-the-pending-rerun.md).
stdout_keep_match=error\[E[0-9]+\]|--> main\.yo:[0-9]+:[0-9]+
timeout=120
