{ String } :: import("std/string");
{ Exception, AnyError } :: import("std/error");
{ println } :: import("std/fmt");
// The unknown name sits INSIDE dyn(...): as a throw payload and as a fn's
// tail value.
fail_unknown :: (fn(exn : Exception) -> unit)({
  exn.throw(dyn(totally_unknown_fn()));
});
make_err :: (fn() -> AnyError)(
  dyn(String.from(totally_unknown_fn()))
);
main :: (fn() -> unit)({
  println("ok");
});
export(main);
