# `yo fix` applies E0407's rename repair: the binder named by a builtin
# (`ghost`, a parameter; `old`, a local) and every use its syntactic scope
# gives it become `ghost_` / `old_` in one repair each. The field label
# `p.ghost` and the named argument `P(ghost : ...)` are not uses and keep
# their spelling. The expected_tree pins the rewritten file, and rc 0 says
# the rewritten file evaluates.
stdout_keep=^fix:
timeout=240
