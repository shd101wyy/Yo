# The chunk-compile memory cap (plans/BUILD_ON_8GB_MACHINES.md Phase 3): with
# `--jobs` left at its default, the number of concurrent chunk compiles is
# lowered to what half of physical memory fits at the largest unit's estimated
# clang peak (`_chunk_jobs_for_memory`). `YO_ASSUME_MEMORY_MB=100` makes that one
# job; an explicit `--jobs 4` is kept as given. The summary line's `jobs=` is the
# assertion.
env=YO_ASSUME_MEMORY_MB=100
stdout_keep=^(chunks: |Using )
timeout=300
