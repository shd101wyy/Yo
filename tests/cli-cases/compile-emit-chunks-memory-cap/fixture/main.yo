{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
Item :: struct(label : String, n : i64);
derive(Item, Clone);
main :: (fn() -> unit)({
  mut(xs) := ArrayList(Item).new();
  xs.push(Item(label : String.from("a"), n : i64(2)));
  xs.push(Item(label : String.from("b"), n : i64(40)));
  (mut(total) : i64) = i64(0);
  (mut(i) : usize) = usize(0);
  while(i < xs.len(), {
    match(
      xs.get_cloned(i),
      .Some(it) => {
        total = (total + it.n);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  println(`total=${total.to_string()}`);
});
export(main);
