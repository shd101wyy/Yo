# A type-unification failure must be anchored at the EXPRESSION that failed
# to unify — here the `i32(2)` argument of `count + i32(2)` on line 4 — not at
# the synthesizer's synthetic row 0 / column 0, which put the CLI's `-->`
# anchor (and the LSP's squiggle) on the first character of the file
# (issues/fixed/unify-errors-carry-a-synthetic-token-so-editors-show-them-at-0-0.md).
# Both the anchor line and the message are pinned.
stdout_keep_match=(--> main\.yo:[0-9]+:[0-9]+|Cannot unify incompatible types: "[a-zA-Z0-9_]+" and "[a-zA-Z0-9_]+")
timeout=120
