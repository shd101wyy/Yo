# `yo fix <path> --migrate dyn-spelling` over a file whose ONLY bare sites
# are closure literals (binding, field, argument, result): the migration
# wraps all four in one run, reports the file as evaluated and exits 0
# (issues/fixed/yo-fix-migrate-dyn-spelling-reports-a-literal-only-file-as-not-evaluating.md).
# The expected_tree pins the rewritten main.yo; the trailing `check` proves no
# bare site is left.
stdout_keep=^fix:
timeout=180
