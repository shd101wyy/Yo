# `yo fix <path> --migrate dyn-spelling` over a file whose ONLY bare sites
# are closure literals (binding, field, argument, generic method argument,
# result): the migration wraps all five in one run, reports the file as
# evaluated and exits 0
# (issues/fixed/yo-fix-migrate-dyn-spelling-stops-at-the-first-site-that-is-not-a-named-closure.md).
# The expected_tree pins the rewritten main.yo; the trailing `check` proves no
# bare site is left.
stdout_keep=^fix:
timeout=180
