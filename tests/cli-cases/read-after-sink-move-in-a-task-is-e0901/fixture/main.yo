{ ArrayList } :: import("std/collections/array_list");
Thing :: ref(struct(n : i32));
(g_kept : ArrayList(Thing)) = ArrayList(Thing).new();
keep :: (fn(sink(t) : Thing) -> unit)({
  g_kept.push(t);
});
task :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(1));
    keep(t);
    t.n
  })
);
main :: (fn(io : Io) -> unit)({
  r := io.await(task(io), io);
});
export(main);
