# A failure INSIDE a match scrutinee must report its own diagnostic, not the
# generic "Failed to evaluate the match scrutinee expression"
# (plans/LLM_FRIENDLY_TOOLCHAIN_AND_SYNTAX.md §3). A place-expression
# scrutinee is evaluated through the exn-less entry point, so its error never
# reached the match frame and the generic message replaced it — measured
# 2026-09-16: an undefined name reported the generic text while a call
# scrutinee reported its real type error.
#
# stdout_keep_match asserts the REAL error (the name), which is what a model
# needs to fix the program; a case that merely checked rc would pass on the
# generic message too.
stdout_keep_match=not found
timeout=120
