{ Thread } :: import("std/thread");
{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
mut(g) := ArrayList(i32).new();
fill :: (fn() -> unit)({
  mut(g2) := g.clone();
  g2.push(i32(1));
  g = g2;
});
main :: (fn() -> unit)({
  fill();
  t := Thread(unit).spawn((io : Io) => {
    fill();
    ()
  });
  t.join();
  println(`len=${g.len()}`);
});
export(main);
