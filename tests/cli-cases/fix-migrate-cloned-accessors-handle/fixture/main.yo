// `yo fix <path> --migrate cloned-accessors` also rewrites a copying accessor
// whose result holds a counted handle (decision 17): the std reader copies
// the handle out of `&Self`, which is E0901 at the call, and `get_cloned` is
// the retain the copy made before. `h.clone()` is no accessor (its result is
// its receiver's own type, not an element): it stays as written.
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
{ HashMap } :: import("std/collections/hash_map");
H :: enum(Held(r : Rc(i32)), Empty);
derive(H, Clone);
main :: (fn() -> unit)({
  mut(xs) := ArrayList(Rc(i32)).new();
  xs.push(Rc.new(i32(2)));
  mut(m) := HashMap(i32, Rc(i32)).new();
  m.insert(i32(1), Rc.new(i32(3)));
  a := xs.get(usize(0));
  b := m.get(&i32(1));
  h := H.Held(r : Rc.new(i32(4)));
  h2 := h.clone();
  assert(match(h2, .Held(r) => (r.* == i32(4)), .Empty => false), "a second H");
  match(
    (a, b),
    (.Some(x), .Some(y)) => assert((x.* + y.*) == i32(5), "two second handles"),
    _ => assert(false, "both present")
  );
});
export(main);
