# `yo fix <path> --migrate cloned-accessors` rewrites a copying accessor call
# whose result holds a counted handle to its `<name>_cloned` sibling:
# `xs.get(...)` at an `Rc` element is E0901 once std's generic readers are
# judged (V2c's follow-up), and `xs.get_cloned(...)` is the retain the copy
# made before. The trailing `check` proves the rewritten file evaluates.
stdout_keep=^(fix:|check: main\.yo)
timeout=240
