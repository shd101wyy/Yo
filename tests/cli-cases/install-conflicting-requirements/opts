# CONFLICT: the root wants util "^2", app_lib wants util "^1" — no tag
# satisfies both, and one flat import namespace means one version per name.
# `yo install` must fail (rc 1) naming the package, the repository and EVERY
# requirer with what it asked for, not pick one silently.
timeout=600
stdout_keep_match=(no tag of \./util\.git satisfies every requirement on "util"|<root> requires version "\^2"|app_lib requires version "\^1")
