//! `Sized`, `?Sized` and the unsized `[T]` (plans/VALUES_BY_DEFAULT.md
//! decision 49, S1): `Sized` is a derived marker; every `generic(T : Type)`
//! and `comptime(V) : Type` binder carries `where(T <: Sized)` implicitly, and
//! `?Sized` in a binder's kind slot drops it. `[T]` (`Slice(T)`) is unsized:
//! any by-value use of it, or of a `?Sized` variable, is E0619 — at the use
//! for a concrete type, at the definition for a `?Sized` binder.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ Fnv1aHasher } :: import("std/hash");

Show :: trait(show : (fn(self : &Self) -> i32));
_SzPoint :: struct(x : i32, y : i32);
impl(_SzPoint, Show(show : (fn(self : &Self) -> i32)(self.x + self.y)));
impl(i32, Show(show : (fn(self : &Self) -> i32)(self.*)));

// A `?Sized` generic: `T` is used only behind the reference.
_sz_show :: (fn(generic(T : ?Sized), x : &T, where(T <: Show)) -> i32)(x.show());
_sz_id_ref :: (fn(generic(T : ?Sized), x : &T) -> &T)(&x.*);
// A tail struct: only the last field may be unsized.
_SzTail :: struct(n : i32, rest : [i32]);
// A type constructor whose binder is `?Sized`.
_SzPtr :: (fn(comptime(V) : ?Sized) -> comptime(Type))(struct(p : *V));
_SzBox :: (fn(comptime(V) : Type) -> comptime(Type))(struct(p : *V));
// A `Type` binder: implicitly `where(U <: Sized)`.
_sz_sized_only :: (fn(generic(U : Type), y : &U) -> i32)(i32(1));

test("[T] is the builtin Slice(T)", {
  assert(type_id(Slice(i32)) == type_id([i32]), "[i32] and Slice(i32) are one type");
  assert(type_id(Slice(i32)) != type_id([u8]), "the element is part of the type");
});

test("Sized is derived from the type's structure", {
  comptime_assert(Type.impls(i32, Sized), "a primitive is Sized");
  comptime_assert(Type.impls(_SzPoint, Sized), "a struct of sized fields is Sized");
  comptime_assert(Type.impls(Array(i32, 4), Sized), "a fixed-size array is Sized");
  // `Type.impls` takes a `Type`, which is sized: the unsized rows ask
  // through a `Type` binder instead (E0619).
  comptime_expect_error(_SzBox([i32]), "is not `Sized`");
  comptime_expect_error(_SzBox(_SzTail), "is not `Sized`");
  comptime_assert(Type.impls(*[i32], Sized), "a pointer to an unsized type is Sized");
  comptime_assert(Type.impls(_SzPtr([i32]), Sized), "a struct holding such a pointer is Sized");
});

test("Sized is never implemented by hand", {
  comptime_expect_error(impl([i32], Sized()), "never implemented by hand");
  comptime_expect_error(impl(_SzPoint, !Sized), "never implemented by hand");
});

test("a ?Sized generic is called at sized types", {
  p := _SzPoint(x : i32(2), y : i32(3));
  assert(_sz_show(&p) == i32(5), "a struct through the where-bound");
  n := i32(9);
  assert(_sz_show(&n) == i32(9), "a primitive through the where-bound");
  assert(_sz_id_ref(&n).* == i32(9), "a ?Sized projection returns the place");
});

test("a ?Sized type constructor takes an unsized argument", {
  comptime_assert(Type.impls(_SzPtr(i32), Sized), "at a sized argument");
  comptime_assert(Type.impls(_SzPtr([u8]), Sized), "at [u8]");
  comptime_expect_error(_SzBox([u8]), "is not `Sized`");
  comptime_expect_error(_SzBox([u8]), "?Sized");
});

test("an unsized type by value is E0619", {
  comptime_expect_error(size_of(Slice(i32)), "is not `Sized`");
  comptime_expect_error(size_of(_SzTail), "is not `Sized`");
  comptime_expect_error(align_of([i32]), "`align_of`");
  comptime_expect_error(Option([i32]), "is not `Sized`");
  comptime_expect_error(ArrayList([i32]), "is not `Sized`");
  comptime_expect_error(Array([i32], 2), "an array element");
  comptime_expect_error(Slice([i32]), "a slice element");
  comptime_expect_error(Tuple(i32, [i32]), "a tuple element");
  comptime_expect_error(struct(a : [i32], b : i32), "not the struct's last");
  comptime_expect_error(enum(A(v : [i32]), B), "the payload");
  comptime_expect_error((fn(x : [i32]) -> unit)(()), "the by-value parameter");
  comptime_expect_error((fn(x : &i32) -> [i32])(x), "a by-value result");
});

_SzSpeak :: trait(sz_speak : (fn(self : &Self) -> i32));
test("a bare Dyn by value is E0619 and names the v0.2.77 migration", {
  comptime_expect_error(Option(Dyn(_SzSpeak)), "is not `Sized`");
  comptime_expect_error(Option(Dyn(_SzSpeak)), "yo version install 0.2.77 && yo fix <path> --migrate unsized");
  comptime_expect_error(struct(a : Dyn(_SzSpeak), b : i32), "--migrate unsized");
  comptime_assert(Type.impls(Option(Box(Dyn(_SzSpeak))), Sized), "the owning box is sized");
});

test("Type.eq, Type.neq and Type.impls take an unsized type", {
  comptime_assert(Type.eq(Dyn(_SzSpeak, Clone), Dyn(Clone, _SzSpeak)), "one Dyn type");
  comptime_assert(Type.neq([i32], [u8]), "two slice types");
  comptime_assert(!Type.impls([u8], Sized), "a slice is not Sized");
  comptime_assert(!Type.impls(Dyn(_SzSpeak), Sized), "a Dyn is not Sized");
});

test("a ?Sized binder used by value is E0619 at the definition", {
  comptime_expect_error(
    (fn(generic(T : ?Sized), x : &T) -> unit)({
      _y := x.*;
    }),
    "is not `Sized`"
  );
  comptime_expect_error((fn(generic(T : ?Sized), x : &T) -> T)(x.*), "a by-value result");
  comptime_expect_error((fn(generic(T : ?Sized), x : T) -> unit)(()), "the by-value parameter");
  comptime_expect_error((fn(generic(T : ?Sized), x : &T) -> usize)(size_of(T)), "`size_of`");
  comptime_expect_error((fn(generic(T : ?Sized), x : &T) -> bool)(Option(T).None.is_none()), "?Sized");
});

test("a ?Sized variable at a Type binder is E0619 naming ?Sized", {
  comptime_expect_error((fn(generic(T : ?Sized), x : &T) -> i32)(_sz_sized_only(x)), "?Sized");
});

test("?Sized is a binder's kind only", {
  comptime_expect_error((fn(x : ?Sized) -> unit)(()), "kind of a type binder");
});

// Coherence rule 3 (decision 49): a blanket over a `Type` binder covers the
// sized types only, so it neither applies to nor overlaps an impl on `[T]`;
// a blanket over a `?Sized` binder covers both.
_CoMark :: trait(co : (fn(self : &Self) -> i32));
impl(generic(T : Type), T, _CoMark(co : (fn(self : &Self) -> i32)(i32(1))));
impl([i32], _CoMark(co : (fn(self : &Self) -> i32)(i32(2))));
_CoAll :: trait(co_all : (fn(self : &Self) -> i32));
impl(generic(T : ?Sized), T, _CoAll(co_all : (fn(self : &Self) -> i32)(i32(3))));

test("a blanket over a Type binder covers the sized types only", {
  n := i32(5);
  assert(n.co() == i32(1), "the blanket covers i32");
  // `[i32]` has its own `_CoMark` impl beside the Type blanket (module
  // level: no overlap error). The overlap row for a `?Sized` blanket waits on
  // issues/2026-11-11-a-generic-blanket-impl-does-not-overlap-an-impl-on-an-array-or-slice.md.
});

// A method call on a `&[T]` finds the slice's own impl: `[T]` registers its
// impls under its element's id (decision 49 S2,
// issues/fixed/2026-11-10-a-method-call-on-a-reference-to-a-slice-does-not-find-an-impl-on-the-slice.md).
test("a method call on a &[T] finds the impl on the slice", {
  a := Array(i32, 2)(1, 2);
  s := unsize(&a);
  assert(s.co() == i32(2), "the slice's own impl, not the sized blanket");
  assert(s.co_all() == i32(3), "the ?Sized blanket");
});

// A `where` on a `?Sized` type-constructor binder (decision 49 S2): the
// binder is bound to its type variable, so the bound attaches.
_SzBound :: (fn(comptime(V) : ?Sized, where(V <: Show)) -> comptime(Type))(struct(p : *V));
impl([i32], Show(show : (fn(self : &Self) -> i32)(i32(__yo_slice_len(self)))));
test("a where on a ?Sized type-constructor binder", {
  comptime_assert(Type.impls(_SzBound(i32), Sized), "a sized argument meets the bound");
  comptime_assert(Type.impls(_SzBound([i32]), Sized), "an unsized argument meets the bound");
  comptime_expect_error(_SzBound(bool), "Show");
});

_sz_hash :: (fn(s : &[i32]) -> u64)({
  mut(h) := Fnv1aHasher.new();
  s.hash(&mut h);
  h.finish()
});
_sz_eq :: (fn(a : &[i32], b : &[i32]) -> bool)(a.* == b.*);
test("the slice's own impls: len, is_empty, contains, Eq, Hash", {
  a := Array(i32, 3)(1, 2, 3);
  b := Array(i32, 3)(1, 2, 3);
  c := Array(i32, 2)(1, 2);
  s := unsize(&a);
  assert(s.len() == usize(3), "len");
  assert(!s.is_empty(), "is_empty");
  two := i32(2);
  nine := i32(9);
  assert(s.contains(&two), "contains a member");
  assert(!s.contains(&nine), "not a non-member");
  assert(_sz_eq(unsize(&a), unsize(&b)), "equal slices");
  assert(!_sz_eq(unsize(&a), unsize(&c)), "a different length is unequal");
  assert(_sz_hash(unsize(&a)) == _sz_hash(unsize(&b)), "equal slices hash alike");
  assert(_sz_hash(unsize(&a)) != _sz_hash(unsize(&c)), "the length is hashed");
});

mut(_SZ_CLONED) := i32(0);
_SzCl :: struct(n : i32);
impl(
  _SzCl,
  Clone(
    clone : (fn(self : &Self) -> Self)({
      _SZ_CLONED = (_SZ_CLONED + i32(1));
      _SzCl(n : self.n)
    })
  )
);
test("CloneInto clones each element of a slice into an uninitialized run", {
  a := Array(_SzCl, 3)(_SzCl(n : i32(4)), _SzCl(n : i32(5)), _SzCl(n : i32(6)));
  mut(b) := Array(_SzCl, 3)(_SzCl(n : i32(0)), _SzCl(n : i32(0)), _SzCl(n : i32(0)));
  before := _SZ_CLONED;
  dst := unsafe(__yo_slice_from_raw_parts(addr_of(b(usize(0))), usize(3)));
  // The run is overwritten without a drop: its old elements own nothing.
  ([_SzCl] <: CloneInto).clone_into(unsize(&a), dst);
  assert(_SZ_CLONED == (before + i32(3)), "one clone per element");
  assert((b(usize(0)).n + b(usize(1)).n + b(usize(2)).n) == i32(15), "the clones landed in order");
});
// A `?Sized`-kinded constructor parameter prints with no mode, as a `Type`
// one does (issues/fixed/2026-11-13-a-sized-kinded-constructor-parameter-prints-as-a-borrow.md).
_SzPrintK :: (fn(comptime(V) : ?Sized) -> comptime(Type))(newtype(p : Option(i32)));
test("a ?Sized constructor parameter prints with no mode", {
  comptime_expect_error({
    (a : i32) = _SzPrintK;
  }, "Given   : fn(V : ?Sized) -> Type");
});
// A reference type passed to a `?Sized` parameter keeps its `&`, as at a
// `Type` one: `Eq(&C)` is the trait over `&C`, not `Eq(C)`
// (issues/fixed/2026-11-14-a-reference-type-argument-at-a-sized-kinded-parameter-loses-its-reference.md).
// The impl takes a DIFFERENT reference Rhs: `impl(&C, Eq(&C))` beside the
// prelude's blanket `impl(&T, Eq(&T))` is E0612 by coherence, so that shape
// is the blanket's alone; this row must hold with and without that blanket.
_SzId :: (fn(comptime(V) : ?Sized) -> comptime(Type))(V);
_SzEqA :: struct(n : i32);
_SzEqB :: struct(m : i32);
impl(
  _SzEqA,
  Eq(&_SzEqB)(
    (==) : (fn(lhs : &Self, rhs : & &_SzEqB) -> bool)(lhs.*.n == rhs.*.*.m),
    (!=) : (fn(lhs : &Self, rhs : & &_SzEqB) -> bool)(lhs.*.n != rhs.*.*.m)
  )
);
test("a reference type argument at a ?Sized parameter keeps its reference", {
  comptime_assert(Type.eq(_SzId(&i32), &i32), "`&i32` stays `&i32`");
  comptime_assert(Type.eq(_SzId(&mut i32), &mut i32), "`&mut i32` stays `&mut i32`");
  comptime_assert(!Type.eq(Eq(&_SzEqA), Eq(_SzEqA)), "`Eq(&C)` is not `Eq(C)`");
  comptime_assert(Type.impls(_SzEqA, Eq(&_SzEqB)), "an impl over a reference Rhs registers as written");
});
// An associated type declared `?Sized` (decision 49) is an associated type:
// `Self.Target` names it in a signature, an impl may bind it to an unsized
// or a sized type, and a written `str` stays the unsized `str` (the legacy
// value-`str` alias applies at a `Type` slot only)
// (issues/fixed/2026-11-15-an-associated-type-declared-sized-opt-out-breaks-self-target.md).
_SzPeek :: trait(
  Target : ?Sized,
  peek : (fn(self : &Self) -> &Self.Target)
);
_SzPeekRow :: struct(a : Array(i32, 3));
impl(_SzPeekRow, _SzPeek(Target : [i32], peek : (fn(self : &Self) -> &Self.Target)(&self.a.*)));
_SzPeekName :: struct(s : &str);
impl(_SzPeekName, _SzPeek(Target : str, peek : (fn(self : &Self) -> &Self.Target)(&self.s.*)));
_SzPeekCell :: struct(n : i32);
impl(_SzPeekCell, _SzPeek(Target : i32, peek : (fn(self : &Self) -> &Self.Target)(&self.n)));
_sz_peek_len :: (fn(generic(T : Type), x : &T, where(T <: _SzPeek(Target := [i32]))) -> usize)(x.peek().len());
_sz_peek_of :: (fn(generic(T : Type), x : &T, where(T <: _SzPeek)) -> &T.Target)(&x.peek().*);
test("an associated type declared ?Sized names an unsized or a sized type", {
  r := _SzPeekRow(a : Array(i32, 3)(i32(1), i32(2), i32(3)));
  assert(r.peek().len() == usize(3), "a [i32] target");
  assert(_sz_peek_len(&r) == usize(3), "through a where-bound naming the target");
  assert(_sz_peek_of(&r).len() == usize(3), "a generic projection of T.Target");
  s := _SzPeekName(s : "abc");
  assert(s.peek().len() == usize(3), "a str target");
  c := _SzPeekCell(n : i32(7));
  assert(c.peek().* == i32(7), "a sized target");
  comptime_assert(Type.impls(_SzPeekRow, _SzPeek(Target := [i32])), "bound to [i32]");
  comptime_assert(Type.impls(_SzPeekName, _SzPeek(Target := str)), "a written str stays the unsized str");
  comptime_assert(Type.impls(_SzPeekCell, _SzPeek(Target := i32)), "bound to i32");
});
test("a ?Sized associated type is required and is unsized by value", {
  comptime_expect_error(impl(_SzPoint, _SzPeek(peek : (fn(self : &Self) -> &i32)(&self.x))), "is not provided");
  comptime_expect_error(trait(Target : ?Sized, get : (fn(self : &Self) -> Self.Target)), "is not `Sized`");
});
