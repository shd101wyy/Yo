//! `Sized`, `?Sized` and the unsized `[T]` (plans/VALUES_BY_DEFAULT.md
//! decision 49, S1): `Sized` is a derived marker; every `generic(T : Type)`
//! and `comptime(V) : Type` binder carries `where(T <: Sized)` implicitly, and
//! `?Sized` in a binder's kind slot drops it. `[T]` (`Slice(T)`) is unsized:
//! any by-value use of it, or of a `?Sized` variable, is E0619 — at the use
//! for a concrete type, at the definition for a `?Sized` binder.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");

Show :: trait(show : (fn(self : &Self) -> i32));
_SzPoint :: struct(x : i32, y : i32);
impl(_SzPoint, Show(show : (fn(self : &Self) -> i32)(self.x + self.y)));
impl(i32, Show(show : (fn(self : &Self) -> i32)(self.*)));

// A `?Sized` generic: `T` is used only behind the reference.
_sz_show :: (fn(generic(T : ?Sized), x : &T, where(T <: Show)) -> i32)(x.show());
_sz_id_ref :: (fn(generic(T : ?Sized), x : &T) -> &T)(&x.*);
// A tail struct: only the last field may be unsized.
_SzTail :: struct(n : i32, rest : [i32]);
// A type constructor whose binder is `?Sized`.
_SzPtr :: (fn(comptime(V) : ?Sized) -> comptime(Type))(struct(p : *V));
_SzBox :: (fn(comptime(V) : Type) -> comptime(Type))(struct(p : *V));
// A `Type` binder: implicitly `where(U <: Sized)`.
_sz_sized_only :: (fn(generic(U : Type), y : &U) -> i32)(i32(1));

test("[T] is the builtin Slice(T)", {
  assert(type_id(Slice(i32)) == type_id([i32]), "[i32] and Slice(i32) are one type");
  assert(type_id(Slice(i32)) != type_id([u8]), "the element is part of the type");
});

test("Sized is derived from the type's structure", {
  comptime_assert(Type.impls(i32, Sized), "a primitive is Sized");
  comptime_assert(Type.impls(_SzPoint, Sized), "a struct of sized fields is Sized");
  comptime_assert(Type.impls(Array(i32, 4), Sized), "a fixed-size array is Sized");
  // `Type.impls` takes a `Type`, which is sized: the unsized rows ask
  // through a `Type` binder instead (E0619).
  comptime_expect_error(_SzBox([i32]), "is not `Sized`");
  comptime_expect_error(_SzBox(_SzTail), "is not `Sized`");
  comptime_assert(Type.impls(*[i32], Sized), "a pointer to an unsized type is Sized");
  comptime_assert(Type.impls(_SzPtr([i32]), Sized), "a struct holding such a pointer is Sized");
});

test("Sized is never implemented by hand", {
  comptime_expect_error(impl([i32], Sized()), "never implemented by hand");
  comptime_expect_error(impl(_SzPoint, !Sized), "never implemented by hand");
});

test("a ?Sized generic is called at sized types", {
  p := _SzPoint(x : i32(2), y : i32(3));
  assert(_sz_show(&p) == i32(5), "a struct through the where-bound");
  n := i32(9);
  assert(_sz_show(&n) == i32(9), "a primitive through the where-bound");
  assert(_sz_id_ref(&n).* == i32(9), "a ?Sized projection returns the place");
});

test("a ?Sized type constructor takes an unsized argument", {
  comptime_assert(Type.impls(_SzPtr(i32), Sized), "at a sized argument");
  comptime_assert(Type.impls(_SzPtr([u8]), Sized), "at [u8]");
  comptime_expect_error(_SzBox([u8]), "is not `Sized`");
  comptime_expect_error(_SzBox([u8]), "?Sized");
});

test("an unsized type by value is E0619", {
  comptime_expect_error(size_of(Slice(i32)), "is not `Sized`");
  comptime_expect_error(size_of(_SzTail), "is not `Sized`");
  comptime_expect_error(align_of([i32]), "`align_of`");
  comptime_expect_error(Option([i32]), "is not `Sized`");
  comptime_expect_error(ArrayList([i32]), "is not `Sized`");
  comptime_expect_error(Array([i32], 2), "an array element");
  comptime_expect_error(Slice([i32]), "a slice element");
  comptime_expect_error(Tuple(i32, [i32]), "a tuple element");
  comptime_expect_error(struct(a : [i32], b : i32), "not the struct's last");
  comptime_expect_error(enum(A(v : [i32]), B), "the payload");
  comptime_expect_error((fn(x : [i32]) -> unit)(()), "the by-value parameter");
  comptime_expect_error((fn(x : &i32) -> [i32])(x), "a by-value result");
});

test("a ?Sized binder used by value is E0619 at the definition", {
  comptime_expect_error(
    (fn(generic(T : ?Sized), x : &T) -> unit)({
      _y := x.*;
    }),
    "is not `Sized`"
  );
  comptime_expect_error((fn(generic(T : ?Sized), x : &T) -> T)(x.*), "a by-value result");
  comptime_expect_error((fn(generic(T : ?Sized), x : T) -> unit)(()), "the by-value parameter");
  comptime_expect_error((fn(generic(T : ?Sized), x : &T) -> usize)(size_of(T)), "`size_of`");
  comptime_expect_error((fn(generic(T : ?Sized), x : &T) -> bool)(Option(T).None.is_none()), "?Sized");
});

test("a ?Sized variable at a Type binder is E0619 naming ?Sized", {
  comptime_expect_error((fn(generic(T : ?Sized), x : &T) -> i32)(_sz_sized_only(x)), "?Sized");
});

test("?Sized is a binder's kind only", {
  comptime_expect_error((fn(x : ?Sized) -> unit)(()), "kind of a type binder");
});

// Coherence rule 3 (decision 49): a blanket over a `Type` binder covers the
// sized types only, so it neither applies to nor overlaps an impl on `[T]`;
// a blanket over a `?Sized` binder covers both.
_CoMark :: trait(co : (fn(self : &Self) -> i32));
impl(generic(T : Type), T, _CoMark(co : (fn(self : &Self) -> i32)(i32(1))));
impl([i32], _CoMark(co : (fn(self : &Self) -> i32)(i32(2))));
_CoAll :: trait(co_all : (fn(self : &Self) -> i32));
impl(generic(T : ?Sized), T, _CoAll(co_all : (fn(self : &Self) -> i32)(i32(3))));

test("a blanket over a Type binder covers the sized types only", {
  n := i32(5);
  assert(n.co() == i32(1), "the blanket covers i32");
  comptime_expect_error(impl([i32], _CoAll(co_all : (fn(self : &Self) -> i32)(i32(4)))), "already implemented");
});
