//! Regression tests for short-circuit operand-temp drops — the `||`/`&&`
//! emitter's per-operand drop emission (`_emit_drops_for_conditional_branch`
//! in src/codegen/exprs/and_or.yo). A short circuit that IS a whole fn body
//! has no open codegen begin (the pending channel is empty), so the operand
//! temps' scope drops ride the shared body node's own ExprInfo list and
//! leaked wholesale until the node-list source landed
//! (issues/fixed/short-circuit-bare-fn-body-operand-temps-leak.md).
//!
//! ## The gate is a DISPOSE COUNTER, not a leak verdict
//!
//! The first version of this file asserted only VALUES, and short-circuit
//! values were never wrong — so all three tests PASSED under the compiler
//! that still had the leak. The leak verdict that was supposed to fail them
//! does not run anywhere: `.github/workflows/test.yml` sets
//! `YO_TEST_LEAK_VERDICT: "0"` on every job that could apply one (a
//! deliberate ratchet for pre-existing self-hosted-emit leak debt), and on
//! macOS `--sanitize address` produces a binary with zero `__asan` symbols.
//! See issues/fixed/leak-regression-tests-cannot-fail-in-ci-leak-verdicts-are-off-everywhere.md.
//!
//! So the operand temps here carry a `Drop` that bumps a shared counter,
//! which turns "the drop was emitted" into an ordinary value assertion: it
//! needs no sanitizer, holds on every platform, and fails under the ratchet.
//! Verified red-first against yo 0.2.24 (which predates the fix): every
//! disposes-count below reads 0 there.
//!
//! The file lives in `tests/` rather than `tests/internal/` on purpose — it
//! imports nothing from `src/`, and `tests/` runs on all six platforms while
//! `tests/internal` only runs in the differential shard.
import("std/string");
{ assert } :: import("std/assert");
{ RefCell } :: import("std/sync/refcell");
// A shared heap counter (an `Rc`) the disposed temps can reach through their
// own field; the count is its one written field, a `RefCell`.
Counter :: struct(n : RefCell(i32));
Tracked :: struct(c : Rc(Counter), v : i32);
impl(
  Tracked,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _old := self.c.n.replace_with(n => (n.* + i32(1)));
    })
  )
);
// Every call mints ONE owning temp; whether it is dropped is what is under
// test.
_mk :: (fn(c : &Rc(Counter), v : i32) -> Tracked)(Tracked(c : Rc.clone(c), v : v));
// ── the shapes ─────────────────────────────────────────────────────────────
// Whole-body `||`, operand 0 FALSE so both operands evaluate: 2 temps.
_two_or :: (fn(c : &Rc(Counter)) -> bool)(
  (_mk(c, i32(1)).v == i32(9)) || (_mk(c, i32(2)).v == i32(9))
);
// Whole-body `&&`, operand 0 TRUE so both operands evaluate: 2 temps.
_two_and :: (fn(c : &Rc(Counter)) -> bool)(
  (_mk(c, i32(1)).v == i32(1)) && (_mk(c, i32(2)).v == i32(9))
);
// `||` that ACTUALLY short-circuits: operand 1 is never evaluated, so only 1
// temp exists. The over-drop canary — a drop emitted unconditionally for
// operand 1 would release a temp that was never created.
_or_short :: (fn(c : &Rc(Counter)) -> bool)(
  (_mk(c, i32(1)).v == i32(1)) || (_mk(c, i32(2)).v == i32(9))
);
// `&&` that actually short-circuits: 1 temp.
_and_short :: (fn(c : &Rc(Counter)) -> bool)(
  (_mk(c, i32(1)).v == i32(9)) && (_mk(c, i32(2)).v == i32(9))
);
// A CHAIN parses as nested binaries `((a || b) || c)`: 3 temps. The inner
// operand's temps were the remainder left by the first fix
// (issues/fixed/short-circuit-chain-inner-operand-temps-still-leak.md).
_chain3 :: (fn(c : &Rc(Counter)) -> bool)(
  (_mk(c, i32(1)).v == i32(9)) || (_mk(c, i32(2)).v == i32(9)) || (_mk(c, i32(3)).v == i32(9))
);
// Mixed `&&` over two `||`s: 4 temps, all evaluated.
_mixed :: (fn(c : &Rc(Counter)) -> bool)(
  ((_mk(c, i32(1)).v == i32(9)) || (_mk(c, i32(2)).v == i32(2))) &&
    ((_mk(c, i32(3)).v == i32(9)) || (_mk(c, i32(4)).v == i32(4)))
);
// `||` inside a match arm: 2 temps. Fixed by the same change and covered by
// no test before.
_in_match :: (fn(c : &Rc(Counter)) -> bool)(
  match(
    Option(i32).Some(i32(1)),
    .Some(_) => ((_mk(c, i32(1)).v == i32(9)) || (_mk(c, i32(2)).v == i32(9))),
    .None => false
  )
);
// The begin-opened (statement-position) shape — the pending channel covers
// it; this pins parity between the two sources.
_stmt_or :: (fn(c : &Rc(Counter)) -> bool)({
  r := ((_mk(c, i32(1)).v == i32(9)) || (_mk(c, i32(2)).v == i32(9)));
  r
});
// `||` in a while body: the loop-scope flush owns these; parity pin.
_in_while :: (fn(c : &Rc(Counter)) -> i32)({
  (mut(h) : i32) = i32(0);
  (mut(i) : usize) = usize(0);
  while(i < usize(3), {
    if((_mk(c, i32(1)).v == i32(9)) || (_mk(c, i32(2)).v == i32(9)), {
      h = (h + i32(1));
    });
    i = (i + usize(1));
  });
  h
});
// Run `f` 100 times and return how many disposes it produced.
_disposes :: (fn(f : &Impl(Fn(c : &Rc(Counter)) -> bool)) -> i32)({
  c := Rc.new(Counter(n : RefCell(i32).new(i32(0))));
  (mut(i) : usize) = usize(0);
  while(i < usize(100), {
    _r := f(&c);
    i = (i + usize(1));
  });
  c.n.with(n => n.*)
});
test("whole-body || drops both operand temps", {
  got := _disposes(_two_or);
  assert(got == i32(200), `2 temps x 100 calls must all dispose, got ${got.to_string()}`);
});
test("whole-body && drops both operand temps", {
  got := _disposes(_two_and);
  assert(got == i32(200), `2 temps x 100 calls must all dispose, got ${got.to_string()}`);
});
test("a || that short-circuits drops exactly the temp it created", {
  got := _disposes(_or_short);
  assert(got == i32(100), `RHS never ran, so 1 temp x 100 calls, got ${got.to_string()}`);
});
test("an && that short-circuits drops exactly the temp it created", {
  got := _disposes(_and_short);
  assert(got == i32(100), `RHS never ran, so 1 temp x 100 calls, got ${got.to_string()}`);
});
test("a || CHAIN drops the inner operand's temps too", {
  got := _disposes(_chain3);
  assert(got == i32(300), `3 temps x 100 calls must all dispose, got ${got.to_string()}`);
});
test("mixed && over two ||s drops all four operand temps", {
  got := _disposes(_mixed);
  assert(got == i32(400), `4 temps x 100 calls must all dispose, got ${got.to_string()}`);
});
test("|| inside a match arm drops its operand temps", {
  got := _disposes(_in_match);
  assert(got == i32(200), `2 temps x 100 calls must all dispose, got ${got.to_string()}`);
});
test("statement-position || keeps parity with the whole-body shape", {
  got := _disposes(_stmt_or);
  assert(got == i32(200), `2 temps x 100 calls must all dispose, got ${got.to_string()}`);
});
test("|| in a while body drops its operand temps every iteration", {
  c := Rc.new(Counter(n : RefCell(i32).new(i32(0))));
  (mut(i) : usize) = usize(0);
  while(i < usize(100), {
    _r := _in_while(&c);
    i = (i + usize(1));
  });
  got := c.n.with(n => n.*);
  assert(got == i32(600), `2 temps x 3 iterations x 100 calls, got ${got.to_string()}`);
});
// ── a value the right operand MOVES ───────────────────────────────────────
// The right operand of `&&` / `||` runs only when the left one lets it, so a
// local it moves is moved on that path only. The path that skips it still
// owns the value and must drop it, exactly once, and the path that runs it
// must not drop it again
// (issues/fixed/2026-11-04-a-move-in-the-right-operand-of-a-short-circuit-operator-leaks-when-the-operand-is-skipped.md).
// Every shape below makes ONE `Tracked`, so each call disposes exactly one.
// Takes its `Tracked` by value: the callee owns it and drops it on return.
_eat :: (fn(t : Tracked) -> bool)(t.v == i32(1));
_eat_opt :: (fn(o : Option(Tracked)) -> bool)(match(o, .Some(t) => (t.v == i32(1)), .None => false));
_and_moves :: (fn(c : &Rc(Counter), a : bool, _b : bool) -> bool)({
  t := _mk(c, i32(1));
  a && _eat(t)
});
_or_moves :: (fn(c : &Rc(Counter), a : bool, _b : bool) -> bool)({
  t := _mk(c, i32(1));
  a || _eat(t)
});
// The verifier's shape: an `Option` local whose only consumer is the right
// operand.
_and_moves_option :: (fn(c : &Rc(Counter), a : bool, _b : bool) -> bool)({
  o := Option(Tracked).Some(_mk(c, i32(1)));
  a && _eat_opt(o)
});
// A chain parses as `((a && b) && eat(t))`: the move is skipped when `a` OR
// `b` is false.
_chain_moves :: (fn(c : &Rc(Counter), a : bool, b : bool) -> bool)({
  t := _mk(c, i32(1));
  a && b && _eat(t)
});
// Nested: the inner `||` drops `t` when `b` skips its right operand, the outer
// `&&` when `a` skips the whole inner one.
_nested_moves :: (fn(c : &Rc(Counter), a : bool, b : bool) -> bool)({
  t := _mk(c, i32(1));
  a && (b || _eat(t))
});
// A `match` inside the right operand moves `t` in one arm: the `.None` arm's
// join drops it there, and the short circuit's skip path drops it when `a` is
// false.
_match_in_rhs_moves :: (fn(c : &Rc(Counter), a : bool, b : bool) -> bool)({
  t := _mk(c, i32(1));
  a && match(if(b, Option(i32).Some(i32(1)), Option(i32).None), .Some(_) => _eat(t), .None => false)
});
// Statement position, then read the result.
_stmt_and_moves :: (fn(c : &Rc(Counter), a : bool, _b : bool) -> bool)({
  t := _mk(c, i32(1));
  r := (a && _eat(t));
  r
});
// A by-value parameter moved only by the right operand: the function owns it.
_param_and_inner :: (fn(t : Tracked, a : bool) -> bool)(a && _eat(t));
_param_and_moves :: (fn(c : &Rc(Counter), a : bool, _b : bool) -> bool)(_param_and_inner(_mk(c, i32(1)), a));
// Run `f` 99 times over every combination of two runtime flags and return
// how many `Tracked` values it disposed of.
_disposes_flags :: (fn(f : &Impl(Fn(c : &Rc(Counter), a : bool, b : bool) -> bool)) -> i32)({
  c := Rc.new(Counter(n : RefCell(i32).new(i32(0))));
  (mut(i) : usize) = usize(0);
  while(i < usize(99), {
    k := (i % usize(3));
    _r := f(&c, (k != usize(0)), (k == usize(2)));
    i = (i + usize(1));
  });
  c.n.with(n => n.*)
});
test("a local the right operand of && moves is dropped once on either path", {
  got := _disposes_flags(_and_moves);
  assert(got == i32(99), `1 value x 99 calls, got ${got.to_string()}`);
});
test("a local the right operand of || moves is dropped once on either path", {
  got := _disposes_flags(_or_moves);
  assert(got == i32(99), `1 value x 99 calls, got ${got.to_string()}`);
});
test("an Option local only the right operand consumes is dropped once", {
  got := _disposes_flags(_and_moves_option);
  assert(got == i32(99), `1 value x 99 calls, got ${got.to_string()}`);
});
test("a move at the end of an && chain is dropped when any earlier operand skips it", {
  got := _disposes_flags(_chain_moves);
  assert(got == i32(99), `1 value x 99 calls, got ${got.to_string()}`);
});
test("a move inside a nested || under && is dropped once on every path", {
  got := _disposes_flags(_nested_moves);
  assert(got == i32(99), `1 value x 99 calls, got ${got.to_string()}`);
});
test("a move in a match arm of the right operand is dropped once on every path", {
  got := _disposes_flags(_match_in_rhs_moves);
  assert(got == i32(99), `1 value x 99 calls, got ${got.to_string()}`);
});
test("statement-position && drops the value its right operand would move", {
  got := _disposes_flags(_stmt_and_moves);
  assert(got == i32(99), `1 value x 99 calls, got ${got.to_string()}`);
});
test("a by-value parameter only the right operand moves is dropped once", {
  got := _disposes_flags(_param_and_moves);
  assert(got == i32(99), `1 value x 99 calls, got ${got.to_string()}`);
});
