// Gated user-defined macros — `pragma(Pragma.AllowMacroDef);` opts this
// file into DEFINING macros (plans/reference/MACRO_POLICY.md Part 2). CALLING std
// macros (`if`, `for`) never needs the pragma; every other test file proves
// that.
//
// This file also preserves the coverage the removed std `try` macro's test
// file (tests/try_macro.test.yo) used to provide: a macro whose expansion
// performs an early `return` in the CALLER's frame.
pragma(Pragma.AllowMacroDef);
{ String } :: import("std/string");
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");

/// Local re-creation of the removed std `try` macro
/// (plans/reference/MACRO_POLICY.md Part 3.1).
try_local :: (fn(quote(expr_to_try) : Expr) -> unquote(Expr))({
  temp :: gensym("try_local");
  quote({
    unquote(temp) := unquote(expr_to_try);
    match(
      unquote(temp),
      .Ok(value) => value,
      .Err(error) => {
        return(.Err(error));
      }
    )
  })
});

/// Quoted-variadic macro (`...(quote(elems))`): a local re-creation of the
/// deleted std `array_list` literal (plans/backlog/MACRO_AND_ISO_REMOVAL.md
/// B3). With the std literals gone this is the runtime suite's only
/// expansion through the quoted-variadic binding path
/// (`src/evaluator/calls/function.yo`: every trailing arg binds as an `Expr`).
_local_list_pushes :: (fn(comptime(tmp) : Expr, comptime(elems) : ExprList) -> comptime(ExprList))(
  cond(
    (elems.len() == usize(0)) => ExprList(),
    true => {
      first :: elems.car();
      rest :: elems.cdr();
      stmt :: quote(unquote(tmp).push(unquote(first)));
      stmt.cons(recur(tmp, rest))
    }
  )
);
local_list :: (fn(...(quote(elems))) -> unquote(Expr))({
  __ :: comptime_assert(elems.len() > usize(0), "local_list needs one element to infer the element type");
  first :: elems.car();
  rest :: elems.cdr();
  tmp :: gensym("local_list");
  first_tmp :: gensym("local_list_first");
  rest_pushes :: _local_list_pushes(tmp, rest);
  quote({
    unquote(first_tmp) := unquote(first);
    unquote(tmp) := ArrayList(type_of(unquote(first_tmp))).new();
    unquote(tmp).push(unquote(first_tmp));
    unquote_splicing(rest_pushes);
    unquote(tmp)
  })
});

/// Lazy-argument macro: the skipped branch must never be evaluated.
unless :: (fn(quote(c) : Expr, quote(body) : Expr) -> unquote(Expr))(
  quote(cond(unquote(c) => (), true => unquote(body)))
);

might_fail :: (fn(ok : bool) -> Result(i32, String))(
  if(ok, Result(i32, String).Ok(i32(41)), Result(i32, String).Err(String.from("nope")))
);

chain :: (fn(ok : bool) -> Result(i32, String))({
  v := try_local(might_fail(ok));
  Result(i32, String).Ok(v + i32(1))
});

test("macro def under AllowMacroDef: caller-frame early return works", {
  match(
    chain(true),
    .Ok(n) => assert(n == i32(42), "Ok value flows through try_local"),
    .Err(_) => assert(false, "unexpected Err from chain(true)")
  );
  match(
    chain(false),
    .Ok(_) => assert(false, "unexpected Ok from chain(false)"),
    .Err(e) => assert(e == "nope", "Err short-circuits the caller")
  );
});

test("macro def under AllowMacroDef: a quoted variadic binds every trailing arg", {
  xs := local_list(i32(3), i32(1), i32(4));
  assert(xs.len() == usize(3), "three elements");
  assert((xs(usize(0)) == i32(3)) && (xs(usize(2)) == i32(4)), "in argument order");
  one := local_list(i32(9));
  assert(one.len() == usize(1), "a single trailing arg");
  names := local_list(String.from("a"), String.from("bc"));
  assert(names(usize(1)) == "bc", "refcounted elements");
  comptime_expect_error(local_list(), "local_list needs one element");
});

test("macro def under AllowMacroDef: skipped branch stays unevaluated", {
  mut(hits) := i32(0);
  unless(true, {
    hits = (hits + i32(1));
  });
  assert(hits == i32(0), "unless(true, ...) must not run the body");
  unless(false, {
    hits = (hits + i32(1));
  });
  assert(hits == i32(1), "unless(false, ...) runs the body once");
});
(g_macro_probe : ArrayList(i32)) = ArrayList(i32).new();
_macro_probe_touch :: (fn() -> unit)({
  g_macro_probe.push(i32(1));
});
/// Rule 3 (decision 18) at a macro call: the call itself is a runtime call,
/// so a local borrow of a module-level place may not be live across it — the
/// expansion's calls (this template's `_macro_probe_touch`) are covered by
/// the macro call that runs them
/// (issues/fixed/2026-10-17-a-module-level-local-borrow-is-not-checked-across-a-call-a-macro-expands-to.md).
_macro_probe_caller :: (fn() -> unquote(Expr))(quote(_macro_probe_touch()));
comptime_expect_error({
  _lb_macro_call_rejected :: (fn() -> unit)({
    y := &mut g_macro_probe;
    _macro_probe_caller();
    y.push(i32(2));
  });
  _lb_macro_call_rejected();
}, "Cannot call");
