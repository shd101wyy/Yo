open import "std/libc/stdio";
{ RwLock } :: import "std/sync/rwlock";
{ Thread } :: import "std/thread";
{ sleep } :: import "std/time/sleep";
{ WaitGroup } :: import "std/sync/waitgroup";
Worker :: import "std/worker";

// ============================================================================
// Basic operations
// ============================================================================

test "RwLock new creates unlocked lock", {
  lock := RwLock.new();
  // Should be able to acquire read lock immediately
  lock.read_lock();
  lock.read_unlock();
};

test "RwLock read lock and unlock", {
  lock := RwLock.new();
  lock.read_lock();
  lock.read_unlock();
  // Should be able to lock again after unlocking
  lock.read_lock();
  lock.read_unlock();
};

test "RwLock write lock and unlock", {
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  // Should be able to lock again after unlocking
  lock.write_lock();
  lock.write_unlock();
};

test "RwLock multiple concurrent readers", {
  lock := RwLock.new();
  // Multiple read locks should succeed without blocking
  lock.read_lock();
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  lock.read_unlock();
};

test "RwLock write after read", {
  lock := RwLock.new();
  lock.read_lock();
  lock.read_unlock();
  // Write should succeed after all readers release
  lock.write_lock();
  lock.write_unlock();
};

test "RwLock read after write", {
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  // Read should succeed after writer releases
  lock.read_lock();
  lock.read_unlock();
};

// ============================================================================
// Sequencing: read/write transitions
// ============================================================================

test "RwLock alternating read and write locks", {
  lock := RwLock.new();
  i := i32(0);
  while runtime((i < i32(5))), {
    lock.read_lock();
    lock.read_unlock();
    lock.write_lock();
    lock.write_unlock();
    i = (i + i32(1));
  };
};

test "RwLock multiple readers then write then readers", {
  lock := RwLock.new();
  // Multiple readers
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  // Then a write
  lock.write_lock();
  lock.write_unlock();
  // Then readers again
  lock.read_lock();
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  lock.read_unlock();
};

test "RwLock write lock is exclusive - cannot nest writes", {
  // Verify that after write_unlock, we can write_lock again
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  lock.write_lock();
  lock.write_unlock();
  lock.write_lock();
  lock.write_unlock();
};

// ============================================================================
// Thread integration (using Arc for cross-thread sharing)
// ============================================================================

test "RwLock concurrent readers across threads", {
  lock := arc(RwLock.new());

  t1 := Thread.spawn(() => {
    lock.(*).read_lock();
    sleep(usize(10));
    lock.(*).read_unlock();
  });

  t2 := Thread.spawn(() => {
    lock.(*).read_lock();
    sleep(usize(10));
    lock.(*).read_unlock();
  });

  t3 := Thread.spawn(() => {
    lock.(*).read_lock();
    sleep(usize(10));
    lock.(*).read_unlock();
  });

  // Main thread also reads concurrently
  lock.(*).read_lock();
  lock.(*).read_unlock();

  t1.join();
  t2.join();
  t3.join();
};

test "RwLock writer thread modifies shared data", {
  lock := arc(RwLock.new());
  data := arc(box(i32(0)));

  t := Thread.spawn(() => {
    lock.(*).write_lock();
    data.(*).(*) = i32(42);
    lock.(*).write_unlock();
  });

  t.join();

  lock.(*).read_lock();
  assert((data.(*).(*) == i32(42)), "should see writer's value");
  lock.(*).read_unlock();
};

test "RwLock two writer threads increment counter", {
  lock := arc(RwLock.new());
  data := arc(box(i32(0)));

  t1 := Thread.spawn(() => {
    i := i32(0);
    while runtime((i < i32(100))), {
      lock.(*).write_lock();
      data.(*).(*) = (data.(*).(*) + i32(1));
      lock.(*).write_unlock();
      i = (i + i32(1));
    };
  });

  t2 := Thread.spawn(() => {
    i := i32(0);
    while runtime((i < i32(100))), {
      lock.(*).write_lock();
      data.(*).(*) = (data.(*).(*) + i32(1));
      lock.(*).write_unlock();
      i = (i + i32(1));
    };
  });

  t1.join();
  t2.join();

  lock.(*).read_lock();
  assert((data.(*).(*) == i32(200)), "counter should be 200 after 2 threads x 100 increments");
  lock.(*).read_unlock();
};

test "RwLock readers wait for writer across threads", {
  lock := arc(RwLock.new());
  data := arc(box(i32(0)));

  // Writer runs first, holds lock while sleeping
  writer := Thread.spawn(() => {
    lock.(*).write_lock();
    sleep(usize(50));
    data.(*).(*) = i32(99);
    lock.(*).write_unlock();
  });

  // Give writer time to acquire lock
  sleep(usize(10));

  // Readers will block until writer releases
  t1 := Thread.spawn(() => {
    lock.(*).read_lock();
    val := data.(*).(*);  
    assert((val == i32(99)), "reader 1 should see 99");
    lock.(*).read_unlock();
  });

  t2 := Thread.spawn(() => {
    lock.(*).read_lock();
    val := data.(*).(*);  
    assert((val == i32(99)), "reader 2 should see 99");
    lock.(*).read_unlock();
  });

  writer.join();
  t1.join();
  t2.join();
};

// ============================================================================
// Worker integration (using Arc for cross-thread sharing)
// ============================================================================

test "RwLock with Workers concurrent reads", {
  lock := arc(RwLock.new());
  wg := arc(WaitGroup.new());
  Worker.set_num_threads(2);

  wg.(*).add(i32(3));
  Worker.spawn(() => {
    lock.(*).read_lock();
    lock.(*).read_unlock();
    wg.(*).done();
  });
  Worker.spawn(() => {
    lock.(*).read_lock();
    lock.(*).read_unlock();
    wg.(*).done();
  });
  Worker.spawn(() => {
    lock.(*).read_lock();
    lock.(*).read_unlock();
    wg.(*).done();
  });

  wg.(*).wait();
};

test "RwLock with Workers write then read", {
  lock := arc(RwLock.new());
  data := arc(box(i32(0)));
  wg := arc(WaitGroup.new());
  Worker.set_num_threads(2);

  // Writer worker
  wg.(*).add(i32(1));
  Worker.spawn(() => {
    lock.(*).write_lock();
    data.(*).(*) = i32(77);
    lock.(*).write_unlock();
    wg.(*).done();
  });

  wg.(*).wait();

  // Verify from main thread
  lock.(*).read_lock();
  assert((data.(*).(*) == i32(77)), "should see worker's write");
  lock.(*).read_unlock();
};
