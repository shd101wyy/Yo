pragma(Pragma.SkipWasm32Wasi); // no pthread support in standalone WASI
{ assert } :: import("std/assert");
{ arch, Arch } :: import("std/process");
open(import("std/libc/stdio"));
{ RwLock } :: import("std/sync/rwlock");
{ Thread, ThreadPool, spawn } :: import("std/thread");
{ sleep_blocking } :: import("std/time/sleep");
{ Duration } :: import("std/time/duration");
{ WaitGroup } :: import("std/sync/waitgroup");
{ AtomicI32, MemoryOrder } :: import("std/sync/atomic");
// ============================================================================
// Basic operations
// ============================================================================
test("RwLock new creates unlocked lock", {
  lock := RwLock.new();
  // Should be able to acquire read lock immediately
  lock.read_lock();
  lock.read_unlock();
});
test("RwLock read lock and unlock", {
  lock := RwLock.new();
  lock.read_lock();
  lock.read_unlock();
  // Should be able to lock again after unlocking
  lock.read_lock();
  lock.read_unlock();
});
test("RwLock write lock and unlock", {
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  // Should be able to lock again after unlocking
  lock.write_lock();
  lock.write_unlock();
});
test("RwLock multiple concurrent readers", {
  lock := RwLock.new();
  // Multiple read locks should succeed without blocking
  lock.read_lock();
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  lock.read_unlock();
});
test("RwLock write after read", {
  lock := RwLock.new();
  lock.read_lock();
  lock.read_unlock();
  // Write should succeed after all readers release
  lock.write_lock();
  lock.write_unlock();
});
test("RwLock read after write", {
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  // Read should succeed after writer releases
  lock.read_lock();
  lock.read_unlock();
});
// ============================================================================
// Sequencing: read/write transitions
// ============================================================================
test("RwLock alternating read and write locks", {
  lock := RwLock.new();
  i := i32(0);
  while(runtime(i < i32(5)), {
    lock.read_lock();
    lock.read_unlock();
    lock.write_lock();
    lock.write_unlock();
    i = (i + i32(1));
  });
});
test("RwLock multiple readers then write then readers", {
  lock := RwLock.new();
  // Multiple readers
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  // Then a write
  lock.write_lock();
  lock.write_unlock();
  // Then readers again
  lock.read_lock();
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  lock.read_unlock();
});
test("RwLock write lock is exclusive - cannot nest writes", {
  // Verify that after write_unlock, we can write_lock again
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  lock.write_lock();
  lock.write_unlock();
  lock.write_lock();
  lock.write_unlock();
});
// ============================================================================
// Thread integration (atomic object — shared directly without Arc)
// ============================================================================
test("RwLock concurrent readers across threads", {
  if(arch == Arch.Wasm32, return(()));
  lock := RwLock.new();
  t1 := Thread.spawn((io) => {
    lock.read_lock();
    sleep_blocking(Duration.from_millis(i64(10)));
    lock.read_unlock();
  });
  t2 := Thread.spawn((io) => {
    lock.read_lock();
    sleep_blocking(Duration.from_millis(i64(10)));
    lock.read_unlock();
  });
  t3 := Thread.spawn((io) => {
    lock.read_lock();
    sleep_blocking(Duration.from_millis(i64(10)));
    lock.read_unlock();
  });
  // Main thread also reads concurrently
  lock.read_lock();
  lock.read_unlock();
  t1.join();
  t2.join();
  t3.join();
});
test("RwLock writer thread modifies shared data", {
  if(arch == Arch.Wasm32, return(()));
  lock := RwLock.new();
  data := AtomicI32(i32(0));
  t := Thread.spawn((io) => {
    lock.write_lock();
    data.store(i32(42), MemoryOrder.Relaxed);
    lock.write_unlock();
  });
  t.join();
  lock.read_lock();
  assert(data.load(MemoryOrder.Relaxed) == i32(42), "should see writer's value");
  lock.read_unlock();
});
test("RwLock two writer threads increment counter", {
  if(arch == Arch.Wasm32, return(()));
  lock := RwLock.new();
  data := AtomicI32(i32(0));
  t1 := Thread.spawn((io) => {
    i := i32(0);
    while(runtime(i < i32(100)), {
      lock.write_lock();
      data.fetch_add(i32(1), MemoryOrder.Relaxed);
      lock.write_unlock();
      i = (i + i32(1));
    });
  });
  t2 := Thread.spawn((io) => {
    i := i32(0);
    while(runtime(i < i32(100)), {
      lock.write_lock();
      data.fetch_add(i32(1), MemoryOrder.Relaxed);
      lock.write_unlock();
      i = (i + i32(1));
    });
  });
  t1.join();
  t2.join();
  lock.read_lock();
  assert(data.load(MemoryOrder.Relaxed) == i32(200), "counter should be 200 after 2 threads x 100 increments");
  lock.read_unlock();
});
test("RwLock readers wait for writer across threads", {
  if(arch == Arch.Wasm32, return(()));
  lock := RwLock.new();
  data := AtomicI32(i32(0));
  // Writer acquires the lock in a separate thread
  writer := Thread.spawn((io) => {
    lock.write_lock();
    data.store(i32(99), MemoryOrder.Relaxed);
    lock.write_unlock();
  });
  // Wait for writer to finish
  writer.join();
  // Readers should see the writer's value
  t1 := Thread.spawn((io) => {
    lock.read_lock();
    val := data.load(MemoryOrder.Relaxed);
    assert(val == i32(99), "reader 1 should see 99");
    lock.read_unlock();
  });
  t2 := Thread.spawn((io) => {
    lock.read_lock();
    val := data.load(MemoryOrder.Relaxed);
    assert(val == i32(99), "reader 2 should see 99");
    lock.read_unlock();
  });
  t1.join();
  t2.join();
});
// ============================================================================
// ThreadPool integration (atomic object — shared directly without Arc)
// ============================================================================
test("RwLock with pool tasks concurrent reads", {
  if(arch == Arch.Wasm32, return(()));
  lock := RwLock.new();
  wg := WaitGroup.new();
  pool := ThreadPool.new(usize(2));
  wg.add(i32(3));
  spawn(pool, (io) => {
    lock.read_lock();
    lock.read_unlock();
    wg.done();
  });
  spawn(pool, (io) => {
    lock.read_lock();
    lock.read_unlock();
    wg.done();
  });
  spawn(pool, (io) => {
    lock.read_lock();
    lock.read_unlock();
    wg.done();
  });
  wg.wait();
});
test("RwLock with pool tasks write then read", {
  if(arch == Arch.Wasm32, return(()));
  lock := RwLock.new();
  data := AtomicI32(i32(0));
  wg := WaitGroup.new();
  pool := ThreadPool.new(usize(2));
  // Writer worker
  wg.add(i32(1));
  spawn(pool, (io) => {
    lock.write_lock();
    data.store(i32(77), MemoryOrder.Relaxed);
    lock.write_unlock();
    wg.done();
  });
  wg.wait();
  // Verify from main thread
  lock.read_lock();
  assert(data.load(MemoryOrder.Relaxed) == i32(77), "should see worker's write");
  lock.read_unlock();
});
// ============================================================================
// Reader wakeup on write_unlock
//
// The suite above never blocks a reader behind a HELD writer: "RwLock readers
// wait for writer across threads" joins the writer before spawning readers, so
// read_lock never waits. This test holds the write lock while the readers
// arrive, which is the only way to exercise write_unlock's wakeup.
// issues/rwlock-write-unlock-never-wakes-blocked-readers.md
// ============================================================================
test("RwLock readers blocked behind a held writer are woken on release", {
  if(arch == Arch.Wasm32, return(()));
  lock := RwLock.new();
  data := AtomicI32(i32(0));
  arrived := AtomicI32(i32(0));
  done := AtomicI32(i32(0));
  // The MAIN thread holds the write lock for the whole spawn window.
  lock.write_lock();
  data.store(i32(99), MemoryOrder.Relaxed);
  t1 := Thread.spawn((io) => {
    arrived.fetch_add(i32(1), MemoryOrder.Relaxed);
    lock.read_lock();
    assert(data.load(MemoryOrder.Relaxed) == i32(99), "reader 1 must see the writer's value");
    lock.read_unlock();
    done.fetch_add(i32(1), MemoryOrder.Relaxed);
  });
  t2 := Thread.spawn((io) => {
    arrived.fetch_add(i32(1), MemoryOrder.Relaxed);
    lock.read_lock();
    assert(data.load(MemoryOrder.Relaxed) == i32(99), "reader 2 must see the writer's value");
    lock.read_unlock();
    done.fetch_add(i32(1), MemoryOrder.Relaxed);
  });
  t3 := Thread.spawn((io) => {
    arrived.fetch_add(i32(1), MemoryOrder.Relaxed);
    lock.read_lock();
    assert(data.load(MemoryOrder.Relaxed) == i32(99), "reader 3 must see the writer's value");
    lock.read_unlock();
    done.fetch_add(i32(1), MemoryOrder.Relaxed);
  });
  // All three have reached read_lock, and the writer still holds it.
  while(runtime(arrived.load(MemoryOrder.Relaxed) < i32(3)), {
    sleep_blocking(Duration.from_millis(i64(1)));
  });
  sleep_blocking(Duration.from_millis(i64(20)));
  assert(done.load(MemoryOrder.Relaxed) == i32(0), "no reader may pass while the writer holds the lock");
  lock.write_unlock();
  t1.join();
  t2.join();
  t3.join();
  assert(done.load(MemoryOrder.Relaxed) == i32(3), "every blocked reader must be woken by write_unlock");
});
