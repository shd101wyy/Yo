open import "std/libc/stdio";
{ RwLock } :: import "std/sync/rwlock";

// ============================================================================
// Basic operations
// ============================================================================

test "RwLock new creates unlocked lock", {
  lock := RwLock.new();
  // Should be able to acquire read lock immediately
  lock.read_lock();
  lock.read_unlock();
};

test "RwLock read lock and unlock", {
  lock := RwLock.new();
  lock.read_lock();
  lock.read_unlock();
  // Should be able to lock again after unlocking
  lock.read_lock();
  lock.read_unlock();
};

test "RwLock write lock and unlock", {
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  // Should be able to lock again after unlocking
  lock.write_lock();
  lock.write_unlock();
};

test "RwLock multiple concurrent readers", {
  lock := RwLock.new();
  // Multiple read locks should succeed without blocking
  lock.read_lock();
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  lock.read_unlock();
};

test "RwLock write after read", {
  lock := RwLock.new();
  lock.read_lock();
  lock.read_unlock();
  // Write should succeed after all readers release
  lock.write_lock();
  lock.write_unlock();
};

test "RwLock read after write", {
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  // Read should succeed after writer releases
  lock.read_lock();
  lock.read_unlock();
};

// ============================================================================
// Sequencing: read/write transitions
// ============================================================================

test "RwLock alternating read and write locks", {
  lock := RwLock.new();
  i := i32(0);
  while runtime((i < i32(5))), {
    lock.read_lock();
    lock.read_unlock();
    lock.write_lock();
    lock.write_unlock();
    i = (i + i32(1));
  };
};

test "RwLock multiple readers then write then readers", {
  lock := RwLock.new();
  // Multiple readers
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  // Then a write
  lock.write_lock();
  lock.write_unlock();
  // Then readers again
  lock.read_lock();
  lock.read_lock();
  lock.read_lock();
  lock.read_unlock();
  lock.read_unlock();
  lock.read_unlock();
};

test "RwLock write lock is exclusive - cannot nest writes", {
  // Verify that after write_unlock, we can write_lock again
  lock := RwLock.new();
  lock.write_lock();
  lock.write_unlock();
  lock.write_lock();
  lock.write_unlock();
  lock.write_lock();
  lock.write_unlock();
};
