// `RefCell(T)` (std/sync/refcell): shared mutation behind `Rc`, checked at
// run time (plans/VALUES_BY_DEFAULT.md decisions 41 and 46, §6 "Decision 46"
// step 1). A conflicting access panics; those paths are pinned by the cli
// cases `refcell-with-mut-under-with-panics`,
// `refcell-replace-under-with-panics` and
// `refcell-replace-with-reentry-panics`.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ RefCell } :: import("std/sync/refcell");
test("with_mut through one handle is seen through another", {
  log := rc(RefCell(ArrayList(String)).new(ArrayList(String).new()));
  other := log;
  other.with_mut(xs => {
    xs.push(String.from("a"));
  });
  log.with_mut(xs => {
    xs.push(String.from("b"));
  });
  assert(log.with(xs => xs.len()) == usize(2), "both pushes landed in the one cell");
  assert(other.with(xs => (xs(usize(1)) == "b")), "in order");
});
test("with returns the body's result, and nested reads share the cell", {
  c := rc(RefCell(i32).new(i32(20)));
  d := c;
  sum := c.with(v => d.with(w => (v + w)));
  assert(sum == i32(40), "two readers at once");
});
test("the mark is released after each access", {
  c := rc(RefCell(i32).new(i32(1)));
  c.with_mut(v => {
    v = (v + i32(1));
  });
  c.with_mut(v => {
    v = (v * i32(10));
  });
  assert(c.with(v => v) == i32(20), "a second with_mut runs after the first");
});
test("the mark is released when the body unwinds", {
  c := rc(RefCell(i32).new(i32(1)));
  _unwinds :: (fn(cell : &Rc(RefCell(i32))) -> i32)({
    cell.with_mut(v => {
      v = i32(2);
      unwind(i32(7));
    });
    i32(0)
  });
  assert(_unwinds(&c) == i32(7), "the body unwound out of the function");
  c.with_mut(v => {
    v = (v + i32(1));
  });
  assert(c.with(v => v) == i32(3), "the cell is free again, with the write kept");
});
test("a RefCell is a value: a plain local works without an Rc", {
  cell := RefCell(String).new(String.from("x"));
  cell.with_mut(s => {
    s.push_str("y");
  });
  assert(cell.with(s => (s == "xy")), "written through a & receiver");
});
test("clone copies the value into a new cell", {
  a := RefCell(i32).new(i32(3));
  b := a.clone();
  b.with_mut(v => {
    v = i32(4);
  });
  assert((a.with(v => v) == i32(3)) && (b.with(v => v) == i32(4)), "independent cells");
});
// `replace`, `replace_with`, `take` and `into_inner`: step 0 of
// issues/questions/2026-10-23-should-yo-add-a-flagless-cell.md.
test("replace_with counts through a second handle and returns the old value", {
  counter := rc(RefCell(i32).new(i32(0)));
  other := counter;
  assert(other.replace_with(n => (n + i32(1))) == i32(0), "the old value");
  assert(counter.replace_with(n => (n * i32(10))) == i32(1), "the first handle sees 1");
  assert(other.with(n => n) == i32(10), "both updates landed in the one cell");
});
test("replace swaps a String in and gives the old one back", {
  name := rc(RefCell(String).new(String.from("old")));
  other := name;
  was := other.replace(String.from("new"));
  assert(was == "old", "the replaced value");
  assert(name.with(s => (s == "new")), "seen through the other handle");
});
test("replace_with builds the successor of a collection from the current one", {
  log := rc(RefCell(ArrayList(String)).new(ArrayList(String).new()));
  log.with_mut(xs => {
    xs.push(String.from("a"));
  });
  was := log.replace_with(xs => {
    next := xs.clone();
    next.push(String.from("b"));
    next
  });
  assert(was.len() == usize(1), "the old list");
  assert(log.with(xs => xs.len()) == usize(2), "the new list");
});
test("take leaves the default behind", {
  log := rc(RefCell(ArrayList(String)).new(ArrayList(String).new()));
  other := log;
  other.with_mut(xs => {
    xs.push(String.from("a"));
    xs.push(String.from("b"));
  });
  taken := log.take();
  assert(taken.len() == usize(2), "the items moved out");
  assert(other.with(xs => xs.len()) == usize(0), "an empty list is left");
  n := RefCell(i32).new(i32(7));
  assert((n.take() == i32(7)) && (n.with(v => v) == i32(0)), "i32's default is 0");
});
test("into_inner consumes the cell and returns the value", {
  cell := RefCell(String).new(String.from("x"));
  cell.with_mut(s => {
    s.push_str("y");
  });
  s := cell.into_inner();
  assert(s == "xy", "the value written through the cell");
  shared := rc(RefCell(ArrayList(String)).new(ArrayList(String).new()));
  shared.with_mut(xs => {
    xs.push(String.from("z"));
  });
  xs := match(Rc.try_unwrap(shared), .Ok(c) => c.into_inner(), .Err(_) => ArrayList(String).new());
  assert(xs.len() == usize(1), "the only handle's cell gives its list up");
});
test("the mark is released when replace_with's function unwinds", {
  c := rc(RefCell(i32).new(i32(1)));
  _unwinds :: (fn(cell : &Rc(RefCell(i32))) -> i32)({
    cell.replace_with(
      v => cond(
        (v == i32(1)) => unwind(i32(7)),
        true => (v + i32(1))
      )
    );
    i32(0)
  });
  assert(_unwinds(&c) == i32(7), "the function unwound out of the caller");
  assert(c.with(v => v) == i32(1), "the value is unchanged");
  assert(c.replace_with(v => (v + i32(1))) == i32(1), "the cell is free again");
  c.with_mut(v => {
    v = (v + i32(1));
  });
  assert(c.with(v => v) == i32(3), "and with_mut runs after it");
});
// A cell reached through an `Rc` element is kept alive for the call even
// when the body drops every other handle: the caller holds a +1 on the
// handle, and a body naming the container itself is E0910
// (issues/fixed/2026-10-23-a-receiver-reached-through-an-rc-auto-deref-is-not-kept-alive-across-its-closure-argument.md).
// The value has a destructor, so each access reports how many values were
// destroyed while its body ran: 0 when the cell outlived the body.
mut(_rc_cell_drops) := i32(0);
_RcTracked :: struct(n : i32);
impl(
  _RcTracked,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _rc_cell_drops = (_rc_cell_drops + i32(1));
    })
  )
);
_rc_tracked_list :: (fn(n : i32) -> ArrayList(Rc(RefCell(_RcTracked))))({
  xs := ArrayList(Rc(RefCell(_RcTracked))).new();
  xs.push(rc(RefCell(_RcTracked).new(_RcTracked(n : n))));
  xs
});
test("with, with_mut, replace_with and replace keep a cell reached through an Rc element alive", {
  _rc_cell_drops = i32(0);
  a := _rc_tracked_list(i32(1));
  a2 := a;
  assert(
    a(usize(0)).with_mut(v => {
      a2.clear();
      v.n = (v.n + i32(1));
      _rc_cell_drops
    }) == i32(0),
    "with_mut: the cell outlives the body"
  );
  assert(_rc_cell_drops == i32(1), "and is destroyed once, after it");
  b := _rc_tracked_list(i32(2));
  b2 := b;
  assert(
    b(usize(0)).with(v => {
      b2.clear();
      _rc_cell_drops + (v.n - v.n)
    }) == i32(1),
    "with"
  );
  assert(_rc_cell_drops == i32(2), "destroyed once");
  c := _rc_tracked_list(i32(3));
  c2 := c;
  old := c(usize(0)).replace_with(v => {
    c2.clear();
    _RcTracked(n : (v.n + _rc_cell_drops))
  });
  assert(old.n == i32(3), "replace_with: the old value, read from a live cell");
  assert(_rc_cell_drops == i32(3), "the new value is destroyed with the cell after the call; the old one is held");
  d := _rc_tracked_list(i32(4));
  d2 := d;
  old_d := d(usize(0)).replace({
    d2.clear();
    _RcTracked(n : _rc_cell_drops)
  });
  assert(old_d.n == i32(4), "replace: an argument that drops the last other handle");
  assert(_rc_cell_drops == i32(4), "the new value is destroyed with the cell after the call");
  e := _rc_tracked_list(i32(5));
  e2 := e;
  assert(
    RefCell(_RcTracked).with_mut(&e(usize(0)).*, v => {
      e2.clear();
      _rc_cell_drops + (v.n - v.n)
    }) == i32(4),
    "a `&` argument through the handle"
  );
  assert(_rc_cell_drops == i32(5), "destroyed once, after the call");
});
test("a body naming the container its cell is lent from is E0910", {
  comptime_expect_error({
    xs := _rc_tracked_list(i32(1));
    xs(usize(0)).with_mut(v => {
      xs.clear();
    })
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    xs := _rc_tracked_list(i32(1));
    xs(usize(0)).replace_with(v => {
      xs.clear();
      _RcTracked(n : v.n)
    })
  }, "an earlier argument of the same call lends to it");
});
test("RefCell is Send when T is, never Sync, so Arc(RefCell(T)) is rejected", {
  comptime_assert(Type.impls(RefCell(i32), Send), "RefCell(i32) is Send");
  comptime_assert(!Type.impls(RefCell(i32), Sync), "RefCell(i32) is not Sync");
  comptime_assert(!Type.impls(RefCell(Rc(i32)), Send), "RefCell(Rc(i32)) is not Send");
  comptime_expect_error(Arc(RefCell(i32)));
});
// A capture-free closure in a generic method is minted once per instantiation
// of that method. Each mint must keep its own capture struct: codegen calls a
// closure through the function its capture struct maps to, and one struct
// shared by the `Ch(i32)` and `Ch(u8)` mints sent both `with_mut` calls to
// one of them, so the C compiler rejected the program. The `Tx` case reaches
// `Ch._add` from another generic impl's definition-time trial first
// (issues/fixed/2026-10-17-a-closure-in-a-generic-method-first-reached-from-another-generic-impl-is-emitted-at-the-trial-type.md).
_CsSt :: (fn(comptime(Item) : Type) -> comptime(Type))(struct(n : usize, x : Option(Item)));
_CsCh :: (fn(comptime(Item) : Type) -> comptime(Type))(struct(_st : Rc(RefCell(_CsSt(Item)))));
impl(
  generic(Item : Type),
  _CsCh(Item),
  new : (fn() -> Self)(Self(_st : rc(RefCell(_CsSt(Item)).new(_CsSt(Item)(n : usize(0), x : Option(Item).None))))),
  _add : (fn(self : &Self) -> unit)(
    self._st.with_mut(s => {
      s.n = (s.n + usize(1));
    })
  ),
  count : (fn(self : &Self) -> usize)(self._st.with(s => s.n))
);
_CsTx :: (fn(comptime(T) : Type) -> comptime(Type))(struct(_ch : _CsCh(T)));
impl(
  generic(T : Type),
  _CsTx(T),
  _attach : (fn(ch : &_CsCh(T)) -> Self)({
    ch._add();
    Self(_ch : ch)
  })
);
test("a closure in a generic method keeps its own capture struct per instantiation", {
  c := _CsCh(i32).new();
  c._add();
  d := _CsCh(u8).new();
  d._add();
  d._add();
  assert(c.count() == usize(1), "the i32 instance counted once");
  assert(d.count() == usize(2), "the u8 instance counted twice");
});
test("a closure in a generic method reached from another generic impl first", {
  c := _CsCh(i64).new();
  t := _CsTx(i64)._attach(&c);
  c._add();
  assert(c.count() == usize(2), "the attach and the direct call both counted");
  assert(t._ch.count() == usize(2), "one shared cell");
});
