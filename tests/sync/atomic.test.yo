  assert(a.load(MemoryOrder.Acquire) == u32(11), "0b1000 | 0b0011 == 0b1011");
  assert(a.fetch_xor(u32(6), MemoryOrder.Consume) == u32(11), "fetch_xor returns previous");
  assert(a.load(MemoryOrder.Acquire) == u32(13), "0b1011 ^ 0b0110 == 0b1101");
});
test("AtomicU32 fetch_min / fetch_max", {
  a := AtomicU32(u32(13));
  assert(a.fetch_min(u32(9), MemoryOrder.AcqRel) == u32(13), "fetch_min returns previous");
  assert(a.load(MemoryOrder.Acquire) == u32(9), "fetch_min stores the smaller value");
  assert(a.fetch_min(u32(40), MemoryOrder.AcqRel) == u32(9), "fetch_min still returns previous");
  assert(a.load(MemoryOrder.Acquire) == u32(9), "fetch_min keeps the smaller value");
  assert(a.fetch_max(u32(40), MemoryOrder.AcqRel) == u32(9), "fetch_max returns previous");
  assert(a.load(MemoryOrder.Acquire) == u32(40), "fetch_max stores the larger value");
  assert(a.fetch_max(u32(2), MemoryOrder.AcqRel) == u32(40), "fetch_max still returns previous");
  assert(a.load(MemoryOrder.Acquire) == u32(40), "fetch_max keeps the larger value");
});
test("AtomicU32 wraps like the runtime operator", {
  (seed : u32) = u32(4294967295);
  a := AtomicU32(seed);
  assert(a.fetch_add(u32(1), MemoryOrder.Relaxed) == seed, "fetch_add returns previous");
  (expected : u32) = (seed + u32(1));
  assert(a.load(MemoryOrder.Relaxed) == expected, "MAX + 1 wraps exactly like the runtime +");
  assert(a.load(MemoryOrder.Relaxed) == u32(0), "MAX + 1 is 0");
});

