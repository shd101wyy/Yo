  a := AtomicIsize(isize(12));
  assert(a.fetch_add(isize(5), MemoryOrder.AcqRel) == isize(12), "fetch_add returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(17), "fetch_add stores the sum");
  assert(a.fetch_sub(isize(4), MemoryOrder.Release) == isize(17), "fetch_sub returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(13), "fetch_sub stores the difference");
});
test("AtomicIsize fetch_and / fetch_or / fetch_xor", {
  a := AtomicIsize(isize(13));
  assert(a.fetch_and(isize(10), MemoryOrder.SeqCst) == isize(13), "fetch_and returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(8), "0b1101 & 0b1010 == 0b1000");
  assert(a.fetch_or(isize(3), MemoryOrder.Relaxed) == isize(8), "fetch_or returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(11), "0b1000 | 0b0011 == 0b1011");
  assert(a.fetch_xor(isize(6), MemoryOrder.Consume) == isize(11), "fetch_xor returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(13), "0b1011 ^ 0b0110 == 0b1101");
});
test("AtomicIsize fetch_min / fetch_max", {
  a := AtomicIsize(isize(13));
  assert(a.fetch_min(isize(9), MemoryOrder.AcqRel) == isize(13), "fetch_min returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(9), "fetch_min stores the smaller value");
  assert(a.fetch_min(isize(40), MemoryOrder.AcqRel) == isize(9), "fetch_min still returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(9), "fetch_min keeps the smaller value");
  assert(a.fetch_max(isize(40), MemoryOrder.AcqRel) == isize(9), "fetch_max returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(40), "fetch_max stores the larger value");
  assert(a.fetch_max(isize(2), MemoryOrder.AcqRel) == isize(40), "fetch_max still returns previous");
  assert(a.load(MemoryOrder.Acquire) == isize(40), "fetch_max keeps the larger value");
});
test("AtomicIsize fetch_min / fetch_max are signed comparisons", {
  a := AtomicIsize(isize(-(5)));
  assert(a.fetch_max(isize(3), MemoryOrder.SeqCst) == isize(-(5)), "fetch_max returns previous");
  assert(a.load(MemoryOrder.SeqCst) == isize(3), "3 > -5");
  b := AtomicIsize(isize(-(5)));
  assert(b.fetch_min(isize(3), MemoryOrder.SeqCst) == isize(-(5)), "fetch_min returns previous");
  assert(b.load(MemoryOrder.SeqCst) == isize(-(5)), "-5 < 3");
});
test("AtomicIsize wraps like the runtime operator", {
  (seed : isize) = isize(0);
  a := AtomicIsize(seed);
  assert(a.fetch_sub(isize(1), MemoryOrder.Relaxed) == isize(0), "fetch_sub returns previous");
  (expected : isize) = (seed - isize(1));
  assert(a.load(MemoryOrder.Relaxed) == expected, "0 - 1 wraps exactly like the runtime -");
});

// ============================================================================
// Contention: the fetch_add / fetch_sub family
// ============================================================================
test("AtomicI64 fetch_add under four-thread contention", {
  if(arch == Arch.Wasm32, return(()));
  counter := AtomicI64(i64(0));
  iterations := i64(5000);
  spin :: (fn(c : AtomicI64, n : i64) -> unit)({
    (i : i64) = i64(0);
    while(runtime(i < n), {
      c.fetch_add(i64(1), MemoryOrder.Relaxed);
      i = (i + i64(1));
    });
  });
  t1 := Thread.spawn((io) => spin(counter, iterations));
  t2 := Thread.spawn((io) => spin(counter, iterations));
  t3 := Thread.spawn((io) => spin(counter, iterations));
  spin(counter, iterations);
  t1.join();
  t2.join();
  t3.join();
  assert(counter.load(MemoryOrder.Acquire) == (iterations * i64(4)), "no increment may be lost");
});
test("AtomicU64 fetch_sub under four-thread contention", {
  if(arch == Arch.Wasm32, return(()));
  iterations := u64(5000);
  counter := AtomicU64(iterations * u64(4));
  drain :: (fn(c : AtomicU64, n : u64) -> unit)({
    (i : u64) = u64(0);
    while(runtime(i < n), {
      c.fetch_sub(u64(1), MemoryOrder.Relaxed);
      i = (i + u64(1));
    });
  });
  t1 := Thread.spawn((io) => drain(counter, iterations));
  t2 := Thread.spawn((io) => drain(counter, iterations));
  t3 := Thread.spawn((io) => drain(counter, iterations));
  drain(counter, iterations);
  t1.join();
  t2.join();
  t3.join();
  assert(counter.load(MemoryOrder.Acquire) == u64(0), "no decrement may be lost");
});
test("AtomicUsize fetch_add under four-thread contention", {
  if(arch == Arch.Wasm32, return(()));
  counter := AtomicUsize(usize(0));
  iterations := usize(5000);
  spin :: (fn(c : AtomicUsize, n : usize) -> unit)({
    (i : usize) = usize(0);
    while(runtime(i < n), {
      c.fetch_add(usize(1), MemoryOrder.Relaxed);
      i = (i + usize(1));
    });
  });
  t1 := Thread.spawn((io) => spin(counter, iterations));
  t2 := Thread.spawn((io) => spin(counter, iterations));
  t3 := Thread.spawn((io) => spin(counter, iterations));
  spin(counter, iterations);
  t1.join();
  t2.join();
  t3.join();
  assert(counter.load(MemoryOrder.Acquire) == (iterations * usize(4)), "no increment may be lost");
});

// ============================================================================
// Contention: the bitwise family
// ============================================================================
test("AtomicU32 fetch_or / fetch_and under four-thread contention", {
  if(arch == Arch.Wasm32, return(()));
  // `or`/`and` are idempotent, so a LOST read-modify-write is invisible in
  // the final value — converging to the same fixed point proves nothing.
  // What it cannot hide is a broken per-bit invariant: thread i owns bit i,
  // sets it, then immediately clears it, and nobody else ever touches that
  // bit. So every `fetch_or` this thread performs MUST report the bit clear.
  // A dropped `fetch_and` leaves the bit standing and the next `fetch_or`
  // sees it. Each thread reports into its OWN atomic (single writer, so the
  // report cannot itself be lost to contention).
  bits := AtomicU32(u32(0));
  iterations := u32(4000);
  v0 := AtomicU32(u32(0));
  v1 := AtomicU32(u32(0));
  v2 := AtomicU32(u32(0));
  v3 := AtomicU32(u32(0));
  toggle :: (
    fn(c : AtomicU32, report : AtomicU32, bit : u32, keep : u32, n : u32) -> unit
  )({
    (i : u32) = u32(0);
    while(runtime(i < n), {
      prev := c.fetch_or(bit, MemoryOrder.AcqRel);
      if((prev & bit) != u32(0), {
        report.store(u32(1), MemoryOrder.Release);
      });
      c.fetch_and(keep, MemoryOrder.AcqRel);
      i = (i + u32(1));
    });
  });
  t1 := Thread.spawn((io) => toggle(bits, v1, u32(2), u32(4294967293), iterations));
  t2 := Thread.spawn((io) => toggle(bits, v2, u32(4), u32(4294967291), iterations));
  t3 := Thread.spawn((io) => toggle(bits, v3, u32(8), u32(4294967287), iterations));
  toggle(bits, v0, u32(1), u32(4294967294), iterations);
  t1.join();
  t2.join();
  t3.join();
  assert(v0.load(MemoryOrder.Acquire) == u32(0), "thread 0 saw its own bit already set");
  assert(v1.load(MemoryOrder.Acquire) == u32(0), "thread 1 saw its own bit already set");
  assert(v2.load(MemoryOrder.Acquire) == u32(0), "thread 2 saw its own bit already set");
  assert(v3.load(MemoryOrder.Acquire) == u32(0), "thread 3 saw its own bit already set");
  assert(bits.load(MemoryOrder.Acquire) == u32(0), "every clear must survive");
});
test("AtomicU16 fetch_xor under four-thread contention", {
  if(arch == Arch.Wasm32, return(()));
  // Each thread flips the same mask an EVEN number of times, so a
  // sequentially-consistent run returns to the initial value. Any lost
  // read-modify-write leaves the flip unpaired and the result non-zero.
  flags := AtomicU16(u16(0));
  iterations := u16(5000);
  flip :: (fn(c : AtomicU16, mask : u16, n : u16) -> unit)({
    (i : u16) = u16(0);
    while(runtime(i < n), {
      c.fetch_xor(mask, MemoryOrder.AcqRel);
      i = (i + u16(1));
    });
  });
  t1 := Thread.spawn((io) => flip(flags, u16(43981), iterations));
  t2 := Thread.spawn((io) => flip(flags, u16(43981), iterations));
  t3 := Thread.spawn((io) => flip(flags, u16(4660), iterations));
  flip(flags, u16(4660), iterations);
  t1.join();
  t2.join();
  t3.join();
  assert(flags.load(MemoryOrder.Acquire) == u16(0), "paired flips must cancel exactly");
});

// ============================================================================
// Contention: the min / max family
// ============================================================================
test("AtomicI32 fetch_min / fetch_max under four-thread contention", {
  if(arch == Arch.Wasm32, return(()));
  // min and max are idempotent too, so the extremes alone are a weak oracle.
  // The property that survives ANY interleaving is monotonicity: once a
  // thread has run `hi.fetch_max(v)`, `hi` is >= v forever, and likewise
  // `lo` is <= v after `lo.fetch_min(v)`. A dropped read-modify-write breaks
  // exactly that. Each thread reports into its OWN atomic (single writer).
  lowest := AtomicI32(i32(1000000));
  highest := AtomicI32(i32(-(1000000)));
  v0 := AtomicI32(i32(0));
  v1 := AtomicI32(i32(0));
  v2 := AtomicI32(i32(0));
  v3 := AtomicI32(i32(0));
  push :: (
    fn(lo : AtomicI32, hi : AtomicI32, report : AtomicI32, base : i32, n : i32) -> unit
  )({
    (i : i32) = i32(0);
    while(runtime(i < n), {
      v := (base + i);
      lo.fetch_min(v, MemoryOrder.AcqRel);
      if(lo.load(MemoryOrder.Acquire) > v, {
        report.store(i32(1), MemoryOrder.Release);
      });
      hi.fetch_max(v, MemoryOrder.AcqRel);
      if(hi.load(MemoryOrder.Acquire) < v, {
        report.store(i32(1), MemoryOrder.Release);
      });
      i = (i + i32(1));
    });
  });
  t1 := Thread.spawn((io) => push(lowest, highest, v1, i32(1000), i32(1000)));
  t2 := Thread.spawn((io) => push(lowest, highest, v2, i32(2000), i32(1000)));
  t3 := Thread.spawn((io) => push(lowest, highest, v3, i32(3000), i32(1000)));
  push(lowest, highest, v0, i32(0), i32(1000));
  t1.join();
  t2.join();
  t3.join();
  assert(v0.load(MemoryOrder.Acquire) == i32(0), "thread 0 observed a lost min/max");
  assert(v1.load(MemoryOrder.Acquire) == i32(0), "thread 1 observed a lost min/max");
  assert(v2.load(MemoryOrder.Acquire) == i32(0), "thread 2 observed a lost min/max");
  assert(v3.load(MemoryOrder.Acquire) == i32(0), "thread 3 observed a lost min/max");
  assert(lowest.load(MemoryOrder.Acquire) == i32(0), "the global minimum must win");
  assert(highest.load(MemoryOrder.Acquire) == i32(3999), "the global maximum must win");
});

// ============================================================================
// fence
// ============================================================================
test("fence accepts every ordering", {
  fence(MemoryOrder.Relaxed);
  fence(MemoryOrder.Consume);
  fence(MemoryOrder.Acquire);
  fence(MemoryOrder.Release);
  fence(MemoryOrder.AcqRel);
  fence(MemoryOrder.SeqCst);
});
test("fence publishes a relaxed store across threads", {
  if(arch == Arch.Wasm32, return(()));
  // The classic message-passing shape with RELAXED accesses on both sides:
  // ordering comes only from the fences. `data` is written before the
  // release fence and the flag; the reader's acquire fence after seeing the
  // flag must therefore observe the payload.
  data := AtomicI64(i64(0));
  ready := AtomicBool(false);
  observed := AtomicI64(i64(-(1)));
  writer := Thread.spawn((io) => {
    data.store(i64(424242), MemoryOrder.Relaxed);
    fence(MemoryOrder.Release);
    ready.store(true, MemoryOrder.Relaxed);
  });
  while(runtime(!(ready.load(MemoryOrder.Relaxed))), {
    ();
  });
  fence(MemoryOrder.Acquire);
  observed.store(data.load(MemoryOrder.Relaxed), MemoryOrder.Relaxed);
  writer.join();
  assert(observed.load(MemoryOrder.Acquire) == i64(424242), "the acquire fence must see the payload");
});
