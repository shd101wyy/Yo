// AtomicU64 read-modify-write family
// ============================================================================
test("AtomicU64 fetch_add / fetch_sub", {
  a := AtomicU64(u64(12));
  assert(a.fetch_add(u64(5), MemoryOrder.AcqRel) == u64(12), "fetch_add returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(17), "fetch_add stores the sum");
  assert(a.fetch_sub(u64(4), MemoryOrder.Release) == u64(17), "fetch_sub returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(13), "fetch_sub stores the difference");
});
test("AtomicU64 fetch_and / fetch_or / fetch_xor", {
  a := AtomicU64(u64(13));
  assert(a.fetch_and(u64(10), MemoryOrder.SeqCst) == u64(13), "fetch_and returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(8), "0b1101 & 0b1010 == 0b1000");
  assert(a.fetch_or(u64(3), MemoryOrder.Relaxed) == u64(8), "fetch_or returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(11), "0b1000 | 0b0011 == 0b1011");
  assert(a.fetch_xor(u64(6), MemoryOrder.Consume) == u64(11), "fetch_xor returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(13), "0b1011 ^ 0b0110 == 0b1101");
});
test("AtomicU64 fetch_min / fetch_max", {
  a := AtomicU64(u64(13));
  assert(a.fetch_min(u64(9), MemoryOrder.AcqRel) == u64(13), "fetch_min returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(9), "fetch_min stores the smaller value");
  assert(a.fetch_min(u64(40), MemoryOrder.AcqRel) == u64(9), "fetch_min still returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(9), "fetch_min keeps the smaller value");
  assert(a.fetch_max(u64(40), MemoryOrder.AcqRel) == u64(9), "fetch_max returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(40), "fetch_max stores the larger value");
  assert(a.fetch_max(u64(2), MemoryOrder.AcqRel) == u64(40), "fetch_max still returns previous");
  assert(a.load(MemoryOrder.Acquire) == u64(40), "fetch_max keeps the larger value");
});
test("AtomicU64 wraps like the runtime operator", {
  (seed : u64) = u64(18446744073709551615);
  a := AtomicU64(seed);
  assert(a.fetch_add(u64(1), MemoryOrder.Relaxed) == seed, "fetch_add returns previous");
  (expected : u64) = (seed + u64(1));
  assert(a.load(MemoryOrder.Relaxed) == expected, "MAX + 1 wraps exactly like the runtime +");
  assert(a.load(MemoryOrder.Relaxed) == u64(0), "MAX + 1 is 0");
});

