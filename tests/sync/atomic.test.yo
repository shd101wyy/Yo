/// Phase C (THREAD_SAFETY): Atomic* wrappers runtime tests.
{ assert } :: import("std/assert");
{
  AtomicBool,
  AtomicI8,
  AtomicI16,
  AtomicI32,
  AtomicI64,
  AtomicU8,
  AtomicU16,
  AtomicU32,
  AtomicU64,
  AtomicUsize,
  AtomicIsize,
  MemoryOrder,
  fence
} :: import("std/sync/atomic");
{ Thread } :: import("std/thread");
{ arch, Arch } :: import("std/process");

// ============================================================================
// AtomicBool
// ============================================================================
test("AtomicBool new and load", {
  a := AtomicBool(false);
  assert(a.load(MemoryOrder.Relaxed) == false, "initial value should be false");
  b := AtomicBool(true);
  assert(b.load(MemoryOrder.Relaxed) == true, "initial value should be true");
});
test("AtomicBool store and load", {
  a := AtomicBool(false);
  a.store(true, MemoryOrder.Release);
  assert(a.load(MemoryOrder.Acquire) == true, "should see stored value");
  a.store(false, MemoryOrder.Release);
  assert(a.load(MemoryOrder.Acquire) == false, "should see stored false");
});
test("AtomicBool swap", {
  a := AtomicBool(false);
  prev := a.swap(true, MemoryOrder.AcqRel);
  assert(prev == false, "swap should return previous value");
  assert(a.load(MemoryOrder.Relaxed) == true, "should have new value");
});
test("AtomicBool compare_exchange", {
  a := AtomicBool(false);
  expected := false;
  ok := a.compare_exchange(expected, true, MemoryOrder.Release, MemoryOrder.Relaxed);
  assert(ok, "CAS should succeed with matching expected");
  assert(a.load(MemoryOrder.Relaxed) == true, "should have new value");
  expected = false;
  ok = a.compare_exchange(expected, true, MemoryOrder.Release, MemoryOrder.Relaxed);
  assert(!(ok), "CAS should fail with mismatched expected");
  assert(expected == true, "expected should be updated to current value");
});

// ============================================================================
// AtomicI32
// ============================================================================
test("AtomicI32 new and load", {
  a := AtomicI32(i32(0));
  assert(a.load(MemoryOrder.Relaxed) == i32(0), "initial value should be 0");
  b := AtomicI32(i32(42));
  assert(b.load(MemoryOrder.Relaxed) == i32(42), "initial value should be 42");
});
test("AtomicI32 store and load", {
  a := AtomicI32(i32(0));
  a.store(i32(99), MemoryOrder.Release);
  assert(a.load(MemoryOrder.Acquire) == i32(99), "should see stored value");
});
test("AtomicI32 swap", {
  a := AtomicI32(i32(1));
  prev := a.swap(i32(100), MemoryOrder.AcqRel);
  assert(prev == i32(1), "swap should return previous value");
  assert(a.load(MemoryOrder.Relaxed) == i32(100), "should have new value");
});
test("AtomicI32 compare_exchange success", {
  a := AtomicI32(i32(0));
  expected := i32(0);
  ok := a.compare_exchange(expected, i32(1), MemoryOrder.Release, MemoryOrder.Relaxed);
  assert(ok, "CAS should succeed");
  assert(a.load(MemoryOrder.Relaxed) == i32(1), "should have new value");
});
test("AtomicI32 compare_exchange failure", {
  a := AtomicI32(i32(5));
  expected := i32(0);
  ok := a.compare_exchange(expected, i32(1), MemoryOrder.Release, MemoryOrder.Relaxed);
  assert(!(ok), "CAS should fail");
  assert(expected == i32(5), "expected should be updated");
  assert(a.load(MemoryOrder.Relaxed) == i32(5), "value unchanged");
});

// ============================================================================
// AtomicI32 cross-thread counter
// ============================================================================
test("AtomicI32 cross-thread counter", {
  if(arch == Arch.Wasm32, return(()));
  counter := AtomicI32(i32(0));
  iterations := i32(1000);
  t := Thread.spawn((io) => {
    (i : i32) = i32(0);
    while(runtime(i < iterations), {
      counter.fetch_add(i32(1), MemoryOrder.Relaxed);
      i = (i + i32(1));
    });
  });
  (j : i32) = i32(0);
  while(runtime(j < iterations), {
    counter.fetch_add(i32(1), MemoryOrder.Relaxed);
    j = (j + i32(1));
  });
  t.join();
  expected := (iterations * i32(2));
  result := counter.load(MemoryOrder.Relaxed);
  assert(result == expected, "counter should reflect both threads");
});

// ============================================================================
// AtomicI64
// ============================================================================
test("AtomicI64 store and load", {
  a := AtomicI64(i64(0));
  a.store(i64(123456789), MemoryOrder.Release);
  assert(a.load(MemoryOrder.Acquire) == i64(123456789), "should read back i64");
});

// ============================================================================
// AtomicUsize
// ============================================================================
test("AtomicUsize store and load", {
  a := AtomicUsize(usize(0));
  a.store(usize(999), MemoryOrder.Release);
  assert(a.load(MemoryOrder.Acquire) == usize(999), "should read back usize");
});

// ============================================================================
// AtomicIsize
// ============================================================================
test("AtomicIsize store and load", {
  a := AtomicIsize(isize(0));
  a.store(isize(-(42)), MemoryOrder.Release);
  assert(a.load(MemoryOrder.Acquire) == isize(-(42)), "should read back isize");
});

// ============================================================================
// AtomicI8 read-modify-write family
// ============================================================================
test("AtomicI8 fetch_add / fetch_sub", {
  a := AtomicI8(i8(12));
  assert(a.fetch_add(i8(5), MemoryOrder.AcqRel) == i8(12), "fetch_add returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(17), "fetch_add stores the sum");
  assert(a.fetch_sub(i8(4), MemoryOrder.Release) == i8(17), "fetch_sub returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(13), "fetch_sub stores the difference");
});
test("AtomicI8 fetch_and / fetch_or / fetch_xor", {
  a := AtomicI8(i8(13));
  assert(a.fetch_and(i8(10), MemoryOrder.SeqCst) == i8(13), "fetch_and returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(8), "0b1101 & 0b1010 == 0b1000");
  assert(a.fetch_or(i8(3), MemoryOrder.Relaxed) == i8(8), "fetch_or returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(11), "0b1000 | 0b0011 == 0b1011");
  assert(a.fetch_xor(i8(6), MemoryOrder.Consume) == i8(11), "fetch_xor returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(13), "0b1011 ^ 0b0110 == 0b1101");
});
test("AtomicI8 fetch_min / fetch_max", {
  a := AtomicI8(i8(13));
  assert(a.fetch_min(i8(9), MemoryOrder.AcqRel) == i8(13), "fetch_min returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(9), "fetch_min stores the smaller value");
  assert(a.fetch_min(i8(40), MemoryOrder.AcqRel) == i8(9), "fetch_min still returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(9), "fetch_min keeps the smaller value");
  assert(a.fetch_max(i8(40), MemoryOrder.AcqRel) == i8(9), "fetch_max returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(40), "fetch_max stores the larger value");
  assert(a.fetch_max(i8(2), MemoryOrder.AcqRel) == i8(40), "fetch_max still returns previous");
  assert(a.load(MemoryOrder.Acquire) == i8(40), "fetch_max keeps the larger value");
});
test("AtomicI8 fetch_min / fetch_max are signed comparisons", {
  a := AtomicI8(i8(-(5)));
  assert(a.fetch_max(i8(3), MemoryOrder.SeqCst) == i8(-(5)), "fetch_max returns previous");
  assert(a.load(MemoryOrder.SeqCst) == i8(3), "3 > -5");
  b := AtomicI8(i8(-(5)));
  assert(b.fetch_min(i8(3), MemoryOrder.SeqCst) == i8(-(5)), "fetch_min returns previous");
  assert(b.load(MemoryOrder.SeqCst) == i8(-(5)), "-5 < 3");
});
test("AtomicI8 wraps like the runtime operator", {
  (seed : i8) = i8(127);
  a := AtomicI8(seed);
  assert(a.fetch_add(i8(1), MemoryOrder.Relaxed) == seed, "fetch_add returns previous");
  (expected : i8) = (seed + i8(1));
  assert(a.load(MemoryOrder.Relaxed) == expected, "MAX + 1 wraps exactly like the runtime +");
  assert(a.load(MemoryOrder.Relaxed) < i8(0), "MAX + 1 is negative");
});

