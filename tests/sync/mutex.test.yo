/// Phase D (THREAD_SAFETY): Mutex(T) compile-time correctness verification.
/// Runtime with_lock tests deferred pending closure ref-parameter codegen fix
/// (caller needs to auto-emit &arg for ref(v):T parameters).
{ Mutex } :: import("std/sync/mutex");

// ============================================================================
// Compile-time: Mutex(T) type is valid and correct
// ============================================================================
comptime_assert(
  Type.impls(Mutex(i32), Send),
  "Mutex(i32) should be Send"
);
comptime_assert(
  Type.impls(Mutex(bool), Send),
  "Mutex(bool) should be Send"
);

// ============================================================================
// Compile-time: Mutex with non-Send T is rejected
// ============================================================================
comptime_expect_error({
  NonSendObj :: object(x : i32);
  Bad :: Mutex(NonSendObj);
});

// ============================================================================
// Compile-time: with_lock signature is correct
// ============================================================================
comptime_assert(
  Type.impls(Mutex(i32), Send),
  "Mutex(i32) should be Send"
);
