/// Phase D (THREAD_SAFETY): Mutex(T) with_lock closure-scoped API tests.
{ assert } :: import("std/assert");
{ Mutex } :: import("std/sync/mutex");

// ============================================================================
// Compile-time checks
// ============================================================================
comptime_assert(
  Type.impls(Mutex(i32), Send),
  "Mutex(i32) should be Send"
);
comptime_expect_error({
  NonSendObj :: ref(struct(x : i32));
  Bad :: Mutex(NonSendObj);
});

// ============================================================================
// Runtime: with_lock basic operations
// ============================================================================
test("Mutex new and with_lock read", {
  m := Mutex(i32).new(i32(42));
  result := m.with_lock((v) => v);
  assert(result == i32(42), "should read initial value");
});
test("Mutex with_lock write and read back", {
  m := Mutex(i32).new(i32(0));
  result := m.with_lock((v) => {
    v = i32(99);
    v
  });
  assert(result == i32(99), "should see written value");
});
test("Mutex with_lock return value", {
  m := Mutex(i32).new(i32(7));
  doubled := m.with_lock((v) => (v * i32(2)));
  assert(doubled == i32(14), "with_lock should propagate return value");
});
// Regression for issues/fixed/generic-r-callback-with-unit-closure-emits-void-star-temp.md.
//
// A `with_lock` body that ends in a STATEMENT binds the callback's generic `R`
// to unit. Codegen used to declare a `void*` temp for the call and initialize
// it from a `void`-returning C function — "initializing 'void *' with an
// expression of incompatible type 'void'" — so the flagship std/sync form did
// not C-compile at all. `yo check` and `--emit-c` both passed; only clang
// caught it, and no test exercised the shape, so nothing in the battery could.
test("Mutex with_lock body may end in a statement (unit R)", {
  m := Mutex(i32).new(i32(0));
  m.with_lock((v) => {
    v = i32(42);
  });
  assert(m.with_lock((v) => v) == i32(42), "the unit-bodied write landed");
});
// O7 residual (plans/STD_API_AUDIT.md §8): the sync containers carry the same
// Acyclic requirement as the imm family — atomic RC cannot collect cycles, so
// a cyclic ATOMIC payload would leak silently and unavoidably.
test("O7: a cyclic element type is rejected — atomic RC cannot collect cycles", {
  // atomic() so the payload IS Send — a plain ref struct fails the Send bound
  // first and the expect-error would pass vacuously without touching Acyclic.
  CyclicNode :: atomic(ref(struct(v : i32, next : Option(Self))));
  comptime_assert(Type.impls(CyclicNode, Send), "the pin payload must be Send so the error is Acyclic's");
  comptime_expect_error(Mutex(CyclicNode));
  assert(true, "rejected at comptime");
});
