pragma(Pragma.SkipWasm32Wasi); // the atomic handle's thread test needs pthreads
//! Cell handles (plans/VALUES_BY_DEFAULT.md §3.5, "V5's seed predicates"):
//! a newtype whose one field `_cell` is `__yo_cell(V)` or
//! `__yo_atomic_cell(V)` is the shape V5 gives `Rc` and `Arc`. The compiler
//! treats it as those cells by structure, so the wrappers of
//! tests/fixtures/cell_handles.yo stand in for them here. This file is SAFE:
//! E0919 and D3 must fire where user code runs.
{ TRc, TArc, trc, tarc, TLocked, tlocked } :: import("./fixtures/cell_handles.yo");
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ yield } :: import("std/async");
{ Thread } :: import("std/thread");
_P :: struct(x : i32, items : ArrayList(i32));
_p :: (fn(x : i32) -> _P)(_P(x : x, items : ArrayList(i32).new()));
impl(
  _P,
  doubled : (fn(self : &Self) -> i32)((self.x * i32(2))),
  bump : (fn(self : &mut Self) -> unit)({
    self.x = (self.x + i32(1));
  })
);
_read_p :: (fn(p : &_P) -> i32)(p.x);
_bump_p :: (fn(p : &mut _P) -> unit)({
  p.x = (p.x + i32(1));
});
test("S17/S18: .* reads the payload of a cell handle", {
  h := trc(i32(5));
  assert(h.* == i32(5), "the payload through the handle");
  p := trc(_p(i32(3)));
  assert(p.*.x == i32(3), "a field of the payload");
  assert(_read_p(&p.*) == i32(3), "the payload lent &");
  q := p;
  assert(q.*.x == i32(3), "a copy reads the same payload");
  a := tarc(i32(9));
  assert(a.* == i32(9), "the payload through an atomic handle");
});
test("S17 with D2: a cell handle auto-dereferences to its payload's fields and methods", {
  p := trc(_p(i32(4)));
  assert(p.x == i32(4), "p.x is p.*.x");
  assert(p.doubled() == i32(8), "p.doubled() is p.*.doubled()");
  a := tarc(_p(i32(6)));
  assert(a.x == i32(6), "through the atomic handle");
  assert(a.doubled() == i32(12), "a method through the atomic handle");
});
test("S1/S9/S10: a write through a cell handle is E0919", {
  h := trc(_p(i32(1)));
  comptime_expect_error(h.*.x = i32(2), "read-only through the handle");
  comptime_expect_error(h.* = _p(i32(2)), "read-only through the handle");
  comptime_expect_error(_bump_p(&mut h.*), "read-only through the handle");
  comptime_expect_error(h.*.bump(), "read-only through the handle");
  comptime_expect_error(h.bump(), "read-only through the handle");
  comptime_expect_error(h.x = i32(3), "read-only through the handle");
  // A safe file's local borrow names the payload's field through
  // auto-dereference (a `*` hop in a local borrow is unsafe-only).
  comptime_expect_error({
    m := &mut h.x;
    ()
  }, "read-only through the handle");
  assert(h.*.x == i32(1), "nothing wrote the payload");
});
_HoldsArc :: struct(a : TArc(_P));
test("S11/S12: a write through an atomic cell handle is D3 in safe code", {
  a := tarc(_p(i32(1)));
  comptime_expect_error(a.*.x = i32(2), "atomic object");
  comptime_expect_error(_bump_p(&mut a.*), "atomic object");
  s := _HoldsArc(a : a);
  comptime_expect_error(s.a.*.x = i32(3), "atomic object");
  assert(a.*.x == i32(1), "nothing wrote the payload");
});
test("S19: ref_count counts the handles, not the constant 1", {
  h := trc(i32(1));
  assert(ref_count(h) == usize(1), "one handle");
  (o : Option(TRc(i32))) = .Some(h);
  assert(ref_count(h) == usize(2), `two handles: ${ref_count(h)}`);
  match(o, .Some(g) => assert(g.* == i32(1), "the Option's handle reads the payload"), .None => assert(false, "a handle"));
  a := tarc(i32(2));
  b := a;
  assert(ref_count(a) == usize(2), `two atomic handles: ${ref_count(a)}`);
  assert(b.* == i32(2), "the copy");
});
test("D3: a struct over an atomic cell is not a handle", {
  l := tlocked(i32(1));
  m := l;
  assert(ref_count(l) == usize(1), "a value struct is not counted, whatever it holds");
  comptime_expect_error(l.*, "No field");
});
test("S3: Option of a cell handle keeps the one-pointer niche; of an atomic one, the tag", {
  assert(size_of(TRc(i32)) == size_of(usize), "a handle is one pointer");
  assert(size_of(Option(TRc(i32))) == size_of(TRc(i32)), "niche");
  assert(size_of(Option(TArc(i32))) > size_of(TArc(i32)), "tagged");
  (none : Option(TRc(i32))) = .None;
  assert(none.is_none(), "NULL is .None");
  some := Option(TRc(i32)).Some(trc(i32(7)));
  assert(match(some, .Some(h) => (h.* == i32(7)), .None => false), "the payload through the folded Option");
});
test("S13: a borrow of a place in a handle's payload pins the cell", {
  h := trc(_p(i32(2)));
  {
    x := &h.x;
    assert(ref_count(h) == usize(2), `the borrow's pin holds the cell: ${ref_count(h)}`);
    assert(x == i32(2), "read through the borrow");
  };
  assert(ref_count(h) == usize(1), "the pin was released at the borrow's scope end");
});
_Area :: trait(area : (fn(self : &Self) -> i32));
_Sq :: struct(s : i32);
impl(_Sq, _Area(area : (fn(self : &Self) -> i32)((self.s * self.s))));
test("S20-S22: dyn of a cell handle dispatches to its payload", {
  (d : Dyn(_Area)) = dyn(trc(_Sq(s : i32(2))));
  assert(d.area() == i32(4), "dispatched to _Sq through the handle");
  match(downcast(d, _Sq), .Some(sq) => assert(sq.s == i32(2), "the payload"), .None => assert(false, "a _Sq"));
  (e : Dyn(_Area, Send)) = dyn(tarc(_Sq(s : i32(3))));
  assert(e.area() == i32(9), "an atomic handle in a Send Dyn");
  t := Thread(i32).spawn(io => e.area());
  assert(t.join() == i32(9), "dispatched on another thread");
  comptime_expect_error({
    (f : Dyn(_Area, Send)) = dyn(trc(_Sq(s : i32(1))));
    f
  }, "must be atomically reference counted");
});
_count_later :: (fn(items : &ArrayList(i32), io : Io) -> Impl(Future(usize, Io)))(
  io.async({ &items }(io : Io) => {
    io.await(yield(io), io);
    items.len()
  })
);
_push_later :: (fn(items : &mut ArrayList(i32), io : Io) -> Impl(Future(unit, Io)))(
  io.async({ &mut items }(io : Io) => items.push(i32(1)))
);
test("S14: a future may hold a & place lent through a cell handle, not a &mut one", {
  p := _p(i32(0));
  p.items.push(i32(1));
  h := trc(p);
  assert(io.await(_count_later(&h.*.items, io), io) == usize(1), "a & lend through the handle crosses the await");
  comptime_expect_error(io.await(_push_later(&mut h.*.items, io), io), "read-only through the handle");
});
_Node :: struct(v : i32, next : Option(TRc(Self)));
_sum_nodes :: (fn(n : &_Node) -> i32)(
  match(n.next, .Some(h) => (n.v + _sum_nodes(&h.*)), .None => n.v)
);
test("a recursive type through a cell handle", {
  tail := trc(_Node(v : i32(3), next : .None));
  mid := trc(_Node(v : i32(2), next : .Some(tail)));
  head := _Node(v : i32(1), next : .Some(mid));
  assert(_sum_nodes(&head) == i32(6), "built and walked");
  assert(size_of(Option(TRc(_Node))) == size_of(usize), "the link is one pointer");
});
test("S5: a pattern does not look through a cell handle implicitly", {
  h := trc(_p(i32(1)));
  comptime_expect_error(
    match(h, _P(x : x, items : _) => x, _ => i32(0)),
    "does not look through a cell implicitly"
  );
  n := match(h, g => g.*.x);
  assert(n == i32(1), "a binding binds the handle");
});
