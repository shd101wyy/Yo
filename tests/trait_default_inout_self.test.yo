// A trait `?=` default method with an `inout(self)` receiver must see `self`
// by reference in its per-impl materialized body
// (issues/fixed/trait-default-inout-self-bound-by-value.md). Before the fix
// `direct` failed to compile (`self.state` on a pointer) and `twice` silently
// did nothing (`bump` received `&(self)`, a `Counter**`).
{ assert } :: import("std/assert");
Bumpable :: trait(
  bump : (fn(self : &mut Self, v : u64) -> unit),
  peek : (fn(self : &mut Self) -> u64),
  // default calling sibling inout methods
  (twice : (fn(self : &mut Self, v : u64) -> unit)) ?=
    (
      (self, v) -> {
        self.bump(v);
        self.bump(v);
      }
    ),
  // default writing a field through self
  (direct : (fn(self : &mut Self, v : u64) -> unit)) ?=
    (
      (self, v) -> {
        self.state = (self.state + v);
      }
    ),
  // default reading through a sibling
  (ro : (fn(self : &mut Self) -> u64)) ?= (self -> self.peek()),
  // explicit fn spelling of a default
  (thrice : (fn(self : &mut Self, v : u64) -> unit)) ?=
    (fn(self : &mut Self, v : u64) -> unit)({
      self.bump(v);
      self.twice(v);
    }),
  // by-value receiver default — the control that always worked
  (snapshot : (fn(self : &Self) -> u64)) ?= (self -> self.state)
);
Counter :: struct(state : u64);
derive(Counter, Copy, Clone);
impl(
  Counter,
  Bumpable(
    bump : (fn(self : &mut Self, v : u64) -> unit)({
      self.state = (self.state + v);
    }),
    peek : (fn(self : &mut Self) -> u64)(self.state)
  )
);
test("inout(self) default calling sibling inout methods mutates the receiver", {
  mut(c) := Counter(state : u64(0));
  c.twice(u64(1));
  assert(c.state == u64(2), "twice bumped twice");
  c.thrice(u64(5));
  assert(c.state == u64(17), "thrice = bump + twice");
});
test("inout(self) default writing a field through self", {
  mut(c) := Counter(state : u64(1));
  c.direct(u64(10));
  assert(c.state == u64(11), "direct wrote through self");
  assert(c.ro() == u64(11), "ro reads through a sibling");
  assert(c.snapshot() == u64(11), "by-value default still fine");
});
// A ref (heap) receiver takes the other pointer path; it must keep working.
RefCounter :: ref(struct(state : u64));
impl(
  RefCounter,
  Bumpable(
    bump : (fn(self : &mut Self, v : u64) -> unit)({
      self.state = (self.state + v);
    }),
    peek : (fn(self : &mut Self) -> u64)(self.state)
  )
);
test("ref-struct receiver: the same defaults", {
  r := RefCounter(state : u64(0));
  r.twice(u64(3));
  r.direct(u64(1));
  assert(r.state == u64(7), "ref receiver: 3+3+1");
  assert(r.ro() == u64(7), "ref receiver ro");
});
// A default whose receiver is BY VALUE owns it, as a provided method's does:
// it may move a move-only receiver into a sibling that consumes it. Before the
// fix the materialized default bound `self` as a borrow, so the move was E0901
// "it is borrowed", and a default that only read its by-value receiver never
// dropped it (issues/fixed/2026-11-05-a-trait-default-cannot-move-its-by-value-self.md).
{ String } :: import("std/string");
Finish :: trait(
  finish : (fn(self : Self) -> String),
  (finish_twice : (fn(self : Self) -> String)) ?= (self -> Self.finish(self).repeat(usize(2))),
  (label_len : (fn(self : Self) -> usize)) ?= (self -> Self.finish(self).len())
);
Digester :: struct(label : String, n : u64);
impl(
  Digester,
  Finish(
    finish : (fn(self : Self) -> String)(`${self.label}${self.n.to_string()}`)
  )
);
test("by-value self default moves a move-only receiver", {
  h := Digester(label : `h`, n : u64(7));
  assert(h.finish_twice() == `h7h7`, "the default consumed the receiver");
  g := Digester(label : `abc`, n : u64(12));
  assert(g.label_len() == usize(5), "a default reading through a consuming sibling");
});
