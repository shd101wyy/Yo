/// Phase N (THREAD_SAFETY): Negative trait impls — `impl(T, !(Trait))`.
///
/// Negative impls override auto-derive: a type with `impl(MyType, !(Send))`
/// does NOT implement Send, regardless of structural auto-derive.
/// Negative impls do NOT require pragma (they're restrictive, not permissive).
/// Negative impls are only allowed for marker traits (no methods).
// Positive: negative Send impl makes a Send type non-Send.
MySendStruct :: struct(value : i32);
impl(MySendStruct, !Send());
comptime_assert(
  Type.impls(MySendStruct, Send) == false,
  "negative Send impl should override auto-derive"
);

// Positive: negative Acyclic impl works.
MyAcyclicStruct :: struct(value : i32);
impl(MyAcyclicStruct, !Acyclic);
comptime_assert(
  Type.impls(MyAcyclicStruct, Acyclic) == false,
  "negative Acyclic impl should override auto-derive"
);

// Positive: negative impl does not require pragma.
test("negative impl does not require pragma", {
  // MySendStruct above was defined without pragma and accepted.
});

// Negative: contradiction — positive + negative impl cannot coexist.
comptime_expect_error({
  ConflictType :: struct(value : i32);
  impl(ConflictType, Send());
  impl(ConflictType, !Send);
});

// Negative: reverse order contradiction — negative + positive cannot coexist.
// Note: We can't test this in the same file because the impl would fail
// at the second registration. The first comptime_expect_error above covers
// the contradiction detection in both directions.
// Negative: !(Trait) for a trait with methods is rejected.
// Clone trait has the `clone` method.
comptime_expect_error(
  impl(MySendStruct, !Clone)
);

// Negative: !(Trait) for a user-defined trait with method.
MyHandler :: trait(
  handle : (fn(self : Self) -> i32)
);
comptime_expect_error(
  impl(MySendStruct, !MyHandler)
);

// Positive: negative impl inside pragma'd code works too.
// (Covered by tests below in a pragma block.)
// Positive: only negative entries (no positive traits) is valid.
OnlyNegStruct :: struct(value : i32);
impl(OnlyNegStruct, !Send);

// Positive: negative impl with multiple types (via generic) works.
Container :: (fn(comptime(T) : Type) -> comptime(Type))(struct(inner : T));
impl(generic(T : Type), Container(T), !Send);
comptime_assert(
  Type.impls(Container(i32), Send) == false,
  "negative generic impl should override auto-derive for Container(i32)"
);
