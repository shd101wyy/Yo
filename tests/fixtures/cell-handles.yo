//! Cell handles: newtypes over the private cell primitives, the shape V5
//! gives `Rc` and `Arc` (plans/VALUES_BY_DEFAULT.md §3.5, "V5's seed
//! predicates"). The compiler recognizes the shape by structure
//! (`cell_handle_view`, decision D1), so these test-local wrappers get the
//! prelude cells' semantics without std: `h.*`, `ref_count`, the `Option`
//! niche, the read-only payload (E0919, D3), `dyn` and auto-dereference.
//! Only an unsafe-capable file can spell the field type; a safe file names
//! the wrappers (tests/cell-handles.test.yo).
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array-list");
TRc :: (fn(comptime(V) : ?Sized) -> comptime(Type))(
  newtype(_cell : __yo_cell(V))
);
TArc :: (fn(comptime(V) : ?Sized) -> comptime(Type))(
  newtype(_cell : __yo_atomic_cell(V))
);
trc :: (fn(generic(V : Type), sink(v) : V) -> TRc(V))(TRc(V)(__yo_cell(V)(v, .None)));
tarc :: (fn(generic(V : Type), sink(v) : V) -> TArc(V))(TArc(V)(__yo_atomic_cell(V)(v, .None)));
// Decision D2: a cell handle in an unsafe-capable file may implement
// `Deref`, as the prelude's cells do.
impl(generic(T : Type), TRc(T), Deref(Target : T, deref : (fn(self : &Self) -> &Self.Target)(&self.*.*)));
impl(generic(T : Type), TArc(T), Deref(Target : T, deref : (fn(self : &Self) -> &Self.Target)(&self.*.*)));
// Decision 17: a second handle is spelled, `TRc.clone(h)`, a count bump as
// the prelude's `Rc.clone` is.
impl(
  generic(T : Type),
  TRc(T),
  Clone(
    clone : (fn(self : &Self) -> Self)({
      // SAFETY: a handle is the address of its live cell; the increment is
      // the new handle's count (`__yo_rc_own`: no second one).
      cell := unsafe(unsafe.cast(self, *T));
      consume(__yo_incr_rc((*void)(cell)));
      __yo_rc_own(unsafe(unsafe.cast(&cell, TRc(T))))
    })
  )
);
impl(
  generic(T : Type),
  TArc(T),
  Clone(
    clone : (fn(self : &Self) -> Self)({
      // SAFETY: as `TRc`'s, with the atomic increment.
      cell := unsafe(unsafe.cast(self, *T));
      consume(__yo_incr_rc_atomic((*void)(cell)));
      __yo_rc_own(unsafe(unsafe.cast(&cell, TArc(T))))
    })
  )
);
// VERDICTS-70 Q1.4: a handle releases its cell in its own `Drop`, as
// `Box` frees its block. A cell handle with a `Drop` impl is dropped by the
// impl alone, never by the builtin decrement as well (the prelude's `Rc`
// and `Arc` take this shape in row 15).
impl(
  generic(T : Type),
  TRc(T),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      // SAFETY: the handle owns one count on its live cell, released here.
      cell := unsafe(unsafe.cast(self, *T));
      __yo_decr_rc((*void)(cell));
    })
  )
);
impl(
  generic(T : Type),
  TArc(T),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      // SAFETY: as `TRc`'s, with the atomic decrement.
      cell := unsafe(unsafe.cast(self, *T));
      __yo_decr_rc_atomic((*void)(cell));
    })
  )
);
/// Replaces the handle's cell: a write to the handle's own field `_cell`, not
/// through the handle (V5's `make_mut` writes it), so it is not E0919, and
/// the method-entry borrow assert reads the cell behind `h`.
treset :: (fn(generic(V : Type), h : &mut TRc(V), sink(v) : V) -> unit)({
  h._cell = __yo_cell(V)(v, .None);
});
/// A plain struct over an atomic cell is not a handle (decision D3: the
/// non-handle atomic types are `struct`s, so their state is not a read-only
/// payload).
TLocked :: (fn(comptime(V) : Type) -> comptime(Type))(
  struct(_cell : __yo_atomic_cell(V))
);
tlocked :: (fn(generic(V : Type), sink(v) : V) -> TLocked(V))(TLocked(V)(_cell : __yo_atomic_cell(V)(v, .None)));
/// A handle whose `Deref` impl names a `Target` other than its payload is a
/// type error at the impl: its `deref` (`&self.*.*`) yields the payload, not
/// the `Target` (VERDICTS-63 decision 12, which retires D2's "whatever
/// `Target` its impl names").
TPt :: struct(x : i32);
TMisnamed :: newtype(_cell : __yo_cell(TPt));
comptime_expect_error(impl(TMisnamed, Deref(Target : bool, deref : (fn(self : &Self) -> &Self.Target)(&self.*.*))), "This function returns `&bool`");
/// An unchecked second name for ONE list, the aliasing a `ref` object over
/// the list gave before `ref(...)` was deleted (v0.2.79): `a := talias(&mut
/// xs)` keeps the list's address, and `tclear(&a)` empties it behind the
/// borrow checker's back. Safe code cannot spell this (a `RefCell` door's
/// borrow flag would panic first), so the receiver keep-alive rows, which need
/// a closure to drop the last other handle while a receiver reached through
/// the list is borrowed, get it from this unsafe-capable fixture.
TAlias :: (fn(comptime(E) : Type) -> comptime(Type))(struct(p : *ArrayList(E)));
talias :: (fn(generic(E : Type), xs : &mut ArrayList(E)) -> TAlias(E))(TAlias(E)(p : addr_of(xs.*)));
tclear :: (fn(generic(E : Type), a : &TAlias(E)) -> unit)({
  a.p.*.clear();
});
export(TRc, TArc, trc, tarc, treset, TLocked, tlocked, TPt, TAlias, talias, tclear);
