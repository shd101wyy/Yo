//! V3b parameter conventions (plans/VALUES_BY_DEFAULT.md decisions 30, 33
//! and 34): `imm(x)`/`mut(x)` parameters and receivers, `mut(y) := place`,
//! the call-site markers `&x`/`&mut x` in arguments and `match` scrutinees,
//! and function types spelled with the modes. Since Generation B's flip a
//! plain parameter is BY VALUE: an explicit-copy argument moves into it, a
//! `Copy` one is copied, a still implicitly copyable kind (`String`, the
//! collections, `Rc`, `ref` handles) is shared as `t := s` shares it, and
//! `imm(x)` is the borrow. A mode is part of the function
//! type for every type, `Copy` or not.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ sleep } :: import("std/sys/timer");
{ DefaultHasher } :: import("std/hash");

_pm_len :: (fn(imm(s) : String) -> usize)(s.len());
_pm_plain_len :: (fn(imm(s) : String) -> usize)(s.len());
_pm_take :: (fn(s : String) -> usize)(s.len());
_pm_add1 :: (fn(n : i32) -> i32)(n + i32(1));
(g_pm_disposed : i32) = i32(0);
_PmRes :: struct(n : i32);
impl(
  _PmRes,
  Dispose(
    dispose : (fn(imm(self) : Self) -> unit)({
      g_pm_disposed = (g_pm_disposed + i32(1));
    })
  )
);
_pm_consume :: (fn(r : _PmRes) -> i32)(r.n);
_pm_run :: (fn(imm(f) : Impl(Fn(r : _PmRes) -> i32)) -> i32)(f(_PmRes(n : i32(5))));
_pm_pass :: (fn(imm(f) : Impl(Fn(r : _PmRes) -> _PmRes)) -> i32)({
  out := f(_PmRes(n : i32(7)));
  out.n
});
_pm_ct_inc :: (fn(comptime(imm(n)) : comptime_int) -> comptime(comptime_int))(n + 1);
_PmV :: struct(n : i32);
derive(_PmV, Copy, Clone);
impl(_PmV, Eq(_PmV)((==) : (fn(imm(lhs) : Self, imm(rhs) : Self) -> bool)(lhs.n == rhs.n)));
_pm_inc :: (fn(mut(n) : i32) -> unit)({
  n = (n + i32(1));
});
_pm_swap :: (fn(mut(a) : i32, mut(b) : i32) -> unit)({
  t := a;
  a = b;
  b = t;
});
_pm_push_seven :: (fn(mut(xs) : ArrayList(i32)) -> unit)({
  xs.push(i32(7));
});
_PmHolder :: struct(items : ArrayList(i32), n : i32);
_PmCounter :: struct(n : i32);
derive(_PmCounter, Copy, Clone);
impl(
  _PmCounter,
  get : (fn(imm(self) : Self) -> i32)(self.n),
  bump : (fn(mut(self) : Self, by : i32) -> unit)({
    self.n = (self.n + by);
  })
);
_PmShow :: trait(show : (fn(imm(self) : Self) -> i32));
impl(_PmCounter, _PmShow(show : (fn(imm(self) : Self) -> i32)(self.n * i32(10))));
_pm_apply_imm :: (fn(imm(f) : Impl(Fn(imm(s) : String) -> usize), imm(s) : String) -> usize)(f(s));
_pm_apply_mut :: (fn(imm(f) : Impl(Fn(mut(n) : i32) -> unit), mut(v) : i32) -> unit)(f(v));

test("a plain parameter is by value: an explicit-copy argument moves into it", {
  r := _PmRes(n : i32(6));
  assert(_pm_consume(r) == i32(6), "r moved into the by-value parameter");
  comptime_expect_error(r.n, "use of moved value");
});

test("a still implicitly copyable kind is shared into a by-value parameter, as `t := s` binds it", {
  // Until V2b makes `String` explicit-copy, passing it by value is a share
  // (+1), exactly like `t := s`, and the caller keeps its string.
  s := String.from("hello");
  assert(_pm_take(s) == usize(5), "the callee got its own share");
  assert(s.len() == usize(5), "s stays usable");
  xs := ArrayList(String).new();
  xs.push(s);
  assert((xs.len() == usize(1)) && (s == "hello"), "pushed by value and still usable");
});

_PmHandle :: ref(struct(n : i32));
test("an io.async body shares a handle into a by-value parameter: the slot keeps its own reference", {
  t := io.async((io : Io) => {
    xs := ArrayList(_PmHandle).new();
    q := _PmHandle(n : i32(2));
    io.await(sleep(u64(1)), io);
    xs.push(q);
    (ref_count(q) * usize(10)) + xs.len()
  });
  r := io.await(t, io);
  assert(r == usize(21), `the list and the slot each hold one reference (rc 2, len 1), got ${r}`);
});

test("a plain parameter of a Copy type copies", {
  n := i32(4);
  assert(_pm_add1(n) == i32(5), "the callee gets a copy");
  assert(_pm_add1(n) == i32(5), "n is still usable: a Copy value is copied, never moved");
});

test("the callee drops a by-value argument exactly once", {
  before := g_pm_disposed;
  {
    r := _PmRes(n : i32(3));
    assert(_pm_consume(r) == i32(3), "r moved into the callee");
  };
  assert(g_pm_disposed == (before + i32(1)), "one dispose: the callee's, none in the caller");
});

test("a closure's by-value parameter owns its argument and drops it once", {
  before := g_pm_disposed;
  assert(_pm_run(r => r.n) == i32(5), "the closure reads its by-value argument");
  assert(g_pm_disposed == (before + i32(1)), "the closure dropped it: one dispose, no leak");
});

test("a closure moves its by-value parameter like any owned value", {
  before := g_pm_disposed;
  a := _pm_run(r => {
    x := r;
    x.n
  });
  assert(a == i32(5), "moved into a local (not an implicit capture: no E0913)");
  assert(g_pm_disposed == (before + i32(1)), "the local dropped it once");
  b := _pm_pass(r => r);
  assert(b == i32(7), "moved out as the result");
  assert(g_pm_disposed == (before + i32(2)), "the caller's result dropped it once");
});

test("comptime(imm(x)) is a compile-time borrow", {
  comptime_assert(_pm_ct_inc(41) == 42, "comptime(imm(n))");
});

test("an operator impl writes the trait's imm operands, Copy or not", {
  assert(_PmV(n : i32(1)) == _PmV(n : i32(1)), "imm(lhs)/imm(rhs) on a Copy type");
  comptime_expect_error(impl(_PmV, Ord(_PmV)((<) : (fn(lhs : Self, rhs : Self) -> bool)(true), (<=) : (fn(imm(lhs) : Self, imm(rhs) : Self) -> bool)(true), (>) : (fn(imm(lhs) : Self, imm(rhs) : Self) -> bool)(true), (>=) : (fn(imm(lhs) : Self, imm(rhs) : Self) -> bool)(true))), "as written");
});

test("imm parameters borrow", {
  s := String.from("hello");
  assert(_pm_len(s) == usize(5), "a bare argument to an imm parameter is a borrow");
  assert(_pm_len(&s) == usize(5), "&s lends s to an imm parameter");
  assert(_pm_plain_len(&s) == usize(5), "&s lends s to a second imm parameter");
  assert(s.len() == usize(5), "s stays usable after both borrows");
});

test("mut parameters are inout parameters", {
  (c : i32) = i32(1);
  _pm_inc(&mut c);
  assert(c == i32(2), "&mut c lends c to a mut parameter");
  _pm_inc(c);
  assert(c == i32(3), "a bare argument to a mut parameter still lends the place");
  (x : i32) = i32(1);
  (y : i32) = i32(2);
  _pm_swap(&mut x, &mut y);
  assert((x == i32(2)) && (y == i32(1)), "swap through two &mut arguments");
});

test("&mut lends a field place", {
  h := _PmHolder(items : ArrayList(i32).new(), n : i32(0));
  _pm_push_seven(&mut h.items);
  _pm_inc(&mut h.n);
  assert(h.items.len() == usize(1), "the push landed in h.items");
  assert(h.n == i32(1), "the increment landed in h.n");
});

test("imm and mut receivers", {
  (c : _PmCounter) = _PmCounter(n : i32(4));
  c.bump(i32(3));
  assert(c.get() == i32(7), "mut(self) writes the receiver; imm(self) reads it");
  assert(c.show() == i32(70), "an imm(self) impl satisfies a trait's plain self method");
});

test("a mode is part of the fn type, for every type", {
  comptime_assert(!Type.is_compatible_with((fn(imm(x) : String) -> usize), (fn(x : String) -> usize)), "imm is not by value");
  comptime_assert(!Type.is_compatible_with((fn(x : String) -> usize), (fn(imm(x) : String) -> usize)), "both directions");
  comptime_assert(!Type.is_compatible_with((fn(imm(x) : i32) -> i32), (fn(x : i32) -> i32)), "Copy types too");
  comptime_assert(Type.is_compatible_with((fn(mut(n) : i32) -> unit), (fn(mut(n) : i32) -> unit)), "mut(n) is inout(n)");
  comptime_assert(Type.is_compatible_with((fn(mut(n) : i32) -> unit), (fn(mut(n) : i32) -> unit)), "both directions");
  comptime_assert(!Type.is_compatible_with((fn(mut(n) : i32) -> unit), (fn(n : i32) -> unit)), "mut is not a plain parameter");
  (f : (fn(imm(x) : String) -> usize)) = _pm_len;
  s := String.from("abc");
  assert(f(s) == usize(3), "an imm-parameter function is a value of its own fn type");
});

test("Fn traits spelled with imm and mut", {
  s := String.from("four");
  assert(_pm_apply_imm(t => t.len(), s) == usize(4), "Impl(Fn(imm(s) : String) -> usize)");
  (v : i32) = i32(1);
  _pm_apply_mut(n => {
    n = (n + i32(10));
  }, v);
  assert(v == i32(11), "Impl(Fn(mut(n) : i32) -> unit) writes through to the caller");
});

test("mut(y) := place is inout(y) := place", {
  (x : i32) = i32(1);
  mut(y) := x;
  y = i32(5);
  assert(y == i32(5), "read through y");
  assert(x == i32(5), "a write through y lands in x (read after y's last use)");
  x = i32(6);
  mut(z) := x;
  assert(z == i32(6), "mut(z) := names the same place");
  h := _PmHolder(items : ArrayList(i32).new(), n : i32(0));
  mut(n) := h.n;
  n = i32(9);
  assert(h.n == i32(9), "a field place");
});

test("&x and &mut x scrutinees match the place", {
  (o : Option(i32)) = .Some(i32(3));
  r := match(&o, .Some(v) => v, .None => i32(0));
  assert(r == i32(3), "match(&o, ...) reads o");
  r2 := match(&mut o, .Some(v) => (v + i32(1)), .None => i32(0));
  assert(r2 == i32(4), "match(&mut o, ...) reads o");
  s := String.from("kept");
  k := match(&s, t => t.len());
  assert((k == usize(4)) && (s.len() == usize(4)), "s stays usable after a borrowed scrutinee");
});

// `&xs(i)` in a body evaluated more than once (a comptime-specialized or a
// closure-taking function): the marker's diagnostic text used to append to
// the callee token's own buffer, renaming `xs` to `xs(i)` for the next
// evaluation (issues/fixed/ast-place-text-renames-the-callee-of-an-element-place.md).
_pm_is_one :: (fn(imm(v) : i32) -> bool)(v == i32(1));
_pm_first_is_one :: (fn(imm(xs) : ArrayList(i32), comptime(k) : i32) -> bool)(_pm_is_one(&xs(usize(0))));
_pm_first_by :: (fn(imm(xs) : ArrayList(i32), imm(cmp) : Impl(Fn(imm(v) : i32) -> bool)) -> bool)(cmp(&xs(usize(0))));
test("&xs(i) lends an element from a body evaluated per specialization", {
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  assert(_pm_first_is_one(&xs, i32(3)), "comptime-specialized body");
  assert(_pm_first_by(&xs, v => (v == i32(1))), "closure-taking body");
});
// A callee whose body lends through markers (`&key`, `&mut h`) still reads
// as not writing its `mut` parameter, so an `imm` binding may be handed to it
// as before (the mutation summary saw a marker as an unknown call;
// issues/fixed/the-mutation-summary-reads-a-call-site-marker-as-an-unknown-call.md).
_PmTable :: struct(n : u64);
impl(
  _PmTable,
  _digest : (fn(imm(self) : Self, mut(key) : String) -> u64)({
    h := DefaultHasher.new();
    key.hash(&mut h);
    h.finish() % self.n
  }),
  lookup : (fn(imm(self) : Self, imm(key) : String) -> u64)(self._digest(key))
);
test("a callee lending through markers does not write its mut parameter", {
  t := _PmTable(n : u64(7));
  s := String.from("abc");
  assert(t.lookup(&s) < u64(7), "an imm binding handed to a mut parameter nothing writes");
});
test("a marker that does not fit the parameter is an error", {
  s := String.from("x");
  (c : i32) = i32(0);
  comptime_expect_error(_pm_len(&mut s), "is not `&mut T`");
  comptime_expect_error(_pm_inc(&c), "lend the place with `&mut c`");
  // `p := &mut c` is a local borrow since decision 42; outside a slot the
  // marker is still not an expression.
  comptime_expect_error({
    _q := (&mut c, i32(1));
  }, "is not an expression of its own");
  comptime_expect_error({
    imm(y) := c;
    y = i32(1);
  }, "is a `&` borrow, which is read-only");
  comptime_expect_error(addr_of(c), "not available in safe code");
});

// Decision 34's Dyn test: `LogicalNot`'s `(!)` takes `self` and returns
// `bool`, so it has a vtable slot; a by-value impl is reached through it
// (issues/fixed/a-dyn-over-an-operator-trait-emits-an-invalid-c-wrapper-name.md).
_PmFlag :: struct(on : bool);
derive(_PmFlag, Copy, Clone);
impl(_PmFlag, LogicalNot((!) : (fn(self : Self) -> bool)(!self.on)));
test("Dyn(LogicalNot) over a by-value operator impl", {
  (d : Dyn(LogicalNot)) = dyn(_PmFlag(on : true));
  assert(!!d, "!d negates through the Dyn");
  (e : Dyn(LogicalNot)) = dyn(_PmFlag(on : false));
  assert(!e, "!e negates through the Dyn");
});

// Passing a function value checks its type against a function-typed
// parameter as binding does, modes included: a by-value `fn(s : String)`
// drops what an `imm(s)` slot only lends (a double free;
// issues/fixed/a-function-argument-is-not-checked-against-a-function-typed-parameter.md).
_PmHook :: (fn(imm(s) : String) -> usize);
_PmMutHook :: (fn(mut(n) : i32) -> unit);
_PmByValHook :: (fn(s : String) -> usize);
_pm_call_hook :: (fn(f : _PmHook, imm(s) : String) -> usize)(f(s));
_pm_call_mut_hook :: (fn(f : _PmMutHook, mut(n) : i32) -> unit)(f(n));
_pm_call_byval_hook :: (fn(f : _PmByValHook, s : String) -> usize)(f(s));
_pm_sink_len :: (fn(sink(s) : String) -> usize)(s.len());
_pm_plain_bump :: (fn(n : i32) -> unit)(());
_pm_imm_bump :: (fn(imm(n) : i32) -> unit)(());
_pm_len_i32 :: (fn(imm(s) : String) -> i32)(i32(1));
_PmHookBox :: struct(f : _PmHook);
_PmLens :: struct(k : usize);
impl(_PmLens, by_value : (fn(s : String) -> usize)(s.len()), lent : (fn(imm(s) : String) -> usize)(s.len()));
test("a function argument's modes must be its function-typed parameter's", {
  s := String.from("abc");
  (n : i32) = i32(1);
  comptime_expect_error(_pm_call_hook(_pm_take, s), "`s : &String` in the expected type and `s : String` in the given one");
  (g : _PmByValHook) = _pm_take;
  comptime_expect_error(_pm_call_hook(g, s), "a parameter's mode is part of the function type");
  comptime_expect_error(_pm_call_hook(_PmLens.by_value, s), "a parameter's mode is part of the function type");
  comptime_expect_error(_pm_call_hook(_pm_sink_len, s), "a parameter's mode is part of the function type");
  comptime_expect_error(_pm_call_byval_hook(_pm_len, s), "`s : String` in the expected type and `s : &String` in the given one");
  comptime_expect_error(_pm_call_mut_hook(_pm_plain_bump, n), "`n : &mut i32` in the expected type and `n : i32` in the given one");
  comptime_expect_error(_pm_call_mut_hook(_pm_imm_bump, n), "`n : &mut i32` in the expected type and `n : &i32` in the given one");
  comptime_expect_error(_pm_apply_imm(_pm_take, s), "a parameter's mode is part of the function type");
  comptime_expect_error(_pm_apply_mut(_pm_plain_bump, n), "a parameter's mode is part of the function type");
  (c : Impl(Fn(t : String) -> usize)) = (t => t.len());
  comptime_expect_error(_pm_apply_imm(c, s), "a parameter's mode is part of the function type");
  comptime_expect_error(_PmHookBox(f : _pm_take), "Incompatible types for field");
  comptime_expect_error(Option(_PmHook).Some(_pm_take), "Incompatible types for field");
  comptime_expect_error((fn() -> _PmHook)(_pm_take), "declared result type");
  comptime_expect_error({
    (h : _PmHook) = _pm_take;
  }, "Incompatible types");
});

test("a function-typed parameter checks the whole signature of a concrete slot", {
  s := String.from("abc");
  (n : i32) = i32(1);
  comptime_expect_error(_pm_call_hook(_pm_len_i32, s), "Incompatible types");
  comptime_expect_error(_pm_call_hook(n, s), "Incompatible types");
});

test("a function value whose modes are the slot's is accepted", {
  s := String.from("abc");
  (n : i32) = i32(1);
  assert(_pm_call_hook(_pm_len, s) == usize(3), "an imm function for an imm slot");
  assert(_pm_call_hook(_PmLens.lent, s) == usize(3), "an imm method value");
  (h : _PmHook) = _pm_len;
  assert(_pm_call_hook(h, s) == usize(3), "a fn-typed local");
  assert(_pm_call_byval_hook(_pm_sink_len, s) == usize(3), "sink and by value are one mode to the callee");
  assert(_pm_call_byval_hook(_pm_take, s) == usize(3), "a by-value function for a by-value slot");
  _pm_call_mut_hook(_pm_inc, n);
  assert(n == i32(2), "a mut function for a mut slot writes through");
  assert(_pm_apply_imm(_pm_len, s) == usize(3), "an imm function for Impl(Fn(imm(s) : String) -> usize)");
  assert(_pm_apply_imm(t => t.len(), s) == usize(3), "a closure literal adopts the slot's modes");
  (c : Impl(Fn(imm(t) : String) -> usize)) = (t => t.len());
  assert(_pm_apply_imm(c, s) == usize(3), "a named closure typed with the slot's modes");
  assert(_PmHookBox(f : _pm_len).f(s) == usize(3), "a struct field of the slot's type");
  assert(s.len() == usize(3), "s was only ever lent");
});

test("the deleted spellings inout and own are errors naming mut and sink", {
  comptime_expect_error(
    (fn(inout(n) : i32) -> unit)({
      n = i32(1);
    }),
    "`inout(x)` was deleted"
  );
  comptime_expect_error((fn(own(s) : String) -> usize)(s.len()), "`own(x)` is spelled `sink(x)`");
  comptime_expect_error((fn(comptime(inout(n)) : i32) -> unit)(()), "`inout(x)` was deleted");
  (_c : i32) = i32(0);
  comptime_expect_error({
    inout(y) := _c;
  }, "`inout(x)` was deleted");
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  comptime_expect_error(
    for(xs, inout(x) => {
      x = i32(2);
    }),
    "the borrowed loop is spelled `for(&mut coll, x => ...)`"
  );
  assert(xs(usize(0)) == i32(1), "nothing was written");
});
// ---------------------------------------------------------------------------
// `mut` places (plans/VALUES_BY_DEFAULT.md decision 26): `match(&mut x, …)`
// and a bare `mut` binding scrutinee bind each part as a `mut` place, which
// the arm writes through; the scrutinee is reached only through the places
// while one is live (E0911).
// ---------------------------------------------------------------------------
_pm_bump :: (fn(mut(o) : Option(i32)) -> unit)(
  match(
    o,
    .Some(n) => {
      n = (n + i32(1));
    },
    .None => ()
  )
);
_pm_rename :: (fn(mut(o) : Option(String)) -> unit)(
  match(
    o,
    .Some(s) => {
      s = String.from("renamed");
    },
    .None => ()
  )
);
_PmPair :: enum(P(a : i32, b : String), Q);
_pm_read_place :: (fn(mut(p) : _PmPair) -> usize)(
  match(
    p,
    .P(a, b) => (usize(a) + b.len()),
    .Q => usize(0)
  )
);
test("match(&mut x, …) binds mut places", {
  (o : Option(i32)) = .Some(i32(1));
  match(
    &mut o,
    .Some(n) => {
      n = (n + i32(10));
    },
    .None => ()
  );
  assert(match(o, .Some(v) => v, .None => i32(0)) == i32(11), "the arm wrote through the place");
  _pm_bump(&mut o);
  assert(match(o, .Some(v) => v, .None => i32(0)) == i32(12), "a mut parameter's match binds places too");
});
test("a mut place of a counted payload replaces it in the scrutinee", {
  (os : Option(String)) = .Some(String.from("old"));
  _pm_rename(&mut os);
  assert(match(&os, .Some(s) => (s == String.from("renamed")), .None => false), "the payload was replaced in place");
  (p : _PmPair) = .P(a : i32(2), b : String.from("abc"));
  assert(_pm_read_place(&mut p) == usize(5), "places are read through");
});
test("a mut place of a move-only payload drops the old value at the write", {
  before := g_pm_disposed;
  {
    (o : Option(_PmRes)) = .Some(_PmRes(n : i32(1)));
    match(
      &mut o,
      .Some(r) => {
        r = _PmRes(n : i32(2));
        assert(g_pm_disposed == (before + i32(1)), "the old payload was dropped at the write");
      },
      .None => ()
    );
    assert(match(&o, .Some(r) => r.n, .None => i32(0)) == i32(2), "the scrutinee holds the new payload");
  };
  assert(g_pm_disposed == (before + i32(2)), "the new payload is dropped once, with o");
});
test("the scrutinee is reached only through a live mut place", {
  (o : Option(i32)) = .Some(i32(1));
  comptime_expect_error(
    match(
      &mut o,
      .Some(n) => {
        o = .None;
        n
      },
      .None => i32(0)
    ),
    "borrows `o` with `&mut` and is still live"
  );
  (h : Option(i32)) = .Some(i32(1));
  comptime_expect_error(
    (fn(imm(x) : Option(i32)) -> i32)(match(&mut x, .Some(n) => n, .None => i32(0))),
    "is a `&` borrow"
  );
  comptime_expect_error(match(&mut Option(i32).Some(i32(1)), .Some(n) => n, .None => i32(0)), "is a temporary");
  assert(match(&h, .Some(n) => n, .None => i32(0)) == i32(1), "h untouched");
});
test("a mut place's writing method writes the scrutinee's part", {
  (ol : Option(ArrayList(i32))) = .Some(ArrayList(i32).new());
  match(
    &mut ol,
    .Some(xs) => xs.push(i32(4)),
    .None => ()
  );
  match(
    &mut ol,
    .Some(xs) => xs.push(i32(5)),
    .None => ()
  );
  assert(match(&ol, .Some(xs) => xs.len(), .None => usize(0)) == usize(2), "pushed in place, twice");
});
