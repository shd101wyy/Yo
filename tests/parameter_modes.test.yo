//! V3b parameter conventions (plans/VALUES_BY_DEFAULT.md decisions 30, 33
//! and 34): `imm(x)`/`mut(x)` parameters and receivers, `mut(y) := place`,
//! the call-site markers `&x`/`&mut x` in arguments and `match` scrutinees,
//! and function types spelled with the modes. Since Generation B's flip a
//! plain parameter is BY VALUE: an explicit-copy argument moves into it, a
//! `Copy` one is copied, a still implicitly copyable kind (`String`, the
//! collections, `Rc`, `ref` handles) is shared as `t := s` shares it, and
//! `imm(x)` is the borrow. A mode is part of the function
//! type for every type, `Copy` or not.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ sleep } :: import("std/sys/timer");
{ DefaultHasher } :: import("std/hash");
{ ToString, Debug, Format } :: import("std/fmt");
{ ToJson, JsonValue } :: import("std/encoding/json");
{ Error, AnyError } :: import("std/error");

_pm_len :: (fn(s : &String) -> usize)(s.len());
_pm_plain_len :: (fn(s : &String) -> usize)(s.len());
_pm_take :: (fn(s : String) -> usize)(s.len());
_pm_add1 :: (fn(n : i32) -> i32)(n + i32(1));
(g_pm_disposed : i32) = i32(0);
_PmRes :: struct(n : i32);
impl(
  _PmRes,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_pm_disposed = (g_pm_disposed + i32(1));
    })
  )
);
_pm_consume :: (fn(r : _PmRes) -> i32)(r.n);
_pm_run :: (fn(f : &Impl(Fn(r : _PmRes) -> i32)) -> i32)(f(_PmRes(n : i32(5))));
_pm_pass :: (fn(f : &Impl(Fn(r : _PmRes) -> _PmRes)) -> i32)({
  out := f(_PmRes(n : i32(7)));
  out.n
});
_pm_ct_inc :: (fn(comptime(n) : &comptime_int) -> comptime(comptime_int))(n + 1);
_PmV :: struct(n : i32);
derive(_PmV, Copy, Clone);
impl(_PmV, Eq(_PmV)((==) : (fn(lhs : &Self, rhs : &Self) -> bool)(lhs.n == rhs.n)));
_pm_inc :: (fn(n : &mut i32) -> unit)({
  n = (n + i32(1));
});
_pm_swap :: (fn(a : &mut i32, b : &mut i32) -> unit)({
  t := a;
  a = b;
  b = t;
});
_pm_push_seven :: (fn(xs : &mut ArrayList(i32)) -> unit)({
  xs.push(i32(7));
});
_PmHolder :: struct(items : ArrayList(i32), n : i32);
_PmCounter :: struct(n : i32);
derive(_PmCounter, Copy, Clone);
impl(
  _PmCounter,
  get : (fn(self : &Self) -> i32)(self.n),
  bump : (fn(self : &mut Self, by : i32) -> unit)({
    self.n = (self.n + by);
  })
);
_PmShow :: trait(show : (fn(self : &Self) -> i32));
impl(_PmCounter, _PmShow(show : (fn(self : &Self) -> i32)(self.n * i32(10))));
_pm_apply_imm :: (fn(f : &Impl(Fn(s : &String) -> usize), s : &String) -> usize)(f(s));
_pm_apply_mut :: (fn(f : &Impl(Fn(n : &mut i32) -> unit), v : &mut i32) -> unit)(f(v));

test("a plain parameter is by value: an explicit-copy argument moves into it", {
  r := _PmRes(n : i32(6));
  assert(_pm_consume(r) == i32(6), "r moved into the by-value parameter");
  comptime_expect_error(r.n, "use of moved value");
});

test("a still implicitly copyable kind is shared into a by-value parameter, as `t := s` binds it", {
  // Until V2b makes `String` explicit-copy, passing it by value is a share
  // (+1), exactly like `t := s`, and the caller keeps its string.
  s := String.from("hello");
  assert(_pm_take(s) == usize(5), "the callee got its own share");
  assert(s.len() == usize(5), "s stays usable");
  xs := ArrayList(String).new();
  xs.push(s);
  assert((xs.len() == usize(1)) && (s == "hello"), "pushed by value and still usable");
});

_PmHandle :: ref(struct(n : i32));
test("an io.async body shares a handle into a by-value parameter: the slot keeps its own reference", {
  t := io.async((io : Io) => {
    xs := ArrayList(_PmHandle).new();
    q := _PmHandle(n : i32(2));
    io.await(sleep(u64(1)), io);
    xs.push(q);
    (ref_count(q) * usize(10)) + xs.len()
  });
  r := io.await(t, io);
  assert(r == usize(21), `the list and the slot each hold one reference (rc 2, len 1), got ${r}`);
});

test("a plain parameter of a Copy type copies", {
  n := i32(4);
  assert(_pm_add1(n) == i32(5), "the callee gets a copy");
  assert(_pm_add1(n) == i32(5), "n is still usable: a Copy value is copied, never moved");
});

test("the callee drops a by-value argument exactly once", {
  before := g_pm_disposed;
  {
    r := _PmRes(n : i32(3));
    assert(_pm_consume(r) == i32(3), "r moved into the callee");
  };
  assert(g_pm_disposed == (before + i32(1)), "one dispose: the callee's, none in the caller");
});

test("a closure's by-value parameter owns its argument and drops it once", {
  before := g_pm_disposed;
  assert(_pm_run(r => r.n) == i32(5), "the closure reads its by-value argument");
  assert(g_pm_disposed == (before + i32(1)), "the closure dropped it: one dispose, no leak");
});

test("a closure moves its by-value parameter like any owned value", {
  before := g_pm_disposed;
  a := _pm_run(r => {
    x := r;
    x.n
  });
  assert(a == i32(5), "moved into a local (not an implicit capture: no E0913)");
  assert(g_pm_disposed == (before + i32(1)), "the local dropped it once");
  b := _pm_pass(r => r);
  assert(b == i32(7), "moved out as the result");
  assert(g_pm_disposed == (before + i32(2)), "the caller's result dropped it once");
});

test("comptime(imm(x)) is a compile-time borrow", {
  comptime_assert(_pm_ct_inc(41) == 42, "comptime(imm(n))");
});

test("an operator impl writes the trait's imm operands, Copy or not", {
  assert(_PmV(n : i32(1)) == _PmV(n : i32(1)), "imm(lhs)/imm(rhs) on a Copy type");
  comptime_expect_error(impl(_PmV, Ord(_PmV)((<) : (fn(lhs : Self, rhs : Self) -> bool)(true), (<=) : (fn(lhs : &Self, rhs : &Self) -> bool)(true), (>) : (fn(lhs : &Self, rhs : &Self) -> bool)(true), (>=) : (fn(lhs : &Self, rhs : &Self) -> bool)(true))), "as written");
});

// Decision 34 as amended 2026-10-11 (maintainer directive): the arithmetic,
// bitwise and unary operator traits take their operands BY VALUE, as Rust's
// `Add::add(self, rhs)` does; `Eq` and `Ord` keep borrowing. An impl writes
// the trait's modes, so a borrowing `Add` impl is rejected as written.
_PmMoney :: struct(c : i32);
derive(_PmMoney, Copy, Clone);
impl(_PmMoney, Add(_PmMoney)(Output : _PmMoney, (+) : (fn(lhs : Self, rhs : Self) -> Self.Output)(_PmMoney(c : (lhs.c + rhs.c)))));
impl(_PmMoney, Negate(Output : _PmMoney, neg : (fn(self : Self) -> Self.Output)(_PmMoney(c : (i32(0) - self.c)))));
_PmTag :: struct(s : String);
impl(_PmTag, Add(_PmTag)(Output : _PmTag, (+) : (fn(lhs : Self, rhs : Self) -> Self.Output)(_PmTag(s : lhs.s.concat(&rhs.s)))));
test("arithmetic and unary operator impls take their operands by value", {
  a := _PmMoney(c : i32(2));
  b := _PmMoney(c : i32(3));
  sum := (a + b);
  assert(sum.c == i32(5), "a by-value Add impl is accepted and called");
  assert(a.c == i32(2), "a Copy operand is copied: a stays usable");
  neg := -a;
  assert(neg.c == i32(-2), "a by-value Negate impl is accepted and called");
  comptime_expect_error(impl(_PmV, Add(_PmV)(Output : _PmV, (+) : (fn(lhs : &Self, rhs : &Self) -> Self.Output)(_PmV(n : (lhs.n + rhs.n))))), "as written");
  comptime_expect_error(impl(_PmMoney, Eq(_PmMoney)((==) : (fn(lhs : Self, rhs : Self) -> bool)(lhs.c == rhs.c))), "as written");
});

test("a by-value operator copies a counted operand", {
  x := _PmTag(s : String.from("ab"));
  y := _PmTag(s : String.from("cd"));
  z := (x + y);
  assert(z.s == "abcd", "the impl owned both operands");
  assert((x.s == "ab") && (y.s == "cd"), "the operands' strings were shared, not freed");
  s := String.from("he");
  t := (s + String.from("llo"));
  assert(t == "hello", "String's by-value (+)");
  assert(s == "he", "s survives as the left operand");
});

test("imm parameters borrow", {
  s := String.from("hello");
  assert(_pm_len(&s) == usize(5), "a bare argument to an imm parameter is a borrow");
  assert(_pm_len(&s) == usize(5), "&s lends s to an imm parameter");
  assert(_pm_plain_len(&s) == usize(5), "&s lends s to a second imm parameter");
  assert(s.len() == usize(5), "s stays usable after both borrows");
});

test("mut parameters are inout parameters", {
  (c : i32) = i32(1);
  _pm_inc(&mut c);
  assert(c == i32(2), "&mut c lends c to a mut parameter");
  _pm_inc(&mut c);
  assert(c == i32(3), "a bare argument to a mut parameter still lends the place");
  (x : i32) = i32(1);
  (y : i32) = i32(2);
  _pm_swap(&mut x, &mut y);
  assert((x == i32(2)) && (y == i32(1)), "swap through two &mut arguments");
});

test("&mut lends a field place", {
  h := _PmHolder(items : ArrayList(i32).new(), n : i32(0));
  _pm_push_seven(&mut h.items);
  _pm_inc(&mut h.n);
  assert(h.items.len() == usize(1), "the push landed in h.items");
  assert(h.n == i32(1), "the increment landed in h.n");
});

test("imm and mut receivers", {
  (c : _PmCounter) = _PmCounter(n : i32(4));
  c.bump(i32(3));
  assert(c.get() == i32(7), "mut(self) writes the receiver; imm(self) reads it");
  assert(c.show() == i32(70), "an imm(self) impl satisfies a trait's plain self method");
});

test("a mode is part of the fn type, for every type", {
  comptime_assert(!Type.is_compatible_with((fn(x : &String) -> usize), (fn(x : String) -> usize)), "imm is not by value");
  comptime_assert(!Type.is_compatible_with((fn(x : String) -> usize), (fn(x : &String) -> usize)), "both directions");
  comptime_assert(!Type.is_compatible_with((fn(x : &i32) -> i32), (fn(x : i32) -> i32)), "Copy types too");
  comptime_assert(Type.is_compatible_with((fn(n : &mut i32) -> unit), (fn(n : &mut i32) -> unit)), "mut(n) is inout(n)");
  comptime_assert(Type.is_compatible_with((fn(n : &mut i32) -> unit), (fn(n : &mut i32) -> unit)), "both directions");
  comptime_assert(!Type.is_compatible_with((fn(n : &mut i32) -> unit), (fn(n : i32) -> unit)), "mut is not a plain parameter");
  (f : (fn(x : &String) -> usize)) = _pm_len;
  s := String.from("abc");
  assert(f(&s) == usize(3), "an imm-parameter function is a value of its own fn type");
});

test("Fn traits spelled with imm and mut", {
  s := String.from("four");
  assert(_pm_apply_imm(t => t.len(), &s) == usize(4), "Impl(Fn(imm(s) : String) -> usize)");
  (v : i32) = i32(1);
  _pm_apply_mut(n => {
    n = (n + i32(10));
  }, &mut v);
  assert(v == i32(11), "Impl(Fn(mut(n) : i32) -> unit) writes through to the caller");
});

test("mut(y) := place is inout(y) := place", {
  (x : i32) = i32(1);
  y := &mut x;
  y = i32(5);
  assert(y == i32(5), "read through y");
  assert(x == i32(5), "a write through y lands in x (read after y's last use)");
  x = i32(6);
  z := &mut x;
  assert(z == i32(6), "mut(z) := names the same place");
  h := _PmHolder(items : ArrayList(i32).new(), n : i32(0));
  n := &mut h.n;
  n = i32(9);
  assert(h.n == i32(9), "a field place");
});

test("&x and &mut x scrutinees match the place", {
  (o : Option(i32)) = .Some(i32(3));
  r := match(&o, .Some(v) => v, .None => i32(0));
  assert(r == i32(3), "match(&o, ...) reads o");
  r2 := match(&mut o, .Some(v) => (v + i32(1)), .None => i32(0));
  assert(r2 == i32(4), "match(&mut o, ...) reads o");
  s := String.from("kept");
  k := match(&s, t => t.len());
  assert((k == usize(4)) && (s.len() == usize(4)), "s stays usable after a borrowed scrutinee");
});

// `&xs(i)` in a body evaluated more than once (a comptime-specialized or a
// closure-taking function): the marker's diagnostic text used to append to
// the callee token's own buffer, renaming `xs` to `xs(i)` for the next
// evaluation (issues/fixed/ast-place-text-renames-the-callee-of-an-element-place.md).
_pm_is_one :: (fn(v : &i32) -> bool)(v == i32(1));
_pm_first_is_one :: (fn(xs : &ArrayList(i32), comptime(k) : i32) -> bool)(_pm_is_one(&xs(usize(0))));
_pm_first_by :: (fn(xs : &ArrayList(i32), cmp : &Impl(Fn(v : &i32) -> bool)) -> bool)(cmp(&xs(usize(0))));
test("&xs(i) lends an element from a body evaluated per specialization", {
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  assert(_pm_first_is_one(&xs, i32(3)), "comptime-specialized body");
  assert(_pm_first_by(&xs, v => (v == i32(1))), "closure-taking body");
});
// A callee whose body lends through markers (`&key`, `&mut h`) still reads
// as not writing its `&mut T` parameter, so a `&T` binding may be handed to it
// as before (the mutation summary saw a marker as an unknown call;
// issues/fixed/the-mutation-summary-reads-a-call-site-marker-as-an-unknown-call.md).
_PmTable :: struct(n : u64);
impl(
  _PmTable,
  _digest : (fn(self : &Self, key : &mut String) -> u64)({
    h := DefaultHasher.new();
    key.hash(&mut h);
    h.finish() % self.n
  }),
  lookup : (fn(self : &Self, key : &String) -> u64)(self._digest(key))
);
test("a callee lending through markers does not write its &mut T parameter", {
  t := _PmTable(n : u64(7));
  s := String.from("abc");
  assert(t.lookup(&s) < u64(7), "a &T binding handed to a &mut T parameter nothing writes");
});
test("a marker that does not fit the parameter is an error", {
  s := String.from("x");
  (c : i32) = i32(0);
  comptime_expect_error(_pm_len(&mut s), "is not `&mut T`");
  comptime_expect_error(_pm_inc(&c), "lend the place with `&mut c`");
  // `p := &mut c` is a local borrow since decision 42; outside a slot the
  // marker is still not an expression.
  comptime_expect_error({
    _q := (&mut c, i32(1));
  }, "is not an expression of its own");
  comptime_expect_error({
    y := &c;
    y = i32(1);
  }, "is a `&` borrow, which is read-only");
  comptime_expect_error(addr_of(c), "not available in safe code");
});

// Decision 34's Dyn test: `LogicalNot`'s `(!)` takes `self` by value (as
// amended 2026-10-11) and returns `bool`, so it has a vtable slot; a by-value
// impl is reached through it
// (issues/fixed/a-dyn-over-an-operator-trait-emits-an-invalid-c-wrapper-name.md).
_PmFlag :: struct(on : bool);
derive(_PmFlag, Copy, Clone);
impl(_PmFlag, LogicalNot((!) : (fn(self : Self) -> bool)(!self.on)));
test("Dyn(LogicalNot) over a by-value operator impl", {
  (d : Dyn(LogicalNot)) = dyn(_PmFlag(on : true));
  assert(!!d, "!d negates through the Dyn");
  (e : Dyn(LogicalNot)) = dyn(_PmFlag(on : false));
  assert(!e, "!e negates through the Dyn");
});

// The vtable wrapper hands a by-value `self` a copy of the payload, its
// counted fields incremented: the impl drops its copy and the Dyn keeps the
// original. A move-only payload has no copy, so it cannot be boxed behind a
// by-value slot at all
// (issues/fixed/a-by-value-self-called-through-a-dyn-frees-the-payload.md).
_PmNamed :: struct(name : String);
impl(_PmNamed, LogicalNot((!) : (fn(self : Self) -> bool)(self.name.len() == usize(0))));
_PmHeld :: struct(n : i32);
impl(
  _PmHeld,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_pm_disposed = (g_pm_disposed + i32(1));
    })
  )
);
impl(_PmHeld, LogicalNot((!) : (fn(self : Self) -> bool)(self.n == i32(0))));
test("a by-value self called through a Dyn gets a copy of the payload", {
  (e : Dyn(LogicalNot)) = dyn(_PmNamed(name : String.from("abc")));
  assert(!!e, "first call: the name is non-empty");
  assert(!!e, "second call reads the payload the first call did not free");
  assert(!!e, "third call");
  comptime_expect_error({
    (_h : Dyn(LogicalNot)) = dyn(_PmHeld(n : i32(1)));
  }, "cannot hold the move-only");
});

// Passing a function value checks its type against a function-typed
// parameter as binding does, modes included: a by-value `fn(s : String)`
// drops what an `imm(s)` slot only lends (a double free;
// issues/fixed/a-function-argument-is-not-checked-against-a-function-typed-parameter.md).
_PmHook :: (fn(s : &String) -> usize);
_PmMutHook :: (fn(n : &mut i32) -> unit);
_PmByValHook :: (fn(s : String) -> usize);
_pm_call_hook :: (fn(f : _PmHook, s : &String) -> usize)(f(s));
_pm_call_mut_hook :: (fn(f : _PmMutHook, n : &mut i32) -> unit)(f(n));
_pm_call_byval_hook :: (fn(f : _PmByValHook, s : String) -> usize)(f(s));
_pm_sink_len :: (fn(sink(s) : String) -> usize)(s.len());
_pm_plain_bump :: (fn(n : i32) -> unit)(());
_pm_imm_bump :: (fn(n : &i32) -> unit)(());
_pm_len_i32 :: (fn(s : &String) -> i32)(i32(1));
_PmHookBox :: struct(f : _PmHook);
_PmLens :: struct(k : usize);
impl(_PmLens, by_value : (fn(s : String) -> usize)(s.len()), lent : (fn(s : &String) -> usize)(s.len()));
test("a function argument's modes must be its function-typed parameter's", {
  s := String.from("abc");
  (n : i32) = i32(1);
  comptime_expect_error(_pm_call_hook(_pm_take, &s), "`s : &String` in the expected type and `s : String` in the given one");
  (g : _PmByValHook) = _pm_take;
  comptime_expect_error(_pm_call_hook(g, &s), "a parameter's mode is part of the function type");
  comptime_expect_error(_pm_call_hook(_PmLens.by_value, &s), "a parameter's mode is part of the function type");
  comptime_expect_error(_pm_call_hook(_pm_sink_len, &s), "a parameter's mode is part of the function type");
  comptime_expect_error(_pm_call_byval_hook(_pm_len, s), "`s : String` in the expected type and `s : &String` in the given one");
  comptime_expect_error(_pm_call_mut_hook(_pm_plain_bump, &mut n), "`n : &mut i32` in the expected type and `n : i32` in the given one");
  comptime_expect_error(_pm_call_mut_hook(_pm_imm_bump, &mut n), "`n : &mut i32` in the expected type and `n : &i32` in the given one");
  comptime_expect_error(_pm_apply_imm(_pm_take, &s), "a parameter's mode is part of the function type");
  comptime_expect_error(_pm_apply_mut(_pm_plain_bump, &mut n), "a parameter's mode is part of the function type");
  (c : Impl(Fn(t : String) -> usize)) = (t => t.len());
  comptime_expect_error(_pm_apply_imm(&c, &s), "a parameter's mode is part of the function type");
  comptime_expect_error(_PmHookBox(f : _pm_take), "Incompatible types for field");
  comptime_expect_error(Option(_PmHook).Some(_pm_take), "Incompatible types for field");
  comptime_expect_error((fn() -> _PmHook)(_pm_take), "declared result type");
  comptime_expect_error({
    (h : _PmHook) = _pm_take;
  }, "Incompatible types");
});

test("a function-typed parameter checks the whole signature of a concrete slot", {
  s := String.from("abc");
  (n : i32) = i32(1);
  comptime_expect_error(_pm_call_hook(_pm_len_i32, &s), "Incompatible types");
  comptime_expect_error(_pm_call_hook(n, &s), "Incompatible types");
});

test("a function value whose modes are the slot's is accepted", {
  s := String.from("abc");
  (n : i32) = i32(1);
  assert(_pm_call_hook(_pm_len, &s) == usize(3), "an imm function for an imm slot");
  assert(_pm_call_hook(_PmLens.lent, &s) == usize(3), "an imm method value");
  (h : _PmHook) = _pm_len;
  assert(_pm_call_hook(h, &s) == usize(3), "a fn-typed local");
  assert(_pm_call_byval_hook(_pm_sink_len, s) == usize(3), "sink and by value are one mode to the callee");
  assert(_pm_call_byval_hook(_pm_take, s) == usize(3), "a by-value function for a by-value slot");
  _pm_call_mut_hook(_pm_inc, &mut n);
  assert(n == i32(2), "a mut function for a mut slot writes through");
  assert(_pm_apply_imm(_pm_len, &s) == usize(3), "an imm function for Impl(Fn(imm(s) : String) -> usize)");
  assert(_pm_apply_imm(t => t.len(), &s) == usize(3), "a closure literal adopts the slot's modes");
  (c : Impl(Fn(t : &String) -> usize)) = (t => t.len());
  assert(_pm_apply_imm(&c, &s) == usize(3), "a named closure typed with the slot's modes");
  assert(_PmHookBox(f : _pm_len).f(&s) == usize(3), "a struct field of the slot's type");
  assert(s.len() == usize(3), "s was only ever lent");
});

test("the deleted spellings inout and own are errors naming mut and sink", {
  comptime_expect_error(
    (fn(inout(n) : i32) -> unit)({
      n = i32(1);
    }),
    "`inout(x)` was deleted"
  );
  comptime_expect_error((fn(own(s) : String) -> usize)(s.len()), "`own(x)` is spelled `sink(x)`");
  comptime_expect_error((fn(comptime(inout(n)) : i32) -> unit)(()), "`inout(x)` was deleted");
  (_c : i32) = i32(0);
  comptime_expect_error({
    inout(y) := _c;
  }, "`inout(x)` was deleted");
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  comptime_expect_error(
    for(xs, inout(x) => {
      x = i32(2);
    }),
    "the borrowed loop is spelled `for(&mut coll, x => ...)`"
  );
  assert(xs(usize(0)) == i32(1), "nothing was written");
});
// ---------------------------------------------------------------------------
// `mut` places (plans/VALUES_BY_DEFAULT.md decision 26): `match(&mut x, …)`
// and a bare `mut` binding scrutinee bind each part as a `mut` place, which
// the arm writes through; the scrutinee is reached only through the places
// while one is live (E0911).
// ---------------------------------------------------------------------------
_pm_bump :: (fn(o : &mut Option(i32)) -> unit)(
  match(
    o,
    .Some(n) => {
      n = (n + i32(1));
    },
    .None => ()
  )
);
_pm_rename :: (fn(o : &mut Option(String)) -> unit)(
  match(
    o,
    .Some(s) => {
      s = String.from("renamed");
    },
    .None => ()
  )
);
_PmPair :: enum(P(a : i32, b : String), Q);
_pm_read_place :: (fn(p : &mut _PmPair) -> usize)(
  match(
    p,
    .P(a, b) => (usize(a) + b.len()),
    .Q => usize(0)
  )
);
test("match(&mut x, …) binds mut places", {
  (o : Option(i32)) = .Some(i32(1));
  match(
    &mut o,
    .Some(n) => {
      n = (n + i32(10));
    },
    .None => ()
  );
  assert(match(o, .Some(v) => v, .None => i32(0)) == i32(11), "the arm wrote through the place");
  _pm_bump(&mut o);
  assert(match(o, .Some(v) => v, .None => i32(0)) == i32(12), "a mut parameter's match binds places too");
});
test("a mut place of a counted payload replaces it in the scrutinee", {
  (os : Option(String)) = .Some(String.from("old"));
  _pm_rename(&mut os);
  assert(match(&os, .Some(s) => (s == String.from("renamed")), .None => false), "the payload was replaced in place");
  (p : _PmPair) = .P(a : i32(2), b : String.from("abc"));
  assert(_pm_read_place(&mut p) == usize(5), "places are read through");
});
test("a mut place of a move-only payload drops the old value at the write", {
  before := g_pm_disposed;
  {
    (o : Option(_PmRes)) = .Some(_PmRes(n : i32(1)));
    match(
      &mut o,
      .Some(r) => {
        r = _PmRes(n : i32(2));
        assert(g_pm_disposed == (before + i32(1)), "the old payload was dropped at the write");
      },
      .None => ()
    );
    assert(match(&o, .Some(r) => r.n, .None => i32(0)) == i32(2), "the scrutinee holds the new payload");
  };
  assert(g_pm_disposed == (before + i32(2)), "the new payload is dropped once, with o");
});
test("the scrutinee is reached only through a live mut place", {
  (o : Option(i32)) = .Some(i32(1));
  comptime_expect_error(
    match(
      &mut o,
      .Some(n) => {
        o = .None;
        n
      },
      .None => i32(0)
    ),
    "borrows `o` with `&mut` and is still live"
  );
  (h : Option(i32)) = .Some(i32(1));
  comptime_expect_error(
    (fn(x : &Option(i32)) -> i32)(match(&mut x, .Some(n) => n, .None => i32(0))),
    "is a `&` borrow"
  );
  comptime_expect_error(match(&mut Option(i32).Some(i32(1)), .Some(n) => n, .None => i32(0)), "is a temporary");
  assert(match(&h, .Some(n) => n, .None => i32(0)) == i32(1), "h untouched");
});
test("a mut place's writing method writes the scrutinee's part", {
  (ol : Option(ArrayList(i32))) = .Some(ArrayList(i32).new());
  match(
    &mut ol,
    .Some(xs) => xs.push(i32(4)),
    .None => ()
  );
  match(
    &mut ol,
    .Some(xs) => xs.push(i32(5)),
    .None => ()
  );
  assert(match(&ol, .Some(xs) => xs.len(), .None => usize(0)) == usize(2), "pushed in place, twice");
});

test("the deleted mode words imm and mut are E0009 naming the sigil spelling", {
  comptime_expect_error((fn(imm(s) : String) -> usize)(s.len()), "`imm(x)` was deleted: a read-only borrow is spelled `x : &T`");
  comptime_expect_error(
    (fn(mut(n) : i32) -> unit)({
      n = i32(1);
    }),
    "`mut(x)` was deleted: an exclusive borrow is spelled `x : &mut T`"
  );
  comptime_expect_error((fn(comptime(imm(n)) : i32) -> i32)(n), "`imm(x)` was deleted");
  comptime_expect_error((fn(f : Impl(Fn(imm(v) : String) -> usize)) -> unit)(()), "`imm(x)` was deleted");
  comptime_expect_error((imm(v) : String) => v.len(), "`imm(x)` was deleted");
  (_v : i32) = i32(0);
  comptime_expect_error(
    _pm_apply_mut(mut(n) => {
      n = i32(1);
    }, _v),
    "`mut(x)` was deleted"
  );
  comptime_expect_error((fn(s : String) -> imm(String))(s), "`imm(x)` was deleted");
  (_c : i32) = i32(0);
  comptime_expect_error({
    imm(y) := _c;
  }, "`imm(x)` was deleted");
  comptime_expect_error({
    mut(y) := _c;
  }, "`mut(x)` was deleted");
  comptime_expect_error({
    y := &mut _c;
    mut(y) = _c;
  }, "`mut(x)` was deleted");
  comptime_expect_error({ imm(_c) }() => i32(1), "`imm(x)` was deleted");
  comptime_expect_error({ mut(z) : &mut _c }() => i32(1), "`mut(x)` was deleted");
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  comptime_expect_error(
    for(xs, mut(x) => {
      x = i32(2);
    }),
    "`for(coll, mut(x) => ...)` was deleted"
  );
  assert(xs(usize(0)) == i32(1), "nothing was written");
});

// Decision 28's argument exclusivity across the argument list: the arguments
// are evaluated in order, so a place an earlier argument lends is borrowed
// while a later one runs, and a later argument may not move it
// (issues/fixed/a-later-argument-can-move-the-place-an-earlier-argument-lends-to-a-call.md).
_PmLentPair :: struct(f : _PmRes, k : i32);
impl(_PmRes, plus : (fn(self : &Self, k : i32) -> i32)(self.n + k));
_pm_sync :: (fn(c : &mut _PmRes, k : i32) -> i32)({
  c.n = (c.n + k);
  c.n
});
_pm_peek :: (fn(c : &_PmRes, k : i32) -> i32)(c.n + k);
_pm_take_pair :: (fn(p : _PmLentPair) -> i32)(p.k);
_pm_reset :: (fn(c : &mut _PmRes) -> i32)({
  c.n = i32(20);
  i32(2)
});
test("a later argument cannot move the place an earlier argument lends to the call", {
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    _pm_sync(&mut a, _pm_consume(a))
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    _pm_peek(&a, _pm_add1(_pm_consume(a)))
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    _pm_peek(&a, {
      k := _pm_consume(a);
      k
    })
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    p := _PmLentPair(f : _PmRes(n : i32(1)), k : i32(2));
    _pm_sync(&mut p.f, _pm_take_pair(p))
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    a.plus(_pm_consume(a))
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    (g : Impl(Fn(c : &mut _PmRes, k : i32) -> i32)) = ((c : &mut _PmRes, k : i32) => (c.n + k));
    g(&mut a, _pm_consume(a))
  }, "an earlier argument of the same call lends to it");
  o := _PmRes(n : i32(3));
  a := _PmRes(n : i32(1));
  assert(_pm_sync(&mut a, _pm_consume(o)) == i32(4), "a later argument may move another binding");
  assert(a.plus(i32(1)) == i32(5), "the lent place is intact");
});

// The borrow an argument lends starts when that argument is evaluated, so a
// later argument may not overwrite the place or lend it `&mut` either: a `&`
// argument naming a field is read before the later arguments run, and the
// overwrite drops the value it points into
// (issues/fixed/a-later-argument-can-overwrite-the-place-an-earlier-argument-lends-to-a-call.md).
_PmLentStr :: struct(s : String, k : i32);
_pm_str_len :: (fn(s : &String, k : i32) -> usize)(s.len());
impl(
  _PmRes,
  bump : (fn(self : &mut Self, k : i32) -> i32)({
    self.n = (self.n + k);
    self.n
  })
);
_pm_reset_str :: (fn(p : &mut _PmLentStr) -> i32)({
  p.s = String.from("y");
  i32(0)
});
test("a later argument cannot overwrite or relend the place an earlier argument lends", {
  comptime_expect_error({
    p := _PmLentStr(s : String.from("a heap-allocated string longer than the inline size"), k : i32(0));
    _pm_str_len(&p.s, {
      p = _PmLentStr(s : String.from("x"), k : i32(1));
      i32(0)
    })
  }, "the borrow starts when that argument is evaluated");
  comptime_expect_error({
    p := _PmLentStr(s : String.from("a heap-allocated string longer than the inline size"), k : i32(0));
    _pm_str_len(&p.s, _pm_reset_str(&mut p))
  }, "the borrow starts when that argument is evaluated");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    _pm_sync(&mut a, {
      a = _PmRes(n : i32(10));
      i32(1)
    })
  }, "the borrow starts when that argument is evaluated");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    _pm_sync(&mut a, _pm_reset(&mut a))
  }, "the borrow starts when that argument is evaluated");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    a.plus({
      a = _PmRes(n : i32(10));
      i32(1)
    })
  }, "the borrow starts when that argument is evaluated");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    _pm_peek(&a, a.bump(i32(1)))
  }, "the borrow starts when that argument is evaluated");
  comptime_expect_error({
    xs := ArrayList(String).new();
    xs.push(String.from("a"));
    _pm_str_len(&xs(usize(0)), {
      xs.push(String.from("b"));
      i32(0)
    })
  }, "the borrow starts when that argument is evaluated");
  // A read or a `&` relend of the lent place, and a write to a disjoint
  // field, pass.
  a := _PmRes(n : i32(1));
  assert(_pm_sync(&mut a, a.plus(i32(1))) == i32(3), "a later argument may read the lent place");
  assert(_pm_peek(&a, _pm_peek(&a, i32(0))) == i32(6), "a later argument may lend the place `&` again");
  p := _PmLentStr(s : String.from("hello"), k : i32(0));
  assert(
    _pm_str_len(&p.s, {
      p.k = i32(3);
      i32(0)
    }) == usize(5),
    "a later argument may write a field the lent place does not overlap"
  );
  assert(p.k == i32(3), "the disjoint write landed");
  xs := ArrayList(i32).new();
  xs.push(i32(xs.len()));
  assert(xs(usize(0)) == i32(0), "a `&mut self` receiver lets a later argument read it");
});

// A method call that omits a defaulted parameter still lends its receiver
// (issues/fixed/2026-10-14-a-method-call-omitting-a-defaulted-parameter-skips-the-lent-receiver-check.md).
impl(_PmRes, peek_d : (fn(self : &Self, k : i32, (extra : i32) ?= i32(0)) -> i32)(self.n + (k + extra)));
test("a later argument cannot move the receiver of a call that omits a defaulted parameter", {
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    a.peek_d(_pm_consume(a))
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    a := _PmRes(n : i32(1));
    a.peek_d(_pm_consume(a), i32(0))
  }, "an earlier argument of the same call lends to it");
  a := _PmRes(n : i32(1));
  o := _PmRes(n : i32(2));
  assert(a.peek_d(_pm_consume(o)) == i32(3), "the receiver is lent, another binding moves");
  assert(_PmRes.peek_d(&a, i32(1)) == i32(2), "a type-qualified call lends its `&a` argument");
});

// An operator whose method borrows its operands (Eq's and Ord's
// `lhs : &Self`) lends them like a written `&a`
// (issues/fixed/2026-10-14-an-operator-operand-lent-to-its-method-can-be-moved-by-the-other-operand.md).
_PmCmp :: struct(n : i32);
(g_pm_cmp_dropped : i32) = i32(0);
impl(
  _PmCmp,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_pm_cmp_dropped = (g_pm_cmp_dropped + i32(1));
    })
  )
);
impl(_PmCmp, Eq(_PmCmp)((==) : ((lhs, rhs) -> (lhs.n == rhs.n))));
impl(
  _PmCmp,
  Ord(_PmCmp)(
    (<) : ((lhs, rhs) -> (lhs.n < rhs.n)),
    (<=) : ((lhs, rhs) -> (lhs.n <= rhs.n)),
    (>) : ((lhs, rhs) -> (lhs.n > rhs.n)),
    (>=) : ((lhs, rhs) -> (lhs.n >= rhs.n))
  )
);
_pm_cmp_eat :: (fn(c : _PmCmp) -> i32)(c.n);
_pm_cmp_make :: (fn(n : i32) -> _PmCmp)(_PmCmp(n : n));
test("an operator operand its method borrows cannot be moved by the other operand", {
  comptime_expect_error({
    a := _PmCmp(n : i32(1));
    a == _pm_cmp_make(_pm_cmp_eat(a))
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    a := _PmCmp(n : i32(1));
    a != _pm_cmp_make(_pm_cmp_eat(a))
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    a := _PmCmp(n : i32(1));
    a < _pm_cmp_make(_pm_cmp_eat(a))
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    a := _PmCmp(n : i32(1));
    a >= {
      a = _PmCmp(n : i32(5));
      _pm_cmp_make(i32(5))
    }
  }, "the borrow starts when that argument is evaluated");
  a := _PmCmp(n : i32(1));
  o := _PmCmp(n : i32(1));
  assert(a == _pm_cmp_make(_pm_cmp_eat(o)), "the other operand may move another binding");
  assert(a == a, "both operands may lend one place");
  assert(a < _pm_cmp_make(i32(2)), "an ordinary comparison");
  assert(a.n == i32(1), "the lent operand is intact");
});

test("imm is an ordinary identifier", {
  (imm : Impl(Fn(x : i32) -> i32)) = ((x : i32) => (x + i32(1)));
  assert(imm(i32(1)) == i32(2), "a closure named imm is called");
});

// `Clone` and `ToString` only read their receiver, so they take
// `self : &Self`, as Rust's do
// (issues/fixed/clone-and-to-string-take-their-receiver-mutably.md): a `&T`
// borrow, a generic one included, can clone and render. An impl member that
// writes a receiver its trait lends read-only is rejected at the impl, since a
// call through the trait would hand it the read-only borrow
// (issues/fixed/an-impl-may-write-a-receiver-its-trait-lends-read-only.md).
_PmLbl :: struct(s : String);
impl(_PmLbl, Clone(clone : (fn(self : &Self) -> Self)(_PmLbl(s : self.s.clone()))));
impl(_PmLbl, ToString(to_string : (fn(self : &Self) -> String)(self.s.clone())));
_pm_copy_of :: (fn(generic(T : Type), x : &T, where(T <: Clone)) -> T)(x.clone());
_pm_render :: (fn(generic(T : Type), x : &T, where(T <: ToString)) -> String)(x.to_string());
_PmReadM :: trait(read_m : (fn(self : &Self) -> i32));
_PmTally :: struct(n : i32);
test("Clone and ToString read a & borrow", {
  l := _PmLbl(s : String.from("x"));
  c := _pm_copy_of(&l);
  assert(c.s == "x", "cloned through a generic &T");
  assert(_pm_render(&l) == "x", "rendered through a generic &T");
  assert(l.s == "x", "the source is unchanged");
});
test("an impl member may not write a receiver its trait lends read-only", {
  comptime_expect_error(
    impl(
      _PmTally,
      _PmReadM(
        read_m : (fn(self : &mut Self) -> i32)({
          self.n = (self.n + i32(1));
          self.n
        })
      )
    ),
    "lends its receiver read-only"
  );
  comptime_expect_error(impl(_PmTally, Clone(clone : (fn(self : &mut Self) -> Self)(_PmTally(n : self.n)))), "lends its receiver read-only");
});

// `Hash.hash`, `Hasher.finish`, `Debug.debug_string`, `Format.format`,
// `ToJson.to_json` and `Error.source` only read their receiver too, so they take `self : &Self`
// as well (issues/fixed/hash-debug-format-to-json-and-source-take-their-receiver-mutably.md):
// a `&T` borrow reaches them, and an impl member that spells
// `self : &mut Self` is rejected at the impl.
_PmKey :: struct(n : i32);
derive(_PmKey, Hash, Debug);
impl(_PmKey, ToString(to_string : (fn(self : &Self) -> String)(self.n.to_string())));
impl(_PmKey, Format());
impl(_PmKey, ToJson(to_json : (fn(self : &Self) -> JsonValue)(JsonValue.Int(value : i64(self.n)))));
impl(_PmKey, Error(source : (fn(self : &Self) -> Option(AnyError))(.None)));
_pm_hash_of :: (fn(generic(T : Type), x : &T, where(T <: Hash)) -> u64)({
  h := DefaultHasher.new();
  x.hash(&mut h);
  h.finish()
});
_pm_finish_of :: (fn(generic(H : Type), h : &H, where(H <: Hasher)) -> u64)(h.finish());
_pm_debug_of :: (fn(generic(T : Type), x : &T, where(T <: Debug)) -> String)(x.debug_string());
_pm_format_of :: (fn(generic(T : Type), x : &T, where(T <: Format)) -> String)(x.format(">4"));
_pm_json_of :: (fn(generic(T : Type), x : &T, where(T <: ToJson)) -> JsonValue)(x.to_json());
_pm_has_source :: (fn(generic(T : Type), x : &T, where(T <: Error)) -> bool)(x.source().is_some());
_PmReadOnly :: struct(n : i32);
impl(_PmReadOnly, ToString(to_string : (fn(self : &Self) -> String)(self.n.to_string())));
test("Hash, Debug, Format, ToJson and Error.source read a & borrow", {
  k := _PmKey(n : i32(7));
  h := DefaultHasher.new();
  k.hash(&mut h);
  assert(_pm_hash_of(&k) == h.finish(), "hashed through a generic &T");
  assert(_pm_finish_of(&h) == h.finish(), "a hasher finished through a generic &H");
  assert(_pm_debug_of(&k) == "_PmKey(7)", "debug-rendered through a generic &T");
  assert(_pm_format_of(&k) == "   7", "formatted through a generic &T");
  assert(match(_pm_json_of(&k), .Int(v) => (v == i64(7)), _ => false), "encoded through a generic &T");
  assert(!_pm_has_source(&k), "source read through a generic &T");
  assert(k.n == i32(7), "the source is unchanged");
});
test("Hash, Debug, Format, ToJson and Error impls may not take self : &mut Self", {
  comptime_expect_error(impl(_PmReadOnly, Debug(debug_string : (fn(self : &mut Self) -> String)(self.n.to_string()))), "lends its receiver read-only");
  comptime_expect_error(impl(_PmReadOnly, ToJson(to_json : (fn(self : &mut Self) -> JsonValue)(JsonValue.Null))), "lends its receiver read-only");
  comptime_expect_error(impl(_PmReadOnly, Error(source : (fn(self : &mut Self) -> Option(AnyError))(.None))), "lends its receiver read-only");
  comptime_expect_error(impl(_PmReadOnly, Hash(hash : (fn(generic(H : Type), self : &mut Self, hasher : &mut H, where(H <: Hasher)) -> unit)(hasher.write_i32(self.n)))), "lends its receiver read-only");
});
