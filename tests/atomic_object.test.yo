open import "std/fmt";

/// Basic atomic object with value fields
AtomicPoint :: atomic object(x : i32, y : i32);

test "Create atomic object", {
  (p : AtomicPoint) = AtomicPoint(i32(10), i32(20));
  assert((p.x == i32(10)), "x should be 10");
  assert((p.y == i32(20)), "y should be 20");
  println(`AtomicPoint: (${p.x}, ${p.y})`);
};

test "Atomic object implements Send", {
  comptime_assert(Type.impls(AtomicPoint, Send), "AtomicPoint should implement Send");
  println("AtomicPoint implements Send: OK");
};

/// Regular object should NOT implement Send
RegularPoint :: object(x : i32, y : i32);

test "Regular object does not implement Send", {
  comptime_assert((Type.impls(RegularPoint, Send) == false), "RegularPoint should not implement Send");
  println("RegularPoint does not implement Send: OK");
};

/// Atomic object with reference counting
AtomicCounter :: atomic object(value : i32);

test "Atomic object reference counting", {
  (a : AtomicCounter) = AtomicCounter(i32(42));
  (b : AtomicCounter) = a;
  assert((a.value == i32(42)), "a.value should be 42");
  assert((b.value == i32(42)), "b.value should be 42");
  println("Atomic object RC: OK");
};

/// Atomic object as a generic type
AtomicBox :: (fn(comptime(T) : Type, where(T <: (Send, Acyclic))) -> comptime(Type))(
  atomic object(value : T)
);

test "Generic atomic object", {
  (b : AtomicBox(i32)) = AtomicBox(i32)(i32(99));
  assert((b.value == i32(99)), "value should be 99");
  println(`AtomicBox: ${b.value}`);
};

/// Atomic object with Send constraint
SendBox :: (fn(comptime(T) : Type, where(T <: (Send, Acyclic))) -> comptime(Type))(
  atomic object(value : T)
);

test "Atomic object with Send constraint", {
  (b : SendBox(i32)) = SendBox(i32)(i32(77));
  assert((b.value == i32(77)), "value should be 77");
  comptime_assert(Type.impls(SendBox(i32), Send), "SendBox(i32) should implement Send");
  println(`SendBox: ${b.value}`);
};

/// Atomic object with Dispose trait
AtomicResource :: atomic object(id : i32);

impl(AtomicResource,
  dispose : (fn(self : Self) -> unit)({
    println(`Disposing AtomicResource(${self.id})`);
  })
);

test "Atomic object with Dispose", {
  {
    (r : AtomicResource) = AtomicResource(i32(1));
    println(`Created AtomicResource(${r.id})`);
  };
  println("After scope - dispose should have been called");
};

/// Test Send constraint validation at module level
comptime_assert((Type.impls(RegularPoint, Send) == false), "RegularPoint must not impl Send for constraint test");

test "Atomic object Send constraint rejects non-Send types", {
  /// We verified above that RegularPoint does not implement Send,
  /// so SendBox(RegularPoint) would fail at compile time.
  /// Here we just verify the constraint works positively.
  comptime_assert(Type.impls(SendBox(i32), Send), "SendBox(i32) should implement Send");
  println("Send constraint validation: OK");
};

/// Test that atomic object with non-Send field is rejected at compile time
test "Atomic object rejects non-Send fields", {
  comptime_expect_error(atomic object(inner : RegularPoint));
  println("Non-Send field rejection: OK");
};

/// Test that self-referential atomic object compiles but does not auto-derive Acyclic
test "Self-referential atomic object does not auto-derive Acyclic", {
  SelfRefNode :: atomic object(_value : i32, _next : Option(Self));
  comptime_assert((Type.impls(SelfRefNode, Acyclic) == false), "self-referential atomic object should not derive Acyclic");
  comptime_assert(Type.impls(SelfRefNode, Send), "self-referential atomic object should still derive Send");
  println("Self-referential Acyclic check: OK");
};

/// Test that manual Acyclic impl works for self-referential types
test "Manual Acyclic impl for self-referential type", {
  ImmNode :: atomic object(_value : i32, _next : Option(Self));
  impl(ImmNode, Acyclic());
  comptime_assert(Type.impls(ImmNode, Acyclic), "manual Acyclic impl should work");
  println("Manual Acyclic impl: OK");
};

/// Test that atomic objects implement Acyclic
test "Atomic object implements Acyclic", {
  comptime_assert(Type.impls(AtomicPoint, Acyclic), "AtomicPoint should implement Acyclic");
  comptime_assert(Type.impls(AtomicCounter, Acyclic), "AtomicCounter should implement Acyclic");
  comptime_assert(Type.impls(AtomicResource, Acyclic), "AtomicResource should implement Acyclic");
  println("Atomic object Acyclic: OK");
};
