{ assert } :: import("std/assert");
{ println } :: import("std/fmt");
/// Basic atomic object with value fields
AtomicPoint :: atomic(ref(struct(x : i32, y : i32)));
test("Create atomic object", {
  (p : AtomicPoint) = AtomicPoint(i32(10), i32(20));
  assert(p.x == i32(10), "x should be 10");
  assert(p.y == i32(20), "y should be 20");
  println(`AtomicPoint: (${p.x}, ${p.y})`);
});
test("Atomic object implements Send", {
  comptime_assert(Type.impls(AtomicPoint, Send), "AtomicPoint should implement Send");
  println("AtomicPoint implements Send: OK");
});
/// Regular object should NOT implement Send
RegularPoint :: ref(struct(x : i32, y : i32));
test("Regular object does not implement Send", {
  comptime_assert(Type.impls(RegularPoint, Send) == false, "RegularPoint should not implement Send");
  println("RegularPoint does not implement Send: OK");
});
/// Atomic object with reference counting
AtomicCounter :: atomic(ref(struct(value : i32)));
test("Atomic object reference counting", {
  (a : AtomicCounter) = AtomicCounter(i32(42));
  (b : AtomicCounter) = a;
  assert(a.value == i32(42), "a.value should be 42");
  assert(b.value == i32(42), "b.value should be 42");
  println("Atomic object RC: OK");
});
/// Atomic object as a generic type
AtomicBox :: (fn(comptime(T) : Type, where(T <: (Send, Acyclic))) -> comptime(Type))(
  atomic(ref(struct(value : T)))
);
test("Generic atomic object", {
  (b : AtomicBox(i32)) = AtomicBox(i32)(i32(99));
  assert(b.value == i32(99), "value should be 99");
  println(`AtomicBox: ${b.value}`);
});
/// Atomic object with Send constraint
SendBox :: (fn(comptime(T) : Type, where(T <: (Send, Acyclic))) -> comptime(Type))(
  atomic(ref(struct(value : T)))
);
test("Atomic object with Send constraint", {
  (b : SendBox(i32)) = SendBox(i32)(i32(77));
  assert(b.value == i32(77), "value should be 77");
  comptime_assert(Type.impls(SendBox(i32), Send), "SendBox(i32) should implement Send");
  println(`SendBox: ${b.value}`);
});
/// Atomic object with Drop trait
AtomicResource :: atomic(ref(struct(id : i32)));
impl(
  AtomicResource,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      println(`Dropping AtomicResource(${self.id})`);
    })
  )
);
test("Atomic object with Drop", {
  {
    (r : AtomicResource) = AtomicResource(i32(1));
    println(`Created AtomicResource(${r.id})`);
  };
  println("After scope - drop should have been called");
});
/// Test Send constraint validation at module level
comptime_assert(Type.impls(RegularPoint, Send) == false, "RegularPoint must not impl Send for constraint test");
test("Atomic object Send constraint rejects non-Send types", {
  /// We verified above that RegularPoint does not implement Send,
  /// so SendBox(RegularPoint) would fail at compile time.
  /// Here we just verify the constraint works positively.
  comptime_assert(Type.impls(SendBox(i32), Send), "SendBox(i32) should implement Send");
  println("Send constraint validation: OK");
});
/// Test that atomic object with non-Send field is rejected at compile time
test("Atomic object rejects non-Send fields", {
  comptime_expect_error(atomic(ref(struct(inner : RegularPoint))));
  println("Non-Send field rejection: OK");
});
// The Acyclic derivation cases below recurse through an `Arc` (an atomic
// shared cell) since V5; the atomic-object cases above stay `ref` for the
// v0.2.77 parser PR.
/// Test that a struct reaching itself through an Arc compiles but does not auto-derive Acyclic
test("Self-referential struct through an Arc does not auto-derive Acyclic", {
  SelfRefNode :: struct(_value : i32, _next : Option(Arc(Self)));
  comptime_assert(Type.impls(SelfRefNode, Acyclic) == false, "a struct reaching itself through an Arc should not derive Acyclic");
  comptime_assert(Type.impls(SelfRefNode, Send), "a struct reaching itself through an Arc should still derive Send");
  println("Self-referential Acyclic check: OK");
});
/// Test that atomic objects implement Acyclic
test("Atomic object implements Acyclic", {
  comptime_assert(Type.impls(AtomicPoint, Acyclic), "AtomicPoint should implement Acyclic");
  comptime_assert(Type.impls(AtomicCounter, Acyclic), "AtomicCounter should implement Acyclic");
  comptime_assert(Type.impls(AtomicResource, Acyclic), "AtomicResource should implement Acyclic");
  println("Atomic object Acyclic: OK");
});
/// Test that cycles through value-type struct intermediaries are detected
test("Cycle through struct wrapper does not derive Acyclic", {
  Wrap :: (fn(comptime(T) : Type) -> comptime(Type))(struct(inner : T));
  derive(generic(T : Type), where(T <: Clone), Wrap(T), Clone);
  derive(generic(T : Type), where(T <: Copy), Wrap(T), Copy);
  CyclicNode :: struct(data : i32, child : Option(Wrap(Arc(Self))));
  // Wrap(i32) has no cycle — should be Acyclic
  comptime_assert(Type.impls(Wrap(i32), Acyclic), "Wrap(i32) should be Acyclic");
  // CyclicNode -> Option(Wrap(Arc(CyclicNode))) -> Wrap(Arc(CyclicNode)) -> struct(inner: Arc(CyclicNode)) -> CyclicNode
  comptime_assert(Type.impls(CyclicNode, Acyclic) == false, "cycle through struct wrapper should not derive Acyclic");
  comptime_assert(Type.impls(CyclicNode, Send), "cycle through struct wrapper should still derive Send");
  println("Cycle through struct wrapper Acyclic check: OK");
});
/// Test that cycles through multiple struct intermediaries are detected
test("Cycle through chained struct wrappers does not derive Acyclic", {
  WrapA :: (fn(comptime(T) : Type) -> comptime(Type))(struct(inner : T));
  WrapB :: (fn(comptime(T) : Type) -> comptime(Type))(struct(inner : T));
  DeepNode :: struct(data : i32, child : Option(WrapA(WrapB(Arc(Self)))));
  comptime_assert(Type.impls(DeepNode, Acyclic) == false, "deep cycle through struct wrappers should not derive Acyclic");
  comptime_assert(Type.impls(DeepNode, Send), "deep cycle should still derive Send");
  println("Cycle through chained struct wrappers: OK");
});
/// Test that newtype wrapper cycles are also detected
test("Cycle through newtype wrapper does not derive Acyclic", {
  Wrapper :: (fn(comptime(T) : Type) -> comptime(Type))(newtype(inner : T));
  NewtypeNode :: struct(data : i32, child : Option(Wrapper(Arc(Self))));
  comptime_assert(Type.impls(NewtypeNode, Acyclic) == false, "cycle through newtype should not derive Acyclic");
  println("Cycle through newtype wrapper: OK");
});
/// Test that non-Send type is rejected by atomic object definition
test("comptime_expect_error: atomic object with non-Send object field", {
  NonSendObj :: ref(struct(x : i32));
  comptime_expect_error({
    Bad :: atomic(ref(struct(inner : NonSendObj)));
  });
  println("Reject non-Send object field: OK");
});
/// Test that Acyclic constraint rejects self-referential atomic object
test("comptime_expect_error: Acyclic constraint rejects cyclic type", {
  SelfRef :: struct(val : i32, next : Option(Arc(Self)));
  AcyclicBox :: (fn(comptime(T) : Type, where(T <: Acyclic)) -> comptime(Type))(
    struct(inner : T)
  );
  comptime_expect_error({
    Bad :: AcyclicBox(SelfRef);
  });
  println("Reject cyclic type with Acyclic constraint: OK");
});
/// Test that Acyclic constraint rejects cycle through struct wrapper
test("comptime_expect_error: Acyclic constraint rejects struct-wrapped cycle", {
  Wrap :: (fn(comptime(T) : Type) -> comptime(Type))(struct(inner : T));
  derive(generic(T : Type), where(T <: Clone), Wrap(T), Clone);
  derive(generic(T : Type), where(T <: Copy), Wrap(T), Copy);
  CyclicNode :: struct(data : i32, child : Option(Wrap(Arc(Self))));
  AcyclicContainer :: (fn(comptime(T) : Type, where(T <: Acyclic)) -> comptime(Type))(
    struct(value : T)
  );
  comptime_expect_error({
    Bad :: AcyclicContainer(CyclicNode);
  });
  println("Reject struct-wrapped cycle with Acyclic constraint: OK");
});
/// Test that Send constraint rejects regular object
test("comptime_expect_error: Send constraint rejects a struct holding an Rc", {
  NonSendObj :: struct(x : Rc(i32));
  SendContainer :: (fn(comptime(T) : Type, where(T <: Send)) -> comptime(Type))(
    struct(value : T)
  );
  comptime_expect_error({
    Bad :: SendContainer(NonSendObj);
  });
  println("Reject non-Send type with Send constraint: OK");
});
/// Test that combined Send + Acyclic constraint rejects a Send but cyclic type
test("comptime_expect_error: Send+Acyclic rejects a Send but cyclic type", {
  CyclicAO :: struct(val : i32, next : Option(Arc(Self)));
  SendAcyclicBox :: (fn(comptime(T) : Type, where(T <: (Send, Acyclic))) -> comptime(Type))(
    struct(value : T)
  );
  comptime_assert(Type.impls(CyclicAO, Send), "the cyclic type is Send");
  comptime_expect_error({
    Bad :: SendAcyclicBox(CyclicAO);
  });
  println("Reject cyclic Send type with Send+Acyclic: OK");
});
/// Test that cycles through enum intermediaries are detected
test("Cycle through enum wrapper does not derive Acyclic", {
  MyEnum :: (fn(comptime(T) : Type) -> comptime(Type))(
    enum(Present(val : T), Absent)
  );
  EnumNode :: struct(data : i32, child : MyEnum(Arc(Self)));
  comptime_assert(Type.impls(EnumNode, Acyclic) == false, "cycle through enum wrapper should not derive Acyclic");
  comptime_assert(Type.impls(EnumNode, Send), "cycle through enum wrapper should still derive Send");
  println("Cycle through enum wrapper Acyclic check: OK");
});
/// Test that Acyclic constraint rejects enum-wrapped cyclic type
test("comptime_expect_error: Acyclic constraint rejects enum-wrapped cycle", {
  MyEnum :: (fn(comptime(T) : Type) -> comptime(Type))(
    enum(Present(val : T), Absent)
  );
  EnumNode :: struct(data : i32, child : MyEnum(Arc(Self)));
  AcyclicBox :: (fn(comptime(T) : Type, where(T <: Acyclic)) -> comptime(Type))(
    struct(inner : T)
  );
  comptime_expect_error({
    Bad :: AcyclicBox(EnumNode);
  });
  println("Reject enum-wrapped cycle with Acyclic constraint: OK");
});
