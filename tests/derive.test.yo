{ assert } :: import("std/assert");
// Tests for derive(Type, Trait(Type)) — auto-generated trait implementations
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ hash_one } :: import("std/hash");
// === Basic struct for testing ===
Point :: struct(x : i32, y : i32);
derive(Point, Eq(Point));
// === Test derive Eq for struct ===
test("derive Eq for struct", {
  p1 := Point(i32(1), i32(2));
  p2 := Point(i32(1), i32(2));
  p3 := Point(i32(3), i32(4));
  assert(p1 == p2, "equal points should be equal");
  assert(p1 != p3, "different points should not be equal");
  assert(!(p1 == p3), "negation of equal should work");
  assert(!(p1 != p2), "negation of not-equal should work");
});
// === Test derive Eq for empty struct ===
Empty :: struct();
derive(Empty, Eq(Empty));
test("derive Eq for empty struct", {
  e1 := Empty();
  e2 := Empty();
  assert(e1 == e2, "empty structs should be equal");
});
// === Test derive Eq for single-field struct ===
Wrapper :: struct(value : i32);
derive(Wrapper, Eq(Wrapper));
test("derive Eq for single-field struct", {
  w1 := Wrapper(i32(42));
  w2 := Wrapper(i32(42));
  w3 := Wrapper(i32(99));
  assert(w1 == w2, "same value wrappers should be equal");
  assert(w1 != w3, "different value wrappers should not be equal");
});
// === Test derive Hash for struct ===
derive(Point, Hash);
test("derive Hash for struct", {
  p1 := Point(i32(1), i32(2));
  p2 := Point(i32(1), i32(2));
  p3 := Point(i32(3), i32(4));
  h1 := hash_one(p1);
  h2 := hash_one(p2);
  h3 := hash_one(p3);
  assert(h1 == h2, "equal points should have equal hashes");
  assert(h1 != h3, "different points should likely have different hashes");
});
// === Test derive Clone for struct ===
derive(Point, Clone);
test("derive Clone for struct", {
  p1 := Point(i32(1), i32(2));
  p2 := p1.clone();
  assert(p1 == p2, "cloned point should equal original");
});
// === Test derive Ord for struct ===
derive(Point, Ord(Point));
test("derive Ord for struct", {
  p1 := Point(i32(1), i32(2));
  p2 := Point(i32(1), i32(3));
  p3 := Point(i32(2), i32(1));
  // Lexicographic: (1,2) < (1,3)
  assert(p1 < p2, "(1,2) should be < (1,3)");
  assert(p1 <= p2, "(1,2) should be <= (1,3)");
  assert(!(p1 > p2), "(1,2) should not be > (1,3)");
  assert(!(p1 >= p2), "(1,2) should not be >= (1,3)");
  // Lexicographic: (1,2) < (2,1)
  assert(p1 < p3, "(1,2) should be < (2,1)");
  // Equal points
  p4 := Point(i32(1), i32(2));
  assert(p1 <= p4, "equal points should be <=");
  assert(p1 >= p4, "equal points should be >=");
  assert(!(p1 < p4), "equal points should not be <");
  assert(!(p1 > p4), "equal points should not be >");
});
// === Test derive ToString for struct ===
derive(Point, ToString);
test("derive ToString for struct", {
  p := Point(i32(1), i32(2));
  s := p.to_string();
  assert(s == `Point(1, 2)`, "toString should format as Point(1, 2)");
});
// === Test multiple derives in one call ===
Color :: struct(r : i32, g : i32, b : i32);
derive(Color, Eq(Color), Hash, Clone, Ord(Color), ToString);
test("multiple derives in one call", {
  c1 := Color(i32(255), i32(0), i32(0));
  c2 := Color(i32(255), i32(0), i32(0));
  c3 := Color(i32(0), i32(255), i32(0));
  // Eq
  assert(c1 == c2, "same colors should be equal");
  assert(c1 != c3, "different colors should not be equal");
  // Hash
  assert(hash_one(c1) == hash_one(c2), "same colors should have same hash");
  // Clone
  c4 := c1.clone();
  assert(c1 == c4, "cloned color should equal original");
  // Ord
  assert(c3 < c1, "(0,255,0) should be < (255,0,0)");
  // ToString
  s := c1.to_string();
  assert(s == `Color(255, 0, 0)`, "toString should format correctly");
});
// === Test derive for struct with bool fields ===
Flags :: struct(a : bool, b : bool);
derive(Flags, Eq(Flags), Hash, Clone);
test("derive for struct with bool fields", {
  f1 := Flags(true, false);
  f2 := Flags(true, false);
  f3 := Flags(false, true);
  assert(f1 == f2, "same flags should be equal");
  assert(f1 != f3, "different flags should not be equal");
  f4 := f1.clone();
  assert(f1 == f4, "cloned flags should equal original");
});
// === Test derive Eq for fieldless enum ===
Direction :: enum(North, South, East, West);
derive(Direction, Eq(Direction));
test("derive Eq for fieldless enum", {
  d1 := Direction.North;
  d2 := Direction.North;
  d3 := Direction.South;
  assert(d1 == d2, "same direction should be equal");
  assert(d1 != d3, "different directions should not be equal");
});
// === Test derive Hash for fieldless enum ===
derive(Direction, Hash);
test("derive Hash for fieldless enum", {
  d1 := Direction.North;
  d2 := Direction.North;
  d3 := Direction.South;
  assert(hash_one(d1) == hash_one(d2), "same direction should have same hash");
  assert(hash_one(d1) != hash_one(d3), "different directions should have different hashes");
});
// === Test derive Clone for fieldless enum ===
derive(Direction, Clone);
test("derive Clone for fieldless enum", {
  d1 := Direction.North;
  d2 := d1.clone();
  assert(d1 == d2, "cloned direction should equal original");
});
// === Test derive Ord for fieldless enum ===
derive(Direction, Ord(Direction));
test("derive Ord for fieldless enum", {
  assert(Direction.North < Direction.South, "North < South");
  assert(Direction.North <= Direction.North, "North <= North");
  assert(Direction.West > Direction.East, "West > East");
});
// === Test derive ToString for fieldless enum ===
derive(Direction, ToString);
test("derive ToString for fieldless enum", {
  d := Direction.North;
  s := d.to_string();
  assert(s == `Direction.North`, "toString should format as Direction.North");
});
// === Test derive for enum with fields ===
Shape :: enum(
  Circle(radius : i32),
  Rectangle(width : i32, height : i32)
);
derive(Shape, Eq(Shape), Hash, Clone, ToString);
test("derive Eq for enum with fields", {
  s1 := Shape.Circle(i32(5));
  s2 := Shape.Circle(i32(5));
  s3 := Shape.Circle(i32(10));
  s4 := Shape.Rectangle(i32(3), i32(4));
  assert(s1 == s2, "same circles should be equal");
  assert(s1 != s3, "different circles should not be equal");
  assert(s1 != s4, "circle should not equal rectangle");
});
test("derive Clone for enum with fields", {
  s1 := Shape.Circle(i32(5));
  s2 := s1.clone();
  assert(s1 == s2, "cloned shape should equal original");
  s3 := Shape.Rectangle(i32(3), i32(4));
  s4 := s3.clone();
  assert(s3 == s4, "cloned rectangle should equal original");
});
test("derive ToString for enum with fields", {
  s1 := Shape.Circle(i32(5));
  assert(s1.to_string() == `Shape.Circle(5)`, "circle toString");
  s2 := Shape.Rectangle(i32(3), i32(4));
  assert(s2.to_string() == `Shape.Rectangle(3, 4)`, "rectangle toString");
});
// === Test derive for struct containing derived struct ===
Line :: struct(start : Point, end_ : Point);
derive(Line, Eq(Line), Clone);
test("derive for nested struct", {
  l1 := Line(Point(i32(0), i32(0)), Point(i32(1), i32(1)));
  l2 := Line(Point(i32(0), i32(0)), Point(i32(1), i32(1)));
  l3 := Line(Point(i32(0), i32(0)), Point(i32(2), i32(2)));
  assert(l1 == l2, "same lines should be equal");
  assert(l1 != l3, "different lines should not be equal");
  l4 := l1.clone();
  assert(l1 == l4, "cloned line should equal original");
});
// ============================================================
// v2: Explicit trait argument syntax
// ============================================================
// Test: derive(Type, Trait(Type)) — explicit trait args
Vec2 :: struct(x : i32, y : i32);
derive(Vec2, Eq(Vec2));
test("derive with explicit trait arg Eq(Type)", {
  v1 := Vec2(i32(3), i32(4));
  v2 := Vec2(i32(3), i32(4));
  v3 := Vec2(i32(1), i32(2));
  assert(v1 == v2, "explicit trait arg: equal");
  assert(v1 != v3, "explicit trait arg: not equal");
});
// Test: multiple explicit trait args
Vec3 :: struct(x : i32, y : i32, z : i32);
derive(Vec3, Eq(Vec3), Hash, Clone);
test("derive with multiple explicit trait args", {
  v1 := Vec3(i32(1), i32(2), i32(3));
  v2 := v1.clone();
  assert(v1 == v2, "mixed args: clone equals original");
  h1 := hash_one(v1);
  h2 := hash_one(v2);
  assert(h1 == h2, "mixed args: equal values same hash");
});
// ============================================================
// v2: comptime_eval
// ============================================================
EvalPoint :: struct(a : i32, b : i32);
comptime_eval("derive(EvalPoint, Eq(EvalPoint))");
test("comptime_eval derive", {
  ep1 := EvalPoint(i32(5), i32(10));
  ep2 := EvalPoint(i32(5), i32(10));
  ep3 := EvalPoint(i32(1), i32(2));
  assert(ep1 == ep2, "comptime_eval: equal");
  assert(ep1 != ep3, "comptime_eval: not equal");
});
// =============================================================================
// === derive_rule tests (Phase 2) — user-defined derive rules via macros ===
// =============================================================================
// Define a custom equality trait
MyEq :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    my_eq : (fn(self : Self, other : Rhs) -> bool)
  )
);
impl(
  i32,
  MyEq(i32)(
    my_eq : ((self, other) -> (self == other))
  )
);
impl(
  bool,
  MyEq(bool)(
    my_eq : ((self, other) -> (self == other))
  )
);
// Register derive rule for MyEq: field-wise equality (structs and fieldless enums)
my_derive_eq :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))({
  info :: Type.get_info(T);
  eq_body :: cond(
    info.is_struct() => cond(
      (Type.get_struct_fields(T).len() == usize(0)) => quote(true),
      true => Type.join_fields(
        T,
        (fn(comptime(field) : FieldInfo) -> comptime(Expr))(
          quote(self.(#(field.name.to_expr())).my_eq(other.(#(field.name.to_expr()))))
        ),
        quote(&&)
      )
    ),
    info.is_enum() => {
      match_branches :: Type.map_variants(
        T,
        (fn(comptime(variant) : VariantInfo) -> comptime(Expr))(
          cond(
            (variant.fields.len() == usize(0)) => quote(
              .(#(variant.name.to_expr())) => match(
                other,
                .(#(variant.name.to_expr())) => true,
                _ => false
              )
            ),
            true => quote(
              _ => false
            )
          )
        )
      );
      quote(match(self, ...#(match_branches)))
    },
    true => quote(false)
  );
  ctx.make_impl(
    quote(
      MyEq(...#(trait_params))(
        my_eq : ((self, other) -> #(eq_body))
      )
    )
  )
});
derive_rule(MyEq, my_derive_eq);
UsesEq :: trait(
  uses_eq : (fn(self : Self, other : Self) -> bool)
);
__derive_uses_eq :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))(
  ctx.make_impl(
    quote(
      UsesEq(
        uses_eq : ((self, other) -> (self == other))
      )
    )
  )
);
derive_rule(UsesEq, __derive_uses_eq);
// Test: derive_rule for 2-field struct
DRPoint :: struct(x : i32, y : i32);
derive(DRPoint, MyEq(DRPoint));
test("derive_rule MyEq for 2-field struct", {
  p1 := DRPoint(i32(1), i32(2));
  p2 := DRPoint(i32(1), i32(2));
  p3 := DRPoint(i32(1), i32(3));
  assert(p1.my_eq(p2), "equal points should be equal");
  assert(!(p1.my_eq(p3)), "different points should not be equal");
});
// Test: derive_rule for 3-field struct
DRVec3 :: struct(x : i32, y : i32, z : i32);
derive(DRVec3, MyEq(DRVec3));
test("derive_rule MyEq for 3-field struct", {
  v1 := DRVec3(i32(1), i32(2), i32(3));
  v2 := DRVec3(i32(1), i32(2), i32(3));
  v3 := DRVec3(i32(1), i32(2), i32(4));
  assert(v1.my_eq(v2), "equal vec3 should be equal");
  assert(!(v1.my_eq(v3)), "different vec3 should not be equal");
});
// Test: derive_rule for empty struct
DREmpty :: struct();
derive(DREmpty, MyEq(DREmpty));
test("derive_rule MyEq for empty struct", {
  e1 := DREmpty();
  e2 := DREmpty();
  assert(e1.my_eq(e2), "empty structs should be equal");
});
// Test: derive_rule for mixed-type struct
DRRecord :: struct(id : i32, active : bool);
derive(DRRecord, MyEq(DRRecord));
test("derive_rule MyEq for mixed-type struct", {
  r1 := DRRecord(i32(1), true);
  r2 := DRRecord(i32(1), true);
  r3 := DRRecord(i32(1), false);
  assert(r1.my_eq(r2), "equal records should be equal");
  assert(!(r1.my_eq(r3)), "different records should not be equal");
});
// Test: derive_rule for fieldless enum
DRColor :: enum(Red, Green, Blue);
derive(DRColor, MyEq(DRColor));
test("derive_rule MyEq for fieldless enum", {
  r := DRColor.Red;
  g := DRColor.Green;
  r2 := DRColor.Red;
  assert(r.my_eq(r2), "Red should equal Red");
  assert(!(r.my_eq(g)), "Red should not equal Green");
  assert(!(g.my_eq(DRColor.Blue)), "Green should not equal Blue");
});
UsesEqPoint :: struct(x : i32, y : i32);
derive(UsesEqPoint, Eq(UsesEqPoint), UsesEq);
test("multiple derives in one call share accumulated impl env", {
  p1 := UsesEqPoint(i32(1), i32(2));
  p2 := UsesEqPoint(i32(1), i32(2));
  p3 := UsesEqPoint(i32(2), i32(3));
  assert(p1.uses_eq(p2), "UsesEq derive should see Eq derived earlier in the same call");
  assert(!(p1.uses_eq(p3)), "UsesEq derive should use the derived Eq implementation");
});
// ========== Test: generic derive_rule with generic/where ==========
// Generic struct type constructor
DRPair :: (fn(comptime(A) : Type, comptime(B) : Type) -> comptime(Type))(
  struct(first : A, second : B)
);
// Generic derive with generic/where
derive(generic(T1, T2), DRPair(T1, T2), where(T1 <: MyEq(T1), T2 <: MyEq(T2)), MyEq(DRPair(T1, T2)));
test("derive_rule MyEq for generic struct with generic/where", {
  p1 := DRPair(i32, i32)(i32(1), i32(2));
  p2 := DRPair(i32, i32)(i32(1), i32(2));
  p3 := DRPair(i32, i32)(i32(1), i32(3));
  assert(p1.my_eq(p2), "equal pairs should be equal");
  assert(!(p1.my_eq(p3)), "different pairs should not be equal");
});
test("derive_rule MyEq for generic struct with mixed types", {
  m1 := DRPair(i32, bool)(i32(42), true);
  m2 := DRPair(i32, bool)(i32(42), true);
  m3 := DRPair(i32, bool)(i32(42), false);
  assert(m1.my_eq(m2), "equal mixed pairs should be equal");
  assert(!(m1.my_eq(m3)), "different mixed pairs should not be equal");
});
// ========== Test: built-in derive with generic/where ==========
DRGenericBox :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(value : T)
);
derive(generic(T), DRGenericBox(T), where(T <: Eq(T)), Eq(DRGenericBox(T)));
test("built-in derive Eq for generic struct with generic/where", {
  b1 := DRGenericBox(i32)(i32(10));
  b2 := DRGenericBox(i32)(i32(10));
  b3 := DRGenericBox(i32)(i32(20));
  assert(b1 == b2, "equal boxes should be equal");
  assert(!(b1 == b3), "different boxes should not be equal");
});
// ============================================================
// derive(Default) — STD_API_AUDIT D3.1
// ============================================================
// Every field takes its own type's default via `(FieldType <: Default).default()`.
DefConfig :: struct(retries : i32, verbose : bool, ratio : f64);
derive(DefConfig, Eq(DefConfig), Default);
test("derive Default for struct of primitives", {
  d := (DefConfig <: Default).default();
  assert(d == DefConfig(i32(0), false, f64(0.0)), "every primitive field takes its own zero");
});
DefProfile :: struct(name : String, nickname : Option(String));
derive(DefProfile, Default);
test("derive Default reaches non-prelude and generic field types", {
  d := (DefProfile <: Default).default();
  assert(d.name.len() == usize(0), "String defaults to empty");
  assert(d.nickname.is_none(), "Option defaults to None");
});
DefEmpty :: struct();
derive(DefEmpty, Eq(DefEmpty), Default);
test("derive Default for empty struct", {
  assert((DefEmpty <: Default).default() == DefEmpty(), "a fieldless struct still gets a default");
});
DefInner :: struct(a : i32, b : usize);
derive(DefInner, Eq(DefInner), Default);
DefOuter :: struct(inner : DefInner, count : usize);
derive(DefOuter, Eq(DefOuter), Default);
test("derive Default nests through a derived field type", {
  d := (DefOuter <: Default).default();
  assert(d == DefOuter(DefInner(i32(0), usize(0)), usize(0)), "the inner default comes from ITS own derive");
});
DefGenericBox :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(value : T)
);
derive(generic(T), DefGenericBox(T), where(T <: Default), Default);
test("derive Default for a generic struct with generic/where", {
  b := (DefGenericBox(i32) <: Default).default();
  assert(b.value == i32(0), "the field default resolves per instantiation");
  c := (DefGenericBox(bool) <: Default).default();
  assert(c.value == false, "a second instantiation resolves independently");
});
test("a derived Default feeds unwrap_or_default", {
  (miss : Option(DefConfig)) = .None;
  assert(miss.unwrap_or_default() == DefConfig(i32(0), false, f64(0.0)), "None unwraps to the derived default");
});
// ============================================================
// derive(Clone) on a GENERIC struct
// ============================================================
// Used to fail outright: the struct branch built its constructor call from
// `Type.to_comptime_string(T)`, a DISPLAY renderer that yields an unusable
// `<struct:struct_yo_id_N>` placeholder for an instantiated generic. It now
// constructs through `Self`.
// issues/fixed/derive-rules-name-types-through-a-display-renderer.md
CloneBox :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(value : T)
);
derive(generic(T), CloneBox(T), where(T <: Clone), Clone);
test("derive Clone for a generic struct", {
  b := CloneBox(i32)(i32(9));
  c := b.clone();
  assert(c.value == i32(9), "generic struct clones through Self");
  s := CloneBox(String)(String.from("hi"));
  t := s.clone();
  assert(t.value == `hi`, "a second instantiation clones independently");
});
// A field whose type is a generic INSTANTIATION — the shape that made
// derive(FromJson) fail, and the whole point of naming field types by index
// rather than by rendering: `ArrayList(i32)` has no written name to render.
DefWithList :: struct(items : ArrayList(i32), name : String, n : i32);
derive(DefWithList, Default);
test("derive Default reaches a generic-instantiated field type", {
  d := (DefWithList <: Default).default();
  assert(d.items.len() == usize(0), "ArrayList field defaults to empty");
  assert(d.name.len() == usize(0), "String field defaults to empty");
  assert(d.n == i32(0), "i32 field defaults to 0");
});
// ============================================================
// derive over a FIXED-SIZE `Array(T, N)` field
// ============================================================
// `Array(T, N)` carried no `Eq` / `Ord` / `Clone` / `Hash` impl, so each of
// these derives generated a body calling an operation the field type did not
// have. The derive rule's definition-time trial swallowed the error, codegen
// rewrote the function to an `abort()` stub, and the binary died with rc=134
// and no diagnostic at all — `yo check` and `yo compile --optimize 2` both
// reported success.
// issues/fixed/derive-eq-clone-ord-over-a-fixed-size-array-field-aborts-at-runtime.md
ArrBox :: struct(cells : Array(i32, 4), tag : i32);
derive(ArrBox, Eq(ArrBox), Ord(ArrBox), Clone, Hash);
test("derive Eq over a fixed-size Array field", {
  a := ArrBox(Array(i32, 4)(1, 2, 3, 4), i32(7));
  b := ArrBox(Array(i32, 4)(1, 2, 3, 4), i32(7));
  last := ArrBox(Array(i32, 4)(1, 2, 3, 9), i32(7));
  first := ArrBox(Array(i32, 4)(9, 2, 3, 4), i32(7));
  assert(a == b, "element-wise equal arrays compare equal");
  assert(a != last, "arrays differing in the LAST element compare unequal");
  assert(a != first, "arrays differing in the FIRST element compare unequal");
  assert(!(a == last), "negated == agrees with !=");
});
test("derive Ord over a fixed-size Array field", {
  a := ArrBox(Array(i32, 4)(1, 2, 3, 4), i32(7));
  b := ArrBox(Array(i32, 4)(1, 2, 3, 5), i32(7));
  c := ArrBox(Array(i32, 4)(2, 0, 0, 0), i32(7));
  assert(a < b, "lexicographic: a difference in the last element decides");
  assert(a < c, "lexicographic: the FIRST difference decides");
  assert(b < c, "(1,2,3,5) < (2,0,0,0)");
  assert(a <= a, "an array is <= itself");
  assert(!(a < a), "an array is not < itself");
  assert(c > a, "the reverse comparison agrees");
  assert(a >= a, "an array is >= itself");
  assert(!(a > a), "an array is not > itself");
});
test("derive Clone over a fixed-size Array field is independent of its source", {
  a := ArrBox(Array(i32, 4)(1, 2, 3, 4), i32(7));
  b := a.clone();
  assert(a == b, "a clone equals its source");
  b.cells(usize(2)) = i32(99);
  assert(b.cells(2) == i32(99), "the clone took the write");
  assert(a.cells(2) == i32(3), "the SOURCE is untouched — the clone is independent");
  assert(a != b, "the mutated clone no longer equals its source");
});
test("derive Hash over a fixed-size Array field agrees with Eq", {
  a := ArrBox(Array(i32, 4)(1, 2, 3, 4), i32(7));
  b := ArrBox(Array(i32, 4)(1, 2, 3, 4), i32(7));
  c := ArrBox(Array(i32, 4)(1, 2, 3, 9), i32(7));
  assert(hash_one(a) == hash_one(b), "equal values hash equal");
  assert(hash_one(a) != hash_one(c), "different values hash differently");
});
// An Array of a STRUCT type — the element's own derived impls are what the
// array impls recurse into.
ArrOfPoint :: struct(pts : Array(Point, 2));
derive(ArrOfPoint, Eq(ArrOfPoint), Ord(ArrOfPoint), Clone, Hash);
test("derive over an Array of a struct type", {
  a := ArrOfPoint(Array(Point, 2)(Point(i32(1), i32(2)), Point(i32(3), i32(4))));
  b := ArrOfPoint(Array(Point, 2)(Point(i32(1), i32(2)), Point(i32(3), i32(4))));
  c := ArrOfPoint(Array(Point, 2)(Point(i32(1), i32(2)), Point(i32(3), i32(5))));
  assert(a == b, "element structs compare through their own derived Eq");
  assert(a != c, "a difference inside the SECOND element is seen");
  assert(a < c, "lexicographic order runs through the element's Ord");
  assert(hash_one(a) == hash_one(b), "equal arrays-of-structs hash equal");
  d := a.clone();
  assert(d == a, "an array of structs clones");
  d.pts(usize(0)).x = i32(42);
  assert(a.pts(0).x == i32(1), "the source array of structs is untouched");
});
// An Array nested inside ANOTHER aggregate — a struct field holding an
// `Array(Array(i32, 2), 2)`, so the element type is itself an array and the
// impls must recurse into their own specialization.
Nested :: struct(grid : Array(Array(i32, 2), 2), name : i32);
derive(Nested, Eq(Nested), Ord(Nested), Clone, Hash);
test("derive over an Array nested inside another aggregate", {
  a := Nested(
    Array(Array(i32, 2), 2)(Array(i32, 2)(1, 2), Array(i32, 2)(3, 4)),
    i32(0)
  );
  b := Nested(
    Array(Array(i32, 2), 2)(Array(i32, 2)(1, 2), Array(i32, 2)(3, 4)),
    i32(0)
  );
  c := Nested(
    Array(Array(i32, 2), 2)(Array(i32, 2)(1, 2), Array(i32, 2)(3, 5)),
    i32(0)
  );
  assert(a == b, "nested arrays compare element-wise all the way down");
  assert(a != c, "a difference in the INNER array is seen");
  assert(a < c, "nested lexicographic order");
  assert(hash_one(a) == hash_one(b), "nested arrays hash equal");
  d := a.clone();
  assert(d == a, "a nested array clones");
  d.grid(usize(1))(usize(1)) = i32(99);
  assert(a.grid(1)(1) == i32(4), "the source's inner array is untouched");
  assert(a != d, "the mutated nested clone differs");
});
// The N == 1 and N == 0 edge cases. A zero-length array is legal
// (`Array(i32, 0)` — tests/array.test.yo), and every impl must degenerate
// correctly: all empty arrays are equal, none is less than another.
OneCell :: struct(cells : Array(i32, 1));
derive(OneCell, Eq(OneCell), Ord(OneCell), Clone, Hash);
NoCell :: struct(cells : Array(i32, 0), tag : i32);
derive(NoCell, Eq(NoCell), Ord(NoCell), Clone, Hash);
test("derive over an Array of length 1", {
  a := OneCell(Array(i32, 1)(5));
  b := OneCell(Array(i32, 1)(5));
  c := OneCell(Array(i32, 1)(6));
  assert(a == b, "single-element arrays compare");
  assert(a != c, "a different single element is seen");
  assert(a < c, "single-element order");
  assert(hash_one(a) == hash_one(b), "single-element arrays hash equal");
  d := a.clone();
  d.cells(usize(0)) = i32(7);
  assert(a.cells(0) == i32(5), "the source's one cell is untouched");
});
test("derive over an Array of length 0", {
  a := NoCell(Array(i32, 0)(), i32(1));
  b := NoCell(Array(i32, 0)(), i32(1));
  c := NoCell(Array(i32, 0)(), i32(2));
  assert(a == b, "empty arrays are equal, so the structs compare on `tag`");
  assert(a != c, "the sibling field still decides");
  assert(a < c, "an empty array contributes nothing to the order");
  assert(!(a < b), "two all-equal values are not ordered");
  assert(a <= b, "two all-equal values are <=");
  assert(hash_one(a) == hash_one(b), "empty arrays hash equal");
  d := a.clone();
  assert(d == a, "an empty array clones");
});
// An Array whose element OWNS heap memory: the clone must be deep, not a
// refcount-shared alias. Mutating the clone's string must leave the source's
// alone.
StrCells :: struct(cells : Array(String, 2));
derive(StrCells, Eq(StrCells), Clone);
test("derive Clone over an Array of owning elements deep-copies", {
  a := StrCells(Array(String, 2)(String.from("ab"), String.from("cd")));
  b := a.clone();
  assert(a == b, "the clone starts equal");
  b.cells(usize(0)).push_str("XY");
  assert(b.cells(0) == `abXY`, "the clone took the append");
  assert(a.cells(0) == `ab`, "the SOURCE string is untouched — the clone is deep");
  assert(a != b, "the mutated clone differs");
});
// An ENUM payload that is a fixed-size array — the exact shape of the filed
// reproducer (`std/net`'s `IpAddr.V6(Array(u16, 8))`).
IpLike :: enum(V4(a : u8), V6(segments : Array(u16, 8)));
derive(IpLike, Eq(IpLike), Ord(IpLike), Clone, Hash);
test("derive over an enum variant carrying a fixed-size Array", {
  s := Array(u16, 8)(u16(0), u16(0), u16(0), u16(0), u16(0), u16(0), u16(0), u16(1));
  t := Array(u16, 8)(u16(0), u16(0), u16(0), u16(0), u16(0), u16(0), u16(0), u16(2));
  x := IpLike.V6(s);
  y := IpLike.V6(s);
  z := IpLike.V6(t);
  assert(x == y, "the same segments compare equal");
  assert(x != z, "different segments compare unequal");
  assert(x < z, "segments order lexicographically");
  assert(hash_one(x) == hash_one(y), "equal segments hash equal");
  assert(IpLike.V4(u8(1)) != x, "a different variant is never equal");
  c := x.clone();
  assert(c == x, "the enum payload array clones");
});
// ============================================================
// A derive whose generated `impl(...)` cannot be REGISTERED must be an error
// AT THE DERIVE, not a module-level death
// ============================================================
// Both of these used to leave `yo check` saying "evaluator OK" and then report
// `Variable "X" not found` at X's NEXT use, because the whole module's
// evaluation died at the `derive`. The generated impl is now evaluated through
// the derive's own exception, so the real diagnostic lands on the
// `derive(...)` statement.
// issues/fixed/derive-ord-without-a-prior-derive-eq-kills-module-evaluation.md
// issues/fixed/bare-derive-form-kills-module-eval.md
OrdNoEqStruct :: struct(a : u8);
comptime_expect_error({
  // `Ord` carries `where(Self <: Eq(Rhs))`; there is no `Eq` impl for this type.
  derive(OrdNoEqStruct, Ord(OrdNoEqStruct));
});
OrdNoEqEnum :: enum(A(x : u8), B);
comptime_expect_error({
  derive(OrdNoEqEnum, Ord(OrdNoEqEnum));
});
BareTraitArg :: struct(a : u8);
comptime_expect_error({
  // The BARE form splices `Eq()` — a trait application with no arguments.
  derive(BareTraitArg, Eq);
});
// Over-rejection canaries: every CURED spelling must still work.
OrdWithEq :: struct(a : u8);
derive(OrdWithEq, Eq(OrdWithEq));
derive(OrdWithEq, Ord(OrdWithEq));
OrdCombined :: struct(a : u8);
derive(OrdCombined, Eq(OrdCombined), Ord(OrdCombined));
test("a derive whose impl cannot register is rejected, and the cured forms still work", {
  x := OrdWithEq(u8(1));
  y := OrdWithEq(u8(2));
  assert(x < y, "Eq-then-Ord still orders");
  assert(x != y, "and still compares");
  assert(!(y < x), "and the reverse is false");
  p := OrdCombined(u8(3));
  q := OrdCombined(u8(4));
  assert(p < q, "the combined derive(S, Eq(S), Ord(S)) form still orders");
  assert(p == OrdCombined(u8(3)), "and still compares");
});
// ============================================================
// derive on a NON-aggregate is rejected by the `derive` builtin itself
// ============================================================
// Pins the guard ("derive only works on struct and enum types"): the rules'
// own `true =>` fallback arms — which would compile an impl that compares,
// hashes or clones nothing — are unreachable through `derive`, and this is
// what keeps them so. (plans/STD_API_STABILIZATION.md §3 item 11 had read those
// arms as a live defect; they are dead code behind this guard.)
DeriveTupleT :: Tuple(i32, i32);
comptime_expect_error({
  derive(DeriveTupleT, Eq(DeriveTupleT));
});
comptime_expect_error({
  derive(DeriveTupleT, Clone);
});
DeriveUnionT :: union(a : i32, b : bool);
comptime_expect_error({
  derive(DeriveUnionT, Hash);
});
comptime_expect_error({
  derive(DeriveUnionT, ToString);
});
DeriveArrayT :: Array(i32, usize(2));
comptime_expect_error({
  derive(DeriveArrayT, Eq(DeriveArrayT));
});
// Over-rejection canaries: a field-less struct and an all-unit-variant enum
// are the smallest aggregates the guard admits, and every rule must take them.
DeriveEmptyS :: struct();
derive(DeriveEmptyS, Eq(DeriveEmptyS), Clone, Hash, ToString);
DeriveUnitE :: enum(A, B);
derive(DeriveUnitE, Eq(DeriveUnitE), Clone, Hash, ToString);
test("derive on a tuple, union or array is a comptime error; the smallest aggregates still derive", {
  assert(DeriveEmptyS() == DeriveEmptyS(), "unit struct Eq");
  assert(DeriveUnitE.A == DeriveUnitE.A, "unit enum Eq");
  assert(DeriveUnitE.A != DeriveUnitE.B, "unit enum Ne");
  assert(DeriveUnitE.B.clone() == DeriveUnitE.B, "unit enum Clone");
  assert(hash_one(DeriveUnitE.A) != hash_one(DeriveUnitE.B), "unit enum Hash separates variants");
  assert(DeriveUnitE.B.to_string() == `DeriveUnitE.B`, "unit enum ToString");
});
