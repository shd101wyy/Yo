{ assert } :: import("std/assert");
// Baseline tests for the Module/Struct unification (plans/archive/UNIFY_MODULE_AND_STRUCT.md).
//
// These tests pin the surface behavior at the Module/Struct boundary that
// must keep working across every phase of the unification:
//
//   1. The `struct(...)` type expression builds an effect record type
//      that `given`/`using` can match nominally.
//   2. A `given`/`using` exchange with a single-op `struct(...)` effect
//      type round-trips successfully (resume path).
//
// Phase 4 migrated these fixtures to `struct(...)` so effect records use the
// same nominal representation as runtime structs.
//
// Imports as comptime structs are exercised implicitly by every other
// .test.yo file via top-level `import` — no dedicated case needed here.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
test("Phase 4c: migrated struct effect record unwind", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  divide :: (fn(x : i32, y : i32, r : Raise) -> i32)(
    cond(
      (y == 0) => r.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  (r : Raise) = Raise(
    raise :
      (
        (msg) -> {
          println(msg);
          unwind(());
        }
      )
  );
  divide(10, 0, r);
  assert(false, "should not reach here after unwind");
});
test("Phase 4c: migrated struct effect record resume", {
  Logger :: struct(
    log : (fn(msg : String) -> unit)
  );
  shout :: (fn(msg : String, l : Logger) -> unit)(
    l.log(msg)
  );
  (l : Logger) = Logger(
    log :
      (
        (msg) -> {
          println(msg);
          return(());
        }
      )
  );
  shout("hello-effect".to_string(), l);
  // If we reach here, the continuation resumed correctly.
  assert(true, "logger resumed");
});
test("Baseline: struct(...) builds a usable effect record type", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  divide :: (fn(x : i32, y : i32, r : Raise) -> i32)(
    cond(
      (y == 0) => r.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  (r : Raise) = Raise(
    raise :
      (
        (msg) -> {
          println(msg);
          unwind(());
        }
      )
  );
  divide(10, 0, r);
  assert(false, "should not reach here after unwind");
});
test("Baseline: given/using round-trip with resume (struct)", {
  Logger :: struct(
    log : (fn(msg : String) -> unit)
  );
  shout :: (fn(msg : String, l : Logger) -> unit)(
    l.log(msg)
  );
  count := 0;
  (l : Logger) = Logger(
    log :
      (
        (msg) -> {
          println(msg);
          return(());
        }
      )
  );
  shout("hello-effect".to_string(), l);
  // If we reach here, the continuation resumed correctly.
  assert(true, "logger resumed");
});
// ----------------------------------------------------------------------
// Phase 4 progress tests: runtime-built `given` evidence with structs.
//
// These pin behavior that ALREADY works in the current evaluator/codegen
// because the given value is fully comptime-resolved per call site
// (specialized away). Phase 4 will extend this to genuinely runtime
// evidence (e.g. struct value computed by a non-comptime function call),
// which currently fails with "given variable has no compile-time value".
// ----------------------------------------------------------------------
test("Phase 4a: given(struct) inside a runtime branch", {
  Tag :: struct(
    name : (fn() -> str)
  );
  speak :: (fn(t : Tag) -> str)(
    t.name()
  );
  flag := true;
  if(flag, {
    (t : Tag) = Tag(name : (() -> "alpha"));
    assert(speak(t) == "alpha", "branch-true picked alpha");
  }, {
    (t : Tag) = Tag(name : (() -> "beta"));
    assert(speak(t) == "beta", "branch-false picked beta");
  });
});
test("Phase 4a: given(struct) inside a while-loop, evaluated each iter", {
  Counter :: struct(
    next : (fn() -> i32)
  );
  step :: (fn(c : Counter) -> i32)(
    c.next()
  );
  i := Box(i32)(0);
  sum := Box(i32)(0);
  while(runtime(i.* < 3), {
    (c : Counter) = Counter(next : (() -> i32(7)));
    sum.* = (sum.* + step(c));
    i.* = (i.* + 1);
  });
  assert(sum.* == 21, "3 iterations × 7 = 21");
});
test("Phase 4b: given(struct) bound to runtime function-returned value", {
  Counter :: struct(
    next : (fn() -> i32)
  );
  make_counter :: (fn(use_a : bool) -> Counter)(
    cond(
      use_a => Counter(next : (() -> i32(1))),
      true => Counter(next : (() -> i32(2)))
    )
  );
  step :: (fn(c : Counter) -> i32)(
    c.next()
  );
  flag := true;
  if(flag, {
    (c : Counter) = make_counter(true);
    assert(step(c) == 1, "use_a=true -> 1");
  }, {
    (c : Counter) = make_counter(false);
    assert(step(c) == 2, "use_a=false -> 2");
  });
  flag2 := false;
  if(flag2, {
    (c : Counter) = make_counter(true);
    assert(step(c) == 1, "unreachable");
  }, {
    (c : Counter) = make_counter(false);
    assert(step(c) == 2, "use_a=false -> 2");
  });
});
test("Phase 1: comptime-only struct fields are erased from C layout", {
  ConfiguredCounter :: struct(
    tag :: "configured-counter",
    next : (fn() -> i32)
  );
  comptime_assert(Type.impls(ConfiguredCounter, Runtime), "mixed struct is runtime");
  make_counter :: (fn() -> ConfiguredCounter)(
    ConfiguredCounter(next : (() -> i32(42)))
  );
  counter := make_counter();
  assert(counter.next() == 42, "runtime field remains callable");
});
test("Phase 6: module and Module keywords are removed", {
  comptime_expect_error(module(x : i32));
  comptime_expect_error(Module);
});
// Verify that open works correctly with struct-typed values
// after the Module→Struct unification.
test("open on struct-typed values", {
  MyStruct :: struct(
    x : i32,
    y : i32
  );
  s := MyStruct(x : i32(10), y : i32(20));
  open(s);
  assert(x == i32(10), "x should be 10");
  assert(y == i32(20), "y should be 20");
});
