test("Test multiple effect row spreads with resume", {
  Raise :: (ctl(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);
  might_fail :: (fn(raise : Raise) -> i32)(
    raise(`oops`)
  );
  might_log :: (fn(log : Log) -> unit)(
    log(`logged something`)
  );
  run_both :: (
    fn(
      forall(T1 : Type, T2 : Type, E1 : Type.Struct, E2 : Type.Struct),
      f1 : (fn(e1 : E1) -> T1),
      f2 : (fn(e2 : E2) -> T2),
      e1 : E1,
      e2 : E2
    ) -> T1
  )({
    f2(e2);
    f1(e1)
  });
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      return(i32(42));
    }
  );
  (log : Log) = (
    (msg) -> {
      println(msg);
      return(());
    }
  );
  result := run_both(might_fail, might_log, raise, log);
  assert(result == i32(42), "multiple spreads resume: should be 42");
});
test("Test multiple effect row spreads with unwind", {
  Raise :: (ctl(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);
  might_fail :: (fn(raise : Raise) -> i32)(
    raise(`oops`)
  );
  might_log :: (fn(log : Log) -> unit)(
    log(`logged something`)
  );
  run_both :: (
    fn(
      forall(T1 : Type, T2 : Type, E1 : Type.Struct, E2 : Type.Struct),
      f1 : (fn(e1 : E1) -> T1),
      f2 : (fn(e2 : E2) -> T2),
      e1 : E1,
      e2 : E2
    ) -> T1
  )({
    f2(e2);
    f1(e1)
  });
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      unwind(());
    }
  );
  (log : Log) = (
    (msg) -> {
      println(msg);
      return(());
    }
  );
  run_both(might_fail, might_log, raise, log);
  assert(false, "multiple spreads unwind: should not reach here");
});
test("Test closure with using() effect - resume", {
  Log :: (fn(msg : String) -> unit);
  x := Box(i32)(0);
  (log : Log) = (
    (msg) -> {
      println(msg);
      return(());
    }
  );
  (closure : Impl(Fn(v : i32, msg : String) -> i32)) =
    (v, msg) => {
      log(msg);
      x.* = (x.* + v);
      return(x.*);
    };
  result1 := closure(1, `hello`);
  assert(result1 == 1, "closure+effect resume: expected result1 to be 1");
  assert(x.* == 1, "closure+effect resume: expected x to be 1");
  result2 := closure(2, `world`);
  assert(result2 == 3, "closure+effect resume: expected result2 to be 3");
  assert(x.* == 3, "closure+effect resume: expected x to be 3");
});
test("Test closure with using() effect - unwind", {
  // Closures cannot capture ctl-typed values (they could outlive the install
  // frame). Pass the effect handler explicitly as a parameter instead.
  Log :: (ctl(msg : String) -> unit);
  run_test :: (fn() -> i32)({
    x := Box(i32)(0);
    (log : Log) = (
      (msg) -> {
        println(msg);
        unwind(i32(99));
      }
    );
    apply :: (fn(v : i32, msg : String, b : Box(i32), lg : Log) -> i32)({
      lg(msg);
      b.* = (b.* + v);
      return(b.*);
    });
    result := apply(1, `hello`, x, log);
    assert(false, "closure+effect unwind: should not reach here");
    return(result);
  });
  val := run_test();
  assert(val == 99, "closure+effect unwind: expected unwind value 99");
});
test("Effect row polymorphism with E : Type.Struct spread", {
  Yield :: (fn(v : i32) -> i32);
  Log :: (fn(v : i32) -> unit);
  traverse :: (
    fn(
      forall(S : usize, E : Type.Struct),
      arr : Array(i32, S),
      callback : Impl(Fn(v : i32, e : E) -> unit),
      e : E
    ) -> unit
  )({
    i := usize(0);
    while(i < S, i = (i + 1), {
      callback(arr(i), e);
    });
  });
  (yield : Yield) =
    (v) -> {
      return(v);
    };
  (log : Log) =
    (v) -> {
      println(v);
    };
  sum := Box(i32)(0);
  arr := Array(i32, 5)(0, 1, 2, 3, 4);
  Eff :: struct(yield : Yield, log : Log);
  traverse(arr, (v : i32, e : Eff) => {
    e.log(v);
    result := e.yield(v);
    assert(result == v, "effect row: yield should return the value");
    sum.* = (sum.* + result);
  }, Eff(yield, log));
  assert(sum.* == 10, "effect row: sum should be 10");
});
test("Effect row inline typed declaration name : Type", {
  Yield :: (fn(v : i32) -> i32);
  Log :: (fn(v : i32) -> unit);
  traverse :: (
    fn(
      forall(S : usize, E : Type.Struct),
      arr : Array(i32, S),
      callback : Impl(Fn(v : i32, e : E) -> unit),
