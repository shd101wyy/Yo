});
test("Mixed unwind and return in effect handler", {
  Yield :: (ctl(v : i32) -> i32);
  Log :: (fn(v : i32) -> unit);
  traverse :: (
    fn(
      forall(S : usize, E : Type.Struct),
      arr : Array(i32, S),
      callback : Impl(Fn(v : i32, e : E) -> unit),
      e : E
    ) -> unit
  )({
    i := usize(0);
    while(i < S, i = (i + 1), {
      callback(arr(i), e);
    });
  });
  (yield : Yield) =
    (v) ->
      cond(
        (v > 2) => {
          unwind(());
        },
        true => {
          return(v);
        }
      );
  (log : Log) =
    (v) -> {
      println(v);
    };
  sum := Box(i32)(0);
  arr := Array(i32, 5)(0, 1, 2, 3, 4);
  Eff :: struct(yield : Yield, log : Log);
  traverse(arr, (v : i32, e : Eff) => {
    e.log(v);
    result := e.yield(v);
    assert(result == v, "mixed handler: yield should return the value");
    sum.* = (sum.* + result);

  }, Eff(yield, log));
  assert(false, "This line should not be reached due to unwind in yield");
});
test("Transitive SM while loop with break", {
  Yield :: (fn(v : i32) -> i32);
  // A transitive effectful function — its forall(E : Type.Struct) means it always gets an SM.
  // The while loop + break is inside the SM-generated function itself.
  count_until :: (
    fn(
      forall(E : Type.Struct),
      limit : i32,
      e : E
    ) -> i32
  )({
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    while(runtime(true), {
      result := e.yield(counter.*);
      sum.* = (sum.* + result);
      counter.* = (counter.* + 1);
      cond(
        (counter.* >= limit) => {
          break;
        },
        true => ()
      );
    });
    return(sum.*);
  });
  (yield : Yield) =
    (v) -> {
      return(v * i32(2));
    };
  result := count_until(i32(4), { yield });
  // e.yield(0)*2=0, e.yield(1)*2=2, e.yield(2)*2=4, e.yield(3)*2=6 => sum = 12
  assert(result == i32(12), "transitive break: sum should be 0+2+4+6 = 12");
});
test("Transitive SM while loop with continue", {
  Yield :: (fn(v : i32) -> i32);
  // Skip odd results, accumulate even results, stop at counter == 8.
  sum_even :: (
    fn(
      forall(E : Type.Struct),
      e : E
    ) -> i32
  )({
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    while(runtime(counter.* < i32(8)), {
      result := e.yield(counter.*);
      counter.* = (counter.* + 1);
      cond(
        ((result % i32(2)) != i32(0)) => {
          continue;
        },
        true => ()
      );
      sum.* = (sum.* + result);
    });
    return(sum.*);
  });
  (yield : Yield) =
    (v) -> {
      return(v);
    };
  result := sum_even({ yield });
  // e.yield(0)=0, e.yield(1)=1(skip), e.yield(2)=2, e.yield(3)=3(skip),
  // e.yield(4)=4, e.yield(5)=5(skip), e.yield(6)=6, e.yield(7)=7(skip) => 0+2+4+6 = 12
  assert(result == i32(12), "transitive continue: sum of even should be 12");
});
test("Transitive SM while loop with mixed continue and break", {
  Yield :: (fn(v : i32) -> i32);
  // continue on counter <= 2, break on counter >= 5, accumulate the rest
  mixed_loop :: (
    fn(
      forall(E : Type.Struct),
      e : E
    ) -> i32
  )({
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    while(runtime(true), {
      counter.* = (counter.* + 1);
      e.yield(counter.*);
      cond(
        (counter.* <= i32(2)) => {
          continue;
        },
        true => ()
      );
      cond(
        (counter.* >= i32(5)) => {
          break;
        },
        true => ()
      );
      sum.* = (sum.* + counter.*);
    });
    return(sum.*);
  });
  (yield : Yield) =
    (v) -> {
      return(v);
    };
  result := mixed_loop({ yield });
  // counter 1: continue, 2: continue, 3: sum+=3, 4: sum+=4, 5: break
  assert(result == i32(7), "transitive mixed: sum should be 3+4 = 7");
});
test("Transitive SM while loop with step expr and continue", {
  Yield :: (fn(v : i32) -> i32);
  sum_with_step :: (
    fn(
      forall(E : Type.Struct),
      e : E
    ) -> i32
  )({
    i := Box(i32)(0);
    sum := Box(i32)(0);
    while(runtime(i.* < i32(6)), i.* = (i.* + 1), {
      result := e.yield(i.*);
      cond(
        ((result % i32(2)) != i32(0)) => {
          continue;
        },
        true => ()
      );
      sum.* = (sum.* + result);
    });
    return(sum.*);
  });
  (yield : Yield) =
    (v) -> {
      return(v);
    };
  result := sum_with_step({ yield });
  // e.yield(0)=0, e.yield(1)=1(skip), e.yield(2)=2, e.yield(3)=3(skip), e.yield(4)=4, e.yield(5)=5(skip) => 0+2+4 = 6
  assert(result == i32(6), "transitive step+continue: sum of even should be 6");
});
test("Transitive SM while loop with early return", {
  Yield :: (fn(v : i32) -> i32);
  find_first :: (
    fn(
      forall(E : Type.Struct),
      threshold : i32,
      e : E
    ) -> i32
  )({
    i := Box(i32)(0);
    while(runtime(i.* < i32(10)), i.* = (i.* + 1), {
      result := e.yield(i.*);
      cond(
        (result >= threshold) => {
          return(result);
        },
        true => ()
      );
    });
    return(i32(-(1)));
  });
  (yield : Yield) =
    (v) -> {
      return(v * i32(3));
    };
  result := find_first(i32(12), { yield });
  // yield(0)=0, yield(1)=3, yield(2)=6, yield(3)=9, yield(4)=12 >= 12 => return 12
  assert(result == i32(12), "transitive early return: should find 12");
});
test("Struct-record effect with forall handler — unwind in while loop", {
  // Tests the pattern from fixme.yo: struct-record effect with forall(ResumeType),
  // handler uses unwind inside a while loop to abort traversal.
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (ctl(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );
  safe_divide :: (fn(x : i32, y : i32, exn : MyException(i32)) -> i32)(
    cond(
      (y == 0) => exn.throw(x, i32(666)),
      true => (x / y)
    )
  );
  traverse :: (
    fn(
      forall(S : usize, E : Type.Struct),
      arr : Array(i32, S),
      exn : MyException(i32),
      e : E
    ) -> unit
  )({
    i := usize(0);
    while(i < S, i = (i + 1), {
      safe_divide(i32(42), arr(i), exn);
    });
  });
  arr := Array(i32, 4)(1, 2, 0, 3);
  exn := MyException(i32)(
    throw : (
      (val, resume_val) -> {
        unwind(());
      }
    )
  );
  traverse(arr, exn, {});
  assert(false, "Should not reach here after unwind");
});
test("Struct-record effect with forall handler — resume in while loop", {
  // Struct-record effect with forall(ResumeType), handler resumes with a value.
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (ctl(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );
  safe_divide :: (fn(x : i32, y : i32, exn : MyException(i32)) -> i32)(
    cond(
      (y == 0) => exn.throw(x, i32(0)),
      true => (x / y)
    )
  );
  run_test :: (fn() -> unit)({
    sum := Box(i32)(0);
    counter := Box(i32)(0);
    exn := MyException(i32)(
      throw : (
        (val, resume_val) -> {
          // resume_val should be i32(0), resume with it
          return(resume_val);
        }
      )
    );
    while(runtime(counter.* < i32(5)), {
      // arr = [2, 0, 3, 0, 1] pattern inlined
      divisor := cond(
        ((counter.* == i32(1)) || (counter.* == i32(3))) => i32(0),
        true => (counter.* + i32(1))
      );
      result := safe_divide(i32(10), divisor, exn);
      sum.* = (sum.* + result);
      counter.* = (counter.* + 1);
    });
    assert(counter.* == i32(5), "counter should reach 5");
    // 10/1=10, 10/0→resume(0)=0, 10/3=3, 10/0→resume(0)=0, 10/5=2 => sum = 15
    assert(sum.* == i32(15), "sum should be 15");
  });
  run_test();
});
test("Struct-record effect with forall handler — break after resume in while loop", {
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (ctl(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );
  safe_op :: (fn(x : i32, exn : MyException(i32)) -> i32)(
    cond(
      (x < 0) => exn.throw(x, i32(0)),
      true => x
    )
  );
  run_test :: (fn() -> unit)({
    counter := Box(i32)(0);
    exn := MyException(i32)(
      throw : (
        (val, resume_val) -> {
          return(resume_val);
        }
      )
    );
    while(runtime(true), {
      result := safe_op(counter.* - i32(2), exn);
      counter.* = (counter.* + 1);
      cond(
        (counter.* >= i32(5)) => {
          break;
        },
        true => ()
      );
    });
    assert(counter.* == i32(5), "break after struct-record resume: counter should be 5");
  });
  run_test();
});
test("Struct-record effect with forall handler — continue after resume in while loop", {
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (ctl(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );
  safe_op :: (fn(x : i32, exn : MyException(i32)) -> i32)(
    cond(
      (x < 0) => exn.throw(x, i32(0)),
      true => x
    )
  );
  run_test :: (fn() -> unit)({
    sum := Box(i32)(0);
    counter := Box(i32)(0);
    exn := MyException(i32)(
      throw : (
        (val, resume_val) -> {
          return(resume_val);
        }
      )
    );
    while(runtime(counter.* < i32(6)), {
      i := counter.*;
      counter.* = (counter.* + 1);
      result := safe_op(i - i32(2), exn);
      // result: negative inputs → 0 (resumed), non-negative → identity
      // i=0→-2→0, i=1→-1→0, i=2→0, i=3→1, i=4→2, i=5→3
      cond(
        (result == i32(0)) => {
          continue;
        },
        true => ()
      );
      sum.* = (sum.* + result);
    });
    assert(counter.* == i32(6), "continue after struct-record resume: counter should be 6");
    // sum = 1 + 2 + 3 = 6
    assert(sum.* == i32(6), "continue after struct-record resume: sum should be 6");
  });
  run_test();
});
test("Struct-record effect with forall handler — early return after resume in while loop", {
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (ctl(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );
  safe_op :: (fn(x : i32, exn : MyException(i32)) -> i32)(
    cond(
      (x < 0) => exn.throw(x, i32(0)),
      true => x
    )
  );
  find_first_positive :: (fn() -> i32)({
    counter := Box(i32)(0);
    exn := MyException(i32)(
      throw : (
        (val, resume_val) -> {
          return(resume_val);
        }
      )
    );
    while(runtime(counter.* < i32(10)), {
      result := safe_op(counter.* - i32(3), exn);
      counter.* = (counter.* + 1);
      cond(
        (result > i32(0)) => {
          return(result);
        },
        true => ()
      );
    });
    return(i32(-(1)));
  });
  result := find_first_positive();
  // counter: 0→-3→0, 1→-2→0, 2→-1→0, 3→0, 4→1>0 → return 1
  assert(result == i32(1), "early return after struct-record resume: should find 1");
});
// ---------------------------------------------------------------------------
// Break in tagged union (Option) match arm after fn resume
// Analogous to async_await test: break in Option match in async while loop.
// Tests that goto-based break in match bodyCode is emitted directly.
// ---------------------------------------------------------------------------
test("Test break in Option match arm after fn resume", {
  GetValue :: (fn() -> i32);
  run_test :: (fn() -> unit)({
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    (get_value : GetValue) = (
      () -> {
        return(i32(1));
      }
    );
    while(runtime(true), {
      get_value();
      counter.* = (counter.* + 1);
      opt := cond(
        (counter.* > i32(5)) => Option(i32).None,
        true => Option(i32).Some(counter.*)
      );
      val := match(
        opt,
        .Some(v) => v,
        .None => break
      );
      sum.* = (sum.* + val);
    });
    assert(counter.* == i32(6), "counter should be 6 when None triggers break");
    assert(sum.* == i32(15), "sum should be 1+2+3+4+5 = 15");
  });
  run_test();
});
// ---------------------------------------------------------------------------
// Continue in tagged union (Option) match arm after fn resume
// Analogous to async_await test: continue in Option match in async while loop.
// ---------------------------------------------------------------------------
test("Test continue in Option match arm after fn resume", {
  GetValue :: (fn() -> i32);
  run_test :: (fn() -> unit)({
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    (get_value : GetValue) = (
      () -> {
        return(i32(1));
      }
    );
    while(runtime(counter.* < i32(6)), {
      get_value();
      counter.* = (counter.* + 1);
      // Skip even numbers via Option match
      opt := cond(
        ((counter.* % i32(2)) == i32(0)) => Option(i32).None,
        true => Option(i32).Some(counter.*)
      );
      val := match(
        opt,
        .Some(v) => v,
        .None => continue
      );
      sum.* = (sum.* + val);
    });
    assert(counter.* == i32(6), "counter should reach 6");
    assert(sum.* == i32(9), "sum should be 1+3+5 = 9 (even numbers skipped)");
  });
  run_test();
});
// ---------------------------------------------------------------------------
// Mixed break and continue in tagged union (Option) match arms after fn resume
// Analogous to async_await test: mixed break and continue in Option match.
// ---------------------------------------------------------------------------
test("Test mixed break and continue in Option match after fn resume", {
  GetValue :: (fn() -> i32);
  run_test :: (fn() -> unit)({
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    (get_value : GetValue) = (
      () -> {
        return(i32(1));
      }
    );
    while(runtime(true), {
      get_value();
      counter.* = (counter.* + 1);
      // None means break, Some(0) means continue, Some(v) means accumulate
      opt := cond(
        (counter.* > i32(7)) => Option(i32).None,
        ((counter.* % i32(3)) == i32(0)) => Option(i32).Some(i32(0)),
        true => Option(i32).Some(counter.*)
      );
      val := match(
        opt,
        .Some(v) => cond((v == i32(0)) => continue, true => v),
        .None => break
      );
      sum.* = (sum.* + val);
    });
    assert(counter.* == i32(8), "counter should be 8 when None triggers break");
    // Iterations: 1→Some(1)→sum, 2→Some(2)→sum, 3→Some(0)→continue,
    // 4→Some(4)→sum, 5→Some(5)→sum, 6→Some(0)→continue,
    // 7→Some(7)→sum, 8→None→break
    // sum = 1+2+4+5+7 = 19
    assert(sum.* == i32(19), "sum should be 1+2+4+5+7 = 19");
  });
  run_test();
});
// ===========================================================================
// Additional corner-case tests
// ===========================================================================
// ---------------------------------------------------------------------------
// Three-level effect propagation via using parameter
// Tests that evidence pointers are forwarded correctly through 3 call levels.
// ---------------------------------------------------------------------------
test("Test three-level effect propagation via using parameter", {
  Raise :: (ctl(msg : String) -> i32);
  level3 :: (fn(x : i32, raise : Raise) -> i32)(
    cond(
      (x < 0) => raise(`negative`),
      true => (x * i32(2))
    )
  );
  level2 :: (fn(x : i32, raise : Raise) -> i32)(
    level3(x, raise) + i32(1)
  );
  level1 :: (fn(x : i32, raise : Raise) -> i32)(
    level2(x, raise) + i32(10)
  );
  (raise : Raise) = (
    (msg) -> {
      return(i32(0));
    }
  );
  result1 := level1(i32(5), raise);
  assert(result1 == i32(21), "3-level propagation: 5*2+1+10 = 21");
  result2 := level1(i32(-(1)), raise);
  assert(result2 == i32(11), "3-level propagation with raise: 0+1+10 = 11");
});
// ---------------------------------------------------------------------------
// Three-level effect propagation with unwind
// Escape at the deepest level should propagate all the way out.
// ---------------------------------------------------------------------------
test("Test three-level effect propagation with unwind", {
  Raise :: (ctl(msg : String) -> i32);
  level3 :: (fn(x : i32, raise : Raise) -> i32)(
    cond(
      (x < 0) => raise(`negative`),
      true => (x * i32(2))
    )
  );
  level2 :: (fn(x : i32, raise : Raise) -> i32)(
    level3(x, raise) + i32(1)
  );
  level1 :: (fn(x : i32, raise : Raise) -> i32)(
    level2(x, raise) + i32(10)
  );
  run_test :: (fn() -> i32)({
    (raise : Raise) = (
      (msg) -> {
        unwind(i32(99));
      }
    );
    level1(i32(-(1)), raise)
  });
  result := run_test();
  assert(result == i32(99), "3-level unwind: should get 99");
});
// ---------------------------------------------------------------------------
// Struct-record effect with unwind returning non-unit value
// ---------------------------------------------------------------------------
test("Test struct-record effect unwind with non-unit value", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  safe_divide :: (fn(x : i32, y : i32, raise_mod : Raise) -> i32)(
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  run_test :: (fn() -> i32)({
    (raise_mod : Raise) = Raise(
      raise :
        (msg) -> {
          unwind(i32(-(1)));
        }
    );
    safe_divide(10, 0, raise_mod)
  });
  result := run_test();
  assert(result == i32(-(1)), "struct-record unwind non-unit: should get -1");
});
// ---------------------------------------------------------------------------
// Struct-record effect with multiple functions
// Tests that a struct record with more than one function field works correctly.
// ---------------------------------------------------------------------------
test("Test struct-record effect with multiple function members", {
  Logger :: struct(
    info : (fn(msg : String) -> i32),
    warn : (fn(msg : String) -> i32),
    count : (fn(current : i32) -> i32)
  );
  log_messages :: (fn(logger : Logger) -> i32)({
    logger.info(`first info`);
    logger.warn(`first warn`);
    logger.info(`second info`);
    logger.count(i32(3))
  });
  (logger : Logger) = Logger(
    info :
      (msg) -> {
        println(msg);
        return(i32(1));
      },
    warn :
      (msg) -> {
        println(msg);
        return(i32(1));
      },
    count :
      (current) -> {
        return(current);
      }
  );
  result := log_messages(logger);
  assert(result == 3, "multi-member struct record: count(3) should return 3");
});
// ---------------------------------------------------------------------------
// Multiple struct-record effects in the same scope
// Two distinct struct-record effect types used together.
// ---------------------------------------------------------------------------
test("Test multiple struct-record effects in same scope", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  Log :: struct(
    log : (fn(msg : String) -> i32)
  );
  compute :: (fn(x : i32, y : i32, raise_mod : Raise, log_mod : Log) -> i32)({
    log_mod.log(`computing`);
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  });
  (raise_mod : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        return(i32(0));
      }
  );
  (log_mod : Log) = Log(
    log :
      (msg) -> {
        println(msg);
        return(i32(1));
      }
  );
  result := compute(10, 2, raise_mod, log_mod);
  assert(result == 5, "multi-struct-record: 10/2 = 5");
  result2 := compute(10, 0, raise_mod, log_mod);
  assert(result2 == 0, "multi-struct-record: raise returns 0");
});
// ---------------------------------------------------------------------------
// Effect handler that conditionally resumes or escapes based on argument
// Handler decides at runtime whether to resume or unwind.
// ---------------------------------------------------------------------------
test("Test effect handler conditional resume or unwind based on argument", {
  Raise :: (ctl(msg : String, attempt : i32) -> i32);
  safe_divide :: (fn(x : i32, y : i32, attempt : i32, raise : Raise) -> i32)(
    cond(
      (y == 0) => raise(`div-by-zero`, attempt),
      true => (x / y)
    )
  );
  run_test :: (fn() -> i32)({
    (raise : Raise) = (
      (msg, attempt) -> {
        cond(
          (attempt <= i32(2)) => {
            return(i32(0));
          },
          true => {
            unwind(i32(-(1)));
          }
        );
      }
    );
    sum := Box(i32)(0);
    sum.* = (sum.* + safe_divide(10, 0, i32(1), raise));
    sum.* = (sum.* + safe_divide(20, 0, i32(2), raise));
    sum.* = (sum.* + safe_divide(30, 0, i32(3), raise));
    return(sum.*);
  });
  result := run_test();
  assert(result == i32(-(1)), "conditional resume/unwind: third call escapes with -1");
});
// ---------------------------------------------------------------------------
// Recursive function with effects (recur + using)
// ---------------------------------------------------------------------------
test("Test recursive function with effect via recur", {
  Raise :: (ctl(msg : String) -> i32);
  sum_to :: (fn(n : i32, raise : Raise) -> i32)(
    cond(
      (n <= 0) => raise(`reached zero`),
      true => (n + recur(n - 1, raise))
    )
  );
  (raise : Raise) = (
    (msg) -> {
      return(i32(0));
    }
  );
  result := sum_to(i32(5), raise);
  assert(result == i32(15), "recur+effect: 5+4+3+2+1+0 = 15");
});
// ---------------------------------------------------------------------------
// Recursive function with effect — unwind during recursion
// ---------------------------------------------------------------------------
test("Test recursive function with effect unwind during recursion", {
  Raise :: (ctl(val : i32) -> i32);
  sum_to :: (fn(n : i32, raise : Raise) -> i32)(
    cond(
      (n <= 0) => i32(0),
      true => (raise(n) + recur(n - 1, raise))
    )
  );
  run_test :: (fn() -> i32)({
    (raise : Raise) = (
      (val) -> {
        cond(
          (val == i32(3)) => {
            unwind(i32(42));
          },
          true => {
            return(val);
          }
        );
      }
    );
    sum_to(i32(5), raise)
  });
  result := run_test();
  assert(result == i32(42), "recur+unwind: should unwind with 42 at n=3");
});
// ---------------------------------------------------------------------------
// Effect with enum return type (Option)
// ---------------------------------------------------------------------------
test("Test effect with Option return type", {
  Lookup :: (fn(key : i32) -> Option(i32));
  get_or_default :: (fn(key : i32, default_val : i32, lookup : Lookup) -> i32)(
    match(
      lookup(key),
      .Some(v) => v,
      .None => default_val
    )
  );
  (lookup : Lookup) = (
    (key) -> {
      return(
        cond(
          (key > 0) => Option(i32).Some(key * i32(10)),
          true => Option(i32).None
        )
      );
    }
  );
  result1 := get_or_default(i32(3), i32(-(1)), lookup);
  assert(result1 == i32(30), "option effect: key=3 -> 30");
  result2 := get_or_default(i32(0), i32(-(1)), lookup);
  assert(result2 == i32(-(1)), "option effect: key=0 -> default -1");
  result3 := get_or_default(i32(-(5)), i32(99), lookup);
  assert(result3 == i32(99), "option effect: key=-5 -> default 99");
});
// ---------------------------------------------------------------------------
// Effect-polymorphic function with struct-record effect (not just fn-type effect)
// Combines forall(E : Type.Struct) spread with struct-record effects.
// ---------------------------------------------------------------------------
test("Test effect polymorphism with struct-record effect spread", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  might_fail :: (fn(raise_mod : Raise) -> i32)(
    raise_mod.raise(`oops`)
  );
  run :: (
    fn(
      forall(T : Type, E : Type.Struct),
      f : (fn(e : E) -> T),
      e : E
    ) -> T
  )(f(e));
  (raise_mod : Raise) = Raise(
    raise :
      (msg) -> {
        return(i32(77));
      }
  );
  result := run(might_fail, raise_mod);
  assert(result == i32(77), "struct-record effect polymorphism: should be 77");
});
// ---------------------------------------------------------------------------
// Transitive SM with struct-record effects (combine forall + transitive + record)
// ---------------------------------------------------------------------------
test("Test transitive SM with struct-record effect in while loop", {
  Counter :: struct(
    increment : (fn(current : i32) -> i32)
  );
  loop_with_effect :: (
    fn(
      forall(E : Type.Struct),
      limit : i32,
      counter : Counter,
      e : E
    ) -> i32
  )({
    sum := Box(i32)(0);
    i := Box(i32)(0);
    c := Box(i32)(0);
    while(runtime(i.* < limit), {
      c.* = counter.increment(c.*);
      sum.* = (sum.* + c.*);
      i.* = (i.* + 1);
    });
    return(sum.*);
  });
  (counter : Counter) = Counter(
    increment :
      (current) -> {
        return(current + i32(1));
      }
  );
  result := loop_with_effect(i32(4), counter, {});
  assert(result == i32(10), "transitive SM struct record: 1+2+3+4 = 10");
});
// Regression: regular -> functions cannot capture outer runtime variables.
// Runtime struct evidence does not turn a regular handler function into a closure.
test("regular fn struct handler cannot capture outer runtime variable", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  outer_val := i32(42);
  comptime_expect_error(
    (r : Raise) = Raise(
      raise : ((msg) -> outer_val)
    )
  );
});
test("Test struct-based effect with unwind", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  safe_divide :: (fn(x : i32, y : i32, raise_mod : Raise) -> i32)(
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  (raise_mod : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        unwind(());
      }
  );
  result := safe_divide(10, 0, raise_mod);
  assert(false, "Should not reach here after unwind");
});
test("Test struct-based effect with resume", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  safe_divide :: (fn(x : i32, y : i32, raise_mod : Raise) -> i32)(
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  (raise_mod : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        return(i32(0));
      }
  );
  result := safe_divide(10, 0, raise_mod);
  assert(result == 0, "struct-based effect with resume: should be 0");
  result2 := safe_divide(10, 2, raise_mod);
  assert(result2 == 5, "struct-based effect with resume: should be 5");
});
// Rule 1: `unwind` requires the enclosing function to be `ctl(...)`.
// A `fn(...) -> ret` body containing `unwind` is a type error.
test("ctl rule 1: unwind in fn body is rejected", {
  comptime_expect_error(
    (fn() -> (fn(msg : String) -> i32))({
      (handler : (fn(msg : String) -> i32)) = (
        (msg) -> {
          unwind(i32(0));
        }
      );
      return(handler);
    })()
  );
});
// Rule 8 (escape boundary 1): function return type cannot be control-bound.
// `unwind` targets the frame where the handler was first locally bound; if
// the value is returned, the install frame is gone by the time a caller
// invokes it.
test("ctl rule 8: cannot return a control-bound value", {
  comptime_expect_error(
    (fn() -> (ctl(msg : String) -> i32))({
      (handler : (ctl(msg : String) -> i32)) = (
        (msg) -> {
          unwind(i32(0));
        }
      );
      return(handler);
    })()
  );
});
// Rule 8 (escape boundary 1): aggregate-containing-CF return is rejected.
test("ctl rule 8: cannot return a struct containing ctl field", {
  Holder :: struct(cf : (ctl(msg : String) -> i32));
  comptime_expect_error(
    (fn() -> Holder)({
      (handler : (ctl(msg : String) -> i32)) = (
        (msg) -> {
          unwind(i32(0));
        }
      );
      return(Holder(cf : handler));
    })()
  );
});
// Rule 8 (escape boundary 2): module-level binding type cannot be
// control-bound. Module-level bindings outlive every call frame.
comptime_expect_error(
  (escaped_handler : (ctl(msg : String) -> i32)) = (
    (msg) -> {
      unwind(i32(0));
    }
  )
);
// Rule 11: pointer to control-bound type is forbidden at the type level.
test("ctl rule 11: cannot form a pointer to a ctl type", {
  Raise :: (ctl(msg : String) -> i32);
  comptime_expect_error(PtrToCtl :: *(Raise));
});
// Rule 11: pointer to a struct containing ctl is also forbidden.
test("ctl rule 11: cannot form a pointer to a control-bound struct", {
  Holder :: struct(cf : (ctl(msg : String) -> i32));
  comptime_expect_error(PtrToHolder :: *(Holder));
});
// Rule 3: closure body cannot contain `unwind`. Closures are heap
// values that may outlive their enclosing frame; `unwind` requires
// frame-bound `ctl(...) -> ret` semantics.
test("ctl rule 3: closure body with unwind is rejected", {
  apply :: (fn(forall(T : Type), f : Impl(Fn() -> T)) -> T)(f());
  comptime_expect_error(
    apply(() => {
      unwind(i32(0));
    })
  );
});
// Rule 4: closure cannot capture a value of control-bound type.
test("ctl rule 4: closure cannot capture a ctl-typed value", {
  Raise :: (ctl(msg : String) -> i32);
  apply :: (fn(forall(T : Type), f : Impl(Fn() -> T)) -> T)(f());
  comptime_expect_error(
    (fn() -> i32)({
      (raise : Raise) = (
        (msg) -> {
          unwind(i32(0));
        }
      );
      return(apply(() => raise(`captured`)));
    })()
  );
});
// Rule 2: an inline lambda whose body contains `unwind` must carry an
// explicit `ctl(...) -> ret` annotation (either on the LHS binding or on
// the lambda itself). Inference from body content is intentionally not
// performed — without an annotation the lambda defaults to `fn`, and
// rule 1 rejects the `unwind`.
test("ctl rule 2: lambda with unwind needs explicit ctl annotation", {
  comptime_expect_error(
    (fn() -> i32)({
      // No annotation on the LHS, none on the lambda: the body's `unwind`
      // must be rejected rather than silently coerce the type to `ctl`.
      handler := (
        (msg : String) -> {
          unwind(i32(0));
        }
      );
      return(i32(1));
    })()
  );
});
// Rule 5 (negative direction): a `ctl(...) -> R` value cannot be assigned
// to a `fn(...) -> R` slot. The reverse subtyping would let a body that
// may `unwind` flow into a callee that expected a non-unwinder.
test("ctl rule 5: ctl is not a subtype of fn", {
  Raise :: (ctl(msg : String) -> i32);
  PureRaise :: (fn(msg : String) -> i32);
  comptime_expect_error(
    (fn() -> PureRaise)({
      (raise : Raise) = (
        (msg) -> {
          unwind(i32(0));
        }
      );
      (pure : PureRaise) = raise;
      return(pure);
    })()
  );
});
// Rule 5 (positive direction): a non-unwinding `fn(...) -> R` value IS a
// valid `ctl(...) -> R`. The lambda below has no `unwind`, so committing
// it to a `ctl`-typed slot is sound and must continue to work.
test("ctl rule 5: fn is a subtype of ctl", {
  Raise :: (ctl(msg : String) -> i32);
  (raise : Raise) = (
    (msg) -> {
      return(i32(42));
    }
  );
  result := raise(`anything`);
  assert(result == i32(42), "non-unwinding lambda should fill a ctl slot");
});
// Regression for issues/fixed/unwind-value-buffer-overflow.md: `unwind(v)`
// memcpy's `v` into the thread-local `__yo_unwind_value` buffer. That buffer
// used to be a fixed `char[64]`, so unwinding a value larger than 64 bytes
// overflowed it (FORTIFY __memcpy_chk → SIGTRAP). The buffer is now a union
// sized to the largest unwound value in the program. `BigUnwind` is 80 bytes.
test("ctl unwind of a value larger than 64 bytes", {
  BigUnwind :: struct(
    a : i64,
    b : i64,
    c : i64,
    d : i64,
    e : i64,
    f : i64,
    g : i64,
    h : i64,
    i : i64,
    j : i64
  );
  RaiseBig :: (ctl() -> BigUnwind);
  produce :: (fn(raise : RaiseBig) -> BigUnwind)(raise());
  run_big :: (fn() -> BigUnwind)({
    (raise : RaiseBig) = (
      () -> {
        unwind(
          BigUnwind(
            i64(1),
            i64(2),
            i64(3),
            i64(4),
            i64(5),
            i64(6),
            i64(7),
            i64(8),
            i64(9),
            i64(10)
          )
        );
      }
    );
    produce(raise)
  });
  big := run_big();
  assert(big.a == i64(1), "first field survives the unwind buffer");
  assert(big.j == i64(10), "last field survives the unwind buffer");
});
