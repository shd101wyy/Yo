test "Test multiple effect row spreads with resume", {
  Raise :: (fn(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);

  might_fail :: (fn(using(raise : Raise)) -> i32)(
    raise(`oops`)
  );

  might_log :: (fn(using(log : Log)) -> unit)(
    log(`logged something`)
  );

  run_both :: (fn(
      forall(T1 : Type, T2 : Type, ...(E1), ...(E2)),
      f1 : (fn(using(...(E1))) -> T1),
      f2 : (fn(using(...(E2))) -> T2),
      using(...(E1), ...(E2))
    ) -> T1)
  {
    f2();
    f1()
  };

  (given(raise) : Raise) = ((msg) -> {
    println(msg);
    return i32(42);
  });

  (given(log) : Log) = ((msg) -> {
    println(msg);
    return ();
  });

  result := run_both(might_fail, might_log);
  assert((result == i32(42)), "multiple spreads resume: should be 42");
};

test "Test multiple effect row spreads with escape", {
  Raise :: (fn(msg : String) -> i32);
  Log :: (fn(msg : String) -> unit);

  might_fail :: (fn(using(raise : Raise)) -> i32)(
    raise(`oops`)
  );

  might_log :: (fn(using(log : Log)) -> unit)(
    log(`logged something`)
  );

  run_both :: (fn(
      forall(T1 : Type, T2 : Type, ...(E1), ...(E2)),
      f1 : (fn(using(...(E1))) -> T1),
      f2 : (fn(using(...(E2))) -> T2),
      using(...(E1), ...(E2))
    ) -> T1)
  {
    f2();
    f1()
  };

  (given(raise) : Raise) = ((msg) -> {
    println(msg);
    escape ();
  });

  (given(log) : Log) = ((msg) -> {
    println(msg);
    return ();
  });

  run_both(might_fail, might_log);
  assert(false, "multiple spreads escape: should not reach here");
};

test "Test closure with using() effect - resume", {
  Log :: (fn(msg : String) -> unit);

  x := Box(i32)(0);

  (given(log) : Log) = ((msg) -> {
    println(msg);
    return ();
  });

  (closure : Impl(Fn(v : i32, msg : String, using(log : Log)) -> i32)) =
    (v, msg, using(log)) => {
      log(msg);
      x.* = (x.* + v);
      return x.*;
    };

  result1 := closure(1, `hello`);
  assert((result1 == 1), "closure+effect resume: expected result1 to be 1");
  assert((x.* == 1), "closure+effect resume: expected x to be 1");

  result2 := closure(2, `world`);
  assert((result2 == 3), "closure+effect resume: expected result2 to be 3");
  assert((x.* == 3), "closure+effect resume: expected x to be 3");
};

test "Test closure with using() effect - escape", {
  Log :: (fn(msg : String) -> unit);

  run_test :: (fn() -> i32) {
    x := Box(i32)(0);

    (given(log) : Log) = ((msg) -> {
      println(msg);
      escape i32(99);
    });

    (closure : Impl(Fn(v : i32, msg : String, using(log : Log)) -> i32)) =
      (v, msg, using(log)) => {
        log(msg);
        x.* = (x.* + v);
        return x.*;
      };

    result := closure(1, `hello`);
    assert(false, "closure+effect escape: should not reach here");
    return result;
  };

  val := run_test();
  assert((val == 99), "closure+effect escape: expected escape value 99");
};

test "Effect row polymorphism with ...(E) spread", {
  Yield :: (fn(v : i32) -> i32);
  Log :: (fn(v : i32) -> unit);

  traverse :: (fn(
    forall(S : usize, ...(E)),
    arr : Array(i32, S),
    callback : (Impl(Fn(v : i32, using(...(E))) -> unit)),
    using(...(E))
    ) -> unit) {
      i := usize(0);
      while i < S, i = (i + 1), {
        callback(arr(i));
      };
    };

  (given(yield) : Yield) =
    (v) -> {
      return v;
    };

  (given(log) : Log) =
    (v) -> {
      println(v);
    };

  sum := Box(i32)(0);
  arr := Array(i32, 5)(0, 1, 2, 3, 4);
  traverse(arr, (v, using(_yield, _log)) => {
    _log(v);
    result := _yield(v);
    assert((result == v), "effect row: yield should return the value");
    sum.* = (sum.* + result);
  }, using(yield, log));
  assert((sum.* == 10), "effect row: sum should be 10");
};

test "Effect row inline typed declaration using(name : Type)", {
  Yield :: (fn(v : i32) -> i32);
  Log :: (fn(v : i32) -> unit);

  traverse :: (fn(
    forall(S : usize, ...(E)),
    arr : Array(i32, S),
    callback : (Impl(Fn(v : i32, using(...(E))) -> unit)),
    using(...(E))
    ) -> unit) {
      i := usize(0);
      while i < S, i = (i + 1), {
        callback(arr(i));
      };
    };

  (given(yield) : Yield) =
    (v) -> {
      return v;
    };

  (given(log) : Log) =
    (v) -> {
      println(v);
    };

  sum := Box(i32)(0);
  arr := Array(i32, 5)(0, 1, 2, 3, 4);

  // Closure declares effect row inline with types — no call-site using() needed
  traverse(arr, (v, using(yield : Yield, log : Log)) => {
    log(v);
    result := yield(v);
    assert((result == v), "inline typed: yield should return the value");
    sum.* = (sum.* + result);
  });
  assert((sum.* == 10), "inline typed: sum should be 10");
};

test "Mixed escape and return in effect handler", {
  Yield :: (fn(v : i32) -> i32);
  Log :: (fn(v : i32) -> unit);

  traverse :: (fn(
    forall(S : usize, ...(E)),
    arr : Array(i32, S),
    callback : (Impl(Fn(v : i32, using(...(E))) -> unit)),
    using(...(E))
    ) -> unit) {
      i := usize(0);
      while i < S, i = (i + 1), {
        callback(arr(i));
      };
    };

  (given(yield) : Yield) =
    (v) -> (
      cond(
        (v > 2) => {
          escape ();
        },
        true => {
          return v;
        }
      )
    );

  (given(log) : Log) =
    (v) -> {
      println(v);
    };

  sum := Box(i32)(0);
  arr := Array(i32, 5)(0, 1, 2, 3, 4);

  traverse(arr, (v, using(yield : Yield, log : Log)) => {
    log(v);
    result := yield(v);
    assert((result == v), "mixed handler: yield should return the value");
    sum.* = (sum.* + result);
  });

  assert(false, "This line should not be reached due to escape in yield");
};

test "Transitive SM while loop with break", {
  Yield :: (fn(v : i32) -> i32);

  // A transitive effectful function — its forall(...(E)) means it always gets an SM.
  // The while loop + break is inside the SM-generated function itself.
  count_until :: (fn(
    forall(...(E)),
    limit : i32,
    using(...(E))
  ) -> i32) {
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    while runtime(true), {
      result := yield(counter.*);
      sum.* = (sum.* + result);
      counter.* = (counter.* + 1);
      cond(
        (counter.* >= limit) => { break; },
        true => ()
      );
    };
    return sum.*;
  };

  (given(yield) : Yield) =
    (v) -> {
      return (v * i32(2));
    };

  result := count_until(i32(4));
  // yield(0)*2=0, yield(1)*2=2, yield(2)*2=4, yield(3)*2=6 => sum = 12
  assert((result == i32(12)), "transitive break: sum should be 0+2+4+6 = 12");
};

test "Transitive SM while loop with continue", {
  Yield :: (fn(v : i32) -> i32);

  // Skip odd results, accumulate even results, stop at counter == 8.
  sum_even :: (fn(
    forall(...(E)),
    using(...(E))
  ) -> i32) {
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    while runtime(counter.* < i32(8)), {
      result := yield(counter.*);
      counter.* = (counter.* + 1);
      cond(
        ((result % i32(2)) != i32(0)) => { continue; },
        true => ()
      );
      sum.* = (sum.* + result);
    };
    return sum.*;
  };

  (given(yield) : Yield) =
    (v) -> {
      return v;
    };

  result := sum_even();
  // yield(0)=0, yield(1)=1(skip), yield(2)=2, yield(3)=3(skip),
  // yield(4)=4, yield(5)=5(skip), yield(6)=6, yield(7)=7(skip) => 0+2+4+6 = 12
  assert((result == i32(12)), "transitive continue: sum of even should be 12");
};

test "Transitive SM while loop with mixed continue and break", {
  Yield :: (fn(v : i32) -> i32);

  // continue on counter <= 2, break on counter >= 5, accumulate the rest
  mixed_loop :: (fn(
    forall(...(E)),
    using(...(E))
  ) -> i32) {
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    while runtime(true), {
      counter.* = (counter.* + 1);
      yield(counter.*);

      cond(
        (counter.* <= i32(2)) => { continue; },
        true => ()
      );

      cond(
        (counter.* >= i32(5)) => { break; },
        true => ()
      );

      sum.* = (sum.* + counter.*);
    };
    return sum.*;
  };

  (given(yield) : Yield) =
    (v) -> {
      return v;
    };

  result := mixed_loop();
  // counter 1: continue, 2: continue, 3: sum+=3, 4: sum+=4, 5: break
  assert((result == i32(7)), "transitive mixed: sum should be 3+4 = 7");
};

test "Transitive SM while loop with step expr and continue", {
  Yield :: (fn(v : i32) -> i32);

  sum_with_step :: (fn(
    forall(...(E)),
    using(...(E))
  ) -> i32) {
    i := Box(i32)(0);
    sum := Box(i32)(0);
    while runtime(i.* < i32(6)), i.* = (i.* + 1), {
      result := yield(i.*);
      cond(
        ((result % i32(2)) != i32(0)) => { continue; },
        true => ()
      );
      sum.* = (sum.* + result);
    };
    return sum.*;
  };

  (given(yield) : Yield) =
    (v) -> {
      return v;
    };

  result := sum_with_step();
  // yield(0)=0, yield(1)=1(skip), yield(2)=2, yield(3)=3(skip), yield(4)=4, yield(5)=5(skip) => 0+2+4 = 6
  assert((result == i32(6)), "transitive step+continue: sum of even should be 6");
};

test "Transitive SM while loop with early return", {
  Yield :: (fn(v : i32) -> i32);

  find_first :: (fn(
    forall(...(E)),
    threshold : i32,
    using(...(E))
  ) -> i32) {
    i := Box(i32)(0);
    while runtime(i.* < i32(10)), i.* = (i.* + 1), {
      result := yield(i.*);
      cond(
        (result >= threshold) => {
          return result;
        },
        true => ()
      );
    };
    return i32(-1);
  };

  (given(yield) : Yield) =
    (v) -> {
      return (v * i32(3));
    };

  result := find_first(i32(12));
  // yield(0)=0, yield(1)=3, yield(2)=6, yield(3)=9, yield(4)=12 >= 12 => return 12
  assert((result == i32(12)), "transitive early return: should find 12");
};

test "Module effect with forall handler — escape in while loop", {
  // Tests the pattern from fixme.yo: module-based effect with forall(ResumeType),
  // handler uses escape inside a while loop to abort traversal.
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (fn(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );

  safe_divide :: (fn(x : i32, y : i32, using(exn : MyException(i32))) -> i32)(
    cond(
      (y == 0) => exn.throw(x, i32(666)),
      true => (x / y)
    )
  );

  traverse :: (fn(
    forall(S : usize, ...(E)),
    arr : Array(i32, S),
    using(exn : MyException(i32), ...(E))
    ) -> unit) {
      i := usize(0);
      while i < S, i = (i + 1), {
        safe_divide(i32(42), arr(i));
      };
    };

  arr := Array(i32, 4)(1, 2, 0, 3);
  given(exn) := MyException(i32)(
    throw : ((val, resume_val) -> {
      escape ();
    })
  );
  traverse(arr, using(exn));
  assert(false, "Should not reach here after escape");
};

test "Module effect with forall handler — resume in while loop", {
  // Module-based effect with forall(ResumeType), handler resumes with a value.
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (fn(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );

  safe_divide :: (fn(x : i32, y : i32, using(exn : MyException(i32))) -> i32)(
    cond(
      (y == 0) => exn.throw(x, i32(0)),
      true => (x / y)
    )
  );

  run_test :: (fn() -> unit) {
    sum := Box(i32)(0);
    counter := Box(i32)(0);

    given(exn) := MyException(i32)(
      throw : ((val, resume_val) -> {
        // resume_val should be i32(0), resume with it
        return resume_val;
      })
    );

    while runtime(counter.* < i32(5)), {
      // arr = [2, 0, 3, 0, 1] pattern inlined
      divisor := cond(
        ((counter.* == i32(1)) || (counter.* == i32(3))) => i32(0),
        true => (counter.* + i32(1))
      );
      result := safe_divide(i32(10), divisor);
      sum.* = (sum.* + result);
      counter.* = (counter.* + 1);
    };

    assert((counter.* == i32(5)), "counter should reach 5");
    // 10/1=10, 10/0→resume(0)=0, 10/3=3, 10/0→resume(0)=0, 10/5=2 => sum = 15
    assert((sum.* == i32(15)), "sum should be 15");
  };
  run_test();
};

test "Module effect with forall handler — break after resume in while loop", {
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (fn(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );

  safe_op :: (fn(x : i32, using(exn : MyException(i32))) -> i32)(
    cond(
      (x < 0) => exn.throw(x, i32(0)),
      true => x
    )
  );

  run_test :: (fn() -> unit) {
    counter := Box(i32)(0);

    given(exn) := MyException(i32)(
      throw : ((val, resume_val) -> {
        return resume_val;
      })
    );

    while runtime(true), {
      result := safe_op((counter.* - i32(2)));
      counter.* = (counter.* + 1);
      cond(
        (counter.* >= i32(5)) => { break; },
        true => ()
      );
    };

    assert((counter.* == i32(5)), "break after module resume: counter should be 5");
  };
  run_test();
};

test "Module effect with forall handler — continue after resume in while loop", {
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (fn(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );

  safe_op :: (fn(x : i32, using(exn : MyException(i32))) -> i32)(
    cond(
      (x < 0) => exn.throw(x, i32(0)),
      true => x
    )
  );

  run_test :: (fn() -> unit) {
    sum := Box(i32)(0);
    counter := Box(i32)(0);

    given(exn) := MyException(i32)(
      throw : ((val, resume_val) -> {
        return resume_val;
      })
    );

    while runtime(counter.* < i32(6)), {
      i := counter.*;
      counter.* = (counter.* + 1);
      result := safe_op((i - i32(2)));
      // result: negative inputs → 0 (resumed), non-negative → identity
      // i=0→-2→0, i=1→-1→0, i=2→0, i=3→1, i=4→2, i=5→3
      cond(
        (result == i32(0)) => { continue; },
        true => ()
      );
      sum.* = (sum.* + result);
    };

    assert((counter.* == i32(6)), "continue after module resume: counter should be 6");
    // sum = 1 + 2 + 3 = 6
    assert((sum.* == i32(6)), "continue after module resume: sum should be 6");
  };
  run_test();
};

test "Module effect with forall handler — early return after resume in while loop", {
  MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
    struct(
      throw : (fn(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
    )
  );

  safe_op :: (fn(x : i32, using(exn : MyException(i32))) -> i32)(
    cond(
      (x < 0) => exn.throw(x, i32(0)),
      true => x
    )
  );

  find_first_positive :: (fn() -> i32) {
    counter := Box(i32)(0);

    given(exn) := MyException(i32)(
      throw : ((val, resume_val) -> {
        return resume_val;
      })
    );

    while runtime(counter.* < i32(10)), {
      result := safe_op((counter.* - i32(3)));
      counter.* = (counter.* + 1);
      cond(
        (result > i32(0)) => {
          return result;
        },
        true => ()
      );
    };

    return i32(-1);
  };

  result := find_first_positive();
  // counter: 0→-3→0, 1→-2→0, 2→-1→0, 3→0, 4→1>0 → return 1
  assert((result == i32(1)), "early return after module resume: should find 1");
};

// ---------------------------------------------------------------------------
// Break in tagged union (Option) match arm after fn resume
// Analogous to async_await test: break in Option match in async while loop.
// Tests that goto-based break in match bodyCode is emitted directly.
// ---------------------------------------------------------------------------
test "Test break in Option match arm after fn resume", {
  GetValue :: (fn() -> i32);

  run_test :: (fn() -> unit) {
    counter := Box(i32)(0);
    sum := Box(i32)(0);

    (given(get_value) : GetValue) = (() -> {
      return i32(1);
    });

    while runtime(true), {
      get_value();
      counter.* = (counter.* + 1);

      opt := cond(
        (counter.* > i32(5)) => Option(i32).None,
        true => Option(i32).Some(counter.*)
      );

      val := match(opt,
        .Some(v) => v,
        .None => break
      );
      sum.* = (sum.* + val);
    };

    assert(counter.* == i32(6), "counter should be 6 when None triggers break");
    assert(sum.* == i32(15), "sum should be 1+2+3+4+5 = 15");
  };
  run_test();
};

// ---------------------------------------------------------------------------
// Continue in tagged union (Option) match arm after fn resume
// Analogous to async_await test: continue in Option match in async while loop.
// ---------------------------------------------------------------------------
test "Test continue in Option match arm after fn resume", {
  GetValue :: (fn() -> i32);

  run_test :: (fn() -> unit) {
    counter := Box(i32)(0);
    sum := Box(i32)(0);

    (given(get_value) : GetValue) = (() -> {
      return i32(1);
    });

    while runtime(counter.* < i32(6)), {
      get_value();
      counter.* = (counter.* + 1);

      // Skip even numbers via Option match
      opt := cond(
        ((counter.* % i32(2)) == i32(0)) => Option(i32).None,
        true => Option(i32).Some(counter.*)
      );

      val := match(opt,
        .Some(v) => v,
        .None => continue
      );
      sum.* = (sum.* + val);
    };

    assert(counter.* == i32(6), "counter should reach 6");
    assert(sum.* == i32(9), "sum should be 1+3+5 = 9 (even numbers skipped)");
  };
  run_test();
};

// ---------------------------------------------------------------------------
// Mixed break and continue in tagged union (Option) match arms after fn resume
// Analogous to async_await test: mixed break and continue in Option match.
// ---------------------------------------------------------------------------
test "Test mixed break and continue in Option match after fn resume", {
  GetValue :: (fn() -> i32);

  run_test :: (fn() -> unit) {
    counter := Box(i32)(0);
    sum := Box(i32)(0);

    (given(get_value) : GetValue) = (() -> {
      return i32(1);
    });

    while runtime(true), {
      get_value();
      counter.* = (counter.* + 1);

      // None means break, Some(0) means continue, Some(v) means accumulate
      opt := cond(
        (counter.* > i32(7)) => Option(i32).None,
        ((counter.* % i32(3)) == i32(0)) => Option(i32).Some(i32(0)),
        true => Option(i32).Some(counter.*)
      );

      val := match(opt,
        .Some(v) => cond((v == i32(0)) => continue, true => v),
        .None => break
      );
      sum.* = (sum.* + val);
    };

    assert(counter.* == i32(8), "counter should be 8 when None triggers break");
    // Iterations: 1→Some(1)→sum, 2→Some(2)→sum, 3→Some(0)→continue,
    // 4→Some(4)→sum, 5→Some(5)→sum, 6→Some(0)→continue,
    // 7→Some(7)→sum, 8→None→break
    // sum = 1+2+4+5+7 = 19
    assert(sum.* == i32(19), "sum should be 1+2+4+5+7 = 19");
  };
  run_test();
};

// ===========================================================================
// Additional corner-case tests
// ===========================================================================

// ---------------------------------------------------------------------------
// Three-level effect propagation via using parameter
// Tests that evidence pointers are forwarded correctly through 3 call levels.
// ---------------------------------------------------------------------------
test "Test three-level effect propagation via using parameter", {
  Raise :: (fn(msg : String) -> i32);

  level3 :: (fn(x : i32, using(raise : Raise)) -> i32)(
    cond(
      (x < 0) => raise(`negative`),
      true => (x * i32(2))
    )
  );

  level2 :: (fn(x : i32, using(raise : Raise)) -> i32)(
    (level3(x) + i32(1))
  );

  level1 :: (fn(x : i32, using(raise : Raise)) -> i32)(
    (level2(x) + i32(10))
  );

  (given(raise) : Raise) = ((msg) -> {
    return i32(0);
  });

  result1 := level1(i32(5));
  assert((result1 == i32(21)), "3-level propagation: 5*2+1+10 = 21");

  result2 := level1(i32(-1));
  assert((result2 == i32(11)), "3-level propagation with raise: 0+1+10 = 11");
};

// ---------------------------------------------------------------------------
// Three-level effect propagation with escape
// Escape at the deepest level should propagate all the way out.
// ---------------------------------------------------------------------------
test "Test three-level effect propagation with escape", {
  Raise :: (fn(msg : String) -> i32);

  level3 :: (fn(x : i32, using(raise : Raise)) -> i32)(
    cond(
      (x < 0) => raise(`negative`),
      true => (x * i32(2))
    )
  );

  level2 :: (fn(x : i32, using(raise : Raise)) -> i32)(
    (level3(x) + i32(1))
  );

  level1 :: (fn(x : i32, using(raise : Raise)) -> i32)(
    (level2(x) + i32(10))
  );

  run_test :: (fn() -> i32) {
    (given(raise) : Raise) = ((msg) -> {
      escape i32(99);
    });
    level1(i32(-1))
  };

  result := run_test();
  assert((result == i32(99)), "3-level escape: should get 99");
};

// ---------------------------------------------------------------------------
// Module effect with escape returning non-unit value
// ---------------------------------------------------------------------------
test "Test module effect escape with non-unit value", {
  Raise :: struct(
    raise : (fn(msg : String) -> i32)
  );

  safe_divide :: (fn(x : i32, y : i32, using(raise_mod : Raise)) -> i32)(
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  );

  run_test :: (fn() -> i32) {
    (given(raise_mod) : Raise) = Raise(
      raise :
        (msg) -> {
          escape i32(-1);
        }
    );
    safe_divide(10, 0)
  };

  result := run_test();
  assert((result == i32(-1)), "module escape non-unit: should get -1");
};

// ---------------------------------------------------------------------------
// Module effect with multiple functions
// Tests that a module with more than one function field works correctly.
// ---------------------------------------------------------------------------
test "Test module effect with multiple function members", {
  Logger :: struct(
    info : (fn(msg : String) -> i32),
    warn : (fn(msg : String) -> i32),
    count : (fn(current : i32) -> i32)
  );

  log_messages :: (fn(using(logger : Logger)) -> i32) {
    logger.info(`first info`);
    logger.warn(`first warn`);
    logger.info(`second info`);
    logger.count(i32(3))
  };

  (given(logger) : Logger) = Logger(
    info :
      (msg) -> {
        println(msg);
        return i32(1);
      },
    warn :
      (msg) -> {
        println(msg);
        return i32(1);
      },
    count :
      (current) -> {
        return current;
      }
  );

  result := log_messages();
  assert((result == 3), "multi-member module: count(3) should return 3");
};

// ---------------------------------------------------------------------------
// Multiple module effects in the same scope
// Two distinct module effect types used together.
// ---------------------------------------------------------------------------
test "Test multiple module effects in same scope", {
  Raise :: struct(
    raise : (fn(msg : String) -> i32)
  );

  Log :: struct(
    log : (fn(msg : String) -> i32)
  );

  compute :: (fn(x : i32, y : i32, using(raise_mod : Raise, log_mod : Log)) -> i32) {
    log_mod.log(`computing`);
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  };

  (given(raise_mod) : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        return i32(0);
      }
  );
  (given(log_mod) : Log) = Log(
    log :
      (msg) -> {
        println(msg);
        return i32(1);
      }
  );

  result := compute(10, 2);
  assert((result == 5), "multi-module: 10/2 = 5");

  result2 := compute(10, 0);
  assert((result2 == 0), "multi-module: raise returns 0");
};

// ---------------------------------------------------------------------------
// Effect handler that conditionally resumes or escapes based on argument
// Handler decides at runtime whether to resume or escape.
// ---------------------------------------------------------------------------
test "Test effect handler conditional resume or escape based on argument", {
  Raise :: (fn(msg : String, attempt : i32) -> i32);

  safe_divide :: (fn(x : i32, y : i32, attempt : i32, using(raise : Raise)) -> i32)(
    cond(
      (y == 0) => raise(`div-by-zero`, attempt),
      true => (x / y)
    )
  );

  run_test :: (fn() -> i32) {
    (given(raise) : Raise) = ((msg, attempt) -> {
      cond(
        (attempt <= i32(2)) => {
          return i32(0);
        },
        true => {
          escape i32(-1);
        }
      );
    });

    sum := Box(i32)(0);
    sum.* = (sum.* + safe_divide(10, 0, i32(1)));
    sum.* = (sum.* + safe_divide(20, 0, i32(2)));
    sum.* = (sum.* + safe_divide(30, 0, i32(3)));
    return sum.*;
  };

  result := run_test();
  assert((result == i32(-1)), "conditional resume/escape: third call escapes with -1");
};

// ---------------------------------------------------------------------------
// Recursive function with effects (recur + using)
// ---------------------------------------------------------------------------
test "Test recursive function with effect via recur", {
  Raise :: (fn(msg : String) -> i32);

  sum_to :: (fn(n : i32, using(raise : Raise)) -> i32)(
    cond(
      (n <= 0) => raise(`reached zero`),
      true => (n + recur((n - 1)))
    )
  );

  (given(raise) : Raise) = ((msg) -> {
    return i32(0);
  });

  result := sum_to(i32(5));
  assert((result == i32(15)), "recur+effect: 5+4+3+2+1+0 = 15");
};

// ---------------------------------------------------------------------------
// Recursive function with effect — escape during recursion
// ---------------------------------------------------------------------------
test "Test recursive function with effect escape during recursion", {
  Raise :: (fn(val : i32) -> i32);

  sum_to :: (fn(n : i32, using(raise : Raise)) -> i32)(
    cond(
      (n <= 0) => i32(0),
      true => (raise(n) + recur((n - 1)))
    )
  );

  run_test :: (fn() -> i32) {
    (given(raise) : Raise) = ((val) -> {
      cond(
        (val == i32(3)) => {
          escape i32(42);
        },
        true => {
          return val;
        }
      );
    });
    sum_to(i32(5))
  };

  result := run_test();
  assert((result == i32(42)), "recur+escape: should escape with 42 at n=3");
};

// ---------------------------------------------------------------------------
// Effect with enum return type (Option)
// ---------------------------------------------------------------------------
test "Test effect with Option return type", {
  Lookup :: (fn(key : i32) -> Option(i32));

  get_or_default :: (fn(key : i32, default_val : i32, using(lookup : Lookup)) -> i32)(
    match(lookup(key),
      .Some(v) => v,
      .None => default_val
    )
  );

  (given(lookup) : Lookup) = ((key) -> {
    return cond(
      (key > 0) => Option(i32).Some((key * i32(10))),
      true => Option(i32).None
    );
  });

  result1 := get_or_default(i32(3), i32(-1));
  assert((result1 == i32(30)), "option effect: key=3 -> 30");

  result2 := get_or_default(i32(0), i32(-1));
  assert((result2 == i32(-1)), "option effect: key=0 -> default -1");

  result3 := get_or_default(i32(-5), i32(99));
  assert((result3 == i32(99)), "option effect: key=-5 -> default 99");
};

// ---------------------------------------------------------------------------
// Effect-polymorphic function with module effect (not just fn-type effect)
// Combines forall(...(E)) spread with module-type effects.
// ---------------------------------------------------------------------------
test "Test effect polymorphism with module effect spread", {
  Raise :: struct(
    raise : (fn(msg : String) -> i32)
  );

  might_fail :: (fn(using(raise_mod : Raise)) -> i32)(
    raise_mod.raise(`oops`)
  );

  run :: (fn(forall(T : Type, ...(E)),
      f : (fn(using(...(E))) -> T),
      using(...(E))) -> T)(f());

  (given(raise_mod) : Raise) = Raise(
    raise :
      (msg) -> {
        return i32(77);
      }
  );

  result := run(might_fail);
  assert(result == i32(77), "module effect polymorphism: should be 77");
};

// ---------------------------------------------------------------------------
// Transitive SM with module effects (combine forall + transitive + module)
// ---------------------------------------------------------------------------
test "Test transitive SM with module effect in while loop", {
  Counter :: struct(
    increment : (fn(current : i32) -> i32)
  );

  loop_with_effect :: (fn(
    forall(...(E)),
    limit : i32,
    using(...(E))
  ) -> i32) {
    sum := Box(i32)(0);
    i := Box(i32)(0);
    c := Box(i32)(0);
    while runtime(i.* < limit), {
      c.* = counter.increment(c.*);
      sum.* = (sum.* + c.*);
      i.* = (i.* + 1);
    };
    return sum.*;
  };

  (given(counter) : Counter) = Counter(
    increment :
      (current) -> {
        return (current + i32(1));
      }
  );

  result := loop_with_effect(i32(4));
  assert((result == i32(10)), "transitive SM module: 1+2+3+4 = 10");
};
// Regression: regular -> functions cannot capture outer runtime variables.
// Runtime struct evidence does not turn a regular handler function into a closure.
test "regular fn struct handler cannot capture outer runtime variable", {
  Raise :: struct(
    raise : (fn(msg : String) -> i32)
  );

  outer_val := i32(42);
  comptime_expect_error(
    (given(r) : Raise) = Raise(
      raise : ((msg) -> outer_val)
    )
  );
};

test "Test struct-based effect with escape", {
  Raise :: struct(
    raise : (fn(msg : String) -> i32)
  );

  safe_divide :: (fn(x : i32, y : i32, using(raise_mod : Raise)) -> i32)(
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  );

  (given(raise_mod) : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        escape ();
      }
  );

  result := safe_divide(10, 0);
  assert(false, "Should not reach here after escape");
};

test "Test struct-based effect with resume", {
  Raise :: struct(
    raise : (fn(msg : String) -> i32)
  );

  safe_divide :: (fn(x : i32, y : i32, using(raise_mod : Raise)) -> i32)(
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  );

  (given(raise_mod) : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        return i32(0);
      }
  );

  result := safe_divide(10, 0);
  assert((result == 0), "struct-based effect with resume: should be 0");
  result2 := safe_divide(10, 2);
  assert((result2 == 5), "struct-based effect with resume: should be 5");
};
