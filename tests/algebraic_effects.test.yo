pragma(Pragma.AllowUnsafe);
open(import("std/string")); // Let's use `String` instead of `str`
open(import("std/fmt"));
{ Exception } :: import("std/error");
test("Test fn unwind and return via using parameter", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // Use an effect in a function (effect becomes an implicit parameter)
  safe_divide :: (fn(x : i32, y : i32, raise : Raise) -> i32)(
    cond(
      (y == 0) => raise(`div-by-zero`, `I don't like it`),
      true => (x / y)
    )
  );
  // Handle the effect — without resume (discarding continuation)
  raise_const :: (fn() -> i64)({
    (raise : Raise) = (
      (msg, msg2) -> {
        // values/anonymous-function.ts
        println(msg);
        println(msg2);
        unwind(i64(42)); // unwind type should match the outer function return type, which is i64 in this case
        // `unwind` is only allowed in a `ctl(...) -> ret` function value (see ctl typing rule 1).
      }
    );
    (i64(8) + i64(safe_divide(1, 0, raise))) + (i64(10) + i64(safe_divide(10, 2, raise)))
  });
  // Returns 42 — continuation is discarded
  // Handle the effect — with resume (invoking continuation)
  raise_resume :: (fn() -> i64)({
    (raise : Raise) = (fn(msg : String, msg2 : String) -> i32)({
      // calls/function-type.ts
      println(msg);
      println(msg2);
      return(i32(42));
    });
    (i64(8) + i64(safe_divide(1, 0, raise))) + i64(10)
  });
  // Returns 60 — return(42) continues after the raise call site
  result1 := raise_const();
  result2 := raise_resume();
  assert(result1 == i64(42));
  assert(result2 == i64(60));
});
test("Test fn resume called directly without intermediate using function", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // The fn function is called directly. The handler uses `return(value)` to
  // resume the continuation — execution continues after the raise(...) call
  // and `result` receives the handler's returned value.
  run_test :: (fn() -> unit)({
    (raise : Raise) = (
      (msg, msg2) -> {
        println(msg);
        println(msg2);
        return(i32(16));
      }
    );
    result := raise(`direct-resume`, `Handler returns a value`);
    println("After raise");
    assert(result == 16, "result should be 16");
  });
  run_test();
});
test("Test fn unwind called directly without intermediate using function", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // The fn function is called directly in the handler scope — no intermediate
  // function with `raise : Raise`. The handler runs, prints the messages,
  // and aborts with `()`, matching the enclosing function's return type (unit).
  run_test :: (fn() -> unit)({
    (raise : Raise) = (
      (msg, msg2) -> {
        println(msg);
        println(msg2);
        unwind(());
      }
    );
    raise(`direct-call`, `No using parameter needed`);
    assert(false, "This line should not be reached");
  });
  run_test();
});
test("Test zero-arg unwind exits unit function", {
  Raise :: (ctl() -> unit);
  run_test :: (fn() -> unit)({
    (raise : Raise) = (
      () -> {
        unwind();
      }
    );
    raise();
    assert(false, "This line should not be reached");
  });
  run_test();
});
test("Test nested fn unwind inside resume handler", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // raise2 is defined inside raise's handler body. raise2 aborts with i32(18),
  // which becomes the result of the outer raise call (since unwind exits the
  // nearest enclosing fn handler, which is raise's handler).
  run_test :: (fn() -> unit)({
    (raise : Raise) = (
      (msg, msg2) -> {
        println(msg);
        println(msg2);
        (raise2 : Raise) = (
          (m1, m2) -> {
            println(m1);
            println(m2);
            unwind(i32(18));
          }
        );
        raise2(`inner msg1`, `inner msg2`);
        assert(false, "This should not be reached if raise2 aborts");
        return(i32(16));
      }
    );
    result := raise(`outer msg1`, `outer msg2`);
    assert(result == 18, "result should be 18 from raise2s unwind");
  });
  run_test();
});
test("Test nested fn resume inside resume handler", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  RaiseF32 :: (fn(msg : String, msg2 : String) -> f32);
  // raise2 is defined inside raise's handler body. raise2 resumes with f32(3.14),
  // then raise resumes with i32(16). Both handlers use return (resume) so
  // execution continues after each call site.
  run_test :: (fn() -> unit)({
    (raise : Raise) = (
      (msg, msg2) -> {
        println(msg);
        println(msg2);
        (raise2 : RaiseF32) = (
          (m1, m2) -> {
            println(m1);
            println(m2);
            return(f32(3.14));
          }
        );
        raise2_result := raise2(`inner msg1`, `inner msg2`);
        assert(raise2_result == f32(3.14), "raise2 should return 3.14");
        return(i32(16));
      }
    );
    result := raise(`outer msg1`, `outer msg2`);
    assert(result == 16, "result should be 16 from raise's return");
  });
  run_test();
});
test("Test while loop calling fn with resume", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // Analogous to async_await test #13: While loop with await inside.
  // Each iteration calls the fn handler which resumes with i32(10).
  run_test :: (fn() -> unit)({
    sum := Box(i32)(0);
    counter := Box(i32)(0);
    (raise : Raise) = (
      (msg, msg2) -> {
        return(i32(10));
      }
    );
    while(runtime(counter.* < i32(5)), {
      result := raise(`msg1`, `msg2`);
      sum.* = (sum.* + result);
      counter.* = (counter.* + 1);
    });
    assert(counter.* == i32(5), "counter should be 5");
    assert(sum.* == i32(50), "sum should be 5*10 = 50");
  });
  run_test();
});
test("Test while loop with break after fn resume", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // Analogous to async_await test #14: While loop with break after await.
  // The handler resumes, then break is used after the fn call.
  run_test :: (fn() -> unit)({
    counter := Box(i32)(0);
    (raise : Raise) = (
      (msg, msg2) -> {
        return(i32(1));
      }
    );
    while(runtime(true), {
      result := raise(`msg1`, `msg2`);
      counter.* = (counter.* + result);
      cond(
        (counter.* >= i32(3)) => {
          break;
        },
        true => ()
      );
    });
    assert(counter.* == i32(3), "counter should be 3 after break");
  });
  run_test();
});
test("Test while loop with continue after fn resume", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // Analogous to async_await test #24: Continue in async while loop.
  // Loop calls fn with resume, then continues (skips sum) on odd iterations.
  run_test :: (fn() -> unit)({
    sum := Box(i32)(0);
    counter := Box(i32)(0);
    (raise : Raise) = (
      (msg, msg2) -> {
        return(i32(1));
      }
    );
    while(runtime(counter.* < i32(10)), {
      raise(`msg1`, `msg2`);
      i := counter.*;
      counter.* = (counter.* + 1);
      cond(
        ((i % i32(2)) != i32(0)) => {
          continue;
        },
        true => ()
      );
      sum.* = (sum.* + i);
    });
    assert(counter.* == i32(10), "counter should be 10");
    assert(sum.* == i32(20), "sum of even numbers 0+2+4+6+8 = 20");
  });
  run_test();
});
test("Test break from cond after fn resume", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // Analogous to async_await test #25: Break from cond in async while loop.
  // while(true), call fn, increment counter, break from cond when counter >= 5.
  // sum = 1+2+3+4 = 10
  run_test :: (fn() -> unit)({
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    (raise : Raise) = (
      (msg, msg2) -> {
        return(i32(1));
      }
    );
    while(runtime(true), {
      raise(`msg1`, `msg2`);
      counter.* = (counter.* + 1);
      cond(
        (counter.* >= i32(5)) => {
          break;
        },
        true => ()
      );
      sum.* = (sum.* + counter.*);
    });
    assert(counter.* == i32(5), "counter should be 5 after break");
    assert(sum.* == i32(10), "sum should be 1+2+3+4 = 10");
  });
  run_test();
});
test("Test break drops local allocations after fn resume", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // Analogous to async_await test #27: Break drops local allocations.
  // Allocate a Box each iteration; break at iteration 3.
  // ASan will catch leaks of the Box or String fn args.
  run_test :: (fn() -> unit)({
    counter := Box(i32)(0);
    (raise : Raise) = (
      (msg, msg2) -> {
        return(i32(1));
      }
    );
    while(runtime(true), {
      temp := Box(i32)(counter.*);
      raise(`msg1`, `msg2`);
      counter.* = (temp.* + 1);
      cond(
        (counter.* >= i32(3)) => {
          break;
        },
        true => ()
      );
    });
    assert(counter.* == i32(3), "counter should be 3 after break");
  });
  run_test();
});
test("Test mixed continue then break after fn resume", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // Analogous to async_await test #32: Mixed continue then break.
  // 1,2 continue; 3,4 accumulate; 5 breaks. sum = 3+4 = 7.
  run_test :: (fn() -> unit)({
    counter := Box(i32)(0);
    sum := Box(i32)(0);
    (raise : Raise) = (
      (msg, msg2) -> {
        return(i32(1));
      }
    );
    while(runtime(true), {
      counter.* = (counter.* + 1);
      raise(`msg1`, `msg2`);
      cond(
        (counter.* <= i32(2)) => {
          continue;
        },
        true => ()
      );
      cond(
        (counter.* >= i32(5)) => {
          break;
        },
        true => ()
      );
      sum.* = (sum.* + counter.*);
    });
    assert(counter.* == i32(5), "counter should stop at 5");
    assert(sum.* == i32(7), "sum should be 3+4 = 7");
  });
  run_test();
});
test("Test early return inside loop after fn resume", {
  Raise :: (ctl(msg : String, msg2 : String) -> i32);
  // Analogous to async_await test #37: Early return inside loop after continue.
  // Continue on even numbers; early-return at first odd >= 5.
  find_first_odd :: (fn() -> i32)({
    i := Box(i32)(0);
    (raise : Raise) = (
      (msg, msg2) -> {
        return(i32(1));
      }
    );
    while(runtime(i.* < i32(10)), {
      i.* = (i.* + 1);
      raise(`msg1`, `msg2`);
      cond(
        ((i.* % i32(2)) == i32(0)) => {
          continue;
        },
        true => ()
      );
      cond(
        (i.* >= i32(5)) => {
          return(i.*);
        },
        true => ()
      );
    });
    return(i32(-(1)));
  });
  result := find_first_odd();
  assert(result == i32(5), "first odd value >= 5 should be 5");
});
test("Test two different fn types in same scope (Log + Raise)", {
  Raise :: (ctl(msg : String) -> i32);
  Log :: (fn(msg : String, counter : Box(i32)) -> unit);
  log_count := box(i32(0));
  (log : Log) = (
    (msg, counter) -> {
      println(msg);
      counter.* = (counter.* + i32(1));
      return(());
    }
  );
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      return(i32(42));
    }
  );
  log(`first log`, log_count);
  log(`second log`, log_count);
  result := raise(`error!`);
  assert(log_count.* == i32(2), "log_count should be 2");
  assert(result == i32(42), "result should be 42");
});
test("Test single-level effect propagation via using parameter", {
  Raise :: (ctl(msg : String) -> i32);
  safe_divide :: (fn(x : i32, y : i32, raise : Raise) -> i32)(
    cond(
      (y == 0) => raise(`division by zero`),
      true => (x / y)
    )
  );
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      return(i32(0));
    }
  );
  result := safe_divide(10, 0, raise);
  assert(result == i32(0), "single-level propagation: should return 0");
});
test("Test two-level effect propagation via using parameter", {
  Raise :: (ctl(msg : String) -> i32);
  safe_divide :: (fn(x : i32, y : i32, raise : Raise) -> i32)(
    cond(
      (y == 0) => raise(`division by zero`),
      true => (x / y)
    )
  );
  compute :: (fn(a : i32, b : i32, raise : Raise) -> i32)(
    safe_divide(a, b, raise) + i32(10)
  );
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      return(i32(0));
    }
  );
  result := compute(50, 0, raise);
  assert(result == i32(10), "two-level propagation: 0 + 10 = 10");
});
test("Test two-level effect propagation via using parameter with unwind", {
  Raise :: (ctl(msg : String) -> i32);
  safe_divide :: (fn(x : i32, y : i32, raise : Raise) -> i32)(
    cond(
      (y == 0) => raise(`division by zero`),
      true => (x / y)
    )
  );
  compute :: (fn(a : i32, b : i32, raise : Raise) -> i32)(
    safe_divide(a, b, raise) + i32(10)
  );
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      unwind(());
    }
  );
  result := compute(50, 0, raise);
  assert(false, "Expected to unwind");
});
test("Test given variable shadowing (inner scope shadows outer)", {
  Raise :: (ctl(msg : String) -> i32);
  safe_divide :: (fn(x : i32, y : i32, raise : Raise) -> i32)(
    cond(
      (y == 0) => raise(`division by zero`),
      true => (x / y)
    )
  );
  (raise : Raise) = (
    (msg) -> {
      return(i32(0));
    }
  );
  result1 := safe_divide(10, 0, raise);
  assert(result1 == i32(0), "outer handler should return 0");
  result2 := {
    (raise_inner : Raise) = (
      (msg) -> {
        return(i32(-(1)));
      }
    );
    safe_divide(20, 0, raise_inner)
  };
  assert(result2 == i32(-(1)), "inner handler should shadow outer and return -1");
  result3 := safe_divide(30, 0, raise);
  assert(result3 == i32(0), "outer handler should still work after inner scope");
});
test("Test given variable shadowing (inner scope shadows outer) with unwind", {
  Raise :: (ctl(msg : String) -> i32);
  // Function that USES the effect (propagates via using parameter)
  safe_divide :: (fn(x : i32, y : i32, raise : Raise) -> i32)(
    cond(
      (y == 0) => raise(`division by zero`),
      true => (x / y)
    )
  );
  // Define `raise` at top level
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      return(i32(0));
    }
  );
  {
    // Define a new handler that unwinds; pass it explicitly to safe_divide.
    (raise2 : Raise) = (
      (msg) -> {
        println(msg);
        unwind(());
      }
    );
    result := safe_divide(10, 0, raise2);
    assert(false, "multi-level propagation: should not reach here");
  };
  assert(false, "should not reach here");
});
test("Test effect polymorphism with using spread", {
  Raise :: (ctl(msg : String) -> i32);
  might_fail :: (fn(raise : Raise) -> i32)(
    raise(`oops`)
  );
  // Effect-polymorphic function: forwards whatever effects f needs
  run :: (
    fn(
      forall(T : Type, E : Type.Struct),
      f : (fn(e : E) -> T),
      e : E
    ) -> T
  )(f(e));
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      return(i32(42));
    }
  );
  result := run(might_fail, raise);
  assert(result == i32(42), "effect polymorphism: should be 42");
});
test("Test effect polymorphism with using spread and unwind", {
  Raise :: (ctl(msg : String) -> i32);
  might_fail :: (fn(raise : Raise) -> i32)(
    raise(`oops`)
  );
  // Effect-polymorphic function: forwards whatever effects f needs
  run :: (
    fn(
      forall(T : Type, E : Type.Struct),
      f : (fn(e : E) -> T),
      e : E
    ) -> T
  )(f(e));
  (raise : Raise) = (
    (msg) -> {
      println(msg);
      unwind(());
    }
  );
  result := run(might_fail, raise);
  assert(false, "This line should not be reached since might_fail raises an error");
});
test("Test struct-record effect with unwind", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  safe_divide :: (fn(x : i32, y : i32, raise_mod : Raise) -> i32)(
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  (raise_mod : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        unwind(());
      }
  );
  result := safe_divide(10, 0, raise_mod);
  assert(false, "Should not reach here after unwind");
});
test("Test struct-record effect with resume", {
  Raise :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  safe_divide :: (fn(x : i32, y : i32, raise_mod : Raise) -> i32)(
    cond(
      (y == 0) => raise_mod.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  (raise_mod : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        return(i32(0));
      }
  );
  result := safe_divide(10, 0, raise_mod);
  assert(result == 0, "struct-record effect with resume: should be 0");
  result2 := safe_divide(10, 2, raise_mod);
  assert(result2 == 5, "struct-record effect with resume: should be 5");
});
test("Test nested struct-record effect with unwind", {
  Errors :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  Effects :: struct(
    errors : Errors
  );
  safe_divide :: (fn(x : i32, y : i32, fx : Effects) -> i32)(
    cond(
      (y == 0) => fx.errors.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  (fx : Effects) = Effects(
    errors : Errors(
      raise :
        (msg) -> {
          println(msg);
          unwind(());
        }
    )
  );
  result := safe_divide(10, 0, fx);
  assert(false, "Should not reach here after unwind");
});
test("Test nested struct-record effect with resume", {
  Errors :: struct(
    raise : (ctl(msg : String) -> i32)
  );
  Effects :: struct(
    errors : Errors
  );
  safe_divide :: (fn(x : i32, y : i32, fx : Effects) -> i32)(
    cond(
      (y == 0) => fx.errors.raise(`div-by-zero`),
      true => (x / y)
    )
  );
  (fx : Effects) = Effects(
    errors : Errors(
      raise :
        (msg) -> {
          println(msg);
          return(i32(0));
        }
    )
  );
  result := safe_divide(10, 0, fx);
  assert(result == 0, "nested struct-record effect with resume: should be 0");
  result2 := safe_divide(10, 2, fx);
  assert(result2 == 5, "nested struct-record effect with resume: should be 5");
});
