      callback(arr(i), e);
    });
  });
  (yield : Yield) =
    (v) -> {
      return(v);
    };
  (log : Log) =
    (v) -> {
      println(v);
    };
  sum := Box(i32)(0);
  arr := Array(i32, 5)(0, 1, 2, 3, 4);
  // Closure declares effect row inline with types — no call-site using() needed
  Eff :: struct(yield : Yield, log : Log);
  traverse(arr, (v : i32, e : Eff) => {
