// The `Copy` trait (plans/VALUES_BY_DEFAULT.md decision 36, Generation A).
//
// `Copy` is a prelude marker that requires `Clone`, as Rust's `Copy: Clone`.
// A named type opts in with `derive(T, Copy, Clone)`, or `impl(T, Copy())`
// beside a `Clone` impl; the impl is checked (a `Clone` impl covers it,
// every part is `Copy`, no `Dispose`, never a reference
// type). The compiler never writes a `Clone` impl. `derive(T, Clone)` is
// always allowed, and a hand-written `Clone` is an error only on a type that
// is `Copy` for every instantiation the impl serves. `where(T <: Copy)` gives
// `T <: Clone` in a generic body. A tuple, an array, a closure, an anonymous
// record and a `fn` pointer are `Copy`, and `Clone`, exactly when all their
// parts are. Generation A does not flip the copy rule: a named plain-data
// type without `Copy` still copies implicitly here. Raw pointers appear in
// the prelude-impl test.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
_CtPoint :: struct(x : i32, y : i32);
derive(_CtPoint, Copy, Clone, Eq(_CtPoint));
// The derive registers `Clone` before `Copy`, whichever is written first: a
// derived clone is field-wise, which for Copy fields is the bitwise copy.
_CtBoth :: struct(n : i32);
derive(_CtBoth, Clone, Copy);
_CtCell :: struct(v : i32);
derive(_CtCell, Clone);
impl(_CtCell, Copy());
_CtDir :: enum(North, South);
derive(_CtDir, Copy, Clone);
_CtShape :: enum(Dot(at : _CtPoint), Empty);
derive(_CtShape, Copy, Clone);
_CtPair :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(a : T, b : T)
);
// Copy only under a bound, and a derived Clone for the instantiations that
// are not Copy (`_CtPair(String)`): the amended decision 36's spelling.
derive(generic(T : Type), where(T <: Clone), _CtPair(T), Clone);
derive(generic(T : Type), where(T <: Copy), _CtPair(T), Copy);
// A generic operator impl over a `Copy` bound: the by-value operand shape
// decision 34 allows for a `Copy` type.
impl(
  generic(T : Type),
  where(T <: Copy, T <: Eq(T)),
  _CtPair(T),
  Eq(_CtPair(T))(
    (==) : ((lhs, rhs) -> ((lhs.a == rhs.a) && (lhs.b == rhs.b))),
    (!=) : ((lhs, rhs) -> !(lhs == rhs))
  )
);
// The `Copy` impl of a struct may come before its fields' own `Copy` impls
// (plans/reference/LAZY_TOPLEVEL_BINDINGS.md): the field check forces them.
// A `derive` is an ordered statement, so the derived `Clone`s come first.
_CtSeg :: struct(from : _CtEnd, to : _CtEnd);
derive(_CtEnd, Clone);
derive(_CtSeg, Clone);
impl(_CtSeg, Copy());
_CtEnd :: struct(v : i32);
impl(_CtEnd, Copy());
// Plain data without `Copy`: still implicitly copied in Generation A.
_CtPlain :: struct(n : i32);
// `Clone` without `Copy`: the explicit-copy kind (decision 36).
derive(_CtPlain, Clone);
// No `Clone` at all (and so no `Copy`): what a tuple holding it is not.
_CtNoClone :: struct(n : i32);
// Rejected impls, each checked in a test below.
_CtLabel :: struct(id : i32, name : String);
_CtFd :: struct(fd : i32);
impl(
  _CtFd,
  Dispose(
    dispose : (fn(self : &Self) -> unit)(())
  )
);
_CtRef :: ref(struct(n : i32));
_CtCopied :: struct(n : i32);
derive(_CtCopied, Clone);
impl(_CtCopied, Copy());
_CtCloned :: struct(n : i32);
derive(_CtCloned, Clone);
impl(_CtCloned, Copy());
_CtHandle :: struct(n : i32);
impl(
  _CtHandle,
  Clone(
    clone : (fn(self : &mut Self) -> Self)(Self(n : self.n))
  )
);
_CtOpen :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(item : T)
);
// A hand-written generic Clone for every instantiation: an unbounded generic
// Copy impl over it is the error, checked in a test below.
_CtTag :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(id : i32)
);
impl(
  generic(T : Type),
  _CtTag(T),
  Clone(
    clone : (fn(self : &mut Self) -> Self)(Self(id : self.id))
  )
);
// No Clone: Copy is rejected on each, checked in a test below. The derive's
// rejection is pinned at module level: a derive inside a function body is
// skipped by the def-time trial (its registrations are module-level
// statements), so `comptime_expect_error` in a body would see no error.
_CtBare :: struct(n : i32);
comptime_expect_error(derive(_CtBare, Copy), "derive(_CtBare, Copy, Clone)");
_CtBareOf :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(item : T)
);
// A pointee field named like one of the pointer's own methods (`clone`, and
// `add`): the clash test. Decision 32's rule covers raw pointers (#1248): a
// member name the pointer and its pointee both have is an error, whatever
// the name.
_CtCloneField :: struct(clone : (fn() -> i32));
_ct_five :: (fn() -> i32)(i32(5));
_CtAddField :: struct(add : (fn() -> i32));
_ct_seven :: (fn() -> i32)(i32(7));
_ct_clone_any :: (fn(generic(T : Type), x : &T, where(T <: Clone)) -> T)(x.clone());
// `where(T <: Copy)` gives `T <: Clone` in the body (Copy's supertrait).
_ct_clone_copy :: (fn(generic(T : Type), x : T, where(T <: Copy)) -> T)(x.clone());
_CtUser :: struct(at : _CtPoint);
impl(
  _CtUser,
  moved : (fn(self : &Self) -> _CtPoint)(self.at.clone())
);
// ---------------------------------------------------------------------------
// The trait and the prelude's impls
// ---------------------------------------------------------------------------
test("Copy: the prelude's scalars, str, unit, raw pointers, Option and Result implement it, and Clone", {
  comptime_assert(Type.impls(i8, Copy) && Type.impls(i16, Copy) && Type.impls(i32, Copy) && Type.impls(i64, Copy), "signed integers");
  comptime_assert(Type.impls(u8, Copy) && Type.impls(u16, Copy) && Type.impls(u32, Copy) && Type.impls(u64, Copy), "unsigned integers");
  comptime_assert(Type.impls(usize, Copy) && Type.impls(isize, Copy), "pointer-sized integers");
  comptime_assert(Type.impls(f32, Copy) && Type.impls(f64, Copy), "floats");
  comptime_assert(Type.impls(bool, Copy) && Type.impls(char, Copy) && Type.impls(int, Copy), "bool, char and the C integers");
  comptime_assert(Type.impls(unit, Copy) && Type.impls(str, Copy), "unit and str views");
  comptime_assert(Type.impls(*i32, Copy) && Type.impls(*String, Copy), "a raw pointer, whatever it points at");
  comptime_assert(Type.impls(Option(i32), Copy), "Option of a Copy payload");
  comptime_assert(Type.impls(Result(i32, bool), Copy), "Result of Copy payloads");
  comptime_assert(!Type.impls(Option(String), Copy), "Option of a String is not");
  comptime_assert(!Type.impls(Result(i32, String), Copy), "Result with a String error is not");
  comptime_assert(!Type.impls(String, Copy), "String owns a buffer");
  comptime_assert(!Type.impls(ArrayList(i32), Copy), "a collection is never Copy");
  comptime_assert(!Type.impls(Rc(i32), Copy), "Rc is never Copy");
  comptime_assert(!Type.impls(Dyn(Clone), Copy), "Dyn is never Copy");
  comptime_assert(Type.impls(i8, Clone) && Type.impls(u64, Clone) && Type.impls(usize, Clone) && Type.impls(f64, Clone), "the integers and floats are Clone");
  comptime_assert(Type.impls(bool, Clone) && Type.impls(char, Clone) && Type.impls(longdouble, Clone) && Type.impls(unit, Clone), "bool, char, the C numbers and unit are Clone");
  comptime_assert(Type.impls(str, Clone) && Type.impls(*String, Clone), "str and a raw pointer are Clone");
  comptime_assert(Type.impls(Option(i32), Clone) && Type.impls(Result(i32, bool), Clone), "Option and Result of Copy payloads are Clone");
});
// ---------------------------------------------------------------------------
// Opting in
// ---------------------------------------------------------------------------
test("Copy: derive(T, Copy, Clone) and impl(T, Copy()) opt a struct, an enum and a generic type in", {
  comptime_assert(Type.impls(_CtPoint, Copy), "derive(_CtPoint, Copy, Clone)");
  comptime_assert(Type.impls(_CtCell, Copy), "impl(_CtCell, Copy())");
  comptime_assert(Type.impls(_CtDir, Copy), "a payload-free enum");
  comptime_assert(Type.impls(_CtShape, Copy), "an enum whose payloads are Copy");
  comptime_assert(Type.impls(_CtPair(i32), Copy), "a generic type over a Copy argument");
  comptime_assert(!Type.impls(_CtPair(String), Copy), "a generic type over a String argument is not");
  comptime_assert(Type.impls(_CtSeg, Copy) && Type.impls(_CtEnd, Copy), "a Copy impl before its fields' impls");
  comptime_assert(Type.impls(Option(_CtPoint), Copy), "Option of a derived Copy type");
});
test("Copy: a derive(T, Copy, Clone) value copies, and the copy is independent", {
  p := _CtPoint(x : i32(1), y : i32(2));
  q := p;
  q.x = i32(10);
  assert((p.x == i32(1)) && (q.x == i32(10)), "q is a copy of p");
  assert((p.y + q.y) == i32(4), "both stay usable");
  s := _CtShape.Dot(at : p);
  t := s;
  match(
    t,
    .Dot(at) => assert(at.x == i32(1), "the payload was copied"),
    .Empty => assert(false, "t is a Dot")
  );
});
// Generation B's flip: a plain-data type that is not `Copy` is copied
// explicitly. `b := a` moves `a`; `.clone()` is the copy.
_ct_take_plain :: (fn(sink(p) : _CtPlain) -> i32)(p.n);
test("Copy: a plain struct without Copy moves at q := p", {
  comptime_assert(!Type.impls(_CtPlain, Copy), "no Copy without an impl or a derive");
  comptime_expect_error({
    a := _CtPlain(n : i32(3));
    _b := a;
    _c := a.n;
  }, "use of moved value: `a`");
  comptime_expect_error({
    a := _CtPlain(n : i32(3));
    _b := a;
    _c := a.n;
  }, "derive(_CtPlain, Copy, Clone)");
  a := _CtPlain(n : i32(3));
  b := a.clone();
  c := a;
  assert((b.n + c.n) == i32(6), "the clone is the copy; the binding moved a");
});
test("Copy: a sink argument of a plain struct without Copy is a move", {
  comptime_expect_error({
    a := _CtPlain(n : i32(4));
    _n := _ct_take_plain(a);
    _m := a.n;
  }, "use of moved value: `a`");
  a := _CtPlain(n : i32(4));
  assert(_ct_take_plain(a.clone()) == i32(4), "a clone is passed, a stays");
  assert(a.n == i32(4), "a is still usable");
});
test("Copy: a Copy struct keeps copying implicitly after the flip", {
  p := _CtPoint(x : i32(1), y : i32(2));
  q := p;
  assert((p.x + q.y) == i32(3), "both stay usable");
});
test("Copy: a closure that only borrows its captures is Copy", {
  a := _CtPlain(n : i32(5));
  (f : Impl(Fn() -> i32)) = ({ a : &a }() => a.n);
  g := f;
  assert((f() + g()) == i32(10), "copying an imm-capture closure copies the borrow (decision 38 A)");
});
// ---------------------------------------------------------------------------
// Structural Copy
// ---------------------------------------------------------------------------
test("Copy: a tuple, an array, a fn pointer and an anonymous record are Copy and Clone when all their parts are", {
  comptime_assert(Type.impls(Tuple(i32, bool), Copy), "a tuple of Copy parts");
  comptime_assert(Type.impls(Tuple(_CtPoint, Option(i32)), Copy), "a tuple of derived Copy parts");
  comptime_assert(!Type.impls(Tuple(i32, String), Copy), "a tuple holding a String is not");
  comptime_assert(!Type.impls(Tuple(i32, _CtPlain), Copy), "a tuple holding a type without Copy is not");
  comptime_assert(Type.impls(Array(i32, 4), Copy), "an array of Copy elements");
  comptime_assert(!Type.impls(Array(String, 2), Copy), "an array of Strings is not");
  comptime_assert(Type.impls((fn(x : i32) -> i32), Copy), "a fn pointer is a code address");
  t := (i32(1), true);
  u := t;
  assert((t.0 + u.0) == i32(2), "a tuple of Copy parts copies implicitly");
  r := _(a : i32(1), b : i32(2));
  comptime_assert(Type.impls(type_of(r), Copy), "an anonymous record of Copy fields");
  comptime_assert(Type.impls(Tuple(i32, bool), Clone) && Type.impls(Tuple(i32, String), Clone), "a tuple of Clone parts is Clone");
  comptime_assert(!Type.impls(Tuple(i32, _CtNoClone), Clone), "a tuple holding a type without Clone is not");
  comptime_assert(Type.impls(Array(String, 2), Clone) && Type.impls((fn(x : i32) -> i32), Clone), "an array of Clone elements, a fn pointer");
  comptime_assert(Type.impls(type_of(r), Clone), "an anonymous record of Clone fields");
  w := t.clone();
  assert(w.0 == i32(1), "a tuple's clone, element-wise");
  ts := (String.from("a"), i32(2));
  tc := ts.clone();
  tc.0.push_str("b");
  assert((ts.0 == String.from("a")) && (tc.0 == String.from("ab")), "a tuple of a String clones its String");
  one := (i32(7),);
  assert(one.clone().0 == i32(7), "a one-element tuple");
});
test("Copy: a closure is Copy when all its captures are", {
  n := i32(2);
  (add_n : Impl(Fn(x : i32) -> i32)) = (x => (x + n));
  comptime_assert(Type.impls(type_of(add_n), Copy), "captures only an i32");
  g := add_n;
  assert((g(i32(1)) + add_n(i32(1))) == i32(6), "both copies call");
  label := String.from("k");
  (with_label : Impl(Fn() -> usize)) = (() => label.len());
  comptime_assert(!Type.impls(type_of(with_label), Copy), "a String capture is not Copy");
  comptime_assert(Type.impls(type_of(add_n), Clone) && Type.impls(type_of(with_label), Clone), "both are Clone: their captures are");
  assert(with_label() == usize(1), "the closure still runs");
});
// ---------------------------------------------------------------------------
// The impl check
// ---------------------------------------------------------------------------
test("Copy: Copy requires Clone, and derive(T, Copy) alone names derive(T, Copy, Clone)", {
  comptime_expect_error(impl(_CtBare, Copy()), "cannot implement \"Copy\" without \"Clone\"");
  comptime_expect_error(impl(generic(T : Type), where(T <: Copy), _CtBareOf(T), Copy()), "cannot implement \"Copy\" without \"Clone\"");
  comptime_assert(!Type.impls(_CtBare, Copy), "the rejected impls registered nothing (the derive's rejection is pinned at module level)");
});
test("Copy: an impl over a part that is not Copy names that part", {
  comptime_expect_error(impl(_CtLabel, Copy()), "its field `name` has type `String`");
  comptime_expect_error(impl(_CtPlainHolder, Copy()), "its field `inner` has type `_CtPlain`");
  comptime_expect_error(impl(generic(T : Type), _CtOpen(T), Copy()), "its field `item` has type `T`");
});
_CtPlainHolder :: struct(inner : _CtPlain);
test("Copy: Copy and Dispose exclude each other, in either order", {
  comptime_expect_error(impl(_CtFd, Copy()), "implements Dispose");
  comptime_expect_error(impl(_CtCopied, Dispose(dispose : (fn(self : Self) -> unit)(()))), "it implements Copy");
});
test("Copy: a reference type, a tuple and a blanket type parameter cannot declare Copy", {
  comptime_expect_error(impl(_CtRef, Copy()), "it is a reference type");
  comptime_expect_error(impl(generic(T : Type), T, Copy()), "only a value type");
});
// ---------------------------------------------------------------------------
// clone() on a Copy type is its Clone impl's
// ---------------------------------------------------------------------------
test("Copy: a Copy type clones through its Clone impl, and where(T <: Copy) gives T <: Clone", {
  comptime_assert(Type.impls(_CtPoint, Clone), "derive(_CtPoint, Copy, Clone)");
  comptime_assert(Type.impls(_CtPair(i32), Clone), "a generic Copy instance's derived Clone");
  comptime_assert(!Type.impls(_CtNoClone, Clone), "a type with neither has no clone()");
  p := _CtPoint(x : i32(4), y : i32(5));
  q := p.clone();
  assert(q == p, "the derived clone is the copy");
  c := _CtCell(v : i32(7)).clone();
  assert(c.v == i32(7), "an impl(T, Copy()) type with derive(T, Clone)");
  pr := _CtPair(i32)(a : i32(1), b : i32(2));
  assert(pr.clone() == pr, "a generic Copy instance, through the where(T <: Copy) Eq impl");
  xs := ArrayList(_CtPoint).new();
  xs.push(p);
  ys := xs.clone();
  assert(match(ys.get(usize(0)), .Some(e) => (e == p), .None => false), "ArrayList.clone over a Copy element");
  assert(_ct_clone_any(p) == p, "a where(T <: Clone) function accepts a Copy type");
  assert(_ct_clone_copy(p) == p, "a where(T <: Copy) body calls clone()");
  assert(_ct_clone_copy(i32(3)) == i32(3), "at a prelude Copy type");
  assert(_ct_clone_copy((i32(1), true)).0 == i32(1), "at a tuple, Copy structurally and Clone by the prelude's tuple impl");
  // `rc` takes its argument `own`, so it moves: wrap a clone, not `p`.
  b := rc(p.clone());
  assert(Rc.clone(b).* == p, "Rc.clone reaches the payload's clone");
  u := _CtUser(at : p);
  assert(u.moved() == p, "clone() inside another type's method");
  s := "abc";
  assert(s.clone() == "abc", "a str view clones as itself");
  n := i32(9);
  np := addr_of(n);
  (npc : *i32) = np.clone();
  assert(npc == np, "a raw pointer clones the address, not the pointee");
});
test("Copy: a pointee field named like a pointer method clashes at p.m(...)", {
  h := _CtCloneField(clone : _ct_five);
  hp := addr_of(h);
  comptime_expect_error(hp.clone(), "is both a field of _CtCloneField and a method of the raw pointer");
  assert(hp.*.clone() == i32(5), "p.*.clone() calls the pointee's field");
  hq := hp;
  assert(hq == hp, "q := p copies the pointer");
  a := _CtAddField(add : _ct_seven);
  ap := addr_of(a);
  comptime_expect_error(ap.add(usize(1)), "is both a field of _CtAddField and a method of the raw pointer");
  assert(ap.*.add() == i32(7), "p.*.add() calls the pointee's field, not the pointer's offset");
});
test("Copy: derive(T, Clone) is accepted beside Copy, in either order", {
  comptime_assert(Type.impls(_CtBoth, Copy) && Type.impls(_CtBoth, Clone), "derive(_CtBoth, Clone, Copy)");
  comptime_assert(Type.impls(_CtCloned, Copy) && Type.impls(_CtCloned, Clone), "derive(_CtCloned, Clone), then impl(_CtCloned, Copy())");
  b := _CtBoth(n : i32(3));
  c := b;
  assert((b.clone().n + c.n) == i32(6), "the derived clone and the copy agree");
});
test("Copy: a type Copy only under a bound copies at i32 and clones at String", {
  pi := _CtPair(i32)(a : i32(1), b : i32(2));
  qi := pi;
  qi.a = i32(5);
  assert((pi.a == i32(1)) && (qi.a == i32(5)), "_CtPair(i32) is Copy: an implicit, independent copy");
  ps := _CtPair(String)(a : String.from("x"), b : String.from("y"));
  qs := ps.clone();
  qs.a.push_str("z");
  assert((ps.a == String.from("x")) && (qs.a == String.from("xz")), "_CtPair(String) is not Copy: an explicit .clone() through the derived Clone");
  comptime_assert(!Type.impls(_CtPair(String), Copy) && Type.impls(_CtPair(String), Clone), "_CtPair(String) is Clone only");
});
test("Copy: the prelude Option(i32) stays Copy with its generic Clone", {
  comptime_assert(Type.impls(Option(i32), Copy) && Type.impls(Option(i32), Clone), "Copy and its conditional Clone");
  o := Option(i32).Some(i32(4));
  p := o;
  assert(match(o.clone(), .Some(v) => (v == i32(4)), .None => false) && p.is_some(), "Option(i32) copies and clones");
});
test("Copy: a hand-written Clone on a type Copy for every instantiation is an error, in either order", {
  comptime_expect_error(impl(_CtPoint, Clone(clone : (fn(self : &mut Self) -> Self)(self))), "Write derive(_CtPoint, Clone) instead");
  comptime_expect_error(impl(_CtHandle, Copy()), "a hand-written Clone impl can only repeat it or contradict it");
  comptime_expect_error(impl(generic(T : Type), _CtTag(T), Copy()), "a hand-written Clone impl can only repeat it or contradict it");
});

// ============================================================================
// Generation B: structural clone() and the derived clone of Copy fields
// ============================================================================
// A `fn` pointer, a closure whose captures are all `Copy` and an anonymous
// record whose fields are, are `Copy` structurally. No impl can name them, so
// `x.clone()` expands to the copy
// (issues/structural-clone-has-no-clone-method-on-records-closures-and-fn-pointers.md).
_ct_sclone :: (fn(generic(T : Type), x : &T, where(T <: Clone)) -> T)(x.clone());
test("Copy: a fn pointer, a Copy closure and a Copy anonymous record clone as the copy", {
  f := _ct_seven;
  g := f.clone();
  assert(g() == i32(7), "a fn pointer's clone calls the same function");
  k := i32(5);
  (c : Impl(Fn() -> i32)) = (() => (k + i32(1)));
  d := c.clone();
  assert(d() == i32(6), "a closure of Copy captures clones as its copy");
  r := _(a : i32(1), b : i32(2));
  s := r.clone();
  assert((s.a + s.b) == i32(3), "an anonymous record of Copy fields clones as its copy");
});
test("Copy: a where(T <: Clone) body clones a fn pointer and an anonymous record", {
  h := _ct_sclone(_ct_seven);
  assert(h() == i32(7), "T := fn() -> i32");
  t := _ct_sclone(_(a : i32(4), b : true));
  assert((t.a == i32(4)) && t.b, "T := the record type");
});
// A struct of `fn` pointers (the shape of the prelude's `Io`) derives `Copy`
// and `Clone`: the derived clone's `self.get.clone()` is the structural clone.
_CtOps :: struct(get : (fn() -> i32), n : i32);
derive(_CtOps, Copy, Clone);
test("Copy: a struct of fn pointers derives Copy and Clone", {
  comptime_assert(Type.impls(_CtOps, Copy) && Type.impls(_CtOps, Clone), "derive(_CtOps, Copy, Clone)");
  o := _CtOps(get : _ct_seven, n : i32(2));
  p := o.clone();
  q := o;
  assert((p.get() + p.n) == i32(9), "the derived clone copies each field");
  assert(q.get() == i32(7), "and the implicit copy agrees");
});
// A conditional `Clone` impl holds only for type arguments that are `Clone`:
// its `where(T <: Clone)` names no type parameter of the impl inside the
// trait, so the trait predicate enforces it
// (issues/fixed/a-conditional-clone-impl-answers-yes-for-a-type-argument-without-clone.md).
_CtWrap :: (fn(comptime(T) : Type) -> comptime(Type))(struct(v : T));
derive(generic(T : Type), where(T <: Clone), _CtWrap(T), Clone);
_CtHand :: (fn(comptime(T) : Type) -> comptime(Type))(struct(v : T));
impl(generic(T : Type), where(T <: Clone), _CtHand(T), Clone(clone : (fn(self : &mut Self) -> Self)(Self(v : self.v.clone()))));
test("Clone: a conditional Clone impl answers no for a type argument without Clone", {
  comptime_assert(!Type.impls(_CtNoClone, Clone), "_CtNoClone has no Clone");
  comptime_assert(!Type.impls(_CtWrap(_CtNoClone), Clone), "a derived conditional Clone");
  comptime_assert(!Type.impls(_CtHand(_CtNoClone), Clone), "a hand-written conditional Clone");
  comptime_assert(!Type.impls(Option(_CtNoClone), Clone), "the prelude's Option");
  // Over-rejection canaries: a Clone argument still answers yes.
  comptime_assert(Type.impls(_CtWrap(i32), Clone) && Type.impls(_CtWrap(String), Clone), "_CtWrap of a Clone type");
  comptime_assert(Type.impls(_CtHand(_CtPlain), Clone), "_CtHand of a Clone struct");
  comptime_assert(Type.impls(Option(String), Clone) && Type.impls(Option(Option(i32)), Clone), "Option of Clone types");
  w := _CtWrap(String)(v : `hi`);
  w2 := w.clone();
  assert(w2.v == `hi`, "the derived clone runs");
});
