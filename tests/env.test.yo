pragma(Pragma.SkipWasm32Wasi); // environment variables require explicit WASI grants
{ assert } :: import("std/assert");
open(import("std/process"));
open(import("std/env"));
open(import("std/string"));
open(import("std/fmt"));
test("env.get returns Some for existing environment variable", {
  // PATH should exist on any Unix-like system
  result := env.get(`PATH`);
  assert(result.is_some(), "Expected PATH to exist");
});
test("env.get returns None for non-existent environment variable", {
  result := env.get(`YO_TEST_NONEXISTENT_VAR_12345`);
  assert(result.is_none());
});
test("env.set creates new environment variable", {
  var_name := `YO_TEST_NEW_VAR`;
  var_value := `test_value_123`;
  // Set the variable
  success := env.set(var_name, var_value);
  assert(success, "env.set should return true");
  // Verify it was set
  result := env.get(var_name);
  match(
    result,
    .Some(value) => {
      assert(value == var_value, "Expected value to match");
    },
    .None => assert(false, "Expected variable to be set")
  );
});
test("env.set overwrites existing variable by default", {
  var_name := `YO_TEST_OVERWRITE_VAR`;
  initial_value := `initial_value`;
  new_value := `new_value`;
  // Set initial value
  env.set(var_name, initial_value);
  // Overwrite with new value (default overwrite=true)
  success := env.set(var_name, new_value);
  assert(success, "env.set should return true");
  // Verify it was overwritten
  result := env.get(var_name);
  match(
    result,
    .Some(value) => {
      assert(value == new_value, "Expected value to be overwritten");
    },
    .None => assert(false, "Expected variable to exist")
  );
});
test("env.set with overwrite=false preserves existing variable", {
  var_name := `YO_TEST_NO_OVERWRITE_VAR`;
  initial_value := `keep_this_value`;
  new_value := `should_not_appear`;
  // Set initial value
  env.set(var_name, initial_value);
  // Try to overwrite with overwrite=false
  env.set(var_name, new_value, overwrite : false);
  // Verify original value is preserved
  result := env.get(var_name);
  match(
    result,
    .Some(value) => {
      assert(value == initial_value, "Expected original value to be preserved");
    },
    .None => assert(false, "Expected variable to exist")
  );
});
test("env.set with overwrite=true replaces existing variable", {
  var_name := `YO_TEST_EXPLICIT_OVERWRITE_VAR`;
  initial_value := `old_value`;
  new_value := `new_value`;
  // Set initial value
  env.set(var_name, initial_value);
  // Explicitly overwrite
  success := env.set(var_name, new_value, overwrite : true);
  assert(success, "env.set should return true");
  // Verify it was overwritten
  result := env.get(var_name);
  match(
    result,
    .Some(value) => {
      assert(value == new_value, "Expected value to be overwritten");
    },
    .None => assert(false, "Expected variable to exist")
  );
});
test("env.set and env.get work with empty string values", {
  var_name := `YO_TEST_EMPTY_VAR`;
  empty_value := ``;
  cond(
    (platform == Platform.Windows) => {
      // Windows doesn't support empty environment variable values
      // Setting to empty string removes the variable
      // So we skip this test on Windows
      println(`Skipping empty string test on Windows (not supported)`);
    },
    true => {
      // Set empty string
      success := env.set(var_name, empty_value);
      assert(success, "env.set should return true for empty string");
      // Verify empty string is retrieved
      result := env.get(var_name);
      match(
        result,
        .Some(value) => {
          assert(value == empty_value, "Expected empty string value");
        },
        .None => assert(false, "Expected variable to exist with empty value")
      );
    }
  );
});
test("env.set and env.get work with special characters", {
  var_name := `YO_TEST_SPECIAL_VAR`;
  special_value := `value with spaces and symbols: !@#$%^&*()`;
  // Set value with special characters
  success := env.set(var_name, special_value);
  assert(success, "env.set should return true");
  // Verify special characters are preserved
  result := env.get(var_name);
  match(
    result,
    .Some(value) => {
      assert(value == special_value, "Expected special characters to be preserved");
    },
    .None => assert(false, "Expected variable to exist")
  );
});
test("env.get and env.set work with UTF-8 strings", {
  var_name := `YO_TEST_UTF8_VAR`;
  utf8_value := `Hello 世界 🌍`;
  // Set UTF-8 value
  success := env.set(var_name, utf8_value);
  assert(success, "env.set should return true for UTF-8");
  // Verify UTF-8 is preserved
  result := env.get(var_name);
  match(
    result,
    .Some(value) => {
      assert(value == utf8_value, "Expected UTF-8 to be preserved");
    },
    .None => assert(false, "Expected variable to exist")
  );
});
test("multiple env.set calls on same variable with overwrite=false", {
  var_name := `YO_TEST_MULTI_SET_VAR`;
  first_value := `first`;
  second_value := `second`;
  third_value := `third`;
  // Set initial value
  env.set(var_name, first_value);
  // Try to set multiple times with overwrite=false
  env.set(var_name, second_value, overwrite : false);
  env.set(var_name, third_value, overwrite : false);
  // Should still have first value
  result := env.get(var_name);
  match(
    result,
    .Some(value) => {
      assert(value == first_value, "Expected first value to remain");
    },
    .None => assert(false, "Expected variable to exist")
  );
});
// ============================================================
// cwd and chdir tests
// ============================================================
test("cwd returns a valid absolute path", {
  result := cwd();
  match(
    result,
    .Ok(path) => {
      // cwd should return an absolute path
      assert(path.is_absolute(), "cwd should return an absolute path");
      // The path should not be empty
      path_str := path.to_string();
      assert(path_str.len() > usize(0), "cwd path should not be empty");
      println(`cwd: ${path_str}`);
    },
    .Err(msg) => {
      // This should not happen on a normal system
      println(`Error: ${msg.to_string()}`);
      assert(false, "cwd should not fail");
    }
  );
});
test("chdir changes directory and cwd reflects the change", {
  { Path } :: import("std/path");
  // Get the original directory
  original_result := cwd();
  match(
    original_result,
    .Err(msg) => {
      println(`Error getting original cwd: ${msg.to_string()}`);
      assert(false, "Failed to get original cwd");
    },
    .Ok(original_path) => {
      println(`Original cwd: ${original_path.to_string()}`);
      // Change to parent directory (safer than temp which might not exist)
      parent_opt := original_path.parent();
      match(
        parent_opt,
        .None => {
          println(`No parent directory available, skipping test`);
        },
        .Some(parent_path) => {
          chdir_result := chdir(parent_path);
          match(
            chdir_result,
            .Err(msg) => {
              println(`Error changing directory: ${msg.to_string()}`);
              assert(false, "Failed to change directory to parent");
            },
            .Ok(_) => {
              // Verify the change
              new_cwd_result := cwd();
              match(
                new_cwd_result,
                .Err(msg) => {
                  println(`Error getting new cwd: ${msg.to_string()}`);
                  assert(false, "Failed to get new cwd");
                },
                .Ok(new_path) => {
                  println(`New cwd: ${new_path.to_string()}`);
                  // Just verify we changed to some directory (don't check exact path due to symlinks etc)
                  assert(new_path.is_absolute(), "New cwd should be absolute");
                }
              );
              // Change back to original directory
              restore_result := chdir(original_path);
              match(
                restore_result,
                .Err(msg) => {
                  println(`Error restoring directory: ${msg.to_string()}`);
                  assert(false, "Failed to restore original directory");
                },
                .Ok(_) => {
                  // Verify we're back
                  final_cwd_result := cwd();
                  match(
                    final_cwd_result,
                    .Err(msg) => {
                      println(`Error getting final cwd: ${msg.to_string()}`);
                      assert(false, "Failed to get final cwd");
                    },
                    .Ok(final_path) => {
                      println(`Restored cwd: ${final_path.to_string()}`);
                      assert(final_path == original_path, "cwd should be restored to original");
                    }
                  );
                }
              );
            }
          );
        }
      );
    }
  );
});
test("chdir fails for non-existent directory", {
  { Path } :: import("std/path");
  nonexistent := Path.new(`/this/path/should/not/exist/12345`);
  result := chdir(nonexistent);
  match(
    result,
    .Ok(_) => {
      assert(false, "chdir should fail for non-existent directory");
    },
    .Err(err) => {
      // The error is structured now, not prose: a missing directory is
      // ENOENT on POSIX and ERROR_PATH_NOT_FOUND on Win32, and both must
      // report exactly `IoError.NotFound` (Rust's `ErrorKind::NotFound`).
      // Before this was `Result(_, String)` and a caller could only
      // string-match the message.
      println(`Expected error: ${err.to_string()}`);
      assert(
        match(err, .NotFound => true, _ => false),
        `chdir to a missing directory must be IoError.NotFound, got ${err.to_string()}`
      );
    }
  );
});
test("chdir reports the REAL errno, not a single catch-all error", {
  // Distinguishes `IoError.NotADirectory` (ENOTDIR) from the `NotFound`
  // above. Two different failures mapping to two different variants is what
  // proves `errno` is actually read — and read BEFORE the `free()` in the
  // error path, which would otherwise clobber it.
  match(
    current_exe(),
    // wasm has no current_exe; nothing to point chdir at.
    .Err(_) => {},
    .Ok(exe_path) => {
      // The running test binary is a FILE, so chdir into it is ENOTDIR.
      result := chdir(exe_path);
      match(
        result,
        .Ok(_) => assert(false, "chdir into a regular file must fail"),
        .Err(err) => {
          // The SAME variant on every platform: POSIX reports ENOTDIR,
          // Win32 reports ERROR_DIRECTORY (267), and both classify to
          // NotADirectory. A structured error that named the failure
          // differently per platform would not be worth having.
          assert(
            match(err, .NotADirectory => true, _ => false),
            `chdir into a file must be IoError.NotADirectory, got ${err.to_string()}`
          );
        }
      );
    }
  );
});
test("current_exe returns an absolute path to an existing executable", {
  result := current_exe();
  match(
    result,
    .Ok(exe_path) => {
      exe_str := exe_path.to_string();
      assert(exe_str.len() > usize(0), "executable path should be non-empty");
      assert(exe_str.starts_with(`/`) || (platform == Platform.Windows), "executable path should be absolute");
    },
    .Err(msg) => {
      // Only wasm targets are allowed to lack current_exe support.
      assert(
        (platform == Platform.Emscripten) || (platform == Platform.Wasi),
        `current_exe failed on a native platform: ${msg.to_string()}`
      );
    }
  );
});
// ===== quick-wins row: remove / vars / str keys =====
test("env.remove unsets a variable", {
  _s := env.set("YO_QW_REMOVE_ME", "gone");
  assert(env.get("YO_QW_REMOVE_ME").is_some(), "set first");
  ok := env.remove("YO_QW_REMOVE_ME");
  assert(ok, "remove returns true");
  assert(env.get("YO_QW_REMOVE_ME").is_none(), "gone after remove");
});
test("env.remove of a never-set variable is still success", {
  assert(env.remove("YO_QW_NEVER_SET_98765"), "idempotent per unsetenv");
});
test("env keys and values accept str and String", {
  _a := env.set("YO_QW_STR_KEY", "str value");
  b := env.get("YO_QW_STR_KEY").unwrap_or(String.from("?"));
  assert(b == "str value", "str key + str value");
  _c := env.set(String.from("YO_QW_STR_KEY"), String.from("string value"));
  d := env.get(String.from("YO_QW_STR_KEY")).unwrap_or(String.from("?"));
  assert(d == "string value", "String key + String value");
  _r := env.remove("YO_QW_STR_KEY");
});
test("env.vars lists every variable as key/value pairs", {
  _s := env.set("YO_QW_VARS_PAIR", "pair-value");
  all := env.vars();
  found := false;
  found_path := false;
  i := usize(0);
  while(i < all.len(), i = (i + usize(1)), {
    kv := all(i);
    cond(
      (kv._0 == "YO_QW_VARS_PAIR") => {
        found = (kv._1 == "pair-value");
      },
      (kv._0 == "PATH") => {
        found_path = true;
      },
      true => ()
    );
  });
  assert(found, "the variable we set is present with its value");
  assert(found_path, "PATH is present");
  _r := env.remove("YO_QW_VARS_PAIR");
});
