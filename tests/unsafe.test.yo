pragma(Pragma.AllowUnsafe);
{ assert, panic } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
import("std/libc/stdio.yo");

/// Tests for the `unsafe(...)` builtin (Phase A of plans/reference/MEMORY_SAFETY.md).
///
/// `unsafe(expr)` is a compile-time marker that permits pointer
/// dereference and arithmetic inside `expr`. Outside `unsafe(...)`,
/// those operations are compile errors.
///
/// NOTE: This file lives under `tests/` which is currently treated as
/// implicitly unsafe-capable while Phase C (the pragma mechanism) is
/// pending. Pointer ops therefore work without explicit wraps here
/// too. The tests below explicitly *use* `unsafe(...)` to verify the
/// builtin behaves as designed (transparent compile-time marker, no
/// runtime cost).
test("unsafe(p.*) reads through a pointer", {
  x := i32(42);
  p := addr_of(x);
  v := unsafe(p.*);
  assert(v == i32(42), "deref via unsafe");
});

test("unsafe(p.* = v) writes through a pointer", {
  x := i32(0);
  p := addr_of(x);
  unsafe(p.* = i32(100));
  assert(x == i32(100), "write via unsafe deref");
});

test("unsafe(p &+ n) does pointer arithmetic", {
  x := i32(7);
  p := addr_of(x);
  q := unsafe(p.add(usize(0)));
  assert(p == q, "pointer + 0 is same address");
});

test("unsafe(...) accepts a begin-block with semicolons", {
  x := i32(0);
  p := addr_of(x);
  unsafe({
    p.* = i32(11);
    p.* = (p.* + i32(31));
  });
  assert(x == i32(42), "begin-block writes propagate");
});

test("unsafe(...) is transparent — returns the inner value", {
  x := i32(5);
  p := addr_of(x);
  doubled := unsafe(p.* * i32(2));
  assert(doubled == i32(10), "value/type passes through unsafe");
});

test("nested unsafe(unsafe(...)) is permitted", {
  x := i32(9);
  p := addr_of(x);
  v := unsafe(unsafe(p.*));
  assert(v == i32(9), "nested unsafe deref");
});

test("unsafe(cond(...)) wraps a cond without braces", {
  x := i32(3);
  p := addr_of(x);
  fallback := i32(0);
  v := unsafe(
    cond(
      (x > i32(0)) => p.*,
      true => fallback
    )
  );
  assert(v == i32(3), "cond inside unsafe");
});

test("unsafe(match(...)) wraps a match", {
  y := i32(77);
  ptr_opt := Option(*i32).Some(addr_of(y));
  fallback := i32(0);
  v := unsafe(
    match(
      ptr_opt,
      .Some(p) => p.*,
      .None => fallback
    )
  );
  assert(v == i32(77), "match inside unsafe");
});

// `___drop(place)` and `drop_in_place(p)` run a destructor in place, without
// moving the value out. Both need an unsafe-capable file: in safe code
// `___drop(h.xs)` left a field readable after its buffer was freed
// (issues/fixed/2026-10-21-the-drop-builtin-is-callable-outside-unsafe.md;
// the rejection is pinned in tests/safe_code_structural_gates.test.yo).
{ malloc, free } :: import("std/libc/stdlib.yo");
mut(DROPPED_IDS) := i32(0);
Tracked :: struct(id : i32);
impl(
  Tracked,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      DROPPED_IDS = (DROPPED_IDS + self.id);
    })
  )
);
TrackedHolder :: struct(t : Tracked);

test("unsafe(___drop(h.t)) runs a field's destructor in place", {
  DROPPED_IDS = i32(0);
  mut(h) := TrackedHolder(t : Tracked(id : i32(5)));
  unsafe(___drop(h.t));
  assert(DROPPED_IDS == i32(5), "the field's destructor ran once");
  // The slot is dead now: initialize it again without dropping it, so the
  // holder's own drop at scope end destroys the new value.
  slot := addr_of(h.t);
  unsafe(consume(slot.* = Tracked(id : i32(100))));
});

test("drop_in_place(p) destroys the value a raw pointer owns", {
  DROPPED_IDS = i32(0);
  raw := unsafe(malloc(size_of(Tracked)));
  slot := match(raw, .Some(r) => (*Tracked)(r), .None => panic("malloc failed"));
  unsafe(consume(slot.* = Tracked(id : i32(7))));
  unsafe(drop_in_place(slot));
  assert(DROPPED_IDS == i32(7), "drop_in_place ran the destructor once");
  unsafe(free(.Some((*void)(slot))));
  assert(DROPPED_IDS == i32(7), "freeing the dead slot runs nothing");
});

// The gate asks where `___drop` is WRITTEN, not whether the call runs under
// `unsafe(...)`: a generic body is evaluated at its call site, so wrapping a
// call into a safe file's generic function must not admit the `___drop` that
// file contains.
{ destroy_field_then_read } :: import("./fixtures/drop_gate_generic.yo");
test("unsafe(...) around a call does not admit ___drop written in a safe file", {
  comptime_expect_error({
    n := unsafe(destroy_field_then_read(i32(0)));
    n
  }, "'___drop(...)' is not available in safe code");
});

test("drop_in_place releases what the pointee owns", {
  raw := unsafe(malloc(size_of(ArrayList(String))));
  slot := match(raw, .Some(r) => (*ArrayList(String))(r), .None => panic("malloc failed"));
  unsafe(consume(slot.* = ArrayList(String).new()));
  unsafe(slot.*.push(String.from("owned by the slot")));
  assert(unsafe(slot.*.len()) == usize(1), "the slot holds one string");
  unsafe(drop_in_place(slot));
  unsafe(free(.Some((*void)(slot))));
});
