//! A `Waker` fired from ANOTHER OS thread resumes the parked task ON ITS OWN
//! LOOP.
//!
//! Step 5 of `plans/archive/WAKER_BASED_SCHEDULING.md`. Before it, a wake raised off
//! the loop's own thread had nowhere safe to put the continuation —
//! `__yo_async_enqueue_continuation` writes a THREAD-LOCAL queue — so it went
//! onto the WAKER's queue and the suspended task was resumed by the worker
//! thread, running the loop's state on a thread that does not own it. Each
//! loop now owns one explicitly locked inbox plus a wakeup channel into its
//! own I/O backend; the token — never the future, and never a reference count
//! — is what crosses.
//!
//! **The oracle is the thread identity, not the value.** Measured with an
//! emitted-C A/B (disable the cross-thread post, re-clang, re-run): the value
//! arrives either way, and `same_thread` flips from true to false. A test that
//! only checked the value would have passed over the bug it exists for.
//!
//! **And the park must be awaited from inside a SPAWNED task.** A blocking
//! `io.await` in `main` is a poll loop over the future's state word, which a
//! foreign CAS satisfies directly — no continuation, nothing for the inbox to
//! carry. That is the risk this document's §"Risks" names first.
//!
//! `Waker` is a move-only value that is `Send`, which is what lets it be moved
//! into a `Thread(unit).spawn` closure at all. `Park` is not, and should not
//! be: it belongs to the loop that created it.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ Park, yield_now } :: import("std/async/waker");
{ IoFuture } :: import("std/sys/future");
{ __yo_async_park_start, __yo_waker_new, __yo_waker_wake, __yo_waker_release, __yo_waker_clone } :: import("std/sys/externs");
{ Thread, get_thread_id, spawn_blocking } :: import("std/thread");
{ AtomicI32, AtomicUsize, MemoryOrder } :: import("std/sync/atomic");
{ Duration } :: import("std/time/duration");
{ sleep_blocking } :: import("std/time/sleep");
/// A waker handle over the runtime's waker calls, for the tests that need the
/// owner and a worker to each hold a handle on ONE token. It is std's `Waker`
/// plus `clone_handle`: Generation A of `Waker.clone`
/// (plans/VALUES_BY_DEFAULT.md §3.13 A5). The runtime has `__yo_waker_clone`;
/// std's `impl(Waker, Clone)` lands once `SEED_VERSION` carries it, and these
/// tests then go back to `Park` and `w.clone()`.
_RawWaker :: struct(_p : *u8);
// SAFETY: as std's `Waker`: every runtime call on the token is thread-safe
// (rule D7).
impl(_RawWaker, Send());
impl(_RawWaker, Sync());
impl(
  _RawWaker,
  /// A pending park future and the first handle on its token.
  park : (fn() -> Tuple(IoFuture, _RawWaker))({
    f := unsafe(__yo_async_park_start());
    w := _RawWaker(_p : unsafe(__yo_waker_new(&f)));
    (f, w)
  }),
  wake : (fn(self : &Self) -> unit)(unsafe(__yo_waker_wake(self._p))),
  /// Another handle on the same token.
  clone_handle : (fn(self : &Self) -> Self)(Self(_p : unsafe(__yo_waker_clone(self._p))))
);
impl(_RawWaker, Dispose(dispose : (fn(self : &Self) -> unit)(unsafe(__yo_waker_release(self._p)))));
test("a waker fired from another OS thread resumes its task on the owning loop", {
  p := Park.new();
  w := p.waker();
  stamped := AtomicI32(i32(0));
  resumed_on := AtomicUsize.new(usize(0));
  main_tid := get_thread_id();
  h := io.spawn(
    io.async({ p, resumed_on, stamped }(io : Io) => {
      io.await(p.wait(io), io);
      resumed_on.store(get_thread_id(), MemoryOrder.Release);
      _a := stamped.fetch_add(i32(100), MemoryOrder.AcqRel);
      i32(0)
    }),
    io
  );
  t := Thread(unit).spawn((tio : Io) => {
    // Genuinely blocking, on its own thread: the loop has no I/O and no
    // runnable task for these 50 ms, so it must wait rather than conclude
    // it has nothing left to do.
    sleep_blocking(Duration.from_millis(i64(50)));
    _b := stamped.fetch_add(i32(7), MemoryOrder.AcqRel);
    w.wake();
    ()
  });
  _r := h.await(io);
  assert(stamped.load(MemoryOrder.Acquire) == i32(107), "the worker ran and the task resumed");
  assert(
    resumed_on.load(MemoryOrder.Acquire) == main_tid,
    "the task resumed on the loop that owns it, not on the thread that woke it"
  );
  t.join();
});
test("two parks woken from two different threads", {
  p1 := Park.new();
  p2 := Park.new();
  w1 := p1.waker();
  w2 := p2.waker();
  order := AtomicI32(i32(0));
  main_tid := get_thread_id();
  both_on_main := AtomicI32(i32(0));
  h1 := io.spawn(
    io.async({ p1, main_tid, both_on_main, order }(io : Io) => {
      io.await(p1.wait(io), io);
      if(get_thread_id() == main_tid, {
        _x := both_on_main.fetch_add(i32(1), MemoryOrder.AcqRel);
      });
      _a := order.fetch_add(i32(1), MemoryOrder.AcqRel);
      i32(0)
    }),
    io
  );
  h2 := io.spawn(
    io.async({ p2, main_tid, both_on_main, order }(io : Io) => {
      io.await(p2.wait(io), io);
      if(get_thread_id() == main_tid, {
        _y := both_on_main.fetch_add(i32(1), MemoryOrder.AcqRel);
      });
      _b := order.fetch_add(i32(10), MemoryOrder.AcqRel);
      i32(0)
    }),
    io
  );
  t1 := Thread(unit).spawn((tio : Io) => {
    sleep_blocking(Duration.from_millis(i64(20)));
    w1.wake();
    ()
  });
  t2 := Thread(unit).spawn((tio : Io) => {
    sleep_blocking(Duration.from_millis(i64(40)));
    w2.wake();
    ()
  });
  _r1 := h1.await(io);
  _r2 := h2.await(io);
  assert(order.load(MemoryOrder.Acquire) == i32(11), "both wakes arrived");
  assert(both_on_main.load(MemoryOrder.Acquire) == i32(2), "both tasks resumed on the owning loop");
  t1.join();
  t2.join();
});
test("a wake that arrives BEFORE the task suspends is not lost", {
  // The classic ordering trap from the other side. `wake` completes the park
  // future, and an await point reads the future's state before registering a
  // continuation, so an already-woken park resumes inline instead of
  // suspending forever.
  p := Park.new();
  w := p.waker();
  t := Thread(unit).spawn((tio : Io) => {
    w.wake();
    ()
  });
  t.join();
  ran := AtomicI32(i32(0));
  h := io.spawn(
    io.async({ p, ran }(io : Io) => {
      io.await(p.wait(io), io);
      _a := ran.fetch_add(i32(1), MemoryOrder.AcqRel);
      i32(0)
    }),
    io
  );
  _r := h.await(io);
  assert(ran.load(MemoryOrder.Acquire) == i32(1), "the early wake was observed rather than lost");
});
test("a wake posted before the owner drops its waker handle still resumes the park", {
  // REGRESSION (issues/fixed/a-foreign-wake-queued-before-the-owner-drops-its-waker-is-lost.md).
  // The worker wakes FIRST — its wake sits on the owner's inbox — and only
  // then does the owner drop its own handle on the token (the worker holds a
  // clone, so the owner's is the last handle). The local release
  // used to null the token's future, so the drain skipped the queued wake and
  // the park never resumed: the loop spun forever with nothing pending. This
  // is spawn_blocking's shape whenever the loop thread is descheduled right
  // after pthread_create (a loaded CI runner, about one time in four; the
  // macOS test leg's four-hour hang). The join makes the ordering
  // deterministic, so this fails every time on the unfixed runtime.
  (round : i32) = i32(0);
  while(runtime(round < i32(5)), {
    pw := _RawWaker.park();
    match(
      pw,
      (f, w) => {
        {
          wc := w.clone_handle();
          worker := Thread(unit).spawn({ wc }(tio : Io) => {
            wc.wake();
            ()
          });
          worker.join();
          _owner := w;
        };
        io.await(f, io);
      }
    );
    round = (round + i32(1));
  });
  assert(round == i32(5), "every park whose wake preceded the owner's release resumed");
});
test("the common ordering — owner drops its waker handle first, worker wakes later — still resumes promptly", {
  // The over-rejection canary for the fix above: this is the FOREIGN release
  // path (the frame's handle is gone before the wake arrives), which must stay
  // as fast as before — a fix that made every local release defer would pass
  // the previous test while pessimising this one.
  (round : i32) = i32(0);
  while(runtime(round < i32(5)), {
    pw := _RawWaker.park();
    match(
      pw,
      (f, w) => {
        {
          wc := w.clone_handle();
          _owner := w;
          _worker := Thread(unit).spawn({ wc }(tio : Io) => {
            sleep_blocking(Duration.from_millis(i64(5)));
            wc.wake();
            ()
          });
        };
        io.await(f, io);
      }
    );
    round = (round + i32(1));
  });
  assert(round == i32(5), "every park woken after the owner's release resumed");
});
// Rule D7 (plans/reference/PARALLELISM_RULES.md): `spawn_blocking` from a task
// on a SPAWNED thread. Its worker wakes the park, ends the blocking bracket,
// and only THEN drops its captured `Waker` — a foreign release into a loop
// that has nothing else left. Before the fix that release decremented the
// loop's live-waker count before posting, so the spawned thread's loop could
// exit and die (it is a _Thread_local) with the post still on its way in
// (issues/fixed/a-foreign-waker-release-can-post-into-a-loop-whose-thread-has-exited.md).
// The window is a few instructions wide, so this is a stress shape: one
// exposure per iteration, and the Linux ASan leg is the oracle for the
// use-after-free. The count checks every iteration completed — a release the
// drain failed to consume would now hang the loop instead of leaking silently
// (issues/fixed/a-foreign-waker-release-racing-the-owners-drain-leaks-the-park-future.md).
test("spawn_blocking from a task on a spawned thread, 2000 times: each loop outlives the release posted into it", {
  total := AtomicI32(i32(0));
  (i : i32) = i32(0);
  while(runtime(i < i32(2000)), {
    t := Thread(unit).spawn((io : Io) => {
      v := io.await(spawn_blocking(() => i32(1), io), io);
      _n := total.fetch_add(v, MemoryOrder.AcqRel);
      ()
    });
    t.join();
    i = (i + i32(1));
  });
  assert(total.load(MemoryOrder.Acquire) == i32(2000), "every spawned thread received its blocking result");
});
// §3.13 A5: a `Waker` is move-only, and a clone is another handle on the same
// token. The token is one live waker for the loop until its LAST handle is
// released, on whichever thread: a clone released early must not release the
// park out from under the handle that will wake it.
test("a waker clone released on a worker thread leaves the owner's handle able to wake the park", {
  (round : i32) = i32(0);
  while(runtime(round < i32(50)), {
    pw := _RawWaker.park();
    match(
      pw,
      (f, w) => {
        wc := w.clone_handle();
        worker := Thread(unit).spawn({ wc }(tio : Io) => {
          // Released here, on the worker, without waking: a non-last handle.
          _keep := wc;
          ()
        });
        worker.join();
        h := io.spawn(
          io.async({ f }(io : Io) => {
            _r := io.await(f, io);
            i32(1)
          }),
          io
        );
        io.await(yield_now(io), io);
        w.wake();
        r := h.await(io);
        assert(match(r, .Some(v) => (v == i32(1)), .None => false), "the owner's handle woke the park");
      }
    );
    round = (round + i32(1));
  });
  assert(round == i32(50), "every round's park was woken by the surviving handle");
});
test("the last of two waker handles, released on a worker after its wake, resumes the park", {
  (round : i32) = i32(0);
  while(runtime(round < i32(50)), {
    pw := _RawWaker.park();
    match(
      pw,
      (f, w) => {
        wc := w.clone_handle();
        // The owner's handle goes first, so the worker's clone is the last
        // one: its release is the foreign path, posted to this loop's inbox.
        {
          _gone := w;
        };
        worker := Thread(unit).spawn({ wc }(tio : Io) => {
          sleep_blocking(Duration.from_millis(i64(1)));
          wc.wake();
          ()
        });
        _r := io.await(f, io);
        worker.join();
      }
    );
    round = (round + i32(1));
  });
  assert(round == i32(50), "every park woken by its last handle resumed");
});
