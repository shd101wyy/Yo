{ assert } :: import("std/assert");
open(import("std/fmt"));
{ Writer } :: import("std/fmt/writer");
// Side-effect witness for the unit-receiver test at the bottom of this file.
(_unit_side_effects : i32) = i32(0);
_unit_mark :: (fn(n : i32) -> unit)({
  _unit_side_effects = (_unit_side_effects + n);
});
test("Test 'println' function", {
  // Test integer types
  println(i8(-128));
  println(i16(-32768));
  println(i32(-2147483648));
  println(i64(-9223372036854775808));
  println(u8(255));
  println(u16(65535));
  println(u32(4294967295));
  println(u64(18446744073709551615));
  // Test floating point
  println(f32(3.14));
  println(f64(2.718281828));
  // Test bool
  println(true);
  println(false);
  // Test isize/usize
  num := 42;
  println(num);
  println(isize(num));
  println(usize(num));
  // Test str
  println("Hello, World!");
});
test("Test 'to_string' (for runtime value) function", {
  x1 := "Hello".to_string();
  y1 := 123.to_string();
  z1 := (3.14).to_string();
  m1 := true.to_string();
  n1 := false.to_string();
  t1 := "Hello";
  x2 := t1.to_string();
  t2 := 123;
  y2 := t2.to_string();
  t3 := 3.14;
  z2 := t3.to_string();
  t4 := true;
  m2 := t4.to_string();
  t5 := false;
  n2 := t5.to_string();
  assert(x1 == x2);
  assert(y1 == y2);
  assert(z1 == z2);
  assert(m1 == m2);
  assert(n1 == n2);
  {
    c :: "Hello, world!";
    c.to_string();
  };
});
test("Test template strings", {
  // Test simple template string with interpolations
  x := `hello, ${123} and ${true}.`;
  assert(x == "hello, 123 and true.".to_string());
  // Test template string with no interpolation
  y := `just a string`;
  assert(y == "just a string".to_string());
  assert(y != "another string".to_string());
  // Test template string with only interpolation
  z := `${42}`;
  assert(z == "42".to_string());
  // Test template string with expression
  a := `result: ${(1 + 2)}`;
  assert(a == "result: 3".to_string());
  // Test adjacent interpolations
  b := `${1}${2}${3}`;
  assert(b == "123".to_string());
  // Test template string with different types
  name := "World";
  age := 25;
  pi := 3.14;
  is_active := true;
  msg := `Name: ${name}, Age: ${age}, Pi: ${pi}, Active: ${is_active}`;
  assert(msg == "Name: World, Age: 25, Pi: 3.14, Active: true".to_string());
  // Test nested expressions in template strings
  c := `sum: ${(10 + 20)}, product: ${(5 * 6)}`;
  assert(c == "sum: 30, product: 30".to_string());
  // Test empty template string
  empty := ``;
  assert(empty == "".to_string());
  // Test escaping dollar sign
  escaped1 := `Price: \${100}`;
  assert(escaped1 == "Price: ${100}".to_string());
  // Test escaped dollar with actual interpolation
  escaped2 := `\${notInterpolated} but ${123} is`;
  assert(escaped2 == "${notInterpolated} but 123 is".to_string());
  // Test escaped backslash
  escaped3 := `Path: C:\\Users\\Name`;
  assert(escaped3 == "Path: C:\\Users\\Name".to_string());
  // Test escaped newline
  escaped4 := `Line1\nLine2`;
  assert(escaped4 == "Line1\nLine2".to_string());
  // Test escaped tab
  escaped5 := `Tab\there`;
  assert(escaped5 == "Tab\there".to_string());
  // Test escaped quote
  escaped6 := `He said \"Hello\"`;
  assert(escaped6 == "He said \"Hello\"".to_string());
  // Test multiple unwind sequences
  escaped7 := `\${a} and \${b} with ${42}`;
  assert(escaped7 == "${a} and ${b} with 42".to_string());
  println("All template string tests passed!");
});
test("C-interop integers, longdouble, and unit stringify (D3.8)", {
  assert(int(42).to_string() == `42`, "int");
  assert(uint(7).to_string() == `7`, "uint");
  assert(short(-3).to_string() == `-3`, "short");
  assert(ushort(9).to_string() == `9`, "ushort");
  assert(long(-100).to_string() == `-100`, "long");
  assert(ulong(100).to_string() == `100`, "ulong");
  assert(longlong(-5).to_string() == `-5`, "longlong");
  assert(ulonglong(5).to_string() == `5`, "ulonglong");
  assert(longdouble(1.5).to_string() == `1.5`, "longdouble");
  // unit's own ToString has its own test below ("Test unit ToString").
});
test("ArrayList and Array stringify as bracketed lists (D3.8)", {
  { ArrayList } :: import("std/collections/array_list");
  list := ArrayList(i32).new();
  assert(list.to_string() == `[]`, "empty list");
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  assert(list.to_string() == `[1, 2, 3]`, "three elements");
  assert(`${list}` == `[1, 2, 3]`, "interpolates in templates");
  arr := Array(u8, usize(3)).fill(7);
  assert(arr.to_string() == `[7, 7, 7]`, "array fill");
  nested := ArrayList(Option(i32)).new();
  nested.push(Option(i32).Some(i32(4)));
  nested.push(Option(i32).None);
  assert(nested.to_string() == `[Some(4), None]`, "nests through Option's ToString");
});
test("Test unit ToString", {
  // The last D3.8 primitive: the receiver is `inout(self) : Self` at
  // Self = unit, which used to emit an invalid C ref-spill
  // (`void __yo_ref_spill_N = ;`) —
  // issues/fixed/inout-unit-receiver-void-ref-spill.md.
  assert(().to_string() == "()", "unit prints as ()");
  // The unit argument's C code is EMPTY (the call is emitted as a statement),
  // which is why passing a null pointer in its place loses nothing — but a
  // side-effecting unit receiver must still run.
  assert(_unit_mark(i32(1)).to_string() == "()", "unit receiver from a call");
  assert(_unit_side_effects == i32(1), "the receiver call's side effect still ran");
  // `unit` in a declaration position (a by-value parameter, so `println(())`,
  // a struct field, a container element) is covered by
  // tests/unit_as_value_type.test.yo.
});
test("numeric to_string through the shared snprintf helper", {
  assert(i8(-128).to_string() == `-128`, "i8 min");
  assert(i64(9007199254740993).to_string() == `9007199254740993`, "big i64");
  assert(u64(18446744073709551615).to_string() == `18446744073709551615`, "u64 max");
  assert(f64(0.5).to_string() == `0.5`, "f64 %g drops trailing zeros");
  assert(f32(2.5).to_string() == `2.5`, "f32 widened");
});
test("Writer.to_string detaches the buffer: later writes never mutate a returned String", {
  // issues/fixed/fmt-writer-to-string-aliases-the-live-buffer.md — the
  // returned String used to SHARE the writer's ArrayList, so `w.write_str`
  // after `to_string` rewrote a value the caller already held (and both
  // dropped the same bytes).
  w := Writer.new();
  w.write_str("abc");
  first := w.to_string();
  w.write_str("def");
  assert(first == `abc`, "the first String must not see bytes written after it was taken");
  assert(first.len() == usize(3), "and its length is fixed at 3");
  assert(w.to_string() == `def`, "to_string hands over the buffer, so the writer starts empty");
  assert(w.len() == usize(0), "the writer is empty after to_string");
  w.write_str("x");
  assert(w.to_string() == `x`, "and is reusable afterwards");
  empty := Writer.new().to_string();
  assert(empty.len() == usize(0), "an empty writer yields an empty String");
});
