open import "std/fmt";

test "Test 'println' function", {
  // Test integer types
  println(i8(-128));
  println(i16(-32768));
  println(i32(-2147483648));
  println(i64(-9223372036854775808));
  
  println(u8(255));
  println(u16(65535));
  println(u32(4294967295));
  println(u64(18446744073709551615));
  
  // Test floating point
  println(f32(3.14));
  println(f64(2.718281828));
  
  // Test bool
  println(true);
  println(false);
  
  // Test isize/usize
  num := 42;
  println(num);
  println(isize(num));
  println(usize(num));

  // Test str
  println("Hello, World!");
};