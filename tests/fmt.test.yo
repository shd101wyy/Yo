open import "std/fmt";

test "Test 'println' function", {
  // Test integer types
  println(i8(-128));
  println(i16(-32768));
  println(i32(-2147483648));
  println(i64(-9223372036854775808));
  
  println(u8(255));
  println(u16(65535));
  println(u32(4294967295));
  println(u64(18446744073709551615));
  
  // Test floating point
  println(f32(3.14));
  println(f64(2.718281828));
  
  // Test bool
  println(true);
  println(false);
  
  // Test isize/usize
  num := 42;
  println(num);
  println(isize(num));
  println(usize(num));

  // Test str
  println("Hello, World!");
};

test "Test 'to_string' (for runtime value) function", {
  x1 := "Hello".to_string();
  y1 := 123.to_string();
  z1 := (3.14).to_string();
  m1 := true.to_string();
  n1 := false.to_string();

  t1 := "Hello";
  x2 := t1.to_string();
  t2 := 123;
  y2 := t2.to_string();
  t3 := 3.14;
  z2 := t3.to_string();
  t4 := true;
  m2 := t4.to_string();
  t5 := false;
  n2 := t5.to_string();

  assert(x1 == x2);
  assert(y1 == y2);
  assert(z1 == z2);
  assert(m1 == m2);
  assert(n1 == n2);
};