pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
test("Test comptime f32", {
  // Basic f32 values
  a :: f32(100.5);
  b :: f32(25.25);
  c :: f32(100.5);
  zero :: f32(0.0);
  neg_val :: -(f32(50.75));
  one :: f32(1.0);
  half :: f32(0.5);
  // Arithmetic operations
  sum :: (a + b); // 125.75f32
  diff :: (a - b); // 75.25f32
  prod :: (a * b); // 2537.625f32
  quot :: (a / b); // 3.9801980198...f32 (approximately 3.98)
  // Unary operations
  neg_a :: -(a); // -100.5f32
  neg_zero :: -(zero); // -0.0f32 (negative zero)
  // Comparison operations
  eq_test :: (a == c); // true (100.5f32 == 100.5f32)
  eq_false :: (a == b); // false (100.5f32 == 25.25f32)
  neq_test :: (a != b); // true (100.5f32 != 25.25f32)
  neq_false :: (a != c); // false (100.5f32 != 100.5f32)
  lt_test :: (b < a); // true (25.25f32 < 100.5f32)
  lt_false :: (a < b); // false (100.5f32 < 25.25f32)
  lte_test :: (b <= a); // true (25.25f32 <= 100.5f32)
  lte_equal :: (a <= c); // true (100.5f32 <= 100.5f32)
  gt_test :: (a > b); // true (100.5f32 > 25.25f32)
  gt_false :: (b > a); // false (25.25f32 > 100.5f32)
  gte_test :: (a >= b); // true (100.5f32 >= 25.25f32)
  gte_equal :: (a >= c); // true (100.5f32 >= 100.5f32)
  // Type conversion operations
  f32_to_f64 :: f64(a); // 100.5f64
  f32_to_i32 :: i32(a); // 100i32 (truncated)
  f32_to_u32 :: u32(a); // 100u32 (truncated)
  f32_to_string :: a.to_comptime_string(); // "100.5"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == (f32(125.75)));
  comptime_assert(diff == (f32(75.25)));
  comptime_assert(prod == (f32(2537.625)));
  // Unary operations
  comptime_assert(neg_a == (-(f32(100.5))));
  comptime_assert(neg_zero == (f32(0.0))); // -0.0 == 0.0 in IEEE 754
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(f32_to_f64 == (f64(100.5)));
  comptime_assert(f32_to_i32 == (i32(100)));
  comptime_assert(f32_to_u32 == (u32(100)));
  comptime_assert(f32_to_string == "100.5");
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a); // -50.75 + 100.5 = 49.75f32
    neg_diff :: (neg_val - a); // -50.75 - 100.5 = -151.25f32
    neg_prod :: (neg_val * f32(2.0)); // -50.75 * 2.0 = -101.5f32
    neg_quot :: (neg_val / f32(2.0)); // -50.75 / 2.0 = -25.375f32
    // Comparisons with negatives
    neg_lt :: (neg_val < a); // true (-50.75 < 100.5)
    neg_gt :: (a > neg_val); // true (100.5 > -50.75)
    comptime_assert(neg_sum == (f32(49.75)));
    comptime_assert(neg_diff == (-(f32(151.25))));
    comptime_assert(neg_prod == (-(f32(101.5))));
    comptime_assert(neg_quot == (-(f32(25.375))));
    comptime_assert(neg_lt == true);
    comptime_assert(neg_gt == true);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 100.5f32
    zero_diff1 :: (a - zero); // 100.5f32
    zero_diff2 :: (zero - a); // -100.5f32
    zero_prod :: (zero * a); // 0.0f32
    comptime_assert(zero_sum == (f32(100.5)));
    comptime_assert(zero_diff1 == (f32(100.5)));
    comptime_assert(zero_diff2 == (-(f32(100.5))));
    comptime_assert(zero_prod == (f32(0.0)));
    // Identity operations
    identity_sum :: (a + zero); // 100.5f32
    identity_prod :: (a * one); // 100.5f32
    comptime_assert(identity_sum == (f32(100.5)));
    comptime_assert(identity_prod == (f32(100.5)));
    // Self operations
    self_sub :: (a - a); // 0.0f32
    self_div :: (a / a); // 1.0f32
    comptime_assert(self_sub == (f32(0.0)));
    comptime_assert(self_div == (f32(1.0)));
  };
  // Test fractional operations
  {
    frac1 :: f32(0.25);
    frac2 :: f32(0.75);
    frac_sum :: (frac1 + frac2); // 1.0f32
    frac_diff :: (frac2 - frac1); // 0.5f32
    frac_prod :: (frac1 * frac2); // 0.1875f32 (3/16)
    frac_quot :: (frac2 / frac1); // 3.0f32
    comptime_assert(frac_sum == (f32(1.0)));
    comptime_assert(frac_diff == (f32(0.5)));
    comptime_assert(frac_prod == (f32(0.1875)));
    comptime_assert(frac_quot == (f32(3.0)));
    // Powers and roots (approximations)
    square :: (frac2 * frac2); // 0.5625f32 (0.75^2)
    half_div :: (one / f32(2.0)); // 0.5f32
    comptime_assert(square == (f32(0.5625)));
    comptime_assert(half_div == (f32(0.5)));
  };
  // Test various divisions
  {
    div1 :: (f32(200.0) / f32(8.0)); // 25.0f32
    div2 :: (f32(201.0) / f32(8.0)); // 25.125f32
    div3 :: (f32(7.0) / f32(100.0)); // 0.07f32
    // Negative divisions
    div4 :: (-(f32(200.0)) / f32(8.0)); // -25.0f32
    div5 :: (f32(200.0) / -(f32(8.0))); // -25.0f32
    div6 :: (-(f32(200.0)) / -(f32(8.0))); // 25.0f32
    comptime_assert(div1 == (f32(25.0)));
    comptime_assert(div2 == (f32(25.125)));
    comptime_assert(div3 == (f32(0.07)));
    comptime_assert(div4 == (-(f32(25.0))));
    comptime_assert(div5 == (-(f32(25.0))));
    comptime_assert(div6 == (f32(25.0)));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / f32(5.0)); // (100.5 + 25.25) / 5.0 = 25.15f32
    chain2 :: (a + (b * f32(2.0))); // 100.5 + (25.25 * 2.0) = 151.0f32
    chain3 :: ((a / b) + f32(1.0)); // (100.5 / 25.25) + 1.0 ≈ 4.98f32
    comptime_assert(chain1 == (f32(25.15)));
    comptime_assert(chain2 == (f32(151.0)));
    // chain3 result depends on precise division
  };
  // Test scientific notation values
  {
    small :: f32(0.001); // 1e-3
    large :: f32(1000.0); // 1e3
    sci_prod :: (small * large); // 1.0f32
    sci_div :: (large / small); // 1000000.0f32 (1e6)
    comptime_assert(sci_prod == (f32(1.0)));
    comptime_assert(sci_div == (f32(1000000.0)));
  };
  // Test precision limits (f32 has about 7 decimal digits of precision)
  {
    precise1 :: f32(1.234567); // Within precision
    precise2 :: f32(1.000001); // Within precision
    precise_sum :: (precise1 + precise2); // 2.234568f32
    precise_diff :: (precise1 - precise2); // 0.234566f32
    comptime_assert(precise_sum == f32(2.234568));
    // comptime_assert(precise_diff == (f32(0.234566)));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    neg_str :: neg_val.to_comptime_string();
    frac_str :: (f32(0.125)).to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(neg_str == "-50.75");
    comptime_assert(frac_str == "0.125");
  };
  // Test special arithmetic patterns
  {
    // Common fractions
    third :: (f32(1.0) / f32(3.0)); // 0.333333...f32
    two_thirds :: (f32(2.0) / f32(3.0)); // 0.666666...f32
    // Reciprocals
    recip_2 :: (f32(1.0) / f32(2.0)); // 0.5f32
    recip_4 :: (f32(1.0) / f32(4.0)); // 0.25f32
    comptime_assert(recip_2 == (f32(0.5)));
    comptime_assert(recip_4 == (f32(0.25)));
    // Powers of 10
    ten :: f32(10.0);
    hundred :: (ten * ten); // 100.0f32
    thousand :: (hundred * ten); // 1000.0f32
    comptime_assert(hundred == (f32(100.0)));
    comptime_assert(thousand == (f32(1000.0)));
  };
});
test("Test comptime f64", {
  // Basic f64 values
  a :: f64(100.5);
  b :: f64(25.25);
  c :: f64(100.5);
  zero :: f64(0.0);
  neg_val :: f64(-(50.75));
  one :: f64(1.0);
  half :: f64(0.5);
  // Arithmetic operations
  sum :: (a + b); // 125.75f64
  diff :: (a - b); // 75.25f64
  prod :: (a * b); // 2537.625f64
  quot :: (a / b); // 3.9801980198019801...f64 (high precision)
  // Unary operations
  neg_a :: -(a); // -100.5f64
  neg_zero :: -(zero); // -0.0f64 (negative zero)
  // Comparison operations
  eq_test :: (a == c); // true (100.5f64 == 100.5f64)
  eq_false :: (a == b); // false (100.5f64 == 25.25f64)
  neq_test :: (a != b); // true (100.5f64 != 25.25f64)
  neq_false :: (a != c); // false (100.5f64 != 100.5f64)
  lt_test :: (b < a); // true (25.25f64 < 100.5f64)
  lt_false :: (a < b); // false (100.5f64 < 25.25f64)
  lte_test :: (b <= a); // true (25.25f64 <= 100.5f64)
  lte_equal :: (a <= c); // true (100.5f64 <= 100.5f64)
  gt_test :: (a > b); // true (100.5f64 > 25.25f64)
  gt_false :: (b > a); // false (25.25f64 > 100.5f64)
  gte_test :: (a >= b); // true (100.5f64 >= 25.25f64)
  gte_equal :: (a >= c); // true (100.5f64 >= 100.5f64)
  // Type conversion operations
  f64_to_f32 :: f32(a); // 100.5f32 (may lose precision)
  f64_to_i64 :: i64(a); // 100i64 (truncated)
  f64_to_u64 :: u64(a); // 100u64 (truncated)
  f64_to_string :: a.to_comptime_string(); // "100.5"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == f64(125.75));
  comptime_assert(diff == f64(75.25));
  comptime_assert(prod == f64(2537.625));
  // Unary operations
  comptime_assert(neg_a == f64(-(100.5)));
  comptime_assert(neg_zero == f64(0.0)); // -0.0 == 0.0 in IEEE 754
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(f64_to_f32 == f32(100.5));
  comptime_assert(f64_to_i64 == i64(100));
  comptime_assert(f64_to_u64 == u64(100));
  comptime_assert(f64_to_string == "100.5");
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a); // -50.75 + 100.5 = 49.75f64
    neg_diff :: (neg_val - a); // -50.75 - 100.5 = -151.25f64
    neg_prod :: (neg_val * f64(2.0)); // -50.75 * 2.0 = -101.5f64
    neg_quot :: (neg_val / f64(2.0)); // -50.75 / 2.0 = -25.375f64
    // Comparisons with negatives
    neg_lt :: (neg_val < a); // true (-50.75 < 100.5)
    neg_gt :: (a > neg_val); // true (100.5 > -50.75)
    comptime_assert(neg_sum == f64(49.75));
    comptime_assert(neg_diff == f64(-(151.25)));
    comptime_assert(neg_prod == f64(-(101.5)));
    comptime_assert(neg_quot == f64(-(25.375)));
    comptime_assert(neg_lt == true);
    comptime_assert(neg_gt == true);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 100.5f64
    zero_diff1 :: (a - zero); // 100.5f64
    zero_diff2 :: (zero - a); // -100.5f64
    zero_prod :: (zero * a); // 0.0f64
    comptime_assert(zero_sum == f64(100.5));
    comptime_assert(zero_diff1 == f64(100.5));
    comptime_assert(zero_diff2 == f64(-(100.5)));
    comptime_assert(zero_prod == f64(0.0));
    // Identity operations
    identity_sum :: (a + zero); // 100.5f64
    identity_prod :: (a * one); // 100.5f64
    comptime_assert(identity_sum == f64(100.5));
    comptime_assert(identity_prod == f64(100.5));
    // Self operations
    self_sub :: (a - a); // 0.0f64
    self_div :: (a / a); // 1.0f64
    comptime_assert(self_sub == f64(0.0));
    comptime_assert(self_div == f64(1.0));
  };
  // Test fractional operations
  {
    frac1 :: f64(0.25);
    frac2 :: f64(0.75);
    frac_sum :: (frac1 + frac2); // 1.0f64
    frac_diff :: (frac2 - frac1); // 0.5f64
    frac_prod :: (frac1 * frac2); // 0.1875f64 (3/16)
    frac_quot :: (frac2 / frac1); // 3.0f64
    comptime_assert(frac_sum == f64(1.0));
    comptime_assert(frac_diff == f64(0.5));
    comptime_assert(frac_prod == f64(0.1875));
    comptime_assert(frac_quot == f64(3.0));
    // Powers and roots (approximations)
    square :: (frac2 * frac2); // 0.5625f64 (0.75^2)
    half_div :: (one / f64(2.0)); // 0.5f64
    comptime_assert(square == f64(0.5625));
    comptime_assert(half_div == f64(0.5));
  };
  // Test various divisions
  {
    div1 :: (f64(200.0) / f64(8.0)); // 25.0f64
    div2 :: (f64(201.0) / f64(8.0)); // 25.125f64
    div3 :: (f64(7.0) / f64(100.0)); // 0.07f64
    // Negative divisions
    div4 :: (f64(-(200.0)) / f64(8.0)); // -25.0f64
    div5 :: (f64(200.0) / f64(-(8.0))); // -25.0f64
    div6 :: (f64(-(200.0)) / f64(-(8.0))); // 25.0f64
    comptime_assert(div1 == f64(25.0));
    comptime_assert(div2 == f64(25.125));
    comptime_assert(div3 == f64(0.07));
    comptime_assert(div4 == f64(-(25.0)));
    comptime_assert(div5 == f64(-(25.0)));
    comptime_assert(div6 == f64(25.0));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / f64(5.0)); // (100.5 + 25.25) / 5.0 = 25.15f64
    chain2 :: (a + (b * f64(2.0))); // 100.5 + (25.25 * 2.0) = 151.0f64
    chain3 :: ((a / b) + f64(1.0)); // (100.5 / 25.25) + 1.0 ≈ 4.980198...f64
    comptime_assert(chain1 == f64(25.15));
    comptime_assert(chain2 == f64(151.0));
    // chain3 result depends on precise division
  };
  // Test scientific notation values
  {
    small :: f64(0.001); // 1e-3
    large :: f64(1000.0); // 1e3
    very_small :: f64(0.000001); // 1e-6
    very_large :: f64(1000000.0); // 1e6
    sci_prod :: (small * large); // 1.0f64
    sci_div :: (large / small); // 1000000.0f64 (1e6)
    tiny_prod :: (very_small * very_large); // 1.0f64
    comptime_assert(sci_prod == f64(1.0));
    comptime_assert(sci_div == f64(1000000.0));
    comptime_assert(tiny_prod == f64(1.0));
  };
  // Test high precision (f64 has about 15-17 decimal digits of precision)
  {
    precise1 :: f64(1.23456789012345); // Within precision
    precise2 :: f64(1.00000000000001); // Within precision
    precise_sum :: (precise1 + precise2); // 2.23456789012346f64
    precise_diff :: (precise1 - precise2); // 0.23456789012344f64
    comptime_assert(precise_sum == f64(2.23456789012346));
    // comptime_assert(precise_diff == (f64(0.23456789012344.)));
  };
  // Test very large and very small numbers
  {
    huge :: f64(1.0e15); // 1 quadrillion
    tiny :: f64(1.0e-15); // 1 femto
    huge_ops :: (huge * f64(2.0)); // 2.0e15f64
    tiny_ops :: (tiny * f64(1000.0)); // 1.0e-12f64
    comptime_assert(huge_ops == f64(2.0e15));
    comptime_assert(tiny_ops == f64(1.0e-12));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    neg_str :: neg_val.to_comptime_string();
    frac_str :: f64(0.125).to_comptime_string();
    sci_str :: f64(1.25e-3).to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(neg_str == "-50.75");
    comptime_assert(frac_str == "0.125");
    // sci_str format may vary based on implementation
  };
  // Test special arithmetic patterns
  {
    // Common fractions with higher precision
    third :: (f64(1.0) / f64(3.0)); // 0.333333333333333...f64
    two_thirds :: (f64(2.0) / f64(3.0)); // 0.666666666666666...f64
    pi_approx :: f64(3.141592653589793); // High precision pi approximation
    // Reciprocals
    recip_2 :: (f64(1.0) / f64(2.0)); // 0.5f64
    recip_4 :: (f64(1.0) / f64(4.0)); // 0.25f64
    recip_pi :: (f64(1.0) / pi_approx); // 1/π
    comptime_assert(recip_2 == f64(0.5));
    comptime_assert(recip_4 == f64(0.25));
    // Powers of 10
    ten :: f64(10.0);
    hundred :: (ten * ten); // 100.0f64
    thousand :: (hundred * ten); // 1000.0f64
    million :: (thousand * thousand); // 1000000.0f64
    comptime_assert(hundred == f64(100.0));
    comptime_assert(thousand == f64(1000.0));
    comptime_assert(million == f64(1000000.0));
  };
  // Test mathematical constants and relationships
  {
    e_approx :: f64(2.718281828459045); // Euler's number approximation
    sqrt2_approx :: f64(1.4142135623730951); // √2 approximation
    // Test some mathematical relationships
    half_pi :: (f64(3.141592653589793) / f64(2.0)); // π/2
    quarter_pi :: (half_pi / f64(2.0)); // π/4
    // Golden ratio approximation
    phi :: f64(1.618033988749895);
    phi_recip :: (f64(1.0) / phi); // 1/φ ≈ φ - 1
    comptime_assert(half_pi == f64(1.5707963267948966));
    comptime_assert(quarter_pi == f64(0.7853981633974483));
    // Test that φ * (1/φ) ≈ 1
    phi_product :: (phi * phi_recip);
    // comptime_assert(phi_product == f64(1.0)); // Should be very close to 1.0
  };
});
test("Test comptime i8", {
  // Basic i8 values
  a :: i8(50);
  b :: i8(25);
  c :: i8(50);
  zero :: i8(0);
  neg_val :: i8((30).neg());
  max_val :: i8.MAX;
  min_val :: i8.MIN;
  // Arithmetic operations
  sum :: (a + b); // 75i8
  diff :: (a - b); // 25i8
  comptime_expect_error(prod :: (a * b)); // 1250i8 (may overflow)
  quot :: (a / b); // 2i8 (integer division)
  remainder :: (a % b); // 0i8 (50 % 25 = 0)
  // Unary operations
  neg_a :: -(a); // -50i8
  neg_zero :: -(zero); // 0i8
  // Comparison operations
  eq_test :: (a == c); // true (50i8 == 50i8)
  eq_false :: (a == b); // false (50i8 == 25i8)
  neq_test :: (a != b); // true (50i8 != 25i8)
  neq_false :: (a != c); // false (50i8 != 50i8)
  lt_test :: (b < a); // true (25i8 < 50i8)
  lt_false :: (a < b); // false (50i8 < 25i8)
  lte_test :: (b <= a); // true (25i8 <= 50i8)
  lte_equal :: (a <= c); // true (50i8 <= 50i8)
  gt_test :: (a > b); // true (50i8 > 25i8)
  gt_false :: (b > a); // false (25i8 > 50i8)
  gte_test :: (a >= b); // true (50i8 >= 25i8)
  gte_equal :: (a >= c); // true (50i8 >= 50i8)
  // Type conversion operations
  i8_to_i16 :: i16(a); // 50i16
  i8_to_u16 :: u16(a); // 50u16
  i8_to_f32 :: f32(a); // 50.0f32
  i8_to_string :: a.to_comptime_string(); // "50"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == i8(75));
  comptime_assert(diff == i8(25));
  comptime_assert(quot == i8(2));
  comptime_assert(remainder == i8(0));
  // Unary operations
  comptime_assert(neg_a == i8((50).neg()));
  comptime_assert(neg_zero == i8(0));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(i8_to_i16 == i16(50));
  comptime_assert(i8_to_u16 == u16(50));
  comptime_assert(i8_to_f32 == f32(50.0));
  comptime_assert(i8_to_string == "50");
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a); // -30 + 50 = 20i8
    neg_diff :: (neg_val - a); // -30 - 50 = -80i8
    neg_prod :: (neg_val * i8(2)); // -30 * 2 = -60i8
    neg_quot :: (neg_val / i8(5)); // -30 / 5 = -6i8
    // Comparisons with negatives
    neg_lt :: (neg_val < a); // true (-30 < 50)
    neg_gt :: (a > neg_val); // true (50 > -30)
    comptime_assert(neg_sum == i8(20));
    comptime_assert(neg_diff == i8((80).neg()));
    comptime_assert(neg_prod == i8((60).neg()));
    comptime_assert(neg_quot == i8((6).neg()));
    comptime_assert(neg_lt == true);
    comptime_assert(neg_gt == true);
  };
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + i8(1)); // -127i8
    comptime_expect_error(min_val - i8(1)); // overflow behavior
    min_neg :: -(min_val); // overflow: -(-128) should be handled
    // Operations with max value
    comptime_expect_error(max_sum :: (max_val + i8(1))); // overflow
    max_sub :: (max_val - i8(1)); // 126i8
    max_neg :: -(max_val); // -127i8
    comptime_assert(min_sum == i8((127).neg()));
    comptime_assert(max_sub == i8(126));
    comptime_assert(max_neg == i8((127).neg()));
    // Boundary comparisons
    comptime_assert(min_val < max_val);
    comptime_assert(max_val > min_val);
    comptime_assert(min_val <= max_val);
    comptime_assert(max_val >= min_val);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 50i8
    zero_diff1 :: (a - zero); // 50i8
    zero_diff2 :: (zero - a); // -50i8
    zero_prod :: (zero * a); // 0i8
    comptime_assert(zero_sum == i8(50));
    comptime_assert(zero_diff1 == i8(50));
    comptime_assert(zero_diff2 == i8((50).neg()));
    comptime_assert(zero_prod == i8(0));
    // Identity operations
    identity_sum :: (a + zero); // 50i8
    identity_prod :: (a * i8(1)); // 50i8
    comptime_assert(identity_sum == i8(50));
    comptime_assert(identity_prod == i8(50));
    // Self operations
    self_sub :: (a - a); // 0i8
    self_div :: (a / a); // 1i8
    self_mod :: (a % a); // 0i8
    comptime_assert(self_sub == i8(0));
    comptime_assert(self_div == i8(1));
    comptime_assert(self_mod == i8(0));
  };
  // Test various divisions
  {
    div1 :: (i8(60) / i8(5)); // 12i8
    div2 :: (i8(61) / i8(5)); // 12i8 (integer division)
    div3 :: (i8(3) / i8(10)); // 0i8
    // Negative divisions
    div4 :: (i8((60).neg()) / i8(5)); // -12i8
    div5 :: (i8(60) / i8((5).neg())); // -12i8
    div6 :: (i8((60).neg()) / i8((5).neg())); // 12i8
    comptime_assert(div1 == i8(12));
    comptime_assert(div2 == i8(12));
    comptime_assert(div3 == i8(0));
    comptime_assert(div4 == i8((12).neg()));
    comptime_assert(div5 == i8((12).neg()));
    comptime_assert(div6 == i8(12));
  };
  // Test modulo operations
  {
    mod1 :: (i8(17) % i8(5)); // 2i8
    mod2 :: (i8(20) % i8(4)); // 0i8
    mod3 :: (i8(7) % i8(10)); // 7i8
    // Negative modulo
    mod4 :: (i8((17).neg()) % i8(5)); // behavior depends on implementation
    mod5 :: (i8(17) % i8((5).neg())); // behavior depends on implementation
    comptime_assert(mod1 == i8(2));
    comptime_assert(mod2 == i8(0));
    comptime_assert(mod3 == i8(7));
  };
  // Test chained operations
  {
    comptime_expect_error(chain1 :: ((a + b) * i8(2))); // (50i8 + 25i8) * 2i8 = 150i8 (may overflow)
    chain2 :: (a + (b * i8(2))); // 50i8 + (25i8 * 2i8) = 100i8
    chain3 :: ((a / b) + i8(1)); // (50i8 / 25i8) + 1i8 = 3i8
    comptime_assert(chain2 == i8(100));
    comptime_assert(chain3 == i8(3));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    neg_str :: neg_val.to_comptime_string();
    max_str :: max_val.to_comptime_string();
    min_str :: min_val.to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(neg_str == "-30");
    comptime_assert(max_str == "127");
    comptime_assert(min_str == "-128");
  };
});
test("Test comptime i16", {
  // Basic i16 values
  a :: i16(1000);
  b :: i16(250);
  c :: i16(1000);
  zero :: i16(0);
  neg_val :: i16(-(500));
  max_val :: i16.MAX;
  min_val :: i16.MIN;
  // Arithmetic operations
  sum :: (a + b); // 1250i16
  diff :: (a - b); // 750i16
  comptime_expect_error(prod :: (a * b)); // 250000i16 (may overflow)
  quot :: (a / b); // 4i16 (integer division)
  remainder :: (a % b); // 0i16 (1000 % 250 = 0)
  // Unary operations
  neg_a :: -(a); // -1000i16
  neg_zero :: -(zero); // 0i16
  // Comparison operations
  eq_test :: (a == c); // true (1000i16 == 1000i16)
  eq_false :: (a == b); // false (1000i16 == 250i16)
  neq_test :: (a != b); // true (1000i16 != 250i16)
  neq_false :: (a != c); // false (1000i16 != 1000i16)
  lt_test :: (b < a); // true (250i16 < 1000i16)
  lt_false :: (a < b); // false (1000i16 < 250i16)
  lte_test :: (b <= a); // true (250i16 <= 1000i16)
  lte_equal :: (a <= c); // true (1000i16 <= 1000i16)
  gt_test :: (a > b); // true (1000i16 > 250i16)
  gt_false :: (b > a); // false (250i16 > 1000i16)
  gte_test :: (a >= b); // true (1000i16 >= 250i16)
  gte_equal :: (a >= c); // true (1000i16 >= 1000i16)
  // Type conversion operations
  i16_to_i32 :: i32(a); // 1000i32
  i16_to_u32 :: u32(a); // 1000u32
  i16_to_f32 :: f32(a); // 1000.0f32
  i16_to_string :: a.to_comptime_string(); // "1000"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == i16(1250));
  comptime_assert(diff == i16(750));
  comptime_assert(quot == i16(4));
  comptime_assert(remainder == i16(0));
  // Unary operations
  n :: (-(1000));
  x :: i16(n);
  comptime_assert(neg_a == i16(-(1000)));
  comptime_assert(neg_zero == i16(0));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(i16_to_i32 == i32(1000));
  comptime_assert(i16_to_u32 == u32(1000));
  comptime_assert(i16_to_f32 == (f32(1000.0)));
  comptime_assert(i16_to_string == "1000");
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a); // -500 + 1000 = 500i16
    neg_diff :: (neg_val - a); // -500 - 1000 = -1500i16
    neg_prod :: (neg_val * i16(2)); // -500 * 2 = -1000i16
    neg_quot :: (neg_val / i16(5)); // -500 / 5 = -100i16
    // Comparisons with negatives
    neg_lt :: (neg_val < a); // true (-500 < 1000)
    neg_gt :: (a > neg_val); // true (1000 > -500)
    comptime_assert(neg_sum == i16(500));
    comptime_assert(neg_diff == i16(-(1500)));
    comptime_assert(neg_prod == i16(-(1000)));
    comptime_assert(neg_quot == i16(-(100)));
    comptime_assert(neg_lt == true);
    comptime_assert(neg_gt == true);
  };
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + i16(1)); // -32767i16
    comptime_expect_error(min_sub :: (min_val - i16(1))); // overflow behavior
    min_neg :: -(min_val); // overflow: -(-32768) should be handled
    // Operations with max value
    comptime_expect_error(max_sum :: (max_val + i16(1))); // overflow
    max_sub :: (max_val - i16(1)); // 32766i16
    max_neg :: -(max_val); // -32767i16
    comptime_assert(min_sum == i16(-(32767)));
    comptime_assert(max_sub == i16(32766));
    comptime_assert(max_neg == i16(-(32767)));
    // Boundary comparisons
    comptime_assert(min_val < max_val);
    comptime_assert(max_val > min_val);
    comptime_assert(min_val <= max_val);
    comptime_assert(max_val >= min_val);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 1000i16
    zero_diff1 :: (a - zero); // 1000i16
    zero_diff2 :: (zero - a); // -1000i16
    zero_prod :: (zero * a); // 0i16
    comptime_assert(zero_sum == i16(1000));
    comptime_assert(zero_diff1 == i16(1000));
    comptime_assert(zero_diff2 == i16(-(1000)));
    comptime_assert(zero_prod == i16(0));
    // Identity operations
    identity_sum :: (a + zero); // 1000i16
    identity_prod :: (a * i16(1)); // 1000i16
    comptime_assert(identity_sum == i16(1000));
    comptime_assert(identity_prod == i16(1000));
    // Self operations
    self_sub :: (a - a); // 0i16
    self_div :: (a / a); // 1i16
    self_mod :: (a % a); // 0i16
    comptime_assert(self_sub == i16(0));
    comptime_assert(self_div == i16(1));
    comptime_assert(self_mod == i16(0));
  };
  // Test large values
  {
    large1 :: i16(20000);
    large2 :: i16(12000);
    large_sum :: (large1 + large2); // 32000i16
    large_diff :: (large1 - large2); // 8000i16
    large_div :: (large1 / i16(10)); // 2000i16
    large_mod :: (large1 % i16(7)); // 6i16 (20000 % 7 = 1)
    comptime_assert(large_sum == i16(32000));
    comptime_assert(large_diff == i16(8000));
    comptime_assert(large_div == i16(2000));
    comptime_assert(large_mod == i16(1));
  };
  // Test various divisions
  {
    div1 :: (i16(2000) / i16(8)); // 250i16
    div2 :: (i16(2001) / i16(8)); // 250i16 (integer division)
    div3 :: (i16(7) / i16(100)); // 0i16
    // Negative divisions
    div4 :: (i16(-(2000)) / i16(8)); // -250i16
    div5 :: (i16(2000) / i16(-(8))); // -250i16
    div6 :: (i16(-(2000)) / i16(-(8))); // 250i16
    comptime_assert(div1 == i16(250));
    comptime_assert(div2 == i16(250));
    comptime_assert(div3 == i16(0));
    comptime_assert(div4 == i16(-(250)));
    comptime_assert(div5 == i16(-(250)));
    comptime_assert(div6 == i16(250));
  };
  // Test modulo operations
  {
    mod1 :: (i16(17) % i16(5)); // 2i16
    mod2 :: (i16(20) % i16(4)); // 0i16
    mod3 :: (i16(7) % i16(10)); // 7i16
    // Negative modulo
    mod4 :: (i16(-(17)) % i16(5)); // behavior depends on implementation
    mod5 :: (i16(17) % i16(-(5))); // behavior depends on implementation
    comptime_assert(mod1 == i16(2));
    comptime_assert(mod2 == i16(0));
    comptime_assert(mod3 == i16(7));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / i16(2)); // (1000i16 + 250i16) / 2i16 = 625i16
    chain2 :: (a + (b * i16(2))); // 1000i16 + (250i16 * 2i16) = 1500i16
    chain3 :: ((a / b) + i16(1)); // (1000i16 / 250i16) + 1i16 = 5i16
    comptime_assert(chain1 == i16(625));
    comptime_assert(chain2 == i16(1500));
    comptime_assert(chain3 == i16(5));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    neg_str :: neg_val.to_comptime_string();
    max_str :: max_val.to_comptime_string();
    min_str :: min_val.to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(neg_str == "-500");
    comptime_assert(max_str == "32767");
    comptime_assert(min_str == "-32768");
  };
});
test("Test comptime i32", {
  // Basic i32 values
  a :: i32(100000);
  b :: i32(25000);
  c :: i32(100000);
  zero :: i32(0);
  neg_val :: i32(-(50000));
  max_val :: i32.MAX;
  min_val :: i32.MIN;
  // Arithmetic operations
  sum :: (a + b); // 125000i32
  diff :: (a - b); // 75000i32
  comptime_expect_error(prod :: (a * b)); // 2500000000i32
  quot :: (a / b); // 4i32 (integer division)
  remainder :: (a % b); // 0i32 (100000 % 25000 = 0)
  // Unary operations
  neg_a :: -(a); // -100000i32
  neg_zero :: -(zero); // 0i32
  // Comparison operations
  eq_test :: (a == c); // true (100000i32 == 100000i32)
  eq_false :: (a == b); // false (100000i32 == 25000i32)
  neq_test :: (a != b); // true (100000i32 != 25000i32)
  neq_false :: (a != c); // false (100000i32 != 100000i32)
  lt_test :: (b < a); // true (25000i32 < 100000i32)
  lt_false :: (a < b); // false (100000i32 < 25000i32)
  lte_test :: (b <= a); // true (25000i32 <= 100000i32)
  lte_equal :: (a <= c); // true (100000i32 <= 100000i32)
  gt_test :: (a > b); // true (100000i32 > 25000i32)
  gt_false :: (b > a); // false (25000i32 > 100000i32)
  gte_test :: (a >= b); // true (100000i32 >= 25000i32)
  gte_equal :: (a >= c); // true (100000i32 >= 100000i32)
  // Type conversion operations
  i32_to_i64 :: i64(a); // 100000i64
  i32_to_u64 :: u64(a); // 100000u64
  i32_to_f32 :: f32(a); // 100000.0f32
  i32_to_f64 :: f64(a); // 100000.0f64
  i32_to_string :: a.to_comptime_string(); // "100000"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == i32(125000));
  comptime_assert(diff == i32(75000));
  comptime_assert(quot == i32(4));
  comptime_assert(remainder == i32(0));
  // Unary operations
  comptime_assert(neg_a == i32(-(100000)));
  comptime_assert(neg_zero == i32(0));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(i32_to_i64 == i64(100000));
  comptime_assert(i32_to_u64 == u64(100000));
  comptime_assert(i32_to_f32 == f32(100000.0));
  comptime_assert(i32_to_f64 == f64(100000.0));
  comptime_assert(i32_to_string == "100000");
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a); // -50000 + 100000 = 50000i32
    neg_diff :: (neg_val - a); // -50000 - 100000 = -150000i32
    neg_prod :: (neg_val * i32(2)); // -50000 * 2 = -100000i32
    neg_quot :: (neg_val / i32(10)); // -50000 / 10 = -5000i32
    // Comparisons with negatives
    neg_lt :: (neg_val < a); // true (-50000 < 100000)
    neg_gt :: (a > neg_val); // true (100000 > -50000)
    comptime_assert(neg_sum == i32(50000));
    comptime_assert(neg_diff == i32(-(150000)));
    comptime_assert(neg_prod == i32(-(100000)));
    comptime_assert(neg_quot == i32(-(5000)));
    comptime_assert(neg_lt == true);
    comptime_assert(neg_gt == true);
  };
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + i32(1)); // -2147483647i32
    comptime_expect_error(min_sub :: (min_val - i32(1))); // overflow behavior
    min_neg :: -(min_val); // overflow: -(-2147483648) should be handled
    // Operations with max value
    comptime_expect_error(max_sum :: (max_val + i32(1))); // overflow
    max_sub :: (max_val - i32(1)); // 2147483646i32
    max_neg :: -(max_val); // -2147483647i32
    comptime_assert(min_sum == i32(-(2147483647)));
    comptime_assert(max_sub == i32(2147483646));
    comptime_assert(max_neg == i32(-(2147483647)));
    // Boundary comparisons
    comptime_assert(min_val < max_val);
    comptime_assert(max_val > min_val);
    comptime_assert(min_val <= max_val);
    comptime_assert(max_val >= min_val);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 100000i32
    zero_diff1 :: (a - zero); // 100000i32
    zero_diff2 :: (zero - a); // -100000i32
    zero_prod :: (zero * a); // 0i32
    comptime_assert(zero_sum == i32(100000));
    comptime_assert(zero_diff1 == i32(100000));
    comptime_assert(zero_diff2 == i32(-(100000)));
    comptime_assert(zero_prod == i32(0));
    // Identity operations
    identity_sum :: (a + zero); // 100000i32
    identity_prod :: (a * i32(1)); // 100000i32
    comptime_assert(identity_sum == i32(100000));
    comptime_assert(identity_prod == i32(100000));
    // Self operations
    self_sub :: (a - a); // 0i32
    self_div :: (a / a); // 1i32
    self_mod :: (a % a); // 0i32
    comptime_assert(self_sub == i32(0));
    comptime_assert(self_div == i32(1));
    comptime_assert(self_mod == i32(0));
  };
  // Test large values
  {
    large1 :: i32(1000000000);
    large2 :: i32(500000000);
    large_sum :: (large1 + large2); // 1500000000i32
    large_diff :: (large1 - large2); // 500000000i32
    large_div :: (large1 / i32(1000)); // 1000000i32
    large_mod :: (large1 % i32(7)); // 6i32 (1000000000 % 7 = 6)
    comptime_assert(large_sum == i32(1500000000));
    comptime_assert(large_diff == i32(500000000));
    comptime_assert(large_div == i32(1000000));
    comptime_assert(large_mod == i32(6));
  };
  // Test various divisions
  {
    div1 :: (i32(200000) / i32(8)); // 25000i32
    div2 :: (i32(200001) / i32(8)); // 25000i32 (integer division)
    div3 :: (i32(7) / i32(1000)); // 0i32
    // Negative divisions
    div4 :: (i32(-(200000)) / i32(8)); // -25000i32
    div5 :: (i32(200000) / -(i32(8))); // -25000i32
    div6 :: (i32(-(200000)) / -(i32(8))); // 25000i32
    comptime_assert(div1 == i32(25000));
    comptime_assert(div2 == i32(25000));
    comptime_assert(div3 == i32(0));
    comptime_assert(div4 == i32(-(25000)));
    comptime_assert(div5 == i32(-(25000)));
    comptime_assert(div6 == i32(25000));
  };
  // Test modulo operations
  {
    mod1 :: (i32(17) % i32(5)); // 2i32
    mod2 :: (i32(20) % i32(4)); // 0i32
    mod3 :: (i32(7) % i32(10)); // 7i32
    // Negative modulo
    mod4 :: (i32(-(17)) % i32(5)); // behavior depends on implementation
    mod5 :: (i32(17) % -(i32(5))); // behavior depends on implementation
    comptime_assert(mod1 == i32(2));
    comptime_assert(mod2 == i32(0));
    comptime_assert(mod3 == i32(7));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / i32(5)); // (100000i32 + 25000i32) / 5i32 = 25000i32
    chain2 :: (a + (b * i32(2))); // 100000i32 + (25000i32 * 2i32) = 150000i32
    chain3 :: ((a / b) + i32(1)); // (100000i32 / 25000i32) + 1i32 = 5i32
    comptime_assert(chain1 == i32(25000));
    comptime_assert(chain2 == i32(150000));
    comptime_assert(chain3 == i32(5));
  };
  // Test powers of 2 (common in systems programming)
  {
    pow2_10 :: i32(1024); // 2^10
    pow2_20 :: i32(1048576); // 2^20
    div_pow2 :: (pow2_20 / pow2_10); // 1024i32
    mod_pow2 :: (i32(1025) % pow2_10); // 1i32
    comptime_assert(div_pow2 == i32(1024));
    comptime_assert(mod_pow2 == i32(1));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    neg_str :: neg_val.to_comptime_string();
    max_str :: max_val.to_comptime_string();
    min_str :: min_val.to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(neg_str == "-50000");
    comptime_assert(max_str == "2147483647");
    comptime_assert(min_str == "-2147483648");
  };
  // Bitwise operations
  {
    x :: i32(0x00FF);
    y :: i32(0x0F0F);
    // bit_and
    and_result :: (x & y);
    comptime_assert(and_result == i32(0x000F));
    // bit_or
    or_result :: (x | y);
    comptime_assert(or_result == i32(0x0FFF));
    // bit_xor
    xor_result :: (x ^ y);
    comptime_assert(xor_result == i32(0x0FF0));
    // bit_not
    not_result :: ~(x);
    comptime_assert(not_result == i32(-(256))); // ~0xFF = -256 in two's complement i32
    // shl
    shl_result :: (i32(1) << i32(10));
    comptime_assert(shl_result == i32(1024));
    // shr (arithmetic shift for signed)
    shr_result :: (i32(1024) >> i32(3));
    comptime_assert(shr_result == i32(128));
    // Chained bitwise
    chained_or :: ((i32(0x01) | i32(0x10)) | i32(0x100));
    comptime_assert(chained_or == i32(0x111));
  };
});
test("Test comptime i64", {
  // Basic i64 values
  a :: i64(1000000000000);
  b :: i64(250000000000);
  c :: i64(1000000000000);
  zero :: i64(0);
  neg_val :: i64(-(500000000000));
  max_val :: i64.MAX;
  min_val :: i64.MIN;
  // Arithmetic operations
  sum :: (a + b); // 1250000000000i64
  diff :: (a - b); // 750000000000i64
  comptime_expect_error(prod :: (a * b)); // 250000000000000000000000i64 (may overflow)
  quot :: (a / b); // 4i64 (integer division)
  remainder :: (a % b); // 0i64
  // Unary operations
  neg_a :: -(a); // -1000000000000i64
  neg_zero :: -(zero); // 0i64
  // Comparison operations
  eq_test :: (a == c); // true
  eq_false :: (a == b); // false
  neq_test :: (a != b); // true
  neq_false :: (a != c); // false
  lt_test :: (b < a); // true
  lt_false :: (a < b); // false
  lte_test :: (b <= a); // true
  lte_equal :: (a <= c); // true
  gt_test :: (a > b); // true
  gt_false :: (b > a); // false
  gte_test :: (a >= b); // true
  gte_equal :: (a >= c); // true
  // Type conversion operations
  i64_to_f32 :: f32(a); // 1000000000000.0f32 (may lose precision)
  i64_to_f64 :: f64(a); // 1000000000000.0f64
  i64_to_string :: a.to_comptime_string(); // "1000000000000"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == i64(1250000000000));
  comptime_assert(diff == i64(750000000000));
  comptime_assert(quot == i64(4));
  comptime_assert(remainder == i64(0));
  // Unary operations
  comptime_assert(neg_a == i64(-(1000000000000)));
  comptime_assert(neg_zero == i64(0));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(i64_to_f64 == f64(1000000000000.0));
  comptime_assert(i64_to_string == "1000000000000");
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a); // -500000000000 + 1000000000000 = 500000000000i64
    neg_diff :: (neg_val - a); // -500000000000 - 1000000000000 = -1500000000000i64
    neg_prod :: (neg_val * i64(2)); // -500000000000 * 2 = -1000000000000i64
    neg_quot :: (neg_val / i64(10)); // -500000000000 / 10 = -50000000000i64
    // Comparisons with negatives
    neg_lt :: (neg_val < a); // true (-500000000000 < 1000000000000)
    neg_gt :: (a > neg_val); // true (1000000000000 > -500000000000)
    comptime_assert(neg_sum == i64(500000000000));
    comptime_assert(neg_diff == i64(-(1500000000000)));
    comptime_assert(neg_prod == i64(-(1000000000000)));
    comptime_assert(neg_quot == i64(-(50000000000)));
    comptime_assert(neg_lt == true);
    comptime_assert(neg_gt == true);
  };
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + i64(1)); // -9223372036854775807i64
    comptime_expect_error(min_sub :: (min_val - i64(1))); // overflow behavior
    min_neg :: -(min_val); // overflow: -(-9223372036854775808) should be handled
    // Operations with max value
    comptime_expect_error(max_sum :: (max_val + i64(1))); // overflow
    max_sub :: (max_val - i64(1)); // 9223372036854775806i64
    max_neg :: -(max_val); // -9223372036854775807i64
    comptime_assert(min_sum == i64(-(9223372036854775807)));
    comptime_assert(max_sub == i64(9223372036854775806));
    comptime_assert(max_neg == i64(-(9223372036854775807)));
    // Boundary comparisons
    comptime_assert(min_val < max_val);
    comptime_assert(max_val > min_val);
    comptime_assert(min_val <= max_val);
    comptime_assert(max_val >= min_val);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 1000000000000i64
    zero_diff1 :: (a - zero); // 1000000000000i64
    zero_diff2 :: (zero - a); // -1000000000000i64
    zero_prod :: (zero * a); // 0i64
    comptime_assert(zero_sum == i64(1000000000000));
    comptime_assert(zero_diff1 == i64(1000000000000));
    comptime_assert(zero_diff2 == i64(-(1000000000000)));
    comptime_assert(zero_prod == i64(0));
    // Identity operations
    identity_sum :: (a + zero); // 1000000000000i64
    identity_prod :: (a * i64(1)); // 1000000000000i64
    comptime_assert(identity_sum == i64(1000000000000));
    comptime_assert(identity_prod == i64(1000000000000));
    // Self operations
    self_sub :: (a - a); // 0i64
    self_div :: (a / a); // 1i64
    self_mod :: (a % a); // 0i64
    comptime_assert(self_sub == i64(0));
    comptime_assert(self_div == i64(1));
    comptime_assert(self_mod == i64(0));
  };
  // Test very large values
  {
    huge1 :: i64(1000000000000000000); // 10^18
    huge2 :: i64(500000000000000000); // 5 * 10^17
    huge_sum :: (huge1 + huge2); // 1.5 * 10^18
    huge_diff :: (huge1 - huge2); // 5 * 10^17
    huge_div :: (huge1 / i64(1000000)); // 10^12
    huge_mod :: (huge1 % i64(7)); // 1i64 (10^18 % 7 = 1)
    comptime_assert(huge_sum == i64(1500000000000000000));
    comptime_assert(huge_diff == i64(500000000000000000));
    comptime_assert(huge_div == i64(1000000000000));
    comptime_assert(huge_mod == i64(1));
  };
  // Test various divisions
  {
    div1 :: (i64(2000000000000) / i64(8)); // 250000000000i64
    div2 :: (i64(2000000000001) / i64(8)); // 250000000000i64 (integer division)
    div3 :: (i64(7) / i64(1000000000000)); // 0i64
    // Negative divisions
    div4 :: (i64(-(2000000000000)) / i64(8)); // -250000000000i64
    div5 :: (i64(2000000000000) / i64(-(8))); // -250000000000i64
    div6 :: (i64(-(2000000000000)) / i64(-(8))); // 250000000000i64
    comptime_assert(div1 == i64(250000000000));
    comptime_assert(div2 == i64(250000000000));
    comptime_assert(div3 == i64(0));
    comptime_assert(div4 == i64(-(250000000000)));
    comptime_assert(div5 == i64(-(250000000000)));
    comptime_assert(div6 == i64(250000000000));
  };
  // Test modulo operations
  {
    mod1 :: (i64(17) % i64(5)); // 2i64
    mod2 :: (i64(20) % i64(4)); // 0i64
    mod3 :: (i64(7) % i64(10)); // 7i64
    // Negative modulo
    mod4 :: (i64(-(17)) % i64(5)); // behavior depends on implementation
    mod5 :: (i64(17) % i64(-(5))); // behavior depends on implementation
    comptime_assert(mod1 == i64(2));
    comptime_assert(mod2 == i64(0));
    comptime_assert(mod3 == i64(7));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / i64(5)); // (10^12 + 2.5*10^11) / 5 = 2.5*10^11
    chain2 :: (a + (b * i64(2))); // 10^12 + (2.5*10^11 * 2) = 1.5*10^12
    chain3 :: ((a / b) + i64(1)); // (10^12 / 2.5*10^11) + 1 = 5i64
    comptime_assert(chain1 == i64(250000000000));
    comptime_assert(chain2 == i64(1500000000000));
    comptime_assert(chain3 == i64(5));
  };
  // Test powers of 2 (important for i64)
  {
    pow2_32 :: i64(4294967296); // 2^32
    pow2_40 :: i64(1099511627776); // 2^40
    div_pow2 :: (pow2_40 / pow2_32); // 256i64 (2^8)
    mod_pow2 :: (i64(4294967297) % pow2_32); // 1i64
    comptime_assert(div_pow2 == i64(256));
    comptime_assert(mod_pow2 == i64(1));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    neg_str :: neg_val.to_comptime_string();
    max_str :: max_val.to_comptime_string();
    min_str :: min_val.to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(neg_str == "-500000000000");
    // FIXME: JavaScript number has limit, should use BitInt in this case.
    // comptime_assert(max_str == "9223372036854775807");
    // comptime_assert(min_str == "-9223372036854775808");
  };
});
test("Test comptime isize", {
  // Basic isize values (values chosen to fit 32-bit isize for wasm32)
  a :: isize(10000);
  b :: isize(2500);
  c :: isize(10000);
  zero :: isize(0);
  neg_val :: isize(-(5000));
  // Arithmetic operations
  sum :: (a + b); // 12500isize
  diff :: (a - b); // 7500isize
  prod :: (a * b); // 25000000isize
  quot :: (a / b); // 4isize (integer division)
  remainder :: (a % b); // 0isize (10000 % 2500 = 0)
  // Unary operations
  neg_a :: -(a); // -10000isize
  neg_zero :: -(zero); // 0isize
  // Comparison operations
  eq_test :: (a == c); // true (100000isize == 100000isize)
  eq_false :: (a == b); // false (100000isize == 25000isize)
  neq_test :: (a != b); // true (100000isize != 25000isize)
  neq_false :: (a != c); // false (100000isize != 100000isize)
  lt_test :: (b < a); // true (25000isize < 100000isize)
  lt_false :: (a < b); // false (100000isize < 25000isize)
  lte_test :: (b <= a); // true (25000isize <= 100000isize)
  lte_equal :: (a <= c); // true (100000isize <= 100000isize)
  gt_test :: (a > b); // true (100000isize > 25000isize)
  gt_false :: (b > a); // false (25000isize > 100000isize)
  gte_test :: (a >= b); // true (100000isize >= 25000isize)
  gte_equal :: (a >= c); // true (100000isize >= 100000isize)
  // Type conversion operations
  isize_to_i64 :: i64(a); // 10000i64
  isize_to_u64 :: u64(a); // 10000u64
  isize_to_f32 :: f32(a); // 10000.0f32
  isize_to_f64 :: f64(a); // 10000.0f64
  isize_to_string :: a.to_comptime_string(); // "10000"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == isize(12500));
  comptime_assert(diff == isize(7500));
  comptime_assert(prod == isize(25000000));
  comptime_assert(quot == isize(4));
  comptime_assert(remainder == isize(0));
  // Unary operations
  comptime_assert(neg_a == isize(-(10000)));
  comptime_assert(neg_zero == isize(0));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(isize_to_i64 == i64(10000));
  comptime_assert(isize_to_u64 == u64(10000));
  comptime_assert(isize_to_f32 == f32(10000.0));
  comptime_assert(isize_to_f64 == f64(10000.0));
  comptime_assert(isize_to_string == "10000");
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a); // -5000 + 10000 = 5000isize
    neg_diff :: (neg_val - a); // -5000 - 10000 = -15000isize
    neg_prod :: (neg_val * isize(2)); // -5000 * 2 = -10000isize
    neg_quot :: (neg_val / isize(10)); // -5000 / 10 = -500isize
    // Comparisons with negatives
    neg_lt :: (neg_val < a); // true (-5000 < 10000)
    neg_gt :: (a > neg_val); // true (10000 > -5000)
    comptime_assert(neg_sum == isize(5000));
    comptime_assert(neg_diff == isize(-(15000)));
    comptime_assert(neg_prod == isize(-(10000)));
    comptime_assert(neg_quot == isize(-(500)));
    comptime_assert(neg_lt == true);
    comptime_assert(neg_gt == true);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 10000isize
    zero_diff1 :: (a - zero); // 10000isize
    zero_diff2 :: (zero - a); // -10000isize
    zero_prod :: (zero * a); // 0isize
    comptime_assert(zero_sum == isize(10000));
    comptime_assert(zero_diff1 == isize(10000));
    comptime_assert(zero_diff2 == isize(-(10000)));
    comptime_assert(zero_prod == isize(0));
    // Identity operations
    identity_sum :: (a + zero); // 10000isize
    identity_prod :: (a * isize(1)); // 10000isize
    comptime_assert(identity_sum == isize(10000));
    comptime_assert(identity_prod == isize(10000));
    // Self operations
    self_sub :: (a - a); // 0isize
    self_div :: (a / a); // 1isize
    self_mod :: (a % a); // 0isize
    comptime_assert(self_sub == isize(0));
    comptime_assert(self_div == isize(1));
    comptime_assert(self_mod == isize(0));
  };
  // Test larger values (safe on all platforms)
  {
    large1 :: isize(1000000);
    large2 :: isize(500000);
    large_sum :: (large1 + large2); // 1500000isize
    large_diff :: (large1 - large2); // 500000isize
    large_div :: (large1 / isize(1000)); // 1000isize
    large_mod :: (large1 % isize(7)); // 6isize (1000000 % 7 = 1)
    comptime_assert(large_sum == isize(1500000));
    comptime_assert(large_diff == isize(500000));
    comptime_assert(large_div == isize(1000));
    comptime_assert(large_mod == isize(1));
  };
  // Test various divisions
  {
    div1 :: (isize(200000) / isize(8)); // 25000isize
    div2 :: (isize(200001) / isize(8)); // 25000isize (integer division)
    div3 :: (isize(7) / isize(1000)); // 0isize
    // Negative divisions
    div4 :: (isize(-(200000)) / isize(8)); // -25000isize
    div5 :: (isize(200000) / isize(-(8))); // -25000isize
    div6 :: (isize(-(200000)) / isize(-(8))); // 25000isize
    comptime_assert(div1 == isize(25000));
    comptime_assert(div2 == isize(25000));
    comptime_assert(div3 == isize(0));
    comptime_assert(div4 == isize(-(25000)));
    comptime_assert(div5 == isize(-(25000)));
    comptime_assert(div6 == isize(25000));
  };
  // Test modulo operations
  {
    mod1 :: (isize(17) % isize(5)); // 2isize
    mod2 :: (isize(20) % isize(4)); // 0isize
    mod3 :: (isize(7) % isize(10)); // 7isize
    // Negative modulo
    mod4 :: (isize(-(17)) % isize(5)); // behavior depends on implementation
    mod5 :: (isize(17) % isize(-(5))); // behavior depends on implementation
    comptime_assert(mod1 == isize(2));
    comptime_assert(mod2 == isize(0));
    comptime_assert(mod3 == isize(7));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / isize(5)); // (10000isize + 2500isize) / 5isize = 2500isize
    chain2 :: (a + (b * isize(2))); // 10000isize + (2500isize * 2isize) = 15000isize
    chain3 :: ((a / b) + isize(1)); // (10000isize / 2500isize) + 1isize = 5isize
    comptime_assert(chain1 == isize(2500));
    comptime_assert(chain2 == isize(15000));
    comptime_assert(chain3 == isize(5));
  };
  // Test powers of 2 (common for pointer arithmetic)
  {
    pow2_10 :: isize(1024); // 2^10
    pow2_16 :: isize(65536); // 2^16
    div_pow2 :: (pow2_16 / pow2_10); // 64isize (2^6)
    mod_pow2 :: (isize(1025) % pow2_10); // 1isize
    comptime_assert(div_pow2 == isize(64));
    comptime_assert(mod_pow2 == isize(1));
  };
  // Test offset calculations (typical use case for isize)
  {
    base_offset :: isize(1000);
    positive_offset :: isize(500);
    negative_offset :: isize(-(200));
    forward_pos :: (base_offset + positive_offset); // 1500isize
    forward_neg :: (base_offset + negative_offset); // 800isize
    backward_pos :: (base_offset - positive_offset); // 500isize
    backward_neg :: (base_offset - negative_offset); // 1200isize
    comptime_assert(forward_pos == isize(1500));
    comptime_assert(forward_neg == isize(800));
    comptime_assert(backward_pos == isize(500));
    comptime_assert(backward_neg == isize(1200));
  };
  // Test difference calculations (common for pointer arithmetic)
  {
    ptr1 :: isize(1000);
    ptr2 :: isize(1500);
    ptr3 :: isize(800);
    diff1 :: (ptr2 - ptr1); // 500isize (positive difference)
    diff2 :: (ptr1 - ptr2); // -500isize (negative difference)
    diff3 :: (ptr1 - ptr3); // 200isize (positive difference)
    abs_diff1 :: (diff2 * isize(-(1))); // 500isize (absolute value simulation)
    comptime_assert(diff1 == isize(500));
    comptime_assert(diff2 == isize(-(500)));
    comptime_assert(diff3 == isize(200));
    comptime_assert(abs_diff1 == isize(500));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    neg_str :: neg_val.to_comptime_string();
    large_str :: isize(123456).to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(neg_str == "-5000");
    comptime_assert(large_str == "123456");
  };
});
test("Test comptime u8", {
  // Basic u8 values
  a :: u8(10);
  b :: u8(3);
  c :: u8(10);
  zero :: u8(0);
  max_u8 :: u8(255);
  one :: u8(1);
  // Arithmetic operations
  sum :: (a + b); // 13
  diff :: (a - b); // 7
  prod :: (a * b); // 30
  quot :: (a / b); // 3 (integer division)
  remainder :: (a % b); // 1
  // Comparison operations
  eq_test :: (a == c); // true (10 == 10)
  eq_false :: (a == b); // false (10 == 3)
  neq_test :: (a != b); // true (10 != 3)
  neq_false :: (a != c); // false (10 != 10)
  lt_test :: (b < a); // true (3 < 10)
  lt_false :: (a < b); // false (10 < 3)
  lte_test :: (b <= a); // true (3 <= 10)
  lte_equal :: (a <= c); // true (10 <= 10)
  gt_test :: (a > b); // true (10 > 3)
  gt_false :: (b > a); // false (3 > 10)
  gte_test :: (a >= b); // true (10 >= 3)
  gte_equal :: (a >= c); // true (10 >= 10)
  // Type conversion operations
  u8_to_string :: a.to_comptime_string(); // "10"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == u8(13));
  comptime_assert(diff == u8(7));
  comptime_assert(prod == u8(30));
  comptime_assert(quot == u8(3));
  comptime_assert(remainder == u8(1));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(u8_to_string == "10");
  // Test u8 boundary conditions
  {
    // Zero operations
    zero_sum :: (zero + a); // 10
    zero_diff1 :: (a - zero); // 10
    zero_prod :: (zero * a); // 0
    comptime_assert(zero_sum == u8(10));
    comptime_assert(zero_diff1 == u8(10));
    comptime_assert(zero_prod == u8(0));
    // Max value operations
    max_minus_one :: (max_u8 - one); // 254
    max_div_two :: (max_u8 / u8(2)); // 127
    max_mod_ten :: (max_u8 % u8(10)); // 5 (255 % 10 = 5)
    comptime_assert(max_minus_one == u8(254));
    comptime_assert(max_div_two == u8(127));
    comptime_assert(max_mod_ten == u8(5));
    // Test max value comparisons
    max_gt_zero :: (max_u8 > zero); // true
    max_eq_255 :: (max_u8 == u8(255)); // true
    zero_lt_max :: (zero < max_u8); // true
    comptime_assert(max_gt_zero == true);
    comptime_assert(max_eq_255 == true);
    comptime_assert(zero_lt_max == true);
  };
  // Test identity operations
  {
    identity_sum :: (a + zero); // 10
    identity_prod :: (a * one); // 10
    comptime_assert(identity_sum == u8(10));
    comptime_assert(identity_prod == u8(10));
    // Self operations
    self_sub :: (a - a); // 0
    self_div :: (a / a); // 1
    self_mod :: (a % a); // 0
    comptime_assert(self_sub == u8(0));
    comptime_assert(self_div == u8(1));
    comptime_assert(self_mod == u8(0));
  };
  // Test medium-sized numbers within u8 range
  {
    med1 :: u8(100);
    med2 :: u8(50);
    med_sum :: (med1 + med2); // 150
    med_diff :: (med1 - med2); // 50
    med_prod :: (med2 * u8(2)); // 100
    med_div :: (med1 / u8(5)); // 20
    med_mod :: (med1 % u8(7)); // 2 (100 % 7 = 2)
    comptime_assert(med_sum == u8(150));
    comptime_assert(med_diff == u8(50));
    comptime_assert(med_prod == u8(100));
    comptime_assert(med_div == u8(20));
    comptime_assert(med_mod == u8(2));
    // String conversion of medium numbers
    med_str :: med1.to_comptime_string();
    comptime_assert(med_str == "100");
  };
  // Test modulo with different numbers
  {
    mod_tests1 :: (u8(17) % u8(5)); // 2
    mod_tests2 :: (u8(20) % u8(4)); // 0
    mod_tests3 :: (u8(7) % u8(10)); // 7
    comptime_assert(mod_tests1 == u8(2));
    comptime_assert(mod_tests2 == u8(0));
    comptime_assert(mod_tests3 == u8(7));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) * u8(2)); // (10 + 3) * 2 = 26
    chain2 :: (a + (b * u8(2))); // 10 + (3 * 2) = 16
    chain3 :: ((a / b) + one); // (10 / 3) + 1 = 3 + 1 = 4
    comptime_assert(chain1 == u8(26));
    comptime_assert(chain2 == u8(16));
    comptime_assert(chain3 == u8(4));
  };
  // Test conversion consistency
  {
    num :: u8(42);
    string_conv :: num.to_comptime_string();
    comptime_assert(string_conv == "42");
    // Test max value string conversion
    max_string :: max_u8.to_comptime_string();
    comptime_assert(max_string == "255");
    // Test zero string conversion
    zero_string :: zero.to_comptime_string();
    comptime_assert(zero_string == "0");
  };
  // Test division edge cases
  {
    // Various divisions
    div1 :: (u8(15) / u8(3)); // 5
    div2 :: (u8(16) / u8(3)); // 5 (integer division)
    div3 :: (u8(2) / u8(5)); // 0
    comptime_assert(div1 == u8(5));
    comptime_assert(div2 == u8(5));
    comptime_assert(div3 == u8(0));
    // Test max value divisions
    max_div_max :: (max_u8 / max_u8); // 1
    max_div_one :: (max_u8 / one); // 255
    comptime_assert(max_div_max == u8(1));
    comptime_assert(max_div_one == u8(255));
  };
  // Test boundary arithmetic that should wrap/saturate
  {
    // Note: These tests assume the implementation handles overflow correctly
    // For u8, values should wrap around or be clamped to 0-255 range
    near_max :: u8(250);
    small_add :: (near_max + u8(3)); // Should be 253
    comptime_assert(small_add == u8(253));
    // Test subtraction near zero
    small_val :: u8(3);
    small_sub :: (small_val - u8(2)); // Should be 1
    comptime_assert(small_sub == u8(1));
  };
});
test("Test comptime u16", {
  // Basic u16 values
  a :: u16(1000);
  b :: u16(250);
  c :: u16(1000);
  zero :: u16(0);
  max_val :: u16.MAX;
  // Arithmetic operations
  sum :: (a + b); // 1250u16
  diff :: (a - b); // 750u16
  comptime_expect_error(prod :: (a * b)); // 250000u16 (may overflow and wrap)
  quot :: (a / b); // 4u16 (integer division)
  remainder :: (a % b); // 0u16 (1000 % 250 = 0)
  // Comparison operations
  eq_test :: (a == c); // true (1000u16 == 1000u16)
  eq_false :: (a == b); // false (1000u16 == 250u16)
  neq_test :: (a != b); // true (1000u16 != 250u16)
  neq_false :: (a != c); // false (1000u16 != 1000u16)
  lt_test :: (b < a); // true (250u16 < 1000u16)
  lt_false :: (a < b); // false (1000u16 < 250u16)
  lte_test :: (b <= a); // true (250u16 <= 1000u16)
  lte_equal :: (a <= c); // true (1000u16 <= 1000u16)
  gt_test :: (a > b); // true (1000u16 > 250u16)
  gt_false :: (b > a); // false (250u16 > 1000u16)
  gte_test :: (a >= b); // true (1000u16 >= 250u16)
  gte_equal :: (a >= c); // true (1000u16 >= 1000u16)
  // Type conversion operations
  u16_to_u32 :: u32(a); // 1000u32
  u16_to_i32 :: i32(a); // 1000i32
  u16_to_f32 :: f32(a); // 1000.0f32
  u16_to_string :: a.to_comptime_string(); // "1000"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == u16(1250));
  comptime_assert(diff == u16(750));
  comptime_assert(quot == u16(4));
  comptime_assert(remainder == u16(0));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(u16_to_u32 == u32(1000));
  comptime_assert(u16_to_i32 == i32(1000));
  comptime_assert(u16_to_f32 == (f32(1000.0)));
  comptime_assert(u16_to_string == "1000");
  // Test boundary values
  {
    min_val :: u16(0);
    // Operations with min value
    min_sum :: (min_val + u16(1)); // 1u16
    comptime_expect_error(min_sub :: (min_val - u16(1))); // 65535u16 (underflow wraps)
    min_mult :: (min_val * u16(500)); // 0u16
    // Operations with max value
    comptime_expect_error(max_sum :: (max_val + u16(1))); // 0u16 (overflow wraps)
    max_sub :: (max_val - u16(1)); // 65534u16
    max_div :: (max_val / u16(13)); // 5041u16
    max_mod :: (max_val % u16(100)); // 35u16 (65535 % 100 = 35)
    comptime_assert(min_sum == u16(1));
    comptime_assert(min_mult == u16(0));
    comptime_assert(max_sub == u16(65534));
    comptime_assert(max_div == u16(5041));
    comptime_assert(max_mod == u16(35));
    // Boundary comparisons
    comptime_assert(min_val < max_val);
    comptime_assert(max_val > min_val);
    comptime_assert(min_val <= max_val);
    comptime_assert(max_val >= min_val);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 1000u16
    zero_diff1 :: (a - zero); // 1000u16
    comptime_expect_error(zero_diff2 :: (zero - a)); // underflow behavior
    zero_prod :: (zero * a); // 0u16
    comptime_assert(zero_sum == u16(1000));
    comptime_assert(zero_diff1 == u16(1000));
    comptime_assert(zero_prod == u16(0));
    // Identity operations
    identity_sum :: (a + zero); // 1000u16
    identity_prod :: (a * u16(1)); // 1000u16
    comptime_assert(identity_sum == u16(1000));
    comptime_assert(identity_prod == u16(1000));
    // Self operations
    self_sub :: (a - a); // 0u16
    self_div :: (a / a); // 1u16
    self_mod :: (a % a); // 0u16
    comptime_assert(self_sub == u16(0));
    comptime_assert(self_div == u16(1));
    comptime_assert(self_mod == u16(0));
  };
  // Test large values
  {
    large1 :: u16(50000);
    large2 :: u16(15000);
    large_sum :: (large1 + large2); // 65000u16
    large_diff :: (large1 - large2); // 35000u16
    large_div :: (large1 / u16(10)); // 5000u16
    large_mod :: (large1 % u16(7)); // 1u16 (50000 % 7 = 6)
    comptime_assert(large_sum == u16(65000));
    comptime_assert(large_diff == u16(35000));
    comptime_assert(large_div == u16(5000));
    comptime_assert(large_mod == u16(6));
  };
  // Test various divisions
  {
    div1 :: (u16(2000) / u16(8)); // 250u16
    div2 :: (u16(2001) / u16(8)); // 250u16 (integer division)
    div3 :: (u16(7) / u16(100)); // 0u16
    comptime_assert(div1 == u16(250));
    comptime_assert(div2 == u16(250));
    comptime_assert(div3 == u16(0));
  };
  // Test modulo operations
  {
    mod1 :: (u16(17) % u16(5)); // 2u16
    mod2 :: (u16(20) % u16(4)); // 0u16
    mod3 :: (u16(7) % u16(10)); // 7u16
    mod4 :: (u16(65535) % u16(256)); // 255u16
    comptime_assert(mod1 == u16(2));
    comptime_assert(mod2 == u16(0));
    comptime_assert(mod3 == u16(7));
    comptime_assert(mod4 == u16(255));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) * u16(2)); // (1000u16 + 250u16) * 2u16 = 2500u16
    chain2 :: (a + (b * u16(2))); // 1000u16 + (250u16 * 2u16) = 1500u16
    chain3 :: ((a / b) + u16(1)); // (1000u16 / 250u16) + 1u16 = 5u16
    comptime_assert(chain1 == u16(2500));
    comptime_assert(chain2 == u16(1500));
    comptime_assert(chain3 == u16(5));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    max_str :: max_val.to_comptime_string();
    large_str :: u16(12345).to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(max_str == "65535");
    comptime_assert(large_str == "12345");
  };
});
test("Test comptime u32", {
  // Basic u32 values
  a :: u32(100000);
  b :: u32(25000);
  c :: u32(100000);
  zero :: u32(0);
  max_val :: u32.MAX;
  // Arithmetic operations
  sum :: (a + b); // 125000u32
  diff :: (a - b); // 75000u32
  prod :: (a * b); // 2500000000u32
  quot :: (a / b); // 4u32 (integer division)
  remainder :: (a % b); // 0u32 (100000 % 25000 = 0)
  // Comparison operations
  eq_test :: (a == c); // true (100000u32 == 100000u32)
  eq_false :: (a == b); // false (100000u32 == 25000u32)
  neq_test :: (a != b); // true (100000u32 != 25000u32)
  neq_false :: (a != c); // false (100000u32 != 100000u32)
  lt_test :: (b < a); // true (25000u32 < 100000u32)
  lt_false :: (a < b); // false (100000u32 < 25000u32)
  lte_test :: (b <= a); // true (25000u32 <= 100000u32)
  lte_equal :: (a <= c); // true (100000u32 <= 100000u32)
  gt_test :: (a > b); // true (100000u32 > 25000u32)
  gt_false :: (b > a); // false (25000u32 > 100000u32)
  gte_test :: (a >= b); // true (100000u32 >= 25000u32)
  gte_equal :: (a >= c); // true (100000u32 >= 100000u32)
  // Type conversion operations
  u32_to_u64 :: u64(a); // 100000u64
  u32_to_i64 :: i64(a); // 100000i64
  u32_to_f32 :: f32(a); // 100000.0f32
  u32_to_f64 :: f64(a); // 100000.0f64
  u32_to_string :: a.to_comptime_string(); // "100000"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == u32(125000));
  comptime_assert(diff == u32(75000));
  comptime_assert(prod == u32(2500000000));
  comptime_assert(quot == u32(4));
  comptime_assert(remainder == u32(0));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(u32_to_u64 == u64(100000));
  comptime_assert(u32_to_i64 == i64(100000));
  comptime_assert(u32_to_f32 == f32(100000.0));
  comptime_assert(u32_to_f64 == f64(100000.0));
  comptime_assert(u32_to_string == "100000");
  // Test boundary values
  {
    min_val :: u32(0);
    // Operations with min value
    min_sum :: (min_val + u32(1)); // 1u32
    comptime_expect_error(min_sub :: (min_val - u32(1))); // underflow wraps to max
    min_mult :: (min_val * u32(500000)); // 0u32
    // Operations with max value
    comptime_expect_error(max_sum :: (max_val + u32(1))); // 0u32 (overflow wraps)
    max_sub :: (max_val - u32(1)); // 4294967294u32
    max_div :: (max_val / u32(100)); // 42949672u32
    max_mod :: (max_val % u32(1000)); // 295u32
    comptime_assert(min_sum == u32(1));
    comptime_assert(min_mult == u32(0));
    comptime_assert(max_sub == u32(4294967294));
    comptime_assert(max_div == u32(42949672));
    comptime_assert(max_mod == u32(295));
    // Boundary comparisons
    comptime_assert(min_val < max_val);
    comptime_assert(max_val > min_val);
    comptime_assert(min_val <= max_val);
    comptime_assert(max_val >= min_val);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 100000u32
    zero_diff1 :: (a - zero); // 100000u32
    comptime_expect_error(zero_diff2 :: (zero - a)); // underflow behavior
    zero_prod :: (zero * a); // 0u32
    comptime_assert(zero_sum == u32(100000));
    comptime_assert(zero_diff1 == u32(100000));
    comptime_assert(zero_prod == u32(0));
    // Identity operations
    identity_sum :: (a + zero); // 100000u32
    identity_prod :: (a * u32(1)); // 100000u32
    comptime_assert(identity_sum == u32(100000));
    comptime_assert(identity_prod == u32(100000));
    // Self operations
    self_sub :: (a - a); // 0u32
    self_div :: (a / a); // 1u32
    self_mod :: (a % a); // 0u32
    comptime_assert(self_sub == u32(0));
    comptime_assert(self_div == u32(1));
    comptime_assert(self_mod == u32(0));
  };
  // Test large values
  {
    large1 :: u32(2000000000);
    large2 :: u32(1500000000);
    large_sum :: (large1 + large2); // 3500000000u32
    large_diff :: (large1 - large2); // 500000000u32
    large_div :: (large1 / u32(1000)); // 2000000u32
    large_mod :: (large1 % u32(7)); // 2u32 (2000000000 % 7 = 5)
    comptime_assert(large_sum == u32(3500000000));
    comptime_assert(large_diff == u32(500000000));
    comptime_assert(large_div == u32(2000000));
    comptime_assert(large_mod == u32(5));
  };
  // Test various divisions
  {
    div1 :: (u32(200000) / u32(8)); // 25000u32
    div2 :: (u32(200001) / u32(8)); // 25000u32 (integer division)
    div3 :: (u32(7) / u32(1000)); // 0u32
    comptime_assert(div1 == u32(25000));
    comptime_assert(div2 == u32(25000));
    comptime_assert(div3 == u32(0));
  };
  // Test modulo operations
  {
    mod1 :: (u32(17) % u32(5)); // 2u32
    mod2 :: (u32(20) % u32(4)); // 0u32
    mod3 :: (u32(7) % u32(10)); // 7u32
    mod4 :: (u32(1000000) % u32(997)); // 9u32 (1000000 % 997 = 9)
    comptime_assert(mod1 == u32(2));
    comptime_assert(mod2 == u32(0));
    comptime_assert(mod3 == u32(7));
    comptime_assert(mod4 == u32(9));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / u32(5)); // (100000u32 + 25000u32) / 5u32 = 25000u32
    chain2 :: (a + (b * u32(2))); // 100000u32 + (25000u32 * 2u32) = 150000u32
    chain3 :: ((a / b) + u32(1)); // (100000u32 / 25000u32) + 1u32 = 5u32
    comptime_assert(chain1 == u32(25000));
    comptime_assert(chain2 == u32(150000));
    comptime_assert(chain3 == u32(5));
  };
  // Test powers of 2 (common in systems programming)
  {
    pow2_10 :: u32(1024); // 2^10
    pow2_20 :: u32(1048576); // 2^20
    div_pow2 :: (pow2_20 / pow2_10); // 1024u32
    mod_pow2 :: (u32(1025) % pow2_10); // 1u32
    comptime_assert(div_pow2 == u32(1024));
    comptime_assert(mod_pow2 == u32(1));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    max_str :: max_val.to_comptime_string();
    large_str :: u32(123456789).to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(max_str == "4294967295");
    comptime_assert(large_str == "123456789");
  };
  // Bitwise operations
  {
    x :: u32(0xFF00);
    y :: u32(0x0FF0);
    // bit_and
    and_result :: (x & y);
    comptime_assert(and_result == u32(0x0F00));
    // bit_or
    or_result :: (x | y);
    comptime_assert(or_result == u32(0xFFF0));
    // bit_xor
    xor_result :: (x ^ y);
    comptime_assert(xor_result == u32(0xF0F0));
    // bit_not
    not_result :: ~(x);
    comptime_assert(not_result == u32(0xFFFF00FF));
    // shl
    shl_result :: (u32(1) << u32(8));
    comptime_assert(shl_result == u32(256));
    // shr
    shr_result :: (u32(256) >> u32(4));
    comptime_assert(shr_result == u32(16));
    // Chained bitwise (left-to-right nesting)
    chained_or :: ((u32(0x0001) | u32(0x0010)) | u32(0x0100));
    comptime_assert(chained_or == u32(0x0111));
    chained_and :: ((u32(0xFFFF) & u32(0x0FF0)) & u32(0x00F0));
    comptime_assert(chained_and == u32(0x00F0));
    // Mask and test pattern (the original bug scenario)
    S_IWUSR :: u32(0o0200);
    S_IWGRP :: u32(0o0020);
    mask :: (S_IWUSR | S_IWGRP);
    comptime_assert(mask == u32(0o0220));
    // Verify the result type is u32, not i32
    // This was the original bug: comptime bitwise on u32 produced ComptimeInt -> i32
    zero_masked :: (u32(0) & mask);
    comptime_assert(zero_masked == u32(0));
    full_masked :: (u32(0o0220) & mask);
    comptime_assert(full_masked == u32(0o0220));
  };
});
test("Test comptime u64", {
  // Basic u64 values
  a :: u64(1000000000000);
  b :: u64(250000000000);
  c :: u64(1000000000000);
  zero :: u64(0);
  max_val :: u64.MAX;
  // Arithmetic operations
  sum :: (a + b); // 1250000000000u64
  diff :: (a - b); // 750000000000u64
  comptime_expect_error(prod :: (a * b)); // 250000000000000000000000u64 (may overflow)
  quot :: (a / b); // 4u64 (integer division)
  remainder :: (a % b); // 0u64
  // Comparison operations
  eq_test :: (a == c); // true
  eq_false :: (a == b); // false
  neq_test :: (a != b); // true
  neq_false :: (a != c); // false
  lt_test :: (b < a); // true
  lt_false :: (a < b); // false
  lte_test :: (b <= a); // true
  lte_equal :: (a <= c); // true
  gt_test :: (a > b); // true
  gt_false :: (b > a); // false
  gte_test :: (a >= b); // true
  gte_equal :: (a >= c); // true
  // Type conversion operations
  u64_to_f32 :: f32(a); // 1000000000000.0f32 (may lose precision)
  u64_to_f64 :: f64(a); // 1000000000000.0f64
  u64_to_string :: a.to_comptime_string(); // "1000000000000"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == u64(1250000000000));
  comptime_assert(diff == u64(750000000000));
  comptime_assert(quot == u64(4));
  comptime_assert(remainder == u64(0));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(u64_to_f64 == f64(1000000000000.0));
  comptime_assert(u64_to_string == "1000000000000");
  // Test boundary values
  {
    min_val :: u64(0);
    // Operations with min value
    min_sum :: (min_val + u64(1)); // 1u64
    comptime_expect_error(min_sub :: (min_val - u64(1))); // underflow wraps to max
    min_mult :: (min_val * u64(5000000)); // 0u64
    // Operations with large values near max
    large_val :: u64(9223372036854775807); // Close to max
    large_sum :: (large_val + u64(1000)); // Still within range
    large_mult :: (large_val / u64(1000)); // 9223372036854775u64
    comptime_assert(min_sum == u64(1));
    comptime_assert(min_mult == u64(0));
    comptime_assert(large_sum == u64(9223372036854776807));
    comptime_assert(large_mult == u64(9223372036854775));
    // Boundary comparisons
    comptime_assert(min_val < large_val);
    comptime_assert(large_val > min_val);
    comptime_assert(min_val <= large_val);
    comptime_assert(large_val >= min_val);
  };
  // Test zero operations
  {
    zero_sum :: (zero + a); // 1000000000000u64
    zero_diff1 :: (a - zero); // 1000000000000u64
    comptime_expect_error(zero_diff2 :: (zero - a)); // underflow behavior
    zero_prod :: (zero * a); // 0u64
    comptime_assert(zero_sum == u64(1000000000000));
    comptime_assert(zero_diff1 == u64(1000000000000));
    comptime_assert(zero_prod == u64(0));
    // Identity operations
    identity_sum :: (a + zero); // 1000000000000u64
    identity_prod :: (a * u64(1)); // 1000000000000u64
    comptime_assert(identity_sum == u64(1000000000000));
    comptime_assert(identity_prod == u64(1000000000000));
    // Self operations
    self_sub :: (a - a); // 0u64
    self_div :: (a / a); // 1u64
    self_mod :: (a % a); // 0u64
    comptime_assert(self_sub == u64(0));
    comptime_assert(self_div == u64(1));
    comptime_assert(self_mod == u64(0));
  };
  // Test very large values
  {
    huge1 :: u64(1000000000000000000); // 10^18
    huge2 :: u64(500000000000000000); // 5 * 10^17
    huge_sum :: (huge1 + huge2); // 1.5 * 10^18
    huge_diff :: (huge1 - huge2); // 5 * 10^17
    huge_div :: (huge1 / u64(1000000)); // 10^12
    huge_mod :: (huge1 % u64(7)); // 1u64 (10^18 % 7 = 1)
    comptime_assert(huge_sum == u64(1500000000000000000));
    comptime_assert(huge_diff == u64(500000000000000000));
    comptime_assert(huge_div == u64(1000000000000));
    comptime_assert(huge_mod == u64(1));
  };
  // Test various divisions
  {
    div1 :: (u64(2000000000000) / u64(8)); // 250000000000u64
    div2 :: (u64(2000000000001) / u64(8)); // 250000000000u64 (integer division)
    div3 :: (u64(7) / u64(1000000000000)); // 0u64
    comptime_assert(div1 == u64(250000000000));
    comptime_assert(div2 == u64(250000000000));
    comptime_assert(div3 == u64(0));
  };
  // Test modulo operations
  {
    mod1 :: (u64(17) % u64(5)); // 2u64
    mod2 :: (u64(20) % u64(4)); // 0u64
    mod3 :: (u64(7) % u64(10)); // 7u64
    mod4 :: (u64(1000000000000000000) % u64(997)); // Large modulo
    comptime_assert(mod1 == u64(2));
    comptime_assert(mod2 == u64(0));
    comptime_assert(mod3 == u64(7));
    // mod4 result depends on calculation
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / u64(5)); // (10^12 + 2.5*10^11) / 5 = 2.5*10^11
    chain2 :: (a + (b * u64(2))); // 10^12 + (2.5*10^11 * 2) = 1.5*10^12
    chain3 :: ((a / b) + u64(1)); // (10^12 / 2.5*10^11) + 1 = 5u64
    comptime_assert(chain1 == u64(250000000000));
    comptime_assert(chain2 == u64(1500000000000));
    comptime_assert(chain3 == u64(5));
  };
  // Test powers of 2 (important for u64)
  {
    pow2_32 :: u64(4294967296); // 2^32
    pow2_40 :: u64(1099511627776); // 2^40
    div_pow2 :: (pow2_40 / pow2_32); // 256u64 (2^8)
    mod_pow2 :: (u64(4294967297) % pow2_32); // 1u64
    comptime_assert(div_pow2 == u64(256));
    comptime_assert(mod_pow2 == u64(1));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    large_str :: u64(123456789012345).to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(large_str == "123456789012345");
  };
});
test("Test comptime usize", {
  // Basic usize values
  a :: usize(100000);
  b :: usize(25000);
  c :: usize(100000);
  zero :: usize(0);
  // Arithmetic operations
  sum :: (a + b); // 125000usize
  diff :: (a - b); // 75000usize
  prod :: (a * b); // 2500000000usize
  quot :: (a / b); // 4usize (integer division)
  remainder :: (a % b); // 0usize (100000 % 25000 = 0)
  // Comparison operations
  eq_test :: (a == c); // true (100000usize == 100000usize)
  eq_false :: (a == b); // false (100000usize == 25000usize)
  neq_test :: (a != b); // true (100000usize != 25000usize)
  neq_false :: (a != c); // false (100000usize != 100000usize)
  lt_test :: (b < a); // true (25000usize < 100000usize)
  lt_false :: (a < b); // false (100000usize < 25000usize)
  lte_test :: (b <= a); // true (25000usize <= 100000usize)
  lte_equal :: (a <= c); // true (100000usize <= 100000usize)
  gt_test :: (a > b); // true (100000usize > 25000usize)
  gt_false :: (b > a); // false (25000usize > 100000usize)
  gte_test :: (a >= b); // true (100000usize >= 25000usize)
  gte_equal :: (a >= c); // true (100000usize >= 100000usize)
  // Type conversion operations
  usize_to_u64 :: u64(a); // 100000u64
  usize_to_i64 :: i64(a); // 100000i64
  usize_to_f32 :: f32(a); // 100000.0f32
  usize_to_f64 :: f64(a); // 100000.0f64
  usize_to_string :: a.to_comptime_string(); // "100000"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == usize(125000));
  comptime_assert(diff == usize(75000));
  comptime_assert(prod == usize(2500000000));
  comptime_assert(quot == (usize(4)));
  comptime_assert(remainder == (usize(0)));
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(usize_to_u64 == u64(100000));
  comptime_assert(usize_to_i64 == i64(100000));
  comptime_assert(usize_to_f32 == f32(100000.0));
  comptime_assert(usize_to_f64 == f64(100000.0));
  comptime_assert(usize_to_string == "100000");
  // Test zero operations
  {
    zero_sum :: (zero + a); // 100000usize
    zero_diff1 :: (a - zero); // 100000usize
    comptime_expect_error(zero_diff2 :: (zero - a)); // underflow behavior (wraps around)
    zero_prod :: (zero * a); // 0usize
    comptime_assert(zero_sum == usize(100000));
    comptime_assert(zero_diff1 == usize(100000));
    comptime_assert(zero_prod == usize(0));
    // Identity operations
    identity_sum :: (a + zero); // 100000usize
    identity_prod :: (a * usize(1)); // 100000usize
    comptime_assert(identity_sum == usize(100000));
    comptime_assert(identity_prod == usize(100000));
    // Self operations
    self_sub :: (a - a); // 0usize
    self_div :: (a / a); // 1usize
    self_mod :: (a % a); // 0usize
    comptime_assert(self_sub == (usize(0)));
    comptime_assert(self_div == (usize(1)));
    comptime_assert(self_mod == (usize(0)));
  };
  // Test larger values (safe on all platforms)
  {
    large1 :: usize(1000000);
    large2 :: usize(500000);
    large_sum :: (large1 + large2); // 1500000usize
    large_diff :: (large1 - large2); // 500000usize
    large_div :: (large1 / usize(1000)); // 1000usize
    large_mod :: (large1 % usize(7)); // 6usize (1000000 % 7 = 1)
    comptime_assert(large_sum == usize(1500000));
    comptime_assert(large_diff == usize(500000));
    comptime_assert(large_div == usize(1000));
    comptime_assert(large_mod == (usize(1)));
  };
  // Test various divisions
  {
    div1 :: (usize(200000) / usize(8)); // 25000usize
    div2 :: (usize(200001) / usize(8)); // 25000usize (integer division)
    div3 :: (usize(7) / usize(1000)); // 0usize
    comptime_assert(div1 == usize(25000));
    comptime_assert(div2 == usize(25000));
    comptime_assert(div3 == (usize(0)));
  };
  // Test modulo operations
  {
    mod1 :: (usize(17) % usize(5)); // 2usize
    mod2 :: (usize(20) % usize(4)); // 0usize
    mod3 :: (usize(7) % usize(10)); // 7usize
    mod4 :: (usize(1000000) % usize(997)); // 9usize (1000000 % 997 = 9)
    comptime_assert(mod1 == (usize(2)));
    comptime_assert(mod2 == (usize(0)));
    comptime_assert(mod3 == (usize(7)));
    comptime_assert(mod4 == (usize(9)));
  };
  // Test chained operations
  {
    chain1 :: ((a + b) / usize(5)); // (100000usize + 25000usize) / 5usize = 25000usize
    chain2 :: (a + (b * usize(2))); // 100000usize + (25000usize * 2usize) = 150000usize
    chain3 :: ((a / b) + usize(1)); // (100000usize / 25000usize) + 1usize = 5usize
    comptime_assert(chain1 == usize(25000));
    comptime_assert(chain2 == usize(150000));
    comptime_assert(chain3 == (usize(5)));
  };
  // Test powers of 2 (common for array indexing)
  {
    pow2_10 :: usize(1024); // 2^10
    pow2_16 :: usize(65536); // 2^16
    div_pow2 :: (pow2_16 / pow2_10); // 64usize (2^6)
    mod_pow2 :: (usize(1025) % pow2_10); // 1usize
    comptime_assert(div_pow2 == usize(64));
    comptime_assert(mod_pow2 == (usize(1)));
  };
  // Test memory-related sizes (typical use case for usize)
  {
    byte_size :: usize(1);
    kb_size :: usize(1024);
    mb_size :: usize(1048576); // 1024 * 1024
    kb_in_bytes :: (kb_size / byte_size); // 1024usize
    mb_in_kb :: (mb_size / kb_size); // 1024usize
    partial_mb :: (usize(1500000) / mb_size); // 1usize (integer division)
    comptime_assert(kb_in_bytes == usize(1024));
    comptime_assert(mb_in_kb == usize(1024));
    comptime_assert(partial_mb == (usize(1)));
  };
  // Test string conversions
  {
    zero_str :: zero.to_comptime_string();
    large_str :: usize(123456).to_comptime_string();
    comptime_assert(zero_str == "0");
    comptime_assert(large_str == "123456");
  };
  // Test array indexing scenarios (common usize usage)
  {
    // Simulate array bounds calculations
    array_len :: usize(100);
    index1 :: usize(50);
    index2 :: usize(99);
    within_bounds1 :: (index1 < array_len); // true
    within_bounds2 :: (index2 < array_len); // true
    out_of_bounds :: (array_len < array_len); // false
    last_index :: (array_len - usize(1)); // 99usize
    mid_index :: (array_len / usize(2)); // 50usize
    comptime_assert(within_bounds1 == true);
    comptime_assert(within_bounds2 == true);
    comptime_assert(out_of_bounds == false);
    comptime_assert(last_index == usize(99));
    comptime_assert(mid_index == usize(50));
  };
});
test("Test types compatibility", {
  comptime_assert(__yo_are_types_compatible(i32, i32) == true); // true
  comptime_assert(__yo_are_types_compatible(i32, i64) == false); // false
  comptime_assert(__yo_are_types_compatible(i64, i32) == false); // false
  // Functions
  comptime_assert(
    __yo_are_types_compatible(
      // true
      fn(x : i32, y : i32) -> i32,
      fn(a : i32, y : i32) -> i32
    ) == true
  );
  comptime_assert(
    __yo_are_types_compatible(
      // true
      fn(generic(T : Type), x : T, y : T) -> T,
      fn(generic(Z : Type), a : Z, b : Z) -> Z
    ) == true
  );
  comptime_assert(
    __yo_are_types_compatible(
      // false
      fn(generic(T : Type), x : T, y : T) -> T,
      fn(a : i32, b : i32) -> i32
    ) == false
  );
  comptime_assert(
    __yo_are_types_compatible(
      // false
      fn(a : i32, b : i32) -> i32,
      fn(generic(T : Type), x : T, y : T) -> T
    ) == false
  );
  MyBox :: (fn(comptime(T) : Type) -> comptime(Type))(struct(value : T));
  comptime_assert(
    __yo_are_types_compatible(
      // true
      fn(generic(T : Type), x : T) -> MyBox(T),
      fn(generic(Z : Type), a : Z) -> MyBox(Z)
    ) == true
  );
  Point :: (fn(comptime(T) : Type) -> comptime(Type))(struct(x : T, y : T));
  comptime_assert(
    __yo_are_types_compatible(
      // true
      fn(generic(T : Type), x : T, y : T) -> Point(T),
      fn(generic(Z : Type), a : Z, b : Z) -> Point(Z)
    ) == true
  );
  // Test pointer type compatibility
  PtrFunc1 ::
    (fn(x : *(i32)) -> unit);
  PtrFunc2 ::
    (fn(x : *(i32)) -> unit);
  comptime_assert(__yo_are_types_compatible(PtrFunc1, PtrFunc2) == true);
  comptime_assert(__yo_are_types_compatible(PtrFunc2, PtrFunc1) == true);
});
test("Test char literals", {
  // Test simple ASCII characters
  char_a :: 'a';
  comptime_assert(char_a == 97, "char 'a' should be 97");
  char_z :: 'z';
  comptime_assert(char_z == 122, "char 'z' should be 122");
  char_0 :: '0';
  comptime_assert(char_0 == 48, "char '0' should be 48");
  char_9 :: '9';
  comptime_assert(char_9 == 57, "char '9' should be 57");
  char_space :: ' ';
  comptime_assert(char_space == 32, "char ' ' should be 32");
  // Test newline
  char_newline :: '\n';
  comptime_assert(char_newline == 10, "char '\\n' should be 10");
  // Test tab
  char_tab :: '\t';
  comptime_assert(char_tab == 9, "char '\\t' should be 9");
  // Test carriage return
  char_cr :: '\r';
  comptime_assert(char_cr == 13, "char '\\r' should be 13");
  // Test backslash
  char_backslash :: '\\';
  comptime_assert(char_backslash == 92, "char '\\\\' should be 92");
  // Test single quote
  char_quote :: '\'';
  comptime_assert(char_quote == 39, "char '\\'' should be 39");
  // Test null character
  char_null :: '\0';
  comptime_assert(char_null == 0, "char '\\0' should be 0");
  // Test bell
  char_bell :: '\a';
  comptime_assert(char_bell == 7, "char '\\a' should be 7");
  // Test backspace
  char_backspace :: '\b';
  comptime_assert(char_backspace == 8, "char '\\b' should be 8");
  // Test form feed
  char_form_feed :: '\f';
  comptime_assert(char_form_feed == 12, "char '\\f' should be 12");
  // Test vertical tab
  char_vtab :: '\v';
  comptime_assert(char_vtab == 11, "char '\\v' should be 11");
});
test("Test comptime boolean", {
  /**
  * Test compile-time bool operations
  * This file tests the __yo_comptime_bool_* functions that operate
  * on compile-time known bool values.
  */
  // Basic bool literals
  true_val :: true;
  false_val :: false;
  // Test logical AND operations
  {
    // All combinations of AND
    and_tt :: (true_val && true_val); // true
    and_tf :: (true_val && false_val); // false
    and_ft :: (false_val && true_val); // false
    and_ff :: (false_val && false_val); // false
    // Verify results with assertions
    comptime_assert(and_tt == true);
    comptime_assert(and_tf == false);
    comptime_assert(and_ft == false);
    comptime_assert(and_ff == false);
  };
  // Test logical OR operations
  {
    // All combinations of OR
    or_tt :: (true_val || true_val); // true
    or_tf :: (true_val || false_val); // true
    or_ft :: (false_val || true_val); // true
    or_ff :: (false_val || false_val); // false
    // Verify results with assertions
    comptime_assert(or_tt == true);
    comptime_assert(or_tf == true);
    comptime_assert(or_ft == true);
    comptime_assert(or_ff == false);
  };
  // Test logical NOT operations
  {
    not_true :: not(true_val); // false
    not_false :: not(false_val); // true
    // Double negation
    not_not_true :: not(not(true_val)); // true
    not_not_false :: not(not(false_val)); // false
    // Verify results
    comptime_assert(not_true == false);
    comptime_assert(not_false == true);
    comptime_assert(not_not_true == true);
    comptime_assert(not_not_false == false);
  };
  // Test equality operations
  {
    eq_tt :: (true_val == true_val); // true
    eq_tf :: (true_val == false_val); // false
    eq_ft :: (false_val == true_val); // false
    eq_ff :: (false_val == false_val); // true
    // Verify results
    comptime_assert(eq_tt == true);
    comptime_assert(eq_tf == false);
    comptime_assert(eq_ft == false);
    comptime_assert(eq_ff == true);
  };
  // Test inequality operations
  {
    neq_tt :: (true_val != true_val); // false
    neq_tf :: (true_val != false_val); // true
    neq_ft :: (false_val != true_val); // true
    neq_ff :: (false_val != false_val); // false
    // Verify results
    comptime_assert(neq_tt == false);
    comptime_assert(neq_tf == true);
    comptime_assert(neq_ft == true);
    comptime_assert(neq_ff == false);
  };
  // Test string conversion
  {
    true_str :: true_val.to_comptime_string(); // "true"
    false_str :: false_val.to_comptime_string(); // "false"
    // Verify string conversions
    comptime_assert(true_str == "true");
    comptime_assert(false_str == "false");
  };
  // Test complex bool expressions
  {
    // De Morgan's Laws
    // !(A && B) == (!A || !B)
    demorgan1_left :: not(true_val && false_val);
    demorgan1_right :: (not(true_val) || not(false_val));
    comptime_assert(demorgan1_left == demorgan1_right);
    // !(A || B) == (!A && !B)
    demorgan2_left :: not(true_val || false_val);
    demorgan2_right :: (not(true_val) && not(false_val));
    comptime_assert(demorgan2_left == demorgan2_right);
    // Distributive properties
    // A && (B || C) == (A && B) || (A && C)
    a :: true_val;
    b :: false_val;
    c :: true_val;
    distrib_left :: (a && (b || c));
    distrib_right :: ((a && b) || (a && c));
    comptime_assert(distrib_left == distrib_right);
    // Identity laws
    // A && true == A
    identity_and :: (a && true);
    comptime_assert(identity_and == a);
    // A || false == A
    identity_or :: (a || false);
    comptime_assert(identity_or == a);
    // Annihilation laws
    // A && false == false
    annihil_and :: (a && false);
    comptime_assert(annihil_and == false);
    // A || true == true
    annihil_or :: (a || true);
    comptime_assert(annihil_or == true);
    // Idempotent laws
    // A && A == A
    idemp_and :: (a && a);
    comptime_assert(idemp_and == a);
    // A || A == A
    idemp_or :: (a || a);
    comptime_assert(idemp_or == a);
  };
  // Test nested expressions
  {
    // Complex nested bool expression
    complex1 :: ((true_val && false_val) || (not(false_val) && true_val));
    comptime_assert(complex1 == true);
    // Another complex expression
    complex2 :: not((true_val || false_val) && not(true_val == false_val));
    comptime_assert(complex2 == false);
    // Triple nested expression
    complex3 :: (((true_val && not(false_val)) || false_val) == (true_val || (false_val && not(true_val))));
    comptime_assert(complex3 == true);
  };
  // Test with computed bool values
  {
    // Use results from other operations
    computed1 :: (true_val == true_val); // true
    computed2 :: (false_val != true_val); // true
    and_computed :: (computed1 && computed2); // true && true = true
    or_computed :: (computed1 || computed2); // true || true = true
    comptime_assert(and_computed == true);
    comptime_assert(or_computed == true);
    // Negation of computed values
    not_computed1 :: not(computed1); // not(true) = false
    not_computed2 :: not(computed2); // not(true) = false
    comptime_assert(not_computed1 == false);
    comptime_assert(not_computed2 == false);
  };
  // Exhaustive truth table tests
  {
    // AND truth table
    comptime_assert((true && true) == true);
    comptime_assert((true && false) == false);
    comptime_assert((false && true) == false);
    comptime_assert((false && false) == false);
    // OR truth table
    comptime_assert((true || true) == true);
    comptime_assert((true || false) == true);
    comptime_assert((false || true) == true);
    comptime_assert((false || false) == false);
    // NOT truth table
    comptime_assert(not(true) == false);
    comptime_assert(not(false) == true);
    // EQ truth table
    comptime_assert((true == true) == true);
    comptime_assert((true == false) == false);
    comptime_assert((false == true) == false);
    comptime_assert((false == false) == true);
    // NEQ truth table
    comptime_assert((true != true) == false);
    comptime_assert((true != false) == true);
    comptime_assert((false != true) == true);
    comptime_assert((false != false) == false);
  };
});
test("Test comptime_float", {
  /**
  * Test compile-time float operations
  */
  // Basic float operations
  a :: 3.5;
  b :: 2.5;
  // Arithmetic operations
  sum :: (a + b); // 6.0
  diff :: (a - b); // 1.0
  prod :: (a * b); // 8.75
  quot :: (a / b); // 1.4
  // Unary operations
  neg_a :: a.neg(); // -3.5
  // Comparison operations
  eq_test :: (a == b); // false
  neq_test :: (a != b); // true
  lt_test :: (a < b); // false
  lte_test :: (a <= b); // false
  gt_test :: (a > b); // true
  gte_test :: (a >= b); // true
  // Type conversion operations
  float_to_int :: i32(a); // 3
  float_to_string :: a.to_comptime_string(); // "3.5"
  // Test with compile-time assertions
  comptime_assert(sum == 6.0);
  comptime_assert(diff == 1.0);
  comptime_assert(prod == 8.75);
  comptime_assert(quot == 1.4);
  comptime_assert(neg_a == 3.5.neg());
  comptime_assert(eq_test == false);
  comptime_assert(neq_test == true);
  comptime_assert(lt_test == false);
  comptime_assert(lte_test == false);
  comptime_assert(gt_test == true);
  comptime_assert(gte_test == true);
  comptime_assert(float_to_int == 3);
  comptime_assert(float_to_string == "3.5");
  // Test zero division error handling
  // This should cause a compile-time error
  // zero :: 0.0;
  // division_by_zero :: a / zero;
});
test("Test comptime_int", {
  /**
  * Test compile-time integer operations
  * This file tests the __yo_comptime_int_* functions that operate
  * on compile-time known integer values.
  */
  // Basic integer operations
  a :: 10;
  b :: 3;
  c :: 10;
  zero :: 0;
  // Arithmetic operations
  sum :: (a + b); // 13
  diff :: (a - b); // 7
  prod :: (a * b); // 30
  quot :: (a / b); // 3 (integer division)
  remainder :: (a % b); // 1
  // Unary operations
  neg_a :: -(a); // -10
  neg_zero :: zero.neg(); // 0
  // Comparison operations
  eq_test :: (a == c); // true (10 == 10)
  eq_false :: (a == b); // false (10 == 3)
  neq_test :: (a != b); // true (10 != 3)
  neq_false :: (a != c); // false (10 != 10)
  lt_test :: (b < a); // true (3 < 10)
  lt_false :: (a < b); // false (10 < 3)
  lte_test :: (b <= a); // true (3 <= 10)
  lte_equal :: (a <= c); // true (10 <= 10)
  gt_test :: (a > b); // true (10 > 3)
  gt_false :: (b > a); // false (3 > 10)
  gte_test :: (a >= b); // true (10 >= 3)
  gte_equal :: (a >= c); // true (10 >= 10)
  // Type conversion operations
  int_to_float :: f64(a); // 10.0
  int_to_string :: a.to_comptime_string(); // "10"
  // Test with compile-time assertions
  // Arithmetic
  comptime_assert(sum == 13);
  comptime_assert(diff == 7);
  comptime_assert(prod == 30);
  comptime_assert(quot == 3);
  comptime_assert(remainder == 1);
  // Unary operations
  comptime_assert(neg_a == (10).neg());
  comptime_assert(neg_zero == 0);
  // Comparisons
  comptime_assert(eq_test == true);
  comptime_assert(eq_false == false);
  comptime_assert(neq_test == true);
  comptime_assert(neq_false == false);
  comptime_assert(lt_test == true);
  comptime_assert(lt_false == false);
  comptime_assert(lte_test == true);
  comptime_assert(lte_equal == true);
  comptime_assert(gt_test == true);
  comptime_assert(gt_false == false);
  comptime_assert(gte_test == true);
  comptime_assert(gte_equal == true);
  // Type conversions
  comptime_assert(int_to_float == 10.0);
  comptime_assert(int_to_string == "10");
  // Test with negative numbers
  {
    neg_num :: 5.neg();
    pos_num :: 7;
    // Arithmetic with negatives
    neg_sum :: (neg_num + pos_num); // 2
    neg_diff :: (neg_num - pos_num); // -12
    neg_prod :: (neg_num * pos_num); // -35
    neg_quot :: (neg_num / pos_num); // 0 (integer division: -5/7 = 0)
    // Comparisons with negatives
    neg_lt :: (neg_num < pos_num); // true (-5 < 7)
    neg_gt :: (pos_num > neg_num); // true (7 > -5)
    comptime_assert(neg_sum == 2);
    comptime_assert(neg_diff == 12.neg());
    comptime_assert(neg_prod == 35.neg());
    comptime_assert(neg_quot == 0);
    comptime_assert(neg_lt == true);
    comptime_assert(neg_gt == true);
  };
  // Test edge cases
  {
    // Zero operations
    zero_sum :: (zero + a); // 10
    zero_diff1 :: (a - zero); // 10
    zero_diff2 :: (zero - a); // -10
    zero_prod :: (zero * a); // 0
    comptime_assert(zero_sum == 10);
    comptime_assert(zero_diff1 == 10);
    comptime_assert(zero_diff2 == 10.neg());
    comptime_assert(zero_prod == 0);
    // Identity operations
    identity_sum :: (a + zero); // 10
    identity_prod :: (a * 1); // 10
    comptime_assert(identity_sum == 10);
    comptime_assert(identity_prod == 10);
    // Self operations
    self_sub :: (a - a); // 0
    self_div :: (a / a); // 1
    self_mod :: (a % a); // 0
    comptime_assert(self_sub == 0);
    comptime_assert(self_div == 1);
    comptime_assert(self_mod == 0);
  };
  // Test larger numbers
  {
    large1 :: 1000;
    large2 :: 999;
    large_sum :: (large1 + large2); // 1999
    large_diff :: (large1 - large2); // 1
    large_prod :: (large1 * 2); // 2000
    large_div :: (large1 / 10); // 100
    large_mod :: (large1 % 7); // 6 (1000 % 7 = 6)
    comptime_assert(large_sum == 1999);
    comptime_assert(large_diff == 1);
    comptime_assert(large_prod == 2000);
    comptime_assert(large_div == 100);
    comptime_assert(large_mod == 6);
    // String conversion of large numbers
    large_str :: large1.to_comptime_string();
    comptime_assert(large_str == "1000");
  };
  // Test modulo with different numbers
  {
    mod_tests1 :: (17 % 5); // 2
    mod_tests2 :: (20 % 4); // 0
    mod_tests3 :: (7 % 10); // 7
    comptime_assert(mod_tests1 == 2);
    comptime_assert(mod_tests2 == 0);
    comptime_assert(mod_tests3 == 7);
  };
  // Test chained operations (order of operations)
  {
    // Note: In Yo, there's no operator precedence, so we need explicit parentheses
    chain1 :: ((a + b) * 2); // (10 + 3) * 2 = 26
    chain2 :: (a + (b * 2)); // 10 + (3 * 2) = 16
    chain3 :: ((a / b) + 1); // (10 / 3) + 1 = 3 + 1 = 4
    comptime_assert(chain1 == 26);
    comptime_assert(chain2 == 16);
    comptime_assert(chain3 == 4);
  };
  // Test conversion consistency
  {
    num :: 42;
    float_conv :: f64(num);
    string_conv :: num.to_comptime_string();
    // Convert back through different paths
    comptime_assert(float_conv == 42.0);
    comptime_assert(string_conv == "42");
    // Test negative conversion
    neg_num :: 42.neg();
    neg_float :: f64(neg_num);
    neg_string :: neg_num.to_comptime_string();
    comptime_assert(neg_float == f64(42.0).neg());
    comptime_assert(neg_string == "-42");
  };
  // Test division edge cases
  {
    // Positive division
    div1 :: (15 / 3); // 5
    div2 :: (16 / 3); // 5 (integer division)
    div3 :: (2 / 5); // 0
    comptime_assert(div1 == 5);
    comptime_assert(div2 == 5);
    comptime_assert(div3 == 0);
    // Test that division by zero would cause compile-time error
    // This should be commented out as it would cause compilation to fail:
    // div_by_zero :: (a / zero);  // Should cause compile-time error
  };
});
test("Test comptime_str", {
  /**
  * Test compile-time string operations
  * This file tests the __yo_comptime_string_* functions that operate
  * on compile-time known string values.
  */
  // Basic string literals
  str1 :: "hello";
  str2 :: "world";
  str3 :: "hello";
  empty_str :: "";
  space_str :: " ";
  // Test string concatenation
  {
    concat1 :: (str1 + " "); // "hello "
    concat2 :: (concat1 + str2); // "hello world"
    concat3 :: (str1 + str2); // "helloworld"
    concat4 :: (empty_str + str1); // "hello"
    concat5 :: (str1 + empty_str); // "hello"
    // Verify concatenation results
    comptime_assert(concat1 == "hello ");
    comptime_assert(concat2 == "hello world");
    comptime_assert(concat3 == "helloworld");
    comptime_assert(concat4 == "hello");
    comptime_assert(concat5 == "hello");
  };
  // Test string equality operations
  {
    eq_same :: (str1 == str3); // true ("hello" == "hello")
    eq_diff :: (str1 == str2); // false ("hello" == "world")
    eq_empty :: (empty_str == ""); // true
    // Verify equality results
    comptime_assert(eq_same == true);
    comptime_assert(eq_diff == false);
    comptime_assert(eq_empty == true);
  };
  // Test string inequality operations
  {
    neq_same :: (str1 != str3); // false ("hello" != "hello")
    neq_diff :: (str1 != str2); // true ("hello" != "world")
    neq_empty :: (empty_str != "a"); // true
    // Verify inequality results
    comptime_assert(neq_same == false);
    comptime_assert(neq_diff == true);
    comptime_assert(neq_empty == true);
  };
  // Test lexicographic comparison operations
  {
    // Test less than
    lt_true :: (str1 < str2); // true ("hello" < "world")
    lt_false :: (str2 < str1); // false ("world" < "hello")
    lt_equal :: (str1 < str3); // false ("hello" < "hello")
    lt_empty :: (empty_str < str1); // true ("" < "hello")
    // Test less than or equal
    lte_true :: (str1 <= str2); // true ("hello" <= "world")
    lte_equal :: (str1 <= str3); // true ("hello" <= "hello")
    lte_false :: (str2 <= str1); // false ("world" <= "hello")
    // Test greater than
    gt_true :: (str2 > str1); // true ("world" > "hello")
    gt_false :: (str1 > str2); // false ("hello" > "world")
    gt_equal :: (str1 > str3); // false ("hello" > "hello")
    // Test greater than or equal
    gte_true :: (str2 >= str1); // true ("world" >= "hello")
    gte_equal :: (str1 >= str3); // true ("hello" >= "hello")
    gte_false :: (str1 >= str2); // false ("hello" >= "world")
    // Verify comparison results
    comptime_assert(lt_true == true);
    comptime_assert(lt_false == false);
    comptime_assert(lt_equal == false);
    comptime_assert(lt_empty == true);
    comptime_assert(lte_true == true);
    comptime_assert(lte_equal == true);
    comptime_assert(lte_false == false);
    comptime_assert(gt_true == true);
    comptime_assert(gt_false == false);
    comptime_assert(gt_equal == false);
    comptime_assert(gte_true == true);
    comptime_assert(gte_equal == true);
    comptime_assert(gte_false == false);
  };
  // Test string length operations
  {
    len_hello :: str1.len(); // 5
    len_world :: str2.len(); // 5
    len_empty :: empty_str.len(); // 0
    len_space :: " ".len(); // 1
    // Verify length results
    comptime_assert(len_hello == 5);
    comptime_assert(len_world == 5);
    comptime_assert(len_empty == 0);
    comptime_assert(len_space == 1);
  };
  // Test case conversion operations
  {
    mixed_case :: "HeLLo WoRLd";
    uppercase :: mixed_case.to_upper(); // "HELLO WORLD"
    lowercase :: mixed_case.to_lower(); // "hello world"
    // Test with already converted strings
    upper_upper :: "HELLO".to_upper(); // "HELLO"
    lower_lower :: "world".to_lower(); // "world"
    // Test with special characters and numbers
    special :: "Hello123!@#".to_upper(); // "HELLO123!@#"
    special_low :: "Hello123!@#".to_lower(); // "hello123!@#"
    // Verify case conversion results
    comptime_assert(uppercase == "HELLO WORLD");
    comptime_assert(lowercase == "hello world");
    comptime_assert(upper_upper == "HELLO");
    comptime_assert(lower_lower == "world");
    comptime_assert(special == "HELLO123!@#");
    comptime_assert(special_low == "hello123!@#");
  };
  // Test complex string operations combining multiple features
  {
    // String building with concatenation and case conversion
    greeting :: (("hello".to_upper() + " ") + "world".to_upper()); // "HELLO WORLD"
    comptime_assert(greeting == "HELLO WORLD");
    comptime_assert(greeting.len() == 11);
    // Comparison with constructed strings
    // FIXME: The code below takes super long time to execute.
    // constructed ::
    //   ((("HE" + "LLO") + " ") + "WO") + "RLD";
    constructed :: "HELLO WORLD";
    comptime_assert(constructed == greeting);
    // Mixed operations
    phrase1 :: "programming";
    phrase2 :: "is";
    phrase3 :: "fun";
    sentence ::
      ((((phrase1.to_upper() + " ") + phrase2.to_upper()) + " ") + phrase3.to_upper());
    comptime_assert(sentence == "PROGRAMMING IS FUN");
    comptime_assert(sentence.len() == 18);
  };
  // Test edge cases
  {
    // Single character strings
    single_a :: "a";
    single_z :: "z";
    single_A :: "A";
    comptime_assert(single_a < single_z);
    comptime_assert(single_A < single_a); // ASCII: 'A' (65) < 'a' (97)
    comptime_assert(single_a.len() == 1);
    comptime_assert(single_a.to_upper() == "A");
    comptime_assert(single_A.to_lower() == "a");
    // Unicode/special characters (basic ASCII)
    newline :: "\n";
    tab :: "\t";
    comptime_assert(newline.len() == 1);
    comptime_assert(tab.len() == 1);
    // Numbers as strings
    num_str1 :: "123";
    num_str2 :: "456";
    num_concat :: (num_str1 + num_str2); // "123456"
    comptime_assert(num_concat == "123456");
    comptime_assert(num_str1 < num_str2); // Lexicographic: "123" < "456"
  };
  // Test string slice operations
  {
    test_str :: "abcdefgh";
    // Basic slice operations
    slice1 :: test_str.slice(0, 3); // "abc"
    slice2 :: test_str.slice(2, 6); // "cdef"
    slice3 :: test_str.slice(3, test_str.len()); // "defgh" (from 3 to end)
    slice4 :: test_str.slice(0, test_str.len()); // "abcdefgh" (full string)
    // Edge cases
    slice_empty :: test_str.slice(5, 5); // "" (empty slice)
    slice_beyond :: test_str.slice(10, test_str.len()); // "" (start beyond length)
    /// slice_negative_end :: test_str.slice(0, 1.neg()); // "" (negative end)
    // Verify slice results
    comptime_assert(slice1 == "abc");
    comptime_assert(slice2 == "cdef");
    comptime_assert(slice3 == "defgh");
    comptime_assert(slice4 == "abcdefgh");
    comptime_assert(slice_empty == "");
    comptime_assert(slice_beyond == "");
    /// comptime_assert(slice_negative_end == "");
    // Test with different strings
    hello :: "hello world";
    hello_slice1 :: hello.slice(0, 5); // "hello"
    hello_slice2 :: hello.slice(6, hello.len()); // "world"
    hello_slice3 :: hello.slice(6, 11); // "world"
    comptime_assert(hello_slice1 == "hello");
    comptime_assert(hello_slice2 == "world");
    comptime_assert(hello_slice3 == "world");
    // Combined with other operations
    combined ::
      ((hello_slice1.to_upper() + " ") + hello_slice2.to_upper());
    comptime_assert(combined == "HELLO WORLD");
  };
});
test("Comptime string basis is BYTES (D4 PR 7, O1c)", {
  // Subject covers all four UTF-8 widths:
  //  a=1B @0   é=2B @1   中=3B @3   𝄞=4B @6   — 10 bytes, 4 runes.
  s :: "aé中𝄞";
  // len() counts BYTES, matching the runtime String.len()/str.len().
  // The pre-PR-7 engine answered 4 (runes) here.
  comptime_assert(s.len() == 10);
  // slice takes BYTE offsets [start, end) on rune boundaries.
  // The pre-PR-7 engine read these as RUNE indices (slice(1, 3) was "é中").
  first :: s.slice(0, 1); // "a"
  second :: s.slice(1, 3); // "é"
  third :: s.slice(3, 6); // "中"
  fourth :: s.slice(6, s.len()); // "𝄞"
  comptime_assert(first == "a");
  comptime_assert(second == "é");
  comptime_assert(third == "中");
  comptime_assert(fourth == "𝄞");
  // Out-of-range still clamps, as slice always has.
  comptime_assert(s.slice(12, s.len()) == "");
  // Runtime-observable: the folded comptime values agree with the runtime
  // byte basis (a vacuously-green comptime fold cannot fake these). `str` is
  // the prelude's byte-based string; a comptime_str converts to it.
  (runtime_len : usize) = usize(s.len());
  (rs : str) = s;
  assert(runtime_len == rs.len());
  assert(runtime_len == usize(10));
  (runtime_third : str) = third;
  assert(runtime_third.len() == usize(3));
  assert(runtime_third == "中");
});
test("Test mutation", {
  // Value semantics
  /// struct
  {
    Point :: struct(
      x : i32,
      y : i32
    );
    p1 :: Point(3, 4);
    p2 :: p1;
    p1.x = 5;
    // comptime_print("p1 ", p1);
    // comptime_print("p2 ", p2);
    comptime_assert(p1.x == 5);
    comptime_assert(p2.x == 3);
  };
  /// array
  {
    arr1 :: [1, 2, 3];
    arr2 :: arr1;
    index :: 0;
    arr1(index) = 4;
    // comptime_print("arr1 ", arr1);
    // comptime_print("arr2 ", arr2);
    comptime_assert(arr1(0) == 4);
    comptime_assert(arr1(1) == 2);
    comptime_assert(arr1(2) == 3);
    comptime_assert(arr2(0) == 1);
  };
  /// tuple
  {
    t1 :: (1, 2.0);
    t2 :: t1;
    t1.0 = 4;
    // comptime_print("t1 ", t1);
    // comptime_print("t2 ", t2);
    comptime_assert(t1.0 == 4);
    comptime_assert(t2.0 == 1);
  };
  /// enum
  {
    Shape :: enum(
      Circle(radius : f32),
      Rectangle(width : f32, height : f32)
    );
    c1 :: Shape.Circle(5.0);
    c2 :: c1;
    c1.radius = 10.0;
    // comptime_print("c1 ", c1);
    // comptime_print("c2 ", c2);
    comptime_assert(c1.radius == 10.0);
    comptime_assert(c2.radius == 5.0); // c2 should remain unchanged with value semantics
  };
  // Refernce semantics are not allowed to be used in compile-time context
  {
    Point :: ref(
      struct(
        // Point now uses reference semantics
        x : i32,
        y : i32
      )
    );
    comptime_expect_error(p1 :: Point(3, 4));
  };
});
test("Test parser associtivity", {
  right :: quote(
    1 +
      2 +
        3
  );
  comptime_assert(right == quote(1 + (2 + 3)));
  left :: quote(
    1
    + 2
    + 3
  );
  comptime_assert(left == quote((1 + 2) + 3));
  right_2 :: quote(
    a
    =
      (b -> c)
  );
  comptime_assert(right_2 == quote(a = (b -> c)));
});
test("Test sizeof", {
  comptime_assert(sizeof(Type) == 0);
  // comptime_assert(sizeof(Free) == 0);
  // comptime_assert(sizeof(Linear) == 0);
  comptime_assert(sizeof(comptime_int) == 0);
  comptime_assert(sizeof(comptime_float) == 0);
  // `unit` is a true zero-sized type (Rust: `size_of::<()>() == 0`): a unit
  // field emits no C member, so nothing is laid out. See
  // tests/unit_as_value_type.test.yo for the aggregate rule and
  // issues/fixed/unit-should-be-a-true-zero-sized-type-like-rust.md.
  comptime_assert(sizeof(unit) == 0);
  comptime_assert(sizeof(u8) == 1);
  comptime_assert(sizeof(u16) == 2);
  comptime_assert(sizeof(u32) == 4);
  comptime_assert(sizeof(u64) == 8);
  comptime_assert(sizeof(i8) == 1);
  comptime_assert(sizeof(i16) == 2);
  comptime_assert(sizeof(i32) == 4);
  comptime_assert(sizeof(i64) == 8);
  comptime_assert(sizeof(f32) == 4);
  comptime_assert(sizeof(f64) == 8);
  comptime_assert(sizeof(bool) == 1);
  MyTuple :: Tuple(
    u8,
    u16,
    u32,
    u64,
    i8,
    i16,
    i32,
    i64,
    f32,
    f64
  );
  comptime_assert(sizeof(MyTuple) == 48);
  MyArray :: Array(u8, 10);
  comptime_assert(sizeof(MyArray) == 10);
  Point :: struct(
    x : i32,
    y : i32
  );
  comptime_assert(sizeof(Point) == 8);
  Color :: enum(
    Red,
    Green,
    Blue
  );
  comptime_assert(sizeof(Color) == 4);
  Shape :: enum(
    Circle(radius : f32),
    Rectangle(width : f32, height : f32)
  );
  comptime_assert(sizeof(Shape) == 12);
  MyUnion :: union(
    a : u8,
    b : u16,
    c : u32,
    d : u64,
    e : i8,
    f : i16,
    g : i32,
    h : i64,
    i : f32,
    j : f64
  );
  comptime_assert(sizeof(MyUnion) == 8);
  test1 :: (fn(comptime(T) : Type) -> unit)({
    x :: sizeof(T);
  });
  // All pointers now have unknown size
  // comptime_assert(sizeof(test1) == 8);
  // comptime_assert(sizeof(*(i32)) == 8);
  // comptime_assert(sizeof(*(f32)) == 8);
  // comptime_assert(sizeof(*(u8)) == 8);
  // comptime_assert(sizeof(*(i32)) == 8);
  //
  // comptime_assert(sizeof(&(f32)) == 8);
  // comptime_assert(sizeof(&(i32)) == 8);
  // comptime_assert(sizeof(&(u8)) == 8);
  // comptime_assert(sizeof(&(i32)) == 8);
});
test("Test alignof", {
  // Test primitive types
  comptime_assert(alignof(u8) == usize(1));
  comptime_assert(alignof(u16) == usize(2));
  comptime_assert(alignof(u32) == usize(4));
  comptime_assert(alignof(u64) == usize(8));
  comptime_assert(alignof(i8) == usize(1));
  comptime_assert(alignof(i16) == usize(2));
  comptime_assert(alignof(i32) == usize(4));
  comptime_assert(alignof(i64) == usize(8));
  comptime_assert(alignof(f32) == usize(4));
  comptime_assert(alignof(f64) == usize(8));
  // Test pointer types
  comptime_assert(alignof(*(u8)) == usize(8));
  comptime_assert(alignof(*(i32)) == usize(8));
  // Test array types (should be same as element type)
  comptime_assert(alignof([u32 ; 10]) == usize(4));
  comptime_assert(alignof([u64 ; 5]) == usize(8));
  // Test struct types
  S :: struct(x : u64, y : u32);
  comptime_assert(alignof(S) == usize(8)); // Should be max alignment (u64 = 8)
});
test("Test comptime Ptr value", {
  // Test 1: Simple address-of and dereference
  {
    val :: i32(42);
    p :: &(val);
    comptime_assert(p.* == i32(42));
  };
  // Test 2: Pointer assignment
  {
    val :: i32(10);
    p :: &(val);
    p.* = i32(20);
    comptime_assert(val == i32(20));
  };
  // Test 3: Multiple derefs
  {
    val :: i32(5);
    p1 :: &(val);
    p2 :: &(p1);
    comptime_assert(p2.*.* == i32(5));
  };
  // Test 4: Another pointer value test
  {
    val :: i32(100);
    p :: &(val);
    comptime_assert(p.* == i32(100));
  };
  // Test 5: Function that reads through pointer
  {
    read_ptr :: (fn(comptime(p) : *(i32)) -> comptime(i32))({
      return(p.*);
    });
    val :: i32(42);
    comptime_assert(read_ptr(&(val)) == i32(42));
  };
  // Test 6: Function that mutates through pointer
  {
    increment :: (fn(comptime(p) : *(i32)) -> comptime(unit))({
      p.* = (p.* + i32(1));
    });
    counter :: i32(0);
    comptime_assert(counter == i32(0));
    increment(&(counter));
    comptime_assert(counter == i32(1));
    increment(&(counter));
    comptime_assert(counter == i32(2));
  };
});
// Test 7: Test pointer to Array value
test("Test comptime Array value", {
  arr :: [i32(0), i32(1), i32(2)];
  p :: &(arr(0));
  p.* = 16;
  p2 :: &(arr(1));
  p2.* = 18;
  comptime_assert(arr(0) == i32(16));
  comptime_assert(arr(1) == i32(18));
  comptime_assert(arr(2) == i32(2));
});
// Test 8: Test Slice
test("Test comptime array element access stays", {
  // (Former "comptime Slice value" test: comptime range slicing retired
  // with the builtin Slice — plans/archive/SLICE_REWORK.md. Element access and
  // writes on comptime arrays are unchanged.)
  arr :: [i32(0), i32(1), i32(2), i32(3), i32(4)];
  comptime_assert(arr(0) == i32(0));
  comptime_assert(arr(4) == i32(4));
});
// Test: Comptime bitwise results preserve typed integer type when used at runtime
// This tests the fix for a bug where comptime bitwise operations (bit_or, bit_and, etc.)
// on typed integers (u32, i32, etc.) produced ComptimeInt values instead of preserving
// the operand type. When mixed with runtime values, ComptimeInt was converted to i32,
// causing type mismatches with u32.
test("Test comptime bitwise type preservation", {
  // u32 bitwise results used in runtime context
  {
    S_IWUSR :: u32(0o0200);
    S_IWGRP :: u32(0o0020);
    S_IWOTH :: u32(0o0002);
    // Comptime OR of two u32 constants
    write_mask :: (S_IWUSR | S_IWGRP);
    // Use comptime bitwise result with runtime u32 value
    m := u32(0o0644);
    result := (m & write_mask);
    assert(result == u32(0o0200), "u32 AND with comptime OR mask");
    // Three-way OR (nested left-to-right)
    full_write_mask :: ((S_IWUSR | S_IWGRP) | S_IWOTH);
    result2 := (m & full_write_mask);
    assert(result2 == u32(0o0200), "u32 AND with three-way comptime OR mask");
    // Comparison of runtime value with comptime bitwise result
    is_zero := ((m & write_mask) == u32(0));
    assert(!(is_zero), "masked value should not be zero");
  };
  // i32 bitwise results used in runtime context
  {
    FLAG_A :: i32(0x01);
    FLAG_B :: i32(0x02);
    FLAG_C :: i32(0x04);
    combined :: (FLAG_A | FLAG_B);
    flags := i32(0x03);
    masked := (flags & combined);
    assert(masked == i32(0x03), "i32 AND with comptime OR mask");
    all_flags :: ((FLAG_A | FLAG_B) | FLAG_C);
    has_c := ((flags & FLAG_C) != i32(0));
    assert(!(has_c), "flag C should not be set");
  };
  // u8 bitwise results used in runtime context
  {
    BIT0 :: u8(0x01);
    BIT1 :: u8(0x02);
    BIT7 :: u8(0x80);
    low_bits :: (BIT0 | BIT1);
    val := u8(0x03);
    result := (val & low_bits);
    assert(result == u8(0x03), "u8 AND with comptime OR mask");
    high_low :: (BIT0 | BIT7);
    result2 := (val & high_low);
    assert(result2 == u8(0x01), "u8 AND with non-adjacent comptime OR mask");
  };
  // Comptime shift results used in runtime context
  {
    shift_val :: (u32(1) << u32(8));
    x := u32(0x1FF);
    result := (x & shift_val);
    assert(result == u32(256), "u32 AND with comptime shift result");
    shift_right :: (u32(0xFF00) >> u32(4));
    result2 := (x & shift_right);
    assert(result2 == u32(0x1F0), "u32 AND with comptime right-shift result");
  };
  // Comptime XOR and NOT results used in runtime context
  {
    a_val :: u32(0xFF00FF00);
    b_val :: u32(0x0FF00FF0);
    xor_mask :: (a_val ^ b_val);
    x := u32(0xFFFFFFFF);
    result := (x & xor_mask);
    assert(result == u32(0xF0F0F0F0), "u32 AND with comptime XOR mask");
    not_mask :: ~(u32(0xFF));
    result2 := (x & not_mask);
    assert(result2 == u32(0xFFFFFF00), "u32 AND with comptime NOT mask");
  };
});
test("Comptime SomeType constraint validation", {
  // BAD: Self.Output is not constrained to Comptime, so comptime(*(Self.Output)) is invalid
  comptime_expect_error(
    MyBadComptimeIndex :: (fn(comptime(Idx) : Type, where(Idx <: Comptime)) -> comptime(Trait))(
      trait(
        Output : Type,
        index : (fn(comptime(self) : *(Self), comptime(idx) : Idx) -> comptime(*(Self.Output))),
        where(Self <: Comptime)
      )
    )
  );
  // GOOD: Self.Output <: Comptime is in the where clause
  MyGoodComptimeIndex :: (fn(comptime(Idx) : Type, where(Idx <: Comptime)) -> comptime(Trait))(
    trait(
      Output : Type,
      index : (fn(comptime(self) : *(Self), comptime(idx) : Idx) -> comptime(*(Self.Output))),
      where(Self <: Comptime, Self.Output <: Comptime)
    )
  );
});
test("comptime_assert validates argument type even in function body", {
  // `==` between Type values is NOT defined (no Eq impl for Type).
  // Use Type.eq / Type.is_compatible_with instead. This must be rejected
  // even when comptime_assert is inside a function body (not actually executed).
  comptime_expect_error(comptime_assert(i32 == i32, "should be rejected"));
  comptime_expect_error(comptime_assert(bool == bool, "should be rejected"));
  // Non-bool argument is also rejected.
  comptime_expect_error(comptime_assert(i32(1), "not a bool"));
  // Valid forms still work:
  comptime_assert(Type.eq(i32, i32), "Type.eq works");
  comptime_assert(true, "literal true works");
});
test("i64.MIN renders as a valid signed C literal", {
  // `-9223372036854775808LL` is NOT a valid signed C literal: the digits do
  // not fit long long, so clang types it UNSIGNED long long
  // (-Wimplicitly-unsigned-literal, hidden by -w) and a comparison it is
  // inlined into silently goes unsigned. The compiler must render i64.MIN
  // as `(-9223372036854775807LL - 1)`. A stage-2-built compiler with the
  // bad rendering rejected EVERY comptime signed subtraction ("3 - 1 = 2
  // exceeds isize range") — the PR #92 fixpoint divergence.
  min_val :: i64.MIN;
  v := i64(3);
  assert(!(v < min_val), "3 < i64.MIN must be false");
  assert(v > min_val, "3 > i64.MIN must be true");
  assert(min_val.to_string() == "-9223372036854775808", "value intact");
  sub_ok :: (isize(3) - isize(1));
  s := sub_ok;
  assert(s == isize(2), "comptime signed subtraction folds");
});
// ─── Comptime contract violations (port of contracts-comptime-violation.test.ts) ──
// A `requires`/`ensures` clause on a comptime fn is checked during CTFE, so a
// violating call is a compile error and comptime_expect_error can pin it.
// Without the contract each call folds cleanly, so these cannot pass vacuously.
__contract_abs :: (fn(comptime(x) : i32, requires(x >= i32(-(100)))) -> comptime(i32))(
  cond((x >= i32(0)) => x, true => -(x))
);
__contract_neg :: (fn(comptime(x) : i32, ensures(result >= i32(0))) -> comptime(i32))(-(x));
// The negatives sit at TOP LEVEL: inside a test(...) body the violating call
// is evaluated during def-time body evaluation, BEFORE comptime_expect_error
// gets to wrap it, and the error escapes as a module-load failure.
comptime_expect_error(__contract_abs(i32(-(200))));
comptime_expect_error(__contract_neg(i32(5)));
test("comptime requires(...) on a satisfying call compiles cleanly", {
  ok :: __contract_abs(i32(-(50)));
  v := ok;
  assert(v == i32(50), "abs(-50) folds to 50");
});
// ===========================================================================
// u64 / usize above i64.MAX — comptime arithmetic must be UNSIGNED
// ===========================================================================
// Comptime integers are carried as `i64`, so every u64/usize value above
// i64.MAX is a NEGATIVE bit pattern (`u64.MAX` is `-1`). Division, modulo, the
// ordering comparisons and the right shift have to be redone in the unsigned
// domain: signed `-1 / 10` is 0, `-1 % 10` is -1, `-1 > 1` is false and
// `-1 >> 1` is -1, none of which are the u64 answers.
// issues/fixed/comptime-u64-div-mod-cmp-shr-are-signed.md
//
// These are MODULE-LEVEL `::` bindings observed by RUNTIME asserts, and that
// shape is deliberate: a `comptime_assert` inside a `test(...)` body does NOT
// FIRE (issues/comptime-assert-never-fires-inside-a-function-body.md), so the
// 1064 comptime_asserts already in this file assert nothing. A module-level
// binding folds at comptime; the runtime assert below then observes the value
// the folder produced, which makes the gate real.
_MAX :: u64.MAX;
_DIV2 :: (_MAX / u64(2));
_DIV10 :: (_MAX / u64(10));
_SUB5_DIV10 :: ((_MAX - u64(5)) / u64(10));
_BIT63_DIV2 :: ((u64(1) << u64(63)) / u64(2));
_MOD10 :: (_MAX % u64(10));
_MOD2 :: (_MAX % u64(2));
_GT1 :: (_MAX > u64(1));
_GTE1 :: (_MAX >= u64(1));
_LT1 :: (_MAX < u64(1));
_LTE1 :: (_MAX <= u64(1));
_ONE_LT_MAX :: (u64(1) < _MAX);
_I64MAX_LT_MAX :: (u64(9223372036854775807) < _MAX);
_MAX_GT_BIT63 :: (_MAX > u64(9223372036854775808));
_SHR1 :: (_MAX >> u64(1));
_SHR63 :: (_MAX >> u64(63));
_SUB1 :: (_MAX - u64(1));
_SHL63 :: (u64(1) << u64(63));
test("comptime u64 above i64.MAX divides and compares UNSIGNED", {
  assert(_DIV2 == u64(9223372036854775807), `u64.MAX / 2 folded to ${_DIV2}`);
  assert(_DIV10 == u64(1844674407370955161), `u64.MAX / 10 folded to ${_DIV10}`);
  assert(_SUB5_DIV10 == u64(1844674407370955161), `(u64.MAX - 5) / 10 folded to ${_SUB5_DIV10}`);
  assert(_BIT63_DIV2 == u64(4611686018427387904), `(1 << 63) / 2 folded to ${_BIT63_DIV2}`);
  assert(_MOD10 == u64(5), `u64.MAX % 10 folded to ${_MOD10}`);
  assert(_MOD2 == u64(1), `u64.MAX % 2 folded to ${_MOD2}`);
  assert(_GT1, "u64.MAX > 1");
  assert(_GTE1, "u64.MAX >= 1");
  assert(!_LT1, "!(u64.MAX < 1)");
  assert(!_LTE1, "!(u64.MAX <= 1)");
  assert(_ONE_LT_MAX, "1 < u64.MAX");
  assert(_I64MAX_LT_MAX, "i64.MAX < u64.MAX");
  assert(_MAX_GT_BIT63, "u64.MAX > 2^63");
  assert(_SHR1 == u64(9223372036854775807), `u64.MAX >> 1 folded to ${_SHR1}`);
  assert(_SHR63 == u64(1), `u64.MAX >> 63 folded to ${_SHR63}`);
  // The two's-complement-identical operations were always right; pin them so
  // a future change here cannot regress them.
  assert(_SUB1 == u64(18446744073709551614), "u64.MAX - 1");
  assert(_SHL63 == u64(9223372036854775808), "1 << 63");
});
_UMAX :: usize.MAX;
_U_GT1 :: (_UMAX > usize(1));
_U_LT1 :: (_UMAX < usize(1));
_U_DIV2 :: (_UMAX / usize(2));
_U_MOD10 :: (_UMAX % usize(10));
_U_SHR1 :: (_UMAX >> usize(1));
test("comptime usize above i64.MAX divides and compares UNSIGNED", {
  // usize shares the hazard: is_unsigned_integer_type covers .Usize and
  // get_integer_type_bits reports the TARGET POINTER WIDTH, so a comptime
  // bounds check against usize.MAX was reading a negative pattern.
  //
  // These assertions are deliberately WIDTH-AGNOSTIC: usize is 32-bit on
  // wasm32, where usize.MAX (4294967295) is a positive i64 and the unsigned
  // split is not even taken. Hardcoding the 64-bit answers made this test fail
  // on the wasm32-wasi leg while the fix itself was correct. For an N-bit
  // unsigned maximum M = 2^N - 1, M/2 == M>>1 and M%10 == 5 hold at BOTH
  // widths — and under the signed bug M/2 is 0 while M>>1 is M, so the
  // equality still catches it.
  assert(_U_GT1, "usize.MAX > 1");
  assert(!_U_LT1, "!(usize.MAX < 1)");
  assert(_U_DIV2 > usize(0), `usize.MAX / 2 folded to ${_U_DIV2} (signed gives 0)`);
  assert(_U_DIV2 == _U_SHR1, `usize.MAX / 2 = ${_U_DIV2} but usize.MAX >> 1 = ${_U_SHR1}`);
  assert(_U_MOD10 == usize(5), `usize.MAX % 10 folded to ${_U_MOD10}`);
});
_NEG :: i64(-1);
_S_DIV10 :: (_NEG / i64(10));
_S_LT1 :: (_NEG < i64(1));
_S_GT1 :: (_NEG > i64(1));
_S_SHR1 :: (_NEG >> i64(1));
_S_MIN_DIV2 :: (i64.MIN / i64(2));
_S_MIN_LT0 :: (i64.MIN < i64(0));
test("comptime SIGNED integers stay signed", {
  // The negative control: the unsigned split must not leak into i64.
  assert(_S_DIV10 == i64(0), `-1 / 10 folded to ${_S_DIV10}`);
  assert(_S_LT1, "-1 < 1");
  assert(!_S_GT1, "!(-1 > 1)");
  assert(_S_SHR1 == i64(-1), `-1 >> 1 folded to ${_S_SHR1}`);
  assert(_S_MIN_DIV2 == i64(-4611686018427387904), `i64.MIN / 2 folded to ${_S_MIN_DIV2}`);
  assert(_S_MIN_LT0, "i64.MIN < 0");
});
