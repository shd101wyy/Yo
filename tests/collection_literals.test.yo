pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
open(import("std/fmt"));
open(import("std/collections/array_list"));
open(import("std/collections/hash_map"));
open(import("std/collections/hash_set"));
// ---------------------------------------------------------------------------
// array_list literal macro
// ---------------------------------------------------------------------------
test("array_list with multiple i32 elements", {
  xs := array_list(i32(10), i32(20), i32(30));
  assert(xs.len() == usize(3), "len");
  total := i32(0);
  it := xs.into_iter();
  while(true, {
    match(
      it.next(),
      .Some(v) => {
        total = (total + v);
      },
      .None => {
        break;
      }
    );
  });
  assert(total == i32(60), "sum");
});
test("array_list rejects empty literal", {
  comptime_expect_error(array_list());
});
test("array_list with single element", {
  xs := array_list(i32(42));
  assert(xs.len() == usize(1), "len");
  it := xs.into_iter();
  match(
    it.next(),
    .Some(v) => assert(v == i32(42), "value"),
    .None => assert(false, "should have an element")
  );
});
test("array_list with String elements (RC types)", {
  xs := array_list(`hello`, `world`);
  assert(xs.len() == usize(2), "len");
  it := xs.into_iter();
  match(
    it.next(),
    .Some(v) => assert(v == `hello`, "first"),
    .None => assert(false, "missing first")
  );
  match(
    it.next(),
    .Some(v) => assert(v == `world`, "second"),
    .None => assert(false, "missing second")
  );
});
test("array_list nested literals", {
  outer := array_list(
    array_list(i32(1), i32(2)),
    array_list(i32(3), i32(4), i32(5))
  );
  assert(outer.len() == usize(2), "outer len");
  it := outer.into_iter();
  match(
    it.next(),
    .Some(v) => assert(v.len() == usize(2), "first inner len"),
    .None => assert(false, "missing first inner")
  );
  match(
    it.next(),
    .Some(v) => assert(v.len() == usize(3), "second inner len"),
    .None => assert(false, "missing second inner")
  );
});
// ---------------------------------------------------------------------------
// hash_map literal macro
// ---------------------------------------------------------------------------
test("hash_map with multiple entries", {
  m := hash_map(i32(1) => i32(10), i32(2) => i32(20), i32(3) => i32(30));
  assert(m.len() == usize(3), "len");
  match(
    m.get(i32(2)),
    .Some(v) => assert(v == i32(20), "key 2"),
    .None => assert(false, "missing key 2")
  );
});
test("hash_map rejects empty literal", {
  comptime_expect_error(hash_map());
});
test("hash_map with String keys and i32 values", {
  m := hash_map(`alice` => i32(30), `bob` => i32(25));
  assert(m.len() == usize(2), "len");
  match(
    m.get(`alice`),
    .Some(v) => assert(v == i32(30), "alice"),
    .None => assert(false, "missing alice")
  );
});
// ---------------------------------------------------------------------------
// hash_set literal macro
// ---------------------------------------------------------------------------
test("hash_set with multiple elements", {
  s := hash_set(i32(1), i32(2), i32(3));
  assert(s.len() == usize(3), "len");
  assert(s.contains(i32(2)), "contains 2");
  assert(!(s.contains(i32(99))), "no 99");
});
test("hash_set rejects empty literal", {
  comptime_expect_error(hash_set());
});
test("hash_set deduplicates equal elements", {
  s := hash_set(i32(5), i32(5), i32(5));
  assert(s.len() == usize(1), "len after dedup");
  assert(s.contains(i32(5)), "contains 5");
});
// ---------------------------------------------------------------------------
// Element type inference via typeof — must produce ArrayList(i32),
// not ArrayList(comptime_int), even when callers pass typed runtime values.
// The .push call below would fail to type-check if the element type were
// inferred as comptime_int, so this acts as a structural assertion.
// ---------------------------------------------------------------------------
test("array_list infers concrete element type from cast literals", {
  xs := array_list(i32(1), i32(2));
  xs.push(i32(99));
  assert(xs.len() == usize(3), "push must succeed at runtime i32 element type");
});
test("array_list infers concrete element type from default integer literals", {
  xs := array_list(1, 2, 3);
  xs.push(i32(4));
  assert(xs.len() == usize(4), "default integer literal lowers to i32");
});
// ---------------------------------------------------------------------------
// Regression: importing collection-literal macros without using them must
// not cause C codegen to emit invalid bodies for the variadic-quote macros.
// (Bug fix: variadic comptime/quote params + comptime return now properly
// skipped during runtime function emission.)
// ---------------------------------------------------------------------------
test("import-only collection literal macros do not break codegen", {
  // The mere `open import` above pulls array_list/hash_map/hash_set into the
  // exported symbol table. Before the fix this triggered a C compile error
  // because the macros were emitted as runtime functions with stub bodies.
  assert(true, "import-only must compile");
});
