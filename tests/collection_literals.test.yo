open import "std/libc/stdio";
open import "std/string";
open import "std/fmt";
open import "std/collections/array_list";
open import "std/collections/hash_map";
open import "std/collections/hash_set";

// ---------------------------------------------------------------------------
// array_list literal macro
// ---------------------------------------------------------------------------

test "array_list with multiple i32 elements", {
  xs := array_list(i32, i32(10), i32(20), i32(30));
  assert(xs.len() == usize(3), "len");
  total := i32(0);
  it := xs.iter();
  while true, {
    match(it.next(),
      .Some(p) => { total = (total + p.*); },
      .None => { break; }
    );
  };
  assert((total == i32(60)), "sum");
};

test "array_list empty produces an empty list", {
  xs := array_list(i32);
  assert(xs.len() == usize(0), "empty len");
};

test "array_list with single element", {
  xs := array_list(i32, i32(42));
  assert(xs.len() == usize(1), "len");
  it := xs.iter();
  match(it.next(),
    .Some(p) => assert((p.* == i32(42)), "value"),
    .None => assert(false, "should have an element")
  );
};

test "array_list with String elements (RC types)", {
  xs := array_list(String, `hello`, `world`);
  assert(xs.len() == usize(2), "len");
  it := xs.iter();
  match(it.next(),
    .Some(p) => assert((p.* == `hello`), "first"),
    .None => assert(false, "missing first")
  );
  match(it.next(),
    .Some(p) => assert((p.* == `world`), "second"),
    .None => assert(false, "missing second")
  );
};

test "array_list nested literals", {
  outer := array_list(ArrayList(i32),
    array_list(i32, i32(1), i32(2)),
    array_list(i32, i32(3), i32(4), i32(5))
  );
  assert(outer.len() == usize(2), "outer len");
  it := outer.iter();
  match(it.next(),
    .Some(p) => assert(p.*.len() == usize(2), "first inner len"),
    .None => assert(false, "missing first inner")
  );
  match(it.next(),
    .Some(p) => assert(p.*.len() == usize(3), "second inner len"),
    .None => assert(false, "missing second inner")
  );
};

// ---------------------------------------------------------------------------
// hash_map literal macro
// ---------------------------------------------------------------------------

test "hash_map with multiple entries", {
  m := hash_map(i32, i32, i32(1) => i32(10), i32(2) => i32(20), i32(3) => i32(30));
  assert(m.len() == usize(3), "len");
  match(m.get(i32(2)),
    .Some(v) => assert((v == i32(20)), "key 2"),
    .None => assert(false, "missing key 2")
  );
};

test "hash_map empty literal", {
  m := hash_map(i32, i32);
  assert(m.len() == usize(0), "empty len");
  assert(m.is_empty(), "is_empty");
};

test "hash_map with String keys and i32 values", {
  m := hash_map(String, i32, `alice` => i32(30), `bob` => i32(25));
  assert(m.len() == usize(2), "len");
  match(m.get(`alice`),
    .Some(v) => assert((v == i32(30)), "alice"),
    .None => assert(false, "missing alice")
  );
};

// ---------------------------------------------------------------------------
// hash_set literal macro
// ---------------------------------------------------------------------------

test "hash_set with multiple elements", {
  s := hash_set(i32, i32(1), i32(2), i32(3));
  assert(s.len() == usize(3), "len");
  assert(s.contains(i32(2)), "contains 2");
  assert(!(s.contains(i32(99))), "no 99");
};

test "hash_set empty literal", {
  s := hash_set(i32);
  assert(s.len() == usize(0), "empty len");
  assert(s.is_empty(), "is_empty");
};

test "hash_set deduplicates equal elements", {
  s := hash_set(i32, i32(5), i32(5), i32(5));
  assert(s.len() == usize(1), "len after dedup");
  assert(s.contains(i32(5)), "contains 5");
};
