//! plans/reference/REF_REFERENCE_SEMANTICS.md Phase 3: reference-semantics enums
//! `ref(enum(…))` / `atomic(ref(enum(…)))` — heap-allocated RC handles.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");

Shape :: ref(enum(Circle(r : i32), Square(s : i32)));
Tree :: ref(enum(Leaf(value : i32), Node(left : Self, right : Self)));
Atom :: atomic(ref(enum(Nil, Cons(v : i32))));
Wrap :: ref(enum(Empty, Has(s : String)));
// A recursive ref-enum reached BOTH via a direct `Self` field and via an
// `ArrayList(Self)` field — the shape of the compiler's own `TypeValue` /
// `AstExpr`. Its `Self` fields need no `Box`: a `ref(enum)` value is already a
// heap RC handle (pointer). Regression guard for the `getSizeOfType` /
// `getAlignmentOfType` enum bug: those walked variant field types inline and so
// recursed forever on a `ref(enum)` whose variant field is typed `Self`, unless
// the type is recognised as pointer-sized (the ref-semantics short-circuit the
// struct branch already had). The bug only surfaced for a function that
// RECONSTRUCTS the ref-enum (`fn(t) -> Self`), e.g. `nest_rebuild` below — a
// merely-reducing recursion (`tree_sum -> i32`) does not trip it.
Nest :: ref(enum(Tip(n : i32), One(inner : Self), Many(items : ArrayList(Self))));
// A VALUE enum (self-recursive via `Rc(Self)`) that holds the recursive
// ref-enum `Nest` as a field — like the compiler's own `EvalValue` holding a
// `TypeValue`. Regression guard for the RC-cycle analysis bug: analyzing such a
// type walked `Nest`'s `Self` variant fields with no visited guard → infinite
// recursion. (The struct path was guarded; the enum path was not.)
Holder :: enum(Plain(n : i32), Boxed(b : Rc(Self), t : Nest));

// `ref`/`atomic` wrap inline struct/enum literals only.
comptime_expect_error(bad_ref_named :: ref(Shape));
comptime_expect_error(bad_atomic_prim :: atomic(i32));

area :: (fn(sh : Shape) -> i32)(
  match(sh, .Circle(r) => (r * r * i32(3)), .Square(s) => (s * s))
);
tree_sum :: (fn(t : Tree) -> i32)(
  match(t, .Leaf(value) => value, .Node(left, right) => (recur(left) + recur(right)))
);
// Reduce a Nest to the sum of its tips (recurses through `Self` + ArrayList(Self)).
nest_sum :: (fn(t : Nest) -> i32)(
  match(
    t,
    .Tip(n) => n,
    .One(inner) => recur(inner),
    .Many(items) => {
      (acc : i32) = i32(0);
      (i : usize) = usize(0);
      while(i < items.len(), {
        match(
          items.get(i),
          .Some(e) => {
            acc = (acc + recur(e));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      acc
    }
  )
);
// RECONSTRUCT a Nest (returns `Self`) — this is the shape that tripped the
// `getSizeOfType`/`getAlignmentOfType` ref-enum recursion bug at def-time eval.
nest_rebuild :: (fn(t : Nest) -> Nest)(
  match(
    t,
    .Tip(n) => Nest.Tip(n : n),
    .One(inner) => Nest.One(inner : recur(inner)),
    .Many(items) => {
      out := ArrayList(Nest).new();
      (i : usize) = usize(0);
      while(i < items.len(), {
        match(
          items.get(i),
          .Some(e) => {
            out.push(recur(e));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      Nest.Many(items : out)
    }
  )
);

test("ref(enum) construct + match", {
  c := Shape.Circle(r : i32(2));
  assert(area(c) == i32(12), "circle area");
  sq := Shape.Square(s : i32(3));
  assert(area(sq) == i32(9), "square area");
});

test("ref(enum) is a shared handle (reference semantics)", {
  c := Shape.Circle(r : i32(2));
  c2 := c;
  assert(area(c2) == i32(12), "copy shares the same handle");
});

test("ref(enum) re-match (handle borrowed, not consumed) + variant reassign", {
  s := Shape.Circle(r : i32(5));
  assert(area(s) == i32(75), "first match");
  assert(area(s) == i32(75), "re-match works — match borrows the handle");
  s = Shape.Square(s : i32(4));
  assert(area(s) == i32(16), "in-place variant reassignment observed");
});

test("recursive ref(enum) builds + traverses", {
  l := Tree.Leaf(value : i32(3));
  r := Tree.Leaf(value : i32(4));
  n := Tree.Node(left : l, right : r);
  assert(tree_sum(n) == i32(7), "recursive sum over a ref-enum tree");
});

test("atomic(ref(enum)) construct + match", {
  a := Atom.Cons(v : i32(42));
  match(a, .Cons(v) => assert(v == i32(42), "atomic ref-enum field"), .Nil => ());
});

test("ref(enum) drops its variant's RC fields on free", {
  w := Wrap.Has(s : `a heap string the ref-enum must free`);
  match(w, .Has(sv) => assert(sv.len() > usize(0), "has a string"), .Empty => ());
});

test("recursive ref(enum) RECONSTRUCTION (Self + ArrayList(Self) fields)", {
  // Build a Nest reached through both a direct `Self` (`One`) and an
  // `ArrayList(Self)` (`Many`) field.
  leaves := ArrayList(Nest).new();
  leaves.push(Nest.Tip(n : i32(1)));
  leaves.push(Nest.One(inner : Nest.Tip(n : i32(2))));
  leaves.push(Nest.Tip(n : i32(4)));
  n := Nest.One(inner : Nest.Many(items : leaves));
  assert(nest_sum(n) == i32(7), "sum over a recursive ref-enum");
  // Reconstructing it (a `fn(t) -> Self`) must compile (regression: the size /
  // alignment calculators used to recurse forever on a `Self` variant field)
  // and preserve the structure.
  rebuilt := nest_rebuild(n);
  assert(nest_sum(rebuilt) == i32(7), "reconstructed ref-enum preserves structure");
});

test("value-enum holding a recursive ref(enum) field (RC-cycle analysis)", {
  // Building/using a value-enum whose field is the recursive ref-enum `Nest`
  // runs the RC-cycle analysis over `Nest`'s `Self` variant fields — which used
  // to recurse forever (the enum walk had no visited guard).
  h := Holder.Boxed(b : rc(Holder.Plain(n : i32(1))), t : Nest.Tip(n : i32(9)));
  match(
    h,
    .Boxed(_, t) => {
      assert(nest_sum(t) == i32(9), "ref-enum field inside a value-enum");
    },
    .Plain(_) => ()
  );
});

// -----------------------------------------------------------------------------
// Reference-semantics field access/mutation through a `ref(enum)` VALUE whose
// variant is not statically narrowed (e.g. a bare `fn(c : Counter)` parameter).
// A `ref(struct)` parameter already supports `s.field = x`; a `ref(enum)`
// parameter must too — the field resolves against the sole variant that
// declares it (the caller asserts the active variant; codegen emits an
// unchecked access). Regression guard for the "Failed to evaluate left-hand
// side of assignment: (c.count)" bug (property-access enum-field resolution
// only handled a narrowed `selectedVariantName`).
// -----------------------------------------------------------------------------
Counter :: ref(enum(Zero, Active(count : i32, step : i32)));

// `c.count` here exercises BOTH the field READ (RHS) and field WRITE (LHS) on a
// `ref(enum)` parameter — neither resolved before the fix.
_bump_counter :: (fn(c : Counter) -> unit)({
  c.count = (c.count + i32(10));
});

_read_counter :: (fn(c : Counter) -> i32)(c.count);

test("ref(enum) parameter field mutation propagates via reference semantics", {
  c := Counter.Active(count : i32(5), step : i32(1));
  _bump_counter(c);
  match(
    c,
    .Active({ count }) => assert(count == i32(15), "param field mutation propagates to caller"),
    .Zero => assert(false, "unexpected Zero variant")
  );
});

test("ref(enum) parameter field read (unnarrowed variant)", {
  c := Counter.Active(count : i32(42), step : i32(1));
  assert(_read_counter(c) == i32(42), "param field read resolves the declaring variant");
});

test("ref(enum) field mutation via an immutable local binding", {
  c := Counter.Active(count : i32(3), step : i32(2));
  c.count = i32(99);
  match(
    c,
    .Active({ count }) => assert(count == i32(99), "immutable-local field mutation"),
    .Zero => assert(false, "unexpected Zero variant")
  );
});

// Regression (issues/fixed/fieldless-ref-enum-simple-enum-collapse.md): an
// all-payload-free ref(enum) used to be collapsed to a bare C enum by
// canOptimizeAsSimpleEnum while its constructors and match lowering kept the
// heap-object shape (obj->header.ref_count / obj->tag) — 9 clang errors, the
// shape did not compile at all. The collapse now excludes reference-semantics
// enums in both compilers.
Flag :: ref(enum(On, Off));

test("fieldless ref(enum) compiles, matches, and is RC-managed", {
  a := Flag.On;
  b := Flag.Off;
  on := match(a, .On => true, .Off => false);
  off := match(b, .On => false, .Off => true);
  assert(on && off, "fieldless ref enum variants distinguish in match");
  a2 := a;
  assert(ref_count(a) == 2, "fieldless ref enum is a heap RC object (rc visible)");
  assert(ref_count(a2) == ref_count(a), "alias shares the same RC object");
});

// Regression (issues/fixed/ref-enum-derives-value-enum-marker-traits.md): the
// marker-trait derivation for enums predated `ref(enum)` and applied the
// VALUE-enum rules to reference enums, so `impl(E, Dispose(...))` on a ref
// enum was rejected, a NON-atomic ref enum with Send fields was `Send` (a
// non-atomic refcount shared across threads), and Comptime / Runtime / Acyclic
// ignored reference semantics. The rules are now the reference struct's: Send
// only when atomic; Runtime always; Comptime never; Acyclic when no RC cycle.
// (The `Rc` marker trait this list began with is deleted,
// plans/VALUES_BY_DEFAULT.md §3.6; `Dispose` on a ref enum is covered below.)
PlainValueEnum :: enum(PvA, PvB(x : i32));
RefEnumBox :: (fn(comptime(T) : Type) -> comptime(Type))(ref(enum(RbEmpty, RbHas(x : T))));
AtomicRefEnumBox :: (fn(comptime(T) : Type) -> comptime(Type))(atomic(ref(enum(ArbEmpty, ArbHas(x : T)))));
ref_enum_is_send :: Type.impls(Shape, Send);
ref_enum_is_runtime :: Type.impls(Shape, Runtime);
ref_enum_is_comptime :: Type.impls(Shape, Comptime);
ref_enum_is_acyclic :: Type.impls(Shape, Acyclic);
recursive_ref_enum_is_acyclic :: Type.impls(Tree, Acyclic);
atomic_ref_enum_is_send :: Type.impls(Atom, Send);
generic_ref_enum_is_send :: Type.impls(RefEnumBox(i32), Send);
generic_atomic_ref_enum_is_send :: Type.impls(AtomicRefEnumBox(i32), Send);
value_enum_is_send :: Type.impls(PlainValueEnum, Send);
value_enum_is_comptime :: Type.impls(PlainValueEnum, Comptime);

test("ref(enum) derives the reference-type marker traits", {
  assert(!ref_enum_is_send, "a non-atomic ref enum is not Send");
  assert(ref_enum_is_runtime, "a ref enum is Runtime");
  assert(!ref_enum_is_comptime, "a ref enum is never Comptime");
  assert(ref_enum_is_acyclic, "a ref enum with no RC cycle is Acyclic");
  assert(!recursive_ref_enum_is_acyclic, "a Self-recursive ref enum is not Acyclic");
  assert(atomic_ref_enum_is_send, "an atomic ref enum with Send fields is Send");
  assert(!generic_ref_enum_is_send, "an instantiated non-atomic ref enum is not Send");
  assert(generic_atomic_ref_enum_is_send, "an instantiated atomic ref enum is Send");
  assert(value_enum_is_send, "a value enum with Send fields stays Send");
  assert(value_enum_is_comptime, "a value enum with Comptime fields stays Comptime");
});

(g_ref_enum_disposed : i32) = i32(0);
Guarded :: ref(enum(GuardNone, GuardSome(label : String)));
impl(
  Guarded,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      g_ref_enum_disposed = (g_ref_enum_disposed + i32(1));
    })
  )
);

test("ref(enum) can implement Dispose; it runs once at the last release", {
  before := g_ref_enum_disposed;
  {
    g := Guarded.GuardSome(String.from("x"));
    alias := g;
    assert(ref_count(alias) == 2, "alias shares the handle");
  };
  assert((g_ref_enum_disposed - before) == i32(1), "Dispose ran exactly once for the ref enum");
  {
    _n := Guarded.GuardNone;
  };
  assert((g_ref_enum_disposed - before) == i32(2), "Dispose also runs for a payload-free variant");
});

// The `Dispose` gate is "is a reference type" at the impl site (it replaced
// the deleted `Rc` marker's `where(Self <: Rc)`, plans/VALUES_BY_DEFAULT.md
// §3.6): a self-recursive ref enum, an atomic ref enum and an instantiated
// generic ref enum may implement it, a value enum may not.
(g_ref_enum_chain_disposed : i32) = i32(0);
GuardedChain :: ref(enum(GcEnd, GcLink(next : Self)));
impl(
  GuardedChain,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      g_ref_enum_chain_disposed = (g_ref_enum_chain_disposed + i32(1));
    })
  )
);
impl(
  Atom,
  Dispose(
    dispose : (fn(self : Self) -> unit)(())
  )
);
impl(
  RefEnumBox(i32),
  Dispose(
    dispose : (fn(self : Self) -> unit)(())
  )
);

// A value enum may implement `Dispose` too: it is then move-only, and its one
// owner disposes it once (plans/VALUES_BY_DEFAULT.md §3.4, V3).
DisposedValueEnum :: enum(DvA, DvB(x : i32));
(g_value_enum_disposed : i32) = i32(0);
impl(
  DisposedValueEnum,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      g_value_enum_disposed = (g_value_enum_disposed + i32(1));
    })
  )
);
test("Dispose accepts every reference enum, and a value enum it makes move-only", {
  before := g_ref_enum_chain_disposed;
  {
    _c := GuardedChain.GcLink(GuardedChain.GcLink(GuardedChain.GcEnd));
  };
  assert((g_ref_enum_chain_disposed - before) == i32(3), "Dispose ran once per node of a self-recursive ref enum");
  value_before := g_value_enum_disposed;
  {
    v := DisposedValueEnum.DvB(i32(1));
    w := v;
  };
  assert((g_value_enum_disposed - value_before) == i32(1), "a value enum's Dispose runs once, for its one owner");
  comptime_assert(Type.impls(DisposedValueEnum, MoveOnly), "a value enum with Dispose is move-only");
  comptime_assert(!Type.impls(PlainValueEnum, MoveOnly), "one without stays copyable");
  comptime_expect_error(
    impl(
      PlainValueEnum,
      Trace(
        trace : (fn(self : Self, tracer : GcTracer) -> unit)(())
      )
    ),
    "cannot implement \"Trace\""
  );
});

// A ref(enum) with one payload-free variant and one `Self` payload is a heap
// object like any other ref(enum), never folded into its payload's pointer (the
// nullable-pointer layout is for VALUE enums such as `Option(T)`). Folded, it
// emitted `typedef T* T` and failed to compile; with `derive(Eq)` the derived
// `==`'s recursive call on the payload was an abort() stub
// (issues/fixed/derived-eq-ref-enum-self-payload-hollow-at-runtime.md).
Chain :: ref(enum(End, Link(next : Self)));
derive(Chain, Eq(Chain));
chain_len :: (fn(c : Chain) -> i32)(
  match(c, .End => i32(0), .Link(next) => (recur(next) + i32(1)))
);
Kind3 :: ref(enum(Leaf, Other, Node(elem : Self)));
derive(Kind3, Eq(Kind3));
Payload :: ref(struct(n : i32));
Slot :: ref(enum(Vacant, Held(p : Payload)));

test("ref(enum) with a unit variant and a Self payload builds, matches and recurses", {
  c := Chain.Link(next : Chain.Link(next : Chain.End));
  assert(chain_len(c) == i32(2), "two links");
  assert(chain_len(Chain.End) == i32(0), "the end has no links");
});

test("derive(Eq) on a ref(enum) with a Self payload compares structurally", {
  a := Chain.Link(next : Chain.End);
  b := Chain.Link(next : Chain.End);
  c := Chain.Link(next : Chain.Link(next : Chain.End));
  assert(a == b, "equal chains built separately");
  assert(!(a == c), "different lengths");
  assert(a != c, "the derived != agrees");
  assert(Chain.End == Chain.End, "unit variants");
  k := Kind3.Node(elem : Kind3.Node(elem : Kind3.Leaf));
  assert(k == Kind3.Node(elem : Kind3.Node(elem : Kind3.Leaf)), "three-variant shape, nested payloads");
  assert(!(k == Kind3.Node(elem : Kind3.Node(elem : Kind3.Other))), "the innermost variant differs");
  assert(!(Kind3.Leaf == Kind3.Other), "distinct unit variants");
});

test("a ref(enum) whose only payload is a ref handle keeps its own identity", {
  // The payload is built inline, so only the variant field holds it. Laid out
  // as its payload's pointer, the enum would share the payload's count.
  s := Slot.Held(p : Payload(n : i32(7)));
  alias := s;
  assert(ref_count(s) == 2, "the enum handle is shared by s and alias");
  payload_rc := match(alias, .Held(q) => ref_count(q), .Vacant => usize(0));
  assert(payload_rc == 1, "the payload has its own count: only the variant field holds it");
  n := match(alias, .Held(q) => q.n, .Vacant => i32(0));
  assert(n == i32(7), "payload read through the alias");
  assert(match(Slot.Vacant, .Vacant => true, .Held(_) => false), "payload-free variant");
});
