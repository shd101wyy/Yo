{ assert } :: import("std/assert");
// Test: Self.method (associated/static-style call) supports forward refs.
// Also covers: P.method (type-name dispatch from outside the impl block).
// Tracking issue: docs/en-US/IMPL_FORWARD_REFERENCES.md
open(import("std/string"));
P :: struct(x : i32);
impl(
  P,
  // Forward reference via Self.method (no self instance) — caller defined
  // before callee in source order.
  caller : (fn(n : i32) -> i32)(
    Self.callee(n)
  ),
  callee : (fn(n : i32) -> i32)(
    n + i32(1)
  )
);
test("Self.method forward reference within single impl", {
  assert(P.caller(i32(10)) == i32(11), "Self.callee(10) + 1");
});
// Mutual recursion via Self.method
N :: struct(value : i32);
impl(
  N,
  is_even_static : (fn(n : i32) -> bool)(
    cond(
      (n == i32(0)) => true,
      true => Self.is_odd_static(n - i32(1))
    )
  ),
  is_odd_static : (fn(n : i32) -> bool)(
    cond(
      (n == i32(0)) => false,
      true => Self.is_even_static(n - i32(1))
    )
  )
);
test("Self.method mutual recursion via static-style call", {
  assert(N.is_even_static(i32(10)), "10 is even");
  assert(N.is_odd_static(i32(7)), "7 is odd");
});
