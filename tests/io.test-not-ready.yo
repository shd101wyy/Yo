// THIS TEST FILE IS NOT READY YET. IT'S JUST A PLACEHOLDER FOR FUTURE TESTS.
// io.test.yo - Tests for std/io.yo async I/O primitives
//
// Tests low-level async I/O operations:
// - Linux: io_uring
// - macOS: dispatch_io (Grand Central Dispatch)

open import "std/libc/stdio";
open import "std/libc/unistd";
{ String } :: import "std/string";
{
  IOError, IOFuture, Statx,
  AT_FDCWD, AT_REMOVEDIR, AT_SYMLINK_NOFOLLOW, STATX_BASIC_STATS,
  S_IFMT, S_IFREG, S_IFDIR, S_IFLNK,
  S_IRWXU, S_IRUSR, S_IWUSR, S_IXUSR,
  DEFAULT_FILE_MODE, DEFAULT_DIR_MODE,
  O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_EXCL, O_TRUNC, O_APPEND,
  __yo_async_read_start, __yo_async_write_start,
  __yo_async_openat_start, __yo_async_close_start,
  __yo_async_statx_start, __yo_async_mkdirat_start,
  __yo_async_unlinkat_start, __yo_async_renameat_start,
  __yo_file_open, __yo_file_close, __yo_file_size
} :: import "std/io";
{ ArrayList } :: import "std/collections/array_list";
Async :: import "std/async";

// ============================================================================
// Test: IOError.from_errno
// ============================================================================

test "IOError.from_errno maps ENOENT to NotFound", {
  { ENOENT } :: import "std/libc/errno";
  err := IOError.from_errno(ENOENT);
  match(err,
    .NotFound => assert(true),
    _ => assert(false)
  );
};

test "IOError.from_errno maps EACCES to PermissionDenied", {
  { EACCES } :: import "std/libc/errno";
  err := IOError.from_errno(EACCES);
  match(err,
    .PermissionDenied => assert(true),
    _ => assert(false)
  );
};

test "IOError.from_errno maps EEXIST to AlreadyExists", {
  { EEXIST } :: import "std/libc/errno";
  err := IOError.from_errno(EEXIST);
  match(err,
    .AlreadyExists => assert(true),
    _ => assert(false)
  );
};

test "IOError.from_errno maps unknown errno to Other", {
  err := IOError.from_errno(i32(9999));
  match(err,
    .Other(code) => assert(code == i32(9999)),
    _ => assert(false)
  );
};

// ============================================================================
// Test: IOError.from_result
// ============================================================================

test "IOError.from_result returns Ok for positive result", {
  result := IOError.from_result(i32(42));
  match(result,
    .Ok(value) => assert(value == i32(42)),
    .Err(_) => assert(false)
  );
};

test "IOError.from_result returns Ok for zero result", {
  result := IOError.from_result(i32(0));
  match(result,
    .Ok(value) => assert(value == i32(0)),
    .Err(_) => assert(false)
  );
};

test "IOError.from_result returns Err for negative result", {
  { ENOENT } :: import "std/libc/errno";
  result := IOError.from_result((i32(0) - ENOENT));
  match(result,
    .Ok(_) => assert(false),
    .Err(err) => {
      match(err,
        .NotFound => assert(true),
        _ => assert(false)
      );
    }
  );
};

// ============================================================================
// Test: Synchronous file operations
// ============================================================================

test "file open and close", {
  // Open a file that exists (the test file)
  fd := __yo_file_open("tests/fixtures/test_file.txt".as_ptr(), O_RDONLY, i32(0));
  assert(fd >= i32(0));
  
  // Close the file
  __yo_file_close(fd);
};

test "file open nonexistent returns error", {
  fd := __yo_file_open("/nonexistent/path/file.txt".as_ptr(), O_RDONLY, i32(0));
  assert(fd < i32(0));  // Should be negative errno
  
  // Check that it's ENOENT
  { ENOENT } :: import "std/libc/errno";
  assert(fd == (i32(0) - ENOENT));
};

test "file size", {
  fd := __yo_file_open("tests/fixtures/test_file.txt".as_ptr(), O_RDONLY, i32(0));
  assert(fd >= i32(0));
  
  size := __yo_file_size(fd);
  assert(size > i64(0));  // File should have some content
  
  __yo_file_close(fd);
};

// ============================================================================
// Test: Async file read
// ============================================================================

test "async read file", {
  async {
    // Open the test file
    fd := __yo_file_open("tests/fixtures/test_file.txt".as_ptr(), O_RDONLY, i32(0));
    assert(fd >= i32(0));
    
    // Allocate buffer
    buffer := ArrayList(u8).new();
    i := usize(0);
    loop {
      cond(
        (i >= usize(256)) => break,
        true => {
          buffer.push(u8(0));
          i = (i + usize(1));
        }
      );
    };
    
    // Start async read
    future := __yo_async_read_start(fd, buffer.as_ptr(), u32(256), u64(0));
    result := await future;
    
    // Check result (should be positive = bytes read)
    assert(result > i32(0));
    
    // Check that we read the expected content (starts with "Hello")
    assert(buffer.get(usize(0)).unwrap() == u8(72));  // 'H'
    assert(buffer.get(usize(1)).unwrap() == u8(101)); // 'e'
    assert(buffer.get(usize(2)).unwrap() == u8(108)); // 'l'
    assert(buffer.get(usize(3)).unwrap() == u8(108)); // 'l'
    assert(buffer.get(usize(4)).unwrap() == u8(111)); // 'o'
    
    __yo_file_close(fd);
  };
};

test "async read with offset", {
  async {
    fd := __yo_file_open("tests/fixtures/test_file.txt".as_ptr(), O_RDONLY, i32(0));
    assert(fd >= i32(0));
    
    // Allocate buffer
    buffer := ArrayList(u8).new();
    i := usize(0);
    loop {
      cond(
        (i >= usize(64)) => break,
        true => {
          buffer.push(u8(0));
          i = (i + usize(1));
        }
      );
    };
    
    // Read from offset 6 (should skip "Hello ")
    future := __yo_async_read_start(fd, buffer.as_ptr(), u32(64), u64(6));
    result := await future;
    
    assert(result > i32(0));
    
    // Should start with "from" (after "Hello ")
    assert(buffer.get(usize(0)).unwrap() == u8(102)); // 'f'
    assert(buffer.get(usize(1)).unwrap() == u8(114)); // 'r'
    assert(buffer.get(usize(2)).unwrap() == u8(111)); // 'o'
    assert(buffer.get(usize(3)).unwrap() == u8(109)); // 'm'
    
    __yo_file_close(fd);
  };
};

// ============================================================================
// Test: Async file write
// ============================================================================

test "async write and read file", {
  async {
    test_path := "/tmp/yo_io_test_write.txt";
    
    // Open file for writing (create/truncate)
    open_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := __yo_file_open(test_path.as_ptr(), open_flags, i32(0o644));
    assert(fd >= i32(0));
    
    // Data to write
    data := "Hello from Yo async I/O test!";
    data_len := u32(30);
    
    // Async write
    write_future := __yo_async_write_start(fd, data.as_ptr(), data_len, u64(0));
    write_result := await write_future;
    assert(write_result == i32(30));
    
    __yo_file_close(fd);
    
    // Read back and verify
    fd2 := __yo_file_open(test_path.as_ptr(), O_RDONLY, i32(0));
    assert(fd2 >= i32(0));
    
    read_buffer := ArrayList(u8).new();
    i := usize(0);
    loop {
      cond(
        (i >= usize(64)) => break,
        true => {
          read_buffer.push(u8(0));
          i = (i + usize(1));
        }
      );
    };
    
    read_future := __yo_async_read_start(fd2, read_buffer.as_ptr(), u32(64), u64(0));
    read_result := await read_future;
    assert(read_result == i32(30));
    
    // Verify content
    assert(read_buffer.get(usize(0)).unwrap() == u8(72));   // 'H'
    assert(read_buffer.get(usize(5)).unwrap() == u8(32));   // ' '
    assert(read_buffer.get(usize(6)).unwrap() == u8(102));  // 'f'
    
    __yo_file_close(fd2);
    
    // Cleanup
    unlink(test_path.as_ptr());
  };
};

// ============================================================================
// Test: Async openat and close
// ============================================================================

test "async openat file", {
  async {
    open_future := __yo_async_openat_start(AT_FDCWD, "tests/fixtures/test_file.txt".as_ptr(), O_RDONLY, i32(0));
    fd_result := await open_future;
    assert(fd_result >= i32(0));
    
    close_future := __yo_async_close_start(fd_result);
    close_result := await close_future;
    assert(close_result == i32(0));
  };
};

test "async openat nonexistent returns error", {
  async {
    open_future := __yo_async_openat_start(AT_FDCWD, "/nonexistent/file.txt".as_ptr(), O_RDONLY, i32(0));
    fd_result := await open_future;
    
    { ENOENT } :: import "std/libc/errno";
    assert(fd_result == (i32(0) - ENOENT));
  };
};

// ============================================================================
// Test: Async stat
// ============================================================================

test "async stat file", {
  { malloc, free } :: import "std/libc/stdlib";
  { __yo_statx_buf_size, __yo_statx_size, __yo_statx_mode } :: import "std/io";
  
  async {
    // Allocate stat buffer
    buf_size := __yo_statx_buf_size();
    buf := malloc(buf_size);
    assert(buf != ptr_null(u8));
    
    stat_future := __yo_async_statx_start(
      AT_FDCWD,
      "tests/fixtures/test_file.txt".as_ptr(),
      i32(0),
      STATX_BASIC_STATS,
      buf
    );
    stat_result := await stat_future;
    assert(stat_result == i32(0));
    
    // Check that it's a regular file
    mode := __yo_statx_mode(buf);
    file_type := (mode & S_IFMT);
    assert(file_type == S_IFREG);
    
    // Check that size is positive
    size := __yo_statx_size(buf);
    assert(size > i64(0));
    
    free(buf);
  };
};

test "async stat directory", {
  { malloc, free } :: import "std/libc/stdlib";
  { __yo_statx_buf_size, __yo_statx_mode } :: import "std/io";
  
  async {
    buf_size := __yo_statx_buf_size();
    buf := malloc(buf_size);
    assert(buf != ptr_null(u8));
    
    stat_future := __yo_async_statx_start(
      AT_FDCWD,
      "tests".as_ptr(),
      i32(0),
      STATX_BASIC_STATS,
      buf
    );
    stat_result := await stat_future;
    assert(stat_result == i32(0));
    
    // Check that it's a directory
    mode := __yo_statx_mode(buf);
    file_type := (mode & S_IFMT);
    assert(file_type == S_IFDIR);
    
    free(buf);
  };
};

// ============================================================================
// Test: Async mkdir and unlink
// ============================================================================

test "async mkdir and rmdir", {
  async {
    test_dir := "/tmp/yo_io_test_mkdir";
    
    // Create directory
    mkdir_future := __yo_async_mkdirat_start(AT_FDCWD, test_dir.as_ptr(), i32(0o755));
    mkdir_result := await mkdir_future;
    assert(mkdir_result == i32(0));
    
    // Verify it exists by stat'ing it
    { malloc, free } :: import "std/libc/stdlib";
    { __yo_statx_buf_size, __yo_statx_mode } :: import "std/io";
    
    buf_size := __yo_statx_buf_size();
    buf := malloc(buf_size);
    
    stat_future := __yo_async_statx_start(AT_FDCWD, test_dir.as_ptr(), i32(0), STATX_BASIC_STATS, buf);
    stat_result := await stat_future;
    assert(stat_result == i32(0));
    
    mode := __yo_statx_mode(buf);
    file_type := (mode & S_IFMT);
    assert(file_type == S_IFDIR);
    
    free(buf);
    
    // Remove directory
    rmdir_future := __yo_async_unlinkat_start(AT_FDCWD, test_dir.as_ptr(), AT_REMOVEDIR);
    rmdir_result := await rmdir_future;
    assert(rmdir_result == i32(0));
  };
};

// ============================================================================
// Test: Async rename
// ============================================================================

test "async rename file", {
  async {
    old_path := "/tmp/yo_io_test_rename_old.txt";
    new_path := "/tmp/yo_io_test_rename_new.txt";
    
    // Create the old file
    open_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := __yo_file_open(old_path.as_ptr(), open_flags, i32(0o644));
    assert(fd >= i32(0));
    __yo_file_close(fd);
    
    // Rename it
    rename_future := __yo_async_renameat_start(
      AT_FDCWD, old_path.as_ptr(),
      AT_FDCWD, new_path.as_ptr()
    );
    rename_result := await rename_future;
    assert(rename_result == i32(0));
    
    // Verify new file exists
    fd2 := __yo_file_open(new_path.as_ptr(), O_RDONLY, i32(0));
    assert(fd2 >= i32(0));
    __yo_file_close(fd2);
    
    // Verify old file doesn't exist
    fd3 := __yo_file_open(old_path.as_ptr(), O_RDONLY, i32(0));
    assert(fd3 < i32(0));
    
    // Cleanup
    unlink(new_path.as_ptr());
  };
};

// ============================================================================
// Test: Concurrent async operations
// ============================================================================

test "multiple concurrent reads", {
  async {
    // Open test file
    fd := __yo_file_open("tests/fixtures/test_file.txt".as_ptr(), O_RDONLY, i32(0));
    assert(fd >= i32(0));
    
    // Allocate buffers
    buf1 := ArrayList(u8).new();
    buf2 := ArrayList(u8).new();
    i := usize(0);
    loop {
      cond(
        (i >= usize(32)) => break,
        true => {
          buf1.push(u8(0));
          buf2.push(u8(0));
          i = (i + usize(1));
        }
      );
    };
    
    // Start two reads concurrently (different offsets)
    future1 := __yo_async_read_start(fd, buf1.as_ptr(), u32(5), u64(0));   // "Hello"
    future2 := __yo_async_read_start(fd, buf2.as_ptr(), u32(4), u64(6));  // "from"
    
    // Wait for both
    result1 := await future1;
    result2 := await future2;
    
    assert(result1 == i32(5));
    assert(result2 == i32(4));
    
    // Verify content
    assert(buf1.get(usize(0)).unwrap() == u8(72));   // 'H'
    assert(buf2.get(usize(0)).unwrap() == u8(102));  // 'f'
    
    __yo_file_close(fd);
  };
};

// ============================================================================
// Test: Yielding between I/O operations
// ============================================================================

test "yield between async operations", {
  async {
    // This test verifies that the event loop properly handles yielding
    
    fd := __yo_file_open("tests/fixtures/test_file.txt".as_ptr(), O_RDONLY, i32(0));
    assert(fd >= i32(0));
    
    buf := ArrayList(u8).new();
    i := usize(0);
    loop {
      cond(
        (i >= usize(32)) => break,
        true => {
          buf.push(u8(0));
          i = (i + usize(1));
        }
      );
    };
    
    // Read
    read_future := __yo_async_read_start(fd, buf.as_ptr(), u32(5), u64(0));
    result := await read_future;
    assert(result == i32(5));
    
    // Yield
    await Async.yield();
    
    // Read again
    read_future2 := __yo_async_read_start(fd, buf.as_ptr(), u32(4), u64(6));
    result2 := await read_future2;
    assert(result2 == i32(4));
    
    __yo_file_close(fd);
  };
};

export;
