//! Identifier catch-alls and constant patterns
//! (plans/reference/MATCH_PATTERN_MATCHING.md §4.3): a bare identifier binds the
//! scrutinee unless it names a compile-time constant in scope, in which case
//! it compares; enum constants (`RED`, `Color.Red`) lower to tag tests.
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
import("std/fmt");
Color :: enum(Red, Green, Blue);
derive(Color, Copy, Clone);
TEN :: i32(10);
RED :: Color.Red;
test("an identifier arm binds the scrutinee", {
  f :: (fn(n : i32) -> i32)(
    match(
      n,
      0 => i32(100),
      other => (other * i32(2))
    )
  );
  assert(f(0) == i32(100));
  assert(f(21) == i32(42));
});
test("an identifier arm binds an enum scrutinee", {
  g :: (fn(c : Color) -> bool)(
    match(
      c,
      .Red => true,
      whole => match(
        whole,
        .Green => false,
        _ => false
      )
    )
  );
  assert(g(Color.Red));
  assert(!g(Color.Blue));
});
test("a compile-time constant in scope compares instead of binding", {
  h :: (fn(n : i32) -> i32)(
    match(
      n,
      TEN => i32(1),
      _ => i32(0)
    )
  );
  assert(h(10) == i32(1));
  assert(h(11) == i32(0));
});
test("enum constants are variant patterns", {
  k :: (fn(c : Color) -> i32)(
    match(
      c,
      RED => i32(1),
      Color.Green => i32(2),
      .Blue => i32(3)
    )
  );
  assert(k(Color.Red) == i32(1));
  assert(k(Color.Green) == i32(2));
  assert(k(Color.Blue) == i32(3));
});
test("a typed literal call is a constant pattern", {
  m :: (fn(n : i64) -> i32)(
    match(
      n,
      i64(5) => i32(1),
      _ => i32(0)
    )
  );
  assert(m(5) == i32(1));
  assert(m(6) == i32(0));
});
test("catch-all on a compile-time scrutinee", {
  K :: i32(7);
  r :: match(
    K,
    0 => i32(0),
    v => (v + i32(1))
  );
  assert(r == i32(8));
});
// `Option` of a reference handle lowers to the nullable pointer
// (plans/EVALUATOR_MEMORY_REDUCTION.md Phase 3), whose match path classified a
// `_` arm as the pointer case and let it OVERWRITE the earlier `.Some` arm:
// `.Some(c) => c.v, _ => fallback` always took the fallback.
Crate :: ref(struct(v : i32));
test("a wildcard after .Some on a nullable-pointer Option only covers .None", {
  pick :: (fn(o : &Option(Crate)) -> i32)(match(o, .Some(c) => c.v, _ => i32(-1)));
  assert(pick(Option(Crate).Some(Crate(v : i32(7)))) == i32(7), ".Some takes its own arm");
  assert(pick(Option(Crate).None) == i32(-1), ".None takes the wildcard");
});
// A match on an owned nullable-pointer Option (a reference-handle payload,
// plans/EVALUATOR_MEMORY_REDUCTION.md Phase 3) must release its scrutinee: the
// nullable-pointer lowering skipped the match's deferred drops, so every
// `match(xs.get(i), .Some(t) => …)` leaked the reference `.get()` returned
// (1.26 M objects in `check src/main.yo`).
(g_tracked_disposed : i32) = i32(0);
Tracked :: ref(struct(v : i32));
impl(
  Tracked,
  Dispose(
    dispose : (fn(self : &Self) -> unit)({
      g_tracked_disposed = (g_tracked_disposed + i32(1));
    })
  )
);
test("a match on an owned nullable-pointer Option releases its scrutinee", {
  before := g_tracked_disposed;
  {
    xs := ArrayList(Tracked).new();
    xs.push(Tracked(v : i32(1)));
    xs.push(Tracked(v : i32(2)));
    (sum : i32) = i32(0);
    (i : usize) = usize(0);
    positions := ArrayList(usize).new();
    positions.push(usize(0));
    positions.push(usize(1));
    while(i < positions.len(), {
      // The shape of the compiler's `get_variables_from_env`: the Option(ref)
      // match sits inside another match's arm.
      match(
        positions.get(i),
        .Some(pos) => match(
          xs.get(pos),
          .Some(t) => {
            sum = (sum + t.v);
          },
          .None => ()
        ),
        .None => ()
      );
      i = (i + usize(1));
    });
    assert(sum == i32(3), "both payloads were read");
  };
  assert((g_tracked_disposed - before) == i32(2), "each element is disposed once the list is gone");
});
// A literal sub-pattern in a variant arm must fall through to the later arms
// on a miss: the tagged-union switch guarded the arm inside its `case TAG:`
// and ended the block in a bare `break`, so a value whose TAG matched but
// whose literal did not skipped the trailing `_` and left the result temp
// uninitialized (issues/fixed/a-literal-sub-pattern-in-a-variant-arm-skips-the-wildcard-arm.md).
TagLit :: enum(Leaf(n : i32), Node(k : i32, flag : bool));
test("a literal sub-pattern miss takes the wildcard arm", {
  pick :: (fn(e : &TagLit) -> i32)(match(e, .Node(k, true) => k, _ => i32(-1)));
  picki :: (fn(e : &TagLit) -> i32)(match(e, .Node(7, f) => i32(70), _ => i32(-1)));
  assert(pick(TagLit.Node(i32(5), true)) == i32(5), "the guarded arm runs when its literal holds");
  assert(pick(TagLit.Node(i32(6), false)) == i32(-1), "a bool literal miss reaches the wildcard");
  assert(pick(TagLit.Leaf(i32(1))) == i32(-1), "another tag reaches the wildcard");
  assert(picki(TagLit.Node(i32(7), false)) == i32(70), "the int-guarded arm ignores the other field");
  assert(picki(TagLit.Node(i32(8), false)) == i32(-1), "an int literal miss reaches the wildcard");
});
test("literal arms that jointly cover their variant still split by payload", {
  both :: (fn(e : &TagLit) -> i32)(
    match(
      e,
      .Node(k, true) => k,
      .Node(k, false) => (i32(0) - k),
      .Leaf(n) => n
    )
  );
  assert(both(TagLit.Node(i32(5), true)) == i32(5), "the true arm");
  assert(both(TagLit.Node(i32(5), false)) == i32(-5), "the false arm");
  assert(both(TagLit.Leaf(i32(9))) == i32(9), "the other variant");
});
