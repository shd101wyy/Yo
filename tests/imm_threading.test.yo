pragma(Pragma.SkipWasm32Wasi); // no pthread support in standalone WASI
{ assert } :: import("std/assert");
// Tests for std/imm collections in multi-threaded environments.
// Verifies that immutable/persistent data structures can be safely
// shared across threads without data races.
{ arch, Arch } :: import("std/process");
open(import("std/fmt"));
{ Thread, ThreadPool, spawn } :: import("std/thread");
{ Channel } :: import("std/sync/channel");
{ WaitGroup } :: import("std/sync/waitgroup");
{ Vec, PopResult } :: import("std/imm/vec");
{ List } :: import("std/imm/list");
{ Map } :: import("std/imm/map");
{ Set } :: import("std/imm/set");
{ SortedMap } :: import("std/imm/sorted_map");
{ SortedSet } :: import("std/imm/sorted_set");
{ ImmString } :: import("std/imm/string");
// ============================================================================
// Vec cross-thread sharing
// ============================================================================
test("Vec shared across threads read-only", {
  if(arch == Arch.Wasm32, return(()));
  v := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  ch := Channel(bool).new(usize(4));
  t1 := Thread.spawn((io) => {
    assert(v(usize(0)) == i32(10), "thread1 sees 10");
    assert(v(usize(1)) == i32(20), "thread1 sees 20");
    assert(v(usize(2)) == i32(30), "thread1 sees 30");
    ch.send(true);
  });
  t2 := Thread.spawn((io) => {
    assert(v.len() == usize(3), "thread2 sees length 3");
    assert(v(usize(2)) == i32(30), "thread2 sees 30");
    ch.send(true);
  });
  ch.recv();
  ch.recv();
  t1.join();
  t2.join();
});
test("Vec persistence — versions created on main, read across threads", {
  if(arch == Arch.Wasm32, return(()));
  // Create base and two independent versions on main thread
  // NOTE: Vec.push uses own(self), so we must be careful about move semantics
  base := Vec(i32).new().push(i32(1)).push(i32(2));
  v1 := base.push(i32(3)).push(i32(4));
  // base was consumed by push; recreate for v2
  base2 := Vec(i32).new().push(i32(1)).push(i32(2));
  v2 := base2.push(i32(99));
  ch := Channel(bool).new(usize(4));
  // Threads verify the independent versions
  t1 := Thread.spawn((io) => {
    assert(v1.len() == usize(4), "v1 has 4 elements");
    assert(v1(usize(3)) == i32(4), "v1 last is 4");
    ch.send(true);
  });
  t2 := Thread.spawn((io) => {
    assert(v2.len() == usize(3), "v2 has 3 elements");
    assert(v2(usize(2)) == i32(99), "v2 last is 99");
    ch.send(true);
  });
  ch.recv();
  ch.recv();
  t1.join();
  t2.join();
});
// ============================================================================
// List cross-thread sharing
// ============================================================================
test("List shared across threads", {
  if(arch == Arch.Wasm32, return(()));
  xs := List(i32).new().prepend(i32(3)).prepend(i32(2)).prepend(i32(1));
  ch := Channel(bool).new(usize(4));
  t1 := Thread.spawn((io) => {
    assert(xs.head().unwrap() == i32(1), "t1 head is 1");
    ch.send(true);
  });
  t2 := Thread.spawn((io) => {
    assert(xs.len() == usize(3), "t2 length is 3");
    ch.send(true);
  });
  ch.recv();
  ch.recv();
  t1.join();
  t2.join();
});
test("List persistence across threads — prepend creates independent versions", {
  if(arch == Arch.Wasm32, return(()));
  base := List(i32).new().prepend(i32(2)).prepend(i32(1));
  ch := Channel(i32).new(usize(4));
  t1 := Thread.spawn((io) => {
    v1 := base.prepend(i32(0));
    ch.send(v1.head().unwrap());
  });
  t2 := Thread.spawn((io) => {
    v2 := base.prepend(i32(99));
    ch.send(v2.head().unwrap());
  });
  h1 := ch.recv().unwrap();
  h2 := ch.recv().unwrap();
  // One should be 0, the other 99
  assert((h1 + h2) == i32(99), "one head 0, other 99");
  t1.join();
  t2.join();
});
// ============================================================================
// Map cross-thread sharing
// ============================================================================
test("Map shared across threads read-only", {
  if(arch == Arch.Wasm32, return(()));
  m := Map(i32, i32).new().insert(i32(1), i32(100)).insert(i32(2), i32(200));
  ch := Channel(bool).new(usize(4));
  t1 := Thread.spawn((io) => {
    assert(m.get(i32(1)).unwrap() == i32(100), "t1 gets key 1");
    ch.send(true);
  });
  t2 := Thread.spawn((io) => {
    assert(m.get(i32(2)).unwrap() == i32(200), "t2 gets key 2");
    ch.send(true);
  });
  ch.recv();
  ch.recv();
  t1.join();
  t2.join();
});
test("Map persistence across threads", {
  if(arch == Arch.Wasm32, return(()));
  base := Map(i32, i32).new().insert(i32(1), i32(10));
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    m1 := base.insert(i32(2), i32(20)).insert(i32(3), i32(30));
    ch.send(m1.len());
  });
  t2 := Thread.spawn((io) => {
    m2 := base.insert(i32(99), i32(99));
    ch.send(m2.len());
  });
  l1 := ch.recv().unwrap();
  l2 := ch.recv().unwrap();
  // Order of receives is non-deterministic; check sum instead
  assert((l1 + l2) == usize(5), "combined map lengths = 3 + 2 = 5");
  assert(base.len() == usize(1), "base unchanged");
  t1.join();
  t2.join();
});
// ============================================================================
// SortedMap cross-thread sharing
// ============================================================================
test("SortedMap shared across threads", {
  if(arch == Arch.Wasm32, return(()));
  sm := SortedMap(i32, i32).new().insert(i32(3), i32(30)).insert(i32(1), i32(10)).insert(i32(2), i32(20));
  ch := Channel(i32).new(usize(4));
  t1 := Thread.spawn((io) => {
    ch.send(sm.min_key().unwrap());
  });
  t2 := Thread.spawn((io) => {
    ch.send(sm.max_key().unwrap());
  });
  min_k := ch.recv().unwrap();
  max_k := ch.recv().unwrap();
  assert((min_k + max_k) == i32(4), "min=1, max=3");
  t1.join();
  t2.join();
});
// ============================================================================
// Set and SortedSet cross-thread sharing
// ============================================================================
test("Set shared across threads", {
  if(arch == Arch.Wasm32, return(()));
  s := Set(i32).new().insert(i32(1)).insert(i32(2)).insert(i32(3));
  ch := Channel(bool).new(usize(4));
  t1 := Thread.spawn((io) => {
    assert(s.contains(i32(1)), "t1 sees 1");
    assert(s.contains(i32(2)), "t1 sees 2");
    ch.send(true);
  });
  t2 := Thread.spawn((io) => {
    assert(s.contains(i32(3)), "t2 sees 3");
    assert(s.len() == usize(3), "t2 sees len 3");
    ch.send(true);
  });
  ch.recv();
  ch.recv();
  t1.join();
  t2.join();
});
test("SortedSet shared across threads", {
  if(arch == Arch.Wasm32, return(()));
  ss := SortedSet(i32).new().insert(i32(5)).insert(i32(1)).insert(i32(3));
  ch := Channel(i32).new(usize(4));
  t1 := Thread.spawn((io) => {
    ch.send(ss.min().unwrap());
  });
  t2 := Thread.spawn((io) => {
    ch.send(ss.max().unwrap());
  });
  min_v := ch.recv().unwrap();
  max_v := ch.recv().unwrap();
  assert((min_v + max_v) == i32(6), "min=1, max=5");
  t1.join();
  t2.join();
});
// ============================================================================
// ImmString cross-thread sharing
// ============================================================================
test("ImmString shared across threads", {
  if(arch == Arch.Wasm32, return(()));
  s := ImmString.from("hello world");
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    ch.send(s.len());
  });
  t2 := Thread.spawn((io) => {
    ch.send(s.len());
  });
  l1 := ch.recv().unwrap();
  l2 := ch.recv().unwrap();
  assert(l1 == usize(11), "t1 sees correct length");
  assert(l2 == usize(11), "t2 sees correct length");
  t1.join();
  t2.join();
});
// ============================================================================
// Producer-consumer with Channel(Vec)
// ============================================================================
test("Channel of Vec — producer sends immutable snapshots to consumer", {
  if(arch == Arch.Wasm32, return(()));
  ch := Channel(Vec(i32)).new(usize(10));
  producer := Thread.spawn((io) => {
    v := Vec(i32).new();
    i := i32(0);
    while(runtime(i < i32(5)), {
      v = v.push(i);
      ch.send(v);
      i = (i + i32(1));
    });
  });
  // Consumer receives 5 snapshots with increasing lengths
  i := usize(0);
  while(runtime(i < usize(5)), {
    snapshot := ch.recv().unwrap();
    assert(snapshot.len() == (i + usize(1)), "snapshot length matches");
    i = (i + usize(1));
  });
  producer.join();
});
// ============================================================================
// Thread pool with immutable collections
// ============================================================================
test("ThreadPool reads shared Map", {
  if(arch == Arch.Wasm32, return(()));
  pool := ThreadPool.with_hardware_threads();
  m := Map(i32, i32).new().insert(i32(1), i32(10)).insert(i32(2), i32(20)).insert(i32(3), i32(30));
  wg := WaitGroup.new();
  wg.add(i32(3));
  spawn(pool, (io) => {
    assert(m.get(i32(1)).unwrap() == i32(10), "worker1 reads key 1");
    wg.done();
  });
  spawn(pool, (io) => {
    assert(m.get(i32(2)).unwrap() == i32(20), "worker2 reads key 2");
    wg.done();
  });
  spawn(pool, (io) => {
    assert(m.get(i32(3)).unwrap() == i32(30), "worker3 reads key 3");
    wg.done();
  });
  wg.wait();
});
test("ThreadPool creates independent List versions", {
  if(arch == Arch.Wasm32, return(()));
  pool := ThreadPool.with_hardware_threads();
  base := List(i32).new().prepend(i32(2)).prepend(i32(1));
  ch := Channel(i32).new(usize(10));
  wg := WaitGroup.new();
  wg.add(i32(3));
  spawn(pool, (io) => {
    v := base.prepend(i32(100));
    ch.send(v.head().unwrap());
    wg.done();
  });
  spawn(pool, (io) => {
    v := base.prepend(i32(200));
    ch.send(v.head().unwrap());
    wg.done();
  });
  spawn(pool, (io) => {
    v := base.prepend(i32(300));
    ch.send(v.head().unwrap());
    wg.done();
  });
  wg.wait();
  // Collect results — each worker prepended a different value
  sum := i32(0);
  i := i32(0);
  while(runtime(i < i32(3)), {
    sum = (sum + ch.recv().unwrap());
    i = (i + i32(1));
  });
  assert(sum == i32(600), "sum of prepended heads is 600");
});
test("Queued worker task keeps captured ImmString alive after creator scope exits", {
  if(arch == Arch.Wasm32, return(()));
  pool := ThreadPool.with_hardware_threads();
  worker_count := pool.num_threads();
  ready := Channel(bool).new(worker_count);
  release := Channel(bool).new(worker_count);
  result := Channel(usize).new(usize(1));
  i := usize(0);
  while(runtime(i < worker_count), {
    spawn(pool, (io) => {
      ready.send(true);
      release.recv().unwrap();
    });
    i = (i + usize(1));
  });
  i = usize(0);
  while(runtime(i < worker_count), {
    ready.recv().unwrap();
    i = (i + usize(1));
  });
  {
    s := ImmString.from("hello");
    spawn(pool, (io) => {
      result.send(s.len());
    });
  };
  i = usize(0);
  while(runtime(i < worker_count), {
    release.send(true);
    i = (i + usize(1));
  });
  len := result.recv().unwrap();
  assert(len == usize(5), "queued worker task must retain captured string");
});
// ============================================================================
// own(self) consumption in thread closures
// ============================================================================
test("Thread closure consumes Vec via own(self) push — no double-free", {
  if(arch == Arch.Wasm32, return(()));
  // base is consumed by push (own(self)), ch is only borrowed (.send())
  // This tests the codegen wrapper correctly NULLs only consumed captures
  base := Vec(i32).new().push(i32(1)).push(i32(2));
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    v1 := base.push(i32(3));
    ch.send(v1.len());
  });
  len := ch.recv().unwrap();
  assert(len == usize(3), "thread pushed to get length 3");
  t1.join();
});
test("Multiple threads each consume own Vec independently", {
  if(arch == Arch.Wasm32, return(()));
  ch := Channel(usize).new(usize(10));
  a := Vec(i32).new().push(i32(1));
  t1 := Thread.spawn((io) => {
    v := a.push(i32(2)).push(i32(3));
    ch.send(v.len());
  });
  b := Vec(i32).new().push(i32(10)).push(i32(20));
  t2 := Thread.spawn((io) => {
    v := b.push(i32(30)).push(i32(40)).push(i32(50));
    ch.send(v.len());
  });
  l1 := ch.recv().unwrap();
  l2 := ch.recv().unwrap();
  assert((l1 + l2) == usize(8), "combined lengths = 3 + 5 = 8");
  t1.join();
  t2.join();
});
test("Pool task consumes Vec via own(self) push", {
  if(arch == Arch.Wasm32, return(()));
  pool := ThreadPool.with_hardware_threads();
  base := Vec(i32).new().push(i32(42));
  ch := Channel(usize).new(usize(4));
  wg := WaitGroup.new();
  wg.add(i32(1));
  spawn(pool, (io) => {
    v := base.push(i32(99));
    ch.send(v.len());
    wg.done();
  });
  wg.wait();
  len := ch.recv().unwrap();
  assert(len == usize(2), "worker push produced length 2");
});
test("Thread closure borrows only — no own(self) consumption", {
  if(arch == Arch.Wasm32, return(()));
  // Only borrowing — no own(self) method called on any capture
  v := Vec(i32).new().push(i32(5)).push(i32(10));
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    ch.send(v.len());
    ch.send(v.len());
  });
  l1 := ch.recv().unwrap();
  l2 := ch.recv().unwrap();
  assert((l1 + l2) == usize(4), "two borrows return correct length");
  t1.join();
});
test("Thread consumes ImmString via own(self) concat", {
  if(arch == Arch.Wasm32, return(()));
  s := ImmString.from("hello");
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    s2 := s.concat(ImmString.from(" world"));
    ch.send(s2.len());
  });
  len := ch.recv().unwrap();
  assert(len == usize(11), "concat produced 'hello world' (11 bytes)");
  t1.join();
});
test("Thread with mixed consumed and borrowed captures", {
  if(arch == Arch.Wasm32, return(()));
  // v is consumed via push (own(self)), m is only borrowed via get
  v := Vec(i32).new().push(i32(1));
  m := Map(i32, i32).new().insert(i32(1), i32(100));
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    v2 := v.push(i32(2));
    val := m.get(i32(1)).unwrap();
    ch.send(v2.len() + usize(val));
  });
  result := ch.recv().unwrap();
  // v2.len() = 2, val = 100, so result = 102
  assert(result == usize(102), "mixed consumed+borrowed gives 102");
  t1.join();
});
test("Thread with chained own(self) calls on capture", {
  if(arch == Arch.Wasm32, return(()));
  base := Vec(i32).new();
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    // Chained push calls: base consumed by first push, result consumed by second
    v := base.push(i32(1)).push(i32(2)).push(i32(3));
    ch.send(v.len());
  });
  len := ch.recv().unwrap();
  assert(len == usize(3), "chained pushes produced length 3");
  t1.join();
});
test("Thread with no RC captures — only primitives", {
  if(arch == Arch.Wasm32, return(()));
  x := i32(42);
  y := i32(58);
  ch := Channel(i32).new(usize(4));
  t1 := Thread.spawn((io) => {
    ch.send(x + y);
  });
  result := ch.recv().unwrap();
  assert(result == i32(100), "primitive captures add to 100");
  t1.join();
});
test("Vec pop in thread — own(self) returning PopResult", {
  if(arch == Arch.Wasm32, return(()));
  v := Vec(i32).new().push(i32(10)).push(i32(20)).push(i32(30));
  ch := Channel(i32).new(usize(4));
  t1 := Thread.spawn((io) => {
    result := v.pop();
    ch.send(result.value.unwrap());
    ch.send(i32(result.vec.len()));
  });
  popped := ch.recv().unwrap();
  remaining := ch.recv().unwrap();
  assert(popped == i32(30), "popped last element 30");
  assert(remaining == i32(2), "remaining vec has 2 elements");
  t1.join();
});
test("Multiple workers each consume different Vecs", {
  if(arch == Arch.Wasm32, return(()));
  pool := ThreadPool.with_hardware_threads();
  ch := Channel(usize).new(usize(10));
  wg := WaitGroup.new();
  wg.add(i32(3));
  v1 := Vec(i32).new().push(i32(1));
  spawn(pool, (io) => {
    r := v1.push(i32(2));
    ch.send(r.len());
    wg.done();
  });
  v2 := Vec(i32).new().push(i32(1)).push(i32(2));
  spawn(pool, (io) => {
    r := v2.push(i32(3)).push(i32(4));
    ch.send(r.len());
    wg.done();
  });
  v3 := Vec(i32).new();
  spawn(pool, (io) => {
    r := v3.push(i32(1)).push(i32(2)).push(i32(3));
    ch.send(r.len());
    wg.done();
  });
  wg.wait();
  sum := usize(0);
  i := i32(0);
  while(runtime(i < i32(3)), {
    sum = (sum + ch.recv().unwrap());
    i = (i + i32(1));
  });
  // v1: 1→2, v2: 2→4, v3: 0→3 = 2+4+3 = 9
  assert(sum == usize(9), "workers produced total length 9");
});
// ============================================================================
// Mixed std/imm types in multi-threaded scenarios
// ============================================================================
/// ImmStrings shared across threads
test("Mixed ImmString across threads", {
  if(arch == Arch.Wasm32, return(()));
  s1 := ImmString.from("hello");
  s2 := ImmString.from("world");
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    assert(s1.len() == usize(5), "t1: s1 is 'hello'");
    ch.send(s1.len());
  });
  t2 := Thread.spawn((io) => {
    assert(s2.len() == usize(5), "t2: s2 is 'world'");
    ch.send(s2.len());
  });
  r1 := ch.recv().unwrap();
  r2 := ch.recv().unwrap();
  t1.join();
  t2.join();
  assert((r1 + r2) == usize(10), "combined results correct");
  println("Mixed ImmString across threads: OK");
});
/// Map with multiple types across threads
test("Mixed Map types across threads", {
  if(arch == Arch.Wasm32, return(()));
  m := Map(i32, i32).new();
  m = m.insert(i32(1), i32(10));
  m = m.insert(i32(2), i32(20));
  m = m.insert(i32(3), i32(30));
  ch := Channel(i32).new(usize(4));
  t1 := Thread.spawn((io) => {
    val := m.get(i32(1)).unwrap();
    ch.send(val);
  });
  t2 := Thread.spawn((io) => {
    val := m.get(i32(3)).unwrap();
    ch.send(val);
  });
  r1 := ch.recv().unwrap();
  r2 := ch.recv().unwrap();
  t1.join();
  t2.join();
  assert((r1 + r2) == i32(40), "sum of key1 + key3 = 40");
  println("Mixed Map types across threads: OK");
});
/// List and Vec in parallel threads
test("Mixed List and Vec across threads", {
  if(arch == Arch.Wasm32, return(()));
  v := Vec(i32).new();
  v = v.push(i32(10));
  v = v.push(i32(20));
  v = v.push(i32(30));
  l := List(i32).new();
  l = l.prepend(i32(30));
  l = l.prepend(i32(20));
  l = l.prepend(i32(10));
  ch := Channel(i32).new(usize(4));
  // Thread 1 reads from Vec
  t1 := Thread.spawn((io) => {
    sum := i32(0);
    i := usize(0);
    while(runtime(i < v.len()), {
      sum = (sum + v(i));
      i = (i + usize(1));
    });
    ch.send(sum);
  });
  // Thread 2 reads from List
  t2 := Thread.spawn((io) => {
    sum := i32(0);
    cur := l;
    while(runtime(cur.len() > usize(0)), {
      sum = (sum + cur.head().unwrap());
      cur = cur.tail();
    });
    ch.send(sum);
  });
  r1 := ch.recv().unwrap();
  r2 := ch.recv().unwrap();
  t1.join();
  t2.join();
  assert((r1 + r2) == i32(120), "Vec sum + List sum = 120");
  println("Mixed List and Vec across threads: OK");
});
/// Set and SortedSet across threads
test("Mixed Set and SortedSet across threads", {
  if(arch == Arch.Wasm32, return(()));
  s := Set(i32).new();
  s = s.insert(i32(1));
  s = s.insert(i32(2));
  s = s.insert(i32(3));
  ss := SortedSet(i32).new();
  ss = ss.insert(i32(4));
  ss = ss.insert(i32(5));
  ss = ss.insert(i32(6));
  ch := Channel(usize).new(usize(4));
  t1 := Thread.spawn((io) => {
    ch.send(s.len());
  });
  t2 := Thread.spawn((io) => {
    ch.send(ss.len());
  });
  r1 := ch.recv().unwrap();
  r2 := ch.recv().unwrap();
  t1.join();
  t2.join();
  assert((r1 + r2) == usize(6), "Set(3) + SortedSet(3) = 6");
  println("Mixed Set and SortedSet across threads: OK");
});
/// Map and SortedMap across threads
test("Mixed Map and SortedMap across threads", {
  if(arch == Arch.Wasm32, return(()));
  m := Map(i32, i32).new();
  m = m.insert(i32(1), i32(100));
  m = m.insert(i32(2), i32(200));
  sm := SortedMap(i32, i32).new();
  sm = sm.insert(i32(3), i32(300));
  sm = sm.insert(i32(4), i32(400));
  ch := Channel(i32).new(usize(4));
  t1 := Thread.spawn((io) => {
    val := m.get(i32(2)).unwrap();
    ch.send(val);
  });
  t2 := Thread.spawn((io) => {
    val := sm.get(i32(4)).unwrap();
    ch.send(val);
  });
  r1 := ch.recv().unwrap();
  r2 := ch.recv().unwrap();
  t1.join();
  t2.join();
  assert((r1 + r2) == i32(600), "Map(200) + SortedMap(400) = 600");
  println("Mixed Map and SortedMap across threads: OK");
});
/// All imm types combined in one multi-threaded scenario
test("All imm types combined across threads", {
  if(arch == Arch.Wasm32, return(()));
  v := Vec(i32).new().push(i32(1)).push(i32(2)).push(i32(3));
  l := List(i32).new().prepend(i32(4));
  s := Set(i32).new().insert(i32(5));
  m := Map(i32, i32).new().insert(i32(6), i32(60));
  ss := SortedSet(i32).new().insert(i32(7));
  sm := SortedMap(i32, i32).new().insert(i32(8), i32(80));
  ch := Channel(usize).new(usize(8));
  // Thread 1: Vec + List
  t1 := Thread.spawn((io) => {
    ch.send(v.len() + l.len());
  });
  // Thread 2: Set + SortedSet
  t2 := Thread.spawn((io) => {
    ch.send(s.len() + ss.len());
  });
  // Thread 3: Map + SortedMap
  t3 := Thread.spawn((io) => {
    ch.send(m.len() + sm.len());
  });
  total := usize(0);
  i := i32(0);
  while(runtime(i < i32(3)), {
    total = (total + ch.recv().unwrap());
    i = (i + i32(1));
  });
  t1.join();
  t2.join();
  t3.join();
  // Vec(3) + List(1) + Set(1) + SortedSet(1) + Map(1) + SortedMap(1) = 8
  assert(total == usize(8), "all imm types total = 8");
  println("All imm types combined across threads: OK");
});
