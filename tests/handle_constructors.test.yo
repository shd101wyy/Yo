//! `Rc(T).new`, `Box(T).new` and `Arc(T).new`, the handle constructors
//! (plans/backlog/STATIC_ARGUMENT_INFERENCE.md §5, A2), and the cell `dyn(...)`
//! synthesizes through them (A3). The prelude's `rc`/`box`/`arc` forward to
//! these until Generation B; tests/rc.test.yo and tests/arc.test.yo pin those
//! spellings.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ToString } :: import("std/fmt");
{ GlobalAllocator } :: import("std/allocator");
// A counting allocator: forwards to the global allocator and counts the
// blocks it holds (`live`).
_Counts :: struct(live : usize);
_count_alloc :: (fn(ctx : ?*void, size : usize, align : usize) -> ?*void)({
  c := (*_Counts)(ctx.unwrap());
  unsafe(c.*.live = (c.*.live + usize(1)));
  GlobalAllocator.malloc(size)
});
_count_realloc :: (fn(ctx : ?*void, ptr : ?*void, old_size : usize, new_size : usize, align : usize) -> ?*void)({
  c := (*_Counts)(ctx.unwrap());
  cond(
    ptr.is_none() => {
      unsafe(c.*.live = (c.*.live + usize(1)));
    },
    true => ()
  );
  GlobalAllocator.realloc(ptr, new_size)
});
_count_free :: (fn(ctx : ?*void, ptr : ?*void, size : usize, align : usize) -> unit)({
  cond(
    ptr.is_some() => {
      c := (*_Counts)(ctx.unwrap());
      unsafe(c.*.live = (c.*.live - usize(1)));
    },
    true => ()
  );
  GlobalAllocator.free(ptr);
});
_COUNT_VTABLE := AllocatorVTable(alloc : _count_alloc, realloc : _count_realloc, free : _count_free);
// An `Allocator` over `c`, which must outlive every block it hands out.
_counting :: (fn(c : *_Counts) -> Allocator)(Allocator(ctx : .Some((*void)(c)), vtable : addr_of(_COUNT_VTABLE)));
test("Rc(T).new builds a cell with one owner", {
  a := Rc(i32).new(i32(42));
  assert(a.* == i32(42), "the payload");
  assert(ref_count(a) == usize(1), "a fresh cell has one owner");
  comptime_assert(Type.eq(type_of(a), Rc(i32)), "the result is an Rc(i32)");
});
test("Rc(T).new with alloc places the cell in the allocator and restores the scope", {
  counts := _Counts(live : usize(0));
  heap := _counting(addr_of(counts));
  {
    a := Rc(i32).new(i32(5), alloc : .Some(heap));
    assert(counts.live == usize(1), `the cell is in the allocator: ${counts.live}`);
    // The construction's scope ends with it: a cell built after it is on the
    // global allocator again.
    g := Rc(i32)(i32(6));
    d := Rc(i32).new(i32(7));
    assert(counts.live == usize(1), "the cells after it are on the global allocator");
    assert(((a.* + g.*) + d.*) == i32(18), "the payloads");
  };
  assert(counts.live == usize(0), "the last drop released the cell into the allocator");
});
test("Box(T).new with alloc places the cell, and a clone stays where its source lives", {
  counts := _Counts(live : usize(0));
  heap := _counting(addr_of(counts));
  {
    a := Box(i32).new(i32(7), alloc : .Some(heap));
    assert(counts.live == usize(1), "the cell is in the allocator");
    match(Box.allocator(a), .Some(o) => assert(o.same(heap), "Box.allocator reads it back"), .None => assert(false, "placed"));
    c := Box.clone(a);
    assert(counts.live == usize(2), "the clone is in the allocator too");
    g := Box(i32).new(i32(1));
    assert(Box.allocator(g).is_none(), "a default box is on the global allocator");
    assert(((a.* + c.*) + g.*) == i32(15), "the payloads");
  };
  assert(counts.live == usize(0), "every placed box went back to the allocator");
});
test("Arc(T).new with alloc places the cell in the allocator and restores the scope", {
  counts := _Counts(live : usize(0));
  heap := _counting(addr_of(counts));
  {
    a := Arc(i32).new(i32(5), alloc : .Some(heap));
    assert(counts.live == usize(1), "the cell is in the allocator");
    assert(ref_count(a) == usize(1), "one handle");
    g := Arc(i32).new(i32(6));
    assert(counts.live == usize(1), "a default Arc is on the global allocator");
    assert((a.* + g.*) == i32(11), "the payloads");
  };
  assert(counts.live == usize(0), "the last drop released the cell into the allocator");
});
test("rc, box and arc forward to the constructors", {
  comptime_assert(Type.eq(type_of(rc(i32(1))), Rc(i32)), "rc builds an Rc");
  comptime_assert(Type.eq(type_of(box(i32(1))), Box(i32)), "box builds a Box");
  comptime_assert(Type.eq(type_of(arc(i32(1))), Arc(i32)), "arc builds an Arc");
  counts := _Counts(live : usize(0));
  heap := _counting(addr_of(counts));
  {
    a := rc(i32(1), alloc : .Some(heap));
    b := box(i32(2), alloc : .Some(heap));
    c := arc(i32(3), alloc : .Some(heap));
    assert(counts.live == usize(3), "the alloc argument reaches the constructor");
    assert(((a.* + b.*) + c.*) == i32(6), "the payloads");
  };
  assert(counts.live == usize(0), "every cell went back");
});
// `dyn(...)` around a payload that is not an object builds its cell through
// the type's `new`: `Rc(T).new(v)`, or `Arc(T).new(v)` for a Send Dyn.
test("dyn(i32(1)) boxes through Rc(i32).new", {
  (d : Dyn(ToString)) = dyn(i32(1));
  assert(d.to_string() == `1`, "the boxed payload");
  (s : Dyn(ToString, Send)) = dyn(i32(2));
  assert(s.to_string() == `2`, "the Send payload, boxed through Arc(i32).new");
});
_Detector :: struct(detect : Dyn(Fn(x : i32) -> i32));
test("dyn(Rc.new(<closure>)) contextually types the closure, as dyn(rc(<closure>)) does", {
  base := i32(10);
  a := _Detector(detect : dyn(Rc.new(x => (x + base))));
  b := _Detector(detect : dyn(rc(x => (x * base))));
  assert(a.detect(i32(1)) == i32(11), "Rc.new: the closure's x is an i32");
  assert(b.detect(i32(2)) == i32(20), "rc: unchanged");
});
// A payload over a type variable (`f : Impl(Fn(...))`) is boxed by the
// prelude's `rc`, bound to the callee (`_synthesized_cell_call`,
// src/evaluator/values/dyn.yo).
_box_fn :: (fn(f : Impl(Fn(x : i32) -> i32)) -> Dyn(Fn(x : i32) -> i32))(dyn(f));
_box_fn_under_rc :: (fn(rc : Impl(Fn(x : i32) -> i32)) -> Dyn(Fn(x : i32) -> i32))(dyn(rc));
test("dyn(f) of an Impl(Fn) parameter boxes, also under a parameter named rc", {
  n := i32(5);
  d := _box_fn(x => (x + n));
  assert(d(i32(1)) == i32(6), "the boxed parameter");
  e := _box_fn_under_rc(x => (x * n));
  assert(e(i32(2)) == i32(10), "a parameter named rc does not capture the cell constructor");
});
// `Rc(type_of(f)).new(f)` and `Box(type_of(f)).new(f)` written in the body of
// a function with an `Impl(Fn(...))` parameter: the shape Generation B3's
// `dyn(f)` synthesizes once `rc` is deleted
// (issues/fixed/2026-10-27-a-static-method-on-an-instantiation-over-an-open-type-parameter-does-not-dispatch.md).
_cell_of_fn :: (fn(f : Impl(Fn(x : i32) -> i32)) -> i32)({
  r := Rc(type_of(f)).new(f);
  b := Box(type_of(r)).new(r);
  (b.*.*)(i32(3))
});
// The unapplied spellings infer `T := type_of(f)` (static-argument inference).
_cell_of_fn_inferred :: (fn(f : Impl(Fn(x : i32) -> i32)) -> i32)({
  r := Rc.new(f);
  b := Box.new(r);
  (b.*.*)(i32(3))
});
_arc_of_fn_inferred :: (fn(f : Impl(Fn(x : i32) -> i32, Send, Sync)) -> i32)({
  a := Arc.new(f);
  (a.*)(i32(3))
});
test("Rc(type_of(f)).new(f) of an Impl(Fn) parameter dispatches, per closure", {
  n := i32(5);
  assert(_cell_of_fn(x => (x + n)) == i32(8), "the cell's closure");
  assert(_cell_of_fn(x => (x * n)) == i32(15), "a second closure type");
  assert(_cell_of_fn_inferred(x => (x + n)) == i32(8), "Rc.new(f), Box.new(r)");
  assert(_cell_of_fn_inferred(x => (x * n)) == i32(15), "a second closure type");
  assert(_arc_of_fn_inferred(x => (x + i32(40))) == i32(43), "Arc.new(f) of a Send + Sync closure");
});
// Static-argument inference (A1): the unapplied spellings infer the payload
// type from the value.
test("Rc.new, Box.new and Arc.new infer the payload type, alloc included", {
  counts := _Counts(live : usize(0));
  heap := _counting(addr_of(counts));
  {
    a := Rc.new(i32(1), alloc : .Some(heap));
    b := Box.new(i32(2), alloc : .Some(heap));
    c := Arc.new(i32(3), alloc : .Some(heap));
    comptime_assert(Type.eq(type_of(a), Rc(i32)), "Rc.new(i32(1)) is Rc(i32)");
    comptime_assert(Type.eq(type_of(b), Box(i32)), "Box.new(i32(2)) is Box(i32)");
    comptime_assert(Type.eq(type_of(c), Arc(i32)), "Arc.new(i32(3)) is Arc(i32)");
    assert(counts.live == usize(3), "every cell is in the allocator");
    assert(((a.* + b.*) + c.*) == i32(6), "the payloads");
  };
  assert(counts.live == usize(0), "every cell went back");
});
test("Rc.new(some_rc) is an Rc(Rc(i32))", {
  inner := Rc.new(i32(4));
  outer := Rc.new(inner);
  comptime_assert(Type.eq(type_of(outer), Rc(Rc(i32))), "a handle is a payload, as Rust's Rc::new(rc)");
  assert(outer.*.* == i32(4), "the inner payload");
});
