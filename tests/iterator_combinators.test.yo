{ assert } :: import("std/assert");
// Comprehensive verification of iterator combinators (blanket Iterator impls
// in std/prelude.yo). Bootstrap §2.1 / §1.2.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
open(import("std/collections/array_list"));
// --- Helper: my_range iterator [start, end) -----------------------------------
MyRange :: struct(_cur : i32, _end : i32);
impl(
  MyRange,
  Iterator(
    Item : i32,
    next : (fn(inout(self) : Self) -> Option(i32))(
      cond(
        (self._cur >= self._end) => .None,
        true => {
          v := self._cur;
          self._cur = (self._cur + i32(1));
          .Some(v)
        }
      )
    )
  )
);
my_range :: (fn(start : i32, end_ : i32) -> MyRange)(MyRange(start, end_));
// --- map -------------------------------------------------------------------
test("iter.map doubles every element", {
  it := my_range(i32(1), i32(4)).map(x => (x * i32(2)));
  out := ArrayList(i32).new();
  while(runtime(true), {
    match(
      it.next(),
      .Some(v) => {
        out.push(v);
      },
      .None => {
        break;
      }
    );
  });
  assert(out.len() == usize(3), "3 elements");
  assert(out(usize(0)) == i32(2), "1*2");
  assert(out(usize(1)) == i32(4), "2*2");
  assert(out(usize(2)) == i32(6), "3*2");
});
// --- filter ----------------------------------------------------------------
test("iter.filter keeps only even values", {
  it := my_range(i32(0), i32(6)).filter(x => ((x % i32(2)) == i32(0)));
  out := ArrayList(i32).new();
  while(runtime(true), {
    match(
      it.next(),
      .Some(v) => {
        out.push(v);
      },
      .None => {
        break;
      }
    );
  });
  assert(out.len() == usize(3), "3 evens");
  assert(out(usize(0)) == i32(0), "0");
  assert(out(usize(1)) == i32(2), "2");
  assert(out(usize(2)) == i32(4), "4");
});
// --- take / skip -----------------------------------------------------------
test("iter.take limits the iterator", {
  it := my_range(i32(0), i32(100)).take(usize(3));
  out := ArrayList(i32).new();
  while(runtime(true), {
    match(
      it.next(),
      .Some(v) => {
        out.push(v);
      },
      .None => {
        break;
      }
    );
  });
  assert(out.len() == usize(3), "took 3");
  assert(out(usize(2)) == i32(2), "third = 2");
});
test("iter.skip drops leading elements", {
  it := my_range(i32(0), i32(5)).skip(usize(3));
  out := ArrayList(i32).new();
  while(runtime(true), {
    match(
      it.next(),
      .Some(v) => {
        out.push(v);
      },
      .None => {
        break;
      }
    );
  });
  assert(out.len() == usize(2), "2 left");
  assert(out(usize(0)) == i32(3), "first = 3");
  assert(out(usize(1)) == i32(4), "second = 4");
});
// --- enumerate -------------------------------------------------------------
test("iter.enumerate pairs index with value", {
  it := my_range(i32(10), i32(13)).enumerate();
  // (0, 10), (1, 11), (2, 12)
  match(
    it.next(),
    .Some(p) => {
      assert(p._0 == usize(0), "index 0");
      assert(p._1 == i32(10), "value 10");
    },
    .None => assert(false, "expected first")
  );
  match(
    it.next(),
    .Some(p) => {
      assert(p._0 == usize(1), "index 1");
      assert(p._1 == i32(11), "value 11");
    },
    .None => assert(false, "expected second")
  );
});
// --- zip -------------------------------------------------------------------
test("iter.zip pairs two iterators", {
  it := my_range(i32(0), i32(3)).zip(my_range(i32(100), i32(103)));
  match(
    it.next(),
    .Some(p) => {
      assert(p._0 == i32(0), "first left is 0");
      assert(p._1 == i32(100), "first right is 100");
    },
    .None => assert(false, "expected first pair")
  );
  match(
    it.next(),
    .Some(p) => {
      assert(p._0 == i32(1), "second left is 1");
      assert(p._1 == i32(101), "second right is 101");
    },
    .None => assert(false, "expected second pair")
  );
});
test("iter.zip stops at shorter iterator", {
  it := my_range(i32(0), i32(5)).zip(my_range(i32(10), i32(12)));
  count := i32(0);
  while(runtime(true), {
    match(
      it.next(),
      .Some(_) => {
        count = (count + i32(1));
      },
      .None => {
        break;
      }
    );
  });
  assert(count == i32(2), "should have 2 pairs (limited by shorter)");
});
// --- fold ------------------------------------------------------------------
test("iter.fold sums values", {
  add :: (fn(acc : i32, x : i32) -> i32)(acc + x);
  total := my_range(i32(1), i32(6)).fold(i32(0), add);
  assert(total == i32(15), "1+2+3+4+5=15");
});
test("iter.fold with single accumulation", {
  mul :: (fn(acc : i32, x : i32) -> i32)(acc * x);
  prod := my_range(i32(1), i32(5)).fold(i32(1), mul);
  assert(prod == i32(24), "1*2*3*4=24");
});
test("iter.fold with multi-arg => lambda", {
  total := my_range(i32(1), i32(6)).fold(i32(0), (acc, x) => (acc + x));
  assert(total == i32(15), "1+2+3+4+5=15 via => lambda");
});
test("iter.fold over ArrayList iter with multi-arg => lambda", {
  list := array_list(i32(10), i32(20), i32(30), i32(40));
  total := list.into_iter().fold(i32(0), (acc, x) => (acc + x));
  assert(total == i32(100), "10+20+30+40=100 via fold over value iter");
});
// --- for_each --------------------------------------------------------------
test("iter.for_each with closure that captures ArrayList", {
  out := array_list(i32(0));
  out.clear();
  src := array_list(i32(1), i32(2), i32(3), i32(4));
  src.into_iter().for_each((x) => {
    out.push(x);
  });
  assert(out.len() == usize(4), "out has 4 elements");
  assert(out(usize(0)) == i32(1), "first element is 1");
  assert(out(usize(3)) == i32(4), "last element is 4");
});
test("iter.for_each accumulates side effects", {
  total := array_list(i32(0));
  total.clear();
  total.push(i32(0));
  my_range(i32(1), i32(5)).for_each((x) => {
    cur := total(usize(0));
    total(usize(0)) = (cur + x);
  });
  assert(total(usize(0)) == i32(10), "1+2+3+4=10");
});
// --- count -----------------------------------------------------------------
test("iter.count returns total elements", {
  n := my_range(i32(0), i32(42)).count();
  assert(n == usize(42), "count 42");
});
// --- any / all -------------------------------------------------------------
test("iter.any returns true on first match", {
  found := my_range(i32(0), i32(10)).any(x => (x == i32(7)));
  assert(found, "found 7");
  none := my_range(i32(0), i32(5)).any(x => (x > i32(100)));
  assert(!(none), "no value > 100");
});
test("iter.all returns true only if every element matches", {
  ok := my_range(i32(0), i32(5)).all(x => (x < i32(10)));
  assert(ok, "all < 10");
  bad := my_range(i32(0), i32(5)).all(x => (x < i32(3)));
  assert(!(bad), "not all < 3");
});
// --- chained combinators (excluding fold) ---------------------------------
test("iter.skip then take then count", {
  n := my_range(i32(0), i32(100)).skip(usize(20)).take(usize(15)).count();
  assert(n == usize(15), "15");
});
test("iter.filter then map then count", {
  square :: (fn(x : i32) -> i32)(x * x);
  is_even :: (fn(x : i32) -> bool)((x % i32(2)) == i32(0));
  n := my_range(i32(0), i32(10)).filter(is_even).map(square).count();
  assert(n == usize(5), "5 evens");
});
// --- combinators on ArrayList iter ----------------------------------------
test("ArrayList.into_iter combinators", {
  make_list :: (fn() -> ArrayList(i32))({
    list := ArrayList(i32).new();
    list.push(i32(1));
    list.push(i32(2));
    list.push(i32(3));
    list.push(i32(4));
    list.push(i32(5));
    list
  });
  even_sum := make_list().into_iter().filter(p => ((p % i32(2)) == i32(0))).fold(i32(0), (acc, x) => (acc + x));
  assert(even_sum == i32(6), "2+4=6");
  even_count := make_list().into_iter().filter(p => ((p % i32(2)) == i32(0))).count();
  assert(even_count == usize(2), "2 evens");
  double :: (fn(x : i32) -> i32)(x * i32(2));
  doubled_count := make_list().into_iter().map(double).count();
  assert(doubled_count == usize(5), "5 mapped");
});
// --- chunk 3: consuming methods (plans/STD_API_AUDIT.md D3.4) ---------------
test("iter.find and iter.position short-circuit on the first match", {
  assert(my_range(i32(0), i32(10)).find(x => (x > i32(3))).unwrap() == i32(4), "find first > 3");
  assert(my_range(i32(0), i32(10)).find(x => (x > i32(99))).is_none(), "find none");
  assert(my_range(i32(5), i32(10)).position(x => (x == i32(7))).unwrap() == usize(2), "position of 7");
  assert(my_range(i32(5), i32(10)).position(x => false).is_none(), "position none");
});
test("iter.last and iter.nth", {
  assert(my_range(i32(1), i32(6)).last().unwrap() == i32(5), "last of [1,6)");
  assert(my_range(i32(1), i32(1)).last().is_none(), "last of empty");
  assert(my_range(i32(10), i32(20)).nth(usize(0)).unwrap() == i32(10), "nth 0");
  assert(my_range(i32(10), i32(20)).nth(usize(3)).unwrap() == i32(13), "nth 3");
  assert(my_range(i32(10), i32(12)).nth(usize(5)).is_none(), "nth past end");
});
test("iter.sum, iter.min, iter.max", {
  assert(my_range(i32(1), i32(5)).sum() == i32(10), "1+2+3+4");
  assert(my_range(i32(3), i32(3)).sum() == i32(0), "empty sum is Default");
  assert(my_range(i32(4), i32(9)).min().unwrap() == i32(4), "min");
  assert(my_range(i32(4), i32(9)).max().unwrap() == i32(8), "max");
  assert(my_range(i32(0), i32(0)).min().is_none(), "empty min");
  assert(my_range(i32(0), i32(0)).max().is_none(), "empty max");
});
// --- chunk 3: new combinators ------------------------------------------------
test("iter.chain yields first then second", {
  it := my_range(i32(1), i32(3)).chain(my_range(i32(10), i32(12)));
  out := ArrayList(i32).new();
  it.for_each((x) => {
    out.push(x);
  });
  assert(out.len() == usize(4), "4 chained");
  assert((out(usize(0)) == i32(1)) && (out(usize(1)) == i32(2)), "first half");
  assert((out(usize(2)) == i32(10)) && (out(usize(3)) == i32(11)), "second half");
});
test("iter.take_while and iter.skip_while split at the boundary", {
  taken := my_range(i32(0), i32(10)).take_while(x => (x < i32(3))).count();
  assert(taken == usize(3), "take_while 0,1,2");
  after_false := my_range(i32(0), i32(10)).take_while(x => (x < i32(0))).count();
  assert(after_false == usize(0), "take_while immediately false");
  skipped := my_range(i32(0), i32(10)).skip_while(x => (x < i32(7))).sum();
  assert(skipped == i32(24), "7+8+9 after skip_while");
  none_skipped := my_range(i32(5), i32(8)).skip_while(x => false).count();
  assert(none_skipped == usize(3), "skip_while never true keeps all");
});
test("iter.filter_map maps and filters in one pass", {
  halved := my_range(i32(0), i32(7)).filter_map(
    (x) => cond(
      ((x % i32(2)) == i32(0)) => Option(i32).Some(x / i32(2)),
      true => Option(i32).None
    )
  );
  out := ArrayList(i32).new();
  halved.for_each((x) => {
    out.push(x);
  });
  assert(out.len() == usize(4), "0,2,4,6 kept");
  assert((out(usize(2)) == i32(2)) && (out(usize(3)) == i32(3)), "halved values");
});
test("iter.peekable peeks without consuming", {
  it := my_range(i32(1), i32(4)).peekable();
  assert(it.peek().unwrap() == i32(1), "peek sees 1");
  assert(it.peek().unwrap() == i32(1), "peek again still 1");
  assert(it.next().unwrap() == i32(1), "next consumes the peeked 1");
  assert(it.next().unwrap() == i32(2), "next continues");
  assert(it.peek().unwrap() == i32(3), "peek after next");
  assert(it.next().unwrap() == i32(3), "consume 3");
  assert(it.peek().is_none(), "peek at end");
  assert(it.next().is_none(), "next at end");
});
test("filter predicate now takes the element by value (D3.4 symmetry)", {
  odd_sum := my_range(i32(0), i32(7)).filter(x => ((x % i32(2)) == i32(1))).sum();
  assert(odd_sum == i32(9), "1+3+5");
});
test("map then for_each — self-marker must not clobber the concrete F binding", {
  // Pre-existing bug surfaced by chunk 3: matching IterMap's Iterator impl
  // inside for_each's where-check wrote the impl's F self-marker over
  // for_each's already-resolved concrete closure binding
  // (issues/varbound-combinator-receiver-impl-match.md).
  out := ArrayList(i32).new();
  my_range(i32(1), i32(4)).map((x) => (x * i32(2))).for_each((x) => {
    out.push(x);
  });
  assert(out.len() == usize(3), "3 mapped elements");
  assert((out(usize(0)) == i32(2)) && (out(usize(2)) == i32(6)), "doubled values");
});
