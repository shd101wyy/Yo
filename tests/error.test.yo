{ assert } :: import("std/assert");
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
test("Test String as Error via AnyError", {
  (err : AnyError) = dyn(`something went wrong`);
  // Downcast back to String and check the message
  match(
    downcast(err, String),
    .Some(s) => assert(s == `something went wrong`, "Expected error message to match"),
    .None => assert(false, "Expected Some(String), got None")
  );
});
test("Test downcast AnyError back to String", {
  (err : AnyError) = dyn(`file not found`);
  match(
    downcast(err, String),
    .Some(s) => assert(s == `file not found`, "Expected 'file not found'"),
    .None => assert(false, "Expected Some(String), got None")
  );
});
test("Test Error source returns None by default", {
  (err : AnyError) = dyn(`default source`);
  match(
    err.source(),
    .Some(s) => assert(false, "Expected None source"),
    .None => assert(true)
  );
});
test("Test Exception throwing and catching with String", {
  safe_divide :: (fn(x : i32, y : i32, exn : Exception) -> i32)(
    cond(
      (y == i32(0)) => exn.throw(dyn(`division by zero`)),
      true => (x / y)
    )
  );
  exn := Exception(
    throw : (
      err -> {
        println(`Error: ${err}`);
        match(
          downcast(err, String),
          .Some(msg) => assert(msg == `division by zero`, "Expected error message to be 'division by zero'"),
          .None => assert(false, "Expected error to be a String")
        );
        unwind(());
      }
    )
  );
  result := safe_divide(6, 3, exn);
  assert(result == 2, "Expected 6 divided by 3 to equal 2");
  safe_divide(10, 0, exn);
  assert(false, "Expected division by zero to throw an exception"); // Shouldn't enter this line
});
test("Test Exception with custom MathError enum", {
  MathError :: enum(
    DivisionByZero,
    NegativeSqrt
  );
  impl(
    MathError,
    ToString(
      to_string : (
        self -> match(
          self,
          .DivisionByZero => `Division by zero`,
          .NegativeSqrt => `Square root of a negative number`
        )
      )
    )
  );
  impl(MathError, Error());
  safe_divide :: (fn(x : i32, y : i32, exn : Exception) -> i32)(
    cond(
      (y == i32(0)) => exn.throw(dyn(MathError.DivisionByZero)),
      true => (x / y)
    )
  );
  exn := Exception(
    throw : (
      err -> {
        println(`Error: ${err}`);
        match(
          downcast(err, MathError),
          .Some(math_err) =>
            match(
              math_err,
              .DivisionByZero => assert(true, "Caught expected DivisionByZero error"),
              _ => assert(false, "Expected error to be DivisionByZero")
            ),
          .None => assert(false, "Expected error to be a MathError")
        );
        unwind(());
      }
    )
  );
  result := safe_divide(6, 3, exn);
  assert(result == 2, "Expected 6 divided by 3 to equal 2");
  safe_divide(10, 0, exn);
  assert(false, "Expected division by zero to throw an exception");
});
test("Test ResumableException throwing and catching with String", {
  safe_divide :: (fn(x : i32, y : i32, exn : ResumableException(i32)) -> i32)(
    cond(
      (y == i32(0)) => exn.throw(dyn(`division by zero`)),
      true => (x / y)
    )
  );
  exn := ResumableException(i32)(
    throw : (
      err -> {
        println(`Error: ${err}`);
        match(
          downcast(err, String),
          .Some(msg) => assert(msg == `division by zero`, "Expected error message to be 'division by zero'"),
          .None => assert(false, "Expected error to be a String")
        );
        return(666); // Return a default value for the resumable exception
      }
    )
  );
  result := safe_divide(6, 3, exn);
  assert(result == 2, "Expected 6 divided by 3 to equal 2");
  result = safe_divide(10, 0, exn);
  assert(result == 666, "Expected division by zero to resume with value 666");
});
test("Test ResumableException with custom MathError enum", {
  MathError :: enum(
    DivisionByZero,
    NegativeSqrt
  );
  impl(
    MathError,
    ToString(
      to_string : (
        self -> match(
          self,
          .DivisionByZero => `Division by zero`,
          .NegativeSqrt => `Square root of a negative number`
        )
      )
    )
  );
  impl(MathError, Error());
  safe_divide :: (fn(x : i32, y : i32, exn : ResumableException(i32)) -> i32)(
    cond(
      (y == i32(0)) => exn.throw(dyn(MathError.DivisionByZero)),
      true => (x / y)
    )
  );
  exn := ResumableException(i32)(
    throw : (
      err -> {
        println(`Error: ${err}`);
        match(
          downcast(err, MathError),
          .Some(math_err) =>
            match(
              math_err,
              .DivisionByZero => assert(true, "Caught expected DivisionByZero error"),
              _ => assert(false, "Expected error to be DivisionByZero")
            ),
          .None => assert(false, "Expected error to be a MathError")
        );
        return(888);
      }
    )
  );
  result := safe_divide(6, 3, exn);
  assert(result == 2, "Expected 6 divided by 3 to equal 2");
  result = safe_divide(10, 0, exn);
  assert(result == 888, "Expected division by zero to resume with value 888");
});
// Regression for issues/fixed/codegen-exn-throw-ref-self-while-hang.md:
// when an `exn : Exception` parameter is locally bound at the caller, the
// call site is the unwind install point — it must clear __yo_effect_escaped
// and read __yo_unwind_value, not just propagate the flag to its own caller.
// Symptom of the bug was that an outer `assert(...)` after the install fn
// returned was silently skipped because the stale flag short-circuited it.
test("Exception install-point clears __yo_effect_escaped after unwind", {
  do_throw :: (fn(exn : Exception) -> bool)({
    exn.throw(dyn(`boom`));
    true
  });
  call_with_local :: (fn() -> bool)({
    local_exn := Exception(throw : (_e -> unwind(false)));
    _r := do_throw(local_exn);
    true
  });
  reached_after := Box(i32)(0);
  r1 := call_with_local();
  // call_with_local must return false (the unwind value), not its default.
  assert(r1 == false, "install point should yield the unwind value");
  // Code after the install fn must actually execute — i.e. the flag was
  // cleared at the install point and did NOT propagate further.
  reached_after.* = i32(1);
  r2 := call_with_local();
  assert(r2 == false, "second call must also unwind cleanly");
  assert(reached_after.* == i32(1), "post-install code must run");
});

// Regression (issues/retired/codegen-dead-code-after-exn-throw.md): a
// comptime-only call in the dead tail of a match arm after `exn.throw` used
// to reach codegen un-folded ("Unhandled function call: ..."). The tail must
// stay LIVE for typing (a handler may resume), so the evaluator has to fold
// the nested `i32(mk(...))` cast, and the emitted code must still unwind.
test("comptime call after exn.throw in a match arm compiles and unwinds", {
  mk :: (fn(comptime(x) : i32) -> i32)(x * i32(2));
  f :: (fn(v : i32, exn : Exception) -> i32)(
    match(
      v > i32(0),
      true => v,
      false => {
        exn.throw(dyn(`neg`));
        i32(mk(i32(3)))
      }
    )
  );
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  assert(f(i32(5), exn) == i32(5), "positive path returns the value");
  f(i32(0) - i32(1), exn);
  assert(false, "unreachable: the negative path must unwind"); // Shouldn't enter this line
});
// Regression (issues/fixed/dyn-box-dispose-is-emitted-with-an-empty-body.md):
// `exn.throw(dyn(err))` boxes a value-typed error through the prelude's generic
// `box`, whose `own(value)` parameter never released the reference the caller
// transferred in — so every thrown `AnyError` payload leaked. A LOOP makes the
// per-throw leak unbounded, which is what made this the highest-traffic leak in
// the language. The `Dispose` counter observes each payload's release.
(g_thrown_payload_disposed : i32) = i32(0);
ThrownRes :: ref(struct(tag : i32));
impl(
  ThrownRes,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      g_thrown_payload_disposed = (g_thrown_payload_disposed + i32(1));
    })
  )
);
ThrownErr :: struct(detail : String, r : ThrownRes);
impl(ThrownErr, ToString(to_string : (fn(inout(self) : Self) -> String)(self.detail.clone())));
impl(ThrownErr, Error());
_throw_payload :: (fn(exn : Exception) -> i32)(
  exn.throw(dyn(ThrownErr(detail : `boom`, r : ThrownRes(tag : i32(1)))))
);
// The handler must `unwind`, which exits THIS function — so the loop below can
// call it repeatedly.
_catch_payload :: (fn() -> i32)({
  exn := Exception(
    throw : (
      err -> unwind(i32(0) - i32(1))
    )
  );
  _throw_payload(exn)
});
test("every AnyError payload thrown in a loop is released", {
  before := g_thrown_payload_disposed;
  (i : i32) = i32(0);
  while(i < i32(20), {
    r := _catch_payload();
    assert(r == (i32(0) - i32(1)), "the handler unwound with its sentinel");
    i = (i + i32(1));
  });
  assert(
    (g_thrown_payload_disposed - before) == i32(20),
    "each of the 20 thrown payloads is released exactly once"
  );
});
// Regression for issues/fixed/resumable-exception-bare-return-handler-body-aborts.md:
// a handler body written as a BARE `err -> return(v)` (no braces) must behave
// exactly like the braced `err -> { return(v); }` form. `return` is recognised
// only as a BEGIN statement (unlike `unwind`, it has no expression-dispatcher
// entry), and the anonymous-function definition-time body trial used to route
// a non-atom body around `evaluate_begin_expression` — so `return` evaluated as
// an ordinary identifier, the error was swallowed, the body got no ExprInfos,
// and codegen shipped an `abort()` stub that killed the process on the first
// throw with no diagnostic anywhere.
_bare_arrow_divide :: (fn(x : i32, y : i32, exn : ResumableException(i32)) -> i32)(
  cond(
    (y == i32(0)) => exn.throw(dyn(`division by zero`)),
    true => (x / y)
  )
);
test("a bare-arrow ResumableException handler resumes like the braced form", {
  bare := ResumableException(i32)(throw : (_err -> return(777)));
  braced := ResumableException(i32)(
    throw : (
      _err -> {
        return(777);
      }
    )
  );
  assert(_bare_arrow_divide(6, 3, bare) == 2, "the non-throwing path is unaffected");
  assert(_bare_arrow_divide(10, 0, bare) == 777, "the bare-arrow handler resumes with 777");
  assert(_bare_arrow_divide(10, 0, braced) == 777, "the braced handler resumes with 777");
  // Resuming MORE THAN ONCE through the same bare-arrow handler must work.
  (i : i32) = i32(0);
  (sum : i32) = i32(0);
  while(i < i32(5), {
    sum = (sum + _bare_arrow_divide(1, 0, bare));
    i = (i + i32(1));
  });
  assert(sum == i32(3885), "five resumes through the bare-arrow handler each yield 777");
});
// The same shape with a NON-CONSTANT resume value, so the handler body is a
// bare `return(<expression over the handler parameter>)` rather than a literal.
test("a bare-arrow handler may compute its resume value from the error", {
  exn := ResumableException(i32)(throw : (err -> return(i32(err.to_string().len()))));
  // `division by zero` is 16 bytes.
  assert(_bare_arrow_divide(10, 0, exn) == i32(16), "the resume value is computed from the error");
});
// Canary: a bare-arrow `unwind` handler (the shape the compiler tree itself
// uses for its def-eval walls) keeps working — `unwind` HAS a dispatcher entry,
// so it never took the broken path, and it must not regress.
_bare_unwind_divide :: (fn(x : i32, y : i32, exn : Exception) -> i32)(
  cond(
    (y == i32(0)) => exn.throw(dyn(`division by zero`)),
    true => (x / y)
  )
);
_bare_unwind_catch :: (fn() -> i32)({
  exn := Exception(throw : (_err -> unwind(i32(42))));
  _bare_unwind_divide(10, 0, exn)
});
test("a bare-arrow Exception handler still unwinds", {
  assert(_bare_unwind_catch() == i32(42), "the bare-arrow unwind handler yields its sentinel");
});
