// Fixture for "module-level globals are isolated per module"
// (issues/fixed/module-global-c-names-are-not-namespaced.md): declares the
// SAME global name as global_b.yo — the two must be distinct C variables.
{ HashMap } :: import("std/collections/hash_map");
{ String } :: import("std/string");
{ RefCell } :: import("std/sync/refcell");
// A value map written after its initializer lives in a `RefCell` (a mutable
// module-level binding cannot be lent `&mut`, decision 47).
(g_cache : RefCell(HashMap(String, i32))) = RefCell(HashMap(String, i32)).new(HashMap(String, i32).new());
a_put :: (fn() -> unit)({
  g_cache.with_mut(m => m.insert(`k`, i32(1)));
});
a_len :: (fn() -> usize)(g_cache.with(m => m.len()));
export(a_put, a_len);
