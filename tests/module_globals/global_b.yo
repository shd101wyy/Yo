// Fixture twin of global_a.yo — same global NAME, logically a different
// variable. See issues/fixed/module-global-c-names-are-not-namespaced.md.
{ HashMap } :: import("std/collections/hash_map");
open(import("std/string"));
(g_cache : HashMap(String, i32)) = HashMap(String, i32).new();
b_len :: (fn() -> usize)(g_cache.len());
export(b_len);
