{ assert } :: import("std/assert");
open(import("std/string"));
open(import("std/collections/array_list"));
test("String repeat basic", {
  s := `ab`.repeat(usize(3));
  assert(s == `ababab`, "ab.repeat(3) should be ababab");
});
test("String repeat zero returns empty", {
  s := `hello`.repeat(usize(0));
  assert(s.is_empty(), "repeat(0) should be empty");
});
test("String repeat one returns same", {
  s := `xyz`.repeat(usize(1));
  assert(s == `xyz`, "repeat(1) should equal self");
});
test("String repeat empty stays empty", {
  s := ``.repeat(usize(5));
  assert(s.is_empty(), "empty.repeat(5) should be empty");
});
test("String repeat utf8", {
  s := `αβ`.repeat(usize(2));
  assert(s == `αβαβ`, "utf8 repeat");
});
test("String join basic", {
  items := ArrayList(String).new();
  items.push(`a`);
  items.push(`b`);
  items.push(`c`);
  s := `, `.join(items);
  assert(s == `a, b, c`, "join with comma");
});
test("String join empty list returns empty", {
  items := ArrayList(String).new();
  s := `, `.join(items);
  assert(s.is_empty(), "join empty list");
});
test("String join single item no separator", {
  items := ArrayList(String).new();
  items.push(`only`);
  s := `, `.join(items);
  assert(s == `only`, "join single item");
});
test("String join with empty separator", {
  items := ArrayList(String).new();
  items.push(`a`);
  items.push(`b`);
  items.push(`c`);
  s := ``.join(items);
  assert(s == `abc`, "empty separator concatenates");
});
test("String lines iterates over lines", {
  input :=
    `line1
line2
line3`;
  iter := input.lines();
  count := usize(0);
  joined := ArrayList(String).new();
  while(runtime(true), {
    match(
      iter.next(),
      .Some(line) => {
        joined.push(line);
        count = (count + usize(1));
      },
      .None => break
    );
  });
  assert(count == usize(3), "should get 3 lines");
  assert(joined(usize(0)) == `line1`, "line1");
  assert(joined(usize(1)) == `line2`, "line2");
  assert(joined(usize(2)) == `line3`, "line3");
});
test("String lines on empty string", {
  iter := ``.lines();
  match(
    iter.next(),
    .Some(_) => assert(false, "empty string should yield no lines"),
    .None => ()
  );
});
test("String lines handles trailing newline", {
  iter :=
    `a
b
`.lines();
  count := usize(0);
  while(runtime(true), {
    match(
      iter.next(),
      .Some(_) => {
        count = (count + usize(1));
      },
      .None => break
    );
  });
  assert(count == usize(2), "trailing newline does not add empty line");
});
