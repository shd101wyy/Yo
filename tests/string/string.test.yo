// ===== starts_with with position Tests =====
test("String starts_with with position at start", {
  s := String.from("Hello World");
  assert(s.starts_with(String.from("Hello"), usize(0)));
});
test("String starts_with with position in middle", {
  s := String.from("Hello World");
  assert(s.starts_with(String.from("World"), usize(6)));
  assert(not(s.starts_with(String.from("Hello"), usize(6))));
});
test("String starts_with position skips prefix", {
  s := String.from("abcdef");
  assert(s.starts_with(String.from("cde"), usize(2)));
  assert(s.starts_with(String.from("def"), usize(3)));
});
test("String starts_with position UTF-8", {
  // `position` is a BYTE offset. Before D4 this was a rune walk that stopped
  // one byte past a lead byte, so `starts_with("世界", 2)` could not be
  // expressed at all (plans/STD_API_AUDIT_D4_PLAN.md §1.3(a)).
  s := String.from("你好世界");
  assert(s.starts_with(String.from("你好"), usize(0)));
  assert(s.starts_with(String.from("世界"), usize(6)));
  assert(s.starts_with(String.from("好世"), usize(3)));
  // A mid-rune position simply cannot match — no panic, just `false`.
  assert(not(s.starts_with(String.from("世界"), usize(5))));
  assert(not(s.starts_with(String.from("好世"), usize(1))));
});
test("String starts_with position beyond length", {
  s := String.from("Hello");
  assert(not(s.starts_with(String.from("o"), usize(10))));
});
test("String starts_with position with emojis", {
  s := String.from("😀😁😂");
  assert(s.starts_with(String.from("😀"), usize(0)));
  assert(s.starts_with(String.from("😁"), usize(4)));
  assert(s.starts_with(String.from("😂"), usize(8)));
});
test("String starts_with position empty prefix", {
  s := String.from("Hello");
  assert(s.starts_with(String.from(""), usize(0)));
  assert(s.starts_with(String.from(""), usize(3)));
});
test("String starts_with position mixed ASCII and UTF-8", {
  s := String.from("Hello 世界");
  assert(s.starts_with(String.from("世"), usize(6)));
  assert(s.starts_with(String.from("世界"), usize(6)));
  assert(not(s.starts_with(String.from("Hello"), usize(6))));
});
// ===== ends_with with end_position Tests =====
test("String ends_with end_position full length", {
  s := String.from("Hello World");
  assert(s.ends_with(String.from("World"), s.len()));
});
test("String ends_with end_position partial string", {
  s := String.from("Hello World");
  assert(s.ends_with(String.from("Hello"), usize(5)));
  assert(not(s.ends_with(String.from("World"), usize(5))));
});
test("String ends_with end_position middle", {
  s := String.from("abcdef");
  assert(s.ends_with(String.from("abc"), usize(3)));
  assert(s.ends_with(String.from("abcd"), usize(4)));
  assert(s.ends_with(String.from("c"), usize(3)));
});
test("String ends_with end_position UTF-8", {
  // `end_position` is how many BYTES of `s` to consider.
  s := String.from("你好世界");
  assert(s.ends_with(String.from("你好"), usize(6)));
  assert(s.ends_with(String.from("好"), usize(6)));
  assert(s.ends_with(String.from("你"), usize(3)));
  assert(s.ends_with(String.from("世界"), usize(12)));
  // Cutting mid-rune cannot match a valid-UTF-8 suffix.
  assert(not(s.ends_with(String.from("好"), usize(5))));
});
test("String ends_with end_position zero", {
  s := String.from("Hello");
  assert(s.ends_with(String.from(""), usize(0)));
  assert(not(s.ends_with(String.from("H"), usize(0))));
});
test("String ends_with end_position beyond length", {
  s := String.from("Hello");
  assert(s.ends_with(String.from("Hello"), usize(100)));
});
test("String ends_with end_position with emojis", {
  s := String.from("😀😁😂");
  assert(s.ends_with(String.from("😀"), usize(4)));
  assert(s.ends_with(String.from("😀😁"), usize(8)));
  assert(s.ends_with(String.from("😂"), usize(12)));
});
test("String ends_with end_position empty suffix", {
  s := String.from("Hello");
  assert(s.ends_with(String.from(""), usize(0)));
  assert(s.ends_with(String.from(""), usize(3)));
});
test("String ends_with end_position mixed ASCII and UTF-8", {
  // "Hello "@0..6, 世@6..9, 界@9..12.
  s := String.from("Hello 世界");
  assert(s.ends_with(String.from("Hello"), usize(5)));
  assert(s.ends_with(String.from(" 世"), usize(9)));
  assert(not(s.ends_with(String.from("世界"), usize(5))));
});
test("String ends_with end_position single character", {
  s := String.from("abcdef");
  assert(s.ends_with(String.from("a"), usize(1)));
  assert(s.ends_with(String.from("b"), usize(2)));
  assert(s.ends_with(String.from("c"), usize(3)));
});
// ===== Iterator Tests =====
// --- chars() tests ---
test("String chars - empty string yields nothing", {
  s := String.new();
  count := usize(0);
  for(s.chars(), ch => {
    consume(ch);
    count = (count + usize(1));
  });
  assert(count == usize(0), "empty string should yield no runes");
});
test("String chars - ASCII string yields correct runes", {
  s := `ABC`;
  count := usize(0);
  sum := u32(0);
  for(s.chars(), ch => {
    sum = (sum + ch.to_u32());
    count = (count + usize(1));
  });
  assert(count == usize(3), "should yield 3 runes");
  // A=65, B=66, C=67 => 198
  assert(sum == u32(198), "sum of codepoints should be correct");
});
test("String chars - multi-byte UTF-8 yields correct runes", {
  // "你好" - two 3-byte CJK characters
  s := `你好`;
  count := usize(0);
  runes := ArrayList(u32).new();
  for(s.chars(), ch => {
    runes.push(ch.to_u32());
    count = (count + usize(1));
  });
  assert(count == usize(2), "should yield 2 runes");
  assert(runes(usize(0)) == u32(0x4F60), "first rune should be 你");
  assert(runes(usize(1)) == u32(0x597D), "second rune should be 好");
});
test("String chars - 4-byte emoji characters", {
  // "😀😎" - two 4-byte emoji
  s := `😀😎`;
  count := usize(0);
  runes := ArrayList(u32).new();
  for(s.chars(), ch => {
    runes.push(ch.to_u32());
    count = (count + usize(1));
  });
  assert(count == usize(2), "should yield 2 runes");
  assert(runes(usize(0)) == u32(0x1F600), "first rune should be 😀");
  assert(runes(usize(1)) == u32(0x1F60E), "second rune should be 😎");
});
test("String chars - mixed ASCII and UTF-8", {
  s := `Hi世界`;
  count := usize(0);
  for(s.chars(), ch => {
    consume(ch);
    count = (count + usize(1));
  });
  assert(count == usize(4), "should yield 4 runes");
});
// --- bytes_iter() tests ---
test("String bytes - empty string yields nothing", {
  s := String.new();
  count := usize(0);
  for(s.bytes(), b => {
    consume(b);
    count = (count + usize(1));
  });
  assert(count == usize(0), "empty string should yield no bytes");
});
test("String bytes - ASCII string yields raw bytes", {
  s := `ABC`;
  count := usize(0);
  bytes := ArrayList(u8).new();
  for(s.bytes(), b => {
    bytes.push(b);
    count = (count + usize(1));
  });
  assert(count == usize(3), "should yield 3 bytes");
  assert(bytes(usize(0)) == u8(65), "first byte should be 'A'");
  assert(bytes(usize(1)) == u8(66), "second byte should be 'B'");
  assert(bytes(usize(2)) == u8(67), "third byte should be 'C'");
});
test("String bytes - UTF-8 string yields all bytes", {
  // "你" is 3 bytes in UTF-8: 0xE4, 0xBD, 0xA0
  s := `你`;
  count := usize(0);
  bytes := ArrayList(u8).new();
  for(s.bytes(), b => {
    bytes.push(b);
    count = (count + usize(1));
  });
  assert(count == usize(3), "should yield 3 bytes for 你");
  assert(bytes(usize(0)) == u8(0xE4), "first byte");
  assert(bytes(usize(1)) == u8(0xBD), "second byte");
  assert(bytes(usize(2)) == u8(0xA0), "third byte");
});
// --- into_iter() tests ---
test("String into_iter - yields runes like chars", {
  s := `Hello`;
  count := usize(0);
  first := u32(0);
  for(s.into_iter(), ch => {
    cond(
      (count == usize(0)) => {
        first = ch.to_u32();
      },
      true => ()
    );
    count = (count + usize(1));
  });
  assert(count == usize(5), "should yield 5 runes");
  assert(first == u32(72), "first rune should be 'H'");
});
test("String into_iter - empty string", {
  s := String.new();
  count := usize(0);
  for(s.into_iter(), ch => {
    consume(ch);
    count = (count + usize(1));
  });
  assert(count == usize(0), "empty string should yield no runes");
});
test("Test String.with_capacity", {
  s := String.with_capacity(usize(100));
  assert(s.len() == usize(0), "with_capacity should start empty");
  assert(s.chars().count() == usize(0), "with_capacity rune count should be 0");
});
test("Test String.push_str", {
  s := String.new();
  s.push_str("hello");
  s.push_str(" ");
  s.push_str("world");
  assert(s == `hello world`, "push_str should append correctly");
  assert(s.len() == usize(11), "len should be 11 bytes");
});
test("Test String.push_string", {
  s := String.new();
  s.push_string(`hello`);
  s.push_string(` `);
  s.push_string(`world`);
  assert(s == `hello world`, "push_string should append correctly");
});
test("Test String.push_byte", {
  s := String.new();
  s.push_byte(u8(65)); // 'A'
  s.push_byte(u8(66)); // 'B'
  s.push_byte(u8(67)); // 'C'
  assert(s == `ABC`, "push_byte should append bytes");
  assert(s.len() == usize(3), "len should be 3 bytes");
});
test("Test String.reserve", {
  s := String.from("hi");
  s.reserve(usize(100));
  assert(s == `hi`, "reserve should not change content");
  assert(s.len() == usize(2), "len should still be 2 after reserve");
});
test("Test String.len counts UTF-8 bytes", {
  s := String.from("café");
  assert(s.len() == usize(5), "len of 'café' should be 5 (UTF-8)");
  assert(s.chars().count() == usize(4), "and 4 runes");
  ascii := String.from("hello");
  assert(ascii.len() == usize(5), "ASCII len is the character count too");
});
test("Test String.substring", {
  s := String.from("hello world");
  sub := s.substring(usize(0), usize(5));
  assert(sub == `hello`, "substring(0,5) should be 'hello'");
  sub2 := s.substring(usize(6), usize(11));
  assert(sub2 == `world`, "substring(6,11) should be 'world'");
  empty := s.substring(usize(3), usize(3));
  assert(empty == ``, "substring with equal start/end should be empty");
});
// ===== Heterogeneous Eq: String <-> str (plans/archive/SLICE_REWORK.md step 1) =====
test("String == str compares bytes directly", {
  x := String.from("abc");
  e := String.new();
  assert(x == "abc", "String==str equal");
  assert(x != "abd", "String!=str different bytes");
  assert(x != "abcd", "String!=str different length");
  assert(x != "", "nonempty String != empty str");
  assert(e == "", "empty String == empty str");
  assert(e != "a", "empty String != nonempty str");
});
test("str == String compares bytes directly", {
  x := String.from("abc");
  e := String.new();
  assert("abc" == x, "str==String equal");
  assert("abd" != x, "str!=String different bytes");
  assert("abcd" != x, "str!=String different length");
  assert("" == e, "empty str == empty String");
  assert("a" != e, "nonempty str != empty String");
});
test("String str-pattern overloads (StrPattern trait)", {
  x := String.from("hello world");
  assert(x.contains("world"), "contains str");
  assert(!x.contains("worlds"), "contains str negative");
  assert(x.contains("o w", usize(3)), "contains str with from_index");
  assert(x.starts_with("hello"), "starts_with str");
  assert(!x.starts_with("world"), "starts_with str negative");
  assert(x.ends_with("world"), "ends_with str");
  assert(!x.ends_with("hello"), "ends_with str negative");
  assert(match(x.index_of("lo"), .Some(i) => (i == usize(3)), .None => false), "index_of str");
  assert(match(x.index_of("zz"), .Some(_) => false, .None => true), "index_of str none");
  assert(match(x.last_index_of("o"), .Some(i) => (i == usize(7)), .None => false), "last_index_of str");
  parts := x.split(" ");
  assert(parts.len() == usize(2), "split str count");
  assert(match(parts.get(usize(0)), .Some(p) => (p == "hello"), .None => false), "split str first");
  assert(match(parts.get(usize(1)), .Some(p) => (p == "world"), .None => false), "split str second");
  // The String-typed inherent methods still dispatch alongside the
  // str-typed trait overloads.
  assert(x.contains(String.from("world")), "contains String");
  assert(x.starts_with(String.from("hello")), "starts_with String");
});
test("String.byte_at indexes bytes", {
  s := String.from("abc");
  assert(s.byte_at(usize(0)) == u8(97), "byte 0");
  assert(s.byte_at(usize(2)) == u8(99), "byte 2");
  multi := String.from("café");
  assert(multi.len() == usize(5), "UTF-8 byte length");
  assert(multi.byte_at(usize(3)) == u8(195), "UTF-8 lead byte");
});
test("String Ord compares byte-lexicographically", {
  a := String.from("apple");
  b := String.from("banana");
  assert(a < b, "apple < banana");
  assert(b > a, "banana > apple");
  assert(a <= a.clone(), "a <= a");
  assert(a >= a.clone(), "a >= a");
  assert(!(b < a), "not banana < apple");
  assert(String.from("ab") < String.from("abc"), "prefix sorts first");
  assert(String.new() < String.from("a"), "empty sorts first");
});
// ---------------------------------------------------------------------------
// Control characters in string literals must survive codegen.
//
// The C emitter quoted string literals with JSON escaping, and JSON spells a
// control character `\uXXXX` — which C REJECTS ("universal character name
// refers to a control character"). A `\0` in any string literal (e.g. a
// NUL-separated dedup key, mirroring TS `join("\0")`) made the emitted C fail
// to compile. Control bytes now emit as named escapes or 3-digit octal.
// See issues/fixed/c-string-literal-control-chars-emitted-as-unicode-escapes.md.
// ---------------------------------------------------------------------------
test("String literals carry NUL and control characters through codegen", {
  sep := `\0`;
  assert(sep.len() == usize(1), "NUL literal is one byte");
  assert(sep.byte_at(usize(0)) == u8(0), "and that byte is 0");
  key := `a${sep}b`;
  assert(key.len() == usize(3), "NUL embeds in a template string");
  assert(key.byte_at(usize(1)) == u8(0), "the embedded byte is 0");
  ctl := `\0${String.from("x")}\b\f`;
  assert(ctl.len() == usize(4), "NUL + x + backspace + formfeed");
  assert(ctl.byte_at(usize(2)) == u8(8), "backspace byte");
  assert(ctl.byte_at(usize(3)) == u8(12), "formfeed byte");
});
// ===== Unicode case conversion (std/string/unicode tables) =====
// to_lowercase/to_uppercase used to map ASCII only; they now carry the full
// Unicode 15.1 mapping. The ASCII arms above pin that ASCII behavior is
// byte-identical to before.
test("String to_lowercase is Unicode-correct", {
  assert(String.from("ÉCOLE").to_lowercase() == String.from("école"), "Latin-1 lower");
  assert(String.from("ΑΒΓ ΩΣ").to_lowercase() == String.from("αβγ ωσ"), "Greek (no final-sigma context rule)");
  assert(String.from("ĀĂĄĆ").to_lowercase() == String.from("āăąć"), "Latin Extended-A alternating range");
  (deseret : String) = String.from("𐐀𐐁").to_lowercase();
  assert(deseret == String.from("𐐨𐐩"), "Deseret (supplementary plane)");
  (dotted : String) = String.from("İ").to_lowercase();
  assert(dotted.len() == usize(3), "İ expands to i + U+0307 (one byte + two bytes)");
  assert((dotted.byte_at(usize(0)) == u8(0x69)) && ((dotted.byte_at(usize(1)) == u8(0xCC)) && (dotted.byte_at(usize(2)) == u8(0x87))), "the expansion bytes (i + U+0307)");
  assert(String.from("").to_lowercase() == String.from(""), "empty stays empty");
});
test("String to_uppercase is Unicode-correct", {
  assert(String.from("école").to_uppercase() == String.from("ÉCOLE"), "Latin-1 upper");
  (sharp_s : String) = String.from("straße").to_uppercase();
  assert(sharp_s == String.from("STRASSE"), "ß expands to SS (length grows)");
  assert(String.from("ﬁ").to_uppercase() == String.from("FI"), "ligature expands");
  assert(String.from("привет").to_uppercase() == String.from("ПРИВЕТ"), "Cyrillic");
  assert(String.from("ǆ").to_uppercase() == String.from("Ǆ"), "titlecase digraph");
});
test("String to_ascii_* maps ASCII only, byte-for-byte", {
  (mixed : String) = String.from("ÉAbC");
  assert(mixed.to_ascii_lowercase() == String.from("Éabc"), "non-ASCII byte untouched by to_ascii_lowercase");
  assert(mixed.to_ascii_uppercase() == String.from("ÉABC"), "non-ASCII byte untouched by to_ascii_uppercase");
  assert(mixed.to_ascii_lowercase().len() == mixed.len(), "no expansion — ASCII mapping is byte-wise");
  assert(String.from("AbC").to_ascii_lowercase() == String.from("abc"), "plain ASCII lower");
  assert(String.from("AbC").to_ascii_uppercase() == String.from("ABC"), "plain ASCII upper");
});
// ===== rune as a Pattern =====
test("rune pattern: contains / index_of / last_index_of", {
  s := String.from("a,é,b");
  assert(s.contains(rune(u32(0x2C))), "comma contained");
  assert(s.contains(rune(u32(0xE9))), "é contained");
  assert(!s.contains(rune(u32(0x2F))), "/ not contained");
  assert(s.index_of(rune(u32(0xE9))).unwrap_or(usize(999)) == usize(2), "é starts at byte 2");
  assert(s.last_index_of(rune(u32(0x2C))).unwrap_or(usize(999)) == usize(4), "last comma at byte 4 (a, comma, 2-byte é, then this comma)");
  assert(s.index_of(rune(u32(0xE9)), usize(3)).is_none(), "from_index past the é finds nothing");
});
test("rune pattern: starts_with / ends_with / split / split_once", {
  s := String.from("é,x");
  assert(s.starts_with(rune(u32(0xE9))), "starts with é");
  assert(s.ends_with(rune(u32(0x78))), "ends with x");
  assert(!s.ends_with(rune(u32(0x2C))), "does not end with comma");
  parts := s.split(rune(u32(0x2C)));
  assert(parts.len() == usize(2), "split on comma");
  first := parts.get(usize(0)).unwrap_or(String.from("?"));
  second := parts.get(usize(1)).unwrap_or(String.from("?"));
  assert((first == String.from("é")) && (second == String.from("x")), "split parts");
  match(
    s.split_once(rune(u32(0x2C))),
    .Some(p) => begin(assert(p.0 == String.from("é"), "split_once first half"), assert(p.1 == String.from("x"), "split_once second half")),
    .None => assert(false, "split_once on a rune")
  );
});
test("rune pattern: replace / replace_all", {
  s := String.from("aébéc");
  assert(s.replace(rune(u32(0xE9)), String.from("E")) == String.from("aEbEc"), "replace every é");
  assert(s.replacen(rune(u32(0xE9)), String.from("E"), usize(1)) == String.from("aEbéc"), "replacen 1 é");
  assert(s.replace_all(rune(u32(0xE9)), String.from("E")) == String.from("aEbEc"), "replace_all é");
  assert(s.replace(rune(u32(0xFF)), String.from("X")) == s, "absent rune replaces nothing");
});
// ===== split_once =====
test("String split_once", {
  kv := String.from("key=value=more");
  match(
    kv.split_once(String.from("=")),
    .Some(p) => begin(assert(p.0 == String.from("key"), "split_once before-half"), assert(p.1 == String.from("value=more"), "split_once after-half")),
    .None => assert(false, "separator is present")
  );
  assert(kv.split_once(String.from("!")).is_none(), "absent separator is .None");
  match(
    kv.split_once(""),
    .Some(p) => begin(assert(p.0 == String.from(""), "empty separator: empty before-half"), assert(p.1 == kv, "empty separator: whole after-half")),
    .None => assert(false, "empty separator always matches")
  );
  assert(String.from("").split_once(String.from("=")).is_none(), "empty string, no separator");
});
// ===== strip_prefix / strip_suffix =====
test("String strip_prefix", {
  s := String.from("prefix-x");
  assert(s.strip_prefix(String.from("prefix-")).unwrap_or(String.from("?")) == String.from("x"), "strips the prefix");
  assert(s.strip_prefix(String.from("nope-")).is_none(), "non-matching prefix is .None");
  assert(s.strip_prefix("").unwrap_or(String.from("?")) == s, "empty prefix strips nothing");
  assert(s.strip_prefix(s).unwrap_or(String.from("?")) == String.from(""), "whole-string prefix strips to empty");
});
test("String strip_suffix", {
  s := String.from("file.rs");
  assert(s.strip_suffix(String.from(".rs")).unwrap_or(String.from("?")) == String.from("file"), "strips the suffix");
  assert(s.strip_suffix(String.from(".ts")).is_none(), "non-matching suffix is .None");
  assert(s.strip_suffix("").unwrap_or(String.from("?")) == s, "empty suffix strips nothing");
  assert(String.from("aaa").strip_suffix(String.from("aa")).unwrap_or(String.from("?")) == String.from("a"), "last starting occurrence wins (Rust parity)");
  assert(String.from("café").strip_suffix(String.from("é")).unwrap_or(String.from("?")) == String.from("caf"), "multibyte suffix");
});
// ===== replace_all with an empty (zero-width) pattern =====
// Rust semantics, adopted with the Pattern-generic rewrite: an empty pattern
// matches between every pair of runes and at both ends. (It used to return
// `self` unchanged.)
test("String replace_all with empty search inserts everywhere", {
  s := String.from("abc");
  assert(s.replace_all(String.from(""), String.from("-")) == String.from("-a-b-c-"), "Rust: \"abc\".replace_all(\"\", \"-\") == \"-a-b-c-\"");
  assert(String.from("").replace_all(String.from(""), String.from("-")) == String.from("-"), "the empty string still has one boundary");
});
// ===== parse_f64 =====
test("String parse_f64 accepts the Rust f64::from_str grammar", {
  assert_approx(String.from("3.25").parse_f64().unwrap_or(f64(0)), f64(3.25), f64(0.000000000001), "plain decimal");
  assert_approx(String.from("-1.5e-3").parse_f64().unwrap_or(f64(0)), f64(-0.0015), f64(0.000000000001), "signed exponent");
  assert_approx(String.from(".5").parse_f64().unwrap_or(f64(0)), f64(0.5), f64(0.000000000001), "leading dot");
  assert_approx(String.from("5.").parse_f64().unwrap_or(f64(0)), f64(5), f64(0.000000000001), "trailing dot");
  assert_approx(String.from("+2").parse_f64().unwrap_or(f64(0)), f64(2), f64(0.000000000001), "explicit plus");
  assert_approx(String.from("01").parse_f64().unwrap_or(f64(0)), f64(1), f64(0.000000000001), "leading zero (unlike JSON)");
  assert(String.from("inf").parse_f64().is_some(), "inf");
  assert(String.from("NAN").parse_f64().is_some(), "NAN (case-insensitive)");
  assert(String.from("Infinity").parse_f64().is_some(), "Infinity");
});
test("String parse_f64 rejects what atof would silently accept", {
  assert(String.from(" 1").parse_f64().is_none(), "leading whitespace");
  assert(String.from("1 ").parse_f64().is_none(), "trailing whitespace");
  assert(String.from("0x1p3").parse_f64().is_none(), "hex float");
  assert(String.from("1.2.3").parse_f64().is_none(), "two dots");
  assert(String.from("").parse_f64().is_none(), "empty");
  assert(String.from("1e").parse_f64().is_none(), "dangling exponent");
  assert(String.from("1e+").parse_f64().is_none(), "exponent sign with no digits");
  assert(String.from(".").parse_f64().is_none(), "dot alone (no digits)");
  assert(String.from("abc").parse_f64().is_none(), "not a number");
});
// ===== parse_i64_radix / parse_u64_radix =====
test("String parse_i64_radix", {
  assert(String.from("ff").parse_i64_radix(u32(16)).unwrap_or(i64(-999)) == i64(255), "hex");
  assert(String.from("-ff").parse_i64_radix(u32(16)).unwrap_or(i64(0)) == i64(-255), "negative hex");
  assert(String.from("101").parse_i64_radix(u32(2)).unwrap_or(i64(-999)) == i64(5), "binary");
  assert(String.from("z").parse_i64_radix(u32(36)).unwrap_or(i64(-999)) == i64(35), "base 36");
  assert(String.from("+7").parse_i64_radix(u32(10)).unwrap_or(i64(-999)) == i64(7), "explicit plus");
  assert(String.from("-8000000000000000").parse_i64_radix(u32(16)).unwrap_or(i64(0)) == i64.MIN, "exactly i64.MIN");
  assert(String.from("ffffffffffffffff").parse_i64_radix(u32(16)).is_none(), "overflows i64");
  assert(String.from("2").parse_i64_radix(u32(2)).is_none(), "digit not valid in radix");
  assert(String.from("1_0").parse_i64_radix(u32(10)).is_none(), "underscore rejected (Rust from_str_radix)");
  assert(String.from("").parse_i64_radix(u32(10)).is_none(), "empty");
  assert(String.from("8").parse_i64_radix(u32(1)).is_none(), "radix below 2");
  assert(String.from("8").parse_i64_radix(u32(37)).is_none(), "radix above 36");
});
test("String parse_u64_radix", {
  assert(String.from("ff").parse_u64_radix(u32(16)).unwrap_or(u64(999)) == u64(255), "hex");
  assert(String.from("ffffffffffffffff").parse_u64_radix(u32(16)).unwrap_or(u64(0)) == u64.MAX, "u64 max");
  assert(String.from("+7").parse_u64_radix(u32(10)).unwrap_or(u64(999)) == u64(7), "explicit plus");
  assert(String.from("-1").parse_u64_radix(u32(10)).is_none(), "minus rejected for unsigned (Rust parity)");
  assert(String.from("2").parse_u64_radix(u32(2)).is_none(), "digit not valid in radix");
  assert(String.from("100000000000000000000").parse_u64_radix(u32(10)).is_none(), "overflows u64");
});
