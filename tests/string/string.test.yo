  result := s.replace_all(String.from("world"), String.from("universe"));
  assert(result == String.from("hello universe"));
});
test("String replace_all not found", {
  s := String.from("hello world");
  result := s.replace_all(String.from("xyz"), String.from("abc"));
  assert(result == s);
});
test("String replace_all with empty string removes all", {
  s := String.from("hello world");
  result := s.replace_all(String.from("o"), String.from(""));
  assert(result == String.from("hell wrld"));
});
test("String replace_all UTF-8", {
  s := String.from("你好世界你好");
  result := s.replace_all(String.from("你好"), String.from("再见"));
  assert(result == String.from("再见世界再见"));
});
test("String replace_all emoji", {
  s := String.from("😀😁😀😁😀");
