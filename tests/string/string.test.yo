pragma(Pragma.AllowUnsafe);
{ assert, assert_approx } :: import("std/assert");
open(import("std/string"));
open(import("std/collections/array_list"));
// ===== Construction Tests =====
test("String.new creates empty string", {
  s := String.new();
  assert(s.is_empty());
  assert(s.len() == usize(0));
});
test("String.from_bytes creates string from byte array", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(72));
  bytes.push(u8(101));
  bytes.push(u8(108));
  bytes.push(u8(108));
  bytes.push(u8(111));
  s := String.from_bytes(bytes);
  assert(not(s.is_empty()));
  assert(s.len() == usize(5));
});
test("String.from creates string from str", {
  // (Former "from byte slice" test: constructing a str view over mortal
  // stack bytes is no longer possible — str is the builtin STATIC view;
  // see plans/archive/SLICE_REWORK.md.)
  s := String.from("Hello");
  assert(s.len() == usize(5));
});
// ===== ASCII String Tests =====
test("String ASCII length", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(72));
  bytes.push(u8(101));
  bytes.push(u8(108));
  bytes.push(u8(108));
  bytes.push(u8(111));
  s := String.from_bytes(bytes);
  assert(s.len() == usize(5));
});
test("String ASCII at() method", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  bytes.push(u8(66));
  bytes.push(u8(67));
  s := String.from_bytes(bytes);
  first := s.at(usize(0));
  assert(first.is_some());
  assert(first.unwrap().to_u32() == u32(65));
  second := s.at(usize(1));
  assert(second.is_some());
  assert(second.unwrap().to_u32() == u32(66));
  third := s.at(usize(2));
  assert(third.is_some());
  assert(third.unwrap().to_u32() == u32(67));
});
test("String ASCII at() out of bounds", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  s := String.from_bytes(bytes);
  result := s.at(usize(5));
  assert(result.is_none());
});
// ===== UTF-8 2-byte Character Tests =====
test("String UTF-8 2-byte character length", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xC2));
  bytes.push(u8(0xA9));
  s := String.from_bytes(bytes);
  // U+00A9 © is one rune in two bytes. `len()` counts BYTES since D4
  // (plans/STD_API_AUDIT_D4_PLAN.md PR 3); `chars().count()` is the rune count
  // this used to assert.
  assert(s.len() == usize(2));
  assert(s.chars().count() == usize(1));
});
test("String UTF-8 2-byte character decode", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xC2));
  bytes.push(u8(0xA9));
  s := String.from_bytes(bytes);
  ch := s.at(usize(0));
  assert(ch.is_some());
  assert(ch.unwrap().to_u32() == u32(0xA9));
});
test("String UTF-8 2-byte multiple characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xC3));
  bytes.push(u8(0xA9));
  bytes.push(u8(0xC3));
  bytes.push(u8(0xA7));
  bytes.push(u8(0xC3));
  bytes.push(u8(0xB1));
  s := String.from_bytes(bytes);
  // é ç ñ — three 2-byte runes at byte offsets 0, 2, 4.
  assert(s.len() == usize(6));
  assert(s.chars().count() == usize(3));
  first := s.at(usize(0));
  assert(first.is_some());
  assert(first.unwrap().to_u32() == u32(0xE9));
  second := s.at(usize(2));
  assert(second.is_some());
  assert(second.unwrap().to_u32() == u32(0xE7));
  third := s.at(usize(4));
  assert(third.is_some());
  assert(third.unwrap().to_u32() == u32(0xF1));
  // A continuation byte is not the start of a rune, so `at` answers `.None`.
  assert(s.at(usize(1)).is_none());
  assert(s.at(usize(3)).is_none());
});
// ===== UTF-8 3-byte Character Tests =====
test("String UTF-8 3-byte character length", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xE4));
  bytes.push(u8(0xB8));
  bytes.push(u8(0xAD));
  s := String.from_bytes(bytes);
  // U+4E2D 中 is one rune in three bytes.
  assert(s.len() == usize(3));
  assert(s.chars().count() == usize(1));
});
test("String UTF-8 3-byte character decode", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xE4));
  bytes.push(u8(0xB8));
  bytes.push(u8(0xAD));
  s := String.from_bytes(bytes);
  ch := s.at(usize(0));
  assert(ch.is_some());
  assert(ch.unwrap().to_u32() == u32(0x4E2D));
});
test("String UTF-8 3-byte multiple characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xE4));
  bytes.push(u8(0xB8));
  bytes.push(u8(0xAD));
  bytes.push(u8(0xE6));
  bytes.push(u8(0x96));
  bytes.push(u8(0x87));
  s := String.from_bytes(bytes);
  // 中 文 — two 3-byte runes at byte offsets 0 and 3.
  assert(s.len() == usize(6));
  assert(s.chars().count() == usize(2));
  first := s.at(usize(0));
  assert(first.is_some());
  assert(first.unwrap().to_u32() == u32(0x4E2D));
  second := s.at(usize(3));
  assert(second.is_some());
  assert(second.unwrap().to_u32() == u32(0x6587));
});
// ===== UTF-8 4-byte Character Tests =====
test("String UTF-8 4-byte character length", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xF0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0x98));
  bytes.push(u8(0x80));
  s := String.from_bytes(bytes);
  // U+1F600 😀 is one rune in four bytes.
  assert(s.len() == usize(4));
  assert(s.chars().count() == usize(1));
});
test("String UTF-8 4-byte character decode", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xF0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0x98));
  bytes.push(u8(0x80));
  s := String.from_bytes(bytes);
  ch := s.at(usize(0));
  assert(ch.is_some());
  assert(ch.unwrap().to_u32() == u32(0x1F600));
});
test("String UTF-8 4-byte multiple characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xF0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0x98));
  bytes.push(u8(0x80));
  bytes.push(u8(0xF0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0x98));
  bytes.push(u8(0x81));
  s := String.from_bytes(bytes);
  // 😀 😁 — two 4-byte runes at byte offsets 0 and 4.
  assert(s.len() == usize(8));
  assert(s.chars().count() == usize(2));
  first := s.at(usize(0));
  assert(first.is_some());
  assert(first.unwrap().to_u32() == u32(0x1F600));
  second := s.at(usize(4));
  assert(second.is_some());
  assert(second.unwrap().to_u32() == u32(0x1F601));
});
// ===== Mixed UTF-8 Tests =====
test("String mixed ASCII and UTF-8", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(72));
  bytes.push(u8(101));
  bytes.push(u8(0xE4));
  bytes.push(u8(0xB8));
  bytes.push(u8(0xAD));
  bytes.push(u8(0xE6));
  bytes.push(u8(0x96));
  bytes.push(u8(0x87));
  s := String.from_bytes(bytes);
  // "He中文" — H@0 e@1 中@2..5 文@5..8.
  assert(s.len() == usize(8));
  assert(s.chars().count() == usize(4));
  first := s.at(usize(0));
  assert(first.unwrap().to_u32() == u32(72));
  second := s.at(usize(1));
  assert(second.unwrap().to_u32() == u32(101));
  third := s.at(usize(2));
  assert(third.unwrap().to_u32() == u32(0x4E2D));
  fourth := s.at(usize(5));
  assert(fourth.unwrap().to_u32() == u32(0x6587));
});
test("String mixed 1,2,3,4 byte characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  bytes.push(u8(0xC2));
  bytes.push(u8(0xA9));
  bytes.push(u8(0xE4));
  bytes.push(u8(0xB8));
  bytes.push(u8(0xAD));
  bytes.push(u8(0xF0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0x98));
  bytes.push(u8(0x80));
  s := String.from_bytes(bytes);
  // "A©中😀" — A@0 (1B), ©@1 (2B), 中@3 (3B), 😀@6 (4B); 10 bytes, 4 runes.
  assert(s.len() == usize(10));
  assert(s.chars().count() == usize(4));
  char0 := s.at(usize(0));
  assert(char0.unwrap().to_u32() == u32(65));
  char1 := s.at(usize(1));
  assert(char1.unwrap().to_u32() == u32(0xA9));
  char2 := s.at(usize(3));
  assert(char2.unwrap().to_u32() == u32(0x4E2D));
  char3 := s.at(usize(6));
  assert(char3.unwrap().to_u32() == u32(0x1F600));
});
// ===== Concat Tests =====
test("String concat two ASCII strings", {
  bytes1 := ArrayList(u8).new();
  bytes1.push(u8(72));
  bytes1.push(u8(101));
  bytes2 := ArrayList(u8).new();
  bytes2.push(u8(108));
  bytes2.push(u8(111));
  str1 := String.from_bytes(bytes1);
  str2 := String.from_bytes(bytes2);
  result := str1.concat(str2);
  assert(result.len() == usize(4));
  assert(result.at(usize(0)).unwrap().to_u32() == u32(72));
  assert(result.at(usize(1)).unwrap().to_u32() == u32(101));
  assert(result.at(usize(2)).unwrap().to_u32() == u32(108));
  assert(result.at(usize(3)).unwrap().to_u32() == u32(111));
});
test("String concat empty with non-empty", {
  empty := String.new();
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  bytes.push(u8(66));
  s := String.from_bytes(bytes);
  result := empty.concat(s);
  assert(result.len() == usize(2));
});
test("String concat non-empty with empty", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  bytes.push(u8(66));
  s := String.from_bytes(bytes);
  empty := String.new();
  result := s.concat(empty);
  assert(result.len() == usize(2));
});
test("String concat two empty strings", {
  empty1 := String.new();
  empty2 := String.new();
  result := empty1.concat(empty2);
  assert(result.is_empty());
});
test("String concat UTF-8 strings", {
  bytes1 := ArrayList(u8).new();
  bytes1.push(u8(0xE4));
  bytes1.push(u8(0xB8));
  bytes1.push(u8(0xAD));
  bytes2 := ArrayList(u8).new();
  bytes2.push(u8(0xE6));
  bytes2.push(u8(0x96));
  bytes2.push(u8(0x87));
  str1 := String.from_bytes(bytes1);
  str2 := String.from_bytes(bytes2);
  result := str1.concat(str2);
  // 中 @0, 文 @3.
  assert(result.len() == usize(6));
  assert(result.chars().count() == usize(2));
  assert(result.at(usize(0)).unwrap().to_u32() == u32(0x4E2D));
  assert(result.at(usize(3)).unwrap().to_u32() == u32(0x6587));
});
test("String concat preserves original strings", {
  bytes1 := ArrayList(u8).new();
  bytes1.push(u8(65));
  bytes2 := ArrayList(u8).new();
  bytes2.push(u8(66));
  str1 := String.from_bytes(bytes1);
  str2 := String.from_bytes(bytes2);
  result := str1.concat(str2);
  assert(str1.len() == usize(1));
  assert(str2.len() == usize(1));
  assert(result.len() == usize(2));
});
// ===== Empty String Tests =====
test("String is_empty on empty string", {
  s := String.new();
  assert(s.is_empty());
});
test("String is_empty on non-empty string", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  s := String.from_bytes(bytes);
  assert(not(s.is_empty()));
});
// ===== as_bytes Tests =====
test("String as_bytes returns byte array", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(72));
  bytes.push(u8(101));
  s := String.from_bytes(bytes);
  result_bytes := s.as_bytes();
  assert(result_bytes.len() == usize(2));
  assert(result_bytes(usize(0)) == u8(72));
  assert(result_bytes(usize(1)) == u8(101));
});
test("String as_bytes on empty string", {
  s := String.new();
  result_bytes := s.as_bytes();
  assert(result_bytes.len() == usize(0));
});
// ===== Edge Cases =====
test("String at() on single character", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  s := String.from_bytes(bytes);
  ch := s.at(usize(0));
  assert(ch.is_some());
  assert(ch.unwrap().to_u32() == u32(65));
  invalid := s.at(usize(1));
  assert(invalid.is_none());
});
test("String len counts bytes while chars().count() only counts rune starts", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xE4));
  bytes.push(u8(0xB8));
  bytes.push(u8(0xAD));
  bytes.push(u8(0xE6));
  bytes.push(u8(0x96));
  bytes.push(u8(0x87));
  s := String.from_bytes(bytes);
  byte_count := s.as_bytes().len();
  assert(byte_count == usize(6));
  // `len()` IS the byte count since D4; `chars().count()` is the one that skips
  // UTF-8 continuation bytes.
  assert(s.len() == byte_count);
  assert(s.chars().count() == usize(2));
});
test("String multiple concat operations", {
  bytes1 := ArrayList(u8).new();
  bytes1.push(u8(65));
  bytes2 := ArrayList(u8).new();
  bytes2.push(u8(66));
  bytes3 := ArrayList(u8).new();
  bytes3.push(u8(67));
  str1 := String.from_bytes(bytes1);
  str2 := String.from_bytes(bytes2);
  str3 := String.from_bytes(bytes3);
  result := str1.concat(str2).concat(str3);
  assert(result.len() == usize(3));
  assert(result.at(usize(0)).unwrap().to_u32() == u32(65));
  assert(result.at(usize(1)).unwrap().to_u32() == u32(66));
  assert(result.at(usize(2)).unwrap().to_u32() == u32(67));
});
test("String at() sequential access", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  bytes.push(u8(66));
  bytes.push(u8(67));
  bytes.push(u8(68));
  bytes.push(u8(69));
  s := String.from_bytes(bytes);
  i := usize(0);
  while(i < s.len(), i = (i + usize(1)), {
    ch := s.at(i);
    assert(ch.is_some());
    expected := (u32(65) + u32(i));
    assert(ch.unwrap().to_u32() == expected);
  });
});
// ===== UTF-8 Validation Edge Cases =====
test("String UTF-8 null byte in middle", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  bytes.push(u8(0));
  bytes.push(u8(66));
  s := String.from_bytes(bytes);
  assert(s.len() == usize(3));
  first := s.at(usize(0));
  assert(first.unwrap().to_u32() == u32(65));
  second := s.at(usize(1));
  assert(second.unwrap().to_u32() == u32(0));
  third := s.at(usize(2));
  assert(third.unwrap().to_u32() == u32(66));
});
test("String UTF-8 all ASCII control characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0));
  bytes.push(u8(9));
  bytes.push(u8(10));
  bytes.push(u8(13));
  bytes.push(u8(32));
  s := String.from_bytes(bytes);
  assert(s.len() == usize(5));
});
// ===== String.from_cstr Tests =====
test("String.from_cstr creates string from C string", {
  (cstr : *u8) = "Hello";
  result := String.from_cstr(cstr);
  match(
    result,
    .Ok(s) => {
      assert(s.len() == usize(5));
      assert(s.at(usize(0)).unwrap().to_u32() == u32(72));
      assert(s.at(usize(4)).unwrap().to_u32() == u32(111));
    },
    .Err(_) => assert(false, "Should successfully create string from C string")
  );
});
test("String.from_cstr empty string", {
  (cstr : *u8) = "";
  result := String.from_cstr(cstr);
  match(
    result,
    .Ok(s) => {
      assert(s.is_empty());
      assert(s.len() == usize(0));
    },
    .Err(_) => assert(false, "Should successfully create empty string")
  );
});
test("String.from_cstr with UTF-8", {
  (cstr : *u8) = "Hello 世界";
  result := String.from_cstr(cstr);
  match(
    result,
    .Ok(s) => {
      // "Hello " is 6 ASCII bytes, 世界 is 3 + 3 → 12 bytes, 8 runes.
      assert(s.len() == usize(12));
      assert(s.chars().count() == usize(8));
    },
    .Err(_) => assert(false, "Should handle UTF-8 in C string")
  );
});
test("String.from_cstr single character", {
  (cstr : *u8) = "X";
  result := String.from_cstr(cstr);
  match(
    result,
    .Ok(s) => {
      assert(s.len() == usize(1));
      assert(s.at(usize(0)).unwrap().to_u32() == u32(88));
    },
    .Err(_) => assert(false, "Should create single character string")
  );
});
// ===== String Literal Conversion Tests =====
test("String.from with string literal", {
  s := String.from("ABC");
  assert(s.len() == usize(3));
  assert(s.at(usize(0)).unwrap().to_u32() == u32(65));
  assert(s.at(usize(1)).unwrap().to_u32() == u32(66));
  assert(s.at(usize(2)).unwrap().to_u32() == u32(67));
});
test("String.from with empty string literal", {
  s := String.from("");
  assert(s.is_empty());
  assert(s.len() == usize(0));
});
test("String.from with UTF-8 literal", {
  s := String.from("你好");
  assert(s.len() == usize(6));
  assert(s.chars().count() == usize(2));
});
test("String.from with emoji literal", {
  s := String.from("😀😁");
  assert(s.len() == usize(8));
  assert(s.chars().count() == usize(2));
  assert(s.at(usize(0)).unwrap().to_u32() == u32(0x1F600));
  assert(s.at(usize(4)).unwrap().to_u32() == u32(0x1F601));
});
// ===== Large String Tests =====
test("String with many ASCII characters", {
  bytes := ArrayList(u8).new();
  i := usize(0);
  while(i < usize(100), i = (i + usize(1)), {
    bytes.push(u8(65));
  });
  s := String.from_bytes(bytes);
  assert(s.len() == usize(100));
  assert(not(s.is_empty()));
});
test("String concat multiple times", {
  base := String.from("A");
  result := base.concat(base);
  assert(result.len() == usize(2));
  result2 := result.concat(result);
  assert(result2.len() == usize(4));
  result3 := result2.concat(result2);
  assert(result3.len() == usize(8));
});
// ===== String Byte Array Tests =====
test("String as_bytes preserves UTF-8 encoding", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xE4));
  bytes.push(u8(0xB8));
  bytes.push(u8(0xAD));
  s := String.from_bytes(bytes);
  result := s.as_bytes();
  assert(result.len() == usize(3));
  assert(result(usize(0)) == u8(0xE4));
  assert(result(usize(1)) == u8(0xB8));
  assert(result(usize(2)) == u8(0xAD));
});
test("String as_bytes returns copy not reference", {
  original_bytes := ArrayList(u8).new();
  original_bytes.push(u8(65));
  original_bytes.push(u8(66));
  s := String.from_bytes(original_bytes);
  retrieved := s.as_bytes();
  assert(retrieved.len() == usize(2));
});
// ===== Additional UTF-8 Character Tests =====
test("String Greek characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xCE));
  bytes.push(u8(0xB1));
  bytes.push(u8(0xCE));
  bytes.push(u8(0xB2));
  bytes.push(u8(0xCE));
  bytes.push(u8(0xB3));
  s := String.from_bytes(bytes);
  // α β γ — three 2-byte runes at byte offsets 0, 2, 4.
  assert(s.len() == usize(6));
  assert(s.chars().count() == usize(3));
  alpha := s.at(usize(0));
  assert(alpha.unwrap().to_u32() == u32(0x3B1));
  beta := s.at(usize(2));
  assert(beta.unwrap().to_u32() == u32(0x3B2));
  gamma := s.at(usize(4));
  assert(gamma.unwrap().to_u32() == u32(0x3B3));
});
test("String Cyrillic characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xD0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0xD1));
  bytes.push(u8(0x80));
  bytes.push(u8(0xD0));
  bytes.push(u8(0xB8));
  s := String.from_bytes(bytes);
  // П р и — three 2-byte runes at byte offsets 0, 2, 4.
  assert(s.len() == usize(6));
  assert(s.chars().count() == usize(3));
  p := s.at(usize(0));
  assert(p.unwrap().to_u32() == u32(0x41F));
  r := s.at(usize(2));
  assert(r.unwrap().to_u32() == u32(0x440));
  i := s.at(usize(4));
  assert(i.unwrap().to_u32() == u32(0x438));
});
test("String Arabic characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xD8));
  bytes.push(u8(0xA7));
  bytes.push(u8(0xD9));
  bytes.push(u8(0x84));
  s := String.from_bytes(bytes);
  // ا ل — two 2-byte runes at byte offsets 0 and 2.
  assert(s.len() == usize(4));
  assert(s.chars().count() == usize(2));
  alef := s.at(usize(0));
  assert(alef.unwrap().to_u32() == u32(0x627));
  lam := s.at(usize(2));
  assert(lam.unwrap().to_u32() == u32(0x644));
});
test("String Hebrew characters", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xD7));
  bytes.push(u8(0xA9));
  bytes.push(u8(0xD7));
  bytes.push(u8(0x9C));
  s := String.from_bytes(bytes);
  // ש ל — two 2-byte runes at byte offsets 0 and 2.
  assert(s.len() == usize(4));
  assert(s.chars().count() == usize(2));
  shin := s.at(usize(0));
  assert(shin.unwrap().to_u32() == u32(0x5E9));
  lamed := s.at(usize(2));
  assert(lamed.unwrap().to_u32() == u32(0x5DC));
});
test("String Japanese Hiragana", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xE3));
  bytes.push(u8(0x81));
  bytes.push(u8(0x82));
  bytes.push(u8(0xE3));
  bytes.push(u8(0x81));
  bytes.push(u8(0x84));
  s := String.from_bytes(bytes);
  // あ い — two 3-byte runes at byte offsets 0 and 3.
  assert(s.len() == usize(6));
  assert(s.chars().count() == usize(2));
  a := s.at(usize(0));
  assert(a.unwrap().to_u32() == u32(0x3042));
  i := s.at(usize(3));
  assert(i.unwrap().to_u32() == u32(0x3044));
});
test("String Korean Hangul", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xED));
  bytes.push(u8(0x95));
  bytes.push(u8(0x9C));
  bytes.push(u8(0xEA));
  bytes.push(u8(0xB8));
  bytes.push(u8(0x80));
  s := String.from_bytes(bytes);
  // 한 글 — two 3-byte runes at byte offsets 0 and 3.
  assert(s.len() == usize(6));
  assert(s.chars().count() == usize(2));
  han := s.at(usize(0));
  assert(han.unwrap().to_u32() == u32(0xD55C));
  gul := s.at(usize(3));
  assert(gul.unwrap().to_u32() == u32(0xAE00));
});
// ===== More Emoji Tests =====
test("String various emojis", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(0xF0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0x98));
  bytes.push(u8(0x80));
  bytes.push(u8(0xF0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0x91));
  bytes.push(u8(0x8D));
  bytes.push(u8(0xF0));
  bytes.push(u8(0x9F));
  bytes.push(u8(0x8E));
  bytes.push(u8(0x89));
  s := String.from_bytes(bytes);
  // 😀 👍 🎉 — three 4-byte runes at byte offsets 0, 4, 8.
  assert(s.len() == usize(12));
  assert(s.chars().count() == usize(3));
  grinning := s.at(usize(0));
  assert(grinning.unwrap().to_u32() == u32(0x1F600));
  thumbsup := s.at(usize(4));
  assert(thumbsup.unwrap().to_u32() == u32(0x1F44D));
  tada := s.at(usize(8));
  assert(tada.unwrap().to_u32() == u32(0x1F389));
});
// ===== Whitespace and Special Character Tests =====
test("String various whitespace", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(32));
  bytes.push(u8(9));
  bytes.push(u8(10));
  bytes.push(u8(13));
  s := String.from_bytes(bytes);
  assert(s.len() == usize(4));
  space := s.at(usize(0));
  assert(space.unwrap().to_u32() == u32(32));
  tab := s.at(usize(1));
  assert(tab.unwrap().to_u32() == u32(9));
  newline := s.at(usize(2));
  assert(newline.unwrap().to_u32() == u32(10));
  carriage := s.at(usize(3));
  assert(carriage.unwrap().to_u32() == u32(13));
});
test("String punctuation marks", {
  s := String.from("!@#$%^&*()");
  assert(s.len() == usize(10));
  exclaim := s.at(usize(0));
  assert(exclaim.unwrap().to_u32() == u32(33));
  at := s.at(usize(1));
  assert(at.unwrap().to_u32() == u32(64));
});
// ===== Concat Edge Cases =====
test("String concat with special characters", {
  str1 := String.from("Hello");
  str2 := String.from(" 世界");
  result := str1.concat(str2);
  // 5 ASCII + 1 space + 3 + 3 = 12 bytes, 8 runes.
  assert(result.len() == usize(12));
  assert(result.chars().count() == usize(8));
});
test("String concat three strings", {
  str1 := String.from("A");
  str2 := String.from("B");
  str3 := String.from("C");
  result := str1.concat(str2).concat(str3);
  assert(result.len() == usize(3));
  assert(result.at(usize(0)).unwrap().to_u32() == u32(65));
  assert(result.at(usize(1)).unwrap().to_u32() == u32(66));
  assert(result.at(usize(2)).unwrap().to_u32() == u32(67));
});
test("String concat identical strings", {
  s := String.from("Test");
  result := s.concat(s);
  assert(result.len() == usize(8));
  assert(s.len() == usize(4));
});
// ===== String + Operator Tests =====
test("String + operator two ASCII strings", {
  str1 := String.from("Hello");
  str2 := String.from(" world");
  result := (str1 + str2);
  assert(result.len() == usize(11));
  assert(result.at(usize(0)).unwrap().to_u32() == u32(72));
  assert(result.at(usize(5)).unwrap().to_u32() == u32(32));
  assert(result.at(usize(6)).unwrap().to_u32() == u32(119));
});
test("String + operator empty with non-empty", {
  empty := String.from("");
  s := String.from("Hello");
  result := (empty + s);
  assert(result.len() == usize(5));
});
test("String + operator non-empty with empty", {
  s := String.from("Hello");
  empty := String.from("");
  result := (s + empty);
  assert(result.len() == usize(5));
});
test("String + operator two empty strings", {
  empty1 := String.from("");
  empty2 := String.from("");
  result := (empty1 + empty2);
  assert(result.is_empty());
});
test("String + operator UTF-8 strings", {
  str1 := String.from("你");
  str2 := String.from("好");
  result := (str1 + str2);
  assert(result.len() == usize(6));
  assert(result.chars().count() == usize(2));
});
test("String + operator mixed ASCII and UTF-8", {
  str1 := String.from("Hello ");
  str2 := String.from("世界");
  result := (str1 + str2);
  // 6 ASCII + 3 + 3 = 12 bytes, 8 runes.
  assert(result.len() == usize(12));
  assert(result.chars().count() == usize(8));
});
test("String + operator chain", {
  str1 := String.from("A");
  str2 := String.from("B");
  str3 := String.from("C");
  result := (str1 + str2 + str3);
  assert(result.len() == usize(3));
  assert(result.at(usize(0)).unwrap().to_u32() == u32(65));
  assert(result.at(usize(1)).unwrap().to_u32() == u32(66));
  assert(result.at(usize(2)).unwrap().to_u32() == u32(67));
});
test("String + operator preserves original strings", {
  str1 := String.from("Hello");
  str2 := String.from(" world");
  result := (str1 + str2);
  assert(str1.len() == usize(5));
  assert(str2.len() == usize(6));
  assert(result.len() == usize(11));
});
// ===== String == Operator Tests =====
test("String == operator identical ASCII strings", {
  str1 := String.from("Hello");
  str2 := String.from("Hello");
  assert(str1 == str2);
});
test("String == operator different ASCII strings", {
  str1 := String.from("Hello");
  str2 := String.from("World");
  assert(not(str1 == str2));
});
test("String == operator empty strings", {
  str1 := String.from("");
  str2 := String.from("");
  assert(str1 == str2);
});
test("String == operator empty vs non-empty", {
  empty := String.from("");
  s := String.from("Hello");
  assert(not(empty == s));
  assert(not(s == empty));
});
test("String == operator different lengths", {
  str1 := String.from("Hello");
  str2 := String.from("Hello!");
  assert(not(str1 == str2));
});
test("String == operator UTF-8 strings equal", {
  str1 := String.from("你好");
  str2 := String.from("你好");
  assert(str1 == str2);
});
test("String == operator UTF-8 strings different", {
  str1 := String.from("你好");
  str2 := String.from("世界");
  assert(not(str1 == str2));
});
test("String == operator mixed ASCII and UTF-8 equal", {
  str1 := String.from("Hello 世界");
  str2 := String.from("Hello 世界");
  assert(str1 == str2);
});
test("String == operator mixed ASCII and UTF-8 different", {
  str1 := String.from("Hello 世界");
  str2 := String.from("Hello World");
  assert(not(str1 == str2));
});
test("String == operator with emoji equal", {
  str1 := String.from("😀😁");
  str2 := String.from("😀😁");
  assert(str1 == str2);
});
test("String == operator with emoji different", {
  str1 := String.from("😀😁");
  str2 := String.from("😁😀");
  assert(not(str1 == str2));
});
test("String == operator case sensitive", {
  str1 := String.from("Hello");
  str2 := String.from("hello");
  assert(not(str1 == str2));
});
test("String == operator with whitespace", {
  str1 := String.from("Hello World");
  str2 := String.from("HelloWorld");
  assert(not(str1 == str2));
});
test("String == operator single character equal", {
  str1 := String.from("A");
  str2 := String.from("A");
  assert(str1 == str2);
});
test("String == operator single character different", {
  str1 := String.from("A");
  str2 := String.from("B");
  assert(not(str1 == str2));
});
test("String + and == operators combined", {
  str1 := String.from("Hello");
  str2 := String.from(" ");
  str3 := String.from("world");
  result := (str1 + str2 + str3);
  expected := String.from("Hello world");
  assert(result == expected);
});
// ===== Performance and Stress Tests =====
test("String with_capacity and repeated push", {
  bytes := ArrayList(u8).with_capacity(usize(50));
  i := usize(0);
  while(i < usize(50), i = (i + usize(1)), {
    bytes.push(u8((i % usize(26)) + usize(65)));
  });
  s := String.from_bytes(bytes);
  assert(s.len() == usize(50));
  assert(not(s.is_empty()));
});
test("String alternating ASCII and UTF-8", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(65));
  bytes.push(u8(0xE4));
  bytes.push(u8(0xB8));
  bytes.push(u8(0xAD));
  bytes.push(u8(66));
  bytes.push(u8(0xE6));
  bytes.push(u8(0x96));
  bytes.push(u8(0x87));
  bytes.push(u8(67));
  s := String.from_bytes(bytes);
  // "A中B文C" — A@0, 中@1..4, B@4, 文@5..8, C@8; 9 bytes, 5 runes.
  assert(s.len() == usize(9));
  assert(s.chars().count() == usize(5));
  assert(s.at(usize(0)).unwrap().to_u32() == u32(65));
  assert(s.at(usize(1)).unwrap().to_u32() == u32(0x4E2D));
  assert(s.at(usize(4)).unwrap().to_u32() == u32(66));
  assert(s.at(usize(5)).unwrap().to_u32() == u32(0x6587));
  assert(s.at(usize(8)).unwrap().to_u32() == u32(67));
});
// ===== substring Tests =====
test("String substring ASCII basic", {
  s := String.from("Hello, World!");
  sub1 := s.substring(usize(0), usize(5));
  expected1 := String.from("Hello");
  assert(sub1 == expected1);
  sub2 := s.substring(usize(7), usize(12));
  expected2 := String.from("World");
  assert(sub2 == expected2);
  sub3 := s.substring(usize(0), usize(13));
  assert(sub3 == s);
});
test("String substring empty result", {
  s := String.from("Hello");
  sub := s.substring(usize(2), usize(2));
  assert(sub.is_empty());
  assert(sub.len() == usize(0));
});
test("String substring single character", {
  s := String.from("Hello");
  sub := s.substring(usize(1), usize(2));
  expected := String.from("e");
  assert(sub == expected);
  assert(sub.len() == usize(1));
});
test("String substring from middle to end", {
  s := String.from("Hello");
  sub := s.substring(usize(2), usize(5));
  expected := String.from("llo");
  assert(sub == expected);
});
test("String substring UTF-8 characters", {
  // 你@0..3 好@3..6 世@6..9 界@9..12 — BYTE offsets since D4.
  s := String.from("你好世界");
  sub1 := s.substring(usize(0), usize(6));
  expected1 := String.from("你好");
  assert(sub1 == expected1);
  sub2 := s.substring(usize(6), usize(12));
  expected2 := String.from("世界");
  assert(sub2 == expected2);
  sub3 := s.substring(usize(3), usize(9));
  expected3 := String.from("好世");
  assert(sub3 == expected3);
});
test("String substring mixed ASCII and UTF-8", {
  // "Hello "@0..6, 世@6..9, 界@9..12, "!"@12.
  s := String.from("Hello 世界!");
  sub1 := s.substring(usize(0), usize(5));
  expected1 := String.from("Hello");
  assert(sub1 == expected1);
  sub2 := s.substring(usize(6), usize(12));
  expected2 := String.from("世界");
  assert(sub2 == expected2);
});
test("String substring with emojis", {
  // 😀@0..4 😁@4..8 😂@8..12.
  s := String.from("😀😁😂");
  sub1 := s.substring(usize(0), usize(8));
  expected1 := String.from("😀😁");
  assert(sub1 == expected1);
  sub2 := s.substring(usize(4), usize(12));
  expected2 := String.from("😁😂");
  assert(sub2 == expected2);
});
test("String substring beyond end", {
  s := String.from("Hello");
  sub := s.substring(usize(0), usize(100));
  assert(sub == s);
});
test("String substring entire string", {
  s := String.from("Test String");
  sub := s.substring(usize(0), s.len());
  assert(sub == s);
});
// ===== index_of Tests =====
test("String index_of found at beginning", {
  s := String.from("Hello, World!");
  result := s.index_of(String.from("Hello"));
  assert(result.is_some());
  assert(result.unwrap() == usize(0));
});
test("String index_of found in middle", {
  s := String.from("Hello, World!");
  result := s.index_of(String.from("World"));
  assert(result.is_some());
  assert(result.unwrap() == usize(7));
});
test("String index_of not found", {
  s := String.from("Hello, World!");
  result := s.index_of(String.from("xyz"));
  assert(result.is_none());
});
test("String index_of single character", {
  s := String.from("Hello, World!");
  result := s.index_of(String.from(","));
  assert(result.is_some());
  assert(result.unwrap() == usize(5));
});
test("String index_of empty string", {
  s := String.from("Hello");
  result := s.index_of(String.from(""));
  assert(result.is_some());
  assert(result.unwrap() == usize(0));
});
test("String index_of entire string", {
  s := String.from("Hello");
  result := s.index_of(String.from("Hello"));
  assert(result.is_some());
  assert(result.unwrap() == usize(0));
});
test("String index_of substring longer than string", {
  s := String.from("Hi");
  result := s.index_of(String.from("Hello"));
  assert(result.is_none());
});
test("String index_of UTF-8 characters", {
  // BYTE offsets out, so the answer feeds straight back into `substring`.
  s := String.from("你好世界");
  result1 := s.index_of(String.from("世界"));
  assert(result1.is_some());
  assert(result1.unwrap() == usize(6));
  result2 := s.index_of(String.from("你好"));
  assert(result2.is_some());
  assert(result2.unwrap() == usize(0));
  result3 := s.index_of(String.from("好世"));
  assert(result3.is_some());
  assert(result3.unwrap() == usize(3));
  assert(s.substring(result3.unwrap(), result3.unwrap() + usize(6)) == String.from("好世"));
});
test("String index_of mixed ASCII and UTF-8", {
  s := String.from("Hello 世界!");
  result := s.index_of(String.from("世界"));
  assert(result.is_some());
  assert(result.unwrap() == usize(6));
});
test("String index_of with emojis", {
  s := String.from("😀😁😂");
  result := s.index_of(String.from("😁"));
  assert(result.is_some());
  assert(result.unwrap() == usize(4));
});
test("String index_of case sensitive", {
  s := String.from("Hello World");
  result := s.index_of(String.from("world"));
  assert(result.is_none());
});
test("String index_of multiple occurrences returns first", {
  s := String.from("abcabc");
  result := s.index_of(String.from("abc"));
  assert(result.is_some());
  assert(result.unwrap() == usize(0));
});
// ===== includes Tests =====
test("String includes found", {
  s := String.from("Hello, World!");
  assert(s.contains(String.from("World")));
  assert(s.contains(String.from("Hello")));
  assert(s.contains(String.from(",")));
});
test("String includes not found", {
  s := String.from("Hello, World!");
  assert(not(s.contains(String.from("xyz"))));
  assert(not(s.contains(String.from("world"))));
});
test("String includes empty string", {
  s := String.from("Hello");
  assert(s.contains(String.from("")));
});
test("String includes entire string", {
  s := String.from("Hello");
  assert(s.contains(String.from("Hello")));
});
test("String includes single character", {
  s := String.from("Hello");
  assert(s.contains(String.from("e")));
  assert(s.contains(String.from("H")));
  assert(not(s.contains(String.from("x"))));
});
test("String includes UTF-8 characters", {
  s := String.from("你好世界");
  assert(s.contains(String.from("世")));
  assert(s.contains(String.from("你好")));
  assert(s.contains(String.from("世界")));
  assert(not(s.contains(String.from("测试"))));
});
test("String includes mixed ASCII and UTF-8", {
  s := String.from("Hello 世界!");
  assert(s.contains(String.from("Hello")));
  assert(s.contains(String.from("世界")));
  assert(s.contains(String.from(" ")));
  assert(s.contains(String.from("!")));
});
test("String includes with emojis", {
  s := String.from("😀😁😂");
  assert(s.contains(String.from("😁")));
  assert(s.contains(String.from("😀😁")));
  assert(not(s.contains(String.from("😃"))));
});
test("String includes case sensitive", {
  s := String.from("Hello World");
  assert(s.contains(String.from("Hello")));
  assert(not(s.contains(String.from("hello"))));
});
test("String includes substring longer than string", {
  s := String.from("Hi");
  assert(not(s.contains(String.from("Hello"))));
});
// ===== split Tests =====
test("String split by comma", {
  s := String.from("Hello,World,Test");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)) == String.from("Hello"));
  assert(parts(usize(1)) == String.from("World"));
  assert(parts(usize(2)) == String.from("Test"));
});
test("String split by space", {
  s := String.from("one two three");
  parts := s.split(String.from(" "));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)) == String.from("one"));
  assert(parts(usize(1)) == String.from("two"));
  assert(parts(usize(2)) == String.from("three"));
});
test("String split by empty string splits into characters", {
  s := String.from("abc");
  parts := s.split(String.from(""));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)) == String.from("a"));
  assert(parts(usize(1)) == String.from("b"));
  assert(parts(usize(2)) == String.from("c"));
});
test("String split with no separator found", {
  s := String.from("Hello");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(1));
  assert(parts(usize(0)) == String.from("Hello"));
});
test("String split empty string", {
  s := String.from("");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(1));
  assert(parts(usize(0)).is_empty());
});
test("String split with separator at beginning", {
  s := String.from(",Hello,World");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)).is_empty());
  assert(parts(usize(1)) == String.from("Hello"));
  assert(parts(usize(2)) == String.from("World"));
});
test("String split with separator at end", {
  s := String.from("Hello,World,");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)) == String.from("Hello"));
  assert(parts(usize(1)) == String.from("World"));
  assert(parts(usize(2)).is_empty());
});
test("String split consecutive separators", {
  s := String.from("Hello,,World");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)) == String.from("Hello"));
  assert(parts(usize(1)).is_empty());
  assert(parts(usize(2)) == String.from("World"));
});
test("String split UTF-8 by ASCII separator", {
  s := String.from("你好,世界");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(2));
  assert(parts(usize(0)) == String.from("你好"));
  assert(parts(usize(1)) == String.from("世界"));
});
test("String split UTF-8 by UTF-8 separator", {
  s := String.from("你好|世界|测试");
  parts := s.split(String.from("|"));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)) == String.from("你好"));
  assert(parts(usize(1)) == String.from("世界"));
  assert(parts(usize(2)) == String.from("测试"));
});
test("String split UTF-8 characters into individual chars", {
  s := String.from("你好");
  parts := s.split(String.from(""));
  assert(parts.len() == usize(2));
  assert(parts(usize(0)) == String.from("你"));
  assert(parts(usize(1)) == String.from("好"));
});
test("String split emojis by space", {
  s := String.from("😀 😁 😂");
  parts := s.split(String.from(" "));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)) == String.from("😀"));
  assert(parts(usize(1)) == String.from("😁"));
  assert(parts(usize(2)) == String.from("😂"));
});
test("String split emojis into individual characters", {
  s := String.from("😀😁");
  parts := s.split(String.from(""));
  assert(parts.len() == usize(2));
  assert(parts(usize(0)) == String.from("😀"));
  assert(parts(usize(1)) == String.from("😁"));
});
test("String split by multi-character separator", {
  s := String.from("Hello::World::Test");
  parts := s.split(String.from("::"));
  assert(parts.len() == usize(3));
  assert(parts(usize(0)) == String.from("Hello"));
  assert(parts(usize(1)) == String.from("World"));
  assert(parts(usize(2)) == String.from("Test"));
});
test("String split single character", {
  s := String.from("A");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(1));
  assert(parts(usize(0)) == String.from("A"));
});
test("String split only separator", {
  s := String.from(",");
  parts := s.split(String.from(","));
  assert(parts.len() == usize(2));
  assert(parts(usize(0)).is_empty());
  assert(parts(usize(1)).is_empty());
});
// ===== index_of with from_index Tests =====
test("String index_of with from_index at start", {
  s := String.from("hello world hello");
  result := s.index_of(String.from("hello"), usize(0));
  assert(result.is_some());
  assert(result.unwrap() == usize(0));
});
test("String index_of with from_index finds second occurrence", {
  s := String.from("hello world hello");
  result := s.index_of(String.from("hello"), usize(1));
  assert(result.is_some());
  assert(result.unwrap() == usize(12));
});
test("String index_of with from_index skips first match", {
  s := String.from("abc abc abc");
  result := s.index_of(String.from("abc"), usize(5));
  assert(result.is_some());
  assert(result.unwrap() == usize(8));
});
test("String index_of with from_index beyond string", {
  s := String.from("hello");
  result := s.index_of(String.from("hello"), usize(10));
  assert(result.is_none());
});
test("String index_of with from_index UTF-8", {
  // 你@0 好@3 世@6 界@9 你@12 好@15 — 18 bytes.
  s := String.from("你好世界你好");
  result1 := s.index_of(String.from("你好"), usize(0));
  assert(result1.is_some());
  assert(result1.unwrap() == usize(0));
  // `from_index` is a BYTE offset, and it need not be a rune boundary:
  // a valid-UTF-8 needle can never match starting inside a rune, so
  // starting the scan at byte 1 skips the match at 0 and finds the one at 12.
  result2 := s.index_of(String.from("你好"), usize(1));
  assert(result2.is_some());
  assert(result2.unwrap() == usize(12));
});
// ===== last_index_of Tests =====
test("String last_index_of finds last occurrence", {
  s := String.from("hello world hello");
  result := s.last_index_of(String.from("hello"));
  assert(result.is_some());
  assert(result.unwrap() == usize(12));
});
test("String last_index_of single occurrence", {
  s := String.from("hello world");
  result := s.last_index_of(String.from("world"));
  assert(result.is_some());
  assert(result.unwrap() == usize(6));
});
test("String last_index_of not found", {
  s := String.from("hello world");
  result := s.last_index_of(String.from("xyz"));
  assert(result.is_none());
});
test("String last_index_of empty string", {
  s := String.from("hello");
  result := s.last_index_of(String.from(""));
  assert(result.is_some());
  assert(result.unwrap() == s.len());
});
test("String last_index_of at end", {
  s := String.from("test");
  result := s.last_index_of(String.from("st"));
  assert(result.is_some());
  assert(result.unwrap() == usize(2));
});
test("String last_index_of UTF-8", {
  s := String.from("你好世界你好");
  result := s.last_index_of(String.from("你好"));
  assert(result.is_some());
  assert(result.unwrap() == usize(12));
  // Capping the start at byte 11 excludes the last occurrence and finds the
  // first one instead.
  capped := s.last_index_of(String.from("你好"), usize(11));
  assert(capped.is_some());
  assert(capped.unwrap() == usize(0));
});
test("String last_index_of multiple same characters", {
  s := String.from("aaaa");
  result := s.last_index_of(String.from("a"));
  assert(result.is_some());
  assert(result.unwrap() == usize(3));
});
// ===== starts_with Tests =====
test("String starts_with true", {
  s := String.from("Hello, World!");
  assert(s.starts_with(String.from("Hello")));
  assert(s.starts_with(String.from("Hello,")));
  assert(s.starts_with(String.from("H")));
});
test("String starts_with false", {
  s := String.from("Hello, World!");
  assert(not(s.starts_with(String.from("World"))));
  assert(not(s.starts_with(String.from("hello"))));
  assert(not(s.starts_with(String.from("X"))));
});
test("String starts_with empty string", {
  s := String.from("Hello");
  assert(s.starts_with(String.from("")));
});
test("String starts_with entire string", {
  s := String.from("Hello");
  assert(s.starts_with(String.from("Hello")));
});
test("String starts_with longer than string", {
  s := String.from("Hi");
  assert(not(s.starts_with(String.from("Hello"))));
});
test("String starts_with UTF-8", {
  s := String.from("你好世界");
  assert(s.starts_with(String.from("你")));
  assert(s.starts_with(String.from("你好")));
  assert(not(s.starts_with(String.from("世界"))));
});
test("String starts_with emoji", {
  s := String.from("😀😁😂");
  assert(s.starts_with(String.from("😀")));
  assert(s.starts_with(String.from("😀😁")));
  assert(not(s.starts_with(String.from("😁"))));
});
// ===== ends_with Tests =====
test("String ends_with true", {
  s := String.from("Hello, World!");
  assert(s.ends_with(String.from("World!")));
  assert(s.ends_with(String.from("!")));
  assert(s.ends_with(String.from("d!")));
});
test("String ends_with false", {
  s := String.from("Hello, World!");
  assert(not(s.ends_with(String.from("Hello"))));
  assert(not(s.ends_with(String.from("world!"))));
  assert(not(s.ends_with(String.from("X"))));
});
test("String ends_with empty string", {
  s := String.from("Hello");
  assert(s.ends_with(String.from("")));
});
test("String ends_with entire string", {
  s := String.from("Hello");
  assert(s.ends_with(String.from("Hello")));
});
test("String ends_with longer than string", {
  s := String.from("Hi");
  assert(not(s.ends_with(String.from("Hello"))));
});
test("String ends_with UTF-8", {
  s := String.from("你好世界");
  assert(s.ends_with(String.from("界")));
  assert(s.ends_with(String.from("世界")));
  assert(not(s.ends_with(String.from("你好"))));
});
test("String ends_with emoji", {
  s := String.from("😀😁😂");
  assert(s.ends_with(String.from("😂")));
  assert(s.ends_with(String.from("😁😂")));
  assert(not(s.ends_with(String.from("😀"))));
});
// ===== replace Tests =====
test("String replace replaces EVERY occurrence (D10)", {
  s := String.from("hello world hello");
  result := s.replace(String.from("hello"), String.from("hi"));
  assert(result == String.from("hi world hi"));
});
test("String replacen bounds the count", {
  s := String.from("a a a a");
  assert(s.replacen(String.from("a"), String.from("b"), usize(0)) == s, "count 0 changes nothing");
  assert(s.replacen(String.from("a"), String.from("b"), usize(1)) == String.from("b a a a"), "count 1");
  assert(s.replacen(String.from("a"), String.from("b"), usize(2)) == String.from("b b a a"), "count 2");
  assert(s.replacen(String.from("a"), String.from("b"), usize(9)) == String.from("b b b b"), "count past the end");
});
test("String replace_first is the pre-D10 replace", {
  s := String.from("hello world hello");
  result := s.replace_first(String.from("hello"), String.from("hi"));
  assert(result == String.from("hi world hello"));
});
test("String replace only occurrence", {
  s := String.from("hello world");
  result := s.replace(String.from("world"), String.from("universe"));
  assert(result == String.from("hello universe"));
});
// Regression: `replace` with a needle LONGER than the haystack used to
// compute `self_bytes - search_bytes` on usize as the loop bound — the
// subtraction underflowed and the scan ran ~2^64 iterations (an
// effective hang; found via the module-global registry's
// `"test".replace("file://", "")` canonicalization).
test("String replace with needle longer than the string", {
  s := String.from("test");
  result := s.replace(String.from("file://"), String.from(""));
  assert(result == s, "needle longer than haystack: unchanged, no hang");
});

test("String replace not found", {
  s := String.from("hello world");
  result := s.replace(String.from("xyz"), String.from("abc"));
  assert(result == s);
});
test("String replace with an empty search interleaves", {
  s := String.from("hello");
  result := s.replace(String.from(""), String.from("X"));
  // Rust: "hello".replace("", "X") == "XhXeXlXlXoX"
  assert(result == String.from("XhXeXlXlXoX"));
  // The bounded form still just prepends.
  assert(s.replacen(String.from(""), String.from("X"), usize(1)) == String.from("Xhello"));
});
test("String replace with empty string", {
  s := String.from("hello world");
  result := s.replace(String.from("hello "), String.from(""));
  assert(result == String.from("world"));
});
test("String replace UTF-8", {
  s := String.from("你好世界你好");
  result := s.replace(String.from("你好"), String.from("再见"));
  assert(result == String.from("再见世界再见"));
});
test("String replace emoji", {
  s := String.from("😀😁😀");
  result := s.replace(String.from("😀"), String.from("😂"));
  assert(result == String.from("😂😁😂"));
});
test("String replace at beginning", {
  s := String.from("hello world");
  result := s.replace(String.from("hello"), String.from("goodbye"));
  assert(result == String.from("goodbye world"));
});
test("String replace at end", {
  s := String.from("hello world");
  result := s.replace(String.from("world"), String.from("universe"));
  assert(result == String.from("hello universe"));
});
