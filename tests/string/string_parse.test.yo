{ assert } :: import("std/assert");
open(import("std/string"));
// === parse_i32 tests ===
test("String parse_i32 positive", {
  s := `42`;
  result := s.parse_i32();
  assert(result.is_some(), "should parse 42");
  assert(result.unwrap() == i32(42), "should be 42");
});
test("String parse_i32 negative", {
  s := `-123`;
  result := s.parse_i32();
  assert(result.is_some(), "should parse -123");
  assert(result.unwrap() == i32(-123), "should be -123");
});
test("String parse_i32 zero", {
  s := `0`;
  result := s.parse_i32();
  assert(result.is_some(), "should parse 0");
  assert(result.unwrap() == i32(0), "should be 0");
});
test("String parse_i32 invalid", {
  s := `hello`;
  result := s.parse_i32();
  assert(result.is_none(), "should fail on non-numeric");
});
test("String parse_i32 empty", {
  s := ``;
  result := s.parse_i32();
  assert(result.is_none(), "should fail on empty");
});
test("String parse_i32 plus sign", {
  s := `+99`;
  result := s.parse_i32();
  assert(result.is_some(), "should parse +99");
  assert(result.unwrap() == i32(99), "should be 99");
});
test("String parse_i32 only sign", {
  s := `-`;
  result := s.parse_i32();
  assert(result.is_none(), "should fail on bare sign");
});
test("String parse_i32 mixed chars", {
  s := `12abc`;
  result := s.parse_i32();
  assert(result.is_none(), "should fail on mixed");
});
// === parse_i64 tests ===
test("String parse_i64 positive", {
  s := `1000000`;
  result := s.parse_i64();
  assert(result.is_some(), "should parse 1000000");
  assert(result.unwrap() == i64(1000000), "should be 1000000");
});
test("String parse_i64 negative", {
  s := `-9876543`;
  result := s.parse_i64();
  assert(result.is_some(), "should parse -9876543");
  assert(result.unwrap() == i64(-9876543), "should be -9876543");
});
test("String parse_i64 zero", {
  s := `0`;
  result := s.parse_i64();
  assert(result.is_some(), "should parse 0");
  assert(result.unwrap() == i64(0), "should be 0");
});
test("String parse_i64 invalid", {
  s := `not_a_number`;
  result := s.parse_i64();
  assert(result.is_none(), "should fail on non-numeric");
});
test("String parse_i64 empty", {
  s := ``;
  result := s.parse_i64();
  assert(result.is_none(), "should fail on empty");
});
