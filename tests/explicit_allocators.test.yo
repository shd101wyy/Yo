//! Reference-counted objects placed by an explicit allocator
//! (`plans/archive/EXPLICIT_ALLOCATORS.md` P3): `with_allocator(a, f)` makes `a` the
//! thread's current allocator while `f` runs, every user-visible RC object
//! created there comes from `a`, and its release is routed back to `a`. Also
//! the `Allocator` vtable surface itself (P0): the owner prefix, the global
//! allocator's value, and an `Allocator` value shared across threads.
//!
//! The counting allocator below is a user-written `Allocator` implementor: it
//! forwards to the global allocator and keeps totals, which is what freezes
//! the vtable's shape against a user-written implementation and lets every
//! test see where a placed block lives and that its release came back.
pragma(Pragma.SkipWasm32Wasi); // the threaded cases need pthreads
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ GlobalAllocator, with_allocator } :: import("std/allocator");
{ Thread } :: import("std/thread");
{ yield } :: import("std/async");
{ AtomicBool, AtomicUsize, MemoryOrder } :: import("std/sync/atomic");
Gc :: import("std/gc");
{ HashMap } :: import("std/collections/hash_map");
{ String } :: import("std/string");
// --- the counting allocator -------------------------------------------------
// `live` is the number of blocks it holds right now. Single-threaded: a test
// that shares an allocator across threads uses `_SHARED_VTABLE` below.
_Counts :: struct(live : usize, allocs : usize, frees : usize, reallocs : usize, bytes : usize);
derive(_Counts, Copy, Clone);
_count_alloc :: (fn(ctx : ?*void, size : usize) -> ?*void)({
  c := (*_Counts)(ctx.unwrap());
  unsafe(c.*.allocs = (c.*.allocs + usize(1)));
  unsafe(c.*.live = (c.*.live + usize(1)));
  unsafe(c.*.bytes = (c.*.bytes + size));
  GlobalAllocator.malloc(size)
});
_count_realloc :: (fn(ctx : ?*void, ptr : ?*void, new_size : usize) -> ?*void)({
  c := (*_Counts)(ctx.unwrap());
  unsafe(c.*.reallocs = (c.*.reallocs + usize(1)));
  cond(
    ptr.is_none() => {
      unsafe(c.*.live = (c.*.live + usize(1)));
    },
    true => ()
  );
  GlobalAllocator.realloc(ptr, new_size)
});
_count_free :: (fn(ctx : ?*void, ptr : ?*void) -> unit)({
  c := (*_Counts)(ctx.unwrap());
  unsafe(c.*.frees = (c.*.frees + usize(1)));
  cond(
    ptr.is_some() => {
      unsafe(c.*.live = (c.*.live - usize(1)));
    },
    true => ()
  );
  GlobalAllocator.free(ptr);
});
_COUNT_VTABLE := AllocatorVTable(alloc : _count_alloc, realloc : _count_realloc, free : _count_free);
_counts :: (fn() -> _Counts)(_Counts(live : usize(0), allocs : usize(0), frees : usize(0), reallocs : usize(0), bytes : usize(0)));
// An `Allocator` over `c`, which must outlive every block it hands out.
_counting :: (fn(c : *_Counts) -> Allocator)(Allocator(ctx : .Some((*void)(c)), vtable : addr_of(_COUNT_VTABLE)));
_Point :: ref(struct(x : i32, y : i32));
_Shape :: ref(enum(Circle(r : i32), Square(side : i32)));
_Node :: ref(struct(value : i32, next : Option(Self)));
_Speak :: trait(speak : (fn(self : &Self) -> i32));
_Dog :: struct(volume : i32);
derive(_Dog, Copy, Clone);
impl(_Dog, _Speak(speak : (fn(self : Self) -> i32)(self.volume)));
_make_speaker :: (fn() -> Dyn(_Speak))(dyn(_Dog(volume : i32(6))));
test("A ref struct constructed in the scope comes from the scope's allocator", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  {
    p := with_allocator(heap, () => _Point(x : i32(3), y : i32(4)));
    assert(counts.live == usize(1), `one block: ${counts.live}`);
    assert((p.x + p.y) == i32(7), "fields");
    assert(ref_count(p) == usize(1), "ref_count() never reports the allocator tag");
    // A second OWNER (a local alias of `p` is a borrow and adds no count).
    holder := ArrayList(_Point).new();
    holder.push(p);
    assert(ref_count(p) == usize(2), "the count still counts");
  };
  assert(counts.live == usize(0), "the last drop released it into its allocator");
});
test("Objects created outside the scope stay on the global allocator", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  before := _Point(x : i32(1), y : i32(1));
  inside := with_allocator(heap, () => _Point(x : i32(2), y : i32(2)));
  after := _Point(x : i32(3), y : i32(3));
  assert(counts.live == usize(1), "only the scoped object");
});
test("ref enum variants, box, arc and dyn boxes are placed by the scope", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  {
    s := with_allocator(heap, () => _Shape.Square(side : i32(5)));
    assert(counts.live == usize(1), "enum variant");
    b := with_allocator(heap, () => rc(i32(9)));
    assert(b.* == i32(9), "box value");
    assert(counts.live == usize(2), "box");
    a := with_allocator(heap, () => arc(i32(11)));
    assert(counts.live == usize(3), "arc (atomic RC)");
    flag := with_allocator(heap, () => AtomicBool.new(true));
    assert(flag.load(MemoryOrder.Acquire), "atomic value");
    assert(counts.live == usize(4), "an atomic ref struct");
    d := with_allocator(heap, () => _make_speaker());
    assert(d.speak() == i32(6), "dyn dispatch");
    assert(counts.live == usize(5), "dyn box");
  };
  assert(counts.live == usize(0), "every kind routed its release back");
});
_make_cycle :: (fn() -> unit)({
  a := _Node(value : i32(1), next : .None);
  b := _Node(value : i32(2), next : .Some(a));
  a.next = .Some(b);
});
test("A cycle built in the scope is collected into its allocator", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  with_allocator(heap, () => _make_cycle());
  assert(counts.live == usize(2), "the cycle keeps both nodes");
  Gc.collect();
  assert(counts.live == usize(0), `the collector freed them into its allocator: ${counts.live}`);
});
// An `Rc` cell placed by `rc`'s explicit `alloc` closes the cycle: the
// collector, not a drop, releases it, and it goes back to the allocator.
_RcCons :: ref(
  enum(
    Nil,
    Cons(head : i32, tail : Rc(Self))
  )
);
_make_rc_cycle :: (fn(a : Allocator) -> unit)({
  c := _RcCons.Cons(i32(1), rc(_RcCons.Nil, alloc : .Some(a)));
  c.tail = rc(c, alloc : .Some(a));
});
test("A cycle closed through an Rc that rc's alloc placed is collected into its allocator", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  _make_rc_cycle(heap);
  assert(counts.live == usize(1), `the cycle keeps its Rc cell; the replaced tail went back: ${counts.live}`);
  Gc.collect();
  assert(counts.live == usize(0), `the collector freed it into its allocator: ${counts.live}`);
});
test("Nested scopes restore the outer allocator", {
  outer_counts := _counts();
  outer := _counting(addr_of(outer_counts));
  inner_counts := _counts();
  inner := _counting(addr_of(inner_counts));
  pair := with_allocator(outer, () => {
    a := _Point(x : i32(1), y : i32(0));
    b := with_allocator(inner, () => _Point(x : i32(2), y : i32(0)));
    c := _Point(x : i32(3), y : i32(0));
    (a, b, c)
  });
  assert(outer_counts.live == usize(2), `outer holds a and c: ${outer_counts.live}`);
  assert(inner_counts.live == usize(1), "inner holds b");
  after := _Point(x : i32(4), y : i32(0));
  assert(outer_counts.live == usize(2), "the scope ended with the call");
});
test("A spawned thread does not inherit the scope", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  with_allocator(heap, () => {
    t := Thread(unit).spawn(io => {
      p := _Point(x : i32(1), y : i32(2));
      assert(p.x == i32(1), "value");
    });
    t.join();
  });
  assert(counts.live == usize(0), "the worker allocated on the global allocator");
});
test("A task keeps its scope across a suspension", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  task := with_allocator(heap, 
    () => io.async((io : Io) => {
      io.await(yield(io), io);
      // Resumed from the event loop, after `scoped` has returned.
      _Point(x : i32(8), y : i32(9))
    })
  );
  outside := _Point(x : i32(0), y : i32(0));
  assert(counts.live == usize(1), `the task's state machine: ${counts.live}`);
  p := io.await(task, io);
  assert(p.x == i32(8), "result");
  // The point the task built after resuming is the allocator's; the runtime's
  // own `yield` future is not (Rule 2). The task's state machine was the
  // allocator's too, and the await released it: it consumed the task (§3.13 A1).
  assert(counts.live == usize(1), `post-await point: ${counts.live}`);
});
// One state-machine type for both allocators: the per-type task pool
// (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 7) is shared between them.
_pooled_task :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    i32(3)
  })
);
test("A task an explicit allocator placed goes back to it, never to the task pool", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  r := {
    task := with_allocator(heap, () => _pooled_task(io));
    io.await(task, io)
  };
  assert(r == i32(3), "result");
  assert(counts.live == usize(0), `the released task went back to the allocator: ${counts.live}`);
});
test("A task created in a scope never takes a pooled global block", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  // A global task of the same type, released: its block may now sit in the pool.
  g := {
    task := _pooled_task(io);
    io.await(task, io)
  };
  task := with_allocator(heap, () => _pooled_task(io));
  assert(counts.live == usize(1), `the scoped task is the allocator's: ${counts.live}`);
  assert((io.await(task, io) + g) == i32(6), "results");
});
test("An unwind handled inside the scope keeps the scope, and the scope ends with the call", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  Raise :: (ctl(code : i32) -> i32);
  body :: (fn() -> i32)({
    (raise : Raise) = (
      code -> {
        unwind(code * i32(10));
      }
    );
    kept := _Point(x : i32(1), y : i32(1));
    raise(i32(4))
  });
  n := with_allocator(heap, () => body());
  assert(n == i32(40), "the handler's value");
  after := _Point(x : i32(2), y : i32(2));
  assert(counts.live == usize(0), `the body's objects died in the allocator and the scope ended: ${counts.live}`);
});
test("with_allocator takes any Allocator value", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  p := with_allocator(heap, () => _Point(x : i32(5), y : i32(6)));
  assert(counts.live == usize(1), "placed");
  g := with_allocator(Allocator.global(), () => _Point(x : i32(7), y : i32(8)));
  assert(counts.live == usize(1), "the global Allocator value places globally-routed blocks");
});
// ===== P3c: the core containers' default constructors follow the scope =====
test("A default ArrayList created in the scope keeps growing in its allocator after it", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  {
    list := with_allocator(heap, () => ArrayList(i32).new());
    assert(list.allocator().is_some(), "new() inside the scope is new_in(scope)");
    mut(i) := i32(0);
    while(runtime(i < i32(500)), {
      list.push(i);
      i = (i + i32(1));
    });
    assert(list.allocator().unwrap().same(heap), "growth outside the scope stays in the allocator");
    outside := ArrayList(i32).new();
    outside.push(i32(1));
    assert(outside.allocator().is_none(), "a list created outside is global");
  };
  assert(counts.live == usize(0), `released: ${counts.live}`);
});
test("A default HashMap and a String built in the scope are placed there", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  {
    m := with_allocator(heap, () => {
      acc := HashMap(i32, i32).new();
      acc.insert(i32(1), i32(10));
      acc
    });
    assert(m.allocator().is_some(), "the map's tables");
    s := with_allocator(heap, () => `joined ${i32(7)} ${String.from("words")}`);
    assert(s == `joined 7 words`, "string contents");
    assert(counts.live > usize(2), "the map object, its tables and the string's bytes");
  };
  assert(counts.live == usize(0), `released: ${counts.live}`);
});
// ===== The Allocator vtable surface (P0; moved from the deleted tests/arena.test.yo) =====
test("A counting allocator sees every block it owns, prefix included", {
  counts := _counts();
  a := _counting(addr_of(counts));
  p := a.alloc(usize(10));
  q := a.alloc(usize(20));
  assert(counts.allocs == usize(2), "two allocations");
  // Each request carries the 16-byte owner prefix.
  assert(counts.bytes == usize(62), `bytes: ${counts.bytes}`);
  r := Allocator.realloc(q.unwrap(), usize(500));
  assert(r.is_some(), "realloc succeeds");
  assert(counts.reallocs == usize(1), "one realloc");
  assert(Allocator.owner_of(r.unwrap()).same(a), "the owner survives a realloc");
  Allocator.free(p);
  Allocator.free(r);
  assert(counts.frees == usize(2), "balanced");
  Allocator.free(.None);
  assert(counts.frees == usize(2), "freeing .None is a no-op");
});
test("The owner prefix is ctx then vtable, 16 bytes before the block", {
  counts := _counts();
  a := _counting(addr_of(counts));
  p := (*u8)(a.alloc(usize(8)).unwrap());
  // SAFETY: every Allocator.alloc block is preceded by its 16-byte prefix:
  // `ctx` at offset 0, `vtable` at `sizeof(*void)` (4 on wasm32, not 8).
  prefix := p.sub(usize(16));
  word0 := unsafe((*?*void)(prefix).*);
  word1 := unsafe((**AllocatorVTable)(prefix.add(size_of(*void))).*);
  assert(word0 == a.ctx, "prefix word 0 is ctx");
  assert(word1 == a.vtable, "prefix word 1 is the vtable");
  Allocator.free(.Some((*void)(p)));
  assert(counts.live == usize(0), "the free was routed back through the prefix");
});
test("Allocator.global round-trips and owns its blocks", {
  g := Allocator.global();
  assert(g.same(Allocator.global()), "one global allocator");
  p := g.alloc(usize(64));
  assert(p.is_some(), "alloc");
  q := Allocator.realloc(p.unwrap(), usize(1 << 16));
  assert(q.is_some(), "realloc");
  assert(Allocator.owner_of(q.unwrap()).same(g), "owner");
  Allocator.free(q);
});
// A thread-safe counter for the allocator two threads share: the counting
// allocator above is not.
_SHARED_LIVE := AtomicUsize.new(usize(0));
_shared_alloc :: (fn(ctx : ?*void, size : usize) -> ?*void)({
  _SHARED_LIVE.fetch_add(usize(1), MemoryOrder.AcqRel);
  GlobalAllocator.malloc(size)
});
_shared_realloc :: (fn(ctx : ?*void, ptr : ?*void, new_size : usize) -> ?*void)({
  cond(
    ptr.is_none() => {
      _SHARED_LIVE.fetch_add(usize(1), MemoryOrder.AcqRel);
    },
    true => ()
  );
  GlobalAllocator.realloc(ptr, new_size)
});
_shared_free :: (fn(ctx : ?*void, ptr : ?*void) -> unit)({
  cond(
    ptr.is_some() => {
      _SHARED_LIVE.fetch_sub(usize(1), MemoryOrder.AcqRel);
    },
    true => ()
  );
  GlobalAllocator.free(ptr);
});
_SHARED_VTABLE := AllocatorVTable(alloc : _shared_alloc, realloc : _shared_realloc, free : _shared_free);
// Allocate and free 500 blocks through `a`.
_churn :: (fn(a : Allocator) -> unit)({
  blocks := ArrayList(*void).new();
  mut(k) := usize(0);
  while(runtime(k < usize(500)), {
    blocks.push(a.alloc(usize(24)).unwrap());
    k = (k + usize(1));
  });
  for(blocks, b => Allocator.free(.Some(b)));
});
test("An Allocator value crosses threads and every release comes back to it", {
  a := Allocator(ctx : .None, vtable : addr_of(_SHARED_VTABLE));
  t1 := Thread(unit).spawn(io => _churn(a));
  t2 := Thread(unit).spawn(io => _churn(a));
  t1.join();
  t2.join();
  assert(_SHARED_LIVE.load(MemoryOrder.Acquire) == usize(0), `live after both workers: ${_SHARED_LIVE.load(MemoryOrder.Acquire)}`);
  g := Allocator.global();
  t3 := Thread(unit).spawn(io => _churn(g));
  t3.join();
});
