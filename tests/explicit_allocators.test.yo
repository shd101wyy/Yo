//! Reference-counted objects placed by an explicit allocator
//! (`plans/EXPLICIT_ALLOCATORS.md` P3): `with_allocator(a, f)` makes `a` the
//! thread's current allocator while `f` runs, every user-visible RC object
//! created there comes from `a`, and its release is routed back to `a`.
pragma(Pragma.SkipWasm32Wasi); // the threaded cases need pthreads
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ Allocator, with_allocator } :: import("std/allocator");
{ Arena } :: import("std/arena");
{ Thread } :: import("std/thread");
{ yield } :: import("std/async");
{ AtomicBool, MemoryOrder } :: import("std/sync/atomic");
Gc :: import("std/gc");
_Point :: ref(struct(x : i32, y : i32));
_Shape :: ref(enum(Circle(r : i32), Square(side : i32)));
_Node :: ref(struct(value : i32, next : Option(Self)));
_Speak :: trait(speak : (fn(self : Self) -> i32));
_Dog :: struct(volume : i32);
impl(_Dog, _Speak(speak : (fn(self : Self) -> i32)(self.volume)));
_arena :: (fn() -> Arena)(Arena.new(usize(1) << usize(20)));
_make_speaker :: (fn() -> Dyn(_Speak))(dyn(_Dog(volume : i32(6))));
test("A ref struct constructed in the scope comes from the arena", {
  arena := _arena();
  {
    p := arena.scoped(() => _Point(x : i32(3), y : i32(4)));
    assert(arena.live_blocks() == usize(1), `one block: ${arena.live_blocks()}`);
    assert((p.x + p.y) == i32(7), "fields");
    assert(rc(p) == usize(1), "rc() never reports the allocator tag");
    q := p;
    assert(rc(p) == usize(2), "the count still counts");
  };
  assert(arena.live_blocks() == usize(0), "the last drop released it into the arena");
});
test("Objects created outside the scope stay on the global allocator", {
  arena := _arena();
  before := _Point(x : i32(1), y : i32(1));
  inside := arena.scoped(() => _Point(x : i32(2), y : i32(2)));
  after := _Point(x : i32(3), y : i32(3));
  assert(arena.live_blocks() == usize(1), "only the scoped object");
});
test("ref enum variants, box, arc and dyn boxes are placed by the scope", {
  arena := _arena();
  {
    s := arena.scoped(() => _Shape.Square(side : i32(5)));
    assert(arena.live_blocks() == usize(1), "enum variant");
    b := arena.scoped(() => box(i32(9)));
    assert(b.* == i32(9), "box value");
    assert(arena.live_blocks() == usize(2), "box");
    a := arena.scoped(() => arc(i32(11)));
    assert(arena.live_blocks() == usize(3), "arc (atomic RC)");
    flag := arena.scoped(() => AtomicBool.new(true));
    assert(flag.load(MemoryOrder.Acquire), "atomic value");
    assert(arena.live_blocks() == usize(4), "an atomic ref struct");
    d := arena.scoped(() => _make_speaker());
    assert(d.speak() == i32(6), "dyn dispatch");
    assert(arena.live_blocks() == usize(5), "dyn box");
  };
  assert(arena.live_blocks() == usize(0), "every kind routed its release back");
});
test("An Iso built in the scope is released into the arena on another thread", {
  arena := _arena();
  iso := arena.scoped(() => Iso(Box(i32))(box(i32(21))));
  assert(arena.live_blocks() == usize(2), `the Iso and its payload: ${arena.live_blocks()}`);
  t := Thread(unit).spawn(io => {
    v := iso.extract();
    assert(v.* == i32(21), "payload");
  });
  t.join();
  assert(arena.live_blocks() == usize(0), `released on the worker: ${arena.live_blocks()}`);
});
_make_cycle :: (fn() -> unit)({
  a := _Node(value : i32(1), next : .None);
  b := _Node(value : i32(2), next : .Some(a));
  a.next = .Some(b);
});
test("A cycle built in the scope is collected into the arena", {
  arena := _arena();
  arena.scoped(() => _make_cycle());
  assert(arena.live_blocks() == usize(2), "the cycle keeps both nodes");
  Gc.collect();
  assert(arena.live_blocks() == usize(0), `the collector freed them into the arena: ${arena.live_blocks()}`);
});
test("Nested scopes restore the outer allocator", {
  outer := _arena();
  inner := _arena();
  pair := outer.scoped(() => {
    a := _Point(x : i32(1), y : i32(0));
    b := inner.scoped(() => _Point(x : i32(2), y : i32(0)));
    c := _Point(x : i32(3), y : i32(0));
    (a, b, c)
  });
  assert(outer.live_blocks() == usize(2), `outer holds a and c: ${outer.live_blocks()}`);
  assert(inner.live_blocks() == usize(1), "inner holds b");
  after := _Point(x : i32(4), y : i32(0));
  assert(outer.live_blocks() == usize(2), "the scope ended with the call");
});
test("A spawned thread does not inherit the scope", {
  arena := _arena();
  arena.scoped(() => {
    t := Thread(unit).spawn(io => {
      p := _Point(x : i32(1), y : i32(2));
      assert(p.x == i32(1), "value");
    });
    t.join();
  });
  assert(arena.live_blocks() == usize(0), "the worker allocated on the global allocator");
});
test("A task keeps its scope across a suspension", {
  arena := _arena();
  task := arena.scoped(
    () => io.async((io : Io) => {
      io.await(yield(io), io);
      // Resumed from the event loop, after `scoped` has returned.
      _Point(x : i32(8), y : i32(9))
    })
  );
  outside := _Point(x : i32(0), y : i32(0));
  p := io.await(task, io);
  assert(p.x == i32(8), "result");
  // The task's state machine and the point it built after resuming are the
  // arena's; the runtime's own `yield` future is not (Rule 2).
  assert(arena.live_blocks() == usize(2), `task + post-await point: ${arena.live_blocks()}`);
});
test("An unwind handled inside the scope keeps the scope, and the scope ends with the call", {
  arena := _arena();
  Raise :: (ctl(code : i32) -> i32);
  body :: (fn() -> i32)({
    (raise : Raise) = (
      code -> {
        unwind(code * i32(10));
      }
    );
    kept := _Point(x : i32(1), y : i32(1));
    raise(i32(4))
  });
  n := arena.scoped(() => body());
  assert(n == i32(40), "the handler's value");
  after := _Point(x : i32(2), y : i32(2));
  assert(arena.live_blocks() == usize(0), `the body's objects died in the arena and the scope ended: ${arena.live_blocks()}`);
});
test("with_allocator takes any Allocator value", {
  arena := _arena();
  p := with_allocator(arena.allocator(), () => _Point(x : i32(5), y : i32(6)));
  assert(arena.live_blocks() == usize(1), "placed");
  g := with_allocator(Allocator.global(), () => _Point(x : i32(7), y : i32(8)));
  assert(arena.live_blocks() == usize(1), "the global Allocator value places globally-routed blocks");
});
