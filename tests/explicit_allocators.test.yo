//! Reference-counted objects placed by an explicit allocator
//! (`plans/archive/EXPLICIT_ALLOCATORS.md` P3): `with_allocator(a, f)` makes `a` the
//! thread's current allocator while `f` runs, every user-visible RC object
//! created there comes from `a`, and its release is routed back to `a`.
pragma(Pragma.SkipWasm32Wasi); // the threaded cases need pthreads
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ with_allocator, GlobalAllocator } :: import("std/allocator");
{ memcpy } :: import("std/libc/string");
{ Arena } :: import("std/arena");
{ Thread } :: import("std/thread");
{ yield } :: import("std/async");
{ AtomicBool, MemoryOrder } :: import("std/sync/atomic");
Gc :: import("std/gc");
{ HashMap } :: import("std/collections/hash_map");
{ String } :: import("std/string");
_Point :: ref(struct(x : i32, y : i32));
_Shape :: ref(enum(Circle(r : i32), Square(side : i32)));
_Node :: ref(struct(value : i32, next : Option(Self)));
_Speak :: trait(speak : (fn(self : &Self) -> i32));
_Dog :: struct(volume : i32);
derive(_Dog, Copy, Clone);
impl(_Dog, _Speak(speak : (fn(self : Self) -> i32)(self.volume)));
_arena :: (fn() -> Arena)(Arena.new(usize(1) << usize(20)));
_make_speaker :: (fn() -> Dyn(_Speak))(dyn(_Dog(volume : i32(6))));
test("A ref struct constructed in the scope comes from the arena", {
  arena := _arena();
  {
    p := arena.scoped(() => _Point(x : i32(3), y : i32(4)));
    assert(arena.live_blocks() == usize(1), `one block: ${arena.live_blocks()}`);
    assert((p.x + p.y) == i32(7), "fields");
    assert(ref_count(p) == usize(1), "ref_count() never reports the allocator tag");
    // A second OWNER (a local alias of `p` is a borrow and adds no count).
    holder := ArrayList(_Point).new();
    holder.push(p);
    assert(ref_count(p) == usize(2), "the count still counts");
  };
  assert(arena.live_blocks() == usize(0), "the last drop released it into the arena");
});
test("Objects created outside the scope stay on the global allocator", {
  arena := _arena();
  before := _Point(x : i32(1), y : i32(1));
  inside := arena.scoped(() => _Point(x : i32(2), y : i32(2)));
  after := _Point(x : i32(3), y : i32(3));
  assert(arena.live_blocks() == usize(1), "only the scoped object");
});
test("ref enum variants, box, arc and dyn boxes are placed by the scope", {
  arena := _arena();
  {
    s := arena.scoped(() => _Shape.Square(side : i32(5)));
    assert(arena.live_blocks() == usize(1), "enum variant");
    b := arena.scoped(() => rc(i32(9)));
    assert(b.* == i32(9), "box value");
    assert(arena.live_blocks() == usize(2), "box");
    a := arena.scoped(() => arc(i32(11)));
    assert(arena.live_blocks() == usize(3), "arc (atomic RC)");
    flag := arena.scoped(() => AtomicBool.new(true));
    assert(flag.load(MemoryOrder.Acquire), "atomic value");
    assert(arena.live_blocks() == usize(4), "an atomic ref struct");
    d := arena.scoped(() => _make_speaker());
    assert(d.speak() == i32(6), "dyn dispatch");
    assert(arena.live_blocks() == usize(5), "dyn box");
  };
  assert(arena.live_blocks() == usize(0), "every kind routed its release back");
});
_make_cycle :: (fn() -> unit)({
  a := _Node(value : i32(1), next : .None);
  b := _Node(value : i32(2), next : .Some(a));
  a.next = .Some(b);
});
test("A cycle built in the scope is collected into the arena", {
  arena := _arena();
  arena.scoped(() => _make_cycle());
  assert(arena.live_blocks() == usize(2), "the cycle keeps both nodes");
  Gc.collect();
  assert(arena.live_blocks() == usize(0), `the collector freed them into the arena: ${arena.live_blocks()}`);
});
// An `Rc` cell placed by `rc`'s explicit `alloc` closes the cycle: the
// collector, not a drop, releases it, and it goes back to the arena.
_RcCons :: ref(
  enum(
    Nil,
    Cons(head : i32, tail : Rc(Self))
  )
);
_make_rc_cycle :: (fn(a : Allocator) -> unit)({
  c := _RcCons.Cons(i32(1), rc(_RcCons.Nil, alloc : .Some(a)));
  c.tail = rc(c, alloc : .Some(a));
});
test("A cycle closed through an Rc that rc's alloc placed is collected into the arena", {
  arena := _arena();
  _make_rc_cycle(arena.allocator());
  assert(arena.live_blocks() == usize(1), `the cycle keeps its Rc cell; the replaced tail went back: ${arena.live_blocks()}`);
  Gc.collect();
  assert(arena.live_blocks() == usize(0), `the collector freed it into the arena: ${arena.live_blocks()}`);
});
test("Nested scopes restore the outer allocator", {
  outer := _arena();
  inner := _arena();
  pair := outer.scoped(() => {
    a := _Point(x : i32(1), y : i32(0));
    b := inner.scoped(() => _Point(x : i32(2), y : i32(0)));
    c := _Point(x : i32(3), y : i32(0));
    (a, b, c)
  });
  assert(outer.live_blocks() == usize(2), `outer holds a and c: ${outer.live_blocks()}`);
  assert(inner.live_blocks() == usize(1), "inner holds b");
  after := _Point(x : i32(4), y : i32(0));
  assert(outer.live_blocks() == usize(2), "the scope ended with the call");
});
test("A spawned thread does not inherit the scope", {
  arena := _arena();
  arena.scoped(() => {
    t := Thread(unit).spawn(io => {
      p := _Point(x : i32(1), y : i32(2));
      assert(p.x == i32(1), "value");
    });
    t.join();
  });
  assert(arena.live_blocks() == usize(0), "the worker allocated on the global allocator");
});
test("A task keeps its scope across a suspension", {
  arena := _arena();
  task := arena.scoped(
    () => io.async((io : Io) => {
      io.await(yield(io), io);
      // Resumed from the event loop, after `scoped` has returned.
      _Point(x : i32(8), y : i32(9))
    })
  );
  outside := _Point(x : i32(0), y : i32(0));
  assert(arena.live_blocks() == usize(1), `the task's state machine: ${arena.live_blocks()}`);
  p := io.await(task, io);
  assert(p.x == i32(8), "result");
  // The point the task built after resuming is the arena's; the runtime's
  // own `yield` future is not (Rule 2). The task's state machine was the
  // arena's too, and the await released it: it consumed the task (§3.13 A1).
  assert(arena.live_blocks() == usize(1), `post-await point: ${arena.live_blocks()}`);
});
// One state-machine type for both allocators: the per-type task pool
// (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 7) is shared between them.
_pooled_task :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    i32(3)
  })
);
test("A task an explicit allocator placed goes back to it, never to the task pool", {
  arena := _arena();
  r := {
    task := arena.scoped(() => _pooled_task(io));
    io.await(task, io)
  };
  assert(r == i32(3), "result");
  assert(arena.live_blocks() == usize(0), `the released task went back to the arena: ${arena.live_blocks()}`);
});
test("A task created in a scope never takes a pooled global block", {
  arena := _arena();
  // A global task of the same type, released: its block may now sit in the pool.
  g := {
    task := _pooled_task(io);
    io.await(task, io)
  };
  task := arena.scoped(() => _pooled_task(io));
  assert(arena.live_blocks() == usize(1), `the scoped task is the arena's: ${arena.live_blocks()}`);
  assert((io.await(task, io) + g) == i32(6), "results");
});
test("An unwind handled inside the scope keeps the scope, and the scope ends with the call", {
  arena := _arena();
  Raise :: (ctl(code : i32) -> i32);
  body :: (fn() -> i32)({
    (raise : Raise) = (
      code -> {
        unwind(code * i32(10));
      }
    );
    kept := _Point(x : i32(1), y : i32(1));
    raise(i32(4))
  });
  n := arena.scoped(() => body());
  assert(n == i32(40), "the handler's value");
  after := _Point(x : i32(2), y : i32(2));
  assert(arena.live_blocks() == usize(0), `the body's objects died in the arena and the scope ended: ${arena.live_blocks()}`);
});
test("with_allocator takes any Allocator value", {
  arena := _arena();
  p := with_allocator(arena.allocator(), () => _Point(x : i32(5), y : i32(6)));
  assert(arena.live_blocks() == usize(1), "placed");
  g := with_allocator(Allocator.global(), () => _Point(x : i32(7), y : i32(8)));
  assert(arena.live_blocks() == usize(1), "the global Allocator value places globally-routed blocks");
});
// ===== P3c: the core containers' default constructors follow the scope =====
test("A default ArrayList created in the scope keeps growing in the arena after it", {
  arena := _arena();
  {
    list := arena.scoped(() => ArrayList(i32).new());
    assert(list.allocator().is_some(), "new() inside the scope is new_in(scope)");
    mut(i) := i32(0);
    while(runtime(i < i32(500)), {
      list.push(i);
      i = (i + i32(1));
    });
    assert(list.allocator().unwrap().same(arena.allocator()), "growth outside the scope stays in the arena");
    outside := ArrayList(i32).new();
    outside.push(i32(1));
    assert(outside.allocator().is_none(), "a list created outside is global");
  };
  assert(arena.live_blocks() == usize(0), `released: ${arena.live_blocks()}`);
});
test("A default HashMap and a String built in the scope are placed there", {
  arena := _arena();
  {
    m := arena.scoped(() => {
      acc := HashMap(i32, i32).new();
      acc.insert(i32(1), i32(10));
      acc
    });
    assert(m.allocator().is_some(), "the map's tables");
    s := arena.scoped(() => `joined ${i32(7)} ${String.from("words")}`);
    assert(s == `joined 7 words`, "string contents");
    assert(arena.live_blocks() > usize(2), "the map object, its tables and the string's bytes");
  };
  assert(arena.live_blocks() == usize(0), `released: ${arena.live_blocks()}`);
});
// ===== Allocator interface version 2: aligned blocks, a sized free =====
// A ledger allocator: every block it hands out is recorded with the size and
// alignment it was asked for, and `realloc`/`free` must be told exactly those.
// Its storage is raw global memory, never an RC object, so recording a block
// allocates nothing in the scope it serves.
_Rec :: struct(ptr : ?*void, size : usize, align : usize);
derive(_Rec, Copy, Clone);
_LEDGER_CAP :: usize(1024);
_Ledger :: struct(recs : ?*void, n : usize, live : usize, mismatches : usize, misaligned : usize, max_align : usize);
derive(_Ledger, Copy, Clone);
// A pointer's address, for alignment checks.
_addr :: (fn(p : ?*void) -> usize)({
  c := p;
  mut(w) := usize(0);
  unsafe(memcpy((*void)(addr_of(w)), (*void)(addr_of(c)), size_of(usize)));
  w
});
_rec_at :: (fn(l : *_Ledger, i : usize) -> *_Rec)(
  // SAFETY: `recs` holds `_LEDGER_CAP` records and `i` is below `n`.
  (*_Rec)(unsafe((*u8)(l.*.recs.unwrap()).add(i * size_of(_Rec))))
);
// The record of `ptr`, checked against `size` and `align`; .None (and a
// mismatch counted) when the ledger never handed `ptr` out.
_ledger_take :: (fn(l : *_Ledger, ptr : ?*void, size : usize, align : usize) -> unit)({
  mut(i) := usize(0);
  mut(found) := false;
  while(runtime(i < unsafe(l.*.n)) && !found, {
    r := _rec_at(l, i);
    if(unsafe(r.*.ptr) == ptr, {
      found = true;
      if((unsafe(r.*.size) != size) || (unsafe(r.*.align) != align), {
        unsafe(l.*.mismatches = (l.*.mismatches + usize(1)));
      });
      unsafe(r.*.ptr = .None);
      unsafe(l.*.live = (l.*.live - usize(1)));
    });
    i = (i + usize(1));
  });
  if(!found, {
    unsafe(l.*.mismatches = (l.*.mismatches + usize(1)));
  });
});
_ledger_put :: (fn(l : *_Ledger, p : ?*void, size : usize, align : usize) -> unit)({
  if((_addr(p) % align) != usize(0), {
    unsafe(l.*.misaligned = (l.*.misaligned + usize(1)));
  });
  if(align > unsafe(l.*.max_align), {
    unsafe(l.*.max_align = align);
  });
  assert(unsafe(l.*.n) < _LEDGER_CAP, "ledger full");
  unsafe(_rec_at(l, l.*.n).* = _Rec(ptr : p, size : size, align : align));
  unsafe(l.*.n = (l.*.n + usize(1)));
  unsafe(l.*.live = (l.*.live + usize(1)));
});
_ledger_alloc :: (fn(ctx : ?*void, size : usize, align : usize) -> ?*void)({
  l := (*_Ledger)(ctx.unwrap());
  p := GlobalAllocator.aligned_alloc(align, size);
  if(p.is_some(), _ledger_put(l, p, size, align));
  p
});
_ledger_realloc :: (fn(ctx : ?*void, ptr : ?*void, old_size : usize, new_size : usize, align : usize) -> ?*void)({
  l := (*_Ledger)(ctx.unwrap());
  q := GlobalAllocator.aligned_alloc(align, new_size);
  match(
    q,
    .Some(qp) => {
      n := cond((old_size < new_size) => old_size, true => new_size);
      // SAFETY: `ptr` holds `old_size` bytes (the ledger checks it), `qp`
      // `new_size`.
      unsafe(memcpy(qp, ptr.unwrap(), n));
      _ledger_take(l, ptr, old_size, align);
      GlobalAllocator.aligned_free(ptr);
      _ledger_put(l, q, new_size, align);
    },
    .None => ()
  );
  q
});
_ledger_free :: (fn(ctx : ?*void, ptr : ?*void, size : usize, align : usize) -> unit)({
  _ledger_take((*_Ledger)(ctx.unwrap()), ptr, size, align);
  GlobalAllocator.aligned_free(ptr);
});
_LEDGER_VTABLE := AllocatorVTable(alloc : _ledger_alloc, realloc : _ledger_realloc, free : _ledger_free);
_new_ledger :: (fn() -> _Ledger)(
  _Ledger(
    recs : GlobalAllocator.calloc(_LEDGER_CAP, size_of(_Rec)),
    n : usize(0),
    live : usize(0),
    mismatches : usize(0),
    misaligned : usize(0),
    max_align : usize(0)
  )
);
test("Every release tells the allocator the size and alignment the block was allocated with", {
  mut(ledger) := _new_ledger();
  a := Allocator(ctx : .Some((*void)(addr_of(ledger))), vtable : addr_of(_LEDGER_VTABLE));
  {
    p := with_allocator(a, () => _Point(x : i32(3), y : i32(4)));
    s := with_allocator(a, () => _Shape.Square(side : i32(5)));
    b := with_allocator(a, () => rc(i64(9)));
    bx := box(i32(2), alloc : .Some(a));
    d := with_allocator(a, () => _make_speaker());
    list := ArrayList(i64).new_in(a);
    mut(i) := i64(0);
    while(runtime(i < i64(300)), {
      list.push(i);
      i = (i + i64(1));
    });
    map := HashMap(i32, i32).new_in(a);
    mut(k) := i32(0);
    while(runtime(k < i32(100)), {
      map.insert(k, k * i32(2));
      k = (k + i32(1));
    });
    assert((p.x + p.y) == i32(7), "ref struct");
    assert(b.* == i64(9), "rc");
    assert(bx.* == i32(2), "box");
    assert(d.speak() == i32(6), "dyn");
    assert(list.get(usize(299)) == Option(i64).Some(i64(299)), "list");
    assert(map.get(i32(99)) == Option(i32).Some(i32(198)), "map");
    assert(ledger.live >= usize(7), `every kind placed in the ledger: ${ledger.live}`);
  };
  assert(ledger.live == usize(0), `every block went back: ${ledger.live} live`);
  assert(ledger.mismatches == usize(0), `every free and realloc was told the allocated size and alignment: ${ledger.mismatches}`);
  assert(ledger.misaligned == usize(0), "every block honours its alignment");
  GlobalAllocator.free(ledger.recs);
});
test("Allocator.alloc places an over-aligned block and keeps it aligned across realloc", {
  mut(ledger) := _new_ledger();
  a := Allocator(ctx : .Some((*void)(addr_of(ledger))), vtable : addr_of(_LEDGER_VTABLE));
  p := a.alloc(usize(100), usize(256)).unwrap();
  assert((_addr(.Some(p)) % usize(256)) == usize(0), "256-aligned");
  assert(ledger.max_align == usize(256), "the raw block was asked for the alignment");
  assert(Allocator.owner_of(p).same(a), "the owner record sits before an over-aligned block too");
  unsafe((*u8)(p).* = u8(7));
  unsafe((*u8)(p).add(usize(99)).* = u8(9));
  q := Allocator.realloc(p, usize(100), usize(5000), usize(256)).unwrap();
  assert((_addr(.Some(q)) % usize(256)) == usize(0), "still 256-aligned");
  assert(unsafe((*u8)(q).*) == u8(7), "first byte kept");
  assert(unsafe((*u8)(q).add(usize(99)).*) == u8(9), "last byte kept");
  Allocator.free(.Some(q), usize(5000), usize(256));
  assert(ledger.live == usize(0), "released");
  assert(ledger.mismatches == usize(0), "sized free matched");
  assert(a.alloc(usize(8), usize(48)).is_none(), "an alignment that is not a power of two is refused");
  // The global allocator and an arena serve the alignment too.
  g := Allocator.global().alloc(usize(10), usize(64)).unwrap();
  assert((_addr(.Some(g)) % usize(64)) == usize(0), "global: 64-aligned");
  Allocator.free(.Some(g), usize(10), usize(64));
  arena := _arena();
  r := arena.allocator().alloc(usize(10), usize(4096)).unwrap();
  assert((_addr(.Some(r)) % usize(4096)) == usize(0), "arena: 4096-aligned");
  Allocator.free(.Some(r), usize(10), usize(4096));
  assert(arena.live_blocks() == usize(0), "arena: released");
});
// A header-free pool: size classes of 64/128/256/512 bytes, each a free list
// threaded through the free blocks themselves. It keeps no per-block header:
// `free` finds the class from the size it is told, so a release told a wrong
// size lands on the wrong list and the per-class counts stop balancing.
_POOL_CLASSES :: usize(4);
_Pool :: struct(heads : Array(?*void, 4), allocs : Array(usize, 4), frees : Array(usize, 4), refused : usize);
derive(_Pool, Copy, Clone);
_pool_class :: (fn(size : usize) -> usize)(
  cond(
    (size <= usize(64)) => usize(0),
    (size <= usize(128)) => usize(1),
    (size <= usize(256)) => usize(2),
    (size <= usize(512)) => usize(3),
    true => _POOL_CLASSES
  )
);
_pool_alloc :: (fn(ctx : ?*void, size : usize, align : usize) -> ?*void)({
  pl := (*_Pool)(ctx.unwrap());
  c := _pool_class(size);
  cond(
    ((c == _POOL_CLASSES) || (align > usize(16))) => {
      unsafe(pl.*.refused = (pl.*.refused + usize(1)));
      .None
    },
    true => {
      unsafe(pl.*.allocs(c) = (pl.*.allocs(c) + usize(1)));
      match(
        unsafe(pl.*.heads(c)),
        .Some(h) => {
          // SAFETY: a free block's first word is the next free block.
          unsafe(pl.*.heads(c) = (*?*void)(h).*);
          .Some(h)
        },
        .None => GlobalAllocator.malloc(usize(64) << c)
      )
    }
  )
});
_pool_free :: (fn(ctx : ?*void, ptr : ?*void, size : usize, align : usize) -> unit)({
  pl := (*_Pool)(ctx.unwrap());
  c := _pool_class(size);
  unsafe(pl.*.frees(c) = (pl.*.frees(c) + usize(1)));
  // SAFETY: `ptr` is a block of class `c` (the size says so), at least a word.
  unsafe((*?*void)(ptr.unwrap()).* = pl.*.heads(c));
  unsafe(pl.*.heads(c) = ptr);
});
_pool_realloc :: (fn(ctx : ?*void, ptr : ?*void, old_size : usize, new_size : usize, align : usize) -> ?*void)(
  cond(
    (_pool_class(old_size) == _pool_class(new_size)) => ptr,
    true => match(
      _pool_alloc(ctx, new_size, align),
      .Some(q) => {
        n := cond((old_size < new_size) => old_size, true => new_size);
        // SAFETY: distinct blocks of at least `n` bytes.
        unsafe(memcpy(q, ptr.unwrap(), n));
        _pool_free(ctx, ptr, old_size, align);
        .Some(q)
      },
      .None => .None
    )
  )
);
_POOL_VTABLE := AllocatorVTable(alloc : _pool_alloc, realloc : _pool_realloc, free : _pool_free);
test("A header-free pool allocator frees by the size it is given", {
  mut(pool) := _Pool(
    heads : Array(?*void, 4)(.None, .None, .None, .None),
    allocs : Array(usize, 4)(usize(0), usize(0), usize(0), usize(0)),
    frees : Array(usize, 4)(usize(0), usize(0), usize(0), usize(0)),
    refused : usize(0)
  );
  a := Allocator(ctx : .Some((*void)(addr_of(pool))), vtable : addr_of(_POOL_VTABLE));
  mut(round) := usize(0);
  while(runtime(round < usize(3)), {
    {
      pts := ArrayList(_Point).new();
      mut(i) := i32(0);
      while(runtime(i < i32(20)), {
        pts.push(with_allocator(a, () => _Point(x : i32(i), y : i32(1))));
        i = (i + i32(1));
      });
      s := with_allocator(a, () => _Shape.Circle(r : i32(3)));
      d := with_allocator(a, () => _make_speaker());
      list := ArrayList(i32).new_in(a);
      mut(j) := i32(0);
      while(runtime(j < i32(60)), {
        list.push(j);
        j = (j + i32(1));
      });
      assert(list.len() == usize(60), "list");
      assert(pts.get(usize(19)).unwrap().x == i32(19), "points");
    };
    round = (round + usize(1));
  });
  assert(pool.refused == usize(0), "every request fit a class");
  mut(c) := usize(0);
  while(runtime(c < _POOL_CLASSES), {
    assert(pool.allocs(c) == pool.frees(c), `class ${c}: ${pool.allocs(c)} allocations, ${pool.frees(c)} frees`);
    c = (c + usize(1));
  });
  assert(pool.allocs(usize(0)) > usize(0), "the small objects took the smallest class");
});
