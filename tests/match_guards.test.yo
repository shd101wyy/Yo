//! Match guards (plans/reference/MATCH_PATTERN_MATCHING.md P3): `(p && (g)) => body`
//! runs the arm when `p` matches AND `g` — evaluated with `p`'s bindings in
//! scope — is true; a guarded arm never counts toward exhaustiveness.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
import("std/fmt");
test("a guard sees the pattern's bindings", {
  classify :: (fn(o : Option(i32)) -> i32)(
    match(
      o,
      (.Some(v) && (v > i32(100))) => i32(2),
      (.Some(v) && (v > i32(10))) => i32(1),
      .Some(_) => i32(0),
      .None => i32(-1)
    )
  );
  assert(classify(Option(i32).Some(500)) == i32(2));
  assert(classify(Option(i32).Some(50)) == i32(1));
  assert(classify(Option(i32).Some(5)) == i32(0));
  assert(classify(Option(i32).None) == i32(-1));
});
test("a guard on a wildcard and on a catch-all", {
  sign :: (fn(n : i32) -> i32)(
    match(
      n,
      (_ && (n < i32(0))) => i32(-1),
      (v && (v == i32(0))) => i32(0),
      _ => i32(1)
    )
  );
  assert(sign(-3) == i32(-1));
  assert(sign(0) == i32(0));
  assert(sign(9) == i32(1));
});
test("a guard may read an outer local", {
  limit := i32(10);
  over :: (fn(n : i32, lim : i32) -> bool)(
    match(
      n,
      (v && (v > lim)) => true,
      _ => false
    )
  );
  assert(over(11, limit));
  assert(!over(10, limit));
});
test("a guarded arm on a nested pattern", {
  f :: (fn(o : Option(Option(i32))) -> i32)(
    match(
      o,
      (.Some(.Some(v)) && (v == i32(7))) => i32(70),
      .Some(.Some(v)) => v,
      .Some(.None) => i32(-1),
      .None => i32(-2)
    )
  );
  assert(f(Option(Option(i32)).Some(Option(i32).Some(7))) == i32(70));
  assert(f(Option(Option(i32)).Some(Option(i32).Some(8))) == i32(8));
  assert(f(Option(Option(i32)).Some(Option(i32).None)) == i32(-1));
});
test("a guard over a reference-semantics binding", {
  long_name :: (fn(o : &Option(String)) -> bool)(
    match(
      o,
      (.Some(s) && (s.len() > usize(3))) => true,
      _ => false
    )
  );
  assert(long_name(Option(String).Some(`hello`)));
  assert(!long_name(Option(String).Some(`hi`)));
  assert(!long_name(Option(String).None));
});
test("guards on a compile-time scrutinee fold", {
  K :: Option(i32).Some(500);
  r :: match(
    K,
    (.Some(v) && (v > i32(100))) => i32(2),
    .Some(_) => i32(1),
    .None => i32(0)
  );
  assert(r == i32(2));
});
// A temporary a guard builds belongs to the guard: it is declared inside the
// arm's test and released right after the guard's bool, whether the guard
// holds or fails
// (issues/fixed/2026-10-24-a-match-guard-that-builds-a-temporary-object-emits-undeclared-c-temps.md).
(mut(g_guard_tok_drops) : i32) = i32(0);
_GuardTok :: struct(n : i32);
impl(
  _GuardTok,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_guard_tok_drops = (g_guard_tok_drops + i32(1));
    })
  )
);
impl(_GuardTok, peek : (fn(self : &Self) -> i32)(self.n));
_guard_tok :: (fn(x : i32) -> _GuardTok)(_GuardTok(n : x));
_GuardHolder :: struct(mk : Dyn(Fn(x : i32) -> _GuardTok), ms : Dyn(Fn(x : i32) -> String));
test("a guard over an object it builds", {
  k := i32(3);
  r := match(k, (n && (rc(n).* > i32(1))) => i32(2), _ => i32(3));
  assert(r == i32(2), "rc object");
  r2 := match(k, (n && (rc(n).* > i32(5))) => i32(2), _ => i32(3));
  assert(r2 == i32(3), "rc object, guard fails");
});
test("a guard's temporary receiver is released once on either path", {
  h := _GuardHolder(mk : dyn((x : i32) => _GuardTok(n : x)), ms : dyn((x : i32) => `s${x}`));
  before := g_guard_tok_drops;
  (mut(i) : i32) = i32(0);
  (mut(hits) : i32) = i32(0);
  while(i < i32(4), i = (i + i32(1)), {
    // A direct call's and a closure-field call's result as the receiver.
    a := match(i, (n && (_guard_tok(n).peek() > i32(1))) => i32(1), _ => i32(0));
    b := match(i, (n && (h.mk(n).peek() > i32(1))) => i32(1), _ => i32(0));
    // An owned String from a closure-field call.
    c := match(i, (n && (h.ms(n).len() == usize(2))) => i32(1), _ => i32(0));
    hits = (hits + a + b + c);
  });
  assert(hits == i32(8), "a and b hold for i = 2 and 3, c for every i");
  assert(g_guard_tok_drops == (before + i32(8)), "each receiver temp released once per evaluation");
});
