// Type-system soundness ratchet (plans/TYPE_SYSTEM_SOUNDNESS.md, Phase 0).
//
// One `comptime_expect_error` per fixed soundness issue whose reproducer fits
// in one file, each naming its issue doc. A case is added in the PR that fixes
// the issue, so this file is always green; the programs still waiting for a
// fix are counted by `scripts/soundness/census.sh` instead.
//
// Each case passes the diagnostic's text as the second argument, so a case
// cannot go green on some unrelated error the snippet happens to hit. Shapes
// that `comptime_expect_error` cannot observe — a check-level swallow
// (the expression is judged in propagate mode), a multi-file program, a
// runtime-only effect — are gated by `tests/cli-cases/` cases instead, and
// listed at the bottom so the ratchet stays one place to read.
{ String } :: import("std/string");
{ assert, panic } :: import("std/assert");
// ---------------------------------------------------------------------------
// issues/fixed/comptime-str-passed-where-string-is-declared-emits-invalid-c.md
// (landed in #856): a comptime literal argument is checked against a concrete
// parameter type.
// ---------------------------------------------------------------------------
_takes_string :: (fn(s : String) -> usize)(s.len());
test("soundness: a comptime_str is not a String argument", {
  comptime_expect_error(_takes_string("raw literal"), "incompatible types");
  assert(true, "rejected");
});
// ---------------------------------------------------------------------------
// issues/fixed/enum-type-constructor-arguments-are-ignored-by-type-compatibility.md
// (Phase 1.1): a generic enum's type arguments are part of its identity, and
// a GADT variant constructs only the instantiation its index names.
// ---------------------------------------------------------------------------
_Value :: (fn(comptime(T) : Type) -> comptime(Type))(
  enum(
    IntVal(i : i32) -> recur(i32),
    BoolVal(b : bool) -> recur(bool),
    PairVal(a : i32, b : bool) -> recur(i32)
  )
);
_Phantom :: (fn(comptime(T) : Type) -> comptime(Type))(enum(A(x : i32), B(y : bool)));
test("soundness: a GADT instantiation does not flow into another index", {
  comptime_expect_error({
    x := _Value(i32).IntVal(i32(77));
    (_y : _Value(bool)) = x;
  }, "Incompatible types");
  assert(true, "rejected");
});
test("soundness: a phantom enum parameter is part of the type", {
  comptime_expect_error({
    x := _Phantom(i32).A(i32(1));
    (_y : _Phantom(bool)) = x;
  }, "Incompatible types");
  assert(true, "rejected");
});
test("soundness: a GADT variant cannot construct another index", {
  comptime_expect_error(_Value(i32).BoolVal(true), "GADT variant \"BoolVal\"");
  comptime_expect_error({
    (_v : _Value(i32)) = .BoolVal(true);
  }, "GADT variant \"BoolVal\"");
  assert(true, "rejected");
});
test("soundness canary: same-index GADT and phantom instantiations still flow", {
  x := _Value(i32).PairVal(i32(1), false);
  (y : _Value(i32)) = x;
  p := _Phantom(bool).B(true);
  (q : _Phantom(bool)) = p;
  (v : _Value(bool)) = .BoolVal(true);
  assert(match(y, .PairVal(a, _) => (a == i32(1)), .IntVal(_) => false), "same index flows");
  assert(match(q, .B(b) => b, .A(_) => false), "same phantom index flows");
  assert(match(v, .BoolVal(b) => b), "shorthand at the declared index");
});
// ---------------------------------------------------------------------------
// issues/fixed/closure-result-type-is-not-checked-against-the-expected-fn-type.md
// (Phase 1.2): a closure's body is checked against the result of the
// `Fn(...) -> R` it adopts.
// ---------------------------------------------------------------------------
_apply :: (fn(f : Impl(Fn(x : i32) -> i32), v : i32) -> i32)(f(v));
test("soundness: a closure body must have the adopted Fn result type", {
  comptime_expect_error(_apply(x => true, i32(3)), "Function body has type `bool`");
  comptime_expect_error(_apply(x -> true, i32(3)), "Function body has type `bool`");
  comptime_expect_error(
    _apply(x => {
      x + i32(1);
    }, i32(3)),
    "Function body has type `unit`"
  );
  assert(true, "rejected");
});
test("soundness canary: a well-typed closure still flows into Fn(x : i32) -> i32", {
  k := i32(10);
  assert(_apply(x => (x + k), i32(3)) == i32(13), "closure result i32");
  assert(_apply(x -> (x * i32(2)), i32(3)) == i32(6), "fn literal result i32");
});
// ---------------------------------------------------------------------------
// issues/fixed/generic-fn-body-is-not-checked-against-its-declared-result-type.md
// (Phase 1.3): a specialized body is checked against its declared result.
// ---------------------------------------------------------------------------
_bad_ct :: (fn(comptime(T) : Type, x : T) -> i32)(true);
_bad_generic :: (fn(generic(T : Type), x : T) -> i32)(true);
_good_generic :: (fn(generic(T : Type), x : T) -> T)(x);
test("soundness: a specialized generic body must have its declared result type", {
  comptime_expect_error(_bad_ct(i32, i32(1)), "Function body has type `bool`");
  comptime_expect_error(_bad_generic(i32(1)), "Function body has type `bool`");
  // A `-> T` result answered concretely is already caught at definition
  // (the deferred-generic compare), before any call.
  comptime_expect_error(_bad_generic_t :: (fn(generic(T : Type), x : T) -> T)(true), "Incompatible function return type");
  assert(true, "rejected");
});
test("soundness canary: a well-typed generic body still specializes", {
  assert(_good_generic(i32(7)) == i32(7), "T = i32");
  assert(_good_generic(true), "T = bool");
});
// ---------------------------------------------------------------------------
// issues/fixed/context-typed-integer-literal-is-not-range-checked.md
// (Phase 1.4): a comptime integer entering a fixed-width slot must fit it.
// ---------------------------------------------------------------------------
_takes_u8 :: (fn(a : u8) -> u8)(a);
_U8Field :: struct(x : u8);
_big_constant :: 300;
test("soundness: a comptime integer that does not fit its slot is E1102", {
  comptime_expect_error({
    (_y : u8) = 300;
  }, "does not fit in u8");
  comptime_expect_error({
    (_z : u8) = -1;
  }, "does not fit in u8");
  comptime_expect_error({
    (_w : i8) = -129;
  }, "does not fit in i8");
  comptime_expect_error(_takes_u8(300), "does not fit in u8");
  comptime_expect_error(_takes_u8(200 + 100), "does not fit in u8");
  comptime_expect_error(u8(300), "does not fit in u8");
  comptime_expect_error({
    (_v : u8) = (200 + 100);
  }, "does not fit in u8");
  comptime_expect_error({
    (_c : u8) = _big_constant;
  }, "does not fit in u8");
  comptime_expect_error(_U8Field(x : (200 + 100)), "does not fit in u8");
  assert(true, "rejected");
});
test("soundness canary: in-range comptime integers take their slot's type", {
  (a : i8) = -128;
  (b : u64) = 18446744073709551615;
  (c : i64) = -9223372036854775808;
  k :: 3;
  (d : u8) = k;
  (e : u8) = (200 + 55);
  (f : f64) = (1 + 2);
  g := _U8Field(x : k);
  h := u64(18446744073709551615);
  // A conversion between TYPED integers keeps its truncating semantics.
  i := u32(i32(-1));
  assert(a == i8(-128), "i8 minimum");
  assert(b == u64.MAX, "u64 maximum");
  assert(c == i64.MIN, "i64 minimum");
  assert(d == u8(3), "comptime constant into u8");
  assert(e == u8(255), "folded sum at the boundary");
  assert(f == 3.0, "comptime_int into f64");
  assert(g.x == u8(3), "comptime constant into a u8 field");
  assert(h == u64.MAX, "u64(max) conversion");
  assert(i == u32(4294967295), "typed conversion truncates");
});
// ---------------------------------------------------------------------------
// issues/fixed/cond-arm-type-unification-depends-on-arm-order.md
// (Phase 1.5): the comptime-numeric arm join is symmetric.
// ---------------------------------------------------------------------------
test("soundness: the arm join does not depend on arm order", {
  c := true;
  x := cond(c => 1, true => i64(2));
  y := cond(c => i64(2), true => 1);
  m := match(c, true => 1, false => i64(2));
  (xi : i64) = x;
  (yi : i64) = y;
  (mi : i64) = m;
  assert((xi == i64(1)) && ((yi == i64(2)) && (mi == i64(1))), "both orders join at i64");
  comptime_expect_error(cond(c => 300, true => u8(1)), "does not fit in u8");
});
// ---------------------------------------------------------------------------
// issues/fixed/equality-operator-without-an-eq-impl-evaluates-to-unit.md
// (Phase 1.6): an operator whose trait lookup misses on a concrete type is
// an error, never `unit`.
// ---------------------------------------------------------------------------
_NoEq :: struct(x : i32);
_NoEqE :: enum(A, B);
_generic_eq :: (fn(generic(T : Type), a : T, b : T, where(T <: Eq(T))) -> bool)(a == b);
test("soundness: a missing operator impl is an error", {
  a := _NoEq(x : i32(1));
  b := _NoEq(x : i32(2));
  comptime_expect_error(a == b, "No matching call found for operator \"==\"");
  comptime_expect_error(a != b, "No matching call found for operator");
  comptime_expect_error(a < b, "No matching call found for operator \"<\"");
  comptime_expect_error(_NoEqE.A == _NoEqE.B, "No matching call found for operator \"==\"");
  assert(true, "rejected");
});
test("soundness canary: generic and impl'd comparisons still resolve", {
  assert(_generic_eq(i32(1), i32(1)), "generic Eq over i32");
  assert(!_generic_eq(String.from("a"), String.from("b")), "generic Eq over String");
});
// ---------------------------------------------------------------------------
// issues/fixed/enum-variant-payload-type-is-not-checked-at-construction.md
// (Phase 1.7): a generic instantiation is never a declared non-generic
// struct, so a wrong payload is rejected at construction.
// ---------------------------------------------------------------------------
{ ArrayList } :: import("std/collections/array_list");
_Verdict :: enum(Proved(core : ArrayList(String)), Nope);
test("soundness: an enum payload is checked at construction", {
  comptime_expect_error(_Verdict.Proved(String.from("unsat")), "Incompatible types for field \"core\"");
  assert(true, "rejected");
});
test("soundness canary: the declared payload type still constructs", {
  v := _Verdict.Proved(ArrayList(String).new());
  assert(match(v, .Proved(c) => (c.len() == usize(0)), .Nope => false), "payload flows");
});
// ---------------------------------------------------------------------------
// issues/fixed/bare-fn-type-param-accepts-a-closure-then-emits-invalid-c.md
// and issues/fixed/a-comptime-parameter-given-a-non-comptime-argument-emits-broken-c.md
// (Phase 1.8): a closure is not a function pointer; a runtime value is not a
// comptime argument.
// ---------------------------------------------------------------------------
_takes_bare :: (fn(f : (fn(a : i32) -> i32), v : i32) -> i32)(f(v));
_double :: (fn(a : i32) -> i32)(a * i32(2));
_ct_param :: (fn(comptime(v) : i32) -> i32)(v);
test("soundness: a closure is not a bare fn(...) argument", {
  k := i32(10);
  comptime_expect_error(_takes_bare(y => (y + k), i32(5)), "cannot be used where the function-pointer type");
  assert(true, "rejected");
});
test("soundness: a runtime value is not a comptime(...) argument", {
  comptime_expect_error(_ct_param(i32.default()), "requires a compile-time argument");
  assert(true, "rejected");
});
test("soundness canary: named fns and literals still fit those slots", {
  assert(_takes_bare(_double, i32(5)) == i32(10), "named fn as fn pointer");
  assert(_ct_param(i32(3)) == i32(3), "literal comptime argument");
});
// ---------------------------------------------------------------------------
// issues/fixed/inout-call-through-a-fn-value-loses-the-mutation.md
// (Phase 1.9): an `inout` parameter is a pointer in every fn-pointer call.
// ---------------------------------------------------------------------------
_bump :: (fn(inout(x) : i32) -> unit)({
  x = (x + i32(1));
  ()
});
_Wrap :: (fn(comptime(T) : Type) -> comptime(Type))(struct(inner : T));
test("soundness: an inout call through a fn value mutates the argument", {
  (f : (fn(inout(x) : i32) -> unit)) = _bump;
  (v : i32) = i32(5);
  f(v);
  _bump(v);
  assert(v == i32(7), "fn-typed local and direct call both mutate");
  (w : _Wrap((fn(inout(x) : i32) -> unit))) = _Wrap((fn(inout(x) : i32) -> unit))(inner : _bump);
  w.inner(v);
  assert(v == i32(8), "fn-typed struct field mutates");
});
// Phase 3.5: the parameter modes are part of the fn type, so a by-reference
// function is not a by-value one, and the CTFE memo keeps
// `_Wrap(fn(x : i32) -> unit)` and `_Wrap(fn(inout(x) : i32) -> unit)` apart.
_p35_by_val :: (fn(x : i32) -> unit)({
  x;
  ()
});
_p35_eat :: (fn(own(s) : String) -> usize)(s.len());
_p35_len :: (fn(s : String) -> usize)(s.len());
_p35_inout_is_by_val :: Type.eq((fn(inout(x) : i32) -> unit), (fn(x : i32) -> unit));
_p35_own_is_borrow :: Type.eq((fn(own(s) : String) -> usize), (fn(s : String) -> usize));
_p35_inout_flows_by_val :: Type.is_compatible_with((fn(inout(x) : i32) -> unit), (fn(x : i32) -> unit));
test("soundness: parameter modes are part of a fn type", {
  comptime_expect_error({
    (g : (fn(x : i32) -> unit)) = _bump;
  }, "Incompatible types");
  comptime_expect_error({
    (h : (fn(s : String) -> usize)) = _p35_eat;
  }, "Incompatible types");
  assert(!_p35_inout_is_by_val, "inout is not by-value");
  assert(!_p35_own_is_borrow, "own is not a borrow");
  assert(!_p35_inout_flows_by_val, "inout does not flow into a by-value slot");
});
test("soundness: the memo keeps a by-value and an inout instantiation apart", {
  (w0 : _Wrap((fn(x : i32) -> unit))) = _Wrap((fn(x : i32) -> unit))(inner : _p35_by_val);
  (w1 : _Wrap((fn(inout(x) : i32) -> unit))) = _Wrap((fn(inout(x) : i32) -> unit))(inner : _bump);
  (v : i32) = i32(5);
  w0.inner(v);
  w1.inner(v);
  assert(v == i32(6), "the inout instance mutates");
});
test("soundness canary: a fn value flows into a slot of the same modes", {
  (g : (fn(inout(x) : i32) -> unit)) = _bump;
  (h : (fn(own(s) : String) -> usize)) = _p35_eat;
  (k : (fn(s : String) -> usize)) = _p35_len;
  (v : i32) = i32(1);
  g(v);
  assert(v == i32(2), "inout slot");
  assert(h(String.from("abc")) == usize(3), "own slot");
  assert(k(String.from("ab")) == usize(2), "borrow slot");
});
// ---------------------------------------------------------------------------
// issues/fixed/impl-is-not-checked-against-the-trait-members.md (Phase 2.1):
// an `impl(T, Trait(...))` is checked against the trait's members.
// ---------------------------------------------------------------------------
_Foo :: trait(f : (fn(self : Self) -> i32), g : (fn(self : Self) -> i32));
_Bar :: trait(f : (fn(self : Self) -> i32), (h : (fn(self : Self) -> i32)) ?= (self -> i32(9)));
_ImplP :: struct(x : i32);
_ImplQ :: struct(x : i32);
_ImplR :: struct(x : i32);
_ImplS :: struct(x : i32);
impl(_ImplS, _Bar(f : (self -> self.x)));
test("soundness: an impl must match its trait's members", {
  comptime_expect_error(impl(_ImplP, _Foo(f : (self -> self.x))), "member \"g\" is not provided and has no default");
  comptime_expect_error(impl(_ImplQ, _Foo(f : (self -> self.x), g : (fn(self : Self) -> bool)(true))), "member \"g\" has type");
  comptime_expect_error(impl(_ImplR, _Foo(f : (self -> self.x), g : (self -> self.x), k : (self -> self.x))), "\"k\" is not a member of the trait");
  assert(true, "rejected");
});
test("soundness canary: a trait default fills an omitted member", {
  s := _ImplS(x : i32(4));
  assert(s.f() == i32(4), "provided member");
  assert(s.h() == i32(9), "default member");
});
// ---------------------------------------------------------------------------
// Gated elsewhere (not expressible as comptime_expect_error):
//   issues/fixed/unwind-type-mismatch-in-a-handler-is-swallowed.md
//     -> tests/cli-cases/check-unwind-type-mismatch-in-handler
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// issues/fixed/impl-trait-return-bound-is-not-checked.md (Phase 2.2): an
// `Impl(Trait)` result or parameter takes only a type that implements it.
// ---------------------------------------------------------------------------
_Speaks :: trait(speak : (fn(self : Self) -> i32));
_Dog :: struct(x : i32);
_Rock :: struct(y : i32);
impl(_Dog, _Speaks(speak : (self -> self.x)));
_make_dog :: (fn() -> Impl(_Speaks))(_Dog(x : i32(3)));
_hear :: (fn(v : Impl(_Speaks)) -> i32)(v.speak());
test("soundness: an Impl(Trait) result or argument must implement the trait", {
  comptime_expect_error(_bad_make :: (fn() -> Impl(_Speaks))(_Rock(y : i32(4))), "which does not implement required trait");
  comptime_expect_error(_hear(_Rock(y : i32(4))), "does not implement required trait");
  assert(true, "rejected");
});
test("soundness canary: an implementing type flows through Impl(Trait)", {
  assert(_make_dog().speak() == i32(3), "Impl result");
  assert(_hear(_Dog(x : i32(5))) == i32(5), "Impl argument");
});
// Canary for the Impl(Trait) argument check. A function VALUE is Send when
// its captures are and its code reaches no thread-affine global (rule D9,
// plans/reference/PARALLELISM_RULES.md), so each argument below is judged by
// value. The bare type `fn() -> i32` has no value to judge and is not Send;
// Acyclic stays a property of the type (a code pointer holds no reference).
_run_send :: (fn(generic(T : Type), cb : Impl(Fn() -> T, Send), where(T <: Send)) -> T)(cb());
_plain_fn :: (fn() -> i32)(i32(8));
test("soundness canary: fn values and capture-free closures are Send", {
  comptime_assert(!Type.impls(fn() -> i32, Send));
  comptime_assert(Type.impls(fn() -> i32, Acyclic));
  assert(_run_send(() => (i32(20) + i32(22))) == i32(42), "closure through Impl(Fn, Send)");
  k := i32(5);
  assert(_run_send(() => (k + i32(1))) == i32(6), "a Send capture");
  assert(_run_send(_plain_fn) == i32(8), "a named fn");
});
// ---------------------------------------------------------------------------
// issues/fixed/generic-type-var-rebinds-per-argument.md (Phase 2.4): every
// mention of a type parameter in one call stands for one type.
// ---------------------------------------------------------------------------
_pair_same :: (fn(generic(A : Type), x : A, y : A) -> A)(x);
_apply_g :: (fn(generic(T : Type), f : Impl(Fn(x : T) -> T), v : T) -> T)(f(v));
_apply_v :: (fn(generic(T : Type), v : T, f : Impl(Fn(x : T) -> T)) -> T)(f(v));
test("soundness: two arguments cannot bind one type parameter to two types", {
  comptime_expect_error(_pair_same(String.from("hello"), i32(2)), "Incompatible types for generic parameter");
  comptime_expect_error(_pair_same(i32(3), String.from("world")), "Incompatible types for generic parameter");
  comptime_expect_error(_apply_g(x => true, i32(3)), "declared result type");
  comptime_expect_error(_apply_g(x -> true, i32(3)), "declared result type");
  assert(true, "rejected");
});
test("soundness canary: arguments that agree on a type parameter", {
  assert(_pair_same(i32(3), i32(4)) == i32(3), "same type");
  assert(_pair_same(i32(3), 4) == i32(3), "a literal adopts the binder");
  assert(_apply_g(x => (x + i32(1)), i32(3)) == i32(4), "closure result agrees");
  assert(_apply_g(x -> (x * i32(2)), i32(3)) == i32(6), "function literal first");
  assert(_apply_v(i32(3), x -> (x * i32(2))) == i32(6), "function literal last");
});
// ---------------------------------------------------------------------------
// issues/fixed/uninferable-generic-result-passes-check-and-ices-in-compile.md
// (Phase 2.4): a result-only type parameter comes from the expected type, or
// is E0613.
// ---------------------------------------------------------------------------
_mk_none :: (fn(generic(T : Type)) -> Option(T))(.None);
_Maker :: struct(k : i32);
impl(_Maker, mk : (fn(generic(T : Type), self : Self) -> Option(T))(.None));
test("soundness: a result-only type parameter with nothing to infer it from", {
  comptime_expect_error({
    x := _mk_none();
    x
  }, "Cannot infer the type parameter");
  comptime_expect_error({
    m := _Maker(k : i32(1));
    y := m.mk();
    y
  }, "Cannot infer the type parameter");
  assert(true, "rejected");
});
test("soundness canary: the expected type infers a result-only type parameter", {
  (x : Option(i32)) = _mk_none();
  assert(match(x, .Some(v) => v, .None => i32(9)) == i32(9), "annotated binding");
  y := _mk_none(generic(bool));
  assert(y.is_none(), "explicit generic argument");
  m := _Maker(k : i32(1));
  (z : Option(u8)) = m.mk();
  assert(z.is_none(), "a method's result-only binder from the expected type");
});
// issues/fixed/generic-fn-specialized-at-two-types-hands-the-closure-the-wrong-param-type.md
// (Phase 2.4): an outer generic instantiating an inner one at a DIFFERENT
// type, with a closure over the outer T's data. The closure's parameter type
// came from the OUTER `T` (resolved by name), so the emitted C passed a
// `usize` index where the closure took a `_Rec`.
_TwoTRec :: struct(key : i32, tag : i32);
_inner_at :: (fn(generic(T : Type), a : T, b : T, less : Impl(Fn(x : T, y : T) -> bool)) -> bool)(less(a, b));
_outer_at :: (fn(generic(T : Type), xs : ArrayList(T), less : Impl(Fn(x : T, y : T) -> bool)) -> bool)(
  _inner_at(usize(0), usize(1), (i, j) => less(xs(i), xs(j)))
);
test("soundness canary: a closure keeps the inner instantiation's parameter type", {
  xs := ArrayList(_TwoTRec).new();
  xs.push(_TwoTRec(key : i32(1), tag : i32(0)));
  xs.push(_TwoTRec(key : i32(2), tag : i32(1)));
  assert(_outer_at(xs, (p, q) => (p.key < q.key)), "compares the records through indices");
});
// issues/fixed/calling-an-io-param-closure-in-a-generic-fn-keeps-an-unresolved-somet.md:
// calling an `Impl(Fn(io : Io) -> T)` parameter inside a generic body typed the
// result as an unresolved SomeT (undeclared symbol / clang type error).
_IoCell :: (fn(comptime(T) : Type, where(T <: Send)) -> comptime(Type))(struct(v : T));
impl(
  generic(T : Type),
  where(T <: Send),
  _IoCell(T),
  put : (fn(inout(self) : Self, value : T) -> unit)({
    self.v = value;
  })
);
_io_run :: (fn(generic(T : Type), io : Io, seed : T, cb : Impl(Fn(io : Io) -> T), where(T <: Send)) -> T)({
  b := _IoCell(T)(v : seed);
  b.put(cb(io));
  b.v
});
test("soundness canary: an io-param closure's result inside a generic body", {
  assert(_io_run(io, i32(0), (io2 : Io) => i32(42)) == i32(42), "i32");
  assert(_io_run(io, u64(0), (io2 : Io) => u64(18446744073709551615)) == u64(18446744073709551615), "u64");
  assert(_io_run(io, f64(0.0), (io2 : Io) => f64(2.5)) == f64(2.5), "f64");
});
// issues/fixed/generic-fn-forall-unresolved-when-argument-is-a-method-call.md
// (Phase 2.4): a method call passed straight to a generic `Option(U)`
// parameter adopted `Option(U)` as its own result (a shallow "is the expected
// type concrete" test), so `U` stayed a type variable and the callee was
// specialized abstractly — an FTT stub at run time.
impl(i32, _wrap_some : (fn(self : i32) -> Option(i32))(Option(i32).Some(self)));
_take_opt :: (fn(generic(U : Type), o : Option(U)) -> bool)(match(o, .Some(_) => true, .None => false));
test("soundness canary: a method-call argument binds the callee's type parameter", {
  x := i32(1);
  assert(_take_opt(x._wrap_some()), "Some through the method call");
});
// issues/fixed/higher-kinded-return-type-is-never-applied-at-the-call-site.md
// (Phase 2.4): a kind-annotated binder is inferred from an argument's
// instantiation, and `F(A)` in the result is applied.
_hk_identity :: (fn(generic(F : (fn(comptime(T) : Type) -> comptime(Type)), A : Type), x : F(A)) -> F(A))(x);
test("soundness canary: F(A) infers F and A and the result is Option(i32)", {
  o := Option(i32).Some(i32(7));
  r := _hk_identity(o);
  (r2 : Option(i32)) = r;
  assert(match(r2, .Some(v) => v, .None => i32(0)) == i32(7), "the constructor was applied");
  xs := ArrayList(i32).new();
  xs.push(i32(3));
  ys := _hk_identity(xs);
  assert(ys.len() == usize(1), "a struct constructor too");
});
// issues/fixed/iterator-chain-shared-stamp-cross-item-pollution.md (Phase 2.4):
// two `.map` calls at different Item types share one substituted `IterMap`
// instance id; the durable `Item` registration was keyed by that id, so the
// second chain's `min` read the first call's `i32`.
_SoundRange :: struct(_cur : i32, _end : i32);
impl(
  _SoundRange,
  Iterator(
    Item : i32,
    next : (fn(inout(self) : Self) -> Option(i32))(
      cond(
        (self._cur >= self._end) => .None,
        true => {
          v := self._cur;
          self._cur = (self._cur + i32(1));
          .Some(v)
        }
      )
    )
  )
);
_SoundRange64 :: struct(_cur : i64, _end : i64);
impl(
  _SoundRange64,
  Iterator(
    Item : i64,
    next : (fn(inout(self) : Self) -> Option(i64))(
      cond(
        (self._cur >= self._end) => .None,
        true => {
          v := self._cur;
          self._cur = (self._cur + i64(1));
          .Some(v)
        }
      )
    )
  )
);
test("soundness canary: two .map chains at different Item types keep their own Item", {
  out := ArrayList(i32).new();
  it := _SoundRange(_cur : i32(1), _end : i32(4)).map(x => (x * i32(2)));
  it.for_each(x => {
    out.push(x);
  });
  m := _SoundRange64(_cur : i64(-3), _end : i64(4)).map(x => (x * i64(2))).min();
  assert(out.len() == usize(3), "the i32 chain");
  assert(match(m, .Some(v) => v, .None => i64(99)) == i64(-6), "the i64 chain's min");
});
// ---------------------------------------------------------------------------
// plans/archive/ASSOC_TYPE_BINDING_IN_FREE_FN_WHERE.md (Phase 2.6): a free
// function's `where(I <: Iterator(Item := A))` binds `A` from the argument's
// impl, a self-referential bound on `A` is judged at that binding, and the
// blanket combinators can be called on the parameter.
// ---------------------------------------------------------------------------
_sound_count :: (fn(generic(I : Type, A : Type), it : I, where(I <: Iterator(Item := A))) -> usize)(
  it.fold(usize(0), (n, x) => (n + usize(1)))
);
_sound_sum :: (fn(generic(I : Type, A : Type), it : I, zero : A, where(I <: Iterator(Item := A), A <: Add(A))) -> A)(
  it.fold(zero, (acc, x) => (acc + x))
);
_sound_collect :: (fn(generic(I : Type, A : Type), it : I, where(I <: Iterator(Item := A))) -> ArrayList(A))(
  it.collect(ArrayList(A))
);
// `J` is fixed only by `F <: (Fn(item : A) -> J)` and the closure's body.
_sound_map_all :: (fn(generic(I : Type, A : Type, J : Type, F : Type), it : I, f : F, where(I <: Iterator(Item := A), F <: (Fn(item : A) -> J))) -> ArrayList(J))(
  it.map(f).collect(ArrayList(J))
);
_sound_sum_i32 :: (fn(generic(I : Type), it : I, where(I <: Iterator(Item := i32))) -> i32)(
  it.fold(i32(0), (acc, x) => (acc + x))
);
test("soundness: a free fn binds an associated type from its where-clause", {
  assert(_sound_count(_SoundRange(_cur : i32(1), _end : i32(4))) == usize(3), "a source");
  assert(_sound_count(_SoundRange(_cur : i32(1), _end : i32(4)).map(x => (x * i32(2)))) == usize(3), "a chain");
  assert(_sound_sum(_SoundRange(_cur : i32(1), _end : i32(4)), i32(0)) == i32(6), "A <: Add(A) at i32");
  assert(_sound_sum(_SoundRange64(_cur : i64(1), _end : i64(4)), i64(0)) == i64(6), "A <: Add(A) at i64");
  got := _sound_collect(_SoundRange(_cur : i32(1), _end : i32(4)));
  assert(got.len() == usize(3), "a blanket combinator on the parameter");
  wide := _sound_map_all(_SoundRange(_cur : i32(1), _end : i32(4)), x => i64(x));
  assert(match(wide.get(usize(2)), .Some(v) => v, .None => i64(0)) == i64(3), "J from the closure body");
  comptime_expect_error(_sound_sum_i32(_SoundRange64(_cur : i64(1), _end : i64(4))), "its associated type Item is i64, not i32");
  // The self-referential bound is still judged, at the candidate.
  flags := ArrayList(bool).new();
  flags.push(true);
  comptime_expect_error(_sound_sum(flags.into_iter(), false), "Type bool does not implement required trait");
});
// ---------------------------------------------------------------------------
// issues/fixed/fn-trait-pairs-are-never-synthesized.md (Phase 2.6): binders
// inside a `Dyn(Fn(...))` parameter are inferred from the argument.
// ---------------------------------------------------------------------------
_sound_apply_dyn :: (fn(generic(A : Type, B : Type), f : Dyn(Fn(x : A) -> B), v : A) -> B)(f(v));
test("soundness: Dyn(Fn(x : A) -> B) binds A and B from the argument", {
  (inc : Dyn(Fn(y : i32) -> i32)) = dyn(y => (y + i32(1)));
  assert(_sound_apply_dyn(inc, i32(41)) == i32(42), "B inferred");
});
// ---------------------------------------------------------------------------
// Phase 2.5: one argument/parameter rule for every call path
// (issues/fixed/a-free-function-call-accepts-an-already-moved-argument.md,
// issues/fixed/a-folded-comptime-integer-argument-to-a-method-is-lowered-to-i32.md).
// ---------------------------------------------------------------------------
_p25_eat :: (fn(own(s) : String) -> usize)(s.len());
_p25_take_u8 :: (fn(a : u8) -> u8)(a);
_P25Holder :: struct(n : i32);
impl(
  _P25Holder,
  eat : (fn(self : Self, own(s) : String) -> usize)(s.len()),
  take_u8 : (fn(self : Self, a : u8) -> u8)(a)
);
test("soundness: a moved argument is rejected on both call paths", {
  a := String.from("abc");
  n := _p25_eat(a);
  comptime_expect_error(_p25_eat(a), "use of moved value");
  h := _P25Holder(n : i32(1));
  b := String.from("wxyz");
  m := h.eat(b);
  comptime_expect_error(h.eat(b), "use of moved value");
  assert((n + m) == usize(7), "each call saw its own string");
});
test("soundness: a folded comptime integer is judged the same on both call paths", {
  h := _P25Holder(n : i32(1));
  assert(_p25_take_u8(100 + 50) == u8(150), "free fn");
  assert(h.take_u8(100 + 50) == u8(150), "method");
  comptime_expect_error(_p25_take_u8(200 + 100), "does not fit in u8");
  comptime_expect_error(h.take_u8(200 + 100), "does not fit in u8");
});
// ---------------------------------------------------------------------------
// issues/fixed/struct-compatibility-accepts-a-name-match-or-an-anonymous-wildcard.md
// (Phase 3.2): a struct is another struct only when it is the same declaration
// or, with an anonymous side, has the same fields. A name match and an empty
// name are not enough.
// ---------------------------------------------------------------------------
{ P : _P31a } :: import("./fixtures/soundness_p1.yo");
{ P : _P31b } :: import("./fixtures/soundness_p2.yo");
_p31_take :: (fn(p : _P31a) -> i32)(p.x);
_P31Named :: struct(x : i32);
_P31Newt :: newtype(v : i32);
_P31Colors :: enum(Red, Green);
_p31_anon_other_fields :: Type.is_compatible_with(struct(y : bool), _P31Named);
_p31_anon_vs_anon :: Type.is_compatible_with(struct(x : i32), struct(y : bool, z : f64));
_p31_newtype_vs_anon :: Type.is_compatible_with(_P31Newt, struct(v : i32));
_p31_anon_vs_newtype :: Type.is_compatible_with(struct(v : i32), _P31Newt);
_p31_ref_vs_anon :: Type.is_compatible_with(ref(struct(x : i32)), struct(x : i32));
_p31_enum_vs_enum :: Type.is_compatible_with(enum(Blue), _P31Colors);
_p31_union_vs_union :: Type.is_compatible_with(union(a : i32), union(b : f64, c : u8));
_p31_anon_same_fields :: Type.is_compatible_with(struct(x : i32), _P31Named);
test("soundness: a name match or an anonymous side is not struct compatibility", {
  comptime_expect_error(_p31_take(_P31b(s : true, t : f64(1.0))), "two different types with the same name");
  comptime_expect_error({
    r := { y : true, z : f64(2.5) };
    (a : _P31Named) = r;
  }, "Incompatible types");
  assert(!_p31_anon_other_fields, "anonymous record with other fields vs a named struct");
  assert(!_p31_anon_vs_anon, "two anonymous records with different fields");
  assert(!_p31_newtype_vs_anon, "a newtype is nominal against an anonymous record");
  assert(!_p31_anon_vs_newtype, "an anonymous record is not a newtype");
  assert(!_p31_ref_vs_anon, "a ref object is not a value record");
  assert(!_p31_enum_vs_enum, "an anonymous enum with other variants");
  assert(!_p31_union_vs_union, "a union with other fields");
});
test("soundness canary: an anonymous record with the same fields flows into a named struct", {
  assert(_p31_anon_same_fields, "same fields");
  r := { x : i32(7) };
  (a : _P31Named) = r;
  assert(a.x == i32(7), "the value survives");
  assert(_p31_take(_P31a(x : i32(4))) == i32(4), "the right P");
});
// ---------------------------------------------------------------------------
// issues/fixed/ctfe-memo-merges-an-anonymous-struct-with-a-named-struct.md
// (Phase 3.4): the CTFE memo keys on identity, so `Type.eq` and an
// instantiation do not depend on what ran first.
// ---------------------------------------------------------------------------
_P34A :: struct(x : i32);
_P34B :: struct(x : i32);
_P34Wrap :: (fn(comptime(T) : Type) -> comptime(Type))(struct(inner : T));
impl(_P34A, show : (fn(self : Self) -> i32)(self.x + i32(100)));
_P34T1 :: trait(t1 : (fn(self : Self) -> i32));
_P34T2 :: trait(t2 : (fn(self : Self) -> i32));
test("soundness: Type.eq does not depend on the order of earlier questions", {
  // anonymous pair first, then the named pair ...
  (anon_first : bool) = Type.eq(struct(x : i32), struct(x : i32));
  (named_second : bool) = Type.eq(_P34A, _P34B);
  // ... and the named pair first, then the anonymous pair.
  (named_first : bool) = Type.eq(_P34B, _P34A);
  (anon_second : bool) = Type.eq(struct(x : i32), struct(x : i32));
  assert(anon_first && anon_second, "two anonymous records with the same fields are one type");
  assert(!named_second && !named_first, "two declarations are two types in either order");
  assert(!Type.eq(struct(x : i32), _P34A), "an anonymous record is not a named struct");
  assert(!Type.eq(Tuple(a : i32, b : bool), Tuple(c : i32, d : bool)), "tuple labels are part of the identity");
  assert(Type.eq(Tuple(a : i32, b : bool), Tuple(a : i32, b : bool)), "the same labelled tuple");
  assert(!Type.eq(Dyn(_P34T1, _P34T2), Dyn(_P34T1)), "a Dyn with more traits is another type");
  assert(!Type.eq(Dyn(_P34T1), Dyn(_P34T1, _P34T2)), "... in either order");
  assert(Type.eq(Dyn(_P34T1, _P34T2), Dyn(_P34T2, _P34T1)), "the same trait set in another order");
});
test("soundness: an instantiation does not adopt an earlier, different one", {
  (w0 : _P34Wrap(struct(x : i32))) = _P34Wrap(struct(x : i32))(
    inner : { x : i32(1) }
  );
  (w1 : _P34Wrap(_P34A)) = _P34Wrap(_P34A)(inner : _P34A(x : i32(2)));
  assert(w0.inner.x == i32(1), "the anonymous instance");
  assert(w1.inner.show() == i32(102), "the named instance keeps its methods");
});
// A collection of an anonymous record and a collection of a named struct with
// the same fields are two instantiations; the memo used to hand the second the
// first's, and pushing the named value failed with "Cannot unify incompatible
// struct types" (reported by a peer session, 2026-09-24).
_P34Row :: struct(name : String, dt : u8);
_p34_rows_anon :: (fn() -> usize)({
  xs := ArrayList(struct(name : String, dt : u8)).new();
  xs.push({ name : String.from("a"), dt : u8(1) });
  xs.len()
});
_p34_rows_named :: (fn() -> usize)({
  ys := ArrayList(_P34Row).new();
  ys.push(_P34Row(name : String.from("b"), dt : u8(2)));
  ys.push(_P34Row(name : String.from("c"), dt : u8(3)));
  ys.len()
});
test("soundness: ArrayList(anonymous record) and ArrayList(Named) are two instantiations", {
  assert(_p34_rows_anon() == usize(1), "anonymous");
  assert(_p34_rows_named() == usize(2), "named");
});
// ---------------------------------------------------------------------------
// issues/fixed/std-panic-cannot-type-a-value-arm-because-there-is-no-bottom-type.md
// (Phase 3.6): `never` is the bottom type. A diverging arm does not
// constrain a cond/match join, and a `-> never` function's call fits any
// value slot.
// ---------------------------------------------------------------------------
_p36_die :: (fn(msg : str) -> never)(__yo_panic(msg));
_p36_pick :: (fn(flag : bool) -> i64)({
  x := cond(flag => i32(3), true => __yo_panic("boom"));
  y := match(flag, false => __yo_panic("bam"), true => i32(4));
  z := cond(flag => i32(5), true => _p36_die("die"));
  i64(x + y + z)
});
_p36_tail :: (fn(flag : bool) -> i32)(cond(flag => i32(7), true => __yo_panic("tail")));
_p36_block :: (fn(flag : bool) -> i32)({
  if(!flag, {
    _p36_die("block");
  });
  i32(8)
});
_p36_never_eq :: Type.eq(never, never);
_p36_never_flows :: Type.is_compatible_with(never, i32);
_p36_into_never :: Type.is_compatible_with(i32, never);
test("soundness: never is the identity of an arm join", {
  assert(_p36_pick(true) == i64(12), "a panicking arm takes the other arm's type");
  assert(_p36_tail(true) == i32(7), "a panicking tail arm");
  assert(_p36_block(true) == i32(8), "a never call as a statement");
});
test("soundness: never flows into every type and nothing flows into it", {
  assert(_p36_never_eq, "never is never");
  assert(_p36_never_flows, "never flows into i32");
  assert(!_p36_into_never, "i32 does not flow into never");
  comptime_expect_error(_p36_returns :: (fn() -> never)(()), "declared result type is `never`");
});
// ---------------------------------------------------------------------------
// Phase 5.1/5.2/5.6: per-path move and initialization state
// (issues/fixed/moving-a-variable-inside-a-loop-body-is-not-rejected.md,
// issues/fixed/cond-arm-initialization-merge-check-never-fires.md,
// issues/fixed/borrowed-arg-invalidated-by-aliased-container-mutation.md).
// Each box counts its releases: a leak or a double release shows as a wrong
// count.
// ---------------------------------------------------------------------------
(g_p5_disposed : i32) = i32(0);
_P5Box :: ref(struct(tag : i32));
impl(
  _P5Box,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      g_p5_disposed = (g_p5_disposed + i32(1));
    })
  )
);
_p5_sink :: (fn(own(b) : _P5Box) -> i32)(b.tag);
_p5_early_return :: (fn(c : bool) -> i32)({
  b := _P5Box(tag : i32(5));
  if(c, {
    return(_p5_sink(b));
  });
  b.tag + i32(1)
});
test("soundness: a move in an arm that returns does not reach the code after the branch", {
  before := g_p5_disposed;
  assert(_p5_early_return(true) == i32(5), "the returning path moved the box");
  assert(_p5_early_return(false) == i32(6), "the other path still has it");
  assert(g_p5_disposed == (before + i32(2)), `each box released once, got ${(g_p5_disposed - before).to_string()}`);
});
// The count above cannot see a second release of a freed box. Here a keeper
// holds one more reference: a second release by the returning arm would
// dispose the box while the keeper still holds it
// (issues/fixed/a-move-in-a-returning-arm-is-released-again-at-the-return.md).
_p5_early_return_kept :: (fn(c : bool, keep : ArrayList(_P5Box)) -> i32)({
  b := _P5Box(tag : i32(5));
  keep.push(b);
  if(c, {
    return(_p5_sink(b));
  });
  b.tag + i32(1)
});
test("soundness: the returning arm releases its moved value once", {
  keep := ArrayList(_P5Box).new();
  before := g_p5_disposed;
  assert(_p5_early_return_kept(true, keep) == i32(5), "the returning path moved the box");
  assert(g_p5_disposed == before, `the keeper still holds the box, got ${(g_p5_disposed - before).to_string()} disposals`);
  keep.clear();
  assert(g_p5_disposed == (before + i32(1)), `released once the keeper lets go, got ${(g_p5_disposed - before).to_string()}`);
});
_p5_move_on_break :: (fn(n : i32) -> i32)({
  b := _P5Box(tag : n);
  (i : i32) = i32(0);
  (r : i32) = i32(0);
  while(true, {
    i = (i + i32(1));
    if(i == i32(3), {
      r = _p5_sink(b);
      break;
    });
  });
  r
});
test("soundness: a loop may move an outer value on its only way out", {
  before := g_p5_disposed;
  assert(_p5_move_on_break(i32(9)) == i32(9), "moved at the break");
  assert(g_p5_disposed == (before + i32(1)), `released once, got ${(g_p5_disposed - before).to_string()}`);
});
_P5Holder :: struct(s : String);
_p5_clobber :: (fn(inout(a) : _P5Holder, b : _P5Holder) -> usize)({
  (i : i32) = i32(0);
  while(runtime(i < i32(3)), {
    a = _P5Holder(s : `fresh-value-${i}-xxxxxxxxxxxxxxxxxxxxxxxx`);
    i = (i + i32(1));
  });
  b.s.len()
});
test("soundness: a by-value argument outlives the inout argument it overlaps", {
  x := _P5Holder(s : String.from("original-value-yyyyyyyyyyyyyyyyyyyyyyyyyyyy"));
  n := _p5_clobber(x, x);
  assert(n == usize(43), `the borrowed value survived the writes, len ${n.to_string()}`);
  assert(x.s.starts_with(`fresh-value-2`), "the inout write reached the caller");
});
// issues/fixed/std-panic-cannot-type-a-value-arm-because-there-is-no-bottom-type.md:
// std/assert's `panic` is `-> never`, so it fits an arm that must produce a value.
test("soundness: std panic types a value arm", {
  pick :: (fn(flag : bool) -> i64)({
    x := cond(flag => i32(3), true => panic("boom"));
    i64(x)
  });
  assert(pick(true) == i64(3), "the value arm is taken");
  first :: (fn(o : Option(i32)) -> i32)(match(o, .Some(v) => v, .None => panic("no value")));
  assert(first(Option(i32).Some(i32(4))) == i32(4), "the match value arm is taken");
});
