//! Regression tests: early-return cleanup inside a match arm must not drop a
//! same-named OUTER variable's pending drop against the arm's shadowing
//! binding. The arm binding `.Some(h)` is a borrow of the matched value's
//! payload (no dup); before the fix, a function-level `h := ...` declared
//! AFTER the match registered a function-scope pending drop that the
//! early-return filter matched BY NAME against the arm binding — the emitted
//! C `drop(h)` resolved to the borrow and double-freed the payload. This was
//! the root cause of the yo-self ExprInfo-table use-after-free (deterministic
//! SIGSEGV under libgmalloc; intermittent SIGTRAP-in-malloc at scale).
//! Fixed by matching pending-drop targets by Variable IDENTITY (id), not name
//! (src/codegen/exprs/return.ts + getDeferredDropTargetVariableId).
{ assert } :: import("std/assert");
import("std/fmt");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Exception } :: import("std/error");
{ yield } :: import("std/async");

Holder :: struct(v : String);

// Early return inside a match arm whose binding shadows a later local.
take_early :: (fn(o : &Option(Holder), flag : bool) -> i32)({
  r := match(
    o,
    .Some(h) => {
      cond(
        flag => {
          return(i32(1));
        },
        true => ()
      );
      i32(2)
    },
    .None => i32(0)
  );
  // Same NAME as the arm binding, declared after the match: its
  // function-scope pending drop must not fire inside the arm.
  h := Holder(v : String.from("later"));
  ___ := h;
  r
});

test("early return in shadowing match arm does not double-free the payload", {
  o := Option(Holder).Some(Holder(v : String.from("payload")));
  x := take_early(&o, true);
  assert(x == i32(1), "early-return path taken");
  // The payload must still be alive: o's borrow reads it after the call.
  alive := match(
    o,
    .Some(h) => (h.v == "payload"),
    .None => false
  );
  assert(alive, "payload survives the early-returning call");
});

test("normal path through the shadowing arm is balanced", {
  o := Option(Holder).Some(Holder(v : String.from("payload-2")));
  x := take_early(&o, false);
  assert(x == i32(2), "normal arm value");
  alive := match(
    o,
    .Some(h) => (h.v == "payload-2"),
    .None => false
  );
  assert(alive, "payload survives the normal path");
});

// Two nested match arms, both shadowing later locals: the early return
// crosses two arm scopes and must skip BOTH outer pending drops.
take_nested :: (
  fn(o : &Option(Holder), o2 : &Option(Holder), flag : bool) -> i32
)({
  r := match(
    o,
    .Some(h) => match(
      o2,
      .Some(g) => cond(
        flag => {
          return(i32(10));
        },
        true => i32(20)
      ),
      .None => i32(0)
    ),
    .None => i32(0)
  );
  h := Holder(v : String.from("later-h"));
  g := Holder(v : String.from("later-g"));
  sink := cond(
    (r > i32(0)) => h,
    true => g
  );
  ___ := sink;
  r
});

// Companion bug (same UAF family, second root): when the dup/drop optimizer
// cancels a move-into-container dup (`w := Wrap(items : items)` below takes
// `items` WITHOUT a dup), it marked the source consumed at the END-OF-SCOPE
// token instead of the transfer site. Early returns between the transfer and
// the scope end then received an early-return-only drop of `items` — freeing
// the buffer `w` still owns (this was the residual dispatch-on SIGTRAP:
// ct_arg_entries moved into ArgValues in yo-self's evaluate_function_call).
Sack :: struct(items : ArrayList(Holder));

take_after_move :: (fn(o : Option(i32)) -> i32)({
  mut(items) := ArrayList(Holder).new();
  items.push(Holder(v : String.from("moved-payload")));
  sack := Sack(items : items);
  match(
    o,
    .Some(x) => {
      return(x);
    },
    .None => ()
  );
  n := i32(sack.items.len());
  ___ := sack;
  n
});

test("early return after a move-into-container does not drop the moved value", {
  x := take_after_move(Option(i32).Some(i32(7)));
  assert(x == i32(7), "early-return path taken");
  y := take_after_move(Option(i32).None);
  assert(y == i32(1), "normal path still sees the moved list");
});

test("early return crossing two shadowing arm scopes", {
  o := Option(Holder).Some(Holder(v : String.from("payload-3")));
  o2 := Option(Holder).Some(Holder(v : String.from("payload-4")));
  x := take_nested(&o, &o2, true);
  assert(x == i32(10), "early-return path taken");
  alive := match(
    o,
    .Some(h) => (h.v == "payload-3"),
    .None => false
  );
  alive2 := match(
    o2,
    .Some(h) => (h.v == "payload-4"),
    .None => false
  );
  assert(alive, "outer payload survives");
  assert(alive2, "inner payload survives");
});

// Regression (issues/fixed/2026-10-15-an-assignments-old-value-save-by-bytes-is-never-released.md):
// an assignment saves the value it overwrites into a temp that is released at
// scope end. #1365 made the save a byte copy (`T t; memcpy(...)`), which the
// emitter's declaration scan does not see, so an explicit `return` (or an
// `exn` escape) after the assignment skipped the release: one leaked old value
// per early exit. The normal path and the never-assigned value are the
// over-release canaries.
(mut(g_sv_dropped) : i32) = i32(0);
_SvTok :: struct(n : i32);
impl(
  _SvTok,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_sv_dropped = (g_sv_dropped + i32(1));
    })
  )
);
_SvHolder :: struct(tok : Option(_SvTok));
_sv_reassign_then_return :: (fn(early : bool) -> i32)({
  mut(t) := _SvTok(n : i32(1));
  t = _SvTok(n : i32(2));
  if(early, {
    return(t.n);
  });
  t.n + i32(10)
});
_sv_field_store_then_return :: (fn(h : &mut _SvHolder, early : bool) -> i32)({
  h.tok = Option(_SvTok).Some(_SvTok(n : i32(3)));
  if(early, {
    return(i32(1));
  });
  i32(2)
});
test("an early return after an assignment releases the overwritten value once", {
  before := g_sv_dropped;
  assert(_sv_reassign_then_return(true) == i32(2), "early path value");
  assert(g_sv_dropped == (before + i32(2)), "the old and the new value are both released");
  assert(_sv_reassign_then_return(false) == i32(12), "normal path value");
  assert(g_sv_dropped == (before + i32(4)), "the normal path releases each value once");
});
test("an early return after a field store releases the field's old value once", {
  before := g_sv_dropped;
  mut(h) := _SvHolder(tok : Option(_SvTok).Some(_SvTok(n : i32(0))));
  assert(_sv_field_store_then_return(&mut h, true) == i32(1), "early path value");
  assert(g_sv_dropped == (before + i32(1)), "the field's old value is released on the early exit");
  assert(_sv_field_store_then_return(&mut h, false) == i32(2), "normal path value");
  assert(g_sv_dropped == (before + i32(2)), "and once on the normal path");
  assert(match(&h.tok, .Some(t) => (t.n == i32(3)), .None => false), "the stored value is still alive");
});
// An unwind out of an inner block must not drop a LATER same-named local
// against the inner one: the escape's consumed-variable drop list matched its
// target's C name on the block-scope stack, and the inner `(k : usize)` made
// the outer `k`'s name look declared
// (issues/fixed/2026-11-03-an-unwind-drop-names-a-shadowing-local-of-another-type.md).
// A move-only key: its drop takes `_SbKey*`, so a drop emitted against the
// inner `usize` below is a C type error, and the counter checks the balance.
(mut(g_sb_key_drops) : i32) = i32(0);
_SbKey :: struct(n : usize);
impl(
  _SbKey,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_sb_key_drops = (g_sb_key_drops + i32(1));
    })
  )
);
// Throws once the inner counter reaches `limit`.
_sb_check :: (fn(k : usize, limit : usize, exn : Exception) -> bool)({
  if(k >= limit, {
    exn.throw(dyn(String.from("limit")));
  });
  true
});
// An inner `(k : usize)` loop counter whose call may unwind, then a later
// outer `k : _SbKey` the cond consumes. The unwind out of the inner loop must
// drop `cell_key` only: the outer `k` does not exist yet.
_sb_pick :: (fn(xs : &ArrayList(usize), limit : usize, exn : Exception) -> usize)({
  (mut(cell_key) : _SbKey) = _SbKey(n : usize(0));
  (mut(i) : usize) = usize(0);
  while(i < xs.len(), i = (i + usize(1)), {
    x := xs(i);
    simple := match(
      x,
      usize(0) => false,
      _ => {
        (mut(ok) : bool) = true;
        (mut(k) : usize) = usize(0);
        while((k < x) && ok, k = (k + usize(1)), {
          ok = _sb_check(k, limit, exn);
        });
        ok
      }
    );
    if(!simple, {
      return(usize(0));
    });
    k := _SbKey(n : x);
    cond(
      (cell_key.n == usize(0)) => {
        cell_key = k;
      },
      !(k.n == cell_key.n) => return(usize(0)),
      true => ()
    );
  });
  cell_key.n
});
_sb_run :: (fn(limit : usize) -> usize)({
  exn := Exception(throw : (_err -> unwind(usize(99))));
  mut(xs) := ArrayList(usize).new();
  xs.push(usize(3));
  xs.push(usize(3));
  _sb_pick(&xs, limit, exn)
});
test("an unwind out of an inner loop does not drop a later same-named local", {
  before := g_sb_key_drops;
  assert(_sb_run(usize(2)) == usize(99), "the inner call unwound");
  assert(g_sb_key_drops == (before + i32(1)), `the unwind drops cell_key only, dropped ${(g_sb_key_drops - before).to_string()}`);
});
test("the same function without an unwind balances every key", {
  before := g_sb_key_drops;
  assert(_sb_run(usize(10)) == usize(3), "no unwind");
  // The initial cell_key (replaced), the second iteration's k, and the final cell_key.
  assert(g_sb_key_drops == (before + i32(3)), `every key dropped once, dropped ${(g_sb_key_drops - before).to_string()}`);
});
// Two same-named locals, the first in an inner block: an unwind inside that
// block released the first one twice, once for its own drop and once for the
// later local's drop resolved by name.
_sb_mk :: (fn(fail : bool, exn : Exception) -> usize)({
  if(fail, {
    exn.throw(dyn(String.from("x")));
  });
  usize(1)
});
_sb_take :: (fn(k : _SbKey) -> usize)(k.n);
_sb_twice :: (fn(flag : bool, fail : bool, exn : Exception) -> usize)({
  if(flag, {
    k := _SbKey(n : usize(1));
    t := _sb_mk(fail, exn);
    return(_sb_take(k) + t);
  });
  k := _SbKey(n : usize(2));
  _sb_take(k)
});
_sb_twice_run :: (fn(flag : bool, fail : bool) -> usize)({
  exn := Exception(throw : (_err -> unwind(usize(99))));
  _sb_twice(flag, fail, exn)
});
test("an unwind before a later same-named local drops the earlier one once", {
  before := g_sb_key_drops;
  assert(_sb_twice_run(true, true) == usize(99), "the call unwound");
  assert(g_sb_key_drops == (before + i32(1)), `the inner k is dropped once, dropped ${(g_sb_key_drops - before).to_string()}`);
  before2 := g_sb_key_drops;
  assert(_sb_twice_run(true, false) == usize(2), "no unwind");
  assert(g_sb_key_drops == (before2 + i32(1)), "the consumed k is dropped once by its consumer");
});
// A consuming `match` arm binding that reuses an enclosing local's name owns
// the payload it moved out of the scrutinee, so the arm's end drops it. The
// drop was attached only when no other binding of the name was visible, and
// the enclosing local it shadows counted as one: every such match leaked its
// payload. Only a binding declared after the value can capture its drop
// (issues/fixed/2026-11-05-a-match-arm-binding-that-shadows-a-local-is-never-dropped.md).
// The tag sums tell a payload drop (10) from the outer local's (1).
(mut(g_sh_drops) : i32) = i32(0);
_ShV :: struct(tag : i32);
impl(
  _ShV,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_sh_drops = (g_sh_drops + self.tag);
    })
  )
);
_sh_n :: (fn() -> i32)(g_sh_drops);
_sh_find :: (fn() -> Option(_ShV))(Option(_ShV).Some(_ShV(tag : i32(10))));
test("a match arm binding that shadows a local is dropped at the arm's end", {
  g_sh_drops = i32(0);
  {
    parsed := _ShV(tag : i32(1));
    inner := match(_sh_find(), .Some(parsed) => parsed.tag, .None => i32(0));
    assert(inner == i32(10), "the arm reads its own binding");
    assert(g_sh_drops == i32(10), `the payload is dropped at the arm's end, drops=${_sh_n()}`);
    assert(parsed.tag == i32(1), "the enclosing local is untouched");
  };
  assert(g_sh_drops == i32(11), `each value is dropped once, drops=${_sh_n()}`);
});
test("a shadowing arm binding over a named scrutinee is dropped once", {
  g_sh_drops = i32(0);
  {
    parsed := _ShV(tag : i32(1));
    o := _sh_find();
    inner := match(o, .Some(parsed) => parsed.tag, .None => i32(0));
    assert((inner + parsed.tag) == i32(11), "both bindings read their own value");
  };
  assert(g_sh_drops == i32(11), `each value is dropped once, drops=${_sh_n()}`);
});
// An early return inside the shadowing arm drops the binding and the local.
_sh_early :: (fn(flag : bool) -> i32)({
  parsed := _ShV(tag : i32(1));
  inner := match(
    _sh_find(),
    .Some(parsed) => {
      if(flag, {
        return(parsed.tag + i32(100));
      });
      parsed.tag
    },
    .None => i32(0)
  );
  parsed.tag + inner
});
test("an early return from a shadowing arm drops the binding and the local once", {
  g_sh_drops = i32(0);
  assert(_sh_early(true) == i32(110), "the early path");
  assert(g_sh_drops == i32(11), `the early path drops each value once, drops=${_sh_n()}`);
  g_sh_drops = i32(0);
  assert(_sh_early(false) == i32(11), "the normal path");
  assert(g_sh_drops == i32(11), `the normal path drops each value once, drops=${_sh_n()}`);
});
// A nested arm's binding that shadows the outer arm's binding: each payload
// is dropped once, by its own arm.
test("nested shadowing arm bindings are each dropped once", {
  g_sh_drops = i32(0);
  {
    inner := match(
      _sh_find(),
      .Some(parsed) => {
        seen := parsed.tag;
        seen + match(_sh_find(), .Some(parsed) => (parsed.tag * i32(10)), .None => i32(0))
      },
      .None => i32(0)
    );
    assert(inner == i32(110), "each arm reads its own binding");
  };
  assert(g_sh_drops == i32(20), `each payload is dropped once, drops=${_sh_n()}`);
});
// The outer arm's binding is read again after the inner arm that shadows it
// closed: the read is the outer binding's, not the enclosing local's.
test("an arm binding read after a nested arm that shadows it is its own", {
  g_sh_drops = i32(0);
  {
    parsed := _ShV(tag : i32(1));
    inner := match(
      _sh_find(),
      .Some(parsed) => {
        nested := match(_sh_find(), .Some(parsed) => (parsed.tag * i32(10)), .None => i32(0));
        nested + parsed.tag
      },
      .None => i32(0)
    );
    assert(inner == i32(110), `each arm reads its own binding, inner=${inner.to_string()}`);
    assert(parsed.tag == i32(1), "the enclosing local is untouched");
  };
  assert(g_sh_drops == i32(21), `each value is dropped once, drops=${_sh_n()}`);
});
// An early return from a nested arm whose binding shadows the outer arm's
// and the enclosing local: all three are dropped once.
_sh_early_nested :: (fn(flag : bool) -> i32)({
  parsed := _ShV(tag : i32(1));
  inner := match(
    _sh_find(),
    .Some(parsed) => match(
      _sh_find(),
      .Some(parsed) => {
        if(flag, {
          return(parsed.tag + i32(100));
        });
        parsed.tag
      },
      .None => i32(0)
    ),
    .None => i32(0)
  );
  parsed.tag + inner
});
test("an early return from a nested shadowing arm drops every value once", {
  g_sh_drops = i32(0);
  assert(_sh_early_nested(true) == i32(110), "the early path");
  assert(g_sh_drops == i32(21), `the early path drops each value once, drops=${_sh_n()}`);
  g_sh_drops = i32(0);
  assert(_sh_early_nested(false) == i32(11), "the normal path");
  assert(g_sh_drops == i32(21), `the normal path drops each value once, drops=${_sh_n()}`);
});
// An unwind out of a shadowing arm drops the binding and the enclosing local.
_sh_check :: (fn(fail : bool, exn : Exception) -> i32)({
  if(fail, {
    exn.throw(dyn(String.from("unwind")));
  });
  i32(0)
});
_sh_unwind :: (fn(fail : bool, exn : Exception) -> i32)({
  parsed := _ShV(tag : i32(1));
  inner := match(_sh_find(), .Some(parsed) => (parsed.tag + _sh_check(fail, exn)), .None => i32(0));
  parsed.tag + inner
});
_sh_unwind_run :: (fn(fail : bool) -> i32)({
  exn := Exception(throw : (_err -> unwind(i32(99))));
  _sh_unwind(fail, exn)
});
test("an unwind out of a shadowing arm drops the binding and the local once", {
  g_sh_drops = i32(0);
  assert(_sh_unwind_run(true) == i32(99), "the call unwound");
  assert(g_sh_drops == i32(11), `the unwind drops each value once, drops=${_sh_n()}`);
  g_sh_drops = i32(0);
  assert(_sh_unwind_run(false) == i32(11), "no unwind");
  assert(g_sh_drops == i32(11), `the normal path drops each value once, drops=${_sh_n()}`);
});
// An early return from a shadowing arm inside an async body, across awaits.
test("an early return from a shadowing arm in an async body drops each value once", {
  g_sh_drops = i32(0);
  drive := (fn(flag : bool, rio : Io) -> Impl(Future(i32, Io)))(
    rio.async((aio : Io) => {
      parsed := Rc.new(_ShV(tag : i32(1)));
      aio.await(yield(aio), aio);
      inner := match(
        _sh_find_cargo(),
        .Some(parsed) => {
          if(flag, {
            return(parsed.tag + i32(100));
          });
          parsed.tag
        },
        .None => i32(0)
      );
      aio.await(yield(aio), aio);
      parsed.tag + inner
    })
  );
  assert(io.await(drive(true, io), io) == i32(110), "the early path");
  assert(g_sh_drops == i32(11), `the early path drops each value once, drops=${_sh_n()}`);
  g_sh_drops = i32(0);
  assert(io.await(drive(false, io), io) == i32(11), "the normal path");
  assert(g_sh_drops == i32(11), `the normal path drops each value once, drops=${_sh_n()}`);
});
// A String payload: the leak verdict (LeakSanitizer) is the oracle.
_sh_find_label :: (fn() -> Option(String))(Option(String).Some(String.from("inner-label")));
test("a shadowing arm binding of a String payload is released", {
  label := String.from("outer-label");
  n := match(_sh_find_label(), .Some(label) => label.len(), .None => usize(0));
  assert((n + label.len()) == usize(22), "both strings are read");
});
// The async shape: a shared handle (`Rc`) payload, whose `Option` lowers to
// the nullable pointer, bound by an arm beside a same-named local that lives
// across awaits.
_ShCargo :: Rc(_ShV);
_sh_find_cargo :: (fn() -> Option(_ShCargo))(Option(_ShCargo).Some(Rc.new(_ShV(tag : i32(10)))));
test("a shadowing nullable-pointer arm binding in an async body is dropped once", {
  g_sh_drops = i32(0);
  drive := (fn(rio : Io) -> Impl(Future(i32, Io)))(
    rio.async((aio : Io) => {
      parsed := Rc.new(_ShV(tag : i32(1)));
      aio.await(yield(aio), aio);
      inner := match(_sh_find_cargo(), .Some(parsed) => parsed.tag, .None => i32(0));
      aio.await(yield(aio), aio);
      parsed.tag + inner
    })
  );
  assert(io.await(drive(io), io) == i32(11), "each binding reads its own value");
  assert(g_sh_drops == i32(11), `each value is dropped once, drops=${_sh_n()}`);
});
// A `&` match's binding is a pointer into the scrutinee (decision 43), read
// through. One that shadows an enclosing local is declared under its own C
// name, and it is still read through that pointer.
_ShTwo :: enum(Two(x : i32, y : i32), One(n : i32));
test("a shadowing binding of a borrowed match reads through its pointer", {
  y := i32(5);
  e := _ShTwo.Two(x : i32(1), y : i32(2));
  got := match(&e, .Two(_, y) => (y.* + i32(10)), _ => i32(-1));
  assert(got == i32(12), `the binding reads the payload, got=${got}`);
  assert(y == i32(5), "the enclosing local is untouched");
});
// Only the outer binding of a nested same-named pair is a pointer: the inner
// by-value binding is read as a value, and the outer one through its pointer
// again once the inner arm closes.
test("nested same-named borrowed and by-value bindings each read their own way", {
  e := _ShTwo.Two(x : i32(1), y : i32(2));
  o := Option(i32).Some(i32(9));
  got := match(
    &e,
    .Two(v, _) => {
      inner := match(o, .Some(v) => (v + i32(100)), .None => i32(0));
      (inner + v.*)
    },
    _ => i32(-1)
  );
  assert(got == i32(110), `inner reads 9, outer reads 1, got=${got}`);
});
