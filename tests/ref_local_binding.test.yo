/// `ref(name) := lvalue;` local binding form.
///
/// v4 (plans/BORROW_EXCLUSIVITY.md): ref-RETURNING functions are
/// banned, so a ref local binds directly to an lvalue — a local
/// variable, a `ref`-bound parameter, or an object field.
///
/// Guarantees pinned here:
/// - `ref(name) := expr;` is recognized as a binding form and the
///   bound variable carries `isRef: true` (same flag as
///   `ref(name) : T` parameter bindings).
/// - `ref(name) :: ...` is rejected — borrows are runtime constructs.
/// - The closure-capture gate rejects captures of a ref-bound local.
// `ref(name) := expr;` with `::` is rejected — borrows are runtime.
comptime_expect_error(
  ref(r) :: i32(42)
);
// The closure-capture gate fires on a `ref`-bound local just as it
// does on a `ref`-bound parameter: `r` is declared as a ref-local via
// the binding form, then captured by the returned closure.
comptime_expect_error(
  make_capturing_closure :: (fn(ref(p) : i32) -> Impl(Fn() -> i32))({
    ref(r) := p;
    () => r
  })
);
// Smoke test: a function that does NOT bind via `ref(name) :=` still
// compiles cleanly. Confirms the binding-form changes don't false-
// positive on regular `:=` bindings.
test("regular := bindings still compile", {
  x := i32(5);
  y := x;
  assert(y == i32(5), "regular binding works");
});
// End-to-end positive: `ref(name) := lvalue` binds the local to the
// source's storage. Reading and writing through the binding reach the
// source.
test("ref(name) := local — read through the binding", {
  x := i32(42);
  ref(r) := x;
  // Reading r auto-derefs to the underlying i32 value.
  assert(r == i32(42), "reads through the ref-binding");
});
test("ref(name) := local — write through the binding propagates", {
  x := i32(5);
  ref(r) := x;
  // Writing through r writes through to x's storage.
  r = i32(99);
  assert(x == i32(99), "writes through the ref-binding propagate");
});
test("ref(name) := ref-bound param — write reaches the caller", {
  bump :: (fn(ref(p) : i32) -> unit)({
    ref(r) := p;
    r = (r + i32(1));
  });
  x := i32(41);
  bump(x);
  assert(x == i32(42), "write through a ref-of-ref-param reaches the caller");
});
