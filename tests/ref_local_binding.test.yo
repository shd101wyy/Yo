/// v4.1 (plans/BORROW_EXCLUSIVITY.md): `inout(name) := …` local bindings
/// were REMOVED — `ref` exists only in parameter position. These tests
/// pin the ban and the migration recipes (direct field access; binding
/// the handle).
open(import("std/string"));
Holder :: object(s : String, n : i32);
// The binding form is rejected with the teaching error.
comptime_expect_error(
  ref_binding_removed :: (fn() -> unit)({
    x := i32(42);
    inout(r) := x;
    consume(r);
  })
);
// Field-borrow shape, same ban.
comptime_expect_error(
  ref_field_binding_removed :: (fn() -> unit)({
    h := Holder(s : String.from("a"), n : i32(1));
    inout(r) := h.s;
    consume(r);
  })
);
// The comptime form is rejected too.
comptime_expect_error(
  ref_comptime_binding_removed :: (fn() -> unit)({
    inout(r) :: i32(42);
    consume(r);
  })
);
// Migration recipe 1: fields read and write in place — no borrow needed.
test("field access reads and writes in place", {
  h := Holder(s : String.from("hello"), n : i32(1));
  h.s = String.from("rewritten");
  assert(h.s == "rewritten", "direct String field write");
  h.n = i32(2);
  assert(h.n == i32(2), "direct scalar field write");
});
// Migration recipe 2: binding the HANDLE keeps an object alive.
test("binding the handle keeps an object alive", {
  a := Holder(s : String.from("kept"), n : i32(0));
  b := a;
  a = Holder(s : String.from("other"), n : i32(1));
  assert(b.s == "kept", "b's handle keeps the original object alive");
  assert(a.s == "other", "a points at the replacement");
});
