pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
import("std/string");
{ ArrayList } :: import("std/collections/array_list");
// === Recursive enum with Rc(Self) ===
// Mirrors the AST MyExpr shape we'll need for the compiler port.
MyExpr :: enum(
  Lit(value : i32),
  Add(lhs : Rc(Self), rhs : Rc(Self)),
  Mul(lhs : Rc(Self), rhs : Rc(Self)),
  List(items : ArrayList(Self))
);
eval :: (fn(e : *MyExpr) -> i32)({
  return(
    match(
      e.*,
      .Lit(v) => v,
      .Add(l, r) => {
        lv := recur(addr_of(l.*));
        rv := recur(addr_of(r.*));
        lv + rv
      },
      .Mul(l, r) => {
        lv := recur(addr_of(l.*));
        rv := recur(addr_of(r.*));
        lv * rv
      },
      .List(items) => {
        sum := i32(0);
        i := usize(0);
        while(i < items.len(), i = (i + usize(1)), {
          match(
            items.get(i),
            .Some(it) => {
              sum = (sum + recur(addr_of(it)));
            },
            .None => ()
          );
        });
        sum
      }
    )
  );
});
test("Recursive enum: construct + match Rc(Self) leaves", {
  e := MyExpr.Add(
    rc(MyExpr.Lit(i32(2))),
    rc(MyExpr.Lit(i32(3)))
  );
  v := eval(addr_of(e));
  assert(v == i32(5), "2 + 3 == 5");
});
test("Recursive enum: ArrayList(Self) variant", {
  items := ArrayList(MyExpr).new();
  items.push(MyExpr.Lit(i32(10)));
  items.push(MyExpr.Lit(i32(20)));
  items.push(MyExpr.Add(rc(MyExpr.Lit(i32(3))), rc(MyExpr.Lit(i32(4)))));
  e := MyExpr.List(items);
  v := eval(addr_of(e));
  assert(v == i32(37), "10 + 20 + 7 == 37");
});
test("Recursive enum: nested Rc(Self) tree", {
  // ((1 + 2) * (3 + 4)) = 21
  tree := MyExpr.Mul(
    rc(MyExpr.Add(rc(MyExpr.Lit(i32(1))), rc(MyExpr.Lit(i32(2))))),
    rc(MyExpr.Add(rc(MyExpr.Lit(i32(3))), rc(MyExpr.Lit(i32(4)))))
  );
  v := eval(addr_of(tree));
  assert(v == i32(21), "(1+2)*(3+4) == 21");
});
build_spine :: (fn(n : i32) -> MyExpr)({
  return(
    cond(
      (n <= i32(0)) => MyExpr.Lit(i32(1)),
      true => MyExpr.Add(rc(MyExpr.Lit(i32(1))), rc(recur(n - i32(1))))
    )
  );
});
test("Recursive enum: deeply nested drop terminates", {
  spine := build_spine(i32(50));
  v := eval(addr_of(spine));
  assert(v == i32(51), "spine of 50 Adds + 1 Lit sums to 51");
});
// === derive(Clone) on a recursive type ===
// Note: derive(Clone) on Rc(Self) currently has a known codegen ordering
// issue (issues/fixed/recursive-derive-clone-codegen-vtable.md). We skip the
// derive call here and only test that the bare recursive enum works.
// === Value-enum drops and dups through per-type functions ===
// issues/fixed/value-enum-drops-are-emitted-inline-at-every-drop-site.md: a
// tagged value enum's drop and dup are one C function per enum type, called at
// every site, instead of the variant switch inlined at each one. Every payload
// must still be released exactly once: the probes count their disposals.
(mut(g_holder_probe_disposed) : i32) = i32(0);
HolderProbe :: ref(struct(id : i32));
impl(
  HolderProbe,
  Dispose(
    dispose : (fn(self : &Self) -> unit)({
      g_holder_probe_disposed = (g_holder_probe_disposed + i32(1));
    })
  )
);
Holder :: enum(
  HEmpty,
  HOne(p : HolderProbe),
  HPair(a : HolderProbe, b : HolderProbe),
  HNest(inner : Rc(Self)),
  HMany(xs : ArrayList(HolderProbe))
);
_holder_weight :: (fn(h : Holder, stop : bool) -> i32)({
  if(stop, {
    return(i32(1));
  });
  match(h, .HPair(_, _) => i32(2), .HNest(_) => i32(3), _ => i32(4))
});
_holder_sum_ids :: (fn(hs : &ArrayList(Holder)) -> i32)({
  (total : i32) = i32(0);
  (i : usize) = usize(0);
  while(i < hs.len(), i = (i + usize(1)), {
    match(
      hs.get(i),
      .Some(h) => match(
        h,
        .HOne(p) => {
          total = (total + p.id);
        },
        .HPair(a, b) => {
          total = (total + (a.id + b.id));
        },
        _ => ()
      ),
      .None => ()
    );
  });
  total
});
test("Value enum: every payload is released once through the per-type drop and dup", {
  before := g_holder_probe_disposed;
  {
    one := Holder.HOne(p : HolderProbe(id : i32(1)));
    pair := Holder.HPair(a : HolderProbe(id : i32(2)), b : HolderProbe(id : i32(3)));
    nest := Holder.HNest(inner : rc(Holder.HOne(p : HolderProbe(id : i32(4)))));
    probes := ArrayList(HolderProbe).new();
    probes.push(HolderProbe(id : i32(5)));
    probes.push(HolderProbe(id : i32(6)));
    many := Holder.HMany(xs : probes);
    assert(_holder_weight(nest, true) == i32(1), "an early return drops its by-value Holder");
    assert(_holder_weight(many, false) == i32(4), "a fall-through drops its by-value Holder");
    hs := ArrayList(Holder).new();
    hs.push(one);
    hs.push(pair);
    hs.push(Holder.HEmpty);
    // `get` copies each element out (a dup); the copies are dropped per iteration.
    assert(_holder_sum_ids(&hs) == i32(6), "1 + 2 + 3");
    assert(_holder_sum_ids(&hs) == i32(6), "a second pass sees the same payloads");
  };
  assert((g_holder_probe_disposed - before) == i32(6), "the six probes are disposed exactly once");
});
// === One C type for Option(E) of a recursive value enum ===
// issues/fixed/option-of-a-recursive-value-enum-gets-two-c-types-in-the-self-build.md:
// with an `ArrayList(Self)` and an `ArrayList(ArrayList(Self))` payload, the
// `Option(ListTree)` that `ArrayList(Self).get` returns inside the enum's own
// arms and the declared `Option(ListTree)` got two C types ("initializing
// '__yo_t_A' with an expression of incompatible type '__yo_t_B'").
ListTree :: enum(
  LtLeaf(n : i32),
  LtList(xs : ArrayList(Self)),
  LtGrid(rows : ArrayList(ArrayList(Self)))
);
_list_tree_weight :: (fn(t : &ListTree) -> i32)(
  match(
    t,
    .LtLeaf(n) => n,
    .LtList(xs) => match(xs.get(usize(0)), .Some(x) => recur(&x), .None => i32(0)),
    .LtGrid(rows) => match(
      rows.get(usize(0)),
      .Some(row) => match(row.get(usize(0)), .Some(x) => recur(&x), .None => i32(0)),
      .None => i32(0)
    )
  )
);
_list_tree_first :: (fn(xs : &ArrayList(ListTree)) -> Option(ListTree))(xs.get(usize(0)));
test("Recursive value enum: ArrayList(Self).get and a declared Option(Self) are one type", {
  inner := ArrayList(ListTree).new();
  inner.push(ListTree.LtLeaf(n : i32(7)));
  xs := ArrayList(ListTree).new();
  xs.push(ListTree.LtList(xs : inner));
  w := match(_list_tree_first(&xs), .Some(f) => _list_tree_weight(&f), .None => i32(-1));
  assert(w == i32(7), "the first element's first leaf");
  row := ArrayList(ListTree).new();
  row.push(ListTree.LtLeaf(n : i32(3)));
  rows := ArrayList(ArrayList(ListTree)).new();
  rows.push(row);
  g := ListTree.LtGrid(rows : rows);
  assert(_list_tree_weight(&g) == i32(3), "a grid's first cell");
});
