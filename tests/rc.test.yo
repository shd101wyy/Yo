pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio");
{ malloc, free } :: import("std/libc/stdlib");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ yield } :: import("std/async");
{ Arena } :: import("std/arena");
{ with_allocator } :: import("std/allocator");
{ hash_one } :: import("std/hash");
{ RefCell } :: import("std/sync/refcell");
Point :: struct(x : i32, y : i32);
derive(Point, Copy, Clone);
Wrapper :: struct(v : Rc(i32));
test("Test 'ref_count' function", {
  // Value type
  {
    p1 := Point(3, 4);
    assert(ref_count(p1) == 1, "ref_count(p1) == 1");
    p2 := p1;
    assert(ref_count(p1) == 1, "ref_count(p1) == 1"); // Should be no change.
    assert(ref_count(p2) == 1, "ref_count(p2) == 1");
  };
  // Reference type
  {
    b1 := Rc(i32)(3);
    assert(ref_count(b1) == 1, "ref_count(b1) == 1");
    {
      b2 := b1; // Yo performs dup/drop cancellation here.
      // So ref_count(b1) should remain 1.
      assert(ref_count(b1) == 1, "ref_count(b1) == 1");
      assert(ref_count(b2) == 1, "ref_count(b2) == 1");
      {
        b3 := b2;
        assert(ref_count(b1) == 2, "ref_count(b1) == 2");
        assert(ref_count(b2) == 2, "ref_count(b2) == 2");
        assert(ref_count(b3) == 2, "ref_count(b3) == 2");
      };
      assert(ref_count(b1) == 1, "ref_count(b1) == 1");
      assert(ref_count(b2) == 1, "ref_count(b2) == 1");
    }
  };
  // Value type containing reference type
  {
    w1 := Wrapper(Rc(i32)(5));
    assert(ref_count(w1) == 1, "ref_count(w1) == 1");
    assert(ref_count(w1.v) == 1, "ref_count(w1.v) == 1");
    w2 := w1;
    assert(ref_count(w1) == 1, "ref_count(w1) == 1"); // Should be no change.
    assert(ref_count(w2) == 1, "ref_count(w2) == 1");
    assert(ref_count(w1.v) == 2, "ref_count(w1.v) == 2"); // Also no change, due to dup/drop cancellation.
    assert(ref_count(w2.v) == 2, "ref_count(w2.v) == 2");
  };
});
test("Test explicit return and implicit return", {
  Foo :: ref(
    struct(
      data : Rc(i32)
    )
  );
  impl(
    Foo,
    new : (fn(val : i32) -> Self)(
      Self(data : rc(val))
    ),
    // This should generate a dup call
    get_data_implicit : (fn(self : &Self) -> Rc(i32))(
      self.data
    ),
    // THIS WORKS:
    get_data_explicit : (fn(self : &Self) -> Rc(i32))({
      return(self.data);
    })
  );
  foo := Foo.new(42);
  d1 := foo.get_data_implicit();
  assert(d1.* == 42, "d1.* == 42");
  d2 := foo.get_data_explicit();
  assert(d2.* == 42, "d2.* == 42");
});
test("Test Rc in different data structures", {
  // Anonymous struct
  {
    x := Rc(i32)(3);
    mut(y) := { x };
    z := { y };
    assert(x.* == 3, "x.* == 3");
    assert(y.x.* == 3, "y.x.* == 3");
    assert(z.y.x.* == 3, "z.y.x.* == 3");
    y.x = Rc(i32)(4);
    assert(y.x.* == 4, "y.x.* == 4");
    assert(z.y.x.* == 3, "z.y.x.* == 3");
  };
  // Nested boxes
  {
    x := rc(3);
    y := rc(x);
    z := rc(y);
    Rc.make_mut(&mut z) = rc(rc(10));
  };
  // Array containing Rc
  {
    x := Rc(i32)(3);
    y := [x,];
    z := [y,];
    m := [z,];
    n := [m,];
    assert(x.* == 3, "x.* == 3");
    assert(y(0).* == 3, "y(0).* ==");
    assert(z(0)(0).* == 3, "z(0)(0).* ==");
    assert(m(0)(0)(0).* == 3, "m(0)(0)(0).* ==");
    assert(n(0)(0)(0)(0).* == 3, "n(0)(0)(0)(0).* ==");
  };
  // Tuple containing Rc
  {
    x := Rc(i32)(3);
    y := (x,);
    mut(z) := (y,);
    m := (z,);
    n := (m,);
    z.0 = (rc(10),);
    assert(x.* == 3, "x.* == 3");
    assert(y.0.* == 3, "y.0.* == 3");
    assert(z.0.0.* == 10, "z.0.0.* == 10");
    assert(m.0.0.0.* == 3, "m.0.0.0.* == 3");
    assert(n.0.0.0.0.* == 3, "n.0.0.0.0.* == 3");
  };
});
// --- Phantom drop regression tests ---
// These test that match/cond inside function arguments don't cause phantom drops
// of undeclared temp variables (fixed in consumeCaseBodyTempVar).
test("Test match inside function arg - no phantom drop", {
  Color :: enum(Red, Green, Blue);
  color_name :: (fn(c : &Color) -> String)(
    match(
      c,
      .Red => `red`,
      .Green => `green`,
      .Blue => `blue`
    )
  );
  result := color_name(.Red);
  assert(result == `red`, "match inside fn arg should work");
  result2 := color_name(.Blue);
  assert(result2 == `blue`, "match inside fn arg should work for Blue");
});
test("Test cond inside function arg - no phantom drop", {
  classify :: (fn(x : i32) -> String)(
    cond(
      (x > i32(0)) => `positive`,
      (x < i32(0)) => `negative`,
      true => `zero`
    )
  );
  result := classify(i32(5));
  assert(result == `positive`, "cond inside fn arg should work");
  result2 := classify(i32(0));
  assert(result2 == `zero`, "cond inside fn arg should work for zero");
});
test("Test match returning RC object - no phantom drop", {
  Tag :: enum(A, B);
  make_string :: (fn(t : &Tag) -> String)(
    match(
      t,
      .A => `alpha`,
      .B => `beta`
    )
  );
  s1 := make_string(.A);
  s2 := make_string(.B);
  assert(s1 == `alpha`, "match returning RC String A");
  assert(s2 == `beta`, "match returning RC String B");
});
// Regression for inline-enum-match-subject-phantom-drop.md:
// constructing an enum with at least one object-payload variant directly as
// the subject of a match (not via a named local) used to emit a drop on an
// undeclared temp variable.
test("Test inline enum construction as match subject - no phantom drop", {
  Kind :: enum(Func, Arr, Obj(s : String));
  match(Kind.Func, .Func => (), _ => ());
  match(Kind.Arr, .Arr => (), _ => ());
  match(Kind.Obj(`payload`), .Obj(s) => assert(s == `payload`, "Obj payload"), _ => ());
});
// --- Array index access with RC types ---
// Regression tests for the inline incr_rc leak (array-index-rc-leak.md).
// Only ubuntu/Linux detected the leak via LeakSanitizer; macOS ARM lacks it.
test("Test array index access - no RC leak for inline use", {
  // Inline access: y(0).* should NOT dup (no ownership transfer)
  {
    x := Rc(i32)(42);
    y := [x,];
    assert(y(0).* == 42, "inline y(0).* should read without leak");
    assert(y(0).* == 42, "second inline y(0).* should also not leak");
    assert(y(0).* == 42, "third inline y(0).* should also not leak");
  };
  // Assigned access: tmp := y(0) should dup exactly once
  {
    x := Rc(i32)(7);
    y := [x,];
    tmp := y(0);
    assert(tmp.* == 7, "assigned y(0) should work");
    assert(ref_count(tmp) == 2, "tmp and y(0) should share RC=2");
    assert(ref_count(x) == 2, "x and y(0) are the same allocation");
  };
  // Multi-element array with inline access
  {
    a := Rc(i32)(10);
    b := Rc(i32)(20);
    c := Rc(i32)(30);
    arr := [a, b, c,];
    assert(arr(0).* == 10, "arr(0).* == 10");
    assert(arr(1).* == 20, "arr(1).* == 20");
    assert(arr(2).* == 30, "arr(2).* == 30");
  };
  // Nested array access with inline use
  {
    x := Rc(i32)(99);
    inner := [x,];
    outer := [inner,];
    assert(outer(0)(0).* == 99, "nested inline access should not leak");
  };
  // Array index used as function argument
  {
    identity :: (fn(b : &Rc(i32)) -> Rc(i32))(b);
    x := Rc(i32)(55);
    y := [x,];
    result := identity(&y(0));
    assert(result.* == 55, "array index as fn arg should dup correctly");
  };
});
test("Test ArrayList index access - no RC leak", {
  // ArrayList of Rc(i32) - inline access
  {
    list := ArrayList(Rc(i32)).new();
    list.push(Rc(i32)(100));
    list.push(Rc(i32)(200));
    list.push(Rc(i32)(300));
    assert(list(usize(0)).* == 100, "list(0).* == 100");
    assert(list(usize(1)).* == 200, "list(1).* == 200");
    assert(list(usize(2)).* == 300, "list(2).* == 300");
    // Multiple inline accesses should not leak
    assert(list(usize(0)).* == 100, "repeated list(0).* should not leak");
    assert(list(usize(0)).* == 100, "third list(0).* should not leak");
  };
  // ArrayList of Rc(i32) - assigned access
  {
    list := ArrayList(Rc(i32)).new();
    list.push(Rc(i32)(42));
    elem := list(usize(0));
    assert(elem.* == 42, "assigned elem.* should work");
  };
  // ArrayList of String - inline access
  {
    list := ArrayList(String).new();
    list.push(`hello`);
    list.push(`world`);
    assert(list(usize(0)) == `hello`, "list(0) == hello");
    assert(list(usize(1)) == `world`, "list(1) == world");
    // Repeated access should not leak
    assert(list(usize(0)) == `hello`, "repeated list(0) should not leak");
  };
  // ArrayList of String - assigned access
  {
    list := ArrayList(String).new();
    list.push(`test`);
    s := list(usize(0)).clone();
    assert(s == `test`, "assigned string from ArrayList should work");
  };
});
test("Test array of objects - no RC leak", {
  Container :: ref(struct(value : i32));
  // Inline access to array of objects
  {
    c1 := Container(i32(1));
    c2 := Container(i32(2));
    c3 := Container(i32(3));
    arr := [c1, c2, c3,];
    assert(arr(0).value == i32(1), "arr(0).value == 1");
    assert(arr(1).value == i32(2), "arr(1).value == 2");
    assert(arr(2).value == i32(3), "arr(2).value == 3");
  };
  // Assigned access to array of objects
  {
    c := Container(i32(42));
    arr := [c,];
    elem := arr(0);
    assert(elem.value == i32(42), "assigned object from array should work");
  };
  // Inline access does not increase RC
  {
    c := Container(i32(77));
    arr := [c,];
    val := arr(0).value;
    assert(val == i32(77), "inline field read works");
  };
});
test("Test array index in expressions - no RC leak", {
  // Array index inside comparison
  {
    x := Rc(i32)(10);
    y := Rc(i32)(10);
    arr := [x, y,];
    assert(arr(0).* == arr(1).*, "comparing array elements inline");
  };
  // Array index inside arithmetic
  {
    a := Rc(i32)(5);
    b := Rc(i32)(3);
    arr := [a, b,];
    sum := (arr(0).* + arr(1).*);
    assert(sum == 8, "sum of array elements via inline access");
  };
  // Array index used in cond
  {
    x := Rc(i32)(42);
    arr := [x,];
    result := cond(
      (arr(0).* > 0) => true,
      true => false
    );
    assert(result, "array index in cond should not leak");
  };
  // Deeply nested inline access
  {
    x := Rc(i32)(1);
    a := [x,];
    b := [a,];
    c := [b,];
    d := [c,];
    assert(d(0)(0)(0)(0).* == 1, "4-deep nested inline access should not leak");
  };
});
test("Test chained method calls - no duplicate var", {
  // Regression test: chained method calls on ArrayList should not
  // cause duplicate temp variable declarations in generated C.
  list := ArrayList(i32).new();
  list.push(i32(10));
  list.push(i32(20));
  list.push(i32(30));
  // Chained get_ptr access (the pattern that triggered the duplicate var bug)
  val := list(usize(1));
  assert(val == i32(20), "index access should work");
  val2 := list(usize(0));
  assert(val2 == i32(10), "index access should work at index 0");
});
test("Test nested && with RC temps - no phantom drop", {
  // Regression test: nested && should not emit drops for temp vars
  // declared inside inner conditional branches
  make_str :: (fn(s : str) -> String)(String.from(s));
  a := make_str("hello");
  b := make_str("world");
  c := make_str("test");
  // Nested &&: inner && creates temp vars that outer && must not drop
  result := ((a.len() > usize(0)) && (b.len() > usize(0)) && (c.len() > usize(0)));
  assert(result, "nested && should work with RC temps");
  // Nested || inside &&
  result2 := ((a.len() > usize(0)) && ((b.len() > usize(0)) || (c.len() > usize(0))));
  assert(result2, "nested || inside && should work with RC temps");
  // Triple nesting
  result3 := ((a.len() > usize(0)) && (b.len() > usize(0)) && ((c.len() > usize(0)) || (make_str("x").len() > usize(0))));
  assert(result3, "triple nested && || should work with RC temps");
  ();
});
test("Test early return of reassigned RC variable does not leak", {
  // Regression test for: issues/fixed/early-return-reassigned-rc-variable-leak.md
  //
  // When an RC variable is reassigned inside a while loop and returned early
  // from inside a match branch, the current value must be dropped after dup'ing
  // it for the return value.
  // (ArrayList is already imported at the top of this file)
  build_string :: (fn(parts : &ArrayList(str)) -> String)({
    mut(result) := String.new();
    mut(i) := usize(0);
    while(i < parts.len(), {
      match(
        parts.get(i),
        .Some(s) => {
          result = result.concat(String.from(s));
          i = (i + usize(1));
        },
        .None => {
          return(result);
        }
      );
    });
    result
  });
  parts := ArrayList(str).new();
  parts.push("hello ");
  parts.push("world");
  s := build_string(&parts);
  assert(s.len() == usize(11), "result should be 'hello world' (11 chars)");
  // If the RC is wrong (leak), ASAN will report it.
  assert(ref_count(s) == 1, "ref_count(s) should be 1 after early return");
});
test("Returning an OWNED RC local from inside a branch is not double-dropped", {
  // The `return(out)` below dups `out` for the caller (rc 1 -> 2) and the
  // early-return path must release the local exactly once (2 -> 1). Codegen
  // used to emit that release TWICE — once from the return's
  // earlyReturnOnlyDeferredDropExpressions and again from the consumed-var
  // escape drops — so rc hit 0, the buffer was freed, and the caller received a
  // dangling pointer. See issues/fixed/yo-return-owned-local-in-branch-double-drop.md.
  build :: (fn(early : bool) -> ArrayList(i32))({
    out := ArrayList(i32).new();
    if(early, {
      out.push(i32(7));
      return(out);
    });
    out.push(i32(2));
    out.push(i32(3));
    out
  });
  a := build(true);
  assert(a.len() == usize(1), "early-return branch should yield 1 element");
  assert(a(usize(0)) == i32(7), "the surviving element should be 7");
  assert(ref_count(a) == 1, "ref_count(a) should be 1 — dup for the caller, one release of the local");
  b := build(false);
  assert(b.len() == usize(2), "fallthrough should yield 2 elements");
  assert(b(usize(0)) == i32(2), "b(0) should be 2");
  assert(b(usize(1)) == i32(3), "b(1) should be 3");
  assert(ref_count(b) == 1, "ref_count(b) should be 1");
});
// Regression canary for the M3 early-return-drop attachment
// (issues/yo-self-compile-performance-rc-string-eq.md, "UNSOUND idea" +
// "Negative result 2026-10-04" sections): any future optimization of that
// walk — a hoist, or a shortcut pruning on `Expr.$.controlFlow` — must keep
// attaching a consumed local's drop at returns HIDDEN inside an `if`/`match`
// arm whose block tail is a plain statement: a begin's control flow is
// tail-position only, so such a block carries NO return flag and only a
// genuine subtree walk finds the cleanup point. A missed attachment leaks the
// still-initialized local on the early path (the counter falls short); an
// over-attachment double-drops it (the caller then reads a freed object).
(mut(g_m3_hidden_disposed) : i32) = i32(0);
M3HiddenRet :: ref(struct(tag : i32));
impl(
  M3HiddenRet,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_m3_hidden_disposed = (g_m3_hidden_disposed + i32(1));
    })
  )
);
m3_consume :: (fn(sink(v) : M3HiddenRet) -> i32)(v.tag);
m3_hidden_if :: (fn(early : bool) -> i32)({
  s := M3HiddenRet(tag : i32(11));
  if(early, {
    return(i32(0));
  });
  r := m3_consume(s);
  r + i32(1)
});
m3_hidden_match :: (fn(k : i32) -> i32)({
  s := M3HiddenRet(tag : i32(22));
  match(
    k,
    0 => {
      return(i32(7));
    },
    _ => ()
  );
  {
    r := m3_consume(s);
    r
  }
});
m3_two_locals :: (fn(early : bool) -> i32)({
  a := M3HiddenRet(tag : i32(33));
  b := M3HiddenRet(tag : i32(44));
  if(early, {
    return(i32(0));
  });
  ra := m3_consume(a);
  rb := m3_consume(b);
  ra + rb
});
test("a moved-out local is dropped on a return hidden in an if or match arm", {
  before := g_m3_hidden_disposed;
  // Early path: the return precedes the move, so the attachment must release
  // the still-initialized local exactly once per call.
  assert(m3_hidden_if(true) == i32(0), "hidden-if early path returns 0");
  assert((g_m3_hidden_disposed - before) == i32(1), "hidden-if early path disposed the local exactly once");
  assert(m3_hidden_if(false) == i32(12), "hidden-if fallthrough returns tag + 1");
  assert((g_m3_hidden_disposed - before) == i32(2), "hidden-if fallthrough disposed via the own-arg transfer");
  assert(m3_hidden_match(0) == i32(7), "hidden-match early path returns 7");
  assert((g_m3_hidden_disposed - before) == i32(3), "hidden-match early path disposed the local exactly once");
  assert(m3_hidden_match(1) == i32(22), "hidden-match fallthrough returns the tag");
  assert((g_m3_hidden_disposed - before) == i32(4), "hidden-match fallthrough disposed via the own-arg transfer");
  // Two consumed locals in one block: the hoist attaches EACH variable against
  // the collected cleanup nodes.
  assert(m3_two_locals(true) == i32(0), "two-locals early path returns 0");
  assert((g_m3_hidden_disposed - before) == i32(6), "both moved-out locals disposed on the hidden early path");
  assert(m3_two_locals(false) == i32(77), "two-locals fallthrough returns 33 + 44");
  assert((g_m3_hidden_disposed - before) == i32(8), "both locals disposed via their own-arg transfers");
});
// --- Inline `ref(enum)` payload-free variant construction ---
// Regression for issues/fixed/ref-enum-unit-variant-inline-construction-leak.md.
//
// A payload-free variant of a `ref(enum)` heap-allocates exactly like the
// payload-carrying form — codegen emits `__yo_new_<Enum>_<Variant>()`, which
// mallocs with ref_count = 1 — but the evaluator never attached an owning temp
// variable to it, so nothing was ever registered to drop the allocation.
// Passing one inline as an argument leaked it once per evaluation: the callee
// treats the parameter as borrowed and dups whatever it retains, so the
// constructor's own +1 was never released. LeakSanitizer caught this in
// tests/internal/context.test.yo, where `EvalValue.UnitVal` is passed inline to
// create_function_body_evaluation_context.
//
// The `ref_count()` assertions are the deterministic gate. The argument temp is
// released at `mk_*`'s scope end, so a caller reading the retained field
// afterwards sees rc == 1 when the release happened and rc == 2 when it leaked.
// That holds on every platform, unlike LeakSanitizer (Linux only) or macOS
// `leaks` (at -O2, LLVM deletes an allocation whose result is discarded, which
// hides exactly the non-argument positions covered by the second test).
//
// `mk_unit` / `mk_payload` use bare tail-expression bodies, so this test also
// gates the bare-tail scope-end drop: the self-hosted compiler used to emit no
// drop at all for the argument temp of a bare tail-expression body (both arms
// reported rc == 2 under it even though TS emitted the drop) — see
// issues/fixed/yo-self-tail-expression-arg-temp-drop-missing.md.
test("Inline ref-enum unit-variant argument is released by the caller", {
  Val :: ref(enum(UnitVal, IntVal(v : i32)));
  Held :: struct(v : Val);
  keep :: (fn(x : &Val) -> Held)(Held(v : x));
  mk_unit :: (fn() -> Held)(keep(Val.UnitVal));
  mk_payload :: (fn() -> Held)(keep(Val.IntVal(v : i32(7))));
  u := mk_unit();
  assert(ref_count(u.v) == 1, "payload-free variant: the caller must release its argument temp");
  p := mk_payload();
  assert(ref_count(p.v) == 1, "payload-carrying variant: unchanged");
  // A direct binding must TRANSFER ownership of the temp, not add a second owner.
  a := Val.UnitVal;
  assert(ref_count(a) == 1, "binding a unit variant owns exactly one reference");
  // Struct-literal field: the aggregate takes the allocation by move.
  h := Held(v : Val.UnitVal);
  assert(ref_count(h.v) == 1, "struct-literal field takes the unit variant by move");
});
test("Inline ref-enum unit-variant in non-argument positions does not leak", {
  Val :: ref(enum(UnitVal, IntVal(v : i32)));
  is_unit :: (fn(x : &Val) -> bool)(
    match(
      x,
      .UnitVal => true,
      .IntVal(v) => false
    )
  );
  // Discarded statement expression.
  Val.UnitVal;
  // Match subject.
  match(Val.UnitVal, .UnitVal => (), .IntVal(v) => ());
  // Condition and short-circuit operand positions, inside a loop so a
  // per-iteration leak accumulates instead of costing one object.
  (mut(i) : usize) = usize(0);
  while(i < usize(3), {
    c := cond(is_unit(Val.UnitVal) => true, true => false);
    assert(c, "cond condition");
    b := (is_unit(Val.UnitVal) && is_unit(Val.IntVal(v : i32(1))));
    assert(!b, "short-circuit operands");
    i = (i + usize(1));
  });
  // Enum-payload position: the outer variant takes the inner one by move.
  o := Option(Val).Some(Val.UnitVal);
  assert(
    match(
      o,
      .Some(v) => is_unit(&v),
      .None => false
    ),
    "Option payload"
  );
});
// Regression: a local dup'd inside ONE arm of an `if` (a macro expanding to
// cond) must keep its scope-end drop. The dup/drop pair optimizer used to
// reach the arm's dup through the raw macro-call args (branch-blind), cancel
// the pair, and mark the variable consumed — leaking one reference on every
// path that did not take the arm (issues/fixed/where-constraints-arraylist-96b-leak.md).
CondMoveHolder :: struct(items : ArrayList(i32));
g_cond_move_seen := ArrayList(ArrayList(i32)).new();
cond_move_make_fresh :: (fn() -> ArrayList(i32))({
  l := ArrayList(i32).new();
  g_cond_move_seen.push(l);
  l
});
cond_move_work :: (fn(flag : bool) -> unit)({
  entries := cond_move_make_fresh();
  if(flag, {
    h := CondMoveHolder(items : entries);
    assert(h.items.len() == usize(0), "held list is empty");
  });
});
test("Conditional move into a struct field balances both paths", {
  cond_move_work(true);
  cond_move_work(false);
  taken := match(g_cond_move_seen.get(usize(0)), .Some(l) => l, .None => ArrayList(i32).new());
  skipped := match(g_cond_move_seen.get(usize(1)), .Some(l) => l, .None => ArrayList(i32).new());
  assert(
    ref_count(taken) == ref_count(skipped),
    "skipped-branch call must not retain an extra reference"
  );
});
// Regression: the loop-traversal borrow-chain optimization
// (optimizeLoopTraversalBorrowChain) must NOT fire when the loop body
// mutates the structure it traverses. Severing head.next while current_opt
// borrowed the severed sublist freed the nodes mid-walk — the traversal then
// read freed memory and visited garbage (use-after-free, found 2026-08-06).
TraversalNode :: ref(struct(value : i32, next : Option(Self)));
traversal_walk_with_sever :: (fn(head : &TraversalNode) -> i32)({
  (mut(current_opt) : Option(TraversalNode)) = head.next;
  (mut(first) : bool) = true;
  (mut(total) : i32) = 0;
  while(true, {
    match(
      current_opt,
      .None => return(total),
      .Some(current) => {
        if(first, {
          first = false;
          head.next = Option(TraversalNode).None;
        });
        total = (total + current.value);
        current_opt = current.next;
      }
    );
  });
  total
});
test("Loop traversal keeps ownership when the loop mutates the structure", {
  head := TraversalNode(
    value : 1,
    next : Option(TraversalNode).Some(
      TraversalNode(
        value : 2,
        next : Option(TraversalNode).Some(TraversalNode(value : 3, next : Option(TraversalNode).None))
      )
    )
  );
  assert(
    traversal_walk_with_sever(&head) == 5,
    "severed traversal must still visit nodes 2 and 3 (owned, not borrowed)"
  );
});
// Regression: a fn whose ENTIRE body is a bare `___ := <owned value>`
// statement. The self-hosted compiler once flushed the body-level deferred
// drops BEFORE the statement, emitting `___drop(___)` against a binding not
// yet declared in C — the emitted program failed to compile (`use of
// undeclared identifier '___'`), and reordering must still drop the
// discarded value (issues/fixed/yo-self-tail-expression-arg-temp-drop-missing.md,
// follow-up commit).
g_discard_seen := ArrayList(ArrayList(i32)).new();
discard_make_tracked :: (fn() -> ArrayList(i32))({
  l := ArrayList(i32).new();
  g_discard_seen.push(l);
  l
});
discard_stmt_body :: (fn() -> unit)(___ := discard_make_tracked());
test("Bare discard-statement fn body compiles and drops the discarded value", {
  discard_stmt_body();
  survivor := match(g_discard_seen.get(usize(0)), .Some(l) => l, .None => ArrayList(i32).new());
  // rc = 3: the g_discard_seen element, the match-arm extraction, and
  // `survivor` itself. Before the fix the discarded value kept a 4th ref
  // (and, under the self-hosted compiler, this file did not even compile —
  // `use of undeclared identifier '___'`).
  assert(
    ref_count(survivor) == 3,
    "discarded value must be dropped (rc 3, not 4)"
  );
});
// Regression (issues/fixed/borrowed-arg-invalidated-by-aliased-container-mutation.md,
// aliasing Stage 0): an RC-typed field PROJECTION passed to a BORROWING
// parameter gets a caller-owned +1 for the call. Without it, `poke(w, w.b)`
// reassigning `w.b` in a LOOP freed the old box mid-call (the loop cannot
// defer the old-value drop across iterations) — the borrowed parameter then
// read a RECYCLED allocation (printed 101, the newest box, instead of 42).
AliasWrap :: ref(struct(b : Rc(i32)));
alias_poke_loop :: (fn(w : &AliasWrap, borrowed : &Rc(i32)) -> unit)({
  (mut(i) : i32) = i32(0);
  while(runtime(i < i32(2)), {
    w.b = rc(i32(100) + i);
    i = (i + i32(1));
  });
  assert(borrowed.* == i32(42), "borrowed projection reads the pre-mutation value");
});
test("borrowed projection argument survives aliased container mutation", {
  w := AliasWrap(b : rc(i32(42)));
  b0 := w.b;
  assert(ref_count(b0) == 2, "w.b + b0 before the call");
  {
    alias_poke_loop(&w, &w.b);
  };
  // Asserted AFTER the enclosing statement scope, deliberately. The two
  // compilers release the Stage-0 +1 at different points — yo-self drops it
  // post-call (its dup temp is consumed at creation and balanced by an
  // explicit call-node drop), TS at scope end (its dup temp stays owning and
  // the normal scope-end machinery drops it). Both are sound; the difference
  // is only WHEN, and it is only observable through `ref_count`. Checking here, once
  // both release points have passed, asserts the property that actually
  // matters and is identical in both: the +1 is released EXACTLY once.
  //
  // rc 2 here = the +1 leaked (which is precisely what yo-self's
  // runtime-call path did before that drop was wired — the previous version
  // of this test asserted rc 2 right after the call and so encoded the leak
  // as expected behaviour). rc 0 / a crash = it was released twice.
  assert(ref_count(b0) == 1, "the Stage-0 +1 is released exactly once");
  assert(b0.* == i32(42), "original box intact after the aliased mutation");
});
// Aliasing Stage 1 (mutation summaries): a READ-ONLY callee cannot
// invalidate the borrowed projection, so the Stage-0 +1 is elided — during
// the call the box's rc stays 2 (w.b + b0), not 3. The non-generic callee
// exercises the mark-time skip; the generic one exercises the
// post-specialization unmark.
stage1_read_borrow :: (fn(w : &AliasWrap, borrowed : &Rc(i32)) -> usize)(
  ref_count(borrowed)
);
stage1_rc_of :: (fn(generic(T : Type), borrowed : &T) -> usize)(
  ref_count(borrowed)
);
test("read-only callee elides the Stage-0 borrowed-projection dup", {
  w := AliasWrap(b : rc(i32(42)));
  b0 := w.b;
  assert(ref_count(b0) == 2, "w.b + b0 before the calls");
  assert(
    stage1_read_borrow(&w, &w.b) == 2,
    "non-generic read-only callee sees rc 2 (mark-time skip)"
  );
  assert(
    stage1_rc_of(&w.b) == 2,
    "generic read-only callee sees rc 2 (post-specialization unmark)"
  );
  assert(ref_count(b0) == 2, "ref_count balanced after both elided calls");
});
// Aliasing Stage 1 SOUNDNESS: the mutation-summary walk must not be fooled by
// a mutation hidden behind a STATEMENT. An assignment carries a compile-time
// UNIT value simply because that is its type — not because it was folded away
// — so a walk that treats "has a compile-time value" as "emits no runtime
// code" skips the statement whole, never sees the mutating call on its
// right-hand side, and wrongly reports the caller read-only. That would elide
// the Stage-0 dup and reopen the aliasing hole this whole arc closes.
stage1_poke :: (fn(w : &AliasWrap, seed : i32) -> i32)({
  w.b = rc(i32(100) + seed);
  w.b.*
});
// The mutating call sits on the RHS of a REASSIGNMENT statement.
stage1_sneaky :: (fn(w : &AliasWrap, borrowed : &Rc(i32), seed : i32) -> i32)({
  (mut(t) : i32) = i32(0);
  t = stage1_poke(w, seed);
  borrowed.* + (t - t)
});
// Control: the same mutation behind a `:=` declaration.
stage1_honest :: (fn(w : &AliasWrap, borrowed : &Rc(i32), seed : i32) -> i32)({
  t := stage1_poke(w, seed);
  borrowed.* + (t - t)
});
// Regression (issues/fixed/array-of-rc-constructor-emits-invalid-c.md): the
// `Array(T, N)(...)` CONSTRUCTOR used to manufacture UnknownValue placeholders
// for runtime elements and then stamp the array as a compile-time constant, so
// codegen emitted `.data = { /* skip generating */, ... }` — an empty
// initializer slot — and every array of RC elements failed to compile. The
// array-LITERAL form already guarded correctly, so the two must agree.
test("arrays of RC elements build at runtime, constructor and literal alike", {
  b1 := rc(i32(42));
  lit := [b1, rc(i32(7)),];
  assert(lit(0).* == i32(42), "literal element 0");
  assert(lit(1).* == i32(7), "literal element 1");
  b2 := rc(i32(42));
  ctor := Array(Rc(i32), 2)(b2, rc(i32(7)));
  assert(ctor(0).* == i32(42), "constructor element 0");
  assert(ctor(1).* == i32(7), "constructor element 1");
  // The two forms must not diverge in ownership either.
  assert(ref_count(b1) == ref_count(b2), "constructor and literal agree on element rc");
  // A fully compile-time array still folds to a constant.
  c :: Array(i32, 3)(1, 2, 3);
  assert(c(2) == 3, "comptime array still folds");
});
// Aliasing STAGE 0 SOUNDNESS — the rules deciding WHICH arguments get
// protected at all. Stage 1 can only elide a dup Stage 0 created, so a shape
// Stage 0 declines to mark is unprotected whatever Stage 1 concludes.
//
// The borrowed argument here is an INDEX read, not a field access. The
// projection predicate used to require a 2-arg dot, and the marker used to
// skip any argument carrying a `$.value` — but a runtime element read carries
// an `UnknownValue`, a value OBJECT meaning "type known, value not". Between
// them every indexed borrow went unprotected: this read 101 (the recycled
// allocation) instead of 42. A fixed-size Array is the shape that
// discriminates — ArrayList index reads go through the Index trait and yield
// an OWNING temp, so they were already safe at +0.
Stage0Arr :: ref(struct(a : Array(Rc(i32), 2)));
stage0_poke_index :: (fn(h : &Stage0Arr, borrowed : &Rc(i32)) -> i32)({
  (mut(i) : i32) = i32(0);
  while(runtime(i < i32(2)), {
    h.a(0) = rc(i32(100) + i);
    i = (i + i32(1));
  });
  borrowed.*
});
test("an INDEXED borrowed argument is protected like a field projection", {
  h := Stage0Arr(a : Array(Rc(i32), 2)(rc(i32(42)), rc(i32(7))));
  assert(
    stage0_poke_index(&h, &h.a(0)) == i32(42),
    "an element read is a place into container storage too"
  );
});
// Aliasing Stage 1 SOUNDNESS — one probe per "this callee is read-only"
// decision rule in the mutation-summary walk. Each callee below invalidates
// the borrowed projection through a DIFFERENT mechanism; every one must be
// classified may-mutate so the Stage-0 +1 is kept. A rule that wrongly
// answers read-only shows up here as a use-after-free, not as a subtle
// slowdown — which is why these are asserted on VALUE, not just rc balance.
//
// An explicit RC decrement releases the container-held reference directly,
// without any assignment for the walk's assignment rule to see. Both the
// high-level drop and the raw primitive count.
// NOTE on shape: the decrement must target a handle the callee OWNS. An
// explicit `___drop(w.b)` on a place the callee does not own is an
// unbalanced program — it releases the container's reference without
// clearing the field, so dropping the container later double-frees. (macOS's
// allocator tolerates that; glibc aborts. It is a bug in the test, not in
// the compiler.) Raw `__yo_decr_rc` is unbalanced in EVERY shape — it does
// not consume its operand, so the scope-end drop decrements a second time —
// so no valid program exercises it and it gets no test; the classification
// rule still lists it, documented in mutation-summary.ts.
stage1_drop_owned :: (fn(sink(h) : Rc(i32), borrowed : &Rc(i32)) -> usize)({
  ___drop(h);
  ref_count(borrowed)
});
// The mutation happens only on the BACK EDGE of a mutual recursion, so the
// walk meets the cycle guard before it ever reaches the assignment.
Stage1Rec :: struct(_d : i32);
impl(
  Stage1Rec,
  even : (fn(w : &AliasWrap, borrowed : &Rc(i32), n : i32) -> i32)(
    cond(
      (n == i32(0)) => borrowed.*,
      true => Stage1Rec.odd(w, borrowed, n - i32(1))
    )
  ),
  odd : (fn(w : &AliasWrap, borrowed : &Rc(i32), n : i32) -> i32)({
    w.b = rc(i32(777));
    Stage1Rec.even(w, borrowed, n - i32(1))
  })
);
// The mutation is inside an immediately-invoked closure — the walk skips
// function DEFINITIONS, so it must still catch the CALL.
stage1_closure :: (fn(w : &AliasWrap, borrowed : &Rc(i32)) -> i32)({
  f := (fn(ww : &AliasWrap) -> i32)({
    ww.b = rc(i32(888));
    i32(0)
  });
  z := f(w);
  borrowed.* + z
});
// The mutation sits in a runtime-selected cond arm, then a match arm — the
// walk must not let arm-skipping (`caseExecuted`) hide a live branch.
stage1_cond_arm :: (fn(w : &AliasWrap, borrowed : &Rc(i32), go : bool) -> i32)({
  cond(
    (go == true) => {
      w.b = rc(i32(555));
      i32(0)
    },
    true => i32(0)
  );
  borrowed.*
});
stage1_match_arm :: (fn(w : &AliasWrap, borrowed : &Rc(i32), o : Option(i32)) -> i32)({
  match(
    o,
    .Some(_) => {
      w.b = rc(i32(666));
      ()
    },
    .None => ()
  );
  borrowed.*
});
// Transitivity: the mutation is three calls deep.
stage1_deep3 :: (fn(w : &AliasWrap) -> unit)({
  w.b = rc(i32(333));
});
stage1_deep2 :: (fn(w : &AliasWrap) -> unit)(
  stage1_deep3(w)
);
stage1_deep1 :: (fn(w : &AliasWrap, borrowed : &Rc(i32)) -> i32)({
  stage1_deep2(w);
  borrowed.*
});
// Over-conservatism guard: a callee whose only "effect" is a benign extern
// (printf takes no callback and is not the runtime/allocator family) must
// STILL be read-only, so the +1 is elided. If this starts failing, the
// extern rule has become too broad and Stage 1 is losing its benefit.
stage1_benign_extern :: (fn(w : &AliasWrap, borrowed : &Rc(i32)) -> usize)({
  unsafe(printf(""));
  ref_count(borrowed)
});
test("mutation inside a runtime cond arm keeps the borrow alive", {
  w := AliasWrap(b : rc(i32(42)));
  assert(
    stage1_cond_arm(&w, &w.b, true) == i32(42),
    "a live cond arm's mutation must count"
  );
});
test("mutation inside a match arm keeps the borrow alive", {
  w := AliasWrap(b : rc(i32(42)));
  assert(
    stage1_match_arm(&w, &w.b, Option(i32).Some(i32(1))) == i32(42),
    "a live match arm's mutation must count"
  );
});
test("mutation three calls deep keeps the borrow alive", {
  w := AliasWrap(b : rc(i32(42)));
  assert(
    stage1_deep1(&w, &w.b) == i32(42),
    "the summary must be transitive through the call graph"
  );
});
test("a benign extern does not defeat the read-only elision", {
  w := AliasWrap(b : rc(i32(42)));
  b0 := w.b;
  assert(ref_count(b0) == 2, "w.b + b0 before the call");
  assert(
    stage1_benign_extern(&w, &w.b) == 2,
    "printf must not make a callee may-mutate (elision preserved)"
  );
});
test("a callee containing an explicit ___drop keeps the borrow alive", {
  w := AliasWrap(b : rc(i32(42)));
  // rc during the call: the container's 1, the own-param's dup, and the
  // Stage-0 borrow dup = 3; `___drop(h)` consumes the own-param's, leaving
  // 2. A 1 here would mean the borrow dup was elided — i.e. a callee that
  // explicitly releases RC storage was classified read-only, which is how
  // `___drop` sitting in the safe-recurse list used to read.
  assert(
    stage1_drop_owned(w.b, &w.b) == 2,
    "an explicit ___drop must not be walked through as safe"
  );
  assert(w.b.* == i32(42), "the container's own handle is still valid");
});
test("mutation on a mutual-recursion back edge keeps the borrow alive", {
  w := AliasWrap(b : rc(i32(42)));
  assert(
    Stage1Rec.even(&w, &w.b, i32(2)) == i32(42),
    "cycle-guard optimism must not hide the back edge's mutation"
  );
});
test("mutation inside an invoked closure keeps the borrow alive", {
  w := AliasWrap(b : rc(i32(42)));
  assert(
    stage1_closure(&w, &w.b) == i32(42),
    "skipping closure DEFINITIONS must not skip the closure CALL"
  );
});
test("statement-hidden mutation keeps the borrowed-projection dup", {
  w := AliasWrap(b : rc(i32(42)));
  // The callee reassigns `w.b`, dropping the 42-box's container reference.
  // Without the caller's Stage-0 +1 the borrow would read recycled memory.
  assert(
    stage1_sneaky(&w, &w.b, i32(0)) == i32(42),
    "borrow survives a mutation hidden behind a reassignment statement"
  );
  w2 := AliasWrap(b : rc(i32(42)));
  assert(
    stage1_honest(&w2, &w2.b, i32(0)) == i32(42),
    "borrow survives a mutation behind a declaration"
  );
});
// Regression: aliasing a ref local must drop each object EXACTLY ONCE.
//
// `b := a` creates ONE deferred `___dup`, keyed under `a`. The dup/drop pair
// optimizer cancels it against the scope-end drop of one variable in the alias
// chain, and whichever it reaches first wins. yo-self walked the frame forwards
// and cancelled the wrong one; TS iterates `getVariablesNeedingDrop`, which is
// already reversed (src/env.ts:2304). The same root cause showed up as a DOUBLE
// FREE in one shape (tests/ref_local_binding.test.yo, which aborted under glibc
// and passed under macOS malloc) and as a LEAK in the reassignment shape below.
//
// Counting disposals is deliberate. The miscount happens at SCOPE END, after any
// in-body assert could observe it, and whether a double free actually crashes is
// allocator-dependent — which is exactly why this stayed invisible on macOS.
// The counter is MODULE-LEVEL on purpose: module-level mutables have program
// lifetime and are never dropped (getVariablesNeedingDrop skips isModuleLevel),
// so it is still readable after the handles are gone. A counter stored INSIDE
// the handle is not — passing it into the struct hands over ownership, so
// disposing the handle frees the counter and reading it afterwards is a UAF.
(mut(g_alias_disposed) : i32) = i32(0);
AliasHandle :: ref(struct(tag : i32));
impl(
  AliasHandle,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_alias_disposed = (g_alias_disposed + i32(1));
    })
  )
);
// CONTROL, not the regression guard: this shape disposed correctly even before
// the fix, so it cannot catch the original bug. It is kept because it DOES guard
// the reversal itself — if walking the frame backwards ever broke the simple
// single-alias case, this is what fails. The discriminating test is the next one.
test("aliasing a ref local disposes the object exactly once", {
  {
    a := AliasHandle(tag : i32(1));
    b := a;
    assert(b.tag == i32(1), "the alias sees the same object");
    assert(g_alias_disposed == i32(0), "nothing disposed while the scope is live");
  };
  assert(
    g_alias_disposed == i32(1),
    "the aliased object is disposed exactly once, not twice and not never"
  );
});
test("reassigning after aliasing disposes both objects exactly once", {
  {
    mut(a) := AliasHandle(tag : i32(1));
    b := a;
    a = AliasHandle(tag : i32(2));
    assert(b.tag == i32(1), "b keeps the original object alive");
    assert(a.tag == i32(2), "a points at the replacement");
  };
  // Two objects were created, so two disposals. Before the fix this reported
  // ONE — the original was never disposed at all.
  assert(
    g_alias_disposed == i32(2),
    "both the original and the replacement are disposed exactly once each"
  );
});
// Regression (issues/fixed/dyn-box-dispose-is-emitted-with-an-empty-body.md):
// an `own(name) : T` parameter of a GENERIC function must release the reference
// the caller transferred in. The callee-side binding was not marked owning, so
// the scope-end drop was never scheduled while the body's store still emitted
// the balancing `___dup` — a net +1 per call. The prelude's
// `box :: (fn(generic(V : Type), own(value) : V) -> Rc(V))(Rc(V)(value))` is
// the highest-traffic instance: the boxed value kept a second reference that
// nobody owned, so it could never reach zero.
test("box takes ownership of its argument without retaining an extra reference", {
  h := Rc(i32)(7);
  b := rc(h);
  assert(ref_count(b.*) == 1, "the box holds the only reference to its value");
});
// The class is wider than `box`: EVERY `own` parameter of a generic function
// leaked, whatever the body did with it. `own_ident` below already failed the
// very first assertion before the fix. The `String` round trip at the end is
// the over-drop canary — an over-drop would have freed the buffer before the
// read.
(mut(g_own_param_freed) : i32) = i32(0);
OwnParamRes :: ref(struct(tag : i32));
impl(
  OwnParamRes,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_own_param_freed = (g_own_param_freed + i32(1));
    })
  )
);
own_ident :: (fn(generic(V : Type), sink(v) : V) -> V)(v);
own_via_local :: (fn(generic(V : Type), sink(v) : V) -> V)({
  w := v;
  w
});
OwnHolder :: (fn(comptime(V) : Type) -> comptime(Type))(ref(struct(item : V)));
own_hold :: (fn(generic(V : Type), sink(v) : V) -> OwnHolder(V))(OwnHolder(V)(item : v));
own_discard :: (fn(generic(V : Type), sink(v) : V) -> i32)(i32(1));
test("an own parameter of a generic function releases its value exactly once", {
  before := g_own_param_freed;
  {
    a := own_ident(OwnParamRes(tag : i32(1)));
    assert(a.tag == i32(1), "the returned value is alive");
    assert(g_own_param_freed == before, "nothing released while the value is alive");
  };
  assert((g_own_param_freed - before) == i32(1), "returned directly: released once");
  {
    b := own_via_local(OwnParamRes(tag : i32(2)));
    assert(b.tag == i32(2), "the value moved through a local is alive");
  };
  assert((g_own_param_freed - before) == i32(2), "moved through a local: released once");
  {
    c := own_hold(OwnParamRes(tag : i32(3)));
    assert(c.item.tag == i32(3), "the held value is alive");
  };
  assert((g_own_param_freed - before) == i32(3), "stored in a generic struct: released once");
  {
    d := own_discard(OwnParamRes(tag : i32(4)));
    assert(d == i32(1), "the discarding callee returns 1");
  };
  assert((g_own_param_freed - before) == i32(4), "never used by the callee: released once");
  s := own_ident(`round trip`);
  assert(s == `round trip`, "a String survives the round trip through an own parameter");
});
// Regression (issues/fixed/alias-elision-base-reassigned-in-nested-block-uaf.md):
// `h2 := h` shares ONE count (the alias dup is elided and `h2` is marked
// consumed, so `h` keeps the count). Reassigning `h` INSIDE a nested block
// scheduled the old value's drop at that block's end — before the outer alias's
// last use — so `h2` read freed memory (GuardMalloc SEGV). The optimizer now
// keeps the dup whenever the base is reassigned anywhere in the block.
AliasHolder :: ref(struct(n : i32));
test("alias survives a reassignment of its base inside a nested block", {
  mut(h) := AliasHolder(n : i32(1));
  h2 := h;
  {
    h.n = i32(7);
    h = AliasHolder(n : i32(100));
  };
  assert(h2.n == i32(7), "the alias still names the original object");
  assert(h.n == i32(100), "the base names the replacement");
  assert(ref_count(h2) == 1, "the original is owned by the alias alone");
  assert(ref_count(h) == 1, "the replacement is owned by the base alone");
});
test("alias made inside a nested block, base reassigned there, base used after", {
  mut(h) := AliasHolder(n : i32(1));
  {
    h2 := h;
    h2.n = i32(9);
    h = AliasHolder(n : i32(100));
    assert(h2.n == i32(9), "inner alias reads the original");
  };
  assert(h.n == i32(100), "outer base reads the replacement");
  assert(ref_count(h) == 1, "one owner");
});
// Same optimizer, the two sibling shapes (issues/fixed/alias-elision-base-reassigned-in-nested-block-uaf.md):
// reassigning the ALIAS dropped a value the alias never owned (its
// replacement leaked), and a chained alias with the base reassigned in a
// nested block under-released. Drop deltas pin "every object exactly once".
test("reassigning the alias itself disposes both objects exactly once", {
  before := g_alias_disposed;
  {
    a := AliasHandle(tag : i32(1));
    mut(b) := a;
    b = AliasHandle(tag : i32(3));
    assert(a.tag == i32(1), "a keeps the original");
    assert(b.tag == i32(3), "b names the replacement");
  };
  assert(g_alias_disposed == (before + i32(2)), "original and replacement disposed exactly once each");
});
test("chained aliases with the base reassigned in a nested block", {
  before := g_alias_disposed;
  {
    mut(a) := AliasHandle(tag : i32(1));
    b := a;
    c := b;
    {
      a = AliasHandle(tag : i32(2));
    };
    assert((b.tag == i32(1)) && (c.tag == i32(1)), "both aliases still name the original");
    assert(a.tag == i32(2), "the base names the replacement");
  };
  assert(g_alias_disposed == (before + i32(2)), "original and replacement disposed exactly once each");
});
test("alias made in an inner block, base reassigned there, base used after", {
  before := g_alias_disposed;
  {
    mut(a) := AliasHandle(tag : i32(1));
    {
      b := a;
      b.tag = i32(9);
      a = AliasHandle(tag : i32(2));
      assert(b.tag == i32(9), "the inner alias reads the original");
    };
    assert(a.tag == i32(2), "the outer base reads the replacement");
  };
  assert(g_alias_disposed == (before + i32(2)), "original and replacement disposed exactly once each");
});
// A handle lent `&mut` keeps its own count
// (issues/fixed/2026-10-15-an-aliased-rc-handle-lent-mut-to-a-call-is-freed-under-its-alias.md):
// the alias elision let `b := a` share ONE count with `a`, so a callee that
// stored a new handle through `&mut b` (or a `self : &mut Self` method on `b`)
// released the shared count and freed the object `a` still named. The drop
// tally sums the tags: 1 + 10 exactly when each object is dropped once.
(mut(g_lend_dropped_tags) : i32) = i32(0);
_LendHandle :: ref(struct(tag : i32));
impl(
  _LendHandle,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_lend_dropped_tags = (g_lend_dropped_tags + self.tag);
    })
  )
);
impl(
  _LendHandle,
  /// Replace the caller's handle with a new object.
  replace_with : (fn(self : &mut Self, tag : i32) -> unit)({
    self = _LendHandle(tag : tag);
  })
);
_lend_replace :: (fn(h : &mut _LendHandle, tag : i32) -> unit)({
  h = _LendHandle(tag : tag);
});
test("an alias lent &mut to a call that replaces it leaves the base its object", {
  before := g_lend_dropped_tags;
  {
    a := _LendHandle(tag : i32(1));
    b := a;
    _lend_replace(&mut b, i32(10));
    assert(a.tag == i32(1), "a still names the original");
    assert(b.tag == i32(10), "b names the replacement");
    assert(ref_count(a) == 1, "the original is a's alone");
  };
  assert(g_lend_dropped_tags == (before + i32(11)), `each object dropped once, got ${(g_lend_dropped_tags - before).to_string()}`);
});
test("a base lent &mut to a call that replaces it leaves the alias its object", {
  before := g_lend_dropped_tags;
  {
    a := _LendHandle(tag : i32(1));
    b := a;
    _lend_replace(&mut a, i32(10));
    assert(b.tag == i32(1), "b still names the original");
    assert(a.tag == i32(10), "a names the replacement");
  };
  assert(g_lend_dropped_tags == (before + i32(11)), `each object dropped once, got ${(g_lend_dropped_tags - before).to_string()}`);
});
test("an alias whose &mut self method replaces it leaves the base its object", {
  before := g_lend_dropped_tags;
  {
    a := _LendHandle(tag : i32(1));
    b := a;
    b.replace_with(i32(10));
    assert(a.tag == i32(1), "a still names the original");
    assert(b.tag == i32(10), "b names the replacement");
  };
  assert(g_lend_dropped_tags == (before + i32(11)), `each object dropped once, got ${(g_lend_dropped_tags - before).to_string()}`);
});
// ---------------------------------------------------------------------------
// A local stored into a struct field that lives in a NESTED block keeps its
// own count.
//
// `_optimize_dup_drop_pairs` cancels a local's single dup against its
// scope-end drop and calls the result a move. That is sound only while the
// container the dup fed OUTLIVES the local — and it does not when the
// container is declared in an inner block, because the inner block's scope end
// releases the field first. The outer local was then dangling for the rest of
// its own scope:
//
//   sink := S.new();
//   { h := H(sink : sink); };   // h dies here, taking sink's only count
//   sink.count();               // use after free
//
// The non-atomic path hid it behind a correct-looking answer: a `ref` holding
// a `ref` is cycle-capable, so it is GC-TRACKED and `__yo_decr_rc` buffers a
// possible root instead of freeing on the spot. An `atomic(ref(...))` is
// atomically counted, never tracked, so the free is immediate and the read faults.
// issues/fixed/a-local-stored-in-a-struct-field-is-dangling-after-the-container-dies.md
//
// The oracle is a Drop counter rather than a value read, because it catches
// BOTH directions: a missing dup frees early (the bug), and an unmatched dup
// never disposes at all (the over-correction).
// ---------------------------------------------------------------------------
(mut(g_nested_disposed) : i32) = i32(0);
NestedSink :: ref(struct(tag : i32));
impl(
  NestedSink,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_nested_disposed = (g_nested_disposed + i32(1));
    })
  )
);
NestedHolder :: ref(struct(label : i32, sink : NestedSink));
test("a local stored into a container in a NESTED block outlives that block", {
  before := g_nested_disposed;
  {
    sink := NestedSink(tag : i32(1));
    {
      h := NestedHolder(label : i32(2), sink : sink);
      assert(h.label == i32(2), "the container sees its own field");
    };
    // The container is gone. `sink` must still be alive here — it is a live
    // local of THIS scope and nothing has consumed it.
    assert(g_nested_disposed == before, "the inner block's container did not take the outer local with it");
    assert(sink.tag == i32(1), "and the outer local still reads correctly");
  };
  assert(
    g_nested_disposed == (before + i32(1)),
    "disposed exactly once, when its own scope ended — not twice, and not never"
  );
});
test("a container two blocks deep does not take the outer local either", {
  before := g_nested_disposed;
  {
    sink := NestedSink(tag : i32(3));
    {
      {
        h := NestedHolder(label : i32(4), sink : sink);
        assert(h.label == i32(4), "the container sees its own field");
      };
      ()
    };
    assert(sink.tag == i32(3), "still readable through two closed scopes");
  };
  assert(g_nested_disposed == (before + i32(1)), "and disposed exactly once");
});
// OVER-CANCELLATION CANARY. The gate above must not fire on a container in the
// SAME scope: that cancellation is correct — drops run in reverse declaration
// order, so the container is released before the local it borrowed from — and
// keeping it is what stops every struct store from costing a dup/drop pair
// again. If this ever reports two disposes the gate has gone too wide in the
// other direction; if it reports none, a dup is unmatched.
test("a container in the SAME scope still shares one count", {
  before := g_nested_disposed;
  {
    sink := NestedSink(tag : i32(5));
    h := NestedHolder(label : i32(6), sink : sink);
    assert(h.label == i32(6), "the container sees its own field");
    assert(sink.tag == i32(5), "and the local still reads");
    assert(g_nested_disposed == before, "nothing disposed while both are live");
  };
  assert(g_nested_disposed == (before + i32(1)), "disposed exactly once at the shared scope end");
});
test("a container in a cond arm and in a while body behave the same way", {
  before := g_nested_disposed;
  {
    sink := NestedSink(tag : i32(7));
    cond(
      true => {
        h := NestedHolder(label : i32(8), sink : sink);
        assert(h.label == i32(8), "the arm's container sees its field");
      },
      true => ()
    );
    assert(sink.tag == i32(7), "readable after the arm");
    (mut(i) : i32) = i32(0);
    while(i < i32(3), i = (i + i32(1)), {
      w := NestedHolder(label : i, sink : sink);
      assert(w.label == i, "the loop body's container sees its field");
    });
    assert(sink.tag == i32(7), "and after three loop iterations");
  };
  assert(
    g_nested_disposed == (before + i32(1)),
    "still exactly one dispose: a loop body taking a reference per iteration must release it per iteration"
  );
});
// Regression: a short-circuit operand INSIDE a bare (non-block) body — a
// match arm, a cond arm, a single-expression fn body, a loop body — declares
// its temps inside the `if (lhs) {` C block the `&&`/`||` lowers to, and can
// only drop them there. The bare-body emitters did not feed the body's
// scope-end drops into the pending path (the block-body emitters did), so the
// temp's drop was left to the post-call flush AFTER the block closed: an
// undeclared C identifier, i.e. the whole test file failed to compile
// (issues/fixed/short-circuit-rhs-temp-in-bare-arm-body-drops-out-of-scope.md).
// Drop deltas pin "exactly once" so the in-branch drop is neither missing
// nor doubled.
(mut(g_sc_disposed) : i32) = i32(0);
ScHandle :: ref(struct(tag : i32));
impl(
  ScHandle,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_sc_disposed = (g_sc_disposed + i32(1));
    })
  )
);
mk_sc :: (fn(n : i32) -> ScHandle)(ScHandle(tag : n));
mk_sc_opt :: (fn(n : i32) -> Option(ScHandle))(Option(ScHandle).Some(ScHandle(tag : n)));
sc_check_body :: (fn(c : bool) -> unit)(assert(c && (mk_sc(i32(3)).tag == i32(3)), "single-expression fn body"));
(mut(g_sc_i) : usize) = usize(0);
sc_step :: (fn(ok : bool) -> unit)({
  g_sc_i = if(ok, g_sc_i + usize(1), usize(99));
});
test("short-circuit RHS temp inside a bare match arm is dropped in the branch", {
  before := g_sc_disposed;
  r := Result(bool, String).Ok(true);
  match(r, .Ok(c) => assert(c && (mk_sc(i32(1)).tag == i32(1)), "bare match arm"), .Err(_) => assert(false, "Ok expected"));
  assert(g_sc_disposed == (before + i32(1)), "the RHS temp is disposed exactly once");
  // The LHS short-circuits: the RHS never runs, nothing is created, nothing is dropped.
  r2 := Result(bool, String).Ok(false);
  match(r2, .Ok(c) => assert(!(c && (mk_sc(i32(1)).tag == i32(1))), "false LHS"), .Err(_) => assert(false, "Ok expected"));
  assert(g_sc_disposed == (before + i32(1)), "a skipped RHS disposes nothing");
});
test("short-circuit RHS temp inside a bare cond arm is dropped in the branch", {
  before := g_sc_disposed;
  c := true;
  cond(c => assert(c && (mk_sc(i32(2)).tag == i32(2)), "bare cond arm"), true => assert(false, "unreachable"));
  assert(g_sc_disposed == (before + i32(1)), "the RHS temp is disposed exactly once");
});
test("short-circuit RHS temp inside a single-expression fn body is dropped in the branch", {
  before := g_sc_disposed;
  sc_check_body(true);
  assert(g_sc_disposed == (before + i32(1)), "the RHS temp is disposed exactly once");
  sc_check_body(true);
  assert(g_sc_disposed == (before + i32(2)), "once per call");
});
test("short-circuit RHS temp inside a bare loop body is dropped per iteration", {
  before := g_sc_disposed;
  g_sc_i = usize(0);
  c := true;
  while(g_sc_i < usize(3), sc_step(c && (mk_sc(i32(4)).tag == i32(4))));
  assert(g_sc_i == usize(3), "three iterations");
  assert(g_sc_disposed == (before + i32(3)), "one temp disposed per iteration");
});
test("|| chain ending in Option.is_some() inside a match arm inside a cond arm", {
  // The shape of issues/fixed/ts-codegen-undeclared-temp-in-short-circuit-option-drop.md.
  before := g_sc_disposed;
  flag := true;
  o := Option(bool).Some(false);
  result := cond(
    flag => match(o, .Some(x) => assert(x || mk_sc_opt(i32(5)).is_some(), "Option RHS"), .None => assert(false, "Some expected")),
    true => assert(false, "unreachable")
  );
  _ := result;
  assert(g_sc_disposed == (before + i32(1)), "the Option temp's payload is disposed exactly once");
});

// Regression (issues/fixed/match-or-cond-call-argument-result-is-never-released.md):
// a `match` / `cond` passed DIRECTLY as a call argument declared its result
// temp with a raw type string, so the temp never reached
// `declared_c_var_names` and the deferred-drop pass skipped the evaluator's
// scheduled scope-end `___drop` as an "undeclared temp" — every RC value such
// an argument produced leaked (the compiler's own `intern_type(match(...))`
// in `_substitute_at` leaked ~7 M TypeValues per self-check). The borrowed-arm
// cases are the over-release canaries: an arm that hands back a caller-owned
// value must not lose a reference when the temp is dropped.
(mut(g_at_disposed) : i32) = i32(0);
ArgTemp :: ref(struct(n : i32));
impl(
  ArgTemp,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_at_disposed = (g_at_disposed + i32(1));
    })
  )
);
at_read :: (fn(a : &ArgTemp) -> i32)(a.n);
at_sink :: (fn(sink(a) : ArgTemp) -> i32)(a.n);
at_pick_match :: (fn(flag : bool, keep : &ArgTemp) -> i32)(at_read(match(flag, true => ArgTemp(n : i32(1)), false => keep)));
at_pick_cond :: (fn(flag : bool, keep : &ArgTemp) -> i32)(at_read(cond(flag => ArgTemp(n : i32(2)), true => keep)));
test("a match passed as a call argument releases its fresh result", {
  before := g_at_disposed;
  flag := (before >= i32(0));
  {
    _n := at_read(match(flag, true => ArgTemp(n : i32(3)), false => ArgTemp(n : i32(4))));
  };
  assert(g_at_disposed == (before + i32(1)), "the match result is disposed exactly once");
  {
    at_read(match(flag, true => ArgTemp(n : i32(5)), false => ArgTemp(n : i32(6))));
  };
  assert(g_at_disposed == (before + i32(2)), "also when the call is a bare statement");
});
test("a cond passed as a call argument releases its fresh result", {
  before := g_at_disposed;
  flag := (before >= i32(0));
  {
    _n := at_read(cond(flag => ArgTemp(n : i32(7)), true => ArgTemp(n : i32(8))));
  };
  assert(g_at_disposed == (before + i32(1)), "the cond result is disposed exactly once");
});
test("a match/cond argument arm that returns a borrowed value does not over-release it", {
  before := g_at_disposed;
  {
    keep := ArgTemp(n : i32(9));
    assert(at_pick_match(false, &keep) == i32(9), "borrowed arm (match) reads the caller's value");
    assert(at_pick_cond(false, &keep) == i32(9), "borrowed arm (cond) reads the caller's value");
    assert(g_at_disposed == before, "the caller's value is still alive");
    assert(ref_count(keep) == 1, "and holds exactly its own reference");
    assert(at_pick_match(true, &keep) == i32(1), "fresh arm (match)");
    assert(at_pick_cond(true, &keep) == i32(2), "fresh arm (cond)");
    assert(g_at_disposed == (before + i32(2)), "each fresh arm result is disposed once");
    assert(ref_count(keep) == 1, "the kept value is untouched by the fresh arms");
  };
  assert(g_at_disposed == (before + i32(3)), "the caller's value is disposed once, at its scope end");
});
// Regression (issues/fixed/2026-10-14-a-block-result-that-is-not-moved-is-never-released.md): a
// value-producing begin block declared its result temp bare, like the match
// and cond above did before #893, so a block result that was not moved (a call
// argument, a receiver, a discarded statement) was never released. The outer
// local and the bound block are the over-release canaries.
test("a block result that is not moved is released once", {
  before := g_at_disposed;
  {
    _n := at_read({
      t := ArgTemp(n : i32(20));
      t
    });
  };
  assert(g_at_disposed == (before + i32(1)), "a block as a call argument");
  {
    {
      t := ArgTemp(n : i32(21));
      t
    };
  };
  assert(g_at_disposed == (before + i32(2)), "a block as a discarded statement");
  {
    _m := {
      t := ArgTemp(n : i32(22));
      t
    }.n;
  };
  assert(g_at_disposed == (before + i32(3)), "a block as a receiver");
});
// Regression (issues/fixed/2026-10-15-a-block-that-yields-an-outer-local-never-takes-its-reference.md):
// a block whose value is a local it does not own (an outer-frame local, a
// borrowed parameter) shares it out with a balancing `___dup`, which the
// block emitter never wrote, so the block's result and the local each
// released the one reference (heap-use-after-free under ASan). Each shape
// below released the outer local early before the fix.
at_block_of_param :: (fn(keep : &ArgTemp) -> i32)(
  at_read({
    _z := i32(0);
    keep
  })
);
test("a block that yields an outer local or is bound does not over-release", {
  before := g_at_disposed;
  {
    keep := ArgTemp(n : i32(23));
    {
      _k := at_read({
        _z := i32(0);
        keep
      });
      {
        _z := i32(0);
        keep
      };
      _m := {
        _z := i32(0);
        keep
      }.n;
      also := {
        _z := i32(0);
        keep
      };
      assert(also.n == i32(23), "a binding of a block that yields the outer local");
      assert(at_block_of_param(&keep) == i32(23), "a block that yields a borrowed parameter");
    };
    assert(g_at_disposed == before, "the outer local is still alive");
    assert(ref_count(keep) == 1, "every block's share of it is released at its scope end");
  };
  assert(g_at_disposed == (before + i32(1)), "the outer local is released once, at its scope end");
  {
    b := {
      t := ArgTemp(n : i32(24));
      t
    };
    assert(b.n == i32(24), "the bound block's value");
  };
  assert(g_at_disposed == (before + i32(2)), "the bound block's value is released once");
  {
    last := ArgTemp(n : i32(25));
    _l := at_read({
      _z := i32(0);
      last
    });
  };
  assert(g_at_disposed == (before + i32(3)), "an outer local whose last use is a block's value is released once");
});
// Regression (issues/fixed/an-assignments-old-value-save-reads-uninitialized-memory-for-pod-types.md):
// every assignment saves the old value for its deferred drop, and a typed
// load of an uninitialized `bool` slot is undefined behavior. The save now
// copies bytes. Under UBSan (ubsan.yml) with MallocScribble this failed with
// "load of value 170, which is not a valid value for type 'bool'".
test("a plain store into fresh memory never loads the uninitialized old value", {
  raw := unsafe(malloc(usize(64)));
  p := (*bool)(raw.unwrap());
  unsafe(p.* = true);
  assert(unsafe(p.*), "the store landed");
  unsafe(free(raw));
});
at_sink_plus :: (fn(sink(a) : ArgTemp) -> i32)(a.n + i32(1));
test("an own parameter read by a bare-expression body is released after the read", {
  before := g_at_disposed;
  {
    x := ArgTemp(n : i32(40));
    _r := at_sink(x);
    assert(_r == i32(40), "the field read happens before the release");
  };
  {
    y := ArgTemp(n : i32(41));
    _s := at_sink_plus(y);
    assert(_s == i32(42), "also inside an arithmetic tail");
  };
  assert(g_at_disposed == (before + i32(2)), "each owned argument is disposed exactly once, by the callee");
});
test("a HashMap that rehashes releases every value once when it dies", {
  before := g_at_disposed;
  {
    m := HashMap(i32, ArgTemp).new();
    (mut(i) : i32) = i32(0);
    while(i < i32(100), i = (i + i32(1)), {
      node := ArgTemp(n : i);
      _old := m.insert(i, node);
    });
    assert(m.len() == usize(100), "every key inserted");
  };
  assert(g_at_disposed == (before + i32(100)), "a rehash releases the old slots, so the map's death disposes all 100 values");
});
AtHolder :: ref(struct(a : i32));
at_build_struct_tail :: (fn() -> AtHolder)(AtHolder(a : at_read(ArgTemp(n : i32(20)))));
test("a call argument inside a struct-literal tail is released", {
  before := g_at_disposed;
  {
    h := at_build_struct_tail();
    assert(h.a == i32(20), "the field holds the call's result");
  };
  assert(g_at_disposed == (before + i32(1)), "the argument temp of the call inside the struct literal is disposed once");
});
at_ok :: (fn(a : &ArgTemp) -> bool)(a.n > i32(0));
test("a call argument under ! or == in an if condition is released", {
  before := g_at_disposed;
  (mut(y) : i32) = i32(0);
  {
    if(!at_ok(ArgTemp(n : i32(1))), {
      y = i32(1);
    });
    if(at_ok(ArgTemp(n : i32(0))) == false, {
      y = i32(2);
    });
  };
  assert(y == i32(2), "the conditions evaluated as expected");
  assert(g_at_disposed == (before + i32(2)), "both condition argument temps are disposed");
});
test("a call argument under an operator in a cond or match arm value is released", {
  before := g_at_disposed;
  flag := (before >= i32(0));
  {
    a := cond(
      flag => (at_read(ArgTemp(n : i32(30))) > i32(0)),
      true => false
    );
    b := match(
      flag,
      true => (at_read(ArgTemp(n : i32(31))) > i32(0)),
      false => false
    );
    assert(a && b, "both arms evaluated");
  };
  assert(g_at_disposed == (before + i32(2)), "both arm argument temps are disposed");
});
test("a nested match argument and a match moved into an own parameter", {
  before := g_at_disposed;
  flag := (before >= i32(0));
  {
    _n := at_read(match(flag, true => match(flag, true => ArgTemp(n : i32(10)), false => ArgTemp(n : i32(11))), false => ArgTemp(n : i32(12))));
  };
  assert(g_at_disposed == (before + i32(1)), "nested match result disposed once");
  {
    _m := at_sink(match(flag, true => ArgTemp(n : i32(13)), false => ArgTemp(n : i32(14))));
  };
  assert(g_at_disposed == (before + i32(2)), "a match moved into an own param is disposed once (by the callee)");
});
// Regression (issues/fixed/match-argument-temp-is-never-released-on-an-explicit-return.md):
// an explicit `return(...)` flushed the enclosing scopes' pending drops but
// skipped the result temp of a `match` / `cond` passed directly as a call
// argument, and nothing after the `return` runs — so the temp's reference
// leaked on every early return (the evaluator's labeled-field access leaked
// the object's PathCollection this way). The borrowed arm is the over-release
// canary: the caller's value must survive and be disposed exactly once.
at_ret_nested :: (fn(flag : bool, keep : &Option(ArgTemp)) -> i32)({
  if(flag, {
    v := at_read(match(keep, .Some(p) => p, .None => ArgTemp(n : i32(50))));
    return(v);
  });
  i32(-1)
});
at_ret_top :: (fn(keep : &Option(ArgTemp)) -> i32)({
  v := at_read(cond(keep.is_some() => keep.unwrap(), true => ArgTemp(n : i32(51))));
  return(v);
});
test("a match or cond call argument is released on an explicit return", {
  before := g_at_disposed;
  {
    _a := at_ret_nested(true, Option(ArgTemp).None);
    _b := at_ret_top(Option(ArgTemp).None);
    assert((_a + _b) == i32(101), "both fresh arms were read");
  };
  assert(g_at_disposed == (before + i32(2)), "each fresh argument temp is disposed once despite the early return");
  {
    keep := ArgTemp(n : i32(52));
    ko := Option(ArgTemp).Some(keep);
    assert(at_ret_nested(true, &ko) == i32(52), "borrowed arm (match)");
    assert(at_ret_top(&ko) == i32(52), "borrowed arm (cond)");
    assert(at_ret_nested(true, &ko) == i32(52), "the borrowed value survives repeated early returns");
    assert(g_at_disposed == (before + i32(2)), "and is still alive");
  };
  assert(g_at_disposed == (before + i32(3)), "the caller's value is disposed once, at its scope end");
});
// issues/fixed/a-field-write-through-a-borrowed-value-binding-double-releases.md:
// a borrowed value is changed through an owned copy. A `&T` parameter is
// read-only whatever the field holds, so a field without RC data is written
// in an owned copy too
// (issues/fixed/a-field-write-through-a-shared-borrow-parameter-is-accepted-and-lost.md).
FwbNamed :: struct(s : String, n : i32);
fwb_rename :: (fn(p : &FwbNamed) -> FwbNamed)({
  mut(q) := p;
  q.s = String.from("renamed-string-long-enough-for-the-heap");
  q
});
fwb_scratch :: (fn(p : &FwbNamed) -> i32)({
  mut(q) := p;
  q.n = (q.n + i32(1));
  q.n
});
test("a borrowed value is changed through an owned copy", {
  orig := FwbNamed(s : String.from("original-string-long-enough-for-the-heap"), n : i32(1));
  renamed := fwb_rename(&orig);
  assert(renamed.s == "renamed-string-long-enough-for-the-heap", "the copy has the new string");
  assert(orig.s == "original-string-long-enough-for-the-heap", "the caller's string is untouched");
  assert(fwb_scratch(&orig) == i32(2), "a non-RC field of an owned copy can be written");
  assert(orig.n == i32(1), "the write changes only the local copy");
  o := Option(FwbNamed).Some(orig);
  from_arm := match(
    o,
    .Some(d) => {
      mut(q) := d;
      q.s = String.from("from-an-arm-long-enough-for-the-heap");
      q.s.clone()
    },
    .None => String.from("")
  );
  assert(from_arm == "from-an-arm-long-enough-for-the-heap", "the arm's copy has the new string");
  match(o, .Some(d) => assert(d.s == "original-string-long-enough-for-the-heap", "the matched value is untouched"), .None => assert(false, "unreachable"));
});
// plans/STRING_VALUE_SEMANTICS.md S2: copy-on-write clones a buffer when its
// count is above 1, so for a VALUE type holding RC data the live count must
// never read 1 while two copies are alive. The dup/drop optimizer never cancels
// a value-with-RC pair ("both copies need their own drop"), unlike the
// reference-type alias above that legitimately shares one count.
_CowLike :: struct(b : Rc(i32), n : i32);
_cow_task :: (fn(w : &_CowLike, io : Io) -> Impl(Future(usize, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    ref_count(w.b)
  })
);
_cow_local_copy :: (fn(w : &_CowLike) -> usize)({
  q := w;
  ref_count(q.b)
});
test("ref_count: copies of a value holding RC data are counted in every position (COW S2)", {
  w := _CowLike(b : rc(i32(7)), n : i32(1));
  assert(ref_count(w.b) == usize(1), "alone");
  {
    w2 := w;
    assert((ref_count(w.b) == usize(2)) && (ref_count(w2.b) == usize(2)), "a nested-scope copy counts");
  };
  assert(ref_count(w.b) == usize(1), "the nested copy released its count");
  w3 := w;
  assert(ref_count(w.b) == usize(2), "a same-scope copy counts");
  assert(_cow_local_copy(&w) >= usize(3), "a callee's local copy of a parameter counts");
  h := ArrayList(_CowLike).new();
  h.push(w);
  assert(ref_count(w.b) >= usize(3), "a list element counts");
  (f : Impl(Fn() -> usize)) = (() => ref_count(w.b));
  assert(f() >= usize(4), "a closure capture counts");
  task := _cow_task(&w, io);
  assert(ref_count(w.b) >= usize(5), "an async task slot counts");
  assert(io.await(task, io) >= usize(5), "and the task sees a shared count");
  assert((w3.n == i32(1)) && (h.len() == usize(1)), "all copies stay live to here");
});
// A borrowed value passed to an `own` parameter — a field place, or a borrowed
// parameter — hands the callee a reference of its own (a +1), and the caller
// keeps its own. The METHOD-dispatch call forms (`Type.method(a)`,
// `recv.method(a)`) generated these arguments bare, dropping the +1 the plain
// call `make(a)` emits: the callee released a reference it was never given,
// and the caller's own release then freed the box a second time
// (issues/fixed/a-field-passed-to-an-own-parameter-of-a-method-call-is-not-retained.md).
(mut(g_own_m_disposed) : i32) = i32(0);
_OwnM :: ref(struct(tag : i32));
impl(
  _OwnM,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_own_m_disposed = (g_own_m_disposed + i32(1));
    })
  )
);
_OwnMHolder :: struct(b : _OwnM);
impl(
  _OwnMHolder,
  make : (fn(sink(b) : _OwnM) -> Self)(Self(b : b)),
  adopt : (fn(self : &Self, sink(b) : _OwnM) -> i32)(b.tag)
);
_OwnMWrap :: struct(m : _OwnM, n : i32);
_OwnMOuter :: struct(w : _OwnMWrap);
_own_m_plain :: (fn(sink(b) : _OwnM) -> _OwnMHolder)(_OwnMHolder(b : b));
_own_m_param_field :: (fn(w : &_OwnMWrap) -> _OwnMHolder)(_OwnMHolder.make(w.m));
_own_m_param :: (fn(m : &_OwnM) -> _OwnMHolder)(_OwnMHolder.make(m));
_own_m_nested_field :: (fn(o : &_OwnMOuter) -> _OwnMHolder)(_OwnMHolder.make(o.w.m));
_own_m_plain_field :: (fn(w : &_OwnMWrap) -> _OwnMHolder)(_own_m_plain(w.m));
test("Type.method with an own parameter retains a borrowed parameter's field", {
  before := g_own_m_disposed;
  {
    w := _OwnMWrap(m : _OwnM(tag : i32(1)), n : i32(1));
    h := _own_m_param_field(&w);
    assert(ref_count(w.m) == usize(2), `the holder and the caller each hold one, got ${ref_count(w.m).to_string()}`);
    assert((h.b.tag == i32(1)) && (g_own_m_disposed == before), "still live in both");
  };
  assert(g_own_m_disposed == (before + i32(1)), `released exactly once, got ${(g_own_m_disposed - before).to_string()}`);
});
test("Type.method with an own parameter retains a local's field", {
  before := g_own_m_disposed;
  {
    out := _OwnMWrap(m : _OwnM(tag : i32(2)), n : i32(0));
    h := _OwnMHolder.make(out.m);
    assert(ref_count(out.m) == usize(2), `the holder and the local each hold one, got ${ref_count(out.m).to_string()}`);
    assert(h.b.tag == i32(2), "the holder reads it");
  };
  assert(g_own_m_disposed == (before + i32(1)), `released exactly once, got ${(g_own_m_disposed - before).to_string()}`);
});
test("Type.method with an own parameter retains a nested field and a borrowed parameter", {
  before := g_own_m_disposed;
  {
    o := _OwnMOuter(w : _OwnMWrap(m : _OwnM(tag : i32(3)), n : i32(0)));
    h := _own_m_nested_field(&o);
    assert(ref_count(o.w.m) == usize(2), `nested field: got ${ref_count(o.w.m).to_string()}`);
    m := _OwnM(tag : i32(4));
    h2 := _own_m_param(&m);
    assert(ref_count(m) == usize(2), `borrowed parameter: got ${ref_count(m).to_string()}`);
    assert((h.b.tag + h2.b.tag) == i32(7), "both holders read their box");
  };
  assert(g_own_m_disposed == (before + i32(2)), `each box released exactly once, got ${(g_own_m_disposed - before).to_string()}`);
});
test("recv.method with an own parameter retains a field argument", {
  before := g_own_m_disposed;
  {
    w := _OwnMWrap(m : _OwnM(tag : i32(5)), n : i32(0));
    holder := _OwnMHolder(b : _OwnM(tag : i32(6)));
    assert(holder.adopt(w.m) == i32(5), "the callee read its copy");
    assert(ref_count(w.m) == usize(1), `the callee released only its own copy, got ${ref_count(w.m).to_string()}`);
    assert(g_own_m_disposed == before, "nothing released early");
  };
  assert(g_own_m_disposed == (before + i32(2)), `each box released exactly once, got ${(g_own_m_disposed - before).to_string()}`);
});
test("a plain call with an own parameter still retains a field argument", {
  before := g_own_m_disposed;
  {
    w := _OwnMWrap(m : _OwnM(tag : i32(8)), n : i32(0));
    h := _own_m_plain_field(&w);
    assert(ref_count(w.m) == usize(2), `got ${ref_count(w.m).to_string()}`);
    assert(h.b.tag == i32(8), "the holder reads it");
  };
  assert(g_own_m_disposed == (before + i32(1)), `released exactly once, got ${(g_own_m_disposed - before).to_string()}`);
});
// The same method-dispatch emitters also dropped the Stage-0 +1 of a borrowed
// field projection passed as the RECEIVER (`o.inner.poke(o)`): the plain call
// `poke_f(o.inner, o)` holds the projected value for the call, the method call
// did not, and a callee that replaced `o.inner` freed the receiver it was still
// reading.
_AlInner :: ref(struct(v : i32));
_AlOuter :: ref(struct(inner : _AlInner));
_al_replace :: (fn(o : &_AlOuter) -> unit)({
  o.inner = _AlInner(v : i32(0));
});
impl(
  _AlInner,
  poke : (fn(self : &Self, o : &_AlOuter) -> i32)({
    _al_replace(o);
    self.v
  })
);
_al_poke_f :: (fn(i : &_AlInner, o : &_AlOuter) -> i32)({
  _al_replace(o);
  i.v
});
test("a receiver projection outlives a method that replaces it", {
  o := _AlOuter(inner : _AlInner(v : i32(7)));
  assert(_al_poke_f(&o.inner, &o) == i32(7), "plain call: the argument survived the replacement");
  o2 := _AlOuter(inner : _AlInner(v : i32(8)));
  assert(o2.inner.poke(&o2) == i32(8), "method call: the receiver survived the replacement");
  assert((o.inner.v + o2.inner.v) == i32(0), "both owners see the replacement");
});
// `ref_count(x)` reads the count of the cell `x` holds, in every shape
// (plans/VALUES_BY_DEFAULT.md V1 step 0): 1 for a value, the live count for a
// `ref` struct, an `Rc`, an `Arc` (read atomically) and a collection handle.
RcNode :: ref(struct(v : i32));
test("ref_count(x) reads the count of every cell shape", {
  // A value: 1, at compile time.
  p := Point(1, 2);
  assert(ref_count(p) == usize(1), "ref_count(p) == 1");
  // ref(struct(...))
  n1 := RcNode(v : i32(1));
  assert(ref_count(n1) == usize(1), "ref_count(n1) == 1");
  {
    n2 := n1;
    {
      n3 := n2;
      assert(ref_count(n1) == usize(2), "ref_count(n1) == 2");
      assert(ref_count(n3) == usize(2), "ref_count(n3) == 2");
    };
  };
  assert(ref_count(n1) == usize(1), "ref_count(n1) == 1 after the copies died");
  // Rc
  b1 := Rc(i32)(3);
  {
    b2 := b1;
    {
      b3 := b2;
      assert(ref_count(b1) == usize(2), "ref_count(b1) == 2");
      assert(ref_count(b3) == usize(2), "ref_count(b3) == 2");
    };
  };
  assert(ref_count(b1) == usize(1), "ref_count(b1) == 1");
  // Arc: an atomic count, read atomically.
  a1 := arc(i32(42));
  {
    a2 := a1;
    {
      a3 := a2;
      assert(ref_count(a1) == usize(2), "ref_count(a1) == 2");
      assert(ref_count(a3) == usize(2), "ref_count(a3) == 2");
    };
  };
  assert(ref_count(a1) == usize(1), "ref_count(a1) == 1");
  // ArrayList (a ref struct): the list handle's own count.
  l1 := ArrayList(i32).new();
  l1.push(i32(1));
  {
    l2 := l1;
    {
      l3 := l2;
      assert(ref_count(l1) == usize(2), "ref_count(l1) == 2");
      assert(ref_count(l3) == usize(2), "ref_count(l3) == 2");
    };
  };
  assert(ref_count(l1) == usize(1), "ref_count(l1) == 1");
});
test("ref_count is a reserved builtin name", {
  // Reserved once markdown_yo v0.0.10 renamed its local `ref_count`
  // (VALUES_BY_DEFAULT V1 step 0b): a binding would be silently hijacked by
  // the count builtin at every call.
  comptime_expect_error(ref_count := 1, "names a builtin");
  comptime_expect_error((ref_count : i32) = 3, "names a builtin");
  comptime_expect_error(ref_count :: (fn(x : i32) -> usize)(usize(0)), "names a builtin");
});
// A newtype built from a value someone else still owns — a field projection
// (`Self(b : self.b)`) or a local that stays live (`x := self.b; Self(b : x)`) —
// takes a reference of its own, as a struct built the same way does. The
// newtype constructor is a zero-cost C cast, and it dropped the argument's
// deferred `___dup`: both owners released the payload, a use-after-free
// (issues/fixed/a-newtype-built-from-a-field-projection-is-not-retained.md).
// A payload the newtype takes over (a fresh local, a call result, a
// constructor) must still gain no extra reference.
(mut(g_nt_disposed) : i32) = i32(0);
_NtBox :: ref(struct(tag : i32));
impl(
  _NtBox,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_nt_disposed = (g_nt_disposed + i32(1));
    })
  )
);
_NtV :: newtype(b : _NtBox);
_NtOpt :: newtype(b : Option(_NtBox));
_NtW :: newtype(v : _NtV);
_NtPair :: newtype(p : Tuple(_NtBox, i32));
_NtHolder :: struct(v : _NtV);
impl(
  _NtV,
  from_field : (fn(self : &mut Self) -> Self)(Self(b : self.b)),
  from_field_val : (fn(self : &Self) -> Self)(Self(b : self.b)),
  from_local : (fn(self : &mut Self) -> Self)({
    x := self.b;
    Self(b : x)
  })
);
impl(_NtOpt, from_field : (fn(self : &mut Self) -> Self)(Self(b : self.b)));
impl(_NtW, from_field : (fn(self : &mut Self) -> Self)(Self(v : self.v)));
impl(_NtPair, from_field : (fn(self : &mut Self) -> Self)(Self(p : self.p)));
_nt_from_param :: (fn(b : &_NtBox) -> _NtV)(_NtV(b : b));
_nt_from_fresh :: (fn(tag : i32) -> _NtV)({
  b := _NtBox(tag : tag);
  _NtV(b : b)
});
_nt_mk :: (fn(tag : i32) -> _NtBox)(_NtBox(tag : tag));
_nt_from_call :: (fn(tag : i32) -> _NtV)(_NtV(b : _nt_mk(tag)));
_nt_from_holder :: (fn(h : &_NtHolder) -> _NtV)(_NtV(b : h.v.b));
test("a newtype built from a field or a live local retains its payload", {
  before := g_nt_disposed;
  {
    mut(s) := _NtV(b : _NtBox(tag : i32(1)));
    t := s.from_field();
    assert(ref_count(s.b) == usize(2), `field projection (inout self): got ${ref_count(s.b).to_string()}`);
    u := s.from_field_val();
    assert(ref_count(s.b) == usize(3), `field projection (by-value self): got ${ref_count(s.b).to_string()}`);
    w := s.from_local();
    assert(ref_count(s.b) == usize(4), `live local: got ${ref_count(s.b).to_string()}`);
    assert(((t.b.tag + u.b.tag + w.b.tag) == i32(3)) && (g_nt_disposed == before), "every copy reads the live box");
  };
  assert(g_nt_disposed == (before + i32(1)), `released exactly once, got ${(g_nt_disposed - before).to_string()}`);
});
test("a newtype built from a parameter or a parameter's field retains it", {
  before := g_nt_disposed;
  {
    b := _NtBox(tag : i32(2));
    v := _nt_from_param(&b);
    assert(ref_count(b) == usize(2), `parameter: got ${ref_count(b).to_string()}`);
    h := _NtHolder(v : _NtV(b : _NtBox(tag : i32(3))));
    hv := _nt_from_holder(&h);
    assert(ref_count(h.v.b) == usize(2), `nested field of a parameter: got ${ref_count(h.v.b).to_string()}`);
    assert(((v.b.tag + hv.b.tag) == i32(5)) && (g_nt_disposed == before), "both read their box");
  };
  assert(g_nt_disposed == (before + i32(2)), `each box released exactly once, got ${(g_nt_disposed - before).to_string()}`);
});
test("a newtype that takes over its payload adds no reference", {
  before := g_nt_disposed;
  {
    f := _nt_from_fresh(i32(4));
    assert(ref_count(f.b) == usize(1), `moved fresh local: got ${ref_count(f.b).to_string()}`);
    c := _nt_from_call(i32(5));
    assert(ref_count(c.b) == usize(1), `call result: got ${ref_count(c.b).to_string()}`);
    n := _NtV(b : _NtBox(tag : i32(6)));
    assert(ref_count(n.b) == usize(1), `constructor argument: got ${ref_count(n.b).to_string()}`);
  };
  assert(g_nt_disposed == (before + i32(3)), `each box released exactly once, got ${(g_nt_disposed - before).to_string()}`);
});
test("a newtype over an Option, a newtype or a tuple retains a field payload", {
  before := g_nt_disposed;
  {
    mut(o) := _NtOpt(b : .Some(_NtBox(tag : i32(7))));
    o2 := o.from_field();
    assert(match(o.b, .Some(x) => (ref_count(x) == usize(2)), .None => false), "Option payload shared by both");
    mut(n) := _NtW(v : _NtV(b : _NtBox(tag : i32(8))));
    n2 := n.from_field();
    assert(ref_count(n.v.b) == usize(2), `nested newtype: got ${ref_count(n.v.b).to_string()}`);
    mut(p) := _NtPair(p : (_NtBox(tag : i32(9)), i32(0)));
    p2 := p.from_field();
    assert(ref_count(p.p.0) == usize(2), `tuple payload: got ${ref_count(p.p.0).to_string()}`);
    o2_tag := match(o2.b, .Some(x) => x.tag, .None => i32(0));
    assert((o2_tag + n2.v.b.tag + p2.p.0.tag) == i32(24), "every copy reads its box");
  };
  assert(g_nt_disposed == (before + i32(3)), `each box released exactly once, got ${(g_nt_disposed - before).to_string()}`);
});
// Regression (issues/fixed/a-container-stored-in-a-tuple-stored-in-a-container-is-never-released.md):
// a tuple literal passed straight to a call (never bound to a name) owned a +1
// per RC-typed element that nothing ever released. The callee stores its OWN
// dup of each element (std assignment semantics: `dst.* = src.*` dups RC
// fields), so the balancing release is the CALLER's drop of the tuple value —
// which a call-result temp and a named binding both get, but an anonymous
// tuple literal never did (attach_temp_variable_to_expr was a no-op stub in
// evaluate_tuple_value, unlike the array-literal path). One reference per
// push leaked, so a container inside a tuple inside a container was never
// freed (48 B / 2 allocations per instance under LSan). The tuple literal now
// gets an owning temp, so its scope-end drop releases the fields.
(mut(g_tuple_elem_disposed) : i32) = i32(0);
TupleElemHandle :: ref(struct(tag : i32));
impl(
  TupleElemHandle,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_tuple_elem_disposed = (g_tuple_elem_disposed + i32(1));
    })
  )
);
test("a local moved into a tuple argument of a call is disposed exactly once", {
  before := g_tuple_elem_disposed;
  {
    ys := ArrayList(Tuple(i32, TupleElemHandle)).new();
    inner := TupleElemHandle(tag : i32(1));
    ys.push((i32(0), inner));
    // Over-drop canary: the read after the push must still see the object.
    assert(ys(usize(0)).1.tag == i32(1), "the pushed handle is readable after the push");
    assert(g_tuple_elem_disposed == before, "nothing disposed while the scope is live");
  };
  assert(
    g_tuple_elem_disposed == (before + i32(1)),
    "the tuple argument's own reference is released at scope end, not leaked"
  );
});
test("a fresh constructor inside a tuple argument is disposed exactly once", {
  before := g_tuple_elem_disposed;
  {
    ys := ArrayList(Tuple(i32, TupleElemHandle)).new();
    ys.push((i32(0), TupleElemHandle(tag : i32(2))));
    assert(ys(usize(0)).1.tag == i32(2), "the fresh handle is stored");
  };
  assert(
    g_tuple_elem_disposed == (before + i32(1)),
    "an element temp consumed by the tuple literal is released by the tuple's own drop"
  );
});
test("one local pushed in two tuple arguments is disposed exactly once", {
  before := g_tuple_elem_disposed;
  {
    ys := ArrayList(Tuple(i32, TupleElemHandle)).new();
    shared := TupleElemHandle(tag : i32(3));
    ys.push((i32(0), shared));
    ys.push((i32(1), shared));
    // Over-drop canary: both elements still read the live object.
    assert((ys(usize(0)).1.tag == i32(3)) && (ys(usize(1)).1.tag == i32(3)), "both elements see the shared object");
  };
  assert(
    g_tuple_elem_disposed == (before + i32(1)),
    "two tuple arguments sharing one local release their references without over-releasing"
  );
});
test("a tuple argument nested inside another tuple argument is disposed exactly once", {
  before := g_tuple_elem_disposed;
  {
    ys := ArrayList(Tuple(Tuple(i32, i32), TupleElemHandle)).new();
    inner := TupleElemHandle(tag : i32(4));
    ys.push(((i32(0), i32(1)), inner));
    assert(ys(usize(0)).1.tag == i32(4), "the nested tuple's handle is stored");
  };
  assert(
    g_tuple_elem_disposed == (before + i32(1)),
    "the inner tuple argument's reference is released through the outer tuple's drop"
  );
});
// CONTROL, not the regression guard: a tuple bound to a NAME before the push
// already disposed correctly (the binding's own scope-end drop descends into
// the tuple's fields), before and after the fix. It guards the named-binding
// path against the same change over-releasing.
test("a named tuple binding pushed into a container is disposed exactly once", {
  before := g_tuple_elem_disposed;
  {
    ys := ArrayList(Tuple(i32, TupleElemHandle)).new();
    inner := TupleElemHandle(tag : i32(5));
    p := (i32(0), inner);
    ys.push(p);
    assert(p.1.tag == i32(5), "the named tuple is readable after the push");
  };
  assert(
    g_tuple_elem_disposed == (before + i32(1)),
    "the named-binding path still releases exactly once"
  );
});
// ===========================================================================
// The unique `Box` (plans/VALUES_BY_DEFAULT.md §3.2, V1 step 2): a uniquely
// owned cell with no count. Explicit-copy: a copy point moves it, any other
// copy is E0901, and `Box.clone(b)` is a deep copy. `g_ubox_disposed` counts
// the disposes of `UBoxProbe` payloads.
// ===========================================================================
(mut(g_ubox_disposed) : i32) = i32(0);
UBoxProbe :: struct(n : i32);
impl(
  UBoxProbe,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_ubox_disposed = (g_ubox_disposed + i32(1));
    })
  )
);
impl(UBoxProbe, Clone(clone : (fn(self : &Self) -> Self)(UBoxProbe(n : self.n))));
UBoxPoint :: struct(x : i32, y : i32);
derive(UBoxPoint, Copy, Clone, Eq(UBoxPoint), Hash);
UBoxTree :: enum(
  Leaf(v : i32),
  Node(l : Box(Self), r : Box(Self))
);
ubox_sum :: (fn(t : &UBoxTree) -> i32)(
  match(
    t,
    .Leaf(v) => v,
    .Node(l, r) => (ubox_sum(&l.*) + ubox_sum(&r.*))
  )
);
// Deep clone for the tree: each `Box` is cloned through its payload.
impl(
  UBoxTree,
  Clone(
    clone : (fn(self : &Self) -> Self)(
      match(
        self,
        .Leaf(v) => UBoxTree.Leaf(v),
        .Node(l, r) => UBoxTree.Node(Box.clone(l), Box.clone(r))
      )
    )
  )
);
test("unique Box: box(v) holds the payload, and b.* is its place", {
  mut(b) := box(UBoxPoint(x : i32(1), y : i32(2)));
  assert(b.*.x == i32(1), "b.* is the payload");
  assert(b.y == i32(2), "auto-dereference reads a field");
  b.* = UBoxPoint(x : i32(5), y : i32(6));
  assert(b.x == i32(5), "a write to b.* replaces the payload");
  b.y = i32(9);
  assert(b.*.y == i32(9), "a field write goes through the box");
});
test("unique Box: Box.clone is an independent, deep copy", {
  a := box(UBoxPoint(x : i32(1), y : i32(2)));
  mut(c) := Box.clone(a);
  c.x = i32(100);
  assert(a.x == i32(1), "the source is untouched");
  assert(c.x == i32(100), "the clone has its own cell");
  assert(a.* == UBoxPoint(x : i32(1), y : i32(2)), "the source payload");
});
test("unique Box: a tree copied with clone and edited on one side", {
  t := UBoxTree.Node(box(UBoxTree.Leaf(i32(1))), box(UBoxTree.Node(box(UBoxTree.Leaf(i32(2))), box(UBoxTree.Leaf(i32(3))))));
  assert(ubox_sum(&t) == i32(6), "the tree sums its leaves");
  mut(u) := t.clone();
  match(
    &mut u,
    .Node(l, _) => {
      l.* = UBoxTree.Leaf(i32(40));
    },
    .Leaf(_) => ()
  );
  assert(ubox_sum(&u) == i32(45), "the copy is edited");
  assert(ubox_sum(&t) == i32(6), "the original is not");
});
test("unique Box: an implicit copy that is not the last use is E0901", {
  a := box(i32(1));
  b := a;
  assert(b.* == i32(1), "the last use moved the box");
  comptime_expect_error(a.*, "use of moved value");
  comptime_expect_error(c := a, "use of moved value");
});
test("unique Box: the payload is dropped exactly once, by its one owner", {
  before := g_ubox_disposed;
  {
    a := box(UBoxProbe(n : i32(1)));
    b := a;
    assert(b.n == i32(1), "moved");
    c := Box.clone(b);
    assert(c.n == i32(1), "cloned");
  };
  assert(g_ubox_disposed == (before + i32(2)), "the moved box once, the clone once");
});
test("unique Box: Box(T) is explicit-copy, and move-only when T is", {
  comptime_assert(!Type.impls(Box(i32), Copy), "a Box is never Copy");
  comptime_assert(Type.impls(Box(i32), Clone), "a Box of a Clone payload is Clone");
  comptime_assert(Type.impls(Box(UBoxProbe), Clone), "including a Drop payload with Clone");
  comptime_assert(!Type.impls(Box(_UBoxToken), Clone), "a Box of a move-only payload is move-only");
  comptime_assert(Type.impls(Box(i32), Send), "a Box is Send when its payload is");
  comptime_assert(!Type.impls(Box(Rc(i32)), Send), "and not when it is not");
});
_UBoxToken :: struct(id : i32);
test("unique Box: Eq, Hash and Default by payload; no count", {
  a := box(UBoxPoint(x : i32(1), y : i32(2)));
  mut(b) := Box.clone(a);
  assert(a == b, "equal payloads");
  b.x = i32(3);
  assert(!(a == b), "compared by payload");
  h1 := box(UBoxPoint(x : i32(7), y : i32(8)));
  h2 := box(UBoxPoint(x : i32(7), y : i32(8)));
  p := UBoxPoint(x : i32(7), y : i32(8));
  assert(hash_one(&h1) == hash_one(&h2), "equal payloads hash alike");
  assert(hash_one(&h1) == hash_one(&p), "a box hashes as its payload");
  // A box is a map key: the map moves it in and compares it in place
  // (issues/fixed/a-hashmap-of-a-move-only-key-or-value-does-not-compile.md).
  m := HashMap(Box(UBoxPoint), Box(i32)).new();
  m.insert(h1, box(i32(78)));
  m.insert(box(UBoxPoint(x : i32(1), y : i32(2))), box(i32(12)));
  assert(m(h2).* == i32(78), "found by an equal payload");
  assert(m.contains_key(&box(UBoxPoint(x : i32(1), y : i32(2)))), "contains_key borrows the box");
  match(
    m.remove(&box(UBoxPoint(x : i32(1), y : i32(2)))),
    .Some(v) => assert(v.* == i32(12), "the boxed value moves out"),
    .None => assert(false, "the key was present")
  );
  assert(m.len() == usize(1), "one entry left");
  (z : Box(i32)) = (Box(i32) <: Default).default();
  assert(z.* == i32(0), "the default box holds the payload's default");
  comptime_expect_error(ref_count(a), "a uniquely owned cell with no count");
});
test("unique Box: Option(Box(T)) is one pointer", {
  comptime_assert(size_of(Option(Box(UBoxPoint))) == size_of(*u8), "the NULL niche");
  (o : Option(Box(i32))) = .Some(box(i32(4)));
  match(
    o,
    .Some(b) => assert(b.* == i32(4), "the payload through the niche"),
    .None => assert(false, "unreachable")
  );
  (n : Option(Box(i32))) = .None;
  assert(n.is_none(), "None is NULL");
});
test("unique Box: alloc places the cell, and a clone stays where its source lives", {
  arena := Arena.new(usize(4096));
  {
    a := box(i32(7), alloc : .Some(arena.allocator()));
    assert(Allocator.owner_of((*void)(addr_of(a.*))).same(arena.allocator()), "the cell's owner prefix names the arena");
    match(Box.allocator(a), .Some(o) => assert(o.same(arena.allocator()), "Box.allocator reads it back"), .None => assert(false, "placed"));
    c := Box.clone(a);
    match(Box.allocator(c), .Some(o) => assert(o.same(arena.allocator()), "the clone is in the arena too"), .None => assert(false, "the clone is placed"));
    g := box(i32(1));
    assert(Box.allocator(g).is_none(), "a default box is on the global allocator");
    s := with_allocator(arena.allocator(), () => box(i32(2)));
    assert(match(Box.allocator(s), .Some(o) => o.same(arena.allocator()), .None => false), "the with_allocator scope places a default box");
  };
  arena.deinit();
});
UBoxProbeTree :: enum(
  Leaf(p : UBoxProbe),
  Node(l : Box(Self), r : Box(Self))
);
test("unique Box: a consuming match looks through the box, and drops it once", {
  before := g_ubox_disposed;
  {
    v := match(box(UBoxProbe(n : i32(3))), UBoxProbe(n : k) => k);
    assert(v == i32(3), "the struct pattern matched through the box");
  };
  assert(g_ubox_disposed == (before + i32(1)), "the scrutinee box dropped its payload once");
  {
    t := UBoxProbeTree.Node(box(UBoxProbeTree.Leaf(UBoxProbe(n : i32(1)))), box(UBoxProbeTree.Leaf(UBoxProbe(n : i32(2)))));
    w := match(
      t,
      .Node(.Leaf(a), r) => {
        keep := r;
        a.n
      },
      .Node(_, _) => i32(0),
      .Leaf(_) => i32(-1)
    );
    assert(w == i32(1), "a look-through on the left, the box itself bound on the right");
  };
  assert(g_ubox_disposed == (before + i32(3)), "both leaves dropped exactly once");
});
// Decision 31: `Box(p)` spells the look-through (Generation A for `Box`; the
// implicit form above goes once a `SEED_VERSION` carries `Box(p)`).
test("unique Box: Box(p) names the cell a pattern looks through", {
  f :: (fn(t : &UBoxTree) -> i32)(
    match(
      t,
      .Node(Box(.Leaf(a)), Box(.Leaf(b))) => (a + b),
      .Node(Box(.Node(Box(.Leaf(a)), _)), _) => (a * i32(10)),
      .Node(_, _) => i32(-1),
      .Leaf(v) => v
    )
  );
  assert(f(UBoxTree.Node(box(UBoxTree.Leaf(1)), box(UBoxTree.Leaf(2)))) == i32(3));
  assert(f(UBoxTree.Node(box(UBoxTree.Node(box(UBoxTree.Leaf(4)), box(UBoxTree.Leaf(0)))), box(UBoxTree.Leaf(9)))) == i32(40));
  assert(f(UBoxTree.Leaf(7)) == i32(7));
  before := g_ubox_disposed;
  {
    v := match(box(UBoxProbe(n : i32(5))), Box(UBoxProbe(n : k)) => k);
    assert(v == i32(5), "Box(p) at the scrutinee matched the payload");
  };
  assert(g_ubox_disposed == (before + i32(1)), "the scrutinee box dropped its payload once");
  comptime_expect_error({
    bad :: (fn(t : &UBoxTree) -> i32)(
      match(
        t,
        Box(.Leaf(n)) => n,
        _ => i32(0)
      )
    );
    bad(UBoxTree.Leaf(1))
  }, "looks through a `Box`, and this position is not one");
});
UBoxHolder :: struct(b : Box(UBoxPoint), k : i32);
derive(UBoxHolder, Clone, Eq(UBoxHolder), Hash);
UBoxChoice :: enum(A(b : Box(i32)), B);
derive(UBoxChoice, Clone);
test("unique Box: derive(Clone) and derive(Eq) go through a Box field", {
  x := UBoxHolder(b : box(UBoxPoint(x : i32(1), y : i32(2))), k : i32(3));
  mut(y) := x.clone();
  assert(x == y, "the derived Eq compares the payloads");
  y.b.x = i32(9);
  assert(x.b.x == i32(1), "the derived clone made a new cell");
  assert(!(x == y), "and the payloads now differ");
  z := x.clone();
  assert(hash_one(&x) == hash_one(&z), "the derived Hash hashes the payload");
  e := UBoxChoice.A(b : box(i32(6)));
  mut(f) := e.clone();
  match(
    &mut f,
    .A(b) => {
      b.* = i32(7);
    },
    .B => ()
  );
  match(
    e,
    .A(b) => assert(b.* == i32(6), "the enum variant's box cloned"),
    .B => assert(false, "variant kept")
  );
});
// `Drop` (plans/VALUES_BY_DEFAULT.md decision 45, the new name of `Drop`)
// on an `Rc` payload: the payload's destructor runs once, when the last
// handle goes away, never while one is live; and `drop(h)` releases one
// handle.
(mut(g_rc_drop_payload) : i32) = i32(0);
RcDropPayload :: struct(n : i32);
impl(
  RcDropPayload,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_rc_drop_payload = (g_rc_drop_payload + self.n);
    })
  )
);
test("Rc(T) with a Drop payload drops it once, with the last handle", {
  before := g_rc_drop_payload;
  {
    a := rc(RcDropPayload(n : i32(5)));
    b := a;
    assert(b.n == i32(5), "both handles see the payload");
    drop(a);
    assert(g_rc_drop_payload == before, "one handle is still live: nothing dropped");
    assert(b.n == i32(5), "b still reads the payload");
  };
  assert(g_rc_drop_payload == (before + i32(5)), "the last handle dropped the payload once");
});
// `runtime(x)` is transparent for ownership: a binding of `runtime(f())` owns
// the call's result exactly once
// (issues/fixed/rc-value-copied-address-taken-and-returned-is-double-dropped.md).
(mut(g_rt_disposed) : i32) = i32(0);
_RtBox :: ref(struct(tag : i32));
impl(
  _RtBox,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_rt_disposed = (g_rt_disposed + i32(1));
    })
  )
);
_rt_make :: (fn(t : i32) -> _RtBox)(_RtBox(tag : t));
test("a binding of runtime(call) releases the result once", {
  before := g_rt_disposed;
  {
    (b : _RtBox) = runtime(_rt_make(i32(4)));
    assert(b.tag == i32(4), "the value came through");
  };
  assert(g_rt_disposed == (before + i32(1)), `released once, got ${(g_rt_disposed - before).to_string()}`);
  (mut(i) : i32) = i32(0);
  while(i < i32(100), {
    (s : String) = runtime(String.from("hello"));
    assert(s == "hello", "the string came through");
    i = (i + i32(1));
  });
});
// A struct field of type `Option(Box(X))` is emitted as the Box newtype's
// typedef, so the struct must follow that typedef in the C type order
// (issues/fixed/a-struct-field-of-type-option-box-emits-invalid-c.md).
UBoxOptString :: struct(o : Option(Box(String)), n : i32);
UBoxOptPoint :: struct(o : Option(Box(UBoxPoint)), n : i32);
UBoxOptInt :: struct(o : Option(Box(i32)), n : i32);
derive(UBoxOptString, Clone);
test("unique Box: a struct field of type Option(Box(T)) compiles and reads back", {
  s := UBoxOptString(o : .Some(box(String.from("hi"))), n : i32(7));
  t := s.clone();
  match(
    &t.o,
    .Some(b) => assert(b.* == String.from("hi"), "the String payload through the field"),
    .None => assert(false, "unreachable")
  );
  p := UBoxOptPoint(o : .Some(box(UBoxPoint(x : i32(1), y : i32(2)))), n : i32(3));
  match(
    &p.o,
    .Some(b) => assert(b.y == i32(2), "the struct payload through the field"),
    .None => assert(false, "unreachable")
  );
  q := UBoxOptInt(o : .None, n : i32(4));
  assert(q.o.is_none() && (q.n == i32(4)), "a None field is NULL");
});
// ---------------------------------------------------------------------------
// Decision 46's doors (plans/VALUES_BY_DEFAULT.md §6 "Decision 46" step 1):
// `Rc.try_unwrap` and `Rc.make_mut`, as Rust has them.
// ---------------------------------------------------------------------------
(mut(g_door_dropped) : i32) = i32(0);
/// A move-only payload (a `Drop` impl, no `Clone`) whose drop is tallied.
_DoorToken :: struct(tag : i32);
impl(
  _DoorToken,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_door_dropped = (g_door_dropped + self.tag);
    })
  )
);
_DoorPoint :: struct(x : i32, label : String);
derive(_DoorPoint, Clone);
test("Rc.try_unwrap on the only handle moves the payload out", {
  before := g_door_dropped;
  {
    h := rc(_DoorToken(tag : i32(5)));
    match(
      Rc.try_unwrap(h),
      .Ok(t) => assert(t.tag == i32(5), "the payload came out"),
      .Err(_) => assert(false, "the only handle unwraps")
    );
  };
  assert(g_door_dropped == (before + i32(5)), `the payload is dropped once, got ${(g_door_dropped - before).to_string()}`);
  s := match(Rc.try_unwrap(rc(String.from("moved"))), .Ok(v) => v, .Err(_) => String.from("shared"));
  assert(s == "moved", "a String payload moves out");
});
test("Rc.try_unwrap on a shared handle returns the handle", {
  before := g_door_dropped;
  {
    a := rc(_DoorToken(tag : i32(7)));
    b := a;
    back := match(
      Rc.try_unwrap(b),
      .Ok(_) => {
        assert(false, "a still shares the cell");
        rc(_DoorToken(tag : i32(0)))
      },
      .Err(h) => h
    );
    assert(ref_count(a) == 2, "the handle came back with its count");
    assert(back.tag == i32(7), "the handle names the same payload");
    assert(g_door_dropped == before, "nothing was dropped");
  };
  assert(g_door_dropped == (before + i32(7)), `the payload is dropped once with its last handle, got ${(g_door_dropped - before).to_string()}`);
});
test("Rc.make_mut on the only handle writes the payload in place", {
  h := rc(_DoorPoint(x : i32(1), label : String.from("a")));
  before := addr_of(h.*);
  Rc.make_mut(&mut h).x = i32(2);
  Rc.make_mut(&mut h).label.push_str("b");
  assert(h.x == i32(2), "the write landed");
  assert(h.label == "ab", "the receiver write landed");
  assert(addr_of(h.*) == before, "no clone: the same cell");
  assert(ref_count(h) == 1, "still the only handle");
});
test("Rc.make_mut on a shared handle clones the payload first", {
  a := rc(_DoorPoint(x : i32(1), label : String.from("a")));
  b := a;
  Rc.make_mut(&mut b).x = i32(9);
  assert(a.x == i32(1), "the other handle does not see the write");
  assert(b.x == i32(9), "the write landed in b's own cell");
  assert(ref_count(a) == 1, "a is alone in the old cell");
  assert(ref_count(b) == 1, "b is alone in the new cell");
  Rc.make_mut(&mut b).x = i32(10);
  assert((a.x == i32(1)) && (b.x == i32(10)), "b is unique now: written in place");
});
test("Rc.make_mut needs a Clone payload, as Rust's does", {
  h := rc(_DoorToken(tag : i32(0)));
  comptime_expect_error(Rc.make_mut(&mut h));
});
// `consume(x)` of an owned value moves it into the builtin, which returns
// `unit`: nothing else owns the value, so the consume releases it, as
// `drop(x)` does. It used to mark `x` moved (suppressing the scope-end drop)
// and emit `x;`, so the value leaked
// (issues/fixed/2026-10-16-consume-of-an-owned-local-as-a-statement-leaks-it.md).
// Drop deltas pin "exactly once, at the consume": a missing release counts 0,
// a release on top of a surviving scope-end drop counts 2.
(mut(g_consume_disposed) : i32) = i32(0);
_ConsumeBox :: ref(struct(tag : i32));
impl(
  _ConsumeBox,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_consume_disposed = (g_consume_disposed + i32(1));
    })
  )
);
_consume_make :: (fn(t : i32) -> _ConsumeBox)(_ConsumeBox(tag : t));
_consume_param :: (fn(b : _ConsumeBox) -> unit)({
  consume(b);
});
_consume_borrow :: (fn(b : &_ConsumeBox) -> unit)({
  consume(b);
});
test("consume of an owned local releases it at the consume", {
  before := g_consume_disposed;
  {
    s := _ConsumeBox(tag : i32(1));
    assert(s.tag == i32(1), "the local is live before the consume");
    consume(s);
    assert(g_consume_disposed == (before + i32(1)), "released at the consume, not at scope end");
  };
  assert(g_consume_disposed == (before + i32(1)), `released exactly once, got ${(g_consume_disposed - before).to_string()}`);
});
test("consume of a call result releases the result", {
  before := g_consume_disposed;
  {
    consume(_consume_make(i32(2)));
  };
  assert(g_consume_disposed == (before + i32(1)), `released exactly once, got ${(g_consume_disposed - before).to_string()}`);
});
test("consume of an alias releases only the alias's count", {
  before := g_consume_disposed;
  {
    a := _ConsumeBox(tag : i32(3));
    b := a;
    consume(b);
    assert(g_consume_disposed == before, "the original still holds the object");
    assert(a.tag == i32(3), "and still reads it");
  };
  assert(g_consume_disposed == (before + i32(1)), `released exactly once, got ${(g_consume_disposed - before).to_string()}`);
});
test("consume in one cond arm releases the local once on either path", {
  (mut(i) : i32) = i32(0);
  while(i < i32(2), {
    before := g_consume_disposed;
    {
      s := _ConsumeBox(tag : i);
      cond(
        (s.tag == i32(0)) => consume(s),
        true => ()
      );
    };
    assert(g_consume_disposed == (before + i32(1)), `path ${i.to_string()}: released exactly once, got ${(g_consume_disposed - before).to_string()}`);
    i = (i + i32(1));
  });
});
test("consume of an owned parameter releases only the callee's count", {
  before := g_consume_disposed;
  {
    s := _ConsumeBox(tag : i32(4));
    _consume_param(s);
    assert(s.tag == i32(4), "the caller's value survives the callee's consume");
  };
  assert(g_consume_disposed == (before + i32(1)), `released exactly once, got ${(g_consume_disposed - before).to_string()}`);
});
test("consume of a borrow releases nothing", {
  before := g_consume_disposed;
  {
    s := _ConsumeBox(tag : i32(5));
    _consume_borrow(&s);
    assert(g_consume_disposed == before, "the borrow's consume left the value alone");
    assert(s.tag == i32(5), "and the owner still reads it");
  };
  assert(g_consume_disposed == (before + i32(1)), `released exactly once, got ${(g_consume_disposed - before).to_string()}`);
});
// An exit after the consume must not release the value again, and an exit
// before it must still release it: exactly one release on every path.
_consume_then_exit :: (fn(flag : bool) -> i32)({
  s := _ConsumeBox(tag : i32(6));
  consume(s);
  cond(flag => return(i32(1)), true => ());
  i32(2)
});
_exit_then_consume :: (fn(flag : bool) -> i32)({
  s := _ConsumeBox(tag : i32(7));
  cond(flag => return(i32(1)), true => ());
  consume(s);
  i32(2)
});
test("an early return after or before a consume releases the local once", {
  before := g_consume_disposed;
  assert(_consume_then_exit(true) == i32(1), "returned early");
  assert(g_consume_disposed == (before + i32(1)), "consume then return: once");
  assert(_consume_then_exit(false) == i32(2), "fell through");
  assert(g_consume_disposed == (before + i32(2)), "consume then fall through: once");
  assert(_exit_then_consume(true) == i32(1), "returned early");
  assert(g_consume_disposed == (before + i32(3)), "return before the consume: once");
  assert(_exit_then_consume(false) == i32(2), "fell through");
  assert(g_consume_disposed == (before + i32(4)), "consume at the end: once");
});
// ---------------------------------------------------------------------------
// Decision 46 Generation B (plans/VALUES_BY_DEFAULT.md §6 "Decision 46" step
// 2): an `Rc`'s payload is read-only through the handle, so every write
// through one is E0919, whose text names the doors.
// ---------------------------------------------------------------------------
_RoNode :: ref(struct(n : i32));
_RoShared :: struct(n : i32, items : ArrayList(i32), node : _RoNode);
_ro_bump :: (fn(x : &mut i32) -> unit)({
  x = (x + i32(1));
});
_ro_peek :: (fn(x : &mut i32) -> i32)(x);
_ro_read :: (fn(x : &i32) -> i32)(x);
_ro_run :: (fn(f : &Impl(Fn() -> unit)) -> unit)(f());
_ro_make :: (fn() -> Rc(_RoShared))(rc(_RoShared(n : i32(1), items : ArrayList(i32).new(), node : _RoNode(n : i32(2)))));
_RoHolder :: struct(h : Rc(_RoShared));
_ro_set_gen :: (fn(generic(T : Type), dst : &mut T, v : T) -> unit)({
  dst = v;
});
test("a write through an Rc handle is E0919, naming the doors", {
  h := _ro_make();
  // An assignment to the payload, to a field under it, to an element under it.
  comptime_expect_error({
    h.* = _RoShared(n : i32(0), items : ArrayList(i32).new(), node : _RoNode(n : i32(0)));
  }, "read-only through the handle");
  comptime_expect_error({
    h.n = i32(3);
  }, "read-only through the handle");
  comptime_expect_error({
    h.*.n = i32(3);
  }, "read-only through the handle");
  comptime_expect_error({
    h.items(usize(0)) = i32(3);
  }, "read-only through the handle");
  // The text names every door.
  comptime_expect_error({
    h.n = i32(3);
  }, "RefCell");
  comptime_expect_error({
    h.n = i32(3);
  }, "Rc.make_mut(&mut h)");
  comptime_expect_error({
    h.n = i32(3);
  }, "Rc.try_unwrap(h)");
  // A `&mut` argument, whether or not the callee writes it, as in Rust.
  comptime_expect_error(_ro_bump(&mut h.n), "read-only through the handle");
  comptime_expect_error(_ro_peek(&mut h.n), "read-only through the handle");
  // A generic `&mut T` parameter: a place under the handle is still the payload.
  comptime_expect_error(_ro_set_gen(&mut h.n, i32(3)), "read-only through the handle");
  comptime_expect_error(_ro_set_gen(&mut h.*, _RoShared(n : i32(0), items : ArrayList(i32).new(), node : _RoNode(n : i32(0)))), "read-only through the handle");
  // A local `&mut` borrow of a place in the payload.
  comptime_expect_error({
    r := &mut h.n;
    r = i32(2);
  }, "read-only through the handle");
  // A `self : &mut Self` receiver, spelled through the payload or auto-dereferenced.
  comptime_expect_error(h.items.push(i32(1)), "read-only through the handle");
  xs := rc(ArrayList(i32).new());
  comptime_expect_error(xs.push(i32(1)), "read-only through the handle");
  // A `ref` object reached from the payload is in the payload.
  comptime_expect_error({
    h.node.n = i32(5);
  }, "read-only through the handle");
  // Through a parameter, a struct field holding the handle, and an Rc in an Rc.
  comptime_expect_error({
    _ro_param_write :: (fn(p : &Rc(_RoShared)) -> unit)({
      p.n = i32(4);
    });
  }, "read-only through the handle");
  holder := _RoHolder(h : _ro_make());
  comptime_expect_error({
    holder.h.n = i32(4);
  }, "read-only through the handle");
  nested := rc(rc(i32(1)));
  comptime_expect_error({
    nested.*.* = i32(2);
  }, "read-only through the handle");
  // Inside a closure body.
  comptime_expect_error(
    _ro_run(() => {
      h.n = i32(6);
    }),
    "read-only through the handle"
  );
});
test("reads, & lends, the handle itself and the doors are not E0919", {
  mut(h) := _ro_make();
  assert(h.n == i32(1), "a read through the handle");
  assert(_ro_read(&h.n) == i32(1), "a & lend of a place in the payload");
  assert(h.items.len() == usize(0), "a &self method on the payload");
  // The handle is the holder's own: rebinding it is not a write through it.
  h = _ro_make();
  mut(holder) := _RoHolder(h : h);
  holder.h = _ro_make();
  assert(holder.h.n == i32(1), "a field holding a handle is rebound");
  // A generic `&mut T` parameter binds `T` to the handle's own type, so the
  // handle itself is lent and rebound, not its payload
  // (issues/fixed/2026-10-24-an-rc-handle-cannot-be-lent-as-mut-to-a-generic-parameter.md).
  mut(g) := rc(i32(1));
  other_g := g;
  _ro_set_gen(&mut g, rc(i32(3)));
  assert((g.* == i32(3)) && (other_g.* == i32(1)), "the handle is rebound; the other handle still sees the old cell");
  _ro_set_gen(&mut holder.h, _ro_make());
  assert(holder.h.n == i32(1), "a field holding a handle, through a generic parameter");
  // A `ref(struct)` handle is not an `Rc`: its own fields are written through it.
  node := _RoNode(n : i32(0));
  node.n = i32(7);
  assert(node.n == i32(7), "a ref object is written through its handle");
  // The doors.
  p := rc(i32(1));
  Rc.make_mut(&mut p) = i32(8);
  assert(p.* == i32(8), "make_mut on the only handle");
  cell := rc(RefCell(_RoShared).new(_RoShared(n : i32(0), items : ArrayList(i32).new(), node : _RoNode(n : i32(0)))));
  other := cell;
  other.with_mut(s => {
    s.n = i32(9);
    s.items.push(i32(1));
  });
  assert(cell.with(s => ((s.n == i32(9)) && (s.items.len() == usize(1)))), "a write through a RefCell door is seen through the other handle");
  n := match(Rc.try_unwrap(rc(i32(4))), .Ok(v) => v, .Err(_) => i32(0));
  assert(n == i32(4), "try_unwrap moves the payload out of the only handle");
});
// --- The `alloc` parameter (plans/VALUES_BY_DEFAULT.md §3.2; `arc`'s twin in tests/arc.test.yo) ---
test("rc alloc : .Some(a) places the cell in a, and the default does not", {
  arena := Arena.new(usize(1) << usize(16));
  {
    a := rc(i32(5), alloc : .Some(arena.allocator()));
    assert(arena.live_blocks() == usize(1), `the cell is in the arena: ${arena.live_blocks()}`);
    assert(ref_count(a) == usize(1), "ref_count never reports the allocator tag");
    g := rc(i32(6));
    assert(arena.live_blocks() == usize(1), "the scope was restored: a default rc is on the global allocator");
    assert((a.* + g.*) == i32(11), "the payloads");
  };
  assert(arena.live_blocks() == usize(0), "the last drop released the cell into the arena");
  arena.deinit();
});
test("rc alloc : .Some(a) inside another scope wins, and the outer scope survives", {
  inner := Arena.new(usize(1) << usize(16));
  outer := Arena.new(usize(1) << usize(16));
  {
    x := with_allocator(outer.allocator(), () => {
      placed := rc(i32(7), alloc : .Some(inner.allocator()));
      scoped := rc(i32(8));
      assert(outer.live_blocks() == usize(1), `the default rc after it still follows the scope: ${outer.live_blocks()}`);
      assert(scoped.* == i32(8), "the scoped payload");
      placed
    });
    assert(inner.live_blocks() == usize(1), "the explicit allocator placed the cell");
    assert(outer.live_blocks() == usize(0), "the scoped rc died with the closure");
    assert(x.* == i32(7), "the placed payload");
  };
  assert(inner.live_blocks() == usize(0), "released into the explicit allocator");
  inner.deinit();
  outer.deinit();
});
test("rc alloc : .Some(a) shared by several handles is released into a once, and try_unwrap frees it there", {
  arena := Arena.new(usize(1) << usize(16));
  {
    shared := rc(i32(42), alloc : .Some(arena.allocator()));
    holder := ArrayList(Rc(i32)).new();
    holder.push(shared);
    assert(ref_count(shared) == usize(2), "two handles, one cell");
    assert(arena.live_blocks() == usize(1), "one cell, two handles");
    assert(holder.get(usize(0)).unwrap().* == i32(42), "the held handle reads the placed cell");
  };
  assert(arena.live_blocks() == usize(0), "the last handle released the cell into the arena");
  n := match(Rc.try_unwrap(rc(i32(4), alloc : .Some(arena.allocator()))), .Ok(v) => v, .Err(_) => i32(0));
  assert(n == i32(4), "try_unwrap moves the payload out of a placed cell");
  assert(arena.live_blocks() == usize(0), "and frees the cell into the arena");
  arena.deinit();
});
// `rc`'s twin of tests/arc.test.yo's Send case: a `dyn(...)` closure that
// captures a parameter of a generic (`Impl(Fn)`) function is boxed by a
// synthesized `rc(closure)` whose `V` is the closure's capture struct
// (issues/fixed/2026-10-22-a-dyn-closure-in-a-generic-fn-boxes-through-a-cell-typed-by-the-unbound-return.md).
_RcDynDetector :: struct(detect : Dyn(Fn(x : i32) -> i32));
_rc_dyn_run :: (fn(get : &Impl(Fn(x : i32) -> i32)) -> i32)({
  d := _RcDynDetector(detect : dyn((x : i32) => (get(x) + i32(1))));
  d.detect(i32(2))
});
test("a dyn of a closure capturing a generic fn's Impl(Fn) parameter boxes through rc", {
  n := i32(10);
  assert(_rc_dyn_run((x : i32) => (x + n)) == i32(13), "the closure, called through the Dyn");
});
// A `cond` whose first live arm is compile-time true collapses to that arm;
// a borrowed handle it returns still takes the balancing count a runtime
// `cond` gives it, so the caller's copy and the owner each hold one
// (issues/fixed/2026-10-22-a-cond-with-a-compile-time-condition-returns-a-borrowed-handle-without-a-dup.md).
_CondCtBox :: ref(struct(n : i32));
_cond_ct_after_false :: (fn(q : &_CondCtBox) -> _CondCtBox)(
  cond(
    false => q,
    true => q
  )
);
_cond_ct_only_true :: (fn(q : &_CondCtBox) -> _CondCtBox)(cond(true => q));
_cond_ct_folded :: (fn(q : &_CondCtBox) -> _CondCtBox)(
  cond(
    (i32(1) == i32(2)) => q,
    true => q
  )
);
_cond_ct_runtime :: (fn(k : bool, q : &_CondCtBox) -> _CondCtBox)(
  cond(
    k => q,
    true => q
  )
);
_cond_ct_deref :: (fn(p : *_CondCtBox) -> _CondCtBox)(
  cond(
    false => p.*,
    true => p.*
  )
);
_cond_ct_read :: (fn(generic(T : Type), p : *T) -> T)(
  cond(
    Type.impls(T, Copy) => p.*,
    true => p.*
  )
);
test("a compile-time-collapsed cond dups the borrowed handle it returns", {
  r := _CondCtBox(n : i32(5));
  {
    a := _cond_ct_after_false(&r);
    assert(ref_count(r) == usize(2), "false => q, true => q: the result holds its own count");
    b := _cond_ct_only_true(&r);
    assert(ref_count(r) == usize(3), "cond(true => q)");
    c := _cond_ct_folded(&r);
    assert(ref_count(r) == usize(4), "a folded-false condition before true => q");
    d := _cond_ct_runtime(false, &r);
    assert(ref_count(r) == usize(5), "the runtime cond, the control");
    e := _cond_ct_deref(addr_of(r));
    assert(ref_count(r) == usize(6), "a raw-pointer read p.*");
    f := _cond_ct_read(addr_of(r));
    assert(ref_count(r) == usize(7), "a generic accessor on Type.impls(T, Copy)");
    assert((a.n + b.n + (c.n + d.n) + (e.n + f.n)) == i32(30), "every copy reads the shared object");
  };
  assert(ref_count(r) == usize(1), "each copy released its own count");
  x := i32(9);
  assert(_cond_ct_read(addr_of(x)) == i32(9), "the generic accessor at a Copy type takes the first arm");
});
test("a compile-time-collapsed cond in a binding dups the local it names", {
  r := _CondCtBox(n : i32(6));
  x := cond(
    false => r,
    true => r
  );
  assert(ref_count(r) == usize(2), "x and r each hold a count");
  assert((x.n + r.n) == i32(12), "both read the object");
});
// More collapsed shapes: a nested collapse (in a runtime arm too), the `if`
// spelling, a borrowed struct's field, a call argument, and an async body.
_CondCtHolder :: struct(r : _CondCtBox, k : i32);
_cond_ct_nested :: (fn(q : &_CondCtBox) -> _CondCtBox)(cond(true => cond(true => q)));
_cond_ct_nested_in_runtime :: (fn(k : bool, q : &_CondCtBox) -> _CondCtBox)(
  cond(
    k => cond(true => q),
    true => q
  )
);
_cond_ct_if :: (fn(q : &_CondCtBox) -> _CondCtBox)(if(true, q, q));
_cond_ct_field :: (fn(h : &_CondCtHolder) -> _CondCtBox)(cond(true => h.r));
_cond_ct_take :: (fn(b : _CondCtBox) -> i32)(b.n);
_cond_ct_async :: (fn(q : &_CondCtBox, io : Io) -> Impl(Future(_CondCtBox, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    cond(
      false => q,
      true => q
    )
  })
);
test("a compile-time-collapsed cond dups through nesting, if, fields, arguments and async", {
  r := _CondCtBox(n : i32(2));
  {
    a := _cond_ct_nested(&r);
    assert(ref_count(r) == usize(2), "cond(true => cond(true => q))");
    b := _cond_ct_nested_in_runtime(true, &r);
    assert(ref_count(r) == usize(3), "a collapsed cond inside a runtime arm");
    c := _cond_ct_if(&r);
    assert(ref_count(r) == usize(4), "if(true, q, q)");
    h := _CondCtHolder(r : r, k : i32(1));
    assert(ref_count(r) == usize(5), "the holder's copy");
    d := _cond_ct_field(&h);
    assert(ref_count(r) == usize(6), "a borrowed struct's field");
    t := _cond_ct_take(cond(true => r));
    assert(ref_count(r) == usize(6), "a call argument: the callee released its own count");
    e := io.await(_cond_ct_async(&r, io), io);
    assert(ref_count(r) == usize(7), "an async body after an await");
    assert((a.n + b.n + (c.n + d.n) + (e.n + t)) == i32(12), "every copy reads the shared object");
  };
  assert(ref_count(r) == usize(1), "each copy released its own count");
});
// A collapsed cond whose arm is `return(x)` moves the returned value out
// (issues/fixed/2026-10-23-a-compile-time-collapsed-cond-arm-return-releases-the-returned-value.md).
_cond_ct_return_then_tail :: (fn(q : &_CondCtBox) -> _CondCtBox)({
  cond(true => return(q));
  q
});
_cond_ct_return_before_runtime_arm :: (fn(k : bool, q : &_CondCtBox) -> _CondCtBox)({
  cond(
    true => return(q),
    k => ()
  );
  q
});
_cond_ct_return_owned :: (fn(q : &_CondCtBox) -> _CondCtBox)({
  cond(true => return(_CondCtBox(n : (q.n + i32(1)))));
  q
});
_cond_ct_return_body :: (fn(q : &_CondCtBox) -> _CondCtBox)(cond(true => return(q)));
_cond_ct_return_after_local :: (fn(q : &_CondCtBox) -> _CondCtBox)({
  x := _CondCtBox(n : i32(0));
  cond(true => return(q));
  x
});
test("a compile-time-collapsed cond's return arm keeps the returned value alive", {
  r := _CondCtBox(n : i32(3));
  {
    a := _cond_ct_return_then_tail(&r);
    assert(ref_count(r) == usize(2), "cond(true => return(q)); q");
    b := _cond_ct_return_before_runtime_arm(false, &r);
    assert(ref_count(r) == usize(3), "true => return(q), k => ()");
    c := _cond_ct_return_body(&r);
    assert(ref_count(r) == usize(4), "the whole body is the collapsed cond");
    d := _cond_ct_return_after_local(&r);
    assert(ref_count(r) == usize(5), "a local released before the return");
    o := _cond_ct_return_owned(&r);
    assert(ref_count(o) == usize(1), "an owned return value is the caller's");
    assert((a.n + b.n + (c.n + d.n) + o.n) == i32(16), "every result reads its object");
  };
  assert(ref_count(r) == usize(1), "each copy released its own count");
});
// The same collapse in an `io.async` body after an await, where the body
// owns a local that the return arm releases.
_cond_ct_async_return :: (fn(q : &_CondCtBox, io : Io) -> Impl(Future(_CondCtBox, Io)))(
  io.async((io : Io) => {
    x := _CondCtBox(n : i32(100));
    io.await(yield(io), io);
    cond(true => return(q));
    x
  })
);
test("a compile-time-collapsed cond's return arm in an async body releases the body's locals", {
  r := _CondCtBox(n : i32(4));
  {
    a := io.await(_cond_ct_async_return(&r, io), io);
    assert(ref_count(r) == usize(2), "an async body's return arm after an await");
    assert(a.n == i32(4), "the returned handle reads its object");
  };
  assert(ref_count(r) == usize(1), "the async result released its count");
});
// `break` and `continue` arms collapse the same way (the arm's control flow
// consumes its body temp), after a collapsed value in the same loop body.
_cond_ct_loop_break :: (fn(q : &_CondCtBox) -> i32)({
  mut(i) := i32(0);
  while(i < i32(3), {
    t := cond(true => q);
    i = (i + t.n);
    cond(true => break);
  });
  i
});
_cond_ct_for_continue :: (fn(q : &_CondCtBox) -> i32)({
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  mut(s) := i32(0);
  for(&xs, x => {
    t := cond(true => q);
    s = (s + (t.n * x));
    cond(true => continue);
  });
  s
});
test("a compile-time-collapsed cond's break and continue arms after a collapsed value in a loop body", {
  r := _CondCtBox(n : i32(4));
  assert(_cond_ct_loop_break(&r) == i32(4), "a collapsed value, then a collapsed break");
  assert(ref_count(r) == usize(1), "the loop body's copy released its count");
  assert(_cond_ct_for_continue(&r) == i32(12), "a collapsed value, then a collapsed continue");
  assert(ref_count(r) == usize(1), "the for body's copies released their counts");
});
// A wrapper awaited twice by one task is fused at both await sites: its body,
// with the collapsed conds, is emitted twice in sibling C blocks.
_cond_ct_fused :: (fn(q : &_CondCtBox, io : Io) -> Impl(Future(i32, Io)))({
  x := cond(
    false => q,
    true => q
  );
  y := cond(true => q);
  io.async((io : Io) => {
    io.await(yield(io), io);
    x.n + y.n
  })
});
_cond_ct_fused_twice :: (fn(q : &_CondCtBox, io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    a := io.await(_cond_ct_fused(q, io), io);
    b := io.await(_cond_ct_fused(q, io), io);
    a + b
  })
);
test("a compile-time-collapsed cond in a wrapper awaited twice by one task", {
  r := _CondCtBox(n : i32(5));
  assert(io.await(_cond_ct_fused_twice(&r, io), io) == i32(20), "each await reads the handle twice");
  assert(ref_count(r) == usize(1), "every collapsed copy released its count");
});
// A `&Self` receiver, or a `&` argument, reached through an `Rc`/`Arc`
// payload is kept alive for its call: the caller takes its +1 on the HANDLE
// (Aliasing Stage 0), so a closure argument that drops every other handle
// leaves the cell alive until the call returns. When the closure names the
// handle's container itself, the call is E0910, as the `&` argument is
// (issues/fixed/2026-10-23-a-receiver-reached-through-an-rc-auto-deref-is-not-kept-alive-across-its-closure-argument.md).
// The payload has a destructor, so it is move-only and no copy of it could
// keep it: `peek` returns how many payloads were destroyed while its closure
// ran, 0 when the cell outlived the closure.
mut(_rcv_drops) := i32(0);
_RcvCell :: struct(n : i32);
impl(
  _RcvCell,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _rcv_drops = (_rcv_drops + i32(1));
    })
  )
);
impl(
  _RcvCell,
  peek : (fn(self : &Self, act : &Impl(Fn() -> unit)) -> i32)({
    act();
    _rcv_drops + (self.n - self.n)
  })
);
_RcvField :: struct(r : Rc(_RcvCell));
_RcvHolder :: struct(xs : ArrayList(Rc(_RcvCell)));
impl(_RcvHolder, first : (fn(self : &Self) -> &Rc(_RcvCell))(&self.xs(usize(0))));
_rcv_peek :: (fn(c : &_RcvCell, act : &Impl(Fn() -> unit)) -> i32)({
  act();
  _rcv_drops + (c.n - c.n)
});
test("a receiver reached through an Rc element outlives a closure that drops the last other handle", {
  _rcv_drops = i32(0);
  hs := ArrayList(Rc(_RcvCell)).new();
  hs.push(rc(_RcvCell(n : i32(1))));
  hs2 := hs;
  assert(
    hs(usize(0)).peek(() => {
      hs2.clear();
    }) == i32(0),
    "auto-dereferenced receiver: the cell outlives the call"
  );
  assert(_rcv_drops == i32(1), "and is destroyed once, after it");
  hs.push(rc(_RcvCell(n : i32(2))));
  assert(
    hs(usize(0)).*.peek(() => {
      hs2.clear();
    }) == i32(1),
    "written `.*` receiver"
  );
  assert(_rcv_drops == i32(2), "destroyed once");
  hs.push(rc(_RcvCell(n : i32(3))));
  assert(
    _rcv_peek(&hs(usize(0)).*, () => {
      hs2.clear();
    }) == i32(2),
    "a `&` argument through the handle"
  );
  assert(_rcv_drops == i32(3), "destroyed once");
  h := _RcvHolder(xs : hs);
  hs.push(rc(_RcvCell(n : i32(4))));
  assert(
    h.xs(usize(0)).peek(() => {
      hs2.clear();
    }) == i32(3),
    "an element of a field"
  );
  assert(_rcv_drops == i32(4), "destroyed once");
  hs.push(rc(_RcvCell(n : i32(5))));
  assert(
    h.first().peek(() => {
      hs2.clear();
    }) == i32(4),
    "a handle returned by a projection call"
  );
  assert(_rcv_drops == i32(5), "destroyed once");
});
test("a receiver behind a field, nested handles or an Arc outlives the closure too", {
  _rcv_drops = i32(0);
  fs := ArrayList(_RcvField).new();
  fs.push(_RcvField(r : rc(_RcvCell(n : i32(1)))));
  fs2 := fs;
  assert(
    fs(usize(0)).r.peek(() => {
      fs2.clear();
    }) == i32(0),
    "an Rc field of an element"
  );
  assert(_rcv_drops == i32(1), "destroyed once");
  nested := ArrayList(Rc(Rc(_RcvCell))).new();
  nested.push(rc(rc(_RcvCell(n : i32(2)))));
  nested2 := nested;
  assert(
    nested(usize(0)).peek(() => {
      nested2.clear();
    }) == i32(1),
    "Rc(Rc(T)): the inner handle holds the payload"
  );
  assert(_rcv_drops == i32(2), "destroyed once");
  boxed := ArrayList(Rc(Box(_RcvCell))).new();
  boxed.push(rc(box(_RcvCell(n : i32(3)))));
  boxed2 := boxed;
  assert(
    boxed(usize(0)).peek(() => {
      boxed2.clear();
    }) == i32(2),
    "Rc(Box(T)): the Rc owns the box"
  );
  assert(_rcv_drops == i32(3), "destroyed once");
  shared := ArrayList(Arc(_RcvCell)).new();
  shared.push(arc(_RcvCell(n : i32(4))));
  shared2 := shared;
  assert(
    shared(usize(0)).peek(() => {
      shared2.clear();
    }) == i32(3),
    "an Arc element"
  );
  assert(_rcv_drops == i32(4), "destroyed once");
});
// The same call in an `io.async` body: the handle's share is taken on the
// state machine's path too, across the awaits around the call.
_rcv_in_task :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    hs := ArrayList(Rc(_RcvCell)).new();
    hs.push(rc(_RcvCell(n : i32(1))));
    hs2 := hs;
    io.await(yield(io), io);
    seen := hs(usize(0)).peek(() => {
      hs2.clear();
    });
    io.await(yield(io), io);
    seen
  })
);
test("a receiver reached through an Rc element in an io.async body outlives the closure", {
  _rcv_drops = i32(0);
  assert(io.await(_rcv_in_task(io), io) == i32(0), "the cell outlives the call in the task");
  assert(_rcv_drops == i32(1), "and is destroyed once");
});
// A copyable payload behind a `Box` or a value field keeps its own +1.
_RcvText :: struct(s : String);
impl(
  _RcvText,
  peek_len : (fn(self : &Self, act : &Impl(Fn() -> unit)) -> usize)({
    act();
    self.s.len()
  })
);
_RcvTextField :: struct(t : _RcvText);
test("a copyable receiver behind a Box or a value field of an element keeps its value", {
  bs := ArrayList(Box(_RcvText)).new();
  bs.push(box(_RcvText(s : String.from("hello"))));
  bs2 := bs;
  assert(
    bs(usize(0)).peek_len(() => {
      bs2.clear();
    }) == usize(5),
    "Box element"
  );
  vs := ArrayList(_RcvTextField).new();
  vs.push(_RcvTextField(t : _RcvText(s : String.from("hello"))));
  vs2 := vs;
  assert(
    vs(usize(0)).t.peek_len(() => {
      vs2.clear();
    }) == usize(5),
    "a value field of an element"
  );
});
test("a closure naming the container a receiver is lent from is E0910", {
  comptime_expect_error({
    hs := ArrayList(Rc(_RcvCell)).new();
    hs(usize(0)).peek(() => {
      hs.clear();
    })
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    fs := ArrayList(_RcvField).new();
    fs(usize(0)).r.peek(() => {
      fs.clear();
    })
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    mut(r) := rc(_RcvCell(n : i32(1)));
    r.peek(() => {
      r = rc(_RcvCell(n : i32(2)));
    })
  }, "an earlier argument of the same call lends to it");
  comptime_expect_error({
    ts := ArrayList(_RcvText).new();
    ts(usize(0)).peek_len(() => {
      ts.clear();
    })
  }, "an earlier argument of the same call lends to it");
});
// An exit taken while a later argument of the call is evaluated (`return`,
// `break`, `continue`, an unwind, a task's `return`) skips the post-call
// release of the share the receiver took on the handle, so the exit releases
// it: a share left behind keeps the cell alive past its last handle, and the
// payload is never destroyed
// (issues/fixed/2026-10-24-a-caller-owned-share-leaks-when-a-later-argument-exits-early.md).
impl(
  _RcvCell,
  peek_k : (fn(self : &Self, k : i32, act : &Impl(Fn() -> unit)) -> i32)({
    act();
    self.n + k
  })
);
_rcv_exit_return :: (fn(hs : &ArrayList(Rc(_RcvCell)), o : Option(i32)) -> i32)(
  hs(usize(0)).peek_k(match(o, .Some(v) => v, .None => return(i32(-1))), () => ())
);
_rcv_exit_return_field :: (fn(fs : &ArrayList(_RcvField), o : Option(i32)) -> i32)(
  fs(usize(0)).r.peek_k(match(o, .Some(v) => v, .None => return(i32(-1))), () => ())
);
_rcv_exit_loops :: (fn(hs : &ArrayList(Rc(_RcvCell))) -> i32)({
  mut(sum) := i32(0);
  mut(i) := i32(0);
  while(i < i32(5), i = (i + i32(1)), {
    sum = (sum + hs(usize(0)).peek_k(cond((i == i32(3)) => break, true => i), () => ()));
  });
  mut(j) := i32(0);
  while(j < i32(5), j = (j + i32(1)), {
    sum = (sum + hs(usize(0)).peek_k(cond((j == i32(2)) => continue, true => j), () => ()));
  });
  sum
});
_RcvExit :: (ctl(k : i32) -> i32);
_rcv_pick :: (fn(k : i32, raise : _RcvExit) -> i32)(cond((k < i32(0)) => raise(k), true => k));
_rcv_exit_unwind :: (fn(hs : &ArrayList(Rc(_RcvCell)), k : i32) -> i32)({
  (raise : _RcvExit) = (
    x -> {
      unwind(i32(-7));
    }
  );
  hs(usize(0)).peek_k(_rcv_pick(k, raise), () => ())
});
_rcv_exit_task :: (fn(o : Option(i32), io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    hs := ArrayList(Rc(_RcvCell)).new();
    hs.push(rc(_RcvCell(n : i32(1))));
    io.await(yield(io), io);
    r := hs(usize(0)).peek_k(match(o, .Some(v) => v, .None => return(i32(5))), () => ());
    io.await(yield(io), io);
    r
  })
);
test("an exit from a later argument releases the share a receiver took through an Rc", {
  _rcv_drops = i32(0);
  hs := ArrayList(Rc(_RcvCell)).new();
  hs.push(rc(_RcvCell(n : i32(1))));
  assert(_rcv_exit_return(&hs, .None) == i32(-1), "return from a later argument");
  assert(_rcv_exit_return(&hs, .Some(i32(2))) == i32(3), "no exit");
  assert(_rcv_exit_loops(&hs) == i32(18), "break and continue from a later argument");
  assert(_rcv_exit_unwind(&hs, i32(-1)) == i32(-7), "unwind from a later argument");
  assert(_rcv_exit_unwind(&hs, i32(2)) == i32(3), "no unwind");
  hs.clear();
  assert(_rcv_drops == i32(1), "every exit released its share");
  fs := ArrayList(_RcvField).new();
  fs.push(_RcvField(r : rc(_RcvCell(n : i32(1)))));
  assert(_rcv_exit_return_field(&fs, .None) == i32(-1), "return, Rc field of an element");
  fs.clear();
  assert(_rcv_drops == i32(2), "the field's share was released");
  assert(io.await(_rcv_exit_task(.None, io), io) == i32(5), "a task's return from a later argument");
  assert(_rcv_drops == i32(3), "the task released its share");
});
// The share is released by exits that leave the call, not by an exit inside
// the argument (a loop's `break`) or inside the closure (its `return`).
_rcv_exit_inner :: (fn(hs : &ArrayList(Rc(_RcvCell)), hs2 : &mut ArrayList(Rc(_RcvCell))) -> i32)(
  hs(usize(0)).peek_k({
    mut(s) := i32(0);
    while(true, {
      s = (s + i32(1));
      cond((s > i32(2)) => break, true => ());
    });
    s
  }, { &mut hs2 }() => {
    hs2.clear();
    cond(true => return(()), true => ());
    _rcv_drops = (_rcv_drops + i32(100));
  })
);
test("an exit inside a later argument or its closure keeps the receiver's share", {
  _rcv_drops = i32(0);
  hs := ArrayList(Rc(_RcvCell)).new();
  hs.push(rc(_RcvCell(n : i32(1))));
  mut(hs2) := hs;
  assert(_rcv_exit_inner(&hs, &mut hs2) == i32(4), "the cell outlives the call");
  assert(_rcv_drops == i32(1), "and is destroyed once, after it");
});

// Teardown at any nesting depth (issues/fixed/yo-self-rc-depth-cap-skips-deep-teardown.md).
// The "does this type hold anything to drop" walk once answered "no" past 8
// aggregate levels, so a value nested 9 or more deep was never torn down:
// a `Drop` leaf's `drop` never ran and its counted cell leaked. Each case
// below holds one `_DeepTracked` (a `ref` with `Drop`) or one `_DeepDropV`
// (a value type with `Drop`) under N wrapper levels and checks it is
// dropped exactly once when the scope ends.
(mut(g_deep_drops) : i32) = i32(0);
_DeepTracked :: ref(struct(v : i32));
impl(
  _DeepTracked,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_deep_drops = (g_deep_drops + self.v);
    })
  )
);
_DeepDropV :: struct(v : i32);
impl(
  _DeepDropV,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_deep_drops = (g_deep_drops + self.v);
    })
  )
);
