// A named tuple copied whole into another aggregate
// (issues/fixed/2026-10-23-a-tuple-copied-into-an-aggregate-keeps-only-its-last-counted-field.md).
// The copy of a tuple (or array) holding counted fields is element-wise: it
// retains each field of the source in place, and its result temp is the LAST
// field. Literal elements, `recur` arguments and closure captures took that
// temp as the copy, so the new aggregate held one field where the tuple
// belonged (the other fields zero: a crash on read, a leak at teardown), and a
// captured tuple was never retained. Each `_TupCopyT` adds its `v` to the
// counter when dropped, so a sum checks every cell is dropped exactly once.
(mut(g_tup_copy_drops) : i32) = i32(0);
_TupCopyT :: ref(struct(v : i32));
impl(
  _TupCopyT,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_tup_copy_drops = (g_tup_copy_drops + self.v);
    })
  )
);
_tup_copy_sum :: (fn(p : Tuple(_TupCopyT, _TupCopyT), n : i32) -> i32)(
  cond((n == i32(0)) => (p.0.v + p.1.v), true => recur(p, n - i32(1)))
);
test("a named tuple copied into a tuple literal keeps every counted field", {
  before := g_tup_copy_drops;
  {
    x1 := (_TupCopyT(v : i32(1)), _TupCopyT(v : i32(2)));
    x2 := (x1, i32(0));
    assert((x2.0.0.v == i32(1)) && (x2.0.1.v == i32(2)), "both fields of the copy");
    assert((x1.0.v + x1.1.v) == i32(3), "the source is intact");
  };
  assert(g_tup_copy_drops == (before + i32(3)), `each cell dropped once, got ${(g_tup_copy_drops - before).to_string()}`);
});
test("a tuple holding one cell twice, copied into a tuple literal, drops it once", {
  before := g_tup_copy_drops;
  {
    x0 := _TupCopyT(v : i32(4));
    x1 := (x0, x0);
    x2 := (x1, i32(0));
    assert((x2.0.0.v + x2.0.1.v) == i32(8), "both fields of the copy");
  };
  assert(g_tup_copy_drops == (before + i32(4)), `the cell dropped once, got ${(g_tup_copy_drops - before).to_string()}`);
});
test("a named tuple copied into an array literal keeps every counted field", {
  before := g_tup_copy_drops;
  {
    x1 := (_TupCopyT(v : i32(1)), _TupCopyT(v : i32(2)));
    a := [x1, x1];
    assert((a(usize(0)).0.v + a(usize(1)).1.v) == i32(3), "fields of both copies");
    assert((x1.0.v + x1.1.v) == i32(3), "the source is intact");
  };
  assert(g_tup_copy_drops == (before + i32(3)), `each cell dropped once, got ${(g_tup_copy_drops - before).to_string()}`);
});
test("a named tuple passed to recur keeps every counted field", {
  before := g_tup_copy_drops;
  {
    x1 := (_TupCopyT(v : i32(5)), _TupCopyT(v : i32(6)));
    assert(_tup_copy_sum(x1, i32(3)) == i32(11), "recur saw both fields");
    assert(_tup_copy_sum(x1, i32(2)) == i32(11), "the source is intact");
  };
  assert(g_tup_copy_drops == (before + i32(11)), `each cell dropped once, got ${(g_tup_copy_drops - before).to_string()}`);
});
test("a closure capturing a named tuple retains it", {
  before := g_tup_copy_drops;
  {
    x1 := (_TupCopyT(v : i32(1)), _TupCopyT(v : i32(2)));
    {
      (f : Impl(Fn() -> i32)) = (() => (x1.0.v + x1.1.v));
      assert(f() == i32(3), "the closure reads both fields");
    };
    assert((x1.0.v + x1.1.v) == i32(3), "the source outlives the closure");
  };
  assert(g_tup_copy_drops == (before + i32(3)), `each cell dropped once, got ${(g_tup_copy_drops - before).to_string()}`);
});
test("a closure capturing a nested tuple and an array retains every cell", {
  before := g_tup_copy_drops;
  {
    x1 := ((_TupCopyT(v : i32(1)), _TupCopyT(v : i32(2))), _TupCopyT(v : i32(4)));
    a := [_TupCopyT(v : i32(8)), _TupCopyT(v : i32(16))];
    {
      (f : Impl(Fn() -> i32)) = (() => (x1.0.0.v + x1.0.1.v + x1.1.v + (a(usize(0)).v + a(usize(1)).v)));
      assert(f() == i32(31), "the closure reads every field");
    };
    assert((x1.1.v + a(usize(1)).v) == i32(20), "the sources outlive the closure");
  };
  assert(g_tup_copy_drops == (before + i32(31)), `each cell dropped once, got ${(g_tup_copy_drops - before).to_string()}`);
});
test("a named tuple copied as a block's last expression in a cond arm keeps every counted field", {
  before := g_tup_copy_drops;
  {
    x1 := (_TupCopyT(v : i32(1)), _TupCopyT(v : i32(2)));
    c := (g_tup_copy_drops >= i32(0));
    y := cond(
      c => {
        k := i32(1);
        x1
      },
      true => x1
    );
    assert((y.0.v + y.1.v) == i32(3), "both fields of the copy");
    assert((x1.0.v + x1.1.v) == i32(3), "the source is intact");
  };
  assert(g_tup_copy_drops == (before + i32(3)), `each cell dropped once, got ${(g_tup_copy_drops - before).to_string()}`);
});
