pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
Point :: struct(x : i32, y : i32);
Wrapper :: struct(v : Box(i32));
test("Test 'rc' function", {
  // Value type
  {
    p1 := Point(3, 4);
    assert(rc(p1) == 1, "rc(p1) == 1");
    p2 := p1;
    assert(rc(p1) == 1, "rc(p1) == 1"); // Should be no change.
    assert(rc(p2) == 1, "rc(p2) == 1");
  };
  // Reference type
  {
    b1 := Box(i32)(3);
    assert(rc(b1) == 1, "rc(b1) == 1");
    {
      b2 := b1; // Yo performs dup/drop cancellation here.
      // So rc(b1) should remain 1.
      assert(rc(b1) == 1, "rc(b1) == 1");
      assert(rc(b2) == 1, "rc(b2) == 1");
      {
        b3 := b2;
        assert(rc(b1) == 2, "rc(b1) == 2");
        assert(rc(b2) == 2, "rc(b2) == 2");
        assert(rc(b3) == 2, "rc(b3) == 2");
      };
      assert(rc(b1) == 1, "rc(b1) == 1");
      assert(rc(b2) == 1, "rc(b2) == 1");
    }
  };
  // Value type containing reference type
  {
    w1 := Wrapper(Box(i32)(5));
    assert(rc(w1) == 1, "rc(w1) == 1");
    assert(rc(w1.v) == 1, "rc(w1.v) == 1");
    w2 := w1;
    assert(rc(w1) == 1, "rc(w1) == 1"); // Should be no change.
    assert(rc(w2) == 1, "rc(w2) == 1");
    assert(rc(w1.v) == 2, "rc(w1.v) == 2"); // Also no change, due to dup/drop cancellation.
    assert(rc(w2.v) == 2, "rc(w2.v) == 2");
  };
});
test("Test explicit return and implicit return", {
  Foo :: ref(
    struct(
      data : Box(i32)
    )
  );
  impl(
    Foo,
    new : (fn(val : i32) -> Self)(
      Self(data : box(val))
    ),
    // This should generate a dup call
    get_data_implicit : (fn(self : Self) -> Box(i32))(
      self.data
    ),
    // THIS WORKS:
    get_data_explicit : (fn(self : Self) -> Box(i32))({
      return(self.data);
    })
  );
  foo := Foo.new(42);
  d1 := foo.get_data_implicit();
  assert(d1.* == 42, "d1.* == 42");
  d2 := foo.get_data_explicit();
  assert(d2.* == 42, "d2.* == 42");
});
test("Test Rc in different data structures", {
  // Anonymous struct
  {
    x := Box(i32)(3);
    y := { x };
    z := { y };
    assert(x.* == 3, "x.* == 3");
    assert(y.x.* == 3, "y.x.* == 3");
    assert(z.y.x.* == 3, "z.y.x.* == 3");
    y.x = Box(i32)(4);
    assert(y.x.* == 4, "y.x.* == 4");
    assert(z.y.x.* == 3, "z.y.x.* == 3");
  };
  // Nested boxes
  {
    x := box(3);
    y := box(x);
    z := box(y);
    z.* = box(box(10));
  };
  // Array containing Rc
  {
    x := Box(i32)(3);
    y := [x,];
    z := [y,];
    m := [z,];
    n := [m,];
    assert(x.* == 3, "x.* == 3");
    assert(y(0).* == 3, "y(0).* ==");
    assert(z(0)(0).* == 3, "z(0)(0).* ==");
    assert(m(0)(0)(0).* == 3, "m(0)(0)(0).* ==");
    assert(n(0)(0)(0)(0).* == 3, "n(0)(0)(0)(0).* ==");
  };
  // Tuple containing Rc
  {
    x := Box(i32)(3);
    y := (x,);
    z := (y,);
    m := (z,);
    n := (m,);
    z.0 = (box(10),);
    assert(x.* == 3, "x.* == 3");
    assert(y.0.* == 3, "y.0.* == 3");
    assert(z.0.0.* == 10, "z.0.0.* == 10");
    assert(m.0.0.0.* == 3, "m.0.0.0.* == 3");
    assert(n.0.0.0.0.* == 3, "n.0.0.0.0.* == 3");
  };
});
test("Test Rc with Iso", {
  {
    x := box(123);
    z := ^(x);
    match(
      z,
      .Some(_) => assert(true),
      .None => assert(false, "unreachable")
    );
  };
  {
    x := box(123);
    y := { x };
    z := ^(x);
    match(
      z,
      .Some(_) => assert(false, "unreachable"),
      .None => assert(true)
    );
  };
});
// --- Phantom drop regression tests ---
// These test that match/cond inside function arguments don't cause phantom drops
// of undeclared temp variables (fixed in consumeCaseBodyTempVar).
test("Test match inside function arg - no phantom drop", {
  Color :: enum(Red, Green, Blue);
  color_name :: (fn(c : Color) -> String)(
    match(
      c,
      .Red => `red`,
      .Green => `green`,
      .Blue => `blue`
    )
  );
  result := color_name(.Red);
  assert(result == `red`, "match inside fn arg should work");
  result2 := color_name(.Blue);
  assert(result2 == `blue`, "match inside fn arg should work for Blue");
});
test("Test cond inside function arg - no phantom drop", {
  classify :: (fn(x : i32) -> String)(
    cond(
      (x > i32(0)) => `positive`,
      (x < i32(0)) => `negative`,
      true => `zero`
    )
  );
  result := classify(i32(5));
  assert(result == `positive`, "cond inside fn arg should work");
  result2 := classify(i32(0));
  assert(result2 == `zero`, "cond inside fn arg should work for zero");
});
test("Test match returning RC object - no phantom drop", {
  Tag :: enum(A, B);
  make_string :: (fn(t : Tag) -> String)(
    match(
      t,
      .A => `alpha`,
      .B => `beta`
    )
  );
  s1 := make_string(.A);
  s2 := make_string(.B);
  assert(s1 == `alpha`, "match returning RC String A");
  assert(s2 == `beta`, "match returning RC String B");
});
// Regression for inline-enum-match-subject-phantom-drop.md:
// constructing an enum with at least one object-payload variant directly as
// the subject of a match (not via a named local) used to emit a drop on an
// undeclared temp variable.
test("Test inline enum construction as match subject - no phantom drop", {
  Kind :: enum(Func, Arr, Obj(s : String));
  match(Kind.Func,.Func => (), _ => ());
  match(Kind.Arr,.Arr => (), _ => ());
  match(Kind.Obj(`payload`),.Obj(s) => assert(s == `payload`, "Obj payload"), _ => ());
});
// --- Array index access with RC types ---
// Regression tests for the inline incr_rc leak (array-index-rc-leak.md).
// Only ubuntu/Linux detected the leak via LeakSanitizer; macOS ARM lacks it.
test("Test array index access - no RC leak for inline use", {
  // Inline access: y(0).* should NOT dup (no ownership transfer)
  {
    x := Box(i32)(42);
    y := [x,];
    assert(y(0).* == 42, "inline y(0).* should read without leak");
    assert(y(0).* == 42, "second inline y(0).* should also not leak");
    assert(y(0).* == 42, "third inline y(0).* should also not leak");
  };
  // Assigned access: tmp := y(0) should dup exactly once
  {
    x := Box(i32)(7);
    y := [x,];
    tmp := y(0);
    assert(tmp.* == 7, "assigned y(0) should work");
    assert(rc(tmp) == 2, "tmp and y(0) should share RC=2");
    assert(rc(x) == 2, "x and y(0) are the same allocation");
  };
  // Multi-element array with inline access
  {
    a := Box(i32)(10);
    b := Box(i32)(20);
    c := Box(i32)(30);
    arr := [a, b, c,];
    assert(arr(0).* == 10, "arr(0).* == 10");
    assert(arr(1).* == 20, "arr(1).* == 20");
    assert(arr(2).* == 30, "arr(2).* == 30");
  };
  // Nested array access with inline use
  {
    x := Box(i32)(99);
    inner := [x,];
    outer := [inner,];
    assert(outer(0)(0).* == 99, "nested inline access should not leak");
  };
  // Array index used as function argument
  {
    identity :: (fn(b : Box(i32)) -> Box(i32))(b);
    x := Box(i32)(55);
    y := [x,];
    result := identity(y(0));
    assert(result.* == 55, "array index as fn arg should dup correctly");
  };
});
test("Test ArrayList index access - no RC leak", {
  // ArrayList of Box(i32) - inline access
  {
    list := ArrayList(Box(i32)).new();
    list.push(Box(i32)(100));
    list.push(Box(i32)(200));
    list.push(Box(i32)(300));
    assert(list(usize(0)).* == 100, "list(0).* == 100");
    assert(list(usize(1)).* == 200, "list(1).* == 200");
    assert(list(usize(2)).* == 300, "list(2).* == 300");
    // Multiple inline accesses should not leak
    assert(list(usize(0)).* == 100, "repeated list(0).* should not leak");
    assert(list(usize(0)).* == 100, "third list(0).* should not leak");
  };
  // ArrayList of Box(i32) - assigned access
  {
    list := ArrayList(Box(i32)).new();
    list.push(Box(i32)(42));
    elem := list(usize(0));
    assert(elem.* == 42, "assigned elem.* should work");
  };
  // ArrayList of String - inline access
  {
    list := ArrayList(String).new();
    list.push(`hello`);
    list.push(`world`);
    assert(list(usize(0)) == `hello`, "list(0) == hello");
    assert(list(usize(1)) == `world`, "list(1) == world");
    // Repeated access should not leak
    assert(list(usize(0)) == `hello`, "repeated list(0) should not leak");
  };
  // ArrayList of String - assigned access
  {
    list := ArrayList(String).new();
    list.push(`test`);
    s := list(usize(0));
    assert(s == `test`, "assigned string from ArrayList should work");
  };
});
test("Test array of objects - no RC leak", {
  Container :: ref(struct(value : i32));
  // Inline access to array of objects
  {
    c1 := Container(i32(1));
    c2 := Container(i32(2));
    c3 := Container(i32(3));
    arr := [c1, c2, c3,];
    assert(arr(0).value == i32(1), "arr(0).value == 1");
    assert(arr(1).value == i32(2), "arr(1).value == 2");
    assert(arr(2).value == i32(3), "arr(2).value == 3");
  };
  // Assigned access to array of objects
  {
    c := Container(i32(42));
    arr := [c,];
    elem := arr(0);
    assert(elem.value == i32(42), "assigned object from array should work");
  };
  // Inline access does not increase RC
  {
    c := Container(i32(77));
    arr := [c,];
    val := arr(0).value;
    assert(val == i32(77), "inline field read works");
  };
});
test("Test array index in expressions - no RC leak", {
  // Array index inside comparison
  {
    x := Box(i32)(10);
    y := Box(i32)(10);
    arr := [x, y,];
    assert(arr(0).* == arr(1).*, "comparing array elements inline");
  };
  // Array index inside arithmetic
  {
    a := Box(i32)(5);
    b := Box(i32)(3);
    arr := [a, b,];
    sum := (arr(0).* + arr(1).*);
    assert(sum == 8, "sum of array elements via inline access");
  };
  // Array index used in cond
  {
    x := Box(i32)(42);
    arr := [x,];
    result := cond(
      (arr(0).* > 0) => true,
      true => false
    );
    assert(result, "array index in cond should not leak");
  };
  // Deeply nested inline access
  {
    x := Box(i32)(1);
    a := [x,];
    b := [a,];
    c := [b,];
    d := [c,];
    assert(d(0)(0)(0)(0).* == 1, "4-deep nested inline access should not leak");
  };
});
test("Test chained method calls - no duplicate var", {
  // Regression test: chained method calls on ArrayList should not
  // cause duplicate temp variable declarations in generated C.
  list := ArrayList(i32).new();
  list.push(i32(10));
  list.push(i32(20));
  list.push(i32(30));
  // Chained get_ptr access (the pattern that triggered the duplicate var bug)
  val := list(usize(1));
  assert(val == i32(20), "index access should work");
  val2 := list(usize(0));
  assert(val2 == i32(10), "index access should work at index 0");
});
test("Test nested && with RC temps - no phantom drop", {
  // Regression test: nested && should not emit drops for temp vars
  // declared inside inner conditional branches
  make_str :: (fn(s : str) -> String)(String.from(s));
  a := make_str("hello");
  b := make_str("world");
  c := make_str("test");
  // Nested &&: inner && creates temp vars that outer && must not drop
  result := (((a.len() > usize(0)) && (b.len() > usize(0))) && (c.len() > usize(0)));
  assert(result, "nested && should work with RC temps");
  // Nested || inside &&
  result2 := ((a.len() > usize(0)) && ((b.len() > usize(0)) || (c.len() > usize(0))));
  assert(result2, "nested || inside && should work with RC temps");
  // Triple nesting
  result3 := (((a.len() > usize(0)) && (b.len() > usize(0))) && ((c.len() > usize(0)) || (make_str("x").len() > usize(0))));
  assert(result3, "triple nested && || should work with RC temps");
  ();
});
test("Test early return of reassigned RC variable does not leak", {
  // Regression test for: issues/early-return-reassigned-rc-variable-leak.md
  //
  // When an RC variable is reassigned inside a while loop and returned early
  // from inside a match branch, the current value must be dropped after dup'ing
  // it for the return value.
  // (ArrayList is already imported at the top of this file)
  build_string :: (fn(parts : ArrayList(str)) -> String)({
    result := String.new();
    i := usize(0);
    while(i < parts.len(), {
      match(
        parts.get(i),
        .Some(s) => {
          result = result.concat(String.from(s));
          i = (i + usize(1));
        },
        .None => {
          return(result);
        }
      );
    });
    result
  });
  parts := ArrayList(str).new();
  parts.push("hello ");
  parts.push("world");
  s := build_string(parts);
  assert(s.len() == usize(11), "result should be 'hello world' (11 chars)");
  // If the RC is wrong (leak), ASAN will report it.
  assert(rc(s) == 1, "rc(s) should be 1 after early return");
});
test("Returning an OWNED RC local from inside a branch is not double-dropped", {
  // The `return(out)` below dups `out` for the caller (rc 1 -> 2) and the
  // early-return path must release the local exactly once (2 -> 1). Codegen
  // used to emit that release TWICE — once from the return's
  // earlyReturnOnlyDeferredDropExpressions and again from the consumed-var
  // escape drops — so rc hit 0, the buffer was freed, and the caller received a
  // dangling pointer. See issues/fixed/yo-return-owned-local-in-branch-double-drop.md.
  build :: (fn(early : bool) -> ArrayList(i32))({
    out := ArrayList(i32).new();
    if(early, {
      out.push(i32(7));
      return(out);
    });
    out.push(i32(2));
    out.push(i32(3));
    out
  });
  a := build(true);
  assert(a.len() == usize(1), "early-return branch should yield 1 element");
  assert(a(usize(0)) == i32(7), "the surviving element should be 7");
  assert(rc(a) == 1, "rc(a) should be 1 — dup for the caller, one release of the local");
  b := build(false);
  assert(b.len() == usize(2), "fallthrough should yield 2 elements");
  assert(b(usize(0)) == i32(2), "b(0) should be 2");
  assert(b(usize(1)) == i32(3), "b(1) should be 3");
  assert(rc(b) == 1, "rc(b) should be 1");
});
// --- Inline `ref(enum)` payload-free variant construction ---
// Regression for issues/fixed/ref-enum-unit-variant-inline-construction-leak.md.
//
// A payload-free variant of a `ref(enum)` heap-allocates exactly like the
// payload-carrying form — codegen emits `__yo_new_<Enum>_<Variant>()`, which
// mallocs with ref_count = 1 — but the evaluator never attached an owning temp
// variable to it, so nothing was ever registered to drop the allocation.
// Passing one inline as an argument leaked it once per evaluation: the callee
// treats the parameter as borrowed and dups whatever it retains, so the
// constructor's own +1 was never released. LeakSanitizer caught this in
// tests/internal/context.test.yo, where `EvalValue.UnitVal` is passed inline to
// create_function_body_evaluation_context.
//
// The `rc()` assertions are the deterministic gate. The argument temp is
// released at `mk_*`'s scope end, so a caller reading the retained field
// afterwards sees rc == 1 when the release happened and rc == 2 when it leaked.
// That holds on every platform, unlike LeakSanitizer (Linux only) or macOS
// `leaks` (at -O2, LLVM deletes an allocation whose result is discarded, which
// hides exactly the non-argument positions covered by the second test).
//
// `mk_unit` / `mk_payload` use bare tail-expression bodies, so this test also
// gates the bare-tail scope-end drop: the self-hosted compiler used to emit no
// drop at all for the argument temp of a bare tail-expression body (both arms
// reported rc == 2 under it even though TS emitted the drop) — see
// issues/fixed/yo-self-tail-expression-arg-temp-drop-missing.md.
test("Inline ref-enum unit-variant argument is released by the caller", {
  Val :: ref(enum(UnitVal, IntVal(v : i32)));
  Held :: struct(v : Val);
  keep :: (fn(x : Val) -> Held)(Held(v : x));
  mk_unit :: (fn() -> Held)(keep(Val.UnitVal));
  mk_payload :: (fn() -> Held)(keep(Val.IntVal(v : i32(7))));
  u := mk_unit();
  assert(rc(u.v) == 1, "payload-free variant: the caller must release its argument temp");
  p := mk_payload();
  assert(rc(p.v) == 1, "payload-carrying variant: unchanged");
  // A direct binding must TRANSFER ownership of the temp, not add a second owner.
  a := Val.UnitVal;
  assert(rc(a) == 1, "binding a unit variant owns exactly one reference");
  // Struct-literal field: the aggregate takes the allocation by move.
  h := Held(v : Val.UnitVal);
  assert(rc(h.v) == 1, "struct-literal field takes the unit variant by move");
});
test("Inline ref-enum unit-variant in non-argument positions does not leak", {
  Val :: ref(enum(UnitVal, IntVal(v : i32)));
  is_unit :: (fn(x : Val) -> bool)(
    match(
      x,
      .UnitVal => true,
      .IntVal(v) => false
    )
  );
  // Discarded statement expression.
  Val.UnitVal;
  // Match subject.
  match(Val.UnitVal,.UnitVal => (),.IntVal(v) => ());
  // Condition and short-circuit operand positions, inside a loop so a
  // per-iteration leak accumulates instead of costing one object.
  (i : usize) = usize(0);
  while(i < usize(3), {
    c := cond(is_unit(Val.UnitVal) => true, true => false);
    assert(c, "cond condition");
    b := (is_unit(Val.UnitVal) && is_unit(Val.IntVal(v : i32(1))));
    assert(!(b), "short-circuit operands");
    i = (i + usize(1));
  });
  // Enum-payload position: the outer variant takes the inner one by move.
  o := Option(Val).Some(Val.UnitVal);
  assert(
    match(
      o,
      .Some(v) => is_unit(v),
      .None => false
    ),
    "Option payload"
  );
});
// Regression: a local dup'd inside ONE arm of an `if` (a macro expanding to
// cond) must keep its scope-end drop. The dup/drop pair optimizer used to
// reach the arm's dup through the raw macro-call args (branch-blind), cancel
// the pair, and mark the variable consumed — leaking one reference on every
// path that did not take the arm (issues/fixed/where-constraints-arraylist-96b-leak.md).
CondMoveHolder :: struct(items : ArrayList(i32));
g_cond_move_seen := ArrayList(ArrayList(i32)).new();
cond_move_make_fresh :: (fn() -> ArrayList(i32))({
  l := ArrayList(i32).new();
  g_cond_move_seen.push(l);
  l
});
cond_move_work :: (fn(flag : bool) -> unit)({
  entries := cond_move_make_fresh();
  if(flag, {
    h := CondMoveHolder(items : entries);
    assert(h.items.len() == usize(0), "held list is empty");
  });
});
test("Conditional move into a struct field balances both paths", {
  cond_move_work(true);
  cond_move_work(false);
  taken := match(g_cond_move_seen.get(usize(0)),.Some(l) => l,.None => ArrayList(i32).new());
  skipped := match(g_cond_move_seen.get(usize(1)),.Some(l) => l,.None => ArrayList(i32).new());
  assert(
    rc(taken) == rc(skipped),
    "skipped-branch call must not retain an extra reference"
  );
});
// Regression: the loop-traversal borrow-chain optimization
// (optimizeLoopTraversalBorrowChain) must NOT fire when the loop body
// mutates the structure it traverses. Severing head.next while current_opt
// borrowed the severed sublist freed the nodes mid-walk — the traversal then
// read freed memory and visited garbage (use-after-free, found 2026-08-06).
TraversalNode :: ref(struct(value : i32, next : Option(Self)));
traversal_walk_with_sever :: (fn(head : TraversalNode) -> i32)({
  (current_opt : Option(TraversalNode)) = head.next;
  (first : bool) = true;
  (total : i32) = 0;
  while(runtime(true), {
    match(
      current_opt,
      .None => return(total),
      .Some(current) => {
        if(first, {
          first = false;
          head.next = Option(TraversalNode).None;
        });
        total = (total + current.value);
        current_opt = current.next;
      }
    );
  });
  total
});
test("Loop traversal keeps ownership when the loop mutates the structure", {
  head := TraversalNode(
    value : 1,
    next : Option(TraversalNode).Some(
      TraversalNode(
        value : 2,
        next : Option(TraversalNode).Some(TraversalNode(value : 3, next : Option(TraversalNode).None))
      )
    )
  );
  assert(
    traversal_walk_with_sever(head) == 5,
    "severed traversal must still visit nodes 2 and 3 (owned, not borrowed)"
  );
});
// Regression: a fn whose ENTIRE body is a bare `___ := <owned value>`
// statement. The self-hosted compiler once flushed the body-level deferred
// drops BEFORE the statement, emitting `___drop(___)` against a binding not
// yet declared in C — the emitted program failed to compile (`use of
// undeclared identifier '___'`), and reordering must still drop the
// discarded value (issues/fixed/yo-self-tail-expression-arg-temp-drop-missing.md,
// follow-up commit).
g_discard_seen := ArrayList(ArrayList(i32)).new();
discard_make_tracked :: (fn() -> ArrayList(i32))({
  l := ArrayList(i32).new();
  g_discard_seen.push(l);
  l
});
discard_stmt_body :: (fn() -> unit)(___ := discard_make_tracked());
test("Bare discard-statement fn body compiles and drops the discarded value", {
  discard_stmt_body();
  survivor := match(g_discard_seen.get(usize(0)),.Some(l) => l,.None => ArrayList(i32).new());
  // rc = 3: the g_discard_seen element, the match-arm extraction, and
  // `survivor` itself. Before the fix the discarded value kept a 4th ref
  // (and, under the self-hosted compiler, this file did not even compile —
  // `use of undeclared identifier '___'`).
  assert(
    rc(survivor) == 3,
    "discarded value must be dropped (rc 3, not 4)"
  );
});
