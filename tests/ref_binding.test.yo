{ assert } :: import("std/assert");
/// `inout(name) : T` parameter semantics — reads and writes through the
/// parameter access the caller's storage. v4.1
/// (plans/BORROW_EXCLUSIVITY.md): `ref` exists ONLY in parameter
/// position, so every test here goes through a ref param.
Point :: struct(x : i32, y : i32);
/// Enum regression type (was the project-enum / enum-field-borrow test).
RefBindEnum :: enum(A(v : i32), B(w : i32));
EnumHolder :: ref(struct(e : RefBindEnum));
test("read through a ref param", {
  get_x :: (fn(inout(p) : Point) -> i32)(p.x);
  pt := Point(x : i32(10), y : i32(20));
  assert(get_x(pt) == i32(10), "read via ref param");
});
test("write through a ref param propagates to the caller", {
  set_x :: (fn(inout(p) : Point, value : i32) -> unit)({
    p.x = value;
  });
  pt := Point(x : i32(10), y : i32(20));
  set_x(pt, i32(99));
  assert(pt.x == i32(99), "write via ref param propagates to caller's pt.x");
  assert(pt.y == i32(20), "unrelated field is untouched");
});
test("ref params chain through nested calls", {
  inner :: (fn(inout(q) : Point) -> unit)({
    q.x = (q.x + i32(1));
  });
  outer :: (fn(inout(p) : Point) -> unit)({
    inner(p);
    inner(p);
  });
  pt := Point(x : i32(0), y : i32(0));
  outer(pt);
  assert(pt.x == i32(2), "two increments through the chained refs");
});
test("enum field writes in place (no borrow needed)", {
  holder := EnumHolder(e : RefBindEnum.A(i32(7)));
  v0 := match(holder.e,.A(v) => v,.B(w) => w);
  assert(v0 == i32(7), "enum field reads 7");
  holder.e = RefBindEnum.A(i32(100));
  v0b := match(holder.e,.A(v) => v,.B(w) => w);
  assert(v0b == i32(100), "enum field write lands in place");
});
