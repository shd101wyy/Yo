{ String } :: import("std/string");
import("std/fmt");
{ assert, panic } :: import("std/assert");
{
  sanitize_project_name,
  generate_build_yo,
  generate_main_source,
  generate_lib_source,
  generate_test_file,
  generate_lib_test_file,
  generate_yo_toml,
  generate_gitignore,
  generate_readme,
  generate_spec_readme,
  generate_spec_example_law,
  generate_agents_md,
  generate_claude_md
} :: import("../../src/init.yo");
// ---------------------------------------------------------------------------
// sanitize_project_name
// ---------------------------------------------------------------------------
test("sanitize_project_name: underscores become hyphens (kebab-case)", {
  name := sanitize_project_name(String.from("my_project-123"));
  assert(name == "my-project-123", `kebab form, got ${name}`);
});
test("sanitize_project_name: kebab-case unchanged", {
  name := sanitize_project_name(String.from("markdown-yo"));
  assert(name == "markdown-yo", `already kebab, got ${name}`);
});
test("sanitize_project_name: upper case is lowercased", {
  name := sanitize_project_name(String.from("My_Project 2"));
  assert(name == "my-project-2", `lowercased kebab, got ${name}`);
});
test("sanitize_project_name: runs of separators collapse, ends are trimmed", {
  name := sanitize_project_name(String.from("__foo--_bar..baz-_"));
  assert(name == "foo-bar-baz", `collapsed and trimmed, got ${name}`);
});
test("sanitize_project_name: no letter or digit sanitizes to empty", {
  name := sanitize_project_name(String.from("_-_"));
  assert(name.len() == usize(0), `only separators, got ${name}`);
});
test("sanitize_project_name: spaces replaced with hyphens", {
  name := sanitize_project_name(String.from("my project"));
  assert(name == "my-project", "spaces become hyphens");
});
test("sanitize_project_name: dots replaced with hyphens", {
  name := sanitize_project_name(String.from("my.project"));
  assert(name == "my-project", "dots become hyphens");
});
test("sanitize_project_name: mixed special chars", {
  name := sanitize_project_name(String.from("foo@bar!baz"));
  assert(name == "foo-bar-baz", "special chars replaced");
});
test("sanitize_project_name: empty string returns empty", {
  name := sanitize_project_name(String.from(""));
  assert(name.len() == usize(0), "empty in, empty out");
});
// ---------------------------------------------------------------------------
// generate_build_yo
// ---------------------------------------------------------------------------
test("generate_build_yo: contains project name", {
  out := generate_build_yo(String.from("myapp"));
  assert(out.contains(String.from("myapp")), "build.yo contains project name");
});
test("generate_build_yo: contains install step", {
  out := generate_build_yo(String.from("x"));
  assert(out.contains(String.from("install")), "build.yo has install step");
});
// ---------------------------------------------------------------------------
// generate_readme
// ---------------------------------------------------------------------------
test("generate_readme: contains project name as heading", {
  out := generate_readme(String.from("cool-lib"));
  assert(out.contains(String.from("cool-lib")), "README contains project name");
});
// ---------------------------------------------------------------------------
// generate_lib_test_file
// ---------------------------------------------------------------------------
test("generate_lib_test_file: imports the library by PACKAGE NAME", {
  out := generate_lib_test_file(String.from("cool-lib"));
  // Not a relative path: the scaffolded test must go through the manifest's
  // `[modules] default` entry, which is what makes `yo init` exercise the
  // package system rather than reach across the tree.
  assert(out.contains(String.from("import(\"cool-lib\")")), "imports by package name");
  assert(!out.contains(String.from("../src/lib.yo")), "does not import by relative path");
});
test("generate_lib_test_file: actually calls the scaffolded `add`", {
  out := generate_lib_test_file(String.from("x"));
  assert(out.contains(String.from("add(2, 3)")), "calls add from src/lib.yo");
  assert(out.contains(String.from("test(")), "is a test file");
});
// ---------------------------------------------------------------------------
// generate_readme — the layout/dependency sections the build redesign needs
// ---------------------------------------------------------------------------
test("generate_readme: documents the manifest, the lock and how to add deps", {
  out := generate_readme(String.from("cool-lib"));
  assert(out.contains(String.from("yo.toml")), "README mentions the manifest");
  assert(out.contains(String.from("yo.lock")), "README mentions the lock file");
  assert(out.contains(String.from("yo add")), "README shows how to add a dependency");
  assert(out.contains(String.from("yo install")), "README shows how to fetch them");
});
// ---------------------------------------------------------------------------
// generate_* pure string functions compile and return non-empty
// ---------------------------------------------------------------------------
test("generate_main_source: non-empty", {
  s := String.from(generate_main_source());
  assert(s.len() > usize(0), "main source is non-empty");
});
test("generate_lib_source: non-empty", {
  s := String.from(generate_lib_source());
  assert(s.len() > usize(0), "lib source is non-empty");
});
test("generate_test_file: non-empty", {
  s := String.from(generate_test_file());
  assert(s.len() > usize(0), "test file is non-empty");
});
test("generate_yo_toml: declares the package, its default module and an empty dependency table", {
  toml := generate_yo_toml(String.from("demo"));
  assert(toml.contains("[package]"), "package table");
  assert(toml.contains("name = \"demo\""), "package name");
  assert(toml.contains("[modules]"), "modules table");
  assert(toml.contains("default = \"src/lib.yo\""), "default module");
  assert(toml.contains("[dependencies]"), "dependencies table");
});
test("generate_gitignore: contains yo-out/", {
  s := String.from(generate_gitignore());
  assert(s.contains(String.from("yo-out/")), "gitignore excludes yo-out/");
});
// ---------------------------------------------------------------------------
// generate_agents_md
// ---------------------------------------------------------------------------
test("generate_agents_md: opens its command block with `yo context`", {
  md := generate_agents_md();
  assert(md.contains(String.from("# AGENTS.md")), "title present");
  assert(md.contains(String.from("yo context       # the language pack + API index — read this first")), "yo context is the first command");
});
test("generate_agents_md: carries no skill-tree text", {
  md := generate_agents_md();
  assert(!md.contains(String.from("skill")), "no skills section");
  assert(!md.contains(String.from("yo skills install")), "the removed command is not taught");
});
test("generate_claude_md: is the one-line @AGENTS.md import", {
  md := generate_claude_md();
  assert(md == "@AGENTS.md\n", "CLAUDE.md imports AGENTS.md and nothing else");
});
test("generate_agents_md: teaches the strict verify gate over spec/", {
  md := generate_agents_md();
  assert(md.contains(String.from("yo verify ./spec --strict")), "recipe names the verify gate");
});
// ---------------------------------------------------------------------------
// generate_spec_readme / generate_spec_example_law — the spec/ scaffold
// (issues/fixed/init-agentsmd-template-omits-the-verify-recipe.md: the
// AGENTS.md recipe teaches `yo verify ./spec --strict`, so the scaffold must
// ship a spec/ that keeps that gate green — the README states the wall, the
// seed law is the first proving claim.)
// ---------------------------------------------------------------------------
test("generate_spec_readme: states the claims/proofs wall and the CODEOWNERS line", {
  md := generate_spec_readme();
  assert(md.contains(String.from("yo verify ./spec --strict")), "names the gate");
  assert(md.contains(String.from("CODEOWNERS")), "names the CODEOWNERS line to add");
});
test("generate_spec_readme: points at the seed law", {
  md := generate_spec_readme();
  assert(md.contains(String.from("example.yo")), "references the seed law file");
});
test("generate_spec_example_law: is a law file over a contracted callee", {
  src := generate_spec_example_law();
  assert(src.contains(String.from("pragma(Pragma.Verify);")), "verify pragma present");
  assert(src.contains(String.from(":: law(")), "declares a law");
  assert(src.contains(String.from("requires(")), "the callee carries a contract");
});
