open(import("std/string"));
open(import("std/fmt"));
{ assert, panic } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{
  sanitize_project_name,
  generate_build_yo,
  generate_main_source,
  generate_lib_source,
  generate_test_file,
  generate_deps_yo,
  generate_gitignore,
  generate_readme,
  generate_agents_md,
  generate_claude_md
} :: import("../../src/init.yo");
{ SkillEntry, description_from_frontmatter } :: import("../../src/skills_command.yo");
// ---------------------------------------------------------------------------
// sanitize_project_name
// ---------------------------------------------------------------------------
test("sanitize_project_name: alphanumeric unchanged", {
  name := sanitize_project_name(String.from("my_project-123"));
  assert(name == "my_project-123", "valid chars unchanged");
});
test("sanitize_project_name: spaces replaced with hyphens", {
  name := sanitize_project_name(String.from("my project"));
  assert(name == "my-project", "spaces become hyphens");
});
test("sanitize_project_name: dots replaced with hyphens", {
  name := sanitize_project_name(String.from("my.project"));
  assert(name == "my-project", "dots become hyphens");
});
test("sanitize_project_name: mixed special chars", {
  name := sanitize_project_name(String.from("foo@bar!baz"));
  assert(name == "foo-bar-baz", "special chars replaced");
});
test("sanitize_project_name: empty string returns empty", {
  name := sanitize_project_name(String.from(""));
  assert(name.len() == usize(0), "empty in, empty out");
});
// ---------------------------------------------------------------------------
// generate_build_yo
// ---------------------------------------------------------------------------
test("generate_build_yo: contains project name", {
  out := generate_build_yo(String.from("myapp"));
  assert(out.contains(String.from("myapp")), "build.yo contains project name");
});
test("generate_build_yo: contains install step", {
  out := generate_build_yo(String.from("x"));
  assert(out.contains(String.from("install")), "build.yo has install step");
});
// ---------------------------------------------------------------------------
// generate_readme
// ---------------------------------------------------------------------------
test("generate_readme: contains project name as heading", {
  out := generate_readme(String.from("cool-lib"));
  assert(out.contains(String.from("cool-lib")), "README contains project name");
});
// ---------------------------------------------------------------------------
// generate_* pure string functions compile and return non-empty
// ---------------------------------------------------------------------------
test("generate_main_source: non-empty", {
  s := String.from(generate_main_source());
  assert(s.len() > usize(0), "main source is non-empty");
});
test("generate_lib_source: non-empty", {
  s := String.from(generate_lib_source());
  assert(s.len() > usize(0), "lib source is non-empty");
});
test("generate_test_file: non-empty", {
  s := String.from(generate_test_file());
  assert(s.len() > usize(0), "test file is non-empty");
});
test("generate_deps_yo: contains export(imports)", {
  s := String.from(generate_deps_yo());
  assert(s.contains(String.from("export(imports)")), "deps.yo exports imports");
});
test("generate_gitignore: contains yo-out/", {
  s := String.from(generate_gitignore());
  assert(s.contains(String.from("yo-out/")), "gitignore excludes yo-out/");
});
// ---------------------------------------------------------------------------
// generate_agents_md / generate_claude_md
// ---------------------------------------------------------------------------
_make_skills :: (fn() -> ArrayList(SkillEntry))({
  skills := ArrayList(SkillEntry).new();
  skills.push(SkillEntry(name : String.from("yo-syntax"), description : String.from("Write and repair Yo source code.")));
  skills.push(SkillEntry(name : String.from("yo-core-patterns"), description : String.from("")));
  skills
});
_make_one_target :: (fn() -> ArrayList(String))({
  targets := ArrayList(String).new();
  targets.push(String.from(".agents"));
  targets
});
test("generate_claude_md: one-line pointer at AGENTS.md", {
  s := String.from(generate_claude_md());
  assert(s == "@AGENTS.md\n", "CLAUDE.md points at AGENTS.md");
});
test("generate_agents_md: lists skill names and descriptions", {
  md := generate_agents_md(_make_skills(), _make_one_target());
  assert(md.contains(String.from("- **yo-syntax** — Write and repair Yo source code.")), "bullet carries the description");
  assert(md.contains(String.from("- **yo-core-patterns**\n")), "empty description omits the dash");
});
test("generate_agents_md: mentions install location", {
  md := generate_agents_md(_make_skills(), _make_one_target());
  assert(md.contains(String.from("`.agents/skills/`")), "location sentence names the skills dir");
});
test("generate_agents_md: multiple targets joined", {
  targets := ArrayList(String).new();
  targets.push(String.from(".agents"));
  targets.push(String.from(".github"));
  md := generate_agents_md(_make_skills(), targets);
  assert(md.contains(String.from("`.agents/skills/`, `.github/skills/`")), "both locations listed");
});
test("generate_agents_md: tells agents how to refresh skills", {
  md := generate_agents_md(_make_skills(), _make_one_target());
  assert(md.contains(String.from("yo skills install")), "refresh hint present");
});
test("generate_agents_md: empty skill list still valid markdown", {
  md := generate_agents_md(ArrayList(SkillEntry).new(), _make_one_target());
  assert(md.contains(String.from("# AGENTS.md")), "title present");
  assert(md.contains(String.from("yo skills install")), "points at the install command");
  assert(!md.contains(String.from("- **")), "no skill bullets");
});
// ---------------------------------------------------------------------------
// description_from_frontmatter — the SKILL.md frontmatter scan
// ---------------------------------------------------------------------------
test("description_from_frontmatter: reads the value after 'description:'", {
  md := String.from("---\nname: yo-syntax\ndescription: Write and repair Yo source code.\n---\n\nbody\n");
  assert(description_from_frontmatter(md) == "Write and repair Yo source code.", "value is read verbatim");
});
test("description_from_frontmatter: keeps the first character when there is no space", {
  // "description:" is 12 bytes; slicing at 13 ate the 'U' and yielded
  // "nspaced". Every bundled SKILL.md writes one space, so the off-by-one
  // was invisible until a skill omitted it.
  md := String.from("---\ndescription:Unspaced value\n---\n");
  assert(description_from_frontmatter(md) == "Unspaced value", "no leading character is dropped");
});
test("description_from_frontmatter: tolerates extra spaces after the colon", {
  md := String.from("---\ndescription:    Padded   \n---\n");
  assert(description_from_frontmatter(md) == "Padded", "surrounding space is trimmed");
});
test("description_from_frontmatter: a body horizontal rule cannot resurrect the scan", {
  // The scan stops at the CLOSING fence. Without that it fell back to
  // "looking for an opening ---", so a markdown hrule in the body re-opened
  // frontmatter and body prose could match `description:`.
  md := String.from("---\nname: only-a-name\n---\n\nintro\n\n---\n\ndescription: body prose, not the frontmatter\n");
  assert(description_from_frontmatter(md) == "", "body text is never taken as the description");
});
test("description_from_frontmatter: missing description yields empty", {
  md := String.from("---\nname: no-description\n---\n\nbody\n");
  assert(description_from_frontmatter(md) == "", "absent description is empty, not an error");
});
test("description_from_frontmatter: content with no frontmatter yields empty", {
  md := String.from("# Just a heading\n\ndescription: not in frontmatter\n");
  assert(description_from_frontmatter(md) == "", "a description outside frontmatter is ignored");
});
