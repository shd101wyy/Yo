open(import("std/string"));
open(import("std/fmt"));
{ assert, panic } :: import("std/assert");
{
  parse_yo_version,
  current_yo_version,
  is_pinned_version_current,
  CURRENT_YO_VERSION
} :: import("../../yo-self/version.yo");
// ---------------------------------------------------------------------------
// parse_yo_version tests
// ---------------------------------------------------------------------------
test("parse_yo_version: plain semver is accepted", {
  result := parse_yo_version(String.from("0.1.12"));
  match(
    result,
    .Err(e) => {
      println(`unexpected Err: ${e}`);
      assert(false, "expected Ok for '0.1.12'");
    },
    .Ok(v) => assert(v == "0.1.12", "version normalised correctly")
  );
});
test("parse_yo_version: v-prefix is stripped", {
  result := parse_yo_version(String.from("v0.1.12"));
  match(
    result,
    .Err(e) => {
      println(`unexpected Err: ${e}`);
      assert(false, "expected Ok for 'v0.1.12'");
    },
    .Ok(v) => assert(v == "0.1.12", "v prefix stripped")
  );
});
test("parse_yo_version: V-prefix is stripped", {
  result := parse_yo_version(String.from("V2.0.0"));
  match(
    result,
    .Err(e) => {
      println(`unexpected Err: ${e}`);
      assert(false, "expected Ok for 'V2.0.0'");
    },
    .Ok(v) => assert(v == "2.0.0", "V prefix stripped")
  );
});
test("parse_yo_version: pre-release suffix is accepted", {
  result := parse_yo_version(String.from("1.0.0-alpha.1"));
  match(
    result,
    .Err(e) => {
      println(`unexpected Err: ${e}`);
      assert(false, "expected Ok for '1.0.0-alpha.1'");
    },
    .Ok(_) => ()
  );
});
test("parse_yo_version: build metadata suffix is accepted", {
  result := parse_yo_version(String.from("1.0.0+build.42"));
  match(
    result,
    .Err(e) => {
      println(`unexpected Err: ${e}`);
      assert(false, "expected Ok for '1.0.0+build.42'");
    },
    .Ok(_) => ()
  );
});
test("parse_yo_version: empty string returns Err", {
  result := parse_yo_version(String.from(""));
  match(
    result,
    .Ok(v) => {
      println(`unexpected Ok: ${v}`);
      assert(false, "expected Err for empty string");
    },
    .Err(_) => ()
  );
});
test("parse_yo_version: latest returns Err", {
  result := parse_yo_version(String.from("latest"));
  match(
    result,
    .Ok(v) => {
      println(`unexpected Ok: ${v}`);
      assert(false, "expected Err for 'latest'");
    },
    .Err(_) => ()
  );
});
test("parse_yo_version: LATEST (uppercase) returns Err", {
  result := parse_yo_version(String.from("LATEST"));
  match(
    result,
    .Ok(v) => {
      println(`unexpected Ok: ${v}`);
      assert(false, "expected Err for 'LATEST'");
    },
    .Err(_) => ()
