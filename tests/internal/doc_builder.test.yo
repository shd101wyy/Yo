/// Tests for `src/doc/builder.yo`'s doc-comment joins: the gate on
/// compiler-internal module fields, and the per-receiver attachment of impl
/// members' `///` comments.
///
/// `yo doc` published the evaluator's own temporaries as documented API — 790
/// `__private_tmp_temp_<digits>` entries in `prelude` alone, rendered as
/// sidebar links to `#const-…` anchors that document nothing, and repeated in
/// every page's search index. The gate existed but was a PREFIX LIST
/// (`___`, `__yo_`) and a temp's prefix is its module path, so no literal
/// prefix can catch them all.
///
/// The doc lookup also keyed every comment by BARE declaration name, so two
/// types in one file with a same-named member (`new` on both) rendered the
/// later impl's prose on BOTH methods
/// (`issues/fixed/stddoc-core-doc-comment-attached-by-bare-member-name.md`).
{ String } :: import("std/string");
{ assert, panic } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ Exception } :: import("std/error");
{ DocModule, DocField, DocVariant, DocFunction } :: import("../../src/doc/model.yo");
{ tokenize } :: import("../../src/lexer.yo");
{ extract_doc_comments } :: import("../../src/doc/extractor.yo");
{ is_compiler_internal_field_name, build_doc_lookup, extract_impl_info_from_tokens, build_doc_module_from_tokens } :: import(
  "../../src/doc/builder.yo"
);
// ---------------------------------------------------------------------------
// What must be hidden
// ---------------------------------------------------------------------------
test("is_compiler_internal_field_name: the prelude's temporaries are internal", {
  // The exact spelling that reached published documentation.
  assert(
    is_compiler_internal_field_name(`__private_tmp_temp_10626258249951560750`),
    "a prelude temporary is not API"
  );
});
test("is_compiler_internal_field_name: a temp under ANY module path is internal", {
  // The prefix is the sanitized module path, so the spelling differs per
  // module. A literal `__private_` check would clean the prelude alone.
  assert(is_compiler_internal_field_name(`_std_string_temp_42`), "std/string temp");
  assert(is_compiler_internal_field_name(`_src_lexer_yo_temp_7`), "a src temp");
  assert(is_compiler_internal_field_name(`__temp_1`), "empty module path still mints a temp");
});
test("is_compiler_internal_field_name: synthesized plumbing and runtime builtins", {
  assert(is_compiler_internal_field_name(`___dup`), "RC plumbing");
  assert(is_compiler_internal_field_name(`___drop`), "RC plumbing");
  assert(is_compiler_internal_field_name(`__yo_malloc`), "runtime builtin");
});
test("is_compiler_internal_field_name: the empty label of an anonymous impl block", {
  assert(is_compiler_internal_field_name(String.new()), "anonymous impl carries no label");
});
// ---------------------------------------------------------------------------
// What must STILL be documented — the gate must not over-reach
// ---------------------------------------------------------------------------
test("is_compiler_internal_field_name: ordinary public names are API", {
  assert(!is_compiler_internal_field_name(`push`), "a method name");
  assert(!is_compiler_internal_field_name(`String`), "a type name");
  assert(!is_compiler_internal_field_name(`MAX_SAFE_INTEGER`), "a constant");
});
test("is_compiler_internal_field_name: a single-underscore name is NOT swallowed", {
  // `_helper` is underscore-private, which is a SEPARATE policy question
  // (`--document-private`); this gate is only about compiler-generated names
  // and must not silently take that decision.
  assert(!is_compiler_internal_field_name(`_helper`), "underscore-private is not compiler-internal");
  assert(!is_compiler_internal_field_name(`__two_underscores`), "still a user name");
});
test("is_compiler_internal_field_name: temp-LOOKING user names stay documented", {
  // The predicate requires `_temp_` followed by digits only.
  assert(!is_compiler_internal_field_name(`_my_temp_buffer`), "digits required after _temp_");
  assert(!is_compiler_internal_field_name(`_a_temp_`), "no digits at all");
  assert(!is_compiler_internal_field_name(`_a_temp_3x`), "non-digit tail");
});
// ---------------------------------------------------------------------------
// Impl-member docs attach per receiver, not by bare member name
// ---------------------------------------------------------------------------
/// Two types in one file, each documenting a `new` — the exact shape that
/// crossed prose when the lookup was keyed by bare name.
_twin_new_source :: (fn() -> String)(
  `/// A plain value struct.\nVs :: struct(x : i32);\nimpl(\n  Vs,\n  /// Make one.\n  new : (fn(x : i32) -> Self)(Self(x)),\n  /// Read it.\n  get : (fn(self : Self) -> i32)(self.x)\n);\n/// A ref struct.\nRs :: ref(struct(y : i32));\nimpl(\n  Rs,\n  /// Make a ref one.\n  new : (fn(y : i32) -> Self)(Self(y))\n);\n`
);
/// One method's `doc` by name, or `.None` when the list has no such member.
_method_doc_of :: (fn(imm(methods) : ArrayList(DocFunction), imm(name) : String) -> Option(String))({
  (i : usize) = usize(0);
  while(i < methods.len(), {
    m := match(
      methods.get(i),
      .Some(x) => x,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    if(m.name == name, {
      return(m.doc);
    });
    i = (i + usize(1));
  });
  Option(String).None
});
_is_doc :: (fn(imm(doc) : Option(String), imm(expected) : String) -> bool)(
  match(
    doc,
    .Some(d) => (d == expected),
    .None => false
  )
);
test("a same-named impl member keeps its own receiver's doc comment", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected lexer error");
        unwind(());
      }
    )
  );
  tokens := tokenize(_twin_new_source(), `test.yo`, exn);
  lookup := build_doc_lookup(extract_doc_comments(tokens));
  impls := extract_impl_info_from_tokens(tokens, lookup);
  vs_methods := match(
    impls.get(`Vs`),
    .Some(e) => e.methods,
    .None => ArrayList(DocFunction).new()
  );
  assert(vs_methods.len() == usize(2), "Vs has new and get");
  assert(_is_doc(_method_doc_of(vs_methods, `new`), `Make one.`), "Vs.new carries its own comment");
  assert(_is_doc(_method_doc_of(vs_methods, `get`), `Read it.`), "and so does the unique member");
  rs_methods := match(
    impls.get(`Rs`),
    .Some(e) => e.methods,
    .None => ArrayList(DocFunction).new()
  );
  assert(
    _is_doc(_method_doc_of(rs_methods, `new`), `Make a ref one.`),
    "Rs.new keeps its own comment instead of overwriting Vs.new's"
  );
});
test("the impl scan records receiver-qualified doc keys for the registry lookups", {
  // `_extract_methods` / `_extract_generic_impl_info` — the evaluator half of
  // `build_doc_module`, which merges FIRST — see no token positions, so they
  // read the `Receiver.member` keys the token scan records in the shared
  // lookup map (HashMap is a ref type; the scan writes through).
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected lexer error");
        unwind(());
      }
    )
  );
  tokens := tokenize(_twin_new_source(), `test.yo`, exn);
  lookup := build_doc_lookup(extract_doc_comments(tokens));
  extract_impl_info_from_tokens(tokens, lookup);
  assert(_is_doc(lookup.get(`Vs.new`), `Make one.`), "a qualified key for Vs.new");
  assert(_is_doc(lookup.get(`Rs.new`), `Make a ref one.`), "a qualified key for Rs.new");
  assert(_is_doc(lookup.get(`Vs.get`), `Read it.`), "a qualified key for the unique member");
});
test("a doc comment separated from the member by a plain note still attaches", {
  // `_collect_doc_comment_before` stops at the first non-doc token, so the
  // intervening `//` note defeats the position join. The bare-name fallback
  // keeps the extractor's attachment — it skips regular comments — so this
  // shape keeps its doc rather than losing it.
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected lexer error");
        unwind(());
      }
    )
  );
  source := `impl(\n  Vs,\n  /// Make one.\n  // grouped under construction\n  new : (fn(x : i32) -> Self)(Self(x))\n);\n`;
  tokens := tokenize(source, `test.yo`, exn);
  lookup := build_doc_lookup(extract_doc_comments(tokens));
  impls := extract_impl_info_from_tokens(tokens, lookup);
  vs_methods := match(
    impls.get(`Vs`),
    .Some(e) => e.methods,
    .None => ArrayList(DocFunction).new()
  );
  assert(_is_doc(_method_doc_of(vs_methods, `new`), `Make one.`), "the fallback still finds the comment");
});
// ---------------------------------------------------------------------------
// build_doc_module_from_tokens — the DEGRADED (token-only) module shape
//
// A module the evaluator cannot load is documented from tokens alone. That
// fallback used to flatten EVERY doc-commented member — impl methods, struct
// fields, enum variants, trait methods, even unexported helpers — into
// standalone `(unknown)` constants, so a degraded run counted ~1.8x the items
// of the evaluated one and read as the BETTER run
// (issues/fixed/yo-doc-without-std-path-silently-emits-token-only-docs.md). The
// token-only path must count what the evaluated path counts: exported
// top-level declarations, with members attached to their types.
// ---------------------------------------------------------------------------
token_module_ :: (fn(imm(source) : String) -> DocModule)({
  // The lex handler is bound per call: a `ctl`-typed Exception cannot live at
  // module level (it would outlive its frame).
  lex_exn := Exception(
    throw : (
      err -> {
        panic(`fixture did not lex: ${err.to_string()}`);
      }
    )
  );
  tokens := tokenize(source, `fixture.yo`, lex_exn);
  build_doc_module_from_tokens(
    String.from("fixture"),
    String.from("fixture"),
    extract_doc_comments(tokens),
    tokens
  )
});
/// The canonical shape: a documented struct (+field docs, +impl method), an
/// enum (+variant docs), a trait (+method doc), a constant, an unexported
/// helper, and an export list naming everything but the helper.
_token_fixture_source := String.from(
  "//! Fixture module.\n/// A documented point.\nPoint :: struct(\n  /// Horizontal coordinate.\n  x : i32,\n  /// Vertical coordinate.\n  y : i32\n);\nimpl(\n  Point,\n  /// Taxicab length.\n  taxicab : (fn(self : Self) -> i32)((self.x + self.y))\n);\n/// The kind of a shape.\nShapeKind :: enum(\n  /// A circle.\n  Circle,\n  /// A box.\n  Boxed(label : String)\n);\n/// Renderable things.\nRenderable :: trait(\n  /// Render to a string.\n  render : (fn(self : Self) -> String)\n);\n/// A real constant.\nMAX_COORD :: i32(1000);\n/// Not exported.\n_helper :: (fn() -> i32)(i32(1));\nexport(Point, ShapeKind, Renderable, MAX_COORD);\n"
);
test("token-only docs count exported top-level declarations, not members", {
  m := token_module_(_token_fixture_source);
  // The one number run_doc sums: functions + types + traits + constants.
  // Members (x, y, taxicab, Circle, Boxed, render) and the unexported
  // `_helper` must NOT appear as standalone items.
  total := (m.functions.len() + m.types.len() + m.traits.len() + m.constants.len());
  assert(total == usize(4), `4 items (Point, ShapeKind, Renderable, MAX_COORD), got ${total.to_string()}`);
  assert(m.constants.len() == usize(1), `only MAX_COORD is a constant, got ${m.constants.len().to_string()}`);
  c := m.constants(usize(0));
  assert(c.name == `MAX_COORD`, `the constant is MAX_COORD, got '${c.name}'`);
  assert(match(c.doc, .Some(d) => (d == `A real constant.`), .None => false), "the constant keeps its doc");
});
test("token-only docs attach methods, fields and variants to their type", {
  m := token_module_(_token_fixture_source);
  assert(m.types.len() == usize(2), `Point and ShapeKind are types, got ${m.types.len().to_string()}`);
  point := m.types(usize(0));
  assert(point.name == `Point`, `first type is Point, got '${point.name}'`);
  assert(match(point.doc, .Some(d) => (d == `A documented point.`), .None => false), "the type keeps its doc");
  // The impl method rides on the type, with its doc.
  assert(point.methods.len() == usize(1), `Point carries taxicab, got ${point.methods.len().to_string()}`);
  taxicab := point.methods(usize(0));
  assert(taxicab.name == `taxicab`, `the method is taxicab, got '${taxicab.name}'`);
  assert(match(taxicab.doc, .Some(d) => (d == `Taxicab length.`), .None => false), "the method keeps its doc");
  // Struct fields ride on the type with their docs.
  fields := match(point.fields, .Some(fs) => fs, .None => ArrayList(DocField).new());
  assert(fields.len() == usize(2), `both documented fields attach, got ${fields.len().to_string()}`);
  fx := fields(usize(0));
  assert(fx.name == `x`, `first field is x, got '${fx.name}'`);
  assert(match(fx.doc, .Some(d) => (d == `Horizontal coordinate.`), .None => false), "the field keeps its doc");
  // Enum variants ride on the type with their docs.
  shape := m.types(usize(1));
  assert(shape.name == `ShapeKind`, `second type is ShapeKind, got '${shape.name}'`);
  variants := match(shape.variants, .Some(vs) => vs, .None => ArrayList(DocVariant).new());
  assert(variants.len() == usize(2), `both documented variants attach, got ${variants.len().to_string()}`);
  assert(variants(usize(0)).name == `Circle`, "first variant is Circle");
  assert(
    match(variants(usize(0)).doc, .Some(d) => (d == `A circle.`), .None => false),
    "the variant keeps its doc"
  );
  // The trait is a trait, and its method's doc survives on it.
  assert(m.traits.len() == usize(1), `Renderable is a trait, got ${m.traits.len().to_string()}`);
  tr := m.traits(usize(0));
  assert(tr.name == `Renderable`, `the trait is Renderable, got '${tr.name}'`);
  assert(tr.methods.len() == usize(1), `the trait carries render, got ${tr.methods.len().to_string()}`);
  assert(
    match(tr.methods(usize(0)).doc, .Some(d) => (d == `Render to a string.`), .None => false),
    "the trait method keeps its doc"
  );
  // The module doc survives either way.
  assert(match(m.doc, .Some(d) => (d == `Fixture module.`), .None => false), "the module doc survives");
});
test("token-only docs: a module without export() documents nothing, like the evaluator", {
  // `std/math.yo` precedent, measured: a module with no export statement
  // exports NO names, and the evaluated doc pipeline documents zero items.
  // The token-only path must not invent items the evaluated one would not
  // show.
  m := token_module_(String.from("//! No exports.\n/// Documented anyway.\nA :: struct(x : i32);\n"));
  total := (m.functions.len() + m.types.len() + m.traits.len() + m.constants.len());
  assert(total == usize(0), `no export statement means no items, got ${total.to_string()}`);
  assert(match(m.doc, .Some(d) => (d == `No exports.`), .None => false), "the module doc still survives");
});
test("token-only docs: an undocumented exported type still carries its method docs", {
  // The type has no doc comment of its own, so only its impl methods bring
  // text. Dropping the type entry would drop their docs with it — the
  // doc-loss defect the token path must never regress
  // (issues/fixed/yo-doc-renders-the-prelude-empty.md, root cause 3).
  m := token_module_(
    String.from(
      "//! Module.\nQuiet :: struct(v : i32);\nimpl(\n  Quiet,\n  /// Loud doc.\n  loud : (fn(self : Self) -> i32)(self.v)\n);\nexport(Quiet);\n"
    )
  );
  assert(m.types.len() == usize(1), `Quiet is documented as a type, got ${m.types.len().to_string()}`);
  quiet := m.types(usize(0));
  assert(quiet.name == `Quiet`, `the type is Quiet, got '${quiet.name}'`);
  assert(quiet.doc.is_none(), "Quiet itself has no doc comment");
  assert(quiet.methods.len() == usize(1), `loud rides on Quiet, got ${quiet.methods.len().to_string()}`);
  assert(
    match(quiet.methods(usize(0)).doc, .Some(d) => (d == `Loud doc.`), .None => false),
    "the method's doc survives on the synthesized type entry"
  );
});
