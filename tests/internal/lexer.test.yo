open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind, find_matching_bracket } :: import("../../src/token.yo");
{ tokenize } :: import("../../src/lexer.yo");
{ YoError } :: import("../../src/error.yo");
{ assert, panic } :: import("std/assert");
// Tokenize source, panicking on any lexer error.
lex_or_panic :: (fn(source : String, exn : Exception) -> ArrayList(Token))(
  tokenize(source, `test.yo`, exn)
);
// Filter out Whitespace tokens.
non_ws :: (fn(toks : ArrayList(Token)) -> ArrayList(Token))({
  result := ArrayList(Token).new();
  i := usize(0);
  n := toks.len();
  while(i < n, {
    match(
      toks.get(i),
      .None => (),
      .Some(tok) => {
        if(tok.kind != TokenKind.Whitespace, {
          result.push(tok);
        });
      }
    );
    i = (i + usize(1));
  });
  result
});
// ─── Identifiers ─────────────────────────────────────────────────────────────
test("Single identifier", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`hello`, exn));
  assert(toks.len() == usize(1), "expected 1 token");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token at 0"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Identifier, "expected Identifier");
      assert(tok.value == `hello`, "value must be 'hello'");
    }
  );
});
