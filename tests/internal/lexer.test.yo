test("Bare exponent stays Integer (TS parity)", {
  // TS consumes e-notation in the INTEGER branch and still pushes
  // TokenType.Integer for a dot-less literal (src/lexer.ts:614-647):
  // `1e10` is Integer("1e10"); only a decimal point makes a Float.
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`1e10`, exn));
  assert(toks.len() == usize(1), "expected 1 token");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Integer, "expected Integer (TS lexes bare exponent as Integer)");
      assert(tok.value == `1e10`, "value must be '1e10'");
    }
  );
});
