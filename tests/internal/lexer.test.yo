    .None => assert(false, "no token at 0"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Bool, "expected Bool");
      assert(tok.value == `true`, "value must be 'true'");
    }
  );
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token at 1"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Bool, "expected Bool");
      assert(tok.value == `false`, "value must be 'false'");
    }
  );
});
