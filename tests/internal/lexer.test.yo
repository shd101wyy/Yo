// ─── Row and column tracking ─────────────────────────────────────────────────
test("Token row tracking across newlines", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  sb := StringBuilder.new();
  sb.write_str("hello");
  sb.write_byte(u8(10));
  sb.write_str("world");
  src := sb.to_string();
  toks := non_ws(tokenize(src, `test.yo`, exn));
  assert(toks.len() == usize(2), "expected 2 tokens");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token 0"),
    .Some(tok) => {
      assert(tok.row == usize(0), "hello is on row 0");
      assert(tok.column == usize(0), "hello starts at col 0");
    }
  );
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token 1"),
    .Some(tok) => {
      assert(tok.row == usize(1), "world is on row 1");
      assert(tok.column == usize(0), "world starts at col 0");
    }
  );
});
test("Column offset within a line", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`abc def`, `test.yo`, exn));
  assert(toks.len() == usize(2), "expected 2 tokens");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token 0"),
    .Some(tok) => assert(tok.column == usize(0), "abc at column 0")
  );
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token 1"),
    .Some(tok) => assert(tok.column == usize(4), "def at column 4")
  );
});
// ─── find_matching_bracket ───────────────────────────────────────────────────
test("find_matching_bracket basic paren", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`(a, b)`, `test.yo`, exn));
  // indices: 0=(  1=a  2=,  3=b  4=)
  result := find_matching_bracket(toks, usize(0));
  match(
    result,
    .None => assert(false, "should find matching paren"),
    .Some(idx) => assert(idx == usize(4), "closing paren at index 4")
  );
});
test("find_matching_bracket nested parens", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`((a))`, `test.yo`, exn));
  // 0=(  1=(  2=a  3=)  4=)
  result := find_matching_bracket(toks, usize(0));
  match(
    result,
    .None => assert(false, "should find outer closing paren"),
    .Some(idx) => assert(idx == usize(4), "outer closing paren at index 4")
  );
});
test("find_matching_bracket curly", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`{x}`, `test.yo`, exn));
  result := find_matching_bracket(toks, usize(0));
  match(
    result,
    .None => assert(false, "should find closing curly"),
    .Some(idx) => assert(idx == usize(2), "closing curly at index 2")
  );
});
test("find_matching_bracket returns None for non-bracket", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`hello`, `test.yo`, exn));
  result := find_matching_bracket(toks, usize(0));
  assert(result == .None, "identifier has no matching bracket");
});
// ─── Error handling ───────────────────────────────────────────────────────────
test("Unterminated string auto-closes at EOF (TS parity)", {
  // TS has NO unterminated-string check (src/lexer.ts:347-378): the scan runs
  // to end-of-input and the token is pushed with the closing quote appended.
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // NOTE (both compilers): the scan index is only advanced when the closing
  // quote is FOUND, so after the auto-closed token the tail re-lexes as
  // ordinary tokens — assert only the first token.
  toks := non_ws(lex_or_panic(`"unterminated`, exn));
  assert(toks.len() >= usize(1), "expected at least 1 token");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.StringLit, "expected StringLit");
      assert(tok.value == `"unterminated"`, "value auto-closed with quote");
    }
  );
});
test("Unterminated block comment raises a lexer diagnostic", {
  exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, YoError),
          .Some(ye) => {
            s := ye.to_string();
            assert(s.contains(`unterminated block comment`), "wrong error message");
            assert(s.contains(`--> test.yo:`), "D3: lexer diagnostics carry the file");
          },
          .None => assert(false, "expected a YoError diagnostic")
        );
        unwind(());
      }
    )
  );
  tokenize(`/* unterminated`, `test.yo`, exn);
  assert(false, "expected a lexer error to be raised");
});
test("Unterminated template string raises a lexer diagnostic", {
  exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, YoError),
          .Some(ye) => assert(ye.to_string().contains(`unterminated template string`), "wrong error message"),
          .None => assert(false, "expected a YoError diagnostic")
        );
        unwind(());
      }
    )
  );
  sb := StringBuilder.new();
  sb.write_byte(u8(0x60));
  sb.write_str("unterminated");
  src := sb.to_string();
  tokenize(src, `test.yo`, exn);
  assert(false, "expected a lexer error to be raised");
});
// ─── Bracket token counts for parenthesized expressions ──────────────────────
test("Tokenize x : (fn() -> i32) yields correct bracket count", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected lexer error");
        unwind(());
      }
    )
  );
  toks := tokenize(`x : (fn() -> i32)`, `test.yo`, exn);
  lp := usize(0);
  rp := usize(0);
  i := usize(0);
  n := toks.len();
  while(i < n, {
    match(
      toks.get(i),
      .None => (),
      .Some(tok) => {
        cond(
          (tok.kind == TokenKind.LParen) => {
            lp = (lp + usize(1));
          },
          (tok.kind == TokenKind.RParen) => {
            rp = (rp + usize(1));
          },
          true => ()
        );
      }
    );
    i = (i + usize(1));
  });
  assert(lp == usize(2), "expected 2 LParen tokens");
  assert(rp == usize(2), "expected 2 RParen tokens");
});
// ─── Reserved verification quantifiers ───────────────────────────────────────
// Port of src/tests/reserved-quantifiers.test.ts: `forall` / `∀` are reserved
// at LEX time (plans/archive/FORALL_TO_GENERIC.md) with a diagnostic that
// names the fix; `exists` / `∃` are deliberately NOT reserved (`exists` is a
// live std API, std/fs/file.yo). The TS file's compile-level positives
// (`generic(T : Type)` binds, `exists` fns compile) are covered by the whole
// std/ + tests/ corpus; the lexer-level gate is what needs a direct test.
test("forall is reserved for verification quantifiers", {
  exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, YoError),
          .Some(ye) => assert(ye.to_string().contains(`\`forall\` is reserved for verification quantifiers. Use \`generic(T : Type)\` to declare type parameters.`), "wrong error message"),
          .None => assert(false, "expected a YoError diagnostic")
        );
        unwind(());
      }
    )
  );
  tokenize(`sum :: (fn(forall(T : Type), a : T) -> T)(a);`, `test.yo`, exn);
  assert(false, "expected a lexer error to be raised");
});
test("∀ is reserved for verification quantifiers", {
  exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, YoError),
          .Some(ye) => assert(ye.to_string().contains(`\`∀\` is reserved for verification quantifiers. Use \`generic(T : Type)\` to declare type parameters.`), "wrong error message"),
          .None => assert(false, "expected a YoError diagnostic")
        );
        unwind(());
      }
    )
  );
  tokenize(`x :: ∀;`, `test.yo`, exn);
  assert(false, "expected a lexer error to be raised");
});
test("exists is NOT reserved — tokenizes as a plain identifier", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected lexer error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`exists`, exn));
  assert(toks.len() == usize(1), "expected 1 token");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token at 0"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Identifier, "expected Identifier");
      assert(tok.value == `exists`, "value must be 'exists'");
    }
  );
});
test("generic tokenizes as a plain identifier (the binder survives)", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected lexer error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`generic`, exn));
  assert(toks.len() == usize(1), "expected 1 token");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token at 0"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Identifier, "expected Identifier");
      assert(tok.value == `generic`, "value must be 'generic'");
    }
  );
});
// ─── Closed operator set (plans/OPERATOR_SET_AND_PRECEDENCE.md) ─────────────
test("closed operator set: ** splits into two * tokens", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`a ** b`, exn));
  assert(toks.len() == usize(4), "expected 4 tokens: a * * b");
  (first_star_col : usize) = usize(0);
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token at 1"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Operator, "expected Operator");
      assert(tok.value == `*`, "first * of the split");
      first_star_col = tok.column;
    }
  );
  match(
    toks.get(usize(2)),
    .None => assert(false, "no token at 2"),
    .Some(tok) => {
      assert(tok.value == `*`, "second * of the split");
      assert(tok.column == (first_star_col + usize(1)), "split pieces keep their own columns");
    }
  );
});
test("closed operator set: greedy longest match splits <<= into << and =", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`a <<= b`, exn));
  assert(toks.len() == usize(4), "expected 4 tokens: a << = b");
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token at 1"),
    .Some(tok) => assert(tok.value == `<<`, "greedy 2-char match first")
  );
  match(
    toks.get(usize(2)),
    .None => assert(false, "no token at 2"),
    .Some(tok) => assert(tok.value == `=`, "then the 1-char remainder")
  );
});
test("closed operator set: ?* splits into ? and * (Option of pointer)", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`?*`, exn));
  assert(toks.len() == usize(2), "?* splits into ? *");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token at 0"),
    .Some(tok) => assert(tok.value == `?`, "? is the Option alias")
  );
  toks2 := non_ws(lex_or_panic(`??`, exn));
  assert(toks2.len() == usize(2), "?? splits into ? ?");
});
test("closed operator set: retired &+ splits into & and +", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`p &+ n`, exn));
  assert(toks.len() == usize(4), "expected 4 tokens: p & + n");
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token at 1"),
    .Some(tok) => assert(tok.value == `&`, "retired &+ is no single token")
  );
});
test("closed operator set: unknown operator run is a lex error", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  _toks := tokenize(`a @@ b`, `test.yo`, exn);
  assert(false, "expected a LexerError for '@@'");
});
// ─── Token.byte_offset (D4 PR 3) ─────────────────────────────────────────────
test("Token.byte_offset is a BYTE offset while character stays a rune index", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // `名` and `前` are 3 bytes each, so every token after the string literal
  // has byte_offset > character. `Token.character` is the lexer's
  // `input.chars()` counter; `Token.byte_offset` is what may index `input`
  // (issues/fixed/yo-self-formatter-corrupts-files-with-non-ascii.md).
  src := `a := "名前"; b := 1;`;
  toks := non_ws(lex_or_panic(src, exn));
  // a  :=  "名前"  ;  b  :=  1  ;  → 8 tokens
  assert(toks.len() == usize(8), "expected 8 non-whitespace tokens");
  match(
    toks.get(usize(2)),
    .None => assert(false, "no token at 2"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.StringLit, "token 2 is the string literal");
      assert(tok.character == usize(5), "rune index of the opening quote");
      assert(tok.byte_offset == usize(5), "byte offset agrees before any multibyte");
    }
  );
  match(
    toks.get(usize(3)),
    .None => assert(false, "no token at 3"),
    .Some(tok) => {
      assert(tok.value == `;`, "token 3 is the semicolon");
      // "a := \"名前\"" is 5 + 1 + 6 + 1 = 13 bytes but 5 + 1 + 2 + 1 = 9 runes.
      assert(tok.character == usize(9), "rune index after the literal");
      assert(tok.byte_offset == usize(13), "byte offset after the literal");
    }
  );
  // Every token's byte_offset must index `input` back to its own first byte.
  (i : usize) = usize(0);
  while(i < toks.len(), {
    match(
      toks.get(i),
      .None => (),
      .Some(tok) => {
        assert(tok.input.is_char_boundary(tok.byte_offset), "byte_offset is a rune boundary");
        assert(
          tok.input.starts_with(tok.value.substring(usize(0), usize(1)), tok.byte_offset),
          "byte_offset points at the token's own first byte"
        );
      }
    );
    i = (i + usize(1));
  });
});
test("Token.byte_offset tracks a multibyte operator run correctly", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // The operator-run splitter advances `column`, `character` and
  // `byte_offset` by the same `k`, which is only sound because every
  // operator char is one ASCII byte.
  src := `名 <= 名`;
  toks := non_ws(lex_or_panic(src, exn));
  assert(toks.len() == usize(3), "名 <= 名");
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token at 1"),
    .Some(tok) => {
      assert(tok.value == `<=`, "the operator token");
      assert(tok.character == usize(2), "rune index 2");
      assert(tok.byte_offset == usize(4), "byte offset 4 (名 is 3 bytes + space)");
    }
  );
});
// ─── Leading UTF-8 BOM ───────────────────────────────────────────────────────
test("Leading UTF-8 BOM is skipped, not lexed into the first token", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // Windows PowerShell 5.1 (`Set-Content -Encoding UTF8`) and several Windows
  // editors write EF BB BF before an otherwise-ASCII file; decoded, that is
  // U+FEFF, which used to be absorbed into the first identifier ("Variable
  // '<BOM>open' not found" — issues/fixed/lexer-rejects-leading-utf8-bom.md).
  sb := StringBuilder.new();
  sb.write_rune(rune(u32(0xFEFF)));
  sb.write_str("open(1)");
  src := sb.to_string();
  toks := non_ws(lex_or_panic(src, exn));
  assert(toks.len() == usize(4), "open ( 1 ) — 4 non-whitespace tokens");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token at 0"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Identifier, "expected Identifier");
      assert(tok.value == `open`, "value must be 'open' with no BOM rune");
      assert(tok.row == usize(0), "row must not count the BOM");
      assert(tok.column == usize(0), "column must not count the BOM");
      assert(tok.character == usize(0), "rune index must not count the BOM");
      assert(
        tok.byte_offset == usize(3),
        "byte_offset still points past the 3 BOM bytes in input"
      );
    }
  );
});
test("BOM-only input tokenizes to an empty stream", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  sb := StringBuilder.new();
  sb.write_rune(rune(u32(0xFEFF)));
  toks := non_ws(lex_or_panic(sb.to_string(), exn));
  assert(toks.len() == usize(0), "expected 0 tokens");
});
