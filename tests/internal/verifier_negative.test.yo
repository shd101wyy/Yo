//! V3 negative-path verification tests (plans/backlog/FORMAL_VERIFICATION.md
//! task 8): the per-function verification pass driven IN-PROCESS over the
//! repo's negative fixtures — the same pieces `yo verify` wires together
//! (mode override + target paths + module evaluation + registry drain),
//! so the PR's code is what runs (the seed compiles it, mirroring
//! verifier.test.yo's model).
//!
//! Two gates:
//!  - SUBSET errors need no solver (the walk rejects the body before any
//!    obligation runs) — those tests always run.
//!  - REFUTATION tests need real Z3: gated on YO_TEST_Z3=1, exactly like
//!    tests/internal/verifier.test.yo (CI's verify job sets it; the
//!    z3-less differential shards skip them).
//!
//! The positive twins of every fixture here live in
//! tests/spec/verify_straight_line.test.yo (the CI verify job runs that
//! file through `yo verify`; under `yo test` its contracts lower to
//! runtime asserts and check the same properties dynamically).
{ String, StringBuilder } :: import("std/string");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
{ env } :: import("std/env");
{
  mm_load_file,
  mm_preload_prelude,
  mm_resolve_entry_abs,
  resolve_std_path,
  _take_load_error
} :: import("../../src/module_manager.yo");
{ clear_module_cache } :: import("../../src/evaluator/module_loader.yo");
{
  set_verify_mode_override,
  set_verify_target_paths,
  take_verify_tasks
} :: import("../../src/evaluator/builtins/contracts.yo");
{
  default_verify_run_config,
  resolve_solver_sync,
  verify_registered_functions,
  VerifyFnReport
} :: import("../../src/verifier/driver.yo");

/// Whether the real-solver tests are enabled (CI verify job).
_have_z3 :: (fn() -> bool)(
  match(
    env.get(String.from("YO_TEST_Z3")),
    .Some(v) => (v == String.from("1")),
    .None => false
  )
);
/// Run the verify pass over one fixture IN-PROCESS. Returns the reports
/// (empty when the solver is unavailable — callers gate on _have_z3 for
/// refutation assertions).
_verify_fixture :: (fn(rel_path : String, io : Io) -> ArrayList(VerifyFnReport))({
  exn := Exception(
    throw : (
      err -> {
        assert(false, `verifier_negative: unexpected throw: ${err}`);
      }
    )
  );
  std_path := resolve_std_path();
  // Targets must carry BOTH forms: Token.module_path is the path EXACTLY
  // as passed to mm_load_file (the relative spelling here), while an
  // imported module's tokens carry the resolved absolute path.
  targets := ArrayList(String).new();
  targets.push(rel_path.clone());
  targets.push(mm_resolve_entry_abs(rel_path.clone(), std_path.clone()));
  // Drop anything a previous test left in the registry, arm the mode and
  // the target set, evaluate, drain.
  take_verify_tasks();
  set_verify_mode_override(Option(String).Some(String.from("verify")));
  set_verify_target_paths(targets);
  clear_module_cache();
  mm_preload_prelude(std_path.clone(), true, io, exn);
  outcome := mm_load_file(rel_path.clone(), std_path.clone(), true, io, exn);
  match(
    _take_load_error(),
    .Some(rendered) => {
      assert(outcome.ok, `fixture ${rel_path} must evaluate cleanly:\n${rendered}`);
    },
    .None => {
      assert(outcome.ok, `fixture ${rel_path} must evaluate cleanly`);
    }
  );
  cfg := default_verify_run_config();
  binary := match(
    resolve_solver_sync(cfg),
    .Resolved(p) => p,
    _ => String.new()
  );
  // NOTE for maintainers: evaluating a module in-process populates the
  // process-lifetime evaluator registries (the cached prelude env, impl
  // and side-table registries) — the tracked self-hosted leak-debt class.
  // This test therefore runs under YO_TEST_LEAK_VERDICT=0 (the same
  // staging ratchet as the differential shards; ASan crash detection
  // stays armed).
  verify_registered_functions(cfg, binary)
});
/// The number of reports whose outcome equals `want`.
_count_outcome :: (fn(reports : ArrayList(VerifyFnReport), want : String) -> usize)({
  (n : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => if(rp.outcome == want, {
        n = (n + usize(1));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  n
});
/// The first report whose outcome equals `want` (asserts existence).
_first_outcome :: (fn(reports : ArrayList(VerifyFnReport), want : String, what : String) -> VerifyFnReport)({
  (found : Option(VerifyFnReport)) = Option(VerifyFnReport).None;
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => if((rp.outcome == want) && found.is_none(), {
        found = Option(VerifyFnReport).Some(rp);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  match(
    found,
    .Some(rp) => rp,
    .None => {
      ids := ArrayList(String).new();
      (j : usize) = usize(0);
      while(j < reports.len(), {
        match(
          reports.get(j),
          .Some(dr) => {
            ids.push(`${dr.fn_id}=${dr.outcome} [${dr.subset_construct}: ${dr.subset_source}]`);
          },
          .None => ()
        );
        j = (j + usize(1));
      });
      assert(false, `expected a '${want}' report (${what}), got: [${_join(ids, String.from(", "))}]`);
      reports.get(usize(0)).unwrap()
    }
  )
});
/// Whether any obligation of `rp` has name starting with `prefix` and a
/// Refuted verdict whose joined counter-example mentions `needle`.
_refuted_with :: (fn(rp : VerifyFnReport, name_prefix : String, needle : String) -> bool)({
  (hit : bool) = false;
  (i : usize) = usize(0);
  while(i < rp.obligations.len(), {
    match(
      rp.obligations.get(i),
      .Some(obl) => {
        name_ok := obl.name.contains(name_prefix.clone());
        match(
          obl.verdict,
          .Refuted(ce) => {
            ce_all := _join(ce, String.from("; "));
            if(name_ok && ce_all.contains(needle.clone()), {
              hit = true;
            });
          },
          _ => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  hit
});
_join :: (fn(ss : ArrayList(String), sep : String) -> String)({
  sb := StringBuilder.new();
  (i : usize) = usize(0);
  while(i < ss.len(), {
    match(
      ss.get(i),
      .Some(s) => {
        if(i > usize(0), {
          sb.write_string(sep.clone());
        });
        sb.write_string(s.clone());
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  sb.to_string()
});

test("subset error: while loop outside the V3 verifiable subset (no solver needed)", {
  reports := _verify_fixture(String.from("./tests/spec/fixtures/negative/subset_while.yo"), io);
  ids := ArrayList(String).new();
  (di : usize) = usize(0);
  while(di < reports.len(), {
    match(
      reports.get(di),
      .Some(dr) => {
        ids.push(`${dr.fn_id}=${dr.outcome} [${dr.subset_construct}]`);
      },
      .None => ()
    );
    di = (di + usize(1));
  });
  dump := _join(ids, String.from(", "));
  assert(reports.len() == usize(1), `expected exactly 1 report, got ${reports.len().to_string()}: [${dump}]`);
  rp := _first_outcome(reports, String.from("subset-error"), String.from("sum_to uses while"));
  assert(rp.subset_construct.contains(String.from("while")), `the subset error must name the construct, got '${rp.subset_construct}'`);
});

test("refuted: wrong ensures on abs (counter-example names x)", {
  if(!_have_z3(), {
    return(());
  });
  reports := _verify_fixture(String.from("./tests/spec/fixtures/negative/wrong_ensures.yo"), io);
  rp := _first_outcome(reports, String.from("refuted"), String.from("abs_wrong ensures(r > 0)"));
  assert(_refuted_with(rp, String.from("ensures#"), String.from("x = ")), "the counter-example must name the input x");
});

test("refuted: AoRTE divisor-nonzero on unannotated divide", {
  if(!_have_z3(), {
    return(());
  });
  reports := _verify_fixture(String.from("./tests/spec/fixtures/negative/bugged_div.yo"), io);
  rp := _first_outcome(reports, String.from("refuted"), String.from("divide_bugged y=0"));
  assert(_refuted_with(rp, String.from("divisor-nonzero"), String.from("y = ")), "the divisor obligation must refute naming y");
});

test("refuted: caller does not discharge callee requires (modular: callee still ok)", {
  if(!_have_z3(), {
    return(());
  });
  reports := _verify_fixture(String.from("./tests/spec/fixtures/negative/caller_violates_requires.yo"), io);
  assert(_count_outcome(reports, String.from("ok")) == usize(1), "safe_div itself must verify");
  rp := _first_outcome(reports, String.from("refuted"), String.from("recip_bugged requires discharge"));
  assert(_refuted_with(rp, String.from("requires#"), String.from("d = ")), "the counter-example must name the caller's d");
});

test("positive battery: every function in verify_straight_line proves", {
  if(!_have_z3(), {
    return(());
  });
  reports := _verify_fixture(String.from("./tests/spec/verify_straight_line.test.yo"), io);
  ids := ArrayList(String).new();
  (bi : usize) = usize(0);
  while(bi < reports.len(), {
    match(
      reports.get(bi),
      .Some(br) => {
        ids.push(`${br.fn_id}=${br.outcome}`);
        (oj : usize) = usize(0);
        while(oj < br.obligations.len(), {
          match(
            br.obligations.get(oj),
            .Some(obl) => {
              match(
                obl.verdict,
                .Refuted(ce) => {
                  ids.push(`  ${obl.name}: ${_join(ce, String.from(", "))}`);
                },
                _ => ()
              );
            },
            .None => ()
          );
          oj = (oj + usize(1));
        });
      },
      .None => ()
    );
    bi = (bi + usize(1));
  });
  assert(_count_outcome(reports, String.from("ok")) == reports.len(), `all battery functions must prove, got: [${_join(ids, String.from(", "))}]`);
  assert(reports.len() >= usize(7), `expected at least 7 verified functions, got ${reports.len().to_string()}`);
});

// 5b Phase 0 (plans/backlog/SAFE_MODE_5B_VERIFIED_GUARD_ELISION.md §4.2):
// obligation names are unique within a function, and an AoRTE obligation
// carries the site of its runtime guard. Before this, both divisions in
// `two_divs` were named `…/divisor-nonzero`, and both calls in `two_calls`
// `…/requires#0`. Obligation generation needs no solver.
_fn_report_named :: (fn(reports : ArrayList(VerifyFnReport), fn_suffix : String) -> Option(VerifyFnReport))({
  (i : usize) = usize(0);
  while(i < reports.len(), {
    rp := reports(i);
    if(rp.fn_id.ends_with(fn_suffix.clone()), {
      return(Option(VerifyFnReport).Some(rp));
    });
    i = (i + usize(1));
  });
  Option(VerifyFnReport).None
});
_names_unique :: (fn(rp : VerifyFnReport) -> bool)({
  (i : usize) = usize(0);
  while(i < rp.obligations.len(), {
    (j : usize) = (i + usize(1));
    while(j < rp.obligations.len(), {
      if(rp.obligations(i).name == rp.obligations(j).name, {
        return(false);
      });
      j = (j + usize(1));
    });
    i = (i + usize(1));
  });
  true
});

// The literal folder wraps like the bit-vectors it models: a zero operand
// of `-` or unary `-` used to overflow its checked u64 arithmetic and abort
// the whole run (issues/fixed/verifier-literal-fold-traps-on-wrapping-arithmetic.md).
test("the literal folder wraps: subtracting or negating a zero literal does not abort", {
  reports := _verify_fixture(String.from("./tests/spec/fixtures/valid/fold_wrapping_literals.yo"), io);
  assert(reports.len() == usize(2), `both functions are reported (got ${reports.len().to_string()})`);
  assert(_count_outcome(reports, String.from("ok")) == usize(2), "both fold to a proof");
});

test("obligation names are unique and guard obligations carry their site", {
  reports := _verify_fixture(String.from("./tests/spec/fixtures/valid/obligation_sites.yo"), io);
  match(
    _fn_report_named(reports, String.from(":10")),
    .Some(rp) => {
      assert(_names_unique(rp), "two_divs: two divisions give two distinct obligation names");
      (rows : ArrayList(usize)) = ArrayList(usize).new();
      (i : usize) = usize(0);
      while(i < rp.obligations.len(), {
        obl := rp.obligations(i);
        if(obl.name.contains("divisor-nonzero"), {
          match(
            obl.site,
            .Some(gs) => {
              assert(gs.class == "divisor-nonzero", "the site names its guard class");
              assert(gs.module.ends_with("obligation_sites.yo"), `the site names its module (got ${gs.module})`);
              rows.push(gs.row);
            },
            .None => {
              assert(false, "a divisor-nonzero obligation carries its guard site");
            }
          );
        });
        i = (i + usize(1));
      });
      assert(rows.len() == usize(2), `two_divs has two divisor obligations (got ${rows.len().to_string()})`);
      assert(rows(usize(0)) != rows(usize(1)), "each division's site is its own line");
    },
    .None => {
      assert(false, "two_divs (fn_id row 10, 0-based) must be reported");
    }
  );
  match(
    _fn_report_named(reports, String.from(":16")),
    .Some(rp2) => {
      assert(_names_unique(rp2), "two_calls: two calls of safe_div give two distinct requires#0 names");
      (ri : usize) = usize(0);
      (n_req : usize) = usize(0);
      while(ri < rp2.obligations.len(), {
        o2 := rp2.obligations(ri);
        if(o2.name.contains("requires#0"), {
          n_req = (n_req + usize(1));
          assert(o2.site.is_none(), "a contract obligation has no guard site");
        });
        ri = (ri + usize(1));
      });
      assert(n_req == usize(2), `two_calls discharges safe_div's requires#0 twice (got ${n_req.to_string()})`);
    },
    .None => {
      assert(false, "two_calls (fn_id row 16, 0-based) must be reported");
    }
  );
});

test("call actuals are the caller's values even when they share the callee's parameter names", {
  if(!_have_z3(), {
    return(());
  });
  ok_reports := _verify_fixture(String.from("./tests/spec/fixtures/valid/call_arg_swap.yo"), io);
  assert(_count_outcome(ok_reports, String.from("ok")) == usize(2), "one_more and swapped (one_more(b, a)) must verify");
  bad_reports := _verify_fixture(String.from("./tests/spec/fixtures/negative/call_arg_swap_false.yo"), io);
  assert(_count_outcome(bad_reports, String.from("refuted")) == usize(1), "differ's same(b, a) must refute");
});

test("an uncontracted pure fn is transparent to specs; one that prints is refused by name", {
  if(!_have_z3(), {
    return(());
  });
  ok_reports := _verify_fixture(String.from("./tests/spec/fixtures/valid/transparent_pure_fn.yo"), io);
  assert(_count_outcome(ok_reports, String.from("ok")) == usize(4), "sq, clamp, square_small and clamped must verify");
  bad_reports := _verify_fixture(String.from("./tests/spec/fixtures/negative/transparent_pure_fn_false.yo"), io);
  assert(_count_outcome(bad_reports, String.from("refuted")) == usize(1), "square_off must refute");
  rp := _first_outcome(bad_reports, String.from("subset-error"), String.from("uses_noisy"));
  assert(rp.subset_construct.contains("not spec-transparent: its body is outside the verifier subset"), `uses_noisy must name why noisy is opaque, got: ${rp.subset_construct}`);
});

test("a recursive transparent callee needs decreases: is_even unfolds, spin is refused by name", {
  if(!_have_z3(), {
    return(());
  });
  ok_reports := _verify_fixture(String.from("./tests/spec/fixtures/valid/transparent_recursive.yo"), io);
  assert(_count_outcome(ok_reports, String.from("ok")) == usize(2), "is_even and six_is_even must verify");
  bad_reports := _verify_fixture(String.from("./tests/spec/fixtures/negative/transparent_recursive_false.yo"), io);
  assert(_count_outcome(bad_reports, String.from("ok")) == usize(1), "only is_even may verify (liar used to, through spin's inconsistent axiom)");
  rp := _first_outcome(bad_reports, String.from("subset-error"), String.from("liar"));
  assert(rp.subset_construct.contains("calls itself without decreases"), `liar must name spin's missing decreases, got: ${rp.subset_construct}`);
});
