open(import("std/string"));
open(import("std/fmt"));
{ parse_doc_comment, is_known_section } :: import("../../src/doc/sections.yo");
{ assert, panic } :: import("std/assert");
// ─── parseDocComment ─────────────────────────────────────────────────────────
test("extracts summary from first paragraph", {
  result := parse_doc_comment(`Creates a connection pool.\n\nMore details here.`);
  assert(result.summary == `Creates a connection pool.`, "summary");
  assert(result.description == `Creates a connection pool.\n\nMore details here.`, "description");
});
test("handles single-line description as summary", {
  result := parse_doc_comment(`A simple function.`);
  assert(result.summary == `A simple function.`, "summary");
  assert(result.description == `A simple function.`, "description");
  assert(result.sections.size == usize(0), "no sections");
});
test("handles empty input", {
  result := parse_doc_comment(``);
  assert(result.summary == ``, "summary empty");
  assert(result.description == ``, "description empty");
  assert(result.sections.size == usize(0), "no sections");
});
test("handles whitespace-only input", {
  result := parse_doc_comment(`   \n  \n  `);
  assert(result.summary == ``, "summary");
  assert(result.description == ``, "description");
});
test("parses ## Returns section", {
  result := parse_doc_comment(`Creates a pool.\n\n## Returns\n\nA pool instance.`);
  assert(result.summary == `Creates a pool.`, "summary");
  returns_val := match(result.sections.get(`returns`), .Some(v) => v, .None => ``);
  assert(returns_val == `A pool instance.`, "returns section");
});
test("parses ## Errors section", {
  result := parse_doc_comment(`Opens a file.\n\n## Errors\n\nReturns \`Err\` if the file does not exist.`);
  errors_val := match(result.sections.get(`errors`), .Some(v) => v, .None => ``);
  assert(errors_val == `Returns \`Err\` if the file does not exist.`, "errors section");
});
test("parses ## Panics section", {
  result := parse_doc_comment(`Divides two numbers.\n\n## Panics\n\nPanics if divisor is zero.`);
  panics_val := match(result.sections.get(`panics`), .Some(v) => v, .None => ``);
  assert(panics_val == `Panics if divisor is zero.`, "panics section");
});
test("parses ## Examples section", {
  result := parse_doc_comment(`Adds two numbers.\n\n## Examples\n\n\`\`\`rust\nresult := add(1, 2);\nassert((result == 3), \"ok\");\n\`\`\``);
  examples_val := match(result.sections.get(`examples`), .Some(v) => v, .None => ``);
  assert(examples_val == `\`\`\`rust\nresult := add(1, 2);\nassert((result == 3), \"ok\");\n\`\`\``, "examples section");
});
test("parses ## Safety section", {
  result := parse_doc_comment(`Dereferences a raw pointer.\n\n## Safety\n\nPointer must be valid and aligned.`);
  safety_val := match(result.sections.get(`safety`), .Some(v) => v, .None => ``);
  assert(safety_val == `Pointer must be valid and aligned.`, "safety section");
});
test("parses ## Deprecated section", {
  result := parse_doc_comment(`Old function.\n\n## Deprecated\n\nUse \`new_function\` instead.`);
  deprecated_val := match(result.sections.get(`deprecated`), .Some(v) => v, .None => ``);
  assert(deprecated_val == `Use \`new_function\` instead.`, "deprecated section");
});
test("parses multiple sections", {
  text := `Creates a connection pool.\n\nDetailed description about pooling.\n\n## Returns\n\nA \`Pool\` instance.\n\n## Errors\n\nReturns \`Err\` if config is invalid.\n\n## Examples\n\n\`\`\`rust\npool := createPool(10, 5000);\n\`\`\``;
  result := parse_doc_comment(text);
  assert(result.summary == `Creates a connection pool.`, "summary");
  assert(result.description == `Creates a connection pool.\n\nDetailed description about pooling.`, "description");
  assert(result.sections.size == usize(3), "three sections");
  returns_val := match(result.sections.get(`returns`), .Some(v) => v, .None => ``);
  assert(returns_val == `A \`Pool\` instance.`, "returns");
  errors_val := match(result.sections.get(`errors`), .Some(v) => v, .None => ``);
  assert(errors_val == `Returns \`Err\` if config is invalid.`, "errors");
  examples_val := match(result.sections.get(`examples`), .Some(v) => v, .None => ``);
  assert(examples_val == `\`\`\`rust\npool := createPool(10, 5000);\n\`\`\``, "examples");
});
test("lowercases section names", {
  result := parse_doc_comment(`Fn.\n\n## RETURNS\n\nA value.`);
  has_returns := match(result.sections.get(`returns`), .Some(_) => true, .None => false);
  assert(has_returns, "has returns key");
  returns_val := match(result.sections.get(`returns`), .Some(v) => v, .None => ``);
  assert(returns_val == `A value.`, "returns value");
});
test("preserves unknown section headings", {
  result := parse_doc_comment(`Fn.\n\n## Notes\n\nSome implementation notes.\n\n## See Also\n\n\`other_fn\``);
  notes_val := match(result.sections.get(`notes`), .Some(v) => v, .None => ``);
  assert(notes_val == `Some implementation notes.`, "notes section");
  see_also_val := match(result.sections.get(`see also`), .Some(v) => v, .None => ``);
  assert(see_also_val == `\`other_fn\``, "see also section");
});
test("trims blank lines around section content", {
  result := parse_doc_comment(`Summary.\n\n## Returns\n\n\nA value.\n\n`);
  returns_val := match(result.sections.get(`returns`), .Some(v) => v, .None => ``);
  assert(returns_val == `A value.`, "returns trimmed");
});
test("handles section with multi-line content", {
  result := parse_doc_comment(`Summary.\n\n## Errors\n\n- \`NotFound\` if missing.\n- \`PermissionDenied\` if access denied.`);
  errors_val := match(result.sections.get(`errors`), .Some(v) => v, .None => ``);
  assert(errors_val == `- \`NotFound\` if missing.\n- \`PermissionDenied\` if access denied.`, "multi-line errors");
});
test("handles description with no sections", {
  text := `This is a simple function.\n\nIt does one thing well.`;
  result := parse_doc_comment(text);
  assert(result.summary == `This is a simple function.`, "summary");
  assert(result.description == text, "full description");
  assert(result.sections.size == usize(0), "no sections");
});
test("handles no description, only sections", {
  result := parse_doc_comment(`## Returns\n\nA value.`);
  assert(result.summary == ``, "summary empty");
  assert(result.description == ``, "description empty");
  returns_val := match(result.sections.get(`returns`), .Some(v) => v, .None => ``);
  assert(returns_val == `A value.`, "returns section");
});
test("does not confuse # heading with ## section", {
  result := parse_doc_comment(`# Main heading\n\nSome text.\n\n## Returns\n\nA value.`);
  assert(result.description == `# Main heading\n\nSome text.`, "description includes # heading");
  returns_val := match(result.sections.get(`returns`), .Some(v) => v, .None => ``);
  assert(returns_val == `A value.`, "returns section");
});
test("handles summary with multi-line first paragraph", {
  result := parse_doc_comment(`First line of summary.\nStill part of summary.\n\nSecond paragraph.`);
  assert(result.summary == `First line of summary.\nStill part of summary.`, "multi-line summary");
});
test("handles real-world doc comment", {
  text := `Creates a new connection pool with the given configuration.\n\nThe pool lazily initializes connections up to \`max_size\`. Idle connections\nare reaped after \`timeout\` milliseconds of inactivity.\n\n## Returns\n\nA \`Result(Pool, PoolError)\` — \`Ok\` with the pool on success,\nor \`Err\` with a \`PoolError\` if the configuration is invalid.\n\n## Panics\n\nPanics if the global allocator is exhausted.\n\n## Examples\n\n\`\`\`rust\n(pool : Result(Pool, PoolError)) = createPool(u32(10), u32(5000));\n\`\`\``;
  result := parse_doc_comment(text);
  assert(result.summary == `Creates a new connection pool with the given configuration.`, "summary");
  assert(result.sections.size == usize(3), "three sections");
  returns_val := match(result.sections.get(`returns`), .Some(v) => v, .None => ``);
  assert(returns_val.contains(`Result(Pool, PoolError)`), "returns contains Pool");
  panics_val := match(result.sections.get(`panics`), .Some(v) => v, .None => ``);
  assert(panics_val.contains(`global allocator`), "panics contains global allocator");
  examples_val := match(result.sections.get(`examples`), .Some(v) => v, .None => ``);
  assert(examples_val.contains(`createPool`), "examples contains createPool");
});
// ─── isKnownSection ──────────────────────────────────────────────────────────
test("recognizes known sections", {
  assert(is_known_section(`returns`), "returns is known");
  assert(is_known_section(`errors`), "errors is known");
  assert(is_known_section(`panics`), "panics is known");
  assert(is_known_section(`stability`), "stability is known (module freeze marker)");
  assert(is_known_section(`examples`), "examples is known");
  assert(is_known_section(`safety`), "safety is known");
  assert(is_known_section(`deprecated`), "deprecated is known");
});
test("is_known_section is case-insensitive", {
  assert(is_known_section(`Returns`), "Returns is known");
  assert(is_known_section(`ERRORS`), "ERRORS is known");
  assert(is_known_section(`Panics`), "Panics is known");
});
test("rejects unknown sections", {
  assert(!(is_known_section(`notes`)), "notes is not known");
  assert(!(is_known_section(`see also`)), "see also is not known");
  assert(!(is_known_section(`todo`)), "todo is not known");
});
test("parses a module-level ## Stability section", {
  parsed := parse_doc_comment(`CSV reader and writer.\n\n## Stability\nunstable — new in v0.2.20; the API may still change.`);
  assert(parsed.summary == `CSV reader and writer.`, "summary unaffected");
  st := match(parsed.sections.get(`stability`), .Some(v) => v, .None => ``);
  assert(st.starts_with(`unstable`), `stability section content: ${st}`);
});
test("parses single-# well-known sections (# Examples, # Returns) like ## ones", {
  result := parse_doc_comment(`Adds two numbers.\n\n# Examples\n\n\`\`\`rust\nadd(1, 2)\n\`\`\`\n\n# Returns\n\nThe sum.`);
  assert(result.sections.contains_key(`examples`), "# Examples is a section");
  assert(result.sections.contains_key(`returns`), "# Returns is a section");
  assert(result.sections.get(`returns`).unwrap() == `The sum.`, "returns content");
  assert(result.description == `Adds two numbers.`, "description excludes the sections");
});
test("an arbitrary single-# heading stays description content", {
  result := parse_doc_comment(`Intro.\n\n# Notes\n\nSome notes.`);
  assert(result.sections.len() == usize(0), "# Notes is not a well-known section");
  assert(result.description.contains(`# Notes`), "kept in the description");
  assert(result.description.contains(`Some notes.`), "with its text");
});
test("a # line inside a fenced code block is not a heading", {
  result := parse_doc_comment(`Run it.\n\n## Examples\n\n\`\`\`sh\n# Examples of flags\nyo build\n\`\`\`\n\nDone.`);
  assert(result.sections.len() == usize(1), "only the real ## Examples section");
  assert(result.sections.get(`examples`).unwrap().contains(`# Examples of flags`), "the shell comment stays inside the section");
});
