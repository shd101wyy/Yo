//! Tests for src/evaluator/effects/effect_analysis_types.yo
//! Mirrors src/evaluator/effects/effect-analysis-types.ts
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("../../src/types/definitions.yo");
{ t_unit } :: import("../../src/types/creators.yo");
{ EvalValue } :: import("../../src/value.yo");
{
  SuspensionPoint,
  SuspensionCapturedVariable
} :: import("../../src/evaluator/shared/suspension_analysis_types.yo");
{ AstExpr } :: import("../../src/expr.yo");
{ TokenKind, Token } :: import("../../src/token.yo");
{ assert, panic } :: import("std/assert");
{
  EffectCallPoint,
  EffectCapturedVariable,
  EffectHandlerInfo,
  EffectAnalysisResult,
  effect_analysis_result_empty
} :: import("../../src/evaluator/effects/effect_analysis_types.yo");
make_token :: (fn(v : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(v),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_sp :: (fn(idx : usize) -> SuspensionPoint)(
  SuspensionPoint(
    index : idx,
    expr : AstExpr.Atom(usize(0), make_token("x")),
    target_variable_id : Option(String).None,
    is_inside_cond : Option(bool).None,
    is_body_result : Option(bool).None,
    is_inside_while : Option(bool).None,
    while_nesting_depth : Option(usize).None,
    cond_branch_source_index : Option(usize).None,
    needs_own_cond_branch_field : Option(bool).None,
    enclosing_while_expr : Option(AstExpr).None,
    cond_branch_suspension_exprs : Option(ArrayList(AstExpr)).None
  )
);
test("effect_analysis_result_empty has no effects", {
  r := effect_analysis_result_empty(String.from("raise"), t_unit());
  assert(!(r.has_effects), "has_effects false");
  assert(r.effect_call_points.len() == usize(0), "no call points");
  assert(r.captured_variables.len() == usize(0), "no captured vars");
  assert(r.effect_parameter_name == "raise", "param name");
  has_infos := match(r.effect_handler_infos, .Some(_) => true, .None => false);
  assert(!(has_infos), "no handler infos");
});
test("EffectCallPoint base fields accessible", {
  ecp := EffectCallPoint(
    base : make_sp(usize(2)),
    operation_arg_types : ArrayList(TypeValue).new(),
    operation_result_type : t_unit(),
    is_transitive_effect_call : Option(bool).None,
    is_transitive_closure_call : Option(bool).None,
    effect_index : Option(usize).None
  );
  assert(ecp.base.index == usize(2), "base index");
  has_transitive := match(ecp.is_transitive_effect_call, .Some(_) => true, .None => false);
  assert(!(has_transitive), "no transitive flag");
});
test("EffectCallPoint transitive flags can be set", {
  ecp := EffectCallPoint(
    base : make_sp(usize(0)),
    operation_arg_types : ArrayList(TypeValue).new(),
    operation_result_type : t_unit(),
    is_transitive_effect_call : Option(bool).Some(true),
    is_transitive_closure_call : Option(bool).Some(false),
    effect_index : Option(usize).Some(usize(1))
  );
  is_trans := match(ecp.is_transitive_effect_call, .Some(b) => b, .None => false);
  assert(is_trans, "is transitive");
  eff_idx := match(ecp.effect_index, .Some(i) => i, .None => usize(999));
  assert(eff_idx == usize(1), "effect_index");
});
test("EffectCallPoint operation_arg_types can be populated", {
  args := ArrayList(TypeValue).new();
  args.push(t_unit());
  ecp := EffectCallPoint(
    base : make_sp(usize(0)),
    operation_arg_types : args,
    operation_result_type : t_unit(),
    is_transitive_effect_call : Option(bool).None,
    is_transitive_closure_call : Option(bool).None,
    effect_index : Option(usize).None
  );
  assert(ecp.operation_arg_types.len() == usize(1), "one arg type");
});
test("EffectCapturedVariable base fields accessible", {
  cv := EffectCapturedVariable(
    base : SuspensionCapturedVariable(
      id : String.from("v0"),
      name : String.from("counter"),
      ty : t_unit(),
      is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
      decl_site : String.from("")
    ),
    is_owning_the_same_rc_value_as : Option(Box(EffectCapturedVariable)).None
  );
  assert(cv.base.id == "v0", "id");
  assert(cv.base.name == "counter", "name");
  has_alias := match(cv.is_owning_the_same_rc_value_as, .Some(_) => true, .None => false);
  assert(!(has_alias), "no alias");
});
test("EffectCapturedVariable self-referential field (Box(Self))", {
  inner := Box(EffectCapturedVariable)(
    EffectCapturedVariable(
      base : SuspensionCapturedVariable(
        id : String.from("v1"),
        name : String.from("inner"),
        ty : t_unit(),
        is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
        decl_site : String.from("")
      ),
      is_owning_the_same_rc_value_as : Option(Box(EffectCapturedVariable)).None
    )
  );
  outer := EffectCapturedVariable(
    base : SuspensionCapturedVariable(
      id : String.from("v2"),
      name : String.from("outer"),
      ty : t_unit(),
      is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
      decl_site : String.from("")
    ),
    is_owning_the_same_rc_value_as : Option(Box(EffectCapturedVariable)).Some(inner)
  );
  has_alias := match(outer.is_owning_the_same_rc_value_as, .Some(_) => true, .None => false);
  assert(has_alias, "outer has alias");
});
test("EffectHandlerInfo fields accessible", {
  info := EffectHandlerInfo(
    effect_parameter_name : String.from("raise"),
    effect_parameter_type : t_unit(),
    effect_field_path : Option(ArrayList(String)).None,
    handler_value : Option(EvalValue).None,
    operation_arg_types : ArrayList(TypeValue).new(),
    operation_result_type : t_unit()
  );
  assert(info.effect_parameter_name == "raise", "param name");
  has_field_path := match(info.effect_field_path, .Some(_) => true, .None => false);
  assert(!(has_field_path), "no field path");
});
test("EffectHandlerInfo with field path", {
  path := ArrayList(String).new();
  path.push(String.from("errors"));
  path.push(String.from("raise"));
  info := EffectHandlerInfo(
    effect_parameter_name : String.from("errors"),
    effect_parameter_type : t_unit(),
    effect_field_path : Option(ArrayList(String)).Some(path),
    handler_value : Option(EvalValue).None,
    operation_arg_types : ArrayList(TypeValue).new(),
    operation_result_type : t_unit()
  );
  path_got := match(info.effect_field_path, .Some(p) => p.len(), .None => usize(0));
  assert(path_got == usize(2), "field path length");
});
test("EffectAnalysisResult can hold effect_call_points", {
  r := effect_analysis_result_empty(String.from("raise"), t_unit());
  ecp := EffectCallPoint(
    base : make_sp(usize(0)),
    operation_arg_types : ArrayList(TypeValue).new(),
    operation_result_type : t_unit(),
    is_transitive_effect_call : Option(bool).None,
    is_transitive_closure_call : Option(bool).None,
    effect_index : Option(usize).None
  );
  r.effect_call_points.push(ecp);
  assert(r.effect_call_points.len() == usize(1), "one call point");
});
test("EffectAnalysisResult variable_id_remapping", {
  r := effect_analysis_result_empty(String.from("exn"), t_unit());
  r.variable_id_remapping.insert(String.from("old_v0"), String.from("new_v0"));
  got := r.variable_id_remapping.get(String.from("old_v0"));
  result := match(got, .Some(v) => v, .None => String.from(""));
  assert(result == "new_v0", "remapping lookup");
});
test("EffectAnalysisResult effect_handler_infos can be set", {
  r := effect_analysis_result_empty(String.from("raise"), t_unit());
  infos := ArrayList(EffectHandlerInfo).new();
  infos.push(
    EffectHandlerInfo(
      effect_parameter_name : String.from("raise"),
      effect_parameter_type : t_unit(),
      effect_field_path : Option(ArrayList(String)).None,
      handler_value : Option(EvalValue).None,
      operation_arg_types : ArrayList(TypeValue).new(),
      operation_result_type : t_unit()
    )
  );
  r.effect_handler_infos = Option(ArrayList(EffectHandlerInfo)).Some(infos);
  count := match(r.effect_handler_infos, .Some(is) => is.len(), .None => usize(0));
  assert(count == usize(1), "one handler info");
});
