//! Tests for src/evaluator/shared/suspension_analysis_types.yo
//! Mirrors src/evaluator/shared/suspension-analysis-types.ts
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{
  SuspensionPoint,
  SuspensionCapturedVariable,
  SuspensionAnalysisResult,
  suspension_analysis_result_empty
} :: import("../../src/evaluator/shared/suspension_analysis_types.yo");
{ TypeValue } :: import("../../src/types/definitions.yo");
{ t_unit } :: import("../../src/types/creators.yo");
{ AstExpr } :: import("../../src/expr.yo");
{ TokenKind, Token } :: import("../../src/token.yo");
{ assert, panic } :: import("std/assert");
make_token :: (fn(v : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(v),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom_expr :: (fn(v : str) -> AstExpr)(
  AstExpr.Atom(usize(0), make_token(v))
);
test("suspension_analysis_result_empty returns zero suspensions", {
  r := suspension_analysis_result_empty();
  assert(!r.has_suspensions, "has_suspensions should be false");
  assert(r.suspension_points.len() == usize(0), "no suspension points");
  assert(r.captured_variables.len() == usize(0), "no captured variables");
});
test("SuspensionPoint constructor sets all fields", {
  sp := SuspensionPoint(
    index : usize(0),
    expr : make_atom_expr("x"),
    target_variable_id : Option(String).Some(String.from("v0")),
    is_inside_cond : Option(bool).Some(false),
    is_body_result : Option(bool).Some(true),
    is_inside_while : Option(bool).Some(true),
    while_nesting_depth : Option(usize).Some(usize(1)),
    cond_branch_source_index : Option(usize).None,
    needs_own_cond_branch_field : Option(bool).Some(true),
    enclosing_while_expr : Option(AstExpr).None,
    cond_branch_suspension_exprs : Option(ArrayList(AstExpr)).None,
    cond_branch_suspension_in_while : Option(ArrayList(bool)).None
  );
  assert(sp.index == usize(0), "index");
  result := match(sp.target_variable_id, .Some(id) => id, .None => String.from(""));
  assert(result == "v0", "target_variable_id");
  result2 := match(sp.is_inside_while, .Some(b) => b, .None => false);
  assert(result2, "is_inside_while");
  // The tail-await marker (PR #123): a standalone tail await is the async
  // body's own result and must keep its await_result storage.
  result3 := match(sp.is_body_result, .Some(b) => b, .None => false);
  assert(result3, "is_body_result");
});
test("SuspensionPoint optional fields default to None", {
  sp := SuspensionPoint(
    index : usize(1),
    expr : make_atom_expr("y"),
    target_variable_id : Option(String).None,
    is_inside_cond : Option(bool).None,
    is_body_result : Option(bool).None,
    is_inside_while : Option(bool).None,
    while_nesting_depth : Option(usize).None,
    cond_branch_source_index : Option(usize).None,
    needs_own_cond_branch_field : Option(bool).None,
    enclosing_while_expr : Option(AstExpr).None,
    cond_branch_suspension_exprs : Option(ArrayList(AstExpr)).None,
    cond_branch_suspension_in_while : Option(ArrayList(bool)).None
  );
  has_target := match(sp.target_variable_id, .Some(_) => true, .None => false);
  assert(!has_target, "target_variable_id should be None");
  has_cond := match(sp.is_inside_cond, .Some(_) => true, .None => false);
  assert(!has_cond, "is_inside_cond should be None");
});
test("SuspensionCapturedVariable fields accessible", {
  cv := SuspensionCapturedVariable(
    id : String.from("v0"),
    name : String.from("counter"),
    ty : t_unit(),
    is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
    decl_site : String.from("")
  );
  assert(cv.id == "v0", "id");
  assert(cv.name == "counter", "name");
  has_alias := match(cv.is_owning_the_same_rc_value_as, .Some(_) => true, .None => false);
  assert(!has_alias, "no alias");
});
test("SuspensionCapturedVariable self-referential field (Box(Self))", {
  inner := Box(SuspensionCapturedVariable)(
    SuspensionCapturedVariable(
      id : String.from("v1"),
      name : String.from("inner"),
      ty : t_unit(),
      is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
      decl_site : String.from("")
    )
  );
  outer := SuspensionCapturedVariable(
    id : String.from("v2"),
    name : String.from("outer"),
    ty : t_unit(),
    is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).Some(inner),
    decl_site : String.from("")
  );
  has_alias := match(outer.is_owning_the_same_rc_value_as, .Some(_) => true, .None => false);
  assert(has_alias, "outer has alias");
});
test("SuspensionAnalysisResult can hold suspension points", {
  r := suspension_analysis_result_empty();
  sp := SuspensionPoint(
    index : usize(0),
    expr : make_atom_expr("await_call"),
    target_variable_id : Option(String).None,
    is_inside_cond : Option(bool).None,
    is_body_result : Option(bool).None,
    is_inside_while : Option(bool).None,
    while_nesting_depth : Option(usize).None,
    cond_branch_source_index : Option(usize).None,
    needs_own_cond_branch_field : Option(bool).None,
    enclosing_while_expr : Option(AstExpr).None,
    cond_branch_suspension_exprs : Option(ArrayList(AstExpr)).None,
    cond_branch_suspension_in_while : Option(ArrayList(bool)).None
  );
  r.suspension_points.push(sp);
  assert(r.suspension_points.len() == usize(1), "one suspension point");
});
test("SuspensionAnalysisResult variable_id_remapping", {
  r := suspension_analysis_result_empty();
  r.variable_id_remapping.insert(String.from("old_v0"), String.from("new_v0"));
  got := r.variable_id_remapping.get(String.from("old_v0"));
  result := match(got, .Some(v) => v, .None => String.from(""));
  assert(result == "new_v0", "remapping lookup");
});
