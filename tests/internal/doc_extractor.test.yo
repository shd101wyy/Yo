test("handles multiple doc comments for different declarations", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `/// First type.\nFoo :: struct();\n\n/// Second type.\nBar :: enum();\n`;
  tokens := lex_(source, exn);
  result := extract_doc_comments(tokens);
  assert(result.declarations.len() == usize(2), "two declarations");
  match(
    result.declarations.get(usize(0)),
    .None => assert(false, "no first declaration"),
    .Some(d) => {
      assert(d.declaration_name == `Foo`, "first name");
      assert(d.comment.content == `First type.`, "first content");
    }
  );
  match(
    result.declarations.get(usize(1)),
    .None => assert(false, "no second declaration"),
    .Some(d) => assert(d.declaration_name == `Bar`, "second name")
  );
});
