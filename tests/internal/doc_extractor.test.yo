open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ Token, TokenKind } :: import("../../src/token.yo");
{ tokenize } :: import("../../src/lexer.yo");
{ assert, panic } :: import("std/assert");
{
  strip_doc_line_comment,
  strip_doc_block_comment,
  extract_doc_comments,
  extract_inline_docs,
  find_matching_parens,
  InlineDocResult,
  ParensResult
} :: import("../../src/doc/extractor.yo");
// Tokenize source, panicking on any lexer error.
lex_ :: (fn(source : String, exn : Exception) -> ArrayList(Token))(
  tokenize(source, `test.yo`, exn)
);
// Extract inline docs from inside the first (...) of the token list.
inline_docs_from_source_ :: (fn(source : String, exn : Exception) -> HashMap(String, String))({
  tokens := lex_(source, exn);
  match(
    find_matching_parens(tokens, usize(0)),
    .None => HashMap(String, String).new(),
    .Some(p) => extract_inline_docs(tokens, p.open + usize(1), p.close).docs
  )
});
// ─── strip_doc_line_comment ───────────────────────────────────────────────────
test("strip_doc_line_comment strips triple-slash prefix and one space", {
  result := strip_doc_line_comment(`/// Hello world`);
  assert(result == `Hello world`, "expected 'Hello world'");
});
test("strip_doc_line_comment strips triple-slash with no space", {
  result := strip_doc_line_comment(`///Hello`);
  assert(result == `Hello`, "expected 'Hello'");
});
test("strip_doc_line_comment strips //! prefix and one space", {
  result := strip_doc_line_comment(`//! Module doc`);
  assert(result == `Module doc`, "expected 'Module doc'");
});
test("strip_doc_line_comment preserves extra indentation", {
  result := strip_doc_line_comment(`///   indented`);
  assert(result == `  indented`, "expected '  indented'");
});
test("strip_doc_line_comment handles empty doc comment", {
  result := strip_doc_line_comment(`///`);
  assert(result == ``, "expected empty string");
});
test("strip_doc_line_comment handles empty //! comment", {
  result := strip_doc_line_comment(`//!`);
  assert(result == ``, "expected empty string");
});
// ─── strip_doc_block_comment ─────────────────────────────────────────────────
test("strip_doc_block_comment strips simple block comment", {
  result := strip_doc_block_comment(`/** Hello */`);
  assert(result == `Hello`, "expected 'Hello'");
});
test("strip_doc_block_comment strips multi-line block with leading asterisks", {
  input := `/**\n * First line\n * Second line\n */`;
  result := strip_doc_block_comment(input);
  assert(result == `First line\nSecond line`, "expected two lines");
});
test("strip_doc_block_comment strips inner doc block comment", {
  result := strip_doc_block_comment(`/*! Module documentation */`);
  assert(result == `Module documentation`, "expected 'Module documentation'");
});
test("strip_doc_block_comment handles empty doc block comment", {
  result := strip_doc_block_comment(`/** */`);
  assert(result == ``, "expected empty string");
});
test("strip_doc_block_comment preserves markdown formatting", {
  input := `/**\n * # Heading\n *\n * - item 1\n * - item 2\n *\n * \`code\`\n */`;
  result := strip_doc_block_comment(input);
  assert(result == `# Heading\n\n- item 1\n- item 2\n\n\`code\``, "markdown preserved");
});
// ─── extract_doc_comments ────────────────────────────────────────────────────
test("extracts a single /// doc comment for a declaration", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  tokens := lex_(`/// A trait.\nFoo :: trait();\n`, exn);
  result := extract_doc_comments(tokens);
  has_module_doc := match(result.module_doc, .Some(_) => true, .None => false);
  assert(!(has_module_doc), "no module doc");
  assert(result.declarations.len() == usize(1), "one declaration");
  match(
    result.declarations.get(usize(0)),
    .None => assert(false, "no declaration at 0"),
    .Some(d) => {
      assert(d.comment.content == `A trait.`, "content");
      assert(d.declaration_name == `Foo`, "name");
    }
  );
});
test("merges consecutive /// lines", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `/// First line.\n/// Second line.\n/// Third line.\nMyType :: struct();\n`;
  tokens := lex_(source, exn);
  result := extract_doc_comments(tokens);
  assert(result.declarations.len() == usize(1), "one declaration");
  match(
    result.declarations.get(usize(0)),
    .None => assert(false, "no declaration"),
    .Some(d) => {
      assert(d.comment.content == `First line.\nSecond line.\nThird line.`, "merged content");
      assert(d.declaration_name == `MyType`, "name");
    }
  );
});
