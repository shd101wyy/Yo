test("extracts /// docs for enum variants", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `Color :: enum(\n  /// Red color.\n  Red,\n  /// Green color.\n  Green,\n  /// Blue color.\n  Blue\n);`;
  docs := inline_docs_from_source_(source, exn);
  assert(docs.size == usize(3), "three docs");
  red_val := match(docs.get(`Red`), .Some(v) => v, .None => ``);
  assert(red_val == `Red color.`, "red doc");
  green_val := match(docs.get(`Green`), .Some(v) => v, .None => ``);
  assert(green_val == `Green color.`, "green doc");
  blue_val := match(docs.get(`Blue`), .Some(v) => v, .None => ``);
  assert(blue_val == `Blue color.`, "blue doc");
});
test("extracts docs for enum variants with fields", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `Shape :: enum(\n  /// A circle with given radius.\n  Circle(radius : f64),\n  /// A rectangle.\n  Rectangle(width : f64, height : f64)\n);`;
  docs := inline_docs_from_source_(source, exn);
  assert(docs.size == usize(2), "two docs");
  circle_val := match(docs.get(`Circle`), .Some(v) => v, .None => ``);
  assert(circle_val == `A circle with given radius.`, "circle doc");
  rect_val := match(docs.get(`Rectangle`), .Some(v) => v, .None => ``);
  assert(rect_val == `A rectangle.`, "rectangle doc");
});
test("handles empty token range", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  tokens := lex_(`struct();`, exn);
  result := extract_inline_docs(tokens, usize(2), usize(2));
  assert(result.docs.size == usize(0), "no docs");
});
test("does not pick up regular // comments", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `S :: struct(\n  // regular comment\n  x : i32,\n  /// Doc comment.\n  y : i32\n);`;
  docs := inline_docs_from_source_(source, exn);
  assert(docs.size == usize(1), "one doc");
  has_x := match(docs.get(`x`), .Some(_) => true, .None => false);
  assert(!(has_x), "x not documented");
  y_val := match(docs.get(`y`), .Some(v) => v, .None => ``);
  assert(y_val == `Doc comment.`, "y doc");
});
test("handles mixed block and line doc comments", {
