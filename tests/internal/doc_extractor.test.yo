test("extracts doc from real std-lib-like code", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `//! Core traits for the Yo type system.\n\n/// Comptime trait - indicates a type that can be used at compile-time.\n/// Examples: i32, bool, Type\nComptime :: trait(\n  id := \"Comptime\"\n);\nexport(Comptime);\n\n/// Runtime trait - indicates a type that can be used at runtime.\n/// Examples: i32, bool, *(i32), void\nRuntime :: trait(\n  id := \"Runtime\"\n);\nexport(Runtime);\n`;
  tokens := lex_(source, exn);
  result := extract_doc_comments(tokens);
  match(
    result.module_doc,
    .None => assert(false, "expected module doc"),
    .Some(m) => assert(m.content == `Core traits for the Yo type system.`, "module doc content")
  );
  assert(result.declarations.len() == usize(2), "two declarations");
  match(
    result.declarations.get(usize(0)),
    .None => assert(false, "no first declaration"),
    .Some(d) => {
      assert(d.declaration_name == `Comptime`, "first name");
      assert(d.comment.content == `Comptime trait - indicates a type that can be used at compile-time.\nExamples: i32, bool, Type`, "first content");
    }
  );
  match(
    result.declarations.get(usize(1)),
    .None => assert(false, "no second declaration"),
    .Some(d) => assert(d.declaration_name == `Runtime`, "second name")
  );
});
// ─── find_matching_parens ────────────────────────────────────────────────────
test("find_matching_parens finds parens for struct", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  tokens := lex_(`Point :: struct(x : f64, y : f64);`, exn);
  match(
    find_matching_parens(tokens, usize(0)),
    .None => assert(false, "expected parens"),
    .Some(p) => {
      match(
        tokens.get(p.open),
        .None => assert(false, "no open tok"),
        .Some(t) => assert(t.kind == TokenKind.LParen, "open is LParen")
      );
      match(
        tokens.get(p.close),
        .None => assert(false, "no close tok"),
        .Some(t) => assert(t.kind == TokenKind.RParen, "close is RParen")
      );
    }
  );
});
test("find_matching_parens handles nested parens", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  tokens := lex_(`Shape :: enum(Circle(radius: f64), Rect(w: f64, h: f64));`, exn);
  match(
    find_matching_parens(tokens, usize(0)),
    .None => assert(false, "expected parens"),
    .Some(p) => {
      // The close should be the last ) before ;
      after_idx := (p.close + usize(1));
      // Skip whitespace to get to semicolon
      i := after_idx;
      n := tokens.len();
      while(i < n, {
        tok := match(
          tokens.get(i),
          .Some(t) => t,
          .None => {
            break;
          }
        );
        if(tok.kind != TokenKind.Whitespace, {
          assert(tok.kind == TokenKind.Semicolon, "token after outer close paren should be semicolon");
          break;
        });
        i = (i + usize(1));
      });
    }
  );
});
test("find_matching_parens returns None when no parens found", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  tokens := lex_(`x :: 42;`, exn);
  match(
    find_matching_parens(tokens, usize(0)),
    .None => (),
    // expected
    .Some(_) => assert(false, "expected None")
  );
});
test("find_matching_parens starts searching from given index", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  tokens := lex_(`a(1); b(2);`, exn);
  // Find semicolon index
  semi_idx := usize(0);
  i := usize(0);
  n := tokens.len();
  while(i < n, {
    tok := match(
      tokens.get(i),
      .Some(t) => t,
      .None => {
        break;
      }
    );
    if(tok.kind == TokenKind.Semicolon, {
      semi_idx = i;
      break;
    });
    i = (i + usize(1));
  });
  match(
    find_matching_parens(tokens, semi_idx + usize(1)),
    .None => assert(false, "expected parens for b(2)"),
    .Some(p) => {
      match(
        tokens.get(p.open),
        .None => assert(false, "no tok"),
        .Some(t) => assert(t.kind == TokenKind.LParen, "found LParen")
      );
    }
  );
});
// ─── extract_inline_docs ─────────────────────────────────────────────────────
test("extracts /// docs for struct fields", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `Point :: struct(\n  /// The x coordinate.\n  x : f64,\n  /// The y coordinate.\n  y : f64\n);`;
  docs := inline_docs_from_source_(source, exn);
  assert(docs.size == usize(2), "two docs");
  x_val := match(docs.get(`x`), .Some(v) => v, .None => ``);
  assert(x_val == `The x coordinate.`, "x doc");
  y_val := match(docs.get(`y`), .Some(v) => v, .None => ``);
  assert(y_val == `The y coordinate.`, "y doc");
});
test("handles struct with only some fields documented", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `Config :: struct(\n  /// The hostname.\n  host : str,\n  port : u16,\n  /// Enable TLS.\n  tls : bool\n);`;
  docs := inline_docs_from_source_(source, exn);
  assert(docs.size == usize(2), "two docs");
  host_val := match(docs.get(`host`), .Some(v) => v, .None => ``);
  assert(host_val == `The hostname.`, "host doc");
  tls_val := match(docs.get(`tls`), .Some(v) => v, .None => ``);
  assert(tls_val == `Enable TLS.`, "tls doc");
  has_port := match(docs.get(`port`), .Some(_) => true, .None => false);
  assert(!(has_port), "port not documented");
});
test("handles struct with no documented fields", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  docs := inline_docs_from_source_(`Empty :: struct(x : i32, y : i32);`, exn);
  assert(docs.size == usize(0), "no docs");
});
test("merges consecutive /// lines for a struct field", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `Config :: struct(\n  /// Maximum number of connections.\n  /// Must be > 0.\n  max_conns : u32\n);`;
  docs := inline_docs_from_source_(source, exn);
  assert(docs.size == usize(1), "one doc");
  val := match(docs.get(`max_conns`), .Some(v) => v, .None => ``);
  assert(val == `Maximum number of connections.\nMust be > 0.`, "merged doc");
});
