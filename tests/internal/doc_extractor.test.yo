        unwind(());
      }
    )
  );
  docs := inline_docs_from_source_(`P :: struct(/** X */ x : f64, /** Y */ y : f64);`, exn);
  assert(docs.size == usize(2), "two docs");
  x_val := match(docs.get(`x`), .Some(v) => v, .None => ``);
  assert(x_val == `X`, "x doc");
  y_val := match(docs.get(`y`), .Some(v) => v, .None => ``);
  assert(y_val == `Y`, "y doc");
});
test("preserves markdown formatting in inline docs", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `S :: struct(\n  /// The **bold** value.\n  ///\n  /// Example: \`x = 42\`\n  x : i32\n);`;
  docs := inline_docs_from_source_(source, exn);
  assert(docs.size == usize(1), "one doc");
  x_val := match(docs.get(`x`), .Some(v) => v, .None => ``);
  assert(x_val == `The **bold** value.\n\nExample: \`x = 42\``, "markdown preserved");
});
