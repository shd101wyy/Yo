test("extracts //! as module doc", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `//! This is the module doc.\n//! It has two lines.\n\nFoo :: struct();\n`;
  tokens := lex_(source, exn);
  result := extract_doc_comments(tokens);
  match(
    result.module_doc,
    .None => assert(false, "expected module doc"),
    .Some(m) => {
      assert(m.content == `This is the module doc.\nIt has two lines.`, "module doc content");
      assert(m.inner, "inner = true");
    }
  );
});
