test("extracts top-level doc for ?= field via extractDocComments", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  source := `/// Target doc.\n(target : i32) ?= 0;\n`;
  tokens := lex_(source, exn);
  result := extract_doc_comments(tokens);
  assert(result.declarations.len() == usize(1), "one declaration");
  match(
    result.declarations.get(usize(0)),
    .None => assert(false, "no declaration"),
    .Some(d) => {
      assert(d.declaration_name == `target`, "declaration name");
      assert(d.comment.content == `Target doc.`, "content");
    }
  );
});
