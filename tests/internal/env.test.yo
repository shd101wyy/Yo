//! Tests for the self-hosted Environment.
open(import("std/string"));
{ TypeValue } :: import("../../yo-self/types/definitions.yo");
{ t_i32, t_bool, t_f32 } :: import("../../yo-self/types/creators.yo");
{ Environment, get_variables_from_env, synthetic_token, add_variable_to_env } :: import("../../yo-self/env.yo");
{ EvalValue } :: import("../../yo-self/value.yo");
{ assert, panic } :: import("std/assert");
test("define and lookup in single frame", {
  env := Environment.new(`mod`);
  _d0 := env.define(`x`, t_i32(), false);
  _d1 := env.define(`flag`, t_bool(), true);
  assert(env.contains(`x`), "x bound");
  assert(env.contains(`flag`), "flag bound");
  assert(!(env.contains(`missing`)), "missing not bound");
  match(
    env.lookup(`x`),
    .Some(v) => {
      assert(v.name == `x`, "x name");
      assert(!(v.is_compile_time_only), "x runtime");
    },
    .None => assert(false, "x lookup must succeed")
  );
  match(
    env.lookup(`flag`),
    .Some(v) => assert(v.is_compile_time_only, "flag is comptime"),
    .None => assert(false, "flag lookup must succeed")
  );
});
test("push_frame / pop_frame and frame_level", {
  env := Environment.new(`mod`);
  _d2 := env.define(`outer`, t_i32(), false);
  base := env.frame_count();
  pushed_idx := env.push_frame(true);
  assert(env.frame_count() == (base + usize(1)), "frame count grew");
  assert(pushed_idx == base, "pushed index = old count");
  _d3 := env.define(`inner`, t_f32(), false);
  match(
    env.lookup(`inner`),
    .Some(v) => assert(v.frame_level == base, "inner frame_level"),
    .None => assert(false, "inner must be visible")
  );
  match(
    env.lookup(`outer`),
    .Some(v) => assert(v.frame_level == usize(0), "outer frame_level=0"),
    .None => assert(false, "outer must be visible from inner")
  );
  env.pop_frame();
  assert(env.frame_count() == base, "frame count shrank");
  assert(!(env.contains(`inner`)), "inner gone after pop");
  assert(env.contains(`outer`), "outer still here");
});
test("shadowing returns innermost binding", {
  env := Environment.new(`mod`);
  _d4 := env.define(`x`, t_i32(), false);
  _d5 := env.push_frame(true);
  _d6 := env.define(`x`, t_bool(), true);
  match(
    env.lookup(`x`),
    .Some(v) => {
      assert(v.is_compile_time_only, "innermost is comptime bool");
    },
    .None => assert(false, "x must be visible")
  );
  env.pop_frame();
  match(
    env.lookup(`x`),
    .Some(v) => assert(!(v.is_compile_time_only), "outer x is runtime i32"),
    .None => assert(false, "outer x must be visible after pop")
  );
});
test("Variable.id is unique per define", {
  env := Environment.new(`mod`);
  _d0 := env.define(`x`, t_i32(), false);
  _d1 := env.define(`y`, t_i32(), false);
  match(
    env.lookup(`x`),
    .Some(vx) => match(
      env.lookup(`y`),
      .Some(vy) => {
        assert(!(vx.id == vy.id), "x and y have different ids");
      },
      .None => assert(false, "y not found")
    ),
    .None => assert(false, "x not found")
  );
});
test("Variable.id is stable after shadowing", {
  env := Environment.new(`mod`);
  _d0 := env.define(`x`, t_i32(), false);
  id_outer := match(
    env.lookup(`x`),
    .Some(v) => v.id,
    // `Variable.id` is a `usize` counter (it stopped being a rendered String in
    // 2b6aa1db7), and `usize(0)` is already its established missing/err sentinel
    // — `make_err_variable` uses it. A `String` sentinel here made the match arms
    // disagree on type and the whole test file failed to compile.
    .None => usize(0)
  );
  _push := env.push_frame(true);
  _d1 := env.define(`x`, t_bool(), true);
  id_inner := match(
    env.lookup(`x`),
    .Some(v) => v.id,
    .None => usize(0)
  );
  assert(!(id_outer == id_inner), "shadow gets a distinct id");
  env.pop_frame();
  id_after_pop := match(
    env.lookup(`x`),
    .Some(v) => v.id,
    .None => usize(0)
  );
  assert(id_outer == id_after_pop, "outer id unchanged after pop");
});
test("Variable.is_owning_the_rc_value defaults false", {
  env := Environment.new(`mod`);
  _d := env.define(`z`, t_f32(), false);
  match(
    env.lookup(`z`),
    .Some(v) => assert(!(v.is_owning_the_rc_value), "default is not owning"),
    .None => assert(false, "z not found")
  );
});
test("Variable.is_owning_the_same_rc_value_as defaults None", {
  env := Environment.new(`mod`);
  _d := env.define(`z`, t_i32(), false);
  match(
    env.lookup(`z`),
    .Some(v) => match(
      v.is_owning_the_same_rc_value_as,
      .Some(_) => assert(false, "expected None"),
      .None => assert(true, "default is None")
    ),
    .None => assert(false, "z not found")
  );
});
test("get_variables_from_env returns all bindings (outermost first)", {
  env := Environment.new(`mod`);
  _d0 := env.define(`x`, t_i32(), false); // frame 0
  _push := env.push_frame(true);
  _d1 := env.define(`x`, t_bool(), true); // frame 1
  all_x := get_variables_from_env(env, `x`);
  assert(all_x.len() == usize(2), "two bindings of x");
  // Outermost first → index 0 is the i32 binding
  match(
    all_x.get(usize(0)),
    .Some(outer) => assert(!(outer.is_compile_time_only), "outer is runtime i32"),
    .None => assert(false, "no outer x")
  );
  match(
    all_x.get(usize(1)),
    .Some(inner) => assert(inner.is_compile_time_only, "inner is comptime bool"),
    .None => assert(false, "no inner x")
  );
});
test("get_variables_from_env returns empty list for unknown name", {
  env := Environment.new(`mod`);
  _d0 := env.define(`x`, t_i32(), false);
  missing := get_variables_from_env(env, `no_such`);
  assert(missing.len() == usize(0), "empty for unknown name");
});
test("add_variable_to_env: explicit token + flags", {
  env := Environment.new(`mod`);
  tok := synthetic_token(`x`, `mod`);
  added := add_variable_to_env(env, `x`, t_i32(), Option(EvalValue).None, false, true, false, false, tok);
  match(
    added,
    .Some(v) => {
      assert(v.name == `x`, "name set");
      assert(v.is_reassignable, "is_reassignable set");
      assert(!(v.is_implicit), "is_implicit defaults false");
      match(
        v.initialized_at_token,
        .Some(_) => assert(true, "initialized_at_token set"),
        .None => assert(false, "expected Some initialized_at_token")
      );
      match(
        v.consumed_at_token,
        .Some(_) => assert(false, "expected None consumed_at_token"),
        .None => assert(true, "consumed_at_token defaults None")
      );
    },
    .None => assert(false, "add_variable_to_env returned None")
  );
  // Variable should now be bound in env.
  assert(env.contains(`x`), "x bound after add_variable_to_env");
});
test("add_variable_to_env: implicit (given) variable", {
  env := Environment.new(`mod`);
  tok := synthetic_token(`io`, `mod`);
  added := add_variable_to_env(env, `io`, t_i32(), Option(EvalValue).None, true, false, false, true, tok);
  match(
    added,
    .Some(v) => {
      assert(v.is_implicit, "is_implicit true for given variable");
      assert(v.is_compile_time_only, "implicit + comptime");
      assert(!(v.is_reassignable), "given is not reassignable");
    },
    .None => assert(false, "expected Some")
  );
});
