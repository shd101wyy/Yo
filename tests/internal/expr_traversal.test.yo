/// Tests for the expression-traversal helpers in yo-self/expr_traversal.yo.
///
/// 1-to-1 port of `src/expr-traversal.ts`. Only the AST-only helpers are
/// covered here — the metadata-aware variant (`exprContainsAwait`) is not
/// yet ported.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, make_err_expr } :: import("../../yo-self/expr.yo");
{ evaluated_body_contains_unwind, expr_tree_contains_return } :: import("../../yo-self/expr_traversal.yo");
{ parse } :: import("../../yo-self/parser.yo");
{ assert, panic } :: import("std/assert");
// ─── Helpers ─────────────────────────────────────────────────────────────────
parse_one :: (fn(src : String) -> AstExpr)({
  exn := Exception(throw : ((err) -> __yo_panic("parse_one: unexpected parse error")));
  prog := parse(src, `test.yo`, exn);
  match(
    prog.get(usize(0)),
    .None => {
      assert(false, "empty program");
      make_err_expr()
    },
    .Some(e) => e
  )
});
// ─── expr_tree_contains_return ───────────────────────────────────────────────
test("expr_tree_contains_return: plain identifier is false", {
  e := parse_one(`foo`);
  assert(expr_tree_contains_return(e) == false, "atom 'foo' should not contain return");
});
test("expr_tree_contains_return: literal return atom matches", {
  e := parse_one(`return`);
  assert(expr_tree_contains_return(e) == true, "atom 'return' should match");
});
test("expr_tree_contains_return: literal unwind atom matches", {
  e := parse_one(`unwind`);
  assert(expr_tree_contains_return(e) == true, "atom 'unwind' should match");
});
test("expr_tree_contains_return: return(x) call matches", {
  e := parse_one(`return(x)`);
  assert(expr_tree_contains_return(e) == true, "return call should match");
});
test("expr_tree_contains_return: unwind(x) call matches", {
  e := parse_one(`unwind(x)`);
  assert(expr_tree_contains_return(e) == true, "unwind call should match");
});
test("expr_tree_contains_return: ordinary call does not match", {
  e := parse_one(`f(x)`);
  assert(expr_tree_contains_return(e) == false, "f(x) should not contain return");
});
test("expr_tree_contains_return: descends into begin block", {
  e := parse_one(
    `{
    a;
    return(b);
  }`
  );
  assert(expr_tree_contains_return(e) == true, "return inside begin should be found");
});
test("expr_tree_contains_return: ignores body inside anonymous fn arrow", {
  // An anonymous-fn arrow `(x) -> body` defines a new function boundary.
  // A `return` inside that arrow's body belongs to a *different* function
  // than the one being traversed, so it must NOT be reported.
  e := parse_one(`(x) -> return(x)`);
  assert(
    expr_tree_contains_return(e) == false,
    "return inside an anonymous fn arrow belongs to a different fn"
  );
});
test("expr_tree_contains_return: descends into cond branches", {
  e := parse_one(`cond(true => return(1), false => 2)`);
  assert(
    expr_tree_contains_return(e) == true,
    "return inside a cond branch should be found"
  );
});
test("expr_tree_contains_return: descends into match branches", {
  e := parse_one(`match(x, .Some(v) => return(v), .None => 0)`);
  assert(
    expr_tree_contains_return(e) == true,
    "return inside a match arm should be found"
  );
});
// ─── evaluated_body_contains_unwind ──────────────────────────────────────────
test("evaluated_body_contains_unwind: plain identifier is false", {
  e := parse_one(`foo`);
  assert(evaluated_body_contains_unwind(e) == false, "atom 'foo' should not contain unwind");
});
test("evaluated_body_contains_unwind: unwind atom matches", {
  e := parse_one(`unwind`);
  assert(evaluated_body_contains_unwind(e) == true, "atom 'unwind' should match");
});
test("evaluated_body_contains_unwind: return does NOT match", {
  e := parse_one(`return(x)`);
  assert(
    evaluated_body_contains_unwind(e) == false,
    "return is not unwind — only the contains-return helper catches both"
  );
});
test("evaluated_body_contains_unwind: descends into cond branch", {
  e := parse_one(`cond(true => unwind(1), false => 2)`);
  assert(
    evaluated_body_contains_unwind(e) == true,
    "unwind inside a cond branch should be found"
  );
});
