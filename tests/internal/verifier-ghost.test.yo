//! The ghost-semantics tests — V5 task 3 (FORMAL_VERIFICATION.md):
//! ghost_fn calls INLINE in the VC walk (a spec function's meaning is its
//! body — `requires(within(x, 0))` assumes the inlined predicate), and
//! `ghost(name := e)` binds a spec-only name (the walk tracks it for
//! assert predicates; ordinary reads are the escape error).
//!
//! In-process model (verifier_quantifiers's shape); proofs and refutations
//! need the real solver (YO_TEST_Z3=1), the escape gate runs solver-free.
{ String, StringBuilder } :: import("std/string");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array-list");
{ assert } :: import("std/assert");
{ env } :: import("std/env");
{
  mm_load_file,
  mm_preload_prelude,
  mm_resolve_entry_abs,
  resolve_std_path,
  _take_load_error
} :: import("../../src/module-manager.yo");
{ clear_module_cache } :: import("../../src/evaluator/module-loader.yo");
{
  set_verify_mode_override,
  set_verify_target_paths,
  take_verify_tasks
} :: import("../../src/evaluator/builtins/contracts.yo");
{
  default_verify_run_config,
  resolve_solver_sync,
  verify_and_strip_tasks,
  VerifyFnReport
} :: import("../../src/verifier/driver.yo");

_have_z3 :: (fn() -> bool)(
  match(
    env.get(String.from("YO_TEST_Z3")),
    .Some(v) => (v == String.from("1")),
    .None => false
  )
);
_load_reports :: (
  fn(rel_path : &String, io : Io, expect_ok : bool) -> ArrayList(VerifyFnReport)
)({
  exn := Exception(
    throw : (
      err -> {
        assert(false, `verifier_ghost: unexpected throw: ${err.*}`);
      }
    )
  );
  std_path := resolve_std_path();
  mut(targets) := ArrayList(String).new();
  targets.push(rel_path.clone());
  targets.push(mm_resolve_entry_abs(rel_path.clone(), std_path.clone()));
  _ := take_verify_tasks();
  set_verify_mode_override(Option(String).None);
  set_verify_target_paths(&targets);
  clear_module_cache();
  mm_preload_prelude(std_path.clone(), true, io, exn);
  outcome := mm_load_file(rel_path.clone(), std_path.clone(), true, io, exn);
  match(
    _take_load_error(),
    .Some(rendered) => {
      assert(
        outcome.ok == expect_ok,
        `fixture ${rel_path} load ok=${outcome.ok.to_string()} (expected ${expect_ok.to_string()}): ${rendered}`
      );
    },
    .None => {
      assert(outcome.ok == expect_ok, `fixture ${rel_path} load ok=${outcome.ok.to_string()}`);
    }
  );
  cfg := default_verify_run_config();
  binary := match(
    resolve_solver_sync(&cfg),
    .Resolved(p) => p,
    _ => String.new()
  );
  verify_and_strip_tasks(&cfg, &binary, take_verify_tasks())
});
_load_error :: (fn(rel_path : &String, io : Io) -> String)({
  exn := Exception(
    throw : (
      err -> {
        assert(false, `verifier_ghost: unexpected throw: ${err.*}`);
      }
    )
  );
  std_path := resolve_std_path();
  mut(targets) := ArrayList(String).new();
  targets.push(rel_path.clone());
  targets.push(mm_resolve_entry_abs(rel_path.clone(), std_path.clone()));
  _ := take_verify_tasks();
  set_verify_mode_override(Option(String).None);
  set_verify_target_paths(&targets);
  clear_module_cache();
  mm_preload_prelude(std_path.clone(), true, io, exn);
  outcome := mm_load_file(rel_path.clone(), std_path.clone(), true, io, exn);
  assert(
    !outcome.ok,
    `fixture ${rel_path} was expected to FAIL to load, but it loaded cleanly`
  );
  match(_take_load_error(), .Some(rendered) => rendered, .None => String.from(""))
});
_reports_dump :: (fn(reports : &ArrayList(VerifyFnReport)) -> String)({
  mut(ids) := ArrayList(String).new();
  (mut(i) : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get_cloned(i),
      .Some(rp) => {
        ids.push(`${rp.fn_id}=${rp.outcome} [${rp.subset_construct}]`);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  mut(sb) := StringBuilder.new();
  (mut(j) : usize) = usize(0);
  while(j < ids.len(), {
    if(j > usize(0), {
      sb.write_string(String.from(", "));
    });
    sb.write_string(ids(j).clone());
    j = (j + usize(1));
  });
  sb.to_string()
});
/// The fn-under-test is the SECOND task (lazy forcing registers the
/// ghost_fn first when the contract references it).
_second :: (fn(reports : &ArrayList(VerifyFnReport)) -> VerifyFnReport)(
  reports.get_cloned(usize(1)).unwrap()
);
_first :: (fn(reports : &ArrayList(VerifyFnReport)) -> VerifyFnReport)(
  reports.get_cloned(usize(0)).unwrap()
);

test("ghost_fn predicates INLINE (bounded proves through within)", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(String.from("./tests/spec/fixtures/valid/ghost-fn-inline.yo"), io, true);
  assert(reports.len() == usize(2), `two functions, got ${reports.len().to_string()}: [${_reports_dump(&reports)}]`);
  rp := _second(&reports);
  assert(rp.outcome == "ok", `bounded proves through the inlined requires, got: [${_reports_dump(&reports)}]`);
});

test("the inlining is REAL — a false post-condition REFUTES (x = 0 model)", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(String.from("./tests/spec/fixtures/negative/ghost-fn-inline-false.yo"), io, true);
  assert(reports.len() == usize(2), `two functions, got ${reports.len().to_string()}: [${_reports_dump(&reports)}]`);
  rp := _second(&reports);
  assert(rp.outcome == "refuted", `strictly_bounded refutes (an assumed-instead-of-inlined predicate would prove anything), got: [${_reports_dump(&reports)}]`);
});

test("ghost bindings track through the walk (ghost_bump proves)", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(String.from("./tests/spec/fixtures/valid/ghost-binding.yo"), io, true);
  assert(reports.len() == usize(1), `one function, got ${reports.len().to_string()}: [${_reports_dump(&reports)}]`);
  rp := _first(&reports);
  assert(rp.outcome == "ok", `ghost_bump proves (the assert reads the ghost binding), got: [${_reports_dump(&reports)}]`);
});

test("a ghost binding does not poison a same-named local in ANOTHER module (FV audit)", {
  if(!_have_z3(), {
    return(());
  });
  // Poison first: this file creates ghost(prev := x), which pre-fix
  // registered `prev` in a PROCESS-GLOBAL name set.
  _ := _load_reports(String.from("./tests/spec/fixtures/valid/ghost-binding.yo"), io, true);
  // An unrelated module whose plain local merely shares the name must
  // still load and prove — the gate asks the resolved Variable, not the
  // name
  // (issues/fixed/ghost-binding-escape-gate-is-a-process-global-name-set.md).
  reports := _load_reports(String.from("./tests/spec/fixtures/valid/ghost-name-collision.yo"), io, true);
  assert(reports.len() == usize(1), `one function, got ${reports.len().to_string()}: [${_reports_dump(&reports)}]`);
  rp := _first(&reports);
  assert(rp.outcome == "ok", `a same-named local in another module is NOT a ghost binding, got: [${_reports_dump(&reports)}]`);
});

test("reading a ghost binding from ordinary code is a LOUD gate (solver-free)", {
  reports := _load_reports(String.from("./tests/spec/fixtures/negative/ghost-escape.yo"), io, false);
  assert(reports.len() == usize(1), `one function, got ${reports.len().to_string()}: [${_reports_dump(&reports)}]`);
  rp := _first(&reports);
  assert(rp.outcome == "subset-error", `leaky is gated, got: [${_reports_dump(&reports)}]`);
  assert(
    rp.subset_construct.contains(String.from("ghost")),
    `the report names the ghost escape, got: ${rp.subset_construct}`
  );
});

// A contracted ghost_fn called from a RUNTIME body. The evaluator always threw
// the right error here; what it did not do was let it out. The throw lands in
// the def-time trial swallow, and `prepare_callsite_contracts` then ran on that
// hollow body and raised a DERIVED unify failure through the real exn — which,
// being raised first, was the one the user saw, blaming a `requires` clause
// they wrote correctly.
// issues/fixed/contracted-ghost-fn-called-from-runtime-reports-a-unify-error.md
test("a contracted ghost_fn called from runtime names the GHOST rule (solver-free)", {
  msg := _load_error(
    String.from("./tests/spec/fixtures/negative/ghost-fn-contracted-runtime-call.yo"),
    io
  );
  assert(
    msg.contains(String.from("ghost context")),
    `the load error must name the ghost-context rule, got: ${msg}`
  );
  assert(
    !msg.contains(String.from("Cannot unify")),
    `the derived unify error must not mask the real cause, got: ${msg}`
  );
});

// The literal-free twin. This shape reported correctly even BEFORE the fix,
// because `requires(a > b)` compares two equally-unbound parameters and so
// produced no mismatch for the derived evaluation to trip over. It is here to
// catch a fix that repairs the noisy path by disturbing the quiet one.
test("the literal-free twin names the GHOST rule too (canary)", {
  msg := _load_error(
    String.from("./tests/spec/fixtures/negative/ghost-fn-contracted-runtime-call-quiet.yo"),
    io
  );
  assert(
    msg.contains(String.from("ghost context")),
    `the literal-free shape must report the same rule, got: ${msg}`
  );
});

// Over-rejection canary: rejecting the runtime call must not close the LEGAL
// ghost-context path. Both the lemma and its caller must still verify, which
// also proves the call-site contract stash still runs for bodies that DID
// evaluate — the thing the fix skips only when the trial failed.
test("the same contracted ghost_fn still verifies from ghost context", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/ghost-fn-contracted-ghost-call.yo"),
    io,
    true
  );
  assert(reports.len() == usize(2), `two functions, got ${reports.len().to_string()}: [${_reports_dump(&reports)}]`);
  assert(
    _first(&reports).outcome == "ok",
    `the lemma proves, got: [${_reports_dump(&reports)}]`
  );
  assert(
    _second(&reports).outcome == "ok",
    `the caller proves, got: [${_reports_dump(&reports)}]`
  );
});

// ---------------------------------------------------------------------------
// The call rules of erased code (plans/backlog/SPEC_AND_PROOF.md §4.1–§4.2):
// evaluator errors, so they need no solver.
// ---------------------------------------------------------------------------
test("ghost(...) takes a binding or a lemma call — a push is E0929", {
  // issues/fixed/2026-11-27-a-ghost-statement-mutates-state-the-program-reads.md
  msg := _load_error(String.from("./tests/spec/fixtures/negative/ghost-statement-mutates-state.yo"), io);
  assert(msg.contains(String.from("E0929")), `the statement form error is E0929, got: ${msg}`);
  assert(msg.contains(String.from("takes a ghost binding")), `the message names the two forms, got: ${msg}`);
});

test("a ghost binding cannot call a contracted function (E0928)", {
  // issues/fixed/2026-11-27-a-ghost-binding-calls-a-diverging-function.md
  msg := _load_error(String.from("./tests/spec/fixtures/negative/ghost-binding-calls-contracted.yo"), io);
  assert(msg.contains(String.from("E0928")), `the spec call error is E0928, got: ${msg}`);
  assert(msg.contains(String.from("'spin' has a contract")), `the message names the callee, got: ${msg}`);
});

test("an ensures clause cannot call a contracted function (E0928)", {
  // issues/fixed/2026-11-27-an-ensures-clause-calls-a-diverging-function.md
  msg := _load_error(String.from("./tests/spec/fixtures/negative/ensures-calls-contracted.yo"), io);
  assert(msg.contains(String.from("E0928")), `the spec call error is E0928, got: ${msg}`);
  assert(msg.contains(String.from("'spin' has a contract")), `the message names the callee, got: ${msg}`);
});

test("a lemma called from an executable body is E0928, naming the ghost statement", {
  msg := _load_error(String.from("./tests/spec/fixtures/negative/lemma-called-from-runtime.yo"), io);
  assert(msg.contains(String.from("E0928")), `a lemma outside a proof is E0928, got: ${msg}`);
  assert(msg.contains(String.from("ghost(lem(...));")), `the message gives the ghost statement, got: ${msg}`);
});

test("ghost(...) inside a lemma body is E0929 — the body is already a proof", {
  msg := _load_error(String.from("./tests/spec/fixtures/negative/ghost-inside-lemma-body.yo"), io);
  assert(msg.contains(String.from("E0929")), `ghost(...) in a proof is E0929, got: ${msg}`);
  assert(msg.contains(String.from("already ghost")), `the message says why, got: ${msg}`);
});

test("an uncontracted function that calls a contracted one is not spec-transparent", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(String.from("./tests/spec/fixtures/negative/transparent-calls-contracted.yo"), io, true);
  (mut(found) : bool) = false;
  (mut(i) : usize) = usize(0);
  while(i < reports.len(), {
    rp := reports.get_cloned(i).unwrap();
    if(rp.subset_construct.contains(String.from("it calls 'spin', which has a contract")), {
      found = true;
      assert(rp.outcome == "subset-error", `wrong must not prove through wrap, got: [${_reports_dump(&reports)}]`);
    });
    i = (i + usize(1));
  });
  assert(found, `a report must name the contracted call inside wrap, got: [${_reports_dump(&reports)}]`);
});
