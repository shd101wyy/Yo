test("a zero-iteration exit is NOT the body's output (pin_exit REFUTED)", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(String.from("./tests/spec/fixtures/negative/loop_exit_havoc.yo"), io);
  assert(reports.len() == usize(1), `one function, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`);
  rp := match(
    reports.get(usize(0)),
    .Some(r) => r,
    .None => {
      assert(false, "report missing");
      return(());
    }
  );
  assert(rp.outcome != "ok", `pin_exit must not prove (the exit is a fresh havoc state), got: [${_reports_dump(reports)}]`);
});

test("the exit encoding re-havocs and selects break states (solver-free)", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `verifier_loops: unexpected throw: ${err}`);
      }
    )
  );
  std_path := resolve_std_path();
  rel := String.from("./tests/spec/fixtures/valid/loop_break.yo");
  targets := ArrayList(String).new();
  targets.push(rel.clone());
  targets.push(mm_resolve_entry_abs(rel.clone(), std_path.clone()));
  _ := take_verify_tasks();
  set_verify_mode_override(Option(String).None);
  set_verify_target_paths(targets);
  clear_module_cache();
  mm_preload_prelude(std_path.clone(), true, io, exn);
  outcome := mm_load_file(rel.clone(), std_path.clone(), true, io, exn);
  assert(outcome.ok, "fixture must evaluate cleanly");
  tasks := take_verify_tasks();
  assert(tasks.len() == usize(1), `one task, got ${tasks.len().to_string()}`);
  t := match(
    tasks.get(usize(0)),
    .Some(x) => x,
    .None => {
      assert(false, "task missing");
      return(());
    }
  );
  res := verify_function_body(
    VerifyFnInput(
      fn_name : t.fn_id.clone(),
      func_id : t.func_id.clone(),
      body : t.body.clone(),
      param_names : t.param_names.clone(),
      param_types : t.param_types.clone(),
      result_type : t.result_type.clone(),
      requires_exprs : t.requires_exprs.clone(),
      ensures_exprs : t.ensures_exprs.clone(),
      decreases_expr : t.decreases_expr.clone(),
      return_label : t.return_label.clone(),
      table : t.table
    )
  );
  assert(res.error.is_none(), `no subset error expected for the break fixture`);
  scripts := StringBuilder.new();
  (oi : usize) = usize(0);
  while(oi < res.obligations.len(), {
    match(
      res.obligations.get(oi),
      .Some(obl) => {
        scripts.write_string(encode_script(obl.query, default_encode_options()));
      },
      .None => ()
    );
    oi = (oi + usize(1));
  });
  all := scripts.to_string();
  assert(all.contains(String.from("__yo_br")), "the break selector constants appear in the encoding");
  assert(all.contains(String.from("__yo_hv2_")), "the exit re-havocs under a second generation");
});
