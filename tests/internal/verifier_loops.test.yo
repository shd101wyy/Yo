test("a non-decreasing loop measure is REFUTED at the variant obligation", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(String.from("./tests/spec/fixtures/negative/non_decreasing_measure.yo"), io);
  assert(reports.len() == usize(1), `one function, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`);
  rp := match(
    reports.get(usize(0)),
    .Some(r) => r,
    .None => {
      assert(false, "report missing");
      return(());
    }
  );
  assert(rp.outcome != "ok", `stuck_measure must not prove, got: [${_reports_dump(reports)}]`);
});

