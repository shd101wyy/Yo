/// Smoke test for yo-self/logger.yo.
///
/// 1-to-1 with `src/logger.ts`. Since `debug()` only prints when both
/// NODE_ENV-isn't-production AND DEBUG-is-set, there's nothing
/// observable to assert from a unit test (the test runner doesn't
/// set DEBUG). This file just exercises the import + call path so a
/// `yo test tests/internal/logger.test.yo` would catch a
/// regression in the binding.
open(import("std/string"));
{ debug } :: import("../../yo-self/logger.yo");
{ assert, panic } :: import("std/assert");
test("logger: debug call type-checks and runs (no DEBUG set → no-op)", {
  debug(String.from("test message"));
  assert(true, "debug returned without panicking");
});
