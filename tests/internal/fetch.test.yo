pragma(Pragma.SkipWasm32Emscripten); // the store-reuse test spawns native git children
pragma(Pragma.SkipWasm32Wasi); // the store-reuse test spawns native git children
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ DirEntry, FileType, create_dir_all } :: import("std/fs/dir");
{ write_string, read_to_string, exists } :: import("std/fs/file");
{ remove_dir_all } :: import("std/fs/walker");
{ Path } :: import("std/path");
{ Rng } :: import("std/rand");
{ temp_dir } :: import("std/env");
{ Exception, IoExn } :: import("std/error");
{ normalize_line_endings, sort_dir_entries, is_local_git_path, git_remote_url, commit_from_ls_remote, fetch_package, git_command } :: import("../../src/fetch.yo");
{ assert, panic } :: import("std/assert");
// ---------------------------------------------------------------------------
// normalize_line_endings
// ---------------------------------------------------------------------------
test("normalize_line_endings: no-op when no CR", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(104)); // 'h'
  bytes.push(u8(105)); // 'i'
  bytes.push(u8(10)); // '\n'
  result := normalize_line_endings(&bytes);
  assert(result.len() == usize(3), "no CR means unchanged length");
  assert(result(usize(0)) == u8(104), "h preserved");
  assert(result(usize(1)) == u8(105), "i preserved");
  assert(result(usize(2)) == u8(10), "LF preserved");
});
test("normalize_line_endings: removes CR before LF", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(104)); // 'h'
  bytes.push(u8(13)); // '\r'
  bytes.push(u8(10)); // '\n'
  bytes.push(u8(105)); // 'i'
  result := normalize_line_endings(&bytes);
  assert(result.len() == usize(3), "CRLF -> LF reduces length by 1");
  assert(result(usize(0)) == u8(104), "h");
  assert(result(usize(1)) == u8(10), "LF");
  assert(result(usize(2)) == u8(105), "i");
});
test("normalize_line_endings: lone CR is preserved", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(13)); // '\r' NOT followed by '\n'
  bytes.push(u8(65)); // 'A'
  result := normalize_line_endings(&bytes);
  assert(result.len() == usize(2), "lone CR kept");
  assert(result(usize(0)) == u8(13), "CR preserved");
  assert(result(usize(1)) == u8(65), "A preserved");
});
test("normalize_line_endings: multiple CRLF sequences", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(97)); // 'a'
  bytes.push(u8(13)); // '\r'
  bytes.push(u8(10)); // '\n'
  bytes.push(u8(98)); // 'b'
  bytes.push(u8(13)); // '\r'
  bytes.push(u8(10)); // '\n'
  result := normalize_line_endings(&bytes);
  assert(result.len() == usize(4), "two CRLFs removed two CRs");
});
// ---------------------------------------------------------------------------
// git_remote_url
// ---------------------------------------------------------------------------
test("is_local_git_path: ./, ../ and / are paths; URLs and scp-style remotes are not", {
  assert(is_local_git_path(String.from("./remote.git")), "./");
  assert(is_local_git_path(String.from("../up/remote.git")), "../");
  assert(is_local_git_path(String.from("/abs/remote.git")), "/");
  assert(!is_local_git_path(String.from("https://github.com/o/r.git")), "https");
  assert(!is_local_git_path(String.from("git@github.com:o/r.git")), "scp-style");
  assert(!is_local_git_path(String.from("ssh://git@host/r.git")), "ssh");
});
test("git_remote_url: a local path is made absolute against the project dir; a URL is as written", {
  assert(git_remote_url(String.from("/proj"), String.from("./remote.git")) == "/proj/remote.git", "./ under the project");
  assert(git_remote_url(String.from("/proj/sub"), String.from("../remote.git")) == "/proj/remote.git", "../ normalizes");
  assert(git_remote_url(String.from("/proj"), String.from("https://h/r.git")) == "https://h/r.git", "URL untouched");
});
// ---------------------------------------------------------------------------
// sort_dir_entries
// ---------------------------------------------------------------------------
_make_dir_entry :: (fn(name : str) -> DirEntry)(
  DirEntry(
    name : String.from(name),
    file_type : FileType.File,
    ino : u64(0),
    parent : Path.new(String.new())
  )
);
test("sort_dir_entries: empty list stays empty", {
  entries := ArrayList(DirEntry).new();
  sorted := sort_dir_entries(&entries);
  assert(sorted.len() == usize(0), "empty");
});
test("sort_dir_entries: single entry unchanged", {
  entries := ArrayList(DirEntry).new();
  entries.push(_make_dir_entry("foo.txt"));
  sorted := sort_dir_entries(&entries);
  assert(sorted.len() == usize(1), "one entry");
  assert(sorted(usize(0)).name == "foo.txt", "name preserved");
});
test("sort_dir_entries: already sorted list unchanged", {
  entries := ArrayList(DirEntry).new();
  entries.push(_make_dir_entry("a.txt"));
  entries.push(_make_dir_entry("b.txt"));
  entries.push(_make_dir_entry("c.txt"));
  sorted := sort_dir_entries(&entries);
  assert(sorted(usize(0)).name == "a.txt", "a first");
  assert(sorted(usize(1)).name == "b.txt", "b second");
  assert(sorted(usize(2)).name == "c.txt", "c third");
});
test("sort_dir_entries: reverse order is sorted", {
  entries := ArrayList(DirEntry).new();
  entries.push(_make_dir_entry("z.txt"));
  entries.push(_make_dir_entry("m.txt"));
  entries.push(_make_dir_entry("a.txt"));
  sorted := sort_dir_entries(&entries);
  assert(sorted(usize(0)).name == "a.txt", "a first");
  assert(sorted(usize(1)).name == "m.txt", "m second");
  assert(sorted(usize(2)).name == "z.txt", "z third");
});
// ---------------------------------------------------------------------------
// commit_from_ls_remote
// ---------------------------------------------------------------------------
_commit_or :: (fn(text : str, fallback : str) -> String)(
  match(
    commit_from_ls_remote(String.from(text)),
    .None => String.from(fallback),
    .Some(sha) => sha
  )
);
test("commit_from_ls_remote: annotated tag peels to the COMMIT, not the tag object", {
  // What `git ls-remote -- <url> v0.0.7 'v0.0.7^{}'` prints for an annotated
  // tag: the tag OBJECT first, the commit on the peeled line.
  text := "7e942fae34e3146de8503f3bf32411e8b28c0919\trefs/tags/v0.0.7\ne0b57015533d17bb5204737d73e6e06d6bcb6292\trefs/tags/v0.0.7^{}";
  assert(
    _commit_or(text, "none") == "e0b57015533d17bb5204737d73e6e06d6bcb6292",
    "the peeled line wins — a tag object is not a commit"
  );
});
test("commit_from_ls_remote: peeled line first is still preferred", {
  text := "e0b57015533d17bb5204737d73e6e06d6bcb6292\trefs/tags/v0.0.7^{}\n7e942fae34e3146de8503f3bf32411e8b28c0919\trefs/tags/v0.0.7";
  assert(
    _commit_or(text, "none") == "e0b57015533d17bb5204737d73e6e06d6bcb6292",
    "order-independent"
  );
});
test("commit_from_ls_remote: lightweight tag has one unpeeled line", {
  text := "ecab5f62bfa3692241d005ada11f77955a9b98e2\trefs/tags/v0.0.4";
  assert(_commit_or(text, "none") == "ecab5f62bfa3692241d005ada11f77955a9b98e2", "the only line");
});
test("commit_from_ls_remote: a branch resolves to its tip", {
  text := "e0b57015533d17bb5204737d73e6e06d6bcb6292\trefs/heads/master";
  assert(_commit_or(text, "none") == "e0b57015533d17bb5204737d73e6e06d6bcb6292", "branch tip");
});
test("commit_from_ls_remote: HEAD resolves to its tip", {
  text := "e0b57015533d17bb5204737d73e6e06d6bcb6292\tHEAD";
  assert(_commit_or(text, "none") == "e0b57015533d17bb5204737d73e6e06d6bcb6292", "HEAD tip");
});
test("commit_from_ls_remote: blank lines are skipped", {
  text := "\n\nabc123\trefs/tags/v1\n\n";
  assert(_commit_or(text, "none") == "abc123", "leading and trailing blanks ignored");
});
test("commit_from_ls_remote: empty output is None", {
  assert(_commit_or("", "none") == "none", "nothing to resolve");
});
// ---------------------------------------------------------------------------
// fetch_package store reuse: a mutated inner file is detected
// ---------------------------------------------------------------------------
/// Run `git -C <dir> <a> [<b> [<c>]]`, failing the test on a non-zero exit.
_fm_git :: (fn(dir : &String, io : Io, e : IoExn, (a : str) ?= "", (b : str) ?= "", (c : str) ?= "") -> unit)({
  cmd := git_command();
  cmd.arg(String.from("-C"));
  cmd.arg(dir.clone());
  if(a.len() > usize(0), {
    cmd.arg(String.from(a));
  });
  if(b.len() > usize(0), {
    cmd.arg(String.from(b));
  });
  if(c.len() > usize(0), {
    cmd.arg(String.from(c));
  });
  status := e.io.await(cmd.status(e.io), e);
  if(!status.success(), {
    e.exn.throw(dyn(`git ${a} failed in ${dir}`));
  });
});
test("fetch_package: a mutated inner file of a stored tree is detected and the tree re-fetched", {
  // The 2026-11-01 store corruption: a tool edited an inner file of a
  // PRESENT store entry; the `.verified` marker still stood, so the locked
  // reuse path trusted the mutated bytes and every project on the machine
  // compiled them. The reuse path must re-hash the tree and re-fetch it
  // (issues/fixed/2026-11-01-a-mutated-store-entry-is-reused-by-install-locked.md).
  rng := Rng.from_entropy();
  root := Path.new(temp_dir()).join(Path.new(`yo_fm_${rng.next_u64().to_string()}`));
  mk := Exception(
    throw : (
      err -> {
        assert(false, `fixture io failed: ${err}`);
        unwind(());
      }
    )
  );
  ioexn := IoExn(io : io, exn : mk);
  repo := root.join(Path.new(String.from("repo"))).to_string();
  io.await(create_dir_all(Path.new(repo.clone()), io), ioexn);
  _fm_git(&repo, io, ioexn, "init", "--quiet");
  _fm_git(&repo, io, ioexn, "config", "user.email", "fixture@example.com");
  _fm_git(&repo, io, ioexn, "config", "user.name", "fixture");
  io.await(write_string(Path.new(`${repo}/lib.yo`), String.from("VERSION :: `1.0.0`;\n"), io), ioexn);
  _fm_git(&repo, io, ioexn, "add", "lib.yo");
  _fm_git(&repo, io, ioexn, "commit", "--quiet", "-m one");
  rp := git_command();
  rp.arg(String.from("-C"));
  rp.arg(repo.clone());
  rp.arg(String.from("rev-parse"));
  rp.arg(String.from("HEAD"));
  out := io.await(rp.output(io), ioexn);
  sha := String.from_bytes(out.stdout.clone()).trim();
  assert(sha.len() == usize(40), "rev-parse HEAD returned a commit");
  cache := root.join(Path.new(String.from("cache"))).to_string();
  no_lock := Option(String).None;
  first := io.await(
    fetch_package(cache.clone(), String.from("fmdep"), repo.clone(), sha.clone(), &no_lock, &no_lock, false, false, false, io, mk),
    ioexn
  );
  locked_commit := Option(String).Some(sha.clone());
  locked_integrity := Option(String).Some(first.integrity.clone());
  second := io.await(
    fetch_package(cache.clone(), String.from("fmdep"), repo.clone(), sha.clone(), &locked_commit, &locked_integrity, false, false, false, io, mk),
    ioexn
  );
  landed := io.await(exists(Path.new(`${second.dir}/lib.yo`), io), io);
  assert(landed, "the locked reuse found the landed tree");
  // The corruption: write into the STORED tree, marker and all.
  io.await(write_string(Path.new(`${second.dir}/lib.yo`), String.from("VERSION :: `9.9.9`;\n"), io), ioexn);
  third := io.await(
    fetch_package(cache.clone(), String.from("fmdep"), repo.clone(), sha.clone(), &locked_commit, &locked_integrity, false, false, false, io, mk),
    ioexn
  );
  text := io.await(read_to_string(Path.new(`${third.dir}/lib.yo`), io), ioexn);
  assert(text.contains(String.from("1.0.0")), "the mutated inner file was re-fetched pristine");
  assert(!text.contains(String.from("9.9.9")), "no mutated byte survives the reuse");
  io.await(remove_dir_all(root.clone(), io), ioexn);
});
