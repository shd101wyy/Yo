{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ DirEntry, FileType } :: import("std/fs/dir");
{ Path } :: import("std/path");
{ normalize_line_endings, sort_dir_entries, is_local_git_path, git_remote_url } :: import("../../src/fetch.yo");
{ assert, panic } :: import("std/assert");
// ---------------------------------------------------------------------------
// normalize_line_endings
// ---------------------------------------------------------------------------
test("normalize_line_endings: no-op when no CR", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(104)); // 'h'
  bytes.push(u8(105)); // 'i'
  bytes.push(u8(10)); // '\n'
  result := normalize_line_endings(bytes);
  assert(result.len() == usize(3), "no CR means unchanged length");
  assert(result(usize(0)) == u8(104), "h preserved");
  assert(result(usize(1)) == u8(105), "i preserved");
  assert(result(usize(2)) == u8(10), "LF preserved");
});
test("normalize_line_endings: removes CR before LF", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(104)); // 'h'
  bytes.push(u8(13)); // '\r'
  bytes.push(u8(10)); // '\n'
  bytes.push(u8(105)); // 'i'
  result := normalize_line_endings(bytes);
  assert(result.len() == usize(3), "CRLF -> LF reduces length by 1");
  assert(result(usize(0)) == u8(104), "h");
  assert(result(usize(1)) == u8(10), "LF");
  assert(result(usize(2)) == u8(105), "i");
});
test("normalize_line_endings: lone CR is preserved", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(13)); // '\r' NOT followed by '\n'
  bytes.push(u8(65)); // 'A'
  result := normalize_line_endings(bytes);
  assert(result.len() == usize(2), "lone CR kept");
  assert(result(usize(0)) == u8(13), "CR preserved");
  assert(result(usize(1)) == u8(65), "A preserved");
});
test("normalize_line_endings: multiple CRLF sequences", {
  bytes := ArrayList(u8).new();
  bytes.push(u8(97)); // 'a'
  bytes.push(u8(13)); // '\r'
  bytes.push(u8(10)); // '\n'
  bytes.push(u8(98)); // 'b'
  bytes.push(u8(13)); // '\r'
  bytes.push(u8(10)); // '\n'
  result := normalize_line_endings(bytes);
  assert(result.len() == usize(4), "two CRLFs removed two CRs");
});
// ---------------------------------------------------------------------------
// git_remote_url
// ---------------------------------------------------------------------------
test("is_local_git_path: ./, ../ and / are paths; URLs and scp-style remotes are not", {
  assert(is_local_git_path(String.from("./remote.git")), "./");
  assert(is_local_git_path(String.from("../up/remote.git")), "../");
  assert(is_local_git_path(String.from("/abs/remote.git")), "/");
  assert(!is_local_git_path(String.from("https://github.com/o/r.git")), "https");
  assert(!is_local_git_path(String.from("git@github.com:o/r.git")), "scp-style");
  assert(!is_local_git_path(String.from("ssh://git@host/r.git")), "ssh");
});
test("git_remote_url: a local path is made absolute against the project dir; a URL is as written", {
  assert(git_remote_url(String.from("/proj"), String.from("./remote.git")) == "/proj/remote.git", "./ under the project");
  assert(git_remote_url(String.from("/proj/sub"), String.from("../remote.git")) == "/proj/remote.git", "../ normalizes");
  assert(git_remote_url(String.from("/proj"), String.from("https://h/r.git")) == "https://h/r.git", "URL untouched");
});
// ---------------------------------------------------------------------------
// sort_dir_entries
// ---------------------------------------------------------------------------
_make_dir_entry :: (fn(name : str) -> DirEntry)(
  DirEntry(
    name : String.from(name),
    file_type : FileType.File,
    ino : u64(0),
    parent : Path.new(String.new())
  )
);
test("sort_dir_entries: empty list stays empty", {
  entries := ArrayList(DirEntry).new();
  sorted := sort_dir_entries(entries);
  assert(sorted.len() == usize(0), "empty");
});
test("sort_dir_entries: single entry unchanged", {
  entries := ArrayList(DirEntry).new();
  entries.push(_make_dir_entry("foo.txt"));
  sorted := sort_dir_entries(entries);
  assert(sorted.len() == usize(1), "one entry");
  assert(sorted(usize(0)).name == "foo.txt", "name preserved");
});
test("sort_dir_entries: already sorted list unchanged", {
  entries := ArrayList(DirEntry).new();
  entries.push(_make_dir_entry("a.txt"));
  entries.push(_make_dir_entry("b.txt"));
  entries.push(_make_dir_entry("c.txt"));
  sorted := sort_dir_entries(entries);
  assert(sorted(usize(0)).name == "a.txt", "a first");
  assert(sorted(usize(1)).name == "b.txt", "b second");
  assert(sorted(usize(2)).name == "c.txt", "c third");
});
test("sort_dir_entries: reverse order is sorted", {
  entries := ArrayList(DirEntry).new();
  entries.push(_make_dir_entry("z.txt"));
  entries.push(_make_dir_entry("m.txt"));
  entries.push(_make_dir_entry("a.txt"));
  sorted := sort_dir_entries(entries);
  assert(sorted(usize(0)).name == "a.txt", "a first");
  assert(sorted(usize(1)).name == "m.txt", "m second");
  assert(sorted(usize(2)).name == "z.txt", "z third");
});
