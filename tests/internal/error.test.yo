//! Tests for src/error.yo + src/diagnostics.yo — the P1 structured
//! diagnostic model (plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md). These are the
//! golden tests for the human/short renderers: exact-string pins of the
//! rustc-shaped output.
//!
//! The renderer pins call render_diagnostics_human(err.diagnostics) directly;
//! the to_string test below additionally pins the TRAIT-DISPATCH tail
//! (YoError.to_string IS render_diagnostics_human(self.diagnostics)) — that
//! bare-tail projection-by-value call was the exact shape of the Stage-0
//! balancing-drop leak (issues/fixed/
//! ref-local-scope-drop-missing-after-value-call.md), so it doubles as the
//! leak regression net under the shard's LeakSanitizer build.
{ rune, String } :: import("std/string");
import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ TokenKind, Token } :: import("../../src/token.yo");
json :: import("std/encoding/json");
{ assert, panic } :: import("std/assert");
{
  TokenAndError,
  TokenAndWarning,
  YoError,
  get_line_at_token,
  get_line_at_position,
  format_error_message,
  format_error_messages,
  format_lexer_error,
  format_raw_error,
  format_warning_messages,
  _classify_message,
  format_error_message_with_help,
  format_error_message_with_repair,
  reanchor_primary_at
} :: import("../../src/error.yo");
{
  Severity,
  Span,
  Diagnostic,
  render_diagnostics_human,
  render_diagnostics_short,
  render_diagnostics_json,
  render_diagnostics_sarif,
  set_warnings_enabled,
  warnings_enabled,
  emit_warning,
  take_warnings,
  take_user_warnings,
  set_color_enabled,
  suggest_name
} :: import("../../src/diagnostics.yo");
// Build a dummy token for testing.
make_token :: (fn(module_path : String, input : String, row : usize, column : usize, value : String) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : value,
    row : row,
    column : column,
    character : usize(0),
    module_path : module_path,
    input : input
  )
);
// ─── format_error_message: the human render (exact) ──────────────────────────
test("format_error_message renders the full block exactly once", {
  tok := make_token(`test.yo`, `let x = 1;`, usize(0), usize(4), `x`);
  err := format_error_message(tok, `undefined variable x`);
  s := render_diagnostics_human(err.diagnostics);
  expected := `error: undefined variable x\n  --> test.yo:1:5\n  |\n1 | let x = 1;\n  |     ^`;
  assert(s == expected, `exact render, got:\n${s}`);
});
test("format_error_message multi-line message keeps continuation lines", {
  tok := make_token(`test.yo`, `x := "s";`, usize(0), usize(0), `x`);
  err := format_error_message(tok, `Incompatible types:\n- Expected: i32\n- Given   : String`);
  s := render_diagnostics_human(err.diagnostics);
  expected := `error[E0601]: Incompatible types:\n- Expected: i32\n- Given   : String\n  --> test.yo:1:1\n  |\n1 | x := "s";\n  | ^\nhelp: run \`yo explain E0601\` for more information`;
  assert(s == expected, `multi-line render, got:\n${s}`);
});
test("format_error_message underlines the whole token (D5)", {
  tok := make_token(`t.yo`, `aa bb`, usize(0), usize(3), `bb`);
  s := render_diagnostics_human(format_error_message(tok, `msg`).diagnostics);
  assert(s.contains(`  |    ^^`), `two carets under "bb", got:\n${s}`);
});
test("format_error_message gutter widens for multi-digit rows", {
  input := `one\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten xx`;
  tok := make_token(`g.yo`, input, usize(9), usize(4), `xx`);
  s := render_diagnostics_human(format_error_message(tok, `msg`).diagnostics);
  assert(s.contains(`   --> g.yo:10:5`), `w=2 anchor, got:\n${s}`);
  assert(s.contains(`   |`), `w=2 bar line, got:\n${s}`);
  assert(s.contains(`10 | ten xx`), `padded row line, got:\n${s}`);
  assert(s.contains(`   |     ^^`), `w=2 caret line, got:\n${s}`);
});
test("format_error_message multibyte before the token aligns by rune column", {
  // `你` is one rune (3 bytes): the token `x` sits at RUNE column 1, and the
  // caret padding counts runes, so it lands under `x` (D4 lesson).
  tok := make_token(`m.yo`, `你x := 1;`, usize(0), usize(1), `x`);
  s := render_diagnostics_human(format_error_message(tok, `msg`).diagnostics);
  expected := `error: msg\n  --> m.yo:1:2\n  |\n1 | 你x := 1;\n  |  ^`;
  assert(s == expected, `rune-column caret, got:\n${s}`);
});
// ─── format_error_messages: primary + note blocks ───────────────────────────
test("format_error_messages: entry 0 is the error, later entries are notes (D6)", {
  tok1 := make_token(`b.yo`, `x y`, usize(0), usize(0), `x`);
  tok2 := make_token(`b.yo`, `x y`, usize(0), usize(2), `y`);
  e1 := TokenAndError(token : tok1, error_message : `first error`);
  e2 := TokenAndError(token : tok2, error_message : `second error`);
  list := ArrayList(TokenAndError).new();
  list.push(e1);
  list.push(e2);
  err := format_error_messages(list);
  s := render_diagnostics_human(err.diagnostics);
  expected := `error: first error\n  --> b.yo:1:1\n  |\n1 | x y\n  | ^\n\nnote: second error\n  --> b.yo:1:3\n  |\n1 | x y\n  |   ^`;
  assert(s == expected, `error + note blocks, got:\n${s}`);
});
// ─── reanchor_primary_at: an error inside std, reported at the user's call ───
test("reanchor_primary_at moves the primary and keeps the old location as a note", {
  std_tok := make_token(`std/fmt/index.yo`, `where(T <: ToString)`, usize(0), usize(8), `<:`);
  call_tok := make_token(`main.yo`, `a\nb\nc\nd\n  println(p);`, usize(4), usize(2), `println`);
  err := format_error_message_with_help(std_tok, `Type P does not implement required trait ToString.`, Option(String).Some(`implement it`));
  moved := reanchor_primary_at(err, call_tok, `raised here, inside the standard library`);
  assert(moved.diagnostics.len() == usize(2), `primary + note, got ${moved.diagnostics.len().to_string()}`);
  s := render_diagnostics_human(moved.diagnostics);
  expected := `error[E0602]: Type P does not implement required trait ToString.\n  --> main.yo:5:3\n  |\n5 |   println(p);\n  |   ^^^^^^^\nhelp: implement it\nhelp: run \`yo explain E0602\` for more information\n\nnote: raised here, inside the standard library\n  --> std/fmt/index.yo:1:9\n  |\n1 | where(T <: ToString)\n  |         ^^`;
  assert(s == expected, `re-anchored render, got:\n${s}`);
});
// ─── format_lexer_error (D3: lexer errors carry file + source line) ─────────
test("format_lexer_error renders like every other stage", {
  input := `a b\n@@ oops`;
  err := format_lexer_error(`src.yo`, input, usize(1), usize(0), `unexpected character`);
  s := render_diagnostics_human(err.diagnostics);
  expected := `error[E0005]: unexpected character\n  --> src.yo:2:1\n  |\n2 | @@ oops\n  | ^\nhelp: run \`yo explain E0005\` for more information`;
  assert(s == expected, `lexer diagnostic, got:\n${s}`);
});
// ─── format_raw_error (path anchor, no snippet) ──────────────────────────────
test("format_raw_error anchors the path without a snippet", {
  s := render_diagnostics_human(format_raw_error(`e.yo`, `unexpected end of input`).diagnostics);
  expected := `error: unexpected end of input\n  --> e.yo:1:1`;
  assert(s == expected, `raw diagnostic, got:\n${s}`);
});
// ─── the code field renders as [EXXXX] (filled by P2) ────────────────────────
test("a coded diagnostic renders error[E0308] in both renderers", {
  diags := ArrayList(Diagnostic).new();
  diags.push(
    Diagnostic(
      code : Option(String).Some(String.from("E0308")),
      severity : Severity.Error,
      message : String.from("mismatched types"),
      span : Span(path : String.from("a.yo"), row : usize(0), col : usize(0), len : usize(1)),
      source_line : String.from("x")
    )
  );
  h := render_diagnostics_human(diags);
  assert(h == `error[E0308]: mismatched types\n  --> a.yo:1:1\n  |\n1 | x\n  | ^\nhelp: run \`yo explain E0308\` for more information`, `coded human, got:\n${h}`);
  sh := render_diagnostics_short(diags);
  assert(sh == `a.yo:1:1: error[E0308]: mismatched types`, `coded short, got:\n${sh}`);
});
// ─── YoError.to_string — the bare-tail Stage-0 shape ─────────────────────────
// This pins the TRAIT-DISPATCH tail (impl(YoError, ToString) to_string =
// render_diagnostics_human(self.diagnostics)): the bare-tail projection-
// by-value call whose Stage-0 balancing drop went missing on the shared
// begin node (issues/fixed/ref-local-scope-drop-missing-after-value-call.md) —
// under the shard's LeakSanitizer build it is the leak's regression net.
test("YoError.to_string renders through the trait tail", {
  tok := make_token(`test.yo`, `let x = 1;`, usize(0), usize(4), `x`);
  err := format_error_message(tok, `undefined variable x`);
  s := err.to_string();
  expected := `error: undefined variable x\n  --> test.yo:1:5\n  |\n1 | let x = 1;\n  |     ^`;
  assert(s == expected, `to_string render, got:\n${s}`);
});
// ─── render_diagnostics_short ────────────────────────────────────────────────
test("render_diagnostics_short is one line per entry", {
  tok := make_token(`test.yo`, `let x = 1;`, usize(0), usize(4), `x`);
  err := format_error_message(tok, `undefined variable x\nsecond line dropped in short`);
  sh := render_diagnostics_short(err.diagnostics);
  assert(sh == `test.yo:1:5: error: undefined variable x`, `short render, got:\n${sh}`);
});
// ─── get_line_at_token / get_line_at_position (legacy warnings-path helpers) ─
test("get_line_at_token single line", {
  tok := make_token(`test.yo`, `hello world`, usize(0), usize(6), `world`);
  line := get_line_at_token(tok);
  assert(line.contains(`test.yo:1:7:`), "header");
  assert(line.contains(`hello world`), "source line");
  assert(line.contains(`^`), "caret");
});
test("get_line_at_token multiline input selects correct row", {
  input := `line0\nline1\nline2`;
  tok := make_token(`src.yo`, input, usize(1), usize(0), `line1`);
  line := get_line_at_token(tok);
  assert(line.contains(`src.yo:2:1:`), "row 1 shown as row 2");
  assert(line.contains(`line1`), "correct source line selected");
});
test("get_line_at_position basic", {
  result := get_line_at_position(`mod.yo`, `abc\ndef`, usize(0), usize(2));
  assert(result.contains(`mod.yo:1:3:`), "header");
  assert(result.contains(`abc`), "source line");
  assert(result.contains(`^`), "caret");
});
// ─── format_warning_messages (legacy pre-P1 block; the warnings channel is P4)
test("format_warning_messages no prefix", {
  tok := make_token(`w.yo`, `foo`, usize(0), usize(0), `foo`);
  entry := TokenAndWarning(token : tok, warning_message : `unused variable`);
  warnset := ArrayList(TokenAndWarning).new();
  warnset.push(entry);
  result := format_warning_messages(.None, warnset);
  assert(result.contains(`Warning: unused variable`), "warning message present");
  assert(result.contains(`^`), "caret present");
});
test("format_warning_messages with prefix", {
  tok := make_token(`w.yo`, `foo`, usize(0), usize(0), `foo`);
  entry := TokenAndWarning(token : tok, warning_message : `deprecated usage`);
  warnset := ArrayList(TokenAndWarning).new();
  warnset.push(entry);
  result := format_warning_messages(.Some(String.from("module warning")), warnset);
  assert(result.contains(`Warning: module warning`), "prefix warning present");
  assert(result.contains(`deprecated usage`), "per-token warning present");
});
test("format_warning_messages empty list no prefix", {
  result := format_warning_messages(.None, ArrayList(TokenAndWarning).new());
  assert(result == ``, "empty result when no prefix and no warnings");
});
// ─── YoError round-trip ──────────────────────────────────────────────────────
test("YoError.diagnostics render the shared human form", {
  tok := make_token(`main.yo`, `let`, usize(0), usize(0), `let`);
  err := format_error_message(tok, `unexpected keyword`);
  s := render_diagnostics_human(err.diagnostics);
  assert(s.starts_with(`error: unexpected keyword`), "severity header present");
  assert(s.contains(`--> main.yo:1:1`), "anchor present");
  assert(s.contains(`1 | let`), "source line present");
});
// ─── P2: the classifier maps messages to code families ──────────────────────
test("classifier: representative messages map to their families", {
  match(
    _classify_message(`Variable "x" not found.`),
    .Some(c) => assert(c == "E0401", `E0401, got ${c}`),
    .None => assert(false, "variable-not-found must classify")
  );
  match(
    _classify_message(`Enum variant "Reed" not found in enum`),
    .Some(c) => assert(c == "E0402", `E0402, got ${c}`),
    .None => assert(false, "enum variant must classify")
  );
  match(
    _classify_message(`Field "_count" of Counter is private to its declaring module`),
    .Some(c) => assert(c == "E0405", `E0405, got ${c}`),
    .None => assert(false, "private member must classify")
  );
  match(
    _classify_message(`Incompatible types:\n- Expected: i32\n- Given   : i64`),
    .Some(c) => assert(c == "E0601", `E0601, got ${c}`),
    .None => assert(false, "incompatible types must classify")
  );
  match(
    _classify_message(`Argument count mismatch: expected 3, got 2`),
    .Some(c) => assert(c == "E0603", `E0603, got ${c}`),
    .None => assert(false, "arity must classify")
  );
  match(
    _classify_message(`Argument for parameter "f" is not callable:\n- Parameter: Impl(Fn(x : i32) -> i32)\n- Argument : i32`),
    .Some(c) => assert(c == "E0606", `E0606, got ${c}`),
    .None => assert(false, "non-callable argument must classify")
  );
  match(
    _classify_message(`use of moved value: \`x\``),
    .Some(c) => assert(c == "E0901", `E0901, got ${c}`),
    .None => assert(false, "moved value must classify")
  );
  match(
    _classify_message(`unexpected token: }`),
    .Some(c) => assert(c == "E0001", `E0001, got ${c}`),
    .None => assert(false, "unexpected token must classify")
  );
  match(
    _classify_message(`unterminated template string`),
    .Some(c) => assert(c == "E0004", `E0004, got ${c}`),
    .None => assert(false, "unterminated must classify")
  );
  match(
    _classify_message(`Integer overflow in compile-time evaluation`),
    .Some(c) => assert(c == "E1102", `E1102, got ${c}`),
    .None => assert(false, "comptime overflow must classify")
  );
  assert(_classify_message(`something entirely novel`).is_none(), "unfamiliar text stays uncoded");
});
test("coded diagnostics render the explain tail (P2)", {
  tok := make_token(`t.yo`, `x := 1;`, usize(0), usize(0), `x`);
  s := render_diagnostics_human(format_error_message(tok, `Variable "x" not found.`).diagnostics);
  assert(s.starts_with(`error[E0401]: Variable "x" not found.`), `coded header, got:\n${s}`);
  assert(
    s.contains(`help: run \`yo explain E0401\` for more information`),
    `explain tail, got:\n${s}`
  );
});
// ─── P3: the help channel + did-you-mean ─────────────────────────────────────
test("suggest_name finds near identifiers and rejects far ones", {
  cands := ArrayList(String).new();
  cands.push(String.from("compute"));
  cands.push(String.from("count"));
  cands.push(String.from("total"));
  match(
    suggest_name(String.from("computee"), cands),
    .Some(h) => assert(h == "compute", `computee → compute, got ${h}`),
    .None => assert(false, "near identifier must suggest")
  );
  assert(suggest_name(String.from("zzzzzzz"), cands).is_none(), "far identifier suggests nothing");
});
test("format_error_message_with_help renders the hint block", {
  tok := make_token(`t.yo`, `compute(x);`, usize(0), usize(0), `compute`);
  err := format_error_message_with_help(
    tok,
    `Variable "computee" not found.`,
    Option(String).Some(`did you mean "compute"?`)
  );
  s := err.to_string();
  assert(s.starts_with(`error[E0401]: Variable "computee" not found.`), `coded header, got:\n${s}`);
  assert(s.contains(`help: did you mean "compute"?`), `hint line, got:\n${s}`);
  assert(
    s.contains(`help: run \`yo explain E0401\` for more information`),
    `explain tail still present, got:\n${s}`
  );
});

// ─── P4: color (D14) ─────────────────────────────────────────────────────────
test("color: human render carries SGR when on and is byte-identical when off", {
  tok := make_token(`t.yo`, `x := 1;`, usize(0), usize(0), `x`);
  set_color_enabled(false);
  plain := render_diagnostics_human(format_error_message(tok, `Variable "x" not found.`).diagnostics);
  assert(!plain.contains(`\u{1b}`), `plain render must not contain ESC, got:\n${plain}`);
  set_color_enabled(true);
  colored := render_diagnostics_human(format_error_message(tok, `Variable "x" not found.`).diagnostics);
  // Restore BEFORE asserting so a failure cannot leak color into the rest
  // of this file's exact-string pins (they run in this same process).
  set_color_enabled(false);
  assert(colored.contains(`\u{1b}[1;31merror[E0401]\u{1b}[0m: Variable "x" not found.`), `red header, got:\n${colored}`);
  assert(colored.contains(`\u{1b}[1;34m  --> t.yo:1:1\u{1b}[0m`), `blue anchor, got:\n${colored}`);
  assert(colored.contains(`\u{1b}[1;31m^\u{1b}[0m`), `red caret, got:\n${colored}`);
  assert(colored.contains(`\u{1b}[1;35mhelp:\u{1b}[0m run \`yo explain E0401\``), `magenta help label, got:\n${colored}`);
});
test("color: a warning renders with the warning color", {
  warns := ArrayList(Diagnostic).new();
  warns.push(
    Diagnostic(
      code : Option(String).None,
      severity : Severity.Warning,
      message : String.from("unused variable `x`"),
      span : Span(path : String.from("t.yo"), row : usize(0), col : usize(0), len : usize(1)),
      source_line : String.from("x := 1;")
    )
  );
  set_color_enabled(true);
  s := render_diagnostics_human(warns);
  set_color_enabled(false);
  assert(s.contains(`\u{1b}[1;33mwarning\u{1b}[0m: unused variable \`x\``), `yellow header, got:\n${s}`);
});
test("color: the json render never carries ESC, even with color forced on", {
  tok := make_token(`t.yo`, `x := 1;`, usize(0), usize(0), `x`);
  set_color_enabled(true);
  j := render_diagnostics_json(format_error_message(tok, `Variable "x" not found.`).diagnostics);
  set_color_enabled(false);
  assert(!j.contains(`\u{1b}`), `json payload must never carry ESC, got:\n${j}`);
});

// ─── P4: SARIF ───────────────────────────────────────────────────────────────
test("sarif: a valid 2.1.0 log with rule, region and fix", {
  tok := make_token(`t.yo`, `countr := 1;`, usize(0), usize(8), `countr`);
  err := format_error_message_with_repair(
    tok,
    `Variable "countr" not found.`,
    Option(String).None,
    String.from("counter"),
    String.from("rename to the closest name in scope")
  );
  s := render_diagnostics_sarif(err.diagnostics);
  assert(s.contains(`"$schema":"https://json.schemastore.org/sarif-2.1.0.json"`), `schema, got:\n${s}`);
  assert(s.contains(`"version":"2.1.0"`), `version, got:\n${s}`);
  assert(s.contains(`"ruleId":"E0401"`), `ruleId, got:\n${s}`);
  assert(s.contains(`"startLine":1`), `1-based startLine, got:\n${s}`);
  assert(s.contains(`"startColumn":9`), `1-based startColumn, got:\n${s}`);
  assert(s.contains(`"endColumn":15`), `exclusive endColumn over the token, got:\n${s}`);
  assert(s.contains(`"tool":{"driver":{"name":"yo"`), `tool.driver nesting, got:` + s);
  assert(s.contains(`"physicalLocation":{"artifactLocation"`), `physicalLocation nesting, got:` + s);
  assert(s.contains(`"fixes"`), `fix present, got:\n${s}`);
  assert(s.contains(`"deletedRegion"`), `deletedRegion, got:\n${s}`);
  assert(
    s.contains(`"insertedContent":{"text":"counter"}`),
    `insertedContent object, got:
${s}`
  );
  match(
    json.parse_string(s),
    .Ok(_) => (),
    .Err(_) => assert(false, `sarif must round-trip through the json parser, got:\n${s}`)
  );
});
test("sarif: an ownership group is ONE log with two results sharing one rule", {
  toks := ArrayList(TokenAndError).new();
  toks.push(
    TokenAndError(
      token : make_token(`t.yo`, `consume(z);`, usize(3), usize(0), `consume`),
      error_message : `use of moved value: \`z\``
    )
  );
  toks.push(
    TokenAndError(
      token : make_token(`t.yo`, `let z = own(T)();`, usize(1), usize(4), `z`),
      error_message : `value moved here`
    )
  );
  s := render_diagnostics_sarif(format_error_messages(toks).diagnostics);
  assert(s.contains(`"ruleId":"E0901"`), `primary keeps its code, got:\n${s}`);
  assert(s.contains(`"level":"error"`), `primary level, got:\n${s}`);
  assert(s.contains(`"level":"note"`), `secondary renders as note, got:\n${s}`);
  match(
    json.parse_string(s),
    .Ok(_) => (),
    .Err(_) => assert(false, `group log must parse, got:\n${s}`)
  );
});
test("sarif: never colored, even with color forced on", {
  tok := make_token(`t.yo`, `x := 1;`, usize(0), usize(0), `x`);
  set_color_enabled(true);
  s := render_diagnostics_sarif(format_error_message(tok, `Variable "x" not found.`).diagnostics);
  set_color_enabled(false);
  assert(!s.contains(`\u{1b}`), `sarif must never carry ESC, got:\n${s}`);
});

// ─── P4: the warnings channel (D15) ──────────────────────────────────────────
test("warnings: the stash dedupes, takes clean, and honors the enabled flag", {
  mk :: (fn(name : String) -> Diagnostic)(
    Diagnostic(
      code : Option(String).None,
      severity : Severity.Warning,
      message : `unused variable \`${name}\``,
      span : Span(path : String.from("t.yo"), row : usize(4), col : usize(2), len : usize(1)),
      source_line : String.new()
    )
  );
  set_warnings_enabled(false);
  emit_warning(mk(String.from("a")));
  assert(take_warnings().len() == usize(0), "emit while disabled is a no-op");
  set_warnings_enabled(true);
  emit_warning(mk(String.from("a")));
  emit_warning(mk(String.from("a")));
  emit_warning(mk(String.from("b")));
  n := take_warnings().len();
  after := take_warnings().len();
  set_warnings_enabled(false);
  assert(n == usize(2), `dedupe to one per span+message, got ${n.to_string()}`);
  assert(after == usize(0), "take clears the stash");
  assert(!warnings_enabled(), "flag restored");
});

test("take_user_warnings filters std/cache roots by path COMPONENT", {
  mk_at :: (fn(path : String) -> Diagnostic)(
    Diagnostic(
      code : Option(String).None,
      severity : Severity.Warning,
      message : String.from("unused variable `x`"),
      span : Span(path : path, row : usize(0), col : usize(0), len : usize(1)),
      source_line : String.new()
    )
  );
  set_warnings_enabled(true);
  emit_warning(mk_at(String.from("file:///toolchain/std/prelude.yo")));
  emit_warning(mk_at(String.from("file:///toolchain/cache/store/sha256/abc/src/lib.yo")));
  emit_warning(mk_at(String.from("file:///repo/stdlib_extra/app.yo")));
  emit_warning(mk_at(String.from("file:///repo/src/app.yo")));
  kept := take_user_warnings(
    String.from("file:///toolchain/std"),
    String.from("file:///toolchain/cache")
  );
  n := kept.len();
  after := take_warnings().len();
  set_warnings_enabled(false);
  assert(n == usize(2), `std+cache dropped, user kept, got ${n.to_string()}`);
  match(
    kept.get(usize(0)),
    .Some(w) => assert(w.span.path.contains(String.from("stdlib_extra")), `stdlib_extra survives a /std root (component check), got ${w.span.path}`),
    .None => assert(false, "first kept present")
  );
  assert(after == usize(0), "take clears");
});
