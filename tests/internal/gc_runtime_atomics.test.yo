//! Tests for the atomic-RC + worker-pool codegen pins.
//!
//! Port of `src/tests/thread-safety-codegen.test.ts` (Phase G / P2.5 step 15,
//! plans/archive/P2_5_RETIRE_EXECUTION.md). The TS version compiles a whole program and
//! greps the emitted C; a cli-case cannot replace it because
//! scripts/cli-diff-test.sh ignores `*.yo.c` by design. This port instead calls
//! the yo-self emitter functions directly — pinning the same template text at
//! its source:
//!   1. `__yo_incr_rc_atomic` uses atomic_fetch_add_explicit + relaxed.
//!   2. `__yo_decr_rc_atomic` uses atomic_fetch_sub_explicit + acq_rel.
//!   3. Drop dispatch runs INSIDE the decrement function (lightweight variant —
//!      the path the TS test's `arc(i32(42))` program hits; the full-GC variant
//!      dispatches via `header->dispose_fn` instead, so pins 1-2 are asserted on
//!      BOTH variants while pin 3 is lightweight-only, exactly like the TS test).
//!   4. `__yo_worker_pool_init` is guarded (idempotent).
{ String } :: import("std/string");
{ Emitter } :: import("../../src/emitter.yo");
{ expr_info_table_new } :: import("../../src/expr_info.yo");
{ host_target } :: import("../../src/target.yo");
{ CodeGenContext } :: import("../../src/codegen/utils/index.yo");
{ FunctionGenerationContext } :: import("../../src/codegen/functions/context.yo");
{ generate_atomic_gc_runtime_functions } :: import("../../src/codegen/functions/gc_runtime.yo");
{ generate_parallelism_runtime } :: import("../../src/codegen/parallelism/runtime.yo");
{ assert, panic } :: import("std/assert");
/// Build a fresh per-function generation context over an empty program,
/// mirroring codegen_c.yo's construction (`Emitter.new()` → `CodeGenContext.new`
/// → `FunctionGenerationContext.new`). The RC-runtime emitters only touch
/// `base.emitter`, `base.target_info`, `base.needs_cycle_gc` and the (empty)
/// `unwind_value_c_types`, so empty registries are the production shape here.
mk_context :: (fn(needs_cycle_gc : bool) -> FunctionGenerationContext)({
  base := CodeGenContext.new(
    Emitter.new(),
    expr_info_table_new(),
    host_target(),
    String.from("system"),
    usize(16777216),
    false,
    false,
    false,
    false,
    false
  );
  base.needs_cycle_gc = needs_cycle_gc;
  FunctionGenerationContext.new(base)
});
/// Emit the RC runtime through the production dispatcher
/// (`generate_atomic_gc_runtime_functions`: full when needs_cycle_gc, else
/// lightweight) and return the full C text (headers + declarations + code).
emit_rc_runtime :: (fn(needs_cycle_gc : bool) -> String)({
  ctx := mk_context(needs_cycle_gc);
  generate_atomic_gc_runtime_functions(ctx);
  em := ctx.base.emitter;
  em.print()
});
/// Emit the parallelism runtime (thread + worker pool) for the host target and
/// return the full C text.
emit_parallelism_runtime :: (fn() -> String)({
  em := Emitter.new();
  generate_parallelism_runtime(em, false, host_target(), false);
  em.print()
});
/// index_of that panics when the marker is missing (so a template rename fails
/// loudly instead of slicing from index 0).
must_find :: (fn(hay : String, needle : str, from : usize) -> usize)(
  match(
    hay.index_of(needle, from),
    .Some(i) => i,
    .None => {
      msg := String.from("codegen pin marker not found in emitted C: ");
      msg.push_str(needle);
      panic(msg);
      usize(0)
    }
  )
);
test("__yo_incr_rc_atomic uses atomic_fetch_add_explicit with relaxed", {
  incr_line := "atomic_fetch_add_explicit((_Atomic uint32_t*)&header->ref_count, 1, memory_order_relaxed)";
  c_light := emit_rc_runtime(false);
  assert(c_light.contains("atomic_fetch_add_explicit"), "lightweight: incr uses atomic_fetch_add_explicit");
  assert(c_light.contains(incr_line), "lightweight: incr fetch_add is memory_order_relaxed");
  c_full := emit_rc_runtime(true);
  assert(c_full.contains(incr_line), "full-GC: incr fetch_add is memory_order_relaxed");
});
test("__yo_decr_rc_atomic uses atomic_fetch_sub_explicit with acq_rel", {
  decr_line := "atomic_fetch_sub_explicit((_Atomic uint32_t*)&header->ref_count, 1, memory_order_acq_rel)";
  c_light := emit_rc_runtime(false);
  assert(c_light.contains(decr_line), "lightweight: decr fetch_sub is memory_order_acq_rel");
  c_full := emit_rc_runtime(true);
  assert(c_full.contains(decr_line), "full-GC: decr fetch_sub is memory_order_acq_rel");
});
test("drop dispatch runs within the decrement function", {
  c := emit_rc_runtime(false);
  // Mirror the TS slice: from the decr definition to its first `}` (which
  // closes the `if (header->type_id)` block, past the dispatch call) + 500.
  start := must_find(c, "static void __yo_decr_rc_atomic", usize(0));
  close := must_find(c, "}", start);
  body := c.substring(start, close + usize(500));
  assert(body.contains("atomic_fetch_sub_explicit"), "decr body contains the atomic fetch_sub");
  assert(body.contains("memory_order_acq_rel"), "decr body fetch_sub is acq_rel");
  assert(body.contains("__yo_dispose_dispatch"), "dispose dispatch runs inside __yo_decr_rc_atomic");
});
test("__yo_worker_pool_init is guarded (idempotent)", {
  c := emit_parallelism_runtime();
  assert(c.contains("__yo_worker_pool_initialized"), "pool init flag is emitted");
  assert(c.contains("static void __yo_worker_pool_init"), "pool init function is emitted");
  // Mirror the TS slice: from the init definition to its first `}` (which
  // closes the guard's early-return block) + 500.
  start := must_find(c, "static void __yo_worker_pool_init(", usize(0));
  close := must_find(c, "}", start);
  body := c.substring(start, close + usize(500));
  assert(body.contains("if (__yo_worker_pool_initialized)"), "init body checks the flag");
  assert(body.contains("return"), "init body returns early when already initialized");
});
/// The C text of one emitted runtime function: from its definition line to
/// the first line that is exactly `}`.
fn_body :: (fn(c : String, signature : str) -> String)({
  start := must_find(c, signature, usize(0));
  close := must_find(c, "\n}", start);
  c.substring(start, close)
});
// A cycle-incapable object carries the 16-byte __yo_ref_header_small_t, and a
// member access through the 56-byte __yo_ref_header_t on it is undefined
// behavior (UBSan object-size fired on the first incr of a self-built
// compiler: issues/fixed/small-rc-header-accessed-through-the-full-header-type.md).
// Code that can see either layout must read through __yo_rc_prefix_t, and
// may cast to the full header only after the TRACKED test.
test("full-GC prefix-only RC paths never cast to the full header", {
  c := emit_rc_runtime(true);
  for_prefix_only := (sig : str) => {
    body := fn_body(c, sig);
    assert(!body.contains("(__yo_ref_header_t*)"), `${sig} reads through the full header`);
    assert(body.contains("(__yo_rc_prefix_t*)"), `${sig} reads through the prefix`);
  };
  for_prefix_only("static inline void __yo_decr_rc(void* ptr) {");
  for_prefix_only("static inline void* __yo_incr_rc(void* ptr) {");
  for_prefix_only("static void* __yo_incr_rc_atomic(void* ptr) {");
  for_prefix_only("static void __yo_decr_rc_atomic(void* ptr) {");
  for_prefix_only("static inline void __yo_borrow_acquire(void* ptr) {");
  for_prefix_only("static inline void __yo_borrow_release(void* ptr) {");
  for_prefix_only("static inline void __yo_borrow_assert_unborrowed(void* ptr) {");
});
test("every full-GC visitor tests TRACKED through the prefix before a full-header cast", {
  c := emit_rc_runtime(true);
  tracked_first := (sig : str) => {
    body := fn_body(c, sig);
    test_at := must_find(body, "((__yo_rc_prefix_t*)ptr)->gc_flags & __YO_GC_TRACKED", usize(0));
    cast_at := must_find(body, "(__yo_ref_header_t*)ptr", usize(0));
    assert(test_at < cast_at, `${sig} casts to the full header before the TRACKED test`);
  };
  tracked_first("static void __yo_gc_unregister(void* ptr) {");
  tracked_first("static void __yo_gc_mark_gray_visitor(void* ptr) {");
  tracked_first("static void __yo_gc_scan_black_visitor(void* ptr) {");
  tracked_first("static void __yo_gc_scan_visitor(void* ptr) {");
  tracked_first("static void __yo_gc_gather_white_visitor(void* ptr) {");
  tracked_first("static void __yo_gc_trial_delete_visitor(void* ptr) {");
  tracked_first("static void __yo_gc_scan_restore_visitor(void* ptr) {");
});
