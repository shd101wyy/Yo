// ─── Colon/assignment operators with parenthesized -> RHS ────────────────────
// Regression: these patterns are used extensively in the prelude and must parse
// without error. The RHS (fn(...) -> T) is a parenthesized expression — the
// strict operator grouping check must not fire.
test("Parse colon : with parenthesized -> RHS", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  prog := parse(`x : (fn() -> i32)`, `test.yo`, exn);
  e := only_expr(&prog);
  assert(ast_expr_is_fn_call(&e), "colon : should produce FnCall");
});
test("Parse ?= with parenthesized -> RHS", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  prog := parse(`x ?= (fn() -> i32)`, `test.yo`, exn);
  e := only_expr(&prog);
  assert(ast_expr_is_fn_call(&e), "?= should produce FnCall");
});
