  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  prog := parse(`x := (fn() -> i32)`, `test.yo`, exn);
  e := only_expr(&prog);
  assert(ast_expr_is_fn_call(&e), ":= should produce FnCall");
});
test("Parse ?= with multi-line parenthesized -> RHS", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  prog := parse(
    `x ?= (
  (lhs, rhs) ->
    lhs + rhs
)`,
    `test.yo`,
    exn
