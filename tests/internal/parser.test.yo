// ─── Closure capture lists (plans/VALUES_BY_DEFAULT.md decision 35) ─────────
test("Parse a capture list: `{ x, &y, z : &mut w }(m) => body`", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  prog := parse(`{ x, &y, z : &mut w }(m) => m`, `test.yo`, exn);
  e := only_expr(&prog);
  // The renderer's canonical form: the record callee is NOT parenthesized
  // (an arrow callee never is — `f(g(m)) => m` renders the same way), and a
  // renamed borrow entry renders `label : <unary operand>` with only the
  // OPERAND parenthesized (`&mut(w)`).
  assert_str_eq(ast_expr_to_string(&e), `_(x : x, __yo_imm(y), __yo_mut(z) : &mut(w))(m) => m`, "the record literal is the arrow's callee; the borrow entries read as the internal mode form");
});
test("Parse a record pattern arm `{ x, y } => body` next to a capture-list closure", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  prog := parse(`match(p, { x, y } => x)`, `test.yo`, exn);
  e := only_expr(&prog);
  // Match arms render without wrapping parens (`match(p, y(x) => x)` does
  // too); the record keeps the `_(…)` shape the shorthand-struct test above
  // establishes.
  assert_str_eq(ast_expr_to_string(&e), `match(p, _(x : x, y : y) => x)`, "a record pattern arm keeps the record shape");
  prog2 := parse(`match(p, { x }(y) => y)`, `test.yo`, exn);
  e2 := only_expr(&prog2);
  assert_str_eq(ast_expr_to_string(&e2), `match(p, _(x : x)(y) => y)`, "the capture-list shape parses; the evaluator rejects it as an arm pattern");
});
