test("Parse colon : with multi-line parenthesized -> RHS in struct field", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  prog := parse(
    `({
    Output : comptime_int,
    (+) : (
      (lhs, rhs) ->
        lhs + rhs
    )
})`,
    `test.yo`,
    exn
  );
  e := only_expr(&prog);
  assert(ast_expr_is_fn_call(&e), "colon with multi-line parens should produce FnCall");
});
// ─── Template-string spec peeling (`_peel_spec`) ──────────────────────────────
// `plans/archive/STD_API_AUDIT_D4_PLAN.md` §5.2 S4. `_peel_spec` splits `${expr:spec}`
// by walking an `ArrayList(rune)` backwards and then cutting `text`. Those two
// index bases have to agree, and BEFORE the D4 migration they agreed only by
// accident — `substring` happened to be rune-indexed. Every pre-existing test
// in this file is ASCII, where the accident is invisible; these are multibyte
// on BOTH sides of the cut, so a byte/rune confusion in the peel shows up as a
// mangled expression text or a mangled spec.
//
// The parse of a template string yields two top-level exprs: the injected
// `import("std/fmt/format")` and the rendering call, whose printed form
// (`(<expr>.format)("<spec>")`) shows exactly where the peel cut.
_ts :: (fn(inner : str) -> String)({
  sb := StringBuilder.new();
  sb.write_byte(u8(96));
  sb.write_str(inner);
  sb.write_byte(u8(96));
  sb.to_string()
});
// `exn` is passed in rather than built here: the file's other tests build the
// throwing handler INSIDE the `test(...)` body, and a `(err) -> { …; unwind(()); }`
// closure hoisted into a top-level helper emits a `Failed to transpile` stub
// under the seed compiler (issues/fixed/ftt-stub-in-live-closure-falls-off-non-void-function.md).
_parse_ts :: (fn(inner : str, exn : Exception) -> String)({
  prog := parse(_ts(inner), `test.yo`, exn);
  assert(prog.len() == usize(2), "template string should parse to import + rendering");
  match(
    prog.get(usize(1)),
    .Some(e) => ast_expr_to_string(&e),
    .None => String.new()
  )
});
test("Peel a format spec off a MULTIBYTE template expression", {
  exn := Exception(
    throw : (
      err -> {
        panic("unexpected parse error in a template string");
      }
    )
  );
  assert_str_eq(_parse_ts("${x:>8}", exn), `(x.format)(">8")`, "ASCII control case");
  assert_str_eq(_parse_ts("${名前:>8}", exn), `(名前.format)(">8")`, "3-byte runes before the colon");
  assert_str_eq(_parse_ts("${名前:.2}", exn), `(名前.format)(".2")`, "precision spec after 3-byte runes");
  assert_str_eq(_parse_ts("${é:#08x}", exn), `(é.format)("#08x")`, "2-byte rune before the colon");
  assert_str_eq(_parse_ts("${a.名前:^10.4}", exn), `((a.名前).format)("^10.4")`, "dotted path with a multibyte segment");
});
test("A spaced colon-pair stays a colon-pair with multibyte content", {
  exn := Exception(
    throw : (
      err -> {
        panic("unexpected parse error in a template string");
      }
    )
  );
  // The `space before the colon` guard reads `tc(k - 2)`, a RUNE index; the
  // whole point of S4 is that the cut that follows agrees with it.
  assert_str_eq(_parse_ts("${名前 : y}", exn), `((名前 : y).to_string)()`, "spaced colon is not a spec");
  assert_str_eq(_parse_ts("${名前}", exn), `(名前.to_string)()`, "no spec at all");
});
test("Peeling survives multibyte literal text around the interpolation", {
  exn := Exception(
    throw : (
      err -> {
        panic("unexpected parse error in a template string");
      }
    )
  );
  assert_str_eq(
    _parse_ts("中${名前:>8}文", exn),
    `((("中".to_string)().(+))((名前.format)(">8")).(+))(("文".to_string)())`,
    "multibyte literal segments on both sides"
  );
});
test("Reject adjacent different operators without parentheses", {
  // The parse-time rejection of `1 + 2 * 3` had NO test at all: the header
  // of tests/operator_grouping.test.yo pointed at a parser-level test in
  // src/tests/operator-grouping.test.ts — a file that never existed in any
  // commit (the TS compiler's src/tests/ was deleted 2026-08-20). This is
  // the reject-invalid direction that file's comptime tests cannot see.
  exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, YoError),
          .Some(ye) => assert(
            ye.to_string().contains(`Adjacent different operators need parentheses`),
            "wrong error message"
          ),
          .None => assert(false, "expected a YoError diagnostic")
        );
        unwind(());
      }
    )
  );
  parse(`x := 1 + 2 * 3;`, `test.yo`, exn);
  assert(false, "expected an adjacent-different-operator parse error");
});
// ─── E0003's canonical-grouping hint ────────────────────────────────────────
// The pair table these follow is in
// issues/retired/2026-10-22-should-the-structural-operators-carry-precedence.md.
/// Parse `src` and return the thrown diagnostic's text, "" when it parses
/// (a handler is capture-free, so the text travels as the fn's value).
_parse_error_text :: (fn(src : &String) -> String)({
  exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, YoError),
          .Some(ye) => unwind(ye.to_string()),
          .None => unwind(String.from("<not a YoError>"))
        );
      }
    )
  );
  parse(src, `test.yo`, exn);
  String.new()
});
/// Parse `src`, expecting E0003. A non-empty `want` is the exact hint sentence
/// the message must carry; an empty one means the pair has no canonical
/// grouping, so the message must carry no hint at all.
_expect_e0003 :: (fn(src : &String, want : &String) -> unit)({
  s := _parse_error_text(src);
  assert(s.contains(`Adjacent different operators need parentheses`), "expected E0003");
  if(want.len() > usize(0), {
    if(!s.contains(want), {
      println(`E0003 hint mismatch: expected "${want}" in: ${s}`);
      assert(false, "missing canonical grouping hint");
    });
  }, {
    if(s.contains(`Wrap the right-hand side`) || s.contains(`Parenthesize`), {
      println(`E0003 claims a grouping for a hint-free pair: ${s}`);
      assert(false, "this mix has no canonical grouping");
    });
  });
});
test("E0003 names the wrap-the-right-side grouping for a binding operator", {
  _expect_e0003(`x := 1 + 2;`, `Wrap the right-hand side in parentheses: name := (1 + 2).`);
});
test("E0003 names the wrap-the-right-side grouping for a fn-type annotation", {
  // `:` next to a fn type is the biggest forced-paren population.
  _expect_e0003(`next : fn() -> void;`, `Wrap the right-hand side in parentheses: name : (fn() -> void).`);
});
test("E0003 names the whole condition for a comparison before an arm arrow", {
  _expect_e0003(
    `cond(n <= i32(1) => i32(1), true => i32(0));`,
    `Parenthesize the whole condition: (condition) => value.`
  );
});
test("E0003 does not group inside a condition with two computational operators", {
  // The parser stops at the INNERMOST operator (`&&`), so naming its operands,
  // `(q && r) => value`, would pick `p == (q && r)`: a different program.
  _expect_e0003(
    `cond(p == q && r => i32(1), true => i32(0));`,
    `Parenthesize the whole condition: (condition) => value.`
  );
});
test("E0003 names the annotated-binding grouping for a typed assignment", {
  // `x : i32 = v` groups on the LEFT — `(x : i32) = v`, never `x : (i32 = v)`.
  _expect_e0003(`x : i32 = 5;`, `Parenthesize the annotated binding: (name : Type) = value.`);
});
test("E0003 stays hint-free when both groupings are real programs", {
  // `1 + 2 * 3` has two legitimate groupings (LLM authoring audit §3.1).
  _expect_e0003(`1 + 2 * 3;`, ``);
});
test("E0003 names the annotated-parameter grouping for `:` next to `=>`", {
  // `x : i32 => x` closes the annotation before the arrow: `(x : i32) => x`.
  _expect_e0003(`x : i32 => x;`, `Parenthesize the annotated parameter: (name : Type) => body.`);
});
test("E0003 names the annotated-parameter grouping for `:` next to a lambda `->`", {
  // `->` after a non-fn-type left operand is a lambda arrow: `(self : Self) -> {...}`.
  _expect_e0003(`self : Self -> { 1 };`, `Parenthesize the annotated parameter: (name : Type) -> body.`);
});
test("E0003 names the fn-type grouping for a fn-type arrow next to `=`", {
  // `x : fn() -> void = f` first fails at `->`: the fn type closes before the
  // binding, `(fn() -> void) = f` (then `(x : (fn() -> void)) = f`).
  _expect_e0003(`x : fn() -> void = f;`, `Parenthesize the function type: (fn(...) -> T) = value.`);
});
test("E0003 names the fn-type grouping for a fn-type arrow next to `=>`", {
  _expect_e0003(`f : fn() -> void => f();`, `Parenthesize the function type: (fn(...) -> T) => value.`);
});
test("E0003 names the labeled-return grouping for a fn-type arrow next to `:`", {
  // `fn() -> r : i32` is a labeled return, `fn() -> (r : i32)`.
  _expect_e0003(`fn() -> r : i32;`, `Wrap the right-hand side in parentheses: fn(...) -> (r : i32).`);
});
test("E0003 names the wrap-the-right-side grouping for a lambda body", {
  _expect_e0003(`f := (x -> x + 1);`, `Wrap the right-hand side in parentheses: params -> (x + 1).`);
});
test("E0003 stays hint-free for an arrow next to a binding", {
  // `c => x = 5`: the lattice's `(c => x) = 5` is never a program, while the
  // arm body `c => (x = 5)` is what an author means — not unique, no hint.
  _expect_e0003(`c => x = 5;`, ``);
});
test("E0003 stays hint-free for a lambda arrow next to a binding", {
  // `err -> flag = true` means the body `err -> (flag = true)`, against the lattice.
  _expect_e0003(`h := (err -> flag = true);`, ``);
});
test("E0003 stays hint-free for an annotation next to `:=`", {
  // `(x : i32) := 5` is rejected (an annotated binding takes `=`) and
  // `x : (i32 := 5)` is no annotation, so neither grouping is a Yo form.
  _expect_e0003(`x : i32 := 5;`, ``);
});
test("E0003 stays hint-free for two different binding operators", {
  _expect_e0003(`x := y = 5;`, ``);
});
test("E0003 stays hint-free for a binding next to `:`", {
  // `x := (y : i32)` compiles, but the parenthesized `y : i32` declares `y`
  // instead of ascribing a type: the lattice grouping is a different program.
  _expect_e0003(`x := y : i32;`, ``);
});
test("E0003 stays hint-free for an arm arrow next to `:`", {
  _expect_e0003(`cond(c => y : i32, true => i32(0));`, ``);
});
test("E0003 stays hint-free for a computational operator next to `->`", {
  // Neither `(a + b) -> c` nor `a + (b -> c)` is a Yo form.
  _expect_e0003(`a + b -> c;`, ``);
});
test("E0003's right-hand side ends at its last token, before a trailing comment", {
  _expect_e0003(
    `cond(c => i32(1), true => a - b // fallback\n);`,
    `Wrap the right-hand side in parentheses: left => (a - b).`
  );
});
test("E0003 shows no right-hand side source when it holds a comment", {
  _expect_e0003(
    `x := a +\n  // a comment inside the right-hand side\n  b;`,
    `Wrap the right-hand side in parentheses: name := (...).`
  );
});
test("E0003's right-hand side stops at an interpolation's end", {
  _expect_e0003(
    String.from("s := `v=${a := b + c}`;\nf1 :: i32(1);\nf2 :: i32(2);\n"),
    `Wrap the right-hand side in parentheses: name := (b + c).`
  );
});
test("E0003 copies a literal in the right-hand side verbatim", {
  _expect_e0003(
    String.from("x := \"a    b\" + c;"),
    String.from("Wrap the right-hand side in parentheses: name := (\"a    b\" + c).")
  );
});
// ─── Decision 42: `&T` / `&mut T` in the declaration slots ──────────────────
// The parse rewrites each slot into the internal mode form every later pass
// reads, headed by `__yo_imm` / `__yo_mut` (plans/VALUES_BY_DEFAULT.md
// decision 42; the source mode words were deleted in Generation B, and the
// expected side spells the internal heads directly); a `&` anywhere else is left for the
// evaluator's "a borrow mode, not a type" error, and a call-site marker (a
// named argument `f(s : &x)`) is never touched.
_d42 :: (fn(src : &String) -> String)({
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected parse error");
        unwind(String.new());
      }
    )
  );
  ast_expr_to_string(only_expr(parse(src, `test.yo`, exn)))
});
test("decision 42: parameters, receivers and comptime parameters", {
  assert_str_eq(_d42(`(fn(x : &String, y : &mut i32, comptime(k) : &i32, self : &Self, z : i32) -> unit)`), _d42(`(fn(__yo_imm(x) : String, __yo_mut(y) : i32, comptime(__yo_imm(k)) : i32, __yo_imm(self) : Self, z : i32) -> unit)`), "each parameter reads as its internal mode form");
  assert_str_eq(_d42(`(fn((x : &i32) ?= 1) -> unit)`), _d42(`(fn((__yo_imm(x) : i32) ?= 1) -> unit)`), "through a ?= default");
});
test("decision 42: Fn slots, closure parameters and results", {
  assert_str_eq(_d42(`Impl(Fn(v : &String, w : &mut i32) -> unit)`), _d42(`Impl(Fn(__yo_imm(v) : String, __yo_mut(w) : i32) -> unit)`), "an Fn slot");
  assert_str_eq(_d42(`(v : &String) => v.len()`), _d42(`(__yo_imm(v) : String) => v.len()`), "one closure parameter");
  assert_str_eq(_d42(`(a : &String, b : &mut i32) => a`), _d42(`(__yo_imm(a) : String, __yo_mut(b) : i32) => a`), "a closure parameter list");
  assert_str_eq(_d42(`(fn(s : &String) -> &mut String)`), _d42(`(fn(__yo_imm(s) : String) -> __yo_mut(String))`), "a result slot");
});
test("decision 42: local borrows, the annotated form and re-points", {
  assert_str_eq(_d42(`y := &s.items`), _d42(`__yo_imm(y) := s.items`), "a read-only local borrow");
  assert_str_eq(_d42(`y := &mut s.items`), _d42(`__yo_mut(y) := s.items`), "an exclusive local borrow");
  assert_str_eq(_d42(`cur = &mut n.next`), _d42(`__yo_mut(cur) = n.next`), "a re-point");
  assert_str_eq(_d42(`(y : &String) = &s`), _d42(`__yo_imm(y, String) := s`), "the annotation is the mode call's second argument");
  assert_str_eq(_d42(`cur = v`), `cur = v`, "a bare right side writes through, it never re-points");
});
test("decision 42: capture lists and the borrowed for", {
  assert_str_eq(_d42(`{ x, y : &y, z : &mut w }(m : i32) => m`), _d42(`{ x, __yo_imm(y) : &y, __yo_mut(z) : &mut w }(m : i32) => m`), "the long form");
  assert_str_eq(_d42(`{ &y, &mut z }() => y`), `_(__yo_imm(y), __yo_mut(z))() => y`, "the puns");
  assert_str_eq(_d42(`for(&xs, x => x)`), _d42(`for(xs, x => x)`), "the read-only borrowed for");
  assert_str_eq(_d42(`for(&mut xs, x => x)`), _d42(`for(xs, __yo_mut(x) => x)`), "the exclusive borrowed for");
  assert_str_eq(_d42(`for(&mut m, (k, v) => v)`), _d42(`for(m, (k, __yo_mut(v)) => v)`), "the map form borrows the value");
});
test("decision 42: a `&` outside a slot is left as written", {
  assert_str_eq(_d42(`T :: &i32`), `T :: &(i32)`, "a type alias is not a slot");
  assert_str_eq(_d42(`show(s : &name)`), `show(s : &(name))`, "a named argument keeps its call-site marker");
  assert_str_eq(_d42(`S :: struct(f : &i32)`), `S :: struct(f : &(i32))`, "a field is not a slot in Generation A");
});
test("decision 42: `&&T` is rejected: a borrow of a borrow does not exist", {
  exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, YoError),
          .Some(ye) => assert(ye.to_string().contains(`a borrow of a borrow does not exist`), "wrong error message"),
          .None => assert(false, "expected a YoError diagnostic")
        );
        unwind(());
      }
    )
  );
  parse(`f :: (fn(x : &&i32) -> unit)(());`, `test.yo`, exn);
  assert(false, "expected the `&&T` parse error");
});
// ─── `=>>` is not an operator ───────────────────────────────────────────────
// The "async closure" arrow `=>>` was removed (maintainer decision 2026-10-22):
// it never was a lexer token (`=>>` lexes as `=>` then `>`), so the dangling
// `>` is a paren-less operator call, E0008, before any evaluator or codegen
// site could see a `=>>` callee.
test("`x =>> body` is rejected with E0008", {
  s := _parse_error_text(`f :: g(x =>> x);`);
  if(!s.contains(`error[E0008]`), {
    println(`expected E0008 for =>>, got: ${s}`);
    assert(false, "`x =>> body` must be rejected with E0008");
  });
  t := _parse_error_text(`f :: g((x : i32) =>> {\n  x\n});`);
  if(!t.contains(`error[E0008]`), {
    println(`expected E0008 for a typed =>> closure, got: ${t}`);
    assert(false, "`(x : i32) =>> { body }` must be rejected with E0008");
  });
});
// Every token of one parse holds the module's `input`/`module_path` cells
// (`Token.input`): the lexer's tokens, the tokens the parser synthesizes for a
// template's literal parts, and a template interpolation body's sub-parse. A token with no
// source text holds the shared empty cell; no token holds a fresh cell over
// a copy of the text.
_tokens_of :: (fn(e : &AstExpr, out : &mut ArrayList(Token)) -> unit)(
  match(
    e,
    .Atom(_, tok) => out.push(tok),
    .FnCall(_, callee, args, _, tok) => {
      out.push(tok);
      _tokens_of(&callee, out);
      (mut(i) : usize) = usize(0);
      while(i < args.len(), i = (i + usize(1)), {
        _tokens_of(&args(i), out);
      });
    }
  )
);
test("every token of a parse shares the module's source and path cells", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  source := String.from("f(`a${b + c}d`, x - y, { p; q });");
  prog := parse(&source, `cells.yo`, exn);
  toks := ArrayList(Token).new();
  (mut(i) : usize) = usize(0);
  while(i < prog.len(), i = (i + usize(1)), {
    _tokens_of(&prog(i), &mut toks);
  });
  first := toks(usize(0));
  src_cell := first.input;
  path_cell := first.module_path;
  assert(src_cell.* == source, "the first token carries the source text");
  (mut(shared) : usize) = usize(0);
  (mut(j) : usize) = usize(0);
  while(j < toks.len(), j = (j + usize(1)), {
    t := toks(j);
    t_src := t.input;
    t_path := t.module_path;
    if(t.value == `b`, {
      assert(unsafe(__yo_ptr_eq(&t_src, &src_cell)), "an interpolation body's token shares the enclosing source cell");
      assert(unsafe(__yo_ptr_eq(&t_path, &path_cell)), "an interpolation body's token shares the enclosing path cell");
    });
    if(t_src.*.len() > usize(0), {
      assert(unsafe(__yo_ptr_eq(&t_src, &src_cell)), "a token with source text shares the source cell");
      assert(unsafe(__yo_ptr_eq(&t_path, &path_cell)), "a token with source text shares the path cell");
      shared = (shared + usize(1));
    });
  });
  assert(shared > usize(8), "the walk saw the program's tokens");
});
