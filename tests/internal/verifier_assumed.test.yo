//! The `assumed()` marker tests — V6 task 5
//! (plans/backlog/FORMAL_VERIFICATION.md): a contracted fn whose body is
//! outside the verifiable subset declares `assumed()`; the verifier
//! reports it as `assumed` without walking the body, while its contracts
//! still gate callers. Also covers the task-5 registration rule: only
//! SPECIFIED functions (a requires/ensures/decreases/assumed clause)
//! join the verify task set.
//!
//! Gates:
//!  - SIGNATURE errors (assumed() with an argument / without contracts)
//!    fail at load — no solver needed, those tests always run.
//!  - The outcome/refutation tests need real Z3: gated on YO_TEST_Z3=1,
//!    exactly like tests/internal/verifier_negative.test.yo.
{ String, StringBuilder } :: import("std/string");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
{ env } :: import("std/env");
{
  mm_load_file,
  mm_preload_prelude,
  mm_resolve_entry_abs,
  resolve_std_path,
  _take_load_error
} :: import("../../src/module_manager.yo");
{ clear_module_cache } :: import("../../src/evaluator/module_loader.yo");
{
  set_verify_mode_override,
  set_verify_target_paths,
  take_verify_tasks
} :: import("../../src/evaluator/builtins/contracts.yo");
{
  default_verify_run_config,
  resolve_solver_sync,
  verify_and_strip_tasks,
  VerifyFnReport
} :: import("../../src/verifier/driver.yo");

_have_z3 :: (fn() -> bool)(
  match(
    env.get(String.from("YO_TEST_Z3")),
    .Some(v) => (v == String.from("1")),
    .None => false
  )
);
_load_reports :: (
  fn(rel_path : String, io : Io, expect_ok : bool) -> ArrayList(VerifyFnReport)
)({
  exn := Exception(
    throw : (
      err -> {
        assert(false, `verifier_assumed: unexpected throw: ${err}`);
      }
    )
  );
  std_path := resolve_std_path();
  targets := ArrayList(String).new();
  targets.push(rel_path.clone());
  targets.push(mm_resolve_entry_abs(rel_path.clone(), std_path.clone()));
  _ := take_verify_tasks();
  set_verify_mode_override(Option(String).None);
  set_verify_target_paths(targets);
  clear_module_cache();
  mm_preload_prelude(std_path.clone(), true, io, exn);
  outcome := mm_load_file(rel_path.clone(), std_path.clone(), true, io, exn);
  match(
    _take_load_error(),
    .Some(rendered) => {
      assert(
        outcome.ok == expect_ok,
        `fixture ${rel_path} load ok=${outcome.ok.to_string()} (expected ${expect_ok.to_string()}): ${rendered}`
      );
    },
    .None => {
      assert(outcome.ok == expect_ok, `fixture ${rel_path} load ok=${outcome.ok.to_string()}`);
    }
  );
  cfg := default_verify_run_config();
  binary := match(
    resolve_solver_sync(cfg),
    .Resolved(p) => p,
    _ => String.new()
  );
  verify_and_strip_tasks(cfg, binary, take_verify_tasks())
});
/// The rendered load diagnostic for a fixture that must FAIL to load.
_load_error :: (fn(rel_path : String, io : Io) -> String)({
  exn := Exception(
    throw : (
      err -> {
        assert(false, `verifier_assumed: unexpected throw: ${err}`);
      }
    )
  );
  std_path := resolve_std_path();
  targets := ArrayList(String).new();
  targets.push(rel_path.clone());
  targets.push(mm_resolve_entry_abs(rel_path.clone(), std_path.clone()));
  _ := take_verify_tasks();
  set_verify_mode_override(Option(String).None);
  set_verify_target_paths(targets);
  clear_module_cache();
  mm_preload_prelude(std_path.clone(), true, io, exn);
  outcome := mm_load_file(rel_path.clone(), std_path.clone(), true, io, exn);
  assert(!outcome.ok, `fixture ${rel_path} must fail to load`);
  match(
    _take_load_error(),
    .Some(rendered) => rendered,
    .None => String.from("(no diagnostic recorded)")
  )
});
_reports_dump :: (fn(reports : ArrayList(VerifyFnReport)) -> String)({
  ids := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => {
        ids.push(`${rp.fn_id}=${rp.outcome} [${rp.subset_construct}]`);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  sb := StringBuilder.new();
  (j : usize) = usize(0);
  while(j < ids.len(), {
    if(j > usize(0), {
      sb.write_string(String.from(", "));
    });
    sb.write_string(ids.get(j).unwrap().clone());
    j = (j + usize(1));
  });
  sb.to_string()
});
_count_outcome :: (fn(reports : ArrayList(VerifyFnReport), outcome : String) -> usize)({
  (n : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => {
        if(rp.outcome == outcome, {
          n = (n + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  n
});
/// The first report with the given outcome whose subset_construct or an
/// obligation counter-example contains `needle`; asserts it exists.
_first_refuted_with :: (
  fn(reports : ArrayList(VerifyFnReport), name_needle : String, ce_needle : String) -> VerifyFnReport
)({
  found := Option(VerifyFnReport).None;
  (i : usize) = usize(0);
  while((i < reports.len()) && found.is_none(), {
    match(
      reports.get(i),
      .Some(rp) => {
        if(rp.outcome == "refuted", {
          (j : usize) = usize(0);
          while((j < rp.obligations.len()) && found.is_none(), {
            match(
              rp.obligations.get(j),
              .Some(obl) => {
                match(
                  obl.verdict,
                  .Refuted(ce) => {
                    if(obl.name.contains(name_needle.clone()), {
                      (k : usize) = usize(0);
                      while(k < ce.len(), {
                        match(
                          ce.get(k),
                          .Some(pair) => {
                            if(pair.contains(ce_needle.clone()), {
                              found = Option(VerifyFnReport).Some(rp);
                            });
                          },
                          .None => ()
                        );
                        k = (k + usize(1));
                      });
                    });
                  },
                  _ => ()
                );
              },
              .None => ()
            );
            j = (j + usize(1));
          });
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  match(
    found,
    .Some(rp) => rp,
    .None => {
      assert(false, `no refuted report with obligation '${name_needle}' and '${ce_needle}' in: [${_reports_dump(reports)}]`);
      reports.get(usize(0)).unwrap()
    }
  )
});

test("an assumed fn reports assumed and its caller proves through the assumed contracts", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/assumed_body.yo"),
    io,
    true
  );
  // opaque_inc (uncontracted, in-subset body) registers too and walks
  // clean — the AoRTE flagship: unannotated code is still checked.
  assert(
    reports.len() == usize(3),
    `all three functions report, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("assumed")) == usize(1),
    `assumed_double must report assumed, got: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("ok")) == usize(2),
    `caller_ok must prove through the assumed contracts (and opaque_inc walks clean), got: [${_reports_dump(reports)}]`
  );
});

test("an assumed callee's requires still gates callers (the body is skipped, never the call-site obligation)", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/negative/assumed_caller_violates.yo"),
    io,
    true
  );
  assert(
    _count_outcome(reports, String.from("assumed")) == usize(1),
    `assumed_pos must report assumed (not walked, not refuted), got: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("refuted")) == usize(1),
    `bad_caller must refute the undischarged requires, got: [${_reports_dump(reports)}]`
  );
  rp := _first_refuted_with(reports, String.from("requires#"), String.from("x = "));
  assert(rp.outcome == "refuted", `the counter-example must name the caller's x`);
});

test("assumed() with an argument is a signature error (no solver needed)", {
  rendered := _load_error(String.from("./tests/spec/fixtures/negative/assumed_with_arg.yo"), io);
  assert(
    rendered.contains(String.from("'assumed()' takes no arguments")),
    `the diagnostic must name the zero-argument rule, got: ${rendered}`
  );
});

test("assumed() without any contract clause is a signature error (no solver needed)", {
  rendered := _load_error(String.from("./tests/spec/fixtures/negative/assumed_naked.yo"), io);
  assert(
    rendered.contains(String.from("'assumed()' without any contract clause")),
    `the diagnostic must name the missing-contract rule, got: ${rendered}`
  );
});

test("an uncontracted fn whose body fails the subset degrades to the passing outside-subset outcome (no solver needed)", {
  reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/uncontracted_outside_subset.yo"),
    io,
    true
  );
  assert(
    reports.len() == usize(1),
    `exactly one function reports, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`
  );
  rp := match(
    reports.get(usize(0)),
    .Some(r0) => r0,
    .None => {
      assert(false, "unreachable");
      return(());
    }
  );
  assert(
    rp.outcome == "outside-subset",
    `plain_read (contract-less, field-read body) must degrade to outside-subset, got: [${_reports_dump(reports)}]`
  );
  assert(
    rp.subset_construct.len() > usize(0),
    `the degraded report keeps the subset construct as its note, got: '${rp.subset_construct}'`
  );
});
