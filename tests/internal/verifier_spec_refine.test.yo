//! The std/spec rework tests — V6 task 3 (plans/backlog/FORMAL_VERIFICATION.md
//! §7, ledger entry 3): the `std/spec` aliases become REAL refinement types
//! via ghost predicates spelled inside the alias bodies (the alias's
//! comptime parameters in scope at ghost creation — every `Family(i32)`
//! evaluation creates a fully concrete predicate), with composition (a
//! nested-refinement chain acting as the conjunction), the value-parameter
//! wrapper `Refine(T, p)`, and the `.check`/`.unchecked` entry paths.
//!
//! Loaded and verified through the in-process harness (the tree evaluator),
//! which is the path that sees tree-side `refine` dispatch. The seed-path
//! (`yo test`-evaluated) runtime behavior test rides the v0.2.36 seed.
//!
//! Gates:
//!  - The HERMETIC layer (runtime-mode erasure) needs no solver.
//!  - The proof layer needs real Z3: gated on YO_TEST_Z3=1, exactly like
//!    the other verifier tests.
{ String, StringBuilder } :: import("std/string");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
{ env } :: import("std/env");
{
  mm_load_file,
  mm_preload_prelude,
  mm_resolve_entry_abs,
  resolve_std_path,
  _take_load_error
} :: import("../../src/module_manager.yo");
{ clear_module_cache } :: import("../../src/evaluator/module_loader.yo");
{
  set_verify_mode_override,
  set_verify_target_paths,
  take_verify_tasks
} :: import("../../src/evaluator/builtins/contracts.yo");
{
  default_verify_run_config,
  resolve_solver_sync,
  verify_and_strip_tasks,
  VerifyFnReport
} :: import("../../src/verifier/driver.yo");

_have_z3 :: (fn() -> bool)(
  match(
    env.get(String.from("YO_TEST_Z3")),
    .Some(v) => (v == String.from("1")),
    .None => false
  )
);
_load_reports :: (
  fn(rel_path : String, io : Io, expect_ok : bool) -> ArrayList(VerifyFnReport)
)({
  exn := Exception(
    throw : (
      err -> {
        assert(false, `verifier_spec_refine: unexpected throw: ${err}`);
      }
    )
  );
  std_path := resolve_std_path();
  targets := ArrayList(String).new();
  targets.push(rel_path.clone());
  targets.push(mm_resolve_entry_abs(rel_path.clone(), std_path.clone()));
  _ := take_verify_tasks();
  set_verify_mode_override(Option(String).None);
  set_verify_target_paths(targets);
  clear_module_cache();
  mm_preload_prelude(std_path.clone(), true, io, exn);
  outcome := mm_load_file(rel_path.clone(), std_path.clone(), true, io, exn);
  match(
    _take_load_error(),
    .Some(rendered) => {
      assert(
        outcome.ok == expect_ok,
        `fixture ${rel_path} load ok=${outcome.ok.to_string()} (expected ${expect_ok.to_string()}): ${rendered}`
      );
    },
    .None => {
      assert(outcome.ok == expect_ok, `fixture ${rel_path} load ok=${outcome.ok.to_string()}`);
    }
  );
  cfg := default_verify_run_config();
  binary := match(
    resolve_solver_sync(cfg),
    .Resolved(p) => p,
    _ => String.new()
  );
  verify_and_strip_tasks(cfg, binary, take_verify_tasks())
});
_reports_dump :: (fn(reports : ArrayList(VerifyFnReport)) -> String)({
  ids := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => {
        ids.push(`${rp.fn_id}=${rp.outcome} [${rp.subset_construct}]`);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  sb := StringBuilder.new();
  (j : usize) = usize(0);
  while(j < ids.len(), {
    if(j > usize(0), {
      sb.write_string(String.from(", "));
    });
    sb.write_string(ids.get(j).unwrap().clone());
    j = (j + usize(1));
  });
  sb.to_string()
});
_count_outcome :: (fn(reports : ArrayList(VerifyFnReport), outcome : String) -> usize)({
  (n : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => {
        if(rp.outcome == outcome, {
          n = (n + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  n
});

// ---------------------------------------------------------------------------
// Hermetic layer — runtime-mode erasure: the alias-created refinements in a
// file without a verify pragma load, compute and register NOTHING.
// ---------------------------------------------------------------------------
test("spec aliases in runtime mode: the module loads unchanged and registers no verify tasks", {
  reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/spec_alias_runtime.yo"),
    io,
    true
  );
  assert(
    reports.len() == usize(0),
    `runtime mode must register no verify tasks, got ${reports.len().to_string()}`
  );
});

// ---------------------------------------------------------------------------
// Proof layer — the reworked alias families prove end-to-end (real Z3).
// ---------------------------------------------------------------------------
test("alias-created refinements prove: composition chain, Bounded capture, wrapper, check/unchecked", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/spec_alias_generic.yo"),
    io,
    true
  );
  // 11 fns report: the ghost predicate bodies, use_dbl (the composition
  // chain's inner nonzero leg discharges the divisor obligation), use_band
  // + band_caller (the captured [0,100] bound proves at the caller's
  // refine#1), use_wrapped (the comptime value-parameter wrapper),
  // nz_check/nz_unchecked (the entry paths) and the alias-created
  // predicate fns. Everything must be a passing outcome: ok, or the
  // contract-less outside-subset degrade (nz_check's Option construction
  // is outside the V3 subset).
  assert(
    reports.len() == usize(11),
    `all eleven functions report, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`
  );
  assert(
    (_count_outcome(reports, String.from("ok")) == usize(10)) && (_count_outcome(reports, String.from("outside-subset")) == usize(1)) && (_count_outcome(reports, String.from("refuted")) == usize(0)),
    `every outcome must pass (10 ok + 1 outside-subset degrade, 0 refuted): [${_reports_dump(reports)}]`
  );
});

test("the negative twins refute: single even refinement does not discharge a division; unconstrained band caller", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/negative/spec_alias_negative.yo"),
    io,
    true
  );
  assert(
    reports.len() == usize(5),
    `all five functions report, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("refuted")) == usize(2),
    `use_even (zero IS even — the single-leg refinement must NOT discharge a division) and band_caller_bad (nothing bounds v into the band) must refute: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("ok")) == usize(3),
    `the predicate fns and use_band stay ok (modular): [${_reports_dump(reports)}]`
  );
});
