open(import("std/string"));
open(import("std/fmt"));
{ assert, panic } :: import("std/assert");
{
  get_global_cache_dir,
  get_global_deps_cache_dir,
  get_global_versions_cache_dir,
  get_version_cache_dir
} :: import("../../src/cache.yo");
// ---------------------------------------------------------------------------
// get_global_deps_cache_dir and get_global_versions_cache_dir
// ---------------------------------------------------------------------------
test("get_global_deps_cache_dir: ends with /deps", {
  d := get_global_deps_cache_dir();
  assert(d.ends_with(String.from("/deps")), "deps cache ends with /deps");
});
test("get_global_versions_cache_dir: ends with /versions", {
  d := get_global_versions_cache_dir();
  assert(d.ends_with(String.from("/versions")), "versions cache ends with /versions");
});
// ---------------------------------------------------------------------------
// get_version_cache_dir
// ---------------------------------------------------------------------------
test("get_version_cache_dir: appends version segment", {
  d := get_version_cache_dir(String.from("0.1.23"));
  assert(d.ends_with(String.from("/versions/0.1.23")), "version dir ends with /versions/0.1.23");
});
// ---------------------------------------------------------------------------
// get_global_cache_dir: basic sanity
// ---------------------------------------------------------------------------
test("get_global_cache_dir: returns non-empty string", {
  d := get_global_cache_dir();
  assert(d.len() > usize(0), "cache dir is non-empty");
});
// ---------------------------------------------------------------------------
// Consistency: deps and versions are children of cache root
// ---------------------------------------------------------------------------
test("get_global_deps_cache_dir: is under cache root", {
  root := get_global_cache_dir();
  deps := get_global_deps_cache_dir();
  assert(deps.starts_with(root), "deps dir is under cache root");
});
test("get_global_versions_cache_dir: is under cache root", {
  root := get_global_cache_dir();
  vers := get_global_versions_cache_dir();
  assert(vers.starts_with(root), "versions dir is under cache root");
});
