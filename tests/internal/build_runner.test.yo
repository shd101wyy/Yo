/// Tests for `src/build_runner.yo`'s DAG builder and cycle detector —
/// ports of the `buildDAG` / `detectCycle` describes of
/// `src/tests/build-system.test.ts` (P2.4). These are the only direct tests
/// of the scheduler logic; the build cli-cases exercise it end-to-end but
/// never pin the DAG shape. Note `detect_cycle` returns the cycle NODE NAME
/// (`Option(String)`) where TS returns the cycle path array — asserts are
/// presence/absence, matching the TS assertions' substance.
pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Emscripten); // no process model in WASM
pragma(Pragma.SkipWasm32Wasi); // no process model in WASM
{ String } :: import("std/string");
import("std/fmt");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ assert, panic } :: import("std/assert");
{ DAGNode, DAGNodeKind, build_dag, detect_cycle, artifact_input_stamp, set_compiler_identity, optimize_level_for, level_wants_debug_symbols, _resolve_c_compiler } :: import("../../src/build_runner.yo");
{ IoExn } :: import("std/error");
{ Path } :: import("std/path");
{ create_dir_all } :: import("std/fs/dir");
{ write_string, copy } :: import("std/fs/file");
{ args, env, cwd } :: import("std/env");
{ platform, Platform } :: import("std/process");
{ exit } :: import("std/libc/stdlib");
{ BuildRegistry, BuildArtifact, ArtifactKind, BuildVerifyConfig, ResolvedDep } :: import("../../src/evaluator/builtins/build.yo");
_mk_artifact :: (fn(kind : ArtifactKind, name : &String, root : &String) -> BuildArtifact)(
  BuildArtifact(
    kind : kind,
    name : name,
    root : root,
    target : String.from(""),
    optimize : String.from(""),
    allocator : String.from(""),
    heap_size : usize(0),
    cycle_collector : String.from("auto"),
    sanitize : String.from(""),
    emit_c_to : String.from(""),
    emit_chunks : usize(0),
    link_libraries : ArrayList(String).new(),
    include_paths : ArrayList(String).new(),
    library_paths : ArrayList(String).new(),
    c_sources : ArrayList(String).new(),
    c_flags : ArrayList(String).new(),
    defines : ArrayList(String).new(),
    strip : false,
    static_link : false,
    linked_artifacts : ArrayList(String).new(),
    linked_system_libs : ArrayList(String).new(),
    package_dir : String.from(""),
    package_name : String.from("")
  )
);
_dag_find :: (fn(dag : &ArrayList(DAGNode), name : &String) -> Option(DAGNode))({
  (mut(i) : usize) = usize(0);
  while(i < dag.len(), {
    node := dag(i);
    if(node.name == name, {
      return(Option(DAGNode).Some(node));
    });
    i = (i + usize(1));
  });
  Option(DAGNode).None
});
_deps_contain :: (fn(node : &DAGNode, dep : &String) -> bool)({
  (mut(i) : usize) = usize(0);
  while(i < node.depends_on.len(), {
    if(node.depends_on(i) == dep, {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
_mk_node :: (fn(name : &String, deps : &ArrayList(String)) -> DAGNode)(
  DAGNode(name : name, kind : DAGNodeKind.Artifact, depends_on : deps)
);
_deps1 :: (fn(a : &String) -> ArrayList(String))({
  l := ArrayList(String).new();
  l.push(a);
  l
});
/// Drive `_resolve_c_compiler`'s default (no explicit `--cc`) expecting the
/// no-compiler error: effect handlers are capture-free
/// (docs/en-US/ALGEBRAIC_EFFECTS.md), so the handler cannot record into an
/// outer variable — it UNWINDS past this helper with the error string, which
/// becomes the helper's result (the loud handlers in the test below unwind
/// unit for the same reason).
_resolve_default_or_error :: (fn(io : Io) -> Result(String, String))({
  catch_exn := Exception(
    throw : (
      err -> unwind(Result(String, String).Err(err.to_string()))
    )
  );
  Result(String, String).Ok(_resolve_c_compiler(&Option(String).None, io, catch_exn))
});
test("build_dag: empty step produces a single-node DAG", {
  // The registries' duplicate-name checks take an Exception; a test that is
  // not exercising them wants one that fails loudly.
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  reg.register_step(String.from("install"), String.from("Build all"), exn);
  dag := build_dag(&reg, String.from("install"));
  assert(dag.len() == usize(1), "root step only");
  node := dag(usize(0));
  assert(node.name == `install`, "root name");
  assert(node.depends_on.len() == usize(0), "no deps");
});
test("register_executable carries the fixed-allocator heap size", {
  // plans/reference/FIXED_REGION_ALLOCATOR.md P2: heap_size rides the artifact
  // next to the allocator string; a missed copy in a register_* site would
  // silently build `fixed` with the default region. The end-to-end path
  // (build.yo -> --heap-size argv -> compile) is pinned by the
  // compile-allocator-fixed cli-case.
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  a := _mk_artifact(ArtifactKind.Executable, String.from("app"), String.from("./src/main.yo"));
  a.allocator = String.from("fixed");
  a.heap_size = usize(65536);
  reg.register_executable(&a, exn);
  got := reg.artifacts(usize(0));
  assert(got.heap_size == usize(65536), "heap_size is copied on registration");
  assert(got.allocator == `fixed`, "allocator is copied on registration");
});
test("register_executable carries the cycle-collector mode", {
  // plans/backlog/WEAK_AND_UNCOLLECTED_RC.md §1: `build.cycle_collector` rides
  // the artifact like heap_size; a missed copy would build `off` as `auto`.
  // The build.yo -> --cycle-collector argv path is pinned by the
  // build-cycle-collector-off cli-case.
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  a := _mk_artifact(ArtifactKind.Executable, String.from("app"), String.from("./src/main.yo"));
  a.cycle_collector = String.from("off");
  reg.register_executable(&a, exn);
  got := reg.artifacts(usize(0));
  assert(got.cycle_collector == `off`, "cycle_collector is copied on registration");
});
test("child compile flags: the four levels map to four distinct --optimize values", {
  /// issues/fixed/build-release-small-is-identical-to-release-safe.md: release-small
  /// used to map to "2" as well, so a ReleaseSmall build was byte-identical to
  /// a ReleaseSafe one — same child argv, same emitted C, even a build-cache
  /// HIT on the flip. It maps to `s` (-Os, which clang, gcc, zig cc and emcc
  /// all accept), so the advertised size mode exists, and `yo compile
  /// --optimize s` accepts the same level.
  assert(optimize_level_for(String.from("release-small")) == `s`, "release-small is -Os");
  assert(
    !(optimize_level_for(String.from("release-small")) == optimize_level_for(String.from("release-safe"))),
    "release-small must not repeat release-safe's level"
  );
  assert(optimize_level_for(String.from("release-safe")) == `2`, "release-safe is -O2");
  assert(optimize_level_for(String.from("release-fast")) == `3`, "release-fast is -O3");
  assert(optimize_level_for(String.from("debug")).len() == usize(0), "debug passes no --optimize (the -O0 default)");
});
test("child compile flags: Debug forwards --debug-symbols, the release levels do not", {
  /// Debug's documented build is `-O0 -g` ("full debug info"), and a build
  /// file has no other flag that reaches the child compile's -g, so Debug
  /// forwards --debug-symbols here. The release levels document no -g and
  /// stay lean.
  assert(level_wants_debug_symbols(String.from("debug")), "Debug builds with debug info");
  assert(!level_wants_debug_symbols(String.from("release-safe")), "release-safe stays lean");
  assert(!level_wants_debug_symbols(String.from("release-fast")), "release-fast stays lean");
  assert(!level_wants_debug_symbols(String.from("release-small")), "release-small stays lean");
});
test("build_dag: step with artifact dependencies", {
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  reg.register_executable(_mk_artifact(ArtifactKind.Executable, String.from("app"), String.from("./src/main.yo")), exn);
  reg.register_static_library(_mk_artifact(ArtifactKind.StaticLibrary, String.from("lib-a"), String.from("./src/a.yo")), exn);
  reg.register_step(String.from("install"), String.from("Build all"), exn);
  reg.add_step_dependency(String.from("install"), String.from("app"));
  reg.add_step_dependency(String.from("install"), String.from("lib-a"));
  dag := build_dag(&reg, String.from("install"));
  assert(dag.len() == usize(3), "install, app, lib-a");
  assert(_dag_find(&dag, String.from("app")).is_some(), "app present");
  assert(_dag_find(&dag, String.from("lib-a")).is_some(), "lib-a present");
});
test("build_dag: linked artifacts create edges", {
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  reg.register_executable(_mk_artifact(ArtifactKind.Executable, String.from("app"), String.from("./src/main.yo")), exn);
  reg.register_static_library(_mk_artifact(ArtifactKind.StaticLibrary, String.from("mylib"), String.from("./src/lib.yo")), exn);
  reg.register_link(String.from("app"), String.from("mylib"));
  reg.register_step(String.from("install"), String.from("Build all"), exn);
  reg.add_step_dependency(String.from("install"), String.from("app"));
  dag := build_dag(&reg, String.from("install"));
  match(
    _dag_find(&dag, String.from("app")),
    .Some(app_node) => assert(_deps_contain(&app_node, String.from("mylib")), "app depends on mylib"),
    .None => assert(false, "app node missing")
  );
});
test("build_dag: run step depends on its artifact", {
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  reg.register_executable(_mk_artifact(ArtifactKind.Executable, String.from("app"), String.from("./src/main.yo")), exn);
  reg.register_run(String.from("app"), ArrayList(String).new());
  reg.register_step(String.from("run"), String.from("Run the app"), exn);
  reg.add_step_dependency(String.from("run"), String.from("run:app"));
  dag := build_dag(&reg, String.from("run"));
  match(
    _dag_find(&dag, String.from("run:app")),
    .Some(run_node) => {
      assert(match(run_node.kind, .Run => true, _ => false), "kind is Run");
      assert(_deps_contain(&run_node, String.from("app")), "run:app depends on app");
    },
    .None => assert(false, "run:app node missing")
  );
});
test("build_dag: a verify step is a leaf Verify node a step can depend on", {
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  reg.register_verify(BuildVerifyConfig(name : String.from("proofs"), root : String.from("./src"), mode : String.from("verify+"), strict : true), exn);
  reg.register_step(String.from("install"), String.from("Build all"), exn);
  reg.add_step_dependency(String.from("install"), String.from("proofs"));
  match(
    reg.resolve_dependency(String.from("proofs")),
    .Some(dep) => match(
      dep,
      .Verify(v) => {
        assert(v.mode == `verify+`, "mode travels");
        assert(v.strict, "strict travels");
      },
      _ => assert(false, "resolves as a verify step")
    ),
    .None => assert(false, "registered")
  );
  dag := build_dag(&reg, String.from("install"));
  assert(dag.len() == usize(2), "verify node plus the step");
  (mut(found) : bool) = false;
  (mut(i) : usize) = usize(0);
  while(i < dag.len(), {
    node := dag(i);
    if(node.name == `proofs`, {
      found = true;
      assert(match(node.kind, .Verify => true, _ => false), "Verify kind");
      assert(node.depends_on.len() == usize(0), "a verify step is a leaf");
    });
    i = (i + usize(1));
  });
  assert(found, "verify node present");
});
/// Returns true iff registering a verify step named `name` on `reg` throws
/// (handlers are capture-free, so the outcome rides on `unwind`).
_register_verify_throws :: (fn(reg : &BuildRegistry, name : &String) -> bool)({
  exn := Exception(
    throw : (
      _err -> {
        unwind(true);
      }
    )
  );
  reg.register_verify(BuildVerifyConfig(name : name.clone(), root : String.from("./src"), mode : String.from("verify"), strict : false), exn);
  false
});
test("register_verify: the one build namespace rejects a reused name", {
  quiet := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  reg.register_step(String.from("verify"), String.from("A custom step"), quiet);
  assert(_register_verify_throws(&reg, String.from("verify")), "a verify step cannot reuse a step's name");
  assert(!_register_verify_throws(&reg, String.from("proofs")), "a fresh name registers");
});
test("build_dag: nested steps are walked transitively", {
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  reg.register_executable(_mk_artifact(ArtifactKind.Executable, String.from("app"), String.from("./src/main.yo")), exn);
  reg.register_step(String.from("compile"), String.from("Compile step"), exn);
  reg.add_step_dependency(String.from("compile"), String.from("app"));
  reg.register_step(String.from("install"), String.from("Install step"), exn);
  reg.add_step_dependency(String.from("install"), String.from("compile"));
  dag := build_dag(&reg, String.from("install"));
  assert(dag.len() == usize(3), "install, compile, app");
  match(
    _dag_find(&dag, String.from("install")),
    .Some(install_node) => assert(_deps_contain(&install_node, String.from("compile")), "install depends on compile"),
    .None => assert(false, "install node missing")
  );
});
test("build_dag: deduplicates shared dependencies", {
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "unexpected registry error");
        unwind(());
      }
    )
  );
  reg := BuildRegistry.new();
  reg.register_static_library(_mk_artifact(ArtifactKind.StaticLibrary, String.from("common"), String.from("./src/common.yo")), exn);
  reg.register_executable(_mk_artifact(ArtifactKind.Executable, String.from("app-a"), String.from("./src/a.yo")), exn);
  reg.register_executable(_mk_artifact(ArtifactKind.Executable, String.from("app-b"), String.from("./src/b.yo")), exn);
  reg.register_link(String.from("app-a"), String.from("common"));
  reg.register_link(String.from("app-b"), String.from("common"));
  reg.register_step(String.from("install"), String.from("Build all"), exn);
  reg.add_step_dependency(String.from("install"), String.from("app-a"));
  reg.add_step_dependency(String.from("install"), String.from("app-b"));
  dag := build_dag(&reg, String.from("install"));
  (mut(common_count) : usize) = usize(0);
  (mut(i) : usize) = usize(0);
  while(i < dag.len(), {
    node := dag(i);
    if(node.name == `common`, {
      common_count = (common_count + usize(1));
    });
    i = (i + usize(1));
  });
  assert(common_count == usize(1), "common appears exactly once");
});
test("detect_cycle: no cycle returns None", {
  dag := ArrayList(DAGNode).new();
  dag.push(_mk_node(String.from("a"), ArrayList(String).new()));
  dag.push(_mk_node(String.from("b"), _deps1(String.from("a"))));
  dag.push(_mk_node(String.from("c"), _deps1(String.from("b"))));
  assert(detect_cycle(&dag).is_none(), "acyclic DAG");
});
test("detect_cycle: direct cycle is detected", {
  dag := ArrayList(DAGNode).new();
  dag.push(_mk_node(String.from("a"), _deps1(String.from("b"))));
  dag.push(_mk_node(String.from("b"), _deps1(String.from("a"))));
  assert(detect_cycle(&dag).is_some(), "a <-> b cycle");
});
test("detect_cycle: indirect cycle is detected", {
  dag := ArrayList(DAGNode).new();
  dag.push(_mk_node(String.from("a"), _deps1(String.from("b"))));
  dag.push(_mk_node(String.from("b"), _deps1(String.from("c"))));
  dag.push(_mk_node(String.from("c"), _deps1(String.from("a"))));
  assert(detect_cycle(&dag).is_some(), "a -> b -> c -> a cycle");
});
test("detect_cycle: a dangling dependency does not hide the cycle after it", {
  // The plan's B12: `_dfs_cycle` skipped a dependency that is not a node by
  // bumping the loop counter and FALLING THROUGH, which bumped it a second
  // time — so the dependency AFTER the dangling one was never examined. Here
  // that is the cycle partner, so the cycle went undetected.
  deps := ArrayList(String).new();
  deps.push(String.from("ghost"));
  deps.push(String.from("b"));
  dag := ArrayList(DAGNode).new();
  dag.push(_mk_node(String.from("a"), &deps));
  dag.push(_mk_node(String.from("b"), _deps1(String.from("a"))));
  assert(detect_cycle(&dag).is_some(), "a -> b -> a, behind a dangling name");
});
test("detect_cycle: self-loop is detected", {
  dag := ArrayList(DAGNode).new();
  dag.push(_mk_node(String.from("a"), _deps1(String.from("a"))));
  assert(detect_cycle(&dag).is_some(), "a -> a self-loop");
});

test("artifact stamp: a different compiler binary is a different stamp", {
  /// The stamp named the compiler only by CURRENT_YO_VERSION, which a
  /// self-built stage-1 shares with the seed that built it, so `yo build`
  /// with the second compiler served the first one's artifact
  /// (issues/fixed/yo-build-cache-ignores-which-compiler-built-the-artifact.md).
  /// The RECORD pass reads only the depfile, so the inputs here are fixed.
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_build_stamp_identity_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  depfile := `${dir}/app.deps`;
  io.await(write_string(Path.new(depfile.clone()), String.from("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef ./src/main.yo\n"), io), ioexn);
  argv := ArrayList(String).new();
  argv.push(String.from("compile"));
  argv.push(String.from("./src/main.yo"));
  set_compiler_identity(String.from("compiler-A"));
  a1 := io.await(artifact_input_stamp(argv.clone(), dir.clone(), depfile.clone(), true, true, ArrayList(String).new(), io), ioexn);
  set_compiler_identity(String.from("compiler-B"));
  b := io.await(artifact_input_stamp(argv.clone(), dir.clone(), depfile.clone(), true, true, ArrayList(String).new(), io), ioexn);
  set_compiler_identity(String.from("compiler-A"));
  a2 := io.await(artifact_input_stamp(argv.clone(), dir.clone(), depfile.clone(), true, true, ArrayList(String).new(), io), ioexn);
  assert(a1.len() > usize(0), "the record pass produced a stamp");
  assert(!(a1 == b), "a different compiler binary must not match the recorded stamp");
  assert(a1 == a2, "the same compiler and inputs reproduce the stamp");
});
test("the build's default C compiler is probed, not the literal clang", {
  // issues/fixed/2026-10-31-yo-build-defaults-to-clang-and-dies-on-clang-less-boxes.md:
  // `yo build` used to default ctx.c_compiler to the literal "clang" with no
  // availability probe — on a box whose PATH has cc but no clang the test
  // suite's child compile spawned a nonexistent binary and every run died
  // with a bare "file or directory not found". The default now goes through
  // the same discovery `yo compile` uses.
  //
  // The fake compilers are this batch binary itself re-exec'd
  // (YO_FAKE_BUILD_CC_MODE gates the child mode, which exits 0 — all a
  // `--version` availability probe checks), copied into a scratch dir under
  // compiler NAMES and reached by masking PATH to that dir, the pattern of
  // tests/internal/compile.test.yo. `copy` carries the exec bits along.
  match(
    env.get(`YO_FAKE_BUILD_CC_MODE`),
    .Some(_) => {
      // Child mode — a fake C compiler: the availability probe only checks
      // the exit status, so succeed without producing anything.
      unsafe(exit(int(0)));
    },
    .None => ()
  );
  // Parent mode — drive the default resolution against controlled PATHs.
  // The helper throws in statement position, so every handler here resumes
  // unit (the io awaits' handlers too): the loud handlers unwind unit out of
  // this test body; the expecting-failure call goes through
  // `_resolve_default_or_error`, whose handler unwinds past IT with the
  // error string.
  io_exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  loud_cc_exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected error while resolving the default cc: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  cwd_str := match(cwd(), .Ok(c) => c.to_string(), .Err(_) => String.from("."));
  // Arm the child gate AFTER this body's own check has run: every probe
  // child inherits it and exits at the gate instead of re-running the file.
  _svm := env.set(String.from("YO_FAKE_BUILD_CC_MODE"), String.from("1"));
  scratch := `/tmp/yo_build_cc_probe_fixture`;
  empty := `/tmp/yo_build_cc_probe_fixture_empty`;
  io.await(create_dir_all(Path.new(scratch.clone()), io), IoExn(io : io, exn : io_exn));
  io.await(create_dir_all(Path.new(empty.clone()), io), IoExn(io : io, exn : io_exn));
  self_argv := args();
  exe_suffix := if(platform == Platform.Windows, String.from(".exe"), String.new());
  // A `cc` but NO `clang`: the clang-less box the issue was filed from.
  io.await(
    copy(Path.new(&self_argv(usize(0))), Path.new(`${scratch}/cc${exe_suffix}`), io),
    IoExn(io : io, exn : io_exn)
  );
  cur_path := match(env.get(`PATH`), .Some(pv) => pv, .None => String.new());
  _sp := env.set(String.from("PATH"), scratch.clone());
  cc_only := _resolve_c_compiler(&Option(String).None, io, loud_cc_exn);
  // clang present again: the probe's first candidate must win over cc.
  io.await(
    copy(Path.new(&self_argv(usize(0))), Path.new(`${scratch}/clang${exe_suffix}`), io),
    IoExn(io : io, exn : io_exn)
  );
  clang_first := _resolve_c_compiler(&Option(String).None, io, loud_cc_exn);
  // An explicit --cc wins without probing: gcc is NOT on the masked PATH.
  explicit := _resolve_c_compiler(&Option(String).Some(String.from("gcc")), io, loud_cc_exn);
  // No compiler anywhere: the same named error `yo compile` raises, not a
  // bare ENOENT from the first child spawn.
  _sp2 := env.set(String.from("PATH"), empty.clone());
  no_cc := _resolve_default_or_error(io);
  _sp3 := env.set(String.from("PATH"), cur_path);
  assert(cc_only == `cc`, `a PATH with cc but no clang resolves cc, got "${cc_only}"`);
  assert(clang_first == `clang`, `clang wins when present, got "${clang_first}"`);
  assert(explicit == `gcc`, `an explicit --cc wins without probing, got "${explicit}"`);
  match(
    no_cc,
    .Err(msg) => assert(msg.contains(`No C compiler found`), `the error names the missing toolchain, got "${msg}"`),
    .Ok(found) => assert(false, `an empty toolchain must fail, resolved "${found}"`)
  );
});
