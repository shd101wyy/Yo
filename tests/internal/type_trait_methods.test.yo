//! Round-trip tests for the trait-method registry +
//! `get_type_trait_methods_by_name_from_env` in env.yo.
//!
//! The full impl-block evaluator-driven path (impl-block source →
//! `evaluate_module_value` → `register_type_trait_method`) is
//! covered by the end-to-end tests once `getReceiverMethodsByName…`
//! lands. These tests poke the registry primitives directly so
//! regressions in storage / lookup shape are caught in isolation.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue, TypeValueNode, FuncMeta, shared_list, no_types, no_labels, no_flags, no_levels } :: import("../../src/types/definitions.yo");
{ t_i32, t_comptime_int, t_comptime_float, t_comptime_string } :: import("../../src/types/creators.yo");
{ EvalValue } :: import("../../src/value.yo");
{ assert, panic } :: import("std/assert");
{ Exception, IoExn } :: import("std/error");
{ Path } :: import("std/path");
{ create_dir_all } :: import("std/fs/dir");
{ write_string } :: import("std/fs/file");
{ analyze_document, AnalyzeOutcome } :: import("../../src/lsp/diagnostics.yo");
{ mm_set_open_document, mm_forget_open_document, resolve_std_path } :: import("../../src/module_manager.yo");
{ generic_impl_binder_bound_counts } :: import("../../src/evaluator/values/impl.yo");
{
  Environment,
  add_where_clause_constraint_for_type_application,
  add_where_clause_constraint_to_env
} :: import("../../src/env.yo");
{
  get_type_trait_methods_by_name_from_env,
  get_receiver_methods_by_name_from_env
} :: import("../../src/env.yo");
{
  MethodEntry,
  register_type_trait_method,
  get_type_trait_methods_for_type,
  get_type_trait_methods_by_name,
  clear_type_trait_methods,
  type_id_or_empty
} :: import("../../src/evaluator/values/type_trait_methods.yo");
_synth_struct :: (fn(id : &String, name : &String) -> TypeValue)(
  rc(
    TypeValueNode.Struct(
      id : id.clone(),
      name : name.clone(),
      field_labels : no_labels(),
      field_types : no_types(),
      is_reference_semantics : false,
      is_atomic_rc : false,
      is_newtype : false,
      constructor_func_id : String.from(""),
      type_arguments : no_types(),
      is_source_namespace : false
    )
  )
);
_entry :: (fn(label : &String) -> MethodEntry)(
  MethodEntry(
    label : label.clone(),
    ty : t_i32(),
    value : Option(EvalValue).None,
    source_trait_id : String.from(""),
    needs_pointer_conversion : false,
    self_type : Option(TypeValue).None,
    owner : String.new()
  )
);
test("type_id_or_empty: extracts struct id", {
  s := _synth_struct(String.from("ty_a"), String.from("A"));
  id := type_id_or_empty(&s);
  assert(id == "ty_a", "expected struct id");
});
test("type_id_or_empty: synthetic id for primitive types", {
  // Primitives carry stable synthetic ids so `impl(unit, ...)` etc. can
  // register methods in the trait-methods registry.
  id := type_id_or_empty(rc(TypeValueNode.Unit));
  assert(id == "__yo_t_unit", "Unit has the synthetic unit id");
});
test("register + get_type_trait_methods_for_type: appends entries", {
  clear_type_trait_methods();
  register_type_trait_method(
    String.from("ty_b"),
    _entry(String.from("foo"))
  );
  register_type_trait_method(
    String.from("ty_b"),
    _entry(String.from("bar"))
  );
  list := get_type_trait_methods_for_type(String.from("ty_b"));
  assert(list.len() == usize(2), "two entries registered");
});
test("get_type_trait_methods_by_name: filters by label", {
  clear_type_trait_methods();
  register_type_trait_method(
    String.from("ty_c"),
    _entry(String.from("foo"))
  );
  register_type_trait_method(
    String.from("ty_c"),
    _entry(String.from("bar"))
  );
  register_type_trait_method(
    String.from("ty_c"),
    _entry(String.from("foo"))
  );
  foos := get_type_trait_methods_by_name(
    String.from("ty_c"),
    String.from("foo")
  );
  assert(foos.len() == usize(2), "two foos");
  bars := get_type_trait_methods_by_name(
    String.from("ty_c"),
    String.from("bar")
  );
  assert(bars.len() == usize(1), "one bar");
  none := get_type_trait_methods_by_name(
    String.from("ty_c"),
    String.from("baz")
  );
  assert(none.len() == usize(0), "no baz");
});
test("get_type_trait_methods_by_name_from_env: registry hit", {
  clear_type_trait_methods();
  s := _synth_struct(String.from("ty_d"), String.from("D"));
  register_type_trait_method(
    String.from("ty_d"),
    _entry(String.from("greet"))
  );
  env := Environment.new(rc(String.from("")));
  hits := get_type_trait_methods_by_name_from_env(
    &env,
    String.from("greet"),
    &s
  );
  assert(hits.len() == usize(1), "one greet method");
});
test("get_type_trait_methods_by_name_from_env: empty id short-circuits", {
  clear_type_trait_methods();
  env := Environment.new(rc(String.from("")));
  hits := get_type_trait_methods_by_name_from_env(
    &env,
    String.from("anything"),
    rc(TypeValueNode.Unit)
  );
  assert(hits.len() == usize(0), "no hits for Unit");
});
test("get_receiver_methods_by_name_from_env: direct receiver", {
  clear_type_trait_methods();
  s := _synth_struct(String.from("ty_recv"), String.from("R"));
  // `_entry` constructs a `MethodEntry` with `ty : t_i32()` (not
  // Func) — the receiver-methods filter only drops 0-arg `Func`
  // methods, so non-Func types pass through. That's enough to
  // exercise the lookup + filter path on the direct-receiver
  // branch.
  register_type_trait_method(
    String.from("ty_recv"),
    _entry(String.from("greet"))
  );
  env := Environment.new(rc(String.from("")));
  hits := get_receiver_methods_by_name_from_env(
    &env,
    String.from("greet"),
    &s,
    false
  );
  assert(hits.len() == usize(1), "one greet method on direct receiver");
});
test("get_receiver_methods_by_name_from_env: through pointer deref", {
  clear_type_trait_methods();
  s := _synth_struct(String.from("ty_pdr"), String.from("PD"));
  register_type_trait_method(
    String.from("ty_pdr"),
    _entry(String.from("foo"))
  );
  // Pointer to struct s.
  ptr_ty := rc(TypeValueNode.Pointer(s));
  env := Environment.new(rc(String.from("")));
  hits := get_receiver_methods_by_name_from_env(
    &env,
    String.from("foo"),
    &ptr_ty,
    false
  );
  assert(hits.len() == usize(1), "method found via ptr-deref");
});
test("get_receiver_methods_by_name_from_env: empty when nothing matches", {
  clear_type_trait_methods();
  s := _synth_struct(String.from("ty_none"), String.from("N"));
  env := Environment.new(rc(String.from("")));
  hits := get_receiver_methods_by_name_from_env(
    &env,
    String.from("missing"),
    &s,
    false
  );
  assert(hits.len() == usize(0), "no hits for unregistered method");
});
test("get_receiver_methods_by_name_from_env: comptime receiver does not crash", {
  // Numeric runtime types (i32/f64) don't carry an `id` in
  // yo-self's `TypeValue` variant set, so the comptime → runtime
  // retry path never finds anything to register against — but it
  // should still complete without throwing for each of the three
  // comptime literal shapes. The asserts pin the no-crash + zero
  // results contract that the larger evaluator will rely on.
  clear_type_trait_methods();
  env := Environment.new(rc(String.from("")));
  hits_int := get_receiver_methods_by_name_from_env(
    &env,
    String.from("anything"),
    t_comptime_int(),
    false
  );
  assert(hits_int.len() == usize(0), "no methods on comptime_int");
  hits_float := get_receiver_methods_by_name_from_env(
    &env,
    String.from("anything"),
    t_comptime_float(),
    false
  );
  assert(hits_float.len() == usize(0), "no methods on comptime_float");
  hits_str := get_receiver_methods_by_name_from_env(
    &env,
    String.from("anything"),
    t_comptime_string(),
    false
  );
  assert(hits_str.len() == usize(0), "no methods on comptime_str");
});
test("get_receiver_methods_by_name_from_env: SomeT with required trait", {
  clear_type_trait_methods();
  // Build a trait with one method: `greet : (fn(x : i32) -> i32)`.
  param_labels := ArrayList(String).new();
  param_labels.push(String.from("x"));
  param_types := ArrayList(TypeValue).new();
  param_types.push(t_i32());
  fn_ty := rc(
    TypeValueNode.Func(
      no_types(),
      shared_list(param_types),
      no_types(),
      no_types(),
      t_i32(),
      rc(
        FuncMeta(
          forall_labels : no_labels(),
          param_labels : shared_list(param_labels),
          implicit_labels : no_labels(),
          result_is_comptime_only : false,
          param_is_ref : no_flags(),
          param_is_owning : no_flags(),
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          extern_name : Option(String).None,
          is_control : false,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      no_types()
    )
  );
  trait_field_labels := ArrayList(String).new();
  trait_field_labels.push(String.from("greet"));
  trait_field_types := ArrayList(TypeValue).new();
  trait_field_types.push(fn_ty);
  greeter_trait := rc(
    TypeValueNode.TraitT(
      name : String.from("Greeter"),
      assoc_type_names : ArrayList(String).new(),
      field_labels : trait_field_labels,
      field_types : trait_field_types,
      id : String.from("trait_greeter"),
      is_concrete : Option(TypeValue).None,
      self_constraints : ArrayList(TypeValue).new(),
      neg_self_constraints : ArrayList(TypeValue).new(),
      assoc_constraint_labels : no_labels(),
      assoc_constraint_types : no_types()
    )
  );
  // SomeT requiring the Greeter trait.
  required_traits := ArrayList(TypeValue).new();
  required_traits.push(greeter_trait);
  required_levels := ArrayList(usize).new();
  required_levels.push(usize(0));
  some_t := rc(
    TypeValueNode.SomeT(
      id : String.from("st_t"),
      name : String.from("T"),
      frame_level : usize(0),
      parent_type : rc(TypeValueNode.TypeUni(usize(0))),
      required_trait_types : required_traits,
      required_trait_levels : required_levels,
      negative_trait_types : ArrayList(TypeValue).new(),
      negative_trait_levels : ArrayList(usize).new(),
      kind_function_type : Option(TypeValue).None,
      resolution : Option(TypeValue).None
    )
  );
  env := Environment.new(rc(String.from("")));
  hits := get_receiver_methods_by_name_from_env(
    &env,
    String.from("greet"),
    &some_t,
    false
  );
  assert(hits.len() == usize(1), "one greet method via SomeT required-trait walk");
  match(
    hits.get(usize(0)),
    .Some(m) =>
      assert(
        m.source_trait_id == String.from("trait_greeter"),
        "method carries the source trait id"
      ),
    .None => assert(false, "expected a method entry")
  );
});
