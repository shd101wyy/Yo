      m.source_trait_id == String.from("trait_greeter_dyn"),
      "method carries the source trait id"
    ),
    .None => assert(false, "expected a method entry")
  );
});
test("get_receiver_methods_by_name_from_env: TypeApplication HKT walk", {
  clear_type_trait_methods();
  // Synthetic `fn(x : i32) -> i32` for the trait method.
  param_labels := ArrayList(String).new();
  param_labels.push(String.from("x"));
  param_types := ArrayList(TypeValue).new();
  param_types.push(t_i32());
  fn_ty := rc(
    TypeValueNode.Func(
      no_types(),
      shared_list(param_types),
      no_types(),
      no_types(),
      t_i32(),
      rc(
        FuncMeta(
          forall_labels : no_labels(),
          param_labels : shared_list(param_labels),
          implicit_labels : no_labels(),
          result_is_comptime_only : false,
          param_is_ref : no_flags(),
          param_is_owning : no_flags(),
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          extern_name : Option(String).None,
          is_control : false,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      no_types()
    )
  );
  // Trait `Functor` with `fmap` method.
  trait_field_labels := ArrayList(String).new();
  trait_field_labels.push(String.from("fmap"));
  trait_field_types := ArrayList(TypeValue).new();
  trait_field_types.push(fn_ty);
  functor_trait := rc(
    TypeValueNode.TraitT(
      name : String.from("Functor"),
      assoc_type_names : ArrayList(String).new(),
      field_labels : trait_field_labels,
      field_types : trait_field_types,
      id : String.from("trait_functor"),
      is_concrete : Option(TypeValue).None,
      self_constraints : ArrayList(TypeValue).new(),
      neg_self_constraints : ArrayList(TypeValue).new(),
      assoc_constraint_labels : no_labels(),
      assoc_constraint_types : no_types()
    )
  );
  // SomeT constructor `F` and arg `A`.
  ctor_some_t := rc(
    TypeValueNode.SomeT(
      id : String.from("st_f"),
      name : String.from("F"),
      frame_level : usize(0),
      parent_type : rc(TypeValueNode.TypeUni(usize(0))),
      required_trait_types : ArrayList(TypeValue).new(),
      required_trait_levels : ArrayList(usize).new(),
      negative_trait_types : ArrayList(TypeValue).new(),
      negative_trait_levels : ArrayList(usize).new(),
      kind_function_type : Option(TypeValue).None,
      resolution : Option(TypeValue).None
    )
  );
  arg_some_t := rc(
    TypeValueNode.SomeT(
      id : String.from("st_a"),
      name : String.from("A"),
      frame_level : usize(0),
      parent_type : rc(TypeValueNode.TypeUni(usize(0))),
      required_trait_types : ArrayList(TypeValue).new(),
      required_trait_levels : ArrayList(usize).new(),
      negative_trait_types : ArrayList(TypeValue).new(),
      negative_trait_levels : ArrayList(usize).new(),
      kind_function_type : Option(TypeValue).None,
      resolution : Option(TypeValue).None
    )
  );
  args_list := ArrayList(TypeValue).new();
  args_list.push(arg_some_t);
  type_app := rc(
    TypeValueNode.TypeAppT(
      constructor : ctor_some_t,
      args : shared_list(args_list)
    )
  );
  // Push a frame so the where-clause-constraint setter has somewhere
  // to record the entry, then register the constraint
  // `F(A) <: Functor`.
  env := Environment.new(rc(String.from("")));
  add_where_clause_constraint_for_type_application(
    &env,
    &type_app,
    &functor_trait,
    false
  );
  hits := get_receiver_methods_by_name_from_env(
    &env,
    String.from("fmap"),
    &type_app,
    false
  );
  assert(hits.len() == usize(1), "one fmap method via TypeApp where-clause");
  match(
    hits.get(usize(0)),
    .Some(m) => assert(
      m.source_trait_id == String.from("trait_functor"),
      "method carries the source trait id"
    ),
    .None => assert(false, "expected a method entry")
  );
});
test("get_receiver_methods_by_name_from_env: infix call keeps *(Self)-first-param methods without ptr conversion", {
  clear_type_trait_methods();
  s := _synth_struct(String.from("ty_infix"), String.from("I"));
  // Build `+ : (fn(self : *(I), other : I) -> i32)` — a Self-as-ptr
  // first-param shape. Mirrors TS env.ts:1278: infix calls suppress
  // the auto-pointer-conversion MARKING but never drop the method —
  // pointer-receiver operators (`zp &+ zi`) match `*(T)` directly.
  param_labels := ArrayList(String).new();
  param_labels.push(String.from("self"));
  param_labels.push(String.from("other"));
  param_types := ArrayList(TypeValue).new();
  param_types.push(rc(TypeValueNode.Pointer(s)));
  param_types.push(s);
  fn_ty := rc(
    TypeValueNode.Func(
      no_types(),
      shared_list(param_types),
      no_types(),
      no_types(),
      t_i32(),
      rc(
        FuncMeta(
          forall_labels : no_labels(),
          param_labels : shared_list(param_labels),
          implicit_labels : no_labels(),
          result_is_comptime_only : false,
          param_is_ref : no_flags(),
          param_is_owning : no_flags(),
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          extern_name : Option(String).None,
          is_control : false,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      no_types()
    )
  );
  register_type_trait_method(
    String.from("ty_infix"),
    MethodEntry(
      label : String.from("+"),
      ty : fn_ty,
      value : Option(EvalValue).None,
      source_trait_id : String.from(""),
      needs_pointer_conversion : false,
      self_type : Option(TypeValue).None,
      owner : String.new()
    )
  );
  env := Environment.new(rc(String.from("")));
  // Non-infix call → keep the method.
  hits_normal := get_receiver_methods_by_name_from_env(
    &env,
    String.from("+"),
    &s,
    false
  );
  assert(hits_normal.len() == usize(1), "non-infix call keeps *(Self) method");
  // Infix call → keep the method, but without the conversion flag.
  hits_infix := get_receiver_methods_by_name_from_env(
    &env,
    String.from("+"),
    &s,
    true
  );
  assert(hits_infix.len() == usize(1), "infix call keeps *(Self) method");
  match(
    hits_infix.get(usize(0)),
    .Some(m) => assert(
      !m.needs_pointer_conversion,
      "infix call does not mark pointer conversion"
    ),
    .None => assert(false, "expected a method entry")
  );
});
test("get_receiver_methods_by_name_from_env: non-infix call sets needs_pointer_conversion", {
  clear_type_trait_methods();
  s := _synth_struct(String.from("ty_ptrconv"), String.from("P"));
  param_labels := ArrayList(String).new();
  param_labels.push(String.from("self"));
  param_types := ArrayList(TypeValue).new();
  param_types.push(rc(TypeValueNode.Pointer(s)));
  fn_ty := rc(
    TypeValueNode.Func(
      no_types(),
      shared_list(param_types),
      no_types(),
      no_types(),
      t_i32(),
      rc(
        FuncMeta(
          forall_labels : no_labels(),
          param_labels : shared_list(param_labels),
          implicit_labels : no_labels(),
          result_is_comptime_only : false,
          param_is_ref : no_flags(),
          param_is_owning : no_flags(),
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          extern_name : Option(String).None,
          is_control : false,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      no_types()
    )
  );
  register_type_trait_method(
    String.from("ty_ptrconv"),
    MethodEntry(
      label : String.from("incr"),
      ty : fn_ty,
      value : Option(EvalValue).None,
      source_trait_id : String.from(""),
      needs_pointer_conversion : false,
      self_type : Option(TypeValue).None,
      owner : String.new()
    )
  );
  env := Environment.new(rc(String.from("")));
  hits := get_receiver_methods_by_name_from_env(
    &env,
    String.from("incr"),
    &s,
    false
  );
  assert(hits.len() == usize(1), "one incr method via direct receiver");
  match(
    hits.get(usize(0)),
    .Some(m) =>
      assert(m.needs_pointer_conversion, "ptr-conversion flag set on non-infix *(T) method"),
    .None => assert(false, "expected a method entry")
  );
});
test("get_receiver_methods_by_name_from_env: env-frames compatible-SomeType scan", {
  clear_type_trait_methods();
  // Build `Greeter` trait with `greet : (fn(x : i32) -> i32)`.
  param_labels := ArrayList(String).new();
  param_labels.push(String.from("x"));
  param_types := ArrayList(TypeValue).new();
  param_types.push(t_i32());
  fn_ty := rc(
    TypeValueNode.Func(
      no_types(),
      shared_list(param_types),
      no_types(),
      no_types(),
      t_i32(),
      rc(
        FuncMeta(
          forall_labels : no_labels(),
          param_labels : shared_list(param_labels),
          implicit_labels : no_labels(),
          result_is_comptime_only : false,
          param_is_ref : no_flags(),
          param_is_owning : no_flags(),
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          extern_name : Option(String).None,
          is_control : false,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      no_types()
    )
  );
  trait_field_labels := ArrayList(String).new();
  trait_field_labels.push(String.from("greet"));
  trait_field_types := ArrayList(TypeValue).new();
  trait_field_types.push(fn_ty);
  greeter_trait := rc(
    TypeValueNode.TraitT(
      name : String.from("Greeter"),
      assoc_type_names : ArrayList(String).new(),
      field_labels : trait_field_labels,
      field_types : trait_field_types,
      id : String.from("trait_greeter_envscan"),
      is_concrete : Option(TypeValue).None,
      self_constraints : ArrayList(TypeValue).new(),
      neg_self_constraints : ArrayList(TypeValue).new(),
      assoc_constraint_labels : no_labels(),
      assoc_constraint_types : no_types()
    )
  );
  // Two SomeTypes sharing the SAME id — under
  // `are_types_compatible` they unify (SomeT compat = id
  // equality). A `where(_Self <: Greeter)` registered against
  // `_self_t` should still surface when the call site queries
  // `output_t` (same id, different name — like Output aliased
  // to _Self during overload resolution).
  _self_t := rc(
    TypeValueNode.SomeT(
      id : String.from("st_shared"),
      name : String.from("_Self"),
      frame_level : usize(0),
      parent_type : rc(TypeValueNode.TypeUni(usize(0))),
      required_trait_types : ArrayList(TypeValue).new(),
      required_trait_levels : ArrayList(usize).new(),
      negative_trait_types : ArrayList(TypeValue).new(),
      negative_trait_levels : ArrayList(usize).new(),
      kind_function_type : Option(TypeValue).None,
      resolution : Option(TypeValue).None
    )
  );
  output_t := rc(
    TypeValueNode.SomeT(
      id : String.from("st_shared"),
      name : String.from("Output"),
      frame_level : usize(0),
      parent_type : rc(TypeValueNode.TypeUni(usize(0))),
      required_trait_types : ArrayList(TypeValue).new(),
      required_trait_levels : ArrayList(usize).new(),
      negative_trait_types : ArrayList(TypeValue).new(),
      negative_trait_levels : ArrayList(usize).new(),
      kind_function_type : Option(TypeValue).None,
      resolution : Option(TypeValue).None
    )
  );
  env := Environment.new(rc(String.from("")));
  add_where_clause_constraint_to_env(&env, &_self_t, &greeter_trait, false);
  hits := get_receiver_methods_by_name_from_env(
    &env,
    String.from("greet"),
    &output_t,
    false
  );
  assert(
    hits.len() == usize(1),
    "env-frames scan finds method via compatible-SomeType match"
  );
  match(
    hits.get(usize(0)),
    .Some(m) => assert(
      m.source_trait_id == String.from("trait_greeter_envscan"),
      "method carries the source trait id"
    ),
    .None => assert(false, "expected a method entry")
  );
});
test("clear_type_trait_methods: wipes state", {
  register_type_trait_method(
    String.from("ty_e"),
    _entry(String.from("foo"))
  );
  clear_type_trait_methods();
  list := get_type_trait_methods_for_type(String.from("ty_e"));
  assert(list.len() == usize(0), "empty after clear");
});

// A where-bound restated on every method of a generic impl is ONE required
// trait of the impl's binder. Each `where(Kw <: Ord(Kw))` evaluates `Ord(Kw)`
// again, and with `Kw` a type variable that constructor call is not memoized,
// so every method minted a TraitT with a fresh id and the id-only dedup kept
// them all — `BTreeMap`'s `K` carried fifteen `Ord(K)`
// (issues/fixed/2026-10-15-a-generic-impls-type-variable-accumulates-one-copy-of-a-where-bound-per-method.md).
_WHERE_DOC :: "Wb :: (fn(comptime(Kw) : Type) -> comptime(Type))(struct(k : Kw));\nimpl(\n  generic(Kw : Type),\n  Wb(Kw),\n  lt : (fn(self : &Self, o : &Kw, where(Kw <: Ord(Kw))) -> bool)(self.k < o),\n  gt : (fn(self : &Self, o : &Kw, where(Kw <: Ord(Kw))) -> bool)(self.k > o),\n  le : (fn(self : &Self, o : &Kw, where(Kw <: Ord(Kw))) -> bool)(self.k <= o)\n);\nmain :: (fn() -> unit)({\n  w := Wb(i32)(k : i32(1));\n  _a := w.lt(&i32(2));\n});\nexport(main);\n";
test("a where-bound restated on each method of a generic impl is recorded once", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_where_bound_dedup_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  doc_path := `${dir}/where_doc.yo`;
  io.await(write_string(Path.new(doc_path.clone()), String.from(_WHERE_DOC), io), ioexn);
  std_path := resolve_std_path();
  mm_set_open_document(doc_path.clone(), String.from(_WHERE_DOC));
  out := ArrayList(AnalyzeOutcome).new();
  _diags := analyze_document(doc_path.clone(), String.from(_WHERE_DOC), std_path.clone(), io, &mut out);
  assert(match(out.get(usize(0)), .Some(oc) => oc.ok, .None => false), "the fixture analyzes clean");
  counts := generic_impl_binder_bound_counts(&String.from("Kw"));
  assert(counts.len() > usize(0), "the fixture's generic impl is registered");
  (mut(i) : usize) = usize(0);
  while(i < counts.len(), {
    n := match(counts.get(i), .Some(c) => c, .None => usize(0));
    assert(n == usize(1), `Kw carries ${n.to_string()} required traits, want one Ord(Kw)`);
    i = (i + usize(1));
  });
  mm_forget_open_document(doc_path.clone());
});
