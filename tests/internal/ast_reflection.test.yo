/// Verifies: AST reflection builtins on ExprVal (`__yo_expr_is_atom`,
/// `__yo_expr_is_fn_call`, `__yo_expr_get_callee`, `__yo_expr_get_args`) —
/// the layer behind `.is_atom()`, `.is_fn_call()`, `.get_callee()`,
/// `.get_args()`, which derive uses and which outlives the macro removal
/// (plans/backlog/MACRO_AND_ISO_REMOVAL.md §0.1).
///
/// Each case reflects on a `quote(...)` value in a module-level comptime
/// `cond` and exports 1 when the queries give the expected answers. Until
/// 2026-10-24 each case defined a gated user macro to receive the quoted
/// argument; the macro layer is being removed, so the cases now quote the
/// argument directly (C5 of the plan above).
{ String } :: import("std/string");
import("std/fmt");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../src/token.yo");
{ EvalValue } :: import("../../src/value.yo");
{ has_comment_attribute, Evaluator } :: import("../../src/evaluator/index.yo");
{ assert, panic } :: import("std/assert");
noop_loader :: (fn(_path : &String) -> Option(EvalValue))(
  Option(EvalValue).None
);
test("AST reflection: ExprVal.is_atom() returns true for atoms", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // Raw builtin `__yo_expr_is_atom` — the `.is_atom()` method sugar needs
  // the prelude. 1 only when `42` is an atom AND `(1 + 2)` is not.
  src := String.from("pragma(Pragma.SkipPrelude);\nr :: cond(__yo_expr_is_atom(quote(42)) => cond(__yo_expr_is_atom(quote((1 + 2))) => 0, true => 1), true => 0);\nexport(r);\n");
  eval := Evaluator.new(
    String.from("<phase6d1>"),
    String.from("<no-std>"),
    noop_loader,
    &src,
    exn
  );
  match(
    eval.get_module_error(),
    .Some(_) => {
      assert(false, "module_error on is_atom test");
    },
    .None => ()
  );
  match(
    eval.get_module_value(),
    .None => {
      assert(false, "no module value");
    },
    .Some(mv) => match(
      mv,
      .StructVal(_, names, values) => {
        (mut(i) : usize) = usize(0);
        n := names.len();
        (mut(found) : Option(usize)) = .None;
        while(i < n, {
          match(
            names.get(i),
            .Some(nm) => cond(
              (nm == "r") => {
                found = .Some(i);
              },
              true => ()
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
        match(
          found,
          .None => {
            assert(false, "r not found");
          },
          .Some(idx) => match(
            values.get(idx),
            .None => {
              assert(false, "r idx missing");
            },
            .Some(rv) => match(
              rv,
              .IntLit(s) => assert(s == "1", "expected 1 (e was atom)"),
              _ => {
                assert(false, "r is not IntLit");
              }
            )
          )
        );
      },
      _ => {
        assert(false, "not ModuleVal");
      }
    )
  );
});
test("AST reflection: ExprVal.is_fn_call() returns true for fn calls", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // Raw builtin `__yo_expr_is_fn_call` (see the SkipPrelude note above).
  // 1 only when `(1 + 2)` is a call AND `42` is not.
  src := String.from("pragma(Pragma.SkipPrelude);\nr :: cond(__yo_expr_is_fn_call(quote((1 + 2))) => cond(__yo_expr_is_fn_call(quote(42)) => 0, true => 1), true => 0);\nexport(r);\n");
  eval := Evaluator.new(
    String.from("<phase6d2>"),
    String.from("<no-std>"),
    noop_loader,
    &src,
    exn
  );
  match(
    eval.get_module_error(),
    .Some(_) => {
      assert(false, "module_error on is_fn_call test");
    },
    .None => ()
  );
  match(
    eval.get_module_value(),
    .None => {
      assert(false, "no module value");
    },
    .Some(mv) => match(
      mv,
      .StructVal(_, names, values) => {
        (mut(i) : usize) = usize(0);
        n := names.len();
        (mut(found) : Option(usize)) = .None;
        while(i < n, {
          match(
            names.get(i),
            .Some(nm) => cond(
              (nm == "r") => {
                found = .Some(i);
              },
              true => ()
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
        match(
          found,
          .None => {
            assert(false, "r not found");
          },
          .Some(idx) => match(
            values.get(idx),
            .None => {
              assert(false, "r idx missing");
            },
            .Some(rv) => match(
              rv,
              .IntLit(s) => assert(s == "1", "expected 1 (e was fn call)"),
              _ => {
                assert(false, "r is not IntLit");
              }
            )
          )
        );
      },
      _ => {
        assert(false, "not ModuleVal");
      }
    )
  );
});
test("AST reflection: get_callee and get_args extract structure", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // Inspects the quoted fn-call expression `(3 + 4)` (FnCall(+, [3, 4])).
  // Raw builtins — `.get_args().len() == 2` needs the prelude. Structure
  // is asserted instead: callee is `+` AND car(args) is `3` → 1.
  src := String.from("pragma(Pragma.SkipPrelude);\ne :: quote((3 + 4));\nv :: cond(__yo_expr_eq(__yo_expr_get_callee(e), quote(+)) => cond(__yo_expr_eq(__yo_comptime_list_car(__yo_expr_get_args(e)), quote(3)) => 1, true => 0), true => 0);\nexport(v);\n");
  eval := Evaluator.new(
    String.from("<phase6d3>"),
    String.from("<no-std>"),
    noop_loader,
    &src,
    exn
  );
  match(
    eval.get_module_error(),
    .Some(_) => {
      assert(false, "module_error on arg_count");
    },
    .None => ()
  );
  match(
    eval.get_module_value(),
    .None => {
      assert(false, "no module value");
    },
    .Some(mv) => match(
      mv,
      .StructVal(_, names, values) => {
        (mut(i) : usize) = usize(0);
        n := names.len();
        (mut(found) : Option(usize)) = .None;
        while(i < n, {
          match(
            names.get(i),
            .Some(nm) => cond(
              (nm == "v") => {
                found = .Some(i);
              },
              true => ()
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
        match(
          found,
          .None => {
            assert(false, "v not found");
          },
          .Some(idx) => match(
            values.get(idx),
            .None => {
              assert(false, "v idx missing");
            },
            .Some(rv) => match(
              rv,
              .IntLit(s) => assert(s == "1", "expected callee + and car(args) 3"),
              _ => {
                assert(false, "v is not IntLit");
              }
            )
          )
        );
      },
      _ => {
        assert(false, "not ModuleVal");
      }
    )
  );
});
