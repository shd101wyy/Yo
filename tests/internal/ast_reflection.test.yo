/// Verifies: AST reflection methods on ExprVal.
/// These are needed for the real std/prelude.yo `for` macro:
///   handle.is_fn_call(), handle.get_callee(), handle.get_args(),
///   callee.is_atom(), etc.
///
/// We define a macro that uses .is_atom() inside a comptime cond
/// and returns a different expression depending on the result.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../src/token.yo");
{ EvalValue } :: import("../../src/value.yo");
{ has_comment_attribute, Evaluator } :: import("../../src/evaluator/index.yo");
{ MACRO_DISPATCH_ENABLED } :: import("../../src/evaluator/calls/function.yo");
{ assert, panic } :: import("std/assert");
noop_loader :: (fn(_path : String) -> Option(EvalValue))(
  Option(EvalValue).None
);
test("AST reflection: ExprVal.is_atom() returns true for atoms", {
  // MACRO_DISPATCH_ENABLED is true (re-enabled 2026-06-11 — the old heap
  // corruption is fixed, see issues/fixed/); this body runs for real.
  if(MACRO_DISPATCH_ENABLED, {
    exn := Exception(
      throw : (
        (err) -> {
          assert(false, "unexpected error");
          unwind(());
        }
      )
    );
    // Raw builtin `__yo_expr_is_atom` — the `.is_atom()` method sugar needs
    // the prelude, and TS rejects it under SkipPrelude (the real module
    // evaluator matches TS; the legacy walker never truly evaluated it).
    src := String.from("pragma(Pragma.SkipPrelude);\npragma(Pragma.AllowMacroDef);\ncheck_atom :: (fn(quote(e) : Expr) -> unquote(Expr))(cond(__yo_expr_is_atom(e) => quote(1), true => quote(0)));\nr :: check_atom(42);\nexport(r);\n");
    eval := Evaluator.new(
      String.from("<phase6d1>"),
      String.from("<no-std>"),
      noop_loader,
      src,
      exn
    );
    match(
      eval.get_module_error(),
      .Some(_) => {
        assert(false, "module_error on is_atom test");
      },
      .None => ()
    );
    match(
      eval.get_module_value(),
      .None => {
        assert(false, "no module value");
      },
      .Some(mv) => match(
        mv,
        .StructVal(_, names, values) => {
          (i : usize) = usize(0);
          n := names.len();
          (found : Option(usize)) = .None;
          while(i < n, {
            match(
              names.get(i),
              .Some(nm) => cond(
                (nm == "r") => {
                  found = .Some(i);
                },
                true => ()
              ),
              .None => ()
            );
            i = (i + usize(1));
          });
          match(
            found,
            .None => {
              assert(false, "r not found");
            },
            .Some(idx) => match(
              values.get(idx),
              .None => {
                assert(false, "r idx missing");
              },
              .Some(rv) => match(
                rv,
                .IntLit(s) => assert(s == "1", "expected 1 (e was atom)"),
                _ => {
                  assert(false, "r is not IntLit");
                }
              )
            )
          );
        },
        _ => {
          assert(false, "not ModuleVal");
        }
      )
    );
  });
});
test("AST reflection: ExprVal.is_fn_call() returns true for fn calls", {
  // MACRO_DISPATCH_ENABLED is true (re-enabled 2026-06-11 — the old heap
  // corruption is fixed, see issues/fixed/); this body runs for real.
  if(MACRO_DISPATCH_ENABLED, {
    exn := Exception(
      throw : (
        (err) -> {
          assert(false, "unexpected error");
          unwind(());
        }
      )
    );
    // Raw builtin `__yo_expr_is_fn_call` (see the SkipPrelude note above).
    src := String.from("pragma(Pragma.SkipPrelude);\npragma(Pragma.AllowMacroDef);\ncheck_call :: (fn(quote(e) : Expr) -> unquote(Expr))(cond(__yo_expr_is_fn_call(e) => quote(1), true => quote(0)));\nr :: check_call((1 + 2));\nexport(r);\n");
    eval := Evaluator.new(
      String.from("<phase6d2>"),
      String.from("<no-std>"),
      noop_loader,
      src,
      exn
    );
    match(
      eval.get_module_error(),
      .Some(_) => {
        assert(false, "module_error on is_fn_call test");
      },
      .None => ()
    );
    match(
      eval.get_module_value(),
      .None => {
        assert(false, "no module value");
      },
      .Some(mv) => match(
        mv,
        .StructVal(_, names, values) => {
          (i : usize) = usize(0);
          n := names.len();
          (found : Option(usize)) = .None;
          while(i < n, {
            match(
              names.get(i),
              .Some(nm) => cond(
                (nm == "r") => {
                  found = .Some(i);
                },
                true => ()
              ),
              .None => ()
            );
            i = (i + usize(1));
          });
          match(
            found,
            .None => {
              assert(false, "r not found");
            },
            .Some(idx) => match(
              values.get(idx),
              .None => {
                assert(false, "r idx missing");
              },
              .Some(rv) => match(
                rv,
                .IntLit(s) => assert(s == "1", "expected 1 (e was fn call)"),
                _ => {
                  assert(false, "r is not IntLit");
                }
              )
            )
          );
        },
        _ => {
          assert(false, "not ModuleVal");
        }
      )
    );
  });
});
test("AST reflection: get_callee and get_args extract structure", {
  // MACRO_DISPATCH_ENABLED is true (re-enabled 2026-06-11 — the old heap
  // corruption is fixed, see issues/fixed/); this body runs for real.
  if(MACRO_DISPATCH_ENABLED, {
    exn := Exception(
      throw : (
        (err) -> {
          assert(false, "unexpected error");
          unwind(());
        }
      )
    );
    // Macro inspects an fn-call expression `(3 + 4)` (which parses as FnCall(+, [3, 4])).
    // We just verify that get_args returns something whose .len() is 2.
    // Raw builtins — `.get_args().len() == 2` needs the prelude. Structure
    // is asserted instead: callee is `+` AND car(args) is `3` → 1.
    src := String.from("pragma(Pragma.SkipPrelude);\npragma(Pragma.AllowMacroDef);\nprobe :: (fn(quote(e) : Expr) -> unquote(Expr))(cond(__yo_expr_eq(__yo_expr_get_callee(e), quote(+)) => cond(__yo_expr_eq(__yo_comptime_list_car(__yo_expr_get_args(e)), quote(3)) => quote(1), true => quote(0)), true => quote(0)));\nv :: probe((3 + 4));\nexport(v);\n");
    eval := Evaluator.new(
      String.from("<phase6d3>"),
      String.from("<no-std>"),
      noop_loader,
      src,
      exn
    );
    match(
      eval.get_module_error(),
      .Some(_) => {
        assert(false, "module_error on arg_count");
      },
      .None => ()
    );
    match(
      eval.get_module_value(),
      .None => {
        assert(false, "no module value");
      },
      .Some(mv) => match(
        mv,
        .StructVal(_, names, values) => {
          (i : usize) = usize(0);
          n := names.len();
          (found : Option(usize)) = .None;
          while(i < n, {
            match(
              names.get(i),
              .Some(nm) => cond(
                (nm == "v") => {
                  found = .Some(i);
                },
                true => ()
              ),
              .None => ()
            );
            i = (i + usize(1));
          });
          match(
            found,
            .None => {
              assert(false, "v not found");
            },
            .Some(idx) => match(
              values.get(idx),
              .None => {
                assert(false, "v idx missing");
              },
              .Some(rv) => match(
                rv,
                .IntLit(s) => assert(s == "1", "expected callee + and car(args) 3"),
                _ => {
                  assert(false, "v is not IntLit");
                }
              )
            )
          );
        },
        _ => {
          assert(false, "not ModuleVal");
        }
      )
    );
  });
});
