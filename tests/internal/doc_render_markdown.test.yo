/// Tests for the Markdown documentation renderer (Phase 2p).
///
/// Mirrors `src/doc/render-markdown.test.ts`.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ assert, panic } :: import("std/assert");
{
  DocParam,
  DocField,
  DocVariant,
  DocAssociatedType,
  DocImplAssocType,
  DocImpl,
  DocFunction,
  DocType,
  DocTrait,
  DocConstant,
  DocModule,
  DocModel,
  DocItemKind,
  DocTraitKind
} :: import("../../src/doc/model.yo");
{
  render_function_md,
  render_type_md,
  render_trait_md,
  render_constant_md,
  render_module_md,
  render_index_md
} :: import("../../src/doc/render_markdown.yo");
// ── Builder helpers ────────────────────────────────────────────────────────
make_param_ :: (fn(name : String, type_ : String) -> DocParam)(
  DocParam(
    name : name,
    type_ : type_,
    is_comptime : false,
    is_implicit : false,
    default_value : Option(String).None,
    doc : Option(String).None
  )
);
make_function_ :: (fn() -> DocFunction)({
  params := ArrayList(DocParam).new();
  params.push(make_param_(`a`, `i32`));
  params.push(make_param_(`b`, `i32`));
  DocFunction(
    name : `add`,
    doc : Option(String).Some(`Add two numbers.`),
    signature : `add :: (fn(a : i32, b : i32) -> i32)`,
    parameters : params,
    return_type : `i32`,
    type_params : Option(ArrayList(DocParam)).None,
    effects : Option(ArrayList(DocParam)).None,
    is_method : false,
    self_type : Option(String).None,
    returns : Option(String).None,
    errors : Option(String).None,
    deprecated : Option(String).None,
    examples : Option(String).None
  )
});
make_type_ :: (fn() -> DocType)({
  fields := ArrayList(DocField).new();
  fields.push(DocField(name : `x`, type_ : `i32`, doc : Option(String).None, default_value : Option(String).None));
  fields.push(DocField(name : `y`, type_ : `i32`, doc : Option(String).None, default_value : Option(String).None));
  DocType(
    name : `Point`,
    doc : Option(String).Some(`A 2D point.`),
    kind : DocItemKind.Struct,
    signature : `Point :: struct(x : i32, y : i32)`,
    type_params : Option(ArrayList(DocParam)).None,
    fields : Option(ArrayList(DocField)).Some(fields),
    variants : Option(ArrayList(DocVariant)).None,
    methods : ArrayList(DocFunction).new(),
    trait_impls : ArrayList(String).new(),
    impls : Option(ArrayList(DocImpl)).None,
    deprecated : Option(String).None,
    examples : Option(String).None
  )
});
make_display_method_ :: (fn() -> DocFunction)({
  params := ArrayList(DocParam).new();
  params.push(make_param_(`self`, `Self`));
  DocFunction(
    name : `display`,
    doc : Option(String).Some(`Render self as a string.`),
    signature : `display : (fn(self: Self) -> str)`,
    parameters : params,
    return_type : `str`,
    type_params : Option(ArrayList(DocParam)).None,
    effects : Option(ArrayList(DocParam)).None,
    is_method : true,
    self_type : Option(String).Some(`Self`),
    returns : Option(String).None,
    errors : Option(String).None,
    deprecated : Option(String).None,
    examples : Option(String).None
  )
});
make_trait_ :: (fn() -> DocTrait)({
  methods := ArrayList(DocFunction).new();
  methods.push(make_display_method_());
  implementors := ArrayList(String).new();
  implementors.push(`Point`);
  implementors.push(`Color`);
  DocTrait(
    name : `Display`,
    doc : Option(String).Some(`Format a value for display.`),
    kind : DocTraitKind.Trait,
    signature : `Display :: trait(display : (fn(self: Self) -> str))`,
    type_params : Option(ArrayList(DocParam)).None,
    associated_types : Option(ArrayList(DocAssociatedType)).None,
    methods : methods,
    implementors : implementors,
    deprecated : Option(String).None,
    examples : Option(String).None
  )
});
make_constant_ :: (fn() -> DocConstant)(
  DocConstant(
    name : `MAX_SIZE`,
    doc : Option(String).Some(`Maximum buffer size.`),
    type_ : `usize`,
    value : Option(String).Some(`1024`),
    deprecated : Option(String).None,
    examples : Option(String).None
  )
);
make_module_ :: (fn() -> DocModule)({
  fns := ArrayList(DocFunction).new();
  fns.push(make_function_());
  types := ArrayList(DocType).new();
  types.push(make_type_());
  traits := ArrayList(DocTrait).new();
  traits.push(make_trait_());
  consts := ArrayList(DocConstant).new();
  consts.push(make_constant_());
  DocModule(
    name : `math`,
    path : `std/math`,
    doc : Option(String).Some(`Math utilities.`),
    stability : Option(String).None,
    functions : fns,
    types : types,
    traits : traits,
    constants : consts,
    submodules : ArrayList(Box(DocModule)).new()
  )
});
make_model_ :: (fn() -> DocModel)({
  modules := ArrayList(DocModule).new();
  modules.push(make_module_());
  DocModel(
    name : `my-project`,
    modules : modules,
    version : Option(String).None
  )
});
// ── renderFunctionMd ────────────────────────────────────────────────────────
test("renderFunctionMd: renders a basic function", {
  md := render_function_md(make_function_());
  assert(md.contains(`### \`add\``), "heading");
  assert(md.contains(`\`\`\`rust`), "code fence");
  assert(md.contains(`add :: (fn(a : i32, b : i32) -> i32)`), "signature");
  assert(md.contains(`Add two numbers.`), "doc");
  assert(md.contains(`**Parameters:**`), "parameters header");
  assert(md.contains(`\`a\` : \`i32\``), "param a");
  assert(md.contains(`**Returns:** \`i32\``), "return(type)");
});
test("renderFunctionMd: renders comptime and implicit parameters", {
  params := ArrayList(DocParam).new();
  params.push(DocParam(name : `T`, type_ : `Type`, is_comptime : true, is_implicit : false, default_value : Option(String).None, doc : Option(String).None));
  params.push(DocParam(name : `io`, type_ : `Io`, is_comptime : false, is_implicit : true, default_value : Option(String).None, doc : Option(String).None));
  fn_ := make_function_();
  fn2 := DocFunction(
    name : fn_.name,
    doc : fn_.doc,
    signature : fn_.signature,
    parameters : params,
    return_type : fn_.return_type,
    type_params : fn_.type_params,
    effects : fn_.effects,
    is_method : fn_.is_method,
    self_type : fn_.self_type,
    returns : fn_.returns,
    errors : fn_.errors,
    deprecated : fn_.deprecated,
    examples : fn_.examples
  );
  md := render_function_md(fn2);
  assert(md.contains(`*(comptime)*`), "comptime marker");
  assert(md.contains(`*(implicit)*`), "implicit marker");
});
test("renderFunctionMd: renders a method with self type", {
  params := ArrayList(DocParam).new();
  fn_ := make_function_();
  fn2 := DocFunction(
    name : `len`,
    doc : fn_.doc,
    signature : fn_.signature,
    parameters : fn_.parameters,
    return_type : fn_.return_type,
    type_params : fn_.type_params,
    effects : fn_.effects,
    is_method : true,
    self_type : Option(String).Some(`Vec`),
    returns : fn_.returns,
    errors : fn_.errors,
    deprecated : fn_.deprecated,
    examples : fn_.examples
  );
  md := render_function_md(fn2);
  assert(md.contains(`### \`Vec.len\``), "method heading");
});
test("renderFunctionMd: renders deprecated banner", {
  fn_ := make_function_();
  fn2 := DocFunction(
    name : fn_.name,
    doc : fn_.doc,
    signature : fn_.signature,
    parameters : fn_.parameters,
    return_type : fn_.return_type,
    type_params : fn_.type_params,
    effects : fn_.effects,
    is_method : fn_.is_method,
    self_type : fn_.self_type,
    returns : fn_.returns,
    errors : fn_.errors,
    deprecated : Option(String).Some(`Use new_add instead.`),
    examples : fn_.examples
  );
  md := render_function_md(fn2);
  assert(md.contains(`⚠️ **Deprecated**`), "deprecated banner");
  assert(md.contains(`Use new_add instead.`), "deprecated message");
});
test("renderFunctionMd: renders Returns section", {
  fn_ := make_function_();
  fn2 := DocFunction(
    name : fn_.name,
    doc : fn_.doc,
    signature : fn_.signature,
    parameters : fn_.parameters,
    return_type : fn_.return_type,
    type_params : fn_.type_params,
    effects : fn_.effects,
    is_method : fn_.is_method,
    self_type : fn_.self_type,
    returns : Option(String).Some(`The sum of the two operands.`),
    errors : fn_.errors,
    deprecated : fn_.deprecated,
    examples : fn_.examples
  );
  md := render_function_md(fn2);
  assert(md.contains(`The sum of the two operands.`), "returns content");
});
test("renderFunctionMd: renders Errors section", {
  fn_ := make_function_();
  fn2 := DocFunction(
    name : fn_.name,
    doc : fn_.doc,
    signature : fn_.signature,
    parameters : fn_.parameters,
    return_type : fn_.return_type,
    type_params : fn_.type_params,
    effects : fn_.effects,
    is_method : fn_.is_method,
    self_type : fn_.self_type,
    returns : fn_.returns,
    errors : Option(String).Some(`Returns an error on overflow.`),
    deprecated : fn_.deprecated,
    examples : fn_.examples
  );
  md := render_function_md(fn2);
