// ── renderTraitMd ─────────────────────────────────────────────────────────────
test("renderTraitMd: renders a trait with methods", {
  md := render_trait_md(make_trait_());
  assert(md.contains(`### \`Display\``), "heading");
  assert(md.contains(`*trait*`), "kind");
  assert(md.contains(`Format a value for display.`), "doc");
  assert(md.contains(`**Required Methods:**`), "methods header");
  assert(md.contains(`Self.display`), "method Self.display");
});
test("renderTraitMd: renders implementors", {
  md := render_trait_md(make_trait_());
  assert(md.contains(`**Implementors:** \`Point\`, \`Color\``), "implementors list");
});
test("renderTraitMd: renders deprecated banner", {
  tr := make_trait_();
  tr2 := DocTrait(
    name : tr.name,
    doc : tr.doc,
    kind : tr.kind,
    signature : tr.signature,
    type_params : tr.type_params,
    associated_types : tr.associated_types,
    methods : tr.methods,
    implementors : tr.implementors,
    deprecated : Option(String).Some(`Use NewTrait.`),
    examples : tr.examples
  );
  md := render_trait_md(tr2);
  assert(md.contains(`⚠️ **Deprecated**`), "deprecated banner");
  assert(md.contains(`Use NewTrait.`), "deprecated message");
});
// ── renderConstantMd ──────────────────────────────────────────────────────────
test("renderConstantMd: renders a constant with value", {
  md := render_constant_md(make_constant_());
  assert(md.contains(`### \`MAX_SIZE\``), "heading");
  assert(md.contains(`\`usize = 1024\``), "type and value");
  assert(md.contains(`Maximum buffer size.`), "doc");
});
test("renderConstantMd: renders a constant without value", {
  c := DocConstant(
    name : `MIN_SIZE`,
    doc : Option(String).None,
    type_ : `usize`,
    value : Option(String).None,
    deprecated : Option(String).None,
    examples : Option(String).None
  );
  md := render_constant_md(c);
  assert(md.contains(`\`usize\``), "type only");
  assert(!(md.contains(`=`)), "no equals sign");
});
test("renderConstantMd: renders deprecated banner", {
  c := DocConstant(
    name : make_constant_().name,
    doc : make_constant_().doc,
    type_ : make_constant_().type_,
    value : make_constant_().value,
    deprecated : Option(String).Some(`Use NEW_VALUE.`),
    examples : Option(String).None
  );
  md := render_constant_md(c);
  assert(md.contains(`⚠️ **Deprecated**`), "deprecated banner");
  assert(md.contains(`Use NEW_VALUE.`), "deprecated message");
});
// ── renderModuleMd ─────────────────────────────────────────────────────────────
test("renderModuleMd: renders a module with all sections", {
  md := render_module_md(make_module_());
  assert(md.contains(`# math`), "h1 heading");
  assert(md.contains(`> Module path: \`std/math\``), "module path");
  assert(md.contains(`Math utilities.`), "doc");
  assert(md.contains(`## Contents`), "contents section");
  assert(md.contains(`## Types`), "types section");
  assert(md.contains(`## Traits`), "traits section");
  assert(md.contains(`## Functions`), "functions section");
  assert(md.contains(`## Constants`), "constants section");
});
test("renderModuleMd: renders empty module without content sections", {
  m := DocModule(
    name : `empty`,
    path : `std/empty`,
    doc : Option(String).None,
    stability : Option(String).None,
    functions : ArrayList(DocFunction).new(),
    types : ArrayList(DocType).new(),
    traits : ArrayList(DocTrait).new(),
    constants : ArrayList(DocConstant).new(),
    submodules : ArrayList(Box(DocModule)).new()
  );
  md := render_module_md(m);
  assert(md.contains(`# empty`), "heading");
  assert(!(md.contains(`## Types`)), "no types section");
  assert(!(md.contains(`## Functions`)), "no functions section");
});
// ── renderIndexMd ─────────────────────────────────────────────────────────────
test("renderIndexMd: renders an index page", {
  md := render_index_md(make_model_());
  assert(md.contains(`# my-project — API Documentation`), "title");
  assert(md.contains(`## Modules`), "modules header");
  assert(md.contains(`[\`std/math\`](module/math.md)`), "module link");
  assert(md.contains(`(4 items)`), "item count");
});
test("renderIndexMd: uses first line of module doc as summary", {
  modules := ArrayList(DocModule).new();
  m := make_module_();
  m2 := DocModule(
    name : m.name,
    path : m.path,
    doc : Option(String).Some(`First line summary.\nMore details here.`),
    stability : Option(String).None,
    functions : m.functions,
    types : m.types,
    traits : m.traits,
    constants : m.constants,
    submodules : m.submodules
  );
  modules.push(m2);
  model := DocModel(name : `proj`, modules : modules, version : Option(String).None);
  md := render_index_md(model);
  assert(md.contains(`First line summary.`), "summary from first line");
});
// ── stability marker (plans/STD_API_AUDIT.md §1: new modules enter `unstable`) ──
test("renderModuleMd: renders the stability note and the index badge", {
  m := make_module_();
  um := DocModule(
    name : m.name,
    path : m.path,
    doc : m.doc,
    stability : Option(String).Some(`unstable`),
    functions : m.functions,
    types : m.types,
    traits : m.traits,
    constants : m.constants,
    submodules : m.submodules
  );
  md := render_module_md(um);
  assert(md.contains(`**Stability: unstable**`), "module page carries the stability note");
  stable_md := render_module_md(m);
  assert(!(stable_md.contains(`Stability:`)), "a stable module has no note");
  modules := ArrayList(DocModule).new();
  modules.push(um);
  idx := render_index_md(DocModel(name : `proj`, modules : modules, version : Option(String).None));
  assert(idx.contains(`(module/math.md) _(unstable)_`), "index badge");
});
