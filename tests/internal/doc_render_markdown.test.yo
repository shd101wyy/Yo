  assert(md.contains(`Returns an error on overflow.`), "errors content");
});
test("renderFunctionMd: renders Examples section", {
  fn_ := make_function_();
  fn2 := DocFunction(
    name : fn_.name,
    doc : fn_.doc,
    signature : fn_.signature,
    parameters : fn_.parameters,
    return_type : fn_.return_type,
    type_params : fn_.type_params,
    effects : fn_.effects,
    is_method : fn_.is_method,
    self_type : fn_.self_type,
    returns : fn_.returns,
    errors : fn_.errors,
    deprecated : fn_.deprecated,
    examples : Option(String).Some(`\`\`\`rust\nresult :: add(i32(1), i32(2));\n\`\`\``)
  );
  md := render_function_md(fn2);
  assert(md.contains(`**Examples:**`), "examples header");
  assert(md.contains(`result :: add(i32(1), i32(2));`), "examples content");
});
test("renderFunctionMd: renders param with doc and default", {
  params := ArrayList(DocParam).new();
  params.push(DocParam(name : `a`, type_ : `i32`, is_comptime : false, is_implicit : false, default_value : Option(String).Some(`0`), doc : Option(String).Some(`First operand.`)));
  fn_ := make_function_();
  fn2 := DocFunction(
    name : fn_.name,
    doc : fn_.doc,
    signature : fn_.signature,
    parameters : params,
    return_type : fn_.return_type,
    type_params : fn_.type_params,
    effects : fn_.effects,
    is_method : fn_.is_method,
    self_type : fn_.self_type,
    returns : fn_.returns,
    errors : fn_.errors,
    deprecated : fn_.deprecated,
    examples : fn_.examples
  );
  md := render_function_md(fn2);
  assert(md.contains(`First operand.`), "param doc");
  assert(md.contains(`= \`0\``), "param default");
});
// ── renderTypeMd ─────────────────────────────────────────────────────────────
test("renderTypeMd: renders a struct type", {
  md := render_type_md(make_type_());
  assert(md.contains(`### \`Point\``), "heading");
  assert(md.contains(`*struct*`), "kind");
  assert(md.contains(`A 2D point.`), "doc");
  assert(md.contains(`**Fields:**`), "fields header");
  assert(md.contains(`\`x\` : \`i32\``), "field x");
});
test("renderTypeMd: renders atomic object type kind", {
  fields := ArrayList(DocField).new();
  fields.push(DocField(name : `_raw`, type_ : `usize`, doc : Option(String).None, default_value : Option(String).None));
  t := make_type_();
  t2 := DocType(
    name : `Cond`,
    doc : t.doc,
    kind : DocItemKind.AtomicObject,
    signature : `Cond :: atomic object(_raw : usize)`,
    type_params : t.type_params,
    fields : Option(ArrayList(DocField)).Some(fields),
    variants : t.variants,
    methods : t.methods,
    trait_impls : t.trait_impls,
    impls : t.impls,
    deprecated : t.deprecated,
    examples : t.examples
  );
  md := render_type_md(t2);
  assert(md.contains(`*atomic object*`), "atomic object kind");
  assert(md.contains(`Cond :: atomic object(_raw : usize)`), "signature");
});
test("renderTypeMd: renders an enum with variants", {
  variants := ArrayList(DocVariant).new();
  variants.push(DocVariant(name : `Red`, fields : Option(ArrayList(DocField)).None, doc : Option(String).None, discriminant : Option(String).None));
  variants.push(DocVariant(name : `Green`, fields : Option(ArrayList(DocField)).None, doc : Option(String).None, discriminant : Option(String).None));
  variants.push(DocVariant(name : `Blue`, fields : Option(ArrayList(DocField)).None, doc : Option(String).Some(`The color blue`), discriminant : Option(String).None));
  t := make_type_();
  t2 := DocType(
    name : `Color`,
    doc : Option(String).Some(`A color.`),
    kind : DocItemKind.Enum,
    signature : `Color :: enum(Red, Green, Blue)`,
    type_params : t.type_params,
    fields : Option(ArrayList(DocField)).None,
    variants : Option(ArrayList(DocVariant)).Some(variants),
    methods : t.methods,
    trait_impls : t.trait_impls,
    impls : t.impls,
    deprecated : t.deprecated,
    examples : t.examples
  );
  md := render_type_md(t2);
  assert(md.contains(`*enum*`), "kind");
  assert(md.contains(`**Variants:**`), "variants header");
  assert(md.contains(`\`Red\``), "Red variant");
  assert(md.contains(`\`Blue\` — The color blue`), "Blue variant with doc");
});
test("renderTypeMd: renders trait impls", {
  t := make_type_();
  t.trait_impls.push(`Display`);
  t.trait_impls.push(`Clone`);
  md := render_type_md(t);
  assert(md.contains(`**Implements:** \`Display\`, \`Clone\``), "implements list");
});
test("renderTypeMd: renders impl blocks with methods", {
  method_names := ArrayList(String).new();
  method_names.push(`size`);
  method_names.push(`is_empty`);
  impl_ := DocImpl(
    signature : `impl(generic(T : Type), where(T <: Send), List(T))`,
    trait_name : Option(String).None,
    method_names : method_names,
    associated_types : Option(ArrayList(DocImplAssocType)).None
  );
  impls := ArrayList(DocImpl).new();
  impls.push(impl_);
  size_params := ArrayList(DocParam).new();
  size_fn := DocFunction(
    name : `size`,
    doc : Option(String).None,
    signature : `size : (fn(self: Self) -> usize)`,
    parameters : size_params,
    return_type : `usize`,
    type_params : Option(ArrayList(DocParam)).None,
    effects : Option(ArrayList(DocParam)).None,
    is_method : true,
    self_type : Option(String).Some(`List`),
    returns : Option(String).None,
    errors : Option(String).None,
    deprecated : Option(String).None,
    examples : Option(String).None
  );
  empty_params := ArrayList(DocParam).new();
  empty_fn := DocFunction(
    name : `is_empty`,
    doc : Option(String).None,
    signature : `is_empty : (fn(self: Self) -> bool)`,
    parameters : empty_params,
    return_type : `bool`,
    type_params : Option(ArrayList(DocParam)).None,
    effects : Option(ArrayList(DocParam)).None,
    is_method : true,
    self_type : Option(String).Some(`List`),
    returns : Option(String).None,
    errors : Option(String).None,
    deprecated : Option(String).None,
    examples : Option(String).None
  );
  methods := ArrayList(DocFunction).new();
  methods.push(size_fn);
  methods.push(empty_fn);
  t := make_type_();
  t2 := DocType(
    name : t.name,
    doc : t.doc,
    kind : t.kind,
    signature : t.signature,
    type_params : t.type_params,
    fields : t.fields,
    variants : t.variants,
    methods : methods,
    trait_impls : t.trait_impls,
    impls : Option(ArrayList(DocImpl)).Some(impls),
    deprecated : t.deprecated,
    examples : t.examples
  );
  md := render_type_md(t2);
  assert(md.contains(`\`impl(generic(T : Type), where(T <: Send), List(T))\``), "impl heading");
  assert(md.contains(`List.size`), "method List.size");
  assert(md.contains(`List.is_empty`), "method List.is_empty");
});
test("renderTypeMd: renders type parameters", {
  type_params := ArrayList(DocParam).new();
  type_params.push(DocParam(name : `T`, type_ : `Type`, is_comptime : true, is_implicit : false, default_value : Option(String).None, doc : Option(String).None));
  t := make_type_();
  t2 := DocType(
    name : `Vec`,
    doc : t.doc,
    kind : t.kind,
    signature : t.signature,
    type_params : Option(ArrayList(DocParam)).Some(type_params),
    fields : t.fields,
    variants : t.variants,
    methods : t.methods,
    trait_impls : t.trait_impls,
    impls : t.impls,
    deprecated : t.deprecated,
    examples : t.examples
  );
  md := render_type_md(t2);
  assert(md.contains(`### \`Vec(T)\``), "type with params heading");
});
test("renderTypeMd: renders deprecated banner", {
  t := make_type_();
  t2 := DocType(
    name : t.name,
    doc : t.doc,
    kind : t.kind,
    signature : t.signature,
    type_params : t.type_params,
    fields : t.fields,
    variants : t.variants,
    methods : t.methods,
    trait_impls : t.trait_impls,
    impls : t.impls,
    deprecated : Option(String).Some(`Use Point3D.`),
    examples : t.examples
  );
  md := render_type_md(t2);
  assert(md.contains(`⚠️ **Deprecated**`), "deprecated banner");
