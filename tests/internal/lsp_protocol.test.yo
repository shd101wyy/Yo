//! Tests for the LSP protocol boundary (`src/lsp/protocol.yo`) and the
//! analysis-state guarantees of `src/lsp/diagnostics.yo`:
//!
//!   - `file:` URI ↔ filesystem path, including the Windows drive form and
//!     percent-encoding, on every platform (pure string handling)
//!     (issues/fixed/lsp-uri-to-fs-path-leaves-a-leading-slash-on-windows-drive-uris.md,
//!     issues/fixed/lsp-definition-uri-is-built-without-percent-encoding.md);
//!   - rune ↔ UTF-16 column conversion around an astral-plane rune
//!     (issues/fixed/lsp-emits-rune-columns-where-the-protocol-says-utf16.md);
//!   - `is_any_temp_variable_name`, the shape predicate completion uses to
//!     hide the evaluator's temporaries
//!     (issues/fixed/lsp-completion-lists-compiler-temporaries.md);
//!   - `analyze_document` keeps the parsed program and the partial ExprInfo
//!     when evaluation fails, and reports `parsed == false` when parsing fails
//!     (issues/fixed/lsp-analysis-state-lost-on-parse-and-eval-errors.md);
//!   - hover renders a contracted function's requires/ensures/return label
//!     and the file's verification mode, and marks ghost_fn predicates
//!     spec-only (FORMAL_VERIFICATION.md V7 task 1);
//!   - the 2026-09-29 audit §2 fixes (plans/archive/LSP_AUDIT_2026-09-29.md): rename
//!     `newName` validation, `context.includeDeclaration`, documentSymbol's
//!     typed top-level declarations, and prepareRename's renameability gate.
{ rune, String } :: import("std/string");
{ Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ assert, assert_eq } :: import("std/assert");
json :: import("std/encoding/json");
{ JsonValue } :: import("std/encoding/json");
{ Path } :: import("std/path");
{ create_dir_all } :: import("std/fs/dir");
{ write_string } :: import("std/fs/file");
{
  uri_to_fs_path,
  fs_path_to_uri,
  module_path_to_uri,
  rune_col_to_utf16_col,
  utf16_col_to_rune_col,
  rune_col_to_utf8_col,
  utf8_col_to_rune_col
} :: import("../../src/lsp/protocol.yo");
{ analyze_document, AnalyzeOutcome } :: import("../../src/lsp/diagnostics.yo");
{ handle_hover } :: import("../../src/lsp/hover.yo");
{ handle_implementations } :: import("../../src/lsp/symbols.yo");
{ handle_document_links } :: import("../../src/lsp/definition.yo");
{ handle_type_definition } :: import("../../src/lsp/definition.yo");
{ handle_references, handle_document_highlight } :: import("../../src/lsp/references.yo");
{ handle_rename, handle_prepare_rename, rename_rejection } :: import("../../src/lsp/rename.yo");
{ handle_document_symbols, handle_document_symbols_flat, handle_workspace_symbols, WorkspaceDoc } :: import("../../src/lsp/symbols.yo");
{ handle_semantic_tokens } :: import("../../src/lsp/folding.yo");
{ resolve_std_path, mm_forget_open_document, mm_invalidate_document } :: import("../../src/module_manager.yo");
{ is_any_temp_variable_name, generate_new_temp_variable_name } :: import("../../src/utils.yo");

test("uri_to_fs_path: POSIX, Windows drive, legacy drive, percent escapes", {
  assert_eq(uri_to_fs_path(`file:///home/u/a.yo`), `/home/u/a.yo`, "posix absolute");
  assert_eq(uri_to_fs_path(`file:///C:/w/a.yo`), `C:/w/a.yo`, "windows drive keeps no leading slash");
  assert_eq(uri_to_fs_path(`file:///c%3A/w/a.yo`), `c:/w/a.yo`, "VS Code's encoded drive colon");
  assert_eq(uri_to_fs_path(`file:///C|/w/a.yo`), `C:/w/a.yo`, "legacy `|` drive spelling");
  assert_eq(uri_to_fs_path(`file:///home/u/my%20dir/a%23b.yo`), `/home/u/my dir/a#b.yo`, "percent-decoded");
  assert_eq(uri_to_fs_path(`/already/a/path.yo`), `/already/a/path.yo`, "plain path passes through");
});

test("fs_path_to_uri percent-encodes segments and round-trips", {
  assert_eq(fs_path_to_uri(`/home/u/a.yo`), `file:///home/u/a.yo`, "posix absolute");
  assert_eq(fs_path_to_uri(`/home/u/my dir/a#b%.yo`), `file:///home/u/my%20dir/a%23b%25.yo`, "space, hash and percent encoded");
  assert_eq(fs_path_to_uri(`C:/w/a.yo`), `file:///C%3A/w/a.yo`, "windows drive gets the empty-authority slash");
  assert_eq(fs_path_to_uri(`C:\\w\\a.yo`), `file:///C%3A/w/a.yo`, "backslashes normalized");
  assert_eq(uri_to_fs_path(fs_path_to_uri(`/x/ä ö/#1.yo`)), `/x/ä ö/#1.yo`, "round trip");
  assert_eq(module_path_to_uri(`file:///abs/dir/x.yo`), `file:///abs/dir/x.yo`, "file:// module path");
  assert_eq(module_path_to_uri(`/abs/dir/x y.yo`), `file:///abs/dir/x%20y.yo`, "plain module path");
});

test("rune <-> UTF-16 columns around an astral-plane rune", {
  line := `ab😀cd`;
  assert_eq(rune_col_to_utf16_col(line.clone(), usize(0)), usize(0), "start");
  assert_eq(rune_col_to_utf16_col(line.clone(), usize(2)), usize(2), "before the emoji");
  assert_eq(rune_col_to_utf16_col(line.clone(), usize(3)), usize(4), "after the emoji: +1 unit");
  assert_eq(rune_col_to_utf16_col(line.clone(), usize(5)), usize(6), "end");
  assert_eq(rune_col_to_utf16_col(line.clone(), usize(99)), usize(6), "past the end clamps");
  assert_eq(utf16_col_to_rune_col(line.clone(), usize(2)), usize(2), "before the emoji");
  assert_eq(utf16_col_to_rune_col(line.clone(), usize(3)), usize(3), "inside the surrogate pair belongs to the emoji");
  assert_eq(utf16_col_to_rune_col(line.clone(), usize(4)), usize(3), "after the emoji: -1 unit");
  assert_eq(utf16_col_to_rune_col(line.clone(), usize(6)), usize(5), "end");
  assert_eq(utf16_col_to_rune_col(line.clone(), usize(99)), usize(5), "past the end clamps");
  cjk := `中文x`;
  assert_eq(rune_col_to_utf16_col(cjk.clone(), usize(2)), usize(2), "BMP runes are one unit each");
  assert_eq(utf16_col_to_rune_col(cjk, usize(2)), usize(2), "BMP inverse");
});

test("is_any_temp_variable_name recognises the generator's shape for any module path", {
  assert(is_any_temp_variable_name(`__private_tmp_temp_39`), "posix-path temporary");
  assert(is_any_temp_variable_name(`__home_runner_temp_1729`), "another host's path");
  assert(is_any_temp_variable_name(`_file____priv_temp_2355`), "file:// spelling");
  assert(is_any_temp_variable_name(`__temp_7`), "empty module path");
  assert(is_any_temp_variable_name(generate_new_temp_variable_name(`/virtual/doc.yo`)), "a freshly minted name");
  assert(!is_any_temp_variable_name(`total`), "plain identifier");
  assert(!is_any_temp_variable_name(`__yo_user_main`), "compiler internal without the marker");
  assert(!is_any_temp_variable_name(`__private_tmp_temp_`), "no digits");
  assert(!is_any_temp_variable_name(`__private_tmp_temp_3x`), "non-digit tail");
  assert(!is_any_temp_variable_name(`x_temp_1`), "no leading underscore");
  assert(!is_any_temp_variable_name(`__private_tmp_yo_temp_1`), "prefix longer than twelve bytes");
});

_GOOD :: "add_one :: (fn(x : i32) -> i32)((x + i32(1)));\nmain :: (fn() -> unit)({\n  y := add_one(i32(41));\n  _z := y;\n  ()\n});\nexport(main);\n";
_EVAL_ERR :: "add_one :: (fn(x : i32) -> i32)((x + i32(1)));\nmain :: (fn() -> unit)({\n  y := add_one(i32(41));\n  _z := y;\n  ()\n});\nexport(main);\nlater :: (fn() -> unit)({\n  undefined_qq();\n});\n";
_PARSE_ERR :: "add_one :: (fn(x : i32) -> i32)((x + i32(1)));\nmain :: (fn() -> unit)({\n  y := add_one(\n});\n";

/// Analyze `text` as `doc_path`; the outcome the server would retain.
_analyze :: (fn(doc_path : String, text : String, std_path : String, io : Io) -> Option(AnalyzeOutcome))({
  out := ArrayList(AnalyzeOutcome).new();
  _diags := analyze_document(doc_path.clone(), text, std_path, io, out);
  out.get(usize(0))
});

test("analysis state survives evaluation and parse errors", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  doc_path := `${dir}/doc.yo`;
  io.await(write_string(Path.new(doc_path.clone()), String.from(_GOOD), io), ioexn);
  std_path := resolve_std_path();
  // Make sure no earlier state for this path leaks between runs.
  mm_forget_open_document(doc_path.clone());
  _pre := mm_invalidate_document(doc_path.clone());
  (good_len : usize) = usize(0);
  match(
    _analyze(doc_path.clone(), String.from(_GOOD), std_path.clone(), io),
    .Some(good) => {
      assert(good.ok && good.parsed, "clean document analyzes ok");
      assert(good.exprs.len() >= usize(3), "clean document: the program is retained");
      good_len = good.exprs.len();
    },
    .None => assert(false, "clean document: no outcome")
  );
  _inv1 := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), String.from(_EVAL_ERR), std_path.clone(), io),
    .Some(ev) => {
      assert(ev.parsed, "evaluation error: the text parsed");
      assert(!ev.ok, "evaluation error: not ok");
      // One more top-level statement (`later`) than the clean text.
      assert_eq(ev.exprs.len(), good_len + usize(1), "evaluation error keeps the whole program");
      // The ExprInfo recorded before the error is still there: hover on `y`
      // (line 3, column 8 — `_z := y`) is typed.
      lines := String.from(_EVAL_ERR).split(String.from("\n"));
      hover := handle_hover(String.from(_EVAL_ERR), doc_path.clone(), lines, ev.exprs, ev.info_table, usize(3), usize(8));
      assert(hover.is_some(), "hover still answers from the partial ExprInfo after an evaluation error");
    },
    .None => assert(false, "evaluation error: no outcome")
  );
  _inv2 := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), String.from(_PARSE_ERR), std_path.clone(), io),
    .Some(pe) => {
      assert(!pe.parsed, "parse error: parsed == false");
      assert(!pe.ok, "parse error: not ok");
      assert_eq(pe.exprs.len(), usize(0), "parse error: no program");
    },
    .None => assert(false, "parse error: no outcome")
  );
});

// ---------------------------------------------------------------------------
// V7 task 1 (FORMAL_VERIFICATION.md): hover on a contract-bearing function
// shows its contracts + verification status.
// ---------------------------------------------------------------------------
_CONTRACT_DOC :: "pragma(Pragma.Verify);\n\nnon_zero :: ghost_fn((fn(x : i32) -> bool)(x != i32(0)));\n\nsafe_div :: (fn(num : i32, requires(num > i32(0)), ensures(r > i32(0))) -> (r : i32))(num);\n\ntakes_nz :: (fn(d : refine(i32, non_zero)) -> i32)(d);\n\nmain :: (fn() -> i32)(safe_div(takes_nz(i32(3))));\n";

/// The markdown `value` string out of a hover response
/// ({contents: {kind, value}, range}). Matched one enum level at a time —
/// nested patterns like `.Some(.Object(...))` do not parse.
_hover_text :: (fn(h : Option(JsonValue)) -> String)({
  (out : String) = String.new();
  root := match(
    h,
    .Some(x) => x,
    .None => {
      return(out);
    }
  );
  contents := match(
    root,
    .Object(ks, vs) => {
      (found : Option(JsonValue)) = Option(JsonValue).None;
      (i : usize) = usize(0);
      while(i < ks.len(), {
        match(
          ks.get(i),
          .Some(k) => {
            if(k == String.from("contents"), {
              match(
                vs.get(i),
                .Some(cv) => {
                  found = Option(JsonValue).Some(cv);
                },
                .None => ()
              );
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      match(
        found,
        .Some(f) => f,
        .None => {
          return(out);
        }
      )
    },
    _ => {
      return(out);
    }
  );
  match(
    contents,
    .Object(ks2, vs2) => {
      (j : usize) = usize(0);
      while(j < ks2.len(), {
        match(
          ks2.get(j),
          .Some(k2) => {
            if(k2 == String.from("value"), {
              match(
                vs2.get(j),
                .Some(vv) => {
                  match(
                    vv,
                    .Str(s) => {
                      out = s.clone();
                    },
                    _ => ()
                  );
                },
                .None => ()
              );
            });
          },
          .None => ()
        );
        j = (j + usize(1));
      });
    },
    _ => ()
  );
  out
});

test("hover shows contracts + verification status for a contracted function", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  doc_path := `${dir}/doc.yo`;
  io.await(write_string(Path.new(doc_path.clone()), String.from(_CONTRACT_DOC), io), ioexn);
  std_path := resolve_std_path();
  mm_forget_open_document(doc_path.clone());
  _pre := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), String.from(_CONTRACT_DOC), std_path.clone(), io),
    .Some(oc) => {
      assert(oc.ok && oc.parsed, "the contracted document analyzes ok");
      lines := String.from(_CONTRACT_DOC).split(String.from("\n"));
      // The call site `safe_div(` on the main line (row 8; the callee name
      // starts at column 22).
      hv := handle_hover(
        String.from(_CONTRACT_DOC),
        doc_path.clone(),
        lines,
        oc.exprs,
        oc.info_table,
        usize(8),
        usize(22)
      );
      assert(hv.is_some(), "hover answers on a contracted callee");
      text := _hover_text(hv);
      assert(
        text.contains(String.from("requires: num > i32(0)")),
        `hover renders the requires clause, got: ${text}`
      );
      assert(
        text.contains(String.from("ensures: r > i32(0)")),
        `hover renders the ensures clause, got: ${text}`
      );
      assert(
        text.contains(String.from("returns r")),
        `hover renders the return label, got: ${text}`
      );
      assert(
        text.contains(String.from("verification mode: verify")),
        `hover names the file's verification mode (pragma(Verify)), got: ${text}`
      );
      // The ghost_fn predicate referenced by the refinement (row 6; the
      // `non_zero` inside refine(i32, ...) starts at column 32).
      hg := handle_hover(
        String.from(_CONTRACT_DOC),
        doc_path.clone(),
        lines,
        oc.exprs,
        oc.info_table,
        usize(6),
        usize(32)
      );
      assert(hg.is_some(), "hover answers on a ghost_fn reference");
      gtext := _hover_text(hg);
      assert(
        gtext.contains(String.from("ghost_fn (spec-only")),
        `hover marks the ghost_fn as spec-only, got: ${gtext}`
      );
    },
    .None => assert(false, "contracted document: no outcome")
  );
});

// ---------------------------------------------------------------------------
// 2026-09-29 audit §2 (plans/archive/LSP_AUDIT_2026-09-29.md): rename validation +
// prepareRename, references includeDeclaration, documentSymbol typed
// declarations.
// ---------------------------------------------------------------------------
_TYPED_DECL :: "Point :: struct(x : i32, y : i32);\n(p : Point) = Point(x : 1, y : 2);\nanswer :: (fn() -> i32)({ return(((p.x) + (p.y))); });\n";
_MISSING_TOSTRING :: "{ println } :: import(\"std/fmt\");\nP2 :: struct(x : i32);\nmain :: (fn() -> unit)({\n  p := P2(x : i32(1));\n  println(p);\n  ()\n});\nexport(main);\n";
_SEM_DOC :: "{ String } :: import(\"std/string\");\ns := String.from(\"hi\");\nn := i32(41);\n// a note\n";
_ASTRAL_DOC :: "emoji := \"🎉\"; n := 1;\n";
_ML_COMMENT_DOC :: "/* one\n   two */\nx := 1;\n";
_FN_DECL_DOC :: "answer :: (fn() -> i32)(i32(42));\nmain :: (fn() -> unit)({ answer(); });\nexport(main);\n";
_IMPL_DOC :: "Show :: trait(show : (fn(self : Self) -> String));\nPoint :: struct(x : i32);\nimpl(Point, Show(show : (fn(self : Self) -> String)(String.from(\"p\"))));\nimpl(Point, show_dist : (fn(self : Self) -> String)(String.from(\"d\")));\nVec :: struct(y : i32);\nimpl(Vec, Show(show : (fn(self : Self) -> String)(String.from(\"v\"))));\n";
_LINKS_DOC :: "{ helper } :: import(\"./link_helper.yo\");\n{ println } :: import(\"std/fmt\");\nmain :: (fn() -> unit)({ println(\"x\"); () });\nexport(main);\n";
_RUNTIME_DECL_DOC :: "(c : i32) = i32(3);\nx := i32(4);\nthread_local(t) := i32(5);\n(thread_local(u) : i32) = i32(6);\n";

test("rename_rejection: only legal binding names pass", {
  // Legal identifiers (including single-underscore-private ones).
  assert(rename_rejection(String.from("p2")).is_none(), "plain identifier");
  assert(rename_rejection(String.from("Point")).is_none(), "capitalized identifier");
  assert(rename_rejection(String.from("_x")).is_none(), "underscore-private identifier");
  assert(rename_rejection(String.from("x_y_2")).is_none(), "digits after the first char");
  // Not identifiers at all — the parser is the authority.
  assert(rename_rejection(String.from("")).is_some(), "empty name");
  assert(rename_rejection(String.from("1 bad name")).is_some(), "spaces and a leading digit");
  assert(rename_rejection(String.from("123")).is_some(), "a number literal");
  assert(rename_rejection(String.from("a-b")).is_some(), "an operator character");
  assert(rename_rejection(String.from("true")).is_some(), "a bool literal");
  // Structural keywords never parse as binding names.
  assert(rename_rejection(String.from("fn")).is_some(), "the fn keyword");
  assert(rename_rejection(String.from("while")).is_some(), "the while keyword");
  assert(rename_rejection(String.from("return")).is_some(), "the return keyword");
  assert(rename_rejection(String.from("match")).is_some(), "the match keyword");
  // Plain-named builtin dispatch names parse as identifiers but are reserved
  // for bindings (src/token.yo).
  assert(rename_rejection(String.from("clone")).is_some(), "reserved builtin binding name");
  assert(rename_rejection(String.from("typeof")).is_some(), "reserved builtin binding name");
  assert(rename_rejection(String.from("___drop")).is_some(), "reserved unspellable name");
});

test("references honor context.includeDeclaration", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  doc_path := `${dir}/doc_typed.yo`;
  io.await(write_string(Path.new(doc_path.clone()), String.from(_TYPED_DECL), io), ioexn);
  std_path := resolve_std_path();
  mm_forget_open_document(doc_path.clone());
  _pre := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), String.from(_TYPED_DECL), std_path.clone(), io),
    .Some(oc) => {
      assert(oc.ok && oc.parsed, "the typed-decl document analyzes ok");
      lines := String.from(_TYPED_DECL).split(String.from("\n"));
      with_decl := json.stringify(
        handle_references(String.from(_TYPED_DECL), doc_path.clone(), lines, `file:///virtual/doc_typed.yo`, oc.exprs, oc.info_table, usize(1), usize(1), true)
      );
      without_decl := json.stringify(
        handle_references(String.from(_TYPED_DECL), doc_path.clone(), lines, `file:///virtual/doc_typed.yo`, oc.exprs, oc.info_table, usize(1), usize(1), false)
      );
      // The declaration (1:1) and both uses (2:35, 2:43) when included.
      assert(with_decl.contains("\"start\":{\"line\":1,\"character\":1}"), "includeDeclaration=true has the declaration");
      assert(with_decl.contains("\"start\":{\"line\":2,\"character\":35}"), "includeDeclaration=true has the first use");
      assert(with_decl.contains("\"start\":{\"line\":2,\"character\":43}"), "includeDeclaration=true has the second use");
      // Uses only when excluded (issues/fixed/lsp-references-ignore-include-declaration.md).
      assert(!without_decl.contains("\"start\":{\"line\":1,\"character\":1}"), "includeDeclaration=false drops the declaration");
      assert(without_decl.contains("\"start\":{\"line\":2,\"character\":35}"), "includeDeclaration=false keeps the first use");
      assert(without_decl.contains("\"start\":{\"line\":2,\"character\":43}"), "includeDeclaration=false keeps the second use");
      // Absent flag defaults to including it.
      defaulted := json.stringify(
        handle_references(String.from(_TYPED_DECL), doc_path.clone(), lines, `file:///virtual/doc_typed.yo`, oc.exprs, oc.info_table, usize(1), usize(1))
      );
      assert(defaulted.contains("\"start\":{\"line\":1,\"character\":1}"), "absent context defaults to includeDeclaration=true");
    },
    .None => assert(false, "typed-decl document: no outcome")
  );
});

test("documentSymbol lists typed top-level declarations", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  doc_path := `${dir}/doc_typed.yo`;
  io.await(write_string(Path.new(doc_path.clone()), String.from(_TYPED_DECL), io), ioexn);
  std_path := resolve_std_path();
  mm_forget_open_document(doc_path.clone());
  _pre := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), String.from(_TYPED_DECL), std_path.clone(), io),
    .Some(oc) => {
      lines := String.from(_TYPED_DECL).split(String.from("\n"));
      syms := json.stringify(handle_document_symbols(oc.exprs, lines));
      assert(syms.contains("\"name\":\"Point\",\"kind\":23"), "the struct binding keeps its Struct kind");
      assert(syms.contains("\"name\":\"answer\",\"kind\":12"), "the fn binding keeps its Function kind");
      assert(
        syms.contains("\"name\":\"p\",\"kind\":13"),
        "the typed declaration (p : Point) = … is a Variable symbol (issues/fixed/lsp-document-symbol-misses-typed-declarations.md)"
      );
    },
    .None => assert(false, "typed-decl document: no outcome")
  );
});

test("prepareRename answers on bindings, not on members or labels", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
