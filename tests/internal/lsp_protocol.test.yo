      all := json.stringify(handle_workspace_symbols(String.new(), ws));
      assert(all.contains("\"Point\"") && all.contains("\"answer\"") && all.contains("\"p\""), "an empty query lists every symbol");
      assert(all.contains("file:///virtual/ws-a.yo"), "each item points into its document");
      poin := json.stringify(handle_workspace_symbols(String.from("poin"), ws));
      assert(poin.contains("\"Point\""), "a case-insensitive substring query finds Point");
      assert(!poin.contains("\"answer\""), "non-matching symbols are left out");
      none := json.stringify(handle_workspace_symbols(String.from("zzzzz"), ws));
      assert_eq(none, String.from("[]"), "no match answers an empty array");
    },
    .None => assert(false, "typed-decl document: no outcome")
  );
});

