  match(
    diags.get(usize(0)),
    .Some(d) => {
      assert(d.code == Option(String).Some(String.from("E0602")), `the primary is the missing-trait error, got ${d.code.to_string()}`);
      assert_eq(d.related.len(), usize(1), "the std-anchored note is attached as related");
      match(
        d.related.get(usize(0)),
        .Some(r) => {
          assert(r.message.contains(String.from("raised here")), `the note's message, got ${r.message}`);
          assert(r.path.contains(String.from("index.yo")), `the note is anchored at std's where clause, got ${r.path}`);
        },
        .None => assert(false, "related entry missing")
      );
    },
    .None => assert(false, "primary diagnostic missing")
  );
});

test("semanticTokens: keywords, literals and comments from the lexer; identifiers from the analysis", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  doc_path := `${dir}/doc_typed.yo`;
  io.await(write_string(Path.new(doc_path.clone()), String.from(_TYPED_DECL), io), ioexn);
  std_path := resolve_std_path();
  mm_forget_open_document(doc_path.clone());
  _pre := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), String.from(_TYPED_DECL), std_path.clone(), io),
    .Some(oc) => {
      // 5-tuples: [deltaLine, deltaStartChar, length, type, modifiers].
      // _TYPED_DECL line 0: `Point :: struct(x : i32, y : i32);`
      // Point -> type (1), :: skipped, struct -> keyword (0), x/y -> property
      // (4, struct-field labels), i32 -> type (1).
      toks := json.stringify(handle_semantic_tokens(String.from(_TYPED_DECL), doc_path.clone(), oc.exprs, oc.info_table));
      assert(toks.contains("[0,0,5,1,0"), "Point is a 5-rune type token");
      assert(toks.contains(",0,9,6,0,0"), "struct is a keyword token");
      assert(toks.contains(",0,7,1,4,0"), "the struct-field label x is a property token");
      assert(toks.contains(",0,4,3,1,0"), "i32 is a 3-rune type token");
      // line 2: `answer :: (fn() -> i32)({ return(((p.x) + (p.y))); });`
      // answer -> function (2), fn -> keyword, p -> variable (3).
      assert(toks.contains(",1,0,6,2,0"), "answer is a 6-rune function token");
      assert(toks.contains(",0,11,2,0,0"), "fn is a keyword token");
      assert(toks.contains(",1,1,1,3,0"), "p is a 1-rune variable token");
    },
    .None => assert(false, "typed-decl document: no outcome")
  );
});

