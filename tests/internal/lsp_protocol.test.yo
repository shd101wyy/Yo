  _pre := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), String.from(_TYPED_DECL), std_path.clone(), io),
    .Some(oc) => {
      lines := String.from(_TYPED_DECL).split(String.from("\n"));
      flat := json.stringify(handle_document_symbols_flat(oc.exprs, lines, `file:///virtual/doc_typed.yo`));
      assert(flat.contains("\"location\":{\"uri\":\"file:///virtual/doc_typed.yo\""), "flat items carry a location with the document uri");
      assert(flat.contains("\"name\":\"Point\",\"kind\":23"), "the symbols and kinds are the same entries");
      assert(!flat.contains("selectionRange"), "no hierarchical-only field in the flat shape");
    },
    .None => assert(false, "typed-decl document: no outcome")
  );
});

test("documentSymbol lists runtime and thread_local declarations", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  doc_path := `${dir}/doc_runtime.yo`;
  text := String.from(_RUNTIME_DECL_DOC);
  io.await(write_string(Path.new(doc_path.clone()), text.clone(), io), ioexn);
  std_path := resolve_std_path();
  mm_forget_open_document(doc_path.clone());
  _pre := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), text.clone(), std_path.clone(), io),
    .Some(oc) => {
      lines := text.split(String.from("\n"));
      syms := json.stringify(handle_document_symbols(oc.exprs, lines));
      assert(syms.contains("\"name\":\"c\",\"kind\":13"), "the typed module constant is a Variable");
      assert(syms.contains("\"name\":\"x\",\"kind\":13"), "a top-level := runtime static is a Variable");
      assert(syms.contains("\"name\":\"t\",\"kind\":13"), "thread_local(name) := init is a Variable");
      assert(syms.contains("\"name\":\"u\",\"kind\":13"), "(thread_local(name) : T) = init is a Variable");
    },
    .None => assert(false, "runtime-decl document: no outcome")
  );
});

// ---------------------------------------------------------------------------
// The gaps the audit did not cover (2026-09-30 closeout, PR B):
// textDocument/implementation, textDocument/documentLink.
// ---------------------------------------------------------------------------
test("implementation: a trait cursor lists this file's impls of it; a type cursor lists its impls", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  doc_path := `${dir}/doc_impl.yo`;
  text := String.from(_IMPL_DOC);
  io.await(write_string(Path.new(doc_path.clone()), text.clone(), io), ioexn);
  std_path := resolve_std_path();
  mm_forget_open_document(doc_path.clone());
  _pre := mm_invalidate_document(doc_path.clone());
  match(
    _analyze(doc_path.clone(), text.clone(), std_path.clone(), io),
    .Some(oc) => {
      assert(oc.parsed, "the impl document parses");
      // Cursor on the trait Show (line 0, column 1): both impls that
      // implement Show — Point's and Vec's — and NOT Point's inherent
      // impl (no trait argument).
      from_trait := json.stringify(
        handle_implementations(text.clone(), doc_path.clone(), `file:///virtual/doc_impl.yo`, text.split(String.from("\n")), oc.exprs, usize(0), usize(1))
      );
      assert(from_trait.contains("\"line\":2"), "Point's trait impl is offered from the trait");
      assert(from_trait.contains("\"line\":5"), "Vec's trait impl is offered from the trait");
      assert(!from_trait.contains("\"line\":3"), "Point's INHERENT impl (no trait) is not offered from the trait");
      // Cursor on the type Point (line 1, column 1): both of Point's impls.
      from_type := json.stringify(
        handle_implementations(text.clone(), doc_path.clone(), `file:///virtual/doc_impl.yo`, text.split(String.from("\n")), oc.exprs, usize(1), usize(1))
      );
      assert(from_type.contains("\"line\":2"), "Point's trait impl is offered from the type");
      assert(from_type.contains("\"line\":3"), "Point's inherent impl is offered from the type");
      assert(!from_type.contains("\"line\":5"), "Vec's impl is not offered from Point");
    },
    .None => assert(false, "impl document: no outcome")
  );
});

test("documentLink: import paths link to the files they name", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, `test io failed: ${err}`);
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := `/tmp/yo_lsp_protocol_fixture`;
  io.await(create_dir_all(Path.new(dir.clone()), io), ioexn);
  helper_path := `${dir}/link_helper.yo`;
  io.await(write_string(Path.new(helper_path.clone()), String.from("helper :: (fn() -> i32)(i32(1));\nexport(helper);\n"), io), ioexn);
  doc_path := `${dir}/doc_links.yo`;
  text := String.from(_LINKS_DOC);
  io.await(write_string(Path.new(doc_path.clone()), text.clone(), io), ioexn);
  std_path := resolve_std_path();
  mm_forget_open_document(doc_path.clone());
  mm_forget_open_document(helper_path.clone());
  _pre := mm_invalidate_document(doc_path.clone());
  _pre2 := mm_invalidate_document(helper_path.clone());
  match(
    _analyze(doc_path.clone(), text.clone(), std_path.clone(), io),
    .Some(oc) => {
      assert(oc.ok && oc.parsed, "the links document analyzes ok");
      lines := text.split(String.from("\n"));
      links := json.stringify(handle_document_links(text.clone(), doc_path.clone(), lines, std_path.clone()));
      // The relative import links to the helper file next to the document;
      // the std import links into std/fmt. Both carry the quoted-string
      // range on their line.
      assert(links.contains("link_helper.yo"), "the ./ import resolves to the sibling file");
      assert(links.contains("std/fmt"), "the std/ import resolves into the std path");
      assert(links.contains("\"start\":{\"line\":0,\"character\":21}"), "the first link's range starts at the opening quote");
      assert((links.split("target").len() - usize(1)) == usize(2), "exactly two links — the two imports");
    },
    .None => assert(false, "links document: no outcome")
  );
});
