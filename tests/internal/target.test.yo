open(import("std/fmt"));
open(import("std/string"));
{ assert, panic } :: import("std/assert");
{
  Arch,
  Os,
  Abi,
  TargetInfo,
  HostInfo,
  arch_to_str,
  os_to_str,
  abi_to_str,
  parse_arch,
  parse_os,
  parse_abi,
  pointer_size_for_arch,
  detect_host,
  parse_target,
  clang_triple,
  is_target_windows,
  is_target_linux,
  is_target_macos,
  is_target_wasm,
  is_target_emscripten,
  is_target_standalone_wasi,
  is_target_musl,
  is_target_posix
} :: import("../../yo-self/target.yo");
// ---------------------------------------------------------------------------
// arch_to_str / os_to_str / abi_to_str
// ---------------------------------------------------------------------------
test("arch_to_str: all variants", {
  assert(arch_to_str(Arch.X86_64) == "x86_64", "x86_64");
  assert(arch_to_str(Arch.Aarch64) == "aarch64", "aarch64");
  assert(arch_to_str(Arch.X86) == "x86", "x86");
  assert(arch_to_str(Arch.Arm) == "arm", "arm");
  assert(arch_to_str(Arch.Wasm32) == "wasm32", "wasm32");
});
test("os_to_str: all variants", {
  assert(os_to_str(Os.Linux) == "linux", "linux");
  assert(os_to_str(Os.Macos) == "macos", "macos");
  assert(os_to_str(Os.Windows) == "windows", "windows");
  assert(os_to_str(Os.FreeBSD) == "freebsd", "freebsd");
  assert(os_to_str(Os.Wasi) == "wasi", "wasi");
  assert(os_to_str(Os.Emscripten) == "emscripten", "emscripten");
});
test("abi_to_str: all variants", {
  assert(abi_to_str(Abi.Gnu) == "gnu", "gnu");
  assert(abi_to_str(Abi.Musl) == "musl", "musl");
  assert(abi_to_str(Abi.Msvc) == "msvc", "msvc");
  assert(abi_to_str(Abi.Wasm_) == "wasm", "wasm");
});
// ---------------------------------------------------------------------------
// parse_arch / parse_os / parse_abi
// ---------------------------------------------------------------------------
test("parse_arch: valid inputs", {
  assert(parse_arch(String.from("x86_64")).is_some(), "x86_64 is Some");
  assert(parse_arch(String.from("aarch64")).is_some(), "aarch64 is Some");
  assert(parse_arch(String.from("wasm32")).is_some(), "wasm32 is Some");
});
test("parse_arch: invalid input returns None", {
  assert(parse_arch(String.from("mips")).is_none(), "mips is None");
  assert(parse_arch(String.from("")).is_none(), "empty is None");
});
test("parse_os: valid inputs", {
  assert(parse_os(String.from("linux")).is_some(), "linux is Some");
  assert(parse_os(String.from("macos")).is_some(), "macos is Some");
  assert(parse_os(String.from("windows")).is_some(), "windows is Some");
  assert(parse_os(String.from("emscripten")).is_some(), "emscripten is Some");
});
test("parse_os: invalid input returns None", {
  assert(parse_os(String.from("solaris")).is_none(), "solaris is None");
});
test("parse_abi: valid inputs", {
  assert(parse_abi(String.from("gnu")).is_some(), "gnu is Some");
  assert(parse_abi(String.from("musl")).is_some(), "musl is Some");
  assert(parse_abi(String.from("msvc")).is_some(), "msvc is Some");
  assert(parse_abi(String.from("wasm")).is_some(), "wasm is Some");
});
test("parse_abi: invalid input returns None", {
  assert(parse_abi(String.from("unknown")).is_none(), "unknown is None");
});
// ---------------------------------------------------------------------------
// pointer_size_for_arch
// ---------------------------------------------------------------------------
test("pointer_size_for_arch: 64-bit arches", {
  assert(pointer_size_for_arch(Arch.X86_64) == u32(64), "x86_64 is 64-bit");
  assert(pointer_size_for_arch(Arch.Aarch64) == u32(64), "aarch64 is 64-bit");
});
test("pointer_size_for_arch: 32-bit arches", {
  assert(pointer_size_for_arch(Arch.X86) == u32(32), "x86 is 32-bit");
  assert(pointer_size_for_arch(Arch.Arm) == u32(32), "arm is 32-bit");
  assert(pointer_size_for_arch(Arch.Wasm32) == u32(32), "wasm32 is 32-bit");
});
// ---------------------------------------------------------------------------
// parse_target
// ---------------------------------------------------------------------------
test("parse_target: two-part triple (arch-os)", {
  result := parse_target(String.from("x86_64-linux"));
  assert(result.is_ok(), "x86_64-linux is Ok");
  ti := match(
    result,
    .Ok(v) => v,
    .Err(_) => {
      assert(false, "not err");
      TargetInfo(arch : Arch.X86_64, os : Os.Linux, abi : Option(Abi).None, pointer_size_bits : u32(0), triple : String.new())
    }
  );
  assert(ti.arch == Arch.X86_64, "arch is x86_64");
  assert(ti.os == Os.Linux, "os is linux");
  assert(ti.pointer_size_bits == u32(64), "pointer is 64 bit");
});
test("parse_target: three-part triple (arch-os-abi)", {
  result := parse_target(String.from("x86_64-linux-musl"));
  assert(result.is_ok(), "x86_64-linux-musl is Ok");
  ti := match(
    result,
    .Ok(v) => v,
    .Err(_) => {
      assert(false, "not err");
      TargetInfo(arch : Arch.X86_64, os : Os.Linux, abi : Option(Abi).None, pointer_size_bits : u32(0), triple : String.new())
    }
  );
  assert(ti.arch == Arch.X86_64, "arch");
  assert(ti.os == Os.Linux, "os");
  assert(ti.abi == Option(Abi).Some(Abi.Musl), "abi is musl");
  assert(ti.triple == "x86_64-linux-musl", "triple string");
});
test("parse_target: wasm shorthand", {
  result := parse_target(String.from("wasm-wasi"));
  assert(result.is_ok(), "wasm-wasi is Ok");
  ti := match(
    result,
    .Ok(v) => v,
    .Err(_) => {
      assert(false, "not err");
      TargetInfo(arch : Arch.X86_64, os : Os.Linux, abi : Option(Abi).None, pointer_size_bits : u32(0), triple : String.new())
    }
  );
  assert(ti.arch == Arch.Wasm32, "arch is wasm32");
  assert(ti.os == Os.Wasi, "os is wasi");
});
test("parse_target: aarch64-macos (no ABI)", {
  result := parse_target(String.from("aarch64-macos"));
  assert(result.is_ok(), "aarch64-macos is Ok");
  ti := match(
    result,
    .Ok(v) => v,
    .Err(_) => {
      assert(false, "not err");
      TargetInfo(arch : Arch.X86_64, os : Os.Linux, abi : Option(Abi).None, pointer_size_bits : u32(0), triple : String.new())
    }
  );
  assert(ti.abi == Option(Abi).None, "no ABI for macos");
  assert(ti.triple == "aarch64-macos", "triple string");
});
test("parse_target: invalid triple returns Err", {
  result := parse_target(String.from("badarch-linux"));
  assert(result.is_err(), "invalid arch returns Err");
});
test("parse_target: abi=none overrides default", {
  result := parse_target(String.from("x86_64-linux-none"));
  assert(result.is_ok(), "x86_64-linux-none is Ok");
  ti := match(
    result,
    .Ok(v) => v,
    .Err(_) => {
      assert(false, "not err");
      TargetInfo(arch : Arch.X86_64, os : Os.Linux, abi : Option(Abi).None, pointer_size_bits : u32(0), triple : String.new())
    }
  );
  assert(ti.abi == Option(Abi).None, "abi=none gives None");
});
// ---------------------------------------------------------------------------
// clang_triple
// ---------------------------------------------------------------------------
test("clang_triple: linux gnu", {
  ti := TargetInfo(
    arch : Arch.X86_64,
    os : Os.Linux,
    abi : Option(Abi).Some(Abi.Gnu),
    pointer_size_bits : u32(64),
    triple : String.from("x86_64-linux-gnu")
  );
  s := clang_triple(ti);
  assert(s == "x86_64-linux-gnu", "linux gnu clang triple");
});
test("clang_triple: macos", {
  ti := TargetInfo(
    arch : Arch.Aarch64,
    os : Os.Macos,
    abi : Option(Abi).None,
    pointer_size_bits : u32(64),
    triple : String.from("aarch64-macos")
  );
  s := clang_triple(ti);
  assert(s == "aarch64-apple-darwin", "macos clang triple");
});
test("clang_triple: wasi", {
  ti := TargetInfo(
    arch : Arch.Wasm32,
    os : Os.Wasi,
    abi : Option(Abi).Some(Abi.Wasm_),
    pointer_size_bits : u32(32),
    triple : String.from("wasm32-wasi")
  );
  s := clang_triple(ti);
  assert(s == "wasm32-wasi", "wasi clang triple");
});
// ---------------------------------------------------------------------------
// Convenience queries
// ---------------------------------------------------------------------------
test("is_target_* queries", {
  linux_ti := TargetInfo(
    arch : Arch.X86_64,
    os : Os.Linux,
    abi : Option(Abi).Some(Abi.Gnu),
    pointer_size_bits : u32(64),
    triple : String.from("x86_64-linux-gnu")
  );
  wasm_ti := TargetInfo(
    arch : Arch.Wasm32,
    os : Os.Wasi,
    abi : Option(Abi).Some(Abi.Wasm_),
    pointer_size_bits : u32(32),
    triple : String.from("wasm32-wasi")
  );
  assert(is_target_linux(linux_ti), "linux is linux");
  assert(!(is_target_windows(linux_ti)), "linux is not windows");
  assert(is_target_posix(linux_ti), "linux is posix");
  assert(is_target_wasm(wasm_ti), "wasi is wasm");
  assert(is_target_standalone_wasi(wasm_ti), "wasi is standalone_wasi");
  assert(!(is_target_posix(wasm_ti)), "wasm is not posix");
});
test("detect_host: returns HostInfo with valid fields", {
  host := detect_host();
  // Just verify the returned value is structurally valid (non-zero pointer_size would prove it)
  // We can't assert a specific OS/arch since tests run on different machines
  assert(true, "detect_host returned without panic");
});
