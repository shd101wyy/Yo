/// Tests for yo-self/evaluator/exprs/assignment.yo — Phase 2v
///
/// Covers:
///   - `throw_rhs_contains_control_flow_expression_error`
///     * cond / match / begin / other RHS all throw
///   - `evaluate_assignment`
///     * atom LHS happy path: x = true, ExprInfo set
///     * variable not found → throws
///     * non-reassignable variable → throws
///     * type mismatch → throws
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../yo-self/token.yo");
{
  AstExpr,
  ast_expr_id,
  BK_ASSIGN,
  BK_COLON,
  BK_COND,
  BK_MATCH,
  BK_BEGIN,
  make_err_expr
} :: import("../../yo-self/expr.yo");
{
  ExprInfo,
  ExprInfoTable,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  ControlFlowKind,
  ControlFlowFlags,
  control_flow_of
} :: import("../../yo-self/expr_info.yo");
{ Environment, add_variable_to_env } :: import("../../yo-self/env.yo");
{ EvalContext, eval_context_new } :: import("../../yo-self/evaluator/context.yo");
{ EvalValue } :: import("../../yo-self/value.yo");
{ TypeValue } :: import("../../yo-self/types/definitions.yo");
{ t_bool, t_i32, t_unit } :: import("../../yo-self/types/creators.yo");
{ set_evaluate_expression_fn, set_evaluate_expression_raw_fn } :: import("../../yo-self/evaluator/exprs/expr.yo");
{
  throw_rhs_contains_control_flow_expression_error,
  evaluate_assignment
} :: import("../../yo-self/evaluator/exprs/assignment.yo");
{ Exception } :: import("std/error");
{ assert, panic } :: import("std/assert");
// ---------------------------------------------------------------------------
// Helpers — shared across all tests
// ---------------------------------------------------------------------------
mk_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
mk_ident :: (fn(id : usize, name : str) -> AstExpr)(
  AstExpr.Atom(id, mk_token(TokenKind.Identifier, name))
);
mk_op_atom :: (fn(id : usize, op : str) -> AstExpr)(
  AstExpr.Atom(id, mk_token(TokenKind.Operator, op))
);
/// Build `op(args…)` FnCall — callee is Atom with an Operator token.
mk_op_call :: (fn(id : usize, op : str, args : ArrayList(AstExpr)) -> AstExpr)({
  callee := mk_op_atom(id + usize(10000), op);
  AstExpr.FnCall(id, callee, args, true, mk_token(TokenKind.Operator, op))
});
/// Build `name(args…)` FnCall — callee is Atom with an Identifier token.
mk_ident_call :: (fn(id : usize, name : str, args : ArrayList(AstExpr)) -> AstExpr)({
  callee := mk_ident(id + usize(10000), name);
  AstExpr.FnCall(id, callee, args, false, mk_token(TokenKind.Identifier, name))
});
/// Build `lhs = rhs` expression.
mk_assign :: (fn(id : usize, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  mk_op_call(id, BK_ASSIGN, args)
});
/// Stub evaluator: stores t_bool() + BoolVal(true) ExprInfo for any expr.
stub_eval_bool :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  info := new_expr_info(env, t_bool());
  info.value = .Some(EvalValue.BoolVal(true));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
/// Stub evaluator: stores t_i32() + IntLit("42") ExprInfo for any expr.
stub_eval_i32 :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  info := new_expr_info(env, t_i32());
  info.value = .Some(EvalValue.IntLit(String.from("42")));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
/// Raw (exn-threading) variants: `evaluate_assignment` dispatches the RHS
/// through `evaluate_expression_raw` (the propagating path), so tests must
/// register the raw hook too.
stub_eval_bool_raw :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  exn;
  info := new_expr_info(env, t_bool());
  info.value = .Some(EvalValue.BoolVal(true));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
stub_eval_i32_raw :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  exn;
  info := new_expr_info(env, t_i32());
  info.value = .Some(EvalValue.IntLit(String.from("42")));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
// ---------------------------------------------------------------------------
// throw_rhs_contains_control_flow_expression_error
// ---------------------------------------------------------------------------
/// Returns true iff calling `throw_rhs_contains_control_flow_expression_error`
/// with the given expression throws.
cf_error_throws :: (fn(rhs : AstExpr) -> bool)({
  exn := Exception(
    throw : (
      (err) -> {
        unwind(true);
      }
    )
  );
  cf := control_flow_of(ControlFlowKind.Return);
  throw_rhs_contains_control_flow_expression_error(rhs, cf, exn);
  false
});
test("cf_error: cond rhs throws", {
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(1), "x"));
  rhs := mk_ident_call(usize(100), BK_COND, args);
  assert(cf_error_throws(rhs), "expected throw for cond rhs");
});
test("cf_error: match rhs throws", {
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(2), "x"));
  rhs := mk_ident_call(usize(101), BK_MATCH, args);
  assert(cf_error_throws(rhs), "expected throw for match rhs");
});
test("cf_error: begin rhs throws", {
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(3), "x"));
  rhs := mk_ident_call(usize(102), BK_BEGIN, args);
  assert(cf_error_throws(rhs), "expected throw for begin rhs");
});
test("cf_error: other rhs throws", {
  rhs := mk_ident(usize(200), "some_expr");
  assert(cf_error_throws(rhs), "expected throw for any rhs with control flow");
});
// ---------------------------------------------------------------------------
// evaluate_assignment — happy path
// ---------------------------------------------------------------------------
test("evaluate_assignment: atom LHS — ExprInfo set with unit type", {
  set_evaluate_expression_fn(stub_eval_bool);
  set_evaluate_expression_raw_fn(stub_eval_bool_raw);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  tok := mk_token(TokenKind.Identifier, "x");
  _v := add_variable_to_env(
    env,
    String.from("x"),
    t_bool(),
    Option(EvalValue).None,
    false,
    true,
    false,
    false,
    tok
  );
  lhs := mk_ident(usize(1), "x");
  rhs := mk_ident(usize(2), "true");
  expr := mk_assign(usize(10), lhs, rhs);
  result := evaluate_assignment(expr, env, ctx, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  assert(match(info_opt, .Some(_) => true, .None => false), "ExprInfo should be set on assignment expr");
});
test("evaluate_assignment: atom LHS reassignment — ExprInfo carries old value/type", {
  set_evaluate_expression_fn(stub_eval_bool);
  set_evaluate_expression_raw_fn(stub_eval_bool_raw);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  tok := mk_token(TokenKind.Identifier, "x");
  _v := add_variable_to_env(
    env,
    String.from("x"),
    t_bool(),
    Option(EvalValue).None,
    false,
    true,
    false,
    false,
    tok
  );
  lhs := mk_ident(usize(3), "x");
  rhs := mk_ident(usize(4), "true");
  expr := mk_assign(usize(20), lhs, rhs);
  result := evaluate_assignment(expr, env, ctx, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  // Real REASSIGNMENT (x already defined): mirrors assignment.ts:759-800 —
  // the expr info carries the OLD value and the variable's type (so codegen
  // saves/drops the old value), NOT UnitVal (that's the initialization /
  // consumed-by-RHS arm). x has no compile-time value here → value is None.
  match(
    info_opt,
    .Some(info) => {
      assert(
        match(info.value, .Some(_) => false, .None => true),
        "reassignment info carries the (absent) old value, not UnitVal"
      );
      assert(
        match(info.ty, .BoolT => true, _ => false),
        "reassignment info type is the variable's type"
      );
    },
    .None => assert(false, "ExprInfo not set")
  );
});
// ---------------------------------------------------------------------------
// evaluate_assignment — error cases
// ---------------------------------------------------------------------------
/// Returns true iff evaluate_assignment throws when the variable is absent.
test_assign_missing_var_throws :: (fn() -> bool)({
  set_evaluate_expression_fn(stub_eval_bool);
  set_evaluate_expression_raw_fn(stub_eval_bool_raw);
  exn := Exception(
    throw : (
      (err) -> {
        unwind(true);
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  // No variable added — "missing_var" will not be found.
  lhs := mk_ident(usize(50), "missing_var");
  rhs := mk_ident(usize(51), "true");
  expr := mk_assign(usize(500), lhs, rhs);
  _r := evaluate_assignment(expr, env, ctx, exn);
  false
});
test("evaluate_assignment: variable not found throws", {
  assert(test_assign_missing_var_throws(), "expected error for missing variable");
});
/// Returns true iff evaluate_assignment throws for a non-reassignable variable.
test_assign_non_reassignable_throws :: (fn() -> bool)({
  set_evaluate_expression_fn(stub_eval_bool);
  set_evaluate_expression_raw_fn(stub_eval_bool_raw);
  exn := Exception(
    throw : (
      (err) -> {
        unwind(true);
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  tok := mk_token(TokenKind.Identifier, "x");
  _v := add_variable_to_env(
    env,
    String.from("x"),
    t_bool(),
    Option(EvalValue).None,
    false,
    false,
    // is_reassignable = false
    false,
    false,
    tok
  );
  lhs := mk_ident(usize(60), "x");
  rhs := mk_ident(usize(61), "true");
  expr := mk_assign(usize(600), lhs, rhs);
  _r := evaluate_assignment(expr, env, ctx, exn);
  false
});
test("evaluate_assignment: non-reassignable variable throws", {
  assert(test_assign_non_reassignable_throws(), "expected error for non-reassignable variable");
});
/// Returns true iff evaluate_assignment throws for a type mismatch (bool var, i32 rhs).
test_assign_type_mismatch_throws :: (fn() -> bool)({
  set_evaluate_expression_fn(stub_eval_i32);
  set_evaluate_expression_raw_fn(stub_eval_i32_raw);
  exn := Exception(
    throw : (
      (err) -> {
        unwind(true);
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  tok := mk_token(TokenKind.Identifier, "x");
  _v := add_variable_to_env(
    env,
    String.from("x"),
    t_bool(),
    Option(EvalValue).None,
    false,
    true,
    false,
    false,
    tok
  );
  lhs := mk_ident(usize(70), "x");
  rhs := mk_ident(usize(71), "42");
  expr := mk_assign(usize(700), lhs, rhs);
  _r := evaluate_assignment(expr, env, ctx, exn);
  false
});
test("evaluate_assignment: type mismatch throws", {
  assert(test_assign_type_mismatch_throws(), "expected error for type mismatch bool vs i32");
});
