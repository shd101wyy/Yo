//! Quick smoke test for the TypeValue enum and its constructors/predicates.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeTag } :: import("../../yo-self/types/tags.yo");
{ TypeValue } :: import("../../yo-self/types/definitions.yo");
{ type_value_tag, t_i32, t_u8, t_f32, t_usize, t_unit, t_bool, t_ptr, t_str, t_array } :: import("../../yo-self/types/creators.yo");
{ is_int_type, is_signed_int_type, is_numeric_type, is_pointer_type, is_str_type, is_array_type } :: import("../../yo-self/types/guards.yo");
{ assert, panic } :: import("std/assert");
test("primitive constructors and tags", {
  ti32 := t_i32();
  tu8t := t_u8();
  tf32 := t_f32();
  tunit := t_unit();
  tbl := t_bool();
  assert(type_value_tag(ti32) == TypeTag.TI32, "i32 tag");
  assert(type_value_tag(tu8t) == TypeTag.TU8, "u8 tag");
  assert(type_value_tag(tf32) == TypeTag.TF32, "f32 tag");
  assert(type_value_tag(tunit) == TypeTag.TUnit, "unit tag");
  assert(type_value_tag(tbl) == TypeTag.TBool, "bool tag");
});
test("is_int / is_signed / is_numeric", {
  assert(is_int_type(t_i32()), "i32 is int");
  assert(is_int_type(t_u8()), "u8 is int");
  assert(!(is_int_type(t_f32())), "f32 is not int");
  assert(is_signed_int_type(t_i32()), "i32 signed");
  assert(!(is_signed_int_type(t_u8())), "u8 unsigned");
  assert(is_numeric_type(t_f32()), "f32 numeric");
  assert(is_numeric_type(t_usize()), "usize numeric");
  assert(!(is_numeric_type(t_unit())), "unit not numeric");
});
test("compound types — pointer / str / array", {
  pi32 := t_ptr(t_i32());
  ai32 := t_array(t_i32(), usize(8));
  assert(is_pointer_type(pi32), "ptr is ptr");
  assert(is_str_type(t_str()), "str is str");
  assert(is_array_type(ai32), "array is array");
  assert(type_value_tag(pi32) == TypeTag.TPtr, "ptr tag");
  assert(type_value_tag(t_str()) == TypeTag.TStr, "str tag");
  assert(type_value_tag(ai32) == TypeTag.TArray, "array tag");
  // Nested pointer
  ppi32 := t_ptr(t_ptr(t_i32()));
  match(
    ppi32,
    .Pointer(p1) => match(
      p1,
      .Pointer(p2) => match(
        p2,
        .Int(bits, signed) => {
          assert(bits == u8(32), "inner i32 width");
          assert(signed, "inner i32 signed");
        },
        _ => assert(false, "expected inner Int")
      ),
      _ => assert(false, "expected ptr ptr")
    ),
    _ => assert(false, "expected outer Pointer")
  );
  // Array length stored
  match(
    ai32,
    .Array(_, len, _) => assert(len == usize(8), "array length 8"),
    _ => assert(false, "expected Array")
  );
});
