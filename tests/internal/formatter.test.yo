/// Tests for format_yo_source (formatter.yo) — the source formatter had no
/// dedicated test (only an indirect whole-tree sweep, now `yo fmt --check`
/// plus the write-idempotence check in gates_fast.sh GATE 6).
/// Pin the cheap invariants: idempotency (format(format(x)) == format(x)),
/// stability of already-formatted input, and comment preservation.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ format_yo_source } :: import("../../src/formatter.yo");
{ assert, panic } :: import("std/assert");
_fmt :: (fn(src : String) -> String)({
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "formatter threw");
        unwind(String.new());
      }
    )
  );
  format_yo_source(src, `<formatter-test>`, exn)
});
test("format_yo_source: empty input", {
  assert(_fmt(String.from("")) == "", "empty stays empty");
});
test("format_yo_source: idempotent on a simple function", {
  src := String.from("f :: (fn(x : i32) -> i32)((x + 1));\nexport(f);\n");
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "format is idempotent");
});
test("format_yo_source: already-formatted source is stable", {
  src := String.from("x := 1;\n");
  assert(_fmt(src.clone()) == src, "canonical form unchanged");
});
test("format_yo_source: preserves comments", {
  src := String.from("// keep me\nx := 1;\n");
  out := _fmt(src.clone());
  assert(out.contains(`// keep me`), "line comment preserved");
});
test("format_yo_source: idempotent on nested calls and match", {
  src := String.from("g :: (fn(o : Option(i32)) -> i32)(match(o, .Some(v) => v, .None => 0));\nexport(g);\n");
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "nested form idempotent");
});
// ---------------------------------------------------------------------------
// Fixture corpus — the 46 (input → expected) pairs script-extracted VERBATIM
// from src/tests/formatter.test.ts (P2.4). Each .input is deliberately
// NON-canonical source (the suffix is not .yo so GATE 6's `fmt --check
// ./tests` skips them); the .expected next to it is the canonical output the
// TS formatter produced and pinned. This is the coverage GATE 6 cannot give:
// a whole-tree `fmt --check` only proves already-canonical text stays
// canonical, never that messy input NORMALIZES correctly.
// Assumes the runner's cwd is the repo root (how `yo test` and CI run).
// ---------------------------------------------------------------------------
{ Path } :: import("std/path");
fs_dir :: import("std/fs/dir");
fs_file :: import("std/fs/file");
test("format_yo_source: fixture corpus from formatter.test.ts", {
  exn := Exception(
    throw : (
      err -> {
        println(`  unexpected io error: ${err}`);
        assert(false, "fixture io failed");
        unwind(());
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := String.from("tests/internal/formatter_fixtures");
  entries := io.await(fs_dir.read_dir(Path.new(dir.clone()), io), ioexn);
  (checked : usize) = usize(0);
  (failed : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < entries.len(), {
    match(
      entries.get(i),
      .Some(e) => if(e.name.ends_with(`.input`), {
        base := e.name.substring(usize(0), e.name.len() - usize(6));
        input := io.await(fs_file.read_to_string(Path.new(`${dir}/${base}.input`), io), ioexn);
        expected := io.await(fs_file.read_to_string(Path.new(`${dir}/${base}.expected`), io), ioexn);
        got := _fmt(input);
        if(got != expected, {
          println(`  FIXTURE FAILED: ${base}`);
          failed = (failed + usize(1));
        });
        checked = (checked + usize(1));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  println(`  ${checked.to_string()} fixtures checked`);
  assert(failed == usize(0), "some formatter fixtures diverged (see above)");
  assert(checked >= usize(46), "fixture corpus missing (cwd must be the repo root)");
});
test("format_yo_source: a template string AFTER a multibyte character survives", {
  // `read_raw_template_string` re-reads the template literal out of `input`
  // by byte offset. It used to be handed `Token.character` — a RUNE index —
  // and re-walked the buffer to convert; D4 PR 3 gave `Token` a real
  // `byte_offset` and deleted that walk. Either way the failure mode is the
  // same class: with a multibyte character EARLIER in the file the slice
  // starts early and swallows the source before the backtick, producing
  // non-parseable output at rc=0
  // (issues/fixed/yo-self-formatter-corrupts-files-with-non-ascii.md — 23 of
  // 40 sampled std files with a backtick came out broken).
  //
  // The em dash below is what makes this test discriminating; the same source
  // with an ASCII hyphen passes under a broken conversion.
  src := String.from("//! doc — with an em dash\nf :: (fn(x : String) -> String)(`v=${x}`);\nexport(f);\n");
  out := _fmt(src);
  assert(out.contains(String.from("`v=${x}`")), "the template literal is intact");
  assert(!out.contains(String.from("`v=${x}`;\n`")), "no duplicated tail");
  assert(_fmt(out) == out, "and formatting is idempotent");
});
test("format_yo_source: multibyte content inside a template string is preserved", {
  src := String.from("g :: (fn() -> String)(`名前 → ${String.new()}`);\nexport(g);\n");
  out := _fmt(src);
  assert(out.contains(String.from("名前 → ${String.new()}")), "multibyte body intact");
  assert(_fmt(out) == out, "idempotent");
});
// ---------------------------------------------------------------------------
// Paren elision (plans/FMT_PAREN_ELISION.md D1-D3) — the decision table.
// `_fmt` runs format_yo_source, whose re-parse gate is the
// meaning-preservation backstop; these pin the canonical OUTPUTS.
// ---------------------------------------------------------------------------
test("fmt elision D1: atom-like groups in infix-operand position", {
  src := String.from("f :: (fn(x : i32, y : i32) -> i32)((x) + (y));\nexport(f);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("(x + y)")), "operand parens around atoms elide");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D1: atom group after a non-allow-list operator", {
  src := String.from("f :: (fn(x : i32, y : i32) -> i32)(x - (y));\nexport(f);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("(x - y)")), "RHS atom group elides after infix -");
});
test("fmt elision D1: prefix-result group elides after :=", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  y := (-x);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -x;")), "(-x) elides to -x on := RHS");
});
test("fmt elision D2: left same-operator group flattens", {
  src := String.from("f :: (fn() -> i32)(((1 + 2) + 3));\nexport(f);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("(1 + 2 + 3)")), "((1 + 2) + 3) flattens to (1 + 2 + 3)");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D2: flatten inside a retained := group", {
  src := String.from("main :: (fn() -> unit)({\n  y := (((1 + 2) + 3));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := (1 + 2 + 3);")), "one level kept, inner flattened");
});
test("fmt elision D3: prefix call parens elide", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  y := -(x);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -x;")), "-(x) elides to -x");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D3: prefix chains normalize to the bare form", {
  src := String.from("T :: ?(*(i32));\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("T :: ?*i32;")), "?(*(i32)) elides to ?*i32");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D3: prefix call over a dot-chain elides", {
  src := String.from("main :: (fn() -> unit)({\n  p := Pair(a : 7);\n  y := -(p.a);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -p.a;")), "-(p.a) elides to -p.a");
});
test("fmt elision D3: prefix call in argument position elides", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  sink(-(x) + 2);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink(-x + 2)")), "-(x) + 2 elides to -x + 2 in an argument");
});
test("fmt elision R1: := RHS infix chain keeps its group", {
  src := String.from("main :: (fn() -> unit)({\n  y := (1 + 2);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := (1 + 2);")), "y := 1 + 2 is illegal — group stays");
  assert(_fmt(out.clone()) == out, "stable");
});
test("fmt elision R2: right operand groups stay", {
  src := String.from("main :: (fn() -> unit)({\n  sink(3 + (4 - 5));\n  sink(3 + (4 + 5));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink(3 + (4 - 5))")), "mixed right group stays");
  assert(out.contains(String.from("sink(3 + (4 + 5))")), "same-op right group stays");
});
test("fmt elision R3: mixed-operator left group stays", {
  src := String.from("main :: (fn() -> unit)({\n  sink((3 + 4) - 5);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink((3 + 4) - 5)")), "mixed operators need the group");
});
test("fmt elision R3: prefix call with infix argument stays", {
  src := String.from("main :: (fn() -> unit)({\n  y := -((1 + 2));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -(1 + 2);")), "prefix binds ONE postfix expr — call parens stay");
});
test("fmt elision R4: multi-arg operator call stays", {
  src := String.from("main :: (fn() -> unit)({\n  y := -((1, 2));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -((1, 2));")), "comma argument keeps BOTH paren levels");
});
test("fmt elision: operator atom stays parenthesized", {
  src := String.from("my_not :: (!);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("my_not :: (!);")), "(!) is a value, not a grouping");
});
test("fmt elision: comment inside a candidate group blocks elision", {
  src := String.from("main :: (fn() -> unit)({\n  y := ((/* keep */ 1 + 2));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("/* keep */")), "comment preserved");
  assert(_fmt(out.clone()) == out, "idempotent with the comment inside");
});
test("fmt elision D3: op((x)) elides both levels in ONE pass", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  y := -((x));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -x;")), "-((x)) reaches -x in one pass (idempotence)");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D1: prefix-result group elides after an infix operator", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  y := 3;\n  sink((x) - (-y));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink(x - -y)")), "(x) - (-y) elides to x - -y");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D2: flatten in call-argument position", {
  src := String.from("main :: (fn() -> unit)({\n  sink(((1 + 2) + 3));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink(1 + 2 + 3)")), "arg-position ((1+2)+3) flattens fully");
});
test("fmt elision: parenthesized dot-deref sugar still canonicalizes", {
  src := String.from("main :: (fn() -> unit)({\n  assert(a.(*) == 99);\n  assert(c.(*).count == 10);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("a.* == 99")), "a.(*) canonicalizes to a.*");
  assert(out.contains(String.from("c.*.count")), "c.(*).count canonicalizes to c.*.count");
});
test("fmt elision: quote argument with macro splices keeps its group (gate-conservative)", {
  src := String.from(
    "main :: (fn() -> unit)({\n  expr := quote((lhs.(#(field)) == rhs.(#(field))));\n});\nexport(main);\n"
  );
  out := _fmt(src.clone());
  assert(
    out.contains(String.from("quote((lhs.(#(field)) == rhs.(#(field))))")),
    "exprs_are_equal cannot prove splice trees equal — the group stays"
  );
  assert(_fmt(out.clone()) == out, "and that is a fixed point");
});
