/// Tests for format_yo_source (formatter.yo) — the source formatter had no
/// dedicated test (only an indirect whole-tree sweep, now `yo fmt --check`
/// plus the write-idempotence check in gates_fast.sh GATE 6).
/// Pin the cheap invariants: idempotency (format(format(x)) == format(x)),
/// stability of already-formatted input, and comment preservation.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ format_yo_source, format_yo_fences, collect_yo_files } :: import("../../src/formatter.yo");
{ YoError } :: import("../../src/error.yo");
{ assert, panic } :: import("std/assert");
_fmt :: (fn(imm(src) : String) -> String)({
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "formatter threw");
        unwind(String.new());
      }
    )
  );
  format_yo_source(src, `<formatter-test>`, exn)
});
test("format_yo_source: empty input", {
  assert(_fmt(String.from("")) == "", "empty stays empty");
});
test("format_yo_source: idempotent on a simple function", {
  src := String.from("f :: (fn(x : i32) -> i32)((x + 1));\nexport(f);\n");
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "format is idempotent");
});
test("format_yo_source: already-formatted source is stable", {
  src := String.from("x := 1;\n");
  assert(_fmt(src.clone()) == src, "canonical form unchanged");
});
test("format_yo_source: preserves comments", {
  src := String.from("// keep me\nx := 1;\n");
  out := _fmt(src.clone());
  assert(out.contains(`// keep me`), "line comment preserved");
});
test("format_yo_source: idempotent on nested calls and match", {
  src := String.from("g :: (fn(o : Option(i32)) -> i32)(match(o, .Some(v) => v, .None => 0));\nexport(g);\n");
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "nested form idempotent");
});
// ---------------------------------------------------------------------------
// Comma-break frame ownership (issues/fixed/fmt-not-idempotent-call-wrapped-
// match-in-block.md): the main-loop comma handler used to break at the
// enclosing multiline inline curly's / multiline bracket's indent for ANY
// comma lexically inside it — including commas nested inside a call paren
// that itself spans one row. That break is emitted before the paren's own
// multiline machinery has bumped the indent, so pass 1 under-indents and
// only pass 2 reaches the fixed point: `yo fmt f.yo && yo fmt --check f.yo`
// failed. A comma nested below the frame's own paren/bracket/curly depth
// must defer to the paren machinery (stay on the row when the paren is
// single-row).
// ---------------------------------------------------------------------------
test("fmt comma frames: call-wrapped match in a block body is a one-pass fixed point", {
  src := String.from(
    "pick :: (fn(xs : ArrayList(i32)) -> i32)({\n  i32(match(xs.get(usize(0)), .Some(a) => a, .None => i32(0)))\n});\nexport(pick);\n"
  );
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "one pass reaches the fixed point");
  assert(
    once.contains(String.from("  i32(match(xs.get(usize(0)), .Some(a) => a, .None => i32(0)))")),
    "the single-row call stays on one row inside the block"
  );
});
test("fmt comma frames: bare match statement in a block body is a one-pass fixed point", {
  src := String.from(
    "pick :: (fn(xs : ArrayList(i32)) -> i32)({\n  match(xs.get(usize(0)), .Some(a) => a, .None => i32(0))\n});\nexport(pick);\n"
  );
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "one pass reaches the fixed point");
});
test("fmt comma frames: cond in a block body is a one-pass fixed point", {
  src := String.from(
    "flag :: (fn(xs : ArrayList(i32)) -> i32)({\n  cond((xs.len() == usize(0)) => i32(0), true => i32(1))\n});\nexport(flag);\n"
  );
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "one pass reaches the fixed point");
});
test("fmt comma frames: single-row calls inside a multiline array stay whole", {
  src := String.from(
    "add :: (fn(a : i32, b : i32) -> i32)((a + b));\nmain :: (fn() -> unit)({\n  xs := [\n    add(i32(1), i32(2)),\n    add(i32(3), i32(4))\n  ];\n});\nexport(main);\n"
  );
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "one pass reaches the fixed point");
  assert(once.contains(String.from("    add(i32(1), i32(2)),")), "the single-row call is not exploded");
});
// The two load-bearing break cases the frame gate must PRESERVE: commas
// directly at the multiline frame's own depth (bracket elements, struct
// fields) still break, and a comma inside an ALREADY-multiline paren still
// breaks (now via the paren arm) — both are already fixed points.
test("fmt comma frames: multiline call inside a multiline array is unchanged", {
  src := String.from(
    "add :: (fn(a : i32, b : i32) -> i32)((a + b));\nmain :: (fn() -> unit)({\n  xs := [\n    add(\n      i32(1),\n      i32(2)\n    )\n  ];\n});\nexport(main);\n"
  );
  out := _fmt(src.clone());
  assert(out == src, "canonical exploded form is stable");
});
test("fmt comma frames: struct-literal field commas at the curly's own depth still break", {
  src := String.from(
    "P :: struct(x : i32, y : i32);\nmain :: (fn() -> unit)({\n  p := {\n    x : i32(1),\n    y : i32(2)\n  };\n});\nexport(main);\n"
  );
  out := _fmt(src.clone());
  assert(out == src, "per-field breaks at the curly's own depth are stable");
});
// A call's block-argument curly whose only content is a single nested call
// statement is inline-eligible (the statement's `;` sits inside the call's
// parens, so the curly has no top-level semicolon). The old comma handler
// broke the INNER call's argument comma at that curly's level — a stable but
// style-inconsistent `f(x,\n{` split that only appeared when the inner call
// itself sat inside another call's block argument
// (src/evaluator/values/impl.yo carried four such spots). The frame gate
// joins them to the dominant `f(x, {` spelling.
test("fmt comma frames: a call block-arg comma nested in another block arg joins", {
  src := String.from(
    "main :: (fn() -> unit)({\n  if(a(), {\n    if(b(),\n    {\n      x := 1;\n    });\n  });\n});\nexport(main);\n"
  );
  out := _fmt(src.clone());
  assert(out.contains(String.from("if(b(), {")), "the inner block-arg comma joins like every statement-level one");
  assert(_fmt(out.clone()) == out, "idempotent");
});
// ---------------------------------------------------------------------------
// Fixture corpus — the 46 (input → expected) pairs script-extracted VERBATIM
// from src/tests/formatter.test.ts (P2.4). Each .input is deliberately
// NON-canonical source (the suffix is not .yo so GATE 6's `fmt --check
// ./tests` skips them); the .expected next to it is the canonical output the
// TS formatter produced and pinned. This is the coverage GATE 6 cannot give:
// a whole-tree `fmt --check` only proves already-canonical text stays
// canonical, never that messy input NORMALIZES correctly.
// Assumes the runner's cwd is the repo root (how `yo test` and CI run).
// 93_prefix_chain_tight_but_infix_space_kept is the one non-verbatim pair:
// its original `v := x & *p;` / `w := 3 - -3;` predate the E0003 rule (a bare
// binary RHS of `:=` needs parens), and the parse gate refuses to reformat
// source the parser rejects, so the RHS parens were added to both sides
// (issues/fixed/fmt-reformats-parse-invalid-files.md).
// ---------------------------------------------------------------------------
{ Path } :: import("std/path");
fs_dir :: import("std/fs/dir");
fs_file :: import("std/fs/file");
test("format_yo_source: fixture corpus from formatter.test.ts", {
  exn := Exception(
    throw : (
      err -> {
        println(`  unexpected io error: ${err}`);
        assert(false, "fixture io failed");
        unwind(());
      }
    )
  );
  ioexn := IoExn(io : io, exn : exn);
  dir := String.from("tests/internal/formatter_fixtures");
  entries := io.await(fs_dir.read_dir(Path.new(dir.clone()), io), ioexn);
  (checked : usize) = usize(0);
  (failed : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < entries.len(), {
    match(
      entries.get(i),
      .Some(e) => if(e.name.ends_with(`.input`), {
        base := e.name.substring(usize(0), e.name.len() - usize(6));
        input := io.await(fs_file.read_to_string(Path.new(`${dir}/${base}.input`), io), ioexn);
        expected := io.await(fs_file.read_to_string(Path.new(`${dir}/${base}.expected`), io), ioexn);
        got := _fmt(input);
        if(got != expected, {
          println(`  FIXTURE FAILED: ${base}`);
          failed = (failed + usize(1));
        });
        checked = (checked + usize(1));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  println(`  ${checked.to_string()} fixtures checked`);
  assert(failed == usize(0), "some formatter fixtures diverged (see above)");
  assert(checked >= usize(46), "fixture corpus missing (cwd must be the repo root)");
});
test("format_yo_source: a template string AFTER a multibyte character survives", {
  // `read_raw_template_string` re-reads the template literal out of `input`
  // by byte offset. It used to be handed `Token.character` — a RUNE index —
  // and re-walked the buffer to convert; D4 PR 3 gave `Token` a real
  // `byte_offset` and deleted that walk. Either way the failure mode is the
  // same class: with a multibyte character EARLIER in the file the slice
  // starts early and swallows the source before the backtick, producing
  // non-parseable output at rc=0
  // (issues/fixed/yo-self-formatter-corrupts-files-with-non-ascii.md — 23 of
  // 40 sampled std files with a backtick came out broken).
  //
  // The em dash below is what makes this test discriminating; the same source
  // with an ASCII hyphen passes under a broken conversion.
  src := String.from("//! doc — with an em dash\nf :: (fn(x : String) -> String)(`v=${x}`);\nexport(f);\n");
  out := _fmt(src);
  assert(out.contains(String.from("`v=${x}`")), "the template literal is intact");
  assert(!out.contains(String.from("`v=${x}`;\n`")), "no duplicated tail");
  assert(_fmt(out) == out, "and formatting is idempotent");
});
test("format_yo_source: multibyte content inside a template string is preserved", {
  src := String.from("g :: (fn() -> String)(`名前 → ${String.new()}`);\nexport(g);\n");
  out := _fmt(src);
  assert(out.contains(String.from("名前 → ${String.new()}")), "multibyte body intact");
  assert(_fmt(out) == out, "idempotent");
});
test("format_yo_source: refuses a changed rendering of source the parser rejects", {
  // issues/fixed/fmt-reformats-parse-invalid-files.md — the renderer is token-level,
  // so it "formatted" (rc=0, file rewritten) source the parser rejects: a
  // backtick closing the template string mid-line leaves `abc`yo test`def`,
  // a token sandwich fmt spaced out while `yo check` fails E0008. The parse
  // gate must throw through the caller's exn — the same shape a lexer error
  // already has (bare diagnostic, `yo fmt` exit 1) — instead of returning a
  // changed rendering that launders the break into an fmt-idempotent file.
  exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, YoError),
          .Some(ye) => {
            s := ye.to_string();
            assert(
              s.contains(`paren-less function and operator calls`),
              "the parse diagnostic surfaces"
            );
            assert(s.contains(`--> <formatter-test>:1:11`), "anchored at the offending token");
          },
          .None => assert(false, "expected a YoError diagnostic")
        );
        unwind(());
      }
    )
  );
  format_yo_source(
    String.from("x := `abc`yo test`def`;\n"),
    `<formatter-test>`,
    exn
  );
  assert(false, "expected a parse error to be raised");
});
test("format_yo_source: parse-invalid but already-canonical source passes through", {
  // The gate fires only when the rendering CHANGES. Source that does not
  // parse but is already canonical (the shape of
  // tests/cli-cases/fix-says-what-it-cannot-repair/fixture/main.yo, whose
  // E0003 `x := 1 && 2 && 3;` is the case's whole point) must stay
  // fmt-clean: `yo check` owns the parseability verdict, and erroring here
  // would red CI's tree-wide `fmt --check ./std ./tests ./src` on that
  // fixture.
  src := String.from("x := 1 && 2 && 3;\n");
  assert(_fmt(src.clone()) == src, "canonical parse-invalid source is untouched");
});
// ---------------------------------------------------------------------------
// Paren elision (plans/archive/FMT_PAREN_ELISION.md D1-D3) — the decision table.
// `_fmt` runs format_yo_source, whose re-parse gate is the
// meaning-preservation backstop; these pin the canonical OUTPUTS.
// ---------------------------------------------------------------------------
test("fmt elision D1: atom-like groups in infix-operand position", {
  src := String.from("f :: (fn(x : i32, y : i32) -> i32)((x) + (y));\nexport(f);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("(x + y)")), "operand parens around atoms elide");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D1: atom group after a non-allow-list operator", {
  src := String.from("f :: (fn(x : i32, y : i32) -> i32)(x - (y));\nexport(f);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("(x - y)")), "RHS atom group elides after infix -");
});
test("fmt elision D1: prefix-result group elides after :=", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  y := (-x);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -x;")), "(-x) elides to -x on := RHS");
});
test("fmt elision D2: left same-operator group flattens", {
  src := String.from("f :: (fn() -> i32)(((1 + 2) + 3));\nexport(f);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("(1 + 2 + 3)")), "((1 + 2) + 3) flattens to (1 + 2 + 3)");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D2: flatten inside a retained := group", {
  src := String.from("main :: (fn() -> unit)({\n  y := (((1 + 2) + 3));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := (1 + 2 + 3);")), "one level kept, inner flattened");
});
test("fmt elision D3: prefix call parens elide", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  y := -(x);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -x;")), "-(x) elides to -x");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D3: prefix chains normalize to the bare form", {
  src := String.from("T :: ?(*(i32));\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("T :: ?*i32;")), "?(*(i32)) elides to ?*i32");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D3: prefix call over a dot-chain elides", {
  src := String.from("main :: (fn() -> unit)({\n  p := Pair(a : 7);\n  y := -(p.a);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -p.a;")), "-(p.a) elides to -p.a");
});
test("fmt elision D3: prefix call in argument position elides", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  sink(-(x) + 2);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink(-x + 2)")), "-(x) + 2 elides to -x + 2 in an argument");
});
test("fmt elision R1: := RHS infix chain keeps its group", {
  src := String.from("main :: (fn() -> unit)({\n  y := (1 + 2);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := (1 + 2);")), "y := 1 + 2 is illegal — group stays");
  assert(_fmt(out.clone()) == out, "stable");
});
test("fmt elision R2: right operand groups stay", {
  src := String.from("main :: (fn() -> unit)({\n  sink(3 + (4 - 5));\n  sink(3 + (4 + 5));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink(3 + (4 - 5))")), "mixed right group stays");
  assert(out.contains(String.from("sink(3 + (4 + 5))")), "same-op right group stays");
});
test("fmt elision R3: mixed-operator left group stays", {
  src := String.from("main :: (fn() -> unit)({\n  sink((3 + 4) - 5);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink((3 + 4) - 5)")), "mixed operators need the group");
});
test("fmt elision R3: prefix call with infix argument stays", {
  src := String.from("main :: (fn() -> unit)({\n  y := -((1 + 2));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -(1 + 2);")), "prefix binds ONE postfix expr — call parens stay");
});
test("fmt elision R4: multi-arg operator call stays", {
  src := String.from("main :: (fn() -> unit)({\n  y := -((1, 2));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -((1, 2));")), "comma argument keeps BOTH paren levels");
});
test("fmt elision: operator atom stays parenthesized", {
  src := String.from("my_not :: (!);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("my_not :: (!);")), "(!) is a value, not a grouping");
});
test("fmt elision: comment inside a candidate group blocks elision", {
  src := String.from("main :: (fn() -> unit)({\n  y := ((/* keep */ 1 + 2));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("/* keep */")), "comment preserved");
  assert(_fmt(out.clone()) == out, "idempotent with the comment inside");
});
test("fmt elision D3: op((x)) elides both levels in ONE pass", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  y := -((x));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("y := -x;")), "-((x)) reaches -x in one pass (idempotence)");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D1: prefix-result group elides after an infix operator", {
  src := String.from("main :: (fn() -> unit)({\n  x := 10;\n  y := 3;\n  sink((x) - (-y));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink(x - -y)")), "(x) - (-y) elides to x - -y");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision D2: flatten in call-argument position", {
  src := String.from("main :: (fn() -> unit)({\n  sink(((1 + 2) + 3));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink(1 + 2 + 3)")), "arg-position ((1+2)+3) flattens fully");
});
test("fmt elision: parenthesized dot-deref sugar still canonicalizes", {
  src := String.from("main :: (fn() -> unit)({\n  assert(a.(*) == 99);\n  assert(c.(*).count == 10);\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("a.* == 99")), "a.(*) canonicalizes to a.*");
  assert(out.contains(String.from("c.*.count")), "c.(*).count canonicalizes to c.*.count");
});
test("fmt elision: quote argument with unquotes unwraps, the unquote calls stay", {
  // The group around the whole `==` argument of `quote(...)` is a plain
  // redundant call argument (`f((a + b))` → `f(a + b)`, D1); the re-parse
  // gate proves the unwrapped tree equal and the canonical form wins.
  src := String.from(
    "main :: (fn() -> unit)({\n  expr := quote((lhs.(unquote(field)) == rhs.(unquote(field))));\n});\nexport(main);\n"
  );
  out := _fmt(src.clone());
  assert(
    out.contains(String.from("quote(lhs.(unquote(field)) == rhs.(unquote(field)))")),
    "the redundant argument group elides; the splice call parens stay tight"
  );
  assert(_fmt(out.clone()) == out, "and that is a fixed point");
});
test("fmt keeps the group of a dynamic member `.(unquote(b))`", {
  // `a.(unquote(b))` names the member that `b` holds; without the group it
  // is `a.unquote(b)`, a call of a method named `unquote`. The same holds for
  // an enum variant pattern `.(unquote(v))` and a chain.
  src := String.from(
    "main :: (fn() -> unit)({\n  e := quote(a.(unquote(b)));\n  f := quote(a.(unquote(b)).c.(unquote(d)));\n  g := quote(match(x, .(unquote(v)) => 1, _ => 2));\n  h := quote(((a.(unquote(b)))));\n});\nexport(main);\n"
  );
  out := _fmt(src.clone());
  assert(out.contains(String.from("e := quote(a.(unquote(b)));")), "a member access keeps its group");
  assert(out.contains(String.from("f := quote(a.(unquote(b)).c.(unquote(d)));")), "so does a chain");
  assert(out.contains(String.from("quote(match(x, .(unquote(v)) => 1, _ => 2))")), "and a variant pattern");
  assert(out.contains(String.from("h := quote(a.(unquote(b)));")), "redundant outer groups go, the member group stays");
  assert(!out.contains(String.from(".unquote(")), "never a method call");
  assert(_fmt(out.clone()) == out, "a fixed point");
});
test("fmt elision D2: prefix operands are not chain operators", {
  src := String.from(
    "main :: (fn() -> unit)({\n  if(((exp_enum_id != giv_enum_id) && !(same_enum_ctor)) && !(same_variants), {\n    return(1);\n  });\n});\nexport(main);\n"
  );
  out := _fmt(src.clone());
  assert(
    out.contains(
      String.from("if((exp_enum_id != giv_enum_id) && !same_enum_ctor && !same_variants, {")
    ),
    "((A) && !b) && !c flattens fully — the ! operands do not split the && chain"
  );
  assert(_fmt(out.clone()) == out, "idempotent");
});
// ---------------------------------------------------------------------------
// D4 (callee canonicalization): a prefix operator call whose result is
// immediately called renders grouped — `op(x)(y)` → `(op x)(y)` — so the
// pointer-cast spelling `*(T)(x)` becomes `(*T)(x)`. Operator-generic: D3's
// shape with the next-token condition inverted (args `(` instead of
// "nothing that re-binds").
// ---------------------------------------------------------------------------
test("fmt D4: pointer cast canonicalizes to the grouped spelling", {
  src := String.from("main :: (fn() -> unit)({\n  free(.Some(*(void)(buf)));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(
    out.contains(String.from("free(.Some((*void)(buf)));")),
    "*(void)(buf) renders as (*void)(buf)"
  );
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt D4: double pointer cast collapses the chain", {
  src := String.from("main :: (fn() -> unit)({\n  sink(*(*(u8))(p));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink((**u8)(p));")), "*(*(u8))(p) renders as (**u8)(p)");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt D4: option-pointer cast groups the whole prefix chain", {
  src := String.from("main :: (fn() -> unit)({\n  sink(?(*(u8))(p));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("sink((?*u8)(p));")), "?(*(u8))(p) renders as (?*u8)(p)");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt D4: every prefix operator, not just *", {
  src := String.from("main :: (fn() -> unit)({\n  sink((-(x))(y), (~(x))(y));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("(-x)(y)")), "-(x)(y) renders as (-x)(y)");
  assert(out.contains(String.from("(~x)(y)")), "~(x)(y) renders as (~x)(y)");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt D4: bare-prefix operand spelling is untouched", {
  src := String.from("main :: (fn() -> unit)({\n  sink(*void(p));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(
    out.contains(String.from("sink(*void(p));")),
    "the *void(p) spelling stays — fmt never invents a cast"
  );
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt D4: -x(y) stays — it is -(x(y)), a different AST from (-x)(y)", {
  src := String.from("main :: (fn() -> unit)({\n  sink((-x(y), -(x)(y)));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("-x(y)")), "bare prefix binds the call — spelling stays");
  assert(out.contains(String.from("(-x)(y)")), "the operator-call callee form canonicalizes");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt D4: spaced func spelling stays (adjacency is structural)", {
  src := String.from("main :: (fn() -> unit)({\n  sink(* (void)(p));\n});\nexport(main);\n");
  out := _fmt(src.clone());
  assert(
    out.contains(String.from("* (void)")),
    "the spaced spelling parses differently — it is not canonicalized"
  );
});
test("fmt D4: multi-arg and infix-operand funcs keep their call parens", {
  src := String.from(
    "main :: (fn() -> unit)({\n  sink((-(1, 2))(y));\n  sink(*((a + b))(y));\n});\nexport(main);\n"
  );
  out := _fmt(src.clone());
  assert(out.contains(String.from("(-(1, 2))(y)")), "multi-arg func call keeps its parens");
  // Non-atom operand: D4 does not fire — the inner group's own parens elide
  // via the pre-existing rules (same output the seed produced), and the
  // operator keeps its call paren.
  assert(out.contains(String.from("*(a + b)(y)")), "non-atom operand is not canonicalized by D4");
});
// ---------------------------------------------------------------------------
// Non-prefix-capable operator CALL parens (issues/fixed/fmt-pointer-type-
// paren-verdict-is-context-dependent.md): `...`, `#`, and `...#` have no
// bare prefix form (PREFIX_OPERATOR_OPERAND_RULE.md Rule 1 lists only
// `- ! ~ & * ? ^`), so their ONLY operand grammar is the tight call
// `op(operand)`. D1's "an atom-like operand needs no parens after ANY
// operator" used to elide that call paren (`...(quote(entries))` →
// `...quote(entries)`), which does not re-parse (E0008) — the verify gate
// then disabled paren elision FILE-WIDE, so the byte-identical
// `Item : *(MapEntry(K, V))` spelling passed `fmt --check` in
// hash_map.yo (whose trailing spread-rest macro tripped the gate) and was
// rewritten in every file without one.
// ---------------------------------------------------------------------------
test("fmt elision: spread-rest call paren stays and does not disable file-wide elision", {
  src := String.from("m :: (fn(...(quote(entries))) -> unquote(Expr))(());\nT :: ?(*(i32));\n");
  out := _fmt(src.clone());
  assert(
    out.contains(String.from("...(quote(entries))")),
    "the spread operator's call paren is load-bearing — ...x does not parse"
  );
  assert(out.contains(String.from("T :: ?*i32;")), "elision still runs in the rest of the file");
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision: barrel export spread call paren stays", {
  src := String.from("export(...(_command));\nprobe :: ((1 + 2) + 3);\n");
  out := _fmt(src.clone());
  assert(out.contains(String.from("...(_command)")), "the barrel spread's call paren stays");
  assert(
    out.contains(String.from("probe :: (1 + 2 + 3);")),
    "elision still runs in the rest of the file"
  );
  assert(_fmt(out.clone()) == out, "idempotent");
});
test("fmt elision: pointer-type paren verdict is context-independent", {
  // The filed divergence: `Item : *(MapEntry(K, V))` canonicalizes in a
  // plain file but survived verbatim in hash_map.yo, whose trailing
  // `fn(...(quote(entries)))` macro used to trip the verify gate and turn
  // elision off for the WHOLE file. Both spellings must now agree.
  plain := String.from("Iter :: struct(Item : *(MapEntry(K, V)));\n");
  with_macro := String.from(
    "m :: (fn(...(quote(entries))) -> unquote(Expr))(());\nIter :: struct(Item : *(MapEntry(K, V)));\n"
  );
  out_plain := _fmt(plain.clone());
  out_with_macro := _fmt(with_macro.clone());
  assert(
    out_plain.contains(String.from("Item : *MapEntry(K, V)")),
    "standalone: the pointer-type paren elides"
  );
  assert(
    out_with_macro.contains(String.from("Item : *MapEntry(K, V)")),
    "with a spread-rest macro in the file: the same verdict"
  );
  assert(_fmt(out_plain.clone()) == out_plain, "idempotent");
  assert(_fmt(out_with_macro.clone()) == out_with_macro, "idempotent");
});
test("format_yo_source: idempotent when a trailing nested match is forced multiline", {
  // issues/fixed/fmt-hugs-a-trailing-nested-match-then-expands-it-on-the-next-pass.md:
  // the first pass kept the outer match on one row and hugged the inner one;
  // the second expanded the outer.
  src := String.from("E :: enum(A, B);\nf :: (fn(a : Result(i32, E)) -> i32)({\n  (score : i32) = i32(0);\n  match(a, .Ok(_) => (), .Err(e) => match(e, .A => { score = (score + i32(10)); }, .B => ()));\n  score\n});\nexport(f);\n");
  once := _fmt(src.clone());
  twice := _fmt(once.clone());
  assert(once == twice, "one pass reaches the fixpoint");
  assert(once.contains("  match(\n    a,\n"), "the outer match is expanded on the first pass");
});
test("collect_yo_files skips dot-prefixed files in a directory walk", {
  // The walk collected EVERY `*.yo` including gitignored dot-files the
  // toolchain generates beside sources (`.yo_selftest_batch_*`,
  // src/main.yo's batch writer), so `fmt --check ./tests` false-red an
  // otherwise clean checkout
  // (issues/fixed/fmt-check-walks-gitignored-generated-dot-files.md).
  // `.fmt_walk_ignored.yo` below is the committed probe: canonical content,
  // so even a walker that regresses cannot reformat it — only this list
  // membership check can see the skip.
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected io error");
        unwind(());
      }
    )
  );
  files := ArrayList(String).new();
  collect_yo_files(Path.new(String.from("tests/internal/formatter_fixtures")), files, io, exn);
  (saw_dot_file : bool) = false;
  (i : usize) = usize(0);
  while(i < files.len(), {
    if(files.get(i).unwrap().contains(String.from(".fmt_walk_ignored")), {
      saw_dot_file = true;
    });
    i = (i + usize(1));
  });
  assert(!saw_dot_file, "the dot-prefixed probe must be skipped by the walk");
  // Explicit intent still formats a dot file handed to the walker directly.
  direct := ArrayList(String).new();
  collect_yo_files(
    Path.new(String.from("tests/internal/formatter_fixtures/.fmt_walk_ignored.yo")),
    direct,
    io,
    exn
  );
  assert(direct.len() == usize(1), "an explicitly-passed dot file is still collected");
});

_fences :: (fn(imm(src) : String, in_comment : bool) -> String)({
  exn := Exception(
    throw : (
      _err -> {
        assert(false, "fence formatter threw");
        unwind(String.new());
      }
    )
  );
  format_yo_fences(src, `<fence-test>`, in_comment, exn)
});
test("format_yo_fences: a ```yo block in Markdown is formatted", {
  src := String.from("# T\n\n```yo\nf :: (fn(a : i32) -> i32)((a + a));\nx := f(i32(1));   // aligned\n```\n");
  out := _fences(src, false);
  assert(out == "# T\n\n```yo\nf :: (fn(a : i32) -> i32)(a + a);\nx := f(i32(1)); // aligned\n```\n", `got:\n${out}`);
});
test("format_yo_fences: a block indented in a list item keeps its indent", {
  src := String.from("- item:\n\n  ```yo\n  g :: (fn(a : i32) -> i32)((a));\n  ```\n");
  out := _fences(src, false);
  assert(out == "- item:\n\n  ```yo\n  g :: (fn(a : i32) -> i32)(a);\n  ```\n", `got:\n${out}`);
});
test("format_yo_fences: ```yo ignore and other languages are left as written", {
  src := String.from("```yo ignore\nbad := a + b * c;\n```\n\n```rust\nlet x = ((1));\n```\n");
  assert(_fences(src.clone(), false) == src, "ignored and rust blocks untouched");
});
test("format_yo_fences: a ```yo block in a doc comment is formatted", {
  src := String.from("/// Doc.\n///\n/// ```yo\n/// x := f(i32(1));   // aligned\n/// ```\nf :: (fn() -> i32)(i32(1));\n");
  out := _fences(src, true);
  assert(out == "/// Doc.\n///\n/// ```yo\n/// x := f(i32(1)); // aligned\n/// ```\nf :: (fn() -> i32)(i32(1));\n", `got:\n${out}`);
});
