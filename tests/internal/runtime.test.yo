/// Tests for src/evaluator/exprs/runtime.yo — Phase 2r
///
/// Covers `evaluate_runtime` — the production handler for `runtime(expr)`.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../src/token.yo");
{ AstExpr, ast_expr_id, BF_RUNTIME } :: import("../../src/expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_get, expr_info_table_set }
:: import("../../src/expr_info.yo");
{ Environment } :: import("../../src/env.yo");
{ EvalContext, eval_context_new } :: import("../../src/evaluator/context.yo");
{ EvalValue } :: import("../../src/value.yo");
{ TypeValue } :: import("../../src/types/definitions.yo");
{ t_i32, t_comptime_int } :: import("../../src/types/creators.yo");
{ set_evaluate_expression_fn, set_evaluate_expression_raw_fn, evaluate_expression }
:: import("../../src/evaluator/exprs/expr.yo");
{ evaluate_runtime } :: import("../../src/evaluator/exprs/runtime.yo");
{ Exception } :: import("std/error");
{ assert, panic } :: import("std/assert");
// Helper: build a token with the given identifier value.
mk_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
// Helper: build a runtime(arg_atom) FnCall expression.
mk_runtime_call :: (fn(arg_id : usize, arg_value : str, call_id : usize) -> AstExpr)({
  arg_atom := AstExpr.Atom(arg_id, mk_token(arg_value));
  callee := AstExpr.Atom(call_id + usize(1000), mk_token(BF_RUNTIME));
  args := ArrayList(AstExpr).new();
  args.push(arg_atom);
  AstExpr.FnCall(call_id, callee, args, false, mk_token(BF_RUNTIME))
});
// Stub evaluator: claims every input is `comptime_int`. After runtime(_),
// the expression should be retyped to i32.
stub_evaluate_comptime_int :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  info := new_expr_info(env, t_comptime_int());
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
/// Raw-seam variant of the stub: same behavior, ignores the custom handler.
stub_evaluate_comptime_int_raw :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)(
  stub_evaluate_comptime_int(expr, env, ctx)
);
test("evaluate_runtime: converts comptime_int argument to i32", {
  set_evaluate_expression_fn(stub_evaluate_comptime_int);
  set_evaluate_expression_raw_fn(stub_evaluate_comptime_int_raw);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  env := Environment.new(String.from("test"));
  call := mk_runtime_call(usize(11), "42", usize(12));
  result := evaluate_runtime(call, env, ctx, exn);
  // Outer call's ExprInfo must be present, with i32 type and no value.
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  assert(match(info_opt, .Some(_) => true, .None => false), "runtime did not record an ExprInfo");
  info := match(
    info_opt,
    .Some(i) => i,
    .None => new_expr_info(env, t_i32())
  );
  // Type should be i32 (converted from comptime_int).
  match(
    info.ty,
    .Int(bits, signed) => {
      assert(bits == u8(32), "expected i32 bits=32");
      assert(signed, "expected i32 signed=true");
    },
    _ => assert(false, "expected runtime() to produce Int(32, true)")
  );
  // value must be .None (runtime value, not known at compile time).
  match(
    info.value,
    .None => (),
    .Some(_) => assert(false, "expected runtime() to leave value = .None")
  );
});
