//! Smoke test: simulate Phase-3 evaluator-style mutual reference between a
//! type module and a value module. Validates that yo-self can lean on
//! Yo's circular-import mechanism without surprises.
{ TypeShape, type_for_value } :: import("./circular_smoke/type_a.yo");
{ ValueB, default_value } :: import("./circular_smoke/value_b.yo");
{ assert, panic } :: import("std/assert");
test("Circular type↔value: type_for_value(IntV) → IntT", {
  v := ValueB.IntV(i32(7));
  t := type_for_value(v);
  match(
    t,
    .IntT => assert(true, "expected IntT"),
    .BoolT => assert(false, "got BoolT, expected IntT"),
    .FuncT(_) => assert(false, "got FuncT, expected IntT")
  );
});
test("Circular type↔value: default_value(BoolT) → BoolV(false)", {
  v := default_value(TypeShape.BoolT);
  match(
    v,
    .BoolV(b) => assert(b == false, "expected false"),
    .IntV(_) => assert(false, "got IntV"),
    .FnV(_) => assert(false, "got FnV")
  );
});
test("Circular type↔value: round-trip through both directions", {
  // Build a function-shaped type, materialize a value with that declared
  // type, then ask for its type again — checking that both halves of the
  // cycle behave consistently.
  declared := TypeShape.FuncT(`result_int`);
  v := default_value(declared);
  match(
    v,
    .FnV(stored) => {
      derived := type_for_value(v);
      match(
        derived,
        .FuncT(name) => assert(name == `result_int`, "name should round-trip"),
        .IntT => assert(false, "got IntT"),
        .BoolT => assert(false, "got BoolT")
      );
      // also assert the stored type matches what we passed in
      match(
        stored,
        .FuncT(name2) => assert(name2 == `result_int`, "stored name should match"),
        .IntT => assert(false, "stored should be FuncT"),
        .BoolT => assert(false, "stored should be FuncT")
      );
    },
    .IntV(_) => assert(false, "expected FnV"),
    .BoolV(_) => assert(false, "expected FnV")
  );
});
