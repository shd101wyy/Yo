/// Tests for `is_valid_variable_name` in src/evaluator/utils.yo.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../src/token.yo");
{ AstExpr } :: import("../../src/expr.yo");
{ is_valid_variable_name } :: import("../../src/evaluator/utils.yo");
{ assert, panic } :: import("std/assert");
mk_tok :: (fn(value : str, kind : TokenKind) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
mk_atom :: (fn(value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(usize(0), mk_tok(value, kind))
);
mk_call :: (fn(func_value : str, func_kind : TokenKind) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  AstExpr.FnCall(
    usize(0),
    mk_atom(func_value, func_kind),
    args,
    false,
    mk_tok(func_value, func_kind)
  )
});
test("is_valid_variable_name: Identifier atom → true", {
  assert(
    is_valid_variable_name(mk_atom("x", TokenKind.Identifier)),
    "identifier atom"
  );
});
test("is_valid_variable_name: Operator atom → true", {
  assert(
    is_valid_variable_name(mk_atom("+", TokenKind.Operator)),
    "operator atom"
  );
});
test("is_valid_variable_name: Operator FnCall → true", {
  // The TS check's operator branch applies to any token kind, not just
  // atoms — so an FnCall whose token is an Operator passes too.
  assert(
    is_valid_variable_name(mk_call("+", TokenKind.Operator)),
    "operator FnCall"
  );
});
test("is_valid_variable_name: Identifier FnCall → false", {
  // FnCall whose token is an Identifier (not Operator) is not a valid
  // binding-LHS — only Atom+Identifier is.
  assert(
    !(is_valid_variable_name(mk_call("foo", TokenKind.Identifier))),
    "identifier FnCall not valid"
  );
});
test("is_valid_variable_name: Integer atom → false", {
  assert(
    !(is_valid_variable_name(mk_atom("42", TokenKind.Integer))),
    "integer atom not valid"
  );
});
test("is_valid_variable_name: StringLit atom → false", {
  assert(
    !(is_valid_variable_name(mk_atom("\"x\"", TokenKind.StringLit))),
    "string atom not valid"
  );
});
