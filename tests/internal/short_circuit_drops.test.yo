//! Regression tests for short-circuit operand-temp drops — the `||`/`&&`
//! emitter's per-operand drop emission (`_emit_drops_for_conditional_branch`
//! in src/codegen/exprs/and_or.yo). A short circuit that IS a whole fn body
//! has no open codegen begin (the pending channel is empty), so the operand
//! temps' scope drops ride the shared body node's own ExprInfo list — they
//! leaked wholesale until the node-list source landed
//! (issues/fixed/short-circuit-bare-fn-body-operand-temps-leak.md). Under
//! the shard's LeakSanitizer build these leak-aborted before the fix; the
//! value asserts pin the short-circuit semantics themselves. CHAINED
//! operands (`a || b || c` — nested binaries) are only partially covered
//! (the inner nested operand still leaks); see the issue's remaining-work.
open(import("std/string"));
open(import("std/fmt"));
{ assert } :: import("std/assert");

// The exact bug shape: a whole-fn-body || whose operands promote str
// literals to owned Strings for the == comparisons.
is_res :: (fn(id : String) -> bool)(
  (id == `forall`) || (id == `∀`)
);
// The && twin.
is_both :: (fn(a : String, b : String) -> bool)(
  (a == `x`) && (b == `y`)
);
// The begin-opened (statement-position) shape — the pending channel covers
// it; this pins parity between the two sources.
in_block :: (fn(id : String) -> bool)({
  r := ((id == `forall`) || (id == `∀`));
  r
});
test("whole-body || drops its literal temps (leak regression)", {
  (i : usize) = usize(0);
  (t : usize) = usize(0);
  while(i < usize(100), {
    if(is_res(String.from("zzz")), {
      t = (t + usize(1));
    });
    if(is_res(String.from("forall")), {
      t = (t + usize(1));
    });
    if(is_res(String.from("∀")), {
      t = (t + usize(1));
    });
    i = (i + usize(1));
  });
  assert(t == usize(200), `false|true|true per iteration, got ${t.to_string()}`);
});
test("whole-body && drops its literal temps and short-circuits", {
  (i : usize) = usize(0);
  (t : usize) = usize(0);
  while(i < usize(100), {
    if(is_both(String.from("x"), String.from("y")), {
      t = (t + usize(1));
    });
    if(is_both(String.from("x"), String.from("z")), {
      t = (t + usize(1));
    });
    if(is_both(String.from("q"), String.from("y")), {
      t = (t + usize(1));
    });
    i = (i + usize(1));
  });
  assert(t == usize(100), `only (x, y) is true, got ${t.to_string()}`);
});
test("statement-position || keeps parity with the whole-body shape", {
  (i : usize) = usize(0);
  (t : usize) = usize(0);
  while(i < usize(100), {
    if(in_block(String.from("∀")), {
      t = (t + usize(1));
    });
    if(in_block(String.from("zzz")), {
      t = (t + usize(1));
    });
    i = (i + usize(1));
  });
  assert(t == usize(100), `one true per iteration, got ${t.to_string()}`);
});
