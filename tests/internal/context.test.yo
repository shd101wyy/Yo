//! Tests for src/evaluator/context.yo
//! Mirrors the structure of src/evaluator/context.ts
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TokenKind, Token } :: import("../../src/token.yo");
{
  EvalContext,
  eval_context_new,
  CaptureUsage,
  track_variable_usage,
  FuncOrAsyncBlockKind,
  FuncOrAsyncBlockCtx,
  LoopKind,
  LoopBodyCtx,
  ExpectedTypeCtx,
  CapturedVarInfo,
  FunctionToCall,
  CallResultKind,
  ArgEntry,
  VarArgEntry,
  ArgValues,
  get_function_call_result,
  get_type_call_result
} :: import("../../src/evaluator/context.yo");
{ TypeValue } :: import("../../src/types/definitions.yo");
{ t_unit, t_func_simple } :: import("../../src/types/creators.yo");
{ EvalValue } :: import("../../src/value.yo");
{ Environment, Frame, new_frame } :: import("../../src/env.yo");
{ AstExpr } :: import("../../src/expr.yo");
{ HashMap } :: import("std/collections/hash_map");
make_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
test("eval_context_new: default fields", {
  ctx := eval_context_new(String.from("/std"), String.from("test.yo"));
  assert(!ctx.is_executing, "not executing by default");
  assert(!ctx.is_inside_impl_block, "not in impl block by default");
  assert(!ctx.is_inside_where_clause, "not in where clause by default");
  assert(!ctx.is_inside_io_async_call, "not in io async call by default");
  assert(ctx.std_path == "/std", "std_path set correctly");
  match(
    ctx.current_module_path,
    .Some(p) => assert(p == "test.yo", "module_path set"),
    .None => assert(false, "module_path should be Some")
  );
});
test("eval_context_new: all optional fields are None", {
  ctx := eval_context_new(String.from("/usr/yo"), String.from("main.yo"));
  match(ctx.load_module, .Some(_) => assert(false, "should be None"), .None => ());
  match(ctx.is_evaluating_function_body_or_async_block, .Some(_) => assert(false, "should be None"), .None => ());
  match(ctx.is_evaluating_loop_body, .Some(_) => assert(false, "should be None"), .None => ());
  match(ctx.expected_type, .Some(_) => assert(false, "should be None"), .None => ());
  match(ctx.captured_variables, .Some(_) => assert(false, "should be None"), .None => ());
  match(ctx.function_return_impl_concrete_type, .Some(_) => assert(false, "should be None"), .None => ());
  match(ctx.currently_specializing_function, .Some(_) => assert(false, "should be None"), .None => ());
  match(ctx.doc_comment_lookup, .Some(_) => assert(false, "should be None"), .None => ());
});
test("eval_context_new: boolean flags default to false", {
  ctx := eval_context_new(String.from("/std"), String.from("x.yo"));
  assert(!ctx.is_executing, "is_executing is false");
  assert(!ctx.is_validating_function_definition, "is_validating_function_definition is false");
  assert(!ctx.is_inside_impl_block, "is_inside_impl_block is false");
  assert(!ctx.is_evaluating_function_type, "is_evaluating_function_type is false");
  assert(!ctx.is_inside_where_clause, "is_inside_where_clause is false");
  assert(!ctx.is_inside_io_async_call, "is_inside_io_async_call is false");
  assert(!ctx.is_inside_given_handler, "is_inside_given_handler is false");
  assert(!ctx.force_compile_time_bindings, "force_compile_time_bindings is false");
  assert(!ctx.is_analyzing_ctfe_capability, "is_analyzing_ctfe_capability is false");
});
test("FuncOrAsyncBlockKind variants exist", {
  k1 := FuncOrAsyncBlockKind.FunctionBody;
  k2 := FuncOrAsyncBlockKind.AsyncBlock;
  k3 := FuncOrAsyncBlockKind.TestBlock;
  match(k1, .FunctionBody => (), _ => assert(false, "expected FunctionBody"));
  match(k2, .AsyncBlock => (), _ => assert(false, "expected AsyncBlock"));
  match(k3, .TestBlock => (), _ => assert(false, "expected TestBlock"));
});
test("LoopKind variants exist", {
  k1 := LoopKind.While;
  k2 := LoopKind.For;
  match(k1, .While => (), _ => assert(false, "expected While"));
  match(k2, .For => (), _ => assert(false, "expected For"));
});
test("CaptureUsage variants", {
  r := CaptureUsage.Read;
  w := CaptureUsage.Write;
  o := CaptureUsage.Own;
  match(r, .Read => (), _ => assert(false, "expected Read"));
  match(w, .Write => (), _ => assert(false, "expected Write"));
  match(o, .Own => (), _ => assert(false, "expected Own"));
});
test("track_variable_usage: no function body context → no-op", {
  ctx := eval_context_new(String.from("/std"), String.from("a.yo"));
  // is_evaluating_function_body_or_async_block is None → should return early
  tok := make_token("x");
  track_variable_usage(String.from("x"), usize(0), CaptureUsage.Read, tok, ctx);
  // captured_variables should remain None
  match(
    ctx.captured_variables,
    .Some(_) => assert(false, "map should remain None"),
    .None => ()
  );
});
test("track_variable_usage: with function body context but var not in env → no-op", {
  ctx := eval_context_new(String.from("/std"), String.from("a.yo"));
  ctx.captured_variables = .Some(HashMap(String, CapturedVarInfo).new());
  // Create a minimal Environment with no frames
  env := Environment(frames : ArrayList(Frame).new(), module_path : String.from("test.yo"), function_declaration_frame_level : Option(usize).None, input_string : String.from(""));
  sub_ctx := FuncOrAsyncBlockCtx(
    kind : FuncOrAsyncBlockKind.FunctionBody,
    func_type : Option(TypeValue).None,
    func_value : Option(EvalValue).None,
    eval_env : env
  );
  ctx.is_evaluating_function_body_or_async_block = Option(FuncOrAsyncBlockCtx).Some(sub_ctx);
  tok := make_token("notfound");
  // env has no frames, so frame_count()=0; frame_level=0 >= 0 → early return
  track_variable_usage(String.from("notfound"), usize(0), CaptureUsage.Read, tok, ctx);
  match(
    ctx.captured_variables,
    .None => assert(false, "map should still exist"),
    .Some(map) => match(
      map.get(String.from("notfound")),
      .None => (),
      // correct: variable not tracked
      .Some(_) => assert(false, "should not have tracked variable")
    )
  );
});
test("CallResultKind variants can be constructed", {
  // Workaround: bind to named vars first (inline enum construction in match subject
  // triggers phantom-drop codegen bug — see issues/inline-enum-match-subject-phantom-drop.md)
  k1 := CallResultKind.FunctionTypeResult;
  k2 := CallResultKind.ArrayTypeResult;
  k3 := CallResultKind.ClosureTypeResult;
  match(k1, .FunctionTypeResult => (), _ => assert(false, "FunctionTypeResult"));
  match(k2, .ArrayTypeResult => (), _ => assert(false, "ArrayTypeResult"));
  match(k3, .ClosureTypeResult => (), _ => assert(false, "ClosureTypeResult"));
});
test("get_function_call_result: returns None for TypeResult", {
  ty := t_unit();
  args := Option(ArrayList(AstExpr)).None;
  f := FunctionToCall(
    ty : ty,
    args : args,
    value : Option(EvalValue).None,
    result : CallResultKind.FunctionTypeResult
  );
  match(
    get_function_call_result(f),
    .None => (),
    .Some(_) => assert(false, "expected None for TypeResult")
  );
});
test("get_type_call_result: returns None for FunctionTypeResult", {
  ty := t_unit();
  f := FunctionToCall(
    ty : ty,
    args : Option(ArrayList(AstExpr)).None,
    value : Option(EvalValue).None,
    result : CallResultKind.FunctionTypeResult
  );
  match(
    get_type_call_result(f),
    .None => (),
    .Some(_) => assert(false, "expected None for FunctionTypeResult")
  );
});
// ---------------------------------------------------------------------------
// create_function_body_evaluation_context (Phase 3c)
// ---------------------------------------------------------------------------
{ create_function_body_evaluation_context } :: import("../../src/evaluator/context.yo");
{ assert, panic } :: import("std/assert");
test("create_function_body_evaluation_context: basic flags", {
  ctx := eval_context_new(String.from("/std"), String.from("test.yo"));
  env := Environment.new(`test`);
  // Build a simple fn() -> unit type
  func_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  body_ctx := create_function_body_evaluation_context(
    func_type,
    EvalValue.UnitVal,
    env,
    ctx
  );
  // Overridden flags
  assert(!body_ctx.is_executing, "is_executing should be false");
  assert(body_ctx.is_validating_function_definition, "is_validating_function_definition should be true");
  assert(!body_ctx.is_evaluating_function_type, "is_evaluating_function_type should be false");
  assert(!body_ctx.force_compile_time_bindings, "force_compile_time_bindings cleared");
  assert(!body_ctx.is_analyzing_ctfe_capability, "is_analyzing_ctfe_capability cleared");
});
test("create_function_body_evaluation_context: function body context embedded", {
  ctx := eval_context_new(String.from("/std"), String.from("test.yo"));
  env := Environment.new(`test`);
  func_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  body_ctx := create_function_body_evaluation_context(
    func_type,
    EvalValue.UnitVal,
    env,
    ctx
  );
  // FuncOrAsyncBlockCtx is embedded
  match(
    body_ctx.is_evaluating_function_body_or_async_block,
    .None => assert(false, "expected Some FuncOrAsyncBlockCtx"),
    .Some(fb) => match(
      fb.kind,
      .FunctionBody => (),
      _ => assert(false, "expected FunctionBody kind")
    )
  );
  // captured_variables is a fresh empty map
  match(
    body_ctx.captured_variables,
    .None => assert(false, "captured_variables should be Some"),
    .Some(_) => ()
  );
  // function_return_impl_concrete_type is a fresh empty list
  match(
    body_ctx.function_return_impl_concrete_type,
    .None => assert(false, "function_return_impl_concrete_type should be Some"),
    .Some(_) => ()
  );
});
test("create_function_body_evaluation_context: expected_type set to return(type)", {
  ctx := eval_context_new(String.from("/std"), String.from("test.yo"));
  env := Environment.new(`test`);
  func_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  body_ctx := create_function_body_evaluation_context(
    func_type,
    EvalValue.UnitVal,
    env,
    ctx
  );
  match(
    body_ctx.expected_type,
    .None => assert(false, "expected_type should be Some"),
    .Some(ectx) => match(
      ectx.ty,
      .Unit => (),
      // t_unit()
      _ => assert(false, "expected return(type to be Unit)")
    )
  );
});
test("create_function_body_evaluation_context: copies parent context fields", {
  ctx := eval_context_new(String.from("/custom/std"), String.from("mymod.yo"));
  ctx.is_inside_impl_block = true;
  env := Environment.new(`test`);
  func_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  body_ctx := create_function_body_evaluation_context(
    func_type,
    EvalValue.UnitVal,
    env,
    ctx
  );
  assert(body_ctx.std_path == "/custom/std", "std_path copied from parent");
  assert(body_ctx.is_inside_impl_block, "is_inside_impl_block copied from parent");
});
