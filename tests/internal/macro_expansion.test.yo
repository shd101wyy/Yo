/// Verifies: a user-defined macro should be recognized,
/// invoked with quoted arguments, and its returned ExprVal re-evaluated
/// in the caller environment.
///
/// We define the simplest possible macro:
///   id_macro :: (fn(quote(e) : Expr) -> unquote(Expr)) quote(unquote(e));
/// Then:
///   y := id_macro(42);
/// `y` should be `IntLit("42")` — i.e. the `42` literal returned by the
/// macro after splicing.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../yo-self/token.yo");
{ EvalValue } :: import("../../yo-self/value.yo");
{ has_comment_attribute, Evaluator } :: import("../../yo-self/evaluator/index.yo");
{ MACRO_DISPATCH_ENABLED } :: import("../../yo-self/evaluator/calls/function.yo");
{ assert, panic } :: import("std/assert");
noop_loader :: (fn(_path : String) -> Option(EvalValue))(
  Option(EvalValue).None
);
test("macro expansion: identity macro expands correctly", {
  // MACRO_DISPATCH_ENABLED is true (re-enabled 2026-06-11 — the old heap
  // corruption is fixed, see issues/fixed/); this body runs for real.
  if(MACRO_DISPATCH_ENABLED, {
    exn := Exception(
      throw : (
        (err) -> {
          assert(false, "unexpected error");
          unwind(());
        }
      )
    );
    src := String.from("pragma(Pragma.SkipPrelude);\nid_macro :: (fn(quote(e) : Expr) -> unquote(Expr))(quote(unquote(e)));\ny :: id_macro(42);\nexport(y);\n");
    eval := Evaluator.new(
      String.from("<phase6c1>"),
      String.from("<no-std>"),
      noop_loader,
      src,
      exn
    );
    match(
      eval.get_module_error(),
      .Some(_) => {
        assert(false, "module_error on identity macro");
      },
      .None => ()
    );
    match(
      eval.get_module_value(),
      .None => {
        assert(false, "no module value produced");
      },
      .Some(mv) => match(
        mv,
        .StructVal(_, names, values) => {
          (found_idx : Option(usize)) = .None;
          (i : usize) = usize(0);
          n := names.len();
          while(i < n, {
            match(
              names.get(i),
              .Some(nm) => cond(
                (nm == "y") => {
                  found_idx = .Some(i);
                },
                true => ()
              ),
              .None => ()
            );
            i = (i + usize(1));
          });
          match(
            found_idx,
            .None => {
              assert(false, "y not in module exports");
            },
            .Some(idx) => match(
              values.get(idx),
              .None => {
                assert(false, "y index missing in values");
              },
              .Some(yv) => match(
                yv,
                .IntLit(s) => assert(s == "42", "y is not 42"),
                _ => {
                  assert(false, "y is not an IntLit");
                }
              )
            )
          );
        },
        _ => {
          assert(false, "module value is not ModuleVal");
        }
      )
    );
  });
});
test("macro expansion: two-arg macro builds sum AST", {
  // MACRO_DISPATCH_ENABLED is true (re-enabled 2026-06-11 — the old heap
  // corruption is fixed, see issues/fixed/); this body runs for real.
  if(MACRO_DISPATCH_ENABLED, {
    exn := Exception(
      throw : (
        (err) -> {
          assert(false, "unexpected error");
          unwind(());
        }
      )
    );
    // The macro still BUILDS the sum AST, but the test asserts on its
    // STRUCTURE (__yo_expr_eq against quote((3 + 4))) instead of evaluating
    // it — `+` needs the prelude, and TS rejects evaluating the old
    // `unquote(Expr)` expansion under SkipPrelude (the real module evaluator
    // matches TS; the legacy walker never truly evaluated it).
    src := String.from("pragma(Pragma.SkipPrelude);\nadd_macro :: (fn(quote(a) : Expr, quote(b) : Expr) -> comptime(Expr))(quote((unquote(a) + unquote(b))));\nz :: __yo_expr_eq(add_macro(3, 4), quote((3 + 4)));\nexport(z);\n");
    eval := Evaluator.new(
      String.from("<phase6c2>"),
      String.from("<no-std>"),
      noop_loader,
      src,
      exn
    );
    match(
      eval.get_module_error(),
      .Some(_) => {
        assert(false, "module_error on add_macro");
      },
      .None => ()
    );
    match(
      eval.get_module_value(),
      .None => {
        assert(false, "no module value produced");
      },
      .Some(mv) => match(
        mv,
        .StructVal(_, names, values) => {
          (found_idx : Option(usize)) = .None;
          (i : usize) = usize(0);
          n := names.len();
          while(i < n, {
            match(
              names.get(i),
              .Some(nm) => cond(
                (nm == "z") => {
                  found_idx = .Some(i);
                },
                true => ()
              ),
              .None => ()
            );
            i = (i + usize(1));
          });
          match(
            found_idx,
            .None => {
              assert(false, "z not in module exports");
            },
            .Some(idx) => match(
              values.get(idx),
              .None => {
                assert(false, "z index missing in values");
              },
              .Some(zv) => match(
                zv,
                .BoolVal(b) => assert(b, "add_macro AST != quote((3 + 4))"),
                _ => {
                  assert(false, "z is not a BoolVal");
                }
              )
            )
          );
        },
        _ => {
          assert(false, "module value is not ModuleVal");
        }
      )
    );
  });
});
