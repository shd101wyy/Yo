//! Tests for src/types/guards.yo.
//!
//! Covers all guards that have real implementations (Phase 2a).
//! Phase 2b stubs (returning false) are tested to confirm they return false —
//! so a future implementation landing out of order gets caught.
{ String } :: import("std/string");
{ TypeValue, TypeValueNode, FuncMeta, shared_list, no_types, no_labels, no_flags, no_discriminants, no_type_lists, no_label_lists, SharedList } :: import("../../src/types/definitions.yo");
{ t_unit, t_bool, t_void, t_i32, t_u8, t_i8, t_u16, t_i16, t_u32, t_u64, t_i64, t_f32, t_f64, t_usize, t_isize, t_comptime_int, t_comptime_float, t_comptime_string, t_ptr, t_array, t_func_simple, t_trait_simple, t_module_simple, t_some_t, t_expr_t, t_comptime_list, t_dyn_simple, t_fn_trait_simple, t_future_trait_simple } :: import("../../src/types/creators.yo");
{ is_int_type, is_float_type } :: import("../../src/types/guards.yo");
{ ArrayList } :: import("std/collections/array_list");
{ assert, panic } :: import("std/assert");
{
  is_primitive_type,
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_comptime_list_type,
  is_expr_list_type,
  is_usize_type,
  is_isize_type,
  is_u8_type,
  is_i8_type,
  is_u16_type,
  is_i16_type,
  is_u32_type,
  is_i32_type,
  is_u64_type,
  is_i64_type,
  is_f32_type,
  is_f64_type,
  is_expr_type,
  is_unit_type,
  is_bool_type,
  is_void_type,
  is_tuple_type,
  is_union_type,
  is_struct_type,
  is_enum_type,
  is_function_type,
  is_trait_type,
  is_module_type,
  is_some_type,
  is_reference_struct_type,
  is_atomic_reference_struct_type,
  is_newtype_type,
  is_fn_trait_type,
  is_function_type_and_is_type_function,
  is_function_type_and_is_macro_function,
  is_function_type_and_returns_comptime_value,
  is_type_hierarchy_type,
  is_type_0,
  is_dyn_type,
  is_type_application_type,
  is_rc_type,
  is_integer_type,
  is_unsigned_integer_type,
  is_char_type,
  is_short_type,
  is_u_short_type,
  is_c_int_type,
  is_c_uint_type,
  is_long_type,
  is_u_long_type,
  is_long_long_type,
  is_u_long_long_type,
  is_long_double_type,
  is_future_trait_type,
  is_concrete_trait_type,
  is_c_compatible_type,
  is_function_type_generic,
  is_function_type_hard_generic,
  is_function_specializable,
  is_boxed_type,
  is_pointer_type,
  is_str_type,
  is_array_type,
  is_signed_int_type,
  is_numeric_type,
  is_comptime_only_type_simple,
  cell_handle_view,
  is_box_type,
  is_unique_box_type,
  is_counted_handle_type,
  is_atomic_counted_handle_type,
  can_optimize_as_nullable_pointer
} :: import("../../src/types/guards.yo");
{ box_inner_type, is_pattern_cell_type, _witness_cell_name } :: import("../../src/pattern.yo");
// Helper constructors for types not exposed by type.yo
t_cchar :: (fn() -> TypeValue)(rc(TypeValueNode.CChar));
t_cshort :: (fn() -> TypeValue)(rc(TypeValueNode.CShort));
t_cushort :: (fn() -> TypeValue)(rc(TypeValueNode.CUShort));
t_cint :: (fn() -> TypeValue)(rc(TypeValueNode.CInt));
t_cuint :: (fn() -> TypeValue)(rc(TypeValueNode.CUInt));
t_clong :: (fn() -> TypeValue)(rc(TypeValueNode.CLong));
t_culong :: (fn() -> TypeValue)(rc(TypeValueNode.CULong));
t_clonglong :: (fn() -> TypeValue)(rc(TypeValueNode.CLongLong));
t_culonglong :: (fn() -> TypeValue)(rc(TypeValueNode.CULongLong));
t_clongdouble :: (fn() -> TypeValue)(rc(TypeValueNode.CLongDouble));
t_typeuni0 :: (fn() -> TypeValue)(rc(TypeValueNode.TypeUni(usize(0))));
t_typeuni1 :: (fn() -> TypeValue)(rc(TypeValueNode.TypeUni(usize(1))));
t_tuple_empty :: (fn() -> TypeValue)(
  rc(TypeValueNode.Tuple(no_labels(), no_types()))
);
t_union_empty :: (fn() -> TypeValue)(
  rc(TypeValueNode.Union(String.from("U"), no_labels(), no_types()))
);
// ---------------------------------------------------------------------------
// Primitive guards
// ---------------------------------------------------------------------------
test("is_primitive_type: value types", {
  assert(is_primitive_type(t_unit()), "unit");
  assert(is_primitive_type(t_bool()), "bool");
  assert(is_primitive_type(t_usize()), "usize");
  assert(is_primitive_type(t_isize()), "isize");
  assert(is_primitive_type(t_i32()), "i32");
  assert(is_primitive_type(t_u8()), "u8");
  assert(is_primitive_type(t_f32()), "f32");
  assert(is_primitive_type(t_cchar()), "cchar");
  assert(is_primitive_type(t_clong()), "clong");
});
test("is_primitive_type: non-primitives return(false)", {
  assert(!is_primitive_type(t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit())), "func");
  assert(!is_primitive_type(t_trait_simple(String.from("T"))), "trait");
  assert(!is_primitive_type(t_some_t(String.from("A"), usize(0))), "some_t");
  assert(!is_primitive_type(t_comptime_int()), "comptime_int not primitive");
  assert(!is_primitive_type(t_comptime_float()), "comptime_float not primitive");
});
// ---------------------------------------------------------------------------
// Comptime type guards
// ---------------------------------------------------------------------------
test("is_comptime_int_type", {
  assert(is_comptime_int_type(t_comptime_int()), "comptime_int");
  assert(!is_comptime_int_type(t_i32()), "i32 not comptime_int");
  assert(!is_comptime_int_type(t_usize()), "usize not comptime_int");
});
test("is_comptime_float_type", {
  assert(is_comptime_float_type(t_comptime_float()), "comptime_float");
  assert(!is_comptime_float_type(t_f32()), "f32 not comptime_float");
});
test("is_comptime_string_type", {
  assert(is_comptime_string_type(t_comptime_string()), "comptime_str");
  assert(!is_comptime_string_type(t_bool()), "bool not comptime_str");
});
test("is_comptime_list_type: Phase 2b stub returns false", {
  assert(!is_comptime_list_type(t_unit()), "stub false");
});
test("is_expr_list_type: Phase 2b stub returns false", {
  assert(!is_expr_list_type(t_unit()), "stub false");
});
// ---------------------------------------------------------------------------
// Exact integer width guards
// ---------------------------------------------------------------------------
test("is_usize_type / is_isize_type", {
  assert(is_usize_type(t_usize()), "usize");
  assert(!is_usize_type(t_i32()), "i32 not usize");
  assert(is_isize_type(t_isize()), "isize");
  assert(!is_isize_type(t_u8()), "u8 not isize");
});
test("fixed-width integer guards", {
  assert(is_u8_type(t_u8()), "u8");
  assert(is_i8_type(t_i8()), "i8");
  assert(is_u16_type(t_u16()), "u16");
  assert(is_i16_type(t_i16()), "i16");
  assert(is_u32_type(t_u32()), "u32");
  assert(is_i32_type(t_i32()), "i32");
  assert(is_u64_type(t_u64()), "u64");
  assert(is_i64_type(t_i64()), "i64");
  // Cross-checks
  assert(!is_u8_type(t_i8()), "i8 not u8");
  assert(!is_i32_type(t_u32()), "u32 not i32");
  assert(!is_u64_type(t_i64()), "i64 not u64");
});
test("float guards", {
  assert(is_f32_type(t_f32()), "f32");
  assert(is_f64_type(t_f64()), "f64");
  assert(!is_f32_type(t_f64()), "f64 not f32");
  assert(!is_f64_type(t_i32()), "i32 not f64");
});
test("is_expr_type: Phase 2b stub returns false", {
  assert(!is_expr_type(t_unit()), "stub false");
});
// ---------------------------------------------------------------------------
// Simple scalar guards
// ---------------------------------------------------------------------------
test("is_unit_type / is_bool_type / is_void_type", {
  assert(is_unit_type(t_unit()), "unit");
  assert(is_bool_type(t_bool()), "bool");
  assert(is_void_type(t_void()), "void");
  assert(!is_unit_type(t_bool()), "bool not unit");
  assert(!is_bool_type(t_void()), "void not bool");
});
// ---------------------------------------------------------------------------
// Compound type guards
// ---------------------------------------------------------------------------
test("is_tuple_type", {
  assert(is_tuple_type(t_tuple_empty()), "tuple");
  assert(!is_tuple_type(t_i32()), "i32 not tuple");
});
test("is_union_type", {
  assert(is_union_type(t_union_empty()), "union");
  assert(!is_union_type(t_i32()), "i32 not union");
});
test("is_struct_type / is_enum_type / is_function_type / is_trait_type / is_module_type / is_some_type", {
  s := rc(TypeValueNode.Struct(id : String.from(""), name : String.from("S"), field_labels : no_labels(), field_types : no_types(), is_reference_semantics : false, is_atomic_rc : false, is_newtype : false, constructor_func_id : String.from(""), type_arguments : no_types(), is_source_namespace : false));
  e := rc(TypeValueNode.EnumT(String.from(""), String.from("E"), no_labels(), no_type_lists(), Option(String).None, no_label_lists(), no_discriminants(), false, false, no_types()));
  f := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  tr := t_trait_simple(String.from("T"));
  m := t_module_simple(String.from("M"));
  sm := t_some_t(String.from("A"), usize(0));
  assert(is_struct_type(&s), "struct");
  assert(is_enum_type(&e), "enum");
  assert(is_function_type(&f), "function");
  assert(is_trait_type(&tr), "trait");
  assert(is_module_type(&m), "module");
  assert(is_some_type(&sm), "some_t");
  assert(!is_struct_type(t_i32()), "i32 not struct");
  assert(!is_function_type(t_bool()), "bool not function");
});
test("Phase 2b stubs: object / atomic / newtype / fn_trait / iso / dyn / type_app / rc / specializable / boxed", {
  assert(!is_reference_struct_type(t_i32()), "object stub");
  assert(!is_atomic_reference_struct_type(t_i32()), "atomic_object stub");
  assert(!is_newtype_type(t_i32()), "newtype stub");
  assert(!is_fn_trait_type(t_i32()), "fn_trait stub");
  assert(!is_dyn_type(t_i32()), "dyn stub");
  assert(!is_type_application_type(t_i32()), "type_app stub");
  assert(!is_rc_type(t_i32()), "rc stub");
  assert(!is_function_specializable(t_i32()), "specializable stub");
  assert(!is_boxed_type(t_i32()), "boxed stub");
  assert(!is_future_trait_type(t_i32()), "future_trait stub");
  assert(!is_concrete_trait_type(t_i32()), "concrete_trait stub");
  assert(!is_function_type_and_is_macro_function(t_i32()), "macro_fn stub");
  assert(!is_function_type_and_returns_comptime_value(t_i32()), "comptime_fn stub");
});
// ---------------------------------------------------------------------------
// Type hierarchy guards
// ---------------------------------------------------------------------------
test("is_type_hierarchy_type / is_type_0", {
  assert(is_type_hierarchy_type(t_typeuni0()), "TypeUni(0)");
  assert(is_type_hierarchy_type(t_typeuni1()), "TypeUni(1)");
  assert(!is_type_hierarchy_type(t_i32()), "i32 not TypeUni");
  assert(is_type_0(t_typeuni0()), "level 0");
  assert(!is_type_0(t_typeuni1()), "level 1 is not 0");
});
test("is_function_type_and_is_type_function", {
  f_ret_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_typeuni0());
  f_ret_unit := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  assert(is_function_type_and_is_type_function(&f_ret_type), "fn returning TypeUni");
  assert(!is_function_type_and_is_type_function(&f_ret_unit), "fn returning unit");
});
test("is_comptime_only_type_simple", {
  // Comptime-only types → true
  assert(is_comptime_only_type_simple(t_comptime_int()), "ComptimeInt");
  assert(is_comptime_only_type_simple(t_comptime_float()), "ComptimeFloat");
  assert(is_comptime_only_type_simple(t_comptime_string()), "ComptimeString");
  assert(is_comptime_only_type_simple(t_typeuni0()), "TypeUni(0)");
  assert(is_comptime_only_type_simple(t_comptime_list(t_i32())), "ComptimeList");
  assert(is_comptime_only_type_simple(t_expr_t()), "ExprT");
  // Non-comptime-only types → false
  assert(!is_comptime_only_type_simple(t_i32()), "i32");
  assert(!is_comptime_only_type_simple(t_bool()), "bool");
  assert(!is_comptime_only_type_simple(t_unit()), "unit");
  assert(!is_comptime_only_type_simple(t_f64()), "f64");
  assert(!is_comptime_only_type_simple(t_usize()), "usize");
});
test("is_function_type_and_returns_comptime_value", {
  f_ret_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_typeuni0());
  f_ret_cint := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_comptime_int());
  f_ret_unit := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  f_ret_i32 := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_i32());
  // fn returning comptime-only types → true
  assert(is_function_type_and_returns_comptime_value(&f_ret_type), "fn → TypeUni(0)");
  assert(is_function_type_and_returns_comptime_value(&f_ret_cint), "fn → ComptimeInt");
  // fn returning runtime/dual types → false
  assert(!is_function_type_and_returns_comptime_value(&f_ret_unit), "fn → unit");
  assert(!is_function_type_and_returns_comptime_value(&f_ret_i32), "fn → i32");
  // Non-function type → false
  assert(!is_function_type_and_returns_comptime_value(t_i32()), "i32 not fn");
  assert(!is_function_type_and_returns_comptime_value(t_unit()), "unit not fn");
});
// ---------------------------------------------------------------------------
// Numeric extended guards
// ---------------------------------------------------------------------------
test("is_integer_type: includes Usize/Isize", {
  assert(is_integer_type(t_i32()), "i32");
  assert(is_integer_type(t_u8()), "u8");
  assert(is_integer_type(t_usize()), "usize");
  assert(is_integer_type(t_isize()), "isize");
  assert(!is_integer_type(t_f32()), "f32 not integer");
  assert(!is_integer_type(t_bool()), "bool not integer");
});
test("is_unsigned_integer_type", {
  assert(is_unsigned_integer_type(t_u8()), "u8");
  assert(is_unsigned_integer_type(t_u32()), "u32");
  assert(is_unsigned_integer_type(t_usize()), "usize");
  assert(!is_unsigned_integer_type(t_i32()), "i32 not unsigned");
  assert(!is_unsigned_integer_type(t_isize()), "isize not unsigned");
});
// ---------------------------------------------------------------------------
// C-compatible guards
// ---------------------------------------------------------------------------
test("C type guards", {
  assert(is_char_type(t_cchar()), "cchar");
  assert(is_short_type(t_cshort()), "cshort");
  assert(is_u_short_type(t_cushort()), "cushort");
  assert(is_c_int_type(t_cint()), "cint");
  assert(is_c_uint_type(t_cuint()), "cuint");
  assert(is_long_type(t_clong()), "clong");
  assert(is_u_long_type(t_culong()), "culong");
  assert(is_long_long_type(t_clonglong()), "clonglong");
  assert(is_u_long_long_type(t_culonglong()), "culonglong");
  assert(is_long_double_type(t_clongdouble()), "clongdouble");
  assert(!is_char_type(t_i32()), "i32 not cchar");
});
test("is_c_compatible_type", {
  assert(is_c_compatible_type(t_cchar()), "cchar");
  assert(is_c_compatible_type(t_cshort()), "cshort");
  assert(is_c_compatible_type(t_cushort()), "cushort");
  assert(is_c_compatible_type(t_cint()), "cint");
  assert(is_c_compatible_type(t_cuint()), "cuint");
  assert(is_c_compatible_type(t_clong()), "clong");
  assert(is_c_compatible_type(t_culong()), "culong");
  assert(is_c_compatible_type(t_clonglong()), "clonglong");
  assert(is_c_compatible_type(t_culonglong()), "culonglong");
  assert(is_c_compatible_type(t_clongdouble()), "clongdouble");
  assert(!is_c_compatible_type(t_i32()), "i32 not C");
  assert(!is_c_compatible_type(t_usize()), "usize not C");
  assert(!is_c_compatible_type(t_bool()), "bool not C");
});
// ---------------------------------------------------------------------------
// Function genericity guards
// ---------------------------------------------------------------------------
test("is_function_type_generic: simple func not generic", {
  f := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  assert(!is_function_type_generic(&f), "simple func");
});
test("is_function_type_generic: generic func is generic", {
  // Build a Func variant with one generic label
  fl := ArrayList(String).new();
  ft := ArrayList(TypeValue).new();
  fl.push(String.from("T"));
  ft.push(rc(TypeValueNode.TypeUni(usize(0))));
  f := rc(
    TypeValueNode.Func(
      shared_list(ft),
      no_types(),
      no_types(),
      no_types(),
      t_unit(),
      rc(
        FuncMeta(
          forall_labels : shared_list(fl),
          param_labels : no_labels(),
          implicit_labels : no_labels(),
          result_is_comptime_only : false,
          param_is_ref : no_flags(),
          param_is_owning : no_flags(),
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          extern_name : Option(String).None,
          is_control : false,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      no_types()
    )
  );
  assert(is_function_type_generic(&f), "generic func generic");
  assert(is_function_type_hard_generic(&f), "generic func hard generic");
});
test("is_function_type_generic: implicit params make generic (but not hard)", {
  // Build a Func with one implicit (using) label and no generic
  il := ArrayList(String).new();
  it_ := ArrayList(TypeValue).new();
  il.push(String.from("io"));
  it_.push(t_module_simple(String.from("Io")));
  f := rc(
    TypeValueNode.Func(
      no_types(),
      no_types(),
      shared_list(it_),
      no_types(),
      t_unit(),
      rc(
        FuncMeta(
          forall_labels : no_labels(),
          param_labels : no_labels(),
          implicit_labels : shared_list(il),
          result_is_comptime_only : false,
          param_is_ref : no_flags(),
          param_is_owning : no_flags(),
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          extern_name : Option(String).None,
          is_control : false,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      no_types()
    )
  );
  assert(is_function_type_generic(&f), "implicit func generic");
  assert(!is_function_type_hard_generic(&f), "implicit func NOT hard generic");
});
test("is_function_type_hard_generic: simple func not hard generic", {
  f := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  assert(!is_function_type_hard_generic(&f), "simple not hard generic");
});
// ---------------------------------------------------------------------------
// Re-exported guards from type.yo
// ---------------------------------------------------------------------------
test("re-exported guards from type.yo still work", {
  assert(is_int_type(t_i32()), "is_int_type i32");
  assert(is_float_type(t_f32()), "is_float_type f32");
  assert(is_signed_int_type(t_i32()), "is_signed_int_type i32");
  assert(!is_signed_int_type(t_u32()), "u32 not signed");
  assert(is_pointer_type(t_ptr(t_i32())), "pointer");
  assert(is_str_type(rc(TypeValueNode.Str)), "str");
  assert(is_array_type(t_array(t_u8(), usize(4))), "array");
});
// ---------------------------------------------------------------------------
// Phase 2f: positive tests for newly implemented guards
// ---------------------------------------------------------------------------
test("is_expr_type: ExprT returns true", {
  assert(is_expr_type(t_expr_t()), "ExprT → true");
  assert(!is_expr_type(t_i32()), "i32 → false");
  assert(!is_expr_type(t_unit()), "unit → false");
});
test("is_comptime_list_type: ComptimeListT returns true", {
  assert(is_comptime_list_type(t_comptime_list(t_i32())), "CL(i32) → true");
  assert(!is_comptime_list_type(t_i32()), "i32 → false");
});
test("is_expr_list_type: ComptimeList of Expr returns true", {
  assert(is_expr_list_type(t_comptime_list(t_expr_t())), "CL(Expr) → true");
  assert(!is_expr_list_type(t_comptime_list(t_i32())), "CL(i32) → false");
  assert(!is_expr_list_type(t_i32()), "i32 → false");
});
test("is_dyn_type: DynT returns true", {
  assert(is_dyn_type(t_dyn_simple(ArrayList(TypeValue).new())), "dyn() → true");
  assert(!is_dyn_type(t_i32()), "i32 → false");
});
test("is_fn_trait_type: FnTraitT returns true", {
  fn1 := t_fn_trait_simple(String.from("Fn"), ArrayList(TypeValue).new(), t_unit());
  assert(is_fn_trait_type(&fn1), "FnTraitT → true");
  assert(!is_fn_trait_type(t_i32()), "i32 → false");
});
test("is_future_trait_type: FutureTraitT returns true", {
  f1 := t_future_trait_simple(String.from("Io"), t_unit());
  assert(is_future_trait_type(&f1), "FutureTraitT → true");
  assert(!is_future_trait_type(t_i32()), "i32 → false");
});
test("is_trait_type: FnTraitT and FutureTraitT are also trait types", {
  fn1 := t_fn_trait_simple(String.from("Fn"), ArrayList(TypeValue).new(), t_unit());
  f1 := t_future_trait_simple(String.from("Io"), t_unit());
  assert(is_trait_type(t_trait_simple(String.from("Display"))), "TraitT → true");
  assert(is_trait_type(&fn1), "FnTraitT is trait type");
  assert(is_trait_type(&f1), "FutureTraitT is trait type");
  assert(!is_trait_type(t_i32()), "i32 not trait type");
});
// ---------------------------------------------------------------------------
// is_rc_type: Phase 3 implementation tests
// ---------------------------------------------------------------------------
test("is_rc_type: i32 and primitives are not RC", {
  assert(!is_rc_type(t_i32()), "i32 → false");
  assert(!is_rc_type(t_bool()), "bool → false");
  assert(!is_rc_type(t_usize()), "usize → false");
  assert(!is_rc_type(t_unit()), "unit → false");
});
test("is_rc_type: struct (not object) is not RC", {
  labels := ArrayList(String).new();
  types := ArrayList(TypeValue).new();
  struct_ty := rc(
    TypeValueNode.Struct(
      id : String.from("id1"),
      name : String.from("Point"),
      field_labels : shared_list(labels),
      field_types : shared_list(types),
      is_reference_semantics : false,
      is_atomic_rc : false,
      is_newtype : false,
      constructor_func_id : String.from(""),
      type_arguments : no_types(),
      is_source_namespace : false
    )
  );
  assert(!is_rc_type(&struct_ty), "struct → false");
});
test("is_rc_type: object (is_reference_semantics=true) is RC", {
  labels := ArrayList(String).new();
  types := ArrayList(TypeValue).new();
  obj_ty := rc(
    TypeValueNode.Struct(
      id : String.from("id2"),
      name : String.from("MyObj"),
      field_labels : shared_list(labels),
      field_types : shared_list(types),
      is_reference_semantics : true,
      is_atomic_rc : false,
      is_newtype : false,
      constructor_func_id : String.from(""),
      type_arguments : no_types(),
      is_source_namespace : false
    )
  );
  assert(is_rc_type(&obj_ty), "object → true");
});
test("is_rc_type: DynT is RC", {
  dyn_ty := t_dyn_simple(ArrayList(TypeValue).new());
  assert(is_rc_type(&dyn_ty), "DynT → true");
});
test("is_rc_type: SomeT with no Future constraint is not RC", {
  // A SomeT with no required traits: not RC
  some_ty := t_some_t(String.from("T"), usize(0));
  assert(!is_rc_type(&some_ty), "SomeT no future → false");
});
test("is_rc_type: SomeT with Future trait constraint is RC", {
  // A SomeT with a Future trait in required_trait_types
  req := ArrayList(TypeValue).new();
  req.push(t_future_trait_simple(String.from("Io"), t_unit()));
  some_ty := rc(
    TypeValueNode.SomeT(
      String.from("id3"),
      String.from("T"),
      usize(0),
      rc(TypeValueNode.TypeUni(usize(0))),
      req,
      ArrayList(usize).new(),
      ArrayList(TypeValue).new(),
      ArrayList(usize).new(),
      Option(TypeValue).None,
      Option(TypeValue).None
    )
  );
  assert(is_rc_type(&some_ty), "SomeT with Future → true");
});
// ---------------------------------------------------------------------------
// Cell handles (plans/VALUES_BY_DEFAULT.md §3.5, V5's seed predicates): a
// newtype whose one field `_cell` is a cell primitive is the shape V5 gives
// `Rc`/`Arc`. Built by hand: the primitive is a `ref` struct with one `*`
// field whose constructor id is the builtin's name.
// ---------------------------------------------------------------------------
_one_field_struct :: (fn(name : str, label : str, field : TypeValue, is_ref : bool, is_atomic : bool, is_newtype : bool, cfid : str) -> TypeValue)({
  labels := ArrayList(String).new();
  labels.push(String.from(label));
  types := ArrayList(TypeValue).new();
  types.push(field);
  rc(
    TypeValueNode.Struct(
      id : String.from(name),
      name : String.from(name),
      field_labels : shared_list(labels),
      field_types : shared_list(types),
      is_reference_semantics : is_ref,
      is_atomic_rc : is_atomic,
      is_newtype : is_newtype,
      constructor_func_id : String.from(cfid),
      type_arguments : no_types(),
      is_source_namespace : false
    )
  )
});
_cell_of :: (fn(payload : TypeValue, is_atomic : bool) -> TypeValue)(
  _one_field_struct(if(is_atomic, "__yo_atomic_cell#i32", "__yo_cell#i32"), "*", payload, true, is_atomic, false, if(is_atomic, "__yo_atomic_cell", "__yo_cell"))
);
_view_of :: (fn(name : str, payload : TypeValue, is_atomic : bool) -> TypeValue)(
  _one_field_struct(name, "_cell", _cell_of(payload, is_atomic), false, false, true, "")
);
/// `enum(None, Some(payload))`, the `Option` shape.
_option_of :: (fn(payload : TypeValue) -> TypeValue)({
  names := ArrayList(String).new();
  names.push(String.from("None"));
  names.push(String.from("Some"));
  none_fields := ArrayList(TypeValue).new();
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(payload);
  fields := ArrayList(SharedList(TypeValue)).new();
  fields.push(shared_list(none_fields));
  fields.push(shared_list(some_fields));
  rc(TypeValueNode.EnumT(String.from("opt"), String.from("Option"), shared_list(names), shared_list(fields), Option(String).None, no_label_lists(), no_discriminants(), false, false, no_types()))
});
test("cell_handle_view: a newtype over a cell primitive, atomic or not, and nothing else", {
  v := _view_of("Rc(i32)", t_i32(), false);
  a := _view_of("Arc(i32)", t_i32(), true);
  match(
    cell_handle_view(&v),
    .Some(hv) => {
      assert(is_i32_type(&hv.payload), "the payload is the cell's field");
      assert(!hv.is_atomic, "the non-atomic cell");
      assert(is_reference_struct_type(&hv.cell), "the cell is a ref struct");
    },
    .None => panic("a view")
  );
  assert(match(cell_handle_view(&a), .Some(hv) => hv.is_atomic, .None => false), "the atomic cell");
  // Decision D3: a plain struct over a cell is not a handle.
  plain := _one_field_struct("Locked(i32)", "_cell", _cell_of(t_i32(), true), false, false, false, "");
  assert(cell_handle_view(&plain).is_none(), "a struct, not a newtype");
  // Another label, or a field that is a plain `ref` struct, is not one.
  other_label := _one_field_struct("W(i32)", "inner", _cell_of(t_i32(), false), false, false, true, "");
  assert(cell_handle_view(&other_label).is_none(), "the field must be `_cell`");
  plain_ref := _one_field_struct("R", "*", t_i32(), true, false, false, "");
  over_ref := _one_field_struct("W2(i32)", "_cell", plain_ref, false, false, true, "");
  assert(cell_handle_view(&over_ref).is_none(), "a ref struct that is not a cell primitive");
  // S4: Box (`newtype(_cell : *V)`) is disjoint from the views.
  bx := _one_field_struct("Box(i32)", "_cell", t_ptr(t_i32()), false, false, true, "");
  assert(is_unique_box_type(&bx), "Box");
  assert(cell_handle_view(&bx).is_none(), "Box is not a cell handle");
  assert(!is_box_type(&bx) && !is_boxed_type(&bx), "nor a shared cell");
});
test("the shared-cell predicates accept a cell handle (S1-S3)", {
  v := _view_of("Rc(i32)", t_i32(), false);
  a := _view_of("Arc(i32)", t_i32(), true);
  assert(is_box_type(&v), "S1: a non-atomic handle is the shared cell");
  assert(!is_box_type(&a), "S1: an atomic one is not");
  assert(is_boxed_type(&v), "S2: a non-atomic handle boxes its payload");
  assert(is_boxed_type(&a), "S2: an atomic handle of a value boxes it");
  obj := _one_field_struct("Obj", "n", t_i32(), true, false, false, "");
  a_obj := _view_of("Arc(Obj)", obj, true);
  assert(!is_boxed_type(&a_obj), "S2: an atomic handle of an object is an object");
  assert(is_counted_handle_type(&v) && is_counted_handle_type(&a), "both are counted handles");
  assert(!is_atomic_counted_handle_type(&v) && is_atomic_counted_handle_type(&a), "only the atomic one counts atomically");
  assert(!is_rc_type(&v), "field-wise: the newtype itself is not an RC type");
  // S3: `Option` of a non-atomic handle folds to the cell pointer; of an
  // atomic one it keeps the tag.
  assert(can_optimize_as_nullable_pointer(&_option_of(v)).is_some(), "S3: the niche");
  assert(can_optimize_as_nullable_pointer(&_option_of(a)).is_none(), "S3: tagged");
});
test("the pattern helpers look through a cell handle (S5, S6)", {
  v := _view_of("Rc(i32)", t_i32(), false);
  a := _view_of("Arc(i32)", t_i32(), true);
  assert(match(box_inner_type(&v), .Some(p) => is_i32_type(&p), .None => false), "S5: the payload");
  assert(match(box_inner_type(&a), .Some(p) => is_i32_type(&p), .None => false), "S5: the atomic payload");
  assert(is_pattern_cell_type(&v) && is_pattern_cell_type(&a), "S5: both are cells a pattern names");
  assert(match(_witness_cell_name(&v), .Some(n) => (n == "Rc"), .None => false), "S6: Rc");
  assert(match(_witness_cell_name(&a), .Some(n) => (n == "Arc"), .None => false), "S6: Arc");
  plain := _one_field_struct("Locked(i32)", "_cell", _cell_of(t_i32(), true), false, false, false, "");
  assert(!is_pattern_cell_type(&plain), "D3: a struct over a cell is not");
});
