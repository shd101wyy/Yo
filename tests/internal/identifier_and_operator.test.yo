/// Tests for yo-se../evaluator/exprs/identifer_and_operator.yo — Phase 3x
///
/// Covers:
///   - Built-in type keyword resolution (e.g. "i32" → TypeVal(i32))
///   - Variable lookup: defined variable returns type and value
///   - Variable lookup: undefined variable throws
///   - throw_error_on_undefined=false does not throw for missing value
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../src/token.yo");
{ AstExpr, ast_expr_id } :: import("../../src/expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_get, expr_info_table_set }
:: import("../../src/expr_info.yo");
{ Environment, add_variable_to_env } :: import("../../src/env.yo");
{ EvalContext, eval_context_new } :: import("../../src/evaluator/context.yo");
{ EvalValue, is_type_val } :: import("../../src/value.yo");
{ TypeValue } :: import("../../src/types/definitions.yo");
{ t_i32, t_bool } :: import("../../src/types/creators.yo");
{ set_evaluate_expression_fn } :: import("../../src/evaluator/exprs/expr.yo");
{ evaluate_identifier_and_operator }
:: import("../../src/evaluator/exprs/identifer_and_operator.yo");
{ Exception } :: import("std/error");
{ assert, panic } :: import("std/assert");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
mk_ident_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
mk_ident :: (fn(id : usize, name : str) -> AstExpr)(
  AstExpr.Atom(id, mk_ident_token(name))
);
// A no-op stub evaluator.
stub_eval :: (
  fn(
    expr : AstExpr,
    _env : Environment,
    _ctx : EvalContext
  ) -> AstExpr
)(expr);
// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------
test("evaluate_identifier_and_operator: builtin keyword i32 → TypeVal", {
  set_evaluate_expression_fn(stub_eval);
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  env := Environment.new(String.from("test"));
  ctx := eval_context_new(String.from(""), String.from("test"));
  expr := mk_ident(usize(1), "i32");
  evaluate_identifier_and_operator(expr, env, ctx, true, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(expr));
  assert(info_opt.is_some(), "ExprInfo set for i32");
  match(
    info_opt,
    .Some(info) => {
      assert(info.value.is_some(), "value is present for i32");
      match(
        info.value,
        .Some(v) => assert(is_type_val(v), "value is TypeVal for i32"),
        .None => assert(false, "no value for i32 keyword")
      );
    },
    .None => assert(false, "no ExprInfo for i32")
  );
});
test("evaluate_identifier_and_operator: builtin keyword bool → TypeVal", {
  set_evaluate_expression_fn(stub_eval);
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  env := Environment.new(String.from("test"));
  ctx := eval_context_new(String.from(""), String.from("test"));
  expr := mk_ident(usize(2), "bool");
  evaluate_identifier_and_operator(expr, env, ctx, true, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(expr));
  assert(info_opt.is_some(), "ExprInfo set for bool");
  match(
    info_opt,
    .Some(info) => assert(info.value.is_some(), "value is TypeVal for bool"),
    .None => assert(false, "no ExprInfo for bool")
  );
});
test("evaluate_identifier_and_operator: defined variable returns type and value", {
  set_evaluate_expression_fn(stub_eval);
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  env := Environment.new(String.from("test"));
  tok := mk_ident_token("x");
  add_variable_to_env(
    env,
    String.from("x"),
    t_i32(),
    Option(EvalValue).Some(EvalValue.IntLit(String.from("42"))),
    true,
    // compile_time_only
    false,
    // reassignable
    false,
    // rc
    false,
    // implicit
    tok
  );
  ctx := eval_context_new(String.from(""), String.from("test"));
  expr := mk_ident(usize(3), "x");
  evaluate_identifier_and_operator(expr, env, ctx, true, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(expr));
  assert(info_opt.is_some(), "ExprInfo set for x");
  match(
    info_opt,
    .Some(info) => {
      // Value should be IntLit("42")
      match(
        info.value,
        .Some(v) => match(
          v,
          .IntLit(s) => assert(s == "42", "value is IntLit 42"),
          _ => assert(false, "value should be IntLit")
        ),
        .None => assert(false, "no value for x")
      );
    },
    .None => assert(false, "no ExprInfo for x")
  );
});
test("evaluate_identifier_and_operator: undefined variable throws", {
  set_evaluate_expression_fn(stub_eval);
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  env := Environment.new(String.from("test"));
  ctx := eval_context_new(String.from(""), String.from("test"));
  expr := mk_ident(usize(4), "undefined_var");
  evaluate_identifier_and_operator(expr, env, ctx, true, exn);
  // If no exception was thrown, we reach here → test fails
  assert(false, "should have thrown for undefined variable");
});
test("evaluate_identifier_and_operator: throw_error_on_undefined=false on uninitialized", {
  set_evaluate_expression_fn(stub_eval);
  exn := Exception(
    throw : (
      err -> {
        assert(false, "should not throw when throw_error_on_undefined=false");
        unwind(());
      }
    )
  );
  env := Environment.new(String.from("test"));
  tok := mk_ident_token("y");
  // Add variable with no value (simulate uninitialized / forward reference)
  add_variable_to_env(
    env,
    String.from("y"),
    t_bool(),
    Option(EvalValue).None,
    // no value
    false,
    // compile_time_only
    false,
    // reassignable
    false,
    // rc
    false,
    // implicit
    tok
  );
  ctx := eval_context_new(String.from(""), String.from("test"));
  expr := mk_ident(usize(5), "y");
  // throw_error_on_undefined=false: no error expected
  evaluate_identifier_and_operator(expr, env, ctx, false, exn);
  // Reaching here means no exception was thrown — correct
});
