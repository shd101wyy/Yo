/// Tests for Phase 2h: EvalValue new variants, value_to_string, and predicates.
///
/// Covers: TupleVal, ArrayVal, PtrVal, TraitVal, ComptimeListVal, ExprVal.
open(import("std/fmt"));
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, make_err_expr } :: import("../../src/expr.yo");
{ TokenKind, Token } :: import("../../src/token.yo");
{ assert, panic } :: import("std/assert");
{
  EvalValue,
  value_to_string,
  is_unit_val,
  is_bool_val,
  is_int_lit,
  is_float_lit,
  is_str_lit,
  is_var_ref,
  is_enum_val,
  is_func_val,
  is_return_val,
  is_type_val,
  is_struct_val,
  is_module_val,
  is_tuple_val,
  is_array_val,
  is_ptr_val,
  is_trait_val,
  is_comptime_list_val,
  is_expr_val
} :: import("../../src/value.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
make_fields :: (fn(vs : ArrayList(EvalValue)) -> ArrayList(EvalValue))(vs);
make_empty_list :: (fn() -> ArrayList(EvalValue))(
  ArrayList(EvalValue).new()
);
// ---------------------------------------------------------------------------
// TupleVal
// ---------------------------------------------------------------------------
test("TupleVal: empty tuple construction and equality", {
  fields := ArrayList(EvalValue).new();
  t1 := EvalValue.TupleVal(fields);
  t2 := EvalValue.TupleVal(ArrayList(EvalValue).new());
  assert(t1 == t2, "empty tuples are equal");
  assert(!(t1 == EvalValue.UnitVal), "TupleVal != UnitVal");
});
test("TupleVal: non-empty equality and inequality", {
  a := ArrayList(EvalValue).new();
  a.push(.IntLit(String.from("1")));
  a.push(.IntLit(String.from("2")));
  b := ArrayList(EvalValue).new();
  b.push(.IntLit(String.from("1")));
  b.push(.IntLit(String.from("2")));
  c := ArrayList(EvalValue).new();
  c.push(.IntLit(String.from("1")));
  c.push(.IntLit(String.from("99")));
  assert(EvalValue.TupleVal(a) == EvalValue.TupleVal(b), "same tuples are equal");
  assert(!(EvalValue.TupleVal(a) == EvalValue.TupleVal(c)), "different tuples are not equal");
});
test("TupleVal: predicates", {
  t := EvalValue.TupleVal(ArrayList(EvalValue).new());
  assert(is_tuple_val(t), "is_tuple_val true");
  assert(!(is_array_val(t)), "is_array_val false for TupleVal");
  assert(!(is_unit_val(t)), "is_unit_val false for TupleVal");
});
test("TupleVal: value_to_string empty", {
  t := EvalValue.TupleVal(ArrayList(EvalValue).new());
  assert(value_to_string(t) == "()", "empty tuple string");
});
test("TupleVal: value_to_string singleton (trailing comma)", {
  fs := ArrayList(EvalValue).new();
  fs.push(.IntLit(String.from("42")));
  t := EvalValue.TupleVal(fs);
  assert(value_to_string(t) == "(42,)", "singleton tuple string");
});
test("TupleVal: value_to_string multi", {
  fs := ArrayList(EvalValue).new();
  fs.push(.IntLit(String.from("1")));
  fs.push(.BoolVal(true));
  t := EvalValue.TupleVal(fs);
  assert(value_to_string(t) == "(1, true)", "multi-element tuple string");
});
// ---------------------------------------------------------------------------
// ArrayVal
// ---------------------------------------------------------------------------
test("ArrayVal: empty array equality", {
  a := EvalValue.ArrayVal(ArrayList(EvalValue).new());
  b := EvalValue.ArrayVal(ArrayList(EvalValue).new());
  assert(a == b, "empty arrays are equal");
});
test("ArrayVal: element-wise equality", {
  a := ArrayList(EvalValue).new();
  a.push(.IntLit(String.from("10")));
  b := ArrayList(EvalValue).new();
  b.push(.IntLit(String.from("10")));
  c := ArrayList(EvalValue).new();
  c.push(.IntLit(String.from("99")));
  assert(EvalValue.ArrayVal(a) == EvalValue.ArrayVal(b), "equal arrays");
  assert(!(EvalValue.ArrayVal(a) == EvalValue.ArrayVal(c)), "unequal arrays");
});
test("ArrayVal: length mismatch is not equal", {
  a := ArrayList(EvalValue).new();
  a.push(.IntLit(String.from("1")));
  b := ArrayList(EvalValue).new();
  b.push(.IntLit(String.from("1")));
  b.push(.IntLit(String.from("2")));
  assert(!(EvalValue.ArrayVal(a) == EvalValue.ArrayVal(b)), "different lengths unequal");
});
test("ArrayVal: predicates", {
  v := EvalValue.ArrayVal(ArrayList(EvalValue).new());
  assert(is_array_val(v), "is_array_val true");
  assert(!(is_tuple_val(v)), "is_tuple_val false for ArrayVal");
});
test("ArrayVal: value_to_string", {
  elems := ArrayList(EvalValue).new();
  elems.push(.IntLit(String.from("1")));
  elems.push(.IntLit(String.from("2")));
  v := EvalValue.ArrayVal(elems);
  assert(value_to_string(v) == "[1, 2]", "array string [1, 2]");
});
test("ArrayVal: value_to_string singleton (trailing comma)", {
  elems := ArrayList(EvalValue).new();
  elems.push(.IntLit(String.from("5")));
  v := EvalValue.ArrayVal(elems);
  assert(value_to_string(v) == "[5,]", "singleton array string");
});
// ---------------------------------------------------------------------------
// PtrVal
// ---------------------------------------------------------------------------
// `PtrVal(target_value : ArrayList(Self), target_index : usize)` — the first
// field is the shared mutable CELL (the same one-element list a `Variable` holds
// as its `value`), not a bare `EvalValue`. `value_to_string` reads `cell.get(0)`
// and, only if that element is an `ArrayVal`, indexes into it with
// `target_index`. These tests predate the cell and were passing a bare value, so
// the file failed to compile and all five reported as failures.
_ptr_cell :: (fn(target : EvalValue) -> ArrayList(EvalValue))({
  cell := ArrayList(EvalValue).new();
  cell.push(target);
  cell
});
test("PtrVal: always unequal", {
  p1 := EvalValue.PtrVal(_ptr_cell(EvalValue.IntLit(String.from("42"))), usize(0));
  p2 := EvalValue.PtrVal(_ptr_cell(EvalValue.IntLit(String.from("42"))), usize(0));
  // Pointer alias identity is not portable; always false.
  assert(!(p1 == p2), "PtrVal equality is always false");
});
test("PtrVal: predicates", {
  p := EvalValue.PtrVal(_ptr_cell(EvalValue.UnitVal), usize(0));
  assert(is_ptr_val(p), "is_ptr_val true");
  assert(!(is_array_val(p)), "is_array_val false for PtrVal");
});
test("PtrVal: value_to_string scalar target", {
  p := EvalValue.PtrVal(_ptr_cell(EvalValue.IntLit(String.from("7"))), usize(0));
  assert(value_to_string(p) == "<ptr to 7>", "ptr to scalar");
});
test("PtrVal: value_to_string array element", {
  elems := ArrayList(EvalValue).new();
  elems.push(.IntLit(String.from("10")));
  elems.push(.IntLit(String.from("20")));
  // The ArrayVal lives INSIDE the cell; `target_index` then selects the element.
  p := EvalValue.PtrVal(_ptr_cell(EvalValue.ArrayVal(elems)), usize(1));
  assert(value_to_string(p) == "<ptr to 20>", "ptr to array element");
});
// ---------------------------------------------------------------------------
// TraitVal
// ---------------------------------------------------------------------------
test("TraitVal: empty trait equality", {
  t1 := EvalValue.TraitVal(
    String.from("Display"),
    ArrayList(String).new(),
    ArrayList(Option(EvalValue)).new()
  );
  t2 := EvalValue.TraitVal(
    String.from("Display"),
    ArrayList(String).new(),
    ArrayList(Option(EvalValue)).new()
  );
  assert(t1 == t2, "empty same-named traits equal");
});
test("TraitVal: different name is not equal", {
  t1 := EvalValue.TraitVal(
    String.from("Display"),
    ArrayList(String).new(),
    ArrayList(Option(EvalValue)).new()
  );
  t2 := EvalValue.TraitVal(
    String.from("Debug"),
    ArrayList(String).new(),
    ArrayList(Option(EvalValue)).new()
  );
  assert(!(t1 == t2), "different trait names not equal");
});
test("TraitVal: Some/None field equality", {
  fnames := ArrayList(String).new();
  fnames.push(String.from("x"));
  fnames.push(String.from("y"));
  fvals_a := ArrayList(Option(EvalValue)).new();
  fvals_a.push(Option(EvalValue).Some(.IntLit(String.from("1"))));
  fvals_a.push(Option(EvalValue).None);
  fvals_b := ArrayList(Option(EvalValue)).new();
  fvals_b.push(Option(EvalValue).Some(.IntLit(String.from("1"))));
  fvals_b.push(Option(EvalValue).None);
  fvals_c := ArrayList(Option(EvalValue)).new();
  fvals_c.push(Option(EvalValue).Some(.IntLit(String.from("99"))));
  fvals_c.push(Option(EvalValue).None);
  t_a := EvalValue.TraitVal(String.from("T"), fnames, fvals_a);
  t_b := EvalValue.TraitVal(String.from("T"), fnames, fvals_b);
  t_c := EvalValue.TraitVal(String.from("T"), fnames, fvals_c);
  assert(t_a == t_b, "matching Some/None fields are equal");
  assert(!(t_a == t_c), "different Some value not equal");
});
test("TraitVal: Some vs None mismatch not equal", {
  fnames := ArrayList(String).new();
  fnames.push(String.from("x"));
  fvals_some := ArrayList(Option(EvalValue)).new();
  fvals_some.push(Option(EvalValue).Some(.UnitVal));
  fvals_none := ArrayList(Option(EvalValue)).new();
  fvals_none.push(Option(EvalValue).None);
  t_some := EvalValue.TraitVal(String.from("T"), fnames, fvals_some);
  t_none := EvalValue.TraitVal(String.from("T"), fnames, fvals_none);
  assert(!(t_some == t_none), "Some vs None mismatch is not equal");
});
test("TraitVal: predicates", {
  v := EvalValue.TraitVal(
    String.from("Eq"),
    ArrayList(String).new(),
    ArrayList(Option(EvalValue)).new()
  );
  assert(is_trait_val(v), "is_trait_val true");
  assert(!(is_struct_val(v)), "is_struct_val false for TraitVal");
});
test("TraitVal: value_to_string", {
  fnames := ArrayList(String).new();
  fnames.push(String.from("to_string"));
  fvals := ArrayList(Option(EvalValue)).new();
  fvals.push(Option(EvalValue).Some(.BoolVal(true)));
  v := EvalValue.TraitVal(String.from("Display"), fnames, fvals);
  assert(value_to_string(v) == "Display(to_string: true)", "trait to string");
});
test("TraitVal: value_to_string with runtime (None) field", {
  fnames := ArrayList(String).new();
  fnames.push(String.from("f"));
  fvals := ArrayList(Option(EvalValue)).new();
  fvals.push(Option(EvalValue).None);
  v := EvalValue.TraitVal(String.from("T"), fnames, fvals);
  assert(value_to_string(v) == "T(f: <runtime>)", "trait None field = <runtime>");
});
// ---------------------------------------------------------------------------
// ComptimeListVal
// ---------------------------------------------------------------------------
test("ComptimeListVal: empty equality", {
  a := EvalValue.ComptimeListVal(ArrayList(EvalValue).new());
  b := EvalValue.ComptimeListVal(ArrayList(EvalValue).new());
  assert(a == b, "empty comptime lists equal");
});
test("ComptimeListVal: element-wise equality", {
  e1 := ArrayList(EvalValue).new();
  e1.push(.IntLit(String.from("1")));
  e2 := ArrayList(EvalValue).new();
  e2.push(.IntLit(String.from("1")));
  e3 := ArrayList(EvalValue).new();
  e3.push(.IntLit(String.from("2")));
  assert(EvalValue.ComptimeListVal(e1) == EvalValue.ComptimeListVal(e2), "equal lists");
  assert(!(EvalValue.ComptimeListVal(e1) == EvalValue.ComptimeListVal(e3)), "unequal lists");
});
test("ComptimeListVal: predicates", {
  v := EvalValue.ComptimeListVal(ArrayList(EvalValue).new());
  assert(is_comptime_list_val(v), "is_comptime_list_val true");
  assert(!(is_array_val(v)), "is_array_val false for ComptimeListVal");
});
test("ComptimeListVal: value_to_string", {
  elems := ArrayList(EvalValue).new();
  elems.push(.IntLit(String.from("3")));
  elems.push(.IntLit(String.from("4")));
  v := EvalValue.ComptimeListVal(elems);
  assert(value_to_string(v) == "comptime_list(3, 4)", "comptime_list string");
});
// ---------------------------------------------------------------------------
// ExprVal
// ---------------------------------------------------------------------------
test("ExprVal: structural equality", {
  e1 := EvalValue.ExprVal(make_err_expr());
  e2 := EvalValue.ExprVal(make_err_expr());
  // Phase 6f: structural Atom-token equality is now implemented.
  // Two calls to make_err_expr() produce identical Atom nodes, so they are equal.
  assert(e1 == e2, "ExprVal structural equality: identical atoms are equal");
  // Different atoms should not be equal.
  other := EvalValue.ExprVal(
    AstExpr.Atom(
      usize(0),
      Token(
        kind : TokenKind.Integer,
        value : String.from("42"),
        row : usize(0),
        column : usize(0),
        character : usize(0),
        module_path : String.from(""),
        input : String.from("")
      )
    )
  );
  assert(!(e1 == other), "ExprVal structural equality: different atoms are unequal");
});
test("ExprVal: predicates", {
  v := EvalValue.ExprVal(make_err_expr());
  assert(is_expr_val(v), "is_expr_val true");
  assert(!(is_tuple_val(v)), "is_tuple_val false for ExprVal");
  assert(!(is_array_val(v)), "is_array_val false for ExprVal");
  assert(!(is_comptime_list_val(v)), "is_comptime_list_val false for ExprVal");
});
test("ExprVal: value_to_string", {
  v := EvalValue.ExprVal(make_err_expr());
  assert(value_to_string(v) == "<expr>", "expr val string is <expr>");
});
// ---------------------------------------------------------------------------
// Predicate cross-checks: ensure each predicate is exclusive for different variants
// ---------------------------------------------------------------------------
test("predicates are exclusive across all variants", {
  unit_v := EvalValue.UnitVal;
  bool_v := EvalValue.BoolVal(true);
  int_v := EvalValue.IntLit(String.from("0"));
  float_v := EvalValue.FloatLit(String.from("0.0"));
  str_v := EvalValue.StrLit(String.from("hi"));
  varref_v := EvalValue.VarRef(String.from("x"));
  tuple_v := EvalValue.TupleVal(ArrayList(EvalValue).new());
  array_v := EvalValue.ArrayVal(ArrayList(EvalValue).new());
  ptr_v := EvalValue.PtrVal(_ptr_cell(EvalValue.UnitVal), usize(0));
  trait_v := EvalValue.TraitVal(String.from("T"), ArrayList(String).new(), ArrayList(Option(EvalValue)).new());
  cl_v := EvalValue.ComptimeListVal(ArrayList(EvalValue).new());
  expr_v := EvalValue.ExprVal(make_err_expr());
  assert(is_unit_val(unit_v), "unit → is_unit_val");
  assert(is_bool_val(bool_v), "bool → is_bool_val");
  assert(is_int_lit(int_v), "int → is_int_lit");
  assert(is_float_lit(float_v), "float → is_float_lit");
  assert(is_str_lit(str_v), "str → is_str_lit");
  assert(is_var_ref(varref_v), "varref → is_var_ref");
  assert(is_tuple_val(tuple_v), "tuple → is_tuple_val");
  assert(is_array_val(array_v), "array → is_array_val");
  assert(is_ptr_val(ptr_v), "ptr → is_ptr_val");
  assert(is_trait_val(trait_v), "trait → is_trait_val");
  assert(is_comptime_list_val(cl_v), "cl → is_comptime_list_val");
  assert(is_expr_val(expr_v), "expr → is_expr_val");
  // Spot-check: none of the phase-2h predicates fire for simple variants
  assert(!(is_tuple_val(unit_v)), "unit ≠ tuple");
  assert(!(is_array_val(bool_v)), "bool ≠ array");
  assert(!(is_ptr_val(str_v)), "str ≠ ptr");
  assert(!(is_trait_val(float_v)), "float ≠ trait");
  assert(!(is_expr_val(varref_v)), "varref ≠ expr");
});
