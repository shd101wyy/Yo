/// Tests for the structural type-key function (types/type_key.yo) — the
/// C-type-identity oracle. A wrong key silently merges distinct C types or
/// duplicates identical ones; the codegen corpus only catches that
/// indirectly, so pin the key's determinism and distinctness here.
{ String } :: import("std/string");
import("std/fmt");
{ TypeValue, TypeValueNode, FuncMeta, shared_list, no_types, no_labels, t_reference, t_reference_with_origin, t_origin_named, t_slot, t_slot_pointee, t_slot_is_mut_ref, t_slot_is_by_value } :: import("../../src/types/definitions.yo");
{ are_types_compatible_exact } :: import("../../src/types/compatibility.yo");
{ type_intern_key } :: import("../../src/types/intern.yo");
{ HashSet } :: import("std/collections/hash_set");
{
  t_func_simple,
  t_some_t,
  t_with_resolution,
  t_ptr,
  t_i32,
  t_bool,
  t_unit,
  t_usize
} :: import("../../src/types/creators.yo");
{ ArrayList } :: import("std/collections/array_list");
{ type_key } :: import("../../src/types/type_key.yo");
{ assert, panic } :: import("std/assert");
test("type_key: deterministic for the same type", {
  assert(type_key(t_i32()) == type_key(t_i32()), "i32 key stable");
  assert(type_key(t_bool()) == type_key(t_bool()), "bool key stable");
  assert(type_key(t_ptr(t_i32())) == type_key(t_ptr(t_i32())), "ptr(i32) key stable");
});
test("type_key: distinct scalar types get distinct keys", {
  assert(!(type_key(t_i32()) == type_key(t_bool())), "i32 vs bool");
  assert(!(type_key(t_i32()) == type_key(t_usize())), "i32 vs usize");
  assert(!(type_key(t_i32()) == type_key(t_unit())), "i32 vs unit");
});
test("type_key: pointer wrapping changes the key", {
  assert(!(type_key(t_ptr(t_i32())) == type_key(t_i32())), "ptr(i32) vs i32");
  assert(
    !(type_key(t_ptr(t_ptr(t_i32()))) == type_key(t_ptr(t_i32()))),
    "ptr(ptr(i32)) vs ptr(i32)"
  );
});
test("type_key: function types keyed by params and result", {
  p1 := ArrayList(String).new();
  p1.push(`a`);
  t1 := ArrayList(TypeValue).new();
  t1.push(t_i32());
  f_i32_to_bool := t_func_simple(p1.clone(), t1.clone(), t_bool());
  p2 := ArrayList(String).new();
  p2.push(`a`);
  t2 := ArrayList(TypeValue).new();
  t2.push(t_i32());
  f_i32_to_i32 := t_func_simple(p2.clone(), t2.clone(), t_i32());
  assert(
    type_key(&f_i32_to_bool) == type_key(&f_i32_to_bool),
    "fn key stable"
  );
  assert(
    !(type_key(&f_i32_to_bool) == type_key(&f_i32_to_i32)),
    "fn keys differ on result type"
  );
});
// Decision 43 step 1: a parameter's mode is its slot type, and a reference's
// origin is not part of any key (type_key, the memos, specialization keys).
test("type_key: a reference slot keys as its spelling, without its origin", {
  assert(type_key(t_reference(t_i32(), false)) == `&i32`, "&i32");
  assert(type_key(t_reference(t_i32(), true)) == `&mut i32`, "&mut i32");
  assert(!(type_key(t_reference(t_i32(), false)) == type_key(t_i32())), "&i32 vs i32");
  // `t_slot`: `&mut` wins, then by value (the bare type), else `&T`.
  assert(type_key(t_slot(t_i32(), true, true)) == `&mut i32`, "mut wins");
  assert(type_key(t_slot(t_i32(), false, true)) == type_key(t_i32()), "by value is the bare type");
  assert(type_key(t_slot(t_i32(), false, false)) == `&i32`, "no mode borrows");
  assert(type_key(t_slot_pointee(t_reference(t_i32(), true))) == type_key(t_i32()), "pointee of &mut i32");
  assert(type_key(t_slot_pointee(t_i32())) == type_key(t_i32()), "pointee of a by-value slot");
  assert(t_slot_is_mut_ref(t_reference(t_i32(), true)) && !t_slot_is_mut_ref(t_reference(t_i32(), false)), "mut flag");
  assert(t_slot_is_by_value(t_i32()) && !t_slot_is_by_value(t_reference(t_i32(), false)), "by-value flag");
  // Two references that differ ONLY in their origin share every key: a named
  // origin (`p`, not elided) keys exactly as the elided one. Step 1 builds no
  // such origin; this pins the rule before step 2 does.
  places := ArrayList(String).new();
  places.push(`p`);
  named := Rc.new(TypeValueNode.OriginSet(places : shared_list(places), is_elided : false));
  r_named := Rc.new(TypeValueNode.Reference(pointee : t_i32(), mutable : true, origin : named));
  assert(type_key(&r_named) == type_key(t_reference(t_i32(), true)), "the origin is not in the key");
  // A fn type prints each parameter's mode from its slot, the pointee after it.
  ps := ArrayList(String).new();
  ps.push(`a`);
  ts := ArrayList(TypeValue).new();
  ts.push(t_i32());
  assert(type_key(t_func_simple(ps.clone(), ts.clone(), t_bool())) == `fn(a : &i32) -> bool`, "fn(a : &i32) -> bool");
});
// `fn(v : <slot>) -> i32`, the slot as given.
_fn_one_slot :: (fn(slot : &TypeValue) -> TypeValue)({
  labels := ArrayList(String).new();
  labels.push(`v`);
  slots := ArrayList(TypeValue).new();
  slots.push(slot.clone());
  Rc.new(
    TypeValueNode.Func(
      no_types(),
      shared_list(slots),
      no_types(),
      no_types(),
      t_i32(),
      Rc.new(
        FuncMeta(
          forall_labels : no_labels(),
          param_labels : shared_list(labels),
          implicit_labels : no_labels(),
          result_is_comptime_only : false,
          result_is_ref : false,
          has_variadic : false,
          is_extern : Option(String).None,
          extern_name : Option(String).None,
          is_control : false,
          variadic_label : Option(String).None,
          variadic_comptime : false
        )
      ),
      no_types()
    )
  )
});
_named_origin :: (fn(name : str) -> TypeValue)({
  names := ArrayList(String).new();
  names.push(String.from(name));
  t_origin_named(&shared_list(names))
});
// Decision 43 step 2 (N1a): a parameter typed `&(T, p)` carries a spelled
// origin in its slot. The specialization cache (`_find_specialization_cache`)
// reuses a specialization when the runtime parameter types are
// `are_types_compatible_exact` and, for an instantiation, `type_key`-equal:
// two function types that differ only in a slot's origin pass both, so an
// origin never mints a specialization. The intern key keeps the origin, so
// the checker still tells the two nodes apart.
test("type_key: a slot's origin is erased from the specialization identity", {
  f_elided := _fn_one_slot(t_reference(t_i32(), false));
  f_p := _fn_one_slot(t_reference_with_origin(t_i32(), false, _named_origin("p")));
  f_q := _fn_one_slot(t_reference_with_origin(t_i32(), false, _named_origin("q")));
  assert(type_key(&f_p) == `fn(v : &i32) -> i32`, "a spelled origin prints as the elided form");
  assert(type_key(&f_p) == type_key(&f_elided), "named vs elided origin: one type_key");
  assert(type_key(&f_p) == type_key(&f_q), "two named origins: one type_key");
  assert(are_types_compatible_exact(&f_p, &f_elided) && are_types_compatible_exact(&f_elided, &f_p), "named vs elided origin: exact-compatible both ways");
  assert(are_types_compatible_exact(&f_p, &f_q), "two named origins: exact-compatible");
  // The mode is still part of the identity.
  f_mut := _fn_one_slot(t_reference_with_origin(t_i32(), true, _named_origin("p")));
  assert(!(type_key(&f_mut) == type_key(&f_p)), "&mut(i32, p) vs &(i32, p): distinct keys");
  assert(!are_types_compatible_exact(&f_mut, &f_p), "&mut(i32, p) vs &(i32, p): not exact-compatible");
  // Storage, not identity: the intern key renders the origin.
  mut(seen_p) := HashSet(String).new();
  mut(seen_e) := HashSet(String).new();
  assert(!(type_intern_key(&f_p, usize(0), &mut seen_p) == type_intern_key(&f_elided, usize(0), &mut seen_e)), "the intern key keeps the origin");
});
test("type_key: SomeT distinct from concrete", {
  st := t_some_t(`T`, usize(0));
  assert(!(type_key(&st) == type_key(t_i32())), "SomeT vs i32");
});
// A one-field capture struct, as create_capture_type_and_value builds it.
_capture_struct :: (fn(sid : &String, label : &String, field : &TypeValue) -> TypeValue)({
  labels := ArrayList(String).new();
  labels.push(label.clone());
  fields := ArrayList(TypeValue).new();
  fields.push(Rc.clone(field));
  Rc.new(TypeValueNode.Struct(sid.clone(), String.from(""), shared_list(labels), shared_list(fields), false, false, false, String.from(""), no_types(), false))
});
// A closure inside a generic function captures the function's `Impl(Fn...)`
// parameter: one SomeT lineage that each call site resolves to its own
// capture struct. Since Phase 3.7 a resolution is an immutable value
// (`t_with_resolution` builds a new node), so two resolutions are two nodes of
// one lineage. The capture struct's key must not follow them, or codegen
// looks it up under a key it was never registered with
// (issues/fixed/a-capture-struct-changes-type-key-when-a-captured-closure-param-is-re-resolved.md).
test("type_key: a capture struct's key survives a re-resolution of its captured closure", {
  wrapper := t_some_t(`Impl`, usize(0));
  first := _capture_struct(`capture_tk_first`, `n`, t_i32());
  second := _capture_struct(`capture_tk_second`, `b`, t_bool());
  as_first := t_with_resolution(&wrapper, &first);
  as_second := t_with_resolution(&wrapper, &second);
  outer_first := _capture_struct(`capture_tk_outer`, `cb`, &as_first);
  outer_second := _capture_struct(`capture_tk_outer`, `cb`, &as_second);
  // The bare identity is its resolution (the closure-container rule).
  assert(type_key(&as_first) == type_key(&first), "a resolved closure identity keys as its capture struct");
  assert(type_key(&as_second) == type_key(&second), "each resolution keys as its own capture struct");
  assert(type_key(&outer_first) == type_key(&outer_second), "the capture struct's key does not follow the resolution");
});
