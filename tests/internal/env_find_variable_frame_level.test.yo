/// Tests for `get_variables_from_frame` and
/// `find_variable_frame_level` in yo-self/env.yo.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../yo-self/token.yo");
{ EvalValue } :: import("../../yo-self/value.yo");
{ TypeValue } :: import("../../yo-self/types/definitions.yo");
{ t_i32 } :: import("../../yo-self/types/creators.yo");
{ assert, panic } :: import("std/assert");
{
  Environment,
  Frame,
  add_variable_to_env,
  get_variables_from_frame,
  find_variable_frame_level
} :: import("../../yo-self/env.yo");
placeholder_token :: (fn() -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(""),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
add_var :: (fn(env : Environment, name : str) -> unit)({
  _r := add_variable_to_env(
    env,
    String.from(name),
    t_i32(),
    Option(EvalValue).None,
    false,
    false,
    false,
    false,
    placeholder_token()
  );
});
test("get_variables_from_frame: empty frame → empty list", {
  env := Environment.new(String.from("test"));
  match(
    env.frames.get(usize(0)),
    .Some(f) => {
      out := get_variables_from_frame(f, String.from("missing"));
      assert(out.len() == usize(0), "no vars");
    },
    .None => assert(false, "expected outer frame")
  );
});
test("get_variables_from_frame: only matching-name vars are returned", {
  env := Environment.new(String.from("test"));
  add_var(env, "x");
  add_var(env, "y");
  add_var(env, "x");
  match(
    env.frames.get(usize(0)),
    .Some(f) => {
      out := get_variables_from_frame(f, String.from("x"));
      assert(out.len() == usize(2), "two x bindings");
    },
    .None => assert(false, "expected outer frame")
  );
});
test("find_variable_frame_level: missing variable → None", {
  env := Environment.new(String.from("test"));
  add_var(env, "x");
  assert(
    find_variable_frame_level(env, String.from("not_defined")).is_none(),
    "missing → None"
  );
});
test("find_variable_frame_level: outermost frame match", {
  env := Environment.new(String.from("test"));
  add_var(env, "x");
  match(
    find_variable_frame_level(env, String.from("x")),
    .Some(idx) => assert(idx == usize(0), "frame 0"),
    .None => assert(false, "expected Some")
  );
});
test("find_variable_frame_level: innermost frame wins when shadowed", {
  env := Environment.new(String.from("test"));
  add_var(env, "x"); // outer x at frame 0
  // Push a new frame and add another x in it.
  _idx := env.push_frame(true);
  add_var(env, "x"); // inner x at frame 1
  match(
    find_variable_frame_level(env, String.from("x")),
    .Some(idx) => assert(idx == usize(1), "innermost frame index"),
    .None => assert(false, "expected Some")
  );
});
