{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ assert, panic } :: import("std/assert");
{
  is_local_path,
  _url_to_dep_name,
  _is_all_digits,
  _parse_semver_tag,
  _compare_semver,
  _parse_tags_for_latest_semver,
  parse_version_req,
  version_req_matches,
  select_version,
  parse_package_specifier,
  dependency_value_text,
  ParsedPackage,
  SemVer,
  VersionReq
} :: import("../../src/install_command.yo");
{ DependencySource, GitRequirement } :: import("../../src/manifest.yo");
// ---------------------------------------------------------------------------
// is_local_path
// ---------------------------------------------------------------------------
test("is_local_path: dot is local", {
  assert(is_local_path(String.from(".")), "dot");
});
test("is_local_path: dotdot is local", {
  assert(is_local_path(String.from("..")), "dotdot");
});
test("is_local_path: ./foo is local", {
  assert(is_local_path(String.from("./foo")), "./foo");
});
test("is_local_path: ../bar is local", {
  assert(is_local_path(String.from("../bar")), "../bar");
});
test("is_local_path: /abs/path is local", {
  assert(is_local_path(String.from("/abs/path")), "abs");
});
test("is_local_path: user/repo is not local", {
  assert(!is_local_path(String.from("user/repo")), "user/repo");
});
test("is_local_path: https:// is not local", {
  assert(!is_local_path(String.from("https://github.com/user/repo")), "https");
});
// ---------------------------------------------------------------------------
// _url_to_dep_name
// ---------------------------------------------------------------------------
test("_url_to_dep_name: strips .git and last path segment", {
  assert(_url_to_dep_name(String.from("https://github.com/user/my-lib.git")) == "my-lib", "https .git");
});
test("_url_to_dep_name: no .git suffix", {
  assert(_url_to_dep_name(String.from("https://github.com/user/my-lib")) == "my-lib", "https");
});
test("_url_to_dep_name: ssh scp-like remote", {
  assert(_url_to_dep_name(String.from("git@github.com:user/my-lib.git")) == "my-lib", "ssh");
});
test("_url_to_dep_name: a trailing slash is ignored", {
  assert(_url_to_dep_name(String.from("./libs/mylib/")) == "mylib", "trailing slash");
});
test("_url_to_dep_name: plain name with no slash and no .git", {
  assert(_url_to_dep_name(String.from("plain")) == "plain", "plain");
});
// ---------------------------------------------------------------------------
// semver tags
// ---------------------------------------------------------------------------
test("_is_all_digits: digits, empty, letters", {
  assert(_is_all_digits(String.from("123")), "digits");
  assert(!_is_all_digits(String.from("")), "empty");
  assert(!_is_all_digits(String.from("12a")), "letter");
});
test("_parse_semver_tag: v1.2.3 parses correctly", {
  sv := _parse_semver_tag(String.from("v1.2.3")).unwrap();
  assert(sv.major == i32(1), "major");
  assert(sv.minor == i32(2), "minor");
  assert(sv.patch == i32(3), "patch");
  assert(sv.pre == "", "release");
  assert(sv.tag == "v1.2.3", "tag kept as written");
});
test("_parse_semver_tag: uppercase V and no prefix both parse", {
  assert(_parse_semver_tag(String.from("V2.0.1")).unwrap().major == i32(2), "V");
  assert(_parse_semver_tag(String.from("0.0.6")).unwrap().patch == i32(6), "bare");
});
test("_parse_semver_tag: pre-release and build metadata", {
  rc := _parse_semver_tag(String.from("v1.0.0-rc.1")).unwrap();
  assert(rc.pre == "rc.1", "pre-release identifiers");
  built := _parse_semver_tag(String.from("v1.0.0+build.5")).unwrap();
  assert(built.pre == "", "build metadata is not a pre-release");
  both := _parse_semver_tag(String.from("v1.0.0-beta+exp")).unwrap();
  assert(both.pre == "beta", "pre before build");
});
test("_parse_semver_tag: rejects non-versions", {
  assert(_parse_semver_tag(String.from("")).is_none(), "empty");
  assert(_parse_semver_tag(String.from("v1.2")).is_none(), "two parts");
  assert(_parse_semver_tag(String.from("v1.x.3")).is_none(), "letter");
  assert(_parse_semver_tag(String.from("v1.0.0-")).is_none(), "dangling dash");
  assert(_parse_semver_tag(String.from("v1.0.0-rc..1")).is_none(), "empty identifier");
  assert(_parse_semver_tag(String.from("latest")).is_none(), "word");
});
_sv :: (fn(t : str) -> SemVer)(_parse_semver_tag(String.from(t)).unwrap());
test("_compare_semver: numeric ordering", {
  assert(_compare_semver(_sv("v1.0.0"), _sv("v1.0.0")) == i32(0), "equal");
  assert(_compare_semver(_sv("v2.0.0"), _sv("v1.9.9")) > i32(0), "major");
  assert(_compare_semver(_sv("v1.2.0"), _sv("v1.1.9")) > i32(0), "minor");
  assert(_compare_semver(_sv("v1.1.2"), _sv("v1.1.1")) > i32(0), "patch");
  assert(_compare_semver(_sv("v1.1.1"), _sv("v1.1.2")) < i32(0), "less");
});
test("_compare_semver: pre-release ordering (semver §11)", {
  assert(_compare_semver(_sv("v1.0.0"), _sv("v1.0.0-rc.1")) > i32(0), "release beats pre-release");
  assert(_compare_semver(_sv("v1.0.0-alpha"), _sv("v1.0.0-alpha.1")) < i32(0), "shorter is smaller");
  assert(_compare_semver(_sv("v1.0.0-alpha.1"), _sv("v1.0.0-alpha.beta")) < i32(0), "numeric < alphanumeric");
  assert(_compare_semver(_sv("v1.0.0-beta.11"), _sv("v1.0.0-beta.2")) > i32(0), "numeric identifiers compare by value");
  assert(_compare_semver(_sv("v1.0.0-rc.1"), _sv("v1.0.0-beta.11")) > i32(0), "lexical");
});
_LS_REMOTE :: "abc\trefs/heads/main\nabd\trefs/tags/v0.1.0\nabe\trefs/tags/v0.2.0\nabf\trefs/tags/v0.2.0^{}\nac0\trefs/tags/v1.0.0-rc.1\nac1\trefs/tags/v0.10.0\nac2\trefs/tags/not-a-version\nac3\trefs/tags/v1.0.0\nac4\trefs/tags/v1.1.0\nac5\trefs/tags/v2.0.0-beta.1\n";
test("_parse_tags_for_latest_semver: picks the highest RELEASE tag", {
  assert(_parse_tags_for_latest_semver(String.from(_LS_REMOTE)).unwrap() == "v1.1.0", "v2.0.0-beta.1 is a pre-release and never the default");
});
test("_parse_tags_for_latest_semver: no tags is .None", {
  assert(_parse_tags_for_latest_semver(String.from("")).is_none(), "empty");
  assert(_parse_tags_for_latest_semver(String.from("abc\trefs/heads/main\n")).is_none(), "branches only");
});
// ---------------------------------------------------------------------------
// version requirements
// ---------------------------------------------------------------------------
_req :: (fn(t : str) -> VersionReq)(
  match(
    parse_version_req(String.from(t)),
    .Ok(r) => r,
    .Err(msg) => {
      panic(`"${t}" should parse: ${msg}`);
      parse_version_req(String.from("*")).unwrap()
    }
  )
);
_matches :: (fn(req : str, v : str) -> bool)(version_req_matches(_req(req), _sv(v)));
test("parse_version_req: rejects garbage and empty", {
  assert(parse_version_req(String.from("")).is_err(), "empty");
  assert(parse_version_req(String.from("latest")).is_err(), "word");
  assert(parse_version_req(String.from("1.2.3.4")).is_err(), "four parts");
  assert(parse_version_req(String.from("^1.*")).is_err(), "wildcard after operator");
  assert(parse_version_req(String.from("1.*.3")).is_err(), "wildcard not last");
  assert(parse_version_req(String.from(">=1,, <2")).is_err(), "empty comparator");
});
test("version_req_matches: caret", {
  assert(_matches("^1.2.3", "v1.2.3"), "lower bound");
  assert(_matches("^1.2.3", "v1.9.0"), "compatible");
  assert(!_matches("^1.2.3", "v2.0.0"), "next major");
  assert(!_matches("^1.2.3", "v1.2.2"), "below");
  assert(_matches("^0.2.3", "v0.2.9"), "0.x: minor is the compatibility line");
  assert(!_matches("^0.2.3", "v0.3.0"), "0.x next minor");
  assert(_matches("^0.0.3", "v0.0.3"), "0.0.x exact");
  assert(!_matches("^0.0.3", "v0.0.4"), "0.0.x next patch");
  assert(_matches("^0.0", "v0.0.9"), "^0.0 → <0.1.0");
  assert(!_matches("^0.0", "v0.1.0"), "^0.0 upper");
  assert(_matches("^0", "v0.9.9"), "^0 → <1.0.0");
  assert(_matches("^1", "v1.9.9"), "^1 → <2.0.0");
  assert(_matches("^1.2", "v1.2.0"), "^1.2 lower");
  assert(!_matches("^1.2", "v1.1.9"), "^1.2 below");
});
test("version_req_matches: a bare version means caret", {
  assert(_matches("1.2.3", "v1.5.0"), "bare");
  assert(!_matches("1.2.3", "v2.0.0"), "bare upper");
  assert(_matches("v1.2.3", "v1.5.0"), "leading v tolerated");
});
test("version_req_matches: tilde", {
  assert(_matches("~1.2.3", "v1.2.9"), "patch moves");
  assert(!_matches("~1.2.3", "v1.3.0"), "minor does not");
  assert(_matches("~1.2", "v1.2.0"), "~1.2 lower");
  assert(!_matches("~1.2", "v1.3.0"), "~1.2 upper");
  assert(_matches("~1", "v1.9.0"), "~1 → <2.0.0");
  assert(!_matches("~1", "v2.0.0"), "~1 upper");
});
test("version_req_matches: exact", {
  assert(_matches("=1.2.3", "v1.2.3"), "exact");
  assert(!_matches("=1.2.3", "v1.2.4"), "exact other");
  assert(_matches("=1.2", "v1.2.7"), "=1.2 is 1.2.x");
  assert(!_matches("=1.2", "v1.3.0"), "=1.2 upper");
  assert(_matches("=1", "v1.7.0"), "=1 is 1.x");
});
test("version_req_matches: comparison operators and partials", {
  assert(_matches(">=1.2.3", "v1.2.3"), ">= inclusive");
  assert(!_matches(">1.2.3", "v1.2.3"), "> exclusive");
  assert(_matches(">1.2.3", "v1.2.4"), "> next");
  assert(_matches(">1.2", "v1.3.0"), ">1.2 means >=1.3.0");
  assert(!_matches(">1.2", "v1.2.9"), ">1.2 excludes 1.2.x");
  assert(_matches("<2", "v1.9.9"), "<2");
  assert(!_matches("<2", "v2.0.0"), "<2 upper");
  assert(_matches("<=1.2", "v1.2.9"), "<=1.2 includes 1.2.x");
  assert(!_matches("<=1.2", "v1.3.0"), "<=1.2 excludes 1.3.0");
  assert(_matches(">=1, <2", "v1.5.0"), "conjunction");
  assert(!_matches(">=1, <2", "v2.0.0"), "conjunction upper");
  assert(!_matches(">=1, <2", "v0.9.0"), "conjunction lower");
});
test("version_req_matches: wildcards", {
  assert(_matches("*", "v0.0.1"), "* any");
  assert(_matches("*", "v9.9.9"), "* any high");
  assert(_matches("1.*", "v1.9.9"), "1.*");
  assert(!_matches("1.*", "v2.0.0"), "1.* upper");
  assert(_matches("1.2.*", "v1.2.9"), "1.2.*");
  assert(!_matches("1.2.*", "v1.3.0"), "1.2.* upper");
  assert(_matches("1.x", "v1.4.0"), "x spelling");
});
test("version_req_matches: pre-releases only when the range names one at the same version", {
  assert(!_matches("^1.0.0", "v1.0.0-rc.1"), "pre-release below the release is excluded");
  assert(!_matches("^1.0.0", "v1.5.0-beta.1"), "pre-release inside the range is excluded");
  assert(!_matches("*", "v2.0.0-beta.1"), "wildcard excludes pre-releases");
  assert(_matches("^1.0.0-rc.1", "v1.0.0-rc.1"), "named pre-release matches");
  assert(_matches("^1.0.0-rc.1", "v1.0.0-rc.2"), "later pre-release of the same version");
  assert(_matches("^1.0.0-rc.1", "v1.0.0"), "the release matches too");
  assert(!_matches("^1.0.0-rc.1", "v1.1.0-beta.1"), "pre-release of another version is excluded");
  assert(!_matches("^1.0.0-rc.5", "v1.0.0-rc.1"), "earlier pre-release is below the bound");
});
test("select_version: highest satisfying tag from ls-remote output", {
  assert(select_version(String.from(_LS_REMOTE), _req("^0.2")).unwrap().tag == "v0.2.0", "^0.2 is <0.3.0 → v0.2.0");
  assert(select_version(String.from(_LS_REMOTE), _req("^0.2.0")).unwrap().tag == "v0.2.0", "^0.2.0 → v0.2.0");
  assert(select_version(String.from(_LS_REMOTE), _req(">=0.2")).unwrap().tag == "v1.1.0", ">=0.2 → highest release");
  assert(select_version(String.from(_LS_REMOTE), _req("^2.0.0-beta.1")).unwrap().tag == "v2.0.0-beta.1", "named pre-release");
  assert(select_version(String.from(_LS_REMOTE), _req("^3")).is_none(), "nothing satisfies");
});
// ---------------------------------------------------------------------------
// parse_package_specifier
// ---------------------------------------------------------------------------
_git :: (fn(spec : str) -> ParsedPackage)(
  match(
    parse_package_specifier(String.from(spec)),
    .Ok(p) => p,
    .Err(msg) => {
      panic(`"${spec}" should parse: ${msg}`);
      ParsedPackage.Path(String.new(), String.new())
    }
  )
);
test("parse_package_specifier: user/repo shorthand", {
  match(
    _git("user/repo"),
    .Git(name, url, req) => {
      assert(name == "repo", "name");
      assert(url == "https://github.com/user/repo", "url");
      assert(req.is_none(), "no requirement → latest");
    },
    .Path(_, _) => panic("expected git")
  );
});
test("parse_package_specifier: user/repo@v1.2.3 is an exact tag", {
  match(
    _git("user/repo@v1.2.3"),
    .Git(_, url, req) => {
      assert(url == "https://github.com/user/repo", "url without the suffix");
      match(req.unwrap(), .Tag(t) => assert(t == "v1.2.3", "tag"), _ => panic("expected a tag"));
    },
    .Path(_, _) => panic("expected git")
  );
});
test("parse_package_specifier: user/repo@^1.2 is a version requirement", {
  match(
    _git("user/repo@^1.2"),
    .Git(_, _, req) => match(req.unwrap(), .Version(v) => assert(v == "^1.2", "range"), _ => panic("expected a version")),
    .Path(_, _) => panic("expected git")
  );
  match(
    _git("user/repo@1.2.3"),
    .Git(_, _, req) => match(req.unwrap(), .Version(v) => assert(v == "1.2.3", "bare version is a range"), _ => panic("expected a version")),
    .Path(_, _) => panic("expected git")
  );
});
test("parse_package_specifier: full https URL, github.com/ form, ssh remotes", {
  match(
    _git("https://gitlab.com/group/thing.git"),
    .Git(name, url, _) => {
      assert(name == "thing", "name strips .git");
      assert(url == "https://gitlab.com/group/thing.git", "url as written");
    },
    .Path(_, _) => panic("expected git")
  );
  match(
    _git("github.com/user/repo"),
    .Git(_, url, _) => assert(url == "https://github.com/user/repo", "github.com/ prefix"),
    .Path(_, _) => panic("expected git")
  );
  match(
    _git("git@github.com:user/repo.git"),
    .Git(name, url, req) => {
      assert(name == "repo", "ssh name");
      assert(url == "git@github.com:user/repo.git", "the @ in the remote is not a version");
      assert(req.is_none(), "no requirement");
    },
    .Path(_, _) => panic("expected git")
  );
  match(
    _git("git@github.com:user/repo.git@~2"),
    .Git(_, url, req) => {
      assert(url == "git@github.com:user/repo.git", "remote kept");
      match(req.unwrap(), .Version(v) => assert(v == "~2", "suffix"), _ => panic("expected a version"));
    },
    .Path(_, _) => panic("expected git")
  );
});
test("parse_package_specifier: local path", {
  match(
    _git("./libs/mylib"),
    .Path(name, rel) => {
      assert(name == "mylib", "name");
      assert(rel == "./libs/mylib", "path as written");
    },
    .Git(_, _, _) => panic("expected path")
  );
});
test("parse_package_specifier: invalid specifiers are errors", {
  assert(parse_package_specifier(String.from("not-a-spec")).is_err(), "single word");
  assert(parse_package_specifier(String.from("a/b/c")).is_err(), "three parts");
  assert(parse_package_specifier(String.from("user/repo@latest")).is_err(), "@latest is neither a tag nor a range");
});
// ---------------------------------------------------------------------------
// dependency_value_text
// ---------------------------------------------------------------------------
test("dependency_value_text: every source shape", {
  assert(dependency_value_text(DependencySource.Path(String.from("../mylib"))) == "{ path = \"../mylib\" }", "path");
  assert(
    dependency_value_text(DependencySource.Git(String.from("https://x/y"), GitRequirement.Version(String.from("^1.2")), String.new())) == "{ git = \"https://x/y\", version = \"^1.2\" }",
    "git version"
  );
  assert(
    dependency_value_text(DependencySource.Git(String.from("https://x/y"), GitRequirement.Tag(String.from("v1.0.0")), String.from("packages/y"))) == "{ git = \"https://x/y\", tag = \"v1.0.0\", path = \"packages/y\" }",
    "git tag with subdir"
  );
  assert(
    dependency_value_text(DependencySource.Git(String.from("https://x/y"), GitRequirement.DefaultBranch, String.new())) == "{ git = \"https://x/y\" }",
    "default branch"
  );
  assert(
    dependency_value_text(DependencySource.Git(String.from("https://x/y"), GitRequirement.Branch(String.from("main")), String.new())) == "{ git = \"https://x/y\", branch = \"main\" }",
    "branch"
  );
  assert(
    dependency_value_text(DependencySource.Git(String.from("https://x/y"), GitRequirement.Rev(String.from("abc123")), String.new())) == "{ git = \"https://x/y\", rev = \"abc123\" }",
    "rev"
  );
});
