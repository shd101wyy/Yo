//! The `refine(T, p)` refinement-type tests — V6 task 3
//! (plans/backlog/FORMAL_VERIFICATION.md §7): distinct at the type level,
//! erased to `T` at runtime, with the verifier discharging the predicate
//! modularly — ASSUMED at a refined parameter's callee entry, PROVED as
//! `refine#N` at a call site.
//!
//! Gates:
//!  - The HERMETIC layer (variant erasure through the guards/tags/size/
//!    compat/toString chokepoints) needs no solver and always runs.
//!  - The proof layer (the plan's safe_div example end-to-end) needs real
//!    Z3: gated on YO_TEST_Z3=1, exactly like the other verifier tests.
{ String, StringBuilder } :: import("std/string");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");
{ env } :: import("std/env");
{
  mm_load_file,
  mm_preload_prelude,
  mm_resolve_entry_abs,
  resolve_std_path,
  _take_load_error
} :: import("../../src/module_manager.yo");
{ clear_module_cache } :: import("../../src/evaluator/module_loader.yo");
{
  set_verify_mode_override,
  set_verify_target_paths,
  take_verify_tasks
} :: import("../../src/evaluator/builtins/contracts.yo");
{
  default_verify_run_config,
  resolve_solver_sync,
  verify_and_strip_tasks,
  VerifyFnReport
} :: import("../../src/verifier/driver.yo");

_have_z3 :: (fn() -> bool)(
  match(
    env.get(String.from("YO_TEST_Z3")),
    .Some(v) => (v == String.from("1")),
    .None => false
  )
);
_load_reports :: (
  fn(rel_path : String, io : Io, expect_ok : bool) -> ArrayList(VerifyFnReport)
)({
  exn := Exception(
    throw : (
      err -> {
        assert(false, `verifier_refine: unexpected throw: ${err}`);
      }
    )
  );
  std_path := resolve_std_path();
  targets := ArrayList(String).new();
  targets.push(rel_path.clone());
  targets.push(mm_resolve_entry_abs(rel_path.clone(), std_path.clone()));
  _ := take_verify_tasks();
  set_verify_mode_override(Option(String).None);
  set_verify_target_paths(targets);
  clear_module_cache();
  mm_preload_prelude(std_path.clone(), true, io, exn);
  outcome := mm_load_file(rel_path.clone(), std_path.clone(), true, io, exn);
  match(
    _take_load_error(),
    .Some(rendered) => {
      assert(
        outcome.ok == expect_ok,
        `fixture ${rel_path} load ok=${outcome.ok.to_string()} (expected ${expect_ok.to_string()}): ${rendered}`
      );
    },
    .None => {
      assert(outcome.ok == expect_ok, `fixture ${rel_path} load ok=${outcome.ok.to_string()}`);
    }
  );
  cfg := default_verify_run_config();
  binary := match(
    resolve_solver_sync(cfg),
    .Resolved(p) => p,
    _ => String.new()
  );
  verify_and_strip_tasks(cfg, binary, take_verify_tasks())
});
_reports_dump :: (fn(reports : ArrayList(VerifyFnReport)) -> String)({
  ids := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => {
        ids.push(`${rp.fn_id}=${rp.outcome} [${rp.subset_construct}]`);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  sb := StringBuilder.new();
  (j : usize) = usize(0);
  while(j < ids.len(), {
    if(j > usize(0), {
      sb.write_string(String.from(", "));
    });
    sb.write_string(ids.get(j).unwrap().clone());
    j = (j + usize(1));
  });
  sb.to_string()
});
_count_outcome :: (fn(reports : ArrayList(VerifyFnReport), outcome : String) -> usize)({
  (n : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => {
        if(rp.outcome == outcome, {
          n = (n + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  n
});

// ---------------------------------------------------------------------------
// Hermetic layer — runtime-mode erasure (no solver): a refine() annotation
// in a file WITHOUT a verify pragma loads, runs and registers NOTHING —
// the annotation evaluates to the plain type and the runtime is unchanged.
// ---------------------------------------------------------------------------
test("refine() in runtime mode: the module evaluates unchanged and registers no verify tasks", {
  reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/refine_nonzero_runtime.yo"),
    io,
    true
  );
  assert(
    reports.len() == usize(0),
    `runtime mode must register no verify tasks, got ${reports.len().to_string()}`
  );
});

// ---------------------------------------------------------------------------
// Proof layer — the plan's worked example end-to-end (real Z3).
// ---------------------------------------------------------------------------
test("safe_div over refine(i32, non_zero) proves with no manual requires; a discharging caller proves", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/refine_nonzero.yo"),
    io,
    true
  );
  // The callee's divisor-nonzero obligation must PROVE from the assumed
  // refinement alone — that is the flagship claim. THREE fns report (the
  // ghost_fn's inner fn walks the trivial AoRTE sweep too) and ALL of
  // them must be ok — a subset error on caller_ok would otherwise pass
  // the ok-count vacuously.
  assert(
    reports.len() == usize(3),
    `all three functions report, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("ok")) == usize(3),
    `safe_div (entry-assumed denom != 0), caller_ok (refine#1 discharged) and the predicate fn must all verify, got: [${_reports_dump(reports)}]`
  );
});

test("a caller passing an unconstrained value REFUTES at refine#N (the callee stays ok)", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/negative/refine_nonzero_false.yo"),
    io,
    true
  );
  assert(
    reports.len() == usize(3),
    `all three functions report, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("refuted")) == usize(1),
    `caller_bad must refute at refine#1, got: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("ok")) == usize(2),
    `safe_div itself must stay ok (modular: one bad caller does not poison the callee), got: [${_reports_dump(reports)}]`
  );
  // The counter-example names the argument: d = 0.
  (names_d : bool) = false;
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => {
        (j : usize) = usize(0);
        while(j < rp.obligations.len(), {
          match(
            rp.obligations.get(j),
            .Some(obl) => {
              match(
                obl.verdict,
                .Refuted(ce) => {
                  if(obl.name.contains(String.from("refine#")), {
                    (k : usize) = usize(0);
                    while(k < ce.len(), {
                      match(
                        ce.get(k),
                        .Some(pair) => {
                          if(pair.contains(String.from("d = ")), {
                            names_d = true;
                          });
                        },
                        .None => ()
                      );
                      k = (k + usize(1));
                    });
                  });
                },
                _ => ()
              );
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  assert(names_d, "the refine#1 counter-example must name the argument d");
});

// ---------------------------------------------------------------------------
// V6 task 6: the WORKED EXAMPLE, re-based off the deleted builtin
// Slice(T) onto Array(T, N) — a refinement-typed index makes an array
// read provably in bounds with no manual `requires`.
// ---------------------------------------------------------------------------
test("worked example: a refinement-typed index proves an array read in bounds", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/worked_example_array_index.yo"),
    io,
    true
  );
  (ok_n : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < reports.len(), {
    match(
      reports.get(i),
      .Some(rp) => {
        if(rp.outcome == "ok", {
          ok_n = (ok_n + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  assert(
    (reports.len() == usize(3)) && (ok_n == usize(3)),
    `first_of_8 (entry-assumed index in [0,8) discharges the AoRTE bound) and pick (refine#1 discharged from its requires) must verify alongside the predicate fn, got ${reports.len().to_string()} report(s), ${ok_n.to_string()} ok: [${_reports_dump(reports)}]`
  );
});

test("worked example twin: an under-constrained index refutes at refine#1", {
  if(!_have_z3(), {
    return(());
  });
  reports := _load_reports(
    String.from("./tests/spec/fixtures/negative/worked_example_array_index_false.yo"),
    io,
    true
  );
  assert(
    _count_outcome(reports, String.from("refuted")) == usize(1),
    `bad_pick must refute at refine#1, got: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("ok")) == usize(2),
    `the callee and predicate fn stay ok (modular), got: [${_reports_dump(reports)}]`
  );
});
