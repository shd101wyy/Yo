test("a recursive ghost_fn is an axiomatized function: a loop invariant over it proves, a non-decreasing one refutes", {
  if(!_have_z3(), {
    return(());
  });
  ok_reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/ghost_fn_recursive.yo"),
    io,
    true
  );
  assert(
    _count_outcome(ok_reports, String.from("ok")) == usize(2),
    `all_pos and check_all must verify, got: [${_reports_dump(ok_reports)}]`
  );
  bad_reports := _load_reports(
    String.from("./tests/spec/fixtures/negative/ghost_fn_recursive_false.yo"),
    io,
    true
  );
  // all_pos itself verifies; check_wrong never clears its flag (unproven:
  // the claim needs a counterexample through the quantified definition);
  // spin's measure does not decrease (refuted).
  assert(
    _count_outcome(bad_reports, String.from("ok")) == usize(1),
    `only all_pos may verify, got: [${_reports_dump(bad_reports)}]`
  );
  assert(
    _count_outcome(bad_reports, String.from("refuted")) == usize(1),
    `spin must refute at decreases-step, got: [${_reports_dump(bad_reports)}]`
  );
});

test("a lemma (unit ghost_fn with ensures) is proved by induction and used through ghost(...): a false lemma and a misuse fail", {
  if(!_have_z3(), {
    return(());
  });
  ok_reports := _load_reports(
    String.from("./tests/spec/fixtures/valid/lemma_member_frame.yo"),
    io,
    true
  );
  // member, the lemma member_frame (its induction), and copy_keeps_member
  // (push's element contract carries the loop; the lemma call carries the
  // ensures).
  assert(
    _count_outcome(ok_reports, String.from("ok")) == usize(3),
    `member, member_frame and copy_keeps_member must verify, got: [${_reports_dump(ok_reports)}]`
  );
  bad_reports := _load_reports(
    String.from("./tests/spec/fixtures/negative/lemma_member_frame_false.yo"),
    io,
    true
  );
  // member and the true member_frame verify; the false lemma does not;
  // misuse's call cannot prove the lemma's prefix requires.
  assert(
    _count_outcome(bad_reports, String.from("ok")) == usize(2),
    `only member and member_frame may verify, got: [${_reports_dump(bad_reports)}]`
  );
  assert(
    _count_outcome(bad_reports, String.from("refuted")) == usize(1),
    `misuse must refute at the lemma's requires, got: [${_reports_dump(bad_reports)}]`
  );
});

