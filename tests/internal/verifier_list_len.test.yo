    reports.len() == usize(2),
    `grow and shrink report, got ${reports.len().to_string()}: [${_reports_dump(reports)}]`
  );
  assert(
    _count_outcome(reports, String.from("subset-error")) == usize(2),
    `grow and shrink must be subset errors naming old(xs), got: [${_reports_dump(reports)}]`
  );
});

