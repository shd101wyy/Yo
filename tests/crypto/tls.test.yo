//! TLS client stream (`std/crypto/tls`, plans/D6_TLS_PLAN.md). The live
//! handshake test needs a TLS backend at build time (OpenSSL on unix,
//! Schannel on Windows) AND network egress at run time. On a developer box
//! with no egress it SKIPS, printing a note; **under CI it is mandatory** —
//! a failure that merely printed a note used to pass with no assertion at
//! all, which is how a broken backend stays green
//! (issues/fixed/live-tls-tests-pass-vacuously-when-the-handshake-fails.md).
//! The error-enum and availability tests are pure.
pragma(Pragma.SkipWasm32Emscripten); // no network stack in WASM
pragma(Pragma.SkipWasm32Wasi); // no network stack in WASM
{ assert, panic } :: import("std/assert");
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ TlsStream, TlsError, tls_available } :: import("std/crypto/tls");
{ Exception, IoExn } :: import("std/error");
{ arch, Arch } :: import("std/process");
{ env } :: import("std/env");
/// True where a TLS failure is a REAL failure rather than "this box has no
/// egress": GitHub Actions and essentially every other CI sets `CI`.
///
/// A capture-free `->` handler may not read a runtime local, but it CAN call
/// a module-level binding (#396), which is why this is a module-level fn.
_network_required :: (fn() -> bool)(env.get("CI").is_some());

test("TlsError renders each variant", {
  a := TlsError.Connect(host : `example.com`.to_string());
  assert(a.to_string().contains(`example.com`), "connect names the host");
  b := TlsError.Handshake(detail : `bad cert`.to_string());
  assert(b.to_string().contains(`handshake`), "handshake label");
  c := TlsError.Io(detail : `reset`.to_string());
  assert(c.to_string().contains(`i/o`), "io label");
  d := TlsError.Closed;
  assert(d.to_string().contains(`closed`), "closed label");
});
test("a TLS backend is present wherever one can be", {
  // Network-free and deterministic — this is the assertion that catches "the
  // backend was never wired up". Schannel ships with Windows and the unix CI
  // legs link OpenSSL, so under CI a `false` here is unambiguously a build or
  // wiring regression. On a developer box without OpenSSL it is legitimately
  // false, so the claim is only made where it holds.
  cond(
    _network_required() => assert(tls_available(), "CI builds must have a working TLS backend"),
    true => assert(true, "not CI: no TLS backend is promised on this box")
  );
});
test("live TLS fetch of example.com (mandatory under CI)", {
  // A box with no egress SKIPS; under CI a failure is a FAILURE. The old
  // handler unwound out of the test body on EVERY error, so the trailing
  // `cond` was dead code and a broken backend passed with no assertion at
  // all (issues/fixed/live-tls-tests-pass-vacuously-when-the-handshake-fails.md).
  reached := Box(bool)(false);
  ok := Box(bool)(false);
  exn := Exception(
    throw : (
      err -> {
        detail := err.to_string();
        cond(
          _network_required() => {
            // eprintln, not a buffered println: the panic below aborts the
            // test child and a buffered line would be lost with it.
            eprintln(`  TLS FAILED where the network is required: ${detail}`);
            panic(`live TLS handshake failed under CI — see the message above`);
          },
          true => {
            eprintln(`  tls test skipped (no egress?): ${detail}`);
            unwind(());
          }
        );
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  s := io.await(TlsStream.connect(`example.com`.to_string(), u16(443), io), e);
  reached.* = true;
  _n := io.await(s.write_str("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n", io), e);
  buf := ArrayList(u8).with_capacity(usize(4096));
  buf.resize_with_byte(usize(4096), int(0));
  n := io.await(s.read(buf.ptr().unwrap(), usize(4096), io), e);
  cond(
    (n >= usize(12)) => {
      head := String.from_bytes(buf.slice_copy(usize(0) .. usize(12)));
      ok.* = head.starts_with(`HTTP/1.1`);
    },
    true => ()
  );
  io.await(s.close(io), e);
  // If we reached the response, it MUST be well-formed; if the handler
  // unwound (offline), reached stays false and the test passes as skipped.
  cond(
    reached.* => assert(ok.*, "a real HTTP response arrived over TLS"),
    true => assert(true, "skipped: no network")
  );
});
