{ assert } :: import("std/assert");
open(import("std/string"));
{ Sha256, sha256, sha256_hex } :: import("std/crypto/sha256");
{ ArrayList } :: import("std/collections/array_list");
{ hex_encode } :: import("std/encoding/hex");
// Helper: build an ArrayList(u8) from a str
_bytes_from_str :: (fn(s : str) -> ArrayList(u8))(
  String.from(s).as_bytes()
);
// ===== sha256_hex convenience function tests =====
test("sha256_hex empty input", {
  data := ArrayList(u8).new();
  result := sha256_hex(data);
  assert(
    result == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "SHA-256 of empty input should match known vector"
  );
});
test("sha256_hex abc", {
  data := _bytes_from_str("abc");
  result := sha256_hex(data);
  assert(
    result == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    "SHA-256 of 'abc' should match known vector"
  );
});
test("sha256_hex hello world", {
  data := _bytes_from_str("hello world");
  result := sha256_hex(data);
  assert(
    result == "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9",
    "SHA-256 of 'hello world' should match known vector"
  );
});
test("sha256_hex The quick brown fox", {
  data := _bytes_from_str("The quick brown fox jumps over the lazy dog");
  result := sha256_hex(data);
  assert(
    result == "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592",
    "SHA-256 of 'The quick brown fox...' should match known vector"
  );
});
// ===== sha256 raw digest tests =====
test("sha256 returns 32 bytes", {
  data := _bytes_from_str("test");
  digest := sha256(data);
  // SHA-256("test") = 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
  assert(digest(usize(0)) == u8(0x9f), "first byte should be 0x9f");
  assert(digest(usize(31)) == u8(0x08), "last byte should be 0x08");
});
// ===== Sha256 streaming API tests =====
test("Sha256 streaming matches one-shot", {
  data := _bytes_from_str("hello world");
  one_shot := sha256_hex(data);
  // Stream in two chunks
  chunk1 := _bytes_from_str("hello ");
  chunk2 := _bytes_from_str("world");
  h := Sha256.new();
  h = h.update(chunk1);
  h = h.update(chunk2);
  digest := h.finish();
  // Convert to hex manually and compare
  bytes := ArrayList(u8).with_capacity(usize(32));
  i := usize(0);
  while(i < usize(32), i = (i + usize(1)), {
    bytes.push(digest(i));
  });
  streamed := hex_encode(bytes);
  assert(
    streamed == one_shot,
    "streaming result should match one-shot"
  );
});
test("Sha256 streaming single byte at a time", {
  data := _bytes_from_str("abc");
  one_shot := sha256_hex(data);
  h := Sha256.new();
  // Feed one byte at a time
  b1 := ArrayList(u8).new();
  b1.push(u8(97)); // 'a'
  b2 := ArrayList(u8).new();
  b2.push(u8(98)); // 'b'
  b3 := ArrayList(u8).new();
  b3.push(u8(99)); // 'c'
  h = h.update(b1);
  h = h.update(b2);
  h = h.update(b3);
  digest := h.finish();
  bytes := ArrayList(u8).with_capacity(usize(32));
  j := usize(0);
  while(j < usize(32), j = (j + usize(1)), {
    bytes.push(digest(j));
  });
  streamed := hex_encode(bytes);
  assert(
    streamed == one_shot,
    "byte-by-byte streaming should match one-shot"
  );
});
test("Sha256 streaming empty update", {
  empty := ArrayList(u8).new();
  data := _bytes_from_str("test");
  h := Sha256.new();
  h = h.update(empty);
  h = h.update(data);
  h = h.update(empty);
  digest := h.finish();
  bytes := ArrayList(u8).with_capacity(usize(32));
  i := usize(0);
  while(i < usize(32), i = (i + usize(1)), {
    bytes.push(digest(i));
  });
  result := hex_encode(bytes);
  expected := sha256_hex(_bytes_from_str("test"));
  assert(
    result == expected,
    "empty updates should not affect result"
  );
});
// ===== Edge cases =====
test("sha256_hex exactly 55 bytes (padding boundary)", {
  // 55 bytes: padding boundary — message + 0x80 + length fits exactly in one block
  data := _bytes_from_str("1234567890123456789012345678901234567890123456789012345");
  result := sha256_hex(data);
  assert(
    result == "03c3a70e99ed5eeccd80f73771fcf1ece643d939d9ecc76f25544b0233f708e9",
    "SHA-256 of 55-byte input should match"
  );
});
test("sha256_hex exactly 56 bytes (padding crosses block)", {
  // 56 bytes: padding must span two blocks
  data := _bytes_from_str("12345678901234567890123456789012345678901234567890123456");
  result := sha256_hex(data);
  assert(
    result == "0be66ce72c2467e793202906000672306661791622e0ca9adf4a8955b2ed189c",
    "SHA-256 of 56-byte input should match"
  );
});
test("sha256_hex exactly 64 bytes (one full block)", {
  data := _bytes_from_str("1234567890123456789012345678901234567890123456789012345678901234");
  result := sha256_hex(data);
  assert(
    result == "676491965ed3ec50cb7a63ee96315480a95c54426b0b72bca8a0d4ad1285ad55",
    "SHA-256 of 64-byte input should match"
  );
});
test("sha256_hex longer than 64 bytes (multi-block)", {
  data := _bytes_from_str("The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog.");
  result := sha256_hex(data);
  assert(
    result == "635241ac823ee4a81fbb410c92be616b0a89191083d8d7b5d232c823dc8df4f5",
    "SHA-256 of multi-block input should match"
  );
});
