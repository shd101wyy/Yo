open(import("std/string"));
{ md5, md5_hex } :: import("std/crypto/md5");
{ ArrayList } :: import("std/collections/array_list");
// Helper: build an ArrayList(u8) from a str
_bytes_from_str :: (fn(s : str) -> ArrayList(u8))(
  String.from(s).as_bytes()
);
// ===== RFC 1321 Test Vectors =====
test("md5_hex empty input", {
  data := ArrayList(u8).new();
  result := md5_hex(data);
  assert(
    result == "d41d8cd98f00b204e9800998ecf8427e",
    "MD5 of empty input should match RFC 1321"
  );
});
test("md5_hex a", {
  data := _bytes_from_str("a");
  result := md5_hex(data);
  assert(
    result == "0cc175b9c0f1b6a831c399e269772661",
    "MD5 of 'a' should match RFC 1321"
  );
});
test("md5_hex abc", {
  data := _bytes_from_str("abc");
  result := md5_hex(data);
  assert(
    result == "900150983cd24fb0d6963f7d28e17f72",
    "MD5 of 'abc' should match RFC 1321"
  );
});
test("md5_hex message digest", {
  data := _bytes_from_str("message digest");
  result := md5_hex(data);
  assert(
    result == "f96b697d7cb7938d525a2f31aaf161d0",
    "MD5 of 'message digest' should match RFC 1321"
  );
});
test("md5_hex alphabet", {
  data := _bytes_from_str("abcdefghijklmnopqrstuvwxyz");
  result := md5_hex(data);
  assert(
    result == "c3fcd3d76192e4007dfb496cca67e13b",
    "MD5 of alphabet should match RFC 1321"
  );
});
test("md5_hex alphanumeric", {
  data := _bytes_from_str("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789");
  result := md5_hex(data);
  assert(
    result == "d174ab98d277d9f5a5611c2c9f419d9f",
    "MD5 of alphanumeric should match RFC 1321"
  );
});
test("md5_hex numeric sequence", {
  data := _bytes_from_str("12345678901234567890123456789012345678901234567890123456789012345678901234567890");
  result := md5_hex(data);
  assert(
    result == "57edf4a22be3c955ac49da2e2107b67a",
    "MD5 of numeric sequence should match RFC 1321"
  );
});
// ===== md5 raw digest tests =====
test("md5 returns 16 bytes", {
  data := _bytes_from_str("hello");
  digest := md5(data);
  // MD5("hello") = 5d41402abc4b2a76b9719d911017c592
  assert(digest(usize(0)) == u8(0x5d), "first byte should be 0x5d");
  assert(digest(usize(15)) == u8(0x92), "last byte should be 0x92");
});
// ===== Edge cases =====
test("md5_hex exactly 55 bytes (padding boundary)", {
  data := _bytes_from_str("1234567890123456789012345678901234567890123456789012345");
  result := md5_hex(data);
  assert(
    result == "c9ccf168914a1bcfc3229f1948e67da0",
    "MD5 of 55-byte input should match"
  );
});
test("md5_hex exactly 56 bytes (padding crosses block)", {
  data := _bytes_from_str("12345678901234567890123456789012345678901234567890123456");
  result := md5_hex(data);
  assert(
    result == "49f193adce178490e34d1b3a4ec0064c",
    "MD5 of 56-byte input should match"
  );
});
test("md5_hex exactly 64 bytes (one full block)", {
  data := _bytes_from_str("1234567890123456789012345678901234567890123456789012345678901234");
  result := md5_hex(data);
  assert(
    result == "eb6c4179c0a7c82cc2828c1e6338e165",
    "MD5 of 64-byte input should match"
  );
});
