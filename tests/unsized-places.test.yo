//! Unsized places and the `static` origin (plans/VALUES_BY_DEFAULT.md
//! decision 49, S1). An `Index(Range(usize))` impl whose `Output` is `[T]`
//! makes `xs(a..b)` an unsized place, so `&xs(a..b)` is a zero-copy view with
//! origin `xs`. A tail struct's last field is `[T]`: `unsize` turns a pointer
//! to its fixed-size instance into a pointer to it, whose fields read through
//! the fat pointer. `static` is the empty origin.
pragma(Pragma.AllowUnsafe);
{ assert, panic } :: import("std/assert");
{ ArrayList } :: import("std/collections/array-list");
{ malloc, free } :: import("std/libc/stdlib.yo");

// A test-local container: the prelude's `Index` keeps `Output : Type` until
// decision 49 S2, and an unsized `Output` already fits it.
_UpBuf :: struct(items : Array(i32, 4));
impl(
  _UpBuf,
  Index(Range(usize))(
    Output : [i32],
    index : (fn(self : &Self, r : Range(usize)) -> &[i32])({
      assert((r.start <= r.end) && (r.end <= usize(4)), "range in bounds");
      p := unsafe(__yo_slice_ptr(unsize(&self.items)));
      part := unsafe(__yo_slice_from_raw_parts(p.add(r.start), r.end - r.start));
      &part.*
    })
  )
);
_up_sum :: (fn(xs : &[i32]) -> i32)({
  p := unsafe(__yo_slice_ptr(xs));
  (mut(total) : i32) = i32(0);
  (mut(i) : usize) = usize(0);
  while(i < __yo_slice_len(xs), i = (i + usize(1)), {
    total = (total + unsafe(p.add(i).*));
  });
  total
});

test("&xs(a..b) is a view of the range", {
  b := _UpBuf(items : Array(i32, 4)(1, 2, 3, 4));
  v := &b(usize(1) .. usize(3));
  assert(__yo_slice_len(v) == usize(2), "two elements");
  assert(_up_sum(v) == i32(5), "the view reads the buffer in place");
  assert(size_of_val(v) == usize(8), "two i32s");
});

test("an unsized place has no value of its own", {
  comptime_expect_error(
    _up_copy_view :: (fn(b : &_UpBuf) -> unit)({
      _v := b(usize(0) .. usize(2));
    }),
    "is not `Sized`"
  );
});

// A tail struct over its `?Sized` binder: `_UpTail(Array(i32, 3))` is the
// sized instance and `_UpTail([i32])` the tail-unsized one.
_UpTail :: (fn(comptime(T) : ?Sized) -> comptime(Type))(struct(n : i32, items : T));
_up_tail_n :: (fn(t : &_UpTail([i32])) -> i32)(t.n);
_up_tail_sum :: (fn(t : &_UpTail([i32])) -> i32)(_up_sum(&t.items));

test("unsize turns a tail struct's array into its slice", {
  s := _UpTail(Array(i32, 3))(n : i32(7), items : Array(i32, 3)(10, 20, 30));
  u := unsize(&s);
  assert(_up_tail_n(u) == i32(7), "a sized field through the fat pointer");
  assert(_up_tail_sum(u) == i32(60), "the tail is a [i32] place");
  assert(size_of_val(u) == size_of(_UpTail(Array(i32, 3))), "the same bytes as the sized instance");
  assert(align_of_val(u) == align_of(i32), "the struct's alignment");
});

mut(_UP_DROPPED) := i32(0);
_UpTracked :: struct(id : i32);
impl(
  _UpTracked,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _UP_DROPPED = (_UP_DROPPED + self.id);
    })
  )
);
_up_drop_in_place :: (fn(generic(T : ?Sized), p : *T) -> unit)(unsafe(___drop(p.*)));

test("___drop of a tail struct place drops its fields and its tail", {
  _UP_DROPPED = i32(0);
  raw := unsafe(malloc(size_of(_UpTail(Array(_UpTracked, 2)))));
  slot := match(raw, .Some(r) => (*_UpTail(Array(_UpTracked, 2)))(r), .None => panic("malloc failed"));
  unsafe(consume(slot.* = _UpTail(Array(_UpTracked, 2))(n : i32(0), items : Array(_UpTracked, 2)(_UpTracked(id : i32(1)), _UpTracked(id : i32(2))))));
  unsafe(_up_drop_in_place(unsize(slot)));
  assert(_UP_DROPPED == i32(3), "each tail element dropped once");
  unsafe(free(.Some((*void)(slot))));
});

// `static`: the empty origin. A reference with it borrows no place.
_UpStaticRef :: &(i32, static);

test("static is the empty origin", {
  comptime_assert(Type.impls(_UpStaticRef, Escapable), "a static reference borrows nothing");
});

// A by-value capture of a fat reference stores the fat pointer itself
// (issues/fixed/2026-11-15-a-closure-capturing-a-fat-reference-by-value-emits-invalid-c.md).
test("a closure captures a &[i32] binding by value", {
  a := Array(i32, 3)(i32(1), i32(2), i32(3));
  v := unsize(&a);
  (f : Impl(Fn() -> i32)) = ({ v }() => _up_sum(v));
  assert(f() == i32(6), "the captured view reads the array");
});
// A call returning `&[T]` or `&str` whose result is used where the call may
// unwind (any `test` body) spills the fat pair into a temp of the
// reference's C type, not of the pointee's
// (issues/fixed/2026-11-19-an-unsized-projection-call-that-may-unwind-spills-into-an-undeclared-temp.md).
_UpRow :: struct(a : Array(i32, 3), s : &str);
_up_row_view :: (fn(x : &_UpRow) -> &[i32])(&x.a.*);
_up_row_name :: (fn(x : &_UpRow) -> &str)(&x.s.*);
_up_any_view :: (fn(generic(T : ?Sized), x : &T) -> &T)(&x.*);
test("an unsized projection call result is read where the call may unwind", {
  r := _UpRow(a : Array(i32, 3)(i32(1), i32(2), i32(3)), s : "abcd");
  assert(_up_row_view(&r).len() == usize(3), "a free &[i32] projection");
  v := _up_row_view(&r);
  assert(v.len() == usize(3), "bound, then read");
  assert(_up_row_name(&r).len() == usize(4), "a free &str projection");
  assert(_up_any_view(&r.a.*).len() == usize(3), "a generic projection at T = [i32]");
});
// ---------------------------------------------------------------------------
// `static` becomes a checked origin (VERDICTS-74, 2026-11-21): a reference's
// origin enters type identity as one bit (static or not), the empty origin is
// spelled in any file, and only values that borrow no place flow into it.
// ---------------------------------------------------------------------------
// Each order uses its own pointee, so the instance it asks about first is
// the first one created (probes s13a and s13b); a `::` alias is evaluated at
// its first use.
_UpX :: struct(n : i32);
_UpY :: struct(n : i32);
_UpOptStaticX :: Option(&(_UpX, static));
_UpOptElidedX :: Option(&_UpX);
_UpOptElidedY :: Option(&_UpY);
_UpOptStaticY :: Option(&(_UpY, static));
test("Option(&(X, static)) and Option(&X) are two instances, static written first", {
  comptime_assert(Type.impls(_UpOptStaticX, Escapable), "Option of a static reference is Escapable");
  comptime_assert(!Type.impls(_UpOptElidedX, Escapable), "Option of an elided-origin reference is not Escapable");
});
test("Option(&(X, static)) and Option(&X) are two instances, elided written first", {
  comptime_assert(!Type.impls(_UpOptElidedY, Escapable), "Option of an elided-origin reference is not Escapable");
  comptime_assert(Type.impls(_UpOptStaticY, Escapable), "Option of a static reference is Escapable");
});
_UpStaticFn :: (fn(a : &(str, static), b : &(str, static)) -> &(str, static))(cond(true => a, true => b));
_UpStaticHolder :: struct(name : &(str, static));
test("a -> &(str, static) function over two literals", {
  s := _UpStaticFn("hello", "world");
  assert(s.len() == usize(5), "the static result reads");
});
test("a &(str, static) field and an ArrayList(&(str, static)) element", {
  h := _UpStaticHolder(name : "abc");
  mut(xs) := ArrayList(&(str, static)).new();
  xs.push("def");
  // Bound first: a method call straight on `xs(i)` emits invalid C
  // (issues/2026-11-23-a-method-call-on-an-arraylist-str-element-read-by-index-emits-a-dot-on-a-pointer.md).
  e := xs(usize(0));
  assert((h.name.len() == usize(3)) && (e.len() == usize(3)), "static slots hold literals");
});
test("a static value passed to a &str parameter", {
  takes :: (fn(s : &str) -> usize)(s.len());
  (lit : &(str, static)) = "static";
  assert(takes(lit) == usize(6), "a static value widens into every origin position");
});
_UpG := _UpX(n : i32(7));
_UpStaticSlot :: struct(r : Option(&(_UpX, static)));
_UpStaticWrap :: (fn(v : &(_UpX, static)) -> Option(&(_UpX, static)))(.Some(v));
_UpStaticFieldOf :: (fn(t : &_UpStaticSlot) -> Option(&(_UpX, static)))(t.r);
_UpStaticCopyField :: (fn(s : &mut _UpStaticSlot, t : &_UpStaticSlot) -> unit)({
  s.r = t.r;
});
test("a read of a static parameter or of a static-typed field is a static value", {
  // A bare static parameter returned as `-> &(T, static)` checks but emits
  // invalid C (issues/2026-11-25-a-static-reference-parameter-returned-bare-emits-its-referent.md).
  mut(h) := _UpStaticSlot(r : .None);
  h.r = _UpStaticWrap(&_UpG);
  mut(k) := _UpStaticSlot(r : .None);
  // A `&mut` / `&` of a holder with a static field borrows the holder; it
  // is no static value, and no static slot asks it to be.
  _UpStaticCopyField(&mut k, &h);
  rk := &k;
  assert(match(_UpStaticFieldOf(rk), .Some(r) => (r.*.n == i32(7)), .None => false), "the static reference reads through every hop");
});
