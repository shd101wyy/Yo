// Auto-dereference through the `Deref` marker (plans/VALUES_BY_DEFAULT.md
// §3.3, V1): on a `Rc`/`Arc` whose own members lack a name, `w.field` and
// `w.method()` mean `w.*.field` and `w.*.method()`, recursively through nested
// wrappers. A name the wrapper and its payload both have is E0616 (decision
// 32): `Rc.m(w)` names the wrapper's, `w.*.m()` the payload's. The file is deliberately NOT
// pragma'd: rule D3 (no write through an `Arc` root in safe code) must still
// fire through the auto-dereference.
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
_P :: struct(n : i32, items : ArrayList(i32));
impl(
  _P,
  get : (fn(imm(self) : Self) -> i32)(self.n),
  bump : (fn(mut(self) : Self) -> unit)({
    self.n = (self.n + i32(1));
  })
);
derive(_P, Clone);
_Q :: struct(n : i32, arr : Array(i32, 2));
derive(_Q, Copy, Clone);
impl(
  _Q,
  get : (fn(self : Self) -> i32)(self.n),
  bump : (fn(mut(self) : Self) -> unit)({
    self.n = (self.n + i32(1));
  })
);
_mk :: (fn(n : i32) -> _P)(_P(n : n, items : ArrayList(i32).new()));
/// Generic over the receiver: one body reads `x.n` on a `_P` and on a
/// `Rc(_P)`; each specialization owns its body, so the Rc call's rewrite
/// must not leak into the plain call.
_read_n :: (fn(generic(T : Type), imm(x) : T) -> i32)(x.n);
_take :: (fn(v : i32) -> i32)(v + i32(1));
// A payload field holding a function, called through the wrapper.
_H :: struct(f : (fn(x : i32) -> i32));
derive(_H, Copy, Clone);
// A user type may not implement `Deref` (concrete or generic impl).
_UserWrap :: struct(v : i32);
_UserGen :: (fn(comptime(T) : Type) -> comptime(Type))(struct(v : T));
test("auto-deref: field read through Rc", {
  b := rc(_mk(i32(1)));
  assert(b.n == i32(1), "b.n reads b.*.n");
  assert((b.n + i32(1)) == i32(2), "inside an operator");
  assert(_take(b.n) == i32(2), "as a call argument");
  x := b.n;
  assert(x == i32(1), "bound to a local");
});
test("auto-deref: method call through Rc", {
  b := rc(_mk(i32(4)));
  assert(b.get() == i32(4), "b.get() calls b.*.get()");
  assert(b.items.len() == usize(0), "method on a forwarded field");
});
test("auto-deref: nested Rc(Rc(T)) reaches the innermost payload", {
  bb := rc(rc(_mk(i32(2))));
  assert(bb.n == i32(2), "field through two wrappers");
  assert(bb.get() == i32(2), "method through two wrappers");
  bb.bump();
  assert(bb.*.*.n == i32(3), "inout(self) through two wrappers");
  bb.n = i32(9);
  assert(bb.*.*.n == i32(9), "write through two wrappers");
});
test("auto-deref: a method the wrapper and its payload both have is E0616", {
  b := rc(_mk(i32(5)));
  // `_P` derives Clone too, so `b.clone()` could be the Rc's clone or the
  // payload's (decision 32): the error names both spellings.
  comptime_expect_error(b.clone(), "is a method of Rc(_P) and of its payload _P");
  comptime_expect_error(b.clone(), "Write Rc.clone(b) for the Rc's own clone, or b.*.clone(...) for the payload's");
  // The annotations are the check: each spelling has its own type.
  (c : Rc(_P)) = Rc.clone(b);
  c.n = i32(6);
  assert(b.n == i32(5), "the clone is a new cell");
  assert(c.n == i32(6), "and its payload is reachable");
  (d : _P) = b.*.clone();
  assert(d.n == i32(5), "the payload's clone is a _P");
  // `*` is the wrapper's own field: `b.*` is the payload, not forwarded.
  (pl : _P) = b.*;
  assert(pl.n == i32(5), "b.* names the payload");
});
test("auto-deref: a field write through Rc is a place", {
  b := rc(_mk(i32(1)));
  b.n = i32(5);
  assert(b.*.n == i32(5), "b.n = v writes b.*.n");
  // An Rc shares its cell: the write is seen through every copy.
  c := b;
  c.n = i32(7);
  assert(b.n == i32(7), "written through the shared cell");
});
test("auto-deref: inout(self) through Rc", {
  b := rc(_mk(i32(1)));
  b.bump();
  assert(b.*.n == i32(2), "b.bump() mutates the payload");
  b.items.push(i32(3));
  b.items.push(i32(4));
  assert(b.*.items.len() == usize(2), "b.items.push(x) mutates the payload's list");
});
test("auto-deref: Arc reads forward, writes are D3 errors in safe code", {
  a := arc(_Q(n : i32(4), arr : [i32(1), i32(2)]));
  assert(a.n == i32(4), "a.n reads a.*.n");
  assert(a.get() == i32(4), "a.get() calls a.*.get()");
  comptime_expect_error(a.bump(), "atomic object");
  comptime_expect_error(a.n = i32(5), "atomic object");
  assert(a.arr(usize(1)) == i32(2), "a.arr(i) reads through the Arc");
  comptime_expect_error(a.arr(usize(0)) = i32(1), "atomic object");
});
test("auto-deref: one generic body serves a value and an Rc", {
  p := _mk(i32(3));
  b := rc(_mk(i32(6)));
  assert(_read_n(p) == i32(3), "plain receiver");
  assert(_read_n(b) == i32(6), "Rc receiver");
  assert(_read_n(p) == i32(3), "plain receiver again");
});
test("auto-deref: indexing a forwarded field (callee position)", {
  b := rc(_mk(i32(1)));
  b.items.push(i32(5));
  b.items.push(i32(6));
  assert(b.items(usize(1)) == i32(6), "b.items(i) reads b.*.items(i)");
  b.items(usize(0)) = i32(7);
  assert(b.*.items(usize(0)) == i32(7), "b.items(i) = v writes the payload's list");
  bb := rc(rc(_mk(i32(1))));
  bb.items.push(i32(8));
  assert(bb.items(usize(0)) == i32(8), "through two wrappers");
  bb.items(usize(0)) = i32(9);
  assert(bb.*.*.items(usize(0)) == i32(9), "written through two wrappers");
});
test("auto-deref: a function-typed payload field is callable", {
  h := rc(_H(f : (fn(x : i32) -> i32)(x + i32(1))));
  assert(h.f(i32(1)) == i32(2), "h.f(x) calls h.*.f(x)");
});
test("auto-deref: only the prelude implements Deref", {
  comptime_expect_error(impl(_UserWrap, Deref(Target : i32)), "Cannot implement Deref");
  comptime_expect_error(impl(generic(T : Type), _UserGen(T), Deref(Target : T)), "Cannot implement Deref");
  comptime_assert(Type.impls(Rc(_P), Deref), "Rc implements Deref");
  comptime_assert(Type.impls(Arc(_Q), Deref), "Arc implements Deref");
  comptime_assert(!Type.impls(_P, Deref), "a plain struct does not");
});
test("auto-deref: a miss names the payload (E0406, E0610)", {
  b := rc(_mk(i32(1)));
  comptime_expect_error(b.nn, "its payload");
  comptime_expect_error(b.nn, "has no field \"nn\" either");
  comptime_expect_error(b.nope(), "has no field or method \"nope\" either");
  bb := rc(rc(_mk(i32(1))));
  comptime_expect_error(bb.nn, "has no field \"nn\" either");
});
// Decision 32 also covers a payload FIELD: a function-typed field is
// callable, so `w.clone()` could call the payload's `clone` field.
_seven :: (fn() -> i32)(i32(7));
_HC :: struct(clone : (fn() -> i32));
impl(_HC, Clone(clone : (fn(imm(self) : Self) -> Self)(_HC(clone : self.clone))));
test("auto-deref: a wrapper method against a payload field is E0616", {
  w := rc(_HC(clone : _seven));
  comptime_expect_error(w.clone(), "is a method of Rc(_HC) and a field of its payload");
  comptime_expect_error(w.clone(), "or w.*.clone(...) to call the payload's field");
  (c : Rc(_HC)) = Rc.clone(w);
  f := w.*.clone;
  assert(f() == i32(7), "the payload's field");
  assert(ref_count(c) == usize(1), "the Rc's own clone is a fresh cell");
});
// A name only the payload has still forwards; a name only the wrapper has
// is the wrapper's. Only a name both have is the error.
test("auto-deref: an unclashed name forwards unchanged", {
  b := rc(_mk(i32(4)));
  assert(b.get() == i32(4), "a payload-only method forwards");
  assert(ref_count(b) == usize(1), "a wrapper-only free function is unaffected");
});
// A trait-bound call in a generic body is the bound's method, never the
// clash, even when the type argument is a wrapper.
_clone_any :: (fn(generic(T : Type), imm(x) : T, where(T <: Clone)) -> T)(x.clone());
test("auto-deref: a trait-bound call at a wrapper instantiation is not the clash", {
  b := rc(_mk(i32(3)));
  c := _clone_any(b);
  c.n = i32(8);
  assert(b.n == i32(3), "T := Rc(_P): the Rc's own clone, a new cell");
});
// derive(Clone) spells a wrapper field's clone through its Clone impl, so a
// struct holding an `Rc` derives Clone with no clash.
_HoldsRc :: struct(r : Rc(i32), k : i32);
derive(_HoldsRc, Clone);
_EnumRc :: enum(A(r : Rc(i32)), B);
derive(_EnumRc, Clone);
test("auto-deref: derive(Clone) clones an Rc field through the Rc's Clone", {
  x := _HoldsRc(r : rc(i32(1)), k : i32(2));
  y := x.clone();
  x.r.* = i32(5);
  assert(y.r.* == i32(1), "the derived clone made a new cell, as the Rc's Clone does");
  e := _EnumRc.A(r : rc(i32(6)));
  f := e.clone();
  match(
    f,
    .A(r) => assert(r.* == i32(6), "the enum variant's Rc field cloned"),
    .B => assert(false, "variant kept")
  );
});
