{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ unchecked_non_zero } :: import("std/spec/refine");
{ ArrayList } :: import("std/collections/array_list");
/// Phase C structural gates for safe code (per plans/reference/MEMORY_SAFETY.md).
///
/// The previous gates required `unsafe(...)` to wrap pointer ops but
/// still let safe code *declare* `*(T)` types and *take* `&(expr)`
/// addresses, on the basis that without an `unsafe(...)`-wrappable
/// op, those declarations were inert. Phase C tightens the safe
/// surface: pointer-type declarations and the address-of operator
/// themselves are rejected in safe code, so user code can't even
/// name a raw pointer.
///
/// Negative cases pinned via `comptime_expect_error(...)`. The
/// positive direction (pragma + raw pointers work) is covered by
/// `tests/unsafe.test.yo` and `tests/privilege_pragma.test.yo`.
// `*(T)` in a parameter slot is rejected in safe code.
comptime_expect_error(
  takes_ptr :: (fn(p : *i32) -> i32)(i32(0))
);
// `*(T)` in a return slot is rejected in safe code.
comptime_expect_error(
  returns_ptr :: (fn() -> *i32)({
    x := i32(0);
    addr_of(x)
  })
);
// `*(T)` in a struct field is rejected in safe code.
comptime_expect_error(
  HasPtrField :: struct(p : *i32)
);
// `addr_of(x)` address-of is rejected in safe code (even when assigning to
// an explicitly-typed local — the type rule fires too, but the
// address-of fires first at the construction site).
comptime_expect_error({
  x := i32(0);
  (p : *i32) = addr_of(x);
});
// `unsafe(...)` itself is rejected in safe code.
comptime_expect_error(
  unsafe(i32(0))
);
// `asm(...)` is rejected in safe code (implicitly unsafe).
comptime_expect_error(
  asm("nop")
);
// `extern(...)` declarations are rejected in safe code (FFI is
// unsafe by construction; user code calls stdlib wrappers).
comptime_expect_error(
  extern(
    "c",
    bad_strlen :
      (
        fn(s : *u8) -> usize
      )
  )
);
// `c_include(...)` header imports are rejected in safe code (same
// rationale — declares FFI symbols).
comptime_expect_error(
  c_include(
    "<string.h>",
    bad_strlen :
      (
        fn(s : *u8) -> usize
      )
  )
);
// Pointer arithmetic `&+` is rejected in safe code.
comptime_expect_error({
  x := i32(0);
  p := addr_of(x);
  q := p.add(usize(1));
});
// Pointer cast `(*U)(p)` is rejected in safe code (result has type
// `*(U)`, which is a forbidden expression type).
comptime_expect_error({
  x := i32(0);
  p := addr_of(x);
  q := (*u8)(p);
});
// Positive runtime guardrail: safe code with no pointer surface
// compiles and runs cleanly.
swap :: (fn(mut(a) : i32, mut(b) : i32) -> unit)({
  tmp := a;
  a = b;
  b = tmp;
});
test("safe code uses inout, no raw pointers needed", {
  x := i32(1);
  y := i32(2);
  swap(x, y);
  assert(x == i32(2), "swapped: x");
  assert(y == i32(1), "swapped: y");
});
// ============================================================================
// Phase A (THREAD_SAFETY): Manual impl(T, Send()) / impl(T, Acyclic())
// requires pragma(Pragma.AllowUnsafe). Auto-derived Send/Acyclic (from
// struct/enum definitions) are not gated — only explicit impl declarations.
// ============================================================================
// Manual impl(T, Send()) without pragma is rejected.
comptime_expect_error({
  PlainStruct :: struct(value : i32);
  impl(PlainStruct, Send());
});
// Manual impl(T, Acyclic()) without pragma is rejected.
comptime_expect_error({
  PlainStruct2 :: struct(value : i32);
  impl(PlainStruct2, Acyclic());
});
// Manual impl(T, Send()) and impl(T, Acyclic()) together without pragma
// are rejected (both gates fire).
comptime_expect_error({
  PlainStruct3 :: struct(value : i32);
  impl(PlainStruct3, Send());
  impl(PlainStruct3, Acyclic());
});

// =====================================================================// Pointer-free APIs with unsafe semantics (the safe-mode handover §3.2
// audit). Each of these compiled cleanly in safe code before its gate; the
// tests pin the error the fix produces.
// ============================================================================
// `String.ptr()` hands out the heap buffer: the POINTER result is a raw
// pointer value, which safe code may not hold. Before the fix this was
// `raw_bytes() -> RawSlice(u8)` — a struct wrapping the pointer, which
// passed the gate and reached `random_bytes`: a heap-use-after-free WRITE
// once the string reallocated.
// issues/fixed/safe-code-holds-a-use-after-free-through-rawslice.md
comptime_expect_error({
  s := String.from("hi");
  s.ptr()
});
// `MaybeUninit.assume_init` reads the uninitialized slot: it now takes the
// `as_ptr()` result as a witness, a pointer safe code cannot hold. The
// one-argument spelling no longer exists, so the call is an arity error.
// issues/fixed/safe-code-reads-uninitialized-memory-through-maybeuninit-assume-init.md
comptime_expect_error({
  m := MaybeUninit(i64).new();
  m.assume_init()
});
// `std/spec/refine`'s trusted casts forge a refinement with no check and no
// proof; they now take a `*(T)` witness (`&(x)`), which safe code cannot
// produce. The two-argument spelling no longer exists.
// issues/fixed/safe-code-forges-refinement-proofs-through-unchecked-casts.md
comptime_expect_error({
  zero := i32(0);
  unchecked_non_zero(zero)
});
// The struct-wrapping-a-pointer class is NOT structurally detectable, so
// these stay as boundary pins: HOLDING a managed container whose pointer
// field is public by accident (HashMap's `ctrl : ?(*(u8))`) is fine —
// while READING that field is an enum-wrapping-a-pointer expression and
// stays gated.
comptime_expect_error({
  { HashMap } :: import("std/collections/hash_map");
  m := HashMap(i32, i32).new();
  c := m.ctrl;
  c
});
{
  { HashMap } :: import("std/collections/hash_map");
  m := HashMap(i32, i32).new();
  m.insert(i32(1), i32(2));
  assert(m.len() == usize(1), "a HashMap is safe to hold and use");
};
// `IndexUnchecked.index_unchecked` skips the bounds check; codegen calls it
// only at a subscript the verifier proved in bounds. Its result is a raw
// pointer, so safe code cannot call it directly, not even to dereference at
// once (plans/backlog/SAFE_MODE_5B_CONTAINER_BOUNDS_ELISION.md).
comptime_expect_error({
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  xs.index_unchecked(usize(5))
});
