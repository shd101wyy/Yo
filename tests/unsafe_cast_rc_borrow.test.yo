// `unsafe.cast(ptr, RcType)` is a BORROWED view of an object someone else
// owns — binding it must not make the local owning, or the callee's scope-end
// drop frees the caller's object
// (issues/fixed/unsafe-cast-to-rc-type-is-treated-as-owned.md, C49).
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Thread } :: import("std/thread");
Ev :: struct(name : String, kind : i32);
W :: ref(struct(q : ArrayList(Ev), active : bool, hits : i32));
// A callback-shaped function: the object arrives as an opaque pointer.
bump_through_cast :: (fn(ud : *u8) -> unit)({
  w := unsafe.cast(ud, W);
  if(w.active, {
    w.q.push(Ev(name : String.from("x"), kind : i32(2)));
    w.hits = (w.hits + i32(1));
  });
});
// Round trip through the opaque pointer and hand the handle back.
identity_through_cast :: (fn(ud : *u8) -> W)(unsafe.cast(ud, W));
test("the caller's object survives a casting callee", {
  w := W(q : ArrayList(Ev).new(), active : true, hits : i32(0));
  bump_through_cast(unsafe.cast(w, *u8));
  bump_through_cast(unsafe.cast(w, *u8));
  bump_through_cast(unsafe.cast(w, *u8));
  assert(w.hits == i32(3), "three callbacks ran");
  assert(w.q.len() == usize(3), "three events queued");
  assert(w.q(usize(0)).name == "x", "the pushed String is intact");
});
test("a cast-derived handle stored and read later stays valid", {
  w := W(q : ArrayList(Ev).new(), active : true, hits : i32(0));
  w2 := identity_through_cast(unsafe.cast(w, *u8));
  w2.hits = i32(7);
  assert(w.hits == i32(7), "same object through the round trip");
  holder := ArrayList(W).new();
  holder.push(w2);
  bump_through_cast(unsafe.cast(w, *u8));
  assert(holder(usize(0)).hits == i32(8), "the held handle sees the callback's write");
  assert(w.q.len() == usize(1), "queue intact after the round trip");
});
// P-18 (plans/PARALLELISM_SOUNDNESS.md Phase 6): a user `Index` impl on an
// object, reached through an interior `inout` argument. The caller takes the
// container's borrow BEFORE the `index` call runs, and the `index` method's
// `inout(self)` entry assert used to see that very borrow and panic with one
// thread (issues/fixed/borrow-count-on-an-atomic-object-is-non-atomic-and-a-user-index-impl-panics-on-it.md).
_BorrowCell :: atomic(ref(struct(items : Array(i32, 4))));
impl(
  _BorrowCell,
  Index(usize)(
    Output : i32,
    index : (fn(inout(self) : Self, idx : usize) -> *Self.Output)(__yo_array_index(&self.items, idx))
  )
);
_PlainCell :: ref(struct(items : Array(i32, 4)));
impl(
  _PlainCell,
  Index(usize)(
    Output : i32,
    index : (fn(inout(self) : Self, idx : usize) -> *Self.Output)(__yo_array_index(&self.items, idx))
  )
);
_read_through :: (fn(inout(x) : i32) -> i32)(x);
test("a user Index impl reached through an interior inout argument does not trip its own caller's borrow", {
  c := _BorrowCell(items : Array(i32, 4)(i32(1), i32(2), i32(3), i32(4)));
  assert(_read_through(c(usize(1))) == i32(2), "atomic object");
  p := _PlainCell(items : Array(i32, 4)(i32(5), i32(6), i32(7), i32(8)));
  assert(_read_through(p(usize(2))) == i32(7), "plain ref object");
});
// ...and on an ATOMIC object the borrow counter is shared by every thread that
// takes an interior reference into it at once: atomic, or a lost update leaves
// it stuck non-zero (the next container operation panics). The race itself
// is the TSan job's to catch; this is the shape it runs.
test("two threads reading through an atomic object's Index impl at once", {
  c := _BorrowCell(items : Array(i32, 4)(i32(1), i32(2), i32(3), i32(4)));
  t := Thread(i32).spawn((io : Io) => {
    (s : i32) = i32(0);
    (i : i32) = i32(0);
    while(runtime(i < i32(10000)), {
      s = (s + _read_through(c(usize(0))));
      i = (i + i32(1));
    });
    s
  });
  (m : i32) = i32(0);
  (j : i32) = i32(0);
  while(runtime(j < i32(10000)), {
    m = (m + _read_through(c(usize(1))));
    j = (j + i32(1));
  });
  assert(t.join() == i32(10000), "the thread read index 0 every time");
  assert(m == i32(20000), "the main thread read index 1 every time");
});
