//! The `io.async` capture rows of the deref seed rider (VERDICTS-60 §4, 11):
//! `{ b : &b.* }` borrows a `&` parameter whole, so an `io.async` body keeps
//! its own copy of it (plans/VALUES_BY_DEFAULT.md §3.13 A2), and `{ &b }` is
//! E0926 in every file since the deref flip (v0.2.79), std and src included,
//! whose `io.async` capture lists are written this way
//! (issues/fixed/2026-11-13-the-v0277-seed-rejects-the-deref-swept-io-async-captures-of-a-reference-parameter.md).
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");

_DerefBox :: struct(n : i32);
_deref_box_read :: (fn(b : &_DerefBox, io : Io) -> Impl(Future(i32)))(
  io.async({ b : &b.* }(io : Io) => {
    return(b.*.n);
  })
);
test("an io.async capture `{ b : &b.* }` of a & parameter borrows the parameter whole", {
  x := _DerefBox(n : i32(11));
  assert(io.await(_deref_box_read(&x, io), io) == i32(11), "the future reads the referent it borrows");
  comptime_expect_error(
    _deref_box_field :: (fn(b : &_DerefBox, io : Io) -> Impl(Future(i32)))(
      io.async({ n : &b.*.n }(io : Io) => {
        return(n.*);
      })
    ),
    "borrows a `&` parameter whole"
  );
  comptime_expect_error(
    _deref_box_bare :: (fn(b : &_DerefBox, io : Io) -> Impl(Future(i32)))(
      io.async({ &b }(io : Io) => {
        return(b.*.n);
      })
    ),
    "borrowing the value it refers to"
  );
});
