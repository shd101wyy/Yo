// An import must bind every export at its DECLARED type, and the named form
// `{ K } :: import(m)` must agree with the module-qualified form `m.K`.
// History: the retired `open(import(m))` glob typed each export from its VALUE
// instead, so an exported `K :: u64(7)` arrived as `i32` and `K + u64(1)`
// failed to unify (issues/fixed/open-import-retypes-integer-constants.md).
{ assert } :: import("std/assert");
{ K_U8, K_U16, K_U32, K_U64, K_U64_ZERO, K_USIZE, K_I8, K_I64, K_ISIZE, K_BOOL, K_F64, K_PT, twice } :: import("./import_constants/constants.yo");
named :: import("./import_constants/constants.yo");
test("import: integer constants keep their declared width", {
  a := (K_U8 + u8(1));
  assert(a == u8(201), "u8");
  b := (K_U16 + u16(1));
  assert(b == u16(60001), "u16");
  c := (K_U32 + u32(1));
  assert(c == u32(4000000001), "u32");
  d := (K_U64 + u64(1));
  assert(d == u64(8), "u64");
  z := (K_U64_ZERO + u64(1));
  assert(z == u64(1), "u64 zero — the value that hid behind the i32 default");
  e := (K_USIZE + usize(1));
  assert(e == usize(4), "usize");
  f := (K_I8 + i8(1));
  assert(f == i8(-4), "i8");
  g := (K_I64 - i64(1));
  assert(g == i64(-9000000001), "i64");
  h := (K_ISIZE + isize(1));
  assert(h == isize(0), "isize");
});
test("import: non-integer constants and functions are unchanged", {
  assert(K_BOOL, "bool");
  assert((K_F64 * f64(2.0)) == f64(3.0), "f64");
  assert(K_PT.x == i32(1), "struct constant field");
  assert(twice(K_U64) == u64(14), "function export with a u64 argument");
});
test("named and module-qualified import agree", {
  assert(K_U64 == named.K_U64, "u64 via both forms");
  assert(K_USIZE == named.K_USIZE, "usize via both forms");
  assert((named.K_U64_ZERO + K_U64) == u64(7), "mixed arithmetic across the two forms");
});
