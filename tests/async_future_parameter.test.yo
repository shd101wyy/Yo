//! REGRESSION: a function that takes an `Impl(Future(T, E))` PARAMETER and
//! awaits it inside an `io.async` closure emitted C that did not compile. Two
//! independent codegen defects, both pre-existing and both invisible to
//! `yo check`
//! (issues/fixed/an-async-closure-capturing-a-future-parameter-emits-a-nested-typedef.md):
//!
//! 1. The Future interface type's ON-DEMAND declaration was written into the
//!    capture struct's OPEN BODY — a `typedef` inside a struct, plus a field of
//!    incomplete type. `generate_struct_declaration` emitted its opening line
//!    and only then resolved field type strings, and that resolution is what
//!    fires the on-demand hook into the same buffer.
//! 2. `get_future_field_name` returned the BARE name for an `.Outer` capture,
//!    so the await emitted `sm->fut` for a field that only exists as
//!    `sm->__capture.fut`. Every other spelling of an outer capture in codegen
//!    already carried the prefix.
//!
//! Neither had been reachable: `Impl(Future(T, E))` appears as a parameter type
//! only in `std/prelude.yo`'s BUILTIN declarations (`io.await`, `io.state`,
//! `io.spawn`), which are compiler intrinsics, and no `std/` function takes a
//! future — so nothing ever produced an awaited future that was an outer
//! capture rather than a local or an `await_future_<n>` slot.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
_take :: (fn(sink(fut) : Impl(Future(i32, Io)), io : Io) -> Impl(Future(i32, Io)))(
  io.async({ fut }(e : Io) => e.await(fut, e))
);
_work :: (fn(io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => i32(42)));
test("a future passed as a parameter can be awaited inside an async closure", {
  r := io.await(_take(_work(io), io), io);
  assert(r == i32(42), `expected 42, got ${r.to_string()}`);
});
_twice :: (fn(sink(a) : Impl(Future(i32, Io)), sink(b) : Impl(Future(i32, Io)), io : Io) -> Impl(Future(i32, Io)))(
  io.async({ a, b }(e : Io) => {
    x := e.await(a, e);
    y := e.await(b, e);
    x + y
  })
);
test("two future parameters each keep their own capture slot", {
  r := io.await(_twice(_work(io), _work(io), io), io);
  assert(r == i32(84), `expected 84, got ${r.to_string()}`);
});
// A bare function type returning `Impl(Future(...))` IS one representation —
// every future is a pointer to a state machine — so it stays a valid
// parameter type, unlike one returning `Impl(Fn(...))`
// (issues/fixed/a-function-returning-impl-passed-to-a-function-typed-parameter-is-called-through-void-pointer.md).
_fp_twice :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => (x * i32(2))));
_fp_plus :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((io2 : Io) => {
    s := String.from("abc");
    x + i32(s.len())
  })
);
_fp_run :: (fn(f : (fn(x : i32, io : Io) -> Impl(Future(i32, Io))), io : Io) -> i32)(io.await(f(i32(21), io), io));
test("two async functions through one function-typed parameter", {
  assert(_fp_run(_fp_twice, io) == i32(42), "first function");
  assert(_fp_run(_fp_plus, io) == i32(24), "second function");
});
// Every other way a future-returning function becomes a function-pointer
// VALUE. The function's own C prototype returns its concrete state machine;
// the value must be called through the slot's erased signature (a thunk), not
// through a cast, or `-fsanitize=function` aborts at the call
// (issues/fixed/2026-10-24-two-async-functions-through-one-function-typed-parameter-are-called-through-an-incompatible-pointer-type.md).
_fp_wrap :: (fn(f : (fn(x : i32, io : Io) -> Impl(Future(i32, Io))), io : Io) -> Impl(Future(i32, Io)))(
  io.async({ f }(e : Io) => e.await(f(i32(21), e), e))
);
test("a function-typed parameter captured by an async closure", {
  r := io.await(_fp_wrap(_fp_twice, io), io);
  assert(r == i32(42), `expected 42, got ${r.to_string()}`);
});
_fp_get :: (fn() -> (fn(x : i32, io : Io) -> Impl(Future(i32, Io))))(_fp_twice);
test("an async function returned as a function value", {
  g := _fp_get();
  r := io.await(g(i32(21), io), io);
  assert(r == i32(42), `expected 42, got ${r.to_string()}`);
});
_FpHolder :: struct(f : (fn(x : i32, io : Io) -> Impl(Future(i32, Io))));
_fp_only_in_field :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => (x + i32(1))));
test("an async function stored in a struct field", {
  direct := io.await(_fp_twice(i32(1), io), io);
  h := _FpHolder(f : _fp_twice);
  r := io.await(h.f(i32(21), io), io);
  assert((direct + r) == i32(44), `expected 44, got ${(direct + r).to_string()}`);
});
test("an async function reached only through a struct field", {
  h := _FpHolder(f : _fp_only_in_field);
  r := io.await(h.f(i32(41), io), io);
  assert(r == i32(42), `expected 42, got ${r.to_string()}`);
});
_fp_three :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => (x * i32(3))));
_fp_pick :: (fn(c : bool, io : Io) -> i32)({
  (mut(h) : (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))) = _fp_twice;
  if(c, {
    h = _fp_three;
  });
  io.await(h(i32(21), io), io)
});
test("a function-typed local conditionally reassigned", {
  a := _fp_pick(false, io);
  b := _fp_pick(true, io);
  assert(a == i32(42), `expected 42, got ${a.to_string()}`);
  assert(b == i32(63), `expected 63, got ${b.to_string()}`);
});
// The two functions have different state machines: a sync future and a
// `_state_t` that awaits. The local's C type names one of them.
_fp_pick_shapes :: (fn(c : bool, io : Io) -> i32)({
  (mut(h) : (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))) = _fp_awaiting;
  if(c, {
    h = _fp_twice;
  });
  io.await(h(i32(21), io), io)
});
test("a function-typed local reassigned between two state-machine shapes", {
  a := _fp_pick_shapes(false, io);
  b := _fp_pick_shapes(true, io);
  assert(a == i32(43), `expected 43, got ${a.to_string()}`);
  assert(b == i32(42), `expected 42, got ${b.to_string()}`);
});
// A body with an await is a full state machine (`_state_t`), not a sync future;
// a delegate returns another async function's future and has no block of its own.
_fp_awaiting :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    y := e.await(_fp_twice(x, e), e);
    y + i32(1)
  })
);
_fp_delegate :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(_fp_twice(x, io));
test("an awaiting async function and a delegate through one function-typed parameter", {
  assert(_fp_run(_fp_awaiting, io) == i32(43), "awaiting function");
  assert(_fp_run(_fp_delegate, io) == i32(42), "delegate function");
});
// A SPECIALIZED callee's parameter (`Impl(Fn(..))`, `generic(F : Type)`)
// is declared with the argument's own resolved state machine. The value passed
// is still the erased-signature thunk, so the callee must call through the
// erased result too, as must a caller of a function value a generic returns.
_fp_run_impl :: (fn(f : Impl(Fn(x : i32, io : Io) -> Impl(Future(i32, Io))), io : Io) -> i32)(io.await(f(i32(21), io), io));
_fp_run_generic :: (fn(generic(F : Type), f : F, io : Io) -> i32)(io.await(f(i32(21), io), io));
_fp_id :: (fn(generic(F : Type), f : F) -> F)(f);
test("an async function passed to a specialized higher-order callee", {
  assert(_fp_run_impl(_fp_twice, io) == i32(42), "Impl(Fn) parameter, sync future");
  assert(_fp_run_impl(_fp_awaiting, io) == i32(43), "Impl(Fn) parameter, awaiting function");
  assert(_fp_run_generic(_fp_twice, io) == i32(42), "generic parameter, sync future");
  assert(_fp_run_generic(_fp_plus, io) == i32(24), "generic parameter, second function");
  g := _fp_id(_fp_twice);
  r := io.await(g(i32(21), io), io);
  assert(r == i32(42), `generic identity: expected 42, got ${r.to_string()}`);
});
