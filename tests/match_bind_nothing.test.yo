{ assert } :: import("std/assert");
// Tests for the "match a variant, bind none of its fields" forms:
//   * bare `.Variant`        (allowed even when the variant HAS fields)
//   * `.Variant({})`         (empty curly — the zero case of partial curly)
// Both coexist with positional destructuring and partial curly destructuring.
import("std/fmt");
Shape :: enum(Circle(r : i32), Rectangle(w : i32, h : i32), Dot);
test("bare .Variant binds nothing for multi-field variants", {
  kind :: (fn(s : Shape) -> i32)(
    match(
      s,
      .Circle => i32(1),
      .Rectangle => i32(2),
      .Dot => i32(3)
    )
  );
  assert(kind(Shape.Circle(5)) == i32(1));
  assert(kind(Shape.Rectangle(3, 4)) == i32(2));
  assert(kind(Shape.Dot) == i32(3));
});
test("empty-curly .Variant({}) binds nothing", {
  kind :: (fn(s : Shape) -> i32)(
    match(
      s,
      .Circle({}) => i32(10),
      .Rectangle({}) => i32(20),
      .Dot => i32(30)
    )
  );
  assert(kind(Shape.Circle(5)) == i32(10));
  assert(kind(Shape.Rectangle(3, 4)) == i32(20));
  assert(kind(Shape.Dot) == i32(30));
});
test("bind-nothing coexists with positional and partial-curly destructuring", {
  area :: (fn(s : Shape) -> i32)(
    match(
      s,
      // positional destructuring
      .Circle(r) => (i32(3) * (r * r)),
      // partial curly: bind only `w`, ignore `h`
      .Rectangle({ w }) => w,
      // bare bind-nothing
      .Dot => i32(0)
    )
  );
  assert(area(Shape.Circle(2)) == i32(12));
  assert(area(Shape.Rectangle(7, 99)) == i32(7));
  assert(area(Shape.Dot) == i32(0));
});
test("bind-nothing arm can still use a wildcard fallback", {
  is_dot :: (fn(s : Shape) -> bool)(
    match(
      s,
      .Dot => true,
      _ => false
    )
  );
  assert(is_dot(Shape.Dot));
  assert(!is_dot(Shape.Circle(1)));
});
export(Shape);
// --- Literal payloads: a literal in a pattern payload position is COMPARED,
// not bound (issues/fixed/enum-pattern-bool-payload-not-compared.md). A `false`
// (or `true`, or an integer, or a string) atom used to be treated as a
// binding name, so `.Some(false)` silently matched `.Some(true)`.
Lamp :: enum(On, Off);
Reading :: enum(Level(v : i32), Flag(v : bool));
test("boolean literal payload discriminates", {
  classify :: (fn(o : Option(bool)) -> i32)(
    match(
      o,
      .Some(false) => i32(200),
      .Some(true) => i32(100),
      // The same-variant catch-all: until the usefulness algorithm lands
      // (P1), literal arms alone do not mark a variant covered.
      .Some(_) => i32(-1),
      .None => i32(0)
    )
  );
  assert(classify(Option(bool).Some(true)) == i32(100), ".Some(true) must take the true arm");
  assert(classify(Option(bool).Some(false)) == i32(200), ".Some(false) must take the false arm");
  assert(classify(Option(bool).None) == i32(0), ".None must take the none arm");
});
test("boolean literal payload with a catch-all binder", {
  classify :: (fn(o : Option(bool)) -> i32)(
    match(
      o,
      .Some(false) => i32(200),
      .Some(b) => cond(b => i32(100), true => i32(150)),
      .None => i32(0)
    )
  );
  assert(classify(Option(bool).Some(true)) == i32(100), "true falls to the binder arm");
  assert(classify(Option(bool).Some(false)) == i32(200), "false takes the literal arm");
});
test("integer literal payload discriminates", {
  band :: (fn(r : Reading) -> i32)(
    match(
      r,
      .Level(404) => i32(4),
      .Level(n) => n,
      .Flag(_) => i32(-2)
    )
  );
  assert(band(Reading.Level(404)) == i32(4), "the literal payload arm matches");
  assert(band(Reading.Level(500)) == i32(500), "other payloads bind");
});
test("literal payload on a comptime-known scrutinee", {
  // The compile-time match path is a different arm evaluator than the
  // runtime path above — pin both.
  v := match(
    Option(bool).Some(true),
    .Some(false) => i32(200),
    .Some(true) => i32(100),
    .Some(_) => i32(-1),
    .None => i32(0)
  );
  assert(v == i32(100), "comptime match must take the true arm");
});
// --- P0 (plans/MATCH_PATTERN_MATCHING.md §6): the #661 gaps and audit rows.
Reading2 :: enum(Code(v : i32), Flag2(v : bool));
test("negative integer literal payload discriminates (#661 gap 3)", {
  pick :: (fn(r : Reading2) -> i32)(
    match(
      r,
      .Code(-1) => i32(11),
      .Code(c) => c,
      .Flag2(_) => i32(-3)
    )
  );
  assert(pick(Reading2.Code(-1)) == i32(11), "the -1 arm matches");
  assert(pick(Reading2.Code(7)) == i32(7), "other codes bind");
});
test("float literal payload discriminates", {
  pick :: (fn(o : Option(f64)) -> i32)(
    match(
      o,
      .Some(1.5) => i32(1),
      .Some(v) => cond((v > 0.0) => i32(2), true => i32(3)),
      .None => i32(0)
    )
  );
  assert(pick(Option(f64).Some(1.5)) == i32(1), "the 1.5 arm matches");
  assert(pick(Option(f64).Some(2.5)) == i32(2), "other values take the binder arm");
  assert(pick(Option(f64).None) == i32(0), "none arm");
});
