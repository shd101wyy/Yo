// Two declared enums with identical variants are DIFFERENT types
// (issues/fixed/structurally-identical-error-enums-in-two-generic-impls-collide.md).
// The exact type comparison the CTFE memo uses compared enums structurally
// only, so `Result(unit, BErr)` was served the `Result(unit, AErr)` instance
// and a `.Err(err) => .Err(err)` propagation in the second generic impl
// failed with "Expected AErr, Got BErr". Both halves are pinned: the direct
// nominal check, and the production pair (HashMap + HashSet in one closure)
// whose error enums are now the same single shape.
{ assert } :: import("std/assert");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ ArrayList } :: import("std/collections/array_list");
AErr :: enum(Boom(code : i32), Quiet);
derive(AErr, Copy, Clone);
BErr :: enum(Boom(code : i32), Quiet);
derive(BErr, Copy, Clone);
fa :: (fn(fail : bool) -> Result(i32, AErr))(
  cond(
    fail => .Err(.Boom(code : i32(1))),
    true => .Ok(i32(10))
  )
);
fb :: (fn(fail : bool) -> Result(i32, BErr))(
  cond(
    fail => .Err(.Boom(code : i32(2))),
    true => .Ok(i32(20))
  )
);
// A generic carrier instantiated at both enums — the shape whose memo entry
// was shared.
Carrier :: (fn(comptime(E) : Type) -> comptime(Type))(struct(inner : Result(unit, E)));
impl(
  generic(E : Type),
  Carrier(E),
  pass_through : (fn(self : &Self) -> Result(unit, E))(
    match(
      self.inner,
      .Err(err) => .Err(err),
      .Ok(v) => .Ok(v)
    )
  )
);
test("same-shaped enums stay distinct through a generic instantiation", {
  ca := Carrier(AErr)(inner : Result(unit, AErr).Err(AErr.Boom(code : i32(1))));
  cb := Carrier(BErr)(inner : Result(unit, BErr).Err(BErr.Boom(code : i32(2))));
  ra := ca.pass_through();
  rb := cb.pass_through();
  assert(match(ra, .Err(e) => match(e, .Boom({ code }) => (code == i32(1)), .Quiet => false), .Ok(_) => false), "AErr carried");
  assert(match(rb, .Err(e) => match(e, .Boom({ code }) => (code == i32(2)), .Quiet => false), .Ok(_) => false), "BErr carried");
  assert(match(fa(false), .Ok(v) => (v == i32(10)), .Err(_) => false), "fa ok");
  assert(match(fb(true), .Err(e) => match(e, .Boom({ code }) => (code == i32(2)), .Quiet => false), .Ok(_) => false), "fb err");
});
test("a value of one enum is not accepted where the other is expected", {
  comptime_expect_error({
    e := AErr.Quiet;
    (y : BErr) = e;
    consume(y);
  });
  // NOT pinned here: `(x : Result(i32, BErr)) = fa(true)` is still ACCEPTED —
  // the non-exact comparison unifies same-named generic instantiations by
  // name alone (issues/fixed/lenient-generic-enum-compatibility-by-name.md); that
  // fix carries its own RED test.
});
test("HashMap and HashSet in one closure — error enums of the same shape", {
  m := HashMap(i32, i32).new();
  // D9: `insert` is infallible and yields the PREVIOUS value / "was new"
  // directly. This test exists for the ERROR-ENUM specializations, so it uses
  // `try_insert`, which still carries the two same-shaped error enums that
  // gave the test its name.
  r := m.try_insert(i32(7), i32(42));
  assert(match(r, .Ok(_) => true, .Err(_) => false), "insert must succeed");
  s := HashSet(i32).new();
  sr := s.try_insert(i32(9));
  assert(match(sr, .Ok(_) => true, .Err(_) => false), "set insert must succeed");
  assert(m.get(i32(7)).is_some(), "key 7 present");
  assert(s.contains(i32(9)), "elem 9 present");
  // Grow both past their initial capacity so `_resize` (the `.Err(err) =>
  // .Err(err)` propagation site) runs in both specializations.
  mut(i) := i32(0);
  while(i < i32(100), i = (i + i32(1)), {
    m.insert(i, i * i32(2));
    s.insert(i * i32(3));
  });
  assert(m.len() == usize(100), "map grew");
  assert(s.len() == usize(100), "set grew");
});
// Two RECURSIVE enums of one shape keep their own `ArrayList(Self)`
// (issues/fixed/2026-10-17-two-recursive-enums-of-one-shape-share-their-arraylist-self-instantiation.md).
// The type key's structural enum dedup merged the two declarations: the
// self-reference inside each expansion renders through the cycle guard
// without the enum's identity, so `ArrayList(RecB)` keyed — and specialized —
// as `ArrayList(RecA)`. Its elements then dispatched as `RecA`: `RecA`'s
// always-true `==` answered for `RecB`, and the C did not compile.
RecA :: enum(Leaf(v : i32), Node(kids : ArrayList(Self)));
RecB :: enum(Leaf(v : i32), Node(kids : ArrayList(Self)));
impl(
  RecA,
  Eq(RecA)(
    (==) : (fn(lhs : &Self, rhs : &Self) -> bool)(true),
    (!=) : (fn(lhs : &Self, rhs : &Self) -> bool)(false)
  )
);
_rec_b_kids_eq :: (fn(a : &ArrayList(RecB), b : &ArrayList(RecB)) -> bool)({
  if(a.len() != b.len(), {
    return(false);
  });
  (mut(i) : usize) = usize(0);
  while(i < a.len(), i = (i + usize(1)), {
    if(a(i) != b(i), {
      return(false);
    });
  });
  true
});
impl(
  RecB,
  Eq(RecB)(
    (==) : (fn(lhs : &Self, rhs : &Self) -> bool)(
      match(
        lhs,
        .Leaf(x) => match(rhs, .Leaf(y) => (x == y), _ => false),
        .Node(a) => match(rhs, .Node(b) => _rec_b_kids_eq(&a, &b), _ => false)
      )
    ),
    (!=) : (fn(lhs : &Self, rhs : &Self) -> bool)(!(lhs == rhs))
  )
);
test("two recursive enums of one shape have distinct ArrayList(Self) instantiations", {
  comptime_expect_error({
    xs := ArrayList(RecB).new();
    (ys : ArrayList(RecA)) = xs;
    consume(ys);
  });
  xs := ArrayList(RecB).new();
  xs.push(RecB.Leaf(v : i32(1)));
  ys := ArrayList(RecB).new();
  ys.push(RecB.Leaf(v : i32(2)));
  assert(RecB.Node(kids : xs) != RecB.Node(kids : ys), "RecB compares its own elements structurally");
  ra := ArrayList(RecA).new();
  ra.push(RecA.Leaf(v : i32(1)));
  bs := ArrayList(RecA).new();
  bs.push(RecA.Leaf(v : i32(2)));
  assert(RecA.Node(kids : ra) == RecA.Node(kids : bs), "RecA keeps its always-true ==");
});
