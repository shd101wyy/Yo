pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));
// Runtime `==` on a derived-Eq enum must dispatch to the generated derived
// equality function (a tag-comparison switch), NOT fold or fail. The receiver
// is a function PARAMETER, so the comparison is genuinely runtime and codegen
// has to emit a call to the collected derived `==` method.
Color :: enum(Red, Green, Blue);
derive(Color, Eq(Color));
tag :: (fn(c : Color) -> i32)(
  cond(
    (c == Color.Red) => i32(82),
    (c == Color.Green) => i32(71),
    true => i32(66)
  )
);
main :: (fn() -> unit)({
  unsafe(_a := putchar(int(tag(Color.Red))));
  unsafe(_b := putchar(int(tag(Color.Green))));
  unsafe(_c := putchar(int(tag(Color.Blue))));
});
export(main);
