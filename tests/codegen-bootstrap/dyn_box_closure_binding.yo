import("std/string");
{ println } :: import("std/fmt");
{ assert } :: import("std/assert");
{ RefCell } :: import("std/sync/refcell");

main :: (fn() -> unit)({
  // The two handles share one closure through an Rc, and the closure keeps
  // its counter behind a shared cell: an `Fn` closure may not write an
  // implicit capture (E0913, #1932), but a write through a `RefCell` door is
  // a read of the shared handle, so the `Rc(Dyn(Fn(...)))` shape stays.
  state := Rc.new(RefCell(i32).new(i32(1)));
  (closure : Rc(Dyn(Fn(y : i32) -> i32))) = Rc(Dyn(Fn(y : i32) -> i32)).new(
    dyn(
      Rc.new(y => {
        state.with_mut(v => {
          v.* = (v.* + y);
        });
        return(state.with(v => v.*));
      })
    )
  );
  // A Dyn owns its payload (plans/VALUES_BY_DEFAULT.md decision 7): the
  // two handles share one closure through an Rc.
  closure2 := Rc.clone(closure);
  closure.*(1); // 2
  closure2.*(1); // 3
  result := closure.*(2); // 5
  assert(result == 5, "Expected final result to be 5");
  println(`ok`);
});
export(main);
