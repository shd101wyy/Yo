pragma(Pragma.AllowUnsafe);
{ putchar } :: import("std/libc/stdio");
Wrap :: newtype(v : i32);
derive(Wrap, Copy, Clone);
impl(
  Wrap,
  bump : (fn(self : &mut Self) -> unit)({
    self.v = (self.v + i32(1));
  })
);
main :: (fn() -> unit)({
  w := Wrap(v : i32(64));
  w.bump();
  unsafe(putchar(int(w.v)));
});
export(main);
