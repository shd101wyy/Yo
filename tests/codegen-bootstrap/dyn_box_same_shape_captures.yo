import("std/string");
{ println } :: import("std/fmt");
{ assert } :: import("std/assert");

use_cb :: (fn(v : i32, cb : &Dyn(Fn(u : i32) -> i32)) -> i32)({
  return(cb(v));
});

t_auto :: (fn() -> unit)({
  a := 2;
  (f1 : Box(Dyn(Fn(u : i32) -> i32))) = dyn(Box.new(u => (u + 1 + a))); // capture variable 'a'
  x := use_cb(10, &f1.*);
  assert(x == 13, "ax");
  (f2 : Box(Dyn(Fn(u : i32) -> i32))) = dyn(Box.new(u => (u * 2))); // capture nothing
  y := use_cb(20, &f2.*);
  assert(y == 40, "ay");
  b := Rc(i32).new(5);
  (f3 : Box(Dyn(Fn(u : i32) -> i32))) = dyn(Box.new(u => (u + 1 + b.*))); // capture variable 'b'
  z := use_cb(10, &f3.*);
  assert(z == 16, "az");
});

t_manual :: (fn() -> unit)({
  a := 2;
  (f1 : Box(Dyn(Fn(u : i32) -> i32))) = dyn(Box.new(u => (u + 1 + a))); // capture variable 'a'
  x := use_cb(10, &f1.*);
  assert(x == 13, "mx");
  (f2 : Box(Dyn(Fn(u : i32) -> i32))) = dyn(Box.new(u => (u * 2))); // capture nothing
  y := use_cb(20, &f2.*);
  assert(y == 40, "my");
  b := Rc(i32).new(5);
  (f3 : Box(Dyn(Fn(u : i32) -> i32))) = dyn(Box.new(u => (u + 1 + b.*))); // capture variable 'b'
  z := use_cb(10, &f3.*);
  assert(z == 16, "mz");
});

main :: (fn() -> unit)({
  t_auto();
  t_manual();
  println(`ok`);
});
export(main);
