// Regression: the self-hosted evaluator's struct / enum / union constructor
// paths (yo-self/evaluator/calls/function.yo) must call
// `attach_temp_variable_to_expr(expr, true, ctx)` so a constructed reference
// (ref-struct / ref-enum) result is materialized into an owning caller-frame
// temp and dropped at scope end — mirroring TS function.ts:2461/2527/2567.
//
// Before the fix, yo-self emitted the constructor call INLINE with no temp and
// no scope-end drop, so every constructed reference leaked (RC never reaching
// 0). This was the ~9x under-free that ballooned the self-compiled compiler to
// 26G on yo-self/main.yo; TS always materialized+dropped.
//
// Observable: `Gc.tracked_count()`. `Node` is self-referential (`Option(Self)`)
// and therefore CYCLABLE, so each live instance is registered with the cycle
// collector and counted (an acyclic ref-struct is NOT tracked — the count would
// stay 0 regardless of leaks). The helper constructs four references and
// returns; with correct eager RC drops the live count returns to baseline 0.
// The count is kept small (well under the GC's auto-collect threshold) so the
// collector does not fire and mask a missing drop — mirroring how
// `tests/cycle_collector.test.yo` asserts exact counts. Pre-fix yo-self leaves
// the post-helper count at 4 (all four leaked), failing the assert (a DIFF /
// non-zero exit in the differential harness); TS and fixed yo-self both pass.
{ assert } :: import("std/assert");
Gc :: import("std/gc");

Node :: ref(struct(x : i32, next : Option(Self)));
Holder :: ref(struct(n : Node));

// Value enum with an RC field: dropping the enum result disposes its owned Node.
Tagged :: enum(Empty, One(a : Node));

// Borrowed param: the callee reads `f` and returns; the caller still owns the
// argument it passed and must drop it.
readx :: (fn(f : Node) -> i32)(f.x);

// Borrowed param whose callee keeps a ref (dups into Holder, dropped at scope
// end); the caller must still drop the argument it passed.
keep :: (fn(f : Node) -> i32)({
  b := Holder(n : f);
  b.n.x
});

// Constructs four references — a bare struct statement, a borrowed-read arg, a
// borrowed-keep arg, and an enum with a nested struct field — and discards all
// of them. Each must be dropped at this helper's scope end.
build_and_discard :: (fn() -> unit)({
  Node(x : 1, next :.None);
  readx(Node(x : 2, next :.None));
  keep(Node(x : 3, next :.None));
  Tagged.One(a : Node(x : 4, next :.None));
  ()
});

main :: (fn() -> unit)({
  assert(Gc.tracked_count() == u64(0), "baseline: no tracked objects at start");
  build_and_discard();
  assert(
    Gc.tracked_count() == u64(0),
    "no leak: every constructed reference was dropped at scope end"
  );
});
export(main);
