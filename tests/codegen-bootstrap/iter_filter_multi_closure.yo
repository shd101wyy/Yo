pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
CountIter :: struct(_count : i32, _max : i32);
impl(
  CountIter,
  Iterator(
    Item : i32,
    next : (fn(inout(self) : Self) -> Option(i32))(
      cond(
        (self._count >= self._max) => .None,
        true => {
          val := self._count;
          self._count = (self._count + i32(1));
          .Some(val)
        }
      )
    )
  )
);
main :: (fn() -> unit)({
  iter1 := CountIter(i32(0), i32(5));
  filtered1 := iter1.filter(x => (x > i32(2)));
  result1 := filtered1.next();
  match(result1, .Some(v) => assert(v == i32(3), "a"), .None => assert(false, "b"));
  iter2 := CountIter(i32(7), i32(8));
  filtered2 := iter2.filter(x => true);
  result2 := filtered2.next();
  match(result2, .Some(v) => assert(v == i32(7), "c"), .None => assert(false, "d"));
  iter3 := CountIter(i32(0), i32(3));
  filtered3 := iter3.filter(x => false);
  result3 := filtered3.next();
  match(result3, .Some(_) => assert(false, "e"), .None => assert(true, "f"));
  ()
});
export(main);
