pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));
classify :: (fn(n : i32) -> i32)({
  if(n < i32(0), return(i32(45)));
  if(n == i32(0), return(i32(48)));
  i32(43)
});
main :: (fn() -> unit)({
  unsafe(_a := putchar(int(classify(i32(5)))));
  unsafe(_b := putchar(int(classify(i32(0)))));
});
export(main);
