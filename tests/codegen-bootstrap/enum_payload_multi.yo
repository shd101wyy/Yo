pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));
Pair :: enum(Empty, Two(a : i32, b : i32));
sum_pair :: (fn(p : Pair) -> i32)(
  match(p,.Empty => i32(0),.Two({ a, b }) => (a + b))
);
main :: (fn() -> unit)({
  unsafe(_x := putchar(int(sum_pair(Pair.Two(i32(30), i32(35))))));
});
export(main);
