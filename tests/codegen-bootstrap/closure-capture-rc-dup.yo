// Regression: an RC-typed value captured by a closure must be owned by the
// capture struct. The evaluator transfers each capture into it
// (evaluator/utils/closure.yo transfer_captured_variables: a value that needs
// a drop moves) and codegen emits the capture field initializers
// (codegen/exprs/closures.yo). When the capture owned nothing, dropping the
// constructing scope's local freed the value under the still-pending closure — Command.status's
// spawn storage was read after free (argc=0 → NULL argv[0] → the
// "Called unwrap on a None value" rc=134 abort that blocked `compile -o` /
// `test` in the self-compiled compiler).
{ Command, ExitStatus } :: import("std/process/command");
{ Exception, AnyError, IoExn } :: import("std/error");
import("std/string");
{ println } :: import("std/fmt");

main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  mut(cmd) := Command.new(`echo`);
  cmd = cmd.arg(`capture_ok`);
  st := io.await(cmd.status(io), IoExn(io : io, exn : exn));
  println(`rc=${st.code().unwrap_or(i32(-1))}`);
});
export(main);
