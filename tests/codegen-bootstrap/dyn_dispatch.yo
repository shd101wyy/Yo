pragma(Pragma.AllowUnsafe);
{ putchar } :: import("std/libc/stdio");
Speak :: trait(
  speak : (fn(self : &Self) -> i32)
);
Dog :: struct();
DogSpeak :: impl(
  Dog,
  Speak(
    speak : (
      (self : &Self) -> {
        return(i32(77));
      }
    )
  )
);
call_speak :: (fn(s : &Dyn(Speak)) -> i32)(s.speak());
main :: (fn() -> unit)({
  dog := Dog();
  (d : Box(Dyn(Speak))) = dyn(Box.new(dog));
  unsafe(_a := putchar(int(call_speak(&d.*))));
});
export(main);
