pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));
Color :: enum(Red, Green, Blue);
Shade :: enum(Light, Dark);
code :: (fn(c : Color, s : Shade) -> i32)(
  match(
    c,
    .Red => match(s,.Light => i32(82),.Dark => i32(114)),
    .Green => i32(71),
    .Blue => i32(66)
  )
);
main :: (fn() -> unit)({
  unsafe(_a := putchar(int(code(Color.Red, Shade.Dark))));
});
export(main);
