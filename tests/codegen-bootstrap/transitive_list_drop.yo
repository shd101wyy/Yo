{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");

// `Inner`'s `Drop` counts the instances dropped; main counts the ones made.
(mut(g_dropped) : i64) = i64(0);
(mut(g_made) : i64) = i64(0);
Inner :: ref(struct(x : i32, cyc : Option(Self)));
impl(
  Inner,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_dropped = (g_dropped + i64(1));
    })
  )
);
// Outer holds an ArrayList(Inner) as an RC field. Dropping Outer transitively
// frees the list, which must drop each Inner.
Outer :: ref(struct(items : ArrayList(Inner)));

main :: (fn() -> unit)({
  (mut(i) : i32) = i32(0);
  while(i < i32(50), {
    o := Outer(items : ArrayList(Inner).new());
    o.items.push(Inner(x : i, cyc : .None));
    o.items.push(Inner(x : i, cyc : .None));
    g_made = (g_made + i64(2));
    // `o` goes out of scope here → drop Outer → drop items list → drop each Inner
    i = (i + i32(1));
  });
  println(`transitive-list-drop live=${(g_made - g_dropped).to_string()}`);
});
export(main);
