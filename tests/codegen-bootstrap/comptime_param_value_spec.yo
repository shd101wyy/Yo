open(import("std/string"));
open(import("std/fmt"));
{ assert } :: import("std/assert");
{ Map } :: import("std/imm/map");

main :: (fn() -> unit)({
  m := Map(i32, i32).new();
  m = m.insert(i32(1), i32(100));
  assert(m.len() == usize(1), "len should be 1");
  assert(m.get(i32(1)).unwrap() == i32(100), "should get 100");
  println(`ok`);
});
export(main);
