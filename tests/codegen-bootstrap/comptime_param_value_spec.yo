import("std/string");
{ println } :: import("std/fmt");
{ assert } :: import("std/assert");
{ HashMap } :: import("std/collections/hash_map");

main :: (fn() -> unit)({
  m := HashMap(i32, i32).new();
  m.insert(i32(1), i32(100));
  assert(m.len() == usize(1), "len should be 1");
  assert(m.get(i32(1)).unwrap_or(i32(0)) == i32(100), "should get 100");
  println(`ok`);
});
export(main);
