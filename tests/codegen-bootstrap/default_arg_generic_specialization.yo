// Regression: an OMITTED `?= default` argument must flow through the call
// exactly like a supplied one — generic inference, param binding, C-argument
// emission, and specialization. yo-self's FuncVal call path skipped all of
// that for omitted params: bare `assert(x)` bound `msg` at the unresolved
// generic SomeT and the body's `panic(msg)` specialized (and was called) at an
// UNEMITTED SomeT-keyed C function ("call to undeclared function" from clang).
// See issues/yo-self-test-runner-remaining-bugs.md (Bug 1).
open(import("std/string"));
open(import("std/fmt"));
_(assert : assert) :: import("std/assert");
describe :: (fn(generic(T : Type), tag : String, (v : T) ?= "fallback", where(T <: ToString)) -> unit)({
  println(`${tag}: ${v.to_string()}`);
});
main :: (fn() -> unit)({
  x := 1;
  // The original repro: single-arg assert relies on the defaulted generic msg.
  assert(x == 1);
  // Omitted default on a user generic fn.
  describe(`omitted`);
  // Supplied arg must keep working alongside the omitted-case specialization.
  describe(`supplied`, `explicit`);
  println(`done`);
});
export(main);
