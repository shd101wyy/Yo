// A dyn closure capturing BOTH a local HashMap and the enclosing function's
// Impl(Fn) PARAM: the param must bind runtime (capturable), its capture-struct
// field must order after the captured closure's own capture struct, and the
// dyn-box specialization must collect (resolved_concrete carve-out).
{ println } :: import("std/fmt");
{ String } :: import("std/string");
{ HashMap } :: import("std/collections/hash_map");

Detector :: struct(detect : Dyn(FnMut(x : i32) -> unit));

run_detector :: (fn(d : &mut Detector, x : i32) -> unit)({
  (d.detect)(x);
});

analyze :: (
  fn(get_info : &Impl(Fn(e : i32) -> i32)) -> unit
)({
  // The map is a value (B9): the closure owns its captured copy, so it reads
  // the entry back itself. Writing the copy types the closure `FnMut`, whose
  // call borrows the closure exclusively — so the struct is lent `&mut` and
  // the binding is `mut` (an `Fn` closure may not write an implicit capture,
  // E0913, #1932).
  mut(extras) := HashMap(String, i32).new();
  mut(d) := Detector(
    detect : dyn(x => {
      extras.insert(`k${x}`, get_info(x));
      match(extras.get(String.from("k7")), .Some(v) => println(`${v}`), .None => println(`missing`));
    })
  );
  run_detector(&mut d, i32(7));
});

main :: (fn() -> unit)({
  analyze(e => (e * i32(3)));
});
export(main);
