open(import("std/fmt"));
open(import("std/string"));

f :: (fn(prev : String, key : String) -> bool)({
  (hit : bool) = false;
  if(!((prev == key) || (prev == String.from("!AMBIG"))), {
    hit = true;
  });
  hit
});

main :: (fn() -> unit)({
  a := `alpha`;
  b := `beta`;
  r1 := f(a, b);
  r2 := f(a, a);
  r3 := f(String.from("!AMBIG"), b);
  println(`${r1.to_string()} ${r2.to_string()} ${r3.to_string()}`);
});
export(main);
