pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));
Pair :: (fn(comptime(A) : Type, comptime(B) : Type) -> comptime(Type))(
  object(first : A, second : B)
);
impl(
  forall(A : Type, B : Type),
  Pair(A, B),
  first_val : (fn(self : Self) -> A)(self.first),
  second_val : (fn(self : Self) -> B)(self.second)
);
main :: (fn() -> unit)({
  p := Pair(i32, i32)(first : i32(72), second : i32(73));
  unsafe(_a := putchar(int(p.first_val())));
  unsafe(_b := putchar(int(p.second_val())));
});
export(main);
