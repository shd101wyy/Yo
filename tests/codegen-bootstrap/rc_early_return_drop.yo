{ ArrayList } :: import("std/collections/array_list");
{ println } :: import("std/fmt");
pick :: (fn(n : i32) -> i32)({
  xs := ArrayList(i32).new();
  xs.push(n);
  if(n > i32(5), {
    return(i32(100));
  });
  xs.push(i32(1));
  i32(xs.len())
});
main :: (fn() -> unit)({
  println(pick(i32(9)));
  println(pick(i32(2)));
});
export(main);
