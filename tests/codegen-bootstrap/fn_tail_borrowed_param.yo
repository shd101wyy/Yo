{ String } :: import("std/string");
{ println } :: import("std/fmt");

Item :: struct(name : String);
derive(Item, Clone);

pass :: (fn(e : &Item) -> Item)({
  (k : usize) = usize(1);
  k;
  e.clone()
});

main :: (fn() -> unit)({
  it := Item(name : String.from("alpha"));
  got := pass(&it);
  println(&got.name);
  println(&it.name);
});
export(main);
