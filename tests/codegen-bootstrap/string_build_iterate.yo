pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ putchar } :: import("std/libc/stdio");
main :: (fn() -> unit)({
  mut(s) := String.from("AB");
  s.push_byte(u8(67));
  mut(i) := usize(0);
  while(i < s.len(), i = (i + usize(1)), {
    unsafe(putchar(int(i32(s.byte_at(i)))));
  });
});
export(main);
