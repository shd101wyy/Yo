open(import("std/fmt"));
{ args } :: import("std/env");

main :: (fn() -> unit)({
  argv := args();
  if(argv.len() < usize(2), {
    println(`no arg`);
  }, {
    sub := argv(usize(1));
    if(sub == "hello", {
      println(`matched hello`);
    }, {
      println(`got '${sub}'`);
    });
  });
});
export(main);
