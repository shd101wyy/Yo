pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));
Wrap :: (fn(comptime(T) : Type) -> comptime(Type))(
  object(v : T)
);
impl(
  forall(T : Type),
  Wrap(T),
  add : (fn(self : Self, delta : i32) -> i32)((self.v) + delta)
);
main :: (fn() -> unit)({
  w := Wrap(i32)(v : i32(60));
  unsafe(_a := putchar(int(w.add(i32(5)))));
});
export(main);
