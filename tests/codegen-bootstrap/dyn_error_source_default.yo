// Dyn(Error) over a type that inherits the `Error.source ?= (self) -> .None`
// default WITHOUT overriding it. The trait default is GENERIC over `Self`
// (typed `fn(inout(self):Self) -> Option(Dyn(SelfTrait))`); it must be
// MONOMORPHIZED to the concrete receiver when building the dyn vtable's trait
// values, else codegen skips its generic body and the dyn wrapper
// `__yo_wrap_..._source` references an undeclared `fn_..._source`. Regression
// for the stage-2 Error.source cluster: `_monomorphize_default_fv` in
// evaluator/values/dyn.yo specializes the default whether it is found via the
// type-trait-method registry (impl.yo fills the raw default there) or via the
// get_trait_default fall-through.
pragma(Pragma.AllowUnsafe);
open(import("std/error"));
open(import("std/string"));
open(import("std/libc/stdio"));

check_no_source :: (fn(e : AnyError) -> i32)(
  match(e.source(), .Some(_) => i32(1), .None => i32(81))
);

main :: (fn() -> unit)({
  s := `oops`;
  (boxed : AnyError) = dyn(s);
  unsafe(_a := putchar(int(check_no_source(boxed)))); // .None → 81 = 'Q'
});
export(main);
