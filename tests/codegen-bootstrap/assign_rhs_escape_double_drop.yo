// Regression (round 4 of the stage-2 double-free hunt): in a reassignment
// `x = f(x)` whose RHS can escape (exn.throw → unwind), the emitted escape
// block must NOT drop the save-old-value temp — the temp is a plain alias
// that receives ownership of the old value only when the assignment
// completes; on escape the LOCAL still owns it and its scope drop covers it.
// yo-self's codegen dropped BOTH (the local via the scope list AND the save
// temp via the pending list), over-dropping the old value once per throw —
// the deterministic `s2 check` rc=138/139 UAF (comptime-fold iterations of
// `v :: variants.get(vi)` in the derive machinery accumulated the deficit
// until the AST node freed). TS's escape lists drop only the local. Fixed
// via FunctionGenerationContext.current_assignment_save_temp. See
// issues/fixed/yo-self-dyn-throw-double-drop.md. Expected output: "done live=0".
{ println } :: import("std/fmt");
{ String } :: import("std/string");
{ Exception } :: import("std/error");
// A ref struct counted when made and when dropped: an over-drop of the old
// value would drop it twice.
(mut(g_dropped) : i64) = i64(0);
(mut(g_made) : i64) = i64(0);
Node :: ref(struct(v : i32, next : Option(Self)));
impl(
  Node,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_dropped = (g_dropped + i64(1));
    })
  )
);
make_node :: (fn(v : i32) -> Node)({
  g_made = (g_made + i64(1));
  Node(v : v, next : .None)
});
// Throws before producing a value — the caller's reassignment never
// completes, so the old value must be dropped exactly once (the local's
// scope drop), not also via the save temp.
replace_or_throw :: (fn(old : &Node, exn : Exception) -> Node)({
  exn.throw(dyn(String.from("no replacement available")));
  old
});
run_once :: (fn(i : i32) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  (mut(cur) : Node) = make_node(i);
  cur = replace_or_throw(&cur, exn);
  cur;
});
main :: (fn() -> unit)({
  (mut(j) : i32) = i32(0);
  while(j < i32(50), {
    run_once(j);
    j = (j + i32(1));
  });
  println(`done live=${(g_made - g_dropped).to_string()}`);
});
export(main);
