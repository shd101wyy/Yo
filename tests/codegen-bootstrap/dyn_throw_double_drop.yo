// Regression: `dyn(payload)` takes OWNERSHIP of its payload. The self-hosted
// evaluator (src/evaluator/values/dyn.yo) must call
// `set_expr_as_needs_to_call_dup` on the final inner value expr — mirroring TS
// setExprAsNeedsToCallDup(finalValueExpr) (src/evaluator/values/dyn.ts:321) —
// so an OWNING payload temp is marked consumed (its scope/escape drop
// suppressed; the dyn's own `.data` drop is the single owner) and a BORROWED
// source gets a deferred dup. Without it, every
// `exn.throw(dyn(make_err(...)))` double-dropped the payload (the pre-existing
// stage-2 startup heap corruption). See
// issues/fixed/yo-self-dyn-throw-double-drop.md. Expected output: "done live=0".
{ ToString, println } :: import("std/fmt");
{ String } :: import("std/string");
{ Error, Exception } :: import("std/error");
// A ref-struct error, counted when made and when dropped, built by a helper
// call — the format_error_message analog. The dyn(make_err(...)) consumes the
// fresh call result; the escape path after exn.throw must NOT also drop it.
(mut(g_dropped) : i64) = i64(0);
(mut(g_made) : i64) = i64(0);
ErrObj :: struct(msg : String, next : Option(Rc(Self)));
impl(
  ErrObj,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_dropped = (g_dropped + i64(1));
    })
  )
);
impl(
  ErrObj,
  ToString(to_string : (self -> self.msg.clone()))
);
impl(ErrObj, Error());
impl(
  ErrObj,
  Clone(
    clone : (fn(self : &Self) -> Self)({
      g_made = (g_made + i64(1));
      ErrObj(msg : self.msg.clone(), next : self.next.clone())
    })
  )
);
make_err :: (fn(m : &String) -> ErrObj)({
  g_made = (g_made + i64(1));
  ErrObj(msg : m.clone(), next : .None)
});
fail_op :: (fn(x : i32, exn : Exception) -> i32)({
  // extra RC locals so the escape drop list is populated
  note := String.from("context note");
  cond(
    (x == i32(0)) => exn.throw(dyn(make_err(`bad input: ${note}`))),
    true => (x + i32(1))
  )
});
run_once :: (fn(i : i32) -> unit)({
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  r := fail_op(i32(0), exn);
  r;
});
main :: (fn() -> unit)({
  (mut(j) : i32) = i32(0);
  while(j < i32(50), {
    run_once(j);
    j = (j + i32(1));
  });
  println(`done live=${(g_made - g_dropped).to_string()}`);
});
export(main);
