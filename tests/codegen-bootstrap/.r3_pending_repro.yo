open(import("std/fmt"));
open(import("std/string"));
Gc :: import("std/gc");
// Round-2 repro attempt 2: mimic evaluate_function_parameter's aliasing shape
// (function.yo:740): an OWNING local reassigned from a match-arm payload
// (Option unwrap) — if yo-self codegen emits no dup for the payload,
// the local's scope drop steals the container's reference → child freed
// while the parent still holds it (the s2 args.get(1) UAF).
Node :: ref(struct(tag : i32, kids : Option(Self)));
probe :: (fn(parent : Node) -> i32)({
  (cur : Node) = parent;
  opt := cur.kids;
  match(
    opt,
    .Some(child) => {
      cur = child;
    },
    .None => ()
  );
  cur.tag
});
main :: (fn() -> unit)({
  root := Node(tag : i32(1), kids :.Some(Node(tag : i32(2), kids :.None)));
  (j : i32) = i32(0);
  (acc : i32) = i32(0);
  while(j < i32(30), {
    acc = (acc + probe(root));
    j = (j + i32(1));
  });
  k := match(root.kids,.Some(c) => c.tag,.None => (-(i32(1))));
  println(`done acc=${acc} k=${k} tracked=${Gc.tracked_count()}`);
});
export(main);
