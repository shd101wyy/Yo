// Dyn dispatch over an explicitly-boxed VALUE struct: `dyn(rc(Sq))`. The dyn
// payload's runtime type is `Rc(Sq)` but the trait impl is on the underlying
// `Sq`, so codegen must:
//   - recognise `Rc(Sq)` as a box (is_boxed_type — needs the `Rc(...)` name
//     stamped on the instantiation),
//   - resolve trait methods on the UNDERLYING `Sq`, emitting the unbox wrapper
//     `(Rc(Sq)*)self_ptr -> &box->* -> Sq.area`,
//   - key the impl/vtable/dyn-box on the unwrapped concrete `Sq` (not `Rc(Sq)`).
pragma(Pragma.AllowUnsafe);
{ putchar } :: import("std/libc/stdio");
Shape :: trait(
  area : (fn(imm(self) : *Self) -> i32)
);
Sq :: struct(s : i32);
SqShape :: impl(
  Sq,
  Shape(
    area : (fn(self : *Self) -> i32)(self.s * self.s)
  )
);
use_shape :: (fn(imm(sh) : Dyn(Shape)) -> i32)(sh.area());
main :: (fn() -> unit)({
  unsafe(_a := putchar(int(use_shape(dyn(rc(Sq(9))))))); // 9*9 = 81 = 'Q'
});
export(main);
