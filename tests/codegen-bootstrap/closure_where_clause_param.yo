import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");

apply_each :: (
  fn(
    generic(A : Type, F : Type),
    items : &ArrayList(A),
    f : &mut F,
    where(F <: (FnMut(item : &A) -> unit))
  ) -> unit
)({
  (mut(i) : usize) = usize(0);
  while(i < items.len(), {
    match(items.get(i), .Some(v) => f(&v), .None => ());
    i = (i + usize(1));
  });
});

main :: (fn() -> unit)({
  mut(out) := ArrayList(i32).new();
  src := ArrayList(i32).from([i32(1), i32(2), i32(3)]);
  // `out` is a value: the body writes it through a `&mut` capture. An
  // implicit capture would push onto the closure's copy
  // (issues/fixed/2026-10-23-an-fn-closure-that-reassigns-a-capture-releases-the-old-value-twice.md).
  apply_each(&src, { &mut out }(x) => {
    out.push(x.*);
  });
  assert(out.len() == usize(3), "len 3");
  println(`ok`);
});
export(main);
