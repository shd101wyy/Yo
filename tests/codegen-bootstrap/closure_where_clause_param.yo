import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ assert } :: import("std/assert");

apply_each :: (
  fn(
    generic(A : Type, F : Type),
    items : &ArrayList(A),
    f : &F,
    where(F <: (Fn(item : &A) -> unit))
  ) -> unit
)({
  (mut(i) : usize) = usize(0);
  while(i < items.len(), {
    match(items.get(i), .Some(v) => f(&v), .None => ());
    i = (i + usize(1));
  });
});

main :: (fn() -> unit)({
  out := ArrayList(i32).new();
  src := ArrayList(i32).from([i32(1), i32(2), i32(3)]);
  apply_each(&src, x => {
    out.push(x);
  });
  assert(out.len() == usize(3), "len 3");
  println(`ok`);
});
export(main);
