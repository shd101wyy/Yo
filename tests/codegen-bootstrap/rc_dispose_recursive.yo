// Regression: freeing an RC struct must recursively drop an RC value held only
// through a VALUE-ENUM field — `next : Option(Self)`. This is the p4 case from
// plans/archive/YO_SELF_RC_EMISSION_LAYER.md §10: `b := N(5, Some(a))` moves `a` into
// `b.next`; when `b` is dropped at scope end, its auto-derived `___dispose` must
// drop `b.next` (an `Option(N)`), whose per-variant drop must in turn decrement
// the inner `N` — else `a` leaks. Exercises both halves of the fix: the struct
// `___dispose` synthesis AND the INLINE value-enum per-variant drop. `N`'s
// `Drop` counts the nodes dropped: both, or `a` leaked. Since V5 part B `N`
// is a value and the chain owns its next node through a `Box`.
pragma(Pragma.AllowUnsafe);
{ printf } :: import("std/libc/stdio.yo");
(mut(g_dropped) : i64) = i64(0);
N :: struct(v : i32, next : Option(Box(Self)));
impl(
  N,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_dropped = (g_dropped + i64(1));
    })
  )
);
build_and_drop :: (fn() -> unit)({
  a := N(4, Option(Box(N)).None);
  b := N(5, Option(Box(N)).Some(Box.new(a))); // a moved into b.next
  (); // a + b dropped at scope end; dropping b must recurse into b.next -> a
});
main :: (fn() -> unit)({
  build_and_drop();
  if(g_dropped == i64(2), {
    unsafe(printf("recursive dispose freed all\n"));
  }, {
    unsafe(printf("recursive dispose leaked\n"));
  });
});
export(main);
