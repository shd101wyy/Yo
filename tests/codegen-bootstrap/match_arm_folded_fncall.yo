pragma(Pragma.AllowUnsafe);
{ putchar } :: import("std/libc/stdio");
mk :: (fn(b : bool) -> Option(i32))(cond(b => .Some(i32(7)), true => .None));
main :: (fn() -> unit)({
  o := mk(true);
  v := match(o, .Some(x) => x, .None => i32(0));
  unsafe(putchar(int(i32(usize(48)) + v)));
});
export(main);
