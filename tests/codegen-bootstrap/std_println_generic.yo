//! Generic ToString-bound print/println specialization end-to-end (Gap 6).
//! Exercises str.to_string + as_bytes + ptr().unwrap() + fwrite + the trailing
//! newline byte-cast — the whole generic-fn monomorphization + method-dispatch
//! + extern-call chain for std/fmt over `str` arguments.
{ print, println } :: import("std/fmt");
main :: (fn() -> unit)({
  print("ab");
  println("cd");
  println("ef");
});
export(main);
