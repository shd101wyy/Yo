//! Generic ToString-bound print/println specialization end-to-end (Gap 6).
//! Exercises str.to_string + as_bytes + ptr().unwrap() + fwrite + the trailing
//! newline byte-cast in println — the whole generic-fn monomorphization +
//! method-dispatch + extern-call chain for std/fmt over a `str` argument.
{ print, println } :: import("std/fmt");
main :: (fn() -> unit)({
  print("ab");
  println("cd");
});
export(main);
