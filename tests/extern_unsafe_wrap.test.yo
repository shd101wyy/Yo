{ assert } :: import("std/assert");
/// plans/archive/EXTERN_UNSAFE_WRAP.md — extern "c" call sites must be
/// wrapped in `unsafe(...)` even in privileged files.
///
/// The pragma authorizes DECLARING the extern symbol; the wrap is
/// the per-call audit marker so `yo unsafe-report` can pinpoint the
/// UB-capable lines.
pragma(Pragma.AllowUnsafe);
{ strlen } :: import("std/libc/string");
// ── Negative: unwrapped extern call is rejected even in a pragma'd file.
comptime_expect_error(
  bad_unwrapped :: (fn(s : *char) -> usize)(strlen(s))
);
// ── Positive: a Yo wrapper whose BODY wraps the extern is itself
//             callable without `unsafe(...)` at the caller. The wrap
//             obligation belongs to the body-author, not the caller.
yo_strlen :: (fn(s : *char) -> usize)(unsafe(strlen(s)));
test("call-site wrap: stdlib wrappers don't propagate the unsafe requirement", {
  cstr := (*char)("hello");
  // No `unsafe(...)` needed at this call site — `yo_strlen`'s body
  // already wrapped its own extern call.
  n := yo_strlen(cstr);
  assert(n == usize(5), "yo_strlen returns the expected length");
});
test("call-site wrap: direct extern call works inside unsafe(...)", {
  cstr := (*char)("world!");
  n := unsafe(strlen(cstr));
  assert(n == usize(6), "wrapped strlen returns the expected length");
});
// ── Definition order: an `extern(...)` block declared BELOW a function that
//    calls one of its members. `::` definitions have been order-independent
//    since plans/reference/LAZY_TOPLEVEL_BINDINGS.md landed, but an extern
//    member was not a pending binding, so this was
//    `E0401 Variable "__yo_thread_self" not found`
//    (issues/fixed/extern-declarations-are-not-forward-referenceable.md).
thread_id_via_forward_extern :: (fn() -> usize)(__yo_thread_self());
extern(
  "Yo",
  __yo_thread_self : (fn() -> usize)
);
test("definition order: a function may call an extern member declared below it", {
  first := thread_id_via_forward_extern();
  second := __yo_thread_self();
  assert(first == second, "the forward-referenced extern member is the same symbol");
});
// ── Two externs, one signature. The codegen registry that collects extern
//    symbols for prototype emission was keyed by the TYPE KEY, so `toupper`
//    and `tolower` — identical `(fn(i32) -> i32)` types — collided and only
//    the second one's prototype was emitted. The first was then called with
//    no declaration at all, which clang rejects at -O0
//    ("call to undeclared library function 'toupper'") and silently accepted
//    at -O2 (issues/fixed/two-externs-of-one-signature-emit-one-prototype.md).
extern("c", toupper : (fn(c : i32) -> i32));
extern("c", tolower : (fn(c : i32) -> i32));
test("two externs with the same signature both get a prototype", {
  upper := unsafe(toupper(i32(97)));
  lower := unsafe(tolower(i32(66)));
  assert(upper == i32(65), "toupper('a') is 'A'");
  assert(lower == i32(98), "tolower('B') is 'b'");
});
