pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/libc/stdio.yo"));
Id :: trait(
  id : (fn(self : Self) -> Self)
);
RetI32 :: trait(
  return_i32 : (fn(self : *(Self)) -> i32)
);
use_id :: (
  fn(
    forall(T : Type),
    value : T,
    where(T <: Id)
  ) -> T
)({
  // (T <: Id).id(value);
  return(value.id());
});
impl(
  i32,
  Id(
    id : (
      (self) -> {
        unsafe(printf("i32 value: %d\n", self));
        return(self);
      }
    )
  )
);
impl(
  i32,
  RetI32(
    return_i32 : (
      (self) -> {
        return(self.*);
      }
    )
  )
);
impl(
  bool,
  Id(
    id : (
      (self) -> {
        cond(
          self => unsafe(printf("bool value: true\n")),
          true => unsafe(printf("bool value: false\n"))
        );
        return(self);
      }
    )
  )
);
impl(
  bool,
  RetI32(
    return_i32 : (
      (self) ->
        cond(
          self.* => 1,
          true => return(0)
        )
    )
  )
);
impl(
  Box(i32),
  Id(
    id : (
      (self) -> {
        unsafe(printf("Boxed i32 value: %d\n", self.*));
        return(self);
      }
    )
  )
);
impl(
  Box(i32),
  RetI32(
    // Let's x2 here
    return_i32 : (
      (self) -> {
        return(self.*.* + (self.*.*));
      }
    )
  )
);
ret_boolean_i32 :: (fn() -> Impl(RetI32))({
  return(true);
});
ret_i32_i32 :: (fn() -> Impl(RetI32))({
  return(i32(123));
});
ret_boxi32_i32 :: (fn() -> Impl(RetI32))({
  return(Box(i32)(456));
});
test("Test impl for i32, bool, Box(i32)", {
  i := 42;
  t := true;
  f := false;
  bi := Box(i32)(100);
  assert(use_id(i) == i, "use_id should return the same i32 value");
  assert(use_id(t) == t, "use_id should return the same bool value");
  assert(use_id(f) == f, "use_id should return the same bool value");
  bi_ret := use_id(bi);
  assert(bi_ret.* == bi.*, "use_id should return the same Boxed i32 value");
  assert(use_id(bi).* == bi.*, "use_id should return the same Boxed i32 value");
});
test("Test fn return Impl that expects error", {
  comptime_expect_error(
    test_fn :: (fn(some_cond : bool) -> Impl(Id))({
      cond(
        some_cond => {
          return(12);
        },
        true => {
          return(false);
        }
      );
    })
  );
  comptime_expect_error(
    test_fn2 :: (fn(color : Color) -> Impl(Id))({
      match(
        color,
        .Red => {
          return(1);
        },
        .Green => {
          return(true);
        },
        .Blue => {
          return(Box(i32));
        }
      );
    })
  );
  comptime_expect_error(
    test_fn3 :: (fn(some_cond : bool) -> Impl(Id))({
      cond(
        some_cond => {
          {
            {
              return(12);
            };
          };
        },
        true => {
          return(false);
        }
      );
    })
  );
  comptime_expect_error(
    test_fn4 :: (fn(flag : bool) -> Impl(RetI32))({
      cond(
        flag => {
          return(i32(100));
        },
        true => ()
      );
      return(true);
    })
  );
});
test("Test function that returns Impl", {
  b := ret_boolean_i32();
  assert(b.return_i32() == 1, "Expected true from ret_boolean_i32");
  assert(ret_i32_i32().return_i32() == i32(123), "Expected 123 from ret_i32_i32");
  r := ret_boxi32_i32();
  assert(&(r).return_i32() == i32(912), "Expected 912 from ret_boxi32_i32");
});
// Trait method disambiguation with where-clause constraints
// When a type implements multiple traits with identically-named methods,
// where(T <: Trait) should constrain method lookup to only the specified trait.
TraitDisambigA :: trait(
  get_number : (fn(self : Self) -> i32)
);
TraitDisambigB :: trait(
  get_number : (fn(self : Self) -> i32)
);
DisambigPoint :: struct(x : i32, y : i32);
impl(
  DisambigPoint,
  TraitDisambigA(
    get_number : (self -> self.x)
  )
);
impl(
  DisambigPoint,
  TraitDisambigB(
    get_number : (self -> self.y)
  )
);
use_trait_a :: (fn(forall(T : Type), self : T, where(T <: TraitDisambigA)) -> i32)({
  return(self.get_number());
});
use_trait_b :: (fn(forall(T : Type), self : T, where(T <: TraitDisambigB)) -> i32)({
  return(self.get_number());
});
use_trait_b_explicit :: (fn(forall(T : Type), self : T, where(T <: TraitDisambigB)) -> i32)({
  return((T <: TraitDisambigB).get_number(self));
});
test("Test trait method disambiguation with where-clause constraints", {
  p := DisambigPoint(10, 20);
  assert(use_trait_a(p) == 10, "use_trait_a should dispatch to TraitDisambigA.get_number (returns x)");
  assert(use_trait_b(p) == 20, "use_trait_b should dispatch to TraitDisambigB.get_number (returns y)");
  assert(use_trait_b_explicit(p) == 20, "use_trait_b_explicit should dispatch to TraitDisambigB.get_number (returns y)");
});
// Regression: issues/fixed/heterogeneous-eq-overload-dispatch.md.
// A second same-name trait-method overload from a PARAMETRIC trait
// (Eq(str) beside Eq(HeteroEqW)) whose impl annotation names a
// module-scope type ("str"). The registered method's specializedType used
// to carry the impl's parameter type exprs with the TRAIT definition's env,
// so call-site re-evaluation of `other : str` failed with
// "Variable str not found" and the heterogeneous overload never dispatched.
// Also exercises the trait's `?=` default for (!=) picking the right
// overload by argument types.
HeteroEqW :: struct(v : i32);
impl(
  HeteroEqW,
  Eq(HeteroEqW)(
    (==) : (fn(self : Self, other : Self) -> bool)(self.v == other.v)
  )
);
impl(
  HeteroEqW,
  Eq(str)(
    (==) : (fn(self : Self, other : str) -> bool)(other.len() == usize(3))
  )
);
hetero_eq_str :: (fn(w : HeteroEqW) -> bool)(w == "abc");
test("Test heterogeneous trait-method overload dispatch (Eq(str) beside Eq(Self))", {
  a := HeteroEqW(v : i32(1));
  b := HeteroEqW(v : i32(1));
  c := HeteroEqW(v : i32(2));
  assert(a == b, "homogeneous (==) overload");
  assert(a != c, "homogeneous (!=) via the trait ?= default");
  assert(hetero_eq_str(a), "heterogeneous (==) overload from a fn body");
  assert(a == "xyz", "heterogeneous (==) overload at a direct call site");
  assert(a != "abcd", "heterogeneous (!=) via the trait ?= default");
});
// Inherent-first resolution (plans/OVERLOADING_REDESIGN.md §6,
// issues/yo-inherent-first-resolution.md): `DelegateV` has an inherent
// `pick(DelegateV)` AND a `DelegatePickStr.pick(str)`. A type (inherent) method
// SHADOWS a same-name trait method, so `v.pick("s")` (str matches only the trait)
// must ERROR — resolution does NOT fall through to the trait. The trait body
// `self.pick(self)` still delegates fine (its `DelegateV` arg matches the inherent).
// (This replaces the old overload-resolution behavior that the §4 redesign removed —
// the same pattern std's former `StrPattern` impl relied on.)
DelegateV :: struct(n : i32);
DelegatePickStr :: trait(
  pick : (fn(self : Self, x : str) -> i32)
);
impl(
  DelegateV,
  pick : (fn(self : Self, x : DelegateV) -> i32)(i32(1))
);
impl(
  DelegateV,
  DelegatePickStr(
    // Delegates to the inherent same-name overload (String/str-style pattern
    // used by std's StrPattern impl on String).
    pick : (fn(self : Self, x : str) -> i32)(self.pick(self) + i32(1))
  )
);
test("Test inherent method shadows a same-name trait method (inherent-first)", {
  v := DelegateV(n : i32(0));
  assert(v.pick(v) == i32(1), "inherent overload selected for a matching arg");
  // Inherent-first: `v.pick("s")` selects the inherent `pick(DelegateV)`; `str` does
  // not match it, and resolution must NOT fall through to `DelegatePickStr.pick(str)`.
  comptime_expect_error(v.pick("s"));
});
