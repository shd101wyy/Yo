pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ printf } :: import("std/libc/stdio.yo");
Id :: trait(
  id : (fn(imm(self) : Self) -> Self)
);
RetI32 :: trait(
  return_i32 : (fn(imm(self) : *Self) -> i32)
);
use_id :: (
  fn(
    generic(T : Type),
    imm(value) : T,
    where(T <: Id)
  ) -> T
)({
  // (T <: Id).id(value);
  return(value.id());
});
impl(
  i32,
  Id(
    id : (
      self -> {
        unsafe(printf("i32 value: %d\n", self));
        return(self);
      }
    )
  )
);
impl(
  i32,
  RetI32(
    return_i32 : (
      self -> {
        return(self.*);
      }
    )
  )
);
impl(
  bool,
  Id(
    id : (
      self -> {
        cond(
          self => unsafe(printf("bool value: true\n")),
          true => unsafe(printf("bool value: false\n"))
        );
        return(self);
      }
    )
  )
);
impl(
  bool,
  RetI32(
    return_i32 : (
      self ->
        cond(
          self.* => 1,
          true => return(0)
        )
    )
  )
);
impl(
  Rc(i32),
  Id(
    id : (
      self -> {
        unsafe(printf("Boxed i32 value: %d\n", self.*));
        return(self);
      }
    )
  )
);
impl(
  Rc(i32),
  RetI32(
    // Let's x2 here
    return_i32 : (
      self -> {
        return(self.*.* + (self.*.*));
      }
    )
  )
);
ret_boolean_i32 :: (fn() -> Impl(RetI32))({
  return(true);
});
ret_i32_i32 :: (fn() -> Impl(RetI32))({
  return(i32(123));
});
ret_boxi32_i32 :: (fn() -> Impl(RetI32))({
  return(Rc(i32)(456));
});
test("Test impl for i32, bool, Rc(i32)", {
  i := 42;
  t := true;
  f := false;
  bi := Rc(i32)(100);
  assert(use_id(i) == i, "use_id should return the same i32 value");
  assert(use_id(t) == t, "use_id should return the same bool value");
  assert(use_id(f) == f, "use_id should return the same bool value");
  bi_ret := use_id(bi);
  assert(bi_ret.* == bi.*, "use_id should return the same Boxed i32 value");
  assert(use_id(bi).* == bi.*, "use_id should return the same Boxed i32 value");
});
test("Test fn return Impl that expects error", {
  comptime_expect_error(
    test_fn :: (fn(some_cond : bool) -> Impl(Id))({
      cond(
        some_cond => {
          return(12);
        },
        true => {
          return(false);
        }
      );
    })
  );
  comptime_expect_error(
    test_fn2 :: (fn(color : Color) -> Impl(Id))({
      match(
        color,
        .Red => {
          return(1);
        },
        .Green => {
          return(true);
        },
        .Blue => {
          return(Rc(i32));
        }
      );
    })
  );
  comptime_expect_error(
    test_fn3 :: (fn(some_cond : bool) -> Impl(Id))({
      cond(
        some_cond => {
          {
            {
              return(12);
            };
          };
        },
        true => {
          return(false);
        }
      );
    })
  );
  comptime_expect_error(
    test_fn4 :: (fn(flag : bool) -> Impl(RetI32))({
      cond(
        flag => {
          return(i32(100));
        },
        true => ()
      );
      return(true);
    })
  );
});
test("Test function that returns Impl", {
  b := ret_boolean_i32();
  assert(b.return_i32() == 1, "Expected true from ret_boolean_i32");
  assert(ret_i32_i32().return_i32() == i32(123), "Expected 123 from ret_i32_i32");
  r := ret_boxi32_i32();
  assert(addr_of(r).return_i32() == i32(912), "Expected 912 from ret_boxi32_i32");
});
// Trait method disambiguation with where-clause constraints
// When a type implements multiple traits with identically-named methods,
// where(T <: Trait) should constrain method lookup to only the specified trait.
TraitDisambigA :: trait(
  get_number : (fn(imm(self) : Self) -> i32)
);
TraitDisambigB :: trait(
  get_number : (fn(imm(self) : Self) -> i32)
);
DisambigPoint :: struct(x : i32, y : i32);
impl(
  DisambigPoint,
  TraitDisambigA(
    get_number : (self -> self.x)
  )
);
impl(
  DisambigPoint,
  TraitDisambigB(
    get_number : (self -> self.y)
  )
);
use_trait_a :: (fn(generic(T : Type), imm(self) : T, where(T <: TraitDisambigA)) -> i32)({
  return(self.get_number());
});
use_trait_b :: (fn(generic(T : Type), imm(self) : T, where(T <: TraitDisambigB)) -> i32)({
  return(self.get_number());
});
use_trait_b_explicit :: (fn(generic(T : Type), imm(self) : T, where(T <: TraitDisambigB)) -> i32)({
  return((T <: TraitDisambigB).get_number(self));
});
test("Test trait method disambiguation with where-clause constraints", {
  p := DisambigPoint(10, 20);
  assert(use_trait_a(p) == 10, "use_trait_a should dispatch to TraitDisambigA.get_number (returns x)");
  assert(use_trait_b(p) == 20, "use_trait_b should dispatch to TraitDisambigB.get_number (returns y)");
  assert(use_trait_b_explicit(p) == 20, "use_trait_b_explicit should dispatch to TraitDisambigB.get_number (returns y)");
});
// Regression: issues/fixed/heterogeneous-eq-overload-dispatch.md.
// A second same-name trait-method overload from a PARAMETRIC trait
// (Eq(str) beside Eq(HeteroEqW)) whose impl annotation names a
// module-scope type ("str"). The registered method's specializedType used
// to carry the impl's parameter type exprs with the TRAIT definition's env,
// so call-site re-evaluation of `other : str` failed with
// "Variable str not found" and the heterogeneous overload never dispatched.
// Also exercises the trait's `?=` default for (!=) picking the right
// overload by argument types.
HeteroEqW :: struct(v : i32);
derive(HeteroEqW, Copy, Clone);
impl(
  HeteroEqW,
  Eq(HeteroEqW)(
    (==) : (fn(imm(self) : Self, imm(other) : Self) -> bool)(self.v == other.v)
  )
);
impl(
  HeteroEqW,
  Eq(str)(
    (==) : (fn(imm(self) : Self, imm(other) : str) -> bool)(other.len() == usize(3))
  )
);
hetero_eq_str :: (fn(w : HeteroEqW) -> bool)(w == "abc");
test("Test heterogeneous trait-method overload dispatch (Eq(str) beside Eq(Self))", {
  a := HeteroEqW(v : i32(1));
  b := HeteroEqW(v : i32(1));
  c := HeteroEqW(v : i32(2));
  assert(a == b, "homogeneous (==) overload");
  assert(a != c, "homogeneous (!=) via the trait ?= default");
  assert(hetero_eq_str(a), "heterogeneous (==) overload from a fn body");
  assert(a == "xyz", "heterogeneous (==) overload at a direct call site");
  assert(a != "abcd", "heterogeneous (!=) via the trait ?= default");
});
// Inherent-first resolution (plans/backlog/OVERLOADING_REDESIGN.md §6,
// issues/fixed/yo-inherent-first-resolution.md): `DelegateV` has an inherent
// `pick(DelegateV)` AND a `DelegatePickStr.pick(str)`. A type (inherent) method
// SHADOWS a same-name trait method, so `v.pick("s")` (str matches only the trait)
// must ERROR — resolution does NOT fall through to the trait. The trait body
// `self.pick(self)` still delegates fine (its `DelegateV` arg matches the inherent).
// (This replaces the old overload-resolution behavior that the §4 redesign removed —
// the same pattern std's former `StrPattern` impl relied on.)
DelegateV :: struct(n : i32);
derive(DelegateV, Copy, Clone);
DelegatePickStr :: trait(
  pick : (fn(imm(self) : Self, x : str) -> i32)
);
impl(
  DelegateV,
  pick : (fn(self : Self, x : DelegateV) -> i32)(i32(1))
);
impl(
  DelegateV,
  DelegatePickStr(
    // Delegates to the inherent same-name overload (String/str-style pattern
    // used by std's StrPattern impl on String).
    pick : (fn(self : Self, x : str) -> i32)(self.pick(self) + i32(1))
  )
);
test("Test inherent method shadows a same-name trait method (inherent-first)", {
  v := DelegateV(n : i32(0));
  assert(v.pick(v) == i32(1), "inherent overload selected for a matching arg");
  // Inherent-first: `v.pick("s")` selects the inherent `pick(DelegateV)`; `str` does
  // not match it, and resolution must NOT fall through to `DelegatePickStr.pick(str)`.
  comptime_expect_error(v.pick("s"));
});
// Duplicate INHERENT method impls are rejected (plans/reference/FUNCTION_OVERLOADING_POLICY.md,
// issues/fixed/duplicate-inherent-method-impls-not-rejected.md): a second
// `impl(T, m : ...)` for the same (type, name) from a different source site is
// an error — before the gate the first silently won (identical signature) or
// both dispatched by arity. Trait-provided names (arm above) stay legal.
test("Test duplicate inherent method impl is rejected (same signature)", {
  comptime_expect_error({
    DupSameSig :: struct(x : i32);
    impl(DupSameSig, get : (fn(imm(self) : Self) -> i32)(self.x));
    impl(DupSameSig, get : (fn(self : Self) -> i32)(self.x + i32(1)));
    ()
  });
});
test("Test duplicate inherent method impl is rejected (different arity)", {
  comptime_expect_error({
    DupArity :: struct(x : i32);
    impl(DupArity, get : (fn(imm(self) : Self) -> i32)(self.x));
    impl(DupArity, get : (fn(self : Self, y : i32) -> i32)(self.x + y));
    ()
  });
});
// A generic impl registering the same method PER INSTANTIATION replays the
// same defining site — that must stay legal (the loader's idempotent
// re-registration works the same way).
GenBox :: (fn(comptime(T) : Type) -> comptime(Type))(struct(v : T));
derive(generic(T : Type), where(T <: Clone), GenBox(T), Clone);
derive(generic(T : Type), where(T <: Copy), GenBox(T), Copy);
impl(
  generic(T : Type),
  GenBox(T),
  first : (fn(imm(self) : Self) -> T)(self.v)
);
test("Test generic impl instantiated twice registers cleanly", {
  a := GenBox(i32)(v : i32(7));
  b := GenBox(bool)(v : true);
  assert(a.first() == i32(7), "GenBox(i32) instantiation");
  assert(b.first() == true, "GenBox(bool) instantiation");
});
// ============================================================
// `(T <: Trait).static_method()` binds Self to T, not to the trait
// ============================================================
// A generic impl's STATIC (no-`self`) trait method whose body constructs via
// `Self(...)` used to fail under the explicit-dispatch form with "Receiver type
// is undefined when implementing trait": the dot-receiver evaluated to the
// TRAIT, so `Self` bound to the trait and `Self(field : ...)` read as a trait
// IMPLEMENTATION. The plain `T.method()` form was always fine, which is what
// isolated it. issues/fixed/subtype-dispatch-binds-self-to-the-trait.md
SdBox :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(value : T)
);
derive(generic(T : Type), where(T <: Clone), SdBox(T), Clone);
derive(generic(T : Type), where(T <: Copy), SdBox(T), Copy);
SdMake :: trait(
  sd_make : (fn() -> Self)
);
impl(
  generic(T : Type),
  where(T <: Default),
  SdBox(T),
  SdMake(sd_make : (fn() -> Self)(Self(value : (T <: Default).default())))
);
test("explicit `<:` dispatch of a generic static binds Self to the receiver", {
  a := (SdBox(i32) <: SdMake).sd_make();
  assert(a.value == i32(0), "i32 instantiation through the <: form");
  b := (SdBox(bool) <: SdMake).sd_make();
  assert(b.value == false, "bool instantiation resolves independently");
  // The plain dot form must keep agreeing with it.
  c := SdBox(i32).sd_make();
  assert(c.value == a.value, "plain dot form agrees with the <: form");
});

// A trait-impl operator member that calls ITSELF from its own body. While the
// impl is being evaluated the operator used to resolve to the member's
// in-flight trait SIGNATURE, which has no value: the operator path stamped no
// callee and codegen emitted `// Failed to transpile`, an abort() stub at the
// first `==`. A trait constructor's members are now pending fields, so the
// call binds the member's phase-A FuncVal
// (issues/fixed/derived-eq-ref-enum-self-payload-hollow-at-runtime.md).
SelfEqTree :: ref(struct(v : i32, kid : Option(Self)));
impl(
  SelfEqTree,
  Eq(SelfEqTree)(
    (==) : (fn(imm(lhs) : Self, imm(rhs) : Self) -> bool)(
      (lhs.v == rhs.v) && match(lhs.kid, .Some(a) => match(rhs.kid, .Some(b) => (a == b), .None => false), .None => rhs.kid.is_none())
    )
  )
);
SelfEqKind :: ref(enum(Leaf, Other, Node(elem : Self)));
impl(
  SelfEqKind,
  Eq(SelfEqKind)(
    (==) : ((lhs, rhs) -> match(lhs, .Leaf => match(rhs, .Leaf => true, _ => false), .Other => match(rhs, .Other => true, _ => false), .Node(l) => match(rhs, .Node(r) => (l == r), _ => false)))
  )
);

test("a trait operator member calls itself recursively", {
  a := SelfEqTree(v : i32(1), kid : .Some(SelfEqTree(v : i32(2), kid : .None)));
  b := SelfEqTree(v : i32(1), kid : .Some(SelfEqTree(v : i32(2), kid : .None)));
  c := SelfEqTree(v : i32(1), kid : .Some(SelfEqTree(v : i32(3), kid : .None)));
  assert(a == b, "equal trees");
  assert(!(a == c), "the child differs");
  assert(a != c, "the default != goes through the recursive ==");
  k := SelfEqKind.Node(elem : SelfEqKind.Leaf);
  assert(k == SelfEqKind.Node(elem : SelfEqKind.Leaf), "-> literal member recursion");
  assert(!(k == SelfEqKind.Node(elem : SelfEqKind.Other)), "payload differs");
});

// A helper placed AFTER the impl, forced from `==`'s body, calls `!=` — a
// LATER member of the same trait entry, not evaluated yet. The miss forces
// `!=` out of order (whose body calls back into `==`'s phase-A FuncVal).
MrE :: enum(Leaf(v : i32), Node(kids : ArrayList(Self)));
impl(
  MrE,
  Eq(MrE)(
    (==) : (fn(imm(lhs) : Self, imm(rhs) : Self) -> bool)(
      match(lhs, .Leaf(x) => match(rhs, .Leaf(y) => (x == y), _ => false), .Node(a) => match(rhs, .Node(b) => _mr_kids_eq(a, b), _ => false))
    ),
    (!=) : (fn(imm(lhs) : Self, imm(rhs) : Self) -> bool)(
      !(lhs == rhs)
    )
  )
);
_mr_kids_eq :: (fn(imm(a) : ArrayList(MrE), imm(b) : ArrayList(MrE)) -> bool)({
  if(a.len() != b.len(), {
    return(false);
  });
  (i : usize) = usize(0);
  while(i < a.len(), i = (i + usize(1)), {
    if(a(i) != b(i), {
      return(false);
    });
  });
  true
});

test("a helper after the impl calls a later operator member of the same trait", {
  a := ArrayList(MrE).new();
  a.push(MrE.Leaf(i32(1)));
  b := ArrayList(MrE).new();
  b.push(MrE.Leaf(i32(1)));
  c := ArrayList(MrE).new();
  c.push(MrE.Leaf(i32(2)));
  assert(MrE.Node(a) == MrE.Node(b), "equal children");
  assert(MrE.Node(a) != MrE.Node(c), "a child differs");
});
