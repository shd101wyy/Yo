open import "std/libc/stdio.yo";
{ GlobalAllocator } :: import "std/allocator.yo";

Id :: module(
  id : (fn(self : Self) -> Self)
);

RetI32 :: module(
  return_i32 : (fn(self : *(Self)) -> i32)
);

use_id :: (fn(
  forall(T : Type),
  value : T,
  where(T <: Id)
) -> T) {
  // (T <: Id).id(value);
  return value.id();
};

impl(i32, Id(
  id : ((self) -> {
    printf("i32 value: %d\n", self);
    return self;
  })
));

impl(i32, RetI32(
  return_i32 : ((self) -> {
    return self.*;
  })
));

impl(boolean, Id(
  id : ((self) -> {
    cond(
      self => printf("boolean value: true\n"),
      true => printf("boolean value: false\n")
    );
    return self;
  })
));

impl(boolean, RetI32(
  return_i32 : ((self) ->
    cond(
      self.* => 1,
      true => return 0
    )
  )
));

impl(Box(i32), Id(
  id : ((self) -> {
    printf("Boxed i32 value: %d\n", self.*);
    return self;
  })
));

impl(Box(i32), RetI32(
  // Let's x2 here
  return_i32 : ((self) -> {
    return self.*.* + (self.*.*);
  })
));

ret_boolean_i32 :: (fn() -> Impl(RetI32)) {
  return true;
};

ret_i32_i32 :: (fn() -> Impl(RetI32)) {
  return i32(123);
};

ret_boxi32_i32 :: (fn() -> Impl(RetI32)) {
  return Box(i32)(456);
};

test "Test impl for i32, boolean, Box(i32)", {
  i := 42;
  t := true;
  f := false;
   
  bi := Box(i32)(100);
   
  assert(use_id(i) == i, "use_id should return the same i32 value");
  assert(use_id(t) == t, "use_id should return the same boolean value");
  assert(use_id(f) == f, "use_id should return the same boolean value");
   
  bi_ret := use_id(bi);
  assert(bi_ret.* == bi.*, "use_id should return the same Boxed i32 value");

  assert(use_id(bi).* == bi.*, "use_id should return the same Boxed i32 value");
};

test "Test fn return Impl that expects error", {
  compt_expect_error(
    test_fn :: (fn(some_cond : boolean) -> Impl(Id)) {
      cond(
        some_cond => {
          return 12;
        },
        true => {
          return false;
        }
      );
    }
  );

  compt_expect_error(
    test_fn2 :: (fn(color : Color) -> Impl(Id)) {
      match(color,
        .Red => {
          return 1;
        },
        .Green => {
          return true;
        },
        .Blue => {
          return Box(i32);
        }
      );
    }
  );

  compt_expect_error(
    test_fn3 :: (fn(some_cond : boolean) -> Impl(Id)) {
      cond(
        some_cond => {
          {
            {
              return 12;
            };
          };
        },
        true => {
          return false;
        }
      );
    }
  );
};

test "Test function that returns Impl", {
  b := ret_boolean_i32();
  assert(b.return_i32() == 1, "Expected true from ret_boolean_i32");

  assert(ret_i32_i32().return_i32() == i32(123), "Expected 123 from ret_i32_i32");
   
  r := ret_boxi32_i32();
  assert(&(r).return_i32() == i32(912), "Expected 912 from ret_boxi32_i32");
};