{ assert } :: import("std/assert");
/// Tests for `comptime(inout(name)) : T` parameter form.
///
/// `ref` and `comptime` can be combined on the same parameter. The
/// parameter is erased at runtime (codegen-side: no presence) AND
/// mutations through the binding propagate back to the caller's
/// compile-time value via the evaluator's binding-update path.
///
/// Outer `comptime`, inner `ref` is the canonical syntax — it
/// matches the existing modifier nesting convention (generic/using/
/// comptime are outer, ref is inner, quote is innermost).
///
/// Negative cases (generic+inout rejected, own+inout rejected) are
/// pinned as `comptime_expect_error` at the end of this file (ported
/// from src/tests/comptime-ref-gate.test.ts for P2.4; the exact error
/// MESSAGES were pinned TS-side — comptime_expect_error asserts only
/// that the rejection fires).
// Positive: comptime+ref allows mutation that propagates back.
bump :: (fn(comptime(inout(n)) : usize) -> comptime(usize))({
  n = (n + usize(1));
  n
});
comptime_assert(bump(usize(5)) == usize(6), "5+1 should be 6");
comptime_assert(bump(usize(0)) == usize(1), "0+1 should be 1");
comptime_assert(bump(usize(100)) == usize(101), "100+1 should be 101");
// Positive: multiple comptime+ref params can compose.
swap_and_sum :: (fn(comptime(inout(a)) : i32, comptime(inout(b)) : i32) -> comptime(i32))({
  tmp :: a;
  a = b;
  b = tmp;
  a + b
});
comptime_assert(swap_and_sum(i32(3), i32(7)) == i32(10), "swap then sum");
// Positive: comptime+ref works alongside ordinary comptime params.
indexed_bump :: (fn(comptime(inout(v)) : usize, comptime(by) : usize) -> comptime(usize))({
  v = (v + by);
  v
});
comptime_assert(indexed_bump(usize(10), usize(5)) == usize(15), "10+5 should be 15");
// Positive: nested call — comptime+ref values are still purely
// compile-time, no runtime presence.
double_bump :: (fn(comptime(inout(n)) : usize) -> comptime(usize))(bump(bump(n)));
comptime_assert(double_bump(usize(5)) == usize(7), "5 -> 6 -> 7");
// Smoke: a runtime test body that does nothing — proves the
// comptime+ref call sites above don't leak any runtime artifacts.
test("comptime(inout(...)) parameters are runtime-invisible", {
  assert(true, "ran");
});
// Negative: generic(...) params are comptime-by-default AND erased at
// runtime, so there is no callee-side binding for inout to refer to
// ("'inout' cannot combine with 'generic'/'using' parameters").
test("inout inside generic(...) is rejected", {
  comptime_expect_error(
    (fn(generic(inout(T) : Type), x : T) -> T)(x)
  );
});
// Negative: own and inout are opposite calling conventions
// ("Cannot combine 'own' and 'inout' on the same parameter").
test("own(inout(...)) is rejected", {
  comptime_expect_error(
    (fn(own(inout(x)) : i32) -> i32)(x)
  );
});
