pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio.yo");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
MyBox :: ref(
  struct(
    (*) : i32
  )
);
impl(
  MyBox,
  Dispose(
    dispose : (fn(self : &Self) -> unit)({
      unsafe(printf("Disposing MyBox with value: %d\n", self.*));
    })
  )
);
test("Test basic pointer arithmetic operations", {
  x := 12;
  p := addr_of(x);
  q := p.add(2); // Test &+
  assert(q > p); // Test &>
  assert(p < q); // Test &<
  assert(q >= p); // Test &>=
  assert(p <= q); // Test &<=
  assert(q.offset_from(p) == 2); // Test &/
  z := q.sub(2); // Test &-
  assert(z == p); // Test &==
  assert(z <= p); // Test &<=
  assert(p >= z); // Test &>=
});
test("Test pointer to object type value and `consume` builtin function", {
  b := MyBox(42);
  p := malloc(size_of(Option(MyBox)));
  match(
    p,
    .None => {
      unsafe(printf("Memory allocation failed\n"));
    },
    .Some(ptr) => {
      casted_ptr := (*Option(MyBox))(ptr);
      // Test the `consume` function here.
      // In theory, the old value will be dropped.
      // So we need to `consume` it here as this is our initialization of the pointer value.
      consume(casted_ptr.* = .Some(b));
      // Test moving out the `b`.
      casted_ptr.* = .None;
    }
  );
  free(p);
});
test("sizeof of a nullable-pointer Option is the pointer's", {
  // Codegen lowers `Option(*(T))` to the bare pointer (NULL = `.None`), so the
  // size/alignment model must say the same: it said a tag plus a pointer (16 B
  // on a 64-bit target) for an 8-byte C type.
  assert(size_of(Option(*i32)) == size_of(*i32), "sizeof(Option(*(i32))) is a pointer's size");
  assert(align_of(Option(*i32)) == align_of(*i32), "alignof(Option(*(i32))) is a pointer's alignment");
});
// issues/fixed/address-of-a-parameter-in-a-generic-fn-emits-a-placeholder.md:
// `&v` of a generic fn's parameter, called with a compile-time argument, is
// the parameter's runtime address (it was a comptime pointer codegen emitted
// as `/* skip generating value */`).
_addr_of_param :: (fn(generic(T : Type), v : &T) -> T)({
  (p : *T) = addr_of(v);
  p.*
});
test("&param in a generic fn called with a literal", {
  assert(_addr_of_param(u64(6)) == u64(6), "the literal's value through its parameter's address");
  assert(_addr_of_param(u64(9)) == u64(9), "a second literal, one specialization");
});
