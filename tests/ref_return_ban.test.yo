//! v4 (plans/archive/BORROW_EXCLUSIVITY.md): `inout` may not appear in
//! return-type position — inout params are second-class and exist only as
//! parameters. A returned inout would be a pointer into storage the caller
//! can reallocate or free. (Renamed from `ref` — plans/reference/REF_REFERENCE_SEMANTICS.md.)
{ assert } :: import("std/assert");
open(import("std/string"));

Point :: struct(x : i32, y : i32);

// Unlabeled `-> inout(T)` is rejected.
comptime_expect_error(
  unlabeled_ref_return :: (fn(inout(p) : Point) -> inout(i32))(
    p.x
  )
);

// Labeled `-> (inout(name) : T)` is rejected.
comptime_expect_error(
  labeled_ref_return :: (fn(inout(p) : Point) -> (inout(out) : i32))(
    p.x
  )
);

// Labeled `-> (name : inout(T))` is rejected.
comptime_expect_error(
  labeled_type_ref_return :: (fn(inout(p) : Point) -> (out : inout(i32)))(
    p.x
  )
);

// A trait method declaring `-> inout(T)` is rejected.
comptime_expect_error(
  trait_method_ref_return :: trait(
    Element : Type,
    project_like : (fn(inout(self) : Self, pos : usize) -> inout(Self.Element))
  )
);

// `inout(T)` cannot appear as a parameter TYPE either (only as the
// parameter modifier `inout(name) : T`).
comptime_expect_error(
  takes_ref_typed :: (fn(p : inout(i32)) -> i32)(i32(0))
);

// `inout(T)` cannot appear inside a generic type — borrows must not flow
// through type constructors. (The diagnostic surfaces as a resolution
// error: `inout` is only a keyword in parameter position.)
comptime_expect_error(
  ref_inside_option :: (fn(inout(p) : Point) -> Option(inout(i32)))(
    Option(inout(i32)).None
  )
);

// Positive: the callback pattern — a parameter that RECEIVES a ref —
// stays legal (`std/sync/mutex.yo` is the live std precedent).
test("callback-style ref params remain legal", {
  with_x :: (fn(inout(p) : Point, body : Impl(Fn(inout(v) : i32) -> i32)) -> i32)(
    body(p.x)
  );
  pt := Point(x : i32(21), y : i32(0));
  doubled := with_x(pt, v => (v + v));
  assert(doubled == i32(42), "callback received the field by ref");
});

// Positive: returning the VALUE is the idiom — object values are
// handles that mutate in place.
Holder :: ref(struct(s : String));
test("returning the value instead of a ref", {
  get_s :: (fn(h : Holder) -> String)(
    h.s
  );
  h := Holder(s : String.from("hello"));
  s := get_s(h);
  s.push_str(" world");
  assert(h.s == "hello world", "returned handle mutates the same object");
});
