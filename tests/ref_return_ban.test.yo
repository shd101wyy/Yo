//! v4 (plans/archive/BORROW_EXCLUSIVITY.md) banned a borrow in return-type
//! position. Decision 24 (plans/VALUES_BY_DEFAULT.md V2b) lifts the ban for
//! projections: `-> &T` / `-> &mut T` yields a place written with the sigil of
//! the result's mode (`&mut p.x`), rooted at a borrow parameter. A body that
//! yields a VALUE is still rejected, and a borrow is still not a type.
{ assert } :: import("std/assert");
{ String } :: import("std/string");

Point :: struct(x : i32, y : i32);
derive(Point, Copy, Clone);

// Unlabeled `-> &mut T` whose body yields a value, not `&mut p.x`, is rejected.
comptime_expect_error(
  unlabeled_ref_return :: (fn(p : &mut Point) -> &mut i32)(
    p.x
  )
);

// Labeled `-> (name : &mut T)` yielding a value is rejected.
comptime_expect_error(
  labeled_ref_return :: (fn(p : &mut Point) -> (out : &mut i32))(
    p.x
  )
);

// A trait method may declare `-> &mut T`: it is a projection (decision 24).
trait_method_ref_return :: trait(
  Element : Type,
  project_like : (fn(self : &mut Self, pos : usize) -> &mut Self.Element)
);
impl(
  Point,
  trait_method_ref_return(
    Element : i32,
    project_like : (fn(self : &mut Self, pos : usize) -> &mut Self.Element)(
      cond(
        (pos == usize(0)) => &mut self.x,
        true => &mut self.y
      )
    )
  )
);

// `&mut T` cannot be a field's type either (only a slot's mode,
// `name : &mut T`).
comptime_expect_error(
  RefTypedField :: struct(p : &mut i32)
);

// `&mut T` cannot appear inside a generic type — borrows must not flow
// through type constructors. (The diagnostic surfaces as a resolution
// error: a borrow is a mode, not a type.)
comptime_expect_error(
  ref_inside_option :: (fn(p : &mut Point) -> Option(&mut i32))(
    Option(&mut i32).None
  )
);

// Positive: the callback pattern — a parameter that RECEIVES a ref —
// stays legal (`std/sync/mutex.yo` is the live std precedent).
test("callback-style ref params remain legal", {
  with_x :: (fn(p : &mut Point, body : &Impl(Fn(v : &mut i32) -> i32)) -> i32)(
    body(&mut p.x)
  );
  pt := Point(x : i32(21), y : i32(0));
  doubled := with_x(&mut pt, v => (v + v));
  assert(doubled == i32(42), "callback received the field by ref");
});

// Positive: returning the VALUE is the idiom — object values are
// handles that mutate in place.
Holder :: ref(struct(s : String));
test("returning the value instead of a ref", {
  get_s :: (fn(h : &Holder) -> String)(
    h.s
  );
  h := Holder(s : String.from("hello"));
  s := get_s(&h);
  s.push_str(" world");
  assert(h.s == "hello world", "returned handle mutates the same object");
});
