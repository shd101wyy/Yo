test "Array element access and length", {
  arr := [10, 20, 30, 40, 50];
  assert(arr.len() == 5);
  assert(arr(usize(0)) == 10);
  assert(arr(usize(1)) == 20);
  assert(arr(usize(2)) == 30);
  assert(arr(usize(3)) == 40);
  assert(arr(usize(4)) == 50);
};

test "Array slice element access and length", {
  arr := [1, 2, 3, 4, 5];
  s := arr(1:arr.len());
  assert(s.len() == 4);
  assert(s(usize(0)) == 2);
  assert(s(usize(1)) == 3);
  assert(s(usize(2)) == 4);
  assert(s(usize(3)) == 5);
};