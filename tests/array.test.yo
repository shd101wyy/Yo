pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/string"));
{ HashMap } :: import("std/collections/hash_map");
test("Test Array declaration with inferred length", {
  {
    arr1 := Array(i32, _)(1, 2, 3);
    arr2 := [i32 ; _](1, 2, 3);
    assert(arr1.len() == 3);
    assert(arr2.len() == 3);
  };
  {
    some_condition :: (fn() -> bool)(true);
    comptime_expect_error({
      arr : Array(i32, _); // Not allow to have Array with unknown length in binding
      cond(
        some_condition() => {
          arr = [1, 2, 3];
        },
        true => {
          arr = [2, 3, 4];
        }
      );
      arr(0) = 5;
    });
    arr := cond(
      some_condition() => [i32 ; 3](1, 2, 3),
      true => [i32 ; 3](2, 3, 4)
    );
  };
  {
    // Test basic array type construction
    IntArray :: Array(i32, 3);
    arr := IntArray(1, 2, 3);
    // Test array access
    first := arr(0);
    second := arr(1);
    third := arr(2);
    // Test different array types
    FloatArray :: Array(f64, 2);
    float_arr := FloatArray(1.5, 2.5);
    // Test nested array type construction
    NestedArray :: Array(Array(i32, 2), 2);
    nested := NestedArray(
      Array(i32, 2)(1, 2),
      Array(i32, 2)(3, 4)
    );
    // Test zero-length array
    EmptyArray :: Array(i32, 0);
    empty := EmptyArray();
    // Test inferred length - different sizes
    inferred_arr4 := Array(i32, _)(1, 2, 3, 4);
    inferred_arr2 := Array(f64, _)(1.5, 2.5);
    inferred_arr1 := Array(bool, _)(true);
    inferred_empty := Array(i32, _)();
    // Test nested inferred arrays
    inferred_nested := Array(Array(i32, _), _)(
      Array(i32, _)(1, 2, 3),
      Array(i32, _)(4, 5, 6)
    );
    // Additional tests for array length inference
    test_basic_inference := Array(i32, _)(10, 20, 30, 40, 50); // Should infer length 5
    test_empty_inference := Array(f64, _)(); // Should infer length 0
    test_single_inference := Array(bool, _)(true); // Should infer length 1
    // Test that inferred arrays work with array access
    first_inferred := test_basic_inference(0); // Should be 10
    last_inferred := test_basic_inference(4); // Should be 50
    // Test mutable
    mutable_array := Array(i32, _)(1, 2, 3);
    comptime_expect_error(
      mutable_array = [1, 2, 3, 4]
    );
    mutable_array = [2, 3, 4]; // Should be allowed
  };
});
test("Test Array element access and length", {
  (arr : [i32 ; 5]) = [10, 20, 30, 40, 50];
  assert(arr.len() == 5);
  assert(arr(usize(0)) == 10);
  assert(arr(usize(1)) == 20);
  assert(arr(usize(2)) == 30);
  assert(arr(usize(3)) == 40);
  assert(arr(usize(4)) == 50);
});
test("Test Array slice element access and length", {
  (arr : [i32 ; 5]) = [1, 2, 3, 4, 5];
  s := arr(usize(1) .. arr.len());
  assert(s.len() == 4);
  assert(s(usize(0)) == 2);
  assert(s(usize(1)) == 3);
  assert(s(usize(2)) == 4);
  assert(s(usize(3)) == 5);
});
test("Test Array copy", {
  // Create binding first, then assign value
  arr1 : Array(i32, 3);
  arr1 = [1, 2, 3];
  // Create binding and assign value in one line
  (arr2 : [i32 ; 3]) = [1, 2, 3];
  arr2(0) = 12;
  // Copy array
  arr3 := arr1;
  arr3(1) = 22; // This shouldn't affect arr1
  assert(arr1(0) == 1);
  assert(arr1(1) == 2);
  assert(arr1(2) == 3);
  assert(arr2(0) == 12);
  assert(arr2(1) == 2);
  assert(arr2(2) == 3);
  assert(arr3(0) == 1);
  assert(arr3(1) == 22);
  assert(arr3(2) == 3);
});
test("Test Array fill method", {
  return_array :: (fn(comptime(n) : usize) -> [i32 ; n])({
    return(Array(i32, n).fill(10));
  });
  return_array_2 :: (fn(comptime(n) : usize) -> [i32 ; n])(Array(i32, n).fill(20));
  comptime_return_array :: (fn(comptime(n) : usize) -> comptime([i32 ; n]))({
    return(Array(i32, n).fill(30));
  });
  comptime_return_array_2 :: (fn(comptime(n) : usize) -> comptime([i32 ; n]))(Array(i32, n).fill(40));
  arr :: Array(i32, 6).fill(8);
  arr2 := return_array(5);
  assert(arr2.len() == 5);
  assert(arr2(0) == 10);
  arr2_2 := return_array_2(7);
  assert(arr2_2.len() == 7);
  assert(arr2_2(0) == 20);
  arr3 := comptime_return_array(10);
  assert(arr3.len() == 10);
  assert(arr3(0) == 30);
  arr3_2 := comptime_return_array_2(12);
  assert(arr3_2.len() == 12);
  assert(arr3_2(0) == 40);
});
test("Test array slice copies (value semantics)", {
  // Range-indexing an array returns an OWNED ArrayList copy
  // (plans/archive/SLICE_REWORK.md): mutations of the copy do NOT write through,
  // and later mutations of the source do not affect the copy.
  (arr : [i32 ; 4]) = [1, 2, 3, 4];
  full_copy := arr(usize(0) .. usize(4));
  part := arr(usize(1) .. usize(3));
  assert(part.len() == usize(2));
  assert(match(part.get(usize(0)), .Some(v) => (v == 2), .None => false));
  assert(match(part.get(usize(1)), .Some(v) => (v == 3), .None => false));
  // Mutating the copy leaves the array untouched.
  part(usize(0)) = i32(10);
  assert(arr(1) == 2);
  assert(match(part.get(usize(0)), .Some(v) => (v == 10), .None => false));
  // Sub-slicing the copy copies again.
  sub := part(usize(0) .. usize(2));
  assert(sub.len() == usize(2));
  assert(match(sub.get(usize(0)), .Some(v) => (v == 10), .None => false));
  assert(full_copy.len() == usize(4));
  assert(match(full_copy.get(usize(3)), .Some(v) => (v == 4), .None => false));
});
// ===== Array Iterator Tests =====
// Value-form iteration: `for(arr, (x) => body)` calls `arr.into_iter()`
// and binds `x` to each element by value. In-place element mutation
// uses index writes (`arr(i) = v`).
test("Array iter - empty array yields nothing", {
  arr := Array(i32, 0)();
  count := usize(0);
  for(arr, x => {
    consume(x);
    count = (count + usize(1));
  });
  assert(count == usize(0), "empty array should yield no elements");
});
test("Array iter - reads elements by value", {
  arr := [i32(10), i32(20), i32(30)];
  sum := i32(0);
  count := usize(0);
  for(arr, x => {
    sum = (sum + x);
    count = (count + usize(1));
  });
  assert(count == usize(3), "should yield 3 elements");
  assert(sum == i32(60), "sum should be correct");
});
test("Array - mutate via index writes", {
  arr := [i32(1), i32(2), i32(3)];
  i := usize(0);
  while(i < usize(3), {
    arr(i) = (arr(i) * i32(10));
    i = (i + usize(1));
  });
  assert(arr(0) == i32(10), "first element should be 10");
  assert(arr(1) == i32(20), "second element should be 20");
  assert(arr(2) == i32(30), "third element should be 30");
});
// ===== Range-copy Iterator Tests =====
test("Range copy iter - reads elements by value", {
  arr := [i32(100), i32(200), i32(300)];
  slice := arr(usize(0) .. usize(3));
  sum := i32(0);
  count := usize(0);
  for(slice, x => {
    sum = (sum + x);
    count = (count + usize(1));
  });
  assert(count == usize(3), "should yield 3 elements");
  assert(sum == i32(600), "sum should be correct");
});
test("Range copy - mutation stays in the copy", {
  // Ranges COPY (plans/archive/SLICE_REWORK.md): mutating the copied list does
  // not write back to the source array.
  arr := [i32(1), i32(2), i32(3)];
  copy := arr(usize(0) .. usize(3));
  i := usize(0);
  while(i < usize(3), {
    copy(i) = (copy(i) + i32(5));
    i = (i + usize(1));
  });
  assert(arr(0) == i32(1), "source untouched");
  assert(match(copy.get(usize(0)), .Some(v) => (v == i32(6)), .None => false), "copy mutated");
  assert(match(copy.get(usize(2)), .Some(v) => (v == i32(8)), .None => false), "copy mutated end");
});
test("Range copy iter - partial range", {
  arr := [i32(10), i32(20), i32(30), i32(40)];
  slice := arr(usize(1) .. usize(3));
  sum := i32(0);
  count := usize(0);
  for(slice, x => {
    sum = (sum + x);
    count = (count + usize(1));
  });
  assert(count == usize(2), "should yield 2 elements");
  assert(sum == i32(50), "sum of middle elements should be 50");
});
// ===== Eq / Ord / Clone / Hash on Array(T, N) itself =====
// The generic impls live in std/prelude.yo next to Array's Send/Acyclic
// markers. Two DIFFERENT lengths in one file matter: they force two
// specializations of the same impl, which is what surfaced the const-generic
// length surviving substitution as `Array(u16, N)` and reaching codegen as the
// C comment `// Unknown type: ...`.
// issues/fixed/array-const-generic-length-unresolved-in-the-operator-call-cast.md
test("Array Eq - element-wise, at two lengths in one file", {
  a := Array(i32, 4)(1, 2, 3, 4);
  b := Array(i32, 4)(1, 2, 3, 4);
  c := Array(i32, 4)(1, 2, 3, 9);
  assert(a == b, "equal arrays compare equal");
  assert(a != c, "a difference in the last element is seen");
  assert(!(a == c), "negated == agrees");
  // Second length → second specialization of the same generic impl.
  p := Array(u16, 2)(u16(7), u16(8));
  q := Array(u16, 2)(u16(7), u16(8));
  r := Array(u16, 2)(u16(7), u16(9));
  assert(p == q, "a second length specializes independently");
  assert(p != r, "and compares correctly");
  // Zero-length and single-element edges.
  assert(Array(i32, 0)() == Array(i32, 0)(), "empty arrays are equal");
  assert(Array(i32, 1)(5) == Array(i32, 1)(5), "single-element arrays compare");
  assert(Array(i32, 1)(5) != Array(i32, 1)(6), "and differ when they should");
});
test("Array Ord - lexicographic", {
  a := Array(i32, 3)(1, 2, 3);
  b := Array(i32, 3)(1, 2, 4);
  c := Array(i32, 3)(2, 0, 0);
  assert(a < b, "the last element decides when the prefix matches");
  assert(a < c, "the FIRST difference decides");
  assert(b < c, "(1,2,4) < (2,0,0)");
  assert(!(a < a), "an array is not < itself");
  assert(a <= a, "an array is <= itself");
  assert(a >= a, "an array is >= itself");
  assert(!(a > a), "an array is not > itself");
  assert(c > b, "the reverse comparison agrees");
  assert(!(Array(i32, 0)() < Array(i32, 0)()), "empty arrays are not ordered");
  assert(Array(i32, 0)() <= Array(i32, 0)(), "empty arrays are <=");
});
test("Array cmp - the Ord default reaches Ordering", {
  a := Array(i32, 3)(1, 2, 3);
  b := Array(i32, 3)(1, 2, 4);
  // `Ordering` has no `Eq` impl in the prelude, so it is matched, not compared.
  assert(match(a.cmp(b), .Less => true, _ => false), "less");
  assert(match(b.cmp(a), .Greater => true, _ => false), "greater");
  assert(match(a.cmp(a), .Equal => true, _ => false), "equal");
});
test("Array Clone - independent of its source", {
  a := Array(i32, 3)(1, 2, 3);
  b := a.clone();
  assert(a == b, "a clone equals its source");
  b(usize(1)) = i32(99);
  assert(b(1) == i32(99), "the clone took the write");
  assert(a(1) == i32(2), "the source is untouched");
  assert(a != b, "the mutated clone differs");
});
test("Array Clone - an owning element type is deep-copied", {
  a := Array(String, 2)(String.from("ab"), String.from("cd"));
  b := a.clone();
  assert(a == b, "the clone starts equal");
  b(usize(0)).push_str("XY");
  assert(b(0) == `abXY`, "the clone took the append");
  assert(a(0) == `ab`, "the SOURCE string buffer is untouched — the clone is deep");
});
test("Array Hash agrees with Eq through a HashMap key", {
  m := HashMap(Array(u8, 4), i32).new();
  k1 := Array(u8, 4)(u8(1), u8(2), u8(3), u8(4));
  k2 := Array(u8, 4)(u8(1), u8(2), u8(3), u8(4));
  k3 := Array(u8, 4)(u8(9), u8(9), u8(9), u8(9));
  m.insert(k1, i32(11));
  m.insert(k3, i32(33));
  assert(m.len() == usize(2), "two distinct keys");
  assert(match(m.get(k2), .Some(v) => (v == i32(11)), .None => false), "an EQUAL key finds the entry — Eq and Hash agree");
  assert(match(m.get(k3), .Some(v) => (v == i32(33)), .None => false), "the second key round-trips");
  m.insert(k2, i32(22));
  assert(m.len() == usize(2), "re-inserting an equal key replaces rather than adds");
});
