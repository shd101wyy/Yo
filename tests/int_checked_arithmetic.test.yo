// Integer batteries (std/prelude.yo): overflow-aware arithmetic —
// `checked_*` reports overflow as `.None`, `saturating_*` clamps — and the
// bit-level operations (`count_ones`, `leading_zeros`, `rotate_left`,
// `reverse_bits`, `swap_bytes`, `next_power_of_two`, …), and the remaining
// arithmetic (`abs`, `signum`, `pow`, `div_euclid`, `midpoint`, `isqrt`,
// `abs_diff`, the byte conversions).
//
// Assertions use an inline `match` rather than a generic `_is_none(o)` helper:
// passing a generic-impl method's result DIRECTLY into a generic fn fails to
// transpile
// (issues/generic-impl-method-result-passed-directly-to-a-generic-fn-fails-to-transpile.md).
{ assert } :: import("std/assert");
_some_eq :: (fn(o : Option(i32), want : i32) -> bool)(match(o, .Some(v) => (v == want), .None => false));
_some_eq_u8 :: (fn(o : Option(u8), want : u8) -> bool)(match(o, .Some(v) => (v == want), .None => false));
_none_i32 :: (fn(o : Option(i32)) -> bool)(match(o, .Some(_) => false, .None => true));
_none_u8 :: (fn(o : Option(u8)) -> bool)(match(o, .Some(_) => false, .None => true));
_M1 :: (i32(0) - i32(1));
test("checked_add reports signed and unsigned overflow", {
  assert(_some_eq(i32(1).checked_add(i32(2)), i32(3)), "1+2=3");
  assert(_none_i32(i32.MAX.checked_add(i32(1))), "MAX+1 overflows");
  assert(_none_i32(i32.MIN.checked_add(_M1)), "MIN+(-1) underflows");
  assert(_some_eq(i32.MAX.checked_add(_M1), i32.MAX - i32(1)), "MAX+(-1) fits");
  assert(_none_u8(u8(200).checked_add(u8(100))), "u8 200+100 overflows");
  assert(_some_eq_u8(u8(200).checked_add(u8(55)), u8(255)), "u8 200+55 = 255 exactly at MAX");
});
test("checked_sub reports underflow, and unsigned never goes below zero", {
  assert(_some_eq(i32(1).checked_sub(i32(2)), _M1), "1-2=-1");
  assert(_none_u8(u8(5).checked_sub(u8(7))), "u8 5-7 underflows");
  assert(_some_eq_u8(u8(5).checked_sub(u8(5)), u8(0)), "u8 5-5=0");
  assert(_none_i32(i32.MIN.checked_sub(i32(1))), "MIN-1 underflows");
  assert(_none_i32(i32.MAX.checked_sub(_M1)), "MAX-(-1) overflows");
});
test("checked_mul checks by division, never by forming the product", {
  assert(_some_eq(i32(3).checked_mul(i32(4)), i32(12)), "3*4=12");
  assert(_some_eq((i32(0) - i32(3)).checked_mul(i32(0) - i32(4)), i32(12)), "(-3)*(-4)=12");
  assert(_some_eq(i32(5).checked_mul(_M1), i32(0) - i32(5)), "5*(-1)=-5");
  assert(_some_eq(_M1.checked_mul(i32(5)), i32(0) - i32(5)), "(-1)*5=-5");
  assert(_some_eq(i32(0).checked_mul(i32.MAX), i32(0)), "0*MAX=0 without overflowing");
  assert(_some_eq(i32.MAX.checked_mul(i32(0)), i32(0)), "MAX*0=0");
  assert(_none_i32(i32.MAX.checked_mul(i32(2))), "MAX*2 overflows");
  assert(_none_i32(i32.MIN.checked_mul(_M1)), "MIN*(-1) overflows (no positive MIN)");
  assert(_none_i32(i32.MIN.checked_mul(i32(2))), "MIN*2 underflows");
  assert(_none_u8(u8(16).checked_mul(u8(16))), "u8 16*16=256 overflows");
  assert(_some_eq_u8(u8(15).checked_mul(u8(17)), u8(255)), "u8 15*17=255 exactly at MAX");
});
test("checked_div and checked_rem reject zero and MIN/-1", {
  assert(_some_eq(i32(7).checked_div(i32(2)), i32(3)), "7/2=3");
  assert(_none_i32(i32(1).checked_div(i32(0))), "divide by zero");
  assert(_none_i32(i32.MIN.checked_div(_M1)), "MIN/-1 overflows");
  assert(_some_eq(i32.MAX.checked_div(_M1), i32(0) - i32.MAX), "MAX/-1 fits");
  assert(_some_eq_u8(u8(200).checked_div(u8(2)), u8(100)), "u8 200/2=100");
  assert(_some_eq(i32(7).checked_rem(i32(2)), i32(1)), "7%2=1");
  assert(_none_i32(i32(1).checked_rem(i32(0))), "rem by zero");
  assert(_none_i32(i32.MIN.checked_rem(_M1)), "MIN%-1 overflows");
});
test("saturating_* clamp to the bound instead of overflowing", {
  assert(i32.MAX.saturating_add(i32(1)) == i32.MAX, "add clamps high");
  assert(i32.MIN.saturating_add(_M1) == i32.MIN, "add clamps low");
  assert(i32(1).saturating_add(i32(2)) == i32(3), "add is ordinary when it fits");
  assert(i32.MIN.saturating_sub(i32(1)) == i32.MIN, "sub clamps low");
  assert(i32.MAX.saturating_sub(_M1) == i32.MAX, "sub clamps high");
  assert(u8(5).saturating_sub(u8(7)) == u8(0), "unsigned sub floors at 0");
  assert(i32.MAX.saturating_mul(i32(2)) == i32.MAX, "mul clamps high");
  assert(i32.MIN.saturating_mul(i32(2)) == i32.MIN, "mul clamps low");
  assert(i32.MIN.saturating_mul(_M1) == i32.MAX, "MIN*(-1) clamps to MAX");
  assert(i32.MAX.saturating_mul(_M1) == (i32(0) - i32.MAX), "MAX*(-1) fits");
});
test("wrapping_add/sub reconstruct the value from the bounds", {
  assert(i32.MAX.wrapping_add(i32(1)) == i32.MIN, "MAX+1 wraps to MIN");
  assert(i32.MIN.wrapping_add(_M1) == i32.MAX, "MIN+(-1) wraps to MAX");
  assert(i32(1).wrapping_add(i32(2)) == i32(3), "ordinary add is unchanged");
  assert(u8(255).wrapping_add(u8(1)) == u8(0), "u8 255+1 wraps to 0");
  assert(u8(200).wrapping_add(u8(100)) == u8(44), "u8 200+100 = 300 mod 256 = 44");
  assert(i32.MIN.wrapping_sub(i32(1)) == i32.MAX, "MIN-1 wraps to MAX");
  assert(i32.MAX.wrapping_sub(_M1) == i32.MIN, "MAX-(-1) wraps to MIN");
  assert(u8(5).wrapping_sub(u8(7)) == u8(254), "u8 5-7 = -2 mod 256 = 254");
  assert(i32(5).wrapping_sub(i32(2)) == i32(3), "ordinary sub is unchanged");
});
test("overflowing_* pair the wrapped value with the flag", {
  a := i32.MAX.overflowing_add(i32(1));
  assert((a.0 == i32.MIN) && (a.1 == true), "MAX+1 = (MIN, true)");
  b := i32(1).overflowing_add(i32(2));
  assert((b.0 == i32(3)) && (b.1 == false), "1+2 = (3, false)");
  c := u8(5).overflowing_sub(u8(7));
  assert((c.0 == u8(254)) && (c.1 == true), "u8 5-7 = (254, true)");
  d := i32(5).overflowing_sub(i32(2));
  assert((d.0 == i32(3)) && (d.1 == false), "5-2 = (3, false)");
});
test("checked_abs reports the MIN case; unsigned abs is the identity", {
  assert(_some_eq(i32(5).checked_abs(), i32(5)), "abs 5 = 5");
  assert(_some_eq((i32(0) - i32(5)).checked_abs(), i32(5)), "abs -5 = 5");
  assert(_none_i32(i32.MIN.checked_abs()), "abs MIN has no positive counterpart");
  assert(_some_eq_u8(u8(200).checked_abs(), u8(200)), "unsigned abs is identity");
  assert(_some_eq_u8(u8(0).checked_abs(), u8(0)), "unsigned abs of MIN(0) is 0");
  assert(i32.MIN.saturating_abs() == i32.MAX, "saturating_abs clamps MIN to MAX");
});
test("checked_pow multiplies stepwise and reports overflow", {
  assert(_some_eq(i32(2).checked_pow(u32(10)), i32(1024)), "2^10 = 1024");
  assert(_some_eq(i32(7).checked_pow(u32(0)), i32(1)), "anything^0 = 1");
  assert(_some_eq(i32(0).checked_pow(u32(5)), i32(0)), "0^5 = 0");
  assert(_none_i32(i32(2).checked_pow(u32(31))), "2^31 overflows i32");
  assert(_some_eq(i32(2).checked_pow(u32(30)), i32(1073741824)), "2^30 fits");
  assert(_none_u8(u8(16).checked_pow(u32(2))), "u8 16^2 = 256 overflows");
});
test("clamp bounds a value into a range", {
  assert(i32(5).clamp(i32(1), i32(10)) == i32(5), "inside the range is unchanged");
  assert(i32(0).clamp(i32(1), i32(10)) == i32(1), "below clamps to lo");
  assert(i32(99).clamp(i32(1), i32(10)) == i32(10), "above clamps to hi");
  assert(u8(0).clamp(u8(3), u8(9)) == u8(3), "unsigned clamps to lo");
});
// ===========================================================================
// Bit-level operations
// ===========================================================================
_some_eq_usize :: (
  fn(o : Option(usize), want : usize) -> bool
)(match(o, .Some(v) => (v == want), .None => false));
_none_usize :: (fn(o : Option(usize)) -> bool)(match(o, .Some(_) => false, .None => true));
_none_u32 :: (fn(o : Option(u32)) -> bool)(match(o, .Some(_) => false, .None => true));
_some_eq_u32 :: (
  fn(o : Option(u32), want : u32) -> bool
)(match(o, .Some(v) => (v == want), .None => false));
test("count_ones and count_zeros are complementary at every width", {
  assert(u8(0).count_ones() == u32(0), "u8 zero has no ones");
  assert(u8.MAX.count_ones() == u32(8), "u8 MAX is eight ones");
  assert(u8(0).count_zeros() == u32(8), "u8 zero is eight zeros");
  assert(u8.MAX.count_zeros() == u32(0), "u8 MAX has no zeros");
  assert(u16(0xF0F0).count_ones() == u32(8), "u16 alternating nibbles");
  assert(u32(0x80000001).count_ones() == u32(2), "u32 both extremes set");
  assert(u64.MAX.count_ones() == u32(64), "u64 MAX is 64 ones");
  assert(u64(0).count_zeros() == u32(64), "u64 zero is 64 zeros");
});
test("a negative signed receiver counts over its OWN width, not 64 bits", {
  // The whole hazard of implementing these over `u64`: `u64(i8(-1))` sign-
  // extends to 64 ones. The cast must go through `u8`, so this is 8.
  assert(i8(0 - 1).count_ones() == u32(8), "i8(-1) is eight ones, not 64");
  assert(i16(0 - 1).count_ones() == u32(16), "i16(-1) is sixteen ones");
  assert(i32(0 - 1).count_ones() == u32(32), "i32(-1) is thirty-two ones");
  assert(i64(0 - 1).count_ones() == u32(64), "i64(-1) is sixty-four ones");
  assert(i8(0 - 1).count_zeros() == u32(0), "i8(-1) has no zeros");
  assert(i8(0 - 2).count_ones() == u32(7), "i8(-2) clears exactly bit 0");
});
test("leading_zeros and trailing_zeros saturate at the width for zero", {
  assert(u8(0).leading_zeros() == u32(8), "u8 zero is all leading zeros");
  assert(u8(0).trailing_zeros() == u32(8), "u8 zero is all trailing zeros");
  assert(u8(1).leading_zeros() == u32(7), "u8 one has seven above it");
  assert(u8(1).trailing_zeros() == u32(0), "u8 one has none below it");
  assert(u8(128).leading_zeros() == u32(0), "u8 top bit has none above it");
  assert(u8(128).trailing_zeros() == u32(7), "u8 top bit has seven below it");
  assert(u32(0).leading_zeros() == u32(32), "u32 zero");
  assert(u32(1).leading_zeros() == u32(31), "u32 one");
  assert(u64(0).leading_zeros() == u32(64), "u64 zero");
  assert(u64(1).leading_zeros() == u32(63), "u64 one");
  // A negative signed value has its sign bit set, so nothing leads it.
  assert(i32(0 - 1).leading_zeros() == u32(0), "i32(-1) has no leading zeros");
  assert(i32(1).leading_zeros() == u32(31), "i32 one");
});
test("leading_ones and trailing_ones are the complement's zero counts", {
  assert(u8.MAX.leading_ones() == u32(8), "u8 MAX is all leading ones");
  assert(u8.MAX.trailing_ones() == u32(8), "u8 MAX is all trailing ones");
  assert(u8(0).leading_ones() == u32(0), "u8 zero has no leading ones");
  assert(u8(0xF0).leading_ones() == u32(4), "u8 0xF0 leads with four ones");
  assert(u8(0x0F).trailing_ones() == u32(4), "u8 0x0F trails with four ones");
  assert(u8(0x0F).leading_ones() == u32(0), "u8 0x0F leads with a zero");
  assert(i8(0 - 1).leading_ones() == u32(8), "i8(-1) is all ones");
});
test("rotate_left and rotate_right wrap rather than shift", {
  // A shift loses the bits that fall off; a rotate must not.
  assert(u8(0x81).rotate_left(u32(1)) == u8(0x03), "u8 0x81 rotl 1 keeps both bits");
  assert(u8(0x81).rotate_right(u32(1)) == u8(0xC0), "u8 0x81 rotr 1 keeps both bits");
  assert(u8(0x01).rotate_right(u32(1)) == u8(0x80), "u8 bit 0 rotr 1 lands on bit 7");
  // A full turn, and more than a full turn, are identities modulo the width.
  assert(u8(0x5A).rotate_left(u32(8)) == u8(0x5A), "a full turn is the identity");
  assert(u8(0x5A).rotate_left(u32(9)) == u8(0x5A).rotate_left(u32(1)), "rotl is mod width");
  assert(u8(0x5A).rotate_left(u32(0)) == u8(0x5A), "rotl 0 is the identity");
  // rotl n then rotr n is the identity at every width.
  assert(u16(0xBEEF).rotate_left(u32(5)).rotate_right(u32(5)) == u16(0xBEEF), "u16 round trip");
  assert(u32(0xDEADBEEF).rotate_left(u32(13)).rotate_right(u32(13)) == u32(0xDEADBEEF), "u32 round trip");
  assert(u64(0x0123456789ABCDEF).rotate_left(u32(37)).rotate_right(u32(37)) == u64(0x0123456789ABCDEF), "u64 round trip");
  assert(i32(0 - 2).rotate_left(u32(1)) == i32(0 - 3), "i32(-2) rotl 1 is -3");
});
test("reverse_bits is an involution and respects the width", {
  assert(u8(0x01).reverse_bits() == u8(0x80), "u8 bit 0 becomes bit 7");
  assert(u8(0x0F).reverse_bits() == u8(0xF0), "u8 low nibble becomes high");
  assert(u8(0x5A).reverse_bits().reverse_bits() == u8(0x5A), "u8 involution");
  assert(u16(0x0001).reverse_bits() == u16(0x8000), "u16 bit 0 becomes bit 15");
  assert(u32(0x00000001).reverse_bits() == u32(0x80000000), "u32 bit 0 becomes bit 31");
  assert(u64(1).reverse_bits() == u64(0x8000000000000000), "u64 bit 0 becomes bit 63");
  assert(u64(0x0123456789ABCDEF).reverse_bits().reverse_bits() == u64(0x0123456789ABCDEF), "u64 involution");
  assert(i8(1).reverse_bits() == i8(0 - 128), "i8 bit 0 becomes the sign bit");
});
test("swap_bytes is an involution and respects the width", {
  assert(u16(0x1234).swap_bytes() == u16(0x3412), "u16 two bytes");
  assert(u32(0x11223344).swap_bytes() == u32(0x44332211), "u32 four bytes");
  assert(u64(0x1122334455667788).swap_bytes() == u64(0x8877665544332211), "u64 eight bytes");
  assert(u8(0x42).swap_bytes() == u8(0x42), "a single byte swaps to itself");
  assert(u32(0x11223344).swap_bytes().swap_bytes() == u32(0x11223344), "u32 involution");
  assert(i16(0x0102).swap_bytes() == i16(0x0201), "i16 two bytes");
});
test("is_power_of_two and next_power_of_two", {
  assert(!u32(0).is_power_of_two(), "zero is NOT a power of two");
  assert(u32(1).is_power_of_two(), "one is 2^0");
  assert(u32(2).is_power_of_two(), "two");
  assert(!u32(3).is_power_of_two(), "three");
  assert(u32(0x80000000).is_power_of_two(), "the top bit alone");
  assert(!u32(0x80000001).is_power_of_two(), "the top bit plus one");
  assert(u32(0).next_power_of_two() == u32(1), "zero rounds up to one");
  assert(u32(1).next_power_of_two() == u32(1), "one is already a power of two");
  assert(u32(2).next_power_of_two() == u32(2), "two is already a power of two");
  assert(u32(3).next_power_of_two() == u32(4), "three rounds up to four");
  assert(u32(5).next_power_of_two() == u32(8), "five rounds up to eight");
  assert(u32(0x40000000).next_power_of_two() == u32(0x40000000), "the largest fitting power");
  assert(u32(0x40000001).next_power_of_two() == u32(0x80000000), "rounds up to the top bit");
  // The u8 overflow edge (129 does not fit in a u8 power of two) is a PANIC,
  // pinned by the checked form in the next test.
});
test("checked_next_power_of_two reports the overflow next_power_of_two panics on", {
  // The panic itself cannot be observed from inside a test process; the
  // checked form is what pins the boundary.
  assert(_some_eq_u32(u32(0).checked_next_power_of_two(), u32(1)), "zero gives one");
  assert(_some_eq_u32(u32(0x80000000).checked_next_power_of_two(), u32(0x80000000)), "the top bit fits");
  assert(_none_u32(u32(0x80000001).checked_next_power_of_two()), "past the top bit does not fit");
  assert(_none_u32(u32.MAX.checked_next_power_of_two()), "MAX does not fit");
  assert(_some_eq_usize(usize(1000).checked_next_power_of_two(), usize(1024)), "usize 1000 -> 1024");
  assert(_none_usize(usize.MAX.checked_next_power_of_two()), "usize MAX does not fit");
});
test("usize and isize use their TARGET width, not a hardcoded 64", {
  // usize is 32-bit on wasm32 and 64-bit elsewhere, so these are written
  // against `usize.MAX` rather than against a literal width.
  w := usize.MAX.count_ones();
  assert((w == u32(64)) || (w == u32(32)), "usize is 64- or 32-bit");
  assert(usize(0).leading_zeros() == w, "zero is all leading zeros, whatever the width");
  assert(usize(0).trailing_zeros() == w, "zero is all trailing zeros");
  assert(usize(0).count_zeros() == w, "zero is all zeros");
  assert(usize(1).leading_zeros() == (w - u32(1)), "one has width-1 above it");
  assert(usize(1).reverse_bits() == (usize(1) << usize(w - u32(1))), "bit 0 becomes the top bit");
  assert(usize(0x5A).rotate_left(u32(3)).rotate_right(u32(3)) == usize(0x5A), "usize rotate round trip");
  assert(isize(0 - 1).count_ones() == w, "isize(-1) is width ones");
  assert(isize(0 - 1).leading_zeros() == u32(0), "isize(-1) has no leading zeros");
  assert(isize(1).reverse_bits() == isize.MIN, "isize bit 0 becomes the sign bit");
});
// ===========================================================================
// Arithmetic part 2
// ===========================================================================
_none_i64 :: (fn(o : Option(i64)) -> bool)(match(o, .Some(_) => false, .None => true));
_some_eq_i64 :: (
  fn(o : Option(i64), want : i64) -> bool
)(match(o, .Some(v) => (v == want), .None => false));
test("abs and signum exist only for the signed types, and abs panics at MIN", {
  assert(i32(0 - 5).abs() == i32(5), "negative");
  assert(i32(5).abs() == i32(5), "positive");
  assert(i32(0).abs() == i32(0), "zero");
  assert(i8(0 - 128).wrapping_abs() == i8(0 - 128), "wrapping_abs maps MIN to itself");
  assert(_none_i32(i32.MIN.checked_abs()), "checked_abs reports the MIN case");
  // `abs()` on MIN PANICS rather than returning a negative absolute value the
  // way a wrapping implementation would; the checked form above is the
  // observable half.
  assert(i32(0 - 7).signum() == i32(0 - 1), "negative signum");
  assert(i32(7).signum() == i32(1), "positive signum");
  assert(i32(0).signum() == i32(0), "zero signum");
  assert(i64(0 - 1).wrapping_neg() == i64(1), "wrapping_neg");
  assert(i64.MIN.wrapping_neg() == i64.MIN, "wrapping_neg maps MIN to itself");
});
test("div_euclid and rem_euclid keep the remainder non-negative", {
  // The whole reason these exist: C's `/` truncates toward zero and `%` keeps
  // the dividend's sign, so `(-7) / 2` is -3 and `(-7) % 2` is -1.
  assert((i32(0 - 7) / i32(2)) == i32(0 - 3), "C division truncates toward zero");
  assert((i32(0 - 7) % i32(2)) == i32(0 - 1), "C remainder keeps the dividend's sign");
  // Euclidean: quotient rounds toward negative infinity, remainder >= 0.
  assert(i32(0 - 7).div_euclid(i32(2)) == i32(0 - 4), "-7 div_euclid 2 = -4");
  assert(i32(0 - 7).rem_euclid(i32(2)) == i32(1), "-7 rem_euclid 2 = 1");
  assert(i32(7).div_euclid(i32(2)) == i32(3), "7 div_euclid 2 = 3");
  assert(i32(7).rem_euclid(i32(2)) == i32(1), "7 rem_euclid 2 = 1");
  // A negative DIVISOR too.
  assert(i32(0 - 7).div_euclid(i32(0 - 2)) == i32(4), "-7 div_euclid -2 = 4");
  assert(i32(0 - 7).rem_euclid(i32(0 - 2)) == i32(1), "-7 rem_euclid -2 = 1");
  assert(i32(7).div_euclid(i32(0 - 2)) == i32(0 - 3), "7 div_euclid -2 = -3");
  assert(i32(7).rem_euclid(i32(0 - 2)) == i32(1), "7 rem_euclid -2 = 1");
  // The identity that defines them, over every sign combination.
  assert(((i32(0 - 7).div_euclid(i32(2)) * i32(2)) + i32(0 - 7).rem_euclid(i32(2))) == i32(0 - 7), "q*d + r == n");
  assert(((i32(7).div_euclid(i32(0 - 2)) * i32(0 - 2)) + i32(7).rem_euclid(i32(0 - 2))) == i32(7), "q*d + r == n, negative divisor");
  // Unsigned: both agree with plain / and %.
  assert(u32(7).div_euclid(u32(2)) == u32(3), "unsigned div_euclid");
  assert(u32(7).rem_euclid(u32(2)) == u32(1), "unsigned rem_euclid");
});
test("midpoint does not overflow where (a + b) / 2 would", {
  // The classic binary-search bug: i32.MAX + i32.MAX overflows, so a naive
  // midpoint is undefined. This one is defined.
  assert(i32.MAX.midpoint(i32.MAX) == i32.MAX, "MAX and MAX");
  assert(u32.MAX.midpoint(u32.MAX) == u32.MAX, "unsigned MAX and MAX");
  assert(u32(0).midpoint(u32.MAX) == (u32.MAX / u32(2)), "0 and MAX");
  assert(i32(2).midpoint(i32(4)) == i32(3), "2 and 4");
  assert(i32(4).midpoint(i32(2)) == i32(3), "argument order does not matter");
  assert(i32(2).midpoint(i32(5)) == i32(3), "rounds toward the smaller");
  assert(i64.MIN.midpoint(i64.MAX) == i64(0 - 1), "MIN and MAX");
});
test("pow and saturating_pow", {
  assert(i32(2).pow(u32(10)) == i32(1024), "2^10");
  assert(i32(0 - 2).pow(u32(3)) == i32(0 - 8), "a negative base to an odd power");
  assert(i32(0 - 2).pow(u32(2)) == i32(4), "a negative base to an even power");
  assert(i32(5).pow(u32(0)) == i32(1), "anything to the zero is 1");
  // pow PANICS on overflow; saturating_pow is the observable form.
  assert(i32(2).saturating_pow(u32(40)) == i32.MAX, "overflow saturates high");
  assert(i32(0 - 2).saturating_pow(u32(41)) == i32.MIN, "a negative base to an ODD power saturates low");
  assert(i32(0 - 2).saturating_pow(u32(40)) == i32.MAX, "a negative base to an EVEN power saturates high");
  assert(u8(2).saturating_pow(u32(9)) == u8.MAX, "unsigned saturates high");
});
test("isqrt is the greatest r with r*r <= n", {
  assert(i32(0).isqrt() == i32(0), "0");
  assert(i32(1).isqrt() == i32(1), "1");
  assert(i32(2).isqrt() == i32(1), "2 -> 1");
  assert(i32(3).isqrt() == i32(1), "3 -> 1");
  assert(i32(4).isqrt() == i32(2), "4 -> 2");
  assert(i32(8).isqrt() == i32(2), "8 -> 2");
  assert(i32(9).isqrt() == i32(3), "9 -> 3");
  assert(i32(99).isqrt() == i32(9), "99 -> 9");
  assert(i32(100).isqrt() == i32(10), "100 -> 10");
  // The defining property at the top of the range, where a naive r*r check
  // would overflow.
  r := i32.MAX.isqrt();
  assert((r * r) <= i32.MAX, "r*r fits under MAX");
  assert((r + i32(1)) > (i32.MAX / (r + i32(1))), "(r+1) squared would exceed MAX");
  assert(u64(1000000000000).isqrt() == u64(1000000), "a large unsigned square");
});
test("checked_neg, wrapping_mul and overflowing_mul", {
  assert(_some_eq(i32(5).checked_neg(), i32(0 - 5)), "negate a positive");
  assert(_none_i32(i32.MIN.checked_neg()), "MIN has no negation");
  assert(_some_eq_u8(u8(0).checked_neg(), u8(0)), "unsigned zero negates to zero");
  assert(_none_u8(u8(1).checked_neg()), "a non-zero unsigned has no negation");
  assert(u8(16).wrapping_mul(u8(16)) == u8(0), "16*16 wraps to 0 in a u8");
  assert(u8(200).wrapping_mul(u8(2)) == u8(144), "200*2 = 400 wraps to 144");
  assert(i8(100).wrapping_mul(i8(3)) == i8(44), "100*3 = 300 wraps to 44");
  assert(u8(3).wrapping_mul(u8(4)) == u8(12), "no wrap when it fits");
  // Tuples are read by index (`.0` / `.1`) — `match` does not destructure
  // them, same as the existing overflowing_add/sub tests above.
  m := u8(200).overflowing_mul(u8(2));
  assert((m.0 == u8(144)) && (m.1 == true), "u8 200*2 = (144, true)");
  n := u8(3).overflowing_mul(u8(4));
  assert((n.0 == u8(12)) && (n.1 == false), "u8 3*4 = (12, false)");
  o := i8(100).overflowing_mul(i8(3));
  assert((o.0 == i8(44)) && (o.1 == true), "i8 100*3 = (44, true)");
});
test("abs_diff returns the UNSIGNED partner so the full range fits", {
  // The point of the unsigned return type: i32.MAX - i32.MIN does not fit in
  // an i32, but its magnitude does fit a u32.
  assert(i32.MAX.abs_diff(i32.MIN) == u32(4294967295), "MAX to MIN spans the whole u32 range");
  assert(i32(0 - 5).abs_diff(i32(5)) == u32(10), "across zero");
  assert(i32(5).abs_diff(i32(0 - 5)) == u32(10), "argument order does not matter");
  assert(i8.MIN.abs_diff(i8.MAX) == u8(255), "i8 full span");
  assert(u8(3).abs_diff(u8(200)) == u8(197), "unsigned");
  assert(u8(200).abs_diff(u8(3)) == u8(197), "unsigned, other order");
  assert(usize(7).abs_diff(usize(9)) == usize(2), "usize");
  assert(isize(0 - 1).abs_diff(isize(1)) == usize(2), "isize returns usize");
});
test("byte conversions round-trip and respect endianness", {
  be := u32(0x11223344).to_be_bytes();
  assert(be(usize(0)) == u8(0x11), "big-endian: MSB first");
  assert(be(usize(3)) == u8(0x44), "big-endian: LSB last");
  le := u32(0x11223344).to_le_bytes();
  assert(le(usize(0)) == u8(0x44), "little-endian: LSB first");
  assert(le(usize(3)) == u8(0x11), "little-endian: MSB last");
  assert(u32.from_be_bytes(be) == u32(0x11223344), "big-endian round trip");
  assert(u32.from_le_bytes(le) == u32(0x11223344), "little-endian round trip");
  // Every width, and the signed types through their bit pattern.
  assert(u8.from_be_bytes(u8(0x42).to_be_bytes()) == u8(0x42), "u8 round trip");
  assert(u16.from_le_bytes(u16(0xBEEF).to_le_bytes()) == u16(0xBEEF), "u16 round trip");
  assert(u64.from_be_bytes(u64(0x0123456789ABCDEF).to_be_bytes()) == u64(0x0123456789ABCDEF), "u64 round trip");
  assert(i32.from_be_bytes(i32(0 - 2).to_be_bytes()) == i32(0 - 2), "i32 negative round trip");
  assert(i64.from_le_bytes(i64.MIN.to_le_bytes()) == i64.MIN, "i64 MIN round trip");
  // A negative value's big-endian bytes are its two's-complement pattern.
  nb := i32(0 - 1).to_be_bytes();
  assert(nb(usize(0)) == u8(255), "i32(-1) is all ones");
  assert(nb(usize(3)) == u8(255), "i32(-1) is all ones, last byte");
});
// === BITS, the shifts it makes expressible, and the remaining arithmetic ===
// `BITS` is an associated constant beside `MIN`/`MAX`, which is what lets the
// six shift methods be ONE `where(T <: Integer)` blanket impl instead of ten
// copies. The width-dependent BIT batteries above stay per-type for a
// different reason: they need the receiver widened through its own unsigned
// type, which a blanket body cannot spell.
test("BITS reports each type's width", {
  assert(u8.BITS == u32(8), "u8 is 8 bits");
  assert(i8.BITS == u32(8), "i8 is 8 bits");
  assert(u16.BITS == u32(16), "u16");
  assert(i16.BITS == u32(16), "i16");
  assert(u32.BITS == u32(32), "u32");
  assert(i32.BITS == u32(32), "i32");
  assert(u64.BITS == u32(64), "u64");
  assert(i64.BITS == u32(64), "i64");
  // Target-dependent: 32 on wasm32, 64 elsewhere. Assert the INVARIANT rather
  // than a number, and that both agree.
  assert((usize.BITS == u32(32)) || (usize.BITS == u32(64)), "usize is 32 or 64");
  assert(isize.BITS == usize.BITS, "isize matches usize");
  // And that it agrees with what the bit batteries measure.
  assert(u8.MAX.count_ones() == u8.BITS, "u8.MAX has BITS one bits");
  assert(u32.MAX.count_ones() == u32.BITS, "u32.MAX has BITS one bits");
  assert(usize.MAX.count_ones() == usize.BITS, "usize.MAX has BITS one bits");
});
test("checked_shl and checked_shr reject a count at or above the width", {
  assert(_some_eq(i32(1).checked_shl(u32(4)), i32(16)), "1 << 4 = 16");
  assert(_some_eq(i32(16).checked_shr(u32(4)), i32(1)), "16 >> 4 = 1");
  // A shift by the width or more is undefined behaviour in C, so it is not
  // performed at all — the count is rejected before the shift.
  assert(_none_i32(i32(1).checked_shl(u32(32))), "a count equal to the width is rejected");
  assert(_none_i32(i32(1).checked_shl(u32(99))), "and so is a larger one");
  assert(_none_i32(i32(1).checked_shr(u32(32))), "the same for shr");
  assert(_some_eq(i32(1).checked_shl(u32(31)), i32.MIN), "the last legal count sets the sign bit");
  assert(_some_eq_u8(u8(1).checked_shl(u32(7)), u8(128)), "u8's last legal count is 7");
  assert(_none_u8(u8(1).checked_shl(u32(8))), "u8 rejects 8");
});
test("wrapping_shl and wrapping_shr wrap the COUNT, not the value", {
  // Rust's semantics: the count is taken modulo BITS. Bits shifted out are
  // still discarded — that is not what "wrapping" refers to here.
  assert(i32(1).wrapping_shl(u32(32)) == i32(1), "a count of 32 wraps to 0 on i32");
  assert(i32(1).wrapping_shl(u32(33)) == i32(2), "33 wraps to 1");
  assert(u8(1).wrapping_shl(u32(9)) == u8(2), "9 wraps to 1 on u8");
  assert(i32(16).wrapping_shr(u32(32)) == i32(16), "shr wraps the same way");
  // A signed >> is arithmetic: the sign bit is replicated.
  assert(i32(0 - 16).wrapping_shr(u32(2)) == i32(0 - 4), "signed shr is arithmetic");
  assert(u8(200).wrapping_shr(u32(2)) == u8(50), "unsigned shr is logical");
});
test("overflowing_shl and overflowing_shr flag a reduced count", {
  a := i32(1).overflowing_shl(u32(4));
  assert((a.0 == i32(16)) && (a.1 == false), "a legal count does not flag");
  b := i32(1).overflowing_shl(u32(32));
  assert((b.0 == i32(1)) && (b.1 == true), "a count at the width flags, and wraps to 0");
  c := i32(1).overflowing_shr(u32(33));
  assert((c.0 == i32(0)) && (c.1 == true), "shr flags too");
  // Discarding set bits is NOT an overflow here — Rust agrees.
  d := i32.MAX.overflowing_shl(u32(1));
  assert(d.1 == false, "losing bits off the top is not flagged");
});
test("wrapping_pow and overflowing_pow", {
  assert(i32(2).wrapping_pow(u32(10)) == i32(1024), "2^10");
  assert(i32(7).wrapping_pow(u32(0)) == i32(1), "anything^0 is 1");
  assert(i32(0 - 3).wrapping_pow(u32(3)) == i32(0 - 27), "a negative base keeps its sign at an odd exponent");
  // u8: 2^8 = 256 wraps to 0.
  assert(u8(2).wrapping_pow(u32(8)) == u8(0), "2^8 wraps to 0 on u8");
  assert(u8(3).wrapping_pow(u32(5)) == u8(243), "3^5 = 243 still fits u8");
  ok := i32(2).overflowing_pow(u32(10));
  assert((ok.0 == i32(1024)) && (ok.1 == false), "a fitting power does not flag");
  bad := i32(2).overflowing_pow(u32(31));
  assert(bad.1 == true, "2^31 does not fit i32 and flags");
  assert(bad.0 == i32.MIN, "and its wrapped value is MIN");
});
test("wrapping_div, wrapping_rem and saturating_div at MIN / -1", {
  // The ONLY input where these differ from `/` and `%`.
  assert(i32.MIN.wrapping_div(_M1) == i32.MIN, "MIN / -1 wraps back to MIN");
  assert(i32.MIN.wrapping_rem(_M1) == i32(0), "MIN % -1 is 0");
  assert(i32.MIN.saturating_div(_M1) == i32.MAX, "MIN / -1 saturates to MAX");
  // Everything else is ordinary division.
  assert(i32(7).wrapping_div(i32(2)) == i32(3), "7/2 truncates toward zero");
  assert(i32(0 - 7).wrapping_rem(i32(2)) == _M1, "C's % keeps the dividend's sign");
  assert(i32(9).saturating_div(i32(3)) == i32(3), "9/3");
  // On an unsigned type the guard reads `0 / MAX`, which is 0 either way.
  assert(u8(0).wrapping_div(u8.MAX) == u8(0), "unsigned is unaffected");
});
test("overflowing_neg", {
  a := i32(5).overflowing_neg();
  assert((a.0 == i32(0 - 5)) && (a.1 == false), "a representable negation does not flag");
  b := i32.MIN.overflowing_neg();
  assert((b.0 == i32.MIN) && (b.1 == true), "MIN negates to itself and flags");
  // Every nonzero unsigned value overflows on negation — Rust agrees.
  c := u8(1).overflowing_neg();
  assert(c.1 == true, "unsigned 1 cannot be negated");
  d := u8(0).overflowing_neg();
  assert(d.1 == false, "unsigned 0 can");
});
test("checked_div_euclid and checked_rem_euclid", {
  assert(_some_eq(i32(0 - 7).checked_div_euclid(i32(2)), i32(0 - 4)), "euclidean division rounds toward -inf");
  assert(_some_eq(i32(0 - 7).checked_rem_euclid(i32(2)), i32(1)), "and its remainder is non-negative");
  assert(_none_i32(i32(1).checked_div_euclid(i32(0))), "a zero divisor is rejected");
  assert(_none_i32(i32(1).checked_rem_euclid(i32(0))), "for both");
  assert(_none_i32(i32.MIN.checked_div_euclid(_M1)), "MIN / -1 does not fit");
  assert(_none_i32(i32.MIN.checked_rem_euclid(_M1)), "and is rejected by the pair");
});
test("ilog2, ilog10 and ilog", {
  assert(i32(1).ilog2() == u32(0), "log2(1) = 0");
  assert(i32(8).ilog2() == u32(3), "log2(8) = 3");
  assert(i32(9).ilog2() == u32(3), "log2(9) floors to 3");
  assert(i32.MAX.ilog2() == u32(30), "i32.MAX has 31 value bits, so log2 is 30");
  assert(u8.MAX.ilog2() == u32(7), "u8.MAX");
  assert(i32(1).ilog10() == u32(0), "log10(1) = 0");
  assert(i32(9).ilog10() == u32(0), "log10(9) floors to 0");
  assert(i32(10).ilog10() == u32(1), "log10(10) = 1");
  assert(i32(999).ilog10() == u32(2), "log10(999) floors to 2");
  assert(i32(1000).ilog10() == u32(3), "log10(1000) = 3");
  assert(i32(100).ilog(i32(10)) == u32(2), "ilog base 10");
  assert(i32(27).ilog(i32(3)) == u32(3), "ilog base 3");
  assert(i32(26).ilog(i32(3)) == u32(2), "and it floors");
  assert(i32(1).ilog(i32(2)) == u32(0), "ilog(1) is 0 for any base");
});
test("unsigned_abs is the one total absolute value", {
  // `abs` PANICS at MIN, whose magnitude does not fit the signed type. The
  // magnitude does fit the unsigned counterpart exactly, which is the whole
  // point of `unsigned_abs`.
  assert(i32(0 - 5).unsigned_abs() == u32(5), "a negative value's magnitude");
  assert(i32(5).unsigned_abs() == u32(5), "a positive value is unchanged");
  assert(i32(0).unsigned_abs() == u32(0), "zero");
  assert(i32.MIN.unsigned_abs() == u32(2147483648), "i32.MIN's magnitude is 2^31");
  assert(i8.MIN.unsigned_abs() == u8(128), "i8.MIN's magnitude is 2^7");
  assert(i16.MIN.unsigned_abs() == u16(32768), "i16.MIN");
  assert(i64.MIN.unsigned_abs() == u64(9223372036854775808), "i64.MIN's magnitude is 2^63");
  assert(isize(0 - 3).unsigned_abs() == usize(3), "isize");
});
