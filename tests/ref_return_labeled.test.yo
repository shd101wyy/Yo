/// Parser-level coverage for the labeled-ref-return forms.
///
/// All three spellings should produce a function type with
/// `isReturnTypeRef` set:
///   1. `-> ref(T)`                — unlabeled (original)
///   2. `-> (name : ref(T))`       — labeled, ref on type (original)
///   3. `-> (ref(name) : T)`       — labeled, ref on label (new)
///
/// And `-> (ref(name) : ref(T))` (double-ref) should be rejected
/// with a "pick one form" diagnostic.
///
/// Bodies use `panic("...")` (which has type Never and widens to
/// any return type) so each declaration exercises the return-slot
/// PARSE without depending on the body-type story. If the labeled
/// form regressed, the declaration would fail with the previous
/// "Expected a valid variable name for return label" error well
/// before the body-type check runs.
pragma(Pragma.AllowUnsafe);
// ── (1) `-> ref(T)` — unlabeled, original form. ─────────────────
get_unlabeled :: (fn(ref(p) : i32) -> ref(i32))(panic("unreachable"));
// ── (2) `-> (name : ref(T))` — labeled, ref on type. ────────────
get_label_then_ref :: (fn(ref(p) : i32) -> (result : ref(i32)))(panic("unreachable"));
// ── (3) `-> (ref(name) : T)` — labeled, ref on label (new). ─────
get_ref_then_label :: (fn(ref(p) : i32) -> (ref(result) : i32))(panic("unreachable"));
// ── (4) Double-ref is rejected with the pick-one diagnostic. ────
comptime_expect_error(
  bad_double_ref :: (fn(ref(p) : i32) -> (ref(result) : ref(i32)))(panic("unreachable"))
);
test("labeled-ref-return: all three forms type-check (parse-level guardrail)", {
  // The mere fact that this test runs means the four declarations
  // above all evaluated successfully (cases 1-3) or were correctly
  // rejected (case 4). No runtime work needed.
  assert(true, "declarations type-check");
});
