/// Parser-level coverage for labeled ref/comptime return-slot forms.
///
/// A modifier on a LABELED return slot goes on the LABEL, never on the
/// type — consistent with the parameter convention (`ref(name) : T`).
///
/// Valid:
///   (1) `-> ref(T)`           — unlabeled (modifier on the sole type)
///   (2) `-> (ref(name) : T)`  — labeled, ref on the label
///
/// Rejected:
///   (3) `-> (name : ref(T))`       — ref on the type when labeled
///   (4) `-> (ref(name) : ref(T))`  — ref on both (double-ref)
///   (5) `-> (name : comptime(T))`  — comptime on the type when labeled
///
/// Bodies use `panic("...")` (type Never, widens to any return type) so
/// each declaration exercises the return-slot PARSE without depending on
/// the body-type story. For the rejected cases the diagnostic fires while
/// evaluating the function TYPE, before the body is ever evaluated.
pragma(Pragma.AllowUnsafe);
// ── (1) `-> ref(T)` — unlabeled, valid. ─────────────────────────
get_unlabeled :: (fn(ref(p) : i32) -> ref(i32))(panic("unreachable"));
// ── (2) `-> (ref(name) : T)` — labeled, ref on label, valid. ────
get_ref_then_label :: (fn(ref(p) : i32) -> (ref(result) : i32))(panic("unreachable"));
// ── (3) `-> (name : ref(T))` — ref on the type is REJECTED. ─────
comptime_expect_error(
  bad_label_then_ref :: (fn(ref(p) : i32) -> (result : ref(i32)))(panic("unreachable"))
);
// ── (4) Double-ref `(ref(name) : ref(T))` is REJECTED. ──────────
comptime_expect_error(
  bad_double_ref :: (fn(ref(p) : i32) -> (ref(result) : ref(i32)))(panic("unreachable"))
);
// ── (5) `-> (name : comptime(T))` — comptime on the type REJECTED. ─
comptime_expect_error(
  bad_label_then_comptime :: (fn() -> (result : comptime(i32)))(panic("unreachable"))
);
test("labeled ref/comptime return forms: modifier-on-label rule enforced", {
  // The mere fact that this test runs means the valid declarations (1-2)
  // evaluated successfully and the invalid ones (3-5) were correctly
  // rejected. No runtime work needed.
  assert(true, "declarations type-check");
});
