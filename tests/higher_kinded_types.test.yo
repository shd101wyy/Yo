open import "std/fmt";
open import "std/string";

// ─────────────────────────────────────────────────────
// Test 1: Basic TypeApplication — forall with function kind
// ─────────────────────────────────────────────────────
identity :: (fn(
  forall(F : (fn(comptime(T) : Type) -> comptime(Type)), A : Type),
  x: F(A)
) -> F(A))(x);

test "Basic HKT identity function", {
  (x : Option(i32)) = .Some(i32(42));
  result := identity(forall(Option, i32), x);
  match(result,
    .Some(v) => {
      assert((v == i32(42)), "expected 42");
    },
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
};

// ─────────────────────────────────────────────────────
// Test 2: Functor trait definition and Option impl
// ─────────────────────────────────────────────────────
Functor :: (fn(comptime(F) : (fn(comptime(T) : Type) -> comptime(Type))) -> comptime(Trait))(
  trait(
    map : (fn(forall(A : Type, B : Type), self: F(A), f: (fn(a : A) -> B)) -> F(B))
  )
);

impl(forall(A : Type), Option(A), Functor(Option)(
  map : (fn(forall(A : Type, B : Type), self: Option(A), f: (fn(a : A) -> B)) -> Option(B))(
    match(self,
      .Some(v) => .Some(f(v)),
      .None => .None
    )
  )
));

test "Functor map on Option Some", {
  (x : Option(i32)) = .Some(i32(42));
  result := x.map(forall(i32), (fn(a: i32) -> i32)((a + i32(1))));
  match(result,
    .Some(v) => {
      assert((v == i32(43)), "expected 43");
    },
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
};

test "Functor map on Option None", {
  (x : Option(i32)) = .None;
  result := x.map(forall(i32), (fn(a: i32) -> i32)((a + i32(1))));
  match(result,
    .Some(_) => assert(false, "expected None"),
    .None => ()
  );
  println(`  passed`);
};

test "Functor map changing type", {
  (x : Option(i32)) = .Some(i32(42));
  result := x.map(forall(bool), (fn(a: i32) -> bool)((a > i32(0))));
  match(result,
    .Some(v) => {
      assert(v, "expected true");
    },
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
};

// ─────────────────────────────────────────────────────
// Test 3: Generic function using HKT (do_map with where clause)
// ─────────────────────────────────────────────────────
do_map :: (fn(
  forall(F : (fn(comptime(T) : Type) -> comptime(Type)), A : Type, B : Type),
  container: F(A),
  f: (fn(a : A) -> B),
  where(F(A) <: Functor(F))
) -> F(B))(
  container.map(forall(B), f)
);

test "Generic do_map with where clause", {
  (x : Option(i32)) = .Some(i32(10));
  result := do_map(forall(Option, i32, i32), x, (fn(a: i32) -> i32)((a * i32(2))));
  match(result,
    .Some(v) => {
      assert((v == i32(20)), "expected 20");
    },
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
};

// ─────────────────────────────────────────────────────
// Test 4: Partial application with `_` placeholder
// ─────────────────────────────────────────────────────
test "Partial application Result(_, i32)", {
  IntResult :: Result(_, i32);
  (r : IntResult(bool)) = .Ok(true);
  match(r,
    .Ok(v) => assert(v, "expected true"),
    .Err(_) => assert(false, "expected Ok")
  );
  println(`  passed`);
};

test "Partial application Result(str, _)", {
  StrOkResult :: Result(str, _);
  (r : StrOkResult(i32)) = .Err(i32(404));
  match(r,
    .Ok(_) => assert(false, "expected Err"),
    .Err(e) => assert((e == i32(404)), "expected 404")
  );
  println(`  passed`);
};

// ─────────────────────────────────────────────────────
// Test 5: Container trait (simpler HKT with get_value)
// ─────────────────────────────────────────────────────
Container :: (fn(comptime(F) : (fn(comptime(T) : Type) -> comptime(Type))) -> comptime(Trait))(
  trait(
    get_value : (fn(forall(A : Type), self: F(A)) -> A)
  )
);

impl(forall(A : Type), Option(A), Container(Option)(
  get_value : (fn(forall(A : Type), self: Option(A)) -> A)(
    match(self,
      .Some(v) => v,
      .None => panic("called get_value on None")
    )
  )
));

test "Container get_value on Option", {
  (x : Option(i32)) = .Some(i32(99));
  v := x.get_value();
  assert((v == i32(99)), "expected 99");
  println(`  passed`);
};

// ─────────────────────────────────────────────────────
// Test 6: HKT with multiple trait methods
// ─────────────────────────────────────────────────────
Mappable :: (fn(comptime(F) : (fn(comptime(T) : Type) -> comptime(Type))) -> comptime(Trait))(
  trait(
    transform : (fn(forall(A : Type, B : Type), self: F(A), f: (fn(a : A) -> B)) -> F(B)),
    contains_value : (fn(forall(A : Type), self: F(A)) -> bool)
  )
);

impl(forall(A : Type), Option(A), Mappable(Option)(
  transform : (fn(forall(A : Type, B : Type), self: Option(A), f: (fn(a : A) -> B)) -> Option(B))(
    match(self,
      .Some(v) => .Some(f(v)),
      .None => .None
    )
  ),
  contains_value : (fn(forall(A : Type), self: Option(A)) -> bool)(
    match(self,
      .Some(_) => true,
      .None => false
    )
  )
));

test "Multiple trait methods with HKT", {
  (x : Option(i32)) = .Some(i32(5));
  (y : Option(i32)) = .None;
  assert(x.contains_value(), "Some should contain value");
  assert(!(y.contains_value()), "None should not contain value");
  result := x.transform(forall(i32), (fn(a: i32) -> i32)((a + i32(10))));
  match(result,
    .Some(v) => assert((v == i32(15)), "expected 15"),
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
};

// ─────────────────────────────────────────────────────
// Test 7: Comptime assertions on HKT types
// ─────────────────────────────────────────────────────
test "Comptime HKT basic assertion", {
  // Verify HKT definitions are valid at compile time
  // The fact that Functor, Container, Mappable traits compile
  // and their impls pass type checking IS the comptime assertion
  comptime_assert(true, "HKT traits and impls compile successfully");
  println(`  passed`);
};

// ─────────────────────────────────────────────────────
// Test 8: HKT used with do_map on None
// ─────────────────────────────────────────────────────
test "do_map on None preserves None", {
  (x : Option(i32)) = .None;
  result := do_map(forall(Option, i32, bool), x, (fn(a: i32) -> bool)((a > i32(0))));
  match(result,
    .Some(_) => assert(false, "expected None"),
    .None => ()
  );
  println(`  passed`);
};

// ─────────────────────────────────────────────────────
// Test 9: Partial application used as HKT forall arg
// ─────────────────────────────────────────────────────
test "Partial application as HKT forall arg", {
  IntResult :: Result(_, i32);
  (r : IntResult(bool)) = .Ok(true);
  match(r,
    .Ok(v) => {
      assert(v, "expected true from IntResult(bool).Ok");
    },
    .Err(_) => assert(false, "expected Ok")
  );

  // Partial apply on second arg
  BoolResult :: Result(bool, _);
  (r2 : BoolResult(str)) = .Ok(false);
  match(r2,
    .Ok(v) => assert(!(v), "expected false"),
    .Err(_) => assert(false, "expected Ok")
  );
  println(`  passed`);
};
