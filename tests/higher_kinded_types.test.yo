{ assert } :: import("std/assert");
open(import("std/fmt"));
open(import("std/string"));
// ─────────────────────────────────────────────────────
// Test 1: Basic TypeApplication — generic with function kind
// ─────────────────────────────────────────────────────
identity :: (
  fn(
    generic(F : (fn(comptime(T) : Type) -> comptime(Type)), A : Type),
    x : F(A)
  ) -> F(A)
)(x);
test("Basic HKT identity function", {
  (x : Option(i32)) = .Some(i32(42));
  result := identity(generic(Option, i32), x);
  match(
    result,
    .Some(v) => {
      assert(v == i32(42), "expected 42");
    },
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 2: Functor trait definition and Option impl
// ─────────────────────────────────────────────────────
Functor :: (fn(comptime(F) : (fn(comptime(T) : Type) -> comptime(Type))) -> comptime(Trait))(
  trait(
    map : (fn(generic(A : Type, B : Type), self : F(A), f : (fn(a : A) -> B)) -> F(B))
  )
);
impl(
  generic(A : Type),
  Option(A),
  Functor(Option)(
    map : (fn(generic(A : Type, B : Type), self : Option(A), f : (fn(a : A) -> B)) -> Option(B))(
      match(
        self,
        .Some(v) => .Some(f(v)),
        .None => .None
      )
    )
  )
);
test("Functor map on Option Some", {
  (x : Option(i32)) = .Some(i32(42));
  result := x.map(generic(i32), (fn(a : i32) -> i32)(a + i32(1)));
  match(
    result,
    .Some(v) => {
      assert(v == i32(43), "expected 43");
    },
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
test("Functor map on Option None", {
  (x : Option(i32)) = .None;
  result := x.map(generic(i32), (fn(a : i32) -> i32)(a + i32(1)));
  match(
    result,
    .Some(_) => assert(false, "expected None"),
    .None => ()
  );
  println(`  passed`);
});
test("Functor map changing type", {
  (x : Option(i32)) = .Some(i32(42));
  result := x.map(generic(bool), (fn(a : i32) -> bool)(a > i32(0)));
  match(
    result,
    .Some(v) => {
      assert(v, "expected true");
    },
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 3: Generic function using HKT (do_map with where clause)
// ─────────────────────────────────────────────────────
do_map :: (
  fn(
    generic(F : (fn(comptime(T) : Type) -> comptime(Type)), A : Type, B : Type),
    container : F(A),
    f : (fn(a : A) -> B),
    where(F(A) <: Functor(F))
  ) -> F(B)
)(
  container.map(generic(B), f)
);
test("Generic do_map with where clause", {
  (x : Option(i32)) = .Some(i32(10));
  result := do_map(generic(Option, i32, i32), x, (fn(a : i32) -> i32)(a * i32(2)));
  match(
    result,
    .Some(v) => {
      assert(v == i32(20), "expected 20");
    },
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 4: Partial application with `_` placeholder
// ─────────────────────────────────────────────────────
test("Partial application Result(_, i32)", {
  IntResult :: Result(_, i32);
  (r : IntResult(bool)) = .Ok(true);
  match(
    r,
    .Ok(v) => assert(v, "expected true"),
    .Err(_) => assert(false, "expected Ok")
  );
  println(`  passed`);
});
test("Partial application Result(str, _)", {
  StrOkResult :: Result(str, _);
  (r : StrOkResult(i32)) = .Err(i32(404));
  match(
    r,
    .Ok(_) => assert(false, "expected Err"),
    .Err(e) => assert(e == i32(404), "expected 404")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 5: Container trait (simpler HKT with get_value)
// ─────────────────────────────────────────────────────
Container :: (fn(comptime(F) : (fn(comptime(T) : Type) -> comptime(Type))) -> comptime(Trait))(
  trait(
    get_value : (fn(generic(A : Type), self : F(A)) -> A)
  )
);
impl(
  generic(A : Type),
  Option(A),
  Container(Option)(
    get_value : (fn(generic(A : Type), self : Option(A)) -> A)(
      match(
        self,
        .Some(v) => v,
        .None => __yo_panic("called get_value on None")
      )
    )
  )
);
test("Container get_value on Option", {
  (x : Option(i32)) = .Some(i32(99));
  v := x.get_value();
  assert(v == i32(99), "expected 99");
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 6: HKT with multiple trait methods
// ─────────────────────────────────────────────────────
Mappable :: (fn(comptime(F) : (fn(comptime(T) : Type) -> comptime(Type))) -> comptime(Trait))(
  trait(
    transform : (fn(generic(A : Type, B : Type), self : F(A), f : (fn(a : A) -> B)) -> F(B)),
    contains_value : (fn(generic(A : Type), self : F(A)) -> bool)
  )
);
impl(
  generic(A : Type),
  Option(A),
  Mappable(Option)(
    transform : (fn(generic(A : Type, B : Type), self : Option(A), f : (fn(a : A) -> B)) -> Option(B))(
      match(
        self,
        .Some(v) => .Some(f(v)),
        .None => .None
      )
    ),
    contains_value : (fn(generic(A : Type), self : Option(A)) -> bool)(
      match(
        self,
        .Some(_) => true,
        .None => false
      )
    )
  )
);
test("Multiple trait methods with HKT", {
  (x : Option(i32)) = .Some(i32(5));
  (y : Option(i32)) = .None;
  assert(x.contains_value(), "Some should contain value");
  assert(!y.contains_value(), "None should not contain value");
  result := x.transform(generic(i32), (fn(a : i32) -> i32)(a + i32(10)));
  match(
    result,
    .Some(v) => assert(v == i32(15), "expected 15"),
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 7: Comptime assertions on HKT types
// ─────────────────────────────────────────────────────
test("Comptime HKT basic assertion", {
  // Verify HKT definitions are valid at compile time
  // The fact that Functor, Container, Mappable traits compile
  // and their impls pass type checking IS the comptime assertion
  comptime_assert(true, "HKT traits and impls compile successfully");
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 8: HKT used with do_map on None
// ─────────────────────────────────────────────────────
test("do_map on None preserves None", {
  (x : Option(i32)) = .None;
  result := do_map(generic(Option, i32, bool), x, (fn(a : i32) -> bool)(a > i32(0)));
  match(
    result,
    .Some(_) => assert(false, "expected None"),
    .None => ()
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 9: Partial application used as HKT generic arg
// ─────────────────────────────────────────────────────
test("Partial application as HKT generic arg", {
  IntResult :: Result(_, i32);
  (r : IntResult(bool)) = .Ok(true);
  match(
    r,
    .Ok(v) => {
      assert(v, "expected true from IntResult(bool).Ok");
    },
    .Err(_) => assert(false, "expected Ok")
  );
  // Partial apply on second arg
  BoolResult :: Result(bool, _);
  (r2 : BoolResult(str)) = .Ok(false);
  match(
    r2,
    .Ok(v) => assert(!v, "expected false"),
    .Err(_) => assert(false, "expected Ok")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 10: Partial application — chained usage
// ─────────────────────────────────────────────────────
test("Partial application chained usage", {
  IntResult :: Result(_, i32);
  (ok_val : IntResult(i32)) = .Ok(i32(99));
  (err_val : IntResult(i32)) = .Err(i32(42));
  // Use ok/err to convert and verify types match
  opt_ok := ok_val.ok();
  match(
    opt_ok,
    .Some(v) => assert(v == i32(99), "expected 99"),
    .None => assert(false, "expected Some")
  );
  opt_err := err_val.err();
  match(
    opt_err,
    .Some(e) => assert(e == i32(42), "expected 42"),
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 11: Partial application — multiple placeholders rejected
// ─────────────────────────────────────────────────────
test("Partial application leaves one placeholder", {
  // Single placeholder at different positions
  First :: Result(_, bool);
  Second :: Result(i32, _);
  (a : First(i32)) = .Ok(i32(1));
  (b : Second(bool)) = .Err(false);
  match(
    a,
    .Ok(v) => assert(v == i32(1), "expected 1"),
    .Err(_) => assert(false, "expected Ok")
  );
  match(
    b,
    .Ok(_) => assert(false, "expected Err"),
    .Err(e) => assert(!e, "expected false")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 12: HKT identity preserves nested types
// ─────────────────────────────────────────────────────
test("HKT identity with nested Option", {
  (x : Option(bool)) = .Some(true);
  result := identity(generic(Option, bool), x);
  match(
    result,
    .Some(v) => assert(v, "expected true"),
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 13: Functor map with closures
// ─────────────────────────────────────────────────────
test("Functor map with different values", {
  (x : Option(i32)) = .Some(i32(5));
  result := x.map(generic(i32), (fn(a : i32) -> i32)(a + i32(100)));
  match(
    result,
    .Some(v) => assert(v == i32(105), "expected 105"),
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 14: do_map with type-changing transform
// ─────────────────────────────────────────────────────
test("do_map with type change", {
  (x : Option(i32)) = .Some(i32(0));
  result := do_map(generic(Option, i32, bool), x, (fn(a : i32) -> bool)(a == i32(0)));
  match(
    result,
    .Some(v) => assert(v, "expected true (0 == 0)"),
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 15: Container trait with get_value on Some
// ─────────────────────────────────────────────────────
test("Container get_value with bool", {
  (x : Option(bool)) = .Some(false);
  v := x.get_value();
  assert(!v, "expected false");
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 16: Mappable trait — transform then check
// ─────────────────────────────────────────────────────
test("Mappable transform and contains_value", {
  (x : Option(i32)) = .Some(i32(3));
  assert(x.contains_value(), "Some should contain value");
  transformed := x.transform(generic(bool), (fn(a : i32) -> bool)(a > i32(0)));
  assert(transformed.contains_value(), "transformed should contain value");
  match(
    transformed,
    .Some(v) => assert(v, "expected true (3 > 0)"),
    .None => assert(false, "expected Some")
  );
  println(`  passed`);
});
// ─────────────────────────────────────────────────────
// Test 17: Mappable on None — transform returns None
// ─────────────────────────────────────────────────────
test("Mappable transform on None", {
  (x : Option(i32)) = .None;
  assert(!x.contains_value(), "None should not contain value");
  result := x.transform(generic(bool), (fn(a : i32) -> bool)(true));
  assert(!result.contains_value(), "transformed None should not contain value");
  match(
    result,
    .Some(_) => assert(false, "expected None"),
    .None => ()
  );
  println(`  passed`);
});
