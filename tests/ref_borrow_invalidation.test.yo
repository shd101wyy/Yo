//! The borrow-invalidation gates of the v4 era were REMOVED together with
//! the `inout(name) := …` local binding; the binding form is BACK
//! (plans/INOUT_LOCAL_BINDINGS_AUDIT.md, 2026-09-07) but it names a SLOT, not
//! an element, so there is still nothing a container operation can
//! invalidate. These tests pin the element-access model: `get` returns the
//! element (a HANDLE for object types) that no container operation can
//! invalidate, and a binding to the container VARIABLE survives any growth
//! of the container it names.
{ assert } :: import("std/assert");
import("std/fmt");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");

// The historical UAF shape — borrow, then grow — cannot dangle any more:
// `inout(r) := xs` names xs's SLOT (the handle), not an element inside its
// buffer, so 64 pushes (the realloc trigger of the original repro) leave `r`
// pointing at the same, still-valid list handle.
test("inout binding to the container variable survives container growth", {
  xs := ArrayList(String).new();
  xs.push(String.from("element-zero"));
  inout(r) := xs;
  i := usize(0);
  while(i < usize(64), {
    xs.push(String.from("filler"));
    i = (i + usize(1));
  });
  assert(r.len() == usize(65), "the binding sees every push");
  assert(match(r.get(usize(0)), .Some(s) => (s == "element-zero"), .None => false), "first element through the binding");
  r = ArrayList(String).new();
  assert(xs.len() == usize(0), "assigning through the binding replaced the container");
});

// `get` returns a HANDLE to the element object — it points at the
// String itself, not into the list's buffer, so container growth
// (realloc) cannot invalidate it. 64 pushes is the realloc trigger from
// the historical UAF repro that motivated the (now deleted) gates.
test("get handle survives container growth", {
  xs := ArrayList(String).new();
  xs.push(String.from("element-zero"));
  e := match(xs.get(usize(0)), .Some(s) => s, .None => String.new());
  i := usize(0);
  while(i < usize(64), {
    xs.push(String.from("filler"));
    i = (i + usize(1));
  });
  assert(e == "element-zero", "handle valid after 64 pushes (realloc)");
  assert(xs.len() == usize(65), "all pushes landed");
});

// Even REASSIGNING the container cannot invalidate a held element
// handle — the handle owns a +1 on the element object. This exact shape
// was a compile error under the old gates; under the value model it is
// simply safe.
test("container freely reassignable while holding an element handle", {
  xs := ArrayList(String).new();
  xs.push(String.from("element-zero"));
  e := match(xs.get(usize(0)), .Some(s) => s, .None => String.new());
  xs = ArrayList(String).new();
  assert(e == "element-zero", "element handle survives the reassign");
  assert(xs.len() == usize(0), "container replaced");
});

// Object elements mutate in place through the get handle — no borrow
// needed.
test("object element mutates in place through a get handle", {
  xs := ArrayList(String).new();
  xs.push(String.from("hello"));
  e := match(xs.get(usize(0)), .Some(s) => s, .None => String.new());
  e.push_str(" world");
  assert(match(xs.get(usize(0)), .Some(s) => (s == "hello world"), .None => false), "mutated in place");
});
