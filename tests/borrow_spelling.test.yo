// `&T` / `&mut T`: the one spelling of a borrow in every slot
// (plans/VALUES_BY_DEFAULT.md decision 42, Generation A). Each form is an
// exact synonym of the mode words it replaces: a parameter or receiver
// `x : &T` is `imm(x) : T` and `x : &mut T` is `mut(x) : T`, a local borrow
// `y := &place` is `imm(y) := place`, a re-point `cur = &mut place` is
// `mut(cur) = place`, a capture `{ y : &y, z : &mut z }` is
// `{ imm(y) : &y, mut(z) : &mut z }`, and the borrowed loop
// `for(&mut xs, x => …)` is `for(xs, mut(x) => …)`. The function-type
// identities below pin "exact": a function declared in one spelling fills a
// slot typed in the other. A `&T` anywhere else is a borrow mode, not a type
// (references become types with decision 43).
//
// `&&T` is a parse error, so it is pinned by tests/internal/parser.test.yo.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
Point :: struct(x : i32, y : i32);
derive(Point, Copy, Clone);
Counter :: struct(n : i32);
impl(
  Counter,
  bump : (fn(self : &mut Self, by : i32) -> unit)({
    self.n = (self.n + by);
  }),
  get : (fn(self : &Self) -> i32)(self.n)
);
// A move-only value with a Drop counter: a borrow neither copies nor
// drops what it lends.
(mut(g_bs_disposed) : i32) = i32(0);
Tracked :: struct(n : i32);
impl(
  Tracked,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_bs_disposed = (g_bs_disposed + i32(1));
    })
  )
);
len_of :: (fn(s : &String) -> usize)(s.len());
bump :: (fn(n : &mut i32) -> unit)({
  n = (n + i32(1));
});
tracked_n :: (fn(t : &Tracked) -> i32)(t.n);
tracked_set :: (fn(t : &mut Tracked, v : i32) -> unit)({
  t.n = v;
});
twice :: (fn(comptime(k) : &i32) -> i32)(k + k);
apply :: (fn(f : &Impl(Fn(v : &String) -> usize), s : &String) -> usize)(f(&s));
apply_mut :: (fn(f : &Impl(Fn(v : &mut i32) -> unit), n : &mut i32) -> unit)(f(&mut n));
old_len_of :: (fn(s : &String) -> usize)(s.len());
old_bump :: (fn(n : &mut i32) -> unit)({
  n = (n + i32(1));
});
// A `ref` object, not an `Rc`: the cursor walk writes `next` through each
// node, and an `Rc`'s payload is read-only (decision 46).
Node :: ref(struct(value : i32, next : Option(Self)));
List :: struct(head : Option(Node));
append :: (fn(list : &mut List, v : i32) -> unit)({
  cur := &mut list.head;
  while(cur.is_some(), {
    match(
      cur,
      .Some(n) => {
        cur = &mut n.next;
      },
      .None => ()
    );
  });
  cur = .Some(Node(value : v, next : .None));
});
sum_list :: (fn(list : &List) -> i32)({
  (mut(total) : i32) = i32(0);
  cur := &list.head;
  while(cur.is_some(), {
    match(
      cur,
      .Some(n) => {
        total = (total + n.value);
        cur = &n.next;
      },
      .None => ()
    );
  });
  total
});

// --- Parameters and receivers -------------------------------------------------
test("a `&T` parameter borrows: the argument stays usable", {
  s := String.from("abc");
  assert(len_of(&s) == usize(3), "read through the borrow");
  assert(s.len() == usize(3), "s was lent, not moved");
});
test("a `&mut T` parameter writes the caller's place", {
  (mut(k) : i32) = i32(1);
  bump(&mut k);
  bump(&mut k);
  assert(k == i32(3), "both writes landed");
});
test("receivers `self : &Self` and `self : &mut Self`", {
  mut(c) := Counter(n : i32(1));
  c.bump(i32(4));
  assert(c.get() == i32(5), "the &mut receiver wrote, the & receiver read");
});
test("a `comptime(x) : &T` parameter", {
  assert(twice(i32(21)) == i32(42), "comptime(imm(k)) : i32 under the new spelling");
});
test("each spelling fills a slot typed in the other: one function type", {
  (f1 : (fn(s : &String) -> usize)) = len_of;
  (f2 : (fn(s : &String) -> usize)) = old_len_of;
  (g1 : (fn(n : &mut i32) -> unit)) = bump;
  (g2 : (fn(n : &mut i32) -> unit)) = old_bump;
  s := String.from("ab");
  (mut(k) : i32) = i32(0);
  g1(&mut k);
  g2(&mut k);
  assert(((f1(&s) + f2(&s)) == usize(4)) && (k == i32(2)), "all four calls borrowed");
});
test("a borrowed move-only value is neither moved nor dropped by the call", {
  before := g_bs_disposed;
  {
    mut(t) := Tracked(n : i32(7));
    assert(tracked_n(&t) == i32(7), "read through &Tracked");
    tracked_set(&mut t, i32(9));
    assert(tracked_n(&t) == i32(9), "written through &mut Tracked");
    assert(g_bs_disposed == before, "no call dropped the lent value");
  };
  assert(g_bs_disposed == (before + i32(1)), "the owner dropped it once, at its scope end");
});

// --- Fn slots and closure parameters ------------------------------------------
test("`Fn(v : &T)` slots and `(v : &T) => …` closure parameters", {
  s := String.from("hello");
  assert(apply((v : &String) => v.len(), &s) == usize(5), "a closure parameter borrows");
  (mut(k) : i32) = i32(1);
  apply_mut((v : &mut i32) => {
    v = (v * i32(10));
  }, &mut k);
  assert(k == i32(10), "a &mut closure parameter wrote the caller's place");
  assert(s.len() == usize(5), "s is still usable");
});

// --- Local borrows and re-points ------------------------------------------------
test("`y := &place` reads through and `y := &mut place` writes through", {
  s := String.from("abc");
  y := &s;
  assert(y.len() == usize(3), "read through the borrow");
  mut(x) := i32(1);
  z := &mut x;
  z = i32(5);
  assert(x == i32(5), "the write through z landed in x");
  mut(p) := Point(x : i32(1), y : i32(2));
  px := &mut p.x;
  px = i32(8);
  assert(p.x == i32(8), "a field borrow wrote the field");
});
test("the annotated local borrow `(y : &T) = &place`", {
  s := String.from("xy");
  (y : &String) = &s;
  assert(y.len() == usize(2), "read through the annotated borrow");
  (mut(n) : i32) = i32(3);
  (m : &mut i32) = &mut n;
  m = i32(4);
  assert(n == i32(4), "written through the annotated &mut borrow");
});
test("a local borrow of a move-only value drops nothing", {
  before := g_bs_disposed;
  {
    mut(t) := Tracked(n : i32(2));
    {
      r := &t;
      assert(r.n == i32(2), "read through r");
      w := &mut t;
      w.n = i32(6);
    };
    assert(g_bs_disposed == before, "the borrows' scope end dropped nothing");
    assert(t.n == i32(6), "the write through w landed");
  };
  assert(g_bs_disposed == (before + i32(1)), "t was dropped once");
});
test("the cursor walk re-points with `cur = &mut n.next` (decision 25)", {
  mut(l) := List(head : .None);
  append(&mut l, i32(1));
  append(&mut l, i32(2));
  append(&mut l, i32(3));
  assert(sum_list(&l) == i32(6), "three nodes, in order, walked with `cur = &n.next`");
});

// --- Capture lists ------------------------------------------------------------
test("capture list `{ y : &y, z : &mut z }` and the puns `{ &y, &mut z }`", {
  y := i32(10);
  mut(z) := i32(1);
  {
    (h : Impl(Fn(m : i32) -> i32)) = ({ y : &y, z : &mut z }(m : i32) => {
      z = (z + (y + m));
      z
    });
    assert(h(i32(1)) == i32(12), "read y, wrote z");
  };
  assert(z == i32(12), "the &mut capture wrote the caller's z");
  {
    (g : Impl(Fn() -> i32)) = ({ &y, &mut z }() => {
      z = (z + y);
      z
    });
    assert(g() == i32(22), "the puns borrow the same places");
  };
  assert(z == i32(22), "the &mut pun wrote z");
});

// --- The borrowed `for` ---------------------------------------------------------
test("`for(&xs, x => …)` reads and `for(&mut xs, x => …)` writes in place", {
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  xs.push(i32(3));
  (mut(sum) : i32) = i32(0);
  for(&xs, x => {
    sum = (sum + x);
  });
  assert(sum == i32(6), "the read loop saw every element");
  for(&mut xs, x => {
    x = (x * i32(10));
  });
  assert((xs(usize(0)) == i32(10)) && (xs(usize(2)) == i32(30)), "the &mut loop wrote each element in place");
  ps := ArrayList(Point).new();
  ps.push(Point(x : i32(1), y : i32(1)));
  for(&mut ps, p => {
    p.x = i32(5);
  });
  assert(ps(usize(0)).x == i32(5), "a struct element was written in place");
});
test("the map form `for(&mut m, (k, v) => …)` borrows the value only", {
  m := HashMap(i32, i32).new();
  m.insert(i32(1), i32(10));
  m.insert(i32(2), i32(20));
  for(&mut m, (k, v) => {
    v = (v + k);
  });
  assert((m.get(i32(1)) == .Some(i32(11))) && (m.get(i32(2)) == .Some(i32(22))), "each value was written in place");
});

// --- A borrow is a mode, not a type ---------------------------------------------
comptime_expect_error(
  bs_type_alias :: (fn() -> unit)({
    T :: &i32;
  }),
  "is a borrow mode, not a type"
);
comptime_expect_error(
  bs_type_argument :: (fn() -> unit)({
    _xs := ArrayList(&i32).new();
  }),
  "is a borrow mode, not a type"
);
comptime_expect_error(
  bs_mut_type_argument :: (fn() -> unit)({
    _o := Option(&mut i32).None;
  }),
  "is a borrow mode, not a type"
);
comptime_expect_error(
  bs_field_type :: (fn() -> unit)({
    S :: struct(f : &i32);
  }),
  "is a borrow mode, not a type"
);
// `&mut(T, p)` is decision 43's origin-qualified reference. Its
// two-argument marker used to re-evaluate itself until `yo check`
// overflowed its stack (exit 139), in every type position
// (issues/fixed/2026-10-21-an-origin-qualified-mut-reference-overflows-the-checker-stack.md).
// Decision 43 step 2 spells it as a parameter's type (N1a) and as a
// result type (N1b); a pointee, a local's annotation and a type argument
// come later.
comptime_expect_error(
  bs_origin_mut_pointee :: (fn(xs : &mut i32) -> &mut&mut(i32, xs))(xs),
  "is an origin-qualified reference"
);
// The second argument is read by its kind: a type there is E0922, not a
// tuple (a tuple type is `Tuple(A, B)`).
comptime_expect_error(
  bs_origin_mut_param :: (fn(xs : &mut(i32, i32)) -> unit)(()),
  "is a type, not an origin"
);
comptime_expect_error(
  bs_origin_mut_type_argument :: (fn() -> unit)({
    _o := Option(&mut(i32, i32)).None;
  }),
  "is an origin-qualified reference"
);
// A borrow result is a projection (decision 24): it yields a place spelled
// with its sigil, never a value.
comptime_expect_error(
  bs_result :: (fn(s : &String) -> &String)(s),
  "a projection (decision 24)"
);
comptime_expect_error(
  bs_mut_result :: (fn(s : &mut String) -> &mut String)(s),
  "a projection (decision 24)"
);
comptime_expect_error(
  bs_annotation_mismatch :: (fn() -> unit)({
    n := i32(1);
    (_y : &String) = &n;
  }),
  "lends the place itself, so its type is the annotation's exactly"
);
comptime_expect_error(
  bs_read_only_local :: (fn() -> unit)({
    x := i32(1);
    y := &x;
    y = i32(2);
  }),
  "is a `&` borrow, which is read-only"
);
comptime_expect_error(
  bs_repoint_not_a_borrow :: (fn() -> unit)({
    x := i32(1);
    w := i32(2);
    w = &x;
  }),
  "re-points a local borrow, and `w` is not one"
);
comptime_expect_error(
  bs_binding_named_mut :: (fn() -> unit)({
    mut := i32(1);
  }),
  "\"mut\" is reserved"
);
comptime_expect_error(
  bs_parameter_named_mut :: (fn(mut : i32) -> i32)(mut),
  "\"mut\" is reserved"
);
comptime_expect_error(
  bs_unlabeled_fn_slot :: (fn(f : &Impl(Fn(&i32) -> i32)) -> i32)(i32(0)),
  "Expected a label for function parameter"
);
// Decision 43 step 2 (N1a; plans/backlog/REFERENCES_AND_ORIGINS.md O1): the
// `Origin` kind, `generic(p : Origin)`, and a parameter typed `&(T, p)` /
// `&mut(T, p)`. The origin is carried in the parameter's slot and checked
// from N1c on; the mode, the pointee and the emitted C are the elided
// form's. An origin binder is not a type parameter, so these functions are
// not generic.
bs_origin_first :: (fn(generic(p : Origin), v : &(i32, p)) -> i32)(v);
bs_origin_bump :: (fn(generic(p : Origin), v : &mut(i32, p)) -> unit)({
  v = (v + i32(1));
});
bs_origin_union :: (fn(generic(p : Origin, q : Origin), a : &(i32, (p, q)), b : &(i32, q)) -> i32)(a + b);
bs_origin_apply :: (fn(generic(p : Origin), f : Impl(Fn(v : &(i32, p)) -> i32), v : &(i32, p)) -> i32)(f(v));
bs_origin_generic :: (fn(generic(T : Type, p : Origin), v : &(T, p)) -> T)(v);
test("a parameter typed `&(T, p)` / `&mut(T, p)` lends like `&T` / `&mut T`", {
  x := i32(41);
  assert(bs_origin_first(&x) == i32(41), "a `&(i32, p)` parameter reads the caller's value");
  mut(y) := i32(1);
  bs_origin_bump(&mut y);
  assert(y == i32(2), "a `&mut(i32, p)` parameter writes the caller's place");
  assert(bs_origin_union(&x, &y) == i32(43), "a union `(p, q)` in origin position");
  assert(bs_origin_apply((v : &i32) => (v + i32(1)), &x) == i32(42), "an `Fn(v : &(i32, p))` slot takes a closure with an elided `&i32` parameter");
  assert(bs_origin_generic(&x) == i32(41), "a type parameter and an origin parameter side by side");
});
bs_apply_elided :: (fn(f : Impl(Fn(v : &i32) -> i32), v : &i32) -> i32)(f(v));
test("a spelled origin and an elided one are one function type", {
  x := i32(7);
  assert(bs_apply_elided(bs_origin_first, &x) == i32(7), "the spelled-origin function fills the elided slot");
});
comptime_expect_error(
  bs_origin_undeclared :: (fn(v : &(i32, q)) -> i32)(v),
  "The origin `q` is not declared"
);
comptime_expect_error(
  bs_origin_param_place :: (fn(xs : &i32, v : &(i32, xs)) -> i32)(v),
  "is not an origin parameter"
);
comptime_expect_error(
  bs_origin_not_a_name :: (fn(generic(p : Origin), v : &(i32, i32(1))) -> i32)(v),
  "is not an origin"
);
comptime_expect_error(
  bs_origin_ref_to_ref :: (fn(generic(r : Origin), a : &mut&(i32, r)) -> unit)(()),
  "a reference to a reference"
);
comptime_expect_error(
  bs_origin_generic_param :: (fn(generic(p : Origin, T : &(i32, p))) -> unit)(()),
  "is erased at runtime"
);
comptime_expect_error(
  bs_origin_type_argument :: (fn(generic(p : Origin)) -> unit)({
    _o := Option(&(i32, p)).None;
  }),
  "is an origin-qualified reference"
);
// Decision 43 step 2 (N1b): a result `-> &(T, o)` / `-> &mut(T, o)` spells
// the origin the projection borrows from: an origin parameter, a
// reference parameter's place, or a union of them. The mode, the pointee
// and the emitted C are the elided `-> &T` form's.
BsTrio :: struct(a : i32, b : i32, c : i32);
bs_ret_origin :: (fn(generic(p : Origin), t : &(BsTrio, p)) -> &(i32, p))(&t.a);
bs_ret_place :: (fn(t : &mut BsTrio) -> &mut(i32, t))(&mut t.b);
bs_ret_union :: (fn(generic(p : Origin), s : &(BsTrio, p), t : &BsTrio, pick : bool) -> &(i32, (p, t)))(
  cond(
    pick => &s.c,
    true => &t.c
  )
);
bs_ret_read :: (fn(x : &i32) -> i32)(x + i32(0));
test("a result typed `&(T, o)` / `&mut(T, o)` projects like `-> &T` / `-> &mut T`", {
  t := BsTrio(a : i32(1), b : i32(2), c : i32(3));
  assert(bs_ret_read(bs_ret_origin(&t)) == i32(1), "an origin parameter's result reads the caller's place");
  mut(u) := BsTrio(a : i32(4), b : i32(5), c : i32(6));
  bs_ret_place(&mut u) = i32(50);
  assert(u.b == i32(50), "a `&mut(i32, t)` result writes the caller's place");
  assert(bs_ret_read(bs_ret_union(&t, &u, true)) == i32(3), "a union `(p, t)` result, first arm");
  assert(bs_ret_read(bs_ret_union(&t, &u, false)) == i32(6), "a union `(p, t)` result, second arm");
});
comptime_expect_error(
  bs_ret_byvalue :: (fn(v : BsTrio) -> &(i32, v))(&v.a),
  "a by-value parameter"
);
comptime_expect_error(
  bs_ret_undeclared :: (fn(t : &BsTrio) -> &(i32, q))(&t.a),
  "The origin `q` is not declared"
);
comptime_expect_error(
  bs_ret_type_param :: (fn(generic(T : Type), t : &BsTrio) -> &(i32, T))(&t.a),
  "is a type parameter, not an origin"
);
comptime_expect_error(
  bs_ret_not_a_name :: (fn(t : &BsTrio) -> &(i32, t.a))(&t.a),
  "is not an origin"
);
comptime_expect_error(
  bs_fn_trait_spelled_result :: (fn(f : Impl(Fn(x : &i32) -> &(i32, x))) -> unit)(()),
  "A closure trait's result origin is elided"
);
// Decision 43 step 2 (N1c; plans/backlog/REFERENCES_AND_ORIGINS.md O3): a
// call of a projection whose result origin is spelled freezes only the
// arguments that origin names; an elided one freezes every reference
// argument (O2). The body is checked against the spelled origin (E0923).
bs_pick_s :: (fn(s : &BsTrio, t : &BsTrio) -> &(i32, s))(&s.a);
bs_pick_p :: (fn(generic(p : Origin), s : &(BsTrio, p), t : &BsTrio) -> &(i32, p))(&s.b);
bs_pick_mut :: (fn(s : &mut BsTrio, t : &mut BsTrio) -> &mut(i32, s))(&mut s.c);
bs_pick_gen :: (fn(generic(T : Type), s : &T, t : &T) -> &(T, s))(&s);
test("a spelled result origin freezes only the arguments it names", {
  t := BsTrio(a : i32(1), b : i32(2), c : i32(3));
  mut(u) := BsTrio(a : i32(4), b : i32(5), c : i32(6));
  r := bs_pick_s(&t, &u);
  u.a = i32(40);
  assert(bs_ret_read(r) == i32(1), "`u` is not in the result's origin `s`: writing it while `r` lives is fine");
  q := bs_pick_p(&t, &u);
  u.b = i32(50);
  assert(bs_ret_read(q) == i32(2), "an origin parameter names the arguments whose slots carry it");
  mut(v) := BsTrio(a : i32(7), b : i32(8), c : i32(9));
  m := bs_pick_mut(&mut v, &mut u);
  m = i32(90);
  u.c = i32(60);
  assert((v.c == i32(90)) && (u.c == i32(60)), "a `&mut(i32, s)` result holds `s` alone");
  x := i32(11);
  mut(y) := i32(12);
  g := bs_pick_gen(&x, &y);
  y = i32(13);
  assert((bs_ret_read(g) == i32(11)) && (y == i32(13)), "a generic projection keeps its spelled origin through the specialization");
});
comptime_expect_error(
  bs_spelled_still_freezes :: (fn() -> unit)({
    mut(t) := BsTrio(a : i32(1), b : i32(2), c : i32(3));
    u := BsTrio(a : i32(4), b : i32(5), c : i32(6));
    r := bs_pick_s(&t, &u);
    t.a = i32(9);
    _ := bs_ret_read(r);
  }),
  "Cannot write"
);
bs_pick_elided :: (fn(s : &BsTrio, t : &BsTrio) -> &i32)(&s.a);
comptime_expect_error(
  bs_elided_freezes_all :: (fn() -> unit)({
    t := BsTrio(a : i32(1), b : i32(2), c : i32(3));
    mut(u) := BsTrio(a : i32(4), b : i32(5), c : i32(6));
    r := bs_pick_elided(&t, &u);
    u.a = i32(9);
    _ := bs_ret_read(r);
  }),
  "whose result origin is elided"
);
comptime_expect_error(
  bs_ret_outside_origin :: (fn(s : &BsTrio, t : &BsTrio) -> &(i32, s))(&t.a),
  "which that origin does not name"
);
comptime_expect_error(
  bs_ret_local_place :: (fn(s : &BsTrio) -> &(i32, s))({
    y := BsTrio(a : i32(1), b : i32(2), c : i32(3));
    return(&y.a);
  }),
  "its storage ends with the call"
);
// O7: an impl member's result origin is within its trait member's.
BsPick :: trait(pick : (fn(self : &Self, other : &i32) -> &(i32, self)));
BsWide :: trait(pick_any : (fn(self : &Self, other : &i32) -> &i32));
BsOne :: struct(v : i32);
impl(BsOne, BsWide(pick_any : (fn(self : &Self, other : &i32) -> &(i32, self))(&self.v)));
impl(BsOne, BsPick(pick : (fn(self : &Self, other : &i32) -> &(i32, self))(&self.v)));
test("an impl may narrow its trait's result origin, and a trait call maps from the trait's", {
  b := BsOne(v : i32(21));
  mut(o) := i32(2);
  r := b.pick_any(&o);
  assert(bs_ret_read(r) == i32(21), "an impl narrower than its trait (`self` within the elided union)");
  (d : Dyn(BsPick)) = dyn(BsOne(v : i32(22)));
  s := d.pick(&o);
  o = i32(3);
  assert((bs_ret_read(s) == i32(22)) && (o == i32(3)), "a Dyn call's result origin is the trait's `self`: `o` stays writable");
});
// A projection method behind a `Dyn` (issues/fixed/2026-10-29-a-dyn-over-a-trait-with-a-projection-method-emits-invalid-c.md):
// the vtable slot and its wrapper take `&T` parameters and return the result
// by pointer, as the impl does.
BsPk :: trait(pk : (fn(self : &Self, other : &i32) -> &i32));
impl(BsOne, BsPk(pk : (fn(self : &Self, other : &i32) -> &i32)(&self.v)));
test("a Dyn over a trait with an elided-origin projection method", {
  (d : Dyn(BsPk)) = dyn(BsOne(v : i32(23)));
  o := i32(2);
  r := d.pk(&o);
  assert(bs_ret_read(r) == i32(23), "the Dyn projection call reads the payload's field");
});
// A projection called through a value (decision 43 step 2, N1c): a
// `fn(...) -> &T` parameter or field, an `Impl(Fn(...) -> &T)` or
// `Dyn(Fn(...) -> &T)` holding a named projection or a closure whose body
// yields `&place`, and an effect operation `ctl(...) -> &T`. The call is the
// place, its `&T` arguments are passed by address, and its result origin is
// O2's per-call default: every reference argument.
bs_first :: (fn(t : &BsTrio) -> &i32)(&t.a);
bs_third_mut :: (fn(t : &mut BsTrio) -> &mut i32)(&mut t.c);
BsProj :: struct(get : (fn(t : &BsTrio) -> &i32), put : (fn(t : &mut BsTrio) -> &mut i32));
bs_via_fn :: (fn(f : (fn(t : &BsTrio) -> &i32), t : &BsTrio) -> i32)({
  r := f(&t);
  bs_ret_read(r)
});
bs_via_impl :: (fn(f : Impl(Fn(t : &BsTrio) -> &i32), t : &BsTrio) -> i32)({
  r := f(&t);
  bs_ret_read(r)
});
bs_poke_impl :: (fn(f : Impl(Fn(t : &mut BsTrio) -> &mut i32), t : &mut BsTrio) -> unit)({
  r := f(&mut t);
  r = i32(70);
});
bs_via_dyn :: (fn(f : Dyn(Fn(t : &BsTrio) -> &i32), t : &BsTrio) -> i32)({
  r := f(&t);
  bs_ret_read(r)
});
BsAsk :: (ctl(key : &i32) -> &(i32, key));
bs_ask_use :: (fn(ask : BsAsk) -> i32)({
  k := i32(31);
  r := ask(&k);
  bs_ret_read(r)
});
test("a projection is called through a function value, a closure trait and an effect operation", {
  mut(t) := BsTrio(a : i32(1), b : i32(2), c : i32(3));
  assert(bs_via_fn(bs_first, &t) == i32(1), "a `fn(...) -> &T` parameter");
  h := BsProj(get : bs_first, put : bs_third_mut);
  g := h.get(&t);
  assert(bs_ret_read(g) == i32(1), "a `fn(...) -> &T` field");
  m := (h.put)(&mut t);
  m = i32(30);
  assert(t.c == i32(30), "a `&mut` projection through a field writes the place");
  assert(bs_via_impl(bs_first, &t) == i32(1), "a named projection in an `Impl(Fn(...) -> &T)` slot");
  assert(bs_via_impl((s : &BsTrio) => &s.b, &t) == i32(2), "a closure literal yielding `&place`");
  bs_poke_impl((s : &mut BsTrio) => &mut s.a, &mut t);
  assert(t.a == i32(70), "a `&mut` closure projection writes through");
  (d : Dyn(Fn(s : &BsTrio) -> &i32)) = dyn((s : &BsTrio) => &s.c);
  assert(bs_via_dyn(d, &t) == i32(30), "a `Dyn(Fn(...) -> &T)` closure");
  (e : Dyn(Fn(s : &BsTrio) -> &i32)) = dyn(bs_first);
  assert(bs_via_dyn(e, &t) == i32(70), "a `Dyn(Fn(...) -> &T)` named projection");
  (ask : BsAsk) = (fn(key : &i32) -> &(i32, key))({
    return(&key);
  });
  assert(bs_ask_use(ask) == i32(31), "a `ctl` handler resumes with a place of its key");
});
comptime_expect_error(
  bs_fn_value_freezes :: (fn(f : (fn(t : &BsTrio) -> &i32), t : &mut BsTrio) -> i32)({
    r := f(&t);
    t.a = i32(9);
    bs_ret_read(r)
  }),
  "Cannot write"
);
comptime_expect_error(
  bs_closure_ret_capture :: (fn(t : &BsTrio) -> i32)({
    y := i32(9);
    bs_via_impl((s : &BsTrio) => &y, &t)
  }),
  "which the closure captures"
);
comptime_expect_error(
  bs_closure_ret_outer_param :: (fn(t : &BsTrio, u : &BsTrio) -> i32)(bs_via_impl((s : &BsTrio) => &u.a, &t)),
  "which the closure captures"
);
comptime_expect_error(
  bs_handler_ret_local :: (fn() -> i32)({
    (ask : BsAsk) = (fn(key : &i32) -> &(i32, key))({
      y := i32(2);
      return(&y);
    });
    bs_ask_use(ask)
  }),
  "its storage ends with the call"
);
comptime_expect_error(
  bs_handler_ret_capture :: (fn() -> i32)({
    x := i32(5);
    (ask : BsAsk) = (
      key -> {
        return(&x);
      }
    );
    bs_ask_use(ask)
  }),
  "which the closure captures"
);
BsTwo :: struct(v : i32);
comptime_expect_error(
  impl(BsTwo, BsPick(pick : (fn(self : &Self, other : &i32) -> &i32)(&self.v))),
  "which the trait's result origin does not name"
);
// `Origin` is reserved like `Type` (decision 43 step 2): a binding of the

// name is rejected naming the kind.
comptime_expect_error(
  bs_origin_reserved :: (fn() -> unit)({
    Origin := i32(1);
  }),
  "it is the kind of an origin"
);
