// Owners (VERDICTS-63; plans/VALUES_BY_DEFAULT.md §3.3): a `Deref` type that
// is not a handle. `x.*` is the place its `deref` projection yields, `&x.*` is
// `x.deref()` and `&mut x.*` is `x.deref_mut()`; a write through `x.*` calls
// `deref_mut` (`DerefMut`, chosen as `IndexMut` is). An owner's own member
// wins over its view's, and a member only the view has forwards through
// `.*`. Outside the prelude the `Target` must be unsized (E0622).
{ assert } :: import("std/assert");
{ RawBuf, raw_buf, view_sum, view_set, ZeroFirst } :: import("./fixtures/deref-owner.yo");

_sum :: (fn(xs : &[i32]) -> i32)(view_sum(xs));
// A safe owner: its `deref` is `&self.items.*`, the whole inner array.
_Ring :: struct(items : Array(i32, 3));
impl(_Ring, len : (fn(self : &Self) -> usize)(usize(30)));
impl(_Ring, Deref(Target : [i32], deref : (fn(self : &Self) -> &Self.Target)(&self.items.*)));
impl(_Ring, DerefMut(Target : [i32], deref_mut : (fn(self : &mut Self) -> &mut Self.Target)(&mut self.items.*)));
// An owner with a read-only view.
_RoRing :: struct(items : Array(i32, 2));
impl(_RoRing, Deref(Target : [i32], deref : (fn(self : &Self) -> &Self.Target)(&self.items.*)));
/// One body over every `Deref` type whose `Target` is `[i32]`.
_total :: (fn(generic(D : Type), d : &D, where(D <: Deref(Target := [i32]))) -> i32)(_sum(d.deref()));

test("&b.* lends the view: bound, as an argument, as a receiver", {
  b := raw_buf(usize(2));
  v := &b.*;
  assert(v.len() == usize(2), "the view holds the first two slots");
  assert(_sum(v) == i32(3), "read through the bound view");
  assert(_sum(&b.*) == i32(3), "as an argument");
  assert(b.*.len() == usize(2), "the view's len");
  assert(b.len() == usize(4), "the owner's own len wins");
  // An unsized projection call's place, lent and used as a receiver: the
  // argument is the fat pair itself
  // (issues/fixed/2026-11-16-an-unsized-projection-place-lent-to-a-reference-parameter-spills-an-undeclared-temporary.md).
  assert(_sum(&RawBuf.deref(&b).*) == i32(3), "a projection call's place as an argument");
  assert(RawBuf.deref(&b).*.len() == usize(2), "and as a receiver");
});
test("a member only the view has forwards through .*", {
  b := raw_buf(usize(2));
  assert(!b.is_empty(), "is_empty is the view's");
  assert(b.contains(&i32(2)), "contains is the view's");
  assert(!b.contains(&i32(3)), "the third slot is outside the view");
  e := raw_buf(usize(0));
  assert(e.is_empty(), "an empty view");
});
test("&mut b.* lends the view exclusively, and writes reach the owner", {
  mut(b) := raw_buf(usize(3));
  w := &mut b.*;
  view_set(w, usize(1), i32(20));
  assert(b.items(usize(1)) == i32(20), "written through the view");
  view_set(&mut b.*, usize(2), i32(30));
  assert(b.items(usize(2)) == i32(30), "written through a &mut lend of b.*");
  b.zero_first();
  assert(b.items(usize(0)) == i32(0), "a &mut view method through the owner");
  b.push(i32(7));
  assert(b.*.len() == usize(4), "the owner grew its view");
});
test("a safe owner whose deref is &self.items.*", {
  mut(r) := _Ring(items : Array(i32, 3)(1, 2, 3));
  assert(r.len() == usize(30), "the owner's len");
  assert(r.*.len() == usize(3), "the view's len");
  assert(_sum(&r.*) == i32(6), "the view as an argument");
  r.*.zero_first();
  assert(r.items(usize(0)) == i32(0), "written through deref_mut");
});
test("Box(owner) and Rc(owner) forward through both steps", {
  bx := Box.new(raw_buf(usize(2)));
  assert(!bx.is_empty(), "Box -> owner -> view");
  assert(bx.len() == usize(4), "the owner's len through the Box");
  r := Rc.new(raw_buf(usize(1)));
  assert(r.contains(&i32(1)), "Rc -> owner -> view");
  assert(_sum(&r.*.*) == i32(1), "the view of the Rc's payload");
});
test("an Array's .* is its [T] view", {
  mut(a) := Array(i32, 3)(1, 2, 3);
  v := &a.*;
  assert(v.len() == usize(3), "a view of every element");
  assert(_sum(&a.*) == i32(6), "as an argument");
  assert(a.len() == usize(3), "the array's own len");
  assert(a(usize(1)) == i32(2), "the array's own index");
  a.*.zero_first();
  assert(a(usize(0)) == i32(0), "written through DerefMut");
});
test("one generic body over Deref(Target := [i32])", {
  b := raw_buf(usize(2));
  a := Array(i32, 2)(5, 6);
  assert(_total(&b) == i32(3), "at an owner");
  assert(_total(&a) == i32(11), "at an Array");
  assert(RawBuf.deref(&b).len() == usize(2), "the qualified projection");
});
mut(_tick_drops) := i32(0);
_Tick :: struct(n : i32);
impl(
  _Tick,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _tick_drops = (_tick_drops + i32(1));
    })
  )
);
_Ticks :: struct(items : Array(_Tick, 2));
impl(_Ticks, Deref(Target : [_Tick], deref : (fn(self : &Self) -> &Self.Target)(&self.items.*)));
test("the elements are dropped once, by the owner", {
  _tick_drops = i32(0);
  {
    t := _Ticks(items : Array(_Tick, 2)(_Tick(n : i32(1)), _Tick(n : i32(2))));
    v := &t.*;
    assert(v.len() == usize(2), "read through the view");
    assert(t.*.len() == usize(2), "and again");
  };
  assert(_tick_drops == i32(2), "two elements, each dropped once");
});
_Hold :: struct(v : &[i32]);
_push_and_sum :: (fn(b : &mut RawBuf, xs : &[i32]) -> i32)({
  b.push(i32(1));
  _sum(xs)
});
// issues/fixed/2026-11-16-an-argument-lending-a-projection-calls-place-holds-no-loan.md:
// `&f(&s).*` and `&s.m().*` as an argument beside `&mut s`.
_S :: struct(x : i32);
impl(_S, xr : (fn(self : &Self) -> &i32)(&self.x));
_xr :: (fn(s : &_S) -> &i32)(&s.x);
_bump :: (fn(s : &mut _S, v : &i32) -> i32)({
  s.x = (s.x + i32(1));
  v.*
});
test("a live view freezes the owner (decision 13)", {
  comptime_expect_error({
    mut(b) := raw_buf(usize(2));
    v := &b.*;
    b.push(i32(3));
    _sum(v)
  }, "borrows `b`");
  comptime_expect_error({
    b := raw_buf(usize(2));
    v := &b.*;
    c := b;
    _sum(v) + _sum(&c.*)
  }, "Cannot move `b`");
  comptime_expect_error({
    mut(b) := raw_buf(usize(2));
    w := &mut b.*;
    _n := b.*.len();
    view_set(w, usize(0), i32(1));
  }, "borrows `b`");
  comptime_expect_error({
    mut(b) := raw_buf(usize(2));
    h := _Hold(v : &b.*);
    b.push(i32(3));
    _sum(h.v)
  }, "borrows");
  comptime_expect_error({
    mut(b) := raw_buf(usize(2));
    _push_and_sum(&mut b, &b.*)
  }, "carries a `&` loan of `b`");
});
test("an argument lending a projection call's place holds the call's loans", {
  comptime_expect_error({
    mut(s) := _S(x : i32(1));
    _bump(&mut s, &s.xr().*)
  }, "carries a `&` loan of `s`");
  comptime_expect_error({
    mut(s) := _S(x : i32(1));
    _bump(&mut s, &_xr(&s).*)
  }, "carries a `&` loan of `s`");
  mut(s) := _S(x : i32(1));
  n := _xr(&s).*;
  assert(_bump(&mut s, &n) == i32(1), "a copy out of the place lends nothing");
  assert(s.x == i32(2), "and the write landed");
});
test("a write through .* needs a writable owner and DerefMut", {
  comptime_expect_error({
    b := raw_buf(usize(2));
    _w := &mut b.*;
  }, "it is a binding declared without `mut`");
  comptime_expect_error({
    mut(r) := _RoRing(items : Array(i32, 2)(1, 2));
    _w := &mut r.*;
  }, "but not `DerefMut`");
  comptime_expect_error({
    mut(r) := _RoRing(items : Array(i32, 2)(1, 2));
    r.*.zero_first();
  }, "but not `DerefMut`");
  comptime_expect_error({
    r := Rc.new(raw_buf(usize(2)));
    _w := &mut r.*.*;
  }, "an `Rc`'s payload is shared, so it is read-only through the handle");
});
test("an unsized place has no value of its own", {
  comptime_expect_error({
    mut(b) := raw_buf(usize(2));
    b.* = b.*;
  }, "`Slice(i32)` is not `Sized`");
  comptime_expect_error({
    b := raw_buf(usize(2));
    _x := b.*;
  }, "`Slice(i32)` is not `Sized`");
});
test("nothing dereferences at a parameter", {
  comptime_expect_error({
    b := raw_buf(usize(2));
    _sum(&b)
  }, "lend its view with `&b.*`");
});
test("a capture list names a binding, not a projection place", {
  comptime_expect_error({
    b := raw_buf(usize(2));
    (f : Impl(Fn() -> i32)) = ({ v : &b.* }() => _sum(v));
    f()
  }, "an owner's `.*` is the place its `deref` projection yields");
});
_Sized :: struct(n : i32);
_Gen :: (fn(comptime(T) : ?Sized) -> comptime(Type))(struct(inner : Box(T)));
_Half :: struct(items : Array(i32, 2));
_Half2 :: struct(items : Array(i32, 2), bytes : Array(u8, 2));
_NoDeref :: struct(items : Array(i32, 2));
test("outside the prelude a Deref impl needs an unsized Target (E0622)", {
  comptime_expect_error(impl(_Sized, Deref(Target : i32, deref : (fn(self : &Self) -> &Self.Target)(&self.n))), "its `Target` `i32` has a size");
  comptime_expect_error(impl(_Sized, DerefMut(Target : i32, deref_mut : (fn(self : &mut Self) -> &mut Self.Target)(&mut self.n))), "Cannot implement `DerefMut` for `_Sized`: its `Target` `i32` has a size");
  comptime_expect_error(impl(generic(T : ?Sized), _Gen(T), Deref(Target : T, deref : (fn(self : &Self) -> &Self.Target)(&self.inner.*))), "is a type variable");
  comptime_expect_error(impl(_NoDeref, Deref(Target : [i32])), "member \"deref\" is not provided");
});
impl(_Half, DerefMut(Target : [i32], deref_mut : (fn(self : &mut Self) -> &mut Self.Target)(&mut self.items.*)));
impl(_Half2, Deref(Target : [i32], deref : (fn(self : &Self) -> &Self.Target)(&self.items.*)));
impl(_Half2, DerefMut(Target : [u8], deref_mut : (fn(self : &mut Self) -> &mut Self.Target)(&mut self.bytes.*)));
test("DerefMut needs a Deref with the same Target", {
  comptime_expect_error({
    mut(h) := _Half(items : Array(i32, 2)(1, 2));
    _w := &mut h.*;
  }, "implements `DerefMut` but not `Deref`");
  comptime_expect_error({
    mut(h) := _Half2(items : Array(i32, 2)(1, 2), bytes : Array(u8, 2)(3, 4));
    _w := &mut h.*;
  }, "share one `Target`");
});
