pragma(Pragma.SkipWasm32Wasi); // no pthread support in standalone WASI
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
import("std/libc/stdio");
{ get_thread_id, Thread } :: import("std/thread");
{ yield } :: import("std/async");
{ Channel } :: import("std/sync/channel");
{ AtomicUsize, MemoryOrder } :: import("std/sync/atomic");
{ ArrayList } :: import("std/collections/array_list");
log :: import("std/log");
test("Thread spawn and join without captures", {
  thread := Thread.spawn(
    io => () // Thread runs with no captures
  );
  thread.join();
});
test("Thread spawn and join with i32 capture", {
  value := 42;
  thread := Thread.spawn(io => {
    // Use captured value
    assert(value == 42);
  });
  thread.join();
});
test("Thread spawn and join with multiple captures", {
  x := 100;
  y := 200;
  thread := Thread.spawn(io => {
    // Use captured values
    assert((x + y) == 300);
  });
  thread.join();
});
test("Thread with async task", {
  thread := Thread.spawn(io => {
    task := io.async((io : Io) => {
      io.await(yield(io), io);
    });
    io.await(task, io);
  });
  thread.join();
});
test("Thread with async returning value", {
  thread := Thread.spawn(io => {
    x := 10;
    y := 20;
    task := io.async((io : Io) => {
      io.await(yield(io), io);
      return(x + y);
    });
    result := io.await(task, io);
    assert(result == i32(30), "async result should be 30");
  });
  thread.join();
});
test("Thread with async loop", {
  thread := Thread.spawn(io => {
    task := io.async((io : Io) => {
      counter := 0;
      while(runtime(counter < i32(5)), {
        counter = (counter + 1);
        io.await(yield(io), io);
      });
      return(counter);
    });
    result := io.await(task, io);
    assert(result == i32(5), "counter should be 5");
  });
  thread.join();
});
test("Thread with multiple async tasks", {
  thread := Thread.spawn(io => {
    task1 := io.async((io : Io) => {
      io.await(yield(io), io);
      return(i32(1));
    });
    task2 := io.async((io : Io) => {
      io.await(yield(io), io);
      return(i32(2));
    });
    r1 := io.await(task1, io);
    r2 := io.await(task2, io);
    assert((r1 + r2) == i32(3), "sum should be 3");
  });
  thread.join();
});
