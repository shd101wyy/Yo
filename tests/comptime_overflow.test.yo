//! Compile-time integer overflow is an ERROR, not a silent wrap.
//!
//! `add` / `sub` / `mul` on comptime values are checked against the target
//! type's range before the value is built (`checkOverflow` in
//! `src/evaluator/builtins/comptime-numeric-fns.ts`, `check_int_overflow` in
//! `src/evaluator/builtins/comptime_numeric_fns.yo`). The bootstrap carries
//! comptime integers as `i64` rather than a bignum, so the 64-bit UNSIGNED
//! cases need their own domain — the "must be ACCEPTED" arms below are the
//! regression guards for that (a signed-domain test reports a false overflow on
//! any u64 value above `i64::MAX`).
//!
//! `comptime_int` itself is unbounded and is deliberately NOT range-checked.
{ assert } :: import("std/assert");

test("signed overflow at the type boundary is rejected", {
  comptime_expect_error(over_i8 :: (i8(127) + i8(1)));
  comptime_expect_error(under_i8 :: (i8(-128) - i8(1)));
  comptime_expect_error(over_i16 :: (i16(32767) + i16(1)));
  comptime_expect_error(under_i16 :: (i16(-32768) - i16(1)));
  comptime_expect_error(over_i32 :: (i32(2147483647) + i32(1)));
  comptime_expect_error(under_i32 :: (i32(-2147483648) - i32(1)));
  comptime_expect_error(mul_i8 :: (i8(50) * i8(25)));
  comptime_expect_error(mul_i32 :: (i32(100000) * i32(100000)));
});

test("unsigned overflow and underflow are rejected", {
  comptime_expect_error(over_u8 :: (u8(255) + u8(1)));
  comptime_expect_error(under_u8 :: (u8(0) - u8(1)));
  comptime_expect_error(over_u16 :: (u16(65535) + u16(1)));
  comptime_expect_error(under_u16 :: (u16(0) - u16(1)));
  comptime_expect_error(under_u32 :: (u32(0) - u32(1)));
  comptime_expect_error(mul_u8 :: (u8(200) * u8(2)));
  // usize/u64 underflow: 0 - 1 has no representation in the unsigned domain.
  comptime_expect_error(under_usize :: (usize(0) - usize(1)));
  comptime_expect_error(under_u64 :: (u64(0) - u64(1)));
});

test("values in range are accepted — including 64-bit unsigned above i64::MAX", {
  // Every one of these is a VALID result. They are the guard against checking
  // 64-bit unsigned arithmetic in the signed domain, where the i64 the
  // bootstrap holds is the u64 bit pattern: `9223372036854775807 + 1000`
  // signed-wraps but is a perfectly good u64.
  big_u64 :: u64(9223372036854775807);
  big_sum :: (big_u64 + u64(1000));
  comptime_assert(big_sum > big_u64, "u64 just past i64::MAX still grows");
  big_diff :: (big_sum - u64(1000));
  comptime_assert(big_diff == big_u64, "u64 subtraction round-trips");
  // usize is TARGET-WIDTH (32-bit on wasm32, 64-bit on native), so the
  // usize probe must not hardcode a 64-bit literal — the 64-bit-domain
  // claim above is u64's job. usize.MAX / usize.MIN resolve to the
  // target's actual width (std/prelude.yo via __yo_pointer_size_bits),
  // so the boundary walk below is valid on every target.
  comptime_assert(usize.MIN == usize(0), "usize.MIN is 0 on every target");
  comptime_assert(usize.MAX > usize(4294967294), "usize.MAX is at least u32.MAX");
  big_usize :: (usize.MAX - usize(1));
  usize_sum :: (big_usize + usize(1));
  comptime_assert(usize_sum == usize.MAX, "usize.MAX is reachable on every target width");
  // Boundaries that must NOT be reported.
  max_i8 :: (i8(126) + i8(1));
  comptime_assert(max_i8 == i8(127), "i8 MAX is reachable");
  min_i8 :: (i8(-127) - i8(1));
  comptime_assert(min_i8 == i8(-128), "i8 MIN is reachable");
  max_u8 :: (u8(254) + u8(1));
  comptime_assert(max_u8 == u8(255), "u8 MAX is reachable");
  zero_u8 :: (u8(1) - u8(1));
  comptime_assert(zero_u8 == u8(0), "u8 zero is reachable");
  // comptime_int is unbounded — no range to exceed.
  big_ct :: (1000000 * 1000000);
  comptime_assert(big_ct > 0, "comptime_int multiplication is unchecked");
});

test("bit_not and mul checks on 64-bit-boundary patterns", {
  // u64(2^63) is the i64.MIN bit pattern; `~` once formed `0 - n - 1`
  // directly on it, which aborts under safe-mode arithmetic.
  boundary :: u64(9223372036854775808);
  comptime_assert(~boundary == u64(9223372036854775807), "~ on the MIN pattern yields MAX");
  comptime_assert(~u64(0) == u64(18446744073709551615), "~ on zero yields u64.MAX");
  // The exact product 1.6e19 leaves i64's range: the wrapped-product probe
  // once formed the overflowing product (and divided by the operand) itself;
  // the overflow must be REPORTED, not trap the compiler.
  comptime_expect_error(mul_past_i64_max :: (i64(4000000000) * i64(4000000000)));
  comptime_expect_error(mul_below_i64_min :: (i64(-4000000000) * i64(4000000000)));
});

test("the compile-time checks do not reject runtime arithmetic", {
  // Only COMPILE-TIME arithmetic is range-checked; a runtime `+` must not be
  // rejected at compile time. Under safe mode the runtime `+` itself traps on
  // overflow, so the keep-the-wrap surface is `wrapping_*`.
  x := i8(127);
  y := i8(1);
  sum := x.wrapping_add(y);
  assert(sum == i8(-128), "wrapping_add wraps exactly at the i8 boundary");
  u := u8(255);
  one := u8(1);
  usum := u.wrapping_add(one);
  assert(usum == u8(0), "wrapping_add wraps exactly at the u8 boundary");
});

test("shifts, negation and division fold like the run time", {
  // A left shift WRAPS the bits it shifts out, as at run time — the fold used
  // to CLAMP (`i32(1) << 31` folded to i32::MAX)
  // (issues/fixed/comptime-integer-folding-clamps-instead-of-wrapping.md).
  sign_bit :: (i32(1) << 31);
  assert(sign_bit == i32(-2147483648), "i32(1) << 31 is the sign bit");
  byte_shl :: (u8(255) << u8(1));
  assert(byte_shl == u8(254), "u8 shl drops the high bit");
  top_bit :: (u64(1) << u64(63));
  assert(top_bit == u64(9223372036854775808), "u64 bit 63");
  masked :: (i8(-1) & i8(127));
  assert(masked == i8(127), "bitwise ops are unaffected");
  // The trapping cases are compile errors on constants.
  comptime_expect_error(shl_count :: (i32(1) << i32(40)), "shift count 40 is out of range for i32");
  comptime_expect_error(shr_count :: (u8(1) >> u8(8)), "shift count 8 is out of range for u8");
  comptime_expect_error(shl_negative :: (i32(1) << i32(-1)), "shift count -1 is out of range");
  comptime_expect_error(neg_min :: -i8(-128), "does not fit in i8");
  comptime_expect_error(div_min :: (i32(-2147483648) / i32(-1)), "does not fit in i32");
  comptime_expect_error(mod_min :: ((i64(-9223372036854775807) - i64(1)) % i64(-1)), "does not fit in i64");
  assert(true, "rejected");
});
