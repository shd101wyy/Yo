// Fixture for tests/open_import_constants.test.yo: exported comptime
// constants of every integer width, plus a struct constant and a function, so
// `open(import(...))` and `{ ... } :: import(...)` can be compared.
K_U8 :: u8(200);
K_U16 :: u16(60000);
K_U32 :: u32(4000000000);
K_U64 :: u64(7);
K_U64_ZERO :: u64(0);
K_USIZE :: usize(3);
K_I8 :: i8(-5);
K_I64 :: i64(-9000000000);
K_ISIZE :: isize(-1);
K_BOOL :: true;
K_F64 :: f64(1.5);
Pt :: struct(x : i32, y : i32);
K_PT :: Pt(i32(1), i32(2));
twice :: (fn(v : u64) -> u64)(v * u64(2));
export(K_U8, K_U16, K_U32, K_U64, K_U64_ZERO, K_USIZE, K_I8, K_I64, K_ISIZE, K_BOOL, K_F64, Pt, K_PT, twice);
