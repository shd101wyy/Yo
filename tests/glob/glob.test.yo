{ assert } :: import("std/assert");
{ glob_match, GlobPattern } :: import("std/glob");
open(import("std/string"));
test("glob exact match", {
  assert(glob_match(`hello.txt`, `hello.txt`), "exact match");
  assert(!glob_match(`hello.txt`, `world.txt`), "no match");
});
test("glob star matches any", {
  assert(glob_match(`*.txt`, `hello.txt`), "*.txt matches hello.txt");
  assert(glob_match(`*.txt`, `.txt`), "*.txt matches .txt");
  assert(!glob_match(`*.txt`, `hello.md`), "*.txt rejects .md");
  assert(!glob_match(`*.txt`, `dir/hello.txt`), "* does not cross /");
});
test("glob question mark", {
  assert(glob_match(`?.txt`, `a.txt`), "?.txt matches a.txt");
  assert(!glob_match(`?.txt`, `ab.txt`), "?.txt rejects ab.txt");
  assert(!glob_match(`?.txt`, `.txt`), "?.txt rejects .txt");
});
test("glob double star", {
  assert(glob_match(`**/*.txt`, `dir/hello.txt`), "**/*.txt matches dir/hello.txt");
  assert(glob_match(`**/*.txt`, `a/b/c/hello.txt`), "**/*.txt matches deep path");
  assert(glob_match(`src/**`, `src/a/b/c`), "src/** matches nested");
});
test("glob character class", {
  assert(glob_match(`[abc].txt`, `a.txt`), "[abc] matches a");
  assert(glob_match(`[abc].txt`, `b.txt`), "[abc] matches b");
  assert(!glob_match(`[abc].txt`, `d.txt`), "[abc] rejects d");
});
test("glob negated character class", {
  assert(glob_match(`[!abc].txt`, `d.txt`), "[!abc] matches d");
  assert(!glob_match(`[!abc].txt`, `a.txt`), "[!abc] rejects a");
});
test("glob complex patterns", {
  assert(glob_match(`src/*.yo`, `src/main.yo`), "src/*.yo");
  assert(!glob_match(`src/*.yo`, `src/sub/main.yo`), "* doesn't cross /");
  assert(glob_match(`src/**/*.yo`, `src/sub/main.yo`), "** crosses /");
  assert(glob_match(`**/*.test.yo`, `tests/string/string.test.yo`), "deep test match");
});
test("glob empty pattern and text", {
  assert(glob_match(``, ``), "empty matches empty");
  assert(!glob_match(``, `a`), "empty pattern rejects non-empty");
  assert(glob_match(`*`, ``), "* matches empty");
});
test("GlobPattern object", {
  pat := GlobPattern.new(`*.yo`);
  assert(pat.matches(`main.yo`), "pattern matches");
  assert(!pat.matches(`main.txt`), "pattern rejects");
});
test("glob character ranges", {
  // issues/fixed/glob-ranges-unimplemented-and-star-exponential.md: `[a-z]`
  // used to compare members literally, so it matched only a, - and z.
  assert(glob_match(`[a-c].txt`, `b.txt`), "[a-c] matches b");
  assert(!glob_match(`[a-c].txt`, `d.txt`), "[a-c] rejects d");
  assert(glob_match(`[0-9][0-9].log`, `42.log`), "two digit ranges");
  assert(!glob_match(`[0-9][0-9].log`, `4a.log`), "range rejects a letter");
  assert(glob_match(`[!a-c].txt`, `d.txt`), "negated range matches d");
  assert(!glob_match(`[!a-c].txt`, `b.txt`), "negated range rejects b");
  assert(glob_match(`[a-cx].txt`, `x.txt`), "range and single member mixed");
  assert(glob_match(`[-a].txt`, `-.txt`), "leading - is literal");
  assert(glob_match(`[a-].txt`, `-.txt`), "trailing - is literal");
  assert(glob_match(`[]a].txt`, `].txt`), "] first is a literal member");
  assert(!glob_match(`[a-z].txt`, `/.txt`), "a class never matches /");
  assert(!glob_match(`[!a].txt`, `/.txt`), "nor does a negated one");
});
test("glob star is polynomial: adversarial star chains terminate promptly", {
  // The old matcher recursed on every `*` — exponential in the number of stars.
  (text : String) = String.with_capacity(usize(64));
  (i : usize) = usize(0);
  while(i < usize(60), i = (i + usize(1)), {
    _a := text.push_str("a");
  });
  _b := text.push_str("b");
  assert(!glob_match(`*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*c`, text), "17 stars against 60 a's + b: false, promptly");
  assert(glob_match(`*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*b`, text), "…and true when the tail matches");
  assert(glob_match(`**/a*/**/b?/*.txt`, `x/y/ab/z/bq/f.txt`), "** and * interleaved");
  assert(!glob_match(`**/a*/**/b?/*.txt`, `x/y/ab/z/bq/f/g.txt`), "* still stops at /");
  assert(glob_match(`a*b/c`, `axb/c`), "literal / after a star");
  assert(!glob_match(`a*b/c`, `ax/b/c`), "the star cannot reach past a /");
});
