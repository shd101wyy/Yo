// `impl(&C, Trait)` and `impl(&mut C, Trait)`: decision 43's N1f-2
// (plans/backlog/REFERENCES_AND_ORIGINS.md), resolved by R-PROBE.
//
// A reference receiver is its own impl receiver: `impl(C, Tr)`,
// `impl(&C, Tr)` and `impl(&mut C, Tr)` are three keys, the origin is not part
// of the key. Method resolution probes RECEIVER-SLOT TYPES: for a receiver of
// type `R`, first `R`, then `&R` and `&mut R`, then one deref; the first
// candidate some method's receiver slot (its `self` parameter, `Self`
// substituted) equals wins. `impl(&C, Tr(m : fn(self : Self)))` and
// `impl(C, Tr(m : fn(self : &Self)))` both have the slot `&C`. An owned
// receiver auto-borrows; nothing auto-moves: `c.m()` takes a by-value `self`
// on `C` first, and `(&c).m()` is the explicit borrow.
{ assert } :: import("std/assert");
{ ArrayList, ArrayListIter } :: import("std/collections/array_list");
{ String } :: import("std/string");
// issues/fixed/2026-11-05-an-impl-over-a-reference-type-registers-nothing.md:
// `impl(&Bag, …)` registered nothing, and a `&Bag` receiver silently called
// `impl(Bag, …)`.
_RbBag :: struct(n : i32);
derive(_RbBag, Copy, Clone);
_RbName :: trait(name : (fn(self : Self) -> i32));
impl(_RbBag, _RbName(name : (fn(self : Self) -> i32)(i32(1))));
impl(&_RbBag, _RbName(name : (fn(self : Self) -> i32)(i32(2))));
_rb_via_ref :: (fn(r : &_RbBag) -> i32)(r.name());
test("a &Bag receiver dispatches to impl(&Bag, …), an owned Bag to impl(Bag, …)", {
  b := _RbBag(n : i32(0));
  assert(b.name() == i32(1), "owned: impl(_RbBag, _RbName)");
  assert((&b).name() == i32(2), "explicit (&b): impl(&_RbBag, _RbName)");
  assert(_rb_via_ref(&b) == i32(2), "a &_RbBag parameter: impl(&_RbBag, _RbName)");
});
// A function with an `&Impl(Fn(...))` parameter is specialized per call, and
// the specialization evaluates a fresh-id clone of the body as written:
// `(&b).name()` is the explicit borrow and `r.*.name()` the referent, as in a
// function with no such parameter. Before the fix, the clone carried the
// definition-time rewrites (`(&b).name` to `b.name` without its borrow mark,
// `r.*` to the name `r`), so both calls picked the other impl
// (issues/fixed/2026-11-06-a-borrowed-for-over-a-mut-param-is-rejected-when-the-fn-also-takes-an-impl-fn-param.md).
_rb_unit :: (fn(x : &i32) -> i32)(x.*);
_rb_explicit_beside_fn :: (fn(n : i32, g : &Impl(Fn(x : &i32) -> i32)) -> i32)({
  b := _RbBag(n : n);
  (&b).name()
});
_rb_deref_beside_fn :: (fn(r : &_RbBag, g : &Impl(Fn(x : &i32) -> i32)) -> i32)(r.*.name());
_rb_ref_beside_fn :: (fn(r : &_RbBag, g : &Impl(Fn(x : &i32) -> i32)) -> i32)(r.name());
test("a specialized body dispatches (&b).m() and r.*.m() as written", {
  b := _RbBag(n : i32(0));
  assert(_rb_explicit_beside_fn(i32(0), _rb_unit) == i32(2), "(&b).name(): impl(&_RbBag, …) in a specialized body");
  assert(_rb_deref_beside_fn(&b, _rb_unit) == i32(1), "r.*.name(): the referent's impl(_RbBag, …)");
  assert(_rb_ref_beside_fn(&b, _rb_unit) == i32(2), "r.name(): the reference's impl(&_RbBag, …)");
});
// (i) The value form consumes, the explicit borrow reads in place.
_IiBag :: struct(xs : ArrayList(i32));
_IiDrain :: struct(bag : _IiBag, i : usize);
impl(
  _IiDrain,
  Iterator(
    Item : i32,
    next : (fn(self : &mut Self) -> Option(i32))({
      if(self.i >= self.bag.xs.len(), {
        return(.None);
      });
      at := self.i;
      self.i = (self.i + usize(1));
      .Some(self.bag.xs(at))
    })
  )
);
_IiCount :: struct(left : usize);
impl(
  _IiCount,
  Iterator(
    Item : usize,
    next : (fn(self : &mut Self) -> Option(usize))({
      if(self.left == usize(0), {
        return(.None);
      });
      self.left = (self.left - usize(1));
      .Some(self.left)
    })
  )
);
impl(
  _IiBag,
  IntoIterator(
    Item : i32,
    IntoIter : _IiDrain,
    into_iter : (fn(self : Self) -> _IiDrain)(_IiDrain(bag : self, i : usize(0)))
  )
);
impl(&_IiBag, IntoIterator(Item : usize, IntoIter : _IiCount, into_iter : (fn(self : Self) -> _IiCount)(_IiCount(left : self.xs.len()))));
_ii_bag :: (fn() -> _IiBag)({
  (mut(xs) : ArrayList(i32)) = ArrayList(i32).new();
  xs.push(i32(5));
  xs.push(i32(7));
  _IiBag(xs : xs)
});
test("(i) bag.into_iter() consumes; (&bag).into_iter() borrows and bag is usable after", {
  bag := _ii_bag();
  (mut(counted) : _IiCount) = (&bag).into_iter();
  (mut(n) : usize) = usize(0);
  while(counted.next().is_some(), {
    n = (n + usize(1));
  });
  assert(n == usize(2), "the borrowing impl walked the bag's length");
  assert(bag.xs.len() == usize(2), "bag is usable after (&bag).into_iter()");
  (mut(drain) : _IiDrain) = bag.into_iter();
  (mut(sum) : i32) = i32(0);
  while(true, {
    match(
      drain.next(),
      .Some(x) => {
        sum = (sum + x);
      },
      .None => break
    );
  });
  assert(sum == i32(12), "the consuming impl owns the elements");
  comptime_expect_error({
    b2 := _ii_bag();
    _d := b2.into_iter();
    _l := b2.xs.len();
  }, "use of moved value: `b2`");
});
// (ii) Two traits whose methods both take the receiver as `&C`: E0616 names
// both impls; the qualified call names one.
_AmC :: struct(n : i32);
derive(_AmC, Copy, Clone);
_AmA :: trait(am : (fn(self : Self) -> i32));
_AmB :: trait(am : (fn(self : &Self) -> i32));
impl(&_AmC, _AmA(am : (fn(self : Self) -> i32)(i32(10))));
impl(_AmC, _AmB(am : (fn(self : &Self) -> i32)(i32(20))));
test("(ii) impl(&C, A(m : Self)) beside impl(C, B(m : &Self)) is E0616; the qualified call dispatches", {
  c := _AmC(n : i32(0));
  comptime_expect_error((&c).am(), "impl(&_AmC, _AmA) (am : fn(self : Self))");
  comptime_expect_error((&c).am(), "impl(_AmC, _AmB) (am : fn(self : &Self))");
  comptime_expect_error((&c).am(), "both take the receiver as &_AmC");
  comptime_expect_error(c.am(), "is ambiguous");
  assert((&_AmC <: _AmA).am(&c) == i32(10), "named: impl(&_AmC, _AmA)");
  assert((_AmC <: _AmB).am(&c) == i32(20), "named: impl(_AmC, _AmB)");
});
// (iv) A move-only owned receiver with a by-value `impl(C, …)` and a
// by-value `impl(&C, …)`: `c.m()` consumes (step 0); only `(&c).m()` borrows.
_MoC :: struct(xs : ArrayList(i32));
_MoTr :: trait(mo : (fn(self : Self) -> usize));
_MoTr2 :: trait(mo : (fn(self : Self) -> usize));
impl(_MoC, _MoTr(mo : (fn(self : Self) -> usize)(self.xs.len())));
impl(&_MoC, _MoTr2(mo : (fn(self : Self) -> usize)(self.xs.len() + usize(100))));
_mo_make :: (fn() -> _MoC)(_MoC(xs : ArrayList(i32).new()));
test("(iv) an owned move-only c takes the by-value impl(C, …) and is consumed", {
  c := _mo_make();
  assert((&c).mo() == usize(100), "(&c).mo(): impl(&_MoC, _MoTr2) borrows");
  assert(c.mo() == usize(0), "c.mo(): impl(_MoC, _MoTr) at step 0");
  comptime_expect_error({
    c2 := _mo_make();
    _a := c2.mo();
    _b := c2.xs.len();
  }, "use of moved value: `c2`");
});
// Two traits whose methods differ only by `self : Self` and `self : &Self`
// both register on one type; an owned receiver takes the by-value one (step
// 0), `(&c)` the borrowing one.
_SvC :: struct(n : i32);
derive(_SvC, Copy, Clone);
_SvByValue :: trait(sv : (fn(self : Self) -> i32));
_SvByRef :: trait(sv : (fn(self : &Self) -> i32));
impl(_SvC, _SvByValue(sv : (fn(self : Self) -> i32)(i32(1))));
impl(_SvC, _SvByRef(sv : (fn(self : &Self) -> i32)(i32(2))));
test("two traits differing only by Self and &Self register and dispatch by probe step", {
  c := _SvC(n : i32(0));
  assert(c.sv() == i32(1), "c.sv(): the slot _SvC at step 0");
  assert((&c).sv() == i32(2), "(&c).sv(): the slot &_SvC at step 0");
  assert((_SvC <: _SvByValue).sv(c) == i32(1), "named: by value");
  assert((_SvC <: _SvByRef).sv(&c) == i32(2), "named: by reference");
});
// The explicit borrow cannot reach what it does not lend.
_ExC :: struct(xs : ArrayList(i32));
_ExTake :: trait(take_all : (fn(self : Self) -> usize));
_ExGrow :: trait(grow : (fn(self : &mut Self) -> unit));
impl(_ExC, _ExTake(take_all : (fn(self : Self) -> usize)(self.xs.len())));
impl(_ExC, _ExGrow(grow : (fn(self : &mut Self) -> unit)(self.xs.push(i32(1)))));
test("(&c) does not move out of c, nor write through a shared borrow", {
  (mut(c) : _ExC) = _ExC(xs : ArrayList(i32).new());
  comptime_expect_error((&c).take_all(), "would move out of what the borrow refers to");
  comptime_expect_error((&c).grow(), "would write through a shared borrow");
  comptime_expect_error((&c).shrink(), "Receiver slot types probed: &_ExC, &&_ExC, &mut &_ExC, _ExC, &mut _ExC.");
  (&mut c).grow();
  assert(c.xs.len() == usize(1), "(&mut c).grow() wrote c in place");
});
// (vii) The std blanket shape over references, spelled by a user: `&T`
// shows wherever `T` does, its body the type-qualified call on `self.*`.
// `(&c).show()` takes the blanket (its slot `&_ShC` is step 0); `c.show()`
// takes `impl(_ShC, …)`.
_ShShow :: trait(show : (fn(self : Self) -> i32));
_ShC :: struct(n : i32);
derive(_ShC, Copy, Clone);
impl(_ShC, _ShShow(show : (fn(self : Self) -> i32)(self.n)));
impl(generic(T), where(T <: _ShShow), &T, _ShShow(show : (fn(self : Self) -> i32)(T.show(self.*) + i32(1000))));
test("(vii) a user blanket impl(generic(T), where(T <: Show), &T, Show(…))", {
  comptime_assert(Type.impls(&_ShC, _ShShow), "the blanket covers &_ShC");
  c := _ShC(n : i32(7));
  assert(c.show() == i32(7), "c.show(): impl(_ShC, _ShShow)");
  assert((&c).show() == i32(1007), "(&c).show(): the blanket over &T");
});
// (viii) Coherence: the origin is not part of a reference receiver's key, and
// a bare-variable blanket covers `&C` too.
_CoC :: struct(n : i32);
_CoTr :: trait(co : (fn(self : Self) -> i32));
_CoTr2 :: trait(co2 : (fn(self : Self) -> i32));
impl(generic(p : Origin), &(_CoC, p), _CoTr(co : (fn(self : Self) -> i32)(i32(1))));
impl(&_CoC, _CoTr2(co2 : (fn(self : Self) -> i32)(i32(1))));
test("(viii) impl(&(C, p), Tr) twice and a bare blanket beside impl(&C, Tr) are E0612", {
  c := _CoC(n : i32(0));
  assert((&c).co() == i32(1), "impl(generic(p : Origin), &(_CoC, p), _CoTr) dispatches");
  assert((&c).co2() == i32(1), "impl(&_CoC, _CoTr2) dispatches");
  comptime_expect_error(impl(generic(q : Origin), &(_CoC, q), _CoTr(co : (fn(self : Self) -> i32)(i32(2)))), "is already implemented");
  comptime_expect_error(impl(&_CoC, _CoTr(co : (fn(self : Self) -> i32)(i32(3)))), "is already implemented");
  comptime_expect_error(impl(generic(T), T, _CoTr2(co2 : (fn(self : Self) -> i32)(i32(2)))), "is already implemented");
});
// (ix) A reference VALUE receiver (`rr.*` with `rr : &&C`) reaches a method of
// `C` through the deref step while the program has a reference impl, as it
// does without one (issues/fixed/2026-11-10-a-reference-value-receiver-is-e0601-once-the-program-has-a-reference-impl.md).
_VrC :: struct(n : i32);
impl(_VrC, vr_len : (fn(self : &Self) -> i32)(self.n));
_VrD :: struct(n : i32);
impl(&_VrD, _ShShow(show : (fn(self : Self) -> i32)(i32(1))));
test("(ix) rr.*.m() on a reference value reaches the referent's method beside a reference impl", {
  c := _VrC(n : i32(5));
  r := &c;
  rr := &r;
  assert(rr.*.vr_len() == i32(5), "rr.*.vr_len()");
  assert(rr.*.*.vr_len() == i32(5), "rr.*.*.vr_len()");
  assert((&r).vr_len() == i32(5), "(&r).vr_len()");
});
// (x) R-PROBE's reference lookups run only where a reference impl can answer
// (VERDICTS-50, `YO_DEBUG_RPROBE_AUDIT=1` aborts when the gate skips one that
// would have added a candidate): a reference impl declared through an alias
// and on a primitive, a bare-binder blanket reached at `T := &C`, and a type
// with no reference impl beside one that has.
_RgTr :: trait(rg : (fn(self : Self) -> i32));
_RgC :: struct(n : i32);
_RgAlias :: _RgC;
impl(&_RgAlias, _RgTr(rg : (fn(self : Self) -> i32)(i32(11))));
_RgPrim :: trait(rgp : (fn(self : Self) -> i32));
impl(&i32, _RgPrim(rgp : (fn(self : Self) -> i32)(i32(12))));
_RgBl :: trait(bl : (fn(self : &Self) -> i32));
impl(generic(T), T, _RgBl(bl : (fn(self : &Self) -> i32)(i32(7))));
_RgPlain :: struct(n : i32);
impl(_RgPlain, plain : (fn(self : &Self) -> i32)(self.n));
_rg_through_binding :: (fn(r : &_RgC) -> i32)(r.bl());
test("(x) the gated probe: an alias, a primitive, a blanket at T := &C, a type with no reference impl", {
  c := _RgC(n : i32(1));
  assert((&c).rg() == i32(11), "impl(&Alias, Tr) is found through the alias");
  x := i32(5);
  assert((&x).rgp() == i32(12), "impl(&i32, Tr)");
  assert(c.bl() == i32(7), "the bare blanket at T := _RgC");
  assert((&c).bl() == i32(7), "the bare blanket through an explicit borrow");
  assert(_rg_through_binding(&c) == i32(7), "the bare blanket through a `&C` binding");
  p := _RgPlain(n : i32(3));
  assert(p.plain() == i32(3), "a type with no reference impl");
});
// (xi) The probe's reference lookups are keyed by (head, method)
// (VERDICTS-51): `impl(&C, Tr)` registering `m1` answers `(&c).m1()` while
// `c.m2()` (a method of `C` alone) resolves without them, and a method only a
// trait DEFAULT provides through a reference impl is found.
_HmC :: struct(n : i32);
impl(_HmC, hm2 : (fn(self : &Self) -> i32)(self.n));
_HmTr :: trait(hm1 : (fn(self : Self) -> i32), (hmd : (fn(self : Self) -> i32)) ?= (self -> i32(40)));
impl(&_HmC, _HmTr(hm1 : (fn(self : Self) -> i32)(i32(30))));
_HmG :: struct(n : i32);
impl(generic(p : Origin), &(_HmG, p), _HmTr(hm1 : (fn(self : Self) -> i32)(i32(31))));
test("(xi) (head, method): a reference impl's method, a method of the value type alone, a trait default", {
  c := _HmC(n : i32(2));
  assert((&c).hm1() == i32(30), "the reference impl's member");
  assert(c.hm2() == i32(2), "a method of C alone, on an owned receiver");
  assert((&c).hm2() == i32(2), "a method of C alone, through (&c)");
  assert((&c).hmd() == i32(40), "a trait default reached through the reference impl");
  g := _HmG(n : i32(5));
  assert((&g).hm1() == i32(31), "a generic reference impl's member");
  assert((&g).hmd() == i32(40), "a generic reference impl's trait default");
});
test("(xi) (head, method) on an owned receiver: a reference impl's member and a trait default it took", {
  c := _HmC(n : i32(2));
  assert(c.hm1() == i32(30), "the reference impl's member, receiver C");
  assert(c.hmd() == i32(40), "a trait default only the reference impl provides, receiver C");
  g := _HmG(n : i32(5));
  assert(g.hm1() == i32(31), "a generic reference impl's member, receiver G");
  assert(g.hmd() == i32(40), "a generic reference impl's trait default, receiver G");
});

// (xi) P3b gap 3 (VERDICTS-49): a receiver slot `self : &Self` at `Self = &C`
// is a `&&C` slot and is accepted; the trait fixes the receiver mode, so an
// impl over a reference type has no other spelling.
_PbTr :: trait(pb : (fn(self : &Self) -> i32));
_PbC :: struct(n : i32);
impl(&_PbC, _PbTr(pb : (fn(self : &Self) -> i32)(self.*.*.n)));
_pb_qualified :: (fn(r : &_PbC) -> i32)((&_PbC <: _PbTr).pb(&r));
test("(iii) a `self : &Self` receiver over impl(&C, Tr): a reference binding, an explicit borrow, a qualified call", {
  c := _PbC(n : i32(4));
  r := &c;
  assert(r.pb() == i32(4), "step 1 on a reference binding lends the binding's own storage");
  assert(_pb_qualified(r) == i32(4), "a `&&C` argument to the qualified call");
  // A reference TEMPORARY or an owned place has no storage of its own to lend
  // as a `&&C`: an error at the call naming the repair, never the mis-passed C.
  comptime_expect_error((&c).pb(), "is not a reference binding whose own storage the call could lend");
  comptime_expect_error(c.pb(), "is not a reference binding whose own storage the call could lend");
});
// (vii) the std blanket's shape before std spells it: a trait with a
// `self : &Self` receiver over `impl(&T, …)` whose body forwards to `T`'s impl.
_PbShow :: trait(show : (fn(self : &Self) -> i32));
impl(_PbC, _PbShow(show : (fn(self : &Self) -> i32)(self.n)));
impl(generic(T), where(T <: _PbShow), &T, _PbShow(show : (fn(self : &Self) -> i32)(T.show(&self.*.*))));
_pb_show_generic :: (fn(generic(T : Type), v : &T, where(T <: _PbShow)) -> i32)(v.show());
test("(vii-b) a blanket impl(&T, Show) with a `self : &Self` receiver, called through a generic bound", {
  c := _PbC(n : i32(9));
  r := &c;
  assert(_pb_show_generic(r) == i32(9), "T := _PbC");
  assert(c.show() == i32(9), "the owned receiver");
});
// (R3, VERDICTS-54) A by-value slot keeps what it declared. `Self` is a written
// reference at an `impl(&C)` and a type variable's name at a bare-variable
// blanket: neither specializes into a by-value reference slot, so they run as
// before, beside the generic `v : T` that does.
_R3Bag :: struct(n : usize);
_R3Named :: trait(nl : (fn(self : Self) -> usize));
impl(&_R3Bag, _R3Named(nl : (fn(self : Self) -> usize)(self.n)));
_R3Tr :: trait(m : (fn(self : Self) -> usize));
impl(generic(T), where(T <: _R3Named), T, _R3Tr(m : (fn(self : Self) -> usize)(self.nl() + usize(1))));
_r3_mk :: (fn() -> _R3Bag)(_R3Bag(n : usize(9)));
test("(R3 q1) a bare-variable blanket's `self : Self` reached at T := &Bag", {
  b := _R3Bag(n : usize(3));
  r := &b;
  assert(r.m() == usize(4), "T := &Bag through a reference binding");
  assert(b.m() == usize(4), "an owned Bag");
  assert(_r3_mk().m() == usize(10), "a temporary Bag");
});
_R3Dup :: trait(dup : (fn(self : Self) -> Self));
impl(&_R3Bag, _R3Dup(dup : (fn(self : Self) -> Self)(self)));
test("(R3 q3) `-> Self` at a concrete Self = &Bag", {
  b := _R3Bag(n : usize(3));
  r := &b;
  q := r.dup();
  qn := q.n;
  assert(qn == usize(3), "the result is the reference");
});
test("(R3) an owned temporary receiver picks the by-value impl: `.clone().into_iter()` runs and counts", {
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  xs.push(i32(3));
  (mut(it) : ArrayListIter(i32)) = xs.clone().into_iter();
  (mut(count) : usize) = usize(0);
  while(it.next().is_some(), {
    count = (count + usize(1));
  });
  assert(count == usize(3), "the clone's three elements");
  assert(xs.len() == usize(3), "the original is untouched");
});

// (P3b gap 1, VERDICTS-49) An infix operator's operand that is a reference
// binding selects with its reference type: `ra == rb` on `ra, rb : &C` is
// `Eq(&C)` (Rust's `impl PartialEq<&B> for &A`), whose `lhs : &Self` slot is
// the `&&C` the binding's own storage fills. It is never an auto-deref: with
// no impl over `&C` that takes the operands, the operand stays a whole-value
// read (E0926, spelled `ra.*`). Since G2 piece 3 the impl over `&_PgC` is the
// prelude's blanket `Eq(&T)`, and a user impl over `&_PgC` beside it is E0612.
_PgC :: struct(n : i32);
derive(_PgC, Eq);
// A by-value `Self` slot at `Self = &C` is not selected for two reference
// bindings yet (issues/2026-11-13-an-operator-impl-over-a-reference-with-by-value-operands-is-not-selected-for-reference-bindings.md).
impl(
  &_PgC,
  Add(&_PgC)(
    Output : i32,
    (+) : (fn(lhs : Self, rhs : Self) -> Self.Output)(lhs.n + rhs.n)
  )
);
_PgNoEq :: struct(n : i32);
test("(P3b gap 1) `ra == rb` on two reference bindings is the impl over `&C`", {
  a := _PgC(n : i32(1));
  b := _PgC(n : i32(1));
  d := _PgC(n : i32(2));
  ra := &a;
  rb := &b;
  rd := &d;
  assert(ra == rb, "two referents holding 1 are equal, through Eq(&_PgC)");
  assert(!(ra == rd), "1 and 2 differ");
  assert(ra != rd, "the impl's `!=`");
  comptime_expect_error(ra + rd, "reading the value it refers to is spelled");
});
test("(P3b gap 1) an operand no impl over `&C` takes stays E0926", {
  b := _PgC(n : i32(1));
  ra := &b;
  // `&C == C`: the impl over `&C` takes a `&C` right operand only.
  comptime_expect_error(ra == b, "reading the value it refers to is spelled");
  x := i32(1);
  rx := &x;
  comptime_expect_error(rx + i32(1), "reading the value it refers to is spelled");
  e := _PgNoEq(n : i32(1));
  re := &e;
  re2 := &e;
  comptime_expect_error(re == re2, "reading the value it refers to is spelled");
  comptime_expect_error(
    impl(&_PgC, Eq(&_PgC)((==) : (fn(lhs : &Self, rhs : &Self) -> bool)(lhs.*.*.n == rhs.*.*.n))),
    "is already implemented"
  );
});

// (G2 piece 3, VERDICTS-49) The prelude's blanket `Eq`/`Ord` over a sized `&T`
// (Rust's `impl PartialEq<&B> for &A`, `impl Ord for &A`): a reference
// compares and orders as its referent, so generic code at `T := &U` has the
// bounds. A move-only referent (`String`) shows nothing is copied. `Hash(&T)`
// and `ToString(&T)` are not in std yet
// (issues/2026-11-13-a-blanket-hash-impl-over-a-reference-rebinds-a-generic-impls-key-to-a-reference-of-itself.md,
// issues/2026-11-13-a-blanket-tostring-impl-over-a-reference-answers-an-rc-receiver-whose-payload-has-the-method.md).
_g3_same :: (fn(generic(T : Type), a : T, b : T, where(T <: Eq(T))) -> bool)(a == b);
_g3_less :: (fn(generic(T : Type), a : T, b : T, where(T <: Ord(T))) -> bool)(a < b);
test("(G2 piece 3) `==`, `!=`, `<` and `cmp` on two references compare the referents", {
  a := String.from("apple");
  b := String.from("apple");
  c := String.from("pear");
  ra := &a;
  rb := &b;
  rc := &c;
  assert(ra == rb, "equal referents");
  assert(ra != rc, "different referents");
  assert(ra < rc, "apple < pear");
  assert(!(rc <= ra), "pear > apple");
  assert(match((&String).cmp(&ra, &rc), .Less => true, _ => false), "cmp forwards String's cmp");
  x := i32(3);
  y := i32(3);
  rx := &x;
  ry := &y;
  assert(rx == ry, "two places holding 3");
  assert(rx >= ry, "3 >= 3");
});
test("(G2 piece 3) generic code at `T := &U` has `Eq` and `Ord`", {
  a := String.from("x");
  b := String.from("x");
  c := String.from("y");
  assert(_g3_same(&a, &b), "Eq(&String) through a bound");
  assert(!_g3_same(&a, &c), "different referents through a bound");
  assert(_g3_less(&a, &c), "Ord(&String) through a bound");
  assert(_g3_same(i32(3), i32(3)), "the owned instance beside it");
});
test("(G2 piece 3) a list of references sorts by its referents", {
  a := String.from("b");
  b := String.from("c");
  c := String.from("a");
  mut(xs) := ArrayList(&String).new();
  xs.push(&a);
  xs.push(&b);
  xs.push(&c);
  xs.sort();
  assert(xs(usize(0)).* == "a", "first");
  assert(xs(usize(2)).* == "c", "last");
  assert(a == "b", "the referents are untouched");
});
test("(G2 piece 3) mixed shapes have no impl: the operand is E0926", {
  x := i32(1);
  rx := &x;
  comptime_expect_error(rx == x, "reading the value it refers to is spelled");
  comptime_expect_error(rx + i32(1), "reading the value it refers to is spelled");
});
