pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf, FILE } :: import("std/libc/stdio.yo");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AnyError, Error, Exception, IoExn } :: import("std/error");
{ path_join } :: import("./helper.yo");
TestDyn :: trait(
  print : (fn(self : &*Self) -> unit),
  return_i32 : (fn(self : &*Self) -> i32)
);
use_test_dyn :: (
  fn(
    value : &Dyn(TestDyn)
  ) -> i32
)({
  value.print();
  return(value.return_i32());
});
MyBox :: struct(
  x : i32
);
impl(
  MyBox,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      unsafe(printf("Disposing Boxed i32 with value: %d\n", self.x));
    })
  )
);
impl(
  i32,
  TestDyn(
    print : (
      self -> {
        unsafe(printf("i32 value: %d\n", self.*.*));
      }
    ),
    return_i32 : (
      self -> {
        return(self.*.*);
      }
    )
  )
);
impl(
  bool,
  TestDyn(
    print : (
      self -> {
        cond(
          self.*.* => unsafe(printf("bool value: true\n")),
          true => unsafe(printf("bool value: false\n"))
        );
      }
    ),
    return_i32 : (
      self ->
        cond(
          self.*.* => 1,
          true => return(0)
        )
    )
  )
);
impl(
  MyBox,
  TestDyn(
    print : (
      self -> {
        unsafe(printf("Boxed i32 value: %d\n", self.x)); // Test auto-dereference
        unsafe(printf("Boxed i32 value: %d\n", self.*.*.x)); // Test manual dereference
      }
    ),
    // Let's x2 here
    return_i32 : (
      self -> {
        return(self.x + (self.*.*.x));
      }
    )
  )
);
add :: (fn(x : i32, y : i32) -> i32)({
  return(x + y);
});
test("Test simple dynamic dispatch with `box`", {
  assert(use_test_dyn(dyn(Box.new(i32(42)))) == 42);
  assert(use_test_dyn(dyn(Box.new(true))) == 1);
  bi := MyBox(100);
  assert(use_test_dyn(dyn(Box.new(bi))) == 200);
});
test("Test simple dynamic dispatch with `Rc(T)`", {
  assert(use_test_dyn(dyn(Rc(i32).new(i32(42)))) == 42);
  assert(use_test_dyn(dyn(Rc(bool).new(true))) == 1);
  bi := MyBox(100);
  assert(use_test_dyn(dyn(Box.new(bi))) == 200);
});
test("Test simple dynamic dispatch with automatic `box` call on value types", {
  assert(use_test_dyn(dyn(Box.new(i32(42)))) == 42);
  assert(use_test_dyn(dyn(Box.new(true))) == 1);
  bi := MyBox(100);
  assert(use_test_dyn(dyn(Box.new(bi))) == 200);
});
test("Test Dyn with multiple traits", {
  Speak :: trait(
    speak : (fn(self : &Self) -> i32)
  );
  Run :: trait(
    run : (fn(self : &Self) -> i32)
  );
  Dog :: struct();
  derive(Dog, Copy, Clone);
  DogSpeak :: impl(
    Dog,
    Speak(
      speak : (
        (self : Self) -> {
          unsafe(printf("Woof!\n"));
          return(1);
        }
      )
    )
  );
  DogRun :: impl(
    Dog,
    Run(
      run : (
        (self : Self) -> {
          unsafe(printf("The dog is running!\n"));
          return(2);
        }
      )
    )
  );
  act :: (fn(s : &Dyn(Speak, Run)) -> i32)(s.speak() + s.run());
  dog := Dog();
  result := act(dyn(Box.new(dog)));
  assert(result == 3, "Expected result to be 3");
  assert(dog.speak() == 1, "Expected dog.speak() to return 1");
});
import("std/string");
{ ToString, print } :: import("std/fmt");
test("Test downcast success", {
  Cat :: struct(name : String);
  derive(Cat, Clone);
  impl(Cat, ToString(to_string : (self -> self.name.clone())));
  Animal :: Box(Dyn(ToString, Clone));
  (animal : Animal) = dyn(Cat(`whiskers`));
  maybe_cat := downcast(&animal.*, Cat);
  match(
    maybe_cat,
    .Some(cat) => {
      assert(cat.name == `whiskers`, "Expected cat.name to be 'whiskers'");
    },
    .None => {
      assert(false, "Expected Some(Cat), got None");
    }
  );
});
test("Test downcast failure", {
  Cat :: struct(name : String);
  derive(Cat, Clone);
  impl(Cat, ToString(to_string : (self -> self.name.clone())));
  Dog :: struct(name : String);
  derive(Dog, Clone);
  impl(Dog, ToString(to_string : (self -> self.name.clone())));
  Animal :: Box(Dyn(ToString, Clone));
  (animal : Animal) = dyn(Cat(`whiskers`));
  maybe_dog := downcast(&animal.*, Dog);
  match(
    maybe_dog,
    .Some(d) => {
      assert(false, "Expected None, got Some(Dog)");
    },
    .None => {
      assert(true);
    }
  );
});
test("Test downcast type check via is_some", {
  Cat :: struct(name : String);
  derive(Cat, Clone);
  impl(Cat, ToString(to_string : (self -> self.name.clone())));
  Dog :: struct(name : String);
  derive(Dog, Clone);
  impl(Dog, ToString(to_string : (self -> self.name.clone())));
  Animal :: Box(Dyn(ToString, Clone));
  (animal : Animal) = dyn(Cat(`whiskers`));
  assert(downcast(&animal.*, Cat).is_some(), "Expected animal to be a Cat");
  assert(downcast(&animal.*, Dog).is_none(), "Expected animal to not be a Dog");
});
// Regression (issues/fixed/downcast-to-a-never-dyned-value-type-emits-invalid-c.md):
// a downcast whose TARGET is a VALUE type that no `dyn()` in the program ever
// wraps used to fall back to the object cast — `((StructType)__yo_incr_rc(...))`
// — which is not valid C ("used type … where arithmetic or pointer type is
// required"), so the whole build died inside the C compiler. Nothing in this
// file boxes a `NeverDynnedValue` or a `NeverDynnedPoint` into a Dyn, so no
// vtable carries their type ids and both answers are statically `.None`. (The
// second was `String` until B8 made it move-only: a downcast to a move-only type
// needs a Dyn that lists `Clone`, E0901.)
test("Test downcast to a value type that no dyn() in the program wraps", {
  Cat :: struct(name : String);
  derive(Cat, Clone);
  impl(Cat, ToString(to_string : (self -> self.name.clone())));
  // A PAYLOAD variant matters: a fieldless enum lowers to a C integer, and the
  // old object-cast fallback then compiled (as a pointer-to-int cast) instead of
  // failing loudly. The struct-shaped variants are what the C compiler rejects.
  NeverDynnedValue :: enum(Boom(code : i32), Bang);
  impl(NeverDynnedValue, ToString(to_string : (self -> `never`)));
  Animal :: Box(Dyn(ToString, Clone));
  (animal : Animal) = dyn(Cat(`whiskers`));
  assert(downcast(&animal.*, NeverDynnedValue).is_none(), "a never-dyn'd value enum can never be inside a Dyn");
  NeverDynnedPoint :: struct(x : i32, y : i32);
  assert(downcast(&animal.*, NeverDynnedPoint).is_none(), "a never-dyn'd value struct can never be inside a Dyn");
  // Over-rejection canary in the same batch: the target that IS wrapped here
  // must still be found.
  assert(downcast(&animal.*, Cat).is_some(), "Expected animal to still be a Cat");
  // The operand of a statically-`.None` downcast is still evaluated — here it is
  // a CALL that builds a fresh Dyn, not a plain local.
  make_animal :: (fn() -> Animal)(dyn(Cat(`shadow`)));
  assert(downcast(make_animal(), NeverDynnedValue).is_err(), "Expected None from a freshly built Dyn too");
});
// Regression (issues/fixed/dyn-as-a-direct-downcast-argument-reports-got-option.md):
// a bare `dyn(...)` as downcast's FIRST argument has nothing to say WHICH Dyn
// to build — downcast accepts any Dyn, so the position supplies no expected
// type. The evaluator used to fall back to an EMPTY Dyn (zero traits): `yo
// check` passed and the build then died inside the C compiler on
// `/* Error: dyn() call missing trait values */`. It now reports at the `dyn`
// token that the Dyn type cannot be inferred; the two spellings that DO
// supply one (an annotated binding, a declared return type) keep working.
test("Test downcast rejects a bare dyn() operand it cannot infer a Dyn for", {
  Cat :: struct(name : String);
  derive(Cat, Clone);
  impl(Cat, ToString(to_string : (self -> self.name.clone())));
  Animal :: Box(Dyn(ToString, Clone));
  comptime_expect_error(downcast(dyn(Cat(`shadow`)), Cat), "cannot infer the Dyn type");
  // The two accepted spellings from the issue, as over-rejection canaries in
  // the same batch:
  (animal : Animal) = dyn(Cat(`shadow`));
  assert(downcast(&animal.*, Cat).is_some(), "the annotated-binding spelling supplies the Dyn");
  make_animal :: (fn() -> Animal)(dyn(Cat(`shadow`)));
  assert(downcast(make_animal(), Cat).is_ok(), "the declared-return spelling supplies the Dyn");
});
test("Test downcast with multiple concrete types", {
  Cat :: struct(name : String);
  derive(Cat, Clone);
  impl(Cat, ToString(to_string : (self -> self.name.clone())));
  Dog :: struct(name : String);
  derive(Dog, Clone);
  impl(Dog, ToString(to_string : (self -> self.name.clone())));
  Animal :: Box(Dyn(ToString, Clone));
  (cat_animal : Animal) = dyn(Cat(`kitty`));
  (dog_animal : Animal) = dyn(Dog(`buddy`));
  // Downcast cat_animal
  match(
    downcast(&cat_animal.*, Cat),
    .Some(cat) => assert(cat.name == `kitty`, "Expected kitty"),
    .None => assert(false, "Expected Some(Cat)")
  );
  match(
    downcast(&cat_animal.*, Dog),
    .Some(d) => assert(false, "cat_animal should not be Dog"),
    .None => assert(true)
  );
  // Downcast dog_animal
  match(
    downcast(&dog_animal.*, Dog),
    .Some(dog) => assert(dog.name == `buddy`, "Expected buddy"),
    .None => assert(false, "Expected Some(Dog)")
  );
  match(
    downcast(&dog_animal.*, Cat),
    .Some(c) => assert(false, "dog_animal should not be Cat"),
    .None => assert(true)
  );
});
// Regression (issues/fixed/dyn-trait-with-future-returning-method-splices-struct-into-vtable.md, C17):
// a Dyn(trait) whose method returns Impl(Future(..)) — resolving the member's C
// type minted the Future struct on demand INSIDE the open vtable typedef, and
// clang rejected the program ("field has incomplete type", "unknown type
// name"). The vtable now collects its member lines before opening the typedef.
AsyncRead :: trait(read : (fn(self : &Self, io : Io) -> Impl(Future(usize, IoExn))));
FixedSrc :: struct(n : usize);
impl(
  FixedSrc,
  AsyncRead(
    read : (fn(self : &Self, io : Io) -> Impl(Future(usize, IoExn)))(
      io.async({ n : self.n }(e : IoExn) => {
        return(n);
      })
    )
  )
);
DynReader :: struct(inner : Box(Dyn(AsyncRead)));
impl(
  DynReader,
  read_twice : (fn(self : &Self, io : Io) -> Impl(Future(usize, IoExn)))(
    io.async({ s : &self.* }(e : IoExn) => {
      a := e.io.await(s.inner.read(e.io), e);
      b := e.io.await(s.inner.read(e.io), e);
      return(a + b);
    })
  )
);
test("Dyn(trait) with a Future-returning method dispatches through the vtable", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  r := DynReader(inner : dyn(Box.new(FixedSrc(n : usize(21)))));
  b := IoExn(io : io, exn : exn);
  v := io.await(r.read_twice(io), b);
  assert(v == usize(42), "two dynamic async reads of 21");
});
// Regression (issues/fixed/dyn-box-dispose-is-emitted-with-an-empty-body.md):
// `dyn(v)` on a VALUE type boxes `v` through the prelude's
// `box :: (fn(generic(V : Type), own(value) : V) -> Rc(V))(Rc(V)(value))`.
// The callee-side binding of an `own` parameter was never marked owning, so a
// GENERIC function — whose body is evaluated against THAT binding, not the
// def-time one — never scheduled the parameter's scope-end drop while the
// body's store still emitted the balancing `___dup`. Every value boxed into a
// `Dyn` therefore kept a reference nobody owned and was never released.
// `AnyError` is `Dyn(Error)`, so it leaked on every thrown error. The
// `Drop` counter observes the release directly. `DynPayloadRes` is a counted
// handle (`Rc`) so a downcast copy and the Dyn's box can share it.
(mut(g_dyn_payload_disposed) : i32) = i32(0);
_DynPayloadVal :: struct(tag : i32);
DynPayloadRes :: Rc(_DynPayloadVal);
_dpr :: (fn(tag : i32) -> DynPayloadRes)(Rc.new(_DynPayloadVal(tag : tag)));
impl(
  _DynPayloadVal,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_dyn_payload_disposed = (g_dyn_payload_disposed + i32(1));
    })
  )
);
DynStructPayload :: struct(r : DynPayloadRes);
derive(DynStructPayload, Clone);
impl(
  DynStructPayload,
  TestDyn(
    print : (
      self -> ()
    ),
    return_i32 : (
      self -> self.*.*.r.tag
    )
  )
);
DynEnumPayload :: enum(Held(r : DynPayloadRes), Empty);
impl(
  DynEnumPayload,
  TestDyn(
    print : (
      self -> ()
    ),
    return_i32 : (
      self -> i32(0)
    )
  )
);
// A payload that itself owns heap memory: a missed teardown loses the String's
// buffer as well as the `DynPayloadRes` handle.
DynHeapPayload :: struct(name : String, r : DynPayloadRes);
impl(
  DynHeapPayload,
  TestDyn(
    print : (
      self -> ()
    ),
    return_i32 : (
      self -> i32(0)
    )
  )
);
test("a value STRUCT boxed into Dyn releases its payload", {
  before := g_dyn_payload_disposed;
  {
    (d : Box(Dyn(TestDyn))) = dyn(Box.new(DynStructPayload(r : _dpr(i32(7)))));
    assert(d.return_i32() == i32(7), "the boxed value is reachable through the vtable");
    assert(g_dyn_payload_disposed == before, "nothing is released while the Dyn is live");
  };
  assert(
    (g_dyn_payload_disposed - before) == i32(1),
    "the boxed struct payload is released exactly once"
  );
});
test("a value ENUM boxed into Dyn releases its payload", {
  before := g_dyn_payload_disposed;
  {
    (d : Box(Dyn(TestDyn))) = dyn(Box.new(DynEnumPayload.Held(r : _dpr(i32(8)))));
    assert(g_dyn_payload_disposed == before, "nothing is released while the Dyn is live");
  };
  assert(
    (g_dyn_payload_disposed - before) == i32(1),
    "the boxed enum payload is released exactly once"
  );
});
// The other half of the same bug: `downcast` extracted the Box's value field
// WITHOUT dup'ing it whenever the target had no user `___dup` method (String, a
// value enum, a value struct — everything dup'd structurally). While `box`
// leaked a reference that over-count masked it; with the refcount exact, the
// caller's scope-end drop and the Box's dispose released the same allocation —
// a heap-use-after-free ASan caught on both Linux legs.
test("a view downcast of a value payload copies nothing", {
  before := g_dyn_payload_disposed;
  {
    (d : Box(Dyn(TestDyn, Clone))) = dyn(Box.new(DynStructPayload(r : _dpr(i32(11)))));
    match(
      downcast(&d.*, DynStructPayload),
      .Some(p) => {
        assert(p.r.tag == i32(11), "the view reads the payload");
        assert(ref_count(p.r) == 1, "a view copies nothing: the Dyn's box holds the only reference");
      },
      .None => assert(false, "expected the downcast to succeed")
    );
    assert(g_dyn_payload_disposed == before, "nothing is released while the Dyn is live");
  };
  assert(
    (g_dyn_payload_disposed - before) == i32(1),
    "the downcast payload is released exactly once"
  );
});
test("a Dyn payload that owns heap memory releases it", {
  before := g_dyn_payload_disposed;
  {
    (d : Box(Dyn(TestDyn))) = dyn(DynHeapPayload(name : `a string on the heap`, r : _dpr(i32(9))));
    assert(g_dyn_payload_disposed == before, "nothing is released while the Dyn is live");
  };
  assert(
    (g_dyn_payload_disposed - before) == i32(1),
    "the heap-owning payload is released exactly once"
  );
});
// ---------------------------------------------------------------------------
// Regression (issues/fixed/dyn-does-not-check-that-the-value-implements-the-traits.md):
// `dyn(x)` never verified that `x`'s type implements the traits of the `Dyn` it
// is coerced into. A required member the type does not implement (and that has
// no trait `?=` default) resolved to a `.None` field value: codegen's wrapper
// emitter SKIPPED the method with a comment while its vtable emitter still named
// the wrapper, so a plain type error surfaced as `use of undeclared identifier
// '__yo_wrap_..._to_string'` from the C compiler. And where the member DID have
// a default (`Error.source`), nothing looked wrong at all — a type the compiler
// itself reports as not implementing `Error` was stored in an `AnyError` and
// dispatched through it.
//
// The `Dog :: struct();` comment that used to sit in "Test Dyn with multiple
// traits" ("This should give error working with `dyn`") is now these tests.
// ---------------------------------------------------------------------------
test("Test dyn rejects a type that implements none of the Dyn's traits", {
  // No `impl(NoImpls, TestDyn(...))` anywhere: neither `print` nor `return_i32`
  // resolves, so this is symptom 1 — the undeclared-wrapper C failure.
  NoImpls :: struct();
  comptime_expect_error(use_test_dyn(dyn(Box.new(NoImpls()))));
  // The same hole through the AUTO-BOX path: a value enum with no impls at all.
  NoImplsValue :: enum(Boom);
  derive(NoImplsValue, Copy, Clone);
  comptime_expect_error(use_test_dyn(dyn(Box.new(NoImplsValue.Boom))));
});
test("Test dyn rejects a type that satisfies only PART of the Dyn's traits", {
  // `AnyError` is `Dyn(Error)` and `Error` carries `where(Self <: ToString)`, so
  // `Dyn(Error)`'s required set is (Error, ToString). A ToString-only type used
  // to be accepted and dispatched — symptom 2, the silent one: `source` resolved
  // to the trait's `?=` default, so the program ran and printed plausible text.
  ToStringOnly :: enum(Boom);
  derive(ToStringOnly, Copy, Clone);
  impl(ToStringOnly, ToString(to_string : (self -> `boom`)));
  comptime_expect_error({
    (e : AnyError) = dyn(Box.new(ToStringOnly.Boom));
    e
  });
});
// --- Over-rejection canaries for the check above. Every shape below is a LEGAL
// --- `dyn()` and must keep compiling AND running.
test("Test Dyn(Error) over a trait default the implementor omits", {
  // Neither type overrides `Error.source`, which has a `?=` default — "no impl
  // for this member" must NOT be read as "does not implement the trait".
  RefErr :: struct(msg : String);
  impl(
    RefErr,
    ToString(
      to_string : (fn(self : &Self) -> String)({
        return(self.msg.clone());
      })
    )
  );
  impl(RefErr, Error());
  impl(
    RefErr,
    Clone(
      clone : (fn(self : &Self) -> Self)(RefErr(msg : self.msg.clone()))
    )
  );
  // A VALUE enum goes through the auto-box path, so the bound must be decided on
  // the UNBOXED concrete rather than on `Rc(ValErr)`.
  ValErr :: enum(Boom, Bust);
  derive(ValErr, Copy, Clone);
  impl(
    ValErr,
    ToString(
      to_string : (fn(self : &Self) -> String)(
        match(self, .Boom => `boom`, .Bust => `bust`)
      )
    )
  );
  impl(ValErr, Error());
  (re : AnyError) = dyn(RefErr(`ref-err`));
  assert(`${re}` == `ref-err`, "Dyn(Error) from a ref struct");
  assert(`e: ${re}!` == `e: ref-err!`, "a Dyn(Error) as a later template part (ToString's append_to)");
  match(re.source(), .Some(_) => assert(false, "default source must be None"), .None => ());
  (ve : AnyError) = dyn(Box.new(ValErr.Bust));
  assert(`${ve}` == `bust`, "Dyn(Error) from a value enum (auto-box)");
  match(ve.source(), .Some(_) => assert(false, "default source must be None (enum)"), .None => ());
});
_use_to_string_dyn :: (fn(v : &Dyn(ToString)) -> String)(v.to_string());
_generic_show :: (fn(generic(T : Type), v : &T, where(T <: ToString)) -> String)(
  _use_to_string_dyn(dyn(Box.new(v.*)))
);
test("Test dyn inside a generic body whose concrete is still a type variable", {
  // At DEFINITION time `T` is an unbound `SomeT`, so the bound is undecidable —
  // `type_implements_trait` answers `false` for want of a concrete. Rejecting
  // there would break every `dyn(v)` written under a `where(T <: Trait)`; the
  // check has to defer to the specialization below.
  assert(_generic_show(i32(5)) == `5`, "dyn() of a generic parameter");
  assert(_generic_show(true) == `true`, "dyn() of a generic parameter, second instantiation");
});
// A trait default with a parameter after `self`, put in the vtable of a `dyn`
// of a type variable: the default was specialized with only `self` bound, so
// its body failed with `Variable "out" not found`
// (issues/fixed/2026-10-27-a-dyn-of-a-type-variable-fails-on-a-trait-default-with-a-parameter.md).
_DynDefShow :: trait(
  show : (fn(self : &Self) -> i32),
  (show_into : (fn(self : &Self, out : &mut i32) -> unit)) ?= (
    (self, out) -> {
      out.* = (out.* + self.show());
    }
  )
);
_DynDefP :: struct(x : i32);
derive(_DynDefP, Copy, Clone);
impl(_DynDefP, _DynDefShow(show : (fn(self : &Self) -> i32)(self.x)));
_dyn_def_use :: (fn(v : &Dyn(_DynDefShow)) -> i32)({
  mut(acc) := i32(1);
  v.show_into(&mut acc);
  acc
});
_dyn_def_generic :: (fn(generic(T : Type), v : &T, where(T <: _DynDefShow)) -> i32)(_dyn_def_use(dyn(Box.new(v.*))));
test("a dyn of a type variable binds every parameter of a trait default", {
  p := _DynDefP(x : i32(41));
  assert(_dyn_def_generic(&p) == i32(42), "through a dyn of the type variable");
  assert(_dyn_def_use(dyn(Box.new(p))) == i32(42), "through a concrete dyn (which moves `p`)");
  // ToString's own `append_to` default is one: a later template part calls it.
  assert(`[${_generic_show(i32(7))}]` == `[7]`, "a Dyn(ToString) rendered inside a template");
});

// An `extern("Yo", X : Type)` opaque — libc's `FILE` here — was a `SomeT` with
// an EMPTY required-trait list. `_compat_impl`'s two `Dyn`<->`SomeT` rules walk
// that list to check the `Dyn` satisfies it, so an empty list meant the loop
// body never ran and both rules returned true VACUOUSLY. Every `Dyn(Trait)`
// unified with every extern opaque, in both directions and at every depth.
// It is now a nominal `ExternOpaqueT`, identified by its C spelling.
// issues/fixed/an-extern-opaque-type-unifies-with-every-dyn.md
_file_sink :: (fn(x : *FILE) -> usize)(usize(0));
_widget_sink :: (fn(x : *String) -> usize)(usize(0));
test("Test a trait object is not accepted where an extern opaque is expected", {
  comptime_expect_error((fn(p : *Box(Dyn(ToString))) -> usize)(_file_sink(p)));
  assert(true, "a *(Dyn(ToString)) is rejected for a *(FILE) parameter");
});
test("Test an Option of a pointer-to-trait-object keeps its payload type", {
  // The same vacuity reached `are_types_compatible_exact`, which the CTFE
  // instantiation memo uses to compare type arguments — so a concrete
  // `Option(*(Dyn(Trait)))` request memo-hit whichever `Option(*(SomeT))` entry
  // came first: the `Option(*(FILE))` one this file's own `std/libc/stdio`
  // import creates, or the abstract `Option(*(T))` shell. Under the first the
  // payload read back as `*(FILE)`; under the second as a type variable that
  // unified with anything. Either way this `comptime_expect_error` would NOT
  // have fired, because the payload was not `*(Dyn(ToString))`.
  comptime_expect_error(
    (fn(o : ?*Box(Dyn(ToString))) -> usize)(
      match(o, .Some(p) => _widget_sink(p), .None => usize(0))
    )
  );
  assert(true, "the payload is *(Dyn(ToString)), not *(FILE) and not a wildcard");
});
// ---------------------------------------------------------------------------
// Object safety (plans/backlog/TYPE_SYSTEM_SOUNDNESS.md Phase 2.7): a method whose
// signature mentions `Self` outside the receiver, or that takes `generic(...)`
// parameters, has no vtable slot, and calling it through a Dyn is E0614
// (issues/fixed/dyn-object-safety-is-not-enforced-before-codegen.md). The
// trait's other methods stay callable through the same Dyn.
// ---------------------------------------------------------------------------
_OsSp :: trait(speak : (fn(self : &Self) -> i32), me : (fn(self : &mut Self) -> Self), same : (fn(self : &Self, other : &Self) -> bool));
_OsGen :: trait(conv : (fn(generic(B : Type), self : &mut Self, b : &B) -> i32));
_OsCat :: struct(n : i32);
derive(_OsCat, Copy, Clone);
impl(_OsCat, _OsSp(speak : (self -> self.n), me : (self -> self.*), same : ((self, other) -> (self.n == other.n))));
impl(_OsCat, _OsGen(conv : (fn(generic(B : Type), self : &mut Self, b : &B) -> i32)(self.n)));
test("Dyn: a method a Dyn cannot call is E0614, the rest stay callable", {
  (d : Box(Dyn(_OsSp))) = dyn(Box.new(_OsCat(n : i32(3))));
  assert(d.speak() == i32(3), "a Self-only-as-receiver method dispatches");
  comptime_expect_error(d.me(), "cannot be called through a Dyn receiver");
  comptime_expect_error(d.same(d), "has type Self, which the Dyn erases");
  (g : Box(Dyn(_OsGen))) = dyn(Box.new(_OsCat(n : i32(4))));
  comptime_expect_error(g.conv(i32(1)), "takes generic(...) parameters");
});
// A blanket INHERENT method over a trait bound resolves for a Dyn receiver; it
// is not a trait member and has no vtable slot, so it is an ordinary call
// (issues/fixed/blanket-inherent-method-on-a-dyn-receiver-dispatches-through-the-vtable.md).
_OsNamed :: trait(name : (fn(self : &Self) -> String));
impl(
  generic(E : Type),
  where(E <: _OsNamed),
  E,
  _os_shout : (fn(self : &Self) -> String)(self.name().concat(String.from("!")))
);
impl(_OsCat, _OsNamed(name : (self -> String.from("cat"))));
test("Dyn: a blanket inherent method on a Dyn receiver is a direct call", {
  (d : Box(Dyn(_OsNamed))) = dyn(Box.new(_OsCat(n : i32(1))));
  assert(d._os_shout() == String.from("cat!"), "the blanket method, whose self.name() goes through the vtable");
});
// A trait implemented through a GENERIC impl can be put behind a Dyn: the
// vtable gets the generic impl's methods specialized for the concrete type
// (issues/fixed/dyn-cannot-resolve-a-trait-method-that-comes-from-a-generic-impl.md).
_os_show :: (fn(v : &Dyn(ToString)) -> String)(v.to_string());
test("Dyn: a trait from a generic impl builds its vtable", {
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  assert(_os_show(dyn(Box.new(xs))) == String.from("[1, 2]"), "ArrayList(T)'s blanket ToString");
  assert(_os_show(dyn(Box.new(Option(i32).Some(i32(5))))) == String.from("Some(5)"), "Option(T)'s blanket ToString");
});
// No upcasting: a Dyn with more traits is not a Dyn with fewer
// (docs/en-US/DYN_DESIGN.md, Phase 2.7 decision).
_OsOt :: trait(other_n : (fn(self : &Self) -> i32));
impl(_OsCat, _OsOt(other_n : (self -> i32(1))));
_os_takes_sp :: (fn(s : &Dyn(_OsSp)) -> i32)(s.speak());
test("Dyn: no upcast from Dyn(A, B) to Dyn(A), with a note saying so", {
  (both : Box(Dyn(_OsSp, _OsOt))) = dyn(Box.new(_OsCat(n : i32(3))));
  comptime_expect_error(_os_takes_sp(&both), "write upcast(value, Dyn(...))");
  assert(both.speak() == i32(3), "the value itself is fine");
});
// Explicit upcast (plans/backlog/TYPE_SYSTEM_SOUNDNESS.md Phase 2.8): the same payload
// behind a Dyn with fewer traits. The source vtable carries the target
// vtable, so each concrete type dispatches to its own impl.
_UpDog :: struct(n : i32);
derive(_UpDog, Copy, Clone);
impl(_UpDog, _OsSp(speak : (self -> (self.n * i32(10))), me : (self -> self.*), same : ((self, other) -> (self.n == other.n))));
impl(_UpDog, _OsOt(other_n : (self -> i32(2))));
_up_both :: (fn(k : i32) -> Box(Dyn(_OsSp, _OsOt)))(
  cond((k == i32(0)) => dyn(Box.new(_OsCat(n : i32(3)))), true => dyn(Box.new(_UpDog(n : i32(4)))))
);
test("Dyn: upcast drops traits and keeps each payload's impls", {
  (cat : Box(Dyn(_OsSp, _OsOt))) = _up_both(i32(0));
  (dog : Box(Dyn(_OsSp, _OsOt))) = _up_both(i32(1));
  // A view upcast leaves the source in place; an owned one moves it.
  assert(upcast(&dog.*, Dyn(_OsOt)).other_n() == i32(2), "the dog's other_n");
  assert(cat.other_n() == i32(1), "the source is still usable after a view");
  (cs : Box(Dyn(_OsSp))) = upcast(cat, Dyn(_OsSp));
  (ds : Box(Dyn(_OsSp))) = upcast(dog, Dyn(_OsSp));
  assert(_os_takes_sp(&cs.*) == i32(3), "the cat's speak");
  assert(_os_takes_sp(&ds.*) == i32(40), "the dog's speak");
  // The same payload: the upcast Dyn downcasts back to it.
  assert(downcast(&ds.*, _UpDog).is_some(), "the payload behind the upcast Dyn");
  assert(downcast(&cs.*, _UpDog).is_none(), "a cat is not a dog");
  // A call operand is evaluated once.
  (tmp_s : Box(Dyn(_OsSp))) = upcast(_up_both(i32(1)), Dyn(_OsSp));
  assert(tmp_s.speak() == i32(40), "upcast of a call result");
});
// Regression (issues/fixed/2026-10-16-a-downcast-result-used-as-a-method-receiver-is-never-released.md):
// a `downcast`/`upcast` result owns a reference to the payload, released by
// its result temp's scope-end drop. The emitters never declared that temp, so
// the drop was skipped whenever no consumer declared it either: a method
// receiver (`downcast(d, T).is_some()`) or a discarded statement leaked the
// payload once per evaluation, and its `Drop` never ran.
// A downcast copies the payload out (a `clone`), so the cat is a cloneable
// handle onto one counted payload: a leaked result keeps it alive.
(mut(g_dc_disposed) : i32) = i32(0);
_DcCatVal :: struct(n : i32);
_DcCat :: struct(h : Rc(_DcCatVal));
derive(_DcCat, Clone);
impl(
  _DcCatVal,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_dc_disposed = (g_dc_disposed + i32(1));
    })
  )
);
impl(_DcCat, ToString(to_string : (self -> String.from("cat"))));
test("Dyn: a downcast or upcast used as a receiver or discarded releases its payload", {
  before := g_dc_disposed;
  (mut(hits) : i32) = i32(0);
  {
    (animal : Box(Dyn(ToString, Clone))) = dyn(Box.new(_DcCat(h : Rc.new(_DcCatVal(n : i32(1))))));
    (mut(i) : i32) = i32(0);
    while(i < i32(3), {
      if(downcast(&animal.*, _DcCat).is_some(), {
        hits = (hits + i32(1));
      });
      i = (i + i32(1));
    });
    downcast(&animal.*, _DcCat);
    assert(upcast(&animal.*, Dyn(ToString)).to_string() == String.from("cat"), "the upcast receiver");
    upcast(&animal.*, Dyn(ToString));
    assert(g_dc_disposed == before, "nothing is released while the Dyn is live");
  };
  assert(hits == i32(3), "every downcast saw the cat");
  assert((g_dc_disposed - before) == i32(1), "the cat is released once its Dyn dies");
  // A value target is extracted from its box and dup'd: the copy is released too.
  payload_before := g_dyn_payload_disposed;
  {
    (d : Box(Dyn(TestDyn))) = dyn(Box.new(DynStructPayload(r : _dpr(i32(9)))));
    assert(downcast(&d.*, DynStructPayload).is_some(), "the boxed struct");
  };
  assert((g_dyn_payload_disposed - payload_before) == i32(1), "the boxed struct's payload is released");
});
test("Dyn: upcast of an AnyError to its ToString supertrait", {
  (e : AnyError) = dyn(Box.new(_UpErr.Bad));
  (ts : Box(Dyn(ToString))) = upcast(e, Dyn(ToString));
  assert(ts.to_string() == String.from("bad"), "the supertrait's slot");
});
_UpErr :: enum(Bad);
derive(_UpErr, Copy, Clone);
impl(_UpErr, ToString(to_string : (self -> String.from("bad"))));
impl(_UpErr, Error());
test("Dyn: an upcast cannot add a trait, and dyn() of a Dyn is rejected", {
  (one : Box(Dyn(_OsSp))) = dyn(Box.new(_OsCat(n : i32(3))));
  comptime_expect_error(upcast(one, Dyn(_OsSp, _OsOt)), "upcast cannot add a trait");
  comptime_expect_error({
    (again : Box(Dyn(_OsSp))) = dyn(one);
  }, "already a Dyn");
  assert(one.speak() == i32(3), "the value itself is fine");
});
// issues/fixed/two-traits-sharing-a-method-name-in-one-dyn-emit-a-duplicate-c-wrapper.md
_ClA :: trait(get : (fn(self : &Self) -> i32));
_ClB :: trait(get : (fn(self : &Self) -> i32));
test("Dyn: two traits with a same-named method cannot share one Dyn (E0616)", {
  comptime_expect_error(Box(Dyn(_ClA, _ClB)), "cannot hold two methods named");
  assert(true, "rejected");
});
// issues/fixed/arraylist-of-a-trait-object-cannot-be-indexed.md: this module
// imports `std/libc/stdio`, whose `Option(*(FILE))` instance the CTFE memo used
// to hand `ArrayList(Dyn(T))._ptr`, so reading an element back did not compile.
{ ToString : _AlToString } :: import("std/fmt/to_string");
test("Test an ArrayList of trait objects reads its elements back", {
  (mut(xs) : ArrayList(Box(Dyn(_AlToString)))) = ArrayList(Box(Dyn(_AlToString))).new();
  xs.push(dyn(Box.new(i32(7)), _AlToString));
  xs.push(dyn(Box.new(i32(9)), _AlToString));
  got := xs(usize(1)).to_string();
  assert(got == String.from("9"), "index 1 reads back the second trait object");
  assert(xs.len() == usize(2), "both elements are held");
});
// issues/fixed/dyn-trait-order-is-part-of-its-c-type.md: a Dyn's trait list
// is a set, so `Dyn(A, B)` flows into a `Dyn(B, A)` parameter and both
// spellings are one C type with one vtable layout.
_OrdA :: trait(a : (fn(self : &Self) -> i32));
_OrdB :: trait(b : (fn(self : &Self) -> i32));
_OrdC :: struct(n : i32);
impl(_OrdC, _OrdA(a : (self -> self.n)));
impl(_OrdC, _OrdB(b : (self -> (self.n + i32(100)))));
_ord_take :: (fn(d : &Dyn(_OrdB, _OrdA)) -> i32)(d.a() + (d.b() * i32(1000)));
test("Dyn: the trait order is not part of the type", {
  (x : Box(Dyn(_OrdA, _OrdB))) = dyn(Box.new(_OrdC(n : i32(1))));
  assert(_ord_take(&x) == i32(101001), "both slots dispatch to their own impl");
  assert(Type.eq(Box(Dyn(_OrdA, _OrdB)), Box(Dyn(_OrdB, _OrdA))), "one type");
});
// issues/fixed/a-method-call-two-trait-impls-supply-silently-picks-one.md:
// an unqualified call two trait impls both supply is E0616; the qualified
// form names the trait.
_ClC :: struct(n : i32);
impl(_ClC, _ClA(get : (self -> i32(1))));
impl(_ClC, _ClB(get : (self -> i32(2))));
test("an unqualified call two trait impls supply is ambiguous (E0616)", {
  c := _ClC(n : i32(0));
  comptime_expect_error(c.get(), "is ambiguous");
  assert((_ClC <: _ClA).get(&c) == i32(1), "qualified: A");
  assert((_ClC <: _ClB).get(&c) == i32(2), "qualified: B");
});
// issues/fixed/dyn-fn-inout-param-pointer-level-mismatch.md: an `inout`
// parameter of a Dyn vtable slot is `T*` in the slot, the wrapper and every
// call site, as it is for a plain fn or an `Impl(Fn)` (the slot and wrapper
// spelled it `T`, the closure and the call site `T*`: a clang error).
_DioHolder :: struct(cb : Box(Dyn(Fn(n : &mut i32) -> unit)));
_DioPusher :: struct(push : Box(Dyn(Fn(xs : &mut ArrayList(i32)) -> unit)));
_dio_bump_twice :: (fn(y : &mut i32, h : &_DioHolder) -> unit)({
  h.cb(y);
  h.cb(y);
});
_dio_push_through :: (fn(xs : &mut ArrayList(i32), p : &_DioPusher) -> unit)({
  p.push(xs);
});
_dio_call_param :: (fn(y : &mut i32, cb : &Dyn(Fn(n : &mut i32) -> unit)) -> unit)({
  cb(y);
});
test("Dyn(Fn) with an inout parameter writes through to the caller's place", {
  h := _DioHolder(
    cb : dyn((n : &mut i32) => {
      n.* = (n.* + i32(1));
    })
  );
  (mut(x) : i32) = i32(41);
  h.cb(&mut x);
  assert(x == i32(42), "a local i32 is incremented in place");
  _dio_bump_twice(&mut x, &h);
  assert(x == i32(44), "an inout parameter is forwarded, not re-addressed");
  _dio_call_param(&mut x, &h.cb);
  assert(x == i32(45), "a Dyn(Fn) parameter called with an inout parameter");
  p := _DioPusher(
    push : dyn((xs : &mut ArrayList(i32)) => {
      xs.push(i32(7));
    })
  );
  (mut(ys) : ArrayList(i32)) = ArrayList(i32).new();
  p.push(&mut ys);
  _dio_push_through(&mut ys, &p);
  assert(ys.len() == usize(2), "a local ArrayList is pushed through the callback, directly and forwarded");
  assert(match(ys.get(usize(1)), .Some(v) => (v == i32(7)), .None => false), "the pushed element reads back");
});
_DioBump :: trait(bump : (fn(self : &Self, n : &mut i32) -> unit));
_DioStep :: struct(k : i32);
impl(
  _DioStep,
  _DioBump(
    bump : (fn(self : &Self, n : &mut i32) -> unit)({
      n.* = (n.* + self.k);
    })
  )
);
_dio_trait_bump :: (fn(y : &mut i32, d : &Dyn(_DioBump)) -> unit)({
  d.bump(y);
});
test("Dyn(trait) method with an inout parameter writes through to the caller's place", {
  (d : Box(Dyn(_DioBump))) = dyn(Box.new(_DioStep(k : i32(2))));
  (mut(x) : i32) = i32(40);
  d.bump(&mut x);
  assert(x == i32(42), "a local i32 is updated in place");
  _dio_trait_bump(&mut x, &d);
  assert(x == i32(44), "an inout parameter is forwarded, not re-addressed");
});

// A `fn(...)` value behind a `Dyn(Fn(...))` is called through the Dyn's
// signature, so `dyn(f)` checks f's against it, modes included
// (issues/fixed/a-function-argument-is-not-checked-against-a-function-typed-parameter.md).
// A `fn(...)` value whose signature IS the Dyn's is boxed as its code pointer
// and called through it: the runtime canaries follow the check below
// (issues/fixed/dyn-of-a-named-function-value-emits-invalid-c.md).
_dfs_by_value :: (fn(s : String) -> usize)(s.len());
_dfs_call :: (fn(f : &Dyn(Fn(s : &String) -> usize), s : &String) -> usize)(f(s));
test("dyn of a function value checks its signature against the Dyn's `Fn`", {
  s := String.from("four");
  comptime_expect_error({
    (h : Box(Dyn(Fn(s : &String) -> usize))) = dyn(Box.new(_dfs_by_value));
  }, "a parameter's mode is part of the function type");
  comptime_expect_error({
    (h : Box(Dyn(Fn(x : i32) -> i32))) = dyn(Box.new(_dfs_by_value));
  }, "Incompatible types");
  (by_value : Box(Dyn(Fn(t : String) -> usize))) = dyn(Box.new(t => t.len()));
  comptime_expect_error(_dfs_call(&by_value, &s), "a parameter's mode is part of the function type");
  (c : Box(Dyn(Fn(t : &String) -> usize))) = dyn(Box.new(t => t.len()));
  assert(_dfs_call(&c, &s) == usize(4), "a closure literal adopts the Dyn's modes");
  assert(s.len() == usize(4), "s was only ever lent");
});
// `dyn(f)` of a named function boxes its code pointer: the Dyn's `call` slot
// casts the pointer back to the function's own prototype and calls it. Every
// shape that names a function value: a top-level `fn` (two of one signature,
// which share one box type and vtable, so the slot must call the pointer the
// box holds, not a fixed function), a `&mut` parameter, `FnOnce`, a function
// from another module, and an `Impl(Fn(...))` parameter bound to a named `fn`
// and boxed in the callee. Before the fix every one passed `check` and failed
// in the C compiler on `__yo_dyn_box_unknown_fn(...)`
// (issues/fixed/dyn-of-a-named-function-value-emits-invalid-c.md). A generic
// type's function taken as a value is not emitted with or without `dyn`
// (issues/a-generic-types-function-taken-as-a-value-is-not-emitted.md).
_dnf_len :: (fn(s : &String) -> usize)(s.len());
_dnf_twice_len :: (fn(s : &String) -> usize)(s.len() * usize(2));
_dnf_bump :: (fn(x : &mut i32) -> unit)({
  x.* = (x.* + i32(1));
});
_dnf_nine :: (fn() -> i32)(i32(9));
_dnf_double :: (fn(x : i32) -> i32)(x * i32(2));
_dnf_box :: (fn(f : Impl(Fn(x : i32) -> i32)) -> Box(Dyn(Fn(x : i32) -> i32)))(dyn(Box.new(f)));
_dnf_call :: (fn(f : &Dyn(Fn(s : &String) -> usize), s : &String) -> usize)(f(s));
test("dyn of a named function calls the function", {
  s := String.from("four");
  (a : Box(Dyn(Fn(s : &String) -> usize))) = dyn(Box.new(_dnf_len));
  (b : Box(Dyn(Fn(s : &String) -> usize))) = dyn(Box.new(_dnf_twice_len));
  assert(a(&s) == usize(4), "the first named fn");
  assert(b(&s) == usize(8), "a second fn of the same signature calls its own code");
  assert(_dnf_call(&a, &s) == usize(4), "a Dyn of a named fn passed by reference");
  (c : Box(Dyn(Fn(x : &mut i32) -> unit))) = dyn(Box.new(_dnf_bump));
  (mut(x) : i32) = i32(40);
  c(&mut x);
  c(&mut x);
  assert(x == i32(42), "a &mut parameter writes through to the caller's place");
  (o : Box(Dyn(FnOnce() -> i32))) = dyn(Box.new(_dnf_nine));
  assert(o() == i32(9), "a Dyn(FnOnce) of a named fn");
  (mut(fs) : ArrayList(Box(Dyn(Fn() -> i32)))) = ArrayList(Box(Dyn(Fn() -> i32))).new();
  fs.push(dyn(Box.new(_dnf_nine)));
  fs.push(dyn(Box.new(() => i32(1))));
  assert((fs(usize(0))() + fs(usize(1))()) == i32(10), "a named fn and a closure share one Dyn type");
});
// A `unit` result lowers to C `void`: a `Dyn(FnOnce(...) -> unit)` call slot
// calls the payload without keeping its result, for a named fn's code pointer
// and for a closure's capture struct alike. Before the fix both declared a
// `void __yo_once_r` temp and failed in the C compiler
// (issues/fixed/a-unit-returning-dyn-fnonce-call-slot-declares-a-void-temp.md).
_dnf_noop :: (fn() -> unit)(());
test("a unit-returning Dyn(FnOnce) of a named fn and of a closure", {
  (n : Box(Dyn(FnOnce() -> unit))) = dyn(Box.new(_dnf_noop));
  n();
  (mut(x) : i32) = i32(1);
  (b : Box(Dyn(FnOnce(x : &mut i32) -> unit))) = dyn(Box.new(_dnf_bump));
  b(&mut x);
  assert(x == i32(2), "a unit-returning named fn called once through a Dyn");
  (c : Box(Dyn(FnOnce(x : &mut i32) -> unit))) = dyn(x => {
    x.* = (x.* + i32(10));
  });
  c(&mut x);
  assert(x == i32(12), "a unit-returning closure called once through a Dyn");
  (d : Box(Dyn(FnOnce() -> unit))) = dyn(Box.new(() => _dnf_noop()));
  d();
});
test("dyn of another module's function and of an Impl(Fn) parameter", {
  (pj : Box(Dyn(Fn(base : &String, name : &String) -> String))) = dyn(Box.new(path_join));
  base := String.from("a");
  name := String.from("b");
  assert(pj(&base, &name) == path_join(&base, &name), "a function imported from another module");
  d := _dnf_box(_dnf_double);
  assert(d(i32(21)) == i32(42), "an Impl(Fn) parameter bound to a named fn, boxed in the callee");
});
// The unique `Dyn` (plans/VALUES_BY_DEFAULT.md decision 7, B12 and B13):
// `Clone` in a Dyn's trait list fills the vtable prefix's `__yo_clone` slot,
// so `d.clone()` copies the payload into a new box, and a copy whose source
// is used again is E0901 (std and src included since B13).
_UdCounter :: trait(
  bump : (fn(self : &mut Self) -> unit),
  count : (fn(self : &Self) -> i32)
);
_UdTally :: struct(n : i32, label : String);
derive(_UdTally, Clone);
impl(
  _UdTally,
  _UdCounter(
    bump : (fn(self : &mut Self) -> unit)({
      self.n = (self.n + i32(1));
    }),
    count : (fn(self : &Self) -> i32)(self.n + i32(self.label.len()))
  )
);
_ud_tally :: (fn(n : i32) -> Box(Dyn(_UdCounter, Clone)))(dyn(Box.new(_UdTally(n : n, label : String.from("t")))));
test("d.clone() on a Dyn with Clone copies the payload", {
  (d : Box(Dyn(_UdCounter, Clone))) = _ud_tally(i32(1));
  (mut(e) : Box(Dyn(_UdCounter, Clone))) = d.clone();
  e.bump();
  e.bump();
  assert(d.count() == i32(2), "the source keeps its own payload");
  assert(e.count() == i32(4), "the clone is written on its own");
  (o : Option(Box(Dyn(_UdCounter, Clone)))) = Option(Box(Dyn(_UdCounter, Clone))).Some(d.clone());
  (p : Option(Box(Dyn(_UdCounter, Clone)))) = o.clone();
  assert(match(p, .Some(x) => (x.count() == i32(2)), .None => false), "an Option of a Dyn with Clone clones it");
  assert(match(o, .Some(x) => (x.count() == i32(2)), .None => false), "the original Option keeps its Dyn");
});
test("the last use of a Dyn moves it", {
  (d : Box(Dyn(_UdCounter))) = dyn(Box.new(_UdTally(n : i32(5), label : String.from(""))));
  e := d;
  assert(e.count() == i32(5), "a copy at the source's last use is a move");
  (mut(f) : Box(Dyn(_UdCounter))) = dyn(Box.new(_UdTally(n : i32(6), label : String.from(""))));
  (mut(g) : Box(Dyn(_UdCounter))) = dyn(Box.new(_UdTally(n : i32(0), label : String.from(""))));
  g = f;
  f = dyn(Box.new(_UdTally(n : i32(7), label : String.from(""))));
  assert((f.count() + g.count()) == i32(13), "a source assigned again after the copy holds a new value");
});
// The scan follows each path through the copy: a `break` leaves the loop
// without running the copy again, a write ends only the path it is on, and a
// `continue` reaches the next iteration.
test("a Dyn copy on a path that breaks out of its loop is its last use", {
  d := _ud_tally(i32(1));
  mut(xs) := ArrayList(Box(Dyn(_UdCounter, Clone))).new();
  while(true, {
    xs.push(d);
    break;
  });
  (mut(i) : i32) = i32(0);
  e := _ud_tally(i32(1));
  while(i < i32(5), {
    if(i == i32(3), {
      xs.push(e);
      break;
    });
    i = ((i + e.count()) - i32(1));
  });
  (mut(f) : Box(Dyn(_UdCounter, Clone))) = _ud_tally(i32(0));
  (mut(j) : i32) = i32(0);
  while(j < i32(2), {
    f = _ud_tally(j);
    xs.push(f);
    j = (j + i32(1));
  });
  assert(xs.len() == usize(4), "each copy was the last use of its source on its path");
});
test("a Dyn copy reached again on another path is E0901", {
  comptime_expect_error({
    (mut(d) : Box(Dyn(_UdCounter, Clone))) = _ud_tally(i32(1));
    c := runtime(true);
    mut(xs) := ArrayList(Box(Dyn(_UdCounter, Clone))).new();
    xs.push(d);
    if(c, {
      d = _ud_tally(i32(2));
    });
    d.count()
  }, "use of moved value");
  comptime_expect_error({
    (mut(d) : Box(Dyn(_UdCounter, Clone))) = _ud_tally(i32(1));
    c := runtime(true);
    mut(xs) := ArrayList(Box(Dyn(_UdCounter, Clone))).new();
    while(c, {
      xs.push(d);
      if(c, {
        break;
      });
      d = _ud_tally(i32(2));
    });
    d.count()
  }, "use of moved value");
  comptime_expect_error({
    (mut(d) : Box(Dyn(_UdCounter, Clone))) = _ud_tally(i32(1));
    c := runtime(true);
    mut(xs) := ArrayList(Box(Dyn(_UdCounter, Clone))).new();
    while(c, {
      xs.push(d);
      if(c, {
        d = _ud_tally(i32(2));
      });
    });
  }, "the loop runs this copy again");
  comptime_expect_error({
    (mut(d) : Box(Dyn(_UdCounter, Clone))) = _ud_tally(i32(1));
    c := runtime(true);
    mut(xs) := ArrayList(Box(Dyn(_UdCounter, Clone))).new();
    while(c, {
      xs.push(d);
      if(c, {
        continue;
      });
      d = _ud_tally(i32(2));
    });
  }, "the loop runs this copy again");
  assert(true, "rejected");
});
test("a by-value match moves a local holding a Dyn", {
  comptime_expect_error({
    o := Option(Box(Dyn(_UdCounter, Clone))).Some(_ud_tally(i32(1)));
    x := match(o, .Some(d) => d.count(), .None => i32(0));
    y := match(o, .Some(d) => d.count(), .None => i32(0));
    x + y
  }, "a `match` takes its scrutinee by value");
  o := Option(Box(Dyn(_UdCounter, Clone))).Some(_ud_tally(i32(1)));
  x := match(&o, .Some(d) => d.count(), .None => i32(0));
  y := match(o, .Some(d) => d.count(), .None => i32(0));
  assert((x + y) == i32(4), "a borrowing match leaves the local to a later by-value one");
});
_UdHolder :: struct(d : Box(Dyn(_UdCounter, Clone)));
(g_ud_held : Box(Dyn(_UdCounter, Clone))) = _ud_tally(i32(0));
test("a Dyn copy whose source is used again is E0901", {
  comptime_expect_error({
    (d : Box(Dyn(_UdCounter))) = dyn(Box.new(_UdTally(n : i32(1), label : String.from(""))));
    e := d;
    d.count() + e.count()
  }, "use of moved value");
  comptime_expect_error({
    d := _ud_tally(i32(1));
    (o : Option(Box(Dyn(_UdCounter, Clone)))) = Option(Box(Dyn(_UdCounter, Clone))).Some(d);
    d.count()
  }, "use of moved value");
  comptime_expect_error({
    d := _ud_tally(i32(1));
    (mut(i) : usize) = usize(0);
    mut(xs) := ArrayList(Box(Dyn(_UdCounter, Clone))).new();
    while(i < usize(2), {
      xs.push(d);
      i = (i + usize(1));
    });
  }, "the loop runs this copy again");
  comptime_expect_error({
    d := _ud_tally(i32(1));
    (f : Impl(Fn() -> i32)) = (() => d.count());
    f() + d.count()
  }, "use of moved value");
  assert(true, "rejected");
});
test("a Dyn copy out of storage that cannot give it away is E0901 at once", {
  comptime_expect_error((fn(d : &Dyn(_UdCounter, Clone)) -> Box(Dyn(_UdCounter, Clone)))(d.*), "it is a `&T` parameter");
  comptime_expect_error({
    h := _UdHolder(d : _ud_tally(i32(1)));
    e := h.d;
    e.count()
  }, "it is a field of another value");
  comptime_expect_error({
    e := g_ud_held;
    e.count()
  }, "it is a module-level binding");
  comptime_expect_error({
    (d : Box(Dyn(_UdCounter))) = dyn(Box.new(_UdTally(n : i32(1), label : String.from(""))));
    e := d;
    d.count() + e.count()
  }, "list `Clone` in the `Dyn`");
  comptime_expect_error({
    d := _ud_tally(i32(1));
    e := d;
    d.count() + e.count()
  }, "write `d.clone()` for an independent copy");
  assert(true, "rejected");
});
_ud_count :: (fn(f : &Impl(Fn() -> i32)) -> i32)(f());
test("a closure that borrows its captures copies no Dyn", {
  d := _ud_tally(i32(2));
  assert(_ud_count(() => d.count()) == i32(3), "a closure passed to a &Impl(Fn) borrows d");
  assert(d.count() == i32(3), "d is still the caller's");
  h := _UdHolder(d : d.clone());
  assert((h.d.count() + _ud_borrowed(&h.d)) == i32(6), "a field is lent with &");
});
_ud_borrowed :: (fn(d : &Dyn(_UdCounter, Clone)) -> i32)(d.count());
_UdCloneLike :: trait(clone : (fn(self : &Self) -> i32));
test("Clone's slot clashes with a trait method named clone", {
  comptime_expect_error(Box(Dyn(_UdCloneLike, Clone)), "two methods named");
  assert(true, "rejected");
});
test("a Dyn(Fn(...), Clone) clones its closure", {
  s := String.from("abc");
  (f : Box(Dyn(Fn(x : i32) -> i32, Clone))) = dyn(Box.new((x : i32) => (x + i32(s.len()))));
  g := f.clone();
  assert((f(i32(1)) + g(i32(2))) == i32(9), "the clone calls its own copy of the closure");
  n := i32(3);
  (h : Box(Dyn(Fn(x : i32) -> i32, Clone))) = dyn(Box.new((x : i32) => (x + n)));
  k := h.clone();
  assert((h(i32(1)) + k(i32(2))) == i32(9), "a closure of Copy captures clones by copy");
  // `s` moved into `f`'s closure (a `String` is a value since B8).
  t := String.from("abc");
  (b : Impl(Fn(x : i32) -> i32)) = ((x : i32) => (x + i32(t.len())));
  (e : Box(Dyn(Fn(x : i32) -> i32, Clone))) = dyn(Box.new(b));
  e2 := e.clone();
  assert((e(i32(1)) + e2(i32(2))) == i32(9), "a typed closure binding clones too");
});
// A Dyn listing two traits that declare the same non-function member (the
// marker traits' `id`) gives its vtable one member of that name
// (issues/fixed/2026-10-24-a-dyn-listing-two-marker-traits-emits-a-duplicate-vtable-member.md).
test("a Dyn listing Send and Sync compiles one member per name", {
  (k : Impl(Fn() -> i32)) = (() => i32(4));
  (d : Box(Dyn(Fn() -> i32, Send, Sync))) = dyn(Box.new(k));
  (a : Arc(Dyn(Fn() -> i32, Send, Sync))) = Arc(Dyn(Fn() -> i32, Send, Sync)).new(dyn(Box.new(() => i32(5))));
  b := Arc.clone(a);
  assert((d() + (a.*() + b.*())) == i32(14), "a Send and Sync Dyn calls through its vtable, and through an Arc");
});
// Two `Dyn(Fn(...))` types that differ only in a parameter's mode are two
// types with two vtables: the slot mode is part of the `Fn` type's key
// (issues/fixed/2026-10-27-dyn-fn-types-differing-only-in-a-parameter-mode-share-one-vtable.md).
test("Dyn(Fn(...)) types differing only in a parameter mode get their own vtables", {
  (a : Box(Dyn(Fn(x : &mut i32) -> unit))) = dyn((x : &mut i32) => {
    x.* = (x.* + i32(1));
  });
  (b : Box(Dyn(Fn(x : i32) -> i32))) = dyn(Box.new((x : i32) => (x + i32(10))));
  (c : Box(Dyn(Fn(x : &i32) -> i32))) = dyn(Box.new((x : &i32) => (x.* + i32(100))));
  (mut(v) : i32) = i32(1);
  a(&mut v);
  assert(v == i32(2), "the &mut slot writes through to the caller");
  assert(b(v) == i32(12), "the by-value slot takes a copy");
  assert(c(&v) == i32(102), "the & slot reads through the borrow");
});
_DmA :: struct(n : i32);
impl(
  _DmA,
  apply : (fn(self : &Self, f : Box(Dyn(Fn(x : &mut i32) -> unit))) -> i32)({
    (mut(v) : i32) = self.n;
    f(&mut v);
    v
  })
);
_DmB :: struct(n : i32);
impl(
  _DmB,
  apply : (fn(self : &Self, f : Box(Dyn(Fn(x : i32) -> unit))) -> i32)({
    f(self.n);
    self.n
  })
);
// One closure literal minted at two instantiations whose expected `Fn` slots
// differ only in a mode: each mint is boxed with its own closure function.
// `x` is a reference in one mint and a value in the other, so the body reads
// it through a receiver (`x.clone()`), the one spelling both accept: a
// whole-value read is `x.*` in the first and `x` in the second (decision 43
// step 2 N1e-1).
_dm_run :: (fn(generic(T : Type), t : T, k : i32) -> i32)(
  t.apply(
    dyn(x => {
      _y := (x.clone() + k);
    })
  )
);
test("one closure literal boxed at a &mut slot and at a by-value slot", {
  assert(_dm_run(_DmA(n : i32(1)), i32(5)) == i32(1), "the &mut mint");
  assert(_dm_run(_DmB(n : i32(2)), i32(5)) == i32(2), "the by-value mint");
});
// The owning downcast of a `Box(Dyn)` hands back the same block as a `Box(V)`
// (decision 49 S2): nothing is cloned, and the payload is dropped once. A
// mismatch hands the box back as `.Err`, dropped once too. (Before the flip a
// downcast copied a move-only payload with its `clone`:
// issues/fixed/2026-10-31-a-downcast-to-a-move-only-type-drops-the-payload-twice.md.)
(mut(g_dc_drops) : i32) = i32(0);
(mut(g_dc_clones) : i32) = i32(0);
_DcFd :: struct(n : i32);
impl(
  _DcFd,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_dc_drops = (g_dc_drops + i32(1));
    })
  )
);
impl(
  _DcFd,
  Clone(
    clone : (fn(self : &Self) -> Self)({
      g_dc_clones = (g_dc_clones + i32(1));
      _DcFd(n : self.n)
    })
  )
);
impl(_DcFd, ToString(to_string : (fn(self : &Self) -> String)(String.from("fd"))));
impl(_DcFd, Error());
test("an owning downcast moves the box, its payload dropped once", {
  {
    (err : AnyError) = dyn(Box.new(_DcFd(n : i32(3))));
    n := match(downcast(&err.*, _DcFd), .Ok(f) => f.n, .Err(_) => i32(0));
    assert(n == i32(3), "the downcast reads the payload");
    assert(g_dc_clones == i32(0), "nothing is cloned");
  };
  assert(g_dc_drops == i32(1), `the payload dropped once, got ${g_dc_drops.to_string()}`);
  {
    (other : AnyError) = dyn(Box.new(_UpErr.Bad));
    back := match(downcast(other, _DcFd), .Ok(_) => i32(-1), .Err(e) => if(downcast(&e.*, _UpErr).is_some(), i32(1), i32(0)));
    assert(back == i32(1), "a mismatch hands the box back");
  };
  assert(g_dc_drops == i32(1), "a mismatch drops no _DcFd");
});
test("a view downcast of a move-only payload needs no Clone", {
  (d : Box(Dyn(ToString))) = dyn(Box.new(_DcFd(n : i32(1))));
  assert(match(downcast(&d.*, _DcFd), .Some(f) => f.n, .None => i32(0)) == i32(1), "viewed in place");
  assert(g_dc_clones == i32(0), "nothing is cloned");
});

// The auto-box does not write the tree: it records `dyn(v)` as
// `dyn(Rc.new(v))` (`note_rewritten_node`, src/expr.yo), which a
// re-evaluation of the same node reads back instead of boxing again.
test("an auto-boxed dyn evaluated again in a loop", {
  (mut(total) : i32) = i32(0);
  (mut(i) : i32) = i32(0);
  while(i < i32(3), {
    total = (total + use_test_dyn(dyn(Box.new(i32(5)))));
    i = (i + i32(1));
  });
  assert(total == i32(15), "boxed on every iteration");
  assert(_generic_show(i32(6)) == `6`, "a generic body boxes per specialization");
});

// A type constructor's CTFE memo compares its arguments by identity, and
// `Fn` serving `FnOnce` is flow, not identity: `ArrayList(Dyn(Fn() -> i32))`
// after `ArrayList(Dyn(FnOnce() -> i32))` was the FnOnce instance, so a
// second call through it was E0901; `Box(...)` of the two the same
// (issues/fixed/2026-11-11-a-dyn-fn-and-a-dyn-fnonce-share-one-type-constructor-instance.md).
test("a Dyn(Fn) after a Dyn(FnOnce) is its own constructor instance", {
  comptime_assert(!Type.eq(ArrayList(Box(Dyn(FnOnce() -> i32))), ArrayList(Box(Dyn(Fn() -> i32)))), "two element types");
  comptime_assert(!Type.eq(Box(Dyn(FnMut() -> i32)), Box(Dyn(Fn() -> i32))), "two boxes");
  (o : Box(Dyn(FnOnce() -> i32))) = dyn(Box.new(_dnf_nine));
  (f : Box(Dyn(Fn() -> i32))) = dyn(Box.new(_dnf_nine));
  mut(fs) := ArrayList(Box(Dyn(Fn() -> i32))).new();
  fs.push(dyn(Box.new(() => i32(1))));
  assert((f() + f() + fs(usize(0))() + fs(usize(0))() + o()) == i32(29), "the Fn instances call twice");
});
// Decision 49's flip: `Clone` in a `Dyn`'s trait list fills the vtable's
// `clone_into` slot, never a callable method of the erased value (its `clone`
// returns `Self`, which the `Dyn` erases — an unsized value). So `b.clone()`
// over the owning box resolves to the box's own clone (an independent payload
// written by `CloneInto`), and the payload's `clone` is not reachable through
// the box at all.
test("Box(Dyn(T, Clone)).clone() is the box's clone", {
  (b : Box(Dyn(ToString, Clone))) = dyn(Box.new(_DcFd(n : i32(4))));
  d := b.clone();
  assert(match(downcast(&d.*, _DcFd), .Some(f) => f.n, .None => i32(0)) == i32(4), "an independent payload");
  assert(g_dc_clones == i32(1), "one clone, through the vtable's clone_into");
  assert(match(downcast(&b.*, _DcFd), .Some(f) => f.n, .None => i32(0)) == i32(4), "the source keeps its payload");
});
test("a Dyn's Clone is not a method of the erased value", {
  comptime_expect_error(
    (fn() -> unit)({
      (b : Box(Dyn(ToString, Clone))) = dyn(Box.new(_DcFd(n : i32(4))));
      _x := b.*.clone();
      ()
    }),
    "clone"
  );
});
