{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
{ get_thread_id } :: import("std/thread");
Worker :: import("std/worker");
{ yield } :: import("std/async");
test("Worker spawn simple task", {
  Worker.set_num_threads(2);
  Worker.spawn((io) => {
    // Simple task that runs on worker thread
    assert(true);
  });
});
test("Worker spawn multiple tasks", {
  Worker.set_num_threads(2);
  Worker.spawn((io) => {
    // Task 1
    assert(true);
  });
  Worker.spawn((io) => {
    // Task 2
    assert(true);
  });
  Worker.spawn((io) => {
    // Task 3
    assert(true);
  });
  Worker.spawn((io) => {
    // Task 4
    assert(true);
  });
});
test("Worker spawn with i32 capture", {
  Worker.set_num_threads(2);
  value := 42;
  Worker.spawn((io) => {
    // Capture an i32 value
    assert(value == 42);
  });
});
test("Worker spawn with multiple captures", {
  Worker.set_num_threads(2);
  x := 100;
  y := 200;
  Worker.spawn((io) => {
    // Capture multiple values
    assert((x + y) == 300);
  });
});
test("Worker get_num_threads returns configured value", {
  Worker.set_num_threads(4);
  n := Worker.get_num_threads();
  // Note: get_num_threads returns configured value or hardware threads if 0
  assert(n > 0);
});
test("Worker with async task", {
  Worker.set_num_threads(2);
  Worker.spawn((io) => {
    task := io.async((io : Io) => {
      io.await(yield(io), io);
    });
    io.await(task, io);
  });
});
test("Worker with async returning value", {
  Worker.set_num_threads(2);
  Worker.spawn((io) => {
    x := 10;
    y := 20;
    task := io.async((io : Io) => {
      io.await(yield(io), io);
      return(x + y);
    });
    result := io.await(task, io);
    assert(result == i32(30), "async result should be 30");
  });
});
test("Worker with async loop", {
  Worker.set_num_threads(2);
  Worker.spawn((io) => {
    task := io.async((io : Io) => {
      counter := 0;
      while(runtime(counter < i32(3)), {
        counter = (counter + 1);
        io.await(yield(io), io);
      });
      return(counter);
    });
    result := io.await(task, io);
    assert(result == i32(3), "counter should be 3");
  });
});
