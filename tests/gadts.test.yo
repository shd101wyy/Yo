{ assert } :: import("std/assert");
// =============================================================================
// GADT Definition Tests
// =============================================================================
// Basic GADT with type-refining constructors
Value :: (fn(comptime(T) : Type) -> comptime(Type))(
  enum(
    IntVal(i : i32) -> recur(i32),
    BoolVal(b : bool) -> recur(bool),
    PairVal(a : i32, b : bool) -> recur(i32)
  )
);
test("GADT basic construction", {
  v1 := Value(i32).IntVal(i32(42));
  v2 := Value(bool).BoolVal(true);
  v3 := Value(i32).PairVal(i32(1), false);
  // Verify they compile and can be used
  assert(true, "GADT construction works");
});
// =============================================================================
// GADT Match Type Refinement Tests
// =============================================================================
// eval function — T is refined per branch via GADT
eval_value :: (fn(generic(T : Type), v : Value(T)) -> T)(
  match(
    v,
    .IntVal(i) => i,
    .BoolVal(b) => b,
    .PairVal(a, b) => a
  )
);
test("GADT match type refinement - IntVal", {
  v := Value(i32).IntVal(i32(42));
  result := eval_value(v);
  assert(result == i32(42), "eval IntVal should return 42");
});
test("GADT match type refinement - BoolVal", {
  v := Value(bool).BoolVal(true);
  result := eval_value(v);
  assert(result, "eval BoolVal should return true");
});
test("GADT match type refinement - PairVal", {
  v := Value(i32).PairVal(i32(99), false);
  result := eval_value(v);
  assert(result == i32(99), "eval PairVal should return 99");
});
// =============================================================================
// GADT Exhaustiveness Tests
// =============================================================================
// When matching Value(i32), only IntVal and PairVal are reachable
// BoolVal is unreachable because BoolVal -> recur(bool) and bool != i32
eval_int_only :: (fn(v : Value(i32)) -> i32)(
  match(
    v,
    .IntVal(i) => i,
    .PairVal(a, b) => a
  )
);
test("GADT exhaustiveness - concrete type excludes unreachable variants", {
  v := Value(i32).IntVal(i32(77));
  result := eval_int_only(v);
  assert(result == i32(77), "eval_int_only should return 77");
});
// =============================================================================
// GADT with Multiple Type Parameters
// =============================================================================
// GADT with two type parameters
MyPair :: (fn(comptime(A) : Type, comptime(B) : Type) -> comptime(Type))(
  enum(
    MkIntBool(x : i32, y : bool) -> recur(i32, bool),
    MkBoolInt(x : bool, y : i32) -> recur(bool, i32)
  )
);
// Extract functions using GADT type refinement
my_fst :: (fn(generic(A : Type, B : Type), p : MyPair(A, B)) -> A)(
  match(
    p,
    .MkIntBool(x, y) => x,
    .MkBoolInt(x, y) => x
  )
);
my_snd :: (fn(generic(A : Type, B : Type), p : MyPair(A, B)) -> B)(
  match(
    p,
    .MkIntBool(x, y) => y,
    .MkBoolInt(x, y) => y
  )
);
test("GADT multiple type params - fst", {
  p := MyPair(i32, bool).MkIntBool(i32(10), true);
  result := my_fst(p);
  assert(result == i32(10), "fst should return 10");
});
test("GADT multiple type params - snd", {
  p := MyPair(i32, bool).MkIntBool(i32(10), true);
  result := my_snd(p);
  assert(result, "snd should return true");
});
// =============================================================================
// GADT with Discriminant Values
// =============================================================================
// GADT variants with explicit discriminant values (multiline syntax)
Tagged :: (fn(comptime(T) : Type) -> comptime(Type))(
  enum(
    (TagInt(i : i32) -> recur(i32)) = 10,
    (TagBool(b : bool) -> recur(bool)) = 20
  )
);
eval_tagged :: (fn(generic(T : Type), t : Tagged(T)) -> T)(
  match(
    t,
    .TagInt(i) => i,
    .TagBool(b) => b
  )
);
test("GADT with discriminant values", {
  t := Tagged(i32).TagInt(i32(55));
  result := eval_tagged(t);
  assert(result == i32(55), "eval_tagged should return 55");
});
// =============================================================================
// GADT mixed with non-GADT variants
// =============================================================================
// Some variants have GADT annotations, some don't
MixedVal :: (fn(comptime(T) : Type) -> comptime(Type))(
  enum(
    MInt(i : i32) -> recur(i32),
    MBool(b : bool) -> recur(bool),
    MGeneric(v : T)
  )
);
eval_mixed :: (fn(generic(T : Type), mv : MixedVal(T)) -> T)(
  match(
    mv,
    .MInt(i) => i,
    .MBool(b) => b,
    .MGeneric(g) => g
  )
);
test("GADT mixed variants - IntVal", {
  mv := MixedVal(i32).MInt(i32(33));
  result := eval_mixed(mv);
  assert(result == i32(33), "eval_mixed MInt should return 33");
});
test("GADT mixed variants - Generic", {
  mv := MixedVal(i32).MGeneric(i32(44));
  result := eval_mixed(mv);
  assert(result == i32(44), "eval_mixed MGeneric should return 44");
});
