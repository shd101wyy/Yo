// ===== Clone / Hash / Ord (audit path row) =====
test("Path.clone is a deep copy — mutating the copy leaves the original alone", {
  p := Path.new(`a/b`);
  q := p.clone();
  assert(p == q, "clone is equal");
  assert(p != Path.new(`a/c`), "different paths differ");
  q2 := q.join(Path.new(`c`));
  assert(q2.to_string() == `a/b/c`, "the clone is usable");
  assert(p.to_string() == `a/b`, "the original is untouched");
});
test("Path hashes consistently with Eq (usable as a HashMap key)", {
  { HashMap } :: import("std/collections/hash_map");
  { DefaultHasher } :: import("std/hash");
  p := Path.new(`/x/y`);
  q := Path.new(`/x/y`);
  r := Path.new(`/x/z`);
  h1 := DefaultHasher.new();
  p.hash(h1);
  v1 := h1.finish();
  h2 := DefaultHasher.new();
  q.hash(h2);
  v2 := h2.finish();
  h3 := DefaultHasher.new();
  r.hash(h3);
  v3 := h3.finish();
  assert(v1 == v2, "equal paths hash equal");
  assert(v1 != v3, "different paths hash differently (no collision here)");
  m := HashMap(Path, i32).new();
  _i := m.insert(p, i32(1));
  _i2 := m.insert(q, i32(2));
  got := m.get(r);
  assert(got.is_none(), "a different path misses");
  got_p := m.get(Path.new(`/x/y`));
  assert(got_p.unwrap_or(i32(-1)) == i32(2), "equal-path insert overwrites");
});
test("Path ordering follows the normalized rendering", {
  a := Path.new(`a/b`);
  b := Path.new(`a/c`);
  c := Path.new(`ab`);
  assert(a < b, "a/b < a/c");
  assert(!(b < a), "not backwards");
  assert(a <= a.clone(), "<= on equal paths");
  assert(b > a, "> works");
  assert(c > a, "'ab' > 'a/b' — byte order on the rendering");
});
// ===== quick-wins row: join(str), push, ancestors, PATH split/join =====
test("Path.join accepts str, String, and Path interchangeably", {
  p := Path.new(`a/b`);
  via_str := p.join("c");
  via_string := p.join(String.from("c"));
  via_path := p.join(Path.new(`c`));
  assert((via_str == via_string) && (via_string == via_path), "all three agree");
  assert(via_str.to_string() == `a/b/c`, "joined");
  assert(p.join("/abs").to_string() == `/abs`, "absolute other still replaces");
});
test("Path.push extends in place; absolute push replaces", {
  p := Path.new(`a/b`);
  p.push("c");
  assert(p.to_string() == `a/b/c`, "pushed");
  p.push("/root");
  assert(p.to_string() == `/root`, "absolute push replaced the contents");
});
test("Path.ancestors walks from self to the root", {
  p := Path.new(`a/b/c`);
  anc := p.ancestors();
  assert(anc.len() == usize(3), "three ancestors");
  assert(anc(usize(0)).to_string() == `a/b/c`, "starts at self");
  assert(anc(usize(1)).to_string() == `a/b`, "then parent");
  assert(anc(usize(2)).to_string() == `a`, "then grandparent");
  abs := Path.new(`/x/y`).ancestors();
  assert(abs.len() == usize(3), "absolute chain incl. root");
  assert(abs(usize(2)).to_string() == `/`, "ends at the root");
});
test("split_paths / join_paths round-trip a PATH-style string", {
  // Built with the PLATFORM delimiter — the input spelling differs between
  // Unix (`:`) and Windows (`;`), so construct it instead of writing a
  // literal.
  raw := String.new();
  _a := raw.push_string(`/usr/bin`);
  _b := raw.push_byte(u8(PATH_DELIMITER));
  _c := raw.push_string(`/bin`);
  _d := raw.push_byte(u8(PATH_DELIMITER));
  parts := split_paths(raw);
  assert(parts.len() == usize(2), "empty segment dropped");
  assert(parts(usize(0)) == Path.new(`/usr/bin`), "first (segment equality)");
  assert(parts(usize(1)) == Path.new(`/bin`), "second (segment equality)");
  expected := String.new();
  _e := expected.push_string(`/usr/bin`);
  _f := expected.push_byte(u8(PATH_DELIMITER));
  _g := expected.push_string(`/bin`);
  joined := join_paths(parts);
  assert(joined == expected, "round-tripped with the platform delimiter");
});
// ============================================
// `..` is recorded, not folded — new/join/push agree, normalize() folds
// (issues/fixed/path-drops-dotdot-and-destroys-unc-prefix.md)
// ============================================
test("Path.new keeps a leading .. on a relative path (measured defect)", {
  // Was `foo`: the leading `..` was silently dropped, so a path that escapes
  // its directory quietly became one that does not.
  p := Path.new(`../foo`);
  assert(p.to_string() == `../foo`, "leading .. survives new()");
  assert(p.is_relative(), "still relative");
  assert(p.normalize().to_string() == `../foo`, "nothing to pop, so it survives normalize()");
});
test("Path.join keeps .. coming from the ARGUMENT (measured defect)", {
  // Was `a/b/c`: `join` dropped the argument's `..` instead of recording it,
  // and disagreed with `new` while doing so.
  joined := Path.new(`a/b`).join(`../c`);
  assert(joined.to_string() == `a/b/../c`, "recorded as written");
  assert(joined == Path.new(`a/b/../c`), "join agrees with new");
  assert(joined.normalize().to_string() == `a/c`, "normalize() pops b");
});
test("Path.push keeps .. coming from the ARGUMENT (measured defect)", {
  // Was `a/b/c` — `push` is `join` in place and had the same defect.
  p := Path.new(`a/b`);
  p.push(`../c`);
  assert(p.to_string() == `a/b/../c`, "recorded as written");
  assert(p == Path.new(`a/b`).join(`../c`), "push agrees with join");
});
test("Path new/join/push agree on a path with no ..", {
  base := Path.new(`a/b`);
  pushed := Path.new(`a/b`);
  pushed.push(`c/d`);
  assert(base.join(`c/d`) == Path.new(`a/b/c/d`), "join agrees with new");
  assert(pushed == Path.new(`a/b/c/d`), "push agrees with new");
});
test("Path.normalize is documented as LEXICAL, so it is idempotent", {
  once := Path.new(`a/b/../../c/./d/..`).normalize();
  assert(once.to_string() == `c`, "folded");
  assert(once.normalize() == once, "already folded");
});
test("Path.new collapses repeated separators and a trailing slash", {
  assert(Path.new(`a//b`).to_string() == `a/b`, "repeated separator");
  assert(Path.new(`a///b////c`).to_string() == `a/b/c`, "many separators");
  assert(Path.new(`a/b/`).to_string() == `a/b`, "trailing slash");
  assert(Path.new(`/a/b//`).to_string() == `/a/b`, "absolute, trailing slashes");
  assert(Path.new(`//a/b`).to_string() == `/a/b`, "leading // is one root, not a UNC share");
});
test("Path.new handles . in every position", {
  assert(Path.new(`./a/b`).to_string() == `a/b`, "leading .");
  assert(Path.new(`a/./b`).to_string() == `a/b`, "interior .");
  assert(Path.new(`a/b/.`).to_string() == `a/b`, "trailing .");
  assert(Path.new(`.`).to_string() == `.`, "bare . is the current directory");
  assert(Path.new(`./.`).to_string() == `.`, "and stays it");
  assert(Path.new(`..`).to_string() == `..`, ".. is NOT the same as .");
});
// ============================================
// Windows roots: UNC share and drive letter
// ============================================
test("Path.new preserves a UNC prefix as a unit (measured defect)", {
  // Was `/server/share/dir`: the `\\server\share` prefix was destroyed,
  // turning a network share into a LOCAL absolute path.
  unc := Path.new(`\\\\server\\share\\dir\\file.txt`);
  assert(unc.to_string() == `\\\\server\\share\\dir\\file.txt`, "round-trips in the Windows spelling");
  assert(unc.is_absolute(), "a share is an absolute location");
  assert(unc != Path.new(`/server/share/dir/file.txt`), "NOT the local path of the same name");
});
test("Path UNC root is a root, not a segment", {
  root := Path.new(`\\\\server\\share`);
  assert(root.to_string() == `\\\\server\\share`, "renders as the bare share");
  assert(root.file_name().is_none(), "a share is not a file name");
  assert(root.parent().is_none(), "and has no parent");
  deeper := Path.new(`\\\\server\\share\\dir`);
  assert(deeper.parent().unwrap() == root, "the share IS the parent of its top level");
  assert(deeper.file_name().unwrap() == `dir`, "file_name skips the root");
  named := root.with_file_name(`other`);
  assert(named.to_string() == `\\\\server\\share\\other`, "with_file_name cannot rewrite the root");
});
test("Path UNC survives join, push, components and normalize", {
  root := Path.new(`\\\\server\\share`);
  assert(root.join(`a/b`).to_string() == `\\\\server\\share\\a\\b`, "join keeps the share");
  p := Path.new(`\\\\server\\share\\a`);
  p.push(`../b`);
  assert(p.normalize().to_string() == `\\\\server\\share\\b`, "push + normalize keep the share");
  assert(Path.new(`\\\\server\\share\\..\\..\\x`).normalize().to_string() == `\\\\server\\share\\x`, ".. never climbs out of a share");
  comps := Path.new(`\\\\server\\share\\dir`).components();
  assert(comps.len() == usize(2), "the share is ONE component");
  assert(comps(usize(0)) == `\\\\server\\share`, "root component");
  assert(comps(usize(1)) == `dir`, "then the segments");
});
test("Path drive letter is a root too", {
  drive := Path.new(`C:\\dir\\f.txt`);
  assert(drive.to_string() == `C:/dir/f.txt`, "rendered with the module's / separator");
  assert(drive.is_absolute(), "a drive-rooted path is absolute");
  assert(drive.file_name().unwrap() == `f.txt`, "file_name skips the root");
  assert(Path.new(`C:/../x`).normalize().to_string() == `C:/x`, ".. never eats the drive");
  assert(Path.new(`C:`).parent().is_none(), "a bare drive has no parent");
  assert(Path.new(`C:/a`) != Path.new(`D:/a`), "different drives are different paths");
});
