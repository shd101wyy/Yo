});
test("Path.components of relative path", {
  p := Path.new(`foo/bar/baz`);
  comps := p.components();
  assert(comps.len() == usize(3));
  c0_opt := comps.get(usize(0));
  match(
    c0_opt,
    .Some(c0) => {
      assert(c0 == `foo`);
    },
    .None => {
      assert(false);
    }
  );
  c1_opt := comps.get(usize(1));
  match(
    c1_opt,
    .Some(c1) => {
      assert(c1 == `bar`);
    },
    .None => {
      assert(false);
    }
  );
  c2_opt := comps.get(usize(2));
  match(
    c2_opt,
    .Some(c2) => {
      assert(c2 == `baz`);
    },
    .None => {
      assert(false);
    }
  );
});
