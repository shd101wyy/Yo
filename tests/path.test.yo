{ assert } :: import("std/assert");
open(import("std/path"));
open(import("std/string"));
test("Path.new creates path from string", {
  path := Path.new(`src/main.yo`);
  s := path.to_string();
  assert(s == `src/main.yo`);
});
test("Path.new handles absolute paths", {
  path := Path.new(`/usr/local/bin`);
  assert(path.is_absolute());
  assert(!(path.is_relative()));
  s := path.to_string();
  assert(s == `/usr/local/bin`);
});
test("Path.new handles relative paths", {
  path := Path.new(`./src/main.yo`);
  assert(path.is_relative());
  assert(!(path.is_absolute()));
});
test("Path.new normalizes . in paths", {
  path := Path.new(`/usr/./local/./bin`);
  s := path.to_string();
  assert(s == `/usr/local/bin`);
});
test("Path.new normalizes .. in paths", {
  path := Path.new(`/usr/local/../bin`);
  s := path.to_string();
  assert(s == `/usr/bin`);
});
test("Path.new handles complex normalization", {
  path := Path.new(`/usr/local/../bin/./test`);
  s := path.to_string();
  assert(s == `/usr/bin/test`);
});
test("Path.new handles empty path", {
  // An empty relative path RENDERS as "." (the current directory) — Node's
  // path.normalize("") === "."; stat("") is ENOENT. The representation stays
  // empty-segments, so parent()/file_name() still return None (below).
  path := Path.new(``);
  s := path.to_string();
  assert(s == `.`);
});
test("Path.new strips trailing slashes", {
  path := Path.new(`/usr/local/bin/`);
  s := path.to_string();
  assert(s == `/usr/local/bin`);
});
test("Path.join concatenates two relative paths", {
  base := Path.new(`home/user`);
  other := Path.new(`documents/work`);
  joined := base.join(other);
  s := joined.to_string();
  assert(s == `home/user/documents/work`);
});
test("Path.join with absolute base path", {
  base := Path.new(`/home/user`);
  other := Path.new(`documents/work`);
  joined := base.join(other);
  s := joined.to_string();
  assert(s == `/home/user/documents/work`);
});
test("Path.join with absolute other path returns other", {
  base := Path.new(`/home/user`);
  other := Path.new(`/usr/local`);
  joined := base.join(other);
  s := joined.to_string();
  assert(s == `/usr/local`);
});
test("Path.parent returns parent directory", {
  path := Path.new(`/usr/local/bin`);
  parent_opt := path.parent();
  match(
    parent_opt,
    .Some(parent) => {
      s := parent.to_string();
      assert(s == `/usr/local`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.parent of root returns Some with empty segments", {
  path := Path.new(`/usr`);
  parent_opt := path.parent();
  match(
    parent_opt,
    .Some(parent) => {
      assert(parent.is_absolute());
      s := parent.to_string();
      assert(s == `/`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.parent of empty path returns None", {
  path := Path.new(``);
  parent_opt := path.parent();
  match(
    parent_opt,
    .Some(_) => {
      assert(false);
    },
    .None => {
      assert(true);
    }
  );
});
test("Path.file_name returns last segment", {
  path := Path.new(`/home/user/document.txt`);
  name_opt := path.file_name();
  match(
    name_opt,
    .Some(name) => {
      assert(name == `document.txt`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.file_name on directory path", {
  path := Path.new(`/usr/local/bin`);
  name_opt := path.file_name();
  match(
    name_opt,
    .Some(name) => {
      assert(name == `bin`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.file_name of empty path returns None", {
  path := Path.new(``);
  name_opt := path.file_name();
  match(
    name_opt,
    .Some(_) => {
      assert(false);
    },
    .None => {
      assert(true);
    }
  );
});
test("Path.file_stem extracts file name without extension", {
  path := Path.new(`main.yo`);
  stem_opt := path.file_stem();
  match(
    stem_opt,
    .Some(stem) => {
      assert(stem == `main`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.file_stem with multiple dots", {
  path := Path.new(`archive.tar.gz`);
  stem_opt := path.file_stem();
  match(
    stem_opt,
    .Some(stem) => {
      assert(stem == `archive.tar`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.file_stem with no extension", {
  path := Path.new(`README`);
  stem_opt := path.file_stem();
  match(
    stem_opt,
    .Some(stem) => {
      assert(stem == `README`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.file_stem with full path", {
  path := Path.new(`/home/user/document.txt`);
  stem_opt := path.file_stem();
  match(
    stem_opt,
    .Some(stem) => {
      assert(stem == `document`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.extension extracts file extension", {
  path := Path.new(`main.yo`);
  ext_opt := path.extension();
  match(
    ext_opt,
    .Some(ext) => {
      assert(ext == `yo`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.extension with multiple dots", {
  path := Path.new(`archive.tar.gz`);
  ext_opt := path.extension();
  match(
    ext_opt,
    .Some(ext) => {
      assert(ext == `gz`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.extension with no extension returns None", {
  path := Path.new(`README`);
  ext_opt := path.extension();
  match(
    ext_opt,
    .Some(_) => {
      assert(false);
    },
    .None => {
      assert(true);
    }
  );
});
test("Path.extension with trailing dot returns None", {
  path := Path.new(`file.`);
  ext_opt := path.extension();
  match(
    ext_opt,
    .Some(_) => {
      assert(false);
    },
    .None => {
      assert(true);
    }
  );
});
test("Path.with_extension changes file extension", {
  path := Path.new(`main.yo`);
  new_path := path.with_extension(`js`);
  s := new_path.to_string();
  assert(s == `main.js`);
});
test("Path.with_extension on path with no extension", {
  path := Path.new(`README`);
  new_path := path.with_extension(`md`);
  s := new_path.to_string();
  assert(s == `README.md`);
});
test("Path.with_extension with full path", {
  path := Path.new(`/home/user/document.txt`);
  new_path := path.with_extension(`pdf`);
  s := new_path.to_string();
  assert(s == `/home/user/document.pdf`);
});
test("Path.with_extension on empty path returns self", {
  path := Path.new(``);
  new_path := path.with_extension(`txt`);
  s := new_path.to_string();
  assert(s == ``);
});
test("Path.with_extension preserves directory structure", {
  path := Path.new(`src/test/main.yo`);
  new_path := path.with_extension(`js`);
  s := new_path.to_string();
  assert(s == `src/test/main.js`);
});
test("Path.is_absolute identifies absolute Unix paths", {
  path := Path.new(`/usr/local/bin`);
  assert(path.is_absolute());
});
test("Path.is_absolute identifies relative paths", {
  path := Path.new(`usr/local/bin`);
  assert(!(path.is_absolute()));
});
test("Path.is_relative identifies relative paths", {
  path := Path.new(`./src/main.yo`);
  assert(path.is_relative());
});
test("Path.is_relative identifies absolute paths", {
  path := Path.new(`/src/main.yo`);
  assert(!(path.is_relative()));
});
test("Path with single segment", {
  path := Path.new(`main.yo`);
  s := path.to_string();
  assert(s == `main.yo`);
  assert(path.is_relative());
});
test("Path root directory", {
  path := Path.new(`/`);
  s := path.to_string();
  assert(s == `/`);
  assert(path.is_absolute());
});
test("Path complex join scenario", {
  base := Path.new(`/home/user`);
  sub1 := Path.new(`documents`);
  sub2 := Path.new(`work/projects`);
  joined1 := base.join(sub1);
  joined2 := joined1.join(sub2);
  s := joined2.to_string();
  assert(s == `/home/user/documents/work/projects`);
});
test("Path parent chain", {
  path := Path.new(`/usr/local/bin/tools`);
  // First parent: /usr/local/bin
  p1_opt := path.parent();
  match(
    p1_opt,
    .Some(p1) => {
      assert(p1.to_string() == `/usr/local/bin`);
      // Second parent: /usr/local
      p2_opt := p1.parent();
      match(
        p2_opt,
        .Some(p2) => {
          assert(p2.to_string() == `/usr/local`);
          // Third parent: /usr
          p3_opt := p2.parent();
          match(
            p3_opt,
            .Some(p3) => {
              assert(p3.to_string() == `/usr`);
            },
            .None => {
              assert(false);
            }
          );
        },
        .None => {
          assert(false);
        }
      );
    },
    .None => {
      assert(false);
    }
  );
});
test("Path normalization removes multiple ..", {
  path := Path.new(`/usr/local/../../etc`);
  s := path.to_string();
  assert(s == `/etc`);
});
test("Path with only dots", {
  // A relative path whose segments all normalize away stays "." (the current
  // directory), never the EMPTY string — stat("") is ENOENT, which broke
  // `yo test .` / `yo check .`. Node's path.normalize agrees; the empty
  // INPUT is the only empty path.
  path := Path.new(`./././.`);
  s := path.to_string();
  assert(s == `.`);
});
test("Path .. beyond root is ignored for relative paths", {
  path := Path.new(`../../../etc`);
  s := path.to_string();
  assert(s == `etc`);
});
// ============================================
// Tests for new Path methods
// ============================================
test("Path.with_file_name replaces filename", {
  p := Path.new(`/usr/local/bin`);
  p2 := p.with_file_name(`lib`);
  assert(p2.to_string() == `/usr/local/lib`);
});
test("Path.with_file_name on single segment", {
  p := Path.new(`foo`);
  p2 := p.with_file_name(`bar`);
  assert(p2.to_string() == `bar`);
});
test("Path.with_file_name on empty path", {
  p := Path.new(``);
  p2 := p.with_file_name(`foo`);
  assert(p2.to_string() == `foo`);
});
test("Path.with_file_name preserves absolute flag", {
  p := Path.new(`/usr/local/bin`);
  p2 := p.with_file_name(`lib`);
  assert(p2.is_absolute());
});
test("Path.with_file_name with complex path", {
  p := Path.new(`foo/bar/baz.txt`);
  p2 := p.with_file_name(`qux.md`);
  assert(p2.to_string() == `foo/bar/qux.md`);
});
test("Path.starts_with matching prefix", {
  p := Path.new(`/usr/local/bin`);
  base := Path.new(`/usr`);
  assert(p.starts_with(base));
});
test("Path.starts_with exact match", {
  p := Path.new(`/usr/local`);
  base := Path.new(`/usr/local`);
  assert(p.starts_with(base));
});
test("Path.starts_with non-matching prefix", {
  p := Path.new(`/usr/local/bin`);
  base := Path.new(`/var`);
  assert(!(p.starts_with(base)));
});
test("Path.starts_with longer base", {
  p := Path.new(`/usr`);
  base := Path.new(`/usr/local`);
  assert(!(p.starts_with(base)));
});
test("Path.starts_with relative vs absolute", {
  p := Path.new(`/usr/local`);
  base := Path.new(`usr`);
  assert(!(p.starts_with(base)));
});
test("Path.starts_with both relative", {
  p := Path.new(`foo/bar/baz`);
  base := Path.new(`foo/bar`);
  assert(p.starts_with(base));
});
test("Path.starts_with empty base", {
  p := Path.new(`foo/bar`);
  base := Path.new(``);
  assert(p.starts_with(base));
});
test("Path.starts_with root", {
  p := Path.new(`/usr/local`);
  base := Path.new(`/`);
  assert(p.starts_with(base));
});
test("Path.ends_with matching suffix", {
  p := Path.new(`/usr/local/bin`);
  suffix := Path.new(`local/bin`);
  assert(p.ends_with(suffix));
});
test("Path.ends_with exact match", {
  p := Path.new(`foo/bar`);
  suffix := Path.new(`foo/bar`);
  assert(p.ends_with(suffix));
});
test("Path.ends_with non-matching suffix", {
  p := Path.new(`/usr/local/bin`);
  suffix := Path.new(`lib`);
  assert(!(p.ends_with(suffix)));
});
test("Path.ends_with longer suffix", {
  p := Path.new(`foo`);
  suffix := Path.new(`foo/bar`);
  assert(!(p.ends_with(suffix)));
});
test("Path.ends_with absolute suffix match", {
  p := Path.new(`/usr/local/bin`);
  suffix := Path.new(`/usr/local/bin`);
  assert(p.ends_with(suffix));
});
test("Path.ends_with absolute suffix mismatch", {
  p := Path.new(`usr/local/bin`);
  suffix := Path.new(`/local/bin`);
  assert(!(p.ends_with(suffix)));
});
test("Path.ends_with empty suffix", {
  p := Path.new(`foo/bar`);
  suffix := Path.new(``);
  assert(p.ends_with(suffix));
});
test("Path.ends_with single segment", {
  p := Path.new(`/usr/local/bin`);
  suffix := Path.new(`bin`);
  assert(p.ends_with(suffix));
});
test("Path.components of relative path", {
  p := Path.new(`foo/bar/baz`);
  comps := p.components();
  assert(comps.len() == usize(3));
  c0_opt := comps.get(usize(0));
  match(
    c0_opt,
    .Some(c0) => {
      assert(c0 == `foo`);
    },
    .None => {
      assert(false);
    }
  );
  c1_opt := comps.get(usize(1));
  match(
    c1_opt,
    .Some(c1) => {
      assert(c1 == `bar`);
    },
    .None => {
      assert(false);
    }
  );
  c2_opt := comps.get(usize(2));
  match(
    c2_opt,
    .Some(c2) => {
      assert(c2 == `baz`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.components of absolute path", {
  p := Path.new(`/usr/local`);
  comps := p.components();
  assert(comps.len() == usize(3));
  c0_opt := comps.get(usize(0));
  match(
    c0_opt,
    .Some(c0) => {
      assert(c0 == `/`);
    },
    .None => {
      assert(false);
    }
  );
  c1_opt := comps.get(usize(1));
  match(
    c1_opt,
    .Some(c1) => {
      assert(c1 == `usr`);
    },
    .None => {
      assert(false);
    }
  );
  c2_opt := comps.get(usize(2));
  match(
    c2_opt,
    .Some(c2) => {
      assert(c2 == `local`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.components of root", {
  p := Path.new(`/`);
  comps := p.components();
  assert(comps.len() == usize(1));
  c0_opt := comps.get(usize(0));
  match(
    c0_opt,
    .Some(c0) => {
      assert(c0 == `/`);
    },
    .None => {
      assert(false);
    }
  );
});
test("Path.components of empty path", {
  p := Path.new(``);
  comps := p.components();
  assert(comps.len() == usize(0));
});
test("Path.components of single segment", {
  p := Path.new(`foo`);
  comps := p.components();
  assert(comps.len() == usize(1));
  c0_opt := comps.get(usize(0));
  match(
    c0_opt,
    .Some(c0) => {
      assert(c0 == `foo`);
    },
    .None => {
      assert(false);
    }
  );
});
