{ assert } :: import("std/assert");
/// Local borrows (plans/VALUES_BY_DEFAULT.md decisions 18, 25 and 38 A):
/// `imm(y) := place` (read-only) and `mut(y) := place` (exclusive; `inout(y)`
/// is its Generation A synonym), with last-use live ranges, place-based
/// exclusivity, the module-level and `await` rules, and re-pointing a borrow
/// along a linked structure (the cursor walk).
///
/// The `await` rule (rule 4) is a whole-program error inside an `io.async`
/// body, which `comptime_expect_error` cannot observe: it is pinned by
/// tests/cli-cases/local-borrow-across-an-await-through-a-cell-is-e0911.
{ String } :: import("std/string");
{ RefCell } :: import("std/sync/refcell");
{ ArrayList } :: import("std/collections/array_list");
Point :: struct(x : i32, y : i32);
derive(Point, Copy, Clone);
Shape :: struct(origin : Point, name : String);
Holder :: ref(struct(n : i32, s : String));
// A `ref` object, not an `Rc`: the cursor walk writes `next` through each
// node, and an `Rc`'s payload is read-only (decision 46).
Node :: ref(struct(value : i32, next : Option(Self)));
List :: struct(head : Option(Node));
(mut(g_count) : i32) = i32(0);
g_list := List(head : .None);
bump :: (fn(n : &mut i32) -> unit)({
  n.* = (n.* + i32(1));
});
take_string :: (fn(sink(s) : String) -> usize)(s.len());
noop :: (fn() -> unit)(());

// --- imm: read-only, and the place stays readable ---------------------------
test("imm borrow reads through, and its root stays readable while it is live", {
  s := String.from("abc");
  y := &s;
  assert(y.len() == usize(3), "read through the imm borrow");
  assert(s.len() == usize(3), "an imm borrow does not lock reads of its place");
  z := &s;
  assert((y.len() + z.len()) == usize(6), "two imm borrows of one place coexist");
});
test("imm borrow of a field of a value struct", {
  mut(p) := Point(x : i32(1), y : i32(2));
  px := &p.x;
  p.y = i32(5);
  assert(px.* == i32(1), "a sibling field stays writable while px is live");
  assert(p.y == i32(5), "sibling write landed");
});
test("after an imm borrow's last use its place is writable again", {
  mut(x) := i32(1);
  y := &x;
  v := y.*;
  x = i32(2);
  assert((v == i32(1)) && (x == i32(2)), "the write after the last use is accepted");
});

// --- mut: exclusive until its last use --------------------------------------
test("mut borrow writes through, and the place is free after its last use", {
  mut(x) := i32(1);
  y := &mut x;
  y.* = i32(5);
  assert(x == i32(5), "the write through y landed in x, read after y's last use");
  x = i32(6);
  assert(x == i32(6), "x is writable after y's last use");
});
test("inout(y) := is mut's synonym and gets the same live range", {
  mut(s) := String.from("a");
  r := &mut s;
  r.push_str("b");
  assert(s == "ab", "read of s after r's last use");
});
test("sibling fields of a value struct are borrowed independently", {
  mut(p) := Point(x : i32(1), y : i32(2));
  a := &mut p.x;
  b := &mut p.y;
  a.* = i32(10);
  b.* = i32(20);
  assert((p.x == i32(10)) && (p.y == i32(20)), "both writes landed");
  mut(sh) := Shape(origin : Point(x : i32(0), y : i32(0)), name : String.from("sq"));
  o := &mut sh.origin;
  sh.name.push_str("!");
  o.x = i32(3);
  assert((sh.origin.x == i32(3)) && (sh.name == "sq!"), "a sibling of a nested field is free");
});
test("a sibling field is readable while a mut borrow of another field is live", {
  mut(p) := Point(x : i32(1), y : i32(7));
  a := &mut p.x;
  v := p.y;
  a.* = v;
  assert(p.x == i32(7), "read the sibling, wrote through a");
});
test("a borrow's last use in one arm leaves the other arm free", {
  mut(x) := i32(1);
  c := runtime(true);
  y := &mut x;
  cond(
    c => {
      y.* = i32(2);
    },
    true => {
      x = i32(3);
    }
  );
  assert(x == i32(2), "the first arm wrote through y");
});
test("a borrow declared in a loop body is fresh each iteration", {
  mut(total) := i32(0);
  mut(i) := i32(0);
  while(i < i32(3), {
    acc := &mut total;
    acc.* = (acc.* + i);
    i = (i + i32(1));
  });
  assert(total == i32(3), "0 + 1 + 2");
});
test("a borrow of a borrow keeps its source borrowed, and both write the same place", {
  mut(sh) := Shape(origin : Point(x : i32(0), y : i32(0)), name : String.from("sq"));
  a := &mut sh.origin;
  b := &mut a.y;
  b.* = i32(3);
  a.x = i32(4);
  assert((sh.origin.y == i32(3)) && (sh.origin.x == i32(4)), "b writes into a's target");
});
test("a borrow of a module-level place with no call in its range", {
  c := &mut g_count;
  c.* = (c.* + i32(7));
  assert(g_count == i32(7), "written through c; the read is after c's last use");
  g_count = i32(0);
});
test("a mut borrow passed to a mut parameter", {
  mut(x) := i32(1);
  y := &mut x;
  bump(&mut y.*);
  bump(y);
  assert(x == i32(3), "both calls wrote x through y");
});
test("an object field borrow pins the object; the cell is the unit", {
  h := Holder(n : i32(1), s : String.from("h"));
  {
    n := &mut h.n;
    n.* = (n.* + i32(1));
  };
  assert(h.n == i32(2), "written through the pinned object");
  assert(ref_count(h) == usize(1), "the pin was released at the borrow's scope end");
});

// --- Decision 25: the cursor walk ---------------------------------------------
append :: (fn(list : &mut List, v : i32) -> unit)({
  cur := &mut list.head;
  while(cur.is_some(), {
    match(
      cur,
      .Some(n) => {
        cur = &mut n.next;
      },
      .None => ()
    );
  });
  cur.* = .Some(Node(value : v, next : .None));
});
sum_list :: (fn(list : &List) -> i32)({
  (mut(total) : i32) = i32(0);
  cur := &list.head;
  while(cur.is_some(), {
    match(
      cur,
      .Some(n) => {
        total = (total + n.value);
        cur = &n.next;
      },
      .None => ()
    );
  });
  total
});
first_over :: (fn(list : &List, k : i32) -> i32)({
  cur := &list.head;
  while(cur.is_some(), {
    match(
      cur,
      .Some(n) => {
        if(n.value > k, {
          return(n.value);
        });
        cur = &n.next;
      },
      .None => ()
    );
  });
  i32(-1)
});
head_count :: (fn(list : &List) -> usize)(
  match(list.head, .Some(b) => ref_count(b), .None => usize(0))
);
test("the cursor walk appends at the tail slot (decision 25)", {
  mut(l) := List(head : .None);
  append(&mut l, i32(1));
  append(&mut l, i32(2));
  append(&mut l, i32(3));
  assert(sum_list(&l) == i32(6), "three nodes, in order");
  before := head_count(&l);
  append(&mut l, i32(4));
  assert(sum_list(&l) == i32(10), "a fourth at the tail");
  assert(head_count(&l) == before, "each step's pin was released when the walk ended");
});
test("an early return mid-walk releases the cell the last step pinned", {
  mut(l) := List(head : .None);
  append(&mut l, i32(1));
  append(&mut l, i32(5));
  append(&mut l, i32(9));
  before := head_count(&l);
  assert(first_over(&l, i32(4)) == i32(5), "found the second node");
  assert(first_over(&l, i32(100)) == i32(-1), "walked off the end");
  assert(head_count(&l) == before, "no pin outlived the walk");
});

// --- Rejected: writes through imm (E0908) --------------------------------------
comptime_expect_error(
  imm_assign_rejected :: (fn() -> unit)({
    x := i32(1);
    y := &x;
    y.* = i32(2);
  }),
  "is a `&` borrow, which is read-only"
);
comptime_expect_error(
  imm_field_write_rejected :: (fn() -> unit)({
    p := Point(x : i32(1), y : i32(2));
    y := &p;
    y.x = i32(2);
  }),
  "is a `&` borrow, which is read-only"
);
comptime_expect_error(
  imm_mutating_method_rejected :: (fn() -> unit)({
    s := String.from("a");
    y := &s;
    y.push_str("!");
  }),
  "is a `&` borrow, which is read-only"
);
comptime_expect_error(
  imm_to_mut_parameter_rejected :: (fn() -> unit)({
    x := i32(1);
    y := &x;
    bump(&mut y.*);
  }),
  "is a `&` borrow, which is read-only"
);
comptime_expect_error(
  mut_borrow_through_imm_rejected :: (fn() -> unit)({
    p := Point(x : i32(1), y : i32(2));
    y := &p;
    z := &mut y.x;
    z = i32(3);
  }),
  "is a `&` borrow, which is read-only"
);

// --- Rejected: accesses that conflict with a live borrow (E0911) --------------
comptime_expect_error(
  write_under_imm_rejected :: (fn() -> unit)({
    mut(x) := i32(1);
    y := &x;
    x = i32(2);
    _v := y;
  }),
  "Cannot write `x` here"
);
comptime_expect_error(
  mutating_method_under_imm_rejected :: (fn() -> unit)({
    mut(s) := String.from("a");
    y := &s;
    s.push_str("b");
    _n := y.len();
  }),
  "Cannot write `s` here"
);
comptime_expect_error(
  move_under_imm_rejected :: (fn() -> unit)({
    s := String.from("a");
    y := &s;
    _m := take_string(s);
    _n := y.len();
  }),
  "Cannot move `s` here"
);
comptime_expect_error(
  read_under_mut_rejected :: (fn() -> unit)({
    mut(x) := i32(1);
    y := &mut x;
    _v := x;
    y = i32(2);
  }),
  "Cannot read `x` here"
);
comptime_expect_error(
  containing_place_written_under_mut_rejected :: (fn() -> unit)({
    mut(p) := Point(x : i32(1), y : i32(2));
    a := &mut p.x;
    p = Point(x : i32(3), y : i32(4));
    a = i32(5);
  }),
  "Cannot write `p` here"
);
comptime_expect_error(
  contained_place_read_under_mut_rejected :: (fn() -> unit)({
    mut(sh) := Shape(origin : Point(x : i32(0), y : i32(0)), name : String.from("sq"));
    o := &mut sh.origin;
    _v := sh.origin.y;
    o.y = i32(1);
  }),
  "Cannot read `sh.origin.y` here"
);
comptime_expect_error(
  two_mut_borrows_of_one_place_rejected :: (fn() -> unit)({
    mut(x) := i32(1);
    a := &mut x;
    b := &mut x;
    b = i32(2);
    a = i32(3);
  }),
  "Cannot read `x` here"
);
comptime_expect_error(
  mut_borrow_under_a_live_imm_borrow_rejected :: (fn() -> unit)({
    mut(x) := i32(1);
    a := &x;
    b := &mut x;
    b = i32(2);
    _v := a;
  }),
  "Cannot borrow with `&mut` `x` here"
);
comptime_expect_error(
  two_fields_of_one_cell_overlap :: (fn() -> unit)({
    h := Holder(n : i32(1), s : String.from("h"));
    n := &mut h.n;
    s := &mut h.s;
    s.push_str("!");
    n = i32(2);
  }),
  "the cell is the unit"
);
comptime_expect_error(
  loop_back_edge_keeps_the_borrow_live :: (fn() -> unit)({
    mut(x) := i32(1);
    i := i32(0);
    y := &mut x;
    while(i < i32(3), {
      y.* = (y.* + i32(1));
      x = i32(0);
      i = (i + i32(1));
    });
  }),
  "Cannot write `x` here"
);
comptime_expect_error(
  a_derived_borrow_keeps_its_source_frozen :: (fn() -> unit)({
    mut(p) := Point(x : i32(1), y : i32(2));
    a := &mut p;
    b := &mut a.x;
    _v := p.y;
    b = i32(3);
  }),
  "Cannot read `p.y` here"
);
comptime_expect_error(
  module_level_borrow_across_a_call_rejected :: (fn() -> unit)({
    c := &mut g_count;
    c.* = i32(1);
    noop();
    c = i32(2);
  }),
  "Cannot call `noop` while `c` is live"
);
// The `for` loop makes runtime calls (its cursor methods), so rule 3 rejects a
// module-level borrow live across it. The loop was a std macro, whose call was
// the runtime call; since MACRO_AND_ISO_REMOVAL B1 it is desugared at parse
// time, and the calls it makes carry the loop's position and are reported as
// `for`. Record:
// issues/fixed/2026-10-17-a-module-level-local-borrow-is-not-checked-across-a-call-a-macro-expands-to.md
comptime_expect_error(
  module_level_borrow_across_a_for_loop_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    xs.push(i32(1));
    c := &mut g_count;
    c.* = i32(1);
    for(&mut xs, x => {
      x = i32(2);
    });
    c = i32(2);
  }),
  "Cannot call `for` while `c` is live"
);

// --- Rejected: re-points (decision 25, plan §8) -------------------------------
comptime_expect_error(
  repoint_to_a_sibling_root_rejected :: (fn() -> unit)({
    mut(l1) := List(head : .None);
    l2 := List(head : .None);
    cur := &mut l1.head;
    cur = &mut l2.head;
    cur = .None;
  }),
  "is a different variable, not a place reached from `cur`"
);
comptime_expect_error(
  repoint_to_a_module_level_place_rejected :: (fn() -> unit)({
    mut(l1) := List(head : .None);
    cur := &mut l1.head;
    cur = &mut g_list.head;
    cur = .None;
  }),
  "is a module-level binding"
);
head_of :: (fn(l : &List) -> Option(Node))(l.head);
comptime_expect_error(
  repoint_to_a_place_a_callee_could_reach_rejected :: (fn() -> unit)({
    mut(l1) := List(head : .None);
    l2 := List(head : .None);
    cur := &mut l1.head;
    cur = &mut head_of(l2);
    cur = .None;
  }),
  "is not known to be reached from `cur`"
);
comptime_expect_error(
  repoint_keeps_the_mode :: (fn() -> unit)({
    l1 := List(head : .None);
    cur := &l1.head;
    match(
      cur,
      .Some(n) => {
        cur = &mut n.next;
      },
      .None => ()
    );
  }),
  "so a re-point keeps that mode"
);
comptime_expect_error(
  repoint_of_a_plain_local_rejected :: (fn() -> unit)({
    x := i32(1);
    y := i32(2);
    x = &mut y;
  }),
  "re-points a local borrow"
);
comptime_expect_error(
  repoint_while_a_derived_borrow_is_live_rejected :: (fn() -> unit)({
    mut(l1) := List(head : .None);
    cur := &mut l1.head;
    match(
      cur,
      .Some(n) => {
        d := &cur.*;
        cur = &mut n.next;
        _b := d.is_some();
      },
      .None => ()
    );
  }),
  "Cannot re-point `cur` here"
);
comptime_expect_error(
  the_declared_place_stays_frozen_mid_walk :: (fn() -> unit)({
    mut(l1) := List(head : .None);
    cur := &mut l1.head;
    while(cur.is_some(), {
      match(
        cur,
        .Some(n) => {
          cur = &mut n.next;
        },
        .None => ()
      );
      l1.head = .None;
    });
    cur = .None;
  }),
  "Cannot write `l1.head` here"
);

// --- Rejected: a borrow crosses the function boundary (E0912) ----------------
// Decision 18 rule 1 (decision 38 A): a borrow is second-class — no return,
// store, escaping capture or spawn. `return(<borrow>)` and a body whose
// result expression is one name the BORROW as the function's result, not
// the value it reads through, so both are rejected even where reading
// through a borrow of an implicitly copyable type produces a copy today.
// (A field of a borrowed place is the exception: `y.x` is that field's
// value, judged by its type.)
comptime_expect_error(
  return_of_a_borrow_rejected :: (fn() -> i32)({
    x := i32(1);
    y := &x;
    return(y);
  }),
  "Cannot return the local borrow `y`"
);
// A FIELD read through a borrow (`y.x`) yields the field's value, a copy of
// a scalar: it is not the borrow, so returning it is fine
// (issues/fixed/2026-11-08-e0912-flags-a-scalar-field-read-through-a-local-borrow-as-returning-the-borrow.md).
return_of_a_scalar_field_read_through_a_borrow :: (fn() -> i32)({
  sh := Shape(origin : Point(x : i32(1), y : i32(2)), name : String.from("sq"));
  y := &sh.origin;
  return(y.x);
});
tail_of_a_scalar_field_read_through_a_borrow :: (fn() -> i32)({
  sh := Shape(origin : Point(x : i32(1), y : i32(2)), name : String.from("sq"));
  y := &sh.origin;
  y.y
});
test("a scalar field read through a local borrow is a copy, returnable", {
  assert(return_of_a_scalar_field_read_through_a_borrow() == i32(1), "return(y.x)");
  assert(tail_of_a_scalar_field_read_through_a_borrow() == i32(2), "tail y.y");
});
comptime_expect_error(
  body_tail_yielding_a_borrow_rejected :: (fn() -> i32)({
    x := i32(1);
    y := &x;
    y
  }),
  "Cannot return the local borrow `y`"
);
comptime_expect_error(
  a_nested_block_the_body_result_ends_in_yielding_a_borrow_rejected :: (fn() -> i32)({
    x := i32(1);
    y := &x;
    {
      _x2 := i32(0);
      y
    }
  }),
  "Cannot return the local borrow `y`"
);
comptime_expect_error(
  a_borrow_declared_in_the_result_block_itself_is_rejected_too :: (fn() -> i32)({
    x := i32(1);
    {
      y := &x;
      y
    }
  }),
  "Cannot return the local borrow `y`"
);
comptime_expect_error(
  a_mut_borrow_tail_is_rejected_like_an_imm_one :: (fn() -> i32)({
    mut(x) := i32(1);
    y := &mut x;
    return(y);
  }),
  "Cannot return the local borrow `y`"
);
comptime_expect_error(
  an_inout_borrow_is_muts_synonym_so_its_return_is_rejected_too :: (fn() -> String)({
    mut(s) := String.from("a");
    r := &mut s;
    return(r);
  }),
  "Cannot return the local borrow `r`"
);
// The way out (the E0912 help): read the value out into an owned local
// first, or return the value of an operation on the borrow.
ret_scalar :: (fn() -> i32)({
  x := i32(1);
  y := &x;
  v := y.*;
  v
});
ret_through_op :: (fn() -> i32)({
  x := i32(1);
  y := &x;
  y.* + i32(0)
});
test("copying a borrow out before returning the copy is the way out", {
  assert(ret_scalar() == i32(1), "`v := y` reads through the borrow and v owns the copy");
  assert(ret_through_op() == i32(1), "an operation on the borrow reads through it");
});

// --- An inner binding that shares the borrow's spelling shadows it ----------
// A closure parameter (or a block statement that rebinds the name) named like
// a live local borrow is a NEW binding: the borrow's range must not extend to
// its mentions, so the borrowed place is readable between the borrow's last
// real use and the shadowing binding
// (`issues/fixed/2026-10-18-a-closure-parameter-named-like-a-live-local-borrow-extends-the-borrow.md`).
test("a closure parameter named like a live borrow does not extend the borrow", {
  result := Rc.new(RefCell(i32).new(0));
  (mut(o) : Option(i32)) = .Some(i32(2));
  cur := &mut o;
  match(
    cur,
    .Some(v) => {
      v.* = (v.* * i32(3));
    },
    .None => ()
  );
  r := match(o, .Some(v) => v, .None => i32(0));
  result.with_mut(cur => {
    cur.* = r;
  });
  assert(result.with(c => c.*) == i32(6), "the write through the closure parameter landed");
});
test("a match arm pattern that binds the name shadows the borrow", {
  (mut(o) : i32) = i32(1);
  cur := &mut o;
  cur.* = i32(5);
  v := (o + i32(0));
  other := Option(i32).Some(i32(4));
  w := match(
    other,
    .Some(cur) => (cur + i32(0)),
    .None => i32(0)
  );
  assert((o == i32(5)) && (v == i32(5)) && (w == i32(4)), "the arm bound its own cur");
});
test("a named fn literal parameter named like a live borrow does not extend the borrow", {
  (mut(o) : i32) = i32(1);
  cur := &mut o;
  cur.* = i32(5);
  v := (o + i32(0));
  f := (fn(cur : i32) -> i32)(cur + i32(1));
  w := f(i32(2));
  assert((o == i32(5)) && (v == i32(5)) && (w == i32(3)), "the fn literal bound its own cur");
});
comptime_expect_error(
  a_closure_that_captures_the_borrow_still_extends_it :: (fn() -> unit)({
    (mut(o) : Option(i32)) = .Some(i32(2));
    cur := &mut o;
    probe := o.is_none();
    f := (fn() -> bool)(cur.is_none());
    f();
    probe;
    ()
  }),
  "with `&mut` and is still live"
);
comptime_expect_error(
  a_cond_arm_condition_still_uses_the_borrow :: (fn() -> unit)({
    (mut(flag) : bool) = true;
    cur := &mut flag;
    probe := flag;
    cond(
      (cur == true) => (),
      true => ()
    );
    probe;
    ()
  }),
  "with `&mut` and is still live"
);
comptime_expect_error(
  a_match_guard_still_uses_the_borrow :: (fn() -> unit)({
    (mut(flag) : bool) = true;
    cur := &mut flag;
    probe := flag;
    other := Option(i32).Some(i32(1));
    match(
      other,
      (.Some(x) && (cur == true)) => (),
      _ => ()
    );
    probe;
    ()
  }),
  "with `&mut` and is still live"
);
// A `match` binding whose only use is an `if` condition in its arm (the
// compiler's own switch-group lowering, `src/evaluator/exprs/match.yo`):
// `if` desugars to a `cond`, the condition is the binding's last use, and
// the arm body may write a field of the object the scrutinee lives in
// (`issues/fixed/2026-10-19-borrow-liveness-rejects-the-match-switch-group-lowering.md`).
GroupArm :: struct(pattern : Option(usize), classic : bool);
test("a match binding used only in an if condition ends at the condition", {
  mut(fa) := GroupArm(pattern : .Some(usize(1)), classic : true);
  match(
    &fa.pattern,
    .Some(fidx) => if(fidx.* == usize(1), {
      fa.classic = false;
    }),
    .None => ()
  );
  assert(!fa.classic, "the arm wrote the sibling field after the binding's last use");
});
// The same shape with a bare-identifier condition: only the `cond`-arm flag
// of `_lb_region_end` keeps `if(b, …)`'s condition a use (a binding-shaped
// left side would otherwise read as a closure parameter list).
GroupFlag :: struct(flag : Option(bool), classic : bool);
test("a match binding that is an if condition by itself ends at the condition", {
  mut(fa) := GroupFlag(flag : .Some(true), classic : true);
  match(
    &fa.flag,
    .Some(b) => if(b.*, {
      fa.classic = false;
    }),
    .None => ()
  );
  assert(!fa.classic, "the arm wrote the sibling field after the binding's last use");
});

// `.*` on a reference reads the value it refers to, and the bare name in a
// by-value position is E0926 (decision 43 step 2 N1e-1). Before N1e-1 the
// deref was E0920, and before E0920 it fell through the property lookup and
// surfaced as the evaluator internal "check_if_function_parameter_matches_argument:
// arg has no ExprInfo" far from the `.*`
// (issues/fixed/2026-10-17-a-dereference-of-a-borrow-parameter-in-a-closure-reports-an-internal-error.md).
_deref_of_borrow_param :: (fn(v : &i32) -> bool)(v.* < i32(20));
_deref_of_local_borrow :: (fn() -> bool)({
  x := i32(25);
  y := &x;
  y.* < i32(20)
});
test("`.*` reads through a borrow parameter and a local borrow", {
  n := i32(5);
  assert(_deref_of_borrow_param(&n), "a borrow parameter reads its referent");
  assert(!_deref_of_local_borrow(), "a local borrow reads its referent");
});
comptime_expect_error({
  _bare_borrow_param :: (fn(v : &i32) -> bool)(v < i32(20));
  n := i32(5);
  _bare_borrow_param(&n);
}, "reading the value it refers to is spelled `v.*`");
// A bare reference whose referent is move-only, read as a whole value: E0926
// is judged before the read's consumer, and `r.*` is right where the value is
// only read (an operand) but E0901 where it would be copied (a by-value
// parameter, a `:=` binding), so the help names both; `r.*` copied anyway is
// E0901 naming the dereference
// (issues/fixed/2026-11-05-migrate-deref-copies-a-move-only-referent-into-a-by-value-parameter.md).
_take_owned_string :: (fn(s : String) -> usize)(s.len());
comptime_expect_error({
  _pass_ref_by_value :: (fn(r : &String) -> usize)(_take_owned_string(r));
  s := String.from("a");
  _pass_ref_by_value(&s);
}, "Where it would be copied — a by-value parameter, a `:=` binding, a return — `String` is move-only, so pass `r` itself to a `&String` parameter, read through it (`r.field`, `r.method()`), or copy it explicitly with `r.*.clone()`. `yo fix --migrate deref` inserts the `.*` at the reads and lists the copies.");
comptime_expect_error({
  _bind_ref_whole :: (fn(r : &String) -> usize)({
    x := r;
    x.len()
  });
  s := String.from("a");
  _bind_ref_whole(&s);
}, "write `r.*` where the value is only read in place (an operand such as `r.* == other`).");
comptime_expect_error(
  (fn(r : &String) -> String)(r.*),
  "pass `r` itself to a `&String` parameter or read through it where the value is used (`r.field`, `r.method()`), or copy it explicitly with `r.*.clone()`"
);
comptime_expect_error({
  _compare_refs_bare :: (fn(r : &String, o : &String) -> bool)(r == o);
  s := String.from("a");
  _compare_refs_bare(&s, &s);
}, "reading the value it refers to is spelled `r.*`");
_compare_string_refs :: (fn(r : &String, o : &String) -> bool)(r.* == o.*);
test("local borrows: `r.*` of a move-only referent is an operand, not a copy", {
  a := String.from("a");
  b := String.from("a");
  assert(_compare_string_refs(&a, &b), "the operands read through the references");
  assert(a.len() == usize(1), "a is untouched");
});
comptime_expect_error({
  _pass_deref_by_value :: (fn(r : &String) -> usize)(_take_owned_string(r.*));
  s := String.from("a");
  _pass_deref_by_value(&s);
}, "cannot copy `r.*`, whose type `String` is move-only: `r` is a reference");
// A type's OWN field named `*` keeps its field read (std's atomics; pinned
// by `check ./std`, which reads `self.*` on `self : &Self` throughout).

// --- Decision 25's cursor walk over `Option(Box(Self))` (VERDICTS-24) --------
// A binding of a bare `match` over `cur` is a place binding into `cur`'s
// target (VERDICTS-13 §14), and a unique `Box`'s auto-deref is a value step:
// the walk re-points through it with no cell and no pin, as in Rust.
BNode :: struct(value : i32, next : Option(Box(Self)));
BList :: struct(head : Option(Box(BNode)));
b_append :: (fn(list : &mut BList, v : i32) -> unit)({
  cur := &mut list.head;
  while(cur.is_some(), {
    match(
      cur,
      .Some(n) => {
        cur = &mut n.next;
      },
      .None => ()
    );
  });
  cur.* = .Some(Box.new(BNode(value : v, next : .None)));
});
// The `&` walk reads `n` after the re-point: a shared binding stays readable.
b_sum :: (fn(list : &BList) -> i32)({
  (mut(total) : i32) = i32(0);
  cur := &list.head;
  while(cur.is_some(), {
    match(
      cur,
      .Some(n) => {
        cur = &n.next;
        total = (total + n.value);
      },
      .None => ()
    );
  });
  total
});
// `recur(&mut n.next)` passes the field's address, as a named call does
// (issues/fixed/2026-11-05-recur-of-a-mut-borrowed-field-of-a-match-binding-passes-the-value-not-its-address.md).
b_last_value :: (fn(slot : &mut Option(Box(BNode))) -> i32)(
  match(slot, .Some(n) => cond(n.next.is_some() => recur(&mut n.next), true => n.value), .None => i32(-1))
);
// The same recursion writing through the address it was passed.
b_bump_all :: (fn(slot : &mut Option(Box(BNode))) -> unit)(
  match(
    slot,
    .Some(n) => {
      n.value = (n.value + i32(10));
      recur(&mut n.next);
    },
    .None => ()
  )
);
test("the cursor walk over Option(Box(Self)) appends at the tail and sums (VERDICTS-24)", {
  mut(l) := BList(head : .None);
  b_append(&mut l, i32(1));
  b_append(&mut l, i32(2));
  b_append(&mut l, i32(3));
  assert(b_sum(&l) == i32(6), "three nodes, in order");
  b_append(&mut l, i32(4));
  assert(b_sum(&l) == i32(10), "a fourth at the tail");
});
test("recur(&mut n.next) through a match binding reaches the last node", {
  mut(h) := Option(Box(BNode)).Some(Box.new(BNode(value : 1, next : .Some(Box.new(BNode(value : 2, next : .None))))));
  assert(b_last_value(&mut h) == i32(2), "the last node's value");
  b_bump_all(&mut h);
  assert(b_last_value(&mut h) == i32(12), "every node was written through its slot");
  mut(l) := BList(head : h);
  assert(b_sum(&l) == i32(23), "11 + 12");
  b_append(&mut l, i32(7));
  assert(b_last_value(&mut l.head) == i32(7), "the appended tail");
});
comptime_expect_error(
  box_walk_the_declared_place_stays_frozen_mid_walk :: (fn() -> unit)({
    mut(l1) := BList(head : .None);
    cur := &mut l1.head;
    while(cur.is_some(), {
      match(
        cur,
        .Some(n) => {
          cur = &mut n.next;
        },
        .None => ()
      );
      l1.head = .None;
    });
    cur = .None;
  }),
  "Cannot write `l1.head` here"
);
comptime_expect_error(
  box_walk_repoint_while_a_derived_borrow_is_live_rejected :: (fn() -> unit)({
    mut(l1) := BList(head : .None);
    cur := &mut l1.head;
    match(
      cur,
      .Some(n) => {
        d := &cur.*;
        cur = &mut n.next;
        _b := d.is_some();
      },
      .None => ()
    );
  }),
  "Cannot re-point `cur` here"
);
// `cur = &mut n.next` reborrows `n` mutably for `cur`'s live range, so `n`
// is frozen after it (Rust's verdict too).
comptime_expect_error(
  box_walk_binding_read_after_a_mut_repoint_rejected :: (fn() -> i32)({
    mut(l1) := BList(head : .Some(Box.new(BNode(value : i32(1), next : .None))));
    cur := &mut l1.head;
    (mut(seen) : i32) = i32(0);
    match(
      cur,
      .Some(n) => {
        cur = &mut n.next;
        seen = n.value;
      },
      .None => ()
    );
    cur.* = .None;
    seen
  }),
  "Cannot read `n"
);
// A by-value `match(cur.*, …)` would move the payload out of `cur`'s
// target, which decision 26 rejects at the scrutinee, naming the bare
// `match(cur, …)` whose binding is a place.
comptime_expect_error(
  box_walk_through_a_by_value_match_rejected :: (fn() -> unit)({
    mut(l1) := BList(head : .None);
    cur := &mut l1.head;
    match(
      cur.*,
      .Some(n) => {
        cur = &mut n.next;
      },
      .None => ()
    );
    cur.* = .None;
  }),
  "match through the reference: `match(cur, …)` binds the payload as a borrow of the referent"
);
// The `Rc` list: the `&` walk steps into each cell (pinning it); the `&mut`
// walk is E0919, since an `Rc`'s payload is read-only (decision 46). The
// mutable list is the `Box` one above.
RNode :: struct(value : i32, next : Option(Rc(Self)));
RList :: struct(head : Option(Rc(RNode)));
r_sum :: (fn(list : &RList) -> i32)({
  (mut(total) : i32) = i32(0);
  cur := &list.head;
  while(cur.is_some(), {
    match(
      cur,
      .Some(n) => {
        total = (total + n.value);
        cur = &n.next;
      },
      .None => ()
    );
  });
  total
});
test("the `&` cursor walk over Option(Rc(Self)) steps through each cell", {
  tail := Rc.new(RNode(value : i32(2), next : .None));
  l := RList(head : .Some(Rc.new(RNode(value : i32(1), next : .Some(Rc.clone(&tail))))));
  assert(r_sum(&l) == i32(3), "1 + 2");
  assert(r_sum(&l) == i32(3), "the walk released each step's pin");
});
comptime_expect_error(
  rc_walk_mut_repoint_rejected :: (fn() -> unit)({
    mut(l1) := RList(head : .None);
    cur := &mut l1.head;
    match(
      cur,
      .Some(n) => {
        cur = &mut n.next;
      },
      .None => ()
    );
    cur.* = .None;
  }),
  "an `Rc`'s payload is shared, so it is read-only through the handle"
);

// --- a borrowed temporary lives to the end of its statement ------------------
// Rust's temporary lifetime (plans/VALUES_BY_DEFAULT.md, "`&temp` is
// allowed"): the temporary a statement creates only to lend it —
// `show(&make())`, the exempt `show(make())`, a borrowed `match` scrutinee —
// is dropped at the end of the STATEMENT, not at the enclosing block's end.
// There is no lifetime extension: a binding of a borrow of a temporary is
// rejected, so the borrow always ends with its statement
// (issues/fixed/2026-11-06-a-borrowed-temporary-is-dropped-at-its-blocks-end-not-its-statements.md).
(mut(g_tmp_drops) : i32) = i32(0);
TmpPlain :: struct(n : i32);
impl(
  TmpPlain,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_tmp_drops = (g_tmp_drops + i32(1));
    })
  )
);
tmp_mk :: (fn() -> TmpPlain)(TmpPlain(n : i32(3)));
tmp_rd :: (fn(p : &TmpPlain) -> i32)(p.n);
impl(TmpPlain, tmp_n : (fn(self : &Self) -> i32)(self.n));
test("a borrowed temporary is dropped at its statement's end", {
  g_tmp_drops = i32(0);
  assert(tmp_rd(&TmpPlain(n : i32(3))) == i32(3), "the marker spelling reads");
  assert(g_tmp_drops == i32(1), "the marker spelling drops at the statement's end");
  assert(tmp_rd(tmp_mk()) == i32(3), "the exempt spelling reads");
  assert(g_tmp_drops == i32(2), "the exempt spelling drops at the statement's end");
  m := match(&tmp_mk(), p => p.n, _ => i32(0));
  assert(m == i32(3), "a borrowed match scrutinee reads");
  assert(g_tmp_drops == i32(3), "a borrowed match scrutinee drops at the statement's end");
  assert(tmp_mk().tmp_n() == i32(3), "a `&self` receiver reads");
  assert(g_tmp_drops == i32(4), "a receiver temporary drops at the statement's end");
  v := tmp_rd(&tmp_mk());
  assert(v == i32(3), "a lend inside a binding's right-hand side reads");
  assert(g_tmp_drops == i32(5), "a lend inside a binding's right-hand side drops at the statement's end");
  (both : i32) = (tmp_rd(&tmp_mk()) + tmp_rd(&TmpPlain(n : i32(4))));
  assert(both == i32(7), "two lent temps in one statement");
  assert(g_tmp_drops == i32(7), "both drop at the statement's end, newest first");
});
TmpRaise :: (ctl() -> unit);
tmp_lend_raise :: (fn(p : &TmpPlain, raise : TmpRaise) -> unit)({
  raise();
  ()
});
tmp_unwinds :: (fn() -> unit)({
  (raise : TmpRaise) = (
    () -> {
      unwind(());
    }
  );
  tmp_lend_raise(&tmp_mk(), raise);
});
test("a lent temporary is dropped when its statement unwinds past it", {
  g_tmp_drops = i32(0);
  tmp_unwinds();
  assert(g_tmp_drops == i32(1), "the escape path inside the statement drops the lent temporary");
});
// A temporary an ENCLOSING statement lends lives to the end of THAT
// statement, not to the end of a statement nested inside it: `for(&r.items,
// x => …)` mints the handle's temporary and the loop body's element binding at
// the same `for` token, and the body's statement-end flush released the outer
// temporary once per iteration — the stage-2 compiler freed its comptime-fn
// cache entries this way
// (issues/fixed/2026-11-07-a-lent-temporary-of-an-enclosing-statement-is-released-at-an-inner-statements-end.md).
TmpBag :: struct(items : ArrayList(i32));
impl(
  TmpBag,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_tmp_drops = (g_tmp_drops + i32(1));
    })
  )
);
tmp_bag :: (fn() -> TmpBag)({
  (mut(xs) : ArrayList(i32)) = ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  TmpBag(items : xs)
});
tmp_share :: (fn(r : &Rc(TmpBag)) -> Option(Rc(TmpBag)))(Option(Rc(TmpBag)).Some(Rc.clone(r)));
test("a lent temporary of an enclosing statement is not released at an inner statement's end", {
  g_tmp_drops = i32(0);
  r := Rc.new(tmp_bag());
  (mut(sum) : i32) = i32(0);
  for(&r.items, x => {
    sum = (sum + x.*);
  });
  assert(sum == i32(3), "the loop reads every element");
  assert(g_tmp_drops == i32(0), "the loop body does not release the handle's temporary once per iteration");
  assert(r.items.len() == usize(2), "the handle is still live after the loop");
});
test("a match binding's lent temporary is not released inside a loop in its arm", {
  g_tmp_drops = i32(0);
  r := Rc.new(tmp_bag());
  (mut(sum) : i32) = i32(0);
  match(
    tmp_share(&r),
    .Some(entry) => {
      for(&entry.items, x => {
        sum = (sum + x.*);
      });
    },
    .None => ()
  );
  assert(sum == i32(3), "the loop reads every element");
  assert(g_tmp_drops == i32(0), "the bag outlives the match: `r` still owns it");
  assert(r.items.len() == usize(2), "the handle is still live after the match");
});
// A holder's flow set is what its `=` joins added (O-1, §7), read wherever
// the holder is read; a by-value parameter holder holds the caller's
// references, never its own place
// (issues/fixed/2026-11-09-a-holder-read-ignores-what-its-assignments-joined.md).
_keep_joined :: (fn(generic(p : Origin), r : &(i32, p)) -> Option(&(i32, p)))({
  mut(res) := Option(&(i32, p)).None;
  res = .Some(r);
  res
});
_keep_typed :: (fn(generic(p : Origin), r : &(i32, p)) -> Option(&(i32, p)))({
  (mut(res) : Option(&(i32, p))) = .None;
  res = .Some(r);
  res
});
_copy_param :: (fn(generic(p : Origin), o : Option(&(i32, p))) -> Option(&(i32, p)))({
  c := o;
  c
});
test("a holder joined from a parameter returns with the parameter's origin", {
  x := i32(4);
  // Matched, not unwrapped (issues/2026-11-09-option-unwrap-over-a-reference-payload-is-e0601.md).
  assert(match(_keep_joined(&x), .Some(r) => (r.* == i32(4)), .None => false), "a `:=` holder");
  assert(match(_keep_typed(&x), .Some(r) => (r.* == i32(4)), .None => false), "a typed holder");
  assert(match(_copy_param(.Some(&x)), .Some(r) => (r.* == i32(4)), .None => false), "a copy of a by-value parameter holder");
});
// The joins stay visible to the return check: a local's lend joined into
// the holder is still E0912.
comptime_expect_error(
  _return_joined_local :: (fn(r : &i32) -> Option(&i32))({
    mut(res) := Option(&i32).None;
    x := i32(1);
    res = .Some(&x);
    res
  }),
  "Cannot return a value holding `x`"
);
// A typed declaration `(h : T) = v` is a holder binding as `h := v` is
// (issues/fixed/2026-11-09-a-typed-declaration-is-not-a-holder-binding.md):
// it freezes what `v` lends, and its `=` joins reach its last use.
comptime_expect_error(
  _typed_holder_freezes :: (fn() -> unit)({
    mut(s) := String.from("ab");
    (h : Option(&String)) = .Some(&s);
    s = String.from("x");
    _ := h;
  }),
  "Cannot write `s` here"
);
comptime_expect_error(
  _typed_holder_scope :: (fn() -> unit)({
    (mut(h) : Option(&String)) = .None;
    {
      inner := String.from("ab");
      h = .Some(&inner);
    };
    _ := h;
  }),
  "scope ends with its block"
);
// Two-phase borrows with a named `&` (plans/backlog/BORROW_CHECKER_COMPLETENESS.md
// §7 P9): a `&mut` argument, the receiver included, is reserved where it is
// written and activated when the call begins, so a `&` loan whose last use is
// a later argument of the same call has ended by then.
_tp_push_len :: (fn(a : &mut ArrayList(i32), n : usize) -> unit)(a.push(i32(n)));
test("a & loan used last in a later argument does not conflict with the &mut receiver", {
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(1));
  r := &xs;
  xs.push(i32(r.len()));
  assert(xs.len() == usize(2), "pushed");
  assert(xs(usize(1)) == i32(1), "pushed r.len() before the push");
  s := &xs;
  _tp_push_len(&mut xs, s.len());
  assert(xs(usize(2)) == i32(2), "an explicit &mut argument is two-phase too");
});
comptime_expect_error(
  two_phase_loan_used_after_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    r := &xs;
    xs.push(i32(r.len()));
    _n := r.len();
  }),
  "Cannot write `xs` here"
);
comptime_expect_error(
  two_phase_mut_loan_in_argument_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    m := &mut xs;
    xs.push(i32(m.len()));
  }),
  "a `&mut` borrow is exclusive"
);
// Two-phase does not end a loan an operand of the call carries into the callee:
// the reference passed bare (in either order), a holder of it, an `Option(&T)`
// of it, or a nested call's reference result over it. Only a loan whose last use
// is an operand that carries no origin (`i32(r.len())`, `h.r.len()`) has ended
// (issues/fixed/2026-11-11-two-phase-ends-a-loan-a-later-argument-carries-into-the-callee.md).
_TpHolder :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(ArrayList(i32), p)));
_tp_push_holder :: (fn(generic(p : Origin), a : &mut ArrayList(i32), h : _TpHolder(p)) -> unit)(a.push(i32(h.r.len())));
_tp_push_opt :: (fn(a : &mut ArrayList(i32), h : Option(&ArrayList(i32))) -> unit)(a.push(i32(match(h, .Some(r) => r.len(), .None => usize(0)))));
_tp_push_list :: (fn(a : &mut ArrayList(i32), r : &ArrayList(i32)) -> unit)(a.push(i32(r.len())));
_tp_list_push :: (fn(r : &ArrayList(i32), a : &mut ArrayList(i32)) -> unit)(a.push(i32(r.len())));
_tp_push_ref :: (fn(a : &mut ArrayList(i32), r : &i32) -> unit)(a.push(r.*));
_tp_first :: (fn(xs : &ArrayList(i32)) -> &i32)(&xs(usize(0)));
_tp_id :: (fn(xs : &ArrayList(i32)) -> &ArrayList(i32))(xs);
comptime_expect_error(
  two_phase_reference_argument_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    r := &xs;
    _tp_push_list(&mut xs, r);
  }),
  "Cannot write `xs` here: `r` borrows `xs`"
);
comptime_expect_error(
  two_phase_reference_argument_before_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    r := &xs;
    _tp_list_push(r, &mut xs);
  }),
  "Cannot write `xs` here: `r` borrows `xs`"
);
comptime_expect_error(
  two_phase_call_result_reference_argument_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    a := _tp_id(&xs);
    _tp_list_push(a, &mut xs);
  }),
  "Cannot write `xs` here: `a` borrows `xs`"
);
comptime_expect_error(
  two_phase_holder_argument_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    h := _TpHolder(xs)(r : &xs);
    _tp_push_holder(&mut xs, h);
  }),
  "Cannot write `xs` here: `h` borrows `xs`"
);
comptime_expect_error(
  two_phase_option_argument_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    h := Option(&ArrayList(i32)).Some(&xs);
    _tp_push_opt(&mut xs, h);
  }),
  "Cannot write `xs` here: `h` borrows `xs`"
);
comptime_expect_error(
  two_phase_reference_result_argument_rejected :: (fn() -> unit)({
    mut(xs) := ArrayList(i32).new();
    xs.push(i32(1));
    q := &xs;
    _tp_push_ref(&mut xs, _tp_first(q));
  }),
  "Cannot write `xs` here: `q` borrows `xs`"
);
test("a holder read for a value in a later argument does not conflict with the &mut argument", {
  mut(xs) := ArrayList(i32).new();
  xs.push(i32(1));
  h := _TpHolder(xs)(r : &xs);
  _tp_push_len(&mut xs, h.r.len());
  assert(xs(usize(1)) == i32(1), "pushed h.r.len() before the push");
});
// --- A move-only element lent for a call while its container is touched through another name ---
// issues/2026-10-23-a-move-only-element-borrowed-for-a-call-is-freed-when-an-argument-clears-its-container-through-another-handle.md
// (VERDICTS-42): the value language rejects every second name; the shared-cell twin panics at the outer cell
// (cli-case refcell-element-lent-outer-cell-cleared-panics).
comptime_expect_error(
  element_lent_container_moved_to_a_second_name_rejected :: (fn() -> unit)({
    hs := ArrayList(RefCell(String)).new();
    hs2 := hs;
    hs(usize(0)).with_mut(v => {
      hs2.clear();
    });
  }),
  "use of moved value"
);
comptime_expect_error(
  element_lent_container_cleared_by_name_rejected :: (fn() -> unit)({
    mut(hs) := ArrayList(RefCell(String)).new();
    hs(usize(0)).with_mut(v => {
      hs.clear();
    });
  }),
  "which an earlier argument of the same call lends to it"
);
comptime_expect_error(
  element_lent_container_cleared_through_a_live_mut_borrow_rejected :: (fn() -> unit)({
    mut(hs) := ArrayList(RefCell(String)).new();
    r := &mut hs;
    hs(usize(0)).with_mut(v => {
      r.clear();
    });
  }),
  "`r` borrows `hs` with `&mut` and is still live"
);
