//! Tuple scrutinees and tuple sub-patterns (plans/reference/MATCH_PATTERN_MATCHING.md
//! P4): `(a, b)` patterns with exact arity, any sub-pattern per element, on
//! runtime and compile-time scrutinees.
{ assert } :: import("std/assert");
{ args } :: import("std/env");
runtime_int :: (fn() -> i32)(i32(args().len()));
test("tuple literal patterns discriminate by element", {
  f :: (fn(t : Tuple(i32, i32)) -> i32)(
    match(
      t,
      (0, 0) => i32(0),
      (0, y) => y,
      (x, 0) => (x * i32(10)),
      (x, y) => ((x * i32(100)) + y)
    )
  );
  assert(f((0, 0)) == i32(0));
  assert(f((0, 7)) == i32(7));
  assert(f((3, 0)) == i32(30));
  assert(f((3, 7)) == i32(307));
});
test("wildcards and bindings mix per element", {
  g :: (fn(t : Tuple(i32, bool)) -> i32)(
    match(
      t,
      (_, true) => i32(1),
      (n, false) => (n + i32(1)),
      (_, _) => i32(0)
    )
  );
  assert(g((5, true)) == i32(1));
  assert(g((5, false)) == i32(6));
});
test("a tuple element may be a variant pattern", {
  Inner :: enum(A(v : i32), B);
  derive(Inner, Copy, Clone);
  h :: (fn(t : Tuple(i32, Inner)) -> i32)(
    match(
      t,
      (0, .A(v)) => v,
      (_, .A(v)) => (v * i32(2)),
      (_, .B) => i32(-1)
    )
  );
  assert(h((0, Inner.A(7))) == i32(7));
  assert(h((9, Inner.A(7))) == i32(14));
  assert(h((9, Inner.B)) == i32(-1));
});
test("or-patterns and ranges inside tuple elements", {
  k :: (fn(t : Tuple(i32, i32)) -> i32)(
    match(
      t,
      (1 | 2, y) => (y + i32(1)),
      (3 ..= 9, y) => (y + i32(2)),
      (x, y) => ((x + y) * i32(-1))
    )
  );
  assert(k((1, 10)) == i32(11));
  assert(k((2, 10)) == i32(11));
  assert(k((5, 10)) == i32(12));
  assert(k((20, 10)) == i32(-30));
});
test("a nested tuple pattern", {
  m :: (fn(t : Tuple(Tuple(i32, i32), i32)) -> i32)(
    match(
      t,
      ((0, 0), z) => z,
      ((x, y), z) => (x + y + z)
    )
  );
  assert(m(((0, 0), 5)) == i32(5));
  assert(m(((1, 2), 5)) == i32(8));
});
test("a whole-value binding of a tuple position", {
  n :: (fn(t : Tuple(i32, i32)) -> i32)(
    match(
      t,
      (whole := (0, _)) => (whole.0 + whole.1),
      (x, y) => (x - y)
    )
  );
  assert(n((0, 9)) == i32(9));
  assert(n((8, 3)) == i32(5));
});
test("compile-time scrutinee: the tuple arm is selected at compile time", {
  K :: (i32(1), i32(2));
  r :: match(
    K,
    (1, y) => y,
    _ => i32(0)
  );
  assert(r == i32(2));
});
test("an enum payload holding a tuple takes a tuple sub-pattern", {
  Pair :: enum(Mk(t : Tuple(i32, i32)), None2);
  p :: (fn(e : Pair) -> i32)(
    match(
      e,
      .Mk((0, y)) => y,
      .Mk((x, _)) => x,
      .None2 => i32(-1)
    )
  );
  assert(p(Pair.Mk((0, 42))) == i32(42));
  assert(p(Pair.Mk((7, 1))) == i32(7));
  assert(p(Pair.None2) == i32(-1));
});
test("a runtime tuple scrutinee with a literal guard", {
  n2 := runtime_int();
  q :: (fn(t : Tuple(i32, i32)) -> i32)(
    match(
      t,
      ((x, y) && ((x + y) > i32(100))) => i32(1),
      _ => i32(0)
    )
  );
  assert(q((50, 60)) == i32(1));
  assert(q((n2, n2)) == i32(0));
});
