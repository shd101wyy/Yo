{ assert } :: import("std/assert");
/// Comprehensive thread-safety test file covering Phases N, O, L.
/// Phase O: atomic-object field writes rejected in safe code
/// Phase N/L: negative impls, JoinHandle/Io non-Send verification
/// Phase P: field visibility enforcement
{ AtomicI32, MemoryOrder } :: import("std/sync/atomic");

// ============================================================================
// Phase O (THREAD_SAFETY): Atomic object field writes forbidden in safe code
// ============================================================================
test("read atomic object field is allowed", {
  a := arc(i32(42));
  assert(a.* == i32(42), "read through arc.* should work");
});
test("read custom atomic object field is allowed", {
  MyObj :: atomic(ref(struct(value : i32)));
  m := MyObj(i32(99));
  assert(m.value == i32(99), "read through custom field should work");
});
test("construct atomic object is allowed", {
  a := arc(i32(7));
  assert(a.* == i32(7), "construction should work");
});

// ============================================================================
// Phase N + L (THREAD_SAFETY): Negative impls and non-Send verification
// ============================================================================
comptime_assert(
  Type.impls(JoinHandle(i32), Send) == false,
  "JoinHandle must not be Send"
);
comptime_assert(
  Type.impls(Io, Send) == false,
  "Io must not be Send"
);
// Verify that a generic negative impl works for any T
comptime_assert(
  Type.impls(JoinHandle(bool), Send) == false,
  "JoinHandle(bool) must not be Send"
);

// Phase N: negative impl override works
MySendStruct :: struct(value : i32);
impl(MySendStruct, !Send());
comptime_assert(
  Type.impls(MySendStruct, Send) == false,
  "negative Send impl should override auto-derive"
);

// Phase N: contradiction detection
comptime_expect_error({
  ConflictType :: struct(value : i32);
  impl(ConflictType, Send());
  impl(ConflictType, !Send());
});

// ============================================================================
// Phase L (THREAD_SAFETY): Send is ENFORCED at the spawn boundary
// ============================================================================
// issues/fixed/send-was-not-enforced-at-spawn-boundaries.md — the closure
// created for `Impl(Fn(io : Io) -> unit, Send)` is checked against `Send`
// capture by capture: a non-atomic `ref` struct (an ArrayList, a String, any
// plain ref(struct)) may not cross an OS thread.
{ Thread } :: import("std/thread");
{ ArrayList } :: import("std/collections/array_list");
// The offending value must be a FUNCTION LOCAL: the check runs over a
// closure's captures, and a module-level binding is a global, not a capture
// (globals reached from a spawned closure are a separate, open question).
NotSendCell :: ref(struct(v : i32));
comptime_expect_error({
  _spawn_with_ref_struct :: (fn() -> unit)({
    cell := NotSendCell(v : i32(1));
    t := Thread(unit).spawn(io => {
      _v := cell.v;
      ()
    });
    t.join();
  });
  _spawn_with_ref_struct();
});
comptime_expect_error({
  _spawn_with_array_list :: (fn() -> unit)({
    items := ArrayList(i32).new();
    t := Thread(unit).spawn(io => {
      items.push(i32(1));
      ()
    });
    t.join();
  });
  _spawn_with_array_list();
});
// A captured CLOSURE is judged by ITS captures (Rust's auto trait): one over
// atomics is Send, one over an ArrayList is not.
comptime_expect_error({
  _spawn_with_closure_over_ref :: (fn() -> unit)({
    items := ArrayList(i32).new();
    (worker : Impl(Fn() -> unit)) = (
      () => {
        items.push(i32(1));
      }
    );
    t := Thread(unit).spawn(io => worker());
    t.join();
  });
  _spawn_with_closure_over_ref();
});
// Over-rejection canaries: Send captures (a scalar, an Arc, a closure over an
// atomic) still spawn. Defined, not run — the check happens when the closure
// is created.
_send_captures_still_spawn :: (fn() -> unit)({
  n := i32(3);
  a := arc(i32(4));
  hits := AtomicI32(i32(0));
  (bump : Impl(Fn() -> unit)) = (
    () => {
      hits.fetch_add(i32(1), MemoryOrder.AcqRel);
    }
  );
  t := Thread(unit).spawn(io => {
    _s := (n + a.*);
    bump();
    ()
  });
  t.join();
});
// D18b: a captured variable whose OWN declared type already requires the
// marker trait is accepted by its DECLARATION, not by re-judging what it
// resolved to. `cb` below is declared `Impl(Fn(io : Io) -> unit, Send)`, so
// forwarding it into a spawn closure must compile — before this it was
// rejected with "Captured variable 'cb' (type Impl : (Fn(Io) -> unit + Send))
// does not implement Send", an error refuted by its own text. This is the
// shape `Thread(T).spawn` itself has.
_forward_a_bounded_callback :: (
  fn(cb : Impl(Fn(io : Io) -> unit, Send)) -> unit
)({
  t := Thread(unit).spawn((io : Io) => {
    cb(io);
    ()
  });
  t.join();
});
// …and that exemption is only sound because the bound is PROVED where the
// value enters. A non-Send closure may not be bound to a `Send`-bounded
// declaration in the first place, so no non-Send value can ever reach the
// exemption above.
comptime_expect_error({
  _bind_non_send_to_a_send_bound :: (fn() -> unit)({
    items := ArrayList(i32).new();
    (leaky : Impl(Fn() -> unit, Send)) = (
      () => {
        items.push(i32(1));
      }
    );
    leaky();
  });
  _bind_non_send_to_a_send_bound();
});
// ============================================================================
// Phase P (THREAD_SAFETY): Field visibility — same-file access works
// ============================================================================
test("private _-field accessible in same file", {
  MyType :: struct(_secret : i32);
  v := MyType(i32(42));
  assert(v._secret == i32(42), "should access _-prefixed field in same file");
  v._secret = i32(99);
  assert(v._secret == i32(99), "should write _-prefixed field in same file");
});

// ============================================================================
// Phase H (THREAD_SAFETY): Iso(Arc(T)) and Arc(Iso(T)) are banned
// ============================================================================
comptime_expect_error({
  Iso(Arc(i32));
});
comptime_expect_error({
  Arc(Iso(i32));
});
