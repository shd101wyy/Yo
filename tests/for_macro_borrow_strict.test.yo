pragma(Pragma.StrictBorrow);
{ assert } :: import("std/assert");
/// `pragma(Pragma.StrictBorrow)` (plans/archive/INOUT_LOCAL_BINDINGS_AUDIT.md Phase D):
/// inside a borrowed `for` body of this file, a call the compiler cannot
/// prove harmless to the borrowed element is a COMPILE error instead of a
/// runtime borrow panic — a mutating method on an alias of the borrowed
/// collection, or a callee whose effects are unknown. Everything the
/// per-parameter mutation mask can vouch for stays accepted. A call on the
/// borrowed collection itself is E0911 in every file.
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
// The body cannot name the borrowed collection at all since decision 39's
// lowering (E0911, plans/VALUES_BY_DEFAULT.md), so what the pragma still
// decides is a call through ANOTHER handle of it, or a callee whose effects
// are unknown.
Bag :: ref(struct(items : ArrayList(i32), version : i32));
impl(
  Bag,
  total : (fn(self : &Self) -> i32)({
    mut(t) := i32(0);
    for(self.items, x => {
      t = (t + x);
    });
    t
  })
);
test("strict: read-only calls, fresh-storage mutation, element writes and other collections are accepted", {
  xs := ArrayList(i32).new();
  xs.push(i32(1));
  xs.push(i32(2));
  ys := xs; // a second handle of the borrowed list
  others := ArrayList(i32).new();
  names := ArrayList(String).new();
  names.push(String.from("a"));
  mut(total) := i32(0);
  for(&mut xs, x => {
    total = (total + (x * i32(ys.len())));
    assert(ys.contains(x), "read-only method through the alias");
    snapshot := ys.clone();
    snapshot.push(i32(9));
    others.push(x); // a different collection
    x = (x + i32(10));
  });
  assert(total == i32(6), "body ran twice");
  assert((xs(usize(0)) == i32(11)) && (others.len() == usize(2)), "element writes and the other collection's growth");
  bag := Bag(items : others, version : i32(0));
  mut(seen) := i32(0);
  for(&mut xs, x => {
    seen = (seen + bag.total());
    for(&mut names, n => {
      n.push_str("!");
    });
  });
  assert((seen == i32(6)) && (names(usize(0)) == "a!!"), "a read-only method on another object iterating itself, and a nested borrowed loop over another collection");
});
comptime_expect_error(
  push_on_borrowed_rejected :: (fn() -> unit)({
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    for(&mut xs, x => {
      xs.push(x);
    });
  })
);
comptime_expect_error(
  pop_on_borrowed_rejected :: (fn() -> unit)({
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    for(&mut xs, x => {
      xs.pop();
    });
  })
);
comptime_expect_error(
  alias_push_rejected :: (fn() -> unit)({
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    ys := xs;
    for(&mut xs, x => {
      ys.push(x);
    });
  })
);
comptime_expect_error(
  closure_call_rejected :: (fn() -> unit)({
    run :: (fn(xs : &mut ArrayList(i32), f : &Impl(Fn() -> unit)) -> unit)({
      for(&mut xs, x => {
        f(); // unknown effects
      });
    });
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    run(&mut xs, () => ());
  })
);
