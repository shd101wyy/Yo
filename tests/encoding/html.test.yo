{ assert } :: import("std/assert");
{ rune, String } :: import("std/string");
html :: import("std/encoding/html");
{ from_code_point, is_valid_entity_code } :: import("std/encoding/html");
test("named entities decode", {
  assert(html.decode(String.from("a &amp; b")) == `a & b`, "amp");
  assert(html.decode(String.from("&lt;p&gt;")) == `<p>`, "lt/gt");
  assert(html.decode(String.from("&quot;x&quot;")) == `"x"`, "quot");
});
test("entities from the static table decode", {
  assert(html.decode(String.from("&forall;x")) == `∀x`, "forall (was mangled to `generic` in the old table)");
  assert(html.decode(String.from("&AElig;")) == `Æ`, "first table entry");
  assert(html.decode(String.from("&zwnj;")) == from_code_point(i32(8204)), "last table entry");
  assert(
    html.decode(String.from("&NotEqualTilde;")) == (from_code_point(i32(8770)) + from_code_point(i32(824))),
    "two-code-point entity"
  );
});
test("legacy entities decode without semicolon by longest prefix", {
  assert(html.decode(String.from("&amp!")) == `&!`, "legacy amp, no semicolon");
  assert(html.decode(String.from("&notin")) == `¬in`, "notin is not legacy; not is - longest legacy prefix wins");
  assert(html.decode(String.from("&bogus")) == `&bogus`, "unknown name with no legacy prefix stays literal");
});
test("decimal numeric entities decode", {
  assert(html.decode(String.from("&#65;")) == `A`, "decimal with semicolon");
  assert(html.decode(String.from("&#65&#66;")) == `AB`, "unterminated decimal still decodes");
  assert(html.decode(String.from("x&#65Zy")) == `xAZy`, "decimal terminated by non-digit");
});
test("hex numeric entities decode", {
  assert(html.decode(String.from("&#x41;")) == `A`, "hex with semicolon");
  assert(html.decode(String.from("&#X41;")) == `A`, "capital X form");
  assert(html.decode(String.from("x&#x41Zy")) == `xAZy`, "hex terminated by non-digit");
  assert(html.decode(String.from("&#x1F600;")) == `😀`, "supplementary-plane hex");
});
test("digits running to end of input decode", {
  assert(html.decode(String.from("&#65")) == `A`, "decimal at EOF");
  assert(html.decode(String.from("&#x41")) == `A`, "hex at EOF");
});
test("malformed numeric entities stay literal", {
  assert(html.decode(String.from("&#x;")) == `&#x;`, "hex marker with no digits");
  assert(html.decode(String.from("&#;")) == `&#;`, "no digits at all");
  assert(html.decode(String.from("a & b")) == `a & b`, "bare ampersand passes through");
  assert(html.decode(String.from("&")) == `&`, "trailing ampersand");
  assert(html.decode(String.from("&#")) == `&#`, "trailing numeric marker");
});
test("invalid code points keep the original entity text", {
  assert(html.decode(String.from("&#xD800;")) == `&#xD800;`, "surrogate kept literal");
});
test("is_valid_entity_code rejects negative code points", {
  // A negative is not a code point at all. The predicate is EXPORTED, so a
  // caller validating its own input is the case that matters -- independent of
  // whether `decode` happens to contain the damage.
  //
  // -1 and -2 were already rejected, but only by ACCIDENT: the noncharacter arm
  // masks with 0xFFFF, which catches exactly those two. Every other negative
  // fell through to `true`. Both are asserted so the accidental path cannot be
  // mistaken for coverage of the real one.
  assert(!html.is_valid_entity_code(i32(-65536)), "-65536 is not a code point");
  assert(!html.is_valid_entity_code(i32(-1)), "-1 is not a code point");
  assert(!html.is_valid_entity_code(i32(-2)), "-2 is not a code point");
  assert(!html.is_valid_entity_code(i32(-1114112)), "-0x110000 is not a code point");
  // The valid neighbours still answer true, so the new first arm cannot be
  // rejecting everything.
  assert(html.is_valid_entity_code(i32(65)), "U+0041 is valid");
  // U+10FFFD, NOT U+10FFFF: the last two code points of every plane are
  // Unicode NONCHARACTERS, so `0x10FFFF & 0xFFFF == 0xFFFF` is correctly
  // rejected by the noncharacter arm. Picking the true maximum as the
  // "largest valid" case asserts the wrong thing.
  assert(html.is_valid_entity_code(i32(1114109)), "U+10FFFD is valid");
  assert(!html.is_valid_entity_code(i32(1114111)), "U+10FFFF is a noncharacter");
  assert(!html.is_valid_entity_code(i32(1114112)), "U+110000 is out of range");
});
test("an over-long numeric reference saturates instead of wrapping", {
  // `&#xFFFF0000;` is 8 hex digits: accumulating it into an i32 overflowed --
  // undefined behaviour in C -- and wrapped to -65536, which the unguarded
  // predicate then called VALID. The parsers now stop accumulating once past
  // U+10FFFF, so the value stays above the range and is rejected for the right
  // reason.
  //
  // The expected output is the module's own tested policy for an invalid code
  // point, asserted directly above this: keep the original entity text. Before
  // the fix this case produced U+FFFD instead -- which is what WHATWG
  // prescribes, but this module deliberately does not follow WHATWG here, so
  // the old output was luck rather than conformance and was INCONSISTENT with
  // the surrogate case beside it.
  assert(html.decode(String.from("&#xFFFF0000;")) == `&#xFFFF0000;`, "over-long hex kept literal");
  assert(html.decode(String.from("&#x110000;")) == `&#x110000;`, "just past U+10FFFF kept literal");
  assert(html.decode(String.from("&#99999999999;")) == `&#99999999999;`, "over-long decimal kept literal");
  // Values that still fit are unaffected by the saturation guard.
  assert(html.decode(String.from("&#x10FFFD;")) == from_code_point(i32(1114109)), "U+10FFFD still decodes");
  assert(html.decode(String.from("&#65;")) == `A`, "short decimal still decodes");
  assert(html.decode(String.from("&#x41;")) == `A`, "short hex still decodes");
});
// D4 (plans/archive/STD_API_AUDIT_D4_PLAN.md §5.2 S1). Every test above puts multibyte
// content only in the DECODER'S OUTPUT; the INPUT is pure ASCII, so the
// scanner's rune arithmetic is never exercised. `html.decode` is the
// highest-risk file in the tree for the byte flip — it scans arbitrary HTML by
// index — so these run multibyte text through the scanner itself, on both
// sides of every entity form and in every backtracking arm.
test("entities decode with multibyte text around them", {
  assert(html.decode(String.from("中文 &amp; 日本語")) == `中文 & 日本語`, "named, CJK on both sides");
  assert(html.decode(String.from("é&lt;é&gt;é")) == `é<é>é`, "2-byte runes between entities");
  assert(html.decode(String.from("𝄞&#65;𝄞")) == `𝄞A𝄞`, "decimal between 4-byte runes");
  assert(html.decode(String.from("𝄞&#x41;𝄞")) == `𝄞A𝄞`, "hex between 4-byte runes");
  assert(html.decode(String.from("aé中𝄞&amp;aé中𝄞")) == `aé中𝄞&aé中𝄞`, "all four widths");
  assert(html.decode(String.from("😀&#x1F600;😀")) == `😀😀😀`, "astral in and out");
  assert(html.decode(String.from("é&#x4E2D;é")) == `é中é`, "hex naming a 3-byte rune");
});
test("the legacy backtracking arm survives multibyte input", {
  // `&notin` decodes as `not` + `in`; the walk-back over `try_end` is the
  // rune-indexed loop that a byte basis would break.
  assert(html.decode(String.from("中&notin中")) == `中¬in中`, "longest legacy prefix, CJK around it");
  assert(html.decode(String.from("é&bogus;é")) == `é&bogus;é`, "unknown named entity stays literal");
  assert(html.decode(String.from("中&amp!中")) == `中&!中`, "legacy amp with no semicolon");
});
test("invalid code points keep their original text with multibyte around them", {
  // The `keep original entity text` arm re-slices the INPUT between two
  // scanner positions — the one place a wrong basis would corrupt bytes it
  // never decoded.
  assert(html.decode(String.from("𝄞&#xD800;𝄞")) == `𝄞&#xD800;𝄞`, "surrogate kept, astral around it");
  assert(html.decode(String.from("中&#xDFFF;中")) == `中&#xDFFF;中`, "high surrogate kept");
});
test("truncated entities at the end of multibyte input", {
  assert(html.decode(String.from("é&")) == `é&`, "trailing ampersand after a 2-byte rune");
  assert(html.decode(String.from("中&#")) == `中&#`, "trailing numeric marker");
  assert(html.decode(String.from("𝄞&#x")) == `𝄞&#x`, "trailing hex marker");
  assert(html.decode(String.from("aé中𝄞")) == `aé中𝄞`, "no entity at all is returned unchanged");
});

test("html.encode escapes the five XSS-critical characters and nothing else", {
  assert(html.encode(`<a href="x">&'s</a>`.to_string()) == `&lt;a href=&quot;x&quot;&gt;&amp;&#39;s&lt;/a&gt;`, "all five escaped");
  plain := `héllo 你好 plain-text_09.~`.to_string();
  assert(html.encode(plain.clone()) == plain, "multibyte and unreserved pass through");
  // The deprecated `html_encode` alias (removed in v0.2.32) still delegates.
  assert(html.html_encode(plain.clone()) == plain, "html_encode alias delegates to html.encode");
});
test("html.decode(html.encode(s)) is the identity", {
  s := `<script>alert("x & 'y' < z >")</script> é你`.to_string();
  assert(html.decode(html.encode(s.clone())) == s, "round trip");
});
test("html.decode is a single pass: a 20k-entity document decodes promptly and in order", {
  // plans/STD_API_STABILIZATION.md §3 item 14: `result` was rebuilt through a
  // template string per character, so a document this size was O(n²) —
  // hundreds of billions of byte copies — and never finished.
  (src : String) = String.with_capacity(usize(400000));
  (i : usize) = usize(0);
  while(i < usize(20000), i = (i + usize(1)), {
    _a := src.push_str("x&amp;y&#60;&#x3E;é ");
  });
  out := html.decode(src);
  unit_len := `x&y<>é `.to_string().len();
  assert(out.len() == (usize(20000) * unit_len), "every entity decoded, nothing dropped");
  assert(out.starts_with(`x&y<>é x&y<>é `), "decoded in order");
  assert(out.ends_with(`x&y<>é `), "to the end");
});
