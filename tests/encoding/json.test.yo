open(import("std/string"));
{ json_parse, json_stringify, JsonValue, JsonError } :: import("std/encoding/json");
{ ArrayList } :: import("std/collections/array_list");
{ Error, AnyError, Exception } :: import("std/error");
// ===== Parse Primitives =====
test("json_parse null", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("null");
  is_null := match(v,.Null => true, _ => false);
  assert(is_null, "should be Null");
});
test("json_parse true", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("true");
  assert(v.as_bool().unwrap() == true, "should be true");
});
test("json_parse false", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("false");
  assert(v.as_bool().unwrap() == false, "should be false");
});
test("json_parse integer", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("42");
  assert(v.as_number().unwrap() == f64(42), "should be 42");
});
test("json_parse negative number", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("-17");
  assert(v.as_number().unwrap() == f64(-(17)), "should be -17");
});
test("json_parse float", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("3.14");
  n := v.as_number().unwrap();
  assert((n > f64(3.139)) && (n < f64(3.141)), "should be approximately 3.14");
});
test("json_parse string", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("\"hello\"");
  assert(v.as_string().unwrap().as_str() == "hello", "should be hello");
});
test("json_parse string with escapes", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("\"line1\\nline2\"");
  s := v.as_string().unwrap();
  bytes := s.as_bytes();
  assert(bytes.len() == usize(11), "escaped string should have 11 bytes");
  assert(bytes.get(usize(5)).unwrap() == u8(10), "byte 5 should be newline");
});
test("json_parse empty string", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("\"\"");
  assert(v.as_string().unwrap().as_str() == "", "should be empty string");
});
// ===== Parse Arrays =====
test("json_parse empty array", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("[]");
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(0), "empty array should have 0 elements");
});
test("json_parse array of numbers", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("[1, 2, 3]");
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(3), "should have 3 elements");
  assert(arr.get(usize(0)).unwrap().as_number().unwrap() == f64(1), "element 0");
  assert(arr.get(usize(1)).unwrap().as_number().unwrap() == f64(2), "element 1");
  assert(arr.get(usize(2)).unwrap().as_number().unwrap() == f64(3), "element 2");
});
test("json_parse mixed array", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("[1, \"two\", true, null]");
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(4), "should have 4 elements");
  assert(arr.get(usize(0)).unwrap().as_number().unwrap() == f64(1), "element 0 is 1");
  assert(arr.get(usize(1)).unwrap().as_string().unwrap().as_str() == "two", "element 1 is two");
  assert(arr.get(usize(2)).unwrap().as_bool().unwrap() == true, "element 2 is true");
  is_null := match(arr.get(usize(3)).unwrap(),.Null => true, _ => false);
  assert(is_null, "element 3 is null");
});
// ===== Parse Objects =====
test("json_parse empty object", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("{}");
  entries := v.as_object().unwrap();
  assert(entries.len() == usize(0), "empty object should have 0 entries");
});
test("json_parse simple object", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("{\"name\": \"test\", \"value\": 42}");
  name := v.get(String.from("name"));
  assert(name.is_some(), "should have name key");
  assert(name.unwrap().as_string().unwrap().as_str() == "test", "name should be test");
  value := v.get(String.from("value"));
  assert(value.is_some(), "should have value key");
  assert(value.unwrap().as_number().unwrap() == f64(42), "value should be 42");
});
test("json_parse nested object", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("{\"outer\": {\"inner\": 99}}");
  outer := v.get(String.from("outer")).unwrap();
  inner := outer.get(String.from("inner")).unwrap();
  assert(inner.as_number().unwrap() == f64(99), "inner value should be 99");
});
test("json_parse nested array in object", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("{\"items\": [10, 20, 30]}");
  items := v.get(String.from("items")).unwrap().as_array().unwrap();
  assert(items.len() == usize(3), "items array should have 3 elements");
  assert(items.get(usize(1)).unwrap().as_number().unwrap() == f64(20), "second item should be 20");
});
// ===== Parse Whitespace =====
test("json_parse with whitespace", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  v := json_parse("  {  \"key\"  :  \"value\"  }  ");
  assert(v.get(String.from("key")).unwrap().as_string().unwrap().as_str() == "value", "should parse correctly with whitespace");
});
// ===== Parse Errors =====
test("json_parse empty input", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        escape(());
      }
    )
  );
  json_parse("");
  assert(false, "empty input should throw");
});
test("json_parse unclosed string error", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        escape(());
      }
    )
  );
  json_parse("\"hello");
  assert(false, "unclosed string should throw");
});
// ===== Stringify =====
test("json_stringify null", {
  result := json_stringify(.Null);
  assert(result.as_str() == "null", "null should stringify to null");
});
test("json_stringify true", {
  result := json_stringify(.Bool(true));
  assert(result.as_str() == "true", "true should stringify to true");
});
test("json_stringify false", {
  result := json_stringify(.Bool(false));
  assert(result.as_str() == "false", "false should stringify to false");
});
test("json_stringify number", {
  result := json_stringify(.Number(f64(42)));
  assert(result.as_str() == "42", "42 should stringify to 42");
});
test("json_stringify string", {
  result := json_stringify(.Str(String.from("hello")));
  assert(result.as_str() == "\"hello\"", "hello should be quoted");
});
test("json_stringify empty array", {
  items := ArrayList(JsonValue).new();
  result := json_stringify(.Array(items));
  assert(result.as_str() == "[]", "empty array should stringify to []");
});
test("json_stringify array", {
  items := ArrayList(JsonValue).new();
  items.push(.Number(f64(1)));
  items.push(.Number(f64(2)));
  items.push(.Number(f64(3)));
  result := json_stringify(.Array(items));
  assert(result.as_str() == "[1,2,3]", "should stringify array");
});
test("json_stringify empty object", {
  keys := ArrayList(String).new();
  vals := ArrayList(JsonValue).new();
  result := json_stringify(.Object(keys, vals));
  assert(result.as_str() == "{}", "empty object should stringify to {}");
});
test("json_stringify object", {
  keys := ArrayList(String).new();
  vals := ArrayList(JsonValue).new();
  keys.push(String.from("a"));
  vals.push(.Number(f64(1)));
  keys.push(String.from("b"));
  vals.push(.Bool(true));
  result := json_stringify(.Object(keys, vals));
  assert(result.as_str() == "{\"a\":1,\"b\":true}", "should stringify object");
});
// ===== Roundtrip =====
test("json roundtrip simple object", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  input := "{\"name\":\"test\",\"value\":42}";
  parsed := json_parse(input);
  output := json_stringify(parsed);
  assert(output.as_str() == input, "roundtrip should preserve simple object");
});
test("json roundtrip nested", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  input := "{\"a\":[1,2,3],\"b\":{\"c\":true}}";
  parsed := json_parse(input);
  output := json_stringify(parsed);
  assert(output.as_str() == input, "roundtrip should preserve nested structure");
});
test("json roundtrip booleans and null", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  input := "[true,false,null]";
  parsed := json_parse(input);
  output := json_stringify(parsed);
  assert(output.as_str() == input, "roundtrip should preserve booleans and null");
});
// ===== JsonValue Methods =====
test("JsonValue.get missing key", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  result := json_parse("{\"a\": 1}");
  assert(result.get(String.from("b")).is_none(), "missing key should return None");
});
test("JsonValue.get on non-object", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  result := json_parse("42");
  assert(result.get(String.from("a")).is_none(), "get on number should return None");
});
test("JsonValue.at valid index", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  result := json_parse("[10, 20, 30]");
  assert(result.at(usize(1)).unwrap().as_number().unwrap() == f64(20), "at(1) should be 20");
});
test("JsonValue.at on non-array", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        escape(());
      }
    )
  );
  result := json_parse("42");
  assert(result.at(usize(0)).is_none(), "at on number should return None");
});
