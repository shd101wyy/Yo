});
test("JsonValue.get on non-object", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  result := json_parse("42", exn);
  assert(result.get(String.from("a")).is_none(), "get on number should return None");
