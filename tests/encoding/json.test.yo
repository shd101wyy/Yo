        unwind(());
      }
    )
  );
  v := json_parse("{}", exn);
  entries := v.as_object().unwrap();
  assert(entries.len() == usize(0), "empty object should have 0 entries");
});
test("json_parse simple object", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("{\"name\": \"test\", \"value\": 42}", exn);
  name := v.get(String.from("name"));
  assert(name.is_some(), "should have name key");
  assert(name.unwrap().as_string().unwrap() == "test", "name should be test");
  value := v.get(String.from("value"));
  assert(value.is_some(), "should have value key");
  assert(value.unwrap().as_number().unwrap() == f64(42), "value should be 42");
});
test("json_parse nested object", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("{\"outer\": {\"inner\": 99}}", exn);
  outer := v(String.from("outer"));
  inner := outer(String.from("inner"));
  assert(inner.as_number().unwrap() == f64(99), "inner value should be 99");
});
test("json_parse nested array in object", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("{\"items\": [10, 20, 30]}", exn);
  items := v(String.from("items")).as_array().unwrap();
  assert(items.len() == usize(3), "items array should have 3 elements");
  assert(items(usize(1)).as_number().unwrap() == f64(20), "second item should be 20");
});
