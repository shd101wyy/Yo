{ assert } :: import("std/assert");
open(import("std/string"));
{ json_parse, json_stringify, JsonValue, JsonError } :: import("std/encoding/json");
{ ArrayList } :: import("std/collections/array_list");
{ Error, AnyError, Exception } :: import("std/error");
// ===== Parse Primitives =====
test("json_parse null", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("null", exn);
  is_null := match(v,.Null => true, _ => false);
  assert(is_null, "should be Null");
});
test("json_parse true", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("true", exn);
  assert(v.as_bool().unwrap() == true, "should be true");
});
test("json_parse false", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("false", exn);
  assert(v.as_bool().unwrap() == false, "should be false");
});
test("json_parse integer", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("42", exn);
  assert(v.as_number().unwrap() == f64(42), "should be 42");
});
test("json_parse negative number", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("-17", exn);
  assert(v.as_number().unwrap() == f64(-(17)), "should be -17");
});
test("json_parse float", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("3.14", exn);
  n := v.as_number().unwrap();
  assert((n > f64(3.139)) && (n < f64(3.141)), "should be approximately 3.14");
});
test("json_parse string", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("\"hello\"", exn);
  assert(v.as_string().unwrap() == "hello", "should be hello");
});
test("json_parse string with escapes", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("\"line1\\nline2\"", exn);
  s := v.as_string().unwrap();
  bytes := s.as_bytes();
  assert(bytes.len() == usize(11), "escaped string should have 11 bytes");
  assert(bytes(usize(5)) == u8(10), "byte 5 should be newline");
});
test("json_parse empty string", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("\"\"", exn);
  assert(v.as_string().unwrap() == "", "should be empty string");
});
// ===== Parse Arrays =====
test("json_parse empty array", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("[]", exn);
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(0), "empty array should have 0 elements");
});
test("json_parse array of numbers", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("[1, 2, 3]", exn);
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(3), "should have 3 elements");
  assert(arr(usize(0)).as_number().unwrap() == f64(1), "element 0");
  assert(arr(usize(1)).as_number().unwrap() == f64(2), "element 1");
  assert(arr(usize(2)).as_number().unwrap() == f64(3), "element 2");
});
test("json_parse mixed array", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("[1, \"two\", true, null]", exn);
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(4), "should have 4 elements");
  assert(arr(usize(0)).as_number().unwrap() == f64(1), "element 0 is 1");
  assert(arr(usize(1)).as_string().unwrap() == "two", "element 1 is two");
  assert(arr(usize(2)).as_bool().unwrap() == true, "element 2 is true");
  is_null := match(arr(usize(3)),.Null => true, _ => false);
  assert(is_null, "element 3 is null");
});
// ===== Parse Objects =====
test("json_parse empty object", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("{}", exn);
  entries := v.as_object().unwrap();
  assert(entries.len() == usize(0), "empty object should have 0 entries");
});
test("json_parse simple object", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("{\"name\": \"test\", \"value\": 42}", exn);
  name := v.get(String.from("name"));
  assert(name.is_some(), "should have name key");
  assert(name.unwrap().as_string().unwrap() == "test", "name should be test");
  value := v.get(String.from("value"));
  assert(value.is_some(), "should have value key");
  assert(value.unwrap().as_number().unwrap() == f64(42), "value should be 42");
});
test("json_parse nested object", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("{\"outer\": {\"inner\": 99}}", exn);
  outer := v(String.from("outer"));
  inner := outer(String.from("inner"));
  assert(inner.as_number().unwrap() == f64(99), "inner value should be 99");
});
test("json_parse nested array in object", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("{\"items\": [10, 20, 30]}", exn);
  items := v(String.from("items")).as_array().unwrap();
  assert(items.len() == usize(3), "items array should have 3 elements");
  assert(items(usize(1)).as_number().unwrap() == f64(20), "second item should be 20");
});
// ===== Parse Whitespace =====
test("json_parse with whitespace", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("  {  \"key\"  :  \"value\"  }  ", exn);
  assert(v(String.from("key")).as_string().unwrap() == "value", "should parse correctly with whitespace");
});
// ===== Parse Errors =====
test("json_parse empty input", {
  exn := Exception(
    throw : (
      (err) -> {
        unwind(());
      }
    )
  );
  json_parse("", exn);
  assert(false, "empty input should throw");
});
test("json_parse unclosed string error", {
  exn := Exception(
    throw : (
      (err) -> {
        unwind(());
      }
    )
  );
  json_parse("\"hello", exn);
  assert(false, "unclosed string should throw");
});
// ===== Stringify =====
test("json_stringify null", {
  result := json_stringify(.Null);
  assert(result == "null", "null should stringify to null");
});
test("json_stringify true", {
  result := json_stringify(.Bool(true));
  assert(result == "true", "true should stringify to true");
});
test("json_stringify false", {
  result := json_stringify(.Bool(false));
  assert(result == "false", "false should stringify to false");
});
test("json_stringify number", {
  result := json_stringify(.Number(f64(42)));
  assert(result == "42", "42 should stringify to 42");
});
test("json_stringify string", {
  result := json_stringify(.Str(String.from("hello")));
  assert(result == "\"hello\"", "hello should be quoted");
});
test("json_stringify empty array", {
  items := ArrayList(JsonValue).new();
  result := json_stringify(.Array(items));
  assert(result == "[]", "empty array should stringify to []");
});
test("json_stringify array", {
  items := ArrayList(JsonValue).new();
  items.push(.Number(f64(1)));
  items.push(.Number(f64(2)));
  items.push(.Number(f64(3)));
  result := json_stringify(.Array(items));
  assert(result == "[1,2,3]", "should stringify array");
});
test("json_stringify empty object", {
  keys := ArrayList(String).new();
  vals := ArrayList(JsonValue).new();
  result := json_stringify(.Object(keys, vals));
  assert(result == "{}", "empty object should stringify to {}");
});
test("json_stringify object", {
  keys := ArrayList(String).new();
  vals := ArrayList(JsonValue).new();
  keys.push(String.from("a"));
  vals.push(.Number(f64(1)));
  keys.push(String.from("b"));
  vals.push(.Bool(true));
  result := json_stringify(.Object(keys, vals));
  assert(result == "{\"a\":1,\"b\":true}", "should stringify object");
});
// ===== Roundtrip =====
test("json roundtrip simple object", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  input := "{\"name\":\"test\",\"value\":42}";
  parsed := json_parse(input, exn);
  output := json_stringify(parsed);
  assert(output == input, "roundtrip should preserve simple object");
});
test("json roundtrip nested", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  input := "{\"a\":[1,2,3],\"b\":{\"c\":true}}";
  parsed := json_parse(input, exn);
  output := json_stringify(parsed);
  assert(output == input, "roundtrip should preserve nested structure");
});
test("json roundtrip booleans and null", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  input := "[true,false,null]";
  parsed := json_parse(input, exn);
  output := json_stringify(parsed);
  assert(output == input, "roundtrip should preserve booleans and null");
});
// ===== JsonValue Methods =====
test("JsonValue.get missing key", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  result := json_parse("{\"a\": 1}", exn);
  assert(result.get(String.from("b")).is_none(), "missing key should return None");
});
test("JsonValue.get on non-object", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  result := json_parse("42", exn);
  assert(result.get(String.from("a")).is_none(), "get on number should return None");
});
test("JsonValue.at valid index", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  result := json_parse("[10, 20, 30]", exn);
  assert(result.at(usize(1)).unwrap().as_number().unwrap() == f64(20), "at(1) should be 20");
});
test("JsonValue.at on non-array", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  result := json_parse("42", exn);
  assert(result.at(usize(0)).is_none(), "at on number should return None");
});
