{ assert } :: import("std/assert");
open(import("std/string"));
{ json_parse, json_stringify, JsonValue, JsonError, ToJson, FromJson, json_encode, json_decode, json_parse_result } :: import("std/encoding/json");
{ HashMap } :: import("std/collections/hash_map");
{ ArrayList } :: import("std/collections/array_list");
{ Error, AnyError, Exception } :: import("std/error");
// ===== Parse Primitives =====
test("json_parse null", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("null", exn);
  is_null := match(v, .Null => true, _ => false);
  assert(is_null, "should be Null");
});
test("json_parse true", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("true", exn);
  assert(v.as_bool().unwrap() == true, "should be true");
});
test("json_parse false", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("false", exn);
  assert(v.as_bool().unwrap() == false, "should be false");
});
test("json_parse integer", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("42", exn);
  assert(v.as_number().unwrap() == f64(42), "should be 42");
});
test("json_parse negative number", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("-17", exn);
  assert(v.as_number().unwrap() == f64(-17), "should be -17");
});
test("json_parse float", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("3.14", exn);
  n := v.as_number().unwrap();
  assert((n > f64(3.139)) && (n < f64(3.141)), "should be approximately 3.14");
});
test("json_parse string", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("\"hello\"", exn);
  assert(v.as_string().unwrap() == "hello", "should be hello");
});
test("json_parse string with escapes", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("\"line1\\nline2\"", exn);
  s := v.as_string().unwrap();
  bytes := s.as_bytes();
  assert(bytes.len() == usize(11), "escaped string should have 11 bytes");
  assert(bytes(usize(5)) == u8(10), "byte 5 should be newline");
});
test("json_parse unicode escape BMP", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  // \u0041 = 'A' (1-byte UTF-8), \u00e9 = 'é' (2-byte), \u4e2d = '中' (3-byte).
  v := json_parse("\"\\u0041 \\u00e9 \\u4e2d\"", exn);
  s := v.as_string().unwrap();
  bytes := s.as_bytes();
  assert(bytes.len() == usize(8), "A + sp + 2-byte + sp + 3-byte = 8 bytes");
  assert(bytes(usize(0)) == u8(65), "first byte should be 'A'");
  assert(bytes(usize(2)) == u8(0xC3), "é lead byte");
  assert(bytes(usize(3)) == u8(0xA9), "é continuation byte");
  assert(bytes(usize(5)) == u8(0xE4), "中 lead byte");
  assert(bytes(usize(6)) == u8(0xB8), "中 continuation byte 1");
  assert(bytes(usize(7)) == u8(0xAD), "中 continuation byte 2");
});
test("json_parse unicode escape surrogate pair", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  // \ud83d\ude00 = U+1F600 (😀), 4-byte UTF-8 F0 9F 98 80.
  v := json_parse("\"\\ud83d\\ude00\"", exn);
  bytes := v.as_string().unwrap().as_bytes();
  assert(bytes.len() == usize(4), "one astral code point = 4 bytes");
  assert(bytes(usize(0)) == u8(0xF0), "byte 0");
  assert(bytes(usize(1)) == u8(0x9F), "byte 1");
  assert(bytes(usize(2)) == u8(0x98), "byte 2");
  assert(bytes(usize(3)) == u8(0x80), "byte 3");
});
test("json_parse lone high surrogate error", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  json_parse("\"\\ud83d\"", exn);
  assert(false, "lone high surrogate should throw");
});
test("json_parse lone low surrogate error", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  json_parse("\"\\udc00 tail\"", exn);
  assert(false, "lone low surrogate should throw");
});
test("json_parse invalid unicode escape hex error", {
  exn := Exception(
    throw : (
      err -> {
        unwind(());
      }
    )
  );
  json_parse("\"\\uZZZZ\"", exn);
  assert(false, "non-hex \\u escape should throw");
});
test("json_parse empty string", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("\"\"", exn);
  assert(v.as_string().unwrap() == "", "should be empty string");
});
// ===== Parse Arrays =====
test("json_parse empty array", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("[]", exn);
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(0), "empty array should have 0 elements");
});
test("json_parse array of numbers", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("[1, 2, 3]", exn);
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(3), "should have 3 elements");
  assert(arr(usize(0)).as_number().unwrap() == f64(1), "element 0");
  assert(arr(usize(1)).as_number().unwrap() == f64(2), "element 1");
  assert(arr(usize(2)).as_number().unwrap() == f64(3), "element 2");
});
test("json_parse mixed array", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  v := json_parse("[1, \"two\", true, null]", exn);
  arr := v.as_array().unwrap();
  assert(arr.len() == usize(4), "should have 4 elements");
  assert(arr(usize(0)).as_number().unwrap() == f64(1), "element 0 is 1");
  assert(arr(usize(1)).as_string().unwrap() == "two", "element 1 is two");
  assert(arr(usize(2)).as_bool().unwrap() == true, "element 2 is true");
  is_null := match(arr(usize(3)), .Null => true, _ => false);
  assert(is_null, "element 3 is null");
});
// ===== Parse Objects =====
test("json_parse empty object", {
  exn := Exception(
    throw : (
      err -> {
