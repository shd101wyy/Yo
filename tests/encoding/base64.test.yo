open(import("std/string"));
open(import("std/encoding/base64"));
{ ArrayList } :: import("std/collections/array_list");
{ Error, AnyError, Exception } :: import("std/error");
// ===== Encoding Tests =====
test("base64_encode empty input", {
  data := ArrayList(u8).new();
  result := base64_encode(data);
  assert(result == "", "empty input should produce empty string");
});
test("base64_encode Hello", {
  data := ArrayList(u8).new();
  data.push(u8(72));
  data.push(u8(101));
  data.push(u8(108));
  data.push(u8(108));
  data.push(u8(111));
  result := base64_encode(data);
  assert(result == "SGVsbG8=", "Hello should encode to SGVsbG8=");
});
test("base64_encode single byte", {
  data := ArrayList(u8).new();
  data.push(u8(65));
  result := base64_encode(data);
  assert(result == "QQ==", "A should encode to QQ==");
});
test("base64_encode two bytes", {
  data := ArrayList(u8).new();
  data.push(u8(65));
  data.push(u8(66));
  result := base64_encode(data);
  assert(result == "QUI=", "AB should encode to QUI=");
});
test("base64_encode three bytes no padding", {
  data := ArrayList(u8).new();
  data.push(u8(65));
  data.push(u8(66));
  data.push(u8(67));
  result := base64_encode(data);
  assert(result == "QUJD", "ABC should encode to QUJD with no padding");
});
test("base64_encode Man", {
  // "Man" -> "TWFu"
  data := ArrayList(u8).new();
  data.push(u8(77));
  data.push(u8(97));
  data.push(u8(110));
  result := base64_encode(data);
  assert(result == "TWFu", "Man should encode to TWFu");
});
// ===== URL-safe Encoding =====
test("base64_encode_url no padding", {
  data := ArrayList(u8).new();
  data.push(u8(65));
  result := base64_encode_url(data);
  // URL-safe should not have padding
  assert(result == "QQ", "URL-safe single byte should not have padding");
});
// ===== Decoding Tests =====
test("base64_decode empty string", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  bytes := base64_decode("", exn);
  assert(bytes.len() == usize(0), "empty string should decode to 0 bytes");
});
test("base64_decode Hello", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  bytes := base64_decode("SGVsbG8=", exn);
  assert(bytes.len() == usize(5), "SGVsbG8= should decode to 5 bytes");
  assert(bytes(usize(0)) == u8(72), "byte 0 = H");
  assert(bytes(usize(1)) == u8(101), "byte 1 = e");
  assert(bytes(usize(2)) == u8(108), "byte 2 = l");
  assert(bytes(usize(3)) == u8(108), "byte 3 = l");
  assert(bytes(usize(4)) == u8(111), "byte 4 = o");
});
test("base64_decode no padding", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  bytes := base64_decode("TWFu", exn);
  assert(bytes.len() == usize(3), "TWFu should decode to 3 bytes");
  assert(bytes(usize(0)) == u8(77), "byte 0 = M");
  assert(bytes(usize(1)) == u8(97), "byte 1 = a");
  assert(bytes(usize(2)) == u8(110), "byte 2 = n");
});
test("base64_decode invalid character error", {
  exn := Exception(
    throw : (
      (err) -> {
        unwind(());
      }
    )
  );
  base64_decode("!!!!", exn);
  assert(false, "invalid chars should have thrown");
});
// ===== Roundtrip Tests =====
test("base64 roundtrip", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  data := ArrayList(u8).new();
  i := u8(0);
  while(i < u8(255), i = (i + u8(1)), {
    data.push(i);
  });
  data.push(u8(255));
  encoded := base64_encode(data);
  decoded := base64_decode(encoded.as_str(), exn);
  assert(decoded.len() == usize(256), "roundtrip should preserve length");
  j := usize(0);
  while(j < usize(256), j = (j + usize(1)), {
    assert(decoded(j) == u8(j), "roundtrip byte mismatch");
  });
});
test("base64 url roundtrip", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  data := ArrayList(u8).new();
  data.push(u8(0xFB));
  data.push(u8(0xFF));
  data.push(u8(0xFE));
  encoded := base64_encode_url(data);
  decoded := base64_decode_url(encoded.as_str(), exn);
  assert(decoded.len() == usize(3), "url roundtrip should preserve length");
  assert(decoded(usize(0)) == u8(0xFB), "url roundtrip byte 0");
  assert(decoded(usize(1)) == u8(0xFF), "url roundtrip byte 1");
  assert(decoded(usize(2)) == u8(0xFE), "url roundtrip byte 2");
});
// ===== String-level API Tests =====
test("encode_string empty", {
  result := base64_encode_string(String.new());
  assert(result == "", "empty string should encode to empty");
});
test("encode_string f to Zg==", {
  result := base64_encode_string(`f`);
  assert(result == "Zg==", "f should encode to Zg==");
});
test("encode_string fo to Zm8=", {
  result := base64_encode_string(`fo`);
  assert(result == "Zm8=", "fo should encode to Zm8=");
});
test("encode_string foo to Zm9v", {
  result := base64_encode_string(`foo`);
  assert(result == "Zm9v", "foo should encode to Zm9v");
});
test("encode_string foobar to Zm9vYmFy", {
  result := base64_encode_string(`foobar`);
  assert(result == "Zm9vYmFy", "foobar should encode to Zm9vYmFy");
});
test("encode_string Hello, World!", {
  result := base64_encode_string(`Hello, World!`);
  assert(result == "SGVsbG8sIFdvcmxkIQ==", "Hello, World! should encode to SGVsbG8sIFdvcmxkIQ==");
});
test("decode_string empty", {
  result := base64_decode_string(String.new());
  assert(result.is_ok(), "empty string should decode ok");
  assert(result.unwrap() == "", "empty string should decode to empty");
});
test("decode_string Zm9v to foo", {
  result := base64_decode_string(`Zm9v`);
  assert(result.is_ok(), "Zm9v should decode ok");
  assert(result.unwrap() == "foo", "Zm9v should decode to foo");
});
test("decode_string Hello World", {
  result := base64_decode_string(`SGVsbG8sIFdvcmxkIQ==`);
  assert(result.is_ok(), "should decode ok");
  assert(result.unwrap() == "Hello, World!", "should decode to Hello, World!");
});
test("decode_string with whitespace", {
  result := base64_decode_string(`Zm9v YmFy`);
  assert(result.is_ok(), "should decode ok with whitespace");
  assert(result.unwrap() == "foobar", "should decode to foobar ignoring whitespace");
});
test("decode_string invalid characters", {
  result := base64_decode_string(`!!!!`);
  assert(result.is_err(), "invalid characters should return error");
});
