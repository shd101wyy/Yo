open(import("std/string"));
{ utf8_to_utf16, utf16_to_utf8 } :: import("std/encoding/utf16");
{ ArrayList } :: import("std/collections/array_list");
{ Error, AnyError, Exception } :: import("std/error");
// Helper: build a str from raw bytes via ArrayList(u8) -> String -> as_str()
// Since Yo doesn't support \x escapes in string literals, we construct
// multi-byte UTF-8 strings from bytes.
_make_str_2 :: (fn(b0 : u8, b1 : u8) -> String)({
  arr := ArrayList(u8).new();
  arr.push(b0);
  arr.push(b1);
  String.from_bytes(arr)
});
_make_str_3 :: (fn(b0 : u8, b1 : u8, b2 : u8) -> String)({
  arr := ArrayList(u8).new();
  arr.push(b0);
  arr.push(b1);
  arr.push(b2);
  String.from_bytes(arr)
});
_make_str_4 :: (fn(b0 : u8, b1 : u8, b2 : u8, b3 : u8) -> String)({
  arr := ArrayList(u8).new();
  arr.push(b0);
  arr.push(b1);
  arr.push(b2);
  arr.push(b3);
  String.from_bytes(arr)
});
// ===== UTF-8 to UTF-16 =====
test("utf8_to_utf16 empty string", {
  result := utf8_to_utf16("");
  assert(result.len() == usize(0), "empty string should produce 0 code units");
});
test("utf8_to_utf16 ASCII", {
  result := utf8_to_utf16("Hello");
  assert(result.len() == usize(5), "Hello should produce 5 code units");
  assert(result(usize(0)) == u16(72), "H = 72");
  assert(result(usize(1)) == u16(101), "e = 101");
  assert(result(usize(2)) == u16(108), "l = 108");
  assert(result(usize(3)) == u16(108), "l = 108");
  assert(result(usize(4)) == u16(111), "o = 111");
});
test("utf8_to_utf16 two-byte UTF-8", {
  // "é" is U+00E9, encoded as 2 bytes in UTF-8 (0xC3 0xA9), 1 code unit in UTF-16
  s := _make_str_2(u8(0xC3), u8(0xA9));
  result := utf8_to_utf16(s.as_str());
  assert(result.len() == usize(1), "e-acute should produce 1 code unit");
  assert(result(usize(0)) == u16(0xE9), "should be U+00E9");
});
test("utf8_to_utf16 three-byte UTF-8", {
  // "€" is U+20AC, encoded as 3 bytes in UTF-8 (0xE2 0x82 0xAC), 1 code unit in UTF-16
  s := _make_str_3(u8(0xE2), u8(0x82), u8(0xAC));
  result := utf8_to_utf16(s.as_str());
  assert(result.len() == usize(1), "euro sign should produce 1 code unit");
  assert(result(usize(0)) == u16(0x20AC), "should be U+20AC");
});
test("utf8_to_utf16 four-byte UTF-8 surrogate pair", {
  // U+1F600 (grinning face) — 4 bytes in UTF-8, surrogate pair in UTF-16
  s := _make_str_4(u8(0xF0), u8(0x9F), u8(0x98), u8(0x80));
  result := utf8_to_utf16(s.as_str());
  assert(result.len() == usize(2), "emoji should produce 2 code units (surrogate pair)");
  assert(result(usize(0)) == u16(0xD83D), "high surrogate");
  assert(result(usize(1)) == u16(0xDE00), "low surrogate");
});
// ===== UTF-16 to UTF-8 =====
test("utf16_to_utf8 empty", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  data := ArrayList(u16).new();
  result := utf16_to_utf8(data, exn);
  assert(result == "", "should be empty string");
});
test("utf16_to_utf8 ASCII", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  data := ArrayList(u16).new();
  data.push(u16(72));
  data.push(u16(101));
  data.push(u16(108));
  data.push(u16(108));
  data.push(u16(111));
  result := utf16_to_utf8(data, exn);
  assert(result == "Hello", "should be Hello");
});
test("utf16_to_utf8 BMP character", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  // U+20AC = € (euro sign)
  data := ArrayList(u16).new();
  data.push(u16(0x20AC));
  s := utf16_to_utf8(data, exn);
  bytes := s.as_bytes();
  assert(bytes.len() == usize(3), "euro sign should be 3 UTF-8 bytes");
  assert(bytes(usize(0)) == u8(0xE2), "byte 0");
  assert(bytes(usize(1)) == u8(0x82), "byte 1");
  assert(bytes(usize(2)) == u8(0xAC), "byte 2");
});
test("utf16_to_utf8 surrogate pair", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  // U+1F600 as surrogate pair: D83D DE00
  data := ArrayList(u16).new();
  data.push(u16(0xD83D));
  data.push(u16(0xDE00));
  s := utf16_to_utf8(data, exn);
  bytes := s.as_bytes();
  assert(bytes.len() == usize(4), "U+1F600 should be 4 UTF-8 bytes");
  assert(bytes(usize(0)) == u8(0xF0), "byte 0");
  assert(bytes(usize(1)) == u8(0x9F), "byte 1");
  assert(bytes(usize(2)) == u8(0x98), "byte 2");
  assert(bytes(usize(3)) == u8(0x80), "byte 3");
});
// ===== Roundtrip =====
test("utf16 roundtrip ASCII", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  input := "Hello, World!";
  utf16 := utf8_to_utf16(input);
  result := utf16_to_utf8(utf16, exn);
  assert(result == input, "ASCII roundtrip should preserve string");
});
test("utf16 roundtrip two-byte", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  // é = U+00E9 as UTF-8 bytes
  input := _make_str_2(u8(0xC3), u8(0xA9));
  utf16 := utf8_to_utf16(input.as_str());
  result := utf16_to_utf8(utf16, exn);
  assert(result == input, "two-byte roundtrip should preserve string");
});
test("utf16 roundtrip surrogate pair", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  // U+1F600 as UTF-8 bytes
  input := _make_str_4(u8(0xF0), u8(0x9F), u8(0x98), u8(0x80));
  utf16 := utf8_to_utf16(input.as_str());
  result := utf16_to_utf8(utf16, exn);
  bytes := result.as_bytes();
  assert(bytes.len() == usize(4), "roundtrip should preserve length");
  assert(bytes(usize(0)) == u8(0xF0), "roundtrip byte 0");
  assert(bytes(usize(1)) == u8(0x9F), "roundtrip byte 1");
  assert(bytes(usize(2)) == u8(0x98), "roundtrip byte 2");
  assert(bytes(usize(3)) == u8(0x80), "roundtrip byte 3");
});
