pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ String } :: import("std/string");
import("std/libc/stdio.yo");
{ ArrayList } :: import("std/collections/array_list");
test("Test str.from_raw_parts", {
  // Create str from raw pointer to string literal data
  s := str.from_raw_parts((*u8)("hello"), usize(5));
  assert(s.len() == usize(5), "str.from_raw_parts should have length 5");
});
test("Test str.from_raw_parts with zero length", {
  s := str.from_raw_parts((*u8)(""), usize(0));
  assert(s.len() == usize(0), "str.from_raw_parts with zero length should have length 0");
});
test("String.ptr is the privileged raw view", {
  // as_str() was deleted (str is the STATIC string view —
  // plans/archive/SLICE_REWORK.md); ptr() is the pragma-gated replacement,
  // ArrayList.ptr()'s shape: the POINTER result is what the safe-mode gate
  // rejects, so a safe file cannot hold the buffer at all.
  greeting := String.from("hello world");
  match(
    greeting.ptr(),
    .Some(p) => assert((p != (*u8)("")) && (greeting.len() == usize(11)), "an allocated string hands out its buffer"),
    .None => assert(false, "an allocated string has a buffer")
  );
  empty := String.new();
  match(
    empty.ptr(),
    .Some(_) => assert(false, "nothing allocated before the first push"),
    .None => assert(empty.len() == usize(0), "empty len")
  );
  cafe := String.from("caf\u00e9");
  assert(cafe.len() == usize(5), "utf8 byte len");
});
test("split_whitespace discards empty pieces at both ends and between runs", {
  a := `  hello   world  `.split_whitespace();
  assert(a.len() == usize(2), "two words despite the padding");
  assert(a(usize(0)) == `hello`, "first word");
  assert(a(usize(1)) == `world`, "second word");
  b := `one`.split_whitespace();
  assert(b.len() == usize(1), "single word");
  c := `   `.split_whitespace();
  assert(c.len() == usize(0), "all whitespace yields nothing");
  d := ``.split_whitespace();
  assert(d.len() == usize(0), "empty yields nothing");
  e := `a\tb\nc`.split_whitespace();
  assert(e.len() == usize(3), "tab and newline are whitespace too");
});
test("splitn bounds the piece count and the last piece keeps the rest", {
  a := `a,b,c,d`.splitn(usize(2), `,`);
  assert(a.len() == usize(2), "two pieces");
  assert(a(usize(0)) == `a`, "first piece");
  assert(a(usize(1)) == `b,c,d`, "last piece keeps the separators");
  b := `a,b`.splitn(usize(9), `,`);
  assert(b.len() == usize(2), "n larger than the split count");
  c := `abc`.splitn(usize(3), `,`);
  assert(c.len() == usize(1), "no separator yields the whole string");
  d := `a,b`.splitn(usize(0), `,`);
  assert(d.len() == usize(0), "n = 0 yields nothing");
  e := `a,b,c`.splitn(usize(1), `,`);
  assert(e.len() == usize(1), "n = 1 is the whole string");
  assert(e(usize(0)) == `a,b,c`, "and it is unsplit");
});
test("is_ascii and eq_ignore_ascii_case fold only A-Z", {
  assert(`hello`.is_ascii() == true, "plain ascii");
  assert(``.is_ascii() == true, "empty is ascii");
  assert(`héllo`.is_ascii() == false, "non-ascii byte detected");
  assert(`Hello`.eq_ignore_ascii_case(`hELLO`) == true, "case folds");
  assert(`hello`.eq_ignore_ascii_case(`hello`) == true, "identical");
  assert(`hello`.eq_ignore_ascii_case(`world`) == false, "different letters");
  assert(`hello`.eq_ignore_ascii_case(`hell`) == false, "different lengths");
  assert(`_`.eq_ignore_ascii_case(`?`) == false, "non-letters must match exactly");
});
test("truncate shortens by BYTES and ignores a longer length", {
  mut(s) := `hello`;
  s.truncate(usize(99));
  assert(s == `hello`, "longer new_len is a no-op");
  s.truncate(usize(2));
  assert(s == `he`, "truncated to two bytes");
  s.truncate(usize(0));
  assert(s.is_empty() == true, "truncate to zero empties");
});
test("slice_copy takes its receiver by value: the view it returns is static only because the receiver is", {
  // A `self : &Self` receiver let `slice_copy` build a static view from a
  // reference that need not point at static bytes
  // (issues/fixed/2026-11-14-str-slice-copy-builds-a-static-view-from-a-borrowed-receiver.md).
  (f : (fn(s : str, r : &Range(usize)) -> str)) = str.slice_copy;
  (g : (fn(s : str, r : &RangeInclusive(usize)) -> str)) = str.slice_copy_inclusive;
  s := "hello";
  t := f(s, &(usize(1) .. usize(3)));
  u := g(s, &(usize(1) ..= usize(3)));
  assert((t.len() == usize(2)) && (t == "el"), "slice_copy through a by-value fn type");
  assert((u.len() == usize(3)) && (u == "ell"), "slice_copy_inclusive through a by-value fn type");
  assert((s(usize(1) .. usize(4)) == "ell") && (s(usize(0) ..= usize(1)) == "he"), "the range subscripts lower to slice_copy");
  assert(s(usize(3) .. usize(99)) == "lo", "an end past the length is clamped");
});
// A `&str` parameter takes a place of type `str`, as `(x : &T)` takes one of
// `T`; a literal is that place (static bytes), and a `&str` value passed bare
// lends what it refers to. The read intrinsics are declared `(s : &str)`
// (issues/fixed/2026-11-15-a-str-reference-argument-is-e0601-under-the-str-flip.md).
impl(str, byte_count : (fn(self : &Self) -> usize)(__yo_str_len(self)));
_count_bytes :: (fn(s : &str) -> usize)(s.len());
test("a &str parameter takes a literal, a &str binding and a receiver", {
  assert(__yo_str_len("abcd") == usize(4), "a literal into the extern's &str parameter");
  s := "hello";
  assert(__yo_str_len(s) == usize(5), "a &str binding into the extern's &str parameter");
  assert(_count_bytes("abc") == usize(3), "a literal into a Yo function's &str parameter");
  assert(_count_bytes(s) == usize(5), "a &str binding into a Yo function's &str parameter");
  assert(("xy".byte_count() == usize(2)) && (s.byte_count() == usize(5)), "a receiver lent to the extern by an impl(str) method");
});
test("a closure captures a &str binding by value", {
  s := "hello";
  (f : Impl(Fn() -> usize)) = ({ s }() => s.len());
  assert(f() == usize(5), "the captured view keeps its length");
});
// A string literal at a `str` (`&(str, static)`) struct field or enum payload
// is that reference value, never a place to lend; a `-> str` function returns
// its `&str` parameter, or a local copy of a `str` parameter, as the
// `&(str, static)` value it is; a literal at a by-value binder is that value
// (issues/fixed/2026-11-16-a-string-literal-in-a-str-field-is-lent-as-a-place.md).
_StrHolder :: struct(name : str);
_StrTagged :: enum(Tag(name : str), Empty);
_str_id :: (fn(s : &str) -> str)(s);
_str_copy :: (fn(a : str) -> str)({
  r := a;
  r
});
_str_pick :: (fn(a : str, b : str, c : bool) -> str)({
  x := cond(c => a, true => b);
  x
});
_str_hold :: (fn(generic(T : Type), x : T) -> T)(x);
_str_tag_len :: (fn(t : &_StrTagged) -> usize)(
  match(
    t,
    .Tag("a") => usize(100),
    .Tag(n) => n.len(),
    .Empty => usize(0)
  )
);
test("a string literal fills a str field and payload, and a -> str function returns a &str", {
  h := _StrHolder(name : "abc");
  assert(h.name.len() == usize(3), "a literal in a str struct field keeps its length");
  assert(_str_tag_len(_StrTagged.Tag("a")) == usize(100), "a literal payload compares equal to the pattern literal");
  assert(_str_tag_len(_StrTagged.Tag("zzzz")) == usize(4), "a literal payload keeps its length");
  assert(_str_id("xyz").len() == usize(3), "a -> str function returns its &str parameter");
  assert((_str_copy("ab") == "ab") && (_str_pick("a", "bc", false) == "bc"), "a local copy of a str parameter is returned");
  assert(_str_hold("xy").len() == usize(2), "a literal at a by-value binder binds T := &(str, static)");
});
// A legacy value `str` payload (`.Some(s)` over an `Option(str)`) is the
// `&(str, static)` value it is: a copy, which a local may take and an arm may
// yield, whatever the match's mode
// (issues/fixed/2026-11-16-a-str-payload-binding-is-a-reference-to-an-unsized-place.md).
_str_or :: (fn(o : Option(str), d : str) -> str)(
  match(
    o,
    .Some(s) => {
      t := s;
      t
    },
    .None => d
  )
);
_str_first :: (fn(xs : &ArrayList(str)) -> str)({
  v := match(xs.get(usize(0)), .Some(s) => s, .None => "~");
  v
});
_str_ref_or :: (fn(o : &Option(str)) -> usize)(
  match(
    o,
    .Some(s) => {
      t := s;
      t.len()
    },
    .None => usize(0)
  )
);
test("a str payload binds the &(str, static) value", {
  assert((_str_or(Option(str).Some("abc"), "d") == "abc") && (_str_or(Option(str).None, "d") == "d"), "a local copy of a consumed payload is the arm's result");
  mut(xs) := ArrayList(str).new();
  assert(_str_first(&xs) == "~", "the default arm");
  xs.push("hi");
  assert(_str_first(&xs) == "hi", "a payload yielded by an arm");
  o := Option(str).Some("four");
  assert(_str_ref_or(&o) == usize(4), "a local copy of a borrowed match's payload");
});
