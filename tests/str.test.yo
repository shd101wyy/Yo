open import "std/string";
open import "std/libc/stdio.yo";
{ ArrayList } :: import "std/collections/array_list";

test "Test str.from_raw_parts", {
  // Create str from raw pointer to string literal data
  s := str.from_raw_parts(*(u8)("hello"), usize(5));
  assert((s.len() == usize(5)), "str.from_raw_parts should have length 5");
};

test "Test str.from_raw_parts with zero length", {
  s := str.from_raw_parts(*(u8)(""), usize(0));
  assert((s.len() == usize(0)), "str.from_raw_parts with zero length should have length 0");
};

test "Test Slice(u8).from_raw_parts", {
  slice := Slice(u8).from_raw_parts(*(u8)("hello"), usize(5));
  assert((slice.len() == usize(5)), "Slice.from_raw_parts should have length 5");
  assert((slice(usize(0)) == u8(104)), "first byte should be 'h' (104)");
  assert((slice(usize(4)) == u8(111)), "last byte should be 'o' (111)");
};

test "Test String.as_str", {
  greeting := String.from("hello world");
  view := greeting.as_str();
  assert((view.len() == usize(11)), "as_str should have length 11");
  assert((view.bytes(usize(0)) == u8(104)), "first byte should be 'h' (104)");
};

test "Test String.as_str empty", {
  empty := String.new();
  empty_view := empty.as_str();
  assert((empty_view.len() == usize(0)), "empty as_str should have length 0");
};

test "Test String.as_str roundtrip", {
  original := String.from("hello world");
  view := original.as_str();
  roundtrip := String.from(view);
  roundtrip_view := roundtrip.as_str();
  assert((roundtrip_view.len() == view.len()), "roundtrip should preserve length");

  // Verify byte-by-byte equality
  i := usize(0);
  while (i < view.len()), (i = (i + usize(1))), {
    assert((view.bytes(i) == roundtrip_view.bytes(i)), "roundtrip bytes should match");
  };
};

test "Test String.as_str with unicode", {
  s := String.from("café");
  view := s.as_str();
  // "café" is 5 bytes in UTF-8 (c=1, a=1, f=1, é=2)
  assert((view.len() == usize(5)), "as_str of 'café' should have 5 bytes");
};
