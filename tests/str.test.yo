pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/libc/stdio.yo"));
{ ArrayList } :: import("std/collections/array_list");
test("Test str.from_raw_parts", {
  // Create str from raw pointer to string literal data
  s := str.from_raw_parts(*(u8)("hello"), usize(5));
  assert(s.len() == usize(5), "str.from_raw_parts should have length 5");
});
test("Test str.from_raw_parts with zero length", {
  s := str.from_raw_parts(*(u8)(""), usize(0));
  assert(s.len() == usize(0), "str.from_raw_parts with zero length should have length 0");
});
test("Test Slice(u8).from_raw_parts", {
  slice := Slice(u8).from_raw_parts(*(u8)("hello"), usize(5));
  assert(slice.len() == usize(5), "Slice.from_raw_parts should have length 5");
  assert(slice(usize(0)) == u8(104), "first byte should be 'h' (104)");
  assert(slice(usize(4)) == u8(111), "last byte should be 'o' (111)");
});
test("String.raw_bytes privileged view lengths", {
  // as_str() was deleted (str is the STATIC string view —
  // plans/SLICE_REWORK.md); raw_bytes is the pragma-gated replacement.
  greeting := String.from("hello world");
  assert(greeting.raw_bytes().len == usize(11), "raw_bytes len");
  empty := String.new();
  assert(empty.raw_bytes().len == usize(0), "empty raw_bytes len");
  cafe := String.from("caf\u00e9");
  assert(cafe.raw_bytes().len == usize(5), "utf8 raw_bytes len");
});
