//! A generic function whose return is `Impl(Future(T))` and whose `T` is
//! reached only through a CLOSURE parameter —
//! `fn(generic(R), f : Impl(Fn() -> R), io) -> Impl(Future(R, Io))`.
//!
//! Each instantiation ALONE always compiled; a second `R` in the same program
//! did not. The declaration is evaluated once, so `R` had ONE `SomeT` id for
//! every call, and the two channels that answer "what is `R`" — the global
//! resolved-concrete registry and the `SomeT`'s own per-object cell — are
//! keyed on it. The registry answered "the LAST call's R", the cell "the
//! PREVIOUS call's", and the emitted C took whichever its reader consulted.
//! issues/fixed/a-generic-function-returning-impl-future-t-miscompiles-at-a-second-t.md
//!
//! **THREE instantiations, deliberately.** At two, a lag-by-one, a swap and a
//! reversal are the same permutation, so a two-`T` test cannot tell a fix from
//! a different bug. At three they disagree.
//!
//! The payload values are chosen so no two expected answers collide: 7, 8, 6.
//! With `Pair(lo : 3, hi : 4)` the second sum is 7 as well, and a `Pair` call
//! miscompiled with the `i32` specialization's type would print the right
//! number for the wrong reason.
{ assert } :: import("std/assert");

_Pair :: struct(lo : i32, hi : i32);
derive(_Pair, Copy, Clone);
_Trip :: struct(a : i64, b : i64, c : i64);
derive(_Trip, Copy, Clone);

_wrap :: (fn(generic(R : Type), f : &Impl(Fn() -> R), io : Io) -> Impl(Future(R, Io)))(
  io.async((io : Io) => f())
);

test("a free generic fn returning Impl(Future(R)) at three different R", {
  a := io.await(_wrap(() => i32(7), io), io);
  assert(a == i32(7), "i32 instantiation");
  b := io.await(_wrap(() => _Pair(lo : i32(3), hi : i32(5)), io), io);
  assert((b.lo + b.hi) == i32(8), "value-struct instantiation");
  c := io.await(_wrap(() => _Trip(a : i64(1), b : i64(2), c : i64(3)), io), io);
  assert((c.a + c.b + c.c) == i64(6), "second, wider value-struct instantiation");
});

// The binder NAME must not matter. `T` and `E` are what the PRELUDE's own
// `Future(T, E)` declaration calls its binders, and those ride along inside a
// re-evaluated `Impl(Future(i32) Io)` — so any machinery here that matches a
// binder by NAME instead of by ID captures the prelude's as if they were the
// callee's. Measured 2026-09-13: a name-keyed version of the fix left
// `std/thread.yo`'s `spawn_blocking` (declared `generic(T)`) still
// miscompiling, and renaming its binder — changing nothing else — made it
// compile and run. `T` is the most natural name there is.
_wrap_t :: (fn(generic(T : Type), f : &Impl(Fn() -> T), io : Io) -> Impl(Future(T, Io)))(
  io.async((io : Io) => f())
);
_wrap_e :: (fn(generic(E : Type), f : &Impl(Fn() -> E), io : Io) -> Impl(Future(E, Io)))(
  io.async((io : Io) => f())
);

test("the binder named T — the prelude's own Future binder name", {
  a := io.await(_wrap_t(() => i32(7), io), io);
  assert(a == i32(7), "i32 instantiation");
  b := io.await(_wrap_t(() => _Pair(lo : i32(3), hi : i32(5)), io), io);
  assert((b.lo + b.hi) == i32(8), "value-struct instantiation");
  c := io.await(_wrap_t(() => _Trip(a : i64(1), b : i64(2), c : i64(3)), io), io);
  assert((c.a + c.b + c.c) == i64(6), "third instantiation");
});

test("the binder named E — the prelude's own effect-row binder name", {
  a := io.await(_wrap_e(() => i32(7), io), io);
  assert(a == i32(7), "i32 instantiation");
  b := io.await(_wrap_e(() => _Pair(lo : i32(3), hi : i32(5)), io), io);
  assert((b.lo + b.hi) == i32(8), "value-struct instantiation");
});

_Box3 :: struct(tag : i32);
derive(_Box3, Copy, Clone);
impl(
  _Box3,
  // An impl entry with NO `self`: called as `_Box3.run(...)`, which takes a
  // different call arm from the instance-method form below.
  run : (fn(generic(R : Type), f : &Impl(Fn() -> R), io : Io) -> Impl(Future(R, Io)))(
    io.async((io : Io) => f())
  ),
  // The instance-method form. This one ALWAYS worked — it is the canary: it
  // reads the specialization's own freshly-cloned body, so an over-eager fix
  // that un-fixes it would otherwise land silently.
  run_self : (fn(generic(R : Type), self : Self, f : &Impl(Fn() -> R), io : Io) -> Impl(Future(R, Io)))(
    io.async((io : Io) => f())
  )
);

test("an impl entry with no self, at two different R", {
  a := io.await(_Box3.run(() => i32(7), io), io);
  assert(a == i32(7), "i32 instantiation");
  b := io.await(_Box3.run(() => _Pair(lo : i32(3), hi : i32(5)), io), io);
  assert((b.lo + b.hi) == i32(8), "value-struct instantiation");
});

test("the method-call form still works, at two different R", {
  bx := _Box3(tag : i32(1));
  a := io.await(bx.run_self(() => i32(7), io), io);
  assert(a == i32(7), "i32 instantiation");
  b := io.await(bx.run_self(() => _Pair(lo : i32(3), hi : i32(5)), io), io);
  assert((b.lo + b.hi) == i32(8), "value-struct instantiation");
});

test("an explicit receiver on the method form, at two different R", {
  bx := _Box3(tag : i32(1));
  a := io.await(_Box3.run_self(bx, () => i32(7), io), io);
  assert(a == i32(7), "i32 instantiation");
  b := io.await(_Box3.run_self(bx, () => _Pair(lo : i32(3), hi : i32(5)), io), io);
  assert((b.lo + b.hi) == i32(8), "value-struct instantiation");
});

// A result that CONTAINS the binder: `Impl(Future(Option(U), Io))`. The
// specialization's `io.async` result kept `Option(U)` and keyed a second C
// type beside the caller's `Option(i32)`
// (issues/fixed/a-generic-async-fn-whose-future-result-contains-t-emits-two-c-types.md).
// Named `T`, the binder also collided with `io.async`'s own `T`: a false
// E0601, "Cannot unify i32 and Option(T)"
// (issues/fixed/a-caller-binder-named-t-collides-with-io-async-t.md).
_wrap_opt_u :: (fn(generic(U : Type), v : &U, io : Io) -> Impl(Future(Option(U), Io)))(
  io.async((io : Io) => Option(U).Some(v))
);
_wrap_opt_t :: (fn(generic(T : Type), v : &T, io : Io) -> Impl(Future(Option(T), Io)))(
  io.async((io : Io) => Option(T).Some(v))
);

test("a future result containing the binder, at two different U", {
  a := io.await(_wrap_opt_u(i32(5), io), io);
  assert(match(a, .Some(x) => (x == i32(5)), .None => false), "i32 instantiation");
  b := io.await(_wrap_opt_u(_Pair(lo : i32(3), hi : i32(5)), io), io);
  assert(match(b, .Some(p) => ((p.lo + p.hi) == i32(8)), .None => false), "value-struct instantiation");
});

test("a future result containing a binder named T", {
  a := io.await(_wrap_opt_t(i32(5), io), io);
  assert(match(a, .Some(x) => (x == i32(5)), .None => false), "i32 instantiation");
  b := io.await(_wrap_opt_t(_Pair(lo : i32(3), hi : i32(5)), io), io);
  assert(match(b, .Some(p) => ((p.lo + p.hi) == i32(8)), .None => false), "value-struct instantiation");
});
// The inverse direction: `T` is bound ONLY by a closure whose result is itself
// an `io.async` future (issues/fixed/a-generic-t-bound-by-a-closure-returning-a-future-is-not-inferred.md).
_call_it :: (fn(generic(T : Type), f : &Impl(Fn() -> T)) -> T)(f());
test("a generic T bound by a closure that returns an io.async future", {
  task := _call_it(() => io.async((io : Io) => i32(8)));
  assert(io.await(task, io) == i32(8), "the future's value");
  pair_task := _call_it(() => io.async((io : Io) => _Pair(lo : i32(2), hi : i32(5))));
  p := io.await(pair_task, io);
  assert((p.lo + p.hi) == i32(7), "a second T");
  // Annotating the binding names the same type and binds the same way.
  (annotated : Impl(Future(i32, Io))) = _call_it(() => io.async((io : Io) => i32(9)));
  assert(io.await(annotated, io) == i32(9), "an annotated binding");
});
// A generic caller that FORWARDS the closure (`arena.scoped(f)` calling
// `with_allocator(a, f)`): inside the caller's specialization the inner call's
// `T` is bound to the caller's `T`, which is bound to the future.
_forward_it :: (fn(generic(T : Type), f : &Impl(Fn() -> T)) -> T)(_call_it(f));
test("a generic T bound through a caller that forwards the closure", {
  task := _forward_it(() => io.async((io : Io) => i32(10)));
  assert(io.await(task, io) == i32(10), "the forwarded future's value");
  n := _forward_it(() => i32(11));
  assert(n == i32(11), "a value through the same caller");
});
// A droppable local makes the body materialize its tail into `__yo_scope_ret`
// before the drops. At the future specialization that temporary took the
// OTHER specialization's return type (`_ScopeLocal*` instead of the state
// machine), a C type error.
// issues/fixed/a-tail-return-temporary-takes-another-specializations-return-type.md
_ScopeLocal :: ref(struct(n : i32));
_call_with_local :: (fn(generic(T : Type), f : &Impl(Fn() -> T)) -> T)({
  _held := _ScopeLocal(n : i32(1));
  f()
});
test("a tail temporary keeps each specialization's own return type", {
  p := _call_with_local(() => _ScopeLocal(n : i32(3)));
  task := _call_with_local(() => io.async((io : Io) => i32(8)));
  assert((p.n + io.await(task, io)) == i32(11), "both specializations");
});
// A future stored as an enum payload (`Option(T)` at `T` = a future) emitted
// the Future interface's on-demand forward declaration INSIDE the variant
// union: "type name does not allow storage class to be specified".
// issues/fixed/an-io-async-future-stored-in-an-enum-payload-emits-a-nested-typedef.md
_FutureSlot :: (fn(comptime(T) : Type) -> comptime(Type))(ref(struct(r : Option(T))));
_call_with_slot :: (fn(generic(T : Type), f : &Impl(Fn() -> T)) -> T)({
  _slot := _FutureSlot(T)(r : .None);
  f()
});
test("a future type as an enum payload declares the payload type first", {
  task := _call_with_slot(() => io.async((io : Io) => i32(12)));
  assert(io.await(task, io) == i32(12), "the future's value");
});
// ---------------------------------------------------------------------------
// A generic function returning `Impl(Future(Result(T, E), Io))` or
// `Impl(Fn(k : i32) -> Result(T, E))` whose body ends in a bare-variant
// `match`: the `T` inside the `Impl` wrapper's trait arguments was never
// substituted at specialization, so `.Ok(x)` took the generic `T` and the
// result had a second C type (clang: incompatible struct assignment)
// (issues/fixed/a-generic-io-async-body-ending-in-a-bare-variant-match-gets-a-second-c-result-type.md).
// ---------------------------------------------------------------------------
_BareE :: enum(X, Y);
derive(_BareE, Copy, Clone);
_bare_future :: (fn(generic(T : Type), v : &Option(T), io : Io) -> Impl(Future(Result(T, _BareE), Io)))({
  b := Rc(Option(T))(v);
  io.async((io : Io) => {
    c := b.*;
    match(c, .Some(x) => .Ok(x), .None => .Err(_BareE.X))
  })
});
_bare_fn :: (fn(generic(T : Type), v : &Option(T)) -> Impl(Fn(k : i32) -> Result(T, _BareE)))({
  b := Rc(Option(T))(v);
  (k : i32) => {
    c := b.*;
    match(c, .Some(x) => .Ok(x), .None => .Err(_BareE.X))
  }
});
test("a generic Impl(Future(Result(T, E))) body ending in a bare-variant match", {
  r := io.await(_bare_future(Option(i32).Some(i32(5)), io), io);
  assert(match(r, .Ok(v) => (v == i32(5)), .Err(_) => false), "the Ok payload is the specialized T");
  r2 := io.await(_bare_future(Option(i32).None, io), io);
  assert(match(r2, .Ok(_) => false, .Err(_) => true), "and the Err arm still works");
});
test("a generic Impl(Fn(...) -> Result(T, E)) closure ending in a bare-variant match", {
  f := _bare_fn(Option(i32).Some(i32(6)));
  r := f(i32(1));
  assert(match(r, .Ok(v) => (v == i32(6)), .Err(_) => false), "the Ok payload is the specialized T");
});
