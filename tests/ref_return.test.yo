/// Phase A of plans/ITERATOR_REDESIGN.md — `-> ref(T)` return slot.
///
/// `ref(T)` is a binding-yield marker in the return slot. The function
/// returns a `T*` at the C ABI; the call site receives a reference
/// that can be (eventually, in Phase B) bound via `ref(name) := ...`
/// or auto-derefed in a value context.
///
/// Phase A guarantees:
/// - `-> ref(T)` parses and produces a function whose return is
///   marked `isRef`.
/// - `ref(T)` is rejected inside any other type expression
///   (parameter type, generic argument, struct field, tuple
///   element, …).
/// - Codegen emits `T*` as the C return type for a function with
///   `-> ref(T)`.
///
/// The flowability rule, the `ref(name) := ...` local binding, and
/// auto-deref of the call result are Phase B; Phase A just lands the
/// parser / type-system / codegen plumbing.
pragma(Pragma.AllowUnsafe);
// `ref(T)` cannot appear as a parameter type (only as a parameter
// modifier `ref(name) : T`).
comptime_expect_error(
  takes_ref_typed :: (fn(p : ref(i32)) -> i32)(i32(0))
);
// `ref(T)` cannot appear inside Option(...) — borrows must not flow
// through generic types. The current diagnostic surfaces as "Variable
// 'ref' not found" because the evaluator only recognizes `ref` as a
// keyword in parameter / return-slot positions; outside those, it
// falls through to identifier resolution and fails. A future
// refinement can produce a more targeted error.
comptime_expect_error(
  takes_option_of_ref :: (fn(p : Option(ref(i32))) -> i32)(i32(0))
);
// `ref(T)` cannot appear inside a tuple element.
comptime_expect_error(
  takes_tuple_of_ref :: (fn(p : (ref(i32), bool)) -> i32)(i32(0))
);
// `ref(T)` cannot appear as a struct field type.
comptime_expect_error(
  HasRefField :: struct(r : ref(i32))
);
// Positive — `-> ref(T)` parses and the function takes a ref param.
ref_identity :: (fn(ref(p) : i32) -> ref(i32))(p);
// Positive — the function CAN be passed to a context that takes a
// ref param (chaining). Phase A only checks this parses; the
// flowability rule and auto-deref show up in Phase B.
test("ref(T) return slot parses and compiles", {
  // Just verifying the prep work landed; full call-site semantics
  // are exercised in Phase B's tests.
  assert(true, "ref return slot parsing did not error");
});
