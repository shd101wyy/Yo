//! JoinHandle introspection + cancellation (`plans/archive/STD_API_AUDIT.md` §7 P0
//! item 6): `state()` (non-blocking FutureState read), `is_finished()`, and
//! `abort()` — cancel a spawned task at its next suspension point.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
import("std/libc/stdio");
{ yield } :: import("std/async");
{ sleep } :: import("std/sys/timer");

// ---------------------------------------------------------------------------
// 1. state() on a completed task reads Completed without blocking
// ---------------------------------------------------------------------------
test("Test JoinHandle state after completion", {
  fut := io.async((io : Io) => {
    return(u64(7));
  });
  h := io.spawn(fut, io);
  // A body with no suspension points runs to completion inside io.spawn.
  s := h.state();
  assert(s == FutureState.Completed, "no-await task should be Completed right after spawn");
  assert(h.is_finished(), "is_finished should be true for a completed task");
  r := h.await(io);
  assert(match(r, .Some(v) => (v == u64(7)), .None => false), "await after completion should read the result");
});
// ---------------------------------------------------------------------------
// 2. state() on a suspended task is non-terminal and does not block
// ---------------------------------------------------------------------------
test("Test JoinHandle state while suspended", {
  fut := io.async((io : Io) => {
    io.await(sleep(u64(20)), io);
    return(i32(1));
  });
  h := io.spawn(fut, io);
  s := h.state();
  assert((s != FutureState.Completed) && (s != FutureState.Aborted), "sleeping task should not be terminal");
  assert(!h.is_finished(), "is_finished should be false while suspended");
  r := h.await(io);
  assert(match(r, .Some(v) => (v == i32(1)), .None => false), "task should still complete normally");
});
// ---------------------------------------------------------------------------
// 3. abort() of a suspended task: await returns .None
// ---------------------------------------------------------------------------
test("Test JoinHandle abort returns None", {
  ran := Rc(bool)(false);
  fut := io.async((io : Io) => {
    io.await(sleep(u64(50)), io);
    ran.* = true;
    return(i32(9));
  });
  h := io.spawn(fut, io);
  h.abort();
  assert(h.state() == FutureState.Aborted, "abort should mark the task Aborted");
  r := h.await(io);
  assert(match(r, .Some(_) => false, .None => true), "awaiting an aborted task should give .None");
  assert(!(ran.*), "the aborted body must not resume past its suspension point");
});
// ---------------------------------------------------------------------------
// 4. The aborted task's pending timer completion fires safely afterwards
//    (the resume entry guard releases the state machine instead of falling
//    through the state switch).
// ---------------------------------------------------------------------------
test("Test aborted task pending completion is safe", {
  ran2 := Rc(bool)(false);
  fut := io.async((io : Io) => {
    io.await(sleep(u64(10)), io);
    ran2.* = true;
    return(i32(3));
  });
  h := io.spawn(fut, io);
  h.abort();
  r := h.await(io);
  assert(match(r, .Some(_) => false, .None => true), "aborted task should give .None");
  // Outlive the aborted task's 10ms timer so its continuation fires into the
  // aborted state machine while the loop is still alive.
  io.await(sleep(u64(30)), io);
  assert(!(ran2.*), "aborted body must not have resumed when its timer fired");
});
// ---------------------------------------------------------------------------
// 5. abort() after completion is a no-op
// ---------------------------------------------------------------------------
test("Test abort after completion is a no-op", {
  fut := io.async((io : Io) => {
    io.await(yield(io), io);
    return(u64(11));
  });
  h := io.spawn(fut, io);
  // Drive the loop until the spawned task has finished without awaiting the
  // handle, so `state()` is read on a task nothing else has observed.
  // Bounded poll, not one fixed sleep: `yield` parked on a 1 ms timer then, and
  // a single sleep(5) raced it — Windows' GetTickCount64 wheel has ~15.6 ms
  // granularity, so both timers fired in ONE wake batch and the awaiting test
  // body exited before the ready queue drained (macos-26-intel lost the same
  // race stochastically on slow VMs).
  (spins : usize) = usize(0);
  while(runtime(!h.is_finished() && (spins < usize(2000))), {
    io.await(sleep(u64(1)), io);
    spins = (spins + usize(1));
  });
  assert(h.is_finished(), "yield task should finish while the sleep loop drives the event loop");
  h.abort();
  assert(h.state() == FutureState.Completed, "abort of a completed task must not change its state");
  r := h.await(io);
  assert(match(r, .Some(v) => (v == u64(11)), .None => false), "completed result should be intact");
});
// ---------------------------------------------------------------------------
// 6. abort() cancels the operation the task is suspended IN, and releases the
//    task there and then — it does not wait for that operation to complete on
//    its own. Before the I/O cancel path existed, the aborted task's state
//    machine and everything it captured stayed alive for the whole remaining
//    sleep, which is what made `timeout` retain ~256 bytes per call until its
//    deadline (issues/fixed/timeout-deadline-timer-future-leak.md).
//    The Dispose counter is the observable: CI runs with detect_leaks=0, so a
//    retention this shape is invisible to the sanitizers.
// ---------------------------------------------------------------------------
(g_abort_capture_disposed : i32) = i32(0);
AbortCaptureProbe :: ref(struct(id : i32));
impl(
  AbortCaptureProbe,
  Dispose(
    dispose : (fn(self : &Self) -> unit)({
      g_abort_capture_disposed = (g_abort_capture_disposed + i32(1));
    })
  )
);
test("Test abort cancels the pending timer and releases the task", {
  {
    probe := AbortCaptureProbe(id : i32(7));
    fut := io.async((io : Io) => {
      io.await(sleep(u64(30000)), io);
      return(probe.id);
    });
    h := io.spawn(fut, io);
    // Let the spawned task reach its suspension point.
    io.await(yield(io), io);
    assert(!h.is_finished(), "task should be parked on the 30 s sleep");
    assert(g_abort_capture_disposed == i32(0), "capture is alive while the task is");
    h.abort();
    r := h.await(io);
    assert(match(r, .Some(_) => false, .None => true), "aborted task should give .None");
  };
  // The local reference is gone and the handle is consumed, so the only thing
  // that could still hold the capture is a state machine kept alive for a
  // timer that will not fire for another 30 seconds.
  assert(g_abort_capture_disposed == i32(1), "abort must release the aborted task's captures at once");
});
// ---------------------------------------------------------------------------
// One abort semantics (plans/ASYNC_IO_API_AUDIT.md A2): an aborted future
// propagates its abort to whoever awaits or spawns it, whether it was aborted
// before or during the wait. Both "already aborted" cases used to panic
// ("attempted to await an aborted Future" / "attempted to spawn an aborted
// Future").
// ---------------------------------------------------------------------------
/// A task that would deliver 5 after a long sleep, aborted before it can.
_aborted_task :: (fn(io : Io) -> Impl(Future(i32, Io)))({
  t := io.async((io : Io) => {
    io.await(sleep(u64(500)), io);
    i32(5)
  });
  h := io.spawn(t, io);
  h.abort();
  t
});
test("io.spawn of an already-aborted future returns a handle that reads None", {
  t := _aborted_task(io);
  h2 := io.spawn(t, io);
  assert(h2.state() == FutureState.Aborted, "the second handle sees the abort");
  assert(h2.await(io).is_none(), "and reads .None instead of panicking");
});
test("io.await of an already-aborted future inside a task aborts the awaiting task", {
  t := _aborted_task(io);
  outer := io.async((io : Io) => {
    v := io.await(t, io);
    v + i32(1)
  });
  ho := io.spawn(outer, io);
  assert(ho.await(io).is_none(), "the awaiting task was aborted in turn");
});
/// A PLAIN function awaiting a future: the sync await path.
_plain_get :: (fn(t : &Impl(Future(i32, Io)), io : Io) -> i32)(io.await(t, io));
test("a plain function's io.await of an already-aborted future propagates to the calling task", {
  t := _aborted_task(io);
  caller := io.async((io : Io) => {
    v := _plain_get(t, io);
    v + i32(1)
  });
  hc := io.spawn(caller, io);
  assert(hc.await(io).is_none(), "the abort escaped the plain function and aborted the calling task");
});
// ---------------------------------------------------------------------------
// Cancellation gaps closed by plans/ASYNC_IO_API_AUDIT.md A3.
// ---------------------------------------------------------------------------
test("abort of a directly spawned raw IoFuture stays Aborted after the operation's time", {
  // issues/fixed/abort-of-a-directly-spawned-raw-io-future-is-undone-by-its-completion.md
  h := io.spawn(sleep(u64(30)), io);
  h.abort();
  assert(h.state() == FutureState.Aborted, "Aborted right after the abort");
  io.await(sleep(u64(80)), io);
  assert(h.state() == FutureState.Aborted, "still Aborted after the timer would have fired");
  assert(h.await(io).is_none(), "await reads .None");
});
test("aborting a task aborts the named child future its await started", {
  ran := Rc(bool)(false);
  child := io.async((io : Io) => {
    io.await(sleep(u64(50)), io);
    ran.* = true;
    i32(1)
  });
  parent := io.async((io : Io) => {
    v := io.await(child, io);
    v + i32(1)
  });
  hp := io.spawn(parent, io);
  io.await(yield(io), io);
  hp.abort();
  assert(io.state(child) == FutureState.Aborted, "the child the parent started was aborted with it");
  io.await(sleep(u64(80)), io);
  assert(!(ran.*), "and its body never resumed past its sleep");
  assert(hp.await(io).is_none(), "the parent reads .None");
});
test("aborting a task leaves a named future that someone else started running", {
  ran := Rc(bool)(false);
  shared := io.async((io : Io) => {
    io.await(sleep(u64(20)), io);
    ran.* = true;
    i32(5)
  });
  hs := io.spawn(shared, io);
  waiter := io.async((io : Io) => io.await(shared, io));
  hw := io.spawn(waiter, io);
  io.await(yield(io), io);
  hw.abort();
  r := hs.await(io);
  assert(match(r, .Some(v) => (v == i32(5)), .None => false), "the shared future completed");
  assert(ran.*, "its body ran to the end");
});
// ---------------------------------------------------------------------------
// A user method named `await` is an ordinary method: codegen lowers
// `x.await(...)` as JoinHandle.await only when the call resolved to it
// (issues/fixed/a-user-method-named-await-is-lowered-as-join-handle-await-and-ices.md).
// ---------------------------------------------------------------------------
_Awaitable :: struct(v : i32);
derive(_Awaitable, Copy, Clone);
impl(_Awaitable, await : (fn(self : Self, io : Io) -> i32)(self.v + i32(1)));
test("a user method named await compiles and runs as a method", {
  t := _Awaitable(v : i32(5));
  assert(t.await(io) == i32(6), "the user's await ran");
  h := io.spawn(io.async((io : Io) => i32(2)), io);
  assert(match(h.await(io), .Some(v) => (v == i32(2)), .None => false), "JoinHandle.await is still the builtin");
});
