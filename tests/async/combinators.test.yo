//! Async combinators — the `JoinHandle` family (`join_all`, `race`,
//! `race_first`, `any`, `any_first`, `timeout`;
//! `plans/archive/STD_API_AUDIT.md` §7 P0 item 6) and the `Stream` family
//! (`map`, `filter`, `filter_map`, `take`, `skip`, `for_each`, `collect`;
//! `plans/reference/ASYNC_ITERATION_STREAM.md`).
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
{ join_all, race, race_first, any, any_first, timeout, TimeoutError, yield } :: import("std/async");
{ Stream, for_await } :: import("std/async/stream");
{ Duration } :: import("std/time/duration");
{ sleep } :: import("std/sys/timer");

/// A task that sleeps `ms` then returns `value`.
sleepy :: (fn(value : i32, ms : u64, io : Io) -> Impl(Future(i32, Io)))({
  v := Rc(i32)(value);
  m := Rc(u64)(ms);
  io.async((io : Io) => {
    io.await(sleep(m.*), io);
    return(v.*);
  })
});
// A `JoinHandle` is move-only (plans/VALUES_BY_DEFAULT.md §3.13 A3): every
// combinator takes its handles by value. `join_all`, `race_first`,
// `any_first` and `timeout` consume them; `race` and `any` hand the list back
// with the index.
// ---------------------------------------------------------------------------
// 1. join_all — results in spawn order, concurrent wall time
// ---------------------------------------------------------------------------
test("Test join_all returns results in order", {
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy(i32(10), u64(15), io), io));
  handles.push(io.spawn(sleepy(i32(20), u64(5), io), io));
  handles.push(io.spawn(sleepy(i32(30), u64(10), io), io));
  results := io.await(join_all(handles, io), io);
  assert(results.len() == usize(3), "join_all should return one result per handle");
  assert(match(results(usize(0)), .Some(v) => (v == i32(10)), .None => false), "slot 0 should be 10");
  assert(match(results(usize(1)), .Some(v) => (v == i32(20)), .None => false), "slot 1 should be 20");
  assert(match(results(usize(2)), .Some(v) => (v == i32(30)), .None => false), "slot 2 should be 30");
});
test("Test join_all drains the list it takes", {
  // An `ArrayList` is still a shared handle (it becomes explicit-copy at
  // V2b), so the caller's binding sees the list `join_all` drained: every
  // handle moved out and was consumed by its join.
  handles := ArrayList(JoinHandle(Rc(i32))).new();
  handles.push(io.spawn(io.async((io : Io) => Rc(i32)(4)), io));
  handles.push(io.spawn(io.async((io : Io) => Rc(i32)(5)), io));
  outs := io.await(join_all(handles, io), io);
  assert(handles.len() == usize(0), "join_all drained the list");
  // Each result moves out of its joined task.
  assert(match(outs(usize(0)), .Some(r) => (r.* == i32(4)), .None => false), "slot 0 moved out");
  assert(match(outs(usize(1)), .Some(r) => (r.* == i32(5)), .None => false), "slot 1 moved out");
});
// ---------------------------------------------------------------------------
// 2. join_all — an aborted task's slot is .None, siblings unaffected
// ---------------------------------------------------------------------------
test("Test join_all with aborted member", {
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy(i32(1), u64(30), io), io));
  handles.push(io.spawn(sleepy(i32(2), u64(5), io), io));
  handles(usize(0)).abort();
  results := io.await(join_all(handles, io), io);
  assert(match(results(usize(0)), .Some(_) => false, .None => true), "aborted slot should be .None");
  assert(match(results(usize(1)), .Some(v) => (v == i32(2)), .None => false), "sibling should complete");
});
// ---------------------------------------------------------------------------
// 3. race — first terminal handle wins; the list comes back, and the losers
//    keep running and stay joinable
// ---------------------------------------------------------------------------
test("Test race picks the fastest", {
  handles := ArrayList(JoinHandle(i32)).new();
  // The loser sleeps long enough that a stalled CI runner cannot let one
  // poll step reap BOTH timers — `race` then reports the lower index and
  // the 40ms/5ms version of this test failed on macos-latest (PR #341).
  handles.push(io.spawn(sleepy(i32(1), u64(500), io), io));
  handles.push(io.spawn(sleepy(i32(2), u64(5), io), io));
  (w, back) := io.await(race(handles, io), io);
  assert(w == usize(1), "the 5ms task should win the race");
  assert(back.len() == usize(2), "race hands the whole list back");
  assert(back(usize(1)).is_finished(), "the winner is terminal");
  assert(!back(usize(0)).is_finished(), "the loser is still running");
  outs := io.await(join_all(back, io), io);
  assert(match(outs(usize(1)), .Some(v) => (v == i32(2)), .None => false), "winner result should be intact");
  assert(match(outs(usize(0)), .Some(v) => (v == i32(1)), .None => false), "loser should still complete normally");
});
test("Test race hands the list back: the losers can still be aborted", {
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy(i32(1), u64(500), io), io));
  handles.push(io.spawn(sleepy(i32(2), u64(1), io), io));
  handles.push(io.spawn(sleepy(i32(3), u64(500), io), io));
  (w, back) := io.await(race(handles, io), io);
  assert(w == usize(1), "the 1 ms task wins");
  back(usize(0)).abort();
  back(usize(2)).abort();
  assert(back(usize(0)).state() == FutureState.Aborted, "loser 0 aborted through the returned list");
  assert(back(usize(2)).state() == FutureState.Aborted, "loser 2 aborted through the returned list");
  outs := io.await(join_all(back, io), io);
  assert(outs(usize(0)).is_none(), "an aborted loser joins as .None");
  assert(match(outs(usize(1)), .Some(v) => (v == i32(2)), .None => false), "the winner's value");
  assert(outs(usize(2)).is_none(), "the other aborted loser joins as .None");
});
// ---------------------------------------------------------------------------
// 4. any — skips aborted handles, returns the first COMPLETION
// ---------------------------------------------------------------------------
test("Test any skips aborted handles", {
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy(i32(1), u64(30), io), io));
  handles.push(io.spawn(sleepy(i32(2), u64(10), io), io));
  handles(usize(0)).abort();
  (w, back) := io.await(any(handles, io), io);
  assert(match(w, .Some(i) => (i == usize(1)), .None => false), "any should pick the completing task, not the aborted one");
  assert(back.len() == usize(2), "any hands the whole list back");
  outs := io.await(join_all(back, io), io);
  assert(outs(usize(0)).is_none(), "the aborted handle joins as .None");
  assert(match(outs(usize(1)), .Some(v) => (v == i32(2)), .None => false), "the completed one keeps its value");
});
// ---------------------------------------------------------------------------
// 5. any — all aborted gives .None
// ---------------------------------------------------------------------------
test("Test any with all aborted", {
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy(i32(1), u64(30), io), io));
  handles.push(io.spawn(sleepy(i32(2), u64(30), io), io));
  handles(usize(0)).abort();
  handles(usize(1)).abort();
  (w, back) := io.await(any(handles, io), io);
  assert(match(w, .Some(_) => false, .None => true), "any over only-aborted handles should be .None");
  assert(back(usize(0)).state() == FutureState.Aborted, "the returned handles are the aborted ones");
  assert(back(usize(1)).state() == FutureState.Aborted, "both of them");
});
// ---------------------------------------------------------------------------
// 6. timeout — completion inside the limit
// ---------------------------------------------------------------------------
test("Test timeout completes in time", {
  h := io.spawn(sleepy(i32(7), u64(5), io), io);
  r := io.await(timeout(h, Duration.from_millis(i64(200)), io), io);
  assert(match(r, .Ok(v) => (v == i32(7)), .Err(_) => false), "task inside the limit should deliver its value");
});
test("Test timeout consumes its handle", {
  comptime_expect_error(
    _timeout_then_await :: (fn(io : Io) -> bool)({
      h := io.spawn(sleepy(i32(1), u64(1), io), io);
      _r := io.await(timeout(h, Duration.from_millis(i64(200)), io), io);
      h.await(io).is_some()
    }),
    "use of moved value"
  );
  h := io.spawn(sleepy(i32(8), u64(1), io), io);
  r := io.await(timeout(h, Duration.from_millis(i64(200)), io), io);
  assert(match(r, .Ok(v) => (v == i32(8)), .Err(_) => false), "the consumed handle's value comes back");
});
// ---------------------------------------------------------------------------
// 6b. timeout — repeated in-time calls against a long deadline.
//     Every call arms a real deadline timer that the winning task never lets
//     fire; each one used to stay armed (and hold its task, its capture and
//     its future) for the whole remaining 60 s, ~256 bytes a call with no
//     ceiling — issues/fixed/timeout-deadline-timer-future-leak.md. The abort
//     now cancels it, so this loop is flat. The assertion here is the
//     behavioural half: correctness under repetition.
// ---------------------------------------------------------------------------
test("Test timeout in a loop against a long deadline", {
  (i : usize) = usize(0);
  while(i < usize(200), i = (i + usize(1)), {
    h := io.spawn(sleepy(i32(3), u64(0), io), io);
    r := io.await(timeout(h, Duration.from_millis(i64(60000)), io), io);
    assert(match(r, .Ok(v) => (v == i32(3)), .Err(_) => false), "every in-time call should deliver its value");
  });
});
// ---------------------------------------------------------------------------
// 7b. timeout — a SELF-aborted task is Aborted, not Elapsed (D18)
// ---------------------------------------------------------------------------
test("Test timeout distinguishes an aborted task from an elapsed deadline", {
  fut := io.async((io : Io) => {
    io.await(sleep(u64(200)), io);
    return(i32(1));
  });
  h := io.spawn(fut, io);
  // Cancel the task ourselves, well inside a generous deadline.
  h.abort();
  r := io.await(timeout(h, Duration.from_millis(i64(500)), io), io);
  assert(
    match(r, .Ok(_) => false, .Err(e) => match(e, .Aborted => true, .Elapsed => false)),
    "a task cancelled before its deadline must report Aborted"
  );
});
// ---------------------------------------------------------------------------
// 7. timeout — deadline aborts the task
// ---------------------------------------------------------------------------
test("Test timeout aborts on deadline", {
  ran := Rc(bool)(false);
  fut := io.async((io : Io) => {
    io.await(sleep(u64(100)), io);
    ran.* = true;
    return(i32(1));
  });
  h := io.spawn(fut, io);
  r := io.await(timeout(h, Duration.from_millis(i64(10)), io), io);
  assert(
    match(r, .Ok(_) => false, .Err(e) => match(e, .Elapsed => true, .Aborted => false)),
    "an over-deadline task should report Elapsed, not a bare .None"
  );
  // Outlive the aborted task's timer so its completion fires the entry guard.
  io.await(sleep(u64(120)), io);
  assert(!(ran.*), "the timed-out body must not resume past its suspension point");
});
// ---------------------------------------------------------------------------
// race_first / any_first — the cleanup done for you
//
// `race`/`any` hand back an INDEX and leave the losers running (dropping a
// `JoinHandle` DETACHES its task, exactly as dropping Tokio's does). These two
// abort AND join each loser and resolve to the winner's result. They drain
// the list, so a loser's fate is observed through what it captured.
// ---------------------------------------------------------------------------
/// A task that sleeps `ms`, then records that it ran past its sleep and
/// returns `value`.
sleepy_flag :: (fn(value : i32, ms : u64, ran : Rc(bool), io : Io) -> Impl(Future(i32, Io)))(
  io.async({ value, ms, ran }(io : Io) => {
    io.await(sleep(ms), io);
    ran.* = true;
    value
  })
);
test("Test race_first returns the fastest task's value", {
  ran0 := Rc(bool)(false);
  ran2 := Rc(bool)(false);
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy_flag(i32(10), u64(60), ran0, io), io));
  handles.push(io.spawn(sleepy(i32(20), u64(1), io), io));
  handles.push(io.spawn(sleepy_flag(i32(30), u64(60), ran2, io), io));
  r := io.await(race_first(handles, io), io);
  assert(match(r, .Some(v) => (v == i32(20)), .None => false), "the 1 ms task wins");
  // Both losers were aborted and joined: neither runs past its sleep.
  io.await(sleep(u64(100)), io);
  assert(!(ran0.*), "loser 0 was aborted, not left running");
  assert(!(ran2.*), "loser 2 was aborted, not left running");
});
test("Test race_first with a single handle", {
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy(i32(7), u64(1), io), io));
  r := io.await(race_first(handles, io), io);
  assert(match(r, .Some(v) => (v == i32(7)), .None => false), "one handle wins by default");
});
test("Test any_first returns the first COMPLETED value and aborts the rest", {
  ran0 := Rc(bool)(false);
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy_flag(i32(1), u64(60), ran0, io), io));
  handles.push(io.spawn(sleepy(i32(2), u64(1), io), io));
  r := io.await(any_first(handles, io), io);
  assert(match(r, .Some(v) => (v == i32(2)), .None => false), "the fast task's value comes back");
  io.await(sleep(u64(100)), io);
  assert(!(ran0.*), "the loser was aborted");
});
test("Test any_first is None when every handle was aborted", {
  handles := ArrayList(JoinHandle(i32)).new();
  handles.push(io.spawn(sleepy(i32(1), u64(60), io), io));
  handles.push(io.spawn(sleepy(i32(2), u64(60), io), io));
  handles(usize(0)).abort();
  handles(usize(1)).abort();
  r := io.await(any_first(handles, io), io);
  assert(match(r, .Some(_) => false, .None => true), "no completion means .None");
});
// ---------------------------------------------------------------------------
// JoinHandle.join — the suspending wait, and the combinators INSIDE a task.
// `yo test` runs every binary with YO_ASYNC_STRICT=1, so a blocking wait that
// nested the loop inside any of these bodies would panic
// (plans/ASYNC_IO_API_AUDIT.md A1, finding F1).
// ---------------------------------------------------------------------------
/// Spawns `n` sleepy workers inside a task and joins them one by one.
join_in_task :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))({
  count := Rc(i32)(n);
  io.async((io : Io) => {
    handles := ArrayList(JoinHandle(i32)).new();
    (k : i32) = i32(0);
    while(k < count.*, k = (k + i32(1)), {
      handles.push(io.spawn(sleepy(k, u64(5), io), io));
    });
    (sum : i32) = i32(0);
    // Each join consumes its handle: pop them off the list.
    while(handles.len() > usize(0), {
      match(
        handles.pop(),
        .Some(h) => match(
          io.await(h.join(io), io),
          .Some(v) => {
            sum = (sum + v);
          },
          .None => ()
        ),
        .None => ()
      );
    });
    sum
  })
});
test("Test JoinHandle.join inside a task suspends instead of nesting the loop", {
  h := io.spawn(join_in_task(i32(4), io), io);
  r := h.await(io);
  assert(match(r, .Some(v) => (v == i32(6)), .None => false), "0+1+2+3 joined from inside the task");
});
test("Test JoinHandle.join from main reads the same Option as await", {
  h := io.spawn(sleepy(i32(9), u64(5), io), io);
  r := io.await(h.join(io), io);
  assert(match(r, .Some(v) => (v == i32(9)), .None => false), "join resolves to the task's value");
  h2 := io.spawn(sleepy(i32(9), u64(5), io), io);
  r2 := h2.await(io);
  assert(match(r2, .Some(v) => (v == i32(9)), .None => false), "await reads the same Option");
});
test("Test JoinHandle.join of an aborted task is None", {
  h := io.spawn(sleepy(i32(1), u64(50), io), io);
  h.abort();
  r := io.await(h.join(io), io);
  assert(match(r, .Some(_) => false, .None => true), "an aborted task joins as .None");
});
/// Runs join_all over two workers from inside a task.
join_all_in_task :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    handles := ArrayList(JoinHandle(i32)).new();
    handles.push(io.spawn(sleepy(i32(1), u64(10), io), io));
    handles.push(io.spawn(sleepy(i32(2), u64(5), io), io));
    outs := io.await(join_all(handles, io), io);
    (sum : i32) = i32(0);
    (i : usize) = usize(0);
    while(i < outs.len(), i = (i + usize(1)), {
      match(
        outs(i),
        .Some(v) => {
          sum = (sum + v);
        },
        .None => ()
      );
    });
    sum
  })
);
test("Test join_all inside a task", {
  r := io.await(join_all_in_task(io), io);
  assert(r == i32(3), "both workers joined from inside the task");
});
/// Races two workers from inside a task and aborts the loser.
race_first_in_task :: (fn(io : Io) -> Impl(Future(Option(i32), Io)))(
  io.async((io : Io) => {
    handles := ArrayList(JoinHandle(i32)).new();
    handles.push(io.spawn(sleepy(i32(1), u64(60), io), io));
    handles.push(io.spawn(sleepy(i32(2), u64(1), io), io));
    io.await(race_first(handles, io), io)
  })
);
test("Test race_first inside a task", {
  r := io.await(race_first_in_task(io), io);
  assert(match(r, .Some(v) => (v == i32(2)), .None => false), "the fast worker wins from inside a task");
});
/// A timeout that elapses, and one that does not, both from inside a task.
timeouts_in_task :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    slow := io.spawn(sleepy(i32(1), u64(200), io), io);
    fast := io.spawn(sleepy(i32(2), u64(1), io), io);
    a := io.await(timeout(slow, Duration.from_millis(i64(10)), io), io);
    b := io.await(timeout(fast, Duration.from_millis(i64(500)), io), io);
    (score : i32) = i32(0);
    match(
      a,
      .Ok(_) => (),
      .Err(e) => match(
        e,
        .Elapsed => {
          score = (score + i32(10));
        },
        .Aborted => ()
      )
    );
    match(
      b,
      .Ok(v) => {
        score = (score + v);
      },
      .Err(_) => ()
    );
    score
  })
);
test("Test timeout inside a task", {
  r := io.await(timeouts_in_task(io), io);
  assert(r == i32(12), "the slow one elapsed (10) and the fast one delivered 2");
});
test("Test any inside a task skips an aborted handle", {
  fut := io.async((io : Io) => {
    handles := ArrayList(JoinHandle(i32)).new();
    handles.push(io.spawn(sleepy(i32(1), u64(30), io), io));
    handles.push(io.spawn(sleepy(i32(2), u64(5), io), io));
    handles(usize(0)).abort();
    (w, _back) := io.await(any(handles, io), io);
    match(w, .Some(i) => i32(i), .None => i32(-1))
  });
  r := io.await(fut, io);
  assert(r == i32(1), "any resolves to the completing handle's index from inside a task");
});
test("Test aborting the joining task leaves the joined task running", {
  done := Rc(bool)(false);
  worker := io.async((io : Io) => {
    io.await(sleep(u64(20)), io);
    done.* = true;
    return(i32(1));
  });
  wh := io.spawn(worker, io);
  // The joiner owns the handle; `join` consumes it.
  joiner := io.async({ wh }(io : Io) => {
    _r := io.await(wh.join(io), io);
    return(i32(2));
  });
  jh := io.spawn(joiner, io);
  jh.abort();
  r := jh.await(io);
  assert(match(r, .Some(_) => false, .None => true), "the joiner was aborted");
  // The aborted join dropped the handle, which detached the worker.
  io.await(sleep(u64(60)), io);
  assert(done.*, "the joined task still ran to the end");
});
// ===========================================================================
// Stream — the async analogue of `Iterator`
// (plans/reference/ASYNC_ITERATION_STREAM.md)
// ===========================================================================
/// A finite test stream: `n`, `n-1`, …, 1, then `.None` forever. A plain
/// value: `next` takes `self : &mut Self`, and its future borrows the stream
/// (plans/VALUES_BY_DEFAULT.md §3.13 A5).
Countdown :: struct(_n : i32);
impl(
  Countdown,
  Stream(
    Item : i32,
    next : (fn(self : &mut Self, io : Io) -> Impl(Future(Option(i32), Io)))(
      io.async({ &mut self }(io : Io) =>
        cond(
          (self._n <= i32(0)) => Option(i32).None,
          true => {
            v := self._n;
            self._n = (self._n - i32(1));
            Option(i32).Some(v)
          }
        ))
    )
  )
);
/// Run a stream's `collect` FROM INSIDE A SPAWNED TASK, with a deadline.
///
/// Both halves matter. Spawning is the shape a blocking await inside a task
/// would deadlock on (the trap every combinator has to be tested against),
/// and the deadline is what turns "a combinator loops forever because `.None`
/// stopped being terminal" into a failed assertion instead of a burnt CI job.
///
/// It takes the stream by value and calls the blanket `collect`, which
/// consumes it, on the generic parameter itself. That used to fail (`No matching call found with
/// arguments: (s.collect)(io)`), so this helper took the collect future
/// instead; it is the shape `plans/archive/ASSOC_TYPE_BINDING_IN_FREE_FN_WHERE.md`
/// (Phase 2.6 of `plans/TYPE_SYSTEM_SOUNDNESS.md`) made work.
_bounded :: (fn(generic(S : Type), s : S, io : Io, where(S <: Stream(Item := i32))) -> ArrayList(i32))({
  h := io.spawn(s.collect(io), io);
  match(
    io.await(timeout(h, Duration.from_millis(i64(5000)), io), io),
    .Ok(list) => list,
    .Err(_) => {
      assert(false, "stream collect did not finish inside the deadline");
      ArrayList(i32).new()
    }
  )
});
/// A consumer generic over "anything that yields values asynchronously" —
/// the thing that was impossible before the trait existed. It never names the
/// item type, and accepts stream sources and combinator chains alike.
///
/// A bare `where(S <: Stream)`, a CONCRETE binding (`Item := i32`, as in
/// `_sum_i32`) and a GENERIC one (`Item := A`, as in `_collect_all`) all work
/// here, for sources and chains alike.
_count_items :: (
  fn(generic(S : Type), s : S, io : Io, where(S <: Stream)) -> Impl(Future(usize, Io))
)(
  io.async({ s }(io : Io) => {
    (n : usize) = usize(0);
    (draining : bool) = true;
    while(draining, {
      nx := io.await(s.next(io), io);
      match(
        nx,
        .Some(_) => {
          n = (n + usize(1));
        },
        .None => {
          draining = false;
        }
      );
    });
    n
  })
);
/// Generic over the item type: `A` is bound from the argument's `Stream` impl,
/// so the body can name `ArrayList(A)` and call the blanket `collect` on `s`.
_collect_all :: (fn(generic(S : Type, A : Type), s : S, io : Io, where(S <: Stream(Item := A))) -> ArrayList(A))(
  io.await(s.collect(io), io)
);
/// The same idea with the item type spelled out, so the body can use the
/// values.
_sum_i32 :: (
  fn(generic(S : Type), s : S, io : Io, where(S <: Stream(Item := i32))) -> Impl(Future(i32, Io))
)(
  io.async({ s }(io : Io) => {
    (total : i32) = i32(0);
    (draining : bool) = true;
    while(draining, {
      nx := io.await(s.next(io), io);
      match(
        nx,
        .Some(v) => {
          total = (total + v);
        },
        .None => {
          draining = false;
        }
      );
    });
    total
  })
);
// ---------------------------------------------------------------------------
// S1. The three cardinalities, awaited straight from `main`
// ---------------------------------------------------------------------------
test("Test Stream over an empty source yields nothing", {
  items := io.await(Countdown(_n : i32(0)).collect(io), io);
  assert(items.len() == usize(0), "an empty stream collects to an empty list");
});
test("Test Stream with a single item", {
  items := io.await(Countdown(_n : i32(1)).collect(io), io);
  assert(items.len() == usize(1), "one item");
  assert(items(usize(0)) == i32(1), "and it is the one the source yielded");
});
test("Test Stream with several items keeps their order", {
  items := io.await(Countdown(_n : i32(3)).collect(io), io);
  assert(items.len() == usize(3), "three items");
  assert(items(usize(0)) == i32(3), "first");
  assert(items(usize(1)) == i32(2), "second");
  assert(items(usize(2)) == i32(1), "third");
});
// ---------------------------------------------------------------------------
// S2. `.None` is terminal AND stays terminal
// ---------------------------------------------------------------------------
test("Test Stream .None is terminal and stays terminal", {
  c := Countdown(_n : i32(1));
  first := io.await(c.next(io), io);
  assert(first.is_some(), "the one item arrives");
  second := io.await(c.next(io), io);
  assert(second.is_none(), "then the stream finishes");
  third := io.await(c.next(io), io);
  assert(third.is_none(), "and a finished stream stays finished");
});
// ---------------------------------------------------------------------------
// S3. A generic consumer bounded by `where(S <: Stream)`
// ---------------------------------------------------------------------------
test("Test a consumer generic over Stream", {
  n := io.await(_count_items(Countdown(_n : i32(4)), io), io);
  assert(n == usize(4), "a function that only knows `S <: Stream` drains the stream");
  chain := Countdown(_n : i32(5)).take(usize(2));
  n3 := io.await(_count_items(chain, io), io);
  assert(n3 == usize(2), "and it takes a combinator chain, not only a source");
  total := io.await(_sum_i32(Countdown(_n : i32(3)), io), io);
  assert(total == i32(6), "a concrete-Item consumer sums a source");
  chained := io.await(_sum_i32(Countdown(_n : i32(3)).map(x => (x * i32(2))), io), io);
  assert(chained == i32(12), "and it accepts a combinator chain, not just a source");
  all := _collect_all(Countdown(_n : i32(3)).map(x => (x * i32(2))), io);
  assert(all.len() == usize(3), "a generic-Item consumer collects a chain");
  assert(all(usize(0)) == i32(6), "and keeps the values");
});
// issues/fixed/a-stream-combinator-used-twice-in-one-chain-emits-two-c-types.md
// The same combinator more than once in one chain: each `map` over a
// different inner stream is its own type. They were interned as one C type
// (incompatible pointer types in the emitted C), two deep and deeper.
test("Test the same combinator repeated in one chain", {
  two := io.await(Countdown(_n : i32(3)).map(x => (x + i32(1))).map(x => (x + i32(2))).collect(io), io);
  assert(two.len() == usize(3), "two maps keep every item");
  assert(two(usize(0)) == i32(6), "two maps: 3 + 1 + 2");
  three := io.await(Countdown(_n : i32(3)).map(x => (x + i32(1))).map(x => (x + i32(2))).map(x => (x + i32(3))).collect(io), io);
  assert(three(usize(0)) == i32(9), "three maps: 3 + 1 + 2 + 3");
  four := io.await(Countdown(_n : i32(3)).map(x => (x + i32(1))).map(x => (x + i32(2))).map(x => (x + i32(3))).map(x => (x + i32(4))).collect(io), io);
  assert(four(usize(0)) == i32(13), "four maps: 3 + 1 + 2 + 3 + 4");
  alt := io.await(Countdown(_n : i32(3)).map(x => (x * i32(2))).take(usize(2)).map(x => (x + i32(1))).collect(io), io);
  assert(alt.len() == usize(2), "map, take, map: the take applies");
  assert(alt(usize(1)) == i32(5), "and the outer map sees the inner one's values: 2 * 2 + 1");
});
// ---------------------------------------------------------------------------
// S4. Each combinator, awaited from inside a spawned task
// ---------------------------------------------------------------------------
test("Test Stream map inside a spawned task", {
  got := _bounded(Countdown(_n : i32(3)).map(x => (x * i32(10))), io);
  assert(got.len() == usize(3), "map is length-preserving");
  assert(got(usize(0)) == i32(30), "first mapped");
  assert(got(usize(2)) == i32(10), "last mapped");
});
test("Test Stream filter inside a spawned task", {
  got := _bounded(Countdown(_n : i32(6)).filter(x => ((x % i32(2)) == i32(0))), io);
  assert(got.len() == usize(3), "three even values in 6..1");
  assert(got(usize(0)) == i32(6), "6 first");
  assert(got(usize(2)) == i32(2), "2 last");
});
test("Test Stream filter that keeps nothing", {
  got := _bounded(Countdown(_n : i32(4)).filter(x => (x > i32(100))), io);
  assert(got.len() == usize(0), "a predicate no item satisfies drains to empty, it does not hang");
});
test("Test Stream filter_map inside a spawned task", {
  got := _bounded(
    Countdown(_n : i32(5)).filter_map(
      x => cond((x > i32(3)) => Option(i32).Some(x + i32(100)), true => Option(i32).None)
    ),
    io
  );
  assert(got.len() == usize(2), "5 and 4 pass the filter half");
  assert(got(usize(0)) == i32(105), "and the map half applied");
  assert(got(usize(1)) == i32(104), "second");
});
test("Test Stream take inside a spawned task", {
  got := _bounded(Countdown(_n : i32(10)).take(usize(3)), io);
  assert(got.len() == usize(3), "take(3) stops at three");
  assert(got(usize(0)) == i32(10), "first");
  assert(got(usize(2)) == i32(8), "third");
});
test("Test Stream take beyond the end of the stream", {
  got := _bounded(Countdown(_n : i32(2)).take(usize(9)), io);
  assert(got.len() == usize(2), "take(9) over a 2-item stream yields 2, then finishes");
});
test("Test Stream take(0) yields nothing", {
  got := _bounded(Countdown(_n : i32(5)).take(usize(0)), io);
  assert(got.len() == usize(0), "take(0) is an empty stream");
});
test("Test Stream skip inside a spawned task", {
  got := _bounded(Countdown(_n : i32(5)).skip(usize(2)), io);
  assert(got.len() == usize(3), "5 items minus the first 2");
  assert(got(usize(0)) == i32(3), "the third item is first now");
});
test("Test Stream skip past the end of the stream", {
  got := _bounded(Countdown(_n : i32(2)).skip(usize(5)), io);
  assert(got.len() == usize(0), "skipping more items than exist finishes the stream");
});
// ---------------------------------------------------------------------------
// S5. A chain of combinators
// ---------------------------------------------------------------------------
test("Test a Stream combinator chain", {
  // 10..1 -> evens (10 8 6 4 2) -> +1 (11 9 7 5 3) -> first two.
  got := _bounded(Countdown(_n : i32(10)).filter(x => ((x % i32(2)) == i32(0))).map(x => (x + i32(1))).take(usize(2)), io);
  assert(got.len() == usize(2), "the chain yields two items");
  assert(got(usize(0)) == i32(11), "first");
  assert(got(usize(1)) == i32(9), "second");
});
// ---------------------------------------------------------------------------
// S6. for_each, from `main` and from a task
// ---------------------------------------------------------------------------
test("Test Stream for_each from main", {
  seen := ArrayList(i32).new();
  io.await(
    Countdown(_n : i32(3)).for_each(x => {
      seen.push(x);
    }, io),
    io
  );
  assert(seen.len() == usize(3), "the body ran once per item");
  assert(seen(usize(0)) == i32(3), "in order");
});
test("Test Stream for_each inside a spawned task", {
  seen := ArrayList(i32).new();
  // The chain is built OUTSIDE the task body on purpose: a closure argument
  // written inside an `io.async` body loses the future's result type
  // (issues/fixed/closure-argument-inside-an-io-async-body-loses-the-future-result-type.md).
  drain := Countdown(_n : i32(4)).for_each(x => {
    seen.push(x);
  }, io);
  h := io.spawn(drain, io);
  r := io.await(timeout(h, Duration.from_millis(i64(5000)), io), io);
  assert(r.is_ok(), "for_each finished inside the deadline");
  assert(seen.len() == usize(4), "every item reached the body");
});
// ---------------------------------------------------------------------------
// S7. The hand-written consumer loop — what `for_await` (S8) expands to
// (issues/fixed/io-await-inside-a-macro-expansion-is-emitted-as-a-blocking-await.md)
// ---------------------------------------------------------------------------
test("Test a hand-written consumer loop inside a spawned task", {
  seen := ArrayList(i32).new();
  c := Countdown(_n : i32(3));
  task := io.async({ c, seen }(io : Io) => {
    (done : bool) = false;
    while(done == false, {
      nx := io.await(c.next(io), io);
      match(
        nx,
        .Some(v) => {
          seen.push(v * i32(2));
        },
        .None => {
          done = true;
        }
      );
    });
    seen.len()
  });
  h := io.spawn(task, io);
  r := io.await(timeout(h, Duration.from_millis(i64(5000)), io), io);
  assert(match(r, .Ok(n) => (n == usize(3)), .Err(_) => false), "the task looped over every item");
  assert(seen(usize(0)) == i32(6), "and the body's effect is visible outside");
});
test("Test a hand-written consumer loop over an empty stream", {
  seen := ArrayList(i32).new();
  c := Countdown(_n : i32(0));
  (done : bool) = false;
  while(done == false, {
    nx := io.await(c.next(io), io);
    match(
      nx,
      .Some(v) => {
        seen.push(v);
      },
      .None => {
        done = true;
      }
    );
  });
  assert(seen.len() == usize(0), "no items, no body");
});
// ---------------------------------------------------------------------------
// S8. `for_await`: the loop of async iteration. Its await comes from a macro
// expansion, which is a real suspension point since the single-pass lowering
// (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 5).
// ---------------------------------------------------------------------------
test("Test for_await from main", {
  seen := ArrayList(i32).new();
  for_await(Countdown(_n : i32(3)), io, x => {
    seen.push(x);
  });
  assert(seen.len() == usize(3), "the body ran once per item");
  assert(seen(usize(0)) == i32(3), "in order");
});
test("Test for_await inside a spawned task, with continue and break", {
  seen := ArrayList(i32).new();
  c := Countdown(_n : i32(6));
  task := io.async({ c, seen }(io : Io) => {
    for_await(c, io, x => {
      if(x == i32(5), {
        continue;
      });
      if(x == i32(2), {
        break;
      });
      seen.push(x);
    });
  });
  h := io.spawn(task, io);
  r := io.await(timeout(h, Duration.from_millis(i64(5000)), io), io);
  assert(r.is_ok(), "for_await finished inside the deadline");
  assert(seen.len() == usize(3), "6, then 5 skipped, 4 and 3, then 2 breaks");
  assert((seen(usize(0)) == i32(6)) && ((seen(usize(1)) == i32(4)) && (seen(usize(2)) == i32(3))), "6 4 3");
});
_first_even :: (fn(c : Countdown, io : Io) -> Impl(Future(i32, Io)))(
  io.async({ c }(io : Io) => {
    for_await(c, io, x => {
      if((x % i32(2)) == i32(0), {
        return(x);
      });
    });
    i32(-1)
  })
);
test("Test for_await with a return from the enclosing task", {
  assert(io.await(_first_even(Countdown(_n : i32(5)), io), io) == i32(4), "the first even item is returned");
  assert(io.await(_first_even(Countdown(_n : i32(1)), io), io) == i32(-1), "no even item: the loop ends");
});
/// A stream whose `next` yields to the loop before answering.
Ticker :: struct(_n : i32);
impl(
  Ticker,
  Stream(
    Item : i32,
    next : (fn(self : &mut Self, io : Io) -> Impl(Future(Option(i32), Io)))(
      io.async({ &mut self }(io : Io) => {
        io.await(yield(io), io);
        cond(
          (self._n <= i32(0)) => Option(i32).None,
          true => {
            v := self._n;
            self._n = (self._n - i32(1));
            Option(i32).Some(v)
          }
        )
      })
    )
  )
);
test("Test for_await suspends its task between items", {
  ticks := Rc(i32)(0);
  seen := ArrayList(i32).new();
  t := Ticker(_n : i32(3));
  task := io.async({ t, seen, ticks }(io : Io) => {
    for_await(t, io, x => {
      seen.push(ticks.*);
    });
  });
  h := io.spawn(task, io);
  (i : i32) = i32(0);
  while(i < i32(20), {
    ticks.* = (ticks.* + i32(1));
    io.await(yield(io), io);
    i = (i + i32(1));
  });
  r := io.await(timeout(h, Duration.from_millis(i64(5000)), io), io);
  assert(r.is_ok(), "the task finished");
  assert(seen.len() == usize(3), "one entry per item");
  // A blocking await would run the whole loop inside the spawn, before main
  // ticks once, and record 0 0 0.
  assert(seen(usize(2)) > seen(usize(0)), "main ran between the task's items");
});
// issues/fixed/an-io-async-body-never-releases-a-closure-parameter-bound-by-a-type-variable.md
(mut(g_fe_disposed) : i32) = i32(0);
_FeThing :: ref(struct(n : i32));
impl(
  _FeThing,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_fe_disposed = (g_fe_disposed + i32(1));
    })
  )
);
test("Stream.for_each releases what its body closure captures", {
  before := g_fe_disposed;
  {
    t := _FeThing(n : i32(2));
    total := Rc(i32)(0);
    io.await(
      Countdown(_n : i32(3)).for_each(x => {
        total.* = (total.* + (x * t.n));
      }, io),
      io
    );
    assert(total.* > i32(0), "the body ran");
  };
  assert((g_fe_disposed - before) == i32(1), `the captured value was released once, released ${g_fe_disposed - before}`);
});
// issues/fixed/2026-10-14-a-capture-in-a-generic-io-async-body-is-retained-with-another-instantiations-type.md
// `collect` owns its stream through a capture list (`io.async({ self }…)`, in
// the blanket impl). A stream holding an `Rc` gets its capture retained field
// by field, and the retain temps were declared with whichever chain's types
// the capture struct registered first: two chains of different shapes in one
// binary failed the C compile.
/// A countdown that keeps its counter in an `Rc` cell.
RcCountdown :: struct(_n : Rc(i32));
impl(
  RcCountdown,
  Stream(
    Item : i32,
    next : (fn(self : &mut Self, io : Io) -> Impl(Future(Option(i32), Io)))(
      io.async({ &mut self }(io : Io) =>
        cond(
          (self._n.* <= i32(0)) => Option(i32).None,
          true => {
            v := self._n.*;
            self._n.* = (self._n.* - i32(1));
            Option(i32).Some(v)
          }
        ))
    )
  )
);
test("Test collect over chains of different shapes whose source holds an Rc", {
  a := io.await(RcCountdown(_n : rc(i32(4))).map(x => (x * i32(10))).map(x => (x + i32(1))).collect(io), io);
  b := io.await(RcCountdown(_n : rc(i32(4))).filter(x => (x > i32(1))).filter(x => (x < i32(4))).collect(io), io);
  c := io.await(RcCountdown(_n : rc(i32(4))).map(x => (x * i32(10))).filter(x => (x > i32(20))).collect(io), io);
  assert(a.len() == usize(4), "map then map keeps every item");
  assert(a(usize(0)) == i32(41), "and applies both maps: 4 * 10 + 1");
  assert(b.len() == usize(2), "filter then filter keeps 3 and 2");
  assert(c.len() == usize(2), "map then filter keeps 40 and 30");
});
