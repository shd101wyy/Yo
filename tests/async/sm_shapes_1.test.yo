//! The async state-machine shape corpus
//! (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 0.4 / §8): await placement
//! crossed with every control-flow construct, generated from the audit's
//! shape sweep. Each test is DIFFERENTIAL — the async body, with its inner
//! future either suspending (a yield) or completing synchronously, must
//! return exactly what the same body returns written synchronously.
pragma(Pragma.SkipWasm32Emscripten); // uses the async runtime end-to-end
pragma(Pragma.SkipWasm32Wasi);
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ yield } :: import("std/async");
_sv :: (fn(x : i32) -> i32)(x);
_svb :: (fn(x : bool) -> bool)(x);
_svs :: (fn(x : i32) -> String)(x.to_string());
_v :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => {
  io2.await(yield(io2), io2);
  x
}));
_vb :: (fn(x : bool, io : Io) -> Impl(Future(bool, Io)))(io.async((io2 : Io) => {
  io2.await(yield(io2), io2);
  x
}));
_vs :: (fn(x : i32, io : Io) -> Impl(Future(String, Io)))(io.async((io2 : Io) => {
  io2.await(yield(io2), io2);
  x.to_string()
}));
_vsync :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => x));
_vbs :: (fn(x : bool, io : Io) -> Impl(Future(bool, Io)))(io.async((io2 : Io) => x));
_vss :: (fn(x : i32, io : Io) -> Impl(Future(String, Io)))(io.async((io2 : Io) => x.to_string()));
// cases/a02_bind.yo
_r_cases_a02_bind :: (fn(n : i32) -> i32)({
  a := _sv(n);
  b := _sv(a + i32(1));
  (a * i32(10)) + b
});
_y_cases_a02_bind :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    a := e.await(_v(n, e), e);
    b := e.await(_v(a + i32(1), e), e);
    (a * i32(10)) + b
  })
);
_s_cases_a02_bind :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    a := e.await(_vsync(n, e), e);
    b := e.await(_vsync(a + i32(1), e), e);
    (a * i32(10)) + b
  })
);
test("shape a02_bind", {
  assert(io.await(_y_cases_a02_bind(i32(0), io), io) == _r_cases_a02_bind(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_a02_bind(i32(0), io), io) == _r_cases_a02_bind(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_a02_bind(i32(1), io), io) == _r_cases_a02_bind(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_a02_bind(i32(1), io), io) == _r_cases_a02_bind(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_a02_bind(i32(3), io), io) == _r_cases_a02_bind(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_a02_bind(i32(3), io), io) == _r_cases_a02_bind(i32(3)), "synchronous inner future, n=3");
});

// cases/a05_condval2.yo
_r_cases_a05_condval2 :: (fn(n : i32) -> i32)({
  r := cond((n > i32(1)) => _sv(i32(10)), true => i32(20));
  r + n
});
_y_cases_a05_condval2 :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    r := cond((n > i32(1)) => e.await(_v(i32(10), e), e), true => i32(20));
    r + n
  })
);
_s_cases_a05_condval2 :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    r := cond((n > i32(1)) => e.await(_vsync(i32(10), e), e), true => i32(20));
    r + n
  })
);
test("shape a05_condval2", {
  assert(io.await(_y_cases_a05_condval2(i32(0), io), io) == _r_cases_a05_condval2(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_a05_condval2(i32(0), io), io) == _r_cases_a05_condval2(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_a05_condval2(i32(1), io), io) == _r_cases_a05_condval2(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_a05_condval2(i32(1), io), io) == _r_cases_a05_condval2(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_a05_condval2(i32(3), io), io) == _r_cases_a05_condval2(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_a05_condval2(i32(3), io), io) == _r_cases_a05_condval2(i32(3)), "synchronous inner future, n=3");
});

// cases/a07_if_else.yo
_r_cases_a07_if_else :: (fn(n : i32) -> i32)({
  (x : i32) = i32(0);
  if(n > i32(1), {
    x = _sv(n);
  }, {
    x = _sv(n + i32(50));
  });
  x
});
_y_cases_a07_if_else :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(n > i32(1), {
      x = e.await(_v(n, e), e);
    }, {
      x = e.await(_v(n + i32(50), e), e);
    });
    x
  })
);
_s_cases_a07_if_else :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(n > i32(1), {
      x = e.await(_vsync(n, e), e);
    }, {
      x = e.await(_vsync(n + i32(50), e), e);
    });
    x
  })
);
test("shape a07_if_else", {
  assert(io.await(_y_cases_a07_if_else(i32(0), io), io) == _r_cases_a07_if_else(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_a07_if_else(i32(0), io), io) == _r_cases_a07_if_else(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_a07_if_else(i32(1), io), io) == _r_cases_a07_if_else(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_a07_if_else(i32(1), io), io) == _r_cases_a07_if_else(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_a07_if_else(i32(3), io), io) == _r_cases_a07_if_else(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_a07_if_else(i32(3), io), io) == _r_cases_a07_if_else(i32(3)), "synchronous inner future, n=3");
});

// cases/a09_cond3_mid_val.yo
_r_cases_a09_cond3_mid_val :: (fn(n : i32) -> i32)({
  r := cond(
    (n == i32(0)) => i32(7),
    (n == i32(1)) => _sv(i32(8)),
    true => i32(9)
  );
  r + i32(1000)
});
_y_cases_a09_cond3_mid_val :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    r := cond(
      (n == i32(0)) => i32(7),
      (n == i32(1)) => e.await(_v(i32(8), e), e),
      true => i32(9)
    );
    r + i32(1000)
  })
);
_s_cases_a09_cond3_mid_val :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    r := cond(
      (n == i32(0)) => i32(7),
      (n == i32(1)) => e.await(_vsync(i32(8), e), e),
      true => i32(9)
    );
    r + i32(1000)
  })
);
test("shape a09_cond3_mid_val", {
  assert(io.await(_y_cases_a09_cond3_mid_val(i32(0), io), io) == _r_cases_a09_cond3_mid_val(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_a09_cond3_mid_val(i32(0), io), io) == _r_cases_a09_cond3_mid_val(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_a09_cond3_mid_val(i32(1), io), io) == _r_cases_a09_cond3_mid_val(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_a09_cond3_mid_val(i32(1), io), io) == _r_cases_a09_cond3_mid_val(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_a09_cond3_mid_val(i32(3), io), io) == _r_cases_a09_cond3_mid_val(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_a09_cond3_mid_val(i32(3), io), io) == _r_cases_a09_cond3_mid_val(i32(3)), "synchronous inner future, n=3");
});

// cases/a12_match_stmt_assign.yo
E_cases_a12_match_stmt_assign :: enum(A(v : i32), B(w : i32, z : i32), C);

_r_cases_a12_match_stmt_assign :: (fn(n : i32) -> i32)({
  ev := cond((n == i32(0)) => E_cases_a12_match_stmt_assign.A(i32(5)), (n == i32(1)) => E_cases_a12_match_stmt_assign.B(i32(6), i32(7)), true => E_cases_a12_match_stmt_assign.C);
  (x : i32) = i32(0);
  match(
    ev,
    .A(v) => {
      x = _sv(v);
      x = (x + v);
    },
    .B(w, z) => {
      t := _sv(w);
      x = (t + w + z);
    },
    .C => {
      x = _sv(i32(99));
    }
  );
  x + n
});
_y_cases_a12_match_stmt_assign :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    ev := cond((n == i32(0)) => E_cases_a12_match_stmt_assign.A(i32(5)), (n == i32(1)) => E_cases_a12_match_stmt_assign.B(i32(6), i32(7)), true => E_cases_a12_match_stmt_assign.C);
    (x : i32) = i32(0);
    match(
      ev,
      .A(v) => {
        x = e.await(_v(v, e), e);
        x = (x + v);
      },
      .B(w, z) => {
        t := e.await(_v(w, e), e);
        x = (t + w + z);
      },
      .C => {
        x = e.await(_v(i32(99), e), e);
      }
    );
    x + n
  })
);
_s_cases_a12_match_stmt_assign :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    ev := cond((n == i32(0)) => E_cases_a12_match_stmt_assign.A(i32(5)), (n == i32(1)) => E_cases_a12_match_stmt_assign.B(i32(6), i32(7)), true => E_cases_a12_match_stmt_assign.C);
    (x : i32) = i32(0);
    match(
      ev,
      .A(v) => {
        x = e.await(_vsync(v, e), e);
        x = (x + v);
      },
      .B(w, z) => {
        t := e.await(_vsync(w, e), e);
        x = (t + w + z);
      },
      .C => {
        x = e.await(_vsync(i32(99), e), e);
      }
    );
    x + n
  })
);
test("shape a12_match_stmt_assign", {
  assert(io.await(_y_cases_a12_match_stmt_assign(i32(0), io), io) == _r_cases_a12_match_stmt_assign(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_a12_match_stmt_assign(i32(0), io), io) == _r_cases_a12_match_stmt_assign(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_a12_match_stmt_assign(i32(1), io), io) == _r_cases_a12_match_stmt_assign(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_a12_match_stmt_assign(i32(1), io), io) == _r_cases_a12_match_stmt_assign(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_a12_match_stmt_assign(i32(3), io), io) == _r_cases_a12_match_stmt_assign(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_a12_match_stmt_assign(i32(3), io), io) == _r_cases_a12_match_stmt_assign(i32(3)), "synchronous inner future, n=3");
});

