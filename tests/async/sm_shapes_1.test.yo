// cases/a15_two_ifs.yo
_r_cases_a15_two_ifs :: (fn(n : i32) -> i32)({
  (x : i32) = i32(0);
  if(n > i32(0), {
    x = (x + _sv(i32(1)));
  });
  if(n > i32(2), {
    x = (x + _sv(i32(10)));
  });
  x + n
});
_y_cases_a15_two_ifs :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(n > i32(0), {
      x = (x + e.await(_v(i32(1), e), e));
    });
    if(n > i32(2), {
      x = (x + e.await(_v(i32(10), e), e));
    });
    x + n
  })
);
_s_cases_a15_two_ifs :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(n > i32(0), {
      x = (x + e.await(_vsync(i32(1), e), e));
    });
    if(n > i32(2), {
      x = (x + e.await(_vsync(i32(10), e), e));
    });
    x + n
  })
);
test("shape a15_two_ifs", {
  assert(io.await(_y_cases_a15_two_ifs(i32(0), io), io) == _r_cases_a15_two_ifs(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_a15_two_ifs(i32(0), io), io) == _r_cases_a15_two_ifs(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_a15_two_ifs(i32(1), io), io) == _r_cases_a15_two_ifs(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_a15_two_ifs(i32(1), io), io) == _r_cases_a15_two_ifs(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_a15_two_ifs(i32(3), io), io) == _r_cases_a15_two_ifs(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_a15_two_ifs(i32(3), io), io) == _r_cases_a15_two_ifs(i32(3)), "synchronous inner future, n=3");
