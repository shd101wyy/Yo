      cond(
        (a < n) => {
          acc = (acc + a);
        },
        true => {
          b := e.await(_vsync(a * i32(2), e), e);
          if(b > i32(0), {
            return(acc + (b * i32(1000)));
          });
          acc = (acc + i32(77));
