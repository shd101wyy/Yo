// cases/a17_nested_if3.yo
_r_cases_a17_nested_if3 :: (fn(n : i32) -> i32)({
  (x : i32) = i32(0);
  if(n > i32(0), {
    a := _sv(n);
    if(a > i32(1), {
      b := _sv(a + i32(1));
      if(b > i32(3), {
        x = _sv(a + b);
      }, {
        x = i32(-1);
      });
    });
    x = (x + a);
  });
  x
});
_y_cases_a17_nested_if3 :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(n > i32(0), {
      a := e.await(_v(n, e), e);
      if(a > i32(1), {
        b := e.await(_v(a + i32(1), e), e);
        if(b > i32(3), {
          x = e.await(_v(a + b, e), e);
        }, {
          x = i32(-1);
        });
      });
      x = (x + a);
    });
    x
  })
);
_s_cases_a17_nested_if3 :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(n > i32(0), {
      a := e.await(_vsync(n, e), e);
      if(a > i32(1), {
        b := e.await(_vsync(a + i32(1), e), e);
        if(b > i32(3), {
          x = e.await(_vsync(a + b, e), e);
        }, {
          x = i32(-1);
        });
      });
      x = (x + a);
    });
    x
  })
);
test("shape a17_nested_if3", {
  assert(io.await(_y_cases_a17_nested_if3(i32(0), io), io) == _r_cases_a17_nested_if3(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_a17_nested_if3(i32(0), io), io) == _r_cases_a17_nested_if3(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_a17_nested_if3(i32(1), io), io) == _r_cases_a17_nested_if3(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_a17_nested_if3(i32(1), io), io) == _r_cases_a17_nested_if3(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_a17_nested_if3(i32(3), io), io) == _r_cases_a17_nested_if3(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_a17_nested_if3(i32(3), io), io) == _r_cases_a17_nested_if3(i32(3)), "synchronous inner future, n=3");
});

// cases/a18_await_cond_cond.yo
_r_cases_a18_await_cond_cond :: (fn(n : i32) -> i32)({
  (x : i32) = i32(0);
  if(_svb(n > i32(1)), {
    x = i32(5);
  }, {
    x = i32(6);
  });
  x
});
_y_cases_a18_await_cond_cond :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(e.await(_vb(n > i32(1), e), e), {
      x = i32(5);
    }, {
      x = i32(6);
    });
    x
  })
);
_s_cases_a18_await_cond_cond :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(e.await(_vbs(n > i32(1), e), e), {
      x = i32(5);
    }, {
      x = i32(6);
    });
    x
  })
);
test("shape a18_await_cond_cond", {
  assert(io.await(_y_cases_a18_await_cond_cond(i32(0), io), io) == _r_cases_a18_await_cond_cond(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_a18_await_cond_cond(i32(0), io), io) == _r_cases_a18_await_cond_cond(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_a18_await_cond_cond(i32(1), io), io) == _r_cases_a18_await_cond_cond(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_a18_await_cond_cond(i32(1), io), io) == _r_cases_a18_await_cond_cond(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_a18_await_cond_cond(i32(3), io), io) == _r_cases_a18_await_cond_cond(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_a18_await_cond_cond(i32(3), io), io) == _r_cases_a18_await_cond_cond(i32(3)), "synchronous inner future, n=3");
});

// cases/a19_await_match_scrut.yo
_r_cases_a19_await_match_scrut :: (fn(n : i32) -> i32)({
  r := match(_sv(n), i32(3) => i32(30), i32(1) => _sv(i32(10)), _ => i32(0));
  r + n
});
_y_cases_a19_await_match_scrut :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
