//! Await-site fusion (plans/reference/ASYNC_AWAIT_SITE_FUSION.md §5): an await of
//! a single-await `io.async` wrapper runs the wrapper in its caller. Fusion
//! changes no observable behavior, so every case here must give the same
//! result with the lowering on (the default) and off (`YO_ASYNC_FUSION=0`).
{ assert } :: import("std/assert");
{ Error, Exception, IoExn } :: import("std/error");
{ String } :: import("std/string");
{ ToString } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ RefCell } :: import("std/sync/refcell");
{ sleep } :: import("std/sys/timer");
{ Path } :: import("std/path");
{ remove_file, rename } :: import("std/fs/dir");
{ exists } :: import("std/fs/file");
Boom :: struct(msg : String);
impl(Boom, ToString(to_string : (self -> self.msg.clone())));
impl(Boom, Error());
derive(Boom, Clone);
// The awaited leaf: a future with no await of its own.
_leaf :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(io.async((e : Io) => n));
// A fusable wrapper: a prologue, then one await, then a tail that throws for
// a big value (std's `NetError.check` shape).
_checked :: (fn(n : i32, io : Io) -> Impl(Future(i32, IoExn)))({
  k := (n + i32(1));
  io.async(e => {
    r := e.io.await(_leaf(k, e.io), e.io);
    cond(
      (r > i32(100)) => e.exn.throw(dyn(Boom(msg : `too big: ${r}`))),
      true => r
    )
  })
});
// Its caller: awaits the wrapper directly (the fused site).
_caller :: (fn(n : i32, io : Io) -> Impl(Future(i32, IoExn)))(
  io.async(e => {
    v := e.io.await(_checked(n, e.io), e);
    v * i32(2)
  })
);
// One frame further out, for a handler installed two frames up.
_outer :: (fn(n : i32, io : Io) -> Impl(Future(i32, IoExn)))(
  io.async(e => {
    v := e.io.await(_caller(n, e.io), e);
    v + i32(1)
  })
);
test("a fused wrapper's value reaches its caller", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  v := io.await(_caller(i32(4), io), IoExn(io : io, exn : exn));
  assert(v == i32(10), "(4 + 1) * 2");
});
_unwound_caller :: (fn(io : Io) -> bool)({
  exn := Exception(
    throw : (
      err -> {
        unwind(true);
      }
    )
  );
  _v := io.await(_caller(i32(200), io), IoExn(io : io, exn : exn));
  false
});
test("a throw in a fused tail unwinds to the caller's handler", {
  assert(_unwound_caller(io), "the handler's unwind value is the function's result");
});
_unwound_two_up :: (fn(io : Io) -> bool)({
  exn := Exception(
    throw : (
      err -> {
        unwind(true);
      }
    )
  );
  _v := io.await(_outer(i32(300), io), IoExn(io : io, exn : exn));
  false
});
test("a throw in a fused tail unwinds to a handler two frames up", {
  assert(_unwound_two_up(io), "the outer handler catches it");
});
// Side effects in the prologue and the arguments run once, in order.
// The log is one list the caller, the prologue and the block all reach: a
// shared cell, since an `ArrayList` is a value (decision 46, B8).
_log_push :: (fn(log : &Rc(RefCell(ArrayList(i32))), x : i32) -> i32)({
  log.with_mut(l => l.push(x));
  x
});
(mut(g_fusion_arg_runs) : i32) = i32(0);
_log_len_at_arg :: (fn(log : &Rc(RefCell(ArrayList(i32)))) -> i32)({
  g_fusion_arg_runs = (g_fusion_arg_runs + i32(1));
  i32(log.with(l => l.len()))
});
_logged :: (fn(log : &Rc(RefCell(ArrayList(i32))), n : i32, io : Io) -> Impl(Future(i32, IoExn)))({
  _p := _log_push(log, i32(2));
  h := Rc.clone(log);
  io.async(e => {
    r := e.io.await(_leaf(n, e.io), e.io);
    _q := _log_push(&h, i32(3));
    r
  })
});
test("prologue and argument effects run once, in order", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  // The argument reads `log` and counts its runs in a global.
  log := Rc.new(RefCell(ArrayList(i32)).new(ArrayList(i32).new()));
  v := io.await(_logged(&log, _log_len_at_arg(&log), io), IoExn(io : io, exn : exn));
  assert(v == i32(0), "the argument ran first, before the prologue's push");
  assert(g_fusion_arg_runs == i32(1), "the argument ran once");
  assert(log.with(l => l.len()) == usize(2), "two effects in the callee");
  assert(log.with(l => l.get(usize(0)).unwrap()) == i32(2), "prologue first");
  assert(log.with(l => l.get(usize(1)).unwrap()) == i32(3), "block second");
});
// Two awaits of one wrapper in one caller, and one in a loop.
_twice_and_loop :: (fn(io : Io) -> Impl(Future(i32, IoExn)))(
  io.async(e => {
    a := e.io.await(_checked(i32(1), e.io), e);
    b := e.io.await(_checked(i32(2), e.io), e);
    (mut(sum) : i32) = i32(0);
    (mut(i) : i32) = i32(0);
    while(i < i32(5), i = (i + i32(1)), {
      x := e.io.await(_checked(i, e.io), e);
      sum = (sum + x);
    });
    a + b + sum
  })
);
test("fused awaits of one wrapper, twice and in a loop", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  v := io.await(_twice_and_loop(io), IoExn(io : io, exn : exn));
  assert(v == i32(20), "(1+1) + (2+1) + (1+2+3+4+5)");
});
// A fused await in a cond arm.
_in_arm :: (fn(flag : bool, io : Io) -> Impl(Future(i32, IoExn)))(
  io.async(e => {
    r := cond(
      flag => {
        x := e.io.await(_checked(i32(10), e.io), e);
        x
      },
      true => i32(0)
    );
    r
  })
);
test("a fused await in a cond arm", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  assert(io.await(_in_arm(true, io), IoExn(io : io, exn : exn)) == i32(11), "the taken arm");
  assert(io.await(_in_arm(false, io), IoExn(io : io, exn : exn)) == i32(0), "the other arm");
});
// A bound future is not a fused site: the ordinary path.
_bound :: (fn(io : Io) -> Impl(Future(i32, IoExn)))(
  io.async(e => {
    f := _checked(i32(20), e.io);
    v := e.io.await(f, e);
    v
  })
);
test("a bound future keeps the ordinary path", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  assert(io.await(_bound(io), IoExn(io : io, exn : exn)) == i32(21), "20 + 1");
});
// A fused wrapper that suspends for real (a timer), awaited from a spawned
// task that is aborted while it waits there.
_nap :: (fn(ms : u64, io : Io) -> Impl(Future(u64, IoExn)))({
  d := ms;
  io.async(e => {
    e.io.await(sleep(d), e.io);
    d
  })
});
_napper :: (fn(io : Io) -> Impl(Future(u64, IoExn)))(
  io.async(e => {
    v := e.io.await(_nap(u64(10000), e.io), e);
    v
  })
);
test("aborting a task suspended at a fused await cancels the wait", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  h := io.spawn(_napper(io), IoExn(io : io, exn : exn));
  io.await(sleep(u64(5)), io);
  h.abort();
  assert(h.await(io).is_none(), "an aborted task has no result");
});
// Nested fusion (F3): a wrapper whose one await is itself a fusable wrapper
// runs both blocks in the caller (§3.1, up to depth 4).
_twice_checked :: (fn(n : i32, io : Io) -> Impl(Future(i32, IoExn)))({
  m := (n * i32(2));
  io.async(e => {
    r := e.io.await(_checked(m, e.io), e);
    r + i32(1)
  })
});
_nest2 :: (fn(n : i32, io : Io) -> Impl(Future(i32, IoExn)))(
  io.async(e => {
    v := e.io.await(_twice_checked(n, e.io), e);
    v
  })
);
test("a fused wrapper nested in a fused wrapper gives its value", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  // 3 * 2 = 6, + 1 in _checked = 7, + 1 in _twice_checked = 8.
  assert(io.await(_nest2(i32(3), io), IoExn(io : io, exn : exn)) == i32(8), "both blocks ran");
});
_nest2_unwound :: (fn(io : Io) -> bool)({
  exn := Exception(
    throw : (
      err -> {
        unwind(true);
      }
    )
  );
  _v := io.await(_nest2(i32(60), io), IoExn(io : io, exn : exn));
  false
});
test("a throw two fused blocks deep unwinds to the caller's handler", {
  assert(_nest2_unwound(io), "60 * 2 + 1 > 100 throws in the inner block");
});
// A chain of five wrappers: fusion stops at depth 4, and the fifth runs as its
// own task. The value is the same either way: n + 5.
_d1 :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    r := e.await(_leaf(n, e), e);
    r + i32(1)
  })
);
_d2 :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    r := e.await(_d1(n, e), e);
    r + i32(1)
  })
);
_d3 :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    r := e.await(_d2(n, e), e);
    r + i32(1)
  })
);
_d4 :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    r := e.await(_d3(n, e), e);
    r + i32(1)
  })
);
_d5 :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    r := e.await(_d4(n, e), e);
    r + i32(1)
  })
);
test("a chain of five fusable wrappers gives its value past the depth limit", {
  assert(io.await(_d5(i32(10), io), io) == i32(15), "10 + 5");
});
// Two wrappers that await each other are recursive through the fused path
// (§3.1 rule 5): codegen must terminate and not fuse the cycle. They are only
// reached behind a runtime false, since running them never ends.
_ping :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    r := e.await(_pong(n, e), e);
    r
  })
);
_pong :: (fn(n : i32, io : Io) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    r := e.await(_ping(n, e), e);
    r
  })
);
_maybe_ping :: (fn(go : bool, io : Io) -> Impl(Future(i32)))(
  io.async((e : Io) => {
    r := cond(
      go => e.await(_ping(i32(1), e), e),
      true => i32(0)
    );
    r
  })
);
test("mutually recursive wrappers compile, and are not fused into each other", {
  assert(io.await(_maybe_ping(runtime(i32(0) > i32(1)), io), io) == i32(0), "the cycle is never entered");
});
// A fused wrapper's names are its own. The wrapper and its block are emitted
// inside the caller's match arm, and an arm binding is not in their scope,
// whatever its name: each case below binds a name the wrapper also declares
// (issues/fixed/2026-11-07-a-fused-await-reads-the-callers-match-binding-of-the-wrappers-name.md).
// The arm's `n` against `_checked`'s parameter `n`, read by its prologue.
_arm_binds_a_parameter_name :: (fn(io : Io) -> Impl(Future(i32, IoExn)))(
  io.async(
    e => match(
      Option(i32).Some(i32(50)),
      .Some(n) => {
        v := e.io.await(_checked(i32(4), e.io), e);
        v + n
      },
      .None => i32(0)
    )
  )
);
test("a caller's arm binding does not shadow a fused wrapper's parameter", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  v := io.await(_arm_binds_a_parameter_name(io), IoExn(io : io, exn : exn));
  assert(v == i32(55), "(4 + 1) + 50");
});
// The arm's `k` against `_checked`'s prologue local `k`, read by its block.
_arm_binds_a_local_name :: (fn(io : Io) -> Impl(Future(i32, IoExn)))(
  io.async(
    e => match(
      Option(i32).Some(i32(50)),
      .Some(k) => {
        v := e.io.await(_checked(i32(4), e.io), e);
        v + k
      },
      .None => i32(0)
    )
  )
);
test("a caller's arm binding does not shadow a fused wrapper's local", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  v := io.await(_arm_binds_a_local_name(io), IoExn(io : io, exn : exn));
  assert(v == i32(55), "(4 + 1) + 50");
});
// `sink` is the shape `build test` died on: the wrapper's capture owns the
// argument and the caller's arm owns its own binding, so reading the second
// as the first releases it twice and leaks the argument.
_len_plus_one :: (fn(sink(name) : String, io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(e => {
    r := e.io.await(_leaf(i32(1), e.io), e.io);
    name.len() + usize(r)
  })
);
_arm_binds_a_sink_name :: (fn(io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(
    e => match(
      Option(String).Some(String.from("the arm's own binding")),
      .Some(name) => {
        v := e.io.await(_len_plus_one(String.from("arg"), e.io), e);
        v + name.len()
      },
      .None => usize(0)
    )
  )
);
test("a caller's arm binding does not shadow a fused wrapper's sink parameter", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  v := io.await(_arm_binds_a_sink_name(io), IoExn(io : io, exn : exn));
  assert(v == usize(25), "(3 + 1) + 21");
});
// A borrowing arm binds a pointer to the part. A wrapper's value of the same
// name is no pointer, so it must not be read through one.
_arm_binds_a_place_of_the_name :: (fn(o : &Option(i32), io : Io) -> Impl(Future(i32, IoExn)))({
  own := o.*;
  io.async(
    e => match(
      &own,
      .Some(n) => {
        v := e.io.await(_checked(i32(4), e.io), e);
        v + n.*
      },
      .None => i32(0)
    )
  )
});
test("a borrowing arm binding does not shadow a fused wrapper's parameter", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "no throw expected");
        unwind(());
      }
    )
  );
  v := io.await(_arm_binds_a_place_of_the_name(&Option(i32).Some(i32(50)), io), IoExn(io : io, exn : exn));
  assert(v == i32(55), "(4 + 1) + 50");
});

// An escape inside a fused site is the awaited future's abort: the caller's
// resume function releases nothing there, and the state machine's dispose
// releases what the caller owns, once
// (issues/fixed/2026-11-07-a-fused-block-that-throws-drops-its-by-value-capture-twice.md).
// First the call's own by-value argument, held by the site's capture, in the
// scopes that hand a consumed value to the escape paths.
_throws_taking :: (fn(sink(name) : String, io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(e => {
    r := e.io.await(_leaf(i32(1), e.io), e.io);
    cond(
      (r > i32(0)) => e.exn.throw(dyn(Boom(msg : name.clone()))),
      true => name.len()
    )
  })
);
_throw_in_an_arm :: (fn(io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(
    e => match(
      Option(String).Some(String.from("the arm's own binding")),
      .Some(name) => {
        v := e.io.await(_throws_taking(String.from("arg"), e.io), e);
        v + name.len()
      },
      .None => usize(0)
    )
  )
);
_throw_in_a_loop :: (fn(io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(e => {
    (mut(i) : usize) = usize(0);
    (mut(total) : usize) = usize(0);
    while(i < usize(2), i = (i + usize(1)), {
      total = (total + e.io.await(_throws_taking(String.from("arg"), e.io), e));
    });
    total
  })
);
_throw_in_a_block :: (fn(io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(e => {
    w := {
      v := e.io.await(_throws_taking(String.from("arg"), e.io), e);
      v + usize(1)
    };
    w + usize(1)
  })
);
// Each runs one of the three to its throw: the handler's unwind value says the
// thrown message was the wrapper's argument.
_caught_arg :: (fn(which : i32, io : Io) -> bool)({
  exn := Exception(
    throw : (
      err -> {
        unwind(err.to_string() == String.from("arg"));
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  _v := cond(
    (which == i32(0)) => io.await(_throw_in_an_arm(io), e),
    (which == i32(1)) => io.await(_throw_in_a_loop(io), e),
    true => io.await(_throw_in_a_block(io), e)
  );
  false
});
test("a throw in a fused block releases the call's argument once (match arm)", {
  assert(_caught_arg(i32(0), io), "the thrown message is the wrapper's argument");
});
test("a throw in a fused block releases the call's argument once (loop body)", {
  assert(_caught_arg(i32(1), io), "the thrown message is the wrapper's argument");
});
test("a throw in a fused block releases the call's argument once (nested block)", {
  assert(_caught_arg(i32(2), io), "the thrown message is the wrapper's argument");
});
// The caller's temps: an earlier statement's, released before the site, and
// the arguments' own. First the shape of src/fetch.yo's store install: `rename`
// over a path that is not there, after an `exists` await.
_land :: (fn(sink(tmp) : String, sink(final_dir) : String, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    landed := e.io.await(exists(Path.new(final_dir.clone()), e.io), e.io);
    if(landed, {
      e.io.await(remove_file(Path.new(tmp.clone()), e.io), e);
    }, {
      e.io.await(rename(Path.new(tmp.clone()), Path.new(final_dir.clone()), e.io), e);
    });
  })
);
// The same with nothing of the file system in it. These wrappers stand below
// their caller on purpose: a drop's position gates compare a caller's temp with
// the escape point, and a wrapper above its caller in one file reads as coming
// before the temp, which hides the release.
_land_lent :: (fn(sink(tmp) : String, sink(final_dir) : String, parked : bool, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    blank := e.io.await(_is_blank(final_dir.clone(), e.io), e);
    cond(
      blank => (),
      parked => e.io.await(_parks_then_throws(tmp.clone(), e.io), e),
      true => e.io.await(_throws_lent(tmp.clone(), e.io), e)
    );
  })
);
_is_blank :: (fn(s : &String, io : Io) -> Impl(Future(bool, IoExn)))({
  n := s.len();
  io.async(e => {
    a := e.io.await(_leaf(i32(1), e.io), e.io);
    b := e.io.await(_leaf(i32(2), e.io), e.io);
    (n + usize(a + b)) == usize(0)
  })
});
_raise_for :: (fn(text : &String, exn : Exception) -> unit)({
  if(text.len() > usize(0), {
    exn.throw(dyn(Boom(msg : text.clone())));
  });
});
_throws_lent :: (fn(s : &String, io : Io) -> Impl(Future(unit, IoExn)))({
  owned := s.clone();
  io.async(e => {
    r := e.io.await(_leaf(i32(1), e.io), e.io);
    _raise_for(&owned, e.exn);
    ()
  })
});
// A block that suspends for real before it throws.
_parks_then_throws :: (fn(s : &String, io : Io) -> Impl(Future(unit, IoExn)))({
  owned := s.clone();
  io.async(e => {
    e.io.await(sleep(u64(1)), e.io);
    _raise_for(&owned, e.exn);
    ()
  })
});
_caught_landing :: (fn(which : i32, io : Io) -> bool)({
  exn := Exception(
    throw : (
      err -> {
        unwind(true);
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  a := String.from("/nonexistent/yo-fusion-test/from");
  b := String.from("/nonexistent/yo-fusion-test/to");
  cond(
    (which == i32(0)) => io.await(_land(a, b, io), e),
    (which == i32(1)) => io.await(_land_lent(a, b, false, io), e),
    true => io.await(_land_lent(a, b, true, io), e)
  );
  false
});
test("a failed rename fused after an earlier await releases each caller temp once", {
  assert(_caught_landing(i32(0), io), "renaming a path that is not there throws");
});
test("a throw fused after an earlier await releases each caller temp once", {
  assert(_caught_landing(i32(1), io), "the wrapper throws");
});
test("a throw after a real suspension in a fused block reaches the caller's handler", {
  assert(_caught_landing(i32(2), io), "the wrapper throws once its timer fires");
});
// A prologue escape leaves the wrapper, as at a call: its own by-value
// parameter is released, once, and the argument is not the caller's any more.
_throws_in_prologue :: (fn(sink(name) : String, io : Io, exn : Exception) -> Impl(Future(usize, IoExn)))({
  n := name.len();
  if(n > usize(3), {
    exn.throw(dyn(Boom(msg : name.clone())));
  });
  io.async(e => {
    r := e.io.await(_leaf(i32(1), e.io), e.io);
    usize(r) + name.len()
  })
});
_prologue_caller :: (fn(sink(name) : String, io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(e => {
    v := e.io.await(_throws_in_prologue(name.clone(), e.io, e.exn), e);
    v + usize(1)
  })
);
_caught_in_prologue :: (fn(name : &String, io : Io) -> usize)({
  exn := Exception(
    throw : (
      err -> {
        unwind(err.to_string().len());
      }
    )
  );
  io.await(_prologue_caller(name.clone(), io), IoExn(io : io, exn : exn))
});
test("a throw in a fused wrapper's prologue releases its argument", {
  assert(_caught_in_prologue(&String.from("long enough"), io) == usize(11), "the thrown message is the argument");
});
test("a fused wrapper's prologue that does not throw runs its block", {
  assert(_caught_in_prologue(&String.from("ab"), io) == usize(4), "(1 + 2) + 1");
});
