//! The io.await/io.spawn effect-bundle contract
//! (issues/fixed/io-await-effect-arg-not-checked-memcpy-overflow.md): the
//! effect argument must have the future's own bundle layout. A smaller or
//! different record used to be accepted silently — codegen memcpy'd
//! sizeof(the future's E) out of it (ASan stack-buffer-overflow on every CI
//! test leg, 2026-08-27).
{ assert } :: import("std/assert");
{ Exception, IoExn } :: import("std/error");
{ Mutex } :: import("std/async/mutex");
{ sleep } :: import("std/time/sleep");
{ Duration } :: import("std/time/duration");
IO_timer :: import("std/sys/timer");
{ IoFuture } :: import("std/sys/future");

give :: (fn(io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(e => usize(11))
);
test("mismatched effect records are rejected at check time", {
  // A one-field record for an IoExn future: wrong layout.
  comptime_expect_error(io.await(give(io), .{ io }));
  // A bare Io for an IoExn future: wrong layout.
  comptime_expect_error(io.await(give(io), io));
  assert(true, "both rejected");
});
test("matching bundles still pass", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  a := io.await(give(io), IoExn(io : io, exn : exn));
  // An anonymous record with EXACTLY the bundle's fields has its layout.
  b := io.await(give(io), .{ io, exn });
  assert((a == usize(11)) && (b == usize(11)), "typed and structural bundles both work");
});
// ---------------------------------------------------------------------------
// A bundled future is never viewed as a bundle-less `Future(T)`, whatever its
// bundle: an await through the view injects nothing, and the body called a
// null handler
// (issues/fixed/a-bundled-future-viewed-as-future-t-runs-with-a-zeroed-bundle-and-segfaults.md);
// an `Io` bundle is no exception, the body reads its `io` from the bundle
// (VERDICTS-68, issues/questions/2026-11-19-a-future-viewed-as-bundle-less-runs-with-a-zeroed-io.md).
// ---------------------------------------------------------------------------
/// A handler bundle: `tell` is called through by the body.
Tell :: (fn(x : i32) -> i32);
TellCtx :: struct(io : Io, tell : Tell);
tells :: (fn(io : Io) -> Impl(Future(i32, TellCtx)))(
  io.async((ctx : TellCtx) => ctx.tell(i32(3)))
);
/// A view that names no bundle.
await_view :: (fn(sink(f) : Impl(Future(i32)), io : Io) -> i32)(io.await(f, io));
/// A spawn through a view that names no bundle.
spawn_view :: (fn(sink(f) : Impl(Future(i32)), io : Io) -> JoinHandle(i32))(io.spawn(f, io));
/// An `Io`-bundled future, typed with its bundle.
io_only :: (fn(io : Io) -> Impl(Future(i32, Io)))(io.async((io : Io) => i32(4)));
test("a handler-bundled future cannot be viewed as Future(T)", {
  comptime_expect_error(await_view(tells(io), io));
  assert(true, "rejected at check time");
});
test("an Io-bundled future cannot be viewed as Future(T)", {
  // The parameter view.
  comptime_expect_error(await_view(io_only(io), io), "Name the bundle");
  // A spawn through the view.
  comptime_expect_error(spawn_view(io_only(io), io), "Name the bundle");
  // The return-position view.
  comptime_expect_error((fn(io : Io) -> Impl(Future(i32)))(io.async((io : Io) => i32(4))), "Name the bundle");
  // A `Dyn(Future(T))` slot: no `Dyn` lists `Future` (E0614, VERDICTS-80).
  f := io_only(io);
  comptime_expect_error({
    (_d : Dyn(Future(i32))) = dyn(&f);
  }, "cannot be made: `Future` has no vtable slot");
  // A local annotation.
  comptime_expect_error({
    (_f : Impl(Future(i32))) = io_only(io);
  }, "Name the bundle");
  // A generic `R` returned through `with_lock`'s `Impl(Future(R, Io))`.
  m := Mutex(i32).new(i32(1));
  comptime_expect_error(_lock_view(&m, &mut (v => (v.* + i32(1))), io));
  assert(true, "every view rejected at check time");
});
/// A generic view over `Mutex.with_lock`'s `Impl(Future(R, Io))`: rejected
/// at each concrete `R`.
_lock_view :: (fn(generic(R : Type), m : &Mutex(i32), body : &mut Impl(FnMut(v : &mut i32) -> R), io : Io) -> Impl(Future(R)))(
  m.with_lock(body, io)
);
/// A generic function's bundle-less result over a handler-bundled body: the
/// view is judged at each instantiation
/// (issues/fixed/2026-11-24-a-generic-fns-bundle-less-future-result-hides-its-bundle.md).
_generic_view :: (fn(generic(R : Type), _x : R, io : Io) -> Impl(Future(i32)))(
  io.async((ctx : TellCtx) => ctx.tell(i32(3)))
);
test("a generic fn's bundle-less future result cannot hide a handler bundle", {
  comptime_expect_error(_generic_view(i32(1), io), "Name the bundle");
  assert(true, "rejected at the instantiation");
});
test("an Io-bundled future keeps its bundle in the type", {
  assert(io.await(io_only(io), io) == i32(4), "awaited through its own type");
  h := io.spawn(io_only(io), io);
  assert(match(h.await(io), .Some(v) => v, .None => i32(0)) == i32(4), "spawned with its bundle");
});
/// A raw `IoFuture` reads no bundle: it flows into any bundle's type.
_raw_as_io :: (fn(f : IoFuture) -> Impl(Future(i32, Io)))(f);
_raw_as_ctx :: (fn(f : IoFuture) -> Impl(Future(i32, TellCtx)))(f);
test("a raw IoFuture flows into Future(T, Io)", {
  assert(io.await(_raw_as_io(IO_timer.sleep(u64(0))), io) >= i32(0), "an IoFuture viewed with the Io bundle");
  t :: (fn(x : i32) -> i32)(x);
  assert(io.await(_raw_as_ctx(IO_timer.sleep(u64(0))), TellCtx(io : io, tell : t)) >= i32(0), "an IoFuture viewed with a handler bundle");
});
/// A struct-bundled task awaits `sleep` with the bundle's `io`.
_SleepCtx :: struct(io : Io, n : i32);
_sleeper :: (fn(io : Io) -> Impl(Future(i32, _SleepCtx)))(
  io.async((ctx : _SleepCtx) => {
    ctx.io.await(sleep(Duration.from_millis(i64(1)), ctx.io), ctx.io);
    ctx.n
  })
);
test("a struct-bundled task awaits sleep(d, ctx.io) with ctx.io as the bundle", {
  assert(io.await(_sleeper(io), _SleepCtx(io : io, n : i32(7))) == i32(7), "slept, then read its bundle");
  // `sleep`'s future reads an `Io`: the struct is not its bundle.
  comptime_expect_error(io.await(sleep(Duration.from_millis(i64(1)), io), _SleepCtx(io : io, n : i32(7))), "effect bundle");
});
// Same labels, different handler TYPE: a different bundle
// (plans/archive/ASYNC_IO_API_AUDIT.md F6).
OtherTell :: (fn(x : bool) -> i32);
test("a bundle with the right labels and a wrong handler type is rejected", {
  t_bool :: (fn(x : bool) -> i32)(i32(0));
  comptime_expect_error(io.await(tells(io), .{ io, tell : t_bool }));
  assert(true, "rejected at check time");
});
// `Future` takes one effect argument, and the `...(E)` effect-row spread was
// removed (2026-10-03, issues/fixed/effect-row-spreads-outlived-the-single-bundle-future.md):
// a spread in `Future` and the `generic(...(E))` row-variable declaration are
// both check errors. An effect row is `generic(E : Type.Struct)`.
test("a ...(E) effect-row spread is a check error", {
  comptime_expect_error(Impl(Future(i32, ...(TellCtx))));
  comptime_expect_error((fn(generic(...(E)), x : i32) -> i32));
  assert(true, "both rejected at check time");
});
// ---------------------------------------------------------------------------
// §3.13 A6 (plans/VALUES_BY_DEFAULT.md): `io.await`/`io.spawn` copy the bundle
// into the future they start, so a bundle field that is not implicitly
// copyable is an error at the site.
// ---------------------------------------------------------------------------
_A6Tok :: struct(n : i32);
impl(_A6Tok, Drop(drop : (fn(self : &mut Self) -> unit)(())));
_A6Ctx :: struct(io : Io, tok : _A6Tok);
_a6_work :: (fn(io : Io) -> Impl(Future(i32, _A6Ctx)))(
  io.async((ctx : _A6Ctx) => ctx.tok.n)
);
test("a move-only bundle field is rejected where the bundle is copied (§3.13 A6)", {
  comptime_expect_error(io.await(_a6_work(io), _A6Ctx(io : io, tok : _A6Tok(n : i32(1)))), "is not implicitly copyable");
  comptime_expect_error(io.spawn(_a6_work(io), _A6Ctx(io : io, tok : _A6Tok(n : i32(1)))), "is not implicitly copyable");
  assert(true, "both rejected");
});
