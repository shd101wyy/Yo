//! State-machine ownership regressions from the async state-machine audit
//! (plans/ASYNC_STATE_MACHINE_GENERATION.md, phase 1). Each test is one issue's
//! repro. Leaks are observed through a `Dispose` counter (CI runs with
//! detect_leaks=0); use-after-frees are caught by the test runner's ASan.
pragma(Pragma.SkipWasm32Emscripten); // uses the async runtime end-to-end
pragma(Pragma.SkipWasm32Wasi);
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ yield } :: import("std/async");
{ sleep } :: import("std/sys/timer");
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ __yo_async_yield_start } :: import("std/sys/externs");
{ IoFuture } :: import("std/sys/future");
{ Error, Exception, IoExn } :: import("std/error");
{ ToString } :: import("std/fmt");

(g_disposed : i32) = i32(0);
Thing :: ref(struct(n : i32));
impl(
  Thing,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      g_disposed = (g_disposed + i32(1));
    })
  )
);

_leaf :: (fn(v : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    v
  })
);

// issues/fixed/async-second-cond-arm-await-of-a-field-future-frees-it.md
Holder :: ref(struct(fut : IoFuture));
_second_arm_await_of_field :: (fn(h : Holder, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (out : i32) = i32(0);
    cond(
      (out == i32(0)) => {
        a := e.await(_leaf(i32(1), e), e);
        b := e.await(h.fut, e);
        out = (a + b);
      },
      true => {
        out = i32(5);
      }
    );
    out
  })
);
test("a cond arm's second await of a field-held future leaves the field's reference alone", {
  h := Holder(fut : unsafe(__yo_async_yield_start()));
  r := io.await(_second_arm_await_of_field(h, io), io);
  assert(r == i32(1), "the arm's awaits both ran");
  // Read the field's future again: it used to be freed by the arm's await.
  r2 := io.await(h.fut, io);
  assert(r2 == i32(0), "the field's future is still alive");
});

// issues/fixed/named-future-awaited-in-a-while-emits-missing-await-future-field.md
_named_future_in_loop :: (fn(n : i64, io : Io) -> Impl(Future(i64, Io)))(
  io.async((io : Io) => {
    f := _leaf(i32(2), io);
    (acc : i64) = i64(0);
    (i : i64) = i64(0);
    while(runtime(i < n), {
      v := io.await(f, io);
      acc = (acc + i64(v));
      i = (i + i64(1));
    });
    acc
  })
);
test("a named future awaited inside a while loop", {
  r := io.await(_named_future_in_loop(i64(3), io), io);
  assert(r == i64(6), "every iteration reads the same completed future");
});

// issues/fixed/awaiting-an-already-started-future-from-a-state-machine-leaks-it.md
test("awaiting an already-running future from a state machine releases it", {
  before := g_disposed;
  {
    f := io.async((io : Io) => {
      io.await(sleep(u64(5)), io);
      Thing(n : i32(7))
    });
    hf := io.spawn(f, io);
    a := io.async((io : Io) => {
      v := io.await(f, io);
      v.n
    });
    r := io.await(a, io);
    assert(r == i32(7), "the awaiter read the running future's result");
    _rf := hf.await(io);
  };
  assert(g_disposed == (before + i32(1)), "the future (and its Thing result) is disposed");
});

// issues/fixed/abort-dispose-never-drops-string-option-and-value-struct-locals.md
Pair :: struct(t : Thing, label : String);
test("an aborted task drops its Option and value-struct locals", {
  before := g_disposed;
  {
    task := io.async((io : Io) => {
      o := Option(Thing).Some(Thing(n : i32(1)));
      p := Pair(t : Thing(n : i32(2)), label : String.from("pair"));
      s := `held ${i32(3)}`;
      io.await(yield(io), io);
      match(o, .Some(q) => q.n, .None => i32(0)) + p.t.n + i32(s.len())
    });
    h := io.spawn(task, io);
    h.abort();
    r := h.await(io);
    assert(r.is_none(), "the task was aborted");
  };
  // The aborted task's queued resume runs its aborted-entry guard, which
  // releases it: give the loop the turns that takes.
  (spins : i32) = i32(0);
  while(runtime((g_disposed < (before + i32(2))) && (spins < i32(100))), {
    io.await(yield(io), io);
    spins = (spins + i32(1));
  });
  assert(g_disposed == (before + i32(2)), "the Option's and the struct's Things are dropped");
});

// issues/fixed/nested-io-async-string-capture-is-not-retained.md
test("a nested io.async capturing a state machine's String retains it", {
  before := g_disposed;
  outer := io.async((io : Io) => {
    s := String.from("abcdef");
    t := Thing(n : i32(3));
    io.await(yield(io), io);
    r := io.await(
      io.async((io : Io) => {
        io.await(yield(io), io);
        s.len() + usize(t.n)
      }),
      io
    );
    r + s.len()
  });
  r := io.await(outer, io);
  assert(r == usize(15), "the outer machine's String survives the inner future");
  assert(g_disposed == (before + i32(1)), "the captured Thing is released exactly once");
});

// issues/fixed/reassigning-a-heap-local-from-an-await-leaks-the-old-value.md
_mk_thing :: (fn(n : i32, io : Io) -> Impl(Future(Thing, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    Thing(n : n)
  })
);
test("reassigning a heap local from an await releases the old value", {
  before := g_disposed;
  {
    task := io.async((io : Io) => {
      t := Thing(n : i32(1));
      t = io.await(_mk_thing(i32(2), io), io);
      t = io.await(_mk_thing(i32(3), io), io);
      t.n
    });
    r := io.await(task, io);
    assert(r == i32(3), "the last reassignment wins");
  };
  assert(g_disposed == (before + i32(3)), "all three Things are disposed");
});

// issues/fixed/tail-primitive-match-with-three-arms-redefines-continuation-fn.md
_tail_match :: (fn(k : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async(
    (io : Io) => match(
      k,
      0 => i32(10),
      1 => io.await(_leaf(i32(20), io), io),
      _ => i32(30)
    )
  )
);
test("a primitive match with three arms as the body's tail", {
  a := io.await(_tail_match(i32(0), io), io);
  b := io.await(_tail_match(i32(1), io), io);
  c := io.await(_tail_match(i32(2), io), io);
  assert((a == i32(10)) && (b == i32(20)) && (c == i32(30)), "each arm's value");
});

// issues/fixed/async-cond-value-with-await-arm-inside-while-yields-zero.md
_classify_cond :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (total : i32) = i32(0);
    (i : i32) = i32(0);
    while(runtime(i < n), {
      v := cond(
        (i == i32(0)) => i32(1),
        (i == i32(2)) => e.await(_leaf(i32(100), e), e),
        true => i32(10)
      );
      total = (total + v);
      i = (i + i32(1));
    });
    total
  })
);
_classify_match :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (total : i32) = i32(0);
    (i : i32) = i32(0);
    while(runtime(i < n), {
      v := match(
        i,
        0 => i32(1),
        2 => e.await(_leaf(i32(100), e), e),
        _ => i32(10)
      );
      total = (total + v);
      i = (i + i32(1));
    });
    total
  })
);
test("a value-position cond or match with an awaiting arm inside a while", {
  // 1 + 10 + 100 + 10
  assert(io.await(_classify_cond(i32(4), io), io) == i32(121), "cond value");
  assert(io.await(_classify_match(i32(4), io), io) == i32(121), "match value");
});

// issues/fixed/a-non-send-closure-reading-a-global-marks-it-thread-reached.md
(g_counter : i32) = i32(0);
test("two io.async closures that update a module global", {
  t1 := io.async((io : Io) => {
    io.await(yield(io), io);
    g_counter = (g_counter + i32(1));
  });
  t2 := io.async((io : Io) => {
    io.await(yield(io), io);
    g_counter = (g_counter + i32(2));
  });
  h1 := io.spawn(t1, io);
  h2 := io.spawn(t2, io);
  _a := h1.await(io);
  _b := h2.await(io);
  assert(g_counter == i32(3), "both tasks ran on the loop's own thread");
});

// issues/fixed/async-abort-dispose-double-drops-moved-enum-payload.md (the binding pair)
test("an aborted task drops a pattern binding's scrutinee once", {
  before := g_disposed;
  {
    task := io.async((io : Io) => {
      o := Option(Thing).Some(Thing(n : i32(5)));
      match(
        o,
        .Some(q) => {
          io.await(yield(io), io);
          q.n
        },
        .None => i32(0)
      )
    });
    h := io.spawn(task, io);
    h.abort();
    r := h.await(io);
    assert(r.is_none(), "the task was aborted");
  };
  (spins : i32) = i32(0);
  while(runtime((g_disposed < (before + i32(1))) && (spins < i32(100))), {
    io.await(yield(io), io);
    spins = (spins + i32(1));
  });
  io.await(yield(io), io);
  assert(g_disposed == (before + i32(1)), "the Thing is disposed exactly once");
});

// issues/fixed/reassigned-heap-local-in-an-arm-after-a-loop-await-leaks.md
_reassign_in_arm_after_loop_await :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (i : i32) = i32(0);
    (last : Thing) = Thing(n : i32(0));
    while(i < i32(10), {
      e.await(_leaf(i, e), e);
      if(i == n, {
        last = Thing(n : i32(1));
        i = i32(100);
      }, {
        i = (i + i32(1));
      });
    });
    last.n
  })
);
test("a heap local reassigned in an arm after a loop await releases the old value", {
  g_disposed = i32(0);
  r := io.await(_reassign_in_arm_after_loop_await(i32(3), io), io);
  assert(r == i32(1), "the arm's reassignment is the task's result");
  assert(g_disposed == i32(2), "the replaced value and the final one are both disposed");
});

// issues/fixed/an-aborted-task-releases-a-local-it-moved-before-its-await.md
(g_kept_things : ArrayList(Thing)) = ArrayList(Thing).new();
_keep_thing :: (fn(own(t) : Thing) -> unit)({
  g_kept_things.push(t);
});
_move_then_sleep :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(7));
    _keep_thing(t);
    e.await(sleep(u64(50)), e);
    i32(1)
  })
);
test("an aborted task does not release a local it moved before its await", {
  g_disposed = i32(0);
  h := io.spawn(_move_then_sleep(io), io);
  io.await(yield(io), io);
  h.abort();
  _r := h.await(io);
  assert(g_disposed == i32(0), "the moved value belongs to its new owner");
  g_kept_things.clear();
  assert(g_disposed == i32(1), "the new owner releases it exactly once");
});
// issues/fixed/a-bare-block-in-an-io-async-body-keeps-its-locals-until-the-task-ends.md
_bare_block_then_await :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (seen : i32) = i32(-1);
    {
      a := Thing(n : i32(1));
      e.await(yield(e), e);
      seen = a.n;
    };
    seen = g_disposed;
    e.await(yield(e), e);
    seen
  })
);
test("a bare block's heap local is released at the block's end, not the task's", {
  g_disposed = i32(0);
  r := io.await(_bare_block_then_await(io), io);
  assert(r == i32(1), "the block's value is disposed before the next statement runs");
  assert(g_disposed == i32(1), "and exactly once");
});
// Phase 6 (plans/ASYNC_STATE_MACHINE_GENERATION.md): heap locals of sibling
// scopes have disjoint live ranges, so they share one slot. Every drop of the
// slot zeroes it, and the abort dispose drops the slot once.
_sibling_scope_things :: (fn(nap : u64, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (sum : i32) = i32(0);
    {
      a := Thing(n : i32(1));
      e.await(yield(e), e);
      sum = (sum + a.n);
    };
    {
      b := Thing(n : i32(2));
      e.await(sleep(nap), e);
      sum = (sum + b.n);
    };
    sum
  })
);
test("two heap locals of sibling scopes share a slot, each disposed once", {
  g_disposed = i32(0);
  r := io.await(_sibling_scope_things(u64(0), io), io);
  assert(r == i32(3), "each block reads its own value after its await");
  assert(g_disposed == i32(2), "each value is disposed once");
});
/// Spawn the two-block task, abort it while it sleeps in the second block,
/// and drop the handle; the count seen before the abort is the result.
_abort_in_the_second_block :: (fn(io : Io) -> i32)({
  h := io.spawn(_sibling_scope_things(u64(50), io), io);
  io.await(sleep(u64(10)), io);
  seen := g_disposed;
  h.abort();
  _r := h.await(io);
  seen
});
test("aborting a task in the second of two sibling scopes that share a slot", {
  g_disposed = i32(0);
  seen := _abort_in_the_second_block(io);
  assert(seen == i32(1), "the first block's value is gone, the second is held");
  assert(g_disposed == i32(2), "the abort disposes the second value once");
});
// An `inout` binding through an object pins it (a hidden owning local); in a
// state machine the pin lives in a task slot, released once at the end of its
// scope or by the abort dispose.
_pin_across_await :: (fn(nap : u64, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    o := Thing(n : i32(1));
    inout(r) := o.n;
    o = Thing(n : i32(5));
    e.await(sleep(nap), e);
    r = (r + i32(1));
    r + o.n
  })
);
test("a pinned object is released once when the task completes", {
  g_disposed = i32(0);
  r := io.await(_pin_across_await(u64(0), io), io);
  assert(r == i32(7), "the binding writes the pinned object, o is the new one");
  assert(g_disposed == i32(2), "the pinned object and the new one are each disposed once");
});
_abort_pinned :: (fn(io : Io) -> unit)({
  h := io.spawn(_pin_across_await(u64(50), io), io);
  io.await(sleep(u64(10)), io);
  h.abort();
  _r := h.await(io);
});
test("a pinned object is released once when the task is aborted", {
  g_disposed = i32(0);
  _abort_pinned(io);
  assert(g_disposed == i32(2), "the abort disposes the pin and the handle's object once each");
});
// issues/fixed/a-local-copied-from-a-captured-value-in-an-io-async-body-does-not-compile.md
_alias_sleeper :: (fn(t : Thing, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    s := t;
    e.await(sleep(u64(50)), e);
    s.n
  })
);
_abort_alias :: (fn(io : Io) -> unit)({
  h := io.spawn(_alias_sleeper(Thing(n : i32(1)), io), io);
  io.await(sleep(u64(10)), io);
  h.abort();
  _r := h.await(io);
});
test("an aborted task does not release a local copied from its capture", {
  g_disposed = i32(0);
  _abort_alias(io);
  assert(g_disposed == i32(1), "the capture releases it once; the copy owns nothing");
});
// issues/fixed/a-cancelled-dup-drop-pair-zeroes-a-state-machine-slot-still-read.md
ThingHolder :: ref(struct(t : Thing, n : i32));
_store_then_read :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(3));
    e.await(yield(e), e);
    h := ThingHolder(t : t, n : t.n);
    e.await(yield(e), e);
    h.n + t.n
  })
);
test("a local stored in a field stays readable across the next await", {
  g_disposed = i32(0);
  r := io.await(_store_then_read(io), io);
  assert(r == i32(6), "both reads see the stored local");
  assert(g_disposed == i32(1), "the local and the field share one object, released once");
});
_store_then_sleep :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(3));
    e.await(yield(e), e);
    h := ThingHolder(t : t, n : t.n);
    e.await(sleep(u64(50)), e);
    h.n + t.n
  })
);
_abort_store :: (fn(io : Io) -> unit)({
  h := io.spawn(_store_then_sleep(io), io);
  io.await(sleep(u64(10)), io);
  h.abort();
  _r := h.await(io);
});
test("aborting a task after it stored a local in a field releases the local once", {
  g_disposed = i32(0);
  _abort_store(io);
  assert(g_disposed == i32(1), "the abort releases the local and the holder, and the object once");
});
// An awaitless `match` in a task whose `.Err` arm MOVES its payload into a
// thrown `dyn`: the handler unwinds, and the aborted task's dispose must not
// drop that payload a second time through the scrutinee
// (issues/fixed/async-abort-dispose-double-drops-moved-enum-payload.md, the
// move-out pair). `keep` shares the payload's Thing: exactly one release
// leaves its count at 1, a double drop takes it to 0, a leak leaves it at 2.
Oops :: ref(struct(thing : Thing));
impl(Oops, ToString(to_string : (self -> String.from("oops"))));
impl(Oops, Error());
_classify :: (fn(t : Thing) -> Result(i32, Oops))(Result(i32, Oops).Err(Oops(thing : t)));
_move_into_throw :: (fn(t : Thing, io : Io) -> Impl(Future(i32, IoExn)))(
  io.async((e : IoExn) => {
    e.io.await(yield(e.io), e.io);
    match(
      _classify(t),
      .Err(o) => e.exn.throw(dyn(o)),
      .Ok(v) => v
    )
  })
);
_throw_moved :: (fn(t : Thing, io : Io) -> bool)({
  exn := Exception(throw : (_err -> unwind(true)));
  _v := io.await(_move_into_throw(t, io), IoExn(io : io, exn : exn));
  false
});
test("an arm that moves its payload into a thrown dyn: the aborted task releases it once", {
  g_disposed = i32(0);
  keep := Thing(n : i32(7));
  assert(_throw_moved(keep, io), "the throw unwinds to the handler");
  assert(rc(keep) == 1, "the thrown payload and the task's scrutinee released it once between them");
  assert(g_disposed == i32(0), "keep is still alive");
});

// issues/fixed/a-break-or-continue-in-an-io-async-loop-never-releases-its-slot-locals.md
_break_slot_local :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (k : i32) = i32(0);
    while(runtime(true), {
      t := Thing(n : k);
      e.await(yield(e), e);
      k = (t.n + i32(1));
      cond(
        (k >= i32(3)) => {
          break;
        },
        true => ()
      );
    });
    k
  })
);
test("a break out of an awaiting while releases the iteration's slot local", {
  before := g_disposed;
  r := io.await(_break_slot_local(io), io);
  assert(r == i32(3), "the loop's value");
  assert((g_disposed - before) == i32(3), `each iteration's Thing was released once, released ${g_disposed - before}`);
});
_continue_slot_local :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (k : i32) = i32(0);
    (sum : i32) = i32(0);
    while(runtime(k < i32(6)), {
      k = (k + i32(1));
      t := Thing(n : k);
      e.await(yield(e), e);
      cond(
        ((t.n % i32(2)) == i32(0)) => {
          continue;
        },
        true => ()
      );
      sum = (sum + t.n);
    });
    sum
  })
);
test("a continue in an awaiting while releases the iteration's slot local", {
  before := g_disposed;
  r := io.await(_continue_slot_local(io), io);
  assert(r == i32(9), "the sum of the odd iterations");
  assert((g_disposed - before) == i32(6), `each iteration's Thing was released once, released ${g_disposed - before}`);
});
// issues/fixed/an-argument-dup-temp-in-an-io-async-body-is-dropped-through-an-unassigned-slot.md
_take_n :: (fn(t : Thing, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    e.await(yield(e), e);
    t.n
  })
);
_arg_dup_in_task :: (fn(keep : ArrayList(Thing), io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    x := e.await(_take_n(keep(usize(0)), e), e);
    x
  })
);
test("an argument read out of a container inside a task is released", {
  before := g_disposed;
  {
    keep := ArrayList(Thing).new();
    keep.push(Thing(n : i32(7)));
    r := io.await(_arg_dup_in_task(keep, io), io);
    assert(r == i32(7), "the task's value");
  };
  assert((g_disposed - before) == i32(1), `the Thing was released with its list, released ${g_disposed - before}`);
});
// issues/fixed/an-early-return-from-an-io-async-body-never-releases-a-slot-local-its-tail-moves.md
_early_return_slot_local :: (fn(early : bool, io : Io) -> Impl(Future(Thing, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(1));
    e.await(yield(e), e);
    if(early, {
      return(Thing(n : i32(2)));
    });
    t
  })
);
test("an early return releases the slot local the tail would have moved", {
  before := g_disposed;
  {
    a := io.await(_early_return_slot_local(true, io), io);
    assert(a.n == i32(2), "the early value");
    b := io.await(_early_return_slot_local(false, io), io);
    assert(b.n == i32(1), "the tail value");
  };
  assert((g_disposed - before) == i32(3), `every Thing was released once, released ${g_disposed - before}`);
});
// issues/fixed/async-abort-dispose-double-drops-moved-enum-payload.md
_bound_then_moved :: (fn(bad : bool, io : Io) -> Impl(Future(Option(String), IoExn)))(
  io.async((e : IoExn) => {
    r := cond(
      bad => Result(String, String).Err(String.from("bad input")),
      true => Result(String, String).Ok(String.from("fine"))
    );
    match(
      r,
      .Err(msg) => {
        e.io.await(yield(e.io), e.io);
        e.exn.throw(dyn(msg))
      },
      .Ok(v) => .Some(v)
    )
  })
);
_catch_bound_then_moved :: (fn(io : Io) -> String)({
  exn := Exception(throw : (err -> unwind(err.to_string())));
  _r := io.await(_bound_then_moved(true, io), IoExn(io : io, exn : exn));
  String.from("not reached")
});
test("a pattern binding moved after an await in its arm is released once", {
  assert(_catch_bound_then_moved(io) == `bad input`, "the thrown binding reached the handler");
});
// issues/fixed/a-closure-literal-argument-inside-an-io-async-body-never-releases-its-captures.md
_run_now :: (fn(f : Impl(Fn() -> i32)) -> i32)(f());
_closure_arg_in_sync_task :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(4));
    _run_now(() => t.n)
  })
);
_closure_arg_in_awaiting_task :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(6));
    e.await(yield(e), e);
    _run_now(() => t.n)
  })
);
test("a closure literal passed as an argument inside a task releases its captures", {
  before := g_disposed;
  a := io.await(_closure_arg_in_sync_task(io), io);
  b := io.await(_closure_arg_in_awaiting_task(io), io);
  assert((a + b) == i32(10), "both closures read their capture");
  assert((g_disposed - before) == i32(2), `each captured Thing was released once, released ${g_disposed - before}`);
});
// issues/fixed/a-spawned-futures-temp-across-an-await-never-releases-its-creation-reference.md
_spawn_leaf :: (fn(io : Io) -> Impl(Future(Thing, Io)))(
  io.async((e : Io) => {
    e.await(yield(e), e);
    Thing(n : i32(1))
  })
);
_spawn_across_await :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    h := e.spawn(_spawn_leaf(e), e);
    e.await(yield(e), e);
    match(h.await(e), .Some(t) => t.n, .None => i32(-1))
  })
);
test("a spawned future's temp that crosses an await is released", {
  before := g_disposed;
  r := io.await(_spawn_across_await(io), io);
  assert(r == i32(1), "the spawned task's value");
  assert((g_disposed - before) == i32(1), `the spawned task's result was released once, released ${g_disposed - before}`);
});
// issues/fixed/a-move-out-of-a-task-slot-empties-it-before-the-consuming-call-runs.md
_MvReport :: struct(items : ArrayList(Thing), n : usize, extra : i32);
// Overwrites the stack the suspended task's resume frame used, so a value
// the task kept in a C local across the suspension reads garbage, whatever
// the frame layout (issues/fixed/an-earlier-argument-read-after-an-await-in-a-later-argument-is-stale.md).
_scrub_stack :: (fn(k : u64) -> u64)({
  (buf : Array(u64, 512)) = Array(u64, 512).fill(k);
  (i : usize) = usize(0);
  (s : u64) = u64(0);
  while(i < usize(512), {
    s = (s + buf(i));
    i = (i + usize(1));
  });
  s
});
_count_later :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    e.await(yield(e), e);
    _ := _scrub_stack(u64(777));
    i32(3)
  })
);
_move_then_read :: (fn(io : Io) -> Impl(Future(_MvReport, Io)))(
  io.async((e : Io) => {
    xs := ArrayList(Thing).new();
    xs.push(Thing(n : i32(1)));
    xs.push(Thing(n : i32(2)));
    e.await(yield(e), e);
    _MvReport(items : xs, n : xs.len(), extra : e.await(_count_later(e), e))
  })
);
test("a later argument of the consuming call still reads a moved slot local", {
  before := g_disposed;
  {
    r := io.await(_move_then_read(io), io);
    assert((r.n == usize(2)) && (r.items.len() == usize(2)), "the length read after the move");
    assert(r.extra == i32(3), "an await in a later argument");
  };
  assert((g_disposed - before) == i32(2), `each item was released once, released ${g_disposed - before}`);
});
// issues/fixed/a-local-read-after-it-moves-inside-a-task-reads-an-emptied-slot.md
_bumped :: (fn(t : Thing, io : Io) -> Impl(Future(Thing, Io)))(
  io.async((e : Io) => {
    e.await(yield(e), e);
    Thing(n : (t.n + i32(1)))
  })
);
_rebind_then_read :: (fn(bump : bool, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(1));
    e.await(yield(e), e);
    (cur : Thing) = t;
    if(bump, {
      b := e.await(_bumped(t, e), e);
      cur = b;
    });
    cur.n
  })
);
test("a local moved to another name inside a task is still readable", {
  before := g_disposed;
  {
    r := io.await(_rebind_then_read(true, io), io);
    assert(r == i32(2), "the moved-from name read its value");
  };
  assert((g_disposed - before) == i32(2), `both Things released once, released ${g_disposed - before}`);
  before2 := g_disposed;
  {
    r2 := io.await(_rebind_then_read(false, io), io);
    assert(r2 == i32(1), "the new owner holds the value");
  };
  assert((g_disposed - before2) == i32(1), `the Thing released once, released ${g_disposed - before2}`);
});
_rebind_then_sleep :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    t := Thing(n : i32(5));
    e.await(yield(e), e);
    (cur : Thing) = t;
    e.await(sleep(u64(200)), e);
    cur.n + t.n
  })
);
_abort_rebind_then_sleep :: (fn(io : Io) -> unit)({
  h := io.spawn(_rebind_then_sleep(io), io);
  io.await(sleep(u64(20)), io);
  h.abort();
  _r := h.await(io);
});
test("an aborted task releases a value moved to another name once", {
  g_disposed = i32(0);
  _abort_rebind_then_sleep(io);
  assert(g_disposed == i32(1), `the new owner releases it, released ${g_disposed}`);
});
_move_each_iteration :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (i : i32) = i32(0);
    (s : i32) = i32(0);
    while(i < i32(2), {
      t := Thing(n : i);
      if(i == i32(0), {
        e.await(yield(e), e);
      }, {
        e.await(sleep(u64(200)), e);
      });
      _keep_thing(t);
      s = (s + t.n);
      i = (i + i32(1));
    });
    s
  })
);
_abort_move_each_iteration :: (fn(io : Io) -> unit)({
  h := io.spawn(_move_each_iteration(io), io);
  io.await(sleep(u64(20)), io);
  h.abort();
  _r := h.await(io);
});
test("an aborted task releases a local re-bound after its previous value moved", {
  g_disposed = i32(0);
  _abort_move_each_iteration(io);
  assert(g_disposed == i32(1), `the second iteration's Thing, released ${g_disposed}`);
  g_kept_things.clear();
  assert(g_disposed == i32(2), "the first iteration's Thing, by its new owner");
});
// A future type variable held in a generic aggregate: the async block's state
// machine type is registered before the type declarations, so the aggregate's
// typedef spells the field with the state machine, as its stores and reads do
// (issues/fixed/an-io-async-future-in-a-generic-struct-field-lowers-to-two-c-types.md).
_FutHolder :: (fn(comptime(T) : Type) -> comptime(Type))(ref(struct(r : Option(T))));
_hold_future :: (fn(generic(T : Type), x : T) -> _FutHolder(T))(_FutHolder(T)(r : .Some(x)));
test("an io.async future stored in a generic struct's Option field is awaited from it", {
  h := _hold_future(io.async((io2 : Io) => i32(8)));
  r := match(
    h.r,
    .Some(task) => io.await(task, io),
    .None => i32(-1)
  );
  assert(r == i32(8), "the stored future's value");
});
_PtrHolder :: (fn(comptime(T) : Type) -> comptime(Type))(ref(struct(r : Option(*T))));
_wrap_future :: (fn(generic(T : Type), f : Impl(Fn() -> T)) -> T)({
  _h := _PtrHolder(T)(r : .None);
  f()
});
test("a generic struct with a pointer-to-future field, built beside the future it returns", {
  task := _wrap_future(() => io.async((io2 : Io) => i32(8)));
  assert(io.await(task, io) == i32(8), "the returned future's value");
});
// A generic `Dispose` impl over a type-function instance runs for the
// instance at a future, as it does at a ref struct: the impl matcher binds
// the future handle itself
// (issues/fixed/a-generic-impl-dispose-never-runs-for-a-type-fn-instance-at-a-future.md).
(g_guards : i32) = i32(0);
_Guard :: (fn(comptime(T) : Type) -> comptime(Type))(ref(struct(n : u8)));
impl(
  generic(T : Type),
  _Guard(T),
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      g_guards = (g_guards + i32(1));
    })
  )
);
_guarded :: (fn(generic(T : Type), f : Impl(Fn() -> T)) -> T)({
  _g := _Guard(T)(n : u8(1));
  f()
});
test("a generic Dispose impl runs for a guard over a future, as over a ref struct", {
  g_guards = i32(0);
  t := _guarded(() => Thing(n : i32(1)));
  task := _guarded(() => io.async((io2 : Io) => i32(8)));
  assert(io.await(task, io) == i32(8), "the future's value");
  assert(t.n == i32(1), "the ref struct's value");
  assert(g_guards == i32(2), "both guards disposed");
});
// issues/fixed/an-earlier-argument-read-after-an-await-in-a-later-argument-is-stale.md
_LenReport :: struct(items : ArrayList(i32), n : usize, extra : i32);
_scrubbing_later :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    e.await(yield(e), e);
    _ := _scrub_stack(u64(777));
    i32(3)
  })
);
_len_then_await :: (fn(io : Io) -> Impl(Future(_LenReport, Io)))(
  io.async((e : Io) => {
    xs := ArrayList(i32).new();
    xs.push(i32(1));
    xs.push(i32(2));
    e.await(yield(e), e);
    _LenReport(items : xs, n : xs.len(), extra : e.await(_scrubbing_later(e), e))
  })
);
test("an earlier argument's value survives a suspension in a later argument", {
  r := io.await(_len_then_await(io), io);
  assert(r.n == usize(2), `the length computed before the await, read ${r.n}`);
  assert(r.items.len() == usize(2), "the moved list");
  assert(r.extra == i32(3), "the awaited argument");
});
