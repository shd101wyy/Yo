  assert(io.await(_s_cases6_h04_callarg_top(i32(1), io), io) == _r_cases6_h04_callarg_top(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases6_h04_callarg_top(i32(3), io), io) == _r_cases6_h04_callarg_top(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases6_h04_callarg_top(i32(3), io), io) == _r_cases6_h04_callarg_top(i32(3)), "synchronous inner future, n=3");
});

// cases6/h05_callarg_arm.yo
_id_cases6_h05_callarg_arm :: (fn(x : i32) -> i32)(x);

_r_cases6_h05_callarg_arm :: (fn(n : i32) -> i32)({
  (y : i32) = i32(0);
  if(n > i32(0), {
    y = _id_cases6_h05_callarg_arm(_sv(n));
  });
  y + i32(1)
});
_y_cases6_h05_callarg_arm :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (y : i32) = i32(0);
    if(n > i32(0), {
      y = _id_cases6_h05_callarg_arm(e.await(_v(n, e), e));
    });
    y + i32(1)
  })
);
_s_cases6_h05_callarg_arm :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (y : i32) = i32(0);
    if(n > i32(0), {
      y = _id_cases6_h05_callarg_arm(e.await(_vsync(n, e), e));
    });
    y + i32(1)
  })
);
test("shape h05_callarg_arm", {
  assert(io.await(_y_cases6_h05_callarg_arm(i32(0), io), io) == _r_cases6_h05_callarg_arm(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases6_h05_callarg_arm(i32(0), io), io) == _r_cases6_h05_callarg_arm(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases6_h05_callarg_arm(i32(1), io), io) == _r_cases6_h05_callarg_arm(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases6_h05_callarg_arm(i32(1), io), io) == _r_cases6_h05_callarg_arm(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases6_h05_callarg_arm(i32(3), io), io) == _r_cases6_h05_callarg_arm(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases6_h05_callarg_arm(i32(3), io), io) == _r_cases6_h05_callarg_arm(i32(3)), "synchronous inner future, n=3");
});

// cases6/h06_cond3_mid_two_awaits_loop.yo
_r_cases6_h06_cond3_mid_two_awaits_loop :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while(i < n, {
    cond(
      (i == i32(0)) => {
        acc = (acc + i32(1));
      },
      (i == i32(1)) => {
        a := _sv(i32(10));
        b := _sv(a + i32(10));
        acc = (acc + b);
      },
      true => {
        acc = (acc + i32(300));
      }
    );
    acc = (acc + i32(1000));
    i = (i + i32(1));
  });
  acc
});
_y_cases6_h06_cond3_mid_two_awaits_loop :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      cond(
        (i == i32(0)) => {
          acc = (acc + i32(1));
        },
        (i == i32(1)) => {
          a := e.await(_v(i32(10), e), e);
          b := e.await(_v(a + i32(10), e), e);
          acc = (acc + b);
        },
        true => {
          acc = (acc + i32(300));
        }
      );
      acc = (acc + i32(1000));
      i = (i + i32(1));
    });
    acc
  })
);
_s_cases6_h06_cond3_mid_two_awaits_loop :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      cond(
        (i == i32(0)) => {
          acc = (acc + i32(1));
        },
        (i == i32(1)) => {
          a := e.await(_vsync(i32(10), e), e);
          b := e.await(_vsync(a + i32(10), e), e);
          acc = (acc + b);
        },
        true => {
          acc = (acc + i32(300));
        }
      );
      acc = (acc + i32(1000));
      i = (i + i32(1));
    });
    acc
  })
);
test("shape h06_cond3_mid_two_awaits_loop", {
  assert(io.await(_y_cases6_h06_cond3_mid_two_awaits_loop(i32(0), io), io) == _r_cases6_h06_cond3_mid_two_awaits_loop(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases6_h06_cond3_mid_two_awaits_loop(i32(0), io), io) == _r_cases6_h06_cond3_mid_two_awaits_loop(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases6_h06_cond3_mid_two_awaits_loop(i32(1), io), io) == _r_cases6_h06_cond3_mid_two_awaits_loop(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases6_h06_cond3_mid_two_awaits_loop(i32(1), io), io) == _r_cases6_h06_cond3_mid_two_awaits_loop(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases6_h06_cond3_mid_two_awaits_loop(i32(3), io), io) == _r_cases6_h06_cond3_mid_two_awaits_loop(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases6_h06_cond3_mid_two_awaits_loop(i32(3), io), io) == _r_cases6_h06_cond3_mid_two_awaits_loop(i32(3)), "synchronous inner future, n=3");
});
