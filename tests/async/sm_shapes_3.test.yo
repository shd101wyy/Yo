// cases3/e13_while_in_cond_arm_mid.yo
_r_cases3_e13_while_in_cond_arm_mid :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  cond(
    (n == i32(0)) => {
      acc = i32(5);
    },
    (n == i32(1)) => {
      (i : i32) = i32(0);
      while(i < i32(3), {
        t := _sv(i);
        acc = (acc + t);
        i = (i + i32(1));
      });
    },
    true => {
      t2 := _sv(n);
      acc = (t2 + i32(1000));
    }
  );
  acc + i32(7)
});
_y_cases3_e13_while_in_cond_arm_mid :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    cond(
      (n == i32(0)) => {
        acc = i32(5);
      },
      (n == i32(1)) => {
        (i : i32) = i32(0);
        while(i < i32(3), {
          t := e.await(_v(i, e), e);
          acc = (acc + t);
          i = (i + i32(1));
        });
      },
      true => {
        t2 := e.await(_v(n, e), e);
        acc = (t2 + i32(1000));
      }
    );
    acc + i32(7)
  })
);
_s_cases3_e13_while_in_cond_arm_mid :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    cond(
      (n == i32(0)) => {
        acc = i32(5);
      },
      (n == i32(1)) => {
        (i : i32) = i32(0);
        while(i < i32(3), {
          t := e.await(_vsync(i, e), e);
          acc = (acc + t);
          i = (i + i32(1));
        });
      },
      true => {
        t2 := e.await(_vsync(n, e), e);
        acc = (t2 + i32(1000));
      }
    );
    acc + i32(7)
  })
);
test("shape e13_while_in_cond_arm_mid", {
  assert(io.await(_y_cases3_e13_while_in_cond_arm_mid(i32(0), io), io) == _r_cases3_e13_while_in_cond_arm_mid(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases3_e13_while_in_cond_arm_mid(i32(0), io), io) == _r_cases3_e13_while_in_cond_arm_mid(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases3_e13_while_in_cond_arm_mid(i32(1), io), io) == _r_cases3_e13_while_in_cond_arm_mid(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases3_e13_while_in_cond_arm_mid(i32(1), io), io) == _r_cases3_e13_while_in_cond_arm_mid(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases3_e13_while_in_cond_arm_mid(i32(3), io), io) == _r_cases3_e13_while_in_cond_arm_mid(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases3_e13_while_in_cond_arm_mid(i32(3), io), io) == _r_cases3_e13_while_in_cond_arm_mid(i32(3)), "synchronous inner future, n=3");
});

