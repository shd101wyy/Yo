// cases4/f02_if3_no_l3.yo
_r_cases4_f02_if3_no_l3 :: (fn(n : i32) -> i32)({
  (x : i32) = i32(0);
  if(n > i32(0), {
    a := _sv(n);
    if(a > i32(1), {
      b := _sv(a + i32(1));
