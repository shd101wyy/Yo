//! The async state-machine shape corpus
//! (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 0.4 / §8): await placement
//! crossed with every control-flow construct, generated from the audit's
//! shape sweep. Each test is DIFFERENTIAL — the async body, with its inner
//! future either suspending (a yield) or completing synchronously, must
//! return exactly what the same body returns written synchronously.
pragma(Pragma.SkipWasm32Emscripten); // uses the async runtime end-to-end
pragma(Pragma.SkipWasm32Wasi);
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ yield } :: import("std/async");
_sv :: (fn(x : i32) -> i32)(x);
_svb :: (fn(x : bool) -> bool)(x);
_svs :: (fn(x : i32) -> String)(x.to_string());
_v :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x
  })
);
_vb :: (fn(x : bool, io : Io) -> Impl(Future(bool, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x
  })
);
_vs :: (fn(x : i32, io : Io) -> Impl(Future(String, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x.to_string()
  })
);
_vsync :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => x));
_vbs :: (fn(x : bool, io : Io) -> Impl(Future(bool, Io)))(io.async((io2 : Io) => x));
_vss :: (fn(x : i32, io : Io) -> Impl(Future(String, Io)))(io.async((io2 : Io) => x.to_string()));
// cases3/e08_nested_if3_mid_await.yo
_r_cases3_e08_nested_if3_mid_await :: (fn(n : i32) -> i32)({
  (x : i32) = i32(0);
  if(n > i32(0), {
    a := _sv(n);
    if(a > i32(1), {
      b := _sv(a + i32(1));
      if(b > i32(3), {
        x = _sv(a + b);
      });
    });
    x = (x + a);
  });
  x
});
_y_cases3_e08_nested_if3_mid_await :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(n > i32(0), {
      a := e.await(_v(n, e), e);
      if(a > i32(1), {
        b := e.await(_v(a + i32(1), e), e);
        if(b > i32(3), {
          x = e.await(_v(a + b, e), e);
        });
      });
      x = (x + a);
    });
    x
  })
);
_s_cases3_e08_nested_if3_mid_await :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = i32(0);
    if(n > i32(0), {
      a := e.await(_vsync(n, e), e);
      if(a > i32(1), {
        b := e.await(_vsync(a + i32(1), e), e);
        if(b > i32(3), {
          x = e.await(_vsync(a + b, e), e);
        });
      });
      x = (x + a);
    });
    x
  })
);
test("shape e08_nested_if3_mid_await", {
  assert(io.await(_y_cases3_e08_nested_if3_mid_await(i32(0), io), io) == _r_cases3_e08_nested_if3_mid_await(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases3_e08_nested_if3_mid_await(i32(0), io), io) == _r_cases3_e08_nested_if3_mid_await(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases3_e08_nested_if3_mid_await(i32(1), io), io) == _r_cases3_e08_nested_if3_mid_await(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases3_e08_nested_if3_mid_await(i32(1), io), io) == _r_cases3_e08_nested_if3_mid_await(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases3_e08_nested_if3_mid_await(i32(3), io), io) == _r_cases3_e08_nested_if3_mid_await(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases3_e08_nested_if3_mid_await(i32(3), io), io) == _r_cases3_e08_nested_if3_mid_await(i32(3)), "synchronous inner future, n=3");
});

// cases3/e09_while3.yo
_r_cases3_e09_while3 :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while(i < n, {
    (j : i32) = i32(0);
    while(j < n, {
      (k : i32) = i32(0);
      while(k < n, {
        t := _sv(i32(1));
        acc = (acc + t);
        k = (k + i32(1));
      });
      j = (j + i32(1));
    });
    i = (i + i32(1));
  });
  acc
});
_y_cases3_e09_while3 :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      (j : i32) = i32(0);
      while(j < n, {
        (k : i32) = i32(0);
        while(k < n, {
          t := e.await(_v(i32(1), e), e);
          acc = (acc + t);
          k = (k + i32(1));
        });
        j = (j + i32(1));
      });
      i = (i + i32(1));
    });
    acc
  })
);
_s_cases3_e09_while3 :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      (j : i32) = i32(0);
      while(j < n, {
        (k : i32) = i32(0);
        while(k < n, {
          t := e.await(_vsync(i32(1), e), e);
          acc = (acc + t);
          k = (k + i32(1));
        });
        j = (j + i32(1));
      });
      i = (i + i32(1));
    });
    acc
  })
);
test("shape e09_while3", {
  assert(io.await(_y_cases3_e09_while3(i32(0), io), io) == _r_cases3_e09_while3(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases3_e09_while3(i32(0), io), io) == _r_cases3_e09_while3(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases3_e09_while3(i32(1), io), io) == _r_cases3_e09_while3(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases3_e09_while3(i32(1), io), io) == _r_cases3_e09_while3(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases3_e09_while3(i32(3), io), io) == _r_cases3_e09_while3(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases3_e09_while3(i32(3), io), io) == _r_cases3_e09_while3(i32(3)), "synchronous inner future, n=3");
});

