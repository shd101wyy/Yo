  assert(io.await(_s_cases_c05_binop_bind_if(i32(0), io), io) == _r_cases_c05_binop_bind_if(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_c05_binop_bind_if(i32(1), io), io) == _r_cases_c05_binop_bind_if(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_c05_binop_bind_if(i32(1), io), io) == _r_cases_c05_binop_bind_if(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_c05_binop_bind_if(i32(3), io), io) == _r_cases_c05_binop_bind_if(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_c05_binop_bind_if(i32(3), io), io) == _r_cases_c05_binop_bind_if(i32(3)), "synchronous inner future, n=3");
});

