// cases11/p01_tail_enum_match_await.yo
E_cases11_p01_tail_enum_match_await :: enum(A(v : i32), B(w : i32, z : i32), C);

_r_cases11_p01_tail_enum_match_await :: (fn(n : i32) -> i32)({
  ev := cond((n == i32(0)) => E_cases11_p01_tail_enum_match_await.A(i32(5)), (n == i32(1)) => E_cases11_p01_tail_enum_match_await.B(i32(6), i32(7)), true => E_cases11_p01_tail_enum_match_await.C);
  match(ev, .A(v) => _sv(v + i32(1)), .B(w, z) => (w + z), .C => i32(0))
});
_y_cases11_p01_tail_enum_match_await :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    ev := cond((n == i32(0)) => E_cases11_p01_tail_enum_match_await.A(i32(5)), (n == i32(1)) => E_cases11_p01_tail_enum_match_await.B(i32(6), i32(7)), true => E_cases11_p01_tail_enum_match_await.C);
    match(ev, .A(v) => e.await(_v(v + i32(1), e), e), .B(w, z) => (w + z), .C => i32(0))
  })
);
_s_cases11_p01_tail_enum_match_await :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    ev := cond((n == i32(0)) => E_cases11_p01_tail_enum_match_await.A(i32(5)), (n == i32(1)) => E_cases11_p01_tail_enum_match_await.B(i32(6), i32(7)), true => E_cases11_p01_tail_enum_match_await.C);
    match(ev, .A(v) => e.await(_vsync(v + i32(1), e), e), .B(w, z) => (w + z), .C => i32(0))
  })
);
test("shape p01_tail_enum_match_await", {
  assert(io.await(_y_cases11_p01_tail_enum_match_await(i32(0), io), io) == _r_cases11_p01_tail_enum_match_await(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases11_p01_tail_enum_match_await(i32(0), io), io) == _r_cases11_p01_tail_enum_match_await(i32(0)), "synchronous inner future, n=0");
