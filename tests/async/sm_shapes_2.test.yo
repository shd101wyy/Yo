// cases11/p03_break_in_enum_match_arm_after_await.yo
E_cases11_p03_break_in_enum_match_arm_after_await :: enum(Go, Stop(v : i32));

_r_cases11_p03_break_in_enum_match_arm_after_await :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while(i < i32(10), {
    i = (i + i32(1));
    ev := cond((i > n) => E_cases11_p03_break_in_enum_match_arm_after_await.Stop(i), true => E_cases11_p03_break_in_enum_match_arm_after_await.Go);
    match(
      ev,
      .Stop(v) => {
        t := _sv(v);
        acc = (acc + (t * i32(100)));
        break;
      },
      .Go => ()
    );
    acc = (acc + i);
  });
  acc
});
_y_cases11_p03_break_in_enum_match_arm_after_await :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < i32(10), {
      i = (i + i32(1));
      ev := cond((i > n) => E_cases11_p03_break_in_enum_match_arm_after_await.Stop(i), true => E_cases11_p03_break_in_enum_match_arm_after_await.Go);
      match(
        ev,
        .Stop(v) => {
          t := e.await(_v(v, e), e);
          acc = (acc + (t * i32(100)));
          break;
        },
        .Go => ()
      );
      acc = (acc + i);
    });
    acc
  })
);
_s_cases11_p03_break_in_enum_match_arm_after_await :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < i32(10), {
      i = (i + i32(1));
      ev := cond((i > n) => E_cases11_p03_break_in_enum_match_arm_after_await.Stop(i), true => E_cases11_p03_break_in_enum_match_arm_after_await.Go);
      match(
        ev,
        .Stop(v) => {
          t := e.await(_vsync(v, e), e);
          acc = (acc + (t * i32(100)));
          break;
        },
        .Go => ()
      );
      acc = (acc + i);
    });
    acc
  })
);
test("shape p03_break_in_enum_match_arm_after_await", {
