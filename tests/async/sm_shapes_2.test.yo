//! The async state-machine shape corpus
//! (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 0.4 / §8): await placement
//! crossed with every control-flow construct, generated from the audit's
//! shape sweep. Each test is DIFFERENTIAL — the async body, with its inner
//! future either suspending (a yield) or completing synchronously, must
//! return exactly what the same body returns written synchronously.
pragma(Pragma.SkipWasm32Emscripten); // uses the async runtime end-to-end
pragma(Pragma.SkipWasm32Wasi);
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ yield } :: import("std/async");
_sv :: (fn(x : i32) -> i32)(x);
_svb :: (fn(x : bool) -> bool)(x);
_svs :: (fn(x : i32) -> String)(x.to_string());
_v :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x
  })
);
_vb :: (fn(x : bool, io : Io) -> Impl(Future(bool, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x
  })
);
_vs :: (fn(x : i32, io : Io) -> Impl(Future(String, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x.to_string()
  })
);
_vsync :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => x));
_vbs :: (fn(x : bool, io : Io) -> Impl(Future(bool, Io)))(io.async((io2 : Io) => x));
_vss :: (fn(x : i32, io : Io) -> Impl(Future(String, Io)))(io.async((io2 : Io) => x.to_string()));
// cases/c02_binop_assign_top.yo
_r_cases_c02_binop_assign_top :: (fn(n : i32) -> i32)({
  (x : i32) = n;
  x = (x + _sv(i32(1)));
  x * i32(10)
});
_y_cases_c02_binop_assign_top :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = n;
    x = (x + e.await(_v(i32(1), e), e));
    x * i32(10)
  })
);
_s_cases_c02_binop_assign_top :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = n;
    x = (x + e.await(_vsync(i32(1), e), e));
    x * i32(10)
  })
);
test("shape c02_binop_assign_top", {
  assert(io.await(_y_cases_c02_binop_assign_top(i32(0), io), io) == _r_cases_c02_binop_assign_top(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_c02_binop_assign_top(i32(0), io), io) == _r_cases_c02_binop_assign_top(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_c02_binop_assign_top(i32(1), io), io) == _r_cases_c02_binop_assign_top(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_c02_binop_assign_top(i32(1), io), io) == _r_cases_c02_binop_assign_top(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_c02_binop_assign_top(i32(3), io), io) == _r_cases_c02_binop_assign_top(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_c02_binop_assign_top(i32(3), io), io) == _r_cases_c02_binop_assign_top(i32(3)), "synchronous inner future, n=3");
});

// cases/c04_binop_assign_if.yo
_r_cases_c04_binop_assign_if :: (fn(n : i32) -> i32)({
  (x : i32) = n;
  if(n > i32(0), {
    x = (x + _sv(i32(1)));
  });
  x * i32(10)
});
_y_cases_c04_binop_assign_if :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = n;
    if(n > i32(0), {
      x = (x + e.await(_v(i32(1), e), e));
    });
    x * i32(10)
  })
);
_s_cases_c04_binop_assign_if :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (x : i32) = n;
    if(n > i32(0), {
      x = (x + e.await(_vsync(i32(1), e), e));
    });
    x * i32(10)
  })
);
test("shape c04_binop_assign_if", {
  assert(io.await(_y_cases_c04_binop_assign_if(i32(0), io), io) == _r_cases_c04_binop_assign_if(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases_c04_binop_assign_if(i32(0), io), io) == _r_cases_c04_binop_assign_if(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases_c04_binop_assign_if(i32(1), io), io) == _r_cases_c04_binop_assign_if(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases_c04_binop_assign_if(i32(1), io), io) == _r_cases_c04_binop_assign_if(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases_c04_binop_assign_if(i32(3), io), io) == _r_cases_c04_binop_assign_if(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases_c04_binop_assign_if(i32(3), io), io) == _r_cases_c04_binop_assign_if(i32(3)), "synchronous inner future, n=3");
});

