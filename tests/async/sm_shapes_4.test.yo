// cases6/h10_nested_if_loop_two_levels.yo
_r_cases6_h10_nested_if_loop_two_levels :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while(i < n, {
    if(i > i32(0), {
      if(i > i32(1), {
        a := _sv(i);
        acc = (acc + a);
      });
      acc = (acc + i32(100));
    });
    acc = (acc + i32(1000));
    i = (i + i32(1));
  });
  acc
});
