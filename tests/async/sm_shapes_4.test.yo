  assert(io.await(_y_cases6_h09_await_tail_in_loop_arm_value(i32(0), io), io) == _r_cases6_h09_await_tail_in_loop_arm_value(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases6_h09_await_tail_in_loop_arm_value(i32(0), io), io) == _r_cases6_h09_await_tail_in_loop_arm_value(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases6_h09_await_tail_in_loop_arm_value(i32(1), io), io) == _r_cases6_h09_await_tail_in_loop_arm_value(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases6_h09_await_tail_in_loop_arm_value(i32(1), io), io) == _r_cases6_h09_await_tail_in_loop_arm_value(i32(1)), "synchronous inner future, n=1");
