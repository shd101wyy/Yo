// cases8/m10_cond_in_while_nested_arm_await_and_break.yo
_r_cases8_m10_cond_in_while_nested_arm_await_and_break :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while(i < i32(10), {
    t := _sv(i);
    cond(
      (t == n) => {
        break;
      },
      ((t % i32(2)) == i32(0)) => {
        acc = (acc + t);
      },
      true => {
        acc = (acc + i32(100));
      }
    );
    i = (i + i32(1));
  });
