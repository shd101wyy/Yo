    (i : i32) = i32(0);
    while(i < n, {
      if(i > i32(0), {
        if(i > i32(1), {
          a := e.await(_v(i, e), e);
          acc = (acc + a);
        });
        acc = (acc + i32(100));
      });
      acc = (acc + i32(1000));
      i = (i + i32(1));
    });
    acc
  })
);
_s_cases6_h10_nested_if_loop_two_levels :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      if(i > i32(0), {
        if(i > i32(1), {
          a := e.await(_vsync(i, e), e);
          acc = (acc + a);
        });
        acc = (acc + i32(100));
      });
      acc = (acc + i32(1000));
      i = (i + i32(1));
    });
    acc
  })
);
test("shape h10_nested_if_loop_two_levels", {
  assert(io.await(_y_cases6_h10_nested_if_loop_two_levels(i32(0), io), io) == _r_cases6_h10_nested_if_loop_two_levels(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases6_h10_nested_if_loop_two_levels(i32(0), io), io) == _r_cases6_h10_nested_if_loop_two_levels(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases6_h10_nested_if_loop_two_levels(i32(1), io), io) == _r_cases6_h10_nested_if_loop_two_levels(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases6_h10_nested_if_loop_two_levels(i32(1), io), io) == _r_cases6_h10_nested_if_loop_two_levels(i32(1)), "synchronous inner future, n=1");
