//! The async state-machine shape corpus
//! (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 0.4 / §8): await placement
//! crossed with every control-flow construct, generated from the audit's
//! shape sweep. Each test is DIFFERENTIAL — the async body, with its inner
//! future either suspending (a yield) or completing synchronously, must
//! return exactly what the same body returns written synchronously.
pragma(Pragma.SkipWasm32Emscripten); // uses the async runtime end-to-end
pragma(Pragma.SkipWasm32Wasi);
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ yield } :: import("std/async");
_sv :: (fn(x : i32) -> i32)(x);
_svb :: (fn(x : bool) -> bool)(x);
_svs :: (fn(x : i32) -> String)(x.to_string());
_v :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x
  })
);
_vb :: (fn(x : bool, io : Io) -> Impl(Future(bool, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x
  })
);
_vs :: (fn(x : i32, io : Io) -> Impl(Future(String, Io)))(
  io.async((io2 : Io) => {
    io2.await(yield(io2), io2);
    x.to_string()
  })
);
_vsync :: (fn(x : i32, io : Io) -> Impl(Future(i32, Io)))(io.async((io2 : Io) => x));
_vbs :: (fn(x : bool, io : Io) -> Impl(Future(bool, Io)))(io.async((io2 : Io) => x));
_vss :: (fn(x : i32, io : Io) -> Impl(Future(String, Io)))(io.async((io2 : Io) => x.to_string()));
// cases6/h07_loop_if_one_await_nottaken.yo
_r_cases6_h07_loop_if_one_await_nottaken :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while(i < n, {
    if(i > i32(0), {
      a := _sv(i);
      acc = (acc + a);
    });
    acc = (acc + i32(1000));
    i = (i + i32(1));
  });
  acc
});
_y_cases6_h07_loop_if_one_await_nottaken :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      if(i > i32(0), {
        a := e.await(_v(i, e), e);
        acc = (acc + a);
      });
      acc = (acc + i32(1000));
      i = (i + i32(1));
    });
    acc
  })
);
_s_cases6_h07_loop_if_one_await_nottaken :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      if(i > i32(0), {
        a := e.await(_vsync(i, e), e);
        acc = (acc + a);
      });
      acc = (acc + i32(1000));
      i = (i + i32(1));
    });
    acc
  })
);
test("shape h07_loop_if_one_await_nottaken", {
  assert(io.await(_y_cases6_h07_loop_if_one_await_nottaken(i32(0), io), io) == _r_cases6_h07_loop_if_one_await_nottaken(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases6_h07_loop_if_one_await_nottaken(i32(0), io), io) == _r_cases6_h07_loop_if_one_await_nottaken(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases6_h07_loop_if_one_await_nottaken(i32(1), io), io) == _r_cases6_h07_loop_if_one_await_nottaken(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases6_h07_loop_if_one_await_nottaken(i32(1), io), io) == _r_cases6_h07_loop_if_one_await_nottaken(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases6_h07_loop_if_one_await_nottaken(i32(3), io), io) == _r_cases6_h07_loop_if_one_await_nottaken(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases6_h07_loop_if_one_await_nottaken(i32(3), io), io) == _r_cases6_h07_loop_if_one_await_nottaken(i32(3)), "synchronous inner future, n=3");
});

// cases6/h08_matchstmt_two_awaits_loop.yo
_r_cases6_h08_matchstmt_two_awaits_loop :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while(i < n, {
    match(
      i,
      i32(1) => {
        a := _sv(i32(10));
        b := _sv(a + i32(10));
        acc = (acc + b);
      },
      _ => {
        acc = (acc + i32(1));
      }
    );
    acc = (acc + i32(1000));
    i = (i + i32(1));
  });
  acc
});
_y_cases6_h08_matchstmt_two_awaits_loop :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      match(
        i,
        i32(1) => {
          a := e.await(_v(i32(10), e), e);
          b := e.await(_v(a + i32(10), e), e);
          acc = (acc + b);
        },
        _ => {
          acc = (acc + i32(1));
        }
      );
      acc = (acc + i32(1000));
      i = (i + i32(1));
    });
    acc
  })
);
_s_cases6_h08_matchstmt_two_awaits_loop :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      match(
        i,
        i32(1) => {
          a := e.await(_vsync(i32(10), e), e);
          b := e.await(_vsync(a + i32(10), e), e);
          acc = (acc + b);
        },
        _ => {
          acc = (acc + i32(1));
        }
      );
      acc = (acc + i32(1000));
      i = (i + i32(1));
    });
    acc
  })
);
test("shape h08_matchstmt_two_awaits_loop", {
  assert(io.await(_y_cases6_h08_matchstmt_two_awaits_loop(i32(0), io), io) == _r_cases6_h08_matchstmt_two_awaits_loop(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases6_h08_matchstmt_two_awaits_loop(i32(0), io), io) == _r_cases6_h08_matchstmt_two_awaits_loop(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases6_h08_matchstmt_two_awaits_loop(i32(1), io), io) == _r_cases6_h08_matchstmt_two_awaits_loop(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases6_h08_matchstmt_two_awaits_loop(i32(1), io), io) == _r_cases6_h08_matchstmt_two_awaits_loop(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases6_h08_matchstmt_two_awaits_loop(i32(3), io), io) == _r_cases6_h08_matchstmt_two_awaits_loop(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases6_h08_matchstmt_two_awaits_loop(i32(3), io), io) == _r_cases6_h08_matchstmt_two_awaits_loop(i32(3)), "synchronous inner future, n=3");
});

