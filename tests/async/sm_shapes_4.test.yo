});

// cases7/k03_list_in_loop_body.yo
{ ArrayList } :: import("std/collections/array_list");

_r_cases7_k03_list_in_loop_body :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  (i : i32) = i32(0);
  while(i < n, {
    xs := ArrayList(i32).new();
    xs.push(i);
    t := _sv(i);
    xs.push(t);
    acc = (acc + i32(xs.len()));
    i = (i + i32(1));
  });
  acc
});
_y_cases7_k03_list_in_loop_body :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      xs := ArrayList(i32).new();
      xs.push(i);
      t := e.await(_v(i, e), e);
      xs.push(t);
      acc = (acc + i32(xs.len()));
      i = (i + i32(1));
    });
    acc
  })
);
_s_cases7_k03_list_in_loop_body :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (acc : i32) = i32(0);
    (i : i32) = i32(0);
    while(i < n, {
      xs := ArrayList(i32).new();
      xs.push(i);
      t := e.await(_vsync(i, e), e);
      xs.push(t);
      acc = (acc + i32(xs.len()));
      i = (i + i32(1));
    });
    acc
  })
);
test("shape k03_list_in_loop_body", {
  assert(io.await(_y_cases7_k03_list_in_loop_body(i32(0), io), io) == _r_cases7_k03_list_in_loop_body(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases7_k03_list_in_loop_body(i32(0), io), io) == _r_cases7_k03_list_in_loop_body(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases7_k03_list_in_loop_body(i32(1), io), io) == _r_cases7_k03_list_in_loop_body(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases7_k03_list_in_loop_body(i32(1), io), io) == _r_cases7_k03_list_in_loop_body(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases7_k03_list_in_loop_body(i32(3), io), io) == _r_cases7_k03_list_in_loop_body(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases7_k03_list_in_loop_body(i32(3), io), io) == _r_cases7_k03_list_in_loop_body(i32(3)), "synchronous inner future, n=3");
});

// cases7/k09_str_nested_while.yo
_r_cases7_k09_str_nested_while :: (fn(n : i32) -> i32)({
  (i : i32) = i32(0);
  (total : i32) = i32(0);
  while(i < n, {
    (j : i32) = i32(0);
    while(j < n, {
      t := _svs((i * i32(10)) + j);
      total = (total + i32(t.len()));
      j = (j + i32(1));
    });
    i = (i + i32(1));
  });
  total
});
_y_cases7_k09_str_nested_while :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (i : i32) = i32(0);
    (total : i32) = i32(0);
    while(i < n, {
      (j : i32) = i32(0);
      while(j < n, {
        t := e.await(_vs((i * i32(10)) + j, e), e);
        total = (total + i32(t.len()));
        j = (j + i32(1));
      });
      i = (i + i32(1));
    });
    total
  })
);
_s_cases7_k09_str_nested_while :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (i : i32) = i32(0);
    (total : i32) = i32(0);
    while(i < n, {
      (j : i32) = i32(0);
      while(j < n, {
        t := e.await(_vss((i * i32(10)) + j, e), e);
        total = (total + i32(t.len()));
        j = (j + i32(1));
      });
      i = (i + i32(1));
    });
    total
  })
);
test("shape k09_str_nested_while", {
  assert(io.await(_y_cases7_k09_str_nested_while(i32(0), io), io) == _r_cases7_k09_str_nested_while(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases7_k09_str_nested_while(i32(0), io), io) == _r_cases7_k09_str_nested_while(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases7_k09_str_nested_while(i32(1), io), io) == _r_cases7_k09_str_nested_while(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases7_k09_str_nested_while(i32(1), io), io) == _r_cases7_k09_str_nested_while(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases7_k09_str_nested_while(i32(3), io), io) == _r_cases7_k09_str_nested_while(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases7_k09_str_nested_while(i32(3), io), io) == _r_cases7_k09_str_nested_while(i32(3)), "synchronous inner future, n=3");
});

// cases7/k10_str_continue_heap.yo
_r_cases7_k10_str_continue_heap :: (fn(n : i32) -> i32)({
  (i : i32) = i32(0);
  (total : i32) = i32(0);
  while(i < (n * i32(2)), {
    i = (i + i32(1));
    t := _svs(i * i32(100));
    if((i % i32(2)) == i32(0), {
      continue;
    });
    total = (total + i32(t.len()));
  });
  total
});
_y_cases7_k10_str_continue_heap :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (i : i32) = i32(0);
    (total : i32) = i32(0);
    while(i < (n * i32(2)), {
      i = (i + i32(1));
      t := e.await(_vs(i * i32(100), e), e);
      if((i % i32(2)) == i32(0), {
        continue;
      });
      total = (total + i32(t.len()));
    });
    total
  })
);
_s_cases7_k10_str_continue_heap :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
  io.async((e : Io) => {
    (i : i32) = i32(0);
    (total : i32) = i32(0);
    while(i < (n * i32(2)), {
      i = (i + i32(1));
      t := e.await(_vss(i * i32(100), e), e);
      if((i % i32(2)) == i32(0), {
        continue;
      });
      total = (total + i32(t.len()));
    });
    total
  })
);
test("shape k10_str_continue_heap", {
  assert(io.await(_y_cases7_k10_str_continue_heap(i32(0), io), io) == _r_cases7_k10_str_continue_heap(i32(0)), "yielding inner future, n=0");
  assert(io.await(_s_cases7_k10_str_continue_heap(i32(0), io), io) == _r_cases7_k10_str_continue_heap(i32(0)), "synchronous inner future, n=0");
  assert(io.await(_y_cases7_k10_str_continue_heap(i32(1), io), io) == _r_cases7_k10_str_continue_heap(i32(1)), "yielding inner future, n=1");
  assert(io.await(_s_cases7_k10_str_continue_heap(i32(1), io), io) == _r_cases7_k10_str_continue_heap(i32(1)), "synchronous inner future, n=1");
  assert(io.await(_y_cases7_k10_str_continue_heap(i32(3), io), io) == _r_cases7_k10_str_continue_heap(i32(3)), "yielding inner future, n=3");
  assert(io.await(_s_cases7_k10_str_continue_heap(i32(3), io), io) == _r_cases7_k10_str_continue_heap(i32(3)), "synchronous inner future, n=3");
});

// cases8/m01_while_in_match_arm.yo
_r_cases8_m01_while_in_match_arm :: (fn(n : i32) -> i32)({
  (acc : i32) = i32(0);
  match(
    n,
    i32(0) => {
      acc = i32(-1);
    },
    _ => {
      (i : i32) = i32(0);
      while(i < n, {
        t := _sv(i);
        acc = (acc + t);
        i = (i + i32(1));
      });
      acc = (acc + i32(100));
    }
  );
  acc
});
_y_cases8_m01_while_in_match_arm :: (fn(n : i32, io : Io) -> Impl(Future(i32, Io)))(
