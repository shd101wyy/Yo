open import "std/libc/stdio";
open import "std/string";
{ temp_dir, path_join } :: import "./helper";
dir :: import "std/io/dir";
file :: import "std/io/file";
path_io :: import "std/io/path";
{ AT_FDCWD, AT_REMOVEDIR, O_WRONLY, O_CREAT, O_TRUNC, O_RDONLY } :: import "std/io/constants";

test "realpath resolves . and ..", {
  async {
    tmp := temp_dir();
    base_dir_str := path_join(tmp, `yo_io_realpath_dir`);
    sub_dir_str := path_join(base_dir_str, `sub`);
    file_name := `target.txt`;
    file_str := path_join(base_dir_str, file_name);

    base_dir_c := base_dir_str.to_cstr();
    sub_dir_c := sub_dir_str.to_cstr();
    file_c := file_str.to_cstr();
    base_dir := base_dir_c.ptr().unwrap();
    sub_dir := sub_dir_c.ptr().unwrap();
    file_path := file_c.ptr().unwrap();

    await dir.unlink(AT_FDCWD, file_path, i32(0));
    await dir.unlink(AT_FDCWD, sub_dir, AT_REMOVEDIR);
    await dir.unlink(AT_FDCWD, base_dir, AT_REMOVEDIR);

    mk_base := await dir.mkdir(AT_FDCWD, base_dir, i32(0o755));
    assert(mk_base == i32(0));
    mk_sub := await dir.mkdir(AT_FDCWD, sub_dir, i32(0o755));
    assert(mk_sub == i32(0));

    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := await file.openat(AT_FDCWD, file_path, write_flags, i32(0o644));
    assert(fd >= i32(0));
    data := *(u8)("realpath data");
    wr := await file.write(fd, data, u32(13), u64(0));
    assert(wr == i32(13));
    await file.close(fd);

    dot_dir_str := path_join(sub_dir_str, `..`);
    dot_path_str := path_join(dot_dir_str, file_name);
    dot_path_c := dot_path_str.to_cstr();
    dot_path := dot_path_c.ptr().unwrap();

    buf_uninit := MaybeUninit(Array(u8, usize(4096))).new();
    buf := *(u8)(buf_uninit.as_ptr());

    rp := path_io.realpath(dot_path, buf);
    printf("  realpath = %d\n", rp);
    assert(rp == i32(0));

    expected_buf_uninit := MaybeUninit(Array(u8, usize(4096))).new();
    expected_buf := *(u8)(expected_buf_uninit.as_ptr());
    expected_rp := path_io.realpath(file_path, expected_buf);
    assert(expected_rp == i32(0));

    resolved_str := String.from_cstr(buf).unwrap();
    expected_str := String.from_cstr(expected_buf).unwrap();
    assert(resolved_str == expected_str);

    await dir.unlink(AT_FDCWD, file_path, i32(0));
    await dir.unlink(AT_FDCWD, sub_dir, AT_REMOVEDIR);
    await dir.unlink(AT_FDCWD, base_dir, AT_REMOVEDIR);
  };
};

test "realpath resolves symlink target", {
  async {
    tmp := temp_dir();
    base_dir_str := path_join(tmp, `yo_io_realpath_link`);
    target_str := path_join(base_dir_str, `target.txt`);
    link_str := path_join(base_dir_str, `link.txt`);

    base_dir_c := base_dir_str.to_cstr();
    target_c := target_str.to_cstr();
    link_c := link_str.to_cstr();
    base_dir := base_dir_c.ptr().unwrap();
    target_path := target_c.ptr().unwrap();
    link_path := link_c.ptr().unwrap();

    await dir.unlink(AT_FDCWD, link_path, i32(0));
    await dir.unlink(AT_FDCWD, target_path, i32(0));
    await dir.unlink(AT_FDCWD, base_dir, AT_REMOVEDIR);

    mk_base := await dir.mkdir(AT_FDCWD, base_dir, i32(0o755));
    assert(mk_base == i32(0));

    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := await file.openat(AT_FDCWD, target_path, write_flags, i32(0o644));
    assert(fd >= i32(0));
    data := *(u8)("symlink target");
    wr := await file.write(fd, data, u32(14), u64(0));
    assert(wr == i32(14));
    await file.close(fd);

    sym_result := await dir.symlink(target_path, AT_FDCWD, link_path);
    printf("  symlink = %d\n", sym_result);

    cond(
      (sym_result == i32(0)) => {
        buf_uninit := MaybeUninit(Array(u8, usize(4096))).new();
        buf := *(u8)(buf_uninit.as_ptr());
        rp := path_io.realpath(link_path, buf);
        printf("  realpath link = %d\n", rp);
        assert(rp == i32(0));

        expected_buf_uninit := MaybeUninit(Array(u8, usize(4096))).new();
        expected_buf := *(u8)(expected_buf_uninit.as_ptr());
        expected_rp := path_io.realpath(target_path, expected_buf);
        assert(expected_rp == i32(0));

        resolved_str := String.from_cstr(buf).unwrap();
        expected_str := String.from_cstr(expected_buf).unwrap();
        assert(resolved_str == expected_str);
      },
      true => ()
    );

    await dir.unlink(AT_FDCWD, link_path, i32(0));
    await dir.unlink(AT_FDCWD, target_path, i32(0));
    await dir.unlink(AT_FDCWD, base_dir, AT_REMOVEDIR);
  };
};

test "realpath on nonexistent returns error", {
  async {
    tmp := temp_dir();
    bad_path_str := path_join(tmp, `yo_io_realpath_missing_999`);
    bad_path_c := bad_path_str.to_cstr();
    bad_path := bad_path_c.ptr().unwrap();

    await dir.unlink(AT_FDCWD, bad_path, i32(0));

    buf_uninit := MaybeUninit(Array(u8, usize(4096))).new();
    buf := *(u8)(buf_uninit.as_ptr());

    rp := path_io.realpath(bad_path, buf);
    printf("  realpath missing = %d\n", rp);
    assert(rp < i32(0));
  };
};
