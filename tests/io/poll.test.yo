open import "std/libc/stdio";
file :: import "std/io/file";
pipe_io :: import "std/io/pipe";
events :: import "std/io/events";

on_poll :: (fn(events_mask: i32, status: i32, user_data: *(u8)) -> unit)({
  printf("poll: %d %d\n", events_mask, status);
  user_data;
});

test "poll init/start/stop", {
  async {
    pipefd_uninit := MaybeUninit(Array(i32, usize(2))).new();
    pipefd := *(i32)(pipefd_uninit.as_ptr());
    pr := pipe_io.pipe(pipefd);
    assert(pr == i32(0));

    read_fd := (pipefd &+ usize(0)).*;
    write_fd := (pipefd &+ usize(1)).*;

    handle := events.poll_init(read_fd);
    ret := events.poll_start(handle, events.POLL_READABLE, on_poll);
    cond(
      (ret < i32(0)) => {
        events.poll_close(handle);
        cr1 := await file.close(read_fd);
        cr2 := await file.close(write_fd);
        assert(cr1 == i32(0));
        assert(cr2 == i32(0));
        return;
      },
      true => ()
    );

    stop_ret := events.poll_stop(handle);
    assert(stop_ret == i32(0));
    events.poll_close(handle);

    cr1 := await file.close(read_fd);
    cr2 := await file.close(write_fd);
    assert(cr1 == i32(0));
    assert(cr2 == i32(0));
  };
};
