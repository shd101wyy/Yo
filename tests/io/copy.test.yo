open import "std/libc/stdio";
open import "std/string";
file :: import "std/io/file";
copy_io :: import "std/io/copy";
dir :: import "std/io/dir";
{ AT_FDCWD, O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC } :: import "std/io/constants";
{ temp_dir, path_join } :: import "./helper";

test "copyfile copies file contents", {
  async {
    tmp := temp_dir();
    src_path_str := path_join(tmp, `yo_io_copy_src.txt`);
    dst_path_str := path_join(tmp, `yo_io_copy_dst.txt`);
    src_path_c := src_path_str.to_cstr();
    dst_path_c := dst_path_str.to_cstr();
    src_path := src_path_c.ptr().unwrap();
    dst_path := dst_path_c.ptr().unwrap();

    await dir.unlink(AT_FDCWD, dst_path, i32(0));
    await dir.unlink(AT_FDCWD, src_path, i32(0));

    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    src_fd := await file.openat(AT_FDCWD, src_path, write_flags, i32(0o644));
    assert(src_fd >= i32(0));

    data := *(u8)("copyfile data");
    data_len := u32(13);
    wr := await file.write(src_fd, data, data_len, u64(0));
    assert(wr == i32(data_len));
    c1 := await file.close(src_fd);
    assert(c1 == i32(0));

    cr := copy_io.copyfile(src_path, dst_path, i32(0));
    printf("  copyfile = %d\n", cr);
    assert(cr == i32(0));

    dst_fd := await file.openat(AT_FDCWD, dst_path, O_RDONLY, i32(0));
    assert(dst_fd >= i32(0));

    buf_uninit := MaybeUninit(Array(u8, usize(32))).new();
    buf := *(u8)(buf_uninit.as_ptr());
    rd := await file.read(dst_fd, buf, u32(32), u64(0));
    assert(rd == i32(data_len));
    assert((buf &+ usize(0)).* == u8(99));
    assert((buf &+ usize(4)).* == u8(102));
    assert((buf &+ usize(12)).* == u8(97));

    c2 := await file.close(dst_fd);
    assert(c2 == i32(0));

    await dir.unlink(AT_FDCWD, dst_path, i32(0));
    await dir.unlink(AT_FDCWD, src_path, i32(0));
  };
};

test "sendfile transfers bytes", {
  async {
    tmp := temp_dir();
    src_path_str := path_join(tmp, `yo_io_sendfile_src.txt`);
    dst_path_str := path_join(tmp, `yo_io_sendfile_dst.txt`);
    src_path_c := src_path_str.to_cstr();
    dst_path_c := dst_path_str.to_cstr();
    src_path := src_path_c.ptr().unwrap();
    dst_path := dst_path_c.ptr().unwrap();

    await dir.unlink(AT_FDCWD, dst_path, i32(0));
    await dir.unlink(AT_FDCWD, src_path, i32(0));

    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    src_fd := await file.openat(AT_FDCWD, src_path, write_flags, i32(0o644));
    assert(src_fd >= i32(0));

    data := *(u8)("sendfile ok");
    data_len := u32(11);
    wr := await file.write(src_fd, data, data_len, u64(0));
    assert(wr == i32(data_len));
    c1 := await file.close(src_fd);
    assert(c1 == i32(0));

    in_fd := await file.openat(AT_FDCWD, src_path, O_RDONLY, i32(0));
    assert(in_fd >= i32(0));
    out_fd := await file.openat(AT_FDCWD, dst_path, write_flags, i32(0o644));
    assert(out_fd >= i32(0));

    sent := copy_io.sendfile(out_fd, in_fd, i64(0), usize(data_len));
    printf("  sendfile = %d\n", sent);
    assert(sent == i32(data_len));

    c2 := await file.close(in_fd);
    c3 := await file.close(out_fd);
    assert(c2 == i32(0));
    assert(c3 == i32(0));

    dst_fd := await file.openat(AT_FDCWD, dst_path, O_RDONLY, i32(0));
    assert(dst_fd >= i32(0));

    buf_uninit := MaybeUninit(Array(u8, usize(32))).new();
    buf := *(u8)(buf_uninit.as_ptr());
    rd := await file.read(dst_fd, buf, u32(32), u64(0));
    assert(rd == i32(data_len));
    assert((buf &+ usize(0)).* == u8(115));
    assert((buf &+ usize(4)).* == u8(102));
    assert((buf &+ usize(10)).* == u8(107));

    c4 := await file.close(dst_fd);
    assert(c4 == i32(0));

    await dir.unlink(AT_FDCWD, dst_path, i32(0));
    await dir.unlink(AT_FDCWD, src_path, i32(0));
  };
};
