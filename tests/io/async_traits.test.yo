//! STD_API_AUDIT D5: the async `Reader`/`Writer` traits, their concrete
//! implementors — `File`, `TcpStream` (impl registration), `Stdout`/`Stderr` —
//! and the slice-2 surface: the `read_to_end`/`read_to_string`/`write_all`
//! trait defaults and `copy`, unblocked by PRs #294/#295 (the loop-await
//! state-machine fixes) and the unit-tail-await substitution fix
//! (issues/fixed/unit-tail-await-of-trait-default-reads-missing-await-result.md).
//! The generic `BufReader(R)`/`BufWriter(W)` wrappers are covered in
//! `bufio.test.yo`; that V3 retired the `Dyn(Reader)` spelling is pinned at
//! the end of this file.
pragma(Pragma.SkipWasm32Wasi); // File I/O — the async open/read/write path is host-only; standalone WASI lacks it (same skip as tests/fs)
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ temp_dir, path_join } :: import("../helper");
{ arch, Arch } :: import("std/process");
{ printf, EOF } :: import("std/libc/stdio");
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ IoExn, Exception } :: import("std/error");
{ Reader, Writer, copy } :: import("std/io");
{ BufReader } :: import("std/io/bufio");
{ Stdout, Stderr, stdout, stderr } :: import("std/io/stdio");
{ File, OpenMode } :: import("std/fs/file");
{ TcpStream } :: import("std/net/tcp");
{ Path } :: import("std/path");
{ remove_file } :: import("std/fs/dir");

// A generic single-await passthrough: proves the WHERE-BOUND trait dispatch
// works for both traits (the control shape from the filed bug).
// The future borrows the reader (a `File` is move-only): the capture list
// lends `r` and copies the plain parameters.
read_once :: (
  fn(generic(R : Type), r : &R, buf : *u8, size : usize, io : Io, where(R <: Reader)) -> Impl(Future(usize, IoExn))
)(
  io.async({ &r, buf, size }(e : IoExn) => e.io.await(r.read(buf, size, e.io), e))
);
write_once :: (
  fn(generic(W : Type), w : &W, buf : *u8, size : usize, io : Io, where(W <: Writer)) -> Impl(Future(usize, IoExn))
)(
  io.async({ &w, buf, size }(e : IoExn) => e.io.await(w.write(buf, size, e.io), e))
);

// Slice-2 generic helpers: the defaults reached through where bounds.
read_all_generic :: (
  fn(generic(R : Type), r : &R, io : Io, where(R <: Reader)) -> Impl(Future(ArrayList(u8), IoExn))
)(
  io.async({ &r, io }(e : IoExn) => e.io.await(r.read_to_end(io), e))
);
read_string_generic :: (
  fn(generic(R : Type), r : &R, io : Io, where(R <: Reader)) -> Impl(Future(String, IoExn))
)(
  io.async({ &r, io }(e : IoExn) => e.io.await(r.read_to_string(io), e))
);
write_all_generic :: (
  fn(generic(W : Type), w : &W, buf : *u8, size : usize, io : Io, where(W <: Writer)) -> Impl(Future(unit, IoExn))
)(
  io.async({ &w, buf, size, io }(e : IoExn) => e.io.await(w.write_all(buf, size, io), e))
);
test("read_to_end default loops chunks; write_all default delivers everything", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  path := Path.new(path_join(temp_dir(), `yo_d5s2_defaults.bin`.to_string()));
  // 10000 bytes so read_to_end must loop three 4096-byte chunks.
  payload := ArrayList(u8).new();
  (mut(i) : usize) = usize(0);
  while(i < usize(10000), i = (i + usize(1)), {
    payload.push(u8(usize(65) + (i % usize(26))));
  });
  f := io.await(File.open(&path, OpenMode.Write, io), t_e);
  io.await(write_all_generic(&f, payload.ptr().unwrap(), payload.len(), io), t_e);
  io.await(f.close(io), t_e);
  // Through the where bound...
  r1 := io.await(File.open(&path, OpenMode.Read, io), t_e);
  all := io.await(read_all_generic(&r1, io), t_e);
  io.await(r1.close(io), t_e);
  assert(all.len() == usize(10000), "read_to_end got all bytes");
  assert(all(usize(0)) == u8(65), "first byte");
  assert(all(usize(9999)) == u8(65 + (9999 % 26)), "last byte");
  // ...and as a direct method call.
  r2 := io.await(File.open(&path, OpenMode.Read, io), t_e);
  all2 := io.await(r2.read_to_end(io), t_e);
  io.await(r2.close(io), t_e);
  assert(all2.len() == usize(10000), "direct read_to_end got all bytes");
  io.await(remove_file(&path, io), t_e);
});
test("read_to_string default validates UTF-8 (default chained onto default)", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  path := Path.new(path_join(temp_dir(), `yo_d5s2_rts.txt`.to_string()));
  f := io.await(File.open(&path, OpenMode.Write, io), t_e);
  n := io.await(f.write_string(`héllo world`.to_string(), io), t_e);
  assert(n == usize(12), "12 UTF-8 bytes written");
  io.await(f.close(io), t_e);
  r := io.await(File.open(&path, OpenMode.Read, io), t_e);
  s := io.await(read_string_generic(&r, io), t_e);
  io.await(r.close(io), t_e);
  assert(s == `héllo world`, "round trip through the trait default");
  io.await(remove_file(&path, io), t_e);
});
test("copy drains a Reader into a Writer and counts bytes", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  pa := Path.new(path_join(temp_dir(), `yo_d5s2_copy_a.bin`.to_string()));
  pb := Path.new(path_join(temp_dir(), `yo_d5s2_copy_b.bin`.to_string()));
  payload := ArrayList(u8).new();
  (mut(i) : usize) = usize(0);
  while(i < usize(5000), i = (i + usize(1)), {
    payload.push(u8(i % usize(251)));
  });
  f := io.await(File.open(&pa, OpenMode.Write, io), t_e);
  io.await(write_all_generic(&f, payload.ptr().unwrap(), payload.len(), io), t_e);
  io.await(f.close(io), t_e);
  cr := io.await(File.open(&pa, OpenMode.Read, io), t_e);
  cw := io.await(File.open(&pb, OpenMode.Write, io), t_e);
  total := io.await(copy(&cr, &cw, io), t_e);
  io.await(cr.close(io), t_e);
  io.await(cw.close(io), t_e);
  assert(total == u64(5000), "copy resolves the byte total");
  vb := io.await(File.open(&pb, OpenMode.Read, io), t_e);
  copied := io.await(vb.read_to_end(io), t_e);
  io.await(vb.close(io), t_e);
  assert(copied.len() == usize(5000), "copied length");
  assert(copied(usize(2500)) == payload(usize(2500)), "copied middle byte");
  io.await(remove_file(&pa, io), t_e);
  io.await(remove_file(&pb, io), t_e);
});
test("read_to_string throws IoError.InvalidData on malformed UTF-8", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  path := Path.new(path_join(temp_dir(), `yo_d5s2_badutf8.bin`.to_string()));
  bad := ArrayList(u8).new();
  bad.push(u8(0xFF));
  bad.push(u8(0xFE));
  fw := io.await(File.open(&path, OpenMode.Write, io), t_e);
  io.await(fw.write(bad.ptr().unwrap(), bad.len(), io), t_e);
  io.await(fw.close(io), t_e);
  exn := Exception(
    throw : (
      err -> {
        msg := err.to_string();
        assert(msg.contains(`malformed data`), `expected InvalidData, got: ${msg}`);
        unwind(());
      }
    )
  );
  ioe := IoExn(io : io, exn : exn);
  // Called directly on a File (no where-bound): this is the Reader trait
  // DEFAULT — File's inherent duplicate was deleted (D5/D2 closeout, one
  // spelling per operation) — exercised through the throw handler.
  r := io.await(File.open(&path, OpenMode.Read, io), t_e);
  s := io.await(r.read_to_string(io), ioe);
  assert(false, `read_to_string must throw on malformed UTF-8, got: ${s}`);
});
test("File implements Reader and Writer — trait-dispatched round trip", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  path := Path.new(path_join(temp_dir(), `yo_d5_traits_roundtrip.bin`.to_string()));
  f := io.await(File.open(&path, OpenMode.Write, io), t_e);
  payload := ArrayList(u8).new();
  payload.push(u8(0xDE));
  payload.push(u8(0xAD));
  payload.push(u8(0xBE));
  payload.push(u8(0xEF));
  // Write through the GENERIC Writer bound (one await).
  wrote := io.await(write_once(&f, payload.ptr().unwrap(), payload.len(), io), t_e);
  assert(wrote == usize(4), "wrote four bytes through the Writer bound");
  io.await(f.flush(io), t_e);
  io.await(f.close(io), t_e);
  // Read back through the GENERIC Reader bound (one await).
  f2 := io.await(File.open(&path, OpenMode.Read, io), t_e);
  buf := ArrayList(u8).with_capacity(usize(8));
  (mut(bi) : usize) = usize(0);
  while(bi < usize(8), bi = (bi + usize(1)), {
    buf.push(u8(0));
  });
  got := io.await(read_once(&f2, buf.ptr().unwrap(), usize(8), io), t_e);
  assert(got == usize(4), "read the four bytes back through the Reader bound");
  assert(buf(usize(0)) == u8(0xDE), "byte 0");
  assert(buf(usize(3)) == u8(0xEF), "byte 3");
  // A second read at EOF resolves 0 — the Reader EOF contract.
  got2 := io.await(read_once(&f2, buf.ptr().unwrap(), usize(8), io), t_e);
  assert(got2 == usize(0), "EOF is 0, not an error");
  io.await(f2.close(io), t_e);
  io.await(remove_file(&path, io), t_e);
});
test("File.read/write_string/write_bytes count in usize now", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  path := Path.new(path_join(temp_dir(), `yo_d5_usize_counts.txt`.to_string()));
  f := io.await(File.open(&path, OpenMode.Write, io), t_e);
  n1 := io.await(f.write_string(`héllo`.to_string(), io), t_e);
  assert(n1 == usize(6), "write_string returns a usize byte count (6 UTF-8 bytes)");
  more := ArrayList(u8).new();
  more.push(u8(0x21));
  n2 := io.await(f.write_bytes(&more, io), t_e);
  assert(n2 == usize(1), "write_bytes returns a usize count");
  io.await(f.close(io), t_e);
  f2 := io.await(File.open(&path, OpenMode.Read, io), t_e);
  s := io.await(f2.read_to_string(io), t_e);
  assert(s == `héllo!`, "round trip");
  io.await(f2.close(io), t_e);
  io.await(remove_file(&path, io), t_e);
});
test("Stdout and Stderr implement Writer", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  // Skipped on wasm (fs-test convention): the emscripten/WASI runtimes'
  // emulated tty has no async fd-1/fd-2 write path — the batch JS throws at
  // the first stdout submission. Native coverage is what this test pins.
  if(arch == Arch.Wasm32, {
    unsafe(printf("  skipped on wasm32\n"));
    return(());
  });
  msg := `d5 stdio writer ok\n`.to_string();
  b := msg;
  o := stdout();
  n := io.await(write_once(&o, b.ptr().unwrap(), b.len(), io), t_e);
  assert(n == b.len(), "stdout write count");
  io.await(o.flush(io), t_e);
  e2 := stderr();
  n2 := io.await(e2.write(b.ptr().unwrap(), b.len(), io), t_e);
  assert(n2 == b.len(), "stderr write count");
});
test("TcpStream carries the Reader and Writer impls", {
  // Registration-level check without opening sockets: the where-bound
  // helpers must ACCEPT a TcpStream-typed argument at compile time. The
  // trait methods delegate to the inherent read/write, whose behavior the
  // tcp tests cover.
  taker_r :: (fn(generic(R : Type), r : &R, where(R <: Reader)) -> bool)(true);
  taker_w :: (fn(generic(W : Type), w : &W, where(W <: Writer)) -> bool)(true);
  fake :: (fn() -> Option(TcpStream))(Option(TcpStream).None);
  match(
    fake(),
    .Some(s) => {
      assert(taker_r(&s), "TcpStream satisfies Reader");
      assert(taker_w(&s), "TcpStream satisfies Writer");
    },
    .None => ()
  );
  assert(true, "TcpStream trait registration type-checks");
});
// ---------------------------------------------------------------------------
// D5 remnant: the `Dyn(Reader)` spelling, which V3 retired. The `Reader`
// defaults (`read_to_end`, `read_to_string`) return futures that BORROW the
// reader, since a move-only `File` cannot be copied into them, and a vtable's
// future type carries no borrow (plans/VALUES_BY_DEFAULT.md §3.13 A2). So no
// reader can be erased, not even a `ref` one whose own `read` owns what it
// uses (issues/questions/2026-10-23-a-move-only-file-cannot-be-a-dyn-reader.md).
// "BufReader wraps ANY Reader" is still true through the generic parameter.
// ---------------------------------------------------------------------------
MemSource :: ref(struct(data : ArrayList(u8), pos : usize));
mem_source :: (fn(text : &String) -> MemSource)(
  MemSource(data : text.to_bytes(), pos : usize(0))
);
impl(
  MemSource,
  Reader(
    read : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
      io.async(e => {
        room := size;
        mut(n) := usize(0);
        while(runtime((n < room) && (self.pos < self.data.len())), {
          consume((buf.add(n)).* = self.data(self.pos));
          self.pos = (self.pos + usize(1));
          n = (n + usize(1));
        });
        n
      })
    )
  )
);
_take_dyn_reader :: (fn(r : Dyn(Reader)) -> bool)(true);
test("no reader is a Dyn(Reader): the Reader defaults borrow it", {
  text := `dyn-reader-ok\nline two\n`.to_string();
  m := mem_source(&text);
  comptime_expect_error(_take_dyn_reader(dyn(m)), "cannot be made a");
});
test("BufReader wraps a user Reader through its generic parameter", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected exception: ${err.to_string()}`);
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  text := `dyn-reader-ok\nline two\n`.to_string();
  m := mem_source(&text);
  rest := io.await(m.read_to_string(io), t_e);
  assert(rest == text, `read_to_string default over a ref reader, got: ${rest}`);
  br := BufReader(MemSource).new(mem_source(&text));
  l1 := io.await(br.read_line(io), t_e);
  assert(match(l1, .Some(s) => (s == `dyn-reader-ok`), .None => false), "BufReader(MemSource) line 1");
  l2 := io.await(br.read_line(io), t_e);
  assert(match(l2, .Some(s) => (s == `line two`), .None => false), "BufReader(MemSource) line 2");
  l3 := io.await(br.read_line(io), t_e);
  assert(l3.is_none(), "BufReader(MemSource) reports EOF");
});
