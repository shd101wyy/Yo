open import "std/libc/stdio";
{ GlobalAllocator } :: import "std/allocator";
{ malloc, free } :: GlobalAllocator;
open import "std/string";
{ platform, Platform, env } :: import "std/process";
dns :: import "std/io/dns";
tcp :: import "std/io/tcp";
{
  AF_INET, AF_INET6,
  SOCK_STREAM, SOCK_DGRAM,
  NI_NUMERICHOST
} :: import "std/io/socket";

test "DNS resolve localhost", using(io : IO), {
  result_ptr := dns.alloc_result();
  ret := io.await(dns.getaddrinfo(*(u8)("localhost"), .None, .None, result_ptr));
  assert(ret == i32(0));

  first_ai := dns.get_result(result_ptr);
  match(first_ai,
    .Some(_) => (),
    .None => assert(false)
  );

  count := i32(0);
  cur := dns.get_result(result_ptr);
  while runtime(true), {
    match(cur,
      .Some(ai) => {
        family := dns.addrinfo_family(ai);
        addrlen := dns.addrinfo_addrlen(ai);
        assert(((family == AF_INET) || (family == AF_INET6)));
        assert(addrlen > u32(0));
        count = (count + i32(1));
        cur = dns.addrinfo_next(ai);
      },
      .None => { break; }
    );
  };
  assert(count >= i32(1));

  match(dns.get_result(result_ptr),
    .Some(ai) => dns.freeaddrinfo(ai),
    .None => ()
  );
  dns.free_result(result_ptr);
};

test "DNS resolve numeric IP 127.0.0.1", using(io : IO), {
  result_ptr := dns.alloc_result();
  ret := io.await(dns.getaddrinfo(*(u8)("127.0.0.1"), .None, .None, result_ptr));
  assert(ret == i32(0));

  match(dns.get_result(result_ptr),
    .Some(ai) => {
      family := dns.addrinfo_family(ai);
      assert(family == AF_INET);
      addrlen := dns.addrinfo_addrlen(ai);
      assert(addrlen == u32(16));
      addr_ptr := dns.addrinfo_addr(ai);
      resolved_family := tcp.get_family(addr_ptr);
      assert(resolved_family == u16(AF_INET));
      dns.freeaddrinfo(ai);
    },
    .None => assert(false)
  );
  dns.free_result(result_ptr);
};

test "DNS resolve with service port", using(io : IO), {
  result_ptr := dns.alloc_result();
  ret := io.await(dns.getaddrinfo(*(u8)("127.0.0.1"), .Some(*(u8)("80")), .None, result_ptr));
  assert(ret == i32(0));

  match(dns.get_result(result_ptr),
    .Some(ai) => {
      addr_ptr := dns.addrinfo_addr(ai);
      port := tcp.get_port_in(addr_ptr);
      assert(port == u16(80));
      dns.freeaddrinfo(ai);
    },
    .None => assert(false)
  );
  dns.free_result(result_ptr);
};

test "DNS getnameinfo reverse lookup", using(io : IO), {
  sa := tcp.make_sockaddr_in_loopback(u16(0));
  host_buf := *(u8)(malloc(usize(256)).unwrap());
  serv_buf := *(u8)(malloc(usize(64)).unwrap());

  // NI_NUMERICHOST: return numeric address string
  ret := io.await(dns.getnameinfo(sa.buf, sa.len, host_buf, usize(256), serv_buf, usize(64), NI_NUMERICHOST));
  assert(ret == i32(0));

  // host_buf should contain "127.0.0.1" (first char '1' = 0x31 = 49)
  assert(host_buf.* == u8(49));

  free(.Some(*(void)(host_buf)));
  free(.Some(*(void)(serv_buf)));
  tcp.free_sockaddr(sa);
};

test "DNS failed resolution for nonexistent host", using(io : IO), {
  result_ptr := dns.alloc_result();
  ret := io.await(dns.getaddrinfo(*(u8)("this.host.definitely.does.not.exist.invalid"), .None, .None, result_ptr));
  // Should fail with some EAI_* error (non-zero)
  assert(ret != i32(0));
  dns.free_result(result_ptr);
};

test "DNS alloc_hints and addrinfo_size", {
  size := dns.addrinfo_size();
  assert(size > usize(0));
  hints := dns.alloc_hints();
  dns.free_hints(hints);
};
