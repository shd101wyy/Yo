open import "std/libc/stdio";
{ malloc, free } :: import "std/libc/stdlib";
{
  O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC, O_DIRECTORY,
  AT_FDCWD, AT_REMOVEDIR, DT_DIR, DT_REG
} :: import "std/io/constants";
{
  openat, close, read, write
} :: import "std/io/file";
dir :: import "std/io/dir";

test "async mkdir and rmdir", {
  async {
    dir_path := *(u8)("/tmp/yo_io_dir_test");
    unlink_result := await dir.unlink(AT_FDCWD, dir_path, AT_REMOVEDIR);
    printf("  cleanup = %d\n", unlink_result);
    mk_result := await dir.mkdir(AT_FDCWD, dir_path, i32(0o755));
    printf("  mkdir = %d\n", mk_result);
    assert(mk_result == i32(0));
    rm_result := await dir.unlink(AT_FDCWD, dir_path, AT_REMOVEDIR);
    printf("  rmdir = %d\n", rm_result);
    assert(rm_result == i32(0));
  };
};

test "mkdir existing returns -EEXIST", {
  async {
    dir_path := *(u8)("/tmp/yo_io_dir_test2");
    await dir.unlink(AT_FDCWD, dir_path, AT_REMOVEDIR);
    mk1 := await dir.mkdir(AT_FDCWD, dir_path, i32(0o755));
    assert(mk1 == i32(0));
    mk2 := await dir.mkdir(AT_FDCWD, dir_path, i32(0o755));
    printf("  mkdir existing = %d\n", mk2);
    assert(mk2 < i32(0));
    await dir.unlink(AT_FDCWD, dir_path, AT_REMOVEDIR);
  };
};

test "async rename", {
  async {
    old_path := *(u8)("/tmp/yo_io_rename_src");
    new_path := *(u8)("/tmp/yo_io_rename_dst");
    await dir.unlink(AT_FDCWD, old_path, i32(0));
    await dir.unlink(AT_FDCWD, new_path, i32(0));
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    open_result := await openat(AT_FDCWD, old_path, write_flags, i32(0o644));
    printf("  create = %d\n", open_result);
    assert(open_result >= i32(0));
    data := *(u8)("rename test");
    wr := await write(open_result, data, u32(11), u64(0));
    assert(wr == i32(11));
    await close(open_result);
    ren_result := await dir.rename(AT_FDCWD, old_path, AT_FDCWD, new_path);
    printf("  rename = %d\n", ren_result);
    assert(ren_result == i32(0));
    old_open := await openat(AT_FDCWD, old_path, O_RDONLY, i32(0));
    printf("  open old = %d\n", old_open);
    assert(old_open < i32(0));
    new_open := await openat(AT_FDCWD, new_path, O_RDONLY, i32(0));
    printf("  open new = %d\n", new_open);
    assert(new_open >= i32(0));
    buf := *(u8)(malloc(usize(64)).unwrap());
    rd := await read(new_open, buf, u32(64), u64(0));
    printf("  read = %d\n", rd);
    assert(rd == i32(11));
    assert((buf &+ usize(0)).* == u8(114));
    await close(new_open);
    free(.Some(*(void)(buf)));
    await dir.unlink(AT_FDCWD, new_path, i32(0));
  };
};

test "async symlink and readlink", {
  async {
    target := *(u8)("/tmp/yo_io_symlink_target");
    link_path := *(u8)("/tmp/yo_io_symlink_link");
    await dir.unlink(AT_FDCWD, link_path, i32(0));
    await dir.unlink(AT_FDCWD, target, i32(0));
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := await openat(AT_FDCWD, target, write_flags, i32(0o644));
    printf("  openat = %d\n", fd);
    assert(fd >= i32(0));
    data := *(u8)("symlink target");
    wr := await write(fd, data, u32(14), u64(0));
    assert(wr == i32(14));
    await close(fd);
    sym_result := await dir.symlink(target, AT_FDCWD, link_path);
    printf("  symlink = %d\n", sym_result);
    assert(sym_result == i32(0));
    readlink_buf := *(u8)(malloc(usize(256)).unwrap());
    rl_result := await dir.readlink(AT_FDCWD, link_path, readlink_buf, usize(256));
    printf("  readlink = %d\n", rl_result);
    assert(rl_result > i32(0));
    assert((readlink_buf &+ usize(0)).* == u8(47));
    fd2 := await openat(AT_FDCWD, link_path, O_RDONLY, i32(0));
    printf("  open via link = %d\n", fd2);
    assert(fd2 >= i32(0));
    read_buf := *(u8)(malloc(usize(64)).unwrap());
    rd := await read(fd2, read_buf, u32(64), u64(0));
    printf("  read via link = %d\n", rd);
    assert(rd == i32(14));
    assert((read_buf &+ usize(0)).* == u8(115));
    await close(fd2);
    free(.Some(*(void)(readlink_buf)));
    free(.Some(*(void)(read_buf)));
    await dir.unlink(AT_FDCWD, link_path, i32(0));
    await dir.unlink(AT_FDCWD, target, i32(0));
  };
};

test "async hard link", {
  async {
    orig_path := *(u8)("/tmp/yo_io_link_orig");
    link_path := *(u8)("/tmp/yo_io_link_hard");
    await dir.unlink(AT_FDCWD, link_path, i32(0));
    await dir.unlink(AT_FDCWD, orig_path, i32(0));
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := await openat(AT_FDCWD, orig_path, write_flags, i32(0o644));
    printf("  create orig = %d\n", fd);
    assert(fd >= i32(0));
    data := *(u8)("hardlink data");
    wr := await write(fd, data, u32(13), u64(0));
    assert(wr == i32(13));
    await close(fd);
    link_result := await dir.link(AT_FDCWD, orig_path, AT_FDCWD, link_path, i32(0));
    printf("  link = %d\n", link_result);
    assert(link_result == i32(0));
    fd2 := await openat(AT_FDCWD, link_path, O_RDONLY, i32(0));
    printf("  open link = %d\n", fd2);
    assert(fd2 >= i32(0));
    buf := *(u8)(malloc(usize(64)).unwrap());
    rd := await read(fd2, buf, u32(64), u64(0));
    printf("  read via link = %d\n", rd);
    assert(rd == i32(13));
    assert((buf &+ usize(0)).* == u8(104));
    await close(fd2);
    free(.Some(*(void)(buf)));
    await dir.unlink(AT_FDCWD, orig_path, i32(0));
    await dir.unlink(AT_FDCWD, link_path, i32(0));
  };
};

test "async unlink file", {
  async {
    file_path := *(u8)("/tmp/yo_io_unlink_file");
    await dir.unlink(AT_FDCWD, file_path, i32(0));
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := await openat(AT_FDCWD, file_path, write_flags, i32(0o644));
    printf("  create = %d\n", fd);
    assert(fd >= i32(0));
    data := *(u8)("delete me");
    wr := await write(fd, data, u32(9), u64(0));
    assert(wr == i32(9));
    await close(fd);
    check_fd := await openat(AT_FDCWD, file_path, O_RDONLY, i32(0));
    printf("  exists = %d\n", check_fd);
    assert(check_fd >= i32(0));
    await close(check_fd);
    unlink_result := await dir.unlink(AT_FDCWD, file_path, i32(0));
    printf("  unlink = %d\n", unlink_result);
    assert(unlink_result == i32(0));
    gone_fd := await openat(AT_FDCWD, file_path, O_RDONLY, i32(0));
    printf("  after unlink = %d\n", gone_fd);
    assert(gone_fd < i32(0));
  };
};

test "unlink nonexistent returns -ENOENT", {
  async {
    bad_path := *(u8)("/tmp/yo_io_nonexistent_file_999");
    result := await dir.unlink(AT_FDCWD, bad_path, i32(0));
    printf("  unlink nonexistent = %d\n", result);
    assert(result < i32(0));
  };
};

test "async getdents lists directory entries", {
  async {
    test_dir := *(u8)("/tmp/yo_io_readdir_test");
    await dir.unlink(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/file_a.txt"), i32(0));
    await dir.unlink(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/file_b.txt"), i32(0));
    await dir.unlink(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/subdir"), AT_REMOVEDIR);
    await dir.unlink(AT_FDCWD, test_dir, AT_REMOVEDIR);

    mk := await dir.mkdir(AT_FDCWD, test_dir, i32(0o755));
    assert(mk == i32(0));

    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd_a := await openat(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/file_a.txt"), write_flags, i32(0o644));
    assert(fd_a >= i32(0));
    await close(fd_a);

    fd_b := await openat(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/file_b.txt"), write_flags, i32(0o644));
    assert(fd_b >= i32(0));
    await close(fd_b);

    subdir_mk := await dir.mkdir(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/subdir"), i32(0o755));
    assert(subdir_mk == i32(0));

    open_flags := (O_RDONLY | O_DIRECTORY);
    dir_fd := await openat(AT_FDCWD, test_dir, open_flags, i32(0));
    printf("  open dir = %d\n", dir_fd);
    assert(dir_fd >= i32(0));

    buf := *(u8)(malloc(usize(4096)).unwrap());
    entry_count := i32(0);
    dir_count := i32(0);
    file_count := i32(0);

    while runtime(true), {
      n := await dir.getdents(dir_fd, buf, u32(4096));
      printf("  getdents = %d\n", n);
      cond(
        (n <= i32(0)) => { break; },
        true => {
          offset := u32(0);
          while runtime(true), {
            cond(
              (offset >= u32(n)) => { break; },
              true => {
                entry := (buf &+ usize(offset));
                name := dir.dirent_name(entry);
                entry_type := dir.dirent_type(entry);
                printf("    entry: %s (type=%d)\n", name, i32(entry_type));
                entry_count = (entry_count + i32(1));
                cond(
                  (entry_type == DT_DIR) => { dir_count = (dir_count + i32(1)); },
                  (entry_type == DT_REG) => { file_count = (file_count + i32(1)); },
                  true => { unit; }
                );
                reclen := dir.dirent_reclen(entry);
                offset = (offset + u32(reclen));
              }
            );
          };
        }
      );
    };

    printf("  total entries = %d\n", entry_count);
    printf("  dir entries = %d\n", dir_count);
    printf("  file entries = %d\n", file_count);

    assert(entry_count >= i32(5));
    assert(dir_count >= i32(3));
    assert(file_count >= i32(2));

    free(.Some(*(void)(buf)));
    await close(dir_fd);

    await dir.unlink(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/file_a.txt"), i32(0));
    await dir.unlink(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/file_b.txt"), i32(0));
    await dir.unlink(AT_FDCWD, *(u8)("/tmp/yo_io_readdir_test/subdir"), AT_REMOVEDIR);
    await dir.unlink(AT_FDCWD, test_dir, AT_REMOVEDIR);
  };
};
