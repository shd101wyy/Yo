open import "std/libc/stdio";
{ GlobalAllocator } :: import "std/allocator";
{ malloc, free } :: GlobalAllocator;
open import "std/string";
{ platform, Platform, env } :: import "std/process";
perm :: import "std/io/perm";
file :: import "std/io/file";
dir :: import "std/io/dir";
{
  AT_FDCWD, O_WRONLY, O_CREAT, O_TRUNC, O_RDONLY,
  F_OK, R_OK, W_OK, X_OK
} :: import "std/io/constants";
{ temp_dir, path_join } :: import "./helper";

// Helper: create a temp test file with given content, return the path as *(u8)
make_test_file :: (fn() -> *(u8)) {
  tmp := temp_dir();
  p := path_join(tmp, `yo_perm_test.txt`);
  c := p.to_cstr();
  c.ptr().unwrap()
};

test "access F_OK R_OK W_OK on existing file", {
  async {
    test_path := make_test_file();
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := await file.openat(AT_FDCWD, test_path, write_flags, i32(0o644));
    assert(fd >= i32(0));
    data := *(u8)("perm test data");
    wr := await file.write(fd, data, u32(14), u64(0));
    assert(wr == i32(14));
    cr := await file.close(fd);
    assert(cr == i32(0));

    ret_f := await perm.access(AT_FDCWD, test_path, F_OK);
    assert(ret_f == i32(0));
    ret_r := await perm.access(AT_FDCWD, test_path, R_OK);
    assert(ret_r == i32(0));
    ret_w := await perm.access(AT_FDCWD, test_path, W_OK);
    assert(ret_w == i32(0));

    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};

test "access on nonexistent file returns -ENOENT", {
  async {
    ret := await perm.access(AT_FDCWD, *(u8)("/tmp/yo_perm_nonexistent_file_12345.txt"), F_OK);
    assert(ret == i32(-2));
  };
};

test "chmodat changes and restores permissions", {
  async {
    test_path := make_test_file();
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := await file.openat(AT_FDCWD, test_path, write_flags, i32(0o644));
    assert(fd >= i32(0));
    data := *(u8)("chmod test");
    wr := await file.write(fd, data, u32(10), u64(0));
    assert(wr == i32(10));
    cr := await file.close(fd);
    assert(cr == i32(0));

    // chmod to read-only (0o444)
    ret := await perm.chmodat(AT_FDCWD, test_path, u32(0o444), i32(0));
    assert(ret == i32(0));

    // Should be readable
    ret_r := await perm.access(AT_FDCWD, test_path, R_OK);
    assert(ret_r == i32(0));

    // Should NOT be writable (non-root: -EACCES = -13)
    ret_w := await perm.access(AT_FDCWD, test_path, W_OK);
    assert(ret_w == i32(-13));

    // Restore to 0644
    ret_b := await perm.chmodat(AT_FDCWD, test_path, u32(0o644), i32(0));
    assert(ret_b == i32(0));

    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};

test "fchmod by fd sets executable bit", {
  async {
    test_path := make_test_file();
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd_w := await file.openat(AT_FDCWD, test_path, write_flags, i32(0o644));
    assert(fd_w >= i32(0));
    data := *(u8)("fchmod test");
    wr := await file.write(fd_w, data, u32(11), u64(0));
    assert(wr == i32(11));
    cr_w := await file.close(fd_w);
    assert(cr_w == i32(0));

    fd := await file.openat(AT_FDCWD, test_path, O_RDONLY, i32(0));
    assert(fd >= i32(0));

    // fchmod to 0o755 (rwxr-xr-x)
    ret := await perm.fchmod(fd, u32(0o755));
    assert(ret == i32(0));

    // Verify executable bit
    ret_x := await perm.access(AT_FDCWD, test_path, X_OK);
    assert(ret_x == i32(0));

    // Restore to 0644
    ret_b := await perm.fchmod(fd, u32(0o644));
    assert(ret_b == i32(0));

    cr := await file.close(fd);
    assert(cr == i32(0));

    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};

test "chmodat on nonexistent file returns -ENOENT", {
  async {
    ret := await perm.chmodat(AT_FDCWD, *(u8)("/tmp/yo_perm_nonexistent_12345.txt"), u32(0o644), i32(0));
    assert(ret == i32(-2));
  };
};

test "fchown with -1 -1 succeeds (no change)", {
  async {
    test_path := make_test_file();
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd_w := await file.openat(AT_FDCWD, test_path, write_flags, i32(0o644));
    assert(fd_w >= i32(0));
    data := *(u8)("chown test");
    wr := await file.write(fd_w, data, u32(10), u64(0));
    assert(wr == i32(10));
    cr_w := await file.close(fd_w);
    assert(cr_w == i32(0));

    fd := await file.openat(AT_FDCWD, test_path, O_RDONLY, i32(0));
    assert(fd >= i32(0));

    // chown to -1, -1 (no change) should succeed
    ret := await perm.fchown(fd, u32(4294967295), u32(4294967295));
    assert(ret == i32(0));

    cr := await file.close(fd);
    assert(cr == i32(0));

    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};
