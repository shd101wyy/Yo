open import "std/libc/stdio";
open import "std/string";
open import "std/collections/array_list";
{ platform, Platform, env } :: import "std/process";
file :: import "std/io/file";
dir :: import "std/io/dir";
time :: import "std/io/time";
{ Statx } :: import "std/io/statx";
{
  AT_FDCWD, O_WRONLY, O_CREAT, O_TRUNC, O_RDONLY,
  STATX_BASIC_STATS
} :: import "std/io/constants";
{ temp_dir, path_join } :: import "./helper";

make_test_file :: (fn(name: String) -> ArrayList(u8)) {
  tmp := temp_dir();
  p := path_join(tmp, name);
  p.to_cstr()
};

create_file :: (fn(test_path: *(u8), content: *(u8), content_len: u32) -> Impl(Future(unit)))(async {
  write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
  fd := await file.openat(AT_FDCWD, test_path, write_flags, i32(0o644));
  assert(fd >= i32(0));
  wr := await file.write(fd, content, content_len, u64(0));
  assert(wr == i32(content_len));
  cr := await file.close(fd);
  assert(cr == i32(0));
});

test "utime sets specific timestamps", {
  async {
    path_cstr := make_test_file(`yo_time_utime.txt`);
    test_path := path_cstr.ptr().unwrap();
    await create_file(test_path, *(u8)("utime test"), u32(10));

    ret := await time.utime(test_path, i64(1000000), i64(0), i64(2000000), i64(0));
    assert(ret == i32(0));

    statx_uninit := MaybeUninit(Array(u8, usize(256))).new();
    stat_buf := *(u8)(statx_uninit.as_ptr());
    sr := await file.statx(AT_FDCWD, test_path, i32(0), STATX_BASIC_STATS, stat_buf);
    assert(sr == i32(0));
    st := Statx(stat_buf, usize(256));
    assert(st.atime_sec() == i64(1000000));
    assert(st.mtime_sec() == i64(2000000));

    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};

test "futime sets timestamps by fd with nanosecond precision", {
  async {
    path_cstr := make_test_file(`yo_time_futime.txt`);
    test_path := path_cstr.ptr().unwrap();
    await create_file(test_path, *(u8)("futime test"), u32(11));

    fd := await file.openat(AT_FDCWD, test_path, O_RDONLY, i32(0));
    assert(fd >= i32(0));

    ret := await time.futime(fd, i64(3000000), i64(500000000), i64(4000000), i64(750000000));
    assert(ret == i32(0));

    statx_uninit := MaybeUninit(Array(u8, usize(256))).new();
    stat_buf := *(u8)(statx_uninit.as_ptr());
    sr := await file.statx(AT_FDCWD, test_path, i32(0), STATX_BASIC_STATS, stat_buf);
    assert(sr == i32(0));
    st := Statx(stat_buf, usize(256));
    assert(st.atime_sec() == i64(3000000));
    assert(st.atime_nsec() == u32(500000000));
    assert(st.mtime_sec() == i64(4000000));
    assert(st.mtime_nsec() == u32(750000000));

    cr := await file.close(fd);
    assert(cr == i32(0));
    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};

test "utime on nonexistent file returns -ENOENT", {
  async {
    ret := await time.utime(*(u8)("/tmp/yo_time_nonexistent_12345.txt"), i64(100), i64(0), i64(200), i64(0));
    assert(ret == i32(-2));
  };
};

test "lutime changes symlink timestamps without affecting target", {
  async {
    path_cstr := make_test_file(`yo_time_lutime_target.txt`);
    test_path := path_cstr.ptr().unwrap();
    await create_file(test_path, *(u8)("lutime test"), u32(11));

    ret_t := await time.utime(test_path, i64(3000000), i64(0), i64(4000000), i64(0));
    assert(ret_t == i32(0));

    link_cstr := make_test_file(`yo_time_lutime_link.txt`);
    link_path := link_cstr.ptr().unwrap();
    lr := await dir.symlink(test_path, AT_FDCWD, link_path);
    assert(lr == i32(0));

    ret := await time.lutime(link_path, i64(5000000), i64(0), i64(6000000), i64(0));
    assert(ret == i32(0));

    statx_uninit := MaybeUninit(Array(u8, usize(256))).new();
    stat_buf := *(u8)(statx_uninit.as_ptr());
    sr := await file.statx(AT_FDCWD, test_path, i32(0), STATX_BASIC_STATS, stat_buf);
    assert(sr == i32(0));
    st := Statx(stat_buf, usize(256));
    assert(st.atime_sec() == i64(3000000));
    assert(st.mtime_sec() == i64(4000000));

    cleanup_link := await dir.unlink(AT_FDCWD, link_path, i32(0));
    assert(cleanup_link == i32(0));
    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};

test "utime with nanosecond precision", {
  async {
    path_cstr := make_test_file(`yo_time_nsec.txt`);
    test_path := path_cstr.ptr().unwrap();
    await create_file(test_path, *(u8)("nsec test"), u32(9));

    ret := await time.utime(test_path, i64(1700000000), i64(123456789), i64(1700000001), i64(987654321));
    assert(ret == i32(0));

    statx_uninit := MaybeUninit(Array(u8, usize(256))).new();
    stat_buf := *(u8)(statx_uninit.as_ptr());
    sr := await file.statx(AT_FDCWD, test_path, i32(0), STATX_BASIC_STATS, stat_buf);
    assert(sr == i32(0));
    st := Statx(stat_buf, usize(256));
    assert(st.atime_sec() == i64(1700000000));
    assert(st.atime_nsec() == u32(123456789));
    assert(st.mtime_sec() == i64(1700000001));
    assert(st.mtime_nsec() == u32(987654321));

    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};

test "futime preserves file content", {
  async {
    path_cstr := make_test_file(`yo_time_content.txt`);
    test_path := path_cstr.ptr().unwrap();
    await create_file(test_path, *(u8)("preserve me!"), u32(12));

    fd := await file.openat(AT_FDCWD, test_path, O_RDONLY, i32(0));
    assert(fd >= i32(0));

    ret := await time.futime(fd, i64(9999), i64(0), i64(8888), i64(0));
    assert(ret == i32(0));

    read_uninit := MaybeUninit(Array(u8, usize(64))).new();
    read_buf := *(u8)(read_uninit.as_ptr());
    rd := await file.read(fd, read_buf, u32(12), u64(0));
    assert(rd == i32(12));

    cr := await file.close(fd);
    assert(cr == i32(0));
    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    assert(cleanup == i32(0));
  };
};
