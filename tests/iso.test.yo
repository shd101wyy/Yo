test "Test basic Iso related functions", {
  x := Box(i32)(42);

  i1 := Iso(Box(i32))(x);
  i2 := i1;
  i3 := i1;

  // f :: Type.impls(typeof(i1), Send);

  e1 := __yo_iso_extract(i2).unwrap();
  assert(e1.* == 42);

  e2 := i2.extract();
  assert(e2.is_none());

  e3 := Iso(Box(i32)).extract(i3);
  assert(e3.is_none());
};

test "Test Iso dispose inner value when not extracted", {
  x := Box(i32)(12);
  
  isolated := Option(Iso(Box(i32))).Some Iso(Box(i32))(x);

  match(isolated,
    .Some(_) => {
      assert(true);
    },
    .None => {
      assert(false, "Expected Some, got None");
    }
  );
  
  return ();
};