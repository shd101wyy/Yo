{ assert } :: import("std/assert");
import("std/string");
import("std/fmt");
{ IoFuture } :: import("std/sys/future");
{ Park } :: import("std/async/waker");
{ size_would_overflow } :: import("std/allocator");
{ Arena } :: import("std/arena");
{ ArrayList } :: import("std/collections/array_list");
// A function whose type parameter is pinned ONLY by an explicit
// `comptime(C) : Type` argument used to be routed into the CTFE
// type-constructor path (every argument was a type), which cannot resolve a
// return type that names a comptime parameter — so the call's result came back
// under-resolved and any method on it failed to resolve. The same gate also
// CTFE-executed an ordinary runtime body.
// issues/fixed/comptime-type-argument-alone-does-not-bind-the-generic.md
_dflt :: (fn(comptime(C) : Type, where(C <: Default)) -> C)((C <: Default).default());
_pick :: (fn(comptime(C) : Type, v : C) -> C)(v);
_dflt2 :: (fn(comptime(C) : Type, hint : C, where(C <: Default)) -> C)(
  (C <: Default).default()
);
_dflt4 :: (fn(comptime(C) : Type, dummy : i32, where(C <: Default)) -> C)(
  (C <: Default).default()
);
// Declared return is a plain runtime type, and the body is NOT comptime-known.
_runtime_body :: (fn(comptime(C) : Type) -> i32)({
  n := i32(7);
  n = (n + i32(1));
  n
});
// A real type constructor must keep its memoized identity.
_Box :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    v : T
  )
);
_takes_box :: (fn(b : _Box(i32)) -> i32)(b.v);
test("a generic bound only by the comptime type argument resolves", {
  a := _dflt(i32);
  assert(a == i32(0), "i32 default through a comptime type argument");
  assert(a.to_string() == `0`, "and the result type is usable");
  b := _dflt(bool);
  assert(!b, "bool default through the same shape");
});
test("the shapes that already worked still work", {
  assert(_pick(i32, i32(5)) == i32(5), "value parameter of type C");
  assert(_dflt2(i32, i32(0)) == i32(0), "dummy hint of type C");
  assert(_dflt4(i32, i32(0)) == i32(0), "dummy parameter unrelated to C");
});
test("an all-comptime-args call is not CTFE-executed", {
  assert(_runtime_body(i32) == i32(8), "runtime body runs at runtime");
});
test("type constructors keep one identity per instantiation", {
  x := _Box(i32)(v : i32(3));
  y := _Box(i32)(v : i32(4));
  assert(_takes_box(x) == i32(3), "first instantiation");
  assert(_takes_box(y) == i32(4), "second instantiation is the same type");
});
// A generic impl's method on a struct whose parameters are PHANTOM (used by no
// field) must be found through a `comptime(K) : Type` helper parameter: the
// helper was not deferred, so its body was checked against the abstract
// `_Phantom(K, V)` and `b.size()` reported "No method" (imm/map's `MapBranch`
// shape). issues/fixed/method-on-a-phantom-generic-struct-is-not-found-through-a-comptime-type-param.md
_Phantom :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(ref(struct(n : u8)));
impl(generic(K : Type, V : Type), _Phantom(K, V), size : (fn(self : Self) -> u8)(self.n));
_phantom_size :: (fn(comptime(K) : Type, comptime(V) : Type, b : _Phantom(K, V)) -> u8)(b.size());
test("A method on a phantom generic struct resolves through a comptime type parameter", {
  x := _Phantom(i32, i32)(n : u8(3));
  assert(_phantom_size(i32, i32, x) == u8(3), "struct");
  y := _Phantom(bool, u8)(n : u8(7));
  assert(_phantom_size(bool, u8, y) == u8(7), "a second instantiation");
});
// A `comptime(T) : Type` argument that is (or holds) a SomeT already resolved
// to a concrete type — `IoFuture :: Impl(Concrete(__yo_io_future_t),
// Future(i32))`, std/async/waker's `Park` — was treated as an unresolved
// placeholder, so the call never specialized and codegen dropped it: an
// internal compiler error in `main`, an abort stub anywhere else.
// issues/fixed/a-comptime-type-argument-holding-a-resolved-impl-never-specializes.md
_FutHolder :: ref(struct(f : IoFuture));
_ignore_t :: (fn(comptime(T) : Type, n : usize) -> usize)(n);
test("A comptime type argument holding a resolved Impl specializes", {
  (m : usize) = usize(4);
  assert(_ignore_t(IoFuture, m) == usize(4), "the Impl itself");
  assert(_ignore_t(_FutHolder, m) == usize(4), "a struct holding one");
  assert(!size_would_overflow(Park, usize(4)), "std's Park");
  arena := Arena.new(usize(4096));
  xs := ArrayList(Park).with_capacity_in(arena.allocator(), usize(0));
  assert(xs.len() == usize(0), "an ArrayList of Park in an explicit allocator");
});

// The enum twin: an enum's instantiation arguments live on `EnumT` itself
// (they used to be in a side table that substitution left stale), so a
// phantom `_PhantomTag(K)` defers its helper and specializes per instance.
// issues/fixed/method-on-a-phantom-generic-enum-is-not-found-through-a-comptime-type-param.md
_PhantomTag :: (fn(comptime(K) : Type) -> comptime(Type))(enum(A, B(n : u8)));
impl(generic(K : Type), _PhantomTag(K), code : (fn(self : Self) -> u8)(match(self, .A => u8(0), .B(n) => n)));
_phantom_code :: (fn(comptime(K) : Type, t : _PhantomTag(K)) -> u8)(t.code());
test("A method on a phantom generic enum resolves through a comptime type parameter", {
  t := _PhantomTag(i32).B(n : u8(5));
  assert(_phantom_code(i32, t) == u8(5), "enum");
  u := _PhantomTag(bool).A;
  assert(_phantom_code(bool, u) == u8(0), "a second instantiation");
});
// Each instantiation gets its own specialization, also when the method reads
// the phantom parameter: the abstract and the concrete instances used to
// share one key, and two concrete ones one structural C key.
impl(generic(K : Type), _PhantomTag(K), width : (fn(self : Self) -> usize)(sizeof(K)));
_phantom_width :: (fn(comptime(K) : Type, t : _PhantomTag(K)) -> usize)(t.width());
test("A phantom generic enum's method that reads K specializes per instantiation", {
  assert(_PhantomTag(i32).A.width() == usize(4), "direct, i32");
  assert(_PhantomTag(u8).A.width() == usize(1), "direct, u8");
  assert(_phantom_width(i64, _PhantomTag(i64).A) == usize(8), "through the helper, i64");
  assert(_phantom_width(u16, _PhantomTag(u16).B(n : u8(1))) == usize(2), "through the helper, u16");
});
