pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ Path } :: import("std/path");
{ IoError } :: import("std/sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
fs_walker :: import("std/fs/walker");
{ WalkEntry, WalkOptions } :: import("std/fs/walker");
{ FileType } :: import("std/fs/dir");
fs_dir :: import("std/fs/dir");
fs_file :: import("std/fs/file");
{ temp_dir, path_join } :: import("../helper");
// ============================================================================
// Helper to set up a test directory tree
// ============================================================================
// Creates:
//   root/
//     a.txt
//     b.txt
//     sub/
//       c.txt
//       deep/
//         d.txt
_setup_walk_tree :: (fn(root : String, io : Io, exn : Exception) -> unit)({
  io.await(fs_dir.create_dir_all(Path.new(root), io), IoExn(io : io, exn : exn));
  sub := path_join(root, `sub`);
  io.await(fs_dir.create_dir_all(Path.new(sub), io), IoExn(io : io, exn : exn));
  deep := path_join(sub, `deep`);
  io.await(fs_dir.create_dir_all(Path.new(deep), io), IoExn(io : io, exn : exn));
  io.await(fs_file.write_file(Path.new(path_join(root, `a.txt`)), String.from("a"), io), IoExn(io : io, exn : exn));
  io.await(fs_file.write_file(Path.new(path_join(root, `b.txt`)), String.from("b"), io), IoExn(io : io, exn : exn));
  io.await(fs_file.write_file(Path.new(path_join(sub, `c.txt`)), String.from("c"), io), IoExn(io : io, exn : exn));
  io.await(fs_file.write_file(Path.new(path_join(deep, `d.txt`)), String.from("d"), io), IoExn(io : io, exn : exn));
});
_cleanup_walk_tree :: (fn(root : String, io : Io, exn : Exception) -> unit)({
  sub := path_join(root, `sub`);
  deep := path_join(sub, `deep`);
  io.await(fs_dir.remove_file(Path.new(path_join(deep, `d.txt`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(Path.new(deep), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(Path.new(path_join(sub, `c.txt`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(Path.new(sub), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(Path.new(path_join(root, `b.txt`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(Path.new(path_join(root, `a.txt`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(Path.new(root), io), IoExn(io : io, exn : exn));
});
// ============================================================================
// walk with default options
// ============================================================================
test("walk lists all entries recursively", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  root := path_join(tmp, `yo_fs_walk_default`);
  _setup_walk_tree(root, io, exn);
  entries := io.await(fs_walker.walk(Path.new(root), io), IoExn(io : io, exn : exn));
  unsafe(printf("  entries count = %lld\n", i64(entries.len())));
  // Should have: sub, deep (dirs) + a.txt, b.txt, c.txt, d.txt (files) = 6
  // Default include_dirs = true
  i := usize(0);
  while(runtime(i < entries.len()), {
    e := entries(i);
    unsafe(printf("  [%d] %s\n", i32(e.depth), e.name.to_cstr().ptr().unwrap()));
    i = (i + usize(1));
  });
  assert(entries.len() == usize(6), "expected 6 entries (2 dirs + 4 files)");
  _cleanup_walk_tree(root, io, exn);
});
// ============================================================================
// walk_with max_depth
// ============================================================================
test("walk_with max_depth limits traversal", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  root := path_join(tmp, `yo_fs_walk_depth`);
  _setup_walk_tree(root, io, exn);
  opts := WalkOptions(
    max_depth : .Some(u32(0)),
    follow_symlinks : false,
    include_dirs : true
  );
  entries := io.await(fs_walker.walk_with(Path.new(root), opts, io), IoExn(io : io, exn : exn));
  unsafe(printf("  entries at depth 0 = %lld\n", i64(entries.len())));
  // At depth 0: a.txt, b.txt, sub (dir) = 3
  i := usize(0);
  while(runtime(i < entries.len()), {
    e := entries(i);
    unsafe(printf("  [%d] %s\n", i32(e.depth), e.name.to_cstr().ptr().unwrap()));
    i = (i + usize(1));
  });
  assert(entries.len() == usize(3), "expected 3 entries at depth 0");
  _cleanup_walk_tree(root, io, exn);
});
// ============================================================================
// walk_with include_dirs = false
// ============================================================================
test("walk_with include_dirs false excludes directories", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  root := path_join(tmp, `yo_fs_walk_nodirs`);
  _setup_walk_tree(root, io, exn);
  opts := WalkOptions(
    max_depth : .None,
    follow_symlinks : false,
    include_dirs : false
  );
  entries := io.await(fs_walker.walk_with(Path.new(root), opts, io), IoExn(io : io, exn : exn));
  unsafe(printf("  file-only entries = %lld\n", i64(entries.len())));
  // Only files: a.txt, b.txt, c.txt, d.txt = 4
  i := usize(0);
  while(runtime(i < entries.len()), {
    e := entries(i);
    unsafe(printf("  %s\n", e.name.to_cstr().ptr().unwrap()));
    is_file := match(e.file_type, .File => true, _ => false);
    assert(is_file, "should only have files");
    i = (i + usize(1));
  });
  assert(entries.len() == usize(4), "expected 4 files");
  _cleanup_walk_tree(root, io, exn);
});
// ============================================================================
// WalkOptions.defaults
// ============================================================================
test("WalkOptions.defaults has expected values", {
  opts := WalkOptions.defaults();
  assert(!(opts.follow_symlinks), "follow_symlinks should be false");
  assert(opts.include_dirs, "include_dirs should be true");
  max_is_none := match(opts.max_depth, .None => true, _ => false);
  assert(max_is_none, "max_depth should be None");
});
// ============================================================================
// walk on nonexistent
// ============================================================================
test("walk nonexistent returns error", {
  exn := Exception(
    throw : (
      (err) -> {
        unsafe(printf("  got expected error\n"));
        unwind(());
      }
    )
  );
  io.await(fs_walker.walk(Path.new(`/nonexistent/yo_fs_walk_nope`), io), IoExn(io : io, exn : exn));
  assert(false, "walk on nonexistent should fail");
});
// ============================================================================
// walk_cstr
// ============================================================================
test("walk_cstr works with C string path", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  root := path_join(tmp, `yo_fs_walk_cstr`);
  root_cstr := root.to_cstr();
  root_c := root_cstr.ptr().unwrap();
  io.await(fs_dir.create_dir_all(Path.new(root), io), IoExn(io : io, exn : exn));
  io.await(fs_file.write_file(Path.new(path_join(root, `x.txt`)), String.from("x"), io), IoExn(io : io, exn : exn));
  entries := io.await(fs_walker.walk_cstr(root_c, io), IoExn(io : io, exn : exn));
  unsafe(printf("  walk_cstr entries = %lld\n", i64(entries.len())));
  assert(entries.len() == usize(1), "expected 1 entry");
  io.await(fs_dir.remove_file(Path.new(path_join(root, `x.txt`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(Path.new(root), io), IoExn(io : io, exn : exn));
});
