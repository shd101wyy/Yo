open import "std/libc/stdio";
open import "std/string";
{ Path } :: import "std/path";
{ IOError } :: import "std/io/errors";
{ TempDir, TempFile } :: import "std/fs/temp";
fs_file :: import "std/fs/file";
{ File } :: import "std/fs/file";
fs_dir :: import "std/fs/dir";
{ temp_dir, path_join } :: import "../helper";

// ============================================================================
// TempDir
// ============================================================================

test "TempDir.new creates a directory", using(io : IO), {
  r := io.await(TempDir.new(using(io)));
  match(r,
    .Ok(td) => {
      p := td.path().to_string();
      printf("  temp dir path = %s\n", p.to_cstr().ptr().unwrap());
      assert((p.len() > usize(0)), "path should not be empty");

      // Verify it exists
      ex := io.await(fs_file.exists(td.path(), using(io)));
      match(ex,
        .Ok(e) => assert(e, "temp dir should exist"),
        .Err(e) => assert(false, "exists check failed")
      );

      // Remove
      rm := io.await(td.remove(using(io)));
      match(rm,
        .Ok(_) => printf("  removed ok\n"),
        .Err(e) => assert(false, "TempDir.remove failed")
      );

      // Verify removed
      ex2 := io.await(fs_file.exists(td.path(), using(io)));
      match(ex2,
        .Ok(e) => assert((!(e)), "temp dir should not exist after remove"),
        .Err(e) => assert(false, "exists check failed")
      );
    },
    .Err(e) => assert(false, "TempDir.new failed")
  );
};

test "TempDir.new_in creates in specified parent", using(io : IO), {
  tmp := temp_dir();
  parent := Path.new(tmp);

  r := io.await(TempDir.new_in(parent, using(io)));
  match(r,
    .Ok(td) => {
      p := td.path().to_string();
      printf("  temp dir path = %s\n", p.to_cstr().ptr().unwrap());

      // Path should start with parent
      assert(p.starts_with(tmp), "path should start with parent");

      io.await(td.remove(using(io)));
    },
    .Err(e) => assert(false, "TempDir.new_in failed")
  );
};

test "TempDir.remove is idempotent", using(io : IO), {
  r := io.await(TempDir.new(using(io)));
  match(r,
    .Ok(td) => {
      io.await(td.remove(using(io)));

      // Second remove should succeed (no-op)
      rm2 := io.await(td.remove(using(io)));
      match(rm2,
        .Ok(_) => printf("  second remove ok\n"),
        .Err(e) => assert(false, "second remove should succeed")
      );
    },
    .Err(e) => assert(false, "TempDir.new failed")
  );
};

// ============================================================================
// TempFile
// ============================================================================

test "TempFile.new creates a file", using(io : IO), {
  r := io.await(TempFile.new(using(io)));
  match(r,
    .Ok(tf) => {
      p := tf.path().to_string();
      printf("  temp file path = %s\n", p.to_cstr().ptr().unwrap());
      assert((p.len() > usize(0)), "path should not be empty");

      // Verify it exists
      ex := io.await(fs_file.exists(tf.path(), using(io)));
      match(ex,
        .Ok(e) => assert(e, "temp file should exist"),
        .Err(e) => assert(false, "exists check failed")
      );

      // Remove
      rm := io.await(tf.remove(using(io)));
      match(rm,
        .Ok(_) => printf("  removed ok\n"),
        .Err(e) => assert(false, "TempFile.remove failed")
      );

      // Verify removed
      ex2 := io.await(fs_file.exists(tf.path(), using(io)));
      match(ex2,
        .Ok(e) => assert((!(e)), "temp file should not exist after remove"),
        .Err(e) => assert(false, "exists check failed")
      );
    },
    .Err(e) => assert(false, "TempFile.new failed")
  );
};

test "TempFile.new_in creates in specified parent", using(io : IO), {
  tmp := temp_dir();
  parent := Path.new(tmp);

  r := io.await(TempFile.new_in(parent, using(io)));
  match(r,
    .Ok(tf) => {
      p := tf.path().to_string();
      printf("  temp file path = %s\n", p.to_cstr().ptr().unwrap());

      // Path should start with parent
      assert(p.starts_with(tmp), "path should start with parent");

      io.await(tf.remove(using(io)));
    },
    .Err(e) => assert(false, "TempFile.new_in failed")
  );
};

test "TempFile.file returns usable File", using(io : IO), {
  r := io.await(TempFile.new(using(io)));
  match(r,
    .Ok(tf) => {
      f := tf.file();

      // Write to the file
      wr := io.await(f.write(`temp file content`, using(io)));
      match(wr,
        .Ok(n) => printf("  wrote %d bytes\n", n),
        .Err(e) => assert(false, "write to temp file failed")
      );

      // Read it back using the path
      content := io.await(fs_file.read_to_string(tf.path(), using(io)));
      match(content,
        .Ok(s) => {
          printf("  read: %s\n", s.to_cstr().ptr().unwrap());
          assert((s == `temp file content`), "temp file content mismatch");
        },
        .Err(e) => assert(false, "read temp file failed")
      );

      io.await(tf.remove(using(io)));
    },
    .Err(e) => assert(false, "TempFile.new failed")
  );
};

test "TempFile.remove is idempotent", using(io : IO), {
  r := io.await(TempFile.new(using(io)));
  match(r,
    .Ok(tf) => {
      io.await(tf.remove(using(io)));

      // Second remove should succeed (no-op)
      rm2 := io.await(tf.remove(using(io)));
      match(rm2,
        .Ok(_) => printf("  second remove ok\n"),
        .Err(e) => assert(false, "second remove should succeed")
      );
    },
    .Err(e) => assert(false, "TempFile.new failed")
  );
};
