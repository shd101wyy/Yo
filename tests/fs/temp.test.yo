pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ Path } :: import("std/path");
{ IoError } :: import("std/sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
{ TempDir, TempFile } :: import("std/fs/temp");
fs_file :: import("std/fs/file");
{ File } :: import("std/fs/file");
fs_dir :: import("std/fs/dir");
{ temp_dir, path_join } :: import("../helper");
// ============================================================================
// TempDir
// ============================================================================
test("TempDir.new creates a directory", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  td := io.await(TempDir.new(io), IoExn(io : io, exn : exn));
  p := td.path().to_string();
  unsafe(printf("  temp dir path = %s\n", p.to_cstr().ptr().unwrap()));
  assert(p.len() > usize(0), "path should not be empty");
  // Verify it exists
  e := io.await(fs_file.exists(td.path(), io), io);
  assert(e, "temp dir should exist");
  // Remove
  io.await(td.remove(io), IoExn(io : io, exn : exn));
  unsafe(printf("  removed ok\n"));
  // Verify removed
  e2 := io.await(fs_file.exists(td.path(), io), io);
  assert(!(e2), "temp dir should not exist after remove");
});
test("TempDir.new_in creates in specified parent", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  parent := Path.new(tmp);
  td := io.await(TempDir.new_in(parent, io), IoExn(io : io, exn : exn));
  p := td.path().to_string();
  unsafe(printf("  temp dir path = %s\n", p.to_cstr().ptr().unwrap()));
  // Path should start with parent (use Path.starts_with for cross-platform segment comparison)
  assert(td.path().starts_with(parent), "path should start with parent");
  io.await(td.remove(io), IoExn(io : io, exn : exn));
});
test("TempDir.remove is idempotent", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  td := io.await(TempDir.new(io), IoExn(io : io, exn : exn));
  io.await(td.remove(io), IoExn(io : io, exn : exn));
  // Second remove should succeed (no-op)
  io.await(td.remove(io), IoExn(io : io, exn : exn));
  unsafe(printf("  second remove ok\n"));
});
// ============================================================================
// TempFile
// ============================================================================
test("TempFile.new creates a file", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tf := io.await(TempFile.new(io), IoExn(io : io, exn : exn));
  p := tf.path().to_string();
  unsafe(printf("  temp file path = %s\n", p.to_cstr().ptr().unwrap()));
  assert(p.len() > usize(0), "path should not be empty");
  // Verify it exists
  e := io.await(fs_file.exists(tf.path(), io), io);
  assert(e, "temp file should exist");
  // Remove
  io.await(tf.remove(io), IoExn(io : io, exn : exn));
  unsafe(printf("  removed ok\n"));
  // Verify removed
  e2 := io.await(fs_file.exists(tf.path(), io), io);
  assert(!(e2), "temp file should not exist after remove");
});
test("TempFile.new_in creates in specified parent", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  parent := Path.new(tmp);
  tf := io.await(TempFile.new_in(parent, io), IoExn(io : io, exn : exn));
  p := tf.path().to_string();
  unsafe(printf("  temp file path = %s\n", p.to_cstr().ptr().unwrap()));
  // Path should start with parent (use Path.starts_with for cross-platform segment comparison)
  assert(tf.path().starts_with(parent), "path should start with parent");
  io.await(tf.remove(io), IoExn(io : io, exn : exn));
});
test("TempFile.file returns usable File", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tf := io.await(TempFile.new(io), IoExn(io : io, exn : exn));
  f := tf.file();
  // Write to the file
  n := io.await(f.write_string(`temp file content`, io), IoExn(io : io, exn : exn));
  unsafe(printf("  wrote %d bytes\n", n));
  // Read it back using the path
  s := io.await(fs_file.read_string(tf.path(), io), IoExn(io : io, exn : exn));
  unsafe(printf("  read: %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `temp file content`, "temp file content mismatch");
  io.await(tf.remove(io), IoExn(io : io, exn : exn));
});
test("TempFile.remove is idempotent", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tf := io.await(TempFile.new(io), IoExn(io : io, exn : exn));
  io.await(tf.remove(io), IoExn(io : io, exn : exn));
  // Second remove should succeed (no-op)
  io.await(tf.remove(io), IoExn(io : io, exn : exn));
  unsafe(printf("  second remove ok\n"));
});
