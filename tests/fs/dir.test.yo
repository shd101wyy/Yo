open import "std/libc/stdio";
open import "std/string";
{ Path } :: import "std/path";
{ IOError } :: import "std/sys/errors";
{ Error, AnyError, Exception } :: import "std/error";
fs_dir :: import "std/fs/dir";
{ FileType, DirEntry } :: import "std/fs/dir";
fs_file :: import "std/fs/file";
{ temp_dir, path_join } :: import "../helper";

// ============================================================================
// create_dir / remove_dir
// ============================================================================

test "create_dir and remove_dir", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_dir_create`));

  // Cleanup any leftover
  cond(io.await(fs_file.exists(dpath, using(io))) => {
    io.await(fs_dir.remove_dir(dpath, using(io, exn)));
  }, true => ());

  io.await(fs_dir.create_dir(dpath, using(io, exn)));
  printf("  create_dir ok\n");

  // Verify it exists
  e := io.await(fs_file.exists(dpath, using(io)));
  assert(e, "dir should exist after create");

  // Remove
  io.await(fs_dir.remove_dir(dpath, using(io, exn)));
  printf("  remove_dir ok\n");
};

test "create_dir_str", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_dir_str`));

  cond(io.await(fs_file.exists(dpath, using(io))) => {
    io.await(fs_dir.remove_dir(dpath, using(io, exn)));
  }, true => ());

  io.await(fs_dir.create_dir(dpath, using(io, exn)));
  printf("  create_dir_str ok\n");

  io.await(fs_dir.remove_dir(dpath, using(io, exn)));
};

test "create_dir on existing returns error", using(io : IO), {
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_dir_exists`));

  // Setup: create the directory
  given(setup_exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception during setup");
    escape ();
  }));

  cond(io.await(fs_file.exists(dpath, using(io))) => {
    io.await(fs_dir.remove_dir(dpath, using(io, setup_exn)));
  }, true => ());
  io.await(fs_dir.create_dir(dpath, using(io, setup_exn)));

  // Second create should fail
  given(exn) := Exception(throw : ((err) -> {
    printf("  got expected error\n");
    escape ();
  }));
  io.await(fs_dir.create_dir(dpath, using(io, exn)));
  assert(false, "create_dir on existing should fail");
};

// ============================================================================
// create_dir_all
// ============================================================================

test "create_dir_all creates nested directories", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  nested := Path.new(path_join(path_join(path_join(tmp, `yo_fs_dir_all`), `sub1`), `sub2`));

  io.await(fs_dir.create_dir_all(nested, using(io, exn)));
  printf("  create_dir_all ok\n");

  // Verify exists
  e := io.await(fs_file.exists(nested, using(io)));
  assert(e, "nested dir should exist");

  // Cleanup nested dirs
  io.await(fs_dir.remove_dir(nested, using(io, exn)));
  io.await(fs_dir.remove_dir(Path.new(path_join(path_join(tmp, `yo_fs_dir_all`), `sub1`)), using(io, exn)));
  io.await(fs_dir.remove_dir(Path.new(path_join(tmp, `yo_fs_dir_all`)), using(io, exn)));
};

test "create_dir_all on existing directory succeeds", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_dir_all_exists`));

  cond(io.await(fs_file.exists(dpath, using(io))) => {
    io.await(fs_dir.remove_dir(dpath, using(io, exn)));
  }, true => ());
  io.await(fs_dir.create_dir_all(dpath, using(io, exn)));

  // Calling again should not error
  io.await(fs_dir.create_dir_all(dpath, using(io, exn)));
  printf("  create_dir_all on existing ok\n");

  io.await(fs_dir.remove_dir(dpath, using(io, exn)));
};

// ============================================================================
// remove_file
// ============================================================================

test "remove_file removes a file", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_dir_rm_file.txt`));

  io.await(fs_file.write_file(fpath, "to remove", using(io, exn)));

  io.await(fs_dir.remove_file(fpath, using(io, exn)));
  printf("  remove_file ok\n");

  // Verify gone
  e := io.await(fs_file.exists(fpath, using(io)));
  assert((!(e)), "file should not exist after remove");
};

test "remove_file nonexistent returns error", using(io : IO), {
  fpath := Path.new(`/nonexistent/yo_fs_rm_nope.txt`);

  given(exn) := Exception(throw : ((err) -> {
    printf("  got expected error\n");
    escape ();
  }));
  io.await(fs_dir.remove_file(fpath, using(io, exn)));
  assert(false, "remove nonexistent should fail");
};

// ============================================================================
// rename
// ============================================================================

test "rename moves a file", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  old_path := Path.new(path_join(tmp, `yo_fs_rename_old.txt`));
  new_path := Path.new(path_join(tmp, `yo_fs_rename_new.txt`));

  cond(io.await(fs_file.exists(new_path, using(io))) => {
    io.await(fs_dir.remove_file(new_path, using(io, exn)));
  }, true => ());
  io.await(fs_file.write_file(old_path, "rename me", using(io, exn)));

  io.await(fs_dir.rename(old_path, new_path, using(io, exn)));
  printf("  rename ok\n");

  // Old should not exist
  old_ex := io.await(fs_file.exists(old_path, using(io)));
  assert((!(old_ex)), "old path should not exist");

  // New should exist with correct content
  s := io.await(fs_file.read_string(new_path, using(io, exn)));
  assert((s == `rename me`), "renamed content mismatch");

  io.await(fs_dir.remove_file(new_path, using(io, exn)));
};

// ============================================================================
// hard_link
// ============================================================================

test "hard_link creates a link", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  src := Path.new(path_join(tmp, `yo_fs_link_src.txt`));
  dst := Path.new(path_join(tmp, `yo_fs_link_dst.txt`));

  cond(io.await(fs_file.exists(dst, using(io))) => {
    io.await(fs_dir.remove_file(dst, using(io, exn)));
  }, true => ());
  io.await(fs_file.write_file(src, "link data", using(io, exn)));

  io.await(fs_dir.hard_link(src, dst, using(io, exn)));
  printf("  hard_link ok\n");

  // Read via link
  s := io.await(fs_file.read_string(dst, using(io, exn)));
  assert((s == `link data`), "link content mismatch");

  io.await(fs_dir.remove_file(src, using(io, exn)));
  io.await(fs_dir.remove_file(dst, using(io, exn)));
};

// ============================================================================
// symlink
// ============================================================================

test "symlink creates a symbolic link", using(io : IO), {
  tmp := temp_dir();
  src := Path.new(path_join(tmp, `yo_fs_symlink_src.txt`));
  lnk := Path.new(path_join(tmp, `yo_fs_symlink_lnk.txt`));

  given(setup_exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception during setup");
    escape ();
  }));

  cond(io.await(fs_file.exists(lnk, using(io))) => {
    io.await(fs_dir.remove_file(lnk, using(io, setup_exn)));
  }, true => ());
  cond(io.await(fs_file.exists(src, using(io))) => {
    io.await(fs_dir.remove_file(src, using(io, setup_exn)));
  }, true => ());
  io.await(fs_file.write_file(src, "symlink data", using(io, setup_exn)));

  // Symlink may fail with PermissionDenied on Windows
  given(sym_exn) := Exception(throw : ((err) -> {
    match(downcast(err, IOError),
      .Some(io_err) => match(io_err,
        .PermissionDenied => {
          printf("  SKIP: symlinks require admin or Developer Mode on Windows\n");
        },
        _ => {
          assert(false, "symlink failed");
        }
      ),
      .None => {
        assert(false, "unexpected error type");
      }
    );
    escape ();
  }));
  io.await(fs_dir.symlink(src, lnk, using(io, sym_exn)));
  printf("  symlink ok\n");

  // Read via symlink
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));
  s := io.await(fs_file.read_string(lnk, using(io, exn)));
  assert((s == `symlink data`), "symlink content mismatch");

  io.await(fs_dir.remove_file(lnk, using(io, exn)));
  io.await(fs_dir.remove_file(src, using(io, exn)));
};

// ============================================================================
// read_dir
// ============================================================================

test "read_dir lists directory entries", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_read_dir`));

  io.await(fs_dir.create_dir_all(dpath, using(io, exn)));

  // Create some files inside
  io.await(fs_file.write_file(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `a.txt`)), "a", using(io, exn)));
  io.await(fs_file.write_file(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `b.txt`)), "b", using(io, exn)));

  // Create a subdirectory
  io.await(fs_dir.create_dir(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `subdir`)), using(io, exn)));

  entries := io.await(fs_dir.read_dir(dpath, using(io, exn)));
  printf("  entries count = %lld\n", i64(entries.len()));
  assert((entries.len() == usize(3)), "expected 3 entries");

  // Check that we find the expected names
  found_a := false;
  found_b := false;
  found_sub := false;
  i := usize(0);
  while runtime((i < entries.len())), {
    entry := entries.get(i).unwrap();
    printf("  entry: %s\n", entry.name.to_cstr().ptr().unwrap());
    cond(
      (entry.name == `a.txt`) => {
        found_a = true;
        assert(match(entry.file_type, .File => true, _ => false), "a.txt should be File");
      },
      (entry.name == `b.txt`) => {
        found_b = true;
        assert(match(entry.file_type, .File => true, _ => false), "b.txt should be File");
      },
      (entry.name == `subdir`) => {
        found_sub = true;
        assert(match(entry.file_type, .Directory => true, _ => false), "subdir should be Directory");
      },
      true => ()
    );
    i = (i + usize(1));
  };
  assert(found_a, "should find a.txt");
  assert(found_b, "should find b.txt");
  assert(found_sub, "should find subdir");

  // Cleanup
  io.await(fs_dir.remove_file(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `a.txt`)), using(io, exn)));
  io.await(fs_dir.remove_file(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `b.txt`)), using(io, exn)));
  io.await(fs_dir.remove_dir(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `subdir`)), using(io, exn)));
  io.await(fs_dir.remove_dir(dpath, using(io, exn)));
};

test "read_dir on nonexistent returns error", using(io : IO), {
  dpath := Path.new(`/nonexistent/yo_fs_read_dir_nope`);

  given(exn) := Exception(throw : ((err) -> {
    printf("  got expected error\n");
    escape ();
  }));
  io.await(fs_dir.read_dir(dpath, using(io, exn)));
  assert(false, "read_dir nonexistent should fail");
};
