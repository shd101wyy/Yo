test("create_dir on existing returns error", {
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_dir_exists`));
  // Setup: create the directory
  setup_exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception during setup");
        unwind(());
      }
    )
  );
  cond(
    io.await(fs_file.exists(dpath, io), io) => {
      io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : setup_exn));
    },
    true => ()
  );
  io.await(fs_dir.create_dir(dpath, io), IoExn(io : io, exn : setup_exn));
  // Second create should fail
  exn := Exception(
    throw : (
      (err) -> {
        unsafe(printf("  got expected error\n"));
        unwind(());
      }
    )
  );
  io.await(fs_dir.create_dir(dpath, io), IoExn(io : io, exn : exn));
  assert(false, "create_dir on existing should fail");
});
// ============================================================================
// create_dir_all
// ============================================================================
test("create_dir_all creates nested directories", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  nested := Path.new(path_join(path_join(path_join(tmp, `yo_fs_dir_all`), `sub1`), `sub2`));
  io.await(fs_dir.create_dir_all(nested, io), IoExn(io : io, exn : exn));
  unsafe(printf("  create_dir_all ok\n"));
  // Verify exists
  e := io.await(fs_file.exists(nested, io), io);
  assert(e, "nested dir should exist");
  // Cleanup nested dirs
  io.await(fs_dir.remove_dir(nested, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(Path.new(path_join(path_join(tmp, `yo_fs_dir_all`), `sub1`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(Path.new(path_join(tmp, `yo_fs_dir_all`)), io), IoExn(io : io, exn : exn));
});
test("create_dir_all on existing directory succeeds", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_dir_all_exists`));
  cond(
    io.await(fs_file.exists(dpath, io), io) => {
      io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : exn));
    },
    true => ()
  );
  io.await(fs_dir.create_dir_all(dpath, io), IoExn(io : io, exn : exn));
  // Calling again should not error
  io.await(fs_dir.create_dir_all(dpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  create_dir_all on existing ok\n"));
  io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// remove_file
// ============================================================================
test("remove_file removes a file", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_dir_rm_file.txt`));
  io.await(fs_file.write_file(fpath, String.from("to remove"), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  remove_file ok\n"));
  // Verify gone
  e := io.await(fs_file.exists(fpath, io), io);
  assert(!(e), "file should not exist after remove");
});
test("remove_file nonexistent returns error", {
  fpath := Path.new(`/nonexistent/yo_fs_rm_nope.txt`);
  exn := Exception(
    throw : (
      (err) -> {
        unsafe(printf("  got expected error\n"));
        unwind(());
      }
    )
  );
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
  assert(false, "remove nonexistent should fail");
});
// ============================================================================
// rename
// ============================================================================
test("rename moves a file", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  old_path := Path.new(path_join(tmp, `yo_fs_rename_old.txt`));
  new_path := Path.new(path_join(tmp, `yo_fs_rename_new.txt`));
  cond(
    io.await(fs_file.exists(new_path, io), io) => {
      io.await(fs_dir.remove_file(new_path, io), IoExn(io : io, exn : exn));
    },
    true => ()
  );
  io.await(fs_file.write_file(old_path, String.from("rename me"), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.rename(old_path, new_path, io), IoExn(io : io, exn : exn));
  unsafe(printf("  rename ok\n"));
  // Old should not exist
  old_ex := io.await(fs_file.exists(old_path, io), io);
  assert(!(old_ex), "old path should not exist");
  // New should exist with correct content
  s := io.await(fs_file.read_string(new_path, io), IoExn(io : io, exn : exn));
  assert(s == `rename me`, "renamed content mismatch");
  io.await(fs_dir.remove_file(new_path, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// hard_link
// ============================================================================
test("hard_link creates a link", {
  // WASM NODERAWFS does not support hard links (link() returns EMLINK)
  if(arch == Arch.Wasm32, {
    unsafe(printf("  skipped on wasm32\n"));
    return(());
  });
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  src := Path.new(path_join(tmp, `yo_fs_link_src.txt`));
  dst := Path.new(path_join(tmp, `yo_fs_link_dst.txt`));
  cond(
    io.await(fs_file.exists(dst, io), io) => {
      io.await(fs_dir.remove_file(dst, io), IoExn(io : io, exn : exn));
    },
    true => ()
  );
  io.await(fs_file.write_file(src, String.from("link data"), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.hard_link(src, dst, io), IoExn(io : io, exn : exn));
  unsafe(printf("  hard_link ok\n"));
  // Read via link
  s := io.await(fs_file.read_string(dst, io), IoExn(io : io, exn : exn));
  assert(s == `link data`, "link content mismatch");
  io.await(fs_dir.remove_file(src, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(dst, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// symlink
// ============================================================================
test("symlink creates a symbolic link", {
  tmp := temp_dir();
  src := Path.new(path_join(tmp, `yo_fs_symlink_src.txt`));
  lnk := Path.new(path_join(tmp, `yo_fs_symlink_lnk.txt`));
  setup_exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception during setup");
        unwind(());
      }
    )
  );
  cond(
    io.await(fs_file.exists(lnk, io), io) => {
      io.await(fs_dir.remove_file(lnk, io), IoExn(io : io, exn : setup_exn));
    },
    true => ()
  );
  cond(
    io.await(fs_file.exists(src, io), io) => {
      io.await(fs_dir.remove_file(src, io), IoExn(io : io, exn : setup_exn));
    },
    true => ()
  );
  io.await(fs_file.write_file(src, String.from("symlink data"), io), IoExn(io : io, exn : setup_exn));
  // Symlink may fail with PermissionDenied on Windows
  sym_exn := Exception(
    throw : (
      (err) -> {
        match(
          downcast(err, IoError),
          .Some(io_err) => match(
            io_err,
            .PermissionDenied => {
              unsafe(printf("  SKIP: symlinks require admin or Developer Mode on Windows\n"));
            },
            _ => {
              assert(false, "symlink failed");
            }
          ),
          .None => {
            assert(false, "unexpected error type");
          }
        );
        unwind(());
      }
    )
  );
  io.await(fs_dir.symlink(src, lnk, io), IoExn(io : io, exn : sym_exn));
  unsafe(printf("  symlink ok\n"));
  // Read via symlink
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  s := io.await(fs_file.read_string(lnk, io), IoExn(io : io, exn : exn));
  assert(s == `symlink data`, "symlink content mismatch");
  io.await(fs_dir.remove_file(lnk, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(src, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// read_dir
// ============================================================================
test("read_dir lists directory entries", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_read_dir`));
  io.await(fs_dir.create_dir_all(dpath, io), IoExn(io : io, exn : exn));
  // Create some files inside
  io.await(fs_file.write_file(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `a.txt`)), String.from("a"), io), IoExn(io : io, exn : exn));
  io.await(fs_file.write_file(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `b.txt`)), String.from("b"), io), IoExn(io : io, exn : exn));
  // Create a subdirectory
  io.await(fs_dir.create_dir(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `subdir`)), io), IoExn(io : io, exn : exn));
  entries := io.await(fs_dir.read_dir(dpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  entries count = %lld\n", i64(entries.len())));
  assert(entries.len() == usize(3), "expected 3 entries");
  // Check that we find the expected names
  found_a := false;
  found_b := false;
  found_sub := false;
  i := usize(0);
  while(runtime(i < entries.len()), {
    entry := entries(i);
    unsafe(printf("  entry: %s\n", entry.name.to_cstr().ptr().unwrap()));
    cond(
      (entry.name == `a.txt`) => {
        found_a = true;
        assert(match(entry.file_type, .File => true, _ => false), "a.txt should be File");
      },
      (entry.name == `b.txt`) => {
        found_b = true;
        assert(match(entry.file_type, .File => true, _ => false), "b.txt should be File");
      },
      (entry.name == `subdir`) => {
        found_sub = true;
        assert(match(entry.file_type, .Directory => true, _ => false), "subdir should be Directory");
      },
      true => ()
    );
    i = (i + usize(1));
  });
  assert(found_a, "should find a.txt");
  assert(found_b, "should find b.txt");
  assert(found_sub, "should find subdir");
  // Cleanup
  io.await(fs_dir.remove_file(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `a.txt`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `b.txt`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(Path.new(path_join(path_join(tmp, `yo_fs_read_dir`), `subdir`)), io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : exn));
});
test("read_dir on nonexistent returns error", {
  dpath := Path.new(`/nonexistent/yo_fs_read_dir_nope`);
  exn := Exception(
    throw : (
      (err) -> {
        unsafe(printf("  got expected error\n"));
        unwind(());
      }
    )
  );
  io.await(fs_dir.read_dir(dpath, io), IoExn(io : io, exn : exn));
  assert(false, "read_dir nonexistent should fail");
});
