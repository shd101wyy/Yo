pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ Path } :: import("std/path");
{ arch, Arch } :: import("std/process");
{ IoError } :: import("std/sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
fs_dir :: import("std/fs/dir");
{ FileType, DirEntry } :: import("std/fs/dir");
fs_file :: import("std/fs/file");
{ temp_dir, path_join } :: import("../helper");
// ============================================================================
// create_dir / remove_dir
// ============================================================================
test("create_dir and remove_dir", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_dir_create`));
  // Cleanup any leftover
  cond(
    io.await(fs_file.exists(dpath, io), io) => {
      io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : exn));
    },
    true => ()
  );
  io.await(fs_dir.create_dir(dpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  create_dir ok\n"));
  // Verify it exists
  e := io.await(fs_file.exists(dpath, io), io);
  assert(e, "dir should exist after create");
  // Remove
  io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  remove_dir ok\n"));
});
