pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio");
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ Path } :: import("std/path");
{ IoError } :: import("std/sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
fs_file :: import("std/fs/file");
{ File, OpenMode } :: import("std/fs/file");
fs_dir :: import("std/fs/dir");
fs_walker :: import("std/fs/walker");
fs_metadata :: import("std/fs/metadata");
{ temp_dir, path_join } :: import("../helper");
{ platform, Platform } :: import("std/process");
{ Command } :: import("std/process/command");
// Probe wrappers: the expected-throw tests await through a SEPARATE handler,
// and a top-level await's IoExn arm needs a fn boundary for unwind to land in.
read_link_probe :: (fn(imm(p) : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    _t := e.io.await(fs_dir.read_link(p, e.io), e);
    ()
  })
);
try_exists_probe :: (fn(imm(p) : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    _t := e.io.await(fs_file.try_exists(p, e.io), e);
    ()
  })
);
// Windows link tests use JUNCTIONS: creating a symlink needs
// SeCreateSymbolicLinkPrivilege there, but `cmd /c mklink /J` creates a
// mount-point reparse point with no privilege at all. mklink parses a
// forward slash as a switch, so paths are converted to backslashes first;
// read_link returns exactly the path mklink stored (issues/fixed/
// s3-fs-wrappers-windows-semantics-audit.md).
_winpath :: (fn(imm(p) : Path) -> String)(
  p.to_string().replace(String.from("/"), String.from("\\"))
);
_make_junction :: (fn(imm(link) : Path, imm(target) : Path, io : Io) -> bool)({
  exn := Exception(
    throw : (
      err -> {
        assert(false, `cmd spawn failed: ${err}`);
        unwind(false);
      }
    )
  );
  cmd := Command.new(`cmd`);
  cmd.arg(`/c`);
  cmd.arg(`mklink`);
  cmd.arg(`/J`);
  cmd.arg(_winpath(link));
  cmd.arg(_winpath(target));
  st := io.await(cmd.status(io), IoExn(io : io, exn : exn));
  st.success()
});
// Best-effort stale removal, so a failed previous run's leftovers (a
// junction, its target dir) cannot fail the NEXT one at create_dir/mklink.
_remove_stale_dir :: (fn(imm(p) : Path, io : Io) -> unit)({
  quiet := Exception(throw : (_err -> unwind(())));
  io.await(fs_dir.remove_dir(p, io), IoExn(io : io, exn : quiet));
});
// ============================================================================
// is_file tests
// ============================================================================
test("is_file returns true for a regular file", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_conv_is_file.txt`));
  io.await(fs_file.write_string(fpath, String.from("hello"), io), IoExn(io : io, exn : exn));
  r := io.await(fs_file.is_file(fpath, io), io);
  unsafe(printf("  is_file = %d\n", cond(r => i32(1), true => i32(0))));
  assert(r, "should be a file");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("is_file returns false for a directory", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_conv_is_file_dir`));
  io.await(fs_dir.create_dir(dpath, io), IoExn(io : io, exn : exn));
  r := io.await(fs_file.is_file(dpath, io), io);
  unsafe(printf("  is_file on dir = %d\n", cond(r => i32(1), true => i32(0))));
  assert(!r, "directory should not be a file");
  io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : exn));
});
test("is_file returns false for nonexistent path", {
  fpath := Path.new(`/nonexistent/yo_fs_conv_no_such_file.txt`);
  r := io.await(fs_file.is_file(fpath, io), io);
  unsafe(printf("  is_file nonexistent = %d\n", cond(r => i32(1), true => i32(0))));
  assert(!r, "nonexistent path should return false");
});
