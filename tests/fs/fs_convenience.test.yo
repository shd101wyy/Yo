// ============================================================================
// canonical tests
// ============================================================================
test("canonical resolves a real path", {
  exn := Exception(
    throw : (
      err -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_conv_canonical.txt`));
  io.await(fs_file.write_string(fpath, String.from("canonical"), io), IoExn(io : io, exn : exn));
  resolved := io.await(fs_file.canonicalize(fpath, io), IoExn(io : io, exn : exn));
  resolved_str := resolved.to_string();
  unsafe(printf("  canonical = %s\n", resolved_str.to_cstr().ptr().unwrap()));
  assert(resolved.is_absolute(), "canonical path should be absolute");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("canonical resolves dot-dot segments", {
  exn := Exception(
    throw : (
      err -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  dir_path := Path.new(path_join(tmp, `yo_fs_conv_canonical_dir`));
  sub_path := Path.new(path_join(path_join(tmp, `yo_fs_conv_canonical_dir`), `sub`));
  file_path := Path.new(path_join(tmp, `yo_fs_conv_canonical_dir/target.txt`));
  io.await(fs_dir.create_dir(dir_path, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.create_dir(sub_path, io), IoExn(io : io, exn : exn));
  io.await(fs_file.write_string(file_path, String.from("data"), io), IoExn(io : io, exn : exn));
  // Path with .. segment: dir/sub/../target.txt should resolve to dir/target.txt
  dotdot_path := Path.new(path_join(path_join(path_join(tmp, `yo_fs_conv_canonical_dir`), `sub`), `../target.txt`));
  resolved := io.await(fs_file.canonicalize(dotdot_path, io), IoExn(io : io, exn : exn));
  direct := io.await(fs_file.canonicalize(file_path, io), IoExn(io : io, exn : exn));
  resolved_str := resolved.to_string();
  direct_str := direct.to_string();
  unsafe(printf("  dotdot resolved = %s\n", resolved_str.to_cstr().ptr().unwrap()));
  unsafe(printf("  direct resolved  = %s\n", direct_str.to_cstr().ptr().unwrap()));
  assert(resolved_str == direct_str, "dot-dot path should resolve to same as direct");
  io.await(fs_dir.remove_file(file_path, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(sub_path, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(dir_path, io), IoExn(io : io, exn : exn));
});
test("canonical throws for nonexistent path", {
  fpath := Path.new(`/nonexistent/yo_fs_conv_canonical_missing`);
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("  got expected error\n"));
        unwind(());
      }
    )
  );
  io.await(fs_file.canonicalize(fpath, io), IoExn(io : io, exn : exn));
  assert(false, "should have thrown");
});

// ============================================================================
// S3 P0 wrappers: copy / remove_dir_all / read_link / set_permissions /
// try_exists (plans/archive/STD_API_AUDIT.md §7 P0 item 4). Per-platform:
// contents/count/link-target/EINVAL/present/absent run everywhere; mode-bit
// round-trips, symlink-as-link removal and denied-parent throws are
// POSIX-only semantics (issues/fixed/s3-fs-wrappers-windows-semantics-audit.md).
// ============================================================================
test("copy copies contents, permission bits and returns the byte count", {
  // Contents and byte count are asserted on EVERY platform (the 2026-08-27
  // Windows child crash in this path went away with the async-runtime race
  // fixes since). The permission-bit round-trip is POSIX-only: Windows'
  // _wchmod keeps just the read-only bit, so a copied mode reads back 0o666,
  // never 0o600 (issues/fixed/s3-fs-wrappers-windows-semantics-audit.md).
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  base := temp_dir();
  src_p := Path.new(path_join(base.clone(), `s3_copy_src.txt`.to_string()));
  dst_p := Path.new(path_join(base.clone(), `s3_copy_dst.txt`.to_string()));
  io.await(fs_file.write_string(src_p, `copy me, préserve me`.to_string(), io), e);
  io.await(fs_file.set_permissions(src_p, fs_file.FilePermission(mode : u32(384)), io), e);
  n := io.await(fs_file.copy(src_p, dst_p, io), e);
  assert(n == u64(21), "byte count (multibyte é = 2 bytes)");
  got := io.await(fs_file.read_to_string(dst_p, io), e);
  assert(got == `copy me, préserve me`, "contents copied");
  if(platform != Platform.Windows, {
    md := io.await(fs_metadata.metadata(dst_p, io), e);
    assert((md.mode() & u32(4095)) == u32(384), "0o600 permission bits copied");
  });
  io.await(fs_dir.remove_file(src_p, io), e);
  io.await(fs_dir.remove_file(dst_p, io), e);
});
test("remove_dir_all removes a nested tree (files, subdirs, symlink as link)", {
  // The plain nested tree is removed on EVERY platform. The symlink-as-link
  // half is POSIX-only: creating a symlink needs SeCreateSymbolicLinkPrivilege
  // on Windows (fs_dir.symlink throws EPERM without it), and a junction there
  // is a directory the walker would follow into the target, so the
  // link-not-target contract is not expressible
  // (issues/fixed/s3-fs-wrappers-windows-semantics-audit.md).
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  base := temp_dir();
  root := Path.new(path_join(base.clone(), `s3_rda_root`.to_string()));
  sub := Path.new(path_join(base.clone(), `s3_rda_root/sub/deeper`.to_string()));
  io.await(fs_dir.create_dir_all(sub, io), e);
  io.await(fs_file.write_string(Path.new(path_join(base.clone(), `s3_rda_root/a.txt`.to_string())), `a`.to_string(), io), e);
  io.await(fs_file.write_string(Path.new(path_join(base.clone(), `s3_rda_root/sub/deeper/b.txt`.to_string())), `b`.to_string(), io), e);
  if(platform != Platform.Windows, {
    // A symlink to a file OUTSIDE the tree: it must be removed as a LINK.
    outside := Path.new(path_join(base.clone(), `s3_rda_outside.txt`.to_string()));
    io.await(fs_file.write_string(outside, `survives`.to_string(), io), e);
    io.await(fs_dir.symlink(outside, Path.new(path_join(base.clone(), `s3_rda_root/sub/link`.to_string())), io), e);
  });
  io.await(fs_walker.remove_dir_all(root, io), e);
  gone := io.await(fs_file.exists(root, io), io);
  assert(gone == false, "tree fully removed");
  if(platform != Platform.Windows, {
    still := io.await(fs_file.exists(Path.new(path_join(base.clone(), `s3_rda_outside.txt`.to_string())), io), io);
    assert(still, "symlink TARGET untouched");
    io.await(fs_dir.remove_file(Path.new(path_join(base.clone(), `s3_rda_outside.txt`.to_string())), io), e);
  });
});
test("read_link returns the link target", {
  // POSIX: a symlink via fs_dir.symlink. Windows: a junction via
  // `cmd /c mklink /J` (a mount-point reparse point — the unprivileged link
  // form); read_link must answer the TARGET the link stores, not the link's
  // own path (issues/fixed/s3-fs-wrappers-windows-semantics-audit.md).
  if(platform == Platform.Windows, {
    exn := Exception(
      throw : (
        err -> {
          assert(false, "unexpected exception");
          unwind(());
        }
      )
    );
    e := IoExn(io : io, exn : exn);
    base := temp_dir();
    target := Path.new(path_join(base.clone(), `s3_rl_target_dir`.to_string()));
    link := Path.new(path_join(base.clone(), `s3_rl_junction`.to_string()));
    _remove_stale_dir(link, io);
    _remove_stale_dir(target, io);
    io.await(fs_dir.create_dir(target, io), e);
    ok := _make_junction(link, target, io);
    assert(ok, "mklink /J created the junction");
    got := io.await(fs_dir.read_link(link, io), e);
    // Path.to_string renders `/`-separated on every platform, and mklink
    // stored the backslash spelling of the SAME target, so the plain
    // comparison (like the POSIX arm below) is the right one.
    assert(got.to_string() == target.to_string(), "junction target read back");
    io.await(fs_dir.remove_dir(link, io), e);
    // Removing a junction removes the LINK, never the target.
    still := io.await(fs_file.exists(target, io), io);
    assert(still, "junction target untouched by remove_dir");
    io.await(fs_dir.remove_dir(target, io), e);
    return(());
  });
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  base := temp_dir();
  target := Path.new(path_join(base.clone(), `s3_rl_target.txt`.to_string()));
  link := Path.new(path_join(base.clone(), `s3_rl_link`.to_string()));
  io.await(fs_file.write_string(target, `t`.to_string(), io), e);
  io.await(fs_dir.symlink(target, link, io), e);
  got := io.await(fs_dir.read_link(link, io), e);
  assert(got.to_string() == target.to_string(), "target read back");
  io.await(fs_dir.remove_file(link, io), e);
  io.await(fs_dir.remove_file(target, io), e);
});
test("read_link on a non-link throws", {
  // Runs on EVERY platform: a regular file is not a reparse point, so
  // FSCTL_GET_REPARSE_POINT reports ERROR_NOT_A_REPARSE_POINT -> EINVAL
  // (Windows), readlink answers EINVAL (POSIX). Before the Windows fix the
  // shim answered the file's own \\?\-prefixed path instead of throwing
  // (issues/fixed/s3-fs-wrappers-windows-semantics-audit.md).
  exn := Exception(
    throw : (
      err -> {
        assert(true, "threw as expected (EINVAL)");
        unwind(());
      }
    )
  );
  base := temp_dir();
  plain := Path.new(path_join(base.clone(), `s3_rl_plain.txt`.to_string()));
  e0 := Exception(
    throw : (
      err0 -> {
        assert(false, "setup failed");
        unwind(());
      }
    )
  );
  io.await(fs_file.write_string(plain, `p`.to_string(), io), IoExn(io : io, exn : e0));
  io.await(read_link_probe(plain, io), IoExn(io : io, exn : exn));
  assert(false, "read_link on a regular file must throw");
});
test("try_exists: true, false for absent, THROWS for a denied parent", {
  // Present/absent run on EVERY platform. The denied-parent arm is inside
  // the POSIX-only block below: a chmod-0 directory does not deny traversal
  // under Windows ACLs, so the contract is not expressible there
  // (issues/fixed/s3-fs-wrappers-windows-semantics-audit.md).
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  base := temp_dir();
  here := Path.new(path_join(base.clone(), `s3_te_here.txt`.to_string()));
  io.await(fs_file.write_string(here, `x`.to_string(), io), e);
  assert(io.await(fs_file.try_exists(here, io), e), "present is true");
  absent := Path.new(path_join(base.clone(), `s3_te_absent.txt`.to_string()));
  assert(io.await(fs_file.try_exists(absent, io), e) == false, "absent is false, not an error");
  io.await(fs_dir.remove_file(here, io), e);
});
test("try_exists THROWS for a denied parent instead of answering false", {
  // POSIX-only: the contract is built on a chmod-0 directory, which Windows
  // ACLs do not express (a mode-0 dir there still allows enumeration, so
  // try_exists correctly answers false rather than throwing)
  // (issues/fixed/s3-fs-wrappers-windows-semantics-audit.md).
  if(platform == Platform.Windows, {
    unsafe(printf("  skipped on windows\n"));
    return(());
  });
  e0 := Exception(
    throw : (
      err0 -> {
        assert(false, "setup failed");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : e0);
  base := temp_dir();
  // 0o000 directory: plain exists() would lie `false`; try_exists throws.
  denied_dir := Path.new(path_join(base.clone(), `s3_te_denied`.to_string()));
  io.await(fs_dir.create_dir(denied_dir, io), e);
  io.await(fs_file.set_permissions(denied_dir, fs_file.FilePermission(mode : u32(0)), io), e);
  child := Path.new(path_join(base.clone(), `s3_te_denied/child.txt`.to_string()));
  exn := Exception(
    throw : (
      err -> {
        assert(true, "threw as expected (EACCES)");
        unwind(());
      }
    )
  );
  io.await(try_exists_probe(child, io), IoExn(io : io, exn : exn));
  // NOTE: reached only if try_exists did NOT throw — restore perms so the
  // temp dir stays removable either way, then fail.
  io.await(fs_file.set_permissions(denied_dir, fs_file.FilePermission(mode : u32(448)), io), e);
  assert(false, "denied parent must throw");
});
test("try_exists denied-dir cleanup", {
  // POSIX-only companion of the test above (the denied dir only exists
  // there) (issues/fixed/s3-fs-wrappers-windows-semantics-audit.md).
  if(platform == Platform.Windows, {
    unsafe(printf("  skipped on windows\n"));
    return(());
  });
  e0 := Exception(
    throw : (
      err0 -> {
        assert(true, "already clean");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : e0);
  base := temp_dir();
  denied_dir := Path.new(path_join(base.clone(), `s3_te_denied`.to_string()));
  io.await(fs_file.set_permissions(denied_dir, fs_file.FilePermission(mode : u32(448)), io), e);
  io.await(fs_dir.remove_dir(denied_dir, io), e);
  assert(true, "cleaned");
});
