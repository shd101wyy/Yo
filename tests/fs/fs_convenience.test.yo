pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
open(import("std/fmt"));
{ Path } :: import("std/path");
{ IoError } :: import("std/sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
fs_file :: import("std/fs/file");
{ File, OpenMode } :: import("std/fs/file");
fs_dir :: import("std/fs/dir");
{ temp_dir, path_join } :: import("../helper");
// ============================================================================
// is_file tests
// ============================================================================
test("is_file returns true for a regular file", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_conv_is_file.txt`));
  io.await(fs_file.write_file(fpath, String.from("hello"), io), IoExn(io : io, exn : exn));
  r := io.await(fs_file.is_file(fpath, io), io);
  unsafe(printf("  is_file = %d\n", cond(r => i32(1), true => i32(0))));
  assert(r, "should be a file");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("is_file returns false for a directory", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_conv_is_file_dir`));
  io.await(fs_dir.create_dir(dpath, io), IoExn(io : io, exn : exn));
  r := io.await(fs_file.is_file(dpath, io), io);
  unsafe(printf("  is_file on dir = %d\n", cond(r => i32(1), true => i32(0))));
  assert(!(r), "directory should not be a file");
  io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : exn));
});
test("is_file returns false for nonexistent path", {
  fpath := Path.new(`/nonexistent/yo_fs_conv_no_such_file.txt`);
  r := io.await(fs_file.is_file(fpath, io), io);
  unsafe(printf("  is_file nonexistent = %d\n", cond(r => i32(1), true => i32(0))));
  assert(!(r), "nonexistent path should return false");
});
// ============================================================================
// is_dir tests
// ============================================================================
test("is_dir returns true for a directory", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_conv_is_dir`));
  io.await(fs_dir.create_dir(dpath, io), IoExn(io : io, exn : exn));
  r := io.await(fs_file.is_dir(dpath, io), io);
  unsafe(printf("  is_dir = %d\n", cond(r => i32(1), true => i32(0))));
  assert(r, "should be a directory");
  io.await(fs_dir.remove_dir(dpath, io), IoExn(io : io, exn : exn));
});
test("is_dir returns false for a file", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_conv_is_dir_file.txt`));
  io.await(fs_file.write_file(fpath, String.from("test"), io), IoExn(io : io, exn : exn));
  r := io.await(fs_file.is_dir(fpath, io), io);
  unsafe(printf("  is_dir on file = %d\n", cond(r => i32(1), true => i32(0))));
  assert(!(r), "file should not be a directory");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("is_dir returns false for nonexistent path", {
  dpath := Path.new(`/nonexistent/yo_fs_conv_no_such_dir`);
  r := io.await(fs_file.is_dir(dpath, io), io);
  unsafe(printf("  is_dir nonexistent = %d\n", cond(r => i32(1), true => i32(0))));
  assert(!(r), "nonexistent path should return false");
});
// ============================================================================
// canonical tests
// ============================================================================
test("canonical resolves a real path", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_conv_canonical.txt`));
  io.await(fs_file.write_file(fpath, String.from("canonical"), io), IoExn(io : io, exn : exn));
  resolved := io.await(fs_file.canonical(fpath, io), IoExn(io : io, exn : exn));
  resolved_str := resolved.to_string();
  unsafe(printf("  canonical = %s\n", resolved_str.to_cstr().ptr().unwrap()));
  assert(resolved.is_absolute(), "canonical path should be absolute");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("canonical resolves dot-dot segments", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  dir_path := Path.new(path_join(tmp, `yo_fs_conv_canonical_dir`));
  sub_path := Path.new(path_join(path_join(tmp, `yo_fs_conv_canonical_dir`), `sub`));
  file_path := Path.new(path_join(tmp, `yo_fs_conv_canonical_dir/target.txt`));
  io.await(fs_dir.create_dir(dir_path, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.create_dir(sub_path, io), IoExn(io : io, exn : exn));
  io.await(fs_file.write_file(file_path, String.from("data"), io), IoExn(io : io, exn : exn));
  // Path with .. segment: dir/sub/../target.txt should resolve to dir/target.txt
  dotdot_path := Path.new(path_join(path_join(path_join(tmp, `yo_fs_conv_canonical_dir`), `sub`), `../target.txt`));
  resolved := io.await(fs_file.canonical(dotdot_path, io), IoExn(io : io, exn : exn));
  direct := io.await(fs_file.canonical(file_path, io), IoExn(io : io, exn : exn));
  resolved_str := resolved.to_string();
  direct_str := direct.to_string();
  unsafe(printf("  dotdot resolved = %s\n", resolved_str.to_cstr().ptr().unwrap()));
  unsafe(printf("  direct resolved  = %s\n", direct_str.to_cstr().ptr().unwrap()));
  assert(resolved_str == direct_str, "dot-dot path should resolve to same as direct");
  io.await(fs_dir.remove_file(file_path, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(sub_path, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_dir(dir_path, io), IoExn(io : io, exn : exn));
});
test("canonical throws for nonexistent path", {
  fpath := Path.new(`/nonexistent/yo_fs_conv_canonical_missing`);
  exn := Exception(
    throw : (
      (err) -> {
        unsafe(printf("  got expected error\n"));
        unwind(());
      }
    )
  );
  io.await(fs_file.canonical(fpath, io), IoExn(io : io, exn : exn));
  assert(false, "should have thrown");
});
