test("metadata_str works with str path", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_meta_str.txt`));
  io.await(fs_file.write_string(fpath, String.from("str meta"), io), IoExn(io : io, exn : exn));
  m := io.await(fs_metadata.metadata(fpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  size = %lld\n", m.size()));
  assert(m.size() == i64(8), "size should be 8");
  assert(m.is_file(), "should be file");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// metadata on nonexistent
// ============================================================================
test("metadata nonexistent returns error", {
  fpath := Path.new(`/nonexistent/yo_fs_meta_nope.txt`);
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("  got expected error\n"));
        unwind(());
      }
    )
  );
  io.await(fs_metadata.metadata(fpath, io), IoExn(io : io, exn : exn));
  assert(false, "metadata on nonexistent should fail");
});
// ============================================================================
// symlink_metadata
// ============================================================================
test("symlink_metadata on symlink reports symlink", {
  tmp := temp_dir();
  src := Path.new(path_join(tmp, `yo_fs_meta_sym_src.txt`));
  lnk := Path.new(path_join(tmp, `yo_fs_meta_sym_lnk.txt`));
  setup_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception during setup");
        unwind(());
      }
    )
  );
  cond(
    io.await(fs_file.exists(lnk, io), io) => {
      io.await(fs_dir.remove_file(lnk, io), IoExn(io : io, exn : setup_exn));
    },
    true => ()
  );
  cond(
    io.await(fs_file.exists(src, io), io) => {
      io.await(fs_dir.remove_file(src, io), IoExn(io : io, exn : setup_exn));
    },
    true => ()
  );
  io.await(fs_file.write_string(src, String.from("symlink meta test"), io), IoExn(io : io, exn : setup_exn));
  // Symlink may fail with PermissionDenied on Windows
  sym_exn := Exception(
    throw : (
      err -> {
        match(
          downcast(err, IoError),
          .Some(io_err) => match(
            io_err,
            .PermissionDenied => {
              unsafe(printf("  SKIP: symlinks require admin or Developer Mode on Windows\n"));
            },
            _ => {
              assert(false, "symlink creation failed");
            }
          ),
          .None => {
            assert(false, "unexpected error type");
          }
        );
        unwind(());
      }
    )
  );
  io.await(fs_dir.symlink(src, lnk, io), IoExn(io : io, exn : sym_exn));
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  // Regular metadata follows the symlink — should report file
  m1 := io.await(fs_metadata.metadata(lnk, io), IoExn(io : io, exn : exn));
  is_file := m1.is_file();
  unsafe(printf("  metadata is_file = %d\n", cond(is_file => i32(1), true => i32(0))));
  assert(is_file, "metadata should follow symlink to file");
  assert(!m1.is_symlink(), "metadata should not report symlink");
  // symlink_metadata should report symlink
  m2 := io.await(fs_metadata.symlink_metadata(lnk, io), IoExn(io : io, exn : exn));
  is_sym := m2.is_symlink();
  unsafe(printf("  symlink_metadata is_symlink = %d\n", cond(is_sym => i32(1), true => i32(0))));
  assert(is_sym, "symlink_metadata should report symlink");
  io.await(fs_dir.remove_file(lnk, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(src, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// File.metadata method
// ============================================================================
test("File.metadata fstats THIS descriptor: a from_fd handle reports the file, not the CWD", {
  // `File.from_fd` owns a raw descriptor and has no path; an empty `Path`
  // renders as ".", so re-stat-by-path answered about the CURRENT DIRECTORY
  // — a directory, with the directory's size and times, and no error.
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_meta_from_fd.txt`));
  io.await(fs_file.write_string(fpath, String.from("0123456789"), io), e);
  { File } :: import("std/fs/file");
  opened := io.await(File.open(fpath, .Read, io), e);
  // Ownership of the descriptor MOVES to the wrapped handle (from_fd's
  // documented contract) — retire the original so it cannot double-close.
  wrapped := File.from_fd(opened.fd());
  opened._is_closed = true;
  m := io.await(wrapped.metadata(io), e);
  unsafe(printf("  from_fd metadata size = %lld\n", m.size()));
  assert(m.size() == i64(10), "size is the FILE's 10 bytes, not the cwd's");
  assert(m.is_file(), "from_fd metadata is a regular file");
  assert(!m.is_dir(), "from_fd metadata is NOT the current directory");
  assert(m.ino() > u64(0), "inode is the file's");
  io.await(wrapped.close(io), e);
  io.await(fs_dir.remove_file(fpath, io), e);
});
test("File.metadata follows the descriptor across a rename, not the path", {
  // The descriptor names the inode; the path does not. A handle whose file
  // was renamed after the open still describes the open file — re-stat by
  // path threw ENOENT here.
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  tmp := temp_dir();
  before := Path.new(path_join(tmp, `yo_fs_meta_rename_a.txt`));
  after := Path.new(path_join(tmp, `yo_fs_meta_rename_b.txt`));
  io.await(fs_file.write_string(before, String.from("12345"), io), e);
  { File } :: import("std/fs/file");
  f := io.await(File.open(before, .Read, io), e);
  io.await(fs_dir.rename(before, after, io), e);
  m := io.await(f.metadata(io), e);
  unsafe(printf("  renamed-open metadata size = %lld\n", m.size()));
  assert(m.size() == i64(5), "size of the still-open inode");
  assert(m.is_file(), "still a regular file");
  io.await(f.close(io), e);
  io.await(fs_dir.remove_file(after, io), e);
});
test("File.metadata returns correct info", {
  exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_meta_file_method.txt`));
  io.await(fs_file.write_string(fpath, String.from("file meta"), io), IoExn(io : io, exn : exn));
  { File } :: import("std/fs/file");
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  m := io.await(f.metadata(io), IoExn(io : io, exn : exn));
  unsafe(printf("  File.metadata size = %lld\n", m.size()));
  assert(m.size() == i64(9), "size should be 9");
  assert(m.is_file(), "should be file");
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
