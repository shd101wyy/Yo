open import "std/libc/stdio";
open import "std/string";
{ Path } :: import "std/path";
{ IOError } :: import "std/io/errors";
fs_metadata :: import "std/fs/metadata";
{ Metadata } :: import "std/fs/metadata";
fs_file :: import "std/fs/file";
fs_dir :: import "std/fs/dir";
{ temp_dir, path_join } :: import "../helper";

// ============================================================================
// metadata on a regular file
// ============================================================================

test "metadata returns file info", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_meta_file.txt`));

  io.await(fs_file.write_file(fpath, "metadata test", using(io)));

  r := io.await(fs_metadata.metadata(fpath, using(io)));
  match(r,
    .Ok(m) => {
      printf("  size = %lld\n", m.size());
      assert((m.size() == i64(13)), "size should be 13");

      printf("  is_file = %d\n", i32(m.is_file()));
      assert(m.is_file(), "should be a file");

      printf("  is_dir = %d\n", i32(m.is_dir()));
      assert((!(m.is_dir())), "should not be a dir");

      printf("  is_symlink = %d\n", i32(m.is_symlink()));
      assert((!(m.is_symlink())), "should not be a symlink");

      printf("  ino = %llu\n", m.ino());
      assert((m.ino() > u64(0)), "inode should be positive");

      printf("  nlink = %llu\n", m.nlink());
      assert((m.nlink() >= u64(1)), "nlink should be >= 1");

      printf("  modified_time = %lld\n", m.modified_time());
      assert((m.modified_time() > i64(0)), "mtime should be positive");
    },
    .Err(e) => assert(false, "metadata failed")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

// ============================================================================
// metadata on a directory
// ============================================================================

test "metadata on directory", using(io : IO), {
  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_meta_dir`));

  io.await(fs_dir.remove_dir(dpath, using(io)));
  io.await(fs_dir.create_dir(dpath, using(io)));

  r := io.await(fs_metadata.metadata(dpath, using(io)));
  match(r,
    .Ok(m) => {
      printf("  is_dir = %d\n", i32(m.is_dir()));
      assert(m.is_dir(), "should be a dir");
      assert((!(m.is_file())), "should not be a file");
    },
    .Err(e) => assert(false, "metadata on dir failed")
  );

  io.await(fs_dir.remove_dir(dpath, using(io)));
};

// ============================================================================
// metadata_str
// ============================================================================

test "metadata_str works with str path", using(io : IO), {
  tmp := temp_dir();
  fpath_s := path_join(tmp, `yo_fs_meta_str.txt`);
  fpath := Path.new(fpath_s);
  fpath_cstr := fpath_s.to_cstr();
  fpath_c := fpath_cstr.ptr().unwrap();

  io.await(fs_file.write_file(fpath, "str meta", using(io)));

  r := io.await(fs_metadata.metadata_str(fpath_c, using(io)));
  match(r,
    .Ok(m) => {
      printf("  size = %lld\n", m.size());
      assert((m.size() == i64(8)), "size should be 8");
      assert(m.is_file(), "should be file");
    },
    .Err(e) => assert(false, "metadata_str failed")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};

// ============================================================================
// metadata on nonexistent
// ============================================================================

test "metadata nonexistent returns error", using(io : IO), {
  fpath := Path.new(`/nonexistent/yo_fs_meta_nope.txt`);
  r := io.await(fs_metadata.metadata(fpath, using(io)));
  match(r,
    .Ok(_) => { assert(false, "metadata on nonexistent should fail"); },
    .Err(e) => { printf("  got expected error\n"); }
  );
};

// ============================================================================
// symlink_metadata
// ============================================================================

test "symlink_metadata on symlink reports symlink", using(io : IO), {
  tmp := temp_dir();
  src := Path.new(path_join(tmp, `yo_fs_meta_sym_src.txt`));
  lnk := Path.new(path_join(tmp, `yo_fs_meta_sym_lnk.txt`));

  io.await(fs_dir.remove_file(lnk, using(io)));
  io.await(fs_dir.remove_file(src, using(io)));
  io.await(fs_file.write_file(src, "symlink meta test", using(io)));
  io.await(fs_dir.symlink(src, lnk, using(io)));

  // Regular metadata follows the symlink — should report file
  r1 := io.await(fs_metadata.metadata(lnk, using(io)));
  match(r1,
    .Ok(m) => {
      printf("  metadata is_file = %d\n", i32(m.is_file()));
      assert(m.is_file(), "metadata should follow symlink to file");
      assert((!(m.is_symlink())), "metadata should not report symlink");
    },
    .Err(e) => assert(false, "metadata on symlink target failed")
  );

  // symlink_metadata should report symlink
  r2 := io.await(fs_metadata.symlink_metadata(lnk, using(io)));
  match(r2,
    .Ok(m) => {
      printf("  symlink_metadata is_symlink = %d\n", i32(m.is_symlink()));
      assert(m.is_symlink(), "symlink_metadata should report symlink");
    },
    .Err(e) => assert(false, "symlink_metadata failed")
  );

  io.await(fs_dir.remove_file(lnk, using(io)));
  io.await(fs_dir.remove_file(src, using(io)));
};

// ============================================================================
// File.metadata method
// ============================================================================

test "File.metadata returns correct info", using(io : IO), {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_meta_file_method.txt`));

  io.await(fs_file.write_file(fpath, "file meta", using(io)));

  { File } :: import "std/fs/file";
  fr := io.await(File.open(fpath, .Read, using(io)));
  match(fr,
    .Ok(f) => {
      mr := io.await(f.metadata(using(io)));
      match(mr,
        .Ok(m) => {
          printf("  File.metadata size = %lld\n", m.size());
          assert((m.size() == i64(9)), "size should be 9");
          assert(m.is_file(), "should be file");
        },
        .Err(e) => assert(false, "File.metadata failed")
      );
      io.await(f.close(using(io)));
    },
    .Err(e) => assert(false, "File.open failed")
  );

  io.await(fs_dir.remove_file(fpath, using(io)));
};
