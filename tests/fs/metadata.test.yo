open import "std/libc/stdio";
open import "std/string";
{ Path } :: import "std/path";
{ IOError } :: import "std/sys/errors";
{ Error, AnyError, Exception } :: import "std/error";
fs_metadata :: import "std/fs/metadata";
{ Metadata } :: import "std/fs/metadata";
fs_file :: import "std/fs/file";
fs_dir :: import "std/fs/dir";
{ temp_dir, path_join } :: import "../helper";

// ============================================================================
// metadata on a regular file
// ============================================================================

test "metadata returns file info", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_meta_file.txt`));

  io.await(fs_file.write_file(fpath, String.from("metadata test")));

  m := io.await(fs_metadata.metadata(fpath));

  printf("  size = %lld\n", m.size());
  assert((m.size() == i64(13)), "size should be 13");

  is_file := m.is_file();
  printf("  is_file = %d\n", cond(is_file => i32(1), true => i32(0)));
  assert(is_file, "should be a file");

  is_dir := m.is_dir();
  printf("  is_dir = %d\n", cond(is_dir => i32(1), true => i32(0)));
  assert((!(is_dir)), "should not be a dir");

  is_symlink := m.is_symlink();
  printf("  is_symlink = %d\n", cond(is_symlink => i32(1), true => i32(0)));
  assert((!(is_symlink)), "should not be a symlink");

  printf("  ino = %llu\n", m.ino());
  assert((m.ino() > u64(0)), "inode should be positive");

  printf("  nlink = %llu\n", m.nlink());
  assert((m.nlink() >= u64(1)), "nlink should be >= 1");

  printf("  modified_time = %lld\n", m.modified_time());
  assert((m.modified_time() > i64(0)), "mtime should be positive");

  io.await(fs_dir.remove_file(fpath));
};

// ============================================================================
// metadata on a directory
// ============================================================================

test "metadata on directory", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  dpath := Path.new(path_join(tmp, `yo_fs_meta_dir`));

  cond(io.await(fs_file.exists(dpath, using(io))) => {
    io.await(fs_dir.remove_dir(dpath));
  }, true => ());
  io.await(fs_dir.create_dir(dpath));

  m := io.await(fs_metadata.metadata(dpath));

  is_dir := m.is_dir();
  printf("  is_dir = %d\n", cond(is_dir => i32(1), true => i32(0)));
  assert(is_dir, "should be a dir");
  assert((!(m.is_file())), "should not be a file");

  io.await(fs_dir.remove_dir(dpath));
};

// ============================================================================
// metadata_str
// ============================================================================

test "metadata_str works with str path", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_meta_str.txt`));

  io.await(fs_file.write_file(fpath, String.from("str meta")));

  m := io.await(fs_metadata.metadata(fpath));
  printf("  size = %lld\n", m.size());
  assert((m.size() == i64(8)), "size should be 8");
  assert(m.is_file(), "should be file");

  io.await(fs_dir.remove_file(fpath));
};

// ============================================================================
// metadata on nonexistent
// ============================================================================

test "metadata nonexistent returns error", using(io : IO), {
  fpath := Path.new(`/nonexistent/yo_fs_meta_nope.txt`);

  given(exn) := Exception(throw : ((err) -> {
    printf("  got expected error\n");
    escape ();
  }));
  io.await(fs_metadata.metadata(fpath));
  assert(false, "metadata on nonexistent should fail");
};

// ============================================================================
// symlink_metadata
// ============================================================================

test "symlink_metadata on symlink reports symlink", using(io : IO), {
  tmp := temp_dir();
  src := Path.new(path_join(tmp, `yo_fs_meta_sym_src.txt`));
  lnk := Path.new(path_join(tmp, `yo_fs_meta_sym_lnk.txt`));

  given(setup_exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception during setup");
    escape ();
  }));

  cond(io.await(fs_file.exists(lnk, using(io))) => {
    io.await(fs_dir.remove_file(lnk));
  }, true => ());
  cond(io.await(fs_file.exists(src, using(io))) => {
    io.await(fs_dir.remove_file(src));
  }, true => ());
  io.await(fs_file.write_file(src, String.from("symlink meta test")));

  // Symlink may fail with PermissionDenied on Windows
  given(sym_exn) := Exception(throw : ((err) -> {
    match(downcast(err, IOError),
      .Some(io_err) => match(io_err,
        .PermissionDenied => {
          printf("  SKIP: symlinks require admin or Developer Mode on Windows\n");
        },
        _ => {
          assert(false, "symlink creation failed");
        }
      ),
      .None => {
        assert(false, "unexpected error type");
      }
    );
    escape ();
  }));
  io.await(fs_dir.symlink(src, lnk));

  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  // Regular metadata follows the symlink — should report file
  m1 := io.await(fs_metadata.metadata(lnk));
  is_file := m1.is_file();
  printf("  metadata is_file = %d\n", cond(is_file => i32(1), true => i32(0)));
  assert(is_file, "metadata should follow symlink to file");
  assert((!(m1.is_symlink())), "metadata should not report symlink");

  // symlink_metadata should report symlink
  m2 := io.await(fs_metadata.symlink_metadata(lnk));
  is_sym := m2.is_symlink();
  printf("  symlink_metadata is_symlink = %d\n", cond(is_sym => i32(1), true => i32(0)));
  assert(is_sym, "symlink_metadata should report symlink");

  io.await(fs_dir.remove_file(lnk));
  io.await(fs_dir.remove_file(src));
};

// ============================================================================
// File.metadata method
// ============================================================================

test "File.metadata returns correct info", using(io : IO), {
  given(exn) := Exception(throw : ((err) -> {
    assert(false, "unexpected exception");
    escape ();
  }));

  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_meta_file_method.txt`));

  io.await(fs_file.write_file(fpath, String.from("file meta")));

  { File } :: import "std/fs/file";
  f := io.await(File.open(fpath, .Read));
  m := io.await(f.metadata());
  printf("  File.metadata size = %lld\n", m.size());
  assert((m.size() == i64(9)), "size should be 9");
  assert(m.is_file(), "should be file");
  io.await(f.close());

  io.await(fs_dir.remove_file(fpath));
};
