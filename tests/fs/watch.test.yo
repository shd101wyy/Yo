// std/fs/watch — file-system change notifications (plans/archive/STD_API_AUDIT.md §7 P1).
pragma(Pragma.SkipWasm32Emscripten); // no inotify/kqueue in WASM
pragma(Pragma.SkipWasm32Wasi); // no inotify/kqueue in WASM
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ temp_dir, path_join } :: import("../helper");
{ Path } :: import("std/path");
{ watch, WatchOptions, FsEvent, FsEventKind, Watcher } :: import("std/fs/watch");
{ Exception } :: import("std/error");
{ Stream } :: import("std/async/stream");
{ timeout, yield } :: import("std/async");
{ Duration } :: import("std/time/duration");
{ ArrayList } :: import("std/collections/array_list");
{ platform, Platform } :: import("std/process");
{ sleep } :: import("std/sys/timer");
{ clock_gettime } :: import("std/sys/clock");
file :: import("std/sys/file");
dir :: import("std/sys/dir");
{ AT_FDCWD, O_CREAT, O_WRONLY, O_TRUNC, AT_REMOVEDIR } :: import("std/sys/constants");
_touch :: (fn(path : String, content : String, io : Io) -> unit)({
  c := path.to_cstr();
  p := c.ptr().unwrap();
  fd := io.await(file.openat(AT_FDCWD, p, O_CREAT | (O_WRONLY | O_TRUNC), i32(0o644)), io);
  assert(fd >= i32(0), "open failed");
  body := content.to_cstr();
  wr := io.await(file.write(fd, body.ptr().unwrap(), u32(content.len()), u64(0)), io);
  assert(wr >= i32(0), "write failed");
  io.await(file.close(fd), io);
});
_unlink :: (fn(path : String, io : Io) -> unit)({
  c := path.to_cstr();
  io.await(dir.unlink(AT_FDCWD, c.ptr().unwrap(), i32(0)), io);
});
test("watch a directory: creating a file produces events, poll drains them", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected error: ${err}`);
        unwind(());
      }
    )
  );
  d := temp_dir();
  target := path_join(d, `yo_watch_poll.txt`);
  _unlink(target, io);
  w := watch(Path.new(d), WatchOptions.defaults(), t_exn);
  assert(w.is_active(), "active after watch()");
  assert(w.pending() == usize(0), "nothing queued yet");
  _touch(target, String.from("hello"), io);
  io.await(sleep(u64(250)), io);
  first := w.poll();
  assert(first.is_some(), "an event was queued for the new file");
  (saw_target : bool) = false;
  (ev : Option(FsEventKind)) = Option(FsEventKind).None;
  cur := first;
  while(cur.is_some(), {
    e := cur.unwrap();
    if(e.name == "yo_watch_poll.txt", {
      saw_target = true;
      ev = Option(FsEventKind).Some(e.kind);
    });
    cur = w.poll();
  });
  assert(saw_target, "the event names the created entry");
  assert(w.pending() == usize(0), "poll drained the queue");
  w.close();
  assert(!w.is_active(), "closed");
  _unlink(target, io);
});
test("next(io) resolves when an event arrives and .None after close", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected error: ${err}`);
        unwind(());
      }
    )
  );
  d := temp_dir();
  target := path_join(d, `yo_watch_next.txt`);
  _unlink(target, io);
  w := watch(Path.new(d), WatchOptions.defaults(), t_exn);
  _touch(target, String.from("x"), io);
  ev := io.await(w.next(io), io);
  assert(ev.is_some(), "next resolved with an event");
  // drain whatever else the backend coalesced, then close: next must not hang
  (more : Option(FsEvent)) = w.poll();
  while(more.is_some(), {
    more = w.poll();
  });
  w.close();
  after := io.await(w.next(io), io);
  assert(after.is_none(), "closed watcher's next is .None");
  _unlink(target, io);
});
// The handler is installed in the function whose return the unwind exits —
// a `ctl` handler is frame-bound (docs/en-US/ALGEBRAIC_EFFECTS.md).
_try_watch :: (fn(p : String) -> Option(Watcher))({
  exn := Exception(
    throw : (
      err -> {
        unwind(Option(Watcher).None);
      }
    )
  );
  w := watch(Path.new(p), WatchOptions.defaults(), exn);
  Option(Watcher).Some(w)
});
test("watching a missing path throws IoError", {
  missing := _try_watch(`/nonexistent/yo_watch_dir_zzz`);
  assert(missing.is_none(), "watch on a missing path unwinds through exn");
  present := _try_watch(temp_dir());
  assert(present.is_some(), "an existing directory is watchable");
  match(present, .Some(w) => w.close(), .None => ());
});
test("FsEventKind renders", {
  assert(FsEventKind.Rename.to_string() == "rename", "rename");
  assert(FsEventKind.Change.to_string() == "change", "change");
});
// A watcher created inside this function drops at the function's end without
// `close()`. Returns false if `watch` itself threw.
_watch_and_drop :: (fn(p : String) -> bool)({
  exn := Exception(
    throw : (
      err -> {
        unwind(false);
      }
    )
  );
  w := watch(Path.new(p), WatchOptions.defaults(), exn);
  assert(w.is_active(), "a fresh watcher is active");
  true
});
// Open-and-close a file and report the descriptor number it got. The kernel
// hands out the LOWEST free descriptor, so this reads as "how many fds are
// currently in use" without depending on any resource limit.
_probe_fd :: (fn(path : String, io : Io) -> i32)({
  c := path.to_cstr();
  p := c.ptr().unwrap();
  fd := io.await(file.openat(AT_FDCWD, p, O_CREAT | O_WRONLY, i32(0o644)), io);
  assert(fd >= i32(0), "the probe file opened");
  io.await(file.close(fd), io);
  fd
});
// Regression: `Watcher` shipped a `close()` and no `Dispose`, so a dropped
// watcher never unregistered — leaking the backend's `__yo_fs_event_t` and its
// descriptors, AND leaving the event loop holding a raw non-owning pointer to
// freed memory
// (issues/fixed/a-dropped-watcher-leaves-the-event-loop-calling-freed-memory.md).
//
// The oracle is the descriptor NUMBER, not a resource limit: each live watcher
// holds an inotify instance on Linux and an O_EVTONLY fd plus a kqueue fd on
// macOS, so 200 leaked watchers push the next free descriptor hundreds higher.
// A limit-based oracle would have been vacuous here — this machine's
// RLIMIT_NOFILE swallows 200 leaks without complaining.
test("a watcher dropped without close() releases its backend handle", {
  d := temp_dir();
  probe := path_join(d, `yo_watch_fd_probe.txt`);
  base := _probe_fd(probe, io);
  (i : usize) = usize(0);
  while(i < usize(200), {
    assert(
      _watch_and_drop(d),
      `watch failed at iteration ${i} — dropped watchers are not releasing their backend handles`
    );
    i = (i + usize(1));
  });
  after := _probe_fd(probe, io);
  assert(
    after <= (base + i32(8)),
    `200 dropped watchers moved the next free descriptor from ${base} to ${after} — their backend handles leaked`
  );
  // And the backend still works afterwards: a fresh watcher still delivers.
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected error: ${err}`);
        unwind(());
      }
    )
  );
  target := path_join(d, `yo_watch_drop.txt`);
  _unlink(target, io);
  w := watch(Path.new(d), WatchOptions.defaults(), t_exn);
  _touch(target, String.from("x"), io);
  ev := io.await(w.next(io), io);
  assert(ev.is_some(), "a watcher created after 200 dropped ones still delivers");
  w.close();
  _unlink(target, io);
  _unlink(probe, io);
});
// A `Watcher` is the first `Stream` implementor — its `next` WAS this shape
// before the trait existed (plans/reference/ASYNC_ITERATION_STREAM.md), so
// every combinator applies to it. The chain is bounded by `take(1)` and the
// await runs in a spawned task under a deadline, so a regression that stops
// delivering events fails instead of hanging.
test("a Watcher is a Stream: map + take collects one event name", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected error: ${err}`);
        unwind(());
      }
    )
  );
  d := temp_dir();
  target := path_join(d, `yo_watch_stream.txt`);
  _unlink(target, io);
  w := watch(Path.new(d), WatchOptions.defaults(), t_exn);
  names := w.map(e => e.name).take(usize(1));
  h := io.spawn(names.collect(io), io);
  _touch(target, String.from("x"), io);
  got := match(
    timeout(h, Duration.from_millis(i64(5000)), io),
    .Ok(list) => list,
    .Err(_) => {
      assert(false, "the watcher stream delivered no event inside the deadline");
      ArrayList(String).new()
    }
  );
  assert(got.len() == usize(1), "take(1) ends the stream after one event");
  assert(got(usize(0)).len() > usize(0), "the mapped item is the entry name");
  (more : Option(FsEvent)) = w.poll();
  while(more.is_some(), {
    more = w.poll();
  });
  w.close();
  _unlink(target, io);
});

test("a recursive watch keeps reporting subdirectory changes after the first batch", {
  // The Windows backend's re-arm in __yo_poll_and_fs_event_tick hard-coded
  // WatchSubtree = FALSE, so a recursive watch asked for less than the
  // caller requested from its SECOND ReadDirectoryChangesW on
  // (issues/fixed/windows-fs-watch-rearm-drops-recursive-flag.md). Round 1
  // forces one delivered batch — the re-arm happens exactly there — and
  // round 2 changes only a SUBDIRECTORY entry. Windows' kernel currently
  // keeps the first arm's scope on the handle, which masks the narrowed
  // re-arm; this pins the contract for a kernel that honors per-request
  // scope. Linux inotify is single-directory and macOS uses a per-directory
  // snapshot diff, so recursive is documented best-effort there and only the
  // root round is asserted on those platforms.
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected error: ${err}`);
        unwind(());
      }
    )
  );
  d := temp_dir();
  sub := path_join(d, `yo_watch_sub`);
  io.await(dir.mkdir(AT_FDCWD, sub.to_cstr().ptr().unwrap(), i32(0o755)), io);
  root_target := path_join(d, `yo_watch_recur_root.txt`);
  sub_target := path_join(sub, `yo_watch_recur_child.txt`);
  _unlink(root_target, io);
  _unlink(sub_target, io);

  w := watch(Path.new(d), WatchOptions(recursive : true), t_exn);
  assert(w.is_active(), "recursive watch started");

  _touch(root_target, String.from("one"), io);
  io.await(sleep(u64(250)), io);
  (saw_root : bool) = false;
  cur := w.poll();
  while(cur.is_some(), {
    e := cur.unwrap();
    if(e.name == String.from("yo_watch_recur_root.txt"), {
      saw_root = true;
    });
    cur = w.poll();
  });
  assert(saw_root, "the root-file event was delivered");

  _touch(sub_target, String.from("two"), io);
  io.await(sleep(u64(250)), io);
  (saw_child : bool) = false;
  cur = w.poll();
  while(cur.is_some(), {
    e := cur.unwrap();
    if(e.name == path_join(String.from("yo_watch_sub"), String.from("yo_watch_recur_child.txt")), {
      saw_child = true;
    });
    cur = w.poll();
  });
  cond(
    (platform == Platform.Windows) => {
      assert(
        saw_child,
        "the subdirectory event was delivered under a recursive watch after a first batch had been re-armed"
      );
    },
    true => ()
  );

  w.close();
  _unlink(sub_target, io);
  _unlink(root_target, io);
});
// A task waiting in next() must not burn CPU. next used to re-yield in a loop,
// so the waiting task was always runnable and the loop never blocked: 300 ms
// of waiting cost ~300 ms of CPU. It now parks, and the event callback wakes
// it (issues/fixed/poll-and-fs-event-watches-starve-while-the-loop-waits.md).
_cpu_ms :: (fn() -> i64)({
  sec_buf := MaybeUninit(i64).new();
  nsec_buf := MaybeUninit(i64).new();
  sec := (*i64)(sec_buf.as_ptr());
  nsec := (*i64)(nsec_buf.as_ptr());
  // CLOCK_PROCESS_CPUTIME_ID: 2 on Linux, 12 on macOS.
  id := cond((platform == Platform.Macos) => i32(12), true => i32(2));
  _rc := clock_gettime(id, sec, nsec);
  (sec.* * i64(1000)) + (nsec.* / i64(1000000))
});
// Awaits directly inside the task (a plain helper like _touch would be a
// nested blocking await there).
_touch_later :: (fn(path : String, io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    _s := io.await(sleep(u64(300)), io);
    c := path.to_cstr();
    fd := io.await(file.openat(AT_FDCWD, c.ptr().unwrap(), O_CREAT | (O_WRONLY | O_TRUNC), i32(0o644)), io);
    _c := io.await(file.close(fd), io);
    fd
  })
);
test("a task waiting in next(io) does not spin the CPU", {
  if(platform != Platform.Windows, {
    t_exn := Exception(
      throw : (
        err -> {
          assert(false, `unexpected error: ${err}`);
          unwind(());
        }
      )
    );
    d := temp_dir();
    target := path_join(d, `yo_watch_idle.txt`);
    _unlink(target, io);
    w := watch(Path.new(d), WatchOptions.defaults(), t_exn);
    h := io.spawn(_touch_later(target, io), io);
    cpu0 := _cpu_ms();
    ev := io.await(w.next(io), io);
    cpu := (_cpu_ms() - cpu0);
    println(`  CPU while waiting ~300 ms in next(): ${cpu} ms`);
    assert(ev.is_some(), "next resolved with the late event");
    assert(cpu < i64(150), "the wait parked instead of spinning");
    _j := h.await(io);
    w.close();
    _unlink(target, io);
  });
});
// A directory watch must not rescan the directory on every loop pass. The
// macOS backend used to diff a full snapshot (an opendir, a readdir and a stat
// per entry) on EVERY pass, so a busy loop under a watch of a few hundred
// entries spent almost all its time re-reading the directory: 20000 yields
// here took seconds. It now rescans on the directory's vnode events and, in
// between, at most every 50 ms (issues/fixed/macos-fs-watch-rescans-its-directory-on-every-loop-pass.md).
test("a directory watch does not rescan the directory on every loop pass", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, `unexpected error: ${err}`);
        unwind(());
      }
    )
  );
  d := path_join(temp_dir(), `yo_watch_busy_dir`);
  _mk := io.await(dir.mkdir(AT_FDCWD, d.to_cstr().ptr().unwrap(), i32(0o755)), io);
  (i : i32) = i32(0);
  while(i < i32(300), i = (i + i32(1)), {
    _touch(path_join(d, `f${i}`), String.from("x"), io);
  });
  w := watch(Path.new(d), WatchOptions.defaults(), t_exn);
  t0 := _cpu_ms();
  (k : i32) = i32(0);
  while(k < i32(20000), k = (k + i32(1)), {
    io.await(yield(io), io);
  });
  spent := (_cpu_ms() - t0);
  println(`  CPU for 20000 loop passes under a 300-entry directory watch: ${spent} ms`);
  assert(spent < i64(1500), "the watch did not rescan the directory on every pass");
  w.close();
  (j : i32) = i32(0);
  while(j < i32(300), j = (j + i32(1)), {
    _unlink(path_join(d, `f${j}`), io);
  });
  _rm := io.await(dir.unlink(AT_FDCWD, d.to_cstr().ptr().unwrap(), AT_REMOVEDIR), io);
});
