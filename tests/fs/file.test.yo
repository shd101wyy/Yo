// ============================================================================
// File position tracking
//
// The underlying primitive is POSITIONAL (pread/pwrite), so `File` must carry
// its own offset — the descriptor's position is neither read nor advanced.
// issues/file-read-write-ignore-position-always-offset-zero.md
// ============================================================================
test("File sequential write_string calls advance the position", {
  exn := Exception(
    throw : (
      err -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_pos_write.txt`));
  f := io.await(File.open(fpath, .Write, io), IoExn(io : io, exn : exn));
  io.await(f.write_string(`AAA`, io), IoExn(io : io, exn : exn));
  io.await(f.write_string(`BBB`, io), IoExn(io : io, exn : exn));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  s := io.await(fs_file.read_to_string(fpath, io), IoExn(io : io, exn : exn));
  assert(s == `AAABBB`, "second write must APPEND, not overwrite at offset 0");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("File sequential read calls advance the position", {
  exn := Exception(
    throw : (
      err -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_pos_read.txt`));
  io.await(fs_file.write_string(fpath, `ABCDEF`, io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  buf := (*u8)(malloc(usize(8)).unwrap());
  n1 := io.await(f.read(buf, usize(3), io), IoExn(io : io, exn : exn));
  assert(n1 == usize(3), "first read should return 3 bytes");
  first := (((buf).* == u8(65)) && ((buf.add(usize(1))).* == u8(66)) && ((buf.add(usize(2))).* == u8(67)));
  assert(first, "first read should be ABC");
  n2 := io.await(f.read(buf, usize(3), io), IoExn(io : io, exn : exn));
  assert(n2 == usize(3), "second read should return 3 bytes");
  second := (((buf).* == u8(68)) && ((buf.add(usize(1))).* == u8(69)) && ((buf.add(usize(2))).* == u8(70)));
  assert(second, "second read must be DEF — the position must advance");
  free(.Some((*void)(buf)));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("File.seek positions the next read", {
  exn := Exception(
    throw : (
      err -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_pos_seek.txt`));
  io.await(fs_file.write_string(fpath, `0123456789`, io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  moved := f.seek(i64(5), .Start, exn);
  assert(moved == i64(5), "seek should report the new offset");
  buf := (*u8)(malloc(usize(8)).unwrap());
  n := io.await(f.read(buf, usize(3), io), IoExn(io : io, exn : exn));
  assert(n == usize(3), "read after seek should return 3 bytes");
  got := (((buf).* == u8(53)) && ((buf.add(usize(1))).* == u8(54)) && ((buf.add(usize(2))).* == u8(55)));
  assert(got, "read after seek(5) must be 567, not 012");
  free(.Some((*void)(buf)));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// set_len / from_fd
// ============================================================================
test("File.set_len truncates a longer file", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  set_len-truncates error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_set_len_trunc.txt`));
  io.await(fs_file.write_string(fpath, String.from("0123456789"), io), IoExn(io : io, exn : exn));
  // .ReadWrite, NOT .Write: .Write is create-or-OVERWRITE and would empty the
  // file before set_len ever runs.
  f := io.await(File.open(fpath, .ReadWrite, io), IoExn(io : io, exn : exn));
  io.await(f.set_len(i64(4), io), IoExn(io : io, exn : exn));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  s := io.await(fs_file.read_to_string(fpath, io), IoExn(io : io, exn : exn));
  assert(s == `0123`, "truncated to 4 bytes");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("File.set_len extends with zeroes", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  set_len-extends error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_set_len_ext.txt`));
  io.await(fs_file.write_string(fpath, String.from("ab"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .ReadWrite, io), IoExn(io : io, exn : exn));
  io.await(f.set_len(i64(5), io), IoExn(io : io, exn : exn));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  bytes := io.await(fs_file.read(fpath, io), IoExn(io : io, exn : exn));
  assert(bytes.len() == usize(5), "extended to 5 bytes");
  b0 := bytes.get(usize(0)).unwrap_or(u8(255));
  b2 := bytes.get(usize(2)).unwrap_or(u8(255));
  b4 := bytes.get(usize(4)).unwrap_or(u8(255));
  assert((b0 == u8(97)) && ((b2 == u8(0)) && (b4 == u8(0))), "original bytes kept, padding is zeroes");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("File.from_fd wraps an existing descriptor", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  from-fd error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_from_fd.txt`));
  io.await(fs_file.write_string(fpath, String.from("wrapped!"), io), IoExn(io : io, exn : exn));
  opened := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  // Rust's File::from_raw_fd semantics: ownership of the descriptor MOVES to
  // the wrapped handle — retire the original so its close/dispose cannot
  // double-close the fd.
  wrapped := File.from_fd(opened.fd());
  opened._is_closed = true;
  buf := (*u8)(malloc(usize(8)).unwrap());
  n := io.await(wrapped.read(buf, usize(8), io), IoExn(io : io, exn : exn));
  assert(n == usize(8), "read through the wrapped handle");
  assert((buf).* == u8(119), "first byte is 'w'");
  assert((buf.add(usize(7))).* == u8(33), "last byte is '!'");
  free(.Some((*void)(buf)));
  io.await(wrapped.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
// ============================================================================
// OpenOptions
// ============================================================================
test("OpenOptions.to_flags picks the access mode as a value, not a bit set", {
  // O_RDONLY is 0, so it must be CHOSEN — OR-ing it in would silently make
  // every read-only open look identical to a write-only one.
  ro := OpenOptions.new().read(true).to_flags().unwrap();
  wo := OpenOptions.new().write(true).to_flags().unwrap();
  rw := OpenOptions.new().read(true).write(true).to_flags().unwrap();
  assert((ro & O_WRONLY) == i32(0), "read-only carries neither write bit");
  assert((ro & O_RDWR) == i32(0), "read-only is not read-write");
  assert((wo & O_WRONLY) == O_WRONLY, "write-only carries O_WRONLY");
  assert((rw & O_RDWR) == O_RDWR, "read+write is O_RDWR");
  assert((ro & O_CLOEXEC) == O_CLOEXEC, "every open is close-on-exec");
});
test("OpenOptions.to_flags maps each flag", {
  f := OpenOptions.new().write(true).create(true).truncate(true).to_flags().unwrap();
  assert((f & O_CREAT) == O_CREAT, "create sets O_CREAT");
  assert((f & O_TRUNC) == O_TRUNC, "truncate sets O_TRUNC");
  assert((f & O_EXCL) == i32(0), "plain create is not exclusive");
  g := OpenOptions.new().append(true).create_new(true).to_flags().unwrap();
  assert((g & O_APPEND) == O_APPEND, "append sets O_APPEND");
  assert((g & O_CREAT) == O_CREAT, "create_new implies O_CREAT");
  assert((g & O_EXCL) == O_EXCL, "create_new sets O_EXCL");
  assert((g & O_WRONLY) == O_WRONLY, "append alone grants write access");
  assert(OpenOptions.new().append(true).creates() == false, "append alone does not create");
  assert(OpenOptions.new().create_new(true).creates(), "create_new creates");
});
test("OpenOptions.to_flags rejects the combinations POSIX would ignore", {
  // Each of these is silently misinterpreted by open(2) rather than
  // diagnosed, so the builder has to catch them.
  assert(OpenOptions.new().to_flags().is_err(), "no access mode at all");
  assert(OpenOptions.new().read(true).truncate(true).to_flags().is_err(), "truncate without write");
  assert(
    OpenOptions.new().write(true).append(true).truncate(true).to_flags().is_err(),
    "truncate and append are contradictory"
  );
  assert(OpenOptions.new().read(true).create(true).to_flags().is_err(), "create without write");
  match(
    OpenOptions.new().read(true).truncate(true).to_flags(),
    .Ok(f) => {
      eprintln(`  unexpectedly accepted: ${f}`);
      assert(false, "must be rejected");
    },
    .Err(msg) => assert(msg.contains("truncate needs write access"), "message names the contradiction")
  );
});
test("OpenOptions setters do not mutate the value they were called on", {
  // The setters are functional, so a base can be reused for several opens.
  base := OpenOptions.new().read(true);
  writing := base.write(true);
  assert(base.to_flags().unwrap() != writing.to_flags().unwrap(), "the derived value differs");
  assert((base.to_flags().unwrap() & O_RDWR) == i32(0), "and the base is untouched");
});
test("File.open_opts read+append writes at the end and reads from the start", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  open_opts error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_open_opts_ra.txt`));
  io.await(fs_file.write_string(fpath, String.from("head"), io), IoExn(io : io, exn : exn));
  // read+append is exactly the combination OpenMode cannot express.
  f := io.await(
    File.open_opts(fpath, OpenOptions.new().read(true).append(true), io),
    IoExn(io : io, exn : exn)
  );
  io.await(f.write_string(String.from("-tail"), io), IoExn(io : io, exn : exn));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  content := io.await(fs_file.read_to_string(fpath, io), IoExn(io : io, exn : exn));
  assert(content == String.from("head-tail"), "append landed after the existing content");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("File.open_opts create without truncate keeps existing content", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  open_opts create error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_open_opts_create.txt`));
  io.await(fs_file.write_string(fpath, String.from("keepme"), io), IoExn(io : io, exn : exn));
  f := io.await(
    File.open_opts(fpath, OpenOptions.new().read(true).write(true).create(true), io),
    IoExn(io : io, exn : exn)
  );
  assert(f.size() == i64(6), "the file was not truncated");
  io.await(f.close(io), IoExn(io : io, exn : exn));
  // The same options on a MISSING path create it.
  gpath := Path.new(path_join(tmp, `yo_fs_open_opts_new.txt`));
  g := io.await(
    File.open_opts(gpath, OpenOptions.new().write(true).create(true), io),
    IoExn(io : io, exn : exn)
  );
  io.await(g.write_string(String.from("fresh"), io), IoExn(io : io, exn : exn));
  io.await(g.close(io), IoExn(io : io, exn : exn));
  fresh := io.await(fs_file.read_to_string(gpath, io), IoExn(io : io, exn : exn));
  assert(fresh == String.from("fresh"), "created and written");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(gpath, io), IoExn(io : io, exn : exn));
});
test("File.open_opts create_new fails on an existing path", {
  setup_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception during setup");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_open_opts_excl.txt`));
  io.await(fs_file.write_string(fpath, String.from("x"), io), IoExn(io : io, exn : setup_exn));
  // Effect handlers are capture-free, so the expectation is asserted INSIDE
  // the handler and the line after the guarded call is the failure case —
  // the same shape as the OpenMode.CreateNew test above.
  exn := Exception(
    throw : (
      err -> {
        unsafe(printf("  create_new correctly failed on an existing path\n"));
        unwind(());
      }
    )
  );
  io.await(
    File.open_opts(fpath, OpenOptions.new().write(true).create_new(true), io),
    IoExn(io : io, exn : exn)
  );
  assert(false, "O_CREAT|O_EXCL on an existing file must throw");
});
test("File.open_opts throws a Context naming the rejected combination", {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_open_opts_bad.txt`));
  exn := Exception(
    throw : (
      err -> {
        msg := err.to_string();
        eprintln(`  rejected with: ${msg}`);
        assert(msg.contains("truncate needs write access"), "the explanation survives the throw");
        // The Context wraps an IoError, so the KIND Rust would report is
        // still reachable through the chain.
        assert(msg.contains("invalid input"), "and the underlying IoError kind is chained");
        unwind(());
      }
    )
  );
  io.await(
    File.open_opts(fpath, OpenOptions.new().read(true).truncate(true), io),
    IoExn(io : io, exn : exn)
  );
  assert(false, "a contradictory OpenOptions must throw");
});
// ============================================================================
// Seek trait + rewind
// ============================================================================
test("File.rewind returns to the beginning", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  rewind error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_rewind.txt`));
  io.await(fs_file.write_string(fpath, String.from("abcdef"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  buf := (*u8)(malloc(usize(3)).unwrap());
  io.await(f.read(buf, usize(3), io), IoExn(io : io, exn : exn));
  assert(f.position() == i64(3), "three bytes consumed");
  f.rewind(exn);
  assert(f.position() == i64(0), "back at the start");
  n := io.await(f.read(buf, usize(3), io), IoExn(io : io, exn : exn));
  assert(n == usize(3), "read again from the start");
  assert((buf).* == u8(97), "first byte is 'a' again");
  free(.Some((*void)(buf)));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
// A generic function bounded on `Seek` — this is what the trait exists for,
// and it is the only thing that proves the impl is actually registered
// (an inherent `seek` would satisfy the call sites above on its own).
_skip_forward :: (
  fn(generic(S : Type), s : S, by : i64, exn : Exception, where(S <: IoTraits.Seek(SeekFrom))) -> i64
)(
  S.seek(s, by, SeekFrom.Current, exn)
);
test("File satisfies the Seek trait bound", {
  exn := Exception(
    throw : (
      err -> {
        eprintln(`  seek-bound error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_seek_trait.txt`));
  io.await(fs_file.write_string(fpath, String.from("0123456789"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  assert(_skip_forward(f, i64(4), exn) == i64(4), "generic Seek call moved the position");
  assert(_skip_forward(f, i64(3), exn) == i64(7), "and it is relative to Current");
  buf := (*u8)(malloc(usize(1)).unwrap());
  io.await(f.read(buf, usize(1), io), IoExn(io : io, exn : exn));
  assert((buf).* == u8(55), "the byte at offset 7 is '7'");
  free(.Some((*void)(buf)));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
