pragma(Pragma.AllowUnsafe);
pragma(Pragma.SkipWasm32Wasi); // Emscripten syscalls (__syscall_*) not available in standalone WASI
{ assert } :: import("std/assert");
open(import("std/libc/stdio"));
open(import("std/string"));
{ Path } :: import("std/path");
{ IoError } :: import("std/sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("std/error");
fs_file :: import("std/fs/file");
{ File, OpenMode, FilePermission } :: import("std/fs/file");
{ temp_dir, path_join } :: import("../helper");
fs_dir :: import("std/fs/dir");
open(import("std/fmt"));
// ============================================================================
// Convenience function tests
// ============================================================================
test("write_string and read_to_string round-trip", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_write_read.txt`));
  io.await(fs_file.write_string(fpath, String.from("hello world"), io), IoExn(io : io, exn : exn));
  unsafe(printf("  write ok\n"));
  s := io.await(fs_file.read_to_string(fpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  read: %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `hello world`, "content mismatch");
  // Cleanup
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("write_string_cstr and read_to_string_cstr", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath_s := path_join(tmp, `yo_fs_file_str_test.txt`);
  fpath_cstr := fpath_s.to_cstr();
  fpath_c := fpath_cstr.ptr().unwrap();
  io.await(fs_file.write_string_cstr(fpath_c, "str path test", io), IoExn(io : io, exn : exn));
  unsafe(printf("  write ok\n"));
  s := io.await(fs_file.read_to_string_cstr(fpath_c, io), IoExn(io : io, exn : exn));
  unsafe(printf("  read: %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `str path test`, "content mismatch");
  io.await(fs_dir.remove_file(Path.new(fpath_s), io), IoExn(io : io, exn : exn));
});
test("read returns bytes", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_read_bytes.txt`));
  io.await(fs_file.write_string(fpath, String.from("ABC"), io), IoExn(io : io, exn : exn));
  bytes := io.await(fs_file.read(fpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  bytes len = %lld\n", i64(bytes.len())));
  assert(bytes.len() == usize(3), "expected 3 bytes");
  assert(bytes(usize(0)) == u8(65), "A=65");
  assert(bytes(usize(1)) == u8(66), "B=66");
  assert(bytes(usize(2)) == u8(67), "C=67");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("append_file appends to existing content", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_append.txt`));
  io.await(fs_file.write_string(fpath, String.from("first"), io), IoExn(io : io, exn : exn));
  io.await(fs_file.append_file(fpath, String.from(" second"), io), IoExn(io : io, exn : exn));
  s := io.await(fs_file.read_to_string(fpath, io), IoExn(io : io, exn : exn));
  unsafe(printf("  read: %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `first second`, "append content mismatch");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("exists returns true for existing file", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_exists.txt`));
  io.await(fs_file.write_string(fpath, String.from("exists"), io), IoExn(io : io, exn : exn));
  e := io.await(fs_file.exists(fpath, io), io);
  unsafe(printf("  exists = %d\n", cond(e => i32(1), true => i32(0))));
  assert(e, "file should exist");
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("exists returns false for nonexistent file", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  fpath := Path.new(`/nonexistent/path/yo_fs_no_such_file.txt`);
  e := io.await(fs_file.exists(fpath, io), io);
  unsafe(printf("  exists = %d\n", cond(e => i32(1), true => i32(0))));
  assert(!(e), "file should not exist");
});
// ============================================================================
// File object tests
// ============================================================================
test("File.open write and read_to_string", {
  exn := Exception(
    throw : (
      (err) -> {
        println(`  unexpected error: ${err}`);
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_obj_rw.txt`));
  // Open for writing
  f := io.await(File.open(fpath, .Write, io), IoExn(io : io, exn : exn));
  n := io.await(f.write_string(`file object test`, io), IoExn(io : io, exn : exn));
  unsafe(printf("  wrote %d bytes\n", n));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  // Open for reading
  f2 := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  s := io.await(f2.read_to_string(io), IoExn(io : io, exn : exn));
  unsafe(printf("  read: %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `file object test`, "File read content mismatch");
  io.await(f2.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("File.open nonexistent returns error", {
  fpath := Path.new(`/nonexistent/path/yo_fs_no_such.txt`);
  exn := Exception(
    throw : (
      (err) -> {
        unsafe(printf("  got error as expected\n"));
        unwind(());
      }
    )
  );
  io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  assert(false, "should not open nonexistent file");
});
test("File.size returns correct size", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_size.txt`));
  io.await(fs_file.write_string(fpath, String.from("twelve chars"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  sz := f.size();
  unsafe(printf("  size = %lld\n", sz));
  assert(sz == i64(12), "size should be 12");
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("File.path returns correct path", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_path.txt`));
  io.await(fs_file.write_string(fpath, String.from("x"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open(fpath, .Read, io), IoExn(io : io, exn : exn));
  p := f.path().to_string();
  expected := fpath.to_string();
  unsafe(printf("  path = %s\n", p.to_cstr().ptr().unwrap()));
  assert(p == expected, "path mismatch");
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("OpenMode.CreateNew fails if file exists", {
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_create_new.txt`));
  // Create file first (with success handler)
  setup_exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception during setup");
        unwind(());
      }
    )
  );
  io.await(fs_file.write_string(fpath, String.from("first"), io), IoExn(io : io, exn : setup_exn));
  // Try CreateNew on existing file - should fail
  exn := Exception(
    throw : (
      (err) -> {
        unsafe(printf("  CreateNew correctly failed\n"));
        unwind(());
      }
    )
  );
  io.await(File.open(fpath, .CreateNew, io), IoExn(io : io, exn : exn));
  assert(false, "CreateNew should fail on existing file");
});
test("OpenMode.CreateNew succeeds on new file", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_create_new2.txt`));
  // Ensure doesn't exist
  cond(
    io.await(fs_file.exists(fpath, io), io) => {
      io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
    },
    true => ()
  );
  f := io.await(File.open(fpath, .CreateNew, io), IoExn(io : io, exn : exn));
  unsafe(printf("  CreateNew succeeded\n"));
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
test("File.open_cstr convenience", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  tmp := temp_dir();
  fpath := Path.new(path_join(tmp, `yo_fs_file_open_str.txt`));
  fpath_cstr := fpath.to_string().to_cstr();
  fpath_c := fpath_cstr.ptr().unwrap();
  io.await(fs_file.write_string(fpath, String.from("open_str test"), io), IoExn(io : io, exn : exn));
  f := io.await(File.open_cstr(fpath_c, .Read, io), IoExn(io : io, exn : exn));
  s := io.await(f.read_to_string(io), IoExn(io : io, exn : exn));
  unsafe(printf("  read: %s\n", s.to_cstr().ptr().unwrap()));
  assert(s == `open_str test`, "open_str content mismatch");
  io.await(f.close(io), IoExn(io : io, exn : exn));
  io.await(fs_dir.remove_file(fpath, io), IoExn(io : io, exn : exn));
});
