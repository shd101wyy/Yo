{ assert } :: import("std/assert");
open(import("std/collections/array_list"));
open(import("std/fmt"));
{ Set } :: import("std/imm/set");
test("Set new is empty", {
  s := Set(i32).new();
  assert(s.is_empty(), "new set should be empty");
  assert(s.len() == usize(0), "len should be 0");
});
test("Set insert and contains", {
  s := Set(i32).new();
  s = s.insert(i32(42));
  assert(s.contains(i32(42)), "set should contain 42");
  assert(!s.contains(i32(99)), "set should not contain 99");
  assert(s.len() == usize(1), "len should be 1");
});
test("Set insert duplicate", {
  s := Set(i32).new();
  s = s.insert(i32(1));
  s = s.insert(i32(1));
  assert(s.len() == usize(1), "duplicate insert should not increase len");
  assert(s.contains(i32(1)), "should still contain 1");
});
test("Set insert multiple elements", {
  s := Set(i32).new();
  s = s.insert(i32(1));
  s = s.insert(i32(2));
  s = s.insert(i32(3));
  assert(s.len() == usize(3), "len should be 3");
  assert(s.contains(i32(1)), "contains 1");
  assert(s.contains(i32(2)), "contains 2");
  assert(s.contains(i32(3)), "contains 3");
});
test("Set remove existing element", {
  s := Set(i32).new();
  s = s.insert(i32(10));
  s = s.insert(i32(20));
  s2 := s.remove(i32(10));
  assert(s2.len() == usize(1), "after remove len should be 1");
  assert(!s2.contains(i32(10)), "10 should be removed");
  assert(s2.contains(i32(20)), "20 should remain");
  // original unchanged
  assert(s.len() == usize(2), "original len unchanged");
});
test("Set remove nonexistent element", {
  s := Set(i32).new();
  s = s.insert(i32(1));
  s2 := s.remove(i32(999));
  assert(s2.len() == usize(1), "len unchanged after removing nonexistent");
});
test("Set union", {
  a := Set(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  b := Set(i32).new();
  b = b.insert(i32(2));
  b = b.insert(i32(3));
  c := a.union(b);
  assert(c.len() == usize(3), "union should have 3 elements");
  assert(c.contains(i32(1)), "union contains 1");
  assert(c.contains(i32(2)), "union contains 2");
  assert(c.contains(i32(3)), "union contains 3");
});
test("Set intersection", {
  a := Set(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  a = a.insert(i32(3));
  b := Set(i32).new();
  b = b.insert(i32(2));
  b = b.insert(i32(3));
  b = b.insert(i32(4));
  c := a.intersection(b);
  assert(c.len() == usize(2), "intersection should have 2 elements");
  assert(c.contains(i32(2)), "intersection contains 2");
  assert(c.contains(i32(3)), "intersection contains 3");
  assert(!c.contains(i32(1)), "intersection does not contain 1");
  assert(!c.contains(i32(4)), "intersection does not contain 4");
});
test("Set difference", {
  a := Set(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  a = a.insert(i32(3));
  b := Set(i32).new();
  b = b.insert(i32(2));
  b = b.insert(i32(4));
  c := a.difference(b);
  assert(c.len() == usize(2), "difference should have 2 elements");
  assert(c.contains(i32(1)), "difference contains 1");
  assert(c.contains(i32(3)), "difference contains 3");
  assert(!c.contains(i32(2)), "difference does not contain 2");
});
test("Set is_subset", {
  a := Set(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  b := Set(i32).new();
  b = b.insert(i32(1));
  b = b.insert(i32(2));
  b = b.insert(i32(3));
  assert(a.is_subset(b), "a is subset of b");
  assert(!b.is_subset(a), "b is not subset of a");
  assert(a.is_subset(a), "a is subset of itself");
});
test("Set is_disjoint", {
  a := Set(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  b := Set(i32).new();
  b = b.insert(i32(3));
  b = b.insert(i32(4));
  assert(a.is_disjoint(b), "a and b are disjoint");
  c := Set(i32).new();
  c = c.insert(i32(2));
  c = c.insert(i32(5));
  assert(!a.is_disjoint(c), "a and c are not disjoint");
});
test("Set Eq trait", {
  a := Set(i32).new();
  a = a.insert(i32(1));
  a = a.insert(i32(2));
  b := Set(i32).new();
  b = b.insert(i32(2));
  b = b.insert(i32(1));
  assert(a == b, "sets with same elements should be equal");
  c := Set(i32).new();
  c = c.insert(i32(1));
  assert(!(a == c), "sets with different elements should not be equal");
});
test("Set to_list", {
  s := Set(i32).new();
  s = s.insert(i32(10));
  s = s.insert(i32(20));
  elems := s.to_list();
  assert(elems.len() == usize(2), "to_list should have 2 elements");
});
test("Set structural sharing", {
  s := Set(i32).new();
  s = s.insert(i32(1));
  s = s.insert(i32(2));
  s2 := s.insert(i32(3));
  // original unchanged
  assert(s.len() == usize(2), "original still 2");
  assert(s2.len() == usize(3), "new set has 3");
  assert(!s.contains(i32(3)), "original doesn't have 3");
  assert(s2.contains(i32(3)), "new set has 3");
});
test("Set many elements", {
  (s : Set(i32)) = Set(i32).new();
  (i : i32) = i32(0);
  while(runtime(i < i32(100)), {
    s = s.insert(i);
    i = (i + i32(1));
  });
  assert(s.len() == usize(100), "should have 100 elements");
  assert(s.contains(i32(0)), "contains 0");
  assert(s.contains(i32(50)), "contains 50");
  assert(s.contains(i32(99)), "contains 99");
  assert(!s.contains(i32(100)), "does not contain 100");
});
test("Set from_list single element", {
  arr := [i32 ; 1](i32(42));
  s := Set(i32).from_list(ArrayList(i32).from_array(arr));
  assert(s.len() == usize(1), "len = 1");
  assert(s.contains(i32(42)), "contains 42");
});
test("Set from_list with elements", {
  arr := [i32 ; 4](i32(10), i32(20), i32(30), i32(40));
  s := Set(i32).from_list(ArrayList(i32).from_array(arr));
  assert(s.len() == usize(4), "len = 4");
  assert(s.contains(i32(10)), "contains 10");
  assert(s.contains(i32(30)), "contains 30");
  assert(!s.contains(i32(50)), "does not contain 50");
});
test("Set from_list duplicates", {
  arr := [i32 ; 4](i32(1), i32(2), i32(1), i32(3));
  s := Set(i32).from_list(ArrayList(i32).from_array(arr));
  assert(s.len() == usize(3), "duplicates collapsed");
});
test("Set from_list equals manual insert", {
  arr := [i32 ; 3](i32(1), i32(2), i32(3));
  s1 := Set(i32).from_list(ArrayList(i32).from_array(arr));
  s2 := Set(i32).new().insert(i32(1)).insert(i32(2)).insert(i32(3));
  assert(s1 == s2, "from_list equals manual insert");
});
