//! REGRESSION: `Error.source()` on an erased receiver returned a type that had
//! LOST the `Error` trait, so the result could not be stored back as an
//! `AnyError` — which is what blocked `ErrorChain` / `root_cause`, the last row
//! of plans/archive/STD_API_STABILIZATION.md held up by a defect rather than a decision
//! (issues/fixed/self-trait-in-a-return-type-loses-the-trait-on-an-erased-receiver.md).
//!
//! `source` is declared `fn(inout(self) : Self) -> Option(Dyn(SelfTrait))`, and
//! `SelfTrait` is `Error` there. `TraitT` equality was NOMINAL, and a trait's
//! name is attached EXTERNALLY by its variable binding — `evaluate_trait_type`
//! builds the value with `trait_name_str := String.from("")` and the name
//! arrives afterwards. So the trait captured while it is still being defined is
//! nameless, `"" == "Error"` is false, and a nominal test declared "different
//! trait" about one trait. Identity is now the `id` that `stable_label_id` sets
//! at construction.
//!
//! The walk below is the whole point: it must TYPE-CHECK, not merely run. The
//! value and the vtable were always right — only the static type was wrong, and
//! in the one way that stops the result being re-erased.
{ assert } :: import("std/assert");
{ Error, AnyError, Context, root_cause, error_chain } :: import("std/error");
{ String } :: import("std/string");
{ ToString } :: import("std/fmt/to_string");
_Inner :: enum(Boom);
derive(_Inner, Copy, Clone);
derive(_Inner, Error(.Boom => `boom`));
test("an Error.source() result re-erases as AnyError, so a chain can be walked", {
  (base : AnyError) = dyn(_Inner.Boom);
  (top : AnyError) = dyn(Context.new(`while loading`, base));
  (mut(cur) : AnyError) = top;
  (mut(links) : usize) = usize(1);
  // The assignment `cur = next` is what failed to type-check: `source()` is
  // declared to return `Option(Dyn(SelfTrait))` and this stores it back.
  (mut(walking) : bool) = true;
  while(walking, {
    match(
      cur.source(),
      .Some(next) => {
        cur = next;
        links = (links + usize(1));
      },
      .None => {
        walking = false;
      }
    );
  });
  assert(links == usize(2), `the chain has two links, got ${links.to_string()}`);
  assert(cur.to_string() == `boom`, `the root cause is the inner error, got ${cur.to_string()}`);
});
test("a one-link error reports no source", {
  (c : AnyError) = dyn(_Inner.Boom);
  assert(c.source().is_none(), "an error with nothing underneath has no source");
});
// The defect was never std-specific: ANY user trait declaring a member that
// returns `Dyn(SelfTrait)` hit it, because the nameless-trait capture happens
// while that trait is being defined. This is the shape from
// issues/fixed/dyn-selftrait-payload-never-matches-the-named-trait.md.
_Node :: trait(
  (parent : (fn(self : &mut Self) -> Option(Dyn(SelfTrait)))) ?= (self -> .None),
  where(Self <: ToString)
);
_AnyNode :: Dyn(_Node);
_Root :: struct(tag : String);
impl(_Root, ToString(to_string : (fn(self : &Self) -> String)(`root(${self.tag})`)));
impl(_Root, _Node());
// The parent is built on each call: a `Dyn` owns its payload
// (plans/VALUES_BY_DEFAULT.md decision 7), so a method cannot hand out a copy
// of a `Dyn` field it only borrows.
_Child :: ref(struct(tag : String, up_tag : String));
impl(_Child, ToString(to_string : (fn(self : &Self) -> String)(`child(${self.tag})`)));
impl(_Child, _Node(parent : (fn(self : &mut Self) -> Option(_AnyNode))(Option(_AnyNode).Some(dyn(_Root(tag : self.up_tag.clone()))))));
_handle :: (fn(n : &_AnyNode) -> String)(n.to_string());
test("a user trait's Dyn(SelfTrait) payload binds and passes as Dyn(ThatTrait)", {
  (c : _AnyNode) = dyn(_Child(tag : `C`, up_tag : `R`));
  // Binding the payload into a named local is one half of the defect...
  (bound : String) = match(
    c.parent(),
    .Some(p) => {
      (q : _AnyNode) = p;
      q.to_string()
    },
    .None => `root`
  );
  assert(bound == `root(R)`, `binding the payload lost the trait, got ${bound}`);
  // ...and passing it straight to a parameter is the other.
  (passed : String) = match(c.parent(), .Some(p) => _handle(&p), .None => `root`);
  assert(passed == `root(R)`, `passing the payload lost the trait, got ${passed}`);
});
// A trait's node is minted before its body is evaluated, so a member typed
// over `Dyn(SelfTrait)` embeds the trait while it is still being built. What
// the trait declares AFTER that member must still reach the embedded copy:
// the `Dyn` returned through the first member's type dispatches the LAST
// member and carries the `where(Self <: X)` constraint, and an impl is
// checked against that constraint. The members and constraints live in one
// shared cell (`TraitTBody`, consultation #13 §13); a snapshot taken when the
// first member was evaluated would build a vtable with one slot.
_Chain :: trait(
  (link : (fn(self : &Self) -> Option(Dyn(SelfTrait)))) ?= (self -> .None),
  weight : (fn(self : &Self) -> i32),
  where(Self <: ToString)
);
_AnyChain :: Dyn(_Chain);
_ChainLeaf :: struct(w : i32);
impl(_ChainLeaf, ToString(to_string : (fn(self : &Self) -> String)(`leaf`)));
impl(_ChainLeaf, _Chain(weight : (fn(self : &Self) -> i32)(self.w)));
_ChainLink :: struct(w : i32, leaf_w : i32);
impl(_ChainLink, ToString(to_string : (fn(self : &Self) -> String)(`link`)));
impl(
  _ChainLink,
  _Chain(
    link : (fn(self : &Self) -> Option(_AnyChain))(Option(_AnyChain).Some(dyn(_ChainLeaf(w : self.leaf_w)))),
    weight : (fn(self : &Self) -> i32)(self.w)
  )
);
test("a Dyn(SelfTrait) member's payload dispatches the members and constraints declared after it", {
  (c : _AnyChain) = dyn(_ChainLink(w : i32(2), leaf_w : i32(5)));
  (w : i32) = match(c.link(), .Some(p) => p.weight(), .None => i32(0));
  assert(w == i32(5), `the payload dispatched the last member wrongly, got ${w.to_string()}`);
  (s : String) = match(c.link(), .Some(p) => p.to_string(), .None => String.new());
  assert(s == `leaf`, `the payload lost the where(Self <: ToString) constraint, got ${s}`);
});
test("a trait's where(Self <: X), declared after a Dyn(SelfTrait) member, is checked at an impl", {
  comptime_expect_error({
    _ChainNoStr :: struct(w : i32);
    impl(_ChainNoStr, _Chain(weight : (fn(self : &Self) -> i32)(self.w)));
  }, "does not implement required constraint");
});
test("root_cause returns the innermost error, and is identity on a lone error", {
  // Scored at RUNTIME on the rendered value, not on a comptime assertion:
  // a comptime_assert here could hold vacuously.
  (base : AnyError) = dyn(_Inner.Boom);
  (top : AnyError) = dyn(Context.new(`while loading`, base));
  assert(
    root_cause(&top).to_string() == `boom`,
    `root_cause of a wrapped error is the inner one, got ${root_cause(&top).to_string()}`
  );
  // An error with nothing underneath is its own root cause — never .None, so
  // callers need no unwrapping.
  (lone : AnyError) = dyn(_Inner.Boom);
  assert(
    root_cause(&lone).to_string() == `boom`,
    "root_cause of a lone error is that error"
  );
});

// `error_chain` is the same walk as `root_cause`, yielding every link instead of
// keeping only the last. Its cursor is an `Option(AnyError)` struct FIELD, which
// is a step past what `root_cause` needs (a local) — the field has to survive
// `source()`'s re-erasure across a method boundary.
test("error_chain yields every link, outermost first", {
  (base : AnyError) = dyn(_Inner.Boom);
  (top : AnyError) = dyn(Context.new(`while loading`, base));
  mut(it) := error_chain(&top);
  (mut(links) : usize) = usize(0);
  (mut(last) : String) = String.new();
  (mut(going) : bool) = true;
  while(going, {
    match(
      it.next(),
      .Some(link) => {
        links = (links + usize(1));
        last = link.to_string();
      },
      .None => {
        going = false;
      }
    );
  });
  assert(links == usize(2), `a 2-link chain yields 2 links, got ${links.to_string()}`);
  assert(last == `boom`, `the last link is the root cause, got ${last}`);
});
test("error_chain of a lone error yields exactly one link", {
  mut(it) := error_chain(dyn(_Inner.Boom));
  (mut(links) : usize) = usize(0);
  (mut(going) : bool) = true;
  while(going, {
    match(
      it.next(),
      .Some(_) => {
        links = (links + usize(1));
      },
      .None => {
        going = false;
      }
    );
  });
  assert(links == usize(1), `a lone error is one link, got ${links.to_string()}`);
});
