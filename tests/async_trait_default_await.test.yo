// Regression: a trait `?=` DEFAULT whose body is `io.async(...)` containing an
// `io.await`. `impl.yo`'s per-impl default materialization used to evaluate the
// default body under the IMPL's ambient EvalContext instead of a FUNCTION-BODY
// one, so the body had no expected return type. `io.async`'s Step 6b
// (evaluator/calls/helper.yo) pre-binds the effect-bundle generic `E` FROM that
// expected `Impl(Future(T, E))`; with none, `E` stayed a SomeT, `e.io.await(...)`
// failed to resolve ("No matching call found"), the def-eval-wall swallowed it,
// and codegen emitted a body of `// Failed to transpile` markers — rewritten to
// `abort()` by PR #275, so every arm below used to abort at runtime.
// The same missing context made `return(...)` inside ANY trait default evaluate
// as a plain identifier ("Variable \"return\" not found").
// See issues/fixed/trait-default-awaiting-self-async-method-emits-hollow-fn.md.
{ assert } :: import("std/assert");
{ IoExn, Exception } :: import("std/error");
AsyncReader :: trait(
  read : (fn(self : Self, io : Io) -> Impl(Future(usize, IoExn))),
  // Default 1: ONE await of a `Self` async method, combined with a runtime arg.
  (read_plus : (fn(self : Self, extra : usize, io : Io) -> Impl(Future(usize, IoExn)))) ?=
    (
      (self, extra, io) ->
        io.async(e => {
          a := e.io.await(Self.read(self, io), e);
          a + extra
        })
    ),
  // Default 2: TWO awaits of the same `Self` async method (two await points in
  // one state machine).
  (read_twice : (fn(self : Self, io : Io) -> Impl(Future(usize, IoExn)))) ?=
    (
      (self, io) ->
        io.async(e => {
          a := e.io.await(Self.read(self, io), e);
          b := e.io.await(Self.read(self, io), e);
          a + b
        })
    )
);
/// Sync trait with a `return(...)` in its default body — the second half of the
/// same missing-function-body-context root cause.
Doubler :: trait(
  base : (fn(self : Self) -> usize),
  (dbl : (fn(self : Self) -> usize)) ?= (self -> return(Self.base(self) * usize(2)))
);
Ra :: struct(k : usize);
impl(
  Ra,
  AsyncReader(
    read : (fn(self : Self, io : Io) -> Impl(Future(usize, IoExn)))(io.async(e => self.k))
  )
);
impl(Ra, Doubler(base : (fn(self : Self) -> usize)(self.k)));
Rb :: struct(k : usize);
impl(
  Rb,
  AsyncReader(
    read : (fn(self : Self, io : Io) -> Impl(Future(usize, IoExn)))(io.async(e => (self.k + usize(1))))
  )
);
test("async trait ?= default awaiting a Self async method", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  a := Ra(k : usize(11));
  v := io.await(a.read_plus(usize(13), io), t_e);
  assert(v == usize(24), "Ra.read_plus: 11 + 13");
});
test("async trait ?= default is monomorphized per implementor", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  b := Rb(k : usize(4));
  v := io.await(b.read_plus(usize(3), io), t_e);
  assert(v == usize(8), "Rb.read_plus: (4 + 1) + 3");
});
test("async trait ?= default with two await points", {
  t_exn := Exception(
    throw : (
      err -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  t_e := IoExn(io : io, exn : t_exn);
  a := Ra(k : usize(11));
  b := Rb(k : usize(4));
  va := io.await(a.read_twice(io), t_e);
  vb := io.await(b.read_twice(io), t_e);
  assert(va == usize(22), "Ra.read_twice: 11 + 11");
  assert(vb == usize(10), "Rb.read_twice: 5 + 5");
});
test("trait ?= default body may use return(...)", {
  a := Ra(k : usize(21));
  assert(a.dbl() == usize(42), "Ra.dbl: 21 * 2");
});
