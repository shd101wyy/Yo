open import "std/libc/stdio.yo";
Gc :: import "std/gc";

List :: object(
  value : i32,
  next : Option(Self)
);
impl(List,
  dispose : ((fn(self : Self)-> unit) {
    printf("Disposing List with value %d\n", self.value);
  })
);

form_cycle :: (fn() -> unit) {
  a := List(3, .None);
  b := List(5, .None);

  a.next = .Some(b);
  b.next = .Some(a); // Create a cycle
};

test "Gc initial state", {
  assert(Gc.tracked_count() == 0, "Expected 0 tracked objects at start");
};

test "Test cycle collection", {
  test_list :: (fn() -> unit) {
    form_cycle(); // create cycle
    c := List(7, .None);
    assert(Gc.tracked_count() == 3, "Expected 3 tracked objects before GC");
    Gc.collect(); // manually trigger the GC collection
    assert(Gc.tracked_count() == 1, "Expected 1 tracked object after GC");
  };

  test_list();
};


test "Test freeing many objects", {
  test_leak :: (fn() -> unit) {
    z := List(3, .None);
    y := List(2, .Some(z));
    x := List(1, .Some(y));
  };

  // Run 100 times to accumulate leaks
  i := 0;
  while i < 100, {
    test_leak();
    i = (i + 1);
  };

  assert(Gc.tracked_count() == 0, "Expect no leak from test_leak();");
};