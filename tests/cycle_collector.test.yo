pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ printf } :: import("std/libc/stdio.yo");
Gc :: import("std/gc");
{ ArrayList } :: import("std/collections/array_list");
{ LinkedList } :: import("std/collections/linked_list");
{ HashMap } :: import("std/collections/hash_map");
{ String } :: import("std/string");
{ VList } :: import("./fixtures/owned_buffer.yo");
List :: ref(
  struct(
    value : i32,
    next : Option(Self)
  )
);
impl(
  List,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      unsafe(printf("Disposing List with value %d\n", self.value));
    })
  )
);
form_cycle :: (fn() -> unit)({
  a := List(3, .None);
  b := List(5, .None);
  a.next = .Some(b);
  b.next = .Some(a); // Create a cycle
});
test("Gc initial state", {
  assert(Gc.tracked_count() == 0, "Expected 0 tracked objects at start");
});
test("Test cycle collection", {
  test_list :: (fn() -> unit)({
    form_cycle(); // create cycle
    c := List(7, .None);
    assert(Gc.tracked_count() == 3, "Expected 3 tracked objects before GC");
    Gc.collect(); // manually trigger the GC collection
    assert(Gc.tracked_count() == 1, "Expected 1 tracked object after GC");
  });
  test_list();
});
test("Test freeing many objects", {
  test_leak :: (fn() -> unit)({
    z := List(3, .None);
    y := List(2, .Some(z));
    x := List(1, .Some(y));
  });
  // Run 100 times to accumulate leaks
  mut(i) := 0;
  while(i < 100, {
    test_leak();
    i = (i + 1);
  });
  assert(Gc.tracked_count() == 0, "Expect no leak from test_leak();");
});
// --- New tests for Bug 1: Reachable objects through cycles ---
// Node type with a child pointer (can form cycles)
Node :: ref(
  struct(
    value : i32,
    child : Option(Self)
  )
);
impl(
  Node,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      unsafe(printf("Disposing Node with value %d\n", self.value));
    })
  )
);
test("Live root reaching into cycle - reachable objects preserved", {
  // Bug 1 test: root → b ↔ c cycle. root is live (on stack).
  // After GC, b and c must NOT be freed (reachable from root).
  create_chain_with_cycle :: (fn() -> Node)({
    b := Node(2, .None);
    c := Node(3, .Some(b));
    b.child = .Some(c);
    return(Node(1, .Some(b)));
  });
  do_test :: (fn() -> unit)({
    root := create_chain_with_cycle();
    // root(1), b(2), c(3) — all tracked
    assert(Gc.tracked_count() == u64(3), "Expected 3 tracked objects");
    Gc.collect();
    // All 3 should still be alive (root is live, b and c are reachable from root)
    assert(Gc.tracked_count() == u64(3), "Expected 3 tracked objects after GC (all reachable)");
    // Verify the objects are still accessible (not freed)
    assert(root.value == 1, "root value should be 1");
    inner := root.child;
    match(
      inner,
      .Some(b) => {
        assert(b.value == 2, "b value should be 2");
        match(
          b.child,
          .Some(c) => {
            assert(c.value == 3, "c value should be 3");
          },
          .None => {
            assert(false, "c should exist");
          }
        );
      },
      .None => {
        assert(false, "b should exist");
      }
    );
  });
  do_test();
  // After do_test, root is freed by RC. b ↔ c cycle remains — need GC to collect.
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "All should be freed after scope exit + GC");
});
test("Longer chain into cycle - all reachable objects preserved", {
  // root → a → b → c → b (cycle between b and c)
  create_long_chain :: (fn() -> Node)({
    b := Node(20, .None);
    c := Node(30, .Some(b));
    b.child = .Some(c);
    a := Node(10, .Some(b));
    return(Node(1, .Some(a)));
  });
  do_test :: (fn() -> unit)({
    root := create_long_chain();
    assert(Gc.tracked_count() == u64(4), "Expected 4 tracked objects");
    Gc.collect();
    // All 4 should survive — all reachable from root
    assert(Gc.tracked_count() == u64(4), "Expected 4 after GC (all reachable from root)");
    assert(root.value == 1, "root intact");
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "All freed after scope exit + GC");
});
test("Mixed live and garbage - only garbage collected", {
  // Create two independent structures:
  // 1. live_root → live_child (live, on stack)
  // 2. cycle: a ↔ b (garbage after leaving scope)
  create_garbage_cycle :: (fn() -> unit)({
    a := Node(100, .None);
    b := Node(200, .Some(a));
    a.child = .Some(b);
    // a and b become garbage when this function returns
  });
  do_test :: (fn() -> unit)({
    live_root := Node(1, .None);
    live_child := Node(2, .None);
    live_root.child = .Some(live_child);
    create_garbage_cycle();
    // 4 tracked: live_root, live_child, a(100), b(200)
    assert(Gc.tracked_count() == u64(4), "Expected 4 tracked objects");
    Gc.collect();
    // Only 2 should remain (live_root and live_child); a,b are garbage
    assert(Gc.tracked_count() == u64(2), "Expected 2 after GC (garbage cycle collected)");
    // Verify live objects are intact
    assert(live_root.value == 1, "live_root intact");
    match(
      live_root.child,
      .Some(c) => {
        assert(c.value == 2, "live_child intact");
      },
      .None => {
        assert(false, "live_child should exist");
      }
    );
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "All freed after scope exit + GC");
});
test("Garbage cycle collected while live objects survive", {
  // Yo uses ownership-transfer (move) semantics for .Some(obj) and constructor args.
  // After `garbage_a := Node(2, .Some(live))`, live's RC=1 is owned by garbage_a.child.
  // When garbage_a.child is reassigned, the old .Some(live) is saved to a temp variable
  // that owns live's reference. The garbage cycle (a ↔ b) has only internal references
  // and is correctly collected. live survives because the temp variable owns its RC.
  do_test :: (fn() -> unit)({
    live := Node(1, .None);
    garbage_a := Node(2, .Some(live));
    garbage_b := Node(3, .Some(garbage_a));
    garbage_a.child = .Some(garbage_b);
    // garbage_a ↔ garbage_b cycle (only internal refs → garbage)
    // live's RC=1 is owned by the saved temp from field assignment (not part of cycle)
    assert(Gc.tracked_count() == u64(3), "Expected 3 tracked");
    Gc.collect();
    // garbage_a and garbage_b collected (cycle with only internal refs)
    // live survives (its RC=1 from the saved temp, no cycle edges)
    assert(Gc.tracked_count() == u64(1), "Only live remains after collecting garbage cycle");
    assert(live.value == 1, "live intact after GC");
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "All freed after scope exit + GC");
});
test("Multiple GC passes don't corrupt state", {
  do_test :: (fn() -> unit)({
    root := Node(1, .None);
    // Create and abandon multiple cycles
    mut(i) := 0;
    while(i < 10, {
      a := Node((i * 2) + 100, .None);
      b := Node((i * 2) + 101, .Some(a));
      a.child = .Some(b);
      i = (i + 1);
    });
    // Multiple GC passes
    mut(j) := 0;
    while(j < 5, {
      Gc.collect();
      j = (j + 1);
    });
    // Only root should remain
    assert(Gc.tracked_count() == u64(1), "Only root should remain after multiple GC passes");
    assert(root.value == 1, "root intact after multiple GC passes");
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "All freed after scope exit + GC");
});
test("Self-referential object collected correctly", {
  do_test :: (fn() -> unit)({
    a := Node(42, .None);
    a.child = .Some(a);
    // a points to itself — simplest possible cycle
    assert(Gc.tracked_count() == u64(1), "Expected 1 tracked");
  });
  // After do_test, 'a' stack ref is dropped → RC=1 (self-ref only)
  // Normal RC can't free it (RC never reaches 0), but the cycle should be collectable
  do_test();
  // The self-referential node may or may not have been collected yet
  // (depends on whether RC drop triggered dealloc or it needs GC)
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "Self-referential cycle collected");
});
test("Three-node cycle all garbage", {
  do_test :: (fn() -> unit)({
    a := Node(1, .None);
    b := Node(2, .None);
    c := Node(3, .None);
    a.child = .Some(b);
    b.child = .Some(c);
    c.child = .Some(a);
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "Three-node cycle collected");
});
test("Diamond reference pattern - all reachable", {
  // root → a, root → b, a → shared, b → shared, shared → a (cycle)
  do_test :: (fn() -> unit)({
    shared := Node(4, .None);
    a := Node(2, .Some(shared));
    b := Node(3, .Some(shared));
    shared.child = .Some(a);
    // root has two children: a and b. We'll use List for this since Node only has one child.
    // Instead, just keep a, b, shared on stack and verify GC doesn't collect them.
    assert(Gc.tracked_count() == u64(3), "Expected 3 tracked (a, b, shared)");
    Gc.collect();
    // All on stack → all live
    assert(Gc.tracked_count() == u64(3), "All live — on stack");
    assert(a.value == 2, "a intact");
    assert(b.value == 3, "b intact");
    assert(shared.value == 4, "shared intact");
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "All freed after scope + GC");
});
// --- ref(enum(...)) cycle collection (Phase-4 reference-semantics enums) ---
// A recursive ref(enum) with a direct Self-typed variant field can form an RC
// cycle just like a ref(struct); the cycle collector must reclaim it. (`ENil` is
// the acyclic terminator; the initial `ENil` is freed on each `next` reassign.)
ENode :: ref(
  enum(
    ENil,
    ECons(value : i32, next : Self)
  )
);
test("ref-enum self-referential cycle collected", {
  do_test :: (fn() -> unit)({
    a := ENode.ECons(42, ENode.ENil);
    a.next = a; // a -> a: simplest ref-enum cycle (RC never reaches 0)
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "ref-enum self-referential cycle collected");
});
test("ref-enum two-node cycle all garbage", {
  do_test :: (fn() -> unit)({
    a := ENode.ECons(1, ENode.ENil);
    b := ENode.ECons(2, ENode.ENil);
    a.next = b;
    b.next = a; // a <-> b: two-node ref-enum cycle, unreachable after return
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "ref-enum two-node cycle collected");
});
// A ref(enum) whose recursive edge is wrapped in a value enum — `next :
// Option(Self)`. The collector's traversal must descend INLINE through the
// `Option` to reach the managed `Self` in `.Some` (compositional traverse_value,
// plans/archive/CYCLE_GC_TRACE_HOOKS.md phase 1). `.None` allocates nothing, so the cycle
// is the only allocation and fully reclaims.
ONode :: ref(
  enum(
    ONil,
    OCons(value : i32, next : Option(Self))
  )
);
test("ref-enum Option(Self) self cycle collected", {
  do_test :: (fn() -> unit)({
    a := ONode.OCons(42, .None);
    a.next = .Some(a); // a -> Some(a): cycle through the value-enum edge
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "ref-enum Option(Self) self cycle collected");
});
test("ref-enum Option(Self) two-node cycle all garbage", {
  do_test :: (fn() -> unit)({
    a := ONode.OCons(1, .None);
    b := ONode.OCons(2, .None);
    a.next = .Some(b);
    b.next = .Some(a); // a <-> b through Option(Self), unreachable after return
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "ref-enum Option(Self) two-node cycle collected");
});
// --- container-held self-reference: children : ArrayList(Self) ---
// The recursive edge lives in the ArrayList's malloc'd buffer, which the
// auto-derived field walk can't reach — only the hand-written Trace impl iterates
// it. Detection also requires the Acyclic auto-derive to see THROUGH the buffer
// (ArrayList(LNode) is NOT Acyclic because LNode is not). This is the self-host
// `TypeValue.field_types : ArrayList(Self)` shape.
LNode :: ref(
  struct(
    value : i32,
    children : ArrayList(Self)
  )
);
test("ArrayList(Self) two-node cycle collected", {
  do_test :: (fn() -> unit)({
    a := LNode(1, ArrayList(LNode).new());
    b := LNode(2, ArrayList(LNode).new());
    consume(a.children.push(b)); // a -> b
    consume(b.children.push(a)); // b -> a : cycle through ArrayList(Self)
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "ArrayList(Self) cycle collected");
});
// --- the same through LinkedList(Self): the element sits one cell deeper ---
// LinkedList(LLNode) holds Node(LLNode) cells whose `?*LLNode` element buffer
// is the edge back, so the cycle analysis has to re-root at the Node, see
// through its buffer and recognise the declaration's shell there. It read that
// shell as a dead end, so neither LLNode nor the list cell registered and the
// cycle leaked; Node's own Trace impl was already the right traversal
// (issues/fixed/2026-10-18-a-linkedlist-of-managed-elements-forms-uncollected-cycles.md).
LLNode :: ref(
  struct(
    value : i32,
    children : LinkedList(Self)
  )
);
test("LinkedList(Self) two-node cycle collected", {
  do_test :: (fn() -> unit)({
    a := LLNode(1, LinkedList(LLNode).new());
    b := LLNode(2, LinkedList(LLNode).new());
    consume(a.children.push_back(b)); // a -> list -> node -> b
    consume(b.children.push_back(a)); // b -> list -> node -> a : the cycle
  });
  do_test();
  Gc.collect();
  assert(Gc.tracked_count() == u64(0), "LinkedList(Self) cycle collected");
  assert(Type.can_form_rc_cycle(LLNode), "LLNode is cycle-capable");
  assert(Type.can_form_rc_cycle(LinkedList(LLNode)), "the list cell sits on the cycle");
  assert(!Type.can_form_rc_cycle(LinkedList(i32)), "a list of plain values is no cycle root");
});
// --- dispose resurrection (PEP 442): a dispose that stores a cycle member into
// a live object must keep that member, not free it under the live object's feet
// (issues/fixed/a-dispose-that-resurrects-a-cycle-member-leaves-a-dangling-handle.md).
// The collector used to free the white subgraph even when a dispose had stored
// one of its members into a live object, leaving that object a handle to freed
// memory. The dispose pass is now followed by a re-check: a white cell whose
// trial-deleted count rose, and everything reachable from it, is turned black
// and kept.
// `store` marks the nodes whose dispose writes their `next` into their keeper;
// `accept` is the keeper's flag that lets it (so a later test can refuse).
MNode :: ref(
  struct(
    v : i32,
    next : Option(Self),
    keeper : Option(Self),
    store : bool,
    accept : bool
  )
);
impl(
  MNode,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      if(self.store, {
        match(
          self.keeper,
          .Some(k) => {
            if(k.accept, {
              k.next = self.next;
            });
          },
          .None => ()
        );
      });
    })
  )
);
test("A dispose that resurrects a cycle member leaves no dangling handle", {
  build :: (fn(k : &MNode) -> unit)({
    a := MNode(1, .None, .Some(k), true, false);
    b := MNode(2, .Some(a), .Some(k), true, false);
    a.next = .Some(b); // a <-> b cycle; both unreachable after return
  });
  do_test :: (fn() -> MNode)({
    k := MNode(0, .None, .None, false, true);
    build(&k);
    before := Gc.tracked_count();
    Gc.collect();
    // Deterministic oracle BEFORE any deref of the possibly-dangling handle:
    // k, a and b were all tracked going in, and the disposes stored both a and
    // b into the live k, so all three must still be tracked coming out. Before
    // the fix this read (before - 2): the pair was freed under k's feet.
    assert(Gc.tracked_count() == before, "resurrected cycle members must stay tracked");
    return(k);
  });
  k := do_test();
  match(
    k.next,
    .Some(n) => {
      assert((n.v == 1) || (n.v == 2), "the resurrected node is readable");
      assert(ref_count(n) >= usize(1), "the resurrected node's count is at least 1");
    },
    .None => {
      assert(false, "the keeper must hold the resurrected node");
    }
  );
});
test("A resurrected pair is reclaimed once unreachable again", {
  // Only a's dispose stores (b's `store` is false), so the kept counts come out
  // exact: once the keeper drops the resurrected reference and refuses further
  // stores, the pair is unreachable garbage again and a LATER collection must
  // reclaim it. Relative to the start because the previous test's
  // both-disposes-store shape ends with its pair intentionally leaked (a
  // reference resurrected and then overwritten within one dispose pass keeps a
  // phantom count).
  base := Gc.tracked_count();
  do_test :: (fn() -> MNode)({
    k := MNode(0, .None, .None, false, true);
    build :: (fn(k : &MNode) -> unit)({
      a := MNode(1, .None, .Some(k), true, false);
      b := MNode(2, .None, .Some(k), false, false);
      a.next = .Some(b);
      b.next = .Some(a); // a <-> b, unreachable after return
    });
    build(&k);
    before := Gc.tracked_count();
    Gc.collect();
    // k, a, b tracked before; a's dispose stored b into the live k, so the
    // pair is kept and the count is unchanged.
    assert(Gc.tracked_count() == before, "the stored pair must stay tracked");
    return(k);
  });
  k := do_test();
  match(
    k.next,
    .Some(b) => {
      assert(b.v == 2, "the stored node is b");
      match(
        b.next,
        .Some(a) => {
          assert(a.v == 1, "the whole pair was kept, not just the stored cell");
        },
        .None => {
          assert(false, "b.next must still reach a");
        }
      );
    },
    .None => {
      assert(false, "the keeper must hold the stored node");
    }
  );
  // Drop the resurrected reference and refuse further stores: the pair is
  // unreachable garbage again and a later collection must reclaim it. The clear
  // runs in its own fn because a field reassignment's old-value drop is
  // DEFERRED to the enclosing scope's end -- inline, collect() below would
  // still see k.next's old handle and classify the pair reachable.
  clear :: (fn(kk : &MNode) -> unit)({
    kk.accept = false;
    kk.next = .None;
  });
  clear(&k);
  Gc.collect();
  assert(Gc.tracked_count() == (base + u64(1)), "only the keeper remains after the pair became unreachable again");
});
// A cycle closed only through unique `Box` payloads (V1 step 2): a `Box` is
// part of its owner's value, so the collector must trace its payload in
// place. Before `Box` tracing, `BNode` did not count as cycle-capable and the
// pair leaked (its disposes never ran).
(mut(g_bnode_disposed) : i32) = i32(0);
BNode :: ref(
  struct(
    value : i32,
    hold : Box(Option(Self))
  )
);
impl(
  BNode,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_bnode_disposed = (g_bnode_disposed + i32(1));
    })
  )
);
test("A cycle closed through Box payloads is collected", {
  base := Gc.tracked_count();
  do_test :: (fn() -> unit)({
    a := BNode(1, box(Option(BNode).None));
    b := BNode(2, box(Option(BNode).None));
    a.hold.* = .Some(b); // a -> Box -> b
    b.hold.* = .Some(a); // b -> Box -> a : a cycle
  });
  do_test();
  Gc.collect();
  assert(g_bnode_disposed == i32(2), "both nodes of the Box-closed cycle were disposed");
  assert(Gc.tracked_count() == base, "and are no longer tracked");
});
// A declared `Acyclic` exempts a tree (plans/VALUES_BY_DEFAULT.md §3.12,
// decision 21's trees, whose `TypeValue` is this shape: a reference enum
// whose children are reference nodes): the walk stops at the declaration, so
// its nodes are not cycle candidates and the collector never tracks them.
// (A value enum with `Rc(Self)` children cannot form a cycle at all: an `Rc`
// payload is immutable.)
AcyTree :: ref(enum(Leaf(n : i32), Node(l : Self, r : Self)));
// SAFETY: an AcyTree is built bottom-up and no node is written after
// construction, so no node can reach itself.
impl(AcyTree, Acyclic());
CycTree :: ref(enum(Leaf(n : i32), Node(l : Self, r : Self)));
test("a declared Acyclic tree's nodes are not cycle candidates", {
  comptime_assert(!Type.can_form_rc_cycle(AcyTree), "a declared Acyclic type stops the cycle walk");
  comptime_assert(Type.can_form_rc_cycle(CycTree), "the same shape without the declaration can form a cycle");
  before := Gc.tracked_count();
  t := AcyTree.Node(AcyTree.Leaf(1), AcyTree.Leaf(2));
  assert(Gc.tracked_count() == before, "an AcyTree node is never registered with the collector");
  c := CycTree.Node(CycTree.Leaf(1), CycTree.Leaf(2));
  assert(Gc.tracked_count() > before, "a CycTree node is registered");
  assert(match(t, .Node(_, _) => true, .Leaf(_) => false) && match(c, .Node(_, _) => true, .Leaf(_) => false));
});
// The compiler's own trees declare `Acyclic` the same way: `AstExpr`
// (src/expr.yo), `VcSort` and `VcTerm` (src/verifier/terms.yo). A language
// test cannot import src/, so these replicas copy the node shapes and the
// declaration. Each declared node has an undeclared twin, which pins that the
// declaration, not the shape, takes the node's containers and holders off the
// cycle walk: #1486 made all of them cycle roots
// (issues/fixed/2026-10-18-a-linkedlist-of-managed-elements-forms-uncollected-cycles.md,
// the probe table). A twin's leaf payload differs from its node's: before
// #1501 keyed enum identity on the declaration, two enums of one shape
// shared their container instances, so `ArrayList(RExprTwin)` was served
// `ArrayList(RExpr)` and read as acyclic.
RExpr :: ref(enum(Atom(n : i32), FnCall(func : Self, args : ArrayList(Self))));
// SAFETY: an RExpr is built bottom-up and no `args` list is written after its
// node is built, so no node can reach itself.
impl(RExpr, Acyclic());
RExprTwin :: ref(enum(Atom(n : i64), FnCall(func : Self, args : ArrayList(Self))));
RSort :: ref(enum(BoolS, SeqS(elem : Self), FunS(domain : Self, range : Self)));
// SAFETY: an RSort's only children are `Self` payloads fixed at construction.
impl(RSort, Acyclic());
RTerm :: ref(
  enum(
    Var(name : String, sort : RSort),
    App(args : ArrayList(Self)),
    Quant(sorts : ArrayList(RSort), body : Self, triggers : ArrayList(Self))
  )
);
// SAFETY: as RExpr: each list is filled before its term is built.
impl(RTerm, Acyclic());
RTermTwin :: ref(
  enum(
    Var(id : i64, sort : RSort),
    App(args : ArrayList(Self)),
    Quant(sorts : ArrayList(RSort), body : Self, triggers : ArrayList(Self))
  )
);
// Holders: `SuspensionPoint`'s shape (a node and an optional node list) and
// `VcQuery`'s (a term list and a term). The list field matters: a twin
// holder with only the node field reads false (measured on #1486's binary).
RPoint :: ref(struct(index : usize, expr : RExpr, branch_exprs : Option(ArrayList(RExpr))));
RPointTwin :: ref(struct(index : usize, expr : RExprTwin, branch_exprs : Option(ArrayList(RExprTwin))));
RQuery :: ref(struct(name : String, assumptions : ArrayList(RTerm), goal : RTerm));
RQueryTwin :: ref(struct(name : String, assumptions : ArrayList(RTermTwin), goal : RTermTwin));
test("declared-Acyclic compiler trees keep their containers and holders off the cycle walk", {
  // AstExpr's shape.
  comptime_assert(!Type.can_form_rc_cycle(RExpr), "a declared AstExpr-shaped node");
  comptime_assert(!Type.can_form_rc_cycle(ArrayList(RExpr)), "ArrayList(AstExpr)");
  comptime_assert(!Type.can_form_rc_cycle(ArrayList(ArrayList(RExpr))), "ArrayList(ArrayList(AstExpr))");
  comptime_assert(!Type.can_form_rc_cycle(HashMap(String, ArrayList(RExpr))), "HashMap(String, ArrayList(AstExpr))");
  comptime_assert(!Type.can_form_rc_cycle(RPoint), "SuspensionPoint");
  comptime_assert(!Type.can_form_rc_cycle(ArrayList(RPoint)), "ArrayList(SuspensionPoint)");
  comptime_assert(Type.can_form_rc_cycle(RExprTwin), "the undeclared twin can form a cycle");
  comptime_assert(Type.can_form_rc_cycle(ArrayList(RExprTwin)), "and its list sits on that cycle (AstExpr shape)");
  comptime_assert(Type.can_form_rc_cycle(RPointTwin), "and so does its holder");
  // VcSort's and VcTerm's shapes.
  comptime_assert(!Type.can_form_rc_cycle(RSort), "VcSort");
  comptime_assert(!Type.can_form_rc_cycle(RTerm), "VcTerm");
  comptime_assert(!Type.can_form_rc_cycle(ArrayList(RTerm)), "ArrayList(VcTerm)");
  comptime_assert(!Type.can_form_rc_cycle(RQuery), "VcQuery");
  comptime_assert(Type.can_form_rc_cycle(RTermTwin), "the undeclared term twin can form a cycle");
  comptime_assert(Type.can_form_rc_cycle(ArrayList(RTermTwin)), "and its list sits on that cycle (VcTerm shape)");
  comptime_assert(Type.can_form_rc_cycle(RQueryTwin), "and so does its query");
  // The LinkedList controls stay cycle roots: no declaration covers them.
  comptime_assert(Type.can_form_rc_cycle(LLNode), "LLNode");
  comptime_assert(Type.can_form_rc_cycle(LinkedList(LLNode)), "LinkedList(LLNode)");
  comptime_assert(Type.can_form_rc_cycle(ArrayList(LLNode)), "ArrayList(LLNode)");
  comptime_assert(!Type.can_form_rc_cycle(LinkedList(i32)), "LinkedList(i32)");
  // At run time a declared node and its list never register.
  before := Gc.tracked_count();
  e := RExpr.FnCall(RExpr.Atom(1), ArrayList(RExpr).new());
  assert(Gc.tracked_count() == before, "an RExpr node and its args list are never registered");
  w := RExprTwin.FnCall(RExprTwin.Atom(1), ArrayList(RExprTwin).new());
  assert(Gc.tracked_count() > before, "the twin's node and list are");
  assert(match(e, .FnCall(_, _) => true, .Atom(_) => false) && match(w, .FnCall(_, _) => true, .Atom(_) => false));
});
// A cycle closed through a VALUE that owns a heap buffer (V2b's unique
// buffers, plans/VALUES_BY_DEFAULT.md: after Generation B every collection is
// this shape). The buffer's elements live behind a `?*T` field the inline
// field walk cannot see, so the value implements `Trace` (the gate admits a
// value that owns a buffer) and its holder's walk calls that `trace` in
// place. Before, the gate rejected the impl, and nothing traced the slots.
(mut(g_vnode_disposed) : i32) = i32(0);
VNode :: ref(
  struct(
    value : i32,
    kids : VList(Self)
  )
);
impl(
  VNode,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      g_vnode_disposed = (g_vnode_disposed + i32(1));
    })
  )
);
// A cyclic element type declared on its own, so `VList(VPeer)` is first
// instantiated outside any definition: the trait checker's on-demand
// re-derivation must see the buffer's elements too (`*T` alone reads as
// Acyclic).
VPeer :: ref(
  struct(
    value : i32,
    next : Option(Self)
  )
);
test("A cycle closed through a buffer-owning value's slots is collected", {
  comptime_assert(Type.can_form_rc_cycle(VNode), "the walk sees through the value's buffer to its elements");
  comptime_assert(!Type.impls(VList(VNode), Acyclic), "a value whose buffer holds a cyclic element is not Acyclic");
  comptime_assert(Type.impls(VList(i32), Acyclic), "one whose buffer holds plain data is");
  comptime_assert(!Type.impls(VList(VPeer), Acyclic), "nor one whose buffer holds a separately declared cyclic element");
  base := Gc.tracked_count();
  do_test :: (fn() -> unit)({
    a := VNode(1, VList(VNode).new());
    b := VNode(2, VList(VNode).new());
    a.kids.push(b); // a -> b, through a's buffer
    b.kids.push(a); // b -> a : a cycle
  });
  do_test();
  Gc.collect();
  assert(g_vnode_disposed == i32(2), "both nodes of the buffer-closed cycle were disposed");
  assert(Gc.tracked_count() == base, "and are no longer tracked");
});
test("A value without a buffer still cannot implement Trace", {
  _PlainPair :: struct(a : i32, b : i32);
  comptime_expect_error(
    impl(
      _PlainPair,
      Trace(
        trace : (fn(self : &Self, tracer : GcTracer) -> unit)(())
      )
    ),
    "cannot implement \"Trace\""
  );
});
