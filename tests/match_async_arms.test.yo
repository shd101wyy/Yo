//! Match arms INSIDE io.async bodies — the async state-machine emitter's
//! arm handling (plans/reference/MATCH_PATTERN_MATCHING.md §6 P0): same-variant
//! literal-payload arms share one case with guards (#661 gap 2), and
//! labeled/curly patterns bind (issues/async-match-arm-labeled-destructure-
//! binds-nothing.md, audit A3).
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ args } :: import("std/env");
{ yield } :: import("std/async");
runtime_int :: (fn() -> i32)(i32(args().len()));
Shape :: enum(Circle(radius : i32), Rect(width : i32, height : i32));
derive(Shape, Copy, Clone);
Reading2 :: enum(Code(v : i32), Flag2(v : bool));
derive(Reading2, Copy, Clone);
Lamp :: enum(On, Off);
test("literal payload arms with an await in each arm (#661 gap 2)", {
  n := runtime_int();
  o := Option(bool).Some(!(n == i32(-1))); // Some(true) at runtime
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      o,
      .Some(false) => {
        io.await(yield(io), io);
        i32(200)
      },
      .Some(true) => {
        io.await(yield(io), io);
        i32(100)
      },
      .Some(_) => i32(-1),
      .None => i32(0)
    );
  });
  io.await(task, io);
  assert(result.* == i32(100), "Some(true) must take the true arm inside async");
});
test("int literal payload arms with awaits", {
  n := runtime_int();
  r2 := Reading2.Code(i32(0) - n); // -1 at runtime (n = argv length)
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      r2,
      .Code(-1) => {
        io.await(yield(io), io);
        i32(11)
      },
      .Code(c) => {
        io.await(yield(io), io);
        c
      },
      .Flag2(_) => i32(-3)
    );
  });
  io.await(task, io);
  assert(result.* == i32(11), "the -1 arm must win inside async");
});
test("labeled and curly patterns in await-carrying arms bind (audit A3)", {
  n := runtime_int();
  s := if(n > i32(100), Shape.Circle(i32(1)), Shape.Rect(i32(4), i32(5)));
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      s,
      .Rect({ width, height : h }) => {
        io.await(yield(io), io);
        width * h
      },
      .Circle(radius : r) => {
        io.await(yield(io), io);
        r * r
      }
    );
  });
  io.await(task, io);
  assert(result.* == i32(20), "labeled/curly bindings must be assigned (4 * 5)");
});
test("positional twin of the labeled case still works", {
  n := runtime_int();
  s := if(n > i32(100), Shape.Circle(i32(1)), Shape.Rect(i32(4), i32(5)));
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      s,
      .Rect(w, h) => {
        io.await(yield(io), io);
        w * h
      },
      .Circle(r) => {
        io.await(yield(io), io);
        r * r
      }
    );
  });
  io.await(task, io);
  assert(result.* == i32(20), "positional binds unchanged");
});
// The await-carrying twin of the synchronous nullable-pointer match: a `_` arm
// on an `Option(<ref>)` was a pattern atom the classifier skipped, so the
// `.None` path ran no arm at all.
Parcel :: ref(struct(v : i32));
test("a wildcard arm on a nullable-pointer Option with awaits", {
  n := runtime_int();
  empty := cond((n == i32(-1)) => Option(Parcel).Some(Parcel(v : i32(1))), true => Option(Parcel).None);
  full := Option(Parcel).Some(Parcel(v : n));
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    a := match(
      full,
      .Some(p) => {
        io.await(yield(io), io);
        p.v
      },
      _ => i32(-5)
    );
    b := match(
      empty,
      .Some(p) => {
        io.await(yield(io), io);
        p.v
      },
      _ => {
        io.await(yield(io), io);
        i32(-5)
      }
    );
    result.* = (a + b);
  });
  io.await(task, io);
  assert(result.* == (n - i32(5)), ".Some binds the payload and .None takes the wildcard, inside async");
});
// The await-carrying twin: a nullable-pointer user enum matched with labeled,
// curly and bare-variant arms inside an async body.
Tote :: enum(Bare, Holding(parcel : Parcel));
test("nullable-pointer user enum arms with awaits: labeled, curly, bare", {
  n := runtime_int();
  holding := Tote.Holding(parcel : Parcel(v : (n + i32(2))));
  bare := cond((n == i32(-1)) => Tote.Holding(parcel : Parcel(v : i32(0))), true => Tote.Bare);
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    a := match(
      holding,
      .Holding(parcel : p) => {
        io.await(yield(io), io);
        p.v
      },
      .Bare => i32(-100)
    );
    b := match(
      holding,
      .Holding({ parcel }) => {
        io.await(yield(io), io);
        parcel.v
      },
      .Bare => i32(-100)
    );
    c := match(
      bare,
      .Holding => {
        io.await(yield(io), io);
        i32(-100)
      },
      .Bare => i32(1)
    );
    result.* = (a + b + c);
  });
  io.await(task, io);
  assert(result.* == (((n + i32(2)) * i32(2)) + i32(1)), "labeled and curly bind the payload, a bare arm selects by variant name");
});
// ---------------------------------------------------------------------------
// The GENERAL pattern forms in awaiting arms (plans/reference/MATCH_PATTERN_MATCHING.md
// §4.9): nested variants, or-patterns, guards, constants, ranges, catch-all
// bindings, whole-value `:=`, tuple/struct scrutinees and Rc payloads all
// dispatch through the compiled-arm test chain; the arm bodies keep the
// ordinary cond_branch suspension machinery.
// ---------------------------------------------------------------------------
Inner2 :: enum(A2(v : i32), B2);
derive(Inner2, Copy, Clone);
Outer2 :: enum(Ok2(v : Inner2), Err2(code : i32));
derive(Outer2, Copy, Clone);
test("a nested variant pattern in an awaiting arm", {
  n := runtime_int();
  o := Outer2.Ok2(Inner2.A2(i32(6) + n)); // Ok2(A2(7)) at runtime
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      o,
      .Ok2(.A2(x)) => {
        io.await(yield(io), io);
        x * i32(10)
      },
      .Ok2(.B2) => {
        io.await(yield(io), io);
        i32(-1)
      },
      .Err2(c) => {
        io.await(yield(io), io);
        c
      }
    );
  });
  io.await(task, io);
  assert(result.* == i32(70), "Ok2(A2(7)) must bind x=7 and take the nested arm");
});
test("an or-pattern arm with an await", {
  n := runtime_int();
  r := Reading2.Code(i32(0) - n); // Code(-1) at runtime
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      r,
      (.Code(-1) | .Code(-2)) => {
        io.await(yield(io), io);
        i32(11)
      },
      .Code(c) => {
        io.await(yield(io), io);
        c * i32(2)
      },
      .Flag2(_) => i32(-3)
    );
  });
  io.await(task, io);
  assert(result.* == i32(11), "Code(-1) must take the or-pattern arm");
});
test("a guard arm with an await", {
  n := runtime_int();
  o := Option(i32).Some(i32(7) + n); // Some(8)
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      o,
      (.Some(v) && (v > i32(100))) => {
        io.await(yield(io), io);
        i32(1)
      },
      .Some(v) => {
        io.await(yield(io), io);
        v + i32(100)
      },
      .None => i32(0)
    );
  });
  io.await(task, io);
  assert(result.* == i32(108), "Some(8) must fail the guard and bind v=8");
});
test("a string-constant arm with an await", {
  n := runtime_int();
  tag := String.from("run");
  t2 := tag.clone();
  (t3 : String) = t2;
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      t3,
      "run" => {
        io.await(yield(io), io);
        i32(1)
      },
      _ => {
        io.await(yield(io), io);
        i32(2)
      }
    );
  });
  io.await(task, io);
  assert(result.* == i32(1), "the string constant arm must match");
});
test("a range arm and a catch-all binding with awaits", {
  n := runtime_int();
  v := (i32(42) + n); // 43
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      v,
      (0 ..= 9) => {
        io.await(yield(io), io);
        i32(1)
      },
      (10 ..= 99) => {
        io.await(yield(io), io);
        i32(2)
      },
      other => {
        io.await(yield(io), io);
        other
      }
    );
  });
  io.await(task, io);
  assert(result.* == i32(2), "43 must take the (10 ..= 99) arm");
});
test("a whole-value := binding with an await", {
  n := runtime_int();
  o := Option(i32).Some(i32(5) + n); // Some(6)
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      o,
      (whole := .Some(v)) => {
        io.await(yield(io), io);
        whole.unwrap_or(i32(0)) - v
      },
      .None => i32(0)
    );
  });
  io.await(task, io);
  assert(result.* == i32(0), "whole and v are the same Some(6)");
});
test("a tuple scrutinee with awaiting arms", {
  n := runtime_int();
  t := (i32(3) + n, true); // (4, true)
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      t,
      (0, _) => {
        io.await(yield(io), io);
        i32(0)
      },
      (x, true) => {
        io.await(yield(io), io);
        x * i32(100)
      },
      (x, false) => x
    );
  });
  io.await(task, io);
  assert(result.* == i32(400), "(4, true) must take the second arm");
});
test("a struct pattern with an await", {
  Pt :: struct(x : i32, y : i32);
  n := runtime_int();
  p := Pt(i32(0) + n, i32(9)); // Pt(1, 9)
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      &p,
      Pt(x : 0, y) => {
        io.await(yield(io), io);
        y
      },
      Pt(x, y) => {
        io.await(yield(io), io);
        (x * i32(10)) + y
      }
    );
  });
  io.await(task, io);
  assert(result.* == i32(19), "Pt(1, 9) must take the general struct arm");
});
List2 :: ref(enum(Nil2, Cons2(head : i32, tail : Rc(Self))));
test("a pattern through an Rc payload with an await", {
  n := runtime_int();
  l := List2.Cons2(1, rc(List2.Cons2(i32(2) + n, rc(List2.Nil2))));
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      l,
      .Cons2(1, Rc(.Cons2(second, _))) => {
        io.await(yield(io), io);
        second
      },
      .Cons2(h, _) => {
        io.await(yield(io), io);
        h
      },
      .Nil2 => i32(0)
    );
  });
  io.await(task, io);
  assert(result.* == i32(3), "the nested Rc payload pattern must bind second=3");
});
test("a wrapper pattern Rc(p) with an await (decision 31)", {
  n := runtime_int();
  l := List2.Cons2(1, rc(List2.Cons2(i32(2) + n, rc(List2.Nil2))));
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    result.* = match(
      l,
      .Cons2(1, Rc(.Cons2(second, Rc(.Nil2)))) => {
        io.await(yield(io), io);
        second
      },
      .Cons2(h, Rc(rest)) => {
        io.await(yield(io), io);
        h + match(rest, .Cons2(x, _) => x, .Nil2 => i32(0))
      },
      .Nil2 => i32(0)
    );
  });
  io.await(task, io);
  assert(result.* == i32(3), "Rc(p) through the tail must bind second=3");
});
// `mut` places across an await (plans/VALUES_BY_DEFAULT.md decision 26): a
// place binding is a pointer into the scrutinee, so its task slot holds the
// pointer and the arm reads and writes the scrutinee's own slot after the
// task resumes
// (issues/fixed/a-mut-match-place-binding-cannot-live-across-an-await.md).
_PlacePair :: enum(Both(a : i32, b : String), Neither);
test("a mut match place binding lives across an await", {
  n := runtime_int();
  result := Rc(i32)(0);
  task := io.async((io : Io) => {
    (o : Option(i32)) = .Some(n);
    match(
      &mut o,
      .Some(v) => {
        before := v;
        io.await(yield(io), io);
        v = (v + i32(10));
        io.await(yield(io), io);
        v = (v + before);
      },
      .None => ()
    );
    result.* = match(o, .Some(v) => v, .None => i32(-1));
  });
  io.await(task, io);
  assert(result.* == (i32(10) + (n + n)), "the arm wrote the scrutinee through the place after each resume");
});
test("a mut place of a counted payload is replaced after an await", {
  result := Rc(usize)(0);
  task := io.async((io : Io) => {
    (os : Option(String)) = .Some(String.from("old"));
    (ol : Option(ArrayList(i32))) = .Some(ArrayList(i32).new());
    match(
      &mut os,
      .Some(s) => {
        io.await(yield(io), io);
        s = String.from("renamed");
      },
      .None => ()
    );
    match(
      &mut ol,
      .Some(xs) => {
        xs.push(i32(1));
        io.await(yield(io), io);
        xs.push(i32(2));
      },
      .None => ()
    );
    result.* = (match(&os, .Some(s) => s.len(), .None => usize(0)) + match(&ol, .Some(xs) => xs.len(), .None => usize(0)));
  });
  io.await(task, io);
  assert(result.* == usize(9), "the payloads were replaced and pushed in place");
});
test("several mut places of one arm, and a local borrow scrutinee, across an await", {
  n := runtime_int();
  result := Rc(usize)(0);
  task := io.async((io : Io) => {
    (p : _PlacePair) = .Both(a : n, b : String.from("ab"));
    match(
      &mut p,
      .Both(a, b) => {
        io.await(yield(io), io);
        a = (a + i32(4));
        b = String.from("abcd");
      },
      .Neither => ()
    );
    (o : Option(i32)) = .Some(i32(2));
    cur := &mut o;
    match(
      cur,
      .Some(v) => {
        io.await(yield(io), io);
        v = (v * i32(3));
      },
      .None => ()
    );
    pa := match(&p, .Both(a, b) => (usize(a) + b.len()), .Neither => usize(0));
    result.* = (pa + usize(match(o, .Some(v) => v, .None => i32(0))));
  });
  io.await(task, io);
  assert(result.* == (usize(n) + usize(14)), "every place was written after the resume");
});
test("two interleaved tasks each write their own mut place across awaits", {
  n := runtime_int();
  r1 := Rc(i32)(0);
  r2 := Rc(i32)(0);
  h1 := io.spawn(
    io.async((io : Io) => {
      (o : Option(i32)) = .Some(n);
      match(
        &mut o,
        .Some(v) => {
          (i : i32) = i32(0);
          while(i < i32(5), {
            io.await(yield(io), io);
            v = (v + i32(1));
            i = (i + i32(1));
          });
        },
        .None => ()
      );
      r1.* = match(o, .Some(v) => v, .None => i32(-1));
      return(());
    }),
    io
  );
  h2 := io.spawn(
    io.async((io : Io) => {
      (o : Option(i32)) = .Some(i32(100));
      match(
        &mut o,
        .Some(v) => {
          (i : i32) = i32(0);
          while(i < i32(5), {
            io.await(yield(io), io);
            v = (v - i32(1));
            i = (i + i32(1));
          });
        },
        .None => ()
      );
      r2.* = match(o, .Some(v) => v, .None => i32(-1));
      return(());
    }),
    io
  );
  h1.await(io);
  h2.await(io);
  assert(r1.* == (n + i32(5)), "task 1 wrote its own place");
  assert(r2.* == i32(95), "task 2 wrote its own place");
});
