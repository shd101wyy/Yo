test "Test simple functions", {
  {
    swap :: (fn(a : *(i32), b : *(i32)) -> unit) {
      temp := a.*;
      a.* = b.*;
      b.* = temp;
    };

    x := 5;
    y := 10;
    swap(&(x), &(y));
    assert(x == 10);
    assert(y == 5);   
  };

  {
    add :: (fn(x : i32, y : i32) -> i32)(x + y);

    // Test argument in begin block.
    assert(add({
      a := 12;
      a
    }, {
      b := 13;
      b
    }) == 25);

    // Test backtick function call
    assert((12 `add` 13) == 25);
  };

  {
    // Test 1: Compile-time true condition (should only evaluate first body)
    test1 :: (fn() -> i32)
      cond(
        true => 42,
        false => (1 `div` 0)  // This should never be evaluated due to compile-time true above
      )
    ;

    // Test 2: Compile-time false conditions followed by true
    test2 :: (fn() -> i32)
      cond(
        false => (1 `div` 0), // This should be skipped
        false => (1 `div` 0), // This should be skipped
        true => 100
      )
    ;

    // Test 3: Mixed compile-time and runtime conditions
    test3 :: (fn(x: i32) -> i32)
      cond(
        false => 10,
        (x == 5) => 20, // Runtime condition
        true => 30
      )
    ;

    // Test 4: All runtime conditions
    test4 :: (fn(x: i32, y: i32) -> i32)
      cond(
        (x == 0) => 1,
        (x == 1) => 2,
        (y == 2) => 3,
        true => 4
      )
    ;

    // Test 5: Type compatibility across branches
    test5 :: (fn(flag: i32) -> i32)
      cond(
        (flag == 1) => 100,
        (flag == 2) => 200,
        true => 300
      )
    ;
    
    assert(test1() == 42);
    assert(test2() == 100);

    assert(test3(x : 5) == 20);
    assert(test3(x : 10) == 30);
    
    assert(test4(0, 0) == 1);
    assert(test4(x : 1, 0) == 2);
    assert(test4(2, y : 2) == 3);
    assert(test4(x : 3, y : 3) == 4);

    // Named arguments must be in the same order as the function definition
    compt_expect_error(test4(y : 1, 0));
    compt_expect_error(test4(y : 1, x : 0));
    compt_expect_error(test4(1, x : 0));

    assert(test5(1) == 100);
    assert(test5(flag : 2) == 200);
    assert(test5(100) == 300);
  };

  // function scope
  {
    a := 4;
    MyI32 :: i32;
    // inner scope implicit add
    add2 :: (fn(x : i32, y : i32) -> i32) {
      (z : MyI32) = 13; // Can use the comptime variables from the outer scope
      
      compt_expect_error(x + a, "Cannot use `a` from outer scope");
      // To capture the outer scope variable, we need to use closure.

      (x + z)
    };
  };

  // no runtime value in compt fn
  {
    no_runtime_in_compt_fn :: (fn() -> compt(unit)) {
      // This is a compt function.
      compt_expect_error(
        a : i32 // runtime variable not allowed
      );
      compt_expect_error(
        b := 12 // runtime variable not allowed
      );

      (compt(c) : i32) = 1;
      d :: 13;
    };
  };

  // return self
  {
    ReturnSelf :: (fn() -> compt(Type)) {
      return struct(
        test :: ((fn() -> Self) {
          s := Self();
          return s;
        })
      );
    };

    ReturnSelf();
  };

  // return in different places
  {
    max :: (fn(x: i32, y: i32) -> i32)
      cond(
        (x > y) => {
          return x;
        },
        true => {
          return y;
        };
      )
    ;

    max2 :: (fn(x: i32, y: i32) -> i32) {
      max := 
        cond(
          (x > y) => {
            return x;
          },
          true => y
        );
      return max;
    };

    assert(max(10, 20) == 20);
    assert(max2(30, 15) == 30);

    Color :: enum(Red, Green, Blue);

    color_to_i32 :: (fn(color: Color) -> i32)
      match(color,
        .Red => {
          return 0;
        },
        .Green => {
          return 1;
        },
        .Blue => {
          return 2;
        }
      )
    ;

    color_to_i32_2 :: (fn(color: Color) -> i32) {
      color := match(color,
        .Red => 0,
        .Green => {
          return 1;
        },
        .Blue => {
          return 2;
        }
      );
      return color;
    };

    assert(color_to_i32(.Red) == 0);
    assert(color_to_i32(.Green) == 1);
    assert(color_to_i32(.Blue) == 2);
    assert(color_to_i32_2(.Red) == 0);
    assert(color_to_i32_2(.Green) == 1);
    assert(color_to_i32_2(.Blue) == 2);

    compt_return_in_while :: (fn(compt(flag): bool) -> compt(i32)) {
      while(flag, {
        cond(
          flag => {
            x :: 1;
            return x;
          },
          true => {
            x :: 2;
          }
        );
        return 4;
      });
      
      16
    };

    x :: compt_return_in_while(true);
    y :: compt_return_in_while(false);
    compt_assert(x == 1);
    compt_assert(y == 16);
  };
};

test "Test function default parameters", {
  {
    // Default parameters
    // The default value for a parameter has to be compile-time known.
    MyAdd ::
      (fn( compt(Lhs): Type, 
        (compt(Rhs): Type) ?= Lhs, 
        compt(Output) ?= Lhs
      )-> compt(Module))
      module
        (Self: Type) = Lhs,
        (+): (fn(lhs: Lhs, rhs: Rhs)-> Output)
    ;

    // _ is used as the inferred, not the default value.
    // Default value is only used when the parameter is not provided.
    IntAdd :: MyAdd(i32);
    IntAdd2 :: MyAdd(i32, undefined);
    IntAdd3 :: MyAdd(i32, undefined, undefined);
    BoolAdd :: MyAdd(bool);
    BoolAdd2 :: MyAdd(bool, undefined);
    BoolAdd3 :: MyAdd(bool, undefined, undefined);
  };
};

test "Test callback regular function", {
  use_cb :: (fn(v : i32, cb : (fn(u : i32) -> i32)) -> i32) {
    return cb(v);
  };

  x := use_cb(10, (u)-> (u + 1));
  assert(x == 11);

  y := use_cb(20, (u)-> (u * 2));
  assert(y == 40);
};

test "Test Impl closure callback", {
  use_cb :: (fn(v : i32, cb : (Impl(Fn(u : i32) -> i32))) -> i32) {
    return cb(v);
  };

  a := 2;
  x := use_cb(10, (u) => ((u + 1) + a)); // capture variable 'a'
  assert(x == 13);

  y := use_cb(20, (u) => (u * 2)); // capture nothing
  assert(y == 40);

  b := Box(i32)(5);
  z := use_cb(10, (u) => ((u + 1) + b.*)); // capture variable 'a'
  assert(z == 16);
};

test "Test Dyn closure callback", {
  use_cb :: (fn(v : i32, cb : (Dyn(Fn(u : i32) -> i32))) -> i32) {
    return cb(v);
  };

  a := 2;
  x := use_cb(10, dyn (u) => ((u + 1) + a)); // capture variable 'a'
  assert(x == 13);

  y := use_cb(20, dyn (u) => (u * 2)); // capture nothing
  assert(y == 40);

  b := Box(i32)(5);
  z := use_cb(10, dyn (u) => ((u + 1) + b.*)); // capture variable 'b'
  assert(z == 16);
};

test "Test Dyn closure callback with manual boxing", {
  use_cb :: (fn(v : i32, cb : (Dyn(Fn(u : i32) -> i32))) -> i32) {
    return cb(v);
  };

  a := 2;
  x := use_cb(10, dyn box (u) => ((u + 1) + a)); // capture variable 'a'
  assert(x == 13);

  y := use_cb(20, dyn box (u) => (u * 2)); // capture nothing
  assert(y == 40);

  b := Box(i32)(5);
  z := use_cb(10, dyn box (u) => ((u + 1) + b.*)); // capture variable 'b'
  assert(z == 16);
};

test "Test the `where` scoping in functions", {
  Container :: (fn(compt(T): Type) -> compt(Type))(
    object(
      value : T,

      // This function has where(T <: Eq(T))
      equals :: (fn(
        self: Self, 
        other: T,
        where(T <: Eq(T))
      ) -> bool)(
        self.value == other
      ),

      // This function should NOT have access to Eq(T) 
      // because it doesn't declare where(T <: Eq(T))
      try_equals_without_constraint :: (fn(
        self: Self,
        other: T
      ) -> bool)({
        // This line should fail: T doesn't have Eq(T) in this function's scope
        compt_expect_error(self.value == other);
        return false;
      })
    )
  );
};

test "Test variable name matching C reserved", {
  test_fn :: (fn(errno : i32) -> i32) {
    return errno;
  };

  errno := 2; // This local variable matches C reserved `errno`.
  cond(
    (errno == 2) => "yes",
    true => "no"
  );
  assert(test_fn(errno) == 2);
};

test "Test anonymous struct with type method", {
  x := 1;
  y := 2;

  closure := {
    x,
    y,

    call :: ((fn(self: Self, z : i32) -> i32)
      (self.x + (self.y + z))
    )
  };

  result := closure.call(3);
  assert(result == 6, "Expected 6");
};

test "Test generic functions", {
  {
    id :: (fn(compt(T): Type, val: T) -> T)
      val
    ;

    x := id(i32, 12);
    y := id(f64, 3.14);
    z := id(bool, true);
    b := id(Box(i32), box(123));

    assert(x == 12);
    assert(y == 3.14);
    assert(z == true);
    assert(b.* == 123);
  };

  {
    id :: (fn(compt(T): Type, val: T) -> T) {
      id2 :: (fn(val: T) -> T)(val);
      return id2(val);
    };

    x := id(i32, 12);
    y := id(f64, 3.14);
    z := id(bool, true);
    b := id(Box(i32), box(123));

    assert(x == 12);
    assert(y == 3.14);
    assert(z == true);
    assert(b.* == 123);
  };

  {
    id :: (fn(compt(T): Type, val: T) -> T) {
      id2 :: (fn(compt(X): Type, val: X) -> X) 
        val
      ;
      id2(T, val)
    };

    x := id(i32, 12);
    y := id(f64, 3.14);
    z := id(bool, true);
    b := id(Box(i32), box(123));

    assert(x == 12);
    assert(y == 3.14);
    assert(z == true);
    assert(b.* == 123);
  };

  {
    compt_add :: (fn(x : i32, compt(y) : i32) -> i32)
      (x + y)
    ;
    x := compt_add(1, 1);
    y := compt_add(2, 1);
    z := compt_add(3, 2);
    
    assert(x == 2);
    assert(y == 3);
    assert(z == 5);
  };

  {
    // anonymous function
    id : (fn(forall(T : Type), x : T) -> T);
    id = ((a) -> a);
    assert(id(12) == 12);
    assert(id(true) == true);
    assert(id(3.14) == 3.14);
  };

  {
    // tuple parameter
    tuple_func :: (fn(
      forall(T : Type, Y : Type),
      x : Tuple(T, Y),
      a : T,
      b : Y
    ) -> Tuple(T, Y)) {
      return (a, b);
    };
    t1 := tuple((12, true), 1, false);
    assert(t1.0 == 1);
    assert(t1.1 == false);
  };

  {
    // container struct
    Container :: (fn(compt(T) : Type)-> compt(Type))
      struct(value: T)
    ;

    use_container :: (fn(
      forall(X : Type), 
      c : Container(X), 
      x : X
    ) -> X) {
      return x;
    };

    i32_container_value := Container(i32)(12);
    x11 := use_container(i32_container_value, 13);
    x12 := use_container(Container(i32)(13), 12);
    x13 := use_container(Container(bool)(true), false);

    assert(x11 == 13);
    assert(x12 == 12);
    assert(x13 == false);
  };

  {
    // parameter that contains function type
    generic_fn :: (fn(
      forall(T : Type),
      x : T,
      callback : (fn(v : T)-> T)
    ) -> T)
      callback(x)
    ;

    a := generic_fn(1, (x)-> (x + 1));
    b := generic_fn(true, (x)-> !(x));

    assert(a == 2);
    assert(b == false);
  };
};

test "Test generic function callback", {
  generic_fn :: (fn(forall(T: Type), x: T, callback: (fn(v: T)-> T))-> T)
    callback(x)
  ;
  assert(generic_fn(2, (x) -> (x + 16)) == 18);
};

test "Test 'recur'", {
  {
    factorial :: (fn(x : i32) -> i32)
      cond(
        (x < 1) => 1,
        true => (x * recur(x - 1))
      )
    ;
    assert(factorial(6) == 720);
  };

  {
    factorial :: (fn(x : i32) -> i32) {
      factorial_acc :: (fn(x : i32, acc : i32) -> i32) {
        return cond(
          (x < 1) => acc,
          true => recur(x - 1, acc * x)
        );
      };
      return factorial_acc(x, 1);
    };
    assert(factorial(6) == 720);
  };
};

test "Test compt function", {
  // Runtime only function
  runt_id :: (fn(n : i32) -> i32)(
    n
  );
  
  // Compile-time only function
  compt_id :: (fn(compt(n) : i32) -> compt(i32))(
    n
  );

  {
    n := 5; // runtime
    compt_expect_error(
      result1 :: compt_id(n) // compt, not allowed
    );
    compt_expect_error(
      result2 :: runt_id(n) // cannot assign runtime to comptime
    );
    compt_expect_error(
      result3 := compt_id(n) // cannot assign runtime `n` to compt parameter
    );
    result4 := runt_id(n); // runtime, allowed
  };

  {
    n :: i32(5); // comptime
    result1 :: compt_id(n); // allowed
    compt_expect_error(
      result2 :: runt_id(n)  // cannot assign runtime to comptime
    );
    result3 := compt_id(n);  // allowed
    result4 := runt_id(n);   // allowed
  };

  {
    Point :: struct(
      x: i32,
      y: i32
    );

    p1 :: Point(3, 4);
    p2 :: Point(5, 6);

    p1_x :: p1.x;

    runt_add_points :: (fn(p1: Point, p2: Point)-> Point)
      Point(p1.x + p2.x, p1.y + p2.y)
    ;
    compt_add_points :: (fn(compt(p1): Point, compt(p2): Point)-> compt(Point))
      Point(p1.x + p2.x, p1.y + p2.y)
    ;

    compt_expect_error(
      p3 :: runt_add_points(p1, p2)
    );
    p4 :: compt_add_points(p1, p2); // allowed, comptime
  };
};

test "Test function overloading using module Call", {
  add :: impl {
    add1 :: (fn(x : i32) -> i32) x;
    add2 :: (fn(x : i32, y : i32) -> i32) (x + y);
    add3 :: (fn(x : i32, y : i32, z : i32) -> i32) ((x + y) + z);
    add4 :: (fn(x : i32, y : i32, z : i32, w : i32) -> i32) (((x + y) + z) + w);
    
    Call :: (add1, add2, add3); // Allow calling the module like a function
    export Call;
  };
  assert(add(1) == 1);
  assert(add(2, 3) == 5);
  assert(add(3, 4, 5) == 12);
  compt_expect_error(
    add(4, 5, 6, 7) // This will not work because add4 is not used in "Call".
  );
};

test "Test mutual recursion", {
  // Mutual recursion
  compt(is_even) : (fn(n : i32) -> bool);
  compt(is_odd) : (fn(n : i32) -> bool);

  is_even = _
    cond
      (n == 0) => true,
      true     => is_odd(n - 1)
  ;

  is_odd  = _
    cond
      (n == 0) => false,
      true     => is_even(n - 1)
  ;

  assert(is_even(10) == true);
  assert(is_odd(10) == false);
  assert(is_even(11) == false);
  assert(is_odd(11) == true);
};

