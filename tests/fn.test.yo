test "Test swap 2 numbers", {
  swap :: (fn(a : *(i32), b : *(i32)) -> unit) {
    temp := a.*;
    a.* = b.*;
    b.* = temp;
  };

  x := 5;
  y := 10;
  swap(&(x), &(y));
  assert(x == 10);
  assert(y == 5);
};

test "Test callback function", {
  use_cb :: (fn(v : i32, cb : (fn(u : i32) -> i32)) -> i32) {
    return cb(v);
  };

  x := use_cb(10, (u)-> (u + 1));
  assert(x == 11);

  y := use_cb(20, (u)-> (u * 2));
  assert(y == 40);
};