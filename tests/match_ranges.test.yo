//! Range patterns (plans/MATCH_PATTERN_MATCHING.md P3): `(lo..hi)` is
//! half-open, `(lo..=hi)` inclusive, bounds are compile-time constants.
//! Ranges and constants are intervals (plans/TYPE_SYSTEM_SOUNDNESS.md Phase
//! 4.5): arms covering a fixed-width integer type are exhaustive without `_`.
{ assert } :: import("std/assert");
import("std/fmt");
test("half-open and inclusive ranges", {
  bucket :: (fn(n : i32) -> i32)(
    match(
      n,
      (0 .. 10) => i32(1),
      (10 ..= 19) => i32(2),
      _ => i32(3)
    )
  );
  assert(bucket(0) == i32(1));
  assert(bucket(9) == i32(1));
  assert(bucket(10) == i32(2));
  assert(bucket(19) == i32(2));
  assert(bucket(20) == i32(3));
  assert(bucket(-1) == i32(3));
});
test("negative bounds", {
  sign :: (fn(n : i32) -> i32)(
    match(
      n,
      (-100 .. 0) => i32(-1),
      0 => i32(0),
      other => (other / other)
    )
  );
  assert(sign(-5) == i32(-1));
  assert(sign(0) == i32(0));
  assert(sign(7) == i32(1));
});
test("a range on a u8 payload", {
  Byte :: enum(Of(b : u8), Nope);
  kind :: (fn(x : Byte) -> i32)(
    match(
      x,
      .Of(48 ..= 57) => i32(1),
      .Of(65 ..= 90) => i32(2),
      .Of(_) => i32(0),
      .Nope => i32(-1)
    )
  );
  assert(kind(Byte.Of(u8(50))) == i32(1));
  assert(kind(Byte.Of(u8(70))) == i32(2));
  assert(kind(Byte.Of(u8(200))) == i32(0));
  assert(kind(Byte.Nope) == i32(-1));
});
test("a range with a whole-value binding", {
  clamp :: (fn(n : i32) -> i32)(
    match(
      n,
      (v := (1 ..= 5)) => (v * i32(10)),
      _ => i32(0)
    )
  );
  assert(clamp(3) == i32(30));
  assert(clamp(6) == i32(0));
});
test("ranges on a compile-time scrutinee", {
  K :: i32(42);
  r :: match(
    K,
    (0 .. 10) => i32(1),
    (40 .. 50) => i32(2),
    _ => i32(3)
  );
  assert(r == i32(2));
});
test("ranges covering a fixed-width type need no catch-all", {
  whole :: (fn(m : u8) -> i32)(match(m, (0 ..= 255) => i32(1)));
  assert(whole(u8(0)) == i32(1));
  assert(whole(u8(255)) == i32(1));
  pieces :: (fn(m : i8) -> i32)(
    match(
      m,
      (-128 .. 0) => i32(-1),
      0 => i32(0),
      (1 ..= 127) => i32(1)
    )
  );
  assert(pieces(i8(-128)) == i32(-1));
  assert(pieces(i8(-1)) == i32(-1));
  assert(pieces(i8(0)) == i32(0));
  assert(pieces(i8(127)) == i32(1));
  // A trailing catch-all after complete coverage is still accepted.
  covered :: (fn(m : u8) -> i32)(match(m, (0 ..= 127) => i32(1), (128 ..= 255) => i32(2), _ => i32(3)));
  assert(covered(u8(200)) == i32(2));
  wide :: (fn(m : u64) -> i32)(
    match(
      m,
      (0 .. 9223372036854775808) => i32(1),
      (9223372036854775808 ..= 18446744073709551615) => i32(2)
    )
  );
  assert(wide(u64(5)) == i32(1));
  assert(wide(u64(18446744073709551615)) == i32(2));
});
test("the constants of a fixed-width type need no catch-all", {
  bit :: (fn(b : u8) -> i32)(
    match(
      b & u8(1),
      0 => i32(0),
      1 => i32(1),
      (2 ..= 255) => i32(2)
    )
  );
  assert(bit(u8(4)) == i32(0));
  assert(bit(u8(5)) == i32(1));
});
