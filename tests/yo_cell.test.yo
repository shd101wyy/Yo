pragma(Pragma.SkipWasm32Wasi); // the atomic cell's thread test needs pthreads
pragma(Pragma.AllowUnsafe);
//! The private heap-cell primitives `__yo_cell(V)` and `__yo_atomic_cell(V)`
//! (plans/VALUES_BY_DEFAULT.md §3.5, Generation A): one counted allocation
//! holding `V` behind the RC header, constructed by `__yo_cell(V)(v, alloc)`
//! with `alloc : Option(Allocator)`. V5 moves `Rc`, `Arc` and the `atomic(...)`
//! std types onto them; until then only this file uses them. The safe-file
//! rejection is pinned in tests/safe_code_structural_gates.test.yo.
{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ GlobalAllocator } :: import("std/allocator");
{ Thread } :: import("std/thread");
test("a cell holds its payload, and a copy shares it", {
  c := __yo_cell(i32)(i32(5), .None);
  assert(c.* == i32(5), "the payload");
  d := c;
  assert(d.* == i32(5), "the copy reads the same payload");
  // A cell is a mutable cell, as a `ref` object is: the write is seen
  // through every handle (only the `Rc` wrapper is read-only, decision 46).
  c.* = i32(7);
  assert(d.* == i32(7), "the write is seen through the other handle");
  assert(c.* == i32(7), "and through the first");
});
// Copies of a value holding the cell are counted (a copy of a bare local
// may be elided, decision 27, as for `Rc`).
_CellHolder :: struct(h : __yo_cell(i32), n : i32);
test("ref_count counts the handles of a cell", {
  w := _CellHolder(h : __yo_cell(i32)(i32(1), .None), n : i32(0));
  assert(ref_count(w.h) == usize(1), "a fresh cell has one handle");
  {
    w2 := w;
    assert((ref_count(w.h) == usize(2)) && (ref_count(w2.h) == usize(2)), "a nested-scope copy counts");
  };
  assert(ref_count(w.h) == usize(1), "the nested copy released its count");
});
_read_cell :: (fn(c : &__yo_cell(i32)) -> i32)(c.*);
test("__yo_cell(V) is one type wherever it is spelled", {
  c := __yo_cell(i32)(i32(3), .None);
  assert(_read_cell(&c) == i32(3), "a cell built here is the parameter's type");
  (t : __yo_cell(i32)) = __yo_cell(i32)(i32(4), .None);
  assert(_read_cell(&t) == i32(4), "an annotated local is the same type");
  b := __yo_cell(bool)(true, .None);
  comptime_expect_error(_read_cell(&b));
  comptime_expect_error({
    (u : __yo_cell(i32)) = __yo_atomic_cell(i32)(i32(1), .None);
  });
});
_cell_get :: (fn(generic(T : Type), c : &__yo_cell(T)) -> T)(c.*.clone());
test("a cell of a generic payload type", {
  c := __yo_cell(String)(String.from("cell"), .None);
  assert(_cell_get(&c) == String.from("cell"), "the String payload, through a generic parameter");
  n := __yo_cell(i64)(i64(9), .None);
  assert(_cell_get(&n) == i64(9), "an i64 instantiation of the same generic");
});
// The payload's drop runs once, when the last handle is released.
_CellDropCount :: struct(p : *usize);
impl(
  _CellDropCount,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      unsafe(self.p.* = (self.p.* + usize(1)));
    })
  )
);
test("the last handle's release drops the payload once", {
  drops := usize(0);
  {
    c := __yo_cell(_CellDropCount)(_CellDropCount(p : addr_of(drops)), .None);
    d := c;
    {
      e := d;
      assert(ref_count(e) >= usize(1), "a live handle");
    };
    assert(drops == usize(0), "handles are alive");
    assert(c.*.p == addr_of(drops), "the payload is intact");
  };
  assert(drops == usize(1), `dropped once: ${drops}`);
});
test("an atomic cell is counted atomically and shared across a thread", {
  shared := __yo_atomic_cell(i32)(i32(42), .None);
  t := Thread(unit).spawn(io => {
    assert(shared.* == i32(42), "the worker reads the cell");
  });
  t.join();
  assert(shared.* == i32(42), "the owner still reads it");
  assert(ref_count(shared) == usize(1), "the worker's handle was released");
});
// --- The allocator argument ---
// A counting allocator: forwards to the global allocator and counts the
// blocks it holds (`live`) and the alloc/realloc requests it served.
_Counts :: struct(live : usize, requests : usize);
_count_alloc :: (fn(ctx : ?*void, size : usize, align : usize) -> ?*void)({
  c := (*_Counts)(ctx.unwrap());
  unsafe(c.*.live = (c.*.live + usize(1)));
  unsafe(c.*.requests = (c.*.requests + usize(1)));
  GlobalAllocator.malloc(size)
});
_count_realloc :: (fn(ctx : ?*void, ptr : ?*void, old_size : usize, new_size : usize, align : usize) -> ?*void)({
  c := (*_Counts)(ctx.unwrap());
  unsafe(c.*.requests = (c.*.requests + usize(1)));
  cond(
    ptr.is_none() => {
      unsafe(c.*.live = (c.*.live + usize(1)));
    },
    true => ()
  );
  GlobalAllocator.realloc(ptr, new_size)
});
_count_free :: (fn(ctx : ?*void, ptr : ?*void, size : usize, align : usize) -> unit)({
  cond(
    ptr.is_some() => {
      c := (*_Counts)(ctx.unwrap());
      unsafe(c.*.live = (c.*.live - usize(1)));
    },
    true => ()
  );
  GlobalAllocator.free(ptr);
});
_COUNT_VTABLE := AllocatorVTable(alloc : _count_alloc, realloc : _count_realloc, free : _count_free);
_counts :: (fn() -> _Counts)(_Counts(live : usize(0), requests : usize(0)));
// An `Allocator` over `c`, which must outlive every block it hands out.
_counting :: (fn(c : *_Counts) -> Allocator)(Allocator(ctx : .Some((*void)(c)), vtable : addr_of(_COUNT_VTABLE)));
test("alloc : .Some(a) places the cell in a, and .None is global", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  {
    a := __yo_cell(i32)(i32(5), .Some(heap));
    assert(counts.live == usize(1), `the cell is in the allocator: ${counts.live}`);
    assert(ref_count(a) == usize(1), "ref_count never reports the allocator tag");
    g := __yo_cell(i32)(i32(6), .None);
    assert(counts.live == usize(1), "a .None cell is on the global allocator");
    s := __yo_atomic_cell(i32)(i32(7), .None);
    assert(counts.live == usize(1), "a .None atomic cell is on the global allocator");
    assert(((a.* + g.*) + s.*) == i32(18), "the payloads");
  };
  assert(counts.live == usize(0), "the last drop released the placed cell into the allocator");
});
// An allocator whose `alloc` itself allocates
// (issues/retired/2026-10-21-should-allocator-callbacks-run-outside-the-allocation-scope.md):
// the cell calls `a`'s vtable directly, as `box` does, so the callback's own
// `ArrayList` goes to the global heap instead of recursing into `a`.
_ReentCounts :: struct(allocs : usize, frees : usize);
_reent_alloc :: (fn(ctx : ?*void, size : usize, align : usize) -> ?*void)({
  c := (*_ReentCounts)(ctx.unwrap());
  unsafe(c.*.allocs = (c.*.allocs + usize(1)));
  mut(scratch) := ArrayList(usize).new();
  scratch.push(size);
  GlobalAllocator.malloc(size)
});
_reent_realloc :: (fn(ctx : ?*void, ptr : ?*void, old_size : usize, new_size : usize, align : usize) -> ?*void)(GlobalAllocator.realloc(ptr, new_size));
_reent_free :: (fn(ctx : ?*void, ptr : ?*void, size : usize, align : usize) -> unit)({
  c := (*_ReentCounts)(ctx.unwrap());
  unsafe(c.*.frees = (c.*.frees + usize(1)));
  GlobalAllocator.free(ptr);
});
test("an allocator whose callback allocates does not recurse", {
  vt := AllocatorVTable(alloc : _reent_alloc, realloc : _reent_realloc, free : _reent_free);
  counts := _ReentCounts(allocs : usize(0), frees : usize(0));
  a := Allocator(ctx : .Some((*void)(addr_of(counts))), vtable : addr_of(vt));
  {
    c := __yo_cell(i32)(i32(1), .Some(a));
    d := __yo_atomic_cell(i32)(i32(2), .Some(a));
    assert((c.* + d.*) == i32(3), "both payloads");
    assert(counts.allocs == usize(2), `one allocation through a per cell: ${counts.allocs}`);
  };
  assert(counts.frees == usize(2), `both cells were released through a: ${counts.frees}`);
});
// --- What V5 builds on the primitive: a wrapper whose only field is the cell ---
_WrapRc :: (fn(comptime(V) : Type) -> comptime(Type))(
  struct(
    _cell : __yo_cell(V)
  )
);
_wrap_rc :: (fn(generic(V : Type), value : V, (alloc : Option(Allocator)) ?= .None) -> _WrapRc(V))(
  _WrapRc(V)(_cell : __yo_cell(V)(value, alloc))
);
test("a wrapper over the cell: generic construction with the allocator, copy, count", {
  counts := _counts();
  heap := _counting(addr_of(counts));
  {
    w := _wrap_rc(i32(11), alloc : .Some(heap));
    assert(counts.live == usize(1), "the wrapper's cell is in the allocator");
    v := w;
    assert(v._cell.* == i32(11), "the payload through the copy");
    assert(ref_count(w._cell) == usize(2), `the copy shares the cell: ${ref_count(w._cell)}`);
    s := _wrap_rc(String.from("text"));
    assert(s._cell.* == String.from("text"), "a String payload on the global allocator");
  };
  assert(counts.live == usize(0), "the wrapper's cell was released into the allocator");
});
test("the payload moves out of the only handle (V5's try_unwrap)", {
  drops := usize(0);
  c := __yo_cell(_CellDropCount)(_CellDropCount(p : addr_of(drops)), .None);
  assert(ref_count(c) == usize(1), "the only handle");
  payload := __yo_ptr_read(addr_of(c.*));
  __yo_rc_forget_payload(&c);
  assert(payload.p == addr_of(drops), "the payload moved out");
  assert(drops == usize(0), "the cell no longer drops it");
});
// A cell is a cycle-collector node when its payload can reach a cell
// (plans/VALUES_BY_DEFAULT.md §3.5): a node that points back at itself
// through a cell compiles with its traversal and is released.
_CellNode :: ref(
  struct(
    value : i32,
    next : Option(__yo_cell(Self))
  )
);
test("a cell of a cyclic payload type", {
  n := _CellNode(value : i32(1), next : .None);
  c := __yo_cell(_CellNode)(n, .None);
  assert(c.*.value == i32(1), "the node through the cell");
  assert(c.*.next.is_none(), "no edge yet");
  // `__yo_cell(_CellNode)` written here and the field's `__yo_cell(Self)`
  // are one type: the cell stores into the field.
  m := _CellNode(value : i32(2), next : .Some(c));
  assert(match(m.next, .Some(x) => x.*.value, .None => i32(0)) == i32(1), "the edge reaches the first node");
});
// The same through a value struct, whose field type is spelled with `Self`:
// a cell built outside the declaration from the type's name is the field's
// type (two ids for the two spellings gave two C types, and the store
// failed in the C compiler).
_CellList :: struct(
  value : i32,
  next : Option(__yo_cell(Self))
);
_cell_list_next :: (fn(l : &_CellList) -> i32)(match(l.next, .Some(x) => x.*.value, .None => i32(-1)));
test("__yo_cell(Self) in a declaration and __yo_cell(T) after it are one type", {
  a := _CellList(value : i32(1), next : .None);
  b := _CellList(value : i32(2), next : .Some(__yo_cell(_CellList)(a, .None)));
  assert(_cell_list_next(&b) == i32(1), "the field holds the cell built from the name");
  (c : __yo_cell(_CellList)) = __yo_cell(_CellList)(b, .None);
  d := _CellList(value : i32(3), next : .Some(c));
  assert(_cell_list_next(&d) == i32(2), "an annotated cell stores into the field too");
  assert(match(d.next, .Some(x) => _cell_list_next(&x.*), .None => i32(0)) == i32(1), "two edges deep");
});
// --- What the primitive rejects ---
test("a payload that exists only at compile time is rejected", {
  comptime_expect_error(__yo_cell(Type)(i32, .None), "exists only at compile time");
  comptime_expect_error(__yo_atomic_cell(comptime_int)(1, .None), "exists only at compile time");
});
test("__yo_cell and __yo_atomic_cell are reserved builtin names", {
  // A binding of either name would be hijacked by the type builtin at every
  // call.
  comptime_expect_error(__yo_cell := 1, "names a builtin");
  comptime_expect_error(__yo_atomic_cell :: (fn(x : i32) -> i32)(x), "names a builtin");
});
