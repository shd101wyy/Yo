// NOT WORKING YET

open import "std/libc/stdio";
Thread :: import "std/thread";

// Low-level runtime types and functions
extern "Yo",
  __yo_worker_t : Type,
  
  __yo_worker_spawn_local : (fn(
    callback : (fn(self : *(__yo_worker_t), closure: *(void)) -> unit),
    closure : ?*(void)
  ) -> *(__yo_worker_t)),
  
  __yo_worker_join : (fn(worker : *(__yo_worker_t)) -> unit),
  __yo_worker_is_other_alive : (fn(worker : *(__yo_worker_t)) -> bool),
  __yo_worker_dup : (fn(worker : *(__yo_worker_t)) -> unit),
  __yo_worker_drop : (fn(worker : *(__yo_worker_t)) -> unit)
;

// High-level typed Worker abstraction
// Worker(SendType, ReceiveType) - parent sends SendType, receives ReceiveType
// Child gets Worker(ReceiveType, SendType) - types are flipped
Worker :: (fn(compt(SendType) : Type, compt(ReceiveType) : Type) -> compt(Type)) {
  Child :: recur(ReceiveType, SendType);

  return object(
    raw : *(__yo_worker_t),
    
    is_other_alive :: (fn(self : *(Self)) -> bool)({
      return __yo_worker_is_other_alive(self.raw);
    }),
    
    join :: (fn(self : *(Self)) -> unit)({
      return __yo_worker_join(self.raw);
    }),
    
    // Spawn a local worker on a dedicated OS thread
    // Parent gets Worker(SendType, ReceiveType)
    // Child callback receives Worker(ReceiveType, SendType) (flipped!)
    spawn_local :: (fn(
      callback : (fn(child : Child) -> unit)
    ) -> Self)({
      // Create a closure struct to hold the user's callback
      Closure :: struct(
        user_callback : (fn(child : Child) -> unit)
      );
      
      // Wrapper function that the C runtime will call
      wrapper :: (fn(raw_worker : *(__yo_worker_t), closure_ptr : *(void)) -> unit)({
        // Cast the closure pointer back to our Closure type
        closure := (*(Closure))(closure_ptr);
        
        // Wrap the raw worker in the typed Worker(ReceiveType, SendType)
        // Note: types are flipped for the child's view!
        child_worker := Child(raw_worker);
        
        // Call the user's callback
        closure.user_callback(child_worker);
      });
      
      // Allocate the closure on heap
      closure := __yo_alloc(Closure);
      closure.user_callback = callback;
      
      // Spawn with our wrapper and closure
      raw := __yo_worker_spawn_local(wrapper, .Some(cast(*(void), closure)));
      
      Self(raw)
    }),
    
    drop :: (fn(self : *Self) -> unit)({
      __yo_worker_drop(self.raw);
    })
  );
};

main :: (fn() -> unit) {
  printf("Main: thread id %zu\n", Thread.get_thread_id());
  
  // Spawn a typed worker
  // Parent: sends i32, receives bool
  // Child: sends bool, receives i32 (flipped)
  worker := Worker(i32, bool).spawn_local((child) -> {
    printf("Child: spawned at thread id %zu\n", Thread.get_thread_id());
    printf("Child: parent alive = %d\n", child.is_other_alive());
    printf("Child: exiting\n");
  });
  
  printf("Main: worker spawned, joining...\n");
  worker.join();
  
  printf("Main: child alive after join = %d\n", worker.is_other_alive());
  
  worker.drop();
  printf("Main: done\n");
};

export main;

