pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ platform, Platform } :: import("std/process");
{ env } :: import("std/env");
temp_dir :: (fn() -> String)(
  cond(
    (platform == Platform.Windows) => {
      temp := env.get(`TEMP`);
      match(
        temp,
        .Some(v) => v,
        .None => {
          tmp := env.get(`TMP`);
          match(
            tmp,
            .Some(v2) => v2,
            .None => `C:\\Temp`
          )
        }
      )
    },
    true => {
      tmp := env.get(`TMPDIR`);
      match(
        tmp,
        .Some(v) => v,
        .None => {
          tmp2 := env.get(`TMP`);
          match(
            tmp2,
            .Some(v2) => v2,
            .None => `/tmp`
          )
        }
      )
    }
  )
);
export(temp_dir);
path_join :: (fn(base : String, name : String) -> String)({
  sep := cond(
    (platform == Platform.Windows) => `\\`,
    true => `/`
  );
  cond(
    base.ends_with(sep) => `${base}${name}`,
    true => `${base}${sep}${name}`
  )
});
export(path_join);
