// Module A: exports Color before importing B,
// then USES Shape from B in a struct definition (rather than re-exporting it).
Color :: enum(Red, Green, Blue);
derive(Color, Copy, Clone);
export(Color);
{ Shape } :: import("./circular_use_b.yo");
ColoredShape :: struct(color : Color, shape : Shape);
derive(ColoredShape, Copy, Clone);
export(ColoredShape);
