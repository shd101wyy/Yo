// Regression tests for issues/fixed/inline-builtin-alias-drops-body-arguments.md.
//
// Codegen ELIDES a function whose body is a single call to a builtin "inline"
// function (`__yo_op_add`, `__yo_ms_sleep`, …) and emits that builtin at the
// CALL SITE with the caller's already-generated argument codes. That textual
// substitution is only sound when the wrapper passes its parameters straight
// through, in order. Before the fix, `is_function_value_with_only_builtin_yo_
// inline_function_call` (src/codegen/utils/index.yo) checked the callee NAME
// alone, so every wrapper that COMPUTED anything from its parameters had that
// computation silently discarded — no diagnostic, wrong answer.
//
// These assertions run at RUNTIME on values the compiler cannot fold (the
// inputs come from a mutable local), because a comptime-folded assertion goes
// through the evaluator and never exercises the codegen path under test.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
/// Computed argument: the `+ 1` is what used to disappear.
add_with_bump :: (fn(a : i32, b : i32) -> i32)(__yo_op_add(a, b + i32(1)));
/// Reordered parameters: `b - a`, not `a - b`.
sub_reversed :: (fn(a : i32, b : i32) -> i32)(__yo_op_sub(b, a));
/// The shape that MUST keep being inlined — a straight pass-through alias, the
/// form all of prelude's operator aliases use.
add_passthrough :: (fn(a : i32, b : i32) -> i32)(__yo_op_add(a, b));
test("inline-builtin alias keeps a computed argument", {
  (x : i32) = i32(10);
  (y : i32) = i32(3);
  // 10 + (3 + 1) = 14. The bug emitted `((10) + (3))` = 13.
  assert(add_with_bump(x, y) == i32(14));
});
test("inline-builtin alias keeps its parameter order", {
  (x : i32) = i32(10);
  (y : i32) = i32(3);
  // b - a = 3 - 10 = -7. The bug emitted `((10) - (3))` = 7.
  assert(sub_reversed(x, y) == i32(-7));
});
test("a straight pass-through alias still computes correctly", {
  (x : i32) = i32(10);
  (y : i32) = i32(3);
  assert(add_passthrough(x, y) == i32(13));
});
// issues/fixed/2026-11-14-an-inline-builtin-alias-that-derefs-its-reference-parameter-emits-a-type-as-the-operand.md:
// a wrapper that passes the deref of its reference parameter, `addr_of(m.*)`
// (the Generation B spelling of the prelude's `MaybeUninit.as_ptr` body), is
// still a pass-through alias, since `&(*m)` is `m`. Before the fix it was
// emitted as a function, and the builtin's direct emission printed its
// operand 0, the type argument, as the pointer: `return ((int32_t*)(__yo_t_…));`
// failed in the C compiler.
_AliasMu :: MaybeUninit(i32);
/// A pass-through alias: the type arguments are bare names, as the prelude's
/// `Self`/`BaseType` are.
_uninit_ptr :: (fn(m : &mut MaybeUninit(i32)) -> *i32)(
  __yo_maybe_uninit_as_ptr(_AliasMu, i32, addr_of(m.*))
);
/// Not an alias (`k` is not forwarded): the builtin is emitted directly, with
/// the type arguments as its first operands.
_uninit_ptr_direct :: (fn(m : &mut MaybeUninit(i32), k : i32) -> *i32)(
  __yo_maybe_uninit_as_ptr(_AliasMu, i32, addr_of(m.*))
);
/// A projection alias in the same spelling: the call is the element's place
/// (issues/fixed/2026-11-14-a-reference-returning-inline-builtin-alias-call-reads-the-address-as-the-value.md).
_arr_at :: (fn(a : &Array(i32, 4), i : usize) -> &i32)(
  __yo_array_index(addr_of(a.*), i)
);
test("an inline-builtin alias over `addr_of(p.*)` of a reference parameter compiles and writes through", {
  mut(u) := MaybeUninit(i32).new();
  p := _uninit_ptr(&mut u);
  unsafe(p.* = i32(41));
  assert(u.assume_init(p) == i32(41));
  mut(w) := MaybeUninit(i32).new();
  q := _uninit_ptr_direct(&mut w, i32(0));
  unsafe(q.* = i32(7));
  assert(w.assume_init(q) == i32(7));
});
test("a reference-returning inline-builtin alias call is the element's place", {
  arr := Array(i32, 4)(i32(1), i32(2), i32(3), i32(4));
  (j : usize) = usize(2);
  assert(_arr_at(&arr, j).* == i32(3));
  assert(arr.index(j).* == i32(3));
  assert((arr.index(j).* + i32(1)) == i32(4));
  c := arr.index(j).*;
  assert(c == i32(3));
  mut(m) := Array(i32, 4)(i32(1), i32(2), i32(3), i32(4));
  m.index_mut(j).* = i32(9);
  assert(m(j) == i32(9));
});
