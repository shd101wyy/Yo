// Fixture for tests/forwarded_closure_param_spec.test.yo: helpers that FORWARD
// an `Impl(Fn)` parameter into one shared function, from another module.
{ String } :: import("std/string");
Lv :: enum(A, B, C);
on :: (fn(imm(lv) : Lv) -> bool)(
  match(
    lv,
    .A => false,
    _ => true
  )
);
// Returns the message when the level is on, empty otherwise — so a test can
// see WHICH closure ran.
inner :: (fn(imm(lv) : Lv, imm(make) : Impl(Fn() -> String)) -> String)(
  cond(
    on(lv) => make(),
    true => String.new()
  )
);
outer_a :: (fn(imm(make) : Impl(Fn() -> String)) -> String)(inner(Lv.A, make));
outer_b :: (fn(imm(make) : Impl(Fn() -> String)) -> String)(inner(Lv.B, make));
outer_c :: (fn(imm(make) : Impl(Fn() -> String)) -> String)(inner(Lv.C, make));
export(Lv, inner, outer_a, outer_b, outer_c);
