open import "std/libc/stdio.yo";
{ GlobalAllocator } :: import "std/allocator.yo";

Id :: module(
  id : (fn(self : Self) -> Self)
);

use_id :: (fn(
  forall(T : Type),
  value : T,
  where(T <: Id)
) -> T) {
  // (T <: Id).id(value);
  return value.id();
};

impl(i32, Id(
  id : ((self) -> {
    printf("i32 value: %d\n", self);
    return self;
  })
));

impl(boolean, Id(
  id : ((self) -> {
    cond(
      self => printf("boolean value: true\n"),
      true => printf("boolean value: false\n")
    );
    return self;
  })
));

impl(Box(i32), Id(
  id : ((self) -> {
    printf("Boxed i32 value: %d\n", self.*);
    return self;
  })
));

test "Test impl for i32, boolean, Box(i32)", {
  i := 42;
  t := true;
  f := false;
   
  bi := Box(i32)(100);
   
  assert(use_id(i) == i, "use_id should return the same i32 value");
  assert(use_id(t) == t, "use_id should return the same boolean value");
  assert(use_id(f) == f, "use_id should return the same boolean value");
   
  bi_ret := use_id(bi);
  assert(bi_ret.* == bi.*, "use_id should return the same Boxed i32 value");

  assert(use_id(bi).* == bi.*, "use_id should return the same Boxed i32 value");
};
