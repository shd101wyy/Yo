// Regression tests for FORWARDED `Impl(Fn(...))` parameters — a closure param
// passed through one or more call hops before being called.
//
// The bug class (issues/fixed/yo-self-stage2-get-type-string-cycle.md): every
// forwarding hop specialized the callee on the caller's bare declared SomeT
// id, so the def-era TYPE-ERASED specialization (param rendered `void*`)
// collided in the spec cache with the resolved-era call whose argument
// resolves to the concrete capture struct — clang then rejected
// `(void*)(<capture struct value>)` (the stage-2 dyn-capture cluster), or the
// wrong spec silently returned zeroes. Fixed by resolving spec ARG types
// through the SomeT resolution chain (`_spec_resolve_arg_ty`), refusing
// abstract-vs-concrete spec-cache matches, and skipping the degenerate
// capbind self-registration (src/evaluator/calls/helper.yo).
{ assert } :: import("std/assert");
import("std/string");
import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
test("Test single-hop forwarded closure param", {
  walk1 :: (
    fn(depth : i32, get_info : &Impl(Fn(k : i32) -> i32), acc : &mut ArrayList(i32)) -> unit
  )({
    if(depth <= i32(0), {
      return(());
    });
    acc.push(get_info(depth));
    recur(depth - i32(1), get_info, acc);
  });
  analyze1 :: (
    fn(depth : i32, get_info : &Impl(Fn(k : i32) -> i32)) -> ArrayList(i32)
  )({
    out := ArrayList(i32).new();
    walk1(depth, get_info, &mut out);
    out
  });
  tbl := ArrayList(i32).new();
  tbl.push(i32(100));
  r := analyze1(i32(2), (k : i32) => (match(tbl.get(usize(0)), .Some(v) => v, .None => i32(0)) + k));
  assert(r.len() == usize(2), "walk should push once per depth level");
  assert(match(r.get(usize(0)), .Some(v) => v, .None => i32(0)) == i32(102), "first push is get_info(2) = 100 + 2");
  assert(match(r.get(usize(1)), .Some(v) => v, .None => i32(0)) == i32(101), "second push is get_info(1) = 100 + 1");
});
test("Test two-hop forwarded closure param with dyn-capturing detector", {
  Detector :: ref(struct(detect : Dyn(Fn(k : i32) -> i32)));
  walk2 :: (
    fn(depth : i32, get_info : &Impl(Fn(k : i32) -> i32), det : &Detector, acc : &mut ArrayList(i32)) -> unit
  )({
    if(depth <= i32(0), {
      return(());
    });
    acc.push(get_info(depth));
    acc.push(det.detect(depth));
    recur(depth - i32(1), get_info, det, acc);
  });
  analyze2 :: (
    fn(depth : i32, get_info : &Impl(Fn(k : i32) -> i32)) -> ArrayList(i32)
  )({
    out := ArrayList(i32).new();
    extras := ArrayList(i32).new();
    extras.push(i32(7));
    // The detector's dyn closure captures the SAME forwarded closure param —
    // the shape suspension-analysis uses (get_info captured by the detect
    // callback while ALSO being forwarded onward).
    det := Detector(
      detect : dyn((k : i32) => (get_info(k) + match(extras.get(usize(0)), .Some(v) => v, .None => i32(0))))
    );
    walk2(depth, get_info, &det, &mut out);
    out
  });
  outer2 :: (
    fn(depth : i32, get_info : &Impl(Fn(k : i32) -> i32)) -> ArrayList(i32)
  )(
    analyze2(depth, get_info)
  );
  // The detector's capture copies the forwarded closure, so the closure must
  // be `Copy`: it captures an `i32`. A closure owning an `ArrayList` is not
  // `Copy` (plans/VALUES_BY_DEFAULT.md decision 36, as Rust's), and copying it
  // out of the borrowed `get_info` is E0901.
  base := i32(100);
  r := outer2(i32(2), (k : i32) => (base + k));
  assert(r.len() == usize(4), "two pushes per depth level over two levels");
  assert(match(r.get(usize(0)), .Some(v) => v, .None => i32(0)) == i32(102), "get_info(2) = 102");
  assert(match(r.get(usize(1)), .Some(v) => v, .None => i32(0)) == i32(109), "detect(2) = 102 + 7");
  assert(match(r.get(usize(2)), .Some(v) => v, .None => i32(0)) == i32(101), "get_info(1) = 101");
  assert(match(r.get(usize(3)), .Some(v) => v, .None => i32(0)) == i32(108), "detect(1) = 101 + 7");
});
test("Test two distinct closures through the same forwarding chain", {
  apply3 :: (
    fn(get_info : &Impl(Fn(k : i32) -> i32)) -> i32
  )(
    get_info(i32(10))
  );
  relay3 :: (
    fn(get_info : &Impl(Fn(k : i32) -> i32)) -> i32
  )(
    apply3(get_info)
  );
  // Two closures with DIFFERENT captures must not merge onto one
  // specialization of the forwarding chain (the capture-split hazard).
  a := i32(1);
  b := i32(2000);
  r1 := relay3((k : i32) => (a + k));
  r2 := relay3((k : i32) => (b + k));
  assert(r1 == i32(11), "first closure captures a=1: 1 + 10");
  assert(r2 == i32(2010), "second closure captures b=2000: 2000 + 10");
});
test("Test a captured generic callback at T = unit", {
  // The ZST instantiation of a forwarded `Impl(Fn(...) -> T)`. The inner
  // closure CAPTURES `cb` and calls it, so the call is a static dispatch
  // through impl_closure_call_map — and at `T = unit` the callee's prototype
  // returns `void` while the call expression's own type is still the
  // unresolved `T`, whose C spelling is the erasure `void*`. Three emitters
  // read the expression instead of the callee and emitted
  // `void* t = <void call>;` (the call-site temp) and then `void* t = ;` (the
  // binding's spill), for a program `yo check` accepts.
  // See issues/fixed/closure-call-binds-a-void-result-to-a-void-pointer-temp.md.
  hits := ArrayList(i32).new();
  call_unit4 :: (fn(f : &Impl(Fn(n : i32) -> unit)) -> unit)({
    f(i32(7));
  });
  run4 :: (fn(generic(T : Type), cb : &Impl(Fn(n : i32) -> T)) -> unit)({
    call_unit4((k : i32) => {
      _v := cb(k);
      ()
    });
  });
  run4((n : i32) => {
    hits.push(n);
  });
  // The call must still RUN: the fix turns the binding into a statement, and a
  // statement that was dropped instead of emitted would leave this empty.
  assert(hits.len() == usize(1), "the captured unit callback ran exactly once");
  assert(match(hits.get(usize(0)), .Some(v) => v, .None => i32(0)) == i32(7), "it ran with the forwarded argument");
});
// Regression (issues/fixed/2026-10-15-the-generic-call-time-binder-binds-a-sink-closure-argument-at-a-bitwise-fn-type.md):
// a generic function's by-value closure parameter whose type mentions its
// type parameter takes a closure literal typed as a bare `fn(...)`, which is
// bitwise-copyable. The caller kept the closure and the callee bound the
// parameter non-owning, so a closure holding a `Drop` value could not be
// moved on (E0901, "Take it `sink(...)`" on a parameter already `sink`).
// The callee owns it now, and each closure's `Drop` value is dropped once.
_CpfDrops :: ref(struct(n : i32));
_CpfTok :: struct(v : i32, drops : _CpfDrops);
impl(
  _CpfTok,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      self.drops.n = (self.drops.n + i32(1));
    })
  )
);
_cpf_take :: (fn(generic(U : Type), sink(f) : Impl(Fn() -> U)) -> U)(f());
_cpf_sink_relay :: (fn(generic(T : Type), sink(cb) : Impl(Fn() -> T)) -> T)(_cpf_take(() => cb()));
_cpf_plain_relay :: (fn(generic(T : Type), cb : Impl(Fn() -> T)) -> T)(_cpf_take(() => cb()));
_cpf_direct :: (fn(generic(T : Type), sink(cb) : Impl(Fn() -> T)) -> T)(cb());
test("a generic function's closure parameter owns a closure literal holding a Drop value", {
  drops := _CpfDrops(n : i32(0));
  {
    t := _CpfTok(v : i32(3), drops : drops);
    assert(_cpf_sink_relay(() => t.v) == i32(3), "the sink relay ran the moved closure");
  };
  assert(drops.n == i32(1), "the sink relay's closure is dropped once");
  {
    t := _CpfTok(v : i32(4), drops : drops);
    assert(_cpf_plain_relay(() => t.v) == i32(4), "the by-value relay ran the moved closure");
  };
  assert(drops.n == i32(2), "the by-value relay's closure is dropped once");
  {
    t := _CpfTok(v : i32(5), drops : drops);
    assert(_cpf_direct(() => t.v) == i32(5), "the callee ran the closure it owns");
  };
  assert(drops.n == i32(3), "the closure the callee owns is dropped once");
});
// The counted-capture shape the stopgap took its own references for: the
// relay now moves the closure on instead, and the caller's `String` is
// released once (a second release is a use-after-free under ASan).
test("a generic function's closure parameter owns a closure literal holding a counted value", {
  s := String.from("counted");
  assert(_cpf_sink_relay(() => s.len()) == usize(7), "the sink relay ran the closure over a String");
  assert(_cpf_plain_relay(() => s.len()) == usize(7), "the by-value relay ran the closure over a String");
  assert(s.len() == usize(7), "the caller's String is still alive");
});
