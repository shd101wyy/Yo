//! An `FnOnce(...)` closure's body owns its by-value captures (decision 37):
//! it drops every capture it does not move. A capture moved on SOME paths
//! only is dropped at the end of each arm that keeps it, as a conditionally
//! moved local is (`_drop_in_arms_that_keep`, src/evaluator/utils.yo). That
//! arm drop names a capture, and codegen skips every drop of a capture name
//! in a closure body unless it is tagged as the body's own capture drop, so
//! every call taking the arm that keeps the capture leaked it
//! (issues/fixed/2026-11-17-a-closure-moving-a-by-value-capture-on-one-branch-leaks-it-on-the-other.md).
//!
//! The gate is a dispose COUNTER, not the leak verdict (CI runs with
//! `YO_TEST_LEAK_VERDICT=0`): each capture's `Drop` bumps a shared count, so a
//! leak reads 0 and a double drop on the moving path reads 2. Every closure
//! below either moves its one capture into `_sink`, which drops it, or keeps
//! it, so every call must dispose exactly once.
{ assert } :: import("std/assert");
{ RefCell } :: import("std/sync/refcell");
{ ArrayList } :: import("std/collections/array_list");
{ yield } :: import("std/async");
Counter :: struct(n : RefCell(i32));
Tracked :: struct(c : Rc(Counter), v : i32);
impl(
  Tracked,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _old := self.c.n.replace_with(n => (n.* + i32(1)));
    })
  )
);
_counter :: (fn() -> Rc(Counter))(Rc.new(Counter(n : RefCell(i32).new(i32(0)))));
_count :: (fn(c : &Rc(Counter)) -> i32)(c.n.with(n => n.*));
_mk :: (fn(c : &Rc(Counter), v : i32) -> Tracked)(Tracked(c : Rc.clone(c), v : v));
/// Takes the value and drops it at its exit.
_sink :: (fn(t : Tracked) -> unit)(());
_sink_true :: (fn(t : Tracked) -> bool)(true);
_peek :: (fn(t : &Tracked) -> i32)(t.v);
// ── the shapes: one closure, one capture, one call ────────────────────────
_if_else :: (fn(c : &Rc(Counter), moves : bool) -> unit)({
  t := _mk(c, i32(1));
  (f : Impl(FnOnce() -> unit)) = ({ t, moves }() => {
    if(moves, {
      _sink(t);
    }, {
      _r := _peek(&t);
    });
    ()
  });
  f();
});
_if_no_else :: (fn(c : &Rc(Counter), moves : bool) -> unit)({
  t := _mk(c, i32(1));
  (f : Impl(FnOnce() -> unit)) = ({ t, moves }() => {
    if(moves, {
      _sink(t);
    });
    ()
  });
  f();
});
_cond3 :: (fn(c : &Rc(Counter), k : i32) -> unit)({
  t := _mk(c, i32(1));
  (f : Impl(FnOnce() -> unit)) = ({ t, k }() => {
    cond(
      (k == i32(0)) => {
        _r := _peek(&t);
      },
      (k == i32(1)) => _sink(t),
      true => ()
    );
    ()
  });
  f();
});
_match_arms :: (fn(c : &Rc(Counter), o : Option(i32)) -> unit)({
  t := _mk(c, i32(1));
  (f : Impl(FnOnce() -> unit)) = ({ t, o }() => {
    match(
      o,
      .Some(_) => _sink(t),
      .None => {
        _r := _peek(&t);
      }
    );
    ()
  });
  f();
});
_nested :: (fn(c : &Rc(Counter), a : bool, b : bool) -> unit)({
  t := _mk(c, i32(1));
  (f : Impl(FnOnce() -> unit)) = ({ t, a, b }() => {
    if(a, {
      if(b, {
        _sink(t);
      }, {
        _r := _peek(&t);
      });
    }, {
      _r := _peek(&t);
    });
    ()
  });
  f();
});
// The arm that keeps the capture returns early.
_early_return :: (fn(c : &Rc(Counter), moves : bool) -> unit)({
  t := _mk(c, i32(1));
  (f : Impl(FnOnce() -> unit)) = ({ t, moves }() => {
    if(!moves, {
      return(());
    });
    _sink(t);
  });
  f();
});
// The capture moves inside an arm that then returns, the other arm falls through.
_return_after_move :: (fn(c : &Rc(Counter), moves : bool) -> i32)({
  t := _mk(c, i32(1));
  (f : Impl(FnOnce() -> i32)) = ({ t, moves }() => {
    if(moves, {
      _sink(t);
      return(i32(1));
    }, {
      _r := _peek(&t);
    });
    i32(0)
  });
  f()
});
// A skippable short-circuit operand moves the capture.
_short_circuit :: (fn(c : &Rc(Counter), moves : bool) -> unit)({
  t := _mk(c, i32(1));
  (f : Impl(FnOnce() -> unit)) = ({ t, moves }() => {
    _b := (moves && _sink_true(t));
    ()
  });
  f();
});
// The reproducer's shape: a closure passed to `RefCell.with_mut`, moving the
// capture into the borrowed list on one arm.
_with_mut :: (fn(c : &Rc(Counter), cell : &RefCell(ArrayList(Tracked)), moves : bool) -> unit)({
  t := _mk(c, i32(1));
  cell.with_mut({ t, moves }(xs) => {
    if(moves, {
      xs.push(t);
    }, {
      _r := _peek(&t);
    });
    ()
  });
});
// `Fn` and `FnMut` calls borrow the closure, so their bodies cannot move a
// capture: the closure value drops it once, whatever the arms do.
_fn_lends :: (fn(c : &Rc(Counter), moves : bool) -> unit)({
  t := _mk(c, i32(1));
  (f : Impl(Fn() -> i32)) = ({ t, moves }() => if(moves, _peek(&t), i32(0)));
  _a := f();
  _b := f();
});
_fnmut_lends :: (fn(c : &Rc(Counter), moves : bool) -> unit)({
  t := _mk(c, i32(1));
  mut(n) := i32(0);
  (mut(f) : Impl(FnMut() -> unit)) = ({ t, moves, &mut n }() => {
    if(moves, {
      n.* = (n.* + _peek(&t));
    }, {
      n.* = (n.* - i32(1));
    });
  });
  f();
  f();
});
// An `io.async` body owns its capture list too; its state machine drops a
// capture through the slot's move flag, so an arm that keeps it needs no drop
// of its own. With no await (one state) and with one (two states).
_async_move :: (fn(c : &Rc(Counter), moves : bool, io : Io) -> unit)({
  t := _mk(c, i32(1));
  io.await(
    io.async({ t, moves }(io : Io) => {
      if(moves, {
        _sink(t);
      }, {
        _r := _peek(&t);
      });
      ()
    }),
    io
  );
});
_async_move_awaiting :: (fn(c : &Rc(Counter), moves : bool, io : Io) -> unit)({
  t := _mk(c, i32(1));
  io.await(
    io.async({ t, moves }(io : Io) => {
      io.await(yield(io), io);
      if(moves, {
        _sink(t);
      }, {
        _r := _peek(&t);
      });
      io.await(yield(io), io);
      ()
    }),
    io
  );
});
// ── the gates ─────────────────────────────────────────────────────────────
test("FnOnce: if/else, the keeping arm drops the capture and the moving arm drops it once", {
  c := _counter();
  _if_else(&c, false);
  assert(_count(&c) == i32(1), `keeping arm: 1 dispose, got ${_count(&c).to_string()}`);
  _if_else(&c, true);
  assert(_count(&c) == i32(2), `moving arm: 1 more dispose, got ${_count(&c).to_string()}`);
});
test("FnOnce: an `if` with no else, the implicit arm drops the capture", {
  c := _counter();
  _if_no_else(&c, false);
  assert(_count(&c) == i32(1), `implicit arm: 1 dispose, got ${_count(&c).to_string()}`);
  _if_no_else(&c, true);
  assert(_count(&c) == i32(2), `moving arm: 1 more dispose, got ${_count(&c).to_string()}`);
});
test("FnOnce: a three-arm cond drops the capture in both arms that keep it", {
  c := _counter();
  _cond3(&c, i32(0));
  assert(_count(&c) == i32(1), `arm 0: 1 dispose, got ${_count(&c).to_string()}`);
  _cond3(&c, i32(1));
  assert(_count(&c) == i32(2), `arm 1 (moves): 1 more dispose, got ${_count(&c).to_string()}`);
  _cond3(&c, i32(2));
  assert(_count(&c) == i32(3), `arm 2: 1 more dispose, got ${_count(&c).to_string()}`);
});
test("FnOnce: match arms, the arm that keeps the capture drops it", {
  c := _counter();
  _match_arms(&c, .None);
  assert(_count(&c) == i32(1), `.None arm: 1 dispose, got ${_count(&c).to_string()}`);
  _match_arms(&c, .Some(i32(3)));
  assert(_count(&c) == i32(2), `.Some arm (moves): 1 more dispose, got ${_count(&c).to_string()}`);
});
test("FnOnce: a nested branch drops the capture on every path that keeps it", {
  c := _counter();
  _nested(&c, false, false);
  assert(_count(&c) == i32(1), `outer else: 1 dispose, got ${_count(&c).to_string()}`);
  _nested(&c, true, false);
  assert(_count(&c) == i32(2), `inner else: 1 more dispose, got ${_count(&c).to_string()}`);
  _nested(&c, true, true);
  assert(_count(&c) == i32(3), `inner then (moves): 1 more dispose, got ${_count(&c).to_string()}`);
});
test("FnOnce: an early return before the move drops the capture", {
  c := _counter();
  _early_return(&c, false);
  assert(_count(&c) == i32(1), `early return: 1 dispose, got ${_count(&c).to_string()}`);
  _early_return(&c, true);
  assert(_count(&c) == i32(2), `move: 1 more dispose, got ${_count(&c).to_string()}`);
});
test("FnOnce: a return after the move in one arm, the other arm falls through", {
  c := _counter();
  assert(_return_after_move(&c, false) == i32(0), "fell through");
  assert(_count(&c) == i32(1), `keeping arm: 1 dispose, got ${_count(&c).to_string()}`);
  assert(_return_after_move(&c, true) == i32(1), "returned");
  assert(_count(&c) == i32(2), `moving arm: 1 more dispose, got ${_count(&c).to_string()}`);
});
test("FnOnce: a short-circuit operand that moves the capture, skipped", {
  c := _counter();
  _short_circuit(&c, false);
  assert(_count(&c) == i32(1), `skipped operand: 1 dispose, got ${_count(&c).to_string()}`);
  _short_circuit(&c, true);
  assert(_count(&c) == i32(2), `evaluated operand: 1 more dispose, got ${_count(&c).to_string()}`);
});
test("FnOnce: a closure passed to with_mut moving the capture into the list on one arm", {
  c := _counter();
  cell := RefCell(ArrayList(Tracked)).new(ArrayList(Tracked).new());
  _with_mut(&c, &cell, false);
  assert(_count(&c) == i32(1), `keeping arm: 1 dispose, got ${_count(&c).to_string()}`);
  _with_mut(&c, &cell, true);
  assert(_count(&c) == i32(1), `moved into the list: no dispose yet, got ${_count(&c).to_string()}`);
  _with_mut(&c, &cell, false);
  assert(_count(&c) == i32(2), `keeping arm again: 1 more dispose, got ${_count(&c).to_string()}`);
  cell.with_mut(xs => xs.clear());
  assert(_count(&c) == i32(3), `the list's element: 1 more dispose, got ${_count(&c).to_string()}`);
});
test("Fn and FnMut: the closure value drops a capture its arms only lend, once", {
  c := _counter();
  _fn_lends(&c, false);
  _fn_lends(&c, true);
  assert(_count(&c) == i32(2), `Fn: 1 dispose per closure, got ${_count(&c).to_string()}`);
  _fnmut_lends(&c, false);
  _fnmut_lends(&c, true);
  assert(_count(&c) == i32(4), `FnMut: 1 dispose per closure, got ${_count(&c).to_string()}`);
});
test("io.async: a capture-list body moving the capture on one arm", {
  c := _counter();
  _async_move(&c, false, io);
  assert(_count(&c) == i32(1), `keeping arm: 1 dispose, got ${_count(&c).to_string()}`);
  _async_move(&c, true, io);
  assert(_count(&c) == i32(2), `moving arm: 1 more dispose, got ${_count(&c).to_string()}`);
  _async_move_awaiting(&c, false, io);
  assert(_count(&c) == i32(3), `awaiting, keeping arm: 1 more dispose, got ${_count(&c).to_string()}`);
  _async_move_awaiting(&c, true, io);
  assert(_count(&c) == i32(4), `awaiting, moving arm: 1 more dispose, got ${_count(&c).to_string()}`);
});
