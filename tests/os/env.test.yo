{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ platform, Platform } :: import("std/process");
{ env, home_dir, config_dir, cache_dir, temp_dir } :: import("std/env");
// ===== home_dir =====
test("home_dir returns Some on Unix", {
  cond(
    ((platform == Platform.Windows) || (platform == Platform.Wasi)) => (),
    true => {
      result := home_dir();
      assert(result.is_some(), "home_dir should return Some on Unix");
      h := result.unwrap();
      // Home dir should start with /
      assert(h.byte_at(usize(0)) == u8(47), "home_dir should start with /");
      // Home dir should not be empty
      assert(h.len() > usize(1), "home_dir should not be just /");
    }
  );
});
test("home_dir matches HOME env var", {
  cond(
    ((platform == Platform.Windows) || (platform == Platform.Wasi)) => (),
    true => {
      home := home_dir();
      env_home := env.get(String.from("HOME"));
      assert(home.is_some(), "home_dir should return Some");
      assert(env_home.is_some(), "HOME env var should exist");
      assert(home.unwrap() == env_home.unwrap(), "home_dir should match HOME env var");
    }
  );
});
// ===== config_dir =====
test("config_dir returns Some on Unix", {
  cond(
    ((platform == Platform.Windows) || (platform == Platform.Wasi)) => (),
    true => {
      result := config_dir();
      assert(result.is_some(), "config_dir should return Some on Unix");
      c := result.unwrap();
      assert(c.len() > usize(0), "config_dir should not be empty");
    }
  );
});
test("config_dir uses XDG_CONFIG_HOME if set", {
  cond(
    ((platform == Platform.Windows) || (platform == Platform.Wasi)) => (),
    true => {
      // Save original
      orig := env.get(String.from("XDG_CONFIG_HOME"));
      // Set custom config dir
      env.set(String.from("XDG_CONFIG_HOME"), String.from("/tmp/yo_test_config"));
      result := config_dir();
      assert(result.is_some(), "config_dir should return Some");
      assert(result.unwrap() == "/tmp/yo_test_config", "should use XDG_CONFIG_HOME");
      // Restore - note: we can't unset, so we just restore if existed
      match(
        orig,
        .Some(v) => {
          env.set(String.from("XDG_CONFIG_HOME"), &v);
        },
        .None => {
          // Set to empty to "clear" it; config_dir will fall back to HOME/.config
          env.set(String.from("XDG_CONFIG_HOME"), String.from(""));
        }
      );
    }
  );
});
// ===== cache_dir =====
test("cache_dir returns Some on Unix", {
  cond(
    ((platform == Platform.Windows) || (platform == Platform.Wasi)) => (),
    true => {
      result := cache_dir();
      assert(result.is_some(), "cache_dir should return Some on Unix");
      c := result.unwrap();
      assert(c.len() > usize(0), "cache_dir should not be empty");
    }
  );
});
// ===== temp_dir =====
test("temp_dir is $TMPDIR when set and /tmp otherwise on Unix", {
  // Hermetic: the runner's environment may set TMPDIR (nix-shell sets
  // `/tmp/nix-shell.XXXXXX`, macOS a per-user directory), so the test sets
  // and clears it itself and restores it after
  // (issues/fixed/2026-10-18-three-language-tests-fail-in-a-nix-shell-sandbox.md).
  cond(
    ((platform == Platform.Windows) || (platform == Platform.Wasi) || (platform == Platform.Emscripten)) => (),
    true => {
      saved := env.get(`TMPDIR`);
      assert(env.remove(`TMPDIR`), "unset TMPDIR");
      unset_result := temp_dir();
      assert(env.set(`TMPDIR`, `/yo-env-test/tmp`), "set TMPDIR");
      set_result := temp_dir();
      match(
        saved,
        .Some(v) => {
          assert(env.set(`TMPDIR`, &v), "restore TMPDIR");
        },
        .None => {
          assert(env.remove(`TMPDIR`), "restore an unset TMPDIR");
        }
      );
      assert(unset_result == "/tmp", `temp_dir without TMPDIR should be /tmp, got ${unset_result}`);
      assert(set_result == "/yo-env-test/tmp", `temp_dir should honour TMPDIR, got ${set_result}`);
    }
  );
});
test("temp_dir is not empty", {
  result := temp_dir();
  assert(result.len() > usize(0), "temp_dir should not be empty");
});
