pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ on_signal, off_signal, Signal, SignalHandler } :: import("std/signal");
{ platform, Platform } :: import("std/process");
{ Error, AnyError, Exception } :: import("std/error");
open(import("std/libc/stdio"));
_noop_handler :: (fn(data : *(u8)) -> unit)({
  ();
});
// ===== Signal Registration =====
test("on_signal registers handler successfully", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  cond(
    (platform == Platform.Windows) => (),
    true => {
      on_signal(.User1, _noop_handler, exn);
      // Clean up
      off_signal(.User1, exn);
    }
  );
});
test("on_signal replaces previous handler", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  cond(
    (platform == Platform.Windows) => (),
    true => {
      _other_handler :: (fn(data : *(u8)) -> unit)({
        ();
      });
      // Register first handler
      on_signal(.User2, _noop_handler, exn);
      // Replace with second handler
      on_signal(.User2, _other_handler, exn);
      // Clean up
      off_signal(.User2, exn);
    }
  );
});
test("off_signal removes handler", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  cond(
    (platform == Platform.Windows) => (),
    true => {
      on_signal(.Alarm, _noop_handler, exn);
      off_signal(.Alarm, exn);
    }
  );
});
