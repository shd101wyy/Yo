pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
open(import("std/collections/hash_set"));
// ===== Construction Tests =====
test("HashSet.new creates empty set", {
  set := HashSet(i32).new();
  assert(set.len() == usize(0));
  assert(set.is_empty());
});
test("HashSet.with_capacity creates set with specified capacity", {
  set := HashSet(i32).with_capacity(usize(32));
  assert(set.len() == usize(0));
  assert(set.is_empty());
  assert(set.capacity >= usize(32));
});
test("HashSet.with_capacity rounds up to power of 2", {
  set := HashSet(i32).with_capacity(usize(20));
  assert(set.len() == usize(0));
  // Should round up to 32
  assert(set.capacity >= usize(20));
});
test("HashSet.with_capacity with small capacity uses default", {
  set := HashSet(i32).with_capacity(usize(4));
  assert(set.len() == usize(0));
  // Should use DEFAULT_CAPACITY (16)
  assert(set.capacity >= usize(4));
});
// ===== Add Tests =====
test("HashSet.add inserts new element", {
  set := HashSet(i32).new();
  result := set.add(i32(42));
  assert(result.is_ok());
  assert(result.unwrap() == true);
  assert(set.len() == usize(1));
});
test("HashSet.add returns false for duplicate element", {
  set := HashSet(i32).new();
  set.add(i32(10));
  result := set.add(i32(10));
  assert(result.is_ok());
  assert(result.unwrap() == false);
  assert(set.len() == usize(1));
});
test("HashSet.add inserts multiple elements", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.add(i32(2));
  set.add(i32(3));
  assert(set.len() == usize(3));
});
test("HashSet.add handles many insertions and triggers resize", {
  set := HashSet(i32).new();
  // Insert enough elements to trigger resize (> 7/8 of capacity)
  i := usize(0);
  while(i < usize(20), i = (i + usize(1)), {
    set.add(i32(i));
  });
  assert(set.len() == usize(20));
});
// ===== Has Tests =====
test("HashSet.has returns true for existing element", {
  set := HashSet(i32).new();
  set.add(i32(42));
  assert(set.contains(i32(42)));
});
test("HashSet.has returns false for non-existing element", {
  set := HashSet(i32).new();
  set.add(i32(10));
  assert(!(set.contains(i32(99))));
});
test("HashSet.has returns false for empty set", {
  set := HashSet(i32).new();
  assert(!(set.contains(i32(42))));
});
test("HashSet.has works after multiple insertions", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.add(i32(2));
  set.add(i32(3));
  assert(set.contains(i32(1)));
  assert(set.contains(i32(2)));
  assert(set.contains(i32(3)));
  assert(!(set.contains(i32(4))));
});
// ===== Remove Tests =====
test("HashSet.remove deletes existing element", {
  set := HashSet(i32).new();
  set.add(i32(42));
  result := set.remove(i32(42));
  assert(result == true);
  assert(set.len() == usize(0));
  assert(set.is_empty());
});
test("HashSet.remove returns false for non-existing element", {
  set := HashSet(i32).new();
  set.add(i32(10));
  result := set.remove(i32(99));
  assert(result == false);
  assert(set.len() == usize(1));
});
test("HashSet.remove from empty set returns false", {
  set := HashSet(i32).new();
  result := set.remove(i32(42));
  assert(result == false);
});
test("HashSet.remove and verify element no longer exists", {
  set := HashSet(i32).new();
  set.add(i32(10));
  set.remove(i32(10));
  assert(!(set.contains(i32(10))));
});
test("HashSet.remove preserves other entries", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.add(i32(2));
  set.add(i32(3));
  set.remove(i32(2));
  assert(set.len() == usize(2));
  assert(set.contains(i32(1)));
  assert(!(set.contains(i32(2))));
  assert(set.contains(i32(3)));
});
test("HashSet.remove multiple elements", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.add(i32(2));
  set.add(i32(3));
  set.remove(i32(1));
  set.remove(i32(3));
  assert(set.len() == usize(1));
  assert(!(set.contains(i32(1))));
  assert(set.contains(i32(2)));
  assert(!(set.contains(i32(3))));
});
// ===== Clear Tests =====
test("HashSet.clear removes all entries", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.add(i32(2));
  set.add(i32(3));
  set.clear();
  assert(set.len() == usize(0));
  assert(set.is_empty());
});
test("HashSet.clear on empty set", {
  set := HashSet(i32).new();
  set.clear();
  assert(set.len() == usize(0));
  assert(set.is_empty());
});
test("HashSet can be reused after clear", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.clear();
  set.add(i32(2));
  assert(set.len() == usize(1));
  assert(set.contains(i32(2)));
});
test("HashSet.clear removes all elements", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.add(i32(2));
  set.clear();
  assert(!(set.contains(i32(1))));
  assert(!(set.contains(i32(2))));
});
// ===== Length and Empty Tests =====
test("HashSet.len returns correct count", {
  set := HashSet(i32).new();
  assert(set.len() == usize(0));
  set.add(i32(1));
  assert(set.len() == usize(1));
  set.add(i32(2));
  assert(set.len() == usize(2));
});
test("HashSet.len after remove", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.add(i32(2));
  set.remove(i32(1));
  assert(set.len() == usize(1));
});
test("HashSet.is_empty on new set", {
  set := HashSet(i32).new();
  assert(set.is_empty());
});
test("HashSet.is_empty after insertions", {
  set := HashSet(i32).new();
  set.add(i32(1));
  assert(!(set.is_empty()));
});
test("HashSet.is_empty after clear", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.clear();
  assert(set.is_empty());
});
// ===== Set Operation Tests =====
test("HashSet.is_subset returns true for subset", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  set2.add(i32(1));
  set2.add(i32(2));
  set2.add(i32(3));
  assert(set1.is_subset(set2));
});
test("HashSet.is_subset returns false for non-subset", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(4));
  set2 := HashSet(i32).new();
  set2.add(i32(1));
  set2.add(i32(2));
  set2.add(i32(3));
  assert(!(set1.is_subset(set2)));
});
test("HashSet.is_subset returns true for equal sets", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  set2.add(i32(1));
  set2.add(i32(2));
  assert(set1.is_subset(set2));
  assert(set2.is_subset(set1));
});
test("HashSet.is_superset returns true for superset", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set1.add(i32(3));
  set2 := HashSet(i32).new();
  set2.add(i32(1));
  set2.add(i32(2));
  assert(set1.is_superset(set2));
});
test("HashSet.is_superset returns false for non-superset", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  set2.add(i32(1));
  set2.add(i32(3));
  assert(!(set1.is_superset(set2)));
});
test("HashSet.is_disjoint returns true for disjoint sets", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  set2.add(i32(3));
  set2.add(i32(4));
  assert(set1.is_disjoint(set2));
});
test("HashSet.is_disjoint returns false for overlapping sets", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  set2.add(i32(2));
  set2.add(i32(3));
  assert(!(set1.is_disjoint(set2)));
});
test("HashSet.union creates combined set", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  set2.add(i32(2));
  set2.add(i32(3));
  result := set1.union(set2);
  assert(result.is_ok());
  union_set := result.unwrap();
  assert(union_set.len() == usize(3));
  assert(union_set.contains(i32(1)));
  assert(union_set.contains(i32(2)));
  assert(union_set.contains(i32(3)));
});
test("HashSet.union with empty set", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  result := set1.union(set2);
  assert(result.is_ok());
  union_set := result.unwrap();
  assert(union_set.len() == usize(2));
  assert(union_set.contains(i32(1)));
  assert(union_set.contains(i32(2)));
});
test("HashSet.intersection creates common elements set", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set1.add(i32(3));
  set2 := HashSet(i32).new();
  set2.add(i32(2));
  set2.add(i32(3));
  set2.add(i32(4));
  result := set1.intersection(set2);
  assert(result.is_ok());
  inter_set := result.unwrap();
  assert(inter_set.len() == usize(2));
  assert(inter_set.contains(i32(2)));
  assert(inter_set.contains(i32(3)));
  assert(!(inter_set.contains(i32(1))));
  assert(!(inter_set.contains(i32(4))));
});
test("HashSet.intersection with empty set", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  result := set1.intersection(set2);
  assert(result.is_ok());
  inter_set := result.unwrap();
  assert(inter_set.is_empty());
});
test("HashSet.difference creates elements in first but not second", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set1.add(i32(3));
  set2 := HashSet(i32).new();
  set2.add(i32(2));
  set2.add(i32(4));
  result := set1.difference(set2);
  assert(result.is_ok());
  diff_set := result.unwrap();
  assert(diff_set.len() == usize(2));
  assert(diff_set.contains(i32(1)));
  assert(diff_set.contains(i32(3)));
  assert(!(diff_set.contains(i32(2))));
  assert(!(diff_set.contains(i32(4))));
});
test("HashSet.difference with empty set returns copy", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  result := set1.difference(set2);
  assert(result.is_ok());
  diff_set := result.unwrap();
  assert(diff_set.len() == usize(2));
  assert(diff_set.contains(i32(1)));
  assert(diff_set.contains(i32(2)));
});
test("HashSet.symmetric_difference creates elements in either but not both", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set1.add(i32(3));
  set2 := HashSet(i32).new();
  set2.add(i32(2));
  set2.add(i32(3));
  set2.add(i32(4));
  result := set1.symmetric_difference(set2);
  assert(result.is_ok());
  sym_diff := result.unwrap();
  assert(sym_diff.len() == usize(2));
  assert(sym_diff.contains(i32(1)));
  assert(sym_diff.contains(i32(4)));
  assert(!(sym_diff.contains(i32(2))));
  assert(!(sym_diff.contains(i32(3))));
});
test("HashSet.symmetric_difference with disjoint sets", {
  set1 := HashSet(i32).new();
  set1.add(i32(1));
  set1.add(i32(2));
  set2 := HashSet(i32).new();
  set2.add(i32(3));
  set2.add(i32(4));
  result := set1.symmetric_difference(set2);
  assert(result.is_ok());
  sym_diff := result.unwrap();
  assert(sym_diff.len() == usize(4));
  assert(sym_diff.contains(i32(1)));
  assert(sym_diff.contains(i32(2)));
  assert(sym_diff.contains(i32(3)));
  assert(sym_diff.contains(i32(4)));
});
// ===== Collision Tests =====
test("HashSet handles hash collisions", {
  set := HashSet(i32).new();
  // Insert multiple elements that might collide
  i := usize(0);
  while(i < usize(10), i = (i + usize(1)), {
    set.add(i32(i));
  });
  // Verify all elements are present
  i = usize(0);
  while(i < usize(10), i = (i + usize(1)), {
    assert(set.contains(i32(i)));
  });
});
// ===== Stress Tests =====
test("HashSet handles large number of insertions", {
  set := HashSet(i32).new();
  // Insert 100 elements
  i := usize(0);
  while(i < usize(100), i = (i + usize(1)), {
    set.add(i32(i));
  });
  assert(set.len() == usize(100));
  // Verify first 50 elements
  i = usize(0);
  while(i < usize(50), i = (i + usize(1)), {
    assert(set.contains(i32(i)));
  });
});
test("HashSet alternating add and remove", {
  set := HashSet(i32).new();
  set.add(i32(1));
  set.add(i32(2));
  set.remove(i32(1));
  set.add(i32(3));
  set.remove(i32(2));
  set.add(i32(4));
  assert(set.len() == usize(2));
  assert(!(set.contains(i32(1))));
  assert(!(set.contains(i32(2))));
  assert(set.contains(i32(3)));
  assert(set.contains(i32(4)));
});
test("HashSet remove and reinsert same element", {
  set := HashSet(i32).new();
  set.add(i32(42));
  set.remove(i32(42));
  set.add(i32(42));
  assert(set.len() == usize(1));
  assert(set.contains(i32(42)));
});
// ===== Edge Cases =====
test("HashSet with zero element", {
  set := HashSet(i32).new();
  set.add(i32(0));
  assert(set.contains(i32(0)));
  assert(set.len() == usize(1));
});
test("HashSet with negative elements", {
  set := HashSet(i32).new();
  set.add(i32(-(1)));
  set.add(i32(-(2)));
  assert(set.contains(i32(-(1))));
  assert(set.contains(i32(-(2))));
  assert(set.len() == usize(2));
});
// ===== Different Element Types =====
test("HashSet with u64 elements", {
  set := HashSet(u64).new();
  set.add(u64(100));
  set.add(u64(200));
  assert(set.len() == usize(2));
  assert(set.contains(u64(100)));
  assert(set.contains(u64(200)));
});
test("HashSet with bool elements", {
  set := HashSet(bool).new();
  set.add(true);
  set.add(false);
  assert(set.len() == usize(2));
  assert(set.contains(true));
  assert(set.contains(false));
});
// ===== Duplicate Addition Tests =====
test("HashSet.add duplicate returns false and doesn't increase size", {
  set := HashSet(i32).new();
  result1 := set.add(i32(5));
  result2 := set.add(i32(5));
  assert(result1.unwrap() == true);
  assert(result2.unwrap() == false);
  assert(set.len() == usize(1));
});
test("HashSet maintains uniqueness", {
  set := HashSet(i32).new();
  i := usize(0);
  while(i < usize(10), i = (i + usize(1)), {
    set.add(i32(5));
  });
  assert(set.len() == usize(1));
  assert(set.contains(i32(5)));
});
// ===== Reference-Counted Type Tests =====
test("HashSet with Box elements - basic add and has", {
  set := HashSet(Box(i32)).new();
  set.add(Box(i32)(10));
  set.add(Box(i32)(20));
  set.add(Box(i32)(30));
  assert(set.len() == usize(3));
  assert(set.contains(Box(i32)(10)));
  assert(set.contains(Box(i32)(20)));
  assert(set.contains(Box(i32)(30)));
});
test("HashSet with Box elements - duplicate rejected and cleaned up", {
  set := HashSet(Box(i32)).new();
  result1 := set.add(Box(i32)(42));
  result2 := set.add(Box(i32)(42));
  assert(result1.is_ok());
  assert(result1.unwrap() == true);
  assert(result2.is_ok());
  assert(result2.unwrap() == false);
  assert(set.len() == usize(1));
  // The duplicate Box(42) should be properly dropped
});
test("HashSet with Box elements - remove cleans up element", {
  set := HashSet(Box(i32)).new();
  set.add(Box(i32)(10));
  set.add(Box(i32)(20));
  set.add(Box(i32)(30));
  result := set.remove(Box(i32)(20));
  assert(result == true);
  assert(set.len() == usize(2));
  assert(!(set.contains(Box(i32)(20))));
  assert(set.contains(Box(i32)(10)));
  assert(set.contains(Box(i32)(30)));
  // The removed Box(20) should be properly dropped
});
test("HashSet with Box elements - clear cleans up all elements", {
  set := HashSet(Box(i32)).new();
  set.add(Box(i32)(1));
  set.add(Box(i32)(2));
  set.add(Box(i32)(3));
  set.clear();
  assert(set.len() == usize(0));
  assert(set.is_empty());
  // All Box elements should be properly dropped
});
test("HashSet with Box elements - stress test with resize", {
  set := HashSet(Box(i32)).new();
  // Add 100 elements to trigger multiple resizes
  i := 0;
  while(i < 100, i = (i + 1), {
    set.add(Box(i32)(i32(i) * 10));
  });
  assert(set.len() == usize(100));
  // Remove one
  set.remove(Box(i32)(200));
  assert(set.len() == usize(99));
  // Clear all
  set.clear();
  assert(set.len() == usize(0));
  // All Box elements should be properly cleaned up including during resizes
});
test("HashSet with Box elements - adding many duplicates", {
  set := HashSet(Box(i32)).new();
  // Add same element many times - all duplicates should be dropped
  i := 0;
  while(i < 50, i = (i + 1), {
    set.add(Box(i32)(42));
  });
  assert(set.len() == usize(1));
  assert(set.contains(Box(i32)(42)));
  // 49 duplicate Box elements should be properly dropped
});
// ---- Iterator Tests ----
test("HashSet into_iter - empty set", {
  set := HashSet(i32).new();
  count := i32(0);
  for(set.into_iter(), (x) => {
    count = (count + i32(1));
  });
  assert(count == i32(0));
});
test("HashSet into_iter - single element", {
  set := HashSet(i32).new();
  set.add(i32(42));
  result := i32(0);
  for(set.into_iter(), (x) => {
    result = x;
  });
  assert(result == i32(42));
});
test("HashSet into_iter - multiple elements all visited", {
  set := HashSet(i32).new();
  set.add(i32(10));
  set.add(i32(20));
  set.add(i32(30));
  sum := i32(0);
  count := i32(0);
  for(set.into_iter(), (x) => {
    sum = (sum + x);
    count = (count + i32(1));
  });
  assert(sum == i32(60));
  assert(count == i32(3));
});
test("HashSet iter - empty set", {
  set := HashSet(i32).new();
  count := i32(0);
  for(set.iter(), (ptr) => {
    count = (count + i32(1));
  });
  assert(count == i32(0));
});
test("HashSet iter - yields pointers to elements", {
  set := HashSet(i32).new();
  set.add(i32(10));
  set.add(i32(20));
  sum := i32(0);
  for(set.iter(), (ptr) => {
    sum = (sum + ptr.*);
  });
  assert(sum == i32(30));
});
