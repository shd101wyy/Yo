pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
open(import("std/collections/hash_map"));
open(import("std/string"));
// ===== Construction Tests =====
test("HashMap.new creates empty map", {
  map := HashMap(i32, i32).new();
  assert(map.len() == usize(0));
  assert(map.is_empty());
});
test("HashMap.with_capacity creates map with specified capacity", {
  map := HashMap(i32, i32).with_capacity(usize(32));
  assert(map.len() == usize(0));
  assert(map.is_empty());
  assert(map.capacity >= usize(32));
});
test("HashMap.with_capacity rounds up to power of 2", {
  map := HashMap(i32, i32).with_capacity(usize(20));
  assert(map.len() == usize(0));
  // Should round up to 32
  assert(map.capacity >= usize(20));
});
test("HashMap.with_capacity with small capacity uses default", {
  map := HashMap(i32, i32).with_capacity(usize(4));
  assert(map.len() == usize(0));
  // Should use DEFAULT_CAPACITY (16)
  assert(map.capacity >= usize(4));
});
// ===== Set Tests =====
test("HashMap.set inserts new key-value pair", {
  map := HashMap(i32, i32).new();
  result := map.insert(i32(42), i32(100));
  assert(result.is_none());
  assert(map.len() == usize(1));
});
test("HashMap.set updates existing key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(10), i32(100));
  // `insert` returns the PREVIOUS value directly now (D9) — there is no
  // Result layer to unwrap first.
  result := map.insert(i32(10), i32(200));
  assert(result.is_some());
  assert(result.unwrap() == i32(100));
  assert(map.len() == usize(1));
});
test("HashMap.set inserts multiple key-value pairs", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.insert(i32(3), i32(30));
  assert(map.len() == usize(3));
});
test("HashMap.set handles many insertions and triggers resize", {
  map := HashMap(i32, i32).new();
  // Insert enough elements to trigger resize (> 7/8 of capacity)
  i := usize(0);
  while(i < usize(20), i = (i + usize(1)), {
    map.insert(i32(i), i32(i * usize(10)));
  });
  assert(map.len() == usize(20));
});
// ===== Get Tests =====
test("HashMap.get returns value for existing key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(42), i32(100));
  result := map.get(i32(42));
  assert(result.is_some());
  assert(result.unwrap() == i32(100));
});
test("HashMap.get returns None for non-existing key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(10), i32(100));
  result := map.get(i32(99));
  assert(result.is_none());
});
test("HashMap.get returns None for empty map", {
  map := HashMap(i32, i32).new();
  result := map.get(i32(42));
  assert(result.is_none());
});
test("HashMap.get retrieves correct values for multiple keys", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(100));
  map.insert(i32(2), i32(200));
  map.insert(i32(3), i32(300));
  assert(map(i32(1)) == i32(100));
  assert(map(i32(2)) == i32(200));
  assert(map(i32(3)) == i32(300));
});
test("HashMap.get after update returns new value", {
  map := HashMap(i32, i32).new();
  map.insert(i32(10), i32(100));
  map.insert(i32(10), i32(999));
  result := map.get(i32(10));
  assert(result.is_some());
  assert(result.unwrap() == i32(999));
});
// ===== Has Tests =====
test("HashMap.has returns true for existing key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(42), i32(100));
  assert(map.contains_key(i32(42)));
});
test("HashMap.has returns false for non-existing key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(10), i32(100));
  assert(!map.contains_key(i32(99)));
});
test("HashMap.has returns false for empty map", {
  map := HashMap(i32, i32).new();
  assert(!map.contains_key(i32(42)));
});
test("HashMap.has works after multiple insertions", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.insert(i32(3), i32(30));
  assert(map.contains_key(i32(1)));
  assert(map.contains_key(i32(2)));
  assert(map.contains_key(i32(3)));
  assert(!map.contains_key(i32(4)));
});
// ===== Remove Tests =====
test("HashMap.remove deletes existing key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(42), i32(100));
  result := map.remove(i32(42));
  assert(result.is_some());
  assert(result.unwrap() == i32(100));
  assert(map.len() == usize(0));
  assert(map.is_empty());
});
test("HashMap.remove returns None for non-existing key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(10), i32(100));
  result := map.remove(i32(99));
  assert(result.is_none());
  assert(map.len() == usize(1));
});
test("HashMap.remove from empty map returns None", {
  map := HashMap(i32, i32).new();
  result := map.remove(i32(42));
  assert(result.is_none());
});
test("HashMap.remove and verify key no longer exists", {
  map := HashMap(i32, i32).new();
  map.insert(i32(10), i32(100));
  map.remove(i32(10));
  assert(!map.contains_key(i32(10)));
  assert(map.get(i32(10)).is_none());
});
test("HashMap.remove preserves other entries", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(100));
  map.insert(i32(2), i32(200));
  map.insert(i32(3), i32(300));
  map.remove(i32(2));
  assert(map.len() == usize(2));
  assert(map.contains_key(i32(1)));
  assert(!map.contains_key(i32(2)));
  assert(map.contains_key(i32(3)));
  assert(map(i32(1)) == i32(100));
  assert(map(i32(3)) == i32(300));
});
test("HashMap.remove multiple keys", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.insert(i32(3), i32(30));
  map.remove(i32(1));
  map.remove(i32(3));
  assert(map.len() == usize(1));
  assert(!map.contains_key(i32(1)));
  assert(map.contains_key(i32(2)));
  assert(!map.contains_key(i32(3)));
});
// ===== Clear Tests =====
test("HashMap.clear removes all entries", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.insert(i32(3), i32(30));
  map.clear();
  assert(map.len() == usize(0));
  assert(map.is_empty());
});
test("HashMap.clear on empty map", {
  map := HashMap(i32, i32).new();
  map.clear();
  assert(map.len() == usize(0));
  assert(map.is_empty());
});
test("HashMap can be reused after clear", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.clear();
  map.insert(i32(2), i32(20));
  assert(map.len() == usize(1));
  assert(map(i32(2)) == i32(20));
});
test("HashMap.clear removes all keys", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.clear();
  assert(!map.contains_key(i32(1)));
  assert(!map.contains_key(i32(2)));
});
// ===== Length and Empty Tests =====
test("HashMap.len returns correct count", {
  map := HashMap(i32, i32).new();
  assert(map.len() == usize(0));
  map.insert(i32(1), i32(10));
  assert(map.len() == usize(1));
  map.insert(i32(2), i32(20));
  assert(map.len() == usize(2));
});
test("HashMap.len after remove", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.remove(i32(1));
  assert(map.len() == usize(1));
});
test("HashMap.is_empty on new map", {
  map := HashMap(i32, i32).new();
  assert(map.is_empty());
});
test("HashMap.is_empty after insertions", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  assert(!map.is_empty());
});
test("HashMap.is_empty after clear", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.clear();
  assert(map.is_empty());
});
// ===== Collision Tests =====
test("HashMap handles hash collisions", {
  map := HashMap(i32, i32).new();
  // Insert multiple elements that might collide
  i := usize(0);
  while(i < usize(10), i = (i + usize(1)), {
    map.insert(i32(i), i32(i * usize(100)));
  });
  // Verify all elements are retrievable
  i = usize(0);
  while(i < usize(10), i = (i + usize(1)), {
    result := map.get(i32(i));
    assert(result.is_some());
    assert(result.unwrap() == i32(i * usize(100)));
  });
});
// ===== Update Tests =====
test("HashMap.set replaces old value", {
  map := HashMap(i32, i32).new();
  map.insert(i32(5), i32(50));
  map.insert(i32(5), i32(500));
  assert(map.len() == usize(1));
  assert(map(i32(5)) == i32(500));
});
test("HashMap multiple updates to same key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(1), i32(20));
  map.insert(i32(1), i32(30));
  assert(map.len() == usize(1));
  assert(map(i32(1)) == i32(30));
});
// ===== Stress Tests =====
test("HashMap handles large number of insertions", {
  map := HashMap(i32, i32).new();
  // Insert 100 elements
  i := usize(0);
  while(i < usize(100), i = (i + usize(1)), {
    map.insert(i32(i), i32(i * usize(2)));
  });
  assert(map.len() == usize(100));
  // Verify all elements
  i = usize(0);
  while(i < usize(50), i = (i + usize(1)), {
    assert(map.contains_key(i32(i)));
    assert(map(i32(i)) == i32(i * usize(2)));
  });
});
test("HashMap alternating insert and remove", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.remove(i32(1));
  map.insert(i32(3), i32(30));
  map.remove(i32(2));
  map.insert(i32(4), i32(40));
  assert(map.len() == usize(2));
  assert(!map.contains_key(i32(1)));
  assert(!map.contains_key(i32(2)));
  assert(map.contains_key(i32(3)));
  assert(map.contains_key(i32(4)));
});
test("HashMap remove and reinsert same key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(42), i32(100));
  map.remove(i32(42));
  map.insert(i32(42), i32(200));
  assert(map.len() == usize(1));
  assert(map(i32(42)) == i32(200));
});
// ===== Edge Cases =====
test("HashMap with zero key", {
  map := HashMap(i32, i32).new();
  map.insert(i32(0), i32(100));
  assert(map.contains_key(i32(0)));
  assert(map(i32(0)) == i32(100));
});
test("HashMap with negative keys", {
  map := HashMap(i32, i32).new();
  map.insert(i32(-1), i32(10));
  map.insert(i32(-2), i32(20));
  assert(map(i32(-1)) == i32(10));
  assert(map(i32(-2)) == i32(20));
});
test("HashMap with negative values", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(-100));
  assert(map(i32(1)) == i32(-100));
});
// ===== Different Key-Value Types =====
test("HashMap with u64 keys and values", {
  map := HashMap(u64, u64).new();
  map.insert(u64(100), u64(200));
  map.insert(u64(300), u64(400));
  assert(map.len() == usize(2));
  assert(map(u64(100)) == u64(200));
  assert(map(u64(300)) == u64(400));
});
test("HashMap with bool keys", {
  map := HashMap(bool, i32).new();
  map.insert(true, i32(1));
  map.insert(false, i32(0));
  assert(map.len() == usize(2));
  assert(map(true) == i32(1));
  assert(map(false) == i32(0));
});
// ===== Reference-Counted Type Tests =====
test("HashMap with Box key and value - basic set and get", {
  map := HashMap(Box(i32), Box(i32)).new();
  map.insert(Box(i32)(1), Box(i32)(10));
  map.insert(Box(i32)(2), Box(i32)(20));
  map.insert(Box(i32)(3), Box(i32)(30));
  assert(map.len() == usize(3));
  assert(map(Box(i32)(1)).* == i32(10));
  assert(map(Box(i32)(2)).* == i32(20));
  assert(map(Box(i32)(3)).* == i32(30));
});
test("HashMap with Box values - update existing key cleans up old value", {
  map := HashMap(Box(i32), Box(i32)).new();
  map.insert(Box(i32)(1), Box(i32)(100));
  // Update with new value - old Box(100) should be dropped
  result := map.insert(Box(i32)(1), Box(i32)(200));
  assert(result.is_some());
  assert(map.len() == usize(1));
  assert(map(Box(i32)(1)).* == i32(200));
  // The old Box(100) value should be properly dropped
});
test("HashMap with Box key and value - remove cleans up both", {
  map := HashMap(Box(i32), Box(i32)).new();
  map.insert(Box(i32)(10), Box(i32)(100));
  map.insert(Box(i32)(20), Box(i32)(200));
  map.insert(Box(i32)(30), Box(i32)(300));
  removed := map.remove(Box(i32)(20));
  assert(removed.is_some());
  assert(removed.unwrap().* == i32(200));
  assert(map.len() == usize(2));
  assert(!map.contains_key(Box(i32)(20)));
  assert(map.contains_key(Box(i32)(10)));
  assert(map.contains_key(Box(i32)(30)));
  // The removed key Box(20) should be dropped, value Box(200) returned
});
test("HashMap with Box key and value - clear cleans up all", {
  map := HashMap(Box(i32), Box(i32)).new();
  map.insert(Box(i32)(1), Box(i32)(10));
  map.insert(Box(i32)(2), Box(i32)(20));
  map.insert(Box(i32)(3), Box(i32)(30));
  map.clear();
  assert(map.len() == usize(0));
  assert(map.is_empty());
  // All Box keys and values should be properly dropped
});
test("HashMap with Box key and value - stress test with resize", {
  map := HashMap(Box(i32), Box(i32)).new();
  // Add 100 elements to trigger multiple resizes
  i := 0;
  while(i < 100, i = (i + 1), {
    map.insert(Box(i32)(i32(i)), Box(i32)(i32(i) * 10));
  });
  assert(map.len() == usize(100));
  // Update half of them (should drop old values)
  i = 0;
  while(i < 50, i = (i + 1), {
    map.insert(Box(i32)(i32(i)), Box(i32)(i32(i) * 100));
  });
  assert(map.len() == usize(100));
  // Remove one
  map.remove(Box(i32)(25));
  assert(map.len() == usize(99));
  // Clear all
  map.clear();
  assert(map.len() == usize(0));
  // All Box elements should be properly cleaned up including during resizes
});
test("HashMap with Box values only", {
  map := HashMap(i32, Box(i32)).new();
  map.insert(i32(1), Box(i32)(100));
  map.insert(i32(2), Box(i32)(200));
  // Update value
  map.insert(i32(1), Box(i32)(150));
  assert(map(i32(1)).* == i32(150));
  assert(map.len() == usize(2));
  // Old Box(100) should be dropped when updated
});
test("HashMap with Box keys only", {
  map := HashMap(Box(i32), i32).new();
  map.insert(Box(i32)(1), i32(100));
  map.insert(Box(i32)(2), i32(200));
  assert(map(Box(i32)(1)) == i32(100));
  assert(map(Box(i32)(2)) == i32(200));
  // Remove
  map.remove(Box(i32)(1));
  assert(map.len() == usize(1));
  // Box key should be dropped
});
// ---- Iterator Tests ----
test("HashMap into_iter - empty map", {
  map := HashMap(i32, i32).new();
  count := i32(0);
  for(map.into_iter(), bucket => {
    count = (count + i32(1));
  });
  assert(count == i32(0));
});
test("HashMap into_iter - single entry", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(100));
  result_key := i32(0);
  result_val := i32(0);
  for(map.into_iter(), bucket => {
    result_key = bucket.key;
    result_val = bucket.value;
  });
  assert(result_key == i32(1));
  assert(result_val == i32(100));
});
test("HashMap into_iter - multiple entries all visited", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.insert(i32(3), i32(30));
  key_sum := i32(0);
  val_sum := i32(0);
  count := i32(0);
  for(map.into_iter(), bucket => {
    key_sum = (key_sum + bucket.key);
    val_sum = (val_sum + bucket.value);
    count = (count + i32(1));
  });
  assert(key_sum == i32(6));
  assert(val_sum == i32(60));
  assert(count == i32(3));
});
test("HashMap iter_ptr - yields pointers to buckets", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  val_sum := i32(0);
  for(map.iter(), ptr => {
    val_sum = (val_sum + ptr.*.value);
  });
  assert(val_sum == i32(30));
});
test("HashMap iter_ptr - mutate values through pointer", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  for(map.iter(), ptr => {
    ptr.*.value = (ptr.*.value * i32(10));
  });
  assert(map(i32(1)) == i32(100));
  assert(map(i32(2)) == i32(200));
});
test("HashMap for (b) => body iterates occupied buckets by value", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  val_sum := i32(0);
  for(map, b => {
    val_sum = (val_sum + b.value);
  });
  assert(val_sum == i32(30));
});
test("HashMap value-form bucket is a copy — writes do not reach the map", {
  // The value form yields `MapEntry(K, V)` STRUCT COPIES; in-place value
  // mutation goes through `set` (or `iter_ptr` in privileged code).
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  for(map, b => {
    b.value = (b.value * i32(10));
  });
  assert(map(i32(1)) == i32(10), "map unchanged — bucket was a copy");
  map.insert(i32(1), map(i32(1)) * i32(10));
  assert(map(i32(1)) == i32(100), "set updates the live value");
});
test("HashMap keys - yields all keys", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.insert(i32(3), i32(30));
  key_sum := i32(0);
  for(map.keys(), k => {
    key_sum = (key_sum + k);
  });
  assert(key_sum == i32(6));
});
test("HashMap values - yields all values", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(2), i32(20));
  map.insert(i32(3), i32(30));
  val_sum := i32(0);
  for(map.values(), v => {
    val_sum = (val_sum + v);
  });
  assert(val_sum == i32(60));
});
// Manual `it.next()` loops over keys()/values(). The wrapped-`_inner`
// delegation form of these iterators never advanced `_index` under manual
// iteration (a field method call on `inout(self)` advanced a COPY), yielding
// the first element forever — `for(...)` masked it. Includes re-set keys
// (the update path) since capture-usage promotion in the self-hosted
// evaluator re-sets the same key repeatedly.
test("HashMap keys - manual next() iteration terminates", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(1), i32(11));
  map.insert(i32(2), i32(20));
  it := map.keys();
  key_sum := i32(0);
  steps := i32(0);
  more := true;
  while(more && (steps < i32(10)), {
    match(
      it.next(),
      .None => {
        more = false;
      },
      .Some(k) => {
        key_sum = (key_sum + k);
        steps = (steps + i32(1));
      }
    );
  });
  assert(steps == i32(2), "keys() must terminate after yielding each key once");
  assert(key_sum == i32(3));
});
test("HashMap values - manual next() iteration terminates", {
  map := HashMap(i32, i32).new();
  map.insert(i32(1), i32(10));
  map.insert(i32(1), i32(11));
  map.insert(i32(2), i32(20));
  it := map.values();
  val_sum := i32(0);
  steps := i32(0);
  more := true;
  while(more && (steps < i32(10)), {
    match(
      it.next(),
      .None => {
        more = false;
      },
      .Some(v) => {
        val_sum = (val_sum + v);
        steps = (steps + i32(1));
      }
    );
  });
  assert(steps == i32(2), "values() must terminate after yielding each value once");
  assert(val_sum == i32(31));
});
// ============================================================================
// Entry-style accessors (plans/archive/STD_API_AUDIT.md §7 collections row)
// ============================================================================
test("get_or_insert inserts once and reads thereafter", {
  m := HashMap(String, i32).new();
  a := m.get_or_insert(`hits`.to_string(), i32(1));
  assert(a == i32(1), "inserted default");
  b := m.get_or_insert(`hits`.to_string(), i32(99));
  assert(b == i32(1), "existing wins over default");
  assert(m.len() == usize(1), "one entry");
});
test("get_or_insert_with defers construction", {
  m := HashMap(String, String).new();
  v := m.get_or_insert_with(`k`.to_string(), () => `built`.to_string());
  assert(v == `built`, "constructed on miss");
  v2 := m.get_or_insert_with(`k`.to_string(), () => `never`.to_string());
  assert(v2 == `built`, "hit skips make");
});
test("update_with maps present values only", {
  m := HashMap(String, i32).new();
  m.insert(`n`.to_string(), i32(10));
  did := m.update_with(`n`.to_string(), v => (v + i32(5)));
  assert(did, "updated");
  assert(match(m.get(`n`.to_string()), .Some(v) => (v == i32(15)), .None => false), "value mapped");
  did2 := m.update_with(`absent`.to_string(), v => v);
  assert(!did2, "absent is a no-op");
  assert(m.len() == usize(1), "no phantom insert");
});
// ===== Tombstone reclamation =====
// issues/fixed/hash-tombstones-are-never-reclaimed.md: `remove` wrote
// CTRL_DELETED and nothing ever counted it, so insert/remove churn filled the
// table with tombstones until every miss probed the whole capacity.
test("HashMap.remove of an isolated key leaves no tombstone", {
  map := HashMap(i32, i32).new();
  map.insert(i32(7), i32(1));
  map.remove(i32(7));
  assert(map.tombstones == usize(0), "a slot whose successor is EMPTY goes straight back to EMPTY");
  assert(map.len() == usize(0));
});
test("HashMap insert/remove churn keeps live + tombstones under the load threshold and stays correct", {
  map := HashMap(i32, i32).new();
  (k : i32) = i32(0);
  while(k < i32(2000), k = (k + i32(1)), {
    map.insert(k, k * i32(3));
  });
  cap0 := map.capacity;
  // Retire the oldest key and admit a new one, 20,000 times over 2,000 live entries.
  (n : i32) = i32(0);
  while(n < i32(20000), n = (n + i32(1)), {
    removed := map.remove(n);
    assert(removed.is_some(), "the oldest key is present");
    assert(removed.unwrap() == (n * i32(3)), "with its value");
    map.insert(i32(2000) + n, (i32(2000) + n) * i32(3));
    threshold := ((map.capacity * usize(7)) / usize(8));
    assert((map.len() + map.tombstones) <= threshold, "live + tombstones never exceeds the load threshold");
  });
  assert(map.len() == usize(2000), "size is unchanged by churn");
  assert(map.capacity == cap0, "a table that is mostly tombstones is rehashed in place, not doubled");
  (c : i32) = i32(20000);
  while(c < i32(22000), c = (c + i32(1)), {
    assert(map.get(c).unwrap() == (c * i32(3)), "every live key is reachable with its value");
  });
  (r : i32) = i32(0);
  while(r < i32(20000), r = (r + i32(1)), {
    assert(map.get(r).is_none(), "every retired key is gone");
  });
});
test("get_key_value returns the STORED key beside the value", {
  m := HashMap(i32, i32).new();
  m.insert(i32(1), i32(10));
  m.insert(i32(2), i32(20));
  assert(match(m.get_key_value(i32(1)), .Some(e) => ((e.key == i32(1)) && (e.value == i32(10))), .None => false), "present key");
  assert(match(m.get_key_value(i32(2)), .Some(e) => (e.value == i32(20)), .None => false), "other key");
  assert(match(m.get_key_value(i32(99)), .Some(_) => false, .None => true), "absent key is None");
  assert(m.len() == usize(2), "lookup does not mutate");
});
test("remove_entry hands back the entry it removed", {
  m := HashMap(i32, i32).new();
  m.insert(i32(1), i32(10));
  m.insert(i32(2), i32(20));
  assert(match(m.remove_entry(i32(1)), .Some(e) => ((e.key == i32(1)) && (e.value == i32(10))), .None => false), "returns the entry");
  assert(m.len() == usize(1), "length shrank");
  assert(m.contains_key(i32(1)) == false, "the key is gone");
  assert(match(m.remove_entry(i32(1)), .Some(_) => false, .None => true), "removing twice is None");
  assert(match(m.remove_entry(i32(2)), .Some(e) => (e.value == i32(20)), .None => false), "the survivor removes");
  assert(m.is_empty() == true, "map is empty");
});
// ===== Entry API =====
test("entry reports occupancy and hands back the key", {
  m := HashMap(i32, i32).new();
  m.insert(i32(1), i32(10));
  e := m.entry(i32(1));
  assert(e.is_occupied() == true, "present key is occupied");
  assert(e.is_vacant() == false, "and not vacant");
  assert(e.key() == i32(1), "the key it was looked up with");
  assert(match(e.value(), .Some(v) => (v == i32(10)), .None => false), "the stored value");
  v := m.entry(i32(2));
  assert(v.is_occupied() == false, "absent key is vacant");
  assert(match(v.value(), .Some(_) => false, .None => true), "a vacant entry has no value");
});
test("entry.or_insert returns the stored value and inserts only when vacant", {
  m := HashMap(i32, i32).new();
  assert(m.entry(i32(1)).or_insert(i32(10)) == i32(10), "vacant inserts the default");
  assert(m.len() == usize(1), "and grew the map");
  assert(m.entry(i32(1)).or_insert(i32(99)) == i32(10), "occupied keeps the stored value");
  assert(m.len() == usize(1), "and did not grow the map");
  assert(m.get(i32(1)).unwrap() == i32(10), "the stored value is untouched");
});
test("entry.or_insert_with only calls make on the vacant path", {
  m := HashMap(i32, i32).new();
  // The recorder is an ArrayList because a closure captures by VALUE, and an
  // ArrayList copy shares its buffer — an i32 counter would not come back out.
  calls := ArrayList(i32).new();
  assert(
    m.entry(i32(1)).or_insert_with(() => {
      calls.push(i32(1));
      i32(7)
    }) == i32(7),
    "vacant makes a value"
  );
  assert(calls.len() == usize(1), "make ran once");
  assert(
    m.entry(i32(1)).or_insert_with(() => {
      calls.push(i32(1));
      i32(9)
    }) == i32(7),
    "occupied returns the stored value"
  );
  assert(calls.len() == usize(1), "make did NOT run again");
});
test("entry.and_modify updates in place and chains into or_insert", {
  m := HashMap(i32, i32).new();
  m.entry(i32(1)).and_modify(n => (n + i32(1))).or_insert(i32(1));
  assert(m.get(i32(1)).unwrap() == i32(1), "first sighting inserts");
  m.entry(i32(1)).and_modify(n => (n + i32(1))).or_insert(i32(1));
  m.entry(i32(1)).and_modify(n => (n + i32(1))).or_insert(i32(1));
  assert(m.get(i32(1)).unwrap() == i32(3), "later sightings increment");
  assert(m.len() == usize(1), "the counter idiom keeps one entry");
});
test("entry.remove takes the entry out of the map", {
  m := HashMap(i32, i32).new();
  m.insert(i32(1), i32(10));
  assert(match(m.entry(i32(1)).remove(), .Some(v) => (v == i32(10)), .None => false), "returns the value");
  assert(m.contains_key(i32(1)) == false, "the key is gone");
  assert(match(m.entry(i32(1)).remove(), .Some(_) => false, .None => true), "a vacant entry removes nothing");
});
test("entry inserts correctly across the resize its own insert triggers", {
  m := HashMap(i32, i32).with_capacity(usize(16));
  // Fill to the load factor so the NEXT vacant insert has to resize, which
  // rehashes the table and invalidates the slot the probe found.
  (i : i32) = i32(0);
  while(i < i32(64), i = (i + i32(1)), {
    assert(m.entry(i).or_insert(i * i32(2)) == (i * i32(2)), "each fresh key inserts its default");
  });
  assert(m.len() == usize(64), "every key landed");
  (j : i32) = i32(0);
  while(j < i32(64), j = (j + i32(1)), {
    assert(m.get(j).unwrap() == (j * i32(2)), "and is reachable after the rehashes");
  });
});
test("entry reuses a tombstone rather than lengthening the chain", {
  m := HashMap(i32, i32).with_capacity(usize(16));
  m.insert(i32(1), i32(10));
  m.insert(i32(2), i32(20));
  m.insert(i32(3), i32(30));
  m.remove(i32(2));
  before := m.tombstones;
  cap := m.capacity;
  m.entry(i32(2)).or_insert(i32(22));
  assert(m.get(i32(2)).unwrap() == i32(22), "the key came back");
  assert(m.tombstones <= before, "reusing the slot did not add a tombstone");
  assert(m.capacity == cap, "and did not force a resize");
  assert(m.len() == usize(3), "with the other two intact");
  assert(m.get(i32(1)).unwrap() == i32(10), "key 1 survived");
  assert(m.get(i32(3)).unwrap() == i32(30), "key 3 survived");
});
test("entry works with an RC key and value type", {
  m := HashMap(String, String).new();
  m.entry(`a`).or_insert(`one`);
  m.entry(`a`).and_modify(s => (s + `!`));
  assert(m.get(`a`).unwrap() == `one!`, "and_modify replaced the value");
  m.entry(`b`).or_insert_with(() => `two`);
  assert(m.get(`b`).unwrap() == `two`, "or_insert_with stored its value");
  assert(m.len() == usize(2), "two entries");
  assert(match(m.entry(`a`).remove(), .Some(s) => (s == `one!`), .None => false), "remove hands the value back");
  assert(m.len() == usize(1), "one entry left");
});
// ===== retain / extend / FromIterator =====
test("retain keeps exactly the entries the predicate accepts", {
  m := HashMap(i32, i32).new();
  (i : i32) = i32(0);
  while(i < i32(20), i = (i + i32(1)), {
    m.insert(i, i * i32(10));
  });
  m.retain((k, _v) => ((k % i32(2)) == i32(0)));
  assert(m.len() == usize(10), "half the keys survive");
  (j : i32) = i32(0);
  while(j < i32(20), j = (j + i32(1)), {
    cond(
      ((j % i32(2)) == i32(0)) => {
        assert(m.get(j).unwrap() == (j * i32(10)), "an even key kept its value");
      },
      true => {
        assert(m.get(j).is_none(), "an odd key is gone");
      }
    );
  });
});
test("retain can see the value and can empty the map", {
  m := HashMap(i32, i32).new();
  m.insert(i32(1), i32(5));
  m.insert(i32(2), i32(50));
  m.retain((_k, v) => (v > i32(10)));
  assert(m.len() == usize(1), "one entry cleared the bar");
  assert(m.contains_key(i32(2)) == true, "the right one");
  m.retain((_k, _v) => false);
  assert(m.is_empty() == true, "rejecting everything empties the map");
  m.insert(i32(3), i32(30));
  assert(m.get(i32(3)).unwrap() == i32(30), "and the map is still usable");
});
test("retain over an RC-typed map", {
  m := HashMap(String, String).new();
  m.insert(`keep`, `yes`);
  m.insert(`drop`, `no`);
  m.retain((k, _v) => (k == `keep`));
  assert(m.len() == usize(1), "one survivor");
  assert(m.get(`keep`).unwrap() == `yes`, "with its value");
  assert(m.get(`drop`).is_none(), "the other is gone");
});
test("extend merges another map, overwriting on duplicates", {
  a := HashMap(i32, i32).new();
  a.insert(i32(1), i32(10));
  a.insert(i32(2), i32(20));
  b := HashMap(i32, i32).new();
  b.insert(i32(2), i32(99));
  b.insert(i32(3), i32(30));
  a.extend(b);
  assert(a.len() == usize(3), "the union of the key sets");
  assert(a.get(i32(1)).unwrap() == i32(10), "an untouched key");
  assert(a.get(i32(2)).unwrap() == i32(99), "a duplicate takes the other map's value");
  assert(a.get(i32(3)).unwrap() == i32(30), "a new key arrives");
  assert(b.len() == usize(2), "the source map is unchanged");
});
test("extend accepts any IntoIterator over entries, not just a map", {
  a := HashMap(i32, i32).new();
  a.insert(i32(1), i32(10));
  entries := ArrayList(MapEntry(i32, i32)).new();
  entries.push(MapEntry(i32, i32)(key : i32(2), value : i32(20)));
  entries.push(MapEntry(i32, i32)(key : i32(1), value : i32(99)));
  a.extend(entries);
  assert(a.len() == usize(2), "the list's entries arrived");
  assert(a.get(i32(2)).unwrap() == i32(20), "a new key");
  assert(a.get(i32(1)).unwrap() == i32(99), "and a duplicate overwrote");
});
test("extend from an empty map is a no-op", {
  a := HashMap(i32, i32).new();
  a.insert(i32(1), i32(10));
  a.extend(HashMap(i32, i32).new());
  assert(a.len() == usize(1), "nothing changed");
  assert(a.get(i32(1)).unwrap() == i32(10), "value intact");
});
test("collect builds a HashMap through FromIterator", {
  src := HashMap(i32, i32).new();
  src.insert(i32(1), i32(10));
  src.insert(i32(2), i32(20));
  out := src.into_iter().collect(HashMap(i32, i32));
  assert(out.len() == usize(2), "both entries arrived");
  assert(out.get(i32(1)).unwrap() == i32(10), "first entry");
  assert(out.get(i32(2)).unwrap() == i32(20), "second entry");
});
test("HashMap Default is the empty map", {
  m := HashMap(String, i32).default();
  assert(m.len() == usize(0), "default map is empty");
  m.insert(`k`, i32(1));
  assert(m.len() == usize(1), "the default map is a usable map");
});
