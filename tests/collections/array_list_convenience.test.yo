{ assert } :: import("std/assert");
open(import("std/collections/array_list"));
open(import("std/string"));
test("ArrayList contains finds existing element", {
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  assert(list.contains(i32(2)), "should contain 2");
});
test("ArrayList contains returns false for missing element", {
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  assert(!list.contains(i32(5)), "should not contain 5");
});
test("ArrayList contains on empty list", {
  list := ArrayList(i32).new();
  assert(!list.contains(i32(1)), "empty list should not contain anything");
});
test("ArrayList index_of finds element", {
  list := ArrayList(i32).new();
  list.push(i32(10));
  list.push(i32(20));
  list.push(i32(30));
  result := list.index_of(i32(20));
  assert(result.is_some(), "should find 20");
  assert(result.unwrap() == usize(1), "index should be 1");
});
test("ArrayList index_of returns None for missing", {
  list := ArrayList(i32).new();
  list.push(i32(10));
  list.push(i32(20));
  assert(list.index_of(i32(99)).is_none(), "should not find 99");
});
test("ArrayList index_of on empty list", {
  list := ArrayList(i32).new();
  assert(list.index_of(i32(1)).is_none(), "empty list index_of should be None");
});
test("ArrayList index_of finds first occurrence", {
  list := ArrayList(i32).new();
  list.push(i32(5));
  list.push(i32(3));
  list.push(i32(5));
  result := list.index_of(i32(5));
  assert(result.is_some(), "should find 5");
  assert(result.unwrap() == usize(0), "should return first index");
});
test("ArrayList reverse multiple elements", {
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  list.push(i32(4));
  list.reverse();
  assert(list(usize(0)) == i32(4), "first should be 4");
  assert(list(usize(1)) == i32(3), "second should be 3");
  assert(list(usize(2)) == i32(2), "third should be 2");
  assert(list(usize(3)) == i32(1), "fourth should be 1");
});
test("ArrayList reverse single element", {
  list := ArrayList(i32).new();
  list.push(i32(42));
  list.reverse();
  assert(list(usize(0)) == i32(42), "single element unchanged");
});
test("ArrayList reverse empty", {
  list := ArrayList(i32).new();
  list.reverse();
  assert(list.len() == usize(0), "empty list stays empty");
});
test("ArrayList reverse odd count", {
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  list.push(i32(4));
  list.push(i32(5));
  list.reverse();
  assert(list(usize(0)) == i32(5), "first should be 5");
  assert(list(usize(2)) == i32(3), "middle should be 3");
  assert(list(usize(4)) == i32(1), "last should be 1");
});
test("ArrayList sort unsorted elements", {
  list := ArrayList(i32).new();
  list.push(i32(3));
  list.push(i32(1));
  list.push(i32(4));
  list.push(i32(1));
  list.push(i32(5));
  list.push(i32(2));
  list.sort();
  assert(list(usize(0)) == i32(1), "index 0 should be 1");
  assert(list(usize(1)) == i32(1), "index 1 should be 1");
  assert(list(usize(2)) == i32(2), "index 2 should be 2");
  assert(list(usize(3)) == i32(3), "index 3 should be 3");
  assert(list(usize(4)) == i32(4), "index 4 should be 4");
  assert(list(usize(5)) == i32(5), "index 5 should be 5");
});
test("ArrayList sort already sorted", {
  list := ArrayList(i32).new();
  list.push(i32(1));
  list.push(i32(2));
  list.push(i32(3));
  list.sort();
  assert(list(usize(0)) == i32(1), "first should be 1");
  assert(list(usize(1)) == i32(2), "second should be 2");
  assert(list(usize(2)) == i32(3), "third should be 3");
});
test("ArrayList sort reverse sorted", {
  list := ArrayList(i32).new();
  list.push(i32(5));
  list.push(i32(4));
  list.push(i32(3));
  list.push(i32(2));
  list.push(i32(1));
  list.sort();
  assert(list(usize(0)) == i32(1), "first should be 1");
  assert(list(usize(1)) == i32(2), "second should be 2");
  assert(list(usize(2)) == i32(3), "third should be 3");
  assert(list(usize(3)) == i32(4), "fourth should be 4");
  assert(list(usize(4)) == i32(5), "fifth should be 5");
});
test("ArrayList sort single element", {
  list := ArrayList(i32).new();
  list.push(i32(42));
  list.sort();
  assert(list(usize(0)) == i32(42), "single element unchanged");
});
test("ArrayList sort empty", {
  list := ArrayList(i32).new();
  list.sort();
  assert(list.len() == usize(0), "empty list stays empty");
});
// ============================================================================
// Real sort (heapsort), sort_by, binary_search, retain, extend
// (plans/STD_API_AUDIT.md §7 collections row)
// ============================================================================
test("sort handles large shuffled input (heapsort, was O(n^2))", {
  list := ArrayList(i32).new();
  // Deterministic pseudo-shuffle: i*7919 mod 104729 over 2000 elements.
  (i : i32) = i32(0);
  while(i < i32(2000), i = (i + i32(1)), {
    list.push((i * i32(7919)) % i32(104729));
  });
  list.sort();
  (j : usize) = usize(1);
  (ordered : bool) = true;
  while(j < list.len(), j = (j + usize(1)), {
    cond(
      (list(j - usize(1)) > list(j)) => {
        ordered = false;
      },
      true => ()
    );
  });
  assert(ordered, "2000 elements ascending");
  assert(list.len() == usize(2000), "length preserved");
});
test("sort_by orders by the supplied less", {
  list := ArrayList(i32).new();
  list.push(i32(3));
  list.push(i32(1));
  list.push(i32(2));
  list.sort_by((a, b) => (a > b));
  assert(list(usize(0)) == i32(3), "descending head");
  assert(list(usize(1)) == i32(2), "descending mid");
  assert(list(usize(2)) == i32(1), "descending tail");
});
test("binary_search finds and reports insertion points", {
  list := ArrayList(i32).new();
  list.push(i32(10));
  list.push(i32(20));
  list.push(i32(30));
  list.push(i32(40));
  assert(match(list.binary_search(i32(30)), .Ok(at) => (at == usize(2)), .Err(_) => false), "found 30 at 2");
  assert(match(list.binary_search(i32(10)), .Ok(at) => (at == usize(0)), .Err(_) => false), "found head");
  assert(match(list.binary_search(i32(25)), .Ok(_) => false, .Err(at) => (at == usize(2))), "25 inserts at 2");
  assert(match(list.binary_search(i32(5)), .Ok(_) => false, .Err(at) => (at == usize(0))), "5 inserts at 0");
  assert(match(list.binary_search(i32(99)), .Ok(_) => false, .Err(at) => (at == usize(4))), "99 inserts at end");
});
test("retain keeps order and drops rejects", {
  list := ArrayList(i32).new();
  (i : i32) = i32(1);
  while(i <= i32(10), i = (i + i32(1)), {
    list.push(i);
  });
  list.retain(v => ((v % i32(2)) == i32(0)));
  assert(list.len() == usize(5), "five evens kept");
  assert(list(usize(0)) == i32(2), "order preserved head");
  assert(list(usize(4)) == i32(10), "order preserved tail");
});
test("retain drops RC elements without leaks or double-drops", {
  list := ArrayList(String).new();
  list.push(`keep-a`.to_string());
  list.push(`drop-b`.to_string());
  list.push(`keep-c`.to_string());
  list.retain(v => v.starts_with(`keep`));
  assert(list.len() == usize(2), "two kept");
  assert(list(usize(0)) == `keep-a`, "a kept");
  assert(list(usize(1)) == `keep-c`, "c kept");
});
test("extend appends copies", {
  a := ArrayList(i32).new();
  a.push(i32(1));
  b := ArrayList(i32).new();
  b.push(i32(2));
  b.push(i32(3));
  a.extend(b);
  assert(a.len() == usize(3), "extended length");
  assert(a(usize(2)) == i32(3), "tail from other");
  assert(b.len() == usize(2), "source untouched");
});
test("sort and sort_by handle RC (String) elements", {
  list := ArrayList(String).new();
  list.push(`pear`.to_string());
  list.push(`apple`.to_string());
  list.push(`mango`.to_string());
  list.push(`fig`.to_string());
  list.sort();
  assert(list(usize(0)) == `apple`, "sorted head");
  assert(list(usize(3)) == `pear`, "sorted tail");
  list.sort_by((a, b) => (b < a));
  assert(list(usize(0)) == `pear`, "descending head");
  assert(list(usize(3)) == `apple`, "descending tail");
  assert(list.len() == usize(4), "no element lost");
});
test("retain over twenty thousand elements is one pass and leaves refcounts balanced", {
  // issues/fixed/array-list-retain-is-quadratic.md: the previous shape called
  // drain(i .. i + 1) per rejection — O(n²) and an allocation each. The
  // survivors share ONE RC value so its refcount is the leak / double-drop
  // witness: every kept slot holds a reference, every dropped slot released
  // one, and clear() takes it back to the baseline.
  shared := `keep-shared`.to_string();
  base := rc(shared);
  list := ArrayList(String).new();
  (i : i32) = i32(0);
  while(i < i32(20000), i = (i + i32(1)), {
    cond(
      ((i % i32(4)) == i32(0)) => {
        list.push(shared);
      },
      true => {
        list.push(`drop-${i}`.to_string());
      }
    );
  });
  with_all := rc(shared);
  list.retain(v => v.starts_with(`keep`));
  assert(list.len() == usize(5000), "one in four kept");
  assert(list(usize(0)) == `keep-shared`, "head kept");
  assert(list(usize(4999)) == `keep-shared`, "tail kept");
  assert(rc(shared) == with_all, "every surviving slot still holds exactly one reference");
  list.retain(v => false);
  assert(list.len() == usize(0), "reject everything");
  assert(rc(shared) == base, "all references released, none double-released");
});
// ===== D17: sort is STABLE; sort_unstable is the heapsort =====
// plans/STD_API_STABILIZATION.md D17. `sort` was heapsort under Rust's name,
// so equal elements reordered: the witness below returned
// `0:6 0:2 0:0 0:4 1:5 1:7 1:3 1:1` before this change.
_SortRec :: struct(key : i32, tag : i32);
test("sort_by is stable: equal keys keep their input order", {
  xs := ArrayList(_SortRec).new();
  i := i32(0);
  while(runtime(i < i32(8)), {
    xs.push(_SortRec(key : (i % i32(2)), tag : i));
    i = (i + i32(1));
  });
  xs.sort_by((a, b) => (a.key < b.key));
  // Keys ascending, and within each key the tags stay in insertion order.
  expect_tags := ArrayList(i32).new();
  expect_tags.push(i32(0));
  expect_tags.push(i32(2));
  expect_tags.push(i32(4));
  expect_tags.push(i32(6));
  expect_tags.push(i32(1));
  expect_tags.push(i32(3));
  expect_tags.push(i32(5));
  expect_tags.push(i32(7));
  j := usize(0);
  while(runtime(j < xs.len()), {
    assert(xs(j).tag == expect_tags(j), `stable order at ${j}: got tag ${xs(j).tag}, want ${expect_tags(j)}`);
    j = (j + usize(1));
  });
});
test("sort orders correctly with duplicates", {
  ns := ArrayList(i32).new();
  ns.push(i32(5));
  ns.push(i32(1));
  ns.push(i32(4));
  ns.push(i32(1));
  ns.push(i32(3));
  ns.sort();
  assert(ns(usize(0)) == i32(1), "0");
  assert(ns(usize(1)) == i32(1), "1");
  assert(ns(usize(2)) == i32(3), "2");
  assert(ns(usize(3)) == i32(4), "3");
  assert(ns(usize(4)) == i32(5), "4");
});
test("sort_unstable still sorts (heapsort path retained)", {
  us := ArrayList(i32).new();
  us.push(i32(9));
  us.push(i32(2));
  us.push(i32(7));
  us.push(i32(2));
  us.sort_unstable();
  assert(us(usize(0)) == i32(2), "a");
  assert(us(usize(1)) == i32(2), "b");
  assert(us(usize(2)) == i32(7), "c");
  assert(us(usize(3)) == i32(9), "d");
});
test("sort_unstable_by sorts by a supplied comparator", {
  us := ArrayList(i32).new();
  us.push(i32(1));
  us.push(i32(9));
  us.push(i32(5));
  us.sort_unstable_by((a, b) => (b < a));
  assert(us(usize(0)) == i32(9), "descending head");
  assert(us(usize(2)) == i32(1), "descending tail");
});
test("sort of an empty or single-element list is a no-op", {
  e := ArrayList(i32).new();
  e.sort();
  assert(e.len() == usize(0), "empty stays empty");
  s := ArrayList(i32).new();
  s.push(i32(42));
  s.sort();
  assert((s.len() == usize(1)) && (s(usize(0)) == i32(42)), "single element preserved");
});
test("sort is stable across a larger run with many ties", {
  xs := ArrayList(_SortRec).new();
  i := i32(0);
  while(runtime(i < i32(64)), {
    xs.push(_SortRec(key : (i % i32(4)), tag : i));
    i = (i + i32(1));
  });
  xs.sort_by((a, b) => (a.key < b.key));
  ok := true;
  j := usize(1);
  while(runtime(j < xs.len()), {
    prev := xs(j - usize(1));
    cur := xs(j);
    // ascending by key, and ties strictly increasing by original tag
    if(cur.key < prev.key, {
      ok = false;
    });
    if((cur.key == prev.key) && (cur.tag < prev.tag), {
      ok = false;
    });
    j = (j + usize(1));
  });
  assert(ok, "64 elements with 4 distinct keys stay stable");
});
