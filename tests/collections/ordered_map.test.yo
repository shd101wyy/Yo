{ assert } :: import("std/assert");
{ OrderedMap, MapEntry } :: import("std/collections/ordered_map");
open(import("std/collections/array_list"));
open(import("std/string"));
test("OrderedMap empty new", {
  m := OrderedMap(String, i32).new();
  assert(m.len() == usize(0), "new map should be empty");
  assert(m.is_empty(), "is_empty true");
  assert(!(m.contains_key(`x`)), "contains_key false");
  assert(m.get(`x`).is_none(), "get returns None");
});
test("OrderedMap set and get", {
  m := OrderedMap(String, i32).new();
  r1 := m.insert(`a`, i32(1));
  assert(r1.is_ok(), "set ok");
  assert(r1.unwrap().is_none(), "no previous value");
  r2 := m.insert(`b`, i32(2));
  assert(r2.is_ok(), "set ok");
  assert(m.len() == usize(2), "len 2");
  assert(m.contains_key(`a`), "has a");
  assert(m.contains_key(`b`), "has b");
  assert(m.get(`a`).unwrap() == i32(1), "a is 1");
  assert(m.get(`b`).unwrap() == i32(2), "b is 2");
});
test("OrderedMap update existing key preserves order", {
  m := OrderedMap(String, i32).new();
  r1 := m.insert(`alpha`, i32(1));
  r2 := m.insert(`beta`, i32(2));
  r3 := m.insert(`gamma`, i32(3));
  assert(r1.is_ok(), "ok1");
  assert(r2.is_ok(), "ok2");
  assert(r3.is_ok(), "ok3");
  // Update beta
  r4 := m.insert(`beta`, i32(20));
  assert(r4.is_ok(), "update ok");
  old := r4.unwrap();
  assert(old.is_some(), "should have old value");
  assert(old.unwrap() == i32(2), "old was 2");
  assert(m.len() == usize(3), "len still 3");
  assert(m.get(`beta`).unwrap() == i32(20), "new value");
  // Iteration order should still be alpha, beta, gamma
  it := m.keys();
  k1 := it.next().unwrap();
  k2 := it.next().unwrap();
  k3 := it.next().unwrap();
  assert(k1 == `alpha`, "first alpha");
  assert(k2 == `beta`, "second beta");
  assert(k3 == `gamma`, "third gamma");
  assert(it.next().is_none(), "no more");
});
test("OrderedMap iteration in insertion order", {
  m := OrderedMap(String, i32).new();
  m.insert(`z`, i32(26));
  m.insert(`a`, i32(1));
  m.insert(`m`, i32(13));
  // keys
  ks := ArrayList(String).new();
  it := m.keys();
  while(true, {
    n := it.next();
    cond(
      n.is_none() => break,
      true => {
        ks.push(n.unwrap());
      }
    );
  });
  assert(ks.len() == usize(3), "3 keys");
  assert(ks(usize(0)) == `z`, "z first");
  assert(ks(usize(1)) == `a`, "a second");
  assert(ks(usize(2)) == `m`, "m third");
  // values
  vs := ArrayList(i32).new();
  vit := m.values();
  while(true, {
    n := vit.next();
    cond(
      n.is_none() => break,
      true => {
        vs.push(n.unwrap());
      }
    );
  });
  assert(vs.len() == usize(3), "3 values");
  assert(vs(usize(0)) == i32(26), "26 first");
  assert(vs(usize(1)) == i32(1), "1 second");
  assert(vs(usize(2)) == i32(13), "13 third");
});
test("OrderedMap iter pairs", {
  m := OrderedMap(String, i32).new();
  m.insert(`one`, i32(1));
  m.insert(`two`, i32(2));
  it := m.iter();
  e1 := it.next().unwrap();
  e2 := it.next().unwrap();
  assert(it.next().is_none(), "two entries");
  assert(e1.key == `one`, "first key");
  assert(e1.value == i32(1), "first value");
  assert(e2.key == `two`, "second key");
  assert(e2.value == i32(2), "second value");
});
test("OrderedMap remove", {
  m := OrderedMap(String, i32).new();
  m.insert(`a`, i32(1));
  m.insert(`b`, i32(2));
  m.insert(`c`, i32(3));
  removed := m.remove(`b`);
  assert(removed.is_some(), "removed");
  assert(removed.unwrap() == i32(2), "old value 2");
  assert(m.len() == usize(2), "len 2");
  assert(!(m.contains_key(`b`)), "b gone");
  // Order should be a, c
  it := m.keys();
  k1 := it.next().unwrap();
  k2 := it.next().unwrap();
  assert(it.next().is_none(), "two keys");
  assert(k1 == `a`, "a first");
  assert(k2 == `c`, "c second");
  // Removing missing key
  miss := m.remove(`z`);
  assert(miss.is_none(), "miss none");
  assert(m.len() == usize(2), "len unchanged");
});
test("OrderedMap clear", {
  m := OrderedMap(String, i32).new();
  m.insert(`a`, i32(1));
  m.insert(`b`, i32(2));
  m.clear();
  assert(m.len() == usize(0), "len 0");
  assert(m.is_empty(), "is empty");
  assert(m.keys().next().is_none(), "no keys");
});
test("OrderedMap re-insert after remove appends to end", {
  m := OrderedMap(String, i32).new();
  m.insert(`a`, i32(1));
  m.insert(`b`, i32(2));
  m.insert(`c`, i32(3));
  m.remove(`a`);
  m.insert(`a`, i32(99));
  it := m.keys();
  k1 := it.next().unwrap();
  k2 := it.next().unwrap();
  k3 := it.next().unwrap();
  assert(k1 == `b`, "b first");
  assert(k2 == `c`, "c second");
  assert(k3 == `a`, "a last (re-inserted)");
  assert(m.get(`a`).unwrap() == i32(99), "a is 99");
});
test("OrderedMap many entries preserves order", {
  m := OrderedMap(String, i32).new();
  i := i32(0);
  while(i < i32(50), i = (i + i32(1)), {
    key := i.to_string();
    m.insert(key, i);
  });
  assert(m.len() == usize(50), "50 entries");
  it := m.keys();
  expected := i32(0);
  while(true, {
    n := it.next();
    cond(
      n.is_none() => break,
      true => {
        k := n.unwrap();
        assert(k == expected.to_string(), "in order");
        expected = (expected + i32(1));
      }
    );
  });
  assert(expected == i32(50), "saw all 50");
});
