// ListView — safe alias windows over ArrayList (plans/SLICE_REWORK.md §3).
open(import("std/fmt"));
{ ArrayList } :: import("../../std/collections/array_list");
{ ListView } :: import("../../std/collections/list_view");
test("ListView reads through the live backing", {
  l := ArrayList(i32).new();
  ___1 := l.push(i32(10));
  ___2 := l.push(i32(20));
  ___3 := l.push(i32(30));
  v := ListView(i32).new(l, usize(1), usize(2));
  assert(v.len() == usize(2), "window length");
  assert(match(v.get(usize(0)),.Some(x) => (x == i32(20)),.None => false), "windowed read");
  assert(match(v.get(usize(2)),.Some(_) => false,.None => true), "out of window is None");
});
test("ListView sees alias mutations (alias semantics, not snapshot)", {
  l := ArrayList(i32).new();
  ___1 := l.push(i32(1));
  ___2 := l.push(i32(2));
  v := ListView(i32).of(l);
  l(usize(1)) = i32(99);
  assert(match(v.get(usize(1)),.Some(x) => (x == i32(99)),.None => false), "mutation visible through view");
});
test("ListView survives realloc growth (reads via the live handle)", {
  l := ArrayList(i32).new();
  ___1 := l.push(i32(7));
  v := ListView(i32).of(l);
  i := usize(0);
  while(i < usize(1000), i = (i + usize(1)), {
    ___ := l.push(i32(1));
  });
  assert(match(v.get(usize(0)),.Some(x) => (x == i32(7)),.None => false), "no stale pointer after realloc");
});
test("ListView shrinkage yields clean None, never UB", {
  l := ArrayList(i32).new();
  ___1 := l.push(i32(1));
  ___2 := l.push(i32(2));
  v := ListView(i32).of(l);
  l.clear();
  assert(match(v.get(usize(0)),.Some(_) => false,.None => true), "read after clear is None");
});
test("ListView sub-views and owned copies", {
  l := ArrayList(i32).new();
  (k : i32) = i32(0);
  while(k < i32(5), k = (k + i32(1)), {
    ___ := l.push(k);
  });
  v := ListView(i32).new(l, usize(1), usize(3));
  sub := v.view(usize(1), usize(2));
  assert(match(sub.get(usize(0)),.Some(x) => (x == i32(2)),.None => false), "sub-view offset composes");
  owned := sub.to_list();
  assert(owned.len() == usize(2), "owned copy length");
  l(usize(2)) = i32(100);
  assert(match(owned.get(usize(0)),.Some(x) => (x == i32(2)),.None => false), "owned copy is independent");
});
