pragma(Pragma.SkipWasm32Emscripten); // no process model in WASM
pragma(Pragma.SkipWasm32Wasi); // no process model in WASM
{ assert } :: import("std/assert");
{ Command, ExitStatus, Output, Child, Stdio } :: import("std/process/command");
{ Exception, AnyError, IoExn } :: import("std/error");
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ platform, Platform } :: import("std/process");
test("Command.new + status (echo exits 0)", {
  exn := Exception(
    throw : (
      (err) -> {
        unwind(());
      }
    )
  );
  cmd := cond(
    (platform == Platform.Windows) => {
      c := Command.new(`cmd.exe`);
      c.arg(`/C`);
      c.arg(`echo`);
      c.arg(`hi`);
      c
    },
    true => {
      c := Command.new(`echo`);
      c.arg(`hi`);
      c
    }
  );
  st := io.await(cmd.status(io), IoExn(io : io, exn : exn));
  assert(st.success(), "echo should succeed");
  assert(st.code().unwrap() == i32(0), "echo exit code 0");
});
test("Command.output captures stdout", {
  exn := Exception(
    throw : (
      (err) -> {
        unwind(());
      }
    )
  );
  cmd := cond(
    (platform == Platform.Windows) => {
      c := Command.new(`cmd.exe`);
      c.arg(`/C`);
      c.arg(`echo`);
      c.arg(`yo_out_test`);
      c
    },
    true => {
      c := Command.new(`echo`);
      c.arg(`yo_out_test`);
      c
    }
  );
  out := io.await(cmd.output(io), IoExn(io : io, exn : exn));
  assert(out.status.success(), "status success");
  assert(out.stdout.len() >= usize(11), "stdout has at least 11 bytes");
  assert(out.stdout(usize(0)) == u8(121), "y");
  assert(out.stdout(usize(1)) == u8(111), "o");
  assert(out.stdout(usize(2)) == u8(95), "_");
  assert(out.stdout(usize(10)) == u8(116), "t");
});
test("Command.status non-zero exit", {
  exn := Exception(
    throw : (
      (err) -> {
        unwind(());
      }
    )
  );
  cmd := cond(
    (platform == Platform.Windows) => {
      c := Command.new(`cmd.exe`);
      c.arg(`/C`);
      c.arg(`exit`);
      c.arg(`1`);
      c
    },
    true => Command.new(`false`)
  );
  st := io.await(cmd.status(io), IoExn(io : io, exn : exn));
  assert(!(st.success()), "should not be success");
  assert(st.code().unwrap() == i32(1), "exit code 1");
});

// ============================================================================
// S3 P0 item 5: Child / spawn / Stdio / env (plans/STD_API_AUDIT.md)
// ============================================================================
test("spawn with piped stdin/stdout: write, EOF, read back, wait", {
  // POSIX-only (the Child/spawn plumbing is posix_spawn + pipes + fcntl;
  // /bin/* paths besides — see issues/s3-fs-wrappers-windows-semantics-audit.md
  // for the recorded Windows-coverage debt).
  if(platform == Platform.Windows, {
    unsafe(printf("  skipped on windows\n"));
    return(());
  });
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  cmd := Command.new(`/bin/cat`.to_string());
  cmd.stdin(Stdio.Piped).stdout(Stdio.Piped);
  child := io.await(cmd.spawn(io), e);
  assert(child.pid() > i32(0), "got a pid");
  payload := `piped héllo`.to_string().as_bytes();
  n := io.await(child.write_stdin(payload, io), e);
  assert(n == usize(12), "wrote 12 UTF-8 bytes");
  io.await(child.close_stdin(io), e);
  out := io.await(child.read_stdout_to_end(io), e);
  assert(out.len() == usize(12), "cat echoed everything");
  assert(out(usize(0)) == u8(112), "p");
  st := io.await(child.wait(io), e);
  assert(st.success(), "cat exits 0");
  assert(st.code().unwrap() == i32(0), "code Some(0)");
});
test("env override and env_clear reach the child", {
  // POSIX-only (the Child/spawn plumbing is posix_spawn + pipes + fcntl;
  // /bin/* paths besides — see issues/s3-fs-wrappers-windows-semantics-audit.md
  // for the recorded Windows-coverage debt).
  if(platform == Platform.Windows, {
    unsafe(printf("  skipped on windows\n"));
    return(());
  });
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  cmd := Command.new(`/bin/sh`.to_string());
  cmd.arg(`-c`.to_string()).arg(`printf %s "$YO_CMD_TEST-$HOME"`.to_string());
  cmd.env(`YO_CMD_TEST`.to_string(), `injected`.to_string());
  out := io.await(cmd.output(io), e);
  s := String.from_bytes(out.stdout);
  assert(s.starts_with("injected-"), "override visible, HOME inherited");
  assert(s.len() > usize(9), "HOME non-empty when inherited");
  cmd2 := Command.new(`/bin/sh`.to_string());
  cmd2.arg(`-c`.to_string()).arg(`printf %s "$YO_CMD_TEST-$HOME"`.to_string());
  cmd2.env(`YO_CMD_TEST`.to_string(), `only`.to_string()).env_clear();
  out2 := io.await(cmd2.output(io), e);
  s2 := String.from_bytes(out2.stdout);
  assert(s2 == `only-`, "env_clear drops HOME, keeps the override");
});
test("a signal death is code None, not exit 0", {
  // POSIX-only (the Child/spawn plumbing is posix_spawn + pipes + fcntl;
  // /bin/* paths besides — see issues/s3-fs-wrappers-windows-semantics-audit.md
  // for the recorded Windows-coverage debt).
  if(platform == Platform.Windows, {
    unsafe(printf("  skipped on windows\n"));
    return(());
  });
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  cmd := Command.new(`/bin/sleep`.to_string());
  cmd.arg(`5`.to_string());
  child := io.await(cmd.spawn(io), e);
  k := child.kill(i32(9));
  assert(k == i32(0), "kill delivered");
  st := io.await(child.wait(io), e);
  assert(st.code().is_none(), "signal death has NO exit code");
  assert(st.signal() == i32(9), "SIGKILL recorded");
  assert(st.success() == false, "not a success");
});
test("Stdio.Null discards child stdout", {
  // POSIX-only (the Child/spawn plumbing is posix_spawn + pipes + fcntl;
  // /bin/* paths besides — see issues/s3-fs-wrappers-windows-semantics-audit.md
  // for the recorded Windows-coverage debt).
  if(platform == Platform.Windows, {
    unsafe(printf("  skipped on windows\n"));
    return(());
  });
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected exception");
        unwind(());
      }
    )
  );
  e := IoExn(io : io, exn : exn);
  cmd := Command.new(`/bin/echo`.to_string());
  cmd.arg(`discarded`.to_string()).stdout(Stdio.Null);
  child := io.await(cmd.spawn(io), e);
  st := io.await(child.wait(io), e);
  assert(st.success(), "echo to /dev/null exits 0");
});
