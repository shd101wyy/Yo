{ assert } :: import("std/assert");
// Regression test for: a top-level `fn` whose body installs a
// `exn := Exception(throw: ((err) -> { unwind(); }))` handler
// must still be registered as a standalone C function when called as
// a regular (non-handler) function from multiple call sites.
//
// Bug: Previously `collection.ts` flagged such functions as
// `isControlFunction=true` (because the body contains `unwind`) and
// only inlined via state machine, never registering a named C function.
// This caused "Unhandled function call" errors when the function was
// called from several sites (e.g. main thread + spawned workers).
//
// Fix: When a control function is called as a regular function, register
// it and mark `isEffectRecordMember=true` so `generateEscape` uses the
// thread-local `__yo_effect_escaped` flag for escape propagation.
pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));
{ Exception, Error, AnyError } :: import("std/error");
{ yield } :: import("std/async");
{ ThreadPool, spawn } :: import("std/thread");
// Top-level fn with a locally installed effect handler that escapes.
// The body pattern mirrors a server accept loop: install handler,
// perform some async operations, return via `return ()` on early exit.
do_work :: (fn(iterations : i32, io : Io) -> i32)({
  exn := Exception(
    throw : (
      (err) -> {
        unsafe(printf("do_work: unexpected exception\n"));
        unwind(i32(-(1)));
      }
    )
  );
  // An await forces this function to be a state-machine function.
  io.await(yield(io), io);
  total := i32(0);
  i := i32(0);
  while(runtime(i < iterations), {
    total = (total + i);
    i = (i + i32(1));
  });
  return(total);
});
test("control fn called as regular function from single site", {
  result := do_work(i32(10), io);
  assert(result == i32(45), "sum 0..9 should be 45");
});
test("control fn called as regular function from multiple sites", {
  // Multiple direct call sites in the same scope — exercises that the
  // function is registered once and dispatched by name at each site.
  a := do_work(i32(5), io);
  b := do_work(i32(6), io);
  c := do_work(i32(7), io);
  assert(a == i32(10), "sum 0..4");
  assert(b == i32(15), "sum 0..5");
  assert(c == i32(21), "sum 0..6");
});
test("control fn called from worker closures", {
  // Match the yo_http_benchmark multi-threaded pattern: call the
  // control fn from main AND from a ThreadPool task closure.
  pool := ThreadPool.new(usize(2));
  spawn(pool, (io) => {
    r := do_work(i32(4), io);
    assert(r == i32(6), "worker sum 0..3 should be 6");
  });
  main_result := do_work(i32(4), io);
  assert(main_result == i32(6), "main sum 0..3 should be 6");
  // Without this the pool task is fire-and-forget and its assertion may never
  // run before the test ends — the check would pass vacuously.
  pool.join_all();
});
