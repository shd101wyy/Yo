// std/fs/temp.yo - Temporary files and directories
//
// Creates temporary files and directories using mkdtemp / mkstemp from std/io/temp.
// The caller is responsible for cleanup — use remove_dir_all / remove_file when done.
//
// Example:
//   { TempDir, TempFile } :: import "std/fs/temp";
//
//   dir := TempDir.new().unwrap();
//   println(dir.path());
//   dir.remove();   // explicit cleanup

open import "../string";
{ ArrayList } :: import "../collections/array_list";
{ IOError } :: import "../io/errors";
{ Exception } :: import "../error/exception";
{ mkdtemp, mkstemp } :: import "../io/temp";
{ File } :: import "./file";
{ remove_dir_all, remove_file } :: import "./dir";
{ platform, Platform } :: import "../process";

// ============================================================================
// TempDir
// ============================================================================

TempDir :: object(
  _path    : String,
  _removed : bool
);

impl(TempDir,
  // Create a temporary directory in the system temp directory.
  new : (fn(using(io : IO, exception : Exception(IOError))) -> Impl(Future(Self)))(
    io.await(TempDir.new_in(_temp_base()))
  ),

  // Create a temporary directory inside `parent`.
  new_in : (fn(parent: String, using(io : IO, exception : Exception(IOError))) -> Impl(Future(Self)))({
    sep      := String.from("/yo-tmp-XXXXXX");
    template := parent.concat(sep);
    template_cstr := template.to_cstr();
    template_ptr  := *(u8)(template_cstr.ptr().unwrap());
    result := mkdtemp(template_ptr);
    cond(
      (result < i32(0)) => exception.throw(IOError.from_errno((i32(0) - result))),
      true => {
        actual_path := String.from_cstr(template_ptr).unwrap();
        Self(_path: actual_path, _removed: false)
      }
    )
  }),

  // Return the directory path.
  path : (fn(self: Self) -> String)(
    self._path
  ),

  // Explicitly remove the temporary directory and all its contents.
  remove : (fn(self: Self, using(io : IO, exception : Exception(IOError))) -> Impl(Future(unit)))({
    cond(
      self._removed => (),
      true => {
        io.await(remove_dir_all(self._path));
        self._removed = true;
        ()
      }
    )
  })
);

export TempDir;

// ============================================================================
// TempFile
// ============================================================================

TempFile :: object(
  file  : File,
  _path : String
);

impl(TempFile,
  // Create a temporary file in the system temp directory.
  new : (fn(using(io : IO, exception : Exception(IOError))) -> Impl(Future(Self)))(
    io.await(TempFile.new_in(_temp_base()))
  ),

  // Create a temporary file inside `parent`.
  new_in : (fn(parent: String, using(io : IO, exception : Exception(IOError))) -> Impl(Future(Self)))({
    sep      := String.from("/yo-tmp-XXXXXX");
    template := parent.concat(sep);
    template_cstr := template.to_cstr();
    template_ptr  := *(u8)(template_cstr.ptr().unwrap());
    fd := mkstemp(template_ptr);
    cond(
      (fd < i32(0)) => exception.throw(IOError.from_errno((i32(0) - fd))),
      true => {
        actual_path := String.from_cstr(template_ptr).unwrap();
        f := File(
          fd:         fd,
          path:       actual_path,
          _read_buf:  ArrayList(u8).new(),
          _write_buf: ArrayList(u8).new(),
          _position:  i64(0),
          _is_closed: false
        );
        Self(file: f, _path: actual_path)
      }
    )
  }),

  // Return the file path.
  path : (fn(self: Self) -> String)(
    self._path
  ),

  // Close and remove the temporary file.
  remove : (fn(self: Self, using(io : IO, exception : Exception(IOError))) -> Impl(Future(unit)))({
    io.await(self.file.close());
    io.await(remove_file(self._path))
  })
);

export TempFile;

// ============================================================================
// Internal helper
// ============================================================================

_temp_base :: (fn() -> String)(
  cond(
    (platform == Platform.Win32) => String.from("C:\\Temp"),
    true                         => String.from("/tmp")
  )
);
