//! RAII-managed temporary files and directories.
//!
//! Both types clean up on drop (`Drop`), BEST-EFFORT: errors are ignored,
//! and directory removal is non-recursive (same as `remove` — it succeeds
//! only when the directory is empty). Call `remove(io)` explicitly when you
//! need to observe removal errors.
//!
//! ## Example
//!
//! ```yo
//! { TempDir } :: import("std/fs/temp");
//!
//! main :: (fn(io : Io, exn : Exception) -> unit)({
//!   dir := io.await(TempDir.new(io), { io, exn });
//!   println(dir.path());
//!   io.await(dir.remove(io), { io, exn }); // or let Drop clean up on drop
//! });
//! ```
//!
//! ## Platform caveat — Windows naming is not atomic
//!
//! `mkdtemp`/`mkstemp` are POSIX primitives that PICK the name and CREATE
//! the entry in one uninterruptible step, retrying until they win. The
//! Windows runtime cannot: it calls `_wmktemp_s` to invent a name and then
//! `_wmkdir`/`_wopen(_O_CREAT | _O_EXCL)` to create it
//! (`src/codegen/async/runtime_io_windows.yo`). That leaves a window between
//! the two, and `_wmktemp_s` offers only 26 candidate names per template per
//! process with no retry here, so both constructors can throw `EEXIST` on
//! Windows where POSIX would simply pick another name
//! (`issues/stddoc-io-windows-temp-naming-is-not-atomic.md`). Treat a
//! `TempDir`/`TempFile` construction as fallible on that platform even when
//! the parent directory is perfectly writable.
//!
//! ## Stability
//!
//! unstable — the naming half of `tempfile`'s API is missing and adding it
//! changes what these types are. Both spellings here are NAMED temporaries
//! (Rust's `NamedTempFile`, `TempDir`): the name is fixed at
//! `<parent>/yo_tmp_XXXXXX` with no way to set the prefix, the suffix, or a
//! number of random characters — `tempfile`'s `Builder` — and there is no
//! unnamed `tempfile()`, the form that unlinks immediately so the file
//! cannot leak if the process dies. `keep()`/`into_path()` (disarm the
//! cleanup and hand the caller the path) are also absent, so a temporary
//! that should be promoted to a real file has to be copied. Freezing follows
//! a `Builder` and a decision on the unnamed form, not a release count.
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator } :: import("../allocator");
{ malloc, free } :: GlobalAllocator;
{ String } :: import("../string");
import("../fmt");
{ Path } :: import("../path");
{ IoError } :: import("../sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("../error");
_file_mod :: import("./file");
_dir_mod :: import("./dir");
IO_temp :: import("../sys/temp");
IO_file :: import("../sys/file");
{ memcpy } :: import("../libc/string");
{ platform, Platform } :: import("../process");
{ temp_dir } :: import("../env");
/// The path and the removed flag behind a `TempDir`'s `Box`. Its `Drop` is
/// the best-effort removal (plans/archive/STD_API_AUDIT.md C12): errors are
/// ignored and the removal is non-recursive (parity with `remove`) — use
/// `remove(io)` to observe failures.
_TempDirState :: struct(
  _path : Path,
  _removed : bool
);
impl(
  _TempDirState,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      cond(
        self._removed => (),
        true => {
          path_cstr_bytes := self._path.to_string().to_cstr();
          path_cstr := path_cstr_bytes.ptr().unwrap();
          cond(
            (platform == Platform.Windows) => {
              { _rmdir } :: import("../libc/windows");
              // SAFETY: path_cstr points at the NUL-terminated bytes of
              // path_cstr_bytes, alive for this whole block.
              unsafe(_rmdir((*char)(path_cstr)));
            },
            true => {
              { rmdir } :: import("../libc/unistd");
              // SAFETY: as above — NUL-terminated, alive for the call.
              unsafe(rmdir((*char)(path_cstr)));
            }
          );
          self._removed = true;
        }
      );
    })
  )
);
/// Temporary directory that can be cleaned up with `remove`.
///
/// A move-only value (its state is a `Box`): one owner removes the
/// directory, and a copy is E0901. Lend it with `&dir`; `remove` marks it
/// removed inside the box, so a `TempDir` is never `Sync`.
TempDir :: struct(_cell : Box(_TempDirState));
impl(TempDir, !Sync());
impl(
  TempDir,
  /// Create a uniquely named directory inside `parent` and return a handle
  /// that removes it on drop — Rust's `tempfile::TempDir::new_in`.
  ///
  /// The name is `parent/yo_tmp_XXXXXX` resolved by `mkdtemp(3)`, which
  /// creates the directory itself with mode `0700` — a temporary directory
  /// is never briefly world-readable — and retries until the name is unused.
  /// Windows takes the non-atomic path described in the module header. Async:
  /// awaited on the event loop, and it throws `IoExn` carrying the errno if
  /// `parent` does not exist, is not writable, or a name cannot be won.
  new_in : (fn(parent : &Path, io : Io) -> Impl(Future(TempDir, IoExn)))(
    io.async(e => {
      // Build template: parent/yo_tmp_XXXXXX
      template_path := parent.join(Path.new(`yo_tmp_XXXXXX`));
      template_str := template_path.to_string();
      // Allocate a mutable C string for mkdtemp
      template_bytes := template_str;
      buf_len := (template_bytes.len() + usize(1));
      buf := (*u8)(malloc(buf_len).unwrap());
      // SAFETY: `buf` is a fresh malloc'd `buf_len = template_bytes.len() + 1`
      // byte buffer; we copy exactly `template_bytes.len()` bytes from
      // `template_bytes`'s underlying storage (alive for the duration of this
      // statement — it's the bytes of `template_str` which we own) and write
      // the trailing NUL at `buf[template_bytes.len()]`. `buf` is freed in
      // both the error branch and after `IO_temp.mkdtemp` returns.
      unsafe(memcpy((*void)(buf), (*void)(template_bytes.ptr().unwrap()), template_bytes.len()));
      (buf.add(template_bytes.len())).* = u8(0);
      result := IO_temp.mkdtemp(buf);
      cond(
        (result < i32(0)) => {
          free(.Some((*void)(buf)));
          e.exn.throw(dyn(IoError.from_errno(i32(0) - result)));
        },
        true => ()
      );
      path_str := String.from_cstr(buf).unwrap();
      free(.Some((*void)(buf)));
      TempDir(_cell : box(_TempDirState(_path : Path.new(&path_str), _removed : false)))
    })
  ),
  /// `new_in` against the system temporary directory (`env.temp_dir()` —
  /// `TMPDIR` on POSIX, `TEMP`/`TMP` on Windows) — Rust's
  /// `tempfile::TempDir::new`.
  new : (fn(io : Io) -> Impl(Future(TempDir, IoExn)))(
    TempDir.new_in(Path.new(temp_dir()), io)
  ),
  /// The directory's real path, as `mkdtemp` resolved it. Stable for the
  /// life of the handle, and still returned after `remove` — the handle
  /// remembers the name it removed rather than emptying itself.
  path : (fn(self : &Self) -> Path)(
    self._cell._path
  ),
  /// Remove the directory now and observe the outcome, instead of leaving it
  /// to `Drop`.
  ///
  /// NON-RECURSIVE (`rmdir`), so it throws `IoExn` (`ENOTEMPTY`) if anything
  /// is still inside — use `walker.remove_dir_all` for a populated tree.
  /// Idempotent: a second call is a no-op, and so is the `Drop` that
  /// follows, because both consult the same `_removed` flag. Async, awaited
  /// on the event loop.
  remove : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
    io.async(
      { &self, io }(e : IoExn) =>
        cond(
          self._cell._removed => (),
          true => {
            st := addr_of(self._cell.*);
            e.io.await(_dir_mod.remove_dir(&self._cell._path, io), e);
            unsafe(consume(st.*._removed = true));
          }
        )
    )
  )
);
export(TempDir);
/// The open file, its path and the removed flag behind a `TempFile`'s
/// `Box`. Its `Drop` is the best-effort close + unlink
/// (plans/archive/STD_API_AUDIT.md C12): errors are ignored — use
/// `remove(io)` to observe failures. The fd is closed FIRST so Windows can
/// delete the file (POSIX allows unlinking an open file; Windows does not).
_TempFileState :: struct(
  _file : _file_mod.File,
  _path : Path,
  _removed : bool
);
impl(
  _TempFileState,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      cond(
        self._removed => (),
        true => {
          cond(
            self._file._cell._is_closed => (),
            true => {
              // `into_fd` retires the handle, so the `File`'s own drop that
              // follows does not close the descriptor a second time.
              IO_file.close_sync(self._file.into_fd());
            }
          );
          path_cstr_bytes := self._path.to_string().to_cstr();
          path_cstr := path_cstr_bytes.ptr().unwrap();
          cond(
            (platform == Platform.Windows) => {
              { _unlink } :: import("../libc/windows");
              // SAFETY: path_cstr points at the NUL-terminated bytes of
              // path_cstr_bytes, alive for this whole block.
              unsafe(_unlink((*char)(path_cstr)));
            },
            true => {
              { unlink } :: import("../libc/unistd");
              // SAFETY: as above — NUL-terminated, alive for the call.
              unsafe(unlink((*char)(path_cstr)));
            }
          );
          self._removed = true;
        }
      );
    })
  )
);
/// Temporary file backed by a `File` handle.
///
/// A move-only value (its state is a `Box`), as `File` is: one owner closes
/// and unlinks the file, and a copy is E0901. `file()` lends the open `File`.
TempFile :: struct(_cell : Box(_TempFileState));
impl(TempFile, !Sync());
impl(
  TempFile,
  /// Create a uniquely named file inside `parent`, open it, and return a
  /// handle that closes and unlinks it on drop — Rust's
  /// `tempfile::NamedTempFile::new_in`.
  ///
  /// `mkstemp(3)` does the naming, so on POSIX the create-and-open is atomic
  /// (`O_EXCL`) and the file is mode `0600` from the instant it exists — a
  /// temporary is never briefly world-readable. Windows takes the non-atomic
  /// path described in the module header. Async: awaited on the event loop,
  /// and throws `IoExn` with the errno on failure.
  new_in : (fn(parent : &Path, io : Io) -> Impl(Future(TempFile, IoExn)))(
    io.async(e => {
      // Build template: parent/yo_tmp_XXXXXX
      template_path := parent.join(Path.new(`yo_tmp_XXXXXX`));
      template_str := template_path.to_string();
      template_bytes := template_str;
      buf_len := (template_bytes.len() + usize(1));
      buf := (*u8)(malloc(buf_len).unwrap());
      // SAFETY: as in `TempDir.new_in` above — `buf` is a fresh malloc'd
      // `template_bytes.len() + 1` byte buffer, we copy exactly the template
      // bytes plus a trailing NUL. `buf` is freed in the error branch and
      // released to mkstemp's owned-fd lifecycle on success.
      unsafe(memcpy((*void)(buf), (*void)(template_bytes.ptr().unwrap()), template_bytes.len()));
      (buf.add(template_bytes.len())).* = u8(0);
      fd := IO_temp.mkstemp(buf);
      cond(
        (fd < i32(0)) => {
          free(.Some((*void)(buf)));
          e.exn.throw(dyn(IoError.from_errno(i32(0) - fd)));
        },
        true => ()
      );
      path_str := String.from_cstr(buf).unwrap();
      free(.Some((*void)(buf)));
      path := Path.new(&path_str);
      file := _file_mod.File._new(fd, path);
      TempFile(_cell : box(_TempFileState(_file : file, _path : path, _removed : false)))
    })
  ),
  /// `new_in` against the system temporary directory (`env.temp_dir()`) —
  /// Rust's `tempfile::NamedTempFile::new`.
  new : (fn(io : Io) -> Impl(Future(TempFile, IoExn)))(
    TempFile.new_in(Path.new(temp_dir()), io)
  ),
  /// The open `File` behind this temporary, lent for reading and writing
  /// it. The `TempFile` keeps ownership: closing the lent handle leaves the
  /// `TempFile`'s cleanup to unlink a file it no longer has open, which is
  /// harmless. The handle starts at position 0 — write, then `seek` back
  /// before reading.
  file : (fn(self : &Self) -> &_file_mod.File)(
    &self._cell._file
  ),
  /// The file's real path, as `mkstemp` resolved it. Handing this to another
  /// process is the reason a NAMED temporary exists; note the file is
  /// unlinked when this handle drops, so the path outlives nothing.
  path : (fn(self : &Self) -> Path)(
    self._cell._path
  ),
  /// Close the descriptor and unlink the file now, observing the outcome,
  /// instead of leaving it to `Drop`. The close comes FIRST so that
  /// Windows can delete the file at all (POSIX allows unlinking an open
  /// file; Windows does not). Idempotent, and the following `Drop`
  /// becomes a no-op. Async, awaited on the event loop; throws `IoExn` if
  /// either step fails.
  remove : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
    io.async(
      { &self, io }(e : IoExn) =>
        cond(
          self._cell._removed => (),
          true => {
            st := addr_of(self._cell.*);
            // The file's state sits inside this temporary's box: close it
            // through its address (this future borrows the temporary).
            e.io.await(_file_mod._close_file_state(addr_of(self._cell._file._cell.*), io), e);
            e.io.await(_dir_mod.remove_file(&self._cell._path, io), e);
            unsafe(consume(st.*._removed = true));
          }
        )
    )
  )
);
export(TempFile);
