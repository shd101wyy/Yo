// std/fs/metadata.yo - File metadata
//
// Wraps the low-level statx buffer with ergonomic accessors.
//
// Example:
//   { metadata } :: import "std/fs/metadata";
//
//   task := io.async((using(io : IO)) => {
//     m := io.await(metadata("/tmp/test.txt"));
//     match(m,
//       .Ok(meta) => {
//         printf("size: %lld\n", meta.size());
//         printf("is file: %d\n", i32(meta.is_file()));
//       },
//       .Err(e) => printf("error\n")
//     );
//   });

{ GlobalAllocator } :: import "../allocator";
{ malloc, free } :: GlobalAllocator;
open import "../string";
{ IOError } :: import "../io/errors";
{ Statx } :: import "../io/statx";
IO_file :: import "../io/file";
{
  AT_FDCWD, AT_SYMLINK_NOFOLLOW, AT_STATX_SYNC_AS_STAT,
  STATX_BASIC_STATS, S_IFMT, S_IFREG, S_IFDIR, S_IFLNK,
  S_IWUSR, S_IWGRP, S_IWOTH
} :: import "../io/constants";

// ============================================================================
// Metadata
// ============================================================================

Metadata :: object(
  _statx : Statx,
  _buf_ptr : *(u8)
);

impl(Metadata,
  // File size in bytes.
  size : (fn(self: Self) -> i64)(
    self._statx.size()
  ),

  // Raw permission mode bits.
  mode : (fn(self: Self) -> u32)(
    self._statx.mode()
  ),

  // True if this is a regular file.
  is_file : (fn(self: Self) -> bool)(
    self._statx.is_file()
  ),

  // True if this is a directory.
  is_dir : (fn(self: Self) -> bool)(
    self._statx.is_directory()
  ),

  // True if this is a symbolic link.
  is_symlink : (fn(self: Self) -> bool)(
    self._statx.is_symlink()
  ),

  // Last modification time (seconds since epoch).
  modified_time : (fn(self: Self) -> i64)(
    self._statx.mtime_sec()
  ),

  // Last access time (seconds since epoch).
  accessed_time : (fn(self: Self) -> i64)(
    self._statx.atime_sec()
  ),

  // Status change time (seconds since epoch).
  created_time : (fn(self: Self) -> i64)(
    self._statx.ctime_sec()
  ),

  // True if the file is read-only (no write permission for anyone).
  is_readonly : (fn(self: Self) -> bool)({
    m := self._statx.mode();
    ((m & (S_IWUSR | S_IWGRP | S_IWOTH)) == u32(0))
  }),

  // Owner user ID.
  uid : (fn(self: Self) -> u32)(
    self._statx.uid()
  ),

  // Owner group ID.
  gid : (fn(self: Self) -> u32)(
    self._statx.gid()
  ),

  // Inode number.
  ino : (fn(self: Self) -> u64)(
    self._statx.ino()
  ),

  // Number of hard links.
  nlink : (fn(self: Self) -> u64)(
    self._statx.nlink()
  )
);

impl(Metadata, Dispose(
  dispose : (fn(self: Self) -> unit)({
    free(.Some(*(void)(self._buf_ptr)));
  })
));

export Metadata;

// ============================================================================
// Statx buffer size extern
// ============================================================================

extern "Yo",
  __yo_statx_buf_size : (fn() -> usize)
;

// ============================================================================
// Internal helper to stat a path
// ============================================================================

_stat_path :: (fn(path: str, flags: i32, using(io : IO)) -> Impl(Future(Result(Metadata, IOError))))({
  cstr := path.to_cstr();
  buf_size := __yo_statx_buf_size();
  buf := *(u8)(malloc(buf_size).unwrap());
  task := io.async((using(io : IO)) => {
    result := io.await(IO_file.statx(AT_FDCWD, cstr, flags, STATX_BASIC_STATS, buf));
    cond(
      (result < i32(0)) => {
        free(.Some(*(void)(buf)));
        return .Err(IOError.from_errno((i32(0) - result)));
      },
      true => {
        sx := Statx(_buf_ptr: buf, _buf_size: buf_size);
        return .Ok(Metadata(_statx: sx, _buf_ptr: buf));
      }
    )
  });
  return task;
});

// Get metadata for a path (follows symlinks).
metadata :: (fn(path: str, using(io : IO)) -> Impl(Future(Result(Metadata, IOError))))(
  _stat_path(path, AT_STATX_SYNC_AS_STAT, using(io))
);

// Get metadata for a path (does NOT follow symlinks).
symlink_metadata :: (fn(path: str, using(io : IO)) -> Impl(Future(Result(Metadata, IOError))))(
  _stat_path(path, (AT_SYMLINK_NOFOLLOW | AT_STATX_SYNC_AS_STAT), using(io))
);

export metadata, symlink_metadata;
