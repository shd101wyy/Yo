// std/fs/walker.yo - Recursive directory traversal
//
// Walks a directory tree and collects entries.
//
// Example:
//   { walk, WalkEntry } :: import "std/fs/walker";
//
//   main :: (fn(using(io : IO)) -> unit)({
//     entries := io.await(walk(`/tmp`));
//     match(entries,
//       .Ok(list) => {
//         i := usize(0);
//         while runtime((i < list.len())), {
//           e := list.get(i).unwrap();
//           println(e.path);
//           i = (i + usize(1));
//         };
//       },
//       .Err(e) => println(e.to_string())
//     );
//   });

{ ArrayList } :: import "../collections/array_list";
open import "../string";
{ Path } :: import "../path";
{ IOError } :: import "../io/errors";
{ FileType } :: import "./dir";
{ DirEntry } :: import "./dir";
_dir :: import "./dir";

// ============================================================================
// WalkEntry
// ============================================================================

WalkEntry :: struct(
  path      : Path,
  name      : String,
  depth     : u32,
  file_type : FileType
);

export WalkEntry;

// ============================================================================
// WalkOptions
// ============================================================================

WalkOptions :: struct(
  max_depth     : ?(u32),
  follow_symlinks : bool,
  include_dirs  : bool
);

impl(WalkOptions,
  defaults : (fn() -> Self)(
    Self(
      max_depth: .None,
      follow_symlinks: false,
      include_dirs: true
    )
  )
);

export WalkOptions;

// ============================================================================
// Internal path join helper
// ============================================================================

_join_path :: (fn(base: String, name: String) -> String)(
  cond(
    base.ends_with(String.from("/")) => `${base}${name}`,
    true => `${base}/${name}`
  )
);

// ============================================================================
// Walk functions
// ============================================================================

// Walk a directory tree with custom options.
walk_with :: (fn(root: Path, options: WalkOptions, using(io : IO)) -> Impl(Future(Result(ArrayList(WalkEntry), IOError), IO)))({
  root_s := root.to_string();
  io.async((using(io : IO)) => {
    results := ArrayList(WalkEntry).new();
    // Stack of (path, depth) pairs to process
    stack := ArrayList(struct(path: String, depth: u32)).new();
    stack.push({ path: root_s, depth: u32(0) });

    while runtime((stack.len() > usize(0))), {
      item := stack.pop().unwrap();
      cur_path := item.path;
      cur_depth := item.depth;

      // Check max depth
      should_continue := match(options.max_depth,
        .Some(max) => (cur_depth <= max),
        .None => true
      );

      cond(
        should_continue => {
          dir_result := io.await(_dir.read_dir(Path.new(cur_path), using(io)));
          match(dir_result,
            .Ok(entries) => {
              i := usize(0);
              while runtime((i < entries.len())), {
                entry := entries.get(i).unwrap();
                entry_path := _join_path(cur_path, entry.name);
                match(entry.file_type,
                  .Directory => {
                    cond(
                      options.include_dirs => {
                        results.push(WalkEntry(
                          path: Path.new(entry_path),
                          name: entry.name,
                          depth: cur_depth,
                          file_type: .Directory
                        ));
                      },
                      true => ()
                    );
                    // Push subdirectory for processing
                    stack.push({ path: entry_path, depth: (cur_depth + u32(1)) });
                  },
                  _ => {
                    results.push(WalkEntry(
                      path: Path.new(entry_path),
                      name: entry.name,
                      depth: cur_depth,
                      file_type: entry.file_type
                    ));
                  }
                );
                i = (i + usize(1));
              };
            },
            .Err(e) => {
              (ret : Result(ArrayList(WalkEntry), IOError)) = .Err(e);
              return ret;
            }
          );
        },
        true => ()
      );
    };

    (ret : Result(ArrayList(WalkEntry), IOError)) = .Ok(results);
    return ret;
  })
});

walk_with_str :: (fn(root: str, options: WalkOptions, using(io : IO)) -> Impl(Future(Result(ArrayList(WalkEntry), IOError), IO)))(
  walk_with(Path.new(String.from(root)), options, using(io))
);

// Walk a directory tree with default options.
walk :: (fn(root: Path, using(io : IO)) -> Impl(Future(Result(ArrayList(WalkEntry), IOError), IO)))
  walk_with(root, WalkOptions.defaults(), using(io))
;

walk_str :: (fn(root: str, using(io : IO)) -> Impl(Future(Result(ArrayList(WalkEntry), IOError), IO)))
  walk(Path.new(String.from(root)), using(io))
;

export walk, walk_str, walk_with, walk_with_str;
