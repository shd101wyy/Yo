// std/fs/file.yo - High-level File object
//
// Wraps a file descriptor and provides buffered async read/write operations.
// Builds on std/io/file (low-level) and std/io/seek for position control.
//
// Paths accept String. Use String.from_cstr / String.from for conversion.
//
// Example:
//   { File, read_to_string } :: import "std/fs/file";
//
//   main :: (fn(using(io : IO)) -> unit)({
//     content := read_to_string(String.from("/etc/hostname")).unwrap();
//     println(content);
//   });
//   export main;

open import "../string";
{ ArrayList } :: import "../collections/array_list";
{ GlobalAllocator } :: import "../allocator";
{ malloc, free } :: GlobalAllocator;
{ IOError } :: import "../io/errors";
{
  AT_FDCWD,
  O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND
} :: import "../io/constants";
{
  openat, close, read, write, ftruncate, statx
} :: import "../io/file";
{ lseek, SEEK_SET, SEEK_CUR, SEEK_END } :: import "../io/seek";
{
  STATX_BASIC_STATS
} :: import "../io/constants";
{ __yo_statx_size } :: import "../io/externs";
{ Metadata, metadata } :: import "./metadata";

// Default I/O buffer size: 8 KiB
_BUF_SIZE :: usize(8192);

// ============================================================================
// File object
// ============================================================================

File :: object(
  fd        : i32,
  path      : String,
  _read_buf : ArrayList(u8),
  _write_buf: ArrayList(u8),
  _position : i64,
  _is_closed: bool
);

impl(File,
  // Low-level open with explicit flags and mode.
  open : (fn(path: String, flags: i32, mode: i32, using(io : IO)) -> Result(Self, IOError))({
    path_cstr := path.to_cstr();
    path_ptr  := *(u8)(path_cstr.ptr().unwrap());
    result    := io.await(openat(AT_FDCWD, path_ptr, flags, mode));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => .Ok(Self(
        fd:         result,
        path:       path,
        _read_buf:  ArrayList(u8).new(),
        _write_buf: ArrayList(u8).new(),
        _position:  i64(0),
        _is_closed: false
      ))
    )
  }),

  // Open an existing file for reading.
  open_read : (fn(path: String, using(io : IO)) -> Result(Self, IOError))(
    Self.open(path, O_RDONLY, i32(0))
  ),

  // Create or truncate a file for writing.
  create : (fn(path: String, using(io : IO)) -> Result(Self, IOError))(
    Self.open(path, (O_WRONLY | (O_CREAT | O_TRUNC)), i32(0o644))
  ),

  // Open or create a file and seek to the end for appending.
  open_append : (fn(path: String, using(io : IO)) -> Result(Self, IOError))(
    Self.open(path, (O_WRONLY | (O_CREAT | O_APPEND)), i32(0o644))
  ),

  // Read up to `size` bytes into `buf`. Returns bytes read or an error.
  read : (fn(self: Self, buf: *(u8), size: usize, using(io : IO)) -> Result(i32, IOError))({
    result := io.await(read(self.fd, buf, u32(size), u64(self._position)));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => {
        self._position = (self._position + i64(result));
        .Ok(result)
      }
    )
  }),

  // Write a String to the file. Returns bytes written or an error.
  write : (fn(self: Self, data: String, using(io : IO)) -> Result(i32, IOError))({
    bytes := data.as_bytes();
    cond(
      (bytes.len() == usize(0)) => .Ok(i32(0)),
      true => {
        data_ptr := *(u8)(bytes.ptr().unwrap());
        result   := io.await(write(self.fd, data_ptr, u32(bytes.len()), u64(self._position)));
        cond(
          (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
          true => {
            self._position = (self._position + i64(result));
            .Ok(result)
          }
        )
      }
    )
  }),

  // Write raw bytes (ArrayList(u8)) to the file.
  write_bytes : (fn(self: Self, data: ArrayList(u8), using(io : IO)) -> Result(i32, IOError))({
    cond(
      (data.len() == usize(0)) => .Ok(i32(0)),
      true => {
        data_ptr := *(u8)(data.ptr().unwrap());
        result   := io.await(write(self.fd, data_ptr, u32(data.len()), u64(self._position)));
        cond(
          (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
          true => {
            self._position = (self._position + i64(result));
            .Ok(result)
          }
        )
      }
    )
  }),

  // Read the entire file content into an ArrayList(u8).
  read_all : (fn(self: Self, using(io : IO)) -> Result(ArrayList(u8), IOError))({
    buf   := ArrayList(u8).with_capacity(_BUF_SIZE);
    chunk := ArrayList(u8).with_capacity(_BUF_SIZE);
    chunk.set_len(_BUF_SIZE);
    chunk_ptr := *(u8)(chunk.ptr().unwrap());
    self._position = i64(0);
    while runtime(true), () => {
      n := io.await(read(self.fd, chunk_ptr, u32(_BUF_SIZE), u64(self._position)));
      cond(
        (n < i32(0)) => {
          return .Err(IOError.from_errno((i32(0) - n)));
        },
        (n == i32(0)) => break,
        true => {
          self._position = (self._position + i64(n));
          i := usize(0);
          while (i < usize(n)), (i = (i + usize(1))), {
            buf.push(chunk.get(i).unwrap());
          };
        }
      );
    };
    .Ok(buf)
  }),

  // Read the entire file content as a UTF-8 String.
  read_to_string : (fn(self: Self, using(io : IO)) -> Result(String, IOError))({
    bytes := self.read_all();
    match(bytes,
      .Err(e) => .Err(e),
      .Ok(b)  => .Ok(String.from_bytes(b))
    )
  }),

  // Flush the write buffer (no-op; writes are direct).
  flush : (fn(self: Self, using(io : IO)) -> Result(unit, IOError))(
    .Ok(())
  ),

  // Seek to an offset. Returns the new absolute position.
  seek : (fn(self: Self, offset: i64, whence: i32) -> Result(i64, IOError))({
    result := lseek(self.fd, offset, whence);
    cond(
      (result < i64(0)) => .Err(IOError.from_errno(i32((i64(0) - result)))),
      true => {
        self._position = result;
        .Ok(result)
      }
    )
  }),

  // Return the current logical file position.
  position : (fn(self: Self) -> i64)(
    self._position
  ),

  // Query the file size via statx.
  size : (fn(self: Self, using(io : IO)) -> Result(i64, IOError))({
    path_cstr := self.path.to_cstr();
    path_ptr  := *(u8)(path_cstr.ptr().unwrap());
    stat_buf  := ArrayList(u8).with_capacity(usize(256));
    stat_buf.set_len(usize(256));
    stat_ptr  := *(u8)(stat_buf.ptr().unwrap());
    result    := io.await(statx(AT_FDCWD, path_ptr, i32(0), u32(STATX_BASIC_STATS), stat_ptr));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => .Ok(__yo_statx_size(stat_ptr))
    )
  }),

  // Fetch file metadata.
  metadata : (fn(self: Self, using(io : IO)) -> Result(Metadata, IOError))(
    metadata(self.path)
  ),

  // Close the file descriptor.
  close : (fn(self: Self, using(io : IO)) -> Result(unit, IOError))({
    cond(
      self._is_closed => .Ok(()),
      true => {
        result := io.await(close(self.fd));
        self._is_closed = true;
        cond(
          (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
          true => .Ok(())
        )
      }
    )
  })
);

export File;

// ============================================================================
// Convenience functions
// ============================================================================

// Read an entire file into an ArrayList(u8).
read_file :: (fn(path: String, using(io : IO)) -> Result(ArrayList(u8), IOError))({
  f := File.open_read(path);
  match(f,
    .Err(e) => .Err(e),
    .Ok(file) => {
      result := file.read_all();
      file.close();
      result
    }
  )
});

// Read an entire file as a UTF-8 String.
read_to_string :: (fn(path: String, using(io : IO)) -> Result(String, IOError))({
  f := File.open_read(path);
  match(f,
    .Err(e) => .Err(e),
    .Ok(file) => {
      result := file.read_to_string();
      file.close();
      result
    }
  )
});

// Write a String to a file, creating or truncating it.
write_file :: (fn(path: String, data: String, using(io : IO)) -> Result(unit, IOError))({
  f := File.create(path);
  match(f,
    .Err(e) => .Err(e),
    .Ok(file) => {
      result := file.write(data);
      file.close();
      match(result,
        .Err(e) => .Err(e),
        .Ok(_)  => .Ok(())
      )
    }
  )
});

// Write raw bytes to a file, creating or truncating it.
write_bytes :: (fn(path: String, data: ArrayList(u8), using(io : IO)) -> Result(unit, IOError))({
  f := File.create(path);
  match(f,
    .Err(e) => .Err(e),
    .Ok(file) => {
      result := file.write_bytes(data);
      file.close();
      match(result,
        .Err(e) => .Err(e),
        .Ok(_)  => .Ok(())
      )
    }
  )
});

// Append a String to a file (creates it if it does not exist).
append_file :: (fn(path: String, data: String, using(io : IO)) -> Result(unit, IOError))({
  f := File.open_append(path);
  match(f,
    .Err(e) => .Err(e),
    .Ok(file) => {
      result := file.write(data);
      file.close();
      match(result,
        .Err(e) => .Err(e),
        .Ok(_)  => .Ok(())
      )
    }
  )
});

// Return true if a path exists (follows symlinks).
exists :: (fn(path: String, using(io : IO)) -> bool)({
  path_cstr := path.to_cstr();
  path_ptr  := *(u8)(path_cstr.ptr().unwrap());
  buf       := ArrayList(u8).with_capacity(usize(256));
  buf.set_len(usize(256));
  buf_ptr   := *(u8)(buf.ptr().unwrap());
  result    := io.await(statx(AT_FDCWD, path_ptr, i32(0), u32(STATX_BASIC_STATS), buf_ptr));
  (result >= i32(0))
});

export read_file, read_to_string, write_file, write_bytes, append_file, exists;
