  write_string_str,
  write_string_cstr,
  write,
  append_file,
  append_file_str,
  exists,
  exists_str,
  exists_cstr,
  is_file,
  is_file_str,
  is_file_cstr,
  is_dir,
  is_dir_str,
  is_dir_cstr,
  canonicalize,
  canonicalize_str,
  canonicalize_cstr,
  try_exists,
  try_exists_str,
  set_permissions,
  set_permissions_str,
  copy,
  copy_str
);
