//! Async directory operations — create, remove, read, link, rename.
//!
//! Wraps low-level `std/sys/dir` with typed APIs using the `Exception` effect.
//!
//! ## Example
//!
//! ```rust
//! { create_dir, remove_dir, read_dir } :: import "std/fs/dir";
//! { Path } :: import "std/path";
//!
//! main :: (fn(io : Io, exn : Exception) -> unit)({
//!   io.await(create_dir(Path.new(`/tmp/yo_test`), io), { io, exn });
//!   entries := io.await(read_dir(Path.new(`/tmp/yo_test`), io), { io, exn });
//!   io.await(remove_dir(Path.new(`/tmp/yo_test`), io), { io, exn });
//! });
//! ```
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator } :: import("../allocator");
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import("../collections/array_list");
open(import("../string"));
{ Path } :: import("../path");
{ IoError } :: import("../sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("../error");
{ EEXIST, ENOENT } :: import("../libc/errno");
IO_dir :: import("../sys/dir");
IO_file :: import("../sys/file");
{ Statx } :: import("../sys/statx");
{ platform, Platform } :: import("../process");
{ AT_FDCWD, AT_REMOVEDIR, AT_SYMLINK_NOFOLLOW, AT_STATX_SYNC_AS_STAT, STATX_BASIC_STATS, O_RDONLY, O_DIRECTORY, DEFAULT_DIR_MODE, DT_UNKNOWN, DT_REG, DT_DIR, DT_LNK } :: import("../sys/constants");
extern(
  "Yo",
  __yo_statx_buf_size : (fn() -> usize)
);
// ============================================================================
// FileType enum
// ============================================================================
/// The type of a file system entry.
FileType :: enum(
  /// A regular file.
  File,
  /// A directory.
  Directory,
  /// A symbolic link.
  Symlink,
  /// An unknown or unsupported file type.
  Other
);
export(FileType);
// ============================================================================
// DirEntry
// ============================================================================
/// A directory entry containing the entry name, file type, inode number, and
/// the directory it was read from (so `path()` can rebuild the full path —
/// Rust's `DirEntry::path`).
DirEntry :: struct(
  name : String,
  file_type : FileType,
  ino : u64,
  parent : Path
);
impl(
  DirEntry,
  /// The full path of this entry: the scanned directory joined with the
  /// entry name. Rust's `DirEntry::path`.
  path : (fn(self : Self) -> Path)(
    self.parent.join(Path.new(self.name.clone()))
  )
);
export(DirEntry);
// ============================================================================
// Directory operations
// ============================================================================
/// Create a directory at the given path.
create_dir :: (fn(path : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    cstr_bytes := path.to_string().to_cstr();
    cstr := cstr_bytes.ptr().unwrap();
    result := e.io.await(IO_dir.mkdir(AT_FDCWD, cstr, i32(DEFAULT_DIR_MODE)), e.io);
    cond(
      (result < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - result))),
      true => ()
    )
  })
);
/// Create a directory (`str` path variant).
create_dir_str :: (fn(path : str, io : Io) -> Impl(Future(unit, IoExn)))(
  create_dir(Path.new(String.from(path)), io)
);
/// Create a directory and all missing parent directories.
/// Does not error if the directory already exists.
create_dir_all :: (fn(path : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    path_s := path.to_string();
    cstr_bytes := path_s.to_cstr();
    cstr := cstr_bytes.ptr().unwrap();
    // Try creating the directory directly first
    result := e.io.await(IO_dir.mkdir(AT_FDCWD, cstr, i32(DEFAULT_DIR_MODE)), e.io);
    cond(
      (result >= i32(0)) => (),
      true => {
        errno := (i32(0) - result);
        cond(
          // Already exists is OK
          (errno == i32(EEXIST)) => (),
          // ENOENT - try to create parents
          (errno == i32(ENOENT)) => {
            // Walk the path and create each component
            bytes := path_s.as_bytes();
            i := usize(1);
            // On Windows, skip past drive letter root (e.g., "C:\")
            // to avoid trying to mkdir "C:" which fails with EACCES
            cond(
              (platform == Platform.Windows) => {
                cond(
                  (bytes.len() >= usize(3)) => {
                    first := bytes(usize(0));
                    second := bytes(usize(1));
                    is_drive_root := ((((first >= u8(65)) && (first <= u8(90))) || ((first >= u8(97)) && (first <= u8(122)))) && (second == u8(58)));
                    cond(
                      is_drive_root => {
                        i = usize(3);
                      },
                      true => ()
                    );
                  },
                  true => ()
                );
              },
              true => ()
            );
            while(runtime(i < bytes.len()), {
              b := bytes(i);
              cond(
                ((b == u8(47)) || (b == u8(92))) => {
                  // '/' found - try to create this prefix
                  prefix := path_s.substring(usize(0), i);
                  prefix_cstr_bytes := prefix.to_cstr();
                  prefix_cstr := prefix_cstr_bytes.ptr().unwrap();
                  r := e.io.await(IO_dir.mkdir(AT_FDCWD, prefix_cstr, i32(DEFAULT_DIR_MODE)), e.io);
                  // Ignore EEXIST errors
                  cond(
                    ((r < i32(0)) && ((i32(0) - r) != i32(EEXIST))) => {
                      e.exn.throw(dyn(IoError.from_errno(i32(0) - r)));
                    },
                    true => ()
                  );
                },
                true => ()
              );
              i = (i + usize(1));
            });
            // Create the final directory
            final_result := e.io.await(IO_dir.mkdir(AT_FDCWD, cstr, i32(DEFAULT_DIR_MODE)), e.io);
            cond(
              (final_result >= i32(0)) => (),
              true => {
                final_errno := (i32(0) - final_result);
                cond(
                  (final_errno == i32(EEXIST)) => (),
                  true => e.exn.throw(dyn(IoError.from_errno(final_errno)))
                )
              }
            )
          },
          true => e.exn.throw(dyn(IoError.from_errno(errno)))
        )
      }
    )
  })
);
/// Create a directory and all missing parents (`str` path variant).
create_dir_all_str :: (fn(path : str, io : Io) -> Impl(Future(unit, IoExn)))(
  create_dir_all(Path.new(String.from(path)), io)
);
/// Remove an empty directory. Throws if the directory is not empty.
remove_dir :: (fn(path : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    cstr_bytes := path.to_string().to_cstr();
    cstr := cstr_bytes.ptr().unwrap();
    result := e.io.await(IO_dir.unlink(AT_FDCWD, cstr, AT_REMOVEDIR), e.io);
    cond(
      (result < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - result))),
      true => ()
    )
  })
);
remove_dir_str :: (fn(path : str, io : Io) -> Impl(Future(unit, IoExn)))(
  remove_dir(Path.new(String.from(path)), io)
);
/// Remove a file at the given path.
remove_file :: (fn(path : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    cstr_bytes := path.to_string().to_cstr();
    cstr := cstr_bytes.ptr().unwrap();
    result := e.io.await(IO_dir.unlink(AT_FDCWD, cstr, i32(0)), e.io);
    cond(
      (result < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - result))),
      true => ()
    )
  })
);
remove_file_str :: (fn(path : str, io : Io) -> Impl(Future(unit, IoExn)))(remove_file(Path.new(String.from(path)), io));
/// Rename or move a file or directory from `from` to `to`.
rename :: (fn(from : Path, to : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    from_cstr_bytes := from.to_string().to_cstr();
    from_cstr := from_cstr_bytes.ptr().unwrap();
    to_cstr_bytes := to.to_string().to_cstr();
    to_cstr := to_cstr_bytes.ptr().unwrap();
    result := e.io.await(IO_dir.rename(AT_FDCWD, from_cstr, AT_FDCWD, to_cstr), e.io);
    cond(
      (result < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - result))),
      true => ()
    )
  })
);
rename_str :: (fn(from : str, to : str, io : Io) -> Impl(Future(unit, IoExn)))(rename(Path.new(String.from(from)), Path.new(String.from(to)), io));
/// Create a hard link from `src` to `dst`.
hard_link :: (fn(src : Path, dst : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    src_cstr_bytes := src.to_string().to_cstr();
    src_cstr := src_cstr_bytes.ptr().unwrap();
    dst_cstr_bytes := dst.to_string().to_cstr();
    dst_cstr := dst_cstr_bytes.ptr().unwrap();
    result := e.io.await(IO_dir.link(AT_FDCWD, src_cstr, AT_FDCWD, dst_cstr, i32(0)), e.io);
    cond(
      (result < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - result))),
      true => ()
    )
  })
);
hard_link_str :: (fn(src : str, dst : str, io : Io) -> Impl(Future(unit, IoExn)))(hard_link(Path.new(String.from(src)), Path.new(String.from(dst)), io));
/// Create a symbolic link at `dst` pointing to `src`.
symlink :: (fn(src : Path, dst : Path, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    src_cstr_bytes := src.to_string().to_cstr();
    src_cstr := src_cstr_bytes.ptr().unwrap();
    dst_cstr_bytes := dst.to_string().to_cstr();
    dst_cstr := dst_cstr_bytes.ptr().unwrap();
    result := e.io.await(IO_dir.symlink(src_cstr, AT_FDCWD, dst_cstr), e.io);
    cond(
      (result < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - result))),
      true => ()
    )
  })
);
symlink_str :: (fn(src : str, dst : str, io : Io) -> Impl(Future(unit, IoExn)))(symlink(Path.new(String.from(src)), Path.new(String.from(dst)), io));
/// Read a symlink's target (`std::fs::read_link`). Throws for a path that is
/// not a symlink (EINVAL) — like Rust.
read_link :: (fn(path : Path, io : Io) -> Impl(Future(Path, IoExn)))(
  io.async(e => {
    cstr_bytes := path.to_string().to_cstr();
    cstr := cstr_bytes.ptr().unwrap();
    bufsize := usize(4096);
    buf := (*u8)(malloc(bufsize).unwrap());
    n := IO_dir.readlink(AT_FDCWD, cstr, buf, bufsize);
    cond(
      (n < i32(0)) => {
        free(.Some((*void)(buf)));
        e.exn.throw(dyn(IoError.from_errno(i32(0) - n)))
      },
      true => {
        target_bytes := ArrayList(u8).with_capacity(usize(n));
        (rli : usize) = usize(0);
        while(rli < usize(n), rli = (rli + usize(1)), {
          target_bytes.push((buf.add(rli)).*);
        });
        free(.Some((*void)(buf)));
        Path.new(String.from_bytes(target_bytes))
      }
    )
  })
);
/// `read_link` (`str` path variant).
read_link_str :: (fn(path : str, io : Io) -> Impl(Future(Path, IoExn)))(read_link(Path.new(String.from(path)), io));

// ============================================================================
// File type by path
// ============================================================================
/// Classify a FILLED statx buffer. The order matters: a symlink must be
/// recognised before anything else, because `lstat` reports `S_IFLNK` and the
/// walker's `follow_symlinks` decision depends on seeing `.Symlink` rather
/// than the target's type.
_statx_file_type :: (fn(buf : *u8, buf_size : usize) -> FileType)({
  sx := Statx(_buf_ptr : buf, _buf_size : buf_size);
  cond(
    sx.is_symlink() => FileType.Symlink,
    sx.is_directory() => FileType.Directory,
    sx.is_file() => FileType.File,
    true => FileType.Other
  )
});
/// The `FileType` of the entry at `path`, WITHOUT following a final symlink
/// (`lstat` semantics): a symlink reports `.Symlink`, never its target's
/// type. That is the same view `readdir`'s `d_type` gives, so a walk sees one
/// consistent answer whatever the filesystem reports, and
/// `WalkOptions.follow_symlinks` — not the stat — stays in charge of descent.
/// Throws when the path cannot be stat'ed.
file_type :: (fn(path : Path, io : Io) -> Impl(Future(FileType, IoExn)))(
  io.async(e => {
    cstr_bytes := path.to_string().to_cstr();
    cstr := cstr_bytes.ptr().unwrap();
    buf_size := __yo_statx_buf_size();
    buf := (*u8)(malloc(buf_size).unwrap());
    result := e.io.await(IO_file.statx(AT_FDCWD, cstr, AT_SYMLINK_NOFOLLOW | AT_STATX_SYNC_AS_STAT, STATX_BASIC_STATS, buf), e.io);
    // The buffer must be freed on BOTH paths, so the classification happens
    // before the free and the throw after it. Both `cond`s are statements
    // and the body's tail is the bare `ft`: a value-position `cond` whose
    // other arm throws emitted a read of an undeclared C temp here
    // (issues/async-cond-value-with-throwing-arm-after-await-undeclared-temp.md).
    (ft : FileType) = FileType.Other;
    cond(
      (result >= i32(0)) => {
        ft = _statx_file_type(buf, buf_size);
      },
      true => ()
    );
    free(.Some((*void)(buf)));
    cond(
      (result < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - result))),
      true => ()
    );
    ft
  })
);
/// `file_type`, degrading to `.Other` instead of throwing — the form
/// `read_dir` uses for its `DT_UNKNOWN` fallback. An entry the directory
/// listed but that cannot be stat'ed (removed under us, or a parent that is
/// readable but not searchable) keeps the `.Other` it has always had, so one
/// unresolvable entry never fails the whole listing.
_file_type_or_other :: (fn(path : Path, io : Io) -> Impl(Future(FileType, Io)))(
  io.async(io => {
    cstr_bytes := path.to_string().to_cstr();
    cstr := cstr_bytes.ptr().unwrap();
    buf_size := __yo_statx_buf_size();
    buf := (*u8)(malloc(buf_size).unwrap());
    result := io.await(IO_file.statx(AT_FDCWD, cstr, AT_SYMLINK_NOFOLLOW | AT_STATX_SYNC_AS_STAT, STATX_BASIC_STATS, buf), io);
    ft := cond(
      (result < i32(0)) => FileType.Other,
      true => _statx_file_type(buf, buf_size)
    );
    free(.Some((*void)(buf)));
    ft
  })
);
// ============================================================================
// Directory listing
// ============================================================================
/// Read all entries from a directory, returning an `ArrayList(DirEntry)`.
/// Skips the `.` and `..` entries.
read_dir :: (fn(path : Path, io : Io) -> Impl(Future(ArrayList(DirEntry), IoExn)))(
  io.async(e => {
    cstr_bytes := path.to_string().to_cstr();
    cstr := cstr_bytes.ptr().unwrap();
    // Open the directory
    fd_result := e.io.await(IO_file.openat(AT_FDCWD, cstr, O_RDONLY | O_DIRECTORY, i32(0)), e.io);
    cond(
      (fd_result < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - fd_result))),
      true => ()
    );
    fd := fd_result;
    // Pass 1 — drain the kernel's dirent buffers, keeping `d_type` RAW.
    // Resolving `DT_UNKNOWN` needs a stat, and an await down here (inside the
    // scan of one getdents buffer, a while nested in a while nested in a cond
    // arm) is the async state-machine shape
    // issues/async-nested-cond-await-duplicate-while-labels.md warns about.
    // The mapping — and the stat — happen in pass 2, one loop up.
    raw := ArrayList(struct(name : String, dt : u8, ino : u64)).new();
    buf_size := u32(4096);
    buf := (*u8)(malloc(usize(buf_size)).unwrap());
    while(runtime(true), {
      n := e.io.await(IO_dir.getdents(fd, buf, buf_size), e.io);
      cond(
        (n < i32(0)) => {
          free(.Some((*void)(buf)));
          e.io.await(IO_file.close(fd), e.io);
          e.exn.throw(dyn(IoError.from_errno(i32(0) - n)));
        },
        (n == i32(0)) => {
          break;
        },
        true => {
          offset := usize(0);
          while(runtime(offset < usize(n)), {
            entry_ptr := buf.add(offset);
            name_ptr := IO_dir.dirent_name(entry_ptr);
            name := String.from_cstr(name_ptr).unwrap();
            // Skip "." and ".."
            cond(
              ((name == String.from(".")) || (name == String.from(".."))) => (),
              true => {
                raw.push({
                  name : name,
                  dt : IO_dir.dirent_type(entry_ptr),
                  ino : IO_dir.dirent_ino(entry_ptr)
                });
              }
            );
            offset = (offset + usize(IO_dir.dirent_reclen(entry_ptr)));
          });
        }
      );
    });
    free(.Some((*void)(buf)));
    e.io.await(IO_file.close(fd), e.io);
    // Pass 2 — `d_type` to `FileType`.
    entries := ArrayList(DirEntry).new();
    (i : usize) = usize(0);
    while(runtime(i < raw.len()), {
      r := raw(i);
      (ft : FileType) = cond(
        (r.dt == DT_REG) => FileType.File,
        (r.dt == DT_DIR) => FileType.Directory,
        (r.dt == DT_LNK) => FileType.Symlink,
        true => FileType.Other
      );
      // `DT_UNKNOWN` is not exotic: XFS, many network and overlay
      // filesystems, and any filesystem that does not carry the type inline
      // answer it for EVERY entry. Calling that `.Other` made the walker
      // silently skip whole subtrees and `remove_dir_all` call `remove_file`
      // on directories, so stat the entry — what every correct readdir
      // consumer does. Only this arm pays a syscall; a filesystem that
      // reports a type keeps the fast path above.
      //
      // The stat is a STATEMENT-form `cond` assigning `ft`, not an arm of the
      // value-form `cond` above: a value-position `cond` with an awaiting arm
      // inside a `while` inside `io.async` silently yields the ZERO value for
      // EVERY arm — issues/async-cond-value-with-await-arm-inside-while-yields-zero.md.
      cond(
        (r.dt == DT_UNKNOWN) => {
          ft = e.io.await(_file_type_or_other(path.join(Path.new(r.name.clone())), e.io), e.io);
        },
        true => ()
      );
      entries.push(
        DirEntry(
          name : r.name,
          file_type : ft,
          ino : r.ino,
          parent : path.clone()
        )
      );
      i = (i + usize(1));
    });
    entries
  })
);
read_dir_str :: (fn(path : str, io : Io) -> Impl(Future(ArrayList(DirEntry), IoExn)))(read_dir(Path.new(String.from(path)), io));
export(
  create_dir,
  create_dir_str,
  create_dir_all,
  create_dir_all_str,
  remove_dir,
  remove_dir_str,
  remove_file,
  remove_file_str,
  rename,
  rename_str,
  hard_link,
  hard_link_str,
  symlink,
  symlink_str,
  read_dir,
  read_dir_str,
  read_link,
  read_link_str,
  file_type
);
