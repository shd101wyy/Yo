// std/fs/dir.yo - High-level directory operations
//
// Provides ergonomic wrappers for directory creation, removal, rename,
// symlink/hardlink, and directory listing built on std/io/dir.
//
// Paths accept String.
//
// Example:
//   { create_dir, read_dir } :: import "std/fs/dir";
//
//   create_dir(String.from("/tmp/mydir"));
//   entries := read_dir(String.from("/tmp/mydir")).unwrap();

open import "../string";
{ ArrayList } :: import "../collections/array_list";
{ GlobalAllocator } :: import "../allocator";
{ malloc, free } :: GlobalAllocator;
{ IOError } :: import "../io/errors";
{
  AT_FDCWD, AT_REMOVEDIR,
  O_RDONLY, O_DIRECTORY
} :: import "../io/constants";
{
  mkdir, unlink, rename : io_rename, symlink : io_symlink, link,
  getdents,
  dirent_reclen : __yo_dirent_reclen,
  dirent_type   : __yo_dirent_type,
  dirent_name   : __yo_dirent_name,
  dirent_ino    : __yo_dirent_ino
} :: import "../io/dir";
{ openat, close } :: import "../io/file";

// ============================================================================
// FileType
// ============================================================================

FileType :: enum(
  .File,
  .Directory,
  .Symlink,
  .Other
);

export FileType;

// dirent d_type constants
_DT_REG  :: u8(8);
_DT_DIR  :: u8(4);
_DT_LNK  :: u8(10);

_dtype_to_filetype :: (fn(dtype: u8) -> FileType)(
  cond(
    (dtype == _DT_REG) => .File,
    (dtype == _DT_DIR) => .Directory,
    (dtype == _DT_LNK) => .Symlink,
    true => .Other
  )
);

// ============================================================================
// DirEntry
// ============================================================================

DirEntry :: struct(
  name      : String,
  path      : String,
  file_type : FileType,
  ino       : u64
);

export DirEntry;

// ============================================================================
// Directory operations
// ============================================================================

// Create a single directory.
create_dir :: (fn(path: String, using(io : IO)) -> Result(unit, IOError))({
  path_cstr := path.to_cstr();
  path_ptr  := *(u8)(path_cstr.ptr().unwrap());
  result    := io.await(mkdir(AT_FDCWD, path_ptr, i32(0o755)));
  cond(
    (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
    true => .Ok(())
  )
});

// Create a directory and all missing ancestors.
create_dir_all :: (fn(path: String, using(io : IO)) -> Result(unit, IOError))({
  segments := path.split(String.from("/"));
  accumulated := String.new();
  cond(
    (path.len() > usize(0)) => {
      first_bytes := path.as_bytes();
      first_b := first_bytes.get(usize(0)).unwrap();
      cond(
        (first_b == u8(47)) => {
          accumulated = String.from("/");
        },
        true => ()
      );
    },
    true => ()
  );
  idx := usize(0);
  while (idx < segments.len()), (idx = (idx + usize(1))), {
    seg := segments.get(idx).unwrap();
    cond(
      (seg.len() == usize(0)) => {
        // skip empty segments (from leading slash)
      },
      true => {
        cond(
          (accumulated.len() > usize(0)) => {
            last_bytes := accumulated.as_bytes();
            last_b := last_bytes.get((accumulated.len() - usize(1))).unwrap();
            cond(
              (last_b != u8(47)) => {
                accumulated = accumulated.concat(String.from("/"));
              },
              true => ()
            );
          },
          true => ()
        );
        accumulated = accumulated.concat(seg);
        seg_cstr := accumulated.to_cstr();
        seg_ptr  := *(u8)(seg_cstr.ptr().unwrap());
        r := io.await(mkdir(AT_FDCWD, seg_ptr, i32(0o755)));
        cond(
          ((r < i32(0)) && (r != (i32(0) - i32(17)))) => { // EEXIST = 17
            return .Err(IOError.from_errno((i32(0) - r)));
          },
          true => ()
        );
      }
    );
  };
  .Ok(())
});

// Remove an empty directory.
remove_dir :: (fn(path: String, using(io : IO)) -> Result(unit, IOError))({
  path_cstr := path.to_cstr();
  path_ptr  := *(u8)(path_cstr.ptr().unwrap());
  result    := io.await(unlink(AT_FDCWD, path_ptr, AT_REMOVEDIR));
  cond(
    (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
    true => .Ok(())
  )
});

// Remove a directory and all its contents recursively.
remove_dir_all :: (fn(path: String, using(io : IO)) -> Result(unit, IOError))({
  entries_result := read_dir(path);
  match(entries_result,
    .Err(e) => .Err(e),
    .Ok(entries) => {
      i := usize(0);
      while (i < entries.len()), (i = (i + usize(1))), {
        entry := entries.get(i).unwrap();
        match(entry.file_type,
          .Directory => {
            r := remove_dir_all(entry.path);
            match(r,
              .Err(e) => { return .Err(e); },
              .Ok(_)  => ()
            );
          },
          _ => {
            r := remove_file(entry.path);
            match(r,
              .Err(e) => { return .Err(e); },
              .Ok(_)  => ()
            );
          }
        );
      };
      remove_dir(path)
    }
  )
});

// Remove a file.
remove_file :: (fn(path: String, using(io : IO)) -> Result(unit, IOError))({
  path_cstr := path.to_cstr();
  path_ptr  := *(u8)(path_cstr.ptr().unwrap());
  result    := io.await(unlink(AT_FDCWD, path_ptr, i32(0)));
  cond(
    (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
    true => .Ok(())
  )
});

// Rename / move a file or directory.
rename :: (fn(from: String, to: String, using(io : IO)) -> Result(unit, IOError))({
  from_cstr := from.to_cstr();
  from_ptr  := *(u8)(from_cstr.ptr().unwrap());
  to_cstr   := to.to_cstr();
  to_ptr    := *(u8)(to_cstr.ptr().unwrap());
  result    := io.await(io_rename(AT_FDCWD, from_ptr, AT_FDCWD, to_ptr));
  cond(
    (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
    true => .Ok(())
  )
});

// Create a symbolic link at `dst` pointing to `src`.
symlink :: (fn(src: String, dst: String, using(io : IO)) -> Result(unit, IOError))({
  src_cstr := src.to_cstr();
  src_ptr  := *(u8)(src_cstr.ptr().unwrap());
  dst_cstr := dst.to_cstr();
  dst_ptr  := *(u8)(dst_cstr.ptr().unwrap());
  result   := io.await(io_symlink(src_ptr, AT_FDCWD, dst_ptr));
  cond(
    (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
    true => .Ok(())
  )
});

// Create a hard link from `src` to `dst`.
hard_link :: (fn(src: String, dst: String, using(io : IO)) -> Result(unit, IOError))({
  src_cstr := src.to_cstr();
  src_ptr  := *(u8)(src_cstr.ptr().unwrap());
  dst_cstr := dst.to_cstr();
  dst_ptr  := *(u8)(dst_cstr.ptr().unwrap());
  result   := io.await(link(AT_FDCWD, src_ptr, AT_FDCWD, dst_ptr, i32(0)));
  cond(
    (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
    true => .Ok(())
  )
});

// Read directory entries. Returns all entries as an ArrayList(DirEntry).
read_dir :: (fn(path: String, using(io : IO)) -> Result(ArrayList(DirEntry), IOError))({
  path_cstr := path.to_cstr();
  path_ptr  := *(u8)(path_cstr.ptr().unwrap());

  // Open the directory
  fd_result := io.await(openat(AT_FDCWD, path_ptr, (O_RDONLY | O_DIRECTORY), i32(0)));
  cond(
    (fd_result < i32(0)) => {
      return .Err(IOError.from_errno((i32(0) - fd_result)));
    },
    true => ()
  );
  dir_fd := fd_result;

  buf_size := usize(4096);
  buf      := ArrayList(u8).with_capacity(buf_size);
  buf.set_len(buf_size);
  buf_ptr  := *(u8)(buf.ptr().unwrap());

  entries  := ArrayList(DirEntry).new();

  while runtime(true), () => {
    n := io.await(getdents(dir_fd, buf_ptr, u32(buf_size)));
    cond(
      (n < i32(0)) => {
        io.await(close(dir_fd));
        return .Err(IOError.from_errno((i32(0) - n)));
      },
      (n == i32(0)) => break,
      true => {
        offset := usize(0);
        while (offset < usize(n)), () => {
          entry_ptr := (buf_ptr &+ offset);
          reclen    := usize(__yo_dirent_reclen(entry_ptr));
          dtype     := __yo_dirent_type(entry_ptr);
          ino       := __yo_dirent_ino(entry_ptr);
          name_ptr  := __yo_dirent_name(entry_ptr);
          name_str  := String.from_cstr(name_ptr).unwrap();

          // Skip "." and ".."
          dot     := String.from(".");
          dot_dot := String.from("..");
          cond(
            ((name_str != dot) && (name_str != dot_dot)) => {
              sep        := String.from("/");
              entry_path := path.concat(sep).concat(name_str);
              entries.push(DirEntry(
                name:      name_str,
                path:      entry_path,
                file_type: _dtype_to_filetype(dtype),
                ino:       ino
              ));
            },
            true => ()
          );
          offset = (offset + reclen);
        };
      }
    );
  };

  io.await(close(dir_fd));
  .Ok(entries)
});

export
  create_dir, create_dir_all,
  remove_dir, remove_dir_all, remove_file,
  rename, symlink, hard_link,
  read_dir,
  DirEntry, FileType;
