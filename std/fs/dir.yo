// std/fs/dir.yo - High-level directory operations
//
// Wraps low-level std/io/dir with typed APIs using Result and IOError.
//
// Example:
//   { create_dir, remove_dir, read_dir } :: import "std/fs/dir";
//
//   main :: (fn(using(io : IO)) -> unit)({
//     io.await(create_dir("/tmp/yo_test"));
//     entries := io.await(read_dir("/tmp/yo_test"));
//     io.await(remove_dir("/tmp/yo_test"));
//   });

{ GlobalAllocator } :: import "../allocator";
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import "../collections/array_list";
open import "../string";
{ IOError } :: import "../io/errors";
IO_dir :: import "../io/dir";
IO_file :: import "../io/file";
{
  AT_FDCWD, AT_REMOVEDIR, O_RDONLY, O_DIRECTORY,
  DEFAULT_DIR_MODE,
  DT_REG, DT_DIR, DT_LNK
} :: import "../io/constants";

// ============================================================================
// FileType enum
// ============================================================================

FileType :: enum(
  File,
  Directory,
  Symlink,
  Other
);

export FileType;

// ============================================================================
// DirEntry
// ============================================================================

DirEntry :: struct(
  name      : String,
  file_type : FileType,
  ino       : u64
);

export DirEntry;

// ============================================================================
// Directory operations
// ============================================================================

// Create a directory at the given path.
create_dir :: (fn(path: str, using(io : IO)) -> Impl(Future(Result(unit, IOError))))({
  cstr := path.to_cstr();
  task := io.async((using(io : IO)) => {
    result := io.await(IO_dir.mkdir(AT_FDCWD, cstr, i32(DEFAULT_DIR_MODE)));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => .Ok(())
    )
  });
  return task;
});

// Create a directory and all parent directories.
// Does not error if the directory already exists.
create_dir_all :: (fn(path: str, using(io : IO)) -> Impl(Future(Result(unit, IOError))))({
  cstr := path.to_cstr();
  task := io.async((using(io : IO)) => {
    // Try creating the directory directly first
    result := io.await(IO_dir.mkdir(AT_FDCWD, cstr, i32(DEFAULT_DIR_MODE)));
    cond(
      (result >= i32(0)) => .Ok(()),
      true => {
        errno := (i32(0) - result);
        cond(
          // Already exists is OK
          (errno == i32(17)) => .Ok(()),
          // ENOENT - try to create parents
          (errno == i32(2)) => {
            // Walk the path and create each component
            s := String.from_str(path);
            bytes := s.as_bytes();
            i := usize(1);
            while runtime((i < bytes.len())), {
              cond(
                (bytes.get(i).unwrap() == u8(47)) => {
                  // '/' found - try to create this prefix
                  prefix := s.substring(usize(0), i);
                  prefix_cstr := prefix.to_str().to_cstr();
                  r := io.await(IO_dir.mkdir(AT_FDCWD, prefix_cstr, i32(DEFAULT_DIR_MODE)));
                  // Ignore EEXIST errors
                  cond(
                    ((r < i32(0)) && ((i32(0) - r) != i32(17))) => {
                      return .Err(IOError.from_errno((i32(0) - r)));
                    },
                    true => ()
                  );
                },
                true => ()
              );
              i = (i + usize(1));
            };
            // Create the final directory
            final_result := io.await(IO_dir.mkdir(AT_FDCWD, cstr, i32(DEFAULT_DIR_MODE)));
            cond(
              (final_result >= i32(0)) => .Ok(()),
              true => {
                final_errno := (i32(0) - final_result);
                cond(
                  (final_errno == i32(17)) => .Ok(()),
                  true => .Err(IOError.from_errno(final_errno))
                )
              }
            )
          },
          true => .Err(IOError.from_errno(errno))
        )
      }
    )
  });
  return task;
});

// Remove an empty directory.
remove_dir :: (fn(path: str, using(io : IO)) -> Impl(Future(Result(unit, IOError))))({
  cstr := path.to_cstr();
  task := io.async((using(io : IO)) => {
    result := io.await(IO_dir.unlink(AT_FDCWD, cstr, AT_REMOVEDIR));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => .Ok(())
    )
  });
  return task;
});

// Remove a file.
remove_file :: (fn(path: str, using(io : IO)) -> Impl(Future(Result(unit, IOError))))({
  cstr := path.to_cstr();
  task := io.async((using(io : IO)) => {
    result := io.await(IO_dir.unlink(AT_FDCWD, cstr, i32(0)));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => .Ok(())
    )
  });
  return task;
});

// Rename/move a file or directory.
rename :: (fn(from: str, to: str, using(io : IO)) -> Impl(Future(Result(unit, IOError))))({
  from_cstr := from.to_cstr();
  to_cstr := to.to_cstr();
  task := io.async((using(io : IO)) => {
    result := io.await(IO_dir.rename(AT_FDCWD, from_cstr, AT_FDCWD, to_cstr));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => .Ok(())
    )
  });
  return task;
});

// Create a hard link from src to dst.
hard_link :: (fn(src: str, dst: str, using(io : IO)) -> Impl(Future(Result(unit, IOError))))({
  src_cstr := src.to_cstr();
  dst_cstr := dst.to_cstr();
  task := io.async((using(io : IO)) => {
    result := io.await(IO_dir.link(AT_FDCWD, src_cstr, AT_FDCWD, dst_cstr, i32(0)));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => .Ok(())
    )
  });
  return task;
});

// Create a symbolic link at dst pointing to src.
symlink :: (fn(src: str, dst: str, using(io : IO)) -> Impl(Future(Result(unit, IOError))))({
  src_cstr := src.to_cstr();
  dst_cstr := dst.to_cstr();
  task := io.async((using(io : IO)) => {
    result := io.await(IO_dir.symlink(src_cstr, AT_FDCWD, dst_cstr));
    cond(
      (result < i32(0)) => .Err(IOError.from_errno((i32(0) - result))),
      true => .Ok(())
    )
  });
  return task;
});

// ============================================================================
// Directory listing
// ============================================================================

// Read directory entries from a path.
read_dir :: (fn(path: str, using(io : IO)) -> Impl(Future(Result(ArrayList(DirEntry), IOError))))({
  cstr := path.to_cstr();
  task := io.async((using(io : IO)) => {
    // Open the directory
    fd_result := io.await(IO_file.openat(AT_FDCWD, cstr, (O_RDONLY | O_DIRECTORY), i32(0)));
    cond(
      (fd_result < i32(0)) => .Err(IOError.from_errno((i32(0) - fd_result))),
      true => {
        fd := fd_result;
        entries := ArrayList(DirEntry).new();
        buf_size := u32(4096);
        buf := *(u8)(malloc(usize(buf_size)).unwrap());
        while runtime(true), {
          n := io.await(IO_dir.getdents(fd, buf, buf_size));
          cond(
            (n < i32(0)) => {
              free(.Some(*(void)(buf)));
              io.await(IO_file.close(fd));
              return .Err(IOError.from_errno((i32(0) - n)));
            },
            (n == i32(0)) => { break; },
            true => {
              offset := usize(0);
              while runtime((offset < usize(n))), {
                entry_ptr := (buf &+ offset);
                name_ptr := IO_dir.dirent_name(entry_ptr);
                name := String.from_cstr(name_ptr).unwrap();
                // Skip "." and ".."
                cond(
                  ((name.eq(String.from("."))) || (name.eq(String.from("..")))) => (),
                  true => {
                    dt := IO_dir.dirent_type(entry_ptr);
                    ft := cond(
                      (dt == DT_REG) => FileType.File,
                      (dt == DT_DIR) => FileType.Directory,
                      (dt == DT_LNK) => FileType.Symlink,
                      true => FileType.Other
                    );
                    entries.push(DirEntry(
                      name: name,
                      file_type: ft,
                      ino: IO_dir.dirent_ino(entry_ptr)
                    ));
                  }
                );
                offset = (offset + usize(IO_dir.dirent_reclen(entry_ptr)));
              };
            }
          );
        };
        free(.Some(*(void)(buf)));
        io.await(IO_file.close(fd));
        return .Ok(entries);
      }
    )
  });
  return task;
});

export
  create_dir, create_dir_all,
  remove_dir, remove_file,
  rename, hard_link, symlink,
  read_dir
;
