//! File system types for open modes, permissions, and seek positions.
//!
//! Three small vocabularies that `std/fs/file` consumes: `OpenMode` (the five
//! common open recipes) and `OpenOptions` (the full flag set, for the
//! combinations the enum cannot spell), `FilePermission` (the POSIX mode a
//! newly created file gets), and `SeekFrom` (the reference point for
//! `File.seek`, and the type argument of `std/io`'s `Seek(From)` trait).
//!
//! Nothing here performs I/O — these are the values you hand to the calls
//! that do, so every function in this module is a pure, synchronous
//! translation into POSIX flag words.
//!
//! ## Stability
//!
//! unstable — `OpenMode` and `OpenOptions` are two answers to one question
//! and only one of them should survive. `OpenOptions` (new 2026-09-09) is
//! strictly more expressive; `OpenMode` remains the argument type of
//! `File.open`, the spelling every existing caller uses, and the shape whose
//! `.CreateNew` variant does NOT grant read access the way
//! `OpenOptions.create_new(true)` can. Freezing follows a decision on
//! whether `OpenMode` becomes a set of `OpenOptions` constructors (and
//! `File.open` takes `OpenOptions`), not a release count.
//!
//! `OpenOptions.to_flags` also still returns `Result(i32, String)`, which is
//! a D1 violation carried deliberately: the four rejections are programmer
//! mistakes rather than OS failures, and giving them an error enum is
//! pending the same decision.
{ String } :: import("../string");
{ O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND, O_EXCL, O_CLOEXEC, DEFAULT_FILE_MODE } :: import("../sys/constants");
/// Determines how a file is opened.
OpenMode :: enum(
  /// Read an existing file (O_RDONLY).
  Read,
  /// Create or overwrite a file (O_WRONLY | O_CREAT | O_TRUNC).
  Write,
  /// Append to a file (O_WRONLY | O_CREAT | O_APPEND).
  Append,
  /// Read and write an existing file (O_RDWR).
  ReadWrite,
  /// Create a new file, fail if it already exists (O_WRONLY | O_CREAT | O_EXCL).
  CreateNew
);
// Convert OpenMode to POSIX open flags.
_open_mode_to_flags :: (fn(mode : OpenMode) -> i32)(
  match(
    mode,
    .Read => (O_RDONLY | O_CLOEXEC),
    .Write => (((O_WRONLY | O_CREAT) | O_TRUNC) | O_CLOEXEC),
    .Append => (((O_WRONLY | O_CREAT) | O_APPEND) | O_CLOEXEC),
    .ReadWrite => (O_RDWR | O_CLOEXEC),
    .CreateNew => (((O_WRONLY | O_CREAT) | O_EXCL) | O_CLOEXEC)
  )
);
// Returns the POSIX mode for an OpenMode.
// Read/ReadWrite don't create files, so mode is 0.
// Write/Append/CreateNew create files, so use the given permission.
_open_mode_needs_perm :: (fn(mode : OpenMode) -> bool)(
  match(
    mode,
    .Read => false,
    .Write => true,
    .Append => true,
    .ReadWrite => false,
    .CreateNew => true
  )
);
export(OpenMode, _open_mode_to_flags, _open_mode_needs_perm);
/// POSIX file permission bits.
FilePermission :: newtype(
  mode : u32
);
impl(
  FilePermission,
  /// `0o644` — `rw-r--r--`. The usual mode for a data file: writable by its
  /// owner, readable by everyone. This is what `File.open` passes when the
  /// mode creates a file and the caller named no permission; the process
  /// `umask` still clears bits from it, so a `umask` of `0o022` is what makes
  /// this the effective default rather than the request.
  default : (fn() -> Self)(
    Self(mode : u32(0o644))
  ),
  /// `0o755` — `rwxr-xr-x`. `default` plus the execute bit for everyone:
  /// scripts and binaries. Note the execute bit is only meaningful on POSIX;
  /// Windows decides executability from the file extension.
  executable : (fn() -> Self)(
    Self(mode : u32(0o755))
  ),
  /// `0o444` — `r--r--r--`. Readable by everyone, writable by nobody, which
  /// is the state `Metadata.is_readonly` reports true for. It does not stop
  /// root, and it does not stop the file's owner from `chmod`-ing it back.
  readonly : (fn() -> Self)(
    Self(mode : u32(0o444))
  ),
  /// `0o600` — `rw-------`. Owner only: the mode to use for anything holding
  /// a credential, and the mode `mkstemp` (so `TempFile`) already creates
  /// with. Unlike the other three this is not weakened by a typical `umask`,
  /// because no group or other bit is being asked for.
  private : (fn() -> Self)(
    Self(mode : u32(0o600))
  )
);
export(FilePermission);
/// A builder for the open flags — Rust's `fs::OpenOptions`.
///
/// `OpenMode`'s five variants are the common combinations, and they cannot
/// express the rest: there is no read+append, no create-without-truncate, no
/// read+write+create. Rather than grow that enum combinatorially, this builds
/// the flag set directly.
///
/// A plain value struct with functional setters, so a chain builds a new
/// value at each step and nothing is shared or allocated:
///
/// ```rust
/// f := io.await(
///   File.open_opts(path, OpenOptions.new().read(true).append(true).create(true), io),
///   { io, exn }
/// );
/// ```
///
/// `to_flags()` resolves the POSIX flag set, and REJECTS the combinations
/// POSIX would silently misinterpret rather than passing them through.
OpenOptions :: struct(
  _read : bool,
  _write : bool,
  _append : bool,
  _truncate : bool,
  _create : bool,
  _create_new : bool
);
export(OpenOptions);
impl(
  OpenOptions,
  /// All flags off. At least one of `read`/`write`/`append` must be set
  /// before `to_flags()` will accept it.
  new : (fn() -> Self)(
    Self(
      _read : false,
      _write : false,
      _append : false,
      _truncate : false,
      _create : false,
      _create_new : false
    )
  ),
  /// Open for reading.
  read : (fn(self : Self, on : bool) -> Self)(
    Self(
      _read : on,
      _write : self._write,
      _append : self._append,
      _truncate : self._truncate,
      _create : self._create,
      _create_new : self._create_new
    )
  ),
  /// Open for writing.
  write : (fn(self : Self, on : bool) -> Self)(
    Self(
      _read : self._read,
      _write : on,
      _append : self._append,
      _truncate : self._truncate,
      _create : self._create,
      _create_new : self._create_new
    )
  ),
  /// Every write goes to the END of the file regardless of the seek position
  /// (`O_APPEND`). Grants write access on its own.
  append : (fn(self : Self, on : bool) -> Self)(
    Self(
      _read : self._read,
      _write : self._write,
      _append : on,
      _truncate : self._truncate,
      _create : self._create,
      _create_new : self._create_new
    )
  ),
  /// Truncate the file to zero length on open. Needs write access.
  truncate : (fn(self : Self, on : bool) -> Self)(
    Self(
      _read : self._read,
      _write : self._write,
      _append : self._append,
      _truncate : on,
      _create : self._create,
      _create_new : self._create_new
    )
  ),
  /// Create the file if it does not exist. Needs write or append access.
  create : (fn(self : Self, on : bool) -> Self)(
    Self(
      _read : self._read,
      _write : self._write,
      _append : self._append,
      _truncate : self._truncate,
      _create : on,
      _create_new : self._create_new
    )
  ),
  /// Create the file, failing if it ALREADY exists. Implies `create`, and the
  /// check-and-create is atomic (`O_EXCL`), which is what makes it usable as a
  /// lock.
  create_new : (fn(self : Self, on : bool) -> Self)(
    Self(
      _read : self._read,
      _write : self._write,
      _append : self._append,
      _truncate : self._truncate,
      _create : self._create,
      _create_new : on
    )
  ),
  /// True when this combination can create the file, so the caller knows
  /// whether the permission argument is consulted.
  creates : (fn(self : Self) -> bool)(
    (self._create || self._create_new)
  ),
  /// The POSIX flag set, or `.Err` naming the contradiction.
  ///
  /// The rejected combinations are the ones POSIX does NOT diagnose — it
  /// quietly ignores whichever flag does not apply, handing back a file that
  /// behaves differently from what was asked:
  ///
  /// - nothing to do: no `read`, `write` or `append`.
  /// - `truncate` without write access: `O_TRUNC` with `O_RDONLY` is
  ///   undefined by POSIX and a no-op on Linux.
  /// - `truncate` with `append`: contradictory — append means every write
  ///   goes to the end, truncate means the end is zero.
  /// - `create` without write access: there is nothing to create the file for.
  to_flags : (fn(self : Self) -> Result(i32, String))(
    cond(
      ((!self._read && !self._write) && !self._append) =>
        Result(i32, String).Err(
          String.from("OpenOptions: set at least one of read, write or append")
        ),
      (self._truncate && (!self._write && !self._append)) =>
        Result(i32, String).Err(
          String.from("OpenOptions: truncate needs write access")
        ),
      (self._truncate && self._append) =>
        Result(i32, String).Err(
          String.from("OpenOptions: truncate and append are contradictory")
        ),
      (self.creates() && (!self._write && !self._append)) =>
        Result(i32, String).Err(
          String.from("OpenOptions: create needs write or append access")
        ),
      true => {
        // The access mode is a VALUE, not a bit set: O_RDONLY is 0, so it has
        // to be chosen, never OR-ed in.
        flags := cond(
          (self._read && (self._write || self._append)) => O_RDWR,
          (self._write || self._append) => O_WRONLY,
          true => O_RDONLY
        );
        with_append := cond(
          self._append => (flags | O_APPEND),
          true => flags
        );
        with_trunc := cond(
          self._truncate => (with_append | O_TRUNC),
          true => with_append
        );
        with_create := cond(
          self.creates() => (with_trunc | O_CREAT),
          true => with_trunc
        );
        // O_EXCL only means "fail if it exists" together with O_CREAT.
        with_excl := cond(
          self._create_new => (with_create | O_EXCL),
          true => with_create
        );
        Result(i32, String).Ok((with_excl | O_CLOEXEC))
      }
    )
  )
);
/// Reference point for file seek operations.
SeekFrom :: enum(
  /// Seek from the beginning of the file.
  Start,
  /// Seek relative to the current position.
  Current,
  /// Seek relative to the end of the file.
  End
);
// Convert SeekFrom to POSIX whence constant (i32).
_seek_from_to_whence :: (fn(from : SeekFrom) -> i32)(
  match(
    from,
    .Start => i32(0),
    .Current => i32(1),
    .End => i32(2)
  )
);
export(SeekFrom, _seek_from_to_whence);
