if :: ((quote(condition) : Expr,
        quote(then) : Expr,
        (quote(else) : Expr) ?= quote(())
      ) -> unquote(Expr))
  quote
    cond 
      unquote(condition) => unquote(then),
      true => unquote(else)
;

(+) :: (( quote(arg1): Expr,
          quote(arg2): Expr,
          ...(quote(arg3))
        ) -> unquote(Expr))
  quote((+) (unquote(arg1) + unquote(arg2)), unquote_splicing(arg3))
;

export 
  if
;
