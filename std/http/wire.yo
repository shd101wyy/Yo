//! HTTP/1.1 wire framing shared by `std/http`'s client and server — header
//! delimiting, `Content-Length`, `Transfer-Encoding: chunked` decoding
//! (RFC 9112 §7.1) and the generic "read one message" loop. std-internal:
//! `std/http/index.yo` does not re-export it.
pragma(Pragma.AllowUnsafe);
open(import("../string"));
{ ArrayList } :: import("../collections/array_list");
{ GlobalAllocator } :: import("../allocator");
{ malloc, free } :: GlobalAllocator;
{ IoExn } :: import("../error");
{ Reader } :: import("../io");
{ HttpError } :: import("./http.yo");
// ============================================================================
// Internal helpers
// ============================================================================
// Find the position of \r\n\r\n (end of HTTP headers)
find_header_end :: (fn(data : ArrayList(u8)) -> usize)({
  len := data.len();
  cond(
    (len < usize(4)) => {
      return(usize(0));
    },
    true => ()
  );
  i := usize(0);
  limit := (len - usize(3));
  while(runtime(i < limit), {
    cond(
      (
        (data(i) == u8(13)) &&
          (
            (data(i + usize(1)) == u8(10)) &&
              (
                (data(i + usize(2)) == u8(13)) &&
                  (data(i + usize(3)) == u8(10))
              )
          )
      ) => {
        return(i);
      },
      true => ()
    );
    i = (i + usize(1));
  });
  usize(0)
});
// SP (0x20) and HTAB (0x09) — the two bytes RFC 9112 §5 calls OWS.
_is_ows :: (fn(b : u8) -> bool)(
  (b == u8(0x20)) || (b == u8(0x09))
);
// Field names are `token`s, which RFC 9110 §5.6.2 restricts to ASCII, so a
// byte-wise ASCII fold is the whole case-insensitivity rule.
_ascii_lower :: (fn(b : u8) -> u8)(
  cond(
    ((b >= u8(65)) && (b <= u8(90))) => (b + u8(32)),
    true => b
  )
);
// Every value of the field line named `name` (ASCII, lower-case, WITHOUT the
// colon) in the header section bytes [0, header_end), in the order the lines
// appear.
//
// RFC 9112 §5 is `field-line = field-name ":" OWS field-value OWS`, and this
// scan follows it exactly:
//
//   - the name must START a line and the colon must follow it IMMEDIATELY;
//   - the start-line (request/status line) is not a field line, so a request
//     target spelling `/transfer-encoding:chunked` is not a header;
//   - the OWS after the colon is OPTIONAL and is any run of SP/HTAB, so
//     `Content-Length:5` is as legal as `Content-Length:  5`;
//   - trailing OWS is stripped too.
_header_values :: (fn(data : ArrayList(u8), header_end : usize, name : String) -> ArrayList(String))({
  out := ArrayList(String).new();
  key := name.as_bytes();
  klen := key.len();
  line_start := usize(0);
  on_start_line := true;
  while(runtime(line_start < header_end), {
    // The line runs to the next LF; a CR right before it is the CRLF
    // terminator, not content. The LAST header line has neither inside the
    // section — `header_end` is the index of the CR opening the terminating
    // CRLFCRLF — so the scan also has to stop at `header_end` itself.
    lf := line_start;
    while(runtime((lf < header_end) && (data(lf) != u8(10))), {
      lf = (lf + usize(1));
    });
    line_end := lf;
    cond(
      ((line_end > line_start) && (data(line_end - usize(1)) == u8(13))) => {
        line_end = (line_end - usize(1));
      },
      true => ()
    );
    cond(
      on_start_line => {
        on_start_line = false;
      },
      (((line_start + klen) < line_end) && (data(line_start + klen) == u8(58))) => {
        matched := true;
        k := usize(0);
        while(runtime(matched && (k < klen)), {
          cond(
            (_ascii_lower(data(line_start + k)) != key(k)) => {
              matched = false;
            },
            true => ()
          );
          k = (k + usize(1));
        });
        cond(
          matched => {
            value_start := (line_start + klen + usize(1));
            while(runtime((value_start < line_end) && _is_ows(data(value_start))), {
              value_start = (value_start + usize(1));
            });
            value_end := line_end;
            while(runtime((value_end > value_start) && _is_ows(data(value_end - usize(1)))), {
              value_end = (value_end - usize(1));
            });
            value_bytes := ArrayList(u8).new();
            j := value_start;
            while(runtime(j < value_end), {
              value_bytes.push(data(j));
              j = (j + usize(1));
            });
            out.push(String.from_bytes(value_bytes));
          },
          true => ()
        );
      },
      true => ()
    );
    line_start = (lf + usize(1));
  });
  out
});
/// What the header section says about the length of the message body.
ContentLength :: enum(
  /// No `Content-Length` field line at all.
  Absent,
  /// One non-negative length (repeated field lines all agreed on it).
  Length(n : usize),
  /// The field IS present but its value is not a single non-negative
  /// integer, or two field lines disagree. RFC 9112 §6.3 makes that
  /// unrecoverable framing — never "no body". `msg` names the defect.
  Invalid(msg : String)
);
// The largest `Content-Length` accepted (~1.15 EiB): far past any real body,
// and small enough that the `(n * 10) + digit` accumulation cannot wrap.
_MAX_CONTENT_LENGTH :: usize(0x0FFFFFFFFFFFFFFF);
// RFC 9112 §6.2 is `Content-Length = 1*DIGIT`: no sign, no leading `+`, no
// trailing junk, no comma list. `String.parse_i32` accepts `-5` and `+5` and
// collapses every other rejection into the same `.None`, so the digits are
// walked here instead.
_parse_content_length :: (fn(value : String) -> Option(usize))({
  bytes := value.as_bytes();
  cond(
    (bytes.len() == usize(0)) => {
      return(Option(usize).None);
    },
    true => ()
  );
  n := usize(0);
  i := usize(0);
  while(runtime(i < bytes.len()), {
    d := bytes(i);
    cond(
      ((d < u8(48)) || (d > u8(57))) => {
        return(Option(usize).None);
      },
      (n > (_MAX_CONTENT_LENGTH / usize(10))) => {
        return(Option(usize).None);
      },
      true => ()
    );
    n = ((n * usize(10)) + usize(d - u8(48)));
    i = (i + usize(1));
  });
  cond(
    (n > _MAX_CONTENT_LENGTH) => Option(usize).None,
    true => .Some(n)
  )
});
/// The `Content-Length` framing declared by the header section (bytes
/// `[0, header_end)`).
find_content_length :: (fn(data : ArrayList(u8), header_end : usize) -> ContentLength)({
  values := _header_values(data, header_end, `content-length`);
  cond(
    (values.len() == usize(0)) => {
      return(ContentLength.Absent);
    },
    true => ()
  );
  first := match(
    _parse_content_length(values(usize(0))),
    .Some(n) => n,
    .None => {
      return(ContentLength.Invalid(`"${values(usize(0))}" is not a non-negative integer`));
    }
  );
  // Repeated field lines are one field whose value is the comma-joined list
  // (RFC 9110 §5.2); for Content-Length that is only legal when every copy
  // says the same thing, and a disagreement is the classic smuggling shape.
  i := usize(1);
  while(runtime(i < values.len()), {
    match(
      _parse_content_length(values(i)),
      .Some(n) => {
        cond(
          (n != first) => {
            return(ContentLength.Invalid(`repeated with different values (${first.to_string()} and ${n.to_string()})`));
          },
          true => ()
        );
      },
      .None => {
        return(ContentLength.Invalid(`"${values(i)}" is not a non-negative integer`));
      }
    );
    i = (i + usize(1));
  });
  ContentLength.Length(first)
});
// True when the header section (bytes [0, header_end)) declares
// `Transfer-Encoding: chunked` (case-insensitive; the LAST listed coding
// must be `chunked` per RFC 9112 §6.1, which is also the only shape servers
// send in practice). Repeated field lines concatenate in order, so the last
// one carries the final coding.
is_chunked :: (fn(data : ArrayList(u8), header_end : usize) -> bool)({
  values := _header_values(data, header_end, `transfer-encoding`);
  cond(
    (values.len() == usize(0)) => false,
    true => values(values.len() - usize(1)).to_lowercase().ends_with(`chunked`)
  )
});
// Outcome of decoding a chunked body prefix.
Dechunk :: enum(
  // Every chunk up to and including the terminating zero chunk was present;
  // `data` is the concatenated chunk data (trailers dropped).
  Done(data : ArrayList(u8)),
  // Well-formed so far, but the terminating zero chunk has not arrived.
  Incomplete,
  // The framing is broken; `msg` names the defect.
  Malformed(msg : String)
);
_hex_digit :: (fn(b : u8) -> i32)(
  cond(
    ((b >= u8(48)) && (b <= u8(57))) => i32(b - u8(48)),
    ((b >= u8(97)) && (b <= u8(102))) => i32((b - u8(97)) + u8(10)),
    ((b >= u8(65)) && (b <= u8(70))) => i32((b - u8(65)) + u8(10)),
    true => i32(-1)
  )
);
// Decode a `Transfer-Encoding: chunked` body (RFC 9112 §7.1): repeated
// `hex-size[;extensions]CRLF data CRLF`, ended by a zero-size chunk followed
// by optional trailer fields and a final CRLF. Chunk extensions and trailers
// are skipped. `body` is bytes [body_start, len) of the raw response.
dechunk :: (fn(body : ArrayList(u8), body_start : usize) -> Dechunk)({
  out := ArrayList(u8).new();
  n := body.len();
  i := body_start;
  while(runtime(true), {
    // chunk-size: at least one hex digit, then optional ";ext" up to CRLF.
    size := usize(0);
    digits := usize(0);
    while(runtime((i < n) && (_hex_digit(body(i)) >= i32(0))), {
      cond(
        (size > usize(0x0FFFFFFF)) => {
          return(Dechunk.Malformed(`chunk size overflows`));
        },
        true => ()
      );
      size = ((size * usize(16)) + usize(_hex_digit(body(i))));
      digits = (digits + usize(1));
      i = (i + usize(1));
    });
    cond(
      (i >= n) => {
        return(Dechunk.Incomplete);
      },
      (digits == usize(0)) => {
        return(Dechunk.Malformed(`chunk size is not hex (byte ${body(i).to_string()} at offset ${(i - body_start).to_string()})`));
      },
      true => ()
    );
    // Skip a chunk extension: everything up to CRLF.
    while(runtime((i < n) && (body(i) != u8(13))), {
      i = (i + usize(1));
    });
    cond(
      ((i + usize(1)) >= n) => {
        return(Dechunk.Incomplete);
      },
      (body(i + usize(1)) != u8(10)) => {
        return(Dechunk.Malformed(`chunk size line not terminated by CRLF`));
      },
      true => ()
    );
    i = (i + usize(2));
    cond(
      (size == usize(0)) => {
        // Last chunk. Trailers (if any) run to an empty line; we need the
        // final CRLF to be present to call the body complete.
        while(runtime(true), {
          cond(
            ((i + usize(1)) >= n) => {
              return(Dechunk.Incomplete);
            },
            ((body(i) == u8(13)) && (body(i + usize(1)) == u8(10))) => {
              return(Dechunk.Done(out));
            },
            true => ()
          );
          // skip one trailer line
          while(runtime((i < n) && (body(i) != u8(10))), {
            i = (i + usize(1));
          });
          cond(
            (i >= n) => {
              return(Dechunk.Incomplete);
            },
            true => ()
          );
          i = (i + usize(1));
        });
      },
      ((i + size + usize(2)) > n) => {
        return(Dechunk.Incomplete);
      },
      true => ()
    );
    k := usize(0);
    while(runtime(k < size), {
      out.push(body(i + k));
      k = (k + usize(1));
    });
    i = (i + size);
    cond(
      ((body(i) != u8(13)) || (body(i + usize(1)) != u8(10))) => {
        return(Dechunk.Malformed(`chunk of ${size.to_string()} bytes at offset ${(i - body_start).to_string()} not followed by CRLF (got bytes ${body(i).to_string()}, ${body(i + usize(1)).to_string()})`));
      },
      true => ()
    );
    i = (i + usize(2));
  });
  Dechunk.Incomplete
});
// A framed message ENDS where its framing says it ends. `read_http_message`
// stops READING at that boundary, but the buffer can already hold more: one
// `read` can deliver the framed body and whatever the peer sent after it in a
// single call, and whether it does is the peer's write-coalescing decision, not
// ours. Handing those bytes on as body is response smuggling (RFC 9112 §11.2)
// — and it is a heisenbug, because the same server and the same client agree
// on every platform where the writes happen not to coalesce.
_message_upto :: (fn(data : ArrayList(u8), limit : usize) -> String)(
  cond(
    (limit >= data.len()) => String.from_bytes(data),
    true => {
      out := ArrayList(u8).with_capacity(limit);
      i := usize(0);
      while(runtime(i < limit), {
        out.push(data(i));
        i = (i + usize(1));
      });
      String.from_bytes(out)
    }
  )
);
// ============================================================================
// Read one full HTTP message (status/request line, headers, body)
// ============================================================================
// An `io.async` future, NOT a plain function with `io.await` inside: a plain
// function's await is a nested BLOCKING event loop, and running one from
// inside a task (fetch_with's) freezes every other task on the loop until
// this read returns — a deadlock the moment the peer is a sibling task
// (issues/fixed/sync-await-in-plain-fn-nests-the-event-loop.md).
/// Read one HTTP/1.1 message from `stream`: until `Content-Length` is
/// satisfied, until the terminating zero chunk of a chunked body, or — for a
/// RESPONSE only — until the peer closes (a response with neither framing
/// header is delimited by close, RFC 9112 §6.3 rule 8). A REQUEST with
/// neither is complete at the end of its headers (the client will not close
/// first). Throws `HttpError.ResponseTooLarge` past `max_bytes` (0 = no
/// ceiling), `HttpError.MalformedChunkedBody` on broken chunk framing and
/// `HttpError.MalformedContentLength` on a `Content-Length` that is not a
/// single non-negative integer.
/// A chunked body is handed on DECODED (`headers CRLFCRLF data`).
///
/// The three framing defects — `HttpError.ResponseTooLarge` past `max_bytes`
/// (0 = no ceiling), `MalformedChunkedBody` on broken chunk framing and
/// `MalformedContentLength` on a `Content-Length` that is not a single
/// non-negative integer — come back as the `.Err`, not as a throw: a SERVER
/// must be able to answer a bad client and keep serving, and a throw would
/// take the whole `serve` loop down with the one connection (D13: the pure
/// decoder returns `Result`; the client throws the `.Err` at its call site —
/// issues/fixed/one-malformed-request-killed-http-server-serve.md). I/O
/// failures on the stream itself still throw through `io`'s exception.
read_http_message :: (
  fn(generic(R : Type), stream : R, max_bytes : usize, is_request : bool, io : Io, where(R <: Reader)) ->
    Impl(Future(Result(String, HttpError), IoExn))
)(
  io.async(e => {
    buf_size := usize(8192);
    buf := (*u8)(malloc(buf_size).unwrap());
    result := ArrayList(u8).new();
    // A framing defect ends the read loop and comes back as the `.Err`. The
    // body is deliberately free of mid-loop `return`s: an async body's state
    // machine does not lower them, and the closure then fails codegen as
    // "never fully evaluated".
    failed := i32(0);
    failed_msg := String.new();
    // Read until connection closes or we've read the full response
    done := false;
    while(runtime(!done), {
      n := e.io.await(stream.read(buf, buf_size, e.io), e);
      cond(
        // 0 bytes means the peer closed the connection. A negative count is
        // no longer representable: NetError.check throws on error, so read()
        // only ever returns a real byte count.
        (n == usize(0)) => {
          done = true;
        },
        true => {
          // The ceiling is checked BEFORE the bytes are buffered, so a
          // hostile body never occupies more than max_bytes + one read.
          cond(
            ((max_bytes > usize(0)) && ((result.len() + n) > max_bytes)) => {
              failed = i32(1);
              done = true;
            },
            true => ()
          );
          i := usize(0);
          while(runtime(!done && (i < n)), {
            result.push((buf.add(i)).*);
            i = (i + usize(1));
          });
          // Check if we've received the full response by looking for
          // Content-Length or end of chunked transfer
          // For simplicity, check if the header section is complete
          // and if Content-Length is satisfied
          cond(
            (!done && (result.len() > usize(4))) => {
              // Check if we have a complete header section (\r\n\r\n)
              header_end := find_header_end(result);
              cond(
                (header_end > usize(0)) => {
                  body_start := (header_end + usize(4));
                  cond(
                    // Chunked: complete once the terminating zero chunk and
                    // its final CRLF are in; malformed framing surfaces below.
                    is_chunked(result, header_end) => match(
                      dechunk(result, body_start),
                      .Done(_) => {
                        done = true;
                      },
                      .Malformed(_) => {
                        done = true;
                      },
                      .Incomplete => ()
                    ),
                    true => match(
                      find_content_length(result, header_end),
                      .Length(cl) => {
                        body_len := (result.len() - body_start);
                        cond(
                          (body_len >= cl) => {
                            done = true;
                          },
                          true => ()
                        );
                      },
                      // RFC 9112 §6.3: a Content-Length that is present but
                      // unreadable is an unrecoverable framing error, NOT a
                      // body-less message — reading on would frame the body
                      // by whatever the peer does next.
                      .Invalid(msg) => {
                        failed = i32(2);
                        failed_msg = msg;
                        done = true;
                      },
                      // A request with no body framing ends with its headers.
                      .Absent => {
                        cond(
                          is_request => {
                            done = true;
                          },
                          true => ()
                        );
                      }
                    )
                  );
                },
                true => ()
              );
            },
            true => ()
          );
        }
      );
    });
    free(.Some((*void)(buf)));
    // A chunked body is handed on DECODED: the raw bytes are rewritten as
    // `headers CRLFCRLF data`, so `parse_response` sees the payload and the
    // Transfer-Encoding header stays visible on the response.
    header_end := find_header_end(result);
    cond(
      (failed == i32(1)) => Result(String, HttpError).Err(HttpError.ResponseTooLarge),
      (failed == i32(2)) => Result(String, HttpError).Err(HttpError.MalformedContentLength(failed_msg)),
      ((header_end > usize(0)) && is_chunked(result, header_end)) => {
        body_start := (header_end + usize(4));
        match(
          dechunk(result, body_start),
          .Done(data) => {
            decoded := ArrayList(u8).with_capacity(body_start + data.len());
            j := usize(0);
            while(runtime(j < body_start), {
              decoded.push(result(j));
              j = (j + usize(1));
            });
            j = usize(0);
            while(runtime(j < data.len()), {
              decoded.push(data(j));
              j = (j + usize(1));
            });
            Result(String, HttpError).Ok(String.from_bytes(decoded))
          },
          .Incomplete => Result(String, HttpError).Err(HttpError.MalformedChunkedBody(`connection closed before the terminating zero chunk`)),
          .Malformed(msg) => Result(String, HttpError).Err(HttpError.MalformedChunkedBody(msg))
        )
      },
      (header_end > usize(0)) => {
        body_start := (header_end + usize(4));
        avail := (result.len() - body_start);
        Result(String, HttpError).Ok(
          match(
            find_content_length(result, header_end),
            // `cl < avail`, not `(body_start + cl) < result.len()`: the sum can
            // overflow usize on a hostile Content-Length.
            .Length(cl) => cond(
              (cl < avail) => _message_upto(result, body_start + cl),
              true => String.from_bytes(result)
            ),
            // A REQUEST with no framing header ends with its headers; a RESPONSE
            // with none is delimited by close, so every byte read is body.
            .Absent => cond(
              is_request => _message_upto(result, body_start),
              true => String.from_bytes(result)
            ),
            // Unreachable: the read loop records `.Invalid` as soon as the header
            // section is complete.
            .Invalid(_) => String.from_bytes(result)
          )
        )
      },
      true => Result(String, HttpError).Ok(String.from_bytes(result))
    )
  })
);
export(find_header_end, ContentLength, find_content_length, is_chunked, Dechunk, dechunk, read_http_message);
