//! Minimal HTTP/1.1 server on `TcpListener` (plans/archive/STD_API_AUDIT.md §7 P1).
//!
//! One connection at a time, one request per connection (`Connection: close`
//! is added to every response) — the shape a CLI, a test fixture or a local
//! tool needs; it shares its wire code (`std/http/wire.yo`) with the client,
//! so request bodies may be `Content-Length` or chunked.
//!
//! ```yo
//! { HttpServer, HttpResponse } :: import("std/http");
//! server := io.await(HttpServer.bind(SocketAddr.loopback(u16(8080)), io), e);
//! io.await(server.serve(req -> HttpResponse.with_status(StatusCode.OK()).with_body(`hi ${req.path}`), io), e);
//! ```
//!
//! `serve` runs until `stop()` is called (checked after each connection) —
//! from another task, or from the handler itself. `serve_once` handles exactly
//! one connection, which is what a test wants. Both consume the server, so
//! the future owns it; keep a `server.clone()` (a second handle to the same
//! listener and stop flag) for `stop`, `local_addr` and `close`.
//!
//! A client's mistake never takes the server down: a request that does not
//! parse gets `400`, one that exceeds `max_request_bytes` gets `413`, one
//! with broken framing (`Content-Length` that is not a number, malformed
//! chunking) gets `400` — and `serve` goes on to the next connection. An I/O
//! failure on the accepted socket itself still propagates out of `serve`.
//!
//! ## Stability
//!
//! unstable — the SHAPE (one connection at a time, one request per
//! connection, `Connection: close` on every response) is expected to change
//! when a connection loop / keep-alive lands; `bind`, `local_addr`,
//! `with_max_request_bytes`, `serve`, `serve_once`, `stop` and `close` are
//! intended to keep their names and meanings.
import("../string");
{ IoExn } :: import("../error");
{ TcpListener, TcpStream } :: import("../net/tcp");
{ SocketAddr } :: import("../net/addr");
{ RefCell } :: import("../sync/refcell");
{ HttpError, HttpHeader, HeaderMap, StatusCode, HttpRequest, HttpResponse, parse_request } :: import("./http.yo");
{ read_http_message, MessageKind } :: import("./wire.yo");
{ RefCell, cell_value_clone } :: import("std/sync/refcell");
/// Default ceiling on a request (headers + body): 16 MiB.
DEFAULT_MAX_REQUEST_BYTES :: (usize(16) * (usize(1024) * usize(1024)));
/// Write `resp` to `stream`, with `Connection: close` unless it names a
/// `Connection` itself, and close the connection.
_respond :: (fn(stream : &TcpStream, resp : HttpResponse, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async({ &stream, resp }(e : IoExn) => {
    mut(r) := resp;
    cond(
      r.get_header(`Connection`).is_none() => {
        r.headers.insert(`Connection`, `close`);
      },
      true => ()
    );
    _w := e.io.await(stream.write_string(r.to_string(), e.io), e);
    e.io.await(stream.close(e.io), e);
    ()
  })
);
/// An HTTP/1.1 server bound to a `TcpListener`.
///
/// Semantically shared (plans/VALUES_BY_DEFAULT.md V5 part B, class S): a
/// handler calls `stop()` on the server whose `serve` future is running it,
/// so two owners outlive each other's calls. A clone is a second handle: the
/// listener sits behind an `Rc` (it is move-only, and `close`'s future
/// borrows it across a suspension) and the stop flag behind an
/// `Rc(RefCell(bool))`, so every clone sees one listener and one flag.
HttpServer :: struct(
  listener : Rc(TcpListener),
  /// Requests larger than this are answered with `413 Payload Too Large`
  /// and the connection closed; `serve` keeps going (0 lifts the ceiling).
  max_request_bytes : usize,
  stopped : Rc(RefCell(bool))
);
derive(HttpServer, Clone);
impl(
  HttpServer,
  /// Bind a listening socket on `addr` (port 0 picks a free port — read it
  /// back with `local_addr()`).
  bind : (fn(addr : SocketAddr, io : Io) -> Impl(Future(HttpServer, IoExn)))(
    io.async(e => {
      listener := e.io.await(TcpListener.bind(addr, e.io), e);
      HttpServer(listener : Rc.new(listener), max_request_bytes : DEFAULT_MAX_REQUEST_BYTES, stopped : Rc.new(RefCell(bool).new(false)))
    })
  ),
  /// The address the server is listening on.
  local_addr : (fn(self : &Self) -> SocketAddr)(
    self.listener.*.local_addr()
  ),
  /// Set the request-size ceiling (builder pattern, before `serve`; 0 =
  /// unlimited). A clone taken earlier keeps the old ceiling, which only
  /// `serve` reads.
  with_max_request_bytes : (fn(self : Self, n : usize) -> Self)({
    mut(s) := self;
    s.max_request_bytes = n;
    s
  }),
  /// Accept ONE connection and read one request from it. Returns the
  /// connection and either the request or the response it gets without
  /// reaching the handler: a request that does not parse gets a `400 Bad
  /// Request` whose body names the defect, and a framing defect (oversize,
  /// unreadable `Content-Length`, malformed chunking) is answered the same way
  /// (`413` for oversize) instead of being thrown out of the server
  /// (issues/fixed/one-malformed-request-killed-http-server-serve.md).
  _accept_request : (fn(self : &Self, io : Io) -> Impl(Future(Tuple(TcpStream, Result(HttpRequest, HttpResponse)), IoExn)))({
    // The future owns a handle to the listener and a copy of the ceiling,
    // not a borrow of the server: `accept`'s future borrows the listener,
    // and a borrow may cross an `Rc` deref.
    listener := Rc.clone(self.listener);
    max_request_bytes := self.max_request_bytes;
    io.async(e => {
      stream := e.io.await(listener.*.accept(e.io), e);
      framed := e.io.await(read_http_message(&stream, max_request_bytes, MessageKind.Request, e.io), e);
      parsed := match(
        framed,
        .Ok(raw) => match(
          parse_request(&raw),
          .Ok(req) => Result(HttpRequest, HttpResponse).Ok(req),
          .Err(perr) => Result(HttpRequest, HttpResponse).Err(HttpResponse.with_status(StatusCode.BAD_REQUEST()).with_body(perr.to_string()))
        ),
        .Err(ferr) => Result(HttpRequest, HttpResponse).Err(
          match(
            &ferr,
            .ResponseTooLarge => HttpResponse.with_status(StatusCode.CONTENT_TOO_LARGE()).with_body(`request larger than ${max_request_bytes} bytes`),
            _ => HttpResponse.with_status(StatusCode.BAD_REQUEST()).with_body(ferr.to_string())
          )
        )
      );
      (stream, parsed)
    })
  }),
  /// Accept ONE connection, read one request, run `handler`, write the
  /// response and close. A request that does not parse, or whose framing is
  /// broken, is answered without calling `handler` (`_accept_request`).
  ///
  /// The returned future owns the server and `handler` (`sink`), so it can
  /// be spawned: a
  /// closure argument moves its captures into it (plans/VALUES_BY_DEFAULT.md
  /// decision 22). A future that only borrowed the handler would be
  /// second-class, and an `io.spawn` of it is E0909
  /// (issues/fixed/2026-10-15-http-server-captures-its-borrowed-handler-into-the-connection-future.md).
  serve_once : (
    fn(self : Self, sink(handler) : Impl(Fn(req : &HttpRequest) -> HttpResponse), io : Io) ->
      Impl(Future(unit, IoExn))
  )(
    io.async(e => {
      got := e.io.await(self._accept_request(e.io), e);
      match(
        got,
        (stream, .Ok(req)) => e.io.await(_respond(&stream, handler(&req), e.io), e),
        (stream, .Err(bad)) => e.io.await(_respond(&stream, bad, e.io), e)
      );
      ()
    })
  ),
  /// Serve connections one after another until `stop()` has been called
  /// (checked after each connection completes). The future owns the server
  /// and `handler`, as `serve_once`'s does.
  serve : (
    fn(self : Self, sink(handler) : Impl(Fn(req : &HttpRequest) -> HttpResponse), io : Io) ->
      Impl(Future(unit, IoExn))
  )(
    io.async(e => {
      while(!self.stopped.with(cell_value_clone), {
        got := e.io.await(self._accept_request(e.io), e);
        match(
          got,
          (stream, .Ok(req)) => e.io.await(_respond(&stream, handler(&req), e.io), e),
          (stream, .Err(bad)) => e.io.await(_respond(&stream, bad, e.io), e)
        );
      });
      ()
    })
  ),
  /// Ask `serve` to return after the connection it is currently handling.
  /// Writes the flag every clone shares, so a handle kept beside a running
  /// `serve` (or the handler's own capture) stops it.
  stop : (fn(self : &Self) -> unit)({
    self.stopped.replace(true);
  }),
  /// Close the listening socket.
  close : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))({
    listener := Rc.clone(self.listener);
    io.async(e => {
      e.io.await(listener.*.close(e.io), e);
    })
  })
);
export(HttpServer, DEFAULT_MAX_REQUEST_BYTES);
