//! HTTP client library — types, request building, and async fetching.
// std/http - HTTP types, request/response builders, and async client.
//
// Example:
//   { HttpRequest, HttpResponse, fetch } :: import "std/http";
//   { Exception } :: import "std/error";
//
//   main :: (fn(io : IO) -> unit)({
//     exn := Exception(throw : ((err) -> {
//       println(err.message());
//       unwind ();
//     }));
//     resp := io.await(fetch(`http://example.com`, io));
//     println(resp.body);
//   });
pragma(Pragma.AllowUnsafe);
_http :: import("./http.yo");
_client :: import("./client.yo");
export(
  ...(_http),
  ...(_client)
);
