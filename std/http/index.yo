//! HTTP/1.1 client and server — types, request/response building, async
//! `fetch`, and `HttpServer` on `TcpListener`.
// std/http - HTTP types, request/response builders, and async client.
//
// Example:
//   { HttpRequest, HttpResponse, fetch } :: import "std/http";
//   { Exception } :: import "std/error";
//
//   main :: (fn(io : Io) -> unit)({
//     exn := Exception(throw : ((err) -> {
//       println(err.message());
//       unwind ();
//     }));
//     resp := io.await(fetch(`http://example.com`, io));
//     println(resp.body);
//   });
_http :: import("./http.yo");
_client :: import("./client.yo");
_server :: import("./server.yo");
export(
  ...(_http),
  ...(_client),
  ...(_server)
);
