//! Async HTTP client with high-level fetch API.
// std/http/client.yo - Async HTTP client using TCP
//
// Provides an async HTTP client and a high-level `fetch` function
// similar to JavaScript's fetch API.
//
// Example:
//   { fetch, HttpResponse } :: import "std/http";
//   { Exception } :: import "std/error";
//
//   main :: (fn(io : Io, exn : Exception) -> unit)({
//     resp := io.await(fetch(`http://example.com/api/data`, io), { io, exn });
//     println(resp.body);
//   });
pragma(Pragma.AllowUnsafe);
open(import("../string"));
{ ArrayList } :: import("../collections/array_list");
{ GlobalAllocator } :: import("../allocator");
{ malloc, free } :: GlobalAllocator;
open(import("../fmt"));
{ Error, AnyError, Exception, IoExn } :: import("../error");
{ TcpStream } :: import("../net/tcp");
{ TlsStream } :: import("../crypto/tls");
{ Reader } :: import("../io");
{ IpAddr, SocketAddr } :: import("../net/addr");
{ lookup_host } :: import("../net/dns");
{ Url, UrlError } :: import("../url");
{ Duration } :: import("../time/duration");
{ timeout } :: import("../async");
{ HttpMethod, HttpHeader, HttpRequest, HttpResponse, parse_response, http_status_text } :: import("./http.yo");
// ============================================================================
// HttpError
// ============================================================================
/// HTTP client error variants.
HttpError :: enum(
  /// Failed to connect to the remote host.
  ConnectionFailed(msg : String),
  /// The URL could not be parsed.
  InvalidUrl(msg : String),
  /// The request timed out.
  Timeout,
  /// Too many HTTP redirects.
  TooManyRedirects,
  /// The URL scheme is not supported. Only `http` is supported — `https`
  /// is REFUSED (not downgraded) until std has TLS: the client used to
  /// accept it, connect to :443, and speak plaintext HTTP
  /// (plans/STD_API_AUDIT.md C1).
  UnsupportedScheme(scheme : String),
  /// The response body exceeds the size limit.
  ResponseTooLarge,
  /// An unclassified HTTP error.
  Other(msg : String)
);
impl(
  HttpError,
  ToString(
    to_string : (
      self ->
        match(
          self,
          .ConnectionFailed(msg) => `HTTP connection failed: ${msg}`,
          .InvalidUrl(msg) => `Invalid URL: ${msg}`,
          .Timeout => `HTTP request timed out`,
          .TooManyRedirects => `Too many redirects`,
          .UnsupportedScheme(scheme) => `Unsupported scheme: ${scheme}`,
          .ResponseTooLarge => `Response too large`,
          .Other(msg) => `HTTP error: ${msg}`
        )
    )
  )
);
impl(HttpError, Error());
export(HttpError);
// ============================================================================
// FetchOptions
// ============================================================================
/// Options for configuring an HTTP request.
/// 64 MiB — the default response-body ceiling. This client buffers the WHOLE
/// response into a `String`, so an unbounded response is an OOM; the ceiling
/// protects by default. `with_max_response_bytes(0)` lifts it.
_DEFAULT_MAX_RESPONSE_BYTES :: (fn() -> u64)(u64(67108864));
/// Default redirect cap (matches curl / most browsers).
_DEFAULT_MAX_REDIRECTS :: (fn() -> u32)(u32(10));
FetchOptions :: ref(
  struct(
    method : HttpMethod,
    headers : ArrayList(HttpHeader),
    body : String,
    /// Deadline for the whole request (connect + send + read + redirects).
    /// `.None` waits forever (the historical behaviour).
    timeout : Option(Duration),
    /// Maximum 3xx redirects to follow before throwing `TooManyRedirects`.
    /// `0` disables following (a 3xx is returned verbatim).
    max_redirects : u32,
    /// Maximum response-body bytes before throwing `ResponseTooLarge`.
    /// `0` means unlimited.
    max_response_bytes : u64
  )
);
impl(
  FetchOptions,
  /// Create default options (GET, no headers, empty body, no timeout, up to
  /// 10 redirects, 64 MiB response ceiling).
  new : (fn() -> Self)(
    Self(
      method : .GET,
      headers : ArrayList(HttpHeader).new(),
      body : ``,
      timeout : Option(Duration).None,
      max_redirects : _DEFAULT_MAX_REDIRECTS(),
      max_response_bytes : _DEFAULT_MAX_RESPONSE_BYTES()
    )
  ),
  /// Set the HTTP method.
  with_method : (fn(self : Self, method : HttpMethod) -> Self)({
    self.method = method;
    self
  }),
  /// Add a request header.
  with_header : (fn(self : Self, name : String, value : String) -> Self)({
    self.headers.push(HttpHeader.new(name, value));
    self
  }),
  /// Set the request body.
  with_body : (fn(self : Self, body : String) -> Self)({
    self.body = body;
    self
  }),
  /// Set a whole-request deadline; on expiry `fetch` throws `Timeout`.
  with_timeout : (fn(self : Self, limit : Duration) -> Self)({
    self.timeout = Option(Duration).Some(limit);
    self
  }),
  /// Set the redirect cap (`0` = do not follow redirects).
  with_max_redirects : (fn(self : Self, n : u32) -> Self)({
    self.max_redirects = n;
    self
  }),
  /// Set the response-body ceiling in bytes (`0` = unlimited).
  with_max_response_bytes : (fn(self : Self, n : u64) -> Self)({
    self.max_response_bytes = n;
    self
  })
);
export(FetchOptions);
// ============================================================================
// Internal helpers
// ============================================================================
// Find the position of \r\n\r\n (end of HTTP headers)
_find_header_end :: (fn(data : ArrayList(u8)) -> usize)({
  len := data.len();
  cond(
    (len < usize(4)) => {
      return(usize(0));
    },
    true => ()
  );
  i := usize(0);
  limit := (len - usize(3));
  while(runtime(i < limit), {
    cond(
      (
        (data(i) == u8(13)) &&
          (
            (data(i + usize(1)) == u8(10)) &&
              (
                (data(i + usize(2)) == u8(13)) &&
                  (data(i + usize(3)) == u8(10))
              )
          )
      ) => {
        return(i);
      },
      true => ()
    );
    i = (i + usize(1));
  });
  usize(0)
});
// Parse Content-Length from headers; returns -1 if not found.
_find_content_length :: (fn(data : ArrayList(u8), header_end : usize) -> i32)({
  // Build header string up to header_end
  header_bytes := ArrayList(u8).new();
  i := usize(0);
  while(runtime(i < header_end), {
    header_bytes.push(data(i));
    i = (i + usize(1));
  });
  header_str := String.from_bytes(header_bytes).to_lowercase();
  match(
    header_str.index_of(`content-length:`),
    .Some(pos) => {
      val_start := (pos + usize(16));
      // Find end of value by looking for \r\n after val_start
      rest := header_str.substring(val_start, header_str.len());
      match(
        rest.index_of(`\r\n`),
        .Some(eol) => {
          val_str := rest.substring(usize(0), eol).trim();
          match(
            val_str.parse_i32(),
            .Some(n) => n,
            .None => i32(-(1))
          )
        },
        .None => {
          val_str := rest.trim();
          match(
            val_str.parse_i32(),
            .Some(n) => n,
            .None => i32(-(1))
          )
        }
      )
    },
    .None => i32(-(1))
  )
});
// ============================================================================
// Internal: read full HTTP response from a TCP stream
// ============================================================================
_read_http_response :: (fn(generic(R : Type), stream : R, max_bytes : u64, e : IoExn, where(R <: Reader)) -> String)({
  buf_size := usize(8192);
  buf := *(u8)(malloc(buf_size).unwrap());
  result := ArrayList(u8).new();
  // Read until connection closes or we've read the full response
  done := false;
  while(runtime(!(done)), {
    n := e.io.await(stream.read(buf, buf_size, e.io), e);
    cond(
      // 0 bytes means the peer closed the connection. A negative count is
      // no longer representable: NetError.check throws on error, so read()
      // only ever returns a real byte count.
      (n == usize(0)) => {
        done = true;
      },
      true => {
        i := usize(0);
        while(runtime(i < n), {
          result.push((buf.add(i)).*);
          i = (i + usize(1));
        });
        // Response-body ceiling (0 = unlimited). Enforced on the FULL buffer
        // (headers + body); the header prologue is negligible against a
        // 64 MiB default and keeps this cheap. C33: without this a hostile
        // server streams an unbounded body into memory.
        cond(
          ((max_bytes > u64(0)) && (u64(result.len()) > max_bytes)) => {
            free(.Some(*(void)(buf)));
            e.exn.throw(dyn(HttpError.ResponseTooLarge));
          },
          true => ()
        );
        // Check if we've received the full response by looking for
        // Content-Length or end of chunked transfer
        // For simplicity, check if the header section is complete
        // and if Content-Length is satisfied
        cond(
          (result.len() > usize(4)) => {
            // Check if we have a complete header section (\r\n\r\n)
            header_end := _find_header_end(result);
            cond(
              (header_end > usize(0)) => {
                // Check Content-Length
                cl := _find_content_length(result, header_end);
                cond(
                  (cl >= i32(0)) => {
                    body_start := (header_end + usize(4));
                    body_len := (result.len() - body_start);
                    cond(
                      (body_len >= usize(cl)) => {
                        done = true;
                      },
                      true => ()
                    );
                  },
                  true => ()
                );
              },
              true => ()
            );
          },
          true => ()
        );
      }
    );
  });
  free(.Some(*(void)(buf)));
  String.from_bytes(result)
});
// ============================================================================
// fetch — High-level async HTTP request (like JavaScript's fetch)
// ============================================================================
/// Resolve a redirect `Location` against the request URL (C33). Handles the
/// three real forms without a full `Url.join`: an absolute URL
/// (`http(s)://…`) is used as-is; an absolute path (`/x`) keeps the base's
/// scheme/host/port; any other relative reference resolves against the
/// base's directory. Throws `InvalidUrl` on a malformed base.
_resolve_url :: (fn(base : String, location : String, exn : Exception) -> String)({
  loc := location.trim();
  cond(
    (loc.starts_with(`http://`) || loc.starts_with(`https://`)) => {
      return(loc);
    },
    true => ()
  );
  bu := Url.parse(base, exn);
  bscheme := bu.scheme();
  bhost := match(
    bu.host(),
    .Some(h) => h,
    .None => {
      exn.throw(dyn(HttpError.InvalidUrl(`redirect base has no host`)));
      return(loc);
    }
  );
  authority := match(
    bu.port(),
    .Some(p) => `${bhost}:${p.to_string()}`,
    .None => bhost.clone()
  );
  cond(
    // Absolute path.
    loc.starts_with(`/`) => `${bscheme}://${authority}${loc}`,
    // Relative reference: resolve against the base path's directory.
    true => {
      bpath := bu.path();
      dir := match(
        bpath.last_index_of(`/`),
        .Some(slash) => bpath.substring(usize(0), slash + usize(1)),
        .None => `/`.to_string()
      );
      `${bscheme}://${authority}${dir}${loc}`
    }
  )
});
/// One HTTP round-trip against `url_str` (no redirect following). The body of
/// the old `fetch_with`; split out so the redirect loop and the timeout race
/// can drive it.
_fetch_once :: (
  fn(url_str : String, opts : FetchOptions, io : Io) ->
    Impl(Future(HttpResponse, IoExn))
)(
  io.async((e) => {
    url := Url.parse(url_str, e.exn);
    scheme := url.scheme();
    is_http := (scheme == `http`);
    is_https := (scheme == `https`);
    // Only http/https. https speaks real TLS (D6); other schemes are refused
    // before any DNS or socket work (also enforced on redirect hops — C1).
    cond(
      (is_http || is_https) => (),
      true => {
        e.exn.throw(dyn(HttpError.UnsupportedScheme(scheme)));
      }
    );
    host := match(
      url.host(),
      .Some(h) => h,
      .None => {
        e.exn.throw(dyn(HttpError.InvalidUrl(`missing host`)));
        `_` // unreachable
      }
    );
    default_port := cond(is_https => u16(443), true => u16(80));
    port := match(url.port(), .Some(p) => p, .None => default_port);
    req_path := url.path();
    cond(
      req_path.is_empty() => {
        req_path = `/`;
      },
      true => ()
    );
    match(
      url.query(),
      .Some(q) => {
        req_path = `${req_path}?${q}`;
      },
      .None => ()
    );
    req := HttpRequest.new(opts.method, req_path);
    req.set_host(host);
    hi := usize(0);
    while(runtime(hi < opts.headers.len()), {
      h := opts.headers(hi);
      req.set_header(h.name, h.value);
      hi = (hi + usize(1));
    });
    cond(
      (!(opts.body.is_empty())) => {
        req.set_body(opts.body);
        req.set_header(`Content-Length`, `${opts.body.len()}`);
      },
      true => ()
    );
    req.set_header(`Connection`, `close`);
    req_str := req.to_string();
    cap := opts.max_response_bytes;
    (raw_response : String) = ``;
    cond(
      is_https => {
        tls := e.io.await(TlsStream.connect(host.clone(), port, e.io), e);
        _wn := e.io.await(tls.write_string(req_str, e.io), e);
        raw_response = _read_http_response(tls, cap, e);
        e.io.await(tls.close(e.io), e);
      },
      true => {
        addrs := e.io.await(lookup_host(host, e.io), e);
        cond(
          (addrs.len() == usize(0)) => {
            e.exn.throw(dyn(HttpError.ConnectionFailed(`DNS resolution failed for ${host}`)));
          },
          true => ()
        );
        addr := SocketAddr.new(addrs(usize(0)), port);
        stream := e.io.await(TcpStream.connect(addr, e.io), e);
        e.io.await(stream.write_string(req_str, e.io), e);
        raw_response = _read_http_response(stream, cap, e);
        e.io.await(stream.close(e.io), e);
      }
    );
    match(
      parse_response(raw_response),
      .Ok(resp) => resp,
      .Err(err) => {
        e.exn.throw(dyn(HttpError.Other(err)));
        HttpResponse.new(i32(0), ``) // unreachable
      }
    )
  })
);
/// `_fetch_once` plus redirect following (C33): a 3xx with a `Location` is
/// followed, resolving relative locations, up to `opts.max_redirects` before
/// throwing `TooManyRedirects`. `max_redirects == 0` returns the 3xx verbatim.
_fetch_redirecting :: (
  fn(url_str : String, opts : FetchOptions, io : Io) ->
    Impl(Future(HttpResponse, IoExn))
)(
  io.async((e) => {
    (current : String) = url_str.clone();
    (redirects : u32) = u32(0);
    (out : Option(HttpResponse)) = Option(HttpResponse).None;
    while(out.is_none(), {
      resp := e.io.await(_fetch_once(current.clone(), opts, e.io), e);
      loc_opt := resp.get_header(`Location`);
      follow := ((resp.is_redirect() && (opts.max_redirects > u32(0))) && loc_opt.is_some());
      cond(
        follow => {
          cond(
            (redirects >= opts.max_redirects) => {
              e.exn.throw(dyn(HttpError.TooManyRedirects));
            },
            true => ()
          );
          loc := match(loc_opt, .Some(l) => l, .None => ``);
          current = _resolve_url(current.clone(), loc, e.exn);
          redirects = (redirects + u32(1));
        },
        true => {
          out = Option(HttpResponse).Some(resp);
        }
      );
    });
    out.unwrap()
  })
);
/// `_fetch_redirecting` with its errors CAPTURED into a `Result` instead of
/// thrown — so a spawned copy always COMPLETES with a value (never aborts).
/// This is what lets the timeout race distinguish a genuine deadline
/// (`timeout` returns `.None`) from a connection error (`.Some(.Err(msg))`):
/// a JoinHandle cannot carry an exception, so an un-captured error would be
/// indistinguishable from a timeout.
_fetch_capturing :: (
  fn(url_str : String, opts : FetchOptions, io : Io) ->
    Impl(Future(Result(HttpResponse, String), IoExn))
)(
  io.async((e) => {
    inner_exn := Exception(
      throw : (
        (err) -> {
          unwind(Result(HttpResponse, String).Err(err.to_string()));
        }
      )
    );
    resp := e.io.await(_fetch_redirecting(url_str, opts, e.io), IoExn(io : e.io, exn : inner_exn));
    Result(HttpResponse, String).Ok(resp)
  })
);
/// Perform an HTTP request with custom options.
///
/// # Example
///
/// ```rust
/// opts := FetchOptions.new().with_method(.POST).with_body(`{"key": "value"}`);
/// resp := io.await(fetch_with(`http://example.com/api`, opts, io), { io, exn });
/// ```
fetch_with :: (
  fn(url_str : String, opts : FetchOptions, io : Io) ->
    Impl(Future(HttpResponse, IoExn))
)(
  io.async(
    (e) =>
      match(
        opts.timeout,
        // No deadline: drive the request directly so real errors propagate
        // with their own type.
        .None => e.io.await(_fetch_redirecting(url_str, opts, e.io), e),
        .Some(limit) => {
          // Deadline: spawn the capturing request and race the clock. `.None`
          // is an UNAMBIGUOUS timeout (the capturing body never aborts), a
          // captured `.Err` re-throws as `Other`, `.Ok` is the response.
          handle := e.io.spawn(_fetch_capturing(url_str, opts, e.io), e);
          raced := timeout(handle, limit, e.io);
          match(
            raced,
            .None => {
              e.exn.throw(dyn(HttpError.Timeout));
              HttpResponse.new(i32(0), ``) // unreachable
            },
            .Some(res) => match(
              res,
              .Ok(resp) => resp,
              .Err(msg) => {
                e.exn.throw(dyn(HttpError.Other(msg)));
                HttpResponse.new(i32(0), ``) // unreachable
              }
            )
          )
        }
      )
  )
);
export(fetch_with);
/// Perform an HTTP GET request to the given URL string.
/// Returns the `HttpResponse` on success.
///
/// # Example
///
/// ```rust
/// resp := io.await(fetch(`http://example.com`, io), { io, exn });
/// cond(resp.is_ok() => println(resp.body), true => println(`Error`));
/// ```
fetch :: (
  fn(url_str : String, io : Io) ->
    Impl(Future(HttpResponse, IoExn))
)(
  io.async((e) => {
    // Hoisted: `io.await` directly inside `return(...)` is rejected by the
    // async state-machine codegen (a restriction `yo check` cannot see).
    resp := e.io.await(fetch_with(url_str, FetchOptions.new(), e.io), e);
    return(resp);
  })
);
export(fetch);
