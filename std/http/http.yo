//! HTTP core types — methods, headers, requests, and responses.
// std/http/http.yo - HTTP types and request/response builders
{ String } :: import("../string");
{ ArrayList } :: import("../collections/array_list");
{ ToString } :: import("../fmt");
{ Error } :: import("../error");
/// Standard HTTP request methods.
HttpMethod :: enum(GET, POST, PUT, DELETE, HEAD, PATCH, OPTIONS);
impl(
  HttpMethod,
  ToString(
    to_string : (
      self ->
        match(
          self,
          .GET => `GET`,
          .POST => `POST`,
          .PUT => `PUT`,
          .DELETE => `DELETE`,
          .HEAD => `HEAD`,
          .PATCH => `PATCH`,
          .OPTIONS => `OPTIONS`
        )
    )
  )
);
impl(
  HttpMethod,
  /// Parse a request-line method token (case-sensitive, as RFC 9110 §9.1
  /// requires). `.None` for anything not in the enum.
  from_string : (fn(s : String) -> Option(HttpMethod))(
    cond(
      (s == `GET`) => .Some(HttpMethod.GET),
      (s == `POST`) => .Some(HttpMethod.POST),
      (s == `PUT`) => .Some(HttpMethod.PUT),
      (s == `DELETE`) => .Some(HttpMethod.DELETE),
      (s == `HEAD`) => .Some(HttpMethod.HEAD),
      (s == `PATCH`) => .Some(HttpMethod.PATCH),
      (s == `OPTIONS`) => .Some(HttpMethod.OPTIONS),
      true => .None
    )
  )
);
/// An HTTP header as a name-value pair.
HttpHeader :: ref(struct(name : String, value : String));
impl(
  HttpHeader,
  /// Create a new header with the given name and value.
  new : (fn(name : String, value : String) -> Self)(
    Self(name : name, value : value)
  )
);
/// A header section — Rust's `http::HeaderMap`.
///
/// Two properties HTTP requires and a `HashMap(String, String)` cannot give:
///
/// - **field names are case-insensitive** (RFC 9110 §5.1), so `Content-Type`
///   and `content-type` are the same field. Comparison folds ASCII case;
///   the name is STORED as written, because that is what goes on the wire.
/// - **a field may appear more than once** (`Set-Cookie` always does), and the
///   order of the repeated values is significant. So this is a multimap that
///   preserves insertion order, backed by a list rather than a hash table.
///
/// `insert` replaces every existing value for a name, `append` adds one — the
/// same split Rust draws, and the reason `set_header` on a request used to
/// silently accumulate duplicates.
HeaderMap :: ref(struct(_entries : ArrayList(HttpHeader)));
impl(
  HeaderMap,
  /// An empty header section.
  new : (fn() -> Self)(
    Self(_entries : ArrayList(HttpHeader).new())
  ),
  /// Number of field LINES, counting each repeat of a name separately.
  len : (fn(self : Self) -> usize)(
    self._entries.len()
  ),
  /// True when there are no field lines.
  is_empty : (fn(self : Self) -> bool)(
    self._entries.is_empty()
  ),
  /// The first value for `name`, or `.None`. Case-insensitive.
  get : (fn(self : Self, name : String) -> Option(String))({
    lower := name.to_lowercase();
    (i : usize) = usize(0);
    while(i < self._entries.len(), i = (i + usize(1)), {
      h := self._entries(i);
      cond(
        (h.name.to_lowercase() == lower) => {
          return(.Some(h.value));
        },
        true => ()
      );
    });
    .None
  }),
  /// Every value for `name`, in the order the field lines appeared. Empty when
  /// the field is absent — which is what makes `Set-Cookie` usable.
  get_all : (fn(self : Self, name : String) -> ArrayList(String))({
    lower := name.to_lowercase();
    out := ArrayList(String).new();
    (i : usize) = usize(0);
    while(i < self._entries.len(), i = (i + usize(1)), {
      h := self._entries(i);
      cond(
        (h.name.to_lowercase() == lower) => {
          out.push(h.value);
        },
        true => ()
      );
    });
    out
  }),
  /// True when `name` has at least one value. Case-insensitive.
  contains_key : (fn(self : Self, name : String) -> bool)(
    self.get(name).is_some()
  ),
  /// Add a value for `name`, KEEPING any existing values. Rust's
  /// `HeaderMap::append`.
  append : (fn(self : Self, name : String, value : String) -> unit)({
    self._entries.push(HttpHeader.new(name, value));
  }),
  /// Set `name` to exactly `value`, dropping every value it had. Rust's
  /// `HeaderMap::insert`. Returns the first previous value, if any — a caller
  /// overwriting a header usually wants to know it was there.
  insert : (fn(self : Self, name : String, value : String) -> Option(String))({
    prev := self.get(name);
    self.remove(name);
    self._entries.push(HttpHeader.new(name, value));
    prev
  }),
  /// Remove every value for `name`, returning how many field lines went.
  remove : (fn(self : Self, name : String) -> usize)({
    lower := name.to_lowercase();
    kept := ArrayList(HttpHeader).new();
    (removed : usize) = usize(0);
    (i : usize) = usize(0);
    while(i < self._entries.len(), i = (i + usize(1)), {
      h := self._entries(i);
      cond(
        (h.name.to_lowercase() == lower) => {
          removed = (removed + usize(1));
        },
        true => {
          kept.push(h);
        }
      );
    });
    self._entries = kept;
    removed
  }),
  /// The field lines in order — for serialization and iteration. The list is a
  /// snapshot: pushing to it does not change the map.
  entries : (fn(self : Self) -> ArrayList(HttpHeader))({
    out := ArrayList(HttpHeader).new();
    (i : usize) = usize(0);
    while(i < self._entries.len(), i = (i + usize(1)), {
      out.push(self._entries(i));
    });
    out
  })
);
impl(
  HeaderMap,
  ToString(
    /// The header section in wire format — each line `Name: value\r\n`,
    /// WITHOUT the blank line that terminates the section (the message
    /// serializers add that, since they also append `Content-Length`).
    to_string : (fn(self : Self) -> String)({
      out := String.new();
      (i : usize) = usize(0);
      while(i < self._entries.len(), i = (i + usize(1)), {
        h := self._entries(i);
        out = `${out}${h.name}: ${h.value}\r\n`;
      });
      out
    })
  )
);
/// An HTTP request with method, path, headers, and optional body.
HttpRequest :: ref(
  struct(
    method : HttpMethod,
    path : String,
    headers : HeaderMap,
    body : String
  )
);
impl(
  HttpRequest,
  /// Create a new request with the given method and path.
  new : (fn(method : HttpMethod, path : String) -> Self)(
    Self(method : method, path : path, headers : HeaderMap.new(), body : ``)
  ),
  /// Add a header and return the request (builder pattern). APPENDS, so a
  /// repeatable field can be built up by chaining.
  header : (fn(self : Self, name : String, value : String) -> Self)({
    self.headers.append(name, value);
    self
  }),
  /// Set the request body and return the request (builder pattern).
  with_body : (fn(self : Self, body : String) -> Self)({
    self.body = body;
    self
  }),
  /// Set the Host header, REPLACING any existing one — there is exactly one
  /// Host per request (RFC 9112 SS3.2), and appending a second used to put both
  /// on the wire.
  set_host : (fn(self : Self, host : String) -> unit)({
    self.headers.insert(`Host`, host);
  }),
  /// Set a header, REPLACING every existing value for that name. Use
  /// `self.headers.append(...)` for a field that may legitimately repeat.
  set_header : (fn(self : Self, name : String, value : String) -> unit)({
    self.headers.insert(name, value);
  }),
  /// Set the request body.
  set_body : (fn(self : Self, body : String) -> unit)({
    self.body = body;
  }),
  /// Look up a header value by name (case-insensitive). The first value, when
  /// the field repeats — `self.headers.get_all(name)` for all of them.
  get_header : (fn(self : Self, name : String) -> Option(String))(
    self.headers.get(name)
  )
);
/// Wire-format serialization lives on the `ToString` trait (D1/D2: one
/// spelling for "render to text", also reachable through `${req}`
/// interpolation and any `T <: ToString` bound) — the same shape
/// `HttpMethod` and `HttpError` already use.
impl(
  HttpRequest,
  ToString(
    /// Serialize the request to an HTTP/1.1 wire-format string.
    to_string : (fn(self : Self) -> String)({
      result := `${self.method.to_string()} ${self.path} HTTP/1.1\r\n${self.headers.to_string()}`;
      result = `${result}\r\n`;
      cond(
        !self.body.is_empty() => {
          result = `${result}${self.body}`;
        },
        true => ()
      );
      result
    })
  )
);
/// An HTTP status code — Rust's `http::StatusCode`.
///
/// A `u16` newtype rather than a bare integer, so the CLASS predicates
/// (`is_success`, `is_client_error`, ...) live with the value instead of being
/// re-derived at every call site, and so a status cannot be confused with a
/// port, a length or a byte count. `u16` because RFC 9110 SS15 fixes the range
/// at three digits: a status is never negative, which an `i32` allowed.
StatusCode :: struct(code : u16);
impl(
  StatusCode,
  /// Wrap a raw code, or `.None` when it is outside the 100-599 range RFC 9110
  /// SS15 defines. An unrecognized code INSIDE the range is accepted — a client
  /// must treat an unknown `4xx` as `400`, so refusing it would break the very
  /// forward-compatibility the classes exist for.
  from_u16 : (fn(code : u16) -> Option(Self))(
    cond(
      ((code >= u16(100)) && (code <= u16(599))) => .Some(Self(code : code)),
      true => .None
    )
  ),
  /// The raw code.
  as_u16 : (fn(self : Self) -> u16)(
    self.code
  ),
  /// 1xx — the request was received and the process continues.
  is_informational : (fn(self : Self) -> bool)(
    (self.code >= u16(100)) && (self.code < u16(200))
  ),
  /// 2xx — the request succeeded.
  is_success : (fn(self : Self) -> bool)(
    (self.code >= u16(200)) && (self.code < u16(300))
  ),
  /// 3xx — further action is needed to complete the request.
  is_redirection : (fn(self : Self) -> bool)(
    (self.code >= u16(300)) && (self.code < u16(400))
  ),
  /// 4xx — the request was malformed or cannot be fulfilled.
  is_client_error : (fn(self : Self) -> bool)(
    (self.code >= u16(400)) && (self.code < u16(500))
  ),
  /// 5xx — the server failed to fulfil an apparently valid request.
  is_server_error : (fn(self : Self) -> bool)(
    self.code >= u16(500)
  ),
  /// 4xx or 5xx — either side's fault, but a failure either way.
  is_error : (fn(self : Self) -> bool)(
    self.code >= u16(400)
  ),
  /// The reason phrase RFC 9110 registers for this code, or `Unknown`.
  ///
  /// The phrase is ADVISORY: a server may send any text and a client must not
  /// act on it — which is why this is a lookup here rather than a field, and
  /// why `HttpResponse` keeps whatever phrase the peer actually sent.
  reason : (fn(self : Self) -> String)(
    cond(
      (self.code == u16(100)) => `Continue`,
      (self.code == u16(101)) => `Switching Protocols`,
      (self.code == u16(200)) => `OK`,
      (self.code == u16(201)) => `Created`,
      (self.code == u16(202)) => `Accepted`,
      (self.code == u16(204)) => `No Content`,
      (self.code == u16(206)) => `Partial Content`,
      (self.code == u16(301)) => `Moved Permanently`,
      (self.code == u16(302)) => `Found`,
      (self.code == u16(303)) => `See Other`,
      (self.code == u16(304)) => `Not Modified`,
      (self.code == u16(307)) => `Temporary Redirect`,
      (self.code == u16(308)) => `Permanent Redirect`,
      (self.code == u16(400)) => `Bad Request`,
      (self.code == u16(401)) => `Unauthorized`,
      (self.code == u16(403)) => `Forbidden`,
      (self.code == u16(404)) => `Not Found`,
      (self.code == u16(405)) => `Method Not Allowed`,
      (self.code == u16(408)) => `Request Timeout`,
      (self.code == u16(409)) => `Conflict`,
      (self.code == u16(410)) => `Gone`,
      (self.code == u16(411)) => `Length Required`,
      (self.code == u16(413)) => `Content Too Large`,
      (self.code == u16(414)) => `URI Too Long`,
      (self.code == u16(415)) => `Unsupported Media Type`,
      (self.code == u16(422)) => `Unprocessable Content`,
      (self.code == u16(429)) => `Too Many Requests`,
      (self.code == u16(431)) => `Request Header Fields Too Large`,
      (self.code == u16(500)) => `Internal Server Error`,
      (self.code == u16(501)) => `Not Implemented`,
      (self.code == u16(502)) => `Bad Gateway`,
      (self.code == u16(503)) => `Service Unavailable`,
      (self.code == u16(504)) => `Gateway Timeout`,
      (self.code == u16(505)) => `HTTP Version Not Supported`,
      true => `Unknown`
    )
  )
);
impl(
  StatusCode,
  ToString(
    /// The digits alone — what goes in a status line.
    to_string : (fn(self : Self) -> String)(
      self.code.to_string()
    )
  )
);
impl(
  StatusCode,
  Eq(StatusCode)(
    (==) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.code == rhs.code
    ),
    (!=) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.code != rhs.code
    )
  )
);
impl(
  StatusCode,
  Ord(StatusCode)(
    (<) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.code < rhs.code
    ),
    (<=) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.code <= rhs.code
    ),
    (>) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.code > rhs.code
    ),
    (>=) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.code >= rhs.code
    )
  )
);
/// The registered codes, as nullary constructors. Not enum variants, because
/// the set is OPEN — a server may send a registered code this list does not
/// carry, and an enum would have to reject or box it.
impl(
  StatusCode,
  OK : (fn() -> Self)(Self(code : u16(200))),
  CREATED : (fn() -> Self)(Self(code : u16(201))),
  ACCEPTED : (fn() -> Self)(Self(code : u16(202))),
  NO_CONTENT : (fn() -> Self)(Self(code : u16(204))),
  MOVED_PERMANENTLY : (fn() -> Self)(Self(code : u16(301))),
  FOUND : (fn() -> Self)(Self(code : u16(302))),
  NOT_MODIFIED : (fn() -> Self)(Self(code : u16(304))),
  TEMPORARY_REDIRECT : (fn() -> Self)(Self(code : u16(307))),
  PERMANENT_REDIRECT : (fn() -> Self)(Self(code : u16(308))),
  BAD_REQUEST : (fn() -> Self)(Self(code : u16(400))),
  UNAUTHORIZED : (fn() -> Self)(Self(code : u16(401))),
  FORBIDDEN : (fn() -> Self)(Self(code : u16(403))),
  NOT_FOUND : (fn() -> Self)(Self(code : u16(404))),
  METHOD_NOT_ALLOWED : (fn() -> Self)(Self(code : u16(405))),
  CONFLICT : (fn() -> Self)(Self(code : u16(409))),
  CONTENT_TOO_LARGE : (fn() -> Self)(Self(code : u16(413))),
  TOO_MANY_REQUESTS : (fn() -> Self)(Self(code : u16(429))),
  INTERNAL_SERVER_ERROR : (fn() -> Self)(Self(code : u16(500))),
  NOT_IMPLEMENTED : (fn() -> Self)(Self(code : u16(501))),
  BAD_GATEWAY : (fn() -> Self)(Self(code : u16(502))),
  SERVICE_UNAVAILABLE : (fn() -> Self)(Self(code : u16(503))),
  GATEWAY_TIMEOUT : (fn() -> Self)(Self(code : u16(504)))
);
/// An HTTP response with status, headers, and body.
HttpResponse :: ref(
  struct(
    /// The status. A `StatusCode`, not a bare `i32` — the class predicates
    /// belong with the value, and a status is never negative.
    status : StatusCode,
    /// The reason phrase as the peer sent it, which may be anything (RFC 9110
    /// SS15 makes it advisory). `status.reason()` gives the registered phrase
    /// instead; keeping both means a proxy can pass the original through.
    status_text : String,
    /// The version on the status line, as received — `HTTP/1.1` or
    /// `HTTP/1.0`. Kept for the same reason `status_text` is: a proxy passes
    /// it through, and connection reuse turns on it (an `HTTP/1.0` response
    /// without `Connection: keep-alive` ends its connection, RFC 9112 §9.3).
    /// `HttpResponse.new` defaults it to `HTTP/1.1`.
    version : String,
    headers : HeaderMap,
    body : String
  )
);
impl(
  HttpResponse,
  /// Create a response with the given status and reason phrase.
  new : (fn(status : StatusCode, status_text : String) -> Self)(
    Self(status : status, status_text : status_text, version : `HTTP/1.1`, headers : HeaderMap.new(), body : ``)
  ),
  /// Look up a header value by name (case-insensitive). The first value, when
  /// the field repeats — `self.headers.get_all(name)` for all of them, which
  /// is what `Set-Cookie` needs.
  get_header : (fn(self : Self, name : String) -> Option(String))(
    self.headers.get(name)
  ),
  /// Set a header, REPLACING every existing value for that name.
  set_header : (fn(self : Self, name : String, value : String) -> unit)({
    self.headers.insert(name, value);
  }),
  /// True if the status is 2xx.
  is_ok : (fn(self : Self) -> bool)(
    self.status.is_success()
  ),
  /// True if the status is 3xx.
  is_redirect : (fn(self : Self) -> bool)(
    self.status.is_redirection()
  ),
  /// True if the status is 4xx or 5xx.
  is_error : (fn(self : Self) -> bool)(
    self.status.is_error()
  ),
  /// A response with `status` and its registered reason phrase.
  with_status : (fn(status : StatusCode) -> Self)(
    Self.new(status, status.reason())
  ),
  /// Add a header and return the response (builder pattern). APPENDS, so a
  /// repeatable field can be built up by chaining.
  header : (fn(self : Self, name : String, value : String) -> Self)({
    self.headers.append(name, value);
    self
  }),
  /// Set the body and return the response (builder pattern).
  with_body : (fn(self : Self, body : String) -> Self)({
    self.body = body;
    self
  })
);
impl(
  HttpResponse,
  ToString(
    /// Serialize to wire format, on the status line's own `version` (so a
    /// parsed response round-trips). A `Content-Length` header is added
    /// when none is present (the byte length of `body`), so the peer can
    /// delimit the message without waiting for close.
    to_string : (fn(self : Self) -> String)({
      result := `${self.version} ${self.status.to_string()} ${self.status_text}\r\n${self.headers.to_string()}`;
      cond(
        self.get_header(`Content-Length`).is_none() => {
          result = `${result}Content-Length: ${self.body.len().to_string()}\r\n`;
        },
        true => ()
      );
      `${result}\r\n${self.body}`
    })
  )
);
/// Why a raw HTTP message did not parse — the error of `parse_request` and
/// `parse_response`, which are pure decoders and so return `Result` (D13).
/// Each variant carries the offending text; `to_string` renders the line a
/// server puts in its `400` body. Until 2026-09-06 the two functions returned
/// `Result(_, String)`, the one std shape a caller could neither match on nor
/// distinguish from any other string
/// (issues/fixed/http-parse-errors-were-bare-strings.md).
HttpParseError :: enum(
  /// No start line at all.
  Empty,
  /// A response whose first line is not `HTTP/<v> <code> <text>`.
  InvalidStatusLine(line : String),
  /// A status code that is not an integer.
  InvalidStatusCode(text : String),
  /// A request line that is not exactly `<method> <target> <version>`.
  InvalidRequestLine(line : String),
  /// A request method outside `HttpMethod`.
  UnknownMethod(name : String),
  /// A request version other than `HTTP/1.1` / `HTTP/1.0`.
  UnsupportedVersion(version : String),
  /// A header line without a `:`.
  InvalidHeaderLine(line : String)
);
derive(
  HttpParseError,
  Error(
    .Empty => `Empty message`,
    .InvalidStatusLine => `Invalid status line: ${line}`,
    .InvalidStatusCode => `Invalid status code: ${text}`,
    .InvalidRequestLine => `Invalid request line: ${line}`,
    .UnknownMethod => `Unknown method: ${name}`,
    .UnsupportedVersion => `Unsupported HTTP version: ${version}`,
    .InvalidHeaderLine => `Invalid header line: ${line}`
  )
);
/// Parse a raw HTTP response into an `HttpResponse`.
///
/// The head is split from the body on the `\r\n\r\n` boundary and the body is
/// sliced as BYTES — it may be binary, and it used to be reassembled by
/// splitting the WHOLE message on `\r\n` and re-joining the tail lines one
/// concatenation at a time: quadratic in the body size, and a `substring` over
/// a UTF-8 continuation byte panics.
parse_response :: (fn(raw : String) -> Result(HttpResponse, HttpParseError))({
  header_end := match(raw.index_of(`\r\n\r\n`), .Some(p) => p, .None => raw.len());
  head := raw.substring(usize(0), header_end);
  body := cond(
    ((header_end + usize(4)) <= raw.len()) => {
      raw_b := raw.as_bytes();
      body_b := ArrayList(u8).new();
      bi := (header_end + usize(4));
      while(runtime(bi < raw_b.len()), {
        body_b.push(raw_b(bi));
        bi = (bi + usize(1));
      });
      String.from_bytes(body_b)
    },
    true => String.new()
  );
  lines := head.split(`\r\n`);
  cond(
    (lines.len() == usize(0)) => {
      return(.Err(HttpParseError.Empty));
    },
    true => ()
  );
  status_line := lines(usize(0));
  cond(
    !status_line.starts_with(`HTTP/`) => {
      return(.Err(HttpParseError.InvalidStatusLine(status_line)));
    },
    true => ()
  );
  sp1_opt := status_line.index_of(` `);
  cond(
    sp1_opt.is_none() => {
      return(.Err(HttpParseError.InvalidStatusLine(status_line)));
    },
    true => ()
  );
  sp1 := sp1_opt.unwrap();
  version := status_line.substring(usize(0), sp1);
  rest := status_line.substring(sp1 + usize(1), status_line.len());
  // The reason phrase is OPTIONAL (RFC 9112 SS4): `HTTP/1.1 204` with no
  // trailing space is well-formed, and rejecting it made this parser stricter
  // than the protocol.
  sp2 := match(rest.index_of(` `), .Some(p) => p, .None => rest.len());
  code_str := rest.substring(usize(0), sp2);
  status_text := cond(
    (sp2 < rest.len()) => rest.substring(sp2 + usize(1), rest.len()),
    true => String.new()
  );
  code_opt := code_str.parse_i32();
  cond(
    code_opt.is_none() => {
      return(.Err(HttpParseError.InvalidStatusCode(code_str)));
    },
    true => ()
  );
  raw_code := code_opt.unwrap();
  // A code outside 100-599 is not a status. It used to be accepted, so a
  // garbled `HTTP/1.1 -1 x` produced a response whose every class predicate
  // answered false.
  status := cond(
    ((raw_code >= i32(100)) && (raw_code <= i32(599))) =>
      match(StatusCode.from_u16(u16(raw_code)), .Some(sc) => sc, .None => StatusCode.OK()),
    true => {
      return(.Err(HttpParseError.InvalidStatusCode(code_str)));
    }
  );
  resp := HttpResponse.new(status, status_text);
  resp.version = version;
  j := usize(1);
  while(j < lines.len(), j = (j + usize(1)), {
    hline := lines(j);
    cond(
      hline.is_empty() => (),
      true => {
        colon_opt := hline.index_of(`:`);
        cond(
          colon_opt.is_some() => {
            colon := colon_opt.unwrap();
            hname := hline.substring(usize(0), colon).trim();
            hval := hline.substring(colon + usize(1), hline.len()).trim();
            // APPEND: a repeated field (Set-Cookie) must keep every value.
            resp.headers.append(hname, hval);
          },
          true => ()
        );
      }
    );
  });
  resp.body = body;
  .Ok(resp)
});
/// Parse a raw HTTP/1.1 request (request line, headers, body) into an
/// `HttpRequest`. The body is taken verbatim — `read_http_message` has
/// already decoded chunked framing when it read the message. Errors name the
/// defect (`Invalid request line`, unknown method, unsupported HTTP version).
parse_request :: (fn(raw : String) -> Result(HttpRequest, HttpParseError))({
  header_end := match(raw.index_of(`\r\n\r\n`), .Some(p) => p, .None => raw.len());
  head := raw.substring(usize(0), header_end);
  // The body is sliced as BYTES: it may be binary (a body starting with a
  // UTF-8 continuation byte panicked the boundary-checked `substring`) —
  // bodies are byte-transparent end to end (plans/archive/STD_API_AUDIT.md, the
  // binary-bodies row; pinned by tests/http/server.test.yo).
  body := cond(
    ((header_end + usize(4)) <= raw.len()) => {
      raw_b := raw.as_bytes();
      body_b := ArrayList(u8).new();
      bi := (header_end + usize(4));
      while(runtime(bi < raw_b.len()), {
        body_b.push(raw_b(bi));
        bi = (bi + usize(1));
      });
      String.from_bytes(body_b)
    },
    true => String.new()
  );
  lines := head.split(`\r\n`);
  cond(
    ((lines.len() == usize(0)) || lines(usize(0)).is_empty()) => {
      return(.Err(HttpParseError.Empty));
    },
    true => ()
  );
  request_line := lines(usize(0));
  parts := request_line.split(` `);
  cond(
    (parts.len() != usize(3)) => {
      return(.Err(HttpParseError.InvalidRequestLine(request_line)));
    },
    true => ()
  );
  method := match(
    HttpMethod.from_string(parts(usize(0))),
    .Some(m) => m,
    .None => {
      return(.Err(HttpParseError.UnknownMethod(parts(usize(0)))));
    }
  );
  version := parts(usize(2));
  cond(
    ((version != `HTTP/1.1`) && (version != `HTTP/1.0`)) => {
      return(.Err(HttpParseError.UnsupportedVersion(version)));
    },
    true => ()
  );
  req := HttpRequest.new(method, parts(usize(1)));
  j := usize(1);
  while(j < lines.len(), j = (j + usize(1)), {
    hline := lines(j);
    match(
      hline.index_of(`:`),
      .Some(colon) => {
        hname := hline.substring(usize(0), colon).trim();
        hval := hline.substring(colon + usize(1), hline.len()).trim();
        req.headers.append(hname, hval);
      },
      .None => {
        return(.Err(HttpParseError.InvalidHeaderLine(hline)));
      }
    );
  });
  req.body = body;
  .Ok(req)
});
// ============================================================================
// HttpError
// ============================================================================
/// HTTP client error variants.
HttpError :: enum(
  /// Failed to connect to the remote host.
  ConnectionFailed(msg : String),
  /// The URL could not be parsed.
  InvalidUrl(msg : String),
  /// The whole request (every connect, write, read and redirect hop) did not
  /// finish within `FetchOptions.timeout`. Never raised without one.
  Timeout,
  /// The server kept redirecting past `FetchOptions.max_redirects` hops.
  TooManyRedirects,
  /// The URL scheme is neither `http` nor `https` (`https` speaks real TLS
  /// through `std/crypto/tls`, D6). Anything else is refused before any DNS
  /// or socket work — never downgraded (plans/archive/STD_API_AUDIT.md C1).
  UnsupportedScheme(scheme : String),
  /// The raw response (status line, headers and body) grew past
  /// `FetchOptions.max_response_bytes`; the connection is dropped there.
  ResponseTooLarge,
  /// A `Transfer-Encoding: chunked` body broke the RFC 9112 §7.1 framing —
  /// a chunk size that is not hex, a missing CRLF after a chunk, or a body
  /// that ended before its terminating zero chunk. `msg` says which.
  MalformedChunkedBody(msg : String),
  /// A `Content-Length` header field whose value is not a single
  /// non-negative integer, or two `Content-Length` field lines that
  /// disagree. RFC 9112 §6.3 makes that unrecoverable framing rather than a
  /// body-less message, so it is raised instead of being read as "absent".
  /// `msg` names the defect.
  MalformedContentLength(msg : String),
  /// An unclassified HTTP error.
  Other(msg : String)
);
derive(
  HttpError,
  Error(
    .ConnectionFailed => `HTTP connection failed: ${msg}`,
    .InvalidUrl => `Invalid URL: ${msg}`,
    .Timeout => `HTTP request timed out`,
    .TooManyRedirects => `Too many redirects`,
    .UnsupportedScheme => `Unsupported scheme: ${scheme}`,
    .ResponseTooLarge => `Response too large`,
    .MalformedChunkedBody => `Malformed chunked body: ${msg}`,
    .MalformedContentLength => `Malformed Content-Length: ${msg}`,
    .Other => `HTTP error: ${msg}`
  )
);
export(HttpError);
export(HttpMethod, HttpHeader, HeaderMap, StatusCode, HttpRequest, HttpResponse);
export(HttpParseError, parse_response, parse_request);
