// std/os/signal.yo - High-level signal handling
//
// Wraps std/sys/signal with typed Signal enum values.
//
// Example:
//   { on_signal, off_signal, Signal, SignalHandler } :: import "std/os/signal";
//
//   handler :: (fn(data: *(u8)) -> unit)({ println("Caught SIGINT"); });
//   on_signal(.Interrupt, handler);

{ IOError } :: import "../sys/errors";
{
  on_signal : _on_signal, off_signal : _off_signal, SignalHandler
} :: import "../sys/signal";
{ platform, Platform } :: import "../process";
{ Error, AnyError, Exception } :: import "../error";

// ============================================================================
// Signal enum
// ============================================================================

Signal :: enum(
  Interrupt,   // SIGINT  (Ctrl-C)
  Terminate,   // SIGTERM
  Hangup,      // SIGHUP
  User1,       // SIGUSR1
  User2,       // SIGUSR2
  Pipe,        // SIGPIPE
  Alarm,       // SIGALRM
  Child        // SIGCHLD
);

export Signal;

_signal_num :: (fn(sig: Signal) -> i32)(
  match(sig,
    .Interrupt => cond(
      (platform == Platform.Darwin) => i32(2),
      true => i32(2)
    ),
    .Terminate => cond(
      (platform == Platform.Darwin) => i32(15),
      true => i32(15)
    ),
    .Hangup => cond(
      (platform == Platform.Darwin) => i32(1),
      true => i32(1)
    ),
    .User1 => cond(
      (platform == Platform.Darwin) => i32(30),
      true => i32(10)
    ),
    .User2 => cond(
      (platform == Platform.Darwin) => i32(31),
      true => i32(12)
    ),
    .Pipe => cond(
      (platform == Platform.Darwin) => i32(13),
      true => i32(13)
    ),
    .Alarm => cond(
      (platform == Platform.Darwin) => i32(14),
      true => i32(14)
    ),
    .Child => cond(
      (platform == Platform.Darwin) => i32(20),
      true => i32(17)
    )
  )
);

// ============================================================================
// on_signal / off_signal
// ============================================================================

// Register a handler for the given signal.
on_signal :: (fn(sig: Signal, handler: SignalHandler, using(exn : Exception)) -> unit)({
  num := _signal_num(sig);
  r   := _on_signal(num, handler);
  cond(
    (r < i32(0)) => {
      exn.throw(dyn IOError.from_errno((i32(0) - r)));
    },
    true => ()
  );
});

// Remove the handler for the given signal.
off_signal :: (fn(sig: Signal, using(exn : Exception)) -> unit)({
  num := _signal_num(sig);
  r   := _off_signal(num);
  cond(
    (r < i32(0)) => {
      exn.throw(dyn IOError.from_errno((i32(0) - r)));
    },
    true => ()
  );
});

export SignalHandler, on_signal, off_signal;
