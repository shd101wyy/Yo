//! Environment directory utilities.
//!
//! Provides platform-aware paths for home, config, cache, and temp directories.
//!
//! # Example
//!
//! ```rust
//! { home_dir, temp_dir } :: import "std/os/env";
//!
//! home := home_dir();
//! tmp  := temp_dir();
//! ```
open(import("../string"));
{ platform, Platform } :: import("../process");
{ env } :: import("../env");
// ============================================================================
// Directory helpers
// ============================================================================
/// Return the current user's home directory, or `.None` if unavailable.
home_dir :: (fn() -> Option(String))(
  cond(
    (platform == Platform.Windows) => match(
      env.get(`USERPROFILE`),
      .Some(p) => .Some(p),
      .None => match(
        env.get(`HOMEDRIVE`),
        .None => .None,
        .Some(drive) => match(
          env.get(`HOMEPATH`),
          .None => .None,
          .Some(path) => .Some(drive.concat(path))
        )
      )
    ),
    true => env.get(`HOME`)
  )
);
/// Return the user-specific configuration directory.
///
/// - Linux/macOS: `$XDG_CONFIG_HOME` or `$HOME/.config`
/// - Windows: `%APPDATA%`
config_dir :: (fn() -> Option(String))(
  cond(
    (platform == Platform.Windows) => env.get(`APPDATA`),
    true => match(
      env.get(`XDG_CONFIG_HOME`),
      .Some(d) => .Some(d),
      .None => match(
        home_dir(),
        .None => .None,
        .Some(h) => .Some(h.concat(`/.config`))
      )
    )
  )
);
/// Return the user-specific cache directory.
///
/// - Linux: `$XDG_CACHE_HOME` or `$HOME/.cache`
/// - macOS: `$HOME/Library/Caches`
/// - Windows: `%LOCALAPPDATA%`
cache_dir :: (fn() -> Option(String))(
  cond(
    (platform == Platform.Windows) => env.get(`LOCALAPPDATA`),
    (platform == Platform.Macos) => match(
      home_dir(),
      .None => .None,
      .Some(h) => .Some(h.concat(`/Library/Caches`))
    ),
    true => match(
      env.get(`XDG_CACHE_HOME`),
      .Some(d) => .Some(d),
      .None => match(
        home_dir(),
        .None => .None,
        .Some(h) => .Some(h.concat(`/.cache`))
      )
    )
  )
);
/// Return the system temporary directory.
temp_dir :: (fn() -> String)(
  cond(
    (platform == Platform.Windows) => match(
      env.get(`TEMP`),
      .Some(t) => t,
      .None => `C:\Temp`
    ),
    true => `/tmp`
  )
);
export(home_dir, config_dir, cache_dir, temp_dir);
