{ ?*, ?*! } :: import "../data/primitive/ptr.yo";

c_include "<stdlib.h>",
  // Types for div functions
  div_t : Free,
  ldiv_t : Free,
  lldiv_t : Free,
  wchar_t : Free,

  // Program termination
  exit :
    (status : int) -> unit,
  quick_exit :
    (status : int) -> unit,
  _Exit :
    (status : int) -> unit,
  abort :
    () -> unit,
  atexit :
    (func : (() -> unit)) -> int,
  at_quick_exit :
    (func : (() -> unit)) -> int,

  // Memory management
  malloc :
    (size : usize) -> ?*!(unit),
  calloc :
    (nmemb : usize, size : usize) -> ?*!(unit),
  realloc :
    (ptr : ?*!(unit), size : usize) -> ?*!(unit),
  free :
    (ptr : ?*!(unit)) -> unit,
  aligned_alloc :
    (alignment : usize, size : usize) -> ?*!(unit),

  // String to number conversion
  atof :
    (nptr : *(char)) -> f64,
  atoi :
    (nptr : *(char)) -> int,
  atol :
    (nptr : *(char)) -> long,
  atoll :
    (nptr : *(char)) -> longlong,
  
  strtol :
    (nptr : *(char), endptr : ?*!(?*(char)), base : int) -> long,
  strtoll :
    (nptr : *(char), endptr : ?*!(?*(char)), base : int) -> longlong,
  strtoul :
    (nptr : *(char), endptr : ?*!(?*(char)), base : int) -> ulong,
  strtoull :
    (nptr : *(char), endptr : ?*!(?*(char)), base : int) -> ulonglong,
  
  strtof :
    (nptr : *(char), endptr : ?*!(?*(char))) -> f32,
  strtod :
    (nptr : *(char), endptr : ?*!(?*(char))) -> f64,
  strtold :
    (nptr : *(char), endptr : ?*!(?*(char))) -> longdouble,

  // Pseudo-random sequence generation
  rand :
    () -> int,
  srand :
    (seed : uint) -> unit,
  
  // C11 - Thread-safe random functions
  rand_r :
    (seedp : *!(uint)) -> int,

  // Searching and sorting
  bsearch :
    (key : *(unit), base : *(unit), nmemb : usize, size : usize, 
     compar : ((a : *(unit), b : *(unit)) -> int)) -> ?*(unit),
  qsort :
    (base : *!(unit), nmemb : usize, size : usize, 
     compar : ((a : *(unit), b : *(unit)) -> int)) -> unit,

  // Integer arithmetic
  abs :
    (j : int) -> int,
  labs :
    (j : long) -> long,
  llabs :
    (j : longlong) -> longlong,
  
  div :
    (numer : int, denom : int) -> div_t,
  ldiv :
    (numer : long, denom : long) -> ldiv_t,
  lldiv :
    (numer : longlong, denom : longlong) -> lldiv_t,

  // Environment functions
  getenv :
    (name : *(char)) -> ?*(char),
  system :
    (command : ?*(char)) -> int,

  // C11 Annex K - Bounds-checking interfaces
  getenv_s :
    (len : ?*!(usize), value : *!(char), maxsize : usize, name : *(char)) -> int,

  // Multibyte/wide character conversion
  mblen :
    (s : ?*(char), n : usize) -> int,
  mbtowc :
    (pwc : ?*!(wchar_t), s : ?*(char), n : usize) -> int,
  wctomb :
    (s : ?*!(char), wc : wchar_t) -> int,
  
  // Multibyte/wide string conversion
  mbstowcs :
    (dest : ?*!(wchar_t), src : *(char), n : usize) -> usize,
  wcstombs :
    (dest : ?*!(char), src : *(wchar_t), n : usize) -> usize,

  // C11 Annex K - Safe multibyte functions
  mbstowcs_s :
    (retval : ?*!(usize), dest : ?*!(wchar_t), destsz : usize, 
     src : *(char), len : usize) -> int,
  wcstombs_s :
    (retval : ?*!(usize), dest : ?*!(char), destsz : usize,
     src : *(wchar_t), len : usize) -> int,

  // Constants
  EXIT_SUCCESS : int,
  EXIT_FAILURE : int,
  RAND_MAX : int,
  MB_CUR_MAX : int
;

// Export all stdlib functionality
export 
  // Program termination
  exit,
  quick_exit,
  _Exit,
  abort,
  atexit,
  at_quick_exit,

  // Memory management
  malloc,
  calloc,
  realloc,
  free,
  aligned_alloc,

  // String to number conversion
  atof,
  atoi,
  atol,
  atoll,
  strtol,
  strtoll,
  strtoul,
  strtoull,
  strtof,
  strtod,
  strtold,

  // Random number generation
  rand,
  srand,
  rand_r,

  // Searching and sorting
  bsearch,
  qsort,

  // Integer arithmetic
  abs,
  labs,
  llabs,
  div,
  ldiv,
  lldiv,

  // Environment
  getenv,
  system,
  getenv_s,

  // Multibyte/wide character
  mblen,
  mbtowc,
  wctomb,
  mbstowcs,
  wcstombs,
  mbstowcs_s,
  wcstombs_s,

  // Types
  div_t,
  ldiv_t,
  lldiv_t,
  wchar_t,

  // Constants
  EXIT_SUCCESS,
  EXIT_FAILURE,
  RAND_MAX,
  MB_CUR_MAX
;
