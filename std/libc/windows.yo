//! Windows-specific C API bindings.
//! Only available when compiling for Windows.
//!
//! ## Stability
//!
//! unstable — a raw C binding, not a Yo design, and Windows-only: every
//! import must sit inside a `Platform.Windows` comptime arm or the
//! `<windows.h>` / `<io.h>` / `<direct.h>` includes reach other platforms'
//! emitted C. The public surfaces above it are `std/env` (cwd,
//! `current_exe`, environment), `std/fs` (delete / rmdir) and `std/time`
//! (local time via `_localtime64_s`). It is additive-by-demand — a Win32
//! symbol appears here the first time a `std/` module needs it — and the
//! selection embeds real Windows decisions, e.g. CRT `_write` is
//! deliberately NOT bound because async-opened fds wrap
//! `FILE_FLAG_OVERLAPPED` handles the CRT cannot serve. Freezing follows
//! the modules above it, not a release count.
// Windows type aliases (using Yo types that match the C types)
pragma(Pragma.AllowUnsafe);
pragma(Pragma.AllowUnsafe);
/// Win32's `DWORD` — a 32-bit unsigned count or error code, bound as
/// `ulong` because that is what it is on the Windows ABI. Every size,
/// length and `GetLastError` value below is one of these.
DWORD :: ulong;
/// Win32's `WCHAR` — ONE UTF-16 code unit, not a character: a non-BMP
/// code point is two of these, so a `*WCHAR` buffer length is in code
/// units and `WideCharToMultiByte` is what turns it into Yo's UTF-8.
WCHAR :: ushort;
/// Win32's `BOOL` — a C `int`, where zero is failure and ANY non-zero
/// value is success. It is not Yo's `bool`; compare against zero rather
/// than casting.
BOOL :: int;
export(DWORD);
export(WCHAR);
export(BOOL);
c_include(
  "<time.h>",
  // MSVC's re-entrant localtime: (struct tm* result, const __time64_t* timer)
  // — note the order is the REVERSE of C11 Annex K's `localtime_s`, which is
  // why std/libc/time.yo's Annex-K binding must not be called on Windows. The
  // result parameter is typed `*(void)` so this file needs no `tm` of its
  // own (C converts `void*` to `struct tm*` implicitly).
  _localtime64_s : (fn(result : *void, timer : *i64) -> int)
);
export(_localtime64_s);
c_include(
  "<windows.h>",
  // GetCurrentDirectoryW - Gets the current directory (Unicode version)
  // Returns the length of the string copied to the buffer (excluding null terminator)
  // If the buffer is too small, returns the required size (including null terminator)
  GetCurrentDirectoryW : (fn(nBufferLength : DWORD, lpBuffer : ?*WCHAR) -> DWORD),
  // SetCurrentDirectoryA - Sets the current directory (ANSI version)
  // Returns nonzero if successful, zero on failure
  SetCurrentDirectoryA : (fn(lpPathName : *char) -> BOOL),
  // WideCharToMultiByte - Converts UTF-16 to UTF-8
  WideCharToMultiByte : (
    fn(
      CodePage : u32,
      dwFlags : DWORD,
      lpWideCharStr : ?*WCHAR,
      cchWideChar : i32,
      lpMultiByteStr : ?*u8,
      cbMultiByte : i32,
      lpDefaultChar : ?*u8,
      lpUsedDefaultChar : ?*i32
    ) -> i32
  ),
  // _putenv_s - Sets environment variable (Windows-specific)
  // Returns 0 on success, non-zero on error
  _putenv_s : (fn(varname : *char, value_string : *char) -> int),
  // _environ - The process environment (MSVC UTCRT): NULL-terminated array
  // of "NAME=VALUE" strings. ANSI variant — Unicode-valued variables are
  // not represented; use env::vars() which reads this.
  _environ :
    *?*char,
  // GetModuleFileNameW - Gets the path of the current executable (Unicode
  // version; hModule = NULL means "the .exe of the current process").
  // Returns the number of WCHARs copied excluding the null terminator, or 0
  // on failure; a return value equal to nSize means the buffer was too small.
  GetModuleFileNameW : (fn(hModule : ?*void, lpFilename : *WCHAR, nSize : DWORD) -> DWORD),
  // GetLastError - the calling thread's last Win32 error code. Win32 APIs do
  // NOT set `errno`, so this is the Windows half of a raw OS error code (the
  // POSIX half being `errno`).
  GetLastError : (fn() -> DWORD),
  // Code page constants
  CP_UTF8 : u32
);
// CRT low-level I/O (the POSIX-shaped `_`-prefixed MSVCRT functions).
// NOTE: CRT `_write` deliberately NOT bound here — async-opened file fds
// wrap FILE_FLAG_OVERLAPPED handles that CRT _write cannot serve; use the
// runtime's `__yo_sync_write` (std/sys/file.yo `write_sync`) instead.
c_include(
  "<io.h>",
  // _unlink - delete a file. Returns 0 on success, -1 on error.
  // Unlike POSIX unlink, fails if the file is still open.
  _unlink : (fn(path : *char) -> int)
);
// CRT directory operations.
c_include(
  "<direct.h>",
  // _rmdir - remove an EMPTY directory. Returns 0 on success, -1 on error.
  _rmdir : (fn(path : *char) -> int)
);
export(GetCurrentDirectoryW);
export(SetCurrentDirectoryA);
export(WideCharToMultiByte);
export(_putenv_s);
export(_environ);
export(GetModuleFileNameW);
export(GetLastError);
export(CP_UTF8);
export(_unlink);
export(_rmdir);
