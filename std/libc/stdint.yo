//! C11 `<stdint.h>` — fixed-width integer types and limits.
//!
//! Note: Yo already has `i8`, `i16`, `i32`, `i64`, `u8`, `u16`, `u32`, `u64`.
//! This file provides C-compatible aliases and additional types/constants.
// Type aliases for C compatibility (mapping Yo types to C stdint names)
pragma(Pragma.AllowUnsafe);
int8_t :: i8;
int16_t :: i16;
int32_t :: i32;
int64_t :: i64;
uint8_t :: u8;
uint16_t :: u16;
uint32_t :: u32;
uint64_t :: u64;
c_include(
  "<stdint.h>",
  // Additional types needed for some limits
  wint_t : Type,
  // Least-width integer types (at least N bits)
  int_least8_t : Type,
  int_least16_t : Type,
  int_least32_t : Type,
  int_least64_t : Type,
  uint_least8_t : Type,
  uint_least16_t : Type,
  uint_least32_t : Type,
  uint_least64_t : Type,
  // Fastest minimum-width integer types (fastest with at least N bits)
  int_fast8_t : Type,
  int_fast16_t : Type,
  int_fast32_t : Type,
  int_fast64_t : Type,
  uint_fast8_t : Type,
  uint_fast16_t : Type,
  uint_fast32_t : Type,
  uint_fast64_t : Type,
  // Pointer-sized integers
  intptr_t : Type,
  uintptr_t : Type,
  // Maximum-width integer types
  intmax_t : Type,
  uintmax_t : Type,
  // Limits for exact-width integer types
  INT8_MIN : i8,
  INT8_MAX : i8,
  INT16_MIN : i16,
  INT16_MAX : i16,
  INT32_MIN : i32,
  INT32_MAX : i32,
  INT64_MIN : i64,
  INT64_MAX : i64,
  UINT8_MAX : u8,
  UINT16_MAX : u16,
  UINT32_MAX : u32,
  UINT64_MAX : u64,
  // Limits for least-width integer types
  INT_LEAST8_MIN : int_least8_t,
  INT_LEAST8_MAX : int_least8_t,
  INT_LEAST16_MIN : int_least16_t,
  INT_LEAST16_MAX : int_least16_t,
  INT_LEAST32_MIN : int_least32_t,
  INT_LEAST32_MAX : int_least32_t,
  INT_LEAST64_MIN : int_least64_t,
  INT_LEAST64_MAX : int_least64_t,
  UINT_LEAST8_MAX : uint_least8_t,
  UINT_LEAST16_MAX : uint_least16_t,
  UINT_LEAST32_MAX : uint_least32_t,
  UINT_LEAST64_MAX : uint_least64_t,
  // Limits for fastest minimum-width integer types
  INT_FAST8_MIN : int_fast8_t,
  INT_FAST8_MAX : int_fast8_t,
  INT_FAST16_MIN : int_fast16_t,
  INT_FAST16_MAX : int_fast16_t,
  INT_FAST32_MIN : int_fast32_t,
  INT_FAST32_MAX : int_fast32_t,
  INT_FAST64_MIN : int_fast64_t,
  INT_FAST64_MAX : int_fast64_t,
  UINT_FAST8_MAX : uint_fast8_t,
  UINT_FAST16_MAX : uint_fast16_t,
  UINT_FAST32_MAX : uint_fast32_t,
  UINT_FAST64_MAX : uint_fast64_t,
  // Limits for pointer-sized integer types
  INTPTR_MIN : intptr_t,
  INTPTR_MAX : intptr_t,
  UINTPTR_MAX : uintptr_t,
  // Limits for maximum-width integer types
  INTMAX_MIN : intmax_t,
  INTMAX_MAX : intmax_t,
  UINTMAX_MAX : uintmax_t,
  // Limits for ptrdiff_t, size_t, and sig_atomic_t
  PTRDIFF_MIN : isize,
  PTRDIFF_MAX : isize,
  SIZE_MAX : usize,
  SIG_ATOMIC_MIN : int,
  SIG_ATOMIC_MAX : int,
  // Limits for wint_t (wide character input type)
  WINT_MIN : wint_t,
  WINT_MAX : wint_t
);
// Export all stdint functionality
export(
  // C-compatible type aliases
  int8_t,
  int16_t,
  int32_t,
  int64_t,
  uint8_t,
  uint16_t,
  uint32_t,
  uint64_t,
  // Least-width types
  int_least8_t,
  int_least16_t,
  int_least32_t,
  int_least64_t,
  uint_least8_t,
  uint_least16_t,
  uint_least32_t,
  uint_least64_t,
  // Fastest minimum-width types
  int_fast8_t,
  int_fast16_t,
  int_fast32_t,
  int_fast64_t,
  uint_fast8_t,
  uint_fast16_t,
  uint_fast32_t,
  uint_fast64_t,
  // Pointer-sized types
  intptr_t,
  uintptr_t,
  // Maximum-width types
  intmax_t,
  uintmax_t,
  // Exact-width limits
  INT8_MIN,
  INT8_MAX,
  INT16_MIN,
  INT16_MAX,
  INT32_MIN,
  INT32_MAX,
  INT64_MIN,
  INT64_MAX,
  UINT8_MAX,
  UINT16_MAX,
  UINT32_MAX,
  UINT64_MAX,
  // Least-width limits
  INT_LEAST8_MIN,
  INT_LEAST8_MAX,
  INT_LEAST16_MIN,
  INT_LEAST16_MAX,
  INT_LEAST32_MIN,
  INT_LEAST32_MAX,
  INT_LEAST64_MIN,
  INT_LEAST64_MAX,
  UINT_LEAST8_MAX,
  UINT_LEAST16_MAX,
  UINT_LEAST32_MAX,
  UINT_LEAST64_MAX,
  // Fastest minimum-width limits
  INT_FAST8_MIN,
  INT_FAST8_MAX,
  INT_FAST16_MIN,
  INT_FAST16_MAX,
  INT_FAST32_MIN,
  INT_FAST32_MAX,
  INT_FAST64_MIN,
  INT_FAST64_MAX,
  UINT_FAST8_MAX,
  UINT_FAST16_MAX,
  UINT_FAST32_MAX,
  UINT_FAST64_MAX,
  // Pointer-sized limits
  INTPTR_MIN,
  INTPTR_MAX,
  UINTPTR_MAX,
  // Maximum-width limits
  INTMAX_MIN,
  INTMAX_MAX,
  UINTMAX_MAX,
  // Other limits
  PTRDIFF_MIN,
  PTRDIFF_MAX,
  SIZE_MAX,
  SIG_ATOMIC_MIN,
  SIG_ATOMIC_MAX,
  WINT_MIN,
  WINT_MAX,
  // Additional types
  wint_t
);
