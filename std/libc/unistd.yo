//! POSIX `<unistd.h>` — standard symbolic constants and types.
pragma(Pragma.AllowUnsafe);
c_include(
  "<unistd.h>",
  // Types
  // usize : Type,
  ssize_t : Type,
  off_t : Type,
  pid_t : Type,
  uid_t : Type,
  gid_t : Type,
  // File descriptor operations
  read :
    (fn(fd : int, buf : *void, count : usize) -> ssize_t),
  write :
    (fn(fd : int, buf : *void, count : usize) -> ssize_t),
  close :
    (fn(fd : int) -> int),
  lseek :
    (fn(fd : int, offset : off_t, whence : int) -> off_t),
  pipe :
    (fn(pipefd : *int) -> int),
  dup :
    (fn(oldfd : int) -> int),
  dup2 :
    (fn(oldfd : int, newfd : int) -> int),
  // Standard file descriptors
  STDIN_FILENO : int,
  STDOUT_FILENO : int,
  STDERR_FILENO : int,
  // File access
  access :
    (fn(pathname : *char, mode : int) -> int),
  unlink :
    (fn(pathname : *char) -> int),
  rmdir :
    (fn(pathname : *char) -> int),
  chdir :
    (fn(path : *char) -> int),
  getcwd :
    (fn(buf : *char, size : usize) -> ?*char),
  // Read the target of a symbolic link. Returns the number of bytes placed
  // in buf (NOT null-terminated), or -1 on error. Declared with `isize`
  // (ABI-compatible with `ssize_t` on all supported targets) so callers can
  // compare/convert the result numerically.
  readlink :
    (fn(pathname : *char, buf : *char, bufsiz : usize) -> isize),
  // Process control
  fork :
    (fn() -> pid_t),
  execve :
    (fn(pathname : *char, argv : **char, envp : **char) -> int),
  _exit :
    (fn(status : int) -> unit),
  getpid :
    (fn() -> pid_t),
  getppid :
    (fn() -> pid_t),
  // User/Group IDs
  getuid :
    (fn() -> uid_t),
  geteuid :
    (fn() -> uid_t),
  getgid :
    (fn() -> gid_t),
  getegid :
    (fn() -> gid_t),
  // Sleep
  sleep :
    (fn(seconds : u32) -> u32),
  usleep :
    (fn(usec : u32) -> int),
  // File access modes for access()
  R_OK : int,
  W_OK : int,
  X_OK : int,
  F_OK : int,
  // The process environment block: a NULL-terminated array of "KEY=VALUE"
  // C strings (POSIX `extern char **environ`).
  environ : *?*char
);
// Export all unistd functionality
export(
  environ,
  // Types
  ssize_t,
  off_t,
  pid_t,
  uid_t,
  gid_t,
  // File descriptor operations
  read,
  write,
  close,
  lseek,
  pipe,
  dup,
  dup2,
  // Standard file descriptors
  STDIN_FILENO,
  STDOUT_FILENO,
  STDERR_FILENO,
  // File access
  access,
  unlink,
  rmdir,
  chdir,
  getcwd,
  readlink,
  // Process control
  fork,
  execve,
  _exit,
  getpid,
  getppid,
  // User/Group IDs
  getuid,
  geteuid,
  getgid,
  getegid,
  // Sleep
  sleep,
  usleep,
  // File access modes
  R_OK,
  W_OK,
  X_OK,
  F_OK
);
