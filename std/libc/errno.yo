//! C11 `<errno.h>` — error handling constants and `errno` variable.
pragma(Pragma.AllowUnsafe);
c_include(
  "<errno.h>",
  // The errno variable - global error indicator
  errno : *int,
  // Standard C11 error constants
  // These are the minimum required by C11
  EDOM : int,
  // Domain error (math functions)
  EILSEQ : int,
  // Illegal byte sequence
  ERANGE : int,
  // Result too large
  // POSIX.1 error constants (widely supported)
  E2BIG : int,
  // Argument list too long
  EACCES : int,
  // Permission denied
  EADDRINUSE : int,
  // Address in use
  EADDRNOTAVAIL : int,
  // Address not available
  EAFNOSUPPORT : int,
  // Address family not supported
  EAGAIN : int,
  // Resource unavailable, try again
  EALREADY : int,
  // Connection already in progress
  EBADF : int,
  // Bad file descriptor
  EBADMSG : int,
  // Bad message
  EBUSY : int,
  // Device or resource busy
  ECANCELED : int,
  // Operation canceled
  ECHILD : int,
  // No child processes
  ECONNABORTED : int,
  // Connection aborted
  ECONNREFUSED : int,
  // Connection refused
  ECONNRESET : int,
  // Connection reset
  EDEADLK : int,
  // Resource deadlock would occur
  EDESTADDRREQ : int,
  // Destination address required
  EEXIST : int,
  // File exists
  EFAULT : int,
  // Bad address
  EFBIG : int,
  // File too large
  EHOSTUNREACH : int,
  // Host is unreachable
  EIDRM : int,
  // Identifier removed
  EINPROGRESS : int,
  // Operation in progress
  EINTR : int,
  // Interrupted function
  EINVAL : int,
  // Invalid argument
  EIO : int,
  // I/O error
  EISCONN : int,
  // Socket is connected
  EISDIR : int,
  // Is a directory
  ELOOP : int,
  // Too many levels of symbolic links
  EMFILE : int,
  // File descriptor value too large
  EMLINK : int,
  // Too many links
  EMSGSIZE : int,
  // Message too large
  EMULTIHOP : int,
  // Multihop attempted
  ENAMETOOLONG : int,
  // Filename too long
  ENETDOWN : int,
  // Network is down
  ENETRESET : int,
  // Connection aborted by network
  ENETUNREACH : int,
  // Network unreachable
  ENFILE : int,
  // Too many files open in system
  ENOBUFS : int,
  // No buffer space available
  ENODATA : int,
  // No message is available
  ENODEV : int,
  // No such device
  ENOENT : int,
  // No such file or directory
  ENOEXEC : int,
  // Executable file format error
  ENOLCK : int,
  // No locks available
  ENOLINK : int,
  // Link has been severed
  ENOMEM : int,
  // Not enough space
  ENOMSG : int,
  // No message of the desired type
  ENOPROTOOPT : int,
  // Protocol not available
  ENOSPC : int,
  // No space left on device
  ENOSR : int,
  // No STREAM resources
  ENOSTR : int,
  // Not a STREAM
  ENOSYS : int,
  // Function not supported
  ENOTCONN : int,
  // The socket is not connected
  ENOTDIR : int,
  // Not a directory
  ENOTEMPTY : int,
  // Directory not empty
  ENOTRECOVERABLE : int,
  // State not recoverable
  ENOTSOCK : int,
  // Not a socket
  ENOTSUP : int,
  // Not supported
  ENOTTY : int,
  // Inappropriate I/O control operation
  ENXIO : int,
  // No such device or address
  EOPNOTSUPP : int,
  // Operation not supported on socket
  EOVERFLOW : int,
  // Value too large to be stored
  EOWNERDEAD : int,
  // Previous owner died
  EPERM : int,
  // Operation not permitted
  EPIPE : int,
  // Broken pipe
  EPROTO : int,
  // Protocol error
  EPROTONOSUPPORT : int,
  // Protocol not supported
  EPROTOTYPE : int,
  // Protocol wrong type for socket
  EROFS : int,
  // Read-only file system
  ESPIPE : int,
  // Invalid seek
  ESRCH : int,
  // No such process
  ESTALE : int,
  // Stale file handle
  ETIME : int,
  // Timer expired
  ETIMEDOUT : int,
  // Connection timed out
  ETXTBSY : int,
  // Text file busy
  EWOULDBLOCK : int,
  // Operation would block
  EXDEV : int // Cross-device link
);
// Export all errno functionality
export(
  // The errno variable
  errno,
  // Standard C11 errors
  EDOM,
  EILSEQ,
  ERANGE,
  // POSIX.1 error constants
  E2BIG,
  EACCES,
  EADDRINUSE,
  EADDRNOTAVAIL,
  EAFNOSUPPORT,
  EAGAIN,
  EALREADY,
  EBADF,
  EBADMSG,
  EBUSY,
  ECANCELED,
  ECHILD,
  ECONNABORTED,
  ECONNREFUSED,
  ECONNRESET,
  EDEADLK,
  EDESTADDRREQ,
  EEXIST,
  EFAULT,
  EFBIG,
  EHOSTUNREACH,
  EIDRM,
  EINPROGRESS,
  EINTR,
  EINVAL,
  EIO,
  EISCONN,
  EISDIR,
  ELOOP,
  EMFILE,
  EMLINK,
  EMSGSIZE,
  EMULTIHOP,
  ENAMETOOLONG,
  ENETDOWN,
  ENETRESET,
  ENETUNREACH,
  ENFILE,
  ENOBUFS,
  ENODATA,
  ENODEV,
  ENOENT,
  ENOEXEC,
  ENOLCK,
  ENOLINK,
  ENOMEM,
  ENOMSG,
  ENOPROTOOPT,
  ENOSPC,
  ENOSR,
  ENOSTR,
  ENOSYS,
  ENOTCONN,
  ENOTDIR,
  ENOTEMPTY,
  ENOTRECOVERABLE,
  ENOTSOCK,
  ENOTSUP,
  ENOTTY,
  ENXIO,
  EOPNOTSUPP,
  EOVERFLOW,
  EOWNERDEAD,
  EPERM,
  EPIPE,
  EPROTO,
  EPROTONOSUPPORT,
  EPROTOTYPE,
  EROFS,
  ESPIPE,
  ESRCH,
  ESTALE,
  ETIME,
  ETIMEDOUT,
  ETXTBSY,
  EWOULDBLOCK,
  EXDEV
);
