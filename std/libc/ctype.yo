// C11 ctype.h - Character classification and conversion functions
// Provides functions to test and convert character types

// c_include "<ctype.h>",
extern "c",
  // Character classification functions
  isalnum :
    (c : int) -> int,    // alphanumeric character
  isalpha :
    (c : int) -> int,    // alphabetic character
  isblank :
    (c : int) -> int,    // blank character (C99/C11)
  iscntrl :
    (c : int) -> int,    // control character
  isdigit :
    (c : int) -> int,    // decimal digit
  isgraph :
    (c : int) -> int,    // graphical character
  islower :
    (c : int) -> int,    // lowercase letter
  isprint :
    (c : int) -> int,    // printable character
  ispunct :
    (c : int) -> int,    // punctuation character
  isspace :
    (c : int) -> int,    // whitespace character
  isupper :
    (c : int) -> int,    // uppercase letter
  isxdigit :
    (c : int) -> int,    // hexadecimal digit

  // Character conversion functions
  tolower :
    (c : int) -> int,    // convert to lowercase
  toupper :
    (c : int) -> int     // convert to uppercase
;

// Export all ctype functionality
export 
  // Character classification
  isalnum,
  isalpha,
  isblank,
  iscntrl,
  isdigit,
  isgraph,
  islower,
  isprint,
  ispunct,
  isspace,
  isupper,
  isxdigit,

  // Character conversion
  tolower,
  toupper
;
