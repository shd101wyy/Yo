//! C11 `<ctype.h>` — character classification and conversion functions.
pragma(Pragma.AllowUnsafe);
c_include(
  "<ctype.h>",
  // Character classification functions
  isalnum :
    (fn(c : int) -> int),
  // alphanumeric character
  isalpha :
    (fn(c : int) -> int),
  // alphabetic character
  isblank :
    (fn(c : int) -> int),
  // blank character (C99/C11)
  iscntrl :
    (fn(c : int) -> int),
  // control character
  isdigit :
    (fn(c : int) -> int),
  // decimal digit
  isgraph :
    (fn(c : int) -> int),
  // graphical character
  islower :
    (fn(c : int) -> int),
  // lowercase letter
  isprint :
    (fn(c : int) -> int),
  // printable character
  ispunct :
    (fn(c : int) -> int),
  // punctuation character
  isspace :
    (fn(c : int) -> int),
  // whitespace character
  isupper :
    (fn(c : int) -> int),
  // uppercase letter
  isxdigit :
    (fn(c : int) -> int),
  // hexadecimal digit
  // Character conversion functions
  tolower :
    (fn(c : int) -> int),
  // convert to lowercase
  toupper :
    (
      fn(c : int) -> int // convert to uppercase
    )
);
// Export all ctype functionality
export(
  // Character classification
  isalnum,
  isalpha,
  isblank,
  iscntrl,
  isdigit,
  isgraph,
  islower,
  isprint,
  ispunct,
  isspace,
  isupper,
  isxdigit,
  // Character conversion
  tolower,
  toupper
);
