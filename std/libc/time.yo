//! C11 `<time.h>` — date and time functions.
//!
//! ## Stability
//!
//! unstable — a raw C binding, not a Yo design. `std/time` is the public
//! surface (`Instant`, `Duration`, `DateTime`); what it takes from here is
//! `localtime_r` for `DateTime`'s local-time conversion. The bindings are
//! deliberately shaped around a portability trap this module cannot fix:
//! `tm` is opaque so `localtime_r` is typed through `*void`, and MSVC has
//! no `localtime_r` at all while its `localtime_s` REVERSES the C11 Annex K
//! argument order — so the Annex K binding here must not be called on
//! Windows, where `std/libc/windows`'s `_localtime64_s` is the equivalent.
//! Freezing would require one portable spelling of broken-down time, which
//! C does not offer; use `std/time`.
pragma(Pragma.AllowUnsafe);
c_include(
  "<time.h>",
  // Types
  time_t : Type,
  clock_t : Type,
  // Structure for broken-down time
  tm : Type,
  // C11 timespec structure
  timespec : Type,
  // Time manipulation functions
  clock :
    (fn() -> clock_t),
  time :
    (fn(timer : ?*time_t) -> time_t),
  difftime :
    (fn(time1 : time_t, time0 : time_t) -> f64),
  mktime :
    (fn(timeptr : *tm) -> time_t),
  // Time conversion functions
  asctime :
    (fn(timeptr : *tm) -> *char),
  ctime :
    (fn(timer : *time_t) -> *char),
  gmtime :
    (fn(timer : *time_t) -> ?*tm),
  localtime :
    (fn(timer : *time_t) -> ?*tm),
  // POSIX re-entrant form (glibc, Apple, musl/wasi). Not on MSVC — there the
  // equivalent is `_localtime64_s` in std/libc/windows.yo; MSVC's `localtime_s`
  // has its two arguments REVERSED from the C11 Annex K prototype below.
  // Typed through `void*` on purpose: the opaque `tm` above is emitted as a
  // bare `tm` in C, which needs the `struct` tag, while `void*` converts to
  // and from `struct tm*` implicitly.
  localtime_r :
    (fn(timer : *void, result : *void) -> ?*void),
  strftime :
    (fn(s : *char, maxsize : usize, format : *char, timeptr : *tm) -> usize),
  // C11 Annex K - Safe time functions
  asctime_s :
    (fn(s : *char, maxsize : usize, timeptr : *tm) -> int),
  ctime_s :
    (fn(s : *char, maxsize : usize, timer : *time_t) -> int),
  gmtime_s :
    (fn(timer : *time_t, result : *tm) -> ?*tm),
  localtime_s :
    (fn(timer : *time_t, result : *tm) -> ?*tm),
  // C11 - Additional time functions
  timespec_get :
    (fn(ts : *timespec, base : int) -> int),
  // Constants
  CLOCKS_PER_SEC : clock_t,
  // C11 timespec_get base values
  TIME_UTC : int,
  // Additional useful constants (implementation-defined)
  CLK_TCK : clock_t
);
// Export all time functionality
export(
  // Types
  time_t,
  clock_t,
  tm,
  timespec,
  // Time manipulation
  clock,
  time,
  difftime,
  mktime,
  // Time conversion
  asctime,
  ctime,
  gmtime,
  localtime,
  localtime_r,
  strftime,
  // C11 safe functions
  asctime_s,
  ctime_s,
  gmtime_s,
  localtime_s,
  timespec_get,
  // Constants
  CLOCKS_PER_SEC,
  TIME_UTC,
  CLK_TCK
);
