//! The network error type — `NetError`, the payload every throw in
//! `std/net` carries.
//!
//! It is the network-facing subset of `IoError` promoted to its own variants
//! (`ConnectionRefused`, `AddrInUse`, `TimedOut`, …) so a caller can `match`
//! the cases it can actually recover from, plus `Io(err)` for everything the
//! kernel reports that is not network-specific. `from_io` does that
//! promotion; `check(result, exn)` is the shape every `std/net` call site
//! uses — a negative syscall return is turned into a `NetError` and THROWN
//! (D1), which is why the byte counts those calls resolve to are always real
//! counts.
//!
//! ## Stability
//!
//! unstable — `Other(msg : String)` is the open question. It is where every
//! ADDRESS-PARSE failure currently lands (`IpAddr.parse`,
//! `SocketAddr.parse`, the port scanner), so a caller that wants to tell
//! "port above 65535" from "host is not an IP" has to read English text,
//! which D1 rules out. Rust puts that case in a separate `AddrParseError`
//! rather than in its I/O error, and `std/net/addr`'s own `## Stability`
//! names the same decision. Since callers `match` this enum, adding the
//! variants that would replace `Other` is not an additive change; freezing
//! waits on that split.
{ String } :: import("../string");
{ IoError } :: import("../sys/errors");
{ ToString } :: import("../fmt");
{ Error, AnyError, Exception } :: import("../error");
// ============================================================================
// DnsError
// ============================================================================
/// Why a name lookup failed. The runtime classifies the resolver's `EAI_*`
/// answer the same way on every platform (`std/sys/dns`'s `DNS_ERR_*`), so a
/// caller can retry `TryAgain` and give up on `NotFound`.
DnsError :: enum(
  /// The name does not exist (`EAI_NONAME`, `EAI_NODATA`). Permanent.
  NotFound,
  /// A temporary resolver failure (`EAI_AGAIN`). Retrying may succeed.
  TryAgain,
  /// A permanent resolver failure (`EAI_FAIL`).
  Fail,
  /// The resolver ran out of memory (`EAI_MEMORY`).
  NoMemory,
  /// Any other resolver failure.
  Other
);
derive(DnsError, Copy, Clone);
derive(
  DnsError,
  Error(
    .NotFound => String.from("name not found"),
    .TryAgain => String.from("temporary resolver failure"),
    .Fail => String.from("resolver failure"),
    .NoMemory => String.from("resolver out of memory"),
    .Other => String.from("resolver error")
  )
);
// ============================================================================
// NetError
// ============================================================================
/// Network-specific error type wrapping lower-level I/O errors.
NetError :: enum(
  /// The remote host refused the connection.
  ConnectionRefused,
  /// The connection was reset by the remote host.
  ConnectionReset,
  /// The connection was aborted locally.
  ConnectionAborted,
  /// The address is already in use.
  AddrInUse,
  /// The requested address is not available.
  AddrNotAvailable,
  /// The operation timed out.
  TimedOut,
  /// The remote host is unreachable.
  HostUnreachable,
  /// The network is unreachable.
  NetworkUnreachable,
  /// DNS resolution of `host` failed, for `reason`.
  DNSFailed(host : String, reason : DnsError),
  /// A wrapped lower-level I/O error.
  Io(err : IoError),
  /// An unclassified network error with a message.
  Other(msg : String)
);
impl(
  NetError,
  /// Convert an `IoError` into the corresponding `NetError` variant.
  from_io : (fn(err : IoError) -> Self)(
    match(
      err,
      .ConnectionRefused => .ConnectionRefused,
      .ConnectionReset => .ConnectionReset,
      .ConnectionAborted => .ConnectionAborted,
      .AddressInUse => .AddrInUse,
      .AddressNotAvailable => .AddrNotAvailable,
      .TimedOut => .TimedOut,
      .HostUnreachable => .HostUnreachable,
      .NetworkUnreachable => .NetworkUnreachable,
      _ => .Io(err)
    )
  )
);
derive(
  NetError,
  Error(
    .ConnectionRefused => String.from("connection refused"),
    .ConnectionReset => String.from("connection reset by peer"),
    .ConnectionAborted => String.from("connection aborted"),
    .AddrInUse => String.from("address already in use"),
    .AddrNotAvailable => String.from("address not available"),
    .TimedOut => String.from("operation timed out"),
    .HostUnreachable => String.from("host unreachable"),
    .NetworkUnreachable => String.from("network unreachable"),
    .DNSFailed => `DNS lookup failed for ${host}: ${reason.to_string()}`,
    .Io => err.to_string(),
    .Other => msg
  )
);
impl(
  NetError,
  /// Check a raw syscall result and throw on error.
  /// Positive values are returned as-is; negative values are converted to a `NetError` and thrown.
  check : (fn(result : i32, exn : &Exception) -> i32)(
    cond(
      (result >= i32(0)) => result,
      true => exn.throw(dyn(Self.from_io(IoError.from_errno(i32(0) - result))))
    )
  )
);
export(NetError, DnsError);
