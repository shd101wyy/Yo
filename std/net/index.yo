//! Networking: addresses, DNS, TCP, UDP and Unix-domain sockets.
//!
//! A re-export barrel: `{ X } :: import("std/net")` and `{ X } :: import("std/net/<module>")` name the same `X`.
//! It defines nothing of its own and lists the modules' public names only, so a module's `_`-prefixed
//! helpers and compiler-facing symbols do not cross the boundary.
{ IpAddr, SocketAddr } :: import("./addr.yo");
{ lookup_host, resolve } :: import("./dns.yo");
{ NetError, DnsError } :: import("./errors.yo");
{ Shutdown, make_sockaddr, sockaddr_to_socket_addr, Incoming, TcpListener, TcpStream } :: import("./tcp.yo");
{ UdpSocket } :: import("./udp.yo");
{ UnixListener, UnixStream } :: import("./unix.yo");
export(IpAddr, SocketAddr, lookup_host, resolve, NetError, DnsError, Shutdown, make_sockaddr, sockaddr_to_socket_addr, Incoming, TcpListener, TcpStream, UdpSocket, UnixListener, UnixStream);
