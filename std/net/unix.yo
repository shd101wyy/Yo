//! Unix domain sockets — `UnixListener` / `UnixStream`
//! (`plans/archive/STD_API_AUDIT.md` §7 P0 item 10: the sys layer was fully plumbed
//! with no typed wrapper). The API mirrors `TcpListener`/`TcpStream`
//! one-to-one, with a filesystem `Path` where TCP has a `SocketAddr`.
//!
//! The LISTENER's socket file is NOT removed on `close` — like Rust, the
//! caller unlinks it (`fs_dir.remove_file`); binding to a path that already
//! exists throws `AddressInUse`.
//!
//! Every network operation is an `io.async` future on the single event-loop
//! thread, and kernel failures throw `IoExn` carrying a `NetError` (D1)
//! rather than resolving to a negative count.
//!
//! ## Stability
//!
//! unstable — it mirrors `std/net/tcp` one-to-one deliberately, which means
//! it also inherits that module's open shapes: no pointer-free read (safe
//! code needs `std/io/bufio`'s `BufReader` or the `Reader` defaults), and no
//! `incoming`, which waits on an async iterator protocol. Two things are
//! specific to this module and not yet decided: a stream cannot report the
//! peer path Rust's `UnixStream::peer_addr` gives, even though the pieces
//! exist one layer down (`std/sys/sockinfo.getpeername` plus
//! `std/sys/unix.sockaddr_un_path`) — so the shape of a Unix address in this
//! API is still unchosen; and there is no `UnixDatagram` beside the stream
//! pair. Freezing follows the tcp decisions plus an address accessor.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("../collections/array_list");
{ String } :: import("../string");
{ Path } :: import("../path");
{ NetError } :: import("./errors");
{ IoError } :: import("../sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("../error");
IO_unix :: import("../sys/unix");
SockInfo :: import("../sys/sockinfo");
IoTraits :: import("../io");
{ GlobalAllocator } :: import("../allocator");
{ malloc, free } :: GlobalAllocator;

_throw_io :: (fn(errno_val : i32, exn : Exception) -> unit)(
  exn.throw(dyn(NetError.from_io(IoError.from_errno(errno_val))))
);
/// A Unix-domain socket descriptor behind a `UnixStream`'s `Box`. Its
/// `Drop` closes the socket unless `close` already did.
_UnixSocketState :: struct(
  _fd : i32,
  _is_closed : bool
);
impl(
  _UnixSocketState,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      cond(
        !self._is_closed => {
          { close_sync } :: import("../sys/file");
          close_sync(self._fd);
          self._is_closed = true;
        },
        true => ()
      );
    })
  )
);
/// A connected Unix-domain stream socket.
///
/// A move-only value (its state is a `Box`): one owner closes the socket, and
/// a copy is E0901. Lend it with `&s`, or share it as `Rc(UnixStream)`.
/// `close` marks the socket closed inside the box, so it is never `Sync`.
UnixStream :: struct(_cell : Box(_UnixSocketState));
impl(UnixStream, !Sync());
/// The listening socket and its path behind a `UnixListener`'s `Box`.
_UnixListenerState :: struct(
  _sock : _UnixSocketState,
  _path : String
);
/// A Unix-domain socket listening on a filesystem path. Move-only, as
/// `UnixStream` is; dropping it closes the socket (the socket FILE stays).
UnixListener :: struct(_cell : Box(_UnixListenerState));
impl(UnixListener, !Sync());
/// Close `st`'s socket from an async body, at most once.
_close_unix :: (fn(st : *_UnixSocketState, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    cond(
      unsafe(st.*._is_closed) => (),
      true => {
        r := e.io.await(IO_unix.close(unsafe(st.*._fd)), e.io);
        unsafe(consume(st.*._is_closed = true));
        cond(
          (r < i32(0)) => {
            _throw_io(i32(0) - r, e.exn);
          },
          true => ()
        );
      }
    );
  })
);
impl(
  UnixListener,
  /// Bind to a filesystem path and start listening. The path must not
  /// already exist (`AddressInUse` otherwise) and is NOT unlinked on close.
  bind : (fn(path : &Path, io : Io) -> Impl(Future(UnixListener, IoExn)))(
    io.async(e => {
      raw_fd := e.io.await(IO_unix.socket_stream(), e.io);
      fd := NetError.check(raw_fd, e.exn);
      path_s := path.to_string();
      cstr_bytes := match(path_s.to_cstr_checked(), .Ok(b) => b, .Err(_) => e.exn.throw(dyn(IoError.InvalidInput)));
      addr := IO_unix.make_sockaddr_un(cstr_bytes.ptr().unwrap());
      addr_buf := match(
        addr.buf,
        .Some(p) => p,
        .None => {
          e.io.await(IO_unix.close(fd), e.io);
          e.exn.throw(dyn(NetError.from_io(IoError.NotSupported)));
          (*u8)("")
        }
      );
      bind_result := e.io.await(IO_unix.bind(fd, addr_buf, addr.len), e.io);
      IO_unix.free_addr(addr);
      cond(
        (bind_result < i32(0)) => {
          e.io.await(IO_unix.close(fd), e.io);
          _throw_io(i32(0) - bind_result, e.exn);
        },
        true => ()
      );
      listen_result := e.io.await(IO_unix.listen(fd, i32(128)), e.io);
      cond(
        (listen_result < i32(0)) => {
          e.io.await(IO_unix.close(fd), e.io);
          _throw_io(i32(0) - listen_result, e.exn);
        },
        true => ()
      );
      return(UnixListener(_cell : box(_UnixListenerState(_sock : _UnixSocketState(_fd : fd, _is_closed : false), _path : path_s))));
    })
  ),
  /// Accept an incoming connection, returning a new `UnixStream`.
  accept : (fn(self : &Self, io : Io) -> Impl(Future(UnixStream, IoExn)))({
    fd := self._cell._sock._fd;
    io.async(e => {
      addr_buf := (*u8)(malloc(usize(128)).unwrap());
      addr_len := (*u32)(malloc(usize(4)).unwrap());
      addr_len.* = u32(128);
      client_fd := e.io.await(IO_unix.accept(fd, addr_buf, addr_len), e.io);
      free(.Some((*void)(addr_buf)));
      free(.Some((*void)(addr_len)));
      cond(
        (client_fd < i32(0)) => _throw_io(i32(0) - client_fd, e.exn),
        true => ()
      );
      own := SockInfo.own_stream_socket(client_fd);
      cond(
        (own < i32(0)) => {
          e.io.await(IO_unix.close(client_fd), e.io);
          _throw_io(i32(0) - own, e.exn);
        },
        true => ()
      );
      return(UnixStream(_cell : box(_UnixSocketState(_fd : client_fd, _is_closed : false))));
    })
  }),
  /// The filesystem path this listener is bound to.
  local_path : (fn(self : &Self) -> &String)(
    &self._cell._path
  ),
  /// Close the listener socket (the socket FILE stays — unlink it yourself).
  close : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
    io.async({ &self, io }(e : IoExn) => {
      e.io.await(_close_unix(addr_of(self._cell._sock), io), e);
    })
  ),
  /// Get the underlying file descriptor.
  fd : (fn(self : &Self) -> i32)(
    self._cell._sock._fd
  )
);
export(UnixListener);
impl(
  UnixStream,
  /// Connect to a Unix-domain socket at `path`, returning a new stream.
  connect : (fn(path : &Path, io : Io) -> Impl(Future(UnixStream, IoExn)))(
    io.async(e => {
      raw_fd := e.io.await(IO_unix.socket_stream(), e.io);
      fd := NetError.check(raw_fd, e.exn);
      own := SockInfo.own_stream_socket(fd);
      cond(
        (own < i32(0)) => {
          e.io.await(IO_unix.close(fd), e.io);
          _throw_io(i32(0) - own, e.exn);
        },
        true => ()
      );
      path_s := path.to_string();
      cstr_bytes := match(path_s.to_cstr_checked(), .Ok(b) => b, .Err(_) => e.exn.throw(dyn(IoError.InvalidInput)));
      addr := IO_unix.make_sockaddr_un(cstr_bytes.ptr().unwrap());
      addr_buf := match(
        addr.buf,
        .Some(p) => p,
        .None => {
          e.io.await(IO_unix.close(fd), e.io);
          e.exn.throw(dyn(NetError.from_io(IoError.NotSupported)));
          (*u8)("")
        }
      );
      conn_result := e.io.await(IO_unix.connect(fd, addr_buf, addr.len), e.io);
      IO_unix.free_addr(addr);
      cond(
        (conn_result < i32(0)) => {
          e.io.await(IO_unix.close(fd), e.io);
          _throw_io(i32(0) - conn_result, e.exn);
        },
        true => ()
      );
      return(UnixStream(_cell : box(_UnixSocketState(_fd : fd, _is_closed : false))));
    })
  ),
  /// Read up to `size` bytes into `buf`, resolving to the number actually
  /// read. `0` — and only `0` — means the peer closed; a SHORT count is
  /// ordinary on a stream socket and is not end-of-stream, so a caller that
  /// needs `size` bytes loops. Awaiting parks this task on the event loop
  /// until the kernel has bytes; a failure throws `IoExn`. The raw pointer
  /// needs `pragma(Pragma.AllowUnsafe)` — safe code uses the `Reader`
  /// defaults (`read_to_end`, `read_to_string`) or `BufReader(UnixStream)`.
  read : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))({
    fd := self._cell._fd;
    io.async(e => {
      r := e.io.await(IO_unix.recv(fd, buf, size, i32(0)), e.io);
      usize(NetError.check(r, e.exn))
    })
  }),
  /// Write up to `size` raw bytes from `buf`, resolving to the number the
  /// kernel accepted — which may be LESS than `size`, so a caller that must
  /// deliver everything loops or takes the `Writer` trait's `write_all`.
  /// Needs `pragma(Pragma.AllowUnsafe)`; `write_bytes` / `write_str` /
  /// `write_string` are the safe spellings.
  write : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))({
    fd := self._cell._fd;
    io.async(e => {
      r := e.io.await(IO_unix.stream_write(fd, buf, size), e.io);
      usize(NetError.check(r, e.exn))
    })
  }),
  /// Write a `str` to the stream. Returns the number of bytes written.
  write_str : (fn(self : &Self, data : str, io : Io) -> Impl(Future(usize, IoExn)))({
    fd := self._cell._fd;
    s := String.from(data);
    io.async(e => {
      r := e.io.await(IO_unix.stream_write(fd, s.ptr().unwrap(), s.len()), e.io);
      usize(NetError.check(r, e.exn))
    })
  }),
  /// Write a `String` to the stream. Returns the number of bytes written.
  write_string : (fn(self : &Self, data : &String, io : Io) -> Impl(Future(usize, IoExn)))({
    fd := self._cell._fd;
    io.async(e => {
      r := e.io.await(IO_unix.stream_write(fd, data.ptr().unwrap(), data.len()), e.io);
      usize(NetError.check(r, e.exn))
    })
  }),
  /// Write raw bytes from an `ArrayList(u8)`. Returns the count written.
  write_bytes : (fn(self : &Self, data : &ArrayList(u8), io : Io) -> Impl(Future(usize, IoExn)))({
    fd := self._cell._fd;
    io.async(e => {
      r := e.io.await(IO_unix.stream_write(fd, data.ptr().unwrap(), data.len()), e.io);
      usize(NetError.check(r, e.exn))
    })
  }),
  /// Close the stream.
  close : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
    io.async({ &self, io }(e : IoExn) => {
      e.io.await(_close_unix(addr_of(self._cell.*), io), e);
    })
  ),
  /// Get the underlying file descriptor.
  fd : (fn(self : &Self) -> i32)(
    self._cell._fd
  )
);
export(UnixStream);
// === std/io async trait impls (STD_API_AUDIT D5) ===
impl(
  UnixStream,
  IoTraits.Reader(
    read : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
      self.read(buf, size, io)
    )
  )
);
impl(
  UnixStream,
  IoTraits.Writer(
    write : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
      self.write(buf, size, io)
    ),
    flush : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
      io.async(e => ())
    )
  )
);
