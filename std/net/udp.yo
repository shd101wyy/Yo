//! Async UDP networking — a typed `UdpSocket` over `std/sys/udp` for
//! connectionless datagrams.
//!
//! Every call is an `io.async` future on the single event-loop thread, and
//! kernel failures throw `IoExn` carrying a `NetError` (D1) instead of
//! resolving to a negative count. Datagram semantics are the kernel's and
//! not softened here: a receive returns ONE datagram (never a partial one and
//! never two), a datagram longer than the buffer is TRUNCATED with the excess
//! discarded, and nothing is retried or ordered.
//!
//! `send_to` addresses each datagram; `send` uses the peer set by `connect`,
//! which for a datagram socket only fixes the default destination and the
//! addresses the kernel will accept from — it does not establish anything.
//!
//! ```rust
//! { UdpSocket } :: import("std/net/udp");
//! { SocketAddr } :: import("std/net/addr");
//! { IoExn } :: import("std/error");
//!
//! e := IoExn(io : io, exn : exn);
//! sock := io.await(UdpSocket.bind(SocketAddr.loopback(u16(0)), io), e);
//! got := io.await(sock.recv_from_bytes(usize(1500), io), e);
//! io.await(sock.close(io), e);
//! ```
//!
//! ## Stability
//!
//! unstable — the receive surface was rebuilt on 2026-09-09 (`recv_from` now
//! resolves to `(usize, SocketAddr)` instead of taking two C out-params, and
//! `recv_bytes` / `recv_from_bytes` gave safe code a way to read a datagram
//! at all), so it is inside its one-release window. The open question is
//! whether the raw pointer pair (`recv`, `recv_from`) stays exported beside
//! the pointer-free pair: two spellings per operation is what D2 argues
//! against, and only the raw one needs `pragma(Pragma.AllowUnsafe)`.
//! Multicast joins and `set_ttl` are missing but additive, so they do not
//! block freezing; the raw/safe split does.
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator } :: import("../allocator");
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import("../collections/array_list");
import("../string");
import("../fmt");
{ NetError } :: import("./errors");
{ IoError } :: import("../sys/errors");
{ IpAddr, SocketAddr } :: import("./addr");
{ Error, AnyError, Exception, IoExn } :: import("../error");
IO_udp :: import("../sys/udp");
IO_tcp :: import("../sys/tcp");
SockInfo :: import("../sys/sockinfo");
{ make_sockaddr, sockaddr_to_socket_addr } :: import("./tcp");
{ AF_INET, AF_INET6, SOCK_DGRAM, SOL_SOCKET, SO_BROADCAST } :: import("../sys/socket");
{ snprintf } :: import("../libc/stdio");
// ============================================================================
// Internal helpers
// ============================================================================
// `make_sockaddr` and `sockaddr_to_socket_addr` both live in `./tcp` — ONE
// encoder and ONE decoder for the whole `net` layer. This file used to carry a
// byte-for-byte copy of the encoder, which is how the hardcoded-"::1" bug
// (plans/archive/STD_API_AUDIT.md C2) had to be fixed twice.
_throw_net_io :: (fn(errno_val : i32, exn : Exception) -> unit)(
  exn.throw(dyn(NetError.from_io(IoError.from_errno(errno_val))))
);
// ============================================================================
// UdpSocket
// ============================================================================
/// A UDP socket for sending and receiving datagrams.
UdpSocket :: ref(
  struct(
    _fd : i32,
    _local_addr : SocketAddr,
    _is_closed : bool
  )
);
impl(
  UdpSocket,
  /// Create and bind a UDP socket to the given address.
  bind : (fn(addr : SocketAddr, io : Io) -> Impl(Future(UdpSocket, IoExn)))(
    io.async(e => {
      domain := cond(
        addr.ip.is_v4() => AF_INET,
        true => AF_INET6
      );
      raw_fd := e.io.await(IO_udp.socket(domain, i32(0)), e.io);
      fd := NetError.check(raw_fd, e.exn);
      saddr := make_sockaddr(addr);
      bind_r := e.io.await(IO_udp.bind(fd, saddr.buf, saddr.len), e.io);
      IO_tcp.free_sockaddr(saddr);
      cond(
        (bind_r < i32(0)) => {
          e.io.await(IO_udp.close(fd), e.io);
          _throw_net_io(i32(0) - bind_r, e.exn);
        },
        true => ()
      );
      // Read back the ACTUAL bound address — a port-0 bind gets its port from
      // the kernel; echoing the bind argument reported port 0 forever. Same
      // fix as TcpListener.bind (C2), which UDP never received
      // (issues/fixed/udpsocket-bind-echoes-its-argument-and-send-has-no-connect.md).
      la_buf := (*u8)(malloc(usize(128)).unwrap());
      la_len := (*u32)(malloc(usize(4)).unwrap());
      la_len.* = u32(128);
      gsn := SockInfo.getsockname(fd, la_buf, la_len);
      local := cond(
        (gsn == i32(0)) => sockaddr_to_socket_addr(la_buf),
        true => addr
      );
      free(.Some((*void)(la_buf)));
      free(.Some((*void)(la_len)));
      return(UdpSocket(_fd : fd, _local_addr : local, _is_closed : false));
    })
  ),
  /// Set the default destination for `send` and filter `recv` to datagrams
  /// from `addr` — `connect(2)` on a UDP socket. Rust: `UdpSocket::connect`.
  /// `send`/`recv` documented "requires prior connect" for as long as they
  /// existed while no `connect` did, so they could only fail with ENOTCONN.
  connect : (fn(self : Self, addr : SocketAddr, io : Io) -> Impl(Future(unit, IoExn)))({
    fd := self._fd;
    io.async(e => {
      saddr := make_sockaddr(addr);
      r := e.io.await(IO_tcp.connect(fd, saddr.buf, saddr.len), e.io);
      IO_tcp.free_sockaddr(saddr);
      cond(
        (r < i32(0)) => {
          _throw_net_io(i32(0) - r, e.exn);
        },
        true => ()
      );
      return(());
    })
  }),
  /// Send a datagram to a specific address.
  /// Returns the number of bytes sent.
  send_to : (fn(self : Self, data : ArrayList(u8), addr : SocketAddr, io : Io) -> Impl(Future(usize, IoExn)))({
    fd := self._fd;
    io.async(e => {
      saddr := make_sockaddr(addr);
      r := e.io.await(IO_udp.sendto(fd, data.ptr().unwrap(), data.len(), i32(0), saddr.buf, saddr.len), e.io);
      IO_tcp.free_sockaddr(saddr);
      usize(NetError.check(r, e.exn))
    })
  }),
  /// Receive a datagram into the provided buffer.
  /// Returns the number of bytes received.
  recv : (fn(self : Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))({
    fd := self._fd;
    io.async(e => {
      r := e.io.await(IO_udp.recv(fd, buf, size, i32(0)), e.io);
      usize(NetError.check(r, e.exn))
    })
  }),
  /// Receive a datagram into `buf`, resolving to the byte count AND the
  /// sender's address — Rust's `UdpSocket::recv_from`.
  ///
  /// The sockaddr buffer is allocated and decoded here. It used to be two RAW
  /// OUT-PARAMS (`src_addr : *u8, src_addr_len : *u32`) that every caller had
  /// to `malloc`, pre-set to 128, pass in, decode and free — a C signature in
  /// a Yo API, and the address was handed back undecoded.
  recv_from : (fn(self : Self, buf : *u8, size : usize, io : Io) -> Impl(Future(Tuple(usize, SocketAddr), IoExn)))({
    fd := self._fd;
    io.async(e => {
      // `sockaddr_storage` is 128 bytes on both POSIX platforms this targets,
      // which is what `accept` and the `bind` read-back also use.
      sa_buf := (*u8)(malloc(usize(128)).unwrap());
      sa_len := (*u32)(malloc(usize(4)).unwrap());
      sa_len.* = u32(128);
      r := e.io.await(IO_udp.recvfrom(fd, buf, size, i32(0), sa_buf, sa_len), e.io);
      // Decode BEFORE the throw check would abandon the buffers: on an error
      // there is nothing to decode, so free and let `check` throw.
      cond(
        (r < i32(0)) => {
          free(.Some((*void)(sa_buf)));
          free(.Some((*void)(sa_len)));
          NetError.check(r, e.exn);
        },
        true => ()
      );
      from := sockaddr_to_socket_addr(sa_buf);
      free(.Some((*void)(sa_buf)));
      free(.Some((*void)(sa_len)));
      (usize(r), from)
    })
  }),
  /// Receive a datagram as bytes, resolving to at most `max` of them.
  ///
  /// The pointer-free counterpart of `recv`. `send_to`/`send` already take an
  /// `ArrayList(u8)`, but every receive took a `*(u8)` — and raw pointers are
  /// not available in safe code, so a program without
  /// `pragma(Pragma.AllowUnsafe)` could SEND a datagram and not receive one.
  ///
  /// A datagram longer than `max` is TRUNCATED, and the excess is discarded by
  /// the kernel — that is `recvfrom`'s behaviour, not a choice made here, so
  /// size `max` for the largest message the protocol allows.
  recv_bytes : (fn(self : Self, max : usize, io : Io) -> Impl(Future(ArrayList(u8), IoExn)))({
    fd := self._fd;
    io.async(e => {
      out := ArrayList(u8).with_capacity(max);
      (i : usize) = usize(0);
      while(i < max, i = (i + usize(1)), {
        out.push(u8(0));
      });
      p := match(out.ptr(), .Some(q) => q, .None => (*u8)(""));
      r := e.io.await(IO_udp.recv(fd, p, max, i32(0)), e.io);
      n := usize(NetError.check(r, e.exn));
      out.truncate(n);
      out
    })
  }),
  /// Receive a datagram as bytes together with the sender's address — the
  /// pointer-free counterpart of `recv_from`. Truncates at `max`, as
  /// `recv_bytes` does.
  recv_from_bytes : (fn(self : Self, max : usize, io : Io) -> Impl(Future(Tuple(ArrayList(u8), SocketAddr), IoExn)))(
    io.async(e => {
      out := ArrayList(u8).with_capacity(max);
      (i : usize) = usize(0);
      while(i < max, i = (i + usize(1)), {
        out.push(u8(0));
      });
      p := match(out.ptr(), .Some(q) => q, .None => (*u8)(""));
      got := e.io.await(self.recv_from(p, max, io), e);
      out.truncate(got.0);
      (out, got.1)
    })
  ),
  /// Send data to the peer set by `connect`. Returns the number of bytes sent.
  send : (fn(self : Self, data : ArrayList(u8), io : Io) -> Impl(Future(usize, IoExn)))({
    fd := self._fd;
    io.async(e => {
      r := e.io.await(IO_udp.send(fd, data.ptr().unwrap(), data.len(), i32(0)), e.io);
      usize(NetError.check(r, e.exn))
    })
  }),
  /// Close the socket.
  close : (fn(self : Self, io : Io) -> Impl(Future(unit, IoExn)))({
    fd := self._fd;
    io.async(e => {
      cond(
        self._is_closed => (),
        true => {
          r := e.io.await(IO_udp.close(fd), e.io);
          self._is_closed = true;
          cond(
            (r < i32(0)) => {
              _throw_net_io(i32(0) - r, e.exn);
            },
            true => ()
          );
        }
      );
    })
  }),
  /// Enable or disable SO_BROADCAST on the socket.
  set_broadcast : (fn(self : Self, enabled : bool, io : Io) -> Impl(Future(unit, IoExn)))({
    fd := self._fd;
    io.async(e => {
      val := cond(enabled => i32(1), true => i32(0));
      val_ptr := &val;
      r := e.io.await(IO_udp.setsockopt(fd, SOL_SOCKET, SO_BROADCAST, (*u8)(val_ptr), u32(4)), e.io);
      cond(
        (r < i32(0)) => {
          _throw_net_io(i32(0) - r, e.exn);
        },
        true => ()
      );
    })
  }),
  /// Get the local address this socket is bound to.
  local_addr : (fn(self : Self) -> SocketAddr)(
    self._local_addr
  ),
  /// Get the underlying file descriptor.
  fd : (fn(self : Self) -> i32)(
    self._fd
  )
);
impl(
  UdpSocket,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      cond(
        !self._is_closed => {
          { close_sync } :: import("../sys/file");
          close_sync(self._fd);
          self._is_closed = true;
        },
        true => ()
      );
    })
  )
);
export(UdpSocket);
