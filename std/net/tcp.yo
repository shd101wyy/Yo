// std/net/tcp.yo - High-level TCP client and server
//
// Provides TcpListener and TcpStream built on std/io/tcp.
//
// Example:
//   { TcpListener, TcpStream } :: import "std/net/tcp";
//   { IpAddr, SocketAddr } :: import "std/net/addr";
//
//   listener := TcpListener.bind(SocketAddr.new(IpAddr.loopback_v4(), u16(8080))).unwrap();
//   stream := listener.accept().unwrap();

open import "../string";
{ ArrayList } :: import "../collections/array_list";
{ GlobalAllocator } :: import "../allocator";
{ malloc, free } :: GlobalAllocator;
{ IOError } :: import "../io/errors";
{
  AF_INET, AF_INET6, SOCK_STREAM,
  SOL_SOCKET, IPPROTO_TCP,
  SO_REUSEADDR, SO_KEEPALIVE,
  TCP_NODELAY,
  sockaddr_in_size, sockaddr_in6_size
} :: import "../io/socket";
{
  socket, bind, listen, accept, connect, recv, send, shutdown, close,
  setsockopt_int,
  make_sockaddr_in, make_sockaddr_in6, make_sockaddr_in_loopback, free_sockaddr,
  SockAddr
} :: import "../io/tcp";
{ IOFuture } :: import "../io/future";
{ IpAddr, SocketAddr } :: import "./addr";
{ NetError } :: import "./errors";

// ============================================================================
// Internal helpers
// ============================================================================

_sockaddr_to_buffer :: (fn(addr: SocketAddr) -> SockAddr)({
  match(addr.ip,
    .V4(a, b, c, d) => {
      ip_buf := Array(u8, usize(20)).fill(u8(0));
      ip_ptr := &(ip_buf(usize(0)));
      { snprintf } :: import "../libc/stdio";
      snprintf(*(char)(ip_ptr), usize(20), "%u.%u.%u.%u",
        i32(a), i32(b), i32(c), i32(d));
      make_sockaddr_in(ip_ptr, addr.port)
    },
    .V6(segs) => {
      ip_buf := Array(u8, usize(40)).fill(u8(0));
      ip_ptr := &(ip_buf(usize(0)));
      { snprintf } :: import "../libc/stdio";
      snprintf(*(char)(ip_ptr), usize(40),
        "%x:%x:%x:%x:%x:%x:%x:%x",
        i32(segs(usize(0))), i32(segs(usize(1))),
        i32(segs(usize(2))), i32(segs(usize(3))),
        i32(segs(usize(4))), i32(segs(usize(5))),
        i32(segs(usize(6))), i32(segs(usize(7))));
      make_sockaddr_in6(ip_ptr, addr.port)
    }
  )
});

_result_to_net :: (fn(r: i32) -> Result(i32, NetError))(
  cond(
    (r < i32(0)) => .Err(NetError.from_io(IOError.from_errno((i32(0) - r)))),
    true => .Ok(r)
  )
);

// ============================================================================
// TcpListener
// ============================================================================

TcpListener :: object(
  fd         : i32,
  local_addr : SocketAddr
);

impl(TcpListener,
  // Bind a TCP socket to the given address and start listening.
  bind : (fn(addr: SocketAddr, using(io : IO)) -> Result(Self, NetError))({
    domain := match(addr.ip,
      .V4(_, _, _, _) => AF_INET,
      .V6(_)          => AF_INET6
    );
    fd_r := io.await(socket(domain, SOCK_STREAM, i32(0)));
    match(_result_to_net(fd_r),
      .Err(e) => .Err(e),
      .Ok(fd) => {
        // SO_REUSEADDR
        setsockopt_int(fd, SOL_SOCKET, SO_REUSEADDR, i32(1));
        sa := _sockaddr_to_buffer(addr);
        bind_r := io.await(bind(fd, sa.buf, sa.len));
        free_sockaddr(sa);
        match(_result_to_net(bind_r),
          .Err(e) => .Err(e),
          .Ok(_) => {
            listen_r := io.await(listen(fd, i32(128)));
            match(_result_to_net(listen_r),
              .Err(e) => .Err(e),
              .Ok(_)  => .Ok(TcpListener(fd: fd, local_addr: addr))
            )
          }
        )
      }
    )
  }),

  // Accept an incoming connection.
  accept : (fn(self: Self, using(io : IO)) -> Result(TcpStream, NetError))({
    r := io.await(accept(self.fd));
    match(_result_to_net(r),
      .Err(e)       => .Err(e),
      .Ok(client_fd) => .Ok(TcpStream(
        fd:         client_fd,
        local_addr: self.local_addr,
        peer_addr:  SocketAddr.new(IpAddr.any_v4(), u16(0)),
        _read_buf:  ArrayList(u8).new(),
        _write_buf: ArrayList(u8).new()
      ))
    )
  }),

  // Return the local address.
  local_addr : (fn(self: Self) -> SocketAddr)(
    self.local_addr
  ),

  // Close the listening socket.
  close : (fn(self: Self, using(io : IO)) -> Result(unit, NetError))({
    r := io.await(close(self.fd));
    match(_result_to_net(r),
      .Err(e) => .Err(e),
      .Ok(_)  => .Ok(())
    )
  })
);

export TcpListener;

// ============================================================================
// TcpStream
// ============================================================================

_READ_BUF_SIZE :: usize(65536);

TcpStream :: object(
  fd         : i32,
  local_addr : SocketAddr,
  peer_addr  : SocketAddr,
  _read_buf  : ArrayList(u8),
  _write_buf : ArrayList(u8)
);

impl(TcpStream,
  // Connect to a remote address.
  connect : (fn(addr: SocketAddr, using(io : IO)) -> Result(Self, NetError))({
    domain := match(addr.ip,
      .V4(_, _, _, _) => AF_INET,
      .V6(_)          => AF_INET6
    );
    fd_r := io.await(socket(domain, SOCK_STREAM, i32(0)));
    match(_result_to_net(fd_r),
      .Err(e) => .Err(e),
      .Ok(fd) => {
        sa := _sockaddr_to_buffer(addr);
        conn_r := io.await(connect(fd, sa.buf, sa.len));
        free_sockaddr(sa);
        match(_result_to_net(conn_r),
          .Err(e) => .Err(e),
          .Ok(_)  => .Ok(TcpStream(
            fd:         fd,
            local_addr: SocketAddr.new(IpAddr.any_v4(), u16(0)),
            peer_addr:  addr,
            _read_buf:  ArrayList(u8).new(),
            _write_buf: ArrayList(u8).new()
          ))
        )
      }
    )
  }),

  // Read up to `size` bytes into `buf`.
  read : (fn(self: Self, buf: *(u8), size: usize, using(io : IO)) -> Result(i32, NetError))({
    r := io.await(recv(self.fd, buf, size, i32(0)));
    _result_to_net(r)
  }),

  // Write a String to the stream.
  write : (fn(self: Self, data: String, using(io : IO)) -> Result(i32, NetError))({
    cond(
      (data.len() == usize(0)) => .Ok(i32(0)),
      true => {
        bytes    := data.as_bytes();
        data_ptr := bytes.ptr().unwrap();
        r        := io.await(send(self.fd, data_ptr, bytes.len(), i32(0)));
        _result_to_net(r)
      }
    )
  }),

  // Write raw bytes to the stream.
  write_bytes : (fn(self: Self, data: ArrayList(u8), using(io : IO)) -> Result(i32, NetError))({
    cond(
      (data.len() == usize(0)) => .Ok(i32(0)),
      true => {
        data_ptr := *(u8)(data.ptr().unwrap());
        r        := io.await(send(self.fd, data_ptr, data.len(), i32(0)));
        _result_to_net(r)
      }
    )
  }),

  // Flush (no-op for TCP; writes are immediate).
  flush : (fn(self: Self, using(io : IO)) -> Result(unit, NetError))(
    .Ok(())
  ),

  // Read all available data into an ArrayList(u8).
  read_all : (fn(self: Self, using(io : IO)) -> Result(ArrayList(u8), NetError))({
    buf      := ArrayList(u8).with_capacity(_READ_BUF_SIZE);
    chunk    := ArrayList(u8).with_capacity(_READ_BUF_SIZE);
    chunk.set_len(_READ_BUF_SIZE);
    chunk_ptr := *(u8)(chunk.ptr().unwrap());
    while runtime(true), () => {
      n := io.await(recv(self.fd, chunk_ptr, _READ_BUF_SIZE, i32(0)));
      cond(
        (n < i32(0)) => {
          return .Err(NetError.from_io(IOError.from_errno((i32(0) - n))));
        },
        (n == i32(0)) => break,
        true => {
          i := usize(0);
          while (i < usize(n)), (i = (i + usize(1))), {
            buf.push(chunk.get(i).unwrap());
          };
        }
      );
    };
    .Ok(buf)
  }),

  // Shut down the write side.
  shutdown : (fn(self: Self, using(io : IO)) -> Result(unit, NetError))({
    r := io.await(shutdown(self.fd, i32(1))); // SHUT_WR = 1
    match(_result_to_net(r),
      .Err(e) => .Err(e),
      .Ok(_)  => .Ok(())
    )
  }),

  // Close the connection.
  close : (fn(self: Self, using(io : IO)) -> Result(unit, NetError))({
    r := io.await(close(self.fd));
    match(_result_to_net(r),
      .Err(e) => .Err(e),
      .Ok(_)  => .Ok(())
    )
  }),

  // Return the local address.
  local_addr : (fn(self: Self) -> SocketAddr)(
    self.local_addr
  ),

  // Return the remote peer address.
  peer_addr : (fn(self: Self) -> SocketAddr)(
    self.peer_addr
  ),

  // Set TCP_NODELAY (disable Nagle's algorithm).
  set_nodelay : (fn(self: Self, nodelay: bool, using(io : IO)) -> Result(unit, NetError))({
    val := cond(nodelay => i32(1), true => i32(0));
    setsockopt_int(self.fd, IPPROTO_TCP, TCP_NODELAY, val);
    .Ok(())
  }),

  // Set SO_KEEPALIVE.
  set_keepalive : (fn(self: Self, enabled: bool, using(io : IO)) -> Result(unit, NetError))({
    val := cond(enabled => i32(1), true => i32(0));
    setsockopt_int(self.fd, SOL_SOCKET, SO_KEEPALIVE, val);
    .Ok(())
  })
);

export TcpStream;
