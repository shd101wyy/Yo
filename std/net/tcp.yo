//! Async TCP networking — listeners and streams with Exception-based error handling.
// std/net/tcp.yo - High-level TCP types
//
// Wraps std/sys/tcp with typed TcpListener and TcpStream objects.
// Uses the Exception effect for error handling.
//
// Example:
//   { TcpListener, TcpStream } :: import "std/net/tcp";
//   { SocketAddr, IpAddr } :: import "std/net/addr";
//   { Exception } :: import "std/error";
//
//   main :: (fn(io : IO) -> unit)({
//     exn := Exception(throw : ((err) -> {
//       println(err.message());
//       unwind ();
//     }));
//     addr := SocketAddr.new(IpAddr.any_v4(), u16(8080));
//     listener := io.await(TcpListener.bind(addr));
//     stream := io.await(listener.accept());
//     // ...
//   });
{ GlobalAllocator } :: import("../allocator");
{ malloc, free } :: GlobalAllocator;
{ ArrayList } :: import("../collections/array_list");
open(import("../string"));
open(import("../fmt"));
{ NetError } :: import("./errors");
{ IOError } :: import("../sys/errors");
{ IpAddr, SocketAddr } :: import("./addr");
{ Error, AnyError, Exception } :: import("../error");
IO_tcp :: import("../sys/tcp");
{ AF_INET, AF_INET6, SOCK_STREAM, SOL_SOCKET, SO_REUSEADDR, IPPROTO_TCP, TCP_NODELAY, SO_KEEPALIVE } :: import("../sys/socket");
// ============================================================================
// Internal helpers
// ============================================================================
// Convert a SocketAddr to a low-level SockAddr buffer.
_make_sockaddr :: (fn(addr : SocketAddr) -> IO_tcp.SockAddr)(
  match(
    addr.ip,
    .V4(a, b, c, d) => {
      // Build the IP string "a.b.c.d"
      { snprintf } :: import("../libc/stdio");
      buf := Array(u8, usize(16)).fill(u8(0));
      snprintf(*(char)(&(buf(usize(0)))), usize(16), "%d.%d.%d.%d", i32(a), i32(b), i32(c), i32(d));
      IO_tcp.make_sockaddr_in(&(buf(usize(0))), addr.port)
    },
    .V6(_) =>
      // For V6, create loopback for now
      IO_tcp.make_sockaddr_in6(*(u8)("::1"), addr.port)
  )
);
_throw_io :: (fn(errno_val : i32, exn : Exception) -> unit)(
  exn.throw(dyn(NetError.from_io(IOError.from_errno(errno_val))))
);
// ============================================================================
// TcpStream (declared before TcpListener so accept can reference it)
// ============================================================================
/// A connected TCP stream for bidirectional data transfer.
TcpStream :: object(
  _fd : i32,
  _peer_addr : SocketAddr,
  _is_closed : bool
);
// ============================================================================
// TcpListener
// ============================================================================
/// A TCP socket that listens for incoming connections.
TcpListener :: object(
  _fd : i32,
  _local_addr : SocketAddr,
  _is_closed : bool
);
impl(
  TcpListener,
  /// Bind to a socket address and start listening.
  bind : (fn(addr : SocketAddr, io : IO) -> Impl(Future(TcpListener, IO, Exception)))(
    io.async((using(io : IO, exn : Exception)) => {
      domain := cond(
        addr.ip.is_v4() => AF_INET,
        true => AF_INET6
      );
      // Create socket
      raw_fd := io.await(IO_tcp.socket(domain, SOCK_STREAM, i32(0)));
      fd := NetError.check(raw_fd);
      // Set SO_REUSEADDR
      reuse_val := i32(1);
      reuse_ptr := &(reuse_val);
      io.await(IO_tcp.setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, *(u8)(reuse_ptr), u32(4)));
      // Bind
      saddr := _make_sockaddr(addr);
      bind_result := io.await(IO_tcp.bind(fd, saddr.buf, saddr.len));
      IO_tcp.free_sockaddr(saddr);
      cond(
        (bind_result < i32(0)) => {
          io.await(IO_tcp.close(fd));
          _throw_io(i32(0) - bind_result);
        },
        true => ()
      );
      // Listen
      listen_result := io.await(IO_tcp.listen(fd, i32(128)));
      cond(
        (listen_result < i32(0)) => {
          io.await(IO_tcp.close(fd));
          _throw_io(i32(0) - listen_result);
        },
        true => ()
      );
      return(TcpListener(_fd : fd, _local_addr : addr, _is_closed : false));
    })
  ),
  /// Accept an incoming connection, returning a new `TcpStream`.
  accept : (fn(self : Self, io : IO) -> Impl(Future(TcpStream, IO, Exception)))({
    fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      // Allocate space for the peer address
      addr_buf := *(u8)(malloc(usize(128)).unwrap());
      addr_len := *(u32)(malloc(usize(4)).unwrap());
      addr_len.* = u32(128);
      client_fd := io.await(IO_tcp.accept(fd, addr_buf, addr_len));
      cond(
        (client_fd < i32(0)) => {
          free(.Some(*(void)(addr_buf)));
          free(.Some(*(void)(addr_len)));
          _throw_io(i32(0) - client_fd);
        },
        true => ()
      );
      // Extract peer address info
      peer_port := IO_tcp.get_port_in(addr_buf);
      free(.Some(*(void)(addr_buf)));
      free(.Some(*(void)(addr_len)));
      peer_addr := SocketAddr.new(IpAddr.any_v4(), peer_port);
      return(
        TcpStream(
          _fd : client_fd,
          _peer_addr : peer_addr,
          _is_closed : false
        )
      );
    })
  }),
  /// Get the local address this listener is bound to.
  local_addr : (fn(self : Self) -> SocketAddr)(
    self._local_addr
  ),
  /// Close the listener socket.
  close : (fn(self : Self, io : IO) -> Impl(Future(unit, IO, Exception)))({
    fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      cond(
        self._is_closed => (),
        true => {
          r := io.await(IO_tcp.close(fd));
          self._is_closed = true;
          cond(
            (r < i32(0)) => {
              _throw_io(i32(0) - r);
            },
            true => ()
          );
        }
      );
    })
  }),
  /// Get the underlying file descriptor.
  fd : (fn(self : Self) -> i32)(
    self._fd
  )
);
impl(
  TcpListener,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      cond(
        (!(self._is_closed)) => {
          { close_sync } :: import("../sys/file");
          close_sync(self._fd);
          self._is_closed = true;
        },
        true => ()
      );
    })
  )
);
export(TcpListener);
// ============================================================================
// TcpStream impl
// ============================================================================
impl(
  TcpStream,
  /// Connect to a remote address, returning a new `TcpStream`.
  connect : (fn(addr : SocketAddr, io : IO) -> Impl(Future(TcpStream, IO, Exception)))(
    io.async((using(io : IO, exn : Exception)) => {
      domain := cond(
        addr.ip.is_v4() => AF_INET,
        true => AF_INET6
      );
      raw_fd := io.await(IO_tcp.socket(domain, SOCK_STREAM, i32(0)));
      fd := NetError.check(raw_fd);
      saddr := _make_sockaddr(addr);
      conn_result := io.await(IO_tcp.connect(fd, saddr.buf, saddr.len));
      IO_tcp.free_sockaddr(saddr);
      cond(
        (conn_result < i32(0)) => {
          io.await(IO_tcp.close(fd));
          _throw_io(i32(0) - conn_result);
        },
        true => ()
      );
      return(
        TcpStream(
          _fd : fd,
          _peer_addr : addr,
          _is_closed : false
        )
      );
    })
  ),
  /// Read bytes from the stream into `buf`.
  /// Returns the number of bytes read, or 0 if the peer closed the connection.
  read : (fn(self : Self, buf : *(u8), size : usize, io : IO) -> Impl(Future(i32, IO, Exception)))({
    fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      r := io.await(IO_tcp.recv(fd, buf, size, i32(0)));
      NetError.check(r)
    })
  }),
  /// Write a `str` to the stream.
  /// Returns the number of bytes written.
  write_str : (fn(self : Self, data : str, io : IO) -> Impl(Future(i32, IO, Exception)))({
    fd := self._fd;
    s := String.from(data);
    s_bytes := s.as_bytes();
    io.async((using(io : IO, exn : Exception)) => {
      r := io.await(IO_tcp.send(fd, s_bytes.ptr().unwrap(), s_bytes.len(), i32(0)));
      NetError.check(r)
    })
  }),
  /// Write a `String` to the stream.
  /// Returns the number of bytes written.
  write_string : (fn(self : Self, data : String, io : IO) -> Impl(Future(i32, IO, Exception)))({
    fd := self._fd;
    data_bytes := data.as_bytes();
    io.async((using(io : IO, exn : Exception)) => {
      r := io.await(IO_tcp.send(fd, data_bytes.ptr().unwrap(), data_bytes.len(), i32(0)));
      NetError.check(r)
    })
  }),
  /// Write raw bytes from an `ArrayList(u8)` to the stream.
  /// Returns the number of bytes written.
  write_bytes : (fn(self : Self, data : ArrayList(u8), io : IO) -> Impl(Future(i32, IO, Exception)))({
    fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      r := io.await(IO_tcp.send(fd, data.ptr().unwrap(), data.len(), i32(0)));
      NetError.check(r)
    })
  }),
  /// Read all available data from the stream into a byte list.
  read_bytes : (fn(self : Self, io : IO) -> Impl(Future(ArrayList(u8), IO, Exception)))({
    fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      buf_size := usize(4096);
      buf := *(u8)(malloc(buf_size).unwrap());
      acc := ArrayList(u8).new();
      done := false;
      while(runtime(!(done)), {
        n := io.await(IO_tcp.recv(fd, buf, buf_size, i32(0)));
        cond(
          (n < i32(0)) => {
            free(.Some(*(void)(buf)));
            done = true;
            _throw_io(i32(0) - n);
          },
          (n == i32(0)) => {
            done = true;
          },
          true => {
            i := usize(0);
            while(runtime(i < usize(n)), {
              acc.push((buf &+ i).*);
              i = (i + usize(1));
            });
          }
        );
      });
      free(.Some(*(void)(buf)));
      return(acc);
    })
  }),
  /// Shut down part or all of the connection.
  /// `how`: 0 = read, 1 = write, 2 = both.
  shutdown : (fn(self : Self, how : i32, io : IO) -> Impl(Future(unit, IO, Exception)))({
    fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      r := io.await(IO_tcp.shutdown(fd, how));
      cond(
        (r < i32(0)) => {
          _throw_io(i32(0) - r);
        },
        true => ()
      );
    })
  }),
  /// Close the stream.
  close : (fn(self : Self, io : IO) -> Impl(Future(unit, IO, Exception)))({
    fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      cond(
        self._is_closed => (),
        true => {
          r := io.await(IO_tcp.close(fd));
          self._is_closed = true;
          cond(
            (r < i32(0)) => {
              _throw_io(i32(0) - r);
            },
            true => ()
          );
        }
      );
    })
  }),
  /// Get the remote peer's socket address.
  peer_addr : (fn(self : Self) -> SocketAddr)(
    self._peer_addr
  ),
  /// Get the underlying file descriptor.
  fd : (fn(self : Self) -> i32)(
    self._fd
  ),
  /// Enable or disable TCP_NODELAY (disables Nagle's algorithm).
  set_nodelay : (fn(self : Self, nodelay : bool, io : IO) -> Impl(Future(unit, IO, Exception)))({
    sock_fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      val := cond(nodelay => i32(1), true => i32(0));
      val_ptr := &(val);
      r := io.await(IO_tcp.setsockopt(sock_fd, IPPROTO_TCP, TCP_NODELAY, *(u8)(val_ptr), u32(4)));
      cond(
        (r < i32(0)) => {
          _throw_io(i32(0) - r);
        },
        true => ()
      );
    })
  }),
  /// Enable or disable SO_KEEPALIVE on the socket.
  set_keepalive : (fn(self : Self, enabled : bool, io : IO) -> Impl(Future(unit, IO, Exception)))({
    sock_fd := self._fd;
    io.async((using(io : IO, exn : Exception)) => {
      val := cond(enabled => i32(1), true => i32(0));
      val_ptr := &(val);
      r := io.await(IO_tcp.setsockopt(sock_fd, SOL_SOCKET, SO_KEEPALIVE, *(u8)(val_ptr), u32(4)));
      cond(
        (r < i32(0)) => {
          _throw_io(i32(0) - r);
        },
        true => ()
      );
    })
  })
);
impl(
  TcpStream,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      cond(
        (!(self._is_closed)) => {
          { close_sync } :: import("../sys/file");
          close_sync(self._fd);
          self._is_closed = true;
        },
        true => ()
      );
    })
  )
);
export(TcpStream);
