//! Shared error type for the `std/encoding` codecs.
//!
//! `hex`, `base64` and `utf16` all report decoding failures with this type.
//!
//! # Example
//!
//! ```rust
//! { EncodingError } :: import "std/encoding/error";
//!
//! exn.throw(dyn(EncodingError.OddLength));
//! ```
open(import("../string"));
{ Error } :: import("../error");
{ ToString } :: import("../fmt");
// ============================================================================
// Error type
// ============================================================================
/// Encoding/decoding error type.
EncodingError :: enum(
  /// Invalid character encountered during decoding.
  InvalidChar(ch : u8),
  /// Input string has odd length (hex requires even length).
  OddLength
);
impl(
  EncodingError,
  ToString(
    to_string : (
      self ->
        match(
          self,
          .InvalidChar(ch) => `encoding error: invalid character ${ch}`,
          .OddLength => `encoding error: odd length`
        )
    )
  )
);
impl(EncodingError, Error());
export(EncodingError);
