//! JSON parsing and serialization.
//!
//! Provides a dynamically-typed JSON value tree.
//!
//! # Example
//!
//! ```rust
//! { json_parse, json_stringify, JsonValue } :: import "std/encoding/json";
//! { Exception } :: import "std/error";
//!
//! exn := Exception(throw : ((err) -> { unwind (); }));
//! v := json_parse(`{"x": 1}`);
//! println(json_stringify(v));
//! ```
pragma(Pragma.AllowUnsafe);
open(import("../string"));
{ ArrayList } :: import("../collections/array_list");
{ assert } :: import("../assert");
{ snprintf } :: import("../libc/stdio");
{ Error, AnyError, Exception } :: import("../error");
{ ToString } :: import("../fmt");
// ============================================================================
// JsonError
// ============================================================================
/// JSON parsing error type.
JsonError :: enum(
  /// Encountered an unexpected character at the given position.
  UnexpectedChar(ch : u8, pos : usize),
  /// Input ended unexpectedly.
  UnexpectedEnd,
  /// Failed to parse a numeric literal.
  InvalidNumber,
  /// Invalid escape sequence in a string.
  InvalidEscape,
  /// Invalid Unicode unwind in a string.
  InvalidUnicode,
  /// Other error with a descriptive message.
  Other(msg : String)
);
impl(
  JsonError,
  ToString(
    to_string : (
      self ->
        match(
          self,
          .UnexpectedChar(ch, pos) => `unexpected character at position ${pos}`,
          .UnexpectedEnd => `unexpected end of input`,
          .InvalidNumber => `invalid number`,
          .InvalidEscape => `invalid escape sequence`,
          .InvalidUnicode => `invalid unicode`,
          .Other(msg) => `JSON error: ${msg}`
        )
    )
  )
);
impl(JsonError, Error());
export(JsonError);
// ============================================================================
// JsonValue
// ============================================================================
/// Dynamically-typed JSON value tree.
JsonValue :: enum(
  /// JSON null.
  Null,
  /// JSON boolean.
  Bool(value : bool),
  /// JSON number (IEEE 754 double).
  Number(value : f64),
  /// JSON string.
  Str(value : String),
  /// JSON array of values.
  Array(items : ArrayList(Self)),
  /// JSON object with ordered key-value pairs.
  Object(keys : ArrayList(String), values : ArrayList(Self))
);
// ============================================================================
// JsonKV - key/value pair convenience struct for Object
// ============================================================================
/// Key-value pair for JSON object entries.
JsonKV :: struct(
  key : String,
  value : JsonValue
);
impl(
  JsonValue,
  /// Get a field from an Object value by key. Returns `.None` if not an Object or key is missing.
  get : (fn(self : Self, key : String) -> Option(JsonValue))(
    match(
      self,
      .Object(keys, values) => {
        i := usize(0);
        while(i < keys.len(), i = (i + usize(1)), {
          cond(
            (keys(i) == key) => {
              return(.Some(values(i)));
            },
            true => ()
          );
        });
        .None
      },
      _ => .None
    )
  ),
  /// Get an element from an Array value by index.
  at : (fn(self : Self, index : usize) -> Option(JsonValue))(
    match(
      self,
      .Array(items) => items.get(index),
      _ => .None
    )
  ),
  /// Extract the boolean value, or `.None` if not a `Bool`.
  as_bool : (fn(self : Self) -> Option(bool))(
    match(
      self,
      .Bool(b) => .Some(b),
      _ => .None
    )
  ),
  /// Extract the numeric value, or `.None` if not a `Number`.
  as_number : (fn(self : Self) -> Option(f64))(
    match(
      self,
      .Number(n) => .Some(n),
      _ => .None
    )
  ),
  /// Extract the string value, or `.None` if not a `Str`.
  as_string : (fn(self : Self) -> Option(String))(
    match(
      self,
      .Str(s) => .Some(s),
      _ => .None
    )
  ),
  /// Extract the array items, or `.None` if not an `Array`.
  as_array : (fn(self : Self) -> Option(ArrayList(JsonValue)))(
    match(
      self,
      .Array(items) => .Some(items),
      _ => .None
    )
  ),
  /// Extract object entries as `ArrayList(JsonKV)`, or `.None` if not an `Object`.
  as_object : (fn(self : Self) -> Option(ArrayList(JsonKV)))(
    match(
      self,
      .Object(keys, values) => {
        result := ArrayList(JsonKV).new();
        i := usize(0);
        while(i < keys.len(), i = (i + usize(1)), {
          result.push(JsonKV(key : keys(i), value : values(i)));
        });
        .Some(result)
      },
      _ => .None
    )
  )
);
/// Index trait — `v(key)` returns the child JsonValue for `key`, panicking
/// if `v` is not an Object or the key is missing.
impl(
  JsonValue,
  Index(String)(
    Output : JsonValue,
    index : (fn(inout(self) : Self, key : String) -> *(Self.Output))(
      match(
        self,
        .Object(keys, values) => {
          i := usize(0);
          while(i < keys.len(), i = (i + usize(1)), {
            if(keys(i) == key, {
              // SAFETY: `i` is bounded by `keys.len()` and the
              // Object variant invariant says `values.len() ==
              // keys.len()`, so `&(values(i))` (Index trait) yields a
              // valid pointer into the Rc-managed values list.
              return(unsafe(&(values(i))));
            });
          });
          __yo_panic("JsonValue: key not found in Object")
        },
        _ => __yo_panic("JsonValue: index by String requires .Object variant")
      )
    )
  )
);
/// Index trait — `v(i)` returns the i-th JsonValue, panicking if `v` is
/// not an Array or `i` is out of bounds.
impl(
  JsonValue,
  Index(usize)(
    Output : JsonValue,
    index : (fn(inout(self) : Self, idx : usize) -> *(Self.Output))(
      match(
        self,
        .Array(items) => {
          assert(idx < items.len(), "JsonValue: Array index out of bounds");
          // SAFETY: assert above bounds `idx`; `items` is the
          // Rc-managed Array list whose storage outlives this call
          // (inout(self) keeps `self` and therefore `items` alive);
          // `&(items(idx))` (Index trait) yields the element pointer.
          return(unsafe(&(items(idx))));
        },
        _ => __yo_panic("JsonValue: index by usize requires .Array variant")
      )
    )
  )
);
export(JsonValue, JsonKV);
// ============================================================================
// Parser state
// ============================================================================
/// UTF-8-encode code point `cp` into `bytes`. Division/modulo instead of
/// shifts (the closed operator set has no `<<`/`>>`).
_push_utf8 :: (fn(bytes : ArrayList(u8), cp : u32) -> unit)({
  cond(
    (cp < u32(0x80)) => {
      bytes.push(u8(cp));
    },
    (cp < u32(0x800)) => {
      bytes.push(u8(u32(0xC0) + (cp / u32(64))));
      bytes.push(u8(u32(0x80) + (cp % u32(64))));
    },
    (cp < u32(0x10000)) => {
      bytes.push(u8(u32(0xE0) + (cp / u32(4096))));
      bytes.push(u8(u32(0x80) + ((cp / u32(64)) % u32(64))));
      bytes.push(u8(u32(0x80) + (cp % u32(64))));
    },
    true => {
      bytes.push(u8(u32(0xF0) + (cp / u32(262144))));
      bytes.push(u8(u32(0x80) + ((cp / u32(4096)) % u32(64))));
      bytes.push(u8(u32(0x80) + ((cp / u32(64)) % u32(64))));
      bytes.push(u8(u32(0x80) + (cp % u32(64))));
    }
  );
});

/// One hex digit's value, or 255 for a non-hex byte.
_hex_digit :: (fn(b : u8) -> u8)(
  cond(
    ((b >= u8(48)) && (b <= u8(57))) => (b - u8(48)),
    ((b >= u8(97)) && (b <= u8(102))) => (b - u8(87)),
    ((b >= u8(65)) && (b <= u8(70))) => (b - u8(55)),
    true => u8(255)
  )
);

_Parser :: ref(
  struct(
    // BYTES, not `str`: `str` is the STATIC string view and a runtime
    // String cannot become one (plans/archive/SLICE_REWORK.md), so a
    // str-typed parser could never parse runtime input — an HTTP body, an
    // LSP frame. Both public entry points funnel into bytes.
    src : ArrayList(u8),
    pos : usize
  )
);
impl(
  _Parser,
  new : (fn(src : ArrayList(u8)) -> Self)(
    Self(src : src, pos : usize(0))
  ),
  peek : (fn(self : Self) -> Option(u8))(
    cond(
      (self.pos < self.src.len()) => .Some(self.src(self.pos)),
      true => .None
    )
  ),
  advance : (fn(self : Self) -> unit)({
    self.pos = (self.pos + usize(1));
  }),
  skip_ws : (fn(self : Self) -> unit)({
    while(runtime(true), {
      match(
        self.peek(),
        .None => break,
        .Some(c) => {
          cond(
            ((((c == u8(32)) || (c == u8(9))) || (c == u8(10))) || (c == u8(13))) => {
              self.advance();
            },
            true => break
          );
        }
      );
    });
  }),
  expect : (fn(self : Self, ch : u8) -> Result(unit, JsonError))({
    self.skip_ws();
    match(
      self.peek(),
      .None => .Err(.UnexpectedEnd),
      .Some(c) =>
        cond(
          (c == ch) => {
            self.advance();
            .Ok(())
          },
          true => .Err(.UnexpectedChar(c, self.pos))
        )
    )
  }),
  /// Four hex digits after `\u`, as a code unit. `.Err(.InvalidUnicode)`
  /// on a short read or a non-hex byte.
  parse_hex4 : (fn(self : Self) -> Result(u32, JsonError))({
    (cp : u32) = u32(0);
    (i : usize) = usize(0);
    while(i < usize(4), {
      match(
        self.peek(),
        .None => {
          return(.Err(.UnexpectedEnd));
        },
        .Some(h) => {
          d := _hex_digit(h);
          if(d == u8(255), {
            return(.Err(.InvalidUnicode));
          });
          self.advance();
          cp = ((cp * u32(16)) + u32(d));
        }
      );
      i = (i + usize(1));
    });
    .Ok(cp)
  }),
  parse_string : (fn(self : Self) -> Result(String, JsonError))({
    self.advance(); // skip opening '"'
    bytes := ArrayList(u8).new();
    while(runtime(true), {
      match(
        self.peek(),
        .None => {
          return(.Err(.UnexpectedEnd));
        },
        .Some(c) => {
          cond(
            (c == u8(34)) => {
              // '"'
              self.advance();
              break;
            },
            (c == u8(92)) => {
              // '\'
              self.advance();
              match(
                self.peek(),
                .None => {
                  return(.Err(.UnexpectedEnd));
                },
                .Some(e) => {
                  self.advance();
                  cond(
                    (e == u8(110)) => {
                      bytes.push(u8(10)); // \n
                    },
                    (e == u8(116)) => {
                      bytes.push(u8(9)); // \t
                    },
                    (e == u8(114)) => {
                      bytes.push(u8(13)); // \r
                    },
                    (e == u8(34)) => {
                      bytes.push(u8(34)); // \"
                    },
                    (e == u8(92)) => {
                      bytes.push(u8(92)); // \\
                    },
                    (e == u8(47)) => {
                      bytes.push(u8(47)); // \/
                    },
                    (e == u8(98)) => {
                      bytes.push(u8(8)); // \b
                    },
                    (e == u8(102)) => {
                      bytes.push(u8(12)); // \f
                    },
                    (e == u8(117)) => {
                      // \uXXXX — with surrogate-pair handling: a high
                      // surrogate must be followed by `\uDC00`-`\uDFFF`,
                      // and a lone low surrogate is invalid (JSON spec /
                      // RFC 8259 §7).
                      (cp : u32) = match(
                        self.parse_hex4(),
                        .Ok(v) => v,
                        .Err(err) => {
                          return(.Err(err));
                        }
                      );
                      if((cp >= u32(0xD800)) && (cp <= u32(0xDBFF)), {
                        bs := match(
                          self.peek(),
                          .Some(x) => x,
                          .None => {
                            return(.Err(.UnexpectedEnd));
                          }
                        );
                        if(bs != u8(92), {
                          return(.Err(.InvalidUnicode));
                        });
                        self.advance();
                        bu := match(
                          self.peek(),
                          .Some(x2) => x2,
                          .None => {
                            return(.Err(.UnexpectedEnd));
                          }
                        );
                        if(bu != u8(117), {
                          return(.Err(.InvalidUnicode));
                        });
                        self.advance();
                        lo := match(
                          self.parse_hex4(),
                          .Ok(v2) => v2,
                          .Err(err2) => {
                            return(.Err(err2));
                          }
                        );
                        if((lo < u32(0xDC00)) || (lo > u32(0xDFFF)), {
                          return(.Err(.InvalidUnicode));
                        });
                        cp = ((u32(0x10000) + ((cp - u32(0xD800)) * u32(1024))) + (lo - u32(0xDC00)));
                      });
                      if((cp >= u32(0xDC00)) && (cp <= u32(0xDFFF)), {
                        return(.Err(.InvalidUnicode));
                      });
                      _push_utf8(bytes, cp);
                    },
                    true => {
                      return(.Err(.InvalidEscape));
                    }
                  );
                }
              );
            },
            true => {
              bytes.push(c);
              self.advance();
            }
          );
        }
      );
    });
    .Ok(String.from_bytes(bytes))
  }),
  parse_number : (fn(self : Self) -> Result(f64, JsonError))({
    start := self.pos;
    match(
      self.peek(),
      .Some(c) => {
        cond(
          (c == u8(45)) => self.advance(),
          // '-'
          true => ()
        );
      },
      .None => ()
    );
    while(runtime(true), {
      match(
        self.peek(),
        .Some(c) => {
          cond(
            ((c >= u8(48)) && (c <= u8(57))) => self.advance(),
            true => break
          );
        },
        .None => break
      );
    });
    match(
      self.peek(),
      .Some(c) => {
        cond(
          (c == u8(46)) => {
            // '.'
            self.advance();
            while(runtime(true), {
              match(
                self.peek(),
                .Some(d) => {
                  cond(
                    ((d >= u8(48)) && (d <= u8(57))) => self.advance(),
                    true => break
                  );
                },
                .None => break
              );
            });
          },
          true => ()
        );
      },
      .None => ()
    );
    match(
      self.peek(),
      .Some(c) => {
        cond(
          ((c == u8(101)) || (c == u8(69))) => {
            // 'e' or 'E'
            self.advance();
            match(
              self.peek(),
              .Some(s) => {
                cond(
                  ((s == u8(43)) || (s == u8(45))) => self.advance(),
                  true => ()
                );
              },
              .None => ()
            );
            while(runtime(true), {
              match(
                self.peek(),
                .Some(d) => {
                  cond(
                    ((d >= u8(48)) && (d <= u8(57))) => self.advance(),
                    true => break
                  );
                },
                .None => break
              );
            });
          },
          true => ()
        );
      },
      .None => ()
    );
    num_len := (self.pos - start);
    num_buf := ArrayList(u8).with_capacity(num_len + usize(1));
    j := usize(0);
    while(j < num_len, j = (j + usize(1)), {
      num_buf.push(self.src(start + j));
    });
    num_buf.push(u8(0));
    num_ptr := *(char)(num_buf.ptr().unwrap());
    { atof } :: import("../libc/stdlib");
    val := unsafe(atof(num_ptr));
    .Ok(val)
  })
);
// ============================================================================
// Recursive value parser (standalone for self-recursion support)
// ============================================================================
// Tiny helpers to avoid begin blocks in cond branches (works around codegen temp var issue)
_parse_true_lit :: (fn(p : _Parser) -> Result(JsonValue, JsonError))({
  p.advance();
  p.advance();
  p.advance();
  p.advance();
  .Ok(.Bool(true))
});
_parse_false_lit :: (fn(p : _Parser) -> Result(JsonValue, JsonError))({
  p.advance();
  p.advance();
  p.advance();
  p.advance();
  p.advance();
  .Ok(.Bool(false))
});
_parse_null_lit :: (fn(p : _Parser) -> Result(JsonValue, JsonError))({
  p.advance();
  p.advance();
  p.advance();
  p.advance();
  .Ok(.Null)
});
_parse_value :: (fn(p : _Parser) -> Result(JsonValue, JsonError))({
  p.skip_ws();
  match(
    p.peek(),
    .None => .Err(.UnexpectedEnd),
    .Some(c) =>
      cond(
        (c == u8(34)) =>
          match(p.parse_string(), .Err(e) => .Err(e), .Ok(s) => .Ok(.Str(s))),
        (c == u8(123)) => {
          // '{' — parse object
          p.advance();
          keys := ArrayList(String).new();
          vals := ArrayList(JsonValue).new();
          p.skip_ws();
          match(
            p.peek(),
            .Some(c2) => {
              cond(
                (c2 == u8(125)) => {
                  p.advance();
                  return(.Ok(.Object(keys, vals)));
                },
                true => ()
              );
            },
            .None => ()
          );
          while(runtime(true), {
            p.skip_ws();
            match(
              p.peek(),
              .None => {
                return(.Err(.UnexpectedEnd));
              },
              .Some(c2) => {
                cond(
                  (c2 != u8(34)) => {
                    return(.Err(.UnexpectedChar(c2, p.pos)));
                  },
                  true => ()
                );
              }
            );
            key_r := p.parse_string();
            match(
              key_r,
              .Err(e) => {
                return(.Err(e));
              },
              .Ok(key) => {
                p.skip_ws();
                match(
                  p.expect(u8(58)),
                  .Err(e) => {
                    return(.Err(e));
                  },
                  .Ok(_) => ()
                );
                match(
                  recur(p),
                  .Err(e) => {
                    return(.Err(e));
                  },
                  .Ok(val) => {
                    keys.push(key);
                    vals.push(val);
                  }
                );
              }
            );
            p.skip_ws();
            match(
              p.peek(),
              .Some(c2) => {
                cond(
                  (c2 == u8(44)) => {
                    p.advance();
                  },
                  (c2 == u8(125)) => {
                    p.advance();
                    break;
                  },
                  true => {
                    return(.Err(.UnexpectedChar(c2, p.pos)));
                  }
                );
              },
              .None => {
                return(.Err(.UnexpectedEnd));
              }
            );
          });
          .Ok(.Object(keys, vals))
        },
        (c == u8(91)) => {
          // '[' — parse array
          p.advance();
          items := ArrayList(JsonValue).new();
          p.skip_ws();
          match(
            p.peek(),
            .Some(c2) => {
              cond(
                (c2 == u8(93)) => {
                  p.advance();
                  return(.Ok(.Array(items)));
                },
                true => ()
              );
            },
            .None => ()
          );
          while(runtime(true), {
            match(
              recur(p),
              .Err(e) => {
                return(.Err(e));
              },
              .Ok(v) => {
                items.push(v);
              }
            );
            p.skip_ws();
            match(
              p.peek(),
              .Some(c2) => {
                cond(
                  (c2 == u8(44)) => {
                    p.advance();
                  },
                  (c2 == u8(93)) => {
                    p.advance();
                    break;
                  },
                  true => {
                    return(.Err(.UnexpectedChar(c2, p.pos)));
                  }
                );
              },
              .None => {
                return(.Err(.UnexpectedEnd));
              }
            );
          });
          .Ok(.Array(items))
        },
        (c == u8(116)) => _parse_true_lit(p),
        (c == u8(102)) => _parse_false_lit(p),
        (c == u8(110)) => _parse_null_lit(p),
        true =>
          match(p.parse_number(), .Err(e) => .Err(e), .Ok(n) => .Ok(.Number(n)))
      )
  )
});
// ============================================================================
// Public API
// ============================================================================
/// Parse JSON bytes into a `JsonValue` tree. Throws via `Exception` on invalid input.
json_parse_bytes :: (fn(bytes : ArrayList(u8), exn : Exception) -> JsonValue)({
  p := _Parser.new(bytes);
  match(
    _parse_value(p),
    .Ok(v) => v,
    .Err(e) => exn.throw(dyn(e))
  )
});
/// Parse a JSON string into a `JsonValue` tree. Throws via `Exception` on invalid input.
json_parse :: (fn(s : str, exn : Exception) -> JsonValue)({
  bytes := ArrayList(u8).new();
  n := s.len();
  (i : usize) = usize(0);
  while(i < n, {
    bytes.push(s.bytes(i));
    i = (i + usize(1));
  });
  json_parse_bytes(bytes, exn)
});
/// Parse a runtime `String` of JSON into a `JsonValue` tree. Throws via
/// `Exception` on invalid input. (`json_parse` takes the STATIC `str` view;
/// runtime input — an HTTP body, an LSP frame — arrives as `String`.)
json_parse_string :: (fn(s : String, exn : Exception) -> JsonValue)(
  json_parse_bytes(s.as_bytes(), exn)
);
export(json_parse, json_parse_bytes, json_parse_string);
// ============================================================================
// Serialisation
// ============================================================================
_write_str_escaped :: (fn(s : String, out : ArrayList(u8)) -> unit)({
  out.push(u8(34)); // '"'
  bytes := s.as_bytes();
  i := usize(0);
  while(i < bytes.len(), i = (i + usize(1)), {
    b := bytes(i);
    cond(
      (b == u8(34)) => {
        out.push(u8(92));
        out.push(u8(34));
      },
      (b == u8(92)) => {
        out.push(u8(92));
        out.push(u8(92));
      },
      (b == u8(10)) => {
        out.push(u8(92));
        out.push(u8(110));
      },
      (b == u8(9)) => {
        out.push(u8(92));
        out.push(u8(116));
      },
      (b == u8(13)) => {
        out.push(u8(92));
        out.push(u8(114));
      },
      true => {
        out.push(b);
      }
    );
  });
  out.push(u8(34)); // '"'
});
_stringify_into :: (fn(value : JsonValue, out : ArrayList(u8)) -> unit)({
  match(
    value,
    .Null => {
      out.push(u8(110));
      out.push(u8(117));
      out.push(u8(108));
      out.push(u8(108));
    },
    .Bool(b) => {
      cond(
        b => {
          out.push(u8(116));
          out.push(u8(114));
          out.push(u8(117));
          out.push(u8(101));
        },
        true => {
          out.push(u8(102));
          out.push(u8(97));
          out.push(u8(108));
          out.push(u8(115));
          out.push(u8(101));
        }
      );
    },
    .Number(n) => {
      buf := Array(u8, usize(32)).fill(u8(0));
      buf_ptr := &(buf(usize(0)));
      unsafe(snprintf(*(char)(buf_ptr), usize(32), "%g", n));
      s2 := String.from_cstr(buf_ptr).unwrap();
      bytes := s2.as_bytes();
      i := usize(0);
      while(i < bytes.len(), i = (i + usize(1)), {
        out.push(bytes(i));
      });
    },
    .Str(s) => {
      _write_str_escaped(s, out);
    },
    .Array(items) => {
      out.push(u8(91)); // '['
      i := usize(0);
      while(i < items.len(), i = (i + usize(1)), {
        cond(
          (i > usize(0)) => {
            out.push(u8(44));
          },
          true => ()
        );
        recur(items(i), out);
      });
      out.push(u8(93)); // ']'
    },
    .Object(keys, values) => {
      out.push(u8(123)); // '{'
      i := usize(0);
      while(i < keys.len(), i = (i + usize(1)), {
        cond(
          (i > usize(0)) => {
            out.push(u8(44));
          },
          true => ()
        );
        _write_str_escaped(keys(i), out);
        out.push(u8(58)); // ':'
        recur(values(i), out);
      });
      out.push(u8(125)); // '}'
    }
  );
});
/// Serialize a `JsonValue` to a compact JSON string.
json_stringify :: (fn(value : JsonValue) -> String)({
  out := ArrayList(u8).new();
  _stringify_into(value, out);
  String.from_bytes(out)
});
/// Write `n` spaces to `out`.
_write_spaces :: (fn(n : usize, out : ArrayList(u8)) -> unit)({
  i := usize(0);
  while(i < n, i = (i + usize(1)), {
    out.push(u8(32));
  });
});
/// Pretty-printing worker. `indent` is the per-level width; `depth` is the
/// current nesting level. Matches `JSON.stringify(value, null, indent)`:
/// containers break one element per line, an EMPTY container stays on one line
/// (`{}` / `[]`), and object keys are followed by `": "`.
_stringify_pretty_into :: (
  fn(
    value : JsonValue,
    indent : usize,
    depth : usize,
    out : ArrayList(u8)
  ) -> unit
)({
  match(
    value,
    .Array(items) => {
      out.push(u8(91)); // '['
      cond(
        (items.len() == usize(0)) => (),
        true => {
          i := usize(0);
          while(i < items.len(), i = (i + usize(1)), {
            cond(
              (i > usize(0)) => {
                out.push(u8(44)); // ','
              },
              true => ()
            );
            out.push(u8(10)); // '\n'
            _write_spaces(indent * (depth + usize(1)), out);
            recur(items(i), indent, depth + usize(1), out);
          });
          out.push(u8(10));
          _write_spaces(indent * depth, out);
        }
      );
      out.push(u8(93)); // ']'
    },
    .Object(keys, values) => {
      out.push(u8(123)); // '{'
      cond(
        (keys.len() == usize(0)) => (),
        true => {
          i := usize(0);
          while(i < keys.len(), i = (i + usize(1)), {
            cond(
              (i > usize(0)) => {
                out.push(u8(44)); // ','
              },
              true => ()
            );
            out.push(u8(10)); // '\n'
            _write_spaces(indent * (depth + usize(1)), out);
            _write_str_escaped(keys(i), out);
            out.push(u8(58)); // ':'
            out.push(u8(32)); // ' '
            recur(values(i), indent, depth + usize(1), out);
          });
          out.push(u8(10));
          _write_spaces(indent * depth, out);
        }
      );
      out.push(u8(125)); // '}'
    },
    // Scalars are identical in both modes.
    _ => _stringify_into(value, out)
  );
});
/// Serialize a `JsonValue` to a pretty-printed JSON string, `indent` spaces per
/// nesting level. `indent == 0` produces the compact form, as
/// `JSON.stringify(v, null, 0)` does.
json_stringify_pretty :: (fn(value : JsonValue, indent : usize) -> String)(
  cond(
    (indent == usize(0)) => json_stringify(value),
    true => {
      out := ArrayList(u8).new();
      _stringify_pretty_into(value, indent, usize(0), out);
      String.from_bytes(out)
    }
  )
);
export(json_stringify, json_stringify_pretty);
