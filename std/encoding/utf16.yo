//! UTF-8 to UTF-16 conversion and vice versa.
//!
//! Converts between Yo's UTF-8 `str` and UTF-16 code units (`ArrayList(u16)`).
//!
//! ## Example
//!
//! ```rust
//! { utf8_to_utf16, utf16_to_utf8 } :: import "std/encoding/utf16";
//!
//! words := utf8_to_utf16("hello");
//! s := utf16_to_utf8(words);
//! ```
open(import("../string"));
{ ArrayList } :: import("../collections/array_list");
{ EncodingError } :: import("./error");
{ Error, AnyError, Exception } :: import("../error");
utf8 :: import("./utf8");
// ============================================================================
// UTF-8 → UTF-16
// ============================================================================
/// Convert a UTF-8 string to an `ArrayList(u16)` of UTF-16 code units.
///
/// Handles BMP characters directly and encodes supplementary characters as surrogate pairs.
utf8_to_utf16 :: (fn(s : String) -> ArrayList(u16))({
  bytes := s.as_bytes();
  out := ArrayList(u16).new();
  i := usize(0);
  while(i < bytes.len(), {
    // A malformed byte becomes U+FFFD and advances by one, so a corrupt input
    // still terminates instead of walking off the buffer.
    d := utf8.decode_lossy(bytes, i);
    cp := d.code.to_u32();
    cond(
      (cp < u32(0x10000)) => {
        out.push(u16(cp));
      },
      true => {
        // Supplementary plane → surrogate pair.
        cp2 := (cp - u32(0x10000));
        out.push(u16((cp2 >> u32(10)) + u32(0xD800)));
        out.push(u16((cp2 & u32(0x3FF)) + u32(0xDC00)));
      }
    );
    i = (i + d.width);
  });
  out
});
export(utf8_to_utf16);
// ============================================================================
// UTF-16 → UTF-8
// ============================================================================
/// Convert UTF-16 code units to a UTF-8 `String`.
///
/// Decodes surrogate pairs back into supplementary code points.
/// Throws via `Exception` on unpaired surrogates.
utf16_to_utf8 :: (fn(data : ArrayList(u16), exn : Exception) -> String)({
  out := ArrayList(u8).new();
  i := usize(0);
  while(i < data.len(), {
    w := u32(data(i));
    cond(
      // Surrogate pair: high surrogate 0xD800-0xDBFF
      ((w >= u32(0xD800)) && (w <= u32(0xDBFF))) => {
        cond(
          ((i + usize(1)) >= data.len()) => {
            exn.throw(dyn(EncodingError.InvalidChar(u8(0))));
          },
          true => ()
        );
        w2 := u32(data(i + usize(1)));
        cond(
          ((w2 < u32(0xDC00)) || (w2 > u32(0xDFFF))) => {
            exn.throw(dyn(EncodingError.InvalidChar(u8(0))));
          },
          true => ()
        );
        cp := (((w - u32(0xD800)) << u32(10)) + (w2 - u32(0xDC00)) + u32(0x10000));
        utf8.encode_lossy_into(cp, out);
        i = (i + usize(2));
      },
      // A LOW surrogate that was not consumed by the branch above is
      // unpaired. The old code let it fall through and wrote it out as a
      // 3-byte CESU-8 sequence — invalid UTF-8 — despite this function's
      // documented "throws on unpaired surrogates" contract.
      ((w >= u32(0xDC00)) && (w <= u32(0xDFFF))) => {
        exn.throw(dyn(EncodingError.InvalidChar(u8(0))));
      },
      true => {
        // A BMP scalar: nothing is ever substituted here.
        utf8.encode_lossy_into(w, out);
        i = (i + usize(1));
      }
    );
  });
  String.from_bytes(out)
});
export(utf16_to_utf8);
