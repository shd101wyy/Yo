//! UTF-8 to UTF-16 conversion and vice versa.
//!
//! Converts between Yo's UTF-8 `str` and UTF-16 code units (`ArrayList(u16)`).
//!
//! ## Example
//!
//! ```rust
//! utf16 :: import("std/encoding/utf16");
//!
//! words := utf16.from_utf8("hello");
//! s := utf16.to_utf8(words);
//! ```
//!
//! Both directions work in CODE UNITS, not bytes — the same basis as Rust's
//! `str::encode_utf16` and `String::from_utf16`. There is no endianness and
//! no BOM here: a caller reading a UTF-16LE file or a Windows `wchar_t*`
//! assembles the `u16`s first.
//!
//! ## Stability
//!
//! unstable — the two directions disagree about failure, and settling that is
//! the open question. `utf8_to_utf16` is LOSSY and infallible (a malformed
//! byte becomes U+FFFD, via `utf8.decode_lossy`), while `utf16_to_utf8` is
//! STRICT and returns a `Result` (an unpaired surrogate is
//! `EncodingError.UnpairedSurrogate`). Rust ships BOTH forms of the fallible
//! direction — `String::from_utf16` and `from_utf16_lossy` — and this module
//! has neither counterpart: no `utf16_to_utf8_lossy` for a caller who wants
//! replacement characters, and no strict `utf8_to_utf16` for a caller who
//! would rather hear that the `String` it was handed is not valid UTF-8 than
//! have the fault papered over. Adding the lossy decoder is additive; making
//! the encoder fallible is not.
//!
//! Also not shipped yet: `utf16_to_utf8` became `Result`-returning in #467
//! (D13), and `UnpairedSurrogate` — which fixed all three surrogate faults
//! reporting `InvalidChar(u8(0))`, an offending character of NUL, because a
//! 16-bit code unit does not fit a `u8` — landed 2026-09-09 (#526). The
//! `pos` it carries is a CODE-UNIT index where every other `EncodingError`
//! offset is a byte offset, which is part of why that shared enum is itself
//! unstable. Names stutter (D2) like the rest of the encoding group.
{ String } :: import("../string");
{ ArrayList } :: import("../collections/array_list");
{ EncodingError } :: import("./error");
{ Error, AnyError, Exception } :: import("../error");
utf8 :: import("./utf8");
// ============================================================================
// UTF-8 → UTF-16
// ============================================================================
/// Convert a UTF-8 string to an `ArrayList(u16)` of UTF-16 code units.
///
/// Handles BMP characters directly and encodes supplementary characters as surrogate pairs.
from_utf8 :: (fn(s : String) -> ArrayList(u16))({
  bytes := s.as_bytes();
  out := ArrayList(u16).new();
  i := usize(0);
  while(i < bytes.len(), {
    // A malformed byte becomes U+FFFD and advances by one, so a corrupt input
    // still terminates instead of walking off the buffer.
    d := utf8.decode_lossy(bytes, i);
    cp := d.code.to_u32();
    cond(
      (cp < u32(0x10000)) => {
        out.push(u16(cp));
      },
      true => {
        // Supplementary plane → surrogate pair.
        cp2 := (cp - u32(0x10000));
        out.push(u16((cp2 >> u32(10)) + u32(0xD800)));
        out.push(u16((cp2 & u32(0x3FF)) + u32(0xDC00)));
      }
    );
    i = (i + d.width);
  });
  out
});
export(from_utf8);
// ============================================================================
// UTF-16 → UTF-8
// ============================================================================
/// Convert UTF-16 code units to a UTF-8 `String` (D13 — a pure transform
/// returns a `Result`; `to_utf8_exn` is the effect-carrying wrapper).
///
/// Decodes surrogate pairs back into supplementary code points.
/// `.Err(EncodingError.UnpairedSurrogate)` on an unpaired surrogate, carrying
/// the offending code unit and its index — it used to report
/// `InvalidChar(u8(0))`, an offending character of NUL, because a 16-bit code
/// unit does not fit in `InvalidChar`'s `u8`.
to_utf8 :: (fn(data : ArrayList(u16)) -> Result(String, EncodingError))({
  out := ArrayList(u8).new();
  i := usize(0);
  while(i < data.len(), {
    w := u32(data(i));
    cond(
      // Surrogate pair: high surrogate 0xD800-0xDBFF
      ((w >= u32(0xD800)) && (w <= u32(0xDBFF))) => {
        cond(
          ((i + usize(1)) >= data.len()) => {
            return(.Err(EncodingError.UnpairedSurrogate(code_unit : u16(w), pos : i)));
          },
          true => ()
        );
        w2 := u32(data(i + usize(1)));
        cond(
          ((w2 < u32(0xDC00)) || (w2 > u32(0xDFFF))) => {
            // The HIGH surrogate is the one at fault: it promised a partner.
            return(.Err(EncodingError.UnpairedSurrogate(code_unit : u16(w), pos : i)));
          },
          true => ()
        );
        cp := (((w - u32(0xD800)) << u32(10)) + (w2 - u32(0xDC00)) + u32(0x10000));
        utf8.encode_lossy_into(cp, out);
        i = (i + usize(2));
      },
      // A LOW surrogate that was not consumed by the branch above is
      // unpaired. The old code let it fall through and wrote it out as a
      // 3-byte CESU-8 sequence — invalid UTF-8 — despite this function's
      // documented "rejects unpaired surrogates" contract.
      ((w >= u32(0xDC00)) && (w <= u32(0xDFFF))) => {
        return(.Err(EncodingError.UnpairedSurrogate(code_unit : u16(w), pos : i)));
      },
      true => {
        // A BMP scalar: nothing is ever substituted here.
        utf8.encode_lossy_into(w, out);
        i = (i + usize(1));
      }
    );
  });
  .Ok(String.from_bytes(out))
});
/// `to_utf8` as an effect: throws the `EncodingError` through `exn`
/// instead of returning it. Kept for callers already inside an effect scope.
to_utf8_exn :: (fn(data : ArrayList(u16), exn : Exception) -> String)(
  match(to_utf8(data), .Ok(v) => v, .Err(e) => exn.throw(dyn(e)))
);
export(to_utf8, to_utf8_exn);
// ============================================================================
// DEPRECATED module-prefix aliases (D2) — REMOVED IN v0.2.32
// ============================================================================
// `utf16 :: import("std/encoding/utf16")` already qualifies the call, so both
// old spellings stuttered (`utf16.utf8_to_utf16`, `utf16.utf16_to_utf8`). These
// thin aliases keep them compiling for one release, the way `json_parse_result`
// and `derive(ToString)` were kept in v0.2.28.
/// DEPRECATED, removed in v0.2.32: call `utf16.from_utf8`.
utf8_to_utf16 :: (fn(s : String) -> ArrayList(u16))(from_utf8(s));
/// DEPRECATED, removed in v0.2.32: call `utf16.to_utf8`.
utf16_to_utf8 :: (fn(data : ArrayList(u16)) -> Result(String, EncodingError))(to_utf8(data));
/// DEPRECATED, removed in v0.2.32: call `utf16.to_utf8_exn`.
utf16_to_utf8_exn :: (fn(data : ArrayList(u16), exn : Exception) -> String)(
  to_utf8_exn(data, exn)
);
export(utf8_to_utf16, utf16_to_utf8, utf16_to_utf8_exn);
