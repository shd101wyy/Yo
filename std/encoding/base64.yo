//! Base64 encoding and decoding (RFC 4648) with standard and URL-safe variants.
//!
//! ## Example
//!
//! ```rust
//! { base64_encode, base64_decode } :: import "std/encoding/base64";
//!
//! s := base64_encode(data);
//! b := base64_decode(s.to_string()).unwrap();
//! ```
open(import("../string"));
{ ArrayList } :: import("../collections/array_list");
{ EncodingError } :: import("./error");
{ Error, AnyError, Exception } :: import("../error");
// ============================================================================
// Standard alphabet
// ============================================================================
_STD_ALPHA :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
_URL_ALPHA :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
_PAD :: u8(61); // '='
// ============================================================================
// Encoding
// ============================================================================
_encode_with :: (fn(data : ArrayList(u8), alpha : str, pad : bool) -> String)({
  n := data.len();
  out := ArrayList(u8).with_capacity(((n + usize(2)) / usize(3)) * usize(4));
  i := usize(0);
  while(i < n, i = (i + usize(3)), {
    b0 := data(i);
    b1 := cond(((i + usize(1)) < n) => data(i + usize(1)), true => u8(0));
    b2 := cond(((i + usize(2)) < n) => data(i + usize(2)), true => u8(0));
    out.push(alpha.bytes(usize(b0 >> u8(2))));
    out.push(alpha.bytes(usize(((b0 & u8(3)) << u8(4)) | (b1 >> u8(4)))));
    cond(
      ((i + usize(1)) < n) => {
        out.push(alpha.bytes(usize(((b1 & u8(15)) << u8(2)) | (b2 >> u8(6)))));
      },
      pad => {
        out.push(_PAD);
      },
      true => ()
    );
    cond(
      ((i + usize(2)) < n) => {
        out.push(alpha.bytes(usize(b2 & u8(63))));
      },
      pad => {
        out.push(_PAD);
      },
      true => ()
    );
  });
  String.from_bytes(out)
});
/// Encode bytes as standard base64 with padding.
base64_encode :: (fn(data : ArrayList(u8)) -> String)(
  _encode_with(data, _STD_ALPHA, true)
);
/// Encode bytes as URL-safe base64 without padding.
base64_encode_url :: (fn(data : ArrayList(u8)) -> String)(
  _encode_with(data, _URL_ALPHA, false)
);
export(base64_encode, base64_encode_url);
// ============================================================================
// Decoding
// ============================================================================
_decode_char :: (fn(c : u8, alpha : str, exn : Exception) -> u8)({
  i := usize(0);
  while(i < usize(64), i = (i + usize(1)), {
    cond(
      (alpha.bytes(i) == c) => {
        return(u8(i));
      },
      true => ()
    );
  });
  exn.throw(dyn(EncodingError.InvalidChar(c)))
});
_decode_with :: (fn(s : String, alpha : str, exn : Exception) -> ArrayList(u8))({
  // Strip trailing padding
  len := s.len();
  while((len > usize(0)) && (s.byte_at(len - usize(1)) == _PAD), len = (len - usize(1)), ());
  // One leftover sextet encodes nothing: no encoder emits it, so it is an
  // error, not a zero byte (issues/fixed/base64-decode-accepted-impossible-lengths-and-trailing-bits.md).
  cond(
    ((len % usize(4)) == usize(1)) => {
      exn.throw(dyn(EncodingError.InvalidLength));
    },
    true => ()
  );
  out := ArrayList(u8).with_capacity((len * usize(3)) / usize(4));
  i := usize(0);
  while(i < len, i = (i + usize(4)), {
    c0 := _decode_char(s.byte_at(i), alpha, exn);
    c1 := cond(
      ((i + usize(1)) < len) => _decode_char(s.byte_at(i + usize(1)), alpha, exn),
      true => u8(0)
    );
    out.push((c0 << u8(2)) | (c1 >> u8(4)));
    cond(
      ((i + usize(2)) < len) => {
        c2 := _decode_char(s.byte_at(i + usize(2)), alpha, exn);
        out.push(((c1 & u8(15)) << u8(4)) | (c2 >> u8(2)));
        cond(
          ((i + usize(3)) < len) => {
            c3 := _decode_char(s.byte_at(i + usize(3)), alpha, exn);
            out.push(((c2 & u8(3)) << u8(6)) | c3);
          },
          true => {
            // Three symbols carry 18 bits for two bytes; the last symbol's
            // low two bits must be zero, or the input has no canonical
            // encoding (Rust rejects it as InvalidLastSymbol).
            cond(
              ((c2 & u8(3)) != u8(0)) => {
                exn.throw(dyn(EncodingError.InvalidLastSymbol(s.byte_at(i + usize(2)))));
              },
              true => ()
            );
          }
        );
      },
      true => {
        // Two symbols carry 12 bits for one byte; the low four bits of the
        // second must be zero.
        cond(
          ((c1 & u8(15)) != u8(0)) => {
            exn.throw(dyn(EncodingError.InvalidLastSymbol(s.byte_at(i + usize(1)))));
          },
          true => ()
        );
      }
    );
  });
  out
});
/// Decode a standard base64 string to bytes. Throws via `Exception` on invalid
/// input: a symbol outside the alphabet (`InvalidChar`), a length of 1 mod 4
/// (`InvalidLength`), or a final symbol with non-zero unused bits
/// (`InvalidLastSymbol`). Padding is optional and, when present, trailing.
base64_decode :: (fn(s : String, exn : Exception) -> ArrayList(u8))(
  _decode_with(s, _STD_ALPHA, exn)
);
/// Decode a URL-safe base64 string to bytes. Throws via `Exception` on invalid input.
base64_decode_url :: (fn(s : String, exn : Exception) -> ArrayList(u8))(
  _decode_with(s, _URL_ALPHA, exn)
);
export(base64_decode, base64_decode_url);
