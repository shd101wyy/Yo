//! Base64 encoding and decoding (RFC 4648) with standard and URL-safe variants.
//!
//! ## Example
//!
//! ```rust
//! base64 :: import("std/encoding/base64");
//!
//! s := base64.encode(data);
//! b := base64.decode(s.to_string()).unwrap();
//! ```
//!
//! ## Stability
//!
//! unstable — the alphabet and the padding rule are baked into the function
//! NAMES, and that is the open question. `base64_encode` uses the standard
//! alphabet WITH padding, `base64_encode_url` the URL-safe alphabet WITHOUT
//! it, and there is no way to ask for the other two combinations; both
//! decoders accept padded and unpadded input alike, so `base64_decode` is
//! Rust's `STANDARD` and `STANDARD_NO_PAD` engines at once. Rust's `base64`
//! crate separates the alphabet from the padding policy into a
//! configurable `Engine` precisely because four names do not scale, and a
//! third axis (`Engine`'s `decode_padding_mode`) would make it eight here.
//! Deciding whether Yo grows an options value or keeps naming the
//! combinations is what has to happen before this freezes.
//!
//! Two smaller things ride along. The decode leniency is wider than Rust's:
//! ALL trailing `=` are stripped before the length check, so `"QUJD===="` is
//! accepted where Rust rejects excess padding — a canonical-form check would
//! turn input that decodes today into an error. And the errors come from the
//! shared `EncodingError` in `std/encoding/error.yo`, which gained its `pos`
//! fields on 2026-09-09 and has not been through a release; whether one enum
//! serves three codecs or splits per codec is that module's own open
//! question.
//!
//! The names also still stutter (D2): `base64_encode` repeats the module it
//! lives in, and the decided direction is `base64.encode` on the imported
//! module value — listed as STILL OPEN in `plans/STD_API_STABILIZATION.md`
//! §4 for the whole encoding group.
{ String } :: import("../string");
{ ArrayList } :: import("../collections/array_list");
{ EncodingError } :: import("./error");
{ Error, AnyError, Exception } :: import("../error");
// ============================================================================
// Standard alphabet
// ============================================================================
_STD_ALPHA :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
_URL_ALPHA :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
_PAD :: u8(61); // '='
// ============================================================================
// Encoding
// ============================================================================
_encode_with :: (fn(data : ArrayList(u8), alpha : str, pad : bool) -> String)({
  n := data.len();
  out := ArrayList(u8).with_capacity(((n + usize(2)) / usize(3)) * usize(4));
  i := usize(0);
  while(i < n, i = (i + usize(3)), {
    b0 := data(i);
    b1 := cond(((i + usize(1)) < n) => data(i + usize(1)), true => u8(0));
    b2 := cond(((i + usize(2)) < n) => data(i + usize(2)), true => u8(0));
    out.push(alpha.bytes(usize(b0 >> u8(2))));
    out.push(alpha.bytes(usize(((b0 & u8(3)) << u8(4)) | (b1 >> u8(4)))));
    cond(
      ((i + usize(1)) < n) => {
        out.push(alpha.bytes(usize(((b1 & u8(15)) << u8(2)) | (b2 >> u8(6)))));
      },
      pad => {
        out.push(_PAD);
      },
      true => ()
    );
    cond(
      ((i + usize(2)) < n) => {
        out.push(alpha.bytes(usize(b2 & u8(63))));
      },
      pad => {
        out.push(_PAD);
      },
      true => ()
    );
  });
  String.from_bytes(out)
});
/// Encode bytes as standard base64 with padding.
encode :: (fn(data : ArrayList(u8)) -> String)(
  _encode_with(data, _STD_ALPHA, true)
);
/// Encode bytes as URL-safe base64 without padding.
encode_url :: (fn(data : ArrayList(u8)) -> String)(
  _encode_with(data, _URL_ALPHA, false)
);
export(encode, encode_url);
// ============================================================================
// Decoding
// ============================================================================
_decode_char_res :: (fn(c : u8, alpha : str, pos : usize) -> Result(u8, EncodingError))({
  i := usize(0);
  while(i < usize(64), i = (i + usize(1)), {
    cond(
      (alpha.bytes(i) == c) => {
        return(.Ok(u8(i)));
      },
      true => ()
    );
  });
  .Err(EncodingError.InvalidChar(ch : c, pos : pos))
});
_decode_with_res :: (fn(s : String, alpha : str) -> Result(ArrayList(u8), EncodingError))({
  // Strip trailing padding
  len := s.len();
  while((len > usize(0)) && (s.byte_at(len - usize(1)) == _PAD), len = (len - usize(1)), ());
  // One leftover sextet encodes nothing: no encoder emits it, so it is an
  // error, not a zero byte (issues/fixed/base64-decode-accepted-impossible-lengths-and-trailing-bits.md).
  cond(
    ((len % usize(4)) == usize(1)) => {
      return(.Err(EncodingError.InvalidLength(len : len)));
    },
    true => ()
  );
  out := ArrayList(u8).with_capacity((len * usize(3)) / usize(4));
  i := usize(0);
  while(i < len, i = (i + usize(4)), {
    c0 := match(
      _decode_char_res(s.byte_at(i), alpha, i),
      .Ok(v) => v,
      .Err(e) => {
        return(.Err(e));
      }
    );
    c1 := cond(
      ((i + usize(1)) < len) => match(
        _decode_char_res(s.byte_at(i + usize(1)), alpha, i + usize(1)),
        .Ok(v) => v,
        .Err(e) => {
          return(.Err(e));
        }
      ),
      true => u8(0)
    );
    out.push((c0 << u8(2)) | (c1 >> u8(4)));
    cond(
      ((i + usize(2)) < len) => {
        c2 := match(
          _decode_char_res(s.byte_at(i + usize(2)), alpha, i + usize(2)),
          .Ok(v) => v,
          .Err(e) => {
            return(.Err(e));
          }
        );
        out.push(((c1 & u8(15)) << u8(4)) | (c2 >> u8(2)));
        cond(
          ((i + usize(3)) < len) => {
            c3 := match(
              _decode_char_res(s.byte_at(i + usize(3)), alpha, i + usize(3)),
              .Ok(v) => v,
              .Err(e) => {
                return(.Err(e));
              }
            );
            out.push(((c2 & u8(3)) << u8(6)) | c3);
          },
          true => {
            // Three symbols carry 18 bits for two bytes; the last symbol's
            // low two bits must be zero, or the input has no canonical
            // encoding (Rust rejects it as InvalidLastSymbol).
            cond(
              ((c2 & u8(3)) != u8(0)) => {
                return(.Err(EncodingError.InvalidLastSymbol(ch : s.byte_at(i + usize(2)), pos : (i + usize(2)))));
              },
              true => ()
            );
          }
        );
      },
      true => {
        // Two symbols carry 12 bits for one byte; the low four bits of the
        // second must be zero.
        cond(
          ((c1 & u8(15)) != u8(0)) => {
            return(.Err(EncodingError.InvalidLastSymbol(ch : s.byte_at(i + usize(1)), pos : (i + usize(1)))));
          },
          true => ()
        );
      }
    );
  });
  .Ok(out)
});
/// Decode a standard base64 string to bytes (D13 — a pure transform returns a
/// `Result`). `.Err` on a symbol outside the alphabet (`InvalidChar`), a
/// length of 1 mod 4 (`InvalidLength`), or a final symbol with non-zero
/// unused bits (`InvalidLastSymbol`). Padding is optional and, when present,
/// trailing.
decode :: (fn(s : String) -> Result(ArrayList(u8), EncodingError))(
  _decode_with_res(s, _STD_ALPHA)
);
/// Decode a URL-safe base64 string to bytes.
decode_url :: (fn(s : String) -> Result(ArrayList(u8), EncodingError))(
  _decode_with_res(s, _URL_ALPHA)
);
/// `decode` as an effect: throws the `EncodingError` through `exn`
/// instead of returning it. Kept for callers already inside an effect scope.
decode_exn :: (fn(s : String, exn : Exception) -> ArrayList(u8))(
  match(decode(s), .Ok(v) => v, .Err(e) => exn.throw(dyn(e)))
);
/// `decode_url` as an effect.
decode_url_exn :: (fn(s : String, exn : Exception) -> ArrayList(u8))(
  match(decode_url(s), .Ok(v) => v, .Err(e) => exn.throw(dyn(e)))
);
export(decode, decode_url, decode_exn, decode_url_exn);
// ============================================================================
// DEPRECATED module-prefix aliases (D2) — REMOVED IN v0.2.32
// ============================================================================
// `base64 :: import("std/encoding/base64")` already qualifies the call, so the
// `base64_` prefix stuttered (`base64.base64_encode`). These thin aliases keep
// the pre-rename spellings compiling for one release, the way
// `json_parse_result` and `derive(ToString)` were kept in v0.2.28.
/// DEPRECATED, removed in v0.2.32: call `base64.encode`.
base64_encode :: (fn(data : ArrayList(u8)) -> String)(encode(data));
/// DEPRECATED, removed in v0.2.32: call `base64.encode_url`.
base64_encode_url :: (fn(data : ArrayList(u8)) -> String)(encode_url(data));
/// DEPRECATED, removed in v0.2.32: call `base64.decode`.
base64_decode :: (fn(s : String) -> Result(ArrayList(u8), EncodingError))(decode(s));
/// DEPRECATED, removed in v0.2.32: call `base64.decode_url`.
base64_decode_url :: (fn(s : String) -> Result(ArrayList(u8), EncodingError))(decode_url(s));
/// DEPRECATED, removed in v0.2.32: call `base64.decode_exn`.
base64_decode_exn :: (fn(s : String, exn : Exception) -> ArrayList(u8))(decode_exn(s, exn));
/// DEPRECATED, removed in v0.2.32: call `base64.decode_url_exn`.
base64_decode_url_exn :: (fn(s : String, exn : Exception) -> ArrayList(u8))(decode_url_exn(s, exn));
export(
  base64_encode,
  base64_encode_url,
  base64_decode,
  base64_decode_url,
  base64_decode_exn,
  base64_decode_url_exn
);
