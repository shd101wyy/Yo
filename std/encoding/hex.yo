//! Hexadecimal encoding and decoding.
//!
//! Converts between raw bytes (`ArrayList(u8)`) and hex strings.
//!
//! ## Example
//!
//! ```rust
//! hex :: import("std/encoding/hex");
//!
//! s := hex.encode(data);         // "deadbeef"
//! b := hex.decode(`deadbeef`).unwrap();
//! ```
//!
//! Encoding is lowercase only; decoding accepts either case, and mixed case
//! within one string.
//!
//! ## Stability
//!
//! unstable — two names short of complete, and the missing one is visible in
//! the code. `_hex_encode_impl` already takes its alphabet as a parameter and
//! `_HEX_CHARS` is the only value ever passed, so Rust's `hex::encode_upper`
//! is one export away; that is additive and safe. The name is the part that
//! is not settled: `hex_encode` / `hex_encode_upper` repeats the module (D2's
//! module-prefix stutter, listed STILL OPEN for the whole encoding group in
//! `plans/STD_API_STABILIZATION.md` §4), and the decided direction is
//! `hex.encode` on the imported module value. Adding a second stuttering name
//! first would mean renaming two instead of one.
//!
//! `hex_decode` became `Result`-returning in #467 (D13) and has not been
//! through a release; its errors are the shared `EncodingError`, whose own
//! open question — one enum for three codecs, where Rust has
//! `hex::FromHexError` — is the other thing holding this module unstable,
//! since `hex_decode` can only ever produce two of that enum's five variants.
{ String } :: import("../string");
{ ArrayList } :: import("../collections/array_list");
{ EncodingError } :: import("./error");
{ Error, AnyError, Exception } :: import("../error");
// ============================================================================
// Encoding
// ============================================================================
_HEX_CHARS :: "0123456789abcdef";
// Encode bytes as lowercase hexadecimal.
_hex_encode_impl :: (fn(data : ArrayList(u8), hex_chars : str) -> String)({
  out := ArrayList(u8).with_capacity(data.len() * usize(2));
  i := usize(0);
  while(i < data.len(), i = (i + usize(1)), {
    b := data(i);
    hi := usize((b >> u8(4)) & u8(0xF));
    lo := usize(b & u8(0xF));
    out.push(hex_chars.bytes(hi));
    out.push(hex_chars.bytes(lo));
  });
  String.from_bytes(out)
});
/// Encode bytes as a lowercase hexadecimal string.
encode :: (fn(data : ArrayList(u8)) -> String)(
  _hex_encode_impl(data, _HEX_CHARS)
);
export(encode);
// ============================================================================
// Decoding
// ============================================================================
/// Nibble value of one hex digit, or which character was wrong AND where
/// (D13). The offset is passed in rather than derived, because this sees one
/// byte and the caller is the one that knows where it came from.
_hex_nibble_res :: (fn(c : u8, pos : usize) -> Result(u8, EncodingError))(
  cond(
    ((c >= u8(48)) && (c <= u8(57))) => .Ok(c - u8(48)),
    // '0'-'9'
    ((c >= u8(97)) && (c <= u8(102))) => .Ok((c - u8(97)) + u8(10)),
    // 'a'-'f'
    ((c >= u8(65)) && (c <= u8(70))) => .Ok((c - u8(65)) + u8(10)),
    // 'A'-'F'
    true => .Err(EncodingError.InvalidChar(ch : c, pos : pos))
  )
);
/// Decode a hexadecimal string to bytes (D13 — a pure transform returns a
/// `Result`; `decode_exn` is the effect-carrying wrapper).
decode :: (fn(s : String) -> Result(ArrayList(u8), EncodingError))({
  cond(
    ((s.len() % usize(2)) != usize(0)) => {
      return(.Err(EncodingError.OddLength(len : s.len())));
    },
    true => ()
  );
  out := ArrayList(u8).with_capacity(s.len() / usize(2));
  i := usize(0);
  while(i < s.len(), i = (i + usize(2)), {
    hi := match(
      _hex_nibble_res(s.byte_at(i), i),
      .Ok(v) => v,
      .Err(e) => {
        return(.Err(e));
      }
    );
    lo := match(
      _hex_nibble_res(s.byte_at(i + usize(1)), i + usize(1)),
      .Ok(v) => v,
      .Err(e) => {
        return(.Err(e));
      }
    );
    out.push((hi << u8(4)) | lo);
  });
  .Ok(out)
});
/// `decode` as an effect: throws the `EncodingError` through `exn`
/// instead of returning it. Kept for callers already inside an effect scope.
decode_exn :: (fn(s : String, exn : Exception) -> ArrayList(u8))(
  match(decode(s), .Ok(v) => v, .Err(e) => exn.throw(dyn(e)))
);
export(decode, decode_exn);
// ============================================================================
// DEPRECATED module-prefix aliases (D2) — REMOVED IN v0.2.32
// ============================================================================
// `hex :: import("std/encoding/hex")` already qualifies the call, so the `hex_`
// prefix stuttered (`hex.hex_encode`). These thin aliases keep the pre-rename
// spellings compiling for one release, the way `json_parse_result` and
// `derive(ToString)` were kept in v0.2.28.
/// DEPRECATED, removed in v0.2.32: call `hex.encode`.
hex_encode :: (fn(data : ArrayList(u8)) -> String)(encode(data));
/// DEPRECATED, removed in v0.2.32: call `hex.decode`.
hex_decode :: (fn(s : String) -> Result(ArrayList(u8), EncodingError))(decode(s));
/// DEPRECATED, removed in v0.2.32: call `hex.decode_exn`.
hex_decode_exn :: (fn(s : String, exn : Exception) -> ArrayList(u8))(decode_exn(s, exn));
export(hex_encode, hex_decode, hex_decode_exn);
