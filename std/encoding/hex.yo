// std/encoding/hex.yo - Hexadecimal encoding/decoding
//
// Converts between raw bytes (ArrayList(u8)) and hex strings.
//
// Example:
//   { hex_encode, hex_decode } :: import "std/encoding/hex";
//
//   s := hex_encode(data);         // "deadbeef"
//   b := hex_decode("deadbeef").unwrap();

open import "../string";
{ ArrayList } :: import "../collections/array_list";

// ============================================================================
// Error type
// ============================================================================

EncodingError :: enum(
  InvalidChar(ch: u8),
  OddLength
);

export EncodingError;

// ============================================================================
// Encoding
// ============================================================================

_HEX_CHARS :: "0123456789abcdef";

// Encode bytes as lowercase hexadecimal.
_hex_encode_impl :: (fn(data: ArrayList(u8), hex_chars: str) -> String)({
  out := ArrayList(u8).with_capacity((data.len() * usize(2)));
  i := usize(0);
  while (i < data.len()), (i = (i + usize(1))), {
    b := data.get(i).unwrap();
    hi := usize(((b >> u8(4)) & u8(0xF)));
    lo := usize((b & u8(0xF)));
    out.push(hex_chars.bytes(hi));
    out.push(hex_chars.bytes(lo));
  };
  String.from_bytes(out)
});

hex_encode :: (fn(data: ArrayList(u8)) -> String)(
  _hex_encode_impl(data, _HEX_CHARS)
);

export hex_encode;

// ============================================================================
// Decoding
// ============================================================================

_hex_nibble :: (fn(c: u8) -> Result(u8, EncodingError))(
  cond(
    ((c >= u8(48)) && (c <= u8(57)))  => .Ok((c - u8(48))),         // '0'-'9'
    ((c >= u8(97)) && (c <= u8(102))) => .Ok(((c - u8(97)) + u8(10))), // 'a'-'f'
    ((c >= u8(65)) && (c <= u8(70)))  => .Ok(((c - u8(65)) + u8(10))), // 'A'-'F'
    true => .Err(.InvalidChar(c))
  )
);

// Decode a hexadecimal string into bytes.
hex_decode :: (fn(s: str) -> Result(ArrayList(u8), EncodingError))({
  cond(
    (((s.len() % usize(2)) != usize(0))) => {
      return .Err(.OddLength);
    },
    true => ()
  );
  out := ArrayList(u8).with_capacity((s.len() / usize(2)));
  i   := usize(0);
  while (i < s.len()), (i = (i + usize(2))), {
    hi_r := _hex_nibble(s.bytes(i));
    lo_r := _hex_nibble(s.bytes((i + usize(1))));
    match(hi_r,
      .Err(e) => { return .Err(e); },
      .Ok(hi) => {
        match(lo_r,
          .Err(e) => { return .Err(e); },
          .Ok(lo) => {
            out.push(((hi << u8(4)) | lo));
          }
        );
      }
    );
  };
  .Ok(out)
});

export hex_decode;
