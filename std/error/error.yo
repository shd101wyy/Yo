// std/error/error.yo - Error trait and common error types
//
// Provides a standard Error trait for implementing custom error types,
// and error chaining utilities.

{ String } :: import "../string";

// ============================================================================
// Error trait
// ============================================================================

// Error trait - implemented by all error types.
// Provides a human-readable message and optional cause chain.
Error :: (fn(comptime(T) : Type) -> comptime(Type))
  trait(
    message :: (fn(self: *(T)) -> String)
  )
;

export Error;
