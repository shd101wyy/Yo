//! High-level child-process spawning with builder-style configuration.
//!
//! Wraps `std/sys/process` with a fluent API for constructing argv, capturing
//! stdout/stderr through pipes, and waiting for the child to exit.
//!
//! # Example
//!
//! ```rust
//! { Command } :: import "std/process/command";
//! { Exception, AnyError } :: import "std/error";
//!
//! main :: (fn(io : Io, exn : Exception) -> unit)({
//!   cmd := Command.new(`echo`);
//!   cmd.arg(`hello`);
//!   cmd.arg(`world`);
//!   out := io.await(cmd.output(io), { io, exn });
//!   assert(out.status.success(), "echo should succeed");
//! });
//! ```
pragma(Pragma.AllowUnsafe);
open(import("../collections/array_list"));
open(import("../string"));
{ Exception, IoExn } :: import("../error");
{ IoError } :: import("../sys/errors");
IO_process :: import("../sys/process");
IO_file :: import("../sys/file");
IO_pipe :: import("../sys/pipe");
{ GlobalAllocator } :: import("../allocator");
{ malloc, free } :: GlobalAllocator;
{ stdout, fflush } :: import("../libc/stdio");
// ============================================================================
// ExitStatus
// ============================================================================
/// The result of a finished child process.
///
/// Holds the raw waitpid status code along with helpers to extract the exit
/// code and termination signal.
ExitStatus :: struct(
  /// Encoded waitpid status. Use `code()` / `signal()` helpers instead of
  /// reading this directly when possible.
  raw : i32
);
impl(
  ExitStatus,
  /// Returns the process exit code (0..255 on Unix). Returns 0 when the
  /// process was terminated by a signal.
  code : (fn(self : Self) -> i32)(
    IO_process.exit_status(self.raw)
  ),
  /// Returns the signal number that terminated the process, or 0 if the
  /// process exited normally.
  signal : (fn(self : Self) -> i32)(
    IO_process.term_signal(self.raw)
  ),
  /// Returns true if the child exited with status code 0.
  success : (fn(self : Self) -> bool)(
    (IO_process.exit_status(self.raw) == i32(0)) && (IO_process.term_signal(self.raw) == i32(0))
  )
);
// ============================================================================
// Output
// ============================================================================
/// Captured output of a child process.
///
/// Returned by `Command.output`. Holds the exit status plus the bytes captured
/// from the child's stdout and stderr.
Output :: ref(
  struct(
    status : ExitStatus,
    stdout : ArrayList(u8),
    stderr : ArrayList(u8)
  )
);
// ============================================================================
// Command
// ============================================================================
/// Builder for a child-process invocation.
///
/// Construct with `Command.new(program)`, then chain mutating builder methods
/// (`arg`, `args`, `env_clear`) before invoking `status()` or `output()`.
Command :: ref(
  struct(
    _program : String,
    _args : ArrayList(String),
    _stdin_fd : i32,
    _stdout_fd : i32,
    _stderr_fd : i32
  )
);
impl(
  Command,
  /// Create a new `Command` invoking `program`. The program name is also used
  /// as `argv[0]` unless a different first arg is pushed manually before
  /// invocation.
  new : (fn(program : String) -> Self)(
    Self(
      _program : program,
      _args : ArrayList(String).new(),
      _stdin_fd : i32(-(1)),
      _stdout_fd : i32(-(1)),
      _stderr_fd : i32(-(1))
    )
  ),
  /// Append a single argument to the argv list.
  arg : (fn(inout(self) : Self, a : String) -> unit)({
    self._args.push(a);
    ()
  }),
  /// Append multiple arguments to the argv list.
  args : (fn(inout(self) : Self, more : ArrayList(String)) -> unit)({
    n := more.len();
    i := usize(0);
    while(runtime(i < n), {
      match(
        more.get(i),
        .Some(s) => {
          self._args.push(s);
        },
        .None => ()
      );
      i = (i + usize(1));
    });
  })
);
// ============================================================================
// Internal helpers
// ============================================================================
// Convert each entry of `(program + args)` into an owned NUL-terminated
// `ArrayList(u8)`. The returned list owns the C-string storage; callers
// extract the raw `*(u8)` pointers separately.
_build_cstr_storage :: (fn(self : Command) -> ArrayList(ArrayList(u8)))({
  storage := ArrayList(ArrayList(u8)).new();
  storage.push(self._program.to_cstr());
  n := self._args.len();
  i := usize(0);
  while(runtime(i < n), {
    match(
      self._args.get(i),
      .Some(s) => {
        storage.push(s.to_cstr());
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  return(storage);
});
// Spawn the child with the given inherited/redirected fds and return the pid.
// Builds argv as a fixed `?(*(u8))` array on the heap. Caller is responsible for
// freeing `argv_buf` AND keeping `storage` alive until after `__yo_async_spawn_start`
// returns the pid (since the kernel reads argv synchronously inside the syscall).
_spawn_with_fds :: (
  fn(
    self : Command,
    stdin_fd : i32,
    stdout_fd : i32,
    stderr_fd : i32,
    io : Io
  ) -> Impl(Future(i32, IoExn))
)({
  // Build the C-string storage BEFORE entering the async closure so the
  // closure doesn't have to capture `self` directly. `self : Command` is an
  // object/ref binding that can't be safely captured across an async
  // boundary; the resulting `storage` ArrayList is Rc/heap-allocated and
  // can be moved into the closure's capture struct.
  storage := _build_cstr_storage(self);
  // Flush our own stdout BEFORE creating the child. `print`/`println` go through
  // C `fwrite(..., stdout)` (std/fmt/index.yo), which is BLOCK-buffered when
  // stdout is a pipe — while the child inherits the raw fd and writes straight
  // through. Without this flush, anything we printed first appears AFTER the
  // child's output whenever stdout is not a tty, so `yo build run | tee log`
  // prints "Building probe →" after the program's own output. `stderr` is
  // unbuffered, so it needs no flush.
  //
  // Surfaced by the CLI differential (PR #98 GATE 7): build-run, doc-html,
  // doc-json and doc-markdown all reported `rc=0; stdout` DIFFs whose line SETS
  // were identical and only the interleaving differed — the compiler's own lines
  // vs a child `git`/compiler process's.
  // `fflush` takes `?(*(FILE))` (C's `fflush(NULL)` flushes every stream), so the
  // non-optional `stdout` needs wrapping. Only stdout is flushed — the measured
  // defect — rather than passing `.None` to flush all streams.
  unsafe(fflush(.Some(stdout)));
  io.async((e) => {
    argc := storage.len();
    // Allocate argv buffer: argc entries + 1 null terminator.
    argv_bytes := (sizeof(?(*(u8))) * (argc + usize(1)));
    argv_raw := malloc(argv_bytes).unwrap();
    argv_buf := *(?(*(u8)))(argv_raw);
    // Fill argv pointers from each owning ArrayList(u8) in storage.
    j := usize(0);
    while(runtime(j < argc), {
      match(
        storage.get(j),
        .Some(cs) => match(
          cs.ptr(),
          .Some(p) => {
            (argv_buf.add(j)).* = .Some(p);
          },
          .None => {
            (argv_buf.add(j)).* = .None;
          }
        ),
        .None => {
          (argv_buf.add(j)).* = .None;
        }
      );
      j = (j + usize(1));
    });
    (argv_buf.add(argc)).* = .None;
    // Resolve program path C string (always present — _build_cstr_storage pushes program first).
    program_cstr := (argv_buf.add(usize(0))).*.unwrap();
    pid := e.io.await(IO_process.spawn(program_cstr, argv_buf, .None, stdin_fd, stdout_fd, stderr_fd), e.io);
    // Free argv buffer (storage is dropped naturally at scope end).
    free(.Some(argv_raw));
    IoError.check(pid, e.exn)
  })
});
// Read all available bytes from `fd` into a freshly returned ArrayList(u8)
// until EOF (read returns 0).
_drain_fd :: (fn(fd : i32, io : Io) -> Impl(Future(ArrayList(u8), IoExn)))(
  io.async((e) => {
    buf_size := usize(4096);
    buf := *(u8)(malloc(buf_size).unwrap());
    out := ArrayList(u8).new();
    while(runtime(true), {
      n := e.io.await(IO_file.read(fd, buf, u32(buf_size), u64(0)), e.io);
      cond(
        (n < i32(0)) => {
          free(.Some(*(void)(buf)));
          e.exn.throw(dyn(IoError.from_errno(i32(0) - n)));
        },
        (n == i32(0)) => break,
        true => {
          k := usize(0);
          while(runtime(k < usize(n)), {
            out.push((buf.add(k)).*);
            k = (k + usize(1));
          });
        }
      );
    });
    free(.Some(*(void)(buf)));
    out
  })
);
// ============================================================================
// Public Command methods (status / output)
// ============================================================================
impl(
  Command,
  /// Spawn the child with stdio inherited from the parent, wait for it to
  /// exit, and return its `ExitStatus`.
  status : (fn(self : Self, io : Io) -> Impl(Future(ExitStatus, IoExn)))(
    // `self : Self` is a value-copy of the Rc-counted Command object, so the
    // closure can freely capture it. (Was `inout(self)` previously, which is a
    // second-class reference and can't be captured across an async boundary.)
    io.async((e) => {
      pid := e.io.await(
        _spawn_with_fds(self, i32(-(1)), i32(-(1)), i32(-(1)), io),
        e
      );
      raw := e.io.await(IO_process.waitpid(pid, i32(0)), e.io);
      IoError.check(raw, e.exn);
      ExitStatus(raw : raw)
    })
  ),
  /// Spawn the child with stdout and stderr captured through pipes. Waits for
  /// the child to exit and returns the exit status plus the captured bytes.
  output : (fn(self : Self, io : Io) -> Impl(Future(Output, IoExn)))(
    // `self : Self` is a value-copy of the Rc-counted Command object; the
    // closure can freely capture it instead of needing `inout(self)`.
    io.async((e) => {
      // Create stdout and stderr pipes.
      out_fd_buf := MaybeUninit(Array(i32, usize(2))).new();
      out_fd := *(i32)(out_fd_buf.as_ptr());
      pr1 := IO_pipe.pipe(out_fd);
      cond(
        (pr1 < i32(0)) => e.exn.throw(dyn(IoError.from_errno(i32(0) - pr1))),
        true => ()
      );
      out_read := (out_fd.add(usize(0))).*;
      out_write := (out_fd.add(usize(1))).*;
      err_fd_buf := MaybeUninit(Array(i32, usize(2))).new();
      err_fd := *(i32)(err_fd_buf.as_ptr());
      pr2 := IO_pipe.pipe(err_fd);
      cond(
        (pr2 < i32(0)) => {
          e.io.await(IO_file.close(out_read), e.io);
          e.io.await(IO_file.close(out_write), e.io);
          e.exn.throw(dyn(IoError.from_errno(i32(0) - pr2)));
        },
        true => ()
      );
      err_read := (err_fd.add(usize(0))).*;
      err_write := (err_fd.add(usize(1))).*;
      // Spawn child with the write ends of both pipes.
      pid := e.io.await(
        _spawn_with_fds(self, i32(-(1)), out_write, err_write, io),
        e
      );
      // Close write ends in parent so reads see EOF when child exits.
      e.io.await(IO_file.close(out_write), e.io);
      e.io.await(IO_file.close(err_write), e.io);
      // Drain both pipes sequentially.
      stdout_buf := e.io.await(_drain_fd(out_read, io), e);
      stderr_buf := e.io.await(_drain_fd(err_read, io), e);
      e.io.await(IO_file.close(out_read), e.io);
      e.io.await(IO_file.close(err_read), e.io);
      raw := e.io.await(IO_process.waitpid(pid, i32(0)), e.io);
      IoError.check(raw, e.exn);
      Output(
        status : ExitStatus(raw : raw),
        stdout : stdout_buf,
        stderr : stderr_buf
      )
    })
  )
);
export(Command, ExitStatus, Output);
