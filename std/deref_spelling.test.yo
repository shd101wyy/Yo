// SIBLING TEST: the `.*` spelling inside std (N3 deref Generation A',
// plans/backlog/SEED_VERSION_AUTOMATION.md). std and src keep the old
// reading of a BARE reference binding until v0.2.78 migrates them: a bare
// `r` reads the value it refers to. A WRITTEN `r.*` on a reference binding
// is the reference's own deref here as everywhere else, whatever the
// referent: `r.*` on `r : &Rc(T)` is the handle, and `a.*` on `a : &T` in a
// generic body is the `T` at every specialization (Generation A, v0.2.76,
// read it as the payload or pointee whenever the specialization made `T` a
// `Box`/`Rc`/`Arc`/pointer). This file lives under std so it is judged by
// std's reading. The v0.2.76 seed compiles std but never runs this file's
// tests, because `check` and builds treat `test(...)` as a no-op and release
// bundles drop `*.test.yo`. `yo test ./std` runs it with the tree compiler.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("std/assert");

_DerefPoint :: struct(a : i32, b : i32);

test("a written r.* reads the referent of a reference binding", {
  x := i32(3);
  r := &x;
  assert(r.* == i32(3), "r.* reads the referent");
  v := r.*;
  assert(v == i32(3), "r.* binds the referent's value");
});
test("a bare read keeps the old reading beside it", {
  x := i32(4);
  r := &x;
  v := r;
  assert(v == i32(4), "a bare r still reads the referent in std");
  assert(r == r.*, "both spellings read the same value");
});
test("r.* = x writes through a &mut reference binding", {
  mut(y) := i32(1);
  w := &mut y;
  w.* = i32(5);
  assert(y == i32(5), "the write through w.* landed in y");
});
test("&r.* lends the referent", {
  x := i32(6);
  r := &x;
  q := &r.*;
  assert(q.* == i32(6), "q borrows what r borrows");
});
test("r.*.field reads a field of the referent", {
  p := _DerefPoint(a : i32(7), b : i32(8));
  pr := &p;
  assert(pr.*.a == i32(7), "r.*.field reads through the referent");
  assert(pr.b == i32(8), "the bare receiver still reads through");
});
test("match(r.*, …) matches the referent", {
  x := i32(9);
  r := &x;
  hit := match(r.*, i32(9) => true, _ => false);
  assert(hit, "match(r.*, …) sees the referent");
});
test("r.* on a &Box(T) is the handle; r.*.* is its payload", {
  bx := Box.new(i32(10));
  rb := &bx;
  n := rb.*.*;
  assert(n == i32(10), "rb.* is the Box, rb.*.* its payload");
});
_deref_first :: (fn(generic(T : Type), a : &T) -> T)(a.*);
test("a.* on a generic &T is the T at a pointer specialization", {
  x := i32(11);
  p := addr_of(x);
  q := _deref_first(&p);
  assert(q == p, "a.* is the pointer itself, not its pointee");
  assert(_deref_first(&x) == i32(11), "and the value at an i32 specialization");
});
_deref_count :: (fn(generic(T : Type), a : &Rc(T)) -> usize)(ref_count(a.*));
test("r.* on a &Rc(T) is the handle", {
  h := Rc.new(i32(12));
  h2 := Rc.clone(h);
  rh := &h;
  assert(ref_count(rh.*) == usize(2), "rh.* is the handle, counted with its clone");
  assert(_deref_count(&h2) == usize(2), "the same through a generic body");
});
test("r.* = Rc.new(...) writes the handle's slot", {
  mut(h) := Rc.new(i32(13));
  w := &mut h;
  w.* = Rc.new(i32(14));
  assert(h.* == i32(14), "the slot behind w now holds the new handle");
  bare := &h;
  v := bare.*.*;
  assert(v == i32(14), "a written deref beside it reads the same handle");
});
// The capture path's written `.*` (the seed rider of VERDICTS-60 §4, 11):
// `{ b : &b.* }` names what `{ &b }` names here, the referent of `b` whole.
// An `io.async` body that borrows a `&` parameter so keeps its own copy of
// it (plans/VALUES_BY_DEFAULT.md §3.13 A2), the spelling the deref flip
// writes in std and src
// (issues/fixed/2026-11-13-the-v0277-seed-rejects-the-deref-swept-io-async-captures-of-a-reference-parameter.md).
_DerefBox :: struct(n : i32);
_deref_box_read :: (fn(b : &_DerefBox, io : Io) -> Impl(Future(i32)))(
  io.async({ b : &b.* }(io : Io) => {
    return(b.*.n);
  })
);
test("an io.async capture `{ b : &b.* }` of a & parameter borrows the parameter whole", {
  x := _DerefBox(n : i32(11));
  assert(io.await(_deref_box_read(&x, io), io) == i32(11), "the future reads the referent it borrows");
  comptime_expect_error(
    _deref_box_field :: (fn(b : &_DerefBox, io : Io) -> Impl(Future(i32)))(
      io.async({ n : &b.*.n }(io : Io) => {
        return(n.*);
      })
    ),
    "borrows a `&` parameter whole"
  );
});
test("a closure's `{ r : &mut r.* }` borrows the referent whole while it lives", {
  mut(p) := _DerefPoint(a : i32(1), b : i32(2));
  r := &mut p;
  comptime_expect_error({
    (mut(f) : Impl(FnMut() -> i32)) = ({ r : &mut r.* }() => {
      r.*.a = (r.*.a + i32(1));
      r.*.a
    });
    _q := &r.b;
    f()
  }, "the closure `f` borrows");
  (mut(g) : Impl(FnMut() -> i32)) = ({ r : &mut r.* }() => {
    r.*.a = (r.*.a + i32(1));
    r.*.a
  });
  assert(g() == i32(2), "the closure writes through the reborrow");
  assert(p.a == i32(2), "the write landed in p");
});
