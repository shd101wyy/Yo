//! Wait for a group of tasks to complete, similar to Go's `sync.WaitGroup`.
pragma(Pragma.AllowUnsafe);
//!
//! ## Example
//!
//! ```yo
//! { WaitGroup } :: import("std/sync/waitgroup");
//! { Thread } :: import("std/thread");
//!
//! wg := Arc.new(WaitGroup.new());
//! wg.add(i32(3));
//! mut(i) := i32(0);
//! while(i < i32(3), {
//!   mine := Arc.clone(wg);
//!   _t := Thread(unit).spawn({ mine }(io : Io) => {
//!     // ... do work ...
//!     mine.done();
//!   });
//!   i = (i + i32(1));
//! });
//! wg.wait(); // blocks until all 3 tasks call done()
//! ```
//!
//! ## Stability
//!
//! unstable — the type has concurrent coverage
//! (`tests/sync/waitgroup.test.yo`) and the Go-derived names are settled,
//! but one behaviour is an unresolved divergence rather than a decision:
//! `add` CLAMPS the counter at zero, so one `done()` too many is silently
//! ignored where Go panics with "negative WaitGroup counter" — the one
//! place Go reliably catches a miscounted group.
//! `plans/archive/STD_API_STABILIZATION_FINDINGS.md` item 10 records it as a gap.
//! Freezing needs that call made (clamp, panic, or a `Result`), because
//! whichever way it goes is observable to every caller. Copying a
//! `WaitGroup` is E0901, the compile-time form of Go's "do not copy" vet
//! check: it is a move-only value, shared as `Arc(WaitGroup)`.
{ Mutex } :: import("./mutex");
{ Condvar } :: import("./condvar");
{
  atomic_int,
  __yo_atomic_load_int,
  __yo_atomic_store_int,
  memory_order_relaxed,
  memory_order_acquire,
  memory_order_release
} :: import("std/libc/stdatomic");
/// Synchronization primitive that blocks until a counter reaches zero. A
/// move-only value with its state in a private `Box`; the tasks share one as
/// `Arc(WaitGroup)`.
///
/// The internal counter is a C11 atomic (held inline: std is unsafe-capable)
/// so `count()` can read without acquiring the mutex (matches Rust's mpsc
/// query-method idiom). Writes to the counter still happen under the mutex
/// so the `_count == 0` observation that triggers `notify_all()` is
/// serialized with `wait()`.
_WaitGroupState :: struct(
  _count : atomic_int,
  _mutex : Mutex(bool),
  _cv : Condvar
);
WaitGroup :: struct(_state : Box(_WaitGroupState));
// SAFETY: the counter is written only under `_mutex` and read through C11
// atomic loads, so tasks on any thread may share the group.
impl(WaitGroup, Send());
impl(WaitGroup, Sync());
impl(
  WaitGroup,
  /// Create an empty group — counter zero, no waiters. A `wait()` on it
  /// returns immediately until something is added.
  new : (fn() -> Self)(
    Self(
      _state : Box.new(
        _WaitGroupState(
          _count : atomic_int(i32(0)),
          _mutex : Mutex(bool).new(false),
          _cv : Condvar.new()
        )
      )
    )
  ),
  // The counter in the box, read and written with C11 atomic operations.
  _count_ptr : (fn(self : &Self) -> *atomic_int)(addr_of(self._state.*._count)),
  /// Add `delta` to the counter, waking every waiter if it reaches zero —
  /// Go's `WaitGroup.Add`.
  ///
  /// Call this BEFORE spawning the tasks it counts: a `wait()` that runs
  /// while the counter is still zero returns immediately, and no later
  /// `add` can bring it back. `delta` may be negative (`done` is exactly
  /// `add(-1)`).
  ///
  /// **The counter is clamped at zero, not checked.** A `delta` that would
  /// take it below zero stores zero and broadcasts, so an extra `done()`
  /// is silently absorbed rather than panicking as Go's does — see the
  /// module's Stability note.
  ///
  /// This briefly takes the group's internal mutex, so it blocks only
  /// against another `add` or the bookkeeping of `wait`, never for the
  /// length of the tasks themselves.
  add : (fn(self : &Self, delta : i32) -> unit)({
    p := self._count_ptr();
    self._state.*._mutex._raw_lock();
    new_count := (unsafe(i32(__yo_atomic_load_int(p, memory_order_relaxed))) + delta);
    cond(
      (new_count <= i32(0)) => {
        unsafe(__yo_atomic_store_int(p, i32(0), memory_order_release));
        self._state.*._cv.notify_all();
      },
      true => {
        unsafe(__yo_atomic_store_int(p, new_count, memory_order_release));
      }
    );
    self._state.*._mutex._raw_unlock();
  }),
  /// Mark one counted task finished — Go's `WaitGroup.Done`, and exactly
  /// `add(-1)`, including the clamp at zero.
  done : (fn(self : &Self) -> unit)(
    self.add(i32(-1))
  ),
  /// Block until the counter reaches zero — Go's `WaitGroup.Wait`.
  ///
  /// Returns immediately when the counter is already zero, which includes
  /// the case of a group nothing was ever added to. Several threads may
  /// wait at once; the zero is announced with a `notify_all`, so all of
  /// them wake. The predicate is re-checked in a loop, so a spurious
  /// condvar wake cannot end the wait early.
  ///
  /// This is a BLOCKING (OS-thread) wait, not an `io.await` — it parks the
  /// calling thread, so calling it on the event-loop thread stalls every
  /// async task in the program. Use it from a thread that owns its own
  /// work.
  wait : (fn(self : &Self) -> unit)({
    p := self._count_ptr();
    self._state.*._mutex._raw_lock();
    while(unsafe(i32(__yo_atomic_load_int(p, memory_order_acquire))) > i32(0), {
      self._state.*._cv.wait_with(&self._state.*._mutex);
    });
    self._state.*._mutex._raw_unlock();
  }),
  /// How many counted tasks are still outstanding, as a lock-free Acquire
  /// load — no mutex is taken.
  ///
  /// Advisory only: another thread can change it between the load and the
  /// next line, so branching on `count() == 0` instead of calling `wait()`
  /// is a race. It exists for diagnostics and progress reporting.
  count : (fn(self : &Self) -> i32)(
    unsafe(i32(__yo_atomic_load_int(self._count_ptr(), memory_order_acquire)))
  )
);
export(WaitGroup);
