//! Reader-writer lock allowing multiple concurrent readers or one exclusive
//! writer.
//!
//! Phase D (THREAD_SAFETY): `RwLock(T)` is parameterized over the protected
//! data and access is granted only through a closure, exactly like
//! `Mutex(T).with_lock`:
//!
//! - `with_read(body)` binds the protected value BY VALUE, so for a value `T`
//!   the body gets a copy and its writes never reach the shared cell. Yo has
//!   no read-only binding mode, so for a `ref(...)` `T` — where the copy
//!   shares the same object — read-only-ness is a convention, not an enforced
//!   rule. Do NOT assign to the parameter: that currently degenerates in the
//!   evaluator (see
//!   issues/assign-to-by-value-closure-param-under-generic-result-types-unit.md).
//! - `with_write(body)` binds `v : &mut T`, so writes land in the protected
//!   cell.
//!
//! The private `__RwLockReadUnlocker` / `__RwLockWriteUnlocker` objects
//! release the lock from their `Drop` impl, so the release happens on a
//! normal return, on an early `return`, and on an `unwind` alike.
//!
//! ## Example
//!
//! ```yo
//! { RwLock } :: import("std/sync/rwlock");
//!
//! lock := RwLock(i32).new(i32(0));
//!
//! // Many readers may hold the lock at the same time.
//! value := lock.with_read(v => v);
//!
//! // One writer at a time, excluding every reader.
//! bumped := lock.with_write(v => {
//!   v = (v + i32(1));
//!   v
//! });
//! ```
//!
//! A body may end in a VALUE or in a STATEMENT — the latter binds the
//! callback's generic `R` to unit, which used to emit `void* tmp = <void call>`
//! and fail to C-compile (the same hole was in `Mutex.with_lock`). Fixed
//! 2026-08-26:
//! issues/fixed/generic-r-callback-with-unit-closure-emits-void-star-temp.md.
//!
//! ## Stability
//!
//! unstable — `try_with_read` / `try_with_write` landed 2026-09-10 and the
//! file has 22 passing cases, but two properties of this surface are still
//! open questions rather than decisions.
//!
//! First, READ-ONLY-NESS IS NOT ENFORCED. `with_read` binds the value by
//! value because Yo has no read-only binding mode; for a `ref(...)` `T`
//! that copy shares the same object, so a body that mutates through it
//! mutates shared data while holding only a read lock — and assigning to
//! the parameter degenerates in the evaluator
//! (issues/assign-to-by-value-closure-param-under-generic-result-types-unit.md).
//! Freezing `with_read` means either a language-level read-only binding or
//! a different signature.
//!
//! Second, the lock is READER-PREFERRING and can starve a writer:
//! `_rw_read_lock` waits only while a writer HOLDS the lock, not while one
//! is queued, so an unbroken stream of readers never lets a waiting writer
//! in. Rust's `RwLock` leaves the fairness to the OS primitive and says so;
//! this one implements the policy itself, so the policy is part of the API
//! and has to be chosen deliberately before it can be frozen.
pragma(Pragma.AllowUnsafe);

{ Mutex } :: import("./mutex");
{ Cond } :: import("./cond");

/// Reader-writer lock built on `Mutex` and `Cond`, owning the protected `T`.
/// A move-only value with its state in a private `Box`; threads share one as
/// `Arc(RwLock(T))`.
///
/// The lock bookkeeping is a non-generic core, so the unlockers and the
/// acquire/release functions below are written once, over a raw pointer to
/// it (a `&Self` receiver is the caller's copy, never its address).
_RwCore :: struct(
  _readers : i32,
  _writer : bool,
  _mutex : Mutex(bool),
  _read_cv : Cond,
  _write_cv : Cond
);
_RwLockState :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _core : _RwCore,
    _value : T
  )
);
RwLock :: (fn(comptime(T) : Type, where(T <: (Send, Sync))) -> comptime(Type))(
  struct(_state : Box(_RwLockState(T)))
);
// SAFETY: the bookkeeping is read and written only under `_mutex`; the value
// is read under a shared acquisition (hence `T <: Sync`) and written under an
// exclusive one, and it may be dropped on any thread (hence `T <: Send`).
impl(generic(T : Type), where(T <: (Send, Sync)), RwLock(T), Send());
impl(generic(T : Type), where(T <: (Send, Sync)), RwLock(T), Sync());

// Acquire a read lock. Blocks while a writer holds the lock.
_rw_read_lock :: (fn(c : *_RwCore) -> unit)(
  unsafe({
    c.*._mutex._raw_lock();
    while(c.*._writer, {
      c.*._read_cv.wait_with(&c.*._mutex);
    });
    consume(c.*._readers = (c.*._readers + i32(1)));
    c.*._mutex._raw_unlock();
  })
);
// Take a read lock only if no writer holds one. True when taken.
//
// The `_writer` test and the `_readers` increment happen under the same
// internal-mutex acquisition, so a writer cannot slip in between them.
_rw_try_read_lock :: (fn(c : *_RwCore) -> bool)(
  unsafe({
    c.*._mutex._raw_lock();
    took := cond(
      c.*._writer => false,
      true => {
        consume(c.*._readers = (c.*._readers + i32(1)));
        true
      }
    );
    c.*._mutex._raw_unlock();
    took
  })
);
// Take a write lock only if no reader and no writer holds one. True when
// taken.
_rw_try_write_lock :: (fn(c : *_RwCore) -> bool)(
  unsafe({
    c.*._mutex._raw_lock();
    took := cond(
      (c.*._writer || (c.*._readers > i32(0))) => false,
      true => {
        consume(c.*._writer = true);
        true
      }
    );
    c.*._mutex._raw_unlock();
    took
  })
);
// Release a read lock.
_rw_read_unlock :: (fn(c : *_RwCore) -> unit)(
  unsafe({
    c.*._mutex._raw_lock();
    consume(c.*._readers = (c.*._readers - i32(1)));
    cond(
      (c.*._readers == i32(0)) => c.*._write_cv.signal(),
      true => ()
    );
    c.*._mutex._raw_unlock();
  })
);
// Acquire a write lock. Blocks while readers or a writer hold the lock.
_rw_write_lock :: (fn(c : *_RwCore) -> unit)(
  unsafe({
    c.*._mutex._raw_lock();
    while(c.*._writer || (c.*._readers > i32(0)), {
      c.*._write_cv.wait_with(&c.*._mutex);
    });
    consume(c.*._writer = true);
    c.*._mutex._raw_unlock();
  })
);
// Release a write lock.
//
// Wake BOTH waiting sets. The previous form picked one:
//
//     cond((_readers > i32(0)) => _read_cv.broadcast(),
//          true                => _write_cv.signal());
//
// and its reader arm was UNREACHABLE. The exclusion invariant guarantees
// `_readers == 0` here: `_rw_read_lock` blocks while `_writer` is set, so
// no reader can have incremented `_readers` while this writer held the lock,
// and `_rw_write_lock` only proceeds once `_readers == 0`. So the test was
// always false and only `_write_cv.signal()` ever ran — readers blocked in
// `_read_cv.wait` were never woken by the writer at all, and escaped only on
// a pthread SPURIOUS wakeup, which is what made this look like it worked.
//
// A releasing writer cannot know which set is waiting, so it must notify
// both: broadcast to every blocked reader (they can all proceed together)
// and signal one blocked writer (only one can proceed). Both predicates are
// re-checked in `while` loops, so the extra wakeups are safe.
_rw_write_unlock :: (fn(c : *_RwCore) -> unit)(
  unsafe({
    c.*._mutex._raw_lock();
    consume(c.*._writer = false);
    c.*._read_cv.broadcast();
    c.*._write_cv.signal();
    c.*._mutex._raw_unlock();
  })
);

// __RwLockReadUnlocker / __RwLockWriteUnlocker — private objects that release
// the corresponding acquisition on Drop. Allocated locally inside
// with_read / with_write; Yo's drop-on-scope-exit and drop-on-unwind machinery
// guarantees the release under a normal return and an unwind(...) alike.
// Mirrors `__MutexUnlocker` in ./mutex. Each points at the core in the lock's
// box, which the `with_*` call borrows for the unlocker's whole life.
__RwLockReadUnlocker :: struct(_core : *_RwCore);
impl(
  __RwLockReadUnlocker,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _rw_read_unlock(self._core);
    })
  )
);

__RwLockWriteUnlocker :: struct(_core : *_RwCore);
impl(
  __RwLockWriteUnlocker,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      _rw_write_unlock(self._core);
    })
  )
);

impl(
  generic(T : Type),
  where(T <: (Send, Sync)),
  RwLock(T),
  /// Create a new reader-writer lock protecting `value`.
  new : (fn(value : T) -> Self)(
    Self(
      _state : Box.new(
        _RwLockState(T)(
          _core : _RwCore(
            _readers : i32(0),
            _writer : false,
            _mutex : Mutex(bool).new(false),
            _read_cv : Cond.new(),
            _write_cv : Cond.new()
          ),
          _value : value
        )
      )
    )
  ),
  /// Run `body` under a SHARED acquisition. Several readers may be inside
  /// `with_read` at once; no writer can be. `body` receives the protected
  /// value BY VALUE — for a value `T` its writes stay in the body's own copy.
  with_read : (
    fn(
      generic(R : Type),
      self : &Self,
      body : &mut Impl(FnMut(v : &T) -> R)
    ) -> R
  )({
    c := self._core_ptr();
    _rw_read_lock(c);
    _guard := __RwLockReadUnlocker(_core : c);
    vp := self._value_ptr();
    body(&unsafe(vp.*))
  }),
  /// Run `body` under an EXCLUSIVE acquisition. No other reader or writer can
  /// be inside the lock. `body` receives `v : &mut T`, so its writes land in
  /// the protected cell.
  with_write : (
    fn(
      generic(R : Type),
      self : &Self,
      body : &mut Impl(FnMut(v : &mut T) -> R)
    ) -> R
  )({
    c := self._core_ptr();
    _rw_write_lock(c);
    _guard := __RwLockWriteUnlocker(_core : c);
    vp := self._value_ptr();
    body(&mut unsafe(vp.*))
  }),
  /// Run `body` under a SHARED acquisition IF one can be taken without
  /// waiting, and return `.Some(result)`; `.None` when a writer holds the
  /// lock. Rust's `try_read`, in this type's closure-scoped shape.
  ///
  /// Note this did NOT need the runtime's `__yo_mutex_trylock`, which the plan
  /// assumed it would. `try_read` has to test `_writer`, and that test happens
  /// under the SHORT internal mutex, which is held only for the length of a
  /// few field reads and never across a wait. Blocking on it is bounded and
  /// unrelated to how long a reader or writer holds the RwLock itself — so the
  /// non-blocking part is skipping the condvar wait, not skipping the mutex.
  try_with_read : (
    fn(
      generic(R : Type),
      self : &Self,
      body : &mut Impl(FnMut(v : &T) -> R)
    ) -> Option(R)
  )(
    cond(
      !_rw_try_read_lock(self._core_ptr()) => Option(R).None,
      true => {
        _guard := __RwLockReadUnlocker(_core : self._core_ptr());
        vp := self._value_ptr();
        Option(R).Some(body(&unsafe(vp.*)))
      }
    )
  ),
  /// Run `body` under an EXCLUSIVE acquisition IF one can be taken without
  /// waiting, and return `.Some(result)`; `.None` when any reader or a writer
  /// holds the lock. Rust's `try_write`.
  ///
  /// **A single concurrent reader is enough to make this `.None`** — an
  /// exclusive acquisition excludes readers too, so this fails far more often
  /// than `try_with_read` under a read-heavy load. Do not spin on it: a writer
  /// polling against a stream of readers can be starved indefinitely, which is
  /// exactly what the blocking `with_write` avoids by parking in the queue.
  try_with_write : (
    fn(
      generic(R : Type),
      self : &Self,
      body : &mut Impl(FnMut(v : &mut T) -> R)
    ) -> Option(R)
  )(
    cond(
      !_rw_try_write_lock(self._core_ptr()) => Option(R).None,
      true => {
        _guard := __RwLockWriteUnlocker(_core : self._core_ptr());
        vp := self._value_ptr();
        Option(R).Some(body(&mut unsafe(vp.*)))
      }
    )
  ),
  // The core and the value in the box. Private to std/sync (member
  // visibility); the acquire/release functions above take the core.
  _core_ptr : (fn(self : &Self) -> *_RwCore)(addr_of(self._state.*._core)),
  _value_ptr : (fn(self : &Self) -> *T)(addr_of(self._state.*._value))
);

export(RwLock);
