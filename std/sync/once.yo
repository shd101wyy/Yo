//! One-time initialization primitives.
//!
//! `Once` runs a side-effecting closure exactly once; `OnceCell(T)` stores the
//! value that closure produced and hands it back on every later call.
//!
//! ## Example
//!
//! ```yo
//! { Once, OnceCell } :: import("std/sync/once");
//!
//! init := Once.new();
//! // Only the first call executes the function
//! init.call(() => {
//!   println("initialized!");
//! });
//! init.call(() => {
//!   println("this will NOT run");
//! });
//!
//! cell := OnceCell(i32).new();
//! a := cell.get_or_init(() => i32(42)); // runs the closure
//! b := cell.get_or_init(() => i32(99)); // lends the stored 42, closure not run
//! assert(b.* == i32(42), "get_or_init returns a &T into the cell");
//! ```
//!
//! ## Stability
//!
//! unstable — the mechanism is settled (double-checked locking over
//! `Mutex.with_lock`, concurrently tested in `tests/sync/once.test.yo`),
//! but one NAME is wrong against the Rust vocabulary the rest of this
//! library follows: `OnceCell(T)` here is thread-safe, which is Rust's
//! `OnceLock<T>`, while Rust's `OnceCell<T>` is the single-threaded one.
//! Renaming it — or adding a genuinely single-threaded cell beside it — is
//! a live question, so the name is not frozen. `LazyLock`'s counterpart is
//! also still missing (`plans/archive/STD_API_STABILIZATION_FINDINGS.md` item 10);
//! that one is additive. Neither type has poisoning: an initializer that
//! exits early leaves the `Once` un-done and the next caller retries.
pragma(Pragma.AllowUnsafe);

{ Mutex } :: import("./mutex");
{
  atomic_bool,
  atomic_load_explicit,
  atomic_store_explicit,
  memory_order_relaxed,
  memory_order_acquire,
  memory_order_release
} :: import("std/libc/stdatomic");

/// Execute a function exactly once, thread-safely. A move-only value with
/// its state in a private `Box`; threads share one as `Arc(Once)`.
_OnceState :: struct(
  _done : atomic_bool,
  _mutex : Mutex(bool)
);
Once :: struct(_state : Box(_OnceState));
// SAFETY: `_done` is a C11 atomic and the initializer runs under `_mutex`, so
// threads may share the `Once`.
impl(Once, Send());
impl(Once, Sync());
impl(
  Once,
  /// Create a `Once` that has not run yet — Rust's `Once::new`.
  new : (fn() -> Self)({
    v := Self(_state : Box.new(_OnceState(_done : atomic_bool(false), _mutex : Mutex(bool).new(false))));
    unsafe(atomic_store_explicit(addr_of(v._state.*._done), false, memory_order_release));
    v
  }),
  // The slow path runs under `Mutex.with_lock` rather than a manual
  // `_raw_lock` / `_raw_unlock` pair. This was long carried as a NOTE saying
  // the pair could leave the mutex held forever if `f` unwound; that claim is
  // WRONG and is corrected here. `f` is an `Impl(FnMut() -> unit)`, and a closure
  // cannot capture an `Exception` ("Closures cannot capture a value of
  // control-bound type"), so `f` has no way to throw past this frame — the
  // leak was never reachable.
  //
  // The rewrite is still the right code, for two reasons that survive:
  //   - the guarantee is now STRUCTURAL (`__MutexUnlocker`'s `Drop`) rather
  //     than resting on `f`'s signature continuing to be un-throwable;
  //   - it removes three `_raw_lock`/`_raw_unlock` call sites, which the
  //     "take the raw handle off the public surface" row needs gone.
  //
  // It was blocked until now on a C-codegen bug — a
  // `fn(generic(R), body : Impl(Fn(...) -> R)) -> R` specialized at `R = unit`
  // emitted `void* tmp = closure(...)` against a `void`-returning C function
  // (issues/fixed/generic-r-callback-with-unit-closure-emits-void-star-temp.md,
  // fixed 2026-08-26 and shipped in the v0.2.29 seed).
  /// Run `f` the first time this is called, and never again — Rust's
  /// `Once::call_once`.
  ///
  /// Every later call is a no-op, and a call that arrives WHILE another
  /// thread is running `f` blocks until that `f` returns, so `f` has
  /// finished for every caller that this returns to. The already-done case
  /// costs one Acquire load and takes no lock.
  ///
  /// `_done` is set only after `f` RETURNS, so an `f` that exits early
  /// leaves the `Once` un-done and the next caller runs it again. That is
  /// the one divergence from Rust, which poisons a `Once` whose closure
  /// panicked and then propagates the panic to every later `call_once`: Yo
  /// has no poisoned state, and marking a half-finished initialization
  /// "done" would be worse than retrying it.
  ///
  /// `f` cannot throw — a closure cannot capture an `Exception` — so there
  /// is no "the mutex stayed locked" case to worry about; release is
  /// structural through `Mutex.with_lock` either way.
  call : (fn(self : &Self, f : &mut Impl(FnMut() -> unit)) -> unit)({
    // Fast path: already done (atomic_bool with Acquire load), no lock taken.
    cond(
      (unsafe(atomic_load_explicit(self._done_ptr(), memory_order_acquire)) == true) => (),
      // Re-entry from inside `f` (rule D5): the initializer runs under
      // `_mutex`, so "this thread holds the mutex" IS "this thread is inside
      // f". Asked here rather than left to the mutex's own self-relock trap
      // so the message names this API — and it needs no extra state to
      // clear on an early exit from `f`, which the mutex guard already
      // handles (issues/fixed/once-re-entered-from-its-own-closure-deadlocks-on-posix-and-double-runs-on-windows.md).
      self._state.*._mutex._held_by_current_thread() => __yo_panic("Once.call: re-entered from its own initializer"),
      true =>
        // The closure reaches the flag through the box: the `Once` is
        // move-only, and the box outlives this call.
        self._state.*._mutex.with_lock({ done : self._done_ptr(), f : &mut f.* }(_guarded) => {
          // Double-check under the lock: another thread may have finished
          // between the fast-path load and the acquisition.
          cond(
            (unsafe(atomic_load_explicit(done, memory_order_relaxed)) == true) => (),
            true => {
              f();
              unsafe(atomic_store_explicit(done, true, memory_order_release));
            }
          );
        })
    );
  }),
  /// Whether the closure has already run to completion — Rust's
  /// `Once::is_completed`.
  ///
  /// A lock-free Acquire load, so it is cheap, and it is honest in the
  /// direction that matters: `true` means the initialization is finished
  /// and its writes are visible to this thread. `false` can be stale the
  /// instant it is read — another thread may be inside `f` — so do not use
  /// it to decide whether `call` will block.
  is_done : (fn(self : &Self) -> bool)(
    unsafe(atomic_load_explicit(self._done_ptr(), memory_order_acquire)) == true
  ),
  // The completion flag in the box.
  _done_ptr : (fn(self : &Self) -> *atomic_bool)(addr_of(self._state.*._done))
);

/// A cell initialized at most once, thread-safely — the value-carrying
/// counterpart of `Once` (Rust's `OnceLock`).
///
/// `Once` itself stores nothing but its completion flag, so it cannot hand a
/// value back; `OnceCell(T)` adds the storage and reuses `Once` for the
/// double-checked-locking protocol. The Release-store that publishes `_done`
/// happens after `_value` is written, and every read goes through an
/// Acquire-load of `_done` first, so a thread that observes an initialized
/// cell also observes the value the initializer wrote.
///
/// A move-only value with its state in a private `Box`; threads share one as
/// `Arc(OnceCell(T))`.
_OnceCellState :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _once : Once,
    _value : Option(T)
  )
);
OnceCell :: (fn(comptime(T) : Type, where(T <: Send)) -> comptime(Type))(
  struct(_state : Box(_OnceCellState(T)))
);
// SAFETY: `_value` is written once, by the initializer under the `Once`'s
// mutex, before the Release-store of `_done`; every read follows an
// Acquire-load of `_done`. So threads may share the cell whenever `T` may be
// moved between them (the initializing thread's value is read by the others).
impl(generic(T : Type), where(T <: Send), OnceCell(T), Send());
impl(generic(T : Type), where(T <: Send), OnceCell(T), Sync());
impl(
  generic(T : Type),
  where(T <: Send),
  OnceCell(T),
  /// Create an empty cell.
  new : (fn() -> Self)(
    Self(
      _state : Box.new(
        _OnceCellState(T)(
          _once : Once.new(),
          _value : Option(T).None
        )
      )
    )
  ),
  /// Store `f()` unless the cell already holds a value. `f` runs at most once
  /// across all threads; every other caller blocks until it finishes.
  _init : (fn(self : &Self, f : &mut Impl(FnMut() -> T)) -> unit)({
    // The closure writes the value through a raw pointer to the state: the
    // receiver is lent to `call` already, and lending it again to the closure
    // would be decision 28's argument exclusivity (E0910).
    st := addr_of(self._state.*);
    self._state.*._once.call({ st, f : &mut f.* }() => {
      unsafe(consume(st.*._value = Option(T).Some(f())));
    });
  }),
  /// Return a reference to the stored value, initializing it with `f` if this
  /// is the first call. `f` runs at most once across all threads; every other
  /// caller blocks until it finishes and then sees its value. The value stays
  /// in the cell, so a move-only `T` is read in place, as Rust's
  /// `OnceLock::get_or_init` lends it.
  ///
  /// The result's origin is the receiver alone (`-> &(T, self)`): the
  /// initializer is released when the call returns, so a capture it wrote is
  /// readable again while the returned reference lives.
  get_or_init : (fn(self : &Self, f : &mut Impl(FnMut() -> T)) -> &(T, self))({
    self._init(f);
    match(
      &self._state.*._value,
      .Some(v) => &v.*,
      .None => __yo_panic("OnceCell: initialized flag published without a value")
    )
  }),
  /// Return a reference to the stored value, or `None` if the cell has not
  /// been initialized. Never runs an initializer.
  get : (fn(self : &Self) -> Option(&T))(
    cond(
      self._state.*._once.is_done() => match(&self._state.*._value, .Some(v) => Option(&T).Some(v), .None => Option(&T).None),
      true => Option(&T).None
    )
  ),
  /// Whether the cell holds a value.
  is_initialized : (fn(self : &Self) -> bool)(
    self._state.*._once.is_done()
  )
);

export(Once, OnceCell);
