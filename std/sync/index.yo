//! Synchronization: atomics, locks, condition variables, latches, one-time initialization and the blocking channel.
//!
//! A re-export barrel: `{ X } :: import("std/sync")` and `{ X } :: import("std/sync/<module>")` name the same `X`.
//! It defines nothing of its own and lists the modules' public names only, so a module's `_`-prefixed
//! helpers and compiler-facing symbols do not cross the boundary.
{ AtomicBool, AtomicI8, AtomicI16, AtomicI32, AtomicI64, AtomicU8, AtomicU16, AtomicU32, AtomicU64, AtomicUsize, AtomicIsize, MemoryOrder, fence } :: import("./atomic.yo");
{ Barrier } :: import("./barrier.yo");
{ TryRecvError, Sender, Receiver, Channel } :: import("./channel.yo");
{ Cond } :: import("./cond.yo");
{ Mutex, RawMutex } :: import("./mutex.yo");
{ Once, OnceCell } :: import("./once.yo");
{ RefCell } :: import("./refcell.yo");
{ RwLock } :: import("./rwlock.yo");
{ Semaphore } :: import("./semaphore.yo");
{ WaitGroup } :: import("./waitgroup.yo");
export(AtomicBool, AtomicI8, AtomicI16, AtomicI32, AtomicI64, AtomicU8, AtomicU16, AtomicU32, AtomicU64, AtomicUsize, AtomicIsize, MemoryOrder, fence, Barrier, TryRecvError, Sender, Receiver, Channel, Cond, Mutex, RawMutex, Once, OnceCell, RefCell, RwLock, Semaphore, WaitGroup);
