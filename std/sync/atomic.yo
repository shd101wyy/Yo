    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current + value, order, read);
    });
    current
  }),
  /// Subtract `value`, returning the PREVIOUS value. Wraps on underflow.
  fetch_sub : (fn(self : Self, value : u64, order : MemoryOrder) -> u64)({
    read := _read_order(order);
    (current : u64) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current - value, order, read);
    });
    current
  }),
  /// Bitwise-AND with `value`, returning the PREVIOUS value.
  fetch_and : (fn(self : Self, value : u64, order : MemoryOrder) -> u64)({
    read := _read_order(order);
    (current : u64) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current & value, order, read);
    });
    current
  }),
  /// Bitwise-OR with `value`, returning the PREVIOUS value.
  fetch_or : (fn(self : Self, value : u64, order : MemoryOrder) -> u64)({
    read := _read_order(order);
    (current : u64) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current | value, order, read);
    });
    current
  }),
  /// Bitwise-XOR with `value`, returning the PREVIOUS value.
  fetch_xor : (fn(self : Self, value : u64, order : MemoryOrder) -> u64)({
    read := _read_order(order);
    (current : u64) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current ^ value, order, read);
    });
    current
  }),
  /// Store the smaller of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic min, so this is a compare-exchange
  /// loop — lock-free, and it only costs a retry under contention.
  fetch_min : (fn(self : Self, value : u64, order : MemoryOrder) -> u64)({
    read := _read_order(order);
    (current : u64) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current < value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  }),
  /// Store the larger of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic max; see `fetch_min`.
  fetch_max : (fn(self : Self, value : u64, order : MemoryOrder) -> u64)({
    read := _read_order(order);
    (current : u64) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current > value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  })
);

// ============================================================================
// AtomicUsize
// ============================================================================
AtomicUsize :: atomic(ref(struct((*) : atomic_size_t)));
impl(
  AtomicUsize,
  /// A new atomic holding `value`. The initializing store is `release`,
  /// so the value is visible to any thread that acquires the handle.
  new : (fn(value : usize) -> Self)({
    v := Self(usize(0));
    unsafe(__yo_atomic_store_size_t(&(v.*), value, memory_order_release));
    v
  }),
  /// Read the current value. PANICS on `Release`/`AcqRel`, which C11 does
  /// not permit on a load.
  load : (fn(self : Self, order : MemoryOrder) -> usize)(
    unsafe(usize(__yo_atomic_load_size_t(&(self.*), _load_order(order).to_c_order())))
  ),
  /// Replace the current value. PANICS on `Acquire`/`AcqRel`, which C11 does
  /// not permit on a store.
  store : (fn(self : Self, value : usize, order : MemoryOrder) -> unit)(
    unsafe(__yo_atomic_store_size_t(&(self.*), value, _store_order(order).to_c_order()))
  ),
  /// Replace the value and return what it held before — C11
  /// `atomic_exchange`, Rust's `swap`.
  swap : (fn(self : Self, value : usize, order : MemoryOrder) -> usize)(
    unsafe(usize(__yo_atomic_exchange_size_t(&(self.*), value, order.to_c_order())))
  ),
  /// Store `new_value` only if the current value equals `expected`, and
  /// report whether it did — C11 `atomic_compare_exchange_strong`.
  ///
  /// STRONG: it never fails spuriously. On failure `expected` is written back
  /// with the value the object actually held, which is what makes the usual
  /// retry loop terminate without a second load. `success` orders the store,
  /// `failure` orders the load taken when nothing is stored — and `failure`
  /// PANICS on `Release`/`AcqRel`, since that path only reads.
  compare_exchange : (
    fn(
      self : Self,
      inout(expected) : usize,
      new_value : usize,
      success : MemoryOrder,
      failure : MemoryOrder
    ) -> bool
  )(
    unsafe(
      __yo_atomic_compare_exchange_size_t(
        &(self.*),
        &expected,
        new_value,
        success.to_c_order(),
        _failure_order(failure).to_c_order()
      )
    )
  ),
  /// Add `value`, returning the PREVIOUS value. Wraps on overflow, as C11
  /// `atomic_fetch_add` does.
  fetch_add : (fn(self : Self, value : usize, order : MemoryOrder) -> usize)({
    read := _read_order(order);
    (current : usize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current + value, order, read);
    });
    current
  }),
  /// Subtract `value`, returning the PREVIOUS value. Wraps on underflow.
  fetch_sub : (fn(self : Self, value : usize, order : MemoryOrder) -> usize)({
    read := _read_order(order);
    (current : usize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current - value, order, read);
    });
    current
  }),
  /// Bitwise-AND with `value`, returning the PREVIOUS value.
  fetch_and : (fn(self : Self, value : usize, order : MemoryOrder) -> usize)({
    read := _read_order(order);
    (current : usize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current & value, order, read);
    });
    current
  }),
  /// Bitwise-OR with `value`, returning the PREVIOUS value.
  fetch_or : (fn(self : Self, value : usize, order : MemoryOrder) -> usize)({
    read := _read_order(order);
    (current : usize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current | value, order, read);
    });
    current
  }),
  /// Bitwise-XOR with `value`, returning the PREVIOUS value.
  fetch_xor : (fn(self : Self, value : usize, order : MemoryOrder) -> usize)({
    read := _read_order(order);
    (current : usize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current ^ value, order, read);
    });
    current
  }),
  /// Store the smaller of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic min, so this is a compare-exchange
  /// loop — lock-free, and it only costs a retry under contention.
  fetch_min : (fn(self : Self, value : usize, order : MemoryOrder) -> usize)({
    read := _read_order(order);
    (current : usize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current < value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  }),
  /// Store the larger of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic max; see `fetch_min`.
  fetch_max : (fn(self : Self, value : usize, order : MemoryOrder) -> usize)({
    read := _read_order(order);
    (current : usize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current > value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  })
);

// ============================================================================
// AtomicIsize
// ============================================================================
AtomicIsize :: atomic(ref(struct((*) : atomic_ptrdiff_t)));
impl(
  AtomicIsize,
  /// A new atomic holding `value`. The initializing store is `release`,
  /// so the value is visible to any thread that acquires the handle.
  new : (fn(value : isize) -> Self)({
    v := Self(isize(0));
    unsafe(__yo_atomic_store_ptrdiff(&(v.*), value, memory_order_release));
    v
  }),
  /// Read the current value. PANICS on `Release`/`AcqRel`, which C11 does
  /// not permit on a load.
  load : (fn(self : Self, order : MemoryOrder) -> isize)(
    unsafe(isize(__yo_atomic_load_ptrdiff(&(self.*), _load_order(order).to_c_order())))
  ),
  /// Replace the current value. PANICS on `Acquire`/`AcqRel`, which C11 does
  /// not permit on a store.
  store : (fn(self : Self, value : isize, order : MemoryOrder) -> unit)(
    unsafe(__yo_atomic_store_ptrdiff(&(self.*), value, _store_order(order).to_c_order()))
  ),
  /// Replace the value and return what it held before — C11
  /// `atomic_exchange`, Rust's `swap`.
  swap : (fn(self : Self, value : isize, order : MemoryOrder) -> isize)(
    unsafe(isize(__yo_atomic_exchange_ptrdiff(&(self.*), value, order.to_c_order())))
  ),
  /// Store `new_value` only if the current value equals `expected`, and
  /// report whether it did — C11 `atomic_compare_exchange_strong`.
  ///
  /// STRONG: it never fails spuriously. On failure `expected` is written back
  /// with the value the object actually held, which is what makes the usual
  /// retry loop terminate without a second load. `success` orders the store,
  /// `failure` orders the load taken when nothing is stored — and `failure`
  /// PANICS on `Release`/`AcqRel`, since that path only reads.
  compare_exchange : (
    fn(
      self : Self,
      inout(expected) : isize,
      new_value : isize,
      success : MemoryOrder,
      failure : MemoryOrder
    ) -> bool
  )(
    unsafe(
      __yo_atomic_compare_exchange_ptrdiff(
        &(self.*),
        &expected,
        new_value,
        success.to_c_order(),
        _failure_order(failure).to_c_order()
      )
    )
  ),
  /// Add `value`, returning the PREVIOUS value. Wraps on overflow, as C11
  /// `atomic_fetch_add` does.
  fetch_add : (fn(self : Self, value : isize, order : MemoryOrder) -> isize)({
    read := _read_order(order);
    (current : isize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current + value, order, read);
    });
    current
  }),
  /// Subtract `value`, returning the PREVIOUS value. Wraps on underflow.
  fetch_sub : (fn(self : Self, value : isize, order : MemoryOrder) -> isize)({
    read := _read_order(order);
    (current : isize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current - value, order, read);
    });
    current
  }),
  /// Bitwise-AND with `value`, returning the PREVIOUS value.
  fetch_and : (fn(self : Self, value : isize, order : MemoryOrder) -> isize)({
    read := _read_order(order);
    (current : isize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current & value, order, read);
    });
    current
  }),
  /// Bitwise-OR with `value`, returning the PREVIOUS value.
  fetch_or : (fn(self : Self, value : isize, order : MemoryOrder) -> isize)({
    read := _read_order(order);
    (current : isize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current | value, order, read);
    });
    current
  }),
  /// Bitwise-XOR with `value`, returning the PREVIOUS value.
  fetch_xor : (fn(self : Self, value : isize, order : MemoryOrder) -> isize)({
    read := _read_order(order);
    (current : isize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current ^ value, order, read);
    });
    current
  }),
  /// Store the smaller of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic min, so this is a compare-exchange
  /// loop — lock-free, and it only costs a retry under contention.
  fetch_min : (fn(self : Self, value : isize, order : MemoryOrder) -> isize)({
    read := _read_order(order);
    (current : isize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current < value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  }),
  /// Store the larger of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic max; see `fetch_min`.
  fetch_max : (fn(self : Self, value : isize, order : MemoryOrder) -> isize)({
    read := _read_order(order);
    (current : isize) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current > value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  })
);

/// Establish a memory fence with `order` on the calling thread.
///
/// Lowers to C11 `atomic_thread_fence`. An atomic operation's own ordering
/// constrains accesses around THAT object; a fence constrains every prior and
/// subsequent memory access of the calling thread, so it is what pairs a
/// `Relaxed` store on one thread with a `Relaxed` load on another.
fence :: (fn(order : MemoryOrder) -> unit)(
  unsafe(atomic_thread_fence(order.to_c_order()))
);

export(
  AtomicBool,
  AtomicI8,
  AtomicI16,
  AtomicI32,
  AtomicI64,
  AtomicU8,
  AtomicU16,
  AtomicU32,
  AtomicU64,
  AtomicUsize,
  AtomicIsize,
  MemoryOrder,
  fence
);
