// AtomicI16
// ============================================================================
AtomicI16 :: atomic(ref(struct((*) : atomic_short)));
impl(
  AtomicI16,
  /// A new atomic holding `value`. The initializing store is `release`,
  /// so the value is visible to any thread that acquires the handle.
  new : (fn(value : i16) -> Self)({
    v := Self(i16(0));
    unsafe(__yo_atomic_store_short(&(v.*), value, memory_order_release));
    v
  }),
  /// Read the current value. PANICS on `Release`/`AcqRel`, which C11 does
  /// not permit on a load.
  load : (fn(self : Self, order : MemoryOrder) -> i16)(
    unsafe(i16(__yo_atomic_load_short(&(self.*), _load_order(order).to_c_order())))
  ),
  /// Replace the current value. PANICS on `Acquire`/`AcqRel`, which C11 does
  /// not permit on a store.
  store : (fn(self : Self, value : i16, order : MemoryOrder) -> unit)(
    unsafe(__yo_atomic_store_short(&(self.*), value, _store_order(order).to_c_order()))
  ),
  /// Replace the value and return what it held before — C11
  /// `atomic_exchange`, Rust's `swap`.
  swap : (fn(self : Self, value : i16, order : MemoryOrder) -> i16)(
    unsafe(i16(__yo_atomic_exchange_short(&(self.*), value, order.to_c_order())))
  ),
  /// Store `new_value` only if the current value equals `expected`, and
  /// report whether it did — C11 `atomic_compare_exchange_strong`.
  ///
  /// STRONG: it never fails spuriously. On failure `expected` is written back
  /// with the value the object actually held, which is what makes the usual
  /// retry loop terminate without a second load. `success` orders the store,
  /// `failure` orders the load taken when nothing is stored — and `failure`
  /// PANICS on `Release`/`AcqRel`, since that path only reads.
  compare_exchange : (
    fn(
      self : Self,
      inout(expected) : i16,
      new_value : i16,
      success : MemoryOrder,
      failure : MemoryOrder
    ) -> bool
  )(
    unsafe(
      __yo_atomic_compare_exchange_short(
        &(self.*),
        &expected,
        new_value,
        success.to_c_order(),
        _failure_order(failure).to_c_order()
      )
    )
  ),
  /// Add `value`, returning the PREVIOUS value. Wraps on overflow, as C11
  /// `atomic_fetch_add` does.
  fetch_add : (fn(self : Self, value : i16, order : MemoryOrder) -> i16)({
    read := _read_order(order);
    (current : i16) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current + value, order, read);
    });
    current
  }),
  /// Subtract `value`, returning the PREVIOUS value. Wraps on underflow.
  fetch_sub : (fn(self : Self, value : i16, order : MemoryOrder) -> i16)({
    read := _read_order(order);
    (current : i16) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current - value, order, read);
    });
    current
  }),
  /// Bitwise-AND with `value`, returning the PREVIOUS value.
  fetch_and : (fn(self : Self, value : i16, order : MemoryOrder) -> i16)({
    read := _read_order(order);
    (current : i16) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current & value, order, read);
    });
    current
  }),
  /// Bitwise-OR with `value`, returning the PREVIOUS value.
  fetch_or : (fn(self : Self, value : i16, order : MemoryOrder) -> i16)({
    read := _read_order(order);
    (current : i16) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current | value, order, read);
    });
    current
  }),
  /// Bitwise-XOR with `value`, returning the PREVIOUS value.
  fetch_xor : (fn(self : Self, value : i16, order : MemoryOrder) -> i16)({
    read := _read_order(order);
    (current : i16) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current ^ value, order, read);
    });
    current
  }),
  /// Store the smaller of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic min, so this is a compare-exchange
  /// loop — lock-free, and it only costs a retry under contention.
  fetch_min : (fn(self : Self, value : i16, order : MemoryOrder) -> i16)({
    read := _read_order(order);
    (current : i16) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current < value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  }),
  /// Store the larger of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic max; see `fetch_min`.
  fetch_max : (fn(self : Self, value : i16, order : MemoryOrder) -> i16)({
    read := _read_order(order);
    (current : i16) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current > value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  })
);

// ============================================================================
// AtomicI32
// ============================================================================
AtomicI32 :: atomic(ref(struct((*) : atomic_int)));
impl(
  AtomicI32,
  /// A new atomic holding `value`. The initializing store is `release`,
  /// so the value is visible to any thread that acquires the handle.
  new : (fn(value : i32) -> Self)({
    v := Self(i32(0));
    unsafe(__yo_atomic_store_int(&(v.*), value, memory_order_release));
    v
  }),
  /// Read the current value. PANICS on `Release`/`AcqRel`, which C11 does
  /// not permit on a load.
  load : (fn(self : Self, order : MemoryOrder) -> i32)(
    unsafe(i32(__yo_atomic_load_int(&(self.*), _load_order(order).to_c_order())))
  ),
  /// Replace the current value. PANICS on `Acquire`/`AcqRel`, which C11 does
  /// not permit on a store.
  store : (fn(self : Self, value : i32, order : MemoryOrder) -> unit)(
    unsafe(__yo_atomic_store_int(&(self.*), value, _store_order(order).to_c_order()))
  ),
  /// Replace the value and return what it held before — C11
  /// `atomic_exchange`, Rust's `swap`.
  swap : (fn(self : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(__yo_atomic_exchange_int(&(self.*), value, order.to_c_order())))
  ),
  /// Store `new_value` only if the current value equals `expected`, and
  /// report whether it did — C11 `atomic_compare_exchange_strong`.
  ///
  /// STRONG: it never fails spuriously. On failure `expected` is written back
  /// with the value the object actually held, which is what makes the usual
  /// retry loop terminate without a second load. `success` orders the store,
  /// `failure` orders the load taken when nothing is stored — and `failure`
  /// PANICS on `Release`/`AcqRel`, since that path only reads.
  compare_exchange : (
    fn(
      self : Self,
      inout(expected) : i32,
      new_value : i32,
      success : MemoryOrder,
      failure : MemoryOrder
    ) -> bool
  )(
    unsafe(
      __yo_atomic_compare_exchange_int(
        &(self.*),
        &expected,
        new_value,
        success.to_c_order(),
        _failure_order(failure).to_c_order()
      )
    )
  ),
  /// Add `value`, returning the PREVIOUS value. Wraps on overflow, as C11
  /// `atomic_fetch_add` does.
  fetch_add : (fn(self : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(atomic_fetch_add_explicit(&(self.*), int(value), order.to_c_order())))
  ),
  /// Subtract `value`, returning the PREVIOUS value. Wraps on underflow.
  fetch_sub : (fn(self : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(atomic_fetch_sub_explicit(&(self.*), int(value), order.to_c_order())))
  ),
  /// Bitwise-AND with `value`, returning the PREVIOUS value.
  fetch_and : (fn(self : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(atomic_fetch_and_explicit(&(self.*), int(value), order.to_c_order())))
  ),
  /// Bitwise-OR with `value`, returning the PREVIOUS value.
  fetch_or : (fn(self : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(atomic_fetch_or_explicit(&(self.*), int(value), order.to_c_order())))
  ),
  /// Bitwise-XOR with `value`, returning the PREVIOUS value.
  fetch_xor : (fn(self : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(atomic_fetch_xor_explicit(&(self.*), int(value), order.to_c_order())))
  ),
  /// Store the smaller of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic min, so this is a compare-exchange
  /// loop — lock-free, and it only costs a retry under contention.
  fetch_min : (fn(self : Self, value : i32, order : MemoryOrder) -> i32)({
    read := _read_order(order);
