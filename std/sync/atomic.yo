//! High-level `Atomic*` wrappers for thread-safe shared mutable values.
//!
//! # Receiver convention
//!
//! Every method on every `Atomic*` type takes `self : Self`, the same
//! convention the rest of `std/sync` uses for `atomic(ref(...))` types
//! (`Mutex`, `RwLock`, `Cond`, `Channel`, `Once`, `WaitGroup`). An atomic
//! IS a shared handle — mutation goes through the C11 atomic operation, not
//! through a Yo place-write — so an `inout` receiver would only demand a
//! mutable binding at every call site without buying any extra guarantee.
//! `compare_exchange` keeps `inout(expected)`, which really is written back:
//! on failure it is updated to the value the object actually held.
//!
//! # Read-modify-write family
//!
//! Every integer atomic carries the full family:
//! `fetch_add`, `fetch_sub`, `fetch_and`, `fetch_or`, `fetch_xor`,
//! `fetch_min`, `fetch_max`. Each returns the value held BEFORE the
//! operation and wraps on overflow, matching C11 `atomic_fetch_*`.
//! `AtomicBool` has none of them: it is not an integer atomic.
//!
//! `AtomicI32` lowers `fetch_add`/`sub`/`and`/`or`/`xor` straight to the
//! C11 `atomic_fetch_*_explicit` generic macros — the only atomic type
//! `std/libc/stdatomic.yo` binds them for, because a `c_include` binding is
//! keyed by C symbol name and those macros have exactly one Yo binding
//! apiece. Every other type, and `fetch_min`/`fetch_max` on all of them
//! (C11 has no atomic min/max at all), runs a strong compare-exchange loop
//! over that type's `__yo_atomic_compare_exchange_*` primitive. The loop is
//! lock-free and yields the same value and the same wrapping semantics; it
//! only costs a retry under contention.
//!
//! # Memory ordering
//!
//! `MemoryOrder` is the C11 model MINUS `consume`, which no production
//! compiler implements and which Rust omits for the same reason — see the
//! type's own doc.
//!
//! An order the operation cannot legally carry PANICS rather than reaching C:
//! C11 forbids `release`/`acq_rel` on a load and `acquire`/`acq_rel` on a
//! store, but the order arrives as a RUNTIME value here, so the C compiler
//! cannot diagnose it and the program would silently get some other
//! ordering. Rust panics too. A compare-exchange loop additionally needs a
//! read-side order for its load and for the CAS failure path; `_read_order`
//! derives it by dropping the store half (`Release -> Relaxed`,
//! `AcqRel -> Acquire`).
//!
//! ## Stability
//!
//! unstable — the TYPES and method names are Rust's and are intended to keep
//! their meanings, but `MemoryOrder` lost its `Consume` variant in this pass
//! and the panic-on-illegal-order behaviour is new, so one more release of
//! use is wanted before freezing. The `Atomic*` set itself is complete
//! (bool, the eight fixed-width integers, `usize`, `isize`) and no additions
//! are planned.
pragma(Pragma.AllowUnsafe);

{
  atomic_bool,
  atomic_int,
  atomic_size_t,
  atomic_llong,
  atomic_schar,
  atomic_short,
  atomic_uchar,
  atomic_ushort,
  atomic_uint,
  atomic_ullong,
  atomic_ptrdiff_t,
  atomic_load_explicit,
  atomic_store_explicit,
  atomic_exchange_explicit,
  atomic_compare_exchange_strong_explicit,
  atomic_fetch_add_explicit,
  atomic_fetch_sub_explicit,
  atomic_fetch_and_explicit,
  atomic_fetch_or_explicit,
  atomic_fetch_xor_explicit,
  atomic_thread_fence,
  __yo_atomic_load_int,
  __yo_atomic_store_int,
  __yo_atomic_exchange_int,
  __yo_atomic_compare_exchange_int,
  __yo_atomic_load_size_t,
  __yo_atomic_store_size_t,
  __yo_atomic_exchange_size_t,
  __yo_atomic_compare_exchange_size_t,
  __yo_atomic_load_llong,
  __yo_atomic_store_llong,
  __yo_atomic_exchange_llong,
  __yo_atomic_compare_exchange_llong,
  __yo_atomic_load_schar,
  __yo_atomic_store_schar,
  __yo_atomic_exchange_schar,
  __yo_atomic_compare_exchange_schar,
  __yo_atomic_load_short,
  __yo_atomic_store_short,
  __yo_atomic_exchange_short,
  __yo_atomic_compare_exchange_short,
  __yo_atomic_load_uchar,
  __yo_atomic_store_uchar,
  __yo_atomic_exchange_uchar,
  __yo_atomic_compare_exchange_uchar,
  __yo_atomic_load_ushort,
  __yo_atomic_store_ushort,
  __yo_atomic_exchange_ushort,
  __yo_atomic_compare_exchange_ushort,
  __yo_atomic_load_uint,
  __yo_atomic_store_uint,
  __yo_atomic_exchange_uint,
  __yo_atomic_compare_exchange_uint,
  __yo_atomic_load_ullong,
  __yo_atomic_store_ullong,
  __yo_atomic_exchange_ullong,
  __yo_atomic_compare_exchange_ullong,
  __yo_atomic_load_ptrdiff,
  __yo_atomic_store_ptrdiff,
  __yo_atomic_exchange_ptrdiff,
  __yo_atomic_compare_exchange_ptrdiff,
  memory_order,
  memory_order_relaxed,
  memory_order_acquire,
  memory_order_release,
  memory_order_acq_rel,
  memory_order_seq_cst
} :: import("std/libc/stdatomic");

/// The memory ordering an atomic operation is performed with — Rust's
/// `atomic::Ordering`, and the same five variants.
///
/// **There is deliberately no `Consume`**, though C11 has a
/// `consume` ordering. It promises dependency ordering, and no production
/// compiler implements it: clang and gcc both strengthen it to `acquire`, and
/// C++ has formally discouraged it (P0371R1) for that reason. A variant that
/// costs `acquire` while promising something weaker is a correctness trap —
/// code written against the promise is unsound on a compiler that ever keeps
/// it, and nothing today does. Rust omits it, and so does this.
MemoryOrder :: enum(Relaxed, Acquire, Release, AcqRel, SeqCst);
impl(
  MemoryOrder,
  /// The C11 `memory_order` this maps to.
  to_c_order : (fn(self : Self) -> memory_order)(
    match(
      self,
      .Relaxed => memory_order_relaxed,
      .Acquire => memory_order_acquire,
      .Release => memory_order_release,
      .AcqRel => memory_order_acq_rel,
      .SeqCst => memory_order_seq_cst
    )
  )
);
/// `order`, if a LOAD may carry it. PANICS otherwise.
///
/// C11 §7.17.7.2 forbids `release` and `acq_rel` on a load, and the order
/// reaches C as a RUNTIME value here (`order.to_c_order()`), so the C compiler
/// cannot diagnose it the way it diagnoses a literal: the program silently
/// gets whichever ordering the runtime switch falls into. Measured before this
/// existed: `a.load(MemoryOrder.Release)` compiled clean at `-O2` and ran.
///
/// Rust panics for exactly this reason — `Ordering::Release` in `load` is a
/// documented panic, not a clamp — because quietly substituting a different
/// ordering hides the bug instead of reporting it.
_load_order :: (fn(order : MemoryOrder) -> MemoryOrder)(
  match(
    order,
    .Release => __yo_panic("Atomic load: MemoryOrder.Release is not a load ordering"),
    .AcqRel => __yo_panic("Atomic load: MemoryOrder.AcqRel is not a load ordering"),
    _ => order
  )
);
/// `order`, if a STORE may carry it. PANICS otherwise — C11 §7.17.7.1 forbids
/// `acquire` and `acq_rel` on a store, for the reason `_load_order` explains.
_store_order :: (fn(order : MemoryOrder) -> MemoryOrder)(
  match(
    order,
    .Acquire => __yo_panic("Atomic store: MemoryOrder.Acquire is not a store ordering"),
    .AcqRel => __yo_panic("Atomic store: MemoryOrder.AcqRel is not a store ordering"),
    _ => order
  )
);
/// `order`, if a compare-exchange FAILURE path may carry it. The failure path
/// performs only a load, so the load rule applies unchanged.
_failure_order :: (fn(order : MemoryOrder) -> MemoryOrder)(_load_order(order));

/// The read-side counterpart of `order`.
///
/// C11 forbids `release` and `acq_rel` where a plain load or a
/// compare-exchange FAILURE order is required, and a failure order may never
/// be stronger than its success order. This drops exactly the store half:
/// `Release -> Relaxed`, `AcqRel -> Acquire`, everything else unchanged.
_read_order :: (fn(order : MemoryOrder) -> MemoryOrder)(
  match(
    order,
    .Release => MemoryOrder.Relaxed,
    .AcqRel => MemoryOrder.Acquire,
    _ => order
  )
);

// ============================================================================
// AtomicBool
// ============================================================================
AtomicBool :: atomic(ref(struct((*) : atomic_bool)));
impl(
  AtomicBool,
  /// A new atomic holding `value`. The initializing store is `release`,
  /// so the value is visible to any thread that acquires the handle.
  new : (fn(value : bool) -> Self)({
    v := Self(false);
    cond(value => unsafe(atomic_store_explicit(&(v.*), true, memory_order_release)), true => ());
    v
  }),
  /// Read the current value. PANICS on `Release`/`AcqRel`, which C11 does
  /// not permit on a load.
  load : (fn(self : Self, order : MemoryOrder) -> bool)(
    unsafe(atomic_load_explicit(&(self.*), _load_order(order).to_c_order())) == true
  ),
  /// Replace the current value. PANICS on `Acquire`/`AcqRel`, which C11 does
  /// not permit on a store.
  store : (fn(self : Self, value : bool, order : MemoryOrder) -> unit)(
    unsafe(atomic_store_explicit(&(self.*), value, _store_order(order).to_c_order()))
  ),
  /// Replace the value and return what it held before — C11
  /// `atomic_exchange`, Rust's `swap`.
  swap : (fn(self : Self, value : bool, order : MemoryOrder) -> bool)(
    unsafe(atomic_exchange_explicit(&(self.*), value, order.to_c_order())) == true
  ),
  /// Store `new_value` only if the current value equals `expected`, and
  /// report whether it did — C11 `atomic_compare_exchange_strong`.
  ///
  /// STRONG: it never fails spuriously. On failure `expected` is written back
  /// with the value the object actually held, which is what makes the usual
  /// retry loop terminate without a second load. `success` orders the store,
  /// `failure` orders the load taken when nothing is stored — and `failure`
  /// PANICS on `Release`/`AcqRel`, since that path only reads.
  compare_exchange : (
    fn(
      self : Self,
      inout(expected) : bool,
      new_value : bool,
      success : MemoryOrder,
      failure : MemoryOrder
    ) -> bool
  )(
    unsafe(
      atomic_compare_exchange_strong_explicit(
        &(self.*),
        &expected,
        new_value,
        success.to_c_order(),
        _failure_order(failure).to_c_order()
      )
    )
  )
);

// ============================================================================
// AtomicI8
// ============================================================================
AtomicI8 :: atomic(ref(struct((*) : atomic_schar)));
impl(
  AtomicI8,
  /// A new atomic holding `value`. The initializing store is `release`,
  /// so the value is visible to any thread that acquires the handle.
  new : (fn(value : i8) -> Self)({
    v := Self(i8(0));
    unsafe(__yo_atomic_store_schar(&(v.*), value, memory_order_release));
    v
  }),
  /// Read the current value. PANICS on `Release`/`AcqRel`, which C11 does
  /// not permit on a load.
  load : (fn(self : Self, order : MemoryOrder) -> i8)(
    unsafe(i8(__yo_atomic_load_schar(&(self.*), _load_order(order).to_c_order())))
  ),
  /// Replace the current value. PANICS on `Acquire`/`AcqRel`, which C11 does
  /// not permit on a store.
  store : (fn(self : Self, value : i8, order : MemoryOrder) -> unit)(
    unsafe(__yo_atomic_store_schar(&(self.*), value, _store_order(order).to_c_order()))
  ),
  /// Replace the value and return what it held before — C11
  /// `atomic_exchange`, Rust's `swap`.
  swap : (fn(self : Self, value : i8, order : MemoryOrder) -> i8)(
    unsafe(i8(__yo_atomic_exchange_schar(&(self.*), value, order.to_c_order())))
  ),
  /// Store `new_value` only if the current value equals `expected`, and
  /// report whether it did — C11 `atomic_compare_exchange_strong`.
  ///
  /// STRONG: it never fails spuriously. On failure `expected` is written back
  /// with the value the object actually held, which is what makes the usual
  /// retry loop terminate without a second load. `success` orders the store,
  /// `failure` orders the load taken when nothing is stored — and `failure`
  /// PANICS on `Release`/`AcqRel`, since that path only reads.
  compare_exchange : (
    fn(
      self : Self,
      inout(expected) : i8,
      new_value : i8,
      success : MemoryOrder,
      failure : MemoryOrder
    ) -> bool
  )(
    unsafe(
      __yo_atomic_compare_exchange_schar(
        &(self.*),
        &expected,
        new_value,
        success.to_c_order(),
        _failure_order(failure).to_c_order()
      )
    )
  ),
  /// Add `value`, returning the PREVIOUS value. Wraps on overflow, as C11
  /// `atomic_fetch_add` does.
  fetch_add : (fn(self : Self, value : i8, order : MemoryOrder) -> i8)({
    read := _read_order(order);
    (current : i8) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current + value, order, read);
    });
    current
  }),
  /// Subtract `value`, returning the PREVIOUS value. Wraps on underflow.
  fetch_sub : (fn(self : Self, value : i8, order : MemoryOrder) -> i8)({
    read := _read_order(order);
    (current : i8) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current - value, order, read);
    });
    current
  }),
  /// Bitwise-AND with `value`, returning the PREVIOUS value.
  fetch_and : (fn(self : Self, value : i8, order : MemoryOrder) -> i8)({
    read := _read_order(order);
    (current : i8) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current & value, order, read);
    });
    current
  }),
  /// Bitwise-OR with `value`, returning the PREVIOUS value.
  fetch_or : (fn(self : Self, value : i8, order : MemoryOrder) -> i8)({
    read := _read_order(order);
    (current : i8) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current | value, order, read);
    });
    current
  }),
  /// Bitwise-XOR with `value`, returning the PREVIOUS value.
  fetch_xor : (fn(self : Self, value : i8, order : MemoryOrder) -> i8)({
    read := _read_order(order);
    (current : i8) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      swapped = self.compare_exchange(current, current ^ value, order, read);
    });
    current
  }),
  /// Store the smaller of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic min, so this is a compare-exchange
  /// loop — lock-free, and it only costs a retry under contention.
  fetch_min : (fn(self : Self, value : i8, order : MemoryOrder) -> i8)({
    read := _read_order(order);
    (current : i8) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current < value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  }),
  /// Store the larger of the current value and `value`, returning the
  /// PREVIOUS value. C11 has no atomic max; see `fetch_min`.
  fetch_max : (fn(self : Self, value : i8, order : MemoryOrder) -> i8)({
    read := _read_order(order);
    (current : i8) = self.load(read);
    (swapped : bool) = false;
    while(runtime(!swapped), {
      chosen := if(current > value, current, value);
      swapped = self.compare_exchange(current, chosen, order, read);
    });
    current
  })
);

