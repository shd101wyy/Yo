// ============================================================================
// AtomicI32
// ============================================================================
AtomicI32 :: atomic(ref(struct((*) : atomic_int)));
impl(
  AtomicI32,
  new : (fn(value : i32) -> Self)({
    v := Self(i32(0));
    unsafe(__yo_atomic_store_int(&(v.*), value, memory_order_release));
    v
  }),
  load : (fn(inout(self) : Self, order : MemoryOrder) -> i32)(
    unsafe(i32(__yo_atomic_load_int(&(self.*), order.to_c_order())))
  ),
  store : (fn(inout(self) : Self, value : i32, order : MemoryOrder) -> unit)(
    unsafe(__yo_atomic_store_int(&(self.*), value, order.to_c_order()))
  ),
  fetch_add : (fn(inout(self) : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(atomic_fetch_add_explicit(&(self.*), int(value), order.to_c_order())))
  ),
  fetch_sub : (fn(inout(self) : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(atomic_fetch_sub_explicit(&(self.*), int(value), order.to_c_order())))
  ),
  swap : (fn(inout(self) : Self, value : i32, order : MemoryOrder) -> i32)(
    unsafe(i32(__yo_atomic_exchange_int(&(self.*), value, order.to_c_order())))
  ),
  compare_exchange : (
    fn(
      inout(self) : Self,
      inout(expected) : i32,
      new_value : i32,
      success : MemoryOrder,
      failure : MemoryOrder
    ) -> bool
  )(
    unsafe(
      __yo_atomic_compare_exchange_int(
        &(self.*),
        &(expected),
        new_value,
        success.to_c_order(),
        failure.to_c_order()
      )
    )
  )
);

