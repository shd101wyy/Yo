//! Mutual exclusion lock primitives.
//!
//! Phase D (THREAD_SAFETY): Mutex parameterized over the protected data.
//! Access is granted via `with_lock(closure)` — the closure receives a
//! `v : &mut T` that is second-class (cannot escape the closure scope).
//! The private `__MutexUnlocker` handles unlock on both normal return
//! and unwind via its `Drop` impl.
//!
//! Both locks are move-only values with their state in a private `Box`,
//! shared as `Arc(Mutex(T))` / `Arc(RawMutex)` — Rust's shape. Until v0.2.80
//! they were implicitly shared handles over an atomic cell, so `m2 := m`
//! named the same lock; now it is E0901, and the fix is `Arc.new(...)` at the
//! creation and `Arc.clone(...)` per sharer.
//!
//! ## Stability
//!
//! unstable — the closure-scoped shape (`with_lock` / `try_with_lock`, no
//! guard type) is settled and concurrently tested
//! (`tests/sync/mutex.test.yo`, 12/12), but ONE row of
//! `plans/archive/STD_API_STABILIZATION.md` §4 "Concurrency" is still open and it
//! is on this surface: `_raw_lock` / `_raw_unlock` / `_raw_handle_ptr` are
//! reachable from outside the module and are meant to be removed. They
//! cannot go yet because `Condvar.wait` takes the raw handle they hand out —
//! `Mutex(T)` has no guard to pass instead — so freezing this module waits
//! on a condvar API that couples to a `Mutex(T)` without exposing its
//! primitive. There is also no poisoning: a thread that unwinds out of
//! `body` releases the lock and leaves the data as it was, where Rust
//! would mark the `Mutex` poisoned. That is a deliberate choice (Yo has no
//! poisoned state anywhere), not an omission, and it is not what is
//! holding the freeze.
pragma(Pragma.AllowUnsafe);
{
  atomic_size_t,
  __yo_atomic_load_size_t,
  __yo_atomic_store_size_t,
  memory_order_acquire,
  memory_order_release
} :: import("std/libc/stdatomic");

extern(
  "Yo",
  // The threading preamble's own thread identity (a macro over pthread_self /
  // GetCurrentThreadId), emitted for every program. NOT `__yo_get_thread_id`:
  // that one lives in the async runtime core, which a program without `io`
  // never emits. Every lock below records its holder with it (rule D5,
  // plans/reference/PARALLELISM_RULES.md).
  __yo_thread_self : (fn() -> usize),
  __YO_THREAD_SYNC_TYPE : Type,
  __yo_mutex_create : (fn() -> __YO_THREAD_SYNC_TYPE),
  __yo_mutex_lock : (fn(mutex : *__YO_THREAD_SYNC_TYPE) -> unit),
  __yo_mutex_trylock : (fn(mutex : *__YO_THREAD_SYNC_TYPE) -> bool),
  __yo_mutex_unlock : (fn(mutex : *__YO_THREAD_SYNC_TYPE) -> unit),
  __yo_mutex_destroy : (fn(mutex : *__YO_THREAD_SYNC_TYPE) -> unit)
);
// SAFETY: __YO_THREAD_SYNC_TYPE is an opaque C-level synchronization
// primitive (pthread_mutex_t or equivalent). It carries its own internal
// synchronization and is designed to be shared across threads.
impl(__YO_THREAD_SYNC_TYPE, Send());

// ============================================================================
// The lock core both `Mutex(T)` and `RawMutex` keep in their box
// ============================================================================
// The OS primitive and the thread holding it (`__yo_thread_self()`; `0` =
// unheld). The owner is a raw C11 atomic held inline: std is unsafe-capable,
// and an `AtomicUsize` would be a second allocation per lock. Every function
// below takes the core by raw pointer, because the core lives in a box and a
// `&Self` receiver is the caller's copy of the handle, never its address.
_LockCore :: struct(
  _handle : __YO_THREAD_SYNC_TYPE,
  _owner : atomic_size_t
);
impl(
  _LockCore,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      return(__yo_mutex_destroy(addr_of(self._handle)));
    })
  )
);
_lock_core_new :: (fn() -> _LockCore)(
  _LockCore(_handle : __yo_mutex_create(), _owner : atomic_size_t(usize(0)))
);
_lock_core_owner :: (fn(c : *_LockCore) -> usize)(
  unsafe(usize(__yo_atomic_load_size_t(addr_of(c.*._owner), memory_order_acquire)))
);
_lock_core_set_owner :: (fn(c : *_LockCore, owner : usize) -> unit)(
  unsafe(__yo_atomic_store_size_t(addr_of(c.*._owner), owner, memory_order_release))
);
_lock_core_held :: (fn(c : *_LockCore) -> bool)(
  _lock_core_owner(c) == __yo_thread_self()
);
// Block until the lock is taken. The caller has already refused a re-lock by
// the holder, with its own message.
_lock_core_lock :: (fn(c : *_LockCore) -> unit)({
  __yo_mutex_lock(unsafe(addr_of(c.*._handle)));
  _lock_core_set_owner(c, __yo_thread_self());
});
// Take the lock if it is free; `false` for the thread that already holds it,
// on every platform (a Windows `CRITICAL_SECTION` would re-enter).
_lock_core_try_lock :: (fn(c : *_LockCore) -> bool)(
  cond(
    _lock_core_held(c) => false,
    __yo_mutex_trylock(unsafe(addr_of(c.*._handle))) => {
      _lock_core_set_owner(c, __yo_thread_self());
      true
    },
    true => false
  )
);
// Release the lock. The caller has already refused an unlock by a thread that
// does not hold it, with its own message.
_lock_core_unlock :: (fn(c : *_LockCore) -> unit)({
  _lock_core_set_owner(c, usize(0));
  __yo_mutex_unlock(unsafe(addr_of(c.*._handle)));
});

// ============================================================================
// Mutex(T) — a move-only lock owning its data, with a closure-scoped lock API
// ============================================================================
/// A mutual-exclusion lock that OWNS the data it protects — Rust's
/// `Mutex<T>`, minus the guard.
///
/// Access is granted only inside a closure: `with_lock` hands `body` an
/// `v : &mut T` that is second-class and cannot escape the closure, so
/// there is no way to hold a reference to the protected value after the
/// lock is released. That is the deliberate divergence from Rust, which
/// returns a `MutexGuard` and relies on its lifetime; Yo has no lifetimes
/// to lean on, so the scope is the closure body.
///
/// `T` must be `Send` (it crosses threads). It need not be `Acyclic`, as
/// in Rust: a cycle closed through a mutex (`Arc(Mutex(Node))` with a
/// `Node` that holds such a handle) leaks, because atomic cells are never
/// cycle-collected (plans/archive/WEAK_AND_UNCOLLECTED_RC.md §2).
///
/// **A `Mutex(T)` is a move-only value, shared as `Arc(Mutex(T))`** — Rust's
/// `Arc<Mutex<T>>`. Copying one is E0901: create it with
/// `Arc.new(Mutex(T).new(v))` and give each thread its own
/// `Arc.clone(...)`. The lock and the value live in a private `Box`, so
/// every method takes `self : &Self` (interior mutability, as in Rust), and
/// auto-dereference reaches them through the `Arc`. The OS primitive is
/// destroyed when the mutex is dropped — for a shared one, with the last
/// `Arc`.
///
/// ```yo
/// { Mutex } :: import("std/sync/mutex");
/// { Thread } :: import("std/thread");
///
/// total := Arc.new(Mutex(i32).new(i32(0)));
/// mine := Arc.clone(total);
/// t := Thread(unit).spawn({ mine }(io : Io) => {
///   mine.with_lock(v => {
///     v.* = (v.* + i32(1));
///   });
/// });
/// t.join();
/// assert(total.with_lock(v => v.*) == i32(1), "one increment");
/// ```
///
/// There is no poisoning: if `body` unwinds, the lock is released and the
/// data keeps whatever value it had at that moment.
///
/// **Misuse traps, on every platform** (rule D5 of
/// `plans/reference/PARALLELISM_RULES.md`): the lock records the thread that
/// holds it, so locking it again from that thread, unlocking it from another,
/// or waiting on a `Condvar` with a mutex the caller does not hold is a panic with
/// a message naming the API — never the platform-dependent deadlock, silent
/// recursion or undefined behaviour of the OS primitive underneath.
_MutexState :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _core : _LockCore,
    _value : T
  )
);
Mutex :: (fn(comptime(T) : Type, where(T <: Send)) -> comptime(Type))(
  struct(_state : Box(_MutexState(T)))
);
// SAFETY: every access to `_value` happens under the core's lock, one thread
// at a time, so the mutex is Sync whenever `T` may be moved between threads:
// Sync for `T <: Send`, not `T <: Sync` (plans/VALUES_BY_DEFAULT.md §3.8).
impl(generic(T : Type), where(T <: Send), Mutex(T), Send());
impl(generic(T : Type), where(T <: Send), Mutex(T), Sync());

/// An UNGUARDED lock with no protected value. `lock` / `try_lock` /
/// `unlock` are the whole API and balancing them is the caller's job — no
/// guard releases it for you — so it exists only for the shapes
/// `Mutex.with_lock`'s closure cannot express: a lock taken in one function
/// and released in another (the thread pool's submission lock in
/// `std/thread.yo`). Prefer `Mutex(T)` everywhere else; `Mutex`'s own raw
/// methods are private to `std/sync/` (member visibility).
///
/// A move-only value like `Mutex(T)`, shared as `Arc(RawMutex)`.
RawMutex :: struct(_core : Box(_LockCore));
// SAFETY: the core is an OS lock and an atomic owner word, both designed to
// be used from several threads at once.
impl(RawMutex, Send());
impl(RawMutex, Sync());
impl(
  RawMutex,
  new : (fn() -> Self)(Self(_core : Box.new(_lock_core_new()))),
  _core_ptr : (fn(self : &Self) -> *_LockCore)(addr_of(self._core.*)),
  /// Block until the lock is taken. Locking again from the thread that holds
  /// it PANICS (it would deadlock on POSIX and silently recurse on Windows;
  /// D5 makes it one behaviour).
  lock : (fn(self : &Self) -> unit)({
    c := self._core_ptr();
    cond(
      _lock_core_held(c) => __yo_panic("RawMutex.lock: locked again by the thread that already holds it"),
      true => ()
    );
    _lock_core_lock(c);
  }),
  /// Take the lock if it is free; `true` = taken (you must `unlock`). `false`
  /// for the thread that already holds it, on every platform (a Windows
  /// `CRITICAL_SECTION` would re-enter).
  try_lock : (fn(self : &Self) -> bool)(_lock_core_try_lock(self._core_ptr())),
  /// Release the lock. PANICS unless THIS thread holds it — an unlock without
  /// a lock, or from another thread, is undefined behaviour in the OS
  /// primitive and is refused here instead.
  unlock : (fn(self : &Self) -> unit)({
    c := self._core_ptr();
    cond(
      !_lock_core_held(c) => __yo_panic("RawMutex.unlock: unlocked by a thread that does not hold it"),
      true => ()
    );
    _lock_core_unlock(c);
  }),
  /// Whether the calling thread holds this lock. Exact for the caller (only
  /// it can change that fact); the answer about any OTHER thread is
  /// advisory. This is what lets a lock taken in one function be released
  /// in another without a guard — `std/thread`'s submission lock.
  held_by_current_thread : (fn(self : &Self) -> bool)(
    _lock_core_held(self._core_ptr())
  )
);

// __MutexUnlocker — private object that unlocks its core on Drop.
// Allocated locally inside with_lock; Yo's drop-on-scope-exit and
// drop-on-unwind machinery guarantees unlock under both normal return
// and unwind(...). It points at the core inside the mutex's box, which
// outlives it: the mutex is borrowed for the whole `with_lock` call.
__MutexUnlocker :: struct(_core : *_LockCore);
impl(
  __MutexUnlocker,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      cond(
        !_lock_core_held(self._core) => __yo_panic("Mutex: unlocked by a thread that does not hold it"),
        true => ()
      );
      _lock_core_unlock(self._core);
    })
  )
);

impl(
  generic(T : Type),
  where(T <: Send),
  Mutex(T),
  /// Wrap `value` in a new, unlocked mutex — Rust's `Mutex::new`.
  ///
  /// `value` moves INTO the lock and is thereafter reachable only through
  /// `with_lock` / `try_with_lock`. Creating the OS primitive and the box
  /// that holds it is the only allocation-time cost; there is no lazy
  /// initialization on first lock.
  new : (fn(value : T) -> Self)({
    return(Self(_state : Box.new(_MutexState(T)(_core : _lock_core_new(), _value : value))));
  }),
  /// Take the lock, run `body` on the protected value, release the lock,
  /// and return `body`'s result — Rust's `lock().unwrap()` plus the guard's
  /// scope, in one call.
  ///
  /// **This blocks** until the lock is available, parking the thread rather
  /// than spinning. `body` receives a `v : &mut T`, so it may mutate the
  /// protected value in place; the mutation is visible to the next holder.
  ///
  /// Release is structural, not by falling off the end: a private
  /// `__MutexUnlocker` is created inside the critical section and its
  /// `Drop` impl unlocks, so an early `return` out of `body` or an
  /// `unwind` through this frame still releases the lock. Nothing marks the
  /// mutex poisoned in that case (see the type doc).
  ///
  /// **Re-entering the same mutex from the same thread PANICS** — on every
  /// platform, with a message naming this API. (The POSIX primitive would
  /// deadlock and the Windows `CRITICAL_SECTION` would silently recurse; the
  /// owner check in `_raw_lock` replaces both with one trap.) Nest different
  /// mutexes, not the same one.
  with_lock : (
    fn(
      generic(R : Type),
      self : &Self,
      body : &mut Impl(FnMut(v : &mut T) -> R)
    ) -> R
  )({
    self._raw_lock();
    _guard := __MutexUnlocker(_core : self._core_ptr());
    vp := self._value_ptr();
    body(&mut unsafe(vp.*))
  }),
  /// Run `body` under the lock IF it can be taken without waiting, and
  /// return `.Some(result)`; `.None` when another thread holds it.
  ///
  /// The closure-scoped counterpart of Rust's `try_lock`. Rust hands back a
  /// `Result<MutexGuard, TryLockError>`; `Mutex(T)` deliberately has no guard
  /// type — access is only ever granted inside a closure — so the "did I get
  /// it" answer is the `Option` instead. `body` not running IS the failure
  /// case, which is why the result is optional rather than the lock state
  /// being reported separately: there is no way to observe "not acquired" and
  /// still have a value.
  ///
  /// Release is by the same `__MutexUnlocker` `with_lock` uses, so an early
  /// `return` or an `unwind` out of `body` still unlocks.
  ///
  /// **Do not spin on this.** A `while(!took, ...)` loop around `try_with_lock`
  /// is a busy-wait that starves the holder on a single core; `with_lock`
  /// parks instead. `try_with_lock` is for the case where there is other
  /// useful work to do when the lock is busy.
  ///
  /// The thread that ALREADY holds this mutex gets `.None`, on every platform
  /// (a Windows `CRITICAL_SECTION` is recursive and would have said `.Some`;
  /// the owner check masks that so the answer is portable).
  try_with_lock : (
    fn(
      generic(R : Type),
      self : &Self,
      body : &mut Impl(FnMut(v : &mut T) -> R)
    ) -> Option(R)
  )({
    c := self._core_ptr();
    cond(
      !_lock_core_try_lock(c) => Option(R).None,
      true => {
        _guard := __MutexUnlocker(_core : c);
        vp := self._value_ptr();
        Option(R).Some(body(&mut unsafe(vp.*)))
      }
    )
  }),
  /// True when the mutex is NOT held right now.
  ///
  /// **Advisory only, and racy by construction:** it takes the lock to find
  /// out and releases it again, so the answer describes a moment that has
  /// already passed. Never branch on this to decide whether a later
  /// `with_lock` will block — that is a TOCTOU bug. It exists for assertions
  /// and diagnostics, which is why it is spelled as a question about the past
  /// rather than as `can_lock`.
  is_unlocked : (fn(self : &Self) -> bool)({
    c := self._core_ptr();
    cond(
      _lock_core_try_lock(c) => {
        _lock_core_unlock(c);
        true
      },
      true => false
    )
  }),
  // Internal methods — private to std/sync (member visibility). Every lock and
  // unlock goes through the core functions, which is what keeps `_owner` exact.
  _core_ptr : (fn(self : &Self) -> *_LockCore)(addr_of(self._state.*._core)),
  _value_ptr : (fn(self : &Self) -> *T)(addr_of(self._state.*._value)),
  _raw_lock : (fn(self : &Self) -> unit)({
    c := self._core_ptr();
    cond(
      _lock_core_held(c) => __yo_panic("Mutex: locked again by the thread that already holds it (a with_lock inside a with_lock on the same mutex)"),
      true => ()
    );
    _lock_core_lock(c);
  }),
  _raw_unlock : (fn(self : &Self) -> unit)({
    c := self._core_ptr();
    cond(
      !_lock_core_held(c) => __yo_panic("Mutex: unlocked by a thread that does not hold it"),
      true => ()
    );
    _lock_core_unlock(c);
  }),
  _raw_handle_ptr : (fn(self : &Self) -> *__YO_THREAD_SYNC_TYPE)(
    addr_of(self._state.*._core._handle)
  ),
  /// Whether the calling thread holds this mutex (exact for the caller).
  _held_by_current_thread : (fn(self : &Self) -> bool)(
    _lock_core_held(self._core_ptr())
  ),
  /// Bracket a condvar wait: the OS wait releases and re-takes the mutex
  /// behind our back, so the owner record is cleared before parking and
  /// restored after. Both panic-check that the caller holds the mutex.
  _park_begin : (fn(self : &Self) -> unit)({
    c := self._core_ptr();
    cond(
      !_lock_core_held(c) => __yo_panic("Condvar.wait_with: the calling thread does not hold the mutex it passed"),
      true => ()
    );
    _lock_core_set_owner(c, usize(0));
  }),
  _park_end : (fn(self : &Self) -> unit)(
    _lock_core_set_owner(self._core_ptr(), __yo_thread_self())
  )
);

export(
  __YO_THREAD_SYNC_TYPE,
  __yo_thread_self,
  Mutex,
  RawMutex
);
