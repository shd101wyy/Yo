//! Bounded MPMC (multiple-producer, multiple-consumer) channel using
//! condition variables for thread synchronization.
pragma(Pragma.AllowUnsafe);
{ __YO_THREAD_SYNC_TYPE } :: import("./mutex");
{ Mutex } :: import("./mutex");
{ Cond } :: import("./cond");
extern(
  "Yo",
  __yo_channel_create : (fn(capacity : usize) -> *(void)),
  __yo_channel_free : (fn(data : *(void)) -> unit)
);
/// Thread-safe MPMC channel with configurable buffer size.
///
/// Type parameter `T` must implement `Send` to guarantee thread safety.
///
/// # Example
/// ```rust
/// { Channel } :: import "std/sync/channel";
/// { Thread } :: import "std/thread";
///
/// ch := Channel(i32).new(usize(4));
/// Thread.spawn(() => {
///   ch.send(i32(42));
/// });
///
/// v := ch.recv();  // blocks until a value is received
/// assert(v == i32(42));
/// ```
Channel :: (fn(comptime(T) : Type, where(T <: Send)) -> comptime(Type))(
  atomic(
    object(
      _data : *(T),
      _head : usize,
      _len : usize,
      _capacity : usize,
      _mutex : Mutex(bool),
      _not_empty : Cond,
      _not_full : Cond,
      _closed : bool
    )
  )
);
impl(
  forall(T : Type),
  Channel(T),
  where(T <: Send),
  // Creates a new bounded channel with the given buffer capacity.
  new : (fn(capacity : usize) -> Self)({
    data := __yo_channel_create(capacity * usize.of(T));
    Self(
      _data : cast(*(T))(data),
      _head : usize(0),
      _len : usize(0),
      _capacity : capacity,
      _mutex : Mutex(bool).new(false),
      _not_empty : Cond.new(),
      _not_full : Cond.new(),
      _closed : false
    )
  }),
  // Sends a value, blocking until there is space.
  send : (fn(ref(self) : Self, value : T) -> unit)({
    self._mutex._raw_lock();
    while(runtime(!(self._closed) && (self._len == self._capacity)), {
      self._not_full.wait(self._mutex._raw_handle_ptr());
    });
    if(self._closed, {
      self._mutex._raw_unlock();
    }, {
      idx := ((self._head + self._len) % self._capacity);
      (self._data &+ idx).* = value;
      self._len = (self._len + usize(1));
      self._not_empty.signal();
      self._mutex._raw_unlock();
    });
  }),
  // Receives a value, blocking until one is available or the channel is closed.
  recv : (fn(ref(self) : Self) -> T)({
    self._mutex._raw_lock();
    while(runtime(!(self._closed) && (self._len == usize(0))), {
      self._not_empty.wait(self._mutex._raw_handle_ptr());
    });
    if(self._closed && (self._len == usize(0)), {
      self._mutex._raw_unlock();
      panic("Channel.recv on empty closed channel");
    }, {
      idx := self._head;
      result := (self._data &+ idx).*;
      self._head = ((idx + usize(1)) % self._capacity);
      self._len = (self._len - usize(1));
      self._not_full.signal();
      self._mutex._raw_unlock();
      result
    });
  }),
  close : (fn(self : Self) -> unit)({
    self._mutex._raw_lock();
    self._closed = true;
    self._not_empty.broadcast();
    self._not_full.broadcast();
    self._mutex._raw_unlock();
  }),
  is_closed : (fn(self : Self) -> bool)(
    self._closed
  ),
  len : (fn(self : Self) -> usize)(
    self._len
  ),
  is_empty : (fn(self : Self) -> bool)(
    self._len == usize(0)
  )
);
// Dispose: drop remaining elements and free the buffer
impl(
  forall(T : Type),
  Channel(T),
  where(T <: Send),
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      (i : usize) = usize(0);
      while(runtime(i < self._len), {
        (idx : usize) = ((self._head + i) % self._capacity);
        unsafe.drop((self._data &+ idx).*);
        i = (i + usize(1));
      });
      free(.Some(*(void)(self._data)));
    })
  )
);
export(Channel);
