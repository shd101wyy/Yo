  // Poll Operations (libuv uv_poll_t equivalent)
  // ========================================================================
  __yo_poll_init : (fn(fd: i32) -> *(u8)),
  __yo_poll_start : (fn(handle: *(u8), events: i32, callback: *(u8)) -> i32),
  __yo_poll_stop : (fn(handle: *(u8)) -> i32),
  __yo_poll_close : (fn(handle: *(u8)) -> unit)
;

// ============================================================================
// IOError - I/O error type
// ============================================================================

IOError :: enum(
  // File system errors
  NotFound,
  PermissionDenied,
  AlreadyExists,
  NotADirectory,
  IsADirectory,
  DirectoryNotEmpty,
  BrokenPipe,
  WouldBlock,
  InvalidInput,
  Interrupted,
  TooManyOpenFiles,
  FileTooLarge,
  NoSpace,
  ReadOnlyFilesystem,
  CrossDeviceLink,
  TooManyLinks,
  NameTooLong,
  NotSupported,
  TimedOut,
  Busy,
  BadFileDescriptor,
  IOError,

  // Network errors
  ConnectionRefused,
  ConnectionReset,
  ConnectionAborted,
  NotConnected,
  AddressInUse,
  AddressNotAvailable,
  NetworkUnreachable,
  HostUnreachable,
  NetworkDown,
  AlreadyConnected,

  // Generic
  Other(code: i32)
);
impl(IOError, {
  from_errno :: (fn(errno: i32) -> Self)(
    cond(
      // File system errors
      (errno == ENOENT) => .NotFound,
      ((errno == EPERM) || (errno == EACCES)) => .PermissionDenied,
      (errno == EEXIST) => .AlreadyExists,
      (errno == ENOTDIR) => .NotADirectory,
      (errno == EISDIR) => .IsADirectory,
      (errno == ENOTEMPTY) => .DirectoryNotEmpty,
      (errno == EPIPE) => .BrokenPipe,
      ((errno == EAGAIN) || (errno == EWOULDBLOCK)) => .WouldBlock,
      (errno == EINVAL) => .InvalidInput,
      (errno == EINTR) => .Interrupted,
      ((errno == EMFILE) || (errno == ENFILE)) => .TooManyOpenFiles,
      (errno == EFBIG) => .FileTooLarge,
      (errno == ENOSPC) => .NoSpace,
      (errno == EROFS) => .ReadOnlyFilesystem,
      (errno == EXDEV) => .CrossDeviceLink,
      (errno == EMLINK) => .TooManyLinks,
      (errno == ENAMETOOLONG) => .NameTooLong,
      ((errno == ENOTSUP) || (errno == EOPNOTSUPP)) => .NotSupported,
      (errno == ETIMEDOUT) => .TimedOut,
      (errno == EBUSY) => .Busy,
      (errno == EBADF) => .BadFileDescriptor,
      (errno == EIO) => .IOError,
      // Network errors
      (errno == ECONNREFUSED) => .ConnectionRefused,
      (errno == ECONNRESET) => .ConnectionReset,
      (errno == ECONNABORTED) => .ConnectionAborted,
      (errno == ENOTCONN) => .NotConnected,
      (errno == EADDRINUSE) => .AddressInUse,
      (errno == EADDRNOTAVAIL) => .AddressNotAvailable,
      (errno == ENETUNREACH) => .NetworkUnreachable,
      (errno == EHOSTUNREACH) => .HostUnreachable,
      (errno == ENETDOWN) => .NetworkDown,
      (errno == EISCONN) => .AlreadyConnected,
      true => .Other(errno)
    )
  );
  export from_errno;

  from_result :: (fn(result: i32) -> Result(i32, Self))(
    cond(
      (result >= i32(0)) => .Ok(result),
      true => .Err(from_errno((i32(0) - result)))
    )
  );
  export from_result;
});

impl(IOError, ToString(
  to_string : (self -> {
    s := match(self,
      // File system errors
      .NotFound => String.from_cstr("file or directory not found").unwrap(),
      .PermissionDenied => String.from_cstr("permission denied").unwrap(),
      .AlreadyExists => String.from_cstr("file or directory already exists").unwrap(),
      .NotADirectory => String.from_cstr("not a directory").unwrap(),
      .IsADirectory => String.from_cstr("is a directory").unwrap(),
      .DirectoryNotEmpty => String.from_cstr("directory not empty").unwrap(),
      .BrokenPipe => String.from_cstr("broken pipe").unwrap(),
      .WouldBlock => String.from_cstr("operation would block").unwrap(),
      .InvalidInput => String.from_cstr("invalid input").unwrap(),
      .Interrupted => String.from_cstr("operation interrupted").unwrap(),
      .TooManyOpenFiles => String.from_cstr("too many open files").unwrap(),
      .FileTooLarge => String.from_cstr("file too large").unwrap(),
      .NoSpace => String.from_cstr("no space left on device").unwrap(),
      .ReadOnlyFilesystem => String.from_cstr("read-only filesystem").unwrap(),
      .CrossDeviceLink => String.from_cstr("cross-device link").unwrap(),
      .TooManyLinks => String.from_cstr("too many links").unwrap(),
      .NameTooLong => String.from_cstr("name too long").unwrap(),
      .NotSupported => String.from_cstr("operation not supported").unwrap(),
      .TimedOut => String.from_cstr("operation timed out").unwrap(),
      .Busy => String.from_cstr("resource busy").unwrap(),
      .BadFileDescriptor => String.from_cstr("bad file descriptor").unwrap(),
      .IOError => String.from_cstr("I/O error").unwrap(),
      // Network errors
      .ConnectionRefused => String.from_cstr("connection refused").unwrap(),
      .ConnectionReset => String.from_cstr("connection reset by peer").unwrap(),
      .ConnectionAborted => String.from_cstr("connection aborted").unwrap(),
      .NotConnected => String.from_cstr("socket not connected").unwrap(),
      .AddressInUse => String.from_cstr("address already in use").unwrap(),
      .AddressNotAvailable => String.from_cstr("address not available").unwrap(),
      .NetworkUnreachable => String.from_cstr("network unreachable").unwrap(),
      .HostUnreachable => String.from_cstr("host unreachable").unwrap(),
      .NetworkDown => String.from_cstr("network is down").unwrap(),
      .AlreadyConnected => String.from_cstr("socket already connected").unwrap(),
      .Other(errno) => String.from_cstr("unknown I/O error").unwrap()
    );
    return s;
  })
));

// ============================================================================
// Statx - File status from async stat operations
// ============================================================================

Statx :: object(
  _buf_ptr: *(u8),
  _buf_size: usize
);
impl(Statx, {
  is_file :: (fn(self: Self) -> bool)({
    mode := __yo_statx_mode(self._buf_ptr);
    file_type := (mode & S_IFMT);
    return (file_type == S_IFREG);
  });
  export is_file;

  is_directory :: (fn(self: Self) -> bool)({
    mode := __yo_statx_mode(self._buf_ptr);
    file_type := (mode & S_IFMT);
    return (file_type == S_IFDIR);
  });
  export is_directory;

  is_symlink :: (fn(self: Self) -> bool)({
    mode := __yo_statx_mode(self._buf_ptr);
    file_type := (mode & S_IFMT);
    return (file_type == S_IFLNK);
  });
  export is_symlink;

  size :: (fn(self: Self) -> i64)(
    __yo_statx_size(self._buf_ptr)
  );
  export size;

  mode :: (fn(self: Self) -> u32)(
    __yo_statx_mode(self._buf_ptr)
  );
  export mode;

  uid :: (fn(self: Self) -> u32)(
    __yo_statx_uid(self._buf_ptr)
  );
  export uid;

  gid :: (fn(self: Self) -> u32)(
    __yo_statx_gid(self._buf_ptr)
  );
  export gid;

  ino :: (fn(self: Self) -> u64)(
    __yo_statx_ino(self._buf_ptr)
  );
  export ino;

  nlink :: (fn(self: Self) -> u64)(
    __yo_statx_nlink(self._buf_ptr)
  );
  export nlink;

  mtime_sec :: (fn(self: Self) -> i64)(
    __yo_statx_mtime_sec(self._buf_ptr)
  );
  export mtime_sec;

  mtime_nsec :: (fn(self: Self) -> u32)(
    __yo_statx_mtime_nsec(self._buf_ptr)
  );
  export mtime_nsec;
});

export
  // Types
  IOError,
  IOFuture,
  Statx,

  // AT_* flags
  AT_FDCWD,
  AT_REMOVEDIR,
  AT_SYMLINK_NOFOLLOW,
  STATX_BASIC_STATS,

  // File type flags (S_IF*)
