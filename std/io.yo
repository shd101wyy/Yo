  __yo_async_fchmod_start : (fn(fd: i32, mode: u32) -> IOFuture),
  __yo_async_fchmodat_start : (fn(dirfd: i32, path: *(u8), mode: u32, flags: i32) -> IOFuture),
  __yo_async_fchown_start : (fn(fd: i32, uid: u32, gid: u32) -> IOFuture),
  __yo_async_fchownat_start : (fn(dirfd: i32, path: *(u8), uid: u32, gid: u32, flags: i32) -> IOFuture),

  // ========================================================================
  // Symbolic Link Resolution (for fs.readlink)
  // ========================================================================
