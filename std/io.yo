// std/io.yo - Low-level async I/O primitives
//
// This module provides low-level async I/O operations using platform-native backends:
// - Linux: io_uring for true async I/O (kernel 5.1+)
// - macOS: dispatch_io (Grand Central Dispatch) for true async file I/O
// - Windows: IOCP for true async I/O (planned)
//
// API Categories (libuv-equivalent coverage):
// - Timers: sleep, timeout
// - File I/O: read, write, open, close, stat, truncate, fsync, access, realpath
// - Directory Ops: mkdir, unlink, rename, symlink, link, readdir, scandir
// - File Extras: mkdtemp, mkstemp, utime, copyfile, sendfile, statfs
// - Permissions: chmod, chown
// - Socket I/O: socket, bind, listen, accept, connect, send, recv
// - FD Ops: dup, dup2, pipe
// - DNS: getaddrinfo, getnameinfo
// - Signals: signal handling
// - TTY: terminal mode, window size
// - FS Events: file/directory watching
// - Poll: generic fd polling
//
// For higher-level APIs, see:
// - std/fs.yo - File and Directory abstractions
// - std/net/tcp.yo - TCP client/server (planned)
// - std/net/udp.yo - UDP sockets (planned)

{ String } :: import "./string";
{ ToString } :: import "./fmt";
{
  ENOENT, EPERM, EACCES, EEXIST, ENOTDIR, EISDIR, ENOTEMPTY, EPIPE,
  EAGAIN, EWOULDBLOCK, EINVAL, EINTR, EMFILE, ENFILE, EFBIG, ENOSPC,
  EROFS, EXDEV, EMLINK, ENAMETOOLONG, ENOTSUP, EOPNOTSUPP, ETIMEDOUT, EBUSY,
  ECONNREFUSED, ECONNRESET, ECONNABORTED, ENOTCONN, EADDRINUSE, EADDRNOTAVAIL,
  ENETUNREACH, EHOSTUNREACH, ENETDOWN, EISCONN, EBADF, EIO
} :: import "./libc/errno";

// Import platform-correct open flags from libc
{
  O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_EXCL, O_TRUNC, O_APPEND,
  O_NONBLOCK, O_CLOEXEC
} :: import "./libc/fcntl";

// ============================================================================
// Constants
// ============================================================================

// AT_FDCWD - Use current working directory for *at() functions
// This value is the same across POSIX systems
AT_FDCWD :: i32(-100);

// Flags for unlinkat (AT_REMOVEDIR)
AT_REMOVEDIR :: i32(0x200);

// Flags for statx (Linux-specific, macOS uses different mechanism)
AT_EMPTY_PATH :: i32(0x1000);
AT_SYMLINK_NOFOLLOW :: i32(0x100);
AT_STATX_SYNC_AS_STAT :: i32(0x0000);

// STATX_BASIC_STATS - request basic stats (Linux-specific)
STATX_BASIC_STATS :: u32(0x000007ff);

// File mode bits (S_IF* and S_I* from sys/stat.h)
S_IFMT   :: u32(0o170000);
S_IFSOCK :: u32(0o140000);
S_IFLNK  :: u32(0o120000);
S_IFREG  :: u32(0o100000);
S_IFBLK  :: u32(0o060000);
S_IFDIR  :: u32(0o040000);
S_IFCHR  :: u32(0o020000);
S_IFIFO  :: u32(0o010000);

// Permission bits
S_IRWXU :: u32(0o0700);
S_IRUSR :: u32(0o0400);
S_IWUSR :: u32(0o0200);
S_IXUSR :: u32(0o0100);
S_IRWXG :: u32(0o0070);
S_IRGRP :: u32(0o0040);
S_IWGRP :: u32(0o0020);
S_IXGRP :: u32(0o0010);
S_IRWXO :: u32(0o0007);
S_IROTH :: u32(0o0004);
S_IWOTH :: u32(0o0002);
S_IXOTH :: u32(0o0001);

// Default permissions
DEFAULT_FILE_MODE :: u32(0o644);
DEFAULT_DIR_MODE  :: u32(0o755);

// ============================================================================
// Socket Constants
// ============================================================================

// Address families (AF_*)
AF_UNSPEC :: i32(0);
AF_UNIX   :: i32(1);
AF_LOCAL  :: i32(1);    // Same as AF_UNIX
AF_INET   :: i32(2);
AF_INET6  :: i32(10);   // Note: 30 on macOS, 10 on Linux - use c_include for portability

// Socket types (SOCK_*)
SOCK_STREAM    :: i32(1);
SOCK_DGRAM     :: i32(2);
SOCK_RAW       :: i32(3);
SOCK_SEQPACKET :: i32(5);

// Socket options levels
SOL_SOCKET :: i32(1);   // Note: 0xFFFF on macOS - use c_include for portability
IPPROTO_TCP :: i32(6);
IPPROTO_UDP :: i32(17);
IPPROTO_IP  :: i32(0);
IPPROTO_IPV6 :: i32(41);

// Socket options (SO_*)
SO_REUSEADDR   :: i32(2);   // Note: different on macOS
SO_KEEPALIVE   :: i32(9);
SO_BROADCAST   :: i32(6);
SO_RCVBUF      :: i32(8);
SO_SNDBUF      :: i32(7);
SO_RCVTIMEO    :: i32(20);
SO_SNDTIMEO    :: i32(21);
SO_ERROR       :: i32(4);
SO_TYPE        :: i32(3);
SO_LINGER      :: i32(13);
SO_REUSEPORT   :: i32(15);

// TCP options (TCP_*)
TCP_NODELAY    :: i32(1);
TCP_KEEPIDLE   :: i32(4);
TCP_KEEPINTVL  :: i32(5);
TCP_KEEPCNT    :: i32(6);

// shutdown() how parameter
SHUT_RD   :: i32(0);
SHUT_WR   :: i32(1);
SHUT_RDWR :: i32(2);

// Special IP addresses
INADDR_ANY       :: u32(0x00000000);
INADDR_LOOPBACK  :: u32(0x7F000001);
INADDR_BROADCAST :: u32(0xFFFFFFFF);

// Directory entry types (DT_*)
DT_UNKNOWN :: u8(0);
DT_FIFO    :: u8(1);
DT_CHR     :: u8(2);
DT_DIR     :: u8(4);
DT_BLK     :: u8(6);
DT_REG     :: u8(8);
DT_LNK     :: u8(10);
DT_SOCK    :: u8(12);
DT_WHT     :: u8(14);

// ============================================================================
// Access Mode Constants (for access/faccessat)
// ============================================================================
F_OK :: i32(0);   // Test for existence
R_OK :: i32(4);   // Test for read permission
W_OK :: i32(2);   // Test for write permission
X_OK :: i32(1);   // Test for execute permission

// ============================================================================
// Copyfile Flags (for copyfile)
// ============================================================================
COPYFILE_EXCL          :: i32(1);   // Fail if destination exists
COPYFILE_FICLONE       :: i32(2);   // Attempt copy-on-write clone
COPYFILE_FICLONE_FORCE :: i32(4);   // Force copy-on-write clone or fail

// ============================================================================
// Signal Constants (POSIX signals)
// ============================================================================
SIGHUP    :: i32(1);
SIGINT    :: i32(2);
SIGQUIT   :: i32(3);
SIGILL    :: i32(4);
SIGTRAP   :: i32(5);
SIGABRT   :: i32(6);
SIGBUS    :: i32(7);
SIGFPE    :: i32(8);
SIGKILL   :: i32(9);
SIGUSR1   :: i32(10);
SIGSEGV   :: i32(11);
SIGUSR2   :: i32(12);
SIGPIPE   :: i32(13);
SIGALRM   :: i32(14);
SIGTERM   :: i32(15);
SIGCHLD   :: i32(17);   // Note: 20 on macOS
SIGCONT   :: i32(18);   // Note: 19 on macOS
SIGSTOP   :: i32(19);   // Note: 17 on macOS
SIGTSTP   :: i32(20);   // Note: 18 on macOS
SIGTTIN   :: i32(21);
SIGTTOU   :: i32(22);
SIGURG    :: i32(23);
SIGXCPU   :: i32(24);
SIGXFSZ   :: i32(25);
SIGVTALRM :: i32(26);
SIGPROF   :: i32(27);
SIGWINCH  :: i32(28);

// ============================================================================
// TTY Mode Constants (libuv uv_tty_mode_t equivalent)
// ============================================================================
TTY_MODE_NORMAL :: i32(0);   // Initial/normal terminal mode
TTY_MODE_RAW    :: i32(1);   // Raw input mode
TTY_MODE_IO     :: i32(2);   // Binary-safe I/O mode (Unix-only)

// ============================================================================
// Poll Event Constants (libuv uv_poll_event equivalent)
// ============================================================================
POLL_READABLE    :: i32(1);
POLL_WRITABLE    :: i32(2);
POLL_DISCONNECT  :: i32(4);
POLL_PRIORITIZED :: i32(8);

// ============================================================================
// FS Event Flags (libuv uv_fs_event_flags equivalent)
// ============================================================================
FS_EVENT_WATCH_ENTRY :: u32(1);   // Watch the directory entry, not contents
FS_EVENT_STAT        :: u32(2);   // Use stat instead of inotify/kqueue
FS_EVENT_RECURSIVE   :: u32(4);   // Watch subdirectories (if supported)

// FS Event Types (callback event types)
FS_EVENT_RENAME :: i32(1);
FS_EVENT_CHANGE :: i32(2);

// ============================================================================
// Extern type for I/O Future
// ============================================================================

extern "Yo",
  yo_io_future_t : Type
;

// I/O Future type - opaque handle to C future struct
IOFuture :: Impl(Concrete(yo_io_future_t), Future(i32));

// ============================================================================
// Extern C runtime functions
// ============================================================================

extern "Yo",
  // ========================================================================
  // File Operations
  // ========================================================================
  __yo_async_read_start : (fn(fd: i32, buffer: *(u8), size: u32, offset: u64) -> IOFuture),
  __yo_async_write_start : (fn(fd: i32, buffer: *(u8), size: u32, offset: u64) -> IOFuture),
  __yo_async_openat_start : (fn(dirfd: i32, path: *(u8), flags: i32, mode: i32) -> IOFuture),
  __yo_async_close_start : (fn(fd: i32) -> IOFuture),
  __yo_async_statx_start : (fn(dirfd: i32, path: *(u8), flags: i32, mask: u32, statxbuf: *(u8)) -> IOFuture),
  __yo_async_mkdirat_start : (fn(dirfd: i32, path: *(u8), mode: i32) -> IOFuture),
  __yo_async_unlinkat_start : (fn(dirfd: i32, path: *(u8), flags: i32) -> IOFuture),
  __yo_async_renameat_start : (fn(olddirfd: i32, oldpath: *(u8), newdirfd: i32, newpath: *(u8)) -> IOFuture),
  __yo_async_symlinkat_start : (fn(target: *(u8), newdirfd: i32, linkpath: *(u8)) -> IOFuture),
  __yo_async_linkat_start : (fn(olddirfd: i32, oldpath: *(u8), newdirfd: i32, newpath: *(u8), flags: i32) -> IOFuture),
  __yo_async_fsync_start : (fn(fd: i32) -> IOFuture),
  __yo_async_fdatasync_start : (fn(fd: i32) -> IOFuture),
  __yo_async_ftruncate_start : (fn(fd: i32, length: i64) -> IOFuture),

  // ========================================================================
  // Directory Listing (for fs.readdir)
  // ========================================================================
  __yo_async_getdents_start : (fn(fd: i32, buf: *(u8), buf_size: u32) -> IOFuture),
  __yo_dirent_size : (fn() -> usize),
  __yo_dirent_reclen : (fn(entry: *(u8)) -> u16),
  __yo_dirent_type : (fn(entry: *(u8)) -> u8),
  __yo_dirent_name : (fn(entry: *(u8)) -> *(u8)),
  __yo_dirent_ino : (fn(entry: *(u8)) -> u64),

  // ========================================================================
