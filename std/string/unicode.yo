_XU_COUNT :: usize(102);
// Index of the range containing `cp`, or _RANGE_COUNT when none does.
_find_range :: (fn(cp : i32) -> usize)({
  (lo : usize) = usize(0);
  (hi : usize) = _RANGE_COUNT;
  while(lo < hi, {
    mid := (lo + ((hi - lo) / usize(2)));
    cond(
      (cp < _LO(mid)) => {
        hi = mid;
      },
      (cp > _HI(mid)) => {
        lo = (mid + usize(1));
      },
      true => {
        return(mid);
      }
    );
  });
  _RANGE_COUNT
});
/// The simple (one-to-one) uppercase mapping of a code point, or the code
/// point itself when it has none.
to_upper_code_point :: (fn(cp : i32) -> i32)({
  i := _find_range(cp);
  if(i == _RANGE_COUNT, {
    return(cp);
  });
  if(_UL(i) == i32(1), {
    // Alternating range: even offsets are already upper, odd ones map down by 1.
    return(if(((cp - _LO(i)) % i32(2)) == i32(0), cp, cp - i32(1)));
  });
  cp + _DU(i)
});
/// The simple (one-to-one) lowercase mapping of a code point, or the code
/// point itself when it has none.
to_lower_code_point :: (fn(cp : i32) -> i32)({
  i := _find_range(cp);
  if(i == _RANGE_COUNT, {
    return(cp);
  });
  if(_UL(i) == i32(1), {
    return(if(((cp - _LO(i)) % i32(2)) == i32(0), cp + i32(1), cp));
  });
  cp + _DL(i)
});
// Index into the expansion table, or _XU_COUNT when `cp` has no expansion.
_find_upper_expansion :: (fn(cp : i32) -> usize)({
  (lo : usize) = usize(0);
  (hi : usize) = _XU_COUNT;
  while(lo < hi, {
    mid := (lo + ((hi - lo) / usize(2)));
    cond(
      (cp < _XU_CP(mid)) => {
        hi = mid;
      },
      (cp > _XU_CP(mid)) => {
        lo = (mid + usize(1));
      },
      true => {
        return(mid);
      }
    );
  });
  _XU_COUNT
});
_push_cp :: (fn(cp : i32, out : ArrayList(u8)) -> unit)({
  utf8.encode_lossy_into(u32(cp), out);
});
// One-to-many lowercase expansions: SpecialCasing has exactly one
// unconditional entry — İ (U+0130) → i + U+0307 COMBINING DOT ABOVE.
_special_to_lower :: (fn(cp : i32, out : ArrayList(u8)) -> bool)(
  if(cp == i32(0x0130), {
    out.push(u8(0x69));
    _push_cp(i32(0x0307), out);
    true
  }, false)
);
_special_to_upper :: (fn(cp : i32, out : ArrayList(u8)) -> bool)({
  i := _find_upper_expansion(cp);
  if(i == _XU_COUNT, {
    return(false);
  });
  _push_cp(_XU_A(i), out);
  _push_cp(_XU_B(i), out);
  if(_XU_C(i) != i32(0), {
    _push_cp(_XU_C(i), out);
  });
  true
});
/// Lowercase UTF-8 bytes using the Unicode case mapping (all scripts, plus
/// the `İ` → `i̇` expansion). Locale-independent. `String.to_lowercase` calls
/// this; the input must be valid UTF-8 (a `String` always is).
to_lowercase_bytes :: (fn(input : ArrayList(u8)) -> ArrayList(u8))({
  (bytes : ArrayList(u8)) = input;
  (out : ArrayList(u8)) = ArrayList(u8).with_capacity(bytes.len());
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    (b0 : i32) = i32(bytes(i));
    // Fast path for ASCII
    if((b0 & i32(0x80)) == i32(0), {
      if((b0 >= i32(0x41)) && (b0 <= i32(0x5A)), {
        out.push(u8(b0 + i32(0x20)));
      }, {
        out.push(u8(b0));
      });
      i = (i + usize(1));
    }, {
      // Multi-byte UTF-8: decode codepoint through the shared decoder
      (result : utf8.Decoded) = utf8.decode_lossy(bytes, i);
      (cp : i32) = i32(result.code.to_u32());
      (len : usize) = result.width;
      if(!_special_to_lower(cp, out), {
        _push_cp(to_lower_code_point(cp), out);
      });
      i = (i + len);
    });
  });
  out
});
/// Uppercase UTF-8 bytes using the Unicode case mapping (all scripts, plus
/// the one-to-many expansions such as `ß` → `SS` and `ﬁ` → `FI`).
/// Locale-independent. `String.to_uppercase` calls this; the input must be
/// valid UTF-8 (a `String` always is).
to_uppercase_bytes :: (fn(input : ArrayList(u8)) -> ArrayList(u8))({
  (bytes : ArrayList(u8)) = input;
  (out : ArrayList(u8)) = ArrayList(u8).with_capacity(bytes.len());
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    (b0 : i32) = i32(bytes(i));
    // Fast path for ASCII
    if((b0 & i32(0x80)) == i32(0), {
      if((b0 >= i32(0x61)) && (b0 <= i32(0x7A)), {
        out.push(u8(b0 - i32(0x20)));
      }, {
        out.push(u8(b0));
      });
      i = (i + usize(1));
    }, {
      // Multi-byte UTF-8: decode codepoint through the shared decoder
      (result : utf8.Decoded) = utf8.decode_lossy(bytes, i);
      (cp : i32) = i32(result.code.to_u32());
      (len : usize) = result.width;
      if(!_special_to_upper(cp, out), {
        _push_cp(to_upper_code_point(cp), out);
      });
      i = (i + len);
    });
  });
  out
});
export(to_lowercase_bytes, to_uppercase_bytes, to_upper_code_point, to_lower_code_point);
