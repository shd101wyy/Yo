//! Unicode-aware case conversion using full case folding rules.
//!
//! # Example
//!
//! ```rust
//! { unicode_to_lowercase, unicode_to_uppercase } :: import "std/string/unicode";
//!
//! lower := unicode_to_lowercase(`HELLO WÖRLD`);  // "hello wörld"
//! upper := unicode_to_uppercase(`hello wörld`);  // "HELLO WÖRLD"
//! ```
pragma(Pragma.AllowUnsafe);
open(import("../string"));
{ ArrayList } :: import("../collections/array_list");
utf8 :: import("../encoding/utf8");
// Declare towlower/towupper directly with i32 to avoid wint_t cast issues.
// On all major platforms, wint_t is compatible with int/i32.
c_include(
  "<wctype.h>",
  towlower :
    (fn(wc : i32) -> i32),
  towupper :
    (
      fn(wc : i32) -> i32
    )
);
// Encode a codepoint that came back from C's `towlower`/`towupper` as an
// `i32`. Those return their argument unchanged when there is no mapping, so
// the value is normally a scalar already; anything that is not (a negative
// WEOF, a surrogate) becomes U+FFFD rather than invalid UTF-8.
_push_cp :: (fn(cp : i32, out : ArrayList(u8)) -> unit)({
  utf8.encode_lossy_into(u32(cp), out);
});
// Special case folding: codepoints that expand to multiple codepoints
// when lowercased. These are Unicode case folding entries of type 'F' (full).
_special_to_lower :: (fn(cp : i32, out : ArrayList(u8)) -> bool)(
  cond(
    // ẞ (U+1E9E LATIN CAPITAL LETTER SHARP S) → ss
    (cp == i32(0x1E9E)) => {
      out.push(u8(0x73)); // s
      out.push(u8(0x73)); // s
      true
    },
    // İ (U+0130 LATIN CAPITAL LETTER I WITH DOT ABOVE) → i + combining dot above
    (cp == i32(0x0130)) => {
      out.push(u8(0x69)); // i
      // U+0307 COMBINING DOT ABOVE
      _push_cp(i32(0x0307), out);
      true
    },
    true => false
  )
);
// Special case folding: codepoints that expand to multiple codepoints
// when uppercased.
_special_to_upper :: (fn(cp : i32, out : ArrayList(u8)) -> bool)(
  cond(
    // ß (U+00DF LATIN SMALL LETTER SHARP S) → SS
    (cp == i32(0x00DF)) => {
      out.push(u8(0x53)); // S
      out.push(u8(0x53)); // S
      true
    },
    // ﬀ (U+FB00 LATIN SMALL LIGATURE FF) → FF
    (cp == i32(0xFB00)) => {
      out.push(u8(0x46)); // F
      out.push(u8(0x46)); // F
      true
    },
    // ﬁ (U+FB01 LATIN SMALL LIGATURE FI) → FI
    (cp == i32(0xFB01)) => {
      out.push(u8(0x46)); // F
      out.push(u8(0x49)); // I
      true
    },
    // ﬂ (U+FB02 LATIN SMALL LIGATURE FL) → FL
    (cp == i32(0xFB02)) => {
      out.push(u8(0x46)); // F
      out.push(u8(0x4C)); // L
      true
    },
    // ﬃ (U+FB03 LATIN SMALL LIGATURE FFI) → FFI
    (cp == i32(0xFB03)) => {
      out.push(u8(0x46)); // F
      out.push(u8(0x46)); // F
      out.push(u8(0x49)); // I
      true
    },
    // ﬄ (U+FB04 LATIN SMALL LIGATURE FFL) → FFL
    (cp == i32(0xFB04)) => {
      out.push(u8(0x46)); // F
      out.push(u8(0x46)); // F
      out.push(u8(0x4C)); // L
      true
    },
    // ﬅ (U+FB05 LATIN SMALL LIGATURE LONG S T) → ST
    (cp == i32(0xFB05)) => {
      out.push(u8(0x53)); // S
      out.push(u8(0x54)); // T
      true
    },
    // ﬆ (U+FB06 LATIN SMALL LIGATURE ST) → ST
    (cp == i32(0xFB06)) => {
      out.push(u8(0x53)); // S
      out.push(u8(0x54)); // T
      true
    },
    true => false
  )
);
// Convert a String to lowercase using Unicode-aware case mapping.
/// Convert a `String` to lowercase using Unicode case mapping rules.
/// Handles both ASCII and non-ASCII codepoints, plus special multi-char expansions (e.g., ẞ → ss).
unicode_to_lowercase :: (fn(input : String) -> String)({
  (bytes : ArrayList(u8)) = input.as_bytes();
  (out : ArrayList(u8)) = ArrayList(u8).with_capacity(bytes.len());
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    (b0 : i32) = i32(bytes(i));
    // Fast path for ASCII
    if((b0 & i32(0x80)) == i32(0), {
      if((b0 >= i32(0x41)) && (b0 <= i32(0x5A)), {
        out.push(u8(b0 + i32(0x20)));
      }, {
        out.push(u8(b0));
      });
      i = (i + usize(1));
    }, {
      // Multi-byte UTF-8: decode codepoint through the shared decoder
      (result : utf8.Decoded) = utf8.decode_lossy(bytes, i);
      (cp : i32) = i32(result.code.to_u32());
      (len : usize) = result.width;
      // Try special case folding first
      if(!(_special_to_lower(cp, out)), {
        // Use C towlower for standard Unicode lowercase
        (lower : i32) = i32(unsafe(towlower(cp)));
        _push_cp(lower, out);
      });
      i = (i + len);
    });
  });
  String.from_bytes(out)
});
// Convert a String to uppercase using Unicode-aware case mapping.
/// Convert a `String` to uppercase using Unicode case mapping rules.
/// Handles both ASCII and non-ASCII codepoints, plus special multi-char expansions (e.g., ß → SS).
unicode_to_uppercase :: (fn(input : String) -> String)({
  (bytes : ArrayList(u8)) = input.as_bytes();
  (out : ArrayList(u8)) = ArrayList(u8).with_capacity(bytes.len());
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    (b0 : i32) = i32(bytes(i));
    // Fast path for ASCII
    if((b0 & i32(0x80)) == i32(0), {
      if((b0 >= i32(0x61)) && (b0 <= i32(0x7A)), {
        out.push(u8(b0 - i32(0x20)));
      }, {
        out.push(u8(b0));
      });
      i = (i + usize(1));
    }, {
      // Multi-byte UTF-8: decode codepoint through the shared decoder
      (result : utf8.Decoded) = utf8.decode_lossy(bytes, i);
      (cp : i32) = i32(result.code.to_u32());
      (len : usize) = result.width;
      // Try special case folding first
      if(!(_special_to_upper(cp, out)), {
        // Use C towupper for standard Unicode uppercase
        (upper : i32) = i32(unsafe(towupper(cp)));
        _push_cp(upper, out);
      });
      i = (i + len);
    });
  });
  String.from_bytes(out)
});
export(unicode_to_lowercase, unicode_to_uppercase);
