//! Immutable UTF-8 string type with comprehensive operations.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("../collections/array_list.yo");
{ rune } :: import("./rune.yo");
// The shared UTF-8 primitives (std/encoding/utf8) — one decoder for the whole
// tree. That module deliberately imports nothing above this layer (only
// ./rune.yo and ../collections/array_list.yo), so importing it here does NOT
// pull std/error or std/fmt into String's dependency cycle.
utf8 :: import("../encoding/utf8.yo");
// The Unicode 15.1 case-mapping tables (a LEAF module — bytes in, bytes out)
// behind `to_lowercase`/`to_uppercase`. Imported here rather than the other
// way round so the String methods and the tables never form a cycle.
unicode_case :: import("./unicode.yo");
{ memcpy, memcmp, strlen } :: import("../libc/string.yo");
{ atof } :: import("../libc/stdlib.yo");
{ fwrite, stderr } :: import("../libc/stdio.yo");
// Pointer-identity builtin for the interned `==` fast path below, called
// DIRECTLY (not via the Eq(*(T)) trait impl): a trait-method `==` on
// pointers inside this `||` triggers a pre-existing yo-self emission bug
// (short_circuit_rc_temp_drop corpus DIFF, rc=133 — see
// issues/fixed/yo-self-ptr-eq-trait-call-in-shortcircuit.md), and the direct
// builtin also skips trait dispatch in the hottest function in the
// compiler. Same local-extern pattern as std/gc.yo.
extern(
  "Yo",
  __yo_ptr_eq : (fn(generic(T : Type), ptr1 : T, ptr2 : T) -> bool)
);
{ GlobalAllocator } :: import("../allocator.yo");
{ malloc } :: GlobalAllocator;
/// String operation error variants.
StringError :: enum(
  /// The input bytes are not valid UTF-8. `cause` says exactly what is wrong
  /// and at which byte offset.
  InvalidUtf8(cause : utf8.Utf8Error),
  /// The index is out of bounds for the string's byte length.
  IndexOutOfBounds(index : usize, length : usize)
);
/// Growable UTF-8 encoded string — the same shape as Rust's `String`.
///
/// NOT immutable: `push_str` / `push_string` / `push_byte` / `reserve` / `clear`
/// take `inout(self)` and mutate in place. Operators such as `+` still return a
/// new string. For an immutable, atomically reference-counted string that is safe
/// to share across threads, see `std/imm/string`.
///
/// Empty strings use zero allocation (represented as `Option.None` internally).
String :: newtype(
  _bytes : Option(ArrayList(u8))
);
impl(
  String,
  /**
  * Create a new empty string (zero allocation)
  */
  new : (fn() -> Self)(
    Self(_bytes : .None)
  ),
  /**
  * Create a new empty string with pre-allocated capacity for the given number of bytes.
  * The string starts empty but can hold `capacity` bytes without reallocating.
  */
  with_capacity : (fn(capacity : usize) -> Self)(
    cond(
      (capacity == usize(0)) => Self(_bytes : .None),
      true => Self(_bytes : .Some(ArrayList(u8).with_capacity(capacity)))
    )
  ),
  /**
  * Create a string from raw bytes WITHOUT checking that they are UTF-8.
  *
  * This is the unchecked constructor: the caller guarantees validity, and
  * nothing scans the buffer. Use it when the bytes came from something that
  * already produced UTF-8 — another `String`, a UTF-8 encoder, a byte-exact
  * slice taken at rune boundaries. For bytes of unknown provenance (a file, a
  * socket, a subprocess) use `from_utf8`, which validates and reports where
  * the input went wrong.
  */
  from_bytes : (fn(bytes : ArrayList(u8)) -> Self)(
    cond(
      (bytes.len() == usize(0)) => Self(_bytes : .None),
      true => Self(_bytes : .Some(bytes))
    )
  ),
  /**
  * Create a string from raw bytes, checking that they are valid UTF-8.
  *
  * The checked counterpart to `from_bytes`: `Err(StringError.InvalidUtf8)`
  * carries a `Utf8Error` naming the defect and the byte offset it starts at.
  * Validation is a single linear scan through `std/encoding/utf8`.
  */
  from_utf8 : (fn(bytes : ArrayList(u8)) -> Result(Self, StringError))(
    match(
      utf8.validate(bytes),
      .Ok(_) => .Ok(Self.from_bytes(bytes)),
      .Err(cause) => .Err(.InvalidUtf8(cause))
    )
  ),
  /**
  * Create a string from a slice of bytes str
  * The slice is a fat pointer containing data pointer and length
  * Example: String.from(slice) where slice is str
  */
  from : (fn(slice : str) -> Self)({
    slen := slice.len();
    if(slen == usize(0), {
      return(Self(_bytes : .None));
    });
    bytes := ArrayList(u8).with_capacity(slen);
    bytes.extend_from_ptr(slice.ptr(), slen);
    return(Self(_bytes : .Some(bytes)));
  }),
  /**
  * Create a string from a C null-terminated string *(u8)
  * Copies bytes until it finds a null byte (0)
  * Example: String.from_cstr(c_string_ptr)
  *
  * Note: We manually search for the null terminator by iterating
  */
  from_cstr : (fn(cstr : *u8) -> Result(Self, StringError))({
    // SAFETY: caller's contract — `cstr` must point at a null-terminated byte
    // sequence (the standard C string invariant). `strlen` walks forward until
    // it hits the null byte and returns the count not including it. If the
    // caller passes a non-null-terminated buffer, the read walks past the end;
    // this is the same trust boundary as `<string.h>`'s `strlen`.
    len := unsafe(strlen((*char)(cstr)));
    if(len == usize(0), {
      return(.Ok(Self(_bytes : .None)));
    });
    bytes := ArrayList(u8).with_capacity(len);
    bytes.extend_from_ptr(cstr, len);
    return(.Ok(Self(_bytes : .Some(bytes))));
  }),
  /// Convert the string to a null-terminated C string.
  /// Returns an `ArrayList(u8)` with the string bytes followed by a `\0`.
  to_cstr : (fn(self : Self) -> ArrayList(u8))({
    (bytes_len : usize) = match(
      self._bytes,
      .Some(b) => b.len(),
      .None => usize(0)
    );
    bytes_with_null := ArrayList(u8).with_capacity(bytes_len + usize(1));
    match(
      self._bytes,
      .Some(b) => match(
        b.ptr(),
        .Some(src) => bytes_with_null.extend_from_ptr(src, bytes_len),
        .None => ()
      ),
      .None => ()
    );
    bytes_with_null.push(u8(0));
    return(bytes_with_null);
  }),
  /// Number of BYTES in this string's UTF-8 encoding — O(1).
  ///
  /// **BYTE basis.** This is the unit every index-taking method on `String`
  /// speaks: `at`, `substring`, the `s(a..b)` / `s(a..=b)` slice sugar,
  /// `index_of`, `last_index_of`, `contains(from_index)`,
  /// `starts_with(position)`, `ends_with(end_position)` and the `Pattern`
  /// trait. It agrees with `str.len()`, `StringBuilder.len()`, `Index(usize)`
  /// (which yields a `u8`) and Rust's `str::len()`.
  ///
  /// For "how many runes" use `chars().count()` (O(n)); to walk runes together with
  /// the byte offset each one starts at, use `char_indices()`.
  /// (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 3 — this returned a RUNE count
  /// before that flip.)
  len : (fn(self : Self) -> usize)(
    match(self._bytes, .Some(b) => b.len(), .None => usize(0))
  ),
  /**
  * Check if the string is empty
  */
  is_empty : (fn(self : Self) -> bool)(
    match(
      self._bytes,
      .None => true,
      .Some(al) => (al.len() == usize(0))
    )
  ),
  /**
  * Get a reference to the internal byte array
  * Returns an empty ArrayList if the string is empty
  */
  as_bytes : (fn(self : Self) -> ArrayList(u8))(
    match(
      self._bytes,
      .None => ArrayList(u8).new(),
      .Some(al) => al
    )
  ),
  // as_bytes : (fn(self: Self) -> ArrayList(u8))({
  //   return self._bytes;
  // }),
  /**
  * Get a str view into the string's UTF-8 bytes
  * Returns a fat pointer (pointer + length) without copying
  */
  /**
  * PRIVILEGED raw view of the heap buffer (ptr + byte length) for C
  * interop and pragma'd std internals. Naming RawSlice requires
  * pragma(Pragma.AllowUnsafe); the view dangles if the String mutates
  * or dies — callers must not let it escape the borrow site.
  * (This replaces the deleted `as_str()`: heap bytes can no longer be
  * viewed as `str`, which is the STATIC string view.
  * See plans/archive/SLICE_REWORK.md.)
  */
  raw_bytes : (fn(self : Self) -> RawSlice(u8))(
    match(
      self._bytes,
      .None => RawSlice(u8)(ptr : (*u8)(""), len : usize(0)),
      .Some(al) => match(
        al._ptr,
        .Some(p) => RawSlice(u8)(ptr : p, len : al._length),
        .None => RawSlice(u8)(ptr : (*u8)(""), len : usize(0))
      )
    )
  ),
  /**
  * Decode a UTF-8 encoded rune starting at the given byte index
  * Internal helper method
  */
  _decode_rune_at : (fn(self : Self, byte_index : usize) -> Option(rune))(
    match(
      self._bytes,
      .None => .None,
      .Some(bytes) =>
        match(
          utf8.decode(bytes, byte_index),
          .Ok(d) => .Some(d.code),
          .Err(_) => .None
        )
    )
  ),
  /// True when byte offset `index` sits on a rune boundary.
  ///
  /// `0` and `len()` are always boundaries; an index past the end never is.
  /// Mirrors Rust's `str::is_char_boundary`. (Defined here, beside `at` and
  /// `substring`, because an `impl` block cannot call forward into a later
  /// one and both of those need it.)
  is_char_boundary : (fn(self : Self, index : usize) -> bool)(
    match(
      self._bytes,
      .None => (index == usize(0)),
      .Some(al) => {
        n := al.len();
        cond(
          (index == usize(0)) => true,
          (index == n) => true,
          (index > n) => false,
          true => match(
            al.get(index),
            .Some(b) => utf8.is_boundary(b),
            .None => false
          )
        )
      }
    )
  ),
  /// Decode the rune that STARTS at byte offset `index`.
  ///
  /// **BYTE basis** (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 3 — this took a
  /// rune index before the flip). `.None` is returned for the three ways a
  /// byte offset can fail to name a rune: at or past `len()`, inside a rune
  /// (a UTF-8 continuation byte), or on bytes that do not decode.
  ///
  /// `while(i < s.len(), { s.at(i) })` therefore visits continuation bytes and
  /// yields `.None` at each of them — use `char_indices()` (or `chars()`) to
  /// walk runes.
  at : (fn(self : Self, index : usize) -> Option(rune))(
    self._decode_rune_at(index)
  ),
  /**
  * Concatenate two strings (like JavaScript +)
  */
  concat : (fn(self : Self, other : Self) -> Self)({
    (self_len : usize) = match(self._bytes, .Some(b) => b.len(), .None => usize(0));
    (other_len : usize) = match(other._bytes, .Some(b) => b.len(), .None => usize(0));
    if((self_len == usize(0)) && (other_len == usize(0)), {
      return(Self(_bytes : .None));
    });
    new_bytes := ArrayList(u8).with_capacity(self_len + other_len);
    match(
      self._bytes,
      .Some(b) => match(
        b.ptr(),
        .Some(p) => new_bytes.extend_from_ptr(p, self_len),
        .None => ()
      ),
      .None => ()
    );
    match(
      other._bytes,
      .Some(b) => match(
        b.ptr(),
        .Some(p) => new_bytes.extend_from_ptr(p, other_len),
        .None => ()
      ),
      .None => ()
    );
    return(Self(_bytes : .Some(new_bytes)));
  }),
  /// Append another `String` to this string in-place (mutates `self`).
  push_string : (fn(inout(self) : Self, other : Self) -> unit)({
    (olen : usize) = match(other._bytes, .Some(b) => b.len(), .None => usize(0));
    if(olen > usize(0), {
      match(
        other._bytes,
        .Some(ob) => match(
          ob.ptr(),
          .Some(p) => {
            match(
              self._bytes,
              .None => {
                (new_al : ArrayList(u8)) = ArrayList(u8).with_capacity(olen);
                new_al.extend_from_ptr(p, olen);
                self._bytes = .Some(new_al);
              },
              .Some(al) => {
                al.extend_from_ptr(p, olen);
              }
            );
          },
          .None => ()
        ),
        .None => ()
      );
    });
  }),
  /// Append a `str` slice to this string in-place (mutates `self`).
  push_str : (fn(inout(self) : Self, s : str) -> unit)({
    (slen : usize) = s.len();
    if(slen > usize(0), {
      match(
        self._bytes,
        .None => {
          (new_al : ArrayList(u8)) = ArrayList(u8).with_capacity(slen);
          new_al.extend_from_ptr(s.ptr(), slen);
          self._bytes = .Some(new_al);
        },
        .Some(al) => {
          al.extend_from_ptr(s.ptr(), slen);
        }
      );
    });
  }),
  /// Append a single byte to this string in-place (mutates `self`).
  /// The caller must ensure the byte maintains valid UTF-8.
  push_byte : (fn(inout(self) : Self, b : u8) -> unit)({
    match(
      self._bytes,
      .None => {
        (new_al : ArrayList(u8)) = ArrayList(u8).with_capacity(usize(8));
        new_al.push(b);
        self._bytes = .Some(new_al);
      },
      .Some(al) => {
        al.push(b);
      }
    );
  }),
  /// Reserve capacity for at least `additional` more bytes.
  /// If the string is empty, creates a new buffer with the given capacity.
  reserve : (fn(inout(self) : Self, additional : usize) -> unit)({
    match(
      self._bytes,
      .None => {
        self._bytes = .Some(ArrayList(u8).with_capacity(additional));
      },
      .Some(al) => {
        (current_len : usize) = al.len();
        al.ensure_total_capacity(current_len + additional);
      }
    );
  }),
  /// Clear the string content but keep the allocated buffer for reuse.
  clear : (fn(inout(self) : Self) -> unit)(
    match(
      self._bytes,
      .Some(al) => al.clear(),
      .None => ()
    )
  ),
  // (Inherent `clone` removed; the Clone trait impl below provides
  // the same semantics via inout(self) : Self after the Phase D
  // migration. Calling `s.clone()` resolves to the trait method.)
  /// Get the byte at the given index. Panics if the index is out of
  /// bounds (mirrors `str`'s byte indexing). Use `len()` for the
  /// valid range and `bytes()` for sequential iteration.
  byte_at : (fn(self : Self, index : usize) -> u8)(
    match(
      self._bytes,
      .Some(b) => match(
        b.get(index),
        .Some(v) => v,
        .None => __yo_panic("String.byte_at: index out of bounds")
      ),
      .None => __yo_panic("String.byte_at: index out of bounds")
    )
  ),
  /// Owned copy of the BYTES in `[r.start, r.end)` — `s(a..b)` lowers to this.
  ///
  /// Same contract as `substring`, including the boundary policy: an endpoint
  /// inside a rune panics.
  slice_copy : (fn(self : Self, r : Range(usize)) -> Self)(
    self.substring(r.start, r.end)
  ),
  /// Inclusive-range companion (`s(a..=b)`) — BYTE offsets, `r.end` included.
  ///
  /// Because `r.end` is the LAST byte kept, it must be the last byte of a
  /// rune for `r.end + 1` to land on a boundary; otherwise this panics like
  /// `substring`.
  slice_copy_inclusive : (fn(self : Self, r : RangeInclusive(usize)) -> Self)(
    self.substring(r.start, r.end + usize(1))
  ),
  /// Owned copy of the bytes in `[start, end)`.
  ///
  /// **BYTE basis** (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 3 — these were
  /// rune indices before the flip).
  ///
  /// **Boundary policy, in full:**
  /// - Out-of-range CLAMPS. `start` and `end` past `len()` are pulled back to
  ///   `len()`, and `start >= end` yields the empty string. This is the
  ///   forgiving behaviour `substring` has always had, and it is kept.
  /// - A non-boundary index PANICS. An endpoint inside a rune is a programmer
  ///   error — a byte offset that came from the wrong basis — not a range
  ///   condition, and honouring it would hand back invalid UTF-8.
  /// - `try_substring(start, end)` is the non-panicking form: it returns
  ///   `.None` for a bad range instead of clamping or panicking.
  /// - `floor_char_boundary` / `ceil_char_boundary` snap an arbitrary offset
  ///   onto a boundary first, for callers doing byte arithmetic.
  /// - Rune-indexed slicing has no method form — walk `char_indices()`
  ///   for byte offsets and slice with those.
  substring : (fn(self : Self, start : usize, end : usize) -> Self)(
    match(
      self._bytes,
      .None => {
        return(Self(_bytes : .None));
      },
      .Some(al) => {
        (total_bytes : usize) = al.len();
        (start_byte : usize) = cond(
          (start > total_bytes) => total_bytes,
          true => start
        );
        (end_byte : usize) = cond(
          (end > total_bytes) => total_bytes,
          true => end
        );
        if(!self.is_char_boundary(start_byte), {
          __yo_panic("String.substring: start is not on a UTF-8 character boundary");
        });
        if(!self.is_char_boundary(end_byte), {
          __yo_panic("String.substring: end is not on a UTF-8 character boundary");
        });
        if(start_byte >= end_byte, {
          return(Self(_bytes : .None));
        });
        (count : usize) = (end_byte - start_byte);
        new_bytes := ArrayList(u8).with_capacity(count);
        match(
          al.ptr(),
          .Some(src_p) => new_bytes.extend_from_ptr(src_p.add(start_byte), count),
          .None => ()
        );
        Self(_bytes : .Some(new_bytes))
      }
    )
  ),
  /// Byte offset of the first occurrence of `substr` at or after `from_index`.
  ///
  /// **BYTE basis, in AND out** (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 3 —
  /// both were rune indices before the flip). `from_index` is a byte offset;
  /// the returned index is the byte offset the match starts at, so it can be
  /// fed straight back into `substring`.
  ///
  /// `from_index` needs no boundary check and gets none: UTF-8 is
  /// self-synchronizing, so a valid-UTF-8 needle can never match starting at a
  /// continuation byte. Starting the scan mid-rune therefore cannot invent a
  /// match, and for a NON-EMPTY needle every index this returns is a rune
  /// boundary at or before `len()`.
  ///
  /// **The empty needle is the one exception, and it is deliberate.** It
  /// matches everywhere, so `index_of(``, i)` answers `.Some(i)` verbatim —
  /// including an `i` inside a rune and an `i` past `len()` (JavaScript's
  /// `indexOf("")` clamps to the length; this does not, and neither did the
  /// pre-D4 rune-indexed version). An offset past the end is harmless
  /// downstream because `substring` clamps, but a MID-RUNE one is not:
  /// `substring` panics there. Callers that feed a search result straight back
  /// into a slice and can be handed an empty needle should go through
  /// `try_substring`, or snap with `floor_char_boundary`.
  /// Not called directly — go through `index_of`.
  _index_of_impl : (fn(self : Self, substr : Self, (from_index : usize) ?= 0) -> Option(usize))(
    cond(
      substr.is_empty() => .Some(from_index),
      true => {
        (self_bytes : usize) = match(self._bytes, .Some(b) => b.len(), .None => usize(0));
        (sub_bytes : usize) = match(substr._bytes, .Some(b) => b.len(), .None => usize(0));
        cond(
          (sub_bytes > self_bytes) => .None,
          (from_index > (self_bytes - sub_bytes)) => .None,
          true => match(
            self._bytes,
            .None => .None,
            .Some(self_al) => match(
              substr._bytes,
              .None => .None,
              .Some(sub_al) => {
                (last_start : usize) = (self_bytes - sub_bytes);
                byte_index := from_index;
                while(byte_index <= last_start, byte_index = (byte_index + usize(1)), {
                  matches := true;
                  j := usize(0);
                  while(j < sub_bytes, j = (j + usize(1)), {
                    self_byte_opt := self_al.get(byte_index + j);
                    sub_byte_opt := sub_al.get(j);
                    match(
                      self_byte_opt,
                      .Some(self_byte) =>
                        match(
                          sub_byte_opt,
                          .Some(sub_byte) => {
                            cond(
                              (self_byte != sub_byte) => {
                                matches = false;
                                break;
                              },
                              true => ()
                            );
                          },
                          .None => {
                            matches = false;
                            break;
                          }
                        ),
                      .None => {
                        matches = false;
                        break;
                      }
                    );
                  });
                  cond(
                    matches => {
                      return(.Some(byte_index));
                    },
                    true => ()
                  );
                });
                return(.None);
              }
            )
          )
        )
      }
    )
  ),
  /// Private: is `substr` present at or after BYTE offset `from_index`?
  ///
  /// **BYTE basis** for `from_index` (`plans/STD_API_AUDIT_D4_PLAN.md` D4
  /// PR 3 — it was a rune index before the flip). Not called directly — go
  /// through `contains`.
  _contains_impl : (fn(self : Self, substr : Self, (from_index : usize) ?= 0) -> bool)(
    match(
      self._index_of_impl(substr, from_index),
      .Some(_) => true,
      .None => false
    )
  ),
  /**
  * Split the string by a separator into an array of strings (like JavaScript split)
  * Returns an ArrayList of String
  */
  _split_impl : (fn(self : Self, separator : Self) -> ArrayList(Self))({
    result := ArrayList(Self).new();
    cond(
      // The empty separator means "split into CHARACTERS", and it has to keep
      // meaning that after `plans/STD_API_AUDIT_D4_PLAN.md` rebases `len()`
      // and `substring` onto bytes — a byte split would hand back fragments
      // that are not valid UTF-8. Pinned to the rune vocabulary (§5.2 S5).
      separator.is_empty() => {
        // One `utf8.step_len` pass: each rune's slice runs from its own byte
        // offset to the next rune's, so this is O(n) where the old per-index
        // rune-slice loop re-walked from the start each time (O(n^2)).
        // Inlined rather than `char_indices()` because that iterator lives in
        // a LATER impl block, and impl blocks cannot call forward.
        match(
          self._bytes,
          .None => {
            return(result);
          },
          .Some(al) => {
            total := al.len();
            (pos : usize) = usize(0);
            while(pos < total, {
              (w : usize) = utf8.step_len(al(pos));
              result.push(self.substring(pos, pos + w));
              pos = (pos + w);
            });
            return(result);
          }
        );
      },
      self.is_empty() => {
        result.push(new());
        return(result);
      },
      true => match(
        self._bytes,
        .None => {
          result.push(new());
          return(result);
        },
        .Some(self_al) => match(
          separator._bytes,
          .None => {
            result.push(self);
            return(result);
          },
          .Some(sep_al) => {
            self_bytes := self_al.len();
            sep_bytes := sep_al.len();
            current_bytes := ArrayList(u8).new();
            byte_index := usize(0);
            while(byte_index < self_bytes, byte_index = (byte_index + usize(1)), {
              matches := true;
              cond(
                ((byte_index + sep_bytes) <= self_bytes) => {
                  j := usize(0);
                  while(j < sep_bytes, j = (j + usize(1)), {
                    self_byte_opt := self_al.get(byte_index + j);
                    sep_byte_opt := sep_al.get(j);
                    match(
                      self_byte_opt,
                      .Some(self_byte) =>
                        match(
                          sep_byte_opt,
                          .Some(sep_byte) => {
                            cond(
                              (self_byte != sep_byte) => {
                                matches = false;
                                break;
                              },
                              true => ()
                            );
                          },
                          .None => {
                            matches = false;
                            break;
                          }
                        ),
                      .None => {
                        matches = false;
                        break;
                      }
                    );
                  });
                },
                true => {
                  matches = false;
                }
              );
              cond(
                matches => {
                  cond(
                    (current_bytes.len() == usize(0)) => result.push(Self(_bytes : .None)),
                    true => result.push(Self(_bytes : .Some(current_bytes)))
                  );
                  current_bytes = ArrayList(u8).new();
                  byte_index = ((byte_index + sep_bytes) - usize(1));
                },
                true => {
                  byte_opt := self_al.get(byte_index);
                  match(
                    byte_opt,
                    .Some(byte) => {
                      current_bytes.push(byte);
                    },
                    .None => ()
                  );
                }
              );
            });
            cond(
              (current_bytes.len() == usize(0)) => result.push(Self(_bytes : .None)),
              true => result.push(Self(_bytes : .Some(current_bytes)))
            );
            return(result);
          }
        )
      )
    )
  }),
  /// Byte offset of the LAST occurrence of `substr` starting at or before
  /// `from_index`.
  ///
  /// **BYTE basis, in AND out** (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 3 —
  /// both were rune indices before the flip). `from_index` is the highest byte
  /// offset a match is allowed to START at; the default `usize.MAX` means
  /// "anywhere". The result is the byte offset of the match, and for a
  /// non-empty needle it is always a rune boundary.
  ///
  /// **The empty needle answers `len()` regardless of `from_index`** (Rust's
  /// `rfind("")` shape), so it is the one case where the result can exceed the
  /// cap the caller asked for. That is the pre-D4 behaviour carried over
  /// unchanged — only the unit changed, from a rune count to a byte count.
  /// Not called directly — go through `last_index_of`.
  _last_index_of_impl : (fn(self : Self, substr : Self, (from_index : usize) ?= usize.MAX) -> Option(usize))(
    cond(
      substr.is_empty() => .Some(self.len()),
      true => match(
        self._bytes,
        .None => .None,
        .Some(self_al) => match(
          substr._bytes,
          .None => .None,
          .Some(sub_al) => {
            self_bytes := self_al.len();
            sub_bytes := sub_al.len();
            cond(
              (sub_bytes > self_bytes) => .None,
              true => {
                (last_start : usize) = (self_bytes - sub_bytes);
                (highest : usize) = cond(
                  (from_index > last_start) => last_start,
                  true => from_index
                );
                // Walk DOWN from the highest allowed start, so the first hit is
                // the last occurrence. `cursor` is one past the candidate so
                // that candidate 0 is still examined without underflowing.
                cursor := (highest + usize(1));
                while(cursor > usize(0), {
                  cursor = (cursor - usize(1));
                  matches := true;
                  j := usize(0);
                  while(j < sub_bytes, j = (j + usize(1)), {
                    self_byte_opt := self_al.get(cursor + j);
                    sub_byte_opt := sub_al.get(j);
                    match(
                      self_byte_opt,
                      .Some(self_byte) =>
                        match(
                          sub_byte_opt,
                          .Some(sub_byte) => {
                            cond(
                              (self_byte != sub_byte) => {
                                matches = false;
                                break;
                              },
                              true => ()
                            );
                          },
                          .None => {
                            matches = false;
                            break;
                          }
                        ),
                      .None => {
                        matches = false;
                        break;
                      }
                    );
                  });
                  cond(
                    matches => {
                      return(.Some(cursor));
                    },
                    true => ()
                  );
                });
                return(.None);
              }
            )
          }
        )
      )
    )
  ),
  /// Private: does this string have `prefix` starting at BYTE offset
  /// `position`?
  ///
  /// **BYTE basis** (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 3). Before the
  /// flip `position` was walked rune-by-rune — and walked WRONG: the counter
  /// advanced on a lead byte while the loop also stepped one byte, so
  /// `"你好".starts_with("好", 1)` stopped at byte 1, in the middle of `你`.
  /// That is §1.3(a) of the plan, and byte indexing removes the walk that
  /// caused it rather than repairing it.
  ///
  /// `position` is never boundary-checked: a valid-UTF-8 prefix cannot match
  /// starting at a continuation byte, so a mid-rune `position` simply answers
  /// `false`. An empty prefix is present anywhere, including past the end.
  ///
  /// The UTF-8-aware byte-compare reused by the `Pattern` impls behind the
  /// generic `starts_with<P : Pattern>` (see
  /// plans/backlog/OVERLOADING_REDESIGN.md §4). Not called directly — go
  /// through `starts_with`.
  _has_prefix : (fn(self : Self, prefix : Self, (position : usize) ?= 0) -> bool)({
    (prefix_bytes : usize) = match(prefix._bytes, .Some(b) => b.len(), .None => usize(0));
    (self_bytes : usize) = match(self._bytes, .Some(b) => b.len(), .None => usize(0));
    cond(
      (prefix_bytes == usize(0)) => true,
      // Ordered so `position + prefix_bytes` cannot overflow: the first arm
      // has already rejected every `position` beyond the byte length.
      (position > self_bytes) => false,
      ((position + prefix_bytes) > self_bytes) => false,
      true => match(
        self._bytes,
        .None => false,
        .Some(self_al) => match(
          prefix._bytes,
          .None => true,
          .Some(prefix_al) => {
            i := usize(0);
            matches := true;
            while(i < prefix_bytes, i = (i + usize(1)), {
              self_byte_opt := self_al.get(position + i);
              prefix_byte_opt := prefix_al.get(i);
              match(
                self_byte_opt,
                .Some(self_byte) =>
                  match(
                    prefix_byte_opt,
                    .Some(prefix_byte) => {
                      cond(
                        (self_byte != prefix_byte) => {
                          matches = false;
                          break;
                        },
                        true => ()
                      );
                    },
                    .None => {
                      matches = false;
                      break;
                    }
                  ),
                .None => {
                  matches = false;
                  break;
                }
              );
            });
            return(matches);
          }
        )
      )
    )
  }),
  /// Private: does the first `end_position` BYTES of this string end with
  /// `suffix`?
  ///
  /// **BYTE basis** (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 3 —
  /// `end_position` was a rune count before the flip). The default
  /// `usize.MAX` means "the whole string"; anything past `len()` clamps to it.
  /// Like `_has_prefix`, a mid-rune `end_position` needs no rejection: a
  /// valid-UTF-8 suffix cannot end there, so the answer is simply `false`.
  ///
  /// Not called directly — go through `ends_with`.
  _ends_with_impl : (fn(self : Self, suffix : Self, (end_position : usize) ?= usize.MAX) -> bool)({
    (suffix_bytes : usize) = match(suffix._bytes, .Some(b) => b.len(), .None => usize(0));
    (self_bytes : usize) = match(self._bytes, .Some(b) => b.len(), .None => usize(0));
    (effective_end : usize) = cond(
      (end_position > self_bytes) => self_bytes,
      true => end_position
    );
    cond(
      (suffix_bytes == usize(0)) => true,
      (suffix_bytes > effective_end) => false,
      true => match(
        self._bytes,
        .None => false,
        .Some(self_al) => match(
          suffix._bytes,
          .None => true,
          .Some(suffix_al) => {
            offset := (effective_end - suffix_bytes);
            i := usize(0);
            matches := true;
            while(i < suffix_bytes, i = (i + usize(1)), {
              self_byte_opt := self_al.get(offset + i);
              suffix_byte_opt := suffix_al.get(i);
              match(
                self_byte_opt,
                .Some(self_byte) =>
                  match(
                    suffix_byte_opt,
                    .Some(suffix_byte) => {
                      cond(
                        (self_byte != suffix_byte) => {
                          matches = false;
                          break;
                        },
                        true => ()
                      );
                    },
                    .None => {
                      matches = false;
                      break;
                    }
                  ),
                .None => {
                  matches = false;
                  break;
                }
              );
            });
            return(matches);
          }
        )
      )
    )
  }),
  /**
  * Uppercase using the full Unicode 15.1 case mapping (all scripts, plus the
  * one-to-many expansions such as `ß` → `SS` and `ﬁ` → `FI`). Locale-independent
  * (never consults the C locale). Context-sensitive rules (Greek final sigma,
  * Turkish dotted i) are not applied — the mapping is per code point, like
  * Go's `strings.ToUpper`. ASCII input keeps a byte-wise fast path.
  */
  to_uppercase : (fn(self : Self) -> Self)(
    match(
      self._bytes,
      .None => Self(_bytes : .None),
      .Some(_) => String.from_bytes(unicode_case.to_uppercase_bytes(self.as_bytes()))
    )
  ),
  /**
  * Lowercase using the full Unicode 15.1 case mapping (all scripts, plus the
  * `İ` → `i̇` expansion). Locale-independent. ASCII input keeps a byte-wise
  * fast path.
  */
  to_lowercase : (fn(self : Self) -> Self)(
    match(
      self._bytes,
      .None => Self(_bytes : .None),
      .Some(_) => String.from_bytes(unicode_case.to_lowercase_bytes(self.as_bytes()))
    )
  ),
  /**
  * Uppercase ASCII letters A-Z only (byte-wise); all other bytes pass through
  * unchanged. The explicitly-ASCII counterpart to `to_uppercase` for when the
  * Unicode mapping must not apply (identifiers, protocol tokens, …).
  */
  to_ascii_uppercase : (fn(self : Self) -> Self)(
    match(
      self._bytes,
      .None => Self(_bytes : .None),
      .Some(al) => {
        (total : usize) = al.len();
        new_bytes := ArrayList(u8).with_capacity(total);
        i := usize(0);
        while(i < total, i = (i + usize(1)), {
          byte_opt := al.get(i);
          match(
            byte_opt,
            .Some(byte) => {
              new_byte := cond(
                ((byte >= u8(0x61)) && (byte <= u8(0x7A))) => (byte - u8(0x20)),
                true => byte
              );
              new_bytes.push(new_byte);
            },
            .None => ()
          );
        });
        Self(_bytes : .Some(new_bytes))
      }
    )
  ),
  /**
  * Lowercase ASCII letters A-Z only (byte-wise); all other bytes pass through
  * unchanged. The explicitly-ASCII counterpart to `to_lowercase`.
  */
  to_ascii_lowercase : (fn(self : Self) -> Self)(
    match(
      self._bytes,
      .None => Self(_bytes : .None),
      .Some(al) => {
        (total : usize) = al.len();
        new_bytes := ArrayList(u8).with_capacity(total);
        i := usize(0);
        while(i < total, i = (i + usize(1)), {
          byte_opt := al.get(i);
          match(
            byte_opt,
            .Some(byte) => {
              new_byte := cond(
                ((byte >= u8(0x41)) && (byte <= u8(0x5A))) => (byte + u8(0x20)),
                true => byte
              );
              new_bytes.push(new_byte);
            },
            .None => ()
          );
        });
        Self(_bytes : .Some(new_bytes))
      }
    )
  ),
  /**
  * Helper to check if a byte is ASCII whitespace
  * Space (0x20), Tab (0x09), Newline (0x0A), Carriage Return (0x0D), Form Feed (0x0C), Vertical Tab (0x0B)
  */
  _is_whitespace_byte : (fn(byte : u8) -> bool)(
    (byte == u8(0x20)) || ((byte == u8(0x09)) || ((byte == u8(0x0A)) || ((byte == u8(0x0D)) || ((byte == u8(0x0C)) || (byte == u8(0x0B))))))
  ),
  /**
  * Remove whitespace from both ends of the string (like JavaScript trim)
  */
  trim : (fn(self : Self) -> Self)(
    match(
      self._bytes,
      .None => Self(_bytes : .None),
      .Some(al) => {
        total_bytes := al.len();
        if(total_bytes == usize(0), {
          return(Self(_bytes : .None));
        });
        (start_idx : usize) = usize(0);
        while(start_idx < total_bytes, {
          (b : u8) = al(start_idx);
          if(!Self._is_whitespace_byte(b), {
            break;
          });
          start_idx = (start_idx + usize(1));
        });
        (end_idx : usize) = total_bytes;
        while(end_idx > start_idx, {
          (b : u8) = al(end_idx - usize(1));
          if(!Self._is_whitespace_byte(b), {
            break;
          });
          end_idx = (end_idx - usize(1));
        });
        if(start_idx >= end_idx, {
          return(Self(_bytes : .None));
        });
        (count : usize) = (end_idx - start_idx);
        new_bytes := ArrayList(u8).with_capacity(count);
        match(
          al.ptr(),
          .Some(p) => new_bytes.extend_from_ptr(p.add(start_idx), count),
          .None => ()
        );
        Self(_bytes : .Some(new_bytes))
      }
    )
  ),
  /**
  * Remove whitespace from the start of the string (like JavaScript trimStart)
  */
  trim_start : (fn(self : Self) -> Self)(
    match(
      self._bytes,
      .None => Self(_bytes : .None),
      .Some(al) => {
        total_bytes := al.len();
        cond(
          (total_bytes == usize(0)) => Self(_bytes : .None),
          true => {
            start_idx := usize(0);
            while(start_idx < total_bytes, start_idx = (start_idx + usize(1)), {
              byte_opt := al.get(start_idx);
              match(
                byte_opt,
                .Some(byte) => {
                  is_ws := Self._is_whitespace_byte(byte);
                  cond(
                    !is_ws => break,
                    true => ()
                  );
                },
                .None => break
              );
            });
            cond(
              (start_idx >= total_bytes) => Self(_bytes : .None),
              true => {
                (count : usize) = (total_bytes - start_idx);
                new_bytes := ArrayList(u8).with_capacity(count);
                match(
                  al.ptr(),
                  .Some(p) => new_bytes.extend_from_ptr(p.add(start_idx), count),
                  .None => ()
                );
                Self(_bytes : .Some(new_bytes))
              }
            )
          }
        )
      }
    )
  ),
  /**
  * Remove whitespace from the end of the string (like JavaScript trimEnd)
  */
  trim_end : (fn(self : Self) -> Self)(
    match(
      self._bytes,
      .None => Self(_bytes : .None),
      .Some(al) => {
        total_bytes := al.len();
        cond(
          (total_bytes == usize(0)) => Self(_bytes : .None),
          true => {
            end_idx := total_bytes;
            while(end_idx > usize(0), end_idx = (end_idx - usize(1)), {
              byte_opt := al.get(end_idx - usize(1));
              match(
                byte_opt,
                .Some(byte) => {
                  is_ws := Self._is_whitespace_byte(byte);
                  cond(
                    !is_ws => break,
                    true => ()
                  );
                },
                .None => break
              );
            });
            cond(
              (end_idx == usize(0)) => Self(_bytes : .None),
              true => {
                new_bytes := ArrayList(u8).with_capacity(end_idx);
                match(
                  al.ptr(),
                  .Some(p) => new_bytes.extend_from_ptr(p, end_idx),
                  .None => ()
                );
                Self(_bytes : .Some(new_bytes))
              }
            )
          }
        )
      }
    )
  )
);
/// Add trait implementation — concatenate two strings with `+`.
impl(
  String,
  Add(String)(
    Output : String,
    (+) : (fn(self : Self, other : Self) -> Self.Output)({
      return(self.concat(other));
    })
  )
);
/// Eq trait implementation — byte-level comparison of two strings.
impl(
  String,
  Eq(String)(
    (==) : (fn(self : Self, other : Self) -> bool)({
      // Direct field reads instead of the trivial `.len()`/`.ptr()`
      // accessors: this compare is ~38% of a yo-self stage2 emit purely
      // from call volume, and each call paid four non-inlined accessor
      // calls before the memcmp (issues/
      // yo-self-compile-performance-rc-string-eq.md, lever 1). Same
      // semantics — `len()` returns `_length`, `ptr()` returns `_ptr`.
      (self_len : usize) = match(self._bytes, .Some(b) => b._length, .None => usize(0));
      (other_len : usize) = match(other._bytes, .Some(b) => b._length, .None => usize(0));
      cond(
        (self_len != other_len) => false,
        (self_len == usize(0)) => true,
        true =>
          match(
            self._bytes,
            .Some(self_al) =>
              match(
                other._bytes,
                .Some(other_al) =>
                  match(
                    self_al._ptr,
                    .Some(self_ptr) =>
                      match(
                        other_al._ptr,
                        // SAFETY: self_len equals other_len (checked
                        // above) and both equal each ArrayList's
                        // ._length (the inner Option's _ptr is Some only
                        // when len > 0); memcmp reads exactly that many
                        // bytes from each Rc-managed buffer.
                        // Interned fast path: the SAME buffer with the
                        // same length is trivially equal — hit constantly
                        // once identifier tokens are interned (yo-self
                        // lexer intern table).
                        .Some(other_ptr) =>
                          (unsafe(__yo_ptr_eq(self_ptr, other_ptr)) || (unsafe(memcmp((*void)(self_ptr), (*void)(other_ptr), self_len)) == int(0))),
                        .None => false
                      ),
                    .None => false
                  ),
                .None => false
              ),
            .None => false
          )
      )
    }),
    (!=) : (fn(self : Self, other : Self) -> bool)({
      return(!Self.(==)(self, other));
    })
  )
);
/// Heterogeneous comparison: `String == str` (and `!=`). Compares bytes
/// DIRECTLY against the static `str` — no intermediate view of the String's
/// heap buffer is constructed (`as_str()` is being removed; see
/// plans/archive/SLICE_REWORK.md step 1). This is the replacement for the dominant
/// `x.as_str() == "literal"` pattern: write `x == "literal"`.
impl(
  String,
  Eq(str)(
    (==) : (fn(self : Self, other : str) -> bool)({
      (self_len : usize) = match(self._bytes, .Some(b) => b.len(), .None => usize(0));
      other_len := other.len();
      cond(
        (self_len != other_len) => false,
        (self_len == usize(0)) => true,
        true =>
          match(
            self._bytes,
            .Some(self_al) =>
              match(
                self_al.ptr(),
                // SAFETY: self_len equals other_len (checked above) and both
                // equal the respective byte counts; the str's backing is
                // static storage and the String's buffer is Rc-managed —
                // memcmp reads exactly self_len bytes from each.
                .Some(self_ptr) =>
                  (unsafe(memcmp((*void)(self_ptr), (*void)(other.ptr()), self_len)) == int(0)),
                .None => false
              ),
            .None => false
          )
      )
    }),
    (!=) : (fn(self : Self, other : str) -> bool)({
      return(!(self == other));
    })
  )
);
/// The symmetric direction: `str == String` (and `!=`), so literal-first
/// comparisons (`"x" == name`) work too. Lives here (not the prelude)
/// because the prelude is layered below `String`.
impl(
  str,
  Eq(String)(
    (==) : (fn(self : Self, other : String) -> bool)({
      self_len := self.len();
      (other_len : usize) = match(other._bytes, .Some(b) => b.len(), .None => usize(0));
      cond(
        (self_len != other_len) => false,
        (self_len == usize(0)) => true,
        true =>
          match(
            other._bytes,
            .Some(other_al) =>
              match(
                other_al.ptr(),
                // SAFETY: lengths equal & nonzero; str backing is static.
                .Some(other_ptr) =>
                  (unsafe(memcmp((*void)(self.ptr()), (*void)(other_ptr), self_len)) == int(0)),
                .None => false
              ),
            .None => false
          )
      )
    }),
    (!=) : (fn(self : Self, other : String) -> bool)({
      return(!(self == other));
    })
  )
);
/// Byte-lexicographic ordering, mirroring `str`'s `Ord(str)` impl in the
/// prelude. Enables `a < b` on Strings directly (the `a.as_str() <
/// b.as_str()` workaround is retired; see plans/archive/SLICE_REWORK.md step 3).
impl(
  String,
  Ord(String)(
    (<) : (fn(lhs : Self, rhs : Self) -> bool)({
      lhs_len := lhs.len();
      rhs_len := rhs.len();
      min_len := cond((lhs_len < rhs_len) => lhs_len, true => rhs_len);
      i := usize(0);
      while(i < min_len, i = (i + usize(1)), {
        cond(
          (lhs.byte_at(i) < rhs.byte_at(i)) => {
            return(true);
          },
          (lhs.byte_at(i) > rhs.byte_at(i)) => {
            return(false);
          },
          true => ()
        );
      });
      lhs_len < rhs_len
    }),
    (<=) : (fn(lhs : Self, rhs : Self) -> bool)({
      return(!(rhs < lhs));
    }),
    (>) : (fn(lhs : Self, rhs : Self) -> bool)({
      return(rhs < lhs);
    }),
    (>=) : (fn(lhs : Self, rhs : Self) -> bool)({
      return(!(lhs < rhs));
    })
  )
);
/// `Pattern` — a value usable as a search pattern against a `String` haystack
/// (mirrors Rust's `core::str::pattern::Pattern`). The PATTERN type implements the
/// match, so a single generic method per operation accepts any pattern type with no
/// overload resolution. Implemented by `str` and `String` (and, later, `char`).
/// See plans/backlog/OVERLOADING_REDESIGN.md §4.
///
/// **Every index in this trait is a BYTE offset into `haystack`**, in both
/// directions (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 3 — they were rune
/// indices before the flip). No index is boundary-checked: UTF-8 is
/// self-synchronizing, so a valid-UTF-8 pattern can only ever match at a rune
/// boundary, and a mid-rune argument answers `false` / `.None` rather than
/// producing a bogus hit.
Pattern :: trait(
  /// BYTE offset in `haystack` to test the prefix at.
  is_prefix_of : (fn(self : Self, haystack : String, position : usize) -> bool),
  /// Number of BYTES of `haystack` to consider; `usize.MAX` means all of it.
  is_suffix_of : (fn(self : Self, haystack : String, end_position : usize) -> bool),
  /// BYTE offset in `haystack` to start searching from.
  is_contained_in : (fn(self : Self, haystack : String, from_index : usize) -> bool),
  /// BYTE offset in AND out: searches from byte `from_index`, answers with the
  /// byte offset of the match.
  index_in : (fn(self : Self, haystack : String, from_index : usize) -> Option(usize)),
  /// BYTE offset in AND out: the highest byte offset a match may start at,
  /// answering with the byte offset of the last such match.
  last_index_in : (fn(self : Self, haystack : String, from_index : usize) -> Option(usize)),
  /// Number of BYTES the match STARTING EXACTLY at byte offset `at` occupies
  /// — 0 when no match starts there. `replace`, `replace_all`, `split_once`
  /// and `strip_prefix` cut the haystack by it; a zero-width pattern (empty
  /// string, empty-matching regex) legitimately answers 0.
  length_in : (fn(self : Self, haystack : String, at : usize) -> usize),
  split_of : (fn(self : Self, haystack : String) -> ArrayList(String))
);
impl(
  String,
  Pattern(
    is_prefix_of : (fn(self : Self, haystack : String, position : usize) -> bool)(
      haystack._has_prefix(self, position)
    ),
    is_suffix_of : (fn(self : Self, haystack : String, end_position : usize) -> bool)(
      haystack._ends_with_impl(self, end_position)
    ),
    is_contained_in : (fn(self : Self, haystack : String, from_index : usize) -> bool)(
      haystack._contains_impl(self, from_index)
    ),
    index_in : (fn(self : Self, haystack : String, from_index : usize) -> Option(usize))(
      haystack._index_of_impl(self, from_index)
    ),
    last_index_in : (fn(self : Self, haystack : String, from_index : usize) -> Option(usize))(
      haystack._last_index_of_impl(self, from_index)
    ),
    length_in : (fn(self : Self, haystack : String, at : usize) -> usize)(
      cond(
        haystack._has_prefix(self, at) => self.len(),
        true => usize(0)
      )
    ),
    split_of : (fn(self : Self, haystack : String) -> ArrayList(String))(
      haystack._split_impl(self)
    )
  )
);
impl(
  str,
  Pattern(
    is_prefix_of : (fn(self : Self, haystack : String, position : usize) -> bool)(
      haystack._has_prefix(String.from(self), position)
    ),
    is_suffix_of : (fn(self : Self, haystack : String, end_position : usize) -> bool)(
      haystack._ends_with_impl(String.from(self), end_position)
    ),
    is_contained_in : (fn(self : Self, haystack : String, from_index : usize) -> bool)(
      haystack._contains_impl(String.from(self), from_index)
    ),
    index_in : (fn(self : Self, haystack : String, from_index : usize) -> Option(usize))(
      haystack._index_of_impl(String.from(self), from_index)
    ),
    last_index_in : (fn(self : Self, haystack : String, from_index : usize) -> Option(usize))(
      haystack._last_index_of_impl(String.from(self), from_index)
    ),
    length_in : (fn(self : Self, haystack : String, at : usize) -> usize)(
      cond(
        haystack._has_prefix(String.from(self), at) => String.from(self).len(),
        true => usize(0)
      )
    ),
    split_of : (fn(self : Self, haystack : String) -> ArrayList(String))(
      haystack._split_impl(String.from(self))
    )
  )
);
/// A single `rune` is a pattern: it matches exactly one occurrence of that
/// code point, on a rune boundary. `s.contains(rune(0x00E9))`,
/// `s.split(rune(c))`, `s.replace(rune(c), String.from("-"))` all dispatch
/// through this impl.
impl(
  rune,
  Pattern(
    is_prefix_of : (fn(self : Self, haystack : String, position : usize) -> bool)(
      match(
        haystack._decode_rune_at(position),
        .Some(r) => (r == self),
        .None => false
      )
    ),
    /// A rune match must END exactly at `end_position` (clamped to `len()`),
    /// so a mid-rune `end_position` can never match.
    is_suffix_of : (fn(self : Self, haystack : String, end_position : usize) -> bool)({
      (n : usize) = haystack.len();
      (eff : usize) = if(end_position > n, n, end_position);
      bytes := haystack.as_bytes();
      pos := usize(0);
      while(pos < eff, {
        d := utf8.decode_lossy(bytes, pos);
        cond(
          ((d.code == self) && ((pos + d.width) == eff)) => {
            return(true);
          },
          true => ()
        );
        pos = (pos + d.width);
      });
      false
    }),
    index_in : (fn(self : Self, haystack : String, from_index : usize) -> Option(usize))({
      bytes := haystack.as_bytes();
      n := bytes.len();
      pos := from_index;
      // A mid-rune `from_index` answers .None, not a bogus hit: skip to the
      // next boundary before scanning.
      while((pos < n) && !haystack.is_char_boundary(pos), pos = (pos + usize(1)), ());
      while(pos < n, {
        d := utf8.decode_lossy(bytes, pos);
        cond(
          (d.code == self) => {
            return(.Some(pos));
          },
          true => ()
        );
        pos = (pos + d.width);
      });
      .None
    }),
    is_contained_in : (fn(self : Self, haystack : String, from_index : usize) -> bool)(
      match(
        self.index_in(haystack, from_index),
        .Some(_) => true,
        .None => false
      )
    ),
    last_index_in : (fn(self : Self, haystack : String, from_index : usize) -> Option(usize))({
      bytes := haystack.as_bytes();
      n := bytes.len();
      lim := if(from_index > n, n, from_index);
      pos := usize(0);
      (last : Option(usize)) = .None;
      while(pos < n, {
        d := utf8.decode_lossy(bytes, pos);
        cond(
          ((d.code == self) && (pos <= lim)) => {
            last = .Some(pos);
          },
          true => ()
        );
        pos = (pos + d.width);
      });
      last
    }),
    length_in : (fn(self : Self, haystack : String, at : usize) -> usize)({
      bytes := haystack.as_bytes();
      cond(
        (at < bytes.len()) =>
          match(
            utf8.decode(bytes, at),
            .Ok(d) => cond(
              (d.code == self) => d.width,
              true => usize(0)
            ),
            .Err(_) => usize(0)
          ),
        true => usize(0)
      )
    }),
    split_of : (fn(self : Self, haystack : String) -> ArrayList(String))({
      parts := ArrayList(String).new();
      bytes := haystack.as_bytes();
      n := bytes.len();
      seg_start := usize(0);
      pos := usize(0);
      while(pos < n, {
        d := utf8.decode_lossy(bytes, pos);
        cond(
          (d.code == self) => {
            parts.push(haystack.substring(seg_start, pos));
            pos = (pos + d.width);
            seg_start = pos;
          },
          true => {
            pos = (pos + d.width);
          }
        );
      });
      parts.push(haystack.substring(seg_start, n));
      parts
    })
  )
);
/// The pattern-search methods — ONE generic method each over `Pattern` (Rust's
/// `str::starts_with<P : Pattern>` family). These replace the old inherent
/// `X(arg : String)` + `StrPattern.X(arg : str)` overload pairs: `s.X("lit")`
/// (P = str) and `s.X(other)` (P = String) both resolve to the one generic method via
/// trait dispatch — no overload resolution. See plans/backlog/OVERLOADING_REDESIGN.md §4.
///
/// **Every index below is a BYTE offset** (`plans/STD_API_AUDIT_D4_PLAN.md`
/// D4 PR 3), matching `len()` and `substring`, so `index_of`'s answer can be
/// fed straight back into `substring` with nothing in between.
impl(
  String,
  /// Does `self` have `prefix` starting at BYTE offset `position` (default 0)?
  starts_with : (fn(generic(P : Type), self : Self, prefix : P, (position : usize) ?= 0, where(P <: Pattern)) -> bool)(
    prefix.is_prefix_of(self, position)
  ),
  /// Does the first `end_position` BYTES of `self` end with `suffix`?
  /// `end_position` defaults to `usize.MAX`, meaning the whole string, and
  /// clamps to `len()`.
  ends_with : (fn(generic(P : Type), self : Self, suffix : P, (end_position : usize) ?= usize.MAX, where(P <: Pattern)) -> bool)(
    suffix.is_suffix_of(self, end_position)
  ),
  /// Does `substr` occur at or after BYTE offset `from_index` (default 0)?
  contains : (fn(generic(P : Type), self : Self, substr : P, (from_index : usize) ?= 0, where(P <: Pattern)) -> bool)(
    substr.is_contained_in(self, from_index)
  ),
  /// BYTE offset of the first occurrence of `substr` at or after BYTE offset
  /// `from_index` (default 0), or `.None`.
  index_of : (fn(generic(P : Type), self : Self, substr : P, (from_index : usize) ?= 0, where(P <: Pattern)) -> Option(usize))(
    substr.index_in(self, from_index)
  ),
  /// BYTE offset of the last occurrence of `substr` starting at or before BYTE
  /// offset `from_index` (default `usize.MAX`, meaning anywhere), or `.None`.
  last_index_of : (fn(generic(P : Type), self : Self, substr : P, (from_index : usize) ?= usize.MAX, where(P <: Pattern)) -> Option(usize))(
    substr.last_index_in(self, from_index)
  ),
  split : (fn(generic(P : Type), self : Self, separator : P, where(P <: Pattern)) -> ArrayList(String))(
    separator.split_of(self)
  ),
  /// Split at the FIRST occurrence of `separator`: `.Some((before; after))`
  /// with the separator itself removed, or `.None` when it never occurs.
  /// Rust's `str::split_once`. A zero-width separator (empty string pattern,
  /// regex matching empty) splits before the first rune.
  split_once : (
    fn(generic(P : Type), self : Self, separator : P, where(P <: Pattern)) -> Option(
      (
        String;
        String
      )
    )
  )({
    (first : Option(usize)) = separator.index_in(self, usize(0));
    match(
      first,
      .Some(at) => {
        (after : usize) = (at + separator.length_in(self, at));
        .Some((self.substring(usize(0), at), self.substring(after, self.len())))
      },
      .None => .None
    )
  }),
  /// `self` without `prefix`, or `.None` when `self` does not start with it.
  /// Rust's `str::strip_prefix`.
  strip_prefix : (fn(generic(P : Type), self : Self, prefix : P, where(P <: Pattern)) -> Option(Self))({
    (hit : bool) = prefix.is_prefix_of(self, usize(0));
    cond(
      hit => .Some(self.substring(prefix.length_in(self, usize(0)), self.len())),
      true => .None
    )
  }),
  /// `self` without `suffix`, or `.None` when `self` does not end with it.
  /// Rust's `str::strip_suffix`. The LAST starting occurrence of the suffix
  /// is the one stripped (so `"aaa".strip_suffix("aa")` is `.Some("a")`,
  /// like Rust).
  strip_suffix : (fn(generic(P : Type), self : Self, suffix : P, where(P <: Pattern)) -> Option(Self))({
    (last : Option(usize)) = suffix.last_index_in(self, usize.MAX);
    match(
      last,
      .Some(at) => {
        (end : usize) = (at + suffix.length_in(self, at));
        cond(
          (end == self.len()) => .Some(self.substring(usize(0), at)),
          true => .None
        )
      },
      .None => .None
    )
  }),
  /**
  * Shared left-to-right scanner behind `replace`, `replacen` and
  * `replace_first`. When `bounded` is true it stops after `limit`
  * replacements and copies the rest of the string verbatim; `limit == 0`
  * with `bounded` replaces nothing.
  */
  _replace_scan : (
    fn(
      generic(P : Type),
      self : Self,
      search_value : P,
      new_value : Self,
      limit : usize,
      bounded : bool,
      where(P <: Pattern)
    ) -> Self
  )({
    self_bytes := self.as_bytes();
    (n : usize) = self_bytes.len();
    out := ArrayList(u8).new();
    nv_bytes := new_value.as_bytes();
    (cut : usize) = usize(0);
    (done : usize) = usize(0);
    pos := usize(0);
    while(pos <= n, {
      cond(
        // Budget spent: leave the loop so the tail copy below runs. It
        // copies from `cut`, which is exactly the unreplaced remainder.
        (bounded && (done >= limit)) => {
          pos = (n + usize(1));
        },
        true => match(
          search_value.index_in(self, pos),
          .Some(at) => {
            // bytes between the last cut and this match
            if(at > cut, {
              match(
                self_bytes.ptr(),
                .Some(p) => out.extend_from_ptr(p.add(cut), at - cut),
                .None => ()
              );
            });
            match(
              nv_bytes.ptr(),
              .Some(p) => out.extend_from_ptr(p, nv_bytes.len()),
              .None => ()
            );
            done = (done + usize(1));
            mlen := search_value.length_in(self, at);
            (after : usize) = (at + mlen);
            cut = after;
            cond(
              // Zero-width match: advance one rune so the next scan starts
              // after the character the insertion sits beside — and the loop
              // always makes progress.
              (mlen == usize(0)) => {
                cond(
                  (after >= n) => {
                    pos = (after + usize(1));
                  },
                  true => {
                    d := utf8.decode_lossy(self_bytes, after);
                    pos = (after + d.width);
                  }
                );
              },
              true => {
                pos = after;
              }
            );
          },
          .None => {
            pos = (n + usize(1));
          }
        )
      );
    });
    if(cut < n, {
      match(
        self_bytes.ptr(),
        .Some(p) => out.extend_from_ptr(p.add(cut), n - cut),
        .None => ()
      );
    });
    String.from_bytes(out)
  }),
  /**
  * Replace EVERY occurrence of `search_value` with `new_value` (D10 —
  * Rust's `str::replace`).
  *
  * `search_value` is any `Pattern` — a `str`, a `String`, a single `rune`, or
  * a compiled `Regex`. A zero-width match inserts `new_value` between every
  * pair of runes and at both ends — Rust's `"abc".replace("", "-") ==
  * "-a-b-c-"` — by stepping one rune past each zero-width match so the scan
  * always advances. Returns `self` unchanged when the pattern never matches.
  *
  * NOTE this replaced only the FIRST occurrence before D10. Use `replacen`
  * for a bounded count.
  */
  replace : (fn(generic(P : Type), self : Self, search_value : P, new_value : Self, where(P <: Pattern)) -> Self)(
    Self._replace_scan(self, search_value, new_value, usize(0), false)
  ),
  /**
  * Replace the first `count` occurrences of `search_value` with `new_value`,
  * leaving any later ones alone — Rust's `str::replacen`.
  *
  * `replacen(p, v, usize(1))` is the pre-D10 meaning of `replace`.
  * `count == 0` returns `self` unchanged.
  */
  replacen : (
    fn(
      generic(P : Type),
      self : Self,
      search_value : P,
      new_value : Self,
      count : usize,
      where(P <: Pattern)
    ) -> Self
  )(
    Self._replace_scan(self, search_value, new_value, count, true)
  ),
  /**
  * Replace the FIRST occurrence of `search_value` with `new_value`.
  *
  * DEPRECATED (D10), kept for one release: this is what `replace` used to
  * mean. Write `replacen(search_value, new_value, usize(1))` instead.
  */
  replace_first : (fn(generic(P : Type), self : Self, search_value : P, new_value : Self, where(P <: Pattern)) -> Self)(
    Self._replace_scan(self, search_value, new_value, usize(1), true)
  ),
  /**
  * Replace EVERY occurrence of `search_value` with `new_value`.
  *
  * DEPRECATED (D10), kept for one release: `replace` now means this. Rust
  * spells it `replace`, with no `replace_all` on `str`.
  */
  replace_all : (fn(generic(P : Type), self : Self, search_value : P, new_value : Self, where(P <: Pattern)) -> Self)(
    Self._replace_scan(self, search_value, new_value, usize(0), false)
  )
);
/// Hash trait implementation — FNV-1a hash over the string's bytes.
/// Bytes are read through the raw buffer pointer (same pattern as `==`'s
/// memcmp path): the previous per-byte `al.get(i)` paid a bounds check +
/// `Option(u8)` construction + match PER BYTE, which made hashing long keys
/// (e.g. the compiler's structural type keys) the top profiled cost of
/// HashMap-heavy phases.
impl(
  String,
  Hash(
    hash : (fn(generic(H : Type), inout(self) : Self, inout(hasher) : H, where(H <: Hasher)) -> unit)({
      match(
        self._bytes,
        .None => (),
        .Some(al) => {
          len := al.len();
          match(
            al.ptr(),
            // SAFETY: `ptr()` is Some only for a live buffer of exactly
            // `len` bytes; the hasher reads [0, len).
            .Some(p) => hasher.write(p, len),
            .None => ()
          );
        }
      );
      // Terminator, so adjacent strings stay prefix-free (Rust does the same).
      hasher.write_u8(u8(255));
    })
  )
);
/// === Iterator support ===
/**
* Rune iterator for `String` — yields decoded Unicode runes.
* Used by `chars()` and `into_iter()`.
*/
StringChars :: struct(
  _string : String,
  _byte_index : usize
);
impl(
  StringChars,
  Iterator(
    Item : rune,
    next : (fn(inout(self) : Self) -> Option(rune))(
      match(
        self._string._bytes,
        .None => .None,
        .Some(al) => cond(
          (self._byte_index >= al.len()) => .None,
          true => {
            first_byte_opt := al.get(self._byte_index);
            match(
              first_byte_opt,
              .Some(first_byte) => {
                (byte_len : usize) = utf8.step_len(first_byte);
                r := self._string._decode_rune_at(self._byte_index);
                self._byte_index = (self._byte_index + byte_len);
                r
              },
              .None => .None
            )
          }
        )
      )
    )
  )
);
/**
* Byte iterator for `String` — yields raw UTF-8 bytes.
* Used by `bytes()`.
*/
StringBytes :: struct(
  _string : String,
  _index : usize
);
impl(
  StringBytes,
  Iterator(
    Item : u8,
    next : (fn(inout(self) : Self) -> Option(u8))(
      match(
        self._string._bytes,
        .None => .None,
        .Some(al) => cond(
          (self._index >= al.len()) => .None,
          true => {
            byte_opt := al.get(self._index);
            self._index = (self._index + usize(1));
            byte_opt
          }
        )
      )
    )
  )
);
/**
* `(byte_offset, rune)` iterator for `String` — yields each rune together with
* the byte offset it starts at. Used by `char_indices()`.
*
* Walks in lockstep with `StringChars`: same runes, same stopping point on
* malformed input. The offsets it yields are exactly the indices
* `is_char_boundary` answers `true` for (on well-formed UTF-8).
*/
StringCharIndices :: struct(
  _string : String,
  _byte_index : usize
);
impl(
  StringCharIndices,
  Iterator(
    Item : IterPair(usize, rune),
    next : (fn(inout(self) : Self) -> Option(IterPair(usize, rune)))(
      match(
        self._string._bytes,
        .None => .None,
        .Some(al) => cond(
          (self._byte_index >= al.len()) => .None,
          true => {
            offset := self._byte_index;
            first_byte_opt := al.get(offset);
            match(
              first_byte_opt,
              .Some(first_byte) => {
                (byte_len : usize) = utf8.step_len(first_byte);
                self._byte_index = (offset + byte_len);
                match(
                  self._string._decode_rune_at(offset),
                  .Some(r) => .Some(IterPair(usize, rune)(_0 : offset, _1 : r)),
                  .None => .None
                )
              },
              .None => .None
            )
          }
        )
      )
    )
  )
);
impl(
  String,
  /**
  * Returns a rune iterator over the string's Unicode characters
  */
  chars : (fn(self : Self) -> StringChars)(
    StringChars(_string : self, _byte_index : usize(0))
  ),
  /**
  * Returns a byte iterator over the string's raw UTF-8 bytes
  */
  bytes : (fn(self : Self) -> StringBytes)(
    StringBytes(_string : self, _index : usize(0))
  ),
  /**
  * Consume the string and return a rune iterator (default iteration)
  */
  into_iter : (fn(self : Self) -> StringChars)(
    StringChars(_string : self, _byte_index : usize(0))
  )
);
/// === Rune-aware indexing (D4 vocabulary) ===
///
/// Everything in this block is stated in **BYTE** offsets.
/// `plans/STD_API_AUDIT_D4_PLAN.md` moved `String`'s index basis from
/// characters to bytes; the API here is Rust-shaped (2026-08-26 decision):
/// byte slicing plus `chars()` / `char_indices()` composed with iterator
/// methods for all rune work — `s.chars().count()` is the rune count,
/// `s.char_indices().nth(n)` finds the byte offset of rune `n`. There is
/// no char-indexed slicing and no second length method; `is_char_boundary`
/// / `floor_char_boundary` / `ceil_char_boundary` / `try_substring` are how
/// byte arithmetic stays on boundaries.
///
/// `char_indices` is built on `std/encoding/utf8` and — like `chars()` —
/// stops at the first byte sequence that will not decode. The boundary
/// functions and `try_substring` are pure byte classification
/// (`utf8.is_boundary`) and cannot fail.
///
/// (`is_char_boundary` is NOT defined here — it lives beside `at` in the main
/// `impl` block, because an `impl` block cannot call forward into a later one
/// and `at`/`substring` need it.)
impl(
  String,
  /// Iterate `(byte_offset, rune)` pairs — Rust's `char_indices()`.
  ///
  /// `_0` is the byte offset the rune starts at, `_1` is the rune. This is
  /// the replacement for the `while(i < s.len()) { s.at(i) }` shape, which
  /// now visits continuation bytes and hands back `.None` at each of them.
  char_indices : (fn(self : Self) -> StringCharIndices)(
    StringCharIndices(_string : self, _byte_index : usize(0))
  ),
  /// The largest byte offset `<= index` that sits on a rune boundary.
  ///
  /// `index` is clamped to `len()` first, so the answer is always a
  /// boundary of THIS string. Pair it with `ceil_char_boundary` to widen or
  /// narrow a byte range onto boundaries before slicing.
  floor_char_boundary : (fn(self : Self, index : usize) -> usize)(
    match(
      self._bytes,
      .None => usize(0),
      .Some(al) => {
        n := al.len();
        cond(
          (index >= n) => n,
          true => {
            i := index;
            while(i > usize(0), {
              b := al(i);
              if(utf8.is_boundary(b), {
                break;
              });
              i = (i - usize(1));
            });
            i
          }
        )
      }
    )
  ),
  /// The smallest byte offset `>= index` that sits on a rune boundary.
  ///
  /// `index` at or past `len()` clamps to `len()`, which is a boundary, so
  /// this always terminates on a valid one.
  ceil_char_boundary : (fn(self : Self, index : usize) -> usize)(
    match(
      self._bytes,
      .None => usize(0),
      .Some(al) => {
        n := al.len();
        cond(
          (index >= n) => n,
          true => {
            i := index;
            while(i < n, {
              b := al(i);
              if(utf8.is_boundary(b), {
                break;
              });
              i = (i + usize(1));
            });
            i
          }
        )
      }
    )
  ),
  /// Byte-range slice that REFUSES a bad range instead of guessing —
  /// Rust's `s.get(start..end)`.
  ///
  /// Same BYTE basis as `substring`, but REFUSING where `substring` clamps or
  /// panics: `.None` is returned for each of the three ranges a byte slice
  /// cannot honour — `start > end`, `end` past `len()`, or an endpoint inside
  /// a rune (which would produce invalid UTF-8). An empty but valid range
  /// yields `.Some` of the empty string.
  try_substring : (fn(self : Self, start : usize, end : usize) -> Option(Self))({
    (n : usize) = match(self._bytes, .Some(b) => b.len(), .None => usize(0));
    if(start > end, {
      return(.None);
    });
    if(end > n, {
      return(.None);
    });
    if(!self.is_char_boundary(start), {
      return(.None);
    });
    if(!self.is_char_boundary(end), {
      return(.None);
    });
    if(start == end, {
      return(.Some(Self(_bytes : .None)));
    });
    (count : usize) = (end - start);
    new_bytes := ArrayList(u8).with_capacity(count);
    match(
      self._bytes,
      .Some(al) => match(
        al.ptr(),
        .Some(src_p) => new_bytes.extend_from_ptr(src_p.add(start), count),
        .None => ()
      ),
      .None => ()
    );
    .Some(Self(_bytes : .Some(new_bytes)))
  })
);
/// === String utility methods ===
/**
* Line iterator for `String` — yields one line at a time (split on `\n`).
* The trailing newline is not included in each yielded line.
* Used by `lines()`.
*/
StringLines :: struct(
  _string : String,
  _byte_index : usize
);
impl(
  StringLines,
  Iterator(
    Item : String,
    next : (fn(inout(self) : Self) -> Option(String))(
      match(
        self._string._bytes,
        .None => .None,
        .Some(al) => {
          total := al.len();
          cond(
            (self._byte_index >= total) => .None,
            true => {
              start := self._byte_index;
              i := start;
              while(i < total, i = (i + usize(1)), {
                byte_opt := al.get(i);
                match(
                  byte_opt,
                  .Some(b) => {
                    cond(
                      (b == u8(10)) => {
                        break;
                      },
                      true => ()
                    );
                  },
                  .None => ()
                );
              });
              line_buf := ArrayList(u8).with_capacity(i - start);
              j := start;
              while(j < i, j = (j + usize(1)), {
                byte_opt := al.get(j);
                match(
                  byte_opt,
                  .Some(b) => {
                    line_buf.push(b);
                  },
                  .None => ()
                );
              });
              self._byte_index = cond(
                (i < total) => (i + usize(1)),
                true => total
              );
              cond(
                (line_buf.len() == usize(0)) => .Some(String(_bytes : .None)),
                true => .Some(String(_bytes : .Some(line_buf)))
              )
            }
          )
        }
      )
    )
  )
);
impl(
  String,
  /**
  * Returns a line iterator over the string.
  * Each call to `next()` yields the next line (without the trailing `\n`).
  *
  * ## Example
  * ```rust
  * s := `hello\nworld`;
  * iter := s.lines();
  * assert(iter.next() == .Some(`hello`), "first line");
  * assert(iter.next() == .Some(`world`), "second line");
  * assert(iter.next() == .None, "done");
  * ```
  */
  lines : (fn(self : Self) -> StringLines)(
    StringLines(_string : self, _byte_index : usize(0))
  ),
  /**
  * Returns a new string containing `n` copies of `self`.
  * Returns an empty string when `n == 0` or `self` is empty.
  *
  * ## Example
  * ```rust
  * assert(`ab`.repeat(usize(3)) == `ababab`, "repeat");
  * assert(`x`.repeat(usize(0)) == ``, "repeat 0");
  * ```
  */
  repeat : (fn(self : Self, n : usize) -> Self)(
    cond(
      (n == usize(0)) => Self(_bytes : .None),
      self.is_empty() => Self(_bytes : .None),
      true => {
        self_byte_len := self.len();
        total := (self_byte_len * n);
        buf := ArrayList(u8).with_capacity(total);
        i := usize(0);
        while(i < n, i = (i + usize(1)), {
          match(
            self._bytes,
            .Some(al) => {
              j := usize(0);
              while(j < self_byte_len, j = (j + usize(1)), {
                byte_opt := al.get(j);
                match(
                  byte_opt,
                  .Some(b) => {
                    buf.push(b);
                  },
                  .None => ()
                );
              });
            },
            .None => ()
          );
        });
        Self(_bytes : .Some(buf))
      }
    )
  ),
  /**
  * Join an `ArrayList(String)` with this string as separator.
  * Returns an empty string when `items` is empty.
  *
  * ## Example
  * ```rust
  * items := ArrayList(String).new();
  * items.push(`a`);
  * items.push(`b`);
  * items.push(`c`);
  * result := `, `.join(items);
  * assert(result == `a, b, c`, "join");
  * ```
  */
  join : (fn(self : Self, items : ArrayList(Self)) -> Self)({
    count := items.len();
    cond(
      (count == usize(0)) => Self(_bytes : .None),
      true => {
        sep_byte_len := self.len();
        total_bytes := usize(0);
        k := usize(0);
        while(k < count, k = (k + usize(1)), {
          item_opt := items.get(k);
          match(
            item_opt,
            .Some(item) => {
              total_bytes = (total_bytes + item.len());
            },
            .None => ()
          );
        });
        cond(
          (count > usize(1)) => {
            total_bytes = (total_bytes + (sep_byte_len * (count - usize(1))));
          },
          true => ()
        );
        buf := ArrayList(u8).with_capacity(total_bytes);
        m := usize(0);
        while(m < count, m = (m + usize(1)), {
          item_opt := items.get(m);
          match(
            item_opt,
            .Some(item) => {
              match(
                item._bytes,
                .Some(al) => {
                  p := usize(0);
                  while(p < al.len(), p = (p + usize(1)), {
                    byte_opt := al.get(p);
                    match(
                      byte_opt,
                      .Some(b) => {
                        buf.push(b);
                      },
                      .None => ()
                    );
                  });
                },
                .None => ()
              );
              cond(
                (m < (count - usize(1))) => {
                  match(
                    self._bytes,
                    .Some(sep_al) => {
                      q := usize(0);
                      while(q < sep_byte_len, q = (q + usize(1)), {
                        byte_opt := sep_al.get(q);
                        match(
                          byte_opt,
                          .Some(b) => {
                            buf.push(b);
                          },
                          .None => ()
                        );
                      });
                    },
                    .None => ()
                  );
                },
                true => ()
              );
            },
            .None => ()
          );
        });
        cond(
          (buf.len() == usize(0)) => Self(_bytes : .None),
          true => Self(_bytes : .Some(buf))
        )
      }
    )
  })
);
/// === Numeric parsing methods ===
impl(
  String,
  /**
  * Parse the string as a boolean.
  * Returns .Some(true) for "true", .Some(false) for "false", .None for anything else.
  */
  parse_bool : (fn(self : Self) -> Option(bool))(
    match(
      self._bytes,
      .None => .None,
      .Some(al) => {
        total_bytes := al.len();
        cond(
          (total_bytes == usize(4)) => {
            b0 := al.get(usize(0)).unwrap_or(u8(0));
            b1 := al.get(usize(1)).unwrap_or(u8(0));
            b2 := al.get(usize(2)).unwrap_or(u8(0));
            b3 := al.get(usize(3)).unwrap_or(u8(0));
            cond(
              ((b0 == u8(116)) && ((b1 == u8(114)) && ((b2 == u8(117)) && (b3 == u8(101))))) =>
                .Some(true),
              true => .None
            )
          },
          (total_bytes == usize(5)) => {
            b0 := al.get(usize(0)).unwrap_or(u8(0));
            b1 := al.get(usize(1)).unwrap_or(u8(0));
            b2 := al.get(usize(2)).unwrap_or(u8(0));
            b3 := al.get(usize(3)).unwrap_or(u8(0));
            b4 := al.get(usize(4)).unwrap_or(u8(0));
            cond(
              ((b0 == u8(102)) && ((b1 == u8(97)) && ((b2 == u8(108)) && ((b3 == u8(115)) && (b4 == u8(101)))))) =>
                .Some(false),
              true => .None
            )
          },
          true => .None
        )
      }
    )
  )
);
// ============================================================================
// Float + radix parsing
//
// parse_f64 validates Rust's f64::from_str grammar itself, then hands the
// validated bytes to libc `atof` for a correctly-rounded conversion. The
// grammar check exists because atof silently accepts MORE than Rust does:
// leading/trailing whitespace, hex floats ("0x1p3"), and a trailing garbage
// suffix (returning a prefix) — all of those must answer .None.
// ============================================================================
/// ASCII-lowercase one byte (used by the inf/nan word match).
_lc_ascii :: (fn(b : u8) -> u8)(
  cond(
    ((b >= u8(0x41)) && (b <= u8(0x5A))) => (b + u8(0x20)),
    true => b
  )
);
/// Is `bytes` exactly Rust's `f64::from_str` grammar?
/// `[+-]? ( digits ('.' digits?)? | '.' digits ) ([eE][+-]?digits)?`
/// — with at least one digit in the significand — or `[+-]?(inf|infinity|nan)`
/// (case-insensitive). No whitespace, no hex floats, no trailing garbage.
_f64_grammar_ok :: (fn(bytes : ArrayList(u8)) -> bool)({
  (n : usize) = bytes.len();
  if(n == usize(0), {
    return(false);
  });
  (i : usize) = usize(0);
  (b0 : u8) = bytes(usize(0));
  if((b0 == u8(0x2B)) || (b0 == u8(0x2D)), {
    i = usize(1);
  });
  (rest : usize) = (n - i);
  // inf / nan / infinity — ASCII case-insensitive, nothing may follow
  // inf / nan / infinity — ASCII case-insensitive, nothing may follow.
  // These arms may only return when the WORD ACTUALLY MATCHES. Returning
  // unconditionally is the bug that made every 3-byte remainder ("1.5",
  // "0.5", "100", "1e3", "2.5", "0.0") and every 8-byte one ("1.234567")
  // answer .None — they are ordinary numbers and must fall through to the
  // numeric grammar below.
  cond(
    (rest == usize(3)) => {
      a := _lc_ascii(bytes(i));
      b := _lc_ascii(bytes(i + usize(1)));
      c := _lc_ascii(bytes(i + usize(2)));
      // "inf" (0x69 0x6E 0x66) or "nan" (0x6E 0x61 0x6E)
      (word : bool) = (((a == u8(0x69)) && ((b == u8(0x6E)) && (c == u8(0x66)))) || ((a == u8(0x6E)) && ((b == u8(0x61)) && (c == u8(0x6E)))));
      if(word, {
        return(true);
      });
    },
    (rest == usize(8)) => {
      // "infinity": i n f i n i t y
      (ok : bool) = true;
      (k : usize) = usize(0);
      while(k < usize(8), k = (k + usize(1)), {
        lc := _lc_ascii(bytes(i + k));
        (want : u8) = cond(
          ((k == usize(0)) || ((k == usize(3)) || (k == usize(5)))) => u8(0x69),
          ((k == usize(1)) || (k == usize(4))) => u8(0x6E),
          (k == usize(2)) => u8(0x66),
          (k == usize(6)) => u8(0x74),
          true => u8(0x79)
        );
        ok = (ok && (lc == want));
      });
      if(ok, {
        return(true);
      });
    },
    true => ()
  );
  // significand: digits with at most one '.'
  (ndig : usize) = usize(0);
  (seen_dot : bool) = false;
  while(i < n, {
    (b : u8) = bytes(i);
    cond(
      ((b >= u8(0x30)) && (b <= u8(0x39))) => {
        ndig = (ndig + usize(1));
        i = (i + usize(1));
      },
      ((b == u8(0x2E)) && !seen_dot) => {
        seen_dot = true;
        i = (i + usize(1));
      },
      true => {
        break;
      }
    );
  });
  if(ndig == usize(0), {
    return(false);
  });
  // optional exponent — must consume the REST of the string
  if(i < n, {
    (e : u8) = bytes(i);
    if((e == u8(0x65)) || (e == u8(0x45)), {
      i = (i + usize(1));
      if(i < n, {
        (s : u8) = bytes(i);
        if((s == u8(0x2B)) || (s == u8(0x2D)), {
          i = (i + usize(1));
        });
      });
      (edig : usize) = usize(0);
      while(i < n, {
        (d : u8) = bytes(i);
        cond(
          ((d >= u8(0x30)) && (d <= u8(0x39))) => {
            edig = (edig + usize(1));
            i = (i + usize(1));
          },
          true => {
            return(false);
          }
        );
      });
      if(edig == usize(0), {
        return(false);
      });
    }, {
      // not an exponent marker → trailing garbage (this is where "0x1p3"
      // dies: the mantissa scan stopped at 'x')
      return(false);
    });
  });
  true
});
/// Digit value of `b` in `radix`, or `.None` when `b` is not a digit there.
/// 0-9, a-z, A-Z — same alphabet as Rust's `from_str_radix`.
_radix_digit :: (fn(b : u8, radix : u32) -> Option(u64))({
  (v : u64) = cond(
    ((b >= u8(0x30)) && (b <= u8(0x39))) => u64(b - u8(0x30)),
    ((b >= u8(0x61)) && (b <= u8(0x7A))) => u64((b - u8(0x61)) + u8(10)),
    ((b >= u8(0x41)) && (b <= u8(0x5A))) => u64((b - u8(0x41)) + u8(10)),
    true => u64.MAX
  );
  cond(
    ((v == u64.MAX) || (v >= u64(radix))) => .None,
    true => .Some(v)
  )
});
/// Magnitude of the digit run starting at `start` (sign already consumed),
/// with overflow checks. The whole remainder must be digits.
_radix_magnitude :: (fn(s : String, radix : u32, start : usize) -> Option(u64))({
  bytes := s.as_bytes();
  (n : usize) = bytes.len();
  if(start >= n, {
    return(.None);
  });
  (mag : u64) = u64(0);
  i := start;
  while(i < n, {
    d := match(
      _radix_digit(bytes(i), radix),
      .Some(v) => v,
      .None => {
        return(.None);
      }
    );
    // mag * radix + d > u64.MAX  ⇔  mag > (u64.MAX - d) / radix
    if(mag > ((u64.MAX - d) / u64(radix)), {
      return(.None);
    });
    mag = ((mag * u64(radix)) + d);
    i = (i + usize(1));
  });
  .Some(mag)
});
impl(
  String,
  /**
  * Parse an `f64` — Rust's `f64::from_str` grammar: optional sign, digits
  * with optional fraction and exponent, or `inf`/`infinity`/`nan`
  * (case-insensitive). Leading/trailing whitespace and hex floats are NOT
  * accepted. `.None` when the string is not a valid number.
  */
  parse_f64 : (fn(self : Self) -> Option(f64))({
    (ok : bool) = _f64_grammar_ok(self.as_bytes());
    cond(
      ok => {
        // to_cstr() gives a NUL-terminated buffer — exactly what atof reads
        c := self.to_cstr();
        p := (*char)(c.ptr().unwrap());
        .Some(unsafe(atof(p)))
      },
      true => .None
    )
  }),
  /**
  * Parse an `i64` in the given `radix` (2..=36, digits 0-9/a-z/A-Z) —
  * Rust's `i64::from_str_radix`. An optional leading `+`/`-` is allowed;
  * `_` is not. `.None` on an empty digit run, any non-digit, a bad radix,
  * or overflow.
  */
  parse_i64_radix : (fn(self : Self, radix : u32) -> Option(i64))({
    (bad : bool) = ((radix < u32(2)) || (radix > u32(36)));
    cond(
      bad => .None,
      true => {
        bytes := self.as_bytes();
        (n : usize) = bytes.len();
        if(n == usize(0), {
          return(.None);
        });
        (neg : bool) = false;
        (start : usize) = usize(0);
        (b0 : u8) = bytes(usize(0));
        if((b0 == u8(0x2B)) || (b0 == u8(0x2D)), {
          neg = (b0 == u8(0x2D));
          start = usize(1);
        });
        match(
          _radix_magnitude(self, radix, start),
          .Some(mag) => cond(
            neg => cond(
              // -2^63 is representable; anything past it is not
              (mag == u64(0x8000000000000000)) => .Some(i64.MIN),
              (mag <= u64(9223372036854775807)) => .Some(i64(0) - i64(mag)),
              true => .None
            ),
            true => cond(
              (mag <= u64(9223372036854775807)) => .Some(i64(mag)),
              true => .None
            )
          ),
          .None => .None
        )
      }
    )
  }),
  /**
  * Parse a `u64` in the given `radix` (2..=36) — Rust's
  * `u64::from_str_radix`. An optional leading `+` is allowed; `-` is not.
  * `.None` on any non-digit, a bad radix, or overflow.
  */
  parse_u64_radix : (fn(self : Self, radix : u32) -> Option(u64))({
    (bad : bool) = ((radix < u32(2)) || (radix > u32(36)));
    cond(
      bad => .None,
      true => {
        bytes := self.as_bytes();
        (n : usize) = bytes.len();
        if(n == usize(0), {
          return(.None);
        });
        (start : usize) = usize(0);
        (b0 : u8) = bytes(usize(0));
        if(b0 == u8(0x2B), {
          start = usize(1);
        });
        _radix_magnitude(self, radix, start)
      }
    )
  }),
  /**
  * Parse the string as a signed 32-bit integer — Rust's `i32::from_str`.
  * An optional leading `+`/`-` is allowed. `.None` on an empty digit run,
  * any non-digit, or a value outside `i32`.
  */
  parse_i32 : (fn(self : Self) -> Option(i32))(
    match(
      self.parse_i64_radix(u32(10)),
      .Some(v) => cond(
        ((v < i64(-2147483648)) || (v > i64(2147483647))) => .None,
        true => .Some(i32(v))
      ),
      .None => .None
    )
  ),
  /**
  * Parse the string as a signed 64-bit integer — Rust's `i64::from_str`.
  * An optional leading `+`/`-` is allowed. `.None` on an empty digit run,
  * any non-digit, or overflow (`i64.MIN` itself is accepted).
  */
  parse_i64 : (fn(self : Self) -> Option(i64))(self.parse_i64_radix(u32(10))),
  /**
  * Parse the string as an unsigned 32-bit integer — Rust's `u32::from_str`.
  * An optional leading `+` is allowed, `-` is not. `.None` on an empty digit
  * run, any non-digit, or a value outside `u32`.
  */
  parse_u32 : (fn(self : Self) -> Option(u32))(
    match(
      self.parse_u64_radix(u32(10)),
      .Some(v) => cond(
        (v > u64(4294967295)) => .None,
        true => .Some(u32(v))
      ),
      .None => .None
    )
  ),
  /**
  * Parse the string as an unsigned 64-bit integer — Rust's `u64::from_str`.
  * An optional leading `+` is allowed, `-` is not. `.None` on an empty digit
  * run, any non-digit, or overflow.
  */
  parse_u64 : (fn(self : Self) -> Option(u64))(self.parse_u64_radix(u32(10)))
);
/// Index trait implementation — access a single byte by index.
/// Panics if the string is empty.
impl(
  String,
  Index(usize)(
    Output : u8,
    index : (fn(inout(self) : Self, idx : usize) -> *Self.Output)(
      match(
        self._bytes,
        .Some(bytes) => &bytes(idx),
        .None => __yo_panic("String: index on empty string")
      )
    )
  )
);
/// Default implementation — the empty string.
impl(
  String,
  Default(
    default : (fn() -> Self)(
      Self(_bytes : .None)
    )
  )
);
/// Clone implementation — produces an independent byte-level copy.
impl(
  String,
  Clone(
    clone : (fn(inout(self) : Self) -> Self)(
      match(
        self._bytes,
        .None => Self(_bytes : .None),
        .Some(al) => {
          n := al.len();
          cond(
            (n == usize(0)) => Self(_bytes : .None),
            true => {
              buf := ArrayList(u8).with_capacity(n);
              match(
                al._ptr,
                .Some(ptr) => buf.extend_from_ptr(ptr, n),
                .None => ()
              );
              Self(_bytes : .Some(buf))
            }
          )
        }
      )
    )
  )
);
impl(
  String,
  FromIterator(
    Elem : String,
    from_iter_new : (fn() -> Self)(
      String.new()
    ),
    from_iter_add : (fn(acc : Self, item : Self.Elem) -> Self)({
      acc.push_string(item);
      acc
    })
  )
);
export(
  String,
  StringError,
  StringChars,
  StringCharIndices,
  StringBytes,
  StringLines,
  Pattern
);
