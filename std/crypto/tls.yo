//! TLS client streams over OpenSSL — `plans/archive/D6_TLS_PLAN.md` (the O2
//! decision: one `TlsStream` implementing the D5 `Reader`/`Writer` traits).
//!
//! On unix targets this requires OpenSSL 1.1.1+/3.x at BUILD time: the
//! compiler probes `pkg-config openssl` (with Homebrew keg fallbacks) and
//! adds the include and link flags; without it, importing this module
//! fails at the C step with the linker naming the missing library. Windows
//! needs no OpenSSL — it gets a Schannel/SSPI backend behind the same
//! fifteen `__yo_tls_*` functions (shipped in v0.2.26,
//! `plans/archive/D6_TLS_PLAN.md`). On wasm there is no backend and
//! `tls_available()` answers `false`.
//!
//! Integration model: the TCP socket belongs to Yo's per-thread async
//! runtime, so OpenSSL never sees the fd. The SSL object speaks through two
//! MEMORY BIOs; this module pumps ciphertext between them and the
//! `TcpStream` around every handshake/read/write step.
//!
//! ```yo
//! { TlsStream } :: import("std/crypto/tls");
//! s := io.await(TlsStream.connect(`example.com`.to_string(), u16(443), io), e);
//! _n := io.await(s.write_str("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n", io), e);
//! n := io.await(s.read(buf.ptr().unwrap(), buf.capacity(), io), e);
//! io.await(s.close(io), e);
//! ```
//!
//! ## Stability
//!
//! unstable — the transport works on every supported target (D6 closed
//! 2026-09-04; the compiler's own downloader runs over it) and both
//! backends verify the chain against the system trust store and check the
//! hostname, so what is unstable is how narrow the surface is. There is
//! exactly one entry point, `TlsStream.connect(host, port, io)`, and no
//! way to say anything else: no options value, so no custom CA bundle, no
//! client certificate, no ALPN (which HTTP/2 would need), no session
//! resumption, no "accept this self-signed certificate for a test", and no
//! server side. Every one of those arrives as a new parameter or a new
//! options type, which is why `connect`'s signature is not frozen.
//! Certificate REVOCATION is deliberately not checked on either backend,
//! matching them to each other rather than to a policy. Freezing follows
//! the first of those features, not a release count.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("../collections/array_list");
{ String } :: import("../string");
{ Path } :: import("../path");
{ IoError } :: import("../sys/errors");
{ Error, AnyError, Exception, IoExn } :: import("../error");
{ TcpStream, _close_stream_in_place } :: import("../net/tcp");
{ NetError } :: import("../net/errors");
IO_tcp :: import("../sys/tcp");
{ SocketAddr, IpAddr } :: import("../net/addr");
{ lookup_host } :: import("../net/dns");
IoTraits :: import("../io");
{ ToString } :: import("../fmt");

extern(
  "Yo",
  // The TLS backend ABI (D6). OpenSSL on unix targets, Schannel/SSPI on
  // Windows (`generate_tls_runtime`, src/codegen/async/runtime_io_common.yo),
  // and refusing stubs on wasm — the implementation is selected per TARGET at
  // C-compile time and emitted only when a __yo_tls_ extern is called.
  // Nothing in this ABI is OpenSSL-specific: it moves ciphertext between two
  // opaque in-memory buffers and asks for plaintext, which is why the Windows
  // backend needed no Yo-side change.
  __yo_tls_ctx_new : (fn() -> ?*void),
  __yo_tls_ssl_new : (fn(ctx : *void, hostname : *char) -> ?*void),
  __yo_tls_handshake : (fn(ssl : *void) -> int),
  __yo_tls_get_error : (fn(ssl : *void, ret : int) -> int),
  __yo_tls_read : (fn(ssl : *void, buf : *void, num : int) -> int),
  __yo_tls_write : (fn(ssl : *void, buf : *void, num : int) -> int),
  __yo_tls_shutdown : (fn(ssl : *void) -> int),
  __yo_tls_free : (fn(ssl : *void, ctx : *void) -> unit),
  __yo_tls_rbio : (fn(ssl : *void) -> *void),
  __yo_tls_wbio : (fn(ssl : *void) -> *void),
  __yo_tls_bio_pending : (fn(bio : *void) -> usize),
  __yo_tls_bio_read : (fn(bio : *void, buf : *void, len : int) -> int),
  __yo_tls_bio_write : (fn(bio : *void, buf : *void, len : int) -> int),
  __yo_tls_err_string : (fn(buf : *char, len : usize) -> unit),
  __yo_tls_available : (fn() -> bool)
);
/// True when this build's TLS backend can connect (unix + OpenSSL).
tls_available :: (fn() -> bool)(unsafe(__yo_tls_available()));
export(tls_available);
_SSL_VERIFY_PEER :: (fn() -> int)(int(1));
_SSL_CTRL_SET_TLSEXT_HOSTNAME :: (fn() -> int)(int(55));
// SSL_get_error results.
_SSL_ERROR_WANT_READ :: (fn() -> int)(int(2));
_SSL_ERROR_WANT_WRITE :: (fn() -> int)(int(3));
_SSL_ERROR_ZERO_RETURN :: (fn() -> int)(int(6));
// Ciphertext pump chunk.
_PUMP_CAP :: (fn() -> usize)(usize(16384));
/// TLS failures, D1 style. `Handshake`/`Io` carry OpenSSL's own message.
TlsError :: enum(
  /// The TCP connection could not be established or resolved.
  Connect(host : String),
  /// The handshake failed (certificate verification failures land here —
  /// OpenSSL reports them through the handshake result).
  Handshake(detail : String),
  /// A read/write failed after the session was established.
  Io(detail : String),
  /// The peer closed the TLS session (clean close_notify) during an
  /// operation that needed data.
  Closed
);
/// `_throw_tls` boxes a `TlsError` into an `AnyError` (`Dyn(Error)`), which
/// requires the `Error` marker — D1's "an error type is a real enum
/// implementing `Error()`" — so this derive supplies it alongside the
/// messages.
derive(
  TlsError,
  Error(
    .Connect => `tls: could not connect to ${host}`,
    .Handshake => `tls handshake failed: ${detail}`,
    .Io => `tls i/o failed: ${detail}`,
    .Closed => `tls session closed by peer`.to_string()
  )
);
export(TlsError);
/// Last backend error as text (empty queue → a fixed note).
_ssl_err_string :: (fn() -> String)({
  buf := ArrayList(u8).with_capacity(usize(256));
  buf.resize_with_byte(usize(256), int(0));
  unsafe(__yo_tls_err_string((*char)(buf.ptr().unwrap()), usize(256)));
  String.from_cstr(buf.ptr().unwrap()).unwrap_or(`unknown TLS error`.to_string())
});
_throw_tls :: (fn(err : &TlsError, exn : Exception) -> unit)(
  exn.throw(dyn(err))
);
/// The socket and the OpenSSL objects behind a `TlsStream`'s `Box`. Its
/// `Drop` releases both unless `close`/`close_sync` already did: a
/// `TlsStream` dropped without `close` used to leak everything it owned — the
/// socket descriptor AND the OpenSSL `SSL`/`SSL_CTX` pair.
_TlsState :: struct(
  _tcp : TcpStream,
  _ctx : *void,
  _ssl : *void,
  // Owned by _ssl after SSL_set_bio; kept for the pumps.
  _rbio : *void,
  _wbio : *void,
  _closed : bool
);
impl(
  _TlsState,
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      if(!self._closed, {
        self._closed = true;
        // __yo_tls_free releases both BIOs (owned by the SSL object) and
        // the context.
        unsafe(__yo_tls_free(self._ssl, self._ctx));
        self._tcp.close_sync();
      });
    })
  )
);
/// A connected TLS client stream.
///
/// A move-only value (its state is a `Box`): one owner frees the session, and
/// a copy is E0901. Lend it with `&s`, or share it as `Rc(TlsStream)`.
/// `close` marks the session closed inside the box, so it is never `Sync`.
TlsStream :: struct(_cell : Box(_TlsState));
impl(TlsStream, !Sync());
/// What the record pumps need, copied out of the state: the socket's fd, the
/// session and its two BIOs. Plain words, so a pump future borrows nothing.
_TlsIo :: struct(
  _fd : i32,
  _ssl : *void,
  _rbio : *void,
  _wbio : *void
);
derive(_TlsIo, Copy, Clone);
/// Drain the write BIO (ciphertext OpenSSL produced) into the socket.
_flush_wbio :: (fn(t : _TlsIo, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async(e => {
    buf := ArrayList(u8).with_capacity(_PUMP_CAP());
    buf.resize_with_byte(_PUMP_CAP(), int(0));
    (pending : usize) = unsafe(__yo_tls_bio_pending(t._wbio));
    while(pending > usize(0), {
      n := unsafe(__yo_tls_bio_read(t._wbio, (*void)(buf.ptr().unwrap()), int(_PUMP_CAP())));
      cond(
        (n > int(0)) => {
          // write_all over the raw chunk.
          (sent : usize) = usize(0);
          (want : usize) = usize(n);
          while(sent < want, {
            r := e.io.await(IO_tcp.stream_write(t._fd, buf.ptr().unwrap().add(sent), want - sent), e.io);
            w := usize(NetError.check(r, e.exn));
            sent = (sent + w);
          });
        },
        true => ()
      );
      pending = unsafe(__yo_tls_bio_pending(t._wbio));
    });
    return(());
  })
);
/// Feed one socket read into the read BIO. Returns the byte count (0 = EOF).
_feed_rbio :: (fn(t : _TlsIo, io : Io) -> Impl(Future(usize, IoExn)))(
  io.async(e => {
    buf := ArrayList(u8).with_capacity(_PUMP_CAP());
    buf.resize_with_byte(_PUMP_CAP(), int(0));
    r := e.io.await(IO_tcp.recv(t._fd, buf.ptr().unwrap(), _PUMP_CAP(), i32(0)), e.io);
    n := usize(NetError.check(r, e.exn));
    cond(
      (n > usize(0)) => {
        _w := unsafe(__yo_tls_bio_write(t._rbio, (*void)(buf.ptr().unwrap()), int(n)));
      },
      true => ()
    );
    return(n);
  })
);
impl(
  TlsStream,
  /// Connect to `host:port` and complete a TLS handshake. Certificate
  /// verification and hostname checking are ON (the system trust store via
  /// `SSL_CTX_set_default_verify_paths`); SNI is sent.
  connect : (fn(host : &String, port : u16, io : Io) -> Impl(Future(TlsStream, IoExn)))(
    io.async(e => {
      // 1. TCP.
      addrs := e.io.await(lookup_host(host, e.io), e);
      cond(
        (addrs.len() == usize(0)) => {
          _throw_tls(TlsError.Connect(host : host.clone()), e.exn);
        },
        true => ()
      );
      addr := SocketAddr.new(addrs(usize(0)), port);
      tcp := e.io.await(TcpStream.connect(addr, e.io), e);
      // 2. Backend objects (verify + trust store + SNI + hostname pin are
      // configured inside __yo_tls_ssl_new).
      host_c := match(host.to_cstr_checked(), .Ok(b) => b, .Err(_) => e.exn.throw(dyn(IoError.InvalidInput)));
      ctx_opt := unsafe(__yo_tls_ctx_new());
      if(ctx_opt.is_none(), {
        _throw_tls(TlsError.Handshake(detail : _ssl_err_string()), e.exn);
      });
      ctx := ctx_opt.unwrap();
      ssl_opt := unsafe(__yo_tls_ssl_new(ctx, (*char)(host_c.ptr().unwrap())));
      if(ssl_opt.is_none(), {
        _throw_tls(TlsError.Handshake(detail : _ssl_err_string()), e.exn);
      });
      ssl := ssl_opt.unwrap();
      rbio := unsafe(__yo_tls_rbio(ssl));
      wbio := unsafe(__yo_tls_wbio(ssl));
      t := _TlsIo(_fd : tcp.fd(), _ssl : ssl, _rbio : rbio, _wbio : wbio);
      s := TlsStream(_cell : box(_TlsState(_tcp : tcp, _ctx : ctx, _ssl : ssl, _rbio : rbio, _wbio : wbio, _closed : false)));
      // 3. Handshake pump. Awaits sit ONE branch under the while — deeper
      // nesting is an unsupported async shape (the closure FTTs to an abort
      // stub; see issues/fixed/ftt-stub-in-live-closure-falls-off-non-void-function.md).
      (done : bool) = false;
      while(!done, {
        ret := unsafe(__yo_tls_handshake(ssl));
        e.io.await(_flush_wbio(t, e.io), e);
        (need_read : bool) = false;
        cond(
          (ret == int(1)) => {
            done = true;
          },
          true => {
            err := unsafe(__yo_tls_get_error(ssl, ret));
            cond(
              (err == _SSL_ERROR_WANT_READ()) => {
                need_read = true;
              },
              (err == _SSL_ERROR_WANT_WRITE()) => (),
              true => {
                _throw_tls(TlsError.Handshake(detail : _ssl_err_string()), e.exn);
              }
            );
          }
        );
        if(need_read, {
          got := e.io.await(_feed_rbio(t, e.io), e);
          cond(
            (got == usize(0)) => {
              _throw_tls(TlsError.Handshake(detail : `peer closed during handshake`.to_string()), e.exn);
            },
            true => ()
          );
        });
      });
      return(s);
    })
  ),
  /// The record pumps' handles (see `_TlsIo`).
  _io : (fn(self : &Self) -> _TlsIo)(
    _TlsIo(_fd : self._cell._tcp.fd(), _ssl : self._cell._ssl, _rbio : self._cell._rbio, _wbio : self._cell._wbio)
  ),
  /// Read decrypted bytes into `buf`. 0 = the peer closed the session.
  read : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
    _tls_read(self._io(), buf, size, io)
  ),
  /// Write plaintext; returns the byte count accepted (all of `size` on
  /// success — SSL_write is all-or-nothing by default).
  write : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
    _tls_write(self._io(), buf, size, io)
  ),
  /// Write a `str`; returns the byte count written.
  write_str : (fn(self : &Self, data : str, io : Io) -> Impl(Future(usize, IoExn)))({
    t := self._io();
    s := String.from(data);
    io.async(e => {
      n := e.io.await(_tls_write(t, s.ptr().unwrap(), s.len(), e.io), e);
      return(n);
    })
  }),
  /// Write a `String` (matches TcpStream.write_string); byte count written.
  write_string : (fn(self : &Self, data : &String, io : Io) -> Impl(Future(usize, IoExn)))({
    t := self._io();
    io.async(e => {
      n := e.io.await(_tls_write(t, data.ptr().unwrap(), data.len(), e.io), e);
      return(n);
    })
  }),
  /// Close: best-effort close_notify, then the socket. Frees the OpenSSL
  /// objects — the stream must not be used afterwards.
  close : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
    io.async({ &self }(e : IoExn) => {
      cond(
        self._cell._closed => (),
        true => {
          st := addr_of(self._cell.*);
          t := self._io();
          unsafe(consume(st.*._closed = true));
          _sd := unsafe(__yo_tls_shutdown(t._ssl));
          e.io.await(_flush_wbio(t, e.io), e);
          // __yo_tls_free releases both BIOs (owned by the SSL object) and
          // the context.
          unsafe(__yo_tls_free(t._ssl, self._cell._ctx));
          // The socket's state sits inside this stream's box: close it
          // through its address (this future borrows the TLS stream).
          e.io.await(_close_stream_in_place(&self._cell._tcp, e.io), e);
        }
      );
      return(());
    })
  ),
  /// Close without the event loop: free the OpenSSL objects and close the
  /// socket now (`TcpStream.close_sync`), even while a pending read or write
  /// future still holds the socket. What `Drop` runs, and what a caller in
  /// plain code (a connection pool's eviction) uses, since the destructor is
  /// never called by hand (E0915).
  ///
  /// It does NOT send a `close_notify`: flushing the write BIO needs the
  /// event loop. `close(io)` is the graceful form and makes `close_sync` a
  /// no-op afterwards; a peer that only sees the TCP FIN is what every
  /// language's TLS drop does.
  close_sync : (fn(self : &Self) -> unit)({
    cond(
      !self._cell._closed => {
        st := addr_of(self._cell.*);
        unsafe(consume(st.*._closed = true));
        // __yo_tls_free releases both BIOs (owned by the SSL object) and
        // the context.
        unsafe(__yo_tls_free(self._cell._ssl, self._cell._ctx));
        self._cell._tcp.close_sync();
      },
      true => ()
    );
  })
);
/// Read decrypted bytes into `buf` through the session `t`.
_tls_read :: (fn(t : _TlsIo, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))({
  ssl := t._ssl;
  io.async(e => {
    (out : usize) = usize(0);
    (settled : bool) = false;
    while(!settled, {
      ret := unsafe(__yo_tls_read(ssl, (*void)(buf), int(size)));
      (act : int) = int(0);
      cond(
        (ret > int(0)) => {
          out = usize(ret);
          settled = true;
        },
        true => {
          err := unsafe(__yo_tls_get_error(ssl, ret));
          cond(
            (err == _SSL_ERROR_ZERO_RETURN()) => {
              out = usize(0);
              settled = true;
            },
            (err == _SSL_ERROR_WANT_READ()) => {
              act = int(1);
            },
            (err == _SSL_ERROR_WANT_WRITE()) => {
              act = int(2);
            },
            true => {
              _throw_tls(TlsError.Io(detail : _ssl_err_string()), e.exn);
              settled = true;
            }
          );
        }
      );
      // One post-cond await block (the handshake loop's proven shape; two
      // separate awaiting `if`s after the cond trip the async state
      // machine — issues/fixed/async-postwhile-multiple-await-ifs.md). WANT_READ
      // (act 1) flushes then feeds; WANT_WRITE (act 2) only flushes.
      if(act > int(0), {
        e.io.await(_flush_wbio(t, e.io), e);
        (got : usize) = usize(1);
        if(act == int(1), {
          got = e.io.await(_feed_rbio(t, e.io), e);
        });
        cond(
          (got == usize(0)) => {
            out = usize(0);
            settled = true;
          },
          true => ()
        );
      });
    });
    return(out);
  })
});
/// Write plaintext through the session `t`; returns the byte count accepted.
_tls_write :: (fn(t : _TlsIo, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))({
  ssl := t._ssl;
  io.async(e => {
    (out : usize) = usize(0);
    (settled : bool) = false;
    while(!settled, {
      ret := unsafe(__yo_tls_write(ssl, (*void)(buf), int(size)));
      e.io.await(_flush_wbio(t, e.io), e);
      (need_read : bool) = false;
      cond(
        (ret > int(0)) => {
          out = usize(ret);
          settled = true;
        },
        true => {
          err := unsafe(__yo_tls_get_error(ssl, ret));
          cond(
            (err == _SSL_ERROR_WANT_READ()) => {
              need_read = true;
            },
            (err == _SSL_ERROR_WANT_WRITE()) => (),
            true => {
              _throw_tls(TlsError.Io(detail : _ssl_err_string()), e.exn);
              settled = true;
            }
          );
        }
      );
      if(need_read, {
        got := e.io.await(_feed_rbio(t, e.io), e);
        cond(
          (got == usize(0)) => {
            _throw_tls(TlsError.Closed, e.exn);
            settled = true;
          },
          true => ()
        );
      });
    });
    return(out);
  })
});
export(TlsStream);
// === std/io async trait impls (D5) ===
impl(
  TlsStream,
  IoTraits.Reader(
    read : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
      self.read(buf, size, io)
    )
  )
);
impl(
  TlsStream,
  IoTraits.Writer(
    write : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
      self.write(buf, size, io)
    ),
    flush : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
      _flush_wbio(self._io(), io)
    )
  )
);
