open import "../data/primitive/expr.yo";
open import "../data/primitive/expr_list.yo";
open import "../data/primitive/usize.yo";
open import "../data/primitive/boolean.yo";

/*
 The `do` macro transform the code below:
  
  do {
    x := 1;
    with response <= fetch("https://api.example.com");
    std.println(response);
    with (json,) <<= response.json();
    std.println(json);
    with (x, y) <- json.parse();
    return x + y;
  }
 
  to:

  {
    x := 1;
    fetch("https://api.example.com", fn(response) => {
      std.println(response);
      response.json(fn(json) =>> {
        std.println(json);
        json.parse(fn(x, y) -> {
          return(x + y);
        })
      })
    })
  }
 */

// Create a begin expression with all arguments using unquote_splicing
create_begin_with_all_args :: ((compt(args) : ExprList) -> compt(Expr)) {
  return cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => args.car(),
    true =>
      // Use unquote_splicing to expand all arguments into a single begin call
      // This creates: begin(arg1, arg2, arg3, ..., argN)
      quote(begin(unquote_splicing(args)))
  );
};

// Helper function to collect consecutive non-with statements into a single begin block
collect_non_with_statements :: ((compt(args) : ExprList) -> compt(Expr)) {
  return cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => args.car(),
    true =>
      // Collect all statements and wrap them in a single begin
      // This will create: begin(stmt1, stmt2, stmt3, ...)
      create_begin_with_all_args(args)
  );
};

// Helper function to check if there are any with statements in the argument list
check_for_with_statements :: ((compt(args) : ExprList) -> compt(boolean)) {
  return cond(
    (args.length() == 0) => false,
    true => {
      first_arg :: args.car();
      rest_args :: args.cdr();
      cond(
        first_arg.is_fn_call() => {
          callee :: first_arg.get_callee();
          cond(
            (callee.is_atom() && (callee == quote(with))) => true,
            true => recur(rest_args)
          )
        },
        true => recur(rest_args)
      )
    }
  );
};

// Transform "with var <= expr" into a monadic bind pattern
// This should transform the entire do block into nested function calls
transform_do_block :: ((compt(args) : ExprList) -> compt(Expr)) {
  return cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => 
      // Last expression, just return it
      args.car(),
    true => {
      first_arg :: args.car();
      rest_args :: args.cdr();
      cond(
        // Check if this is a with statement: with var <= expr
        first_arg.is_fn_call() => {
          callee :: first_arg.get_callee();
          cond(
            (callee.is_atom() && (callee == quote(with))) => {
              with_args :: first_arg.get_args();
              cond(
                (with_args.length() == 1) => {
                  assignment_expr :: with_args.car(); // This should be "var <= expr"
                  cond(
                    assignment_expr.is_fn_call() => {
                      assignment_callee :: assignment_expr.get_callee();
                      cond(
                        (assignment_callee.is_atom() && 
                         ((assignment_callee == quote(<-)) || 
                          (assignment_callee == quote(<=)) || 
                          (assignment_callee == quote(<<=)))) => {
                          assignment_args :: assignment_expr.get_args();
                          cond(
                            (assignment_args.length() == 2) => {
                              var_name :: assignment_args.car();
                              expr_value :: assignment_args.cdr().car();
                              
                              // First, compute rest_transformed before using it
                              rest_transformed :: cond(
                                (rest_args.length() == 0) => quote(()),
                                (rest_args.length() == 1) => rest_args.car(),
                                true => {
                                  // Always use recursive transformation for consistency  
                                  recur(rest_args)
                                }
                              );
                              
                              // Now create the callback function using the computed rest_transformed
                              callback_fn :: cond(
                                var_name.is_fn_call() => {
                                  var_callee :: var_name.get_callee();
                                  cond(
                                    (var_callee.is_atom() && (var_callee == quote(tuple))) => {
                                      // It's a tuple pattern like (x, y)
                                      tuple_args :: var_name.get_args();
                                      // Create function with multiple parameters
                                      cond(
                                        (assignment_callee == quote(<-)) =>
                                          quote(fn(unquote_splicing(tuple_args)) -> unquote(rest_transformed)),
                                        (assignment_callee == quote(<=)) =>
                                          quote(fn(unquote_splicing(tuple_args)) => unquote(rest_transformed)),
                                        (assignment_callee == quote(<<=)) => 
                                          quote(fn(unquote_splicing(tuple_args)) =>> unquote(rest_transformed)),
                                        true => {
                                          compt_assert(false, "Unknown assignment operator in with statement");
                                          quote(false) // malformed
                                        }
                                      )
                                    },
                                    true => 
                                      // Not a tuple, treat as single parameter
                                      cond(
                                        (assignment_callee == quote(<-)) =>
                                          quote(fn(unquote(var_name)) -> unquote(rest_transformed)),
                                        (assignment_callee == quote(<=)) =>
                                          quote(fn(unquote(var_name)) => unquote(rest_transformed)),
                                        (assignment_callee == quote(<<=)) =>
                                          quote(fn(unquote(var_name)) =>> unquote(rest_transformed)),
                                        true => {
                                          compt_assert(false, "Unknown assignment operator in with statement");
                                          quote(false) // malformed
                                        }
                                      )
                                  )
                                },
                                true => 
                                  // Not a function call, check if it's _ (no args) or treat as single parameter
                                  cond(
                                    (var_name.is_atom() && (var_name == quote(_))) =>
                                      // Special case: _ means no parameters
                                      cond(
                                        (assignment_callee == quote(<-)) =>
                                          quote(fn() -> unquote(rest_transformed)),
                                        (assignment_callee == quote(<=)) =>
                                          quote(fn() => unquote(rest_transformed)),
                                        (assignment_callee == quote(<<=)) => // <<=
                                          quote(fn() =>> unquote(rest_transformed)),
                                        true => {
                                          compt_assert(false, "Unknown assignment operator in with statement");
                                          quote(false) // malformed
                                        }
                                      ),
                                    true => 
                                      // Regular single parameter
                                      cond(
                                        (assignment_callee == quote(<-)) =>
                                          quote(fn(unquote(var_name)) -> unquote(rest_transformed)),
                                        (assignment_callee == quote(<=)) =>
                                          quote(fn(unquote(var_name)) => unquote(rest_transformed)),
                                        (assignment_callee == quote(<<=)) => // <<=
                                          quote(fn(unquote(var_name)) =>> unquote(rest_transformed)),
                                        true => {
                                          compt_assert(false, "Unknown assignment operator in with statement");
                                          quote(false) // malformed
                                        }
                                      )
                                  )
                              );
                              
                              // Check if expr_value is a function call to add the callback as an argument
                              cond(
                                expr_value.is_fn_call() => {
                                  // Get the function and its existing arguments
                                  fn_name :: expr_value.get_callee();
                                  fn_args :: expr_value.get_args();
                                  // We need to construct: fn_name(arg1, arg2, ..., callback_fn)
                                  // Since we can't use unquote_splicing easily, let's handle common cases
                                  cond(
                                    (fn_args.length() == 1) => {
                                      arg1 :: fn_args.car();
                                      quote(unquote(fn_name)(unquote(arg1), unquote(callback_fn)))
                                    },
                                    (fn_args.length() == 2) => {
                                      arg1 :: fn_args.car();
                                      arg2 :: fn_args.cdr().car();
                                      quote(unquote(fn_name)(unquote(arg1), unquote(arg2), unquote(callback_fn)))
                                    },
                                    (fn_args.length() == 0) => 
                                      quote(unquote(fn_name)(unquote(callback_fn))),
                                    true => 
                                      // For more than 2 args, fall back to the simple approach
                                      quote(unquote(expr_value)(unquote(callback_fn)))
                                  )
                                },
                                true => 
                                  // If it's not a function call, treat it as a simple call
                                  quote(unquote(expr_value)(unquote(callback_fn)))
                              )
                            },
                            true => {
                              compt_assert(false, "Malformed <-, <=, or <<= statement, expected two arguments");
                              quote(false) // malformed
                            }
                          )
                        },
                        true => {
                          compt_assert(false, "Expected \"with\" statement to use <-, <= or <<=");
                          quote(false) // not <=
                        }
                      )
                    },
                    true => {
                      compt_assert(false, "Expected \"with\" statement to be a function call");
                      quote(false) // not function call
                    }
                  )
                },
                true => {
                  compt_assert(false, "Malformed \"with\" statement, expected one argument");
                  quote(false) // wrong arg count
                }
              )
            },
            // Not a with statement, but there are more statements after
            // This means it's a regular statement in the middle of the block
            // We need to check if there are any with statements in the remaining args
            true => {
              // Look ahead to see if there are any with statements in the remaining args
              has_with_statement :: check_for_with_statements(rest_args);
              cond(
                has_with_statement => {
                  // If there are with statements ahead, we need to sequence this statement
                  // with the transformed rest
                  rest_transformed :: recur(rest_args);
                  quote(begin(unquote(first_arg), unquote(rest_transformed)))
                },
                true => {
                  // No with statements ahead, collect all into a single begin
                  all_remaining :: quote(unquote(first_arg)).cons(rest_args);
                  create_begin_with_all_args(all_remaining)
                }
              )
            }
          )
        },
        true => {
          // Not a function call, sequence all remaining statements
          all_remaining :: quote(unquote(first_arg)).cons(rest_args);
          create_begin_with_all_args(all_remaining)
        }
      )
    }
  );
};

// Helper function to check if there are any with statements in the argument list

do :: ((quote(begin_expr) : Expr) -> unquote(Expr)) {
  return cond(
    begin_expr.is_fn_call() => {
      callee :: begin_expr.get_callee();
      cond(
        // expect the callee to be the `begin` function
        (callee.is_atom() && (callee == quote(begin))) => {
          args :: begin_expr.get_args();
          // Transform the entire block
          transform_do_block(args)
        },
        // otherwise, return false for error
        true => {
          compt_assert(false, "Expected `do` block to start with `begin`");
          quote(false)
        }
      )
    },
    true => {
      compt_assert(false, "Expected `do` block to be a function call to `begin`");
      quote(false)
    }
  );
};

expanded :: macro_expand quote
  do {
    x := 1;
    with response <= fetch("https://api.example.com");
    std.println("after fetch");
    std.println(response);
    with (json,) <<= response.json();
    std.println("after json");
    std.println(json);
  }
;

compt_assert(expanded == quote(
  {
    x := 1;
    fetch("https://api.example.com", fn(response) => {
      std.println("after fetch");
      std.println(response);
      response.json(fn(json) =>> {
        std.println("after json");
        std.println(json);
      })
    })
  })
);

