extern "Yo",
  // Cooperative multithreading
  __yo_thread_set_maximum_threads: (fn(num: usize) -> unit),
  __yo_thread_get_hardware_threads: (fn() -> usize),
  __yo_get_thread_id : (fn() -> usize),
  __yo_thread_yield : (fn() -> unit)
;

export
  set_maximum_threads : __yo_thread_set_maximum_threads,
  get_hardware_threads : __yo_thread_get_hardware_threads,
  get_thread_id : __yo_get_thread_id,
  thread_yield : __yo_thread_yield
;