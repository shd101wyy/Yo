//! OS threads and a thread pool, each thread with its own Io event loop and
//! GC heap.
//!
//! Two levels are available:
//!
//!   * `Thread.spawn` — one dedicated OS thread per call, joined explicitly.
//!   * `ThreadPool`   — a reusable pool of worker threads that tasks are
//!     handed to; tasks are distributed round-robin with thread affinity
//!     (no work stealing).
//!
//! Neither `Thread.join` nor `ThreadPool.join_all` carries a value out of a
//! thread. To return a result, hand the value back over a `Channel`:
//!
//! ```rust
//! { Channel } :: import "std/sync/channel";
//! { Thread } :: import "std/thread";
//!
//! out := Channel(i32).new(usize(1));
//! t := Thread.spawn((io) => {
//!   out.send(i32(42));
//!   ()
//! });
//! t.join();
//! result := out.recv().unwrap();
//! ```
pragma(Pragma.AllowUnsafe);
{ Mutex } :: import("./sync/mutex");
{ AtomicBool, AtomicUsize, MemoryOrder } :: import("./sync/atomic");
{ Channel } :: import("./sync/channel");
{ assert } :: import("./assert");
extern(
  "Yo",
  __yo_thread_get_hardware_threads : (fn() -> usize),
  __yo_get_thread_id : (fn() -> usize),
  __yo_get_cpu_id : (fn() -> i32)
);
extern(
  "Yo",
  __yo_thread_t : Type,
  __yo_thread_spawn : (fn(cb : Impl(Fn(io : Io) -> unit, Send)) -> __yo_thread_t),
  __yo_thread_join : (fn(t : __yo_thread_t) -> unit),
  __yo_thread_detach : (fn(t : __yo_thread_t) -> unit),
  // The threading preamble's own thread identity (a macro over pthread_self /
  // GetCurrentThreadId). NOT `__yo_get_thread_id`: that one lives in the async
  // runtime core, which a program without `io` never emits, so using it here
  // made every ThreadPool user without async fail to link.
  __yo_thread_self : (fn() -> usize)
);
extern(
  "Yo",
  __yo_worker_spawn : (fn(cb : Impl(Fn(io : Io) -> unit, Send)) -> unit),
  __yo_worker_get_num_threads : (fn() -> usize),
  __yo_worker_set_num_threads : (fn(num : usize) -> unit)
);
/// OS thread handle — Rust's `JoinHandle`. Each spawned thread gets its own
/// Io event loop. `join` waits for it, once; dropping a handle that was never
/// joined DETACHES the thread (it keeps running and the OS reclaims it when it
/// finishes). Reference-counted so that detach-on-drop runs exactly once
/// however many copies of the handle exist
/// (issues/fixed/thread-join-was-re-callable-and-handles-leaked.md).
Thread :: ref(
  struct(
    handle : __yo_thread_t,
    _joined : bool
  )
);
impl(
  Thread,
  /// Spawn a new OS thread running the given closure.
  /// The closure receives its own per-thread Io event loop.
  spawn : (fn(cb : Impl(Fn(io : Io) -> unit, Send)) -> Self)({
    raw := __yo_thread_spawn(cb);
    Self(handle : raw, _joined : false)
  }),
  /// Block the current thread until this thread completes. Panics on a second
  /// call: joining a thread twice is undefined behaviour in every threading
  /// API underneath (`pthread_join` on a joined thread; a closed `HANDLE`).
  join : (fn(self : Self) -> unit)({
    assert(!self._joined, "Thread.join: this thread was already joined");
    self._joined = true;
    __yo_thread_join(self.handle)
  }),
  /// True once `join` has returned.
  is_joined : (fn(self : Self) -> bool)(
    self._joined
  )
);
impl(
  Thread,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      cond(
        !self._joined => {
          self._joined = true;
          __yo_thread_detach(self.handle);
        },
        true => ()
      );
    })
  )
);
/// A pool of worker threads that tasks are handed to.
///
/// Each task is pinned to one worker thread (round-robin, no work stealing),
/// and every worker thread has its own GC heap and async Io event loop.
///
/// The OS worker threads live in one process-global pool owned by the
/// runtime, which starts it on the first `spawn` and tears it down at process
/// exit. A `ThreadPool` value is the explicit handle on that pool: it decides
/// the thread count, submits tasks, and drains them. Two consequences:
///
///   * the `num_threads` passed to `new` is a request — it only takes effect
///     while the runtime pool has not started yet, so the first `ThreadPool`
///     created (before any task is spawned) fixes the count for the process;
///   * `join_all` and `shutdown` drain the *runtime* pool, so if a program
///     holds two `ThreadPool` values they drain each other's work as well.
///
/// Uses atomic reference counting, so a pool may be shared across threads.
///
/// ## Example
///
/// ```rust
/// { ThreadPool, spawn } :: import "std/thread";
///
/// pool := ThreadPool.new(usize(4));
/// spawn(pool, (io) => {
///   // ... do work ...
/// });
/// pool.join_all(); // wait for everything submitted so far
/// pool.shutdown(); // refuse new work, then drain
/// ```
ThreadPool :: atomic(
  ref(
    struct(
      _mutex : Mutex(bool),
      _used : AtomicBool,
      _closed : AtomicBool,
      /// Which thread holds `_mutex`, so a submission made FROM a task that the
      /// runtime is running inline on the submitting thread (no worker thread
      /// could be created) re-enters instead of self-deadlocking
      /// (issues/fixed/thread-pool-spawn-self-deadlocked-in-the-inline-fallback.md).
      _held : AtomicBool,
      _owner : AtomicUsize
    )
  )
);
impl(
  ThreadPool,
  /// Create a pool that requests `num_threads` worker threads.
  ///
  /// `num_threads` must be > 0. It is a request, not a guarantee: see the
  /// type-level note about the process-global runtime pool.
  new : (fn(num_threads : usize) -> Self)({
    assert(num_threads > usize(0), "ThreadPool.new: num_threads must be > 0");
    __yo_worker_set_num_threads(num_threads);
    Self(
      _mutex : Mutex(bool).new(false),
      _used : AtomicBool(false),
      _closed : AtomicBool(false),
      _held : AtomicBool(false),
      _owner : AtomicUsize(usize(0))
    )
  }),
  /// Create a pool sized to the runtime pool's current thread count, which
  /// defaults to the number of hardware threads (CPU cores).
  with_hardware_threads : (fn() -> Self)(
    Self.new(__yo_worker_get_num_threads())
  ),
  /// The number of worker threads the runtime pool is using (or will use).
  num_threads : (fn(self : Self) -> usize)(
    __yo_worker_get_num_threads()
  ),
  /// Block until every task submitted to this pool so far has finished.
  /// The pool stays open — further `spawn` calls are still accepted.
  ///
  /// The drain is a barrier, not a counter: it submits one sentinel task per
  /// worker thread and waits for all of them. The runtime hands consecutive
  /// submissions to consecutive worker threads (round-robin, guarded by the
  /// runtime's pool mutex) and each worker runs its own queue in FIFO order,
  /// so once every sentinel has run, every task queued before it has run too.
  /// `spawn` and this submission loop share the pool mutex, so tasks
  /// submitted concurrently *through this pool* cannot break the round-robin
  /// stride.
  ///
  /// Must not be called from inside a pool task: the caller's worker thread
  /// would be busy waiting for its own sentinel.
  ///
  /// KNOWN LEAK, pre-existing and below std: a spawn wrapper never drops its
  /// closure's reference-counted captures, so the sentinels' `drained` channel
  /// is never freed and each call leaks ~344 bytes. Measured on `develop` too,
  /// with plain task closures — see
  /// `issues/spawn-closure-captures-never-dropped-leak.md`.
  join_all : (fn(self : Self) -> unit)({
    cond(
      self._used.load(MemoryOrder.Acquire) => {
        workers := __yo_worker_get_num_threads();
        drained := Channel(bool).new(workers);
        // Submit exactly one sentinel per worker, with no interleaved
        // submission from this pool.
        took := _lock_for_submission(self);
        (i : usize) = usize(0);
        while(runtime(i < workers), {
          __yo_worker_spawn((io : Io) => {
            drained.send(true);
            ()
          });
          i = (i + usize(1));
        });
        _unlock_after_submission(self, took);
        // Wait for every sentinel. Nothing is held while we block, so tasks
        // may keep arriving behind the barrier.
        (seen : usize) = usize(0);
        while(runtime(seen < workers), {
          drained.recv().unwrap();
          seen = (seen + usize(1));
        });
      },
      true => ()
    );
  }),
  /// Refuse new work, then block until every outstanding task has finished.
  ///
  /// Idempotent. The runtime's OS worker threads are process-global and are
  /// reclaimed at process exit; `shutdown` closes *this* pool and drains the
  /// work it submitted.
  shutdown : (fn(self : Self) -> unit)({
    self._closed.store(true, MemoryOrder.Release);
    self.join_all();
  }),
  /// Whether `shutdown` has been called (lock-free atomic load).
  is_shutdown : (fn(self : Self) -> bool)(
    self._closed.load(MemoryOrder.Acquire)
  )
);
/// Hand a task to `pool`. Returns immediately; the task runs on one of the
/// worker threads, which supplies it with its own Io event loop.
///
/// Panics if the pool has been shut down.
///
/// ```rust
/// spawn(pool, (io) => {
///   // ... do work ...
/// });
/// ```
//
// IMPLEMENTATION NOTE — this is deliberately a module-level function and not
// a `pool.spawn(cb)` method. A closure parameter that is forwarded into a
// spawn primitive from inside an impl method with a `self` receiver is
// specialized only once: with two or more differently-shaped task closures in
// one program, every shape after the first is emitted as a
// `// Failed to transpile` comment, so those tasks silently do nothing.
// Static impl methods (`Thread.spawn`) and free functions are unaffected.
// See issues/impl-method-self-receiver-hollows-forwarded-spawn-closures.md —
// do not "tidy" this into a method until that is fixed.
/// Take the pool's submission lock unless THIS thread already holds it, and
/// say whether it was taken. The runtime's inline fallback (no worker thread
/// could be created — standalone WASI, or thread creation failing) runs a
/// task on the submitting thread, INSIDE `spawn`'s critical section; a task
/// that itself spawns would then block on the mutex it already holds. Owner
/// tracking makes that submission re-entrant: `_owner` is written before
/// `_held` (Release) and `_held` is read before `_owner` (Acquire), so a
/// thread that sees `_held` set sees the owner who set it — a stale
/// `_owner` value can only be observed under `_held == false`, which takes
/// the lock as it should.
_lock_for_submission :: (fn(pool : ThreadPool) -> bool)({
  me := __yo_thread_self();
  cond(
    (pool._held.load(MemoryOrder.Acquire) && (pool._owner.load(MemoryOrder.Acquire) == me)) => false,
    true => {
      pool._mutex._raw_lock();
      pool._owner.store(me, MemoryOrder.Release);
      pool._held.store(true, MemoryOrder.Release);
      true
    }
  )
});
_unlock_after_submission :: (fn(pool : ThreadPool, took : bool) -> unit)({
  cond(
    took => {
      pool._held.store(false, MemoryOrder.Release);
      pool._mutex._raw_unlock();
    },
    true => ()
  );
});
spawn :: (fn(pool : ThreadPool, cb : Impl(Fn(io : Io) -> unit, Send)) -> unit)({
  assert(
    !pool._closed.load(MemoryOrder.Acquire),
    "thread.spawn: pool has been shut down"
  );
  // The pool mutex serializes submission so that `join_all`'s sentinel tasks
  // land on distinct worker threads (see `ThreadPool.join_all`); it is held
  // across `__yo_worker_spawn` because that call may run the task inline, so
  // it must be re-entrant for the task's own spawns.
  took := _lock_for_submission(pool);
  pool._used.store(true, MemoryOrder.Release);
  __yo_worker_spawn(cb);
  _unlock_after_submission(pool, took);
});
/// Get the number of hardware threads (CPU cores) available.
get_hardware_threads :: __yo_thread_get_hardware_threads;
/// Get the current OS thread ID.
get_thread_id :: __yo_get_thread_id;
/// The CPU core the calling thread is currently running on, or `-1` when the
/// platform cannot say. Linux (`sched_getcpu`) and Windows
/// (`GetCurrentProcessorNumber`) report it; macOS has no public per-thread
/// CPU query and always returns `-1`, as does WASM. Advisory only — the
/// scheduler may migrate the thread right after the call.
get_cpu_id :: __yo_get_cpu_id;
export(
  get_hardware_threads,
  get_thread_id,
  get_cpu_id,
  Thread,
  ThreadPool,
  spawn
);
