/// Option — a value that may or may not be present.
///
/// `Option(T)` has two variants:
/// - `.Some(value)` — contains a value of type `T`
/// - `.None` — contains no value
///
/// # Example
/// ```rust
/// (x : Option(i32)) = .Some(i32(42));
/// assert(x.is_some(), "expected Some");
/// assert((x.unwrap() == i32(42)), "expected 42");
/// ```
Option :: (fn(comptime(T) : Type) -> comptime(Type))(
  enum(
    None,
    Some(value : T)
  )
);
impl(
  generic(T : Type),
  Option(T),
  /// Extract the contained value, panicking with a message if `None`.
  unwrap : (fn(self : Self) -> T)(
    match(
      self,
      .Some(value) => value,
      .None => __yo_panic("Called unwrap on a None value")
    )
  ),
  /// Extract the contained value, or return `or_value` if `None`.
  unwrap_or : (fn(self : Self, or_value : T) -> T)(
    match(
      self,
      .Some(value) => value,
      .None => or_value
    )
  ),
  /// Return `true` if the option contains a value.
  is_some : (fn(self : Self) -> bool)(
    match(
      self,
      .Some(_) => true,
      .None => false
    )
  ),
  /// Return `true` if the option is `None`.
  is_none : (fn(self : Self) -> bool)(
    match(
      self,
      .None => true,
      .Some(_) => false
    )
  )
);
/// Functional combinators for `Option(T)`.
impl(
  generic(T : Type),
  Option(T),
  /// Apply `f` to the contained value (if `Some`), or return `None`.
  map : (fn(generic(B : Type), self : Self, f : Impl(Fn(a : T) -> B)) -> Option(B))(
    match(
      self,
      .Some(value) => Option(B).Some(f(value)),
      .None => Option(B).None
    )
  ),
  /// Apply `f` to the contained value (if `Some`) and flatten the result.
  and_then : (fn(generic(B : Type), self : Self, f : Impl(Fn(a : T) -> Option(B))) -> Option(B))(
    match(
      self,
      .Some(value) => f(value),
      .None => Option(B).None
    )
  ),
  /// Return `Some(value)` if the predicate returns `true`, otherwise `None`.
  filter : (fn(self : Self, predicate : Impl(Fn(a : T) -> bool)) -> Option(T))(
    match(
      self,
      .Some(value) => cond(
        predicate(value) => Option(T).Some(value),
        true => Option(T).None
      ),
      .None => Option(T).None
    )
  ),
  /// Return this option if `Some`, otherwise call `f` and return its result.
  or_else : (fn(self : Self, f : Impl(Fn() -> Option(T))) -> Option(T))(
    match(
      self,
      .Some(value) => Option(T).Some(value),
      .None => f()
    )
  ),
  /// Apply `f` if `Some`, otherwise return `default_val`.
  map_or : (fn(generic(B : Type), self : Self, default_val : B, f : Impl(Fn(a : T) -> B)) -> B)(
    match(
      self,
      .Some(value) => f(value),
      .None => default_val
    )
  ),
  /// Apply `f` if `Some`, otherwise call `default_fn`.
  map_or_else : (fn(generic(B : Type), self : Self, default_fn : Impl(Fn() -> B), f : Impl(Fn(a : T) -> B)) -> B)(
    match(
      self,
      .Some(value) => f(value),
      .None => default_fn()
    )
  ),
  /// Return `optb` if `self` is `Some`, otherwise `None`.
  and : (fn(generic(B : Type), self : Self, optb : Option(B)) -> Option(B))(
    match(
      self,
      .Some(_) => optb,
      .None => Option(B).None
    )
  ),
  /// Return `self` if `Some`, otherwise return `optb`.
  or : (fn(self : Self, optb : Option(T)) -> Option(T))(
    match(
      self,
      .Some(value) => Option(T).Some(value),
      .None => optb
    )
  ),
  /// Extract the contained value, or call `f` to produce a default.
  unwrap_or_else : (fn(self : Self, f : Impl(Fn() -> T)) -> T)(
    match(
      self,
      .Some(value) => value,
      .None => f()
    )
  ),
  /// Extract the contained value, panicking with `msg` if `None`.
  expect : (fn(self : Self, msg : str) -> T)(
    match(
      self,
      .Some(value) => value,
      .None => __yo_panic(msg)
    )
  ),
  /// Return `true` if `Some` and the predicate holds for the value.
  is_some_and : (fn(self : Self, f : Impl(Fn(a : T) -> bool)) -> bool)(
    match(
      self,
      .Some(value) => f(value),
      .None => false
    )
  ),
  /// Call `f` with the contained value (if `Some`), then return the option.
  inspect : (fn(self : Self, f : Impl(Fn(a : T) -> unit)) -> Option(T))(
    match(
      self,
      .Some(value) => {
        f(value);
        Option(T).Some(value)
      },
      .None => Option(T).None
    )
  )
);
/// In-place helpers for `Option(T)` (plans/STD_API_AUDIT.md D3.7).
impl(
  generic(T : Type),
  Option(T),
  /// Take the value out of the option, leaving `None` in its place.
  take : (fn(inout(self) : Self) -> Option(T))({
    old := self;
    self = Option(T).None;
    old
  }),
  /// Replace the contained value with `Some(value)`, returning the old option.
  replace : (fn(inout(self) : Self, value : T) -> Option(T))({
    old := self;
    self = Option(T).Some(value);
    old
  })
);
/// Flatten a nested `Option(Option(T))` into `Option(T)`.
impl(
  generic(T : Type),
  Option(Option(T)),
  /// Collapse one level of nesting.
  flatten : (fn(self : Self) -> Option(T))(
    match(
      self,
      .Some(inner) => inner,
      .None => Option(T).None
    )
  )
);
/// `Option(T)` defaults to `.None`.
impl(
  generic(T : Type),
  Option(T),
  Default(
    default : (fn() -> Self)(Option(T).None)
  )
);
/// Default-aware helpers for `Option(T)` (plans/STD_API_AUDIT.md D3.1/D3.7).
impl(
  generic(T : Type),
  where(T <: Default),
  Option(T),
  /// Extract the contained value, or `T`'s default when `None`.
  unwrap_or_default : (fn(self : Self) -> T)(
    match(
      self,
      .Some(value) => value,
      .None => (T <: Default).default()
    )
  )
);
/// `Option(T)` implements `Comptime` when `T` implements `Comptime`.
impl(generic(T : Type), where(T <: Comptime), Option(T), Comptime());
/// Compile-time methods for `Option(T)`.
impl(
  generic(T : Type),
  where(T <: Comptime),
  Option(T),
  /// Compile-time unwrap — panics at compile-time if `None`.
  comptime_unwrap : (fn(comptime(self) : Self) -> comptime(T))(
    match(
      self,
      .Some(value) => value,
      .None => __yo_panic("Called comptime_unwrap on a None value")
    )
  ),
  comptime_unwrap_or : (fn(comptime(self) : Self, comptime(or_value) : T) -> comptime(T))(
    match(
      self,
      .Some(value) => value,
      .None => or_value
    )
  ),
  comptime_is_some : (fn(comptime(self) : Self) -> comptime(bool))(
    match(
      self,
      .Some(_) => true,
      .None => false
    )
  ),
  comptime_is_none : (fn(comptime(self) : Self) -> comptime(bool))(
    match(
      self,
      .None => true,
      .Some(_) => false
    )
  )
);
/// `?` is a shorthand alias for `Option`.
? :: Option;
// The `(?*)` nullable-pointer alias was REMOVED 2026-08-21
// (plans/OPERATOR_SET_AND_PRECEDENCE.md): `?*` is no longer an operator
// token — write the composition `?(*(T))` (i.e. `Option(*(T))`) instead.
export(
  Option,
  ?
);
/// DeriveContext — context passed to derive rule functions (needs Option).
/// Used by the `derive` macro to generate trait implementations.
DeriveContext :: struct(
  /// The AST expression for the target type.
  target : Expr,
  /// Optional generic parameters for generic types.
  forall_params : Option(Expr),
  /// Optional where clause for constrained generics.
  where_clause : Option(Expr)
);
impl(DeriveContext, Comptime());
impl(
  DeriveContext,
  make_impl : (fn(comptime(self) : DeriveContext, comptime(trait_body) : Expr) -> comptime(Expr))(
    cond(
      self.forall_params.comptime_is_some() => cond(
        self.where_clause.comptime_is_some() =>
          quote(
            impl(
              unquote(self.forall_params.comptime_unwrap()),
              unquote(self.target),
              unquote(self.where_clause.comptime_unwrap()),
              unquote(trait_body)
            )
          ),
        true =>
          quote(
            impl(
              unquote(self.forall_params.comptime_unwrap()),
              unquote(self.target),
              unquote(trait_body)
            )
          )
      ),
      true => quote(
        impl(
          unquote(self.target),
          unquote(trait_body)
        )
      )
    )
  )
);
export(DeriveContext);
// ============================================================
// Built-in derive rules
// ============================================================
// Helper: fold over a range [0..n) at comptime
__yo_comptime_fold_range :: (
  fn(
    comptime(n) : usize,
    comptime(init) : comptime_str,
    comptime(f) : (fn(comptime(acc) : comptime_str, comptime(i) : usize) -> comptime(comptime_str))
  ) -> comptime(comptime_str)
)(
  cond(
    (n == usize(0)) => init,
    (n == usize(1)) => f(init, usize(0)),
    true => f(recur(n - usize(1), init, f), n - usize(1))
  )
);
// Helper: concat 2 strings
__s2 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str) -> comptime(comptime_str))(a + b);
// Helper: concat 3 strings
__s3 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str) -> comptime(comptime_str))(
  (a + b) + c
);
// Helper: concat 4 strings
__s4 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str, comptime(d) : comptime_str) -> comptime(comptime_str))(
  ((a + b) + c) + d
);
// Helper: concat 5 strings
__s5 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str, comptime(d) : comptime_str, comptime(e) : comptime_str) -> comptime(comptime_str))(
  (((a + b) + c) + d) + e
);
// --- derive_rule for Eq ---
__derive_eq :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))({
  info :: Type.get_info(T);
  cond(
    info.is_struct() => {
      eq_body :: cond(
        (Type.get_struct_fields(T).len() == usize(0)) => quote(true),
        true => Type.join_fields(
          T,
          (fn(comptime(field) : FieldInfo) -> comptime(Expr))(
            quote(lhs.(#(field.name.to_expr())) == rhs.(#(field.name.to_expr())))
          ),
          quote(&&)
        )
      );
      ctx.make_impl(
        quote(
          Eq(...#(trait_params))(
            (==) : ((lhs, rhs) -> #(eq_body)),
            (!=) : ((lhs, rhs) -> not(lhs == rhs))
          )
        )
      )
    },
    info.is_enum() => {
      variants :: Type.get_enum_variants(T);
      vc :: variants.len();
      eq_branches :: __yo_comptime_fold_range(
        vc,
        "",
        (fn(comptime(acc) : comptime_str, comptime(vi) : usize) -> comptime(comptime_str))({
          v :: variants.get(vi);
          branch :: cond(
            (v.fields.len() == 0) =>
              __s5(".", v.name, " => match(rhs, .", v.name, " => true, _ => false)"),
            true => {
              lhs_bindings :: __yo_comptime_fold_range(
                v.fields.len(),
                "",
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  cond(
                    (a == "") => __s2("__lhs_", fname),
                    true => __s3(a, ", __lhs_", fname)
                  )
                })
              );
              rhs_bindings :: __yo_comptime_fold_range(
                v.fields.len(),
                "",
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  cond(
                    (a == "") => __s2("__rhs_", fname),
                    true => __s3(a, ", __rhs_", fname)
                  )
                })
              );
              eq_cmp :: __yo_comptime_fold_range(
                v.fields.len(),
                "",
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  part :: __s4("(__lhs_", fname, " == __rhs_", fname);
                  cond(
                    (a == "") => __s2(part, ")"),
                    true => __s5("(", a, " && ", __s2(part, ")"), ")")
                  )
                })
              );
              __s5(
                __s3(".", v.name, "("),
                lhs_bindings,
                __s3(") => match(rhs, .", v.name, "("),
                rhs_bindings,
                __s3(") => ", eq_cmp, ", _ => false)")
              )
            }
          );
          cond(
            (acc == "") => branch,
            true => __s3(acc, ",\n    ", branch)
          )
        })
      );
      match_body :: __s3("match(lhs,\n    ", eq_branches, "\n  )");
      ctx.make_impl(
        quote(
          Eq(...#(trait_params))(
            (==) : ((lhs, rhs) -> #(match_body.to_expr())),
            (!=) : ((lhs, rhs) -> not(lhs == rhs))
          )
        )
      )
    },
    true =>
      ctx.make_impl(
        quote(
          Eq(...#(trait_params))(
            (==) : ((lhs, rhs) -> true),
            (!=) : ((lhs, rhs) -> not(lhs == rhs))
          )
        )
      )
  )
});
derive_rule(Eq, __derive_eq);
// `Pragma` (defined near the top) is compared by `==` in the compiler's
// memory-safety pragma registry. Derived here, once the `Eq` derive rule
// is registered.
derive(Pragma, Eq(Pragma));
// --- derive_rule for Clone ---
__derive_clone :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))({
  info :: Type.get_info(T);
  cond(
    info.is_struct() => {
      fields :: Type.get_struct_fields(T);
      fc :: fields.len();
      cloned_fields :: __yo_comptime_fold_range(
        fc,
        "",
        (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
          fname :: fields.get(fi).name;
          part :: __s3("self.", fname, ".clone()");
          cond(
            (a == "") => part,
            true => __s3(a, ", ", part)
          )
        })
      );
      // Construct through `Self`, NOT through a rendered type name:
      // `Type.to_comptime_string` is a DISPLAY renderer and returns an
      // unusable `<struct:…>` placeholder for an instantiated generic, which
      // made `derive(Clone)` fail outright on every generic struct.
      clone_body :: __s3("Self(", cloned_fields, ")");
      ctx.make_impl(
        quote(
          Clone(
            clone : ((self) -> #(clone_body.to_expr()))
          )
        )
      )
    },
    info.is_enum() => {
      variants :: Type.get_enum_variants(T);
      vc :: variants.len();
      clone_branches :: __yo_comptime_fold_range(
        vc,
        "",
        (fn(comptime(acc) : comptime_str, comptime(vi) : usize) -> comptime(comptime_str))({
          v :: variants.get(vi);
          branch :: cond(
            (v.fields.len() == 0) => __s4(".", v.name, " => .", v.name),
            true => {
              bindings :: __yo_comptime_fold_range(
                v.fields.len(),
                "",
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  cond(
                    (a == "") => __s2("__v_", fname),
                    true => __s3(a, ", __v_", fname)
                  )
                })
              );
              cloned :: __yo_comptime_fold_range(
                v.fields.len(),
                "",
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  cond(
                    (a == "") => __s3("__v_", fname, ".clone()"),
                    true => __s4(a, ", __v_", fname, ".clone()")
                  )
                })
              );
              __s5(
                __s3(".", v.name, "("),
                bindings,
                __s3(") => .", v.name, "("),
                cloned,
                ")"
              )
            }
          );
          cond(
            (acc == "") => branch,
            true => __s3(acc, ",\n    ", branch)
          )
        })
      );
      match_body :: __s3("match(self,\n    ", clone_branches, "\n  )");
      ctx.make_impl(
        quote(
          Clone(
            clone : ((self) -> #(match_body.to_expr()))
          )
        )
      )
    },
    true =>
      ctx.make_impl(
        quote(
          Clone(
            clone : ((self) -> self)
          )
        )
      )
  )
});
derive_rule(Clone, __derive_clone);
// --- derive_rule for Hash ---
__derive_hash :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))({
  info :: Type.get_info(T);
  cond(
    info.is_struct() => {
      fields :: Type.get_struct_fields(T);
      fc :: fields.len();
      cond(
        (fc == 0) =>
          ctx.make_impl(
            quote(
              Hash(
                (hash) : ((self) -> u64(0))
              )
            )
          ),
        true => {
          hash_stmts :: __yo_comptime_fold_range(
            fc,
            "",
            (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
              fname :: fields.get(fi).name;
              cond(
                (fi == 0) => __s3("(h : u64) = self.", fname, ".hash()"),
                true => __s4(a, ";\n    h = ((h * u64(31)) + self.", fname, ".hash())")
              )
            })
          );
          hash_body :: __s3("{\n    ", hash_stmts, ";\n    return(h);\n  }");
          ctx.make_impl(
            quote(
              Hash(
                (hash) : ((self) -> #(hash_body.to_expr()))
              )
            )
          )
        }
      )
    },
    info.is_enum() => {
      variants :: Type.get_enum_variants(T);
      vc :: variants.len();
      hash_branches :: __yo_comptime_fold_range(
        vc,
        "",
        (fn(comptime(acc) : comptime_str, comptime(vi) : usize) -> comptime(comptime_str))({
          v :: variants.get(vi);
          vi_str :: __yo_comptime_usize_to_comptime_string(vi);
          branch :: cond(
            (v.fields.len() == 0) => __s4(".", v.name, " => u64(", __s2(vi_str, ")")),
            true => {
              bindings :: __yo_comptime_fold_range(
                v.fields.len(),
                "",
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  cond(
                    (a == "") => __s2("__v_", fname),
                    true => __s3(a, ", __v_", fname)
                  )
                })
              );
              hash_stmts :: __yo_comptime_fold_range(
                v.fields.len(),
                __s3("(h : u64) = u64(", vi_str, ")"),
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  __s4(a, "; h = ((h * u64(31)) + __v_", fname, ".hash())")
                })
              );
              __s5(
                __s3(".", v.name, "("),
                bindings,
                ") => { ",
                __s2(hash_stmts, "; h"),
                "; }"
              )
            }
          );
          cond(
            (acc == "") => branch,
            true => __s3(acc, ",\n    ", branch)
          )
        })
      );
      match_body :: __s3("match(self,\n    ", hash_branches, "\n  )");
      ctx.make_impl(
        quote(
          Hash(
            (hash) : ((self) -> #(match_body.to_expr()))
          )
        )
      )
    },
    true =>
      ctx.make_impl(
        quote(
          Hash(
            (hash) : ((self) -> u64(0))
          )
        )
      )
  )
});
derive_rule(Hash, __derive_hash);
// --- derive_rule for Ord ---
// Helper: generate lexicographic comparison for struct fields
__derive_ord_struct_body :: (fn(comptime(T) : Type, comptime(op) : comptime_str) -> comptime(comptime_str))({
  fields :: Type.get_struct_fields(T);
  fc :: fields.len();
  cond(
    (fc == 1) => {
      fname :: fields.get(0).name;
      __s5("(lhs.", fname, " ", op, __s3(" rhs.", fname, ")"))
    },
    true => {
      branches :: __yo_comptime_fold_range(
        fc,
        "",
        (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
          fname :: fields.get(fi).name;
          branch :: cond(
            (fi == (fc - 1)) =>
              __s5("true => (lhs.", fname, " ", op, __s3(" rhs.", fname, ")")),
            true =>
              __s5("(lhs.", fname, " != rhs.", fname, __s5(") => (lhs.", fname, " ", op, __s3(" rhs.", fname, ")")))
          );
          cond(
            (a == "") => branch,
            true => __s3(a, ",\n      ", branch)
          )
        })
      );
      __s3("cond(\n      ", branches, "\n    )")
    }
  )
});
// Helper: generate lexicographic comparison for enum variant bindings
__derive_ord_variant_body :: (fn(comptime(v) : VariantInfo, comptime(op) : comptime_str) -> comptime(comptime_str))(
  cond(
    (v.fields.len() == 1) => {
      fname :: v.fields.get(0).name;
      __s5("(__lhs_", fname, " ", op, __s3(" __rhs_", fname, ")"))
    },
    true => {
      branches :: __yo_comptime_fold_range(
        v.fields.len(),
        "",
        (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
          fname :: v.fields.get(fi).name;
          branch :: cond(
            (fi == (v.fields.len() - 1)) =>
              __s5("true => (__lhs_", fname, " ", op, __s3(" __rhs_", fname, ")")),
            true =>
              __s5("(__lhs_", fname, " != __rhs_", fname, __s5(") => (__lhs_", fname, " ", op, __s3(" __rhs_", fname, ")")))
          );
          cond(
            (a == "") => branch,
            true => __s3(a, ",\n        ", branch)
          )
        })
      );
      __s3("cond(\n        ", branches, "\n      )")
    }
  )
);
__derive_ord :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))({
  info :: Type.get_info(T);
  cond(
    info.is_struct() => {
      fields :: Type.get_struct_fields(T);
      fc :: fields.len();
      cond(
        (fc == 0) =>
          ctx.make_impl(
            quote(
              Ord(...#(trait_params))(
                (<) : ((lhs, rhs) -> false),
                (<=) : ((lhs, rhs) -> true),
                (>) : ((lhs, rhs) -> false),
                (>=) : ((lhs, rhs) -> true)
              )
            )
          ),
        true => {
          lt_body :: __derive_ord_struct_body(T, "<");
          le_body :: __derive_ord_struct_body(T, "<=");
          gt_body :: __derive_ord_struct_body(T, ">");
          ge_body :: __derive_ord_struct_body(T, ">=");
          ctx.make_impl(
            quote(
              Ord(...#(trait_params))(
                (<) : ((lhs, rhs) -> #(lt_body.to_expr())),
                (<=) : ((lhs, rhs) -> #(le_body.to_expr())),
                (>) : ((lhs, rhs) -> #(gt_body.to_expr())),
                (>=) : ((lhs, rhs) -> #(ge_body.to_expr()))
              )
            )
          )
        }
      )
    },
    info.is_enum() => {
      variants :: Type.get_enum_variants(T);
      vc :: variants.len();
      // Generate one operator's match branches
      __gen_op_branches :: (fn(comptime(op) : comptime_str, comptime(eq_val) : comptime_str) -> comptime(comptime_str))({
        branches :: __yo_comptime_fold_range(
          vc,
          "",
          (fn(comptime(acc) : comptime_str, comptime(vi) : usize) -> comptime(comptime_str))({
            v :: variants.get(vi);
            branch :: cond(
              (v.fields.len() == 0) =>
                __s5(".", v.name, " => match(rhs, .", v.name, __s4(" => ", eq_val, ", _ => (i32(lhs) ", __s2(op, " i32(rhs)))"))),
              true => {
                lhs_bindings :: __yo_comptime_fold_range(
                  v.fields.len(),
                  "",
                  (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                    fname :: v.fields.get(fi).name;
                    cond(
                      (a == "") => __s2("__lhs_", fname),
                      true => __s3(a, ", __lhs_", fname)
                    )
                  })
                );
                rhs_bindings :: __yo_comptime_fold_range(
                  v.fields.len(),
                  "",
                  (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                    fname :: v.fields.get(fi).name;
                    cond(
                      (a == "") => __s2("__rhs_", fname),
                      true => __s3(a, ", __rhs_", fname)
                    )
                  })
                );
                field_cmp :: __derive_ord_variant_body(v, op);
                __s5(
                  __s3(".", v.name, "("),
                  lhs_bindings,
                  __s3(") => match(rhs, .", v.name, "("),
                  rhs_bindings,
                  __s4(") => ", field_cmp, ", _ => (i32(lhs) ", __s2(op, " i32(rhs)))"))
                )
              }
            );
            cond(
              (acc == "") => branch,
              true => __s3(acc, ",\n      ", branch)
            )
          })
        );
        __s3("match(lhs,\n      ", branches, "\n    )")
      });
      lt_match :: __gen_op_branches("<", "false");
      le_match :: __gen_op_branches("<=", "true");
      gt_match :: __gen_op_branches(">", "false");
      ge_match :: __gen_op_branches(">=", "true");
      ctx.make_impl(
        quote(
          Ord(...#(trait_params))(
            (<) : ((lhs, rhs) -> #(lt_match.to_expr())),
            (<=) : ((lhs, rhs) -> #(le_match.to_expr())),
            (>) : ((lhs, rhs) -> #(gt_match.to_expr())),
            (>=) : ((lhs, rhs) -> #(ge_match.to_expr()))
          )
        )
      )
    },
    true =>
      ctx.make_impl(
        quote(
          Ord(...#(trait_params))(
            (<) : ((lhs, rhs) -> false),
            (<=) : ((lhs, rhs) -> true),
            (>) : ((lhs, rhs) -> false),
            (>=) : ((lhs, rhs) -> true)
          )
        )
      )
  )
});
derive_rule(Ord, __derive_ord);
// --- derive_rule for Default ---
/// `derive(Default)` for structs: every field takes its own type's default.
///
/// Each field's type is named by INDEXING the struct's own field list —
/// `(Type.get_struct_fields(Self).get(i).field_type <: Default).default()` —
/// rather than by rendering the type back to source. Rendering does not work
/// here: `Type.to_comptime_string` returns an unusable `<struct:…>` / `<enum:…>`
/// placeholder for every INSTANTIATED generic (`Option(i32)`, `ArrayList(i32)`,
/// any user generic), so a rendered `Option(String)` field would not reparse.
/// Indexing sidesteps that entirely and needs no field type to be in scope at
/// the impl site. See issues/type-to-comptime-string-placeholder-for-generics.md.
///
/// Structs only. An enum has no canonical default variant — Rust needs an
/// explicit `#[default]` attribute to pick one, and Yo has no such attribute,
/// so guessing (say, the first variant) would be a silent choice rather than a
/// declared one.
__derive_default :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))({
  info :: Type.get_info(T);
  comptime_assert(
    info.is_struct(),
    "derive(Default) supports structs only — an enum has no canonical default variant, so write the impl by hand"
  );
  fields :: Type.get_struct_fields(T);
  fc :: fields.len();
  default_fields :: __yo_comptime_fold_range(
    fc,
    "",
    (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
      fname :: fields.get(fi).name;
      part :: __s5(
        fname,
        " : (Type.get_struct_fields(Self).get(",
        fi.to_comptime_string(),
        ").field_type <: Default).default()",
        ""
      );
      cond(
        (a == "") => part,
        true => __s3(a, ", ", part)
      )
    })
  );
  default_body :: __s3("Self(", default_fields, ")");
  ctx.make_impl(
    quote(
      Default(
        default : (() -> #(default_body.to_expr()))
      )
    )
  )
});
derive_rule(Default, __derive_default);
/// Result — a value that is either success (`Ok`) or failure (`Err`).
///
/// `Result(OkType, ErrorType)` has two variants:
/// - `.Ok(value)` — contains a success value of type `OkType`
/// - `.Err(error)` — contains an error value of type `ErrorType`
///
/// # Example
/// ```rust
/// (r : Result(i32, str)) = .Ok(i32(42));
/// assert(r.is_ok(), "expected Ok");
/// ```
Result :: (fn(comptime(OkType) : Type, comptime(ErrorType) : Type) -> comptime(Type))(
  enum(
    Ok(value : OkType),
    Err(error : ErrorType)
  )
);
impl(
  generic(OkType : Type, ErrorType : Type),
  Result(OkType, ErrorType),
  /// Extract the `Ok` value, panicking if `Err`.
  unwrap : (fn(self : Self) -> OkType)(
    match(
      self,
      .Ok(value) => value,
      .Err(_) => __yo_panic("Called unwrap on an Error value")
    )
  ),
  /// Extract the `Err` value, panicking if `Ok`.
  unwrap_err : (fn(self : Self) -> ErrorType)(
    match(
      self,
      .Err(error) => error,
      .Ok(_) => __yo_panic("Called unwrap_err on an Ok value")
    )
  ),
  /// Return `true` if the result is `Ok`.
  is_ok : (fn(self : Self) -> bool)(
    match(
      self,
      .Ok(_) => true,
      .Err(_) => false
    )
  ),
  /// Return `true` if the result is `Err`.
  is_err : (fn(self : Self) -> bool)(
    match(
      self,
      .Err(_) => true,
      .Ok(_) => false
    )
  )
);
/// Functional combinators for `Result(OkType, ErrorType)`.
impl(
  generic(OkType : Type, ErrorType : Type),
  Result(OkType, ErrorType),
  /// Map the `Ok` value with `f`, leaving `Err` untouched.
  map : (fn(generic(B : Type), self : Self, f : Impl(Fn(a : OkType) -> B)) -> Result(B, ErrorType))(
    match(
      self,
      .Ok(value) => Result(B, ErrorType).Ok(f(value)),
      .Err(error) => Result(B, ErrorType).Err(error)
    )
  ),
  /// Map the `Err` value with `f`, leaving `Ok` untouched.
  map_err : (fn(generic(F : Type), self : Self, f : Impl(Fn(a : ErrorType) -> F)) -> Result(OkType, F))(
    match(
      self,
      .Ok(value) => Result(OkType, F).Ok(value),
      .Err(error) => Result(OkType, F).Err(f(error))
    )
  ),
  /// Chain a computation that may fail on the `Ok` value.
  and_then : (fn(generic(B : Type), self : Self, f : Impl(Fn(a : OkType) -> Result(B, ErrorType))) -> Result(B, ErrorType))(
    match(
      self,
      .Ok(value) => f(value),
      .Err(error) => Result(B, ErrorType).Err(error)
    )
  ),
  /// Chain a recovery computation on the `Err` value.
  or_else : (fn(generic(F : Type), self : Self, f : Impl(Fn(a : ErrorType) -> Result(OkType, F))) -> Result(OkType, F))(
    match(
      self,
      .Ok(value) => Result(OkType, F).Ok(value),
      .Err(error) => f(error)
    )
  ),
  /// Return `res` if `Ok`, otherwise propagate `Err`.
  and : (fn(generic(B : Type), self : Self, res : Result(B, ErrorType)) -> Result(B, ErrorType))(
    match(
      self,
      .Ok(_) => res,
      .Err(error) => Result(B, ErrorType).Err(error)
    )
  ),
  /// Return `self` if `Ok`, otherwise return `res`.
  or : (fn(generic(F : Type), self : Self, res : Result(OkType, F)) -> Result(OkType, F))(
    match(
      self,
      .Ok(value) => Result(OkType, F).Ok(value),
      .Err(_) => res
    )
  ),
  /// Convert to `Option(OkType)`, discarding the error.
  ok : (fn(self : Self) -> Option(OkType))(
    match(
      self,
      .Ok(value) => Option(OkType).Some(value),
      .Err(_) => Option(OkType).None
    )
  ),
  /// Convert to `Option(ErrorType)`, discarding the success value.
  err : (fn(self : Self) -> Option(ErrorType))(
    match(
      self,
      .Ok(_) => Option(ErrorType).None,
      .Err(error) => Option(ErrorType).Some(error)
    )
  ),
  /// Apply `f` if `Ok`, otherwise return `default_val`.
  map_or : (fn(generic(B : Type), self : Self, default_val : B, f : Impl(Fn(a : OkType) -> B)) -> B)(
    match(
      self,
      .Ok(value) => f(value),
      .Err(_) => default_val
    )
  ),
  /// Apply `f` if `Ok`, otherwise call `default_fn` with the error.
  map_or_else : (fn(generic(B : Type), self : Self, default_fn : Impl(Fn(a : ErrorType) -> B), f : Impl(Fn(a : OkType) -> B)) -> B)(
    match(
      self,
      .Ok(value) => f(value),
      .Err(error) => default_fn(error)
    )
  ),
  /// Extract the `Ok` value, or call `f` with the error to produce a fallback.
  unwrap_or_else : (fn(self : Self, f : Impl(Fn(a : ErrorType) -> OkType)) -> OkType)(
    match(
      self,
      .Ok(value) => value,
      .Err(error) => f(error)
    )
  ),
  /// Extract the `Ok` value, or return `or_value` if `Err`.
  unwrap_or : (fn(self : Self, or_value : OkType) -> OkType)(
    match(
      self,
      .Ok(value) => value,
      .Err(_) => or_value
    )
  ),
  /// Extract the `Ok` value, panicking with `msg` if `Err`.
  expect : (fn(self : Self, msg : str) -> OkType)(
    match(
      self,
      .Ok(value) => value,
      .Err(_) => __yo_panic(msg)
    )
  ),
  /// Extract the `Err` value, panicking with `msg` if `Ok`.
  expect_err : (fn(self : Self, msg : str) -> ErrorType)(
    match(
      self,
      .Err(error) => error,
      .Ok(_) => __yo_panic(msg)
    )
  ),
  /// Call `f` with the `Ok` value (if any), then return the result.
  inspect : (fn(self : Self, f : Impl(Fn(a : OkType) -> unit)) -> Result(OkType, ErrorType))(
    match(
      self,
      .Ok(value) => {
        f(value);
        Result(OkType, ErrorType).Ok(value)
      },
      .Err(error) => Result(OkType, ErrorType).Err(error)
    )
  ),
  /// Call `f` with the `Err` value (if any), then return the result.
  inspect_err : (fn(self : Self, f : Impl(Fn(a : ErrorType) -> unit)) -> Result(OkType, ErrorType))(
    match(
      self,
      .Ok(value) => Result(OkType, ErrorType).Ok(value),
      .Err(error) => {
        f(error);
        Result(OkType, ErrorType).Err(error)
      }
    )
  )
);
/// Extract the `Ok` value, or `OkType`'s default when `Err`
/// (plans/STD_API_AUDIT.md D3.1/D3.7).
impl(
  generic(OkType : Type, ErrorType : Type),
  where(OkType <: Default),
  Result(OkType, ErrorType),
  unwrap_or_default : (fn(self : Self) -> OkType)(
    match(
      self,
      .Ok(value) => value,
      .Err(_) => (OkType <: Default).default()
    )
  )
);
/// Flatten a nested `Result(Result(T, E), E)` into `Result(T, E)`.
impl(
  generic(T : Type, E : Type),
  Result(Result(T, E), E),
  /// Collapse one level of nesting.
  flatten : (fn(self : Self) -> Result(T, E))(
    match(
      self,
      .Ok(inner) => inner,
      .Err(error) => Result(T, E).Err(error)
    )
  )
);
/// Transpose a `Result` of an `Option` into an `Option` of a `Result`.
impl(
  generic(T : Type, E : Type),
  Result(Option(T), E),
  /// `Ok(Some(v))` becomes `Some(Ok(v))`, `Ok(None)` becomes `None`,
  /// `Err(e)` becomes `Some(Err(e))`.
  transpose : (fn(self : Self) -> Option(Result(T, E)))(
    match(
      self,
      .Ok(opt) => match(
        opt,
        .Some(value) => Option(Result(T, E)).Some(Result(T, E).Ok(value)),
        .None => Option(Result(T, E)).None
      ),
      .Err(error) => Option(Result(T, E)).Some(Result(T, E).Err(error))
    )
  )
);
/// Transpose an `Option` of a `Result` into a `Result` of an `Option`.
impl(
  generic(T : Type, E : Type),
  Option(Result(T, E)),
  /// `Some(Ok(v))` becomes `Ok(Some(v))`, `None` becomes `Ok(None)`,
  /// `Some(Err(e))` becomes `Err(e)`.
  transpose : (fn(self : Self) -> Result(Option(T), E))(
    match(
      self,
      .Some(r) => match(
        r,
        .Ok(value) => Result(Option(T), E).Ok(Option(T).Some(value)),
        .Err(error) => Result(Option(T), E).Err(error)
      ),
      .None => Result(Option(T), E).Ok(Option(T).None)
    )
  )
);
/// `Option` to `Result` conversion methods (defined after `Result`).
impl(
  generic(T : Type),
  Option(T),
  /// Convert `Some(value)` to `Ok(value)`, or return `Err(err)` if `None`.
  ok_or : (fn(generic(E : Type), self : Self, err : E) -> Result(T, E))(
    match(
      self,
      .Some(value) => Result(T, E).Ok(value),
      .None => Result(T, E).Err(err)
    )
  ),
  /// Convert `Some(value)` to `Ok(value)`, or call `err_fn` to produce `Err` if `None`.
  ok_or_else : (fn(generic(E : Type), self : Self, err_fn : Impl(Fn() -> E)) -> Result(T, E))(
    match(
      self,
      .Some(value) => Result(T, E).Ok(value),
      .None => Result(T, E).Err(err_fn())
    )
  )
);
/// `Result(OkType, ErrorType)` implements `Comptime` when both types implement `Comptime`.
impl(generic(OkType : Type, ErrorType : Type), where(OkType <: Comptime, ErrorType <: Comptime), Result(OkType, ErrorType), Comptime());
/// Compile-time methods for `Result(OkType, ErrorType)`.
impl(
  generic(OkType : Type, ErrorType : Type),
  where(OkType <: Comptime, ErrorType <: Comptime),
  Result(OkType, ErrorType),
  /// Compile-time unwrap — panics at compile-time if `Err`.
  comptime_unwrap : (fn(comptime(self) : Self) -> comptime(OkType))(
    match(
      self,
      .Ok(value) => value,
      .Err(_) => __yo_panic("Called comptime_unwrap on an Err value")
    )
  ),
  comptime_unwrap_err : (fn(comptime(self) : Self) -> comptime(ErrorType))(
    match(
      self,
      .Err(error) => error,
      .Ok(_) => __yo_panic("Called comptime_unwrap_err on an Ok value")
    )
  ),
  comptime_is_ok : (fn(comptime(self) : Self) -> comptime(bool))(
    match(
      self,
      .Ok(_) => true,
      .Err(_) => false
    )
  ),
  comptime_is_err : (fn(comptime(self) : Self) -> comptime(bool))(
    match(
      self,
      .Err(_) => true,
      .Ok(_) => false
    )
  )
);
/// Clone for `Option(T)` — clones the inner value when `Some`.
impl(
  generic(T : Type),
  where(T <: Clone),
  Option(T),
  Clone(
    clone : (
      (self) ->
        match(
          self,
          .None => Option(T).None,
          .Some(v) => Option(T).Some(v.clone())
        )
    )
  )
);
/// Equality for `Option(T)` — `Some(a) == Some(b)` iff `a == b`; `None == None`.
impl(
  generic(T : Type),
  where(T <: Eq(T)),
  Option(T),
  Eq(Option(T))(
    (==) : (
      (lhs, rhs) ->
        match(
          lhs,
          .None => match(rhs, .None => true, .Some(_) => false),
          .Some(a) => match(
            rhs,
            .None => false,
            .Some(b) => (a == b)
          )
        )
    )
  )
);
/// Ordering for `Option(T)` — `None` sorts before every `Some`
/// (plans/STD_API_AUDIT.md D3.7).
impl(
  generic(T : Type),
  where(T <: Ord(T)),
  Option(T),
  Ord(Option(T))(
    (<) : (
      (lhs, rhs) ->
        match(
          lhs,
          .None => match(rhs, .None => false, .Some(_) => true),
          .Some(a) => match(
            rhs,
            .None => false,
            .Some(b) => (a < b)
          )
        )
    ),
    (<=) : (
      (lhs, rhs) ->
        match(
          lhs,
          .None => true,
          .Some(a) => match(
            rhs,
            .None => false,
            .Some(b) => (a <= b)
          )
        )
    ),
    (>) : (
      (lhs, rhs) ->
        match(
          lhs,
          .None => false,
          .Some(a) => match(
            rhs,
            .None => true,
            .Some(b) => (a > b)
          )
        )
    ),
    (>=) : (
      (lhs, rhs) ->
        match(
          lhs,
          .None => match(rhs, .None => true, .Some(_) => false),
          .Some(a) => match(
            rhs,
            .None => true,
            .Some(b) => (a >= b)
          )
        )
    )
  )
);
/// Hash for `Option(T)` — variant tag mixed with the inner hash, so
/// options can key maps (plans/STD_API_AUDIT.md D3.7).
impl(
  generic(T : Type),
  where(T <: Hash),
  Option(T),
  Hash(
    (hash) : (
      (self) ->
        match(
          self,
          .None => u64(0),
          .Some(v) => ((v.hash() * u64(31)) + u64(1))
        )
    )
  )
);
/// Clone for `Result(T, E)` — clones the inner value or error.
impl(
  generic(T : Type, E : Type),
  where(T <: Clone, E <: Clone),
  Result(T, E),
  Clone(
    clone : (
      (self) ->
        match(
          self,
          .Ok(v) => Result(T, E).Ok(v.clone()),
          .Err(e) => Result(T, E).Err(e.clone())
        )
    )
  )
);
/// Equality for `Result(T, E)` — variants must match and inner values must be equal.
impl(
  generic(T : Type, E : Type),
  where(T <: Eq(T), E <: Eq(E)),
  Result(T, E),
  Eq(Result(T, E))(
    (==) : (
      (lhs, rhs) ->
        match(
          lhs,
          .Ok(a) => match(
            rhs,
            .Ok(b) => (a == b),
            .Err(_) => false
          ),
          .Err(a) => match(
            rhs,
            .Ok(_) => false,
            .Err(b) => (a == b)
          )
        )
    )
  )
);
/// Ordering for `Result(T, E)` — every `Ok` sorts before every `Err`
/// (plans/STD_API_AUDIT.md D3.7).
impl(
  generic(T : Type, E : Type),
  where(T <: Ord(T), E <: Ord(E)),
  Result(T, E),
  Ord(Result(T, E))(
    (<) : (
      (lhs, rhs) ->
        match(
          lhs,
          .Ok(a) => match(
            rhs,
            .Ok(b) => (a < b),
            .Err(_) => true
          ),
          .Err(a) => match(
            rhs,
            .Ok(_) => false,
            .Err(b) => (a < b)
          )
        )
    ),
    (<=) : (
      (lhs, rhs) ->
        match(
          lhs,
          .Ok(a) => match(
            rhs,
            .Ok(b) => (a <= b),
            .Err(_) => true
          ),
          .Err(a) => match(
            rhs,
            .Ok(_) => false,
            .Err(b) => (a <= b)
          )
        )
    ),
    (>) : (
      (lhs, rhs) ->
        match(
          lhs,
          .Ok(a) => match(
            rhs,
            .Ok(b) => (a > b),
            .Err(_) => false
          ),
          .Err(a) => match(
            rhs,
            .Ok(_) => true,
            .Err(b) => (a > b)
          )
        )
    ),
    (>=) : (
      (lhs, rhs) ->
        match(
          lhs,
          .Ok(a) => match(
            rhs,
            .Ok(b) => (a >= b),
            .Err(_) => false
          ),
          .Err(a) => match(
            rhs,
            .Ok(_) => true,
            .Err(b) => (a >= b)
          )
        )
    )
  )
);
/// Hash for `Result(T, E)` — variant tag mixed with the inner hash
/// (plans/STD_API_AUDIT.md D3.7).
impl(
  generic(T : Type, E : Type),
  where(T <: Hash, E <: Hash),
  Result(T, E),
  Hash(
    (hash) : (
      (self) ->
        match(
          self,
          .Ok(v) => ((v.hash() * u64(31)) + u64(1)),
          .Err(e) => ((e.hash() * u64(31)) + u64(2))
        )
    )
  )
);
export(Result);
/// Box — a heap-allocated, reference-counted container for a single value.
///
/// Use `box(value)` to allocate. Access the inner value with `b.*`.
///
/// # Example
/// ```rust
/// b := box(i32(42));
/// assert((b.* == i32(42)), "inner value is 42");
/// ```
Box :: (fn(comptime(V) : Type) -> comptime(Type))(
  ref(
    struct(
      (*) : V
    )
  )
);
/// Allocate a value on the heap, returning a `Box(V)`.
box :: (fn(generic(V : Type), own(value) : V) -> Box(V))(Box(V)(value));
impl(
  generic(T : Type),
  Box(T),
  Isolation(
    can_isolate : ((self) -> (rc(self) == 1))
  )
);
impl(
  generic(T : Type),
  where(T <: Hash),
  Box(T),
  Hash(
    (hash) : ((self) -> self.*.hash())
  )
);
impl(
  generic(T : Type),
  where(T <: Eq(T)),
  Box(T),
  Eq(Box(T))(
    // SAFETY: Box always holds a non-null pointer to Rc-managed
    // storage; the deref is sound for as long as either operand
    // is alive, which covers the duration of this comparison.
    (==) : ((lhs, rhs) -> unsafe(lhs.* == rhs.*))
  )
);
impl(
  generic(T : Type),
  where(T <: Clone),
  Box(T),
  Clone(
    clone : ((self) -> box(self.*.clone()))
  )
);
export(
  Box,
  box
);
/// Iso — an isolated reference-counted value that can be sent across threads.
// SAFETY: Iso(T) is unconditionally Send (no `T <: Send` bound) because
// Iso's public API exposes no operation on the inner T except extract(),
// which atomically verifies rc == 1 before returning. If you add any new
// method to Iso(T) that touches the inner T (map, peek, read, &self
// borrow, etc.), this Send claim becomes unsound and must be revoked.
// See plans/THREAD_SAFETY.md "Iso(T) design notes — precedent and known
// risks" for the full argument.
impl(generic(T : Type), Iso(T), Send());
impl(generic(T : Type), where(T <: Acyclic), Iso(T), Acyclic());
impl(
  generic(T : Type),
  Iso(T),
  /// Extract the inner value if this `Iso` holds the only reference.
  /// Panics if rc != 1 or if this Iso has already been extracted.
  extract : (fn(self : Self) -> T)(
    __yo_iso_extract(self)
  )
);
(^) :: (fn(quote(v) : Expr) -> unquote(Expr))({
  temp :: cond(
    v.is_atom() => v,
    true => gensym("iso_extract_temp")
  );
  temp_type :: gensym("iso_extract_temp_type");
  assignment :: cond(
    v.is_atom() => quote(()),
    true => quote(unquote(temp) := unquote(v))
  );
  return(
    quote({
      unquote(assignment);
      unquote(temp_type) :: typeof(unquote(temp));
      cond(
        Type.contains_rc_type(unquote(temp_type)) => // compile-time check
        cond(
          Type.can_form_rc_cycle(unquote(temp_type)) => {
            // compile-time check
            consume(unquote(temp));
            comptime_assert(false, "Cannot isolate value of type containing Rc type that can form cycles");
            Option(Iso(unquote(temp_type))).None
          },
          !(Var.is_owning_the_rc_value(unquote(temp))) => {
            // compile-time check
            consume(unquote(temp));
            comptime_assert(false, "Cannot isolate value of type that is not owned");
            Option(Iso(unquote(temp_type))).None
          },
          (Var.has_other_aliases(unquote(temp))) => {
            // compile-time check
            consume(unquote(temp));
            comptime_assert(false, "Cannot isolate value of type that has other aliases");
            Option(Iso(unquote(temp_type))).None
          },
          (unquote(temp_type) <: Isolation).can_isolate(unquote(temp)) => // run-time check
          Option(Iso(unquote(temp_type))).Some(Iso(unquote(temp_type))(unquote(temp))),
          true => {
            // run-time check
            unsafe.drop(unquote(temp));
            Option(Iso(unquote(temp_type))).None
          }
        ),
        true => {
          // compile-time check
          comptime_assert(false, "Cannot isolate value type that does not contain Rc type");
          Option(Iso(unquote(temp_type))).Some(Iso(unquote(temp_type))(unquote(temp)))
        }
      )
    })
  );
});
export(^);
/// === Arc ===
/// Arc — an atomically reference-counted, thread-safe container for a single value.
///
/// Use `arc(value)` to allocate. Access the inner value with `a.*`.
///
/// # Example
/// ```rust
/// a := arc(i32(42));
/// assert((a.* == i32(42)), "inner value is 42");
/// ```
Arc :: (fn(comptime(V) : Type, where(V <: (Send, Acyclic))) -> comptime(Type))(
  atomic(
    ref(
      struct(
        (*) : V
      )
    )
  )
);
/// Allocate a value inside an Arc, returning an `Arc(V)`.
arc :: (fn(generic(V : Type), own(value) : V, where(V <: (Send, Acyclic))) -> Arc(V))(Arc(V)(value));
// SAFETY: Arc(T) is an atomic reference-counted wrapper. It is Send when
// the inner T is Send (all fields of the atomic-object must be Send per
// auto-derive) and Acyclic (prevents permanent leaks from Arc cycles).
impl(generic(T : Type), where(T <: (Send, Acyclic)), Arc(T), Send());
export(Arc, arc);
/// === MaybeUninit ===
extern(
  "Yo",
  __yo_maybe_uninit_new :
    (fn(comptime(_Self) : Type) -> _Self),
  __yo_maybe_uninit_as_ptr :
    (fn(comptime(_Self) : Type, comptime(BaseType) : Type, self : *(_Self)) -> *(BaseType)),
  __yo_maybe_uninit_assume_init :
    (fn(comptime(_Self) : Type, comptime(BaseType) : Type, self : _Self) -> BaseType)
);
/// MaybeUninit — a wrapper that allows holding an uninitialized value.
///
/// Useful for FFI or low-level patterns where a value must be
/// allocated first and initialized later (e.g., by a C function).
///
/// # Example
/// ```rust
/// extern "C",
///   time_t : Type,
///   time : fn(timer: ?(*(time_t))) -> time_t
/// ;
///
/// uninitialized_timer := MaybeUninit(time_t).new();
/// ptr := uninitialized_timer.as_ptr();
/// time(.Some(ptr));
/// timer := uninitialized_timer.assume_init();
/// ```
MaybeUninit :: (fn(comptime(BaseType) : Type) -> comptime(Type))(
  newtype(
    value : BaseType
  )
);
impl(
  generic(BaseType : Type),
  MaybeUninit(BaseType),
  /// Create a new uninitialized value.
  new : (fn() -> Self)(__yo_maybe_uninit_new(Self)),
  /// Get a mutable pointer to the underlying value.
  as_ptr : (fn(inout(self) : Self) -> *(BaseType))(
    __yo_maybe_uninit_as_ptr(Self, BaseType, &(self))
  ),
  /// Assume the value is initialized and extract it. **Undefined behavior if not initialized.**
  assume_init : (fn(own(self) : Self) -> BaseType)(
    __yo_maybe_uninit_assume_init(Self, BaseType, self)
  )
);
export(MaybeUninit);
/// Iterator trait — lazy, pull-based sequence traversal.
Iterator :: trait(
  /// The type of elements yielded by this iterator.
  Item : Type,
  /// Advance the iterator and return the next value, or `None` when exhausted.
  next :
    (
      fn(inout(self) : Self) -> Option(Self.Item)
    )
);
export(Iterator);
/// DoubleEndedIterator trait — an `Iterator` that can also be advanced from the
/// BACK. `next` and `next_back` consume from opposite ends of the same sequence
/// and meet in the middle; once they meet, both return `.None`.
///
/// Declares its own `Item`, which is how `next_back`'s signature can name it.
/// It deliberately carries NO where-clause tying it to `Iterator`: a trait
/// cannot constrain another trait's associated type to its OWN
/// (`where(Self <: Iterator(Item := Self.Item))` is rejected — the constraint
/// value must be a type, not an associated-type projection of `Self`).
///
/// COHERENCE RULE (not compiler-checked): an impl's `DoubleEndedIterator.Item`
/// MUST equal its `Iterator.Item`. The associated-type registry is keyed by
/// (type id, label) with no trait discrimination and takes the FIRST match, so a
/// mismatch is silently first-wins rather than diagnosed. Every impl in std
/// pairs the two traits on the same type with the same `Item`.
DoubleEndedIterator :: trait(
  /// The type of elements yielded — must equal `Self`'s `Iterator.Item`.
  Item : Type,
  /// Advance the iterator from the back and return the previous value, or
  /// `None` when the two ends have met.
  next_back :
    (
      fn(inout(self) : Self) -> Option(Self.Item)
    )
);
export(DoubleEndedIterator);
/// IntoIterator trait — convert a collection into an iterator.
IntoIterator :: trait(
  Item : Type,
  IntoIter : Type,
  into_iter :
    (fn(self : Self) -> Self.IntoIter),
  where(Self.IntoIter <: Iterator(Item := Self.Item))
);
export(IntoIterator);
/// FromIterator trait — build `Self` from a sequence of `Self.Elem` values.
///
/// The iteration loop lives in the blanket `collect` below, not here, so this
/// trait stays MONOMORPHIC: a seed constructor plus one element-at-a-time step,
/// both statics, dispatched the way `sum` calls `(A <: Default).default()`.
/// That is what removes the need for a trait method carrying its own
/// `generic(...)` + `where`.
///
/// The element type is deliberately named `Elem`, NOT `Item`: the assoc-type
/// registry is keyed by (type id, label) with no trait discrimination, so an
/// `Item` here would collide with the collection's own `IntoIterator.Item` and
/// resolve first-wins by load order — benign for `ArrayList`, but genuinely
/// divergent for `HashMap`, whose `IntoIterator.Item` is `MapEntry(K, V)`.
///
/// `from_iter_add` RETURNS the accumulator instead of mutating it so that one
/// signature covers reference collections (mutate `acc`, return it — the return
/// is a rebind of the same object) and value types such as `String`.
FromIterator :: trait(
  /// The element type this collection is built from.
  Elem : Type,
  /// The empty collection `collect` starts from.
  from_iter_new : (fn() -> Self),
  /// Add one element to a partially-built collection and return it.
  from_iter_add : (fn(acc : Self, item : Self.Elem) -> Self)
);
export(FromIterator);
/// === Array Iterator ===
/// Value iterator for Array(T, N) — yields elements by value. Backs
/// the for-macro value form `for(arr, (x) => body)` via `into_iter`.
_ArrayIter :: (fn(comptime(T) : Type, comptime(N) : usize) -> comptime(Type))(
  struct(
    _arr : Array(T, N),
    _index : usize,
    /// How many elements `next_back` has already taken off the END. A COUNTER
    /// rather than a back cursor, so it initialises from a plain `usize(0)`
    /// literal and nothing has to coerce the comptime value-generic `N` into a
    /// runtime field. While it is 0 the forward guard is unchanged.
    _back_taken : usize
  )
);
impl(
  generic(T : Type, N : usize),
  _ArrayIter(T, N),
  Iterator(
    Item : T,
    next : (fn(inout(self) : Self) -> Option(T))(
      cond(
        ((self._index + self._back_taken) >= N) => .None,
        true => {
          out := self._arr(self._index);
          self._index = (self._index + usize(1));
          .Some(out)
        }
      )
    )
  )
);
impl(
  generic(T : Type, N : usize),
  _ArrayIter(T, N),
  DoubleEndedIterator(
    Item : T,
    next_back : (fn(inout(self) : Self) -> Option(T))(
      cond(
        ((self._index + self._back_taken) >= N) => .None,
        true => {
          self._back_taken = (self._back_taken + usize(1));
          .Some(self._arr(N - self._back_taken))
        }
      )
    )
  )
);
impl(
  generic(T : Type, N : usize),
  Array(T, N),
  IntoIterator(
    Item : T,
    IntoIter : _ArrayIter(T, N),
    into_iter : (fn(self : Self) -> _ArrayIter(T, N))(
      _ArrayIter(T, N)(_arr : self, _index : usize(0), _back_taken : usize(0))
    )
  )
);
/// TryFrom trait — fallible conversion from one type to another.
/// From trait — infallible conversion FROM another type
/// (plans/STD_API_AUDIT.md D3.2; the fallible pair is `TryFrom` below).
From :: (fn(comptime(Source) : Type) -> comptime(Trait))(
  trait(
    /// Convert `value` into `Self`.
    from :
      (fn(value : Source) -> Self)
  )
);
export(From);
/// Into trait — infallible conversion of `Self` INTO another type.
/// Called with the target type, mirroring `try_into`:
/// `wide := narrow.into(i64);`
Into :: (fn(comptime(To) : Type) -> comptime(Trait))(
  trait(
    /// Convert `self` into the target type.
    into :
      (fn(self : Self, (comptime(_To) : Type) = To) -> To)
  )
);
export(Into);
// Lossless integer widenings — the canonical seed impls for From/Into.
// (Narrowing stays with TryFrom, where failure is representable.)
impl(i16, From(i8)(from : (value -> i16(value))));
impl(i32, From(i8)(from : (value -> i32(value))));
impl(i32, From(i16)(from : (value -> i32(value))));
impl(i64, From(i8)(from : (value -> i64(value))));
impl(i64, From(i16)(from : (value -> i64(value))));
impl(i64, From(i32)(from : (value -> i64(value))));
impl(u16, From(u8)(from : (value -> u16(value))));
impl(u32, From(u8)(from : (value -> u32(value))));
impl(u32, From(u16)(from : (value -> u32(value))));
impl(u64, From(u8)(from : (value -> u64(value))));
impl(u64, From(u16)(from : (value -> u64(value))));
impl(u64, From(u32)(from : (value -> u64(value))));
impl(f64, From(f32)(from : (value -> f64(value))));
impl(i8, Into(i16)(into : ((self, _) -> i16(self))));
impl(i8, Into(i32)(into : ((self, _) -> i32(self))));
impl(i8, Into(i64)(into : ((self, _) -> i64(self))));
impl(i16, Into(i32)(into : ((self, _) -> i32(self))));
impl(i16, Into(i64)(into : ((self, _) -> i64(self))));
impl(i32, Into(i64)(into : ((self, _) -> i64(self))));
impl(u8, Into(u16)(into : ((self, _) -> u16(self))));
impl(u8, Into(u32)(into : ((self, _) -> u32(self))));
impl(u8, Into(u64)(into : ((self, _) -> u64(self))));
impl(u16, Into(u32)(into : ((self, _) -> u32(self))));
impl(u16, Into(u64)(into : ((self, _) -> u64(self))));
impl(u32, Into(u64)(into : ((self, _) -> u64(self))));
impl(f32, Into(f64)(into : ((self, _) -> f64(self))));
TryFrom :: (fn(comptime(Source) : Type) -> comptime(Trait))(
  trait(
    /// Error type returned on conversion failure.
    Error : Type,
    /// Attempt to convert `value` into `Self`.
    try_from :
      (fn(value : Source) -> Result(Self, Self.Error))
  )
);
export(TryFrom);
/// TryInto trait — fallible conversion of `Self` into another type.
TryInto :: (fn(comptime(To) : Type) -> comptime(Trait))(
  trait(
    /// Error type returned on conversion failure.
    Error : Type,
    /// Attempt to convert `self` into the target type.
    try_into :
      (fn(self : Self, (comptime(_To) : Type) = To) -> Result(To, Self.Error))
  )
);
export(TryInto);
/// `if` macro — expands to `cond(condition => then, true => else)`.
///
/// # Example
/// ```rust
/// if(x > 0, println("positive"), println("non-positive"));
/// ```
///
/// NOTE (plans/MACRO_POLICY.md Part 3.2): current compilers desugar
/// `if(...)` calls to `cond(...)` at parse time (`desugar_if_calls` in
/// src/expr.yo), so this macro is normally never dispatched. It is KEPT
/// for (a) seed-generation bootstrap compatibility — the seed binary has
/// no desugar pass and needs this definition to compile the tree — and
/// (b) as the fallback for `if` calls the desugar leaves alone (odd
/// arity, mismatched labels, dynamically built ASTs). Do not delete until
/// the seed release ships the desugar pass.
if :: (
  fn(
    quote(condition) : Expr,
    quote(then) : Expr,
    (quote(else) : Expr) ?= quote(())
  ) -> unquote(Expr)
)(
  quote(
    cond(
      unquote(condition) => unquote(then),
      true => unquote(else)
    )
  )
);
export(if);
// The `try` macro (unwrap a `Result`, returning early on `Err`) was
// REMOVED 2026-08-21 (plans/MACRO_POLICY.md Part 3.1): it had zero call
// sites outside its own test file, it was the only std macro that
// injected a hidden caller-frame `return`, and its name invited confusion
// with the algebraic-effects system. Match on the `Result` instead, or
// define an equivalent macro locally under `pragma(Pragma.AllowMacroDef);`
// (tests/macro_def_pragma.test.yo keeps a working three-line version).
/// `for` macro — iterate over a collection.
///
///   `for(coll, (x) => body)` — calls `coll.into_iter()` and binds `x`
///     to each yielded value. The collection is moved into the
///     iterator; object elements are handles, so mutating `x` in the
///     body mutates the element in place.
///
/// The old borrow form `for(coll, inout(x) => body)` was REMOVED: it
/// required `ref`s into reallocatable storage, which is no longer
/// expressible. Object elements mutate in place through the value
/// handle; struct elements use an index loop with `get`/`set`.
///
/// Combinator chains (`coll.into_iter().map(f)`, etc.) work
/// transparently: a blanket `into_iter` impl on `Iterator` (below)
/// makes every iterator its own `IntoIterator`.
///
/// # Examples
/// ```rust
/// // Object elements — mutate in place through the handle.
/// for(names, (s) => {
///   s.push_str("!");
/// });
///
/// // Consume an iterator chain.
/// for(list.into_iter(), (x) => print(x));
/// ```
for :: (
  fn(
    quote(coll) : Expr,
    quote(handle) : Expr
  ) -> unquote(Expr)
)({
  // Check if `handle` is a function call of `=>`
  return(
    cond(
      (handle.is_fn_call()) => {
        callee :: handle.get_callee();
        cond(
          (callee.is_atom() && (callee == quote(=>))) => {
            args :: handle.get_args();
            comptime_assert(args.len() == 2, "'for' macro requires 2 arguments in the function handle");
            variable :: args.car();
            body :: args.cdr().car();
            // Detect `inout(name) => body` — borrow form. Otherwise
            // it's the value form `(name) => body`.
            is_ref_form :: cond(
              variable.is_fn_call() => {
                v_callee :: variable.get_callee();
                v_callee.is_atom() && (v_callee == quote(inout))
              },
              true => false
            );
            cond(
              is_ref_form => {
                // The borrow form is gone: it handed out refs into
                // reallocatable storage. Teach the migration instead
                // of failing with a resolution error.
                comptime_assert(
                  false,
                  "'for(coll, inout(x) => ...)' was removed - use the value form 'for(coll, (x) => ...)'. Object elements are handles and mutate in place; for struct elements use an index loop with get/set."
                );
                quote(())
              },
              true => {
                iter_var :: gensym("for_iter_var");
                temp_var :: gensym("for_temp_var");
                quote({
                  unquote(iter_var) := unquote(coll).into_iter();
                  while(runtime(true), {
                    unquote(temp_var) := unquote(iter_var).next();
                    match(
                      unquote(temp_var),
                      .Some(unquote(variable)) => unquote(body),
                      .None => {
                        break;
                      }
                    )
                  });
                })
              }
            )
          },
          true => {
            comptime_assert(false, "for macro requires a function handle with `=>`");
            quote(false)
          }
        )
      },
      true => {
        comptime_assert(false, "for macro requires a function handle with `=>`");
        quote(false)
      }
    )
  );
});
export(for);
// =============================================================================
// Iterator Combinators
// =============================================================================
/// `IterPair` — a two-element product type used by `enumerate` and `zip`.
IterPair :: (fn(comptime(A) : Type, comptime(B) : Type) -> comptime(Type))(
  struct(_0 : A, _1 : B)
);
export(IterPair);
/// Zip two options into an option of a pair (plans/STD_API_AUDIT.md D3.7;
/// defined here because it needs `IterPair`).
impl(
  generic(T : Type),
  Option(T),
  /// `Some(a).zip(Some(b))` is `Some(IterPair(a, b))`; anything else is `None`.
  zip : (fn(generic(B : Type), self : Self, other : Option(B)) -> Option(IterPair(T, B)))(
    match(
      self,
      .Some(a) => match(
        other,
        .Some(b) => Option(IterPair(T, B)).Some(IterPair(T, B)(_0 : a, _1 : b)),
        .None => Option(IterPair(T, B)).None
      ),
      .None => Option(IterPair(T, B)).None
    )
  )
);
// ---------------------------------------------------------------------------
// IterMap
// ---------------------------------------------------------------------------
/// Lazy iterator that maps each element through a function `F`.
///
/// Created by calling `.map(f)` on any iterator.
/// `I` is the source iterator type, `B` is the output element type,
/// `F` is the mapper closure type satisfying `Fn(item : A) -> B`.
IterMap :: (fn(comptime(I) : Type, comptime(B) : Type, comptime(F) : Type) -> comptime(Type))(
  struct(_inner : I, _f : F)
);
impl(
  generic(I : Type, A : Type, B : Type, F : Type),
  where(I <: Iterator(Item := A), F <: (Fn(item : A) -> B)),
  IterMap(I, B, F),
  Iterator(
    Item : B,
    next : (fn(inout(self) : Self) -> Option(B))(
      match(
        self._inner.next(),
        .None => .None,
        .Some(item) => .Some((self._f)(item))
      )
    )
  )
);
export(IterMap);
// ---------------------------------------------------------------------------
// IterFilter
// ---------------------------------------------------------------------------
/// Lazy iterator that skips elements for which the predicate returns `false`.
///
/// Created by calling `.filter(pred)` on any iterator.
/// `I` is the source iterator type, `F` is the predicate closure type
/// satisfying `Fn(item : A) -> bool` — by value, symmetric with `map`
/// (plans/STD_API_AUDIT.md D3.4's callback-asymmetry fix).
IterFilter :: (fn(comptime(I) : Type, comptime(F) : Type) -> comptime(Type))(
  struct(_inner : I, _f : F)
);
impl(
  generic(I : Type, A : Type, F : Type),
  where(I <: Iterator(Item := A), F <: (Fn(item : A) -> bool)),
  IterFilter(I, F),
  Iterator(
    Item : A,
    next : (fn(inout(self) : Self) -> Option(A))({
      (loop_result : Option(A)) = .None;
      while(runtime(true), {
        candidate := self._inner.next();
        match(
          candidate,
          .None => {
            break;
          },
          .Some(item) => {
            cond(
              (self._f)(item) => {
                loop_result = .Some(item);
                break;
              },
              true => ()
            );
          }
        );
      });
      loop_result
    })
  )
);
export(IterFilter);
// ---------------------------------------------------------------------------
// IterTake
// ---------------------------------------------------------------------------
/// Lazy iterator that yields at most `n` elements from the source.
///
/// Created by calling `.take(n)` on any iterator.
IterTake :: (fn(comptime(I) : Type) -> comptime(Type))(
  struct(_inner : I, _remaining : usize)
);
impl(
  generic(I : Type, A : Type),
  where(I <: Iterator(Item := A)),
  IterTake(I),
  Iterator(
    Item : A,
    next : (fn(inout(self) : Self) -> Option(A))(
      cond(
        (self._remaining == usize(0)) => .None,
        true => {
          self._remaining = (self._remaining - usize(1));
          self._inner.next()
        }
      )
    )
  )
);
export(IterTake);
// ---------------------------------------------------------------------------
// IterSkip
// ---------------------------------------------------------------------------
/// Lazy iterator that skips the first `n` elements of the source, then yields
/// all remaining elements.
///
/// Created by calling `.skip(n)` on any iterator.
IterSkip :: (fn(comptime(I) : Type) -> comptime(Type))(
  struct(_inner : I, _to_skip : usize)
);
impl(
  generic(I : Type, A : Type),
  where(I <: Iterator(Item := A)),
  IterSkip(I),
  Iterator(
    Item : A,
    next : (fn(inout(self) : Self) -> Option(A))({
      while(self._to_skip > usize(0), {
        result := self._inner.next();
        match(
          result,
          .None => {
            self._to_skip = usize(0);
            return(.None);
          },
          .Some(_) => {
            self._to_skip = (self._to_skip - usize(1));
          }
        );
      });
      self._inner.next()
    })
  )
);
export(IterSkip);
// ---------------------------------------------------------------------------
// IterEnumerate
// ---------------------------------------------------------------------------
/// Lazy iterator that pairs each element with its zero-based index.
///
/// Created by calling `.enumerate()` on any iterator.
/// Yields `IterPair(usize, A)` values where `_0` is the index and `_1` is
/// the original element.
IterEnumerate :: (fn(comptime(I) : Type) -> comptime(Type))(
  struct(_inner : I, _index : usize)
);
impl(
  generic(I : Type, A : Type),
  where(I <: Iterator(Item := A)),
  IterEnumerate(I),
  Iterator(
    Item : IterPair(usize, A),
    next : (fn(inout(self) : Self) -> Option(IterPair(usize, A)))(
      match(
        self._inner.next(),
        .None => .None,
        .Some(item) => {
          idx := self._index;
          self._index = (self._index + usize(1));
          .Some(IterPair(usize, A)(_0 : idx, _1 : item))
        }
      )
    )
  )
);
export(IterEnumerate);
// ---------------------------------------------------------------------------
// IterZip
// ---------------------------------------------------------------------------
/// Lazy iterator that combines two iterators element-by-element into pairs.
/// Stops as soon as either iterator is exhausted.
///
/// Created by calling `.zip(other)` on any iterator.
/// Yields `IterPair(A, B)` values.
IterZip :: (fn(comptime(I) : Type, comptime(J) : Type) -> comptime(Type))(
  struct(_left : I, _right : J)
);
impl(
  generic(I : Type, J : Type, A : Type, B : Type),
  where(I <: Iterator(Item := A), J <: Iterator(Item := B)),
  IterZip(I, J),
  Iterator(
    Item : IterPair(A, B),
    next : (fn(inout(self) : Self) -> Option(IterPair(A, B)))(
      match(
        self._left.next(),
        .None => .None,
        .Some(a) => match(
          self._right.next(),
          .None => .None,
          .Some(b) => .Some(IterPair(A, B)(_0 : a, _1 : b))
        )
      )
    )
  )
);
export(IterZip);
// ---------------------------------------------------------------------------
// IterChain
// ---------------------------------------------------------------------------
/// Lazy iterator that yields all of the first iterator, then all of the second.
///
/// Created by calling `.chain(other)` on any iterator. Both iterators must
/// yield the same `Item` type.
IterChain :: (fn(comptime(I) : Type, comptime(J) : Type) -> comptime(Type))(
  struct(_first : I, _second : J, _first_done : bool)
);
impl(
  generic(I : Type, J : Type, A : Type),
  where(I <: Iterator(Item := A), J <: Iterator(Item := A)),
  IterChain(I, J),
  Iterator(
    Item : A,
    next : (fn(inout(self) : Self) -> Option(A))({
      (result : Option(A)) = .None;
      cond(
        !(self._first_done) => {
          match(
            self._first.next(),
            .Some(item) => {
              result = .Some(item);
            },
            .None => {
              self._first_done = true;
            }
          );
        },
        true => ()
      );
      cond(
        (self._first_done && result.is_none()) => {
          result = self._second.next();
        },
        true => ()
      );
      result
    })
  )
);
export(IterChain);
// ---------------------------------------------------------------------------
// IterTakeWhile
// ---------------------------------------------------------------------------
/// Lazy iterator that yields elements while `pred` holds, then stops forever.
///
/// Created by calling `.take_while(pred)` on any iterator.
IterTakeWhile :: (fn(comptime(I) : Type, comptime(F) : Type) -> comptime(Type))(
  struct(_inner : I, _f : F, _done : bool)
);
impl(
  generic(I : Type, A : Type, F : Type),
  where(I <: Iterator(Item := A), F <: (Fn(item : A) -> bool)),
  IterTakeWhile(I, F),
  Iterator(
    Item : A,
    next : (fn(inout(self) : Self) -> Option(A))({
      (result : Option(A)) = .None;
      cond(
        self._done => (),
        true => {
          match(
            self._inner.next(),
            .None => {
              self._done = true;
            },
            .Some(item) => {
              cond(
                (self._f)(item) => {
                  result = .Some(item);
                },
                true => {
                  self._done = true;
                }
              );
            }
          );
        }
      );
      result
    })
  )
);
export(IterTakeWhile);
// ---------------------------------------------------------------------------
// IterSkipWhile
// ---------------------------------------------------------------------------
/// Lazy iterator that skips elements while `pred` holds, then yields the rest.
///
/// Created by calling `.skip_while(pred)` on any iterator.
IterSkipWhile :: (fn(comptime(I) : Type, comptime(F) : Type) -> comptime(Type))(
  struct(_inner : I, _f : F, _skipping : bool)
);
impl(
  generic(I : Type, A : Type, F : Type),
  where(I <: Iterator(Item := A), F <: (Fn(item : A) -> bool)),
  IterSkipWhile(I, F),
  Iterator(
    Item : A,
    next : (fn(inout(self) : Self) -> Option(A))({
      (result : Option(A)) = .None;
      while(runtime(true), {
        match(
          self._inner.next(),
          .None => {
            break;
          },
          .Some(item) => {
            cond(
              (self._skipping && (self._f)(item)) => (),
              true => {
                self._skipping = false;
                result = .Some(item);
                break;
              }
            );
          }
        );
      });
      result
    })
  )
);
export(IterSkipWhile);
// ---------------------------------------------------------------------------
// IterFilterMap
// ---------------------------------------------------------------------------
/// Lazy iterator that maps each element to an `Option` and yields the `Some`s.
///
/// Created by calling `.filter_map(f)` on any iterator. `B` is the output
/// element type, `F` satisfies `Fn(item : A) -> Option(B)`.
IterFilterMap :: (fn(comptime(I) : Type, comptime(B) : Type, comptime(F) : Type) -> comptime(Type))(
  struct(_inner : I, _f : F)
);
impl(
  generic(I : Type, A : Type, B : Type, F : Type),
  where(I <: Iterator(Item := A), F <: (Fn(item : A) -> Option(B))),
  IterFilterMap(I, B, F),
  Iterator(
    Item : B,
    next : (fn(inout(self) : Self) -> Option(B))({
      (result : Option(B)) = .None;
      while(runtime(true), {
        match(
          self._inner.next(),
          .None => {
            break;
          },
          .Some(item) => {
            match(
              (self._f)(item),
              .Some(mapped) => {
                result = .Some(mapped);
                break;
              },
              .None => ()
            );
          }
        );
      });
      result
    })
  )
);
export(IterFilterMap);
// ---------------------------------------------------------------------------
// IterPeekable
// ---------------------------------------------------------------------------
/// Iterator wrapper that can look at the next element without consuming it.
///
/// Created by calling `.peekable()` on any iterator. `A` is the element type.
IterPeekable :: (fn(comptime(I) : Type, comptime(A) : Type) -> comptime(Type))(
  struct(_inner : I, _peeked : Option(A))
);
impl(
  generic(I : Type, A : Type),
  where(I <: Iterator(Item := A)),
  IterPeekable(I, A),
  /// Return the next element without consuming it. Repeated calls return
  /// the same element until `next()` is called.
  peek : (fn(inout(self) : Self) -> Option(A))({
    cond(
      self._peeked.is_none() => {
        self._peeked = self._inner.next();
      },
      true => ()
    );
    self._peeked
  })
);
impl(
  generic(I : Type, A : Type),
  where(I <: Iterator(Item := A)),
  IterPeekable(I, A),
  Iterator(
    Item : A,
    next : (fn(inout(self) : Self) -> Option(A))(
      match(
        self._peeked.take(),
        .Some(item) => .Some(item),
        .None => self._inner.next()
      )
    )
  )
);
export(IterPeekable);
/// Lazy iterator that yields the source's elements back-to-front.
///
/// Created by calling `.rev()` on any `DoubleEndedIterator`. `next` pulls from
/// the source's BACK and `next_back` from its FRONT, so `.rev().rev()` restores
/// the original order.
IterRev :: (fn(comptime(I) : Type) -> comptime(Type))(
  struct(
    _inner : I
  )
);
impl(
  generic(I : Type, A : Type),
  where(I <: DoubleEndedIterator(Item := A)),
  IterRev(I),
  Iterator(
    Item : A,
    next : (fn(inout(self) : Self) -> Option(A))(
      self._inner.next_back()
    )
  )
);
/// `IterRev` is itself double-ended — `next_back` is the source's `next`. This
/// is what makes `.rev().rev()` the identity.
impl(
  generic(I : Type, A : Type),
  where(I <: Iterator(Item := A)),
  IterRev(I),
  DoubleEndedIterator(
    Item : A,
    next_back : (fn(inout(self) : Self) -> Option(A))(
      self._inner.next()
    )
  )
);
export(IterRev);
// ---------------------------------------------------------------------------
// Range iteration (plans/STD_API_AUDIT.md D3.5): `for(0..10, (i) => ...)`
// and every iterator combinator work on integer ranges. Per-type impls —
// a generic impl would need a `Step` notion (a generic "one") the prelude
// does not have; chunk-1 `From` covers only lossless widening, which
// excludes e.g. u8 -> i8.
// ---------------------------------------------------------------------------
/// Half-open `i8` range iteration: yields `start`, `start+1`, …, `end - 1`.
impl(
  Range(i8),
  Iterator(
    Item : i8,
    next : (fn(inout(self) : Self) -> Option(i8))(
      cond(
        (self.start >= self.end) => .None,
        true => {
          v := self.start;
          self.start = (self.start + i8(1));
          .Some(v)
        }
      )
    )
  )
);
/// Inclusive `i8` range iteration: yields `start` … `end`. After yielding
/// `end` the range flips to the canonical EMPTY form (start 1, end 0) instead
/// of incrementing past `end` — `start..=i8.MAX` therefore terminates
/// instead of wrapping.
impl(
  RangeInclusive(i8),
  Iterator(
    Item : i8,
    next : (fn(inout(self) : Self) -> Option(i8))(
      cond(
        (self.start > self.end) => .None,
        true => {
          v := self.start;
          cond(
            (v == self.end) => {
              self.start = i8(1);
              self.end = i8(0);
            },
            true => {
              self.start = (self.start + i8(1));
            }
          );
          .Some(v)
        }
      )
    )
  )
);
