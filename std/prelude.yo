/// ComptimeList
impl(forall(T : Type), ComptimeList(T), {
  car :: (fn(comptime(self): Self) -> comptime(__yo_comptime_list_element_type(Self)))(
    __yo_comptime_list_car(self)
  );
  cdr :: (fn(comptime(self): Self) -> comptime(Self))(
    __yo_comptime_list_cdr(self)
  );
  first :: car;
  rest :: cdr;
  append :: (fn(comptime(self): Self, comptime(another): Self) -> comptime(Self))(
    __yo_comptime_list_append(self, another)
  );
  len :: (fn(comptime(self): Self) -> comptime(usize))(
    __yo_comptime_list_length(self)
  );
  export car, cdr, first, rest, append, len;
});

/// ExprList
ExprList :: ComptimeList(Expr);
export ExprList;

/// Expr
impl(Expr, ComptEq(Expr)(
  (==) : (fn(comptime(lhs): Expr, comptime(rhs): Expr) -> comptime(bool))(
    __yo_expr_eq(lhs, rhs)
  )
));
impl(Expr, {
  is_atom :: (fn(comptime(self): Expr) -> comptime(bool))(
    __yo_expr_is_atom(self)
  );
