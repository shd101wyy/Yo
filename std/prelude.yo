  f32,
  Eq(f32)(
    (==) : ((lhs, rhs) -> __yo_op_eq(lhs, rhs)),
    (!=) : ((lhs, rhs) -> __yo_op_neq(lhs, rhs))
  )
);
impl(
  f32,
  Ord(f32)(
    (<) : ((lhs, rhs) -> __yo_op_lt(lhs, rhs)),
    (<=) : ((lhs, rhs) -> __yo_op_lte(lhs, rhs)),
    (>) : ((lhs, rhs) -> __yo_op_gt(lhs, rhs)),
    (>=) : ((lhs, rhs) -> __yo_op_gte(lhs, rhs)),
    // TOTAL-order override (plans/STD_API_AUDIT.md D3.3, no-PartialOrd
    // decision): the OPERATORS stay IEEE (NaN incomparable), but `cmp`
    // must be total so float sorts are deterministic. NaNs compare equal
    // to each other and greater than every number (incl. +inf); -0 and
    // +0 compare Equal (deliberately simpler than IEEE totalOrder, and
    // consistent with `==`).
    cmp : (
      (lhs, rhs) -> {
        l_nan := not(lhs == lhs);
        r_nan := not(rhs == rhs);
        cond(
          (l_nan && r_nan) => Ordering.Equal,
          l_nan => Ordering.Greater,
          r_nan => Ordering.Less,
          (lhs < rhs) => Ordering.Less,
          (lhs == rhs) => Ordering.Equal,
          true => Ordering.Greater
        )
      }
    )
  )
);
// f32's `Hash` impl was DELETED (std S1, no-PartialOrd decision): it was
// `u64(i32(self))` — a TRUNCATING int cast, so 0.5 and 0.9 already hashed
// alike — and float map keys break the Eq/Hash contract on NaN anyway.
// `HashMap(f32, …)` is now a compile error; key by the bits or a rounded
// integer explicitly instead.
impl(
  f32,
  Clone(
    clone : ((self) -> __yo_return_self(self))
  )
);
