    Item : u16,
    next_back : (fn(inout(self) : Self) -> Option(u16))(
      cond(
        (self.start > self.end) => .None,
        true => {
          v := self.end;
          cond(
            (v == self.start) => {
              self.start = u16(1);
              self.end = u16(0);
            },
            true => {
              self.end = (self.end - u16(1));
            }
          );
          .Some(v)
        }
      )
    )
  )
);
/// Half-open `u32` range back-iteration: yields `end - 1`, …, `start`. No
/// underflow on unsigned types: the guard means `end > start >= u32.MIN`, so
/// `end - 1` is always representable.
impl(
  Range(u32),
  DoubleEndedIterator(
    Item : u32,
    next_back : (fn(inout(self) : Self) -> Option(u32))(
      cond(
        (self.start >= self.end) => .None,
        true => {
          self.end = (self.end - u32(1));
          .Some(self.end)
        }
      )
    )
  )
);
/// Inclusive `u32` range back-iteration: yields `end`, …, `start`. The exact
/// mirror of the forward impl — the canonical-EMPTY sentinel (start 1, end 0)
/// is end-agnostic, so flipping on the LAST element works from either side,
/// `u32.MIN ..= x` terminates from the back without underflowing `end`, and
/// mixing `next` with `next_back` on one range stays correct because both test
/// `start > end` and both flip when the ends coincide.
impl(
  RangeInclusive(u32),
  DoubleEndedIterator(
    Item : u32,
    next_back : (fn(inout(self) : Self) -> Option(u32))(
      cond(
        (self.start > self.end) => .None,
        true => {
          v := self.end;
          cond(
            (v == self.start) => {
              self.start = u32(1);
              self.end = u32(0);
            },
            true => {
              self.end = (self.end - u32(1));
            }
          );
          .Some(v)
        }
      )
    )
  )
);
