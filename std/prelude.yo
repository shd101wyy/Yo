/// Eq trait — enables `==` and `!=` comparison operators.
/// The `!=` method has a default implementation that negates `==`.
Eq ::
  (fn(comptime(Rhs) : Type) -> comptime(Trait))(
    trait(
      (==) : (fn(lhs : Self, rhs : Rhs) -> bool),
      ((!=) : (fn(lhs : Self, rhs : Rhs) -> bool)) ?=
        (
          (lhs, rhs) ->
            not(Self.(==)(lhs, rhs))
        )
    )
  );
export(Eq);
ComptimeEq ::
  (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
    trait(
      (==) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(bool)),
      ((!=) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(bool))) ?=
        (
          (lhs, rhs) ->
            not(Self.(==)(lhs, rhs))
        ),
      where(Self <: Comptime)
    )
  );
export(ComptimeEq);
/// Ordering — result of a comparison.
Ordering :: enum(
  /// Left-hand side is less than right-hand side.
  Less,
  /// Both sides are equal.
  Equal,
  /// Left-hand side is greater than right-hand side.
  Greater
);
export(Ordering);
/// Ord trait — enables `<`, `<=`, `>`, `>=` comparison operators.
/// Requires the type to also implement `Eq`.
///
/// `cmp` is contractually a TOTAL order for every std impl (the audit's
/// no-PartialOrd decision, plans/STD_API_AUDIT.md D3.3): the default is
/// derived from `<`/`==`, and types whose operators are only partial
/// (floats: NaN is incomparable under IEEE `<`) OVERRIDE `cmp` with a
/// total order instead of splitting the trait.
Ord :: (
  fn(
    comptime(Rhs) : Type
  ) -> comptime(Trait)
)(
  trait(
    (<) :
      (fn(lhs : Self, rhs : Rhs) -> bool),
    (<=) :
      (fn(lhs : Self, rhs : Rhs) -> bool),
    (>) :
      (fn(lhs : Self, rhs : Rhs) -> bool),
    (>=) :
      (fn(lhs : Self, rhs : Rhs) -> bool),
    (cmp : (fn(lhs : Self, rhs : Rhs) -> Ordering)) ?=
      (
        (lhs, rhs) ->
          cond(
            Self.(<)(lhs, rhs) => Ordering.Less,
            Self.(==)(lhs, rhs) => Ordering.Equal,
            true => Ordering.Greater
          )
      ),
    where(Self <: Eq(Rhs))
  )
);
export(Ord);
ComptimeOrd :: (
  fn(
    comptime(Rhs) : Type,
    where(Rhs <: Comptime)
  ) -> comptime(Trait)
)(
  trait(
    (<) :
      (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(bool)),
    (<=) :
      (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(bool)),
    (>) :
      (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(bool)),
    (>=) :
      (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(bool)),
    where(Self <: (Comptime, ComptimeEq(Rhs)))
  )
);
export(ComptimeOrd);
/**
* Hash trait - Similar to Rust's std::hash::Hash
*
* This trait defines the ability to hash a value into a u64.
* Types that implement Hash can be used as keys in HashMap and HashSet.
*
* The hash function should satisfy:
* 1. Deterministic: The same value always produces the same hash
* 2. Consistent with Eq: If a == b, then hash(a) == hash(b)
*
* Note: Unlike Rust which uses a Hasher trait for incremental hashing,
* we use a simpler approach where each type directly produces a u64 hash.
*/
Hash :: trait(
  /**
  * Compute the hash of a value
  * Returns a u64 hash value
  */
  (hash) : (fn(inout(self) : Self) -> u64)
);
export(Hash);
/// Clone trait — deep-copy a value.
Clone :: trait(
  /// Create an independent clone of `self`.
  clone :
    (
      fn(inout(self) : Self) -> Self
    )
);
export(Clone);
/// Default trait — the type's default value (Rust's `Default`).
/// Call explicitly via `(T <: Default).default()` in generic code, or
/// `MyType.default()` on a concrete type. Unblocks
/// `Option.unwrap_or_default` and map `or_default`-style helpers
/// (plans/STD_API_AUDIT.md D3.1).
Default :: trait(
  /// The default value of the type.
  default : (fn() -> Self)
);
export(Default);
impl(bool, Default(default : (fn() -> Self)(false)));
impl(i8, Default(default : (fn() -> Self)(i8(0))));
impl(i16, Default(default : (fn() -> Self)(i16(0))));
impl(i32, Default(default : (fn() -> Self)(i32(0))));
impl(i64, Default(default : (fn() -> Self)(i64(0))));
impl(u8, Default(default : (fn() -> Self)(u8(0))));
impl(u16, Default(default : (fn() -> Self)(u16(0))));
impl(u32, Default(default : (fn() -> Self)(u32(0))));
impl(u64, Default(default : (fn() -> Self)(u64(0))));
impl(isize, Default(default : (fn() -> Self)(isize(0))));
impl(usize, Default(default : (fn() -> Self)(usize(0))));
impl(f32, Default(default : (fn() -> Self)(f32(0.0))));
impl(f64, Default(default : (fn() -> Self)(f64(0.0))));
/// Isolation trait — runtime check whether a value can be safely transferred.
Isolation :: trait(
  can_isolate : (fn(self : Self) -> bool)
);
export(Isolation);
/// ComptimeToString trait — compile-time string conversion.
ComptimeToString :: trait(
  to_comptime_string : (fn(comptime(self) : Self) -> comptime(comptime_str)),
  where(Self <: Comptime)
);
export(ComptimeToString);
// SAFETY: All builtin primitive types (unit, void, comptime_int,
// comptime_float, comptime_str, bool, i8/i16/i32/i64, u8/u16/u32/u64,
// f32/f64, isize/usize, char/int/uint/short/ushort/long/ulong/longlong/
// ulonglong/longdouble) are plain value types with no heap allocations
// or thread-local state. They are trivially safe to send across threads
// and cannot form reference cycles. For these types, Send and Acyclic are
// structural properties of the underlying C types.
// === Builtin types ===
