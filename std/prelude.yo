// @skip_prelude
// Prelude Module
// - Calling "import" is prohibited in this prelude module.

// Traits for determine type availability
/// Comptime trait - indicates a type that can be used at compile-time.
/// Examples: i32, bool, Type, comptime_int, comptime_float, comptime_string
/// Non-examples: int, ushort (runtime-only types)
Comptime :: trait(
  id := "Comptime"
);
export Comptime;

/// Runtime trait - indicates a type that can be used at runtime.
/// Examples: i32, bool, *(i32), void
/// Non-examples: comptime_int, comptime_float, comptime_string, Type (compile-time-only types)
Runtime :: trait(
  id := "Runtime"
);
export Runtime;

// === Builtin Yo functions ===
extern "Yo",
  __yo_return_self : (fn(forall(T: Type), self: T) -> T),
  __yo_noop : (fn(forall(T : Type))-> T),
  __yo_as : (fn(forall(_Self: Type), self: _Self, comptime(Target): Type) -> Target),
  
  // Arithmetic Operators
  /// +
  __yo_op_add : (fn(forall(T : Type), x : T, y : T) -> T),
  /// -
  __yo_op_sub : (fn(forall(T : Type), x : T, y : T) -> T),
  /// *
  __yo_op_mul : (fn(forall(T : Type), x : T, y : T) -> T),
  /// /
  __yo_op_div : (fn(forall(T : Type), x : T, y : T) -> T),
  /// %
  __yo_op_mod : (fn(forall(T : Type), x : T, y : T) -> T),
  /// -
  __yo_op_neg : (fn(forall(T : Type), x : T) -> T),
  
  // Relational Operators
  /// ==
  __yo_op_eq : (fn(forall(T : Type), x : T, y : T) -> bool),
  /// !=
  __yo_op_neq : (fn(forall(T : Type), x : T, y: T) -> bool),
  /// <
  __yo_op_lt : (fn(forall(T : Type), x : T, y : T) -> bool),
  /// <=
  __yo_op_lte : (fn(forall(T : Type), x : T, y : T) -> bool),
  /// >
  __yo_op_gt : (fn(forall(T : Type), x : T, y : T) -> bool),
  /// >=
  __yo_op_gte : (fn(forall(T : Type), x : T, y : T) -> bool),

  // Logical Operators
  /// !
  __yo_op_not : (fn(forall(T : Type), x : T) -> bool),

  // Bitwise Operators
  /// &
  __yo_op_bit_and : (fn(forall(T : Type), x : T, y : T) -> T),
  /// |
  __yo_op_bit_or  : (fn(forall(T : Type), x : T, y : T) -> T),
  /// ^
  __yo_op_bit_xor : (fn(forall(T : Type), x : T, y : T) -> T),
  /// ~
  __yo_op_bit_complement: (fn(forall(T : Type), x : T) -> T),
  /// <<
  __yo_op_bit_left_shift : (fn(forall(T : Type), x : T, y : T) -> T),
  /// >>
  __yo_op_bit_right_shift : (fn(forall(T : Type), x : T, y : T) -> T),

  // Ptr related functions
  __yo_ptr_add :
    fn(forall(T: Type), ptr : T, offset : usize) -> T,
  __yo_ptr_sub :
    fn(forall(T: Type), ptr : T, offset : usize) -> T,
  __yo_ptr_diff :
    fn(forall(T: Type), ptr1 : T, ptr2 : T) -> isize,
  __yo_ptr_eq :
    fn(forall(T: Type), ptr1 : T, ptr2 : T) -> bool,
  __yo_ptr_neq :
    fn(forall(T: Type), ptr1 : T, ptr2 : T) -> bool,
  __yo_ptr_lt :
    fn(forall(T: Type), ptr1 : T, ptr2 : T) -> bool,
  __yo_ptr_lte :
    fn(forall(T: Type), ptr1 : T, ptr2 : T) -> bool,
  __yo_ptr_gt :
    fn(forall(T: Type), ptr1 : T, ptr2 : T) -> bool,
  __yo_ptr_gte :
    fn(forall(T: Type), ptr1 : T, ptr2 : T) -> bool,

  // slice related
  __yo_slice_len :
    fn(forall(T: Type), slice: Slice(T)) -> usize,

  // C macro related
  __yo_c_macro_defined : (fn(comptime(name) : comptime_string) -> comptime(bool)),
  __yo_c_macro_value : (fn(comptime(name) : comptime_string) -> comptime(comptime_string)),

  // Process related functions
  __yo_process_platform : (fn() -> comptime(comptime_string)),
  __yo_process_arch : (fn() -> comptime(comptime_string)),
  __yo_process_cwd : (fn() -> comptime(comptime_string)),
  __yo_process_env_get : (fn(comptime(key) : comptime_string) -> comptime(comptime_string)),
  __yo_process_node_version : (fn() -> comptime(comptime_string))
;
export __yo_as;

assert :: (fn(flag : bool, (comptime(msg) : comptime_string) ?= "Assertion failed.") -> unit)
  cond(
    flag => (),
    true => panic(msg)
  )
;
export assert;

// unsafe module
unsafe :: impl {
  drop :: (fn(forall(T : Type), own(value) : T) -> unit) {
    ___drop(value);
    ()
  };
  export drop;
};
export unsafe;

