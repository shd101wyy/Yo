// ---------------------------------------------------------------------------
// Range back-iteration — the DoubleEndedIterator half of the forward impls
// above, so `(a .. b).rev()` and `.rev()` on any range-backed chain work.
// Per-type for the same reason the forward impls are: a generic impl would
// need a `Step` notion (a generic "one") the prelude does not have.
// ---------------------------------------------------------------------------
/// Half-open `i8` range back-iteration: yields `end - 1`, …, `start`. No
/// underflow on unsigned types: the guard means `end > start >= i8.MIN`, so
/// `end - 1` is always representable.
impl(
  Range(i8),
  DoubleEndedIterator(
    Item : i8,
    next_back : (fn(inout(self) : Self) -> Option(i8))(
      cond(
        (self.start >= self.end) => .None,
        true => {
          self.end = (self.end - i8(1));
          .Some(self.end)
        }
      )
    )
  )
);
/// Inclusive `i8` range back-iteration: yields `end`, …, `start`. The exact
/// mirror of the forward impl — the canonical-EMPTY sentinel (start 1, end 0)
/// is end-agnostic, so flipping on the LAST element works from either side,
/// `i8.MIN ..= x` terminates from the back without underflowing `end`, and
/// mixing `next` with `next_back` on one range stays correct because both test
/// `start > end` and both flip when the ends coincide.
impl(
  RangeInclusive(i8),
  DoubleEndedIterator(
    Item : i8,
    next_back : (fn(inout(self) : Self) -> Option(i8))(
      cond(
        (self.start > self.end) => .None,
        true => {
          v := self.end;
          cond(
            (v == self.start) => {
              self.start = i8(1);
              self.end = i8(0);
            },
            true => {
              self.end = (self.end - i8(1));
            }
          );
          .Some(v)
        }
      )
    )
  )
);
