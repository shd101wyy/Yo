/**
 * This file contains the prelude for the Yo language.
 * References:
 * - Haskell: https://hackage.haskell.org/package/base-4.19.0.0/docs/index.html
 * - Rust: https://doc.rust-lang.org/std/index.html
 */

// builtins
{ _ } :: import "./builtins.yo";

// interface
_arithmetic := import "./interfaces/arithmetic.yo";
_logic := import "./interfaces/logic.yo";
_common := import "./interfaces/common.yo";
_eq := import "./interfaces/eq.yo";
_ord := import "./interfaces/ord.yo";
_closure := import "./interfaces/closure.yo";

// data
_option := import "./data/option.yo";
_i32 := import "./data/primitive/i32.yo";
_boolean := import "./data/primitive/boolean.yo";

export {
  ...(_arithmetic),
  ...(_logic),
  ...(_common),
  ...(_eq),
  ...(_ord),
  ...(_closure),

  ...(_option),
  ...(_i32),
  ...(_boolean),
}