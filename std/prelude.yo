// ---------------------------------------------------------------------------
// Blanket methods — added to all types implementing Iterator
// ---------------------------------------------------------------------------
/// Blanket `into_iter` — every `Iterator` is its own `IntoIterator`,
/// returning `self`. This lets `for(combinator_chain, (x) => body)`
/// expand to `combinator_chain.into_iter().next()` uniformly with
/// `for(coll, (x) => body)` — the macro always calls `.into_iter()`
/// for the value-iteration form, and for an iterator we hand back
/// self. See plans/archive/ITERATOR_REDESIGN.md.
impl(
  generic(I : Type),
  where(I <: Iterator),
  I,
  into_iter : (fn(self : Self) -> Self)(self)
);
impl(
  generic(I : Type),
  where(I <: Iterator),
  I,
  /// Transform each element with `f`, producing an `IterMap` iterator.
  map : (
    fn(
      generic(A : Type, B : Type, F : Type),
      self : Self,
      f : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> B))
    ) -> IterMap(Self, B, F)
  )(
    IterMap(Self, B, F)(_inner : self, _f : f)
  ),
  /// Keep only elements for which `pred` returns `true`, producing an
  /// `IterFilter` iterator. The predicate takes the element BY VALUE,
  /// symmetric with `map` (D3.4 callback-asymmetry fix).
  filter : (
    fn(
      generic(A : Type, F : Type),
      self : Self,
      f : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> bool))
    ) -> IterFilter(Self, F)
  )(
    IterFilter(Self, F)(_inner : self, _f : f)
  ),
  /// Yield at most `n` elements, producing an `IterTake` iterator.
  take : (
    fn(
      generic(A : Type),
      self : Self,
      n : usize,
      where(Self <: Iterator(Item := A))
    ) -> IterTake(Self)
  )(
    IterTake(Self)(_inner : self, _remaining : n)
  ),
  /// Skip the first `n` elements, producing an `IterSkip` iterator.
  skip : (
    fn(
      generic(A : Type),
      self : Self,
      n : usize,
      where(Self <: Iterator(Item := A))
    ) -> IterSkip(Self)
  )(
    IterSkip(Self)(_inner : self, _to_skip : n)
  ),
  /// Pair each element with its zero-based index, producing an `IterEnumerate` iterator.
  enumerate : (
    fn(
      generic(A : Type),
      self : Self,
      where(Self <: Iterator(Item := A))
    ) -> IterEnumerate(Self)
  )(
    IterEnumerate(Self)(_inner : self, _index : usize(0))
  ),
  /// Combine with another iterator element-by-element, producing an `IterZip` iterator.
  zip : (
    fn(
      generic(A : Type, J : Type, B : Type),
      self : Self,
      other : J,
      where(Self <: Iterator(Item := A), J <: Iterator(Item := B))
    ) -> IterZip(Self, J)
  )(
    IterZip(Self, J)(_left : self, _right : other)
  ),
  /// Reduce the iterator to a single value by repeatedly applying `f`.
  fold : (
    fn(
      generic(A : Type, Acc : Type, F : Type),
      self : Self,
      init : Acc,
      f : F,
      where(Self <: Iterator(Item := A), F <: (Fn(acc : Acc, item : A) -> Acc))
    ) -> Acc
  )({
    acc := init;
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          acc = (f)(acc, item);
        }
      );
    });
    acc
  }),
  /// Apply `f` to each element, consuming the iterator.
  for_each : (
    fn(
      generic(A : Type, F : Type),
      self : Self,
      f : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> unit))
    ) -> unit
  )({
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          (f)(item);
        }
      );
    });
  }),
  /// Count the number of remaining elements.
  count : (
    fn(
      generic(A : Type),
      self : Self,
      where(Self <: Iterator(Item := A))
    ) -> usize
  )({
    n := usize(0);
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(_) => {
          n = (n + usize(1));
        }
      );
    });
    n
  }),
  /// Return `true` if any element satisfies `pred`.  Short-circuits on first match.
  any : (
    fn(
      generic(A : Type, F : Type),
      self : Self,
      pred : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> bool))
    ) -> bool
  )({
    result := false;
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          cond(
            (pred)(item) => {
              result = true;
              break;
            },
            true => ()
          );
        }
      );
    });
    result
  }),
  /// Return `true` if every element satisfies `pred`.  Short-circuits on first failure.
  all : (
    fn(
      generic(A : Type, F : Type),
      self : Self,
      pred : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> bool))
    ) -> bool
  )({
    result := true;
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          cond(
            !(pred(item)) => {
              result = false;
              break;
            },
            true => ()
          );
        }
      );
    });
    result
  }),
  /// Return the first element satisfying `pred`. Short-circuits.
  find : (
    fn(
      generic(A : Type, F : Type),
      self : Self,
      pred : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> bool))
    ) -> Option(A)
  )({
    (found : Option(A)) = .None;
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          cond(
            (pred)(item) => {
              found = .Some(item);
              break;
            },
            true => ()
          );
        }
      );
    });
    found
  }),
  /// Return the zero-based index of the first element satisfying `pred`.
  position : (
    fn(
      generic(A : Type, F : Type),
      self : Self,
      pred : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> bool))
    ) -> Option(usize)
  )({
    (found : Option(usize)) = .None;
    idx := usize(0);
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          cond(
            (pred)(item) => {
              found = .Some(idx);
              break;
            },
            true => {
              idx = (idx + usize(1));
            }
          );
        }
      );
    });
    found
  }),
  /// Return the last element, consuming the iterator.
  last : (
    fn(
      generic(A : Type),
      self : Self,
      where(Self <: Iterator(Item := A))
    ) -> Option(A)
  )({
    (latest : Option(A)) = .None;
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          latest = .Some(item);
        }
      );
    });
    latest
  }),
  /// Return the `n`-th element (zero-based), consuming elements up to it.
  nth : (
    fn(
      generic(A : Type),
      self : Self,
      n : usize,
      where(Self <: Iterator(Item := A))
    ) -> Option(A)
  )({
    (result : Option(A)) = .None;
    remaining := n;
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          cond(
            (remaining == usize(0)) => {
              result = .Some(item);
              break;
            },
            true => {
              remaining = (remaining - usize(1));
            }
          );
        }
      );
    });
    result
  }),
  /// Sum all elements, starting from the element type's `Default`.
  sum : (
    fn(
      generic(A : Type),
      self : Self,
      where(Self <: Iterator(Item := A), A <: (Add(A), Default))
    ) -> A
  )({
    (acc : A) = (A <: Default).default();
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          acc = (acc + item);
        }
      );
    });
    acc
  }),
  /// Return the smallest element (first of equals), or `None` when empty.
  min : (
    fn(
      generic(A : Type),
      self : Self,
      where(Self <: Iterator(Item := A), A <: Ord(A))
    ) -> Option(A)
  )({
    (best : Option(A)) = .None;
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          best = match(
            best,
            .None => Option(A).Some(item),
            .Some(b) => cond(
              (item < b) => Option(A).Some(item),
              true => Option(A).Some(b)
            )
          );
        }
      );
    });
    best
  }),
  /// Return the largest element (last of equals), or `None` when empty.
  max : (
    fn(
      generic(A : Type),
      self : Self,
      where(Self <: Iterator(Item := A), A <: Ord(A))
    ) -> Option(A)
  )({
    (best : Option(A)) = .None;
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          best = match(
            best,
            .None => Option(A).Some(item),
            .Some(b) => cond(
              (item < b) => Option(A).Some(b),
              true => Option(A).Some(item)
            )
          );
        }
      );
    });
    best
  }),
  /// Yield all of this iterator, then all of `other` (same element type).
  chain : (
    fn(
      generic(A : Type, J : Type),
      self : Self,
      other : J,
      where(Self <: Iterator(Item := A), J <: Iterator(Item := A))
    ) -> IterChain(Self, J)
  )(
    IterChain(Self, J)(_first : self, _second : other, _first_done : false)
  ),
  /// Yield elements while `pred` holds, producing an `IterTakeWhile`.
  take_while : (
    fn(
      generic(A : Type, F : Type),
      self : Self,
      f : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> bool))
    ) -> IterTakeWhile(Self, F)
  )(
    IterTakeWhile(Self, F)(_inner : self, _f : f, _done : false)
  ),
  /// Skip elements while `pred` holds, producing an `IterSkipWhile`.
  skip_while : (
    fn(
      generic(A : Type, F : Type),
      self : Self,
      f : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> bool))
    ) -> IterSkipWhile(Self, F)
  )(
    IterSkipWhile(Self, F)(_inner : self, _f : f, _skipping : true)
  ),
  /// Map to `Option` and keep the `Some`s, producing an `IterFilterMap`.
  filter_map : (
    fn(
      generic(A : Type, B : Type, F : Type),
      self : Self,
      f : F,
      where(Self <: Iterator(Item := A), F <: (Fn(item : A) -> Option(B)))
    ) -> IterFilterMap(Self, B, F)
  )(
    IterFilterMap(Self, B, F)(_inner : self, _f : f)
  ),
  /// Wrap in an `IterPeekable`, which adds `peek()`.
  peekable : (
    fn(
      generic(A : Type),
      self : Self,
      where(Self <: Iterator(Item := A))
    ) -> IterPeekable(Self, A)
  )(
    IterPeekable(Self, A)(_inner : self, _peeked : Option(A).None)
  ),
  /// Collect the iterator into the collection type `C`, chosen by TYPE
  /// ARGUMENT the way `into(T)` is. The element type is not written — it comes
  /// from `Self.Item` and must match `C`'s `FromIterator.Elem`.
  ///
  /// ```rust
  /// squares := (i32(0) .. i32(5)).map((x) => (x * x)).collect(ArrayList(i32));
  /// uniq := words.into_iter().collect(HashSet(String));
  /// ```
  ///
  /// There is no return-type inference and no turbofish: the argument is the
  /// only channel. Carries NO `generic(A : Type)` and no method-level `Self`
  /// bound — the enclosing impl header already supplies `Self <: Iterator`, and
  /// binding no `A` keeps `collect` off the Item-recovery path implicated in
  /// issues/iterator-chain-shared-stamp-cross-item-pollution.md.
  collect : (
    fn(
      self : Self,
      comptime(C) : Type,
      where(C <: FromIterator)
    ) -> C
  )({
    (out : C) = (C <: FromIterator).from_iter_new();
    iter := self;
    while(runtime(true), {
      match(
        iter.next(),
        .None => {
          break;
        },
        .Some(item) => {
          out = (C <: FromIterator).from_iter_add(out, item);
        }
      );
    });
    out
  })
);
/// Blanket `rev` — added to every type implementing `DoubleEndedIterator`.
///
/// Its OWN impl block (rather than a method inside the `where(I <: Iterator)`
/// block with a trailing `where(Self <: DoubleEndedIterator)`) so the bound sits
/// on a bare-SomeT receiver pattern, which is the only case where an impl
/// where-clause is actually enforced during generic-impl matching — `rev` on a
/// forward-only iterator then fails at method resolution with a clear message
/// instead of late inside specialization.
impl(
  generic(I : Type),
  where(I <: DoubleEndedIterator),
  I,
  /// Reverse the iteration order, producing an `IterRev` iterator.
  ///
  /// ```rust
  /// (i32(0) .. i32(5)).rev().for_each((x) => { out.push(x); });  // 4 3 2 1 0
  /// ```
  rev : (fn(self : Self) -> IterRev(Self))(
    IterRev(Self)(_inner : self)
  )
);
/// FutureState — the state of an async `Future`.
FutureState :: enum(
  /// The future has been created but not yet started.
  Pending = 0,
  /// The future is actively running.
  Running = 1,
  /// The future completed successfully.
  Completed = -(1),
  /// The future was aborted (e.g., via `unwind`).
  Aborted = -(2)
);
// SAFETY: FutureState is a plain enum of integer values (Pending, Done,
// Aborted) with no heap allocations. It is trivially Send and Acyclic.
impl(FutureState, Acyclic());
impl(FutureState, Runtime());
impl(FutureState, Send());
impl(
  FutureState,
  Eq(FutureState)(
    (==) : ((lhs, rhs) -> __yo_op_eq(lhs, rhs)),
    (!=) : ((lhs, rhs) -> __yo_op_neq(lhs, rhs))
  )
);
export(FutureState);
/// JoinHandle — a handle to a spawned async task.
/// Wraps a raw pointer to the spawned future's state machine.
/// Generic over `T`, the return type of the spawned task.
JoinHandle :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    /// Raw pointer to the spawned future (uses `*(T)` so the type parameter is visible).
    __future : *(T)
  )
);
// Phase L (THREAD_SAFETY): JoinHandle is NOT Send — the inner future state
// machine lives on the spawner's event-loop thread. Cross-thread result
// delivery uses Channel(T).
impl(generic(T : Type), JoinHandle(T), !(Send()));
export(JoinHandle);
/// Io module — the async runtime effect.
///
/// Provides `io.async`, `io.await`, `io.spawn`, and `io.state` operations.
/// Automatically injected into `main` when declared with `io : Io`.
Io :: struct(
  /// Create a new `Future` from an async closure.
  async : (fn(generic(T : Type, E : Type.Struct), action : Impl(Fn(e : E) -> T)) -> Impl(Future(T, E))),
  /// Await a `Future`, suspending until its result is ready.
  await : (fn(generic(T : Type, E : Type.Struct), fut : Impl(Future(T, E)), e : E) -> T),
  /// Inspect the current state of a `Future` without blocking.
  state : (fn(generic(T : Type, E : Type), fut : Impl(Future(T, E))) -> FutureState),
  /// Spawn a `Future` as an independent task, returning a `JoinHandle`.
  spawn : (fn(generic(T : Type, E : Type.Struct), fut : Impl(Future(T, E)), e : E) -> JoinHandle(T))
);
// Phase L (THREAD_SAFETY): Io is NOT Send — the async runtime it represents
// is per-thread (per AGENTS.md). Sending Io across a thread boundary would
// reference a scheduler on the wrong thread.
impl(Io, !(Send()));
export(Io);
extern(
  "Yo",
  __yo_io_async : (fn(generic(T : Type, E : Type.Struct), action : Impl(Fn(e : E) -> T)) -> Impl(Future(T, E))),
  __yo_io_await : (fn(generic(T : Type, E : Type.Struct), fut : Impl(Future(T, E)), e : E) -> T),
  __yo_io_state : (fn(generic(T : Type, E : Type), fut : Impl(Future(T, E))) -> FutureState),
  __yo_io_spawn : (fn(generic(T : Type, E : Type.Struct), fut : Impl(Future(T, E)), e : E) -> JoinHandle(T))
);
/// Built-in Io module instance. Automatically injected for `main` functions
/// with `io : Io`.
__yo_builtin_io :: Io(
  async : __yo_io_async,
  await : __yo_io_await,
  state : __yo_io_state,
  spawn : __yo_io_spawn
);
export(__yo_builtin_io);
/// JoinHandle methods — defined after Io so `io : Io` resolves.
extern(
  "Yo",
  __yo_join_handle_await : (fn(generic(T : Type), self : JoinHandle(T), io : Io) -> Option(T))
);
impl(
  generic(T : Type),
  JoinHandle(T),
  await : __yo_join_handle_await
);
/// JoinHandle introspection + cancellation. The raw helpers read/write the
/// common spawned-future header (`{__yo_ref_header_t; int state;}`) emitted
/// by the async runtime; state mapping follows `io.state`: any positive step
/// index reads as Running.
extern(
  "Yo",
  __yo_join_handle_state_raw : (fn(fut : *(void)) -> FutureState),
  __yo_join_handle_abort_raw : (fn(fut : *(void)) -> unit)
);
impl(
  generic(T : Type),
  JoinHandle(T),
  /// The task's current `FutureState`, read without blocking or driving the
  /// event loop (unlike `await`, which polls the loop to completion).
  state : (fn(self : JoinHandle(T)) -> FutureState)(
    __yo_join_handle_state_raw(*(void)(self.__future))
  ),
  /// True once the task is terminal — `Completed` or `Aborted`.
  is_finished : (fn(self : JoinHandle(T)) -> bool)({
    s := __yo_join_handle_state_raw(*(void)(self.__future));
    (s == FutureState.Completed) || (s == FutureState.Aborted)
  }),
  /// Cancel the task: a non-terminal task is marked `Aborted` and will not
  /// resume past its current suspension point (its pending completion, if
  /// any, releases the state machine instead of resuming it). Completed and
  /// already-aborted tasks are left untouched. `await` on an aborted handle
  /// returns `.None`. NOTE: abort cancels the TASK, not any in-flight I/O
  /// operation it is suspended on — a task parked on I/O that never
  /// completes stays allocated until process exit.
  abort : (fn(self : JoinHandle(T)) -> unit)(
    __yo_join_handle_abort_raw(*(void)(self.__future))
  )
);
