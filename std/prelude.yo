//! Prelude — automatically imported into every Yo source file.
//!
//! Provides core language primitives: traits (`Comptime`, `Runtime`, `Clone`,
//! `Eq`, `Ord`, `Hash`, …), fundamental types (`Option`, `Result`, `Box`,
//! `Slice`, `Range`, `String`, …), operator traits (`Add`, `Sub`, …), type
//! reflection (`TypeInfo`), conversion (`Into`, `From`), the async runtime
//! (`Io`, `Future`, `JoinHandle`), and derive rules.
//!
//! **Do NOT import `std/prelude`** — it is loaded automatically and an
//! explicit import will produce a compile error.
// === Foundational traits ===
// `Comptime` and `Runtime` are defined first because every other
// type (including `Pragma` below) is type-checked against them.
/// Comptime trait — indicates a type that can be used at compile-time.
/// Examples: `i32`, `bool`, `Type`, `comptime_int`, `comptime_float`, `comptime_str`.
/// Non-examples: `int`, `ushort` (runtime-only types).
Comptime :: trait(
  id := "Comptime"
);
export(Comptime);
/// Runtime trait — indicates a type that can be used at runtime.
/// Examples: `i32`, `bool`, `*(i32)`, `void`.
/// Non-examples: `comptime_int`, `comptime_float`, `comptime_str`, `Type` (compile-time-only types).
Runtime :: trait(
  id := "Runtime"
);
export(Runtime);

// === Pragma — file-level privilege flags ===
//
// `Pragma` is defined here (right after the foundational traits and
// BEFORE any extern/asm/pointer-op site) so the prelude can declare
// its own `pragma(Pragma.AllowUnsafe);` via ordinary evaluation. The
// prelude is the foundation of Yo's unsafe-capable machinery
// (raw-pointer impls, FFI declarations, the async runtime, …); the
// pragma must be registered before the first extern/asm/pointer-op
// declaration fires the Phase C gates.
//
// `SkipPrelude` is recognized via a separate AST-level pre-scan that
// runs before the prelude loads (chicken-and-egg: a file with
// `pragma(Pragma.SkipPrelude);` doesn't have the prelude in scope).
// All other pragma variants are validated by ordinary evaluation
// against this enum. See plans/MEMORY_SAFETY.md.
/// File-level privilege flag for the `pragma(...)` builtin. Declared
/// at the top of a Yo file (e.g. `pragma(Pragma.AllowUnsafe);`) to
/// opt the file into compiler-recognized behaviors. See
/// plans/MEMORY_SAFETY.md.
Pragma :: enum(
  /// File is permitted to use raw pointer ops, `unsafe(...)`,
  /// `asm(...)`, and `extern(...)`. Without this, those constructs
  /// produce compile errors.
  AllowUnsafe,
  /// File is permitted to DEFINE macro functions — `quote(...)`
  /// parameters and `unquote(...)` return types. CALLING macros (`if`,
  /// `for`, collection literals, …) needs no pragma. Recognized at the
  /// AST level so it also works in `SkipPrelude` files. See
  /// plans/MACRO_POLICY.md.
  AllowMacroDef,
  /// Disable the auto-import of `std/prelude`. Used by the prelude
  /// itself, and by any tool/test that wants to bootstrap manually.
  /// Recognized at the AST level before the prelude loads.
  SkipPrelude,
  /// Test-runner directive: skip this test file on ALL WASM targets.
  SkipWasm,
  /// Test-runner directive: skip when target is wasm32-unknown-emscripten.
  SkipWasm32Emscripten,
  /// Test-runner directive: skip when target is wasm32-wasip1.
  SkipWasm32Wasi,
  /// File is skipped by the test runner when the target OS is Windows.
  /// For tests that depend on a POSIX-only or not-yet-ported platform
  /// facility (e.g. std/crypto/tls needs OpenSSL, absent on the Windows
  /// runners — Schannel is the deferred Windows path). Mirrors the
  /// SkipWasm32* variants.
  SkipWindows,
  /// Formal verification: contracts in this file are proof obligations.
  /// Phase 0 only registers the pragma; later phases will hook in
  /// verification. See plans/FORMAL_VERIFICATION.md.
  Verify,
  /// Formal verification: try to prove, fall back to runtime assert
  /// when proof times out. The production mode for verified code.
  VerifyOrAssert,
  /// Formal verification: erase contract clauses entirely (no proof,
  /// no runtime assert). For release/benchmark builds.
  NoContracts
);
export(Pragma);

// Prelude opts itself out of the implicit self-prelude import and
// into unsafe-capable mode. Both calls evaluate normally against the
// `Pragma` enum defined just above.
pragma(Pragma.SkipPrelude);
pragma(Pragma.AllowUnsafe);
// === Builtin Yo functions ===
extern(
  "Yo",
  __yo_return_self : (fn(generic(T : Type), self : T) -> T),
  __yo_noop : (fn(generic(T : Type)) -> T),
  __yo_borrow_assert_unborrowed : (fn(generic(T : Type), obj : T) -> unit),
  __yo_as : (fn(generic(_Self : Type), self : _Self, comptime(Target) : Type) -> Target),
  // Arithmetic Operators
  /// +
  __yo_op_add : (fn(generic(T : Type), x : T, y : T) -> T),
  /// -
  __yo_op_sub : (fn(generic(T : Type), x : T, y : T) -> T),
  /// *
  __yo_op_mul : (fn(generic(T : Type), x : T, y : T) -> T),
  /// /
  __yo_op_div : (fn(generic(T : Type), x : T, y : T) -> T),
  /// %
  __yo_op_mod : (fn(generic(T : Type), x : T, y : T) -> T),
  /// -
  __yo_op_neg : (fn(generic(T : Type), x : T) -> T),
  // Relational Operators
  /// ==
  __yo_op_eq : (fn(generic(T : Type), x : T, y : T) -> bool),
  /// !=
  __yo_op_neq : (fn(generic(T : Type), x : T, y : T) -> bool),
  /// <
  __yo_op_lt : (fn(generic(T : Type), x : T, y : T) -> bool),
  /// <=
  __yo_op_lte : (fn(generic(T : Type), x : T, y : T) -> bool),
  /// >
  __yo_op_gt : (fn(generic(T : Type), x : T, y : T) -> bool),
  /// >=
  __yo_op_gte : (fn(generic(T : Type), x : T, y : T) -> bool),
  // Logical Operators
  /// !
  __yo_op_not : (fn(generic(T : Type), x : T) -> bool),
  // Bitwise Operators
  /// &
  __yo_op_bit_and : (fn(generic(T : Type), x : T, y : T) -> T),
  /// |
  __yo_op_bit_or : (fn(generic(T : Type), x : T, y : T) -> T),
  /// ^
  __yo_op_bit_xor : (fn(generic(T : Type), x : T, y : T) -> T),
  /// ~
  __yo_op_bit_complement : (fn(generic(T : Type), x : T) -> T),
  /// <<
  __yo_op_bit_left_shift : (fn(generic(T : Type), x : T, y : T) -> T),
  /// >>
  __yo_op_bit_right_shift : (fn(generic(T : Type), x : T, y : T) -> T),
  // Ptr related functions
  __yo_ptr_add :
    (fn(generic(T : Type), ptr : T, offset : usize) -> T),
  __yo_ptr_sub :
    (fn(generic(T : Type), ptr : T, offset : usize) -> T),
  __yo_ptr_diff :
    (fn(generic(T : Type), ptr1 : T, ptr2 : T) -> isize),
  __yo_ptr_eq :
    (fn(generic(T : Type), ptr1 : T, ptr2 : T) -> bool),
  __yo_ptr_neq :
    (fn(generic(T : Type), ptr1 : T, ptr2 : T) -> bool),
  __yo_ptr_lt :
    (fn(generic(T : Type), ptr1 : T, ptr2 : T) -> bool),
  __yo_ptr_lte :
    (fn(generic(T : Type), ptr1 : T, ptr2 : T) -> bool),
  __yo_ptr_gt :
    (fn(generic(T : Type), ptr1 : T, ptr2 : T) -> bool),
  __yo_ptr_gte :
    (fn(generic(T : Type), ptr1 : T, ptr2 : T) -> bool),
  // str (builtin static string view) intrinsics
  __yo_str_from_raw_parts :
    (fn(ptr : *(u8), length : usize) -> str),
  __yo_str_len :
    (fn(s : str) -> usize),
  __yo_str_ptr :
    (fn(s : str) -> *(u8)),
  __yo_str_byte :
    (fn(s : str, idx : usize) -> u8),
  // array indexing builtin (used by Index trait impls)
  __yo_array_index :
    (fn(generic(T : Type, N : usize), self : *(Array(T, N)), idx : usize) -> *(T)),
  // Process related functions
  __yo_process_platform : (fn() -> comptime(comptime_str)),
  __yo_process_arch : (fn() -> comptime(comptime_str))
);
export(__yo_as);
/// The `unsafe` module — provides low-level unwind hatches.
unsafe :: impl({
  /// Manually drop `value`, running its destructor immediately.
  drop :: (fn(quote(value) : Expr) -> unquote(Expr))(quote(___drop(unquote(value))));
  export(drop);
  cast :: __yo_as;
  export(cast);
});
export(unsafe);
/// Send trait — indicates a type that can be safely transferred between threads.
Send :: trait(
  id := "Send"
);
export(Send);
/// Acyclic trait - indicates a type that cannot form reference cycles.
/// Types that implement Acyclic don't need cycle collection tracking.
/// Primitive types, value types without object fields, and objects that
/// don't reference back to themselves (directly or indirectly) are Acyclic.
Acyclic :: trait(
  id := "Acyclic"
);
export(Acyclic);
/// The Rc trait means the type is reference counted `object` type.
Rc :: trait(
  id := "Rc"
);
export(Rc);
/// Dispose trait - defines a dispose method for cleaning up resources.
Dispose :: trait(
  id := "Dispose",
  dispose : (fn(self : Self) -> unit),
  where(Self <: Rc)
);
export(Dispose);
/// === Cycle-GC tracing ===
/// `GcTracer` carries the cycle collector's edge-registration callback (an opaque
/// raw pointer). A `Trace` impl calls `tracer.visit(slot)` once per outgoing edge,
/// passing a POINTER to where the child lives (a struct field or a container buffer
/// element). The raw callback is never touched directly.
GcTracer :: newtype(_callback : *(u8));
export(GcTracer);
extern(
  "Yo",
  /// Per-slot edge tracer (compiler intrinsic). Internal — call `tracer.visit`.
  __yo_gc_trace_child : (fn(generic(T : Type), tracer : GcTracer, slot : *(T)) -> unit)
);
impl(
  GcTracer,
  /// Trace one outgoing edge. `slot` points at where the child lives; the collector
  /// reads `*slot` WITHOUT touching its reference count — registering the edge if it
  /// is a managed handle and recursing inline through value structure otherwise.
  /// Passing the slot pointer (not the element by value) keeps tracing RC-neutral: a
  /// by-value managed handle would be dup'd then dropped, freeing a live element
  /// mid-collection.
  visit : (fn(generic(T : Type), self : Self, slot : *(T)) -> unit)(
    __yo_gc_trace_child(self, slot)
  )
);
/// Trace trait — mandatory for every reference type that can transitively hold a
/// managed reference. Auto-derived by the compiler for structs/enums (incl.
/// `Option` and all value types); hand-implemented for containers whose elements
/// live in a heap buffer (`ArrayList`, `HashMap`, …). The constructor wires
/// `header.traverse_fn` to this `trace`.
Trace :: trait(
  id := "Trace",
  trace : (fn(self : Self, tracer : GcTracer) -> unit),
  where(Self <: Rc)
);
export(Trace);
/// Index trait — enables `container(idx)` subscript syntax at runtime.
/// The `Idx` parameter is the index type (e.g., `usize`, `Range(usize)`).
/// Implementations must define an `Output` associated type and an `index` method.
Index :: (fn(comptime(Idx) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    index : (fn(inout(self) : Self, idx : Idx) -> *(Self.Output))
  )
);
export(Index);
/// ComptimeIndex — compile-time indexing trait for constant expressions.
ComptimeIndex :: (fn(comptime(Idx) : Type, where(Idx <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    index : (fn(comptime(inout(self)) : Self, comptime(idx) : Idx) -> comptime(*(Self.Output))),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeIndex);
/// Half-open range `start..end` (excludes `end`).
Range :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(start : T, end : T)
);
export(Range);
/// Inclusive range `start..=end` (includes `end`).
RangeInclusive :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(start : T, end : T)
);
export(RangeInclusive);
/// RangeOp trait — enables `start..end` operator syntax.
RangeOp :: trait(
  (..) : (fn(start : Self, end : Self) -> Range(Self))
);
export(RangeOp);
/// RangeInclusiveOp trait — enables `start..=end` operator syntax.
RangeInclusiveOp :: trait(
  (..=) : (fn(start : Self, end : Self) -> RangeInclusive(Self))
);
export(RangeInclusiveOp);
// comptime array/slice/string indexing builtins (used by ComptimeIndex trait impls)
extern(
  "Yo",
  __yo_comptime_array_index :
    (fn(generic(T : Type, N : usize), comptime(self) : *(Array(T, N)), comptime(idx) : usize, where(T <: Comptime)) -> comptime(*(T))),
  __yo_comptime_string_index :
    (fn(comptime(self) : comptime_str, comptime(idx) : comptime_int) -> comptime(comptime_str)),
  __yo_comptime_string_index_range :
    (fn(comptime(self) : comptime_str, comptime(idx) : Range(comptime_int)) -> comptime(comptime_str)),
  __yo_comptime_string_index_range_inclusive :
    (fn(comptime(self) : comptime_str, comptime(idx) : RangeInclusive(comptime_int)) -> comptime(comptime_str)),
  __yo_comptime_list_index :
    (fn(generic(T : Type), comptime(self) : *(ComptimeList(T)), comptime(idx) : usize, where(T <: Comptime)) -> comptime(*(T))),
  __yo_comptime_list_index_range :
    (fn(generic(T : Type), comptime(self) : *(ComptimeList(T)), comptime(idx) : Range(usize), where(T <: Comptime)) -> comptime(*(ComptimeList(T)))),
  __yo_comptime_list_index_range_inclusive :
    (fn(generic(T : Type), comptime(self) : *(ComptimeList(T)), comptime(idx) : RangeInclusive(usize), where(T <: Comptime)) -> comptime(*(ComptimeList(T))))
);
ComptimeRangeOp :: trait(
  (..) : (fn(comptime(start) : Self, comptime(end) : Self) -> comptime(Range(Self))),
  where(Self <: Comptime)
);
export(ComptimeRangeOp);
ComptimeRangeInclusiveOp :: trait(
  (..=) : (fn(comptime(start) : Self, comptime(end) : Self) -> comptime(RangeInclusive(Self))),
  where(Self <: Comptime)
);
export(ComptimeRangeInclusiveOp);
/// Add trait — enables `lhs + rhs` operator. Parameterized by `Rhs` type.
Add :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    /// The output type of the addition.
    Output : Type,
    (+) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(Add);
/// Compile-time variant of `Add`.
ComptimeAdd :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (+) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeAdd);
/// Sub trait — enables `lhs - rhs` operator.
Sub :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (-) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(Sub);
ComptimeSub :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (-) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeSub);
/// Mul trait — enables `lhs * rhs` operator.
Mul :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (*) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(Mul);
ComptimeMul :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (*) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeMul);
/// Div trait — enables `lhs / rhs` operator.
Div :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (/) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(Div);
ComptimeDiv :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (/) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeDiv);
/// Mod trait — enables `lhs % rhs` operator.
Mod :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (%) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(Mod);
ComptimeMod :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (%) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeMod);
/// BitLeftShift trait — enables `lhs << rhs` operator.
BitLeftShift :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (<<) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(BitLeftShift);
ComptimeBitLeftShift :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (<<) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeBitLeftShift);
/// BitRightShift trait — enables `lhs >> rhs` operator.
BitRightShift :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (>>) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(BitRightShift);
ComptimeBitRightShift :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (>>) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeBitRightShift);
// `Exponentiation`/`ComptimeExponentiation` were DELETED here (std S1,
// plans/STD_API_AUDIT.md §4 prelude row): the `**` operator token was
// already removed 2026-08-21 (plans/OPERATOR_SET_AND_PRECEDENCE.md), and
// the traits had zero impls and zero call sites — dead surface.
/// Negate trait — enables unary `-value` operator.
Negate :: trait(
  Output : Type,
  (neg) : (fn(self : Self) -> Self.Output)
);
export(Negate);
ComptimeNegate :: trait(
  Output : Type,
  (neg) : (fn(comptime(self) : Self) -> comptime(Self.Output)),
  where(Self <: Comptime, Self.Output <: Comptime)
);
export(ComptimeNegate);
/// LogicalNot trait — enables `!value` boolean negation.
LogicalNot :: trait((!) : (fn(self : Self) -> bool));
export(LogicalNot);
ComptimeLogicalNot :: trait(
  (!) : (fn(comptime(self) : Self) -> comptime(bool)),
  where(Self <: Comptime)
);
export(ComptimeLogicalNot);
/// BitNot trait — enables `~value` bitwise complement.
BitNot :: trait(
  Output : Type,
  (~) : (fn(self : Self) -> Self.Output)
);
export(BitNot);
ComptimeBitNot :: trait(
  Output : Type,
  (~) : (fn(comptime(self) : Self) -> comptime(Self.Output)),
  where(Self <: Comptime, Self.Output <: Comptime)
);
export(ComptimeBitNot);
/// BitAnd trait — enables `lhs & rhs` bitwise AND.
BitAnd :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (&) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(BitAnd);
ComptimeBitAnd :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (&) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeBitAnd);
/// BitOr trait — enables `lhs | rhs` bitwise OR.
BitOr :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (|) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(BitOr);
ComptimeBitOr :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (|) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeBitOr);
/// BitXor trait — enables `lhs ^ rhs` bitwise XOR.
BitXor :: (fn(comptime(Rhs) : Type) -> comptime(Trait))(
  trait(
    Output : Type,
    (^) : (fn(lhs : Self, rhs : Rhs) -> Self.Output)
  )
);
export(BitXor);
ComptimeBitXor :: (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))(
  trait(
    Output : Type,
    (^) : (fn(comptime(lhs) : Self, comptime(rhs) : Rhs) -> comptime(Self.Output)),
    where(Self <: Comptime, Self.Output <: Comptime)
  )
);
export(ComptimeBitXor);
(!) :: impl({
  (not) :: (
    fn(
      generic(_Self : Type),
      self : _Self,
      where(_Self <: LogicalNot)
    ) -> bool
  )(self.(!)());
  (comptime_not) :: (
    fn(
      generic(_Self : Type),
      comptime(self) : _Self,
      where(_Self <: (Comptime, ComptimeLogicalNot))
    ) -> comptime(bool)
  )(self.(!)());
  Call :: (not, comptime_not);
  export(Call);
});
(not) :: (!);
export(not, !);
(~) :: impl({
  (bit_not) :: (
    fn(
      generic(_Self : Type),
      self : _Self,
      where(_Self <: BitNot)
    ) -> _Self
  )(self.(~)());
  (comptime_bit_not) :: (
    fn(
      generic(_Self : Type),
      comptime(self) : _Self,
      where(_Self <: (Comptime, ComptimeBitNot))
    ) -> comptime(_Self)
  )(self.(~)());
  Call :: (bit_not, comptime_bit_not);
  export(Call);
});
export(~);
(-) :: impl({
  (neg) :: (
    fn(
      generic(_Self : Type),
      self : _Self,
      where(_Self <: Negate)
    ) -> _Self
  )({
    return(self.neg());
  });
  (comptime_neg) :: (
    fn(
      generic(_Self : Type),
      comptime(self) : _Self,
      where(_Self <: (Comptime, ComptimeNegate))
    ) -> comptime(_Self)
  )({
    return(self.neg());
  });
  Call :: (neg, comptime_neg);
  export(Call);
});
export(-);
/**
* logic for bool
* No need to export them. For internal use only
