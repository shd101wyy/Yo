// === Data Types ===
/// === Option ===
Option :: (fn(comptime(T) : Type) -> comptime(Type))
  enum(
    None,
    Some(value: T),

    unwrap :: (fn(self : Self) -> T)(
      match(self,
        .Some(value) => value,
        .None => panic("Called unwrap on a None value")
      )
    ),

    unwrap_or :: (fn(self : Self, or_value : T) -> T)(
      match(self,
        .Some(value) => value,
        .None => or_value
      )
    ),

    is_some :: (fn(self : Self) -> bool)(
      match(self,
        .Some(_) => true,
        .None => false
      )
    ),

    is_none :: (fn(self : Self) -> bool)(
      match(self,
        .None => true,
        .Some(_) => false
      )
    )
  )
;
// Alias of the Option type
? :: Option;
// Nullable pointer
(?*) :: (fn(comptime(T): Type) -> comptime(Type))
  Option(*(T))
;
export 
  Option,
  ?,
  (?*)
;


/// === Result ===
Result :: (fn(comptime(OkType): Type, comptime(ErrorType): Type) -> comptime(Type))
  enum
    Ok(value: OkType),
    Err(error: ErrorType),

    unwrap :: (fn(self : Self) -> OkType)(
      match(self,
        .Ok(value) => value,
        .Err(_) => panic("Called unwrap on an Error value")
      )
    ),

    is_ok :: (fn(self : Self) -> bool)(
      match(self,
        .Ok(_) => true,
        .Err(_) => false
      )
    ),

    is_err :: (fn(self : Self) -> bool)(
      match(self,
        .Err(_) => true,
        .Ok(_) => false
      )
    )
;
export
  Result
;

/// === Box ===
Box :: (fn(comptime(V) : Type) -> comptime(Type))
  object(
    (*) : V
  )
;
box :: (fn(forall(V : Type), own(value) : V) -> Box(V))
  Box(V)(value)
;
impl(forall(T : Type), Box(T), Isolation(
  can_isolate : ((self) -> (rc(self) == 1))
));
impl(forall(T : Type),
       where(T <: Hash),
       Box(T),
       Hash(
         (hash) : ((self) -> (self.*).*.hash())
       )
);
impl(forall(T : Type),
       where(T <: Eq(T)),
       Box(T),
       Eq(Box(T))(
         (==) : ((lhs, rhs) -> (lhs.* == rhs.*))
       )
);

export
  Box,
  box
;

/// === Iso ===
impl(forall(T : Type), Iso(T), Send());
impl(forall(T : Type), where(T <: Acyclic), Iso(T), Acyclic());
impl(forall(T : Type), Iso(T), {
  extract :: (fn(self : Self) -> Option(T))(
    __yo_iso_extract(self)
  );
  export extract;
});


(^) :: (fn(quote(v) : Expr) -> unquote(Expr))({
  temp :: cond(
    v.is_atom() => v, 
    true => gensym("iso_extract_temp")
  );
  temp_type :: gensym("iso_extract_temp_type");
  assignment :: cond(
    v.is_atom() => quote(()),
    true => quote(unquote(temp) := unquote(v))
  );
  return quote {
    unquote(assignment);
    unquote(temp_type) :: typeof(unquote(temp));
    cond(
      Type.contains_rc_type(unquote(temp_type)) =>  // compile-time check
        cond(
          Type.can_form_rc_cycle(unquote(temp_type)) => { // compile-time check
            consume(unquote(temp));
            comptime_assert(false, "Cannot isolate value of type containing Rc type that can form cycles");
            Option(Iso(unquote(temp_type))).None
          },
          !(Var.is_owning_the_rc_value(unquote(temp))) => { // compile-time check
            consume(unquote(temp));
            comptime_assert(false, "Cannot isolate value of type that is not owned");
            Option(Iso(unquote(temp_type))).None
          },
          (Var.has_other_aliases(unquote(temp))) => { // compile-time check
            consume(unquote(temp));
            comptime_assert(false, "Cannot isolate value of type that has other aliases");
            Option(Iso(unquote(temp_type))).None
          },
          (unquote(temp_type) <: Isolation).can_isolate(unquote(temp)) => // run-time check
            Option(Iso(unquote(temp_type))).Some(Iso(unquote(temp_type))(unquote(temp))),
          true => { // run-time check
            unsafe.drop(unquote(temp));
            Option(Iso(unquote(temp_type))).None
          }
        ),
      true => { // compile-time check
        comptime_assert(false, "Cannot isolate value type that does not contain Rc type");
        Option(Iso(unquote(temp_type))).Some(Iso(unquote(temp_type))(unquote(temp)))
      }
    )
  };
});
export (^);

/// === MaybeUninit ===
extern "Yo",
  __yo_maybe_uninit_new : 
    (fn(comptime(_Self) : Type) -> _Self),
  __yo_maybe_uninit_as_ptr : 
    (fn(comptime(_Self) : Type, comptime(BaseType): Type, self: *(_Self)) -> *(BaseType)),
  __yo_maybe_uninit_assume_init : 
    (fn(comptime(_Self) : Type, comptime(BaseType): Type, self: _Self) -> BaseType)
;

MaybeUninit :: (fn(comptime(BaseType): Type) -> comptime(Type))
  struct(
    value: BaseType,

    new :: (fn() -> Self)(__yo_maybe_uninit_new(Self)),

    as_ptr :: (fn(self: *(Self)) -> *(BaseType))(
      __yo_maybe_uninit_as_ptr(Self, BaseType, self)
    ),

    assume_init :: (fn(self : Self) -> BaseType)(
      __yo_maybe_uninit_assume_init(Self, BaseType, self)
    )
  )
;

/* EXAMPLE:

extern "C",
  time_t : Type,
  time : 
    fn(timer: ?*(time_t)) -> time_t
;

uninitialized_timer := MaybeUninit(time_t).new(); // Create an uninitialized MaybeUninit(time_t)
ptr := uninitialized_timer.as_ptr(); // ptr has type *(time_t)
time(.Some(ptr)); // initialize the timer
timer := uninitialized_timer.assume_init(); // now we can assume it's initialized

*/
export
  MaybeUninit
;

// === Traits again ===
/// === Iterator ===
Iterator :: (fn(comptime(Item) : Type) -> comptime(Trait)) {
  return trait(
    Item := Item,
    next :
      fn(self : *(Self)) -> Option(Self.Item)
  );
};
export Iterator;

/// === IntoIterator ===
IntoIterator :: (fn(
  comptime(Item) : Type,
  comptime(IntoIter) : Type,
  where(IntoIter <: Iterator(Item))) -> comptime(Trait)) {
  return trait(
    Item := Item,
    IntoIter := IntoIter,
    into_iter : 
      fn(self : Self) -> Self.IntoIter
  );
};
export IntoIterator;

// === Conversion ===
TryFrom :: (fn(comptime(From) : Type) -> comptime(Trait))(
  trait(
    Error : Type,
    try_from :
      (fn(value : From) -> Result(Self, Self.Error))
  )
);
export TryFrom;

TryInto :: (fn(comptime(To) : Type) -> comptime(Trait))(
  trait(
    Error : Type,
    try_into :
      (fn(self : Self, (comptime(_To) : Type) = To) -> Result(To, Self.Error))
  )
);
export TryInto;

// === Macros ===
/// === if ===
if :: (fn(quote(condition) : Expr,
        quote(then) : Expr,
        (quote(else) : Expr) ?= quote(())
      ) -> unquote(Expr))
  quote
    cond 
      unquote(condition) => unquote(then),
      true => unquote(else)
;
export 
  if
;

/**
* try macro for handling Result types.
*/
try :: (fn(quote(expr_to_try): Expr) -> unquote(Expr)) {
  temp :: gensym("try");
  quote {
    unquote(temp) := unquote(expr_to_try);
    match(unquote(temp),
      .Ok => unquote(temp).value,
      .Err => {
        return unquote(temp).error;
      }
    )
  }
};
export try;

/**
 * `for` macro to run while loop over an iterator
 * eg:
 * 
 *   for box.into_iter(), (value) => {
 *     printf("value %d\n", value);
 *   };
 *
 * transforms to
 * 
 * iter := box.into_iter();
 * while true, {
 *   value := iter.next();
 *   match(value,
 *     .Some(value) => {
 *       printf("value %d\n", value);
 *     }),
 *     .None => { break; } 
 * }
 */
for :: (fn(
  quote(iter) : Expr,
  quote(handle) : Expr
  ) -> unquote(Expr)) {
  // Check if `handle` is a function call of `=>`
  return cond(
    (handle.is_fn_call()) => {
      callee :: handle.get_callee();
      cond(
        (callee.is_atom() && (callee == quote(=>))) => {
          args :: handle.get_args();
          comptime_assert(args.len() == 2, "'for' macro requires 2 arguments in the function handle");
          variable :: args.car();
          body :: args.cdr().car();

          iter_var :: gensym("for_iter_var");
          temp_var :: gensym("for_temp_var");
          quote({
            unquote(iter_var) := unquote(iter);
            while runtime(true), {
              unquote(temp_var) := &(unquote(iter_var)).next();
              match(unquote(temp_var),
                .Some(unquote(variable)) => unquote(body),
                .None => { break; }
              )
            };
          })
        },
        true => {
          comptime_assert(false, "for macro requires a function handle with `=>`");
          quote(false)
        }
      )
    },
    true => {
      comptime_assert(false, "for macro requires a function handle with `=>`");
      quote(false)
    });
};
export for;
