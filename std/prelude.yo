/// === Traits ===
Send :: trait(
  id := "Send"
);
export Send;

/// Acyclic trait - indicates a type that cannot form reference cycles.
/// Types that implement Acyclic don't need cycle collection tracking.
/// Primitive types, value types without object fields, and objects that
/// don't reference back to themselves (directly or indirectly) are Acyclic.
Acyclic :: trait(
  id := "Acyclic"
);
export Acyclic;

/// The Rc trait means the type is reference counted `object` type.
Rc :: trait(
  id := "Rc"
);
export Rc;

/// Dispose trait - defines a dispose method for cleaning up resources.
Dispose :: trait(
  id := "Dispose",
  dispose : (fn(self: Self) -> unit),
  where(Self <: Rc)
);
export Dispose;

/// === Arithmetic ===
Add :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (+)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Add;

ComptimeAdd :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    Output := Output,
    (+)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeAdd;

Sub :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (-)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Sub;

ComptimeSub :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    Output := Output,
    (-)    : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeSub;

Mul :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (*)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Mul;

ComptimeMul :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    Output := Output,
    (*)    : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeMul;

Div :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (/)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Div;

ComptimeDiv :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    Output := Output,
    (/)    : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeDiv;

Mod :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (%)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Mod;

ComptimeMod :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    Output := Output,
    (%)    : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeMod;

BitLeftShift :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (<<)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitLeftShift;

ComptimeBitLeftShift :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    Output := Output,
    (<<)   : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeBitLeftShift;

BitRightShift :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (>>)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitRightShift;

ComptimeBitRightShift :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    Output := Output,
    (>>)   : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeBitRightShift;

Exponentiation :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (**)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Exponentiation;

ComptimeExponentiation :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    Output := Output,
    (**)   : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeExponentiation;

Negate :: (fn(comptime(Output) : Type)-> comptime(Trait)) 
  trait
    Output := Output,
    (neg): (fn(self: Self)-> Output)
;
export Negate;

ComptimeNegate :: (fn(comptime(Output) : Type, where(Output <: Comptime))-> comptime(Trait)) 
  trait(
    Output := Output,
    (neg) : (fn(comptime(self): Self)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeNegate;

/// === Logic ===
LogicalNot :: trait
  (!)  : (fn(self: Self)-> bool)
;
export LogicalNot;

ComptimeLogicalNot :: trait
  (!)  : (fn(comptime(self): Self) -> comptime(bool)),
  where(Self <: Comptime)
;
export ComptimeLogicalNot;

BitNot :: (fn(comptime(Output) : Type) -> comptime(Trait))
  trait
    Output := Output,
    (~)    :  (fn(self: Self)-> Output)
;
export BitNot;

ComptimeBitNot :: (fn(comptime(Output) : Type, where(Output <: Comptime)) -> comptime(Trait))
  trait(
    Output := Output,
    (~)    :  (fn(comptime(self): Self)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeBitNot;

BitAnd :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs) -> comptime(Trait)) 
  trait
    Output := Output,
    (&)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitAnd;

ComptimeBitAnd :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime)) -> comptime(Trait)) 
  trait(
    Output := Output,
    (&)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeBitAnd;

BitOr :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs) -> comptime(Trait))
  trait
    Output := Output,
    (|)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitOr;

ComptimeBitOr :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime)) -> comptime(Trait))
  trait(
    Output := Output,
    (|)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeBitOr;

BitXor :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs) -> comptime(Trait)) 
  trait
    Output := Output,
    (^)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitXor;

ComptimeBitXor :: (fn(comptime(Rhs) : Type, (comptime(Output) : Type) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime)) -> comptime(Trait)) 
  trait(
    Output := Output,
    (^)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output)),
    where(Self <: Comptime)
  )
;
export ComptimeBitXor;

(!) :: impl {
  (not) :: (fn(forall(_Self : Type),
            self : _Self,
            where(_Self <: LogicalNot)
          ) -> bool)
    self.(!)()
  ;

  (comptime_not) :: (fn(forall(_Self : Type),
          comptime(self) : _Self,
          where(_Self <: (Comptime, ComptimeLogicalNot))
        ) -> comptime(bool))
    self.(!)()
  ;

  Call :: (not, comptime_not);

  export
    Call
  ;
};
(not) :: (!);
export not, (!);

(-) :: impl {
  (neg) :: (fn(forall(_Self : Type),
            self : _Self,
            where(_Self <: Negate(_Self))
          ) -> _Self) {
    return self.neg();
  };

  (comptime_neg) :: (fn(forall(_Self : Type), 
          comptime(self) : _Self,
          where(_Self <: (Comptime, ComptimeNegate(_Self)))
        ) -> comptime(_Self)) {
    return self.neg();
  };

  Call :: (neg, comptime_neg);

  export
    Call
  ;
};
export (-);

/**
 * logic for bool
 * No need to export them. For internal use only
 */
impl(bool, Comptime());
impl(bool, Runtime());
impl(bool, LogicalNot(
  (!): ((self) ->
    __yo_op_not(self)
  )
));
impl(bool, ComptimeLogicalNot(
  (!) : (self ->
    __yo_comptime_bool_not(self)
  )
));

/// === Eq ===
Eq ::
  (fn(comptime(Rhs) : Type) -> comptime(Trait))
  trait(
    (==) : (fn(lhs: Self, rhs: Rhs) -> bool),

    ((!=) : (fn(lhs: Self, rhs: Rhs) -> bool)) ?= 
      ((lhs, rhs) ->
        not(Self.(==)(lhs, rhs))
      )
  );
export Eq;

ComptimeEq ::
  (fn(comptime(Rhs) : Type, where(Rhs <: Comptime)) -> comptime(Trait))
  trait(
    (==) : (fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool)),

    ((!=) : (fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool))) ?= 
      ((lhs, rhs) ->
        not(Self.(==)(lhs, rhs))
      ),
    
    where(Self <: Comptime)
  )
;
export ComptimeEq;

/// === Ord ===
Ordering :: enum(
  Less,
  Equal,
  Greater
);
export Ordering;

Ord :: (
  fn(
    comptime(Rhs) : Type
  ) -> comptime(Trait))
  trait(
    (<) :
      fn(lhs: Self, rhs: Rhs) -> bool,
    (<=) :
      fn(lhs: Self, rhs: Rhs) -> bool,
    (>) :
      fn(lhs: Self, rhs: Rhs) -> bool,
    (>=) :
      fn(lhs: Self, rhs: Rhs) -> bool,
    where(Self <: Eq(Rhs))
  )
;
export Ord;

ComptimeOrd :: (
  fn(
    comptime(Rhs) : Type,
    where(Rhs <: Comptime)
  ) -> comptime(Trait))
  trait(
    (<) :
      fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool),
    (<=) :
      fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool),
    (>) :
      fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool),
    (>=) :
      fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool),
    where(Self <: (Comptime, ComptimeEq(Rhs)))
  )
;

/**
 * Hash trait - Similar to Rust's std::hash::Hash
 * 
 * This trait defines the ability to hash a value into a u64.
 * Types that implement Hash can be used as keys in HashMap and HashSet.
 * 
 * The hash function should satisfy:
 * 1. Deterministic: The same value always produces the same hash
 * 2. Consistent with Eq: If a == b, then hash(a) == hash(b)
 * 
 * Note: Unlike Rust which uses a Hasher trait for incremental hashing,
 * we use a simpler approach where each type directly produces a u64 hash.
 */
Hash :: trait(
  /**
    * Compute the hash of a value
    * Returns a u64 hash value
    */
  (hash): (fn(self : *(Self)) -> u64)
);
export
  Hash
;

// === Clone ===
Clone :: trait(
  clone : 
    fn(self: *(Self)) -> Self
);

// === Isolation ===
Isolation :: trait(
  can_isolate : (fn(self : Self) -> bool)
);
export Isolation;

// === ToComptimeString ===
ComptimeToString :: trait(
  to_comptime_string : (fn(comptime(self) : Self) -> comptime(comptime_string)),
  where(Self <: Comptime)
);

// === Builtin types ===
/// unit
impl(unit, Acyclic());
impl(unit, Comptime());
impl(unit, Runtime());
impl(unit, Send());

/// void
impl(void, Acyclic());
impl(void, Runtime());
impl(void, Send());

/// comptime_int
impl(comptime_int, Acyclic());
impl(comptime_int, Comptime());
impl(comptime_int, ComptimeAdd(comptime_int)(
  (+) : ((lhs, rhs) ->
    __yo_comptime_int_add(lhs, rhs)
  )
));
impl(comptime_int, ComptimeSub(comptime_int)(
  (-) : ((lhs, rhs) ->
    __yo_comptime_int_sub(lhs, rhs)
  )
));
impl(comptime_int, ComptimeMul(comptime_int)(
  (*) : ((lhs, rhs) ->
    __yo_comptime_int_mul(lhs, rhs)
  )
));
impl(comptime_int, ComptimeDiv(comptime_int)(
  (/) : ((lhs, rhs) ->
    __yo_comptime_int_div(lhs, rhs)
  )
));
impl(comptime_int, ComptimeMod(comptime_int)(
  (%) : ((lhs, rhs) ->
    __yo_comptime_int_mod(lhs, rhs)
  )
));
impl(comptime_int, ComptimeNegate(comptime_int)(
  (neg) : (self ->
    __yo_comptime_int_neg(self)
  )
));
impl(comptime_int, ComptimeEq(comptime_int)(
  (==) : ((lhs, rhs) ->
    __yo_comptime_int_eq(lhs, rhs)
  ),
  (!=) : ((lhs, rhs) ->
    __yo_comptime_int_neq(lhs, rhs)
  )
));
impl(comptime_int, ComptimeOrd(comptime_int)(
  (<) : ((lhs, rhs) ->
    __yo_comptime_int_lt(lhs, rhs)
  ),
  (<=) : ((lhs, rhs) ->
    __yo_comptime_int_lte(lhs, rhs)
  ),
  (>) : ((lhs, rhs) ->
    __yo_comptime_int_gt(lhs, rhs)
  ),
  (>=) : ((lhs, rhs) ->
    __yo_comptime_int_gte(lhs, rhs)
  )
));
impl(comptime_int, ComptimeToString(
  (to_comptime_string) : (self ->
    __yo_comptime_int_to_comptime_string(self)
  )
));
_comptime_int :: comptime_int;
export comptime_int : _comptime_int;

