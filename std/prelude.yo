/// Ptr
// SAFETY: A raw pointer *(T) is Send only when the pointee T is Send —
// the pointer itself is a plain value (an address), and Send implies
// that any T reachable through it is safe to access from another thread.
// *(T) is unconditionally Acyclic because raw pointers do not participate
// in Yo's ARC reference-counting cycle analysis.
impl(generic(T : Type), where(T <: Send), *(T), Send());
impl(generic(T : Type), *(T), Acyclic());
impl(generic(T : Type), where(T <: Comptime), *(T), Comptime());
impl(generic(T : Type), where(T <: Runtime), *(T), Runtime());
/*
// NOTE: Below should give error, as C disallows pointer arithmetic on void pointers.
impl(*(void), Add(usize)(
  Output : *(void),
  (+) : ((lhs, rhs) -> __yo_ptr_add(lhs, rhs))
));
impl(*(void), Sub(usize)(
  Output : *(void),
  (-) : ((lhs, rhs) -> __yo_ptr_sub(lhs, rhs))
));
impl(*(void), Eq(*(void))(
  (==) : ((lhs, rhs) -> __yo_ptr_eq(lhs, rhs)),
  (!=) : ((lhs, rhs) -> __yo_ptr_neq(lhs, rhs))
));
impl(*(void), Div(*(void))(
  Output : isize,
  (/) : ((lhs, rhs) -> __yo_ptr_diff(lhs, rhs))
));
impl(*(void), Ord(*(void))(
  (<) : ((lhs, rhs) -> __yo_ptr_lt(lhs, rhs)),
  (<=) : ((lhs, rhs) -> __yo_ptr_lte(lhs, rhs)),
  (>) : ((lhs, rhs) -> __yo_ptr_gt(lhs, rhs)),
  (>=) : ((lhs, rhs) -> __yo_ptr_gte(lhs, rhs))
));
*/
// Pointer operations, Rust-style (plans/archive/POINTER_OPERATORS_TO_TRAITS_AND_METHODS.md):
// comparison is plain Eq/Ord (address identity — same as C and Rust's raw
// pointers; note ref-semantics OBJECT types keep VALUE equality via their
// own Eq impls), arithmetic is explicit METHODS so offsetting stays
// typographically loud inside unsafe(...) blocks. The former `&`-prefixed
// operator family (`&==`, `&+`, `&/`, …) is retired.
impl(
  generic(T : Type),
  *(T),
  /// Offset forward by `count` elements (formerly `p &+ count`).
  add : (fn(self : Self, count : usize) -> Self)(
    __yo_ptr_add(self, count)
  ),
  /// Offset backward by `count` elements (formerly `p &- count`).
  sub : (fn(self : Self, count : usize) -> Self)(
    __yo_ptr_sub(self, count)
  ),
  /// Signed element distance from `origin` to `self` (formerly `self &/ origin`).
  /// Both pointers must point into the same allocation.
  offset_from : (fn(self : Self, origin : Self) -> isize)(
    __yo_ptr_diff(self, origin)
  )
);
impl(
  generic(T : Type),
  *(T),
  Eq(*(T))(
    (==) : (fn(lhs : Self, rhs : *(T)) -> bool)(
      __yo_ptr_eq(lhs, rhs)
    ),
    (!=) : (fn(lhs : Self, rhs : *(T)) -> bool)(
      __yo_ptr_neq(lhs, rhs)
    )
  )
);
impl(
  generic(T : Type),
  *(T),
  Ord(*(T))(
    (<) : (fn(lhs : Self, rhs : *(T)) -> bool)(
      __yo_ptr_lt(lhs, rhs)
    ),
    (<=) : (fn(lhs : Self, rhs : *(T)) -> bool)(
      __yo_ptr_lte(lhs, rhs)
    ),
    (>) : (fn(lhs : Self, rhs : *(T)) -> bool)(
      __yo_ptr_gt(lhs, rhs)
    ),
    (>=) : (fn(lhs : Self, rhs : *(T)) -> bool)(
      __yo_ptr_gte(lhs, rhs)
    )
  )
);
/// Array
// SAFETY: Array(T, U) is a fixed-size array value type. It is Send when T
// is Send because an array value is copied across threads (each thread
// gets an independent copy). It is unconditionally Acyclic because arrays
// are value-typed — they do not participate in ARC reference counting.
impl(generic(T : Type, U : usize), where(T <: Send), Array(T, U), Send());
impl(generic(T : Type, U : usize), Array(T, U), Acyclic());
impl(generic(T : Type, U : usize), where(T <: Comptime), Array(T, U), Comptime());
impl(generic(T : Type, U : usize), where(T <: Runtime), Array(T, U), Runtime());
impl(
  generic(T : Type, U : usize),
  Array(T, U),
  len : (fn(inout(self) : Self) -> usize)({
    return(U);
  })
  /*
  // NOTE: Macro doesn't work yet.
  fill :: (fn(quote(val) : Expr) -> unquote(Expr)) {
    return quote(
      __yo_array_fill(Self, unquote(val))
    );
  };
  export fill;
  */
);
impl(
  generic(T : Type, U : usize),
  where(T <: Comptime),
  Array(T, U),
  fill : (fn(comptime(val) : T) -> comptime(Self))({
    return(__yo_array_fill(Self, val));
  })
);
/// Array Index impls
/// Bodies take `&(self)` so the `*(Array(T, N))`-expecting builtin
/// receives the right C-ABI shape — `inout(self) : Self` gives the body
/// a value-typed view of `self` even though the runtime passes a
/// pointer. See plans/archive/ITERATOR_REDESIGN.md.
impl(
  generic(T : Type, N : usize),
  Array(T, N),
  Index(usize)(
    Output : T,
    index : (fn(inout(self) : Self, idx : usize) -> *(Self.Output))(
      __yo_array_index(&(self), idx)
    )
  )
);
/// RawSlice — a plain ptr+len pair for PRIVILEGED (pragma'd) code: C
/// interop and std internals. Carries a raw pointer, so the existing
/// raw-pointer gates apply: safe code cannot name or construct it.
/// Replaces the builtin Slice(T) for internal plumbing
/// (plans/archive/SLICE_REWORK.md step 4).
RawSlice :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(ptr : *(T), len : usize)
);
export(RawSlice);
// array. Sending a slice across threads copies the header; both threads
// can independently read the backing array. The backing array's lifetime
// is managed by its owning collection (which must itself be Send to cross
// threads). Slice is always Acyclic — it is a value type with no ARC.
/// Array ComptimeIndex impls
impl(
  generic(T : Type, N : usize),
  where(T <: Comptime),
  Array(T, N),
  ComptimeIndex(usize)(
    Output : T,
    index : (fn(comptime(inout(self)) : Self, comptime(idx) : usize) -> comptime(*(Self.Output)))(
      __yo_comptime_array_index(self, idx)
    )
  )
);
/// comptime_str ComptimeIndex impls
impl(
  comptime_str,
  ComptimeIndex(comptime_int)(
    Output : comptime_str,
    index : (
      (self, idx) ->
        __yo_comptime_string_index(self, idx)
    )
  )
);
impl(
  comptime_str,
  ComptimeIndex(Range(comptime_int))(
    Output : comptime_str,
    index : (
      (self, idx) ->
        __yo_comptime_string_index_range(self, idx)
    )
  )
);
impl(
  comptime_str,
  ComptimeIndex(RangeInclusive(comptime_int))(
    Output : comptime_str,
    index : (
      (self, idx) ->
        __yo_comptime_string_index_range_inclusive(self, idx)
    )
  )
);
/// `str` — the BUILTIN immutable view of STATIC string bytes (TypeTag.Str,
/// a fat pointer `{ const uint8_t* ptr; size_t len; }` in C).
///
/// String literals `"hello"` and template-literal segments produce `str`
/// at runtime; the backing bytes live in static storage (immortal), so a
/// `str` is freely copyable and storable with no lifetime constraints.
/// For heap-allocated growable strings, see `String`.
impl(
  str,
  /// Construct a `str` from a raw pointer and length.
  /// SAFETY: callers must guarantee the bytes outlive every use of the
  /// view — the safe surface only ever does this with static storage.
  from_raw_parts : (fn(ptr : *(u8), length : usize) -> Self)(
    __yo_str_from_raw_parts(ptr, length)
  ),
  /// Return the length in bytes.
  len : (fn(self : Self) -> usize)(
    __yo_str_len(self)
  ),
  ptr : (fn(self : Self) -> *(u8))(
    __yo_str_ptr(self)
  ),
  /// Return the byte at `idx` (bounds are the caller's responsibility,
  /// mirroring slice indexing).
  bytes : (fn(self : Self, idx : usize) -> u8)(
    __yo_str_byte(self, idx)
  )
);
/// Range slicing on `str` stays a ZERO-COPY `str` — a window of static
/// bytes is still static (byte indices). `s(a..b)` lowers to this.
impl(
  str,
  slice_copy : (fn(self : Self, r : Range(usize)) -> Self)({
    e := cond((r.end > __yo_str_len(self)) => __yo_str_len(self), true => r.end);
    st := cond((r.start > e) => e, true => r.start);
    __yo_str_from_raw_parts(__yo_str_ptr(self).add(st), e - st)
  }),
  slice_copy_inclusive : (fn(self : Self, r : RangeInclusive(usize)) -> Self)({
    e := cond(((r.end + usize(1)) > __yo_str_len(self)) => __yo_str_len(self), true => (r.end + usize(1)));
    st := cond((r.start > e) => e, true => r.start);
    __yo_str_from_raw_parts(__yo_str_ptr(self).add(st), e - st)
  })
);
impl(
  str,
  Eq(str)(
    (==) : (fn(lhs : Self, rhs : Self) -> bool)({
      lhs_len := lhs.len();
      cond(
        (lhs_len != rhs.len()) => {
          return(false);
        },
        true => ()
      );
      i := usize(0);
      while(i < lhs_len, i = (i + usize(1)), {
        cond(
          (lhs.bytes(i) != rhs.bytes(i)) => {
            return(false);
          },
          true => ()
        );
      });
      true
    }),
    (!=) : (fn(lhs : Self, rhs : Self) -> bool)({
      return(!(Self.(==)(lhs, rhs)));
    })
  )
);
impl(
  str,
  Ord(str)(
    (<) : (fn(lhs : Self, rhs : Self) -> bool)({
      lhs_len := lhs.len();
      rhs_len := rhs.len();
      min_len := cond((lhs_len < rhs_len) => lhs_len, true => rhs_len);
      i := usize(0);
      while(i < min_len, i = (i + usize(1)), {
        cond(
          (lhs.bytes(i) < rhs.bytes(i)) => {
            return(true);
          },
          (lhs.bytes(i) > rhs.bytes(i)) => {
            return(false);
          },
          true => ()
        );
      });
      lhs_len < rhs_len
    }),
    (<=) : (fn(lhs : Self, rhs : Self) -> bool)({
      return(!(rhs < lhs));
    }),
    (>) : (fn(lhs : Self, rhs : Self) -> bool)({
      return(rhs < lhs);
    }),
    (>=) : (fn(lhs : Self, rhs : Self) -> bool)({
      return(!(lhs < rhs));
    })
  )
);
// (str is a builtin type — no export needed; the identifier resolves
// everywhere like bool/i32.)
// (`assert`/`panic` are NOT ambient: import them explicitly from
// `std/assert`. The prelude itself never imports other modules.)
