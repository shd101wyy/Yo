/// === Traits ===
Send :: trait(
  id := "Send"
);
export Send;

/// Acyclic trait - indicates a type that cannot form reference cycles.
/// Types that implement Acyclic don't need cycle collection tracking.
/// Primitive types, value types without object fields, and objects that
/// don't reference back to themselves (directly or indirectly) are Acyclic.
Acyclic :: trait(
  id := "Acyclic"
);
export Acyclic;

/// === Arithmetic ===
Add :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (+)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Add;

ComptAdd :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (+)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptAdd;

Sub :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (-)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Sub;

ComptSub :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (-)    : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptSub;

Mul :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (*)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Mul;

ComptMul :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (*)    : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptMul;

Div :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (/)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Div;

ComptDiv :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (/)    : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptDiv;

Mod :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (%)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Mod;

ComptMod :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (%)    : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptMod;

BitLeftShift :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (<<)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitLeftShift;

ComptBitLeftShift :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (<<)   : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptBitLeftShift;

BitRightShift :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (>>)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitRightShift;

ComptBitRightShift :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (>>)   : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptBitRightShift;

Exponentiation :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (**)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;
export Exponentiation;

ComptExponentiation :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs)-> comptime(Trait))
  trait
    Output := Output,
    (**)   : (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptExponentiation;

Negate :: (fn(comptime(Output) : Type)-> comptime(Trait)) 
  trait
    Output := Output,
    (neg): (fn(self: Self)-> Output)
;
export Negate;

ComptNegate :: (fn(comptime(Output) : Type)-> comptime(Trait)) 
  trait
    Output := Output,
    (neg) : (fn(comptime(self): Self)-> comptime(Output))
;
export ComptNegate;

/// === Logic ===
LogicalNot :: trait
  (!)  : (fn(self: Self)-> bool)
;
export LogicalNot;

ComptLogicalNot :: trait
  (!)  : (fn(comptime(self): Self) -> comptime(bool))
;
export ComptLogicalNot;

BitNot :: (fn(comptime(Output) : Type) -> comptime(Trait))
  trait
    Output := Output,
    (~)    :  (fn(self: Self)-> Output)
;
export BitNot;

ComptBitNot :: (fn(comptime(Output) : Type) -> comptime(Trait))
  trait
    Output := Output,
    (~)    :  (fn(comptime(self): Self)-> comptime(Output))
;
export ComptBitNot;

BitAnd :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs) -> comptime(Trait)) 
  trait
    Output := Output,
    (&)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitAnd;

ComptBitAnd :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs) -> comptime(Trait)) 
  trait
    Output := Output,
    (&)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptBitAnd;

BitOr :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs) -> comptime(Trait))
  trait
    Output := Output,
    (|)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitOr;

ComptBitOr :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs) -> comptime(Trait))
  trait
    Output := Output,
    (|)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptBitOr;

BitXor :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs) -> comptime(Trait)) 
  trait
    Output := Output,
    (^)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;
export BitXor;

ComptBitXor :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs) -> comptime(Trait)) 
  trait
    Output := Output,
    (^)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
;
export ComptBitXor;

(!) :: impl {
  (not) :: (fn(forall(_Self : Type),
            self : _Self,
            where(_Self <: LogicalNot)
          ) -> bool)
    self.(!)()
  ;

  (compt_not) :: (fn(forall(_Self : Type), 
          comptime(self) : _Self,
          where(_Self <: ComptLogicalNot)
        ) -> comptime(bool))
    self.(!)()
  ;

  Call :: (not, compt_not);

  export
    Call,
    not,
    compt_not
  ;
};
(not) :: (!);
export not, (!);

(-) :: impl {
  (neg) :: (fn(forall(_Self : Type),
            self : _Self,
            where(_Self <: Negate(_Self))
          ) -> _Self) {
    return self.neg();
  };

  (compt_neg) :: (fn(forall(_Self : Type), 
          comptime(self) : _Self,
          where(_Self <: ComptNegate(_Self))
        ) -> comptime(_Self)) {
    return self.neg();
  };

  Call :: (neg, compt_neg);

  export
    Call,
    neg,
    compt_neg
  ;
};
export (-);

/**
 * logic for bool
 * No need to export them. For internal use only
 */
impl(bool, LogicalNot(
  (!): ((a) ->
    __yo_op_not(a)
  )
));
impl(bool, ComptLogicalNot(
  (!) : (fn(comptime(self): bool) -> comptime(bool))(
    __yo_comptime_bool_not(self)
  )
));

/// === Eq ===
Eq ::
  (fn(comptime(Rhs) : Type) -> comptime(Trait))
  trait(
    (==) : (fn(lhs: Self, rhs: Rhs) -> bool),

    ((!=) : (fn(lhs: Self, rhs: Rhs) -> bool)) ?= 
      ((lhs, rhs) ->
        not(Self.(==)(lhs, rhs))
      )
  );
export Eq;

ComptEq ::
  (fn(comptime(Rhs) : Type) -> comptime(Trait))
  trait(
    (==) : (fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool)),

    ((!=) : (fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool))) ?= 
      ((lhs, rhs) ->
        not(Self.(==)(lhs, rhs))
      )
  )
;
export ComptEq;

/// === Ord ===
Ordering :: enum
  Less,
  Equal,
  Greater
;
export Ordering;

Ord :: (
  fn(
    comptime(Rhs) : Type
  ) -> comptime(Trait))
  trait(
    where(Self <: Eq(Rhs)),

    (<) :
      fn(lhs: Self, rhs: Rhs) -> bool,
    (<=) :
      fn(lhs: Self, rhs: Rhs) -> bool,
    (>) :
      fn(lhs: Self, rhs: Rhs) -> bool,
    (>=) :
      fn(lhs: Self, rhs: Rhs) -> bool
  )
;
export Ord;

ComptOrd :: (
  fn(
    comptime(Rhs) : Type
  ) -> comptime(Trait))
  trait(
    where(Self <: ComptEq(Rhs)),

    (<) :
      fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool),
    (<=) :
      fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool),
    (>) :
      fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool),
    (>=) :
      fn(comptime(lhs): Self, comptime(rhs): Rhs) -> comptime(bool)
  )
;

/**
 * Hash trait - Similar to Rust's std::hash::Hash
 * 
 * This trait defines the ability to hash a value into a u64.
 * Types that implement Hash can be used as keys in HashMap and HashSet.
 * 
 * The hash function should satisfy:
 * 1. Deterministic: The same value always produces the same hash
 * 2. Consistent with Eq: If a == b, then hash(a) == hash(b)
 * 
 * Note: Unlike Rust which uses a Hasher trait for incremental hashing,
 * we use a simpler approach where each type directly produces a u64 hash.
 */
Hash :: trait(
  /**
    * Compute the hash of a value
    * Returns a u64 hash value
    */
  (hash): (fn(self : *(Self)) -> u64)
);
export
  Hash
;

// === Clone ===
Clone :: trait(
  clone : 
    fn(self: *(Self)) -> Self
);

// === Isolation ===
Isolation :: trait(
  can_isolate : (fn(self : Self) -> bool)
);
export Isolation;

// === ToComptimeString ===
ComptToString :: trait(
  to_comptime_string : (fn(comptime(self) : Self) -> comptime(comptime_string))
);

// === Builtin types ===
/// comptime_int
impl(comptime_int, ComptAdd(comptime_int)(
  (+) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(comptime_int))(
    __yo_comptime_int_add(lhs, rhs)
  )
));
impl(comptime_int, ComptSub(comptime_int)(
  (-) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(comptime_int))(
    __yo_comptime_int_sub(lhs, rhs)
  )
));
impl(comptime_int, ComptMul(comptime_int)(
  (*) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(comptime_int))(
    __yo_comptime_int_mul(lhs, rhs)
  )
));
impl(comptime_int, ComptDiv(comptime_int)(
  (/) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(comptime_int))(
    __yo_comptime_int_div(lhs, rhs)
  )
));
impl(comptime_int, ComptMod(comptime_int)(
  (%) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(comptime_int))(
    __yo_comptime_int_mod(lhs, rhs)
  )
));
impl(comptime_int, ComptNegate(comptime_int)(
  (neg) : (fn(comptime(self): comptime_int) -> comptime(comptime_int))(
    __yo_comptime_int_neg(self)
  )
));
impl(comptime_int, ComptEq(comptime_int)(
  (==) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(bool))(
    __yo_comptime_int_eq(lhs, rhs)
  ),
  (!=) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(bool))(
    __yo_comptime_int_neq(lhs, rhs)
  )
));
impl(comptime_int, ComptOrd(comptime_int)(
  (<) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(bool))(
    __yo_comptime_int_lt(lhs, rhs)
  ),
  (<=) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(bool))(
    __yo_comptime_int_lte(lhs, rhs)
  ),
  (>) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(bool))(
    __yo_comptime_int_gt(lhs, rhs)
  ),
  (>=) : (fn(comptime(lhs): comptime_int, comptime(rhs): comptime_int) -> comptime(bool))(
    __yo_comptime_int_gte(lhs, rhs)
  )
));
impl(comptime_int, ComptToString(
  (to_comptime_string) : (self ->
    __yo_comptime_int_to_comptime_string(self)
  )
));
_comptime_int :: comptime_int;
export comptime_int : _comptime_int;

