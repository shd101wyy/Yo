//! Glob pattern matching for file paths.
open(import("./string"));
{ ArrayList } :: import("./collections/array_list");
// Recursive byte-level glob pattern matching
_glob_match_impl :: (fn(pb : ArrayList(u8), pi : usize, tb : ArrayList(u8), ti : usize) -> bool)({
  // Base: both pattern and text consumed
  cond(
    ((pi == pb.len()) && (ti == tb.len())) => {
      return(true);
    },
    true => ()
  );
  // Pattern consumed but text remains
  cond(
    (pi == pb.len()) => {
      return(false);
    },
    true => ()
  );
  p := pb(pi);
  // Handle * and **
  cond(
    (p == u8(42)) => {
      is_dbl := cond(
        ((pi + usize(1)) < pb.len()) => (pb(pi + usize(1)) == u8(42)),
        true => false
      );
      cond(
        is_dbl => {
          // ** matches any characters including /
          npi := (pi + usize(2));
          // Skip optional trailing /
          cond(
            (npi < pb.len()) => {
              cond(
                (pb(npi) == u8(47)) => {
                  npi = (npi + usize(1));
                },
                true => ()
              );
            },
            true => ()
          );
          // Try ** matching nothing
          cond(
            recur(pb, npi, tb, ti) => {
              return(true);
            },
            true => ()
          );
          // Try ** consuming one char
          cond(
            (ti < tb.len()) => {
              return(recur(pb, pi, tb, ti + usize(1)));
            },
            true => {
              return(false);
            }
          );
        },
        true => {
          // Single * matches any except /
          // Try * matching nothing
          cond(
            recur(pb, pi + usize(1), tb, ti) => {
              return(true);
            },
            true => ()
          );
          // Try * consuming one non-/ char
          cond(
            (ti < tb.len()) => {
              tc := tb(ti);
              cond(
                (tc != u8(47)) => {
                  return(recur(pb, pi, tb, ti + usize(1)));
                },
                true => {
                  return(false);
                }
              );
            },
            true => {
              return(false);
            }
          );
        }
      );
    },
    true => ()
  );
  // Text consumed but non-star pattern remains
  cond(
    (ti == tb.len()) => {
      return(false);
    },
    true => ()
  );
  t := tb(ti);
  // Handle ?
  cond(
    (p == u8(63)) => {
      cond(
        (t != u8(47)) => {
          return(recur(pb, pi + usize(1), tb, ti + usize(1)));
        },
        true => {
          return(false);
        }
      );
    },
    true => ()
  );
  // Handle [...]
  cond(
    (p == u8(91)) => {
      ci := (pi + usize(1));
      neg := false;
      // Check for negation: ! or ^
      cond(
        (ci < pb.len()) => {
          nc := pb(ci);
          cond(
            ((nc == u8(33)) || (nc == u8(94))) => {
              neg = true;
              ci = (ci + usize(1));
            },
            true => ()
          );
        },
        true => ()
      );
      // Scan characters in class until ]
      found := false;
      cdone := false;
      while((ci < pb.len()) && !cdone, ci = (ci + usize(1)), {
        ch := pb(ci);
        cond(
          (ch == u8(93)) => {
            cdone = true;
          },
          true => {
            cond(
              (ch == t) => {
                found = true;
              },
              true => ()
            );
          }
        );
      });
      // Malformed pattern (no closing ])
      cond(
        !cdone => {
          return(false);
        },
        true => ()
      );
      matched := cond(
        neg => !found,
        true => found
      );
      cond(
        matched => {
          return(recur(pb, ci, tb, ti + usize(1)));
        },
        true => {
          return(false);
        }
      );
    },
    true => ()
  );
  // Literal byte match
  cond(
    (p == t) => recur(pb, pi + usize(1), tb, ti + usize(1)),
    true => false
  )
});
glob_match :: (fn(pattern : String, text : String) -> bool)(
  _glob_match_impl(pattern.as_bytes(), usize(0), text.as_bytes(), usize(0))
);
/// Compiled glob pattern that can be matched against strings.
GlobPattern :: ref(
  struct(
    _pattern : String
  )
);
impl(
  GlobPattern,
  new : (fn(pattern : String) -> Self)(
    Self(_pattern : pattern)
  ),
  matches : (fn(self : Self, text : String) -> bool)(
    _glob_match_impl(self._pattern.as_bytes(), usize(0), text.as_bytes(), usize(0))
  )
);
export(glob_match, GlobPattern);
