// --- derive_rule for Debug ---
// Local helpers (not exported from prelude, so defined locally)
__ts_s2 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str) -> comptime(comptime_str))(a + b);
__ts_s3 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str) -> comptime(comptime_str))(
  a + b + c
);
__ts_s4 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str, comptime(d) : comptime_str) -> comptime(comptime_str))(
  a + b + c + d
);
__ts_s5 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str, comptime(d) : comptime_str, comptime(e) : comptime_str) -> comptime(comptime_str))(
  a + b + c + d + e
);
__ts_fold_range :: (
  fn(
    comptime(n) : usize,
    comptime(init) : comptime_str,
    comptime(f) : (fn(comptime(acc) : comptime_str, comptime(i) : usize) -> comptime(comptime_str))
  ) -> comptime(comptime_str)
)(
  cond(
    (n == usize(0)) => init,
    (n == usize(1)) => f(init, usize(0)),
    true => f(recur(n - usize(1), init, f), n - usize(1))
  )
);
/// The `debug_fmt` body `derive(Debug)` emits, as comptime source:
/// `TypeName(field1, field2, …)` for a struct, `TypeName.Variant(…)` for an
/// enum, each field written through its own `Debug`.
///
/// INVARIANT — the emitted source must contain NO free identifier.
/// The caller splices it through `.to_expr()`, which re-parses it, so every
/// name in it resolves in the DERIVING file's scope, not in this module's.
/// The body therefore calls only methods (`f.write_str`, each field's own
/// `debug_fmt(f)`), with `str` literals, all resolved by type,
/// never by scope (issues/fixed/derive-tostring-debug-body-is-unhygienic-and-aborts.md).
/// `self`, `f`, the `__v_*` arm bindings and the `.`-prefixed variant tags are
/// the only other names, and all are bound at the splice site.
/// Regression test: tests/cli-cases/derive-render-without-string-import.
__derive_debug_body :: (fn(comptime(T) : Type) -> comptime(comptime_str))({
  type_name :: Type.to_comptime_string(T);
  info :: Type.get_info(T);
  cond(
    info.is_struct() => {
      fields :: Type.get_struct_fields(T);
      cond(
        (fields.len() == 0) => __ts_s3("f.write_str(\"", type_name, "()\")"),
        true => {
          body :: __ts_fold_range(
            fields.len(),
            __ts_s3("{ f.write_str(\"", type_name, "(\");"),
            (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
              fname :: fields.get(fi).name;
              with_sep :: cond(
                (fi == 0) => a,
                true => __ts_s2(a, " f.write_str(\", \");")
              );
              __ts_s4(with_sep, " self.", fname, ".debug_fmt(f);")
            })
          );
          __ts_s2(body, " f.write_str(\")\") }")
        }
      )
    },
    info.is_enum() => {
      variants :: Type.get_enum_variants(T);
      vc :: variants.len();
      branches :: __ts_fold_range(
        vc,
        "",
        (fn(comptime(acc) : comptime_str, comptime(vi) : usize) -> comptime(comptime_str))({
          v :: variants.get(vi);
          branch :: cond(
            (v.fields.len() == 0) =>
              __ts_s5(".", v.name, " => f.write_str(\"", type_name, __ts_s3(".", v.name, "\")")),
            true => {
              bindings :: __ts_fold_range(
                v.fields.len(),
                "",
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  cond(
                    (a == "") => __ts_s2("__v_", fname),
                    true => __ts_s3(a, ", __v_", fname)
                  )
                })
              );
              body :: __ts_fold_range(
                v.fields.len(),
                __ts_s5("{ f.write_str(\"", type_name, ".", v.name, "(\");"),
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  with_sep :: cond(
                    (fi == 0) => a,
                    true => __ts_s2(a, " f.write_str(\", \");")
                  );
                  __ts_s4(with_sep, " __v_", fname, ".debug_fmt(f);")
                })
              );
              full_body :: __ts_s2(body, " f.write_str(\")\") }");
              __ts_s4(".", v.name, __ts_s3("(", bindings, ") => "), full_body)
            }
          );
          cond(
            (acc == "") => branch,
            true => __ts_s3(acc, ",\n    ", branch)
          )
        })
      );
      __ts_s3("match(self,\n    ", branches, "\n  )")
    },
    true => __ts_s3("f.write_str(\"", type_name, "\")")
  )
});
/// `derive(Debug)` — the structural render, as a `debug_fmt` that writes each
/// part into the formatter.
__derive_debug :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))({
  body :: __derive_debug_body(T);
  ctx.make_impl(
    quote(
      Debug(
        debug_fmt : ((self, f) -> unquote(body.to_expr()))
      )
    )
  )
});
derive_rule(Debug, __derive_debug);
