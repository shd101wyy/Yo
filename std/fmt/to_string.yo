//! `Display`, `Debug` and `Formatter` — the two rendering channels, the sink
//! they write into, and their impls for every primitive.
//!
//! `Display` is the USER-FACING text: what `println`, `print` and `${...}`
//! interpolation call, and what an error type's message is written by hand
//! for. `Debug` is the STRUCTURAL render: what `derive(Debug)` emits, variant
//! name and fields included. Both write into a `Formatter`, which owns the
//! `String` being built, so a value nested in another one writes its text
//! straight into the outer result instead of building a `String` of its own.
//!
//! ```yo
//! { Display, Formatter } :: import("std/fmt");
//! Point :: struct(x : i32, y : i32);
//! impl(
//!   Point,
//!   Display(
//!     fmt : (fn(self : &Self, f : &mut Formatter) -> unit)({
//!       f.write_str("(");
//!       f.write(&self.x);
//!       f.write_str(", ");
//!       f.write(&self.y);
//!       f.write_str(")");
//!     })
//!   )
//! );
//! ```
//!
//! `x.to_string()` is `Display`'s provided method: a fresh `Formatter`, then
//! `x.fmt`, then the result. `String` and `str` override it to copy their
//! bytes. `x.debug_string()` is `Debug`'s twin.
//!
//! Numbers go through one shared `_snprintf_into` (a comptime format literal,
//! a 32-byte stack buffer) rather than a hand-rolled digit loop, so all
//! eighteen numeric impls share one body, and each writes its digits into the
//! formatter without an intermediate `String`.
//!
//! ## Stability
//!
//! unstable, for two named reasons rather than a release count.
//!
//! `Formatter` has no format spec yet: `${x:spec}` still renders through
//! `Format.format` (`./format.yo`), and a `fmt` impl cannot read a width or a
//! precision.
//!
//! And `f64` / `f32` rendering is not yet portable: a finite value is the host
//! C library's `%g` output, so its exact digits are whatever that library
//! prints.
//!
//! This module holds no template literal. A module that holds one gets an
//! `import("std/fmt")` from the parser, and `std/fmt` imports this module, so
//! a template here would be an import cycle that leaves `Display` unbound
//! while `std/fmt` destructures it. The impls below write their text with
//! `write_str` and `write`, which is what a template lowers to.
pragma(Pragma.AllowUnsafe);
{ String, rune, ParseIntError, ParseFloatError, ParseBoolError } :: import("../string");
{ snprintf } :: import("../libc/stdio");
{ ArrayList } :: import("../collections/array-list");
utf8 :: import("../encoding/utf8");
// `isnan`/`isinf` come straight from libc rather than via `std/math`: that
// module registers METHODS on f64/f32 and importing it here would be a cycle
// for a two-predicate need.
{ isnan : _c_isnan, isinf : _c_isinf } :: import("../libc/math.yo");
/// The sink a `Display` or `Debug` impl writes into: it owns the `String`
/// being built. `Formatter.new()` starts empty, `finish()` hands the text back.
///
/// A template of two or more parts is one formatter: each literal part is a
/// `write_str`, each interpolated part an `e.fmt(&mut f)`, and the template's
/// value is `f.finish()`.
Formatter :: struct(_out : String);
impl(
  Formatter,
  /// An empty formatter. Allocates nothing until the first write.
  new : (fn() -> Self)(Self(_out : String.new())),
  /// A formatter that continues `out`: what is written is appended to it.
  from : (fn(sink(out) : String) -> Self)(Self(_out : out)),
  /// The text written so far, moved out.
  finish : (fn(sink(self) : Self) -> String)(
    match(
      self,
      Formatter(_out : o) => o
    )
  ),
  /// Append the bytes of `s`.
  write_str : (fn(self : &mut Self, s : &str) -> unit)(self._out.push_str(s)),
  /// Append the UTF-8 encoding of `r`.
  write_rune : (fn(self : &mut Self, r : rune) -> unit)(self._out.push_rune(r)),
  /// Append `v`'s `Display` text.
  write : (fn(generic(T : ?Sized), self : &mut Self, v : &T, where(T <: Display)) -> unit)(T.fmt(v, self)),
  /// Append `v`'s `Debug` text.
  write_debug : (fn(generic(T : ?Sized), self : &mut Self, v : &T, where(T <: Debug)) -> unit)(T.debug_fmt(v, self))
);
export(Formatter);
/// `"".formatter()` — a formatter that starts with these bytes. A template of
/// two or more parts lowers to it: the lowering names only methods, so a
/// template spliced into another module's scope needs no import.
impl(
  str,
  formatter : (fn(self : &Self) -> Formatter)(Formatter(_out : String.from(self)))
);
/// Rendering a value as the text a USER should read: what `println`, `print`
/// and `${...}` interpolation call.
Display :: trait(
  /// Write `self`'s user-facing text into `f`.
  fmt : (fn(self : &Self, f : &mut Formatter) -> unit),
  /// `self`'s text as a new `String`: a fresh `Formatter`, then `fmt`.
  (to_string : (fn(self : &Self) -> String)) ?=
    (
      self -> {
        mut(f) := Formatter.new();
        self.fmt(&mut f);
        f.finish()
      }
    ),
  /// Append `self`'s text to `out`.
  (append_to : (fn(self : &Self, out : &mut String) -> unit)) ?= ((self, out) -> out.push_string(&self.to_string()))
);
export(Display);
/// The STRUCTURAL render of a value: type or variant name plus fields, the
/// shape `derive(Debug)` emits. Meant for logs, assertion failures and
/// inspection, never for text a user reads.
///
/// ```yo
/// MyError :: enum(NotFound(path : String));
/// derive(MyError, Debug); // "MyError.NotFound(/tmp/x)" — structural
/// ```
///
/// There is deliberately NO blanket `impl(T <: Display) Debug for T`: it
/// would give any type with a hand-written message a `debug_string` that
/// returns that MESSAGE rather than a structural render.
Debug :: trait(
  /// Write `self`'s structural render into `f`.
  debug_fmt : (fn(self : &Self, f : &mut Formatter) -> unit),
  /// `self`'s structural render as a new `String`.
  (debug_string : (fn(self : &Self) -> String)) ?=
    (
      self -> {
        mut(f) := Formatter.new();
        self.debug_fmt(&mut f);
        f.finish()
      }
    )
);
export(Debug);
/// The one shared body behind every numeric `Display` impl. `fmt` is a
/// `comptime_str` parameter, so it forwards into the extern call as a literal.
/// 32 bytes covers every `%g`-family rendering (compact, exponent form) and
/// every 64-bit integer; the digits go into `f` without a `String` of their own.
_SNPRINTF_BUFFER_SIZE :: usize(32);
_snprintf_into :: (fn(comptime(fmt) : comptime_str, comptime(T) : Type, v : &T, f : &mut Formatter) -> unit)({
  buffer := Array(u8, _SNPRINTF_BUFFER_SIZE).fill(0);
  buffer_ptr := addr_of(buffer(0));
  n := unsafe(snprintf((*char)(buffer_ptr), _SNPRINTF_BUFFER_SIZE, fmt, v.*));
  len := cond(
    (n < int(0)) => usize(0),
    (usize(n) >= _SNPRINTF_BUFFER_SIZE) => (_SNPRINTF_BUFFER_SIZE - usize(1)),
    true => usize(n)
  );
  f.write_str(str.from_raw_parts(buffer_ptr, len));
});
// === Signed Integer Implementations ===
impl(
  i8,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%hhd", i8, self, f)))
);
impl(
  i16,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%hd", i16, self, f)))
);
impl(
  i32,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%d", i32, self, f)))
);
impl(
  i64,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%lld", i64, self, f)))
);
impl(
  isize,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%zd", isize, self, f)))
);
// === Unsigned Integer Implementations ===
impl(
  u8,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%hhu", u8, self, f)))
);
impl(
  u16,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%hu", u16, self, f)))
);
impl(
  u32,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%u", u32, self, f)))
);
impl(
  u64,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%llu", u64, self, f)))
);
impl(
  usize,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%zu", usize, self, f)))
);
// === Floating Point Implementations ===
/// The platform-independent spelling of a non-finite double, or `.None` when
/// `v` is finite and `%g` should render it.
///
/// `%g` hands back whatever the host C library spells: `nan` or `-nan` on
/// glibc / Apple libc / musl, and `-nan(ind)` or `nan(snan)` on the MS CRT. So
/// the same program logged a different token on Windows, JSON-encoded a
/// different token, and compared differently against a fixture — silently, and
/// with no way for a caller to normalise without knowing every spelling
/// (issues/fixed/float-to-string-is-platform-dependent-for-non-finite-values.md).
///
/// It had already produced one compiler bug: codegen's non-finite match tested
/// the raw string against `"nan"` / `"-nan"` and emitted `-nan(ind).0` — not
/// valid C — on Windows.
///
/// The spellings are Rust's `Display for f64`: `NaN`, `inf`, `-inf`. Rust
/// implements this itself rather than delegating to the C library, for exactly
/// this reason. Note `inf` / `-inf` already matched on POSIX; `NaN` is the one
/// that changes there, and Windows is normalised on all three.
_non_finite_str :: (fn(v : f64) -> Option(&(str, static)))(
  cond(
    // NaN first: it is the only value that is neither finite nor comparable,
    // and `isinf` is false for it.
    (unsafe(_c_isnan(v)) != int(0)) => Option(&(str, static)).Some("NaN"),
    (unsafe(_c_isinf(v)) != int(0)) => cond(
      // A negative infinity compares below every finite double, so a plain
      // sign test is enough and needs no `signbit`.
      (v < f64(0.0)) => Option(&(str, static)).Some("-inf"),
      true => Option(&(str, static)).Some("inf")
    ),
    true => Option(&(str, static)).None
  )
);
impl(
  f32,
  // %g: general format, trailing zeros removed (widened to f64 for varargs)
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(
      match(
        _non_finite_str(f64(self.*)),
        .Some(t) => f.write_str(t),
        .None => _snprintf_into("%g", f64, f64(self.*), f)
      )
    )
  )
);
impl(
  f64,
  // %g: general format, trailing zeros removed
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(
      match(
        _non_finite_str(self.*),
        .Some(t) => f.write_str(t),
        .None => _snprintf_into("%g", f64, self, f)
      )
    )
  )
);
// === C-interop Integer Implementations (plans/archive/STD_API_AUDIT.md D3.8) ===
impl(
  int,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%d", int, self, f)))
);
impl(
  uint,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%u", uint, self, f)))
);
impl(
  short,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%hd", short, self, f)))
);
impl(
  ushort,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%hu", ushort, self, f)))
);
impl(
  long,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%ld", long, self, f)))
);
impl(
  ulong,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%lu", ulong, self, f)))
);
impl(
  longlong,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%lld", longlong, self, f)))
);
impl(
  ulonglong,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(_snprintf_into("%llu", ulonglong, self, f)))
);
// Buffer size for long double conversion: scientific notation can be long.
_FLOAT_BUFFER_SIZE :: usize(64);
impl(
  longdouble,
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)({
      buffer := Array(u8, _FLOAT_BUFFER_SIZE).fill(0);
      buffer_ptr := addr_of(buffer(0));
      // Use %Lg for general format (removes trailing zeros)
      n := unsafe(snprintf((*char)(buffer_ptr), _FLOAT_BUFFER_SIZE, "%Lg", self.*));
      len := cond(
        (n < int(0)) => usize(0),
        (usize(n) >= _FLOAT_BUFFER_SIZE) => (_FLOAT_BUFFER_SIZE - usize(1)),
        true => usize(n)
      );
      f.write_str(str.from_raw_parts(buffer_ptr, len));
    })
  )
);
// === Boolean Implementation ===
impl(
  bool,
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(
      cond(
        self.* => f.write_str("true"),
        true => f.write_str("false")
      )
    )
  )
);
// === Char Implementation ===
impl(
  char,
  // A C `char` is one byte, written as that byte; NUL writes nothing.
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(
      cond(
        (u8(self.*) == u8(0)) => (),
        true => f._out.push_byte(u8(self.*))
      )
    )
  )
);
// === String Implementation ===
impl(
  String,
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(f._out.push_string(self)),
    // An owned result of a borrowed receiver is a copy (B8,
    // plans/VALUES_BY_DEFAULT.md): `String` owns its buffer.
    to_string : (fn(self : &Self) -> String)(self.clone()),
    append_to : (fn(self : &Self, out : &mut String) -> unit)(out.push_string(self))
  )
);
// === str Implementation ===
impl(
  str,
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(f.write_str(self)),
    // `String.from` and `push_str` take `&str` and copy the bytes.
    to_string : (fn(self : &Self) -> String)(String.from(self)),
    append_to : (fn(self : &Self, out : &mut String) -> unit)(out.push_str(self))
  )
);
// === A shared reference ===
/// `Display` over a shared reference: a reference renders as its referent, so
/// `${r}` and a generic `show(v : &T)` at `T := &U` print the value, never an
/// address. Every method is forwarded, so a `&String` is still copied once by
/// `to_string`. The bodies are the type-qualified calls, never
/// `self.*.fmt(f)`, whose probe would select this impl again (VERDICTS-49).
impl(
  generic(T : Type),
  where(T <: Display),
  &T,
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(T.fmt(self.*, f)),
    to_string : (fn(self : &Self) -> String)(T.to_string(self.*)),
    append_to : (fn(self : &Self, out : &mut String) -> unit)(T.append_to(self.*, out))
  )
);
/// `Debug` over a shared reference: the referent's structural render.
impl(
  generic(T : Type),
  where(T <: Debug),
  &T,
  Debug(
    debug_fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(T.debug_fmt(self.*, f)),
    debug_string : (fn(self : &Self) -> String)(T.debug_string(self.*))
  )
);
// === Unit ===
/// `()` prints as "()". The `self : &Self` receiver of type unit is passed as
/// a null pointer at the C level (see codegen _apply_ref_amp;
/// issues/fixed/inout-unit-receiver-void-ref-spill.md).
impl(
  unit,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(f.write_str("()")))
);
// === rune Implementation ===
impl(
  rune,
  // One shared encoder (std/encoding/utf8). `self.char` is a raw u32, so the
  // lossy entry point is the right one: a `rune` built by hand around a
  // surrogate renders as U+FFFD rather than emitting CESU-8.
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)({
      mut(out) := ArrayList(u8).with_capacity(usize(4));
      utf8.encode_lossy_into(self.char, &mut out);
      n := out.len();
      (mut(i) : usize) = usize(0);
      while(i < n, {
        f._out.push_byte(out(i));
        i = (i + usize(1));
      });
    })
  )
);
// === Option / Result Implementations (plans/archive/STD_API_AUDIT.md D3.7) ===
/// `Option(T)` prints as `Some(<value>)` / `None`, so `println(opt)` and
/// `${opt}` in template strings compile.
impl(
  generic(T : Type),
  where(T <: Display),
  Option(T),
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(
      match(
        self,
        .Some(value) => {
          f.write_str("Some(");
          T.fmt(value, f);
          f.write_str(")");
        },
        .None => f.write_str("None")
      )
    )
  )
);
/// `Result(T, E)` prints as `Ok(<value>)` / `Err(<error>)`.
impl(
  generic(T : Type, E : Type),
  where(T <: Display, E <: Display),
  Result(T, E),
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(
      match(
        self,
        .Ok(value) => {
          f.write_str("Ok(");
          T.fmt(value, f);
          f.write_str(")");
        },
        .Err(error) => {
          f.write_str("Err(");
          E.fmt(error, f);
          f.write_str(")");
        }
      )
    )
  )
);
// === Container Implementations (plans/archive/STD_API_AUDIT.md D3.8) ===
/// `ArrayList(T)` prints as `[a, b, c]`, so `println(list)` compiles.
impl(
  generic(T : Type),
  where(T <: Display),
  ArrayList(T),
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)({
      f.write_str("[");
      (mut(i) : usize) = usize(0);
      n := self.len();
      while(i < n, {
        cond(
          (i > usize(0)) => {
            f.write_str(", ");
          },
          true => ()
        );
        T.fmt(&self(i), f);
        i = (i + usize(1));
      });
      f.write_str("]");
    })
  )
);
/// `Array(T, N)` prints as `[a, b, c]`.
impl(
  generic(T : Type, N : usize),
  where(T <: Display),
  Array(T, N),
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)({
      f.write_str("[");
      (mut(i) : usize) = usize(0);
      while(i < N, {
        cond(
          (i > usize(0)) => {
            f.write_str(", ");
          },
          true => ()
        );
        T.fmt(&self(i), f);
        i = (i + usize(1));
      });
      f.write_str("]");
    })
  )
);
/// The D12 parse errors live in `std/string` (below this module, so they
/// cannot name `Display` themselves); their renderings live here, the same
/// split `impl(String, Error())` uses one layer up.
impl(
  ParseIntError,
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(
      match(
        self,
        .Empty => f.write_str("cannot parse integer from empty string"),
        .InvalidDigit => f.write_str("invalid digit found in string"),
        .PosOverflow => f.write_str("number too large to fit in target type"),
        .NegOverflow => f.write_str("number too small to fit in target type"),
        .InvalidRadix => f.write_str("radix must be between 2 and 36")
      )
    )
  )
);
impl(
  ParseFloatError,
  Display(
    fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(
      match(
        self,
        .Empty => f.write_str("cannot parse float from empty string"),
        .Invalid => f.write_str("invalid float literal")
      )
    )
  )
);
impl(
  ParseBoolError,
  Display(fmt : (fn(self : &Self, f : &mut Formatter) -> unit)(f.write_str("provided string was not `true` or `false`")))
);
