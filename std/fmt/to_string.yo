//! ToString trait and implementations for all primitive types.
pragma(Pragma.AllowUnsafe);
{ String, rune } :: import("../string");
{ snprintf } :: import("../libc/stdio");
{ ArrayList } :: import("../collections/array_list");
utf8 :: import("../encoding/utf8");
/// Trait for converting values to their `String` representation.
/// Types implementing this trait can be used with `println`, `print`, and template strings.
ToString :: trait(
  to_string : (fn(inout(self) : Self) -> String)
);
export(ToString);
/// The one shared body behind every numeric `ToString` impl (audit fmt row:
/// dedupe the snprintf helpers). `fmt` is a comptime `str` parameter, so it
/// forwards into the extern call as a literal — no runtime conversion.
/// 32 bytes covers every `%g`-family rendering (compact, exponent form).
_SNPRINTF_BUFFER_SIZE :: usize(32);
_snprintf_to_string :: (fn(comptime(fmt) : str, comptime(T) : Type, v : T) -> String)({
  buffer := Array(u8, _SNPRINTF_BUFFER_SIZE).fill(0);
  buffer_ptr := (&(buffer(0)));
  unsafe(snprintf(*(char)(buffer_ptr), _SNPRINTF_BUFFER_SIZE, fmt, v));
  String.from_cstr(buffer_ptr).unwrap()
});

// === Helper function for integer conversion ===
// Buffer size for integer to string conversion
// i64 min is -9223372036854775808 (20 chars + null = 21)
// u64 max is 18446744073709551615 (20 chars + null = 21)
_INT_BUFFER_SIZE :: usize(24);
// === Signed Integer Implementations ===
impl(
  i8,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%hhd", i8, self)
    )
  )
);
impl(
  i16,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%hd", i16, self)
    )
  )
);
impl(
  i32,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%d", i32, self)
    )
  )
);
impl(
  i64,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%lld", i64, self)
    )
  )
);
impl(
  isize,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%zd", isize, self)
    )
  )
);
// === Unsigned Integer Implementations ===
impl(
  u8,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%hhu", u8, self)
    )
  )
);
impl(
  u16,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%hu", u16, self)
    )
  )
);
impl(
  u32,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%u", u32, self)
    )
  )
);
impl(
  u64,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%llu", u64, self)
    )
  )
);
impl(
  usize,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%zu", usize, self)
    )
  )
);
// === Floating Point Implementations ===
// Buffer size for float to string conversion
// Scientific notation can be long, use generous buffer
_FLOAT_BUFFER_SIZE :: usize(64);
impl(
  f32,
  // %g: general format, trailing zeros removed (widened to f64 for varargs)
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%g", f64, f64(self))
    )
  )
);
impl(
  f64,
  // %g: general format, trailing zeros removed
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%g", f64, self)
    )
  )
);
// === C-interop Integer Implementations (plans/STD_API_AUDIT.md D3.8) ===
impl(
  int,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%d", int, self)
    )
  )
);
impl(
  uint,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%u", uint, self)
    )
  )
);
impl(
  short,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%hd", short, self)
    )
  )
);
impl(
  ushort,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%hu", ushort, self)
    )
  )
);
impl(
  long,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%ld", long, self)
    )
  )
);
impl(
  ulong,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%lu", ulong, self)
    )
  )
);
impl(
  longlong,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%lld", longlong, self)
    )
  )
);
impl(
  ulonglong,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      _snprintf_to_string("%llu", ulonglong, self)
    )
  )
);
impl(
  longdouble,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)({
      buffer := Array(u8, _FLOAT_BUFFER_SIZE).fill(0);
      buffer_ptr := (&(buffer(0)));
      // Use %Lg for general format (removes trailing zeros)
      unsafe(snprintf(*(char)(buffer_ptr), _FLOAT_BUFFER_SIZE, "%Lg", self));
      String.from_cstr(buffer_ptr).unwrap()
    })
  )
);
// === Boolean Implementation ===
impl(
  bool,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      cond(
        self => String.from("true"),
        true => String.from("false")
      )
    )
  )
);
// === Char Implementation ===
impl(
  char,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)({
      // char is a single byte, create a 2-byte buffer (char + null)
      buffer := Array(u8, usize(2)).fill(0);
      buffer(0) = u8(self);
      buffer_ptr := (&(buffer(0)));
      String.from_cstr(buffer_ptr).unwrap()
    })
  )
);
// === String Implementation (identity) ===
impl(
  String,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      // String already is a string, just return a clone
      self
    )
  )
);
// === str Implementation ===
impl(
  str,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)({
      // Convert byte array to String assuming UTF-8
      return(String.from(self));
    })
  )
);
// === Unit ===
/// `()` prints as "()" — the last D3.8 primitive (plans/STD_API_AUDIT.md).
/// The inout(self) receiver of type unit is passed as a null pointer at the
/// C level (see codegen _apply_ref_amp;
/// issues/fixed/inout-unit-receiver-void-ref-spill.md).
impl(
  unit,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(`()`)
  )
);
// === rune Implementation ===
// Convert Unicode code point to UTF-8 string
impl(
  rune,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)({
      // One shared encoder (std/encoding/utf8) instead of a seventh hand-rolled
      // copy. `self.char` is a raw u32, so the lossy entry point is the right
      // one — a `rune` built by hand around a surrogate stringifies as U+FFFD
      // rather than emitting CESU-8.
      out := ArrayList(u8).with_capacity(usize(4));
      utf8.encode_lossy_into(self.char, out);
      String.from_bytes(out)
    })
  )
);
// === Option / Result Implementations (plans/STD_API_AUDIT.md D3.7) ===
/// `Option(T)` prints as `Some(<value>)` / `None`, so `println(opt)` and
/// `${opt}` in template strings compile.
impl(
  generic(T : Type),
  where(T <: ToString),
  Option(T),
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      match(
        self,
        .Some(value) => `Some(${value})`,
        .None => `None`
      )
    )
  )
);
/// `Result(T, E)` prints as `Ok(<value>)` / `Err(<error>)`.
impl(
  generic(T : Type, E : Type),
  where(T <: ToString, E <: ToString),
  Result(T, E),
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      match(
        self,
        .Ok(value) => `Ok(${value})`,
        .Err(error) => `Err(${error})`
      )
    )
  )
);
// === Container Implementations (plans/STD_API_AUDIT.md D3.8) ===
/// `ArrayList(T)` prints as `[a, b, c]`, so `println(list)` compiles.
impl(
  generic(T : Type),
  where(T <: ToString),
  ArrayList(T),
  ToString(
    to_string : (fn(inout(self) : Self) -> String)({
      (out : String) = `[`;
      (i : usize) = usize(0);
      n := self.len();
      while(i < n, {
        cond(
          (i > usize(0)) => {
            out = `${out}, `;
          },
          true => ()
        );
        out = `${out}${self(i)}`;
        i = (i + usize(1));
      });
      `${out}]`
    })
  )
);
/// `Array(T, N)` prints as `[a, b, c]`.
impl(
  generic(T : Type, N : usize),
  where(T <: ToString),
  Array(T, N),
  ToString(
    to_string : (fn(inout(self) : Self) -> String)({
      (out : String) = `[`;
      (i : usize) = usize(0);
      while(i < N, {
        cond(
          (i > usize(0)) => {
            out = `${out}, `;
          },
          true => ()
        );
        out = `${out}${self(i)}`;
        i = (i + usize(1));
      });
      `${out}]`
    })
  )
);
// --- derive_rule for ToString ---
// Local helpers (not exported from prelude, so defined locally)
__ts_s2 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str) -> comptime(comptime_str))(a + b);
__ts_s3 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str) -> comptime(comptime_str))(
  (a + b) + c
);
__ts_s4 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str, comptime(d) : comptime_str) -> comptime(comptime_str))(
  ((a + b) + c) + d
);
__ts_s5 :: (fn(comptime(a) : comptime_str, comptime(b) : comptime_str, comptime(c) : comptime_str, comptime(d) : comptime_str, comptime(e) : comptime_str) -> comptime(comptime_str))(
  (((a + b) + c) + d) + e
);
__ts_fold_range :: (
  fn(
    comptime(n) : usize,
    comptime(init) : comptime_str,
    comptime(f) : (fn(comptime(acc) : comptime_str, comptime(i) : usize) -> comptime(comptime_str))
  ) -> comptime(comptime_str)
)(
  cond(
    (n == usize(0)) => init,
    (n == usize(1)) => f(init, usize(0)),
    true => f(recur(n - usize(1), init, f), n - usize(1))
  )
);
// Helper: join string parts with + operator, left-to-right parenthesized
__derive_join_plus :: (fn(comptime(parts) : comptime_str, comptime(new_part) : comptime_str) -> comptime(comptime_str))(
  cond(
    (parts == "") => new_part,
    true => __ts_s5("(", parts, " + ", new_part, ")")
  )
);
__derive_tostring :: (fn(comptime(T) : Type, comptime(ctx) : DeriveContext, comptime(trait_params) : ComptimeList(Expr)) -> comptime(Expr))({
  type_name :: Type.to_comptime_string(T);
  info :: Type.get_info(T);
  cond(
    info.is_struct() => {
      fields :: Type.get_struct_fields(T);
      fc :: fields.len();
      cond(
        (fc == 0) => {
          label :: __ts_s3("String.from(\"", type_name, "()\")");
          ctx.make_impl(
            quote(
              ToString(
                to_string : ((self) -> #(label.to_expr()))
              )
            )
          )
        },
        true => {
          body :: __ts_fold_range(
            fc,
            __ts_s3("String.from(\"", type_name, "(\")"),
            (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
              fname :: fields.get(fi).name;
              with_sep :: cond(
                (fi == 0) => a,
                true => __derive_join_plus(a, "String.from(\", \")")
              );
              __derive_join_plus(with_sep, __ts_s3("self.", fname, ".to_string()"))
            })
          );
          full_body :: __derive_join_plus(body, "String.from(\")\")");
          ctx.make_impl(
            quote(
              ToString(
                to_string : ((self) -> #(full_body.to_expr()))
              )
            )
          )
        }
      )
    },
    info.is_enum() => {
      variants :: Type.get_enum_variants(T);
      vc :: variants.len();
      ts_branches :: __ts_fold_range(
        vc,
        "",
        (fn(comptime(acc) : comptime_str, comptime(vi) : usize) -> comptime(comptime_str))({
          v :: variants.get(vi);
          branch :: cond(
            (v.fields.len() == 0) =>
              __ts_s5(".", v.name, " => String.from(\"", type_name, __ts_s3(".", v.name, "\")")),
            true => {
              bindings :: __ts_fold_range(
                v.fields.len(),
                "",
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  cond(
                    (a == "") => __ts_s2("__v_", fname),
                    true => __ts_s3(a, ", __v_", fname)
                  )
                })
              );
              body :: __ts_fold_range(
                v.fields.len(),
                __ts_s5("String.from(\"", type_name, ".", v.name, "(\")"),
                (fn(comptime(a) : comptime_str, comptime(fi) : usize) -> comptime(comptime_str))({
                  fname :: v.fields.get(fi).name;
                  with_sep :: cond(
                    (fi == 0) => a,
                    true => __derive_join_plus(a, "String.from(\", \")")
                  );
                  __derive_join_plus(with_sep, __ts_s3("__v_", fname, ".to_string()"))
                })
              );
              full_body :: __derive_join_plus(body, "String.from(\")\")");
              __ts_s4(".", v.name, __ts_s3("(", bindings, ") => "), full_body)
            }
          );
          cond(
            (acc == "") => branch,
            true => __ts_s3(acc, ",\n    ", branch)
          )
        })
      );
      match_body :: __ts_s3("match(self,\n    ", ts_branches, "\n  )");
      ctx.make_impl(
        quote(
          ToString(
            to_string : ((self) -> #(match_body.to_expr()))
          )
        )
      )
    },
    true => {
      label :: __ts_s3("String.from(\"", type_name, "\")");
      ctx.make_impl(
        quote(
          ToString(
            to_string : ((self) -> #(label.to_expr()))
          )
        )
      )
    }
  )
});
derive_rule(ToString, __derive_tostring);
