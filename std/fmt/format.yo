//! The `Format` protocol — `value.format(spec)` (STD_API_AUDIT D3.10).
//!
//! The spec grammar lives in `./spec.yo`; this module is the dispatch layer.
//! Numeric types get radix and sign-aware zero padding; everything else that
//! implements `ToString` gets width, fill, alignment and truncation from the
//! trait's default `format` — Rust's model, where fill/align/width are
//! post-processing over whatever the value rendered as.
//!
//! ## Example
//!
//! ```yo
//! { Format } :: import("std/fmt/format");
//!
//! i32(255).format("#06x");   // "0x00ff"
//! f64(3.14159).format(".2"); // "3.14"
//! `ada`.format("<8");        // "ada     "
//! ```
//!
//! A type implements `Format` at most once (`plans/reference/TRAIT_COHERENCE.md`):
//! the numeric impls below are the only ones with a body of their own, and
//! every other std type that implements `ToString` implements `Format` with
//! the trait's DEFAULT `format` — width, fill, alignment and truncation over
//! `to_string()`. A type of your own opts in the same way, in one line:
//!
//! ```yo
//! impl(Point, Format());   // needs `impl(Point, ToString(...))`
//! ```
//!
//! There is no blanket `impl(T <: ToString)`: it would overlap every numeric
//! impl, and with no specialization one of the two would be dead code. `f32`
//! delegates to `f64`; every integer funnels into one `_format_int` after
//! splitting itself into sign and magnitude in its own width.
//!
//! ## Stability
//!
//! unstable — it is a thin dispatch layer over `./spec.yo`, and it inherits
//! that module's two open questions (no dynamic width or precision, and a
//! `parse` that never reports a bad spec). It has one of its own: fixed-point
//! float rendering goes through `StringBuilder.write_f64`, which truncates at
//! 63 bytes, so `f64(1.0e300).format(".2")` returns 63 digits of a 302-digit
//! number (`issues/stddoc-str-string-builder-write-f64-truncates.md`).
//! Fixing that changes output. The `Format` trait itself — one method, `spec`
//! as a plain `str`, an unrecognised spec degrading to `to_string()` — is
//! settled.
{ FormatSpec } :: import("./spec");
{ ArrayList } :: import("../collections/array_list");
{ rune, String, Alignment, StringBuilder, ParseIntError, ParseFloatError, ParseBoolError } :: import("../string");
{ ToString } :: import("./to_string");
/// Format a value according to a spec string. Every `Format` type is also
/// `ToString`: an unrecognised spec degrades to its `to_string()`.
Format :: trait(
  /// Render `self` under `spec`. An unrecognised spec degrades to the plain
  /// `to_string()` rendering rather than failing. The default applies width,
  /// fill, alignment and truncation to `to_string()`.
  (format : (fn(inout(self) : Self, spec : str) -> String)) ?=
    (
      (self, spec) -> {
        s := FormatSpec.parse(spec);
        body := self.to_string();
        s.pad(body, Alignment.Left)
      }
    ),
  where(Self <: ToString)
);
_DIGITS_LOWER :: "0123456789abcdef";
_DIGITS_UPPER :: "0123456789ABCDEF";
/// Render `mag` in `radix`, without sign or prefix. `radix` is 2, 8 or 16.
_to_radix :: (fn(mag : u64, radix : u64, upper : bool) -> String)(
  cond(
    (mag == u64(0)) => String.from("0"),
    true => {
      alpha := if(upper, _DIGITS_UPPER, _DIGITS_LOWER);
      bytes := String.from(alpha).as_bytes();
      tmp := ArrayList(u8).new();
      (m : u64) = mag;
      while(m > u64(0), {
        d := usize(m % radix);
        tmp.push(bytes(d));
        m = (m / radix);
      });
      sb := StringBuilder.new();
      (i : usize) = tmp.len();
      while(i > usize(0), {
        i = (i - usize(1));
        sb.write_byte(tmp(i));
      });
      sb.to_string()
    }
  )
);
/// The radix a spec's `kind` selects, or 10 when it selects none.
_radix_of :: (fn(kind : rune) -> u64)(
  cond(
    ((kind.char == u32(0x78)) || (kind.char == u32(0x58))) => u64(16),
    (kind.char == u32(0x62)) => u64(2),
    (kind.char == u32(0x6F)) => u64(8),
    true => u64(10)
  )
);
/// The `#` prefix for a radix.
_prefix_of :: (fn(radix : u64, alt : bool) -> String)(
  cond(
    !alt => String.new(),
    (radix == u64(16)) => String.from("0x"),
    (radix == u64(2)) => String.from("0b"),
    (radix == u64(8)) => String.from("0o"),
    true => String.new()
  )
);
/// Render `v` with exactly `p` decimal places, via the builder primitive.
_f64_fixed :: (fn(v : f64, p : usize) -> String)({
  sb := StringBuilder.new();
  sb.write_f64(v, i32(p));
  sb.to_string()
});
/// Shared body for every integer impl: `neg` and `mag` are the sign-magnitude
/// split the caller computed in its own width.
_format_int :: (fn(neg : bool, mag : u64, decimal : String, spec : str) -> String)({
  s := FormatSpec.parse(spec);
  radix := _radix_of(s.kind);
  digits := if(radix == u64(10), decimal, _to_radix(mag, radix, s.kind.char == u32(0x58)));
  sign := cond(
    neg => String.from("-"),
    s.plus => String.from("+"),
    true => String.new()
  );
  s.pad_numeric(sign, _prefix_of(radix, s.alt), digits)
});
impl(
  i8,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)({
      neg := (self < i8(0));
      mag := if(neg, ~u64(self) + u64(1), u64(self));
      dec := if(neg, i8(0).to_string(), self.to_string());
      _format_int(neg, mag, if(neg, mag.to_string(), dec), spec)
    })
  )
);
impl(
  i16,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)({
      neg := (self < i16(0));
      mag := if(neg, ~u64(self) + u64(1), u64(self));
      dec := if(neg, i16(0).to_string(), self.to_string());
      _format_int(neg, mag, if(neg, mag.to_string(), dec), spec)
    })
  )
);
impl(
  i32,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)({
      neg := (self < i32(0));
      mag := if(neg, ~u64(self) + u64(1), u64(self));
      dec := if(neg, i32(0).to_string(), self.to_string());
      _format_int(neg, mag, if(neg, mag.to_string(), dec), spec)
    })
  )
);
impl(
  i64,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)({
      neg := (self < i64(0));
      mag := if(neg, ~u64(self) + u64(1), u64(self));
      dec := if(neg, i64(0).to_string(), self.to_string());
      _format_int(neg, mag, if(neg, mag.to_string(), dec), spec)
    })
  )
);
impl(
  isize,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)({
      neg := (self < isize(0));
      mag := if(neg, ~u64(self) + u64(1), u64(self));
      dec := if(neg, isize(0).to_string(), self.to_string());
      _format_int(neg, mag, if(neg, mag.to_string(), dec), spec)
    })
  )
);
impl(
  u8,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)(
      _format_int(false, u64(self), self.to_string(), spec)
    )
  )
);
impl(
  u16,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)(
      _format_int(false, u64(self), self.to_string(), spec)
    )
  )
);
impl(
  u32,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)(
      _format_int(false, u64(self), self.to_string(), spec)
    )
  )
);
impl(
  u64,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)(
      _format_int(false, u64(self), self.to_string(), spec)
    )
  )
);
impl(
  usize,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)(
      _format_int(false, u64(self), self.to_string(), spec)
    )
  )
);
impl(
  f64,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)({
      s := FormatSpec.parse(spec);
      neg := (self < f64(0.0));
      body := match(
        s.precision,
        .Some(p) => _f64_fixed(if(neg, -self, self), p),
        .None => if(neg, -self, self).to_string()
      );
      sign := cond(
        neg => String.from("-"),
        s.plus => String.from("+"),
        true => String.new()
      );
      s.pad_numeric(sign, String.new(), body)
    })
  )
);
impl(
  f32,
  Format(
    format : (fn(inout(self) : Self, spec : str) -> String)(
      f64(self).format(spec)
    )
  )
);
// Every other std type that implements `ToString`: the default `format`.
impl(bool, Format());
impl(char, Format());
impl(rune, Format());
impl(str, Format());
impl(String, Format());
impl(unit, Format());
impl(int, Format());
impl(uint, Format());
impl(short, Format());
impl(ushort, Format());
impl(long, Format());
impl(ulong, Format());
impl(longlong, Format());
impl(ulonglong, Format());
impl(longdouble, Format());
impl(generic(T : Type), where(T <: ToString), Option(T), Format());
impl(generic(T : Type, E : Type), where(T <: ToString, E <: ToString), Result(T, E), Format());
impl(generic(T : Type), where(T <: ToString), ArrayList(T), Format());
impl(generic(T : Type, N : usize), where(T <: ToString), Array(T, N), Format());
impl(ParseIntError, Format());
impl(ParseFloatError, Format());
impl(ParseBoolError, Format());
export(Format);
