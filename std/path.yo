//! Cross-platform filesystem path manipulation.
pragma(Pragma.AllowUnsafe);
open(import("./string"));
open(import("./fmt"));
open(import("./collections/array_list"));
/// Platform-specific path separator: `'/'` on Unix, `'\\'` on Windows.
PATH_SEPARATOR :: cond(
  (__yo_process_platform() == "windows") => u8(92),
  // '\' for Windows
  true => u8(47) // '/' for Unix
);
export(PATH_SEPARATOR);
/// Platform-specific path list delimiter: `':'` on Unix, `';'` on Windows.
PATH_DELIMITER :: cond(
  (__yo_process_platform() == "windows") => u8(59),
  // ';' for Windows
  true => u8(58) // ':' for Unix
);
export(PATH_DELIMITER);
/// Filesystem path with segment-based operations.
/// Paths are normalized on construction: `.` segments are removed, `..` pops the parent.
Path :: ref(
  struct(
    _segments : ArrayList(String),
    _is_absolute : bool
  )
);
impl(
  Path,
  /// Create a new path from a string. Normalizes separators and resolves `.`/`..`.
  new : (fn(path_str : String) -> Self)({
    segments := ArrayList(String).new();
    is_abs := false;
    // Handle empty path early
    cond(
      path_str.is_empty() => {
        return(Self(_segments : segments, _is_absolute : is_abs));
      },
      true => ()
    );
    // Normalize backslashes to forward slashes for cross-platform support
    normalized := path_str.replace_all(String.from("\\"), String.from("/"));
    // Check if path is absolute
    // Unix: starts with '/'
    // Windows: starts with drive letter like 'C:' or UNC path '\\'
    bytes := normalized.as_bytes();
    cond(
      (bytes.len() > usize(0)) => {
        first_byte := bytes.get(usize(0));
        match(
          first_byte,
          .Some(b) => cond(
            // Unix-style absolute path (starts with /)
            (b == u8(47)) => {
              is_abs = true;
            },
            true => {
              // Windows drive letter: check for pattern like "C:"
              cond(
                (bytes.len() >= usize(2)) => {
                  second_byte_opt := bytes.get(usize(1));
                  match(
                    second_byte_opt,
                    .Some(second_byte) => cond(
                      // Check if second byte is ':' (colon)
                      (second_byte == u8(58)) => {
                        // First byte should be a letter (A-Z or a-z)
                        is_letter := (((b >= u8(65)) && (b <= u8(90))) || ((b >= u8(97)) && (b <= u8(122))));
                        cond(
                          is_letter => {
                            is_abs = true;
                          },
                          true => ()
                        );
                      },
                      true => ()
                    ),
                    .None => ()
                  );
                },
                true => ()
              );
            }
          ),
          .None => ()
        );
      },
      true => ()
    );
    // Split path by "/" separator (backslashes already normalized)
    sep := String.from("/");
    parts := normalized.split(sep);
    // Process each part
    i := usize(0);
    while(i < parts.len(), i = (i + usize(1)), {
      part_opt := parts.get(i);
      match(
        part_opt,
        .Some(part) => {
          // Skip empty segments (from leading/trailing slashes)
          cond(
            part.is_empty() => (),
            true => {
              // Check if it's "." (current directory)
              is_dot := (
                (part.len() == usize(1)) && {
                  byte_opt := part.as_bytes().get(usize(0));
                  match(
                    byte_opt,
                    .Some(b) => (b == u8(46)),
                    .None => false
                  )
                }
              );
              // Check if it's ".." (parent directory)
              is_dotdot := (
                (part.len() == usize(2)) && {
                  b0_opt := part.as_bytes().get(usize(0));
                  b1_opt := part.as_bytes().get(usize(1));
                  match(
                    b0_opt,
                    .Some(b0) => match(
                      b1_opt,
                      .Some(b1) => ((b0 == u8(46)) && (b1 == u8(46))),
                      .None => false
                    ),
                    .None => false
                  )
                }
              );
              cond(
                is_dot => (),
                // Skip "."
                is_dotdot => {
                  // Pop the last segment if exists
                  cond(
                    (segments.len() > usize(0)) => {
                      segments.pop();
                    },
                    true => ()
                  );
                },
                true => {
                  segments.push(part);
                }
              );
            }
          );
        },
        .None => ()
      );
    });
    return(Self(_segments : segments, _is_absolute : is_abs));
  }),
  /// Create a path from a C string pointer.
  from_cstr : (fn(cstr : *u8) -> Self)({
    str_result := String.from_cstr(cstr);
    match(
      str_result,
      .Ok(s) => {
        return(Self.new(s));
      },
      .Err(_) => {
        // Return empty path on error
        return(Self(_segments : ArrayList(String).new(), _is_absolute : false));
      }
    );
  }),
  /// Join this path with another. If `other` is absolute, returns `other`.
  /// Join with any `ToString` — a `str`/`String` literal or another `Path`
  /// (audit path row: `join(str)`). `Path` round-trips through `new`
  /// losslessly (paths are stored normalized), so the generic facade is
  /// semantics-preserving for existing `Path` callers.
  join : (fn(generic(P : Type), self : Self, other : P, where(P <: ToString)) -> Self)(
    self._join_path(Path.new(other.to_string()))
  ),
  _join_path : (fn(self : Self, other : Self) -> Self)({
    // If other is absolute, return other
    cond(
      other._is_absolute => {
        return(other);
      },
      true => ()
    );
    // Otherwise, concatenate segments
    new_segments := ArrayList(String).with_capacity(self._segments.len() + other._segments.len());
    // Copy self segments
    i := usize(0);
    while(i < self._segments.len(), i = (i + usize(1)), {
      seg := self._segments.get(i);
      match(
        seg,
        .Some(s) => {
          new_segments.push(s);
        },
        .None => ()
      );
    });
    // Copy other segments
    j := usize(0);
    while(j < other._segments.len(), j = (j + usize(1)), {
      seg := other._segments.get(j);
      match(
        seg,
        .Some(s) => {
          new_segments.push(s);
        },
        .None => ()
      );
    });
    return(Self(_segments : new_segments, _is_absolute : self._is_absolute));
  }),
  /// Get the parent directory path, or `.None` if there are no segments.
  parent : (fn(self : Self) -> Option(Self))({
    cond(
      (self._segments.len() == usize(0)) => {
        return(.None);
      },
      true => ()
    );
    new_segments := ArrayList(String).with_capacity(self._segments.len() - usize(1));
    i := usize(0);
    while(i < (self._segments.len() - usize(1)), i = (i + usize(1)), {
      seg := self._segments.get(i);
      match(
        seg,
        .Some(s) => {
          new_segments.push(s);
        },
        .None => ()
      );
    });
    return(.Some(Self(_segments : new_segments, _is_absolute : self._is_absolute)));
  }),
  /// Get the last path segment (filename), or `.None` for empty paths.
  file_name : (fn(self : Self) -> Option(String))({
    cond(
      (self._segments.len() == usize(0)) => {
        return(.None);
      },
      true => ()
    );
    return(self._segments.get(self._segments.len() - usize(1)));
  }),
  /// Get the filename without its extension, or `.None` for empty paths.
  file_stem : (fn(self : Self) -> Option(String))({
    name_opt := self.file_name();
    match(
      name_opt,
      .Some(name) => {
        // Find the last dot using String methods
        dot := String.from(".");
        last_dot_result := name.last_index_of(dot);
        match(
          last_dot_result,
          .Some(idx) => {
            // Return substring before the dot
            stem := name.substring(usize(0), idx);
            return(.Some(stem));
          },
          .None => {
            // No dot found, return the whole name
            return(.Some(name));
          }
        );
      },
      .None => {
        return(.None);
      }
    );
  }),
  /// Get the file extension (without the dot), or `.None` if there is none.
  extension : (fn(self : Self) -> Option(String))({
    name_opt := self.file_name();
    match(
      name_opt,
      .Some(name) => {
        // Find the last dot using String methods
        dot := String.from(".");
        last_dot_result := name.last_index_of(dot);
        match(
          last_dot_result,
          .Some(idx) => {
            // Return substring after the dot
            ext := name.substring(idx + usize(1), name.len());
            cond(
              ext.is_empty() => {
                return(.None);
              },
              true => {
                return(.Some(ext));
              }
            );
          },
          .None => {
            // No dot found, no extension
            return(.None);
          }
        );
      },
      .None => {
        return(.None);
      }
    );
  }),
  /// Return a new path with the extension replaced by `ext`.
  with_extension : (fn(self : Self, ext : String) -> Self)({
    cond(
      (self._segments.len() == usize(0)) => {
        return(self);
      },
      true => ()
    );
    // Get the file stem
    stem_opt := self.file_stem();
    match(
      stem_opt,
      .Some(stem) => {
        // Build new file name with extension
        dot := String.from(".");
        new_name := stem.concat(dot).concat(ext);
        // Replace the last segment
        new_segments := ArrayList(String).with_capacity(self._segments.len());
        i := usize(0);
        while(i < (self._segments.len() - usize(1)), i = (i + usize(1)), {
          seg := self._segments.get(i);
          match(
            seg,
            .Some(s) => {
              new_segments.push(s);
            },
            .None => ()
          );
        });
        new_segments.push(new_name);
        return(Self(_segments : new_segments, _is_absolute : self._is_absolute));
      },
      .None => {
        return(self);
      }
    );
  }),
  /// Return a new path with the last segment replaced by `name`.
  with_file_name : (fn(self : Self, name : String) -> Self)({
    cond(
      (self._segments.len() == usize(0)) => {
        // Empty path, just return a new path with the name
        segments := ArrayList(String).new();
        segments.push(name);
        return(Self(_segments : segments, _is_absolute : self._is_absolute));
      },
      true => ()
    );
    // Replace the last segment
    new_segments := ArrayList(String).with_capacity(self._segments.len());
    i := usize(0);
    while(i < (self._segments.len() - usize(1)), i = (i + usize(1)), {
      seg := self._segments.get(i);
      match(
        seg,
        .Some(s) => {
          new_segments.push(s);
        },
        .None => ()
      );
    });
    new_segments.push(name);
    return(Self(_segments : new_segments, _is_absolute : self._is_absolute));
  }),
  /// Check if this path starts with the given base path (segment-wise).
  starts_with : (fn(self : Self, base : Self) -> bool)({
    // Absolute vs relative mismatch
    cond(
      (self._is_absolute != base._is_absolute) => {
        return(false);
      },
      true => ()
    );
    // Base has more segments than self
    cond(
      (base._segments.len() > self._segments.len()) => {
        return(false);
      },
      true => ()
    );
    // Check if all base segments match
    i := usize(0);
    while(i < base._segments.len(), i = (i + usize(1)), {
      self_seg_opt := self._segments.get(i);
      base_seg_opt := base._segments.get(i);
      match(
        self_seg_opt,
        .Some(self_seg) => match(
          base_seg_opt,
          .Some(base_seg) => {
            cond(
              (self_seg == base_seg) => (),
              true => {
                return(false);
              }
            );
          },
          .None => {
            return(false);
          }
        ),
        .None => {
          return(false);
        }
      );
    });
    return(true);
  }),
  /// Check if this path ends with the given suffix path (segment-wise).
  ends_with : (fn(self : Self, suffix : Self) -> bool)({
    // Suffix has more segments than self
    cond(
      (suffix._segments.len() > self._segments.len()) => {
        return(false);
      },
      true => ()
    );
    // If suffix is absolute, it must match exactly
    cond(
      suffix._is_absolute => {
        cond(
          (self._is_absolute != suffix._is_absolute) => {
            return(false);
          },
          true => ()
        );
        cond(
          (self._segments.len() != suffix._segments.len()) => {
            return(false);
          },
          true => ()
        );
      },
      true => ()
    );
    // Check if suffix segments match the end of self
    suffix_len := suffix._segments.len();
    self_len := self._segments.len();
    offset := (self_len - suffix_len);
    i := usize(0);
    while(i < suffix_len, i = (i + usize(1)), {
      self_seg_opt := self._segments.get(offset + i);
      suffix_seg_opt := suffix._segments.get(i);
      match(
        self_seg_opt,
        .Some(self_seg) => match(
          suffix_seg_opt,
          .Some(suffix_seg) => {
            cond(
              (self_seg == suffix_seg) => (),
              true => {
                return(false);
              }
            );
          },
          .None => {
            return(false);
          }
        ),
        .None => {
          return(false);
        }
      );
    });
    return(true);
  }),
  /// Get all path components as a list. Absolute paths start with `"/"`.
  components : (fn(self : Self) -> ArrayList(String))({
    result := ArrayList(String).with_capacity(self._segments.len() + usize(1));
    // Add root component if absolute
    cond(
      self._is_absolute => {
        result.push(String.from("/"));
      },
      true => ()
    );
    // Add all segments
    i := usize(0);
    while(i < self._segments.len(), i = (i + usize(1)), {
      seg := self._segments.get(i);
      match(
        seg,
        .Some(s) => {
          result.push(s);
        },
        .None => ()
      );
    });
    return(result);
  }),
  /// Check if the path is absolute.
  is_absolute : (fn(self : Self) -> bool)(
    self._is_absolute
  ),
  /// Check if the path is relative (not absolute).
  is_relative : (fn(self : Self) -> bool)(
    !self._is_absolute
  ),
  /// Return `self` expressed relative to `base`: drop the segments the two
  /// share, emit one `..` per remaining `base` segment, then the rest of
  /// `self`. Equivalent to node's `path.relative(base, self)`.
  ///
  /// Returns an empty relative path when the two are equal. When `base` and
  /// `self` differ in absoluteness there is no common root to walk from, so
  /// `self` is returned unchanged (node resolves both against the cwd first;
  /// this has no cwd to resolve against).
  strip_prefix : (fn(self : Self, base : Self) -> Self)({
    cond(
      (self._is_absolute != base._is_absolute) => {
        return(self);
      },
      true => ()
    );
    (common : usize) = usize(0);
    (matching : bool) = true;
    while(matching && ((common < base._segments.len()) && (common < self._segments.len())), {
      b := match(base._segments.get(common), .Some(x) => x, .None => String.new());
      t := match(self._segments.get(common), .Some(x) => x, .None => String.new());
      cond(
        (b == t) => {
          common = (common + usize(1));
        },
        true => {
          matching = false;
        }
      );
    });
    segments := ArrayList(String).new();
    (i : usize) = common;
    while(i < base._segments.len(), {
      segments.push(String.from(".."));
      i = (i + usize(1));
    });
    (j : usize) = common;
    while(j < self._segments.len(), {
      match(
        self._segments.get(j),
        .Some(seg) => {
          segments.push(seg);
        },
        .None => ()
      );
      j = (j + usize(1));
    });
    Self(_segments : segments, _is_absolute : false)
  })
);
impl(
  Path,
  ToString(
    to_string : (
      self -> {
        segments := self._segments;
        sep := String.from("/");
        result := String.new();
        // A relative path with no segments is the CURRENT DIRECTORY and must
        // render as "." — `stat("")` is ENOENT, which made `yo test .` /
        // `yo check .` fail with a bare "file or directory not found". This
        // is a RENDER-level rule (Node: path.normalize(".") === "." and
        // path.dirname("foo") === "."): the empty-segment representation is
        // untouched, so join/parent/relative_from keep their semantics.
        if(!self._is_absolute && (segments.len() == usize(0)), {
          return(String.from("."));
        });
        // Check if first segment is a Windows drive letter (e.g., "C:")
        has_drive_letter := cond(
          (segments.len() > usize(0)) => {
            first_seg_opt := segments.get(usize(0));
            match(
              first_seg_opt,
              .Some(first_seg) =>
                // Check if it's a drive letter like "C:"
                cond(
                  (first_seg.len() == usize(2)) => {
                    b0_opt := first_seg.as_bytes().get(usize(0));
                    b1_opt := first_seg.as_bytes().get(usize(1));
                    match(
                      b0_opt,
                      .Some(b0) => match(
                        b1_opt,
                        .Some(b1) => {
                          is_letter := (((b0 >= u8(65)) && (b0 <= u8(90))) || ((b0 >= u8(97)) && (b0 <= u8(122))));
                          is_colon := (b1 == u8(58));
                          is_letter && is_colon
                        },
                        .None => false
                      ),
                      .None => false
                    )
                  },
                  true => false
                ),
              .None => false
            )
          },
          true => false
        );
        // For Unix absolute paths, prepend /
        // For Windows paths with drive letter, don't prepend /
        cond(
          (self._is_absolute && !has_drive_letter) => {
            result = result.concat(sep);
          },
          true => ()
        );
        i := usize(0);
        segments_len := segments.len();
        while(i < segments_len, i = (i + usize(1)), {
          seg := segments.get(i);
          match(
            seg,
            .Some(s) => {
              result = result.concat(s);
              cond(
                (i < (segments_len - usize(1))) => {
                  result = result.concat(sep);
                },
                true => ()
              );
            },
            .None => ()
          );
        });
        return(result);
      }
    )
  )
);
impl(
  Path,
  Eq(Path)(
    (==) : (
      (self, other) -> {
        // Compare absolute vs relative
        cond(
          (self._is_absolute != other._is_absolute) => {
            return(false);
          },
          true => ()
        );
        // Compare segment lengths
        cond(
          (self._segments.len() != other._segments.len()) => {
            return(false);
          },
          true => ()
        );
        // Compare each segment
        i := usize(0);
        while(i < self._segments.len(), i = (i + usize(1)), {
          self_seg_opt := self._segments.get(i);
          other_seg_opt := other._segments.get(i);
          match(
            self_seg_opt,
            .Some(self_seg) => match(
              other_seg_opt,
              .Some(other_seg) => {
                cond(
                  (self_seg == other_seg) => (),
                  true => {
                    return(false);
                  }
                );
              },
              .None => {
                return(false);
              }
            ),
            .None => {
              return(false);
            }
          );
        });
        return(true);
      }
    )
  )
);
/// Deep copy (audit path row: `Clone` — a `ref` type needs an explicit impl;
/// sharing the RC handle via assignment is NOT a copy and would alias
/// mutations through the segment list).
impl(
  Path,
  Clone(
    clone : (fn(inout(self) : Self) -> Self)({
      segments := ArrayList(String).with_capacity(self._segments.len());
      (n : usize) = self._segments.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          self._segments.get(i),
          .Some(seg) => {
            _p := segments.push(seg.clone());
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      Self(_segments : segments, _is_absolute : self._is_absolute)
    })
  )
);
/// Hash over the segments plus the absolute flag (audit path row: `Hash` —
/// makes Path usable as a HashMap key). Consistent with `Eq(Path)`: equal
/// paths hash equal.
impl(
  Path,
  Hash(
    hash : (fn(generic(H : Type), inout(self) : Self, inout(hasher) : H, where(H <: Hasher)) -> unit)({
      hasher.write_u8(if(self._is_absolute, u8(1), u8(0)));
      (n : usize) = self._segments.len();
      hasher.write_usize(n);
      (i : usize) = usize(0);
      while(i < n, {
        match(
          self._segments.get(i),
          .Some(seg) => {
            (rb : RawSlice(u8)) = seg.raw_bytes();
            hasher.write(rb.ptr, rb.len);
            // Terminator, so adjacent segments stay prefix-free.
            hasher.write_u8(u8(47));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    })
  )
);
/// Ordering by the normalized rendering (audit path row: `Ord`) — a total
/// order suitable for sorted collections; NOT a promise about platform
/// collation.
impl(
  Path,
  Ord(Path)(
    (<) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.to_string() < rhs.to_string()
    ),
    (<=) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.to_string() <= rhs.to_string()
    ),
    (>) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.to_string() > rhs.to_string()
    ),
    (>=) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.to_string() >= rhs.to_string()
    )
  )
);
/// Extend this path IN PLACE with `other` (audit path row: `push` —
/// Rust's `PathBuf::push`). Takes any `ToString` like `join`. An absolute
/// `other` replaces the contents entirely, exactly like `join`.
impl(
  Path,
  push : (fn(generic(P : Type), inout(self) : Self, other : P, where(P <: ToString)) -> unit)({
    joined := self._join_path(Path.new(other.to_string()));
    self._segments.clear();
    _e := self._segments.extend(joined._segments);
    self._is_absolute = joined._is_absolute;
  })
);
/// This path and every ancestor, starting with `self` and ending at the
/// root (`/`) for absolute paths or the empty relative path (audit path
/// row: `ancestors` — Rust yields an iterator; this materializes the list,
/// walker-style). `"a/b/c"` → `a/b/c`, `a/b`, `a`; `/x` → `/x`, `/`.
impl(
  Path,
  ancestors : (fn(self : Self) -> ArrayList(Self))({
    out := ArrayList(Self).new();
    cur := self.clone();
    _p := out.push(cur.clone());
    while(true, {
      nxt := cur.parent();
      // `parent` of a single relative segment is the EMPTY relative path
      // (renders "."); Rust's `ancestors` stops before it, as do we. The
      // absolute root ("/", zero segments + absolute) IS yielded.
      stop := match(
        nxt,
        .Some(n) =>
          cond(
            ((n._segments.len() == usize(0)) && !n._is_absolute) => true,
            true => {
              _p2 := out.push(n.clone());
              cur = n;
              false
            }
          ),
        .None => true
      );
      if(stop, {
        return(out);
      });
    });
    out
  })
);
export(Path);
// ============================================================================
// PATH environment-variable helpers (audit path row: PATH split/join —
// Rust's std::env::split_paths / join_paths, placed with the delimiter).
// ============================================================================
/// Split a `PATH`-style string (`"/usr/bin:/bin"` on Unix, `;`-separated on
/// Windows) into its `Path` components. Empty segments are dropped.
split_paths :: (fn(s : String) -> ArrayList(Path))({
  parts := s.split(rune(u32(PATH_DELIMITER)));
  out := ArrayList(Path).new();
  i := usize(0);
  while(i < parts.len(), i = (i + usize(1)), {
    part := parts.get(i).unwrap_or(String.new());
    cond(
      part.is_empty() => (),
      true => {
        _p := out.push(Path.new(part.clone()));
      }
    );
  });
  out
});
/// Join paths back into a `PATH`-style string with the platform delimiter.
join_paths :: (fn(paths : ArrayList(Path)) -> String)({
  out := String.new();
  i := usize(0);
  while(i < paths.len(), i = (i + usize(1)), {
    p := paths.get(i).unwrap_or(Path.new(String.new()));
    if(i > usize(0), {
      _c := out.push_byte(u8(PATH_DELIMITER));
    });
    _a := out.push_string(p.to_string());
  });
  out
});
export(split_paths, join_paths);
