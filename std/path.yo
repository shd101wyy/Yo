//! Cross-platform filesystem path manipulation.
pragma(Pragma.AllowUnsafe);
open(import("./string"));
open(import("./fmt"));
open(import("./collections/array_list"));
/// Platform-specific path separator: `'/'` on Unix, `'\\'` on Windows.
PATH_SEPARATOR :: cond(
  (__yo_process_platform() == "windows") => u8(92),
  // '\' for Windows
  true => u8(47) // '/' for Unix
);
export(PATH_SEPARATOR);
/// Platform-specific path list delimiter: `':'` on Unix, `';'` on Windows.
PATH_DELIMITER :: cond(
  (__yo_process_platform() == "windows") => u8(59),
  // ';' for Windows
  true => u8(58) // ':' for Unix
);
export(PATH_DELIMITER);
/// Filesystem path with segment-based operations.
///
/// **Components are recorded as written.** Empty components (repeated or
/// trailing separators) and `.` components are dropped — dropping either can
/// never change which file the path names. `..` is **kept**: folding `a/b/..`
/// to `a` is only correct when `b` is not a symlink, so the fold is opt-in via
/// `normalize()`. `new`, `join` and `push` therefore all agree — none of them
/// folds. Use `fs.canonicalize` when the filesystem must be consulted.
///
/// `_prefix` holds a root marker that is not a bare `/`: a Windows drive
/// (`C:`) or a UNC share (`\\server\share`). Both imply an absolute path and
/// neither is ever popped by `normalize()` or rewritten by `with_file_name` /
/// `with_extension`.
Path :: ref(
  struct(
    _prefix : String,
    _segments : ArrayList(String),
    _is_absolute : bool
  )
);
impl(
  Path,
  /// Create a new path from a string. Normalizes separators, drops empty and
  /// `.` components, and records `..` verbatim (see the type doc: folding `..`
  /// is `normalize()`'s job, because it is wrong over symlinks).
  ///
  /// Two leading BACKSLASHES are a Windows UNC share: the `\\server\share`
  /// root is kept whole in `_prefix`. `//a/b` is NOT a UNC path — on POSIX
  /// that is an ordinary root with a redundant separator.
  new : (fn(path_str : String) -> Self)({
    segments := ArrayList(String).new();
    (prefix : String) = String.new();
    (is_abs : bool) = false;
    // Handle empty path early
    cond(
      path_str.is_empty() => {
        return(Self(_prefix : prefix, _segments : segments, _is_absolute : is_abs));
      },
      true => ()
    );
    // A UNC share is spelled with backslashes on every platform, so detect it
    // on the ORIGINAL string — before separators are folded to `/`.
    is_unc := path_str.starts_with(String.from("\\\\"));
    // Normalize backslashes to forward slashes for cross-platform support
    normalized := path_str.replace_all(String.from("\\"), String.from("/"));
    // Windows drive letter (`C:`): the root marker, not a segment.
    (is_drive : bool) = false;
    cond(
      (normalized.len() >= usize(2)) => {
        b0 := normalized.byte_at(usize(0));
        b1 := normalized.byte_at(usize(1));
        is_letter := (((b0 >= u8(65)) && (b0 <= u8(90))) || ((b0 >= u8(97)) && (b0 <= u8(122))));
        is_drive = (is_letter && (b1 == u8(58)));
      },
      true => ()
    );
    // `unc_take` diverts the first two non-empty components (server, share)
    // into the prefix; everything after them is an ordinary segment.
    (unc_take : usize) = usize(0);
    (body : String) = normalized.clone();
    cond(
      is_unc => {
        is_abs = true;
        unc_take = usize(2);
      },
      is_drive => {
        is_abs = true;
        prefix = normalized.substring(usize(0), usize(2));
        body = normalized.substring(usize(2), normalized.len());
      },
      true => {
        is_abs = normalized.starts_with(String.from("/"));
      }
    );
    // Split path by "/" separator (backslashes already normalized)
    sep := String.from("/");
    parts := body.split(sep);
    dot := String.from(".");
    // Process each part
    i := usize(0);
    while(i < parts.len(), i = (i + usize(1)), {
      part_opt := parts.get(i);
      match(
        part_opt,
        .Some(part) => {
          cond(
            // Skip empty segments (from leading/trailing/repeated slashes)
            part.is_empty() => (),
            (unc_take > usize(0)) => {
              // `\\` before the server, a single `\` before the share.
              cond(
                prefix.is_empty() => {
                  _b0 := prefix.push_byte(u8(92));
                  _b1 := prefix.push_byte(u8(92));
                },
                true => {
                  _b2 := prefix.push_byte(u8(92));
                }
              );
              _ps := prefix.push_string(part);
              unc_take = (unc_take - usize(1));
            },
            // Skip "." — it always denotes the directory itself, so dropping
            // it cannot change which file the path names (unlike "..").
            (part == dot) => (),
            true => {
              segments.push(part);
            }
          );
        },
        .None => ()
      );
    });
    return(Self(_prefix : prefix, _segments : segments, _is_absolute : is_abs));
  }),
  /// Create a path from a C string pointer.
  from_cstr : (fn(cstr : *u8) -> Self)({
    str_result := String.from_cstr(cstr);
    match(
      str_result,
      .Ok(s) => {
        return(Self.new(s));
      },
      .Err(_) => {
        // Return empty path on error
        return(Self(_prefix : String.new(), _segments : ArrayList(String).new(), _is_absolute : false));
      }
    );
  }),
  /// Join this path with another. If `other` is absolute, returns `other`.
  /// Join with any `ToString` — a `str`/`String` literal or another `Path`
  /// (audit path row: `join(str)`). `Path` round-trips through `new`
  /// losslessly (its rendering re-parses to the same components), so the
  /// generic facade is semantics-preserving for existing `Path` callers.
  ///
  /// `other`'s components are APPENDED, `..` included: `"a/b".join("../c")`
  /// is `a/b/../c`, matching what `Path.new("a/b/../c")` records. Call
  /// `normalize()` on the result for the lexical fold.
  join : (fn(generic(P : Type), self : Self, other : P, where(P <: ToString)) -> Self)(
    self._join_path(Path.new(other.to_string()))
  ),
  _join_path : (fn(self : Self, other : Self) -> Self)({
    // If other is absolute, return other
    cond(
      other._is_absolute => {
        return(other);
      },
      true => ()
    );
    // Otherwise, concatenate segments
    new_segments := ArrayList(String).with_capacity(self._segments.len() + other._segments.len());
    // Copy self segments
    i := usize(0);
    while(i < self._segments.len(), i = (i + usize(1)), {
      seg := self._segments.get(i);
      match(
        seg,
        .Some(s) => {
          new_segments.push(s);
        },
        .None => ()
      );
    });
    // Copy other segments
    j := usize(0);
    while(j < other._segments.len(), j = (j + usize(1)), {
      seg := other._segments.get(j);
      match(
        seg,
        .Some(s) => {
          new_segments.push(s);
        },
        .None => ()
      );
    });
    return(Self(_prefix : self._prefix.clone(), _segments : new_segments, _is_absolute : self._is_absolute));
  }),
  /// Fold `..` LEXICALLY: each `..` pops the component before it.
  ///
  /// This is the OPT-IN half of the model `new`/`join`/`push` implement — it
  /// is **not** valid whenever a popped component is a symlink, because
  /// `a/b/../c` and `a/c` then name different files. Use `fs.canonicalize`
  /// (which asks the filesystem) when that matters; use this when a purely
  /// lexical answer is what you want, e.g. to key a cache on one spelling.
  ///
  /// A leading `..` on a RELATIVE path is PRESERVED — there is nothing before
  /// it to pop, and dropping it is what silently turned an escaping path into
  /// a non-escaping one. On an ABSOLUTE path it folds away, because `/..` is
  /// `/`; a drive or UNC root (`_prefix`) is never popped either.
  normalize : (fn(self : Self) -> Self)({
    out := ArrayList(String).with_capacity(self._segments.len());
    dotdot := String.from("..");
    i := usize(0);
    while(i < self._segments.len(), i = (i + usize(1)), {
      seg := self._segments.get(i).unwrap_or(String.new());
      cond(
        (seg == dotdot) => {
          // Only a NORMAL component can be popped; a `..` already on the
          // output is a component this path could not resolve either.
          (top_is_dotdot : bool) = false;
          cond(
            (out.len() > usize(0)) => {
              top_is_dotdot = (out.get(out.len() - usize(1)).unwrap_or(String.new()) == dotdot);
            },
            true => ()
          );
          (can_pop : bool) = ((out.len() > usize(0)) && !top_is_dotdot);
          cond(
            can_pop => {
              out.pop();
            },
            self._is_absolute => (),
            true => {
              out.push(seg);
            }
          );
        },
        true => {
          out.push(seg);
        }
      );
    });
    return(Self(_prefix : self._prefix.clone(), _segments : out, _is_absolute : self._is_absolute));
  }),
  /// Get the parent directory path, or `.None` if there are no segments.
  parent : (fn(self : Self) -> Option(Self))({
    cond(
      (self._segments.len() == usize(0)) => {
        return(.None);
      },
      true => ()
    );
    new_segments := ArrayList(String).with_capacity(self._segments.len() - usize(1));
    i := usize(0);
    while(i < (self._segments.len() - usize(1)), i = (i + usize(1)), {
      seg := self._segments.get(i);
      match(
        seg,
        .Some(s) => {
          new_segments.push(s);
        },
        .None => ()
      );
    });
    return(.Some(Self(_prefix : self._prefix.clone(), _segments : new_segments, _is_absolute : self._is_absolute)));
  }),
  /// Get the last path segment (filename), or `.None` for empty paths.
  file_name : (fn(self : Self) -> Option(String))({
    cond(
      (self._segments.len() == usize(0)) => {
        return(.None);
      },
      true => ()
    );
    return(self._segments.get(self._segments.len() - usize(1)));
  }),
  /// Get the filename without its extension, or `.None` for empty paths.
  file_stem : (fn(self : Self) -> Option(String))({
    name_opt := self.file_name();
    match(
      name_opt,
      .Some(name) => {
        // Find the last dot using String methods
        dot := String.from(".");
        last_dot_result := name.last_index_of(dot);
        match(
          last_dot_result,
          .Some(idx) => {
            // Return substring before the dot
            stem := name.substring(usize(0), idx);
            return(.Some(stem));
          },
          .None => {
            // No dot found, return the whole name
            return(.Some(name));
          }
        );
      },
      .None => {
        return(.None);
      }
    );
  }),
  /// Get the file extension (without the dot), or `.None` if there is none.
  extension : (fn(self : Self) -> Option(String))({
    name_opt := self.file_name();
    match(
      name_opt,
      .Some(name) => {
        // Find the last dot using String methods
        dot := String.from(".");
        last_dot_result := name.last_index_of(dot);
        match(
          last_dot_result,
          .Some(idx) => {
            // Return substring after the dot
            ext := name.substring(idx + usize(1), name.len());
            cond(
              ext.is_empty() => {
                return(.None);
              },
              true => {
                return(.Some(ext));
              }
            );
          },
          .None => {
            // No dot found, no extension
            return(.None);
          }
        );
      },
      .None => {
        return(.None);
      }
    );
  }),
  /// Return a new path with the extension replaced by `ext`.
  with_extension : (fn(self : Self, ext : String) -> Self)({
    cond(
      (self._segments.len() == usize(0)) => {
        return(self);
      },
      true => ()
    );
    // Get the file stem
    stem_opt := self.file_stem();
    match(
      stem_opt,
      .Some(stem) => {
        // Build new file name with extension
        dot := String.from(".");
        new_name := stem.concat(dot).concat(ext);
        // Replace the last segment
        new_segments := ArrayList(String).with_capacity(self._segments.len());
        i := usize(0);
        while(i < (self._segments.len() - usize(1)), i = (i + usize(1)), {
          seg := self._segments.get(i);
          match(
            seg,
            .Some(s) => {
              new_segments.push(s);
            },
            .None => ()
          );
        });
        new_segments.push(new_name);
        return(Self(_prefix : self._prefix.clone(), _segments : new_segments, _is_absolute : self._is_absolute));
      },
      .None => {
        return(self);
      }
    );
  }),
  /// Return a new path with the last segment replaced by `name`.
  with_file_name : (fn(self : Self, name : String) -> Self)({
    cond(
      (self._segments.len() == usize(0)) => {
        // Empty path, just return a new path with the name
        segments := ArrayList(String).new();
        segments.push(name);
        return(Self(_prefix : self._prefix.clone(), _segments : segments, _is_absolute : self._is_absolute));
      },
      true => ()
    );
    // Replace the last segment
    new_segments := ArrayList(String).with_capacity(self._segments.len());
    i := usize(0);
    while(i < (self._segments.len() - usize(1)), i = (i + usize(1)), {
      seg := self._segments.get(i);
      match(
        seg,
        .Some(s) => {
          new_segments.push(s);
        },
        .None => ()
      );
    });
    new_segments.push(name);
    return(Self(_prefix : self._prefix.clone(), _segments : new_segments, _is_absolute : self._is_absolute));
  }),
  /// Check if this path starts with the given base path (segment-wise).
  starts_with : (fn(self : Self, base : Self) -> bool)({
    // Absolute vs relative mismatch, or a different root (drive / UNC share)
    cond(
      (self._is_absolute != base._is_absolute) => {
        return(false);
      },
      true => ()
    );
    cond(
      (self._prefix != base._prefix) => {
        return(false);
      },
      true => ()
    );
    // Base has more segments than self
    cond(
      (base._segments.len() > self._segments.len()) => {
        return(false);
      },
      true => ()
    );
    // Check if all base segments match
    i := usize(0);
    while(i < base._segments.len(), i = (i + usize(1)), {
      self_seg_opt := self._segments.get(i);
      base_seg_opt := base._segments.get(i);
      match(
        self_seg_opt,
        .Some(self_seg) => match(
          base_seg_opt,
          .Some(base_seg) => {
            cond(
              (self_seg == base_seg) => (),
              true => {
                return(false);
              }
            );
          },
          .None => {
            return(false);
          }
        ),
        .None => {
          return(false);
        }
      );
    });
    return(true);
  }),
  /// Check if this path ends with the given suffix path (segment-wise).
  ends_with : (fn(self : Self, suffix : Self) -> bool)({
    // Suffix has more segments than self
    cond(
      (suffix._segments.len() > self._segments.len()) => {
        return(false);
      },
      true => ()
    );
    // If suffix is absolute, it must match exactly
    cond(
      suffix._is_absolute => {
        cond(
          (self._is_absolute != suffix._is_absolute) => {
            return(false);
          },
          true => ()
        );
        cond(
          (self._prefix != suffix._prefix) => {
            return(false);
          },
          true => ()
        );
        cond(
          (self._segments.len() != suffix._segments.len()) => {
            return(false);
          },
          true => ()
        );
      },
      true => ()
    );
    // Check if suffix segments match the end of self
    suffix_len := suffix._segments.len();
    self_len := self._segments.len();
    offset := (self_len - suffix_len);
    i := usize(0);
    while(i < suffix_len, i = (i + usize(1)), {
      self_seg_opt := self._segments.get(offset + i);
      suffix_seg_opt := suffix._segments.get(i);
      match(
        self_seg_opt,
        .Some(self_seg) => match(
          suffix_seg_opt,
          .Some(suffix_seg) => {
            cond(
              (self_seg == suffix_seg) => (),
              true => {
                return(false);
              }
            );
          },
          .None => {
            return(false);
          }
        ),
        .None => {
          return(false);
        }
      );
    });
    return(true);
  }),
  /// Get all path components as a list. The first component is the ROOT when
  /// there is one: the drive / UNC share for a prefixed path, `"/"` for a
  /// plain absolute path, nothing for a relative one.
  components : (fn(self : Self) -> ArrayList(String))({
    result := ArrayList(String).with_capacity(self._segments.len() + usize(1));
    // Add the root component: the drive / UNC share when there is one (it IS
    // the root), otherwise `/` for a plain absolute path.
    cond(
      !self._prefix.is_empty() => {
        result.push(self._prefix.clone());
      },
      self._is_absolute => {
        result.push(String.from("/"));
      },
      true => ()
    );
    // Add all segments
    i := usize(0);
    while(i < self._segments.len(), i = (i + usize(1)), {
      seg := self._segments.get(i);
      match(
        seg,
        .Some(s) => {
          result.push(s);
        },
        .None => ()
      );
    });
    return(result);
  }),
  /// Check if the path is absolute.
  is_absolute : (fn(self : Self) -> bool)(
    self._is_absolute
  ),
  /// Check if the path is relative (not absolute).
  is_relative : (fn(self : Self) -> bool)(
    !self._is_absolute
  ),
  /// Return `self` expressed relative to `base`: drop the segments the two
  /// share, emit one `..` per remaining `base` segment, then the rest of
  /// `self`. Equivalent to node's `path.relative(base, self)`.
  ///
  /// Returns an empty relative path when the two are equal. When `base` and
  /// `self` differ in absoluteness there is no common root to walk from, so
  /// `self` is returned unchanged (node resolves both against the cwd first;
  /// this has no cwd to resolve against).
  strip_prefix : (fn(self : Self, base : Self) -> Self)({
    cond(
      (self._is_absolute != base._is_absolute) => {
        return(self);
      },
      true => ()
    );
    cond(
      (self._prefix != base._prefix) => {
        return(self);
      },
      true => ()
    );
    (common : usize) = usize(0);
    (matching : bool) = true;
    while(matching && ((common < base._segments.len()) && (common < self._segments.len())), {
      b := match(base._segments.get(common), .Some(x) => x, .None => String.new());
      t := match(self._segments.get(common), .Some(x) => x, .None => String.new());
      cond(
        (b == t) => {
          common = (common + usize(1));
        },
        true => {
          matching = false;
        }
      );
    });
    segments := ArrayList(String).new();
    (i : usize) = common;
    while(i < base._segments.len(), {
      segments.push(String.from(".."));
      i = (i + usize(1));
    });
    (j : usize) = common;
    while(j < self._segments.len(), {
      match(
        self._segments.get(j),
        .Some(seg) => {
          segments.push(seg);
        },
        .None => ()
      );
      j = (j + usize(1));
    });
    Self(_prefix : String.new(), _segments : segments, _is_absolute : false)
  })
);
impl(
  Path,
  ToString(
    to_string : (
      self -> {
        segments := self._segments;
        result := String.new();
        // A relative path with no segments is the CURRENT DIRECTORY and must
        // render as "." — `stat("")` is ENOENT, which made `yo test .` /
        // `yo check .` fail with a bare "file or directory not found". This
        // is a RENDER-level rule (Node: path.normalize(".") === "." and
        // path.dirname("foo") === "."): the empty-segment representation is
        // untouched, so join/parent/relative_from keep their semantics.
        if(!self._is_absolute && (segments.len() == usize(0)), {
          return(String.from("."));
        });
        // A UNC path has no forward-slash spelling worth emitting — its root
        // IS `\\server\share` — so it renders in the Windows spelling
        // throughout. Every other path keeps the module's `/` rendering (the
        // "Windows separator in to_string" audit item is unaffected).
        has_prefix := !self._prefix.is_empty();
        is_unc := self._prefix.starts_with(String.from("\\"));
        sep := cond(
          is_unc => String.from("\\"),
          true => String.from("/")
        );
        // A drive / UNC root IS the prefix; a plain absolute path's root is a
        // leading separator.
        cond(
          has_prefix => {
            result = result.concat(self._prefix);
          },
          self._is_absolute => {
            result = result.concat(sep);
          },
          true => ()
        );
        i := usize(0);
        segments_len := segments.len();
        while(i < segments_len, i = (i + usize(1)), {
          seg := segments.get(i);
          match(
            seg,
            .Some(s) => {
              // The plain-absolute root already emitted its separator; every
              // other position needs one before the segment.
              cond(
                ((i > usize(0)) || has_prefix) => {
                  result = result.concat(sep);
                },
                true => ()
              );
              result = result.concat(s);
            },
            .None => ()
          );
        });
        return(result);
      }
    )
  )
);
impl(
  Path,
  Eq(Path)(
    (==) : (
      (self, other) -> {
        // Compare absolute vs relative, and the root (drive / UNC share)
        cond(
          (self._is_absolute != other._is_absolute) => {
            return(false);
          },
          true => ()
        );
        cond(
          (self._prefix != other._prefix) => {
            return(false);
          },
          true => ()
        );
        // Compare segment lengths
        cond(
          (self._segments.len() != other._segments.len()) => {
            return(false);
          },
          true => ()
        );
        // Compare each segment
        i := usize(0);
        while(i < self._segments.len(), i = (i + usize(1)), {
          self_seg_opt := self._segments.get(i);
          other_seg_opt := other._segments.get(i);
          match(
            self_seg_opt,
            .Some(self_seg) => match(
              other_seg_opt,
              .Some(other_seg) => {
                cond(
                  (self_seg == other_seg) => (),
                  true => {
                    return(false);
                  }
                );
              },
              .None => {
                return(false);
              }
            ),
            .None => {
              return(false);
            }
          );
        });
        return(true);
      }
    )
  )
);
/// Deep copy (audit path row: `Clone` — a `ref` type needs an explicit impl;
/// sharing the RC handle via assignment is NOT a copy and would alias
/// mutations through the segment list).
impl(
  Path,
  Clone(
    clone : (fn(inout(self) : Self) -> Self)({
      segments := ArrayList(String).with_capacity(self._segments.len());
      (n : usize) = self._segments.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          self._segments.get(i),
          .Some(seg) => {
            _p := segments.push(seg.clone());
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      Self(_prefix : self._prefix.clone(), _segments : segments, _is_absolute : self._is_absolute)
    })
  )
);
/// Hash over the segments plus the absolute flag (audit path row: `Hash` —
/// makes Path usable as a HashMap key). Consistent with `Eq(Path)`: equal
/// paths hash equal.
impl(
  Path,
  Hash(
    hash : (fn(generic(H : Type), inout(self) : Self, inout(hasher) : H, where(H <: Hasher)) -> unit)({
      hasher.write_u8(if(self._is_absolute, u8(1), u8(0)));
      (pb : RawSlice(u8)) = self._prefix.raw_bytes();
      hasher.write(pb.ptr, pb.len);
      // Terminator, so the root stays prefix-free against the first segment.
      hasher.write_u8(u8(47));
      (n : usize) = self._segments.len();
      hasher.write_usize(n);
      (i : usize) = usize(0);
      while(i < n, {
        match(
          self._segments.get(i),
          .Some(seg) => {
            (rb : RawSlice(u8)) = seg.raw_bytes();
            hasher.write(rb.ptr, rb.len);
            // Terminator, so adjacent segments stay prefix-free.
            hasher.write_u8(u8(47));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    })
  )
);
/// Ordering by the rendering (audit path row: `Ord`) — a total
/// order suitable for sorted collections; NOT a promise about platform
/// collation.
impl(
  Path,
  Ord(Path)(
    (<) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.to_string() < rhs.to_string()
    ),
    (<=) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.to_string() <= rhs.to_string()
    ),
    (>) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.to_string() > rhs.to_string()
    ),
    (>=) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs.to_string() >= rhs.to_string()
    )
  )
);
/// Extend this path IN PLACE with `other` (audit path row: `push` —
/// Rust's `PathBuf::push`). Takes any `ToString` like `join`. An absolute
/// `other` replaces the contents entirely, exactly like `join`, and `..` in
/// `other` is appended rather than folded, exactly like `join`.
impl(
  Path,
  push : (fn(generic(P : Type), inout(self) : Self, other : P, where(P <: ToString)) -> unit)({
    joined := self._join_path(Path.new(other.to_string()));
    self._segments.clear();
    _e := self._segments.extend(joined._segments);
    self._is_absolute = joined._is_absolute;
    self._prefix = joined._prefix.clone();
  })
);
/// This path and every ancestor, starting with `self` and ending at the
/// root (`/`) for absolute paths or the empty relative path (audit path
/// row: `ancestors` — Rust yields an iterator; this materializes the list,
/// walker-style). `"a/b/c"` → `a/b/c`, `a/b`, `a`; `/x` → `/x`, `/`.
impl(
  Path,
  ancestors : (fn(self : Self) -> ArrayList(Self))({
    out := ArrayList(Self).new();
    cur := self.clone();
    _p := out.push(cur.clone());
    while(true, {
      nxt := cur.parent();
      // `parent` of a single relative segment is the EMPTY relative path
      // (renders "."); Rust's `ancestors` stops before it, as do we. The
      // absolute root ("/", zero segments + absolute) IS yielded.
      stop := match(
        nxt,
        .Some(n) =>
          cond(
            ((n._segments.len() == usize(0)) && !n._is_absolute) => true,
            true => {
              _p2 := out.push(n.clone());
              cur = n;
              false
            }
          ),
        .None => true
      );
      if(stop, {
        return(out);
      });
    });
    out
  })
);
export(Path);
// ============================================================================
// PATH environment-variable helpers (audit path row: PATH split/join —
// Rust's std::env::split_paths / join_paths, placed with the delimiter).
// ============================================================================
/// Split a `PATH`-style string (`"/usr/bin:/bin"` on Unix, `;`-separated on
/// Windows) into its `Path` components. Empty segments are dropped.
split_paths :: (fn(s : String) -> ArrayList(Path))({
  parts := s.split(rune(u32(PATH_DELIMITER)));
  out := ArrayList(Path).new();
  i := usize(0);
  while(i < parts.len(), i = (i + usize(1)), {
    part := parts.get(i).unwrap_or(String.new());
    cond(
      part.is_empty() => (),
      true => {
        _p := out.push(Path.new(part.clone()));
      }
    );
  });
  out
});
/// Join paths back into a `PATH`-style string with the platform delimiter.
join_paths :: (fn(paths : ArrayList(Path)) -> String)({
  out := String.new();
  i := usize(0);
  while(i < paths.len(), i = (i + usize(1)), {
    p := paths.get(i).unwrap_or(Path.new(String.new()));
    if(i > usize(0), {
      _c := out.push_byte(u8(PATH_DELIMITER));
    });
    _a := out.push_string(p.to_string());
  });
  out
});
export(split_paths, join_paths);
