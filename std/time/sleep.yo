//! Synchronous sleep — blocks the current thread.
//!
//! # Example
//!
//! ```rust
//! { sleep } :: import "std/time/sleep";
//! sleep(usize(100)); // sleep 100ms
//! ```

extern "Yo",
  __yo_ms_sleep : (fn(ms: usize) -> unit)
;

/// Block the current thread for the given number of milliseconds.
sleep :: __yo_ms_sleep;

export
  sleep
;
