// std/time/instant.yo - Monotonic clock instant
//
// Instant captures a point in time from the monotonic clock.
// Use it to measure elapsed time. Not suitable for wall-clock times.
//
// Example:
//   { Instant } :: import "std/time/instant";
//
//   start := Instant.now();
//   // ... do work ...
//   elapsed := start.elapsed();
//   println(elapsed.as_millis());

{ Duration } :: import "./duration";
{ CLOCK_MONOTONIC, clock_gettime } :: import "../io/clock";

// ============================================================================
// Instant - monotonic clock snapshot
// ============================================================================

Instant :: struct(
  secs  : i64,
  nanos : i64
);

impl(Instant,
  // Capture the current monotonic time.
  now : (fn() -> Self)({
    sec  := i64(0);
    nsec := i64(0);
    clock_gettime(CLOCK_MONOTONIC, &sec, &nsec);
    Self(secs: sec, nanos: nsec)
  }),

  // Duration elapsed since this instant was created.
  elapsed : (fn(self: *(Self)) -> Duration)({
    now := Instant.now();
    now.duration_since(self.*)
  }),

  // Duration between this instant and an earlier one.
  // Returns Duration.zero() if `earlier` is actually later.
  duration_since : (fn(self: *(Self), earlier: Instant) -> Duration)({
    self_ns := ((self.secs * i64(1000000000)) + self.nanos);
    earlier_ns := ((earlier.secs * i64(1000000000)) + earlier.nanos);
    cond(
      (self_ns <= earlier_ns) => Duration.zero(),
      true => Duration.from_nanos((self_ns - earlier_ns))
    )
  })
);

export Instant;
