//! Wall-clock date and time, either in UTC or at a FIXED offset from it.
//!
//! A `DateTime` is a broken-down civil date plus a `utc_offset_secs`. It is
//! not zone-aware: the offset is a number of seconds, not a zone identifier,
//! so a value cannot answer "what will this clock read next July" or be
//! converted from one zone to another. `DateTime.now()` asks the C library
//! for the offset in force right now (DST included) and stores that; every
//! other constructor leaves the offset at 0, i.e. UTC.
//!
//! Two conversions look interchangeable and are not: `to_unix` reads the
//! civil fields AS IF they were UTC, while `to_unix_utc` subtracts the offset
//! and so names the actual instant. Reach for `to_unix_utc` unless you know
//! the offset is 0.
//!
//! ## Example
//!
//! ```rust
//! { DateTime } :: import "std/time/datetime";
//!
//! now := DateTime.now_utc();
//! println(now.to_string());   // "2026-02-26T17:41:24Z"
//! ```
//!
//! ## Stability
//!
//! unstable — two things in the surface are unsettled, and one is a live bug.
//!
//! The `to_unix` / `to_unix_utc` pair is a naming trap: `to_unix` is the
//! shorter, more obvious name and is the WRONG one for any value with an
//! offset, which is how `DateTime.now()` returns every value. Renaming
//! `to_unix` to say that it reads the fields as UTC (`to_unix_as_utc`, or
//! making `to_unix` the offset-aware one) is a breaking change nobody has
//! decided yet. The local-offset behaviour of `now()` is itself only one
//! release old — until 2026-09-06 it returned UTC under a local name
//! (`issues/fixed/datetime-now-returned-utc-and-called-it-local.md`).
//!
//! `day_of_week` is wrong for year 0 and returns a `u8` wrap for negative
//! years, because Sakamoto's algorithm needs floored division and C truncates
//! toward zero
//! (`issues/stddoc-io-datetime-day-of-week-wrong-for-non-positive-years.md`).
//! `_validate` never checks the year, so those values reach it through the
//! validating `new`.
//!
//! Beyond that: whether a real time-zone database belongs in `std` (Rust
//! leaves it to `chrono-tz`/`jiff`) decides whether `utc_offset_secs` stays
//! the whole zone story, and the eight public fields are unvalidated where
//! `new` validates, so a struct literal can build a 31st of February that
//! every method here will happily compute on. Freezing follows those three
//! decisions, not a release count.
pragma(Pragma.AllowUnsafe);
{ String } :: import("../string");
{ ToString } :: import("../fmt");
{ Error } :: import("../error");
{ CLOCK_REALTIME, clock_gettime } :: import("../sys/clock");
{ localtime_r } :: import("../libc/time");
{ platform, Platform } :: import("../process");
{ snprintf } :: import("../libc/stdio");
{ panic } :: import("../assert");
{ Duration } :: import("./duration");
{ ArrayList } :: import("../collections/array_list");
/// Calendar date and time with nanosecond precision.
/// Values are in UTC unless `utc_offset_secs` is non-zero.
///
/// The fields are public and are NOT checked on assignment — `DateTime.new`
/// and `DateTime.parse` are the validating entry points. A value built with a
/// struct literal can hold an impossible date, and every method here will
/// compute on it without complaint.
DateTime :: struct(
  /// Proleptic Gregorian year, unbounded and signed (negative years are
  /// years BCE). `_validate` does not range-check it, and `day_of_week` is
  /// wrong for years at or below 0 — see `## Stability`.
  year : i32,
  /// Month, `1..=12`.
  month : u8,
  /// Day of month, `1` through the length of this month in this year
  /// (leap-aware).
  day : u8,
  /// Hour, `0..=23`.
  hour : u8,
  /// Minute, `0..=59`.
  minute : u8,
  /// Second, `0..=60` — 60 is admitted so a leap second parses rather than
  /// being rejected as garbage.
  second : u8,
  /// Nanoseconds within the second, `0..=999_999_999`.
  nanosecond : u32,
  /// Seconds EAST of UTC for the civil fields above; `0` means the value is
  /// UTC. `±86_399` is the accepted range. This is a fixed offset, not a
  /// zone, so it records what the offset WAS at this instant and cannot be
  /// used to convert the value to another zone.
  utc_offset_secs : i32
);
// Days per month lookup (non-leap year)
_DAYS_IN_MONTH :: Array(u8, usize(12))(
  u8(31),
  u8(28),
  u8(31),
  u8(30),
  u8(31),
  u8(30),
  u8(31),
  u8(31),
  u8(30),
  u8(31),
  u8(30),
  u8(31)
);
_is_leap_year :: (fn(y : i32) -> bool)(
  ((y % i32(4)) == i32(0)) && (((y % i32(100)) != i32(0)) || ((y % i32(400)) == i32(0)))
);
// Convert a Unix timestamp (seconds since 1970-01-01 UTC) into date/time fields.
_from_unix_secs :: (fn(secs : i64, nanos : i64) -> DateTime)({
  // Adjust epoch: number of days since Unix epoch
  days := (secs / i64(86400));
  rem := (secs % i64(86400));
  // Normalise negative remainders
  rem_adj := cond(
    (rem < i64(0)) => (rem + i64(86400)),
    true => rem
  );
  days_adj := cond(
    (rem < i64(0)) => (days - i64(1)),
    true => days
  );
  hour := u8(rem_adj / i64(3600));
  min_r := (rem_adj % i64(3600));
  minute := u8(min_r / i64(60));
  second := u8(min_r % i64(60));
  // Gregorian calendar computation starting from 1970-01-01
  // Using the algorithm from days since epoch → year/month/day
  z := (days_adj + i64(719468));
  era := cond(
    (z >= i64(0)) => (z / i64(146097)),
    true => ((z - i64(146096)) / i64(146097))
  );
  doe := (z - (era * i64(146097)));
  yoe := (((doe - (doe / i64(1460))) + (doe / i64(36524))) - (doe / i64(146096)));
  yoe = (yoe / i64(365));
  y := (yoe + (era * i64(400)));
  doy := (doe - (((i64(365) * yoe) + (yoe / i64(4))) - (yoe / i64(100))));
  mp := (((i64(5) * doy) + i64(2)) / i64(153));
  d := (doy - (((i64(153) * mp) + i64(2)) / i64(5)));
  m := cond(
    (mp < i64(10)) => (mp + i64(3)),
    true => (mp - i64(9))
  );
  y2 := cond(
    (m <= i64(2)) => (y + i64(1)),
    true => y
  );
  DateTime(
    year : i32(y2),
    month : u8(m),
    day : u8(d + i64(1)),
    hour : hour,
    minute : minute,
    second : second,
    nanosecond : u32(nanos),
    utc_offset_secs : i32(0)
  )
});
/// The zone offset in force at `secs` (seconds east of UTC, DST included),
/// from the C library's local-time tables: break the instant down with
/// `localtime_r` (`_localtime64_s` on Windows), read the broken-down wall
/// clock back as an epoch AS IF it were UTC, and difference the two. Only the
/// first nine `int` members of `struct tm` are read (`tm_sec` … `tm_isdst`),
/// which every libc we target lays out in that order (glibc, Apple, MSVC,
/// musl/wasi); the buffer is 64 bytes, larger than any of their `struct tm`.
/// Falls back to 0 (UTC) when the conversion fails.
_local_utc_offset :: (fn(secs : i64) -> i32)({
  t := secs;
  tm_buf := Array(i32, usize(16)).fill(i32(0));
  ok := cond(
    (platform == Platform.Windows) => {
      // Package-absolute for the same reason as std/env.yo: a relative import
      // inside a conditional body resolves against the caller's directory.
      { _localtime64_s } :: import("std/libc/windows");
      unsafe(_localtime64_s((*(void))(&tm_buf(usize(0))), &(t))) == int(0)
    },
    true => unsafe(localtime_r((*(void))(&(t)), (*(void))(&tm_buf(usize(0))))).is_some()
  );
  cond(
    ok => (),
    true => {
      return(i32(0));
    }
  );
  (wall : DateTime) = DateTime(
    year : (tm_buf(usize(5)) + i32(1900)),
    month : u8(tm_buf(usize(4)) + i32(1)),
    day : u8(tm_buf(usize(3))),
    hour : u8(tm_buf(usize(2))),
    minute : u8(tm_buf(usize(1))),
    second : u8(tm_buf(usize(0))),
    nanosecond : u32(0),
    utc_offset_secs : i32(0)
  );
  i32(wall.to_unix() - secs)
});
impl(
  DateTime,
  /// The current UTC date and time, with `utc_offset_secs` left at 0 — use
  /// `now()` for the local wall clock.
  ///
  /// Panics if `clock_gettime(CLOCK_REALTIME)` fails, rather than reading as
  /// 1970: a broken clock must not silently yield the epoch
  /// (plans/archive/STD_API_AUDIT.md C10).
  now_utc : (fn() -> Self)({
    sec := i64(0);
    nsec := i64(0);
    rc := clock_gettime(CLOCK_REALTIME, &(sec), &(nsec));
    // cond + panic (not assert) so the message String is only built on the
    // failure path.
    cond(
      (rc == i32(0)) => (),
      true => panic(`DateTime.now_utc: clock_gettime(CLOCK_REALTIME) failed (rc=${rc})`)
    );
    _from_unix_secs(sec, nsec)
  }),
  /// Current LOCAL date/time: the wall clock in the process's zone (`TZ`, else
  /// the system zone) with `utc_offset_secs` set to that zone's offset at this
  /// instant, DST included — so `to_unix_utc` is exact and `to_string` renders
  /// `±HH:MM`. Until 2026-09-06 this returned `now_utc()` under a local name
  /// (issues/fixed/datetime-now-returned-utc-and-called-it-local.md). Where the
  /// C library has no zone information (wasm) the offset is 0.
  now : (fn() -> Self)({
    sec := i64(0);
    nsec := i64(0);
    rc := clock_gettime(CLOCK_REALTIME, &(sec), &(nsec));
    cond(
      (rc == i32(0)) => (),
      true => panic(`DateTime.now: clock_gettime(CLOCK_REALTIME) failed (rc=${rc})`)
    );
    off := _local_utc_offset(sec);
    (local : DateTime) = _from_unix_secs(sec + i64(off), nsec);
    local.utc_offset_secs = off;
    local
  }),
  /// The UTC civil date and time of a Unix timestamp — `utc_offset_secs` is
  /// 0, so the result is UTC even if the caller meant a local instant.
  ///
  /// Negative `secs` (before 1970) work: the day and the within-day remainder
  /// are both normalised toward negative infinity. `nanos` is stored as
  /// given, narrowed to `u32` and NOT normalised or validated — pass a value
  /// already in `[0, 1e9)`, which is what every OS timestamp field supplies.
  /// `DateTime.new` is the constructor that validates.
  from_unix : (fn(secs : i64, nanos : i64) -> Self)(
    _from_unix_secs(secs, nanos)
  ),
  /// Unix seconds obtained by reading the civil fields AS IF they were UTC.
  ///
  /// This IGNORES `utc_offset_secs`, so for any value carrying an offset —
  /// everything `now()` returns — it is not the instant the value names.
  /// `to_unix_utc` is the offset-aware form and is the one to reach for; this
  /// one is useful when you want the wall clock's own epoch reading, which is
  /// how `_local_utc_offset` recovers a zone offset. The sub-second part is
  /// dropped: whole seconds only.
  ///
  /// Exact for negative years too — it is the era-based inverse of
  /// `from_unix`, not a loop.
  to_unix : (fn(inout(self) : Self) -> i64)({
    // Compute days since epoch using the inverse Gregorian algorithm
    y := i64(self.year);
    m := i64(self.month);
    d := i64(self.day);
    y2 := cond(
      (m <= i64(2)) => (y - i64(1)),
      true => y
    );
    era := cond(
      (y2 >= i64(0)) => (y2 / i64(400)),
      true => ((y2 - i64(399)) / i64(400))
    );
    yoe := (y2 - (era * i64(400)));
    mp := cond(
      (m > i64(2)) => (m - i64(3)),
      true => (m + i64(9))
    );
    doy := ((((i64(153) * mp) + i64(2)) / i64(5)) + (d - i64(1)));
    doe := ((((yoe * i64(365)) + (yoe / i64(4))) - (yoe / i64(100))) + doy);
    days := (((era * i64(146097)) + doe) - i64(719468));
    time_secs := (((i64(self.hour) * i64(3600)) + (i64(self.minute) * i64(60))) + i64(self.second));
    (days * i64(86400)) + time_secs
  }),
  /// Whether `year` is a leap year under the proleptic Gregorian rule
  /// (divisible by 4, except centuries not divisible by 400) — so year 0 and
  /// year 2000 are leap years and 1900 is not.
  is_leap_year : (fn(inout(self) : Self) -> bool)(
    _is_leap_year(self.year)
  ),
  /// Day of the week as ISO 8601 numbers the days: `0` = Monday through
  /// `6` = Sunday. Rust's `chrono` spells this `weekday()`.
  ///
  /// Reads the CIVIL fields, so it is the weekday of the wall clock rather
  /// than of the UTC instant — the two differ near midnight for a value with
  /// an offset.
  ///
  /// **Only valid for years 1 and later.** It is Sakamoto's algorithm, which
  /// needs floored division; C truncates toward zero, so year 0 is off by one
  /// and a negative year returns a `u8` wrap outside `0..=6`
  /// (`issues/stddoc-io-datetime-day-of-week-wrong-for-non-positive-years.md`).
  day_of_week : (fn(inout(self) : Self) -> u8)({
    // Tomohiko Sakamoto's algorithm
    t := Array(i32, usize(12))(
      i32(0),
      i32(3),
      i32(2),
      i32(5),
      i32(0),
      i32(3),
      i32(5),
      i32(1),
      i32(4),
      i32(6),
      i32(2),
      i32(4)
    );
    y := cond(
      (i32(self.month) < i32(3)) => (self.year - i32(1)),
      true => self.year
    );
    sum := (((((y + (y / i32(4))) - (y / i32(100))) + (y / i32(400))) + t(usize(i32(self.month) - i32(1)))) + i32(self.day));
    dow := (sum % i32(7));
    // Convert: 0=Sun → remap to 0=Mon
    u8(
      cond(
        (dow == i32(0)) => i32(6),
        true => (dow - i32(1))
      )
    )
  }),
  /// Day of the year, 1-based: `1` on 1 January and `365` (`366` in a leap
  /// year) on 31 December. Leap-aware, and correct for negative years, unlike
  /// `day_of_week` — it only sums month lengths.
  day_of_year : (fn(inout(self) : Self) -> u16)({
    m := i32(self.month);
    d := i32(self.day);
    // Sum days in preceding months
    days := d;
    i := i32(1);
    while(i < m, i = (i + i32(1)), {
      idx := usize(i - i32(1));
      days = (days + i32(_DAYS_IN_MONTH(idx)));
      // Add leap day after Feb in a leap year
      cond(
        ((i == i32(2)) && _is_leap_year(self.year)) => {
          days = (days + i32(1));
        },
        true => ()
      );
    });
    u16(days)
  })
);
impl(
  DateTime,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)({
      // RFC3339 offset rendering: "Z" only for UTC; a non-zero
      // `utc_offset_secs` renders as ±HH:MM. This used to hardcode "Z" for
      // EVERY value, stringifying offset datetimes as if they were UTC
      // (plans/archive/STD_API_AUDIT.md C4).
      buf := Array(u8, usize(48)).fill(u8(0));
      buf_ptr := &(buf(usize(0)));
      cond(
        (self.utc_offset_secs == i32(0)) => {
          unsafe(
            snprintf(
              (*char)(buf_ptr),
              usize(48),
              "%04d-%02u-%02uT%02u:%02u:%02uZ",
              self.year,
              self.month,
              self.day,
              self.hour,
              self.minute,
              self.second
            )
          );
        },
        true => {
          off := self.utc_offset_secs;
          is_neg := (off < i32(0));
          abs_off := cond(is_neg => (i32(0) - off), true => off);
          off_h := (abs_off / i32(3600));
          off_m := ((abs_off % i32(3600)) / i32(60));
          cond(
            is_neg => {
              unsafe(
                snprintf(
                  (*char)(buf_ptr),
                  usize(48),
                  "%04d-%02u-%02uT%02u:%02u:%02u-%02d:%02d",
                  self.year,
                  self.month,
                  self.day,
                  self.hour,
                  self.minute,
                  self.second,
                  off_h,
                  off_m
                )
              );
            },
            true => {
              unsafe(
                snprintf(
                  (*char)(buf_ptr),
                  usize(48),
                  "%04d-%02u-%02uT%02u:%02u:%02u+%02d:%02d",
                  self.year,
                  self.month,
                  self.day,
                  self.hour,
                  self.minute,
                  self.second,
                  off_h,
                  off_m
                )
              );
            }
          );
        }
      );
      String.from_cstr(buf_ptr).unwrap()
    })
  )
);

// ============================================================================
// RFC 3339 parse / format, component ctor, arithmetic, Eq/Ord
// (plans/archive/STD_API_AUDIT.md §7 time row)
// ============================================================================
/// Typed parse/construction errors (D1 style, mirrors PercentError).
DateTimeError :: enum(
  /// The text does not match RFC 3339 `date-time`; `index` is the BYTE
  /// offset where matching failed.
  InvalidFormat(index : usize),
  /// A parsed/constructed component is outside its calendar range; `field`
  /// names it ("month", "day", "hour", "minute", "second", "offset").
  OutOfRange(field : str)
);
/// D1's "an error type is a real enum implementing `Error()`". Nothing in std
/// boxes a `DateTimeError` into an `AnyError` today, but `dyn()` now enforces
/// the bound, so the `Error` half of this derive is what makes the first
/// `throw` of one compile.
derive(
  DateTimeError,
  Error(
    .InvalidFormat => `invalid RFC 3339 date-time at byte ${index.to_string()}`,
    .OutOfRange => `date-time component out of range: ${String.from(field)}`
  )
);
export(DateTimeError);
/// Days in `month` of `year` (leap-aware). 0 for an invalid month.
_days_in :: (fn(year : i32, month : u8) -> u8)(
  cond(
    ((month < u8(1)) || (month > u8(12))) => u8(0),
    ((month == u8(2)) && _is_leap_year(year)) => u8(29),
    true => _DAYS_IN_MONTH(usize(month) - usize(1))
  )
);
/// Range-validate a component set (leap-aware days; second 60 admitted for
/// leap seconds, as RFC 3339 requires; offset within ±23:59).
_validate :: (fn(dt : DateTime) -> Option(DateTimeError))(
  cond(
    ((dt.month < u8(1)) || (dt.month > u8(12))) => Option(DateTimeError).Some(DateTimeError.OutOfRange("month")),
    (
      (dt.day < u8(1)) || (
        dt.day > _days_in(
          dt.year,
          dt.month
        )
      )
    ) => Option(DateTimeError).Some(DateTimeError.OutOfRange("day")),
    (dt.hour > u8(23)) => Option(DateTimeError).Some(DateTimeError.OutOfRange("hour")),
    (dt.minute > u8(59)) => Option(DateTimeError).Some(DateTimeError.OutOfRange("minute")),
    (dt.second > u8(60)) => Option(DateTimeError).Some(DateTimeError.OutOfRange("second")),
    (dt.nanosecond > u32(999999999)) => Option(DateTimeError).Some(DateTimeError.OutOfRange("nanosecond")),
    ((dt.utc_offset_secs > i32(86399)) || (dt.utc_offset_secs < i32(-86399))) => Option(DateTimeError).Some(DateTimeError.OutOfRange("offset")),
    true => Option(DateTimeError).None
  )
);
/// Parse exactly `count` ASCII digits at `at`; .None on any non-digit.
_digits :: (fn(bs : ArrayList(u8), at : usize, count : usize) -> Option(i64))({
  (acc : i64) = i64(0);
  (i : usize) = usize(0);
  while(i < count, i = (i + usize(1)), {
    b := match(bs.get(at + i), .Some(x) => x, .None => u8(0));
    cond(
      ((b < u8(48)) || (b > u8(57))) => {
        return(Option(i64).None);
      },
      true => ()
    );
    acc = ((acc * i64(10)) + i64(b - u8(48)));
  });
  Option(i64).Some(acc)
});
_byte_is :: (fn(bs : ArrayList(u8), at : usize, a : u8, b : u8) -> bool)(
  match(bs.get(at), .Some(x) => ((x == a) || (x == b)), .None => false)
);
impl(
  DateTime,
  /// Component constructor with calendar validation (leap-aware days,
  /// leap-second 60 admitted, offset within a day).
  new : (
    fn(year : i32, month : u8, day : u8, hour : u8, minute : u8, second : u8, (nanosecond : u32) ?= u32(0), (utc_offset_secs : i32) ?= i32(0)) -> Result(DateTime, DateTimeError)
  )({
    dt := DateTime(
      year : year,
      month : month,
      day : day,
      hour : hour,
      minute : minute,
      second : second,
      nanosecond : nanosecond,
      utc_offset_secs : utc_offset_secs
    );
    match(
      _validate(dt),
      .Some(e) => Result(DateTime, DateTimeError).Err(e),
      .None => Result(DateTime, DateTimeError).Ok(dt)
    )
  }),
  /// Parse an RFC 3339 `date-time`: `YYYY-MM-DDTHH:MM:SS[.f...][Z|±HH:MM]`.
  /// Lowercase `t`/`z` are accepted (the RFC permits them); fractional
  /// seconds keep nanosecond precision (digits beyond 9 are truncated);
  /// calendar ranges are validated leap-aware.
  parse : (fn(text : String) -> Result(DateTime, DateTimeError))({
    bs := text.as_bytes();
    n := bs.len();
    err :: (fn(at : usize) -> Result(DateTime, DateTimeError))(
      Result(DateTime, DateTimeError).Err(DateTimeError.InvalidFormat(index : at))
    );
    dash := u8(45);
    colon := u8(58);
    year := match(_digits(bs, usize(0), usize(4)), .Some(v) => v, .None => return(err(usize(0))));
    if(!(_byte_is(bs, usize(4), dash, dash)), return(err(usize(4))));
    month := match(_digits(bs, usize(5), usize(2)), .Some(v) => v, .None => return(err(usize(5))));
    if(!(_byte_is(bs, usize(7), dash, dash)), return(err(usize(7))));
    day := match(_digits(bs, usize(8), usize(2)), .Some(v) => v, .None => return(err(usize(8))));
    // 'T' | 't' | ' ' (the space form is an RFC 3339 §5.6 NOTE allowance).
    sep_ok := (_byte_is(bs, usize(10), u8(84), u8(116)) || _byte_is(bs, usize(10), u8(32), u8(32)));
    if(!(sep_ok), return(err(usize(10))));
    hour := match(_digits(bs, usize(11), usize(2)), .Some(v) => v, .None => return(err(usize(11))));
    if(!(_byte_is(bs, usize(13), colon, colon)), return(err(usize(13))));
    minute := match(_digits(bs, usize(14), usize(2)), .Some(v) => v, .None => return(err(usize(14))));
    if(!(_byte_is(bs, usize(16), colon, colon)), return(err(usize(16))));
    second := match(_digits(bs, usize(17), usize(2)), .Some(v) => v, .None => return(err(usize(17))));
    (at : usize) = usize(19);
    (nanos : i64) = i64(0);
    // Optional fraction: '.' then 1+ digits.
    cond(
      _byte_is(bs, at, u8(46), u8(46)) => {
        at = (at + usize(1));
        (digits_seen : usize) = usize(0);
        (scale : i64) = i64(100000000);
        (going : bool) = true;
        while(going, {
          b := match(bs.get(at), .Some(x) => x, .None => u8(0));
          cond(
            ((b >= u8(48)) && (b <= u8(57))) => {
              if(digits_seen < usize(9), {
                nanos = (nanos + (i64(b - u8(48)) * scale));
                scale = (scale / i64(10));
              });
              digits_seen = (digits_seen + usize(1));
              at = (at + usize(1));
            },
            true => {
              going = false;
            }
          );
        });
        if(digits_seen == usize(0), return(err(at)));
      },
      true => ()
    );
    // Offset: 'Z'/'z' or ±HH:MM. REQUIRED by the grammar.
    (offset : i32) = i32(0);
    cond(
      _byte_is(bs, at, u8(90), u8(122)) => {
        at = (at + usize(1));
      },
      (_byte_is(bs, at, u8(43), u8(43)) || _byte_is(bs, at, dash, dash)) => {
        neg := _byte_is(bs, at, dash, dash);
        oh := match(_digits(bs, at + usize(1), usize(2)), .Some(v) => v, .None => return(err(at + usize(1))));
        if(!(_byte_is(bs, at + usize(3), colon, colon)), return(err(at + usize(3))));
        om := match(_digits(bs, at + usize(4), usize(2)), .Some(v) => v, .None => return(err(at + usize(4))));
        if(om > i64(59), return(Result(DateTime, DateTimeError).Err(DateTimeError.OutOfRange(field : "offset"))));
        raw := i32((oh * i64(3600)) + (om * i64(60)));
        offset = cond(neg => (i32(0) - raw), true => raw);
        at = (at + usize(6));
      },
      true => return(err(at))
    );
    if(at != n, return(err(at)));
    DateTime.new(i32(year), u8(month), u8(day), u8(hour), u8(minute), u8(second), u32(nanos), offset)
  }),
  /// Unix seconds of the INSTANT this value names — unlike `to_unix`, which
  /// reads the wall-clock fields as if they were UTC, this subtracts the
  /// UTC offset. Equal instants at different offsets agree here.
  to_unix_utc : (fn(inout(self) : Self) -> i64)(
    self.to_unix() - i64(self.utc_offset_secs)
  ),
  /// This value shifted forward by `d` (offset preserved; nanoseconds carry).
  add : (fn(inout(self) : Self, d : Duration) -> Self)({
    total_nanos := (i64(self.nanosecond) + (d.as_nanos() % i64(1000000000)));
    carry := (total_nanos / i64(1000000000));
    off := self.utc_offset_secs;
    base := DateTime.from_unix((self.to_unix() + d.as_secs()) + carry, total_nanos % i64(1000000000));
    DateTime(
      year : base.year,
      month : base.month,
      day : base.day,
      hour : base.hour,
      minute : base.minute,
      second : base.second,
      nanosecond : base.nanosecond,
      utc_offset_secs : off
    )
  }),
  /// This value shifted backward by `d`.
  sub : (fn(inout(self) : Self, d : Duration) -> Self)({
    (nanos : i64) = (i64(self.nanosecond) - (d.as_nanos() % i64(1000000000)));
    (borrow : i64) = i64(0);
    cond(
      (nanos < i64(0)) => {
        nanos = (nanos + i64(1000000000));
        borrow = i64(1);
      },
      true => ()
    );
    off := self.utc_offset_secs;
    base := DateTime.from_unix((self.to_unix() - d.as_secs()) - borrow, nanos);
    DateTime(
      year : base.year,
      month : base.month,
      day : base.day,
      hour : base.hour,
      minute : base.minute,
      second : base.second,
      nanosecond : base.nanosecond,
      utc_offset_secs : off
    )
  })
);
/// INSTANT equality/order: values naming the same moment compare equal even
/// at different UTC offsets (`2026-01-01T01:00:00+01:00` ==
/// `2026-01-01T00:00:00Z`). Fieldwise comparison would call them unequal.
impl(
  DateTime,
  Eq(DateTime)(
    (==) : (fn(lhs : Self, rhs : Self) -> bool)(
      (lhs.to_unix_utc() == rhs.to_unix_utc()) && (lhs.nanosecond == rhs.nanosecond)
    ),
    (!=) : (fn(lhs : Self, rhs : Self) -> bool)(
      !(lhs == rhs)
    )
  )
);
impl(
  DateTime,
  Ord(DateTime)(
    (<) : (fn(lhs : Self, rhs : Self) -> bool)({
      ls := lhs.to_unix_utc();
      rs := rhs.to_unix_utc();
      cond(
        (ls != rs) => (ls < rs),
        true => (lhs.nanosecond < rhs.nanosecond)
      )
    }),
    (<=) : (fn(lhs : Self, rhs : Self) -> bool)(
      !(rhs < lhs)
    ),
    (>) : (fn(lhs : Self, rhs : Self) -> bool)(
      rhs < lhs
    ),
    (>=) : (fn(lhs : Self, rhs : Self) -> bool)(
      !(lhs < rhs)
    )
  )
);
export(DateTime);
