//! Time: durations, instants, calendar date-times and sleeping.
//!
//! A re-export barrel: `{ X } :: import("std/time")` and `{ X } :: import("std/time/<module>")` name the same `X`.
//! It defines nothing of its own and lists the modules' public names only, so a module's `_`-prefixed
//! helpers and compiler-facing symbols do not cross the boundary.
{ DateTimeError, DateTime } :: import("./datetime.yo");
{ Duration } :: import("./duration.yo");
{ Instant, SystemTimeError, SystemTime, UNIX_EPOCH } :: import("./instant.yo");
{ sleep, sleep_blocking, Interval, interval } :: import("./sleep.yo");
export(DateTimeError, DateTime, Duration, Instant, SystemTimeError, SystemTime, UNIX_EPOCH, sleep, sleep_blocking, Interval, interval);
