//! Connected socket pair.
//!
//! Synchronous wrapper for `socketpair`-like behavior.
//! Returns 0 on success, negative error on failure.
pragma(Pragma.AllowUnsafe);
{ __yo_sync_socketpair } :: import("./externs.yo");
// Create a pair of connected sockets.
// Writes two socket fds into `sv` (sv[0], sv[1]).
socketpair :: (fn(domain : i32, sock_type : i32, protocol : i32, sv : *i32) -> i32)(
  __yo_sync_socketpair(domain, sock_type, protocol, sv)
);
export(socketpair);
