//! Filesystem statistics.
//!
//! Provides a synchronous wrapper around `statfs` and typed accessors
//! for the statfs buffer returned by the C runtime.
//!
//! All operations return `i32` directly (no `IoFuture` overhead):
//! - 0 on success
//! - Negative value: -errno on failure
//
// Example:
//   statfs :: import "std/sys/statfs";
//
//   buf_size := statfs.statfs_buf_size();
//   buf := (*u8)(malloc(buf_size).unwrap());
//   ret := statfs.statfs((*u8)("/"), buf);
//   assert(ret == i32(0));
//   block_size := statfs.statfs_bsize(buf);
//   free(.Some((*void)(buf)));
pragma(Pragma.AllowUnsafe);
{ __yo_sync_statfs, __yo_statfs_buf_size, __yo_statfs_type, __yo_statfs_bsize, __yo_statfs_blocks, __yo_statfs_bfree, __yo_statfs_bavail, __yo_statfs_files, __yo_statfs_ffree } :: import("./externs.yo");
// ============================================================================
// statfs — Filesystem statistics (sync)
// ============================================================================
// Get filesystem statistics for the given path.
// Writes result to `buf` (use statfs_buf_size() to allocate).
// Returns 0 on success, -errno on failure.
statfs :: (fn(path : *u8, buf : *u8) -> i32)(
  __yo_sync_statfs(path, buf)
);
// ============================================================================
// Statfs buffer helpers
// ============================================================================
// Get required buffer size for statfs.
statfs_buf_size :: (fn() -> usize)(
  __yo_statfs_buf_size()
);
// Filesystem type (0 on platforms without type).
statfs_type :: (fn(buf : *u8) -> u64)(
  __yo_statfs_type(buf)
);
// Fundamental filesystem block size.
statfs_bsize :: (fn(buf : *u8) -> u64)(
  __yo_statfs_bsize(buf)
);
// Total data blocks in filesystem.
statfs_blocks :: (fn(buf : *u8) -> u64)(
  __yo_statfs_blocks(buf)
);
// Free blocks in filesystem.
statfs_bfree :: (fn(buf : *u8) -> u64)(
  __yo_statfs_bfree(buf)
);
// Free blocks available to unprivileged users.
statfs_bavail :: (fn(buf : *u8) -> u64)(
  __yo_statfs_bavail(buf)
);
// Total file nodes (inodes).
statfs_files :: (fn(buf : *u8) -> u64)(
  __yo_statfs_files(buf)
);
// Free file nodes (inodes).
statfs_ffree :: (fn(buf : *u8) -> u64)(
  __yo_statfs_ffree(buf)
);
export(
  statfs,
  statfs_buf_size,
  statfs_type,
  statfs_bsize,
  statfs_blocks,
  statfs_bfree,
  statfs_bavail,
  statfs_files,
  statfs_ffree
);
