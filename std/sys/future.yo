//! `IoFuture` type — opaque handle to a C async I/O future struct.
// ============================================================================
// Extern type for I/O Future
// ============================================================================
pragma(Pragma.AllowUnsafe);
extern(
  "Yo",
  __yo_io_future_t : Type
);
IoFuture :: Impl(Concrete(__yo_io_future_t), Future(i32));
export(
  __yo_io_future_t,
  IoFuture
);
