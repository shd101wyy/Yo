//! Extern C runtime function declarations.
//!
//! All low-level extern functions for async I/O operations.
pragma(Pragma.AllowUnsafe);
{ IoFuture } :: import("./future.yo");
// ============================================================================
// Extern C runtime functions
// ============================================================================
extern(
  "Yo",
  // ========================================================================
  // File Operations
  // ========================================================================
  __yo_async_read_start : (fn(fd : i32, buffer : *u8, size : u32, offset : u64) -> IoFuture),
  __yo_async_write_start : (fn(fd : i32, buffer : *u8, size : u32, offset : u64) -> IoFuture),
  __yo_async_openat_start : (fn(dirfd : i32, path : *u8, flags : i32, mode : i32) -> IoFuture),
  __yo_async_close_start : (fn(fd : i32) -> IoFuture),
  __yo_async_statx_start : (fn(dirfd : i32, path : *u8, flags : i32, mask : u32, statxbuf : *u8) -> IoFuture),
  __yo_async_mkdirat_start : (fn(dirfd : i32, path : *u8, mode : i32) -> IoFuture),
  __yo_async_unlinkat_start : (fn(dirfd : i32, path : *u8, flags : i32) -> IoFuture),
  __yo_async_renameat_start : (fn(olddirfd : i32, oldpath : *u8, newdirfd : i32, newpath : *u8) -> IoFuture),
  __yo_async_symlinkat_start : (fn(target : *u8, newdirfd : i32, linkpath : *u8) -> IoFuture),
  __yo_async_linkat_start : (fn(olddirfd : i32, oldpath : *u8, newdirfd : i32, newpath : *u8, flags : i32) -> IoFuture),
  __yo_async_fsync_start : (fn(fd : i32) -> IoFuture),
  __yo_async_fdatasync_start : (fn(fd : i32) -> IoFuture),
  __yo_async_ftruncate_start : (fn(fd : i32, length : i64) -> IoFuture),
  // ========================================================================
  // Directory Listing (for fs.readdir)
  // ========================================================================
  __yo_async_getdents_start : (fn(fd : i32, buf : *u8, buf_size : u32) -> IoFuture),
  __yo_dirent_size : (fn() -> usize),
  __yo_dirent_reclen : (fn(entry : *u8) -> u16),
  __yo_dirent_type : (fn(entry : *u8) -> u8),
  __yo_dirent_name : (fn(entry : *u8) -> *u8),
  __yo_dirent_ino : (fn(entry : *u8) -> u64),
  // ========================================================================
  // Symbolic Link Resolution (for fs.readlink)
  // ========================================================================
  // ========================================================================
  // File Descriptor Operations (async dup/dup2/pipe removed - now sync)
  // ========================================================================
  // ========================================================================
  // Socket Operations (for tcp, udp, unix sockets)
  // ========================================================================
  __yo_async_socket_start : (fn(domain : i32, sock_type : i32, protocol : i32) -> IoFuture),
  __yo_async_bind_start : (fn(sockfd : i32, addr : *u8, addrlen : u32) -> IoFuture),
  __yo_async_listen_start : (fn(sockfd : i32, backlog : i32) -> IoFuture),
  __yo_async_accept_start : (fn(sockfd : i32, addr : *u8, addrlen : *u32) -> IoFuture),
  __yo_async_connect_start : (fn(sockfd : i32, addr : *u8, addrlen : u32) -> IoFuture),
  __yo_async_send_start : (fn(sockfd : i32, buf : *u8, len : usize, flags : i32) -> IoFuture),
  __yo_async_recv_start : (fn(sockfd : i32, buf : *u8, len : usize, flags : i32) -> IoFuture),
  __yo_async_sendto_start : (fn(sockfd : i32, buf : *u8, len : usize, flags : i32, dest_addr : *u8, addrlen : u32) -> IoFuture),
  __yo_async_recvfrom_start : (fn(sockfd : i32, buf : *u8, len : usize, flags : i32, src_addr : *u8, addrlen : *u32) -> IoFuture),
  __yo_async_shutdown_start : (fn(sockfd : i32, how : i32) -> IoFuture),
  __yo_async_setsockopt_start : (fn(sockfd : i32, level : i32, optname : i32, optval : *u8, optlen : u32) -> IoFuture),
  __yo_async_getsockopt_start : (fn(sockfd : i32, level : i32, optname : i32, optval : *u8, optlen : *u32) -> IoFuture),
  __yo_sync_getsockname : (fn(sockfd : i32, addr : *u8, addrlen : *u32) -> i32),
  __yo_sync_getpeername : (fn(sockfd : i32, addr : *u8, addrlen : *u32) -> i32),
  __yo_sync_setsockopt : (fn(sockfd : i32, level : i32, optname : i32, optval : *u8, optlen : u32) -> i32),
  __yo_sync_getsockopt : (fn(sockfd : i32, level : i32, optname : i32, optval : *u8, optlen : *u32) -> i32),
  __yo_sync_socketpair : (fn(domain : i32, sock_type : i32, protocol : i32, sv : *i32) -> i32),
  // ========================================================================
  // System Information & Utilities
  // ========================================================================
  __yo_sync_clock_gettime : (fn(clock_id : i32, sec : *i64, nsec : *i64) -> i32),
  __yo_sync_uname : (fn(buf : *u8) -> i32),
  __yo_sync_gethostname : (fn(name : *u8, len : usize) -> i32),
  __yo_sync_umask : (fn(mask : i32) -> i32),
  // ========================================================================
  // Process Operations
  // ========================================================================
  __yo_async_spawn_start : (fn(file : *u8, argv : *?*u8, envp : ?*?*u8, stdin_fd : i32, stdout_fd : i32, stderr_fd : i32) -> IoFuture),
  /// Spawn with a working directory (`.None` = inherit the parent's). POSIX:
  /// posix_spawn_file_actions_addchdir_np (ENOSYS on a libc without it);
  /// Windows: lpCurrentDirectory. In the v0.2.20 seed's runtime and later.
  __yo_async_spawn_start_cwd : (fn(file : *u8, argv : *?*u8, envp : ?*?*u8, stdin_fd : i32, stdout_fd : i32, stderr_fd : i32, cwd : ?*u8) -> IoFuture),
  __yo_async_waitpid_start : (fn(pid : i32, options : i32) -> IoFuture),
  __yo_process_exit_status : (fn(status : i32) -> i32),
  __yo_process_term_signal : (fn(status : i32) -> i32),
  // ========================================================================
  // Synchronous File Helpers
  // ========================================================================
  __yo_file_open : (fn(path : *u8, flags : i32, mode : i32) -> i32),
  __yo_file_close : (fn(fd : i32) -> unit),
  __yo_file_size : (fn(fd : i32) -> i64),
  // ========================================================================
  // Stat Buffer Accessors
  // ========================================================================
  __yo_statx_buf_size : (fn() -> usize),
  __yo_statx_size : (fn(statxbuf : *u8) -> i64),
  __yo_statx_mode : (fn(statxbuf : *u8) -> u32),
  __yo_statx_mtime_sec : (fn(statxbuf : *u8) -> i64),
  __yo_statx_mtime_nsec : (fn(statxbuf : *u8) -> u32),
  __yo_statx_atime_sec : (fn(statxbuf : *u8) -> i64),
  __yo_statx_atime_nsec : (fn(statxbuf : *u8) -> u32),
  __yo_statx_ctime_sec : (fn(statxbuf : *u8) -> i64),
  __yo_statx_ctime_nsec : (fn(statxbuf : *u8) -> u32),
  __yo_statx_btime_sec : (fn(statxbuf : *u8) -> i64),
  __yo_statx_btime_nsec : (fn(statxbuf : *u8) -> u32),
  __yo_statx_uid : (fn(statxbuf : *u8) -> u32),
  __yo_statx_gid : (fn(statxbuf : *u8) -> u32),
  __yo_statx_ino : (fn(statxbuf : *u8) -> u64),
  __yo_statx_dev_major : (fn(statxbuf : *u8) -> u64),
  __yo_statx_dev_minor : (fn(statxbuf : *u8) -> u64),
  __yo_statx_nlink : (fn(statxbuf : *u8) -> u64),
  __yo_statx_blksize : (fn(statxbuf : *u8) -> u64),
  __yo_statx_blocks : (fn(statxbuf : *u8) -> u64),
  // ========================================================================
  // Socket Address Helpers
  // ========================================================================
  __yo_sockaddr_in_size : (fn() -> usize),
  __yo_sockaddr_in6_size : (fn() -> usize),
  __yo_sockaddr_un_size : (fn() -> usize),
  __yo_sockaddr_storage_size : (fn() -> usize),
  __yo_sockaddr_set_family : (fn(addr : *u8, family : u16) -> unit),
  __yo_sockaddr_get_family : (fn(addr : *u8) -> u16),
  __yo_sockaddr_in_set_port : (fn(addr : *u8, port : u16) -> unit),
  __yo_sockaddr_in_get_port : (fn(addr : *u8) -> u16),
  __yo_sockaddr_in_set_addr : (fn(addr : *u8, ip : u32) -> unit),
  __yo_sockaddr_in_get_addr : (fn(addr : *u8) -> u32),
  __yo_sockaddr_in6_set_port : (fn(addr : *u8, port : u16) -> unit),
  __yo_sockaddr_in6_get_port : (fn(addr : *u8) -> u16),
  __yo_sockaddr_in6_set_addr : (fn(addr : *u8, ip : *u8) -> unit),
  __yo_sockaddr_in6_get_addr : (fn(addr : *u8, out : *u8) -> unit),
  __yo_sockaddr_un_set_path : (fn(addr : *u8, path : *u8) -> unit),
  __yo_sockaddr_un_get_path : (fn(addr : *u8) -> *u8),
  __yo_inet_pton : (fn(af : i32, src : *u8, dst : *u8) -> i32),
  __yo_inet_ntop : (fn(af : i32, src : *u8, dst : *u8, size : u32) -> *u8),
  __yo_htons : (fn(hostshort : u16) -> u16),
  __yo_ntohs : (fn(netshort : u16) -> u16),
  __yo_htonl : (fn(hostlong : u32) -> u32),
  __yo_ntohl : (fn(netlong : u32) -> u32),
  // ========================================================================
  // Timer Operations
  // ========================================================================
  __yo_async_sleep_start : (fn(milliseconds : u64) -> IoFuture),
  // ========================================================================
  // File Extra Operations (async only: sleep remains async)
  // ========================================================================
  __yo_statfs_buf_size : (fn() -> usize),
  __yo_statfs_type : (fn(buf : *u8) -> u64),
  __yo_statfs_bsize : (fn(buf : *u8) -> u64),
  __yo_statfs_blocks : (fn(buf : *u8) -> u64),
  __yo_statfs_bfree : (fn(buf : *u8) -> u64),
  __yo_statfs_bavail : (fn(buf : *u8) -> u64),
  __yo_statfs_files : (fn(buf : *u8) -> u64),
  __yo_statfs_ffree : (fn(buf : *u8) -> u64),
  // ========================================================================
  // Directory Scanning
  // ========================================================================
  __yo_async_scandir_start : (fn(dirfd : i32, path : *u8) -> IoFuture),
  __yo_async_opendir_start : (fn(path : *u8) -> IoFuture),
  __yo_async_readdir_start : (fn(dir : *u8, entries : *u8, max_entries : usize) -> IoFuture),
  __yo_async_closedir_start : (fn(dir : *u8) -> IoFuture),
  // ========================================================================
  // DNS Operations
  // ========================================================================
  __yo_async_getaddrinfo_start : (fn(node : *u8, service : ?*u8, hints : ?*u8, result : *?*u8) -> IoFuture),
  __yo_async_getnameinfo_start : (fn(addr : *u8, addrlen : u32, host : *u8, hostlen : usize, service : *u8, servlen : usize, flags : i32) -> IoFuture),
  __yo_freeaddrinfo : (fn(res : *u8) -> unit),
  __yo_addrinfo_size : (fn() -> usize),
  __yo_addrinfo_flags : (fn(ai : *u8) -> i32),
  __yo_addrinfo_family : (fn(ai : *u8) -> i32),
  __yo_addrinfo_socktype : (fn(ai : *u8) -> i32),
  __yo_addrinfo_protocol : (fn(ai : *u8) -> i32),
  __yo_addrinfo_addrlen : (fn(ai : *u8) -> u32),
  __yo_addrinfo_addr : (fn(ai : *u8) -> *u8),
  __yo_addrinfo_canonname : (fn(ai : *u8) -> ?*u8),
  __yo_addrinfo_next : (fn(ai : *u8) -> ?*u8),
  // ========================================================================
  // Signal Operations
  // ========================================================================
  __yo_signal_start : (fn(signum : i32, handler : *u8) -> i32),
  __yo_signal_stop : (fn(signum : i32) -> i32),
  __yo_kill : (fn(pid : i32, signum : i32) -> i32),
  // ========================================================================
  // TTY Operations
  // ========================================================================
  __yo_tty_init : (fn(fd : i32) -> i32),
  __yo_tty_set_mode : (fn(fd : i32, mode : i32) -> i32),
  __yo_tty_reset_mode : (fn() -> i32),
  __yo_tty_get_winsize : (fn(fd : i32, width : *i32, height : *i32) -> i32),
  __yo_isatty : (fn(fd : i32) -> i32),
  // ========================================================================
  // FS Event Operations
  // ========================================================================
  __yo_fs_event_init : (fn() -> *u8),
  __yo_fs_event_start : (fn(handle : *u8, path : *u8, flags : u32, callback : *u8, user_data : *u8) -> i32),
  __yo_fs_event_stop : (fn(handle : *u8) -> i32),
  __yo_fs_event_close : (fn(handle : *u8) -> unit),
  // ========================================================================
  // Poll Operations
  // ========================================================================
  __yo_poll_init : (fn(fd : i32) -> *u8),
  __yo_poll_start : (fn(handle : *u8, events : i32, callback : *u8, user_data : *u8) -> i32),
  __yo_poll_stop : (fn(handle : *u8) -> i32),
  __yo_poll_close : (fn(handle : *u8) -> unit),
  // ========================================================================
  // Synchronous Operations (no IoFuture overhead)
  // ========================================================================
  __yo_sync_pipe : (fn(pipefd : *i32) -> i32),
  __yo_sync_dup : (fn(oldfd : i32) -> i32),
  __yo_sync_dup2 : (fn(oldfd : i32, newfd : i32) -> i32),
  __yo_sync_access : (fn(dirfd : i32, path : *u8, mode : i32) -> i32),
  __yo_sync_realpath : (fn(path : *u8, resolved : *u8) -> i32),
  __yo_sync_mkdtemp : (fn(template : *u8) -> i32),
  __yo_sync_mkstemp : (fn(template : *u8) -> i32),
  __yo_sync_copyfile : (fn(src : *u8, dst : *u8, flags : i32) -> i32),
  __yo_sync_sendfile : (fn(out_fd : i32, in_fd : i32, offset : i64, count : usize) -> i32),
  __yo_sync_fchmod : (fn(fd : i32, mode : u32) -> i32),
  __yo_sync_fchmodat : (fn(dirfd : i32, path : *u8, mode : u32, flags : i32) -> i32),
  __yo_sync_fchown : (fn(fd : i32, uid : u32, gid : u32) -> i32),
  __yo_sync_fchownat : (fn(dirfd : i32, path : *u8, uid : u32, gid : u32, flags : i32) -> i32),
  __yo_sync_readlinkat : (fn(dirfd : i32, path : *u8, buf : *u8, bufsize : usize) -> i32),
  __yo_sync_utime : (fn(path : *u8, atime_sec : i64, atime_nsec : i64, mtime_sec : i64, mtime_nsec : i64) -> i32),
  __yo_sync_futime : (fn(fd : i32, atime_sec : i64, atime_nsec : i64, mtime_sec : i64, mtime_nsec : i64) -> i32),
  __yo_sync_lutime : (fn(path : *u8, atime_sec : i64, atime_nsec : i64, mtime_sec : i64, mtime_nsec : i64) -> i32),
  __yo_sync_statfs : (fn(path : *u8, statfsbuf : *u8) -> i32),
  __yo_sync_mmap : (fn(addr : ?*u8, length : usize, prot : i32, flags : i32, fd : i32, offset : i64) -> ?*u8),
  __yo_sync_mmap_is_error : (fn(addr : ?*u8) -> bool),
  __yo_sync_mmap_errno : (fn(addr : ?*u8) -> i32),
  __yo_sync_munmap : (fn(addr : *u8, length : usize) -> i32),
  __yo_sync_mprotect : (fn(addr : *u8, length : usize, prot : i32) -> i32),
  __yo_sync_msync : (fn(addr : *u8, length : usize, flags : i32) -> i32),
  __yo_sync_fcntl_getfl : (fn(fd : i32) -> i32),
  __yo_sync_fcntl_setfl : (fn(fd : i32, flags : i32) -> i32),
  __yo_sync_fcntl_getfd : (fn(fd : i32) -> i32),
  __yo_sync_fcntl_setfd : (fn(fd : i32, flags : i32) -> i32),
  __yo_sync_lseek : (fn(fd : i32, offset : i64, whence : i32) -> i64),
  __yo_sync_write : (fn(fd : i32, buf : *u8, count : u32, offset : u64) -> i32),
  __yo_sync_fallocate : (fn(fd : i32, mode : i32, offset : i64, length : i64) -> i32),
  __yo_sync_flock : (fn(fd : i32, operation : i32) -> i32),
  __yo_sync_readv : (fn(fd : i32, iov : *u8, iovcnt : i32) -> i32),
  __yo_sync_writev : (fn(fd : i32, iov : *u8, iovcnt : i32) -> i32),
  __yo_sync_preadv : (fn(fd : i32, iov : *u8, iovcnt : i32, offset : i64) -> i32),
  __yo_sync_pwritev : (fn(fd : i32, iov : *u8, iovcnt : i32, offset : i64) -> i32),
  __yo_iovec_size : (fn() -> usize),
  __yo_iovec_set : (fn(iov : *u8, index : usize, base : *u8, len : usize) -> unit),
  __yo_sync_fadvise : (fn(fd : i32, offset : i64, len : i64, advice : i32) -> i32),
  __yo_sync_madvise : (fn(addr : *u8, length : usize, advice : i32) -> i32)
);
export(
  // File operations
  __yo_async_read_start,
  __yo_async_write_start,
  __yo_async_openat_start,
  __yo_async_close_start,
  __yo_async_statx_start,
  __yo_async_mkdirat_start,
