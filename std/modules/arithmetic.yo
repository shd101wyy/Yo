/**
 * There is no operator precedence in Yo
 */

Add :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Type))
  module
    Self :: Lhs,
    (+): ((lhs: Lhs, rhs: Rhs)-> Output)
;

Sub :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Type))
  module
    Self :: Lhs,
    (-): ((lhs: Lhs, rhs: Rhs)-> Output)
;

Mul :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Type))
  module
    Self :: Lhs,
    (*): ((lhs: Lhs, rhs: Rhs)-> Output)
;

Div :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Type))
  module
    Self :: Lhs,
    (/): ((lhs: Lhs, rhs: Rhs)-> Output)
;

Mod :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Type))
  module
    Self :: Lhs,
    (%): ((lhs: Lhs, rhs: Rhs)-> Output)
;

BitLeftShift :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Type))
  module
    Self :: Lhs,
    (<<): ((lhs: Lhs, rhs: Rhs)-> Output)
;

BitRightShift :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Type))
  module
    Self :: Lhs,
    (>>): ((lhs: Lhs, rhs: Rhs)-> Output)
;


Exponentiation :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Type))
  module
    Self :: Lhs,
    (**): ((lhs: Lhs, rhs: Rhs)-> Output)
;

Negate ::
  ((@(Self_): Type, @(Output) ?= Self_)-> @(Type))
  module
    Self :: Self_,
    (-):
      (self: Self)-> Output
;

export
  Add,
  Sub,
  Mul,
  Div,
  Mod,
  BitLeftShift,
  BitRightShift,
  Exponentiation,
  Negate
;