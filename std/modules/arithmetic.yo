/**
 * There is no operator precedence in Yo
 */

Add :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (+)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

Sub :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (-)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

Mul :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (*)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

Div :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (/)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

Mod :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (%)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

BitLeftShift :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (<<)   : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

BitRightShift :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (>>)   : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;


Exponentiation :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (**)   : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

Negate ::
  (fn(compt(Self): Type, compt(Output) ?= Self)-> compt(Module))
  module
    Self   := Self,
    (neg): (fn(self: Self)-> Output)
;


ComptNegate ::
  (fn(compt(Self): Type)-> compt(Module))
  module
    Self  := Self,
    (neg) : (fn(compt(self): Self)-> compt(Self))
;

(-) :: module {
  (neg) :: (fn( forall(Self : Type), 
            self : Self,
            using(compt(NegateMethod): Negate(Self))
          ) -> Self)
    NegateMethod.neg(self)
  ;

  (compt_neg) :: (fn(forall(Self : Type), 
          compt(self) : Self,
          using(compt(NegateMethod): ComptNegate(Self))
        ) -> compt(Self))
    NegateMethod.neg(self)
  ;

  Self :: (neg, compt_neg);

  export
    neg,
    compt_neg,
    Self
  ;
};


export
  Add,
  Sub,
  Mul,
  Div,
  Mod,
  BitLeftShift,
  BitRightShift,
  Exponentiation,
  Negate,
  (-)
;