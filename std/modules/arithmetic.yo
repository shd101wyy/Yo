/**
 * There is no operator precedence in Yo
 */

Add :: (fn(compt(Rhs) : Type)-> compt(Module))
  module
    Self   : Type,
    Output ?= Rhs,
    (+)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;

Sub :: (fn(compt(Rhs) : Type)-> compt(Module))
  module
    Self   : Type,
    Output ?= Rhs,
    (-)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;

Mul :: (fn(compt(Rhs) : Type)-> compt(Module))
  module
    Self   : Type,
    Output ?= Rhs,
    (*)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;

Div :: (fn(compt(Rhs) : Type)-> compt(Module))
  module
    Self   : Type,
    Output ?= Rhs,
    (/)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;

Mod :: (fn(compt(Rhs) : Type)-> compt(Module))
  module
    Self   : Type,
    Output ?= Rhs,
    (%)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;

BitLeftShift :: (fn(compt(Rhs) : Type)-> compt(Module))
  module
    Self   : Type,
    Output ?= Rhs,
    (<<)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;

BitRightShift :: (fn(compt(Rhs) : Type)-> compt(Module))
  module
    Self   : Type,
    Output ?= Rhs,
    (>>)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;


Exponentiation :: (fn(compt(Rhs) : Type)-> compt(Module))
  module
    Self   : Type,
    Output ?= Rhs,
    (**)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;

Negate :: module
    Self   : Type,
    Output ?= Self,
    (neg): (fn(self: Self)-> Output)
;


ComptNegate :: module
    Self   : Type,
    Output ?= Self,
    (neg) : (fn(compt(self): Self)-> compt(Output))
;

(-) :: impl {
  (neg) :: (fn( forall(Self : Type), 
            self : Self,
            using(NegateMethod) : (Self <: Negate)
          ) -> Self)
    NegateMethod.neg(self)
  ;

  (compt_neg) :: (fn(forall(Self : Type), 
          compt(self) : Self,
          using(NegateMethod) : (Self <: ComptNegate)
        ) -> compt(Self))
    NegateMethod.neg(self)
  ;

  Self :: (neg, compt_neg);

  export
    neg,
    compt_neg,
    Self
  ;
};


export
  Add,
  Sub,
  Mul,
  Div,
  Mod,
  BitLeftShift,
  BitRightShift,
  Exponentiation,
  Negate,
  (-)
;