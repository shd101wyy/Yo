/**
 * There is no operator precedence in Yo
 */

def Add:
  (@(Lhs): Type, @(Rhs): Type, @(Output): Type)-> @(Type), 
  module
    (Self: Type) == Lhs,
    (+): ((lhs: Lhs, rhs: Rhs)-> Output)
;

def Sub:
  (@(Lhs): Type, @(Rhs): Type, @(Output): Type)-> @(Type), 
  module
    (Self: Type) == Lhs,
    (-): ((lhs: Lhs, rhs: Rhs)-> Output)
;

def Mul:
  (@(Lhs): Type, @(Rhs): Type, @(Output): Type)-> @(Type), 
  module
    (Self: Type) == Lhs,
    (*): ((lhs: Lhs, rhs: Rhs)-> Output)
;

def Div:
  (@(Lhs): Type, @(Rhs): Type, @(Output): Type)-> @(Type), 
  module
    (Self: Type) == Lhs,
    (/): ((lhs: Lhs, rhs: Rhs)-> Output)
;

def Mod:
  (@(Lhs): Type, @(Rhs): Type, @(Output): Type)-> @(Type), 
  module
    (Self: Type) == Lhs,
    (%): ((lhs: Lhs, rhs: Rhs)-> Output)
;

def BitLeftShift:
  (@(Lhs): Type, @(Rhs): Type, @(Output): Type)-> @(Type), 
  module
    (Self: Type) == Lhs,
    (<<): ((lhs: Lhs, rhs: Rhs)-> Output)
;

def BitRightShift:
  (@(Lhs): Type, @(Rhs): Type, @(Output): Type)-> @(Type), 
  module
    (Self: Type) == Lhs,
    (>>): ((lhs: Lhs, rhs: Rhs)-> Output)
;


def Exponentiation:
  (@(Lhs): Type, @(Rhs): Type, @(Output): Type)-> @(Type), 
  module
    (Self: Type) == Lhs,
    (**): ((lhs: Lhs, rhs: Rhs)-> Output)
;

def Negate:
  (@(Self): Type, @(Output): Type)-> @(Type),
  module
    (Self: Type) == Self,
    (-):
      (self: Self)-> Output
;

export {
  Add,
  Sub,
  Mul,
  Div,
  Mod,
  BitLeftShift,
  BitRightShift,
  Exponentiation,
  Negate
};