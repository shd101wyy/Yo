/**
 * There is no operator precedence in Yo
 */
__yo_eval_builtin_module("Add");
__yo_eval_builtin_module("Sub");
__yo_eval_builtin_module("Mul");
__yo_eval_builtin_module("Div");
__yo_eval_builtin_module("Mod");
__yo_eval_builtin_module("BitLeftShift");
__yo_eval_builtin_module("BitRightShift");
__yo_eval_builtin_module("Exponentiation");
__yo_eval_builtin_module("Negate");
__yo_eval_builtin_module("ComptNegate");

(-) :: impl {
  (neg) :: (fn(forall(_Self : Type), 
            self : _Self,
            using(NegateMethod) : (_Self <: Negate(_Self))
          ) -> _Self)
    NegateMethod.neg(self)
  ;

  (compt_neg) :: (fn(forall(_Self : Type), 
          compt(self) : _Self,
          using(NegateMethod) : (_Self <: ComptNegate(_Self))
        ) -> compt(_Self))
    NegateMethod.neg(self)
  ;

  Self :: (neg, compt_neg);

  export
    neg,
    compt_neg,
    Self
  ;
};


export
  Add,
  Sub,
  Mul,
  Div,
  Mod,
  BitLeftShift,
  BitRightShift,
  Exponentiation,
  Negate,
  (-)
;