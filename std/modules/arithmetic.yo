/**
 * There is no operator precedence in Yo
 */

// TODO: Support this:
__yo_eval_builtin_module("Add");
__yo_eval_builtin_module("Sub");
__yo_eval_builtin_module("Mul");
__yo_eval_builtin_module("Div");

Mod :: (fn(compt(Rhs) : Type, compt(Output) ?= Rhs)-> compt(Module))
  module
    Output := Output,
    (%)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;

BitLeftShift :: (fn(compt(Rhs) : Type, compt(Output) ?= Rhs)-> compt(Module))
  module
    Output := Output,
    (<<)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;

BitRightShift :: (fn(compt(Rhs) : Type, compt(Output) ?= Rhs)-> compt(Module))
  module
    Output := Output,
    (>>)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;


Exponentiation :: (fn(compt(Rhs) : Type, compt(Output) ?= Rhs)-> compt(Module))
  module
    Output := Output,
    (**)   : (fn(lhs: Self, rhs: Rhs)-> Output)
;

Negate :: (fn(compt(Output) : Type)-> compt(Module)) 
  module
    Output := Output,
    (neg): (fn(self: Self)-> Output)
;


ComptNegate :: (fn(compt(Output) : Type)-> compt(Module)) 
  module
    Output := Output,
    (neg) : (fn(compt(self): Self)-> compt(Output))
;

(-) :: impl {
  (neg) :: (fn(forall(_Self : Type), 
            self : _Self,
            using(NegateMethod) : (_Self <: Negate(_Self))
          ) -> _Self)
    NegateMethod.neg(self)
  ;

  (compt_neg) :: (fn(forall(_Self : Type), 
          compt(self) : _Self,
          using(NegateMethod) : (_Self <: ComptNegate(_Self))
        ) -> compt(_Self))
    NegateMethod.neg(self)
  ;

  Self :: (neg, compt_neg);

  export
    neg,
    compt_neg,
    Self
  ;
};


export
  Add,
  Sub,
  Mul,
  Div,
  Mod,
  BitLeftShift,
  BitRightShift,
  Exponentiation,
  Negate,
  (-)
;