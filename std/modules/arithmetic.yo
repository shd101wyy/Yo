/**
 * There is no operator precedence in Yo
 */

Add :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Module))
  module
    Self   := Lhs,
    (+)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

Sub :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Module))
  module
    Self   := Lhs,
    (-)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

Mul :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Module))
  module
    Self   := Lhs,
    (*)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

Div :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Module))
  module
    Self   := Lhs,
    (/)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

Mod :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Module))
  module
    Self   := Lhs,
    (%)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

BitLeftShift :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Module))
  module
    Self   := Lhs,
    (<<)   : ((lhs: Lhs, rhs: Rhs)-> Output)
;

BitRightShift :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Module))
  module
    Self   := Lhs,
    (>>)   : ((lhs: Lhs, rhs: Rhs)-> Output)
;


Exponentiation :: ((@(Lhs): Type, @(Rhs) ?= Lhs, @(Output) ?= Lhs)-> @(Module))
  module
    Self   := Lhs,
    (**)   : ((lhs: Lhs, rhs: Rhs)-> Output)
;

Negate ::
  ((@(Self): Type)-> @(Module))
  module
    Self   := Self,
    (neg): ((self: Self)-> Self)
;


ComptNegate ::
  ((@(Self): Type)-> @(Module))
  module
    Self  := Self,
    (neg) : ((@(self): Self)-> @(Self))
;

(-) :: module {
  (neg) :: (( forall(@(Self) : Type), 
            self : Self, 
            implicit(@(NegateMethod): Negate(Self))
          ) -> Self)
    NegateMethod.neg(self)
  ;

  (compt_neg) :: ((forall(@(Self) : Type), 
          @(self) : Self,
          implicit(@(NegateMethod): ComptNegate(Self))
        ) -> @(Self))
    NegateMethod.neg(self)
  ;

  Self :: (neg, compt_neg);

  export
    neg,
    compt_neg,
    Self
  ;
};


export
  Add,
  Sub,
  Mul,
  Div,
  Mod,
  BitLeftShift,
  BitRightShift,
  Exponentiation,
  Negate,
  (-)
;