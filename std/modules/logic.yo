LogicalAnd :: ((compt(Lhs): Type, compt(Rhs) ?= Lhs)-> compt(Module))
  module
    Self := Lhs,
    (&&) : ((lhs: Lhs, rhs: Rhs)-> boolean)
;

LogicalOr :: ((compt(Lhs): Type, compt(Rhs) ?= Lhs)-> compt(Module))
  module
    Self := Lhs,
    (||) : ((lhs: Lhs, rhs: Rhs)-> boolean)
;

LogicalNot :: ((compt(Self): Type) -> compt(Module))
  module
    Self := Self,
    (!)  : ((self: Self)-> boolean)
;

BitNot :: ((compt(Self): Type) -> compt(Module))
  module
    Self   := Self,
    Output ?= Self,
    (~)  : ((self: Self)-> Output)
;

BitAnd :: ((compt(Lhs): Type, compt(Rhs) ?= Lhs) -> compt(Module)) 
  module
    Self   := Lhs,
    Output ?= Lhs,
    (&)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

BitOr :: ((compt(Lhs): Type, compt(Rhs) ?= Lhs) -> compt(Module))
  module
    Self   := Lhs,
    Output ?= Lhs,
    (|)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

BitXor :: ((compt(Lhs): Type, compt(Rhs) ?= Lhs) -> compt(Module)) 
  module
    Self   := Lhs,
    Output ?= Lhs,
    (^)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

export
  LogicalAnd,
  LogicalOr,
  LogicalNot,
  BitNot,
  BitAnd,
  BitOr,
  BitXor
;