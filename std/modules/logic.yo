open import("../builtins.yo");

/*
// && and || are short-circuiting logical operations.
// The logical operations are defined in terms of the boolean type.
// They shouldn't be modules
LogicalAnd :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs)-> compt(Module))
  module
    Self := Lhs,
    (&&) : (fn(lhs: Lhs, rhs: Rhs)-> boolean)
;

LogicalOr :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs)-> compt(Module))
  module
    Self := Lhs,
    (||) : (fn(lhs: Lhs, rhs: Rhs)-> boolean)
;
*/

LogicalNot :: module
  Self : Type,
  (!)  : (fn(self: Self)-> boolean)
;

BitNot :: module
    Self   : Type,
    Output ?= Self,
    (~)  : (fn(self: Self)-> Output)
;

BitAnd :: (fn(compt(Rhs) : Type) -> compt(Module)) 
  module
    Self   : Type,
    Output ?= Self,
    (&)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;

BitOr :: (fn(compt(Rhs) : Type) -> compt(Module))
  module
    Self   :  Type,
    Output ?= Self,
    (|)    : (fn(lhs: Self, rhs: Rhs)-> Output)
;

BitXor :: (fn(compt(Rhs) : Type) -> compt(Module)) 
  module
    Self   :  Type,
    Output ?= Self,
    (^)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;

ComptLogicalNot :: module
  Self : Type,
  (!)  : (fn(compt(self): Self) -> compt(boolean))
;

(!) :: impl {
  (not) :: (fn( forall(Self : Type),
            self : Self,
            using(LogicalNotMethod : (Self <: LogicalNot))
          ) -> boolean)
    LogicalNotMethod.(!)(self)
  ;

  (compt_not) :: (fn(forall(Self : Type), 
          compt(self) : Self,
          using(LogicalNotMethod : (Self <: ComptLogicalNot))
        ) -> compt(boolean))
    LogicalNotMethod.(!)(self)
  ;

  Self :: (not, compt_not);

  export
    Self,
    not,
    compt_not
  ;
};
(not) :: (!);

/**
 * logic for boolean
 */
BooleanLogicalNot :: LogicalNot
  Self : boolean,
  (!): ((a) ->
    __yo_op_not(a)
  )
;

ComptBooleanLogicalNot :: ComptLogicalNot
  Self : boolean,
  (!): ((self) ->
    cond
      self => false,
      true => true
  )
;

export
  LogicalNot,
  ComptLogicalNot,
  BitNot,
  BitAnd,
  BitOr,
  BitXor,

  (!),
  not,

  BooleanLogicalNot,
  ComptBooleanLogicalNot
;