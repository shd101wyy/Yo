LogicalAnd :: ((@(Lhs): Type, @(Rhs) ?= Lhs)-> @(Type))
  module
    Self := Lhs,
    (&&) : ((lhs: Lhs, rhs: Rhs)-> boolean)
;

LogicalOr :: ((@(Lhs): Type, @(Rhs) ?= Lhs)-> @(Type))
  module
    Self := Lhs,
    (||) : ((lhs: Lhs, rhs: Rhs)-> boolean)
;

LogicalNot :: ((@(Self): Type) -> @(Type))
  module
    Self := Self,
    (!)  : ((self: Self)-> boolean)
;

BitNot :: ((@(Self): Type) -> @(Type))
  module
    Self   := Self,
    Output ?= Self,
    (~)  : ((self: Self)-> Output)
;

BitAnd :: ((@(Lhs): Type, @(Rhs) ?= Lhs) -> @(Type)) 
  module
    Self   := Lhs,
    Output ?= Lhs,
    (&)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

BitOr :: ((@(Lhs): Type, @(Rhs) ?= Lhs) -> @(Type))
  module
    Self   := Lhs,
    Output ?= Lhs,
    (|)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

BitXor :: ((@(Lhs): Type, @(Rhs) ?= Lhs) -> @(Type)) 
  module
    Self   := Lhs,
    Output ?= Lhs,
    (^)    : ((lhs: Lhs, rhs: Rhs)-> Output)
;

export
  LogicalAnd,
  LogicalOr,
  LogicalNot,
  BitNot,
  BitAnd,
  BitOr,
  BitXor
;