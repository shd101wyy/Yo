open import("../builtins.yo");

/*
// && and || are short-circuiting logical operations.
// The logical operations are defined in terms of the boolean type.
// They shouldn't be modules
LogicalAnd :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs)-> compt(Module))
  module
    Self := Lhs,
    (&&) : (fn(lhs: Lhs, rhs: Rhs)-> boolean)
;

LogicalOr :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs)-> compt(Module))
  module
    Self := Lhs,
    (||) : (fn(lhs: Lhs, rhs: Rhs)-> boolean)
;
*/

LogicalNot :: module
  (!)  : (fn(self: Self)-> boolean)
;

BitNot :: (fn(compt(Output) : Type) -> compt(Module))
  module
    Output := Output,
    (~)    :  (fn(self: Self)-> Output)
;

BitAnd :: (fn(compt(Rhs) : Type, compt(Output) ?= Rhs) -> compt(Module)) 
  module
    Output := Output,
    (&)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;

BitOr :: (fn(compt(Rhs) : Type, compt(Output) ?= Rhs) -> compt(Module))
  module
    Output := Output,
    (|)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;

BitXor :: (fn(compt(Rhs) : Type, compt(Output) ?= Rhs) -> compt(Module)) 
  module
    Output := Output,
    (^)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;

ComptLogicalNot :: module
  (!)  : (fn(compt(self): Self) -> compt(boolean))
;

(!) :: impl {
  (not) :: (fn( forall(_Self : Type),
            self : _Self,
            using(LogicalNotMethod) : (_Self <: LogicalNot)
          ) -> boolean)
    LogicalNotMethod.(!)(self)
  ;

  (compt_not) :: (fn(forall(_Self : Type), 
          compt(self) : _Self,
          using(LogicalNotMethod) : (_Self <: ComptLogicalNot)
        ) -> compt(boolean))
    LogicalNotMethod.(!)(self)
  ;

  Self :: (not, compt_not);

  export
    Self,
    not,
    compt_not
  ;
};
(not) :: (!);

/**
 * logic for boolean
 */
BooleanLogicalNot :: impl boolean, LogicalNot(
  (!): ((a) ->
    __yo_op_not(a)
  )
);

ComptBooleanLogicalNot :: impl boolean, ComptLogicalNot(
  (!): ((self) ->
    cond
      self => false,
      true => true
  )
);

export
  LogicalNot,
  ComptLogicalNot,
  BitNot,
  BitAnd,
  BitOr,
  BitXor,

  (!),
  not,

  BooleanLogicalNot,
  ComptBooleanLogicalNot
;