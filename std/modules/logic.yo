open import("../builtins.yo");

/*
// && and || are short-circuiting logical operations.
// The logical operations are defined in terms of the boolean type.
// They shouldn't be modules
LogicalAnd :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs)-> compt(Module))
  module
    Self := Lhs,
    (&&) : (fn(lhs: Lhs, rhs: Rhs)-> boolean)
;

LogicalOr :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs)-> compt(Module))
  module
    Self := Lhs,
    (||) : (fn(lhs: Lhs, rhs: Rhs)-> boolean)
;
*/

LogicalNot :: (fn(compt(Self): Type) -> compt(Module))
  module
    Self := Self,
    (!)  : (fn(self: Self)-> boolean)
;

BitNot :: (fn(compt(Self): Type) -> compt(Module))
  module
    Self   := Self,
    Output := Self,
    (~)  : (fn(self: Self)-> Output)
;

BitAnd :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs) -> compt(Module)) 
  module
    Self   := Lhs,
    Output := Lhs,
    (&)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

BitOr :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs) -> compt(Module))
  module
    Self   := Lhs,
    Output := Lhs,
    (|)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

BitXor :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= boolean) -> compt(Module)) 
  module
    Self   := Lhs,
    (^)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

ComptLogicalNot :: (fn(compt(Self): Type) -> compt(Module))
  module
    Self := Self,
    (!)  : (fn(compt(self): Self) -> compt(boolean))
  ;

(!) :: module {
  (not) :: (fn( forall(Self : Type),
            self : Self,
            using(LogicalNotMethod : LogicalNot(Self))
          ) -> boolean)
    LogicalNotMethod.(!)(self)
  ;

  (compt_not) :: (fn(forall(Self : Type), 
          compt(self) : Self,
          using(LogicalNotMethod : ComptLogicalNot(Self))
        ) -> compt(boolean))
    LogicalNotMethod.(!)(self)
  ;

  Self :: (not, compt_not);

  export
    Self,
    not,
    compt_not
  ;
};
(not) :: (!);

/**
 * logic for boolean
 */
given(BooleanLogicalNot) :: LogicalNot(boolean)
  (!): ((a) ->
    __yo_op_not(a)
  )
;

given(ComptBooleanLogicalNot) :: ComptLogicalNot(boolean)
  (!): ((self) ->
    cond
      self => false,
      true => true
  )
;

export
  LogicalNot,
  ComptLogicalNot,
  BitNot,
  BitAnd,
  BitOr,
  BitXor,

  (!),
  not,

  BooleanLogicalNot,
  ComptBooleanLogicalNot
;