open import "../data/primitives";
open import "../data/result.yo";
{ SIZE_MAX } :: import "../libc/stdint.yo";

/**
 * Allocation error types
 */
AllocError :: enum(
  OutOfMemory,
  InvalidSize,
  InvalidAlignment,
  InvalidPointer
);

/**
 * Memory layout information for a type
 */
Layout :: struct(
  size: usize,
  alignment: usize
);

/**
 * Get the memory layout for a type T
 */
layout_of :: 
  (fn(compt(T): Type) -> compt(Layout))
    Layout(
      size: sizeof(T),
      alignment: alignof(T)
    )
;

/**
 * Check if a size calculation would overflow
 */
size_would_overflow :: 
  (fn(compt(T): Type, count: usize) -> boolean) {
    type_size :: sizeof(T);
    cond 
      (type_size == (0).as(usize)) => false,
      true => (count > (SIZE_MAX / type_size))
  };

CustomAllocator :: module(
  Self : Type,

  /**
   * Allocate memory for count times of type T.
   */
  alloc : (fn(self : *(Self), compt(T): Type, count: usize) -> Result(?*(T), AllocError)),

  /**
   * Allocate zeroed memory for count items of type T
   */
  alloc_zeroed : (fn(self : *(Self), compt(T): Type, count: usize) -> Result(?*(T), AllocError)),

  /**
   * Allocate aligned memory for count items of type T
   */
  alloc_aligned : (fn(self : *(Self), compt(T): Type, count: usize, alignment: usize) -> Result(?*(T), AllocError)),

  /**
   * Reallocate memory to new_count items
   */
  realloc : (fn(forall(T : Type), self : *(Self), old_ptr : ?*(T), new_count : usize) -> Result(?*(T), AllocError)),

  /**
   * Deallocate memory pointed to by ptr.
   */
  dealloc : (fn(forall(T : Type), self : *(Self), ptr : *(T)) -> Result(unit, AllocError))
);

Allocator :: *(Dyn(CustomAllocator));

// Global Allocator
// We are using mimalloc if that's available
extern "Yo",
  yo_malloc : 
    fn(size: usize) -> ?*(void),
  yo_calloc :
    fn(nmemb: usize, size: usize) -> ?*(void),
  yo_realloc :
    fn(ptr : ?*(void), size : usize) -> ?*(void),
  yo_free :
    fn(ptr : ?*(void)) -> unit,
  yo_aligned_alloc :
    fn(alignment : usize, size : usize) -> ?*(void)
;

GlobalAllocator :: impl {
  malloc :: yo_malloc;
  calloc :: yo_calloc;
  realloc :: yo_realloc;
  free :: yo_free;
  aligned_alloc :: yo_aligned_alloc;

  export
    malloc,
    calloc,
    realloc,
    free,
    aligned_alloc
  ;
};

export
  size_would_overflow,
  CustomAllocator,
  Allocator,
  Layout,
  layout_of,
  AllocError,

  GlobalAllocator
;