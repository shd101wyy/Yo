Functor :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type))
  ) -> compt(Module))
  module(
    map : 
      fn(
        forall(A : Type, B : Type),
        a : Wrapper(A),
        f : (fn(a : A) => B)
      ) -> Wrapper(B)
  )
;

Apply :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type)),
  using(FunctorWrapper : Functor(Wrapper))
  ) -> compt(Module))
  module(
    (apply) : 
      fn(
        forall(A : Type, B : Type),
        f : Wrapper(fn(a : A) => B),
        a : Wrapper(A)
      ) -> Wrapper(B),

    (<*>) ?= apply
  )
;

Applicative :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type)),
  using(ApplyWrapper : Apply(Wrapper))
  ) -> compt(Module))
  module(
    pure : 
      fn(
        forall(A : Type),
        a : A
      ) -> Wrapper(A)
  )
;

Bind :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type)),
  using(ApplyWrapper : Apply(Wrapper))
  ) -> compt(Module))
  module(
    (bind) : 
      fn(
        forall(A : Type, B : Type),
        a : Wrapper(A),
        f : (fn(a : A) => Wrapper(B))
      ) -> Wrapper(B),

    (>>=) ?= bind
  )
;

Monad :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type)),
  using(
    ApplicativeWrapper : Applicative(Wrapper),
    BindWrapper : Bind(Wrapper))
  ) -> compt(Module))
  module()
;

Semigroup :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type))
  ) -> compt(Module))
  module(
    (append) : 
      fn(
        forall(A : Type),
        a : Wrapper(A),
        b : Wrapper(A)
      ) -> Wrapper(A)
  )
;

Monoid :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type)),
  using(SemigroupWrapper : Semigroup(Wrapper))
  ) -> compt(Module))
  module(
    (empty) : 
      fn(
        forall(A : Type),
        a : Wrapper(A)
      ) -> Wrapper(A)
  )
;

Foldable :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type))
  ) -> compt(Module))
  module(
    foldr : 
      fn(
        forall(A : Type, B : Type),
        a : Wrapper(A),
        f : (fn(a : A, b : B) => B),
        b0 : B
      ) -> B,
    foldl : 
      fn(
        forall(A : Type, B : Type),
        a : Wrapper(A),
        f : (fn(b : B, a : A) => B),
        b0 : B
      ) -> B
    fold_map :
      fn(
        forall(A : Type, M : Type),
        a : Wrapper(A),
        f : (fn(a : A) => M),
        using(MonoidWrapper : Monoid(M))
      ) -> M
  )
;

export
  Functor,
  Apply,
  Applicative,
  Bind,
  Monad,
  Monoid,
  Foldable
;