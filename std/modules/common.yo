def Drop:
  (@(Self): Type)-> @(Type),
  module
    (Self: Type) == Self,
    drop: 
      (self: Self)-> ()
;

def Clone:
  (@(Self): Linear)-> @(Type),
  module
    (Self: Type) == Self,
    clone: 
      (self: &(Self))-> Self
;


/*
