Clone ::
  (fn(compt(Self): Type)-> compt(Module))
  module
    Self  := Self,
    clone : 
      fn(self: &(Self))-> Self
;

clone :: (fn( forall(compt(Self): Type),
            self : &(Self), 
            using(compt(CloneMethod) : Clone(Self))
          ) -> Self)
  CloneMethod.clone(self)
;

% :: clone; // IDEA: two circles and a slash perfectly represent clone!


Drop :: (fn(compt(Self): Type) -> compt(Module))
  module
    Self := Self,
    drop :
      fn(self: Self) -> unit
;


// IDEA: For struct that implements the `clone` method, we regard it as `Clone(StructType)` as well.
// ^ This is already implemented

export 
  Clone,
  clone,
  %,
  Drop
;
