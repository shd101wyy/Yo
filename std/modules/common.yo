Drop :: ((@(Self_): Type)-> @(Type))
  module
    Self :: Self_,
    @(drop) :
      (self: Self)-> unit
;

Clone ::
  ((@(Self): Linear)-> @(Type))
  module
    Self :: Self,
    clone: 
      (self: &(Self))-> Self
;


/*
// QUESTION: What should be the parameter type here
fn Copy(T: Free), interface {
  copy: (fn(self: T)-> T)
};
*/

export 
  Drop, 
  Clone
;