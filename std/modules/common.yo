Clone ::
  ((@(Self): Type)-> @(Type))
  module
    Self  := Self,
    clone : 
      (self: &(Self))-> Self
;

clone :: (( forall(@(Self): Type),
            self : &(Self), 
            implicit(@(CloneMethod) : Clone(Self))
          ) -> Self)
  CloneMethod.clone(self)
;

% :: clone; // IDEA: two circles and a slash perfectly represent clone!

// IDEA: For struct that implements the `clone` method, we regard it as `Clone(StructType)` as well.

export 
  Clone,
  clone,
  %
;
