Clone :: (fn(compt(Output) : Type) -> compt(Module))
  module
    clone : 
      fn(self: Self) -> Output
;

clone :: (fn( forall(_Self : Type),
            self : _Self, 
            using(CloneMethod) : (_Self <: Clone(_Self))
          ) -> _Self)
  CloneMethod.clone(self)
;

% :: clone; // IDEA: two circles and a slash perfectly represent clone!


Drop :: module
  drop :
    fn(self: Self) -> unit
;


// IDEA: For struct that implements the `clone` method, we regard it as `Clone(StructType)` as well.
// ^ This is already implemented

export 
  Clone,
  clone,
  %,
  Drop
;
