def Drop:
  (@(This): Type)-> @(Type),
  module
    (This: Type) == This,
    drop: 
      (self: This)-> ()
;

def Clone:
  (@(This): Linear)-> @(Type),
  module
    (This: Type) == This,
    clone: 
      (self: &(This))-> This
;


/*
// QUESTION: What should be the parameter type here
fn Copy(T: Free), interface {
  copy: (fn(self: T)-> T)
};
*/

export { Drop, Clone }