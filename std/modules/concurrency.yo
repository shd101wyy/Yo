extern "Yo",
  // Cooperative multithreading
  __yo_task_yield: (fn() -> unit),
  __yo_task_wait_all: (fn() -> unit),
  __yo_concurrency_set_maximum_threads: (fn(num: usize) -> unit)
;

Concurrency :: impl {
  yield :: __yo_task_yield;
  wait_all:: __yo_task_wait_all;
  set_maximum_threads :: __yo_concurrency_set_maximum_threads;

  export
    yield,
    wait_all,
    set_maximum_threads
  ;
};

export
  Concurrency
;