/*
def FnOnce:
  (compt(Context): Type, compt(Arguments): Type, compt(Output): Type)-> compt(Type), 
  module
    call_once: 
      (self: Context, arguments: Arguments)
        -> Output
;

def FnMut:
  (compt(Context): Type, compt(Arguments): Type, compt(Output): Type, implicit(compt(fn_mut): FnOnce(Context, Arguments, Output)))
    -> compt(Type), 
  module
    call_mut: 
