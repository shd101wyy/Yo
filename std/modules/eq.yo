Eq :: 
  ((@(Lhs): Type, @(Rhs) ?= Lhs) -> @(Type))
  module
    Self := Lhs,

    eq: ((lhs: &(Lhs), rhs: &(Rhs)) -> boolean),

    (ne: ((lhs: &(Lhs), rhs: &(Rhs)) -> boolean)) ?= 
      (fn(lhs, rhs) ->
        not(eq(lhs, rhs))
    )
;

// x == y
// automatically converted to
// Eq.eq(&x, &y)
// or
// x.eq(&y)
/*
(==) :: (( quote(lhs) : Expr, quote(rhs) : Expr)-> unquote(Expr))
  quote(
    Eq(typeof(unquote(lhs))).eq(&(unquote(lhs)), &(unquote(rhs)))
  )
*/

export Eq;