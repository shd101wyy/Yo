Eq :: 
  ((@(Lhs): Type, @(Rhs) ?= Lhs) -> @(Type))
  module
    Self := Lhs,
    eq: ((lhs: &(Lhs), rhs: &(Rhs)) -> boolean),
    (ne: ((lhs: &(Lhs), rhs: &(Rhs)) -> boolean)) ?= 
      (fn(lhs, rhs) ->
        not(eq(lhs, rhs))
    )
;

// x == y
// automatically converted to
// Eq.eq(&x, &y)
// or
// x.eq(&y)
/*
export macro (==) <Lhs, Rhs>(lhs: Expr<Lhs>, rhs: Expr<Rhs>): Expr<boolean> {
  Eq.eq(&lhs, &rhs)
}
*/

export Eq;