{ not, BooleanLogicalNot } :: import "./logic.yo";

Eq ::
  (fn(compt(Rhs) : Type) -> compt(Module))
  module
    (==) : (fn(lhs: Self, rhs: Rhs) -> boolean),

    ((!=) : (fn(lhs: Self, rhs: Rhs) -> boolean)) ?= 
      ((lhs, rhs) ->
        not(Self.(==)(lhs, rhs), BooleanLogicalNot)
      )
;

export Eq;