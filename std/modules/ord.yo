{ Eq } :: import "./eq.yo";

Ordering :: enum
  Less,
  Equal,
  Greater
;

Ord :: (
  ( compt(Lhs): Type,
    compt(Rhs) ?= Lhs,
    implicit(compt(EqSelf) : Eq(Lhs, Rhs))
  ) -> compt(Module))
  module
    (<) :
      (lhs: Lhs, rhs: Rhs) -> boolean,
    (<=) :
      (lhs: Lhs, rhs: Rhs) -> boolean,
    (>) :
      (lhs: Lhs, rhs: Rhs) -> boolean,
    (>=) :
      (lhs: Lhs, rhs: Rhs) -> boolean
;

export 
  Ordering, 
  Ord
;