{ Eq } :: import "./eq.yo";

Ordering :: enum
  Less,
  Equal,
  Greater
;

Ord :: (((@(Self) : Type), implicit(@(EqSelf) : Eq(Self))) -> @(Module))
  module
    compare :
      (self: &(Self), other: &(Self)) -> Ordering,
    lt :
      (self: &(Self), other: &(Self)) -> boolean,
    gt :
      (self: &(Self), other: &(Self)) -> boolean,
    lte :
      (self: &(Self), other: &(Self)) -> boolean,
    gte :
      (self: &(Self), other: &(Self)) -> boolean
;

export 
  Ordering, 
  Ord
;