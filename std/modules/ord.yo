{ Eq } :: import "./eq.yo";

Ordering :: enum
  Less,
  Equal,
  Greater
;

Ord :: (
  fn(
    compt(Rhs) : Type
  ) -> compt(Module))
  module
    Self : Type,
    using(EqSelf) : (Self <: Eq(Rhs)),

    (<) :
      fn(lhs: Self, rhs: Rhs) -> boolean,
    (<=) :
      fn(lhs: Self, rhs: Rhs) -> boolean,
    (>) :
      fn(lhs: Self, rhs: Rhs) -> boolean,
    (>=) :
      fn(lhs: Self, rhs: Rhs) -> boolean
;

export 
  Ordering, 
  Ord
;