{ Eq } :: import "./eq.yo";

Ordering :: enum
  Less,
  Equal,
  Greater
;

Ord :: (
  ( @(Lhs): Type,
    @(Rhs) ?= Lhs,
    implicit(@(EqSelf) : Eq(Lhs, Rhs))
  ) -> @(Module))
  module
    (<) :
      (lhs: Lhs, rhs: Rhs) -> boolean,
    (<=) :
      (lhs: Lhs, rhs: Rhs) -> boolean,
    (>) :
      (lhs: Lhs, rhs: Rhs) -> boolean,
    (>=) :
      (lhs: Lhs, rhs: Rhs) -> boolean
;

export 
  Ordering, 
  Ord
;