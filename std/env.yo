//! Process environment: command-line arguments, environment variables,
//! current working directory, and platform-aware user directories.
//!
//! Mirrors the layout of Rust's `std::env`. Platform/architecture detection
//! and child-process spawning live in `std/process`.
pragma(Pragma.AllowUnsafe);
open(import("./collections/array_list"));
open(import("./string"));
open(import("./path"));
{ ToString } :: import("./fmt/to_string.yo");
{ platform, Platform } :: import("./process");
{ GlobalAllocator } :: import("./allocator");
{ malloc, free } :: GlobalAllocator;
// === Low-level C interface ===
extern(
  "Yo",
  __yo_argc : i32,
  __yo_argv : **u8
);
// === Command-line arguments ===
/// Get command-line arguments as an `ArrayList(String)`.
/// The first element is the program name.
args :: (fn() -> ArrayList(String))({
  i := usize(0);
  len := usize(__yo_argc);
  result := ArrayList(String).with_capacity(len);
  while(i < len, {
    // SAFETY: i < argc; argv is the C runtime's argument vector.
    arg_ptr := unsafe((__yo_argv.add(i)).*);
    arg_str := String.from_cstr(arg_ptr).unwrap();
    result.push(arg_str);
    i = (i + 1);
  });
  return(result);
});
export(args);
/// Environment variable access and manipulation.
env :: impl({
  { getenv, setenv, unsetenv } :: import("./libc/stdlib");
  /// Get the value of an environment variable by name.
  /// Returns `.None` if the variable is not set. The key is any `ToString`
  /// (audit env row: `str` keys) — a literal works directly.
  get :: (fn(generic(K : Type), name : K, where(K <: ToString)) -> Option(String))({
    name_cstr := name.to_string().to_cstr().ptr().unwrap();
    val_ptr := unsafe(getenv(*(char)(name_cstr)));
    match(
      val_ptr,
      .None => .None,
      .Some(ptr) => .Some(String.from_cstr(*(u8)(ptr)).unwrap())
    )
  });
  export(get);
  /// Set an environment variable. If `overwrite` is false and the variable
  /// already exists, it is not modified. Returns true on success. Key and
  /// value are any `ToString` (audit env row: `str` keys).
  set :: (fn(generic(K : Type, V : Type), name : K, value : V, (overwrite : bool) ?= true, where(K <: ToString, V <: ToString)) -> bool)({
    name_cstr := name.to_string().to_cstr().ptr().unwrap();
    value_cstr := value.to_string().to_cstr().ptr().unwrap();
    result := cond(
      (platform == Platform.Windows) => {
        // Package-absolute: a GENERIC method body re-specializes per call
        // site, so a relative import here would resolve against the CALLER's
        // directory (the windows cross-emit's "tried src/libc/windows.yo").
        { _putenv_s } :: import("std/libc/windows");
        cond(
          overwrite =>
            unsafe(_putenv_s(*(char)(name_cstr), *(char)(value_cstr))),
          true => {
            existing := unsafe(getenv(*(char)(name_cstr)));
            match(
              existing,
              .Some(_) => int(0),
              .None => unsafe(_putenv_s(*(char)(name_cstr), *(char)(value_cstr)))
            )
          }
        )
      },
      true => {
        overwrite_int := cond(
          overwrite => int(1),
          true => int(0)
        );
        unsafe(setenv(*(char)(name_cstr), *(char)(value_cstr), overwrite_int))
      }
    );
    return(result == int(0));
  });
  export(set);
  /// Remove an environment variable. Returns true on success (removing a
  /// variable that was not set is also success, matching `unsetenv`).
  /// POSIX uses `unsetenv`; Windows removes by setting an empty value.
  remove :: (fn(generic(K : Type), name : K, where(K <: ToString)) -> bool)({
    name_cstr := name.to_string().to_cstr().ptr().unwrap();
    result := cond(
      (platform == Platform.Windows) => {
        { _putenv_s } :: import("std/libc/windows");
        unsafe(_putenv_s(*(char)(name_cstr), *(char)(String.from("").to_cstr().ptr().unwrap())))
      },
      true => {
        r := unsafe(unsetenv(*(char)(name_cstr)));
        r
      }
    );
    return(result == int(0));
  });
  export(remove);
  /// Every environment variable as `IterPair(String, String)` key/value
  /// pairs (audit env row: `vars()` iteration). Reads the C `environ`
  /// array (`_environ` on Windows — the ANSI copy, so Unicode-valued
  /// variables are not represented there).
  vars :: (fn() -> ArrayList(IterPair(String, String)))({
    out := ArrayList(IterPair(String, String)).new();
    entries := cond(
      (platform == Platform.Windows) => {
        { _environ } :: import("std/libc/windows");
        _environ
      },
      (platform == Platform.Macos) => {
        { _NSGetEnviron } :: import("std/libc/darwin");
        envp := unsafe(_NSGetEnviron());
        envp.*
      },
      true => {
        { environ } :: import("std/libc/unistd");
        environ
      }
    );
    i := usize(0);
    while(true, {
      entry_ptr := unsafe((entries.add(i)).*);
      stop := match(
        entry_ptr,
        .Some(p) => {
          entry := String.from_cstr(*(u8)(p)).unwrap_or(String.new());
          eq := entry.index_of(rune(u32(61)));
          kv := match(
            eq,
            .Some(pos) => {
              k := entry.substring(usize(0), pos);
              v := entry.substring(pos + usize(1), entry.len());
              out.push(IterPair(String, String)(_0 : k, _1 : v));
              false
            },
            .None => {
              // Malformed entry without '=': keep it whole as the key.
              out.push(IterPair(String, String)(_0 : entry, _1 : String.new()));
              false
            }
          );
          kv
        },
        .None => true
      );
      if(stop, {
        return(out);
      });
      i = (i + usize(1));
    });
    out
  });
  export(vars);
});
export(env);
/// Get the current working directory as a `Path`.
/// Returns `Err` with a message on failure.
cwd :: (fn() -> Result(Path, String))(
  cond(
    (platform == Platform.Windows) => {
      { GetCurrentDirectoryW, WideCharToMultiByte, CP_UTF8, WCHAR, DWORD } :: import("./libc/windows");
      required_size := unsafe(GetCurrentDirectoryW(ulong(0), .None));
      cond(
        (required_size == ulong(0)) => .Err(`Failed to get current working directory on Windows`),
        true => {
          wbuf := *(WCHAR)(malloc(usize(required_size) * usize(2)).unwrap());
          actual_size := unsafe(GetCurrentDirectoryW(required_size, .Some(wbuf)));
          cond(
            (actual_size == ulong(0)) => {
              free(.Some(*(void)(wbuf)));
              .Err(`Failed to get current working directory on Windows`)
            },
            true => {
              utf8_size := unsafe(
                WideCharToMultiByte(
                  CP_UTF8,
                  ulong(0),
                  .Some(wbuf),
                  i32(actual_size),
                  .None,
                  i32(0),
                  .None,
                  .None
                )
              );
              cond(
                (utf8_size <= i32(0)) => {
                  free(.Some(*(void)(wbuf)));
                  .Err(`Failed to convert directory path to UTF-8`)
                },
                true => {
                  utf8_buf := *(u8)(malloc(usize(utf8_size) + usize(1)).unwrap());
                  result := unsafe(
                    WideCharToMultiByte(
                      CP_UTF8,
                      ulong(0),
                      .Some(wbuf),
                      i32(actual_size),
                      .Some(utf8_buf),
                      utf8_size,
                      .None,
                      .None
                    )
                  );
                  free(.Some(*(void)(wbuf)));
                  cond(
                    (result <= i32(0)) => {
                      free(.Some(*(void)(utf8_buf)));
                      .Err(`Failed to convert directory path to UTF-8`)
                    },
                    true => {
                      (utf8_buf.add(usize(result))).* = u8(0);
                      cwd_str := String.from_cstr(utf8_buf).unwrap();
                      free(.Some(*(void)(utf8_buf)));
                      .Ok(Path.new(cwd_str))
                    }
                  )
                }
              )
            }
          )
        }
      )
    },
    true => {
      { getcwd } :: import("./libc/unistd");
      // 4096 is PATH_MAX on Linux/macOS and exceeds MAX_PATH (260) on Windows;
      // the few systems with longer paths fail gracefully via the .None branch
      // below (getcwd returns NULL and sets errno=ERANGE).
      buf_size := usize(4096);
      buf := *(char)(malloc(buf_size).unwrap());
      // SAFETY: `buf` points at a fresh malloc'd `buf_size`-byte buffer and
      // is freed in both branches below. `getcwd(buf, buf_size)` writes at
      // most `buf_size - 1` bytes plus a terminating NUL, then returns either
      // `buf` (success) or NULL (failure — buffer too small / cwd unlinked).
      result_ptr := unsafe(getcwd(buf, buf_size));
      match(
        result_ptr,
        .None => {
          free(.Some(*(void)(buf)));
          .Err(`Failed to get current working directory`)
        },
        .Some(ptr) => {
          cwd_str := String.from_cstr(*(u8)(ptr)).unwrap();
          free(.Some(*(void)(buf)));
          .Ok(Path.new(cwd_str))
        }
      )
    }
  )
);
export(cwd);
/// Get the absolute path of the current executable.
/// The path is symlink-resolved on macOS/Linux (via `/proc/self/exe` on
/// Linux, `_NSGetExecutablePath` + `realpath` on macOS) and comes from
/// `GetModuleFileNameW` on Windows. Returns `Err` with a message on failure
/// or on platforms without a way to discover the executable (wasm).
current_exe :: (fn() -> Result(Path, String))(
  cond(
    (platform == Platform.Windows) => {
      { GetModuleFileNameW, WideCharToMultiByte, CP_UTF8, WCHAR } :: import("./libc/windows");
      // 32768 WCHARs covers the maximum extended-length path.
      buf_len := ulong(32768);
      wbuf := *(WCHAR)(malloc(usize(buf_len) * usize(2)).unwrap());
      copied := unsafe(GetModuleFileNameW(.None, wbuf, buf_len));
      cond(
        ((copied == ulong(0)) || (copied >= buf_len)) => {
          free(.Some(*(void)(wbuf)));
          .Err(`Failed to get the executable path on Windows`)
        },
        true => {
          utf8_size := unsafe(
            WideCharToMultiByte(
              CP_UTF8,
              ulong(0),
              .Some(wbuf),
              i32(copied),
              .None,
              i32(0),
              .None,
              .None
            )
          );
          cond(
            (utf8_size <= i32(0)) => {
              free(.Some(*(void)(wbuf)));
              .Err(`Failed to convert the executable path to UTF-8`)
            },
            true => {
              utf8_buf := *(u8)(malloc(usize(utf8_size) + usize(1)).unwrap());
              result := unsafe(
                WideCharToMultiByte(
                  CP_UTF8,
                  ulong(0),
                  .Some(wbuf),
                  i32(copied),
                  .Some(utf8_buf),
                  utf8_size,
                  .None,
                  .None
                )
              );
              free(.Some(*(void)(wbuf)));
              cond(
                (result <= i32(0)) => {
                  free(.Some(*(void)(utf8_buf)));
                  .Err(`Failed to convert the executable path to UTF-8`)
                },
                true => {
                  (utf8_buf.add(usize(result))).* = u8(0);
                  exe_str := String.from_cstr(utf8_buf).unwrap();
                  free(.Some(*(void)(utf8_buf)));
                  .Ok(Path.new(exe_str))
                }
              )
            }
          )
        }
      )
    },
    (platform == Platform.Macos) => {
      { _NSGetExecutablePath } :: import("./libc/dyld");
      { realpath } :: import("./libc/stdlib");
      // *bufsize in/out parameter for _NSGetExecutablePath.
      size_ptr := *(u32)(malloc(usize(4)).unwrap());
      (size_ptr).* = u32(4096);
      buf := *(char)(malloc(usize(4096)).unwrap());
      rc := unsafe(_NSGetExecutablePath(buf, size_ptr));
      // On -1 the buffer was too small and *size_ptr holds the needed size —
      // retry once with exactly that size.
      raw_path := cond(
        (rc == int(0)) => Option(*char).Some(buf),
        true => {
          free(.Some(*(void)(buf)));
          needed := usize(unsafe((size_ptr).*));
          buf2 := *(char)(malloc(needed).unwrap());
          rc2 := unsafe(_NSGetExecutablePath(buf2, size_ptr));
          cond(
            (rc2 == int(0)) => Option(*char).Some(buf2),
            true => {
              free(.Some(*(void)(buf2)));
              Option(*char).None
            }
          )
        }
      );
      free(.Some(*(void)(size_ptr)));
      match(
        raw_path,
        .None => .Err(`Failed to get the executable path on macOS`),
        .Some(pbuf) => {
          // _NSGetExecutablePath may return a symlinked/relative path —
          // canonicalize it. Pass OUR OWN buffer rather than NULL: with a NULL
          // second argument realpath returns a buffer from libc's malloc, and
          // releasing that through GlobalAllocator is a cross-allocator free.
          // Under `--allocator mimalloc` — which every release bundle uses —
          // mi_free rejects it ("mi_free: invalid pointer") and the buffer
          // leaks, one PATH_MAX block and one stderr line per call. POSIX
          // requires a caller-supplied buffer to hold at least PATH_MAX bytes;
          // 4096 covers macOS's 1024.
          rbuf := *(char)(malloc(usize(4096)).unwrap());
          resolved := unsafe(realpath(pbuf, .Some(rbuf)));
          free(.Some(*(void)(pbuf)));
          match(
            resolved,
            .None => {
              free(.Some(*(void)(rbuf)));
              .Err(`Failed to resolve the executable path on macOS`)
            },
            .Some(rp) => {
              exe_str := String.from_cstr(*(u8)(rp)).unwrap();
              free(.Some(*(void)(rbuf)));
              .Ok(Path.new(exe_str))
            }
          )
        }
      )
    },
    (platform == Platform.Linux) => {
      { readlink } :: import("./libc/unistd");
      // /proc/self/exe is already a fully resolved path; readlink does not
      // null-terminate, so reserve one byte and terminate manually.
      buf_size := usize(4096);
      buf := *(u8)(malloc(buf_size).unwrap());
      link_cstr := String.from("/proc/self/exe").to_cstr().ptr().unwrap();
      n := unsafe(readlink(*(char)(link_cstr), *(char)(buf), buf_size - usize(1)));
      cond(
        (n < isize(0)) => {
          free(.Some(*(void)(buf)));
          .Err(`Failed to read /proc/self/exe`)
        },
        true => {
          (buf.add(usize(n))).* = u8(0);
          exe_str := String.from_cstr(buf).unwrap();
          free(.Some(*(void)(buf)));
          .Ok(Path.new(exe_str))
        }
      )
    },
    true => .Err(`current_exe is not supported on platform '${platform}'`)
  )
);
export(current_exe);
/// Change the current working directory to `path`.
/// Returns `Ok(())` on success, or `Err` with a message on failure.
chdir :: (fn(path : Path) -> Result(unit, String))(
  cond(
    (platform == Platform.Windows) => {
      { SetCurrentDirectoryA, BOOL } :: import("./libc/windows");
      path_str := path.to_string();
      path_cstr := path_str.to_cstr().ptr().unwrap();
      result := unsafe(SetCurrentDirectoryA(*(char)(path_cstr)));
      cond(
        (result == int(0)) => .Err(`Failed to change directory to: ${path_str}`),
        true => .Ok(())
      )
    },
    true => {
      { chdir : unix_chdir } :: import("./libc/unistd");
      path_str := path.to_string();
      path_cstr := path_str.to_cstr().ptr().unwrap();
      // SAFETY: `unix_chdir` is libc `chdir` aliased on import;
      // `path_cstr` is the null-terminated buffer that `to_cstr()`
      // just produced and `path_str` keeps alive across this call.
      result := unsafe(unix_chdir(*(char)(path_cstr)));
      cond(
        (result != int(0)) => .Err(`Failed to change directory to: ${path_str}`),
        true => .Ok(())
      )
    }
  )
);
export(chdir);
// ============================================================================
// Directory helpers
// ============================================================================
/// Return the current user's home directory, or `.None` if unavailable.
home_dir :: (fn() -> Option(String))(
  cond(
    (platform == Platform.Windows) => match(
      env.get(`USERPROFILE`),
      .Some(p) => .Some(p),
      .None => match(
        env.get(`HOMEDRIVE`),
        .None => .None,
        .Some(drive) => match(
          env.get(`HOMEPATH`),
          .None => .None,
          .Some(path) => .Some(drive.concat(path))
        )
      )
    ),
    true => env.get(`HOME`)
  )
);
export(home_dir);
/// Return the user-specific configuration directory.
///
/// - Linux/macOS: `$XDG_CONFIG_HOME` or `$HOME/.config`
/// - Windows: `%APPDATA%`
config_dir :: (fn() -> Option(String))(
  cond(
    (platform == Platform.Windows) => env.get(`APPDATA`),
    true => match(
      env.get(`XDG_CONFIG_HOME`),
      .Some(d) => .Some(d),
      .None => match(
        home_dir(),
        .None => .None,
        .Some(h) => .Some(h.concat(`/.config`))
      )
    )
  )
);
export(config_dir);
/// Return the user-specific cache directory.
///
/// - Linux: `$XDG_CACHE_HOME` or `$HOME/.cache`
/// - macOS: `$HOME/Library/Caches`
/// - Windows: `%LOCALAPPDATA%`
cache_dir :: (fn() -> Option(String))(
  cond(
    (platform == Platform.Windows) => env.get(`LOCALAPPDATA`),
    (platform == Platform.Macos) => match(
      home_dir(),
      .None => .None,
      .Some(h) => .Some(h.concat(`/Library/Caches`))
    ),
    true => match(
      env.get(`XDG_CACHE_HOME`),
      .Some(d) => .Some(d),
      .None => match(
        home_dir(),
        .None => .None,
        .Some(h) => .Some(h.concat(`/.cache`))
      )
    )
  )
);
export(cache_dir);
/// Return the system temporary directory.
///
/// - Linux/macOS: `$TMPDIR`, else `/tmp` (POSIX honors TMPDIR; on macOS it
///   is a per-user confined directory — plans/STD_API_AUDIT.md D8)
/// - Windows: `%TEMP%`, then `%TMP%`, else `C:\Temp`
temp_dir :: (fn() -> String)(
  cond(
    (platform == Platform.Windows) => match(
      env.get(`TEMP`),
      .Some(t) => t,
      .None => match(
        env.get(`TMP`),
        .Some(t2) => t2,
        .None => `C:\Temp`
      )
    ),
    true => match(
      env.get(`TMPDIR`),
      .Some(t3) => t3,
      .None => `/tmp`
    )
  )
);
export(temp_dir);
