//! Process environment: command-line arguments, environment variables,
//! and current working directory.
//!
//! Mirrors the layout of Rust's `std::env`. Platform/architecture detection
//! and child-process spawning live in `std/process`.
pragma(Pragma.AllowUnsafe);
open(import("./collections/array_list"));
open(import("./string"));
open(import("./path"));
{ platform, Platform } :: import("./process");
{ GlobalAllocator } :: import("./allocator");
{ malloc, free } :: GlobalAllocator;
// === Low-level C interface ===
extern(
  "Yo",
  __yo_argc : i32,
  __yo_argv : *(*(u8))
);
// === Raw command-line arguments ===
/// Get raw command-line arguments as a RawSlice of C strings (privileged:
/// callers must be pragma'd to name RawSlice). The first element is the
/// program name.
raw_args :: (fn() -> RawSlice(*(u8)))({
  return(RawSlice(*(u8))(ptr : __yo_argv, len : usize(__yo_argc)));
});
export(raw_args);
/// Get the number of command-line arguments (including program name).
argc :: (fn() -> i32)({
  return(__yo_argc);
});
export(argc);
/// Get the raw `argv` pointer (`*(*(u8))`).
argv :: (fn() -> *(*(u8)))({
  return(__yo_argv);
});
export(argv);
// === Convenient command-line arguments ===
/// Get command-line arguments as an `ArrayList(String)`.
/// The first element is the program name.
args :: (fn() -> ArrayList(String))({
  i := usize(0);
  len := usize(argc());
  result := ArrayList(String).with_capacity(len);
  while(i < len, {
    // SAFETY: i < argc; argv is the C runtime's argument vector.
    arg_ptr := unsafe((__yo_argv.add(i)).*);
    arg_str := String.from_cstr(arg_ptr).unwrap();
    result.push(arg_str);
    i = (i + 1);
  });
  return(result);
});
export(args);
/// Environment variable access and manipulation.
env :: impl({
  { getenv, setenv } :: import("./libc/stdlib");
  /// Get the value of an environment variable by name.
  /// Returns `.None` if the variable is not set.
  get :: (fn(name : String) -> Option(String))({
    name_cstr := name.to_cstr().ptr().unwrap();
    val_ptr := unsafe(getenv(*(char)(name_cstr)));
    match(
      val_ptr,
      .None =>.None,
      .Some(ptr) =>.Some(String.from_cstr(*(u8)(ptr)).unwrap())
    )
  });
  export(get);
  /// Set an environment variable. If `overwrite` is false and the variable
  /// already exists, it is not modified. Returns true on success.
  set :: (fn(name : String, value : String, (overwrite : bool) ?= true) -> bool)({
    name_cstr := name.to_cstr().ptr().unwrap();
    value_cstr := value.to_cstr().ptr().unwrap();
    result := cond(
      (platform == Platform.Windows) => {
        { _putenv_s } :: import("./libc/windows");
        cond(
          overwrite =>
            unsafe(_putenv_s(*(char)(name_cstr), *(char)(value_cstr))),
          true => {
            existing := unsafe(getenv(*(char)(name_cstr)));
            match(
              existing,
              .Some(_) => int(0),
              .None => unsafe(_putenv_s(*(char)(name_cstr), *(char)(value_cstr)))
            )
          }
        )
      },
      true => {
        overwrite_int := cond(
          overwrite => int(1),
          true => int(0)
        );
        unsafe(setenv(*(char)(name_cstr), *(char)(value_cstr), overwrite_int))
      }
    );
    return(result == int(0));
  });
  export(set);
});
export(env);
/// Get the current working directory as a `Path`.
/// Returns `Err` with a message on failure.
cwd :: (fn() -> Result(Path, String))(
  cond(
    (platform == Platform.Windows) => {
      { GetCurrentDirectoryW, WideCharToMultiByte, CP_UTF8, WCHAR, DWORD } :: import("./libc/windows");
      required_size := unsafe(GetCurrentDirectoryW(ulong(0),.None));
      cond(
        (required_size == ulong(0)) =>.Err(`Failed to get current working directory on Windows`),
        true => {
          wbuf := *(WCHAR)(malloc(usize(required_size) * usize(2)).unwrap());
          actual_size := unsafe(GetCurrentDirectoryW(required_size,.Some(wbuf)));
          cond(
            (actual_size == ulong(0)) => {
              free(.Some(*(void)(wbuf)));
              .Err(`Failed to get current working directory on Windows`)
            },
            true => {
              utf8_size := unsafe(
                WideCharToMultiByte(
                  CP_UTF8,
                  ulong(0),
                  .Some(wbuf),
                  i32(actual_size),
                  .None,
                  i32(0),
                  .None,
                  .None
                )
              );
              cond(
                (utf8_size <= i32(0)) => {
                  free(.Some(*(void)(wbuf)));
                  .Err(`Failed to convert directory path to UTF-8`)
                },
                true => {
                  utf8_buf := *(u8)(malloc(usize(utf8_size) + usize(1)).unwrap());
                  result := unsafe(
                    WideCharToMultiByte(
                      CP_UTF8,
                      ulong(0),
                      .Some(wbuf),
                      i32(actual_size),
                      .Some(utf8_buf),
                      utf8_size,
                      .None,
                      .None
                    )
                  );
                  free(.Some(*(void)(wbuf)));
                  cond(
                    (result <= i32(0)) => {
                      free(.Some(*(void)(utf8_buf)));
                      .Err(`Failed to convert directory path to UTF-8`)
                    },
                    true => {
                      (utf8_buf.add(usize(result))).* = u8(0);
                      cwd_str := String.from_cstr(utf8_buf).unwrap();
                      free(.Some(*(void)(utf8_buf)));
                      .Ok(Path.new(cwd_str))
                    }
                  )
                }
              )
            }
          )
        }
      )
    },
    true => {
      { getcwd } :: import("./libc/unistd");
      // 4096 is PATH_MAX on Linux/macOS and exceeds MAX_PATH (260) on Windows;
      // the few systems with longer paths fail gracefully via the .None branch
      // below (getcwd returns NULL and sets errno=ERANGE).
      buf_size := usize(4096);
      buf := *(char)(malloc(buf_size).unwrap());
      // SAFETY: `buf` points at a fresh malloc'd `buf_size`-byte buffer and
      // is freed in both branches below. `getcwd(buf, buf_size)` writes at
      // most `buf_size - 1` bytes plus a terminating NUL, then returns either
      // `buf` (success) or NULL (failure — buffer too small / cwd unlinked).
      result_ptr := unsafe(getcwd(buf, buf_size));
      match(
        result_ptr,
        .None => {
          free(.Some(*(void)(buf)));
          .Err(`Failed to get current working directory`)
        },
        .Some(ptr) => {
          cwd_str := String.from_cstr(*(u8)(ptr)).unwrap();
          free(.Some(*(void)(buf)));
          .Ok(Path.new(cwd_str))
        }
      )
    }
  )
);
export(cwd);
/// Change the current working directory to `path`.
/// Returns `Ok(())` on success, or `Err` with a message on failure.
chdir :: (fn(path : Path) -> Result(unit, String))(
  cond(
    (platform == Platform.Windows) => {
      { SetCurrentDirectoryA, BOOL } :: import("./libc/windows");
      path_str := path.to_string();
      path_cstr := path_str.to_cstr().ptr().unwrap();
      result := unsafe(SetCurrentDirectoryA(*(char)(path_cstr)));
      cond(
        (result == int(0)) =>.Err(`Failed to change directory to: ${path_str}`),
        true =>.Ok(())
      )
    },
    true => {
      { chdir : unix_chdir } :: import("./libc/unistd");
      path_str := path.to_string();
      path_cstr := path_str.to_cstr().ptr().unwrap();
      // SAFETY: `unix_chdir` is libc `chdir` aliased on import;
      // `path_cstr` is the null-terminated buffer that `to_cstr()`
      // just produced and `path_str` keeps alive across this call.
      result := unsafe(unix_chdir(*(char)(path_cstr)));
      cond(
        (result != int(0)) =>.Err(`Failed to change directory to: ${path_str}`),
        true =>.Ok(())
      )
    }
  )
);
export(chdir);
