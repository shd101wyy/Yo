// std/io/future.yo - IOFuture type
//
// Opaque handle to C async I/O future struct.

// ============================================================================
// Extern type for I/O Future
// ============================================================================

extern "Yo",
  yo_io_future_t : Type
;

IOFuture :: Impl(Concrete(yo_io_future_t), Future(i32));

export
  yo_io_future_t,
  IOFuture
;
