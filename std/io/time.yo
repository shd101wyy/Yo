// std/io/time.yo - File timestamp operations
//
// Provides async wrappers for utime/futime/lutime to change file timestamps.
//
// All async operations return IOFuture which resolves to:
//   - 0: success
//   - Negative value: -errno on failure
//
// Timestamps use (seconds, nanoseconds) pairs for both atime and mtime.
// Use special value UTIME_NOW (0x3fffffff) to set current time,
// or UTIME_OMIT (0x3ffffffe) to leave a timestamp unchanged.
//
// Example:
//   time :: import "std/io/time";
//   { AT_FDCWD } :: import "std/io/constants";
//
//   async {
//     // Set both atime and mtime to specific values
//     ret := await time.utime(*(u8)("/tmp/test.txt"), i64(1000000), i64(0), i64(2000000), i64(0));
//     assert(ret == i32(0));
//
//     // Set timestamps on an open fd
//     ret2 := await time.futime(fd, i64(1000000), i64(0), i64(2000000), i64(0));
//     assert(ret2 == i32(0));
//   };

{ IOFuture } :: import "./future.yo";
{
  __yo_async_utime_start, __yo_async_futime_start, __yo_async_lutime_start
} :: import "./externs.yo";

// ============================================================================
// utime — Change file timestamps by path
// ============================================================================

// Change file access and modification times by path.
// path: file path (null-terminated)
// atime_sec, atime_nsec: access time (seconds + nanoseconds)
// mtime_sec, mtime_nsec: modification time (seconds + nanoseconds)
// Returns 0 on success, -errno on failure.
utime :: (fn(path: *(u8), atime_sec: i64, atime_nsec: i64, mtime_sec: i64, mtime_nsec: i64) -> IOFuture)(
  __yo_async_utime_start(path, atime_sec, atime_nsec, mtime_sec, mtime_nsec)
);

// ============================================================================
// futime — Change file timestamps by fd
// ============================================================================

// Change file access and modification times by file descriptor.
// fd: open file descriptor
// atime_sec, atime_nsec: access time (seconds + nanoseconds)
// mtime_sec, mtime_nsec: modification time (seconds + nanoseconds)
// Returns 0 on success, -errno on failure.
futime :: (fn(fd: i32, atime_sec: i64, atime_nsec: i64, mtime_sec: i64, mtime_nsec: i64) -> IOFuture)(
  __yo_async_futime_start(fd, atime_sec, atime_nsec, mtime_sec, mtime_nsec)
);

// ============================================================================
// lutime — Change symlink timestamps (does not follow symlinks)
// ============================================================================

// Change file access and modification times of a symlink itself.
// Does not follow the symlink (uses AT_SYMLINK_NOFOLLOW).
// path: symlink path (null-terminated)
// atime_sec, atime_nsec: access time (seconds + nanoseconds)
// mtime_sec, mtime_nsec: modification time (seconds + nanoseconds)
// Returns 0 on success, -errno on failure.
lutime :: (fn(path: *(u8), atime_sec: i64, atime_nsec: i64, mtime_sec: i64, mtime_nsec: i64) -> IOFuture)(
  __yo_async_lutime_start(path, atime_sec, atime_nsec, mtime_sec, mtime_nsec)
);

export utime, futime, lutime;
