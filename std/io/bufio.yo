//! Buffered wrappers over ANY async `Reader`/`Writer` — the D5 generic
//! `BufReader(R)` / `BufWriter(W)` (`plans/archive/STD_API_AUDIT.md` §D5), the
//! replacement for the fd-only `std/sys/bufio` pair it has now replaced.
//!
//! `BufReader(R)` reduces the number of inner reads by filling an internal
//! buffer in `capacity`-sized chunks; `BufWriter(W)` batches small writes and
//! delivers them with `write_all` when the buffer fills or `flush` is called.
//! Both implement the trait they wrap, so a `BufReader(R)` is itself a
//! `Reader` (and gets `read_to_end`/`read_to_string` for free) and a
//! `BufWriter(W)` is a `Writer`.
//!
//! **`BufWriter(W)` does NOT flush on drop.** A `Drop` cannot await the
//! inner writer's async `write`, so — like tokio's `BufWriter`, and unlike
//! the deleted fd-based `std/sys/bufio` writer, whose dispose could issue a
//! sync positional syscall — buffered bytes still in the writer when it is
//! dropped are LOST. Call `flush(io)` before letting it go.
//!
//! `lines()` is still absent, but no longer for the reason this doc used to
//! give. The async iterator protocol EXISTS now (`std/async/stream.yo`); what
//! blocks `lines()` is that a `Stream` reports failure IN its item while
//! `read_line` THROWS, and a `ctl` handler can neither be installed across a
//! suspension nor stored in a `ref` struct. So the line primitive is still
//! `read_line` (`.None` on clean EOF), and the fix is a `Reader` that can
//! return its failure — `plans/backlog/ASYNC_LINES_NEEDS_A_NONTHROWING_READ.md`.
//!
//! The fd-based `std/sys/bufio` pair is GONE (2026-08-28): the compiler's own
//! three consumers — `lsp/server`, `lsp/transport`, `check_watch` — read stdin
//! through `BufReader(Stdin)` now, and the module and its test are deleted. That
//! migration waited on a seed carrying #299's shadow-registration fix, because
//! `yo build` compiles `src/` with the SEED and the older one mis-emitted this
//! module's match bindings; v0.2.18 carries it.
//!
//! ## Stability
//!
//! unstable — one thing here is expected to move and one thing is waiting on
//! the language. `read_exact` is a `BufReader` METHOD returning
//! `Option(ArrayList(u8))`, where Rust's is a `Read` trait method: the
//! Rust-shaped end state is a `Reader` default (so a `File` or `TcpStream`
//! gets it unbuffered too), which would leave two spellings of one operation
//! unless this one is removed — a breaking change, so it waits for a window.
//! And `lines()` cannot exist until Yo has an async iterator protocol, which
//! is why `read_line` is the primitive; adding `lines()` later is additive,
//! but it may well change what shape `read_line` wants to be. The
//! no-flush-on-drop rule for `BufWriter` is NOT an open question — it is a
//! deliberate match for tokio's `BufWriter` (a `Drop` cannot await), and
//! it is documented above because callers must act on it.
pragma(Pragma.AllowUnsafe);
{ Reader, Writer } :: import("./index");
{ IoExn } :: import("../error");
{ ArrayList } :: import("../collections/array_list");
{ String } :: import("../string");

/// A `BufReader`'s buffer and cursor, in the reader's `Box`: the methods
/// take `self : &Self` and move the cursor inside the box.
_BufReaderState :: struct(
  _buf : ArrayList(u8),
  _pos : usize,
  _filled : usize,
  _capacity : usize
);
/// Buffered reader over any `Reader`.
///
/// It OWNS its inner reader (`new` moves it in, as Rust's `BufReader::new`
/// does), so a `BufReader(File)` is move-only like the `File`; `get_ref`
/// lends the inner reader back. The buffer lives in a `Box` that the methods
/// write through `&Self`, so a `BufReader` is never `Sync`.
BufReader :: (fn(comptime(R) : Type) -> comptime(Type))(
  struct(
    _inner : R,
    _st : Box(_BufReaderState)
  )
);
impl(generic(R : Type), BufReader(R), !Sync());
/// A `BufWriter`'s pending bytes, in the writer's `Box`.
_BufWriterState :: struct(
  _buf : ArrayList(u8),
  _capacity : usize
);
/// Buffered writer over any `Writer`. It owns its inner writer, as
/// `BufReader` owns its reader; `get_ref` lends it back.
BufWriter :: (fn(comptime(W) : Type) -> comptime(Type))(
  struct(
    _inner : W,
    _st : Box(_BufWriterState)
  )
);
impl(generic(W : Type), BufWriter(W), !Sync());
/// A `capacity`-long zeroed byte buffer (`ArrayList` used as fixed storage).
_zeroed :: (fn(capacity : usize) -> ArrayList(u8))({
  b := ArrayList(u8).with_capacity(capacity);
  (i : usize) = usize(0);
  while(i < capacity, i = (i + usize(1)), {
    b.push(u8(0));
  });
  b
});
impl(
  generic(R : Type),
  where(R <: Reader),
  BufReader(R),
  /// Wrap `inner` (moved in) with the default 4096-byte buffer.
  new : (fn(sink(inner) : R) -> Self)(
    Self.with_capacity(inner, usize(4096))
  ),
  /// Wrap `inner` (moved in) with a `capacity`-byte buffer.
  with_capacity : (fn(sink(inner) : R, capacity : usize) -> Self)(
    Self(_inner : inner, _st : box(_BufReaderState(_buf : _zeroed(capacity), _pos : usize(0), _filled : usize(0), _capacity : capacity)))
  ),
  /// The inner reader, lent.
  get_ref : (fn(self : &Self) -> &R)(&self._inner),
  /// The buffer state, written through `&Self`.
  _state : (fn(self : &Self) -> *_BufReaderState)(addr_of(self._st.*)),
  /// Number of buffered bytes available without touching the inner reader.
  buffered : (fn(self : &Self) -> usize)(
    self._st._filled - self._st._pos
  ),
  /// Refill the internal buffer from the inner reader. Resolves to the
  /// number of bytes now buffered; `0` means the inner reader hit EOF.
  _fill : (fn(self : &Self, io : Io) -> Impl(Future(usize, IoExn)))(
    io.async({ &self, io }(e : IoExn) => {
      st := self._state();
      p := match(self._st._buf.ptr(), .Some(q) => q, .None => (*u8)(""));
      n := e.io.await(self._inner.read(p, self._st._capacity, io), e);
      unsafe(consume(st.*._pos = usize(0)));
      unsafe(consume(st.*._filled = n));
      n
    })
  ),
  /// Read one line (up to and including `\n`; the `\n` is consumed and NOT
  /// included). Resolves to `.None` on clean EOF with no pending bytes.
  /// The bytes are handed back UNVALIDATED via the unchecked constructor —
  /// framing protocols read ASCII headers; validate with `String.from_utf8`
  /// where the content is untrusted.
  read_line : (fn(self : &Self, io : Io) -> Impl(Future(Option(String), IoExn)))(
    io.async({ &self, io }(e : IoExn) => {
      st := self._state();
      line_bytes := ArrayList(u8).new();
      (found_newline : bool) = false;
      (hit_eof : bool) = false;
      while(!found_newline && !hit_eof, {
        cond(
          (self._st._pos < self._st._filled) => {
            scan := self._st._pos;
            while((scan < self._st._filled) && !found_newline, {
              b := self._st._buf(scan);
              cond(
                (b == u8(10)) => {
                  found_newline = true;
                },
                true => {
                  line_bytes.push(b);
                }
              );
              scan = (scan + usize(1));
            });
            unsafe(consume(st.*._pos = scan));
          },
          true => {
            n := e.io.await(Self._fill(self, io), e);
            if(n == usize(0), {
              hit_eof = true;
            });
          }
        );
      });
      at_end := (hit_eof && (line_bytes.len() == usize(0)));
      line := String.from_bytes(line_bytes);
      cond(
        at_end => Option(String).None,
        true => Option(String).Some(line)
      )
    })
  ),
  /// Read EXACTLY `n` bytes, looping over short reads — the operation a
  /// framed protocol needs (`Content-Length: N` then N body bytes).
  /// Resolves to `.None` when EOF arrives first; the partial bytes are
  /// discarded with the broken frame.
  read_exact : (fn(self : &Self, n : usize, io : Io) -> Impl(Future(Option(ArrayList(u8)), IoExn)))(
    io.async({ &self, n, io }(e : IoExn) => {
      st := self._state();
      result := ArrayList(u8).new();
      (hit_eof : bool) = false;
      while((result.len() < n) && !hit_eof, {
        cond(
          (self._st._pos < self._st._filled) => {
            while((result.len() < n) && (self._st._pos < self._st._filled), {
              result.push(self._st._buf(self._st._pos));
              unsafe(consume(st.*._pos = (st.*._pos + usize(1))));
            });
          },
          true => {
            got := e.io.await(Self._fill(self, io), e);
            if(got == usize(0), {
              hit_eof = true;
            });
          }
        );
      });
      cond(
        hit_eof => Option(ArrayList(u8)).None,
        true => Option(ArrayList(u8)).Some(result)
      )
    })
  )
);
impl(
  generic(R : Type),
  where(R <: Reader),
  BufReader(R),
  Reader(
    read : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
      io.async({ &self, buf, size, io }(e : IoExn) => {
        st := self._state();
        (out : usize) = usize(0);
        (done : bool) = false;
        // Serve buffered bytes first.
        available := (self._st._filled - self._st._pos);
        cond(
          (available > usize(0)) => {
            to_copy := cond((available < size) => available, true => size);
            (i : usize) = usize(0);
            while(i < to_copy, i = (i + usize(1)), {
              (buf.add(i)).* = self._st._buf(self._st._pos + i);
            });
            unsafe(consume(st.*._pos = (st.*._pos + to_copy)));
            out = to_copy;
            done = true;
          },
          true => ()
        );
        // Empty buffer + large read: bypass the buffer entirely.
        cond(
          (!done && (size >= self._st._capacity)) => {
            out = e.io.await(self._inner.read(buf, size, io), e);
            done = true;
          },
          true => ()
        );
        // Empty buffer + small read: refill, then serve.
        cond(
          !done => {
            got := e.io.await(Self._fill(self, io), e);
            to_copy := cond((got < size) => got, true => size);
            (j : usize) = usize(0);
            while(j < to_copy, j = (j + usize(1)), {
              (buf.add(j)).* = self._st._buf(j);
            });
            unsafe(consume(st.*._pos = to_copy));
            out = to_copy;
          },
          true => ()
        );
        out
      })
    )
  )
);
impl(
  generic(W : Type),
  where(W <: Writer),
  BufWriter(W),
  /// Wrap `inner` (moved in) with the default 4096-byte buffer.
  new : (fn(sink(inner) : W) -> Self)(
    Self.with_capacity(inner, usize(4096))
  ),
  /// Wrap `inner` (moved in) with a `capacity`-byte buffer.
  with_capacity : (fn(sink(inner) : W, capacity : usize) -> Self)(
    Self(_inner : inner, _st : box(_BufWriterState(_buf : ArrayList(u8).with_capacity(capacity), _capacity : capacity)))
  ),
  /// The inner writer, lent.
  get_ref : (fn(self : &Self) -> &W)(&self._inner),
  /// The pending bytes, written through `&Self`.
  _state : (fn(self : &Self) -> *_BufWriterState)(addr_of(self._st.*)),
  /// Number of bytes currently buffered.
  buffered : (fn(self : &Self) -> usize)(
    self._st._buf.len()
  ),
  /// Buffer a `String`'s bytes. The pointer-taking `write` is the trait's
  /// primitive; this is the form callers actually want, and the fd-based
  /// `std/sys/bufio` writer this module replaced had it — dropping it would
  /// have made "write a string to a buffered writer" a pointer exercise.
  write_string : (fn(self : &Self, s : &String, io : Io) -> Impl(Future(unit, IoExn)))(
    io.async({ &self, &s, io }(e : IoExn) => {
      bytes := &s;
      n := bytes.len();
      cond(
        (n > usize(0)) => {
          p := match(bytes.ptr(), .Some(q) => q, .None => (*u8)(""));
          e.io.await(Self.write_all(self, p, n, io), e);
        },
        true => ()
      );
      ()
    })
  ),
  /// Buffer an `ArrayList(u8)`. Companion to `write_string`, same rationale.
  write_bytes : (fn(self : &Self, data : &ArrayList(u8), io : Io) -> Impl(Future(unit, IoExn)))(
    io.async({ &self, &data, io }(e : IoExn) => {
      n := data.len();
      cond(
        (n > usize(0)) => {
          p := match(data.ptr(), .Some(q) => q, .None => (*u8)(""));
          e.io.await(Self.write_all(self, p, n, io), e);
        },
        true => ()
      );
      ()
    })
  ),
  /// Deliver the buffered bytes to the inner writer (without flushing IT).
  _flush_buf : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
    io.async({ &self, io }(e : IoExn) => {
      st := self._state();
      cond(
        (self._st._buf.len() > usize(0)) => {
          p := match(self._st._buf.ptr(), .Some(q) => q, .None => (*u8)(""));
          e.io.await(self._inner.write_all(p, self._st._buf.len(), io), e);
          unsafe(st.*._buf.clear());
        },
        true => ()
      );
      ()
    })
  )
);
impl(
  generic(W : Type),
  where(W <: Writer),
  BufWriter(W),
  Writer(
    write : (fn(self : &Self, buf : *u8, size : usize, io : Io) -> Impl(Future(usize, IoExn)))(
      io.async({ &self, buf, size, io }(e : IoExn) => {
        st := self._state();
        (src_pos : usize) = usize(0);
        while(src_pos < size, {
          space := (self._st._capacity - self._st._buf.len());
          cond(
            (space == usize(0)) => {
              e.io.await(Self._flush_buf(self, io), e);
            },
            true => {
              remaining := (size - src_pos);
              to_copy := cond((remaining < space) => remaining, true => space);
              (i : usize) = usize(0);
              while(i < to_copy, i = (i + usize(1)), {
                unsafe(st.*._buf.push((buf.add(src_pos + i)).*));
              });
              src_pos = (src_pos + to_copy);
            }
          );
        });
        size
      })
    ),
    flush : (fn(self : &Self, io : Io) -> Impl(Future(unit, IoExn)))(
      io.async({ &self, io }(e : IoExn) => {
        e.io.await(Self._flush_buf(self, io), e);
        e.io.await(self._inner.flush(io), e);
        ()
      })
    )
  )
);
export(BufReader, BufWriter);
