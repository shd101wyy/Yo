// std/io/errors.yo - IOError type
//
// Comprehensive I/O error type with errno-to-error mapping.

{ String } :: import "../string";
{ ToString } :: import "../fmt";
{
  ENOENT, EPERM, EACCES, EEXIST, ENOTDIR, EISDIR, ENOTEMPTY, EPIPE,
  EAGAIN, EWOULDBLOCK, EINVAL, EINTR, EMFILE, ENFILE, EFBIG, ENOSPC,
  EROFS, EXDEV, EMLINK, ENAMETOOLONG, ENOTSUP, EOPNOTSUPP, ETIMEDOUT, EBUSY,
  ECONNREFUSED, ECONNRESET, ECONNABORTED, ENOTCONN, EADDRINUSE, EADDRNOTAVAIL,
  ENETUNREACH, EHOSTUNREACH, ENETDOWN, EISCONN, EBADF, EIO
} :: import "../libc/errno";

// ============================================================================
// IOError - I/O error type
// ============================================================================

IOError :: enum(
  // File system errors
  NotFound,
  PermissionDenied,
  AlreadyExists,
  NotADirectory,
  IsADirectory,
  DirectoryNotEmpty,
  BrokenPipe,
  WouldBlock,
  InvalidInput,
  Interrupted,
  TooManyOpenFiles,
  FileTooLarge,
  NoSpace,
  ReadOnlyFilesystem,
  CrossDeviceLink,
  TooManyLinks,
  NameTooLong,
  NotSupported,
  TimedOut,
  Busy,
  BadFileDescriptor,
  IOError,

  // Network errors
  ConnectionRefused,
  ConnectionReset,
  ConnectionAborted,
  NotConnected,
  AddressInUse,
  AddressNotAvailable,
  NetworkUnreachable,
  HostUnreachable,
  NetworkDown,
  AlreadyConnected,

  // Generic
  Other(code: i32)
);

impl(IOError,
  from_errno : (fn(errno: i32) -> Self)(
    cond(
      (errno == i32(ENOENT)) => .NotFound,
      ((errno == i32(EPERM)) || (errno == i32(EACCES))) => .PermissionDenied,
      (errno == i32(EEXIST)) => .AlreadyExists,
      (errno == i32(ENOTDIR)) => .NotADirectory,
      (errno == i32(EISDIR)) => .IsADirectory,
      (errno == i32(ENOTEMPTY)) => .DirectoryNotEmpty,
      (errno == i32(EPIPE)) => .BrokenPipe,
      ((errno == i32(EAGAIN)) || (errno == i32(EWOULDBLOCK))) => .WouldBlock,
      (errno == i32(EINVAL)) => .InvalidInput,
      (errno == i32(EINTR)) => .Interrupted,
      ((errno == i32(EMFILE)) || (errno == i32(ENFILE))) => .TooManyOpenFiles,
      (errno == i32(EFBIG)) => .FileTooLarge,
      (errno == i32(ENOSPC)) => .NoSpace,
      (errno == i32(EROFS)) => .ReadOnlyFilesystem,
      (errno == i32(EXDEV)) => .CrossDeviceLink,
      (errno == i32(EMLINK)) => .TooManyLinks,
      (errno == i32(ENAMETOOLONG)) => .NameTooLong,
      ((errno == i32(ENOTSUP)) || (errno == i32(EOPNOTSUPP))) => .NotSupported,
      (errno == i32(ETIMEDOUT)) => .TimedOut,
      (errno == i32(EBUSY)) => .Busy,
      (errno == i32(EBADF)) => .BadFileDescriptor,
      (errno == i32(EIO)) => .IOError,
      (errno == i32(ECONNREFUSED)) => .ConnectionRefused,
      (errno == i32(ECONNRESET)) => .ConnectionReset,
      (errno == i32(ECONNABORTED)) => .ConnectionAborted,
      (errno == i32(ENOTCONN)) => .NotConnected,
      (errno == i32(EADDRINUSE)) => .AddressInUse,
      (errno == i32(EADDRNOTAVAIL)) => .AddressNotAvailable,
      (errno == i32(ENETUNREACH)) => .NetworkUnreachable,
      (errno == i32(EHOSTUNREACH)) => .HostUnreachable,
      (errno == i32(ENETDOWN)) => .NetworkDown,
      (errno == i32(EISCONN)) => .AlreadyConnected,
      true => .Other(errno)
    )
  ),

  from_result : (fn(result: i32) -> Result(i32, Self))(
    cond(
      (result >= i32(0)) => .Ok(result),
      true => .Err(Self.from_errno((i32(0) - result)))
    )
  )
);

impl(IOError, ToString(
  to_string : (self -> {
    s := match(self,
      .NotFound => String.from_cstr("file or directory not found").unwrap(),
      .PermissionDenied => String.from_cstr("permission denied").unwrap(),
      .AlreadyExists => String.from_cstr("file or directory already exists").unwrap(),
      .NotADirectory => String.from_cstr("not a directory").unwrap(),
      .IsADirectory => String.from_cstr("is a directory").unwrap(),
      .DirectoryNotEmpty => String.from_cstr("directory not empty").unwrap(),
      .BrokenPipe => String.from_cstr("broken pipe").unwrap(),
      .WouldBlock => String.from_cstr("operation would block").unwrap(),
      .InvalidInput => String.from_cstr("invalid input").unwrap(),
      .Interrupted => String.from_cstr("operation interrupted").unwrap(),
      .TooManyOpenFiles => String.from_cstr("too many open files").unwrap(),
      .FileTooLarge => String.from_cstr("file too large").unwrap(),
      .NoSpace => String.from_cstr("no space left on device").unwrap(),
      .ReadOnlyFilesystem => String.from_cstr("read-only filesystem").unwrap(),
      .CrossDeviceLink => String.from_cstr("cross-device link").unwrap(),
      .TooManyLinks => String.from_cstr("too many links").unwrap(),
      .NameTooLong => String.from_cstr("name too long").unwrap(),
      .NotSupported => String.from_cstr("operation not supported").unwrap(),
      .TimedOut => String.from_cstr("operation timed out").unwrap(),
      .Busy => String.from_cstr("resource busy").unwrap(),
      .BadFileDescriptor => String.from_cstr("bad file descriptor").unwrap(),
      .IOError => String.from_cstr("I/O error").unwrap(),
      .ConnectionRefused => String.from_cstr("connection refused").unwrap(),
      .ConnectionReset => String.from_cstr("connection reset by peer").unwrap(),
      .ConnectionAborted => String.from_cstr("connection aborted").unwrap(),
      .NotConnected => String.from_cstr("socket not connected").unwrap(),
      .AddressInUse => String.from_cstr("address already in use").unwrap(),
      .AddressNotAvailable => String.from_cstr("address not available").unwrap(),
      .NetworkUnreachable => String.from_cstr("network unreachable").unwrap(),
      .HostUnreachable => String.from_cstr("host unreachable").unwrap(),
      .NetworkDown => String.from_cstr("network is down").unwrap(),
      .AlreadyConnected => String.from_cstr("socket already connected").unwrap(),
      .Other(errno) => String.from_cstr("unknown I/O error").unwrap()
    );
    return s;
  })
));

export IOError;
