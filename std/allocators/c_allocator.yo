open import "../modules/allocator.yo";
open import "../macros/if.yo";
open import "../data/primitives";
open import "../libc/stdlib.yo";

CAllocator :: struct(
  CustomAllocator :: (CustomAllocator(
    Self : Self,

    alloc : ((self, T, count) -> {
      // Check for overflow
      if size_would_overflow(T, count), {
        return .Error(.InvalidSize);
      };
      
      size := (count * sizeof(T).as(usize));
      some_ptr := malloc(size);
      match some_ptr,
        .Some(ptr) => {
          // Cast the void pointer to the correct type
          typed_ptr := ptr.cast(*(T));
          .Ok(.Some(typed_ptr))
        },
        .None => .Error(.OutOfMemory)
    }),

    alloc_zeroed : ((self, T, count) -> {
      // Check for overflow
      if size_would_overflow(T, count), {
        return .Error(.InvalidSize);
      };
      
      some_ptr := calloc(count, sizeof(T).as(usize));
      match some_ptr,
        .Some(ptr) => {
          typed_ptr := ptr.cast(*(T));
          .Ok(.Some(typed_ptr))
        },
        .None => .Error(.OutOfMemory)
    }),

    alloc_aligned : ((self, T, count, alignment) -> {
      // Check for overflow
      if size_would_overflow(T, count), {
        return .Error(.InvalidSize);
      };
      
      // Check if alignment is valid (power of 2)
      if (
          (alignment == (0).as(usize)) ||
          ((alignment & (alignment - (1).as(usize))) != (0).as(usize))
      ), {
        return .Error(.InvalidAlignment);
      };
      
      // Check if alignment is at least as large as the type's natural alignment
      natural_alignment := alignof(T);
      if (alignment < natural_alignment), {
        return .Error(.InvalidAlignment);
      };
      
      // For now, fall back to regular malloc (would need aligned_alloc in real implementation)
      size := (count * sizeof(T).as(usize));
      some_ptr := malloc(size);
      match some_ptr,
        .Some(ptr) => {
          typed_ptr := ptr.cast(*(T));
          .Ok(.Some(typed_ptr))
        },
        .None => .Error(.OutOfMemory)
    }),

    realloc : ((forall(T), self, some_old_ptr, new_count) -> {
      // Check for overflow
      if (size_would_overflow(T, new_count)), {
        return .Error(.InvalidSize);
      };
      
      // Handle null pointer case
      match some_old_ptr,
        .None => {
          // Realloc with null pointer behaves like malloc
          size := (new_count * sizeof(T).as(usize));
          some_ptr := malloc(size);
          match some_ptr,
            .Some(ptr) => {
              typed_ptr := ptr.cast(*(T));
              .Ok(.Some(typed_ptr))
            },
            .None => .Error(.OutOfMemory)
        },
        .Some(old_ptr) => {
          raw_old := old_ptr.cast(*(void));

          // Handle zero size case
          if (new_count == (0).as(usize)), {
            free(.Some(raw_old));
            return .Ok(.None);
          };
          
          new_size := (new_count * sizeof(T).as(usize));
          some_new_ptr := realloc(.Some(raw_old), new_size);
          match some_new_ptr,
            .Some(new_ptr) => {
              typed_ptr := new_ptr.cast(*(T));
              .Ok(.Some(typed_ptr))
            },
            .None => .Error(.OutOfMemory)
        }
    }),

    dealloc : ((forall(T), self, ptr) -> {
      raw_ptr := ptr.cast(*(void));
      free(.Some(raw_ptr));
      .Ok(())
    })
  ))
);

export CAllocator;