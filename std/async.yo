// Drive an async task to completion on the current thread.
// This is intended for top-level (sync) code, e.g. `main`.
// The task is awaited to completion; then normal drop runs and frees it.
// block_on :: (fn(task : Impl(Future(unit))) -> unit) {
//   __yo_async_run_until_complete(__yo_as(task, *(void)));
//   return ();
// };

export
  // block_on,
  yield
;