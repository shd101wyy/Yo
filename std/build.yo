// Build System Module
//
// Provides the declarative build API for Yo projects.
// All functions are compile-time only — they register build artifacts
// and steps that the build runner uses to orchestrate compilation.
//
// Usage in build.yo:
//   build :: import "std/build";
//   build.project(name: "my-app", version: "0.1.0");
//   build.executable(build.Executable(name: "my-app", root: "./src/main.yo"));

// ── Optimization levels ──────────────────────────────────────────────

Optimize :: enum(
  Debug,
  ReleaseSafe,
  ReleaseFast,
  ReleaseSmall
);
export Optimize;

// ── Memory allocators ────────────────────────────────────────────────

Allocator :: enum(
  Mimalloc,
  Libc
);
export Allocator;

// ── Sanitizers ───────────────────────────────────────────────────────

Sanitize :: enum(
  None,
  Address,
  Leak
);
export Sanitize;

// ── Target utilities ─────────────────────────────────────────────────

target_host :: __yo_build_target_host();
export target_host;

// ── Config struct types ──────────────────────────────────────────────
// Struct types with defaults, like Zig's options structs.
// Usage: build.executable(build.Executable(name: "app", root: "./src/main.yo"))
// Unspecified fields get their default values.

Executable :: struct(
  name : comptime_string,
  root : comptime_string,
  (target : comptime_string) ?= __yo_build_target_host(),
  (optimize : Optimize) ?= Optimize.Debug,
  (allocator : Allocator) ?= Allocator.Mimalloc,
  (sanitize : Sanitize) ?= Sanitize.None
);
export Executable;

StaticLibrary :: struct(
  name : comptime_string,
  root : comptime_string,
  (target : comptime_string) ?= __yo_build_target_host(),
  (optimize : Optimize) ?= Optimize.Debug
);
export StaticLibrary;

TestSuite :: struct(
  name : comptime_string,
  root : comptime_string,
  (target : comptime_string) ?= __yo_build_target_host()
);
export TestSuite;

// ── Dependency config types ──────────────────────────────────────────

GitDependency :: struct(
  name : comptime_string,
  url : comptime_string,
  (ref : comptime_string) ?= "HEAD",
  (path : comptime_string) ?= ""
);
export GitDependency;

SystemLibrary :: struct(
  name : comptime_string,
  pkg_config : comptime_string,
  (fallback_include : comptime_string) ?= "",
  (fallback_lib : comptime_string) ?= "",
  (fallback_link : comptime_string) ?= ""
);
export SystemLibrary;

// ── Build functions ──────────────────────────────────────────────────
// All return unit. Artifacts and steps are registered by name in
// the global BuildRegistry during compile-time evaluation.

// Register project metadata.
project :: (fn(comptime(name) : comptime_string, comptime(version) : comptime_string) -> unit) {
  __yo_build_project(name, version);
};
export project;

// Register an executable artifact from a config struct.
executable :: (fn(comptime(config) : Executable) -> unit) {
  opt_str :: match(config.optimize,
    .Debug => "debug",
    .ReleaseSafe => "release-safe",
    .ReleaseFast => "release-fast",
    .ReleaseSmall => "release-small"
  );
  alloc_str :: match(config.allocator,
    .Mimalloc => "mimalloc",
    .Libc => "libc"
  );
  san_str :: match(config.sanitize,
    .None => "none",
    .Address => "address",
    .Leak => "leak"
  );
  __yo_build_executable(config.name, config.root, config.target, opt_str, alloc_str, san_str);
};
export executable;

// Register a static library artifact from a config struct.
static_library :: (fn(comptime(config) : StaticLibrary) -> unit) {
  opt_str :: match(config.optimize,
    .Debug => "debug",
    .ReleaseSafe => "release-safe",
    .ReleaseFast => "release-fast",
    .ReleaseSmall => "release-small"
  );
  __yo_build_static_library(config.name, config.root, config.target, opt_str);
};
export static_library;

// Register a test suite from a config struct.
test :: (fn(comptime(config) : TestSuite) -> unit) {
  __yo_build_test(config.name, config.root, config.target);
};
export test;

// Create a run step (compile + execute an artifact by name).
run :: (fn(comptime(artifact_name) : comptime_string) -> unit) {
  __yo_build_run(artifact_name);
};
export run;

// Register a named build step with dependencies (by name).
// Dependencies are names of executables, tests, run steps, or other steps.
step :: (fn(
  comptime(name) : comptime_string,
  comptime(description) : comptime_string,
  (comptime(dep0) : comptime_string) ?= "",
  (comptime(dep1) : comptime_string) ?= "",
  (comptime(dep2) : comptime_string) ?= "",
  (comptime(dep3) : comptime_string) ?= "",
  (comptime(dep4) : comptime_string) ?= "",
  (comptime(dep5) : comptime_string) ?= "",
  (comptime(dep6) : comptime_string) ?= "",
  (comptime(dep7) : comptime_string) ?= ""
) -> unit) {
  __yo_build_step(name, description, dep0, dep1, dep2, dep3, dep4, dep5, dep6, dep7);
};
export step;

// Register a git-hosted dependency.
dependency :: (fn(comptime(config) : GitDependency) -> unit) {
  __yo_build_dependency(config.name, config.url, config.ref, config.path);
};
export dependency;

// Register a system C library discovered via pkg-config.
system_library :: (fn(comptime(config) : SystemLibrary) -> unit) {
  __yo_build_system_library(config.name, config.pkg_config, config.fallback_include, config.fallback_lib, config.fallback_link);
};
export system_library;
