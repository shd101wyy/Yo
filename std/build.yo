//! Declarative build API for Yo projects.
//!
//! All functions are compile-time only — they register build artifacts
//! and steps that the build runner uses to orchestrate compilation.
//!
//! ## Example
//!
//! ```rust
//! build :: import "std/build";
//!
//! mod  :: build.module({ name: "default" });  // a [modules] entry of yo.toml
//! exe  :: build.executable({ name: "my-app", root: "./src/main.yo" });
//! install :: build.step("install", "Build all artifacts");
//! install.depend_on(exe);
//! ```
//!
//! ## Stability
//!
//! unstable — this is the API a project's `build.yo` is written against, so
//! it is the one place where a breaking change costs every downstream project
//! a manual edit, and two things still move. The step model is one:
//! `StepKind` and `Step` expose the runner's DAG vocabulary directly, and the
//! runner's scheduling is still being changed (levels, artifact caching), so
//! a build file that reaches past `Executable`/`TestSuite` into `Step` is
//! reaching at something not yet settled. The other is `CompilationTarget`,
//! which gained the canonical Rust triples in
//! `plans/reference/TARGET_TRIPLES.md` and may still gain fields as targets
//! are added.
//!
//! The declarative face — `Executable`, `StaticLibrary`, `SharedLibrary`,
//! `TestSuite`, `BuildModule`, `target_host`, the `Optimize`/`Allocator`/
//! `Sanitize` enums — is what `yo init` scaffolds and what is expected to
//! keep its names and meanings. Write build files against that.
// ── Optimization levels ──────────────────────────────────────────────
/// Optimization level for compiled artifacts.
Optimize :: enum(
  /// No optimizations, full debug info.
  /// Compiler Flags: `-O0 -g`
  Debug,
  /// Optimized with safety checks.
  /// Compiler Flags: `-O2 -g`
  ReleaseSafe,
  /// Maximum speed optimizations.
  /// Compiler Flags: `-O3`
  ReleaseFast,
  /// Optimize for binary size.
  /// Compiler Flags `-O2`
  ReleaseSmall
);
export(Optimize);
// ── Memory allocators ────────────────────────────────────────────────
/// Memory allocator to use in the compiled artifact.
Allocator :: enum(
  /// High-performance allocator (mimalloc).
  Mimalloc,
  /// The platform's system allocator (macOS malloc zones, Windows CRT heap,
  /// glibc/musl malloc on Linux).
  System,
  /// A general-purpose TLSF allocator over ONE statically-sized region in
  /// `.bss` (`heap_size`, default 16 MiB). No libc heap; running out of that
  /// region is a panic with a diagnostic. The first building block of the
  /// embedded/freestanding story, and on desktop a deterministic OOM oracle
  /// (plans/reference/FIXED_REGION_ALLOCATOR.md).
  Fixed
);
export(Allocator);
// ── Sanitizers ───────────────────────────────────────────────────────
/// Runtime sanitizer to enable.
Sanitize :: enum(
  /// No sanitizer.
  None,
  /// AddressSanitizer — detects memory errors and leaks.
  Address,
  /// LeakSanitizer — detects memory leaks only.
  Leak,
  /// ThreadSanitizer — detects data races in multi-threaded code.
  Thread
);
export(Sanitize);
// ── Step kinds ───────────────────────────────────────────────────────
/// Kind of build step.
StepKind :: enum(
  Executable,
  StaticLibrary,
  SharedLibrary,
  SystemLibrary,
  TestSuite,
  Run,
  Custom,
  Documentation
);
export(StepKind);
// ── Compilation targets ──────────────────────────────────────────────
/// The supported compilation targets, named by their canonical Rust-style
/// triple (`<arch>-<vendor>-<os>[-<env>]`, plus `wasm32-wasip1`) — the same
/// strings `yo compile --target` takes and the release assets are named by.
/// There are no aliases: an unrecognised spelling is rejected with this list.
CompilationTarget :: { X86_64_Unknown_Linux_Gnu : "x86_64-unknown-linux-gnu", X86_64_Unknown_Linux_Musl : "x86_64-unknown-linux-musl", Aarch64_Unknown_Linux_Gnu : "aarch64-unknown-linux-gnu", Aarch64_Unknown_Linux_Musl : "aarch64-unknown-linux-musl", Aarch64_Apple_Darwin : "aarch64-apple-darwin", X86_64_Apple_Darwin : "x86_64-apple-darwin", X86_64_Pc_Windows_Msvc : "x86_64-pc-windows-msvc", Aarch64_Pc_Windows_Msvc : "aarch64-pc-windows-msvc", Wasm32_Unknown_Emscripten : "wasm32-unknown-emscripten", Wasm32_Wasip1 : "wasm32-wasip1" };
export(CompilationTarget);
// ── Target utilities ─────────────────────────────────────────────────
/// Host compilation target string.
target_host :: __yo_build_target_host();
export(target_host);
// ── Config struct types ──────────────────────────────────────────────
/// Configuration for building an executable.
Executable :: struct(
  /// Artifact name.
  name : comptime_str,
  /// Root source file.
  root : comptime_str,
  /// Compilation target triple (defaults to host).
  (target : comptime_str) ?= __yo_build_target_host(),
  /// Optimization level.
  (optimize : Optimize) ?= Optimize.Debug,
  /// Memory allocator.
  (allocator : Allocator) ?= Allocator.System,
  /// Fixed-region heap size in bytes (`allocator : Allocator.Fixed` only;
  /// 64 KiB..4 GiB, rounded down to a 16-byte granule). Ignored by the other
  /// allocators.
  (heap_size : usize) ?= usize(16777216),
  /// Runtime sanitizer.
  (sanitize : Sanitize) ?= Sanitize.None,
  /// Write the single generated C file to this path instead of the default
  /// `<output>.c` sidecar. Empty = default. Redirects rather than duplicates,
  /// so exactly one C file exists and the C compiler consumes it.
  (emit_c_to : comptime_str) ?= "",
  /// Split the emitted C into this many translation units, compiled in
  /// PARALLEL behind a content-addressed object cache and then linked
  /// (plans/reference/CHUNKED_C_EMISSION.md). 0 = off, one C file as before — which is
  /// the default because the single-file emission is what the bootstrap gates
  /// and the portable-C distribution compare. At -O1 and above a chunked
  /// build also gets `-flto=thin`, without which it would lose the
  /// cross-module inlining that a single translation unit gives for free.
  (emit_chunks : comptime_int) ?= 0
);
export(Executable);
/// Configuration for building a static library.
StaticLibrary :: struct(
  /// Artifact name.
  name : comptime_str,
  /// Root source file.
  root : comptime_str,
  /// Compilation target triple (defaults to host).
  (target : comptime_str) ?= __yo_build_target_host(),
  /// Optimization level.
  (optimize : Optimize) ?= Optimize.Debug
);
export(StaticLibrary);
/// Configuration for building a shared/dynamic library.
SharedLibrary :: struct(
  /// Artifact name.
  name : comptime_str,
  /// Root source file.
  root : comptime_str,
  /// Compilation target triple (defaults to host).
  (target : comptime_str) ?= __yo_build_target_host(),
  /// Optimization level.
  (optimize : Optimize) ?= Optimize.Debug
);
export(SharedLibrary);
/// Configuration for a test suite.
TestSuite :: struct(
  /// Suite name.
  name : comptime_str,
  /// Root test file.
  root : comptime_str,
  /// Compilation target triple (defaults to host).
  (target : comptime_str) ?= __yo_build_target_host(),
  /// Comma-separated paths (files or directories, relative to the project
  /// root) excluded from the test walk — a path is excluded if it equals an
  /// entry or lives under one, e.g. "tests/internal,tests/cli-cases".
  (exclude : comptime_str) ?= "",
  /// Print each test as it runs (`yo test --verbose`). `yo build --verbose`
  /// turns it on for every suite regardless.
  (verbose : bool) ?= false,
  /// Stop at the first failing test (`yo test --bail`).
  (bail : bool) ?= false,
  /// Test files to compile at once (`yo test --parallel N`). Forwarded to the
  /// child run, which ACCEPTS it and runs sequentially anyway — `yo test`'s v1
  /// takes the flag for CLI compatibility only (`src/main.yo`). Surfaced so the
  /// build file is not the thing that loses it.
  (parallel : usize) ?= usize(1)
);
export(TestSuite);
// ── Build module type ────────────────────────────────────────────────
/// A named module of this package or of a dependency, as a handle for
/// linking system libraries (`mod.link(sys)`). Which FILE the module is —
/// and what `import("name")` resolves to — is the manifest's business
/// (`yo.toml` `[modules]`, plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.1).
BuildModule :: struct(
  /// Module name (`""` = the dependency's default module).
  name : comptime_str,
  /// The dependency the module belongs to (`""` = this package).
  _dep : comptime_str
);
export(BuildModule);
// ── Step type ────────────────────────────────────────────────────────
/// A build step returned by all registration functions.
/// Use `step.depend_on(dep)` to wire dependencies between steps.
Step :: struct(
  /// Step name.
  name : comptime_str,
  /// Kind of step.
  kind : StepKind
);
export(Step);
// ── Step methods ─────────────────────────────────────────────────────
impl(
  Step,
  /// Add a dependency — `dep` must complete before this step runs.
  depend_on : (fn(comptime(self) : Self, comptime(dep) : Step) -> comptime(unit))({
    __yo_build_step_depend_on(self.name, dep.name, dep.kind);
  }),
  /// Link a library step into this step.
  link : (fn(comptime(self) : Self, comptime(library) : Step) -> comptime(unit))({
    __yo_build_link(self.name, library.name);
  }),
  /// Add extra C compiler flags to this step.
  add_c_flags : (fn(comptime(self) : Self, comptime(flags) : comptime_str) -> comptime(unit))({
    __yo_build_add_cflags(self.name, flags);
  })
);
// ── Build module methods ─────────────────────────────────────────────
impl(
  BuildModule,
  /// Link a system library into this module.
  link : (fn(comptime(self) : Self, comptime(library) : Step) -> comptime(unit))({
    __yo_build_module_link(self.name, library.name);
  })
);
// ── Build option config types ────────────────────────────────────────
// Like Zig's b.option(), declare user-configurable options.
// CLI usage: yo build -Dname=value
/// User-configurable build option (declared in `build.yo`, set via `yo build -Dname=value`).
BuildOption :: struct(
  /// Option name (used with `-D`).
  name : comptime_str,
  /// Human-readable description.
  description : comptime_str,
  /// Default value if not provided.
  (default : comptime_str) ?= ""
);
export(BuildOption);
/// System C library discovered via `pkg-config`.
SystemLibrary :: struct(
  /// Library name (passed to `pkg-config`).
  name : comptime_str,
  /// Fallback include path if pkg-config fails.
  (fallback_include : comptime_str) ?= "",
  /// Fallback library path.
  (fallback_lib : comptime_str) ?= "",
  /// Fallback link flags.
  (fallback_link : comptime_str) ?= "",
  /// Extra C preprocessor defines.
  (defines : comptime_str) ?= ""
);
export(SystemLibrary);
// ── Dependency handle ────────────────────────────────────────────────
// Returned by build.dependency("name") for an entry of yo.toml's
// [dependencies]. Provides access to artifacts defined in the dependency's
// build.yo.
/// Handle to a manifest dependency. Use `.artifact()` or `.module()` to access its exports.
Dependency :: struct(
  name : comptime_str
);
export(Dependency);
impl(
  Dependency,
  /// Access a named artifact from the dependency's `build.yo`.
  /// Returns a `Step` that can be linked to the consumer's artifacts.
  artifact : (fn(comptime(self) : Self, comptime(artifact_name) : comptime_str) -> comptime(Step))({
    __yo_build_dep_artifact(self.name, artifact_name);
    Step(name : artifact_name, kind : StepKind.StaticLibrary)
  }),
  /// Get a module from the dependency's `build.yo`.
  /// Empty `module_name` defaults to the sole module if exactly one exists.
  module : (fn(comptime(self) : Self, (comptime(module_name) : comptime_str) ?= "") -> comptime(BuildModule))({
    _encoded :: __yo_build_dep_module(self.name, module_name);
    BuildModule(name : module_name, _dep : self.name)
  })
);
// ── Build functions ──────────────────────────────────────────────────
// All registration functions return a Step value, allowing steps to be
// wired together as dependencies via step.depend_on(dep).
/// Register an executable artifact. Returns a `Step` for dependency wiring.
executable :: (fn(comptime(config) : Executable) -> comptime(Step))({
  opt_str :: match(
    config.optimize,
    .Debug => "debug",
    .ReleaseSafe => "release-safe",
    .ReleaseFast => "release-fast",
    .ReleaseSmall => "release-small"
  );
  // This string is handed to whichever compiler binary runs the build. It
  // spelled itself "libc" through the migration window, because seeds v0.2.9
  // and older rejected "system" ("invalid --allocator"). SEED_VERSION reached
  // v0.2.11 in #169 and v0.2.11 accepts "system", so the window is closed and
  // the alias is gone. A pre-v0.2.10 `yo` can no longer build this tree — that
  // is the intended consequence, and CI already requires v0.2.11.
  alloc_str :: match(
    config.allocator,
    .Mimalloc => "mimalloc",
    .System => "system",
    .Fixed => "fixed"
  );
  san_str :: match(
    config.sanitize,
    .None => "none",
    .Address => "address",
    .Leak => "leak",
    .Thread => "thread"
  );
  __yo_build_executable(config.name, config.root, config.target, opt_str, alloc_str, san_str, config.emit_c_to, config.emit_chunks, config.heap_size);
  Step(name : config.name, kind : StepKind.Executable)
});
export(executable);
/// Register a static library artifact. Returns a `Step` for dependency wiring.
static_library :: (fn(comptime(config) : StaticLibrary) -> comptime(Step))({
  opt_str :: match(
    config.optimize,
    .Debug => "debug",
    .ReleaseSafe => "release-safe",
    .ReleaseFast => "release-fast",
    .ReleaseSmall => "release-small"
  );
  __yo_build_static_library(config.name, config.root, config.target, opt_str);
  Step(name : config.name, kind : StepKind.StaticLibrary)
});
export(static_library);
/// Register a shared/dynamic library artifact. Returns a `Step` for dependency wiring.
shared_library :: (fn(comptime(config) : SharedLibrary) -> comptime(Step))({
  opt_str :: match(
    config.optimize,
    .Debug => "debug",
    .ReleaseSafe => "release-safe",
    .ReleaseFast => "release-fast",
    .ReleaseSmall => "release-small"
  );
  __yo_build_shared_library(config.name, config.root, config.target, opt_str);
  Step(name : config.name, kind : StepKind.SharedLibrary)
});
export(shared_library);
/// Register a test-suite artifact. Returns a `Step` for dependency wiring.
test :: (fn(comptime(config) : TestSuite) -> comptime(Step))({
  __yo_build_test(config.name, config.root, config.target, config.exclude, config.verbose, config.bail, config.parallel);
  Step(name : config.name, kind : StepKind.TestSuite)
});
export(test);
/// Create a run step (compile + execute an artifact). Returns a `Step`.
run :: (fn(comptime(artifact) : Step) -> comptime(Step))({
  __yo_build_run(artifact.name);
  Step(name : artifact.name, kind : StepKind.Run)
});
export(run);
/// Register a named build step. Use `step.depend_on(dep)` to add dependencies.
step :: (
  fn(
    comptime(name) : comptime_str,
    comptime(description) : comptime_str
  ) -> comptime(Step)
)({
  __yo_build_step(name, description);
  Step(name : name, kind : StepKind.Custom)
});
export(step);
/// The handle of a dependency declared in `yo.toml`'s `[dependencies]` (or
/// `[dev-dependencies]`) — Zig's `b.dependency(name, .{})`. Where the
/// dependency comes from (git, version, path) is the manifest's; the build
/// file only names it. The runner rejects a name the manifest lacks.
dependency :: (fn(comptime(name) : comptime_str) -> comptime(Dependency))({
  __yo_build_dependency(name);
  Dependency(name : name)
});
export(dependency);
/// Register a system C library discovered via `pkg-config`. Returns a `Step` for linking.
system_library :: (fn(comptime(config) : SystemLibrary) -> comptime(Step))({
  __yo_build_system_library(config.name, config.fallback_include, config.fallback_lib, config.fallback_link, config.defines);
  Step(name : config.name, kind : StepKind.SystemLibrary)
});
export(system_library);
/// Module configuration. The module's root file is declared in `yo.toml`'s
/// `[modules]` table (`default = "src/lib.yo"`, `board = "src/board.yo"`);
/// `build.module` names one of those to attach system libraries to it.
ModuleConfig :: struct(
  /// Module name (`"default"` for the package's root module).
  name : comptime_str
);
export(ModuleConfig);
/// Name a module of this package (see `yo.toml` `[modules]`). Returns a
/// `BuildModule` for linking system libraries.
_module :: (fn(comptime(config) : ModuleConfig) -> comptime(BuildModule))({
  __yo_build_module(config.name);
  BuildModule(name : config.name, _dep : "")
});
export(module : _module);
/// Declare a user-configurable build option.
/// Returns the option value (from CLI `-Dname=value`, or the default).
///
/// ## Example
/// ```rust
/// strip :: build.option({
///   name: "strip",
///   description: "Strip debug symbols",
///   default: "false"
/// });
/// ```
option :: (fn(comptime(config) : BuildOption) -> comptime(str))(
  __yo_build_option(config.name, config.description, config.default)
);
export(option);
// ── Documentation generation ─────────────────────────────────────────
/// Output format for documentation generation.
DocFormat :: enum(
  Html,
  Markdown,
  Json
);
export(DocFormat);
/// Configuration for documentation generation.
DocConfig :: struct(
  /// Step name (e.g., "doc").
  name : comptime_str,
  /// Root source file or directory to document.
  root : comptime_str,
  /// Output directory (default: "yo-out/doc").
  (output : comptime_str) ?= "yo-out/doc",
  /// Output format (default: Html).
  (format : DocFormat) ?= DocFormat.Html,
  /// Document non-exported (private) items.
  (include_private : bool) ?= false,
  /// Custom site title (default: project name).
  (title : comptime_str) ?= "",
  /// Release version to display (e.g., "v1.0.0").
  /// When empty, auto-detects from git tag or commit hash.
  (version : comptime_str) ?= "",
  /// Path to logo image.
  (logo : comptime_str) ?= "",
  /// Path to favicon.
  (favicon : comptime_str) ?= ""
);
export(DocConfig);
/// Register a documentation generation step. Returns a Step for dependency wiring.
///
/// ## Examples
///
/// ```rust
/// build :: import "std/build";
///
/// // Minimal — just works with defaults
/// doc_step :: build.doc({ name: "doc", root: "./src/lib.yo" });
///
/// // Full customization
/// doc_step :: build.doc({
///   name: "doc",
///   root: "./src",
///   output: "docs/api",
///   format: DocFormat.Markdown,
///   title: "My Library API",
///   version: "v1.0.0"
/// });
///
/// install :: build.step("install", "Build all artifacts");
/// install.depend_on(doc_step);
/// ```
doc :: (fn(comptime(config) : DocConfig) -> comptime(Step))({
  fmt_str :: match(
    config.format,
    .Html => "html",
    .Markdown => "markdown",
    .Json => "json"
  );
  __yo_build_doc(
    config.name,
    config.root,
    config.output,
    fmt_str,
    config.include_private,
    // Slot kept, value fixed: `include_deps` promised documentation of the
    // dependency closure and nothing ever read it (the plan's B13). The
    // argument stays so an older SEED, whose builtin requires ten arguments,
    // still evaluates this file.
    false,
    config.title,
    config.logo,
    config.favicon,
    config.version
  );
  Step(name : config.name, kind : StepKind.Documentation)
});
export(doc);
