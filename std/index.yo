/**
 * This file contains the prelude for the Yo language.
 * References:
 * - Haskell: https://hackage.haskell.org/package/base-4.19.0.0/docs/index.html
 * - Rust: https://doc.rust-lang.org/std/index.html
 */

// builtins
_builtins :: import "./builtins.yo";

// modules
_arithmetic :: import "./modules/arithmetic.yo";
_logic :: import "./modules/logic.yo";
_common :: import "./modules/common.yo";
_eq :: import "./modules/eq.yo";
_ord :: import "./modules/ord.yo";
_closure :: import "./modules/closure.yo";

// data
/// primitive
_boolean :: import "./data/primitives/boolean.yo";
_f32 :: import "./data/primitives/f32.yo";
_f64 :: import "./data/primitives/f64.yo";
_i8  ::  import "./data/primitives/i8.yo";
_i16 :: import "./data/primitives/i16.yo";
_i32 :: import "./data/primitives/i32.yo";
_i64 :: import "./data/primitives/i64.yo";
_isize :: import "./data/primitives/isize.yo";
_u8  ::  import "./data/primitives/u8.yo";
_u16 :: import "./data/primitives/u16.yo";
_u32 :: import "./data/primitives/u32.yo";
_u64 :: import "./data/primitives/u64.yo";
_usize :: import "./data/primitives/usize.yo";

/// compt types
_type :: import "./data/primitives/type.yo";
_compt_int :: import "./data/primitives/compt_int.yo";
_compt_float :: import "./data/primitives/compt_float.yo";
_compt_string :: import "./data/primitives/compt_string.yo";
_expr :: import "./data/primitives/expr.yo";
_expr_list :: import "./data/primitives/expr_list.yo";

/// C compatible types
_char :: import "./data/primitives/char.yo";
_short :: import "./data/primitives/short.yo";
_ushort :: import "./data/primitives/ushort.yo";
_int :: import "./data/primitives/int.yo";
_uint :: import "./data/primitives/uint.yo";
_long :: import "./data/primitives/long.yo";
_ulong :: import "./data/primitives/ulong.yo";
_longlong :: import "./data/primitives/longlong.yo";
_ulonglong :: import "./data/primitives/ulonglong.yo";
_longdouble ::  import "./data/primitives/longdouble.yo";

/// pointer and reference
_ptr :: import "./data/primitives/ptr.yo";

/// other data types
_option :: import "./data/option.yo";
_maybe_uninit :: import "./data/maybe_uninit.yo";
_result :: import "./data/result.yo";

// macros
_if :: import "./macros/if.yo";
_do :: import "./macros/do.yo";
_try :: import "./macros/try.yo";

export
  // builtins
  ...(_builtins),

  // modules
  ...(_arithmetic),
  ...(_logic),
  ...(_common),
  ...(_eq),
  ...(_ord),
  ...(_closure),

  // data
  /// compt types
  ...(_type),
  ...(_compt_int),
  ...(_compt_float),
  ...(_compt_string),
  ...(_expr),
  ...(_expr_list),

  /// primitive types
  ...(_boolean),
  ...(_f32),
  ...(_f64),
  ...(_i8),
  ...(_i16),
  ...(_i32),
  ...(_i64),
  ...(_isize),
  ...(_u8),
  ...(_u16),
  ...(_u32),
  ...(_u64),
  ...(_usize),

  /// C compatible types
  ...(_char),
  ...(_short),
  ...(_ushort),
  ...(_int),
  ...(_uint),
  ...(_long),
  ...(_ulong),
  ...(_longlong),
  ...(_ulonglong),
  ...(_longdouble),

  /// pointer and reference
  ...(_ptr),

  /// other data types
  ...(_option),
  ...(_maybe_uninit),
  ...(_result),

  // macros
  ...(_if),
  ...(_do),
  ...(_try)
;