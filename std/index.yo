/**
 * This file contains the prelude for the Yo language.
 * References:
 * - Haskell: https://hackage.haskell.org/package/base-4.19.0.0/docs/index.html
 * - Rust: https://doc.rust-lang.org/std/index.html
 */

// builtins
_builtins :: import "./builtins.yo";

// interface
_arithmetic :: import "./modules/arithmetic.yo";
_logic :: import "./modules/logic.yo";
_common :: import "./modules/common.yo";
_eq :: import "./modules/eq.yo";
_ord :: import "./modules/ord.yo";
_closure :: import "./modules/closure.yo";

// data
_option :: import "./data/option.yo";
_boolean :: import "./data/primitive/boolean.yo";
_type :: import "./data/primitive/type.yo";
_compt_int :: import "./data/primitive/compt_int.yo";
_compt_float :: import "./data/primitive/compt_float.yo";
_compt_boolean :: import "./data/primitive/compt_boolean.yo";
_compt_string :: import "./data/primitive/compt_string.yo";
_expr :: import "./data/primitive/expr.yo";
_expr_list :: import "./data/primitive/expr_list.yo";
_f32 :: import "./data/primitive/f32.yo";
_f64 :: import "./data/primitive/f64.yo";
_i8  ::  import "./data/primitive/i8.yo";
_i16 :: import "./data/primitive/i16.yo";
_i32 :: import "./data/primitive/i32.yo";
_i64 :: import "./data/primitive/i64.yo";
_isize :: import "./data/primitive/isize.yo";
_u8  ::  import "./data/primitive/u8.yo";
_u16 :: import "./data/primitive/u16.yo";
_u32 :: import "./data/primitive/u32.yo";
_u64 :: import "./data/primitive/u64.yo";
_usize :: import "./data/primitive/usize.yo";

export
  ...(_builtins),

  ...(_arithmetic),
  ...(_logic),
  ...(_common),
  ...(_eq),
  ...(_ord),
  ...(_closure),

  ...(_option),
  ...(_boolean),
  ...(_type),
  ...(_compt_int),
  ...(_compt_float),
  ...(_compt_boolean),
  ...(_compt_string),
  ...(_expr),
  ...(_expr_list),

  ...(_f32),
  ...(_f64),
  ...(_i8),
  ...(_i16),
  ...(_i32),
  ...(_i64),
  ...(_isize),
  ...(_u8),
  ...(_u16),
  ...(_u32),
  ...(_u64),
  ...(_usize)
;