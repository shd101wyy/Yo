//! A bump arena: an explicit `Allocator` over one region.
//!
//! ```rust
//! { Arena } :: import("std/arena");
//! arena := Arena.new(usize(1024) * usize(1024));
//! a := arena.allocator();
//! // … hand `a` to anything that takes an Allocator …
//! arena.deinit();   // PANICS if a block is still live
//! ```
//!
//! Placement, not lifetime: under reference counting every block still dies
//! when its last reference goes away, and its release is routed back here by
//! the owner prefix (`std/allocator.yo`). What the arena adds is where the
//! bytes live — one contiguous region — and a checked end: `deinit` (and the
//! arena handle's own dispose) panics while any block is live, so "the arena
//! died under a live block" is a loud, defined failure instead of the
//! use-after-free it is in Zig. A process-lifetime arena calls `abandon()`
//! instead: tracking stops and the region is never released.
//!
//! Freeing a block reclaims its bytes only when it is the most recent
//! allocation; everything else is reclaimed by `deinit`. `realloc` grows the
//! most recent block in place when the region has room.
//!
//! Thread-safe: every operation takes the arena's spinlock, so blocks may be
//! freed on any thread.
//!
//! Under `--debug-heap` the exit report lists every arena still live (never
//! deinit) or abandoned at exit, with its live blocks and bytes in use.
//!
//! ## Stability
//!
//! stable — `new`, `allocator`, `scoped`, `deinit`, `abandon`, `live_blocks`,
//! `used_bytes`, `capacity` and `is_released`, frozen with the `Allocator`
//! vtable (`plans/archive/EXPLICIT_ALLOCATORS.md`).
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator, with_allocator } :: import("./allocator");
{ panic } :: import("./assert");
{ eprintln } :: import("./fmt");
{ atexit } :: import("./libc/stdlib");
{ memcpy } :: import("./libc/string");
{
  atomic_bool,
  atomic_init,
  atomic_exchange_explicit,
  atomic_store_explicit,
  memory_order_acquire,
  memory_order_release
} :: import("./libc/stdatomic");
{ __YO_THREAD_SYNC_TYPE } :: import("./sync/mutex");
extern(
  "Yo",
  __yo_mutex_create : (fn() -> __YO_THREAD_SYNC_TYPE),
  __yo_mutex_lock : (fn(mutex : *__YO_THREAD_SYNC_TYPE) -> unit),
  __yo_mutex_unlock : (fn(mutex : *__YO_THREAD_SYNC_TYPE) -> unit),
  __yo_debug_heap_on : (fn() -> bool)
);
// Every block starts on a 16-byte boundary of the region.
_ALIGN :: usize(16);
// The arena's state lives in a plain block, not in the `Arena` object, so an
// `Allocator` value can point at it. A state is never released: a dead
// arena's state goes back to `_pool` (below), because a stale `Allocator` copy
// may still reach it — and on a pooled state `dead` makes that a panic
// instead of a use-after-free.
_ArenaState :: struct(
  lock : atomic_bool,
  region : ?*u8,
  capacity : usize,
  top : usize,
  // Offset of the most recent block, while it is still reclaimable.
  last : Option(usize),
  live : usize,
  dead : bool,
  abandoned : bool,
  next : ?*void
);
// Dead states, reused by the next `Arena.new`. Reachable from a global, so
// they are never reported as leaks; bounded by the peak number of arenas alive
// at once.
_pool_mutex := __yo_mutex_create();
_pool := Option(*void).None;
// Abandoned states (and, through them, their regions): kept reachable on
// purpose, since an abandoned arena lives as long as the process.
_abandoned := Option(*void).None;
// Under `--debug-heap` only: arenas neither deinit nor abandoned, for the exit
// report. Off otherwise, so a leaked arena stays unreachable and LSan still
// reports its region.
_live := Option(*void).None;
_reporter_installed := false;
_round_up :: (fn(n : usize) -> usize)((((n + _ALIGN) - usize(1)) / _ALIGN) * _ALIGN);
_st :: (fn(ctx : ?*void) -> *_ArenaState)((*_ArenaState)(ctx.unwrap()));
_lock :: (fn(st : *_ArenaState) -> unit)({
  // SAFETY: `st` is a live arena state (states are never released).
  while(runtime(unsafe(atomic_exchange_explicit(&(st.*.lock), true, memory_order_acquire)) == true), {
    ();
  });
});
_unlock :: (fn(st : *_ArenaState) -> unit)(
  // SAFETY: as `_lock`.
  unsafe(atomic_store_explicit(&(st.*.lock), false, memory_order_release))
);
// Bump `size` bytes off the region. Caller holds the lock.
_bump :: (fn(st : *_ArenaState, size : usize) -> ?*void)({
  // SAFETY: the caller holds the lock on the live state `st`.
  s := unsafe(st.*);
  need := _round_up(size);
  cond(
    s.dead => panic("Arena: allocation from an arena after deinit"),
    ((need < size) || (need > (s.capacity - s.top))) => .None,
    true => {
      at := s.top;
      unsafe(st.*.top = (at + need));
      unsafe(st.*.last = .Some(at));
      unsafe(st.*.live = (s.live + usize(1)));
      .Some((*void)(unsafe(s.region.unwrap().add(at))))
    }
  )
});
_arena_alloc :: (fn(ctx : ?*void, size : usize) -> ?*void)({
  st := _st(ctx);
  _lock(st);
  r := _bump(st, size);
  _unlock(st);
  r
});
_arena_free :: (fn(ctx : ?*void, ptr : ?*void) -> unit)(
  match(
    ptr,
    .Some(p) => {
      st := _st(ctx);
      _lock(st);
      // SAFETY: the lock is held on the live state `st`; `p` is one of its
      // blocks, so it lies inside the region.
      s := unsafe(st.*);
      off := usize(unsafe((*u8)(p).offset_from(s.region.unwrap())));
      cond(
        (s.last == Option(usize).Some(off)) => {
          unsafe(st.*.top = off);
          unsafe(st.*.last = .None);
        },
        true => ()
      );
      unsafe(st.*.live = (s.live - usize(1)));
      _unlock(st);
    },
    .None => ()
  )
);
_arena_realloc :: (fn(ctx : ?*void, ptr : ?*void, new_size : usize) -> ?*void)(
  match(
    ptr,
    .None => _arena_alloc(ctx, new_size),
    .Some(p) => {
      st := _st(ctx);
      _lock(st);
      // SAFETY: as `_arena_free`.
      s := unsafe(st.*);
      off := usize(unsafe((*u8)(p).offset_from(s.region.unwrap())));
      need := _round_up(new_size);
      (r : ?*void) = cond(
        s.dead => panic("Arena: reallocation in an arena after deinit"),
        (need < new_size) => .None,
        // The most recent block grows (or shrinks) in place.
        ((s.last == Option(usize).Some(off)) && (need <= (s.capacity - off))) => {
          unsafe(st.*.top = (off + need));
          .Some(p)
        },
        true => match(
          _bump(st, new_size),
          .Some(q) => {
            // The old block's size is not recorded; its bytes end at or
            // before `top`, so copying up to there stays inside the region.
            avail := (s.top - off);
            n := cond((new_size < avail) => new_size, true => avail);
            unsafe(memcpy(q, p, n));
            // One block replaced by one: `_bump` counted the new one.
            unsafe(st.*.live = (st.*.live - usize(1)));
            .Some(q)
          },
          .None => .None
        )
      );
      _unlock(st);
      r
    }
  )
);
_ARENA_VTABLE := AllocatorVTable(
  alloc : _arena_alloc,
  realloc : _arena_realloc,
  free : _arena_free
);
// A fresh or recycled state, reset for a region of `capacity` bytes.
_take_state :: (fn() -> *_ArenaState)({
  unsafe(__yo_mutex_lock(&_pool_mutex));
  reused := _pool;
  match(
    reused,
    // SAFETY: pooled states are live blocks owned by the pool.
    .Some(p) => {
      _pool = unsafe((*_ArenaState)(p).*.next);
    },
    .None => ()
  );
  unsafe(__yo_mutex_unlock(&_pool_mutex));
  match(
    reused,
    .Some(p) => (*_ArenaState)(p),
    .None => match(
      GlobalAllocator.malloc(size_of(_ArenaState)),
      .Some(p) => (*_ArenaState)(p),
      .None => panic("Arena.new: out of memory")
    )
  )
});
_give_state :: (fn(st : *_ArenaState) -> unit)({
  unsafe(__yo_mutex_lock(&_pool_mutex));
  unsafe(st.*.next = _pool);
  _pool = .Some((*void)(st));
  unsafe(__yo_mutex_unlock(&_pool_mutex));
});
// `st` leaves the `--debug-heap` live list. Caller holds `_pool_mutex`.
_unlink_live :: (fn(st : *_ArenaState) -> unit)({
  target := Option(*void).Some((*void)(st));
  (prev : Option(*_ArenaState)) = .None;
  (cur : Option(*void)) = _live;
  while(runtime(cur.is_some() && (cur != target)), {
    // SAFETY: states on the live list are never released.
    p := (*_ArenaState)(cur.unwrap());
    prev = .Some(p);
    cur = unsafe(p.*.next);
  });
  cond(
    cur.is_none() => (),
    true => {
      after := unsafe(st.*.next);
      match(
        prev,
        .Some(p) => {
          unsafe(p.*.next = after);
        },
        .None => {
          _live = after;
        }
      );
    }
  );
});
_report_list :: (fn(head : Option(*void), what : str) -> unit)({
  (cur : Option(*void)) = head;
  while(runtime(cur.is_some()), {
    st := (*_ArenaState)(cur.unwrap());
    _lock(st);
    // SAFETY: states on the lists are never released.
    s := unsafe(st.*);
    _unlock(st);
    eprintln(`arena (${what}): live at exit: ${s.live} block(s), ${s.top} of ${s.capacity} bytes in use`);
    cur = s.next;
  });
});
// The `--debug-heap` exit reporter, installed by the first `Arena.new`.
_report_arenas :: (fn() -> unit)({
  unsafe(__yo_mutex_lock(&_pool_mutex));
  _report_list(_live, "never deinit");
  _report_list(_abandoned, "abandoned");
  unsafe(__yo_mutex_unlock(&_pool_mutex));
});
_track :: (fn(st : *_ArenaState) -> unit)({
  unsafe(__yo_mutex_lock(&_pool_mutex));
  unsafe(st.*.next = _live);
  _live = .Some((*void)(st));
  install := !_reporter_installed;
  _reporter_installed = true;
  unsafe(__yo_mutex_unlock(&_pool_mutex));
  cond(
    install => {
      unsafe(atexit(_report_arenas));
    },
    true => ()
  );
});
/// A bump arena over one region. See the module notes.
Arena :: ref(struct(_state : *_ArenaState));
impl(
  Arena,
  /// An arena over a region of `capacity` bytes (rounded up to 16). Panics
  /// when the region cannot be allocated.
  new : (fn(capacity : usize) -> Self)({
    cap := _round_up(cond((capacity == usize(0)) => _ALIGN, true => capacity));
    region := match(
      GlobalAllocator.aligned_alloc(_ALIGN, cap),
      .Some(r) => (*u8)(r),
      .None => panic("Arena.new: out of memory")
    );
    st := _take_state();
    // SAFETY: `st` is a state block nobody else holds; every field is
    // written before the arena is visible to anyone.
    unsafe(atomic_init(&(st.*.lock), false));
    unsafe(st.*.region = .Some(region));
    unsafe(st.*.capacity = cap);
    unsafe(st.*.top = usize(0));
    unsafe(st.*.last = .None);
    unsafe(st.*.live = usize(0));
    unsafe(st.*.dead = false);
    unsafe(st.*.abandoned = false);
    unsafe(st.*.next = .None);
    cond(
      unsafe(__yo_debug_heap_on()) => _track(st),
      true => ()
    );
    Self(_state : st)
  }),
  /// This arena as an `Allocator` value. Every block it hands out is released
  /// back here, wherever and whenever its last reference dies.
  allocator : (fn(self : Self) -> Allocator)(
    Allocator(ctx : .Some((*void)(self._state)), vtable : &_ARENA_VTABLE)
  ),
  /// `with_allocator(self.allocator(), f)`: evaluate `f()` with this arena as
  /// the current allocator.
  scoped : (fn(generic(T : Type), self : Self, f : Impl(Fn() -> T)) -> T)(
    with_allocator(self.allocator(), f)
  ),
  /// Blocks allocated here and not yet freed.
  live_blocks : (fn(self : Self) -> usize)({
    _lock(self._state);
    n := unsafe(self._state.*.live);
    _unlock(self._state);
    n
  }),
  /// Bytes of the region in use (the bump offset).
  used_bytes : (fn(self : Self) -> usize)({
    _lock(self._state);
    n := unsafe(self._state.*.top);
    _unlock(self._state);
    n
  }),
  /// The region's size in bytes.
  capacity : (fn(self : Self) -> usize)(unsafe(self._state.*.capacity)),
  /// Whether `deinit` or `abandon` has run.
  is_released : (fn(self : Self) -> bool)({
    _lock(self._state);
    s := unsafe(self._state.*);
    _unlock(self._state);
    s.dead || s.abandoned
  }),
  /// Release the region. PANICS if any block is still live. A second call, or
  /// a call after `abandon`, is a no-op. Also runs when the last `Arena`
  /// handle dies.
  deinit : (fn(self : Self) -> unit)({
    st := self._state;
    _lock(st);
    s := unsafe(st.*);
    cond(
      (s.dead || s.abandoned) => _unlock(st),
      (s.live > usize(0)) => {
        _unlock(st);
        panic(`Arena.deinit: ${s.live} block(s) still live (${s.top} of ${s.capacity} bytes in use)`);
      },
      true => {
        unsafe(st.*.dead = true);
        unsafe(st.*.region = .None);
        _unlock(st);
        GlobalAllocator.aligned_free(.Some((*void)(s.region.unwrap())));
        cond(
          unsafe(__yo_debug_heap_on()) => {
            unsafe(__yo_mutex_lock(&_pool_mutex));
            _unlink_live(st);
            unsafe(__yo_mutex_unlock(&_pool_mutex));
          },
          true => ()
        );
        _give_state(st);
      }
    );
  }),
  /// Stop tracking and never release the region: for an arena that lives as
  /// long as the process (startup tables, interners). Blocks may still be
  /// freed into it; `deinit` becomes a no-op.
  abandon : (fn(self : Self) -> unit)({
    st := self._state;
    _lock(st);
    s := unsafe(st.*);
    cond(
      (s.dead || s.abandoned) => _unlock(st),
      true => {
        unsafe(st.*.abandoned = true);
        _unlock(st);
        unsafe(__yo_mutex_lock(&_pool_mutex));
        cond(
          unsafe(__yo_debug_heap_on()) => _unlink_live(st),
          true => ()
        );
        unsafe(st.*.next = _abandoned);
        _abandoned = .Some((*void)(st));
        unsafe(__yo_mutex_unlock(&_pool_mutex));
      }
    );
  })
);
impl(
  Arena,
  Dispose(
    dispose : (fn(self : Self) -> unit)(self.deinit())
  )
);
export(Arena);
