/**
 * ArrayList - A dynamic array implementation for Yo language
 * 
 * Similar to Rust's Vec<T> and Zig's ArrayList, this ArrayList provides:
 * - Dynamic resizing
 * - ~~Memory management via custom allocator~~
 * - Type safety
 * - RAII for automatic cleanup
 */
{ GlobalAllocator, AllocError } :: import "../../modules/allocator.yo";
open import "../option.yo";
open import "../result.yo";
open import "../primitives";

{ malloc, calloc, realloc, free, aligned_alloc } :: GlobalAllocator;

/**
 * ArrayList error types
 */
ArrayListError :: enum(
  AllocError(error : AllocError),
  IndexOutOfBounds(index: usize, len: usize),
  EmptyList
);

/**
 * ArrayList type - a growable array
 * 
 * Memory layout:
 * - ptr: pointer to the heap-allocated buffer
 * - len: current number of elements
 * - capacity: total capacity of the buffer
 */
ArrayList :: (fn(compt(T): Type) -> compt(Type))
  object(
    ptr : ?*(T),
    len : usize,
    capacity : usize,

    /**
     * Create a new empty ArrayList
     */
    new :: ((fn() -> Self)
      Self(
        ptr: .None,
        len: (0).as(usize),
        capacity: (0).as(usize)
      )),

    /**
     * Create an ArrayList with a specific initial capacity
     */
    with_capacity :: ((fn(capacity: usize) -> Self)
      cond 
        (capacity == (0).as(usize)) => 
          Self.new(),
        true => {
          ptr_result := malloc(sizeof(T) * capacity);
          match(ptr_result,
            .Some(ptr) =>
              Self(
                ptr: .Some(ptr.cast(*(T))),
                len: (0).as(usize),
                capacity: capacity
              ),
            .None => panic("malloc returned None")
          )
        }
    ),

    /**
     * Add an element to the end of the ArrayList
     */
    push :: ((fn(self: *(Self), value: T) -> Result(unit, ArrayListError))
      // Check if we need to grow
      cond
        (self.len >= self.capacity) => {
          // Need to grow - calculate new capacity
          new_capacity := cond
            (self.capacity == (0).as(usize)) => (4).as(usize),
            true => (self.capacity * (2).as(usize));
          
          // Allocate or reallocate
          some_ptr := self.ptr;
          new_some_ptr := match some_ptr,
            .None => GlobalAllocator.malloc(sizeof(T) * new_capacity),
            .Some(ptr) => GlobalAllocator.realloc(some_ptr, new_capacity);
          
          match(new_some_ptr,
            .Some(ptr) => {
              self.ptr = .Some(ptr.cast(*(T)));
              self.capacity = new_capacity;
              // Now add the element
              // TODO: Implement pointer arithmetic and dereferencing
              self.len = (self.len + (1).as(usize));
              .Ok(())
            },
            .None => .Error(.AllocError(.OutOfMemory))
          )
        },
        true => {
          // Have capacity - just add the element
          self.len = (self.len + (1).as(usize));
          .Ok(())
        }
    ),

    /**
     * Remove and return the last element
     */
    pop :: ((fn(self: *(Self)) -> Option(T))
      cond
        (self.len == (0).as(usize)) => .None,
        true => {
          self.len = (self.len - (1).as(usize));
          some_ptr := self.ptr;
          match(some_ptr,
            .None => .None,
            .Some(ptr) => {
              last_element := ptr.cast(*(T)).unchecked_deref();
              .Some(last_element)
            }
          )
        }
    ),

    /**
     * Get an element by index (bounds checked)
     */
    /*
    get :: ((fn(self: *(Self), index: usize) -> Result(Option(&(T)), ArrayListError))
      cond
        (index >= self.len) => .Error(.IndexOutOfBounds(index: index, len: self.len)),
        true =>
          match self.ptr,
            .None => .Ok(.None),
            .Some =>
              // TODO: Implement pointer arithmetic
              .Ok(.Some(/* &(ptr + index) */))
            
    ),
    */

    _free_elements :: ((fn(self : Self) -> unit)
      cond(
        T.contains_arc_type() => {
          i := (0).as(usize);
          ptr := self.ptr.unwrap();
          while i < self.len, i = (i + 1), {
            ptr := (ptr + i);
            element := ptr.*;
          };
        },
        true => ()
      )
    ),

    /**
     * Clear all elements but keep capacity
     */
    clear :: ((fn(self: Self) -> unit) {
      self._free_elements();
      self.len = (0).as(usize);
    }),

    /**
     * RAII destructor - automatically called when ArrayList goes out of scope
     * For `object`, this is called when the reference count drops to zero
     */
    dispose :: ((fn(self: Self) -> unit) {
      some_ptr := self.ptr;
      match(some_ptr,
        .Some(ptr) => {
          self._free_elements();
          GlobalAllocator.free(.Some(ptr.cast(*(void))));
        },
        .None => ()
      );
      return ();
    })
  );

export
  ArrayList,
  ArrayListError
;
