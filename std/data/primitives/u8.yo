open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Hash } :: import "../../modules/hash.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

U8 :: impl {
  Self :: u8;
  export Self;

  // === Arithmetic ===
  _Add :: Add(u8, u8)
    (+): ((a, b) -> __yo_op_add(a, b))
  ;
  _Sub :: Sub(u8, u8)
    (-): ((a, b) -> __yo_op_sub(a, b))
  ;
  _Mul :: Mul(u8, u8)
    (*): ((a, b) -> __yo_op_mul(a, b))
  ;
  _Div :: Div(u8, u8)
    (/): ((a, b) -> __yo_op_div(a, b))
  ;
  _Mod :: Mod(u8, u8)
    (%): ((a, b) -> __yo_op_mod(a, b))
  ;
  _Negate :: Negate(u8)
    (neg): ((a) -> __yo_op_neg(a))
  ;
  _BitLeftShift :: BitLeftShift(u8, u8)
    (<<): ((a, b) -> __yo_op_bit_left_shift(a, b))
  ;
  _BitRightShift :: BitRightShift(u8, u8)
    (>>): ((a, b) -> __yo_op_bit_right_shift(a, b))
  ;
  export
    Add : _Add,
    Sub : _Sub,
    Mul : _Mul,
    Div : _Div,
    Mod : _Mod,
    Negate : _Negate,
    BitLeftShift : _BitLeftShift,
    BitRightShift : _BitRightShift
  ;

  // === Logic ===
  _LogicalNot :: LogicalNot(u8)
    (!): ((a) -> __yo_op_not(a))
  ;
  _BitNot :: BitNot(u8)
    (~): ((a) -> __yo_op_bit_complement(a))
  ;
  _BitAnd :: BitAnd(u8, u8)
    (&): ((a, b) -> __yo_op_bit_and(a, b))
  ;
  _BitOr :: BitOr(u8, u8)
    (|): ((a, b) -> __yo_op_bit_or(a, b))
  ;
  _BitXor :: BitXor(u8, u8)
    (^): ((a, b) -> __yo_op_bit_xor(a, b))
  ;
  export
    LogicalNot : _LogicalNot,
    BitNot : _BitNot,
    BitAnd : _BitAnd,
    BitOr : _BitOr,
    BitXor : _BitXor
  ;

  // === Eq ===
  _Eq :: Eq(u8, u8)
    (==) : ((a, b) -> __yo_op_eq(a, b)),
    (!=) : ((a, b) -> __yo_op_neq(a, b))
  ;
  export Eq : _Eq;

  // === Ord ===
  _Ord :: Ord(u8, u8, using(_Eq))
    (<) : ((a, b) -> __yo_op_lt(a, b)),
    (<=) : ((a, b) -> __yo_op_lte(a, b)),
    (>) : ((a, b) -> __yo_op_gt(a, b)),
    (>=) : ((a, b) -> __yo_op_gte(a, b))
  ;
  export Ord : _Ord;

  // === Hash ===
  _Hash :: Hash(u8)
    (hash): ((value) -> __yo_as(value, u64))
  ;
  export Hash : _Hash;

  // === Drop ===
  _Drop :: Drop(u8)
    drop: ((self) ->
      // No-op for u8, as it does not require any special cleanup
      __yo_noop()
    )
  ;
  export Drop : _Drop;

  // === Clone ===
  _Clone :: Clone(u8)
    clone: ((self) ->
      // No-op for u8, as it is a primitive type
      __yo_return_self(self.*)
    )
  ;
  export Clone : _Clone;

  // === Other methods ===
  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  export as;

};


ComptU8 :: impl {
  Self :: u8;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_gte(lhs, rhs)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_u8_as(self, Target)
  ;


  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_u8_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  U8,
  ComptU8;

