open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
U8Add :: Add(u8, u8)
  (+): ((a, b) -> __yo_op_add(a, b))
;

U8Sub :: Sub(u8, u8)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

U8Mul :: Mul(u8, u8)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

U8Div :: Div(u8, u8)
  (/): ((a, b) -> __yo_op_div(a, b))
;

U8Mod :: Mod(u8, u8)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

U8Negate :: Negate(u8)
  (neg): ((a) -> __yo_op_neg(a))
;

U8BitLeftShift :: BitLeftShift(u8, u8)
  (<<): ((a, b) -> __yo_op_bit_left_shift(a, b))
;

U8BitRightShift :: BitRightShift(u8, u8)
  (>>): ((a, b) -> __yo_op_bit_right_shift(a, b))
;

/**
 * logic
 */
U8LogicalNot :: LogicalNot(u8)
  (!): ((a) -> __yo_op_not(a))
;

U8BitNot :: BitNot(u8)
  (~): ((a) -> __yo_op_bit_complement(a))
;

U8BitAnd :: BitAnd(u8, u8)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

U8BitOr :: BitOr(u8, u8)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

U8BitXor :: BitXor(u8, u8)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
U8Eq :: Eq(u8, u8)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
U8Ord :: Ord(u8, u8, using(U8Eq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

U8Drop :: Drop(u8)
  drop: ((self) ->
    // No-op for u8, as it does not require any special cleanup
    __yo_noop()
  )
;

U8Clone :: Clone(u8)
  clone: ((self) ->
    // No-op for u8, as it is a primitive type
    __yo_return_self(self.*)
  )
;

U8Methods :: impl {
  Self :: u8;

  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  
  export Self,
    as
  ;
};

U8ComptMethods :: impl {
  Self :: u8;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u8_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u8_gte(lhs, rhs)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_u8_as(self, Target)
  ;


  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_u8_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  U8Add,
  U8Sub,
  U8Mul,
  U8Div,
  U8Mod,
  U8BitLeftShift,
  U8BitRightShift,
  U8Negate,
  U8LogicalNot,
  U8BitNot,
  U8BitAnd,
  U8BitOr,
  U8BitXor,
  U8Eq,
  U8Ord,
  U8Drop,
  U8Clone,
  U8Methods,
  U8ComptMethods
;
