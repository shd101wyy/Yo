{ Option, ? } :: import "../option.yo";
{ Add, Sub } :: import "../../modules/arithmetic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";

extern "Yo",
  __yo_ptr_cast :
    fn(forall(Source: Type), source : *(Source), compt(Target) : Free) -> Target,
  __yo_mut_ptr_cast :
    fn(forall(Source: Type), source : *!(Source), compt(Target) : Free) -> Target,
  
  // Pointer arithmetic operations
  __yo_ptr_add :
    fn(forall(T: Type), ptr : *(T), offset : usize) -> *(T),
  __yo_mut_ptr_add :
    fn(forall(T: Type), ptr : *!(T), offset : usize) -> *!(T),
  __yo_ptr_sub :
    fn(forall(T: Type), ptr : *(T), offset : usize) -> *(T),
  __yo_mut_ptr_sub :
    fn(forall(T: Type), ptr : *!(T), offset : usize) -> *!(T),
  __yo_ptr_diff :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> isize,
  __yo_ptr_eq :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_neq :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_lt :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_lte :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_gt :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_gte :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_deref :
    fn(forall(T: Type), ptr : *(T)) -> T,
  __yo_mut_ptr_deref :
    fn(forall(T: Type), ptr : *!(T)) -> T,
  __yo_mut_ptr_assign :
    fn(forall(T: Type), ptr : *!(T), value : T) -> unit
;

/**
 * Pointer arithmetic functions
 */

/**
 * Immutable pointer operations module
 */
PtrMethods :: module {
  // Pointer arithmetic: ptr + offset
  (+) :: (fn(forall(T: Type), ptr: *(T), offset: usize) -> *(T))
    __yo_ptr_add(ptr, offset)
  ;
  
  // Pointer subtraction: ptr - offset  
  (-) :: (fn(forall(T: Type), ptr: *(T), offset: usize) -> *(T))
    __yo_ptr_sub(ptr, offset)
  ;
  
  // Pointer difference: ptr1 - ptr2 (when both operands are pointers)
  diff :: (fn(forall(T: Type), ptr1: *(T), ptr2: *(T)) -> isize)
    __yo_ptr_diff(ptr1, ptr2)
  ;
  
  // Pointer comparison
  (==) :: (fn(forall(T: Type), ptr1: *(T), ptr2: *(T)) -> boolean)
    __yo_ptr_eq(ptr1, ptr2)
  ;
  
  (!=) :: (fn(forall(T: Type), ptr1: *(T), ptr2: *(T)) -> boolean)
    __yo_ptr_neq(ptr1, ptr2)
  ;
  
  (<) :: (fn(forall(T: Type), ptr1: *(T), ptr2: *(T)) -> boolean)
    __yo_ptr_lt(ptr1, ptr2)
  ;
  
  (<=) :: (fn(forall(T: Type), ptr1: *(T), ptr2: *(T)) -> boolean)
    __yo_ptr_lte(ptr1, ptr2)
  ;
  
  (>) :: (fn(forall(T: Type), ptr1: *(T), ptr2: *(T)) -> boolean)
    __yo_ptr_gt(ptr1, ptr2)
  ;
  
  (>=) :: (fn(forall(T: Type), ptr1: *(T), ptr2: *(T)) -> boolean)
    __yo_ptr_gte(ptr1, ptr2)
  ;
  
  // Dereference pointer to get value
  (*) :: (fn(forall(T: Type), ptr: *(T)) -> T)
    __yo_ptr_deref(ptr)
  ;
  
  // Cast pointer to another type
  cast :: (fn(forall(Source: Type), source: *(Source), compt(Target): Free) -> Target)
    __yo_ptr_cast(source, Target)
  ;
  
  export (+), (-), diff, (==), (!=), (<), (<=), (>), (>=), (*), cast;
};

/**
 * Mutable pointer operations module
 */
MutPtrMethods :: module {
  // Pointer arithmetic: ptr + offset
  (+) :: (fn(forall(T: Type), ptr: *!(T), offset: usize) -> *!(T))
    __yo_mut_ptr_add(ptr, offset)
  ;
  
  // Pointer subtraction: ptr - offset
  (-) :: (fn(forall(T: Type), ptr: *!(T), offset: usize) -> *!(T))
    __yo_mut_ptr_sub(ptr, offset)
  ;
  
  // Dereference mutable pointer to get value
  (*) :: (fn(forall(T: Type), ptr: *!(T)) -> T)
    __yo_mut_ptr_deref(ptr)
  ;
  
  // Assign value to mutable pointer
  assign :: (fn(forall(T: Type), ptr: *!(T), value: T) -> unit)
    __yo_mut_ptr_assign(ptr, value)
  ;
  
  // Cast mutable pointer to another type
  cast :: (fn(forall(Source: Type), source: *!(Source), compt(Target): Free) -> Target)
    __yo_mut_ptr_cast(source, Target)
  ;
  
  export (+), (-), (*), assign, cast;
};

// Nullable pointer
/*
?* :: ((quote(Source) : Expr) -> unquote(Expr))
  quote Option(*(unquote(Source)))
;
*/
?* :: (fn(compt(T): Type) -> compt(Type))
  ?(*(T))
;

// Nullable mutable pointer
/*
?*! :: ((quote(Source) : Expr) -> unquote(Expr))
  quote Option(*!(unquote(Source)))
;
*/
?*! :: (fn(compt(T): Type) -> compt(Type))
  ?(*!(T))
;

export
  PtrMethods,
  MutPtrMethods,
  ?*,
  ?*!
;