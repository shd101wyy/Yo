{ Option } :: import "../option.yo";
{ Add, Sub } :: import "../../modules/arithmetic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";

extern "Yo",
  __yo_ptr_cast :
    fn(forall(Source: Type), source : *(Source), compt(Target) : Type) -> Target,

  // Pointer arithmetic operations
  __yo_ptr_add :
    fn(forall(T: Type), ptr : *(T), offset : usize) -> *(T),
  __yo_ptr_sub :
    fn(forall(T: Type), ptr : *(T), offset : usize) -> *(T),
  __yo_ptr_diff :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> isize,
  __yo_ptr_eq :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_neq :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_lt :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_lte :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_gt :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean,
  __yo_ptr_gte :
    fn(forall(T: Type), ptr1 : *(T), ptr2 : *(T)) -> boolean
;

/**
 * Pointer operations module
 */
Ptr :: impl {
  // Pointer arithmetic: ptr + offset
  (+) :: __yo_ptr_add;
  
  // Pointer subtraction: ptr - offset  
  (-) :: __yo_ptr_sub;
  
  // Pointer difference: ptr1 - ptr2 (when both operands are pointers)
  diff :: __yo_ptr_diff;
  
  // Pointer comparison
  (==) :: __yo_ptr_eq;
  
  (!=) :: __yo_ptr_neq;
  
  (<) :: __yo_ptr_lt;
  
  (<=) :: __yo_ptr_lte;
  
  (>) :: __yo_ptr_gt;
  
  (>=) :: __yo_ptr_gte;
  
  // Cast pointer to another type
  cast :: __yo_ptr_cast;
  
  export 
    (+),
    (-),
    diff,
    (==),
    (!=),
    (<),
    (<=),
    (>),
    (>=),
    cast
};

// Nullable pointer
(?*) :: (fn(compt(T): Type) -> compt(Type))
  Option(*(T))
;

// Nullable mutable pointer
(?*!) :: (fn(compt(T): Type) -> compt(Type))
  Option(*(T))
;

export
  Ptr,
  ?*,
  ?*!
;