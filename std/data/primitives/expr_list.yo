ExprListMethods :: module {
  Self :: ExprList;

  car :: (fn(compt(self) : ExprList) -> compt(Expr))
    __yo_expr_list_car(self)
  ;

  cdr :: (fn(compt(self) : ExprList) -> compt(ExprList))
    __yo_expr_list_cdr(self)
  ;

  first :: car;

  rest :: cdr;

  append :: (fn(compt(self) : ExprList, compt(another) : ExprList) -> compt(ExprList))
    __yo_expr_list_append(self, another)
  ;

  length :: (fn(compt(self) : ExprList) -> compt(usize))
    __yo_expr_list_length(self)
  ;

  export
    Self,
    car,
    cdr,
    first,
    rest,
    append,
    length
  ;
};

export
  ExprListMethods
;