open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Hash } :: import "../../modules/hash.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

I16 :: impl {
  Self :: i16;
  export Self;

  // === Arithmetic ===
  _Add :: Add(Self)
    Self : Self,
    (+): ((a, b) -> __yo_op_add(a, b))
  ;
  _Sub :: Sub(Self)
    Self : Self,
    (-): ((a, b) -> __yo_op_sub(a, b))
  ;
  _Mul :: Mul(Self)
    Self : Self,
    (*): ((a, b) -> __yo_op_mul(a, b))
  ;
  _Div :: Div(Self)
    Self : Self,
    (/): ((a, b) -> __yo_op_div(a, b))
  ;
  _Mod :: Mod(Self)
    Self : Self,
    (%): ((a, b) -> __yo_op_mod(a, b))
  ;
  _Negate :: Negate
    Self : Self,
    (neg): ((a) -> __yo_op_neg(a))
  ;
  _BitLeftShift :: BitLeftShift(Self)
    Self : Self,
    (<<): ((a, b) -> __yo_op_bit_left_shift(a, b))
  ;
  _BitRightShift :: BitRightShift(Self)
    Self : Self,
    (>>): ((a, b) -> __yo_op_bit_right_shift(a, b))
  ;
  export
    Add : _Add,
    Sub : _Sub,
    Mul : _Mul,
    Div : _Div,
    Mod : _Mod,
    Negate : _Negate,
    BitLeftShift : _BitLeftShift,
    BitRightShift : _BitRightShift
  ;

  // === Logic ===
  _LogicalNot :: LogicalNot
    Self : Self,
    (!): ((a) -> __yo_op_not(a))
  ;
  _BitNot :: BitNot
    Self : Self,
    (~): ((a) -> __yo_op_bit_complement(a))
  ;
  _BitAnd :: BitAnd(Self)
    Self : Self,
    (&): ((a, b) -> __yo_op_bit_and(a, b))
  ;
  _BitOr :: BitOr(Self)
    Self : Self,
    (|): ((a, b) -> __yo_op_bit_or(a, b))
  ;
  _BitXor :: BitXor(Self)
    Self : Self,
    (^): ((a, b) -> __yo_op_bit_xor(a, b))
  ;
  export
    LogicalNot : _LogicalNot,
    BitNot : _BitNot,
    BitAnd : _BitAnd,
    BitOr : _BitOr,
    BitXor : _BitXor
  ;

  // === Eq ===
  _Eq :: Eq(Self)
    Self : Self,
    (==) : ((a, b) -> __yo_op_eq(a, b)),
    (!=) : ((a, b) -> __yo_op_neq(a, b))
  ;
  export Eq : _Eq;

  // === Ord ===
  _Ord :: Ord(Self)
    Self : Self,
    (<) : ((a, b) -> __yo_op_lt(a, b)),
    (<=) : ((a, b) -> __yo_op_lte(a, b)),
    (>) : ((a, b) -> __yo_op_gt(a, b)),
    (>=) : ((a, b) -> __yo_op_gte(a, b))
  ;
  export Ord : _Ord;

  // === Hash ===
  _Hash :: Hash
    Self : Self,
    (hash): ((value) -> __yo_as(value, u64))
  ;
  export Hash : _Hash;

  // === Drop ===
  _Drop :: Drop
    Self : Self,
    drop: ((self) ->
      // No-op for i16, as it does not require any special cleanup
      __yo_noop()
    )
  ;
  export Drop : _Drop;

  // === Clone ===
  _Clone :: Clone
    Self : Self,
    clone: ((self) ->
      // No-op for i16, as it is a primitive type
      __yo_return_self(self.*)
    )
  ;
  export Clone : _Clone;

  // === Other methods ===
  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  export as;

};


ComptI16 :: impl {
  Self :: i16;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_gte(lhs, rhs)
  ;

  neg :: (fn(compt(self): Self) -> compt(Self))
    __yo_i16_neg(self)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_i16_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_i16_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    neg,
    as,
    to_string
  ;
};

export
  I16,
  ComptI16;

