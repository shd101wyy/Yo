open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(I16Add) :: Add(i16, i16)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(I16Sub) :: Sub(i16, i16)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(I16Mul) :: Mul(i16, i16)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(I16Div) :: Div(i16, i16)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(I16Mod) :: Mod(i16, i16)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(I16Negate) :: Negate(i16)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(I16LogicalNot) :: LogicalNot(i16)
  (!): ((a) -> __yo_op_not(a))
;

given(I16BitNot) :: BitNot(i16)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(I16BitAnd) :: BitAnd(i16, i16)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(I16BitOr) :: BitOr(i16, i16)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(I16BitXor) :: BitXor(i16, i16)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
given(I16Eq) :: Eq(i16, i16)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
given(I16Ord) :: Ord(i16, i16, using(I16Eq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(I16Drop) :: Drop(i16)
  drop: ((self) ->
    // No-op for i16, as it does not require any special cleanup
    __yo_noop()
  )
;

given(I16Clone) :: Clone(i16)
  clone: ((self) ->
    // No-op for i16, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(I16Methods) :: impl {
  Self :: i16;

  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  
  export Self,
    as
  ;
};

given(I16ComptMethods) :: impl {
  Self :: i16;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i16_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i16_gte(lhs, rhs)
  ;

  neg :: (fn(compt(self): Self) -> compt(Self))
    __yo_i16_neg(self)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_i16_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_i16_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    neg,
    as,
    to_string
  ;
};

export
  I16Add,
  I16Sub,
  I16Mul,
  I16Div,
  I16Mod,
  I16Negate,
  I16LogicalNot,
  I16BitNot,
  I16BitAnd,
  I16BitOr,
  I16BitXor,
  I16Eq,
  I16Ord,
  I16Drop,
  I16Clone,
  I16Methods,
  I16ComptMethods;
