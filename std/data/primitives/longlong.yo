open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
{ LogicalNot } :: import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(LongLongAdd) :: Add(longlong, longlong)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(LongLongSub) :: Sub(longlong, longlong)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(LongLongMul) :: Mul(longlong, longlong)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(LongLongDiv) :: Div(longlong, longlong)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(LongLongMod) :: Mod(longlong, longlong)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(LongLongNegate) :: Negate(longlong)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(LongLongLogicalNot) :: LogicalNot(longlong)
  (!): ((a) -> __yo_op_not(a))
;


/**
 * eq
 */
given(LongLongEq) :: Eq(longlong, longlong)
  (==) : ((a, b) -> __yo_op_eq(a, b))
;

/**
 * ord
 */
given(LongLongOrd) :: Ord(longlong, longlong, using(LongLongEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(LongLongDrop) :: Drop(longlong)
  drop: ((self) ->
    // No-op for longlong, as it does not require any special cleanup
    __yo_noop()
  )
;

given(LongLongClone) :: Clone(longlong)
  clone: ((self) ->
    // No-op for longlong, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(LongLongMethods) :: module {
  Self :: longlong;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_longlong_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  LongLongAdd,
  LongLongSub,
  LongLongMul,
  LongLongDiv,
  LongLongMod,
  LongLongNegate,
  LongLongLogicalNot,
  LongLongEq,
  LongLongOrd,
  LongLongDrop,
  LongLongClone,
  LongLongMethods
;