open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
LongLongAdd :: Add(longlong, longlong)
  (+): ((a, b) -> __yo_op_add(a, b))
;

LongLongSub :: Sub(longlong, longlong)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

LongLongMul :: Mul(longlong, longlong)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

LongLongDiv :: Div(longlong, longlong)
  (/): ((a, b) -> __yo_op_div(a, b))
;

LongLongMod :: Mod(longlong, longlong)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

LongLongNegate :: Negate(longlong)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
LongLongLogicalNot :: LogicalNot(longlong)
  (!): ((a) -> __yo_op_not(a))
;

LongLongBitNot :: BitNot(longlong)
  (~): ((a) -> __yo_op_bit_complement(a))
;

LongLongBitAnd :: BitAnd(longlong, longlong)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

LongLongBitOr :: BitOr(longlong, longlong)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

LongLongBitXor :: BitXor(longlong, longlong)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
LongLongEq :: Eq(longlong, longlong)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
LongLongOrd :: Ord(longlong, longlong, using(LongLongEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

LongLongDrop :: Drop(longlong)
  drop: ((self) ->
    // No-op for longlong, as it does not require any special cleanup
    __yo_noop()
  )
;

LongLongClone :: Clone(longlong)
  clone: ((self) ->
    // No-op for longlong, as it is a primitive type
    __yo_return_self(self.*)
  )
;

LongLongMethods :: impl {
  Self :: longlong;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  LongLongAdd,
  LongLongSub,
  LongLongMul,
  LongLongDiv,
  LongLongMod,
  LongLongNegate,
  LongLongLogicalNot,
  LongLongBitNot,
  LongLongBitAnd,
  LongLongBitOr,
  LongLongBitXor,
  LongLongEq,
  LongLongOrd,
  LongLongDrop,
  LongLongClone,
  LongLongMethods
;