open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
F64Add :: Add(f64, f64)
  (+): ((a, b) -> __yo_op_add(a, b))
;

F64Sub :: Sub(f64, f64)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

F64Mul :: Mul(f64, f64)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

F64Div :: Div(f64, f64)
  (/): ((a, b) -> __yo_op_div(a, b))
;

F64Mod :: Mod(f64, f64)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

F64Negate :: Negate(f64)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
F64LogicalNot :: LogicalNot(f64)
  (!): ((a) -> __yo_op_not(a))
;

F64BitNot :: BitNot(f64)
  (~): ((a) -> __yo_op_bit_complement(a))
;

F64BitAnd :: BitAnd(f64, f64)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

F64BitOr :: BitOr(f64, f64)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

F64BitXor :: BitXor(f64, f64)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
F64Eq :: Eq(f64, f64)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
F64Ord :: Ord(f64, f64, using(F64Eq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

F64Drop :: Drop(f64)
  drop: ((self) ->
    // No-op for f64, as it does not require any special cleanup
    __yo_noop()
  )
;

F64Clone :: Clone(f64)
  clone: ((self) ->
    // No-op for f64, as it is a primitive type
    __yo_return_self(self.*)
  )
;

F64Methods :: impl {
  Self :: f64;

  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  
  export Self,
    as
  ;
};

F64ComptMethods :: impl {
  Self :: f64;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_f64_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_f64_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_f64_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_f64_div(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_f64_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_f64_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_f64_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_f64_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_f64_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_f64_gte(lhs, rhs)
  ;

  neg :: (fn(compt(self): Self) -> compt(Self))
    __yo_f64_neg(self)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_f64_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_f64_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    neg,
    as,
    to_string
  ;
};

export
  F64Add,
  F64Sub,
  F64Mul,
  F64Div,
  F64Mod,
  F64Negate,
  F64LogicalNot,
  F64BitNot,
  F64BitAnd,
  F64BitOr,
  F64BitXor,
  F64Eq,
  F64Ord,
  F64Drop,
  F64Clone,
  F64Methods,
  F64ComptMethods
;
