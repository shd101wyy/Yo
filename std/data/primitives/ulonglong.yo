open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(ULongLongAdd) :: Add(ulonglong, ulonglong)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(ULongLongSub) :: Sub(ulonglong, ulonglong)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(ULongLongMul) :: Mul(ulonglong, ulonglong)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(ULongLongDiv) :: Div(ulonglong, ulonglong)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(ULongLongMod) :: Mod(ulonglong, ulonglong)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(ULongLongNegate) :: Negate(ulonglong)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(ULongLongLogicalNot) :: LogicalNot(ulonglong)
  (!): ((a) -> __yo_op_not(a))
;

given(ULongLongBitNot) :: BitNot(ulonglong)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(ULongLongBitAnd) :: BitAnd(ulonglong, ulonglong)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(ULongLongBitOr) :: BitOr(ulonglong, ulonglong)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(ULongLongBitXor) :: BitXor(ulonglong, ulonglong)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
given(ULongLongEq) :: Eq(ulonglong, ulonglong)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
given(ULongLongOrd) :: Ord(ulonglong, ulonglong, using(ULongLongEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(ULongLongDrop) :: Drop(ulonglong)
  drop: ((self) ->
    // No-op for ulonglong, as it does not require any special cleanup
    __yo_noop()
  )
;

given(ULongLongClone) :: Clone(ulonglong)
  clone: ((self) ->
    // No-op for ulonglong, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(ULongLongMethods) :: impl {
  Self :: ulonglong;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export 
  ULongLongAdd,
  ULongLongSub,
  ULongLongMul,
  ULongLongDiv,
  ULongLongMod,
  ULongLongNegate,
  ULongLongLogicalNot,
  ULongLongBitNot,
  ULongLongBitAnd,
  ULongLongBitOr,
  ULongLongBitXor,
  ULongLongEq,
  ULongLongOrd,
  ULongLongDrop,
  ULongLongClone,
  ULongLongMethods
;