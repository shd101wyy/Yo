open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Hash } :: import "../../modules/hash.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

ULongLong :: impl {
  Self :: ulonglong;
  export Self;

  // === Arithmetic ===
  _Add :: impl(Self, Add(Self)
    (+): ((a, b) -> __yo_op_add(a, b))
  );
  _Sub :: impl(Self, Sub(Self)
    (-): ((a, b) -> __yo_op_sub(a, b))
  );
  _Mul :: impl(Self, Mul(Self)
    (*): ((a, b) -> __yo_op_mul(a, b))
  );
  _Div :: impl(Self, Div(Self)
    (/): ((a, b) -> __yo_op_div(a, b))
  );
  _Mod :: impl(Self, Mod(Self)
    (%): ((a, b) -> __yo_op_mod(a, b))
  );
  _Negate :: impl(Self, Negate(Self)
    (neg): ((a) -> __yo_op_neg(a))
  );
  export
    Add : _Add,
    Sub : _Sub,
    Mul : _Mul,
    Div : _Div,
    Mod : _Mod,
    Negate : _Negate
  ;

  // === Logic ===
  _LogicalNot :: impl(Self, LogicalNot
    (!): ((a) -> __yo_op_not(a))
  );
  _BitNot :: impl(Self, BitNot(Self)
    (~): ((a) -> __yo_op_bit_complement(a))
  );
  _BitAnd :: impl(Self, BitAnd(Self)
    (&): ((a, b) -> __yo_op_bit_and(a, b))
  );
  _BitOr :: impl(Self, BitOr(Self)
    (|): ((a, b) -> __yo_op_bit_or(a, b))
  );
  _BitXor :: impl(Self, BitXor(Self)
    (^): ((a, b) -> __yo_op_bit_xor(a, b))
  );
  export
    LogicalNot : _LogicalNot,
    BitNot : _BitNot,
    BitAnd : _BitAnd,
    BitOr : _BitOr,
    BitXor : _BitXor
  ;

  // === Eq ===
  _Eq :: impl(Self, Eq(Self)
    (==) : ((a, b) -> __yo_op_eq(a, b)),
    (!=) : ((a, b) -> __yo_op_neq(a, b))
  );
  export Eq : _Eq;

  // === Ord ===
  _Ord :: impl(Self, Ord(Self)
    (<) : ((a, b) -> __yo_op_lt(a, b)),
    (<=) : ((a, b) -> __yo_op_lte(a, b)),
    (>) : ((a, b) -> __yo_op_gt(a, b)),
    (>=) : ((a, b) -> __yo_op_gte(a, b))
  );
  export Ord : _Ord;

  // === Hash ===
  _Hash :: impl(Self, Hash
    (hash): ((value) -> __yo_as(value, u64))
  );
  export Hash : _Hash;

  // === Drop ===
  _Drop :: impl(Self, Drop
    drop: ((self) ->
      __yo_noop()
    )
  );
  export Drop : _Drop;

  // === Clone ===
  _Clone :: impl(Self, Clone
    clone: ((self) ->
      __yo_return_self(self.*)
    )
  );
  export Clone : _Clone;

  // === Other methods ===
  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;
  export as;

};

export ULongLong;