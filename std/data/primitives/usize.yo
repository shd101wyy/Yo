open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
{ LogicalNot } :: import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(UsizeAdd) :: Add(usize, usize)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(UsizeSub) :: Sub(usize, usize)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(UsizeMul) :: Mul(usize, usize)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(UsizeDiv) :: Div(usize, usize)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(UsizeMod) :: Mod(usize, usize)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(UsizeNegate) :: Negate(usize)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(UsizeLogicalNot) :: LogicalNot(usize)
  (!): ((a) -> __yo_op_not(a))
;


/**
 * eq
 */
given(UsizeEq) :: Eq(usize, usize)
  (==) : ((a, b) -> __yo_op_eq(a, b))
;

/**
 * ord
 */
given(UsizeOrd) :: Ord(usize, usize, using(UsizeEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(UsizeDrop) :: Drop(usize)
  drop: ((self) ->
    // No-op for usize, as it does not require any special cleanup
    __yo_noop()
  )
;

given(UsizeClone) :: Clone(usize)
  clone: ((self) ->
    // No-op for usize, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(UsizeComptMethods) :: module {
  Self :: usize;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_usize_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_usize_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_usize_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_usize_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_usize_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_usize_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_usize_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_usize_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_usize_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_usize_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_usize_gte(lhs, rhs)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_usize_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_usize_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  UsizeAdd,
  UsizeSub,
  UsizeMul,
  UsizeDiv,
  UsizeMod,
  UsizeNegate,
  UsizeLogicalNot,
  UsizeEq,
  UsizeOrd,
  UsizeDrop,
  UsizeClone,
  UsizeComptMethods
;
