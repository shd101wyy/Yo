open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
ULongAdd :: Add(ulong, ulong)
  (+): ((a, b) -> __yo_op_add(a, b))
;

ULongSub :: Sub(ulong, ulong)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

ULongMul :: Mul(ulong, ulong)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

ULongDiv :: Div(ulong, ulong)
  (/): ((a, b) -> __yo_op_div(a, b))
;

ULongMod :: Mod(ulong, ulong)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

ULongNegate :: Negate(ulong)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
ULongLogicalNot :: LogicalNot(ulong)
  (!): ((a) -> __yo_op_not(a))
;

ULongBitNot :: BitNot(ulong)
  (~): ((a) -> __yo_op_bit_complement(a))
;

ULongBitAnd :: BitAnd(ulong, ulong)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

ULongBitOr :: BitOr(ulong, ulong)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

ULongBitXor :: BitXor(ulong, ulong)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
ULongEq :: Eq(ulong, ulong)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
ULongOrd :: Ord(ulong, ulong, using(ULongEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

ULongDrop :: Drop(ulong)
  drop: ((self) ->
    // No-op for ulong, as it does not require any special cleanup
    __yo_noop()
  )
;

ULongClone :: Clone(ulong)
  clone: ((self) ->
    // No-op for ulong, as it is a primitive type
    __yo_return_self(self.*)
  )
;

ULongMethods :: impl {
  Self :: ulong;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  ULongAdd,
  ULongSub,
  ULongMul,
  ULongDiv,
  ULongMod,
  ULongNegate,
  ULongLogicalNot,
  ULongBitNot,
  ULongBitAnd,
  ULongBitOr,
  ULongBitXor,
  ULongEq,
  ULongOrd,
  ULongDrop,
  ULongClone,
  ULongMethods
;