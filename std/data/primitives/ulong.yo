open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Hash } :: import "../../modules/hash.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

ULong :: impl {
  Self :: ulong;
  export Self;

  // === Arithmetic ===
  _Add :: Add(ulong, ulong)
    (+): ((a, b) -> __yo_op_add(a, b))
  ;
  _Sub :: Sub(ulong, ulong)
    (-): ((a, b) -> __yo_op_sub(a, b))
  ;
  _Mul :: Mul(ulong, ulong)
    (*): ((a, b) -> __yo_op_mul(a, b))
  ;
  _Div :: Div(ulong, ulong)
    (/): ((a, b) -> __yo_op_div(a, b))
  ;
  _Mod :: Mod(ulong, ulong)
    (%): ((a, b) -> __yo_op_mod(a, b))
  ;
  _Negate :: Negate(ulong)
    (neg): ((a) -> __yo_op_neg(a))
  ;
  export
    Add : _Add,
    Sub : _Sub,
    Mul : _Mul,
    Div : _Div,
    Mod : _Mod,
    Negate : _Negate
  ;

  // === Logic ===
  _LogicalNot :: LogicalNot(ulong)
    (!): ((a) -> __yo_op_not(a))
  ;
  _BitNot :: BitNot(ulong)
    (~): ((a) -> __yo_op_bit_complement(a))
  ;
  _BitAnd :: BitAnd(ulong, ulong)
    (&): ((a, b) -> __yo_op_bit_and(a, b))
  ;
  _BitOr :: BitOr(ulong, ulong)
    (|): ((a, b) -> __yo_op_bit_or(a, b))
  ;
  _BitXor :: BitXor(ulong, ulong)
    (^): ((a, b) -> __yo_op_bit_xor(a, b))
  ;
  export
    LogicalNot : _LogicalNot,
    BitNot : _BitNot,
    BitAnd : _BitAnd,
    BitOr : _BitOr,
    BitXor : _BitXor
  ;

  // === Eq ===
  _Eq :: Eq(ulong, ulong)
    (==) : ((a, b) -> __yo_op_eq(a, b)),
    (!=) : ((a, b) -> __yo_op_neq(a, b))
  ;
  export Eq : _Eq;

  // === Ord ===
  _Ord :: Ord(ulong, ulong, using(_Eq))
    (<) : ((a, b) -> __yo_op_lt(a, b)),
    (<=) : ((a, b) -> __yo_op_lte(a, b)),
    (>) : ((a, b) -> __yo_op_gt(a, b)),
    (>=) : ((a, b) -> __yo_op_gte(a, b))
  ;
  export Ord : _Ord;

  // === Hash ===
  _Hash :: Hash(ulong)
    (hash): ((value) -> __yo_as(value, u64))
  ;
  export Hash : _Hash;

  // === Drop ===
  _Drop :: Drop(ulong)
    drop: ((self) ->
      // No-op for ulong, as it does not require any special cleanup
      __yo_noop()
    )
  ;
  export Drop : _Drop;

  // === Clone ===
  _Clone :: Clone(ulong)
    clone: ((self) ->
      // No-op for ulong, as it is a primitive type
      __yo_return_self(self.*)
    )
  ;
  export Clone : _Clone;

  // === Other methods ===
  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;
  export as;

};

export ULong;