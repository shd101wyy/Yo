open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(ULongAdd) :: Add(ulong, ulong)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(ULongSub) :: Sub(ulong, ulong)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(ULongMul) :: Mul(ulong, ulong)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(ULongDiv) :: Div(ulong, ulong)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(ULongMod) :: Mod(ulong, ulong)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(ULongNegate) :: Negate(ulong)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(ULongLogicalNot) :: LogicalNot(ulong)
  (!): ((a) -> __yo_op_not(a))
;

given(ULongBitNot) :: BitNot(ulong)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(ULongBitAnd) :: BitAnd(ulong, ulong)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(ULongBitOr) :: BitOr(ulong, ulong)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(ULongBitXor) :: BitXor(ulong, ulong)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
given(ULongEq) :: Eq(ulong, ulong)
  (==) : ((a, b) -> __yo_op_eq(a, b))
;

/**
 * ord
 */
given(ULongOrd) :: Ord(ulong, ulong, using(ULongEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(ULongDrop) :: Drop(ulong)
  drop: ((self) ->
    // No-op for ulong, as it does not require any special cleanup
    __yo_noop()
  )
;

given(ULongClone) :: Clone(ulong)
  clone: ((self) ->
    // No-op for ulong, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(ULongMethods) :: impl {
  Self :: ulong;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_ulong_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  ULongAdd,
  ULongSub,
  ULongMul,
  ULongDiv,
  ULongMod,
  ULongNegate,
  ULongLogicalNot,
  ULongBitNot,
  ULongBitAnd,
  ULongBitOr,
  ULongBitXor,
  ULongEq,
  ULongOrd,
  ULongDrop,
  ULongClone,
  ULongMethods
;