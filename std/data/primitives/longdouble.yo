open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(LongDoubleAdd) :: Add(longdouble, longdouble)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(LongDoubleSub) :: Sub(longdouble, longdouble)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(LongDoubleMul) :: Mul(longdouble, longdouble)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(LongDoubleDiv) :: Div(longdouble, longdouble)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(LongDoubleMod) :: Mod(longdouble, longdouble)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(LongDoubleNegate) :: Negate(longdouble)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(LongDoubleLogicalNot) :: LogicalNot(longdouble)
  (!): ((a) -> __yo_op_not(a))
;

given(LongDoubleBitNot) :: BitNot(longdouble)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(LongDoubleBitAnd) :: BitAnd(longdouble, longdouble)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(LongDoubleBitOr) :: BitOr(longdouble, longdouble)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(LongDoubleBitXor) :: BitXor(longdouble, longdouble)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
given(LongDoubleEq) :: Eq(longdouble, longdouble)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
given(LongDoubleOrd) :: Ord(longdouble, longdouble, using(LongDoubleEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(LongDoubleDrop) :: Drop(longdouble)
  drop: ((self) ->
    // No-op for longdouble, as it does not require any special cleanup
    __yo_noop()
  )
;

given(LongDoubleClone) :: Clone(longdouble)
  clone: ((self) ->
    // No-op for longdouble, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(LongDoubleMethods) :: impl {
  Self :: longdouble;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  LongDoubleAdd,
  LongDoubleSub,
  LongDoubleMul,
  LongDoubleDiv,
  LongDoubleMod,
  LongDoubleNegate,
  LongDoubleLogicalNot,
  LongDoubleBitNot,
  LongDoubleBitAnd,
  LongDoubleBitOr,
  LongDoubleBitXor,
  LongDoubleEq,
  LongDoubleOrd,
  LongDoubleDrop,
  LongDoubleClone,
  LongDoubleMethods
;