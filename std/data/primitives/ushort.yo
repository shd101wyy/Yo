open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(UShortAdd) :: Add(ushort, ushort)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(UShortSub) :: Sub(ushort, ushort)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(UShortMul) :: Mul(ushort, ushort)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(UShortDiv) :: Div(ushort, ushort)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(UShortMod) :: Mod(ushort, ushort)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(UShortNegate) :: Negate(ushort)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(UShortLogicalNot) :: LogicalNot(ushort)
  (!): ((a) -> __yo_op_not(a))
;

given(UShortBitNot) :: BitNot(ushort)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(UShortBitAnd) :: BitAnd(ushort, ushort)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(UShortBitOr) :: BitOr(ushort, ushort)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(UShortBitXor) :: BitXor(ushort, ushort)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
given(UShortEq) :: Eq(ushort, ushort)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
given(UShortOrd) :: Ord(ushort, ushort, using(UShortEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(UShortDrop) :: Drop(ushort)
  drop: ((self) ->
    // No-op for ushort, as it does not require any special cleanup
    __yo_noop()
  )
;

given(UShortClone) :: Clone(ushort)
  clone: ((self) ->
    // No-op for ushort, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(UShortMethods) :: impl {
  Self :: ushort;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  UShortAdd,
  UShortSub,
  UShortMul,
  UShortDiv,
  UShortMod,
  UShortNegate,
  UShortLogicalNot,
  UShortBitNot,
  UShortBitAnd,
  UShortBitOr,
  UShortBitXor,
  UShortEq,
  UShortOrd,
  UShortDrop,
  UShortClone,
  UShortMethods
;