open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
IntAdd :: Add(int, int)
  (+): ((a, b) -> __yo_op_add(a, b))
;

IntSub :: Sub(int, int)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

IntMul :: Mul(int, int)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

IntDiv :: Div(int, int)
  (/): ((a, b) -> __yo_op_div(a, b))
;

IntMod :: Mod(int, int)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

IntNegate :: Negate(int)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
IntLogicalNot :: LogicalNot(int)
  (!): ((a) -> __yo_op_not(a))
;


IntBitNot :: BitNot(int)
  (~): ((a) -> __yo_op_bit_complement(a))
;

IntBitAnd :: BitAnd(int, int)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

IntBitOr :: BitOr(int, int)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

IntBitXor :: BitXor(int, int)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
IntEq :: Eq(int, int)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
IntOrd :: Ord(int, int, using(IntEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

IntDrop :: Drop(int)
  drop: ((self) ->
    // No-op for int, as it does not require any special cleanup
    __yo_noop()
  )
;

IntClone :: Clone(int)
  clone: ((self) ->
    // No-op for int, as it is a primitive type
    __yo_return_self(self.*)
  )
;

IntMethods :: impl {
  Self :: int;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  IntAdd,
  IntSub,
  IntMul,
  IntDiv,
  IntMod,
  IntNegate,
  IntLogicalNot,
  IntBitNot,
  IntBitAnd,
  IntBitOr,
  IntBitXor,
  IntEq,
  IntOrd,
  IntDrop,
  IntClone,
  IntMethods
;