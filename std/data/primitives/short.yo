open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(ShortAdd) :: Add(short, short)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(ShortSub) :: Sub(short, short)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(ShortMul) :: Mul(short, short)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(ShortDiv) :: Div(short, short)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(ShortMod) :: Mod(short, short)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(ShortNegate) :: Negate(short)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(ShortLogicalNot) :: LogicalNot(short)
  (!): ((a) -> __yo_op_not(a))
;

given(ShortBitNot) :: BitNot(short)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(ShortBitAnd) :: BitAnd(short, short)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(ShortBitOr) :: BitOr(short, short)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(ShortBitXor) :: BitXor(short, short)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
given(ShortEq) :: Eq(short, short)
  (==) : ((a, b) -> __yo_op_eq(a, b))
;

/**
 * ord
 */
given(ShortOrd) :: Ord(short, short, using(ShortEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(ShortDrop) :: Drop(short)
  drop: ((self) ->
    // No-op for short, as it does not require any special cleanup
    __yo_noop()
  )
;

given(ShortClone) :: Clone(short)
  clone: ((self) ->
    // No-op for short, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(ShortMethods) :: impl {
  Self :: short;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_short_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  ShortAdd,
  ShortSub,
  ShortMul,
  ShortDiv,
  ShortMod,
  ShortNegate,
  ShortLogicalNot,
  ShortBitNot,
  ShortBitAnd,
  ShortBitOr,
  ShortBitXor,
  ShortEq,
  ShortOrd,
  ShortDrop,
  ShortClone,
  ShortMethods
;