open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
ShortAdd :: Add(short, short)
  (+): ((a, b) -> __yo_op_add(a, b))
;

ShortSub :: Sub(short, short)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

ShortMul :: Mul(short, short)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

ShortDiv :: Div(short, short)
  (/): ((a, b) -> __yo_op_div(a, b))
;

ShortMod :: Mod(short, short)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

ShortNegate :: Negate(short)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
ShortLogicalNot :: LogicalNot(short)
  (!): ((a) -> __yo_op_not(a))
;

ShortBitNot :: BitNot(short)
  (~): ((a) -> __yo_op_bit_complement(a))
;

ShortBitAnd :: BitAnd(short, short)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

ShortBitOr :: BitOr(short, short)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

ShortBitXor :: BitXor(short, short)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
ShortEq :: Eq(short, short)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
ShortOrd :: Ord(short, short, using(ShortEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

ShortDrop :: Drop(short)
  drop: ((self) ->
    // No-op for short, as it does not require any special cleanup
    __yo_noop()
  )
;

ShortClone :: Clone(short)
  clone: ((self) ->
    // No-op for short, as it is a primitive type
    __yo_return_self(self.*)
  )
;

ShortMethods :: impl {
  Self :: short;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  ShortAdd,
  ShortSub,
  ShortMul,
  ShortDiv,
  ShortMod,
  ShortNegate,
  ShortLogicalNot,
  ShortBitNot,
  ShortBitAnd,
  ShortBitOr,
  ShortBitXor,
  ShortEq,
  ShortOrd,
  ShortDrop,
  ShortClone,
  ShortMethods
;