open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
{ LogicalNot } :: import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(LongAdd) :: Add(long, long)
  (+): (fn(a, b)-> __yo_op_add(a, b))
;

given(LongSub) :: Sub(long, long)
  (-): (fn(a, b)-> __yo_op_sub(a, b))
;

given(LongMul) :: Mul(long, long)
  (*): (fn(a, b)-> __yo_op_mul(a, b))
;

given(LongDiv) :: Div(long, long)
  (/): (fn(a, b)-> __yo_op_div(a, b))
;

given(LongMod) :: Mod(long, long)
  (%): (fn(a, b)-> __yo_op_mod(a, b))
;

given(LongNegate) :: Negate(long)
  (neg): (fn(a)-> __yo_op_neg(a))
;

/**
 * logic
 */
given(LongLogicalNot) :: LogicalNot(long)
  (!): (fn(a)-> __yo_op_not(a))
;


/**
 * eq
 */
given(LongEq) :: Eq(long, long)
  (==) : (fn(a, b)-> __yo_op_eq(a, b))
;

/**
 * ord
 */
given(LongOrd) :: Ord(long, long, using(LongEq))
  (<) : (fn(a, b)-> __yo_op_lt(a, b)),
  (<=) : (fn(a, b)-> __yo_op_lte(a, b)),
  (>) : (fn(a, b)-> __yo_op_gt(a, b)),
  (>=) : (fn(a, b)-> __yo_op_gte(a, b))
;

given(LongDrop) :: Drop(long)
  drop: (fn(self)->
    // No-op for long, as it does not require any special cleanup
    __yo_noop()
  )
;

given(LongClone) :: Clone(long)
  clone: (fn(self)->
    // No-op for long, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(LongMethods) :: module {
  Self :: long;

  as :: ((self: Self, compt(Target) : Type) -> Target)
    __yo_long_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  LongAdd,
  LongSub,
  LongMul,
  LongDiv,
  LongMod,
  LongNegate,
  LongLogicalNot,
  LongEq,
  LongOrd,
  LongDrop,
  LongClone,
  LongMethods
;