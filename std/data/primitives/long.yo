open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(LongAdd) :: Add(long, long)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(LongSub) :: Sub(long, long)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(LongMul) :: Mul(long, long)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(LongDiv) :: Div(long, long)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(LongMod) :: Mod(long, long)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(LongNegate) :: Negate(long)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(LongLogicalNot) :: LogicalNot(long)
  (!): ((a) -> __yo_op_not(a))
;

given(LongBitNot) :: BitNot(long)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(LongBitAnd) :: BitAnd(long, long)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(LongBitOr) :: BitOr(long, long)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(LongBitXor) :: BitXor(long, long)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
given(LongEq) :: Eq(long, long)
  (==) : ((a, b) -> __yo_op_eq(a, b))
;

/**
 * ord
 */
given(LongOrd) :: Ord(long, long, using(LongEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(LongDrop) :: Drop(long)
  drop: ((self) ->
    // No-op for long, as it does not require any special cleanup
    __yo_noop()
  )
;

given(LongClone) :: Clone(long)
  clone: ((self) ->
    // No-op for long, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(LongMethods) :: impl {
  Self :: long;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  LongAdd,
  LongSub,
  LongMul,
  LongDiv,
  LongMod,
  LongNegate,
  LongLogicalNot,
  LongBitNot,
  LongBitAnd,
  LongBitOr,
  LongBitXor,
  LongEq,
  LongOrd,
  LongDrop,
  LongClone,
  LongMethods
;