{ Drop } :: import "../../modules/common.yo";


given(DropArray) :: ((
  forall(compt(T): Type, compt(S): usize), 
  using(compt(DropT): Drop(T)))
  -> compt(Drop(Array(T, S))))
  Drop(Array(T, S))
    drop : 
      fn(self)-> 
        for self, elem => {
          DropT.drop(elem);
        };
  ;

export DropArray;