open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Hash } :: import "../../modules/hash.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
U32Add :: Add(u32, u32)
  (+): ((a, b) -> __yo_op_add(a, b))
;

U32Sub :: Sub(u32, u32)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

U32Mul :: Mul(u32, u32)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

U32Div :: Div(u32, u32)
  (/): ((a, b) -> __yo_op_div(a, b))
;

U32Mod :: Mod(u32, u32)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

U32Negate :: Negate(u32)
  (neg): ((a) -> __yo_op_neg(a))
;

U32BitLeftShift :: BitLeftShift(u32, u32)
  (<<): ((a, b) -> __yo_op_bit_left_shift(a, b))
;

U32BitRightShift :: BitRightShift(u32, u32)
  (>>): ((a, b) -> __yo_op_bit_right_shift(a, b))
;

/**
 * logic
 */
U32LogicalNot :: LogicalNot(u32)
  (!): ((a) -> __yo_op_not(a))
;

U32BitNot :: BitNot(u32)
  (~): ((a) -> __yo_op_bit_complement(a))
;

U32BitAnd :: BitAnd(u32, u32)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

U32BitOr :: BitOr(u32, u32)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

U32BitXor :: BitXor(u32, u32)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
U32Eq :: Eq(u32, u32)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
U32Ord :: Ord(u32, u32, using(U32Eq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

/**
 * hash
 */
U32Hash :: Hash(u32)
  (hash): ((value) -> __yo_as(value, u64))
;

U32Drop :: Drop(u32)
  drop: ((self) ->
    // No-op for u32, as it does not require any special cleanup
    __yo_noop()
  )
;

U32Clone :: Clone(u32)
  clone: ((self) ->
    // No-op for u32, as it is a primitive type
    __yo_return_self(self.*)
  )
;

U32Methods :: impl {
  Self :: u32;

  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  
  export Self,
    as
  ;
};

U32ComptMethods :: impl {
  Self :: u32;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u32_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u32_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u32_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u32_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u32_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u32_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u32_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u32_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u32_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u32_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u32_gte(lhs, rhs)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_u32_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_u32_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  U32Add,
  U32Sub,
  U32Mul,
  U32Div,
  U32Mod,
  U32BitLeftShift,
  U32BitRightShift,
  U32Negate,
  U32LogicalNot,
  U32BitNot,
  U32BitAnd,
  U32BitOr,
  U32BitXor,
  U32Eq,
  U32Ord,
  U32Hash,
  U32Drop,
  U32Clone,
  U32Methods,
  U32ComptMethods
;
