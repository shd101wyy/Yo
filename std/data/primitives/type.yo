TypeMethods :: impl {
  Self :: Type;

  to_string :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_type_to_string(self)
  ;

  is_compatible_with :: (fn(compt(self): Self, compt(expected_type): Type) -> compt(boolean))
    __yo_are_types_compatible(expected_type, self)
  ;

  contains_arc_type :: (fn(compt(self): Self) -> compt(boolean))
    __yo_type_contains_arc_type(self)
  ;

  export
    Self,
    to_string,
    is_compatible_with,
    contains_arc_type
  ;
};

export
  TypeMethods
;