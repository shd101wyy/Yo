open import("../../builtins.yo");
open import "../../modules/logic.yo";
{ Clone, Drop } :: import "../../modules/common.yo";
{ Eq } :: import "../../modules/eq.yo";


Boolean :: impl {
  Self :: boolean;
  export Self;

  // === Eq ===
  _Eq :: Eq(Self)
    Self : Self,
    (==): ((a, b) ->
      __yo_op_eq(a, b)
    )
  ;
  export Eq : _Eq;

  // === Drop ===
  _Drop :: Drop
    Self : Self,
    drop: ((self)->
      // No-op for boolean
      __yo_noop()
    )
  ;
  export Drop : _Drop;

  // === Clone ===
  _Clone :: Clone
    Self : Self,
    clone: ((self) ->
      // No-op for boolean, as it is a primitive type
      __yo_return_self(self.*)
    )
  ;
  export Clone : _Clone;
};

ComptBoolean :: impl {
  Self :: boolean;

  (&&) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_boolean_and(lhs, rhs)
  ;

  (||) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_boolean_or(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_boolean_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_boolean_neq(lhs, rhs)
  ;

  not :: (fn(compt(self): Self) -> compt(Self))
    __yo_compt_boolean_not(self)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_compt_boolean_to_string(self)
  ;

  export
    Self,
    &&,
    ||,
    ==,
    !=,
    not,
    to_string
  ;
};



export
  Boolean,
  ComptBoolean
;