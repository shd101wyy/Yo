{ __yo_noop, __yo_return_self, __yo_op_not, __yo_op_eq } :: import("../../builtins.yo");
{ LogicalNot } :: import "../../modules/logic.yo";
{ Clone, Drop } :: import "../../modules/common.yo";
{ Eq } :: import "../../modules/eq.yo";

/**
 * logic
 */
given(BooleanLogicalNot) :: LogicalNot(boolean)
  (!): (fn(a)->
    __yo_op_not(a)
  )
;

/**
 * eq
 */
given(BooleanEq) :: Eq(boolean, boolean)
  (==): (fn(a, b)->
    __yo_op_eq(a, b)
  )
;

/**
  * Drop
  * 
  * This is a no-op for boolean type, as it does not require any special cleanup.
  */
given(BooleanDrop) :: Drop(boolean)
  drop: (fn(self)->
    // No-op for boolean
    __yo_noop()
  )
;

/**
  * Clone
  * 
  * Just returns the same boolean value, as it is a primitive type.
  */
given(BooleanClone) :: Clone(boolean)
  clone: (fn(self)->
    // No-op for boolean, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(ComptBooleanMethods) :: module {
  Self :: boolean;

  (&&) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_boolean_and(lhs, rhs)
  ;

  (||) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_boolean_or(lhs, rhs)
  ;

  (==) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_boolean_eq(lhs, rhs)
  ;

  (!=) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_boolean_neq(lhs, rhs)
  ;

  not :: ((compt(self): Self) -> compt(Self))
    __yo_compt_boolean_not(self)
  ;

  (to_string) :: ((compt(self): Self) -> compt(compt_string))
    __yo_compt_boolean_to_string(self)
  ;

  export
    Self,
    &&,
    ||,
    ==,
    !=,
    not,
    to_string
  ;
};



export
  BooleanLogicalNot,
  BooleanEq,
  BooleanDrop,
  BooleanClone,
  ComptBooleanMethods
;