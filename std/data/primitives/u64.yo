open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(U64Add) :: Add(u64, u64)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(U64Sub) :: Sub(u64, u64)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(U64Mul) :: Mul(u64, u64)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(U64Div) :: Div(u64, u64)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(U64Mod) :: Mod(u64, u64)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(U64Negate) :: Negate(u64)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(U64LogicalNot) :: LogicalNot(u64)
  (!): ((a) -> __yo_op_not(a))
;

given(U64BitNot) :: BitNot(u64)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(U64BitAnd) :: BitAnd(u64, u64)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(U64BitOr) :: BitOr(u64, u64)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(U64BitXor) :: BitXor(u64, u64)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
given(U64Eq) :: Eq(u64, u64)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
given(U64Ord) :: Ord(u64, u64, using(U64Eq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(U64Drop) :: Drop(u64)
  drop: ((self) ->
    // No-op for u64, as it does not require any special cleanup
    __yo_noop()
  )
;

given(U64Clone) :: Clone(u64)
  clone: ((self) ->
    // No-op for u64, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(U64Methods) :: impl {
  Self :: u64;

  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  
  export Self,
    as
  ;
};


given(U64ComptMethods) :: impl {
  Self :: u64;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u64_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u64_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u64_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u64_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u64_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u64_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u64_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u64_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u64_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u64_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u64_gte(lhs, rhs)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_u64_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_u64_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  U64Add,
  U64Sub,
  U64Mul,
  U64Div,
  U64Mod,
  U64Negate,
  U64LogicalNot,
  U64BitNot,
  U64BitAnd,
  U64BitOr,
  U64BitXor,
  U64Eq,
  U64Ord,
  U64Drop,
  U64Clone,
  U64Methods,
  U64ComptMethods
;
