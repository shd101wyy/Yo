open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Hash } :: import "../../modules/hash.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

I32 :: impl {
  // === Arithmetic ===
  _Add :: Add(i32, i32)
    (+): ((a, b) -> __yo_op_add(a, b))
  ;
  _Sub :: Sub(i32, i32)
    (-): ((a, b) -> __yo_op_sub(a, b))
  ;
  _Mul :: Mul(i32, i32)
    (*): ((a, b) -> __yo_op_mul(a, b))
  ;
  _Div :: Div(i32, i32)
    (/): ((a, b) -> __yo_op_div(a, b))
  ;
  _Mod :: Mod(i32, i32)
    (%): ((a, b) -> __yo_op_mod(a, b))
  ;
  _Negate :: Negate(i32)
    (neg): ((a) -> __yo_op_neg(a))
  ;
  _BitLeftShift :: BitLeftShift(i32, i32)
    (<<): ((a, b) -> __yo_op_bit_left_shift(a, b))
  ;
  _BitRightShift :: BitRightShift(i32, i32)
    (>>): ((a, b) -> __yo_op_bit_right_shift(a, b))
  ;
  export
    Add : _Add,
    Sub : _Sub,
    Mul : _Mul,
    Div : _Div,
    Mod : _Mod,
    Negate : _Negate,
    BitLeftShift : _BitLeftShift,
    BitRightShift : _BitRightShift
  ;
};

/**
 * arithmetic
 */
I32Add :: Add(i32, i32)
  (+): ((a, b) -> __yo_op_add(a, b))
;

I32Sub :: Sub(i32, i32)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

I32Mul :: Mul(i32, i32)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

I32Div :: Div(i32, i32)
  (/): ((a, b) -> __yo_op_div(a, b))
;

I32Mod :: Mod(i32, i32)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

I32Negate :: Negate(i32)
  (neg): ((a) -> __yo_op_neg(a))
;

I32BitLeftShift :: BitLeftShift(i32, i32)
  (<<): ((a, b) -> __yo_op_bit_left_shift(a, b))
;

I32BitRightShift :: BitRightShift(i32, i32)
  (>>): ((a, b) -> __yo_op_bit_right_shift(a, b))
;

/**
 * logic
 */
I32LogicalNot :: LogicalNot(i32)
  (!): ((a) -> __yo_op_not(a))
;

I32BitNot :: BitNot(i32)
  (~): ((a) -> __yo_op_bit_complement(a))
;

I32BitAnd :: BitAnd(i32, i32)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

I32BitOr :: BitOr(i32, i32)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

I32BitXor :: BitXor(i32, i32)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
I32Eq :: Eq(i32, i32)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
I32Ord :: Ord(i32, i32, using(I32Eq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

/**
 * hash
 */
I32Hash :: Hash(i32)
  (hash): ((value) -> __yo_as(value, u64))
;

I32Drop :: Drop(i32)
  drop: ((self) ->
    // No-op for i32, as it does not require any special cleanup
    __yo_noop()
  )
;

I32Clone :: Clone(i32)
  clone: ((self) ->
    // No-op for i32, as it is a primitive type
    __yo_return_self(self.*)
  )
;

I32Methods :: impl {
  Self :: i32;

  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  
  export Self,
    as
  ;
};

/**
 * Methods for compt i32
 */
I32ComptMethods :: impl {
  Self :: i32;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_gte(lhs, rhs)
  ;

  neg :: (fn(compt(self): Self) -> compt(Self))
    __yo_i32_neg(self)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_i32_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_i32_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    neg,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

// TODO: Instead of creating this many modules, let's put everything inside
// I32
// so we can have:
// I32.(+)
// I32.(*)
// etc...

export
  I32,
  I32Add,
  I32Sub,
  I32Mul,
  I32Div,
  I32Mod,
  I32BitLeftShift,
  I32BitRightShift,
  I32Negate,
  I32LogicalNot,
  I32BitNot,
  I32BitAnd,
  I32BitOr,
  I32BitXor,
  I32Eq,
  I32Ord,
  I32Hash,
  I32Drop,
  I32Clone,
  I32Methods,
  I32ComptMethods
;