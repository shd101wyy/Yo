open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Hash } :: import "../../modules/hash.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

I32 :: impl {
  Self :: i32;
  export Self;

  // === Arithmetic ===
  _Add :: impl(Self, Add(Self)
    (+): ((a, b) -> __yo_op_add(a, b))
  );
  _Sub :: impl(Self, Sub(Self)
    (-): ((a, b) -> __yo_op_sub(a, b))
  );
  _Mul :: impl(Self, Mul(Self)
    (*): ((a, b) -> __yo_op_mul(a, b))
  );
  _Div :: impl(Self, Div(Self)
    (/): ((a, b) -> __yo_op_div(a, b))
  );
  _Mod :: impl(Self, Mod(Self)
    (%): ((a, b) -> __yo_op_mod(a, b))
  );
  _Negate :: impl(Self, Negate(Self)
    (neg): ((a) -> __yo_op_neg(a))
  );
  _BitLeftShift :: impl(Self, BitLeftShift(Self)
    (<<): ((a, b) -> __yo_op_bit_left_shift(a, b))
  );
  _BitRightShift :: impl(Self, BitRightShift(Self)
    (>>): ((a, b) -> __yo_op_bit_right_shift(a, b))
  );
  export
    Add : _Add,
    Sub : _Sub,
    Mul : _Mul,
    Div : _Div,
    Mod : _Mod,
    Negate : _Negate,
    BitLeftShift : _BitLeftShift,
    BitRightShift : _BitRightShift
  ;

  // === Logic ===
  _LogicalNot :: impl(Self, LogicalNot
    (!): ((a) -> __yo_op_not(a))
  );

  _BitNot :: impl(Self, BitNot(Self)
    (~): ((a) -> __yo_op_bit_complement(a))
  );

  _BitAnd :: impl(Self, BitAnd(Self)
    (&): ((a, b) -> __yo_op_bit_and(a, b))
  );

  _BitOr :: impl(Self, BitOr(Self)
    (|): ((a, b) -> __yo_op_bit_or(a, b))
  );

  _BitXor :: impl(Self, BitXor(Self)
    (^): ((a, b) -> __yo_op_bit_xor(a, b))
  );
  export
    LogicalNot : _LogicalNot,
    BitNot : _BitNot,
    BitAnd : _BitAnd,
    BitOr : _BitOr,
    BitXor : _BitXor
  ;

  // === Eq ===
  _Eq :: impl(Self, Eq(Self)
    (==) : ((a, b) -> __yo_op_eq(a, b)),
    (!=) : ((a, b) -> __yo_op_neq(a, b))
  );
  export Eq : _Eq;

  // === Ord ===
  _Ord :: impl(Self, Ord(Self)
    (<) : ((a, b) -> __yo_op_lt(a, b)),
    (<=) : ((a, b) -> __yo_op_lte(a, b)),
    (>) : ((a, b) -> __yo_op_gt(a, b)),
    (>=) : ((a, b) -> __yo_op_gte(a, b))
  );
  export Ord : _Ord;

  // === Hash ===
  _Hash :: impl(Self, Hash
    (hash): ((value) -> __yo_as(value, u64))
  );
  export Hash : _Hash;

  // === Drop ===
  _Drop :: impl(Self, Drop
    drop: ((self) ->
      __yo_noop()
    )
  );
  export Drop : _Drop;

  // === Clone ===
  _Clone :: impl(Self, Clone(Self)
    clone: ((self) ->
      __yo_return_self(self)
    )
  );
  export Clone : _Clone;

  // === Other methods ===
  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  export as;

};


/**
 * Methods for compt i32
 */
ComptI32 :: impl {
  Self :: i32;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_gte(lhs, rhs)
  ;

  neg :: (fn(compt(self): Self) -> compt(Self))
    __yo_i32_neg(self)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_i32_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_i32_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    neg,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

// TODO: Instead of creating this many modules, let's put everything inside
// I32
// so we can have:
// I32.(+)
// I32.(*)
// etc...

export
  I32,
  ComptI32
;