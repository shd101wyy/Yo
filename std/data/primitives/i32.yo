open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
{ LogicalNot } :: import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(I32Add) :: Add(i32, i32)
  (+): (fn(a, b)-> __yo_op_add(a, b))
;

given(I32Sub) :: Sub(i32, i32)
  (-): (fn(a, b)-> __yo_op_sub(a, b))
;

given(I32Mul) :: Mul(i32, i32)
  (*): (fn(a, b)-> __yo_op_mul(a, b))
;

given(I32Div) :: Div(i32, i32)
  (/): (fn(a, b)-> __yo_op_div(a, b))
;

given(I32Mod) :: Mod(i32, i32)
  (%): (fn(a, b)-> __yo_op_mod(a, b))
;

given(I32Negate) :: Negate(i32)
  (neg): (fn(a)-> __yo_op_neg(a))
;

/**
 * logic
 */
given(I32LogicalNot) :: LogicalNot(i32)
  (!): (fn(a)-> __yo_op_not(a))
;


/**
 * eq
 */
given(I32Eq) :: Eq(i32, i32)
  (==) : (fn(a, b)-> __yo_op_eq(a, b))
;

/**
 * ord
 */
given(I32Ord) :: Ord(i32, i32, using(I32Eq))
  (<) : (fn(a, b)-> __yo_op_lt(a, b)),
  (<=) : (fn(a, b)-> __yo_op_lte(a, b)),
  (>) : (fn(a, b)-> __yo_op_gt(a, b)),
  (>=) : (fn(a, b)-> __yo_op_gte(a, b))
;

given(I32Drop) :: Drop(i32)
  drop: (fn(self)->
    // No-op for i32, as it does not require any special cleanup
    __yo_noop()
  )
;

given(I32Clone) :: Clone(i32)
  clone: (fn(self)->
    // No-op for i32, as it is a primitive type
    __yo_return_self(self.*)
  )
;


/**
 * Methods for compt i32
 */
given(I32ComptMethods) :: module {
  Self :: i32;

  (+) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_add(lhs, rhs)
  ;

  (-) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_sub(lhs, rhs)
  ;

  (*) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_mul(lhs, rhs)
  ;

  (/) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_div(lhs, rhs)
  ;

  (%) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_i32_mod(lhs, rhs)
  ;

  (==) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_eq(lhs, rhs)
  ;

  (!=) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_neq(lhs, rhs)
  ;

  (<) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_lt(lhs, rhs)
  ;

  (<=) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_lte(lhs, rhs)
  ;

  (>) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_gt(lhs, rhs)
  ;

  (>=) :: ((compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_i32_gte(lhs, rhs)
  ;

  neg :: ((compt(self): Self) -> compt(Self))
    __yo_i32_neg(self)
  ;

  (as) :: ((compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_i32_as(self, Target)
  ;

  (to_string) :: ((compt(self): Self) -> compt(compt_string))
    __yo_i32_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    neg,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  I32Add,
  I32Sub,
  I32Mul,
  I32Div,
  I32Mod,
  I32Negate,
  I32LogicalNot,
  I32Eq,
  I32Ord,
  I32Drop,
  I32Clone,
  I32ComptMethods
;