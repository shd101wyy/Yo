given(ComptStringMethods) :: module {
  Self :: compt_string;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_compt_string_concat(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_compt_string_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_compt_string_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_compt_string_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_compt_string_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_compt_string_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_compt_string_gte(lhs, rhs)
  ;

  length :: (fn(compt(self): Self) -> compt(compt_int))
    __yo_compt_string_length(self)
  ;

  (to_upper) :: (fn(compt(self): Self) -> compt(Self))
    __yo_compt_string_to_upper(self)
  ;

  (to_lower) :: (fn(compt(self): Self) -> compt(Self))
    __yo_compt_string_to_lower(self)
  ;

  slice :: (fn(compt(self): Self, compt(start): compt_int, (compt(end): compt_int) ?= length(self)) -> compt(Self))
    __yo_compt_string_slice(self, start, end)
  ;

  // slice :: (fn(compt(self): Self, compt(start): compt_int) -> compt(Self))
  //   __yo_compt_string_slice(self, start)
  // ;

  export
    Self,
    +,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    length,
    to_upper,
    to_lower,
    slice
  ;
};

export
  ComptStringMethods;
