open import("../../builtins.yo");
{ Clone, Drop } :: import "../../modules/common.yo";

given(CharDrop) :: Drop(char)
  drop: ((self) ->
    // No-op for char, as it does not require any special cleanup
    __yo_noop()
  )
;

given(CharClone) :: Clone(char)
  clone: ((self) ->
    // No-op for char, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(CharMethods) :: impl {
  Self :: char;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export
  CharMethods,
  CharClone,
  CharDrop
;