open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
IsizeAdd :: Add(isize, isize)
  (+): ((a, b) -> __yo_op_add(a, b))
;

IsizeSub :: Sub(isize, isize)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

IsizeMul :: Mul(isize, isize)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

IsizeDiv :: Div(isize, isize)
  (/): ((a, b) -> __yo_op_div(a, b))
;

IsizeMod :: Mod(isize, isize)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

IsizeNegate :: Negate(isize)
  (neg): ((a) -> __yo_op_neg(a))
;

IsizeBitLeftShift :: BitLeftShift(isize, isize)
  (<<): ((a, b) -> __yo_op_bit_left_shift(a, b))
;

IsizeBitRightShift :: BitRightShift(isize, isize)
  (>>): ((a, b) -> __yo_op_bit_right_shift(a, b))
;

/**
 * logic
 */
IsizeLogicalNot :: LogicalNot(isize)
  (!): ((a) -> __yo_op_not(a))
;

IsizeBitNot :: BitNot(isize)
  (~): ((a) -> __yo_op_bit_complement(a))
;

IsizeBitAnd :: BitAnd(isize, isize)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

IsizeBitOr :: BitOr(isize, isize)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

IsizeBitXor :: BitXor(isize, isize)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
IsizeEq :: Eq(isize, isize)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
IsizeOrd :: Ord(isize, isize, using(IsizeEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

IsizeDrop :: Drop(isize)
  drop: ((self) ->
    // No-op for isize, as it does not require any special cleanup
    __yo_noop()
  )
;

IsizeClone :: Clone(isize)
  clone: ((self) ->
    // No-op for isize, as it is a primitive type
    __yo_return_self(self.*)
  )
;

IsizeMethods :: impl {
  Self :: isize;

  (as) :: (fn(self: Self, compt(Target): Type) -> Target)
    __yo_as(self, Target)
  ;
  
  export Self,
    as
  ;
};

IsizeComptMethods :: impl {
  Self :: isize;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_isize_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_isize_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_isize_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_isize_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_isize_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_isize_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_isize_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_isize_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_isize_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_isize_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_isize_gte(lhs, rhs)
  ;

  neg :: (fn(compt(self): Self) -> compt(Self))
    __yo_isize_neg(self)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_isize_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_isize_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    neg,
    as,
    to_string
  ;
};

export
  IsizeAdd,
  IsizeSub,
  IsizeMul,
  IsizeDiv,
  IsizeMod,
  IsizeBitLeftShift,
  IsizeBitRightShift,
  IsizeNegate,
  IsizeLogicalNot,
  IsizeBitNot,
  IsizeBitAnd,
  IsizeBitOr,
  IsizeBitXor,
  IsizeEq,
  IsizeOrd,
  IsizeDrop,
  IsizeClone,
  IsizeMethods,
  IsizeComptMethods
;
