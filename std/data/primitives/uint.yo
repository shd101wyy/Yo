open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(UIntAdd) :: Add(uint, uint)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(UIntSub) :: Sub(uint, uint)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(UIntMul) :: Mul(uint, uint)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(UIntDiv) :: Div(uint, uint)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(UIntMod) :: Mod(uint, uint)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(UIntNegate) :: Negate(uint)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(UIntLogicalNot) :: LogicalNot(uint)
  (!): ((a) -> __yo_op_not(a))
;

given(UIntBitNot) :: BitNot(uint)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(UIntBitAnd) :: BitAnd(uint, uint)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(UIntBitOr) :: BitOr(uint, uint)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(UIntBitXor) :: BitXor(uint, uint)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
given(UIntEq) :: Eq(uint, uint)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
given(UIntOrd) :: Ord(uint, uint, using(UIntEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(UIntDrop) :: Drop(uint)
  drop: ((self) ->
    // No-op for uint, as it does not require any special cleanup
    __yo_noop()
  )
;

given(UIntClone) :: Clone(uint)
  clone: ((self) ->
    // No-op for uint, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(UIntMethods) :: impl {
  Self :: uint;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export 
  UIntAdd,
  UIntSub,
  UIntMul,
  UIntDiv,
  UIntMod,
  UIntNegate,
  UIntLogicalNot,
  UIntBitNot,
  UIntBitAnd,
  UIntBitOr,
  UIntBitXor,
  UIntEq,
  UIntOrd,
  UIntDrop,
  UIntClone,
  UIntMethods
;