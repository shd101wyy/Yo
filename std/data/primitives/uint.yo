open import "../../builtins.yo";
open import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
UIntAdd :: Add(uint, uint)
  (+): ((a, b) -> __yo_op_add(a, b))
;

UIntSub :: Sub(uint, uint)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

UIntMul :: Mul(uint, uint)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

UIntDiv :: Div(uint, uint)
  (/): ((a, b) -> __yo_op_div(a, b))
;

UIntMod :: Mod(uint, uint)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

UIntNegate :: Negate(uint)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
UIntLogicalNot :: LogicalNot(uint)
  (!): ((a) -> __yo_op_not(a))
;

UIntBitNot :: BitNot(uint)
  (~): ((a) -> __yo_op_bit_complement(a))
;

UIntBitAnd :: BitAnd(uint, uint)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

UIntBitOr :: BitOr(uint, uint)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

UIntBitXor :: BitXor(uint, uint)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;



/**
 * eq
 */
UIntEq :: Eq(uint, uint)
  (==) : ((a, b) -> __yo_op_eq(a, b)),
  (!=) : ((a, b) -> __yo_op_neq(a, b))
;

/**
 * ord
 */
UIntOrd :: Ord(uint, uint, using(UIntEq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

UIntDrop :: Drop(uint)
  drop: ((self) ->
    // No-op for uint, as it does not require any special cleanup
    __yo_noop()
  )
;

UIntClone :: Clone(uint)
  clone: ((self) ->
    // No-op for uint, as it is a primitive type
    __yo_return_self(self.*)
  )
;

UIntMethods :: impl {
  Self :: uint;

  as :: (fn(self: Self, compt(Target) : Type) -> Target)
    __yo_as(self, Target)
  ;

  export
    Self,
    as
  ;
};

export 
  UIntAdd,
  UIntSub,
  UIntMul,
  UIntDiv,
  UIntMod,
  UIntNegate,
  UIntLogicalNot,
  UIntBitNot,
  UIntBitAnd,
  UIntBitOr,
  UIntBitXor,
  UIntEq,
  UIntOrd,
  UIntDrop,
  UIntClone,
  UIntMethods
;