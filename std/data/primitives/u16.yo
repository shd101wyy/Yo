open import "../../builtins.yo";
{ Add, Sub, Mul, Div, Mod, Negate } :: import "../../modules/arithmetic.yo";
open import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Ord } :: import "../../modules/ord.yo";
{ Clone, Drop } :: import "../../modules/common.yo";

/**
 * arithmetic
 */
given(U16Add) :: Add(u16, u16)
  (+): ((a, b) -> __yo_op_add(a, b))
;

given(U16Sub) :: Sub(u16, u16)
  (-): ((a, b) -> __yo_op_sub(a, b))
;

given(U16Mul) :: Mul(u16, u16)
  (*): ((a, b) -> __yo_op_mul(a, b))
;

given(U16Div) :: Div(u16, u16)
  (/): ((a, b) -> __yo_op_div(a, b))
;

given(U16Mod) :: Mod(u16, u16)
  (%): ((a, b) -> __yo_op_mod(a, b))
;

given(U16Negate) :: Negate(u16)
  (neg): ((a) -> __yo_op_neg(a))
;

/**
 * logic
 */
given(U16LogicalNot) :: LogicalNot(u16)
  (!): ((a) -> __yo_op_not(a))
;

given(U16BitNot) :: BitNot(u16)
  (~): ((a) -> __yo_op_bit_complement(a))
;

given(U16BitAnd) :: BitAnd(u16, u16)
  (&): ((a, b) -> __yo_op_bit_and(a, b))
;

given(U16BitOr) :: BitOr(u16, u16)
  (|): ((a, b) -> __yo_op_bit_or(a, b))
;

given(U16BitXor) :: BitXor(u16, u16)
  (^): ((a, b) -> __yo_op_bit_xor(a, b))
;


/**
 * eq
 */
given(U16Eq) :: Eq(u16, u16)
  (==) : ((a, b) -> __yo_op_eq(a, b))
;

/**
 * ord
 */
given(U16Ord) :: Ord(u16, u16, using(U16Eq))
  (<) : ((a, b) -> __yo_op_lt(a, b)),
  (<=) : ((a, b) -> __yo_op_lte(a, b)),
  (>) : ((a, b) -> __yo_op_gt(a, b)),
  (>=) : ((a, b) -> __yo_op_gte(a, b))
;

given(U16Drop) :: Drop(u16)
  drop: ((self) ->
    // No-op for u16, as it does not require any special cleanup
    __yo_noop()
  )
;

given(U16Clone) :: Clone(u16)
  clone: ((self) ->
    // No-op for u16, as it is a primitive type
    __yo_return_self(self.*)
  )
;

given(U16ComptMethods) :: module {
  Self :: u16;

  (+) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u16_add(lhs, rhs)
  ;

  (-) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u16_sub(lhs, rhs)
  ;

  (*) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u16_mul(lhs, rhs)
  ;

  (/) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u16_div(lhs, rhs)
  ;

  (%) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(Self))
    __yo_u16_mod(lhs, rhs)
  ;

  (==) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u16_eq(lhs, rhs)
  ;

  (!=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u16_neq(lhs, rhs)
  ;

  (<) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u16_lt(lhs, rhs)
  ;

  (<=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u16_lte(lhs, rhs)
  ;

  (>) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u16_gt(lhs, rhs)
  ;

  (>=) :: (fn(compt(lhs): Self, compt(rhs): Self) -> compt(boolean))
    __yo_u16_gte(lhs, rhs)
  ;

  (as) :: (fn(compt(self): Self, compt(Target): Type) -> compt(Target))
    __yo_u16_as(self, Target)
  ;

  (to_string) :: (fn(compt(self): Self) -> compt(compt_string))
    __yo_u16_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  U16Add,
  U16Sub,
  U16Mul,
  U16Div,
  U16Mod,
  U16Negate,
  U16LogicalNot,
  U16BitNot,
  U16BitAnd,
  U16BitOr,
  U16BitXor,
  U16Eq,
  U16Ord,
  U16Drop,
  U16Clone,
  U16ComptMethods
;
