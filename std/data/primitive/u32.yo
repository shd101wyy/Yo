implicit(ComptU32Methods) :: module {
  Self :: u32;

  (+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u32_add(lhs, rhs)
  ;

  (-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u32_sub(lhs, rhs)
  ;

  (*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u32_mul(lhs, rhs)
  ;

  (/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u32_div(lhs, rhs)
  ;

  (%) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u32_mod(lhs, rhs)
  ;

  (==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u32_eq(lhs, rhs)
  ;

  (!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u32_neq(lhs, rhs)
  ;

  (<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u32_lt(lhs, rhs)
  ;

  (<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u32_lte(lhs, rhs)
  ;

  (>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u32_gt(lhs, rhs)
  ;

  (>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u32_gte(lhs, rhs)
  ;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_u32_as(self, Target)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_u32_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  ComptU32Methods;
