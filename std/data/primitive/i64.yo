implicit(ComptI64Methods) :: module {
  Self :: i64;

  (+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i64_add(lhs, rhs)
  ;

  (-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i64_sub(lhs, rhs)
  ;

  (*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i64_mul(lhs, rhs)
  ;

  (/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i64_div(lhs, rhs)
  ;

  (%) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i64_mod(lhs, rhs)
  ;

  (==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i64_eq(lhs, rhs)
  ;

  (!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i64_neq(lhs, rhs)
  ;

  (<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i64_lt(lhs, rhs)
  ;

  (<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i64_lte(lhs, rhs)
  ;

  (>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i64_gt(lhs, rhs)
  ;

  (>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i64_gte(lhs, rhs)
  ;

  neg :: ((@(self): Self) -> @(Self))
    __yo_i64_neg(self)
  ;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_i64_as(self, Target)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_i64_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    neg,
    as,
    to_string
  ;
};

export
  ComptI64Methods;
