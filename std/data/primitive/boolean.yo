// let { codegen_inline } = @import("../../builtins.yo");
{ LogicalNot } := import "../../classes/logic.yo";
{ Eq } := import "../../classes/eq.yo";
{ Drop } := import "../../classes/common.yo";

/**
 * logic
 */
impl LogicalNot(boolean), {
  (!): (fn(a)-> {
    codegen_inline(C="(!($1))");
    recur(a)
  })
};

/**
 * eq
 */
impl Eq(boolean, boolean), {
  (==): (fn(a, b)-> {
    codegen_inline(C="(($1) == ($2))");
    recur(a, b)
  }),
  (!=): (fn(a, b)-> {
    codegen_inline(C="(($1) != ($2))");
    recur(a, b)
  })
};

/**
 * drop
 */
impl Drop(boolean), {
  drop: noop()
};