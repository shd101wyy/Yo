{ compt_codegen_inline, compt_noop } :: import("../../builtins.yo");
{ LogicalNot } :: import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";
{ Drop } :: import "../../modules/common.yo";

/**
 * logic
 */
BooleanLogicalNot :: LogicalNot(boolean)
  (!): (fn(a)-> {
    compt_codegen_inline("(!($1))");
    recur(a)
  })
;

/**
 * eq
 */
implicit(BooleanEq) :: Eq(boolean, boolean)
  (eq): (fn(a, b)-> {
    compt_codegen_inline("(($1) == ($2))");
    recur(a, b)
  })
  /*,
  (ne): (fn(a, b)-> {
    compt_codegen_inline(C="(($1) != ($2))");
    recur(a, b)
  })
  */
;

/**
 * drop
 */
implicit(BooleanDrop) :: Drop(boolean)
  drop : 
    fn(self) -> compt_noop()
;

export 
  BooleanEq,
  BooleanDrop
;