given(ExprMethods) :: module {
  Self :: Expr;

  is_atom :: ((compt(self): Expr)-> compt(boolean))
    __yo_expr_is_atom(self)
  ;

  is_fn_call :: ((compt(self): Expr)-> compt(boolean))
    __yo_expr_is_fn_call(self)
  ;

  get_callee :: ((compt(self): Expr)-> compt(Expr))
    __yo_expr_get_callee(self)
  ;

  get_args :: ((compt(self): Expr)-> compt(ExprList))
    __yo_expr_get_args(self)
  ;

  cons :: ((compt(self): Expr, compt(rest): ExprList) -> compt(ExprList))
    __yo_expr_list_cons(self, rest)
  ;

  to_string :: ((compt(self): Expr)-> compt(compt_string))
    __yo_expr_to_string(self)
  ;

  export 
    Self,
    is_atom,
    is_fn_call,
    get_callee,
    get_args,
    cons,
    to_string
  ;
};

export
  ExprMethods
;