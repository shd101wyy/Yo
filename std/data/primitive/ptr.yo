{ Option, ? } :: import "../option.yo";

extern "Yo",
  __yo_ptr_cast :
    (forall(@(Source): Type), source : *(Source), @(Target) : Free) -> Target,
  __yo_mut_ptr_cast :
    (forall(@(Source): Type), source : *!(Source), @(Target) : Free) -> Target
;

ptr_cast :: module {
  Self :: (__yo_ptr_cast, __yo_mut_ptr_cast);

  export Self;
};

PtrMethods :: module {
  cast :: ptr_cast;

  export cast;
};

// Nullable pointer
/*
?* :: ((quote(Source) : Expr) -> unquote(Expr))
  quote Option(*(unquote(Source)))
;
*/
?* :: ((compt(T): Type) -> compt(Type))
  ?(*(T))
;

// Nullable mutable pointer
/*
?*! :: ((quote(Source) : Expr) -> unquote(Expr))
  quote Option(*!(unquote(Source)))
;
*/
?*! :: ((compt(T): Type) -> compt(Type))
  ?(*!(T))
;

export
  PtrMethods,
  ?*,
  ?*!
;