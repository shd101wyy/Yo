{ Drop } :: import "../../modules/common.yo";


implicit(DropArray) :: ((
  forall(@(T): Type, @(S): usize), 
  implicit(@(DropT): Drop(T)))
  -> @(Drop(Array(T, S))))
  Drop(Array(T, S))
    drop : 
      fn(self)-> 
        for self, element => {
          DropT.drop(element);
        };
  ;

export DropArray;