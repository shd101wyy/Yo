implicit(ComptF64Methods) :: module {
  Self :: f64;

  (@+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_f64_add(lhs, rhs)
  ;

  (@-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_f64_sub(lhs, rhs)
  ;

  (@*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_f64_mul(lhs, rhs)
  ;

  (@/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_f64_div(lhs, rhs)
  ;

  (@==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f64_eq(lhs, rhs)
  ;

  (@!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f64_neq(lhs, rhs)
  ;

  (@<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f64_lt(lhs, rhs)
  ;

  (@<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f64_lte(lhs, rhs)
  ;

  (@>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f64_gt(lhs, rhs)
  ;

  (@>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f64_gte(lhs, rhs)
  ;

  neg :: ((@(self): Self) -> @(Self))
    __yo_f64_neg(self)
  ;

  @~- :: neg;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_f64_as(self, Target)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_f64_to_string(self)
  ;

  export
    Self,
    @+,
    @-,
    @*,
    @/,
    neg,
    @==,
    @!=,
    @<,
    @<=,
    @>,
    @>=,
    as,
    to_string
  ;
};

export
  ComptF64Methods;
