implicit(U64ComptMethods) :: module {
  Self :: u64;

  (+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u64_add(lhs, rhs)
  ;

  (-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u64_sub(lhs, rhs)
  ;

  (*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u64_mul(lhs, rhs)
  ;

  (/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u64_div(lhs, rhs)
  ;

  (%) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u64_mod(lhs, rhs)
  ;

  (==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u64_eq(lhs, rhs)
  ;

  (!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u64_neq(lhs, rhs)
  ;

  (<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u64_lt(lhs, rhs)
  ;

  (<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u64_lte(lhs, rhs)
  ;

  (>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u64_gt(lhs, rhs)
  ;

  (>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u64_gte(lhs, rhs)
  ;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_u64_as(self, Target)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_u64_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  U64ComptMethods;
