implicit(ComptBooleanMethods) :: module {
  Self :: boolean;

  (@&&) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_compt_boolean_and(lhs, rhs)
  ;

  (@||) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_compt_boolean_or(lhs, rhs)
  ;

  (@==) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_compt_boolean_eq(lhs, rhs)
  ;

  (@!=) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_compt_boolean_neq(lhs, rhs)
  ;

  not :: ((@(self): Self) -> @(Self))
    __yo_compt_boolean_not(self)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_compt_boolean_to_string(self)
  ;

  export
    Self,
    @&&,
    @||,
    @==,
    @!=,
    not,
    to_string
  ;
};

export
  ComptBooleanMethods;
