implicit(TypeMethods) :: module {
  Self :: Type;

  is_free :: ((compt(self): Self) -> compt(boolean))
    __yo_type_is_free(self)
  ;

  is_linear :: ((compt(self): Self) -> compt(boolean))
    __yo_type_is_linear(self)
  ;

  contains_reference :: ((compt(self): Self) -> compt(boolean))
    __yo_type_contains_reference(self)
  ;

  to_string :: ((compt(self): Self) -> compt(compt_string))
    __yo_type_to_string(self)
  ;

  is_compatible_with :: ((compt(self): Self, compt(expected_type): Type) -> compt(boolean))
    __yo_are_types_compatible(expected_type, self)
  ;

  export
    Self,
    is_free,
    is_linear,
    contains_reference,
    to_string,
    is_compatible_with
  ;
};

export
  TypeMethods
;