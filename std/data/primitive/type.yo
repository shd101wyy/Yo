implicit(TypeMethods) :: module {
  Self :: Type;

  is_free :: ((@(self): Self) -> @(boolean))
    __yo_type_is_free(self)
  ;

  is_linear :: ((@(self): Self) -> @(boolean))
    __yo_type_is_linear(self)
  ;

  contains_reference :: ((@(self): Self) -> @(boolean))
    __yo_type_contains_reference(self)
  ;

  to_string :: ((@(self): Self) -> @(compt_string))
    __yo_type_to_string(self)
  ;

  is_compatible_with :: ((@(self): Self, @(expected_type): Type) -> @(boolean))
    __yo_are_types_compatible(expected_type, self)
  ;

  export
    Self,
    is_free,
    is_linear,
    contains_reference,
    to_string,
    is_compatible_with
  ;
};

export
  TypeMethods
;