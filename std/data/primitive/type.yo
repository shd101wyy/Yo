implicit(TypeMethods) :: module {
  Self :: Type;

  to_string :: ((@(self): Self) -> @(compt_string))
    __yo_type_to_string(self)
  ;

  is_compatible_with :: ((@(self): Self, @(expected_type): Type) -> @(boolean))
    __yo_are_types_compatible(expected_type, self)

  export
    Self,
    to_string
  ;
};

export
  TypeMethods
;