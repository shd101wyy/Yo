ExprListMethods :: module {
  Self :: ExprList;

  car :: ((@(self) : ExprList) -> @(Expr))
    __yo_expr_list_car(self)
  ;

  cdr :: ((@(self) : ExprList) -> @(ExprList))
    __yo_expr_list_cdr(self)
  ;

  first :: car;

  rest :: cdr;

  append :: ((@(self) : ExprList, @(another) : ExprList) -> @(ExprList))
    __yo_expr_list_append(self, another)
  ;

  length :: ((@(self) : ExprList) -> @(usize))
    __yo_expr_list_length(self)
  ;

  export
    Self,
    car,
    cdr,
    first,
    rest,
    append,
    length
  ;
};

export
  ExprListMethods
;