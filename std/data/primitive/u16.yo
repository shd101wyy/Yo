implicit(ComptU16Methods) :: module {
  Self :: u16;

  (+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u16_add(lhs, rhs)
  ;

  (-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u16_sub(lhs, rhs)
  ;

  (*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u16_mul(lhs, rhs)
  ;

  (/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u16_div(lhs, rhs)
  ;

  (%) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u16_mod(lhs, rhs)
  ;

  (==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u16_eq(lhs, rhs)
  ;

  (!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u16_neq(lhs, rhs)
  ;

  (<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u16_lt(lhs, rhs)
  ;

  (<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u16_lte(lhs, rhs)
  ;

  (>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u16_gt(lhs, rhs)
  ;

  (>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u16_gte(lhs, rhs)
  ;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_u16_as(self, Target)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_u16_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    as,
    to_string
  ;
};

export
  ComptU16Methods;
