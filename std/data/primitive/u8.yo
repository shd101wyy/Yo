implicit(ComptU8Methods) :: module {
  Self :: u8;

  (@+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u8_add(lhs, rhs)
  ;

  (@-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u8_sub(lhs, rhs)
  ;

  (@*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u8_mul(lhs, rhs)
  ;

  (@/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u8_div(lhs, rhs)
  ;

  (@%) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_u8_mod(lhs, rhs)
  ;

  (@==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u8_eq(lhs, rhs)
  ;

  (@!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u8_neq(lhs, rhs)
  ;

  (@<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u8_lt(lhs, rhs)
  ;

  (@<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u8_lte(lhs, rhs)
  ;

  (@>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u8_gt(lhs, rhs)
  ;

  (@>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_u8_gte(lhs, rhs)
  ;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_u8_as(self, Target)
  ;


  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_u8_to_string(self)
  ;

  export
    Self,
    @+,
    @-,
    @*,
    @/,
    @%,
    @==,
    @!=,
    @<,
    @<=,
    @>,
    @>=,
    as,
    to_string
  ;
};

export
  ComptU8Methods;
