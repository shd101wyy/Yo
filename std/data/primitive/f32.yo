implicit(ComptF32Methods) :: module {
  Self :: f32;

  (@+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_f32_add(lhs, rhs)
  ;

  (@-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_f32_sub(lhs, rhs)
  ;

  (@*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_f32_mul(lhs, rhs)
  ;

  (@/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_f32_div(lhs, rhs)
  ;

  (@==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f32_eq(lhs, rhs)
  ;

  (@!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f32_neq(lhs, rhs)
  ;

  (@<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f32_lt(lhs, rhs)
  ;

  (@<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f32_lte(lhs, rhs)
  ;

  (@>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f32_gt(lhs, rhs)
  ;

  (@>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_f32_gte(lhs, rhs)
  ;

  neg :: ((@(self): Self) -> @(Self))
    __yo_f32_neg(self)
  ;

  @~- :: neg;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_f32_as(self, Target)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_f32_to_string(self)
  ;

  export
    Self,
    @+,
    @-,
    @*,
    @/,
    neg,
    @==,
    @!=,
    @<,
    @<=,
    @>,
    @>=,
    as,
    to_string
  ;
};

export
  ComptF32Methods;
