{ compt_codegen_inline } :: import("../../builtins.yo");
{ Add, Sub, Mul, Div, Mod } :: import "../../modules/arithmetic.yo";
{ LogicalNot } :: import "../../modules/logic.yo";
{ Eq } :: import "../../modules/eq.yo";

/**
 * arithmetic
 */
implicit(I32Add) :: Add(i32, i32)
  Output : i32,
  (+): (fn(a, b)-> {
    compt_codegen_inline("(((int32_t)$1) + ((int32_t)$2))");
    recur(a, b)
  })
;

implicit(I32Sub) :: Sub(i32, i32)
  Output: i32,
  (-): (fn(a, b)-> {
    compt_codegen_inline("(((int32_t)$1) - ((int32_t)$2))");
    recur(a, b)
  })
;

implicit(I32Mul) :: Mul(i32, i32)
  Output: i32,
  (*): (fn(a, b)-> {
    compt_codegen_inline("(((int32_t)$1) * ((int32_t)$2))");
    recur(a, b)
  })
;

implicit(I32Div) :: Div(i32, i32)
  Output: i32,
  (/): (fn(a, b)-> {
    compt_codegen_inline("(((int32_t)$1) / ((int32_t)$2))");
    recur(a, b)
  })
;

implicit(I32Mod) :: Mod(i32, i32)
  Output: i32,
  (%): (fn(a, b)-> {
    compt_codegen_inline("(((int32_t)$1) % ((int32_t)$2))");
    recur(a, b)
  })
;

/**
 * logic
 */
implicit(I32LogicalNot) :: LogicalNot(i32)
  (!): (fn(a)-> {
    compt_codegen_inline("!((int32_t)$1)");
    recur(a)
  })
;


/**
 * eq
 */
implicit(I32Eq) :: Eq(i32, i32)
  eq: (fn(a, b)-> {
    compt_codegen_inline("(((int32_t)*$1) == ((int32_t)*$2))");
    recur(a, b)
  })/*,
  ne: (fn(a, b)-> {
    compt_codegen_inline("(((int32_t)*$1) != ((int32_t)*$2))");
    recur(a, b)
  })*/
;

implicit(ComptI32Methods) :: module {
  Self :: i32;

  (@+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i32_add(lhs, rhs)
  ;

  (@-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i32_sub(lhs, rhs)
  ;

  (@*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i32_mul(lhs, rhs)
  ;

  (@/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i32_div(lhs, rhs)
  ;

  (@%) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i32_mod(lhs, rhs)
  ;

  (@==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i32_eq(lhs, rhs)
  ;

  (@!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i32_neq(lhs, rhs)
  ;

  (@<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i32_lt(lhs, rhs)
  ;

  (@<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i32_lte(lhs, rhs)
  ;

  (@>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i32_gt(lhs, rhs)
  ;

  (@>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i32_gte(lhs, rhs)
  ;

  neg :: ((@(self): Self) -> @(Self))
    __yo_i32_neg(self)
  ;

  @~- :: neg;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_i32_as(self, Target)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_i32_to_string(self)
  ;

  export
    Self,
    @+,
    @-,
    @*,
    @/,
    @%,
    neg,
    @==,
    @!=,
    @<,
    @<=,
    @>,
    @>=,
    as,
    to_string
  ;
};

export
  I32Add,
  I32Sub,
  I32Mul,
  I32Div,
  I32Mod,
  I32LogicalNot,
  I32Eq,
  ComptI32Methods
;