implicit(ComptI16Methods) :: module {
  Self :: i16;

  (+) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i16_add(lhs, rhs)
  ;

  (-) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i16_sub(lhs, rhs)
  ;

  (*) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i16_mul(lhs, rhs)
  ;

  (/) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i16_div(lhs, rhs)
  ;

  (%) :: ((@(lhs): Self, @(rhs): Self) -> @(Self))
    __yo_i16_mod(lhs, rhs)
  ;

  (==) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i16_eq(lhs, rhs)
  ;

  (!=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i16_neq(lhs, rhs)
  ;

  (<) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i16_lt(lhs, rhs)
  ;

  (<=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i16_lte(lhs, rhs)
  ;

  (>) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i16_gt(lhs, rhs)
  ;

  (>=) :: ((@(lhs): Self, @(rhs): Self) -> @(boolean))
    __yo_i16_gte(lhs, rhs)
  ;

  neg :: ((@(self): Self) -> @(Self))
    __yo_i16_neg(self)
  ;

  (as) :: ((@(self): Self, @(Target): Type) -> @(Target))
    __yo_i16_as(self, Target)
  ;

  (to_string) :: ((@(self): Self) -> @(compt_string))
    __yo_i16_to_string(self)
  ;

  export
    Self,
    +,
    -,
    *,
    /,
    %,
    ==,
    !=,
    <,
    <=,
    >,
    >=,
    neg,
    as,
    to_string
  ;
};

export
  ComptI16Methods;
