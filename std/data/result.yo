Result :: (fn(compt(OkType): Type, compt(ErrorType): Type) -> compt(Type))
  enum
    Ok(value: OkType),
    Error(error: ErrorType),

    unwrap :: ((fn(self : Self) -> OkType)
      match(self,
        .Ok(value) => value,
        .Error(_) => panic("Called unwrap on an Error value")
      )
    )
;

export
  Result
;