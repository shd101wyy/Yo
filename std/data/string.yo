{ Option } :: import "./option.yo";
{ Result } :: import "./result.yo";
{ ArrayList } :: import "../collections/array_list.yo";
{ rune } :: import "./rune.yo";
open import "./primitives";

StringError :: enum(
  InvalidUtf8,
  IndexOutOfBounds(index: usize, length: usize)
);

/**
 * String - Immutable UTF-8 encoded string
 * 
 * Similar to JavaScript String, Python str, and Rust String.
 * Strings are immutable - all operations return new strings.
 * 
 * Internal storage uses ArrayList(u8) for UTF-8 bytes.
 */
String :: object(
  _bytes: ArrayList(u8),

  /**
   * Create a new empty string
   */
  new :: ((fn() -> Self)
    Self(_bytes: ArrayList(u8).new())
  ),

  /**
   * Create a string from UTF-8 bytes
   * Returns None if the bytes are not valid UTF-8
   */
  from_utf8 :: ((fn(bytes: ArrayList(u8)) -> Result(Self, StringError))
    .Ok(Self(_bytes: bytes))
  ),

  /**
   * Get the length of the string in Unicode characters (runes)
   * For "你好世界", this returns 4
   */
  length :: ((fn(self: Self) -> usize) {
    count := (0).as(usize);
    byte_index := (0).as(usize);
    total_bytes := self._bytes.length();
    
    while ((byte_index < total_bytes)),
          (byte_index = (byte_index + (1).as(usize))),
    {
      byte_opt := self._bytes.get(byte_index);
      match(byte_opt,
        .Some(byte) => {
          // Count UTF-8 character start bytes (not continuation bytes)
          // Continuation bytes have pattern 10xxxxxx (0x80-0xBF)
          cond(
            ((byte < (0x80).as(u8)) || (byte >= (0xC0).as(u8))) => {
              count = (count + (1).as(usize));
            },
            true => ()
          );
        },
        .None => ()
      );
    };
    
    return count;
  }),

  /**
   * Get the length of the string in bytes
   */
  len_bytes :: ((fn(self: Self) -> usize)
    self._bytes.length()
  ),

  /**
   * Check if the string is empty
   */
  is_empty :: ((fn(self: Self) -> boolean)
    (self._bytes.length() == (0).as(usize))
  ),

  /**
   * Get a reference to the internal byte array
   */
  as_bytes :: ((fn(self: Self) -> ArrayList(u8))
    self._bytes
  ),

  /**
   * Decode a UTF-8 encoded rune starting at the given byte index
   * Internal helper method
   */
  _decode_rune_at :: ((fn(self: Self, byte_index: usize) -> Option(rune)) {
    first_byte_opt := self._bytes.get(byte_index);
    match(first_byte_opt,
      .Some(first_byte) => {
        // Determine how many bytes this UTF-8 character uses
        (res : Option(rune)) = cond(
          // 1-byte character: 0xxxxxxx (ASCII)
          (first_byte < (0x80).as(u8)) => {
            codepoint := first_byte.as(u32);
            rune.from_u32(codepoint)
          },
          // 2-byte character: 110xxxxx 10xxxxxx
          ((first_byte >= (0xC0).as(u8)) && (first_byte < (0xE0).as(u8))) => {
            second_opt := self._bytes.get((byte_index + (1).as(usize)));
            match(second_opt,
              .Some(second) => {
                codepoint := (((first_byte.as(u32) & (0x1F).as(u32)) << (6).as(u32)) | (second.as(u32) & (0x3F).as(u32)));
                rune.from_u32(codepoint)
              },
              .None => .None
            )
          },
          // 3-byte character: 1110xxxx 10xxxxxx 10xxxxxx
          ((first_byte >= (0xE0).as(u8)) && (first_byte < (0xF0).as(u8))) => {
            second_opt := self._bytes.get((byte_index + (1).as(usize)));
            third_opt := self._bytes.get((byte_index + (2).as(usize)));
            match(second_opt,
              .Some(second) =>
                match(third_opt,
                  .Some(third) => {
                    codepoint := ((((first_byte.as(u32) & (0x0F).as(u32)) << (12).as(u32)) | ((second.as(u32) & (0x3F).as(u32)) << (6).as(u32))) | (third.as(u32) & (0x3F).as(u32)));
                    rune.from_u32(codepoint)
                  },
                  .None => .None
                ),
              .None => .None
            )
          },
          // 4-byte character: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
          ((first_byte >= (0xF0).as(u8)) && (first_byte < (0xF8).as(u8))) => {
            second_opt := self._bytes.get((byte_index + (1).as(usize)));
            third_opt := self._bytes.get((byte_index + (2).as(usize)));
            fourth_opt := self._bytes.get((byte_index + (3).as(usize)));
            match(second_opt,
              .Some(second) =>
                match(third_opt,
                  .Some(third) =>
                    match(fourth_opt,
                      .Some(fourth) => {
                        codepoint := (((((first_byte.as(u32) & (0x07).as(u32)) << (18).as(u32)) | ((second.as(u32) & (0x3F).as(u32)) << (12).as(u32))) | ((third.as(u32) & (0x3F).as(u32)) << (6).as(u32))) | (fourth.as(u32) & (0x3F).as(u32)));
                        rune.from_u32(codepoint)
                      },
                      .None => .None
                    ),
                  .None => .None
                ),
              .None => .None
            )
          },
          // Invalid UTF-8 start byte
          true => .None
        );
        return res;
      },
      .None => .None
    )
  }),

  /**
   * Get the rune at the specified character index (0-based)
   * Returns None if index is out of bounds
   * For "你好世界", at(0) returns '你', at(1) returns '好', etc.
   */
  at :: ((fn(self: Self, index: usize) -> Option(rune)) {
    char_count := (0).as(usize);
    byte_index := (0).as(usize);
    total_bytes := self._bytes.length();
    
    // Find the byte position of the character at the given index
    while ((byte_index < total_bytes)),
          (byte_index = (byte_index + (1).as(usize))),
    {
      byte_opt := self._bytes.get(byte_index);
      match(byte_opt,
        .Some(byte) => {
          // Check if this is a UTF-8 character start byte
          is_start := ((byte < (0x80).as(u8)) || (byte >= (0xC0).as(u8)));
          cond(
            is_start => {
              // Found a character start byte
              cond(
                (char_count == index) => {
                  // This is the character we want, decode it
                  return self._decode_rune_at(byte_index);
                },
                true => {
                  // Not the right character yet, keep counting
                  char_count = (char_count + (1).as(usize));
                }
              );
            },
            true => ()
          );
        },
        .None => ()
      );
    };
    
    // Index out of bounds
    return .None;
  }),

  /**
   * Concatenate two strings (like JavaScript +)
   */
  concat :: ((fn(self: Self, other: Self) -> Self) {
    new_bytes := ArrayList(u8).with_capacity((self.len_bytes() + other.len_bytes()));
    
    // Copy bytes from self
    i := (0).as(usize);
    while ((i < self.len_bytes())),
          (i = (i + (1).as(usize))),
    {
      byte_opt := self._bytes.get(i);
      match(byte_opt,
        .Some(byte) => { new_bytes.push(byte); },
        .None => { panic("String.concat: failed to get byte from self"); }
      );
    };
    
    // Copy bytes from other
    j := (0).as(usize);
    while ((j < other.len_bytes())),
          (j = (j + (1).as(usize))),
    {
      byte_opt := other._bytes.get(j);
      match(byte_opt,
        .Some(byte) => { new_bytes.push(byte); },
        .None => { panic("String.concat: failed to get byte from other"); }
      );
    };
    
    return Self(_bytes: new_bytes);
  }),

  /**
   * Dispose the string and free its memory
   */
  dispose :: ((fn(self: Self) -> unit) {
    self._bytes.dispose();
  })
);

export
  String,
  StringError
;
