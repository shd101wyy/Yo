//! NFA virtual machine (Thompson simulation).
//!
//! **Internal to `std/regex`.** Nothing here is public API: import
//! `std/regex` and use `Regex`. This module's shape changes freely.
//!
//! Executes a compiled NFA program against an input string.
//! Uses Thompson's NFA simulation with parallel state tracking
//! for O(n×m) worst-case time complexity.
//!
//! ## Capture slots
//!
//! Each live NFA thread carries its own capture-slot array of
//! `2 * (n_groups + 1)` `usize` entries — two (start, end) per group plus
//! two for the whole match — initialised to `usize.MAX` ("unset"). The count
//! is derived from the compiled program, so there is **no cap on the number
//! of capture groups**: the engine neither errors nor truncates, and the only
//! bound is memory. (A `MAX_SLOTS :: 200` constant used to sit here; it was
//! referenced nowhere and bounded nothing, so it was deleted rather than
//! turned into a limit the engine never had.)
//!
//! ## Match semantics
//!
//! LEFTMOST-FIRST, like Perl/PCRE and Rust's regex crate — not POSIX
//! leftmost-longest. Threads within one generation are processed in priority
//! order and the first to reach `Match` wins, which is exactly what makes
//! `a|ab` match just `a`. Priority comes from the order `_add_thread` walks a
//! `Split`'s two targets (`target_a` first), so the compiler's greedy/lazy
//! target ordering IS the greediness.
//!
//! ## Where it stops being linear
//!
//! The `seen` bitmap makes each generation visit every pc at most once, which
//! is what buys O(n×m). A `Backref` breaks that premise: it needs the actual
//! text a group captured, so two threads at the same pc are no longer
//! interchangeable, and a multi-byte backreference cannot be consumed in one
//! generation at all — those threads go into `deferred` and are revived at the
//! byte position they land on. Lookarounds also step outside the simulation:
//! each one runs its own nested generation loop over the sub-program. So
//! patterns using only the linear-time constructs get the linear-time bound,
//! and the others do not.
//!
//! ## Stability
//!
//! unstable, and deliberately not public. It is one half of an internal pair
//! with `compiler.yo` — the `Instr` set is their private wire format and moves
//! in the same commit as this file. Two behaviours here are known-approximate
//! and will change: `_to_lower` folds ASCII only, so the `i` flag does not
//! match `é`/`É`, and class membership is a linear scan of unsorted ranges. A
//! third is unbounded: nothing caps thread count or backtracking work, so a
//! pathological backreference pattern has no execution budget the way Rust's
//! engine does. Fixing any of those changes what matches or how long it takes.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ NfaProgram, ClassEntry } :: import("./compiler.yo");
{ RegexFlags } :: import("./flags.yo");
utf8 :: import("../encoding/utf8.yo");
/// One live NFA thread — a position in the program plus the captures it has
/// recorded so far. Reference-counted, but never shared: `fork` copies the
/// slots, because two threads that diverge must not see each other's captures.
NfaThread :: ref(
  struct(
    /// Index into `NfaProgram.instructions` — the instruction this thread is
    /// about to execute.
    pc : usize,
    /// `2 * (n_groups + 1)` capture positions, `usize.MAX` meaning "unset".
    /// Slot `2g` is group `g`'s start and `2g+1` its end; 0 and 1 are the
    /// whole match.
    slots : ArrayList(usize)
  )
);
impl(
  NfaThread,
  /// A thread at `pc` with all `n_slots` captures unset.
  ///
  /// "Unset" is `usize.MAX`, chosen so the whole array can be initialised
  /// with one `memset` of `0xFF` instead of a per-slot loop — which is why the
  /// sentinel is MAX rather than 0 (0 is a legal byte offset).
  new : (fn(pc : usize, n_slots : usize) -> Self)({
    s := ArrayList(usize).with_capacity(n_slots);
    // usize.MAX = 0xFF..FF, so memset with 0xFF fills each byte
    s.resize_with_byte(n_slots, int(255));
    Self(pc : pc, slots : s)
  }),
  /// A copy of this thread positioned at `new_pc`, with its captures copied
  /// too.
  ///
  /// The copy is a bulk `extend_from_ptr`, and it is what a `Split` costs: an
  /// O(n_slots) copy per fork per generation. Every step of the simulation
  /// forks rather than mutating, so a thread's captures are only ever written
  /// by the thread that owns them.
  fork : (fn(self : Self, new_pc : usize) -> Self)({
    new_slots := ArrayList(usize).with_capacity(self.slots.len());
    match(
      self.slots.ptr(),
      .Some(src) => new_slots.extend_from_ptr(src, self.slots.len()),
      .None => ()
    );
    Self(pc : new_pc, slots : new_slots)
  })
);
/// What one `exec_at` attempt produced.
VmMatch :: struct(
  /// Whether a match was found starting at (or, without the `y` flag, at or
  /// after) the requested position.
  matched : bool,
  /// The winning thread's capture slots, or an EMPTY list when `matched` is
  /// false — so callers must check `matched` before indexing, not just the
  /// length.
  slots : ArrayList(usize)
);
/// One decoded rune and how many bytes it occupied — the unit the simulation
/// advances by, since the program matches runes while positions are byte
/// offsets.
DecodedChar :: struct(
  /// The code point, or U+FFFD when the bytes did not decode: the VM is
  /// tolerant by contract and never fails on malformed input.
  codepoint : u32,
  /// Bytes consumed, always at least 1 — a malformed byte is charged as width
  /// 1 so the scan cannot stall.
  byte_len : usize
);
/// A thread parked until the scan reaches a later byte position.
///
/// This exists for BACKREFERENCES only. A `Backref` consumes as many bytes as
/// the referenced group captured, which may be several generations' worth,
/// and the generation loop advances one rune at a time — so the thread is
/// stored here and revived when `byte_pos` catches up. Nothing else in the
/// engine needs it, because every other instruction consumes zero or one rune.
DeferredThread :: struct(
  /// The byte position at which this thread becomes live again.
  target_byte_pos : usize,
  /// The parked thread, captures included.
  thread : NfaThread
);
/// One execution context: a compiled program bound to one input, plus the
/// scratch buffers the generation loop reuses.
///
/// Cheap to create and intended to be created per attempt — `Regex`'s
/// `Pattern` methods build one per call. It is NOT reusable across inputs (the
/// input is a field) and not safe to run twice concurrently (the `_seen`
/// buffers are shared mutable scratch), but `exec_at` may be called repeatedly
/// on the same instance for different start offsets, which is how `find_all`
/// walks a string.
NfaVm :: ref(
  struct(
    _program : NfaProgram,
    _flags : RegexFlags,
    _input : String,
    _bytes : ArrayList(u8),
    _n_slots : usize,
    _seen : ArrayList(bool),
    _next_seen : ArrayList(bool)
  )
);
// Block 1: Constructor and leaf helpers (no method dependencies)
impl(
  NfaVm,
  /// Bind `program` and `flags` to `input`, sizing the capture array from the
  /// program's group count and pre-allocating the two per-generation `seen`
  /// bitmaps to the instruction count. Those two allocations are hoisted here,
  /// rather than made per generation, because `exec_at` clears them with a
  /// `memset` on every step.
  new : (fn(program : NfaProgram, flags : RegexFlags, input : String) -> Self)({
    n_slots := ((program.n_groups + usize(1)) * usize(2));
    n_instr := program.instructions.len();
    seen := ArrayList(bool).with_capacity(n_instr);
    seen.resize_with_byte(n_instr, int(0));
    next_seen := ArrayList(bool).with_capacity(n_instr);
    next_seen.resize_with_byte(n_instr, int(0));
    Self(
      _program : program,
      _flags : flags,
      _input : input,
      _bytes : input.as_bytes(),
      _n_slots : n_slots,
      _seen : seen,
      _next_seen : next_seen
    )
  }),
  // Tolerant by contract: the VM steps over whatever bytes the subject
  // happens to hold, so a malformed sequence yields U+FFFD and a width of 1
  // rather than failing. The old hand-rolled version indexed `_bytes` past the
  // end on a truncated tail; `decode_lossy` bounds-checks instead.
  _decode_codepoint : (fn(self : Self, pos : usize) -> DecodedChar)({
    d := utf8.decode_lossy(self._bytes, pos);
    DecodedChar(codepoint : d.code.to_u32(), byte_len : d.width)
  }),
  _to_lower : (fn(self : Self, cp : u32) -> u32)(
    cond(
      ((cp >= u32(65)) && (cp <= u32(90))) => (cp + u32(32)),
      true => cp
    )
  ),
  _is_word_char : (fn(self : Self, cp : u32) -> bool)(
    ((cp >= u32(48)) && (cp <= u32(57))) || ((cp >= u32(65)) && (cp <= u32(90))) || (((cp >= u32(97)) && (cp <= u32(122))) || (cp == u32(95)))
  ),
  _find_prev_char_start : (fn(self : Self, pos : usize) -> usize)({
    p := (pos - usize(1));
    while(p > usize(0), p = (p - usize(1)), {
      b := self._bytes(p);
      cond(
        utf8.is_boundary(b) => {
          return(p);
        },
        true => ()
      );
    });
    p
  }),
  _prev_byte_is_newline : (fn(self : Self, pos : usize) -> bool)(
    cond(
      (pos == usize(0)) => false,
      true => {
        b := self._bytes(pos - usize(1));
        b == u8(10)
      }
    )
  ),
  _cur_byte_is_newline : (fn(self : Self, pos : usize) -> bool)(
    cond(
      (pos >= self._bytes.len()) => false,
      true => {
        b := self._bytes(pos);
        b == u8(10)
      }
    )
  )
);
// Block 2: Methods that depend on Block 1
impl(
  NfaVm,
  _char_matches : (fn(self : Self, expected : u32, actual : u32) -> bool)(
    cond(
      (expected == actual) => true,
      self._flags.ignore_case => (self._to_lower(expected) == self._to_lower(actual)),
      true => false
    )
  ),
  _codepoint_in_class : (fn(self : Self, cp : u32, cls : ClassEntry) -> bool)({
    check_cp := cond(
      self._flags.ignore_case => self._to_lower(cp),
      true => cp
    );
    (found : bool) = false;
    i := usize(0);
    while((i < cls.ranges.len()) && !found, i = (i + usize(1)), {
      r := cls.ranges(i);
      (low : u32) = cond(
        self._flags.ignore_case => self._to_lower(r.low),
        true => r.low
      );
      (high : u32) = cond(
        self._flags.ignore_case => self._to_lower(r.high),
        true => r.high
      );
      cond(
        ((check_cp >= low) && (check_cp <= high)) => {
          found = true;
        },
        true => ()
      );
    });
    cond(
      (!found && self._flags.ignore_case) => {
        i2 := usize(0);
        while((i2 < cls.ranges.len()) && !found, i2 = (i2 + usize(1)), {
          r := cls.ranges(i2);
          cond(
            ((cp >= r.low) && (cp <= r.high)) => {
              found = true;
            },
            true => ()
          );
        });
      },
      true => ()
    );
    cond(
      cls.negated => !found,
      true => found
    )
  }),
  _is_word_boundary : (fn(self : Self, pos : usize) -> bool)({
    left_is_word := cond(
      (pos == usize(0)) => false,
      true => {
        prev_pos := self._find_prev_char_start(pos);
        prev := self._decode_codepoint(prev_pos);
        self._is_word_char(prev.codepoint)
      }
    );
    right_is_word := cond(
      (pos >= self._bytes.len()) => false,
      true => {
        cur := self._decode_codepoint(pos);
        self._is_word_char(cur.codepoint)
      }
    );
    left_is_word != right_is_word
  })
);
// Block 3: _add_thread (recursive, depends on Block 1+2)
impl(
  NfaVm,
  _add_thread : (fn(self : Self, list : ArrayList(NfaThread), thread : NfaThread, byte_pos : usize, seen : ArrayList(bool)) -> unit)({
    cond(
      (thread.pc >= self._program.instructions.len()) => {
        return(());
      },
      true => ()
    );
    // Already checked bounds above: thread.pc < instructions.len()
    is_seen := seen(thread.pc);
    cond(
      is_seen => {
        return(());
      },
      true => ()
    );
    seen(thread.pc) = true;
    instr := self._program.instructions(thread.pc);
    match(
      instr.kind,
      .Split => {
        t1 := thread.fork(instr.target_a);
        t2 := thread.fork(instr.target_b);
        recur(self, list, t1, byte_pos, seen);
        recur(self, list, t2, byte_pos, seen);
      },
      .Jump => {
        new_t := thread.fork(instr.target);
        recur(self, list, new_t, byte_pos, seen);
      },
      .Save => {
        cond(
          (instr.slot < thread.slots.len()) => {
            &(thread.slots(instr.slot)).* = byte_pos;
          },
          true => ()
        );
        new_t := NfaThread(pc : (thread.pc + usize(1)), slots : thread.slots);
        recur(self, list, new_t, byte_pos, seen);
      },
      .AssertStart => {
        passes := cond(
          self._flags.multiline =>
            ((byte_pos == usize(0)) || self._prev_byte_is_newline(byte_pos)),
          true => (byte_pos == usize(0))
        );
        cond(
          passes => {
            new_t := thread.fork(thread.pc + usize(1));
            recur(self, list, new_t, byte_pos, seen);
          },
          true => ()
        );
      },
      .AssertEnd => {
        passes := cond(
          self._flags.multiline =>
            ((byte_pos >= self._bytes.len()) || self._cur_byte_is_newline(byte_pos)),
          true => (byte_pos >= self._bytes.len())
        );
        cond(
          passes => {
            new_t := thread.fork(thread.pc + usize(1));
            recur(self, list, new_t, byte_pos, seen);
          },
          true => ()
        );
      },
      .AssertWordBoundary => {
        cond(
          self._is_word_boundary(byte_pos) => {
            new_t := thread.fork(thread.pc + usize(1));
            recur(self, list, new_t, byte_pos, seen);
          },
          true => ()
        );
      },
      .AssertNonWordBoundary => {
        cond(
          !self._is_word_boundary(byte_pos) => {
            new_t := thread.fork(thread.pc + usize(1));
            recur(self, list, new_t, byte_pos, seen);
          },
          true => ()
        );
      },
      _ => {
        list.push(thread);
      }
    );
  })
);
// Block 4: Sub-VM for lookahead/lookbehind (depends on Block 1+2+3)
impl(
  NfaVm,
  // Run a sub-VM starting at sub_start_pc from start_byte.
  // If required_end is not UNSET, only succeed when Match is found at exactly required_end.
  _run_sub_vm : (fn(self : Self, sub_start_pc : usize, start_byte : usize, required_end : usize) -> bool)({
    unset := usize.MAX;
    sub_current := ArrayList(NfaThread).new();
    sub_next := ArrayList(NfaThread).new();
    sub_seen := ArrayList(bool).with_capacity(self._program.instructions.len());
    sub_seen.resize_with_byte(self._program.instructions.len(), int(0));
    initial := NfaThread.new(sub_start_pc, self._n_slots);
    self._add_thread(sub_current, initial, start_byte, sub_seen);
    sub_pos := start_byte;
    input_len := self._bytes.len();
    while(sub_pos <= input_len, {
      cond(
        (sub_current.len() == usize(0)) => {
          break;
        },
        true => ()
      );
      // Check for Match in current threads
      st := usize(0);
      while(st < sub_current.len(), st = (st + usize(1)), {
        st_thread := sub_current(st);
        st_instr := self._program.instructions(st_thread.pc);
        match(
          st_instr.kind,
          .Match => {
            cond(
              (required_end == unset) => {
                return(true);
              },
              (sub_pos == required_end) => {
                return(true);
              },
              true => ()
            );
          },
          _ => ()
        );
      });
      cond(
        (sub_pos >= input_len) => {
          break;
        },
        true => ()
      );
      // Stop if we've passed the required end position
      cond(
        ((required_end != unset) && (sub_pos > required_end)) => {
          break;
        },
        true => ()
      );
      decoded := self._decode_codepoint(sub_pos);
      sub_cp := decoded.codepoint;
      sub_blen := decoded.byte_len;
      // Clear seen
      sub_seen.fill_with_byte(int(0));
      // Process consuming instructions
      st2 := usize(0);
      while(st2 < sub_current.len(), st2 = (st2 + usize(1)), {
        st_thread := sub_current(st2);
        st_instr := self._program.instructions(st_thread.pc);
        match(
          st_instr.kind,
          .Char => {
            cond(
              self._char_matches(st_instr.codepoint, sub_cp) => {
                new_t := st_thread.fork(st_thread.pc + usize(1));
                self._add_thread(sub_next, new_t, sub_pos + sub_blen, sub_seen);
              },
              true => ()
            );
          },
          .AnyChar => {
            should_match := cond(
              self._flags.dot_all => true,
              true => (sub_cp != u32(10))
            );
            cond(
              should_match => {
                new_t := st_thread.fork(st_thread.pc + usize(1));
                self._add_thread(sub_next, new_t, sub_pos + sub_blen, sub_seen);
              },
              true => ()
            );
          },
          .CharClass => {
            class_opt := self._program.classes.get(st_instr.class_idx);
            match(
              class_opt,
              .Some(cls) => {
                cond(
                  self._codepoint_in_class(sub_cp, cls) => {
                    new_t := st_thread.fork(st_thread.pc + usize(1));
                    self._add_thread(sub_next, new_t, sub_pos + sub_blen, sub_seen);
                  },
                  true => ()
                );
              },
              .None => ()
            );
          },
          _ => ()
        );
      });
      // Swap sub_current/sub_next and clear for reuse
      tmp_sub := sub_current;
      sub_current = sub_next;
      sub_next = tmp_sub;
      sub_next.clear();
      sub_pos = (sub_pos + sub_blen);
    });
    false
  })
);
// Block 5: exec_at (depends on Block 1+2+3+4)
impl(
  NfaVm,
  /// Run the program against the input, starting at byte offset `start_byte`.
  ///
  /// Without the `y` (sticky) flag the caller is expected to retry at
  /// successive offsets — this function does not itself scan forward for a
  /// start position; the surrounding `Regex` methods do, using
  /// `literal_prefix` to skip offsets that cannot match.
  ///
  /// Returns the LEFTMOST-FIRST match (see the module header): threads are
  /// processed in priority order within each generation and the first to reach
  /// `Match` ends that generation, so alternation order and greedy/lazy
  /// ordering decide the result rather than match length.
  ///
  /// The loop runs while `byte_pos <= input_len` — one generation PAST the
  /// last byte — because the zero-width assertions (`$`, `\b`) and empty
  /// matches have to be evaluated at the end of input too.
  ///
  /// `start_byte` is not boundary-checked: a mid-rune offset simply decodes
  /// the bytes it finds there and, for a valid pattern, fails to match.
  exec_at : (fn(self : Self, start_byte : usize) -> VmMatch)({
    // Reuse pre-allocated seen buffers from the VM
    current := ArrayList(NfaThread).new();
    next := ArrayList(NfaThread).new();
    seen := self._seen;
    next_seen := self._next_seen;
    deferred := ArrayList(DeferredThread).new();
    // Clear for this execution
    seen.fill_with_byte(int(0));
    next_seen.fill_with_byte(int(0));
    initial := NfaThread.new(usize(0), self._n_slots);
    self._add_thread(current, initial, start_byte, seen);
    best_match := VmMatch(matched : false, slots : ArrayList(usize).new());
    byte_pos := start_byte;
    input_len := self._bytes.len();
    unset := usize.MAX;
    while(byte_pos <= input_len, {
      (cur_cp : u32) = u32(0);
      (char_byte_len : usize) = usize(0);
      (at_end : bool) = (byte_pos >= input_len);
      cond(
        !at_end => {
          decoded := self._decode_codepoint(byte_pos);
          cur_cp = decoded.codepoint;
          char_byte_len = decoded.byte_len;
        },
        true => ()
      );
      // Clear seen flags for this generation using memset
      seen.fill_with_byte(int(0));
      next_seen.fill_with_byte(int(0));
      // Process deferred threads targeting this byte_pos
      new_deferred := ArrayList(DeferredThread).new();
      di := usize(0);
      while(di < deferred.len(), di = (di + usize(1)), {
        d := deferred(di);
        cond(
          (d.target_byte_pos == byte_pos) => {
            self._add_thread(current, d.thread, byte_pos, seen);
          },
          true => {
            new_deferred.push(d);
          }
        );
      });
      deferred = new_deferred;
      // Break if no threads and no deferred
      cond(
        ((current.len() == usize(0)) && (deferred.len() == usize(0))) => {
          break;
        },
        true => ()
      );
      // Process each thread (priority order — first match wins in gen)
      (found_match_in_gen : bool) = false;
      t := usize(0);
      while((t < current.len()) && !found_match_in_gen, t = (t + usize(1)), {
        thread := current(t);
        instr := self._program.instructions(thread.pc);
        match(
          instr.kind,
          .Char => {
            cond(
              (!at_end && self._char_matches(instr.codepoint, cur_cp)) => {
                new_thread := thread.fork(thread.pc + usize(1));
                self._add_thread(next, new_thread, byte_pos + char_byte_len, next_seen);
              },
              true => ()
            );
          },
          .AnyChar => {
            cond(
              !at_end => {
                should_match := cond(
                  self._flags.dot_all => true,
                  true => (cur_cp != u32(10))
                );
                cond(
                  should_match => {
                    new_thread := thread.fork(thread.pc + usize(1));
                    self._add_thread(next, new_thread, byte_pos + char_byte_len, next_seen);
                  },
                  true => ()
                );
              },
              true => ()
            );
          },
          .CharClass => {
            cond(
              !at_end => {
                class_opt := self._program.classes.get(instr.class_idx);
                match(
                  class_opt,
                  .Some(cls) => {
                    cond(
                      self._codepoint_in_class(cur_cp, cls) => {
                        new_thread := thread.fork(thread.pc + usize(1));
                        self._add_thread(next, new_thread, byte_pos + char_byte_len, next_seen);
                      },
                      true => ()
                    );
                  },
                  .None => ()
                );
              },
              true => ()
            );
          },
          .Backref => {
            group_start_slot := (instr.slot * usize(2));
            group_end_slot := ((instr.slot * usize(2)) + usize(1));
            cond(
              ((group_start_slot < thread.slots.len()) && (group_end_slot < thread.slots.len())) => {
                gs := thread.slots(group_start_slot);
                ge := thread.slots(group_end_slot);
                cond(
                  ((gs != unset) && (ge != unset)) => {
                    captured_len := (ge - gs);
                    cond(
                      ((byte_pos + captured_len) <= input_len) => {
                        // Compare captured bytes against input at current position
                        (bytes_match : bool) = true;
                        bi := usize(0);
                        while(bi < captured_len, bi = (bi + usize(1)), {
                          expected := self._bytes(gs + bi);
                          actual := self._bytes(byte_pos + bi);
                          cond(
                            self._flags.ignore_case => {
                              el := cond(
                                ((expected >= u8(65)) && (expected <= u8(90))) => (expected + u8(32)),
                                true => expected
                              );
                              al := cond(
                                ((actual >= u8(65)) && (actual <= u8(90))) => (actual + u8(32)),
                                true => actual
                              );
                              cond(
                                (el != al) => {
                                  bytes_match = false;
                                },
                                true => ()
                              );
                            },
                            true => {
                              cond(
                                (expected != actual) => {
                                  bytes_match = false;
                                },
                                true => ()
                              );
                            }
                          );
                        });
                        cond(
                          bytes_match => {
                            new_pos := (byte_pos + captured_len);
                            new_thread := thread.fork(thread.pc + usize(1));
                            cond(
                              (captured_len == usize(0)) => {
                                // Empty capture — epsilon-like, process in current gen
                                self._add_thread(current, new_thread, byte_pos, seen);
                              },
                              true => {
                                // Defer to the target byte position
                                deferred.push(DeferredThread(target_byte_pos : new_pos, thread : new_thread));
                              }
                            );
                          },
                          true => ()
                        );
                      },
                      true => ()
                    );
                  },
                  true => ()
                );
              },
              true => ()
            );
          },
          .Lookahead => {
            // Zero-width assertion: run sub-VM at current position
            sub_start := instr.target_a;
            positive := (instr.slot == usize(1));
            sub_matched := self._run_sub_vm(sub_start, byte_pos, unset);
            cond(
              (sub_matched == positive) => {
                sub_end := instr.target_b;
                new_thread := thread.fork(sub_end);
                self._add_thread(current, new_thread, byte_pos, seen);
              },
              true => ()
            );
          },
          .Lookbehind => {
            // Zero-width assertion: check if sub-pattern matches ending at current position
            sub_start := instr.target_a;
            positive := (instr.slot == usize(1));
            (lb_matched : bool) = false;
            // Try each byte position backwards from byte_pos
            cond(
              (byte_pos == usize(0)) => {
                // Only try empty match at position 0
                cond(
                  self._run_sub_vm(sub_start, usize(0), usize(0)) => {
                    lb_matched = true;
                  },
                  true => ()
                );
              },
              true => {
                // Try from byte_pos backwards to 0
                (try_pos : usize) = byte_pos;
                while(!lb_matched, {
                  cond(
                    (try_pos == usize(0)) => {
                      cond(
                        self._run_sub_vm(sub_start, usize(0), byte_pos) => {
                          lb_matched = true;
                        },
                        true => ()
                      );
                      break;
                    },
                    true => {
                      try_pos = (try_pos - usize(1));
                      // Skip UTF-8 continuation bytes (10xxxxxx)
                      cond(
                        (try_pos > usize(0)) => {
                          tb := self._bytes(try_pos);
                          while(utf8.is_continuation(tb) && (try_pos > usize(0)), {
                            try_pos = (try_pos - usize(1));
                            tb = self._bytes(try_pos);
                          });
                        },
                        true => ()
                      );
                      cond(
                        self._run_sub_vm(sub_start, try_pos, byte_pos) => {
                          lb_matched = true;
                        },
                        true => ()
                      );
                    }
                  );
                });
              }
            );
            cond(
              (lb_matched == positive) => {
                sub_end := instr.target_b;
                new_thread := thread.fork(sub_end);
                self._add_thread(current, new_thread, byte_pos, seen);
              },
              true => ()
            );
          },
          .Match => {
            // Record match and kill lower-priority threads
            best_match = VmMatch(matched : true, slots : thread.slots);
            found_match_in_gen = true;
          },
          _ => ()
        );
      });
      // Swap current/next and clear for reuse
      tmp_c := current;
      current = next;
      next = tmp_c;
      next.clear();
      cond(
        at_end => {
          break;
        },
        true => {
          byte_pos = (byte_pos + char_byte_len);
        }
      );
    });
    // Store seen buffers back for reuse in next exec_at call
    self._seen = seen;
    self._next_seen = next_seen;
    best_match
  })
);
export(NfaVm);
