//! Regex pattern parser — parses a regex pattern string into an AST
//! of `RegexNode` objects. Uses an iterative stack-based approach.
//!
//! **Internal to `std/regex`.** Nothing here is public API: import
//! `std/regex` and use `Regex`. This module's shape changes freely — the one
//! piece of it users see is `RegexError`, which `std/regex` re-exports.
open(import("std/collections/array_list"));
open(import("std/string"));
{ RegexNode, CharRange, GroupNameEntry } :: import("./node.yo");
{ unicode_property_ranges } :: import("./unicode.yo");
{ RegexError } :: import("./error.yo");
utf8 :: import("../encoding/utf8.yo");
// A parse frame for tracking alternation/sequence state
ParseFrame :: struct(
  alternatives : ArrayList(ArrayList(RegexNode)),
  current : ArrayList(RegexNode),
  is_non_capturing : bool,
  group_index : usize,
  is_lookahead : bool,
  is_lookbehind : bool,
  is_positive : bool
);
// Parser state object
RegexParser :: ref(
  struct(
    _source : String,
    _bytes : ArrayList(u8),
    _pos : usize,
    _group_count : usize,
    _group_names : ArrayList(GroupNameEntry)
  )
);
// First impl block: utility + leaf parsers (defined bottom-up)
impl(
  RegexParser,
  new : (fn(pattern : String) -> Self)(
    Self(
      _source : pattern,
      _bytes : pattern.as_bytes(),
      _pos : usize(0),
      _group_count : usize(0),
      _group_names : ArrayList(GroupNameEntry).new()
    )
  ),
  _peek : (fn(self : Self) -> Option(u8))(
    cond(
      (self._pos < self._bytes.len()) => self._bytes.get(self._pos),
      true => .None
    )
  ),
  _advance : (fn(self : Self) -> Option(u8))({
    cond(
      (self._pos >= self._bytes.len()) => {
        return(.None);
      },
      true => ()
    );
    b := self._bytes.get(self._pos);
    self._pos = (self._pos + usize(1));
    b
  }),
  // Decode a full UTF-8 codepoint given the first byte (already consumed by
  // _advance), and leave _pos just past the sequence.
  //
  // Tolerant by contract, like the VM's decoder: a malformed pattern byte
  // becomes U+FFFD and consumes exactly one byte. The old hand-rolled version
  // read `_bytes(self._pos + k)` unconditionally and indexed past the end on a
  // truncated tail.
  _read_codepoint : (fn(self : Self, first : u8) -> u32)({
    start := (self._pos - usize(1));
    d := utf8.decode_lossy(self._bytes, start);
    self._pos = (start + d.width);
    d.code.to_u32()
  }),
  _at_end : (fn(self : Self) -> bool)(
    self._pos >= self._bytes.len()
  ),
  group_count : (fn(self : Self) -> usize)(
    self._group_count
  ),
  group_names : (fn(self : Self) -> ArrayList(GroupNameEntry))(
    self._group_names
  ),
  _lookup_group_name : (fn(self : Self, name : String) -> Option(usize))({
    i := usize(0);
    while(i < self._group_names.len(), i = (i + usize(1)), {
      entry := self._group_names(i);
      cond(
        (entry.name == name) => {
          return(.Some(entry.index));
        },
        true => ()
      );
    });
    .None
  }),
  _escape_char_codepoint : (fn(self : Self, ch : u8) -> u32)(
    cond(
      (ch == u8(110)) => u32(10),
      (ch == u8(116)) => u32(9),
      (ch == u8(114)) => u32(13),
      (ch == u8(102)) => u32(12),
      (ch == u8(118)) => u32(11),
      (ch == u8(48)) => u32(0),
      true => u32(ch)
    )
  ),
  _parse_number : (fn(self : Self) -> Option(usize))({
    start := self._pos;
    while(!(self._at_end()), {
      pk := self._peek();
      is_digit := match(
        pk,
        .Some(b) => ((b >= u8(48)) && (b <= u8(57))),
        .None => false
      );
      cond(
        is_digit => {
          self._pos = (self._pos + usize(1));
        },
        true => {
          break;
        }
      );
    });
    cond(
      (self._pos == start) => {
        return(.None);
      },
      true => ()
    );
    result := usize(0);
    i := start;
    while(i < self._pos, i = (i + usize(1)), {
      d := self._bytes(i);
      result = ((result * usize(10)) + usize(d - u8(48)));
    });
    .Some(result)
  }),
  _parse_greedy_modifier : (fn(self : Self) -> bool)({
    pk := self._peek();
    is_question := match(
      pk,
      .Some(b) => (b == u8(63)),
      .None => false
    );
    cond(
      is_question => {
        self._pos = (self._pos + usize(1));
        return(false);
      },
      true => ()
    );
    true
  }),
  _make_digit_ranges : (fn(self : Self) -> ArrayList(CharRange))({
    r := ArrayList(CharRange).new();
    r.push(CharRange(low : u32(48), high : u32(57)));
    r
  }),
  _make_word_ranges : (fn(self : Self) -> ArrayList(CharRange))({
    r := ArrayList(CharRange).new();
    r.push(CharRange(low : u32(48), high : u32(57)));
    r.push(CharRange(low : u32(65), high : u32(90)));
    r.push(CharRange(low : u32(95), high : u32(95)));
    r.push(CharRange(low : u32(97), high : u32(122)));
    r
  }),
  _make_space_ranges : (fn(self : Self) -> ArrayList(CharRange))({
    r := ArrayList(CharRange).new();
    r.push(CharRange(low : u32(9), high : u32(13)));
    r.push(CharRange(low : u32(32), high : u32(32)));
    r
  }),
  // Parse \xHH hex unwind — reads exactly 2 hex digits and returns the codepoint.
  _parse_hex_byte : (fn(self : Self) -> Option(u32))({
    if((self._pos + usize(2)) > self._bytes.len(), {
      return(.None);
    });
    (h1 : u8) = self._bytes(self._pos);
    (h2 : u8) = self._bytes(self._pos + usize(1));
    (v1 : i32) = cond(
      ((h1 >= u8(48)) && (h1 <= u8(57))) => (i32(h1) - i32(48)),
      ((h1 >= u8(65)) && (h1 <= u8(70))) => ((i32(h1) - i32(65)) + i32(10)),
      ((h1 >= u8(97)) && (h1 <= u8(102))) => ((i32(h1) - i32(97)) + i32(10)),
      true => {
        return(.None);
      }
    );
    (v2 : i32) = cond(
      ((h2 >= u8(48)) && (h2 <= u8(57))) => (i32(h2) - i32(48)),
      ((h2 >= u8(65)) && (h2 <= u8(70))) => ((i32(h2) - i32(65)) + i32(10)),
      ((h2 >= u8(97)) && (h2 <= u8(102))) => ((i32(h2) - i32(97)) + i32(10)),
      true => {
        return(.None);
      }
    );
    self._pos = (self._pos + usize(2));
    .Some(u32((v1 << i32(4)) | v2))
  }),
  _parse_class_unwind : (fn(self : Self) -> Result(ArrayList(CharRange), RegexError))({
    b := self._advance();
    match(
      b,
      .Some(ch) =>
        cond(
          (ch == u8(100)) => .Ok(self._make_digit_ranges()),
          (ch == u8(68)) => {
            r := ArrayList(CharRange).new();
            r.push(CharRange(low : u32(0), high : u32(47)));
            r.push(CharRange(low : u32(58), high : u32(0x10FFFF)));
            .Ok(r)
          },
          (ch == u8(119)) => .Ok(self._make_word_ranges()),
          (ch == u8(87)) => {
            r := ArrayList(CharRange).new();
            r.push(CharRange(low : u32(0), high : u32(47)));
            r.push(CharRange(low : u32(58), high : u32(64)));
            r.push(CharRange(low : u32(91), high : u32(94)));
            r.push(CharRange(low : u32(96), high : u32(96)));
            r.push(CharRange(low : u32(123), high : u32(0x10FFFF)));
            .Ok(r)
          },
          (ch == u8(115)) => .Ok(self._make_space_ranges()),
          (ch == u8(83)) => {
            r := ArrayList(CharRange).new();
            r.push(CharRange(low : u32(0), high : u32(8)));
            r.push(CharRange(low : u32(14), high : u32(31)));
            r.push(CharRange(low : u32(33), high : u32(0x10FFFF)));
            .Ok(r)
          },
          (ch == u8(120)) => {
            r := ArrayList(CharRange).new();
            match(
              self._parse_hex_byte(),
              .Some(v) => r.push(CharRange(low : v, high : v)),
              .None => r.push(CharRange(low : u32(ch), high : u32(ch)))
            );
            .Ok(r)
          },
          true => {
            r := ArrayList(CharRange).new();
            codepoint := self._escape_char_codepoint(ch);
            r.push(CharRange(low : codepoint, high : codepoint));
            .Ok(r)
          }
        ),
      .None => .Err(RegexError.TrailingBackslash(self._pos))
    )
  }),
  _try_parse_char_range : (fn(self : Self, ranges : ArrayList(CharRange), low : u32) -> unit)({
    pk3 := self._peek();
    is_dash := match(
      pk3,
      .Some(b2) => (b2 == u8(45)),
      .None => false
    );
    cond(
      is_dash => {
        has_end := ((self._pos + usize(1)) < self._bytes.len());
        cond(
          has_end => {
            end_first := self._bytes(self._pos + usize(1));
            cond(
              (end_first == u8(93)) => {
                ranges.push(CharRange(low : low, high : low));
              },
              (end_first == u8(92)) => {
                // High end is an escape sequence (e.g. \x20, \0, \n)
                self._pos = (self._pos + usize(1));
                self._pos = (self._pos + usize(1));
                esc := self._parse_class_unwind();
                match(
                  esc,
                  .Ok(esc_ranges) => {
                    if((esc_ranges.len() == usize(1)) && (esc_ranges(usize(0)).low == esc_ranges(usize(0)).high), {
                      (high : u32) = esc_ranges(usize(0)).low;
                      ranges.push(CharRange(low : low, high : high));
                    }, {
                      // Multi-range unwind like \d can't be range endpoint; treat dash as literal
                      ranges.push(CharRange(low : low, high : low));
                      ranges.push(CharRange(low : u32(45), high : u32(45)));
                      j := usize(0);
                      while(j < esc_ranges.len(), j = (j + usize(1)), {
                        ranges.push(esc_ranges(j));
                      });
                    });
                  },
                  .Err(_e) => {
                    ranges.push(CharRange(low : low, high : low));
                  }
                );
              },
              true => {
                // Consume dash
                self._pos = (self._pos + usize(1));
                // Consume first byte of end char
                self._pos = (self._pos + usize(1));
                // Decode full codepoint (reads continuation bytes)
                end_cp := self._read_codepoint(end_first);
                ranges.push(CharRange(low : low, high : end_cp));
              }
            );
          },
          true => {
            ranges.push(CharRange(low : low, high : low));
          }
        );
      },
      true => {
        ranges.push(CharRange(low : low, high : low));
      }
    );
  }),
  _parse_char_class_content : (fn(self : Self, ranges : ArrayList(CharRange)) -> Result(unit, RegexError))({
    pk2 := self._peek();
    b := match(
      pk2,
      .Some(v) => v,
      .None => {
        return(.Err(RegexError.UnterminatedCharClass(self._pos)));
      }
    );
    cond(
      (b == u8(93)) => {
        return(.Ok(()));
      },
      (b == u8(92)) => {
        self._pos = (self._pos + usize(1));
        esc := self._parse_class_unwind();
        match(
          esc,
          .Ok(esc_ranges) => {
            // If unwind produced a single codepoint, check for range (e.g. \0-\x20)
            if((esc_ranges.len() == usize(1)) && (esc_ranges(usize(0)).low == esc_ranges(usize(0)).high), {
              (low : u32) = esc_ranges(usize(0)).low;
              self._try_parse_char_range(ranges, low);
            }, {
              j := usize(0);
              while(j < esc_ranges.len(), j = (j + usize(1)), {
                ranges.push(esc_ranges(j));
              });
            });
          },
          .Err(e) => {
            return(.Err(e));
          }
        );
      },
      true => {
        self._pos = (self._pos + usize(1));
        low := self._read_codepoint(b);
        self._try_parse_char_range(ranges, low);
      }
    );
    .Ok(())
  }),
  _parse_char_class : (fn(self : Self) -> Result(RegexNode, RegexError))({
    ranges := ArrayList(CharRange).new();
    negated := false;
    // Check for negation '^'
    pk := self._peek();
    is_neg := match(
      pk,
      .Some(b) => (b == u8(94)),
      .None => false
    );
    cond(
      is_neg => {
        negated = true;
        self._pos = (self._pos + usize(1));
      },
      true => ()
    );
    // Parse class contents until ']'
    while(!(self._at_end()), {
      pk2 := self._peek();
      found_end := match(
        pk2,
        .Some(b) => (b == u8(93)),
        .None => false
      );
      cond(
        found_end => {
          self._pos = (self._pos + usize(1));
          return(.Ok(RegexNode.char_class(ranges, negated)));
        },
        true => ()
      );
      result := self._parse_char_class_content(ranges);
      match(
        result,
        .Ok(_) => (),
        .Err(e) => {
          return(.Err(e));
        }
      );
    });
    .Err(RegexError.UnterminatedCharClass(self._pos))
  }),
  // Parse \p{PropertyName} or \P{PropertyName} unicode property unwind.
  // negated=true for \P (inverted match).
  _parse_unicode_property : (fn(self : Self, negated : bool) -> Result(RegexNode, RegexError))({
    // Expect opening '{'
    pk := self._peek();
    is_brace := match(
      pk,
      .Some(v) => (v == u8(123)),
      .None => false
    );
    cond(
      (!(is_brace)) => {
        return(.Err(RegexError.InvalidUnicodeProperty(self._pos)));
      },
      true => ()
    );
    self._pos = (self._pos + usize(1));
    // Read property name until '}'
    name_bytes := ArrayList(u8).new();
    while(!(self._at_end()), {
      nb := self._peek();
      nb_val := match(
        nb,
        .Some(v) => v,
        .None => {
          break;
        }
      );
      cond(
        (nb_val == u8(125)) => {
          self._pos = (self._pos + usize(1));
          name_str := String.from_bytes(name_bytes);
          lookup := unicode_property_ranges(name_str);
          return(
            match(
              lookup,
              .Some(ranges) => .Ok(RegexNode.char_class(ranges, negated)),
              .None => .Err(RegexError.UnknownUnicodeProperty(name_str, self._pos))
            )
          );
        },
        true => {
          name_bytes.push(nb_val);
          self._pos = (self._pos + usize(1));
        }
      );
    });
    .Err(RegexError.InvalidUnicodeProperty(self._pos))
  }),
  _parse_unwind : (fn(self : Self) -> Result(RegexNode, RegexError))({
    b := self._advance();
    match(
      b,
      .Some(ch) =>
        cond(
          (ch == u8(100)) => .Ok(RegexNode.char_class(self._make_digit_ranges(), false)),
          (ch == u8(68)) => .Ok(RegexNode.char_class(self._make_digit_ranges(), true)),
          (ch == u8(119)) => .Ok(RegexNode.char_class(self._make_word_ranges(), false)),
          (ch == u8(87)) => .Ok(RegexNode.char_class(self._make_word_ranges(), true)),
          (ch == u8(115)) => .Ok(RegexNode.char_class(self._make_space_ranges(), false)),
          (ch == u8(83)) => .Ok(RegexNode.char_class(self._make_space_ranges(), true)),
          (ch == u8(98)) => .Ok(RegexNode.anchor_node(.WordBoundary)),
          (ch == u8(66)) => .Ok(RegexNode.anchor_node(.NonWordBoundary)),
          // Numeric backreference \1 through \9
          ((ch >= u8(49)) && (ch <= u8(57))) => {
            group_idx := usize(ch - u8(48));
            cond(
              (group_idx > self._group_count) =>
                .Err(RegexError.InvalidBackreference(group_idx, self._pos)),
              true => .Ok(RegexNode.backreference(group_idx))
            )
          },
          // Named backreference \k<name>
          (ch == u8(107)) => {
            pk := self._peek();
            is_lt := match(
              pk,
              .Some(v) => (v == u8(60)),
              .None => false
            );
            cond(
              (!(is_lt)) => {
                return(.Err(RegexError.InvalidNamedBackreference(self._pos)));
              },
              true => ()
            );
            self._pos = (self._pos + usize(1));
            name_bytes := ArrayList(u8).new();
            while(!(self._at_end()), {
              nb := self._peek();
              nb_val := match(
                nb,
                .Some(v) => v,
                .None => {
                  break;
                }
              );
              cond(
                (nb_val == u8(62)) => {
                  self._pos = (self._pos + usize(1));
                  name_str := String.from_bytes(name_bytes);
                  lookup := self._lookup_group_name(name_str);
                  return(
                    match(
                      lookup,
                      .Some(idx) => .Ok(RegexNode.backreference(idx)),
                      .None => .Err(RegexError.UnknownGroupName(name_str, self._pos))
                    )
                  );
                },
                true => {
                  name_bytes.push(nb_val);
                  self._pos = (self._pos + usize(1));
                }
              );
            });
            .Err(RegexError.InvalidNamedBackreference(self._pos))
          },
          // Unicode property \p{Name}
          (ch == u8(112)) => self._parse_unicode_property(false),
          // Negated unicode property \P{Name}
          (ch == u8(80)) => self._parse_unicode_property(true),
          // Hex unwind \xHH
          (ch == u8(120)) => match(
            self._parse_hex_byte(),
            .Some(v) => .Ok(RegexNode.literal(v)),
            .None => .Ok(RegexNode.literal(u32(ch)))
          ),
          true => .Ok(RegexNode.literal(self._escape_char_codepoint(ch)))
        ),
      .None => .Err(RegexError.TrailingBackslash(self._pos))
    )
  }),
  _parse_counted_quantifier : (fn(self : Self, atom : RegexNode) -> Result(RegexNode, RegexError))({
    self._pos = (self._pos + usize(1));
    min_opt := self._parse_number();
    mn := match(
      min_opt,
      .Some(v) => v,
      .None => {
        return(.Err(RegexError.InvalidQuantifier(self._pos)));
      }
    );
    pk := self._peek();
    b := match(
      pk,
      .Some(v) => v,
      .None => {
        return(.Err(RegexError.UnexpectedEnd(self._pos)));
      }
    );
    cond(
      (b == u8(125)) => {
        // {n}
        self._pos = (self._pos + usize(1));
        greedy := self._parse_greedy_modifier();
        return(.Ok(RegexNode.quantifier(atom, mn, mn, greedy)));
      },
      (b != u8(44)) => {
        return(.Err(RegexError.InvalidQuantifier(self._pos)));
      },
      true => ()
    );
    // Consume ','
    self._pos = (self._pos + usize(1));
    pk2 := self._peek();
    b2 := match(
      pk2,
      .Some(v) => v,
      .None => {
        return(.Err(RegexError.UnexpectedEnd(self._pos)));
      }
    );
    cond(
      (b2 == u8(125)) => {
        // {n,} — unbounded
        self._pos = (self._pos + usize(1));
        greedy := self._parse_greedy_modifier();
        return(.Ok(RegexNode.quantifier(atom, mn, usize(0), greedy)));
      },
      true => ()
    );
    // {n,m}
    max_opt := self._parse_number();
    mx := match(
      max_opt,
      .Some(v) => v,
      .None => {
        return(.Err(RegexError.InvalidQuantifier(self._pos)));
      }
    );
    pk3 := self._peek();
    b3 := match(
      pk3,
      .Some(v) => v,
      .None => {
        return(.Err(RegexError.UnexpectedEnd(self._pos)));
      }
    );
    cond(
      (b3 != u8(125)) => {
        return(.Err(RegexError.InvalidQuantifier(self._pos)));
      },
      true => ()
    );
    self._pos = (self._pos + usize(1));
    cond(
      (mx < mn) => {
        return(.Err(RegexError.QuantifierOutOfOrder(mn, mx, self._pos)));
      },
      true => ()
    );
    greedy := self._parse_greedy_modifier();
    .Ok(RegexNode.quantifier(atom, mn, mx, greedy))
  }),
  _parse_atom : (fn(self : Self) -> Result(RegexNode, RegexError))({
    b := self._advance();
    match(
      b,
      .Some(ch) =>
        cond(
          (ch == u8(46)) => .Ok(RegexNode.dot()),
          (ch == u8(94)) => .Ok(RegexNode.anchor_node(.Start)),
          (ch == u8(36)) => .Ok(RegexNode.anchor_node(.End)),
          (ch == u8(91)) => self._parse_char_class(),
          (ch == u8(92)) => self._parse_unwind(),
          true => .Ok(RegexNode.literal(self._read_codepoint(ch)))
        ),
      .None => .Err(RegexError.UnexpectedEnd(self._pos))
    )
  }),
  _maybe_quantify : (fn(self : Self, a : RegexNode) -> Result(RegexNode, RegexError))({
    pk := self._peek();
    b := match(
      pk,
      .Some(v) => v,
      .None => {
        return(.Ok(a));
      }
    );
    cond(
      (b == u8(42)) => {
        self._pos = (self._pos + usize(1));
        greedy := self._parse_greedy_modifier();
        .Ok(RegexNode.quantifier(a, usize(0), usize(0), greedy))
      },
      (b == u8(43)) => {
        self._pos = (self._pos + usize(1));
        greedy := self._parse_greedy_modifier();
        .Ok(RegexNode.quantifier(a, usize(1), usize(0), greedy))
      },
      (b == u8(63)) => {
        self._pos = (self._pos + usize(1));
        greedy := self._parse_greedy_modifier();
        .Ok(RegexNode.quantifier(a, usize(0), usize(1), greedy))
      },
      (b == u8(123)) => self._parse_counted_quantifier(a),
      true => .Ok(a)
    )
  }),
  _parse_quantified : (fn(self : Self) -> Result(RegexNode, RegexError))({
    atom := self._parse_atom();
    match(
      atom,
      .Ok(a) => self._maybe_quantify(a),
      .Err(e) => .Err(e)
    )
  })
);
// Second impl block: helper methods first, then main parse loop
impl(
  RegexParser,
  _make_sequence : (fn(self : Self, nodes : ArrayList(RegexNode)) -> RegexNode)(
    cond(
      (nodes.len() == usize(0)) => RegexNode.sequence(ArrayList(RegexNode).new()),
      (nodes.len() == usize(1)) => nodes(usize(0)),
      true => RegexNode.sequence(nodes)
    )
  ),
  _finalize_frame : (fn(self : Self, alts : ArrayList(ArrayList(RegexNode)), seq : ArrayList(RegexNode)) -> RegexNode)({
    cond(
      (alts.len() == usize(0)) => {
        return(self._make_sequence(seq));
      },
      true => ()
    );
    alts.push(seq);
    result := self._make_sequence(alts(usize(0)));
    i := usize(1);
    while(i < alts.len(), i = (i + usize(1)), {
      right := self._make_sequence(alts(i));
      result = RegexNode.alternation(result, right);
    });
    result
  }),
  parse : (fn(self : Self) -> Result(RegexNode, RegexError))({
    stack := ArrayList(ParseFrame).new();
    cur_alts := ArrayList(ArrayList(RegexNode)).new();
    cur_seq := ArrayList(RegexNode).new();
    cur_non_cap := false;
    cur_group_idx := usize(0);
    cur_is_la := false;
    cur_is_lb := false;
    cur_is_pos := true;
    while(!(self._at_end()), {
      pk := self._peek();
      b := match(
        pk,
        .Some(v) => v,
        .None => {
          break;
        }
      );
      cond(
        (b == u8(40)) => {
          // '(' — open group
          self._pos = (self._pos + usize(1));
          stack.push(
            ParseFrame(
              alternatives : cur_alts,
              current : cur_seq,
              is_non_capturing : cur_non_cap,
              group_index : cur_group_idx,
              is_lookahead : cur_is_la,
              is_lookbehind : cur_is_lb,
              is_positive : cur_is_pos
            )
          );
          // Detect group type: (?:  (?<name>  (?=  (?!  (?<=  (?<!
          is_nc := false;
          g_idx := usize(0);
          is_la := false;
          is_lb := false;
          is_pos := true;
          pk2 := self._peek();
          is_question := match(
            pk2,
            .Some(v) => (v == u8(63)),
            .None => false
          );
          cond(
            is_question => {
              has_next := ((self._pos + usize(1)) < self._bytes.len());
              cond(
                has_next => {
                  nb := self._bytes.get(self._pos + usize(1));
                  next_ch := match(
                    nb,
                    .Some(v) => v,
                    .None => u8(0)
                  );
                  cond(
                    // (?:  — non-capturing group
                    (next_ch == u8(58)) => {
                      is_nc = true;
                      self._pos = (self._pos + usize(2));
                    },
                    // (?=  — positive lookahead
                    (next_ch == u8(61)) => {
                      is_la = true;
                      is_pos = true;
                      is_nc = true;
                      self._pos = (self._pos + usize(2));
                    },
                    // (?!  — negative lookahead
                    (next_ch == u8(33)) => {
                      is_la = true;
                      is_pos = false;
                      is_nc = true;
                      self._pos = (self._pos + usize(2));
                    },
                    // (?< — could be lookbehind or named group
                    (next_ch == u8(60)) => {
                      // Check char after '<'
                      has_third := ((self._pos + usize(2)) < self._bytes.len());
                      third_ch := cond(
                        has_third => match(
                          self._bytes.get(self._pos + usize(2)),
                          .Some(v) => v,
                          .None => u8(0)
                        ),
                        true => u8(0)
                      );
                      cond(
                        // (?<=  — positive lookbehind
                        (third_ch == u8(61)) => {
                          is_lb = true;
                          is_pos = true;
                          is_nc = true;
                          self._pos = (self._pos + usize(3));
                        },
                        // (?<!  — negative lookbehind
                        (third_ch == u8(33)) => {
                          is_lb = true;
                          is_pos = false;
                          is_nc = true;
                          self._pos = (self._pos + usize(3));
                        },
                        // (?<name>  — named capturing group
                        true => {
                          self._pos = (self._pos + usize(2));
                          name_bytes := ArrayList(u8).new();
                          while(!(self._at_end()), {
                            name_b := self._peek();
                            name_ch := match(
                              name_b,
                              .Some(v) => v,
                              .None => {
                                break;
                              }
                            );
                            cond(
                              (name_ch == u8(62)) => {
                                self._pos = (self._pos + usize(1));
                                break;
                              },
                              true => {
                                name_bytes.push(name_ch);
                                self._pos = (self._pos + usize(1));
                              }
                            );
                          });
                          self._group_count = (self._group_count + usize(1));
                          g_idx = self._group_count;
                          group_name := String.from_bytes(name_bytes);
                          self._group_names.push(GroupNameEntry(name : group_name, index : g_idx));
                        }
                      );
                    },
                    true => ()
                  );
                },
                true => ()
              );
            },
            true => ()
          );
          cond(
            (((!(is_nc)) && (!(is_la))) && ((!(is_lb)) && (g_idx == usize(0)))) => {
              self._group_count = (self._group_count + usize(1));
              g_idx = self._group_count;
            },
            true => ()
          );
          cur_alts = ArrayList(ArrayList(RegexNode)).new();
          cur_seq = ArrayList(RegexNode).new();
          cur_non_cap = is_nc;
          cur_group_idx = g_idx;
          cur_is_la = is_la;
          cur_is_lb = is_lb;
          cur_is_pos = is_pos;
        },
        (b == u8(41)) => {
          // ')' — close group
          self._pos = (self._pos + usize(1));
          cond(
            (stack.len() == usize(0)) => {
              return(.Err(RegexError.UnmatchedCloseParen(self._pos)));
            },
            true => ()
          );
          inner := self._finalize_frame(cur_alts, cur_seq);
          // Save this group's type before restoring parent frame
          this_is_la := cur_is_la;
          this_is_lb := cur_is_lb;
          group_node := cond(
            cur_is_la => RegexNode.lookahead(inner, cur_is_pos),
            cur_is_lb => RegexNode.lookbehind(inner, cur_is_pos),
            cur_non_cap => RegexNode.non_capturing_group(inner),
            true => RegexNode.group(inner, cur_group_idx)
          );
          parent := stack(stack.len() - usize(1));
          stack.pop();
          cur_alts = parent.alternatives;
          cur_seq = parent.current;
          cur_non_cap = parent.is_non_capturing;
          cur_group_idx = parent.group_index;
          cur_is_la = parent.is_lookahead;
          cur_is_lb = parent.is_lookbehind;
          cur_is_pos = parent.is_positive;
          // Lookahead/lookbehind should not be quantified
          cond(
            (this_is_la || this_is_lb) => {
              cur_seq.push(group_node);
            },
            true => {
              quantified := self._maybe_quantify(group_node);
              match(
                quantified,
                .Ok(q) => {
                  cur_seq.push(q);
                },
                .Err(e) => {
                  return(.Err(e));
                }
              );
            }
          );
        },
        (b == u8(124)) => {
          // '|' — alternation
          self._pos = (self._pos + usize(1));
          cur_alts.push(cur_seq);
          cur_seq = ArrayList(RegexNode).new();
        },
        true => {
          atom := self._parse_quantified();
          match(
            atom,
            .Ok(a) => {
              cur_seq.push(a);
            },
            .Err(e) => {
              return(.Err(e));
            }
          );
        }
      );
    });
    cond(
      (stack.len() > usize(0)) => {
        return(.Err(RegexError.UnterminatedGroup(self._pos)));
      },
      true => ()
    );
    result := self._finalize_frame(cur_alts, cur_seq);
    .Ok(result)
  })
);
export(RegexParser);
