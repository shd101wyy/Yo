//! Immutable, thread-safe UTF-8 string type.
//!
//! Uses atomic reference counting for safe sharing across threads.
//! All "modification" operations return a new string; the original is unchanged.
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator } :: import("../allocator.yo");
{ ArrayList } :: import("../collections/array_list.yo");
{ malloc, free } :: GlobalAllocator;
{ memcpy, memcmp } :: import("../libc/string.yo");
{ rune } :: import("../string/rune.yo");
utf8 :: import("../encoding/utf8.yo");
std_string :: import("../string");
{ ToString } :: import("../fmt/to_string.yo");
imm_list :: import("./list.yo");
_min :: (fn(a : usize, b : usize) -> usize)(
  cond((a < b) => a, true => b)
);
_alloc_bytes :: (fn(n : usize) -> *(u8))(
  match(
    malloc(n),
    .Some(p) => *(u8)(p),
    .None => __yo_panic("imm.String: allocation failed")
  )
);
/// Immutable, thread-safe UTF-8 string.
///
/// Uses atomic RC — cheap to clone, safe to share across threads.
/// No mutable operations. All "modification" methods return a new String.
///
/// Empty strings are zero-allocation (null pointer, zero length).
String :: atomic(
  ref(
    struct(
      _ptr : ?(*(u8)),
      _len : usize,
      _capacity : usize
    )
  )
);
impl(
  String,
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      match(
        self._ptr,
        .Some(p) => free(.Some(*(void)(p))),
        .None => ()
      );
    })
  )
);
impl(
  String,
  /// Create a new empty string (zero allocation).
  new : (fn() -> Self)(
    Self(_ptr : .None, _len : usize(0), _capacity : usize(0))
  ),
  /// Create a string from a `str` slice (copies the bytes).
  from : (fn(s : str) -> Self)({
    slen := s.len();
    if(slen == usize(0), {
      return(Self(_ptr : .None, _len : usize(0), _capacity : usize(0)));
    });
    ptr := _alloc_bytes(slen);
    unsafe(memcpy(*(void)(ptr), *(void)(s.ptr()), slen));
    return(Self(_ptr : .Some(ptr), _len : slen, _capacity : slen));
  }),
  /// Create a string from a standard (mutable) String by copying its bytes.
  from_string : (fn(s : std_string.String) -> Self)({
    slen := s.len();
    if(slen == usize(0), {
      return(Self(_ptr : .None, _len : usize(0), _capacity : usize(0)));
    });
    ptr := _alloc_bytes(slen);
    rb := s.raw_bytes();
    unsafe(memcpy(*(void)(ptr), *(void)(rb.ptr), slen));
    return(Self(_ptr : .Some(ptr), _len : slen, _capacity : slen));
  }),
  /// Number of BYTES in this string's UTF-8 encoding — O(1).
  ///
  /// **BYTE basis**, the unit every index on this type speaks: `slice`,
  /// `index_of`, `byte_at` and `at` all take or return byte offsets, and it
  /// agrees with `std/string`'s `String.len()`, `str.len()` and Rust's
  /// `str::len()`.
  ///
  /// For "how many runes" use `char_len()` (O(n)); to walk runes together with
  /// the byte offset each one starts at, use `char_indices()`.
  /// (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 4 — this returned a RUNE count
  /// before that flip, and a `bytes_len()` alias carried the byte count; the
  /// alias was DELETED with the flip because it had no consumer left.)
  len : (fn(self : Self) -> usize)(
    self._len
  ),
  /// Check if the string is empty.
  is_empty : (fn(self : Self) -> bool)(
    self._len == usize(0)
  ),
  /// Get a `str` view of the string's bytes (zero-copy borrow).
  as_str : (fn(self : Self) -> str)(
    match(
      self._ptr,
      .Some(p) => str.from_raw_parts(p, self._len),
      .None => str.from_raw_parts(*(u8)(""), usize(0))
    )
  ),
  /// Get the byte at a given index, or `.None` if out of bounds.
  byte_at : (fn(self : Self, index : usize) -> Option(u8))(
    cond(
      (index >= self._len) => .None,
      true => match(
        self._ptr,
        .Some(p) => .Some((p.add(index)).*),
        .None => .None
      )
    )
  ),
  /// Concatenate two strings, returning a new string.
  /// Uses COW: if this string has a unique reference and enough capacity,
  /// appends in-place.
  concat : (fn(own(self) : Self, other : Self) -> Self)({
    if(self._len == usize(0), {
      unsafe.drop(self);
      return(other);
    });
    if(other._len == usize(0), {
      return(self);
    });
    new_len := (self._len + other._len);
    if(rc(self) == usize(1), {
      if(new_len <= self._capacity, {
        match(
          other._ptr,
          .Some(op) => match(
            self._ptr,
            .Some(sp) => {
              unsafe(memcpy(*(void)(sp.add(self._len)), *(void)(op), other._len));
            },
            .None => ()
          ),
          .None => ()
        );
        self._len = new_len;
        return(self);
      });
      new_cap := cond(
        (new_len > (self._capacity * usize(2))) => new_len,
        true => (self._capacity * usize(2))
      );
      ptr := _alloc_bytes(new_cap);
      match(
        self._ptr,
        .Some(sp) => {
          unsafe(memcpy(*(void)(ptr), *(void)(sp), self._len));
          free(.Some(*(void)(sp)));
        },
        .None => ()
      );
      match(
        other._ptr,
        .Some(op) => {
          unsafe(memcpy(*(void)(ptr.add(self._len)), *(void)(op), other._len));
        },
        .None => ()
      );
      self._ptr = .Some(ptr);
      self._len = new_len;
      self._capacity = new_cap;
      return(self);
    });
    ptr := _alloc_bytes(new_len);
    match(
      self._ptr,
      .Some(sp) => {
        unsafe(memcpy(*(void)(ptr), *(void)(sp), self._len));
      },
      .None => ()
    );
    match(
      other._ptr,
      .Some(op) => {
        unsafe(memcpy(*(void)(ptr.add(self._len)), *(void)(op), other._len));
      },
      .None => ()
    );
    unsafe.drop(self);
    return(Self(_ptr : .Some(ptr), _len : new_len, _capacity : new_len));
  }),
  /// Extract a byte-range substring [start, end). Returns a new string.
  /// If indices are out of bounds, clamps to valid range.
  slice : (fn(self : Self, start : usize, end : usize) -> Self)({
    (clamped_start : usize) = _min(start, self._len);
    (clamped_end : usize) = _min(end, self._len);
    if(clamped_start >= clamped_end, {
      return(Self.new());
    });
    new_len := (clamped_end - clamped_start);
    ptr := _alloc_bytes(new_len);
    match(
      self._ptr,
      .Some(sp) => {
        unsafe(memcpy(*(void)(ptr), *(void)(sp.add(clamped_start)), new_len));
      },
      .None => ()
    );
    return(Self(_ptr : .Some(ptr), _len : new_len, _capacity : new_len));
  }),
  /// Check if the string starts with a given prefix.
  starts_with : (fn(self : Self, prefix : Self) -> bool)({
    if(prefix._len > self._len, {
      return(false);
    });
    if(prefix._len == usize(0), {
      return(true);
    });
    match(
      self._ptr,
      .Some(sp) => match(
        prefix._ptr,
        .Some(pp) => (unsafe(memcmp(*(void)(sp), *(void)(pp), prefix._len)) == int(0)),
        .None => true
      ),
      .None => (prefix._len == usize(0))
    )
  }),
  /// Check if the string ends with a given suffix.
  ends_with : (fn(self : Self, suffix : Self) -> bool)({
    if(suffix._len > self._len, {
      return(false);
    });
    if(suffix._len == usize(0), {
      return(true);
    });
    offset := (self._len - suffix._len);
    match(
      self._ptr,
      .Some(sp) => match(
        suffix._ptr,
        .Some(xp) => (unsafe(memcmp(*(void)(sp.add(offset)), *(void)(xp), suffix._len)) == int(0)),
        .None => true
      ),
      .None => (suffix._len == usize(0))
    )
  }),
  /// Find the first occurrence of `needle` starting at `from_index`.
  /// Returns byte index or `.None`.
  index_of : (fn(self : Self, needle : Self, from_index : usize) -> Option(usize))({
    if(needle._len == usize(0), {
      return(.Some(from_index));
    });
    if((from_index + needle._len) > self._len, {
      return(.None);
    });
    match(
      self._ptr,
      .None => {
        return(.None);
      },
      .Some(sp) => match(
        needle._ptr,
        .None => {
          return(.Some(from_index));
        },
        .Some(np) => {
          i := from_index;
          limit := ((self._len - needle._len) + usize(1));
          while(i < limit, i = (i + usize(1)), {
            if(unsafe(memcmp(*(void)(sp.add(i)), *(void)(np), needle._len)) == int(0), {
              return(.Some(i));
            });
          });
          return(.None);
        }
      )
    )
  }),
  /// Check if the string contains a given substring.
  contains : (fn(self : Self, needle : Self) -> bool)(
    self.index_of(needle, usize(0)).is_some()
  ),
  /// Split the string by a separator, returning an immutable List of Strings.
  split : (fn(self : Self, sep : Self) -> imm_list.List(String))({
    result := imm_list.List(String).new();
    if(sep._len == usize(0), {
      return(result.prepend(self));
    });
    pos := usize(0);
    segments := imm_list.List(String).new();
    while(runtime(true), {
      match(
        self.index_of(sep, pos),
        .Some(idx) => {
          segments = segments.prepend(self.slice(pos, idx));
          pos = (idx + sep._len);
        },
        .None => {
          segments = segments.prepend(self.slice(pos, self._len));
          return(segments.reverse());
        }
      );
    });
    segments.reverse()
  }),
  /// Check if a byte is ASCII whitespace.
  _is_whitespace : (fn(b : u8) -> bool)(
    (((b == u8(0x20)) || (b == u8(0x09))) || (b == u8(0x0A))) || ((b == u8(0x0D)) || (b == u8(0x0C)))
  ),
  /// Trim leading and trailing ASCII whitespace.
  trim : (fn(self : Self) -> Self)({
    if(self._len == usize(0), {
      return(self);
    });
    match(
      self._ptr,
      .None => {
        return(self);
      },
      .Some(p) => {
        start := usize(0);
        while(
          (start < self._len) && (Self._is_whitespace((p.add(start)).*)),
          start = (start + usize(1)),
          ()
        );
        end := self._len;
        while(
          (end > start) && (Self._is_whitespace((p.add(end - usize(1))).*)),
          end = (end - usize(1)),
          ()
        );
        if((start == usize(0)) && (end == self._len), {
          return(self);
        });
        return(self.slice(start, end));
      }
    )
  }),
  /// Trim leading ASCII whitespace.
  trim_start : (fn(self : Self) -> Self)({
    if(self._len == usize(0), {
      return(self);
    });
    match(
      self._ptr,
      .None => {
        return(self);
      },
      .Some(p) => {
        start := usize(0);
        while(
          (start < self._len) && (Self._is_whitespace((p.add(start)).*)),
          start = (start + usize(1)),
          ()
        );
        if(start == usize(0), {
          return(self);
        });
        return(self.slice(start, self._len));
      }
    )
  }),
  /// Trim trailing ASCII whitespace.
  trim_end : (fn(self : Self) -> Self)({
    if(self._len == usize(0), {
      return(self);
    });
    match(
      self._ptr,
      .None => {
        return(self);
      },
      .Some(p) => {
        end := self._len;
        while(
          (end > usize(0)) && (Self._is_whitespace((p.add(end - usize(1))).*)),
          end = (end - usize(1)),
          ()
        );
        if(end == self._len, {
          return(self);
        });
        return(self.slice(usize(0), end));
      }
    )
  }),
  /// Convert all ASCII uppercase letters to lowercase.
  /// Uses COW: if this string has a unique reference, modifies bytes in-place.
  to_lowercase : (fn(own(self) : Self) -> Self)({
    if(self._len == usize(0), {
      return(self);
    });
    match(
      self._ptr,
      .None => {
        return(self);
      },
      .Some(sp) => {
        if(rc(self) == usize(1), {
          i := usize(0);
          while(i < self._len, i = (i + usize(1)), {
            (b : u8) = (sp.add(i)).*;
            if((b >= u8(0x41)) && (b <= u8(0x5A)), {
              (sp.add(i)).* = (b + u8(32));
            });
          });
          return(self);
        });
        ptr := _alloc_bytes(self._len);
        unsafe(memcpy(*(void)(ptr), *(void)(sp), self._len));
        i := usize(0);
        while(i < self._len, i = (i + usize(1)), {
          (b : u8) = (ptr.add(i)).*;
          if((b >= u8(0x41)) && (b <= u8(0x5A)), {
            (ptr.add(i)).* = (b + u8(32));
          });
        });
        saved_len := self._len;
        unsafe.drop(self);
        return(Self(_ptr : .Some(ptr), _len : saved_len, _capacity : saved_len));
      }
    )
  }),
  /// Convert all ASCII lowercase letters to uppercase.
  /// Uses COW: if this string has a unique reference, modifies bytes in-place.
  to_uppercase : (fn(own(self) : Self) -> Self)({
    if(self._len == usize(0), {
      return(self);
    });
    match(
      self._ptr,
      .None => {
        return(self);
      },
      .Some(sp) => {
        if(rc(self) == usize(1), {
          i := usize(0);
          while(i < self._len, i = (i + usize(1)), {
            (b : u8) = (sp.add(i)).*;
            if((b >= u8(0x61)) && (b <= u8(0x7A)), {
              (sp.add(i)).* = (b - u8(32));
            });
          });
          return(self);
        });
        ptr := _alloc_bytes(self._len);
        unsafe(memcpy(*(void)(ptr), *(void)(sp), self._len));
        i := usize(0);
        while(i < self._len, i = (i + usize(1)), {
          (b : u8) = (ptr.add(i)).*;
          if((b >= u8(0x61)) && (b <= u8(0x7A)), {
            (ptr.add(i)).* = (b - u8(32));
          });
        });
        saved_len := self._len;
        unsafe.drop(self);
        return(Self(_ptr : .Some(ptr), _len : saved_len, _capacity : saved_len));
      }
    )
  }),
  /// Replace the first occurrence of `search` with `replacement`.
  replace : (fn(self : Self, search : Self, replacement : Self) -> Self)(
    match(
      self.index_of(search, usize(0)),
      .None => {
        return(self);
      },
      .Some(idx) => {
        before := self.slice(usize(0), idx);
        after := self.slice(idx + search._len, self._len);
        tmp := before.concat(replacement);
        return(tmp.concat(after));
      }
    )
  ),
  /// Replace all occurrences of `search` with `replacement`.
  replace_all : (fn(self : Self, search : Self, replacement : Self) -> Self)({
    if(search._len == usize(0), {
      return(self);
    });
    result := Self.new();
    pos := usize(0);
    done := false;
    while(!(done), {
      match(
        self.index_of(search, pos),
        .Some(idx) => {
          segment := self.slice(pos, idx);
          result = result.concat(segment);
          result = result.concat(replacement);
          pos = (idx + search._len);
        },
        .None => {
          result = result.concat(self.slice(pos, self._len));
          done = true;
        }
      );
    });
    result
  }),
  /// Repeat the string `n` times.
  repeat : (fn(self : Self, n : usize) -> Self)({
    if((n == usize(0)) || (self._len == usize(0)), {
      return(Self.new());
    });
    if(n == usize(1), {
      return(self);
    });
    new_len := (self._len * n);
    ptr := _alloc_bytes(new_len);
    match(
      self._ptr,
      .Some(sp) => {
        i := usize(0);
        while(i < n, i = (i + usize(1)), {
          unsafe(memcpy(*(void)(ptr.add(i * self._len)), *(void)(sp), self._len));
        });
      },
      .None => ()
    );
    return(Self(_ptr : .Some(ptr), _len : new_len, _capacity : new_len));
  }),
  /// Decode a single UTF-8 rune starting at byte index.
  _decode_rune_at : (fn(self : Self, byte_index : usize) -> Option(rune))({
    if(byte_index >= self._len, {
      return(.None);
    });
    match(
      self._ptr,
      .None => {
        return(.None);
      },
      .Some(p) => {
        // This buffer is raw memory, not an `ArrayList(u8)`, so the bytes are
        // fetched here and handed to the shared core. `decode_parts` exists
        // for exactly this: copying into a list to decode one rune would cost
        // an allocation per rune.
        (rest : usize) = (self._len - byte_index);
        (available : usize) = cond(
          (rest > usize(4)) => usize(4),
          true => rest
        );
        (b0 : u8) = (p.add(byte_index)).*;
        (b1 : u8) = cond(
          (available > usize(1)) => (p.add(byte_index + usize(1))).*,
          true => u8(0)
        );
        (b2 : u8) = cond(
          (available > usize(2)) => (p.add(byte_index + usize(2))).*,
          true => u8(0)
        );
        (b3 : u8) = cond(
          (available > usize(3)) => (p.add(byte_index + usize(3))).*,
          true => u8(0)
        );
        match(
          utf8.decode_parts(b0, b1, b2, b3, available, byte_index),
          .Ok(d) => .Some(d.code),
          .Err(_) => .None
        )
      }
    )
  }),
  /// Decode the rune that STARTS at byte offset `index`.
  ///
  /// **BYTE basis** (`plans/STD_API_AUDIT_D4_PLAN.md` D4 PR 4 — this took a
  /// rune index before the flip; it now mirrors `std/string`'s `String.at`).
  /// `.None` is returned for the three ways a byte offset can fail to name a
  /// rune: at or past `len()`, inside a rune (a UTF-8 continuation byte), or
  /// on bytes that do not decode.
  ///
  /// `while(i < s.len(), { s.at(i) })` therefore visits continuation bytes and
  /// yields `.None` at each of them — use `char_indices()` (or `chars()`) to
  /// walk runes.
  at : (fn(self : Self, index : usize) -> Option(rune))(
    self._decode_rune_at(index)
  )
);
/// === Rune-aware indexing (D4 vocabulary) ===
///
/// The same six additions `std/string/string.yo` grew, plus the rune iterator
/// this type never had. Offsets are **BYTES** throughout (except `char_len`,
/// which counts runes) — and since D4 PR 4 flipped `len()` and `at()`, that
/// is the basis the WHOLE type speaks: this block is the rune vocabulary on
/// top of it. See `plans/STD_API_AUDIT_D4_PLAN.md`.
///
/// `char_len` and `char_indices` are built on `std/encoding/utf8` and inherit
/// its malformed-input behaviour: `char_len` counts non-continuation bytes
/// (what `len()` counted before D4 PR 4), `char_indices` and `chars` stop at
/// the first sequence that will not decode. The boundary functions and
/// `try_substring` are pure byte classification and cannot fail.
/// Rune iterator for `imm.String` — created by `chars()`.
StringChars :: struct(
  _string : String,
  _byte_index : usize
);
impl(
  StringChars,
  Iterator(
    Item : rune,
    next : (fn(inout(self) : Self) -> Option(rune))(
      cond(
        (self._byte_index >= self._string.len()) => .None,
        true => match(
          self._string.byte_at(self._byte_index),
          .Some(first_byte) => {
            offset := self._byte_index;
            self._byte_index = (offset + utf8.step_len(first_byte));
            self._string._decode_rune_at(offset)
          },
          .None => .None
        )
      )
    )
  )
);
/// `(byte_offset, rune)` iterator for `imm.String` — created by
/// `char_indices()`. Walks in lockstep with `StringChars`.
StringCharIndices :: struct(
  _string : String,
  _byte_index : usize
);
impl(
  StringCharIndices,
  Iterator(
    Item : IterPair(usize, rune),
    next : (fn(inout(self) : Self) -> Option(IterPair(usize, rune)))(
      cond(
        (self._byte_index >= self._string.len()) => .None,
        true => match(
          self._string.byte_at(self._byte_index),
          .Some(first_byte) => {
            offset := self._byte_index;
            self._byte_index = (offset + utf8.step_len(first_byte));
            match(
              self._string._decode_rune_at(offset),
              .Some(r) => .Some(IterPair(usize, rune)(_0 : offset, _1 : r)),
              .None => .None
            )
          },
          .None => .None
        )
      )
    )
  )
);
impl(
  String,
  /// Iterate the string's runes.
  chars : (fn(self : Self) -> StringChars)(
    StringChars(_string : self, _byte_index : usize(0))
  ),
  /// Iterate `(byte_offset, rune)` pairs — Rust's `char_indices()`.
  char_indices : (fn(self : Self) -> StringCharIndices)(
    StringCharIndices(_string : self, _byte_index : usize(0))
  ),
  /// Number of Unicode scalar values (runes) in the string — O(n).
  ///
  /// **RUNE basis**, and the only length on this type that is: `len()` counts
  /// BYTES (D4 PR 4). Use this wherever a count is a display/character count
  /// rather than a buffer size.
  char_len : (fn(self : Self) -> usize)({
    count := usize(0);
    i := usize(0);
    n := self._len;
    while(i < n, i = (i + usize(1)), {
      match(
        self.byte_at(i),
        .Some(b) => {
          cond(
            utf8.is_boundary(b) => {
              count = (count + usize(1));
            },
            true => ()
          );
        },
        .None => ()
      );
    });
    count
  }),
  /// True when byte offset `index` sits on a rune boundary.
  ///
  /// `0` and `len()` are always boundaries; an index past the end never
  /// is. Mirrors Rust's `str::is_char_boundary`.
  is_char_boundary : (fn(self : Self, index : usize) -> bool)(
    cond(
      (index == usize(0)) => true,
      (index == self._len) => true,
      (index > self._len) => false,
      true => match(
        self.byte_at(index),
        .Some(b) => utf8.is_boundary(b),
        .None => false
      )
    )
  ),
  /// The largest byte offset `<= index` that sits on a rune boundary.
  ///
  /// `index` is clamped to `len()` first, so the answer is always a
  /// boundary of THIS string.
  floor_char_boundary : (fn(self : Self, index : usize) -> usize)(
    cond(
      (index >= self._len) => self._len,
      true => {
        i := index;
        while(i > usize(0), {
          (on_boundary : bool) = match(
            self.byte_at(i),
            .Some(b) => utf8.is_boundary(b),
            .None => true
          );
          if(on_boundary, {
            break;
          });
          i = (i - usize(1));
        });
        i
      }
    )
  ),
  /// The smallest byte offset `>= index` that sits on a rune boundary.
  ///
  /// `index` at or past `len()` clamps to `len()`, which is a
  /// boundary, so this always terminates on a valid one.
  ceil_char_boundary : (fn(self : Self, index : usize) -> usize)(
    cond(
      (index >= self._len) => self._len,
      true => {
        i := index;
        while(i < self._len, {
          (on_boundary : bool) = match(
            self.byte_at(i),
            .Some(b) => utf8.is_boundary(b),
            .None => true
          );
          if(on_boundary, {
            break;
          });
          i = (i + usize(1));
        });
        i
      }
    )
  ),
  /// Byte-range slice that REFUSES a bad range instead of clamping it —
  /// Rust's `s.get(start..end)`, and the checked counterpart of `slice`.
  ///
  /// `.None` for `start > end`, for `end` past `len()`, and for an
  /// endpoint inside a rune (which would produce invalid UTF-8). An empty but
  /// valid range yields `.Some` of the empty string.
  try_substring : (fn(self : Self, start : usize, end : usize) -> Option(Self))({
    if(start > end, {
      return(.None);
    });
    if(end > self._len, {
      return(.None);
    });
    if(!(self.is_char_boundary(start)), {
      return(.None);
    });
    if(!(self.is_char_boundary(end)), {
      return(.None);
    });
    return(.Some(self.slice(start, end)));
  })
);
/// Equality by byte content.
impl(
  String,
  Eq(String)(
    (==) : (fn(self : Self, other : Self) -> bool)({
      if(self._len != other._len, {
        return(false);
      });
      if(self._len == usize(0), {
        return(true);
      });
      match(
        self._ptr,
        .Some(sp) => match(
          other._ptr,
          .Some(op) => (unsafe(memcmp(*(void)(sp), *(void)(op), self._len)) == int(0)),
          .None => false
        ),
        .None => match(
          other._ptr,
          .Some(_) => false,
          .None => true
        )
      )
    }),
    (!=) : (fn(self : Self, other : Self) -> bool)({
      return(!(Self.(==)(self, other)));
    })
  )
);
// TODO: Eq(str) impl — "Variable str not found" inside impl blocks for atomic object types.
// Provide eq_str method instead.
impl(
  String,
  /// Compare with a `str` for equality.
  eq_str : (fn(self : Self, other : str) -> bool)({
    other_len := other.len();
    if(self._len != other_len, {
      return(false);
    });
    if(self._len == usize(0), {
      return(true);
    });
    match(
      self._ptr,
      .Some(sp) => (unsafe(memcmp(*(void)(sp), *(void)(other.ptr()), self._len)) == int(0)),
      .None => (other_len == usize(0))
    )
  })
);
/// Lexicographic ordering.
impl(
  String,
  Ord(String)(
    (<) : (fn(self : Self, other : Self) -> bool)({
      min_len := _min(self._len, other._len);
      if(min_len > usize(0), {
        match(
          self._ptr,
          .Some(sp) => match(
            other._ptr,
            .Some(op) => {
              (cmp_result : int) = unsafe(memcmp(*(void)(sp), *(void)(op), min_len));
              if(cmp_result != int(0), {
                return(cmp_result < int(0));
              });
            },
            .None => ()
          ),
          .None => ()
        );
      });
      self._len < other._len
    }),
    (<=) : (fn(self : Self, other : Self) -> bool)({
      return(!(other < self));
    }),
    (>) : (fn(self : Self, other : Self) -> bool)(
      other < self
    ),
    (>=) : (fn(self : Self, other : Self) -> bool)({
      return(!(self < other));
    })
  )
);
/// FNV-1a hash over the string's bytes.
impl(
  String,
  Hash(
    (hash) : (fn(inout(self) : Self) -> u64)({
      h := u64(14695981039346656037);
      match(
        self._ptr,
        .None => (),
        .Some(p) => {
          i := usize(0);
          while(i < self._len, i = (i + usize(1)), {
            // SAFETY: `p` points at the Rc-managed UTF-8 byte
            // buffer of length `self._len`; the loop guard
            // `i < self._len` keeps `p &+ i` inside the allocation.
            h = (h ^ u64(unsafe((p.add(i)).*)));
            h = (h * u64(1099511628211));
          });
        }
      );
      h
    })
  )
);
/// ToString returns a std.String for compatibility with println/print.
impl(
  String,
  ToString(
    to_string : (fn(inout(self) : Self) -> std_string.String)({
      bytes := ArrayList(u8).new();
      match(
        self._ptr,
        .None => (),
        .Some(p) => bytes.extend_from_ptr(p, self._len)
      );
      std_string.String.from_bytes(bytes)
    })
  )
);
export(String, StringChars, StringCharIndices);
