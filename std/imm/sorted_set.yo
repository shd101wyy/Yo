//! Persistent immutable sorted set using a left-leaning red-black tree.
//!
//! `SortedSet(T)` is a thin wrapper around `SortedMap(T, bool)`, keeping
//! elements in sorted order. All mutations return new sets, leaving the
//! original unchanged.
//!
//! Elements must implement `Eq`, `Ord`, and `Send`.
//!
//! ## Examples
//!
//! ```rust
//! { SortedSet } :: import "std/imm/sorted_set";
//!
//! s := SortedSet(i32).new();
//! s = s.insert(i32(3));
//! s = s.insert(i32(1));
//! s = s.insert(i32(2));
//! // elements are always sorted: 1, 2, 3
//! ```
//!
//! `contains`, `insert` and `remove` are O(log n) through the tree, and
//! `min`/`max` are the leftmost/rightmost walk. The set operations are
//! eager — each builds a new set, O(n log n) — and `to_list()`, like the
//! `IntoIterator` behind `for(set, ...)`, materializes an `imm.List` in
//! ascending order, O(n).
//!
//! ## Stability
//!
//! unstable — inherits both open questions of the map it wraps
//! (`plans/STD_API_STABILIZATION.md` §4): `remove(elem) -> Self` cannot say
//! whether the element was present, and the wrapper stores
//! `SortedMap(T, bool)` where D16's rule for `HashSet` says the value slot
//! should be `unit`, now that `unit` is a true ZST. Freezing follows those
//! two.
pragma(Pragma.AllowUnsafe);
{ SortedMap } :: import("./sorted_map.yo");
{ ArrayList } :: import("../collections/array_list.yo");
{ List, ListIter } :: import("./list.yo");
/// Persistent immutable sorted set backed by a left-leaning red-black tree.
SortedSet :: (fn(comptime(T) : Type, where(T <: (Eq(T), Ord(T), Send, Acyclic))) -> comptime(Type))(
  struct(_inner : SortedMap(T, bool))
);
// O7: nesting support — see SortedMap's impl.
impl(generic(T : Type), where(T <: (Eq(T), Ord(T), Send, Acyclic)), SortedSet(T), Acyclic());
impl(
  generic(T : Type),
  where(T <: (Eq(T), Ord(T), Send, Acyclic)),
  SortedSet(T),
  /// Create an empty sorted set.
  new : (fn() -> Self)(
    Self(_inner : SortedMap(T, bool).new())
  ),
  /// Number of elements.
  len : (fn(self : Self) -> usize)(self._inner.len()),
  /// Check if the set is empty.
  is_empty : (fn(self : Self) -> bool)(self._inner.is_empty()),
  /// Check if the set contains `elem`.
  contains : (fn(self : Self, elem : T) -> bool)(
    self._inner.contains_key(elem)
  ),
  /// Return a new set with `elem` added.
  insert : (fn(self : Self, elem : T) -> Self)(
    Self(_inner : self._inner.insert(elem, true))
  ),
  /// Return a new set with `elem` removed — `im`'s `without`. An element that
  /// is not present gives back an equal set, and says nothing about whether
  /// anything was there; `extract` is the form that does.
  remove : (fn(self : Self, elem : T) -> Self)(
    Self(_inner : self._inner.remove(elem))
  ),
  /// The set WITHOUT `elem`, or `.None` when `elem` was not a member — `im`'s
  /// `extract`.
  ///
  /// A set has no value to hand back, so the `Option` carries the whole
  /// answer: `.Some` means "it was there, and here is the set without it",
  /// `.None` means "nothing to remove, and your own set is already correct".
  /// That is what `remove` alone cannot say — its result is
  /// indistinguishable from a no-op.
  extract : (fn(self : Self, elem : T) -> Option(Self))(
    cond(
      self.contains(elem) => Option(Self).Some(self.remove(elem)),
      true => Option(Self).None
    )
  ),
  /// Get the minimum element.
  min : (fn(self : Self) -> Option(T))(
    self._inner.min_key()
  ),
  /// Get the maximum element.
  max : (fn(self : Self) -> Option(T))(
    self._inner.max_key()
  ),
  /// Return elements as a sorted List.
  to_list : (fn(self : Self) -> List(T))(
    self._inner.keys()
  ),
  /// Return the union of two sorted sets.
  union : (fn(self : Self, other : Self) -> Self)({
    elems := other.to_list();
    (result : Self) = self;
    (cur : List(T)) = elems;
    (done : bool) = false;
    while(runtime(!done), {
      match(
        cur.head(),
        .Some(elem) => {
          result = result.insert(elem);
          cur = cur.tail();
        },
        .None => {
          done = true;
        }
      );
    });
    result
  }),
  /// Return the intersection of two sorted sets.
  intersection : (fn(self : Self, other : Self) -> Self)({
    elems := self.to_list();
    (result : Self) = Self.new();
    (cur : List(T)) = elems;
    (done : bool) = false;
    while(runtime(!done), {
      match(
        cur.head(),
        .Some(elem) => {
          if(other.contains(elem), {
            result = result.insert(elem);
          });
          cur = cur.tail();
        },
        .None => {
          done = true;
        }
      );
    });
    result
  }),
  /// Return the difference (`self \ other`).
  difference : (fn(self : Self, other : Self) -> Self)({
    elems := self.to_list();
    (result : Self) = Self.new();
    (cur : List(T)) = elems;
    (done : bool) = false;
    while(runtime(!done), {
      match(
        cur.head(),
        .Some(elem) => {
          if(!other.contains(elem), {
            result = result.insert(elem);
          });
          cur = cur.tail();
        },
        .None => {
          done = true;
        }
      );
    });
    result
  }),
  /// Check if `self` is a subset of `other`.
  is_subset : (fn(self : Self, other : Self) -> bool)({
    if(self.len() > other.len(), {
      return(false);
    });
    elems := self.to_list();
    (cur : List(T)) = elems;
    (result : bool) = true;
    while(runtime(result && !cur.is_empty()), {
      match(
        cur.head(),
        .Some(elem) => {
          if(!other.contains(elem), {
            result = false;
          });
          cur = cur.tail();
        },
        .None => ()
      );
    });
    result
  }),
  /// Check if two sorted sets are disjoint.
  is_disjoint : (fn(self : Self, other : Self) -> bool)({
    (smaller : Self) = cond(
      (self.len() <= other.len()) => self,
      true => other
    );
    (larger : Self) = cond(
      (self.len() <= other.len()) => other,
      true => self
    );
    elems := smaller.to_list();
    (cur : List(T)) = elems;
    (result : bool) = true;
    while(runtime(result && !cur.is_empty()), {
      match(
        cur.head(),
        .Some(elem) => {
          if(larger.contains(elem), {
            result = false;
          });
          cur = cur.tail();
        },
        .None => ()
      );
    });
    result
  }),
  /// Create a sorted set from a slice of elements.
  from_list : (fn(l : ArrayList(T)) -> Self)({
    (result : Self) = Self.new();
    i := usize(0);
    slen := l.len();
    while(i < slen, i = (i + usize(1)), {
      result = result.insert(match(l.get(i), .Some(__e) => __e, .None => __yo_panic("from_list: index out of bounds")));
    });
    result
  })
);
impl(
  generic(T : Type),
  where(T <: (Eq(T), Ord(T), Send, Acyclic)),
  SortedSet(T),
  Eq(SortedSet(T))(
    (==) : (fn(lhs : Self, rhs : Self) -> bool)(
      lhs._inner == rhs._inner
    )
  )
);
/// Iterate the set's elements in ASCENDING order. Delegates to `to_list()` —
/// see `Map`'s `IntoIterator` for the cost note.
impl(
  generic(T : Type),
  where(T <: (Eq(T), Ord(T), Send, Acyclic)),
  SortedSet(T),
  IntoIterator(
    Item : T,
    IntoIter : ListIter(T),
    into_iter : (fn(self : Self) -> ListIter(T))(
      self.to_list().into_iter()
    )
  )
);
/// `Default` — the empty sorted set.
impl(
  generic(T : Type),
  where(T <: (Eq(T), Ord(T), Send, Acyclic)),
  SortedSet(T),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
export(SortedSet);
