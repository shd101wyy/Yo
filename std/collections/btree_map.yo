//! Sorted map backed by a sorted array with O(log n) lookup via binary
//! search.
//!
//! The name is Rust's, the shape is Rust's — key-ordered iteration, `range`,
//! `first_entry`/`last_entry`, `pop_first`/`pop_last` — but the storage is
//! not: entries live in one `ArrayList` kept in key order, so `get` and
//! `contains_key` are O(log n) while `insert` and `remove` are O(n) (they
//! shift the tail), where Rust's B-tree gives all four O(log n). That trade
//! wins for the small, read-mostly maps this is used for and costs on
//! insert-heavy ones; use `HashMap` when the order is not needed.
//!
//! ## Example
//!
//! ```rust
//! { BTreeMap } :: import "std/collections/btree_map";
//!
//! m := BTreeMap(String, i32).new();
//! m.insert(String.from("b"), 2);
//! m.insert(String.from("a"), 1);
//! // Iteration order: a, b
//! ```
//!
//! ## Stability
//!
//! stable — the surface mirrors `std::collections::BTreeMap` (`insert`
//! returning the replaced value since 2026-09-06, `contains_key`, `range`
//! over a `Range(K)`, `pop_first`/`pop_last`, `FromIterator`), and
//! `plans/STD_API_STABILIZATION.md` §4 lists nothing open against it. The
//! sorted-array backing is an implementation choice, not part of the
//! contract: replacing it with a real B-tree would change complexity, not
//! any signature.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("./array_list");
{ MapEntry } :: import("./entry.yo");
export(MapEntry);
{ assert } :: import("../assert");
import("../string");
// Internal result from binary search.
_FindResult :: struct(idx : usize, found : bool);
/// Sorted map maintaining entries in key order.
/// Provides ordered iteration and O(log n) lookup via binary search. Insert is O(n).
BTreeMap :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  ref(
    struct(
      _entries : ArrayList(MapEntry(K, V))
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  /// Empty map.
  new : (fn() -> Self)(
    Self(_entries : ArrayList(MapEntry(K, V)).new())
  ),
  /// Number of entries. O(1).
  len : (fn(self : Self) -> usize)(
    self._entries.len()
  ),
  /// True when the map holds no entries.
  is_empty : (fn(self : Self) -> bool)(
    self._entries.len() == usize(0)
  ),
  // Binary search: returns the index of the entry with key `k`,
  // or the insertion point if not found.
  _find : (fn(self : Self, k : K, where(K <: Ord(K))) -> _FindResult)({
    lo := usize(0);
    hi := self._entries.len();
    while(lo < hi, {
      mid := (lo + ((hi - lo) / usize(2)));
      entry_key := self._entries(mid).key;
      cond(
        (entry_key < k) => {
          lo = (mid + usize(1));
        },
        (entry_key > k) => {
          hi = mid;
        },
        true => {
          return(_FindResult(mid, true));
        }
      );
    });
    _FindResult(lo, false)
  }),
  /// Copy of the value stored under `k`, or `.None` — O(log n) binary
  /// search. `self(k)` (the `Index` impl) asserts the key is present
  /// instead.
  get : (fn(self : Self, k : K, where(K <: Ord(K))) -> Option(V))({
    r := self._find(k);
    cond(
      r.found => .Some(self._entries(r.idx).value),
      true => .None
    )
  }),
  /// Insert or update the value for key `k`, returning the value it REPLACED
  /// (`.None` for a new key) — Rust's `BTreeMap::insert`. Until 2026-09-06
  /// this returned `unit`, dropping the old value silently, and discarded
  /// `push`'s `Result` before computing `len() - 1`
  /// (issues/fixed/btree-map-insert-dropped-the-old-value-and-push-results-were-ignored.md).
  /// For new keys: append at end then shift-left to the sorted position.
  insert : (fn(self : Self, k : K, v : V, where(K <: Ord(K))) -> Option(V))({
    r := self._find(k);
    cond(
      r.found => {
        entry := self._entries(r.idx);
        &(self._entries(r.idx)).* = MapEntry(K, V)(key : entry.key, value : v);
        .Some(entry.value)
      },
      true => {
        // The push moved OUT of a cond condition here: before D9 this arm's
        // predecessor was `push(...).is_err() => __yo_panic(...)`, which
        // performed the push as a side effect of testing it. `push` now
        // panics on allocation failure itself — the same outcome that arm
        // spelled out, since a half-updated map that then underflows
        // `len() - 1` is not recoverable.
        self._entries.push(MapEntry(K, V)(key : k, value : v));
        pos := (self._entries.len() - usize(1));
        while(pos > r.idx, pos = (pos - usize(1)), {
          curr := self._entries(pos);
          prev := self._entries(pos - usize(1));
          &(self._entries(pos)).* = prev;
          &(self._entries(pos - usize(1))).* = curr;
        });
        .None
      }
    )
  }),
  /// Remove the entry for `k` and return its value, or `.None` — O(log n)
  /// to find it, O(n) to close the gap, and the key order is preserved.
  remove : (fn(self : Self, k : K, where(K <: Ord(K))) -> Option(V))({
    r := self._find(k);
    cond(
      r.found => {
        v := self._entries(r.idx).value;
        self._entries.remove(r.idx);
        .Some(v)
      },
      true => .None
    )
  }),
  /// Whether `k` is present — Rust's `contains_key`. O(log n), and it does
  /// not touch the value.
  contains_key : (fn(self : Self, k : K, where(K <: Ord(K))) -> bool)(
    match(self.get(k), .Some(_) => true, .None => false)
  ),
  /// Remove and return the lowest entry — Rust's `pop_first`.
  pop_first : (fn(self : Self, where(K <: Ord(K))) -> Option(MapEntry(K, V)))(
    match(
      self.first_entry(),
      .Some(e) => {
        _r := self.remove(e.key);
        Option(MapEntry(K, V)).Some(e)
      },
      .None => Option(MapEntry(K, V)).None
    )
  ),
  /// Remove and return the highest entry — Rust's `pop_last`.
  pop_last : (fn(self : Self, where(K <: Ord(K))) -> Option(MapEntry(K, V)))(
    match(
      self.last_entry(),
      .Some(e) => {
        _r := self.remove(e.key);
        Option(MapEntry(K, V)).Some(e)
      },
      .None => Option(MapEntry(K, V)).None
    )
  ),
  /// The entry with the smallest key, or `.None` — O(1), since the backing
  /// array is kept in key order.
  ///
  /// Named `first_entry`/`last_entry` rather than `min`/`max` because this is
  /// a MAP: it returns a whole `MapEntry`, not a key. Sets keep `min`/`max`,
  /// which do return the element (plans/archive/STD_API_AUDIT.md §5).
  first_entry : (fn(self : Self) -> Option(MapEntry(K, V)))(
    cond(
      (self._entries.len() == usize(0)) => .None,
      true => .Some(self._entries(usize(0)))
    )
  ),
  /// Return the entry with the largest key, or `.None`.
  last_entry : (fn(self : Self) -> Option(MapEntry(K, V)))(
    cond(
      (self._entries.len() == usize(0)) => .None,
      true => .Some(self._entries(self._entries.len() - usize(1)))
    )
  )
);
/// Value iterator over a BTreeMap — yields each `MapEntry(K, V)` BY VALUE in
/// KEY ORDER. This is what `into_iter()`, and therefore `for(map, ...)`,
/// returns; `iter()` yields pointers.
///
/// It holds the backing entry list by handle, so the walk sees the array as
/// it was when the iterator was made plus any in-place value updates;
/// inserting or removing during the walk shifts entries under it.
BTreeMapIter :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _entries : ArrayList(MapEntry(K, V)),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapIter(K, V),
  Iterator(
    Item : MapEntry(K, V),
    next : (fn(inout(self) : Self) -> Option(MapEntry(K, V)))(
      cond(
        (self._index >= self._entries.len()) => .None,
        true => {
          entry := self._entries(self._index);
          self._index = (self._index + usize(1));
          .Some(entry)
        }
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  IntoIterator(
    Item : MapEntry(K, V),
    IntoIter : BTreeMapIter(K, V),
    into_iter : (fn(self : Self) -> BTreeMapIter(K, V))(
      BTreeMapIter(K, V)(_entries : self._entries, _index : usize(0))
    )
  )
);
/// Pointer iterator over a BTreeMap — yields `*(MapEntry(K, V))` into the
/// backing array, in key order. This is what `iter()` returns (D14): nothing
/// is dup'd, and `p.*.value` can be written in place.
///
/// An `insert` or `remove` during the walk shifts or reallocates that array
/// and invalidates every pointer already yielded.
BTreeMapIterPtr :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _entries : ArrayList(MapEntry(K, V)),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapIterPtr(K, V),
  Iterator(
    Item : *MapEntry(K, V),
    next : (fn(inout(self) : Self) -> Option(*MapEntry(K, V)))(
      cond(
        (self._index >= self._entries.len()) => .None,
        true =>
          match(
            self._entries._ptr,
            .Some(ptr) => {
              element_ptr := ptr.add(self._index);
              self._index = (self._index + usize(1));
              .Some(element_ptr)
            },
            .None => .None
          )
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  /// Borrowing walk in key order: yields a `*(MapEntry(K, V))` into the
  /// backing array and leaves the map intact (D14).
  iter : (fn(self : Self) -> BTreeMapIterPtr(K, V))(
    BTreeMapIterPtr(K, V)(_entries : self._entries, _index : usize(0))
  )
);
/// Iterator over a BTreeMap's keys in ascending order — what `keys()`
/// returns. Keys are yielded by value.
BTreeMapKeys :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _inner : BTreeMapIter(K, V)
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapKeys(K, V),
  Iterator(
    Item : K,
    next : (fn(inout(self) : Self) -> Option(K))(
      match(
        self._inner.next(),
        .None => .None,
        .Some(entry) => .Some(entry.key)
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  /// Walk the keys in ascending order — Rust's `keys`.
  keys : (fn(self : Self) -> BTreeMapKeys(K, V))(
    BTreeMapKeys(K, V)(_inner : BTreeMapIter(K, V)(_entries : self._entries, _index : usize(0)))
  )
);
/// Iterator over a BTreeMap's values, ordered by their KEYS — what
/// `values()` returns. Values are yielded by value.
BTreeMapValues :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _inner : BTreeMapIter(K, V)
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapValues(K, V),
  Iterator(
    Item : V,
    next : (fn(inout(self) : Self) -> Option(V))(
      match(
        self._inner.next(),
        .None => .None,
        .Some(entry) => .Some(entry.value)
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  /// Walk the values in key order — Rust's `values`.
  values : (fn(self : Self) -> BTreeMapValues(K, V))(
    BTreeMapValues(K, V)(_inner : BTreeMapIter(K, V)(_entries : self._entries, _index : usize(0)))
  )
);
/// Iterator over the entries of one key window, in key order — what
/// `range(k1 .. k2)` returns.
///
/// The window is resolved to array INDICES once, when the iterator is made,
/// so an insertion during the walk moves entries in or out of it. Yields
/// entries by value.
BTreeMapRange :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _entries : ArrayList(MapEntry(K, V)),
    _index : usize,
    _end : usize
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapRange(K, V),
  Iterator(
    Item : MapEntry(K, V),
    next : (fn(inout(self) : Self) -> Option(MapEntry(K, V)))(
      cond(
        (self._index >= self._end) => .None,
        true => {
          entry := self._entries(self._index);
          self._index = (self._index + usize(1));
          .Some(entry)
        }
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  /// The entries whose keys lie in `[start, end)`, in key order — Rust's
  /// `range`.
  ///
  /// The window is a `Range(K)` — write it with `..`: `m.range(k1 .. k2)`. It is
  /// half-open, like every other range in the language, so `a .. b` and `b .. c`
  /// partition `[a, c)` with nothing counted twice, and the `..` at the call
  /// site says so without the reader having to remember.
  ///
  /// An inverted window yields NOTHING rather than erroring — unlike
  /// `Rng.range` / `random_range`, which panic. The difference is what each
  /// returns: an empty iterator is a real answer, whereas a sampler asked for
  /// a value from an empty range has none to give.
  ///
  /// The bounds do NOT have to be present in the map: `_find` reports the
  /// insertion point for an absent key, which is exactly the first entry at or
  /// past it.
  range : (fn(self : Self, r : Range(K), where(K <: Ord(K))) -> BTreeMapRange(K, V))({
    lo := self._find(r.start).idx;
    hi := self._find(r.end).idx;
    BTreeMapRange(K, V)(
      _entries : self._entries,
      _index : lo,
      _end : cond(
        (hi < lo) => lo,
        true => hi
      )
    )
  })
);
impl(
  generic(K : Type, V : Type),
  where(K <: Ord(K)),
  BTreeMap(K, V),
  /// Build a map from a sequence of entries — `xs.collect(BTreeMap(K, V))`.
  ///
  /// Later duplicates overwrite earlier ones, as `insert` does.
  FromIterator(
    Elem : MapEntry(K, V),
    from_iter_new : (fn() -> Self)(
      BTreeMap(K, V).new()
    ),
    from_iter_add : (fn(acc : Self, item : MapEntry(K, V)) -> Self)({
      acc.insert(item.key, item.value);
      acc
    })
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  Index(K)(
    Output : V,
    index : (fn(inout(self) : Self, idx : K, where(K <: Ord(K))) -> *Self.Output)({
      r := self._find(idx);
      assert(r.found, "BTreeMap: key not found");
      entry_ptr := &self._entries(r.idx);
      &(entry_ptr.*.value)
    })
  )
);
/// `Default` — the empty map.
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
export(
  BTreeMap,
  BTreeMapIter,
  BTreeMapIterPtr,
  BTreeMapRange,
  BTreeMapKeys,
  BTreeMapValues
);
