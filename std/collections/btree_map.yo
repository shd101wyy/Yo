//! Sorted map backed by a sorted array with O(log n) lookup via binary search.
//!
//! ## Example
//!
//! ```rust
//! { BTreeMap } :: import "std/collections/btree_map";
//!
//! m := BTreeMap(String, i32).new();
//! m.insert(String.from("b"), 2);
//! m.insert(String.from("a"), 1);
//! // Iteration order: a, b
//! ```
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("./array_list");
{ MapEntry } :: import("./entry.yo");
export(MapEntry);
{ assert } :: import("../assert");
open(import("../string"));
// Internal result from binary search.
_FindResult :: struct(idx : usize, found : bool);
/// Sorted map maintaining entries in key order.
/// Provides ordered iteration and O(log n) lookup via binary search. Insert is O(n).
BTreeMap :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  ref(
    struct(
      _entries : ArrayList(MapEntry(K, V))
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  // Create an empty map.
  new : (fn() -> Self)(
    Self(_entries : ArrayList(MapEntry(K, V)).new())
  ),
  // Number of entries.
  len : (fn(self : Self) -> usize)(
    self._entries.len()
  ),
  // True if empty.
  is_empty : (fn(self : Self) -> bool)(
    self._entries.len() == usize(0)
  ),
  // Binary search: returns the index of the entry with key `k`,
  // or the insertion point if not found.
  _find : (fn(self : Self, k : K, where(K <: Ord(K))) -> _FindResult)({
    lo := usize(0);
    hi := self._entries.len();
    while(lo < hi, {
      mid := (lo + ((hi - lo) / usize(2)));
      entry_key := self._entries(mid).key;
      cond(
        (entry_key < k) => {
          lo = (mid + usize(1));
        },
        (entry_key > k) => {
          hi = mid;
        },
        true => {
          return(_FindResult(mid, true));
        }
      );
    });
    _FindResult(lo, false)
  }),
  // Retrieve the value associated with key `k`.
  get : (fn(self : Self, k : K, where(K <: Ord(K))) -> Option(V))({
    r := self._find(k);
    cond(
      r.found => .Some(self._entries(r.idx).value),
      true => .None
    )
  }),
  /// Insert or update the value for key `k`, returning the value it REPLACED
  /// (`.None` for a new key) — Rust's `BTreeMap::insert`. Until 2026-09-06
  /// this returned `unit`, dropping the old value silently, and discarded
  /// `push`'s `Result` before computing `len() - 1`
  /// (issues/fixed/btree-map-insert-dropped-the-old-value-and-push-results-were-ignored.md).
  /// For new keys: append at end then shift-left to the sorted position.
  insert : (fn(self : Self, k : K, v : V, where(K <: Ord(K))) -> Option(V))({
    r := self._find(k);
    cond(
      r.found => {
        entry := self._entries(r.idx);
        &(self._entries(r.idx)).* = MapEntry(K, V)(key : entry.key, value : v);
        .Some(entry.value)
      },
      true => {
        // The push moved OUT of a cond condition here: before D9 this arm's
        // predecessor was `push(...).is_err() => __yo_panic(...)`, which
        // performed the push as a side effect of testing it. `push` now
        // panics on allocation failure itself — the same outcome that arm
        // spelled out, since a half-updated map that then underflows
        // `len() - 1` is not recoverable.
        self._entries.push(MapEntry(K, V)(key : k, value : v));
        pos := (self._entries.len() - usize(1));
        while(pos > r.idx, pos = (pos - usize(1)), {
          curr := self._entries(pos);
          prev := self._entries(pos - usize(1));
          &(self._entries(pos)).* = prev;
          &(self._entries(pos - usize(1))).* = curr;
        });
        .None
      }
    )
  }),
  // Remove the entry with key `k`. Returns the old value, or .None.
  remove : (fn(self : Self, k : K, where(K <: Ord(K))) -> Option(V))({
    r := self._find(k);
    cond(
      r.found => {
        v := self._entries(r.idx).value;
        self._entries.remove(r.idx);
        .Some(v)
      },
      true => .None
    )
  }),
  /// Return the entry with the smallest key, or `.None`.
  ///
  /// Named `first_entry`/`last_entry` rather than `min`/`max` because this is a
  /// MAP: it returns a whole `MapEntry`, not a key. Sets keep `min`/`max`,
  /// which do return the element (plans/archive/STD_API_AUDIT.md §5).
  /// Whether `k` is present — Rust's `contains_key`.
  contains_key : (fn(self : Self, k : K, where(K <: Ord(K))) -> bool)(
    match(self.get(k), .Some(_) => true, .None => false)
  ),
  /// Remove and return the lowest entry — Rust's `pop_first`.
  pop_first : (fn(self : Self, where(K <: Ord(K))) -> Option(MapEntry(K, V)))(
    match(
      self.first_entry(),
      .Some(e) => {
        _r := self.remove(e.key);
        Option(MapEntry(K, V)).Some(e)
      },
      .None => Option(MapEntry(K, V)).None
    )
  ),
  /// Remove and return the highest entry — Rust's `pop_last`.
  pop_last : (fn(self : Self, where(K <: Ord(K))) -> Option(MapEntry(K, V)))(
    match(
      self.last_entry(),
      .Some(e) => {
        _r := self.remove(e.key);
        Option(MapEntry(K, V)).Some(e)
      },
      .None => Option(MapEntry(K, V)).None
    )
  ),
  first_entry : (fn(self : Self) -> Option(MapEntry(K, V)))(
    cond(
      (self._entries.len() == usize(0)) => .None,
      true => .Some(self._entries(usize(0)))
    )
  ),
  /// Return the entry with the largest key, or `.None`.
  last_entry : (fn(self : Self) -> Option(MapEntry(K, V)))(
    cond(
      (self._entries.len() == usize(0)) => .None,
      true => .Some(self._entries(self._entries.len() - usize(1)))
    )
  )
);
/**
* Value iterator for BTreeMap - yields MapEntry(K, V) in sorted key order
*/
BTreeMapIter :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _entries : ArrayList(MapEntry(K, V)),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapIter(K, V),
  Iterator(
    Item : MapEntry(K, V),
    next : (fn(inout(self) : Self) -> Option(MapEntry(K, V)))(
      cond(
        (self._index >= self._entries.len()) => .None,
        true => {
          entry := self._entries(self._index);
          self._index = (self._index + usize(1));
          .Some(entry)
        }
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  IntoIterator(
    Item : MapEntry(K, V),
    IntoIter : BTreeMapIter(K, V),
    into_iter : (fn(self : Self) -> BTreeMapIter(K, V))(
      BTreeMapIter(K, V)(_entries : self._entries, _index : usize(0))
    )
  )
);
/**
* Pointer iterator for BTreeMap - yields pointers to MapEntry(K, V) in sorted key order
*/
BTreeMapIterPtr :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _entries : ArrayList(MapEntry(K, V)),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapIterPtr(K, V),
  Iterator(
    Item : *MapEntry(K, V),
    next : (fn(inout(self) : Self) -> Option(*MapEntry(K, V)))(
      cond(
        (self._index >= self._entries.len()) => .None,
        true =>
          match(
            self._entries._ptr,
            .Some(ptr) => {
              element_ptr := ptr.add(self._index);
              self._index = (self._index + usize(1));
              .Some(element_ptr)
            },
            .None => .None
          )
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  iter : (fn(self : Self) -> BTreeMapIterPtr(K, V))(
    BTreeMapIterPtr(K, V)(_entries : self._entries, _index : usize(0))
  )
);
/**
* Keys iterator - wraps BTreeMapIter and yields only keys in sorted order
*/
BTreeMapKeys :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _inner : BTreeMapIter(K, V)
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapKeys(K, V),
  Iterator(
    Item : K,
    next : (fn(inout(self) : Self) -> Option(K))(
      match(
        self._inner.next(),
        .None => .None,
        .Some(entry) => .Some(entry.key)
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  keys : (fn(self : Self) -> BTreeMapKeys(K, V))(
    BTreeMapKeys(K, V)(_inner : BTreeMapIter(K, V)(_entries : self._entries, _index : usize(0)))
  )
);
/**
* Values iterator - wraps BTreeMapIter and yields only values in sorted key order
*/
BTreeMapValues :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _inner : BTreeMapIter(K, V)
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapValues(K, V),
  Iterator(
    Item : V,
    next : (fn(inout(self) : Self) -> Option(V))(
      match(
        self._inner.next(),
        .None => .None,
        .Some(entry) => .Some(entry.value)
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  values : (fn(self : Self) -> BTreeMapValues(K, V))(
    BTreeMapValues(K, V)(_inner : BTreeMapIter(K, V)(_entries : self._entries, _index : usize(0)))
  )
);
/**
* Range iterator for BTreeMap - yields MapEntry(K, V) over a key window
* in sorted key order.
*/
BTreeMapRange :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _entries : ArrayList(MapEntry(K, V)),
    _index : usize,
    _end : usize
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMapRange(K, V),
  Iterator(
    Item : MapEntry(K, V),
    next : (fn(inout(self) : Self) -> Option(MapEntry(K, V)))(
      cond(
        (self._index >= self._end) => .None,
        true => {
          entry := self._entries(self._index);
          self._index = (self._index + usize(1));
          .Some(entry)
        }
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  /// The entries whose keys lie in `[start, end)`, in key order — Rust's
  /// `range`.
  ///
  /// Half-open, like every other range in the language, so `range(a, b)` and
  /// `range(b, c)` partition `[a, c)` with nothing counted twice. An inverted
  /// window yields nothing rather than erroring.
  ///
  /// The bounds do NOT have to be present in the map: `_find` reports the
  /// insertion point for an absent key, which is exactly the first entry at or
  /// past it.
  range : (fn(self : Self, start : K, end : K, where(K <: Ord(K))) -> BTreeMapRange(K, V))({
    lo := self._find(start).idx;
    hi := self._find(end).idx;
    BTreeMapRange(K, V)(
      _entries : self._entries,
      _index : lo,
      _end : cond(
        (hi < lo) => lo,
        true => hi
      )
    )
  })
);
impl(
  generic(K : Type, V : Type),
  where(K <: Ord(K)),
  BTreeMap(K, V),
  /// Build a map from a sequence of entries — `xs.collect(BTreeMap(K, V))`.
  ///
  /// Later duplicates overwrite earlier ones, as `insert` does.
  FromIterator(
    Elem : MapEntry(K, V),
    from_iter_new : (fn() -> Self)(
      BTreeMap(K, V).new()
    ),
    from_iter_add : (fn(acc : Self, item : MapEntry(K, V)) -> Self)({
      acc.insert(item.key, item.value);
      acc
    })
  )
);
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  Index(K)(
    Output : V,
    index : (fn(inout(self) : Self, idx : K, where(K <: Ord(K))) -> *Self.Output)({
      r := self._find(idx);
      assert(r.found, "BTreeMap: key not found");
      entry_ptr := &self._entries(r.idx);
      &(entry_ptr.*.value)
    })
  )
);
/// `Default` — the empty map.
impl(
  generic(K : Type, V : Type),
  BTreeMap(K, V),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
export(
  BTreeMap,
  BTreeMapIter,
  BTreeMapIterPtr,
  BTreeMapRange,
  BTreeMapKeys,
  BTreeMapValues
);
