//! Insertion-ordered map.
//!
//! `OrderedMap(K, V)` preserves the order in which keys were first inserted,
//! similar to JavaScript's `Map` or Python's `dict` (≥ 3.7). The entries live
//! in one `ArrayList(MapEntry(K, V))` in insertion order — the ONLY place a
//! key is stored — beside a hash index from each key's hash to the positions
//! of the entries whose key hashes to it, so lookup is O(1) average time and
//! the key is never copied
//! (`issues/fixed/2026-10-16-an-orderedmap-of-a-move-only-key-does-not-compile.md`).
//!
//! # Complexity
//!
//! - `set` (new key): O(1) amortized
//! - `set` (existing key): O(1) — value updated in place, order unchanged
//! - `get` / `contains_key`: O(1) average
//! - `remove`: O(n) — the entries after the removed one shift down a slot
//! - `swap_remove`: O(1) — moves the last entry into the removed slot, so the
//!   iteration order changes (Rust's `IndexMap::swap_remove`)
//! - `index_of` / `get_index`: O(1) — positional lookup, both directions
//! - `iter` / `keys` / `values`: O(n), in insertion order
//!
//! ## Example
//!
//! ```yo
//! { OrderedMap } :: import("std/collections/ordered_map");
//!
//! m := OrderedMap(String, i32).new();
//! m.insert(`alpha`, i32(1));
//! m.insert(`beta`, i32(2));
//! m.insert(`gamma`, i32(3));
//!
//! // Iteration yields keys in insertion order.
//! it := m.keys();
//! while(true, {
//!   match(
//!     it.next(),
//!     .Some(k) => println(&k),
//!     .None => break
//!   );
//! });
//! ```
//!
//! ## Stability
//!
//! unstable — `plans/archive/STD_API_STABILIZATION.md` §4 still lists one shape open
//! here: `remove` is O(n) because it rebuilds the key-order list, and the O(1)
//! `swap_remove` that `indexmap` offers beside it (removing by swapping the
//! last key into the hole, at the cost of the order) has not been decided.
//! Adding it would change what `remove`'s cost is worth accepting. Everything
//! else is settled — D14's pointer `iter()` and the `IntoIterator` that makes
//! `for(map, ...)` work both landed 2026-09-08.
// `iter()` yields `*(MapEntry(K, V))` into the entry list's buffer (D14), so
// this module names a raw pointer type. The pointers come from
// `ArrayList.ptr` and are never dereferenced outside the in-place readers.
pragma(Pragma.AllowUnsafe);
{ MapEntry } :: import("./entry.yo");
{ ArrayList } :: import("./array_list");
{ HashMap, HashMapError } :: import("./hash_map");
{ DefaultHasher, DEFAULT_KEY_0, DEFAULT_KEY_1 } :: import("../hash.yo");
{ AllocError } :: import("../allocator.yo");
/// Ordered map preserving insertion order of keys.
/// Keys must implement `Eq` and `Hash`.
///
/// The key of each entry is stored ONCE, in `_entries`; `_index` maps the
/// key's HASH to the positions of the entries whose key hashes to it (two
/// keys can share a hash, so the value is a list of positions, each compared
/// by key in place). A move-only key — a `Drop` type, a `Box`, a plain type
/// with neither `Copy` nor `Clone` — therefore moves in with its entry and
/// out again, never through a copy.
OrderedMap :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  ref(
    struct(
      /// The entries, in insertion order. The only home of each key.
      _entries : ArrayList(MapEntry(K, V)),
      /// Each key's hash -> the positions in `_entries` of the entries whose
      /// key hashes to it. A list of positions, because a hash is not a key:
      /// on a lookup every position is compared by key, in place. This is
      /// what makes `swap_remove` O(1) and answers `index_of`; every write
      /// to `_entries` must keep it in step — the sites are `insert`,
      /// `remove` and `swap_remove` (`new` and `clear` start it empty).
      _index : HashMap(u64, ArrayList(usize))
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  /// Create an empty `OrderedMap`.
  new : (fn() -> Self)(
    Self(
      _entries : ArrayList(MapEntry(K, V)).new(),
      _index : HashMap(u64, ArrayList(usize)).new()
    )
  ),
  /// Number of entries.
  len : (fn(self : &Self) -> usize)(self._entries.len()),
  /// Whether the map is empty.
  is_empty : (fn(self : &Self) -> bool)(self._entries.is_empty()),
  /// The entry buffer, for the in-place readers. Only called with a position
  /// below `len()`, so the buffer exists.
  _entries_ptr : (fn(self : &Self) -> *MapEntry(K, V))(
    match(
      self._entries.ptr(),
      .Some(p) => p,
      .None => __yo_panic("OrderedMap: the entry list has no buffer")
    )
  ),
  /// A key's hash. The FIXED SipHash keys keep the index reproducible run to
  /// run, as `HashMap` does for its bucket order.
  _hash_key : (fn(self : &Self, key : &K) -> u64)({
    h := DefaultHasher.new_with_keys(DEFAULT_KEY_0, DEFAULT_KEY_1);
    key.hash(&mut h);
    h.finish()
  }),
  /// The position of `key` in `_entries`, comparing each candidate's key in
  /// place — a `&K` is all a lookup ever needs, so a move-only key is found.
  _find_pos : (fn(self : &Self, key : &K) -> Option(usize))({
    h := self._hash_key(key);
    match(
      self._index.get(&h),
      .Some(positions) => {
        (mut(found) : Option(usize)) = Option(usize).None;
        i := usize(0);
        while((i < positions.len()) && found.is_none(), i = (i + usize(1)), {
          match(
            positions.get(i),
            .Some(pos) => {
              ep := self._entries_ptr().add(pos);
              cond(
                (ep.*.key == key) => {
                  found = Option(usize).Some(pos);
                },
                true => ()
              );
            },
            .None => ()
          );
        });
        found
      },
      .None => Option(usize).None
    )
  }),
  /// Record that `pos` holds an entry whose key hashes to `h`. The bucket is
  /// an `ArrayList`, a shared handle, so the `get` copy writes the list the
  /// index holds.
  _index_add : (fn(self : &mut Self, h : u64, pos : usize) -> unit)(
    match(
      self._index.get(&h),
      .Some(positions) => positions.push(pos),
      .None => {
        fresh := ArrayList(usize).new();
        fresh.push(pos);
        self._index.insert(h, fresh);
        ()
      }
    )
  ),
  /// Forget the position `pos` under `h` (`remove`/`swap_remove`).
  _index_drop : (fn(self : &mut Self, h : u64, pos : usize) -> unit)(
    match(
      self._index.get(&h),
      .Some(positions) => {
        match(
          positions.index_of(&pos),
          .Some(i) => consume(positions.remove(i)),
          .None => ()
        );
        ()
      },
      .None => ()
    )
  ),
  /// Move a position record from `from` to `to` under `h` — the fix-up a
  /// shift or a swap leaves behind.
  _index_bump : (fn(self : &mut Self, h : u64, from : usize, to : usize) -> unit)(
    match(
      self._index.get(&h),
      .Some(positions) => {
        match(
          positions.index_of(&from),
          .Some(i) => {
            consume(positions.remove(i));
            positions.insert(i, to);
          },
          .None => ()
        );
        ()
      },
      .None => ()
    )
  ),
  /// Returns `true` if `key` is present.
  contains_key : (fn(self : &Self, key : &K) -> bool)(self._find_pos(key).is_some()),
  /// Returns the value for `key`, or `.None`.
  get : (fn(self : &Self, key : &K) -> Option(V))(
    match(
      self._find_pos(key),
      .Some(pos) => Option(V).Some((self._entries_ptr().add(pos)).*.value),
      .None => Option(V).None
    )
  ),
  /// Insert or update `key -> value`.
  ///
  /// - For a new key, the whole entry (key and value) moves into the list.
  /// - For an existing key, only the value moves: it is swapped in place,
  ///   bitwise, and the old one moves out. The key never moves.
  ///
  /// Returns `Ok(.Some(old_value))` if key already existed, `Ok(.None)` for
  /// a new key, or `.Err(_)` on allocation failure.
  ///
  /// The allocator-aware form (D9); `insert` is the one to reach for.
  try_insert : (fn(self : &mut Self, key : K, value : V) -> Result(Option(V), HashMapError))(
    match(
      self._find_pos(&key),
      .Some(pos) => {
        // The old value moves out bitwise and the new one moves into its
        // slot (HashMap.try_insert's idiom): nothing is copied, and the key
        // stays where it is.
        p := self._entries_ptr().add(pos);
        old := __yo_ptr_read(unsafe(addr_of(p.*.value)));
        __yo_ptr_write(unsafe(addr_of(p.*.value)), value);
        Result(Option(V), HashMapError).Ok(Option(V).Some(old))
      },
      .None => {
        h := self._hash_key(&key);
        pos := self._entries.len();
        entry := MapEntry(K, V)(key : key, value : value);
        match(
          self._entries.try_push(entry),
          .Err(_) => Result(Option(V), HashMapError).Err(.AllocError(error : .OutOfMemory)),
          .Ok(_) => {
            self._index_add(h, pos);
            Result(Option(V), HashMapError).Ok(Option(V).None)
          }
        )
      }
    )
  ),
  /// Insert a key/value pair, returning the PREVIOUS value for that key.
  /// A new key is appended to the insertion order; an existing key keeps its
  /// position.
  ///
  /// PANICS on allocation failure (D9). Use `try_insert` to handle OOM.
  insert : (fn(self : &mut Self, key : K, value : V) -> Option(V))(
    match(
      Self.try_insert(self, key, value),
      .Ok(prev) => prev,
      .Err(_) => __yo_panic("OrderedMap.insert: allocation failed")
    )
  ),
  /// Remove `key`, keeping the insertion order of everything else — Rust's
  /// `IndexMap::shift_remove`. Returns the removed value or `.None`.
  ///
  /// O(n) in the number of entries AFTER the removed one: they each shift
  /// down a slot, and the hash index has to learn where they went. Use
  /// `swap_remove` when the order does not matter.
  remove : (fn(self : &mut Self, key : &K) -> Option(V))(
    match(
      self._find_pos(key),
      .None => Option(V).None,
      .Some(pos) => {
        // The stored key's hash, taken while the entry is still in place.
        h := self._hash_key(&((self._entries_ptr().add(pos)).*.key));
        self._index_drop(h, pos);
        // The whole entry moves out bitwise; a struct-pattern match takes
        // the value and drops the key.
        entry := self._entries.remove(pos);
        // Every entry after the hole slid down one slot: move its position
        // record down with it.
        j := pos;
        n := self._entries.len();
        while(j < n, j = (j + usize(1)), {
          hj := self._hash_key(&((self._entries_ptr().add(j)).*.key));
          self._index_bump(hj, j + usize(1), j);
        });
        match(entry, { key : _, value : v } => Option(V).Some(v))
      }
    )
  ),
  /// Remove `key` in O(1), moving the LAST entry into its position — Rust's
  /// `IndexMap::swap_remove`. Returns the removed value or `.None`.
  ///
  /// This CHANGES the iteration order, which is the whole trade: `remove`
  /// preserves insertion order and pays O(n) to rebuild the entry list, while
  /// this touches two slots and is done. Reach for it when you are draining
  /// a map, or when order stops mattering once a key is gone.
  swap_remove : (fn(self : &mut Self, key : &K) -> Option(V))(
    match(
      self._find_pos(key),
      .None => Option(V).None,
      .Some(pos) => {
        // The stored key's hash, taken while the entry is still in place.
        h := self._hash_key(&((self._entries_ptr().add(pos)).*.key));
        last := (self._entries.len() - usize(1));
        // The whole entry moves out bitwise; a struct-pattern match takes
        // the value and drops the key.
        entry := self._entries.swap_remove(pos);
        self._index_drop(h, pos);
        cond(
          (pos == last) => (),
          true => {
            // The entry that was last now sits at `pos`; move its position
            // record (after the drop above, so a hash it shares with the
            // removed key cannot collide with the old record).
            hlast := self._hash_key(&((self._entries_ptr().add(pos)).*.key));
            self._index_bump(hlast, last, pos);
          }
        );
        match(entry, { key : _, value : v } => Option(V).Some(v))
      }
    )
  ),
  /// The position of `key` in the iteration order, or `.None` if it is
  /// absent — Rust's `IndexMap::get_index_of`. O(1): the hash index that
  /// `swap_remove` needs already answers this.
  index_of : (fn(self : &Self, key : &K) -> Option(usize))(self._find_pos(key)),
  /// The `(key, value)` pair at position `i` in the iteration order, or
  /// `.None` when `i` is out of range — Rust's `IndexMap::get_index`.
  get_index : (fn(self : &Self, i : usize) -> Option(MapEntry(K, V)))(
    self._entries.get(i)
  ),
  /// Remove all entries.
  clear : (fn(self : &mut Self) -> unit)({
    self._entries = ArrayList(MapEntry(K, V)).new();
    self._index = HashMap(u64, ArrayList(usize)).new();
  })
);
/// Iterator over the keys of an `OrderedMap` in insertion order.
OrderedMapKeys :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  ref(
    struct(
      _map : OrderedMap(K, V),
      _index : usize
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMapKeys(K, V),
  /// Next key in INSERTION order, or `.None` at the end — O(1), straight off
  /// the entry list.
  ///
  /// The keys are yielded by value (dup'd for a refcounted `K`). Inserting a
  /// new key during the walk appends to that list and so extends the walk;
  /// removing one shifts everything after the removed entry.
  next : (fn(self : &mut Self) -> Option(K))({
    cond(
      (self._index >= self._map._entries.len()) => {
        return(Option(K).None);
      },
      true => ()
    );
    k := match(
      self._map._entries.get(self._index),
      .Some(e) => Option(K).Some(__probe_dup(&e.key)),
      .None => Option(K).None
    );
    self._index = (self._index + usize(1));
    return(k);
  })
);
/// Iterator over the values of an `OrderedMap` in insertion order.
OrderedMapValues :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  ref(
    struct(
      _map : OrderedMap(K, V),
      _index : usize
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMapValues(K, V),
  /// Next value in the KEYS' insertion order, or `.None` at the end — O(1),
  /// a plain array read off the entry list.
  next : (fn(self : &mut Self) -> Option(V))({
    cond(
      (self._index >= self._map._entries.len()) => {
        return(Option(V).None);
      },
      true => ()
    );
    match(
      self._map._entries.get(self._index),
      .Some(e) => {
        self._index = (self._index + usize(1));
        return(Option(V).Some(e.value));
      },
      .None => {
        return(Option(V).None);
      }
    );
  })
);
/// Iterator over `(key, value)` pairs of an `OrderedMap` in insertion order.
OrderedMapIter :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  ref(
    struct(
      _map : OrderedMap(K, V),
      _index : usize
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMapIter(K, V),
  Iterator(
    Item : MapEntry(K, V),
    next : (fn(self : &mut Self) -> Option(MapEntry(K, V)))({
      cond(
        (self._index >= self._map._entries.len()) => {
          return(Option(MapEntry(K, V)).None);
        },
        true => ()
      );
      match(
        self._map._entries.get(self._index),
        .Some(e) => {
          self._index = (self._index + usize(1));
          return(Option(MapEntry(K, V)).Some(e));
        },
        .None => {
          return(Option(MapEntry(K, V)).None);
        }
      );
    })
  )
);
/// Pointer iterator over an `OrderedMap`'s `(key, value)` pairs, in insertion
/// order — what `iter()` returns (D14).
///
/// Each `next` yields a `*(MapEntry(K, V))` straight into the entry list's
/// buffer, so entries are borrowed rather than rebuilt by value, and writing
/// `p.*.value` updates the map in place. Any insertion that grows the buffer
/// reallocates it, and a `remove`/`swap_remove` shifts entries, so both
/// invalidate or reorder pointers already yielded.
OrderedMapIterPtr :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  ref(
    struct(
      _map : OrderedMap(K, V),
      _index : usize
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMapIterPtr(K, V),
  Iterator(
    Item : *MapEntry(K, V),
    next : (fn(self : &mut Self) -> Option(*MapEntry(K, V)))({
      cond(
        (self._index >= self._map._entries.len()) => {
          return(Option(*MapEntry(K, V)).None);
        },
        true => ()
      );
      match(
        self._map._entries.ptr(),
        .Some(base) => {
          p := base.add(self._index);
          self._index = (self._index + usize(1));
          return(Option(*MapEntry(K, V)).Some(p));
        },
        .None => {
          return(Option(*MapEntry(K, V)).None);
        }
      );
    })
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  IntoIterator(
    Item : MapEntry(K, V),
    IntoIter : OrderedMapIter(K, V),
    /// Iterate `(key, value)` pairs BY VALUE in insertion order — the shape
    /// `iter()` had before D14, and what `for(map, ...)` expands to.
    into_iter : (fn(self : &Self) -> OrderedMapIter(K, V))(
      OrderedMapIter(K, V)(_map : self, _index : usize(0))
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  /// Iterator over keys in insertion order.
  keys : (fn(self : &Self) -> OrderedMapKeys(K, V))(
    OrderedMapKeys(K, V)(_map : self, _index : usize(0))
  ),
  /// Iterator over values in insertion order.
  values : (fn(self : &Self) -> OrderedMapValues(K, V))(
    OrderedMapValues(K, V)(_map : self, _index : usize(0))
  ),
  /// Iterator over `(key, value)` pairs in insertion order, yielding a
  /// `*(MapEntry(K, V))` into the map's own storage (D14). Use `into_iter()`
  /// for the by-value form.
  iter : (fn(self : &Self) -> OrderedMapIterPtr(K, V))(
    OrderedMapIterPtr(K, V)(_map : self, _index : usize(0))
  )
);
/// The borrowed `for`'s cursor (decision 39, plans/VALUES_BY_DEFAULT.md): a
/// position in the entry list, re-checked against its live length at each
/// step. The element is the entry at that position, in place.
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : MapEntry(K, V),
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self._entries.len()),
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut MapEntry(K, V))({
      if(cur >= self._entries.len(), {
        __yo_panic("OrderedMap: walk cursor out of bounds");
      });
      self._entries.ptr().unwrap().add(cur)
    }),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
/// `Default` — the empty map.
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
export(
  OrderedMap,
  MapEntry,
  OrderedMapKeys,
  OrderedMapValues,
  OrderedMapIter,
  OrderedMapIterPtr
);
