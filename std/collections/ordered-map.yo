//! Insertion-ordered map.
//!
//! `OrderedMap(K, V)` preserves the order in which keys were first inserted,
//! similar to JavaScript's `Map` or Python's `dict` (≥ 3.7). The entries live
//! in one `ArrayList(Tuple(K, V))` in insertion order — the ONLY place a
//! key is stored — beside a hash index from each key's hash to the positions
//! of the entries whose key hashes to it, so lookup is O(1) average time and
//! the key is never copied
//! (`issues/fixed/2026-10-16-an-orderedmap-of-a-move-only-key-does-not-compile.md`).
//!
//! # Complexity
//!
//! - `set` (new key): O(1) amortized
//! - `set` (existing key): O(1) — value updated in place, order unchanged
//! - `get` / `contains_key`: O(1) average
//! - `remove`: O(n) — the entries after the removed one shift down a slot
//! - `swap_remove`: O(1) — moves the last entry into the removed slot, so the
//!   iteration order changes (Rust's `IndexMap::swap_remove`)
//! - `index_of` / `get_index`: O(1) — positional lookup, both directions
//! - `iter` / `keys` / `values`: O(n), in insertion order
//!
//! ## Example
//!
//! ```yo
//! { OrderedMap } :: import("std/collections/ordered-map");
//!
//! m := OrderedMap(String, i32).new();
//! m.insert(`alpha`, i32(1));
//! m.insert(`beta`, i32(2));
//! m.insert(`gamma`, i32(3));
//!
//! // Iteration yields keys in insertion order.
//! it := m.keys();
//! while(true, {
//!   match(
//!     it.next(),
//!     .Some(k) => println(&k),
//!     .None => break
//!   );
//! });
//! ```
//!
//! ## Stability
//!
//! unstable — `plans/archive/STD_API_STABILIZATION.md` §4 still lists one shape open
//! here: `remove` is O(n) because it rebuilds the key-order list, and the O(1)
//! `swap_remove` that `indexmap` offers beside it (removing by swapping the
//! last key into the hole, at the cost of the order) has not been decided.
//! Adding it would change what `remove`'s cost is worth accepting. Everything
//! else is settled: `iter()` lends, `iter_raw()` walks pointers, and the
//! `IntoIterator` impls make `for(map, ...)` work.
// `iter_raw()` yields `*(Tuple(K, V))` into the entry list's buffer (D14), so
// this module names a raw pointer type. The pointers come from
// `ArrayList.ptr` and are never dereferenced outside the in-place readers.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("./array-list");
{ HashMap, HashMapError } :: import("./hash-map");
{ DefaultHasher, DEFAULT_KEY_0, DEFAULT_KEY_1 } :: import("../hash.yo");
{ AllocError } :: import("../allocator.yo");
/// Ordered map preserving insertion order of keys.
/// Keys must implement `Eq` and `Hash`.
///
/// The key of each entry is stored ONCE, in `_entries`; `_index` maps the
/// key's HASH to the positions of the entries whose key hashes to it (two
/// keys can share a hash, so the value is a list of positions, each compared
/// by key in place). A move-only key — a `Drop` type, a `Box`, a plain type
/// with neither `Copy` nor `Clone` — therefore moves in with its entry and
/// out again, never through a copy.
OrderedMap :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  struct(
    /// The entries, in insertion order. The only home of each key.
    _entries : ArrayList(Tuple(K, V)),
    /// Each key's hash -> the positions in `_entries` of the entries whose
    /// key hashes to it. A list of positions, because a hash is not a key:
    /// on a lookup every position is compared by key, in place. This is
    /// what makes `swap_remove` O(1) and answers `index_of`; every write
    /// to `_entries` must keep it in step — the sites are `insert`,
    /// `remove` and `swap_remove` (`new` and `clear` start it empty).
    _index : HashMap(u64, ArrayList(usize))
  )
);
// A value since B10 (plans/VALUES_BY_DEFAULT.md): cloning clones the entries
// and the position index, which needs `K <: Clone` and `V <: Clone` (through
// the entry tuple's Clone and `HashMap`'s `Clone`).
derive(generic(K : Type, V : Type), where(K <: (Eq(K), Hash, Clone), V <: Clone), OrderedMap(K, V), Clone);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  /// Create an empty `OrderedMap`.
  new : (fn() -> Self)(
    Self(
      _entries : ArrayList(Tuple(K, V)).new(),
      _index : HashMap(u64, ArrayList(usize)).new()
    )
  ),
  /// Number of entries.
  len : (fn(self : &Self) -> usize)(self._entries.len()),
  /// Whether the map is empty.
  is_empty : (fn(self : &Self) -> bool)(self._entries.is_empty()),
  /// The entry buffer, for the in-place readers. Only called with a position
  /// below `len()`, so the buffer exists.
  _entries_ptr : (fn(self : &Self) -> *Tuple(K, V))(
    match(
      self._entries.ptr(),
      .Some(p) => p,
      .None => __yo_panic("OrderedMap: the entry list has no buffer")
    )
  ),
  /// A key's hash. The FIXED SipHash keys keep the index reproducible run to
  /// run, as `HashMap` does for its bucket order.
  _hash_key : (fn(self : &Self, key : &K) -> u64)({
    mut(h) := DefaultHasher.new_with_keys(DEFAULT_KEY_0, DEFAULT_KEY_1);
    key.hash(&mut h);
    h.finish()
  }),
  /// The position of `key` in `_entries`, comparing each candidate's key in
  /// place — a `&K` is all a lookup ever needs, so a move-only key is found.
  _find_pos : (fn(self : &Self, key : &K) -> Option(usize))({
    h := self._hash_key(key);
    cond(
      // The position list is lent where the index holds it: `get` would
      // copy the list, which is a value since B8.
      self._index.contains_key(&h) => self._find_among(&self._index(h), key),
      true => Option(usize).None
    )
  }),
  /// The entry among `positions` whose key is `key`, compared in place.
  _find_among : (fn(self : &Self, positions : &ArrayList(usize), key : &K) -> Option(usize))({
    (mut(found) : Option(usize)) = Option(usize).None;
    mut(i) := usize(0);
    while((i < positions.len()) && found.is_none(), i = (i + usize(1)), {
      pos := positions(i);
      ep := self._entries_ptr().add(pos);
      cond(
        (ep.*.0 == key.*) => {
          found = Option(usize).Some(pos);
        },
        true => ()
      );
    });
    found
  }),
  /// Record that `pos` holds an entry whose key hashes to `h`.
  ///
  /// The position list is written WHERE THE INDEX HOLDS IT, through the
  /// bucket's entry pointer — a projection into the map's own storage. A
  /// list read out with `get` is a copy once `ArrayList` is a value type,
  /// and a push onto the copy would be lost; the same holds for
  /// `_index_drop` and `_index_bump`.
  _index_add : (fn(self : &mut Self, h : u64, pos : usize) -> unit)(
    match(
      self._index.get_entry_ptr(&h),
      .Some(ep) => ep.*.1.push(pos),
      .None => {
        mut(fresh) := ArrayList(usize).new();
        fresh.push(pos);
        self._index.insert(h, fresh);
        ()
      }
    )
  ),
  /// Forget the position `pos` under `h` (`remove`/`swap_remove`).
  _index_drop : (fn(self : &mut Self, h : u64, pos : usize) -> unit)(
    match(
      self._index.get_entry_ptr(&h),
      .Some(ep) => {
        match(
          ep.*.1.index_of(&pos),
          .Some(i) => consume(ep.*.1.remove(i)),
          .None => ()
        );
        ()
      },
      .None => ()
    )
  ),
  /// Move a position record from `from` to `to` under `h` — the fix-up a
  /// shift or a swap leaves behind.
  _index_bump : (fn(self : &mut Self, h : u64, from : usize, to : usize) -> unit)(
    match(
      self._index.get_entry_ptr(&h),
      .Some(ep) => {
        match(
          ep.*.1.index_of(&from),
          .Some(i) => {
            consume(ep.*.1.remove(i));
            ep.*.1.insert(i, to);
          },
          .None => ()
        );
        ()
      },
      .None => ()
    )
  ),
  /// Returns `true` if `key` is present.
  contains_key : (fn(self : &Self, key : &K) -> bool)(self._find_pos(key).is_some()),
  /// Returns the value for `key`, or `.None`.
  get : (fn(self : &Self, key : &K) -> Option(V))(
    match(
      self._find_pos(key),
      .Some(pos) => Option(V).Some((self._entries_ptr().add(pos)).*.1),
      .None => Option(V).None
    )
  ),
  /// Insert or update `key -> value`.
  ///
  /// - For a new key, the whole entry (key and value) moves into the list.
  /// - For an existing key, only the value moves: it is swapped in place,
  ///   bitwise, and the old one moves out. The key never moves.
  ///
  /// Returns `Ok(.Some(old_value))` if key already existed, `Ok(.None)` for
  /// a new key, or `.Err(_)` on allocation failure.
  ///
  /// The allocator-aware form (D9); `insert` is the one to reach for.
  try_insert : (fn(self : &mut Self, key : K, value : V) -> Result(Option(V), HashMapError))(
    match(
      self._find_pos(&key),
      .Some(pos) => {
        // The old value moves out bitwise and the new one moves into its
        // slot (HashMap.try_insert's idiom): nothing is copied, and the key
        // stays where it is.
        p := self._entries_ptr().add(pos);
        old := __yo_ptr_read(unsafe(addr_of(p.*.1)));
        __yo_ptr_write(unsafe(addr_of(p.*.1)), value);
        Result(Option(V), HashMapError).Ok(Option(V).Some(old))
      },
      .None => {
        h := self._hash_key(&key);
        pos := self._entries.len();
        entry := (key, value);
        match(
          self._entries.try_push(entry),
          .Err(_) => Result(Option(V), HashMapError).Err(.AllocError(error : .OutOfMemory)),
          .Ok(_) => {
            self._index_add(h, pos);
            Result(Option(V), HashMapError).Ok(Option(V).None)
          }
        )
      }
    )
  ),
  /// Insert a key/value pair, returning the PREVIOUS value for that key.
  /// A new key is appended to the insertion order; an existing key keeps its
  /// position.
  ///
  /// PANICS on allocation failure (D9). Use `try_insert` to handle OOM.
  insert : (fn(self : &mut Self, key : K, value : V) -> Option(V))(
    match(
      Self.try_insert(self, key, value),
      .Ok(prev) => prev,
      .Err(_) => __yo_panic("OrderedMap.insert: allocation failed")
    )
  ),
  /// Remove `key`, keeping the insertion order of everything else — Rust's
  /// `IndexMap::shift_remove`. Returns the removed value or `.None`.
  ///
  /// O(n) in the number of entries AFTER the removed one: they each shift
  /// down a slot, and the hash index has to learn where they went. Use
  /// `swap_remove` when the order does not matter.
  remove : (fn(self : &mut Self, key : &K) -> Option(V))(
    match(
      self._find_pos(key),
      .None => Option(V).None,
      .Some(pos) => {
        // The stored key's hash, taken while the entry is still in place.
        h := self._hash_key(&((self._entries_ptr().add(pos)).*.0));
        self._index_drop(h, pos);
        // The whole entry moves out bitwise; a struct-pattern match takes
        // the value and drops the key.
        entry := self._entries.remove(pos);
        // Every entry after the hole slid down one slot: move its position
        // record down with it.
        mut(j) := pos;
        n := self._entries.len();
        while(j < n, j = (j + usize(1)), {
          hj := self._hash_key(&((self._entries_ptr().add(j)).*.0));
          self._index_bump(hj, j + usize(1), j);
        });
        match(entry, (_, v) => Option(V).Some(v))
      }
    )
  ),
  /// Remove `key` in O(1), moving the LAST entry into its position — Rust's
  /// `IndexMap::swap_remove`. Returns the removed value or `.None`.
  ///
  /// This CHANGES the iteration order, which is the whole trade: `remove`
  /// preserves insertion order and pays O(n) to rebuild the entry list, while
  /// this touches two slots and is done. Reach for it when you are draining
  /// a map, or when order stops mattering once a key is gone.
  swap_remove : (fn(self : &mut Self, key : &K) -> Option(V))(
    match(
      self._find_pos(key),
      .None => Option(V).None,
      .Some(pos) => {
        // The stored key's hash, taken while the entry is still in place.
        h := self._hash_key(&((self._entries_ptr().add(pos)).*.0));
        last := (self._entries.len() - usize(1));
        // The whole entry moves out bitwise; a struct-pattern match takes
        // the value and drops the key.
        entry := self._entries.swap_remove(pos);
        self._index_drop(h, pos);
        cond(
          (pos == last) => (),
          true => {
            // The entry that was last now sits at `pos`; move its position
            // record (after the drop above, so a hash it shares with the
            // removed key cannot collide with the old record).
            hlast := self._hash_key(&((self._entries_ptr().add(pos)).*.0));
            self._index_bump(hlast, last, pos);
          }
        );
        match(entry, (_, v) => Option(V).Some(v))
      }
    )
  ),
  /// The position of `key` in the iteration order, or `.None` if it is
  /// absent — Rust's `IndexMap::get_index_of`. O(1): the hash index that
  /// `swap_remove` needs already answers this.
  index_of : (fn(self : &Self, key : &K) -> Option(usize))(self._find_pos(key)),
  /// The `(key, value)` pair at position `i` in the iteration order, or
  /// `.None` when `i` is out of range — Rust's `IndexMap::get_index`.
  get_index : (fn(self : &Self, i : usize) -> Option(Tuple(K, V)))(
    // A clone (`Tuple(K, V) <: Clone`): the list keeps its entry (B8).
    self._entries.get_cloned(i)
  ),
  /// Remove all entries.
  clear : (fn(self : &mut Self) -> unit)({
    self._entries = ArrayList(Tuple(K, V)).new();
    self._index = HashMap(u64, ArrayList(usize)).new();
  })
);
/// Decision 20's cloning accessors (plans/VALUES_BY_DEFAULT.md): `get` for a
/// value that is not copied implicitly. The stored value is cloned in place,
/// never copied out first.
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash), V <: Clone),
  OrderedMap(K, V),
  /// A clone of the value for `key`, or `.None`.
  get_cloned : (fn(self : &Self, key : &K) -> Option(V))(
    match(
      self._find_pos(key),
      .Some(pos) => Option(V).Some((self._entries_ptr().add(pos)).*.1.clone()),
      .None => Option(V).None
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash, Clone), V <: Clone),
  OrderedMap(K, V),
  /// A clone of the `(key, value)` pair at position `i` in the iteration
  /// order, or `.None` when `i` is out of range — `get_index` for a key or
  /// value that is not copied implicitly.
  get_index_cloned : (fn(self : &Self, i : usize) -> Option(Tuple(K, V)))(
    self._entries.get_cloned(i)
  )
);
/// Iterator over the keys of an `OrderedMap` in insertion order.
OrderedMapIntoKeys :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  struct(
    _map : OrderedMap(K, V),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash, Clone)),
  OrderedMapIntoKeys(K, V),
  /// Next key in INSERTION order, or `.None` at the end — O(1), straight off
  /// the entry list.
  ///
  /// Each key is yielded as a clone (`K <: Clone`), as `HashMapIntoKeys` does:
  /// the entry list keeps its own (B8). Inserting a
  /// new key during the walk appends to that list and so extends the walk;
  /// removing one shifts everything after the removed entry.
  next : (fn(self : &mut Self) -> Option(K))({
    cond(
      (self._index >= self._map._entries.len()) => {
        return(Option(K).None);
      },
      true => ()
    );
    k := Option(K).Some(self._map._entries(self._index).0.clone());
    self._index = (self._index + usize(1));
    return(k);
  })
);
/// Iterator over the values of an `OrderedMap` in insertion order.
OrderedMapIntoValues :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  struct(
    _map : OrderedMap(K, V),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash), V <: Clone),
  OrderedMapIntoValues(K, V),
  /// Next value in the KEYS' insertion order, or `.None` at the end — O(1),
  /// a clone (`V <: Clone`) read off the entry list.
  next : (fn(self : &mut Self) -> Option(V))({
    cond(
      (self._index >= self._map._entries.len()) => {
        return(Option(V).None);
      },
      true => ()
    );
    v := self._map._entries(self._index).1.clone();
    self._index = (self._index + usize(1));
    Option(V).Some(v)
  })
);
/// Iterator over `(key, value)` pairs of an `OrderedMap` in insertion order.
OrderedMapIntoIter :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  struct(
    _map : OrderedMap(K, V),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash, Clone), V <: Clone),
  OrderedMapIntoIter(K, V),
  Iterator(
    Item : Tuple(K, V),
    next : (fn(self : &mut Self) -> Option(Tuple(K, V)))({
      cond(
        (self._index >= self._map._entries.len()) => {
          return(Option(Tuple(K, V)).None);
        },
        true => ()
      );
      // A clone of the entry (`K`, `V` <: Clone): the list keeps its own (B8).
      e := self._map._entries(self._index).clone();
      self._index = (self._index + usize(1));
      Option(Tuple(K, V)).Some(e)
    })
  )
);
/// Pointer iterator over an `OrderedMap`'s `(key, value)` pairs, in insertion
/// order — what `iter_raw()` returns (D14).
///
/// Each `next` yields a `*(Tuple(K, V))` straight into the entry list's
/// buffer, so entries are borrowed rather than rebuilt by value, and writing
/// `p.*.1` updates the map in place. A raw view (decision 39, B7b): it
/// holds the entry list's buffer pointer and the length `iter_raw()` saw, NOT the
/// map, so it keeps nothing alive and is meant for
/// `pragma(Pragma.AllowUnsafe)` code. The map must outlive the walk; any
/// insertion that grows the buffer reallocates it, and a
/// `remove`/`swap_remove` shifts entries, so both invalidate or reorder
/// pointers already yielded.
OrderedMapRawIter :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  struct(
    _ptr : ?*Tuple(K, V),
    _len : usize,
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMapRawIter(K, V),
  Iterator(
    Item : *Tuple(K, V),
    next : (fn(self : &mut Self) -> Option(*Tuple(K, V)))({
      cond(
        (self._index >= self._len) => {
          return(Option(*Tuple(K, V)).None);
        },
        true => ()
      );
      match(
        self._ptr,
        .Some(base) => {
          p := base.add(self._index);
          self._index = (self._index + usize(1));
          return(Option(*Tuple(K, V)).Some(p));
        },
        .None => {
          return(Option(*Tuple(K, V)).None);
        }
      );
    })
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  IntoIterator(
    Item : Tuple(K, V),
    IntoIter : OrderedMapIntoIter(K, V),
    /// Iterate `(key, value)` pairs BY VALUE in insertion order — what
    /// `for(map, ...)` expands to.
    into_iter : (fn(self : Self) -> OrderedMapIntoIter(K, V))(
      OrderedMapIntoIter(K, V)(_map : self, _index : usize(0))
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  /// Iterator over keys in insertion order. Consumes the map (lookahead
  /// D20).
  into_keys : (fn(self : Self) -> OrderedMapIntoKeys(K, V))(
    OrderedMapIntoKeys(K, V)(_map : self, _index : usize(0))
  ),
  /// Iterator over values in insertion order. Consumes the map (lookahead
  /// D20).
  into_values : (fn(self : Self) -> OrderedMapIntoValues(K, V))(
    OrderedMapIntoValues(K, V)(_map : self, _index : usize(0))
  ),
  /// Iterator over `(key, value)` pairs in insertion order, yielding a
  /// `*(Tuple(K, V))` into the map's own storage (D14): the
  /// `pragma(Pragma.AllowUnsafe)` form, whose iterator holds the entry
  /// buffer, not the map (B7b). Use `into_iter()` for the consuming by-value
  /// form and `for(&map, (k, v) => ...)` to read in place.
  iter_raw : (fn(self : &Self) -> OrderedMapRawIter(K, V))(
    OrderedMapRawIter(K, V)(_ptr : self._entries.ptr(), _len : self._entries.len(), _index : usize(0))
  )
);
/// `Default` — the empty map.
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
/// The shared walk over a `OrderedMap` (Rust's `indexmap::Iter<'a, K, V>`): a `&(OrderedMap(K, V), p)` lend and a
/// position, yielding each entry as `(&(K, p), &(V, p))`. Binding the cursor
/// freezes the map for its life (E0911 on a write), which is what makes the
/// borrowed `for(&map, (k, v) => body)` lower to the value form over
/// `(&map).into_iter()`.
OrderedMapIter :: (fn(comptime(K) : Type, comptime(V) : Type, comptime(p) : Origin) -> comptime(Type))(
  struct(
    _coll : &(OrderedMap(K, V), p),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type, p : Origin),
  where(K <: (Eq(K), Hash)),
  OrderedMapIter(K, V, p),
  Iterator(
    Item : Tuple(&(K, p), &(V, p)),
    next : (fn(self : &mut Self) -> Option(Tuple(&(K, p), &(V, p))))({
      at := self._index;
      cond(
        (at >= self._coll._entries.len()) => .None,
        true => {
          self._index = (at + usize(1));
          .Some((&self._coll._entries.ptr().unwrap().add(at).*.0, &self._coll._entries.ptr().unwrap().add(at).*.1))
        }
      )
    })
  )
);
impl(
  generic(K : Type, V : Type, p : Origin),
  where(K <: (Eq(K), Hash)),
  &(OrderedMap(K, V), p),
  IntoIterator(
    Item : Tuple(&(K, p), &(V, p)),
    IntoIter : OrderedMapIter(K, V, p),
    into_iter : (fn(self : Self) -> OrderedMapIter(K, V, p))(OrderedMapIter(K, V, p)(_coll : self, _index : usize(0)))
  )
);
/// The write walk over a `OrderedMap` (Rust's `indexmap::IterMut<'a, K, V>`): a `&mut(OrderedMap(K, V), p)` lend and a
/// position, yielding each entry as `(&(K, p), &mut(V, p))`: the key is read-only
/// (a written key would break the map's order), the value is writable. The map is
/// frozen exclusively while the cursor lives.
OrderedMapIterMut :: (fn(comptime(K) : Type, comptime(V) : Type, comptime(p) : Origin) -> comptime(Type))(
  struct(
    _coll : &mut(OrderedMap(K, V), p),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type, p : Origin),
  where(K <: (Eq(K), Hash)),
  OrderedMapIterMut(K, V, p),
  Iterator(
    Item : Tuple(&(K, p), &mut(V, p)),
    next : (fn(self : &mut Self) -> Option(Tuple(&(K, p), &mut(V, p))))({
      at := self._index;
      cond(
        (at >= self._coll._entries.len()) => .None,
        true => {
          self._index = (at + usize(1));
          .Some((&self._coll._entries.ptr().unwrap().add(at).*.0, &mut self._coll._entries.ptr().unwrap().add(at).*.1))
        }
      )
    })
  )
);
impl(
  generic(K : Type, V : Type, p : Origin),
  where(K <: (Eq(K), Hash)),
  &mut(OrderedMap(K, V), p),
  IntoIterator(
    Item : Tuple(&(K, p), &mut(V, p)),
    IntoIter : OrderedMapIterMut(K, V, p),
    into_iter : (fn(self : Self) -> OrderedMapIterMut(K, V, p))(OrderedMapIterMut(K, V, p)(_coll : self, _index : usize(0)))
  )
);
impl(
  generic(K : Type, V : Type),
  OrderedMap(K, V),
  /// The shared walk, Rust's `iter()`: each element as a `Tuple(&K, &V)` rooted at the
  /// collection, which stays frozen while the iterator lives. `for(&c, x => …)`
  /// is the same walk.
  iter : (fn(self : &Self) -> OrderedMapIter(K, V, self))(OrderedMapIter(K, V, self)(_coll : self, _index : usize(0))),
  /// The write walk, Rust's `iter_mut()`: each element as a `Tuple(&K, &mut V)`.
  /// `for(&mut c, x => …)` is the same walk.
  iter_mut : (fn(self : &mut Self) -> OrderedMapIterMut(K, V, self))(OrderedMapIterMut(K, V, self)(_coll : self, _index : usize(0)))
);
/// The keys of a borrowed map, Rust's `keys()`: each key as a `&K` rooted at
/// the map, in the order `iter()` walks.
OrderedMapKeys :: (fn(comptime(K) : Type, comptime(V) : Type, comptime(p) : Origin) -> comptime(Type))(
  struct(_inner : OrderedMapIter(K, V, p))
);
impl(
  generic(K : Type, V : Type, p : Origin),
  where(K <: (Eq(K), Hash)),
  OrderedMapKeys(K, V, p),
  Iterator(
    Item : &(K, p),
    next : (fn(self : &mut Self) -> Option(&(K, p)))(
      match(self._inner.next(), .Some(kv) => .Some(kv.0), .None => .None)
    )
  )
);
/// The values of a borrowed map, Rust's `values()`: each value as a `&V`.
OrderedMapValues :: (fn(comptime(K) : Type, comptime(V) : Type, comptime(p) : Origin) -> comptime(Type))(
  struct(_inner : OrderedMapIter(K, V, p))
);
impl(
  generic(K : Type, V : Type, p : Origin),
  where(K <: (Eq(K), Hash)),
  OrderedMapValues(K, V, p),
  Iterator(
    Item : &(V, p),
    next : (fn(self : &mut Self) -> Option(&(V, p)))(
      match(self._inner.next(), .Some((_, v)) => .Some(v), .None => .None)
    )
  )
);
/// The values of an exclusively borrowed map, Rust's `values_mut()`: each
/// value as a `&mut V`.
OrderedMapValuesMut :: (fn(comptime(K) : Type, comptime(V) : Type, comptime(p) : Origin) -> comptime(Type))(
  struct(_inner : OrderedMapIterMut(K, V, p))
);
impl(
  generic(K : Type, V : Type, p : Origin),
  where(K <: (Eq(K), Hash)),
  OrderedMapValuesMut(K, V, p),
  Iterator(
    Item : &mut(V, p),
    next : (fn(self : &mut Self) -> Option(&mut(V, p)))(
      match(self._inner.next(), .Some((_, v)) => .Some(v), .None => .None)
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  OrderedMap(K, V),
  /// Each key as a `&K` (Rust's `keys()`); `into_keys()` moves them out.
  keys : (fn(self : &Self) -> OrderedMapKeys(K, V, self))(OrderedMapKeys(K, V, self)(_inner : self.iter())),
  /// Each value as a `&V` (Rust's `values()`); `into_values()` moves them out.
  values : (fn(self : &Self) -> OrderedMapValues(K, V, self))(OrderedMapValues(K, V, self)(_inner : self.iter())),
  /// Each value as a `&mut V` (Rust's `values_mut()`).
  values_mut : (fn(self : &mut Self) -> OrderedMapValuesMut(K, V, self))(OrderedMapValuesMut(K, V, self)(_inner : self.iter_mut()))
);
export(
  OrderedMap,
  OrderedMapIntoKeys,
  OrderedMapIntoValues,
  OrderedMapIntoIter,
  OrderedMapRawIter,
  OrderedMapIter,
  OrderedMapIterMut,
  OrderedMapKeys,
  OrderedMapValues,
  OrderedMapValuesMut
);
