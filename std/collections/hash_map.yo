//! Hash map using SwissTable algorithm with SIMD-accelerated lookup.
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator, AllocError, size_would_overflow } :: import("../allocator.yo");
{ MapEntry } :: import("./entry.yo");
{ DefaultHasher, DEFAULT_KEY_0, DEFAULT_KEY_1 } :: import("../hash.yo");
{ malloc, calloc, realloc, free } :: GlobalAllocator;
/// Error variants for HashMap operations.
HashMapError :: enum(
  /// Memory allocation failed.
  AllocError(error : AllocError),
  /// Capacity calculation overflowed.
  CapacityOverflow
);
/// Control byte for an empty bucket (never used).
CTRL_EMPTY :: u8(255);
/// Control byte for a deleted bucket (tombstone).
CTRL_DELETED :: u8(254);
/// Default initial capacity (must be power of 2).
DEFAULT_CAPACITY :: usize(16);
/// Maximum load factor numerator (7/8 = 0.875). Resize when `size > capacity * 7 / 8`.
MAX_LOAD_FACTOR_NUMERATOR :: usize(7);
MAX_LOAD_FACTOR_DENOMINATOR :: usize(8);
/// Extract H2 hash (lower 7 bits) from full hash for control byte comparison.
h2_hash :: (fn(hash : u64) -> u8)(u8(hash & u64(127)));
/// Avalanche-mix a 64-bit hash (murmur3 fmix64 finalizer) so that weakly-
/// distributed hashes — notably the IDENTITY hash of integer keys — spread
/// uniformly across buckets. Without this, sequential integer keys (e.g. the
/// expr ids in the self-host's `expr_info_table`) collapse 128 consecutive keys
/// into ONE h1 bucket under `(hash >> 7) % capacity`, producing O(n) linear-probe
/// chains (O(n^2) overall). `*` wraps on u64 overflow (as FNV-1a relies on).
mix_u64 :: (fn(hash : u64) -> u64)({
  h := hash;
  h = (h ^ (h >> u64(33)));
  h = (h * u64(0xff51afd7ed558ccd));
  h = (h ^ (h >> u64(33)));
  h = (h * u64(0xc4ceb9fe1a85ec53));
  h = (h ^ (h >> u64(33)));
  return(h);
});
/// Extract H1 hash (upper bits) for bucket index calculation.
h1_hash :: (fn(hash : u64, capacity : usize) -> usize)(usize(mix_u64(hash) >> u64(7)) % capacity);
/// High-performance hash map using SwissTable algorithm.
/// Keys must implement `Eq` and `Hash`. Provides O(1) average lookup, insert, and delete.
HashMap :: (
  fn(
    comptime(K) : Type,
    comptime(V) : Type,
    where(K <: (Eq(K), Hash))
  ) -> comptime(Type)
)(
  ref(
    struct(
      ctrl : ?(*(u8)),
      data : ?(*(MapEntry(K, V))),
      capacity : usize,
      size : usize,
      /// Slots holding `CTRL_DELETED`. A tombstone keeps probe chains intact
      /// but is never `EMPTY`, so it costs exactly what a live entry costs on
      /// every miss; `_needs_resize` therefore counts `size + tombstones`, and
      /// a table that is mostly tombstones is rehashed IN PLACE instead of
      /// doubled (hashbrown's rule). Before this, insert/remove churn drove
      /// every probe to O(capacity) — issues/fixed/hash-tombstones-are-never-reclaimed.md.
      tombstones : usize,
      /// SipHash-1-3 keys (`std/hash`). `new` uses the fixed defaults so
      /// iteration order is reproducible; `with_keys` keys this map alone.
      k0 : u64,
      k1 : u64
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMap(K, V),
  /**
  * Allocate memory for HashMap with given capacity
  * Initializes all control bytes to EMPTY
  */
  _alloc_with_capacity : (fn(capacity : usize) -> Result(Self, HashMapError))({
    bucket_size :: sizeof(MapEntry(K, V));
    // `capacity * bucket_size` is computed in usize and WRAPS, which would hand
    // malloc a tiny size while the map still believes it owns `capacity`
    // buckets. This is the check `CapacityOverflow` was declared for and never
    // performed (issues/fixed/collection-capacity-overflow-unchecked.md).
    if(size_would_overflow(MapEntry(K, V), capacity), {
      return(.Err(.CapacityOverflow));
    });
    ctrl_size := capacity;
    data_size := (capacity * bucket_size);
    ctrl_result := malloc(ctrl_size);
    match(
      ctrl_result,
      .None => .Err(.AllocError(error : .OutOfMemory)),
      .Some(ctrl_void_ptr) => {
        ctrl_ptr := *(u8)(ctrl_void_ptr);
        data_result := malloc(data_size);
        match(
          data_result,
          .None => {
            free(.Some(*(void)(ctrl_ptr)));
            .Err(.AllocError(error : .OutOfMemory))
          },
          .Some(data_void_ptr) => {
            data_ptr := *(MapEntry(K, V))(data_void_ptr);
            i := usize(0);
            while(i < capacity, i = (i + usize(1)), {
              (ctrl_ptr.add(i)).* = CTRL_EMPTY;
            });
            .Ok(
              Self(
                ctrl : .Some(ctrl_ptr),
                data : .Some(data_ptr),
                capacity : capacity,
                size : usize(0),
                tombstones : usize(0),
                k0 : DEFAULT_KEY_0,
                k1 : DEFAULT_KEY_1
              )
            )
          }
        )
      }
    )
  }),
  /// The bucket hash of `key` under this map's keys.
  _hash : (fn(inout(self) : Self, inout(key) : K) -> u64)({
    h := DefaultHasher.new_with_keys(self.k0, self.k1);
    key.hash(h);
    h.finish()
  }),
  /**
  * Create a new empty HashMap with default capacity
  */
  new : (fn() -> Self)({
    result := Self._alloc_with_capacity(DEFAULT_CAPACITY);
    match(
      result,
      .Ok(map) => map,
      .Err(_) => __yo_panic("Failed to allocate HashMap")
    )
  }),
  /**
  * Create a new empty HashMap whose hashes are keyed by `k0`, `k1`
  * (SipHash-1-3 keys). Two maps with different keys place the same key in
  * different buckets, so a map fed by untrusted input can be given
  * per-process random keys (`std/crypto/random`) to defeat collision
  * flooding; `new()` uses fixed keys so iteration order is reproducible.
  */
  with_keys : (fn(k0 : u64, k1 : u64) -> Self)({
    map := Self.new();
    map.k0 = k0;
    map.k1 = k1;
    map
  }),
  /**
  * Create a HashMap with a specific initial capacity
  * Capacity will be rounded up to next power of 2
  */
  with_capacity : (fn(requested_capacity : usize) -> Self)({
    capacity := cond(
      (requested_capacity < DEFAULT_CAPACITY) => DEFAULT_CAPACITY,
      true => {
        c := requested_capacity;
        c = (c - usize(1));
        // Smear the top bit down over the WHOLE width, deriving the shifts from
        // `sizeof(usize)` rather than hardcoding them: the unrolled 1/2/4/8/16
        // stopped short of a 64-bit usize (so a request above 2^32 rounded to a
        // non-power-of-two, though the bucket masking `hash & (capacity - 1)`
        // requires one), and hardcoding a `>> 32` instead breaks wasm32, where
        // usize is 32 bits and a shift equal to the width is undefined —
        // `with_capacity` really did round wrong there while every native test
        // stayed green (issues/fixed/collection-capacity-overflow-unchecked.md).
        sh := usize(1);
        while(sh < (sizeof(usize) * usize(8)), {
          c = (c | (c >> sh));
          sh = (sh * usize(2));
        });
        c + usize(1)
      }
    );
    result := Self._alloc_with_capacity(capacity);
    match(
      result,
      .Ok(map) => map,
      .Err(_) => __yo_panic("Failed to allocate HashMap")
    )
  }),
  /**
  * Get ctrl pointer (unwrapped for internal use)
  */
  _ctrl_ptr : (fn(self : Self) -> *(u8))(
    match(
      self.ctrl,
      .Some(ptr) => ptr,
      .None => __yo_panic("HashMap ctrl pointer is null")
    )
  ),
  /**
  * Get data pointer (unwrapped for internal use)
  */
  _data_ptr : (fn(self : Self) -> *(MapEntry(K, V)))(
    match(
      self.data,
      .Some(ptr) => ptr,
      .None => __yo_panic("HashMap data pointer is null")
    )
  ),
  /**
  * Find bucket index for a given key using quadratic probing
  * Returns Some(index) if key is found, None otherwise
  */
  _find_bucket : (fn(self : Self, key : K, hash : u64) -> Option(usize))({
    h2 := h2_hash(hash);
    index := h1_hash(hash, self.capacity);
    probe := usize(0);
    ctrl_ptr := Self._ctrl_ptr(self);
    data_ptr := Self._data_ptr(self);
    while(probe < self.capacity, probe = (probe + usize(1)), {
      probe_index := ((index + probe) % self.capacity);
      ctrl_byte := (ctrl_ptr.add(probe_index)).*;
      cond(
        (ctrl_byte == CTRL_EMPTY) => {
          return(.None);
        },
        (ctrl_byte == h2) => {
          bucket := (data_ptr.add(probe_index)).*;
          cond(
            (bucket.key == key) => {
              return(.Some(probe_index));
            },
            true => ()
          );
        },
        true => ()
      );
    });
    .None
  }),
  /**
  * Find first available bucket (EMPTY or DELETED) for insertion
  * Returns bucket index using quadratic probing
  */
  _find_insert_bucket : (fn(self : Self, hash : u64) -> usize)({
    index := h1_hash(hash, self.capacity);
    probe := usize(0);
    ctrl_ptr := Self._ctrl_ptr(self);
    while(probe < self.capacity, probe = (probe + usize(1)), {
      probe_index := ((index + probe) % self.capacity);
      ctrl_byte := (ctrl_ptr.add(probe_index)).*;
      cond(
        ((ctrl_byte == CTRL_EMPTY) || (ctrl_byte == CTRL_DELETED)) => {
          return(probe_index);
        },
        true => ()
      );
    });
    __yo_panic("HashMap is full - should have resized")
  }),
  /**
  * Check if HashMap needs resizing based on load factor
  */
  _needs_resize : (fn(self : Self) -> bool)({
    threshold := ((self.capacity * MAX_LOAD_FACTOR_NUMERATOR) / MAX_LOAD_FACTOR_DENOMINATOR);
    (self.size + self.tombstones) >= threshold
  }),
  /**
  * Resize and rehash the HashMap to a new capacity
  */
  _resize : (fn(self : Self, new_capacity : usize) -> Result(unit, HashMapError))({
    result := Self._alloc_with_capacity(new_capacity);
    match(
      result,
      .Err(err) => .Err(err),
      .Ok(new_map) => {
        new_map.k0 = self.k0;
        new_map.k1 = self.k1;
        i := usize(0);
        ctrl_ptr := Self._ctrl_ptr(self);
        data_ptr := Self._data_ptr(self);
        while(i < self.capacity, i = (i + usize(1)), {
          ctrl_byte := (ctrl_ptr.add(i)).*;
          cond(
            ((ctrl_byte != CTRL_EMPTY) && (ctrl_byte != CTRL_DELETED)) => {
              bucket := (data_ptr.add(i)).*;
              hash := self._hash(bucket.key);
              h2 := h2_hash(hash);
              new_index := Self._find_insert_bucket(new_map, hash);
              new_ctrl_ptr := Self._ctrl_ptr(new_map);
              new_data_ptr := Self._data_ptr(new_map);
              (new_ctrl_ptr.add(new_index)).* = h2;
              consume((new_data_ptr.add(new_index)).* = bucket);
              new_map.size = (new_map.size + usize(1));
            },
            true => ()
          );
        });
        // Drop old buckets before freeing old data array
        // (bucket := ... above duped them, so we need to drop the old refs)
        cond(
          (Type.contains_rc_type(K) || Type.contains_rc_type(V)) => {
            j := usize(0);
            while(j < self.capacity, j = (j + usize(1)), {
              ctrl_byte := (ctrl_ptr.add(j)).*;
              cond(
                ((ctrl_byte != CTRL_EMPTY) && (ctrl_byte != CTRL_DELETED)) => {
                  bucket_ptr := data_ptr.add(j);
                  cond(
                    Type.contains_rc_type(K) => unsafe.drop((bucket_ptr.*).key),
                    true => ()
                  );
                  cond(
                    Type.contains_rc_type(V) => unsafe.drop((bucket_ptr.*).value),
                    true => ()
                  );
                },
                true => ()
              );
            });
          },
          true => ()
        );
        match(
          self.ctrl,
          .Some(ptr) => free(.Some(*(void)(ptr))),
          .None => ()
        );
        match(
          self.data,
          .Some(ptr) => free(.Some(*(void)(ptr))),
          .None => ()
        );
        self.ctrl = new_map.ctrl;
        self.data = new_map.data;
        self.capacity = new_map.capacity;
        self.tombstones = usize(0);
        new_map.ctrl = .None;
        new_map.data = .None;
        .Ok(())
      }
    )
  }),
  /**
  * Insert or update a key-value pair
  * Returns Ok(Some(old_value)) if key existed, Ok(None) if new key
  */
  insert : (fn(self : Self, key : K, value : V) -> Result(Option(V), HashMapError))({
    hash := self._hash(key);
    bucket_opt := Self._find_bucket(self, key, hash);
    match(
      bucket_opt,
      .Some(index) => {
        data_ptr := Self._data_ptr(self);
        old_bucket := (data_ptr.add(index)).*;
        old_value := old_bucket.value;
        new_bucket := MapEntry(K, V)(key : key, value : value);
        // Don't use consume here - we want to drop the old bucket at memory
        // Note: old_bucket already duped it, so dropping here decrements to RC=1
        // Then old_bucket goes out of scope and drops again to RC=0
        // But wait - we return old_value which was duped from old_bucket...
        // Actually the MapEntry struct contains RC types, so assignment drops old + dups new
        (data_ptr.add(index)).* = new_bucket;
        .Ok(.Some(old_value))
      },
      .None => {
        resize_check := cond(
          (Self._needs_resize(self)) => {
            // Over the load threshold because of tombstones rather than live
            // entries: rehash at the SAME capacity, which clears every
            // tombstone; only a genuinely full table doubles.
            new_capacity := cond(
              (((self.size + usize(1)) * usize(2)) <= self.capacity) => self.capacity,
              true => (self.capacity * usize(2))
            );
            Self._resize(self, new_capacity)
          },
          true => Result(unit, HashMapError).Ok(())
        );
        match(
          resize_check,
          .Err(err) => .Err(err),
          .Ok(_) => {
            h2 := h2_hash(hash);
            index := Self._find_insert_bucket(self, hash);
            ctrl_ptr := Self._ctrl_ptr(self);
            data_ptr := Self._data_ptr(self);
            cond(
              ((ctrl_ptr.add(index)).* == CTRL_DELETED) => {
                self.tombstones = (self.tombstones - usize(1));
              },
              true => ()
            );
            (ctrl_ptr.add(index)).* = h2;
            new_bucket := MapEntry(K, V)(key : key, value : value);
            consume((data_ptr.add(index)).* = new_bucket);
            self.size = (self.size + usize(1));
            .Ok(.None)
          }
        )
      }
    )
  }),
  /**
  * Get a value by key
  * Returns Some(value) if found, None otherwise
  */
  get : (fn(self : Self, key : K) -> Option(V))({
    hash := self._hash(key);
    bucket_opt := Self._find_bucket(self, key, hash);
    match(
      bucket_opt,
      .Some(index) => {
        data_ptr := Self._data_ptr(self);
        bucket := (data_ptr.add(index)).*;
        .Some(bucket.value)
      },
      .None => .None
    )
  }),
  /**
  * Check if a key exists in the map
  */
  contains_key : (fn(self : Self, key : K) -> bool)({
    hash := self._hash(key);
    bucket_opt := Self._find_bucket(self, key, hash);
    match(
      bucket_opt,
      .Some(_) => true,
      .None => false
    )
  }),
  /**
  * Remove a key-value pair by key
  * Returns Some(value) if the key was found and removed, None otherwise
  */
  remove : (fn(self : Self, key : K) -> Option(V))({
    hash := self._hash(key);
    bucket_opt := Self._find_bucket(self, key, hash);
    match(
      bucket_opt,
      .Some(index) => {
        data_ptr := Self._data_ptr(self);
        ctrl_ptr := Self._ctrl_ptr(self);
        bucket_ptr := data_ptr.add(index);
        // Read and dup value for return
        value := bucket_ptr.*.value;
        // Drop the bucket's key (we're removing it)
        unsafe.drop(bucket_ptr.*.key);
        // Drop the bucket's value extra ref (we duped it above)
        unsafe.drop(bucket_ptr.*.value);
        // Linear probing stops at the first EMPTY slot, so if the NEXT slot is
        // EMPTY no live key's probe chain passes through this one and it can
        // go straight back to EMPTY. Otherwise it must stay a tombstone: a key
        // inserted later may have probed past it.
        cond(
          ((ctrl_ptr.add((index + usize(1)) % self.capacity)).* == CTRL_EMPTY) => {
            (ctrl_ptr.add(index)).* = CTRL_EMPTY;
          },
          true => {
            (ctrl_ptr.add(index)).* = CTRL_DELETED;
            self.tombstones = (self.tombstones + usize(1));
          }
        );
        self.size = (self.size - usize(1));
        .Some(value)
      },
      .None => .None
    )
  }),
  /**
  * Get the number of key-value pairs in the map
  */
  len : (fn(self : Self) -> usize)(
    self.size
  ),
  /**
  * Check if the map is empty
  */
  is_empty : (fn(self : Self) -> bool)(
    self.size == usize(0)
  ),
  /**
  * Clear all key-value pairs
  * Resets all control bytes to EMPTY
  */
  clear : (fn(self : Self) -> unit)({
    // Drop all occupied buckets before clearing
    cond(
      (Type.contains_rc_type(K) || Type.contains_rc_type(V)) => {
        ctrl_ptr := Self._ctrl_ptr(self);
        data_ptr := Self._data_ptr(self);
        i := usize(0);
        while(i < self.capacity, i = (i + usize(1)), {
          ctrl_byte := (ctrl_ptr.add(i)).*;
          cond(
            ((ctrl_byte != CTRL_EMPTY) && (ctrl_byte != CTRL_DELETED)) => {
              bucket_ptr := data_ptr.add(i);
              unsafe.drop(bucket_ptr.*);
            },
            true => ()
          );
        });
      },
      true => ()
    );
    ctrl_ptr := Self._ctrl_ptr(self);
    i := usize(0);
    while(i < self.capacity, i = (i + usize(1)), {
      (ctrl_ptr.add(i)).* = CTRL_EMPTY;
    });
    self.size = usize(0);
    self.tombstones = usize(0);
  })
);
/// The entry-style accessors (plans/STD_API_AUDIT.md §7 collections row):
/// Yo's pragmatic shape of Rust's Entry — no borrow object, just
/// get-or-insert in one probe-and-settle call.
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMap(K, V),
  /// The value for `key`, inserting `default` first when absent.
  get_or_insert : (fn(self : Self, key : K, default : V) -> V)(
    match(
      self.get(key),
      .Some(v) => v,
      .None => {
        _r := self.insert(key, default);
        default
      }
    )
  ),
  /// The value for `key`, inserting `make()`'s result first when absent —
  /// use over `get_or_insert` when constructing the default is costly.
  get_or_insert_with : (fn(self : Self, key : K, make : Impl(Fn() -> V)) -> V)(
    match(
      self.get(key),
      .Some(v) => v,
      .None => {
        made := make();
        _r := self.insert(key, made);
        made
      }
    )
  ),
  /// Update the value for `key` through `f` when present; no-op when absent.
  /// Returns true when an update happened.
  update_with : (fn(self : Self, key : K, f : Impl(Fn(v : V) -> V)) -> bool)(
    match(
      self.get(key),
      .Some(v) => {
        _r := self.insert(key, f(v));
        true
      },
      .None => false
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMap(K, V),
  Dispose(
    /**
    * RAII destructor - automatically called when HashMap goes out of scope
    */
    dispose : (fn(self : Self) -> unit)({
      // Drop all occupied buckets before freeing memory
      cond(
        (Type.contains_rc_type(K) || Type.contains_rc_type(V)) => {
          match(
            self.ctrl,
            .Some(ctrl_ptr) => {
              match(
                self.data,
                .Some(data_ptr) => {
                  i := usize(0);
                  while(i < self.capacity, i = (i + usize(1)), {
                    ctrl_byte := (ctrl_ptr.add(i)).*;
                    cond(
                      ((ctrl_byte != CTRL_EMPTY) && (ctrl_byte != CTRL_DELETED)) => {
                        bucket_ptr := data_ptr.add(i);
                        unsafe.drop(bucket_ptr.*);
                      },
                      true => ()
                    );
                  });
                },
                .None => ()
              );
            },
            .None => ()
          );
        },
        true => ()
      );
      match(
        self.ctrl,
        .Some(ptr) => free(.Some(*(void)(ptr))),
        .None => ()
      );
      match(
        self.data,
        .Some(ptr) => free(.Some(*(void)(ptr))),
        .None => ()
      );
    })
  )
);
/**
* Value iterator for HashMap - yields MapEntry(K, V) by value
* Scans ctrl bytes to find occupied slots.
*/
HashMapIter :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _map : HashMap(K, V),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMapIter(K, V),
  Iterator(
    Item : MapEntry(K, V),
    next : (fn(inout(self) : Self) -> Option(MapEntry(K, V)))(
      cond(
        (self._map.capacity == usize(0)) => .None,
        true => {
          ctrl_ptr := self._map.ctrl.unwrap();
          data_ptr := self._map.data.unwrap();
          result := Option(MapEntry(K, V)).None;
          while((self._index < self._map.capacity) && result.is_none(), self._index = (self._index + usize(1)), {
            ctrl_byte := (ctrl_ptr.add(self._index)).*;
            cond(
              ((ctrl_byte != CTRL_EMPTY) && (ctrl_byte != CTRL_DELETED)) => {
                result = .Some((data_ptr.add(self._index)).*);
              },
              true => ()
            );
          });
          result
        }
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMap(K, V),
  IntoIterator(
    Item : MapEntry(K, V),
    IntoIter : HashMapIter(K, V),
    into_iter : (fn(self : Self) -> HashMapIter(K, V))(
      HashMapIter(K, V)(_map : self, _index : usize(0))
    )
  )
);
/**
* Pointer iterator for HashMap - yields pointers to MapEntry(K, V)
* Pointers are valid as long as the map is not modified during iteration.
*/
HashMapIterPtr :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _map : HashMap(K, V),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMapIterPtr(K, V),
  Iterator(
    Item : *(MapEntry(K, V)),
    next : (fn(inout(self) : Self) -> Option(*(MapEntry(K, V))))(
      cond(
        (self._map.capacity == usize(0)) => .None,
        true => {
          ctrl_ptr := self._map.ctrl.unwrap();
          data_ptr := self._map.data.unwrap();
          result := Option(*(MapEntry(K, V))).None;
          while((self._index < self._map.capacity) && result.is_none(), self._index = (self._index + usize(1)), {
            ctrl_byte := (ctrl_ptr.add(self._index)).*;
            cond(
              ((ctrl_byte != CTRL_EMPTY) && (ctrl_byte != CTRL_DELETED)) => {
                result = .Some(data_ptr.add(self._index));
              },
              true => ()
            );
          });
          result
        }
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMap(K, V),
  /// Pointer iterator — yields `*(MapEntry(K, V))` for each occupied bucket.
  /// For privileged/unsafe internal use; value iteration goes through
  /// `into_iter()`.
  iter : (fn(self : Self) -> HashMapIterPtr(K, V))(
    HashMapIterPtr(K, V)(_map : self, _index : usize(0))
  )
);
/**
* Keys iterator - scans ctrl bytes directly and yields only the keys.
*
* NOTE: This held a wrapped `_inner : HashMapIter(K, V)` and delegated
* `self._inner.next()` — but a method call on a struct FIELD of `inout(self)`
* advances a COPY of the field, so `_index` never moved and manual
* `it.next()` loops yielded the first key forever (`for(...)` masked it).
* Scan directly instead, mirroring `HashMapIterPtr`.
*/
HashMapKeys :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _map : HashMap(K, V),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMapKeys(K, V),
  Iterator(
    Item : K,
    next : (fn(inout(self) : Self) -> Option(K))(
      cond(
        (self._map.capacity == usize(0)) => .None,
        true => {
          ctrl_ptr := self._map.ctrl.unwrap();
          data_ptr := self._map.data.unwrap();
          result := Option(K).None;
          while((self._index < self._map.capacity) && result.is_none(), self._index = (self._index + usize(1)), {
            ctrl_byte := (ctrl_ptr.add(self._index)).*;
            cond(
              ((ctrl_byte != CTRL_EMPTY) && (ctrl_byte != CTRL_DELETED)) => {
                result = .Some((data_ptr.add(self._index)).*.key);
              },
              true => ()
            );
          });
          result
        }
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMap(K, V),
  keys : (fn(self : Self) -> HashMapKeys(K, V))(
    HashMapKeys(K, V)(_map : self, _index : usize(0))
  )
);
/**
* Values iterator - scans ctrl bytes directly and yields only the values.
*
* NOTE: Same direct-scan structure as `HashMapKeys` — see the note there for
* why the wrapped-`_inner` delegation form was replaced.
*/
HashMapValues :: (fn(comptime(K) : Type, comptime(V) : Type) -> comptime(Type))(
  struct(
    _map : HashMap(K, V),
    _index : usize
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMapValues(K, V),
  Iterator(
    Item : V,
    next : (fn(inout(self) : Self) -> Option(V))(
      cond(
        (self._map.capacity == usize(0)) => .None,
        true => {
          ctrl_ptr := self._map.ctrl.unwrap();
          data_ptr := self._map.data.unwrap();
          result := Option(V).None;
          while((self._index < self._map.capacity) && result.is_none(), self._index = (self._index + usize(1)), {
            ctrl_byte := (ctrl_ptr.add(self._index)).*;
            cond(
              ((ctrl_byte != CTRL_EMPTY) && (ctrl_byte != CTRL_DELETED)) => {
                result = .Some((data_ptr.add(self._index)).*.value);
              },
              true => ()
            );
          });
          result
        }
      )
    )
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMap(K, V),
  values : (fn(self : Self) -> HashMapValues(K, V))(
    HashMapValues(K, V)(_map : self, _index : usize(0))
  )
);
impl(
  generic(K : Type, V : Type),
  HashMap(K, V),
  Index(K)(
    Output : V,
    index : (fn(inout(self) : Self, idx : K, where(K <: (Eq(K), Hash))) -> *(Self.Output))({
      hash := self._hash(idx);
      bucket_opt := Self._find_bucket(self, idx, hash);
      match(
        bucket_opt,
        .Some(i) => {
          data_ptr := Self._data_ptr(self);
          &((data_ptr.add(i)).*.value)
        },
        .None => __yo_panic("HashMap: key not found")
      )
    })
  )
);
/// Clone implementation for HashMap — deep-clones all key-value entries.
impl(
  generic(K : Type, V : Type),
  where(K <: (Clone, Eq(K), Hash), V <: Clone),
  HashMap(K, V),
  Clone(
    clone : (fn(inout(self) : Self) -> Self)({
      result := Self.with_keys(self.k0, self.k1);
      it := self.iter();
      running := true;
      while(running, {
        nxt := it.next();
        match(
          nxt,
          .None => {
            running = false;
          },
          .Some(bucket_ptr) => {
            // SAFETY: iter_ptr().next() returns .Some(p) only when p
            // points at an occupied bucket within the Rc-managed
            // _data buffer; the buffer is alive while `self` holds
            // the Rc (we received `inout(self)` so the caller still
            // owns it across this call).
            k := unsafe(bucket_ptr.*.key.clone());
            v := unsafe(bucket_ptr.*.value.clone());
            result.insert(k, v);
          }
        );
      });
      result
    })
  )
);
impl(
  generic(K : Type, V : Type),
  where(K <: (Eq(K), Hash)),
  HashMap(K, V),
  Trace(
    /**
    * Cycle-GC tracing. Buckets live in a malloc'd open-addressing buffer the
    * compiler's auto-derived field walk cannot reach, so trace each FULL slot
    * (its control byte is neither EMPTY nor DELETED). `tracer.visit` takes the
    * `MapEntry(K, V)` slot POINTER; the per-value traversal descends inline through
    * the value struct, tracing BOTH the key and the value, WITHOUT touching any
    * reference count (a by-value managed handle would be dup'd then dropped,
    * freeing a live element mid-collection). Mirrors the ArrayList `Trace` impl +
    * the SwissTable slot scan.
    */
    trace : (fn(self : Self, tracer : GcTracer) -> unit)({
      match(
        self.ctrl,
        .Some(ctrl_ptr) => match(
          self.data,
          .Some(data_ptr) => {
            (i : usize) = usize(0);
            while(i < self.capacity, {
              ctrl_byte := (ctrl_ptr.add(i)).*;
              // Full slot iff the SwissTable control high bit is clear (a full byte
              // stores the 7-bit h2 hash); EMPTY (255) and DELETED (254) both set it.
              // Uses the control-bit directly so the trace body needs no module-level
              // constant in scope.
              if((ctrl_byte & u8(128)) == u8(0), {
                tracer.visit(data_ptr.add(i));
              });
              i = (i + usize(1));
            });
          },
          .None => ()
        ),
        .None => ()
      );
    })
  )
);
export(
  HashMap,
  HashMapError,
  MapEntry,
  HashMapIter,
  HashMapIterPtr,
  HashMapKeys,
  HashMapValues
);
// =============================================================================
// hash_map! literal macro
// =============================================================================
/// Internal helper: build a list of `tmp.insert(k, v).unwrap()` statements from
/// a sequence of `k => v` arrow expressions.
__hash_map_build_sets :: (fn(comptime(tmp) : Expr, comptime(entries) : ExprList) -> comptime(ExprList))(
  cond(
    (entries.len() == usize(0)) => ExprList(),
    true => {
      first :: entries.car();
      rest :: entries.cdr();
      __ :: comptime_assert(first.is_fn_call(), "hash_map entries must use 'k => v'");
      callee :: first.get_callee();
      __1 :: comptime_assert(callee.is_atom() && (callee == quote(=>)), "hash_map entries must use 'k => v'");
      pair :: first.get_args();
      __2 :: comptime_assert(pair.len() == usize(2), "hash_map entries must use 'k => v'");
      key :: pair.car();
      val :: pair.cdr().car();
      stmt :: quote(unquote(tmp).insert(unquote(key), unquote(val)).unwrap());
      stmt.cons(recur(tmp, rest))
    }
  )
);
/// `hash_map` macro — construct a `HashMap(K, V)` literal.
///
/// `K` and `V` are inferred from the first entry's key and value via `typeof`,
/// so at least one entry is required.
///
/// ## Example
/// ```rust
/// m := hash_map(`a` => i32(1), `b` => i32(2));
/// ```
hash_map :: (fn(...(quote(entries))) -> unquote(Expr))({
  __ :: comptime_assert(
    entries.len() > usize(0),
    "hash_map requires at least one 'k => v' entry to infer K and V"
  );
  first :: entries.car();
  __1 :: comptime_assert(first.is_fn_call(), "hash_map entries must use 'k => v'");
  callee :: first.get_callee();
  __2 :: comptime_assert(callee.is_atom() && (callee == quote(=>)), "hash_map entries must use 'k => v'");
  pair :: first.get_args();
  __3 :: comptime_assert(pair.len() == usize(2), "hash_map entries must use 'k => v'");
  first_key :: pair.car();
  first_val :: pair.cdr().car();
  rest :: entries.cdr();
  tmp :: gensym("hash_map");
  k_tmp :: gensym("hash_map_k0");
  v_tmp :: gensym("hash_map_v0");
  rest_sets :: __hash_map_build_sets(tmp, rest);
  quote({
    unquote(k_tmp) := unquote(first_key);
    unquote(v_tmp) := unquote(first_val);
    unquote(tmp) := HashMap(typeof(unquote(k_tmp)), typeof(unquote(v_tmp))).new();
    unquote(tmp).insert(unquote(k_tmp), unquote(v_tmp)).unwrap();
    unquote_splicing(rest_sets);
    unquote(tmp)
  })
});
export(hash_map);
