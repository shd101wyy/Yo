//! Dynamic array (vector) with amortized O(1) push and O(1) indexed access.
//!
//! ## Stability
//!
//! stable — every breaking flip this type owed Rust shipped in v0.2.28:
//! `push` is infallible with `try_push` beside it (D9), `iter()` yields
//! POINTERS while `into_iter()` yields values (D14), and `sort` is the stable
//! merge with `sort_unstable` as the heapsort (D17). The P1 battery is
//! complete and test-covered, and `plans/STD_API_STABILIZATION.md` §4 lists
//! nothing still open against this module, so further work here is additive.
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator, AllocError, size_would_overflow } :: import("../allocator.yo");
{ memmove, memcpy, memset } :: import("../libc/string.yo");
{ SIZE_MAX } :: import("../libc/stdint.yo");
{ malloc, calloc, realloc, free, aligned_alloc } :: GlobalAllocator;
/// Error variants for ArrayList operations.
ArrayListError :: enum(
  /// Memory allocation failed.
  AllocError(error : AllocError),
  /// Index is out of bounds for the current length.
  IndexOutOfBounds(index : usize, length : usize),
  /// Attempted to access an element from an empty list.
  EmptyList
);
/// Generic growable array similar to Rust's `Vec<T>`.
/// Heap-allocated with automatic resizing and reference-counted cleanup.
ArrayList :: (fn(comptime(T) : Type) -> comptime(Type))(
  ref(
    struct(
      _ptr : ?(*(T)),
      _length : usize,
      _capacity : usize
    )
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  /// Number of elements. O(1) — the length is stored, never counted.
  len : (fn(self : Self) -> usize)({
    return(self._length);
  }),
  /// True when the list holds no elements — `len() == 0`.
  is_empty : (fn(self : Self) -> bool)({
    return(self._length == usize(0));
  }),
  /// Elements the current buffer can hold before `push` has to reallocate.
  ///
  /// `SIZE_MAX` for a zero-sized element type, which never grows — see
  /// `_zst_anchor`. Rust's `Vec::capacity` reports `usize::MAX` for the same
  /// reason.
  capacity : (fn(self : Self) -> usize)({
    return(self._capacity);
  }),
  /// Raw pointer to the element buffer, or `.None` when nothing is allocated
  /// yet — Rust's `Vec::as_ptr`, minus the dangling-pointer guarantee.
  ///
  /// The pointer is only valid until the next reallocation (`push` past
  /// capacity, `reserve`, `ensure_total_capacity`, `shrink_to_fit`), and it
  /// borrows: it does not keep the list alive.
  ptr : (fn(self : Self) -> ?(*(T)))(
    self._ptr
  ),
  /// Declare that the first `new_len` slots of the buffer are live — Rust's
  /// `Vec::set_len`, and just as unsafe.
  ///
  /// Nothing is initialized and nothing is dropped: growing the length exposes
  /// whatever bytes the buffer already held, and shrinking it leaks the
  /// elements past the new end (`dispose` and `clear` only walk `[0, len)`).
  /// Reach for it only after filling the buffer through `ptr()` or
  /// `extend_from_ptr`. PANICS when `new_len` exceeds the capacity.
  set_len : (fn(self : Self, new_len : usize) -> unit)({
    cond(
      (new_len <= self._capacity) => {
        self._length = new_len;
      },
      true => __yo_panic("set_len: new length exceeds capacity")
    );
  }),
  /// Empty list. Allocates nothing — the first `push` buys the buffer (four
  /// elements), as Rust's `Vec::new` does.
  new : (fn() -> Self)(
    Self(
      _ptr : .None,
      _length : usize(0),
      _capacity : usize(0)
    )
  ),
  /// Owned copy of the elements in `[r.start, r.end)` — JS-style range
  /// slicing with value semantics (plans/archive/SLICE_REWORK.md: `list(a..b)`
  /// lowers to this).
  ///
  /// The end is CLAMPED to the length rather than checked, so an over-long
  /// range yields a short list instead of panicking; `slice` is the checked,
  /// `Result`-returning spelling. Elements are copied (dup'd for a
  /// refcounted `T`), so the result is independent of the source.
  slice_copy : (fn(self : Self, r : Range(usize)) -> Self)({
    e := cond((r.end > self.len()) => self.len(), true => r.end);
    out := Self.new();
    i := r.start;
    while(i < e, i = (i + usize(1)), {
      match(
        self.get(i),
        .Some(v) => {
          out.push(v);
        },
        .None => ()
      );
    });
    out
  }),
  /// Inclusive-range companion of `slice_copy` (`list(a..=b)`).
  slice_copy_inclusive : (fn(self : Self, r : RangeInclusive(usize)) -> Self)({
    last := cond((r.end >= self.len()) => self.len(), true => (r.end + usize(1)));
    out := Self.new();
    i := r.start;
    while(i < last, i = (i + usize(1)), {
      match(
        self.get(i),
        .Some(v) => {
          out.push(v);
        },
        .None => ()
      );
    });
    out
  }),
  /// Owned `ArrayList` copy of a fixed-size array's elements — the companion
  /// to array range-indexing (plans/archive/SLICE_REWORK.md).
  ///
  /// `N` comes from the array's type, so the exact capacity is reserved up
  /// front and no growth happens.
  from_array : (fn(generic(N : usize), arr : Array(T, N)) -> Self)({
    out := Self.with_capacity(N);
    i := usize(0);
    while(i < N, i = (i + usize(1)), {
      out.push(arr(i));
    });
    out
  }),
  /// Empty list whose buffer already holds `cap` elements — Rust's
  /// `Vec::with_capacity`.
  ///
  /// PANICS on `"capacity overflow"` when `sizeof(T) * cap` would wrap (Rust
  /// panics with the same message), and on allocation failure. A zero-sized
  /// element type takes the one-byte anchor buffer instead of allocating
  /// `cap` of nothing.
  with_capacity : (fn(cap : usize) -> Self)(
    cond(
      (cap == usize(0)) =>
        Self.new(),
      // `sizeof(T) * cap` is computed in usize and WRAPS. Without this guard a
      // capacity from untrusted input (a length prefix off a socket, say) hands
      // malloc a tiny — or zero — size while the list still reports `cap`, so
      // the first pushes write outside the allocation: silent heap corruption
      // (issues/fixed/collection-capacity-overflow-unchecked.md). Rust's
      // `Vec::with_capacity` panics with "capacity overflow" here too.
      size_would_overflow(T, cap) =>
        __yo_panic("ArrayList.with_capacity: capacity overflow"),
      // Zero-sized element (`unit`, an all-`unit` struct): the buffer holds no
      // bytes, so the list never grows — see `_zst_anchor`.
      (sizeof(T) == usize(0)) => Self._zst_anchor(),
      true => {
        ptr_result := malloc(sizeof(T) * cap);
        match(
          ptr_result,
          .Some(_ptr) =>
            Self(
              _ptr : .Some((*(T))(_ptr)),
              _length : usize(0),
              _capacity : cap
            ),
          .None => __yo_panic("malloc returned None")
        )
      }
    )
  ),
  /// The one buffer an ArrayList of a ZERO-SIZED element type ever has.
  ///
  /// `sizeof(T) == 0` (`unit`, an all-`unit` aggregate, `Array(unit, N)`) means
  /// the elements occupy no bytes: a store writes nothing, a read reads nothing,
  /// and the byte size of every buffer is 0. Rust's `Vec<()>` never allocates
  /// and reports `capacity() == usize::MAX`. Yo cannot conjure a non-null
  /// dangling pointer, so the stand-in is ONE one-byte block, allocated once and
  /// never resized: the capacity is `SIZE_MAX`, so `push` never reaches the grow
  /// path, and `shrink_to_fit` is a no-op. Going through the allocator with
  /// `sizeof(T) * cap == 0` instead would `malloc(0)` and then `realloc(p, 0)` —
  /// which frees `p` and returns NULL on glibc and the Windows CRT — and the
  /// list would report "allocation failed" on its second growth.
  _zst_anchor : (fn() -> Self)(
    match(
      malloc(usize(1)),
      .Some(anchor) =>
        Self(
          _ptr : .Some((*(T))(anchor)),
          _length : usize(0),
          _capacity : SIZE_MAX
        ),
      .None => __yo_panic("malloc returned None")
    )
  ),
  /// Append an element, reporting allocation failure as
  /// `.Err(.AllocError(.OutOfMemory))` instead of panicking.
  ///
  /// The allocator-aware form (D9); `push` is the one to reach for. Amortized
  /// O(1) — the buffer doubles (4 elements first), so a growth INVALIDATES
  /// every pointer previously handed out by `ptr()`, `iter()` or the `Index`
  /// impl.
  try_push : (fn(self : Self, value : T) -> Result(unit, ArrayListError))(
    // Check if we need to grow
    cond(
      (self._length >= self._capacity) => {
        // Need to grow - calculate new capacity. A zero-sized element type
        // takes the anchor buffer and `SIZE_MAX` capacity instead (see
        // `_zst_anchor`), so this branch runs once for it and never again.
        new_capacity := cond(
          (sizeof(T) == usize(0)) => SIZE_MAX,
          (self._capacity == usize(0)) => usize(4),
          true => (self._capacity * usize(2))
        );
        // Allocate or reallocate
        new_some_ptr := match(
          self._ptr,
          .None => GlobalAllocator.malloc(cond((sizeof(T) == usize(0)) => usize(1), true => (sizeof(T) * new_capacity))),
          .Some(old_ptr) => GlobalAllocator.realloc(
            .Some((*(void))(old_ptr)),
            sizeof(T) * new_capacity
          )
        );
        match(
          new_some_ptr,
          .Some(new_ptr) => {
            typed_ptr := (*T)(new_ptr);
            self._ptr = .Some(typed_ptr);
            self._capacity = new_capacity;
            // Now add the element at position length
            target_ptr := typed_ptr.add(self._length);
            consume(target_ptr.* = value);
            self._length = (self._length + usize(1));
            .Ok(())
          },
          .None => .Err(.AllocError(.OutOfMemory))
        )
      },
      true =>
        // Have capacity - just add the element
        match(
          self._ptr,
          .Some(_ptr) => {
            target_ptr := _ptr.add(self._length);
            consume(target_ptr.* = value);
            self._length = (self._length + usize(1));
            .Ok(())
          },
          .None => __yo_panic("ArrayList has capacity but no ptr")
        )
    )
  ),
  /// Append an element — amortized O(1).
  ///
  /// PANICS on allocation failure: Rust's `Vec::push` aborts, and so do this
  /// list's own `ensure_total_capacity` / `with_capacity`. Before D9 this
  /// returned a `Result` that every one of its callers discarded, usually via
  /// a throwaway `_p :=` binding — a `Result` nobody checks is strictly worse
  /// than a panic, because it reads as if the failure were handled. Use
  /// `try_push` when the caller genuinely handles OOM.
  ///
  /// A growth reallocates, so any pointer into the buffer (`ptr()`, `iter()`,
  /// `self(i)`) is invalid afterwards.
  push : (fn(self : Self, value : T) -> unit)(
    match(
      Self.try_push(self, value),
      .Ok(_) => (),
      .Err(_) => __yo_panic("ArrayList.push: allocation failed")
    )
  ),
  /// Remove and return the last element, or `.None` when empty — O(1), and
  /// the capacity is kept.
  pop : (fn(self : Self) -> Option(T))(
    cond(
      (self._length == usize(0)) => .None,
      true => {
        self._length = (self._length - usize(1));
        match(
          self._ptr,
          .None => .None,
          .Some(_ptr) => {
            last_element_ptr := _ptr.add(self._length);
            last_element := last_element_ptr.*;
            // Drop the slot's reference since it's no longer tracked
            // (length was decremented, so dispose won't reach this slot)
            unsafe.drop(last_element_ptr.*);
            .Some(last_element)
          }
        )
      }
    )
  ),
  /// Copy of the element at `index`, or `.None` when `index >= len()`.
  ///
  /// The bounds-checked reader. `self(index)` (the `Index` impl) hands back a
  /// POINTER into the buffer and panics out of range instead; `iter()` is the
  /// way to walk without copying a refcounted `T`.
  get : (fn(self : Self, index : usize) -> Option(T))(
    cond(
      (index >= self._length) => .None,
      true =>
        match(
          self._ptr,
          .None => .None,
          .Some(_ptr) => .Some((_ptr.add(index)).*)
        )
    )
  ),
  /// Give the unused tail of the buffer back to the allocator so that
  /// `capacity() == len()` — Rust's `Vec::shrink_to_fit`.
  ///
  /// Reallocates (an empty list frees its buffer outright), so every pointer
  /// into the buffer is invalid afterwards and the next `push` grows again.
  /// `.Err(.AllocError(.OutOfMemory))` when the shrinking `realloc` fails —
  /// the list is left untouched and usable. A zero-sized element type is a
  /// no-op: its anchor buffer cannot shrink.
  shrink_to_fit : (fn(self : Self) -> Result(unit, ArrayListError))(
    // If length equals capacity or both are zero, nothing to do. A zero-sized
    // element type has nothing to shrink either (its buffer is the one-byte
    // anchor; `realloc(p, 0)` would free it — see `_zst_anchor`).
    cond(
      ((self._length == self._capacity) || (self._capacity == usize(0))) => .Ok(()),
      (sizeof(T) == usize(0)) => .Ok(()),
      true =>
        // If length is zero, free the buffer
        cond(
          (self._length == usize(0)) => {
            match(
              self._ptr,
              .Some(_ptr) => {
                GlobalAllocator.free(.Some((*void)(_ptr)));
                self._ptr = .None;
                self._capacity = usize(0);
              },
              .None => ()
            );
            .Ok(())
          },
          true =>
            // Otherwise, reallocate to exact size
            match(
              self._ptr,
              .None => __yo_panic("ArrayList has capacity but no ptr"),
              .Some(old_ptr) => {
                new_some_ptr := GlobalAllocator.realloc(
                  .Some((*void)(old_ptr)),
                  sizeof(T) * self._length
                );
                match(
                  new_some_ptr,
                  .Some(new_ptr) => {
                    self._ptr = .Some((*T)(new_ptr));
                    self._capacity = self._length;
                    .Ok(())
                  },
                  .None => .Err(.AllocError(.OutOfMemory))
                )
              }
            )
        )
    )
  ),
  _free_elements : (fn(self : Self) -> unit)(
    cond(
      Type.contains_rc_type(T) => {
        if(self._length > usize(0), {
          i := usize(0);
          base_ptr := self._ptr.unwrap();
          while(i < self._length, i = (i + usize(1)), {
            element_ptr := base_ptr.add(i);
            unsafe.drop(element_ptr.*);
          });
        });
      },
      true => ()
    )
  ),
  /// Remove the elements in `[r.start, r.end)` and return them, in order, as
  /// a fresh list — Rust's `Vec::drain`, collected eagerly rather than lazily
  /// (Yo has no borrowing iterator to hold the source open).
  ///
  /// O(n): the tail shifts left to close the gap. PANICS on an inverted range
  /// or an end past the length — the old `remove(start, count)` silently
  /// clamped the count, which hid caller bugs.
  drain : (fn(self : Self, r : Range(usize)) -> Self)({
    if((r.start > r.end) || (r.end > self._length), {
      __yo_panic("ArrayList.drain: invalid range for this length");
    });
    count := (r.end - r.start);
    out := Self.new();
    cond(
      (count == usize(0)) => out,
      true =>
        match(
          self._ptr,
          .None => __yo_panic("ArrayList has length but no ptr"),
          .Some(_ptr) => {
            // Collect the drained elements FIRST: get dups each one, so the
            // shift below can drop the originals with balanced RCs. (ci, not
            // i: the shift arms below redeclare i in their own scopes.)
            ci := usize(0);
            while(ci < count, ci = (ci + usize(1)), {
              match(
                self.get(r.start + ci),
                .Some(e) => out.push(e),
                .None => __yo_panic("ArrayList.drain: get failed inside bounds")
              );
            });
            // Shift remaining elements left to fill the gap
            // We need to move elements from [r.start + count, length) to [r.start, ...)
            elements_after := ((self._length - r.start) - count);
            cond(
              (elements_after > usize(0)) => {
                src_ptr := _ptr.add(r.start + count);
                dst_ptr := _ptr.add(r.start);
                cond(
                  Type.contains_rc_type(T) => {
                    // For RC types, iterate and properly manage RC
                    // The assignment dst.* = src.* will:
                    // 1. Dup src.* (RC+1)
                    // 2. Drop old dst.* (either element being removed, or previous iteration's copy)
                    // 3. Write to dst.*
                    i := usize(0);
                    while(i < elements_after, i = (i + usize(1)), {
                      dst := dst_ptr.add(i);
                      src := src_ptr.add(i);
                      dst.* = src.*;
                    });
                    // Drop the non-overlapping tail stale pointers
                    j := usize(0);
                    tail_start := (r.start + elements_after);
                    while(j < count, j = (j + usize(1)), {
                      tail_ptr := _ptr.add(tail_start + j);
                      unsafe.drop(tail_ptr.*);
                    });
                  },
                  true => {
                    // For non-RC types, use fast memmove
                    element_size := sizeof(T);
                    bytes_to_move := (elements_after * element_size);
                    dst_void := (*void)(dst_ptr);
                    src_void := (*void)(src_ptr);
                    // SAFETY: dst_ptr and src_ptr both point into self._ptr's
                    // contiguous element buffer. `elements_after = self._length - (r.start + count)`
                    // counts elements still in-bounds after the drain range,
                    // so `bytes_to_move = elements_after * sizeof(T)` stays within
                    // the allocated buffer. memmove handles overlap.
                    unsafe(memmove(dst_void, src_void, bytes_to_move));
                  }
                );
              },
              true => {
                // No elements to shift, just drop the drained elements
                cond(
                  Type.contains_rc_type(T) => {
                    i := usize(0);
                    while(i < count, i = (i + usize(1)), {
                      element_ptr := _ptr.add(r.start + i);
                      unsafe.drop(element_ptr.*);
                    });
                  },
                  true => ()
                );
              }
            );
            // Update length
            self._length = (self._length - count);
            out
          }
        )
    )
  }),
  /// Insert `value` at `idx`, shifting the tail right — O(n). `idx == len`
  /// appends, as in Rust.
  insert : (fn(self : Self, idx : usize, value : T) -> unit)({
    if(idx > self._length, {
      __yo_panic("ArrayList.insert: index out of bounds");
    });
    self.push(value);
    // Rotate the freshly appended element down into place. Uses `swap`, which
    // moves raw slots, so no element is dup'd or dropped on the way.
    (k : usize) = (self._length - usize(1));
    while(k > idx, {
      self.swap(k, k - usize(1));
      k = (k - usize(1));
    });
  }),
  /// Move every element of `other` onto the end of `self`, leaving `other`
  /// EMPTY — Rust's `append`. `extend` copies instead.
  append : (fn(self : Self, other : Self) -> unit)({
    (i : usize) = usize(0);
    n := other.len();
    while(i < n, {
      match(other.get(i), .Some(v) => self.push(v), .None => ());
      i = (i + usize(1));
    });
    other.clear();
  }),
  /// First element, or `.None` when empty.
  first : (fn(self : Self) -> Option(T))(
    self.get(usize(0))
  ),
  /// Last element, or `.None` when empty.
  last : (fn(self : Self) -> Option(T))(
    cond(
      (self._length == usize(0)) => Option(T).None,
      true => self.get(self._length - usize(1))
    )
  ),
  /// Reserve room for `additional` MORE elements.
  ///
  /// Rust's spelling. `ensure_total_capacity` takes a TOTAL, which is the same
  /// call with a different meaning and an easy one to get wrong at a call site.
  reserve : (fn(self : Self, additional : usize) -> unit)(
    self.ensure_total_capacity(self._length + additional)
  ),
  /// Exchange the elements at `i` and `j`.
  ///
  /// Moves the raw slots, like `reverse` — no dup/drop, so this is RC-neutral
  /// however the element type is refcounted.
  swap : (fn(self : Self, i : usize, j : usize) -> unit)({
    if((i >= self._length) || (j >= self._length), {
      __yo_panic("ArrayList.swap: index out of bounds");
    });
    cond(
      (i == j) => (),
      true =>
        match(
          self._ptr,
          .Some(_ptr) => {
            tmp := (_ptr.add(i)).*;
            (_ptr.add(i)).* = (_ptr.add(j)).*;
            (_ptr.add(j)).* = tmp;
          },
          .None => ()
        )
    );
  }),
  /// Remove the element at `idx` and return it, moving the LAST element into
  /// the hole — O(1), and it does not preserve order. Rust's `swap_remove`.
  swap_remove : (fn(self : Self, idx : usize) -> T)({
    if(idx >= self._length, {
      __yo_panic("ArrayList.swap_remove: index out of bounds");
    });
    self.swap(idx, self._length - usize(1));
    match(self.pop(), .Some(v) => v, .None => __yo_panic("ArrayList.swap_remove: pop failed after bounds check"))
  }),
  /// Shorten to `new_len`, dropping the elements past it. Longer `new_len` is
  /// a no-op, as in Rust.
  truncate : (fn(self : Self, new_len : usize) -> unit)({
    cond(
      (new_len >= self._length) => (),
      true => {
        _t := self.drain(new_len .. self._length);
        ()
      }
    );
  }),
  /// Resize to exactly `new_len`, dropping the tail when shrinking and
  /// appending copies of `value` when growing. Rust's `resize`.
  ///
  /// Distinct from `resize_with_byte`, which memsets raw storage and is only
  /// meaningful for a plain-old-data element type.
  resize : (fn(self : Self, new_len : usize, value : T) -> unit)({
    cond(
      (new_len < self._length) => {
        self.truncate(new_len);
      },
      (new_len > self._length) => {
        self.reserve(new_len - self._length);
        while(self._length < new_len, {
          self.push(value);
        });
      },
      true => ()
    );
  }),
  /// Overwrite every element with `value`, keeping the length. Rust's `fill`.
  fill : (fn(self : Self, value : T) -> unit)({
    (i : usize) = usize(0);
    n := self._length;
    while(i < n, i = (i + usize(1)), {
      self(i) = value;
    });
  }),
  /// Split off `[at, len)` into a new list, leaving `[0, at)` here.
  split_off : (fn(self : Self, at : usize) -> Self)({
    if(at > self._length, {
      __yo_panic("ArrayList.split_off: index out of bounds");
    });
    self.drain(at .. self._length)
  }),
  /// Remove the element at `idx` and return it, shifting the tail left —
  /// O(n), order preserved. Rust's `Vec::remove`.
  ///
  /// PANICS when `idx >= len()`. `swap_remove` is the O(1) alternative when
  /// order does not matter, and `LinkedList.remove` returns a `Result`
  /// instead — a deliberate difference (D1): the list that has to walk to
  /// the index reports the caller's mistake as a value.
  remove : (fn(self : Self, idx : usize) -> T)({
    if(idx >= self._length, {
      __yo_panic("ArrayList.remove: index out of bounds");
    });
    match(
      self.get(idx),
      .Some(elem) => {
        // get dup'd the element; drain drops the original — RC balanced.
        _r := self.drain(idx .. (idx + usize(1)));
        elem
      },
      .None => __yo_panic("ArrayList.remove: get failed after bounds check")
    )
  }),
  /// Owned copy of `[start, end)`, or an `.IndexOutOfBounds` error — the
  /// CHECKED counterpart of `slice_copy`, which clamps instead.
  ///
  /// An inverted range reports `.IndexOutOfBounds(index : start, length :
  /// end)`. O(end - start), one allocation of the exact size.
  slice : (fn(self : Self, start : usize, end : usize) -> Result(Self, ArrayListError))(
    // Validate indices
    cond(
      (start > self._length) =>
        .Err(.IndexOutOfBounds(index : start, length : self._length)),
      (end > self._length) =>
        .Err(.IndexOutOfBounds(index : end, length : self._length)),
      (start > end) =>
        .Err(.IndexOutOfBounds(index : start, length : end)),
      true => {
        slice_length := (end - start);
        // If slice is empty, return empty ArrayList
        cond(
          (slice_length == usize(0)) =>
            .Ok(Self.new()),
          true =>
            match(
              self._ptr,
              .None => __yo_panic("ArrayList has length but no ptr"),
              .Some(src_ptr) => {
                // Create new ArrayList with exact capacity
                new_list := Self.with_capacity(slice_length);
                match(
                  new_list._ptr,
                  .None => .Err(.AllocError(.OutOfMemory)),
                  .Some(dst_ptr) => {
                    // Copy elements
                    i := usize(0);
                    while(i < slice_length, i = (i + usize(1)), {
                      src := src_ptr.add(start + i);
                      dst := dst_ptr.add(i);
                      consume(dst.* = src.*);
                    });
                    // Set the length of the new list
                    new_list._length = slice_length;
                    .Ok(new_list)
                  }
                )
              }
            )
        )
      }
    )
  ),
  /// Grow the buffer so it holds at least `min_cap` elements in TOTAL,
  /// doubling as it goes; a request under the current capacity does nothing.
  ///
  /// `reserve(additional)` is the Rust spelling and takes a COUNT TO ADD —
  /// the same call with a different meaning, and the easy one to get right at
  /// a call site. PANICS on capacity overflow and on allocation failure
  /// (`try_push` is the only allocator-aware entry point). Reallocates, so
  /// pointers into the buffer do not survive it.
  ensure_total_capacity : (fn(self : Self, min_cap : usize) -> unit)({
    cond(
      (min_cap <= self._capacity) => (),
      // Same wrap as `with_capacity` — and the doubling loop below has a second
      // face: once `cap * 2` wraps to 0 the loop can never reach `min_cap`, so
      // an oversized request SPINS FOREVER instead of failing
      // (issues/fixed/collection-capacity-overflow-unchecked.md).
      size_would_overflow(T, min_cap) =>
        __yo_panic("ArrayList.ensure_total_capacity: capacity overflow"),
      // Zero-sized element type: the anchor buffer satisfies every capacity
      // (see `_zst_anchor`); `min_cap <= self._capacity` above catches it once
      // the anchor is in place.
      (sizeof(T) == usize(0)) => {
        anchor := Self._zst_anchor();
        self._ptr = anchor._ptr;
        self._capacity = anchor._capacity;
      },
      true => {
        new_capacity := cond(
          (self._capacity == usize(0)) => min_cap,
          true => {
            cap := self._capacity;
            // `min_cap` is known not to overflow `sizeof(T) * min_cap`, but the
            // doubling itself can still wrap. Fall back to `min_cap` in that
            // one case; every reachable growth keeps the usual doubling.
            while(cap < min_cap, {
              cap = cond(
                (cap > (SIZE_MAX / usize(2))) => min_cap,
                true => (cap * usize(2))
              );
            });
            cap
          }
        );
        new_some_ptr := match(
          self._ptr,
          .None => GlobalAllocator.malloc(sizeof(T) * new_capacity),
          .Some(old_ptr) => GlobalAllocator.realloc(
            .Some((*(void))(old_ptr)),
            sizeof(T) * new_capacity
          )
        );
        match(
          new_some_ptr,
          .Some(new_ptr) => {
            self._ptr = .Some((*(T))(new_ptr));
            self._capacity = new_capacity;
          },
          .None => __yo_panic("ArrayList.ensure_total_capacity: allocation failed")
        );
      }
    );
  }),
  /// Append `count` elements from a raw buffer with one `memcpy`.
  ///
  /// The caller guarantees `src` holds `count` initialized, correctly aligned
  /// `T`s that do not alias this list's buffer. The bytes are copied WITHOUT
  /// per-element dup, so for a refcounted `T` this MOVES the source elements:
  /// the caller must not also release them. Reaching for it on a plain-data
  /// element type is the point — that is where it beats a `push` loop.
  extend_from_ptr : (fn(self : Self, src : *(T), count : usize) -> unit)({
    cond(
      (count == usize(0)) => (),
      true => {
        self.ensure_total_capacity(self._length + count);
        match(
          self._ptr,
          .Some(dst_base) => {
            dst := (*(void))(dst_base.add(self._length));
            unsafe(memcpy(dst, (*(void))(src), count * sizeof(T)));
            self._length = (self._length + count);
          },
          .None => __yo_panic("ArrayList.extend_from_ptr: no ptr after ensure_total_capacity")
        );
      }
    );
  }),
  /// Drop every element and set the length to 0, KEEPING the capacity —
  /// Rust's `Vec::clear`. Use `shrink_to_fit` afterwards to release the
  /// buffer too.
  clear : (fn(self : Self) -> unit)({
    Self._free_elements(self);
    self._length = usize(0);
  }),
  /// Overwrite the live `len()` elements with a repeated byte via `memset` —
  /// the fast way to zero a `bool` / integer list.
  ///
  /// Writes over the elements without dropping them, so it is only sound for
  /// a plain-data `T`: on a refcounted element type it strands every handle
  /// it overwrites. `fill(value)` is the type-safe form.
  fill_with_byte : (fn(self : Self, byte_val : int) -> unit)(
    match(
      self._ptr,
      .None => (),
      .Some(_ptr) => {
        unsafe(memset((*(void))(_ptr), byte_val, self._length * sizeof(T)));
      }
    )
  ),
  /// Set the length to exactly `new_len`, `memset`ting any newly exposed
  /// slots to a repeated byte.
  ///
  /// Shrinking does NOT run destructors and growing does not construct
  /// anything, so — like `fill_with_byte` — this is for a plain-data `T`
  /// only; `resize(new_len, value)` is the type-safe form. Growing may
  /// reallocate and can panic on allocation failure.
  resize_with_byte : (fn(self : Self, new_len : usize, byte_val : int) -> unit)({
    cond(
      (new_len <= self._length) => {
        self._length = new_len;
      },
      true => {
        self.ensure_total_capacity(new_len);
        match(
          self._ptr,
          .Some(_ptr) => {
            start := (*(void))(_ptr.add(self._length));
            fill_count := ((new_len - self._length) * sizeof(T));
            unsafe(memset(start, byte_val, fill_count));
            self._length = new_len;
          },
          .None => __yo_panic("ArrayList.resize_with_byte: no ptr after ensure")
        );
      }
    );
  })
);
impl(
  generic(T : Type),
  ArrayList(T),
  Index(usize)(
    /// The output type is the element type `T`.
    Output : T,
    /// Returns a pointer to the element at the given index. Panics if the index is out of bounds.
    index : (fn(inout(self) : Self, idx : usize) -> *(Self.Output))({
      // Bounds check via `if` + `__yo_panic` (not `assert`: this module is
      // inside `std/assert`'s dependency cycle and cannot import it).
      if(idx >= self._length, {
        __yo_panic("ArrayList: index out of bounds");
      });
      match(
        self._ptr,
        .Some(_ptr) => _ptr.add(idx),
        .None => __yo_panic("ArrayList: index on empty list")
      )
    })
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  Dispose(
    /// Drops every live element and frees the buffer. Runs when the last
    /// reference to the list goes away, not at the end of the binding's
    /// scope.
    dispose : (fn(self : Self) -> unit)({
      match(
        self._ptr,
        .Some(_ptr) => {
          Self._free_elements(self);
          self._length = usize(0);
          GlobalAllocator.free(.Some((*void)(_ptr)));
          self._ptr = .None;
        },
        .None => ()
      );
    })
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  Trace(
    /// Cycle-GC tracing. The elements live in a malloc'd buffer the
    /// compiler's auto-derived field walk cannot reach, so trace each
    /// element's buffer slot. `tracer.visit` takes the slot POINTER and reads
    /// it WITHOUT touching the element's reference count — a by-value managed
    /// handle would be dup'd then dropped, freeing a live element
    /// mid-collection.
    trace : (fn(self : Self, tracer : GcTracer) -> unit)({
      match(
        self._ptr,
        .Some(base) => {
          (i : usize) = usize(0);
          while(i < self._length, {
            tracer.visit(base.add(i));
            i = (i + usize(1));
          });
        },
        .None => ()
      );
    })
  )
);
// === Iterator support ===
/// Value iterator over an ArrayList — yields each element BY VALUE, which
/// dups a refcounted `T`. This is what `into_iter()` (and therefore
/// `for(list, ...)`) returns; `iter()` yields pointers instead (D14).
///
/// It holds the list by handle and re-reads `_length` on every `next`, so a
/// `push` during a forward walk extends the walk. Double-ended: `next_back`
/// takes from the far end.
ArrayListIter :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _list : ArrayList(T),
    _index : usize,
    /// How many elements `next_back` has already taken off the END. A COUNTER
    /// rather than a back cursor, so the forward guard keeps reading
    /// `_list._length` LIVE — pushing during a forward-only walk still extends
    /// it exactly as before.
    _back_taken : usize
  )
);
impl(
  generic(T : Type),
  ArrayListIter(T),
  Iterator(
    Item : T,
    next : (fn(inout(self) : Self) -> Option(T))(
      cond(
        ((self._index + self._back_taken) >= self._list._length) => .None,
        true => {
          value := self._list.get(self._index);
          self._index = (self._index + usize(1));
          value
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  ArrayListIter(T),
  DoubleEndedIterator(
    Item : T,
    next_back : (fn(inout(self) : Self) -> Option(T))(
      cond(
        ((self._index + self._back_taken) >= self._list._length) => .None,
        true => {
          self._back_taken = (self._back_taken + usize(1));
          self._list.get(self._list._length - self._back_taken)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  IntoIterator(
    Item : T,
    IntoIter : ArrayListIter(T),
    into_iter : (fn(self : Self) -> ArrayListIter(T))(
      ArrayListIter(T)(_list : self, _index : usize(0), _back_taken : usize(0))
    )
  )
);
/// Pointer iterator over an ArrayList — yields `*(T)` INTO the list's own
/// buffer (D14). This is what `iter()` returns; `into_iter()` keeps yielding
/// values.
///
/// The elements are borrowed, not dup'd, so iterating a list of RC values
/// costs no refcount traffic and writing through the pointer mutates the list
/// in place. `HashMapIterPtr` established the shape.
///
/// The pointers alias the buffer, so any operation that REALLOCATES it
/// (`push` past capacity, `reserve`, `shrink_to_fit`) invalidates every
/// pointer already yielded. Live-length semantics are otherwise the same as
/// `ArrayListIter`'s: `_length` is re-read on each `next`.
ArrayListIterPtr :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _list : ArrayList(T),
    _index : usize,
    /// See ArrayListIter._back_taken — a COUNTER, so the forward guard keeps
    /// reading `_list._length` live.
    _back_taken : usize
  )
);
impl(
  generic(T : Type),
  ArrayListIterPtr(T),
  Iterator(
    Item : *(T),
    next : (fn(inout(self) : Self) -> Option(*(T)))(
      cond(
        ((self._index + self._back_taken) >= self._list._length) => .None,
        true => {
          // The guard above proves `_length > _index >= 0`, so the buffer is
          // allocated and `_ptr` is `.Some`.
          base := self._list._ptr.unwrap();
          p := base.add(self._index);
          self._index = (self._index + usize(1));
          .Some(p)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  ArrayListIterPtr(T),
  DoubleEndedIterator(
    Item : *(T),
    next_back : (fn(inout(self) : Self) -> Option(*(T)))(
      cond(
        ((self._index + self._back_taken) >= self._list._length) => .None,
        true => {
          base := self._list._ptr.unwrap();
          self._back_taken = (self._back_taken + usize(1));
          .Some(base.add(self._list._length - self._back_taken))
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  /// Borrowing walk over a shared handle: yields a `*(T)` into the list's
  /// buffer and leaves the list intact — `for(list.iter(), ptr => ...)`,
  /// where `into_iter` would move the list and yield values (D14; the
  /// `iter` / `into_iter` split every other std collection already had).
  ///
  /// The receiver arrives RC-dup'd at the method boundary, so moving it into
  /// the iterator is balanced and the buffer outlives the walk. Do not grow
  /// the list mid-walk: a reallocation invalidates the pointers already
  /// yielded.
  iter : (fn(self : Self) -> ArrayListIterPtr(T))(
    ArrayListIterPtr(T)(_list : self, _index : usize(0), _back_taken : usize(0))
  )
);
impl(
  generic(T : Type),
  where(T <: Eq(T)),
  ArrayList(T),
  /// Remove CONSECUTIVE duplicates, keeping the first of each run — Rust's
  /// `dedup`. Only adjacent equals collapse, so `[1,2,1]` is unchanged; sort
  /// first if you want set semantics.
  dedup : (fn(self : Self) -> unit)({
    cond(
      (self._length <= usize(1)) => (),
      true => {
        kept := ArrayList(T).new();
        (i : usize) = usize(0);
        while(i < self._length, {
          cur := match(self.get(i), .Some(v) => v, .None => __yo_panic("ArrayList.dedup: get failed"));
          is_dup := cond(
            (kept.len() == usize(0)) => false,
            true =>
              match(
                kept.get(kept.len() - usize(1)),
                .Some(prev) => (prev == cur),
                .None => false
              )
          );
          if(!(is_dup), {
            kept.push(cur);
          });
          i = (i + usize(1));
        });
        self.clear();
        (j : usize) = usize(0);
        while(j < kept.len(), {
          match(kept.get(j), .Some(v) => self.push(v), .None => ());
          j = (j + usize(1));
        });
      }
    );
  }),
  /// Whether `self` begins with `prefix` — Rust's `starts_with`.
  starts_with : (fn(self : Self, prefix : Self) -> bool)({
    n := prefix.len();
    cond(
      (n > self._length) => false,
      true => {
        (i : usize) = usize(0);
        (same : bool) = true;
        while(runtime((i < n) && same), {
          a := match(self.get(i), .Some(v) => v, .None => __yo_panic("ArrayList.starts_with: get failed"));
          b := match(prefix.get(i), .Some(v) => v, .None => __yo_panic("ArrayList.starts_with: get failed"));
          if(!((a == b)), {
            same = false;
          });
          i = (i + usize(1));
        });
        same
      }
    )
  }),
  /// Whether `self` ends with `suffix` — Rust's `ends_with`.
  ends_with : (fn(self : Self, suffix : Self) -> bool)({
    n := suffix.len();
    cond(
      (n > self._length) => false,
      true => {
        off := (self._length - n);
        (i : usize) = usize(0);
        (same : bool) = true;
        while(runtime((i < n) && same), {
          a := match(self.get(off + i), .Some(v) => v, .None => __yo_panic("ArrayList.ends_with: get failed"));
          b := match(suffix.get(i), .Some(v) => v, .None => __yo_panic("ArrayList.ends_with: get failed"));
          if(!((a == b)), {
            same = false;
          });
          i = (i + usize(1));
        });
        same
      }
    )
  }),
  /// Whether any element equals `value` — a linear scan, O(n), stopping at
  /// the first match. Rust's `Vec::contains`.
  contains : (fn(self : Self, value : T) -> bool)({
    found := false;
    match(
      self._ptr,
      .Some(_ptr) => {
        i := usize(0);
        while((i < self._length) && !(found), i = (i + usize(1)), {
          cond(
            ((_ptr.add(i)).* == value) => {
              found = true;
            },
            true => ()
          );
        });
      },
      .None => ()
    );
    return(found);
  }),
  /// Index of the FIRST element equal to `value`, or `.None` — a linear
  /// scan, O(n). Rust spells this `iter().position(...)`; on a sorted list
  /// reach for `binary_search` instead.
  index_of : (fn(self : Self, value : T) -> Option(usize))({
    (result : Option(usize)) = .None;
    found := false;
    match(
      self._ptr,
      .Some(_ptr) => {
        i := usize(0);
        while((i < self._length) && !(found), i = (i + usize(1)), {
          cond(
            ((_ptr.add(i)).* == value) => {
              result = .Some(i);
              found = true;
            },
            true => ()
          );
        });
      },
      .None => ()
    );
    return(result);
  })
);
impl(
  generic(T : Type),
  ArrayList(T),
  /// Reverse the elements in place, O(n).
  ///
  /// Exchanges raw slots, like `swap`, so no element is dup'd or dropped —
  /// RC-neutral however `T` is refcounted.
  reverse : (fn(self : Self) -> unit)({
    cond(
      (self._length <= usize(1)) => (),
      true =>
        match(
          self._ptr,
          .Some(_ptr) => {
            i := usize(0);
            j := (self._length - usize(1));
            while(i < j, {
              i = (i + usize(1));
              j = (j - usize(1));
            }, {
              tmp := (_ptr.add(i)).*;
              (_ptr.add(i)).* = (_ptr.add(j)).*;
              (_ptr.add(j)).* = tmp;
            });
          },
          .None => ()
        )
    );
  })
);
/// In-place heapsort over raw storage with a caller-supplied strict "less"
/// — O(n log n) worst case, no allocation, no recursion. NOT stable (equal
/// elements may reorder); shared by `sort` and `sort_by`. The sift-down is
/// written inline in both phases: a nested named fn cannot capture `ptr`/
/// `less`, and a bare closure binding has no target type to infer from.
_heapsort_by :: (
  fn(generic(T : Type), ptr : *(T), n : usize, less : Impl(Fn(a : T, b : T) -> bool)) -> unit
)({
  // Phase 1: heapify (sift-down from the last parent to the root).
  (i : usize) = (n / usize(2));
  while(i > usize(0), {
    i = (i - usize(1));
    (root : usize) = i;
    (going : bool) = true;
    while(going, {
      child := ((root * usize(2)) + usize(1));
      cond(
        (child >= n) => {
          going = false;
        },
        true => {
          (largest : usize) = child;
          cond(
            (((child + usize(1)) < n) && less((ptr.add(child)).*, (ptr.add(child + usize(1))).*)) => {
              largest = (child + usize(1));
            },
            true => ()
          );
          cond(
            less((ptr.add(root)).*, (ptr.add(largest)).*) => {
              tmp := (ptr.add(root)).*;
              (ptr.add(root)).* = (ptr.add(largest)).*;
              (ptr.add(largest)).* = tmp;
              root = largest;
            },
            true => {
              going = false;
            }
          );
        }
      );
    });
  });
  // Phase 2: pop the max to the tail, shrinking the heap.
  (end : usize) = n;
  while(end > usize(1), {
    end = (end - usize(1));
    head := (ptr.add(usize(0))).*;
    (ptr.add(usize(0))).* = (ptr.add(end)).*;
    (ptr.add(end)).* = head;
    (root : usize) = usize(0);
    (going : bool) = true;
    while(going, {
      child := ((root * usize(2)) + usize(1));
      cond(
        (child >= end) => {
          going = false;
        },
        true => {
          (largest : usize) = child;
          cond(
            (((child + usize(1)) < end) && less((ptr.add(child)).*, (ptr.add(child + usize(1))).*)) => {
              largest = (child + usize(1));
            },
            true => ()
          );
          cond(
            less((ptr.add(root)).*, (ptr.add(largest)).*) => {
              tmp := (ptr.add(root)).*;
              (ptr.add(root)).* = (ptr.add(largest)).*;
              (ptr.add(largest)).* = tmp;
              root = largest;
            },
            true => {
              going = false;
            }
          );
        }
      );
    });
  });
});
/// STABLE sort over raw storage (D17): equal elements keep their input
/// order, which is what `sort` means in Rust, Python, Java and Go.
///
/// The elements are not what gets sorted — an INDEX array is, by a bottom-up
/// merge sort (naturally stable: a tie takes the left run). The elements then
/// move exactly once each, through the same three-line swap `_heapsort_by`
/// uses, which is witnessed RC-balanced (nothing is disposed during a sort;
/// every element is released exactly once at scope end).
///
/// Sorting indices rather than elements buys two things: the scratch is
/// plain `usize`, so there is no RC-typed uninitialised buffer to get the
/// `consume(p.* = v)` discipline wrong on (the trap that bit `imm/vec`), and
/// the merge is monomorphic — instantiating the generic `_heapsort_by` at a
/// second `T` made the specializer hand the element comparator the index
/// type, emitting C that passes a `size_t` where the closure wants the
/// element struct.
_merge_sort_indices :: (
  fn(
    generic(T : Type),
    order : ArrayList(usize),
    scratch : ArrayList(usize),
    ptr : *(T),
    n : usize,
    less : Impl(Fn(a : T, b : T) -> bool)
  ) -> unit
)({
  (width : usize) = usize(1);
  while(width < n, {
    (lo : usize) = usize(0);
    while(lo < n, {
      mid := cond(((lo + width) < n) => (lo + width), true => n);
      hi := cond(((mid + width) < n) => (mid + width), true => n);
      (a : usize) = lo;
      (b : usize) = mid;
      (w : usize) = lo;
      while(w < hi, {
        take_left := cond(
          (a >= mid) => false,
          (b >= hi) => true,
          // `!less(right, left)` — on a tie the LEFT run wins, which is
          // exactly what makes the merge stable.
          true => !unsafe(less((ptr.add(order(b))).*, (ptr.add(order(a))).*))
        );
        cond(
          take_left => {
            scratch(w) = order(a);
            a = (a + usize(1));
          },
          true => {
            scratch(w) = order(b);
            b = (b + usize(1));
          }
        );
        w = (w + usize(1));
      });
      lo = (lo + (width * usize(2)));
    });
    (c : usize) = usize(0);
    while(c < n, {
      order(c) = scratch(c);
      c = (c + usize(1));
    });
    width = (width * usize(2));
  });
});
_stable_sort_by :: (
  fn(generic(T : Type), ptr : *(T), n : usize, less : Impl(Fn(a : T, b : T) -> bool)) -> unit
)({
  order := ArrayList(usize).new();
  scratch := ArrayList(usize).new();
  (k : usize) = usize(0);
  while(k < n, {
    order.push(k);
    scratch.push(k);
    k = (k + usize(1));
  });
  _merge_sort_indices(order, scratch, ptr, n, less);
  // `order(i)` is the SOURCE index of the element that belongs at `i`. The
  // cycle-following swap below consumes DESTINATION indices ("the element
  // at i moves to dest(i)"), so invert first — applying the cycle walk to
  // source indices sorts the wrong way round (`[A,B,C]` with `order=[2,0,1]`
  // yields `[B,C,A]`, not `[C,A,B]`). `scratch` is free now, so the inverse
  // costs no extra allocation.
  (m : usize) = usize(0);
  while(m < n, {
    scratch(order(m)) = m;
    m = (m + usize(1));
  });
  // Apply the permutation in place by following cycles: O(n) swaps, and the
  // only element movement in the whole routine.
  (i : usize) = usize(0);
  while(i < n, {
    while(scratch(i) != i, {
      j := scratch(i);
      tmp := unsafe((ptr.add(i)).*);
      unsafe((ptr.add(i)).* = (ptr.add(j)).*);
      unsafe((ptr.add(j)).* = tmp);
      scratch(i) = scratch(j);
      scratch(j) = j;
    });
    i = (i + usize(1));
  });
});
impl(
  generic(T : Type),
  where(T <: Ord(T)),
  ArrayList(T),
  /// Sort ascending by `Ord`. STABLE (D17): equal elements keep their input
  /// order, as `sort` does in Rust, Python, Java and Go.
  ///
  /// O(n log n) with one `usize` index array plus scratch allocated for the
  /// merge — `sort_unstable` is the allocation-free heapsort for when order
  /// among equals does not matter.
  sort : (fn(self : Self) -> unit)({
    cond(
      (self._length <= usize(1)) => (),
      true =>
        match(
          self._ptr,
          .Some(_ptr) => _stable_sort_by(_ptr, self._length, (a, b) => (a < b)),
          .None => ()
        )
    );
  }),
  /// Sort ascending by `Ord` WITHOUT preserving the order of equal elements
  /// — Rust's `sort_unstable`. Heapsort: O(n log n) worst case, in place, no
  /// allocation, no recursion (see `_heapsort_by`).
  sort_unstable : (fn(self : Self) -> unit)({
    cond(
      (self._length <= usize(1)) => (),
      true =>
        match(
          self._ptr,
          .Some(_ptr) => _heapsort_by(_ptr, self._length, (a, b) => (a < b)),
          .None => ()
        )
    );
  })
);
/// Equality for ArrayList — two lists are equal if they have the same length
/// and every pair of elements at corresponding indices is equal.
impl(
  generic(T : Type),
  where(T <: Eq(T)),
  ArrayList(T),
  Eq(ArrayList(T))(
    (==) : (fn(lhs : Self, rhs : Self) -> bool)({
      n := lhs.len();
      cond(
        (!(n == rhs.len())) => false,
        true => {
          (i : usize) = usize(0);
          (equal : bool) = true;
          while(runtime((i < n) && equal), {
            match(
              lhs.get(i),
              .Some(a) => match(
                rhs.get(i),
                .Some(b) => {
                  equal = (a == b);
                },
                .None => {
                  equal = false;
                }
              ),
              .None => {
                equal = false;
              }
            );
            i = (i + usize(1));
          });
          equal
        }
      )
    })
  )
);
/// Default implementation — the empty list.
impl(
  generic(T : Type),
  ArrayList(T),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
/// Clone implementation for ArrayList — deep-clones each element.
impl(
  generic(T : Type),
  where(T <: Clone),
  ArrayList(T),
  Clone(
    clone : (fn(inout(self) : Self) -> Self)({
      n := self.len();
      result := Self.with_capacity(n);
      i := usize(0);
      while(i < n, {
        item_opt := self.get(i);
        match(
          item_opt,
          .Some(item) => {
            result.push(item.clone());
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      result
    })
  )
);
/// Iterator over non-overlapping CHUNKS of a list.
///
/// Yo has no slice type, so each chunk is a freshly allocated `ArrayList(T)`
/// COPY rather than a borrowed view — the honest rendering of Rust's `chunks`,
/// whose item is a `&[T]`. Mutating a yielded chunk does not touch the source.
ArrayListChunks :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _src : ArrayList(T),
    _index : usize,
    _size : usize
  )
);
impl(
  generic(T : Type),
  ArrayListChunks(T),
  Iterator(
    Item : ArrayList(T),
    next : (fn(inout(self) : Self) -> Option(ArrayList(T)))({
      n := self._src.len();
      cond(
        (self._index >= n) => Option(ArrayList(T)).None,
        true => {
          end := cond(
            ((self._index + self._size) < n) => (self._index + self._size),
            true => n
          );
          out := self._src.slice_copy(self._index .. end);
          self._index = end;
          Option(ArrayList(T)).Some(out)
        }
      )
    })
  )
);
/// Iterator over overlapping WINDOWS of a list — see `ArrayListChunks` for why
/// each window is a copy.
ArrayListWindows :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _src : ArrayList(T),
    _index : usize,
    _size : usize
  )
);
impl(
  generic(T : Type),
  ArrayListWindows(T),
  Iterator(
    Item : ArrayList(T),
    next : (fn(inout(self) : Self) -> Option(ArrayList(T)))({
      n := self._src.len();
      cond(
        ((self._index + self._size) > n) => Option(ArrayList(T)).None,
        true => {
          out := self._src.slice_copy(self._index .. (self._index + self._size));
          self._index = (self._index + usize(1));
          Option(ArrayList(T)).Some(out)
        }
      )
    })
  )
);
export(
  ArrayList,
  ArrayListError,
  ArrayListIter,
  ArrayListIterPtr,
  ArrayListChunks,
  ArrayListWindows
);
// =============================================================================
// array_list! literal macro
// =============================================================================
/// Internal helper: build a list of `tmp.push(elem)` statements from `elems`.
__array_list_build_pushes :: (fn(comptime(tmp) : Expr, comptime(elems) : ExprList) -> comptime(ExprList))(
  cond(
    (elems.len() == usize(0)) => ExprList(),
    true => {
      first :: elems.car();
      rest :: elems.cdr();
      stmt :: quote(unquote(tmp).push(unquote(first)));
      stmt.cons(recur(tmp, rest))
    }
  )
);
/// `array_list` macro — construct an `ArrayList(T)` literal.
///
/// The element type `T` is inferred from the first element via `typeof`, so
/// at least one element is required.
///
/// ## Example
/// ```rust
/// xs := array_list(i32(1), i32(2), i32(3));
/// names := array_list(`alice`, `bob`);
/// ```
///
/// Expands to:
/// ```rust
/// {
///   __first := <first elem>;
///   __tmp := ArrayList(typeof(__first)).new();
///   __tmp.push(__first);
///   __tmp.push(<elem 2>);
///   ...
///   __tmp
/// }
/// ```
array_list :: (fn(...(quote(elems))) -> unquote(Expr))({
  __ :: comptime_assert(
    elems.len() > usize(0),
    "array_list requires at least one element to infer the element type"
  );
  first :: elems.car();
  rest :: elems.cdr();
  tmp :: gensym("array_list");
  first_tmp :: gensym("array_list_first");
  rest_pushes :: __array_list_build_pushes(tmp, rest);
  quote({
    unquote(first_tmp) := unquote(first);
    unquote(tmp) := ArrayList(typeof(unquote(first_tmp))).new();
    unquote(tmp).push(unquote(first_tmp));
    unquote_splicing(rest_pushes);
    unquote(tmp)
  })
});
/// Range slicing on fixed-size arrays returns an OWNED ArrayList copy
/// (`arr(a..b)` lowers to this — plans/archive/SLICE_REWORK.md).
impl(
  generic(T : Type, N : usize),
  Array(T, N),
  /// Owned copy of `[r.start, r.end)` of a fixed-size array. The end is
  /// clamped to `N`, so an over-long range yields a short list.
  slice_copy : (fn(self : Array(T, N), r : Range(usize)) -> ArrayList(T))({
    e := cond((r.end > N) => N, true => r.end);
    out := ArrayList(T).new();
    i := r.start;
    while(i < e, i = (i + usize(1)), {
      out.push(self(i));
    });
    out
  }),
  /// Inclusive-range companion of `slice_copy` (`arr(a..=b)`).
  slice_copy_inclusive : (fn(self : Array(T, N), r : RangeInclusive(usize)) -> ArrayList(T))({
    last := cond((r.end >= N) => N, true => (r.end + usize(1)));
    out := ArrayList(T).new();
    i := r.start;
    while(i < last, i = (i + usize(1)), {
      out.push(self(i));
    });
    out
  })
);
/// Build an `ArrayList(T)` from any iterator of `T` — the target of
/// `it.collect(ArrayList(T))`. The iteration loop lives in the blanket
/// `collect` (std/prelude.yo); these two statics are the seed and the step.
impl(
  generic(T : Type),
  ArrayList(T),
  FromIterator(
    Elem : T,
    from_iter_new : (fn() -> Self)(
      ArrayList(T).new()
    ),
    from_iter_add : (fn(acc : Self, item : T) -> Self)({
      acc.push(item);
      acc
    })
  )
);

// ============================================================================
// Real sort (heapsort), sort_by, binary_search, retain, extend
// (plans/archive/STD_API_AUDIT.md §7 collections row)
// ============================================================================
impl(
  generic(T : Type),
  ArrayList(T),
  /// Sort by a caller-supplied strict "less" — `less(a, b)` is true when `a`
  /// must come before `b`. STABLE: equal elements keep their input order,
  /// matching Rust's `sort_by`. Use `sort_unstable_by` for the
  /// allocation-free heapsort.
  sort_by : (fn(self : Self, less : Impl(Fn(a : T, b : T) -> bool)) -> unit)({
    cond(
      (self._length <= usize(1)) => (),
      true => match(
        self._ptr,
        .Some(_ptr) => _stable_sort_by(_ptr, self._length, less),
        .None => ()
      )
    );
  }),
  /// Sort ascending by a KEY extracted from each element — Rust's
  /// `sort_by_key`. Stable, like `sort_by`, which it delegates to.
  ///
  /// The key type is a method-level `generic(K : Type)`, which the clause
  /// order requires to come BEFORE `self`; it is inferred from the closure at
  /// the call site, so `xs.sort_by_key((p) => p.age)` needs no annotation.
  sort_by_key : (
    fn(
      generic(K : Type),
      self : Self,
      key : Impl(Fn(v : T) -> K),
      where(K <: Ord(K))
    ) -> unit
  )(
    self.sort_by((a, b) => (key(a) < key(b)))
  ),
  /// Binary search over a list ordered by `cmp` — Rust's `binary_search_by`.
  ///
  /// `cmp` reports how each ELEMENT orders against the target (`.Less` when
  /// the element comes first), so searching does not require constructing a
  /// `T` to compare against — which is the whole reason to reach for this
  /// over `binary_search`. `.Ok(index)` of a match (any one of an equal run),
  /// or `.Err(insertion_index)`.
  binary_search_by : (fn(self : Self, cmp : Impl(Fn(v : T) -> Ordering)) -> Result(usize, usize))({
    (lo : usize) = usize(0);
    (hi : usize) = self._length;
    (found : Option(usize)) = Option(usize).None;
    while((lo < hi) && found.is_none(), {
      mid := (lo + ((hi - lo) / usize(2)));
      match(
        cmp(self(mid)),
        .Less => {
          lo = (mid + usize(1));
        },
        .Greater => {
          hi = mid;
        },
        .Equal => {
          found = Option(usize).Some(mid);
        }
      );
    });
    match(
      found,
      .Some(at) => Result(usize, usize).Ok(at),
      .None => Result(usize, usize).Err(lo)
    )
  }),
  /// Non-overlapping chunks of `size`, in order — Rust's `chunks`. The final
  /// chunk is SHORT when the length is not a multiple of `size`.
  ///
  /// PANICS on `size == 0`, as Rust does.
  chunks : (fn(self : Self, size : usize) -> ArrayListChunks(T))({
    if(size == usize(0), {
      __yo_panic("ArrayList.chunks: size must be non-zero");
    });
    ArrayListChunks(T)(_src : self, _index : usize(0), _size : size)
  }),
  /// Overlapping windows of EXACTLY `size`, advancing one element at a time —
  /// Rust's `windows`. Yields nothing when the list is shorter than `size`.
  ///
  /// PANICS on `size == 0`, as Rust does.
  windows : (fn(self : Self, size : usize) -> ArrayListWindows(T))({
    if(size == usize(0), {
      __yo_panic("ArrayList.windows: size must be non-zero");
    });
    ArrayListWindows(T)(_src : self, _index : usize(0), _size : size)
  }),
  /// Sort by a caller-supplied strict "less" WITHOUT preserving the order of
  /// equal elements (heapsort). Rust's `sort_unstable_by`.
  sort_unstable_by : (fn(self : Self, less : Impl(Fn(a : T, b : T) -> bool)) -> unit)({
    cond(
      (self._length <= usize(1)) => (),
      true => match(
        self._ptr,
        .Some(_ptr) => _heapsort_by(_ptr, self._length, less),
        .None => ()
      )
    );
  }),
  /// Keep only the elements `pred` accepts, in place and in order; the
  /// rejected elements are dropped. One pass: the survivors are collected
  /// into a fresh list, `clear` releases every original, `extend` moves the
  /// survivors back — O(n) with a single allocation, and every RC step is one
  /// of the module's proven public operations (push / clear / extend). The
  /// first cut compacted through raw pointers and double-released RC elements
  /// (the Linux-ASan heap-use-after-free on PR #313's first run; local ASan is
  /// non-functional, so CI was the first to see it); the second walked
  /// backwards over `drain`, which was O(n²) with an allocation per rejection
  /// (issues/fixed/array-list-retain-is-quadratic.md).
  retain : (fn(self : Self, pred : Impl(Fn(v : T) -> bool)) -> unit)({
    n := self._length;
    kept := Self.with_capacity(n);
    (i : usize) = usize(0);
    while(i < n, i = (i + usize(1)), {
      v := self(i);
      cond(
        pred(v) => {
          kept.push(v);
        },
        true => ()
      );
    });
    self.clear();
    self.extend(kept);
  }),
  /// Append a copy of every element of `other`.
  extend : (fn(self : Self, other : ArrayList(T)) -> unit)({
    (i : usize) = usize(0);
    n := other.len();
    while(i < n, i = (i + usize(1)), {
      self.push(other(i));
    });
  })
);
impl(
  generic(T : Type),
  where(T <: Ord(T)),
  ArrayList(T),
  /// Binary search over a SORTED list (ascending, `sort`'s order):
  /// `.Ok(index)` of a matching element (any one of an equal run), or
  /// `.Err(insertion_index)` where the value would keep the order.
  binary_search : (fn(self : Self, value : T) -> Result(usize, usize))({
    (lo : usize) = usize(0);
    (hi : usize) = self.len();
    (found : Option(usize)) = Option(usize).None;
    while((lo < hi) && found.is_none(), {
      mid := (lo + ((hi - lo) / usize(2)));
      cur := self(mid);
      cond(
        (cur < value) => {
          lo = (mid + usize(1));
        },
        (value < cur) => {
          hi = mid;
        },
        true => {
          found = Option(usize).Some(mid);
        }
      );
    });
    match(
      found,
      .Some(at) => Result(usize, usize).Ok(at),
      .None => Result(usize, usize).Err(lo)
    )
  })
);
export(array_list);
