//! Dynamic array (vector) with amortized O(1) push and O(1) indexed access.
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator, AllocError, size_would_overflow } :: import("../allocator.yo");
{ memmove, memcpy, memset } :: import("../libc/string.yo");
{ SIZE_MAX } :: import("../libc/stdint.yo");
{ malloc, calloc, realloc, free, aligned_alloc } :: GlobalAllocator;
/// Error variants for ArrayList operations.
ArrayListError :: enum(
  /// Memory allocation failed.
  AllocError(error : AllocError),
  /// Index is out of bounds for the current length.
  IndexOutOfBounds(index : usize, length : usize),
  /// Attempted to access an element from an empty list.
  EmptyList
);
/// Generic growable array similar to Rust's `Vec<T>`.
/// Heap-allocated with automatic resizing and reference-counted cleanup.
ArrayList :: (fn(comptime(T) : Type) -> comptime(Type))(
  ref(
    struct(
      _ptr : ?(*(T)),
      _length : usize,
      _capacity : usize
    )
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  len : (fn(self : Self) -> usize)({
    return(self._length);
  }),
  /**
  * True when the list contains no elements.
  */
  is_empty : (fn(self : Self) -> bool)({
    return(self._length == usize(0));
  }),
  capacity : (fn(self : Self) -> usize)({
    return(self._capacity);
  }),
  /**
  * Get a pointer to the underlying data buffer
  * Returns .None if the list is empty or has no allocated buffer
  */
  ptr : (fn(self : Self) -> ?(*(T)))(
    self._ptr
  ),
  /**     * Directly set the length of the ArrayList
  * UNSAFE: This does not initialize new elements or free removed elements
  * Only use when you've manually populated the buffer (e.g., via direct memory writes)
  */
  set_len : (fn(self : Self, new_len : usize) -> unit)({
    cond(
      (new_len <= self._capacity) => {
        self._length = new_len;
      },
      true => __yo_panic("set_len: new length exceeds capacity")
    );
  }),
  /**
  * Create a new empty ArrayList
  */
  new : (fn() -> Self)(
    Self(
      _ptr : .None,
      _length : usize(0),
      _capacity : usize(0)
    )
  ),
  /**
  * Create an ArrayList by copying the elements of a fixed-size array.
  * The owned-copy companion to array range-indexing
  * (plans/archive/SLICE_REWORK.md).
  */
  /**
  * Owned copy of the elements in `[r.start, r.end)` — JS-style range
  * slicing with value semantics (plans/archive/SLICE_REWORK.md: `list(a..b)`
  * lowers to this).
  */
  slice_copy : (fn(self : Self, r : Range(usize)) -> Self)({
    e := cond((r.end > self.len()) => self.len(), true => r.end);
    out := Self.new();
    i := r.start;
    while(i < e, i = (i + usize(1)), {
      match(
        self.get(i),
        .Some(v) => {
          ___ := out.push(v);
        },
        .None => ()
      );
    });
    out
  }),
  /// Inclusive-range companion of `slice_copy` (`list(a..=b)`).
  slice_copy_inclusive : (fn(self : Self, r : RangeInclusive(usize)) -> Self)({
    last := cond((r.end >= self.len()) => self.len(), true => (r.end + usize(1)));
    out := Self.new();
    i := r.start;
    while(i < last, i = (i + usize(1)), {
      match(
        self.get(i),
        .Some(v) => {
          ___ := out.push(v);
        },
        .None => ()
      );
    });
    out
  }),
  from_array : (fn(generic(N : usize), arr : Array(T, N)) -> Self)({
    out := Self.with_capacity(N);
    i := usize(0);
    while(i < N, i = (i + usize(1)), {
      out.push(arr(i));
    });
    out
  }),
  /**
  * Create an ArrayList with a specific initial cap
  */
  with_capacity : (fn(cap : usize) -> Self)(
    cond(
      (cap == usize(0)) =>
        Self.new(),
      // `sizeof(T) * cap` is computed in usize and WRAPS. Without this guard a
      // capacity from untrusted input (a length prefix off a socket, say) hands
      // malloc a tiny — or zero — size while the list still reports `cap`, so
      // the first pushes write outside the allocation: silent heap corruption
      // (issues/fixed/collection-capacity-overflow-unchecked.md). Rust's
      // `Vec::with_capacity` panics with "capacity overflow" here too.
      size_would_overflow(T, cap) =>
        __yo_panic("ArrayList.with_capacity: capacity overflow"),
      // Zero-sized element (`unit`, an all-`unit` struct): the buffer holds no
      // bytes, so the list never grows — see `_zst_anchor`.
      (sizeof(T) == usize(0)) => Self._zst_anchor(),
      true => {
        ptr_result := malloc(sizeof(T) * cap);
        match(
          ptr_result,
          .Some(_ptr) =>
            Self(
              _ptr : .Some((*(T))(_ptr)),
              _length : usize(0),
              _capacity : cap
            ),
          .None => __yo_panic("malloc returned None")
        )
      }
    )
  ),
  /**
  * The one buffer an ArrayList of a ZERO-SIZED element type ever has.
  *
  * `sizeof(T) == 0` (`unit`, an all-`unit` aggregate, `Array(unit, N)`) means
  * the elements occupy no bytes: a store writes nothing, a read reads nothing,
  * and the byte size of every buffer is 0. Rust's `Vec<()>` never allocates
  * and reports `capacity() == usize::MAX`. Yo cannot conjure a non-null
  * dangling pointer, so the stand-in is ONE one-byte block, allocated once and
  * never resized: the capacity is `SIZE_MAX`, so `push` never reaches the grow
  * path, and `shrink_to_fit` is a no-op. Going through the allocator with
  * `sizeof(T) * cap == 0` instead would `malloc(0)` and then `realloc(p, 0)` —
  * which frees `p` and returns NULL on glibc and the Windows CRT — and the
  * list would report "allocation failed" on its second growth.
  */
  _zst_anchor : (fn() -> Self)(
    match(
      malloc(usize(1)),
      .Some(anchor) =>
        Self(
          _ptr : .Some((*(T))(anchor)),
          _length : usize(0),
          _capacity : SIZE_MAX
        ),
      .None => __yo_panic("malloc returned None")
    )
  ),
  /**
  * Add an element to the end of the ArrayList
  */
  push : (fn(self : Self, value : T) -> Result(unit, ArrayListError))(
    // Check if we need to grow
    cond(
      (self._length >= self._capacity) => {
        // Need to grow - calculate new capacity. A zero-sized element type
        // takes the anchor buffer and `SIZE_MAX` capacity instead (see
        // `_zst_anchor`), so this branch runs once for it and never again.
        new_capacity := cond(
          (sizeof(T) == usize(0)) => SIZE_MAX,
          (self._capacity == usize(0)) => usize(4),
          true => (self._capacity * usize(2))
        );
        // Allocate or reallocate
        new_some_ptr := match(
          self._ptr,
          .None => GlobalAllocator.malloc(cond((sizeof(T) == usize(0)) => usize(1), true => (sizeof(T) * new_capacity))),
          .Some(old_ptr) => GlobalAllocator.realloc(
            .Some((*(void))(old_ptr)),
            sizeof(T) * new_capacity
          )
        );
        match(
          new_some_ptr,
          .Some(new_ptr) => {
            typed_ptr := *(T)(new_ptr);
            self._ptr = .Some(typed_ptr);
            self._capacity = new_capacity;
            // Now add the element at position length
            target_ptr := typed_ptr.add(self._length);
            consume(target_ptr.* = value);
            self._length = (self._length + usize(1));
            .Ok(())
          },
          .None => .Err(.AllocError(.OutOfMemory))
        )
      },
      true =>
        // Have capacity - just add the element
        match(
          self._ptr,
          .Some(_ptr) => {
            target_ptr := _ptr.add(self._length);
            consume(target_ptr.* = value);
            self._length = (self._length + usize(1));
            .Ok(())
          },
          .None => __yo_panic("ArrayList has capacity but no ptr")
        )
    )
  ),
  /**
  * Remove and return the last element
  */
  pop : (fn(self : Self) -> Option(T))(
    cond(
      (self._length == usize(0)) => .None,
      true => {
        self._length = (self._length - usize(1));
        match(
          self._ptr,
          .None => .None,
          .Some(_ptr) => {
            last_element_ptr := _ptr.add(self._length);
            last_element := last_element_ptr.*;
            // Drop the slot's reference since it's no longer tracked
            // (length was decremented, so dispose won't reach this slot)
            unsafe.drop(last_element_ptr.*);
            .Some(last_element)
          }
        )
      }
    )
  ),
  /**
  * Get an element by index (bounds checked)
  */
  get : (fn(self : Self, index : usize) -> Option(T))(
    cond(
      (index >= self._length) => .None,
      true =>
        match(
          self._ptr,
          .None => .None,
          .Some(_ptr) => .Some((_ptr.add(index)).*)
        )
    )
  ),
  /**
  * Shrink the capacity to match the current length
  * This reduces memory usage but may cause reallocation on next push
  */
  shrink_to_fit : (fn(self : Self) -> Result(unit, ArrayListError))(
    // If length equals capacity or both are zero, nothing to do. A zero-sized
    // element type has nothing to shrink either (its buffer is the one-byte
    // anchor; `realloc(p, 0)` would free it — see `_zst_anchor`).
    cond(
      ((self._length == self._capacity) || (self._capacity == usize(0))) => .Ok(()),
      (sizeof(T) == usize(0)) => .Ok(()),
      true =>
        // If length is zero, free the buffer
        cond(
          (self._length == usize(0)) => {
            match(
              self._ptr,
              .Some(_ptr) => {
                GlobalAllocator.free(.Some(*(void)(_ptr)));
                self._ptr = .None;
                self._capacity = usize(0);
              },
              .None => ()
            );
            .Ok(())
          },
          true =>
            // Otherwise, reallocate to exact size
            match(
              self._ptr,
              .None => __yo_panic("ArrayList has capacity but no ptr"),
              .Some(old_ptr) => {
                new_some_ptr := GlobalAllocator.realloc(
                  .Some(*(void)(old_ptr)),
                  sizeof(T) * self._length
                );
                match(
                  new_some_ptr,
                  .Some(new_ptr) => {
                    self._ptr = .Some(*(T)(new_ptr));
                    self._capacity = self._length;
                    .Ok(())
                  },
                  .None => .Err(.AllocError(.OutOfMemory))
                )
              }
            )
        )
    )
  ),
  _free_elements : (fn(self : Self) -> unit)(
    cond(
      Type.contains_rc_type(T) => {
        if(self._length > usize(0), {
          i := usize(0);
          base_ptr := self._ptr.unwrap();
          while(i < self._length, i = (i + usize(1)), {
            element_ptr := base_ptr.add(i);
            unsafe.drop(element_ptr.*);
          });
        });
      },
      true => ()
    )
  ),
  /**
  * Removes the elements in `r.start .. r.end` (half-open) and returns them
  * as a fresh ArrayList(T), in order. Rust `Vec::drain` parity for the
  * failure contract: an inverted range or an end past the length panics —
  * the old `remove(start, count)` silently clamped the count, which hid
  * caller bugs. (§5: the two-argument spelling is gone; use this, or the
  * single-index `remove`.)
  */
  drain : (fn(self : Self, r : Range(usize)) -> Self)({
    if((r.start > r.end) || (r.end > self._length), {
      __yo_panic("ArrayList.drain: invalid range for this length");
    });
    count := (r.end - r.start);
    out := Self.new();
    cond(
      (count == usize(0)) => out,
      true =>
        match(
          self._ptr,
          .None => __yo_panic("ArrayList has length but no ptr"),
          .Some(_ptr) => {
            // Collect the drained elements FIRST: get dups each one, so the
            // shift below can drop the originals with balanced RCs. (ci, not
            // i: the shift arms below redeclare i in their own scopes.)
            ci := usize(0);
            while(ci < count, ci = (ci + usize(1)), {
              match(
                self.get(r.start + ci),
                .Some(e) => out.push(e),
                .None => __yo_panic("ArrayList.drain: get failed inside bounds")
              );
            });
            // Shift remaining elements left to fill the gap
            // We need to move elements from [r.start + count, length) to [r.start, ...)
            elements_after := ((self._length - r.start) - count);
            cond(
              (elements_after > usize(0)) => {
                src_ptr := _ptr.add(r.start + count);
                dst_ptr := _ptr.add(r.start);
                cond(
                  Type.contains_rc_type(T) => {
                    // For RC types, iterate and properly manage RC
                    // The assignment dst.* = src.* will:
                    // 1. Dup src.* (RC+1)
                    // 2. Drop old dst.* (either element being removed, or previous iteration's copy)
                    // 3. Write to dst.*
                    i := usize(0);
                    while(i < elements_after, i = (i + usize(1)), {
                      dst := dst_ptr.add(i);
                      src := src_ptr.add(i);
                      dst.* = src.*;
                    });
                    // Drop the non-overlapping tail stale pointers
                    j := usize(0);
                    tail_start := (r.start + elements_after);
                    while(j < count, j = (j + usize(1)), {
                      tail_ptr := _ptr.add(tail_start + j);
                      unsafe.drop(tail_ptr.*);
                    });
                  },
                  true => {
                    // For non-RC types, use fast memmove
                    element_size := sizeof(T);
                    bytes_to_move := (elements_after * element_size);
                    dst_void := *(void)(dst_ptr);
                    src_void := *(void)(src_ptr);
                    // SAFETY: dst_ptr and src_ptr both point into self._ptr's
                    // contiguous element buffer. `elements_after = self._length - (r.start + count)`
                    // counts elements still in-bounds after the drain range,
                    // so `bytes_to_move = elements_after * sizeof(T)` stays within
                    // the allocated buffer. memmove handles overlap.
                    unsafe(memmove(dst_void, src_void, bytes_to_move));
                  }
                );
              },
              true => {
                // No elements to shift, just drop the drained elements
                cond(
                  Type.contains_rc_type(T) => {
                    i := usize(0);
                    while(i < count, i = (i + usize(1)), {
                      element_ptr := _ptr.add(r.start + i);
                      unsafe.drop(element_ptr.*);
                    });
                  },
                  true => ()
                );
              }
            );
            // Update length
            self._length = (self._length - count);
            out
          }
        )
    )
  }),
  /**
  * Removes and returns the element at `idx`, shifting the tail left.
  * Panics if `idx` is out of bounds (the `Index` impl's contract).
  */
  remove : (fn(self : Self, idx : usize) -> T)({
    if(idx >= self._length, {
      __yo_panic("ArrayList.remove: index out of bounds");
    });
    match(
      self.get(idx),
      .Some(elem) => {
        // get dup'd the element; drain drops the original — RC balanced.
        _r := self.drain(idx .. (idx + usize(1)));
        elem
      },
      .None => __yo_panic("ArrayList.remove: get failed after bounds check")
    )
  }),
  /**
  * Create a new ArrayList containing a slice of elements from start to end (exclusive)
  * Similar to array slicing in many languages: array[start:end]
  * Returns a new ArrayList with copied elements
  */
  slice : (fn(self : Self, start : usize, end : usize) -> Result(Self, ArrayListError))(
    // Validate indices
    cond(
      (start > self._length) =>
        .Err(.IndexOutOfBounds(index : start, length : self._length)),
      (end > self._length) =>
        .Err(.IndexOutOfBounds(index : end, length : self._length)),
      (start > end) =>
        .Err(.IndexOutOfBounds(index : start, length : end)),
      true => {
        slice_length := (end - start);
        // If slice is empty, return empty ArrayList
        cond(
          (slice_length == usize(0)) =>
            .Ok(Self.new()),
          true =>
            match(
              self._ptr,
              .None => __yo_panic("ArrayList has length but no ptr"),
              .Some(src_ptr) => {
                // Create new ArrayList with exact capacity
                new_list := Self.with_capacity(slice_length);
                match(
                  new_list._ptr,
                  .None => .Err(.AllocError(.OutOfMemory)),
                  .Some(dst_ptr) => {
                    // Copy elements
                    i := usize(0);
                    while(i < slice_length, i = (i + usize(1)), {
                      src := src_ptr.add(start + i);
                      dst := dst_ptr.add(i);
                      consume(dst.* = src.*);
                    });
                    // Set the length of the new list
                    new_list._length = slice_length;
                    .Ok(new_list)
                  }
                )
              }
            )
        )
      }
    )
  ),
  /**
  * Ensure the ArrayList can hold at least `min_cap` total elements
  * without further reallocation.
  */
  ensure_total_capacity : (fn(self : Self, min_cap : usize) -> unit)({
    cond(
      (min_cap <= self._capacity) => (),
      // Same wrap as `with_capacity` — and the doubling loop below has a second
      // face: once `cap * 2` wraps to 0 the loop can never reach `min_cap`, so
      // an oversized request SPINS FOREVER instead of failing
      // (issues/fixed/collection-capacity-overflow-unchecked.md).
      size_would_overflow(T, min_cap) =>
        __yo_panic("ArrayList.ensure_total_capacity: capacity overflow"),
      // Zero-sized element type: the anchor buffer satisfies every capacity
      // (see `_zst_anchor`); `min_cap <= self._capacity` above catches it once
      // the anchor is in place.
      (sizeof(T) == usize(0)) => {
        anchor := Self._zst_anchor();
        self._ptr = anchor._ptr;
        self._capacity = anchor._capacity;
      },
      true => {
        new_capacity := cond(
          (self._capacity == usize(0)) => min_cap,
          true => {
            cap := self._capacity;
            // `min_cap` is known not to overflow `sizeof(T) * min_cap`, but the
            // doubling itself can still wrap. Fall back to `min_cap` in that
            // one case; every reachable growth keeps the usual doubling.
            while(cap < min_cap, {
              cap = cond(
                (cap > (SIZE_MAX / usize(2))) => min_cap,
                true => (cap * usize(2))
              );
            });
            cap
          }
        );
        new_some_ptr := match(
          self._ptr,
          .None => GlobalAllocator.malloc(sizeof(T) * new_capacity),
          .Some(old_ptr) => GlobalAllocator.realloc(
            .Some((*(void))(old_ptr)),
            sizeof(T) * new_capacity
          )
        );
        match(
          new_some_ptr,
          .Some(new_ptr) => {
            self._ptr = .Some((*(T))(new_ptr));
            self._capacity = new_capacity;
          },
          .None => __yo_panic("ArrayList.ensure_total_capacity: allocation failed")
        );
      }
    );
  }),
  /**
  * Append `count` elements from a raw pointer using memcpy.
  * The caller must ensure `src` points to at least `count` valid elements.
  */
  extend_from_ptr : (fn(self : Self, src : *(T), count : usize) -> unit)({
    cond(
      (count == usize(0)) => (),
      true => {
        self.ensure_total_capacity(self._length + count);
        match(
          self._ptr,
          .Some(dst_base) => {
            dst := (*(void))(dst_base.add(self._length));
            _ := unsafe(memcpy(dst, (*(void))(src), count * sizeof(T)));
            self._length = (self._length + count);
          },
          .None => __yo_panic("ArrayList.extend_from_ptr: no ptr after ensure_total_capacity")
        );
      }
    );
  }),
  /**
  * Clear all elements but keep capacity
  */
  clear : (fn(self : Self) -> unit)({
    Self._free_elements(self);
    self._length = usize(0);
  }),
  /**
  * Fill all elements with a byte pattern using memset.
  * Useful for zeroing bool/integer arrays in O(1).
  * Only safe for types without RC (e.g., bool, u8, usize).
  */
  fill_with_byte : (fn(self : Self, byte_val : int) -> unit)(
    match(
      self._ptr,
      .None => (),
      .Some(_ptr) => {
        _ := unsafe(memset((*(void))(_ptr), byte_val, self._length * sizeof(T)));
      }
    )
  ),
  /**
  * Resize ArrayList to exactly `new_len` elements, filling new slots with
  * a byte pattern via memset. Does not call destructors on removed elements.
  * Only safe for trivial types (bool, u8, usize, etc.).
  */
  resize_with_byte : (fn(self : Self, new_len : usize, byte_val : int) -> unit)({
    cond(
      (new_len <= self._length) => {
        self._length = new_len;
      },
      true => {
        self.ensure_total_capacity(new_len);
        match(
          self._ptr,
          .Some(_ptr) => {
            start := (*(void))(_ptr.add(self._length));
            fill_count := ((new_len - self._length) * sizeof(T));
            _ := unsafe(memset(start, byte_val, fill_count));
            self._length = new_len;
          },
          .None => __yo_panic("ArrayList.resize_with_byte: no ptr after ensure")
        );
      }
    );
  })
);
impl(
  generic(T : Type),
  ArrayList(T),
  Index(usize)(
    /// The output type is the element type `T`.
    Output : T,
    /// Returns a pointer to the element at the given index. Panics if the index is out of bounds.
    index : (fn(inout(self) : Self, idx : usize) -> *(Self.Output))({
      // Bounds check via `if` + `__yo_panic` (not `assert`: this module is
      // inside `std/assert`'s dependency cycle and cannot import it).
      if(idx >= self._length, {
        __yo_panic("ArrayList: index out of bounds");
      });
      match(
        self._ptr,
        .Some(_ptr) => _ptr.add(idx),
        .None => __yo_panic("ArrayList: index on empty list")
      )
    })
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  Dispose(
    /**
    * RAII destructor - automatically called when ArrayList goes out of scope
    * For `object`, this is called when the reference count drops to zero
    */
    dispose : (fn(self : Self) -> unit)({
      match(
        self._ptr,
        .Some(_ptr) => {
          Self._free_elements(self);
          self._length = usize(0);
          GlobalAllocator.free(.Some(*(void)(_ptr)));
          self._ptr = .None;
        },
        .None => ()
      );
    })
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  Trace(
    /**
    * Cycle-GC tracing. The elements live in a malloc'd buffer the compiler's
    * auto-derived field walk cannot reach, so trace each element's buffer slot.
    * `tracer.visit` takes the slot POINTER and reads it WITHOUT touching the
    * element's reference count — a by-value managed handle would be dup'd then
    * dropped, freeing a live element mid-collection.
    */
    trace : (fn(self : Self, tracer : GcTracer) -> unit)({
      match(
        self._ptr,
        .Some(base) => {
          (i : usize) = usize(0);
          while(i < self._length, {
            tracer.visit(base.add(i));
            i = (i + usize(1));
          });
        },
        .None => ()
      );
    })
  )
);
// === Iterator support ===
/**
* Value iterator for ArrayList - yields elements by value (T)
* Used by into_iter() / IntoIterator trait
*/
ArrayListIter :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _list : ArrayList(T),
    _index : usize,
    /// How many elements `next_back` has already taken off the END. A COUNTER
    /// rather than a back cursor, so the forward guard keeps reading
    /// `_list._length` LIVE — pushing during a forward-only walk still extends
    /// it exactly as before.
    _back_taken : usize
  )
);
impl(
  generic(T : Type),
  ArrayListIter(T),
  Iterator(
    Item : T,
    next : (fn(inout(self) : Self) -> Option(T))(
      cond(
        ((self._index + self._back_taken) >= self._list._length) => .None,
        true => {
          value := self._list.get(self._index);
          self._index = (self._index + usize(1));
          value
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  ArrayListIter(T),
  DoubleEndedIterator(
    Item : T,
    next_back : (fn(inout(self) : Self) -> Option(T))(
      cond(
        ((self._index + self._back_taken) >= self._list._length) => .None,
        true => {
          self._back_taken = (self._back_taken + usize(1));
          self._list.get(self._list._length - self._back_taken)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  IntoIterator(
    Item : T,
    IntoIter : ArrayListIter(T),
    into_iter : (fn(self : Self) -> ArrayListIter(T))(
      ArrayListIter(T)(_list : self, _index : usize(0), _back_taken : usize(0))
    )
  )
);
impl(
  generic(T : Type),
  ArrayList(T),
  /**
  * Non-consuming iteration over a shared handle: yields each element by
  * value (each dup'd), leaving the list intact — for(list.iter(), ...)
  * where into_iter would move the list. HashMap.keys/values established
  * the shape: the receiver arrives RC-dup'd at the method boundary, so
  * moving it into the iterator is balanced. Live-length semantics are the
  * iterator's own (see ArrayListIter).
  */
  iter : (fn(self : Self) -> ArrayListIter(T))(
    ArrayListIter(T)(_list : self, _index : usize(0), _back_taken : usize(0))
  )
);
impl(
  generic(T : Type),
  where(T <: Eq(T)),
  ArrayList(T),
  /**
  * Check if the list contains a value
  */
  contains : (fn(self : Self, value : T) -> bool)({
    found := false;
    match(
      self._ptr,
      .Some(_ptr) => {
        i := usize(0);
        while((i < self._length) && !(found), i = (i + usize(1)), {
          cond(
            ((_ptr.add(i)).* == value) => {
              found = true;
            },
            true => ()
          );
        });
      },
      .None => ()
    );
    return(found);
  }),
  /**
  * Find the first index of a matching value
  * Returns .Some(index) if found, .None otherwise
  */
  index_of : (fn(self : Self, value : T) -> Option(usize))({
    (result : Option(usize)) = .None;
    found := false;
    match(
      self._ptr,
      .Some(_ptr) => {
        i := usize(0);
        while((i < self._length) && !(found), i = (i + usize(1)), {
          cond(
            ((_ptr.add(i)).* == value) => {
              result = .Some(i);
              found = true;
            },
            true => ()
          );
        });
      },
      .None => ()
    );
    return(result);
  })
);
impl(
  generic(T : Type),
  ArrayList(T),
  /**
  * Reverse elements in place
  */
  reverse : (fn(self : Self) -> unit)({
    cond(
      (self._length <= usize(1)) => (),
      true =>
        match(
          self._ptr,
          .Some(_ptr) => {
            i := usize(0);
            j := (self._length - usize(1));
            while(i < j, {
              i = (i + usize(1));
              j = (j - usize(1));
            }, {
              tmp := (_ptr.add(i)).*;
              (_ptr.add(i)).* = (_ptr.add(j)).*;
              (_ptr.add(j)).* = tmp;
            });
          },
          .None => ()
        )
    );
  })
);
/// In-place heapsort over raw storage with a caller-supplied strict "less"
/// — O(n log n) worst case, no allocation, no recursion. NOT stable (equal
/// elements may reorder); shared by `sort` and `sort_by`. The sift-down is
/// written inline in both phases: a nested named fn cannot capture `ptr`/
/// `less`, and a bare closure binding has no target type to infer from.
_heapsort_by :: (
  fn(generic(T : Type), ptr : *(T), n : usize, less : Impl(Fn(a : T, b : T) -> bool)) -> unit
)({
  // Phase 1: heapify (sift-down from the last parent to the root).
  (i : usize) = (n / usize(2));
  while(i > usize(0), {
    i = (i - usize(1));
    (root : usize) = i;
    (going : bool) = true;
    while(going, {
      child := ((root * usize(2)) + usize(1));
      cond(
        (child >= n) => {
          going = false;
        },
        true => {
          (largest : usize) = child;
          cond(
            (((child + usize(1)) < n) && less((ptr.add(child)).*, (ptr.add(child + usize(1))).*)) => {
              largest = (child + usize(1));
            },
            true => ()
          );
          cond(
            less((ptr.add(root)).*, (ptr.add(largest)).*) => {
              tmp := (ptr.add(root)).*;
              (ptr.add(root)).* = (ptr.add(largest)).*;
              (ptr.add(largest)).* = tmp;
              root = largest;
            },
            true => {
              going = false;
            }
          );
        }
      );
    });
  });
  // Phase 2: pop the max to the tail, shrinking the heap.
  (end : usize) = n;
  while(end > usize(1), {
    end = (end - usize(1));
    head := (ptr.add(usize(0))).*;
    (ptr.add(usize(0))).* = (ptr.add(end)).*;
    (ptr.add(end)).* = head;
    (root : usize) = usize(0);
    (going : bool) = true;
    while(going, {
      child := ((root * usize(2)) + usize(1));
      cond(
        (child >= end) => {
          going = false;
        },
        true => {
          (largest : usize) = child;
          cond(
            (((child + usize(1)) < end) && less((ptr.add(child)).*, (ptr.add(child + usize(1))).*)) => {
              largest = (child + usize(1));
            },
            true => ()
          );
          cond(
            less((ptr.add(root)).*, (ptr.add(largest)).*) => {
              tmp := (ptr.add(root)).*;
              (ptr.add(root)).* = (ptr.add(largest)).*;
              (ptr.add(largest)).* = tmp;
              root = largest;
            },
            true => {
              going = false;
            }
          );
        }
      );
    });
  });
});
impl(
  generic(T : Type),
  where(T <: Ord(T)),
  ArrayList(T),
  /**
  * Sort elements in ascending order (heapsort — see _heapsort_by).
  */
  sort : (fn(self : Self) -> unit)({
    // Heapsort (was O(n²) insertion sort — plans/STD_API_AUDIT.md §7
    // collections row): O(n log n) worst case, in place, not stable.
    cond(
      (self._length <= usize(1)) => (),
      true =>
        match(
          self._ptr,
          .Some(_ptr) => _heapsort_by(_ptr, self._length, (a, b) => (a < b)),
          .None => ()
        )
    );
  })
);
/// Equality for ArrayList — two lists are equal if they have the same length
/// and every pair of elements at corresponding indices is equal.
impl(
  generic(T : Type),
  where(T <: Eq(T)),
  ArrayList(T),
  Eq(ArrayList(T))(
    (==) : (fn(lhs : Self, rhs : Self) -> bool)({
      n := lhs.len();
      cond(
        (!(n == rhs.len())) => false,
        true => {
          (i : usize) = usize(0);
          (equal : bool) = true;
          while(runtime((i < n) && equal), {
            match(
              lhs.get(i),
              .Some(a) => match(
                rhs.get(i),
                .Some(b) => {
                  equal = (a == b);
                },
                .None => {
                  equal = false;
                }
              ),
              .None => {
                equal = false;
              }
            );
            i = (i + usize(1));
          });
          equal
        }
      )
    })
  )
);
/// Default implementation — the empty list.
impl(
  generic(T : Type),
  ArrayList(T),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
/// Clone implementation for ArrayList — deep-clones each element.
impl(
  generic(T : Type),
  where(T <: Clone),
  ArrayList(T),
  Clone(
    clone : (fn(inout(self) : Self) -> Self)({
      n := self.len();
      result := Self.with_capacity(n);
      i := usize(0);
      while(i < n, {
        item_opt := self.get(i);
        match(
          item_opt,
          .Some(item) => {
            result.push(item.clone());
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      result
    })
  )
);
export(
  ArrayList,
  ArrayListError,
  ArrayListIter
);
// =============================================================================
// array_list! literal macro
// =============================================================================
/// Internal helper: build a list of `tmp.push(elem)` statements from `elems`.
__array_list_build_pushes :: (fn(comptime(tmp) : Expr, comptime(elems) : ExprList) -> comptime(ExprList))(
  cond(
    (elems.len() == usize(0)) => ExprList(),
    true => {
      first :: elems.car();
      rest :: elems.cdr();
      stmt :: quote(unquote(tmp).push(unquote(first)));
      stmt.cons(recur(tmp, rest))
    }
  )
);
/// `array_list` macro — construct an `ArrayList(T)` literal.
///
/// The element type `T` is inferred from the first element via `typeof`, so
/// at least one element is required.
///
/// ## Example
/// ```rust
/// xs := array_list(i32(1), i32(2), i32(3));
/// names := array_list(`alice`, `bob`);
/// ```
///
/// Expands to:
/// ```rust
/// {
///   __first := <first elem>;
///   __tmp := ArrayList(typeof(__first)).new();
///   __tmp.push(__first);
///   __tmp.push(<elem 2>);
///   ...
///   __tmp
/// }
/// ```
array_list :: (fn(...(quote(elems))) -> unquote(Expr))({
  __ :: comptime_assert(
    elems.len() > usize(0),
    "array_list requires at least one element to infer the element type"
  );
  first :: elems.car();
  rest :: elems.cdr();
  tmp :: gensym("array_list");
  first_tmp :: gensym("array_list_first");
  rest_pushes :: __array_list_build_pushes(tmp, rest);
  quote({
    unquote(first_tmp) := unquote(first);
    unquote(tmp) := ArrayList(typeof(unquote(first_tmp))).new();
    unquote(tmp).push(unquote(first_tmp));
    unquote_splicing(rest_pushes);
    unquote(tmp)
  })
});
/// Range slicing on fixed-size arrays returns an OWNED ArrayList copy
/// (`arr(a..b)` lowers to this — plans/archive/SLICE_REWORK.md).
impl(
  generic(T : Type, N : usize),
  Array(T, N),
  slice_copy : (fn(self : Array(T, N), r : Range(usize)) -> ArrayList(T))({
    e := cond((r.end > N) => N, true => r.end);
    out := ArrayList(T).new();
    i := r.start;
    while(i < e, i = (i + usize(1)), {
      out.push(self(i));
    });
    out
  }),
  slice_copy_inclusive : (fn(self : Array(T, N), r : RangeInclusive(usize)) -> ArrayList(T))({
    last := cond((r.end >= N) => N, true => (r.end + usize(1)));
    out := ArrayList(T).new();
    i := r.start;
    while(i < last, i = (i + usize(1)), {
      out.push(self(i));
    });
    out
  })
);
/// Build an `ArrayList(T)` from any iterator of `T` — the target of
/// `it.collect(ArrayList(T))`. The iteration loop lives in the blanket
/// `collect` (std/prelude.yo); these two statics are the seed and the step.
impl(
  generic(T : Type),
  ArrayList(T),
  FromIterator(
    Elem : T,
    from_iter_new : (fn() -> Self)(
      ArrayList(T).new()
    ),
    from_iter_add : (fn(acc : Self, item : T) -> Self)({
      acc.push(item);
      acc
    })
  )
);

// ============================================================================
// Real sort (heapsort), sort_by, binary_search, retain, extend
// (plans/STD_API_AUDIT.md §7 collections row)
// ============================================================================
impl(
  generic(T : Type),
  ArrayList(T),
  /// Sort ascending by a strict "less" closure — `less(a, b)` true when `a`
  /// must come before `b`. Heapsort: O(n log n) worst case, in place, not
  /// stable.
  sort_by : (fn(self : Self, less : Impl(Fn(a : T, b : T) -> bool)) -> unit)({
    cond(
      (self._length <= usize(1)) => (),
      true => match(
        self._ptr,
        .Some(_ptr) => _heapsort_by(_ptr, self._length, less),
        .None => ()
      )
    );
  }),
  /// Keep only the elements `pred` accepts, in place and in order; the
  /// rejected elements are dropped. One pass: the survivors are collected
  /// into a fresh list, `clear` releases every original, `extend` moves the
  /// survivors back — O(n) with a single allocation, and every RC step is one
  /// of the module's proven public operations (push / clear / extend). The
  /// first cut compacted through raw pointers and double-released RC elements
  /// (the Linux-ASan heap-use-after-free on PR #313's first run; local ASan is
  /// non-functional, so CI was the first to see it); the second walked
  /// backwards over `drain`, which was O(n²) with an allocation per rejection
  /// (issues/fixed/array-list-retain-is-quadratic.md).
  retain : (fn(self : Self, pred : Impl(Fn(v : T) -> bool)) -> unit)({
    n := self._length;
    kept := Self.with_capacity(n);
    (i : usize) = usize(0);
    while(i < n, i = (i + usize(1)), {
      v := self(i);
      cond(
        pred(v) => {
          kept.push(v);
        },
        true => ()
      );
    });
    self.clear();
    self.extend(kept);
  }),
  /// Append a copy of every element of `other`.
  extend : (fn(self : Self, other : ArrayList(T)) -> unit)({
    (i : usize) = usize(0);
    n := other.len();
    while(i < n, i = (i + usize(1)), {
      self.push(other(i));
    });
  })
);
impl(
  generic(T : Type),
  where(T <: Ord(T)),
  ArrayList(T),
  /// Binary search over a SORTED list (ascending, `sort`'s order):
  /// `.Ok(index)` of a matching element (any one of an equal run), or
  /// `.Err(insertion_index)` where the value would keep the order.
  binary_search : (fn(self : Self, value : T) -> Result(usize, usize))({
    (lo : usize) = usize(0);
    (hi : usize) = self.len();
    (found : Option(usize)) = Option(usize).None;
    while((lo < hi) && found.is_none(), {
      mid := (lo + ((hi - lo) / usize(2)));
      cur := self(mid);
      cond(
        (cur < value) => {
          lo = (mid + usize(1));
        },
        (value < cur) => {
          hi = mid;
        },
        true => {
          found = Option(usize).Some(mid);
        }
      );
    });
    match(
      found,
      .Some(at) => Result(usize, usize).Ok(at),
      .None => Result(usize, usize).Err(lo)
    )
  })
);
export(array_list);
