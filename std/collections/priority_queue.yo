//! Binary MAX-heap priority queue — Rust's `BinaryHeap` (D11).
//!
//! ## Example
//!
//! ```rust
//! { PriorityQueue } :: import "std/collections/priority_queue";
//!
//! pq := PriorityQueue(i32).new();
//! pq.push(5);
//! pq.push(1);
//! pq.push(3);
//! x := pq.pop().unwrap();  // 5 — the LARGEST
//! ```
//!
//! For a min-heap, wrap the elements in the prelude's `Reverse(T)`, whose
//! `Ord` is the inverted one:
//!
//! ```rust
//! pq := PriorityQueue(Reverse(i32)).new();
//! pq.push(Reverse(i32)(5));
//! pq.push(Reverse(i32)(1));
//! x := pq.pop().unwrap().value;  // 1 — the SMALLEST
//! ```
//!
//! ## Stability
//!
//! unstable — the MAX-heap flip (D11) shipped in v0.2.28 and this is the
//! campaign's one CONTESTABLE flip: `priority_queue` is max-ordered in C++
//! but MIN-ordered in Java, so the name alone does not settle which end
//! `pop` should return, and Rust's `BinaryHeap` is what decided it here. One
//! release of real use is what would freeze it. The rest of the surface
//! (`push`/`pop`/`peek`/`len`/`is_empty`, `Default`, the two iterators) is
//! settled, and Rust's `into_sorted_vec`/`from` would be additive.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("./array_list");
/// MAX-heap backed by an ArrayList (D11 — Rust's `BinaryHeap`).
/// `peek`/`pop` yield the LARGEST element. For a min-heap, use
/// `PriorityQueue(Reverse(T))` rather than negating keys — negation is wrong
/// for unsigned types and for the minimum of a signed type.
PriorityQueue :: (fn(comptime(T) : Type) -> comptime(Type))(
  ref(
    struct(
      _data : ArrayList(T)
    )
  )
);
impl(
  generic(T : Type),
  PriorityQueue(T),
  /// Empty queue. Allocates nothing until the first `push`.
  new : (fn() -> Self)(
    Self(_data : ArrayList(T).new())
  ),
  /// Number of elements. O(1).
  len : (fn(self : Self) -> usize)(
    self._data.len()
  ),
  /// True when the queue holds no elements.
  is_empty : (fn(self : Self) -> bool)(
    self._data.len() == usize(0)
  ),
  /// The LARGEST element without removing it, or `.None` when empty — O(1),
  /// since the heap keeps its maximum at the root. Rust's
  /// `BinaryHeap::peek`.
  peek : (fn(self : Self) -> Option(T))(
    cond(
      (self._data.len() == usize(0)) => .None,
      true => self._data.get(usize(0))
    )
  ),
  /// Insert an element and sift it up to its place — O(log n). Rust's
  /// `BinaryHeap::push`.
  ///
  /// PANICS on allocation failure, since the backing `ArrayList.push` does
  /// (D9); there is no `try_push` here.
  push : (fn(self : Self, val : T, where(T <: Ord(T))) -> unit)({
    // `push`'s Result used to be discarded, so an allocation failure went on
    // to sift an element that was never stored and underflowed `len() - 1`.
    // ArrayList.push panics on that failure itself as of D9, so the guard
    // that used to stand here is now the callee's job.
    self._data.push(val);
    // Sift up
    i := (self._data.len() - usize(1));
    while(i > usize(0), {
      parent := ((i - usize(1)) / usize(2));
      child_val := self._data(i);
      parent_val := self._data(parent);
      cond(
        (child_val > parent_val) => {
          &(self._data(i)).* = parent_val;
          &(self._data(parent)).* = child_val;
          i = parent;
        },
        true => {
          break;
        }
      );
    });
  }),
  /// Remove and return the LARGEST element, or `.None` when empty —
  /// O(log n). Rust's `BinaryHeap::pop`.
  ///
  /// For smallest-first, build the queue over `Reverse(T)` rather than
  /// negating keys: negation is wrong for an unsigned type and for a signed
  /// minimum.
  pop : (fn(self : Self, where(T <: Ord(T))) -> Option(T))({
    n := self._data.len();
    cond(
      (n == usize(0)) => .None,
      true => {
        top := self._data(usize(0));
        last := self._data(n - usize(1));
        &(self._data(usize(0))).* = last;
        self._data.pop();
        // Sift down
        i := usize(0);
        while(runtime(true), {
          left := ((i * usize(2)) + usize(1));
          right := ((i * usize(2)) + usize(2));
          largest := i;
          new_n := self._data.len();
          cond(
            ((left < new_n) && (self._data(left) > self._data(largest))) => {
              largest = left;
            },
            true => ()
          );
          cond(
            ((right < new_n) && (self._data(right) > self._data(largest))) => {
              largest = right;
            },
            true => ()
          );
          cond(
            (largest == i) => {
              break;
            },
            true => {
              a := self._data(i);
              b := self._data(largest);
              &(self._data(i)).* = b;
              &(self._data(largest)).* = a;
              i = largest;
            }
          );
        });
        .Some(top)
      }
    )
  })
);
/// Value iterator over a PriorityQueue — yields elements in the heap's
/// INTERNAL array order, which is NOT sorted order (only the first element is
/// guaranteed to be the maximum). This is what `into_iter()`, and therefore
/// `for(pq, ...)`, returns.
///
/// Rust's `BinaryHeap::iter` makes the same no-order promise; drain the queue
/// with `pop` in a loop when the order matters.
PriorityQueueIter :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _data : ArrayList(T),
    _index : usize
  )
);
impl(
  generic(T : Type),
  PriorityQueueIter(T),
  Iterator(
    Item : T,
    next : (fn(inout(self) : Self) -> Option(T))(
      cond(
        (self._index >= self._data.len()) => .None,
        true => {
          value := self._data(self._index);
          self._index = (self._index + usize(1));
          .Some(value)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  PriorityQueue(T),
  IntoIterator(
    Item : T,
    IntoIter : PriorityQueueIter(T),
    into_iter : (fn(self : Self) -> PriorityQueueIter(T))(
      PriorityQueueIter(T)(_data : self._data, _index : usize(0))
    )
  )
);
/// Pointer iterator over a PriorityQueue — yields `*(T)` into the backing
/// array, in the same unsorted heap order. This is what `iter()` returns
/// (D14), so nothing is dup'd.
///
/// Writing through a yielded pointer can BREAK the heap invariant: nothing
/// re-sifts afterwards. A `push` that grows the array invalidates pointers
/// already yielded.
PriorityQueueIterPtr :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _data : ArrayList(T),
    _index : usize
  )
);
impl(
  generic(T : Type),
  PriorityQueueIterPtr(T),
  Iterator(
    Item : *T,
    next : (fn(inout(self) : Self) -> Option(*T))(
      cond(
        (self._index >= self._data.len()) => .None,
        true =>
          match(
            self._data._ptr,
            .Some(ptr) => {
              element_ptr := ptr.add(self._index);
              self._index = (self._index + usize(1));
              .Some(element_ptr)
            },
            .None => .None
          )
      )
    )
  )
);
impl(
  generic(T : Type),
  PriorityQueue(T),
  /// Borrowing walk over the heap array, in unsorted order (D14) — see
  /// `PriorityQueueIterPtr` for the invariant this can break.
  iter : (fn(inout(self) : Self) -> PriorityQueueIterPtr(T))(
    PriorityQueueIterPtr(T)(_data : self._data, _index : usize(0))
  )
);
/// `Default` — the empty queue.
impl(
  generic(T : Type),
  PriorityQueue(T),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
export(
  PriorityQueue,
  PriorityQueueIter,
  PriorityQueueIterPtr
);
