//! Binary min-heap priority queue.
//!
//! # Example
//!
//! ```rust
//! { PriorityQueue } :: import "std/collections/priority_queue";
//!
//! pq := PriorityQueue(i32).new();
//! pq.push(5);
//! pq.push(1);
//! pq.push(3);
//! x := pq.pop().unwrap();  // 1
//! ```
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("./array_list");
/// Min-heap backed by an ArrayList.
/// Elements are ordered ascending (smallest first). Negate keys for max-heap behavior.
PriorityQueue :: (fn(comptime(T) : Type) -> comptime(Type))(
  ref(
    struct(
      _data : ArrayList(T)
    )
  )
);
impl(
  generic(T : Type),
  PriorityQueue(T),
  // Create an empty priority queue.
  new : (fn() -> Self)(
    Self(_data : ArrayList(T).new())
  ),
  // Number of elements.
  len : (fn(self : Self) -> usize)(
    self._data.len()
  ),
  // True if empty.
  is_empty : (fn(self : Self) -> bool)(
    self._data.len() == usize(0)
  ),
  // Inspect the smallest element without removing it.
  peek : (fn(self : Self) -> Option(T))(
    cond(
      (self._data.len() == usize(0)) =>.None,
      true => self._data.get(usize(0))
    )
  ),
  // Insert a new element.
  push : (fn(self : Self, val : T, where(T <: Ord(T))) -> unit)({
    self._data.push(val);
    // Sift up
    i := (self._data.len() - usize(1));
    while(i > usize(0), {
      parent := ((i - usize(1)) / usize(2));
      child_val := self._data(i);
      parent_val := self._data(parent);
      cond(
        (child_val < parent_val) => {
          &(self._data(i)).* = parent_val;
          &(self._data(parent)).* = child_val;
          i = parent;
        },
        true => {
          break;
        }
      );
    });
  }),
  // Remove and return the smallest element.
  pop : (fn(self : Self, where(T <: Ord(T))) -> Option(T))({
    n := self._data.len();
    cond(
      (n == usize(0)) =>.None,
      true => {
        top := self._data(usize(0));
        last := self._data(n - usize(1));
        &(self._data(usize(0))).* = last;
        self._data.pop();
        // Sift down
        i := usize(0);
        while(runtime(true), {
          left := ((i * usize(2)) + usize(1));
          right := ((i * usize(2)) + usize(2));
          smallest := i;
          new_n := self._data.len();
          cond(
            ((left < new_n) && (self._data(left) < self._data(smallest))) => {
              smallest = left;
            },
            true => ()
          );
          cond(
            ((right < new_n) && (self._data(right) < self._data(smallest))) => {
              smallest = right;
            },
            true => ()
          );
          cond(
            (smallest == i) => {
              break;
            },
            true => {
              a := self._data(i);
              b := self._data(smallest);
              &(self._data(i)).* = b;
              &(self._data(smallest)).* = a;
              i = smallest;
            }
          );
        });
        .Some(top)
      }
    )
  })
);
/**
* Value iterator for PriorityQueue - yields elements in heap (arbitrary) order
* Note: This iterates in internal storage order, NOT sorted order.
*/
PriorityQueueIter :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _data : ArrayList(T),
    _index : usize
  )
);
impl(
  generic(T : Type),
  PriorityQueueIter(T),
  Iterator(
    Item : T,
    next : (fn(inout(self) : Self) -> Option(T))(
      cond(
        (self._index >= self._data.len()) =>.None,
        true => {
          value := self._data(self._index);
          self._index = (self._index + usize(1));
          .Some(value)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  PriorityQueue(T),
  into_iter : (fn(self : Self) -> PriorityQueueIter(T))(
    PriorityQueueIter(T)(_data : self._data, _index : usize(0))
  )
);
/**
* Pointer iterator for PriorityQueue - yields pointers to elements in heap order
*/
PriorityQueueIterPtr :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _data : ArrayList(T),
    _index : usize
  )
);
impl(
  generic(T : Type),
  PriorityQueueIterPtr(T),
  Iterator(
    Item : *(T),
    next : (fn(inout(self) : Self) -> Option(*(T)))(
      cond(
        (self._index >= self._data.len()) =>.None,
        true =>
          match(
            self._data._ptr,
            .Some(ptr) => {
              element_ptr := (ptr &+ self._index);
              self._index = (self._index + usize(1));
              .Some(element_ptr)
            },
            .None =>.None
          )
      )
    )
  )
);
impl(
  generic(T : Type),
  PriorityQueue(T),
  iter : (fn(inout(self) : Self) -> PriorityQueueIterPtr(T))(
    PriorityQueueIterPtr(T)(_data : self._data, _index : usize(0))
  )
);
export(
  PriorityQueue,
  PriorityQueueIter,
  PriorityQueueIterPtr
);
