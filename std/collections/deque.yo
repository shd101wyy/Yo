//! Double-ended queue (ring buffer) with O(1) push/pop at both ends.
//!
//! ## Example
//!
//! ```yo
//! { Deque } :: import("std/collections/deque");
//!
//! d := Deque(i32).new();
//! d.push_back(1);
//! d.push_front(0);
//! x := d.pop_front().unwrap(); // 0
//! ```
//!
//! Elements live in one heap block used as a ring: `_head` is the front slot
//! and the logical index `k` sits at `(_head + k) % capacity`, so both ends
//! are O(1) and nothing shifts. Growth doubles the block (8 slots first) and
//! LINEARISES the contents, which invalidates every pointer into the old
//! buffer. Rust's counterpart is `VecDeque`.
//!
//! ## Stability
//!
//! stable — the surface mirrors `VecDeque`
//! (`push_front`/`push_back`/`pop_front`/`pop_back`/`front`/`back`/`get`,
//! `iter`/`into_iter`, `FromIterator`, `Default`), allocation failure panics
//! like every other collection (D9), and `plans/archive/STD_API_STABILIZATION.md` §4
//! lists nothing open against this module.
//! `tests/collections/deque.test.yo` covers the surface, including the
//! wrap-around cases. Missing pieces such as `Debug` or a `retain` would be
//! additive.
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator, AllocError, size_would_overflow } :: import("../allocator");
{ SIZE_MAX } :: import("../libc/stdint");
{ assert } :: import("../assert");
mem :: import("../mem");
{ malloc, realloc, free } :: GlobalAllocator;
// The top bit of `_capacity`: set when the ring came from an explicit
// `Allocator` and carries its owner prefix (`std/allocator.yo`), so growth and
// release go through it. Kept inside an existing word so the deque object does
// not grow (plans/archive/EXPLICIT_ALLOCATORS.md §3.3); every capacity read masks it.
_CAP_TAG :: (usize(1) << ((size_of(usize) * usize(8)) - usize(1)));
_CAP_MASK :: (_CAP_TAG - usize(1));
/// Circular buffer supporting efficient push/pop at both front and back.
Deque :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _buf : ?*T,
    _head : usize,
    _tail : usize,
    _len : usize,
    _capacity : usize
  )
);
// SAFETY: a value `Deque(T)` is the only owner of its ring buffer (B10,
// plans/VALUES_BY_DEFAULT.md): moving the deque moves every element with it,
// so it is `Send`/`Sync` exactly when `T` is (decision 38 E, as `ArrayList`).
impl(generic(T : Type), where(T <: Send), Deque(T), Send());
impl(generic(T : Type), where(T <: Sync), Deque(T), Sync());
/// Clone implementation for Deque — deep-clones each element into a fresh ring
/// (hand-written: the ring's raw buffer cannot be derived over).
impl(
  generic(T : Type),
  where(T <: Clone),
  Deque(T),
  Clone(
    // A clone lives where its source lives (as ArrayList's Clone).
    clone : (fn(self : &Self) -> Self)({
      out := Deque(T).with_capacity(self._len);
      i := usize(0);
      while(i < self._len, {
        out.push_back(self.get_cloned(i).unwrap());
        i = (i + usize(1));
      });
      out
    })
  )
);
impl(
  generic(T : Type),
  Deque(T),
  /// Empty deque. `alloc : .None`, the default, puts the ring on the global
  /// allocator and allocates nothing: the first push buys an 8-slot ring.
  /// `alloc : .Some(a)` places the ring in `a`, and every growth and the
  /// final release go through `a`. A placed deque takes one allocation right
  /// away, a block holding only the owner prefix, which is how it remembers
  /// its allocator; it PANICS when that allocation fails.
  new : (fn((alloc : Option(Allocator)) ?= .None) -> Self)(
    match(
      alloc,
      .None => Self(_buf : .None, _head : usize(0), _tail : usize(0), _len : usize(0), _capacity : usize(0)),
      .Some(a) => match(
        a.alloc(usize(0), align_of(T)),
        .Some(p) => Self(_buf : .Some((*T)(p)), _head : usize(0), _tail : usize(0), _len : usize(0), _capacity : _CAP_TAG),
        .None => __yo_panic("Deque.new: allocation failed")
      )
    )
  ),
  // The ring's slot count without the allocator tag.
  _cap : (fn(self : &Self) -> usize)(self._capacity & _CAP_MASK),
  // True when the ring came from an explicit `Allocator`.
  _owned : (fn(self : &Self) -> bool)((self._capacity & _CAP_TAG) != usize(0)),
  /// The allocator the ring lives in, or `.None` for the global one.
  allocator : (fn(self : &Self) -> Option(Allocator))(
    cond(
      self._owned() => .Some(Allocator.owner_of((*void)(self._buf.unwrap()))),
      true => .None
    )
  ),
  // Release a ring buffer the way it was allocated: an owned one is told its
  // size (the current capacity's worth of slots) and alignment.
  _free_buf : (fn(self : &Self, p : &*T) -> unit)(
    cond(
      self._owned() => Allocator.free(.Some((*void)(p)), self._cap() * size_of(T), align_of(T)),
      true => free(.Some((*void)(p)))
    )
  ),
  /// Number of elements. O(1); not the ring's capacity.
  len : (fn(self : &Self) -> usize)(
    self._len
  ),
  /// True when the deque holds no elements.
  is_empty : (fn(self : &Self) -> bool)(
    self._len == usize(0)
  ),
  // Ensure at least `min_cap` slots are available.
  _grow : (fn(self : &mut Self, min_cap : usize) -> unit)({
    mut(new_cap) := cond(
      (self._cap() == usize(0)) => usize(8),
      true => (self._cap() * usize(2))
    );
    // Same wrap as ArrayList.with_capacity: `new_cap * sizeof(T)` is computed in
    // usize, and the doubling loop itself can wrap to 0 and spin forever
    // (issues/fixed/collection-capacity-overflow-unchecked.md — the C35 guard
    // every other collection carries; Deque was the one left out).
    while(new_cap < min_cap, {
      new_cap = cond(
        (new_cap > (_CAP_MASK / usize(2))) => min_cap,
        true => (new_cap * usize(2))
      );
    });
    if(size_would_overflow(T, new_cap) || (new_cap > _CAP_MASK), {
      __yo_panic("Deque: capacity overflow");
    });
    size := (new_cap * size_of(T));
    // The new ring comes from the allocator that owns the old one.
    new_raw := cond(
      self._owned() => Allocator.owner_of((*void)(self._buf.unwrap())).alloc(size, align_of(T)),
      true => malloc(size)
    );
    new_buf := match(
      new_raw,
      .Some(p) => (*T)(p),
      .None => __yo_panic("Deque: allocation failed")
    );
    // Linearise existing elements into the new buffer. Each element moves
    // bitwise, so the old buffer is freed below without dropping anything:
    // no count changes, and a move-only `T` moves too.
    mut(i) := usize(0);
    while(i < self._len, i = (i + usize(1)), {
      idx := ((self._head + i) % self._cap());
      buf := self._buf.unwrap();
      __yo_ptr_write(new_buf.add(i), __yo_ptr_read(buf.add(idx)));
    });
    match(
      self._buf,
      .Some(p) => self._free_buf(p),
      .None => ()
    );
    self._buf = .Some(new_buf);
    self._head = usize(0);
    self._tail = self._len;
    self._capacity = (new_cap | (self._capacity & _CAP_TAG));
  }),
  /// Add an element at the back — amortized O(1). Rust's `push_back`.
  ///
  /// A full ring grows (doubling and linearising), which PANICS on allocation
  /// failure or capacity overflow rather than reporting it (D9), and
  /// invalidates every pointer into the buffer.
  push_back : (fn(self : &mut Self, val : T) -> unit)({
    cond(
      (self._len == self._cap()) => self._grow(self._len + usize(1)),
      true => ()
    );
    buf := self._buf.unwrap();
    consume((buf.add(self._tail)).* = val);
    self._tail = ((self._tail + usize(1)) % self._cap());
    self._len = (self._len + usize(1));
  }),
  /// Add an element at the front — amortized O(1) and no shifting, which is
  /// the whole reason to use a deque over an `ArrayList`. Rust's
  /// `push_front`.
  ///
  /// Grows exactly like `push_back` when the ring is full.
  push_front : (fn(self : &mut Self, val : T) -> unit)({
    cond(
      (self._len == self._cap()) => self._grow(self._len + usize(1)),
      true => ()
    );
    self._head = cond(
      (self._head == usize(0)) => (self._cap() - usize(1)),
      true => (self._head - usize(1))
    );
    buf := self._buf.unwrap();
    consume((buf.add(self._head)).* = val);
    self._len = (self._len + usize(1));
  }),
  /// Remove and return the front element, or `.None` when empty — O(1). The
  /// capacity is kept.
  pop_front : (fn(self : &mut Self) -> Option(T))(
    cond(
      (self._len == usize(0)) => .None,
      true => {
        buf := self._buf.unwrap();
        // The element moves out bitwise: the slot leaves the ring, so the
        // deque no longer drops it (a move-only `T` works).
        val := __yo_ptr_read(buf.add(self._head));
        self._head = ((self._head + usize(1)) % self._cap());
        self._len = (self._len - usize(1));
        .Some(val)
      }
    )
  ),
  /// Remove and return the back element, or `.None` when empty — O(1).
  pop_back : (fn(self : &mut Self) -> Option(T))(
    cond(
      (self._len == usize(0)) => .None,
      true => {
        self._tail = cond(
          (self._tail == usize(0)) => (self._cap() - usize(1)),
          true => (self._tail - usize(1))
        );
        buf := self._buf.unwrap();
        val := __yo_ptr_read(buf.add(self._tail));
        self._len = (self._len - usize(1));
        .Some(val)
      }
    )
  ),
  /// First element, or `.None` when empty — Rust's `VecDeque::front`.
  front : (fn(self : &Self) -> Option(T))(
    self.get(usize(0))
  ),
  /// Last element, or `.None` when empty — Rust's `VecDeque::back`.
  back : (fn(self : &Self) -> Option(T))(
    cond(
      (self._len == usize(0)) => Option(T).None,
      true => self.get(self._len - usize(1))
    )
  ),
  /// Copy of the element at LOGICAL index `index` (0 = front), or `.None`
  /// when out of range — O(1) through the ring's modulo, not a walk.
  ///
  /// `self(index)` (the `Index` impl) reads the element in place and asserts
  /// the bound instead; `get_cloned(i)` clones an element that is not copied
  /// implicitly, and `with(i, body)` writes one in place
  /// (plans/VALUES_BY_DEFAULT.md decision 20).
  get : (fn(self : &Self, index : usize) -> Option(T))(
    cond(
      (index >= self._len) => .None,
      true => {
        buf := self._buf.unwrap();
        idx := ((self._head + index) % self._cap());
        .Some((buf.add(idx)).*)
      }
    )
  ),
  /// Run `body` on the element at logical index `index`, borrowed in place,
  /// and return its result — decision 20's non-copying access. Asserts
  /// `index < len()`. The body runs once, so it is an `FnOnce` moved in
  /// (decision 37) and may move its captures into the element.
  ///
  /// ```yo
  /// { Deque } :: import("std/collections/deque");
  /// (mut(d) : Deque(i32)) = Deque(i32).new();
  /// d.push_back(i32(1));
  /// d.with(usize(0), v => {
  ///   v = (v + i32(10));
  /// });
  /// assert(d(usize(0)) == i32(11), "written in place");
  /// ```
  with : (fn(generic(R : Type), self : &mut Self, index : usize, sink(body) : Impl(FnOnce(v : &mut T) -> R)) -> R)(
    body(&mut self(index))
  ),
  /// Move the element at logical index `index` out and leave `T`'s default
  /// in its slot — `std/mem`'s `take(&mut d(i))`. Asserts `index < len()`.
  take : (fn(self : &mut Self, index : usize, where(T <: Default)) -> T)(
    mem.take(&mut self(index))
  ),
  /// Exchange the elements at logical indices `i` and `j` — Rust's
  /// `VecDeque::swap`. The slots move bitwise: no element is copied or
  /// dropped, so a move-only `T` swaps too. Asserts both indices are
  /// `< len()`.
  swap : (fn(self : &mut Self, i : usize, j : usize) -> unit)({
    assert((i < self._len) && (j < self._len), "Deque.swap: index out of bounds");
    cond(
      (i == j) => (),
      true => {
        buf := self._buf.unwrap();
        pi := buf.add((self._head + i) % self._cap());
        pj := buf.add((self._head + j) % self._cap());
        tmp := __yo_ptr_read(pi);
        __yo_ptr_write(pi, __yo_ptr_read(pj));
        __yo_ptr_write(pj, tmp);
      }
    );
  })
);
impl(
  generic(T : Type),
  where(T <: Clone),
  Deque(T),
  /// A clone of the element at logical index `index`, or `.None` when out of
  /// range — `get` for an element that is not copied implicitly (decision
  /// 20). The element is cloned in place, never copied out first.
  get_cloned : (fn(self : &Self, index : usize) -> Option(T))(
    cond(
      (index >= self._len) => .None,
      true => .Some(self(index).clone())
    )
  ),
  /// A clone of the front element, or `.None` when empty.
  front_cloned : (fn(self : &Self) -> Option(T))(
    self.get_cloned(usize(0))
  ),
  /// A clone of the back element, or `.None` when empty.
  back_cloned : (fn(self : &Self) -> Option(T))(
    cond(
      (self._len == usize(0)) => Option(T).None,
      true => self.get_cloned(self._len - usize(1))
    )
  )
);
impl(
  generic(T : Type),
  Deque(T),
  Drop(
    drop : (fn(self : &mut Self) -> unit)({
      match(
        self._buf,
        .Some(p) => {
          cond(
            Type.contains_rc_type(T) => {
              mut(i) := usize(0);
              while(i < self._len, i = (i + usize(1)), {
                idx := ((self._head + i) % self._cap());
                drop_in_place(p.add(idx));
              });
            },
            true => ()
          );
          self._free_buf(p);
          self._buf = .None;
        },
        .None => ()
      );
    })
  )
);
/// Value iterator over a Deque — walks the ring in logical order (front
/// first) and yields each element BY VALUE, dup'ing a refcounted `T`. This is
/// what `into_iter()`, and therefore `for(deque, ...)`, returns; `iter()`
/// yields pointers.
///
/// The element count is captured when the iterator is made, so pushes during
/// the walk are not seen — and a pop is worse than unseen: it moves `_head`,
/// which shifts every remaining position. Double-ended: `next_back` takes
/// from the far end of the same window.
DequeIter :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _deque : Deque(T),
    _pos : usize,
    _remaining : usize
  )
);
impl(
  generic(T : Type),
  DequeIter(T),
  Iterator(
    Item : T,
    next : (fn(self : &mut Self) -> Option(T))(
      cond(
        (self._remaining == usize(0)) => .None,
        true => {
          idx := ((self._deque._head + self._pos) % self._deque._cap());
          buf := self._deque._buf.unwrap();
          value := (buf.add(idx)).*;
          self._pos = (self._pos + usize(1));
          self._remaining = (self._remaining - usize(1));
          .Some(value)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  DequeIter(T),
  DoubleEndedIterator(
    Item : T,
    next_back : (fn(self : &mut Self) -> Option(T))(
      cond(
        (self._remaining == usize(0)) => .None,
        true => {
          // Decrement FIRST so the index lands on the last LIVE element and
          // `_remaining - 1` never underflows. `_pos` + `_remaining` already
          // bracket both ends, so back-iteration needs no new field.
          self._remaining = (self._remaining - usize(1));
          idx := ((self._deque._head + self._pos + self._remaining) % self._deque._cap());
          buf := self._deque._buf.unwrap();
          .Some((buf.add(idx)).*)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  Deque(T),
  IntoIterator(
    Item : T,
    IntoIter : DequeIter(T),
    into_iter : (fn(self : Self) -> DequeIter(T))({
      n := self._len;
      DequeIter(T)(_deque : self, _pos : usize(0), _remaining : n)
    })
  )
);
/// Pointer iterator over a Deque — yields `*(T)` into the ring itself, in
/// logical order. This is what `iter()` returns (D14): nothing is dup'd and
/// writing through the pointer updates the element in place.
///
/// A raw view (decision 39, B7b): it holds the ring's buffer pointer, its
/// capacity and the head and length `iter()` saw, NOT the deque, so it keeps
/// nothing alive and is meant for `pragma(Pragma.AllowUnsafe)` code. A
/// yielded pointer dies with the buffer, so the deque must outlive the walk,
/// and a push, pop or growth during it leaves the walk reading stale slots.
DequeIterPtr :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _buf : ?*T,
    _head : usize,
    _cap : usize,
    _pos : usize,
    _remaining : usize
  )
);
impl(
  generic(T : Type),
  DequeIterPtr(T),
  Iterator(
    Item : *T,
    next : (fn(self : &mut Self) -> Option(*T))(
      cond(
        (self._remaining == usize(0)) => .None,
        true => {
          idx := ((self._head + self._pos) % self._cap);
          buf := self._buf.unwrap();
          element_ptr := buf.add(idx);
          self._pos = (self._pos + usize(1));
          self._remaining = (self._remaining - usize(1));
          .Some(element_ptr)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  Deque(T),
  /// Raw walk from the front: yields a `*(T)` into the ring and leaves the
  /// deque intact (D14). Safe code reads elements with `for(&dq, x => ...)`;
  /// this is the `pragma(Pragma.AllowUnsafe)` form, whose iterator holds the
  /// buffer, not the deque (decision 39, B7b).
  iter : (fn(self : &Self) -> DequeIterPtr(T))(
    DequeIterPtr(T)(_buf : self._buf, _head : self._head, _cap : self._cap(), _pos : usize(0), _remaining : self._len)
  ),
  /// The logical positions `0 .. len()` (front first), a `Range(usize)` that
  /// holds no handle to the deque: decision 39's index cursor
  /// (plans/VALUES_BY_DEFAULT.md). Read each element as `dq(i)`, which
  /// re-derives it from the current ring.
  indices : (fn(self : &Self) -> Range(usize))(
    usize(0) .. self._len
  )
);
/// The borrowed `for`'s cursor (decision 39): a logical `usize` index from
/// the front, re-checked against the live length at each step.
impl(
  generic(T : Type),
  Deque(T),
  BorrowedWalk(
    WalkCursor : usize,
    WalkElem : T,
    walk_start : (fn(self : &Self) -> usize)(usize(0)),
    walk_valid : (fn(self : &Self, cur : &usize) -> bool)(cur < self._len),
    walk_ref : (fn(self : &Self, cur : &usize) -> &T)({
      assert(cur < self._len, "Deque: walk cursor out of bounds");
      buf := self._buf.unwrap();
      buf.add((self._head + cur) % self._cap())
    }),
    walk_next : (fn(self : &Self, cur : &usize) -> usize)(cur + usize(1))
  )
);
impl(
  generic(T : Type),
  Deque(T),
  BorrowedWalkMut(
    walk_elem : (fn(self : &mut Self, cur : &usize) -> &mut T)({
      assert(cur < self._len, "Deque: walk cursor out of bounds");
      buf := self._buf.unwrap();
      buf.add((self._head + cur) % self._cap())
    })
  )
);
impl(
  generic(T : Type),
  Deque(T),
  Index(usize)(
    Output : T,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)({
      assert(idx < self._len, "Deque: index out of bounds");
      buf := self._buf.unwrap();
      physical_idx := ((self._head + idx) % self._cap());
      buf.add(physical_idx)
    })
  )
);
impl(
  generic(T : Type),
  Deque(T),
  IndexMut(usize)(
    Output : T,
    index_mut : (fn(self : &mut Self, idx : usize) -> &mut Self.Output)({
      assert(idx < self._len, "Deque: index out of bounds");
      buf := self._buf.unwrap();
      physical_idx := ((self._head + idx) % self._cap());
      buf.add(physical_idx)
    })
  )
);
impl(
  generic(T : Type),
  Deque(T),
  Trace(
    /// Cycle-GC tracing. The elements live in a malloc'd ring buffer the
    /// compiler's auto-derived field walk cannot reach, so trace each live
    /// element's buffer slot. Logical element `k` (0 = front) sits at
    /// physical slot `(_head + k) % _capacity`. `tracer.visit` takes the slot
    /// POINTER and reads it WITHOUT touching the element's reference count (a
    /// by-value managed handle would be dup'd then dropped, freeing a live
    /// element mid-collection). Mirrors the ArrayList `Trace` impl.
    trace : (fn(self : &Self, tracer : GcTracer) -> unit)({
      match(
        self._buf,
        .Some(base) => {
          (mut(k) : usize) = usize(0);
          while(k < self._len, {
            slot := ((self._head + k) % self._cap());
            tracer.visit(base.add(slot));
            k = (k + usize(1));
          });
        },
        .None => ()
      );
    })
  )
);
/// Build a `Deque(T)` from any iterator of `T` — the target of
/// `it.collect(Deque(T))`. Elements arrive at the BACK, so iteration order is
/// preserved.
impl(
  generic(T : Type),
  Deque(T),
  FromIterator(
    Elem : T,
    from_iter_new : (fn() -> Self)(
      Deque(T).new()
    ),
    from_iter_add : (fn(sink(acc) : Self, item : &T) -> Self)({
      acc.push_back(item);
      acc
    })
  )
);
/// `Default` — the empty deque.
impl(
  generic(T : Type),
  Deque(T),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
export(
  Deque,
  DequeIter,
  DequeIterPtr
);
