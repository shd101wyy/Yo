//! Double-ended queue (ring buffer) with O(1) push/pop at both ends.
//!
//! ## Example
//!
//! ```rust
//! { Deque } :: import "std/collections/deque";
//!
//! d := Deque(i32).new();
//! d.push_back(1);
//! d.push_front(0);
//! x := d.pop_front().unwrap();  // 0
//! ```
pragma(Pragma.AllowUnsafe);
{ GlobalAllocator, AllocError, size_would_overflow } :: import("../allocator");
{ SIZE_MAX } :: import("../libc/stdint");
{ assert } :: import("../assert");
{ malloc, realloc, free } :: GlobalAllocator;
/// Circular buffer supporting efficient push/pop at both front and back.
Deque :: (fn(comptime(T) : Type) -> comptime(Type))(
  ref(
    struct(
      _buf : ?*T,
      _head : usize,
      _tail : usize,
      _len : usize,
      _capacity : usize
    )
  )
);
impl(
  generic(T : Type),
  Deque(T),
  // Create an empty Deque.
  new : (fn() -> Self)(
    Self(_buf : .None, _head : usize(0), _tail : usize(0), _len : usize(0), _capacity : usize(0))
  ),
  // Number of elements currently stored.
  len : (fn(self : Self) -> usize)(
    self._len
  ),
  // True if the deque contains no elements.
  is_empty : (fn(self : Self) -> bool)(
    self._len == usize(0)
  ),
  // Ensure at least `min_cap` slots are available.
  _grow : (fn(self : Self, min_cap : usize) -> unit)({
    new_cap := cond(
      (self._capacity == usize(0)) => usize(8),
      true => (self._capacity * usize(2))
    );
    // Same wrap as ArrayList.with_capacity: `new_cap * sizeof(T)` is computed in
    // usize, and the doubling loop itself can wrap to 0 and spin forever
    // (issues/fixed/collection-capacity-overflow-unchecked.md — the C35 guard
    // every other collection carries; Deque was the one left out).
    while(new_cap < min_cap, {
      new_cap = cond(
        (new_cap > (SIZE_MAX / usize(2))) => min_cap,
        true => (new_cap * usize(2))
      );
    });
    if(size_would_overflow(T, new_cap), {
      __yo_panic("Deque: capacity overflow");
    });
    size := (new_cap * sizeof(T));
    new_buf := *(T)(malloc(size).unwrap());
    // Linearise existing elements into the new buffer
    i := usize(0);
    while(i < self._len, i = (i + usize(1)), {
      idx := ((self._head + i) % self._capacity);
      buf := self._buf.unwrap();
      consume((new_buf.add(i)).* = (buf.add(idx)).*);
    });
    // Drop old elements for RC types before freeing old buffer
    // (the copy above duped each element, so old slots still hold references)
    cond(
      Type.contains_rc_type(T) => {
        j := usize(0);
        while(j < self._len, j = (j + usize(1)), {
          old_idx := ((self._head + j) % self._capacity);
          old_buf := self._buf.unwrap();
          unsafe.drop((old_buf.add(old_idx)).*);
        });
      },
      true => ()
    );
    match(
      self._buf,
      .Some(p) => free(.Some(*(void)(p))),
      .None => ()
    );
    self._buf = .Some(new_buf);
    self._head = usize(0);
    self._tail = self._len;
    self._capacity = new_cap;
  }),
  // Push an element to the back.
  push_back : (fn(self : Self, val : T) -> unit)({
    cond(
      (self._len == self._capacity) => self._grow(self._len + usize(1)),
      true => ()
    );
    buf := self._buf.unwrap();
    consume((buf.add(self._tail)).* = val);
    self._tail = ((self._tail + usize(1)) % self._capacity);
    self._len = (self._len + usize(1));
  }),
  // Push an element to the front.
  push_front : (fn(self : Self, val : T) -> unit)({
    cond(
      (self._len == self._capacity) => self._grow(self._len + usize(1)),
      true => ()
    );
    self._head = cond(
      (self._head == usize(0)) => (self._capacity - usize(1)),
      true => (self._head - usize(1))
    );
    buf := self._buf.unwrap();
    consume((buf.add(self._head)).* = val);
    self._len = (self._len + usize(1));
  }),
  // Remove and return the front element.
  pop_front : (fn(self : Self) -> Option(T))(
    cond(
      (self._len == usize(0)) => .None,
      true => {
        buf := self._buf.unwrap();
        element_ptr := buf.add(self._head);
        val := element_ptr.*;
        unsafe.drop(element_ptr.*);
        self._head = ((self._head + usize(1)) % self._capacity);
        self._len = (self._len - usize(1));
        .Some(val)
      }
    )
  ),
  // Remove and return the back element.
  pop_back : (fn(self : Self) -> Option(T))(
    cond(
      (self._len == usize(0)) => .None,
      true => {
        self._tail = cond(
          (self._tail == usize(0)) => (self._capacity - usize(1)),
          true => (self._tail - usize(1))
        );
        buf := self._buf.unwrap();
        element_ptr := buf.add(self._tail);
        val := element_ptr.*;
        unsafe.drop(element_ptr.*);
        self._len = (self._len - usize(1));
        .Some(val)
      }
    )
  ),
  // Get an element by logical index (0 = front).
  get : (fn(self : Self, index : usize) -> Option(T))(
    cond(
      (index >= self._len) => .None,
      true => {
        buf := self._buf.unwrap();
        idx := ((self._head + index) % self._capacity);
        .Some((buf.add(idx)).*)
      }
    )
  )
);
impl(
  generic(T : Type),
  Deque(T),
  Dispose(
    dispose : (fn(self : Self) -> unit)({
      match(
        self._buf,
        .Some(p) => {
          cond(
            Type.contains_rc_type(T) => {
              i := usize(0);
              while(i < self._len, i = (i + usize(1)), {
                idx := ((self._head + i) % self._capacity);
                unsafe.drop((p.add(idx)).*);
              });
            },
            true => ()
          );
          free(.Some(*(void)(p)));
          self._buf = .None;
        },
        .None => ()
      );
    })
  )
);
/**
* Value iterator for Deque - yields elements by value (T)
* Traverses the circular buffer in logical order.
*/
DequeIter :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _deque : Deque(T),
    _pos : usize,
    _remaining : usize
  )
);
impl(
  generic(T : Type),
  DequeIter(T),
  Iterator(
    Item : T,
    next : (fn(inout(self) : Self) -> Option(T))(
      cond(
        (self._remaining == usize(0)) => .None,
        true => {
          idx := ((self._deque._head + self._pos) % self._deque._capacity);
          buf := self._deque._buf.unwrap();
          value := (buf.add(idx)).*;
          self._pos = (self._pos + usize(1));
          self._remaining = (self._remaining - usize(1));
          .Some(value)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  DequeIter(T),
  DoubleEndedIterator(
    Item : T,
    next_back : (fn(inout(self) : Self) -> Option(T))(
      cond(
        (self._remaining == usize(0)) => .None,
        true => {
          // Decrement FIRST so the index lands on the last LIVE element and
          // `_remaining - 1` never underflows. `_pos` + `_remaining` already
          // bracket both ends, so back-iteration needs no new field.
          self._remaining = (self._remaining - usize(1));
          idx := ((self._deque._head + self._pos + self._remaining) % self._deque._capacity);
          buf := self._deque._buf.unwrap();
          .Some((buf.add(idx)).*)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  Deque(T),
  IntoIterator(
    Item : T,
    IntoIter : DequeIter(T),
    into_iter : (fn(self : Self) -> DequeIter(T))(
      DequeIter(T)(_deque : self, _pos : usize(0), _remaining : self._len)
    )
  )
);
/**
* Pointer iterator for Deque - yields pointers to elements (*(T))
* Yields pointers into the circular buffer. Pointers are valid as long as
* the deque is not modified during iteration.
*/
DequeIterPtr :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _deque : Deque(T),
    _pos : usize,
    _remaining : usize
  )
);
impl(
  generic(T : Type),
  DequeIterPtr(T),
  Iterator(
    Item : *T,
    next : (fn(inout(self) : Self) -> Option(*T))(
      cond(
        (self._remaining == usize(0)) => .None,
        true => {
          idx := ((self._deque._head + self._pos) % self._deque._capacity);
          buf := self._deque._buf.unwrap();
          element_ptr := buf.add(idx);
          self._pos = (self._pos + usize(1));
          self._remaining = (self._remaining - usize(1));
          .Some(element_ptr)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  Deque(T),
  iter : (fn(self : Self) -> DequeIterPtr(T))(
    DequeIterPtr(T)(_deque : self, _pos : usize(0), _remaining : self._len)
  )
);
impl(
  generic(T : Type),
  Deque(T),
  Index(usize)(
    Output : T,
    index : (fn(inout(self) : Self, idx : usize) -> *Self.Output)({
      assert(idx < self._len, "Deque: index out of bounds");
      buf := self._buf.unwrap();
      physical_idx := ((self._head + idx) % self._capacity);
      buf.add(physical_idx)
    })
  )
);
impl(
  generic(T : Type),
  Deque(T),
  Trace(
    /**
    * Cycle-GC tracing. The elements live in a malloc'd ring buffer the compiler's
    * auto-derived field walk cannot reach, so trace each live element's buffer slot.
    * Logical element `k` (0 = front) sits at physical slot `(_head + k) % _capacity`.
    * `tracer.visit` takes the slot POINTER and reads it WITHOUT touching the element's
    * reference count (a by-value managed handle would be dup'd then dropped, freeing a
    * live element mid-collection). Mirrors the ArrayList `Trace` impl.
    */
    trace : (fn(self : Self, tracer : GcTracer) -> unit)({
      match(
        self._buf,
        .Some(base) => {
          (k : usize) = usize(0);
          while(k < self._len, {
            slot := ((self._head + k) % self._capacity);
            tracer.visit(base.add(slot));
            k = (k + usize(1));
          });
        },
        .None => ()
      );
    })
  )
);
/// Build a `Deque(T)` from any iterator of `T` — the target of
/// `it.collect(Deque(T))`. Elements arrive at the BACK, so iteration order is
/// preserved.
impl(
  generic(T : Type),
  Deque(T),
  FromIterator(
    Elem : T,
    from_iter_new : (fn() -> Self)(
      Deque(T).new()
    ),
    from_iter_add : (fn(acc : Self, item : T) -> Self)({
      acc.push_back(item);
      acc
    })
  )
);
export(
  Deque,
  DequeIter,
  DequeIterPtr
);
