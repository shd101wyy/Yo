//! Doubly-linked list with O(1) push/pop at both ends.
//!
//! Every node is a separate reference-counted allocation holding `next` and
//! `prev` handles, so indexing is an O(n) walk and each element costs a
//! pointer pair on top of its value: reach for `ArrayList` unless the point
//! is cheap splicing at the ends, and for `Deque` when both ends are what you
//! want. Positional `insert`/`remove` report a bad index as a `Result` rather
//! than panicking (D1) — deliberately unlike `ArrayList`, where the same
//! mistake panics, because a list that has to walk to the index is already
//! answering a question that can fail.
//!
//! ## Stability
//!
//! stable — names mirror Rust's `LinkedList`
//! (`push_front`/`push_back`/`pop_front`/`pop_back`/`front`/`back`), the
//! `Result` shape of `insert`/`remove` is the settled D1 decision, and
//! `plans/STD_API_STABILIZATION.md` §4 lists nothing open against this
//! module. `tests/collections/linked_list.test.yo` covers the surface.
//! Missing trait impls (`Debug`, `Ord`, `Hash`) would be additive.
pragma(Pragma.AllowUnsafe);
{ assert } :: import("../assert");
/// What a positional `insert` / `remove` can fail with.
LinkedListError :: enum(
  /// Index is out of bounds for the current length.
  IndexOutOfBounds(index : usize, length : usize),
  /// Attempted to access an element from an empty list.
  EmptyList
);
/// Internal node for the linked list. Reference-counted via `object`.
Node :: (fn(comptime(T) : Type) -> comptime(Type))(
  ref(
    struct(
      value : T,
      next : Option(Self),
      prev : Option(Self)
    )
  )
);
/// Doubly-linked list with O(1) push/pop at both ends.
LinkedList :: (fn(comptime(T) : Type) -> comptime(Type))(
  ref(
    struct(
      head : Option(Node(T)),
      tail : Option(Node(T)),
      length : usize
    )
  )
);
impl(
  generic(T : Type),
  LinkedList(T),
  /// Empty list. Allocates nothing — each `push_*` allocates its own node.
  new : (fn() -> Self)(
    Self(
      head : .None,
      tail : .None,
      length : usize(0)
    )
  ),
  /// Number of elements. O(1) — the count is maintained, not walked.
  len : (fn(self : Self) -> usize)(
    self.length
  ),
  /// True when the list holds no elements.
  is_empty : (fn(self : Self) -> bool)(
    self.length == usize(0)
  ),
  /// Add an element at the front — O(1), one node allocation. Rust's
  /// `push_front`. Existing element positions shift by one; no pointer or
  /// iterator into another node is disturbed.
  push_front : (fn(self : Self, value : T) -> unit)({
    new_node := Node(T)(
      value : value,
      next : self.head,
      prev : .None
    );
    match(
      self.head,
      .None => {
        self.tail = .Some(new_node);
      },
      .Some(old_head) => {
        old_head.prev = .Some(new_node);
      }
    );
    self.head = .Some(new_node);
    self.length = (self.length + usize(1));
  }),
  /// Add an element at the back — O(1), one node allocation. Rust's
  /// `push_back`. This is the cheap append; `ArrayList.push` is cheaper
  /// still if you do not need stable node identity.
  push_back : (fn(self : Self, value : T) -> unit)({
    new_node := Node(T)(
      value : value,
      next : .None,
      prev : self.tail
    );
    match(
      self.tail,
      .None => {
        self.head = .Some(new_node);
      },
      .Some(old_tail) => {
        old_tail.next = .Some(new_node);
      }
    );
    self.tail = .Some(new_node);
    self.length = (self.length + usize(1));
  }),
  /// Remove and return the first element, or `.None` when empty — O(1).
  ///
  /// Clears the new head's `prev` handle, which is what breaks the
  /// reference cycle every adjacent node pair forms (see `dispose`).
  pop_front : (fn(self : Self) -> Option(T))(
    match(
      self.head,
      .None => .None,
      .Some(old_head) => {
        value := old_head.value;
        new_head_opt := old_head.next;
        match(
          new_head_opt,
          .None => {
            self.head = .None;
            self.tail = .None;
          },
          .Some(new_head) => {
            new_head.prev = .None;
            self.head = .Some(new_head);
          }
        );
        self.length = (self.length - usize(1));
        .Some(value)
      }
    )
  ),
  /// Remove and return the last element, or `.None` when empty — O(1),
  /// because the list keeps a tail handle.
  pop_back : (fn(self : Self) -> Option(T))(
    match(
      self.tail,
      .None => .None,
      .Some(old_tail) => {
        value := old_tail.value;
        new_tail_opt := old_tail.prev;
        match(
          new_tail_opt,
          .None => {
            self.head = .None;
            self.tail = .None;
          },
          .Some(new_tail) => {
            new_tail.next = .None;
            self.tail = .Some(new_tail);
          }
        );
        self.length = (self.length - usize(1));
        .Some(value)
      }
    )
  ),
  /// Copy of the first element without removing it, or `.None` — Rust's
  /// `front`. The value is dup'd for a refcounted `T`; `iter()` yields
  /// pointers if that matters.
  front : (fn(self : Self) -> Option(T))(
    match(
      self.head,
      .None => .None,
      .Some(head_node) => .Some(head_node.value)
    )
  ),
  /// Copy of the last element without removing it, or `.None` — Rust's
  /// `back`.
  back : (fn(self : Self) -> Option(T))(
    match(
      self.tail,
      .None => .None,
      .Some(tail_node) => .Some(tail_node.value)
    )
  ),
  /// Copy of the element at `index`, or `.None` when out of range.
  ///
  /// O(n): it walks from the head — there is no random access. Rust has no
  /// `LinkedList::get` at all, for exactly this reason; a full traversal
  /// belongs in `iter()`, and a `get` in a loop is quadratic.
  get : (fn(self : Self, index : usize) -> Option(T))(
    cond(
      (index >= self.length) => .None,
      true => {
        current_opt := self.head;
        i := usize(0);
        while(i < index, i = (i + usize(1)), {
          match(
            current_opt,
            .None => {
              return(.None);
            },
            .Some(current) => {
              current_opt = current.next;
              ()
            }
          );
        });
        match(
          current_opt,
          .None => .None,
          .Some(node) => .Some(node.value)
        )
      }
    )
  ),
  /// Insert `value` so that it ends up at `index`, shifting the rest along
  /// — O(n) to walk there, O(1) to splice. `index == len()` appends.
  ///
  /// `.Err(.IndexOutOfBounds)` when `index > len()`. This is the D1 line:
  /// an out-of-range index is a CALLER MISTAKE and stays a `Result` here,
  /// while an allocation failure panics; `ArrayList.insert` panics on the
  /// same mistake, and that difference is deliberate.
  insert : (fn(self : Self, index : usize, value : T) -> Result(unit, LinkedListError))(
    cond(
      (index > self.length) => .Err(.IndexOutOfBounds(index : index, length : self.length)),
      (index == usize(0)) => {
        self.push_front(value);
        .Ok(())
      },
      (index == self.length) => {
        self.push_back(value);
        .Ok(())
      },
      true => {
        current_opt := self.head;
        i := usize(0);
        while(i < index, i = (i + usize(1)), {
          match(
            current_opt,
            .None => {
              return(.Err(.IndexOutOfBounds(index : index, length : self.length)));
            },
            .Some(current) => {
              current_opt = current.next;
            }
          );
        });
        match(
          current_opt,
          .None => .Err(.IndexOutOfBounds(index : index, length : self.length)),
          .Some(current) => {
            prev_opt := current.prev;
            new_node := Node(T)(
              value : value,
              next : .Some(current),
              prev : prev_opt
            );
            current.prev = .Some(new_node);
            match(
              prev_opt,
              .None => {
                self.head = .Some(new_node);
              },
              .Some(prev_node) => {
                prev_node.next = .Some(new_node);
              }
            );
            self.length = (self.length + usize(1));
            .Ok(())
          }
        )
      }
    )
  ),
  /// Remove the element at `index` and return it — O(n) to walk there.
  ///
  /// `.Err(.IndexOutOfBounds)` when `index >= len()`, where
  /// `ArrayList.remove` panics — the same deliberate D1 difference as
  /// `insert`. The first and last indices are routed through
  /// `pop_front`/`pop_back`.
  remove : (fn(self : Self, index : usize) -> Result(T, LinkedListError))(
    cond(
      (index >= self.length) => .Err(.IndexOutOfBounds(index : index, length : self.length)),
      (index == usize(0)) =>
        match(
          self.pop_front(),
          .Some(value) => .Ok(value),
          .None => .Err(.EmptyList)
        ),
      (index == (self.length - usize(1))) =>
        match(
          self.pop_back(),
          .Some(value) => .Ok(value),
          .None => .Err(.EmptyList)
        ),
      true => {
        current_opt := self.head;
        i := usize(0);
        while(i < index, i = (i + usize(1)), {
          match(
            current_opt,
            .None => {
              return(.Err(.IndexOutOfBounds(index : index, length : self.length)));
            },
            .Some(current) => {
              current_opt = current.next;
            }
          );
        });
        match(
          current_opt,
          .None => .Err(.IndexOutOfBounds(index : index, length : self.length)),
          .Some(node_to_remove) => {
            value := node_to_remove.value;
            prev_opt := node_to_remove.prev;
            next_opt := node_to_remove.next;
            match(
              prev_opt,
              .Some(prev_node) => {
                prev_node.next = next_opt;
              },
              .None => {
                self.head = next_opt;
              }
            );
            match(
              next_opt,
              .Some(next_node) => {
                next_node.prev = prev_opt;
              },
              .None => {
                self.tail = prev_opt;
              }
            );
            self.length = (self.length - usize(1));
            .Ok(value)
          }
        )
      }
    )
  ),
  /// Drop every element — O(n).
  ///
  /// Pops from the front rather than releasing the head handle, because each
  /// adjacent node pair is a reference CYCLE (`a.next == b`, `b.prev == a`):
  /// dropping the head alone would leave the whole chain with a nonzero
  /// refcount. `pop_front` clears each new head's `prev`, which unlinks the
  /// chain as it goes.
  clear : (fn(self : Self) -> unit)({
    while(self.length > usize(0), {
      self.pop_front();
    });
  }),
  /// Whether any element equals `value` — a walk from the head, O(n),
  /// stopping at the first match.
  contains : (
    fn(
      self : Self,
      value : T,
      where(T <: Eq(T))
    ) -> bool
  )({
    current_opt := self.head;
    i := usize(0);
    while(i < self.length, i = (i + usize(1)), {
      match(
        current_opt,
        .None => {
          return(false);
        },
        .Some(current) => {
          cond(
            (current.value == value) => {
              return(true);
            },
            true => {
              current_opt = current.next;
            }
          );
        }
      );
    });
    false
  }),
  /// Reverse the list in place — O(n).
  ///
  /// Swaps each node's `next` and `prev` handles and then exchanges head and
  /// tail, so no element is moved or copied and node identity is preserved.
  reverse : (fn(self : Self) -> unit)({
    current_opt := self.head;
    i := usize(0);
    while(i < self.length, i = (i + usize(1)), {
      match(
        current_opt,
        .None => {
          return;
        },
        .Some(current) => {
          temp := current.next;
          current.next = current.prev;
          current.prev = temp;
          current_opt = temp;
        }
      );
    });
    temp_head := self.head;
    self.head = self.tail;
    self.tail = temp_head;
  })
);
impl(
  generic(T : Type),
  LinkedList(T),
  Dispose(
    /// Unlinks and drops every node when the last reference to the list goes
    /// away. Delegates to `clear` because the `prev` handles make the chain
    /// cyclic — see `clear`.
    dispose : (fn(self : Self) -> unit)(
      self.clear()
    )
  )
);
/// Value iterator over a LinkedList — follows `next` from the head and
/// yields each element BY VALUE (dup'd for a refcounted `T`). This is what
/// `into_iter()`, and therefore `for(list, ...)`, returns.
///
/// It holds only the current NODE, so the walk survives elements being
/// removed behind it, but removing the node it is parked on cuts the walk
/// short.
LinkedListIter :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _current : Option(Node(T))
  )
);
impl(
  generic(T : Type),
  LinkedListIter(T),
  Iterator(
    Item : T,
    next : (fn(inout(self) : Self) -> Option(T))(
      match(
        self._current,
        .None => .None,
        .Some(node) => {
          self._current = node.next;
          .Some(node.value)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  LinkedList(T),
  IntoIterator(
    Item : T,
    IntoIter : LinkedListIter(T),
    into_iter : (fn(self : Self) -> LinkedListIter(T))(
      LinkedListIter(T)(_current : self.head)
    )
  )
);
/// Pointer iterator over a LinkedList — yields `&(node.value)` for each
/// node, so nothing is dup'd and writing through the pointer updates the
/// element in place. This is what `iter()` returns (D14).
///
/// A yielded pointer is valid only while its node is alive: removing that
/// element during the walk leaves it dangling.
LinkedListIterPtr :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _current : Option(Node(T))
  )
);
impl(
  generic(T : Type),
  LinkedListIterPtr(T),
  Iterator(
    Item : *T,
    next : (fn(inout(self) : Self) -> Option(*T))(
      match(
        self._current,
        .None => .None,
        .Some(node) => {
          self._current = node.next;
          .Some(&node.value)
        }
      )
    )
  )
);
impl(
  generic(T : Type),
  LinkedList(T),
  /// Borrowing walk from the head: yields a `*(T)` into each node, leaving
  /// the list intact — `for(list.iter(), p => ...)`, where `into_iter`
  /// moves the list and yields values (D14).
  iter : (fn(self : Self) -> LinkedListIterPtr(T))(
    LinkedListIterPtr(T)(_current : self.head)
  )
);
/// Index trait — `list(idx)` returns the element at `idx`. O(n) walk.
/// `&(node.value)` is a valid heap pointer while `self` keeps the
/// Rc chain alive — the dispatcher inlines and dereferences this
/// before any drop runs. Same pattern as `LinkedListIterPtr.next`.
impl(
  generic(T : Type),
  LinkedList(T),
  Index(usize)(
    Output : T,
    index : (fn(inout(self) : Self, idx : usize) -> *Self.Output)({
      assert(idx < self.length, "LinkedList: index out of bounds");
      (current : Option(Node(T))) = self.head;
      i := usize(0);
      while(runtime(true), {
        match(
          current,
          .Some(node) => {
            if(i == idx, {
              // SAFETY: `node` is held in an Rc-managed chain rooted
              // at `self.head`; while `self` is borrowed (inout(self))
              // every node we've walked stays alive, so `&node.value`
              // is a valid borrow into Rc storage.
              return(unsafe(&node.value));
            });
            current = node.next;
            i = (i + usize(1));
          },
          .None => __yo_panic("LinkedList: unreachable past length check")
        );
      });
      __yo_panic("LinkedList: index loop exited without return")
    })
  )
);
/// `Default` — the empty list.
impl(
  generic(T : Type),
  LinkedList(T),
  Default(
    default : (fn() -> Self)(
      Self.new()
    )
  )
);
export(
  LinkedList,
  LinkedListError,
  LinkedListIter,
  LinkedListIterPtr
);
