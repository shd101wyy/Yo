//! Async task utilities — cooperative `yield`, `JoinHandle.join` and the
//! `JoinHandle` combinators (`plans/archive/STD_API_AUDIT.md` §7 P0 item 6,
//! reshaped as futures by `plans/ASYNC_IO_API_AUDIT.md` A1).
//!
//! Every combinator (`join_all`, `race`, `race_first`, `any`, `any_first`,
//! `timeout`, `select`) is a FUTURE: it suspends the awaiting task until its
//! operands are done, so it works the same in `main` and inside an `io.async`
//! body. The list combinators take spawned handles — spawn at the call site.
//! A `JoinHandle` is move-only (plans/VALUES_BY_DEFAULT.md §3.13 A3), so each
//! takes its handles by value: `join`, `join_all`, `race_first` and
//! `any_first` consume them, and `race`/`any` hand the list back with the
//! index, so the losers can still be aborted or joined:
//!
//! ```yo
//! { join_all, race } :: import("std/async");
//!
//! handles := ArrayList(JoinHandle(String)).new();
//! handles.push(io.spawn(fetch_a(io), io));
//! handles.push(io.spawn(fetch_b(io), io));
//! results := io.await(join_all(handles, io), io); // ArrayList(Option(String))
//! h := io.spawn(fetch_a(io), io);
//! one := io.await(h.join(io), io); // Option(String), from a task too
//! ```
//!
//! `timeout` and the two-way `select` take FUTURES (§3.13 A4), so they can
//! wrap a future that borrows (`timeout(rx.recv(io), d, io)`,
//! `select(s.next(io), t.next(io), io)`). Each runs its operands as scoped
//! child tasks and aborts and joins them before it resolves, so no borrow
//! outlives the call; a borrowing operand makes the combinator's own future a
//! borrowing one, awaited where it is made.
//!
//! For the async-safe `Channel` and `Mutex` (usable INSIDE tasks without
//! parking the event loop the way `std/sync`'s blocking primitives do), see
//! `std/async/channel` and `std/async/mutex`.
//!
//! ## Stability
//!
//! unstable — the names (`yield`, `join`, `join_all`, `race`, `race_first`,
//! `any`, `any_first`, `timeout`, `TimeoutError`) and the future-returning
//! shape are settled as of 2026-10-03; the list combinators' `JoinHandle`
//! argument type is a decision (`plans/ASYNC_IO_API_AUDIT.md` Q3), which
//! decision 14 of `plans/VALUES_BY_DEFAULT.md` reverses for `timeout` and
//! `select` (they take futures, 2026-10-16). What may still
//! change is the wait primitive under them (`__yo_join_wait_*`): today it
//! wakes on ANY added task, which `any` works around by re-waiting over the
//! handles still running.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("../collections/array_list");
{ assert, panic } :: import("../assert");
{ Duration } :: import("../time/duration");
{ Error } :: import("../error");
{ ToString } :: import("../fmt");
import("../string");
IO_timer :: import("../sys/timer");
{ __yo_async_yield_start, __yo_join_wait_new, __yo_join_wait_add } :: import("../sys/externs.yo");
{ IoFuture } :: import("../sys/future.yo");
/// Suspend the current async task until the next event-loop turn: drain the
/// ready queue, then poll (and, when idle with pending I/O, block in) I/O.
///
/// There is NO TIMER under this. The future is created pending and completed
/// at the top of the next ready-task drain, after that drain has measured its
/// budget, so the resumed continuation lands beyond the budget and runs in the
/// following step — with exactly one `__yo_io_poll()` in between. That is the
/// same mechanism `std/async/waker`'s `yield_now` documents, and the two are
/// now the same thing.
///
/// It was a 1 ms timer until v0.2.32, for a bootstrap reason and not a design
/// one: `yield` is on the compiler's OWN import path (through
/// `std/fs/watch`), and a seed compiler emits the async runtime it was built
/// with — so pointing this at `__yo_async_yield_start` could not link until a
/// published seed carried that symbol. v0.2.31 is the first that does.
///
/// Two earlier shapes are ruled out and neither should come back. A body of
/// `return(())` completes the future SYNCHRONOUSLY, so `io.await(yield(io), io)`
/// never reaches `__yo_async_poll_step` at all: a poll-until-finished loop
/// built on it (`is_finished()` + `await yield()`) spins without ever polling
/// I/O and the polled task never progresses (the build smoke hang's spin
/// component, issues/fixed/build-smoke-hangs-registry-perturbation.md). An
/// ALREADY-COMPLETE future is the same failure by a different route — the
/// await point takes an inline fast path for one of those and the task never
/// leaves the C stack.
yield :: (fn(io : Io) -> Impl(Future(unit)))(
  io.async((io : Io) => {
    _r := io.await(unsafe(__yo_async_yield_start()), io);
    ()
  })
);
impl(
  generic(T : Type),
  JoinHandle(T),
  /// Wait for the task from INSIDE a task: a future that resolves to the
  /// task's result (`.None` if it was aborted) and suspends the awaiting task
  /// until then — `io.await(h.join(io), io)`. `h.await(io)` returns the same
  /// `Option(T)` but is a blocking poll of the event loop, which is right in
  /// `main` or any plain `fn` and nests the loop inside an `io.async` body
  /// (`YO_ASYNC_STRICT=1` panics there); `join` is the form for a task. In
  /// `main`, `io.await(h.join(io), io)` and `h.await(io)` are equivalent.
  ///
  /// Joining CONSUMES the handle (plans/VALUES_BY_DEFAULT.md §3.13 A3): the
  /// future owns it, and the result moves out of the task. A result several
  /// tasks need is joined once and shared (`Rc(T)`, a channel). Aborting the
  /// JOINING task cancels the wait and drops the handle, which detaches the
  /// joined task: it keeps running (abort it first if its work is unwanted).
  join : (fn(self : Self, io : Io) -> Impl(Future(Option(T), Io)))(
    io.async({ self }(io : Io) => {
      w := unsafe(__yo_join_wait_new());
      unsafe(__yo_join_wait_add(&w, self.as_ptr()));
      _w := io.await(w, io);
      // Terminal now: this read returns without driving the loop.
      self.await(io)
    })
  )
);
/// The tasks of `handles`, as the raw pointers the join wait takes. The list
/// keeps owning the handles; a pointer is valid while its handle is alive.
_task_ptrs :: (fn(generic(T : Type), handles : &ArrayList(JoinHandle(T))) -> ArrayList(*void))({
  out := ArrayList(*void).with_capacity(handles.len());
  (i : usize) = usize(0);
  while(i < handles.len(), i = (i + usize(1)), {
    out.push(handles(i).as_ptr());
  });
  out
});
/// A wait that resolves when ANY of `tasks` is terminal. Tasks that are
/// terminal already resolve it at once.
_wait_any :: (fn(tasks : &ArrayList(*void)) -> IoFuture)({
  w := unsafe(__yo_join_wait_new());
  (i : usize) = usize(0);
  while(i < tasks.len(), i = (i + usize(1)), {
    unsafe(__yo_join_wait_add(&w, tasks(i)));
  });
  w
});
/// Await every handle, in order, resolving to each task's result (`.None` for
/// a task that was aborted). All tasks run concurrently on the loop — the wait
/// costs the SLOWEST task's wall time, not the sum. It drains the list: each
/// handle is consumed by its join.
///
/// ```yo
/// results := io.await(join_all(handles, io), io); // ArrayList(Option(T))
/// ```
join_all :: (
  fn(generic(T : Type), handles : ArrayList(JoinHandle(T)), io : Io) -> Impl(Future(ArrayList(Option(T)), Io))
)(
  io.async({ handles }(io : Io) => {
    hs := handles;
    out := ArrayList(Option(T)).with_capacity(hs.len());
    // `pop` drains from the back, so reverse once to join in list order.
    hs.reverse();
    while(hs.len() > usize(0), {
      match(
        hs.pop(),
        .Some(h) => {
          r := io.await(h.join(io), io);
          out.push(r);
        },
        .None => ()
      );
    });
    out
  })
);
/// Resolve once at least one handle is terminal (completed OR aborted), to
/// its index, and hand the list back: `(index, handles)`. The losers keep
/// running: a `JoinHandle` dropped without an await DETACHES its task, so
/// `abort()` the losers if their work is unwanted (`race_first` does that for
/// you). Panics on an empty list.
///
/// ```yo
/// (w, hs) := io.await(race(handles, io), io);
/// ```
race :: (
  fn(generic(T : Type), handles : ArrayList(JoinHandle(T)), io : Io) -> Impl(Future(Tuple(usize, ArrayList(JoinHandle(T))), Io))
)({
  assert(handles.len() > usize(0), "race: empty handle list");
  io.async({ handles }(io : Io) => {
    hs := handles;
    tasks := _task_ptrs(&hs);
    _w := io.await(_wait_any(&tasks), io);
    (winner : Option(usize)) = Option(usize).None;
    (i : usize) = usize(0);
    while((i < hs.len()) && winner.is_none(), i = (i + usize(1)), {
      if(hs(i).is_finished(), {
        winner = Option(usize).Some(i);
      });
    });
    (winner.unwrap(), hs)
  })
});
/// Resolve once some handle COMPLETES (not merely aborts), to its index, or
/// to `.None` once every handle is terminal without a completion, and hand
/// the list back: `(index, handles)`. Like `race`, the losers keep running
/// unless aborted (`any_first` aborts them). Panics on an empty list.
any :: (
  fn(generic(T : Type), handles : ArrayList(JoinHandle(T)), io : Io) -> Impl(Future(Tuple(Option(usize), ArrayList(JoinHandle(T))), Io))
)({
  assert(handles.len() > usize(0), "any: empty handle list");
  io.async({ handles }(io : Io) => {
    hs := handles;
    (result : Option(usize)) = Option(usize).None;
    (decided : bool) = false;
    while(decided == false, {
      // Every task still running; the wait below resolves when one of
      // THESE ends, so an already-terminal (aborted) task cannot keep
      // resolving it at once.
      pending := ArrayList(*void).new();
      (i : usize) = usize(0);
      while((i < hs.len()) && (decided == false), i = (i + usize(1)), {
        s := hs(i).state();
        cond(
          (s == FutureState.Completed) => {
            result = Option(usize).Some(i);
            decided = true;
          },
          (s == FutureState.Aborted) => (),
          true => pending.push(hs(i).as_ptr())
        );
      });
      cond(
        decided => (),
        (pending.len() == usize(0)) => {
          decided = true;
        },
        true => {
          _w := io.await(_wait_any(&pending), io);
        }
      );
    });
    (result, hs)
  })
});
/// Drain `handles` after a race: the winner at index `w` is joined (when
/// there is one), every loser is aborted AND joined, and the winner's result
/// comes back. The join lets a loser suspended in a cancellable operation be
/// released here rather than when that operation would have completed.
_settle :: (
  fn(generic(T : Type), handles : ArrayList(JoinHandle(T)), winner : Option(usize), io : Io) -> Impl(Future(Option(T), Io))
)(
  io.async({ handles, winner }(io : Io) => {
    hs := handles;
    (out : Option(T)) = Option(T).None;
    // `pop` drains from the back: the popped handle's index is the length
    // after the pop.
    while(hs.len() > usize(0), {
      match(
        hs.pop(),
        .Some(h) => cond(
          match(winner, .Some(w) => (hs.len() == w), .None => false) => {
            out = io.await(h.join(io), io);
          },
          true => {
            h.abort();
            _lr := io.await(h.join(io), io);
          }
        ),
        .None => ()
      );
    });
    out
  })
);
/// Resolve to the FIRST handle's result and abort the rest — `race` with the
/// cleanup done for you (`.None` if the winner was aborted rather than
/// completed). It drains the list. Panics on an empty list.
///
/// This exists because `race`/`any` hand back an index and leave the losers
/// running: dropping a `JoinHandle` DETACHES its task (Tokio's semantics,
/// which is what makes a fire-and-forget `io.spawn` statement correct), so a
/// caller who wants the losers' work stopped has to `abort()` each one. The
/// handle's `Drop` releases its reference to the task; abort-on-drop is
/// deliberately not its semantics.
///
/// Every loser is aborted AND joined: the join lets a loser suspended in a
/// cancellable operation be released here rather than when that operation
/// would have completed.
race_first :: (fn(generic(T : Type), handles : ArrayList(JoinHandle(T)), io : Io) -> Impl(Future(Option(T), Io)))({
  assert(handles.len() > usize(0), "race_first: empty handle list");
  io.async({ handles }(io : Io) => {
    (w, hs) := io.await(race(handles, io), io);
    io.await(_settle(hs, Option(usize).Some(w), io), io)
  })
});
/// Resolve to the first handle to COMPLETE and abort the rest — `any` with
/// the cleanup done for you. `.None` when every handle ended without
/// completing. It drains the list. Panics on an empty list. See `race_first`
/// for why this exists.
any_first :: (fn(generic(T : Type), handles : ArrayList(JoinHandle(T)), io : Io) -> Impl(Future(Option(T), Io)))({
  assert(handles.len() > usize(0), "any_first: empty handle list");
  io.async({ handles }(io : Io) => {
    (decided, hs) := io.await(any(handles, io), io);
    io.await(_settle(hs, decided, io), io)
  })
});
/// A combinator's operand, running as a SCOPED child task (plans/VALUES_BY_DEFAULT.md
/// §3.13 A4). `timeout` and `select` take futures, and a future may borrow
/// (§3.13 A2), so the task that runs one must never outlive the combinator's
/// own future, which the caller awaits inside the borrow:
/// - the combinator aborts and joins it on every path before it resolves;
/// - if the combinator's future is aborted or dropped first, dropping this
///   aborts the task.
/// An aborted task never resumes, so whatever it borrows is no longer touched
/// once the abort returns. `_p` is the task's pointer, valid while `_h` holds
/// the handle (`_scoped_join` takes it out).
_Scoped :: (fn(comptime(U) : Type) -> comptime(Type))(
  struct(_h : Option(JoinHandle(U)), _p : *void)
);
impl(
  generic(U : Type),
  _Scoped(U),
  Drop(
    drop : (fn(self : &mut Self) -> unit)(
      if(self._h.is_some(), {
        __yo_join_handle_abort_raw(self._p);
      })
    )
  )
);
/// Take ownership of a spawned operand as a scoped child.
_scope :: (fn(generic(U : Type), h : JoinHandle(U)) -> _Scoped(U))({
  p := h.as_ptr();
  _Scoped(U)(_h : Option(JoinHandle(U)).Some(h), _p : p)
});
/// The scoped task's state (`Aborted` once it was joined).
_scoped_state :: (fn(generic(U : Type), s : &_Scoped(U)) -> FutureState)(
  if(s._h.is_some(), __yo_join_handle_state_raw(s._p), FutureState.Aborted)
);
/// Abort the scoped task (a terminal one is left alone).
_scoped_abort :: (fn(generic(U : Type), s : &_Scoped(U)) -> unit)(
  if(s._h.is_some(), {
    __yo_join_handle_abort_raw(s._p);
  })
);
/// Add the scoped task to the join wait `w`.
_scoped_wait_on :: (fn(generic(U : Type), s : &_Scoped(U), w : &IoFuture) -> unit)(
  if(s._h.is_some(), {
    unsafe(__yo_join_wait_add(w, s._p));
  })
);
/// Join the scoped task: its result, or `.None` if it was aborted. Called
/// once, after which the task is no longer scoped (the join owns it).
_scoped_join :: (fn(generic(U : Type), s : &mut _Scoped(U), io : Io) -> Impl(Future(Option(U), Io)))(
  match(
    s._h.take(),
    .Some(t) => {
      (th : JoinHandle(U)) = t;
      th.join(io)
    },
    .None => panic("std/async: a scoped task was joined twice")
  )
);
/// Why `timeout(...)` produced no value (D18).
///
/// The old `Option(T)` return collapsed these two outcomes into each other —
/// and, when `T` was itself an `Option`, into a task that legitimately
/// returned `.None`. A caller that wants to retry on a slow task but give up
/// on a cancelled one could not tell them apart.
TimeoutError :: enum(
  /// The deadline fired first; `timeout` aborted the operand.
  Elapsed,
  /// The operand was aborted (an effect handler unwound it) while the
  /// deadline was still unexpired, so it never produced a value.
  Aborted
);
derive(TimeoutError, Copy, Clone);
derive(
  TimeoutError,
  Error(
    .Elapsed => `timeout: the deadline elapsed before the task finished`,
    .Aborted => `timeout: the task was aborted before it produced a value`
  )
);
/// Run `fut` with a deadline: `.Ok(v)` if it finishes within `limit`,
/// `.Err(TimeoutError.Elapsed)` if the deadline fires first (the operand is
/// aborted), `.Err(TimeoutError.Aborted)` if the operand was aborted on its
/// own (an effect handler unwound it). Millisecond granularity (the timer
/// contract of `std/time/sleep`). Tokio's `time::timeout(d, fut)`.
///
/// ```yo
/// r := io.await(timeout(rx.recv(io), Duration.from_millis(i64(200)), io), io);
/// ```
///
/// The operand is a FUTURE, so it may borrow (plans/VALUES_BY_DEFAULT.md
/// §3.13 A4): `timeout(s.next(io), d, io)` over a `&mut` stream works, and
/// the future `timeout` returns is then a borrowing future too, awaited where
/// it is made. The operand runs as a scoped child task with the bundle the
/// caller's `io.await` passes (`timeout`'s future has the operand's effect
/// type `E`), and is aborted and joined before `timeout` resolves, so no
/// borrow outlives the call. A task that is already spawned is timed out
/// through its join future, `timeout(h.join(io), d, io)`, which resolves to
/// `.Ok(Option(T))`; on the deadline it drops the handle, which DETACHES the
/// task (Tokio's semantics): abort the task through the handle first if its
/// work is unwanted.
///
/// An operand that finishes before the deadline leaves nothing behind:
/// aborting the deadline task deregisters the armed timer in the I/O backend
/// and releases the deadline task there and then. Until that cancel path
/// existed the timer kept counting and held ~256 bytes per call for the whole
/// remaining deadline (`issues/fixed/timeout-deadline-timer-future-leak.md`).
timeout :: (
  fn(generic(T : Type, E : Type.Struct), fut : Impl(Future(T, E)), limit : Duration, io : Io) -> Impl(Future(Result(T, TimeoutError), E))
)({
  ms := Rc(u64)(u64(limit.as_millis()));
  io.async({ fut, ms, io }(e : E) => {
    // A borrowing operand is spawned under `unsafe`: `_Scoped` guarantees the
    // task ends before this future does (see its documentation). The handle
    // is annotated, so its type comes from `T`, not from the spawn.
    (h : JoinHandle(T)) = unsafe(io.spawn(fut, e));
    child := _scope(h);
    // The deadline is a spawned TASK, not a bare io-timer future: a raw
    // `IoFuture` local would be auto-dropped at scope end while the backend
    // still holds the armed timer (issues/fixed/pending-io-future-local-drop-uaf.md);
    // inside a task the await machinery owns it correctly on every path.
    deadline_fut := io.async((io : Io) => {
      io.await(IO_timer.sleep(ms.*), io);
      return(());
    });
    deadline := _scope(io.spawn(deadline_fut, io));
    // One wait over the operand and the deadline: resolves when either ends.
    w := unsafe(__yo_join_wait_new());
    _scoped_wait_on(&child, &w);
    _scoped_wait_on(&deadline, &w);
    _w := io.await(w, io);
    // Which arm ended the wait — the ONLY place the two failure modes are
    // distinguishable. Afterwards the join reports `.None` for a deadline
    // abort and a self-abort alike.
    s := _scoped_state(&child);
    elapsed := ((s != FutureState.Completed) && (s != FutureState.Aborted));
    if(elapsed, {
      _scoped_abort(&child);
    });
    // Abort and join the deadline task. When the operand finished first, the
    // abort cancels the still-armed timer and releases the deadline task
    // immediately (runtime_core.yo `__yo_async_io_cancel`), so the join that
    // follows resolves without waiting for `limit`.
    _scoped_abort(&deadline);
    _deadline_r := io.await(_scoped_join(&mut deadline, io), io);
    _timeout_result(io.await(_scoped_join(&mut child, io), io), elapsed)
  })
});
/// `timeout`'s result from the joined operand. A function of its own: the
/// result type comes from the joined value, so the `io.async` body never
/// builds a type from `T` (and the seed compiles `std/http`'s `timeout` call
/// into the compiler: a generic `io.async` body ending in a bare-variant
/// `match` gave the result a second C type there,
/// issues/fixed/a-generic-io-async-body-ending-in-a-bare-variant-match-gets-a-second-c-result-type.md).
_timeout_result :: (fn(generic(T : Type), r : Option(T), elapsed : bool) -> Result(T, TimeoutError))({
  (out : Result(T, TimeoutError)) = match(
    r,
    .Some(v) => .Ok(v),
    .None => cond(
      elapsed => .Err(TimeoutError.Elapsed),
      true => .Err(TimeoutError.Aborted)
    )
  );
  out
});
/// Which operand of `select` finished first, with its result.
Selected :: (fn(comptime(A) : Type, comptime(B) : Type) -> comptime(Type))(
  enum(
    /// The first operand completed first.
    First(value : A),
    /// The second operand completed first.
    Second(value : B)
  )
);
/// Run two futures and resolve to the first one to COMPLETE, aborting and
/// joining the other: `.Some(.First(a))` or `.Some(.Second(b))`, or `.None`
/// when both were aborted (an effect handler unwound each) without a
/// completion. An operand that aborts does not win; the other keeps running.
/// When both have completed by the time the wait resumes, the first wins (a
/// biased select, like Tokio's `select!` with `biased;`).
///
/// ```yo
/// match(
///   io.await(select(rx.recv(io), sleep(u64(50)), io), io),
///   .Some(.First(msg)) => handle(msg),
///   .Some(.Second(_)) => println("idle"),
///   .None => ()
/// );
/// ```
///
/// The operands are FUTURES, so they may borrow (plans/VALUES_BY_DEFAULT.md
/// §3.13 A4), as `timeout`'s does: each runs as a scoped child task with the
/// bundle the caller's `io.await` passes, the loser is aborted and joined
/// before `select` resolves, and the future `select` returns borrows what the
/// operands borrow. The two may not lend overlapping places when either side
/// is `&mut` (decision 38 B): `select(s.next(io), s.next(io), io)` is E0910.
select :: (
  fn(generic(A : Type, B : Type, E : Type.Struct), first : Impl(Future(A, E)), second : Impl(Future(B, E)), io : Io) -> Impl(Future(Option(Selected(A, B)), E))
)(
  io.async({ first, second, io }(e : E) => {
    // Spawned under `unsafe` as in `timeout`: `_Scoped` keeps either task
    // from outliving this future.
    (ha : JoinHandle(A)) = unsafe(io.spawn(first, e));
    a := _scope(ha);
    (hb : JoinHandle(B)) = unsafe(io.spawn(second, e));
    b := _scope(hb);
    // 0: undecided, 1: the first completed, 2: the second, 3: both aborted.
    (decided : u8) = u8(0);
    while(decided == u8(0), {
      sa := _scoped_state(&a);
      sb := _scoped_state(&b);
      cond(
        (sa == FutureState.Completed) => {
          decided = u8(1);
        },
        (sb == FutureState.Completed) => {
          decided = u8(2);
        },
        ((sa == FutureState.Aborted) && (sb == FutureState.Aborted)) => {
          decided = u8(3);
        },
        true => {
          // Wait on the operands still running: an aborted one would resolve
          // the wait at once.
          w := unsafe(__yo_join_wait_new());
          if(sa != FutureState.Aborted, {
            _scoped_wait_on(&a, &w);
          });
          if(sb != FutureState.Aborted, {
            _scoped_wait_on(&b, &w);
          });
          _w := io.await(w, io);
        }
      );
    });
    // The loser is aborted (a terminal one is left alone) and both are
    // joined, so neither task outlives this future.
    if(decided != u8(1), {
      _scoped_abort(&a);
    });
    if(decided != u8(2), {
      _scoped_abort(&b);
    });
    ra := io.await(_scoped_join(&mut a, io), io);
    rb := io.await(_scoped_join(&mut b, io), io);
    _select_result(decided, ra, rb)
  })
);
/// `select`'s result from the joined operands (a function of its own for the
/// reason `_timeout_result` gives).
_select_result :: (fn(generic(A : Type, B : Type), decided : u8, ra : Option(A), rb : Option(B)) -> Option(Selected(A, B)))({
  (out : Option(Selected(A, B))) = Option(Selected(A, B)).None;
  if(decided == u8(1), {
    match(
      ra,
      .Some(v) => {
        out = Option(Selected(A, B)).Some(Selected(A, B).First(v));
      },
      .None => ()
    );
  });
  if(decided == u8(2), {
    match(
      rb,
      .Some(v) => {
        out = Option(Selected(A, B)).Some(Selected(A, B).Second(v));
      },
      .None => ()
    );
  });
  out
});
export(yield, join_all, race, race_first, any, any_first, timeout, TimeoutError, select, Selected);
