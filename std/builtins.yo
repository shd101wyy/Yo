// Also needs to update the src/builtins.ts file
extern "Yo",
  // compt_codegen_inline: (fn(compt(C): compt_string)-> compt(unit)),
  // compt_noop: (()-> compt(unit)),
  __yo_return_self : (fn(forall(T: Type), self: T) -> T),
  __yo_noop: (fn(forall(T : Type))-> T),
  __yo_as: (fn(forall(Self: Type), self: Self, compt(Target): Type) -> Target),
  
  // Arithmetic Operators
  /// +
  __yo_op_add : (fn(forall(T : Type), x : T, y : T) -> T),
  /// -
  __yo_op_sub : (fn(forall(T : Type), x : T, y : T) -> T),
  /// *
  __yo_op_mul : (fn(forall(T : Type), x : T, y : T) -> T),
  /// /
  __yo_op_div : (fn(forall(T : Type), x : T, y : T) -> T),
  /// %
  __yo_op_mod : (fn(forall(T : Type), x : T, y : T) -> T),
  /// -
  __yo_op_neg : (fn(forall(T : Type), x : T) -> T),
  
  // Relational Operators
  /// ==
  __yo_op_eq : (fn(forall(T : Type), x : T, y : T) -> boolean),
  /// !=
  __yo_op_neq : (fn(forall(T : Type), x : T, y: T) -> boolean),
  /// <
  __yo_op_lt : (fn(forall(T : Type), x : T, y : T) -> boolean),
  /// <=
  __yo_op_lte : (fn(forall(T : Type), x : T, y : T) -> boolean),
  /// >
  __yo_op_gt : (fn(forall(T : Type), x : T, y : T) -> boolean),
  /// >=
  __yo_op_gte : (fn(forall(T : Type), x : T, y : T) -> boolean),

  // Logical Operators
  /// &&
  __yo_op_and : (fn(forall(T : Type), x : T, y : T) -> boolean),
  /// ||
  __yo_op_or : (fn(forall(T : Type), x : T, y : T) -> boolean),
  /// !
  __yo_op_not : (fn(forall(T : Type), x : T) -> boolean),

  // Bitwise Operators
  /// &
  __yo_op_bit_and : (fn(forall(T : Type), x : T, y : T) -> T),
  /// |
  __yo_op_bit_or  : (fn(forall(T : Type), x : T, y : T) -> T),
  /// ^
  __yo_op_bit_xor : (fn(forall(T : Type), x : T, y : T) -> boolean),
  /// ~
  __yo_op_bit_complement: (fn(forall(T : Type), x : T) -> T),
  /// <<
  __yo_op_bit_left_shift : (fn(forall(T : Type), x : T, y : T) -> T),
  /// >>
  __yo_op_bit_right_shift : (fn(forall(T : Type), x : T, y : T) -> T)
;

export
  __yo_return_self,
  __yo_noop,
  __yo_as,
  
  // Arithemtic
  __yo_op_add, // +
  __yo_op_sub, // -
  __yo_op_mul, // *
  __yo_op_div, // /
  __yo_op_mod, // %
  __yo_op_neg, // -

  // Relational
  __yo_op_eq,  // ==
  __yo_op_neq, // !=
  __yo_op_lt,  // <
  __yo_op_lte, // <=
  __yo_op_gt,  // >
  __yo_op_gte, // >=

  // Logical
  __yo_op_and, // &&
  __yo_op_or,  // ||
  __yo_op_not, // !

  // Bitwise
  __yo_op_bit_and,        // &
  __yo_op_bit_or,         // |
  __yo_op_bit_xor,        // ^
  __yo_op_bit_complement, // ~
  __yo_op_bit_left_shift, // <<
  __yo_op_bit_right_shift // >>
;