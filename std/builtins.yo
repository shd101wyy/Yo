// Also needs to update the src/builtins.ts file
extern "Yo",
  // compt_codegen_inline: ((@(C): compt_string)-> @(unit)),
  // compt_noop: (()-> @(unit)),
  
  // Arithmetic Operators
  /// +
  __yo_op_add : ((forall(@(T): Free), x : T, y : T) -> T),
  /// -
  __yo_op_sub : ((forall(@(T): Free), x : T, y : T) -> T),
  /// *
  __yo_op_mul : ((forall(@(T): Free), x : T, y : T) -> T),
  /// /
  __yo_op_div : ((forall(@(T): Free), x : T, y : T) -> T),
  /// %
  __yo_op_mod : ((forall((@T): Free), x : T, y : T) -> T),
  /// -
  __yo_op_neg : ((forall(@(T): Free), x : T) -> T),
  
  // Relational Operators
  /// ==
  __yo_op_eq : ((forall(@(T): Free), x : T, y : T) -> boolean),
  /// !=
  __yo_op_neq : ((forall(@(T): Free), x : T, y: T) -> boolean),
  /// <
  __yo_op_lt : ((forall(@(T): Free), x : T, y : T) -> boolean),
  /// <=
  __yo_op_lte : ((forall(@(T): Free), x : T, y : T) -> boolean),
  /// >
  __yo_op_gt : ((forall(@(T): Free), x : T, y : T) -> boolean),
  /// >=
  __yo_op_gte : ((forall(@(T): Free), x : T, y : T) -> boolean),

  // Logical Operators
  /// &&
  __yo_op_and : ((forall(@(T): Free), x : T, y : T) -> boolean),
  /// ||
  __yo_op_or : ((forall(@(T): Free), x : T, y : T) -> boolean),
  /// !
  __yo_op_not : ((forall(@(T): Free), x : T) -> boolean),

  // Bitwise Operators
  /// &
  __yo_op_bit_and : ((forall(@(T): Free), x : T, y : T) -> T),
  /// |
  __yo_op_bit_or  : ((forall(@(T): Free), x : T, y : T) -> T),
  /// ^
  __yo_op_bit_xor : ((forall(@(T): Free), x : T, y : T) -> boolean),
  /// ~
  __yo_op_bit_complement: ((forall(@(T): Free), x : T) -> T),
  /// <<
  __yo_op_bit_left_shift : ((forall(@(T): Free), x : T, y : T) -> T),
  /// >>
  __yo_op_bit_right_shift : ((forall(@(T): Free), x : T, y : T) -> T)
;

export
  // Arithemtic
  __yo_op_add, // +
  __yo_op_sub, // -
  __yo_op_mul, // *
  __yo_op_div, // /
  __yo_op_mod, // %
  __yo_op_neg, // -

  // Relational
  __yo_op_eq,  // ==
  __yo_op_neq, // !=
  __yo_op_lt,  // <
  __yo_op_lte, // <=
  __yo_op_gt,  // >
  __yo_op_gte, // >=

  // Logical
  __yo_op_and, // &&
  __yo_op_or,  // ||
  __yo_op_not, // !

  // Bitwise
  __yo_op_bit_and,        // &
  __yo_op_bit_or,         // |
  __yo_op_bit_xor,        // ^
  __yo_op_bit_complement, // ~
  __yo_op_bit_left_shift, // <<
  __yo_op_bit_right_shift // >>
;