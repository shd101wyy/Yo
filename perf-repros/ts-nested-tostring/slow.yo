//! Synthetic SLOW form — adds a get_variable_info-style dead function
//! that uses ty_to_str inside a template-string. This is the variant
//! that exhibits the perf bug.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");

TyShape :: enum(
  Unit,
  BoolT,
  Void,
  Int1, Int2, Int4, Int8,
  Float4, Float8,
  Usize, Isize,
  ComptimeInt, ComptimeFloat, ComptimeString,
  CChar, CShort, CUShort, CInt, CUInt, CLong, CULong,
  CLongLong, CULongLong, CLongDouble,
  Pointer(inner : Box(Self)),
  Slice(inner : Box(Self)),
  Array(inner : Box(Self), n : usize),
  Tuple(labels : ArrayList(String), types : ArrayList(Self)),
  Func(params : ArrayList(Self), result : Box(Self)),
  Struct(name : String, fields : ArrayList(Self)),
  EnumT(name : String, variants : ArrayList(String)),
  Union(name : String, variants : ArrayList(Self)),
  TraitT(name : String, fields : ArrayList(String)),
  SomeT(id : String, name : String, level : usize),
  TypeAppT(constructor : Box(Self), args : ArrayList(Self))
);

ty_to_str :: (fn(t : TyShape) -> String)(
  match(
    t,
    .Unit => `unit`,
    .BoolT => `bool`,
    .Void => `void`,
    .Int1 => `i8`, .Int2 => `i16`, .Int4 => `i32`, .Int8 => `i64`,
    .Float4 => `f32`, .Float8 => `f64`,
    .Usize => `usize`, .Isize => `isize`,
    .ComptimeInt => `comptime_int`,
    .ComptimeFloat => `comptime_float`,
    .ComptimeString => `comptime_string`,
    .CChar => `char`, .CShort => `short`, .CUShort => `ushort`,
    .CInt => `int`, .CUInt => `uint`, .CLong => `long`, .CULong => `ulong`,
    .CLongLong => `longlong`, .CULongLong => `ulonglong`, .CLongDouble => `longdouble`,
    .Pointer(inner) => `*(${recur(inner.*)})`,
    .Slice(inner) => `Slice(${recur(inner.*)})`,
    .Array(inner, n) => `Array(${recur(inner.*)}, ${n.to_string()})`,
    .Tuple(_, _) => `Tuple(...)`,
    .Func(_, _) => `Func(...)`,
    .Struct(name, _) => `struct ${name}`,
    .EnumT(name, _) => `enum ${name}`,
    .Union(name, _) => `union ${name}`,
    .TraitT(name, _) => `trait ${name}`,
    .SomeT(_, name, _) => `Some(${name})`,
    .TypeAppT(_, _) => `TypeApp(...)`
  )
);

// The bug-triggering function — every template-string ${...} slot
// calls ty_to_str / .to_string() and multiplies tryToCall traffic.
Variable :: object(
  id : String,
  name : String,
  ty : TyShape,
  is_compile_time_only : bool,
  is_reassignable : bool
);

get_variable_info :: (fn(v : Variable) -> String)(
  `{id: ${v.id}, name: ${v.name}, type: ${ty_to_str(v.ty)}, type2: ${ty_to_str(v.ty)}, isCompileTimeOnly: ${v.is_compile_time_only.to_string()}, isReassignable: ${v.is_reassignable.to_string()}}`
);

main :: (fn() -> unit)(());
export(main);
