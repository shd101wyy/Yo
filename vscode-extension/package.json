{
  "name": "yolang",
  "displayName": "Yo Language",
  "description": "Yo language syntax highlighting",
  "icon": "Yo_logo.png",
  "version": "0.2.13",
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "package": "vsce package"
  },
  "repository": "https://github.com/shd101wyy/yo",
  "license": "NCSA",
  "publisher": "shd101wyy",
  "contributes": {
    "languages": [
      {
        "id": "yo",
        "aliases": [
          "Yo",
          "yo"
        ],
        "extensions": [
          "yo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yo",
        "scopeName": "source.yo",
        "path": "./syntaxes/yo.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[yo]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "shd101wyy.yolang"
      }
    }
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  }
}
