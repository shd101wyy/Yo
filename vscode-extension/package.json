{
  "name": "yolang",
  "displayName": "Yo Language",
  "description": "Yo language syntax highlighting",
  "version": "0.0.20",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:yo"
  ],
  "main": "./out/native/extension.js",
  "scripts": {
    "build": "bun run build.js",
    "watch": "bun run build.js --watch",
    "package": "bun run build && vsce package"
  },
  "repository": "https://github.com/shd101wyy/yo",
  "license": "NCSA",
  "publisher": "shd101wyy",
  "contributes": {
    "languages": [
      {
        "id": "yo",
        "aliases": [
          "Yo",
          "yo"
        ],
        "extensions": [
          "yo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yo",
        "scopeName": "source.yo",
        "path": "./syntaxes/yo.tmLanguage.json"
      }
    ]
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "devDependencies": {
    "@types/node": "16",
    "@types/vscode": "1.70.0",
    "esbuild": "^0.20.0",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "typescript": "^5.3.3"
  }
}
