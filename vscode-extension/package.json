{
  "name": "Mo",
  "displayName": "Mo",
  "description": "Mo language syntax highlighting",
  "version": "0.0.1",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:mo"
  ],
  "main": "./out/native/extension.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch"
  },
  "repository": "https://github.com/0xGG/mo",
  "license": "NCSA",
  "publisher": "shd101wyy",
  "contributes": {
    "languages": [
      {
        "id": "mo",
        "aliases": [
          "Mo",
          "mo"
        ],
        "extensions": [
          "mo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mo",
        "scopeName": "source.mo",
        "path": "./syntaxes/mo.tmLanguage.json"
      }
    ]
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "devDependencies": {
    "@types/node": "16",
    "@types/vscode": "1.70.0",
    "esbuild": "^0.20.0",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "typescript": "^5.3.3"
  }
}
