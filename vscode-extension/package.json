{
  "name": "yolang",
  "displayName": "Yo Language",
  "description": "Yo language support: syntax highlighting + language server (diagnostics, hover, completion, navigation, rename, formatting)",
  "icon": "Yo_logo.png",
  "version": "0.2.30",
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "package": "vsce package"
  },
  "repository": "https://github.com/shd101wyy/yo",
  "license": "NCSA",
  "publisher": "shd101wyy",
  "contributes": {
    "languages": [
      {
        "id": "yo",
        "aliases": [
          "Yo",
          "yo"
        ],
        "extensions": [
          "yo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yo",
        "scopeName": "source.yo",
        "path": "./syntaxes/yo.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[yo]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "shd101wyy.yolang"
      }
    },
    "configuration": {
      "title": "Yo",
      "properties": {
        "yo.binPath": {
          "type": "string",
          "default": "yo",
          "description": "Path to the yo binary used for the language server (`yo lsp`). Defaults to `yo` on PATH."
        },
        "yo.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the Yo language server (`yo lsp`) for diagnostics, hover, completion, navigation, rename and formatting. Syntax highlighting works regardless."
        },
        "yo.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC traffic between VS Code and `yo lsp` in the \"Yo Language Server\" output channel."
        }
      }
    },
    "commands": [
      {
        "command": "yo.restartLanguageServer",
        "title": "Yo: Restart Language Server"
      }
    ]
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:yo",
    "onCommand:yo.restartLanguageServer"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
