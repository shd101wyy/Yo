{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "noUnusedLocals": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "out",
    "lib": ["ES2020"],
    "types": ["node"],
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out"]
}
