{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "noUnusedLocals": true,
    "sourceMap": true,
    "outDir": "out",
    "lib": [
      "ES2020",
      "WebWorker"
    ],
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@mo/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "../src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ],

}