{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "noUnusedLocals": true,
    "sourceMap": true,
    "outDir": "out",
    "lib": ["ES2020", "WebWorker"],
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@yo/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "../src/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
