{
  "my_comments": [
    "Referenec: https://github.com/microsoft/vscode/blob/main/extensions/typescript-basics/syntaxes/TypeScript.tmLanguage.json"
  ],
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Yo",
  "patterns": [
    {
      "include": "#statements"
    },
    {
      "include": "#shebang"
    }
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.ts",
      "match": "\\A(#!).*(?=$)",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.ts"
        }
      }
    },
    "statements": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#type-declaration" },
        { "include": "#type-kind" },
        { "include": "#permissions" },
        { "include": "#self-reference" },
        { "include": "#defer" },
        { "include": "#condition" },
        { "include": "#clause" },
        { "include": "#imports" },
        { "include": "#try-with" },
        { "include": "#builtin-functions" },
        { "include": "#async-await" },
        { "include": "#infix-precedence" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#template-strings" },
        { "include": "#builtin-types" },
        { "include": "#builtin-values" }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.yo",
          "match": "//.*"
        },
        {
          "include": "#comment-block"
        }
      ]
    },
    "comment-block": {
      "name": "comment.block.yo",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.yo",
          "match": "\\b(let|var|while|for|select|generic|mut|const|in|out|inout|ref|break|continue|pass|return|unwind|pure|recur|use|borrow|comptime|runt|resume|shift|reset|abort|panic|assert|test|thread_local|atomic)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.control.yo",
          "match": "[=+\\-\\*/<>@$~&%|!?^.:\\\\#∀]+"
        }
      ]
    },
    "type-declaration": {
      "name": "storage.type.yo",
      "match": "\\b(type|fn|ctl|macro|enum|struct|newtype|union|object|actor|ref|impl|dyn|derive|derive_rule|box|chan|static)\\b"
    },
    "type-kind": {
      "name": "entity.name.type",
      "match": "\\b(Type|Var|Trait|Self|SelfTrait|This|Dyn|Impl|Future|Concrete|Fn|FnOnce|Io|Send|Copy|Acyclic|Comptime|Runtime)\\b"
    },
    "permissions": {
      "name": "keyword.control.yo",
      "match": "\\b(read|write|own|move|copy|control)\\b"
    },
    "self-reference": {
      "name": "variable.language.this.yo",
      "match": "\\b(self|this)\\b"
    },
    "defer": {
      "name": "keyword.control.yo",
      "match": "\\b(defer|abortdefer)\\b"
    },
    "condition": {
      "name": "keyword.control.yo",
      "match": "\\b(if|cond|then|else|switch|case|default|match)\\b"
    },
    "clause": {
      "name": "keyword.control.yo",
      "match": "\\b(open|exists|where)\\b"
    },
    "imports": {
      "name": "keyword.control.yo",
      "match": "\\b(import|export|from|as|extern|trait|c_include)\\b"
    },
    "try-with": {
      "name": "keyword.control.yo",
      "match": "\\b(try|with)\\b"
    },
    "builtin-functions": {
      "name": "entity.name.function.yo",
      "match": "\\b(sizeof|alignof|typeof|gensym|consume|rc|take|drop|clone|dup|quote|unquote|unquote_splicing|comptime_expect_error|comptime_assert|downcast|comptime_fn|array|tuple|comptime_list|begin|and|or|not|_|the|macro_expand|runtime|unsafe|asm|global_asm|pragma)\\b"
    },
    "async-await": {
      "patterns": [
        { "name": "keyword.control.yo", "match": "\\b(async|await|spawn)\\b" },
        { "name": "entity.name.type", "match": "\\b(Promise)\\b" }
      ]
    },
    "infix-precedence": {
      "name": "keyword.control",
      "match": "\\b(infix|infixl|infixr)\\b"
    },
    "strings": {
      "name": "string.quoted.double.yo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.yo",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.yo",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.yo",
          "match": "\\\\."
        }
      ]
    },
    "template-strings": {
      "name": "string.template.yo",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.yo",
          "match": "\\\\."
        },
        {
          "name": "meta.template.expression.yo",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.yo"
            }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.yo" }
          },
          "patterns": [{ "include": "#statements" }]
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.yo",
      "match": "\\b(unit|usize|isize|u8|i8|u16|i16|u32|i32|u64|i64|f16|f32|f64|bool|char|symbol|any|voidptr|void|comptime_int|comptime_float|comptime_string|str|Array|Slice|Tuple|Expr|ComptimeList|ExprList|Iso|Arc|anyopaque|char|short|ushort|int|uint|long|ulong|longlong|ulonglong|longdouble)\\b"
    },
    "builtin-values": {
      "name": "constant.language.yo",
      "match": "\\b(true|false|null|undefined)\\b"
    }
  },
  "scopeName": "source.yo"
}
