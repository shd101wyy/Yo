{
  "my_comments": [
    "Reference: https://github.com/microsoft/vscode/blob/main/extensions/typescript-basics/syntaxes/TypeScript.tmLanguage.json",
    "Keyword/builtin vocabulary mirrors the CURRENT language as implemented in",
    "src/lexer.yo, src/token.yo, src/parser.yo and src/evaluator/ — keep it in",
    "sync when the grammar changes. Yo has NO reserved keywords in the lexer",
    "(only `true`/`false` are special-cased); everything below highlights names",
    "the evaluator or parser recognizes."
  ],
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Yo",
  "patterns": [
    {
      "include": "#statements"
    },
    {
      "include": "#shebang"
    }
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.yo",
      "match": "\\A(#!).*(?=$)",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.yo"
        }
      }
    },
    "statements": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#type-declaration" },
        { "include": "#type-kind" },
        { "include": "#parameters-and-clauses" },
        { "include": "#self-reference" },
        { "include": "#imports" },
        { "include": "#builtin-functions" },
        { "include": "#async-await" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#template-strings" },
        { "include": "#builtin-types" },
        { "include": "#builtin-values" }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.documentation.yo",
          "match": "///[^/].*$|///$"
        },
        {
          "name": "comment.line.inner-doc.yo",
          "match": "//!(.).*$|//!$"
        },
        {
          "name": "comment.line.double-slash.yo",
          "match": "//.*"
        },
        {
          "include": "#comment-block-doc"
        },
        {
          "include": "#comment-block-inner-doc"
        },
        {
          "include": "#comment-block"
        }
      ]
    },
    "comment-block": {
      "name": "comment.block.yo",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "comment-block-doc": {
      "name": "comment.block.documentation.yo",
      "begin": "/\\*(?=\\*[^/]|\\*$)",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#comment-block-doc"
        }
      ]
    },
    "comment-block-inner-doc": {
      "name": "comment.block.inner-doc.yo",
      "begin": "/\\*!",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#comment-block-inner-doc"
        }
      ]
    },
    "numbers": {
      "comment": "One number is one token. Underscores only in DECIMAL digits; hex/binary/octal take bare digits. A Float requires `.digit` — `1.foo` is `1` `.` `foo`.",
      "patterns": [
        {
          "name": "constant.numeric.hex.yo",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.yo",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.yo",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.yo",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d[\\d_]*)?\\b"
        }
      ]
    },
    "keywords": {
      "comment": "Control-flow heads. All are ordinary calls in the grammar; the evaluator (or the parse-time if->cond desugar) recognizes them.",
      "patterns": [
        {
          "name": "keyword.control.yo",
          "match": "\\b(if|cond|match|while|for|return|unwind|recur|break|continue)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.yo",
          "match": "[=+\\-*/<>@$~&%|!?^.:\\\\#]+"
        }
      ]
    },
    "type-declaration": {
      "name": "storage.type.yo",
      "match": "\\b(fn|ctl|unsafe_fn|type|struct|union|enum|newtype|trait|impl|ref|atomic|box|dyn|export|import|extern|c_include|test|thread_local)\\b"
    },
    "type-kind": {
      "name": "entity.name.type.yo",
      "match": "\\b(Type|Trait|Self|SelfTrait|Fn|Impl|Future|Io|Send|Dyn|Acyclic|Comptime|Runtime|Expr|Iso|Concrete)\\b"
    },
    "parameters-and-clauses": {
      "comment": "Parameter label modifiers, fn-signature clause heads, and the ghost/contract surface (forall/exists are the ghost-only quantifiers).",
      "patterns": [
        {
          "name": "keyword.control.yo",
          "match": "\\b(comptime|generic|where|using|given|own|inout|quote|forall|exists|ghost|ghost_fn|requires|ensures|invariant|decreases|refine|assumed|old)\\b"
        }
      ]
    },
    "self-reference": {
      "patterns": [
        {
          "name": "variable.language.this.yo",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "keyword.control.import.yo",
          "match": "\\b(import|export)\\b"
        }
      ]
    },
    "builtin-functions": {
      "name": "entity.name.function.yo",
      "match": "\\b(sizeof|alignof|typeid|typeof|gensym|consume|dup|drop|rc|the|downcast|derive|derive_rule|macro_expand|comptime_assert|comptime_expect_error|comptime_fn|comptime_print|comptime_eval|comptime_read_file|comptime_json_parse|comptime_toml_parse|comptime_list|quote|unquote|unquote_splicing|and|or|runtime|unsafe|pragma|asm|global_asm|va_start|begin|_)\\b"
    },
    "async-await": {
      "patterns": [
        { "name": "keyword.control.async.yo", "match": "\\b(async)\\b" },
        { "name": "keyword.control.await.yo", "match": "\\b(await)\\b" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.yo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.yo",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.yo",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.yo",
          "match": "\\\\."
        }
      ]
    },
    "template-strings": {
      "name": "string.template.yo",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.yo",
          "match": "\\\\."
        },
        {
          "comment": "Interpolation; nested braces inside the expression are tracked, mirroring the lexer's brace-depth counting.",
          "name": "meta.template.expression.yo",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.yo"
            }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.yo" }
          },
          "patterns": [
            { "include": "#template-braces" },
            { "include": "#statements" }
          ]
        }
      ]
    },
    "template-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#template-braces" },
        { "include": "#statements" }
      ]
    },
    "builtin-types": {
      "comment": "Builtin scalar type names (resolve_primitive_identifier in src/evaluator/exprs/identifer_and_operator.yo) plus common prelude type constructors.",
      "name": "support.type.yo",
      "match": "\\b(comptime_int|comptime_float|comptime_str|longdouble|longlong|ulonglong|unit|usize|isize|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|bool|char|str|void|ushort|ulong|uint|short|long|int|Array|RawSlice|ComptimeList|String|Option|Result|Box|Arc|ArrayList|HashMap|HashSet|Ordering|Range|RangeInclusive)\\b"
    },
    "builtin-values": {
      "name": "constant.language.yo",
      "match": "\\b(true|false)\\b"
    }
  },
  "scopeName": "source.yo"
}
