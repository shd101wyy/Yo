{
  "my_comments": [
    "Referenec: https://github.com/microsoft/vscode/blob/main/extensions/typescript-basics/syntaxes/TypeScript.tmLanguage.json"
  ],
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mo",
  "patterns": [
    {
      "include": "#statements"
    },
    {
      "include": "#shebang"
    }
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.ts",
      "match": "\\A(#!).*(?=$)",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.ts"
        }
      }
    },
    "statements": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#type-declaration" },
        { "include": "#type-kind" },
        { "include": "#permissions" },
        { "include": "#defer" },
        { "include": "#condition" },
        { "include": "#clause" },
        { "include": "#module" },
        { "include": "#try-with" },
        { "include": "#builtin-functions" },
        { "include": "#async-await" },
        { "include": "#infix-precedence" },
        { "include": "#strings" },
        { "include": "#chars"},
        { "include": "#infix-identifiers" },
        { "include": "#builtin-types" }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mo",
          "match": "//.*"
        },
        {
          "name": "comment.block.mo",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mo",
          "match": "\\b(let|var|while|for|forall|mut|const|ref|break|continue|return|use|compt|compteval|runt)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.control.mo",
          "match": "[=+\\-\\*/<>@$~&%|!?^.:\\\\#]+"
        }
      ]
    },
    "type-declaration": {
      "name": "storage.type.mo",
      "match": "\\b(type|fn|def|macro|enum|data|struct|union|interface|trait|impl|dyn|static|expr)\\b"
    },
    "type-kind": {
      "name": "entity.name.type",
      "match": "\\b(Type|Free|Linear|Self|Interface)\\b"
    },
    "permissions": {
      "name": "keyword.control.mo",
      "match": "\\b(read|write|own|copy|control|self|this)\\b"
    },
    "defer": {
      "name": "keyword.control.mo",
      "match": "\\b(defer|abortdefer)\\b"
    },
    "condition": {
      "name": "keyword.control.mo",
      "match": "\\b(if|cond|then|else|switch|case|default|match)\\b"
    },
    "clause": {
      "name": "keyword.control.mo",
      "match": "\\b(given|using|where)\\b"
    },
    "module": {
      "name": "keyword.control.mo",
      "match": "\\b(import|export|from|as|extern)\\b"
    },
    "try-with": {
      "name": "keyword.control.mo",
      "match": "\\b(try|with)\\b"
    },
    "builtin-functions": {
      "name": "entity.name.function.mo",
      "match": "\\b(sizeof|typeof|_)\\b"
    },
    "async-await": {
      "patterns": [
        { "name": "keyword.control.mo", "match": "\\b(async|await|do)\\b" },
        { "name": "entity.name.type", "match": "\\b(Promise)\\b" }
      ]
    },
    "infix-precedence": {
      "name": "keyword.control",
      "match": "\\b(infix|infixl|infixr)\\b"
    },
    "strings": {
      "name": "string.quoted.double.mo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mo",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.mo",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.mo",
          "match": "\\\\."
        }
      ]
    },
    "infix-identifiers": {
      "name": "entity.name.function.mo",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.mo",
          "match": "\\\\."
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.mo",
      "match": "\\b(usize|isize|u8|i8|u16|i16|u32|i32|u64|i64|f16|f32|f64|boolean|char|symbol|any|voidptr|void|null|true|false)\\b"
    }
  },
  "scopeName": "source.mo"
}
